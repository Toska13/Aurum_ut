Функция ПроверитьСвязанныеОпасныеГрузы(Знач Объект, Знач СтрокаТовара, ТаблицаОшибок)
	
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ТекущийНомерСтроки = СтрокаТовара.НомерСтроки;
	ИмяТЧ = "Товары"; // ошибки будем складывать к товарам

	СвязанныеСтрокиОГ = Объект.ОпасныеГрузы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки));
	Для Каждого СтрокаОГ Из СвязанныеСтрокиОГ Цикл 
		
		Источник = СтрокаОГ;
		
		Если НЕ ЗначениеЗаполнено(Источник.НомерООН) Тогда
			ТекстОшибки = "Укажите Номер ООН опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.НадлежащееОтгрузочноеНаименование) Тогда
			ТекстОшибки = "Укажите Надлежащее отгрузочное наименование опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.Класс) Тогда
			ТекстОшибки = "Укажите Класс опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.КлассификационныйКод) Тогда
			ТекстОшибки = "Укажите Классификационный код опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.ГруппаУпаковки) Тогда
			ТекстОшибки = "Укажите Группу упаковки опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.ЗнакОпасности) Тогда
			ТекстОшибки = "Укажите Знак опасности опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Источник.КодОграниченияТуннели) Тогда
			ТекстОшибки = "Укажите Код ограничения проезда через туннели опасного груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
		КонецЕсли;
		
		Если Источник.Класс = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс1 Тогда
			
			Если НЕ ЗначениеЗаполнено(Источник.ОбМасНетВзрСод) Тогда
				ТекстОшибки = "Укажите Общая масса нетто взрывчатого содержимого в килограммах для каждого вещества или изделия, имеющего отдельный номер ООН (т.к. класс = 1)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Источник.ОбМасНетВзрСодВсех) Тогда
				ТекстОшибки = "Укажите Общая масса нетто взрывчатого содержимого в килограммах для всех веществ и изделий, которых касается сопроводительная ведомость (т.к. класс = 1)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция КоличествоЗнаковВЧисле(Значение)
	
	ДлинаЦелойЧасти = СтрДлина(Цел(Значение));
	ДлинаДробнойЧасти = СтрДлина(Значение - Цел(Значение)) - 2;
	
	Возврат ДлинаЦелойЧасти + ДлинаДробнойЧасти;
	
КонецФункции

