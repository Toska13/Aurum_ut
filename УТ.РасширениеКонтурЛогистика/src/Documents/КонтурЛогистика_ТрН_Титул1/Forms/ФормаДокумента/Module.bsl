&НаКлиенте
Процедура ИнфПолПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы.ИнфПол.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьРедактированиеИнфПол(ТекДанные);
	ДопПолеПриИзменении(Элемент);	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРедактированиеИнфПол(ТекДанные)
	
	Если ТекДанные.Идентиф = "ORDERS" Тогда
		Объект.НомераЗаказов = ТекДанные.Значение;	
	ИначеЕсли ТекДанные.Идентиф = "INVOIC" Тогда
		Объект.НомераУПД = ТекДанные.Значение;
	ИначеЕсли ТекДанные.Идентиф = "DESADV" Тогда
		Объект.НомераDESADV = ТекДанные.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнфПолПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ИнфПол.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.Идентиф = "ORDERS" Тогда
		Объект.НомераЗаказов = "";	
	ИначеЕсли ТекДанные.Идентиф = "INVOIC" Тогда
		Объект.НомераУПД = "";
	ИначеЕсли ТекДанные.Идентиф = "DESADV" Тогда
		Объект.НомераDESADV = "";
	КонецЕсли;
	
	ДопПолеПриИзменении(Элемент);	
		
КонецПроцедуры

