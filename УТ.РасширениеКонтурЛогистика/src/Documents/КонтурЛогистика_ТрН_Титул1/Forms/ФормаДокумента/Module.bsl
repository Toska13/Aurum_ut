Процедура СвернутьШапку(Команда)

	ШапкаНаОтдельнойЗакладке = Истина;
	УстановитьПоложениеШапки();

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьШапку(Команда)

	//ШапкаНаОтдельнойЗакладке = Ложь;
	//УстановитьПоложениеШапки();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеШапки()

	Если ШапкаНаОтдельнойЗакладке Тогда

		текАктивнаяЗакладка = Элементы.Страницы.ТекущаяСтраница;

		ПереместитьШапкуВызовСервера();
		//Элементы.Переместить(Элементы.ГруппаШапкаЛево, Элементы.СтраницаШапка);
		//Элементы.СвернутьШапку.Видимость = Ложь;
		//Элементы.РазвернутьШапку.Видимость = Истина;

		ПанельОшибокРазвернута = Элементы.ПанельОшибок.РастягиватьПоВертикали;
		Если Не ПанельОшибокРазвернута Тогда
			ПанельОшибокСвернутьРазвернутьВызовОМ();
		КонецЕсли;

		Элементы.Страницы.ТекущаяСтраница = текАктивнаяЗакладка;

	Иначе

		ПереместитьШапкуВызовСервера();
		//Элементы.Переместить(Элементы.ГруппаШапкаЛево, Элементы.ГруппаШапкаМестоположение);
		//Элементы.СвернутьШапку.Видимость = Истина;
		//Элементы.РазвернутьШапку.Видимость = Ложь;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПереместитьШапкуВызовСервера()

	Если ШапкаНаОтдельнойЗакладке Тогда
		Если Элементы.СтраницаШапка.ПодчиненныеЭлементы.Найти(Элементы.ГруппаШапкаДанные.Имя) = Неопределено Тогда
			КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(ЭтаФорма,
																   Элементы.ГруппаШапкаДанные,
																   Элементы.СтраницаШапка);
		КонецЕсли;
	Иначе
		Если Элементы.ГруппаШапкаМестоположение.ПодчиненныеЭлементы.Найти(Элементы.ГруппаШапкаДанные.Имя) = Неопределено Тогда
			КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(ЭтаФорма,
																   Элементы.ГруппаШапкаДанные,
																   Элементы.ГруппаШапкаМестоположение);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СделатьНесопоставленныеНеУчитываемыми(Команда)

	НесопоставленныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("КоличествоМест,МассаПлановаяБруттоКг,ОтгрузочноеНаименование,Учитывать",
																	   0,
																	   0,
																	   "",
																	   Истина));
	Если НесопоставленныеСтроки.Количество() > 0 Тогда

		Для Каждого текСтр Из НесопоставленныеСтроки Цикл
			СделатьСтрокуТовараНеучитываемой(текСтр);
		КонецЦикла;

		ПолностьюОбновитьПредставлениеДанных();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СделатьСтрокуТовараНеучитываемой(Знач ТекДанныеТоваров)

	СделатьНоменклатуруНеучитываемой(ТекДанныеТоваров.Номенклатура, ТекДанныеТоваров.УпаковкаЕдиницаИзмерения);
	
	// эта номенклатура может быть еще в других строках
	// требуется переконвертировать все строки с этой номенклатурой
	МассивСтрокСЭтойНоменклатурой = Объект.ТоварыДокумента1С.НайтиСтроки(Новый Структура("Номенклатура",
																						 ТекДанныеТоваров.Номенклатура));

	Для Каждого СтрокаПереконвертации Из МассивСтрокСЭтойНоменклатурой Цикл

		СконвертироватьСтрокуТоваровКлиент(СтрокаПереконвертации.ПолучитьИдентификатор());

	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СделатьНоменклатуруНеучитываемой(Номенклатура, УпаковкаЕдиницаИзмерения)

	РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.ПрисвоитьСоответствиеНоменклатуры(Номенклатура,
																									   Новый Структура("Учитывать,УпаковкаЕдиницаИзмерения",
																													   Ложь,
																													   УпаковкаЕдиницаИзмерения));

КонецПроцедуры

&НаКлиенте
Процедура Перепроверить(Команда = Неопределено)
	
	РезультатПроверки = ПроверитьДокумент();
	
	// если есть ошибки или предупреждения то нажатие всегда показывает панель ошибок (в свернутом или развернутом виде)
	
	ВсегдаВыводитьРезультатВалидации = ВсегдаВыводитьРезультатВалидации();
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки, ВсегдаВыводитьРезультатВалидации);
	
КонецПроцедуры

&НаКлиенте
Функция ВсегдаВыводитьРезультатВалидации()
	
	Возврат КодТекущегоСтатусаДокументооборота = "r-rejected"
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный");
	
КонецФункции

&НаКлиенте
Процедура ПеречитатьОбъект(Команда)

	ОбработчикПеречитатьОбъект();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()

	ЭтаФорма.Прочитать();
	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()

	ОбновитьДанныеФормы();
	УправлениеЭлементамиФормыВЗависимостиОтСтатуса();
	ПолностьюОбновитьПредставлениеДанных();
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(ЭтаФорма, Объект.ДокументОснование);
	УправлениеКолбасойТитуловВызовСервера();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеКолбасойТитуловВызовСервера()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УправлениеСтатусомПодписиИКолбасойТитулов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()

	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПерепроверить(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт

	Если ТипЗнч(Параметр2) = Тип("Структура") Тогда 
		Если Не ЗначениеЗаполнено(Объект.ДокументЭТРН) Тогда
			Параметр2.Свойство("ДокументЭТРН", Объект.ДокументЭТРН);
		КонецЕсли;	
	КонецЕсли; 

	ОбновитьДанныеФормы();
	Перепроверить();

КонецПроцедуры

&НаКлиенте
Функция ПроверитьДокумент()
	
	РезультатПроверки = ПроверитьДокументСервер();
	
	ВсегдаВыводитьРезультатВалидации = ВсегдаВыводитьРезультатВалидации();
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки, ВсегдаВыводитьРезультатВалидации);
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьПиктограммыОшибокТабличнойЧасти(
		Объект.Товары, ТаблицаОшибок, "Товары", "КартинкаОшибок");
	
	ЗаполнитьТребуемыеДействияТоваров(); 	// требуемые действия зависят от результатов проверки 
	УправлениеВидимостьюИДоступностью(); 	// доступность команд
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ПроверитьДокументСервер()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатыПроверкиДокумента = Документы.КонтурЛогистика_ТрН_Титул1.ПроверитьДокумент(ДокОбъект, ТаблицаОшибок, ТребуемоеДействие);
	
	РезультатПроверки = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаТовара.Картинка = 0;
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТребуемыеДействияТоваров()

	Для Каждого СтрокаТовара Из Объект.Товары Цикл

		СформироватьТребуемоеДействиеСтрокиТовара(СтрокаТовара);

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьТребуемоеДействиеСтрокиТовара(СтрокаТовара)

	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТовара.ТребуемоеДействие = "";
	
	// Блок 1 - Требуемые действия ведения пользователя за ручку по номенклатуре

	Если Не СтрокаТовара.Учитывать Тогда
		СтрокаТовара.ТребуемоеДействие = "Не учитывается";
		Возврат;
	КонецЕсли;
	
	// Для исходящих одни требуемые действия, а для исходящих другие
	Если ТекущийСтатус <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен") Тогда

		Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда 
			// эти требуемые действия блока 1 не являются блокирующими по документу - они только ведут пользователя
			Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) И Не СтрокаТовара.Свернута Тогда
				СтрокаТовара.ТребуемоеДействие = "Указать Номенклатуру";

			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовара.УпаковкаЕдиницаИзмерения) И Не СтрокаТовара.Свернута Тогда
				СтрокаТовара.ТребуемоеДействие = "Указать Единицу измерения";

			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовара.Количество) И Не СтрокаТовара.Свернута Тогда
				СтрокаТовара.ТребуемоеДействие = "Указать Количество";
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовара.СпособУпаковки)
					  Или Не ЗначениеЗаполнено(СтрокаТовара.СостояниеГруза)
					  Или Не ЗначениеЗаполнено(СтрокаТовара.ВидТары)
					  Или Не ЗначениеЗаполнено(СтрокаТовара.МассаПлановаяБруттоКг)
					  Или Не ЗначениеЗаполнено(СтрокаТовара.ОтгрузочноеНаименование) Тогда

				Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ТребоватьНаличиеБазовыхСоответствий") Тогда
					СтрокаТовара.ТребуемоеДействие = "Установить соответствие";
				Иначе
					СтрокаТовара.ТребуемоеДействие = "Заполнить обязательные поля";
				КонецЕсли;

			Иначе
				СтрокаТовара.ТребуемоеДействие = "Готов";
			КонецЕсли;
			
			Если СтрокаТовара.Свернута Тогда 
				СтрокаТовара.ТребуемоеДействие = СтрокаТовара.ТребуемоеДействие + ", свернута";
			КонецЕсли;	
			
		Иначе
			
			Если СтрокаТовара.КартинкаОшибок = 2 Тогда
				СтрокаТовара.ТребуемоеДействие = "Заполнить обязательные поля";
			Иначе
				СтрокаТовара.ТребуемоеДействие = "Готов";
			КонецЕсли;
			
		КонецЕсли;

	Иначе

		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			СтрокаТовара.ТребуемоеДействие = "Сопоставить";
		Иначе
			СтрокаТовара.ТребуемоеДействие = "ОК";
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьЗаголовкиКоличества(Форма)
	
	КоличествоМест = 0;
	КоличествоСтрок = 0;
	
	Для Каждого ТекущаяСтрока Из Форма.Объект.Товары Цикл
		
		Если Не ТекущаяСтрока.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоМест = КоличествоМест + ТекущаяСтрока.КоличествоМест;
		КоличествоСтрок = КоличествоСтрок + 1;
		
	КонецЦикла;
	
	Форма.Элементы.ТоварыКоличествоМест.Заголовок = КоличествоМест;
	Форма.Элементы.ТоварыКоличество.Заголовок = Форма.Объект.Товары.Итог("Количество");
	
	Форма.Элементы.ГруппаТовары.Заголовок = "Грузы (" + КоличествоСтрок + ")";

КонецПроцедуры

