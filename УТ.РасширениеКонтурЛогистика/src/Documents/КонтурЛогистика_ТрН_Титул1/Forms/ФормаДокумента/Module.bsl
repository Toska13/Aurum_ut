Процедура ОткрытьСоответствияНоменклатуры(Команда)

	ОткрытьСоответствияТекущейСтроки();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовкиГруппамДопПолей()
	
	// ТелефоныПереадресующего
	Элементы.ГруппаТелефоныПереадресующего.Заголовок = "Телефоны переадресующих (" + Объект.ТелефоныПереадресующего.Количество() +")";
	
	// Состояние
	УстановитьЗаголовокСостояний();
	
	// Ограничения
	УстановитьЗаголовокОграничений();
	
	// ГруппаИнфПоля
	Элементы.ГруппаИнфПоля.Заголовок = "Информационные поля (" + Объект.ИнфПол.Количество() + ")";
	
	// ГруппаСопроводительные
	Элементы.ГруппаСопроводительные.Заголовок = "Сопроводительные документы (" + Объект.СопроводительныеДокументы.Количество() + ")";
	
	// ГруппаСпецУсловияДвижения
	Если Объект.СпецУслДвиж.Количество() = 0 Тогда 
		Элементы.ГруппаСпецУсловияДвижения.Заголовок = "Специальные условия движения (не указано)";
	Иначе
		Элементы.ГруппаСпецУсловияДвижения.Заголовок = "Специальные условия движения (указано)";
	КонецЕсли;
	
	// ГруппаДопПолучатели1
	Элементы.ГруппаДопПолучатели1.Заголовок = "Дополнительные получатели (" + Объект.ДополнительныеПолучателиФайла.Количество() + ")";
	
	// ГруппаДокументыОснования1
	Элементы.ГруппаДокументыОснования1.Заголовок = "Документы основания (" + Объект.ДокументыОснования.Количество() + ")";
	
	// ГруппаОтправкаУведомлений
	Если ЗначениеЗаполнено(Объект.УведомлениеОтказаНаТелефон) Или ЗначениеЗаполнено(Объект.УведомлениеОтказаНаАдресЭлектроннойПочты) Тогда 
		Элементы.ГруппаОтправкаУведомлений.Заголовок = "Уведомления об отказе (подключено)";
	Иначе
		Элементы.ГруппаОтправкаУведомлений.Заголовок = "Уведомления об отказе (не подключено)";
	КонецЕсли;
	
	// ORDERS DESADV INVOIC
	Если ЗначениеЗаполнено(Объект.НомераЗаказов) 
		Или ЗначениеЗаполнено(Объект.НомераDESADV) 
		Или ЗначениеЗаполнено(Объект.НомераУПД) Тогда
		
		Элементы.ГруппаEDI.Заголовок = "Уведомления об отказе (указано)";
		
	Иначе
		Элементы.ГруппаEDI.Заголовок = "Номера заказов, отгрузок, УПД (не указано)";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокОграничений()
	
	Счетчик = 0;
	Если ЗначениеЗаполнено(Объект.УказанияВОтношенииНормПеревозки) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОграничениеСкорости) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ТемператураНеНиже) Или ЗначениеЗаполнено(Объект.ТемператураНеВыше) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВлажностьНеНиже) Или ЗначениеЗаполнено(Объект.ВлажностьНеВыше) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Элементы.ГруппаОграничения.Заголовок = "Ограничения и указания (" + Счетчик + ")";

КонецПроцедуры

&НаКлиенте
Функция УстановитьЗаголовокСостояний()
	
	Если ЗначениеЗаполнено(Объект.СостояниеКузова)
		Или ЗначениеЗаполнено(Объект.СостояниеТары)
		Или ЗначениеЗаполнено(Объект.СведенияОПломбах)
		Или ЗначениеЗаполнено(Объект.СостояниеУпаковки) Тогда 
		
		Элементы.ГруппаСостояние.Заголовок = "Состояние груза, тары, упаковки, пломбы (заполнено)";
		
	Иначе
		
		Элементы.ГруппаСостояние.Заголовок = "Состояние груза, тары, упаковки, пломбы (не указано)";
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ТоварыДобавить(Команда)

	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	НоваяСтрока.Учитывать = Истина;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
		И КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ИспользуютсяХарактеристики() Тогда
		НоваяСтрока.Характеристика =  КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПустаяХарактеристика();
	КонецЕсли;
	
	Если Объект.СозданВручную Тогда
		
		ТипСправочникаНоменклатура = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяСправочникаНоменклатура");

		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы("Справочник."
																		   + ТипСправочникаНоменклатура
																		   + ".ФормаВыбора",
																		   ,
																		   ЭтаФорма,
																		   ЭтаФорма,
																		   "ОбработчикВыбораНоменклатуры",
																		   НоваяСтрока.ПолучитьИдентификатор());
		
	Иначе
	
		ПроверитьДокумент();
		ЗаполнитьТребуемыеДействияТоваров();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыСкопировать(Команда)
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.Учитывать = Истина;
	
	Если ТекСтрока <> Неопределено Тогда 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока,, "ИдентификаторСтроки");
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументЭТРННажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Ключ", Объект.ДокументЭТРН);
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ФормаОбъекта",
																   ПараметрыФормы,
																   ЭтаФорма,
																   ЭтаФорма,
																   "ОбработчикПерепроверить");
КонецПроцедуры

&НаКлиенте
Процедура ТоварыМассаПлановаяБруттоКгПриИзменении(Элемент)

	Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто")
		И Не ЗначениеЗаполнено(Объект.НомИспр) Тогда
		
		Объект.МассаБруттоКг = МассаПлановаяБруттоКгТоваров();
	КонецЕсли;

	ПроверитьДокумент();

КонецПроцедуры

