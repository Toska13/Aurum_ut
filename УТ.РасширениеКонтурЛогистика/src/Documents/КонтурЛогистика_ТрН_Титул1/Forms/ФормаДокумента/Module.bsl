		ТекОтметка = Элементы.ОтметкиГрузоотправителя.ТекущиеДанные;

		Если ТекОтметка <> Неопределено Тогда

			Элемент.ТекущиеДанные.ИдентификаторСтрокиОтметки = ТекОтметка.ИдентификаторСтроки;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметкиПриАктивизацииСтроки(Элемент)

	Если Элемент.ТекущиеДанные = Неопределено Тогда

		Элементы.Акты.ОтборСтрок 			= Неопределено;
		Элементы.Штрафы.ОтборСтрок 			= Неопределено;
		Элементы.ОтметкиИнфПол.ОтборСтрок 	= Неопределено;

	Иначе

		Элементы.Акты.ОтборСтрок 			= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки",
																			Элемент.ТекущиеДанные.ИдентификаторСтроки);
		Элементы.Штрафы.ОтборСтрок 			= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки",
																			  Элемент.ТекущиеДанные.ИдентификаторСтроки);

		Элементы.ОтметкиИнфПол.ОтборСтрок 	= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки",
																			  Элемент.ТекущиеДанные.ИдентификаторСтроки);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметкиДобавить(Команда)

	НоваяСтрока = Объект.ОтметкиГрузоотправителя.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	НоваяСтрока.ДатаИВремяОтметки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();

	ПроверитьДокумент();

