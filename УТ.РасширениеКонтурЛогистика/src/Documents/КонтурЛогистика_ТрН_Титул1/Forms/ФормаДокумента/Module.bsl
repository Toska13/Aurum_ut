// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ТоварыХарактеристика.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
												И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики") = Истина;
	
	ПриИзмененииОтправителяШаблона();
	
	Если Не ЗначениеЗаполнено(Объект.ДокументЭТРН.ДатаТрН) Тогда
		
		ПроставитьВЭТРН(Объект.ДокументЭТРН, "ДатаТрН", ТекущаяДатаСеанса());
		
		Если Не ЗначениеЗаполнено(Объект.ДокументЭТРН.НомерТрН) Тогда 
			ПроставитьВЭТРН(Объект.ДокументЭТРН, "НомерТрН", Формат(Объект.ДокументЭТРН.Номер, "ЧГ="));
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьДанныеФормы();
	
	Элементы.ДокументОснование.Доступность = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТипыДокументаОснованияНастроеныДляТитула(1);
	
	РазблокироватьДанныеФормыДляРедактирования();
	
	УправлениеЭлементамиФормыВЗависимостиОтСтатуса();
	
	// Нужен для удаления организации из ТЧ дополнительных получателей файла
	ПредОтправительШаблона = Объект.ОтправительШаблона;
	ПредСоставитель = Объект.Составитель;
	
	ЗаполнитьДатыПогрузкиЛокальные();
	ОбработатьСпособСозданияДокумента();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Баги старой платформы при отрисовке сложных группировок:
	// в режиме интерфейса 8.2 отображаем в режиме "на отдельных закладках" шапку и тч
	ШапкаНаОтдельнойЗакладке = Истина;
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаШапка;
		Элементы.Группа16.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.Группа14.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.ГруппаОграничения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	ПроверитьДокумент();
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
	// начальное отображение реквизитов
	Если Не ЗначениеЗаполнено(Объект.Водитель2) Тогда 
		Элементы.ГруппаВодитель2.Видимость = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РедактированиеЭТРН_Прицеп2) Тогда 
		Элементы.ГруппаПрицеп2.Видимость = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РедактированиеЭТРН_Прицеп) Тогда 
		Элементы.ГруппаПрицеп.Видимость = Ложь;
		Элементы.ГруппаКомандаДобавитьПрицеп.Видимость = Истина;
	Иначе
		Элементы.ГруппаКомандаДобавитьПрицеп.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьЗаголовкиГруппамДопПолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И (Параметр = Объект.Ссылка Или (Параметр <> Неопределено
																							И ТипЗнч(Параметр) = Тип("Массив")
																							И Параметр.Найти(Объект.Ссылка) <> Неопределено)) Тогда 
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();

	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьОткрытыеТитулы" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
			  И Параметр <> Неопределено
			  И ТипЗнч(Параметр) = Тип("Массив")
			  И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда

		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли  ИмяСобытия = "ЗавершениеФоновогоЗадания" 
			И Параметр <> Неопределено
			И ТипЗнч(Параметр) = Тип("Структура")
			И Параметр.Свойство("КлючФЗ")
			И Параметр.КлючФЗ = "Выполнение обмена колбаса" Тогда
			
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);

	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов"
			  И Параметр <> Неопределено
			  И ТипЗнч(Параметр) = Тип("Массив")
			  И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда

		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
			
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьВодителяПоУмолчанию" 
		И Параметр <> Неопределено
		И ТипЗнч(Параметр) = Тип("Структура") Тогда
		
		Объект.Водитель = Параметр.ВодительПоУмолчанию;
		Объект.Водитель2 = Параметр.Водитель2ПоУмолчанию;
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПунктМаршрута"
		И Параметр = РедактированиеЭТРН_МестоПогрузки Тогда
		
		ОбновитьЧасовыеПоясаМестаПогрузки();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЧасовыеПоясаМестаПогрузки()
	
	Перем НовыйЧасовойПояс;
	
	НовыйЧасовойПояс = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
	РедактированиеЭТРН_МестоПогрузки, "ЧасовойПояс");
	Если ЧасовойПоясПогрузки <> НовыйЧасовойПояс Тогда
		// Пересчитаем время
		ДатаВремяПодачиПлановая = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
		ДатаВремяПодачиПлановая, ЧасовойПоясПогрузки, НовыйЧасовойПояс);
		ДатаВремяПрибытия = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
		ДатаВремяПрибытия, ЧасовойПоясПогрузки, НовыйЧасовойПояс);
		ДатаВремяУбытия = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
		ДатаВремяУбытия, ЧасовойПоясПогрузки, НовыйЧасовойПояс);
		
		ЧасовойПоясПогрузки = НовыйЧасовойПояс;
		Элементы.ГруппаДатыИМеста.Заголовок = ЗаголовокДатИВременПогрузки(ЧасовойПоясПогрузки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ЗаполнитьТребуемыеДействияТоваров();
	Оповестить("КонтурЛогистика_ВвестиДокумент");
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСпособСозданияДокумента();
	
	Если Параметры.Свойство("СозданВручную") Тогда
		Объект.СозданВручную = Параметры.СозданВручную;
		ЭтаФорма.ТекущийЭлемент = Элементы.РедактированиеЭТРН_НомерТрН;
	Иначе 
		ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		НК_ДляРучногоВвода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(ТипЛогистическогоДокумента); 
		Объект.СозданВручную = ЗначениеЗаполнено(НК_ДляРучногоВвода) И Не ЗначениеЗаполнено(Объект.ДокументОснование);	 
	КонецЕсли;
		
КонецПроцедуры	 

&НаКлиенте
Процедура ПерезаполнитьПоДокОснованию(Команда)

	СписокКнопок = Новый СписокЗначений();
	СписокКнопок.Добавить("Да, и ЭТрН и Титул");
	СписокКнопок.Добавить("Да, только Титул");
	СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);

	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Полностью перезаполнить по документу-основанию?",
																  СписокКнопок,
																  "Подтвердите операцию",
																  ,
																  ЭтаФорма,
																  "ОбработчикСогласияПерезаполнения");

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСогласияПерезаполнения(Ответ, ДопПараметр = Неопределено) Экспорт

	Если Ответ = "Да, и ЭТрН и Титул" Тогда
		ПерезаполнитьПоДокОснованиюСервер(Истина);
		ОбновитьДанныеФормы();
	ИначеЕсли Ответ = "Да, только Титул" Тогда
		ПерезаполнитьПоДокОснованиюСервер(Ложь);
		ОбновитьДанныеФормы();
	КонецЕсли;

	Элементы.ПерезаполнитьПоДокОснованию.ЦветТекста = ЦветаСтиляЦветТекстаФормы();
	ОбновитьОтображениеДанных();
	ПолностьюОбновитьПредставлениеДанных();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦветаСтиляЦветТекстаФормы()
	
	Возврат ЦветаСтиля.ЦветТекстаФормы;
	
КонецФункции

&НаКлиенте
Процедура ОтправительШаблонаПриИзменении(Элемент)

	ПриИзмененииОтправителяШаблона();

КонецПроцедуры

&НаКлиенте
Процедура ОтправительШаблонаДопПриИзменении(Элемент)

	ПриИзмененииОтправителяШаблона();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()

	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.ДокументЭТРН);
	КодТекущегоСтатусаДокументооборота = ТекущийСтатусДокументооборота.Код;
	КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Объект.Ссылка);
	
	ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	
	НастройкаКонвертацииДляРучногоВвода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(ТипЛогистическогоДокумента); 
	РучнойВвод = Объект.СозданВручную;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		 Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда
		ПерешелВЛогистическиеСтатус = Истина;
	Иначе
		ПерешелВЛогистическиеСтатус = Ложь;
	КонецЕсли;
	Элементы.ТекущийСтатус.Видимость = Не ПерешелВЛогистическиеСтатус;
	Элементы.ТекущийСтатусДокументооборота.Видимость = ПерешелВЛогистическиеСтатус;

	ПересчитатьЗаголовкиКоличества(ЭтаФорма);

	// Элементы.ДокументЭТРНПогрузкаСотрудник.Видимость = ЗначениеЗаполнено(Объект.ДокументЭТРН.ПогрузкаСотрудник);
	
	ЕстьЭЗЗ = ЗначениеЗаполнено(Объект.ДокументЭТРН.ЗаказЗаявкаОснование);
	Элементы.ДокументЭТРНЗаказЗаявкаОснование.Видимость = ЕстьЭЗЗ;
	Элементы.ДокументЭТРННомЗак.Видимость 				= НЕ ЕстьЭЗЗ И ЗначениеЗаполнено(Объект.ДокументЭТРН.НомЗак);
	Элементы.ДокументЭТРНДатаЗак.Видимость 				= НЕ ЕстьЭЗЗ И ЗначениеЗаполнено(Объект.ДокументЭТРН.ДатаЗак);
	
	Элементы.ДокументЭТРНПрицеп.Видимость = ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп);
	Элементы.ДокументЭТРНПрицеп2.Видимость = ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп2);
	
	Элементы.РедактированиеЭТРН_НомерТрН.Видимость = НЕ ЗначениеЗаполнено(Объект.ДокументЭТРН.НомерТрН);
	Элементы.РедактированиеЭТРН_ДатаТрН.Видимость = НЕ ЗначениеЗаполнено(Объект.ДокументЭТРН.ДатаТрН);
	
	УИД_ТрН = Объект.ДокументЭТРН.УИД;
	
	Элементы.ГруппаЭкспедиция.Видимость = Объект.ДокументЭТРН.ЭтоЭкспедиция = Истина;
	
	ЭтоВходящий = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен;
	ЕстьДокУчСист = ЗначениеЗаполнено(Объект.ДокументОснование);
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = ЭтоВходящий И Не ЕстьДокУчСист;

	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		 Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
		 Или (ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен И Справочники.КонтурЛогистика_ФайлыОбмена.ЭтоВходящийНеподписанный(КрайнийФайл))
		 Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
		 ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	Элементы.ПерезаполнитьПоДокОснованию.Видимость = (Не ЭтоВходящий И (ЕстьДокУчСист Или РучнойВвод))
													Или (ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен 
														И ТекущийСтатусДокументооборота = КонтурЛогистика_ОбработкаДокументовСервер.НайтиСостояниеДОПоКоду("r-wait-storekeeper"));
	Элементы.ОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = Не ЕстьДокУчСист;
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(
		Объект.Ссылка, Объект.ДокументОснование,
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус, ТребуемоеДействие);
	
	Если Объект.ЭтоПрототип Или (ЗначениеЗаполнено(Объект.Составитель) И Объект.Составитель <> Объект.ДокументЭТРН.Грузоотправитель) Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Отправить прототип в сервис";
	ИначеЕсли ЗначениеЗаполнено(Объект.ОтправительШаблона) Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Отправить шаблон грузоотправителю";
	КонецЕсли;
	
	// Погрузка, Отказ
	Если КодТекущегоСтатусаДокументооборота = "r-rejected" Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Создать Титул 1 с уточнениями";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = Истина;
	КонецЕсли;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ТипЛогистическогоДокумента);
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость =
			КонтурЛогистика_ОбработкаДокументовСервер.ДокументМожноОтправлять(Объект.Ссылка, НастройкаКонвертации);
	КонецЕсли;
	
	ДоступностьQR = ЗначениеЗаполнено(Объект.ДокументЭТРН.kl_id);
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод.Видимость = ДоступностьQR;
	
	ЗаполнитьВспомогательныеРеквизитыРедактированияЭТРН();
			
	ОтрисоватьДокументыОснованияСервер();
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы.Видимость = СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы;
	 	
	КомментарииВодителяПриПогрузке = Объект.ДокументЭТРН.КомментарииВодителяПриПогрузке;
	Элементы.КомментарииВодителяПриПогрузке.Видимость = ЗначениеЗаполнено(КомментарииВодителяПриПогрузке);
	
	Если Элементы.Найти("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителюПанель") <> Неопределено Тогда
		Если ЗначениеЗаполнено(КомментарииВодителяПриПогрузке) Тогда
			
			Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителюПанель.Видимость =
				(Не ТолькоПросмотр
					И (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
						Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный));
			
		Иначе
			Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителюПанель.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьДокументыОснованияСервер()
	
	КоличествоОснований = Объект.ДокументыОснования.Количество();
	Если КоличествоОснований > 1 Тогда 
		Элементы.ДекорацияНесколькоОснований.Видимость = Истина;
		Элементы.ДокументОснование.Видимость = Ложь;
		Элементы.ДекорацияНесколькоОснований.Заголовок = "" + КоличествоОснований + " документов-оснований";
	Иначе
		Элементы.ДекорацияНесколькоОснований.Видимость = Ложь;
		Элементы.ДокументОснование.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтрисоватьДокументыОснованияКлиент()
	
	КоличествоОснований = Объект.ДокументыОснования.Количество();
	Если КоличествоОснований > 1 Тогда 
		Элементы.ДекорацияНесколькоОснований.Видимость = Истина;
		Элементы.ДокументОснование.Видимость = Ложь;
		Элементы.ДекорацияНесколькоОснований.Заголовок = "" + КоличествоОснований + " документов-оснований";
	Иначе
		Элементы.ДекорацияНесколькоОснований.Видимость = Ложь;
		Элементы.ДокументОснование.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВспомогательныеРеквизитыРедактированияЭТРН()

	ДокЭТРН = Объект.ДокументЭТРН;
	
	Если ЗначениеЗаполнено(ДокЭТРН) Тогда 
		
		РедактированиеЭТРН_ТранспортноеСредство = ДокЭТРН.ТранспортноеСредство;
		РедактированиеЭТРН_Прицеп = ДокЭТРН.Прицеп;
		РедактированиеЭТРН_Прицеп2 = ДокЭТРН.Прицеп2;
		РедактированиеЭТРН_ПогрузкаСотрудник = ДокЭТРН.ПогрузкаСотрудник;
		РедактированиеЭТРН_МестоПогрузки = ДокЭТРН.МестоПогрузки;
		РедактированиеЭТРН_МестоДоставки = ДокЭТРН.МестоДоставки;
		
		РедактированиеЭТРН_Грузоотправитель = ДокЭТРН.Грузоотправитель;
		РедактированиеЭТРН_Перевозчик = ДокЭТРН.Перевозчик;
		РедактированиеЭТРН_Грузополучатель = ДокЭТРН.Грузополучатель;
		РедактированиеЭТРН_ПогрузкуОсуществляет = ДокЭТРН.ПогрузкуОсуществляет;
		
		РедактированиеЭТРН_НомерТрН = ДокЭТРН.НомерТрН;
		РедактированиеЭТРН_ДатаТрН = ДокЭТРН.ДатаТрН;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер(ПерезаполнятьЭТРН = Ложь)

	Если Не Объект.СозданВручную Тогда
		Объект.Товары.Очистить();
		Объект.Маркировки.Очистить();
		Объект.ОпасныеГрузы.Очистить();
		Объект.Контейнеры.Очистить();
		Объект.ТелефоныПереадресующего.Очистить();
		Объект.ДополнительныеВодители.Очистить();
		Объект.СведенияГосСистем.Очистить();
		Объект.ИнфПол.Очистить();
	КонецЕсли;
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", ДокОбъект.ДокументОснование);
	ДанныеЗаполнения.Вставить("ТипЛогистика", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
	ДанныеЗаполнения.Вставить("Разделитель", ДокОбъект.Разделитель);
	ДанныеЗаполнения.Вставить("ПерезаполнитьГлавныйДокументЕслиСуществует", ПерезаполнятьЭТРН);
	
	ДокОбъект.Заполнить(ДанныеЗаполнения);
	
	СвязанныйДокумент = РегистрыСведений.КонтурЛогистика_СвязиДокументов.СвязанныйДокумент(Объект.Ссылка);
	Если СвязанныйДокумент.ДокументПодчиненный = Объект.Ссылка Тогда
		НастройкиСвязи = Справочники.КонтурЛогистика_НастройкиСвязейДокументов.НастройкиСвязиДокументовПодчиненных(
			СвязанныйДокумент.ТипДокументаПодчиненный);
		Для Каждого ТекущаяНастройка Из НастройкиСвязи Цикл
			Если ТекущаяНастройка.ТипДокументаОсновной = СвязанныйДокумент.ТипДокументаОсновной
				И ТекущаяНастройка.ТипДокументаПодчиненный = СвязанныйДокумент.ТипДокументаПодчиненный
				И ТекущаяНастройка.РасчетОснованияЗаполнения_Расчитывать
				И ЗначениеЗаполнено(ТекущаяНастройка.НастройкиКонвертацииПодчиненного) Тогда
				
				// Заполним из конверации связей
				КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
					ДокОбъект, ТекущаяНастройка.НастройкиКонвертацииПодчиненного, СвязанныйДокумент.ДокументОсновной,, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	Модифицированность = Истина;
		
	ПриИзмененииОтправителяШаблона();

КонецПроцедуры

&НаКлиенте
Процедура ПолностьюОбновитьПредставлениеДанных()

	//УстановитьТипыЗначенийРеквизитов(); // TODO

	ОповеститьОбИзменении(Объект.ДокументЭТРН);
	ЗаполнитьПредставлениеРеквизитовДокументаОснования();

	ЗаполнитьТребуемыеДействияТоваров();
	ПроверитьДокумент(); // вызовет УправлениеВидимостьюИДоступностью();

КонецПроцедуры

// УПРАВЛЕНИЕ ВИДИМОСТЬЮ И ДОСТУПНОСТЬЮ
&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()

	УстановитьПоложениеСохраняемыхЭлементов();
	УстановитьФорматыКолонокСКоличеством();

	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	РеквизитыЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		Объект.ДокументЭТРН, "Грузоотправитель, ПогрузкуОсуществляет");
	Элементы.ГруппаОтправляющийСклад.Видимость =
		(ЗначениеЗаполнено(РеквизитыЭТРН.ПогрузкуОсуществляет) И РеквизитыЭТРН.ПогрузкуОсуществляет <> РеквизитыЭТРН.Грузоотправитель);
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляТРН") Тогда

		Элементы.УИД_ТрН.ПодсказкаВвода = "взять из пула";

	Иначе

		Элементы.УИД_ТрН.ПодсказкаВвода = "получим после отправки";

	КонецЕсли;

	Элементы.РазделительИндикатор.Видимость = ЗначениеЗаполнено(Объект.Разделитель);
	
	УстановитьВидимостьНоменклатуры();
		
	Элементы.ГруппаСоставитель.Видимость = Объект.ЭтоПрототип;
	Элементы.Составитель.Видимость = ЗначениеЗаполнено(Объект.Составитель);
	
	СкрытьПоказатьЗначенияДокУчСист();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНоменклатуры()
	
	// видимость номенклатуры в зависимости от того есть ли там номенклатура (она есть если отправляли Т1 из этой базы) 
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаНоменклатура);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыХарактеристика);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаЕдиницы);	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФорматыКолонокСКоличеством()

	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "МассаПлановаяНеттоКг",
																			 Элементы.ТоварыМассаПлановаяНеттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "МассаПлановаяБруттоКг",
																			 Элементы.ТоварыМассаПлановаяБруттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "Количество",
																			 Элементы.ТоварыКоличество);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "Плотность",
																			 Элементы.ТоварыПлотность);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеСохраняемыхЭлементов()

	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	УстановитьПоложениеШапки();
	УстановитьСвернутостьПодробностейОТоварах();

КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормыВЗависимостиОтСтатуса()
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
		Или ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке")
		Или ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена")
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю
		Или (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
			И ЗначениеЗаполнено(КомментарииВодителяПриПогрузке)) Тогда
		
		ТолькоПросмотр = Ложь;
		Элементы.ГруппаИсправление.Видимость = Объект.НомИспр > 0;
		Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
			Элементы.ВнестиИсправлениеТитула.Видимость = Ложь;
		КонецЕсли;
		
		Если Объект.НомИспр > 0 Тогда
			
			Для Каждого ИмяЭлемента Из Документы.КонтурЛогистика_ТрН_Титул1.МассивЭлементовНедоступныхДляИсправления() Цикл
				
				Элемент = Элементы.Найти(ИмяЭлемента);
				Если Не Элемент = Неопределено Тогда
					Элемент.Доступность = Ложь;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// особенности поведения формы для полученного титула - если сценарий предусматривает подписание - надо проставить подписанта
		Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда
			
			НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
				Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, Объект.ДокументОснование);
			КрайнийФайлДокумента = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Объект.Ссылка);
			
			Если ЗначениеЗаполнено(НастройкаКонвертации)
				И (НастройкаКонвертации.Сценарий_РазрешитьПодписыватьПолученныйЧерновик
					Или НастройкаКонвертации.Сценарий_ОтправлятьНеподписанный)
				И НастройкаКонвертации.ПодписантТекущийПользователь
				И КрайнийФайлДокумента <> Неопределено
				И Не КрайнийФайлДокумента.ПодписьВерна Тогда
				
				ТолькоПросмотр = Ложь;
				Элементы.ГруппаИсправление.Видимость = Ложь;
				Попытка
					Объект.ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
					ЭтаФорма.Модифицированность = Истина;
				Исключение
				КонецПопытки;
				
			Иначе
				
				ТолькоПросмотр = Истина;
				Элементы.ГруппаИсправление.Видимость = Истина;
				Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
					Элементы.ВнестиИсправлениеТитула.Видимость = (Не ЗначениеЗаполнено(Объект.ОтправительШаблона)
						И ТребуемоеДействие <> Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
						И Объект.ДокументЭТРН.Грузоотправитель.Наш);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ТолькоПросмотр = Истина;
		Элементы.ГруппаИсправление.Видимость = Не ЗначениеЗаполнено(Объект.ОтправительШаблона);
		Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
			Элементы.ВнестиИсправлениеТитула.Видимость = (Не ЗначениеЗаполнено(Объект.ОтправительШаблона)
				И ТребуемоеДействие <> Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
				И Объект.ДокументЭТРН.Грузоотправитель.Наш);
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ТоварыСкопировать.Видимость 					= Не ТолькоПросмотр;
	Элементы.ТоварыДобавить.Видимость 						= Не ТолькоПросмотр;
	Элементы.ТоварыГруппаТребуемоеДействие.Видимость 		= Не ТолькоПросмотр;
	Элементы.ТоварыГруппаУправление.Видимость 				= Не ТолькоПросмотр;
	Элементы.ОтметкиОтметкиДобавить.Видимость 				= Не ТолькоПросмотр;
	Элементы.ОтметкиОтметкиСкопировать.Видимость 			= Не ТолькоПросмотр;
	Элементы.ПерезаполнитьПоДокОснованию.Видимость 			= Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяПрибытияТекущим.Видимость 	= Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяУбытияТекущим.Видимость 	= Не ТолькоПросмотр;
	
	УстановитьДоступностьКоманд(Не ТолькоПросмотр);
	
	// Погрузка, Отказ
	Если КодТекущегоСтатусаДокументооборота = "r-rejected" Тогда
		Элементы.ГруппаИсправление.Видимость = Ложь;
		Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
			Элементы.ВнестиИсправлениеТитула.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКоманд(Доступность)
	
	УстановитьДоступностьЭлемента("ФормаЗаписать", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СформироватьФайлыОбмена", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителю", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПропуститьДокумент", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОбработатьВходящийДокумент", Доступность);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлемента(ИмяЭлемента, Доступность)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйЭлемент.Доступность = Доступность;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОтправителяШаблона()

	ОтправительШаблонаУправлениеВидимостью();
	ИзменитьДопПолучателя(Объект.ОтправительШаблона, ПредОтправительШаблона);

	ПредОтправительШаблона = Объект.ОтправительШаблона;

КонецПроцедуры

&НаСервере
Процедура ОтправительШаблонаУправлениеВидимостью()

	Элементы.ГруппаОтправительШаблона.Видимость = ЗначениеЗаполнено(Объект.ОтправительШаблона);

КонецПроцедуры

&НаСервере
Процедура ИзменитьДопПолучателя(НовыйДопПолучатель, ПредДопПолучатель)

	Если ЗначениеЗаполнено(НовыйДопПолучатель) 
		И Не НовыйДопПолучатель = ПредДопПолучатель  
		И Не Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ЯвляетсяУчастникомПеревозки(НовыйДопПолучатель, Объект.ДокументЭТРН) Тогда

		нСтроки = Объект.ДополнительныеПолучателиФайла.НайтиСтроки(Новый Структура("ОрганизацияДиадок", НовыйДопПолучатель));
		Если Не нСтроки.Количество() Тогда
			НовыйПолучатель = Объект.ДополнительныеПолучателиФайла.Добавить();
			НовыйПолучатель.ОрганизацияДиадок = НовыйДопПолучатель;
		КонецЕсли;

	КонецЕсли;

	Если ЗначениеЗаполнено(ПредДопПолучатель) И Не НовыйДопПолучатель = ПредДопПолучатель Тогда
		нСтроки = Объект.ДополнительныеПолучателиФайла.НайтиСтроки(Новый Структура("ОрганизацияДиадок", ПредДопПолучатель));
		Для Каждого НайденнаяСтрока Из нСтроки Цикл
			Объект.ДополнительныеПолучателиФайла.Удалить(НайденнаяСтрока);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

