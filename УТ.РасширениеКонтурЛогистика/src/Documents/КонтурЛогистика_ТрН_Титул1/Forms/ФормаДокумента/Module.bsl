// Обработчики для требуемых действий

&НаКлиенте
Процедура ОбработатьТребуемоеДействие(ТребуемоеДействие, ПолеТаблицыОшибок = Неопределено)
	
	// реализуем отдельную обработку некоторых требуемых действий
	Если Ложь Тогда // Какие-то особенные UI для требуемых действий, например: ТребуемоеДействие = "Исправить GTIN" Тогда

	Иначе // типовая обработка таблицы ошибок

		Если ПолеТаблицыОшибок <> Неопределено Тогда
			КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, ПолеТаблицыОшибок.Имя);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСоответствияТекущейСтроки()

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда
		
		ТекстПредупреждения = "Табличная часть пуста! Сначала добавьте товар.";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПредупреждения);	
		
	Иначе
	
		текНоменклатура 	= ТекущиеДанные.Номенклатура;
		текЕдиница 			= ТекущиеДанные.УпаковкаЕдиницаИзмерения;
		текХарактеристика 	= ТекущиеДанные.Характеристика;
		
		КонтурЛогистика_КонвертацияКлиент.ОткрытьСоответствияНоменклатуры(текНоменклатура, текЕдиница, текХарактеристика, ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаТЧПоИдентификаторуСтроки(ИдСтрокиТоваров)
	Строки = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдСтрокиТоваров));
	Возврат Строки[0];	
КонецФункции

&НаКлиенте
Процедура ОбработчикВыбораНоменклатуры(ВыбранноеЗначение, ПараметрИдСтрокиТоваров) Экспорт

	Если ВыбранноеЗначение <> Неопределено Тогда

		ТекДанные = Объект.Товары.НайтиПоИдентификатору(ПараметрИдСтрокиТоваров);
		
		ТекДанные.Номенклатура = ВыбранноеЗначение;

		ОбработчикПереконвертироватьСтроку(ПараметрИдСтрокиТоваров, ТекДанные);
		
		УстановитьВидимостьНоменклатуры();

		ПересчитатьДанныеСтрокиТЧТовары(ТекДанные);
		
		УправлениеВидимостьюИДоступностью();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьДанныеСтрокиТЧТовары(ТекДанные)
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест") Тогда
		КоличествоМест = 0;
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			Объект.КоличествоМест = Объект.КоличествоМест + ТекущаяСтрока.КоличествоМест;
		КонецЦикла;
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто") Тогда
		МассаБруттоКг = 0;
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			Объект.МассаБруттоКг = Объект.МассаБруттоКг + ТекущаяСтрока.МассаПлановаяБруттоКг;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораЕдиницыИзмерения(ВыбранноеЗначение, ПараметрИдСтрокиТоваров) Экспорт

	Если ВыбранноеЗначение <> Неопределено Тогда

		ТекДанные = Объект.Товары.НайтиПоИдентификатору(ПараметрИдСтрокиТоваров);
		ТекДанные.УпаковкаЕдиницаИзмерения = ВыбранноеЗначение;

		ОбработчикПереконвертироватьСтроку(ПараметрИдСтрокиТоваров, ТекДанные);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПереконвертироватьСтроку(ИдСтрокиТоваров, ТекДанные)

	СконвертироватьСтрокуТоваровКлиент(ИдСтрокиТоваров);
	СформироватьТребуемоеДействиеСтрокиТовара(ТекДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикИзмененияСоответствий(Параметр, ДопПараметр) Экспорт

	Если ЗначениеЗаполнено(ДопПараметр) Тогда

		локМассивСтрокСЭтойНоменклатурой = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ДопПараметр));
		локМассивИдентификаторов = Новый Массив();

		Для Каждого СтрокаПереконвертации Из локМассивСтрокСЭтойНоменклатурой Цикл

			СконвертироватьСтрокуТоваровКлиент(СтрокаПереконвертации.ПолучитьИдентификатор());
			локМассивИдентификаторов.Добавить(СтрокаПереконвертации.ИдентификаторСтроки);

		КонецЦикла;

		ПолностьюОбновитьПредставлениеДанных();

		ТоварыКоличествоМестПриИзменении(Неопределено);
		ТоварыМассаПлановаяБруттоКгПриИзменении(Неопределено);

		ПересчитатьЗаголовкиКоличества(ЭтаФорма);

		Модифицированность = Истина;

	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура СконвертироватьСтрокуПриРучномИзменении(ПараметрИдСтрокиТоваров)
	
	СконвертироватьСтрокуТоваровКлиент(ПараметрИдСтрокиТоваров);
	
	ТоварыКоличествоМестПриИзменении(Неопределено);
	ТоварыМассаПлановаяБруттоКгПриИзменении(Неопределено);

	ПересчитатьЗаголовкиКоличества(ЭтаФорма);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СконвертироватьСтрокуТоваровКлиент(ИдентификаторСтрокиТоваров)

	ТекСтрока = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтрокиТоваров);

	Если (ЗначениеЗаполнено(ТекСтрока.Номенклатура) И ЗначениеЗаполнено(ТекСтрока.УпаковкаЕдиницаИзмерения)) 
	      Или Объект.СозданВручную Тогда
		СконвертироватьСтрокуТоваров1СвЛогистика(ИдентификаторСтрокиТоваров, НастройкаКонвертацииДляРучногоВвода);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СконвертироватьСтрокуТоваров1СвЛогистика(ИдентификаторСтрокиТоваров, НастройкаКонвертацииДляРучногоВввода = Неопределено)

	СтрокаТоваров = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтрокиТоваров);

	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.СконвертироватьСтрокуТоваров1СвЛогистика(СтрокаТоваров.НомерСтроки, НастройкаКонвертацииДляРучногоВввода);

	ЗаполнитьЗначенияСвойств(СтрокаТоваров, ДокОбъект.Товары[СтрокаТоваров.НомерСтроки - 1]);
	// маркировки проч не переносим т.к. можно потерять данные

КонецПроцедуры

