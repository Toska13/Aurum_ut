#Область ДатаВремяПогрузки

&НаСервере
Процедура ЗаполнитьДатыПогрузкиЛокальные()
	
	Если Не ЗначениеЗаполнено(Объект.ДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыЭТРН = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(
		Объект.ДокументЭТРН, "ДатаВремяДоставки, МестоПогрузки");
	Если ЗначениеЗаполнено(РеквизитыЭТРН.МестоПогрузки) Тогда
		ЧасовойПоясПогрузки = РеквизитыЭТРН.МестоПогрузки.ЧасовойПояс;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		ДатаВремяПодачиПлановая = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ДатаВремяПодачиПлановая, Неопределено, ЧасовойПоясПогрузки);
		ДатаВремяПрибытия = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ДатаВремяПрибытия, Неопределено, ЧасовойПоясПогрузки);
		ДатаВремяУбытия = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ДатаВремяУбытия, Неопределено, ЧасовойПоясПогрузки);
		ДатаВремяДоставки = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			РеквизитыЭТРН.ДатаВремяДоставки, Неопределено, ЧасовойПоясПогрузки);
	Иначе
		ДатаВремяПодачиПлановая = Объект.ДатаВремяПодачиПлановая;
		ДатаВремяПрибытия = Объект.ДатаВремяПрибытия;
		ДатаВремяУбытия = Объект.ДатаВремяУбытия;
		ДатаВремяДоставки = РеквизитыЭТРН.ДатаВремяДоставки;
	КонецЕсли;
	
	Элементы.ГруппаДатыИМеста.Заголовок = ЗаголовокДатИВременПогрузки(ЧасовойПоясПогрузки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДатуПогрузкиОбъекта(Форма, ЧасовойПоясПогрузки, ИмяРеквизита)
	
	РеквизитФормы = Форма[ИмяРеквизита];
	
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		Форма.Объект[ИмяРеквизита] = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(РеквизитФормы, ЧасовойПоясПогрузки);
	Иначе
		Форма.Объект[ИмяРеквизита] = РеквизитФормы;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокДатИВременПогрузки(ЧасовойПояс)
	
	Заголовок = "Даты и время";
	
	Если ЗначениеЗаполнено(ЧасовойПояс) Тогда
		Заголовок = Заголовок + " " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(ЧасовойПояс);
	КонецЕсли;
	
	Возврат Заголовок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекущаяДатаВЧасовомПоясе(ЧасовойПояс)
	
	Если ЗначениеЗаполнено(ЧасовойПояс) Тогда
		Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(ТекущаяДата(), Неопределено, ЧасовойПояс);
	Иначе
		Возврат ТекущаяДата();
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ЕГАИС

&НаКлиенте
Процедура ИзменитьСведенияГосСистемДляЕГАИС()
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторыЕГАИС) Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиТоваров", ТекДанные.ИдентификаторСтроки);
		Отбор.Вставить("НаимГосСист", "ЕГАИС");
				
		Найд = Объект.СведенияГосСистем.НайтиСтроки(Отбор);		
		Для каждого Стр Из Найд Цикл
			Объект.СведенияГосСистем.Удалить(Стр);	
		КонецЦикла;
		
		ИдентификаторыЕГАИС = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ТекДанные.ИдентификаторыЕГАИС, ";", Ложь);
		
		Для каждого Идентификатор Из ИдентификаторыЕГАИС Цикл
			
			НоваяСтрока = Объект.СведенияГосСистем.Добавить();
			НоваяСтрока.ИдентификаторСтрокиТоваров = ТекДанные.ИдентификаторСтроки;
			НоваяСтрока.НаимГосСист = "ЕГАИС";
			НоваяСтрока.ИдНомУчетЕд = СокрЛП(Идентификатор);
						
		КонецЦикла;
		
		ТекДанные.УчетГрузаВГИС = Истина;
		
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиТоваров", ТекДанные.ИдентификаторСтроки);
		Отбор.Вставить("НаимГосСист", "ЕГАИС");
				
		Найд = Объект.СведенияГосСистем.НайтиСтроки(Отбор);		
		Для каждого Стр Из Найд Цикл
			Объект.СведенияГосСистем.Удалить(Стр);	
		КонецЦикла;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиТоваров", ТекДанные.ИдентификаторСтроки);
		Найд = Объект.СведенияГосСистем.НайтиСтроки(Отбор);
		Если Найд.Количество() = 0 Тогда
			ТекДанные.УчетГрузаВГИС = Ложь;	
		КонецЕсли;
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПерезаписатьИдентификаторыЕГАИС()	
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
		
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторСтрокиТоваров", ТекДанные.ИдентификаторСтроки);
	Отбор.Вставить("НаимГосСист", "ЕГАИС");
	
	ИдентификаторыЕГАИС = "";
	Найд = Объект.СведенияГосСистем.НайтиСтроки(Отбор);
	ид = 1;
	Для каждого Стр Из Найд Цикл
		
		Если ид = Найд.Количество() Тогда
			ИдентификаторыЕГАИС = ИдентификаторыЕГАИС + Стр.ИдНомУчетЕд;
		Иначе
			ИдентификаторыЕГАИС = ИдентификаторыЕГАИС + Стр.ИдНомУчетЕд + "; ";
		КонецЕсли;
		
		ид = ид + 1;
		
	КонецЦикла;
	
	ТекДанные.ИдентификаторыЕГАИС = ИдентификаторыЕГАИС;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторСтрокиТоваров", ТекДанные.ИдентификаторСтроки);		
	Найд = Объект.СведенияГосСистем.НайтиСтроки(Отбор);
	Если Найд.Количество() = 0 Тогда
		ТекДанные.УчетГрузаВГИС = Ложь;	
	КонецЕсли;	
		
КонецПроцедуры

