&НаКлиенте
Процедура РедактированиеЭТРН_ЛюбойРеквизит_ПриИзменении(Элемент)
	
	текЗначение = ЭтаФорма[Элемент.Имя];
	ПолеЭТРН =  СтрЗаменить(Элемент.Имя, "РедактированиеЭТРН_", "");
	
	РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере(ПолеЭТРН, текЗначение);
	
	Если ПолеЭТРН = "ТранспортноеСредство" Тогда 
		
		Если ЗначениеЗаполнено(текЗначение) Тогда
			
			ПрицепПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(текЗначение, "ПрицепПоУмолчанию");
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("Прицеп", ПрицепПоУмолчанию);
			РедактированиеЭТРН_Прицеп = ПрицепПоУмолчанию;
			
			Прицеп2ПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(текЗначение, "Прицеп2ПоУмолчанию");
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("Прицеп2", Прицеп2ПоУмолчанию);
			РедактированиеЭТРН_Прицеп2 = Прицеп2ПоУмолчанию;
			
		Иначе
			
			ПрицепПустаяСсылка = ПредопределенноеЗначение("Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка");
			
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("Прицеп", ПрицепПустаяСсылка);
			РедактированиеЭТРН_Прицеп = ПрицепПустаяСсылка;
			
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("Прицеп2", ПрицепПустаяСсылка);
			РедактированиеЭТРН_Прицеп2 = ПрицепПустаяСсылка;
			
		КонецЕсли;
		
	ИначеЕсли ПолеЭТРН = "Перевозчик" Тогда
		
		Перевозчик = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.ДокументЭТРН, "Перевозчик");
		Если Не ЗначениеЗаполнено(Перевозчик) Тогда
			Возврат;
		КонецЕсли;
		
		ТранспортноеСредствоПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Перевозчик, "ТранспортноеСредствоПоУмолчанию");
		ВодительПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Перевозчик, "ВодительПоУмолчанию");
		Водитель2ПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Перевозчик, "Водитель2ПоУмолчанию");
		
		ИспользуютсяРеквизитыПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИспользуютсяРеквизитыПоУмолчаниюВОрганизации();
		
		Если ИспользуютсяРеквизитыПоУмолчанию Тогда
			Объект.Водитель = ВодительПоУмолчанию;
			Объект.Водитель2 = Водитель2ПоУмолчанию;
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("ТранспортноеСредство", ТранспортноеСредствоПоУмолчанию);
		КонецЕсли;
		
		Если ИспользуютсяРеквизитыПоУмолчанию Тогда
			
			Если ЗначениеЗаполнено(ТранспортноеСредствоПоУмолчанию) Тогда
				ПрицепПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
					ТранспортноеСредствоПоУмолчанию, "ПрицепПоУмолчанию");	
				Прицеп2ПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
					ТранспортноеСредствоПоУмолчанию, "Прицеп2ПоУмолчанию");
			Иначе
				ПрицепПоУмолчанию = ПредопределенноеЗначение("Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка");
				Прицеп2ПоУмолчанию = ПредопределенноеЗначение("Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка");
			КонецЕсли;
			
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("Прицеп", ПрицепПоУмолчанию);
			РедактированиеЭТРН_Прицеп = ПрицепПоУмолчанию;
			
			РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере("Прицеп2", Прицеп2ПоУмолчанию);
			РедактированиеЭТРН_Прицеп2 = Прицеп2ПоУмолчанию;
			
		КонецЕсли;
		
	ИначеЕсли ПолеЭТРН = "Грузоотправитель" 
		И Объект.ИнициаторПереадресации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель") Тогда
		
		текГО = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.ДокументЭТРН, "Грузоотправитель");
		
		Если ЗначениеЗаполнено(текГО) Тогда
			УстановитьТелефонПереадресацииИзОсновногоТелефонаОрганизации(текГО);
		КонецЕсли;
	
	ИначеЕсли ПолеЭТРН = "Грузополучатель" 
		И Объект.ИнициаторПереадресации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ИнициаторыПереадресовки.Грузополучатель") Тогда
		
		текГП = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.ДокументЭТРН, "Грузополучатель");
		
		Если ЗначениеЗаполнено(текГП) Тогда
			УстановитьТелефонПереадресацииИзОсновногоТелефонаОрганизации(текГП);
		КонецЕсли;
		
	ИначеЕсли ПолеЭТРН = "МестоПогрузки" Тогда 
		
		ОбновитьЧасовыеПоясаМестаПогрузки();
	
	КонецЕсли;
	
	ОповеститьОбИзменении(Объект.ДокументЭТРН);
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТелефонПереадресацииИзОсновногоТелефонаОрганизации(ОрганизацияДДСсылка)
	
	Если ЗначениеЗаполнено(ОрганизацияДДСсылка) Тогда
				
		ТелефоныПАМассив = ТелефоныПередресующего(ОрганизацияДДСсылка);
		Если ТелефоныПАМассив.Количество() > 0  Тогда
			Объект.ТелефоныПереадресующего.Очистить();
			Для Каждого ТелПА из ТелефоныПАМассив Цикл 
				НоваяСтрокаПА = Объект.ТелефоныПереадресующего.Добавить();
				НоваяСтрокаПА.Телефон = ТелПА;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТелефоныПередресующего(ОрганизацияДДСсылка)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТелефоныПереадресующего(ОрганизацияДДСсылка);
	
КонецФункции

&НаСервере
Процедура РедактированиеЭТРН_Реквизит_ПриИзмененииНаСервере(ВКакойРеквизитИмя, УстанавливаемоеЗначение)
	
	ПроставитьВЭТРН(Объект.ДокументЭТРН, ВКакойРеквизитИмя, УстанавливаемоеЗначение);
	
	// автоопределение партнера
	Если ВКакойРеквизитИмя = "Грузоотправитель" Тогда
		
		Если ЗначениеЗаполнено(УстанавливаемоеЗначение) Тогда 
			ПартнерГрузоотправитель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(УстанавливаемоеЗначение);
		Иначе
			ПартнерГрузоотправитель = Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
		КонецЕсли;
		ПроставитьВЭТРН(Объект.ДокументЭТРН, "ПартнерГрузоотправитель", ПартнерГрузоотправитель);
		
	ИначеЕсли ВКакойРеквизитИмя = "Перевозчик" Тогда
		
		Если ЗначениеЗаполнено(УстанавливаемоеЗначение) Тогда 
			ПартнерПеревозчик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(УстанавливаемоеЗначение);
		Иначе
			ПартнерПеревозчик = Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
		КонецЕсли;
		ПроставитьВЭТРН(Объект.ДокументЭТРН, "ПартнерПеревозчик", ПартнерПеревозчик);
		
	ИначеЕсли ВКакойРеквизитИмя = "Грузополучатель" Тогда
		
		Если ЗначениеЗаполнено(УстанавливаемоеЗначение) Тогда 
			ПартнерГрузополучатель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(УстанавливаемоеЗначение);
		Иначе
			ПартнерГрузополучатель = Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
		КонецЕсли;
		ПроставитьВЭТРН(Объект.ДокументЭТРН, "ПартнерГрузополучатель", ПартнерГрузополучатель);
		
	КонецЕсли;
	
	ОбновитьДанныеФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПроставитьВЭТРН(ДокументЭТРНСсылка, ВКакойРеквизитИмя, УстанавливаемоеЗначение)

	Если Не ЗначениеЗаполнено(ДокументЭТРНСсылка) Тогда
		
		Если Объект.СозданВручную
			 И ЗначениеЗаполнено(РедактированиеЭТРН_ДатаТрН)
			 И ЗначениеЗаполнено(РедактированиеЭТРН_НомерТрН) Тогда

			ДокументЭТРН = НайтиЭТРН(РедактированиеЭТРН_ДатаТрН, РедактированиеЭТРН_НомерТрН);
			
			Если ЗначениеЗаполнено(ДокументЭТРН) Тогда
				ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
			Иначе
				ДокЭТРНОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
			КонецЕсли;

			ДокЭТРНОбъект.Дата = ТекущаяДатаСеанса();
			
			ЗаполнитьЗаимствованныеИзЭТРН_Реквизиты(ДокЭТРНОбъект);
				
			ДокЭТРНОбъект.Записать();

			Объект.ДокументЭТРН = ДокЭТРНОбъект.Ссылка;
		
		КонецЕсли;
		
	Иначе
		
		ДокЭТРНОбъект = ДокументЭТРНСсылка.ПолучитьОбъект();
		ДокЭТРНОбъект[ВКакойРеквизитИмя] = УстанавливаемоеЗначение;
		ДокЭТРНОбъект.Записать();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НайтиЭТРН(ДатаТрН, НомерТрН)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
	|ГДЕ
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Номер = &Номер
	|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Дата = &Дата
	|	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Номер", НомерТрН);
	Запрос.УстановитьПараметр("Дата", ДатаТрн);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	 
	КонецЕсли;	 
	
	Возврат Неопределено;
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьЗаимствованныеИзЭТРН_Реквизиты(ДокЭТРНОбъект)

	ДокЭТРНОбъект.Грузоотправитель = РедактированиеЭТРН_Грузоотправитель;
	ДокЭТРНОбъект.Грузополучатель = РедактированиеЭТРН_Грузополучатель;
	ДокЭТРНОбъект.ДатаТрН = РедактированиеЭТРН_ДатаТрН;
	ДокЭТРНОбъект.МестоДоставки = РедактированиеЭТРН_МестоДоставки;
	ДокЭТРНОбъект.МестоПогрузки = РедактированиеЭТРН_МестоПогрузки;
	ДокЭТРНОбъект.НомерТрН = РедактированиеЭТРН_НомерТрН;
	ДокЭТРНОбъект.Перевозчик = РедактированиеЭТРН_Перевозчик;
	ДокЭТРНОбъект.ПогрузкаСотрудник = РедактированиеЭТРН_ПогрузкаСотрудник;
	ДокЭТРНОбъект.ПогрузкуОсуществляет = РедактированиеЭТРН_ПогрузкуОсуществляет;
	ДокЭТРНОбъект.Прицеп = РедактированиеЭТРН_Прицеп;
	ДокЭТРНОбъект.Прицеп2 = РедактированиеЭТРН_Прицеп2;
	ДокЭТРНОбъект.ТранспортноеСредство = РедактированиеЭТРН_ТранспортноеСредство;
	
КонецПроцедуры	 

