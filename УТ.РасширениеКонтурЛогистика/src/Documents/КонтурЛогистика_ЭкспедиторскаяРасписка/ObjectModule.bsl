#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// При вызове обработчика заполнения в обычных формах
	// в данных заполнения содержится ссылка на документ основание
	// если ДанныеЗаполнения - ссылка одного из типов ДокументаОснование
	// преобразуем ДанныеЗаполнения к структуре
	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка");
	КонтурЛогистика_ОбработкаДокументовСервер.ПреобразоватьДанныеЗаполненияДляУчетныхДокументов(ДанныеЗаполнения,
		ТипЛогистика);
	
	// а) Из документа учетной системы
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// б) Загружен из сервиса, создаем из файла обмена
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;
		
		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);
		ЗаполнитьРеквизитыПоПользователю();
		
	// в) Из документа ЭТрН Т1
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		
		ЗаполнитьПоДокументуТрНТитул1(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// г) Копирование 
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Титул")
		И ДанныеЗаполнения.Свойство("Скопировать")
		И ДанныеЗаполнения.Скопировать Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Титул);
		Для каждого ТЧ Из ЭтотОбъект.Метаданные().ТабличныеЧасти Цикл
			Для каждого Стр Из ДанныеЗаполнения.Титул[ТЧ.Имя] Цикл
				НоваяСтрока = ЭтотОбъект[ТЧ.Имя].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		КонецЦикла;
		
		ЭтотОбъект.Номер = "";
		ЭтотОбъект.Дата = ТекущаяДатаСеанса();
		ЭтотОбъект.ДатаДок = ТекущаяДатаСеанса();
		КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьНомерКопииКНомеруДокумента(ЭтотОбъект.НомерДок, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка);
		
	// д) Ручной ввод Т1 с нуля
	Иначе
		
		МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
		ЗаполнитьРеквизитыПоПользователю();
		
	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЭкспедиторскаяРасписка_ОбработкаЗаполнения_После", Истина, ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЭкспедиторскаяРасписка_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДатаСеанса();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение

#Область ЗаполнитьИзДокументаОснования

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	Разделитель = Неопределено;
	
	ДанныеЗаполнения.Свойство("Разделитель", Разделитель);
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
		ДанныеЗаполнения.ТипЛогистика, ДанныеЗаполнения.ДокументОснование);
		
	Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ЭтотОбъект, ДокументОснование, НастройкаКонвертации, "");
		
	// Заполнить ЭтотТитул
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации, , Переменные);
	
	// TODO отрефачить дублирование в модулях объектов Т1 и Т3
	ТЗ_ТоварыВременная = ЗаполнитьТабЧастьТовары(НастройкаКонвертации, Переменные);
	
	// Если не были сгенерированы при формировании 
	КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТЗ_ТоварыВременная);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда
		КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	КонецЕсли;
	
	// Сворачиваем товары
	КолУчТоваров = ТЗ_ТоварыВременная.НайтиСтроки(Новый Структура("Учитывать", Истина)).Количество();
	Если НастройкаКонвертации.СворачиватьТабЧастьТовары И КолУчТоваров > 1 Тогда
		ТЗ_ТоварыВременная = КонтурЛогистика_КонвертацияСервер.СвернутьТовары(ТЗ_ТоварыВременная, ЭтотОбъект, НастройкаКонвертации);
	КонецЕсли;
	Товары.Загрузить(ТЗ_ТоварыВременная);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест") Тогда
		КоличествоМест = 0;
		НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			КоличествоМест = КоличествоМест + ТекущаяСтрока.КоличествоМест;
		КонецЦикла;
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто") Тогда
		МассаБруттоКг = 0;
		НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			МассаБруттоКг = МассаБруттоКг + ТекущаяСтрока.МассаПлановаяБруттоКг;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьТабЧастьТовары(НастройкаКонвертации, Переменные = Неопределено)
	
	Товары.Очистить();
	
	ТЗ_ТоварыВременная = Товары.Выгрузить();
	
	КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ЗаполнитьТабЧастьТоварыПоДокументуУчетнойСистемы(
		ТЗ_ТоварыВременная, НастройкаКонвертации, ЭтотОбъект, , Переменные);
	
	// Заполнить способ упаковки из настроек
	СпособУпаковки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособУпаковкиПоУмолчанию");
	Для Каждого Строка Из ТЗ_ТоварыВременная Цикл 
		Если Не ЗначениеЗаполнено(Строка.СпособУпаковки) Тогда 
			Строка.СпособУпаковки = СпособУпаковки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТЗ_ТоварыВременная;
	
КонецФункции

Процедура ЗаполнитьПоДокументуТрНТитул1(ТрН_Титул1)
	
	РеквизитыЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ТрН_Титул1.ДокументЭТРН,
		"УИД, НомерТрН, ДатаТрН, Грузоотправитель, ЭкспедицияЗаказчик, Грузоотправитель");
	
	НомерДок = РеквизитыЭТРН.НомерТрН;
	ДатаДок = РеквизитыЭТРН.ДатаТрН;
	
	ОтправительШаблона = РеквизитыЭТРН.ЭкспедицияЗаказчик;
	Грузоотправитель = РеквизитыЭТРН.ЭкспедицияЗаказчик;
	Клиент = РеквизитыЭТРН.ЭкспедицияЗаказчик;
	Экспедитор = РеквизитыЭТРН.Грузоотправитель;
	
	КоличествоМест = ТрН_Титул1.КоличествоМест;
	МассаБруттоКг = ТрН_Титул1.МассаБруттоКг;
	
	Для Каждого ТекущаяСтрока Из ТрН_Титул1.Товары Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ТрН_Титул1.Маркировки Цикл
		НоваяСтрока = Маркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ТрН_Титул1.ИнфПол Цикл
		НоваяСтрока = ИнфПол.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	// Для связи документов
	Если ЗначениеЗаполнено(РеквизитыЭТРН.УИД) Тогда
		НоваяСтрока = ИнфПол.Добавить();
		НоваяСтрока.Идентиф = "ЭТрН_УИД";
		НоваяСтрока.Значение = РеквизитыЭТРН.УИД;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыЭТРН.НомерТрН) Тогда
		НоваяСтрока = ИнфПол.Добавить();
		НоваяСтрока.Идентиф = "ЭТрН_Номер";
		НоваяСтрока.Значение = РеквизитыЭТРН.НомерТрН;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыЭТРН.ДатаТрН) Тогда
		НоваяСтрока = ИнфПол.Добавить();
		НоваяСтрока.Идентиф = "ЭТрН_Дата";
		НоваяСтрока.Значение = РеквизитыЭТРН.ДатаТрН;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнитьИзФайлаОбмена

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	Перем СодЭР;
	
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
	
	ЗаполнитьРеквизитыТитулаИзXDTO(XDTO, СодЭР);
	
	ЗаполнитьТоварыИзXDTO(СодЭР);
	
	КонтурЛогистика_КонструкторыXDTO.ЗаполнитьИнфПолИзXDTO(СодЭР, ЭтотОбъект, "ИнфПол");
	
	МассивДопРеквизитовДокумента = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.ИнфПол_СписокДопРеквизитов();
	
	КонтурЛогистика_КонвертацияСервер.ДопРеквизиты_ЗаполнитьИзИнфПол(МассивДопРеквизитовДокумента, ЭтотОбъект);

КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO, СодЭР)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ЭлДокумент = XDTO.Документ;
	СодЭР = XDTO.Документ.СодЭР;
	
	ДатаИнф = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_ПолучитьЗначениеСвойства(ЭлДокумент, "ДатаИнф"));
	ВремяИнф = КС.Конвертировать_ВремяТип_вДата(КС.XDTO_ПолучитьЗначениеСвойства(ЭлДокумент, "ВремяИнф"));
	
	НомерДок = КС.XDTO_Вычислить(ЭлДокумент, "НомерДок");
	ДатаДок = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_ПолучитьЗначениеСвойства(ЭлДокумент, "ДатаДок"));
	
	Грузоотправитель = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_ПолучитьЗначениеСвойства(СодЭР.СвГО, "РекИдентГО"));
	СвКлиент = КС.XDTO_ПолучитьЗначениеСвойства(СодЭР, "СвКлиент");
	Если СвКлиент <> Неопределено Тогда
		Клиент = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_ПолучитьЗначениеСвойства(СодЭР.СвКлиент, "РекИдентКлиент"));
	КонецЕсли;
	Экспедитор = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_ПолучитьЗначениеСвойства(СодЭР.СвЭксп, "РекИдентЭксп"));
	
КонецПроцедуры

Процедура ЗаполнитьТоварыИзXDTO(Знач СодЭР)
	
	Перем ВидТар_raw, ЗакУсл_raw, МассивОпГруз, НоваяСтрокаТовара, ОпГруз, ОпГруз_raw, стрОбъявленнаяЦенность_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Товары.Очистить();
	КоличествоМест = 0;
	МассаБруттоКг = 0;
	
	ОпГруз_raw = КС.XDTO_Вычислить(СодЭР, "СвГруз.ОпГруз");
	МассивОпГруз = КС.XDTO_ВычислитьМассивXDTO(ОпГруз_raw);
	Для Каждого ОпГруз из МассивОпГруз Цикл 
		
		НоваяСтрокаТовара = Товары.Добавить();
		НоваяСтрокаТовара.Учитывать = Истина;
		НоваяСтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		НоваяСтрокаТовара.ОтгрузочноеНаименование 	= КС.XDTO_Вычислить(ОпГруз, "НаимГруз");
		НоваяСтрокаТовара.СостояниеГруза 			= КС.XDTO_Вычислить(ОпГруз, "СостГруз");
		НоваяСтрокаТовара.СпособУпаковки 			= КС.XDTO_Вычислить(ОпГруз, "СпУпак");
		
		ВидТар_raw = КС.XDTO_Вычислить(ОпГруз, "ВидТар");
		Если ЗначениеЗаполнено(ВидТар_raw) Тогда
			НоваяСтрокаТовара.ВидТары = Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду(ВидТар_raw);
		КонецЕсли;
		
		НоваяСтрокаТовара.КоличествоМест = КС.XDTO_Вычислить(ОпГруз, "КолМестГр");
		КоличествоМест = КоличествоМест + НоваяСтрокаТовара.КоличествоМест;
		
		НоваяСтрокаТовара.МассаПлановаяБруттоКг = КС.XDTO_Вычислить(ОпГруз, "ПлМасГруз.МасБрутЗнач");
		МассаБруттоКг = МассаБруттоКг + НоваяСтрокаТовара.МассаПлановаяБруттоКг;
		
		НоваяСтрокаТовара.КодТНВЭД = КС.XDTO_Вычислить(ОпГруз, "КодТовНом");
		НоваяСтрокаТовара.ОбъемКубМ = КС.XDTO_Вычислить(ОпГруз, "Объем");
		НоваяСтрокаТовара.МассаПлановаяНеттоКг = КС.XDTO_Вычислить(ОпГруз, "ПлМасГруз.МасНетЗнач");
		НоваяСтрокаТовара.КоличествоПаллет = КС.XDTO_Вычислить(ОпГруз, "ПлМасГруз.КолПалл");
		НоваяСтрокаТовара.ДопИнформация = КС.XDTO_Вычислить(ОпГруз, "ДрОГруз");
		
		стрОбъявленнаяЦенность_raw = КС.XDTO_Вычислить(ОпГруз, "ЦеннГруз.СтЦеннГр");
		Если стрОбъявленнаяЦенность_raw <> Неопределено Тогда 
			НоваяСтрокаТовара.ОбъявленнаяЦенность = Число(стрОбъявленнаяЦенность_raw);
		КонецЕсли;
		
		НоваяСтрокаТовара.Плотность = КС.XDTO_Вычислить(ОпГруз, "Плотн");
		
		ЗакУсл_raw = КС.XDTO_Вычислить(ОпГруз, "ЗакУсл");
		Если ЗакУсл_raw <> Неопределено Тогда
			НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(ЗакУсл_raw);
			
			Если ЗначениеЗаполнено(НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок)
				И НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок.СвязанныеОбъекты.Количество() > 0 Тогда
				
				НоваяСтрокаТовара.ЗаказчикПеревозки  	= НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок.СвязанныеОбъекты[0].СвязанныйОбъект;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьМаркировкиИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьМаркировкиИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	стрМаркировки_raw = КС.XDTO_Вычислить(ОпГруз, "Марк");
	
	Если стрМаркировки_raw = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(стрМаркировки_raw) = Тип("Строка") Тогда
		МассивМаркировок = Новый Массив;
		МассивМаркировок.Добавить(стрМаркировки_raw);
	Иначе
		МассивМаркировок = КС.XDTO_ВычислитьМассивXDTO(стрМаркировки_raw);
	КонецЕсли;
	
	Для Каждого МаркировкаЗначение Из МассивМаркировок Цикл 
		НоваяСтрокаМаркировки = Маркировки.Добавить();
		НоваяСтрокаМаркировки.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
		НоваяСтрокаМаркировки.ЗначениеМаркировки = МаркировкаЗначение;
	КонецЦикла;
	
КонецПроцедуры

