	Если Не ЗначениеЗаполнено(ДопПараметр) Тогда
		Возврат;
	КонецЕсли;
	
	локМассивСтрокСЭтойНоменклатурой = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ДопПараметр));
	локМассивИдентификаторов = Новый Массив();
	
	Для Каждого СтрокаПереконвертации Из локМассивСтрокСЭтойНоменклатурой Цикл
		СконвертироватьСтрокуТоваровКлиент(СтрокаПереконвертации.ПолучитьИдентификатор());
		локМассивИдентификаторов.Добавить(СтрокаПереконвертации.ИдентификаторСтроки);
