&НаКлиенте
Процедура ТоварыДобавить(Команда)
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	НоваяСтрока.Учитывать = Истина;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
		И КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ИспользуютсяХарактеристики() Тогда
		
		НоваяСтрока.Характеристика =  КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПустаяХарактеристика();
	КонецЕсли;
	
	ПроверитьДокумент();
	
	ЗаполнитьТребуемыеДействияТоваров();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСкопировать(Команда)
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	НоваяСтрока.Учитывать = Истина;
	
	Если ТекСтрока <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока,, "ИдентификаторСтроки");
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьНеучитываемые(Команда)
	
	СкрытьНеучитываемые = Не СкрытьНеучитываемые;
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНеучитываемыхИФильтраОшибок()
	
	КонтурЛогистика_ОбработкаДокументовКлиент.УстановитьВидимостьНеучитываемыхИФильтраОшибок(
		Объект.Товары, СкрытьНеучитываемые, Элементы.Товары, Элементы.ТоварыИтоги);
	
	// Лишним не будет
	Элементы.ОтключитьФильтрТаблицыОшибокТовары.Видимость = ЗначениеЗаполнено(ОтборТаблицыОшибокЗначениеТовары);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьФильтрТаблицыОшибокТовары(Команда)
	
	ОтборТаблицыОшибокЗначениеТовары = "";
	
	Если Элементы.Товары.ОтборСтрок <> Неопределено Тогда
		
		ВременнаяСтруктура = Новый Структура(Элементы.Товары.ОтборСтрок);
		
		Если ВременнаяСтруктура.Свойство("ПризнакОтбораТаблицыОшибок") Тогда
			ВременнаяСтруктура.Удалить("ПризнакОтбораТаблицыОшибок");
			Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура(ВременнаяСтруктура);
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ОтключитьФильтрТаблицыОшибокТовары.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСоответствияНоменклатуры(Команда)
	
	ОткрытьСоответствияТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьНесопоставленныеНеУчитываемыми(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("КоличествоМест", 0);
	ПараметрыОтбора.Вставить("МассаПлановаяБруттоКг", 0);
	ПараметрыОтбора.Вставить("ОтгрузочноеНаименование", "");
	ПараметрыОтбора.Вставить("Учитывать", Истина);
	
	НесопоставленныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбора);
	
	Если НесопоставленныеСтроки.Количество() > 0 Тогда
		
		Для Каждого текСтр Из НесопоставленныеСтроки Цикл
			СделатьСтрокуТовараНеучитываемой(текСтр);
		КонецЦикла;
		
		ОбновитьПредставлениеДанных();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗначенияДокументаУчетнойСистемы(Команда)
	
	РеквизитыУчетногоДокументаВидимы = Не РеквизитыУчетногоДокументаВидимы;
	Если РеквизитыУчетногоДокументаВидимы Тогда 
		Элементы.ФормаПоказатьЗначенияДокументаУчетнойСистемы.Картинка = БиблиотекаКартинок.КонтурЛогистика_Скрыть;
	Иначе
		Элементы.ФормаПоказатьЗначенияДокументаУчетнойСистемы.Картинка = БиблиотекаКартинок.КонтурЛогистика_Показать;
	КонецЕсли;
	
	СкрытьПоказатьЗначенияДокУчСист();
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьЗначенияДокУчСист()
	
	ЗаполнитьПредставлениеРеквизитовДокументаОснования();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуКонвертации(Команда)
	
	КонтурЛогистика_ОбработкаДокументовКлиент.ОткрытьНастройкуКонвертации(
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка"), Объект.ДокументОснование);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()
	
	УстановитьПоложениеСохраняемыхЭлементов();
	
	УстановитьФорматыКолонокСКоличеством();
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеСохраняемыхЭлементов()
	
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	
	УстановитьПоложениеШапки();
	
	УстановитьСвернутостьПодробностейОТоварах();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФорматыКолонокСКоличеством()
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(
		Объект.Товары, "МассаПлановаяНеттоКг", Элементы.ТоварыМассаПлановаяНеттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(
		Объект.Товары, "МассаПлановаяБруттоКг", Элементы.ТоварыМассаПлановаяБруттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(
		Объект.Товары, "Количество", Элементы.ТоварыКоличество);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(
		Объект.Товары, "Плотность", Элементы.ТоварыПлотность);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	// Видимость номенклатуры в зависимости от того есть ли там номенклатура (она есть если отправляли Т1 из этой базы)
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(
		Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаНоменклатура);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(
		Объект.Товары, "Номенклатура", Элементы.ТоварыХарактеристика);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(
		Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаЕдиницы);
	
	СкрытьПоказатьЗначенияДокУчСист();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийКодСостоянияДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.Ссылка).Код;
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.Ссылка);
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда
		
		ПерешелВЛогистическиеСтатус = Истина;
	Иначе
		ПерешелВЛогистическиеСтатус = Ложь;
	КонецЕсли;
	Элементы.ТекущийСтатус.Видимость = Не ПерешелВЛогистическиеСтатус;
	Элементы.ТекущийСтатусДокументооборота.Видимость = ПерешелВЛогистическиеСтатус;
	
	ВозможностьОтветнойПодписи = ВозможностьОтветнойПодписи();
	
	Если ТекущийКодСостоянияДокументооборота = "fr-сheck-forwarder"
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		
		ВозможностьПодписанияИОтправки = Не ВозможностьОтветнойПодписи;
	Иначе
		ВозможностьПодписанияИОтправки = Ложь;
	КонецЕсли;
	
	ДоступнаОсновнаяКнопкаПоУмолчанию = Не ВозможностьОтветнойПодписи И ВозможностьПодписанияИОтправки;
	ДоступностьКнопкиСогласования = ВозможностьОтветнойПодписи;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Повторно выполнить задачу";
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Выполнить задачу";
	КонецЕсли;
	
	ЭтоВходящий = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен;
	ЕстьДокУчСист = ЗначениеЗаполнено(Объект.ДокументОснование);
	
	Элементы.ПерезаполнитьПоДокОснованию.Видимость = Не ЭтоВходящий И ЕстьДокУчСист;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = ЭтоВходящий И Не ЕстьДокУчСист;
	Элементы.ОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = Не ЕстьДокУчСист;
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(
		Объект.Ссылка, Объект.ДокументОснование,
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус);
	
	Если ЗначениеЗаполнено(Объект.ОтправительШаблона) И ТекущийКодСостоянияДокументооборота = "" Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Отправить шаблон экспедитору";
	КонецЕсли;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_Согласовать.Видимость = ДоступностьКнопкиСогласования;
	
	Если Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Элементы.ФормаОбщаяКомандаКонтурЛогистика_Согласовать.Видимость Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_Согласовать.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
	Элементы.ОткрытьНастройкуКонвертации.Видимость = ЗначениеЗаполнено(Объект.ДокументОснование);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставлениеДанных()
	
	ЗаполнитьПредставлениеРеквизитовДокументаОснования();
	ЗаполнитьТребуемыеДействияТоваров();
	ПроверитьДокумент(); // вызовет УправлениеВидимостьюИДоступностью();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипыДокументаОснованияНастроеныДляТитула()
	
	ТипыНастроены = Истина;
	
	РеквизитМД = Метаданные.Документы["КонтурЛогистика_ЭкспедиторскаяРасписка"].Реквизиты.ДокументОснование;
	
	МассивТипов = РеквизитМД.Тип.Типы();
	
	Если МассивТипов.Количество() = 1 И МассивТипов.Найти(Тип("ДокументСсылка.КонтурЛогистика_Вспомогательный")) = 0 Тогда
		ТипыНастроены = Ложь;
	КонецЕсли;
	
	Возврат ТипыНастроены;
	
КонецФункции

&НаСервере
Процедура УправлениеЭлементамиФормыВЗависимостиОтСтатуса()
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		
		ЛокальныйТолькоПросмотр = Ложь;
	Иначе
		ЛокальныйТолькоПросмотр = Истина;
	КонецЕсли;
	
	ВозможностьОтветнойПодписи = ВозможностьОтветнойПодписи();
	
	Если ВозможностьОтветнойПодписи Тогда 
		ЛокальныйТолькоПросмотр = Истина;
	КонецЕсли;
	
	ВозможностьПодписанияИОтправки = Не ЛокальныйТолькоПросмотр И Не ВозможностьОтветнойПодписи;
	
	Элементы.ГруппаШапкаМестоположение.ТолькоПросмотр = ЛокальныйТолькоПросмотр;
	Элементы.Товары.ТолькоПросмотр = ЛокальныйТолькоПросмотр;
	Элементы.Маркировки.ТолькоПросмотр = ЛокальныйТолькоПросмотр;
	Элементы.СтраницаДополнительныеПоля.ТолькоПросмотр = ЛокальныйТолькоПросмотр;
	
	Элементы.ТоварыСкопировать.Видимость = Не ЛокальныйТолькоПросмотр;
	Элементы.ТоварыДобавить.Видимость = Не ЛокальныйТолькоПросмотр;
	Элементы.ТоварыГруппаТребуемоеДействие.Видимость = Не ЛокальныйТолькоПросмотр;
	Элементы.ТоварыГруппаУправление.Видимость = Не ЛокальныйТолькоПросмотр;
	
	// ПодменюУправление
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СформироватьФайлыОбмена", Не ЛокальныйТолькоПросмотр);
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный", Ложь);
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке", Ложь);
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание", Ложь);
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить", ВозможностьПодписанияИОтправки);
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке", ВозможностьПодписанияИОтправки);
	ИзменитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_Согласовать", ВозможностьОтветнойПодписи);
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьДоступностьЭлемента(ИмяЭлемента, ЗначениеДоступности)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент <> Неопределено Тогда
		НайденныйЭлемент.Доступность = ЗначениеДоступности;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВозможностьОтветнойПодписи()
	
	ТребуетсяОтветнаяПодпись = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ТребуетсяОтветнаяПодписьЗаказчикаЭР");
	
	Если ТекущийКодСостоянияДокументооборота = "fr-сheck-cargo-owner"
		И ТребуетсяОтветнаяПодпись Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПоложениеШапки()
	
	Если ШапкаНаОтдельнойЗакладке Тогда
		
		текАктивнаяЗакладка = Элементы.Страницы.ТекущаяСтраница;
		
		ПереместитьШапкуВызовСервера();
		Элементы.СвернутьШапку.Видимость = Ложь;
		Элементы.РазвернутьШапку.Видимость = Истина;
		
		ПанельОшибокРазвернута = Элементы.ПанельОшибок.РастягиватьПоВертикали;
		Если Не ПанельОшибокРазвернута Тогда
			ПанельОшибокСвернутьРазвернутьВызовОМ();
		КонецЕсли;
		
		Элементы.Страницы.ТекущаяСтраница = текАктивнаяЗакладка;
		
	Иначе
		
		ПереместитьШапкуВызовСервера();
		Элементы.СвернутьШапку.Видимость = Истина;
		Элементы.РазвернутьШапку.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьШапкуВызовСервера()
	
	Если ШапкаНаОтдельнойЗакладке Тогда
		Если Элементы.СтраницаШапка.ПодчиненныеЭлементы.Найти(Элементы.ГруппаШапкаДанные.Имя) = Неопределено Тогда
			КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(
				ЭтаФорма, Элементы.ГруппаШапкаДанные, Элементы.СтраницаШапка);
		КонецЕсли;
	Иначе
		Если Элементы.ГруппаШапкаМестоположение.ПодчиненныеЭлементы.Найти(Элементы.ГруппаШапкаДанные.Имя) = Неопределено Тогда
			КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(
				ЭтаФорма, Элементы.ГруппаШапкаДанные, Элементы.ГруппаШапкаМестоположение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДокумент()
	
	РезультатПроверки = ПроверитьДокументСервер();
	
	Если ТекущийКодСостоянияДокументооборота = "fr-wait-forwarder"
		Или ТекущийКодСостоянияДокументооборота = "fr-wait-cargo-owner"
		Или ТекущийКодСостоянияДокументооборота = "fr-completed" Тогда
		
		ВсегдаВыводитьРезультатВалидации = Ложь;
	Иначе
		ВсегдаВыводитьРезультатВалидации = Истина;
	КонецЕсли;
	
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(
		ТекущийСтатус, ЭтаФорма, РезультатПроверки, ВсегдаВыводитьРезультатВалидации);
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьПиктограммыОшибокТабличнойЧасти(
		Объект.Товары, ТаблицаОшибок, "Товары", "КартинкаОшибок");
	
	ЗаполнитьТребуемыеДействияТоваров(); // Требуемые действия зависят от результатов проверки
	УправлениеВидимостьюИДоступностью(); // Доступность команд
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ПроверитьДокументСервер()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатыПроверкиДокумента = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.ПроверитьДокумент(ДокОбъект, ТаблицаОшибок);
	
	РезультатПроверки = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаТовара.Картинка = 0;
	КонецЦикла;
	
