#Область ПроверкаЗаполнения

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	Если Объект.Грузоотправитель = Объект.Экспедитор Тогда
		ТекстОшибки = "Грузоотправитель и экспедитор не могут совпадать";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Редактирование_Грузоотправитель", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НомерДок) Тогда
		ТекстОшибки = "Укажите номер документа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"НомерДок", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаДок) Тогда
		ТекстОшибки = "Укажите дату документа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"ДатаДок", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Грузоотправитель) И Не ЗначениеЗаполнено(Объект.Грузоотправитель.ТелефонОсновной) Тогда
		ТекстОшибки = "Укажите телефон грузоотправителя";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Грузоотправитель.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Клиент) И Не ЗначениеЗаполнено(Объект.Клиент.ТелефонОсновной) Тогда
		ТекстОшибки = "Укажите телефон клиента";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Клиент.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Экспедитор) И Не ЗначениеЗаполнено(Объект.Экспедитор.ТелефонОсновной) Тогда
		ТекстОшибки = "Укажите телефон экспедитора";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Экспедитор.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" Или Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			текКатегория = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
			
			ТекстОшибки = "Укажите " + СинонимРеквизита(ОбязательныйРевизит);
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, "", "", ОбязательныйРевизит, текКатегория, ТекстОшибки, "Указать");
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьТабЧастьТовары(Знач Объект, ТаблицаОшибок, ТекСтатусДокумента = Неопределено, ЭтоШаблон = Ложь)
	
	Если ЭтоШаблон Тогда
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	Иначе
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КонецЕсли;
	
	ИмяТЧ = "Товары";
	
	Если Не ЗначениеЗаполнено(Объект.Товары) Тогда
		ТекстОшибки = "Добавьте груз в табличную часть ""Грузы (Товары)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, "", "", "", КатегорияОшибка, ТекстОшибки, "Добавить груз");
		Возврат;	
	КонецЕсли;
	
	Если Объект.Товары.НайтиСтроки(Новый Структура("Учитывать", Истина)).Количество() = 0 Тогда		
		ТекстОшибки = "Нет ни одного учитываемого груза в табличной части ""Грузы (Товары)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"", КатегорияОшибка, ТекстОшибки, "Добавить груз");
	    Возврат;	
	КонецЕсли;
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		
		Если Не СтрокаТовара.Учитывать Тогда 
			Продолжить;
		КонецЕсли;
		
		ТекущийНомерСтроки = СтрокаТовара.НомерСтроки;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.КоличествоМест) Тогда
			ТекстОшибки = "Укажите Количество мест по грузу";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
				"КоличествоМест", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать кол-во мест");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.ОтгрузочноеНаименование) Тогда
			ТекстОшибки = "Укажите Отгрузочное наименование";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
				"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать отгрузочное наименование");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.СостояниеГруза) Тогда
			ТекстОшибки = "Укажите Состояние груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
				"СостояниеГруза", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать состояние груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.СпособУпаковки) Тогда
			ТекстОшибки = "Укажите Способ упаковки";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
				"СпособУпаковки", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать способ упаковки");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.ВидТары) Тогда
			ТекстОшибки = "Укажите Вид тары";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
				"ВидТары", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать вид тары");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.МассаПлановаяБруттоКг) Тогда
			ТекстОшибки = "Укажите Массу (брутто) груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
				"МассаПлановаяБруттоКг", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать массу брутто");
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция СинонимРеквизита(ИмяРеквизита) Экспорт
	
	Попытка
		Возврат Метаданные.Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.Реквизиты[ИмяРеквизита].Синоним;
	Исключение
		Возврат ИмяРеквизита;
	КонецПопытки;
	
КонецФункции

Процедура ПроверитьПодписанта(ДокументОбъектИлиСсылка, ТаблицаОшибок, ПараметрыФормированияФайлов)
	
	Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ПользовательПодписант) Тогда
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
		
	Иначе
		
		ТекстОшибки = "Укажите пользователя подписанта документа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, "", "", "ПользовательПодписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка,
			ТекстОшибки, "Указать");
		
	КонецЕсли;
	
КонецПроцедуры

