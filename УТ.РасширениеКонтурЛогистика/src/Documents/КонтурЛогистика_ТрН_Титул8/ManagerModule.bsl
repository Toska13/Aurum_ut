Функция ВсеЗамены(ДокументЭТрНСсылка) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул8.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул8 КАК КонтурЛогистика_ТрН_Титул8
	|ГДЕ
	|	НЕ КонтурЛогистика_ТрН_Титул8.ПометкаУдаления
	|	И КонтурЛогистика_ТрН_Титул8.ДокументЭТРН = &ДокументЭТРН
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_ТрН_Титул8.Дата";
	
	Запрос.УстановитьПараметр("ДокументЭТРН", ДокументЭТрНСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
