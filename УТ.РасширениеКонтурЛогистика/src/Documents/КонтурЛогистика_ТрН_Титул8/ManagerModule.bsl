Функция ПоследняяЗамена(ДокументЭТРНСсылка, ИмяТЧ) Экспорт
	
	НайденныйТ8 = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КонтурЛогистика_ТрН_Титул8НовыеПрицепы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ТрН_Титул8.НовыеПрицепы КАК КонтурЛогистика_ТрН_Титул8НовыеПрицепы
	               |ГДЕ
	               |	НЕ КонтурЛогистика_ТрН_Титул8НовыеПрицепы.Ссылка.ПометкаУдаления
	               |	И КонтурЛогистика_ТрН_Титул8НовыеПрицепы.Ссылка.ДокументЭТРН = &ДокументЭТРН
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_ТрН_Титул8НовыеПрицепы.Ссылка.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументЭТРН", ДокументЭТРНСсылка);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НовыеПрицепы", ИмяТЧ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НайденныйТ8 = Выборка.Ссылка;	
	КонецЕсли;	
	
	Возврат НайденныйТ8;
	
КонецФункции

