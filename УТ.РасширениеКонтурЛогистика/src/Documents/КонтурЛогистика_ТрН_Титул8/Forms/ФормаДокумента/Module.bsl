&НаКлиенте
Процедура ДобавитьСменуТСИлиПрицепа(Команда)
	
	НоваяЗаменаТС = Объект.ЗаменТС.Добавить();
	НоваяЗаменаТС.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	НоваяЗаменаТС.ПредставлениеЗамены = "Замена №" + НоваяЗаменаТС.НомерСтроки;
	
	Элементы.ЗаменТС.ТекущаяСтрока = НоваяЗаменаТС.ПолучитьИдентификатор();
	
	ИнициализироватьТумблерЗамены();
	
	УправлениеВидимостьюИДоступностью();
	
	УстановитьЗаголовкиСтраниц(ЭтаФорма);
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСменуТСИлиПрицепа(Команда)
	
	Если Объект.ЗаменТС.Количество() = 1 Тогда 
		
		Объект.ЗаменТС.Очистить();
		Объект.НовыеТранспортныеСредства.Очистить();
		Объект.НовыеПрицепы.Очистить();
		Объект.ДокументыОПередачеГруза.Очистить();
		Объект.СпецУсловияДвижения.Очистить();
		
	Иначе
		
		ТекДанные = Элементы.ЗаменТС.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда 
			Возврат
		КонецЕсли;	
		
		Отбор = Новый Структура("ИдентификаторСтрокиЗаменТС", ТекДанные.ИдентификаторСтроки);
		
		нСтроки = Объект.НовыеТранспортныеСредства.НайтиСтроки(Отбор);
		Для Каждого нСтрока Из нСтроки Цикл 
			Объект.НовыеТранспортныеСредства.Удалить(нСтрока);
		КонецЦикла;
		
		нСтроки = Объект.НовыеПрицепы.НайтиСтроки(Отбор);
		Для Каждого нСтрока Из нСтроки Цикл 
			Объект.НовыеПрицепы.Удалить(нСтрока);
		КонецЦикла;
		
		нСтроки = Объект.ДокументыОПередачеГруза.НайтиСтроки(Отбор);
		Для Каждого нСтрока Из нСтроки Цикл 
			Объект.ДокументыОПередачеГруза.Удалить(нСтрока);
		КонецЦикла;
		
		нСтроки = Объект.СпецУсловияДвижения.НайтиСтроки(Отбор);
		Для Каждого нСтрока Из нСтроки Цикл 
			Объект.СпецУсловияДвижения.Удалить(нСтрока);
		КонецЦикла;
		
		нСтроки = Объект.ЗаменТС.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки));
		Для Каждого нСтрока Из нСтроки Цикл 
			Объект.ЗаменТС.Удалить(нСтрока);
		КонецЦикла;
		
	КонецЕсли;	
			
	УправлениеВидимостьюИДоступностью();
	
	УстановитьЗаголовкиСтраниц(ЭтаФорма);
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ТумблерЗаменаТСПриИзменении(Элемент)
	
	ИнициализироватьТумблерЗамены();	
	УправлениеВидимостьюИДоступностью();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьТумблерЗамены()
	
	Если ТумблерЗаменаТС = 0 Тогда
		
		Объект.НовыеПрицепы.Очистить();
		
		Если Не ЗначениеЗаполнено(Объект.НовыеТранспортныеСредства) Тогда
			НовоеТС = Объект.НовыеТранспортныеСредства.Добавить();
			НовоеТС.ИдентификаторСтрокиЗаменТС = Объект.ЗаменТС[0].ИдентификаторСтроки;
		КонецЕсли;
		
	ИначеЕсли ТумблерЗаменаТС = 1 Тогда
		
		Объект.НовыеТранспортныеСредства.Очистить();
		
		Если Не ЗначениеЗаполнено(Объект.НовыеПрицепы) Тогда
			НовыйПрицеп = Объект.НовыеПрицепы.Добавить();
			НовыйПрицеп.ИдентификаторСтрокиЗаменТС = Объект.ЗаменТС[0].ИдентификаторСтроки;
		КонецЕсли;
		
	ИначеЕсли ТумблерЗаменаТС = 2 Тогда	
		
		Если Не ЗначениеЗаполнено(Объект.НовыеТранспортныеСредства) Тогда 
			НовоеТС = Объект.НовыеТранспортныеСредства.Добавить();
			НовоеТС.ИдентификаторСтрокиЗаменТС = Объект.ЗаменТС[0].ИдентификаторСтроки;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.НовыеПрицепы) Тогда
			НовыйПрицеп = Объект.НовыеПрицепы.Добавить();
			НовыйПрицеп.ИдентификаторСтрокиЗаменТС = Объект.ЗаменТС[0].ИдентификаторСтроки;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ДекорацияДокументПередачиГрузаВТСНажатие(Элемент)
	
	НовыйДокумент = Объект.ДокументыОПередачеГруза.Добавить();
	НовыйДокумент.ИдентификаторСтрокиЗаменТС = Объект.ЗаменТС[0].ИдентификаторСтроки;
	
	Если Объект.ДокументыОПередачеГруза.Количество() = 1 И Не ТумблерЗаполненИдДокПерГр Тогда 
		ЗаполнитьДанныеДокумента(НовыйДокумент, "ПерГр");
	КонецЕсли;
	
	УправлениеВидимостьюИДоступностью();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДекорацияУдалитьДокументПередачиГрузаВТСНажатие(Элемент)
	
	Объект.ДокументыОПередачеГруза.Очистить();
	
