	Если Не Объект.ЗаменТС.Количество() Тогда 
		
		ДовавитьСтрокуВТаблицуЗаменТС();
		
	Иначе
		
		// каждая новое ТС в таблице это обязятельно новый ИдентификаторСтрокиЗаменТС
		
		ТекДанные = Элементы.ЗаменТС.ТекущиеДанные;
		
		нСтроки = Объект.НовыеТранспортныеСредства.НайтиСтроки(Новый Структура("ИдентификаторСтрокиЗаменТС", ТекДанные.ИдентификаторСтроки));	
		Если нСтроки.Количество() Тогда 
			ДовавитьСтрокуВТаблицуЗаменТС();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

