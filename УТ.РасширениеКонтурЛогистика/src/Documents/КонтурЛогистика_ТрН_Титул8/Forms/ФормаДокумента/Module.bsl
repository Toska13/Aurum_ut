&НаКлиенте
Процедура ДовавитьСтрокуВТаблицуЗаменТС()
	
	НоваяЗамена = Объект.ЗаменТС.Добавить();
	НоваяЗамена.ИдентификаторСтроки = Новый УникальныйИдентификатор;
