	Если Не ЗначениеЗаполнено(Объект.НовыеВодители) Тогда 
		НовыйВодитель = Объект.НовыеВодители.Добавить();
		НовыйВодитель.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		Элементы.НовыеВодители.ТекущаяСтрока = НовыйВодитель.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьДанныеДокумента(ОбъектДокумента, ПостФикс = "") 
	
	ОбъектДокумента["ДатаДок" + ПостФикс] = ТекущаяДата();
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСтраниц(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Элементы.СтраницаЗаменаВодителей.Заголовок = "Замены водителей";
	Элементы.СтраницаЗаменаТС.Заголовок = "Замены транспортных средств";
	
	Если Объект.НовыеВодители.Количество() Тогда 
		
		Элементы.СтраницаЗаменаВодителей.Заголовок = "Замены водителей (" + Объект.НовыеВодители.Количество() + ")";
		
	КонецЕсли;
	
	Если Объект.ЗаменТС.Количество() Тогда 
		
		Элементы.СтраницаЗаменаТС.Заголовок = "Замены транспортных средств (" + Объект.ЗаменТС.Количество() + ")";
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьТекстДекорацииПредВодители()

	ТекстЗаголовка = "";
	
	Если Объект.ПредыдущиеВодители.Количество() Тогда 
				
		Для Каждого Строка Из Объект.ПредыдущиеВодители Цикл 
			
			ТекстЗаголовка = ТекстЗаголовка + ?(ЗначениеЗаполнено(ТекстЗаголовка), ", ", "") + Строка.Водитель.Наименование;
			
		КонецЦикла;	
		
	КонецЕсли;	

	Элементы.ДекорацияПредВодители.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстДекорацииПредТС()

	ТекстЗаголовка = "";
	
	Если Объект.ПредыдущиеТранспортныеСредства.Количество() Тогда 
				
		Для Каждого Строка Из Объект.ПредыдущиеТранспортныеСредства Цикл 
			
			Если Не Строка.ЭтоПрицеп Тогда 
				
				ТекстЗаголовка = ТекстЗаголовка + ?(ЗначениеЗаполнено(ТекстЗаголовка), ", ", "") + Строка.ТранспортноеСредство.Наименование;
				
			КонецЕсли;
		
		КонецЦикла;	
		
	КонецЕсли;	

	Элементы.ДекорацияПредТС.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

