&НаКлиенте
Процедура ЗаменТСПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ЗаменТС.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Или Объект.ЗаменТС.Количество() < 2 Тогда 
		ОтборСтрок = Неопределено;
	Иначе
		ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтрокиЗаменТС", ТекДанные.ИдентификаторСтроки));
	КонецЕсли;	
	
	Элементы.НовыеТранспортныеСредства.ОтборСтрок 	= ОтборСтрок;
	Элементы.НовыеПрицепы.ОтборСтрок 				= ОтборСтрок;
	Элементы.СпецУсловияДвижения.ОтборСтрок 		= ОтборСтрок;
	Элементы.ДокументыОПередачеГруза.ОтборСтрок 	= ОтборСтрок;
	
КонецПроцедуры

