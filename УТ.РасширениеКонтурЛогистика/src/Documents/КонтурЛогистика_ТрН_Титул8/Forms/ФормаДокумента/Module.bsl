&НаСервере
Процедура ПеречитатьЗначенияТумблеров()
	
	ТумблерЗаполненИдДокПерГр 		= ЗначениеЗаполнено(Объект.ДокументыОПередачеГруза) И ЗначениеЗаполнено(Объект.ДокументыОПередачеГруза[0].ИдДокПерГр);
	ТумблерЗаполненИдДокПерГрВод 	= ЗначениеЗаполнено(Объект.НовыеВодители) И ЗначениеЗаполнено(Объект.НовыеВодители[0].ИдДокПерГрВод);
	ТумблерЗаполненИдПутевогоЛиста 	= ЗначениеЗаполнено(Объект.ПутевыеЛисты) И ЗначениеЗаполнено(Объект.ПутевыеЛисты[0].ИдДок);
	ТумблерЗаполненИдСпецРазрешения = ЗначениеЗаполнено(Объект.СпецУсловияДвижения) И ЗначениеЗаполнено(Объект.СпецУсловияДвижения[0].ИдСР);
	
	Если ЗначениеЗаполнено(Объект.ИдДокПричЗам) Тогда 
		ТумблерОснованиеЗамены = 0;
	ИначеЕсли ЗначениеЗаполнено(Объект.НаимДокПричЗам) Тогда
		ТумблерОснованиеЗамены = 1;
	Иначе 
		ТумблерОснованиеЗамены = 2;
	КонецЕсли;	

	Если ЗначениеЗаполнено(Объект.НовыеТранспортныеСредства) И ЗначениеЗаполнено(Объект.НовыеПрицепы) Тогда 
		ТумблерЗаменаТС = 2;
	ИначеЕсли ЗначениеЗаполнено(Объект.НовыеПрицепы) Тогда 
		ТумблерЗаменаТС = 1;
	Иначе 
		ТумблерЗаменаТС = 0;
	КонецЕсли;	
	
	Если ТумблерОснованиеЗамены = 1 Тогда 
		ЗаполнитьДанныеДокумента(Объект, "ПричЗам");
	КонецЕсли;
	
КонецПроцедуры	

