	Если Не Объект.ЗаменТС.Количество() Тогда
		ДовавитьСтрокуВТаблицуЗаменТС();
		
	Иначе
		
		// каждая новый документ о передаче груза в таблице это обязятельно новый ИдентификаторСтрокиЗаменТС
		
		ТекДанные = Элементы.ЗаменТС.ТекущиеДанные;
		
		нСтроки = Объект.ДокументыОПередачеГруза.НайтиСтроки(Новый Структура("ИдентификаторСтрокиЗаменТС", ТекДанные.ИдентификаторСтроки));	
		Если нСтроки.Количество() Тогда 
