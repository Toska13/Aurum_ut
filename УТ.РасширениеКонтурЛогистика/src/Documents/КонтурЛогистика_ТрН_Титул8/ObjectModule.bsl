		МассивXDTO_ЗаменТС = КС.XDTO_ВычислитьМассивXDTO(XDTO_ЗаменТС);
		Для Каждого ЗаменТС_XDTO Из МассивXDTO_ЗаменТС Цикл 
			
			СтрокаЗаменТС = ЗаменТС.Добавить();
			
			СтрокаЗаменТС.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			
			// ДокументыОПередачеГруза 
			
			Если Не КС.XDTO_Вычислить(ЗаменТС_XDTO, "ДокПерГр") = Неопределено Тогда 
				
				СтрокаДокумент = ДокументыОПередачеГруза.Добавить();
				СтрокаДокумент.ИдентификаторСтрокиЗаменТС = СтрокаЗаменТС.ИдентификаторСтроки;
				
				СтрокаДокумент.НаимДокПерГр 	= КС.XDTO_Вычислить(ЗаменТС_XDTO.ДокПерГр, "НаимДок");
				СтрокаДокумент.НомерДокПерГр 	= КС.XDTO_Вычислить(ЗаменТС_XDTO.ДокПерГр, "НомерДок");
				СтрокаДокумент.ДатаДокПерГр 	= КС.XDTO_Вычислить(ЗаменТС_XDTO.ДокПерГр, "ДатаДок");
				СтрокаДокумент.ИдДокПерГр		= КС.XDTO_Вычислить(ЗаменТС_XDTO.ДокПерГр, "ИдДок");
				СтрокаДокумент.ДопСведДокПерГр	= КС.XDTO_Вычислить(ЗаменТС_XDTO.ДокПерГр, "ДопСведДок");
				
				МассивСторон =  КС.Конвертировать_ИдРекСостТип_вМассивСторонСоставителей(КС.XDTO_Вычислить(ЗаменТС_XDTO.ДокПерГр, "ИдРекСост"));
				Составители = Перечисления.КонтурЛогистика_СтороныСоставители.СоставителиИзМассиваСторон(ДокументЭТРН, МассивСторон);
				
				СтрокаДокумент.СтороныСостДокПерГр 	= Составители.Составитель; 
