			КонецЕсли;
			
			// НовыеТранспортныеСредства
			
			ТС_XDTO = КС.XDTO_Вычислить(ЗаменТС_XDTO, "ТС");
			Если Не ТС_XDTO = Неопределено Тогда 
				
				СтрокаТС = НовыеТранспортныеСредства.Добавить();
				
				СтрокаТС.ИдентификаторСтрокиЗаменТС = СтрокаЗаменТС.ИдентификаторСтроки;
				СтрокаТС.ТранспортноеСредство = КС.Конвертировать_СвТС_вТранспортноеСредствоЛогистика(ТС_XDTO);
				
