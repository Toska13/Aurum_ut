#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияВодительТСИзТЧвРеквизиты();
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ТрН_Титул8_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ДатВрЗамен = ТекущаяДатаСеанса();
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);
		
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗначенияВодительТСИзРеквизитовВТЧ();
		ЗаполнитьРеквизитыПоПользователю();
		
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ПредыдущийТитул")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ПредыдущийТитул) Тогда
		
		ЗаполнитьПоПредыдущемуТитулу(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();	
		
	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ТрН_Титул8_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
		
КонецПроцедуры

Процедура ЗначенияВодительТСИзРеквизитовВТЧ()
	
	Если ЗначениеЗаполнено(НовыйВодитель) Тогда 
		
		СтрокаНовогоВодителя = НовыеВодители.Добавить();
		СтрокаНовогоВодителя.Водитель = НовыйВодитель;
		СтрокаНовогоВодителя.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовыйВодитель2) Тогда 
		
		СтрокаНовогоВодителя = НовыеВодители.Добавить();
		СтрокаНовогоВодителя.Водитель = НовыйВодитель2;
		СтрокаНовогоВодителя.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеТС) ИЛИ ЗначениеЗаполнено(НовыйПрицеп) Тогда 
		
		СтрокаЗаменТС = ЗаменТС.Добавить();
		СтрокаЗаменТС.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		Если ЗначениеЗаполнено(НовоеТС) Тогда
			СтрокаНовыеТранспортныеСредства = НовыеТранспортныеСредства.Добавить();
			СтрокаНовыеТранспортныеСредства.ИдентификаторСтрокиЗаменТС = СтрокаЗаменТС.ИдентификаторСтроки;
			СтрокаНовыеТранспортныеСредства.ТранспортноеСредство = НовоеТС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НовыйПрицеп) Тогда
			СтрокаНовыеПрицепы = НовыеПрицепы.Добавить();
			СтрокаНовыеПрицепы.ИдентификаторСтрокиЗаменТС = СтрокаЗаменТС.ИдентификаторСтроки;
			СтрокаНовыеПрицепы.Прицеп = НовыйПрицеп;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗначенияВодительТСИзТЧвРеквизиты()
	
	Если НовыеВодители.Количество() > 0 Тогда 
		НовыйВодитель = НовыеВодители[0].Водитель;
		Если НовыеВодители.Количество() > 1 Тогда 
			НовыйВодитель2 = НовыеВодители[1].Водитель;
		КонецЕсли;
	КонецЕсли;
	
	Если ПредыдущиеВодители.Количество() > 0 Тогда 
		Водитель = ПредыдущиеВодители[0].Водитель;
		Если ПредыдущиеВодители.Количество() > 1 Тогда 
			Водитель2 = ПредыдущиеВодители[1].Водитель;
		КонецЕсли;
	КонецЕсли;
	
	Если НовыеТранспортныеСредства.Количество() > 0 Тогда 
		НовоеТС = НовыеТранспортныеСредства[0].ТранспортноеСредство;
	КонецЕсли;
	
	Если НовыеПрицепы.Количество() > 0 Тогда 
		НовоеТС = НовыеПрицепы[0].Прицеп;
	КонецЕсли;
	
	Если ПредыдущиеТранспортныеСредства.Количество() > 0 Тогда 
		
		Для Каждого СтрокаПредыдущегоТС Из ПредыдущиеТранспортныеСредства Цикл 
			
			Если СтрокаПредыдущегоТС.ЭтоПрицеп Тогда 
				Прицеп = СтрокаПредыдущегоТС.ТранспортноеСредство;
			Иначе
				ТС = СтрокаПредыдущегоТС.ТранспортноеСредство;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
								ДанныеЗаполнения.ТипЛогистика, 
								ДанныеЗаполнения.ДокументОснование);
								
	Если НастройкаКонвертации <> Неопределено Тогда
		ДанныеЗаполнения.Вставить("НастройкаКонвертации", НастройкаКонвертации);
	Иначе
		ВызватьИсключение "Не найдена настройка конвертации для титула 8 по документу ДокументОснование";
	КонецЕсли;								
	
	// найти Т2 - для этого найти Главный док ЭТРН
	
	НайденныйЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрН(ДокументОснование, НастройкаКонвертации);
	Если НайденныйЭТРН = Неопределено Тогда 
		ВызватьИсключение "Не найден Главный документ ЭТРН по документу " + ДокументОснование;
	КонецЕсли;
		
	НайденныйТ2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2, НайденныйЭТРН);
	
	Если НайденныйТ2 = Неопределено Тогда 
		ВызватьИсключение "Не найден титул 2 - основание для смены водителя по документу " + ДокументОснование;
	КонецЕсли;
		
	ДанныеЗаполнения.Вставить("ПредыдущийТитул", НайденныйТ2);							
	
	ЗаполнитьПоПредыдущемуТитулу(ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	НайденныйДокументЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлу(ФайлСсылка);
	
	Если Не ЗначениеЗаполнено(НайденныйДокументЭТРН) Тогда 
		
		Сообщить("При создании титула по файлу " + ФайлСсылка + "не смог найти Документ ЭТРН, создание не выполнено");
		
	Иначе
		
		ДокументЭТРН = НайденныйДокументЭТРН;
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		ЗаполнитьРеквизитыТитулаИзXDTO(XDTO);
		ЗаполнитьПредыдущихВодителей();
		ЗаполнитьПредыдущиеТС();
		
		// Комментарий - нет в формате минтранса // TODO есть в Диадоке - научиться доставать из ДД 
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПоПредыдущемуТитулу(Знач ДанныеЗаполнения)
	
	ПредыдущийТитул = ДанныеЗаполнения.ПредыдущийТитул;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
							ДанныеЗаполнения.ТипЛогистика);
							
	ДокументЭТРН = ПредыдущийТитул.ДокументЭТРН;
	
	ЗаполнитьУказателиНаПредыдущийТитул(ПредыдущийТитул);
	
	ЗаполнитьПредыдущихВодителей();
	ЗаполнитьПредыдущиеТС();
	
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
		
		ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации);

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьУказателиНаПредыдущийТитул(Знач ЛюбойТитул) Экспорт
	
	ЭтоТитул2 = ТипЗнч(ЛюбойТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2");
	
	Если ЭтоТитул2 Тогда 
		Титул2 = ЛюбойТитул;
	Иначе
		Титул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2, ЛюбойТитул.ДокументЭТРН)
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Титул2) Тогда 
		
		ФайлТитула = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Титул2);
		
		ИдФайлПрвПрием	= СтрЗаменить(ФайлТитула.ИмяФайла, ".xml", "");;
		ДатФайлПрвПрием	= Титул2.ДатИнфПрвПрием;
		ВрФайлПрвПрием	= Титул2.ВрИнфПрвПрием;
		//ДатФайлПрвПрием	= ?(ЭтоТитул2, ПредыдущийТитул.ДатИнфПрвПрием, ПредыдущийТитул.ДатИнфПрвВыд);
		//ВрФайлПрвПрием	= ?(ЭтоТитул2, ПредыдущийТитул.ВрИнфПрвПрием, ПредыдущийТитул.ВрИнфПрвВыд);
		
		ДвоичныеДанныеПодписи 	= ФайлТитула.Подпись.Получить();
		ЭППВ 					= Base64Строка(ДвоичныеДанныеПодписи);
		
	Иначе
		
		ВызватьИсключение "Не найден титул 2 (перевозчика о приеме груза к перевозке) - нельзя ввести титул эстафеты.";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПредыдущихВодителей()
	
	ПредыдущиеВодители.Очистить();
	
	Титул8 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8, ДокументЭТРН);
	
	Если ЗначениеЗаполнено(Титул8) Тогда 
		
		Для Каждого Строка Из Титул8.НовыеВодители Цикл 
			
			ЗаполнитьЗначенияСвойств(ПредыдущиеВодители.Добавить(), Строка);
			
		КонецЦикла;
		
	Иначе
		
		Титул1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументЭТРН);
		
		НоваяСтрока 			= ПредыдущиеВодители.Добавить();
		НоваяСтрока.Водитель 	= Титул1.Водитель;
		Водитель 				= Титул1.Водитель;;
		
		Если ЗначениеЗаполнено(Титул1.Водитель2) Тогда
			
			НоваяСтрока 			= ПредыдущиеВодители.Добавить();
			НоваяСтрока.Водитель 	= Титул1.Водитель2;
			Водитель2 				= Титул1.Водитель2;
			
		КонецЕсли;
		
		Для Каждого Строка Из Титул1.ДополнительныеВодители Цикл 
			
			ЗаполнитьЗначенияСвойств(ПредыдущиеВодители.Добавить(), Строка);
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ЗаполнитьПредыдущиеТС()
	
	ПредыдущиеТранспортныеСредства.Очистить();
	
	Титул8 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8, ДокументЭТРН);
	
	Если ЗначениеЗаполнено(Титул8) Тогда 
		
		Для Каждого Строка Из Титул8.НовыеТранспортныеСредства Цикл 
			
			ЗаполнитьЗначенияСвойств(ПредыдущиеТранспортныеСредства.Добавить(), Строка);
			
		КонецЦикла;
			
		Для Каждого Строка Из Титул8.НовыеПрицепы Цикл 
			
			НоваяСтрока = ПредыдущиеТранспортныеСредства.Добавить();
			
			НоваяСтрока.ТранспортноеСредство 	= Строка.Прицеп;
			НоваяСтрока.ЭтоПрицеп				= Истина; 				
			
		КонецЦикла;
		
	Иначе
		
		НоваяСтрока = ПредыдущиеТранспортныеСредства.Добавить();
		НоваяСтрока.ТранспортноеСредство = ДокументЭТРН.ТранспортноеСредство;
		
		Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп) Тогда 
			
			НоваяСтрока = ПредыдущиеТранспортныеСредства.Добавить();
			НоваяСтрока.ТранспортноеСредство = ДокументЭТРН.Прицеп;
			НоваяСтрока.ЭтоПрицеп			 = Истина;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп2) Тогда 
			
			НоваяСтрока = ПредыдущиеТранспортныеСредства.Добавить();
			НоваяСтрока.ТранспортноеСредство = ДокументЭТРН.Прицеп2;
			НоваяСтрока.ЭтоПрицеп			 = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации) Экспорт

	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
		// Заполнить ЭтотТитул
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				ДокументЭТРН.Перевозчик,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Документ = КС.XDTO_Вычислить(XDTO, "Документ");
	СодИнфЗамен = КС.XDTO_Вычислить(XDTO, "Документ.СодИнфЗамен");
	ОтметПрв 	= КС.XDTO_Вычислить(СодИнфЗамен, "ОтметЗам");
	
	ДатВрЗамен = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(КС.XDTO_Вычислить(СодИнфЗамен, "ДатВрЗамен"));
	
	ДатИнфЗамен = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(Документ, "ДатИнфЗамен"));
	ВрИнфЗамен 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(Документ, "ВрИнфЗамен"));
	
	XDTO_ИдИнфПрвПрием	= КС.XDTO_Вычислить(Документ, "ИдИнфПрвПрием");
	ИдФайлПрвПрием		= КС.XDTO_Вычислить(XDTO_ИдИнфПрвПрием, "ИдФайлПрвПрием");
	ДатФайлПрвПрием		= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO_ИдИнфПрвПрием, "ДатФайлПрвПрием"));
	ВрФайлПрвПрием		= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(XDTO_ИдИнфПрвПрием, "ВрФайлПрвПрием"));
