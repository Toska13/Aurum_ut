				МассивXDTO_СпецУслДвиж = КС.XDTO_ВычислитьМассивXDTO(КС.XDTO_Вычислить(ЗаменТС_XDTO, "СпецУслДвиж"));
				Для Каждого СпецУслДвиж_XDTO Из МассивXDTO_СпецУслДвиж Цикл 
					
					СтрокаСпецУслДвиж = СпецУсловияДвижения.Добавить();
					
					СтрокаСпецУслДвиж.ИдентификаторСтрокиЗаменТС = СтрокаЗаменТС.ИдентификаторСтроки;
					СтрокаСпецУслДвиж.НомСР 	= КС.XDTO_Вычислить(СпецУслДвиж_XDTO, "НомСР");
					СтрокаСпецУслДвиж.ДатаСР 	= КС.XDTO_Вычислить(СпецУслДвиж_XDTO, "ДатаСР");
					СтрокаСпецУслДвиж.СрокСР 	= КС.XDTO_Вычислить(СпецУслДвиж_XDTO, "СрокСР");
					
					Если Не КС.XDTO_Вычислить(СпецУслДвиж_XDTO, "СведМрш") = Неопределено Тогда
						СтрокаСпецУслДвиж.МршТекст 	= КС.XDTO_Вычислить(СпецУслДвиж_XDTO.СведМрш, "МршТекст");
