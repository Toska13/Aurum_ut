				НоваяСтрокаВодитель.НомерДокПерГрВод 	= КС.XDTO_Вычислить(ЗаменВодитXDTO.ДокПерГрВод, "НомерДок");
				НоваяСтрокаВодитель.ДатаДокПерГрВод 	= КС.XDTO_Вычислить(ЗаменВодитXDTO.ДокПерГрВод, "ДатаДок");
				НоваяСтрокаВодитель.ДопСведДокПерГрВод 	= КС.XDTO_Вычислить(ЗаменВодитXDTO.ДокПерГрВод, "ДопСведДок");
				НоваяСтрокаВодитель.ИдДокПерГрВод 		= КС.XDTO_Вычислить(ЗаменВодитXDTO.ДокПерГрВод, "ИдДок");
				
				МассивСторон =  КС.Конвертировать_ИдРекСостТип_вМассивСторонСоставителей(КС.XDTO_Вычислить(ЗаменВодитXDTO.ДокПерГрВод, "ИдРекСост"));
