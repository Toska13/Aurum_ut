// Функция - Проверить документ
//
// Параметры:
//  ДокументОбъектИлиСсылка - ДокументСсылка, ДокументОбъект - проверяемый документ может передаваться как ссылкой так и объектом
//  ТаблицаОшибок	 		- ТаблицаЗначений - можно передать таблицу с уже найденными ошибками
//  АвтоФормированиеИзТ3	- Булево - Признак автоматического формирования Т3
//  ПараметрыФормированияФайлов - Структура - Значения реквизитов заполнения файла обмена
// 
// Возвращаемое значение:
//  Структура -  см. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, АвтоФормированиеИзТ3 = Ложь, ПараметрыФормированияФайлов = Неопределено, АвтоФормированиеИзТ1 = Ложь, ПроверкаСквозногоСценария = Ложь) Экспорт
	
	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка, Истина);
	
	ТаблицаОшибок.Очистить();
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		КонтурЛогистика_ПанельОшибокСервер.ВывестиОшибкуТекущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок)
	КонецЕсли;
	ПЛ_Титул1 = ДокументОбъектИлиСсылка.Титул1; 	
	
	// наличие титула медика
	ПроверитьМедосмотрВодителей(ПЛ_Титул1, ТаблицаОшибок, АвтоФормированиеИзТ3);
	
	КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиПредыдущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ПЛ_Титул1, ТаблицаОшибок);
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		
		// TODO понять какие сценарии проверки входящего документа
		
	Иначе
		
		// TODO реализовать проверку документа
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4, ТаблицаОшибок);
		
		ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок, ПроверкаСквозногоСценария);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидация_ГСМ(ДокументОбъектИлиСсылка, ТаблицаОшибок,
			Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде, АвтоФормированиеИзТ1);
		
		Документы.КонтурЛогистика_ПЛ_Титул1.ПроверитьАктивныйПредыдущийЭПЛ(ДокументОбъектИлиСсылка.Титул1, ТаблицаОшибок);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
		
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьРоуминг(ДокументОбъектИлиСсылка, ТаблицаОшибок);

	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьМедосмотрВодителей(ПЛ_Титул1, ТаблицаОшибок, АвтоФормированиеИзТ3 = Ложь)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	Т2_Водителя1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиПЛМедосмотрВодителя(
																	ПЛ_Титул1,
																	Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2,
																	ПЛ_Титул1.Водитель);
	
	Если Т2_Водителя1 <> Неопределено Тогда 
		
		СтатусТитулаМОВодителя1 = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатусРасширенный(Т2_Водителя1);
		
		Если СтатусТитулаМОВодителя1 = Неопределено 
			ИЛИ СтатусТитулаМОВодителя1.Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
			
			ТекстОшибки = "Неверный статус медосмотра первого водителя: " + ПЛ_Титул1.Водитель;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Титул1", КатегорияПредупреждение, ТекстОшибки, "Проверить");
			
		ИначеЕсли СтатусТитулаМОВодителя1.Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи Тогда
					
			ТекстОшибки = "Водитель не прошел медосмотр: " + ПЛ_Титул1.Водитель;			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Титул1", КатегорияОшибка, ТекстОшибки, "Проверить");
			
		КонецЕсли;
		
	Иначе
		
		Если АвтоФормированиеИзТ3 Тогда
			ТекстОшибки = "Для подписания титула ПЛ4 - Путевой лист (одометр предрейсовый) требуется титул ПЛ2 - Путевой лист (медосмотр предрейсовый) для водителя " 
				+ ПЛ_Титул1.Водитель;
		Иначе
			ТекстОшибки = "Не найден медосмотр первого водителя: " + ПЛ_Титул1.Водитель;
		КонецЕсли;
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Титул1", КатегорияОшибка, ТекстОшибки, "Проверить");
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ПЛ_Титул1.Водитель2) Тогда
		
		Т2_Водителя2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиПЛМедосмотрВодителя(
																		ПЛ_Титул1,
																		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2,
																		ПЛ_Титул1.Водитель2);
		Если Т2_Водителя2 <> Неопределено Тогда 
			
			СтатусТитулаМОВодителя2 = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатусРасширенный(Т2_Водителя2);
			
			Если СтатусТитулаМОВодителя2 = Неопределено
				ИЛИ СтатусТитулаМОВодителя2 = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
				
				ТекстОшибки = "Неверный статус медосмотра второго водителя: " + ПЛ_Титул1.Водитель2;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Титул1", КатегорияПредупреждение, ТекстОшибки, "Проверить");
				
			ИначеЕсли СтатусТитулаМОВодителя2.Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи Тогда
				
				ТекстОшибки = "Второй водитель не прошел медосмотр:  " + ПЛ_Титул1.Водитель2;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Титул1", КатегорияОшибка, ТекстОшибки, "Проверить");
		
			КонецЕсли;

		Иначе
			
			Если АвтоФормированиеИзТ3 Тогда
				ТекстОшибки = "Для подписания титула ПЛ4 - Путевой лист (одометр предрейсовый) требуется титул ПЛ2 - Путевой лист (медосмотр предрейсовый) для второго водителя " 
					+ ПЛ_Титул1.Водитель2;
			Иначе
				ТекстОшибки = "Не найден медосмотр второго водителя: " + ПЛ_Титул1.Водитель2;
			КонецЕсли;
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Титул1", КатегорияПредупреждение, ТекстОшибки, "Выполнить обмен");
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок, ПроверкаСквозногоСценария = Ложь)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ДокументТитул1 = Объект.Титул1;
	ДокументТитул3 = Объект.Титул3;
	
	Если НЕ ЗначениеЗаполнено(ДокументТитул1)  Тогда
		
		ТекстОшибки = "Титул не привязан к первому титулу Путевого листа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"ДокументТитул1", КатегорияОшибка, ТекстОшибки, "Указать");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументТитул3) И НЕ ДокументТитул1.ЭтоСменаВодителя Тогда
		
		ТекстОшибки = "Титул не привязан к титулу техосмотра Путевого листа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"ДокументТитул1", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЭПСоб)  Тогда
		
		ТекстОшибки = "Не получена подпись составителя Т1";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"ЭПСоб", КатегорияОшибка, ТекстОшибки, "Выполнить обмен");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ЭПТехСост) И НЕ ДокументТитул1.ЭтоСменаВодителя Тогда
		
		ТекстОшибки = "Не получена подпись составителя Т3";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"ЭПТехСост", КатегорияОшибка, ТекстОшибки, "Выполнить обмен");
	КонецЕсли;
	
	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" Или Прав(ОбязательныйРевизит, 14) = "МассивСтруктур"
			Или (ПроверкаСквозногоСценария И ОбязательныйРевизит = "УИД_ПЛ") Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			ОбязательныйРевизитСиноним = Документы.КонтурЛогистика_ПЛ_Титул4.СинонимРеквизита(ОбязательныйРевизит);
			ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ОбязательныйРевизит, КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
	КонецЦикла;
	
	// Провдение документа основания
	КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьПроведениеДокументаОснования(Объект, ТаблицаОшибок, КатегорияОшибка);
	
	// TODO
	// ГЛУБОКИЕ ВАЛИДАЦИИ, ВЗАИМНЫЕ ВАЛИДАЦИИ
	
КонецПроцедуры

