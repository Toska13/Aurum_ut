#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ПЛ_Титул4_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		// TODO
		//ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		//ЗаполнитьРеквизитыПоПользователю();
		
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ПредыдущийТитул")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ПредыдущийТитул) Тогда
		
		ЗаполнитьПоПредыдущемуТитулу(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		КонтурЛогистика_ОбработкаДокументовСервер.ДополнитьДополнительныхПолучателейИзГлавногоДокумента(ЭтотОбъект, Титул1);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);

	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ПЛ_Титул4_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
		
КонецПроцедуры

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	НайденныйДокументТ1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлуПЛ(ФайлСсылка);
	
	Если Не ЗначениеЗаполнено(НайденныйДокументТ1) Тогда 
		
		Сообщить("При создании титула по файлу " + ФайлСсылка + "не смог найти исходный документ Титул1 путевого листа, создание не выполнено");
		
	Иначе
		
		Титул1 = НайденныйДокументТ1;
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		Если Найти(XDTO.ИдФайл, "DP_UVUTOCH") = 0 Тогда 
			
			ЗаполнитьРеквизитыТитулаИзXDTO(XDTO);
			
		Иначе
			
			ЗаполнитьРеквизитыТитулаИзXDTOОтказ(XDTO);
			
		КонецЕсли;
		
		// Комментарий - нет в формате минтранса // TODO есть в Диадоке - научиться доставать из ДД 
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Документ 		= КС.XDTO_Вычислить(XDTO, "Документ");
	СодИнфВыезд 	= КС.XDTO_Вычислить(XDTO, "Документ.СодИнфВыезд");
	
	УИД_ПЛ 		= КС.XDTO_Вычислить(СодИнфВыезд, "УИД_ПЛ");
	
	ДатИнфВыезд 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(Документ, "ДатИнфВыезд"));
	ВрИнфВыезд 		= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(Документ, "ВрИнфВыезд"));
	
	ДатФайлИнфТехСост = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(Документ, "ИдИнфТехСост.ДатФайлИнфТехСост"));
	ВрФайлИнфТехСост 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(Документ, "ИдИнфТехСост.ВрФайлИнфТехСост"));
	ИдФайлИнфТехСост 	= КС.XDTO_Вычислить(Документ, "ИдИнфТехСост.ИдФайлИнфТехСост");
	
	ЭПТехСост = КС.XDTO_Вычислить(Документ, "ИдИнфТехСост.ЭП");
	
	ТипПодпис_raw = КС.XDTO_Вычислить(Документ, "ПодпИнфВыезд.ТипПодпис");
	ТипПодпис = Перечисления.КонтурЛогистика_ТипыПодписи.ЗначениеИзXDTO(ТипПодпис_raw);
	
	СпосПодтПолном_raw = КС.XDTO_Вычислить(Документ, "ПодпИнфВыезд.СпосПодтПолном");
	СпосПодтПолном = Перечисления.КонтурЛогистика_СпособыПодтвержденияПолномочий.ЗначениеИзXDTO(СпосПодтПолном_raw);
	
	Должность 	= КС.XDTO_Вычислить(Документ, "ПодпИнфВыезд.Должн");
	
	Фамилия 	= КС.XDTO_Вычислить(Документ, "ПодпИнфВыезд.ФИО.Фамилия");
	Имя 		= КС.XDTO_Вычислить(Документ, "ПодпИнфВыезд.ФИО.Имя");
	Отчество 	= КС.XDTO_Вычислить(Документ, "ПодпИнфВыезд.ФИО.Отчество");
	
	СвОдомВыезд_XDTO 	= КС.XDTO_Вычислить(СодИнфВыезд, "СвОдомВыезд");
	ПоказанияОдометра 	= КС.XDTO_Вычислить(СвОдомВыезд_XDTO, "ОдомВыезд");   
	ДатВрОдометр 		= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(КС.XDTO_Вычислить(СвОдомВыезд_XDTO, "ДатВрВыезд"));
	
	ОдометрРаботник_raw = КС.XDTO_Вычислить(СодИнфВыезд, "СвУплЛиц");
	ОдометрРаботник = КС.Конвертировать_СведОтвЛицоТип_вСотрудникаЛогистика(ОдометрРаботник_raw);
	
	КС.ЗаполнитьДополнительныхПолучателей(XDTO, ЭтотОбъект);

КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTOОтказ(Знач XDTO)
	
	ЕстьОтказВПодписи = Истина;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Документ = КС.XDTO_Вычислить(XDTO, "Документ");
	
	// Данные Подписанта
	XDTO_Подписант 		= КС.XDTO_Вычислить(Документ, "Подписант");
	
	Должность 	= КС.XDTO_Вычислить(XDTO_Подписант, "Должн");
	Фамилия 	= КС.XDTO_Вычислить(XDTO_Подписант, "ФИО.Фамилия");
	Имя 		= КС.XDTO_Вычислить(XDTO_Подписант, "ФИО.Имя");
	Отчество 	= КС.XDTO_Вычислить(XDTO_Подписант, "ФИО.Отчество");
		
	ТекстУведомления 		= КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "Документ.СвУведУточ.ТекстУведУточ");	
	ПричинаОтказаВПодписи 	= ?(Не ТипЗнч(ТекстУведомления) = Тип("ОбъектXDTO"), ТекстУведомления, ""); 
	
КонецПроцедуры

Процедура ЗаполнитьПоПредыдущемуТитулу(Знач ДанныеЗаполнения)
	
	ПредыдущийТитул = ДанныеЗаполнения.ПредыдущийТитул;
	
	УИД_ПЛ = ПредыдущийТитул.УИД_ПЛ;
	Если ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		Титул1 = ПредыдущийТитул;
	Иначе
		Титул1 = ПредыдущийТитул.Титул1;
	КонецЕсли;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	
	// Поиск документа учетной системы
	Если ЗначениеЗаполнено(НастройкаКонвертации.ТипДокумента1С) Тогда
		
		НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыПоТипуЛогистика(Титул1, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
		
		Если ЗначениеЗаполнено(НайденныйДокУчСист) Тогда 
			ДокументОснование = НайденныйДокУчСист;
		КонецЕсли;
		
	КонецЕсли;
	
	Титул3 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3, Титул1);
	
	Если Не ЗначениеЗаполнено(ДатВрОдометр) Тогда
		ДатВрОдометр = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Титул1.ЭтоСменаВодителя Тогда 
		ЭтоСменаВодителя = Истина;
	КонецЕсли;
	
	Если ДанныеЗаполнения.Свойство("ПроверкаЗаполнения") Тогда
		ЭПСоб = "<для проверки заполнения>";
		ЭПТехСост = "<для проверки заполнения>";
	Иначе
		ЗаполнитьУказателиНаПредыдущийТитул(Титул1, Титул3);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации);
	КонецЕсли;
	
	// Если эти показания одометра - продолжения предыдущего ПЛ - то проставим значение оттуда
	Если Титул1.ЭтоСменаВодителя Тогда 
		ИсходныйПЛ = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Титул1, "ПредыдущийПЛ");
		Если ЗначениеЗаполнено(ИсходныйПЛ) Тогда 
			НайденныйТ5 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 , ИсходныйПЛ);
			Если ЗначениеЗаполнено(НайденныйТ5) Тогда 
				ПоказанияОдометра = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(НайденныйТ5, "ПоказанияОдометра");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Данные из рабочего места
	Если ДанныеЗаполнения.Свойство("ЭтоСменаВодителя") И ЗначениеЗаполнено(ДанныеЗаполнения.ЭтоСменаВодителя) Тогда
		ЭтоСменаВодителя = ДанныеЗаполнения.ЭтоСменаВодителя;
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("ОдометрРаботник") И ЗначениеЗаполнено(ДанныеЗаполнения.ОдометрРаботник) Тогда
		ОдометрРаботник = ДанныеЗаполнения.ОдометрРаботник;
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("Должность") И ЗначениеЗаполнено(ДанныеЗаполнения.Должность) Тогда
		Должность = ДанныеЗаполнения.Должность;
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("ПоказанияОдометра") И ЗначениеЗаполнено(ДанныеЗаполнения.ПоказанияОдометра) Тогда
		ПоказанияОдометра = ДанныеЗаполнения.ПоказанияОдометра;
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("ДатВрОдометр") И ЗначениеЗаполнено(ДанныеЗаполнения.ДатВрОдометр) Тогда
		ДатВрОдометр = ДанныеЗаполнения.ДатВрОдометр;
	КонецЕсли;
	
	// Данные сквозного сценария (из титула 1)
	Если Титул1.ФормироватьТ4Сразу Тогда
		ОдометрРаботник = Титул1.ДанныеТ4ОдометрРаботник;
		Должность = Титул1.ДанныеТ4Должность;
		ПоказанияОдометра = Титул1.ДанныеТ4ПоказанияОдометра;
		ДатВрОдометр = Титул1.ДанныеТ4ДатВрОдометр;
		ПользовательПодписант = Титул1.ДанныеТ4ПользовательПодписант;
		ПараметрНастроекПодписания = Титул1.ДанныеТ4ПараметрНастроекПодписания;
		
		ЕстьНеОтправленныеДанныеПоГСМ = КонтурЛогистика_ОбработкаДокументовСервер.ЕстьНеОтправленныеДанныеПоГСМ(
			Титул1.kl_id, Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде);
		Если ЕстьНеОтправленныеДанныеПоГСМ Тогда
			// Пробуем отправить сразу
			ОтборДанных = Новый Структура;
			ОтборДанных.Вставить("ОрганизацияДиадок", Титул1.ЛицоОформившееПЛ);
			ОтборДанных.Вставить("ТипДанных", РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ);
			ОтборДанных.Вставить("Разрез1", Титул1.kl_id);
			ОтборДанных.Вставить("Разрез2", Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде);
			
			КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьПроизволныеДанные(ОтборДанных);
		КонецЕсли;
	КонецЕсли;
	
	// Данные сквозного сценария (из титула 3)
	Если ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")
		И ПредыдущийТитул.ФормироватьТ4Сразу Тогда
		
		ОдометрРаботник = ПредыдущийТитул.ДанныеТ4ОдометрРаботник;
		Должность = ПредыдущийТитул.ДанныеТ4Должность;
		ПоказанияОдометра = ПредыдущийТитул.ДанныеТ4ПоказанияОдометра;
		ДатВрОдометр = ПредыдущийТитул.ДанныеТ4ДатВрОдометр;
		ПользовательПодписант = ПредыдущийТитул.ДанныеТ4ПользовательПодписант;
		ПараметрНастроекПодписания = ПредыдущийТитул.ДанныеТ4ПараметрНастроекПодписания;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьУказателиНаПредыдущийТитул(Знач Титул1, Титул3) Экспорт
	
	Перем ДвоичныеДанныеПодписи, ФайлТитула1;
	
	ФайлТитула1 = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Титул1);
	
	Если Не ЗначениеЗаполнено(ФайлТитула1) Тогда 
		ВызватьИсключение "Не найден файл обмена Титулом1 Путевого листа - невозможно создать Титул4: " + Титул1;
	КонецЕсли;
	
	ИдФайлИнфСоб 	= СтрЗаменить(ФайлТитула1.ИмяФайла, ".xml", "");
	ДатФайлИнфСоб 	= Титул1.ДатИнфСоб;
	ВрФайлИнфСоб  	= Титул1.ВрИнфСоб;
	
	ДвоичныеДанныеПодписи = ФайлТитула1.Подпись.Получить();
	ЭПСоб 				= Base64Строка(ДвоичныеДанныеПодписи);

	ФайлТитула3 = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Титул3);
	
	Если ЗначениеЗаполнено(ФайлТитула3) Тогда
		ИдФайлИнфТехСост 	= СтрЗаменить(ФайлТитула3.ИмяФайла, ".xml", "");
		ДатФайлИнфТехСост 	= Титул3.ДатИнфТехСост;
		ВрФайлИнфТехСост  	= Титул3.ВрИнфТехСост;
		
		ДвоичныеДанныеПодписи = ФайлТитула3.Подпись.Получить();
		ЭПТехСост 				= Base64Строка(ДвоичныеДанныеПодписи);
	Иначе
		
		Если Не Титул1.ЭтоСменаВодителя Тогда // если смена водителя - то указателя на Т3 нет в природе - и это норм по формату
			ВызватьИсключение "Не найден файл обмена Титулом 3 Путевого листа - невозможно создать Титул4: " + Титул3;
		КонецЕсли;
	КонецЕсли;
	

КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ОрганизацияПодписанта = ?(ЗначениеЗаполнено(Титул1.ОрганизацияТехСостояние), Титул1.ОрганизацияТехСостояние, Титул1.ЛицоОформившееПЛ);
			
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				ОрганизацияПодписанта,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации) Экспорт

	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
		//Заполнить ЭтотТитул
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьФайлОбмена(ПараметрыФайлаРеквизиты = Неопределено) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	Попытка
	
		Заблокировать();
	
	Исключение
		
		Результат.Успешно = Ложь;
	    Результат.ОписаниеОшибки = "Не удалось заблокировать документ: " + ОписаниеОшибки();
		Возврат Результат;
		
	КонецПопытки;
	
	// Проверка статуса после наложения блокировки на Документ
	РезультатПроверкиСтатуса = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьТекущийСтатусДокументаДляСозданияФайловОбмена(Ссылка);
	
	Если НЕ РезультатПроверкиСтатуса.Успешно Тогда
		Разблокировать();
		Возврат РезультатПроверкиСтатуса;
	КонецЕсли;
	
	// Выполнить валидацию документа
	РезультатВалидации = Документы.КонтурЛогистика_ПЛ_Титул4.ПроверитьДокумент(Ссылка);
	
	Если РезультатВалидации.КоличествоОшибок > 0 Тогда
		
		Разблокировать();
		Результат.ОписаниеОшибки = "Ошибки в " + Ссылка + "! Исправьте их для отправки.";
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		ДатИнфВыезд = ТекущаяДатаСеанса();
		ВрИнфВыезд = ТекущаяДатаСеанса();
		
		// формируем текст xml
		РезультатФормированияТекста = СформироватьТекстФайла(ДатИнфВыезд, ВрИнфВыезд);
		
		Если РезультатФормированияТекста.Успешно = Ложь Тогда
					
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормированияТекста));
			Возврат Результат;
					
		КонецЕсли;
		
		// запишем в справочник
		РезультатСозданияФайла = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьФайлОбмена(
										РезультатФормированияТекста,
										Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4,
										ПараметрыФайлаРеквизиты,
										Ссылка);
				
		ЗаполнитьЗначенияСвойств(Результат, РезультатСозданияФайла);
		
		Если Результат.Успешно Тогда
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Ссылка, 
				Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена, , Истина);
			
			Результат.МассивФайловОбмена.Добавить(РезультатСозданияФайла.Файл);
			
		Иначе
			
			ВызватьИсключение КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(Результат);
			
		КонецЕсли;
		
		Записать(); // запишем  ДатИнфТехСост и ВрИнфТехСост
		
		Разблокировать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Разблокировать();
		Результат.Успешно = Ложь;
		Результат.Массивошибок.Добавить("Ошибка при формировании файла обмена по документу " + Ссылка + ": " + ОписаниеОшибки());
		
		КонтекстМетода = Новый Структура;
		КонтекстМетода.Вставить("ПараметрыФайлаРеквизиты", ПараметрыФайлаРеквизиты);
		КонтекстМетода.Вставить("РезультатСозданияФайла", РезультатСозданияФайла);
		
		КонтурЛогистика_Метрика.ОбработатьОшибкуФормированияТекстаФайла(Ссылка, ИнформацияОбОшибке(), КонтекстМетода);
		
	КонецПопытки;
	
	Возврат Результат;
		
		
КонецФункции 

Функция СформироватьТекстФайла(ДатаФормирования, ВремяФормирования)
	
	НомерТитула = 4;
	Формат = "5.01";
	ТипДокументооборота = "__PL";
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ТекстФайла", "");
	
	XDTO_Файл = КС.XDTO_ФайлОбмена(НомерТитула, Формат, ТипДокументооборота);
	
	GUID = Строка(Новый УникальныйИдентификатор);
	
	Если ДополнительныеПолучателиФайла.Количество() > 0 Тогда 
		W = 1;
	Иначе
		W = 0;
	КонецЕсли;
	
	КС.ДобавитьДополнительныхПолучателейФайла(XDTO_Файл, ДополнительныеПолучателиФайла); 	
	
	XDTO_Файл.ИдФайл = КС.ИдентификаторФайлаТитулаПЛ(НомерТитула, 
												Титул1.ЛицоОформившееПЛ,
												Титул1.ОрганизацияМедик,
												Титул1.ОрганизацияТехСостояние,
												Титул1.ОрганизацияОдометр,
												GUID,
												W); 
	Результат.Вставить("ИдФайл",		XDTO_Файл.ИдФайл);
												
	ОрганизацияПодписанта = ?(ЗначениеЗаполнено(Титул1.ОрганизацияТехСостояние), Титул1.ОрганизацияТехСостояние, Титул1.ЛицоОформившееПЛ);
	ПодписантСтруктура 	= РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
		ОрганизацияПодписанта, ПользовательПодписант, Неопределено, ЭтотОбъект, ПараметрНастроекПодписания);
	
	XDTO_Подписант 		= КС.XDTO_ПодпИнф(НомерТитула, ТипДокументооборота, Формат, ПодписантСтруктура);
	Если ЗначениеЗаполнено(ПодписантСтруктура.МЧД) И ПодписантСтруктура.СпосПодтПолном = "3" Тогда 
		Результат.Вставить("ИдентификаторМЧД",	ПодписантСтруктура.МЧД);
	КонецЕсли;
	
	XDTO_Файл.Документ	= КС.XDTO_Документ(НомерТитула, ТипДокументооборота, Формат, XDTO_Подписант, ДатаФормирования, ВремяФормирования);
	
	Если Титул1.ЭтоСменаВодителя Тогда 
		XDTO_ИдИнфСоб 		= КС.XDTO_ПЛ_ИдИнфСоб(НомерТитула, Формат, Ссылка);
		КС.XDTO_Установить(XDTO_Файл.Документ, "ИдИнфСоб", XDTO_ИдИнфСоб);
	Иначе
		XDTO_ИдИнфТехСост 		= КС.XDTO_ПЛ_ИдИнфТехСост(НомерТитула, Формат, Ссылка);
		КС.XDTO_Установить(XDTO_Файл.Документ, "ИдИнфТехСост", XDTO_ИдИнфТехСост);
	КонецЕсли;

	XDTO_СодИнфВыезд = КС.XDTO_ПЛ_СодИнфВыезд(НомерТитула, Формат, Ссылка);
	КС.XDTO_Установить(XDTO_Файл.Документ, "СодИнфВыезд", XDTO_СодИнфВыезд);
	
	ТекстФайла = КонтурЛогистика_КонструкторыXDTO.ПодготовитьТекстФайлаЛогистика(XDTO_Файл);
	
	Результат.Вставить("ТекстФайла",ТекстФайла);
	Результат.Вставить("GUID",		GUID);
	
	Результат.Успешно = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецЕсли