&НаКлиенте
Процедура ПерезаполнитьПоДокОснованию(Команда)

	ПерезаполнитьПоДокОснованиюСервер();
	ОбновитьДанныеФормы();

	ПолностьюОбновитьПредставлениеДанных();

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер()

	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда

		Объект.Товары.Очистить();
		Объект.ДополнительныеПолучателиФайла.Очистить();
		Объект.ИнфПол.Очистить();
		
		ДокОбъект = РеквизитФормыВЗначение("Объект");
		ДокОбъект.Заполнить(Новый Структура("ДокументОснование, ТипЛогистика",
											ДокОбъект.ДокументОснование,
											Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ДФ_Титул1));
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;

	КонецЕсли;

КонецПроцедуры

