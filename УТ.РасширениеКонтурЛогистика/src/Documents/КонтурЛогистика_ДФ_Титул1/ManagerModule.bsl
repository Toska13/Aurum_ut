Функция ДопРеквизитСтруктура(Имя, Синоним, Комментарий, ТипЗначения, КартинкаИндекс)
	Возврат Новый Структура("Имя, Синоним, Комментарий, Тип, Картинка", Имя, Синоним, Комментарий, ТипЗначения, КартинкаИндекс);	
КонецФункции

Функция ПолучитьСледующийПоЦепочкеТипТитулаДФ(ДокДФТ1Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокДФТ1Ссылка) Тогда 
		ВызватьИсключение "Не заполнен Документ - не могу определить титул";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ДФ_Титул2) КАК ТипТитула
	               |ПОМЕСТИТЬ ВТ_ВсеТитулыДФ
	               |ИЗ
	               |	Документ.КонтурЛогистика_ДФ_Титул1 КАК КонтурЛогистика_ДФ_Титул1
	               |ГДЕ
	               |	КонтурЛогистика_ДФ_Титул1.Ссылка = &ДокументДФТ1
	               |	И НЕ КонтурЛогистика_ДФ_Титул1.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВсеТитулыДФ.ТипТитула КАК ТипТитула
	               |ИЗ
	               |	ВТ_ВсеТитулыДФ КАК ВТ_ВсеТитулыДФ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ_ВсеТитулыДФ.ТипТитула.Порядок УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументДФТ1", ДокДФТ1Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ТипТитула;
	Иначе
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ДФ_Титул1;
	КонецЕсли;
	
КонецФункции

