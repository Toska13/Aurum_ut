		Объект.ПромПунктМрш.Очистить();
		Объект.СвЛицГО.Очистить();
		Объект.АдрПункт.Очистить();
		Объект.ОпасныеГрузы.Очистить();
		Объект.ТоварыПунктыПогрузкиВыгрузки.Очистить();
		Объект.ДополнительныеПолучателиФайла.Очистить();
		Объект.ИнфПол.Очистить();
		
		ДокОбъект = РеквизитФормыВЗначение("Объект");
		ДокОбъект.Заполнить(Новый Структура("ДокументОснование, ТипЛогистика",
											ДокОбъект.ДокументОснование,
											Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1));
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;

	КонецЕсли;

