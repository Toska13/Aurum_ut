// Прочее

Процедура ЗаполнитьДанныеОПунктахМаршрута()
	
	ОтборСтрокПогрузки = Новый Структура("Погрузка", Истина);
	СтрокиПогрузки = АдрПункт.НайтиСтроки(ОтборСтрокПогрузки);
	
	ОтборСтрокВыгрузки = Новый Структура("Выгрузка", Истина);
	СтрокиВыгрузки = АдрПункт.НайтиСтроки(ОтборСтрокВыгрузки);
	
	КоличествоПунктовПогрузки = СтрокиПогрузки.Количество();
	КоличествоПунктовВыгрузки = СтрокиВыгрузки.Количество();
	
	Если КоличествоПунктовВыгрузки > 0 Тогда
		
		ПервыйПунктВыгрузки		= СтрокиВыгрузки[0].ПунктМаршрута;
		ПоследнийПунктВыгрузки  = СтрокиВыгрузки[СтрокиВыгрузки.ВГраница()].ПунктМаршрута;		
		
	Иначе
		
		ПервыйПунктВыгрузки		= Справочники.КонтурЛогистика_ПунктыМаршрута.ПустаяСсылка();
		ПоследнийПунктВыгрузки  = Справочники.КонтурЛогистика_ПунктыМаршрута.ПустаяСсылка();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли

