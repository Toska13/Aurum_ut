#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ = Ложь 
		И Не ЗначениеЗаполнено(УИД_Зак) 
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоВходящийДокумент(ДополнительныеСвойства) 
		И ЗначениеЗаполнено(Грузоотправитель) Тогда
		
		Организация = КонтурЛогистика_ОбщегоНазначенияСервер.ОрганизацияДляЗапросаУИДов(ЭтотОбъект);
		
		ПолученныйУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ПолучитьОчередной(Организация);
		Если ПолученныйУИД <> Неопределено Тогда
			УИД_Зак = ПолученныйУИД;
			ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация);
		Иначе
			Сообщить("Не получен УИД из пула. Закончились?");
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ = Ложь Тогда
		
		ЗаполнитьДанныеОПунктахМаршрута();	
		
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЗЗ_Титул1_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// а) Из документа учетной системы
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// б) загружен из сервиса, создаем из файла обмена
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);
		
	// в) копирование 
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Титул")
		И ДанныеЗаполнения.Свойство("Скопировать")
		И ДанныеЗаполнения.Скопировать Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Титул);
		Для каждого ТЧ Из ЭтотОбъект.Метаданные().ТабличныеЧасти Цикл
			Для каждого Стр Из ДанныеЗаполнения.Титул[ТЧ.Имя] Цикл
				НоваяСтрока = ЭтотОбъект[ТЧ.Имя].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		КонецЦикла;
		
		ЭтотОбъект.Номер = "";
		ЭтотОбъект.УИД_Зак = "";
		ЭтотОбъект.Дата = ТекущаяДатаСеанса();
		ЭтотОбъект.ДатаЗак = ТекущаяДатаСеанса();
		КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьНомерКопииКНомеруДокумента(ЭтотОбъект.НомЗак, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1);

	// г) ручной ввод Т1 с нуля
	Иначе
		
		ЗаполнитьРеквизитыПоПользователю();
		
	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЗЗ_Титул1_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДата();
	УИД_Зак = "";
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из док Основания

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
								ДанныеЗаполнения.ТипЛогистика, 
								ДанныеЗаполнения.ДокументОснование);
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		
		Сообщить("Не найдена настройка конвертации по " + ДанныеЗаполнения.ДокументОснование + ". Проверьте настройки конвертации документов");
		Возврат;
		
	КонецЕсли;
	
	//Заполнить ЭтотТитул
	
	Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ЭтотОбъект, ДокументОснование, НастройкаКонвертации, "");
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации, , Переменные);
	
	ТЗ_ТоварыВременная = ЗаполнитьТабЧастьТовары(НастройкаКонвертации, Переменные);
	
	// если не были сгенерированы при формировании 
	КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТЗ_ТоварыВременная);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда 
		КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	КонецЕсли;
	
	// Сворачиваем товары
	Если КонтурЛогистика_ОбработкаДокументовСервер.НужноСворачиватьТовары(
			ТЗ_ТоварыВременная,
			ПартнерПеревозчик,
			НастройкаКонвертации.СворачиватьТабЧастьТовары) Тогда
			
		ТЗ_ТоварыВременная = КонтурЛогистика_КонвертацияСервер.СвернутьТовары(ТЗ_ТоварыВременная, ЭтотОбъект, НастройкаКонвертации);
			
	КонецЕсли;	
	Товары.Загрузить(ТЗ_ТоварыВременная);
	
	// положим ПунктПод в ТЧ АдрПункт
	Если ЗначениеЗаполнено(ПунктПод) и АдрПункт.Количество() = 0 Тогда 
		
		НоваяСтрокаПодачи = АдрПункт.Добавить();
		НоваяСтрокаПодачи.Погрузка = Истина;
		НоваяСтрокаПодачи.ПунктМаршрута = ПунктПод;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьТабЧастьТовары(НастройкаКонвертации, Переменные = Неопределено)
	
	Товары.Очистить();
			
	ТЗ_ТоварыВременная = Товары.Выгрузить();
	
	КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ЗаполнитьТабЧастьТоварыПоДокументуУчетнойСистемы(ТЗ_ТоварыВременная, НастройкаКонвертации, ЭтотОбъект, , Переменные);
	
	// заполнить метод определения массы из настроек
	МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");		
	Для Каждого Строка Из ТЗ_ТоварыВременная Цикл 
		Если Не ЗначениеЗаполнено(Строка.МетодОпределенияМассы) Тогда 
			Строка.МетодОпределенияМассы = МетодОпределенияМассы;
		КонецЕсли;	
	КонецЦикла;		
	
	Возврат ТЗ_ТоварыВременная;
	
КонецФункции

Процедура СконвертироватьСтрокуТоваров1СвЛогистика(НомерСтроки) Экспорт
	
	СтрокаТоваров = Товары.Найти(НомерСтроки, "НомерСтроки");
	
	// сформировать расширенную (с упаковками) строку товаров
	ТЗ_ТоварыВременная = Товары.ВыгрузитьКолонки(); 
	
	СтрокаТоваровВременная = ТЗ_ТоварыВременная.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТоваровВременная, СтрокаТоваров);
	
	КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	
	// положить расширенную строку товаров обратно в ТоварыДокумента1С
	ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаТоваровВременная);
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоУмолчаниюВСтрокеТоваров(СтрокаТоваров)
	
	// если есть дефолтные значения, например в настройках
	ДефолтМетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
	
	Если Не ЗначениеЗаполнено(СтрокаТоваров.ДефолтМетодОпределенияМассы) Тогда 
		СтрокаТоваров.МетодОпределенияМассы = ДефолтМетодОпределенияМассы;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				Грузоотправитель,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку( "ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из пришедшего файла XML

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
	
	СодИнфГО = XDTO.Документ.СодИнфГО; 
	
	ЗаполнитьРеквизитыТитулаИзXDTO(XDTO, СодИнфГО);
	
	ЗаполнитьТоварыИзXDTO(СодИнфГО);
	
	КонтурЛогистика_КонструкторыXDTO.ЗаполнитьИнфПолИзXDTO(СодИнфГО, ЭтотОбъект, "ИнфПол");
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO, Знач СодИнфГО)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	УИД_Зак 	= КС.XDTO_Вычислить(СодИнфГО, "УИД_Зак");
	
	ЭтотОбъект.Функция 	= Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO, "Документ.Функция"));
	
	ДатИнфГО 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ДатИнфГО"));
	ВрИнфГО 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ВрИнфГО"));
	
	НаимЭкСубСост 	= КС.XDTO_Вычислить(СодИнфГО, "НаимЭкСубСост");
	
	ОснДовОргСост 	= КС.Конвертировать_РеквДокТип_вДоговорЛогистика(КС.XDTO_Вычислить(XDTO, "Документ.ОснДовОргСост"));
	ДогОргПрвз 		= КС.Конвертировать_РеквДокТип_вДоговорЛогистика(КС.XDTO_Вычислить(XDTO, "Документ.ДогОргПрвз"));
	
	НомЗак 			= КС.XDTO_Вычислить(СодИнфГО, "НомЗак");
	ДатаЗак 		= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СодИнфГО, "ДатаЗак"));
	
	УказанияВОтношенииНормПеревозки  = КС.XDTO_Вычислить(СодИнфГО, "УкНормПрвз");
	ПредСрПрвз 		= КС.XDTO_Вычислить(СодИнфГО, "ПредСрПрвз");
	ПрвзПищПрод 	= КС.XDTO_Вычислить(СодИнфГО, "ПрвзПищПрод");
	ИныеУслв 		= КС.XDTO_Вычислить(СодИнфГО, "ИныеУслв");
	КонПунктМрш 	= КС.XDTO_Вычислить(СодИнфГО, "КонПунктМрш");
	
	ПромПунктМрш_raw = КС.XDTO_Вычислить(СодИнфГО, "ПромПунктМрш");
	Если Не ПромПунктМрш_raw = Неопределено Тогда
		МассивПромПунктМрш = КС.XDTO_ВычислитьМассивXDTO(ПромПунктМрш_raw);
		Для Каждого XDTO_ПромПунктМрш Из МассивПромПунктМрш Цикл 
			НоваяСтрокаПромПунктМрш = ПромПунктМрш.Добавить();
			НоваяСтрокаПромПунктМрш.ПромПунктМрш = XDTO_ПромПунктМрш;
		КонецЦикла;
	КонецЕсли;
	
	Грузоотправитель   	= КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_Вычислить(СодИнфГО, "СвГО"));
	Перевозчик   		= КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_Вычислить(СодИнфГО, "СвПрв"));
	
	СвЛицГО_raw = КС.XDTO_Вычислить(СодИнфГО, "СвЛицГО");
	Если Не СвЛицГО_raw = Неопределено Тогда
		МассивСвЛицГО = КС.XDTO_ВычислитьМассивXDTO(СвЛицГО_raw);
		Для Каждого XDTO_СвЛицГО Из МассивСвЛицГО Цикл 
			НоваяСтрокаСвЛицГО = СвЛицГО.Добавить();
			НоваяСтрокаСвЛицГО.Полномочие 	= Перечисления.КонтурЛогистика_ПолномочияДействий.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO_СвЛицГО, "Полн"));
			НоваяСтрокаСвЛицГО.Участник 	= КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_Вычислить(XDTO_СвЛицГО, "РеквЛицГО"));
			XDTO_РеквДокПолн 				= КС.XDTO_Вычислить(XDTO_СвЛицГО, "РеквДокПолн");
			КС.ЗаполнитьСтрокуСопрДокИзРеквДокТип(НоваяСтрокаСвЛицГО, XDTO_РеквДокПолн);
		КонецЦикла;
	КонецЕсли;
	
	ПунктПод		= КС.Конвертировать_АдресПользТип2023_вПунктМаршрутаЛогистика(КС.XDTO_Вычислить(СодИнфГО, "ПунктПод.АдрПунктПод"));
	ДатВрПод		= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(КС.XDTO_Вычислить(СодИнфГО, "ПунктПод.ДатВрПод"));
	ПредВрПод		= КС.Конвертировать_ВремяВЗТип_вВремяСеанса(КС.XDTO_Вычислить(СодИнфГО, "ПунктПод.ПредВрПод"));

	АдрПункт_raw = КС.XDTO_Вычислить(СодИнфГО, "АдрПункт");
	Если Не АдрПункт_raw = Неопределено Тогда
		
		МассивАдрПункт = КС.XDTO_ВычислитьМассивXDTO(АдрПункт_raw);
		Для Каждого XDTO_АдрПункт Из МассивАдрПункт Цикл
			
			НоваяСтрокаАдрПункт = АдрПункт.Добавить();
			НоваяСтрокаАдрПункт.Погрузка 	= КС.XDTO_Вычислить(XDTO_АдрПункт, "Опер") = "Погрузка";
			НоваяСтрокаАдрПункт.Выгрузка 	= КС.XDTO_Вычислить(XDTO_АдрПункт, "Опер") = "Выгрузка";
			НоваяСтрокаАдрПункт.ДатВрОпер 	= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(КС.XDTO_Вычислить(XDTO_АдрПункт, "ДатВрОпер"));
			НоваяСтрокаАдрПункт.ПредВрОпер 	= КС.Конвертировать_ВремяВЗТип_вВремяСеанса(КС.XDTO_Вычислить(XDTO_АдрПункт, "ПредВрОпер"));
			ПунктМаршрута_raw = КС.XDTO_Вычислить(XDTO_АдрПункт, "АдресПункт");
			НоваяСтрокаАдрПункт.ПунктМаршрута 	= КС.Конвертировать_АдресПользТип2023_вПунктМаршрутаЛогистика(ПунктМаршрута_raw);
			
		КонецЦикла;
		
	КонецЕсли;
	
	XDTO_ПарТСПрвз 	= КС.XDTO_Вычислить(СодИнфГО, "ПарТСПрвз");
	ТСТип 				= КС.XDTO_Вычислить(XDTO_ПарТСПрвз, "Тип");	
	ТСГрузопод 			= КС.XDTO_Вычислить(XDTO_ПарТСПрвз, "Грузопод");	
	ТСВместим 			= КС.XDTO_Вычислить(XDTO_ПарТСПрвз, "Вместим");	
	ТСТипПогр 			= КС.XDTO_Вычислить(XDTO_ПарТСПрвз, "ТипПогр");	
	ТСТипКуз 			= КС.XDTO_Вычислить(XDTO_ПарТСПрвз, "ТипКуз");	
	ТСДрПарам 			= КС.XDTO_Вычислить(XDTO_ПарТСПрвз, "ДрПарам");	
	
	ТемператураНеНиже			= КС.XDTO_Вычислить(СодИнфГО, "ТемпРеж.ТемпНеНиже");
	ТемператураНеВыше			= КС.XDTO_Вычислить(СодИнфГО, "ТемпРеж.ТемпНеВыше");
	ВлажностьНеНиже				= КС.XDTO_Вычислить(СодИнфГО, "ВлажнРеж.ВлажнНеНиже");
	ВлажностьНеВыше				= КС.XDTO_Вычислить(СодИнфГО, "ВлажнРеж.ВлажнНеВыше");
	
КонецПроцедуры

Процедура ЗаполнитьТоварыИзXDTO(Знач СодИнфГО)
	
	Перем ВидТар_raw, ЗакУсл_raw, МассивОпГруз, НоваяСтрокаТовара, ОпГруз, ОпГруз_raw, стрОбъявленнаяЦенность_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Товары.Очистить();
	
	ОпГруз_raw 					= КС.XDTO_Вычислить(СодИнфГО, "ОпГруз");
	МассивОпГруз 				= КС.XDTO_ВычислитьМассивXDTO(ОпГруз_raw);
	Для Каждого ОпГруз из МассивОпГруз Цикл 
		
		НоваяСтрокаТовара = Товары.Добавить();
		НоваяСтрокаТовара.Учитывать = Истина;
		НоваяСтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		НоваяСтрокаТовара.ОтгрузочноеНаименование 	= КС.XDTO_Вычислить(ОпГруз, "НаимГруз");
		НоваяСтрокаТовара.СостояниеГруза 			= КС.XDTO_Вычислить(ОпГруз, "СостГруз");
		ВидТар_raw = КС.XDTO_Вычислить(ОпГруз, "ВидТар");
		Если ЗначениеЗаполнено(ВидТар_raw) Тогда                                          
			НоваяСтрокаТовара.ВидТары 				= Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду(ВидТар_raw);
		КонецЕсли;
		НоваяСтрокаТовара.ДопИнформация  			= КС.XDTO_Вычислить(ОпГруз, "ДрОГруз");
		
		НоваяСтрокаТовара.КоличествоМест  			= КС.XDTO_Вычислить(ОпГруз, "КолГрМест");
		НоваяСтрокаТовара.МетодОпределенияМассы  	= Перечисления.КонтурЛогистика_МетодыОпределенияМассы.ЗначениеИзXDTO(КС.XDTO_Вычислить(ОпГруз, "МетОпрМасс"));
		НоваяСтрокаТовара.МассаПлановаяБруттоКг  	= КС.XDTO_Вычислить(ОпГруз, "МасГруз.МасБрутЗнач");
		НоваяСтрокаТовара.МассаПлановаяНеттоКг  	= КС.XDTO_Вычислить(ОпГруз, "МасГруз.МасНетЗнач");
		НоваяСтрокаТовара.КоличествоПаллет  		= КС.XDTO_Вычислить(ОпГруз, "МасГруз.КолПалл");
		НоваяСтрокаТовара.МасТар  					= КС.XDTO_Вычислить(ОпГруз, "МасГруз.МасТар");
		НоваяСтрокаТовара.ОбъемКубМ  				= КС.XDTO_Вычислить(ОпГруз, "Объем");
		
		НоваяСтрокаТовара.Высота  					= КС.XDTO_Вычислить(ОпГруз, "РазмерГрМест.ВысЗнач");
		НоваяСтрокаТовара.Длина  					= КС.XDTO_Вычислить(ОпГруз, "РазмерГрМест.ДлЗнач");
		НоваяСтрокаТовара.Ширина  					= КС.XDTO_Вычислить(ОпГруз, "РазмерГрМест.ШирЗнач");
		
		НоваяСтрокаТовара.РаспрГр  					= КС.XDTO_Вычислить(ОпГруз, "РаспрГр") = "1";
		НоваяСтрокаТовара.ДелГр  					= КС.XDTO_Вычислить(ОпГруз, "ДелГр") = "1";
		НоваяСтрокаТовара.УчВодПогрГр  				= КС.XDTO_Вычислить(ОпГруз, "УчВодПогрГр") = "1";
		НоваяСтрокаТовара.ПрГрКонт  				= Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ЗначениеИзXDTO(КС.XDTO_Вычислить(ОпГруз, "ПрГрКонт"));
		
		ЗакУсл_raw									= КС.XDTO_Вычислить(ОпГруз, "ЗакУсл");
		Если ЗакУсл_raw <> Неопределено Тогда
			НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(ЗакУсл_raw);
			
			Если ЗначениеЗаполнено(НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок) 
				И НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок.СвязанныеОбъекты.Количество() > 0 Тогда 
				
				НоваяСтрокаТовара.ЗаказчикПеревозки  = НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок.СвязанныеОбъекты[0].СвязанныйОбъект;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДогУслПрвз_raw                = КС.XDTO_Вычислить(ОпГруз, "ДогУслПрвз");
		
		Если ДогУслПрвз_raw <> Неопределено Тогда
			НоваяСтрокаТовара.ДоговорПеревозкиЛогистика = КС.Конвертировать_РеквДокТип_вДоговорЛогистика(ДогУслПрвз_raw);
			
			Если ЗначениеЗаполнено(НоваяСтрокаТовара.ДоговорПеревозкиЛогистика) 
				И НоваяСтрокаТовара.ДоговорПеревозкиЛогистика.СвязанныеОбъекты.Количество() > 0 Тогда 
				
				НоваяСтрокаТовара.ДоговорПеревозки  = НоваяСтрокаТовара.ДоговорПеревозкиЛогистика.СвязанныеОбъекты[0].СвязанныйОбъект;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьОпасныеГрузыИзXDTO(НоваяСтрокаТовара, ОпГруз);
		ЗаполнитьТоварыПунктыПогрузкиВыгрузкиИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТоварыПунктыПогрузкиВыгрузкиИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	Пункты_raw = КС.XDTO_Вычислить(ОпГруз, "Пункт");
	
	Если Пункты_raw <> Неопределено Тогда
		
		МассивПунктовТоваров = КС.XDTO_ВычислитьМассивXDTO(Пункты_raw);
		 Для Каждого XDTO_ПунктТоваров Из МассивПунктовТоваров Цикл 
			 
			 НовыйСтрокаПунктТоваров = ТоварыПунктыПогрузкиВыгрузки.Добавить();
			 НовыйСтрокаПунктТоваров.ИдентификаторСтрокиТоваров 	= НоваяСтрокаТовара.ИдентификаторСтроки;
			 НовыйСтрокаПунктТоваров.Выгрузка 	= КС.XDTO_Вычислить(XDTO_ПунктТоваров, "Выгр");
			 НовыйСтрокаПунктТоваров.Погрузка 	= КС.XDTO_Вычислить(XDTO_ПунктТоваров, "Погр");
			 НовыйСтрокаПунктТоваров.КолГрМест 	= КС.XDTO_Вычислить(XDTO_ПунктТоваров, "КолГрМест");
			 
		 КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОпасныеГрузыИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем НоваяСтрокаОпГр, СвОпГруз_XDTO;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвОпГруз_XDTO = КС.XDTO_Вычислить(ОпГруз, "ИнфОпасн");
	Если СвОпГруз_XDTO <> Неопределено Тогда
		
		НоваяСтрокаОпГр = ОпасныеГрузы.Добавить();
		НоваяСтрокаОпГр.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
		
		НоваяСтрокаОпГр.НомерООН 						= КС.XDTO_Вычислить(СвОпГруз_XDTO, "НомООН");
		НоваяСтрокаОпГр.НадлежащееОтгрузочноеНаименование = КС.XDTO_Вычислить(СвОпГруз_XDTO, "НадОтгНаим");
		НоваяСтрокаОпГр.ТехническоеНаименование 		= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ТехНаим");
		НоваяСтрокаОпГр.Описание 						= КС.XDTO_Вычислить(СвОпГруз_XDTO, "Описание");
		НоваяСтрокаОпГр.Класс 							= Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.ЗначениеИзXDTO(КС.XDTO_Вычислить(СвОпГруз_XDTO, "Клас"));
		НоваяСтрокаОпГр.КлассификационныйКод 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КласКод");
		НоваяСтрокаОпГр.ГруппаУпаковки 					= Перечисления.КонтурЛогистика_ГруппыУпаковки.ЗначениеИзXDTO(КС.XDTO_Вычислить(СвОпГруз_XDTO, "ГрУп"));
		НоваяСтрокаОпГр.ЗнакОпасности 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ЗнОп");
		НоваяСтрокаОпГр.КодОграниченияТуннели 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КодОгрЧерТун");
		НоваяСтрокаОпГр.Радионуклиды 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "НазРадионук");
		НоваяСтрокаОпГр.ОписаниеФизХимФормы 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОписФизХимФорм");
		НоваяСтрокаОпГр.МаксАктивностьРадиации 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "МаксАкт");
		НоваяСтрокаОпГр.КатегорияУпаковки 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КатУпак");
		НоваяСтрокаОпГр.ТранспортныйИндекс 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ТрансИндекс");
		НоваяСтрокаОпГр.ИндексБезопасности 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ИндексБез");
		НоваяСтрокаОпГр.ОпознавательныйЗнакСертификатов = КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОпозЗнак");
		НоваяСтрокаОпГр.ПолнаяАктивностьГруза 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ПолнАктГр");
		НоваяСтрокаОпГр.ОбМасНетВзрСод 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОбМасНетВзрСод");
		НоваяСтрокаОпГр.ОбМасНетВзрСодВсех 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОбМасНетВзрСодВсех");
		НоваяСтрокаОпГр.ПроцСмеси 						= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ПроцСмеси");
		НоваяСтрокаОпГр.ДатаИстеченияВремениУдержания 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СвОпГруз_XDTO, "ДатИстВрУдер"));
		НоваяСтрокаОпГр.КонтрольнаяТемпература 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КонтТемпер");
		НоваяСтрокаОпГр.АварийнаяТемпература 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "АварТемпер");
		
	КонецЕсли;

КонецПроцедуры

