Функция РезультатПроверкиПолейТС(ДокЭтрнСсылка)
	
	Отказ = Ложь;
	
	РезультатПроверкиОбщий = Справочники.КонтурЛогистика_ТранспортныеСредства.ОписаниеРезультатаПроверки();
	РезультатПроверкиТС = Справочники.КонтурЛогистика_ТранспортныеСредства.ОписаниеРезультатаПроверки();
	РезультатПроверкиПрицепа = Справочники.КонтурЛогистика_ТранспортныеСредства.ОписаниеРезультатаПроверки();
	РезультатПроверкиПрицепа2 = Справочники.КонтурЛогистика_ТранспортныеСредства.ОписаниеРезультатаПроверки();
	
	ТранспортноеСредство = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(ДокЭТрНСсылка, "ТранспортноеСредство");
	Если ЗначениеЗаполнено(ТранспортноеСредство) Тогда 
		
		РезультатПроверкиТС = Справочники.КонтурЛогистика_ТранспортныеСредства.РезультатПроверкиАрендатораДоговора(ТранспортноеСредство, Отказ);
		
		Если РезультатПроверкиТС.ЕстьОшибки Тогда
			Для Каждого Ошибка Из РезультатПроверкиТС.ОшибкиПолей Цикл
				Ошибка.ИмяПоля = "ТранспортноеСредство." + Ошибка.ИмяПоля; 
				РезультатПроверкиОбщий.ОшибкиПолей.Добавить(Ошибка);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Прицеп = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(ДокЭТрНСсылка, "Прицеп");
	Если ЗначениеЗаполнено(Прицеп) Тогда 
		РезультатПроверкиПрицепа = Справочники.КонтурЛогистика_ТранспортныеСредства.РезультатПроверкиАрендатораДоговора(Прицеп, Отказ);
		
		Если РезультатПроверкиПрицепа.ЕстьОшибки Тогда
			Для Каждого Ошибка Из РезультатПроверкиПрицепа.ОшибкиПолей Цикл 
				Ошибка.ИмяПоля = "Прицеп." + Ошибка.ИмяПоля; 
				РезультатПроверкиОбщий.ОшибкиПолей.Добавить(Ошибка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Прицеп2 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(ДокЭТрНСсылка, "Прицеп2");
	Если ЗначениеЗаполнено(Прицеп2) Тогда 
		РезультатПроверкиПрицепа2 = Справочники.КонтурЛогистика_ТранспортныеСредства.РезультатПроверкиАрендатораДоговора(Прицеп2, Отказ);
		
		Если РезультатПроверкиПрицепа2.ЕстьОшибки Тогда
			Для Каждого Ошибка Из РезультатПроверкиПрицепа2.ОшибкиПолей Цикл 
				Ошибка.ИмяПоля = "Прицеп2." + Ошибка.ИмяПоля; 
				РезультатПроверкиОбщий.ОшибкиПолей.Добавить(Ошибка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	РезультатПроверкиОбщий.ЕстьОшибки = РезультатПроверкиТС.ЕстьОшибки Или РезультатПроверкиПрицепа.ЕстьОшибки Или РезультатПроверкиПрицепа2.ЕстьОшибки;
	
	Возврат РезультатПроверкиОбщий;
	
КонецФункции

