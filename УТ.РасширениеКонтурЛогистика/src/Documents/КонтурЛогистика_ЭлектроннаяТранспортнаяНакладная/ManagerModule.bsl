	ДанныеПечати.Вставить("ДанныеПодписания", Пакеты[9].Выгрузить());
	ДанныеПечати.Вставить("ДанныеСотрудников", Пакеты[11].Выгрузить());
	ДанныеПечати.Вставить("ДанныеДоговоров", Пакеты[13].Выгрузить());
	ДанныеПечати.Вставить("ВыборкаОрганизации", Пакеты[15].Выбрать());
	
	Возврат ДанныеПечати;
	
КонецФункции

Процедура ОбновитьГрузополучателяИМестоДоставки(ДокЭтрнСсылка, Титул7Ссылка) Экспорт 
			
		ДокЭтрнОбъект = ДокЭтрнСсылка.ПолучитьОбъект();
		
		НайденныйДокументТитул3 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3, ДокЭтрнСсылка);
				
		// для титула 2 перезапишем в ЭТрН новое место доставки и нового ГП
		// для титула 4, а значит и для титула 3 запишем возвратные место и ГП
		Если ЗначениеЗаполнено(НайденныйДокументТитул3) Тогда 
			
			ДокЭтрнОбъект.ВозвратМесто = Титул7Ссылка.АдрВыгруз;
			
			Если ЗначениеЗаполнено(Титул7Ссылка.НовГрузПол) Тогда 
				ДокЭтрнОбъект.ВозвратПолучатель = Титул7Ссылка.НовГрузПол;
			КонецЕсли;
			
		Иначе
			
			// значит сюда попали изи титула 7 до приемки

			// в документе теперь новое место доставки
			// НО! это могла быть не первая переадресовка. 
			// и заменять ПереадресовкаИсходноеМестоДоставки и ПереадресовкаИсходныйПолучатель
			// нужно только если они пустые
			Если Не ЗначениеЗаполнено(ДокЭтрнОбъект.ПереадресовкаИсходноеМестоДоставки) Тогда 
				ДокЭтрнОбъект.ПереадресовкаИсходноеМестоДоставки = ДокЭтрнОбъект.МестоДоставки;
			КонецЕсли;
			ДокЭтрнОбъект.МестоДоставки 	= Титул7Ссылка.АдрВыгруз;
			
			Если ЗначениеЗаполнено(Титул7Ссылка.НовГрузПол) Тогда
				// в документе теперь новый грузополучатель
				// см. чуть выше - важно учесть что это может быть не первая переадресовка
				Если Не ЗначениеЗаполнено(ДокЭтрнОбъект.ПереадресовкаИсходныйПолучатель) Тогда 
					ДокЭтрнОбъект.ПереадресовкаИсходныйПолучатель = ДокЭтрнОбъект.Грузополучатель;
				КонецЕсли;
				ДокЭтрнОбъект.Грузополучатель = Титул7Ссылка.НовГрузПол;
			КонецЕсли;
			
		КонецЕсли;
		
		ДокЭтрнОбъект.Записать();
			
КонецПроцедуры	

Процедура ОбновитьСчетчикПереадресовок(ДокЭтрнСсылка) Экспорт 
	
	ДокЭтрнОбъект = ДокЭтрнСсылка.ПолучитьОбъект();
	
	ДокЭтрнОбъект.КоличествоПереадресовок = ДокЭтрнОбъект.КоличествоПереадресовок + 1;
	
	ДокЭтрнОбъект.Записать();
	
КонецПроцедуры

Процедура ОбновитьСчетчикСменИТелефон(ДокЭтрнСсылка, Титул8Ссылка) Экспорт 
	
	ДокЭтрнОбъект = ДокЭтрнСсылка.ПолучитьОбъект();
	
	Если Титул8Ссылка.НовыеВодители.Количество() Тогда  
		ДокЭтрнОбъект.КоличествоСменВодителей = ДокЭтрнОбъект.КоличествоСменВодителей + 1;
		
		Если ЗначениеЗаполнено(Титул8Ссылка.НовыеВодители[0].Водитель)
			И ЗначениеЗаполнено(Титул8Ссылка.НовыеВодители[0].Водитель.ТелефонОсновной) Тогда
			
			ДокЭтрнОбъект.ТелефонВодителя = Титул8Ссылка.НовыеВодители[0].Водитель.ТелефонОсновной;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Титул8Ссылка.НовыеТранспортныеСредства.Количество() Или Титул8Ссылка.НовыеПрицепы.Количество() Тогда 
		ДокЭтрнОбъект.КоличествоСменТС = ДокЭтрнОбъект.КоличествоСменТС + 1;
	КонецЕсли;
	

	ДокЭтрнОбъект.Записать();
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеАдреса(ТаблицаОшибок, КатегорияОшибка, ПунктМаршрутаСсылка, ИмяПунктаМаршрута = "МестоПогрузки", ПроверкаТ7 = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ПунктМаршрутаСсылка) Тогда
		
		ЗаполнениеАдресаВариант1 = ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфАдрес) И ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфКодСтраны);
		ЗаполнениеАдресаВариант2 = ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИндекс) И ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресКодРегион);
		ЗаполнениеАдресаВариант3 = ЗначениеЗаполнено(ПунктМаршрутаСсылка.КодГАР);
		
		СинонимПоля = "";
		Если ИмяПунктаМаршрута = "МестоПогрузки" Тогда 
			СинонимПоля	= "Месте погрузки";
		ИначеЕсли ИмяПунктаМаршрута = "МестоДоставки" Тогда 
			СинонимПоля	= "Месте доставки";
		ИначеЕсли ИмяПунктаМаршрута = "АдрВыгруз" Тогда 
			СинонимПоля	= "Новом Месте доставки";
		Иначе
			СинонимПоля	= ИмяПунктаМаршрута;
		КонецЕсли;
		
		
		Если Не ЗаполнениеАдресаВариант1 И Не ЗаполнениеАдресаВариант2 И Не ЗаполнениеАдресаВариант3 Тогда 
			
			Если ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфАдрес) И Не ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфКодСтраны) И Не ЗаполнениеАдресаВариант2 И Не ЗаполнениеАдресаВариант3 Тогда 
				
				ТекстОшибки = "Укажите Код страны в " + СинонимПоля + ?(ПроверкаТ7, "" , " (в Документе электронной транспортной накладной)");
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				?(ПроверкаТ7, "" , "ГлавныйДокумент.") + ИмяПунктаМаршрута + ".АдресИнфКодСтраны", КатегорияОшибка, ТекстОшибки, "Указать");
				
			ИначеЕсли Не ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфАдрес) И ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфКодСтраны) И Не ЗаполнениеАдресаВариант2 И Не ЗаполнениеАдресаВариант3 Тогда 
				
				ТекстОшибки = "Укажите Адрес в " + СинонимПоля + ?(ПроверкаТ7, "" , " (в Документе электронной транспортной накладной)");
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				?(ПроверкаТ7, "" , "ГлавныйДокумент.") + ИмяПунктаМаршрута + ".АдресИнфАдрес", КатегорияОшибка, ТекстОшибки, "Указать");		
				
			ИначеЕсли ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИндекс) И Не ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресКодРегион) И Не ЗаполнениеАдресаВариант1 И Не ЗаполнениеАдресаВариант3 Тогда 
				
				ТекстОшибки = "Укажите Код региона в " + СинонимПоля + ?(ПроверкаТ7, "" , " (в Документе электронной транспортной накладной)");
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				?(ПроверкаТ7, "" , "ГлавныйДокумент.") + ИмяПунктаМаршрута + ".АдресКодРегион", КатегорияОшибка, ТекстОшибки, "Указать");
				
			ИначеЕсли Не ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИндекс) И ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресКодРегион) И Не ЗаполнениеАдресаВариант1 И Не ЗаполнениеАдресаВариант3 Тогда 
				
				ТекстОшибки = "Укажите Индекс в " + СинонимПоля + ?(ПроверкаТ7, "" , " (в Документе электронной транспортной накладной)");
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				?(ПроверкаТ7, "" , "ГлавныйДокумент.") + ИмяПунктаМаршрута + ".АдресИндекс", КатегорияОшибка, ТекстОшибки, "Указать");
				
			Иначе
				
				ТекстОшибки = "Укажите Адрес и Код страны в " + СинонимПоля + ?(ПроверкаТ7, "" , " (в Документе электронной транспортной накладной)");
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				?(ПроверкаТ7, "" , "ГлавныйДокумент.") + ИмяПунктаМаршрута + ".АдресИнфАдрес", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

