Функция ПогрузкуОсуществляетДругаяОрганизация(ДокЭТрНСсылка) Экспорт

	Если (ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкуОсуществляет) 
		Или ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкаДоговор)
		Или ДокЭТрНСсылка.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку)
		И ЗначениеЗаполнено(ДокЭТрНСсылка.Грузоотправитель)
		И ДокЭТрНСсылка.ПогрузкуОсуществляет <> ДокЭТрНСсылка.Грузоотправитель Тогда
		
		ПогрузкуОсуществляетДругаяОрганизация = Истина;
		
	Иначе
		
		ПогрузкуОсуществляетДругаяОрганизация = Ложь;
		
	КонецЕсли;
	
	Возврат ПогрузкуОсуществляетДругаяОрганизация;

КонецФункции

// Допроверяет то что не проверено вызовом МассивОбязательныхРеквизитов
Процедура ПроверитьКлючевыеРеквизитыЭтРН(ДокЭТрНСсылка, ТаблицаОшибок, ВместоОшибокПредупреждения = Ложь, ПолнаяПроверка = Истина) Экспорт
	
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	Если ВместоОшибокПредупреждения Тогда 
		КатегорияОшибка = КатегорияПредупреждение;
	Иначе
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КонецЕсли;
	КатегорияОшибкаБезусловная = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
		
	Если ДокЭТрНСсылка.Перевозчик.ИНН = ДокЭТрНСсылка.Грузополучатель.ИНН Тогда
		
		ТекстОшибки = "Грузополучатель и перевозчик совпадают.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.ДокументЭТРН", КатегорияПредупреждение, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// ИНН
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Грузоотправитель.ИНН) Тогда 
		
		ТекстОшибки = "Укажите в Грузоотправителе ИНН (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.ИНН", КатегорияОшибкаБезусловная, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Перевозчик.ИНН) Тогда 
		
		ТекстОшибки = "Укажите в Перевозчике ИНН (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Грузополучатель.ИНН) Тогда 
		
		ТекстОшибки = "Укажите в Грузополучателе ИНН (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// НаименованиеОрганизацииПолное
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Грузоотправитель.НаименованиеОрганизацииПолное) Тогда 
		
		ТекстОшибки = "Укажите в Грузоотправителе Полное наименование (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Перевозчик.НаименованиеОрганизацииПолное) Тогда 
		
		ТекстОшибки = "Укажите в Перевозчике Полное наименование (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Грузополучатель.НаименованиеОрганизацииПолное) Тогда 
		
		ТекстОшибки = "Укажите в Грузополучателе Полное наименование (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// ИдентификаторУчастникаЭДО
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Грузоотправитель.ИдентификаторУчастникаЭДО) Тогда 
		
		ТекстОшибки = "Укажите в Грузоотправителе Идентификатор участника ЭДО (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.ИдентификаторУчастникаЭДО", КатегорияОшибкаБезусловная, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Перевозчик.ИдентификаторУчастникаЭДО) Тогда 
		
		ТекстОшибки = "Укажите в Перевозчике Идентификатор участника ЭДО (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.Грузополучатель.ИдентификаторУчастникаЭДО) Тогда 
		
		ТекстОшибки = "Укажите в Грузополучателе Идентификатор участника ЭДО (в Документе электронной транспортной накладной)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// Для титулов 2 и 3 дальнейшие прверки не важны
	Если Не ПолнаяПроверка Тогда
		Возврат;
	КонецЕсли;
	
	// Телефоны
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЭТрНСсылка.Грузоотправитель) Тогда 
		
		ТекстОшибки = "Укажите Телефон Грузоотправителя";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЭТрНСсылка.Перевозчик) Тогда 
		
		ТекстОшибки = "Укажите Телефон Перевозчика";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЭТрНСсылка.Грузополучатель) Тогда 
		
		ТекстОшибки = "Укажите Телефон Грузополучателя";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// Экспедитор
	Если ДокЭТрНСсылка.ЭтоЭкспедиция Тогда 
		
		Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияЗаказчик.ИНН) Тогда 
			
			ТекстОшибки = "Укажите в Заказчике перевозки ИНН (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.ЭкспедицияЗаказчик.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияЗаказчик.НаименованиеОрганизацииПолное) Тогда 
			
			ТекстОшибки = "Укажите в Заказчике перевозки Полное наименование (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.ЭкспедицияЗаказчик.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЭТрНСсылка.ЭкспедицияЗаказчик) Тогда 
			
			ТекстОшибки = "Укажите Телефон Заказчика перевозки";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.ЭкспедицияЗаказчик.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияДоговор) Тогда
			
			ТекстОшибки = "Укажите договор с заказчиком перевозки (экспедиторский договор)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.ЭкспедицияДоговор", КатегорияОшибка, ТекстОшибки, "Указать");
			
		Иначе
			
			Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияДоговор.Организация) 
				И Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияДоговор.ОрганизацияИНН) Тогда
				
				ТекстОшибки = "Укажите организацию или ИНН, к которой относится договор с заказчиком перевозки (экспедиторский договор)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ЭкспедицияДоговор.ОрганизацияИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;	
			
			Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияДоговор.Контрагент) 
				И Не ЗначениеЗаполнено(ДокЭТрНСсылка.ЭкспедицияДоговор.КонтрагентИНН) Тогда
				
				ТекстОшибки = "Укажите контрагента или ИНН, с которым у организации заключен договор с заказчиком перевозки (экспедиторский договор)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ЭкспедицияДоговор.КонтрагентИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьДоговор(ДокЭТрНСсылка.ЭкспедицияДоговор, ТаблицаОшибок, КатегорияОшибка, "ГлавныйДокумент.ПогрузкаДоговор.ДатаДокумента");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Откуда и куда везем
	МестоПогрузки = ДокЭТрНСсылка.МестоПогрузки;
	ПроверитьЗаполнениеАдреса(ТаблицаОшибок, КатегорияОшибка, МестоПогрузки);
	
	Если ЗначениеЗаполнено(МестоПогрузки) И Не ЗначениеЗаполнено(МестоПогрузки.Собственник) И Не ЗначениеЗаполнено(СокрЛП(МестоПогрузки.СобственникНеУказанПричина)) Тогда
		
		ТекстОшибки = "Укажите Собственника Места погрузки (в Документе электронной транспортной накладной) или причину почему информации о собственнике нет";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.МестоПогрузки.Собственник", КатегорияОшибка, ТекстОшибки, "Указать");
		
	ИначеЕсли ЗначениеЗаполнено(МестоПогрузки) И ЗначениеЗаполнено(МестоПогрузки.Собственник) Тогда 
		
		Если Не ЗначениеЗаполнено(МестоПогрузки.Собственник.ИНН) Тогда
			
			ТекстОшибки = "Укажите в Собственнике Места погрузки ИНН (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.МестоПогрузки.Собственник.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(МестоПогрузки.Собственник.НаименованиеОрганизацииПолное) Тогда
			
			ТекстОшибки = "Укажите в Собственнике Места погрузки Полное наименование организации (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.МестоПогрузки.Собственник.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(МестоПогрузки.Собственник) Тогда
			
			ТекстОшибки = "Укажите телефон в Собственнике Места погрузки (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.МестоПогрузки.Собственник.ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЕсли;
	
	МестоДоставки = ДокЭТрНСсылка.МестоДоставки;
	ПроверитьЗаполнениеАдреса(ТаблицаОшибок, КатегорияОшибка, МестоДоставки, "МестоДоставки");
	
	Если Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПогрузкуОсуществляетДругаяОрганизация(ДокЭТрНСсылка) Тогда
		
		Если ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкуОсуществляет) Тогда
		
			Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкуОсуществляет.ИНН) Тогда
				
				ТекстОшибки = "Укажите в Организации осуществляющей погрузку ИНН (в Документе электронной транспортной накладной)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ПогрузкуОсуществляет.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкуОсуществляет.НаименованиеОрганизацииПолное) Тогда
				
				ТекстОшибки = "Укажите в Организации осуществляющей погрузку Полное наименование организации (в Документе электронной транспортной накладной)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ПогрузкуОсуществляет.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЭТрНСсылка.ПогрузкуОсуществляет) Тогда
				
				ТекстОшибки = "Укажите Телефон в Организации осуществляющей погрузку(в Документе электронной транспортной накладной)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ПогрузкуОсуществляет.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
		
		КонецЕсли;
			
		Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкаДоговор) Тогда
		
			ТекстОшибки = "Укажите договор-основание полномочий составителя файла обмена";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ГлавныйДокумент.ПогрузкаДоговор", КатегорияОшибка, ТекстОшибки, "Указать");
			
		Иначе 
			
			Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкаДоговор.Организация) И Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкаДоговор.ОрганизацияИНН) Тогда
				
				ТекстОшибки = "Укажите организацию или ИНН, к которой относится договор-погрузки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ПогрузкаДоговор.ОрганизацияИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;	
			
			Если Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкаДоговор.Контрагент) И Не ЗначениеЗаполнено(ДокЭТрНСсылка.ПогрузкаДоговор.КонтрагентИНН) Тогда
				
				ТекстОшибки = "Укажите контрагента или ИНН, с которым у организации заключен договор погрузки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ГлавныйДокумент.ПогрузкаДоговор.КонтрагентИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьДоговор(ДокЭТрНСсылка.ПогрузкаДоговор, ТаблицаОшибок, КатегорияОшибка, "ГлавныйДокумент.ПогрузкаДоговор.ДатаДокумента");
			
		КонецЕсли;		
		
	КонецЕсли;
	
	// Проверяем заполнены ли поля Лизингодатель/Договор для отдельных видов владения
	РезультатПроверкиПолейТС = РезультатПроверкиПолейТС(ДокЭтрнСсылка);
	Если РезультатПроверкиПолейТС.ЕстьОшибки Тогда
		
		Для Каждого ОшибкаПоля Из РезультатПроверкиПолейТС.ОшибкиПолей Цикл
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, 
				"", 
				"", 
				"ГлавныйДокумент." + ОшибкаПоля.ИмяПоля, 
				КатегорияОшибка, 
				ОшибкаПоля.ТекстОшибки, 
				"Указать");
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПоследнийПоДатеТитулЭТРН(ДокЭТрНСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ТрН_Титул1.Дата КАК Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = &ДокументЭТРН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул2.Ссылка,
	|	КонтурЛогистика_ТрН_Титул2.Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = &ДокументЭТРН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул3.Ссылка,
	|	КонтурЛогистика_ТрН_Титул3.Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул3 КАК КонтурЛогистика_ТрН_Титул3
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул3.ДокументЭТРН = &ДокументЭТРН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул4.Ссылка,
	|	КонтурЛогистика_ТрН_Титул4.Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул4 КАК КонтурЛогистика_ТрН_Титул4
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул4.ДокументЭТРН = &ДокументЭТРН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументЭТРН", ДокЭТрНСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
	
		Возврат Выборка.Ссылка;
		
	Иначе
		
		Возврат Неопределено;
	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСледующийПоЦепочкеТипТитулаЭТРН(ДокЭтрнСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(ДокЭтрнСсылка) Тогда 
		ВызватьИсключение "Не заполнен Этрн - не могу определить титул";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2) КАК ТипТитула
	|ПОМЕСТИТЬ ВТ_ВсеТитулыЭТРН
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = &ДокументЭТРН
	|	И НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = &ДокументЭТРН
	|	И НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4)
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул3 КАК КонтурЛогистика_ТрН_Титул3
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул3.ДокументЭТРН = &ДокументЭТРН
	|	И НЕ КонтурЛогистика_ТрН_Титул3.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеТитулыЭТРН.ТипТитула КАК ТипТитула
	|ИЗ
	|	ВТ_ВсеТитулыЭТРН КАК ВТ_ВсеТитулыЭТРН
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ВсеТитулыЭТРН.ТипТитула.Порядок УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументЭТРН", ДокЭтрнСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ТипТитула;
	Иначе
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДляПечатиТрН(МассивДокументовЭТрН) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка,
	|	ТранспортныеСредства.Ссылка КАК ТранспортноеСредство
	|ПОМЕСТИТЬ ВТ_ЭТрН
	|ИЗ
	|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ТранспортныеСредства КАК ТранспортныеСредства
	|		ПО КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ТранспортноеСредство = ТранспортныеСредства.Ссылка
	|			И (НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления)
	|ГДЕ
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка В(&МассивДокументовЭТрН)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЭТрН.Ссылка.kl_id КАК kl_id,
	|	ВТ_ЭТрН.Ссылка КАК ДокументЭТРН,
	|	ВТ_ЭТрН.Ссылка.НомерТрН КАК НомерТрН,
	|	ВТ_ЭТрН.Ссылка.ДатаТрН КАК ДатаТрН,
	|	ВЫБОР
	|		КОГДА ВТ_ЭТрН.Ссылка.НомЗак = """"
	|			ТОГДА ""Без номера""
	|		ИНАЧЕ ВТ_ЭТрН.Ссылка.НомЗак
	|	КОНЕЦ КАК НомЗак,
	|	ВТ_ЭТрН.Ссылка.ДатаЗак КАК ДатаЗак,
	|	ВЫБОР
	|		КОГДА ВТ_ЭТрН.Ссылка.ЭтоЭкспедиция
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК ГОЭксп,
	|	ВТ_ЭТрН.Ссылка.Грузоотправитель КАК Грузоотправитель,
	|	ВТ_ЭТрН.Ссылка.Грузополучатель КАК Грузополучатель,
	|	ВТ_ЭТрН.Ссылка.Перевозчик КАК Перевозчик,
	|	ВТ_ЭТрН.Ссылка.МестоДоставки.АдресИнфАдрес КАК АдресДостГр,
	|	ВТ_ЭТрН.Ссылка.МестоДоставки.АдресИнфКодСтраны.Наименование КАК АдресДостГрСтрана,
	|	ВТ_ЭТрН.Ссылка.СрокДоставки КАК СрокДостГр,
	|	ВТ_ЭТрН.Ссылка.ДатаВремяДоставки КАК ДатВрДостГр,
	|	ВЫРАЗИТЬ(ВТ_ЭТрН.Ссылка.МаршрутТекст КАК СТРОКА(1000)) КАК МршПрвз,
	|	ВТ_ЭТрН.ТранспортноеСредство.ТипТС КАК ТипТС,
	|	ВТ_ЭТрН.ТранспортноеСредство.МаркаТС КАК МаркаТС,
	|	ВТ_ЭТрН.ТранспортноеСредство.ГрузоподъемностьТонн КАК ГрузоподъемностьТонн,
	|	ВТ_ЭТрН.ТранспортноеСредство.ВместимостьКубМ КАК ВместимостьКубМ,
	|	ВТ_ЭТрН.ТранспортноеСредство.РегНомер КАК РегНомер,
	|	ВТ_ЭТрН.ТранспортноеСредство.ВидВладения КАК ТипВлад,
	|	ВТ_ЭТрН.ТранспортноеСредство.ДоговорАрендаЛизинг КАК ДоговорАрендаЛизинг,
	|	ВТ_ЭТрН.Ссылка.ПогрузкуОсуществляет КАК СвЛицПогрГр,
	|	ВТ_ЭТрН.Ссылка.МестоПогрузки.Собственник КАК ВладИнфр,
	|	ВТ_ЭТрН.Ссылка.МестоПогрузки.АдресИнфАдрес КАК ФАдресПогр,
	|	ВТ_ЭТрН.Ссылка.МестоПогрузки.АдресИнфКодСтраны.Наименование КАК ФАдресПогрСтрана,
	|	ВТ_ЭТрН.Ссылка.ПогрузкаСотрудник КАК РабЛицПогрГр,
	|	ВТ_ЭТрН.Ссылка.ПогрузкаДоговор КАК ДогЛицПогрГр,
	|	ВТ_ЭТрН.Ссылка.ЭкспедицияЗаказчик КАК ЭкспедицияЗаказчик,
	|	ВТ_ЭТрН.Ссылка.ЭкспедицияДоговор КАК ЭкспедицияДоговор,
	|	ВТ_ЭТрН.Ссылка.Прицеп КАК Прицеп,
	|	ВТ_ЭТрН.Ссылка.Прицеп2 КАК Прицеп2,
	|	1 КАК НалКоорТочВрДост,
	|	""Электронное уведомление перевозчика о переадресовке"" КАК СпосПерУкПА,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(Титул1.УказанияВОтношенииНормПеревозки КАК СТРОКА(1000))) = """"
	|			ТОГДА ""Отсутствуют""
	|		ИНАЧЕ ВЫРАЗИТЬ(Титул1.УказанияВОтношенииНормПеревозки КАК СТРОКА(1000))
	|	КОНЕЦ КАК УкНормПрвз,
	|	ЕСТЬNULL(Титул1.ПерегрузкаЗапрещена, ЛОЖЬ) КАК ЗапрПерегруз,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Титул1.СведенияОПломбах КАК СТРОКА(1000)), """") КАК СвПломба,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Титул1.ОграничениеСкорости КАК СТРОКА(1000)), """") КАК ОгрСкор,
	|	ЕСТЬNULL(Титул1.ИнициаторПереадресации, """") КАК ЛицоПА,
	|	ЕСТЬNULL(Титул1.ТемператураНеНиже, """") КАК ТемпНеНиже,
