Функция ПолучитьСледующийПоЦепочкеТипТитулаСВ(ДокСВСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокСВСсылка) Тогда 
		ВызватьИсключение "Не заполнен СВ - не могу определить титул";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_СВ_ТитулПВ.ТипТитула КАК ТипТитула
	               |ПОМЕСТИТЬ ВТ_ВсеТитулыЗН
	               |ИЗ
	               |	Документ.КонтурЛогистика_СВ_ТитулПВ КАК КонтурЛогистика_СВ_ТитулПВ
	               |ГДЕ
	               |	НЕ КонтурЛогистика_СВ_ТитулПВ.ПометкаУдаления
	               |	И КонтурЛогистика_СВ_ТитулПВ.ТипТитула <> ЗНАЧЕНИЕ(перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка)
	               |	И КонтурЛогистика_СВ_ТитулПВ.ДокументСВ = &ДокументСВ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтурЛогистика_СВ_ТитулГО.ТипТитула
	               |ИЗ
	               |	Документ.КонтурЛогистика_СВ_ТитулГО КАК КонтурЛогистика_СВ_ТитулГО
	               |ГДЕ
	               |	НЕ КонтурЛогистика_СВ_ТитулГО.ПометкаУдаления
	               |	И КонтурЛогистика_СВ_ТитулГО.ТипТитула <> ЗНАЧЕНИЕ(перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка)
	               |	И КонтурЛогистика_СВ_ТитулГО.ДокументСВ = &ДокументСВ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтурЛогистика_СВ_ТитулГП.ТипТитула
	               |ИЗ
	               |	Документ.КонтурЛогистика_СВ_ТитулГП КАК КонтурЛогистика_СВ_ТитулГП
	               |ГДЕ
	               |	НЕ КонтурЛогистика_СВ_ТитулГП.ПометкаУдаления
	               |	И КонтурЛогистика_СВ_ТитулГП.ТипТитула <> ЗНАЧЕНИЕ(перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка)
	               |	И КонтурЛогистика_СВ_ТитулГП.ДокументСВ = &ДокументСВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВсеТитулыСВ.ТипТитула КАК ТипТитула
	               |ИЗ
	               |	ВТ_ВсеТитулыЗН КАК ВТ_ВсеТитулыСВ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ_ВсеТитулыСВ.ТипТитула.Порядок УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументСВ", ДокСВСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ТекТип = Выборка.ТипТитула;
		СледующийТип = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СледующийТипДокумента(ТекТип);
		
		Возврат СледующийТип;
		
	Иначе
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1;
		
	КонецЕсли;
	
КонецФункции

#КонецЕсли