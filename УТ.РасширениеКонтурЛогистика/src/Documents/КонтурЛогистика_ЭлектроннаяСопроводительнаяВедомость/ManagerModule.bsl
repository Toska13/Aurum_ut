// Допроверяет то что не проверено вызовом МассивОбязательныхРеквизитов
Процедура ПроверитьКлючевыеРеквизитыСВ(ДокСВСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	Если ДокСВСсылка.Перевозчик.ИНН = ДокСВСсылка.Грузоотправитель.ИНН Тогда
		
		ТекстОшибки = "Укажите другую организацию грузоотправителя или перевозчика - они совпадают (в Документе электронной транспортной накладной).";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.ДокументЭТРН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
		
	Если ДокСВСсылка.Перевозчик.ИНН = ДокСВСсылка.Грузополучатель.ИНН Тогда
		
		ТекстОшибки = "Укажите другую организацию грузополучателя или перевозчика - они совпадают (в Документе электронной транспортной накладной).";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.ДокументЭТРН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// ИНН
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Грузоотправитель.ИНН) Тогда 
	
		ТекстОшибки = "Укажите в Грузоотправителе ИНН (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Перевозчик.ИНН) Тогда 
	
		ТекстОшибки = "Укажите в Перевозчике ИНН (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Грузополучатель.ИНН) Тогда 
	
		ТекстОшибки = "Укажите в Грузополучателе ИНН (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
	
	// НаименованиеОрганизацииПолное
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Грузоотправитель.НаименованиеОрганизацииПолное) Тогда 
	
		ТекстОшибки = "Укажите в Грузоотправителе Полное наименование (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Перевозчик.НаименованиеОрганизацииПолное) Тогда 
	
		ТекстОшибки = "Укажите в Перевозчике Полное наименование (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Грузополучатель.НаименованиеОрганизацииПолное) Тогда 
	
		ТекстОшибки = "Укажите в Грузополучателе Полное наименование (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	// Телефоны
	
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокСВСсылка.Грузоотправитель) Тогда 
	
		ТекстОшибки = "Укажите Телефон Грузоотправителя";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокСВСсылка.Перевозчик) Тогда 
	
		ТекстОшибки = "Укажите Телефон Перевозчика";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокСВСсылка.Грузополучатель) Тогда 
	
		ТекстОшибки = "Укажите Телефон Грузополучателя";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	// ИдентификаторУчастникаЭДО
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Грузоотправитель.ИдентификаторУчастникаЭДО) Тогда 
	
		ТекстОшибки = "Укажите в Грузоотправителе Идентификатор участника ЭДО (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузоотправитель.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Перевозчик.ИдентификаторУчастникаЭДО) Тогда 
	
		ТекстОшибки = "Укажите в Перевозчике Идентификатор участника ЭДО (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Перевозчик.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ДокСВСсылка.Грузополучатель.ИдентификаторУчастникаЭДО) Тогда 
	
		ТекстОшибки = "Укажите в Грузополучателе Идентификатор участника ЭДО (в Документе электронной транспортной накладной)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Грузополучатель.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
	
КонецПроцедуры

