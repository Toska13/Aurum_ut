Функция МассивОбязательныхРеквизитов() Экспорт
	
	МассивОбязательных = Новый Массив();
	МассивОбязательных.Добавить("НомерСВ");
	МассивОбязательных.Добавить("ДатаСВ");
	МассивОбязательных.Добавить("Грузоотправитель");
	МассивОбязательных.Добавить("Перевозчик");
	МассивОбязательных.Добавить("Грузополучатель");
	
	Возврат МассивОбязательных;
	
КонецФункции

