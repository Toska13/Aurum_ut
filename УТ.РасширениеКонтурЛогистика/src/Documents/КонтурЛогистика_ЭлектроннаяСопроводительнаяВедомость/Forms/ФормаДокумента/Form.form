  <attributes>
    <name>СвязанныеДокументыТитулы</name>
    <title>
      <key>ru</key>
      <value>Связанные документы титулы</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
