    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	КонтурЛогистика_СВ_ТитулПВ.ТипТитула КАК ТипТитула,
	КонтурЛогистика_СВ_ТитулПВ.Ссылка КАК Ссылка,
	КонтурЛогистика_СВ_ТитулПВ.ДокументОснование КАК ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка КАК ФайлОбмена
ИЗ
	Документ.КонтурЛогистика_СВ_ТитулПВ КАК КонтурЛогистика_СВ_ТитулПВ
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_СВ_ТитулПВ.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_СВ_ТитулПВ.ПометкаУдаления
	И КонтурЛогистика_СВ_ТитулПВ.ДокументСВ = &amp;ДокументСВ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_СВ_ТитулГО.ТипТитула,
	КонтурЛогистика_СВ_ТитулГО.Ссылка,
	КонтурЛогистика_СВ_ТитулГО.ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка
ИЗ
	Документ.КонтурЛогистика_СВ_ТитулГО КАК КонтурЛогистика_СВ_ТитулГО
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_СВ_ТитулГО.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_СВ_ТитулГО.ПометкаУдаления
	И КонтурЛогистика_СВ_ТитулГО.ДокументСВ = &amp;ДокументСВ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_СВ_ТитулГП.ТипТитула,
	КонтурЛогистика_СВ_ТитулГП.Ссылка,
	КонтурЛогистика_СВ_ТитулГП.ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка
ИЗ
	Документ.КонтурЛогистика_СВ_ТитулГП КАК КонтурЛогистика_СВ_ТитулГП
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_СВ_ТитулГП.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_СВ_ТитулГП.ПометкаУдаления
	И КонтурЛогистика_СВ_ТитулГП.ДокументСВ = &amp;ДокументСВ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
