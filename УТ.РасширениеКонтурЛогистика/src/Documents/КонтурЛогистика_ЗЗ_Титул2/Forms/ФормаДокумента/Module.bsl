&НаСервере
Процедура УстановитьЗаголовкиСтраниц()
		
	УстановитьЗаголовокСтраницы(Элементы.СтраницаВодители, Объект.Водители.Количество(), "Водители");
	УстановитьЗаголовокСтраницы(Элементы.СтраницаПрицепы, Объект.Прицепы.Количество(), "Прицепы");
	УстановитьЗаголовокСтраницы(Элементы.СтраницаСпецУсловияДвижения, Объект.СпецУсловияДвижения.Количество(), "Спец. условия движения");
	УстановитьЗаголовокСтраницы(Элементы.СтраницаПунктыМаршрутаТ1, Объект.Титул1.АдрПункт.Количество(), "Маршрут");
	
	// грузы с учетом не учитываемых
	КоличествоСтрок = 0;
	Для Каждого ТекущаяСтрока Из Объект.Титул1.Товары Цикл
		Если Не ТекущаяСтрока.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		КоличествоСтрок = КоличествоСтрок + 1;
	КонецЦикла;
	Элементы.СтраницаГрузыТ1.Заголовок = "Грузы (" + КоличествоСтрок + ")";
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатыПогрузки()
	
	Если Не ЗначениеЗаполнено(Объект.Титул1) Тогда
		Возврат;
	КонецЕсли;
	
	МестоПогрузки = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(Объект.Титул1, "ПунктПод");
	Если ЗначениеЗаполнено(МестоПогрузки) Тогда
		ЧасовойПоясПогрузки = МестоПогрузки.ЧасовойПояс;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		Т1ДатаВремяПодачи = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.Титул1.ДатВрПод, Неопределено, ЧасовойПоясПогрузки);
	Иначе
		Т1ДатаВремяПодачи = Объект.Титул1.ДатВрПод;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		Элементы.ЧасовойПоясЗаголовок.Заголовок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(ЧасовойПоясПогрузки);
	Иначе
		Элементы.ЧасовойПоясЗаголовок.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокСтраницы(Страница, КоличествоСтрок, БазовыйЗаголовок)
	
	Если КоличествоСтрок = 0 Тогда 
		Страница.Заголовок = БазовыйЗаголовок;
	Иначе
		Страница.Заголовок = БазовыйЗаголовок + " (" + КоличествоСтрок + ")";
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере                                                                                                                         
Процедура СформироватьНадписиПараметровТСИДопУсловий()
	
	Титул1 = Объект.Титул1;
	
	Если ЗначениеЗаполнено(Титул1) Тогда 
		
		Реквизиты = "ТСГрузопод,ТСВместим,ТСТип,ТСТипКуз,ТСТипПогр,ТСДрПарам,ТемператураНеВыше,ТемператураНеНиже,
					|ВлажностьНеВыше,ВлажностьНеНиже,УказанияВОтношенииНормПеревозки,ПредСрПрвз,ПрвзПищПрод,ИныеУслв,КонПунктМрш";
	
		СтруктураПоказателей = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(Объект.Титул1, Реквизиты);
		
		Модуль = КонтурЛогистика_ПечатьСервер;
		
		Элементы.Титул1ТСТипПогр.Видимость 	= ЗначениеЗаполнено(Титул1.ТСТипПогр);
		Элементы.Титул1ТСТипКуз.Видимость 	= ЗначениеЗаполнено(Титул1.ТСТипКуз);
		Элементы.Титул1ТСДрПарам.Видимость 	= ЗначениеЗаполнено(Титул1.ТСДрПарам);
		
		ОписаниеДопПолейГО = "Доп. поля Грузоотправителя (не указаны)";
		Если ЗначениеЗаполнено(Титул1.ТемператураНеВыше)
			Или ЗначениеЗаполнено(Титул1.ТемператураНеНиже) Тогда 
			
			ОписаниеДопПолейГО = "Доп. поля Грузоотправителя (указаны)";	
		Иначе
			Элементы.ГруппаТемпература.Видимость = Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Титул1.ВлажностьНеВыше)
			Или ЗначениеЗаполнено(Титул1.ВлажностьНеНиже) Тогда
			ОписаниеДопПолейГО = "Доп. поля Грузоотправителя (указаны)";	
		Иначе
			Элементы.ГруппаВлажность.Видимость = Ложь;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Титул1.УказанияВОтношенииНормПеревозки)
			Или (ЗначениеЗаполнено(Титул1.ПредСрПрвз) И Титул1.ПредСрПрвз <> "Отсутствуют")
			Или (ЗначениеЗаполнено(Титул1.ПрвзПищПрод) И Титул1.ПрвзПищПрод <> "Отсутствуют")
			Или ЗначениеЗаполнено(Титул1.ИныеУслв)
			Или ЗначениеЗаполнено(Титул1.КонПунктМрш) Тогда 
			
			ОписаниеДопПолейГО = "Доп. поля Грузоотправителя (указаны)";	
			
		Иначе
			
			
		КонецЕсли;
		
		Элементы.СтраницаДопПоляТ1.Заголовок = ОписаниеДопПолейГО;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполитьПолеВводаВодителя(Форма)
	
	Если ЗначениеЗаполнено(Форма.Объект.Водители) Тогда 
		Форма.Водитель = Форма.Объект.Водители[0].СвВодит;
		Если Форма.Объект.Водители.Количество() > 1 Тогда 
			Форма.Водитель2 = Форма.Объект.Водители[1].СвВодит;
		Иначе
			Форма.Водитель2 = "";
		КонецЕсли;
	Иначе
		Форма.Водитель = "";
		Форма.Водитель2 = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполитьПолеВводаПрицепа(Форма)
	
	Если ЗначениеЗаполнено(Форма.Объект.Прицепы) Тогда 
		Форма.Прицеп = Форма.Объект.Прицепы[0].Прицеп;
	Иначе
		Форма.Прицеп = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительПриИзменении(Элемент)
	
	Объект.Водители.Очистить();
	
	Если ЗначениеЗаполнено(Водитель) Тогда 
		НоваяСтрока = Объект.Водители.Добавить();
		НоваяСтрока.СвВодит = Водитель;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Водитель2) Тогда 
		НоваяСтрока = Объект.Водители.Добавить();
		НоваяСтрока.СвВодит = Водитель2;
	КонецЕсли;	
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрицепПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Прицеп) Тогда 
		Если Не ЗначениеЗаполнено(Объект.Прицепы) Тогда
			НоваяСтрока = Объект.Прицепы.Добавить();
			НоваяСтрока.Прицеп = Прицеп;
		Иначе	
			Объект.Прицепы[0].Прицеп = Прицеп;
		КонецЕсли;	
	Иначе
		Объект.Прицепы.Удалить(0);
		ЗаполитьПолеВводаПрицепа(ЭтаФорма);
	КонецЕсли;	
	
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюЗаказЗаявку(Команда)
	
	ЭтаФорма.Закрыть();	
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ЗЗ_Титул1.Форма.ФормаДокумента",
		Новый Структура("Ключ", СсылкаНаНовуюЗаявку(Объект.Титул1)),
		ЭтаФорма);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкаНаНовуюЗаявку(ЗЗ_Титул1Ссылка)
	
	НовыйОбъект = ЗЗ_Титул1Ссылка.Скопировать();
	НовыйОбъект.Записать();
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(НовыйОбъект.Ссылка, Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик, Истина);
	
	// завершаем старую
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ЗЗ_Титул1Ссылка, "zz-createNewZZ",, Истина);
	
	Возврат НовыйОбъект.Ссылка;
	
КонецФункции

