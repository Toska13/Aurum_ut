&НаСервере
Процедура ЗаполнитьПрицепПоУмолчанию()
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		Объект.Прицепы.Очистить();
		
		ПрицепПоУмолчанию = Объект.ТранспортноеСредство.ПрицепПоУмолчанию;
		ПрицепПоУмолчанию2 = Объект.ТранспортноеСредство.Прицеп2ПоУмолчанию;
		
		Если ЗначениеЗаполнено(ПрицепПоУмолчанию) Тогда 
			НовПрицеп = Объект.Прицепы.Добавить();
			
			НовПрицеп.Прицеп = ПрицепПоУмолчанию;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПрицепПоУмолчанию2) Тогда 
			НовПрицеп = Объект.Прицепы.Добавить();
			
			НовПрицеп.Прицеп = ПрицепПоУмолчанию2;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

