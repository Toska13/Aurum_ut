
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПроверкаОтвета", РежимПроверкиОтвета);
			
	ОбновитьДанныеФормы();
		
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	УстановитьЗаголовкиСтраниц();
	
	// нет в реквизитах объекта СуммаНДС - восстановим её
	СуммаНДС = Объект.СтТовУчНал - Объект.СтТовБезНДС;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаРеквизиты.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.СтавкаНДС.РастягиватьПоГоризонтали = Ложь;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Баги старой платформы при отрисовке сложных группировок
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
		Элементы.ГруппаРеквизиты.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.СуммаДляРасчетов.МаксимальнаяШирина = 0;
		Элементы.СтавкаНДС.МаксимальнаяШирина = 0;
		Элементы.СуммаНДС.МаксимальнаяШирина = 0;
		Элементы.СтоимостьБезНДС.МаксимальнаяШирина = 0;
		Элементы.СтоимостьСНДС.МаксимальнаяШирина = 0;
	КонецЕсли;
	
	УправлениеВидимостьюИДоступностью();
	ПроверитьДокумент();
	УправлениеВидимостьюСумм(ЭтаФорма);
	
	ЗаполнитьСуммуДляРасчета();
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.Титул1, Истина);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		 Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда
		ПерешелВЛогистическиеСтатус = Истина;
	Иначе
		ПерешелВЛогистическиеСтатус = Ложь;
	КонецЕсли;
		
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Повторно выполнить задачу";
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Выполнить задачу";
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(Объект.Ссылка, 
																				   Объект.ДокументОснование,
																				   Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, 
																				   ТекущийСтатус);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка 
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
		ТолькоПросмотр = Ложь;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	Если ЗначениеЗаполнено(Объект.Титул1.Грузоотправитель) Тогда
		ГОНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.Титул1.Грузоотправитель, "Наш");
	Иначе
		ГОНаш = Ложь;
	КонецЕсли;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВвестиЭТРНизЗЗ.Видимость = ГОНаш;
	
	Если ТекущийСтатусДокументооборота.ТребуемоеДействиеТ1 = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника
		И ГОНаш Тогда
		
		РежимПроверкиОтвета = Истина;
		
	КонецЕсли;
	
	ТолькоПросмотр = Макс(РежимПроверкиОтвета, ТолькоПросмотр);
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПроверкаОтветаПройдена.Видимость 		 	= НЕ ДоступнаОсновнаяКнопкаПоУмолчанию И РежимПроверкиОтвета;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПроверкаОтветаПройдена.КнопкаПоУмолчанию 	= НЕ ДоступнаОсновнаяКнопкаПоУмолчанию И РежимПроверкиОтвета;
	Элементы.ПодменюОтказаться.Видимость 											 	= НЕ ДоступнаОсновнаяКнопкаПоУмолчанию И РежимПроверкиОтвета;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи.Видимость 			 	= ДоступнаОсновнаяКнопкаПоУмолчанию ИЛИ НЕ РежимПроверкиОтвета;
	
	Элементы.ГруппаОсновныеРеквизиты.ТолькоПросмотр = ТолькоПросмотр;
	Элементы.ГруппаСуммы.ТолькоПросмотр				= ТолькоПросмотр;
	Элементы.ДобваитьВторогоВодителя.Доступность	= Не ТолькоПросмотр;
	
	Если Элементы.Найти("ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи") <> Неопределено Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи.Видимость = Не ТолькоПросмотр;
	КонецЕсли;
		
	ЭтоВходящий = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен;
		
	Элементы.ПользовательПодписант.Видимость = НЕ ЭтоВходящий;
			
	РеквизитыТ1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(Объект.Титул1, "Составитель,НаимЭкСубСост,ДогОргПрвз");	
		
	СоставительТ1 	= РеквизитыТ1.Составитель;
	НаимЭкСубСостТ1 = РеквизитыТ1.НаимЭкСубСост;
	ДогОргПрвзТ1 	= РеквизитыТ1.ДогОргПрвз;
	
	Т1Товары = Объект.Титул1.Товары;
	Т1Мест 			= Т1Товары.Итог("КоличествоМест");
	Т1МассаБрутто 	= Т1Товары.Итог("МассаПлановаяБруттоКг");
	Т1Объем 		= Т1Товары.Итог("ОбъемКубМ");
	
	ЗаполнитьПоказателиРасчетаСумм(ЭтаФорма);
	СформироватьНадписиПараметровТСИДопУсловий();
	ЗаполитьПолеВводаВодителя(ЭтаФорма);
	ЗаполитьПолеВводаПрицепа(ЭтаФорма);
	
	ЗаполнитьДатыПогрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И Параметр = Объект.Ссылка Тогда 
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
				
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	ИначеЕсли ИмяСобытия = "ПерезаполнитьТитул"
		И Параметр <> Неопределено
		И Параметр = Объект.Ссылка Тогда
		
		ПерезаполнитьПоДокОснованиюСервер();
		ОбновитьДанныеФормы();
		ОбновитьОтображениеДанных();
		ПроверитьДокумент();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
			  И Параметр <> Неопределено
			  И ТипЗнч(Параметр) = Тип("Массив")
			  И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда

		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()

	ЭтаФорма.Прочитать();
	ОбновитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()

	ОбновитьДанныеФормы();
	ПроверитьДокумент();
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(ЭтаФорма, Объект.ДокументОснование);
	УправлениеКолбасойТитуловВызовСервера();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеКолбасойТитуловВызовСервера()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УправлениеСтатусомПодписиИКолбасойТитулов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()

	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()
	
	ЭтоВходящий = ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен");
	ЭтоЧерновик = ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик");
			
	// причина отказа в подписи 
	
	Элементы.ГруппаПричинаОтказаВПодписи.Видимость = (ЭтоВходящий Или Не ЭтоЧерновик) И Объект.ЕстьОтказВПодписи;	
	
	Элементы.ЗЗ_Титул1Сотставитель.Видимость 	= Не ЭтоВходящий И ЗначениеЗаполнено(СоставительТ1);
	Элементы.ЗЗ_Титул1НаимЭкСубСост.Видимость 	= ЭтоВходящий И ЗначениеЗаполнено(НаимЭкСубСостТ1);
	Элементы.Составитель.Видимость 				= Не ЭтоВходящий;
	Элементы.НаимЭкСубСост.Видимость 			= ЭтоВходящий;
	
	Элементы.ГруппаСтороныЗЗСоставитель.Видимость 	= ЗначениеЗаполнено(СоставительТ1) Или ЗначениеЗаполнено(НаимЭкСубСостТ1);	
	Элементы.ГруппаСтороныЗЗДоговорСПВ.Видимость 	= ЗначениеЗаполнено(ДогОргПрвзТ1);
	
	СтавкаРавнаБезНДС = Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.БезНДС")
							Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС0"); 
						
	Элементы.СуммаНДС.Видимость 		= Не СтавкаРавнаБезНДС;
	Элементы.СтоимостьСНДС.Видимость 	= Не СтавкаРавнаБезНДС;
	
	Элементы.ГруппаЛицоПеревозкиДоверенность.Видимость = ЗначениеЗаполнено(Объект.СвЛицПрв);
	
	Элементы.СвЛицОргПрвз.Видимость 				= Не Объект.ЕстьОтказВПодписи;
	Элементы.ТранспортноеСредство.Видимость 		= Не Объект.ЕстьОтказВПодписи;
	Элементы.ГруппаРазмерПлаты.Видимость 			= Не Объект.ЕстьОтказВПодписи;
	Элементы.ГруппаДоп.Видимость 					= Не Объект.ЕстьОтказВПодписи;
	Элементы.СтраницаВодители.Видимость 			= Не Объект.ЕстьОтказВПодписи;
	Элементы.СтраницаПрицепы.Видимость 				= Не Объект.ЕстьОтказВПодписи;
	Элементы.СтраницаСпецУсловияДвижения.Видимость 	= Не Объект.ЕстьОтказВПодписи;
	Элементы.ГруппаОсновныеРеквизиты.Видимость 		= Не Объект.ЕстьОтказВПодписи;
	
	УказанВторойВодитель = Объект.Водители.Количество() > 1;
	Элементы.ГруппаВодитель2.Видимость = УказанВторойВодитель;
	Элементы.ДобваитьВторогоВодителя.Видимость = Не УказанВторойВодитель;
	
КонецПроцедуры

&НаКлиенте
Процедура Перепроверить(Команда = Неопределено)
	
	РезультатПроверки = ПроверитьДокумент();
	
	// если есть ошибки или предупреждения то нажатие всегда показывает панель ошибок (в свернутом или развернутом виде)
	
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПерепроверить(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Перепроверить();
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДокумент()
	
	РезультатПроверки = ПроверитьДокументСервер();
	
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки);
	
	УправлениеВидимостьюИДоступностью();
	
	Возврат РезультатПроверки;
		
КонецФункции

&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2, Объект.ДокументОснование);
	
	ДокОбъект.ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации);
	
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДокументСервер()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатыПроверкиДокумента = Документы.КонтурЛогистика_ЗЗ_Титул2.ПроверитьДокумент(ДокОбъект, ТаблицаОшибок);
	
	РезультатПроверки = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	УстановитьЗаголовкиСтраниц();
	
	Возврат РезультатПроверки;
	
КонецФункции

// Обслуживание панели ошибок
&НаКлиенте
Процедура ПанельОшибокМинимизировать(Команда)
	КонтурЛогистика_ПанельОшибокКлиент.МинимизироватьПанельОшибок(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПанельОшибокМаксимизировать(Команда)
	КонтурЛогистика_ПанельОшибокКлиент.ПоказатьПанельОшибок(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОшибокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, Поле.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ПользовательПодписантПриИзменении(Элемент)
	ПроверитьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ТумблерПодписатьИОтправитьПриИзменении(Элемент)
	
	Если Не Объект.ЕстьОтказВПодписи Тогда 
		Объект.ПричинаОтказаВПодписи = "";
	КонецЕсли;	
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммы(Форма)
	
	Объект = Форма.Объект;
	
	Если Форма.НеРассчитыватьСуммы Тогда 			
		
		Объект.СтТовБезНДС 	= Форма.СуммаДляРасчетов;
		Форма.СуммаНДС 		= 0;
		Объект.СтТовУчНал 	= 0;
		
	Иначе
		
		Если Форма.НДСВСумме Тогда 
			
			Если Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС10_110") Тогда 
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 10 / 110;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС20_120") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 20 / 120;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС22_122") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 22 / 122;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС5_105") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 5 / 105;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС7_107") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 7 / 107;
			КонецЕсли;	
			
			Объект.СтТовУчНал 	= Форма.СуммаДляРасчетов;
			Объект.СтТовБезНДС 	= Объект.СтТовУчНал - Форма.СуммаНДС;
			
		Иначе
			
			Если Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС10") Тогда 
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 10 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС20") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 20 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС22") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 22 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС5") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 5 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС7") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 7 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС9_09") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 9.09 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС16_67") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 16.67 / 100;
			ИначеЕсли Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС18_03") Тогда	
				Форма.СуммаНДС = Форма.СуммаДляРасчетов * 18.03 / 100;
			КонецЕсли;
			
			Объект.СтТовБезНДС 	= Форма.СуммаДляРасчетов;
			Объект.СтТовУчНал 	= Объект.СтТовБезНДС + Форма.СуммаНДС;
			
		КонецЕсли;	
		
	КонецЕсли;	
		
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюСумм(Форма)

	Элементы = Форма.Элементы;
	
	Если Форма.НеРассчитыватьСуммы Тогда
		
		Элементы.СуммаДляРасчетов.Заголовок = "Сумма без НДС";
		Элементы.СуммаНДС.Заголовок 		= "Сумма НДС";
		
		Элементы.СуммаНДС.Видимость 		= Ложь;
		Элементы.СтоимостьБезНДС.Видимость 	= Ложь;
		Элементы.СтоимостьСНДС.Видимость 	= Ложь;
		
	Иначе
		
		Если Не Форма.НДСВСумме Тогда
			
			Элементы.СуммаДляРасчетов.Заголовок = "Сумма без НДС";
			Элементы.СуммаНДС.Заголовок 		= "Сумма НДС";
			
			Элементы.СтоимостьБезНДС.Видимость 	= Ложь;			
			Элементы.СтоимостьСНДС.Видимость 	= Истина;
			
		Иначе
			
			Элементы.СуммаДляРасчетов.Заголовок = "Сумма с НДС";
			Элементы.СуммаНДС.Заголовок 		= "Сумма НДС (в т.ч.)";
			
			Элементы.СтоимостьБезНДС.Видимость 	= Истина;			
			Элементы.СтоимостьСНДС.Видимость 	= Ложь;
			
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПоказателиРасчетаСумм(Форма)

	Объект = Форма.Объект;
	
	Форма.НеРассчитыватьСуммы = Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.БезНДС")
							Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС0")
							Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДСИсчисляетсяНалоговымАгентом");
						
	Форма.НДСВСумме = Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС10_110")
					Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС20_120")
					Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС22_122")
					Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС5_105")
					Или Объект.НалСт = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС7_107");


КонецПроцедуры

