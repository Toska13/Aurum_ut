// Функция - Проверить документ
//
// Параметры:
//  ДокументОбъектИлиСсылка - ДокументСсылка, ДокументОбъект - проверяемый документ может передаваться как ссылкой так и объектом
//  ТаблицаОшибок	 		- ТаблицаЗначений - можно передать таблицу с уже найденными ошибками
//  ПараметрыФормированияФайлов - Структура - Значения реквизитов заполнения файла обмена
// 
// Возвращаемое значение:
//  Структура -  см. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, ПараметрыФормированияФайлов = Неопределено) Экспорт
	
	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка, Истина);
	
	ТаблицаОшибок.Очистить();
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		КонтурЛогистика_ПанельОшибокСервер.ВывестиОшибкуТекущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок)
	КонецЕсли;
	
	КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиПредыдущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ДокументОбъектИлиСсылка.Титул1, ТаблицаОшибок);
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		
		// TODO понять какие сценарии проверки входящего документа
		
	ИначеЕсли Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
		И Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда  
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2, ТаблицаОшибок);
		
		ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		// TODO - доделать валидатор
		//
		//ПроверитьОтметки(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		//ПроверитьИнфПол(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
		
	ИначеЕсли ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена Тогда 
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиДругихСторон(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьРоуминг(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
		
	Если НЕ ЗначениеЗаполнено(Объект.Титул1)  Тогда
		
		ТекстОшибки = "Титул не привязан к Титулу 1 Заказа (заявки)";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ЗЗ_Титул1", КатегорияОшибка, ТекстОшибки, "Указать");
		
	Иначе
		
		Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
			
			Если Прав(ОбязательныйРевизит, 6) = "Массив" ИЛИ Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
				
				ОбязательныйРевизитСиноним = СинонимРеквизита(ОбязательныйРевизит);
				ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					ОбязательныйРевизит, КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
				
		КонецЦикла;
		
		// ОрганизацияСоставитель 
		Если ЗначениеЗаполнено(Объект.Составитель) И Объект.Составитель <> Объект.Титул1.Перевозчик Тогда 
			
			Если НЕ Объект.Составитель = Объект.Титул1.Перевозчик Тогда
				
				Если Не ЗначениеЗаполнено(Объект.ОснДовОргСост) Тогда
				
					ТекстОшибки = "Укажите договор-основание полномочий составителя файла обмена";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"Объект.ОснДовОргСост", КатегорияОшибка, ТекстОшибки, "Указать");
					
				Иначе 
					
					Если Не ЗначениеЗаполнено(Объект.ОснДовОргСост.Организация) Тогда
						
						ТекстОшибки = "Укажите организацию, к которой относится договор составителя заказа (заявки)";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
							"Объект.ОснДовОргСост.Организация", КатегорияОшибка, ТекстОшибки, "Указать");
						
					КонецЕсли;	
					
					Если Не ЗначениеЗаполнено(Объект.ОснДовОргСост.Контрагент) Тогда
						
						ТекстОшибки = "Укажите контрагента, с которым у организации заключен договор составителя заказа (заявки)";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
							"Объект.ОснДовОргСост.Контрагент", КатегорияОшибка, ТекстОшибки, "Указать");
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Объект.ЕстьОтказВПодписи Тогда
			
			Если Не ЗначениеЗаполнено(Объект.ПричинаОтказаВПодписи) Тогда 
				
				ТекстОшибки = "Не указана причина отказа в приеме";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ПричинаОтказаВПриеме", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
		Иначе
			
			// СвЛицОргПрвз
			Если Не ЗначениеЗаполнено(Объект.СвЛицОргПрвз) Тогда
					
				ТекстОшибки = "Укажите лицо, ответственное за организацию перевозки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"СвЛицОргПрвз", КатегорияОшибка, ТекстОшибки, "Указать");
				
			Иначе
				
				Если Не ЗначениеЗаполнено(Объект.СвЛицОргПрвз.ТелефонОсновной) Тогда
					ТекстОшибки = "Укажите телефон лица, ответственного за организацию перевозки";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"СвЛицОргПрвз.ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;
				
			КонецЕсли;
			
			// СвВодит
			ПроверитьВодителей(Объект, ТаблицаОшибок);
			
			// СвЛицПрв			
			Если ЗначениеЗаполнено(Объект.СвЛицПрв) Тогда 
				ПроверитьРеквизитыДоверенности(Объект, ТаблицаОшибок);					
			КонецЕсли;	
			
			// СвТС
			ПроверитьТранспортноеСредство(Объект, ТаблицаОшибок);
			ПроверитьПрицеп(Объект, ТаблицаОшибок);
			ПроверитьСпецУсловия(Объект, ТаблицаОшибок);
			
			// РазмПлатРасчет
			Если Не ЗначениеЗаполнено(Объект.Расчет) И Не ЗначениеЗаполнено(Объект.СтТовБезНДС) И Не ЗначениеЗаполнено(Объект.НалСт) Тогда
				
				ТекстОшибки = "Укажите Порядок расчета ИЛИ Стоимость перевозки без НДС и Налоговую ставку";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Расчет", КатегорияОшибка, ТекстОшибки, "Указать");
					
			ИначеЕсли ЗначениеЗаполнено(Объект.СтТовБезНДС) И Не ЗначениеЗаполнено(Объект.НалСт) Тогда 		
				
				ТекстОшибки = "Укажите Налоговую ставку";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"НалСт", КатегорияОшибка, ТекстОшибки, "Указать");
				
			ИначеЕсли ЗначениеЗаполнено(Объект.НалСт) И Не ЗначениеЗаполнено(Объект.СтТовБезНДС) Тогда 		
				
				ТекстОшибки = "Укажите Стоимость перевозки без НДС";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"СтТовБезНДС", КатегорияОшибка, ТекстОшибки, "Указать");	
				
			КонецЕсли;
			
			// Провдение документа основания
			КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьПроведениеДокументаОснования(Объект, ТаблицаОшибок, КатегорияОшибка);
			
		КонецЕсли;
		
	КонецЕсли;
		
	// TODO
	// ГЛУБОКИЕ ВАЛИДАЦИИ, ВЗАИМНЫЕ ВАЛИДАЦИИ
	
КонецПроцедуры

Процедура ПроверитьВодителей(Знач Объект, ТаблицаОшибок)

	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	ИмяТЧ = "Водители";
	
	Если Объект.Водители.Количество() = 0 Тогда 
			
		ТекстОшибки = "Укажите водителя";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Водитель", КатегорияОшибка, ТекстОшибки, "Указать");
			
	Иначе

		Для Каждого СтрокаВодитель Из Объект.Водители Цикл 
			
			НомерСтроки 	= СтрокаВодитель.НомерСтроки;
			Водитель 		= СтрокаВодитель.СвВодит;
			
			Если ЗначениеЗаполнено(Водитель) Тогда
					
				Если Не ЗначениеЗаполнено(Водитель.ТелефонОсновной) Тогда
					ТекстОшибки = "Укажите телефон водителя";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"СвВодит.ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;
								
				Если Не ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) Тогда			
					ТекстОшибки = "Укажите у водителя дату выдачи ВУ";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"СвВодит.ВУДатаВыдачи", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Водитель.ВУНомер) Тогда
					ТекстОшибки = "Укажите у водителя номер ВУ";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"СвВодит.ВУНомер", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда				
					ТекстОшибки = "Укажите у водителя серию ВУ";				
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"СвВодит.ВУСерия", КатегорияОшибка, ТекстОшибки, "Указать");				
				КонецЕсли;	
									
				Если Не ЗначениеЗаполнено(Водитель.ИНН) Тогда 
					ТекстОшибки = "Укажите у водителя серию ВУ";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"СвВодит.ИНН", КатегорияОшибка, "Укажите ИНН водителя", "Указать");
				Иначе	
					ТекстОшибки = Справочники.КонтурЛогистика_Сотрудники.ТекстОшибкиПроверкиИНН(Водитель.ИНН);
					Если ЗначениеЗаполнено(ТекстОшибки) Тогда 
					    КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
							"СвВодит.ИНН", КатегорияОшибка, "Укажите верный ИНН водителя. " + ТекстОшибки, "Указать");
					КонецЕсли;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Объект.Титул1.Перевозчик)
					И КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступенСервисФизЛиц(Объект.Титул1.Перевозчик) Тогда				
					КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьВодителяВСервисе(Объект.Титул1.Перевозчик, Водитель, "СвВодит", ТаблицаОшибок, ИмяТЧ, НомерСтроки);				
				КонецЕсли;
				
			Иначе	
				
				ТекстОшибки = "Укажите водителя";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					"СвВодит", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
							
		КонецЦикла;	
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРеквизитыДоверенности(Знач Объект, ТаблицаОшибок)

	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Если Не ЗначениеЗаполнено(Объект.РеквДоверИдДок) 
		И Не ЗначениеЗаполнено(Объект.РеквДоверНаименование) 
		И Не ЗначениеЗаполнено(Объект.РеквДоверНомер)
		И Не ЗначениеЗаполнено(Объект.РеквДоверДата) 
		И Не ЗначениеЗаполнено(Объект.РеквДоверСоставитель) 
		И Не ЗначениеЗаполнено(Объект.РеквДоверСоставитель2) 
		И Не ЗначениеЗаполнено(Объект.РеквДоверДопСведДок) Тогда 
		
		ТекстОшибки = "Укажите Идентификатор ИЛИ Наименование, Номер, Дату и Составителей доверенности.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"РеквДоверНаименование", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Объект.РеквДоверИдДок) 
		И (ЗначениеЗаполнено(Объект.РеквДоверНаименование)
		Или ЗначениеЗаполнено(Объект.РеквДоверНомер) 
		Или ЗначениеЗаполнено(Объект.РеквДоверДата)
		Или ЗначениеЗаполнено(Объект.РеквДоверСоставитель)
		Или ЗначениеЗаполнено(Объект.РеквДоверСоставитель2) 
		Или ЗначениеЗаполнено(Объект.РеквДоверДопСведДок)) Тогда	
			
		Если Не ЗначениеЗаполнено(Объект.РеквДоверНаименование) Тогда 
			
			ТекстОшибки = "Укажите наименование доверенности.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"РеквДоверНаименование", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.РеквДоверДата) Тогда 
			
			ТекстОшибки = "Укажите дату доверенности.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"РеквДоверДата", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.РеквДоверСоставитель) И Не ЗначениеЗаполнено(Объект.РеквДоверСоставитель2) Тогда 
			
			ТекстОшибки = "Укажите составителей доверенности.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"РеквДоверСоставитель", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
			
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПроверитьТранспортноеСредство(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка 		= ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка");
	КатегорияПредупреждение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение");
	
	ТранспортноеСредство = Объект.ТранспортноеСредство;
	
	Если ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.РегНомер) Тогда
			
			ТекстОшибки = "Укажите рег. номер транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ТранспортноеСредство.РегНомер", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ВидВладения) Тогда
			
			ТекстОшибки = "Укажите вид владения транспортным средством";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ТранспортноеСредство.ВидВладения", КатегорияОшибка, ТекстОшибки, "Указать");
			
		Иначе
			
			// TODO валидация основания владения 
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ГрузоподъемностьТонн) Тогда
			
			Если Не ЗначениеЗаполнено(Объект.Прицепы) Тогда
				ТекстОшибки = "Укажите прицеп или грузоподъемность транспортного средства";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Прицеп", КатегорияОшибка, ТекстОшибки, "Указать");
			Иначе
				ТекстОшибки = "Не указана грузоподъемность транспортного средства (тягач?)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ТранспортноеСредство.ГрузоподъемностьТонн", КатегорияПредупреждение, ТекстОшибки, "Проверить");
			КонецЕсли;
		
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ВместимостьКубМ) Тогда
			
			Если Не ЗначениеЗаполнено(Объект.Прицепы) Тогда
				ТекстОшибки = "Укажите прицеп или вместимость транспортного средства";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Прицеп", КатегорияОшибка, ТекстОшибки, "Указать");
			Иначе
				ТекстОшибки = "Не указана вместимость транспортного средства (тягач?)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ТранспортноеСредство.ВместимостьКубМ", КатегорияПредупреждение, ТекстОшибки, "Проверить");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ТипТС) Тогда
			
			ТекстОшибки = "Укажите тип транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ТранспортноеСредство.ТипТС", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.МаркаТС) Тогда
			
			ТекстОшибки = "Укажите марку транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ТранспортноеСредство.МаркаТС", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	Иначе
		
		ТекстОшибки = "Укажите Транспортное средство";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТранспортноеСредство", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;	

КонецПроцедуры

Процедура ПроверитьПрицеп(Знач Объект, ТаблицаОшибок)

	Если ЗначениеЗаполнено(Объект.Прицепы) Тогда 
			
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
		ИмяТЧ = "Прицепы";

		Для Каждого СтрокаПрицеп Из Объект.Прицепы Цикл
			
			НомерСтроки = СтрокаПрицеп.НомерСтроки;
			Прицеп 		= СтрокаПрицеп.Прицеп;
			
			Если ЗначениеЗаполнено(Прицеп) Тогда
				
				Если Не ЗначениеЗаполнено(Прицеп.ВидВладения) Тогда
					
					ТекстОшибки = "Укажите вид владения прицепом";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"Прицеп.ВидВладения", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Прицеп.ГрузоподъемностьТонн) Тогда
					
					ТекстОшибки = "Укажите грузоподъемность прицепа";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"Прицеп.ГрузоподъемностьТонн", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Прицеп.ТипТС) Тогда
					
					ТекстОшибки = "Укажите тип прицепа";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"Прицеп.ТипТС", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Прицеп.МаркаТС) Тогда
					
					ТекстОшибки = "Укажите марку прицепа";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"Прицеп.МаркаТС", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Прицеп.ВместимостьКубМ) Тогда
					
					ТекстОшибки = "Укажите вместимость прицепа";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						"Прицеп.ВместимостьКубМ", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
			Иначе
				
				ТекстОшибки = "Укажите прицеп";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					"Прицеп", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	

КонецПроцедуры

Процедура ПроверитьСпецУсловия(Знач Объект, ТаблицаОшибок) 
	
	Если ЗначениеЗаполнено(Объект.СпецУсловияДвижения) Тогда 
		
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
		ИмяТЧ = "СпецУсловияДвижения";
		
		Для Каждого СтрокаУслДвижения Из Объект.СпецУсловияДвижения Цикл
			
			НомерСтроки = СтрокаУслДвижения.НомерСтроки;
			
			Если Не ЗначениеЗаполнено(СтрокаУслДвижения.ИдСР) 
				И Не ЗначениеЗаполнено(СтрокаУслДвижения.НомСР) 
				И Не ЗначениеЗаполнено(СтрокаУслДвижения.ДатаСР) 
				И Не ЗначениеЗаполнено(СтрокаУслДвижения.СрокСР)
				И Не ЗначениеЗаполнено(СтрокаУслДвижения.ВидСР)
				И Не ЗначениеЗаполнено(СтрокаУслДвижения.НаимОИВ) Тогда 
				
				ТекстОшибки = "Укажите Идентификатор ИЛИ Номер, Дату, Срок, Вид спец. разрешения";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"НомСР", КатегорияОшибка, ТекстОшибки, "Указать");
								
			КонецЕсли;	
			
			Если Не ЗначениеЗаполнено(СтрокаУслДвижения.ИдСР) 
				И (ЗначениеЗаполнено(СтрокаУслДвижения.НомСР) 
				Или ЗначениеЗаполнено(СтрокаУслДвижения.ДатаСР)
				Или ЗначениеЗаполнено(СтрокаУслДвижения.СрокСР)
				Или ЗначениеЗаполнено(СтрокаУслДвижения.ВидСР)
				Или ЗначениеЗаполнено(СтрокаУслДвижения.НаимОИВ)) Тогда	
					
				Если Не ЗначениеЗаполнено(СтрокаУслДвижения.НомСР) Тогда 
					
					ТекстОшибки = "Укажите Номер специального разрешения.";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"НомСР", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаУслДвижения.ДатаСР) Тогда 
					
					ТекстОшибки = "Укажите Дату специального разрешения.";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"ДатаСР", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаУслДвижения.СрокСР) Тогда 
					
					ТекстОшибки = "Укажите Срок специального разрешения.";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"СрокСР", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаУслДвижения.ВидСР) Тогда 
					
					ТекстОшибки = "Укажите Вид специального разрешения.";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"ВидСР", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаУслДвижения.НаимОИВ) Тогда 
					
					ТекстОшибки = "Укажите Наименование органа, выдавшего специальное разрешение.";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"НаимОИВ", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
					
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры	

