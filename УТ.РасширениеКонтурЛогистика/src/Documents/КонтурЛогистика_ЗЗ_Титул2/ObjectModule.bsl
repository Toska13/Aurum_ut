#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ = Ложь
		И ЗначениеЗаполнено(Титул1) Тогда
		
		ПеренестиДанныеВТ1(Отказ);
		
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЗЗ_Титул2_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		// TODO
		//ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		//ЗаполнитьРеквизитыПоПользователю();
		
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ПредыдущийТитул")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ПредыдущийТитул) Тогда
		
		ЗаполнитьПоПредыдущемуТитулу(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		//КонтурЛогистика_ОбработкаДокументовСервер.ДополнитьДополнительныхПолучателейИзГлавногоДокумента(ЭтотОбъект);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);

	Иначе
		
		ЗаполнитьРеквизитыПоПользователю();
		
	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЗЗ_Титул2_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
		
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДата();
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из док Основания

Процедура ЗаполнитьПоПредыдущемуТитулу(Знач ДанныеЗаполнения)
	
	ПредыдущийТитул = ДанныеЗаполнения.ПредыдущийТитул;
	
	НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляСледующегоТитула(ПредыдущийТитул);
	
	Если ЗначениеЗаполнено(НайденныйДокУчСист) Тогда 
		ДокументОснование = НайденныйДокУчСист;
	КонецЕсли;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
							ДанныеЗаполнения.ТипЛогистика);
							
	УИД_Зак = ПредыдущийТитул.УИД_Зак;
	Если Не ЗначениеЗаполнено(УИД_Зак) Тогда 
		УИД_Зак = "Отсутствует";
	КонецЕсли;
	Титул1 	= ПредыдущийТитул.Ссылка;
	
	ЗаполнитьУказателиНаПредыдущийТитул(ПредыдущийТитул);
			
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
		
		ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации);

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьУказателиНаПредыдущийТитул(Знач ПредыдущийТитул) Экспорт
	
	Перем ДвоичныеДанныеПодписи, ФайлТитула1;
	
	ФайлТитула1 = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ПредыдущийТитул);
	
	ИдФайлИнфГО 	= СтрЗаменить(ФайлТитула1.ИмяФайла, ".xml", "");
	ДатФайлИнфГО 	= ПредыдущийТитул.ДатИнфГО;
	ВрФайлИнфГО  	= ПредыдущийТитул.ВрИнфГО;
	
	ДвоичныеДанныеПодписи = ФайлТитула1.Подпись.Получить();
	ЭПГО 				= Base64Строка(ДвоичныеДанныеПодписи);

КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				Титул1.Перевозчик,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку( "ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации) Экспорт

	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
		//Заполнить ЭтотТитул
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации);
	КонецЕсли;
	
КонецПроцедуры


//////////////////////////////////////////////////////////////////
// Из пришедшего файла XML

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	НайденныйДокументЗЗ = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлуЗЗ(ФайлСсылка);
	
	Если Не ЗначениеЗаполнено(НайденныйДокументЗЗ) Тогда 
		
		Сообщить("При создании титула по файлу " + ФайлСсылка + "не смог найти Документ ЭТРН, создание не выполнено");
		
	Иначе
		
		Титул1 = НайденныйДокументЗЗ;
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		ЗаполнитьРеквизитыТитулаИзXDTO(XDTO);
							
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Документ 		= КС.XDTO_Вычислить(XDTO, "Документ");
	
	ДатИнфПрв 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(Документ, "ДатИнфПрв"));
	ВрИнфПрв 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(Документ, "ВрИнфПрв")); 
	
	// ИдИнфГО
	ДатФайлИнфГО 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(Документ, "ИдИнфГО.ДатФайлИнфГО"));
	ВрФайлИнфГО 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(Документ, "ИдИнфГО.ВрФайлИнфГО"));
	ИдФайлИнфГО 	= КС.XDTO_Вычислить(Документ, "ИдИнфГО.ИдФайлИнфГО");
	ЭПГО 			= КС.XDTO_Вычислить(Документ, "ИдИнфГО.ЭП");
	
	СодИнфПрв = XDTO.Документ.СодИнфПрв;
	
	НаимЭкСубСост 	= КС.XDTO_Вычислить(СодИнфПрв, "НаимЭкСубСост");	
	ОснДовОргСост 	= КС.Конвертировать_РеквДокТип_вДоговорЛогистика(КС.XDTO_Вычислить(СодИнфПрв, "ОснДовОргСост"));
	
	ЕстьОтказВПодписи = КС.XDTO_Вычислить(СодИнфПрв, "СодОпер") = "2";
	
	Если ЕстьОтказВПодписи Тогда 
		
		ПричинаОтказаВПодписи = КС.XDTO_Вычислить(СодИнфПрв, "ПричОтк"); 
		
	Иначе
		
		// СвЛицОргПрвз
		XDTO_СвЛицОргПрвз = КС.XDTO_Вычислить(СодИнфПрв, "СвЛицОргПрвз");	
		СвЛицОргПрвз = КС.Конвертировать_ФИОТипСТелефонами_вСотрудникаЛогистика(XDTO_СвЛицОргПрвз.ФИО, XDTO_СвЛицОргПрвз.Тлф);
		
		// СвВодит
		XDTO_СвВодит = КС.XDTO_Вычислить(СодИнфПрв, "СвВодит");
		Если Не XDTO_СвВодит = Неопределено Тогда
			МассивВодители = КС.XDTO_ВычислитьМассивXDTO(XDTO_СвВодит);
			Для Каждого XDTO_Водитель Из МассивВодители Цикл 
				НоваяСтрокаВодитель = Водители.Добавить();
				НоваяСтрокаВодитель.СвВодит = КС.Конвертировать_СвВодит_вВодителяЛогистика(XDTO_Водитель);
			КонецЦикла;
		КонецЕсли;
		
		// СвТС
		XDTO_СвТС = КС.XDTO_Вычислить(СодИнфПрв, "СвТС");
		
		ТранспортноеСредство = КС.Конвертировать_СвТС_вТранспортноеСредствоЛогистика(КС.XDTO_Вычислить(XDTO_СвТС, "ТС"));
		
		XDTO_Прицеп_raw = КС.XDTO_Вычислить(XDTO_СвТС, "Прицеп");
		Если Не XDTO_Прицеп_raw = Неопределено Тогда
			МассивПрицепы = КС.XDTO_ВычислитьМассивXDTO(XDTO_Прицеп_raw);
			Для Каждого XDTO_Прицеп Из МассивПрицепы Цикл 
				НоваяСтрокаПрицеп = Прицепы.Добавить();
				НоваяСтрокаПрицеп.Прицеп = КС.Конвертировать_СвТС_вТранспортноеСредствоЛогистика(XDTO_Прицеп, Истина);
			КонецЦикла;
		КонецЕсли;
		
		XDTO_СпецУслДвиж = КС.XDTO_Вычислить(XDTO_СвТС, "СпецУслДвиж");
		Если Не XDTO_СпецУслДвиж = Неопределено Тогда
			МассивСпецУслДвиж = КС.XDTO_ВычислитьМассивXDTO(XDTO_СпецУслДвиж);
			Для Каждого XDTO_СпецУслДвиж Из МассивСпецУслДвиж Цикл 
				НоваяСтрокаСпецУслДвиж = СпецУсловияДвижения.Добавить();
				НоваяСтрокаСпецУслДвиж.НомСР 	= КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "НомСР");
				НоваяСтрокаСпецУслДвиж.ДатаСР 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "ДатаСР"));
				НоваяСтрокаСпецУслДвиж.СрокСР 	= КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "СрокСР");
				НоваяСтрокаСпецУслДвиж.ИдСР 	= КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "ИдСР");
				НоваяСтрокаСпецУслДвиж.ВидСР 	= КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "ВидСР");
				НоваяСтрокаСпецУслДвиж.НаимОИВ 	= КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "НаимОИВ");
				
				СведМрш = КС.XDTO_Вычислить(XDTO_СпецУслДвиж, "СведМрш");
				НоваяСтрокаСпецУслДвиж.СведМрш_МршТекст 	= КС.XDTO_Вычислить(СведМрш, "МршТекст");
				НоваяСтрокаСпецУслДвиж.СведМрш_МршМашЧит 	= КС.XDTO_Вычислить(СведМрш, "МршМашЧит");
			КонецЦикла;
		КонецЕсли;
		
		// СвЛицПрв
		XDTO_СвЛицПрв = КС.XDTO_Вычислить(СодИнфПрв, "СвЛицПрв");	
		Если Не XDTO_СвЛицПрв = Неопределено Тогда 
			
			XDTO_РеквДовер = КС.XDTO_Вычислить(XDTO_СвЛицПрв, "РеквДовер");
			РеквДоверНаименование 	= КС.XDTO_Вычислить(XDTO_РеквДовер, "НаимДок");
			РеквДоверНомер 			= КС.XDTO_Вычислить(XDTO_РеквДовер, "НомерДок");
			РеквДоверДата 			= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO_РеквДовер, "ДатаДок"));
			РеквДоверИдДок 			= КС.XDTO_Вычислить(XDTO_РеквДовер, "ИдДок");
			РеквДоверДопСведДок 	= КС.XDTO_Вычислить(XDTO_РеквДовер, "ДопСведДок");
			
			Массив_XDTO_ИдРекСост = КС.XDTO_ВычислитьМассивXDTO(КС.XDTO_Вычислить(XDTO_РеквДовер, "ИдРекСост"));
			Если Массив_XDTO_ИдРекСост.Количество() > 0 Тогда 
				РеквДоверСоставитель = КС.Конвертировать_ИдРекСостТип_вОрганизациюДиадок(Массив_XDTO_ИдРекСост[0]);
			КонецЕсли;
			Если Массив_XDTO_ИдРекСост.Количество() > 1 Тогда 
				РеквДоверСоставитель2 = КС.Конвертировать_ИдРекСостТип_вОрганизациюДиадок(Массив_XDTO_ИдРекСост[1]);
			КонецЕсли;
			
			СвЛицПрв = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_Вычислить(XDTO_СвЛицПрв, "РеквЛицПрв"));
			
		КонецЕсли;
		
		// РазмПлатРасчет
		XDTO_РазмПлатРасчет = КС.XDTO_Вычислить(СодИнфПрв, "РазмПлатРасчет");
		
		Расчет 	= КС.XDTO_Вычислить(XDTO_РазмПлатРасчет, "Расчет");
		
		СтТовБезНДС = КС.XDTO_Вычислить(XDTO_РазмПлатРасчет, "СтТовБезНДС");
		Если ЗначениеЗаполнено(СтТовБезНДС) Тогда 
			НалСт 		= Перечисления.КонтурЛогистика_СтавкиНДС.СтавкаНДСПоПредставлению(КС.XDTO_Вычислить(XDTO_РазмПлатРасчет, "НалСт"));
			СтТовУчНал 	= КС.XDTO_Вычислить(XDTO_РазмПлатРасчет, "СтТовУчНал");
		КонецЕсли;
		
		// ИнфПол
		КонтурЛогистика_КонструкторыXDTO.ЗаполнитьИнфПолИзXDTO(СодИнфПрв, ЭтотОбъект, "ИнфПол");
		
	КонецЕсли;
	
КонецПроцедуры

