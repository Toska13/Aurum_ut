Процедура ПеренестиДанныеВТ1(Отказ)
	
	ПервыйВодительТ2 = РассчитатьПервогоВодителя();
	
	Если Титул1.ПервыйВодитель <> ПервыйВодительТ2 Тогда
		
		Титул1Объект = Титул1.ПолучитьОбъект();
		
		Попытка
			Титул1Объект.Заблокировать();
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОписаниеОшибки = "Не удалось перенести данные о первом водителе в Титул 1 по причине невозможности установки блокировки."
				+ Символы.ПС
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			Сообщить(ОписаниеОшибки);
			Отказ = Истина;
				
		КонецПопытки;
		
		Титул1Объект.ПервыйВодитель = ПервыйВодительТ2;
		Титул1Объект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьПервогоВодителя()
	
	Если Водители.Количество() > 0 Тогда
		Возврат Водители[0].СвВодит;
	Иначе
		Возврат Справочники.КонтурЛогистика_Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

#КонецЕсли