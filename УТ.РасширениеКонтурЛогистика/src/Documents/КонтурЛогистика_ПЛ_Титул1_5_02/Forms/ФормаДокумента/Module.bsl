&НаСервереБезКонтекста
Функция ПричинаОтказаВПодписиТехКонтроляИзТитула3(Титул1)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титул1", Титул1);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул3.ПричинаОтказаВПодписи КАК ПричинаОтказаВПодписи
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул3_5_02 КАК КонтурЛогистика_ПЛ_Титул3
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул3.Титул1 = &Титул1
	|	И КонтурЛогистика_ПЛ_Титул3.ЕстьОтказВПодписи
	|	И НЕ КонтурЛогистика_ПЛ_Титул3.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПричинаОтказаВПодписи;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ВывестиВидВладенияТС()
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		
		ВидВладения = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.ТранспортноеСредство, "ВидВладения");
		
		Если ВидВладения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1")
			Или ВидВладения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыВладенияТранспортнымСредством.СовместнаяСобственностьСупругов_2") Тогда
			Элементы.ДокУчСист_ТранспортноеСредство_ВидВладения.Заголовок = "в собственности";			
		Иначе			
			Элементы.ДокУчСист_ТранспортноеСредство_ВидВладения.Заголовок = "в аренде";			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

