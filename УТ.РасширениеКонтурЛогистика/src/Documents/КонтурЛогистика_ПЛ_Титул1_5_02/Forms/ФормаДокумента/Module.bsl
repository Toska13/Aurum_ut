&НаКлиенте
Процедура ПодборДокументовОснования(Команда)
	
	ИмяФормыДокумента = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ИмяФормыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ИмяФормыВыбораПоТипуДокумента(ТипЗнч(Объект.ДокументОснование));
	КонецЕсли;
	
	Если ИмяФормыДокумента = Неопределено Тогда
		
		// Открываем форму выбора типа документа
		ТипыДокументаОснования = КонтурЛогистика_ОбщегоНазначенияСервер.ТипыДокументаОснования("КонтурЛогистика_ПЛ_Титул1_5_02");
		
		Если ТипыДокументаОснования = Неопределено Тогда
			Сообщить("Не удалось определить тип документа основания!");
			Возврат;
		КонецЕсли;
		
		СЗТипыДокументаОснования = Новый СписокЗначений;
		СЗТипыДокументаОснования.ЗагрузитьЗначения(ТипыДокументаОснования);
		
		Оповещение = Новый ОписаниеОповещения("ВыборТипаДокументаОснованияЗавершение", ЭтаФорма);
		
		СЗТипыДокументаОснования.ПоказатьВыборЭлемента(Оповещение);
		
	Иначе
		
		// Сразу открываем форму выбора
		ОткрытьФормуВыбораДокументаОснование(ИмяФормыДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗначенияДокументаУчетнойСистемы(Команда)
	
	РеквизитыУчетногоДокументаВидимы = Не РеквизитыУчетногоДокументаВидимы;
	Если РеквизитыУчетногоДокументаВидимы Тогда 
		Элементы.ФормаПоказатьЗначенияДокументаУчетнойСистемы.Картинка = БиблиотекаКартинок.КонтурЛогистика_Скрыть;
	Иначе
		Элементы.ФормаПоказатьЗначенияДокументаУчетнойСистемы.Картинка = БиблиотекаКартинок.КонтурЛогистика_Показать;
	КонецЕсли;
	
	СкрытьПоказатьЗначенияДокУчСист();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОсновнымДокументомОснования(Команда)
	
	ТекущиеДанные = Элементы.ДокументыОснования.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДокументОснование = ТекущиеДанные.ДокументОснование;
	
	ИзменениеДокумнетовОснований();
	
	УстановитьПервой(Объект.ДокументыОснования.Индекс(ТекущиеДанные), ТекущиеДанные.НомерСтроки);
	
	ПоказатьПредупреждениеПерезаполнения();
	
КонецПроцедуры

