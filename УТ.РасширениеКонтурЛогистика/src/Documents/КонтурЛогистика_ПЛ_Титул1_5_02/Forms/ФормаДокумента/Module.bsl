&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	ЭтоКоммерческаяПеревозка = Объект.ВидПеревозки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыПеревозки.КП");
	
	Элементы.ВидКоммерческойПеревозки.Видимость = ЭтоКоммерческаяПеревозка;
	
	ЭтоПеревозкаПоДоговору = Объект.ВидКоммерческойПеревозки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыКоммерческихПеревозок.ПГ");
		
	// Причина отказа в подписи
	Элементы.ГруппаПричинаОтказаВПодписи.Видимость = Объект.ЕстьОтказВПодписи;
	Элементы.ГруппаПричинаОтказаВПодписиТехника.Видимость = ЗначениеЗаполнено(ПричинаОтказаВПодписиТехКонтроля);
	
	СкрытьПоказатьЗначенияДокУчСист();
	
	Элементы.ГруппаМедик.Видимость = МедикВнешняяОрганизация;
			
	Если Не ИдетВыборВодителя2 Тогда
		Элементы.ГруппаВодитель2.Видимость = ЗначениеЗаполнено(Объект.Водитель2);
		Элементы.КартинкаВодительПлюс1.Видимость = Не Элементы.ГруппаВодитель2.Видимость;
	КонецЕсли;
	
	Элементы.ГруппаПрицеп2.Видимость = ЗначениеЗаполнено(Объект.Прицеп2);
	Элементы.КартинкаПрицепПлюс1.Видимость = Не Элементы.ГруппаПрицеп2.Видимость;
	
	Элементы.СрокПЛИнтервал.Видимость = ЗначениеЗаполнено(Объект.СрокПЛИнтервал) Или Не Элементы.ГруппаСрокИнтервал.Видимость;
	Элементы.СрокПЛ.Заголовок = ?(Элементы.СрокПЛИнтервал.Видимость, "С", "День");
	Элементы.ГруппаСрокИнтервал.Видимость = Не Элементы.СрокПЛИнтервал.Видимость;
	
	Элементы.ПартнерМедик.Видимость = ЗначениеЗаполнено(Объект.ПартнерМедик);
	
	Элементы.РазделительИндикатор.Видимость = ЗначениеЗаполнено(Объект.Разделитель);
	
	Элементы.ГруппаПодписант.Видимость = ЗначениеЗаполнено(Объект.Фамилия);
	
	Элементы.ГруппаДатаФормированияФайла.Видимость = ЗначениеЗаполнено(Объект.ДатИнфСоб);
	
	ОбновитьЭлементыСквозногоСценария();
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовкиГруппамДопПолей()
	
	// ГруппаИнфПоля
	Элементы.ГруппаИнфПоля.Заголовок = "Информационные поля (" + Объект.ИнфПол.Количество() +")";
	
	// ГруппаДопПолучатели
	Элементы.ГруппаДопПолучатели.Заголовок = "Доп. получатели файла (" + Объект.ДополнительныеПолучателиФайла.Количество() +")";
	
	// ГруппаГосСистемы
	Элементы.ГруппаГосСистемы.Заголовок = "Учет в государственных информационных системах (" + Объект.СведенияГосСистем.Количество() +")";
	
	// СпециальныеУсловияДвижения
	Элементы.ГруппаСпециальныеУсловияДвижения.Заголовок = "Специальные условия движения (" + Объект.СпецУслДвиж.Количество() +")";
	
	// ДокументыОснования
	Элементы.ГруппаДокументыОснования.Заголовок = "Документы основания (" + Объект.ДокументыОснования.Количество() +")";
			
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыСквозногоСценария()
	
	СтороннийМедик = СтороннийМедик();
	Элементы.ГруппаСквознойСценарийМедик.Доступность = Не СтороннийМедик;
	
	Элементы.ФормироватьТ2СразуФлажекВыкл.Видимость = Не Объект.ФормироватьТ2Сразу;
	Элементы.ФормироватьТ2СразуФлажекВкл.Видимость = Объект.ФормироватьТ2Сразу;
	Элементы.ГруппаСквознойСценарийМедикДанные.Видимость = Объект.ФормироватьТ2Сразу;
	
	Элементы.ФормироватьТ3СразуФлажекВыкл.Видимость = Не Объект.ФормироватьТ3Сразу;
	Элементы.ФормироватьТ3СразуФлажекВкл.Видимость = Объект.ФормироватьТ3Сразу;
	Элементы.ГруппаСквознойСценарийТехКонтрольДанные.Видимость = Объект.ФормироватьТ3Сразу;
	
КонецПроцедуры

