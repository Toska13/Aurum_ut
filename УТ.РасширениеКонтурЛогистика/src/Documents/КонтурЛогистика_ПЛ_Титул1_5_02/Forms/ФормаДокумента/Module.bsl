&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер()
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Или РучнойВвод Тогда
		
		Объект.СведенияГосСистем.Очистить();
		Объект.СведенияГосСистем.Очистить();
		Объект.ДополнительныеВодители.Очистить();		
		Объект.СпецУслДвиж.Очистить();
		Объект.ИнфПол.Очистить();
		
		ДокОбъект = РеквизитФормыВЗначение("Объект");
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ДокументОснование", ДокОбъект.ДокументОснование);
		ДанныеЗаполнения.Вставить("ТипЛогистика", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
		ДанныеЗаполнения.Вставить("Разделитель", ДокОбъект.Разделитель);
		
		ДокОбъект.Заполнить(ДанныеЗаполнения);
		
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПрицепПоУмолчанию()
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		Объект.Прицеп = Объект.ТранспортноеСредство.ПрицепПоУмолчанию;
		Объект.Прицеп2 = Объект.ТранспортноеСредство.Прицеп2ПоУмолчанию;
	Иначе
		Объект.Прицеп = Справочники.УчетнаяСистема_ТранспортныеСредства.ПустаяСсылка();
		Объект.Прицеп2 = Справочники.УчетнаяСистема_ТранспортныеСредства.ПустаяСсылка();
	КонецЕсли;
	
