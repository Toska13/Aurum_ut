&НаКлиенте
Процедура ДокументОснованиеОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ПриОчисткеДокументаОснование(ЭтаФорма, Объект.ДокументОснование);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеДокумнетовОснований()
	
	ОтрисоватьДокументыОснованияКлиент();
	
	Элементы.ПерезаполнитьПоДокОснованию.ЦветТекста = WebЦвета.Красный;
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьДокументыОснованияСервер()
	
	КоличествоОснований = Объект.ДокументыОснования.Количество();
	Если КоличествоОснований > 1 Тогда 
		Элементы.ДекорацияНесколькоОснований.Видимость = Истина;
		Элементы.ДокументОснование.Видимость = Ложь;
		Если КоличествоОснований = 2 Или КоличествоОснований = 3 Или КоличествоОснований = 4 Тогда
			Элементы.ДекорацияНесколькоОснований.Заголовок = "" + КоличествоОснований + " документа-оснований";
		Иначе
			Элементы.ДекорацияНесколькоОснований.Заголовок = "" + КоличествоОснований + " документов-оснований";
		КонецЕсли;
	Иначе
		Элементы.ДекорацияНесколькоОснований.Видимость = Ложь;
		Элементы.ДокументОснование.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтрисоватьДокументыОснованияКлиент()
	
	КоличествоОснований = Объект.ДокументыОснования.Количество();
	Если КоличествоОснований > 1 Тогда 
		Элементы.ДекорацияНесколькоОснований.Видимость = Истина;
		Элементы.ДокументОснование.Видимость = Ложь;
		Если КоличествоОснований = 2 Или КоличествоОснований = 3 Или КоличествоОснований = 4 Тогда
			Элементы.ДекорацияНесколькоОснований.Заголовок = "" + КоличествоОснований + " документа-оснований";	
		Иначе
			Элементы.ДекорацияНесколькоОснований.Заголовок = "" + КоличествоОснований + " документов-оснований";
		КонецЕсли;
	Иначе
		Элементы.ДекорацияНесколькоОснований.Видимость = Ложь;
		Элементы.ДокументОснование.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыборТипаДокументаОснованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ИмяФормыВыбораПоТипуДокумента(Результат.Значение);
	
	ОткрытьФормуВыбораДокументаОснование(ИмяФормыДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораДокументаОснование(ИмяФормыДокумента)
	
	ПараметрыФормы = Новый Структура("МножественныйВыбор, ЗакрыватьПриВыборе", Истина, Ложь);
	
	Если ТипЗнч(ПолучитьФорму(ИмяФормыДокумента)) = Тип("УправляемаяФорма") Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы(ИмяФормыДокумента, ПараметрыФормы, Элементы.ДокументыОснования);
	Иначе
		ОткрытьФорму(ИмяФормыДокумента, ПараметрыФормы, Элементы.ДокументыОснования);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеПерезаполнения()
	
	ТекстПредупреждения = "Документ используемый для заполнения изменен.
		|Возможно следует перезаполнить документ.";
	КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПредупреждения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПервой(Знач ИндексСтроки, Знач НомерСтроки)
	
	Объект.ДокументыОснования.Сдвинуть(ИндексСтроки, 1 - НомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДокументовОснования(массДокументыОснования)
	
	Если массДокументыОснования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущееЗначение Из массДокументыОснования Цикл
		
		ЕстьДубли = Ложь;
		
		Для Каждого ТекущийДокументОснования Из Объект.ДокументыОснования Цикл
			Если ТекущийДокументОснования.ДокументОснование = ТекущееЗначение Тогда
				ЕстьДубли = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьДубли Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ТекущееЗначение;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) И Объект.ДокументыОснования.Количество() <> 0 Тогда
		Объект.ДокументОснование = Объект.ДокументыОснования[0].ДокументОснование;
		ПоказатьПредупреждениеПерезаполнения();
	КонецЕсли;
	
	ИзменениеДокумнетовОснований();
	
КонецПроцедуры

&НаКлиенте
Функция ВсегдаВыводитьРезультатВалидации()
	
	Возврат ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПустаяСсылка")
		Или ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик");
	
КонецФункции

&НаКлиенте
Функция СтороннийМедик()
	Возврат СтороннийМедикНаСервере();	
КонецФункции
	
&НаСервере
Функция СтороннийМедикНаСервере()
	
	Возврат (ЗначениеЗаполнено(Объект.ОрганизацияМедик)
		И Объект.ЛицоОформившееПЛ <> Объект.ОрганизацияМедик
		И Не ОрганизацияМедикНаш);
	
КонецФункции
	
&НаСервере
Процедура ОрганизацияМедикПриИзмененииСервер()

	Если ЗначениеЗаполнено(Объект.ОрганизацияМедик) Тогда
		ОрганизацияМедикНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.ОрганизацияМедик, "Наш");
	Иначе
		ОрганизацияМедикНаш = Ложь;
	КонецЕсли;
	
	Если СтороннийМедикНаСервере() Тогда
		Объект.ФормироватьТ2Сразу = Ложь;
		Объект.ФормироватьТ3Сразу = Ложь;
	КонецЕсли;
	РассчитатьПартнераМедика();	

КонецПроцедуры

&НаСервере
Процедура РассчитатьПартнераМедика()

	Если ЗначениеЗаполнено(Объект.ОрганизацияМедик) Тогда 
		Объект.ПартнерМедик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(Объект.ОрганизацияМедик);
	Иначе
		Объект.ПартнерМедик = Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

