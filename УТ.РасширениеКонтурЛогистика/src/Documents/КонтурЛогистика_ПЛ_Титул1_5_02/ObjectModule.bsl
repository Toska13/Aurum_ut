#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
	
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Отказ
		И Не ЗначениеЗаполнено(УИД_ПЛ)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоВходящийДокумент(ДополнительныеСвойства)
		И ЗначениеЗаполнено(ЛицоОформившееПЛ) Тогда
		
		Если Не ЭтоПроверкаСквозногоСценария(ДополнительныеСвойства) Тогда
		
			Организация = КонтурЛогистика_ОбщегоНазначенияСервер.ОрганизацияДляЗапросаУИДов(ЭтотОбъект);
			
			ПолученныйУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ПолучитьОчередной(Организация);
			Если ПолученныйУИД <> Неопределено Тогда
				УИД_ПЛ = ПолученныйУИД;
				ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация);
			Иначе
				Если Не ДополнительныеСвойства.Свойство("ТихийРежим") Тогда
					Сообщить("Не получен УИД из пула. Закончились?");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
						
	КонецЕсли;
	
	// Медик не наш, тогда не можем формировать Т2
	Если ФормироватьТ2Сразу
		И ЗначениеЗаполнено(ОрганизацияМедик)
		И ЛицоОформившееПЛ <> ОрганизацияМедик
		И Не ОрганизацияМедик.Наш Тогда
		
		ФормироватьТ2Сразу = Ложь;
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ПЛ_Титул1_5_02_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// а) Из документа учетной системы 
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// а1) Из титула5 (водители, сдеавшие ТС дргуим водителям) 
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ПредыдущийТитул")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ПредыдущийТитул) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// б) загружен из сервиса, создаем из файла обмена
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;
		
		// Идентификатор в Логистике
		kl_id = ДанныеЗаполнения.kl_id;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);
		
	// в) копирование 
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Титул")
		И ДанныеЗаполнения.Свойство("Скопировать")
		И ДанныеЗаполнения.Скопировать Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Титул);
		Для каждого ТЧ Из ЭтотОбъект.Метаданные().ТабличныеЧасти Цикл
			Для каждого Стр Из ДанныеЗаполнения.Титул[ТЧ.Имя] Цикл
				НоваяСтрока = ЭтотОбъект[ТЧ.Имя].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		КонецЦикла;
		
		ЭтотОбъект.Номер = "";
		ЭтотОбъект.УИД_ПЛ = "";
		ЭтотОбъект.Дата = ТекущаяДатаСеанса();
		ЭтотОбъект.ДатаПЛ = ТекущаяДатаСеанса();
		ЭтотОбъект.kl_id = "";
		ЭтотОбъект.ХешСуммаQRКода = 0;
		КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьНомерКопииКНомеруДокумента(
			ЭтотОбъект.НомерПЛ, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
			
	// в) ручной ввод Т1 с нуля
	Иначе
		
		НастройкаКонвертацииСНуля = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
		Если ЗначениеЗаполнено(НастройкаКонвертацииСНуля) Тогда 
			ЗаполнитьДефолтыРучногоЗаполненияПоНастройкеКонвертации(НастройкаКонвертацииСНуля);
		КонецЕсли;
		
		ЗаполнитьРеквизитыПоПользователю();
		
	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ПЛ_Титул1_5_02_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДата();
	УИД_ПЛ = "";
	ХешСуммаQRКода = 0;
	ЕстьОтказВПодписи = Ложь;
	ПричинаОтказаВПодписи = "";
	kl_id = "";
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнитьИзДокументаОснования

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.Свойство("ПредыдущийТитул") Тогда
		ПредыдущийТитул = ДанныеЗаполнения.ПредыдущийТитул;
	Иначе
		ПредыдущийТитул = Неопределено;
	КонецЕсли;
	
	Если ДанныеЗаполнения.Свойство("СпецСценарий") Тогда		
		СпецСценарий = ДанныеЗаполнения.СпецСценарий;		
	Иначе		
		СпецСценарий = Неопределено;		
	КонецЕсли;
		
	Разделитель = Неопределено;
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	ДанныеЗаполнения.Свойство("Разделитель", Разделитель);
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
		ДанныеЗаполнения.ТипЛогистика, ДанныеЗаполнения.ДокументОснование, СпецСценарий);
	
	// Заполнить ЭтотТитул
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации);
	
	// Могли быть переданы конкретные N документов оснований а не 1
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдномуЭПЛ") Тогда 
		Если ДанныеЗаполнения.Свойство("ДокументыОснования") 
			И ТипЗнч(ДанныеЗаполнения.ДокументыОснования) = Тип("Массив") Тогда
			Для Каждого ДопДокОснование Из ДанныеЗаполнения.ДокументыОснования Цикл 
				НовСтр = ДокументыОснования.Добавить();
				НовСтр.ДокументОснование = ДопДокОснование;
			КонецЦикла;
		Иначе
			НовСтр = ДокументыОснования.Добавить();
			НовСтр.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
		КонецЕсли;
	Иначе
		НовСтр = ДокументыОснования.Добавить();
		НовСтр.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	КонецЕсли;
	ДокументыОснования.Свернуть("ДокументОснование");
	
	Если ЗначениеЗаполнено(НастройкаКонвертации)
		И ЗначениеЗаполнено(НастройкаКонвертации.ПоискОснованийКодНа1С)
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдномуЭПЛ") Тогда 
	
		//вычислить массив оснований
		Попытка
			МассивДокументыОснования = Новый Массив;
			Выполнить(НастройкаКонвертации.ПоискОснованийКодНа1С);
			Для Каждого ДопДокОснование Из МассивДокументыОснования Цикл 
				НовСтр = ДокументыОснования.Добавить();
				НовСтр.ДокументОснование = ДопДокОснование;
			КонецЦикла;
			
			ДокументыОснования.Свернуть("ДокументОснование");
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ИдентификаторыЕГАИС) Тогда
		ПоложитьИдентификаторыЕГАИСВИнфПоля(ИдентификаторыЕГАИС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоложитьИдентификаторыЕГАИСВИнфПоля(ИдентификаторыЕГАИС)
	
	МассивИдентификаторыЕГАИС = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ИдентификаторыЕГАИС, ";", Ложь);
			
	Для каждого Идентификатор Из МассивИдентификаторыЕГАИС Цикл
		
		НоваяСтрока = ИнфПол.Добавить();
		НоваяСтрока.Идентиф = "ЕГАИС";
		НоваяСтрока.Значение = СокрЛП(Идентификатор);
					
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнитьИзФайлаОбмена

Процедура ЗаполнитьДефолтыРучногоЗаполненияПоНастройкеКонвертации(Знач НастройкаКонвертации)

	Разделитель = Неопределено;
	ДокументОснование = Неопределено;	

	ДополнительныеВодители.Очистить();
	ДополнительныеПолучателиФайла.Очистить();
	ИнфПол.Очистить();
	ДокументыОснования.Очистить();

	Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ЭтотОбъект, ДокументОснование, НастройкаКонвертации, "");
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации, , Переменные);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнитьИзФайлаОбмена

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
	
	СодИнфСоб 	= XDTO.Документ.СодИнфСоб; 
	
	ЗаполнитьРеквизитыТитулаИзXDTO(XDTO, СодИнфСоб);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO, Знач СодИнфСоб)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	УИД_ПЛ 	= КС.XDTO_Вычислить(СодИнфСоб, "УИД_ПЛ");
	
	ДатИнфСоб 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ДатИнфСоб"));
	ВрИнфСоб 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ВрИнфСоб"));

	ЛицоОформившееПЛ    = КС.Конвертировать_РекИдентГО_вОрганизациюДиадок(КС.XDTO_ПолучитьЗначениеСвойства(СодИнфСоб, "СвЛицПЛ"));
	
	МассивКлючей_R_Т_A_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(КС.XDTO_Вычислить(XDTO,"ИдФайл"), "_");
	КлючA = МассивКлючей_R_Т_A_О_W[2];
		
	// мед раб
	ОргA = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиСоздатьПоИдентификаторуЭДО(КлючA);
	Если ОргA <> ЛицоОформившееПЛ Тогда 
		ОрганизацияМедик = ОргA;
	КонецЕсли;
	
	НомерПЛ  	= КС.XDTO_Вычислить(XDTO, "Документ.НомДок");
	ДатаПЛ_raw	= КС.XDTO_Вычислить(XDTO, "Документ.ДатаДок");
	ДатаПЛ		= КС.Конвертировать_ДатаТип_вДата(ДатаПЛ_raw);
	
	ОбязМедосмотрПосле			= КС.XDTO_Вычислить(СодИнфСоб, "ОбМедОсмПосле") = "1";
	ВидПеревозки				= Перечисления.КонтурЛогистика_ВидыПеревозки.ЗначениеИзXDTO(КС.XDTO_Вычислить(СодИнфСоб, "ВидПрв"));	
	ВидКоммерческойПеревозки 	= Перечисления.КонтурЛогистика_ВидыКоммерческихПеревозок.ЗначениеИзXDTO(КС.XDTO_Вычислить(СодИнфСоб, "ВидКП"));
	ВидСообщения				= Перечисления.КонтурЛогистика_ВидыПутейСообщений.ЗначениеИзXDTO(КС.XDTO_Вычислить(СодИнфСоб, "ВидСообщ"));
		
	Если КС.XDTO_Вычислить(СодИнфСоб, "СрокПЛ.ПЛДень") = "1" Тогда 
		СрокПЛ = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СодИнфСоб, "СрокПЛ.ДатаИспПЛ"));
		СрокПЛИнтервал = СрокПЛ;
	Иначе
		СрокПЛ = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СодИнфСоб, "СрокПЛ.ДатаНачИспПЛ"));
		СрокПЛИнтервал = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СодИнфСоб, "СрокПЛ.ДатаКонИспПЛ"));
	КонецЕсли;
	
	СвТС_XDTO 				= КС.XDTO_Вычислить(СодИнфСоб, "СвТС");
	ТранспортноеСредство 	=  КС.Конвертировать_СвТС_вТранспортноеСредствоЛогистика(КС.XDTO_Вычислить(СвТС_XDTO, "ТС"), Ложь);
	Прицепы_XDTO 			=  КС.XDTO_Вычислить(СвТС_XDTO, "Прицеп");
	МассивПрицеповXDTO		= КС.XDTO_ВычислитьМассивXDTO(Прицепы_XDTO);
	КолчествоПрицепов = МассивПрицеповXDTO.Количество();
	Если КолчествоПрицепов > 0 Тогда
		Прицеп 				= КС.Конвертировать_СвТС_вТранспортноеСредствоЛогистика(МассивПрицеповXDTO[0], Истина);
		
		Если КолчествоПрицепов > 1 Тогда
			Прицеп2			= КС.Конвертировать_СвТС_вТранспортноеСредствоЛогистика(МассивПрицеповXDTO[1], Истина);
		КонецЕсли;
	КонецЕсли;
	
	// Водитель 1
	СвВодит_XDTO		= КС.XDTO_Вычислить(СодИнфСоб, "СвВодит");
	МассивСвВодит_XDTO  = КС.XDTO_ВычислитьМассивXDTO(СвВодит_XDTO);
	Водитель 	= КС.Конвертировать_СвВодит_вВодителяЛогистика(МассивСвВодит_XDTO[0]);
	// Водитель 2
	Если МассивСвВодит_XDTO.Количество() > 1 Тогда 
		Водитель2 	= КС.Конвертировать_СвВодит_вВодителяЛогистика(МассивСвВодит_XDTO[1]);
	КонецЕсли;
	// Водитель 3,4...
	Если МассивСвВодит_XDTO.Количество() > 2 Тогда 
		
		Для й = 2 По МассивСвВодит_XDTO.Количество() Цикл
			НоваяСтрокаДопВодителя = ДополнительныеВодители.Добавить();
			НоваяСтрокаДопВодителя.Водитель = КС.Конвертировать_СвВодит_вВодителяЛогистика(МассивСвВодит_XDTO[й-1]);
		КонецЦикла;
		
	КонецЕсли;
	
	// спец условия движения
	КС.ЗаполнитьСпецУслДвижИзXDTO(СодИнфСоб, ЭтотОбъект, "СпецУслДвиж");
	
	// учет в гос системах
	КС.ЗаполнитьСвГосСистИзXDTO(СодИнфСоб, ЭтотОбъект, "СведенияГосСистем");
		
	ТипПодпис_raw = КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.ТипПодпис");
	ТипПодпис = Перечисления.КонтурЛогистика_ТипыПодписи.ЗначениеИзXDTO(ТипПодпис_raw);
	
	СпосПодтПолном_raw = КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.СпосПодтПолном");
	СпосПодтПолном = Перечисления.КонтурЛогистика_СпособыПодтвержденияПолномочий.ЗначениеИзXDTO(СпосПодтПолном_raw);
	
	Должность 	= КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.Должн");
	
	Фамилия 	= КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.ФИО.Фамилия");
	Имя 		= КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.ФИО.Имя");
	Отчество 	= КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.ФИО.Отчество");
	
	ДопСведенияОПодписанте = КС.XDTO_Вычислить(XDTO, "Документ.ПодпИнфСоб.ДопСведПодп");
	
	// ИнфПол
	КС.ЗаполнитьИнфПолИзXDTOсИдФайл(СодИнфСоб, ЭтотОбъект, "ИнфПол");
	
	КС.ЗаполнитьДополнительныхПолучателей(XDTO, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ГенерацияXML

Функция СформироватьФайлОбмена(ПараметрыФайлаРеквизиты = Неопределено) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	Попытка
	
		Заблокировать();
	
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не удалось заблокировать документ: " + ОписаниеОшибки();
		Возврат Результат;
		
	КонецПопытки;
	
	// Проверка статуса после наложения блокировки на Документ
	РезультатПроверкиСтатуса = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьТекущийСтатусДокументаДляСозданияФайловОбмена(Ссылка);
	
	Если НЕ РезультатПроверкиСтатуса.Успешно Тогда
		Разблокировать();
		Возврат РезультатПроверкиСтатуса;
	КонецЕсли;
	
	// Выполнить валидацию документа
	РезультатВалидации = Документы.КонтурЛогистика_ПЛ_Титул1_5_02.ПроверитьДокумент(Ссылка);
	
	Если РезультатВалидации.КоличествоОшибок > 0 Тогда
		
		Разблокировать();
		Результат.ОписаниеОшибки = "Ошибки в " + Ссылка + "! Исправьте их для отправки.";
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	ДатИнфСоб = ТекущаяДатаСеанса();
	ВрИнфСоб = ТекущаяДатаСеанса();
	
	Попытка
		
		// формируем текст xml
		РезультатФормированияТекста = СформироватьТекстФайла(ДатИнфСоб, ВрИнфСоб);
		Если РезультатФормированияТекста.Успешно = Ложь Тогда
					
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормированияТекста));
			Возврат Результат;
					
		КонецЕсли;
		
		// запишем в справочник
		РезультатСозданияФайла = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьФайлОбмена(
										РезультатФормированияТекста,
										Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02,
										ПараметрыФайлаРеквизиты,
										Ссылка);
				
		ЗаполнитьЗначенияСвойств(Результат, РезультатСозданияФайла);
		
		Если Результат.Успешно Тогда
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Ссылка, 
				Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена, , Истина);
			
			Результат.МассивФайловОбмена.Добавить(РезультатСозданияФайла.Файл);
			
		Иначе
			
			ВызватьИсключение КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(Результат);
			
		КонецЕсли;
		
		Записать(); // запишем  ДатИнфСоб и ВрИнфСоб
		
		Разблокировать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = "Ошибка при формировании файла обмена по документу " + Ссылка + ": " + ОписаниеОшибки();
		Сообщить(ТекстОшибки);
		Разблокировать();
		Результат.Успешно = Ложь;
		Результат.Массивошибок.Добавить(ТекстОшибки);
		
		КонтекстМетода = Новый Структура;
		КонтекстМетода.Вставить("ПараметрыФайлаРеквизиты", ПараметрыФайлаРеквизиты);
		КонтекстМетода.Вставить("РезультатСозданияФайла", РезультатСозданияФайла);
		
		КонтурЛогистика_Метрика.ОбработатьОшибкуФормированияТекстаФайла(Ссылка, ИнформацияОбОшибке(), КонтекстМетода);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТекстФайла(ДатаФормирования, ВремяФормирования)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	НомерТитула = 1;
	Формат = "5.02";
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ТекстФайла", "");
	
	XDTO_Файл = КС.XDTO_ФайлОбмена(НомерТитула, Формат, "__PL");
	
	GUID = Строка(Новый УникальныйИдентификатор);
	
	ОтправительФайла = ЛицоОформившееПЛ;
	
	Если ДополнительныеПолучателиФайла.Количество() > 0 Тогда 
		W = 1;
	Иначе
		W = 0;
	КонецЕсли;
	
	КС.ДобавитьДополнительныхПолучателейФайла(XDTO_Файл, ДополнительныеПолучателиФайла); 	
	
	XDTO_Файл.ИдФайл = КС.ИдентификаторФайлаТитулаПЛ_5_02(НомерТитула, 
												ОтправительФайла,
												ОрганизацияМедик,																								
												GUID,
												W);
	Результат.Вставить("ИдФайл",		XDTO_Файл.ИдФайл);
												
	ПодписантСтруктура 	= РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
		ОтправительФайла, ПользовательПодписант, ДатаПЛ, ЭтотОбъект, ПараметрНастроекПодписания);
		
	XDTO_Подписант 		= КС.XDTO_ПодпИнф(НомерТитула, "__PL", Формат, ПодписантСтруктура);
	Если ЗначениеЗаполнено(ПодписантСтруктура.МЧД) И ПодписантСтруктура.СпосПодтПолном = "3" Тогда 
		Результат.Вставить("ИдентификаторМЧД",	ПодписантСтруктура.МЧД);
	КонецЕсли;
		
	XDTO_Файл.Документ	= КС.XDTO_Документ(НомерТитула, "__PL", Формат, XDTO_Подписант, ДатаФормирования, ВремяФормирования);

	XDTO_СодИнфСоб = КС.XDTO_ПЛ_СодИнфСоб_5_02(НомерТитула, Формат, Ссылка);
	
	КС.XDTO_Установить(XDTO_Файл.Документ, "СодИнфСоб", XDTO_СодИнфСоб);
		
	КС.XDTO_Установить(XDTO_Файл.Документ, "ДатаДок", КС.XDTO_ДатаТип(ДатаПЛ));
	КС.XDTO_Установить(XDTO_Файл.Документ, "НомДок", СокрЛП(НомерПЛ));
			
	ТекстФайла = КонтурЛогистика_КонструкторыXDTO.ПодготовитьТекстФайлаЛогистика(XDTO_Файл, Формат);
	
	Результат.Вставить("ТекстФайла",ТекстФайла);
	Результат.Вставить("GUID",		GUID);
	
	Результат.Успешно = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ОрганизацияПодписанта = ЛицоОформившееПЛ;
			
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				ОрганизацияПодписанта,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
				
	Исключение
		
		КонтурЛогистика_Метрика.Метрика_Отправить_Предупреждение("КонтурЛогистика_ЗаполнитьРеквизитыПоПользователю", 
			"ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация)
	
	УспешноОтметилиИспользованиеУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ОтметитьИспользованным(УИД_ПЛ, Организация);
	Если Не УспешноОтметилиИспользованиеУИД Тогда
		
		Отказ = Истина;
		Сообщить("УИД из пула был использован другим документом, попробуйте повторить операцию");
		
	КонецЕсли;
	
КонецПроцедуры		

Функция ЭтоПроверкаСквозногоСценария(ДопСведения)
	
	Если ТипЗнч(ДопСведения) = Тип("Структура") 
		И ДопСведения.Свойство("ПроверкаСквозногоСценария") Тогда		
		Возврат Истина;
	Иначе
		Возврат Ложь
	КонецЕсли;
			
КонецФункции

