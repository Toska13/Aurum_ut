Функция МассивОбязательныхРеквизитов(ТипДокумента = Неопределено) Экспорт
	
	МассивОбязательных = Новый Массив();
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1 Тогда 
		// выгружаем пустой контейнер из ТС
		МассивОбязательных.Добавить("МестоВыгрузки");
		МассивОбязательных.Добавить("ДатТСВыгр");
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул3 Тогда 
		// погружаем заполненный контейнер на ТС
		МассивОбязательных.Добавить("МестоПогрузки");
		МассивОбязательных.Добавить("ДатТСПогр");
	КонецЕсли;
	
	// FIXME
	МассивОбязательных.Добавить("ОтвЛицоПВ");
	МассивОбязательных.Добавить("ТранспортноеСредство");
	
	МассивОбязательных.Добавить("ПользовательПодписант");
	
	Возврат МассивОбязательных;
	
КонецФункции

