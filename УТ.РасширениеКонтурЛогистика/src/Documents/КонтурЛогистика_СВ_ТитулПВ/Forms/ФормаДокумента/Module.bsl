&НаСервере
Процедура ЗаполнитьПредставлениеРеквизитовДокументаОснования()

	Представления = ПолучитьПредставлениеРеквизитовДокументаОснования(Объект.ДокументОснование, Объект);	
	МассивКонвертируемыхРеквизитов = СоответствиеКонвертируемыхРеквизитовИзДокУчСист();
	
	Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл 
		
		Значение = Неопределено;
		
		Если  Представления.Свойство("ДокУчСист_" + Эл.Ключ, Значение) Тогда 
			текВыражение = "ДокУчСист_" + Эл.Ключ  + " = Значение";
			Выполнить (текВыражение);
			
			
			// определим доступность команды сопоставления
			ИмяЭлементаЛогистика = Эл.Значение; // сконвертированного
			ИмяЭлементаНадписиСопоставить = "ДокУчСист_" + Эл.Ключ + "_Сопоставить";
			
			Если ЗначениеЗаполнено(ИмяЭлементаЛогистика) И ЗначениеЗаполнено(Этаформа["ДокУчСист_" + Эл.Ключ]) Тогда // если этот элемент выведен на форму и он рассчитан из документа уч сист
				
				Если Элементы.Найти(ИмяЭлементаЛогистика) <> Неопределено Тогда
					
					ПутьПроверкиДанных = Элементы.Найти(ИмяЭлементаЛогистика).ПутьКДанным;
					ЗначениеВРеквизите = Вычислить(ПутьПроверкиДанных);
					НужноСопоставить = Не ЗначениеЗаполнено(ЗначениеВРеквизите);
					
				Иначе
					
					НужноСопоставить = Ложь;
					
				КонецЕсли;
				
				Элементы.Найти(ИмяЭлементаЛогистика).Видимость = НЕ НужноСопоставить;
				Элементы.Найти(ИмяЭлементаНадписиСопоставить).Видимость = НужноСопоставить;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеРеквизитовДокументаОснования(ДокументОснование, Знач ДокументТитулОбъект)
	
	МассивКонвертируемыхРеквизитов = СоответствиеКонвертируемыхРеквизитовИзДокУчСист();
	
	СтруктураПредставлений = Новый Структура;
	Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл 
		СтруктураПредставлений.Вставить("ДокУчСист_" + Эл);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда 
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументОснование);
		
		Если НастройкаКонвертации <> Неопределено Тогда
			
			Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл 
				
				Если Эл.Ключ = "Водитель" Тогда // в другой ТЧ 
					НастройкаКонвертацииРеквизита = НастройкаКонвертации.ПравилаКонвертацииТитулаРеквизиты.Найти(Эл.Ключ, "РеквизитТитула");
				Иначе
					НастройкаКонвертацииРеквизита = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти(Эл.Ключ, "РеквизитТитула");
				КонецЕсли;
				
				РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
											ДокументОснование,
											НастройкаКонвертацииРеквизита,
											НастройкаКонвертации,
											ДокументТитулОбъект,
											Ложь);
				
				Если РезультатВычисления.Успешно Тогда 
					СтруктураПредставлений.Вставить("ДокУчСист_" + Эл.Ключ, 	РезультатВычисления.Значение);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		 
	КонецЕсли;
	
	Возврат СтруктураПредставлений;
	
КонецФункции

&НаСервереБезКонтекста
Функция СоответствиеКонвертируемыхРеквизитовИзДокУчСист()
	
	Перем МассивКонвертируемыхРеквизитов;
	
	МассивКонвертируемыхРеквизитов = Новый Соответствие;
	МассивКонвертируемыхРеквизитов.Вставить("Грузоотправитель"				, "ДокументСВГрузоотправитель");
	МассивКонвертируемыхРеквизитов.Вставить("Перевозчик"					, "ДокументСВПеревозчик");
	МассивКонвертируемыхРеквизитов.Вставить("Грузополучатель"				, "ДокументСВГрузополучатель");
	МассивКонвертируемыхРеквизитов.Вставить("ТранспортноеСредство"			, "ДокументСВТранспортноеСредство");
	МассивКонвертируемыхРеквизитов.Вставить("Прицеп"						, "ДокументСВПрицеп");
	МассивКонвертируемыхРеквизитов.Вставить("МестоПогрузки"					, "ДокументСВМестоПогрузки");
	МассивКонвертируемыхРеквизитов.Вставить("МестоДоставки"					, "ДокументСВМестоДоставки");
	МассивКонвертируемыхРеквизитов.Вставить("ГрузоотправительПодразделение"	, ""); // элементов нет в Т1
	МассивКонвертируемыхРеквизитов.Вставить("ПеревозчикПодразделение"		, "");
	МассивКонвертируемыхРеквизитов.Вставить("ГрузополучательПодразделение"	, "");
	МассивКонвертируемыхРеквизитов.Вставить("ПогрузкаДоговор"				, "");
	МассивКонвертируемыхРеквизитов.Вставить("ПогрузкаСотрудник"				, "ДокументСВПогрузкаСотрудник");
	МассивКонвертируемыхРеквизитов.Вставить("Водитель"						, "Водитель");
	МассивКонвертируемыхРеквизитов.Вставить("ЭкспедицияЗаказчик"			, "ДокументСВЭкспедицияЗаказчик");
	МассивКонвертируемыхРеквизитов.Вставить("ЭкспедицияДоговор"				, "ДокументСВЭкспедицияДоговор");
	Возврат МассивКонвертируемыхРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДокУчСист_Реквизит_СопоставитьНажатие(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	ОбъектДокУчСистПуть = "ЭтаФорма." + СтрЗаменить(ИмяЭлемента, "_Сопоставить", "");
	ЗначениеОбъектДокУчСист = Вычислить(ОбъектДокУчСистПуть);
	
	ОткрытьФормуПодбораСущностиЛогистика(ЗначениеОбъектДокУчСист, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодбораСущностиЛогистика(Знач ОбъектУчетнойСистемы, Знач Элемент)
	
	ПараметрыФормыПоиска = Новый Структура;
	ПараметрыФормыПоиска.Вставить("ОбъектУчетнойСистемы", ОбъектУчетнойСистемы);
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ИмяЭлементаФормы", Элемент.Имя);
	
	Если Элемент.Имя = "ДокУчСист_Грузоотправитель_Сопоставить"
		ИЛИ Элемент.Имя = "ДокУчСист_Перевозчик_Сопоставить"
		ИЛИ Элемент.Имя = "ДокУчСист_Грузополучатель_Сопоставить"
		ИЛИ Элемент.Имя = "ДокУчСист_ЭкспедицияЗаказчик_Сопоставить"
		Тогда 
		
		ИмяСущности = "КонтурЛогистика_ОрганизацииДиадок";
		
	ИначеЕсли Элемент.Имя = "ДокУчСист_МестоПогрузки_Сопоставить"
		ИЛИ Элемент.Имя = "ДокУчСист_МестоДоставки_Сопоставить"
		Тогда
		
		ИмяСущности = "КонтурЛогистика_ПунктыМаршрута";
		
	ИначеЕсли Элемент.Имя = "ДокУчСист_ТранспортноеСредство_Сопоставить"
		ИЛИ Элемент.Имя = "ДокУчСист_Прицеп_Сопоставить"
		Тогда
		
		ИмяСущности = "КонтурЛогистика_ТранспортныеСредства";
		
	ИначеЕсли Элемент.Имя = "ДокУчСист_ПогрузкаСотрудник_Сопоставить"
		ИЛИ Элемент.Имя = "ДокУчСист_Водитель_Сопоставить"
		Тогда
		
		ИмяСущности = "КонтурЛогистика_Сотрудники";
		
	ИначеЕсли Элемент.Имя = "ДокУчСист_ЭкспедицияДоговор_Сопоставить"
		Тогда
		
		ИмяСущности = "КонтурЛогистика_Договоры";
		
	Иначе
		
		ВызватьИсключение "не реализовано";
		
	КонецЕсли;
	
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник." + ИмяСущности + ".ФормаВыбора",
			ПараметрыФормыПоиска,
			ЭтаФорма,
			ЭтаФорма,
			"ОбработчикВыбораСопоставленияРеквизитаДокумента",
			ПараметрыОбработчика);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораСопоставленияРеквизитаДокумента(ВыбранноеЗначение, ДопПараметры) Экспорт

	Если ВыбранноеЗначение <> Неопределено Тогда 
		
		// Выполнить переконвертацию или присваивание
		ПовторноСконвертироватьРеквизит(ДопПараметры.ИмяЭлементаФормы);
		
		ПолностьюОбновитьПредставлениеДанных();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПовторноСконвертироватьРеквизит(ИмяЭлементаФормы)
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	ПерезаполнитьЭТРН = Ложь;
	
	ИмяРеквизита = СтрЗаменить(ИмяЭлементаФормы, "ДокУчСист_", "");
	ИмяРеквизита = СтрЗаменить(ИмяРеквизита, "_Сопоставить", "");
	
	// надо понять, требуется ли переконвертировать ЭТРН или надо конвертнуть только титул	
	СоотвРеквизита = СоответствиеКонвертируемыхРеквизитовИзДокУчСист().Получить(ИмяРеквизита);
	Если СоотвРеквизита <> Неопределено Тогда 
		Если Найти(СоотвРеквизита, "ДокументСВ") Тогда 
			ПерезаполнитьЭТРН = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура("ДокументОснование, ТипЛогистика, ПерезаполнитьГлавныйДокументЕслиСуществует", Объект.ДокументОснование, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ПерезаполнитьЭТРН);
	ДокОбъект.Заполнить(ДанныеЗаполнения);
	
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЭТРН()
	
	ДокЭТРН = Объект.ДокументСВ;
	Если ЗначениеЗаполнено(ДокЭТРН) Тогда 
		ДокЭТРНОбъект = ДокЭТРН.ПолучитьОбъект();
		ДокЭТРНОбъект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Объект.ДокументОснование)
		И (ЗавершениеРаботы = Неопределено Или Не ЗавершениеРаботы) Тогда
		
		УдалитьЭТРН();
	КонецЕсли;
	
КонецПроцедуры

