
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Элементы.ТоварыХарактеристика.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
												И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики") = Истина;
	
	ОбновитьДанныеФормы();
	
	ЗаполнитьПредставлениеРеквизитовДокументаОснования();
	
	РазблокироватьДанныеФормыДляРедактирования();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	УправлениеЭлементамиФормыВЗависимостиОтСтатуса();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// баги старой платформы при отрисовке сложных группировок:
	// в режиме интерфейса 8.2 отображаем в режиме "на отдельных закладках" шапку и тч
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда 
		ШапкаНаОтдельнойЗакладке = Истина;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаШапка;
		элементы.Группа16.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;

	УправлениеВидимостьюИДоступностью(); // в будущем завернуть на проверить документ
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" 
		И 	(Параметр = Объект.Ссылка 
				ИЛИ
			(Параметр <> Неопределено 
			И ТипЗнч(Параметр) = Тип("Массив") 
			И Параметр.Найти(Объект.Ссылка) <> Неопределено)) Тогда 
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ЗаполнитьТребуемыеДействияТоваров();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПоДокОснованию(Команда)
	
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить("Да, и СВ и Титул");
	СписокКнопок.Добавить("Да, только Титул");
	СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Действие полностью перезаполнит документ по Основанию. Вы АБСОЛЮТНО уверены?",
		СписокКнопок,
		"Подтвердите операцию",
		,
		ЭтаФорма,
		"ОбработчикСогласияПерезаполнения");
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработчикСогласияПерезаполнения(Ответ, ДопПараметр = Неопределено) Экспорт
	
	Если Ответ = "Да, и СВ и Титул" Тогда 
		ПерезаполнитьПоДокОснованиюСервер(Истина);
		ОбновитьДанныеФормы();
	ИначеЕсли Ответ = "Да, только Титул" Тогда
		ПерезаполнитьПоДокОснованиюСервер(Ложь);
		ОбновитьДанныеФормы();
	КонецЕсли;
	
	ОбновитьОтображениеДанных();
	ПолностьюОбновитьПредставлениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипТитулаПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	ПроверитьДокумент();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.ДокументСВ, Истина);
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда 
		ПерешелВЛогистическиеСтатус = Истина;
	Иначе
		ПерешелВЛогистическиеСтатус = Ложь;
	КонецЕсли;
	Элементы.ТекущийСтатус.Видимость = Не ПерешелВЛогистическиеСтатус;
	Элементы.ТекущийСтатусДокументооборота.Видимость = ПерешелВЛогистическиеСтатус;
	
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Повторно выполнить задачу";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Переотправить неподписанный (черновик)";
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Выполнить задачу";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Отправить неподписанный (черновик)";
	КонецЕсли;

	ЭтоВходящий = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен;
	ЕстьДокУчСист = ЗначениеЗаполнено(Объект.ДокументОснование);
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = ЭтоВходящий И Не ЕстьДокУчСист;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	Элементы.ПерезаполнитьПоДокОснованию.Видимость = НЕ ЭтоВходящий И ЕстьДокУчСист;
	Элементы.ОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = НЕ ЕстьДокУчСист;
	Элементы.ПользовательПодписант.Видимость = НЕ ЭтоВходящий;
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(Объект.Ссылка, Объект.ДокументОснование, Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер(ПерезаполнятьЭТРН = Ложь)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		Объект.Товары.Очистить();
		Объект.Маркировки.Очистить();
		Объект.ОпасныеГрузы.Очистить();
		Объект.Контейнеры.Очистить();
		Объект.ДополнительныеВодители.Очистить();
		
		ДокОбъект = РеквизитФормыВЗначение("Объект");
		ДокОбъект.Заполнить(Новый Структура("ДокументОснование, ТипЛогистика, ПерезаполнитьГлавныйДокументЕслиСуществует", ДокОбъект.ДокументОснование, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ПерезаполнятьЭТРН));
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолностьюОбновитьПредставлениеДанных()

	//УстановитьТипыЗначенийРеквизитов(); // TODO
	
	ОповеститьОбИзменении(Объект.ДокументСВ);
	ЗаполнитьПредставлениеРеквизитовДокументаОснования();
	
	ЗаполнитьТребуемыеДействияТоваров();
	ПроверитьДокумент(); // вызовет УправлениеВидимостьюИДоступностью();
	
КонецПроцедуры

// УПРАВЛЕНИЕ ВИДИМОСТЬЮ И ДОСТУПНОСТЬЮ
&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()
	
	УстановитьПоложениеСохраняемыхЭлементов();
	УстановитьФорматыКолонокСКоличеством();

	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	ЭтоВыгрузка = МассивТиповГдеЕстьВыгрузка().Найти(Объект.ТипТитула) <> Неопределено;
	ЭтоПогрузка = МассивТиповГдеЕстьПогрузка().Найти(Объект.ТипТитула) <> Неопределено;
	
	Элементы.ГруппаДатаВыгрузки.Видимость = ЭтоВыгрузка;
	Элементы.ГруппаДатаПогрузки.Видимость = ЭтоПогрузка;
	
	Элементы.ГруппаВыгрузка.Видимость = ЭтоВыгрузка;
	Элементы.ГруппаПогрузка.Видимость = ЭтоПогрузка;
	
	// TODO уточнить видимость когда ФНС нормально напишет чего имела в виду
	//Элементы.КонтейнерыДатВрСдПгр.Видимость = ЭтоВыгрузка;
	//Элементы.КонтейнерыДатВрВозврКонт.Видимость = ЭтоПогрузка;
	
КонецПроцедуры

&НаКлиенте
Функция МассивТиповГдеЕстьВыгрузка()

	текМассив = Новый Массив;
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул2"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул5"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул6"));
	
	Возврат текМассив;
	
КонецФункции

&НаКлиенте
Функция МассивТиповГдеЕстьПогрузка()

	
	текМассив = Новый Массив;
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул3"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул4"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул7"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул8"));
	текМассив.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул9"));
	
	Возврат текМассив;
	
КонецФункции

&НаКлиенте
Процедура УстановитьФорматыКолонокСКоличеством()
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "МассаКонтейнеровБрутто", Элементы.ТоварыМассаКонтейнеровБрутто);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "ПлановаяМассаГрузаБрутто", Элементы.ТоварыПлановаяМассаГрузаБрутто);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "КоличествоМест", Элементы.ТоварыКоличествоМест);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "Плотность", Элементы.ТоварыПлотность);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеСохраняемыхЭлементов()
	
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	УстановитьПоложениеШапки();
	УстановитьСвернутостьПодробностейОТоварах();

КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормыВЗависимостиОтСтатуса()
	
	СтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	
	Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик 
		Или (СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка И ЗначениеЗаполнено(Объект.ДокументСВ.УИД)) Тогда
		
		ТолькоПросмотр = Ложь;
		Элементы.ГруппаИсправление.Видимость = Объект.НомИспр > 0;
		Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
			Элементы.ВнестиИсправлениеТитула.Видимость = Ложь;
		КонецЕсли;
		
	Иначе
		
		ТолькоПросмотр = Истина;
		Элементы.ГруппаИсправление.Видимость = Истина;
		Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
			Элементы.ВнестиИсправлениеТитула.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Управление положением подробных сведений о товаре

&НаКлиенте
Процедура СвернутьПодробныеСведенияНажатие(Элемент)
	
	СкрытьПодробностиТоваров = Истина;
	УстановитьСвернутостьПодробностейОТоварах();
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаРазвернутьПодробностиТоваровНажатие(Элемент)
	
	СкрытьПодробностиТоваров = Ложь;
	УстановитьСвернутостьПодробностейОТоварах();
	
КонецПроцедуры

// Вспомогательные для Обработчики команд

&НаКлиенте
Процедура УстановитьСвернутостьПодробностейОТоварах()
	
	Элементы.ГруппаПодробныеСведенияСвернутая.Видимость = СкрытьПодробностиТоваров;
	Элементы.ГруппаПодробныеСведения.Видимость = НЕ Элементы.ГруппаПодробныеСведенияСвернутая.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	ОтборСтрок = Неопределено;
	
	Если Не Элемент.ТекущиеДанные = Неопределено Тогда  
		
		ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиТоваров", Элемент.ТекущиеДанные.ИдентификаторСтроки);	
		
	КонецЕсли;	
					
	Элементы.Маркировки.ОтборСтрок 			= ОтборСтрок;
	Элементы.ОпасныеГрузы.ОтборСтрок 		= ОтборСтрок;					
					
	КонтурЛогистика_ПанельОшибокКлиент.УстановитьОтборТаблицыОшибокПоНомеруСтроки(ТаблицаОшибок, Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура СвернутьШапку(Команда)
	
	ШапкаНаОтдельнойЗакладке = Истина;
	УстановитьПоложениеШапки();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьШапку(Команда)
	
	ШапкаНаОтдельнойЗакладке = Ложь;
	УстановитьПоложениеШапки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеШапки()
	
	Если ШапкаНаОтдельнойЗакладке Тогда
		
		текАктивнаяЗакладка = Элементы.Страницы.ТекущаяСтраница;
		
		ПереместитьШапкуВызовСервера();
		//Элементы.Переместить(Элементы.ГруппаШапкаЛево, Элементы.СтраницаШапка);
		Элементы.СвернутьШапку.Видимость = Ложь;
		Элементы.РазвернутьШапку.Видимость = Истина;
		
		ПанельОшибокРазвернута = Элементы.ПанельОшибок.РастягиватьПоВертикали;
		Если Не ПанельОшибокРазвернута Тогда 
			ПанельОшибокСвернутьРазвернутьВызовОМ();
		КонецЕсли;
		                                             
		Элементы.Страницы.ТекущаяСтраница = текАктивнаяЗакладка;
		
	Иначе
		
		ПереместитьШапкуВызовСервера();
		//Элементы.Переместить(Элементы.ГруппаШапкаЛево, Элементы.ГруппаШапкаМестоположение);
		Элементы.СвернутьШапку.Видимость = Истина;
		Элементы.РазвернутьШапку.Видимость = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПереместитьШапкуВызовСервера()
	
	Если ШапкаНаОтдельнойЗакладке Тогда
		КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(ЭтаФорма, Элементы.ГруппаШапкаДанные, Элементы.СтраницаШапка);
	Иначе
		КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(ЭтаФорма, Элементы.ГруппаШапкаДанные, Элементы.ГруппаШапкаМестоположение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СделатьНесопоставленныеНеУчитываемыми(Команда)
	
	НесопоставленныеСтроки = Объект.Товары.НайтиСтроки(
		Новый Структура("КоличествоМест,МассаКонтейнеровБрутто,ОтгрузочноеНаименование,Учитывать", 
			0,
			0,
			"",
			Истина)
		);
	Если НесопоставленныеСтроки.Количество() > 0 Тогда
			
		Для Каждого текСтр Из НесопоставленныеСтроки Цикл
			СделатьСтрокуТовараНеучитываемой(текСтр);
		КонецЦикла;
		
		ПолностьюОбновитьПредставлениеДанных();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьСтрокуТовараНеучитываемой(Знач ТекДанныеТоваров)
	
	СделатьНоменклатуруНеучитываемой(ТекДанныеТоваров.Номенклатура, ТекДанныеТоваров.УпаковкаЕдиницаИзмерения);
	
	// эта номенклатура может быть еще в других строках
	// требуется переконвертировать все строки с этой номенклатурой
	МассивСтрокСЭтойНоменклатурой = Объект.ТоварыДокумента1С.НайтиСтроки(Новый Структура("Номенклатура", ТекДанныеТоваров.Номенклатура));
	
	Для Каждого СтрокаПереконвертации Из МассивСтрокСЭтойНоменклатурой Цикл
		
		СконвертироватьСтрокуТоваровКлиент(СтрокаПереконвертации.ПолучитьИдентификатор());
		
	КонецЦикла;
	
КонецПроцедуры

