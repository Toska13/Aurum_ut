    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	КонтурЛогистика_ЗН_Титул1.Ссылка КАК Ссылка,
	КонтурЛогистика_ЗН_Титул1.ДокументОснование КАК ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка КАК ФайлОбмена
ИЗ
	Документ.КонтурЛогистика_ЗН_Титул1 КАК КонтурЛогистика_ЗН_Титул1
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_ЗН_Титул1.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_ЗН_Титул1.ПометкаУдаления
	И КонтурЛогистика_ЗН_Титул1.ДокументЗН = &amp;ГлавныйДокумент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_ЗН_Титул2.Ссылка,
	КонтурЛогистика_ЗН_Титул2.ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка
ИЗ
	Документ.КонтурЛогистика_ЗН_Титул2 КАК КонтурЛогистика_ЗН_Титул2
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_ЗН_Титул2.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_ЗН_Титул2.ПометкаУдаления
	И КонтурЛогистика_ЗН_Титул2.ДокументЗН = &amp;ГлавныйДокумент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_ЗН_Титул3.Ссылка,
	КонтурЛогистика_ЗН_Титул3.ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка
ИЗ
	Документ.КонтурЛогистика_ЗН_Титул3 КАК КонтурЛогистика_ЗН_Титул3
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_ЗН_Титул3.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_ЗН_Титул3.ПометкаУдаления
	И КонтурЛогистика_ЗН_Титул3.ДокументЗН = &amp;ГлавныйДокумент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_ЗН_Титул4.Ссылка,
	КонтурЛогистика_ЗН_Титул4.ДокументОснование,
	КонтурЛогистика_ФайлыОбмена.Ссылка
ИЗ
	Документ.КонтурЛогистика_ЗН_Титул4 КАК КонтурЛогистика_ЗН_Титул4
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		ПО КонтурЛогистика_ЗН_Титул4.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
ГДЕ
	НЕ КонтурЛогистика_ЗН_Титул4.ПометкаУдаления
	И КонтурЛогистика_ЗН_Титул4.ДокументЗН = &amp;ГлавныйДокумент</queryText>
