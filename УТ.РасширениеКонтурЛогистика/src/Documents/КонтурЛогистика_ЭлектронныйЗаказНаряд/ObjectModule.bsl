#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда 
		
		ТипДокумента = ДанныеЗаполнения.ТипДокумента;
		
		ТекстФайла = ДанныеЗаполнения.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ДанныеЗаполнения + " нет текста титула");
			Возврат;
		КонецЕсли;
		
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда 
			
			СодЗНИнфФт 	= XDTO.Документ.СодЗНИнфФт;
			
			УИД 	= КС.XDTO_Вычислить(СодЗНИнфФт, "УИД_ЗН");
			
			НомерЗН 	= КС.XDTO_ПолучитьЗначениеСвойства(СодЗНИнфФт, "НомерЗН");
			ДатаЗН_raw = КС.XDTO_ПолучитьЗначениеСвойства(СодЗНИнфФт, "ДатаЗН");
			ДатаЗН     = КС.Конвертировать_ДатаТип_вДата(ДатаЗН_raw);
			
			//TODO не умеем конвертить СвФт УчастникЗНФЛТип и УчастникЗНЮЛТип
			Фрахтователь 	= КС.Конвертировать_УчастникЗН_вОрганизациюДиадок(КС.XDTO_ПолучитьЗначениеСвойства(СодЗНИнфФт, "СвФт"));
			Фрахтовщик 		= ДанныеЗаполнения.Получатель;
			
			ФрахтовательПодразделение = ДанныеЗаполнения.ОтправительПодразделение;
			ФрахтовщикПодразделение = ДанныеЗаполнения.ПолучательПодразделение;
			
			МестоПодачи  			= КС.Конвертировать_АдресПользТип_вПунктМаршрутаЛогистика(КС.XDTO_ПолучитьЗначениеСвойства(СодЗНИнфФт.СвМршПодТС, "АдрМесПодТС"));
			МаршрутДатВрПодТСRAW	= КС.XDTO_Вычислить(СодЗНИнфФт, "СвМршПодТС.ДатВрПодТС");
			Если ЗначениеЗаполнено(МаршрутДатВрПодТСRAW) Тогда 
            	МаршрутДатВрПодТС	= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(МаршрутДатВрПодТСRAW);
			КонецЕсли;
			
			Маршрут					= КС.XDTO_Вычислить(СодЗНИнфФт, "СвМршПодТС.МршПрвз.МршТекст");
			МаршрутМашиночитаемый 	= КС.XDTO_Вычислить(СодЗНИнфФт, "СвМршПодТС.МршПрвз.МршМашЧит");
			
			СрокВыполненияПеревозки	= КС.XDTO_Вычислить(СодЗНИнфФт, "СвСрокВыпПрвз");
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда 
			
		Иначе
			 Сообщить("Обработка заполнения Документа ЭТРН из " + ТипДокумента + " не поддерживается");
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли