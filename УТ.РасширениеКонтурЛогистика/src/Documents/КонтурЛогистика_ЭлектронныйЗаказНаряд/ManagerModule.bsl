// Допроверяет то что не проверено вызовом МассивОбязательныхРеквизитов
Процедура ПроверитьКлючевыеРеквизиты(ДокЗНСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	
	// ИНН
	Если Не ЗначениеЗаполнено(ДокЗНСсылка.Фрахтователь.ИНН) Тогда 
	
		ТекстОшибки = "Укажите в Фрахтователе ИНН (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтователь.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не ЗначениеЗаполнено(ДокЗНСсылка.Фрахтовщик.ИНН) Тогда 
	
		ТекстОшибки = "Укажите в Фрахтовщике ИНН (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтовщик.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	// НаименованиеОрганизацииПолное
	Если Не ЗначениеЗаполнено(ДокЗНСсылка.Фрахтователь.НаименованиеОрганизацииПолное) Тогда 
	
		ТекстОшибки = "Укажите в Фрахтователь Полное наименование (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтователь.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не ЗначениеЗаполнено(ДокЗНСсылка.Фрахтовщик.НаименованиеОрганизацииПолное) Тогда 
	
		ТекстОшибки = "Укажите в Фрахтовщик Полное наименование (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтовщик.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	// Телефоны
	
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЗНСсылка.Фрахтователь) Тогда 
	
		ТекстОшибки = "Укажите Телефон Фрахтователь";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтователь.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(ДокЗНСсылка.Фрахтовщик) Тогда 
	
		ТекстОшибки = "Укажите Телефон Фрахтовщик";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтовщик.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	// ИдентификаторУчастникаЭДО
	Если Не ЗначениеЗаполнено(ДокЗНСсылка.Фрахтователь.ИдентификаторУчастникаЭДО) Тогда 
	
		ТекстОшибки = "Укажите в Фрахтователь Идентификатор участника ЭДО (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтователь.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;			
			
	Если Не ЗначениеЗаполнено(ДокЗНСсылка.Фрахтовщик.ИдентификаторУчастникаЭДО) Тогда 
	
		ТекстОшибки = "Укажите в Фрахтовщик Идентификатор участника ЭДО (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.Фрахтовщик.ИдентификаторУчастникаЭДО", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
		
	// Откуда везем
	МестоПодачи = ДокЗНСсылка.МестоПодачи;	
	Если Не ЗначениеЗаполнено(МестоПодачи.КодГАР) 
		И (Не ЗначениеЗаполнено(МестоПодачи.АдресИнфАдрес) 
			ИЛИ Не ЗначениеЗаполнено(МестоПодачи.АдресИнфКодСтраны))
		И (Не ЗначениеЗаполнено(МестоПодачи.АдресИндекс) 
			ИЛИ Не ЗначениеЗаполнено(МестоПодачи.АдресКодРегион)) Тогда 
	
		ТекстОшибки = "Укажите Адрес в Месте подачи (в Документе электронного Заказ-Наряда)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ГлавныйДокумент.МестоПодачи.АдресИнфАдрес", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПоследнийПоДатеТитул(ДокЗНСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ЗН_Титул1.Дата КАК Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул1 КАК КонтурЛогистика_ЗН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул1.ДокументЗН = &ДокументЗН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗН_Титул2.Ссылка,
	|	КонтурЛогистика_ЗН_Титул2.Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул2 КАК КонтурЛогистика_ЗН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул2.ДокументЗН = &ДокументЗН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗН_Титул3.Ссылка,
	|	КонтурЛогистика_ЗН_Титул3.Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул3 КАК КонтурЛогистика_ЗН_Титул3
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул3.ДокументЗН = &ДокументЗН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗН_Титул4.Ссылка,
	|	КонтурЛогистика_ЗН_Титул4.Дата
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул4 КАК КонтурЛогистика_ЗН_Титул4
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул4.ДокументЗН = &ДокументЗН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументЗН", ДокЗНСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
	
		Возврат Выборка.Ссылка;
		
	Иначе
		
		Возврат Неопределено;
	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСледующийПоЦепочкеТипТитулаЗН(ДокЗНСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокЗНСсылка) Тогда 
		ВызватьИсключение "Не заполнен ЗН - не могу определить титул";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2) КАК ТипТитула
	|ПОМЕСТИТЬ ВТ_ВсеТитулыЗН
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул1 КАК КонтурЛогистика_ЗН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул1.ДокументЗН = &ДокументЗН
	|	И НЕ КонтурЛогистика_ЗН_Титул1.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3)
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул2 КАК КонтурЛогистика_ЗН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул2.ДокументЗН = &ДокументЗН
	|	И НЕ КонтурЛогистика_ЗН_Титул2.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4)
	|ИЗ
	|	Документ.КонтурЛогистика_ЗН_Титул3 КАК КонтурЛогистика_ЗН_Титул3
	|ГДЕ
	|	КонтурЛогистика_ЗН_Титул3.ДокументЗН = &ДокументЗН
	|	И НЕ КонтурЛогистика_ЗН_Титул3.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеТитулыЗН.ТипТитула КАК ТипТитула
	|ИЗ
	|	ВТ_ВсеТитулыЗН КАК ВТ_ВсеТитулыЗН
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипТитула УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументЗН", ДокЗНСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ТипТитула;
	Иначе
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1;
	КонецЕсли;
	
КонецФункции

#КонецЕсли