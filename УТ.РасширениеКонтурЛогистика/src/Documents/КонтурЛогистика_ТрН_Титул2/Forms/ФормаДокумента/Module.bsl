	СтандартнаяОбработка = Ложь;
	
	Если Не Модифицированность Тогда
		Закрыть();
	КонецЕсли;
	
	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2");
	ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1"),
		Объект.ДокументЭТРН);
	ДопПараметрыДействия = Новый Структура;
	
	КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаИзПредыдущегоТитула(
		ТипЛогистика, ПредыдущийТитул, ЭтаФорма, ДопПараметрыДействия);
	
