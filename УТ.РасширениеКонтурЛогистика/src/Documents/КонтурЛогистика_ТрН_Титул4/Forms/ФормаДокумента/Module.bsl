&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ОбновитьДанныеФормы();

	Элементы.ДокументОснование.Доступность = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТипыДокументаОснованияНастроеныДляТитула(4);
	
	ЭлементыДляРазрешенияРедактирования = Новый Массив;
	ЭлементыДляРазрешенияРедактирования.Добавить("Группа2");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка, ЭлементыДляРазрешенияРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеВидимостьюИДоступностью();
	ПроверитьДокумент();
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И Параметр = Объект.Ссылка Тогда 
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// ОбновитьДанныеФормы();
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьОткрытыеТитулы" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьОбъект(Команда)
	
	ОбработчикПеречитатьОбъект();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()
	
	ЭтаФорма.Прочитать();
	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()

	ОбновитьДанныеФормы();
	ПроверитьДокумент();
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(ЭтаФорма, Объект.ДокументОснование);
	УправлениеКолбасойТитуловВызовСервера();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеКолбасойТитуловВызовСервера()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УправлениеСтатусомПодписиИКолбасойТитулов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()
	
	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.ДокументЭТРН, Истина);
	ТекущийСтатусОсобенностиДокументооборота = РегистрыСведений.КонтурЛогистика_ОсобенностиДокументооборота.ПолучитьОсобенность(Объект.ДокументЭТРН);
	КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Объект.Ссылка);
	
	Если Не ЗначениеЗаполнено(ТекущийСтатусОсобенностиДокументооборота) Тогда
		Элементы.ТекущийСтатусОсобенностиДокументооборота.Видимость = Ложь;
	КонецЕсли;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Заголовок = "Повторно подписать и отправить";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Переотправить неподписанный (черновик)";
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Заголовок = "Подписать и отправить";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Отправить неподписанный (черновик)";
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(Объект.Ссылка, Объект.ДокументОснование ,Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
		ИЛИ (ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен И Справочники.КонтурЛогистика_ФайлыОбмена.ЭтоВходящийНеподписанный(КрайнийФайл))
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
		ТолькоПросмотр = Ложь;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
		ТолькоПросмотр = Истина;
	КонецЕсли;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	УстановитьДоступностьКоманд(Не ТолькоПросмотр);
	
	НайденныйТитул7 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7, Объект.ДокументЭТРН);
	Если ЗначениеЗаполнено(НайденныйТитул7) и НайденныйТитул7.НовГрузПол <> Объект.ДокументЭТРН.Грузополучатель Тогда 
		НовыйГрузополучательВидим = Истина;
	Иначе
		НовыйГрузополучательВидим = Ложь;
	КонецЕсли;
	Элементы.ГруппаДругойГрузополучатель.Видимость 	= НовыйГрузополучательВидим;

	Титул1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, Объект.ДокументЭТРН);
	Титул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2, Объект.ДокументЭТРН);
	Титул3 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3, Объект.ДокументЭТРН);
	ЗаполинтьДатыРазгрузки();
	
	Т1Мест = Титул1.КоличествоМест;
	Т1МассаБрутто = Титул1.МассаБруттоКг;
	Т3Мест = Титул3.КоличествоМестПринято;
	Т3МассаБрутто = Титул3.МассаБруттоКг;
	Т3ПричинаОтказа = Титул3.ПричОтк;
	Т3СостояниеГруза = Титул3.ОбщееСостояние;
	Т3ГрузыУказаны = Титул3.Товары.Количество() > 0;
	
	ЗначениеМестПринято = "" + Т3Мест + " из " + Т1Мест;
	ЗначениеМассаПринято = "" + Т3МассаБрутто + " из " + Т1МассаБрутто + " кг";
	ОтказВПриемке = Титул3.ОтказВПриемке; 
	ПринятьЧастично = Титул3.ПринятьЧастично;
	
	Элементы.Титул3ОтказВПриемке.Видимость 		= ОтказВПриемке;
	Элементы.Т3ПричинаОтказа.Видимость 			= ОтказВПриемке;
	Элементы.ГруппаЧастично.Видимость 			= ПринятьЧастично;
	Элементы.Титул3ПринятьЧастично.Видимость 	= ПринятьЧастично;
	Элементы.ДекорацияПринятПолностью.Видимость = Не ПринятьЧастично и Не ОтказВПриемке;
	Элементы.Т3ГрузыНеУказаныГП.Видимость       = Не Т3ГрузыУказаны;
	Элементы.Титул3Товары.Видимость       		= Т3ГрузыУказаны;
		
	ЭтоЭкспедиция	= Объект.ДокументЭТРН.ЭтоЭкспедиция;
	ЭкспедицияЗаказчик	= Объект.ДокументЭТРН.ЭкспедицияЗаказчик;
	ЕстьЗамечанияВодителяИзТ2 = ЗначениеЗаполнено(Титул2.ЗамечанияВодителя);
	ЕстьОтметкиГП			= Титул3.ОтметкиГрузополучателя.Количество() > 0;	
	
	Титул8ЗаменаВодителя = Документы.КонтурЛогистика_ТрН_Титул8.ПоследняяЗамена(Объект.ДокументЭТРН, "НовыеВодители");
	
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);
	
	Если ЗначениеЗаполнено(Титул8ЗаменаВодителя) Тогда 
		ВодительНаВыгрузке = Титул8ЗаменаВодителя.НовыеВодители[0].Водитель;
	Иначе
		ВодительНаВыгрузке = Титул1.Водитель;
	КонецЕсли;
	
	Если ТекущийСтатусДокументооборота = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НайтиСостояниеДОПоКоду("d-wait-carrier-sign") Тогда 
		ВодительУжеСогласовал = Истина;
	ИначеЕсли ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		ВодительУжеСогласовал = Истина;
	Иначе
		ВодительУжеСогласовал = Ложь;
	КонецЕсли;
	
	Элементы.НадписьНеСогласовал.Видимость  = Не ВодительУжеСогласовал;
	Если ЗначениеЗаполнено(Объект.ЗамечанияВодителя) Тогда
		Элементы.НадписьБезЗамечаний.Видимость 	= Ложь;
	Иначе
		Если ВодительУжеСогласовал Тогда 
			Элементы.НадписьБезЗамечаний.Видимость 	= Истина;
		Иначе
			Элементы.НадписьБезЗамечаний.Видимость 	= Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ВсеПереадресации = Документы.КонтурЛогистика_ТрН_Титул7.ВсеПереадресации(Объект.ДокументЭТРН);
	ПерадресацииИВозвраты.Загрузить(ВсеПереадресации);
	
	ВсеЗамены = Документы.КонтурЛогистика_ТрН_Титул8.ВсеЗамены(Объект.ДокументЭТРН);
	ЗаменыВодителейТС.Загрузить(ВсеЗамены);
	
	Для Каждого Замена Из ЗаменыВодителейТС Цикл 
		Замена.ЕстьЗаменаВодителя 	= Замена.Ссылка.НовыеВодители.Количество();
		Замена.ЕстьЗаменаТС 		= Замена.Ссылка.НовыеТранспортныеСредства.Количество();
		Замена.ЕстьЗаменаПрицепа 	= Замена.Ссылка.НовыеПрицепы.Количество();
	КонецЦикла;
	
	ЕстьПрицеп2 = ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп2);
	ЕстьПрицеп = ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп);
	ПогрузкуОсуществляет = Объект.ДокументЭТРН.ПогрузкуОсуществляет;
	Грузоотправитель	 = Объект.ДокументЭТРН.Грузоотправитель;
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы.Видимость = СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКоманд(Доступность)
	
	УстановитьДоступностьЭлемента("ФормаЗаписать", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СформироватьФайлыОбмена", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителю", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПропуститьДокумент", Доступность);
	УстановитьДоступностьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОбработатьВходящийДокумент", Доступность);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлемента(ИмяЭлемента, Доступность)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйЭлемент.Доступность = Доступность;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьЗаголовкиКоличества(Форма)
	
	КоличествоСтрок = 0;
	
	Для Каждого ТекущаяСтрока Из Форма.Титул1.Товары Цикл
		
		Если Не ТекущаяСтрока.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоСтрок = КоличествоСтрок + 1;
		
	КонецЦикла;
	
	Форма.Элементы.ГруппаТоварыИзТ1.Заголовок = "Грузы при оформлении (" + КоличествоСтрок + ")";
	
	КоличествоСтрок = 0;
	
	Для Каждого ТекущаяСтрока Из Форма.Титул3.Товары Цикл
		
		Если Не ТекущаяСтрока.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоСтрок = КоличествоСтрок + 1;
		
	КонецЦикла;
	
	Форма.Элементы.ГруппаТоварыИзТ3.Заголовок = "Грузы на приемке (" + КоличествоСтрок + ")";


КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()
	
	ЭтоВходящий = ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен");
	ЭтоЧерновик = ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик");
	ЭтоИсправлениеОшибки = ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка");
	
	Элементы.ГруппаОтметкиНадпись.Видимость = ЭтоВходящий ИЛИ Не ЭтоЧерновик;
	Элементы.ГруппаОтметкиТумблер1.Видимость = ЭтоЧерновик ИЛИ ЭтоИсправлениеОшибки;
	
	Элементы.ГруппаЗамечанияПеревозчика.Видимость = Объект.ЕстьЗамечанияПеревозчика;
	Элементы.ГруппаОтметкиПеревозчика.Видимость = Объект.ЕстьОтметкиПеревозчика;
	Элементы.ГруппаАкты.Видимость = Объект.ЕстьОтметкиПеревозчика;
	Элементы.ГруппаШтрафы.Видимость = Объект.ЕстьОтметкиПеревозчика;
	Элементы.ГруппаИнфПол.Видимость = Объект.ЕстьОтметкиПеревозчика;
	Элементы.ГруппаПрицеп2.Видимость = ЕстьПрицеп2;
	Элементы.ГруппаПрицеп.Видимость = ЕстьПрицеп;
	Элементы.ДокументЭТРНПогрузкуОсуществляет.Видимость = ЗначениеЗаполнено(ПогрузкуОсуществляет) И ПогрузкуОсуществляет <> Грузоотправитель;
	
	Элементы.ВодительСтрока.Видимость 		= ЗначениеЗаполнено(Объект.ВодительСтрока);
	Элементы.ЗамечанияВодителя.Видимость 	= ЗначениеЗаполнено(Объект.ЗамечанияВодителя);
	
	Элементы.ЗамечанияВодителяИзТ2.Видимость 	= ЕстьЗамечанияВодителяИзТ2;
	Элементы.НадписьБезЗамечанийИзТ2.Видимость 	= Не ЕстьЗамечанияВодителяИзТ2;
	
	Элементы.ГруппаПодписьПеревозчика.Видимость = ЗначениеЗаполнено(Объект.Фамилия);

	Элементы.ГруппаЭкспедиция.Видимость = ЭтоЭкспедиция;
	Элементы.СтраницаОтметкиГП.Видимость 			= ЕстьОтметкиГП;
	
	Элементы.СтраницаПереадресации.Видимость 		= ЗначениеЗаполнено(ПерадресацииИВозвраты);
	Элементы.СтраницаЗаменыВодителейТС.Видимость 	= ЗначениеЗаполнено(ЗаменыВодителейТС);
	
	Элементы.ГруппаИсправление.Видимость = Объект.НомИспрГП > 0;
	
	УстановитьЗаголовкиГруппамДопПолей();
	
КонецПроцедуры

