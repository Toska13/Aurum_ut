
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ОбновитьДанныеФормы();

	Элементы.ДокументОснование.Доступность = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТипыДокументаОснованияНастроеныДляТитула(6);
	
	ЭлементыДляРазрешенияРедактирования = Новый Массив;
	ЭлементыДляРазрешенияРедактирования.Добавить("Группа2");
	ЭлементыДляРазрешенияРедактирования.Добавить("ГруппаПодписьПеревозчика");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка, ЭлементыДляРазрешенияРедактирования);
	
	ТумблерЗаполненИД 		= ЗначениеЗаполнено(Объект.ИдДокОснДовОргСост);
	ТумблерЗаполненИДПлат 	= ЗначениеЗаполнено(Объект.ИдДокОснИнПлат);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ПроверитьДокумент();
	ПоказатьСкрытьГруппы(ЭтаФорма);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И Параметр = Объект.Ссылка Тогда 
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// ОбновитьДанныеФормы();
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьОткрытыеТитулы" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьОбъект(Команда)
	
	ОбработчикПеречитатьОбъект();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()
	
	ЭтаФорма.Прочитать();
	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()

	ОбновитьДанныеФормы();
	ПроверитьДокумент();
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(ЭтаФорма, Объект.ДокументОснование);
	УправлениеКолбасойТитуловВызовСервера();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеКолбасойТитуловВызовСервера()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УправлениеСтатусомПодписиИКолбасойТитулов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()
	
	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.ДокументЭТРН, Истина);
	
	ПерешелВЛогистическиеСтатус = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена;
	Элементы.ТекущийСтатус.Видимость = Не ПерешелВЛогистическиеСтатус;
	Элементы.ТекущийСтатусДокументооборота.Видимость = ПерешелВЛогистическиеСтатус;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Заголовок = "Повторно подписать и отправить";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Переотправить неподписанный (черновик)";
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Заголовок = "Подписать и отправить";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Отправить неподписанный (черновик)";
	КонецЕсли;

	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(Объект.Ссылка, Объект.ДокументОснование ,Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка 
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
		ТолькоПросмотр = Ложь;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
		ТолькоПросмотр = Истина;
	КонецЕсли;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	Титул1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, Объект.ДокументЭТРН);
	Титул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2, Объект.ДокументЭТРН);
	Титул3 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3, Объект.ДокументЭТРН);
	Титул4 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4, Объект.ДокументЭТРН);
	Титул5 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5, Объект.ДокументЭТРН);
	
	Титул8ЗаменаВодителя = Документы.КонтурЛогистика_ТрН_Титул8.ПоследняяЗамена(Объект.ДокументЭТРН, "НовыеВодители");
	
	Если ЗначениеЗаполнено(Титул8ЗаменаВодителя) Тогда 
		ВодительНаВыгрузке = Титул8ЗаменаВодителя.НовыеВодители[0].Водитель;
	Иначе
		ВодительНаВыгрузке = Титул1.Водитель;
	КонецЕсли;
	
	СтавкаРавнаБезНДС = Титул5.СтавкаНДС = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.БезНДС")
						Или Титул5.СтавкаНДС = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтавкиНДС.НДС0");
	
	ПрицепВЭТрНеУказан = ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп);
	Прицеп2ВЭТрНеУказан = ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп2);
	
	ВсеПереадресации = Документы.КонтурЛогистика_ТрН_Титул7.ВсеПереадресации(Объект.ДокументЭТРН);
	ПерадресацииИВозвраты.Загрузить(ВсеПереадресации);
	
	ВсеЗамены = Документы.КонтурЛогистика_ТрН_Титул8.ВсеЗамены(Объект.ДокументЭТРН);
	ЗаменаВодителейТС.Загрузить(ВсеЗамены);
	
	Для Каждого Замена Из ЗаменаВодителейТС Цикл 
		Замена.ЕстьЗаменаВодителя 	= Замена.Ссылка.НовыеВодители.Количество();
		Замена.ЕстьЗаменаТС 		= Замена.Ссылка.НовыеТранспортныеСредства.Количество();
		Замена.ЕстьЗаменаПрицепа 	= Замена.Ссылка.НовыеПрицепы.Количество();
	КонецЦикла;
	
	ВсеОтметки = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ВсеОтметкиПоЭТрН(Объект.ДокументЭТРН);
	Отметки.Загрузить(ВсеОтметки);
	
	ВсеАкты = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ВсеАктыПоЭТрН(Объект.ДокументЭТРН);
	Акты.Загрузить(ВсеАкты);
	
	ВсеШтрафы = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ВсеШтрафыПоЭТрН(Объект.ДокументЭТРН);
	Штрафы.Загрузить(ВсеШтрафы);
	
	ДатаПрибытияПогрПВ 	= ?(ЗначениеЗаполнено(Титул2.ЗамДатВрПриб), Титул2.ЗамДатВрПриб, "не указал");
	ДатаПостПогрПВ 		= ?(ЗначениеЗаполнено(Титул2.ЗамДатВрПосПрием), Титул2.ЗамДатВрПосПрием, "не указал");
	ДатаУбытияПогрПВ 	= ?(ЗначениеЗаполнено(Титул2.ЗамДатВрУбыт), Титул2.ЗамДатВрУбыт, "не указал");
	
	ДатаПрибытияВыгрПВ 	= ?(ЗначениеЗаполнено(Титул4.ЗамДатВрПриб), Титул4.ЗамДатВрПриб, "не указал");
	ДатаПостВыгрПВ 		= ?(ЗначениеЗаполнено(Титул4.ЗамДатВрПосВыгр), Титул4.ЗамДатВрПосВыгр, "не указал");
	ДатаУбытияВыгрПВ 	= ?(ЗначениеЗаполнено(Титул4.ЗамДатВрУбыт), Титул4.ЗамДатВрУбыт, "не указал");
		
	ДатыПрибытияНаПогрОтличаются 	= ЗначениеЗаполнено(ДатаПрибытияПогрПВ) И ДатаПрибытияПогрПВ <> "не указал" И Титул1.ДатаВремяПрибытия <> ДатаПрибытияПогрПВ;
	ДатыПрибытияНаВыгрОтличаются 	= ЗначениеЗаполнено(ДатаПрибытияВыгрПВ) И ДатаПрибытияВыгрПВ <> "не указал" И Титул3.ФДатВрПриб <> ДатаПрибытияВыгрПВ;
	ДатыУбытияНаПогрОтличаются 		= ЗначениеЗаполнено(ДатаУбытияПогрПВ) И ДатаУбытияПогрПВ <> "не указал" И Титул1.ДатаВремяУбытия <> ДатаУбытияПогрПВ;
	ДатыУбытияНаВыгрОтличаются 		= ЗначениеЗаполнено(ДатаУбытияВыгрПВ) И ДатаУбытияВыгрПВ <> "не указал" И Титул3.ФДатВрУбыт <> ДатаУбытияВыгрПВ;
	
	ЗамечанияВодителяНаПогр = Титул2.ЗамечанияВодителя;
	ЗамечанияВодителяНаВыгр = Титул4.ЗамечанияВодителя;
	
	ЗамечанияПеревозчикаНаПогр = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(Титул2,, Истина);
	ЗамечанияПеревозчикаНаВыгр = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(Титул4, Истина, Истина);
	
	ЭтоЭкспедиция = Объект.ДокументЭТрН.ЭтоЭкспедиция;
	
	// установка заголовков страниц
	
	ЕстьРасхожденияПоМассе 		= Не Титул1.МассаБруттоКг = Титул3.МассаБруттоКг;
	ЕстьРасхожденияПоКоличеству = Не Титул1.КоличествоМест = Титул3.КоличествоМестПринято;
	
	Элементы.ГруппаТоварыИзТ1.Заголовок 			= "Грузы при оформлении (" + Титул1.Товары.Количество() + ")";	
	Элементы.ГруппаТоварыИзТ3.Заголовок 			= "Грузы на приемке (" + Титул3.Товары.Количество() + ")";
	Элементы.СтраницаПереадресации.Заголовок 		= "Переадресации и возвраты (" + ПерадресацииИВозвраты.Количество() + ")";
	Элементы.СтраницаЗаменыВодителейТС.Заголовок 	= "Замены водителей | ТС (" + ЗаменаВодителейТС.Количество() + ")";
	Элементы.СтраницаОтметки.Заголовок 				= "Отметки, Акты, Штрафы (" + Отметки.Количество() + ")";
	
	// заголовок Т3
	
	Элементы.ГруппаТоварыИзТ3.Картинка = БиблиотекаКартинок.КонтурЛогистика_Коробка;
	
	Если ЕстьРасхожденияПоКоличеству Или ЕстьРасхожденияПоМассе Тогда 
		
		Элементы.ГруппаТоварыИзТ3.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
		
		Если ЕстьРасхожденияПоКоличеству И ЕстьРасхожденияПоМассе Тогда 
			Элементы.ГруппаТоварыИзТ3.Заголовок = "Грузы на приемке (" + Титул3.Товары.Количество() + ", есть расхождения по количеству и массе)";
		ИначеЕсли ЕстьРасхожденияПоКоличеству Тогда 
			Элементы.ГруппаТоварыИзТ3.Заголовок = "Грузы на приемке (" + Титул3.Товары.Количество() + ", есть расхождения по количеству)";
		Иначе	
			Элементы.ГруппаТоварыИзТ3.Заголовок = "Грузы на приемке (" + Титул3.Товары.Количество() + ", есть расхождения по массе)";
		КонецЕсли;
		
	КонецЕсли;
	
	Если Элементы.Найти("ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи") <> Неопределено Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи.Видимость = Не ТолькоПросмотр;
	КонецЕсли;
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы.Видимость = СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюИДоступностью(Форма)
	
	Элементы 	= Форма.Элементы;
	Объект 		= Форма.Объект;
	
	ЭтоВходящий 			= Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен");
	ЭтоЧерновик 			= Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик");
	ЭтоИсправлениеОшибки 	= Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка");
	
	Элементы.ГруппаПодписьПеревозчика.Видимость = ЗначениеЗаполнено(Объект.Фамилия);
	
	Элементы.ИдДок.Видимость 			= Форма.ТумблерЗаполненИД;
	Элементы.ГруппаДокумент.Видимость 	= Не Форма.ТумблерЗаполненИД;
	
	
	Элементы.ИдДокПлат.Видимость 			= Форма.ТумблерЗаполненИДПлат;
	Элементы.ГруппаДокументПлат.Видимость 	= Не Форма.ТумблерЗаполненИДПлат;
	
	
	// причина отказа в подписи 
	
	Элементы.ГруппаПричинаОтказаВПодписи.Видимость = (ЭтоВходящий Или Не ЭтоЧерновик) И Объект.ЕстьОтказВПодписи;
	Элементы.НомерСчета.Видимость 	= Не Объект.ЕстьОтказВПодписи;
	Элементы.ГруппаДанныеДопПоля.Видимость 	= Не Объект.ЕстьОтказВПодписи;
	
	Элементы.ГруппаПрицеп.Видимость = Форма.ПрицепВЭТрНеУказан;
	Элементы.ГруппаПрицеп2.Видимость = Форма.Прицеп2ВЭТрНеУказан;
	Элементы.ГруппаЭкспедиция.Видимость = Форма.ЭтоЭкспедиция;
	
	Элементы.СтраницаОтметки.Видимость 				= ЗначениеЗаполнено(Форма.Отметки); 
	Элементы.СтраницаПереадресации.Видимость 		= ЗначениеЗаполнено(Форма.ПерадресацииИВозвраты);
	Элементы.СтраницаЗаменыВодителейТС.Видимость 	= ЗначениеЗаполнено(Форма.ЗаменаВодителейТС);
			
	Элементы.ЗамечанияВодителяВыгр.Видимость 	= ЗначениеЗаполнено(Форма.ЗамечанияВодителяНаВыгр);
	Элементы.БезЗамечВодитВыгр.Видимость 		= Не ЗначениеЗаполнено(Форма.ЗамечанияВодителяНаВыгр);
	Элементы.ЗамечанияПеревозчикаВыгр.Видимость = ЗначениеЗаполнено(Форма.ЗамечанияПеревозчикаНаВыгр);
	Элементы.БезЗамечПВВыгр.Видимость 			= Не ЗначениеЗаполнено(Форма.ЗамечанияПеревозчикаНаВыгр);
	
	Элементы.Титул5СуммаНДС.Видимость 		= Не Форма.СтавкаРавнаБезНДС;
	Элементы.Титул5СтоимостьСНДС.Видимость 	= Не Форма.СтавкаРавнаБезНДС;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьСкрытьГруппы(Форма)
	
	Элементы 	= Форма.Элементы;
	
	// поведение группы "Погрузка"
		
	Если Форма.ДатыПрибытияНаПогрОтличаются Или Форма.ДатыУбытияНаПогрОтличаются Тогда
		Элементы.ГруппаПогрузка.Заголовок 						= "Даты и время";
		Элементы.ГруппаПогрузка.ЗаголовокСвернутогоОтображения 	= "Даты и время - есть расхождения";
		
		Элементы.ВосклицаниеДатыПогр.Видимость = Истина;
		Элементы.ГруппаПогрузка.Показать();
	Иначе
		Элементы.ГруппаПогрузка.Заголовок 						= "Даты и время";
		Элементы.ГруппаПогрузка.ЗаголовокСвернутогоОтображения 	= "Даты и время - расхождений нет";
		
		Элементы.ВосклицаниеДатыПогр.Видимость = Ложь;
		Элементы.ГруппаПогрузка.Скрыть();
	КонецЕсли;
	
	// поведение группы "Выгрузка"
	
	Если Форма.ДатыПрибытияНаВыгрОтличаются Или Форма.ДатыУбытияНаВыгрОтличаются Тогда
		Элементы.ГруппаВыгрузка.Заголовок 						= "Даты и время";
		Элементы.ГруппаВыгрузка.ЗаголовокСвернутогоОтображения 	= "Даты и время - есть расхождения";
		
		Элементы.ВосклицаниеДатыРазг.Видимость = Истина;
		Элементы.ГруппаВыгрузка.Показать();
	Иначе
		Элементы.ГруппаВыгрузка.Заголовок 						= "Даты и время";
		Элементы.ГруппаВыгрузка.ЗаголовокСвернутогоОтображения 	= "Даты и время - расхождений нет";
		
		Элементы.ВосклицаниеДатыРазг.Видимость = Ложь;
		Элементы.ГруппаВыгрузка.Скрыть();
	КонецЕсли;
	
	// поведение группы "ГруппаВодительНаПогрузке"
	
	Если ЗначениеЗаполнено(Форма.ЗамечанияВодителяНаПогр) Или ЗначениеЗаполнено(Форма.ЗамечанияПеревозчикаНаПогр) Тогда
		Элементы.ГруппаВодительНаПогрузке.Заголовок 						= "Водитель и замечания";
		Элементы.ГруппаВодительНаПогрузке.ЗаголовокСвернутогоОтображения 	= "Водитель и замечания - есть замечания";
		
		Элементы.ВосклицаниеЗамечанияПогр.Видимость = Истина;
		Элементы.ГруппаВодительНаПогрузке.Показать();
	Иначе
		Элементы.ГруппаВодительНаПогрузке.Заголовок 						= "Водитель и замечания";
		Элементы.ГруппаВодительНаПогрузке.ЗаголовокСвернутогоОтображения 	= "Водитель и замечания - замечаний нет";
		
		Элементы.ВосклицаниеЗамечанияПогр.Видимость = Ложь;
		Элементы.ГруппаВодительНаПогрузке.Скрыть();
	КонецЕсли;	
	
	Элементы.ЗамечанияВодителяПогр.Видимость 	= ЗначениеЗаполнено(Форма.ЗамечанияВодителяНаПогр);
	Элементы.БезЗамечВодитПогр.Видимость 		= Не ЗначениеЗаполнено(Форма.ЗамечанияВодителяНаПогр);
	Элементы.ЗамечанияПеревозчикаПогр.Видимость = ЗначениеЗаполнено(Форма.ЗамечанияПеревозчикаНаПогр);
	Элементы.БезЗамечПВПогр.Видимость 			= Не ЗначениеЗаполнено(Форма.ЗамечанияПеревозчикаНаПогр);
	
	// поведение группы "ГруппаВодителяНаВыгрузке"
	
	Если ЗначениеЗаполнено(Форма.ЗамечанияВодителяНаВыгр) Или ЗначениеЗаполнено(Форма.ЗамечанияПеревозчикаНаВыгр) Тогда
		Элементы.ГруппаВодителяНаВыгрузке.Заголовок 						= "Водитель и замечания";
		Элементы.ГруппаВодителяНаВыгрузке.ЗаголовокСвернутогоОтображения 	= "Водитель и замечания - есть замечания";
		
		Элементы.ВосклицаниеЗамечанияРазг.Видимость = Истина;
		Элементы.ГруппаВодителяНаВыгрузке.Показать();
	Иначе
		Элементы.ГруппаВодителяНаВыгрузке.Заголовок 						= "Водитель и замечания";
		Элементы.ГруппаВодителяНаВыгрузке.ЗаголовокСвернутогоОтображения 	= "Водитель и замечания - замечаний нет";
		
		Элементы.ВосклицаниеЗамечанияРазг.Видимость = Ложь;
		Элементы.ГруппаВодителяНаВыгрузке.Скрыть();
	КонецЕсли;

	
КонецПроцедуры	

