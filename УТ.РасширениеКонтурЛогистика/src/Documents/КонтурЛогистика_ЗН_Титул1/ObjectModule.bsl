#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ = Ложь 
		И Не ЗначениеЗаполнено(УИД_ЗН) 
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоВходящийДокумент(ДополнительныеСвойства) 
		И ЗначениеЗаполнено(ДокументЗН.Фрахтователь) Тогда
		
		ПараметрыСервиса 	= КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика();
		БратьУИДИзПула 		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляЗН");
		
		Если БратьУИДИзПула Тогда 
			
			Организация = КонтурЛогистика_ОбщегоНазначенияСервер.ОрганизацияДляЗапросаУИДов(ЭтотОбъект);
			
			ПолученныйУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ПолучитьОчередной(Организация);			
			Если ПолученныйУИД <> Неопределено Тогда				
				УИД_ЗН = ПолученныйУИД;				
				ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация);			
			Иначе				
				Сообщить("Не получен УИД из пула. Закончились?");				
			КонецЕсли;	
						
		Иначе
			
			// ничего не делаем.
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЗН_Титул1_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);	
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);

	КонецЕсли;
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЗН_Титул1_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из док Основания

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	Перем ГлавныйДокументОбъект, НайденныйЗН, НастройкаКонвертации, ТЗ_ТоварыВременная;
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
								ДанныеЗаполнения.ТипЛогистика, 
								ДанныеЗаполнения.ДокументОснование);
	
	// ДокументЭТрН потребуется создать(найти) и записать в базу.
	
	НайденныйЗН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЗН(ДокументОснование, НастройкаКонвертации);
	Если ЗначениеЗаполнено(НайденныйЗН) Тогда 
		ГлавныйДокумент = НайденныйЗН;
		
		// перезаполним ЭТРН если взведен флаг
		Если ДанныеЗаполнения.Свойство("ПерезаполнитьГлавныйДокументЕслиСуществует") И ДанныеЗаполнения.ПерезаполнитьГлавныйДокументЕслиСуществует Тогда 
			
			ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ГлавныйДокументОбъект, ДанныеЗаполнения.ДокументОснование, НастройкаКонвертации);
			ГлавныйДокументОбъект.Записать();
			
		КонецЕсли;
	Иначе
		
		ИмяГлавногоДокумента = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяГлавногоДокументаКонтурЛогистика(ДанныеЗаполнения.ТипЛогистика);
		ГлавныйДокументОбъект = Документы[ИмяГлавногоДокумента].СоздатьДокумент();
		
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ГлавныйДокументОбъект, ДанныеЗаполнения.ДокументОснование, НастройкаКонвертации);
		ГлавныйДокументОбъект.Записать();
		ДокументЗН = ГлавныйДокументОбъект.Ссылка;
		
	КонецЕсли;
	
	//Заполнить ЭтотТитул
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации);
	
	// TODO отрефачить дублирвоание в модулях объектов Т1 и Т3 
	ТЗ_ТоварыВременная = ЗаполнитьТабЧастьТовары(НастройкаКонвертации);
	
	КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТЗ_ТоварыВременная);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда 
		КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	КонецЕсли;
	
	Товары.Загрузить(ТЗ_ТоварыВременная);
	
КонецПроцедуры

//TODO отрефачить дублирвоание в модулях объектов Т1 и Т3 
Функция ЗаполнитьТабЧастьТовары(НастройкаКонвертации)
	
	Товары.Очистить();
			
	ТЗ_ТоварыВременная = Товары.Выгрузить(); 
	
	КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ЗаполнитьТабЧастьТоварыПоДокументуУчетнойСистемы(ТЗ_ТоварыВременная, НастройкаКонвертации, ЭтотОбъект);

	Возврат ТЗ_ТоварыВременная;
	
КонецФункции

Процедура СконвертироватьСтрокуТоваров1СвЛогистика(НомерСтроки) Экспорт
	
	СтрокаТоваров = Товары.Найти(НомерСтроки, "НомерСтроки");
	
	// сформировать расширенную (с упаковками) строку товаров
	ТЗ_ТоварыВременная = Товары.ВыгрузитьКолонки(); 
	
	СтрокаТоваровВременная = ТЗ_ТоварыВременная.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТоваровВременная, СтрокаТоваров);
	
	КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	
	// положить расширенную строку товаров обратно в ТоварыДокумента1С
	ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаТоваровВременная);
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоУмолчаниюВСтрокеТоваров(СтрокаТоваров)
	
	// если есть дефолтные значения, например в настройках
	ДефолтСпособУпаковки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособУпаковкиПоУмолчанию");
	
	Если Не ЗначениеЗаполнено(ДефолтСпособУпаковки) Тогда 
		СтрокаТоваров.СпособУпаковки = ДефолтСпособУпаковки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				ДокументЗН.Фрахтователь,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из пришедшего файла XML

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	// TODO
	
	НайденныйДокументЗН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлу(ФайлСсылка);
	
	Если Не ЗначениеЗаполнено(НайденныйДокументЗН) Тогда 
		
		Сообщить("При создании титула по файлу " + ФайлСсылка + "не смог найти Документ ЗН, создание не выполнено");
		
	Иначе
		
		ЭтотОбъект.ДокументЗН = НайденныйДокументЗН;
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		СодЗНИнфФт 	= XDTO.Документ.СодЗНИнфФт;
		
		ЗаполнитьРеквизитыТитулаИзXDTO(XDTO, СодЗНИнфФт);
		
		ЗаполнитьТоварыИзXDTO(СодЗНИнфФт);

		КонтурЛогистика_КонструкторыXDTO.ЗаполнитьСопроводительныеДокументыИзXDTO(СодЗНИнфФт, ЭтотОбъект);
		
		// TODO ИнфПол
		
		// Комментарий - нет в формате минтранса // TODO есть в Диадоке - научиться доставать из ДД 
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO, СодЗНИнфФт)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	УИД_ЗН						= КС.XDTO_Вычислить(СодЗНИнфФт, "УИД_ЗН");
	
	ДатИнфФт 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ДатИнфФт"));
	ВрИнфФт 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ВрИнфФт"));
	
	МаршрутДатВрПодТС_raw		= КС.XDTO_Вычислить(СодЗНИнфФт, "СвМршПодТС.ДатВрПодТС");
	МаршрутДатВрПодТС			= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(МаршрутДатВрПодТС_raw);
	
	ПорядОсущ					= КС.XDTO_Вычислить(СодЗНИнфФт, "СвУслФрах.ПорядОсущ");
	
	РазШтрНеПрТС				= КС.XDTO_ВычислитьЧисло(СодЗНИнфФт, "СвУслФрах.РазШтрНеПрТС");
	РазШтрОткПол				= КС.XDTO_ВычислитьЧисло(СодЗНИнфФт, "СвУслФрах.РазШтрОткПол");
	
	УкНормПрвз					= КС.XDTO_Вычислить(СодЗНИнфФт, "СвУказФт.УкНормПрвз");
	
	ТСТип						= КС.XDTO_Вычислить(СодЗНИнфФт, "СвУказФт.ПарТС.Тип");
	ТСМарка						= КС.XDTO_Вычислить(СодЗНИнфФт, "СвУказФт.ПарТС.Марка");
	ТСГрузопод					= КС.XDTO_Вычислить(СодЗНИнфФт, "СвУказФт.ПарТС.Грузопод");
	ТСВместим					= КС.XDTO_Вычислить(СодЗНИнфФт, "СвУказФт.ПарТС.Вместим");
	
	// исправления
	КС.ЗаполнитьИсправления_ЗН(ЭтотОбъект, СодЗНИнфФт);
	
КонецПроцедуры

Процедура ЗаполнитьТоварыИзXDTO(Знач СодЗНИнфФт)

	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Товары.Очистить();
	
	ОпГруз_raw 					= КС.XDTO_Вычислить(СодЗНИнфФт, "СвГруз.ОпГруз");
	МассивОпГруз 				= КС.XDTO_ВычислитьМассивXDTO(ОпГруз_raw);
	
	Для Каждого ОпГруз из МассивОпГруз Цикл 
		
		НоваяСтрокаТовара = Товары.Добавить();
		НоваяСтрокаТовара.Учитывать = Истина;
		НоваяСтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		НоваяСтрокаТовара.ОтгрузочноеНаименование 	= КС.XDTO_Вычислить(ОпГруз, "НаимГруз");
		НоваяСтрокаТовара.СостояниеГруза 			= КС.XDTO_Вычислить(ОпГруз, "СостГруз");
		НоваяСтрокаТовара.СпособУпаковки 			= КС.XDTO_Вычислить(ОпГруз, "СпУпак");
		ВидТар_raw = КС.XDTO_Вычислить(ОпГруз, "ВидТар");
		Если ЗначениеЗаполнено(ВидТар_raw) Тогда                                          
			НоваяСтрокаТовара.ВидТары 				= Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду(ВидТар_raw);
		КонецЕсли;
		НоваяСтрокаТовара.КоличествоМест  			= КС.XDTO_Вычислить(ОпГруз, "КолМест");
		
		НоваяСтрокаТовара.МассаПлановаяБруттоКг  	= КС.XDTO_Вычислить(ОпГруз, "МасГруз.МасБрутЗнач");
		НоваяСтрокаТовара.МассаПлановаяНеттоКг  	= КС.XDTO_Вычислить(ОпГруз, "МасГруз.МасНетЗнач");
		НоваяСтрокаТовара.КоличествоПаллет  		= КС.XDTO_Вычислить(ОпГруз, "МасГруз.КолПалл");
		
		НоваяСтрокаТовара.КодТНВЭД  				= КС.XDTO_Вычислить(ОпГруз, "КодТовНом");
		НоваяСтрокаТовара.ОбъемКубМ  				= КС.XDTO_ВычислитьЧисло(ОпГруз, "Объем");
		НоваяСтрокаТовара.ДопИнформация  			= КС.XDTO_Вычислить(ОпГруз, "ДрОГруз");
		
		НоваяСтрокаТовара.Высота  					= КС.XDTO_Вычислить(ОпГруз, "Габар.ВысЗнач");
		НоваяСтрокаТовара.Длина  					= КС.XDTO_Вычислить(ОпГруз, "Габар.ДлЗнач");
		НоваяСтрокаТовара.Ширина  					= КС.XDTO_Вычислить(ОпГруз, "Габар.ШирЗнач");
		
		стрОбъявленнаяЦенность_raw				  	= КС.XDTO_Вычислить(ОпГруз, "ЦеннГруз.СтЦеннГр");
		Если стрОбъявленнаяЦенность_raw <> Неопределено Тогда 
			НоваяСтрокаТовара.ОбъявленнаяЦенность = Число(стрОбъявленнаяЦенность_raw);
		КонецЕсли;
		
		НоваяСтрокаТовара.Плотность 				= КС.XDTO_Вычислить(ОпГруз, "Плотн");
		
		ЗаполнитьМаркировкиИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
		ЗаполнитьОпасныеГрузыИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
		ЗаполнитьКонтейнерыИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКонтейнерыИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем МассивСвКонтейн_XDTO, НоваяСтрокаКонтейнера, СвКонтейн_XDTO, СвКонтейн_XDTO_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвКонтейн_XDTO_raw = КС.XDTO_Вычислить(ОпГруз, "СвКонтейн");
	
	Если СвКонтейн_XDTO_raw <> Неопределено Тогда
		
		МассивСвКонтейн_XDTO = КС.XDTO_ВычислитьМассивXDTO(СвКонтейн_XDTO_raw);
		Для Каждого СвКонтейн_XDTO Из МассивСвКонтейн_XDTO Цикл
			
			НоваяСтрокаКонтейнера = Контейнеры.Добавить();
			НоваяСтрокаКонтейнера.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
			НоваяСтрокаКонтейнера.ИдНомерКонтейнера 		= КС.XDTO_Вычислить(СвКонтейн_XDTO, "ИдКонтейн");
			НоваяСтрокаКонтейнера.Количество 				= КС.XDTO_Вычислить(СвКонтейн_XDTO, "КолКонтейн");
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

