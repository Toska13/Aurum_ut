Процедура ЗаполнитьМаркировкиИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем МаркировкаЗначение, МассивМаркировок, НоваяСтрокаМаркировки, стрМаркировки_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	стрМаркировки_raw = КС.XDTO_Вычислить(ОпГруз, "Марк");
	
	Если стрМаркировки_raw <> Неопределено Тогда 
		Если ТипЗнч(стрМаркировки_raw) = Тип("Строка") Тогда 
			МассивМаркировок = Новый Массив;
			МассивМаркировок.Добавить(стрМаркировки_raw);
		Иначе
			МассивМаркировок = КС.XDTO_ВычислитьМассивXDTO(стрМаркировки_raw);
		КонецЕсли;
	КонецЕсли;
	Для Каждого МаркировкаЗначение Из МассивМаркировок Цикл 
		НоваяСтрокаМаркировки = Маркировки.Добавить();
		НоваяСтрокаМаркировки.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
		НоваяСтрокаМаркировки.ЗначениеМаркировки = МаркировкаЗначение;
	КонецЦикла;

КонецПроцедуры

