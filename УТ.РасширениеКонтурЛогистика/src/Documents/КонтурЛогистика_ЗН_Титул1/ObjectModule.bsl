		НоваяСтрокаОпГр.ИндексБезопасности 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ИндексБез");
		НоваяСтрокаОпГр.ОпознавательныйЗнакСертификатов = КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОпозЗнак");
		НоваяСтрокаОпГр.ПолнаяАктивностьГруза 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ПолнАктГр");
		НоваяСтрокаОпГр.ОбМасНетВзрСод 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОбМасНетВзрСод");
