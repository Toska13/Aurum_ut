&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер(ПерезаполнятьГлавныйДокумент = Ложь)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		Объект.Товары.Очистить();
		Объект.Маркировки.Очистить();
		Объект.ОпасныеГрузы.Очистить();
		Объект.Контейнеры.Очистить();
		Объект.ТелефоныПереадресующего.Очистить();
		Объект.ДополнительныеВодители.Очистить();
		Объект.СведенияГосСистем.Очистить();
		
		ДокОбъект = РеквизитФормыВЗначение("Объект");
		ДокОбъект.Заполнить(Новый Структура("ДокументОснование, ТипЛогистика, ПерезаполнитьГлавныйДокументЕслиСуществует", ДокОбъект.ДокументОснование, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ПерезаполнятьГлавныйДокумент));
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;
		
	КонецЕсли;
	
