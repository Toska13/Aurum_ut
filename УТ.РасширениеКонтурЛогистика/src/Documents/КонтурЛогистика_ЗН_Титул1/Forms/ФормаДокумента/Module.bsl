&НаКлиенте
Процедура ОткрытьСоответствияТекущейСтроки()
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда
		
		ТекстПредупреждения = "Табличная часть пуста! Сначала добавьте товар.";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПредупреждения);	
		
	Иначе

		текНоменклатура = ТекущиеДанные.Номенклатура; 
		текЕдиница = ТекущиеДанные.УпаковкаЕдиницаИзмерения; 
		текХарактеристика = ТекущиеДанные.Характеристика; 
		
		Если ЗначениеЗаполнено(текНоменклатура) Тогда
			
			ПараметрыФормыСоответствий = Новый Структура;
			ПараметрыФормыСоответствий.Вставить("Номенклатура", текНоменклатура);
			ПараметрыФормыСоответствий.Вставить("Сопоставление", Истина);
			
			Если НаНоменклатуруУжеЕстьКакоеЛибоБазовоеСоответствие(текНоменклатура) Тогда 
			
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Форма.ФормаНабораЗаписей",
						ПараметрыФормыСоответствий,
						ЭтаФорма,
						ЭтаФорма,
						"ОбработчикИзмененияСоответствий",
						текНоменклатура);
					
			Иначе
						
				ПараметрыФормыСоответствий.Вставить("УпаковкаЕдиницаИзмерения", текЕдиница);
				ПараметрыФормыСоответствий.Вставить("Характеристика", текХарактеристика);
				
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Форма.ФормаЗаписи",
						ПараметрыФормыСоответствий,
						ЭтаФорма,
						ЭтаФорма,
						"ОбработчикИзмененияСоответствий",
						текНоменклатура);
				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НаНоменклатуруУжеЕстьКакоеЛибоБазовоеСоответствие(текНоменклатура)
	
	ВыборкаПоНоменклатуре = РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Выбрать(Новый Структура("Номенклатура", текНоменклатура));
	Если ВыборкаПоНоменклатуре.Следующий() Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ТоварыДобавить(Команда)
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.Учитывать = Истина;	
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
		И КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ИспользуютсяХарактеристики() Тогда 
		НоваяСтрока.Характеристика =  КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПустаяХарактеристика();
	КонецЕсли;
	
	ПроверитьДокумент();
	ЗаполнитьТребуемыеДействияТоваров();
	
КонецПроцедуры

