&НаКлиенте
Процедура ОтметкиГрузополучателяПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ОтметкиГрузополучателя.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	нСтроки = Объект.Акты.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОтметки", ТекДанные.ИдентификаторСтроки));
	Для каждого Строка Из нСтроки Цикл
		Объект.Акты.Удалить(Строка);
	КонецЦикла;
	
	нСтроки = Объект.Штрафы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОтметки", ТекДанные.ИдентификаторСтроки));
	Для каждого Строка Из нСтроки Цикл
		Объект.Штрафы.Удалить(Строка);
	КонецЦикла;
	
	ПроверитьДокумент();

КонецПроцедуры

