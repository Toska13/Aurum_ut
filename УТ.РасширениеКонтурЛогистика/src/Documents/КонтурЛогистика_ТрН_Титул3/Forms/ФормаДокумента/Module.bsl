&НаСервере
Процедура УстановитьЗаголовокНастройкеСопоставления()

	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ТекСпособСопоставленияТоваров = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Т3СпособСопоставленияТоваров", Объект.ДокументЭТРН.ПартнерГрузоотправитель);
		Элементы.ДеревоСопоставленийТоваровОткрытьНастройкуСопоставления.Заголовок = "по " + ТекСпособСопоставленияТоваров;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьДокумент(Команда)
	
	ТипЛогистическогоДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3");
	
	НастройкиКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МассивНастроекКонвертацииПоТипуЛогистики(ТипЛогистическогоДокумента);
	
	Если НастройкиКонвертации.Количество() = 0 Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не могу найти настройку конвертации документа для Т3");
		
	ИначеЕсли НастройкиКонвертации.Количество() = 1 Тогда
		
		ИмяДокументаУчетнойСистемы = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			НастройкиКонвертации[0], "ТипДокумента1С");
		
		ОткрытьФормуВыбораУчетногоДокумента(ИмяДокументаУчетнойСистемы);
		
	Иначе
		
		СЗТипыДокументаОснования = Новый СписокЗначений;
		Для Каждого ТекущаяНастройкаКонвертации Из НастройкиКонвертации Цикл
			ИмяДокументаУчетнойСистемы = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				ТекущаяНастройкаКонвертации, "ТипДокумента1С");
			Если ЗначениеЗаполнено(ИмяДокументаУчетнойСистемы) Тогда
				СЗТипыДокументаОснования.Добавить(ИмяДокументаУчетнойСистемы);
			КонецЕсли;
		КонецЦикла;
		
		Если СЗТипыДокументаОснования.Количество() = 1 Тогда
			ОткрытьФормуВыбораУчетногоДокумента(СЗТипыДокументаОснования[0].Значение);
		Иначе
			Оповещение = Новый ОписаниеОповещения("ВыборТипаДокументаОснованияЗавершение", ЭтаФорма);
			СЗТипыДокументаОснования.ПоказатьВыборЭлемента(Оповещение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборТипаДокументаОснованияЗавершение(ИмяДокументаУчетнойСистемы, ДополнительныеПараметры) Экспорт
	
	Если ИмяДокументаУчетнойСистемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуВыбораУчетногоДокумента(ИмяДокументаУчетнойСистемы.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораУчетногоДокумента(ИмяДокументаУчетнойСистемы)
	
	Если ЗначениеЗаполнено(ИмяДокументаУчетнойСистемы) Тогда
	
		ПараметрыФормыВыбора = Новый Структура("РежимВыбора", Истина);
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы(
			"Документ." + ИмяДокументаУчетнойСистемы + ".ФормаВыбора", ПараметрыФормыВыбора, ЭтаФорма, ЭтаФорма, "ПривязатьДокументВыбор");
		
	Иначе
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			"В настройке конвертации документа не указан тип документа учетной системы");
		
	КонецЕсли;
	
КонецПроцедуры

