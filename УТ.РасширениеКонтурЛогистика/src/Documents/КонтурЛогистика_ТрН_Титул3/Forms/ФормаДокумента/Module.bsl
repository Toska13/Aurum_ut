&НаКлиенте
Процедура УстановитьСвернутостьПодробностейОТоварахДокумента()
	
	Элементы.ГруппаПодробныеСведенияСвернутая1.Видимость = СкрытьПодробностиТоваровДокумента;
	Элементы.ГруппаПодробныеСведения1.Видимость = НЕ Элементы.ГруппаПодробныеСведенияСвернутая1.Видимость;
	
КонецПроцедуры

// УПРАВЛЕНИЕ ВИДИМОСТЬЮ И ДОСТУПНОСТЬЮ
&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()
	
	// особенности отображения - источник товаров и документ основание
	ЕстьДокУчСист = ЗначениеЗаполнено(Объект.ДокументОснование);
	Элементы.ГруппаТоварыДокументаУчетнойСистемы.Видимость 	= ЕстьДокУчСист;
	Элементы.СопоставлениеТоваров.Видимость 				= ЕстьДокУчСист;
	Элементы.ГруппаТоварыПояснение.Видимость 				= ЕстьДокУчСист;
	Элементы.ПерезаполнитьПоДокОснованию.Видимость 			= ЕстьДокУчСист;
	
	Элементы.ТоварыДобавить.Видимость						= Не ЕстьДокУчСист И Не ТолькоПросмотр;
	Элементы.ТоварыСкопировать.Видимость					= Не ЕстьДокУчСист И Не ТолькоПросмотр;
	Элементы.ОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = Не ЕстьДокУчСист И Не ТолькоПросмотр;
	
	Если ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен")
		Или ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки") Тогда 
			
		Элементы.ГруппаТовары.Заголовок = "Товары";
		
	ИначеЕсли ЕстьДокУчСист Тогда
		
		Если НастройкаТоварыУчитыватьУчетныйДокумент Тогда
			
			Элементы.ГруппаТовары.Заголовок = "Товары по данным Отправителя (справочно)";
			Если Объект.РазбиватьГрузыПоСтрокам Тогда 
				Элементы.СопоставлениеТоваров.Заголовок = "Сопоставление (к отправке)";
			Иначе
				Элементы.СопоставлениеТоваров.Заголовок = "Сопоставление (справочно)";
			КонецЕсли;
			Элементы.ДекорацияТоварыИсточникПодпись.Заголовок = "Товары из документа";
			
		Иначе
			
			Если Объект.РазбиватьГрузыПоСтрокам Тогда 
				Элементы.ГруппаТовары.Заголовок = "Товары по данным Отправителя (к отправке)";
			Иначе
				Элементы.ГруппаТовары.Заголовок = "Товары по данным Отправителя (справочно)";
			КонецЕсли;
			Элементы.СопоставлениеТоваров.Заголовок = "Сопоставление (справочно)";
			Элементы.ДекорацияТоварыИсточникПодпись.Заголовок = "Товары из Т1";
			
		КонецЕсли;
		
	Иначе
		
		Если Объект.РазбиватьГрузыПоСтрокам Тогда 
			Элементы.ГруппаТовары.Заголовок = "Товары (к отправке)";
		Иначе
			Элементы.ГруппаТовары.Заголовок = "Товары (из Т1, справочно)";
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ДеревоСопоставленийТоваровСохранитьСопоставлениеТоваров.Видимость = Не СопоставленияТоваровСохранены;
	
	УстановитьПоложениеСохраняемыхЭлементов();
	
	УстановитьФорматыКолонокСКоличеством();
	
	// видимость номенклатуры в зависимости от того есть ли там номенклатура (она есть если отправляли Т1 из этой базы) 
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаНоменклатура);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыХарактеристика);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаЕдиницы);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.ТоварыДокументаУчетнойСистемы, "ДопКлючПоиска", Элементы.ТоварыУчетнойСистемыДопКлючПоиска);
	
	РазвернутьСоответствия();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьФорматыКолонокСКоличеством()
	
	// товары из Т1
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "МассаНеттоКг", Элементы.ТоварыМассаНеттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "МассаБруттоКг", Элементы.ТоварыМассаБруттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "Количество", Элементы.ТоварыКоличество);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "Плотность", Элементы.ТоварыПлотность);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары, "ОбъемКубМ", Элементы.ТоварыОбъемКубМ);
	
	// товары документа
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыДокументаУчетнойСистемы, "МассаНеттоКг", Элементы.ТоварыУчетнойСистемыМассаНеттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыДокументаУчетнойСистемы, "МассаБруттоКг", Элементы.ТоварыУчетнойСистемыМассаБруттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыДокументаУчетнойСистемы, "Количество", Элементы.ТоварыУчетнойСистемыКоличество);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыДокументаУчетнойСистемы, "ОбъемКубМ", Элементы.ТоварыУчетнойСистемыОбъемКубМ);
	
	// таблица соответствия
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыСоответствиеСтрокТоваров, "МассаНеттоКг", Элементы.ДеревоСопоставленийТоваровМассаНеттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыСоответствиеСтрокТоваров, "МассаБруттоКг", Элементы.ДеревоСопоставленийТоваровМассаБруттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыСоответствиеСтрокТоваров, "ОбъемКубМ", Элементы.ДеревоСопоставленийТоваровОбъемКубМ);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыСоответствиеСтрокТоваров, "МассаНеттоКгОтправителя", Элементы.ДеревоСопоставленийТоваровМассаНеттоКгОтправителя);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыСоответствиеСтрокТоваров, "МассаБруттоКгОтправителя", Элементы.ДеревоСопоставленийТоваровМассаБруттоКгОтправителя);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.ТоварыСоответствиеСтрокТоваров, "ОбъемКубМОтправителя", Элементы.ДеревоСопоставленийТоваровОбъемКубМОтправителя);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеСохраняемыхЭлементов()
	
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	УстановитьПоложениеШапки();
	УстановитьСвернутостьПодробностейОТоварах();
	УстановитьСвернутостьПодробностейОТоварахДокумента();

КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормыВЗависимостиОтСтатуса()
	
	СтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	
	Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю
		Или (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
			И ЗначениеЗаполнено(КомментарииВодителяПриВыгрузке))
		Или (СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка И ЗначениеЗаполнено(Объект.ДокументЭТРН.УИД)) Тогда
		
		ТолькоПросмотр = Макс(Ложь, ТолькоПросмотр);
		Элементы.ГруппаИсправление.Видимость = Объект.НомИспр > 0;
		
	ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
		Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
		Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3, Объект.ДокументОснование);
		КрайнийФайлДокумента = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Объект.Ссылка);
		
		Если ЗначениеЗаполнено(НастройкаКонвертации) 
			И НастройкаКонвертации.Сценарий_РазрешитьПодписыватьПолученныйЧерновик
			И КрайнийФайлДокумента <> Неопределено 
			И Не КрайнийФайлДокумента.ПодписьВерна Тогда 
			
			ТолькоПросмотр = Макс(Ложь, ТолькоПросмотр);
			Элементы.ГруппаИсправление.Видимость = Ложь;
			Попытка
				Объект.ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
				ЭтаФорма.Модифицированность = Истина;
			Исключение
			КонецПопытки;
			
		Иначе
			
			ТолькоПросмотр = Истина;
			Элементы.ГруппаИсправление.Видимость = Истина;
			
		КонецЕсли;
		
	Иначе
		ТолькоПросмотр = Истина;
		Элементы.ГруппаИсправление.Видимость = Истина;
	КонецЕсли;
	
	Элементы.ПривязатьДокумент.Видимость = СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена;
	
	Если Элементы.Найти("ВнестиИсправлениеТитула") <> Неопределено Тогда
		Элементы.ВнестиИсправлениеТитула.Видимость = ТолькоПросмотр И Объект.ДокументЭТРН.Грузополучатель.Наш;
	КонецЕсли;
	
	Элементы.ОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость 	= Не ТолькоПросмотр;
	Элементы.ОбщаяКомандаКонтурЛогистика_ПерезаполнитьИзПредыдущего.Видимость 	= Не ТолькоПросмотр;
	Элементы.ТоварыДобавить.Видимость 											= Не ТолькоПросмотр;
	Элементы.ТоварыСкопировать.Видимость 										= Не ТолькоПросмотр;
	Элементы.ОтметкиГрузополучателяОтметкиДобавить.Видимость 					= Не ТолькоПросмотр;
	Элементы.ОтметкиГрузополучателяОтметкиСкопировать.Видимость 				= Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяЗаявленноеТекущим.Видимость 					= Не ТолькоПросмотр; 
	Элементы.УстановитьДатуВремяПрибытияТекущим.Видимость 						= Не ТолькоПросмотр; 
	Элементы.УстановитьДатуВремяУбытияТекущим.Видимость 						= Не ТолькоПросмотр; 
	// Элементы.ПодменюУправление.Доступность = Не ТолькоПросмотр;    // TODO требуется индивидуальная блокировка команд: сценарий 
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьШапку(Команда)
	
	ШапкаНаОтдельнойЗакладке = Истина;
	УстановитьПоложениеШапки();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьШапку(Команда)
	
	ШапкаНаОтдельнойЗакладке = Ложь;
	УстановитьПоложениеШапки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеШапки()
	
	Если ШапкаНаОтдельнойЗакладке Тогда
		
		текАктивнаяЗакладка = Элементы.Страницы.ТекущаяСтраница;
		
		ПереместитьШапкуВызовСервера();
		//Элементы.Переместить(Элементы.ГруппаШапкаЛево, Элементы.СтраницаШапка);
		Элементы.СвернутьШапку.Видимость = Ложь;
		Элементы.РазвернутьШапку.Видимость = Истина;
		
		ПанельОшибокРазвернута = Элементы.ПанельОшибок.РастягиватьПоВертикали;
		Если Не ПанельОшибокРазвернута Тогда 
			ПанельОшибокСвернутьРазвернутьВызовОМ();
		КонецЕсли;
		                                             
		Элементы.Страницы.ТекущаяСтраница = текАктивнаяЗакладка;
		
	Иначе
		
		ПереместитьШапкуВызовСервера();
		//Элементы.Переместить(Элементы.ГруппаШапкаЛево, Элементы.ГруппаШапкаМестоположение);
		Элементы.СвернутьШапку.Видимость = Истина;
		Элементы.РазвернутьШапку.Видимость = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПереместитьШапкуВызовСервера()
	
	Если ШапкаНаОтдельнойЗакладке Тогда
		КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(ЭтаФорма, Элементы.ГруппаШапкаДанные, Элементы.СтраницаШапка);
	Иначе
		КонтурЛогистика_ПанельОшибокСервер.ПереместитьЭлементы(ЭтаФорма, Элементы.ГруппаШапкаДанные, Элементы.ГруппаШапкаМестоположение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		
		Элементы.Маркировки.ОтборСтрок 			= Неопределено;
		Элементы.МаркировкиУчДок.ОтборСтрок 		= Неопределено;
		
	Иначе
		
		Элементы.Маркировки.ОтборСтрок 			= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиТоваров", Элемент.ТекущиеДанные.ИдентификаторСтроки);    
		Элементы.МаркировкиУчДок.ОтборСтрок 		= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиТоваров", Элемент.ТекущиеДанные.ИдентификаторСтроки);    
		
	КонецЕсли;
	
	КонтурЛогистика_ПанельОшибокКлиент.УстановитьОтборТаблицыОшибокПоНомеруСтроки(ТаблицаОшибок, Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	ОбнулитьКолонкиСуммированияПоНеУчитываемымТоварам();
	
	СформироватьТребуемоеДействиеСтрокиТовара(Элемент.ТекущиеДанные);
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);
	
	Элементы.ДеревоСопоставленийТоваровЗаполнитьДеревоСопоставленияТоваров.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
	Элементы.СопоставлениеТоваров.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
	
	АвторасчетИтоговСервер();
	
	ПроверитьДокумент();

КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьКолонкиСуммированияПоНеУчитываемымТоварам()
	
	Перем СтрокаТовара;
	
	// неучитываемые должны иметь 0 в колонках суммироания
	Для Каждого СтрокаТовара Из Объект.ТоварыДокументаУчетнойСистемы Цикл
		
		Если СтрокаТовара.Учитывать = Ложь Тогда 
			СтрокаТовара.КоличествоМест = 0;
			СтрокаТовара.МассаБруттоКг = 0;
			СтрокаТовара.МассаНеттоКг = 0;
			СтрокаТовара.КоличествоПаллет = 0;
		КонецЕсли;
		
	КонецЦикла;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		
		Если СтрокаТовара.Учитывать = Ложь Тогда 
			СтрокаТовара.КоличествоМест = 0;
			СтрокаТовара.МассаБруттоКг = 0;
			СтрокаТовара.МассаНеттоКг = 0;
			СтрокаТовара.КоличествоПаллет = 0;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АвторасчетИтоговСервер()

	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.АвторасчетИтогов();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	
КонецПроцедуры // АвторасчетИтоговСервер()


&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТоварыТребуемоеДействие" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элемент.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда 
			
			ТребуемоеДействие = ТекДанные.ТребуемоеДействие; 
			ПараметрыТекСтрока = ВыбраннаяСтрока;
			
			Если ТребуемоеДействие = "Установить соответствие"
				ИЛИ ТребуемоеДействие = "Не учитывается" Тогда
				
				ОткрытьСоответствияТекущейСтроки();
				
			Иначе // требуемое действие от таблицы ошибок
				
				ОбработатьТребуемоеДействие(ТребуемоеДействие, Неопределено);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчики для требуемых действий

&НаКлиенте
Процедура ОбработатьТребуемоеДействие(ТребуемоеДействие, ПолеТаблицыОшибок = Неопределено)
	
	// реализуем отдельную обработку некоторых требуемых действий
	Если Ложь Тогда // Какие-то особенные UI для требуемых действий, например: ТребуемоеДействие = "Исправить GTIN" Тогда
		
	Иначе // типовая обработка таблицы ошибок
		
		Если ПолеТаблицыОшибок <> Неопределено Тогда
			КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, ПолеТаблицыОшибок.Имя);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказВПриемкеПриИзменении(Элемент)
	
	УправлениеВидимостьюИДоступностью();	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДеревоСопоставленияТоваров(Команда)
	
	ПересопоставитьТоварыАвтоматически();
	РазвернутьСоответствия();
	СопоставленияТоваровСохранены = Истина;
	Элементы.ДеревоСопоставленийТоваровСохранитьСопоставлениеТоваров.Видимость = Не СопоставленияТоваровСохранены;
	Элементы.ДеревоСопоставленийТоваровЗаполнитьДеревоСопоставленияТоваров.Картинка = БиблиотекаКартинок.Обновить;
	Элементы.СопоставлениеТоваров.Картинка = БиблиотекаКартинок.КонтурЛогистика_Сопоставление;
	
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьСоответствия()
	
	Для Каждого Строка1 Из ДеревоСопоставленийТоваров.ПолучитьЭлементы() Цикл
		Элементы.ДеревоСопоставленийТоваров.Развернуть(Строка1.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересопоставитьТоварыАвтоматически()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.СопоставитьТоварыАвтоматически();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	Модифицированность = Истина;
	СопоставленияТоваровСохранены = Истина;
	ЗаполнитьДеревоСопоставленияТоваровСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоСопоставленияТоваровСервер() // обратная процедура - СохранитьСопоставлениеТоваровНаСервере()
	
	Дерево = РеквизитФормыВЗначение("ДеревоСопоставленийТоваров");
	Дерево.Строки.Очистить();
	
	Объект.ТоварыСоответствиеСтрокТоваров.Сортировать("НомерСтрокиОтправителя, НомерСтрокиПолучателя");
	
	Для Каждого СтрокаСоответствия из Объект.ТоварыСоответствиеСтрокТоваров Цикл

		ПредставлениеОтправителя = "";
		НайденныеСтрокаОтправителя = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСоответствия.ИдентификаторСтрокиТоваровОтправителя));
		Если НайденныеСтрокаОтправителя.Количество() = 1 Тогда
			НайденнаяСтрокаОтправителя = НайденныеСтрокаОтправителя[0];
			ПредставлениеОтправителя = "" + НайденнаяСтрокаОтправителя.Номенклатура + ", " + НайденнаяСтрокаОтправителя.УпаковкаЕдиницаИзмерения + " [ " + НайденнаяСтрокаОтправителя.ОтгрузочноеНаименование + ", " + НайденнаяСтрокаОтправителя.СостояниеГруза + "]"; 
		Иначе
			ПредставлениеОтправителя = "<Нет строки отправителя>";
		КонецЕсли;
		
		ПредставлениеПолучателя = "";
		НайденныеСтрокаПолучателя = Объект.ТоварыДокументаУчетнойСистемы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСоответствия.ИдентификаторСтрокиТоваровПолучателя));
		Если НайденныеСтрокаПолучателя.Количество() = 1 Тогда
			НайденнаяСтрокаПолучателя = НайденныеСтрокаПолучателя[0];
			ПредставлениеПолучателя = "" + НайденнаяСтрокаПолучателя.Номенклатура + ", " + НайденнаяСтрокаПолучателя.УпаковкаЕдиницаИзмерения + " [ " + НайденнаяСтрокаПолучателя.ОтгрузочноеНаименование + ", " + НайденнаяСтрокаПолучателя.СостояниеГруза + "]"; 
		Иначе
			ПредставлениеПолучателя = "<Нет строки получателя>";
		КонецЕсли;
		
		СтрокаДереваОтправителя = Дерево.Строки.Найти(СтрокаСоответствия.ИдентификаторСтрокиТоваровОтправителя, "ИдентификаторСтрокиТоваровОтправителя");
		
		Если СтрокаДереваОтправителя = Неопределено Тогда
			
			// новая строка дерева и парная
			СтрокаДереваОтправителя = Дерево.Строки.Добавить();
			СтрокаДереваОтправителя.УровеньСтроки = 1;
			СтрокаДереваОтправителя.ПредставлениеСтрокиОтправителя = ПредставлениеОтправителя;
			ЗаполнитьЗначенияСвойств(СтрокаДереваОтправителя, СтрокаСоответствия, "ИдентификаторСтрокиТоваровОтправителя,
			|НомерСтрокиОтправителя,ОбъемКубМОтправителя,КоличествоМестОтправителя,МассаБруттоКгОтправителя,МассаНеттоКгОтправителя,КоличествоПаллетОтправителя" );
			
			СтрокаПолучателя = СтрокаДереваОтправителя.Строки.Добавить();
			СтрокаПолучателя.УровеньСтроки = 2;
			СтрокаПолучателя.ПредставлениеСтрокиПолучателя = ПредставлениеПолучателя;
			ЗаполнитьЗначенияСвойств(СтрокаПолучателя, СтрокаСоответствия, "ИдентификаторСтрокиТоваровПолучателя,
			|НомерСтрокиПолучателя,ОбъемКубМ,КоличествоМест,МассаБруттоКг,МассаНеттоКг,КоличествоПаллет" );
			
		Иначе // уже есть такая строка 
			
			// это может быть разноска по принципу 1 строка получателя - N строк отправителя
			СтрокаПолучателя = Дерево.Строки.Найти(СтрокаСоответствия.ИдентификаторСтрокиТоваровПолучателя, "ИдентификаторСтрокиТоваровПолучателя");
			Если СтрокаПолучателя = Неопределено Тогда
				
				// строки получателя еще нет - складываем в ветвь
				СтрокаПолучателя = СтрокаДереваОтправителя.Строки.Добавить();
				СтрокаПолучателя.УровеньСтроки = 2;
				СтрокаПолучателя.ПредставлениеСтрокиПолучателя = ПредставлениеПолучателя;
				ЗаполнитьЗначенияСвойств(СтрокаПолучателя, СтрокаСоответствия, "ИдентификаторСтрокиТоваровПолучателя,
				|НомерСтрокиПолучателя,ОбъемКубМ,КоличествоМест,МассаБруттоКг,МассаНеттоКг,КоличествоПаллет" );
				
			Иначе
				
				// уже есть такая строка получателя и есть такая же строка получателя - заводим новую строку отправителя
				СтрокаДереваОтправителя = Дерево.Строки.Добавить();
				СтрокаДереваОтправителя.УровеньСтроки = 1;
				СтрокаДереваОтправителя.ПредставлениеСтрокиОтправителя = ПредставлениеОтправителя;
				ЗаполнитьЗначенияСвойств(СтрокаДереваОтправителя, СтрокаСоответствия, "ИдентификаторСтрокиТоваровОтправителя,
				|НомерСтрокиОтправителя,ОбъемКубМОтправителя,КоличествоМестОтправителя,МассаБруттоКгОтправителя,МассаНеттоКгОтправителя,КоличествоПаллетОтправителя" );
				
				СтрокаПолучателя = СтрокаДереваОтправителя.Строки.Добавить();
				СтрокаПолучателя.УровеньСтроки = 2;
				СтрокаПолучателя.ПредставлениеСтрокиПолучателя = ПредставлениеПолучателя;
				ЗаполнитьЗначенияСвойств(СтрокаПолучателя, СтрокаСоответствия, "ИдентификаторСтрокиТоваровПолучателя,
				|НомерСтрокиПолучателя,ОбъемКубМ,КоличествоМест,МассаБруттоКг,МассаНеттоКг,КоличествоПаллет" );
				
			КонецЕсли;
			
		КонецЕсли;
		//ЗаполнитьЗначенияСвойств(СтрокаДереваОтправителя, СтрокаСоответствия);

	КонецЦикла;
	
	// СформироватьТД
	Для Каждого Строка1 Из Дерево.Строки Цикл // парная с клиентсокй СформироватьТребуемыеДействияНаКлиенте
		
		// несопоставлены строки?
		Если Не ЗначениеЗаполнено(Строка1.ИдентификаторСтрокиТоваровОтправителя) Тогда 
			Строка1.ТребуемоеДействие = "нет товара грузоотправителя";
			Строка1.КартинкаТребуемогоДействия = 1;
		ИначеЕсли НЕ ДочерниеРазнесены(Строка1) Тогда 
			Строка1.ТребуемоеДействие = "нет товара в документе";
			Строка1.КартинкаТребуемогоДействия = 1;
			
		// отличается количество мест?	
		ИначеЕсли ИтогДочернихКолМест(Строка1) > Строка1.КоличествоМестОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе больше мест";
			Строка1.КартинкаТребуемогоДействия = 1;
		ИначеЕсли ИтогДочернихКолМест(Строка1) < Строка1.КоличествоМестОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе меньше мест";
			Строка1.КартинкаТребуемогоДействия = 1;
			
		// отличается масса брутто?	
		ИначеЕсли ИтогДочернихБрутто(Строка1) > Строка1.МассаБруттоКгОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе больше брутто";
			Строка1.КартинкаТребуемогоДействия = 1;
		ИначеЕсли ИтогДочернихБрутто(Строка1) < Строка1.МассаБруттоКгОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе меньше брутто";
			Строка1.КартинкаТребуемогоДействия = 1;
			
			
		Иначе
			Строка1.ТребуемоеДействие = "ок";
			Строка1.КартинкаТребуемогоДействия = 3;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоСопоставленийТоваров");

КонецПроцедуры

&НаСервере
