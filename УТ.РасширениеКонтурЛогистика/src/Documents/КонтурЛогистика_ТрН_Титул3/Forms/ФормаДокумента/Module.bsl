&НаКлиенте
Процедура ОбработатьИнтерактивноеИзменениеДереваСопоставлений()
	
	Строки1 = ДеревоСопоставленийТоваров.ПолучитьЭлементы();
	Строк1 = Строки1.Количество();
	Если Строк1 > 0 Тогда
		
		Для й = 1 По Строк1 Цикл
			
			Строка1 = Строки1[Строк1 - й];
			Строка1Индекс = Строки1.Индекс(Строка1);
			Строки2 = Строка1.ПолучитьЭлементы();
			Строк2 = Строки2.Количество();
			
			Если Строка1.КоличествоМестОтправителя = 0 И Строк2 = 0 Тогда
				Строки1.Удалить(Строка1Индекс);
			ИначеЕсли  Строка1.КоличествоМестОтправителя > 0 И Строк2 = 0 Тогда
				НоваяПустаяСтрока2 = Строки2.Добавить();
				НоваяПустаяСтрока2.ПредставлениеСтрокиОтправителя = "<Нет строки получателя>";
				НоваяПустаяСтрока2.УровеньСтроки = 2;
				НоваяПустаяСтрока2.НомерСтрокиПолучателя = 0;
			КонецЕсли;
			
			Если Строк2 > 0 Тогда 
				ПроверитьСхлопнутьСтрокиПолучателя(Строка1);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	СопоставленияТоваровСохранены = Ложь;
	Элементы.ДеревоСопоставленийТоваровСохранитьСопоставлениеТоваров.Видимость = Не СопоставленияТоваровСохранены;
	
	СформироватьТребуемыеДействияНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТребуемыеДействияНаКлиенте() // парная с серверной СформироватьТребуемыеДействия

	// СформироватьТД
	Для Каждого Строка1 Из ДеревоСопоставленийТоваров.ПолучитьЭлементы() Цикл 
		
		// несопоставлены строки?
		Если Не ЗначениеЗаполнено(Строка1.ИдентификаторСтрокиТоваровОтправителя) Тогда 
			Строка1.ТребуемоеДействие = "нет товара грузоотправителя";
			Строка1.КартинкаТребуемогоДействия = 1;
		ИначеЕсли Не ДочерниеРазнесеныКлиент(Строка1) Тогда 
			Строка1.ТребуемоеДействие = "нет товара в документе";
			Строка1.КартинкаТребуемогоДействия = 1;
			
		// отличается количество мест?	
		ИначеЕсли ИтогДочернихМестКлиент(Строка1) > Строка1.КоличествоМестОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе больше";
			Строка1.КартинкаТребуемогоДействия = 1;
		ИначеЕсли ИтогДочернихМестКлиент(Строка1) < Строка1.КоличествоМестОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе меньше";
			Строка1.КартинкаТребуемогоДействия = 1;
			
		// отличается масса брутто?	
		ИначеЕсли ИтогДочернихБруттоКлиент(Строка1) > Строка1.МассаБруттоКгОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе больше брутто";
			Строка1.КартинкаТребуемогоДействия = 1;
		ИначеЕсли ИтогДочернихБруттоКлиент(Строка1) < Строка1.МассаБруттоКгОтправителя Тогда 
			Строка1.ТребуемоеДействие = "в документе меньше брутто";
			Строка1.КартинкаТребуемогоДействия = 1;
			
		Иначе
			Строка1.ТребуемоеДействие = "ок";
			Строка1.КартинкаТребуемогоДействия = 3;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ДочерниеРазнесеныКлиент(СтрокаДерева)
	
	Ошибка = Ложь;
	
	Если СтрокаДерева.ПолучитьЭлементы().Количество() = 0 Тогда 
		Ошибка = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаДочернего Из СтрокаДерева.ПолучитьЭлементы() Цикл 
		
		Если Не ЗначениеЗаполнено(СтрокаДочернего.ИдентификаторСтрокиТоваровПолучателя) Тогда 
			Ошибка = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НЕ Ошибка
	
КонецФункции 


&НаКлиенте
Процедура ПроверитьСхлопнутьСтрокиПолучателя(Строка1)
	
	Строки2 = Строка1.ПолучитьЭлементы();
	Строк2 = Строки2.Количество();
	МассивИдентификаторовПолучателя = Новый Массив; // массив уникальных 
	
	Для й = 1 По Строк2 Цикл
		
		Строка2 = Строки2[Строк2 - й];
		Строка2Индекс = Строки2.Индекс(Строка2);
		Если Строка2.КоличествоМест = 0 И Строк2 > 1 Тогда
			Строки2.Удалить(Строка2Индекс);
			Продолжить;
		КонецЕсли;
		
		Если МассивИдентификаторовПолучателя.Найти(Строка2.ИдентификаторСтрокиТоваровПолучателя) = Неопределено Тогда 
			МассивИдентификаторовПолучателя.Добавить(Строка2.ИдентификаторСтрокиТоваровПолучателя);
		КонецЕсли;
		
	КонецЦикла;
	
	// объединить строки2 если у них одинаковый ИдентификаторСтрокиТоваровПолучателя
	Для Каждого ИдентификаторСтрокиТоваровПолучателя Из МассивИдентификаторовПолучателя Цикл 
		ПерваяСтрокаСЭтимИд = Неопределено;
		Строки2 = Строка1.ПолучитьЭлементы();
		Строк2 = Строки2.Количество();
		Для й = 1 По Строк2 Цикл
			Строка2 = Строки2[Строк2 - й];
			Строка2Индекс = Строки2.Индекс(Строка2);
			Если Строка2.ИдентификаторСтрокиТоваровПолучателя = ИдентификаторСтрокиТоваровПолучателя Тогда 
				Если ПерваяСтрокаСЭтимИд = Неопределено Тогда 
					ПерваяСтрокаСЭтимИд = Строка2;
				Иначе
					ПерваяСтрокаСЭтимИд.ОбъемКубМ = ПерваяСтрокаСЭтимИд.ОбъемКубМ + Строка2.ОбъемКубМ;
					ПерваяСтрокаСЭтимИд.КоличествоМест = ПерваяСтрокаСЭтимИд.КоличествоМест + Строка2.КоличествоМест;
					ПерваяСтрокаСЭтимИд.МассаБруттоКг = ПерваяСтрокаСЭтимИд.МассаБруттоКг + Строка2.МассаБруттоКг;
					ПерваяСтрокаСЭтимИд.МассаНеттоКг = ПерваяСтрокаСЭтимИд.МассаНеттоКг + Строка2.МассаНеттоКг;
					ПерваяСтрокаСЭтимИд.КоличествоПаллет = ПерваяСтрокаСЭтимИд.КоличествоПаллет + Строка2.КоличествоПаллет;
					
					Строки2.Удалить(Строка2Индекс);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСопоставлениеТоваров(Команда)
	
	СохранитьСопоставлениеТоваровНаСервере();
	
	// повторно разложить из дерева?
	СопоставленияТоваровСохранены = Истина;
	Элементы.ДеревоСопоставленийТоваровСохранитьСопоставлениеТоваров.Видимость = Не СопоставленияТоваровСохранены;
	ЗаполнитьДеревоСопоставленияТоваровСервер();
	РазвернутьСоответствия();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСопоставлениеТоваровНаСервере() // обратная процедура - ЗаполнитьДеревоСопоставленияТоваровСервер()
	
	// положим данные дерева в ТоварыСоответствиеСтрокТоваров
	Дерево = РеквизитФормыВЗначение("ДеревоСопоставленийТоваров");
	
	Объект.ТоварыСоответствиеСтрокТоваров.Очистить();
	
	Для Каждого СтрокаДереваОтправителя Из Дерево.Строки Цикл
		
		
		Если СтрокаДереваОтправителя.Строки.Количество() = 0 Тогда
			
			НоваяСтрокаСоответствия = Объект.ТоварыСоответствиеСтрокТоваров.Добавить();
			
			// есть только часть отправителя
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСоответствия, СтрокаДереваОтправителя, "ИдентификаторСтрокиТоваровОтправителя,
			|НомерСтрокиОтправителя,ОбъемКубМОтправителя,КоличествоМестОтправителя,МассаБруттоКгОтправителя,МассаНеттоКгОтправителя,КоличествоПаллетОтправителя" );
			
		Иначе
			
			Для Каждого СтрокаДереваПолучателя Из СтрокаДереваОтправителя.Строки Цикл
				
				НоваяСтрокаСоответствия = Объект.ТоварыСоответствиеСтрокТоваров.Добавить();
				
				// часть отправителя
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСоответствия, СтрокаДереваОтправителя, "ИдентификаторСтрокиТоваровОтправителя,
				|НомерСтрокиОтправителя,ОбъемКубМОтправителя,КоличествоМестОтправителя,МассаБруттоКгОтправителя,МассаНеттоКгОтправителя,КоличествоПаллетОтправителя" );
				
				// часть получателя
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСоответствия, СтрокаДереваПолучателя, "ИдентификаторСтрокиТоваровПолучателя,
				|НомерСтрокиПолучателя,ОбъемКубМ,КоличествоМест,МассаБруттоКг,МассаНеттоКг,КоличествоПаллет" );
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ТоварыСоответствиеСтрокТоваров.Сортировать("НомерСтрокиОтправителя, НомерСтрокиПолучателя");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСопоставленийТоваровНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Если Элемент.ТекущиеДанные.УровеньСтроки <> 2 Тогда 
		Выполнение = Ложь;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДеревоСопоставленийТоваровПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	НайденнаяСтрокаПеретаскивания = ДеревоСопоставленийТоваров.НайтиПоИдентификатору(Строка);
	Если НайденнаяСтрокаПеретаскивания <> Неопределено Тогда 
		Если НайденнаяСтрокаПеретаскивания.УровеньСтроки <> 1 Тогда 
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСопоставленийТоваровПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	НайденнаяСтрокаПеретаскивания = ДеревоСопоставленийТоваров.НайтиПоИдентификатору(Строка);
	Если НайденнаяСтрокаПеретаскивания <> Неопределено Тогда 
		Если НайденнаяСтрокаПеретаскивания.УровеньСтроки <> 1 Тогда 
			ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
		Иначе
			ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОтметкиГрузополучателяПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		
		Элементы.Акты.ОтборСтрок 			= Неопределено;
		Элементы.Штрафы.ОтборСтрок 			= Неопределено;
		Элементы.ОтметкиИнфПол.ОтборСтрок 	= Неопределено;
		
	Иначе
		
		Элементы.Акты.ОтборСтрок 			= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки", Элемент.ТекущиеДанные.ИдентификаторСтроки);    
		Элементы.Штрафы.ОтборСтрок 			= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки", Элемент.ТекущиеДанные.ИдентификаторСтроки);    
		Элементы.ОтметкиИнфПол.ОтборСтрок 	= Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки", Элемент.ТекущиеДанные.ИдентификаторСтроки);    
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АктыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда 
		
		ТекОтметкаГП = Элементы.ОтметкиГрузополучателя.ТекущиеДанные;
		
		Если ТекОтметкаГП <> Неопределено Тогда 
			
			Элемент.ТекущиеДанные.ИдентификаторСтрокиОтметки = ТекОтметкаГП.ИдентификаторСтроки;
			Элемент.ТекущиеДанные.АктДата = ТекущаяДата();
			Элемент.ТекущиеДанные.АктНаименование = "Акт";
			
		КонецЕсли
		
	КонецЕсли
	
