// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Элементы.ТоварыХарактеристика.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики") = Истина;
	СопоставленияТоваровСохранены = Истина;
	
	Элементы.ДокументОснование.Доступность = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТипыДокументаОснованияНастроеныДляТитула(3);
	
	ОбновитьДанныеФормы();
	
	РазблокироватьДанныеФормыДляРедактирования();
	
	ЭлементыДляРазрешенияРедактирования = Новый Массив;
	ЭлементыДляРазрешенияРедактирования.Добавить("ГруппаЛево");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка, ЭлементыДляРазрешенияРедактирования);
	
	НастройкаСопоствления = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного("Т3СпособСопоставленияТоваров", Объект.ДокументЭТРН.ПартнерГрузоотправитель);
	
	УправлениеЭлементамиФормыВЗависимостиОтСтатуса();
	
	ЗаполнитьДатыРазгрузкиЛокальные();
	
	// Баги старой платформы при отрисовке сложных группировок:
	// в режиме интерфейса 8.2 отображаем в режиме "на отдельных закладках" шапку и тч
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
		ШапкаНаОтдельнойЗакладке = Истина;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаШапка;
		Элементы.Переместить(Элементы.Группа5, Элементы.Группа14);
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеВидимостьюИДоступностью(); // в будущем завернуть на проверить документ
	ПроверитьДокумент();
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		Элементы.Страницы.ТекущаяСтраница = Элементы.СопоставлениеТоваров;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И Параметр = Объект.Ссылка Тогда 
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// ОбновитьДанныеФормы();
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьОткрытыеТитулы" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли  ИмяСобытия = "ЗавершениеФоновогоЗадания" 
			И Параметр <> Неопределено
			И ТипЗнч(Параметр) = Тип("Структура")
			И Параметр.Свойство("КлючФЗ")
			И Параметр.КлючФЗ = "ВыполнениеОбменаКолбаса" Тогда
			
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "ИзменениеОбщейНастройки"
		И  Параметр = "Т3ТоварыУчитыватьУчетныйДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПунктМаршрута"
		И Параметр = Объект.МестоВыгрузки Тогда
		
		НовыйЧасовойПояс = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.МестоВыгрузки, "ЧасовойПояс");
		Если ЧасовойПоясРазгрузки <> НовыйЧасовойПояс Тогда
			// Пересчитаем время
			ЗаявДатВрПриб = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
				ЗаявДатВрПриб, ЧасовойПоясРазгрузки, НовыйЧасовойПояс);
			ФДатВрПриб = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
				ФДатВрПриб, ЧасовойПоясРазгрузки, НовыйЧасовойПояс);
			ФДатВрУбыт = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
				ФДатВрУбыт, ЧасовойПоясРазгрузки, НовыйЧасовойПояс);
			
			ЧасовойПоясРазгрузки = НовыйЧасовойПояс;
			Элементы.Группа5.Заголовок = ЗаголовокДатИВременПогрузки(ЧасовойПоясРазгрузки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьОбъект(Команда)
	
	ОбработчикПеречитатьОбъект();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()
	
	ЭтаФорма.Прочитать();
	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()

	ОбновитьДанныеФормы();
	ПолностьюОбновитьПредставлениеДанных();
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(ЭтаФорма, Объект.ДокументОснование);
	УправлениеКолбасойТитуловВызовСервера();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеКолбасойТитуловВызовСервера()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УправлениеСтатусомПодписиИКолбасойТитулов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()
	
	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ПолностьюОбновитьПредставлениеДанных()

	// TODO
	
	//УстановитьТипыЗначенийРеквизитов();
	//ЗаполнитьПредставлениеРеквизитовДокументаОснования();
	//
	ЗаполнитьДатыРазгрузкиЛокальные();
	ЗаполнитьТребуемыеДействияТоваров();
	
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);	
	ПроверитьДокумент(); // вызовет УправлениеВидимостьюИДоступностью();
	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.ДокументЭТРН, Истина);
	КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Объект.Ссылка);
	
	Титул1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, Объект.ДокументЭТРН);
	
	НастройкаТоварыУчитыватьУчетныйДокумент = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т3ТоварыУчитыватьУчетныйДокумент") = Истина;	
	
	ПерешелВЛогистическиеСтатус = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена;
	Элементы.ТекущийСтатус.Видимость = Не ПерешелВЛогистическиеСтатус;
	Элементы.ТекущийСтатусДокументооборота.Видимость = ПерешелВЛогистическиеСтатус;
	
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Заголовок = "Повторно подписать и отправить";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Переотправить неподписанный (черновик)";
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Заголовок = "Подписать и отправить";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный.Заголовок = "Отправить неподписанный (черновик)";
	КонецЕсли;

	Элементы.ДокументЭТРНПогрузкуОсуществляет.Видимость = ЗначениеЗаполнено(Объект.ДокументЭТРН.ПогрузкуОсуществляет)
																И Объект.ДокументЭТРН.Грузоотправитель <> Объект.ДокументЭТРН.ПогрузкуОсуществляет;
	Элементы.ДокументЭТРННомЗак.Видимость 				= ЗначениеЗаполнено(Объект.ДокументЭТРН.НомЗак);
	Элементы.ДокументЭТРНПрицеп.Видимость 				= ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп);
	Элементы.ДокументЭТРНПрицеп2.Видимость 				= ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп2);
	Элементы.ДокументЭТРНПрицеп.Видимость 				= ЗначениеЗаполнено(Объект.ДокументЭТРН.Прицеп);
	
	ЭтоВходящий = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен;
	ЕстьДокУчСист = ЗначениеЗаполнено(Объект.ДокументОснование);
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = ЭтоВходящий И Не ЕстьДокУчСист;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик Тогда
		ДоступностьПодписатьОтправить = Истина;
		
	ИначеЕсли ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			И ТекущийСтатусДокументооборота.НаименованиеСостоянияАнгл = "WaybillDeliveryWaitConsigneeSignature" Тогда 
		ДоступностьПодписатьОтправить = Истина;
		
	Иначе
		ДоступностьПодписатьОтправить = Ложь;
		
	КонецЕсли;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить.Видимость = ДоступностьПодписатьОтправить;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке.Видимость = ДоступностьПодписатьОтправить;
		
	Элементы.ПерезаполнитьПоДокОснованию.Видимость = НЕ ЭтоВходящий И ЕстьДокУчСист И Не ТолькоПросмотр;
	Элементы.ОбщаяКомандаКонтурЛогистика_ПерезаполнитьИзПредыдущего.Видимость = НЕ ЭтоВходящий И Не ЕстьДокУчСист И Не ТолькоПросмотр;
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(
		Объект.Ссылка, Объект.ДокументОснование,
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус, ТребуемоеДействие);
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
		ИЛИ (ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен И Справочники.КонтурЛогистика_ФайлыОбмена.ЭтоВходящийНеподписанный(КрайнийФайл))
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
		ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	ЗаполнитьДеревоСопоставленияТоваровСервер();
	
	Если ЗначениеЗаполнено(Объект.Грузополучатель) 
		И Объект.Грузополучатель <> Объект.ДокументЭТРН.Грузополучатель Тогда 
		НовыйГрузополучательВидим = Истина;
	Иначе
		НовыйГрузополучательВидим = Ложь;
	КонецЕсли;
	Если Объект.МестоВыгрузки <> Объект.ДокументЭТРН.МестоДоставки Тогда 
		ЕстьСменаМестаВыгрузки = Истина;
	Иначе
		ЕстьСменаМестаВыгрузки = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаДругойГрузополучатель.Видимость 	= НовыйГрузополучательВидим;
	Элементы.ЕстьСменаМестаВыгрузки.Видимость 	= ЕстьСменаМестаВыгрузки;
	
	ВсеПереадресации = Документы.КонтурЛогистика_ТрН_Титул7.ВсеПереадресации(Объект.ДокументЭТРН);
	ПерадресацииИВозвраты.Загрузить(ВсеПереадресации);
	
	ВсеЗамены = Документы.КонтурЛогистика_ТрН_Титул8.ВсеЗамены(Объект.ДокументЭТРН);
	ЗаменыВодителейТС.Загрузить(ВсеЗамены);
	
	Для Каждого Замена Из ЗаменыВодителейТС Цикл 
		Замена.ЕстьЗаменаВодителя 	= Замена.Ссылка.НовыеВодители.Количество();
		Замена.ЕстьЗаменаТС 		= Замена.Ссылка.НовыеТранспортныеСредства.Количество();
		Замена.ЕстьЗаменаПрицепа 	= Замена.Ссылка.НовыеПрицепы.Количество();
	КонецЦикла;
	
	Элементы.СтраницаПереадресации.Видимость 		= ЗначениеЗаполнено(ПерадресацииИВозвраты);
	Элементы.СтраницаЗаменыВодителейТС.Видимость 	= ЗначениеЗаполнено(ЗаменыВодителейТС);
	
	УстановитьЗаголовокНастройкеСопоставления();
	
	Если Объект.ЭтоПриемВозврата И Не Объект.РазбиватьГрузыПоСтрокам Тогда
		
		Элементы.ОстатокКоличествоМест.Видимость = Истина;
		Элементы.Титул1КоличествоМест.Видимость = Ложь;
		ОстатокКоличествоМест = Объект.КоличествоМестПринято;
		
	КонецЕсли;
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы.Видимость = СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы;
	
	КомментарииВодителяПриВыгрузке = Объект.ДокументЭТРН.КомментарииВодителяПриВыгрузке;
	Элементы.КомментарииВодителяПриВыгрузке.Видимость = ЗначениеЗаполнено(КомментарииВодителяПриВыгрузке);
	
	Если Элементы.Найти("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителюПанель") <> Неопределено Тогда
		Если ЗначениеЗаполнено(КомментарииВодителяПриВыгрузке) Тогда
			
			Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителюПанель.Видимость =
				(Не ТолькоПросмотр
					И (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
						Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный));
			
		Иначе
			Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителюПанель.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Перепроверить(Команда = Неопределено)
	
	РезультатПроверки = ПроверитьДокумент();
	
	// если есть ошибки или предупреждения то нажатие всегда показывает панель ошибок (в свернутом или развернутом виде)
	ВсегдаВыводитьРезультатВалидации = ВсегдаВыводитьРезультатВалидации();
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки, ВсегдаВыводитьРезультатВалидации);
	
КонецПроцедуры

&НаКлиенте
Функция ВсегдаВыводитьРезультатВалидации()
	
	Возврат ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный");
	
КонецФункции

&НаКлиенте
Процедура СкрытьПоказатьНеучитываемые(Команда)
	
	СкрытьНеучитываемые = Не СкрытьНеучитываемые;
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьНеучитываемыеУчДок(Команда)
	
	СкрытьНеучитываемыеУчДок = Не СкрытьНеучитываемыеУчДок;
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяЗаявленноеТекущим(Команда)
	
	ЗаявДатВрПриб = ТекущаяДатаВЧасовомПоясе(ЧасовойПоясРазгрузки);
	
	ЗаполнитьДатуПогрузкиОбъекта(ЭтаФорма, ЧасовойПоясРазгрузки, "ЗаявДатВрПриб");
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяПрибытияТекущим(Команда)
	
	ФДатВрПриб = ТекущаяДатаВЧасовомПоясе(ЧасовойПоясРазгрузки);
	ЗаполнитьДатуПогрузкиОбъекта(ЭтаФорма, ЧасовойПоясРазгрузки, "ФДатВрПриб");
	
	ПродолжительностьРазгрузки = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки(
		"СредняяПродолжительностьРазгрузки", ЗначениеРеквизитаСсылки(Объект.ДокументЭТРН,"ПартнерГрузополучатель"));
	Если ТипЗнч(ПродолжительностьРазгрузки) = Тип("Число") Тогда
		ФДатВрУбыт = ФДатВрПриб + ПродолжительностьРазгрузки * 60;
		ЗаполнитьДатуПогрузкиОбъекта(ЭтаФорма, ЧасовойПоясРазгрузки, "ФДатВрУбыт");
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяУбытияТекущим(Команда)
	
	ФДатВрУбыт = ТекущаяДатаВЧасовомПоясе(ЧасовойПоясРазгрузки);
	
	ЗаполнитьДатуПогрузкиОбъекта(ЭтаФорма, ЧасовойПоясРазгрузки, "ФДатВрУбыт");
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	ОбновитьДанныеФормы();
	ПриОткрытии(Ложь);
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Перезаполнить титул по выбранному документу основанию?",
			РежимДиалогаВопрос.ДаНетОтмена,
			"Подтвердите операцию",
			,
			ЭтаФорма,
			"ОбработчикСогласияПерезаполнения");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПоДокОснованию(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Действие полностью перезаполнит документ по Основанию. Вы АБСОЛЮТНО уверены?",
		РежимДиалогаВопрос.ДаНетОтмена,
		"Подтвердите операцию",
		,
		ЭтаФорма,
		"ОбработчикСогласияПерезаполнения");
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьСоответствияТекущейСтроки(Команда = Неопределено)
	
	ТекущиеДанные = Элементы.ТоварыУчетнойСистемы.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда
		
		ТекстПредупреждения = "Табличная часть пуста! Сначала добавьте товар.";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПредупреждения);	
		
	Иначе
	
		текНоменклатура 	= ТекущиеДанные.Номенклатура; 
		текЕдиница 			= ТекущиеДанные.УпаковкаЕдиницаИзмерения; 
		текХарактеристика 	= ТекущиеДанные.Характеристика; 
		
		КонтурЛогистика_КонвертацияКлиент.ОткрытьСоответствияНоменклатуры(текНоменклатура, текЕдиница, текХарактеристика, ЭтаФорма);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикИзмененияСоответствий(Параметр, ДопПараметр) Экспорт
	
	Если ЗначениеЗаполнено(ДопПараметр) Тогда
		
		локМассивСтрокСЭтойНоменклатурой = Объект.ТоварыДокументаУчетнойСистемы.НайтиСтроки(Новый Структура("Номенклатура", ДопПараметр));
		локМассивИдентификаторов = Новый Массив;
		
		Для Каждого СтрокаПереконвертации Из локМассивСтрокСЭтойНоменклатурой Цикл
			
			СконвертироватьСтрокуТоваровКлиент(СтрокаПереконвертации.ПолучитьИдентификатор());
			локМассивИдентификаторов.Добавить(СтрокаПереконвертации.ИдентификаторСтроки);
			
		КонецЦикла;
		
		ПолностьюОбновитьПредставлениеДанных();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СконвертироватьСтрокуТоваровКлиент(ИдентификаторСтрокиТоваров)
	
	ТекСтрока = Объект.ТоварыДокументаУчетнойСистемы.НайтиПоИдентификатору(ИдентификаторСтрокиТоваров);
	
	Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) И ЗначениеЗаполнено(ТекСтрока.УпаковкаЕдиницаИзмерения) Тогда
		СконвертироватьСтрокуТоваров1СвЛогистика(ИдентификаторСтрокиТоваров);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СконвертироватьСтрокуТоваров1СвЛогистика(ИдентификаторСтрокиТоваров)
	
	СтрокаТоваров = Объект.ТоварыДокументаУчетнойСистемы.НайтиПоИдентификатору(ИдентификаторСтрокиТоваров);
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.СконвертироватьСтрокуТоваровУчетнойСистемывЛогистика(СтрокаТоваров.НомерСтроки); 
	
	ЗаполнитьЗначенияСвойств(СтрокаТоваров, ДокОбъект.ТоварыДокументаУчетнойСистемы[СтрокаТоваров.НомерСтроки - 1])
	
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыДобавить(Команда)
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.Учитывать = Истина;	
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
		И КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ИспользуютсяХарактеристики() Тогда 
		НоваяСтрока.Характеристика =  КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПустаяХарактеристика();
	КонецЕсли;
	
	ПроверитьДокумент();
	ЗаполнитьТребуемыеДействияТоваров();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметкиДобавить(Команда)
	
	НоваяСтрока = Объект.ОтметкиГрузополучателя.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.ДатаИВремяОтметки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыУчДокДобавить(Команда)
	
	НоваяСтрока = Объект.ТоварыДокументаУчетнойСистемы.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.Учитывать = Истина;	
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() 
		И КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ИспользуютсяХарактеристики() Тогда 
		НоваяСтрока.Характеристика =  КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПустаяХарактеристика();
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСкопировать(Команда)
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.Учитывать = Истина;
	
	Если ТекСтрока <> Неопределено Тогда 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока,, "ИдентификаторСтроки");
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметкиСкопировать(Команда)
	ПроверитьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыУчДокСкопировать(Команда)
	ПроверитьДокумент();
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработчикСогласияПерезаполнения(Ответ, ДопПараметр = Неопределено) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		ПерезаполнитьПоДокОснованиюСервер();
		ОбновитьДанныеФормы();
	КонецЕсли;
	
	ОбновитьОтображениеДанных();
	ПолностьюОбновитьПредставлениеДанных();
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер()

	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда

		Объект.ТоварыДокументаУчетнойСистемы.Очистить();

		ДокОбъект = РеквизитФормыВЗначение("Объект");
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
									Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3);
		ДокОбъект.ЗаполнитьЧерезНастройкиКонвертации(НастройкаКонвертации);
		ДокОбъект.АвторасчетИтогов(НастройкаКонвертации);
	
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;

	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьЗаголовкиКоличества(Форма)
	
	Форма.Элементы.ТоварыУчетнойСистемыКоличествоМест.Заголовок = Формат(Форма.Объект.ТоварыДокументаУчетнойСистемы.Итог("КоличествоМест"),"ЧН=-");
	Форма.Элементы.ТоварыУчетнойСистемыМассаБруттоКг.Заголовок = Формат(Форма.Объект.ТоварыДокументаУчетнойСистемы.Итог("МассаБруттоКг"),"ЧН=-");
	
	Форма.Элементы.ТоварыКоличествоМест.Заголовок = Формат(Форма.Объект.Товары.Итог("КоличествоМест"),"ЧН=-");
	Форма.Элементы.ТоварыМассаБруттоКг.Заголовок = Формат(Форма.Объект.Товары.Итог("МассаБруттоКг"),"ЧН=-");
	
	Форма.Элементы.ДеревоСопоставленийТоваровКоличествоМестОтправителя.Заголовок 	= "" + Формат(Форма.Объект.Товары.Итог("КоличествоМест"),"ЧН=-");
	Форма.Элементы.ДеревоСопоставленийТоваровКоличествоМест.Заголовок 				= "" + Формат(Форма.Объект.ТоварыСоответствиеСтрокТоваров.Итог("КоличествоМест"),"ЧН=-");
	
	Форма.Элементы.ДеревоСопоставленийТоваровМассаБруттоКгОтправителя.Заголовок 	= "" + Формат(Форма.Объект.Товары.Итог("МассаБруттоКг"),"ЧН=-");
	Форма.Элементы.ДеревоСопоставленийТоваровМассаБруттоКг.Заголовок 				= "" + Формат(Форма.Объект.ТоварыСоответствиеСтрокТоваров.Итог("МассаБруттоКг"),"ЧН=-");
	
	Форма.Элементы.ДеревоСопоставленийТоваровМассаНеттоКгОтправителя.Заголовок 		= "" + Формат(Форма.Объект.Товары.Итог("МассаНеттоКг"),"ЧН=-");
	Форма.Элементы.ДеревоСопоставленийТоваровМассаНеттоКг.Заголовок 				= "" + Формат(Форма.Объект.ТоварыСоответствиеСтрокТоваров.Итог("МассаНеттоКг"),"ЧН=-");
	
	Форма.Элементы.ДеревоСопоставленийТоваровОбъемКубМОтправителя.Заголовок 		= "" + Формат(Форма.Объект.Товары.Итог("ОбъемКубМ"),"ЧН=-");
	Форма.Элементы.ДеревоСопоставленийТоваровОбъемКубМ.Заголовок 					= "" + Формат(Форма.Объект.ТоварыСоответствиеСтрокТоваров.Итог("ОбъемКубМ"),"ЧН=-");
	
	Форма.Элементы.ДеревоСопоставленийТоваровКоличествоПаллетОтправителя.Заголовок 	= "" + Формат(Форма.Объект.Товары.Итог("КоличествоПаллет"),"ЧН=-");
	Форма.Элементы.ДеревоСопоставленийТоваровКоличествоПаллет.Заголовок 			= "" + Формат(Форма.Объект.ТоварыСоответствиеСтрокТоваров.Итог("КоличествоПаллет"),"ЧН=-");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаСсылки(Ссылка, ИмяРеквизита)

	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Ссылка, ИмяРеквизита);

КонецФункции

&НаКлиенте
Функция ПроверитьДокумент()
	
	РезультатПроверки = ПроверитьДокументСервер();
	
	ВсегдаВыводитьРезультатВалидации = ВсегдаВыводитьРезультатВалидации();
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки, ВсегдаВыводитьРезультатВалидации);
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьПиктограммыОшибокТабличнойЧасти(Объект.Товары, ТаблицаОшибок, "Товары", "КартинкаОшибок");
	
	ЗаполнитьТребуемыеДействияТоваров(); 	// требуемые действия зависят от результатов проверки 
	УправлениеВидимостьюИДоступностью(); 		// доступность команд
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ПроверитьДокументСервер()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатыПроверкиДокумента = Документы.КонтурЛогистика_ТрН_Титул3.ПроверитьДокумент(ДокОбъект, ТаблицаОшибок, ТребуемоеДействие);
	
	РезультатПроверки = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаТовара.Картинка = 0;
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции

// Обслуживание панели ошибок

&НаКлиенте
Процедура ПанельОшибокМинимизировать(Команда)
	КонтурЛогистика_ПанельОшибокКлиент.МинимизироватьПанельОшибок(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПанельОшибокМаксимизировать(Команда)
	КонтурЛогистика_ПанельОшибокКлиент.ПоказатьПанельОшибок(ЭтаФорма);
