#Область ДатаВремяРазгрузки

&НаСервере
Процедура ЗаполнитьДатыРазгрузкиЛокальные()
	
	Если Не ЗначениеЗаполнено(Объект.ДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.МестоВыгрузки) Тогда
		ЧасовойПоясРазгрузки = Объект.МестоВыгрузки.ЧасовойПояс;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧасовойПоясРазгрузки) Тогда
		ЗаявДатВрПриб = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ЗаявДатВрПриб, Неопределено, ЧасовойПоясРазгрузки);
		ФДатВрПриб = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ФДатВрПриб, Неопределено, ЧасовойПоясРазгрузки);
		ФДатВрУбыт = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ФДатВрУбыт, Неопределено, ЧасовойПоясРазгрузки);
	Иначе
		ЗаявДатВрПриб = Объект.ЗаявДатВрПриб;
		ФДатВрПриб = Объект.ФДатВрПриб;
		ФДатВрУбыт = Объект.ФДатВрУбыт;
	КонецЕсли;
	
	Элементы.Группа5.Заголовок = ЗаголовокДатИВременПогрузки(ЧасовойПоясРазгрузки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДатуПогрузкиОбъекта(Форма, ЧасовойПоясРазгрузки, ИмяРеквизита)
	
	РеквизитФормы = Форма[ИмяРеквизита];
	
	Если ЗначениеЗаполнено(ЧасовойПоясРазгрузки) Тогда
		Форма.Объект[ИмяРеквизита] = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(РеквизитФормы, ЧасовойПоясРазгрузки);
	Иначе
		Форма.Объект[ИмяРеквизита] = РеквизитФормы;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокДатИВременПогрузки(ЧасовойПояс)
	
	Заголовок = "Даты и время разгрузки";
	
	Если ЗначениеЗаполнено(ЧасовойПояс) Тогда
		Заголовок = Заголовок + " " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(ЧасовойПояс);
	КонецЕсли;
	
	Возврат Заголовок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекущаяДатаВЧасовомПоясе(ЧасовойПояс)
	
	Если ЗначениеЗаполнено(ЧасовойПояс) Тогда
		Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(ТекущаяДата(), Неопределено, ЧасовойПояс);
	Иначе
		Возврат ТекущаяДата();
	КонецЕсли;
	
КонецФункции

#КонецОбласти
