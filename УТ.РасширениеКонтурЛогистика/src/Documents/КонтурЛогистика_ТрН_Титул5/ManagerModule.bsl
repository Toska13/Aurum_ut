		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"БИК", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
