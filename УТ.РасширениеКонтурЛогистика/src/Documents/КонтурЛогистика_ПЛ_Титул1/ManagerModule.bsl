
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	КонтурЛогистика_ОбработкаДокументовСервер.ОбработкаПолученияПредставленияДокументаТитулаПЛ(Данные, Представление, СтандартнаяОбработка, "1");
	
КонецПроцедуры

Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, ПараметрыФормированияФайлов = Неопределено) Экспорт
	
	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка, Истина);
	
	ТаблицаОшибок.Очистить();
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		КонтурЛогистика_ПанельОшибокСервер.ВывестиОшибкуТекущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок)
	КонецЕсли;
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		
		// TODO понять какие сценарии проверки входящего документа
		
	ИначеЕсли Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
		И Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда  
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, ТаблицаОшибок);
		
		ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		Если ДокументОбъектИлиСсылка.ВидПеревозки = Перечисления.КонтурЛогистика_ВидыПеревозки.КП
			И ДокументОбъектИлиСсылка.ВидКоммерческойПеревозки = Перечисления.КонтурЛогистика_ВидыКоммерческихПеревозок.ПГ Тогда
			
			ПроверитьМаршрут(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		КонецЕсли;
		
		ПроверитьИнфПол(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		Если ДокументОбъектИлиСсылка.ФормироватьТ2Сразу Или ДокументОбъектИлиСсылка.ФормироватьТ3Сразу Или ДокументОбъектИлиСсылка.ФормироватьТ4Сразу Тогда 
			ПроверитьСквознойСценарий(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		КонецЕсли;
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьДружбуКонтрагентов(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		ПроверитьАктивныйПредыдущийЭПЛ(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьОтправителя(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
	ИначеЕсли ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена Тогда 
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиДругихСторон(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьРоуминг(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ПроверитьНастроенныеПодразделения(Объект, ТаблицаОшибок);
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Объект.ЛицоОформившееПЛ);
	Если Не ПараметрыСервиса.АвторизацияВыполнена И ЗначениеЗаполнено(Объект.ЛицоОформившееПЛ) Тогда
		
		ОстатокУИДов = РегистрыСведений.КонтурЛогистика_УИДыГИС.ОсталосьСвободныхУИДов(Объект.ЛицоОформившееПЛ);
		
		Если ОстатокУИДов = 0 Тогда
			
			КатегорияОшибкиПула = КатегорияОшибка;
			Если ЗначениеЗаполнено(Объект.УИД_ПЛ) Тогда
				КатегорияОшибкиПула = КатегорияПредупреждение;
			КонецЕсли;
			
			ТекстОшибки = "Не осталось свободных УИД в пуле. Получите новые.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"УИД_ПЛ", КатегорияОшибкиПула, ТекстОшибки, "Получить УИДы");
			
		КонецЕсли;
		
		Если ОстатокУИДов > 0 И Не ЗначениеЗаполнено(Объект.УИД_ПЛ) Тогда 
			ТекстОшибки = "УИД будет взят из пула (при записи)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"УИД_ПЛ", КатегорияПредупреждение, ТекстОшибки, "Взять сейчас");
		КонецЕсли;
		
	КонецЕсли;

	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" ИЛИ Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			ОбязательныйРевизитСиноним = Документы.КонтурЛогистика_ПЛ_Титул1.СинонимРеквизита(ОбязательныйРевизит);
			ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ОбязательныйРевизит, КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.ВидПеревозки = Перечисления.КонтурЛогистика_ВидыПеревозки.КП Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ВидКоммерческойПеревозки) Тогда 
			ТекстОшибки = "Не указан вид коммерческой перевозки";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ВидКоммерческойПеревозки", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
		
		
		Если Объект.ВидКоммерческойПеревозки = Перечисления.КонтурЛогистика_ВидыКоммерческихПеревозок.ПГ Тогда
			
			Если Не ЗначениеЗаполнено(Объект.МестоОтправления) Тогда
				ТекстОшибки = "Не указано место отправления для коммерческой перевозки грузов";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"МестоОтправления", КатегорияОшибка, ТекстОшибки, "Указать");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(Объект.ЛицоОформившееПЛ) Тогда
		
		ТекстОшибки = "Укажите телефон организации оформляющей путевой лист";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"ЛицоОформившееПЛ.ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	
	Если Объект.ЭтоСменаВодителя И Не ЗначениеЗаполнено(Объект.ПредыдущийПЛ) Тогда
		
		ТекстОшибки = "Не указан предыдущий предыдущий Путевой лист";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"ПредыдущийПЛ", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	//ТС
	
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ТранспортноеСредство.ТипТС) Тогда
			
			ТекстОшибки = "Укажите тип транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТранспортноеСредство.ТипТ С", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ТранспортноеСредство.МаркаТС) Тогда
			
			ТекстОшибки = "Укажите марку транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТранспортноеСредство.МаркаТС", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ТранспортноеСредство.МодельТС) Тогда
			
			ТекстОшибки = "Укажите модель транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТранспортноеСредство.МодельТС", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ТранспортноеСредство.РегНомер) 
			И Не ЗначениеЗаполнено(Объект.ТранспортноеСредство.ИнвНомер) Тогда
			
			ТекстОшибки = "Укажите гос. рег. номер или инв. номер транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТранспортноеСредство.РегНомер", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ТранспортноеСредство.АрендодательЛизингодатель)
			И (Объект.ТранспортноеСредство.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Аренда_3
				Или Объект.ТранспортноеСредство.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Лизинг_4) Тогда
			
			ТекстОшибки = "Не указан владелец ТС - По умолчанию считаем что оформитель ПЛ и есть собственник.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТранспортноеСредство.АрендодательЛизингодатель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		КонецЕсли;
	КонецЕсли;
	
	// Прицепы
	ПроверитьПрицеп(Объект.Прицеп, ТаблицаОшибок, КатегорияОшибка, "Прицеп");
	ПроверитьПрицеп(Объект.Прицеп2, ТаблицаОшибок, КатегорияОшибка, "Прицеп2");
	
	// Водитель1 и 2
	КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьВодителя(Объект.Водитель, ТаблицаОшибок, КатегорияОшибка,, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, Объект);
	
	Если ЗначениеЗаполнено(Объект.Водитель2) Тогда 
		КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьВодителя(Объект.Водитель2, ТаблицаОшибок, КатегорияОшибка, "2", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, Объект);
	КонецЕсли;
	
	// ДополнительныеВодители
	Для Каждого Строка Из Объект.ДополнительныеВодители Цикл 
		
		КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьВодителя(Строка.Водитель, ТаблицаОшибок, КатегорияОшибка, Строка, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, Объект);
		
	КонецЦикла;
	
	// ГО если указан
	
	Если ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда 
		
		Если Не ЗначениеЗаполнено(Объект.Грузоотправитель.ТелефонОсновной) Тогда
			
			ТекстОшибки = "Укажите Телефон в Грузоотправителе или очистите ГО";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Грузоотправитель.ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.Грузоотправитель.ИНН) Тогда 
			
			ТекстОшибки = "Укажите ИНН в Грузоотправителе или очистите ГО";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Грузоотправитель.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;			
		
		Для Каждого ДопГО Из Объект.ДополнительныеГрузоотправители Цикл 
			
			Если ЗначениеЗаполнено(ДопГО.Грузоотправитель) Тогда 
				Если Не ЗначениеЗаполнено(ДопГО.Грузоотправитель.ТелефонОсновной) Тогда
					
					ТекстОшибки = "Укажите Телефон в дополнительном Грузоотправителе или очистите ГО";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "ДополнительныеГрузоотправители", ДопГО.НомерСтроки, 
					"Грузоотправитель.ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ДопГО.Грузоотправитель.ИНН) Тогда 
					
					ТекстОшибки = "Укажите ИНН в дополнительном Грузоотправителе или очистите ГО";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "ДополнительныеГрузоотправители", ДопГО.НомерСтроки, 
					"Грузоотправитель.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СрокПЛИнтервал) И Объект.СрокПЛИнтервал < Объект.СрокПЛ Тогда 
		
		ТекстОшибки = "Окончание срока ПЛ должно быть позже его начала";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"СрокПЛИнтервал", КатегорияОшибка, ТекстОшибки, "Исправить");
		
	КонецЕсли;
	
	// TODO
	// ГЛУБОКИЕ ВАЛИДАЦИИ, ВЗАИМНЫЕ ВАЛИДАЦИИ
	
КонецПроцедуры

Процедура ПроверитьИнфПол(Знач Объект, ТаблицаОшибок)
	
	МассивПроверок = Новый Массив;
	МассивПроверок.Добавить("ИнфПол");
	
	КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьИнфПол(Объект, МассивПроверок, ТаблицаОшибок);	
	
КонецПроцедуры	

Процедура ПроверитьНастроенныеПодразделения(Знач Объект, Знач ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;

	Если ЗначениеЗаполнено(Объект.ЛицоОформившееПЛ) Тогда
		НастроенноеПодразделениеОтпр = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиОрганизацииДиадок(
																							Объект.ЛицоОформившееПЛ,
																							Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.ПодразделениеОтправительПутевогоЛиста);
		Если Не ЗначениеЗаполнено(НастроенноеПодразделениеОтпр) Тогда 
			ТекстОшибки = "У орг.оформителя не указано Подразделение-отправитель по умолчанию в настройках";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ЛицоОформившееПЛ.Настройки", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
		
		НастроенноеПодразделениеПолуч = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиОрганизацииДиадок(
																							Объект.ЛицоОформившееПЛ,
																							Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.ПодразделениеПолучательПутевогоЛиста);
		Если Не ЗначениеЗаполнено(НастроенноеПодразделениеПолуч) Тогда 
			ТекстОшибки = "У орг.оформителя не указано Подразделение-получатель по умолчанию в настройках";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ЛицоОформившееПЛ.Настройки", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НастроенноеПодразделениеОтпр) И ЗначениеЗаполнено(НастроенноеПодразделениеПолуч) 
			И НастроенноеПодразделениеОтпр = НастроенноеПодразделениеПолуч Тогда 
			ТекстОшибки = "У орг.оформителя Подразделение-отправитель по умолчанию в настройках совпадает с Подразделением-получателем";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ЛицоОформившееПЛ.Настройки", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМаршрут(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ИмяТЧ = "АдресаПунктов";
	
	// Пункт(ы) погрузки
	Для Каждого СтрокаМаршрута Из Объект.АдресаПунктов Цикл 
		
		ТекущийНомерСтроки = СтрокаМаршрута.НомерСтроки;
		
		Если Не ЗначениеЗаполнено(СтрокаМаршрута.ПунктМаршрута) Тогда 
			ТекстОшибки = "Укажите пункт маршрута";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
			"ПунктМаршрута", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьПрицеп(Прицеп, ТаблицаОшибок, КатегорияОшибка, ИмяПоля)
	
	Если Не ЗначениеЗаполнено(Прицеп) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Прицеп.МаркаТС) Тогда
		
		ТекстОшибки = "Укажите марку прицепа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ИмяПоля + ".МаркаТС", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Прицеп.МодельТС) Тогда
		
		ТекстОшибки = "Укажите модель прицепа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ИмяПоля + ".МодельТС", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Прицеп.РегНомер) Тогда
		
		ТекстОшибки = "Укажите гос. рег. номер прицепа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ИмяПоля + ".РегНомер", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСквознойСценарий(Знач Объект, ТаблицаОшибок)
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		Если Не ЗначениеЗаполнено(Объект.ЛицоОформившееПЛ) Тогда
			Возврат;
		КонецЕсли;
		
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
		
		// Титул 1
		Если ТипЗнч(Объект) = Тип("ДокументОбъект.КонтурЛогистика_ПЛ_Титул1") Тогда
			Объект.ДополнительныеСвойства.Вставить("ТихийРежим");	// Без лишних сообщений
			Объект.ДополнительныеСвойства.Вставить("ПроверкаСквозногоСценария");
			Объект.Записать();
		КонецЕсли;
		
		// Титул 2
		Если Объект.ФормироватьТ2Сразу Тогда
			
			ПредыдущиеТитулы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
			УточнениеТипаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2;
			ДополнительныеДанные = Новый Структура;
			ДополнительныеДанные.Вставить("Водитель", Объект.Водитель);
			ДополнительныеДанные.Вставить("ПроверкаЗаполнения");
			ДанныеЗаполнения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеДанные);
			
			НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(УточнениеТипаЛогистика);
			
			Если НастройкаКонвертации = Неопределено Тогда
				ТекстОшибки = "Не найдена настройка конвертации титула 2";
				ДополнительныеПараметры = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УточнениеТипаЛогистика);
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"СоздатьНастройкуКонвертации", КатегорияОшибка, ТекстОшибки, "Настроить",,,, ДополнительныеПараметры);
			Иначе
				РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
					ПредыдущиеТитулы, УточнениеТипаЛогистика, Ложь, ДанныеЗаполнения);
				
				Если РезультатВвода.ВведенныеДокументы.Количество() > 0 Тогда
					ТаблицаОшибокТ2 = Неопределено;
					Титул2 = РезультатВвода.ВведенныеДокументы[0];
					Документы.КонтурЛогистика_ПЛ_Титул2.ПроверитьДокумент(Титул2, ТаблицаОшибокТ2,, Истина);
					
					Для Каждого ТекущаяОшибка Из ТаблицаОшибокТ2 Цикл
						СтрокаОшибки = ТаблицаОшибок.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаОшибки, ТекущаяОшибка);
						СтрокаОшибки.ИмяПоля = "ДанныеТ2" + СтрокаОшибки.ИмяПоля;
					КонецЦикла;
					
					Если Не ЗначениеЗаполнено(Объект.ДанныеТ2ПользовательПодписант) Тогда
						ТекстОшибки = "Укажите Пользователь подписант для Медосмотра";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
							"ДанныеТ2ПользовательПодписант", КатегорияОшибка, ТекстОшибки, "Указать");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Титул 3
		Если Объект.ФормироватьТ3Сразу Тогда
			
			ПредыдущиеТитулы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
			УточнениеТипаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3;
			ДополнительныеДанные = Новый Структура;
			ДополнительныеДанные.Вставить("ПроверкаЗаполнения");
			ДанныеЗаполнения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеДанные);
			
			НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(УточнениеТипаЛогистика);
			
			Если НастройкаКонвертации = Неопределено Тогда
				ТекстОшибки = "Не найдена настройка конвертации титула 3";
				ДополнительныеПараметры = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УточнениеТипаЛогистика);
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"СоздатьНастройкуКонвертации", КатегорияОшибка, ТекстОшибки, "Настроить",,,, ДополнительныеПараметры);
			Иначе
				РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
					ПредыдущиеТитулы, УточнениеТипаЛогистика, Ложь, ДанныеЗаполнения);
				
				Если РезультатВвода.ВведенныеДокументы.Количество() > 0 Тогда
					ТаблицаОшибокТ3 = Неопределено;
					Титул3 = РезультатВвода.ВведенныеДокументы[0];
					Документы.КонтурЛогистика_ПЛ_Титул3.ПроверитьДокумент(Титул3, ТаблицаОшибокТ3,, Истина);
					
					Для Каждого ТекущаяОшибка Из ТаблицаОшибокТ3 Цикл
						СтрокаОшибки = ТаблицаОшибок.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаОшибки, ТекущаяОшибка);
						СтрокаОшибки.ИмяПоля = "ДанныеТ3" + СтрокаОшибки.ИмяПоля;
					КонецЦикла;
					
					Если Не ЗначениеЗаполнено(Объект.ДанныеТ3ПользовательПодписант) Тогда
						ТекстОшибки = "Укажите Пользователь подписант для Тех контроль";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
							"ДанныеТ3ПользовательПодписант", КатегорияОшибка, ТекстОшибки, "Указать");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Титул 4
		Если Объект.ФормироватьТ4Сразу Тогда
			
			ПредыдущиеТитулы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
			УточнениеТипаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4;
			ДополнительныеДанные = Новый Структура;
			ДополнительныеДанные.Вставить("ПроверкаЗаполнения");
			ДанныеЗаполнения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеДанные);
			
			НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(УточнениеТипаЛогистика);
			
			Если НастройкаКонвертации = Неопределено Тогда
				ТекстОшибки = "Не найдена настройка конвертации титула 4";
				ДополнительныеПараметры = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УточнениеТипаЛогистика);
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"СоздатьНастройкуКонвертации", КатегорияОшибка, ТекстОшибки, "Настроить",,,, ДополнительныеПараметры);
			Иначе
				
				Если Не Объект.ФормироватьТ2Сразу Тогда
					ТекстОшибки = "Не выбрано автоматическое подписание медосмотра";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
						"ФормироватьТ2Сразу", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;		
				
				Если Не Объект.ФормироватьТ3Сразу Тогда
					ТекстОшибки = "Не выбрано автоматическое подписание тех. контроля";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
						"ФормироватьТ3Сразу", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;		
				
				Если Объект.ФормироватьТ2Сразу И Объект.ФормироватьТ3Сразу Тогда
					
					РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
						ПредыдущиеТитулы, УточнениеТипаЛогистика, Ложь, ДанныеЗаполнения);
					
					Если РезультатВвода.ВведенныеДокументы.Количество() > 0 Тогда
						ТаблицаОшибокТ4 = Неопределено;
						Титул4 = РезультатВвода.ВведенныеДокументы[0];
						Документы.КонтурЛогистика_ПЛ_Титул4.ПроверитьДокумент(Титул4, ТаблицаОшибокТ4,,, Истина, Истина);
						
						Для Каждого ТекущаяОшибка Из ТаблицаОшибокТ4 Цикл
							СтрокаОшибки = ТаблицаОшибок.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаОшибки, ТекущаяОшибка);
							СтрокаОшибки.ИмяПоля = "ДанныеТ4" + СтрокаОшибки.ИмяПоля;
						КонецЦикла;
						
						Если Не ЗначениеЗаполнено(Объект.ДанныеТ4ПользовательПодписант) Тогда
							ТекстОшибки = "Укажите Пользователь подписант для Показания одометра";
							КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
								"ДанныеТ4ПользовательПодписант", КатегорияОшибка, ТекстОшибки, "Указать");
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЕсли;
		КонецЕсли;
		
		// Так как нам надо отменить изменения сделанные при валидации
		ОтменитьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьАктивныйПредыдущийЭПЛ(Знач Объект, ТаблицаОшибок) Экспорт
	
	ЗначениеНастройкиКонтроля = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("КонтрольЕстьАктивныйПЛ");
	
	Если Не ЗначениеЗаполнено(ЗначениеНастройкиКонтроля)
		Или ЗначениеНастройкиКонтроля = Перечисления.КонтурЛогистика_ВариантыВалидации.НеПроверять Тогда 
		
		Возврат; // не включено
		
	КонецЕсли;
	
	Если ЗначениеНастройкиКонтроля = Перечисления.КонтурЛогистика_ВариантыВалидации.Предупреждать Тогда
		КатегорияОшибкиОбъекта = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	Иначе 
		КатегорияОшибкиОбъекта = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КонецЕсли;
	
	
	Водитель1 	= Объект.Водитель;
	Водитель2	= Объект.Водитель2;
	ТС 			= Объект.ТранспортноеСредство;
	Прицеп 		= Объект.Прицеп;
	ДатаПЛ 		= Объект.ДатаПЛ;
	Если Не ЗначениеЗаполнено(ДатаПЛ) 
		Или НачалоДня(ДатаПЛ) = НачалоДня(ТекущаяДата()) Тогда 
		ДатаПЛ = ТекущаяДата();
	КонецЕсли;
	
	СрокПЛ		= Объект.СрокПЛ;
	Если Не ЗначениеЗаполнено(СрокПЛ) Тогда 
		СрокПЛ = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ПЛ_Титул1.Ссылка КАК Ссылка,
	               |	КонтурЛогистика_ПЛ_Титул1.Водитель КАК Водитель,
	               |	КонтурЛогистика_ПЛ_Титул1.Водитель2 КАК Водитель2,
	               |	КонтурЛогистика_ПЛ_Титул1.ТранспортноеСредство КАК ТранспортноеСредство,
	               |	КонтурЛогистика_ПЛ_Титул1.Прицеп КАК Прицеп,
	               |	КонтурЛогистика_ПЛ_Титул1.СрокПЛ КАК СрокПЛ,
	               |	КонтурЛогистика_ПЛ_Титул1.СрокПЛИнтервал КАК СрокПЛИнтервал
	               |ПОМЕСТИТЬ ВТ_СвежиеПЛ
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул1.ДатаПЛ >= &Дата30Дней
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СвежиеПЛ.Ссылка КАК Ссылка,
	               |	ВТ_СвежиеПЛ.Водитель КАК Водитель,
	               |	ВТ_СвежиеПЛ.Водитель2 КАК Водитель2,
	               |	ВТ_СвежиеПЛ.ТранспортноеСредство КАК ТранспортноеСредство,
	               |	ВТ_СвежиеПЛ.Прицеп КАК Прицеп,
	               |	ВТ_СвежиеПЛ.СрокПЛ КАК СрокПЛ,
	               |	ВТ_СвежиеПЛ.СрокПЛИнтервал КАК СрокПЛИнтервал
	               |ПОМЕСТИТЬ ВТ_АктивныеСвежиеПЛ
	               |ИЗ
	               |	ВТ_СвежиеПЛ КАК ВТ_СвежиеПЛ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних(, ) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
	               |		ПО ВТ_СвежиеПЛ.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
	               |ГДЕ
	               |	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &СостояниеВПути
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_СвежиеПЛ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_АктивныеСвежиеПЛ.Ссылка КАК Ссылка,
	               |	ВТ_АктивныеСвежиеПЛ.Водитель КАК Водитель,
	               |	ВТ_АктивныеСвежиеПЛ.Водитель2 КАК Водитель2,
	               |	ВТ_АктивныеСвежиеПЛ.ТранспортноеСредство КАК ТранспортноеСредство,
	               |	ВТ_АктивныеСвежиеПЛ.Прицеп КАК Прицеп,
	               |	ВТ_АктивныеСвежиеПЛ.СрокПЛ КАК СрокПЛ,
	               |	ВТ_АктивныеСвежиеПЛ.СрокПЛИнтервал КАК СрокПЛИнтервал
	               |ИЗ
	               |	ВТ_АктивныеСвежиеПЛ КАК ВТ_АктивныеСвежиеПЛ
	               |ГДЕ
	               |	(ВТ_АктивныеСвежиеПЛ.Водитель = &Водитель
	               |				И ВТ_АктивныеСвежиеПЛ.Водитель <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка)
	               |			ИЛИ ВТ_АктивныеСвежиеПЛ.Водитель = &Водитель2
	               |				И ВТ_АктивныеСвежиеПЛ.Водитель <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка)
	               |			ИЛИ ВТ_АктивныеСвежиеПЛ.Водитель2 = &Водитель
	               |				И ВТ_АктивныеСвежиеПЛ.Водитель2 <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка)
	               |			ИЛИ ВТ_АктивныеСвежиеПЛ.Водитель2 = &Водитель2
	               |				И ВТ_АктивныеСвежиеПЛ.Водитель2 <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка)
	               |			ИЛИ ВТ_АктивныеСвежиеПЛ.ТранспортноеСредство = &ТС
	               |				И ВТ_АктивныеСвежиеПЛ.ТранспортноеСредство <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка))
	               |	И (ВТ_АктивныеСвежиеПЛ.СрокПЛ = &СрокПЛ
	               |			ИЛИ &СрокПЛ МЕЖДУ ВТ_АктивныеСвежиеПЛ.СрокПЛ И ВТ_АктивныеСвежиеПЛ.СрокПЛИнтервал)";
	
	Запрос.УстановитьПараметр("ДатаЭПЛ", ДатаПЛ);
	Запрос.УстановитьПараметр("Дата30Дней", ДатаПЛ - 2592000); // минус 30 суток
	Запрос.УстановитьПараметр("Водитель", Водитель1);
	Запрос.УстановитьПараметр("Водитель2", Водитель2);
	Запрос.УстановитьПараметр("ТС", ТС);
	Запрос.УстановитьПараметр("СрокПЛ", СрокПЛ);
	Запрос.УстановитьПараметр("СостояниеВПути", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-on-the-way"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		                                                                                 
		ТекстОшибки = "Уже есть активный ЭПЛ: " + Выборка.Ссылка + " (включена проверка): " + Символы.ПС
		+ Выборка.Водитель + ?(ЗначениеЗаполнено(Выборка.Водитель2), " " + Выборка.Водитель2 ,"") + ", " + Символы.ПС 
		+ Выборка.ТранспортноеСредство + ", " + Символы.ПС
		+ ?(ЗначениеЗаполнено(Выборка.СрокПЛИнтервал),
			"интервал действия с " + Формат(Выборка.СрокПЛ, "ДФ=dd.MM.yyyy") + " по " + Формат(Выборка.СрокПЛИнтервал, "ДФ=dd.MM.yyyy"),
			"действует " + Формат(Выборка.СрокПЛ, "ДФ=dd.MM.yyyy"));
		
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"" , КатегорияОшибкиОбъекта, ТекстОшибки, "Проверить");
		
		Если Выборка.Количество() > 1 Тогда
			
			ЕщеПЛ = Выборка.Количество() - 1;
			ТекстОшибки = "Есть еще " + ЕщеПЛ + " активных путевых листов с таким же Водителем/ТС/Прицепом (включена проверка)";			
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"" , КатегорияОшибкиОбъекта, ТекстОшибки, "Проверить");
			
			Прервать;
			
		КонецЕсли;
		
	
	КонецЦикла;
	
КонецПроцедуры

