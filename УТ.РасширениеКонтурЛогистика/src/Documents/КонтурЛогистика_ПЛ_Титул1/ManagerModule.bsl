Функция ПолучитьСледующийПоЦепочкеТипТитулаПЛ(ДокПЛТ1Ссылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(ДокПЛТ1Ссылка) Тогда 
		ВызватьИсключение "Не заполнен Документ - не могу определить титул";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2) КАК ТипТитула
	               |ПОМЕСТИТЬ ВТ_ВсеТитулыПЛ
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул1.Ссылка = &ДокументПЛТ1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА КонтурЛогистика_ПЛ_Титул2.Титул1.ЭтоСменаВодителя
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3)
	               |	КОНЕЦ
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул2.Титул1 = &ДокументПЛТ1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул2.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4)
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул3 КАК КонтурЛогистика_ПЛ_Титул3
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул3.Титул1 = &ДокументПЛТ1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул3.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5)
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул4 КАК КонтурЛогистика_ПЛ_Титул4
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул4.Титул1 = &ДокументПЛТ1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул4.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6)
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул5 КАК КонтурЛогистика_ПЛ_Титул5
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул5.Титул1 = &ДокументПЛТ1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул5.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВсеТитулыЭТРН.ТипТитула КАК ТипТитула
	               |ИЗ
	               |	ВТ_ВсеТитулыПЛ КАК ВТ_ВсеТитулыЭТРН
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ_ВсеТитулыЭТРН.ТипТитула.Порядок УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументПЛТ1", ДокПЛТ1Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ТипТитула;
	Иначе
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
	КонецЕсли;
	
КонецФункции

