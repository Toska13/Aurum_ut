&НаСервере
Процедура ПерезаполнитьПоДокОснованиюСервер()
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Или РучнойВвод Тогда
		
		Объект.ДополнительныеВодители.Очистить();
		Объект.ДополнительныеГрузоотправители.Очистить();
		Объект.АдресаПунктов.Очистить();
		Объект.ДополнительныеПолучателиФайла.Очистить();
		Объект.ИнфПол.Очистить();
		
		ДокОбъект = РеквизитФормыВЗначение("Объект");
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ДокументОснование", ДокОбъект.ДокументОснование);
		ДанныеЗаполнения.Вставить("ТипЛогистика", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
		ДанныеЗаполнения.Вставить("Разделитель", ДокОбъект.Разделитель);
		
		ДокОбъект.Заполнить(ДанныеЗаполнения);
		
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОшибокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаОшибок.ТекущиеДанные;
	
	Если Поле.Имя = "ТаблицаОшибокТекстОшибки" Тогда 
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекущиеДанные.ТекстОшибки, "Полный текст проблемы");
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ИмяПоля = "ДанныеТ2Подписант"
		Или ТекущиеДанные.ИмяПоля = "ДанныеТ3Подписант"
		Или ТекущиеДанные.ИмяПоля = "ДанныеТ4Подписант" Тогда
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("ДатаГлавного", Объект.ДатаПЛ);
		ПараметрыРасчета.Вставить("ПользовательПодписант", Объект.ДанныеТ2ПользовательПодписант);
		ПараметрыРасчета.Вставить("ПараметрНастроекПодписания", Объект.ДанныеТ2ПараметрНастроекПодписания);
		
		Если ТекущиеДанные.ИмяПоля = "ДанныеТ2Подписант" Тогда
			ПараметрыРасчета.Вставить("ОрганизацияГлавного",
				?(ЗначениеЗаполнено(Объект.ОрганизацияМедик), Объект.ОрганизацияМедик, Объект.ЛицоОформившееПЛ));
		ИначеЕсли ТекущиеДанные.ИмяПоля = "ДанныеТ3Подписант" Тогда
			ПараметрыРасчета.Вставить("ОрганизацияГлавного",
				?(ЗначениеЗаполнено(Объект.ОрганизацияТехСостояние), Объект.ОрганизацияТехСостояние, Объект.ЛицоОформившееПЛ));
		ИначеЕсли ТекущиеДанные.ИмяПоля = "ДанныеТ4Подписант" Тогда
			ПараметрыРасчета.Вставить("ОрганизацияГлавного",
				?(ЗначениеЗаполнено(Объект.ОрганизацияОдометр), Объект.ОрганизацияОдометр, Объект.ЛицоОформившееПЛ));
		КонецЕсли;
		
		КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыборПодписанта(ЭтаФорма, Объект, ПараметрыРасчета);
		
	Иначе
		
		КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, Поле.Имя, "ПослеВыбораВТаблицеОшибок");
		
	КонецЕсли;
	
КонецПроцедуры

