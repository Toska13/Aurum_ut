&НаКлиенте
Функция ПроверитьДокумент()
	
	РезультатПроверки = ПроверитьДокументСервер();
	
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(ТекущийСтатус, ЭтаФорма, РезультатПроверки);
	
	УправлениеВидимостьюИДоступностью(); 	// доступность команд
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Процедура РассчитатьПартнераМедика()

	Если ЗначениеЗаполнено(Объект.ОрганизацияМедик) Тогда 
		Объект.ПартнерМедик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(Объект.ОрганизацияМедик);
	Иначе
		Объект.ПартнерМедик = Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьДокументСервер()

	ДокОбъект = РеквизитФормыВЗначение("Объект");

	РезультатыПроверкиДокумента = Документы.КонтурЛогистика_ПЛ_Титул1.ПроверитьДокумент(ДокОбъект, ТаблицаОшибок);

	РезультатПроверки = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);

	Возврат РезультатПроверки;

КонецФункции

