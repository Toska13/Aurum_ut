#Область СквознойСценарий

&НаКлиенте
Процедура ОбновитьЭлементыСквозногоСценария()
	
	Элементы.ГруппаСквознойСценарий.Видимость = Не Объект.ЭтоСменаВодителя;
	
	// Медосмотр
	СтороннийМедик = СтороннийМедик();
	Элементы.ГруппаСквознойСценарийМедик.Доступность = Не СтороннийМедик;
	
	Элементы.ФормироватьТ2СразуФлажекВыкл.Видимость = Не Объект.ФормироватьТ2Сразу;
	Элементы.ФормироватьТ2СразуФлажекВкл.Видимость = Объект.ФормироватьТ2Сразу;
	Элементы.ГруппаСквознойСценарийМедикДанные.Видимость = Объект.ФормироватьТ2Сразу;
	
	// Тех контроль и показания одометра
	СтороннийТехКонтроль = СтороннийТехКонтроль();
	СтороннийПоказанияОдометра = СтороннийПоказанияОдометра();
	Элементы.ГруппаСквознойСценарийТехКонтроль.Доступность = Не СтороннийТехКонтроль И Не СтороннийПоказанияОдометра;
	
	Элементы.ФормироватьТ3СразуФлажекВыкл.Видимость = Не Объект.ФормироватьТ3Сразу;
	Элементы.ФормироватьТ3СразуФлажекВкл.Видимость = Объект.ФормироватьТ3Сразу;
	Элементы.ФормироватьТ4СразуФлажекВыкл.Видимость = Не Объект.ФормироватьТ4Сразу;
	Элементы.ФормироватьТ4СразуФлажекВкл.Видимость = Объект.ФормироватьТ4Сразу;
	Элементы.ГруппаСквознойСценарийТехКонтрольДанные.Видимость = Объект.ФормироватьТ3Сразу;
	Элементы.ГруппаСквознойСценарийПоказанияОдометраДанные.Видимость = Объект.ФормироватьТ4Сразу;
			
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьТ2СразуФлажекВклВыклНажатие(Элемент)
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьТехосмотрДоМедОсмотра")
		И Объект.ФормироватьТ2Сразу
		И Объект.ФормироватьТ3Сразу Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			"Нельзя отключить оформление медосмотра при автоматическом подписании тех. контроль.
			|Для этого необходимо в настройках включить опцию ""Разрешить техосмотр до мед. осмотра"".");
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Объект.ФормироватьТ2Сразу = Не Объект.ФормироватьТ2Сразу;
	
	Если Не Объект.ФормироватьТ2Сразу И Объект.ФормироватьТ4Сразу Тогда
		Объект.ФормироватьТ4Сразу = Ложь;
	КонецЕсли;
	
	ОбновитьЭлементыСквозногоСценария();
	
	ПроверитьДокумент();
	
КонецПроцедуры

