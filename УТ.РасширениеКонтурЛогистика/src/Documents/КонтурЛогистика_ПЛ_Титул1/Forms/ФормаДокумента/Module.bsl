&НаКлиенте
Процедура ОбработатьТребуемоеДействие(ТребуемоеДействие, ПолеТаблицыОшибок = Неопределено)
	
	// реализуем отдельную обработку некоторых требуемых действий
	Если Ложь Тогда // Какие-то особенные UI для требуемых действий, например: ТребуемоеДействие = "Исправить GTIN" Тогда

	Иначе // типовая обработка таблицы ошибок

		Если ПолеТаблицыОшибок <> Неопределено Тогда
			КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, ПолеТаблицыОшибок.Имя);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// УПРАВЛЕНИЕ ВИДИМОСТЬЮ И ДОСТУПНОСТЬЮ
&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()

	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	// зависимости от формата ПЛ
	Элементы.ПредыдущийПЛ.Видимость = Объект.ЭтоСменаВодителя;
	
	ЭтоКоммерческаяПеревозка = Объект.ВидПеревозки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыПеревозки.КП");
	
	Элементы.ВидКоммерческойПеревозки.Видимость = ЭтоКоммерческаяПеревозка;
	
	ЭтоПеревозкаПоДоговору = Объект.ВидКоммерческойПеревозки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыКоммерческихПеревозок.ПГ");
	Элементы.ГруппаМестоОтправления.Видимость = ЭтоКоммерческаяПеревозка И ЭтоПеревозкаПоДоговору;
	Элементы.ГруппаПунктыМаршрута.Видимость = ЭтоКоммерческаяПеревозка И ЭтоПеревозкаПоДоговору;
	
	// Причина отказа в подписи
	Элементы.ГруппаПричинаОтказаВПодписи.Видимость = Объект.ЕстьОтказВПодписи;
	Элементы.ГруппаПричинаОтказаВПодписиТехника.Видимость = ЗначениеЗаполнено(ПричинаОтказаВПодписиТехКонтроля);
	
	СкрытьПоказатьЗначенияДокУчСист();
	
	Если Не ЗначениеЗаполнено(Объект.ОрганизацияМедик) 
		И Не ЗначениеЗаполнено(Объект.ОрганизацияТехСостояние)
		И Не ЗначениеЗаполнено(Объект.ОрганизацияОдометр)
		Тогда 
		СкрытьДопСтороны = Истина;
	Иначе
		СкрытьДопСтороны = Ложь;
	КонецЕсли;
	Элементы.ГруппаДопСтороны.Видимость = Не СкрытьДопСтороны;
	Элементы.ГруппаВключитьВидимостьСторон.Видимость = Не Элементы.ГруппаДопСтороны.Видимость;
	
	Если Не ИдетВыборВодителя2 Тогда
		Элементы.ГруппаВодитель2.Видимость = ЗначениеЗаполнено(Объект.Водитель2);
		Элементы.КартинкаВодительПлюс1.Видимость = Не Элементы.ГруппаВодитель2.Видимость;
	КонецЕсли;
	
	Элементы.ГруппаПрицеп2.Видимость = ЗначениеЗаполнено(Объект.Прицеп2);
	Элементы.КартинкаПрицепПлюс1.Видимость = Не Элементы.ГруппаПрицеп2.Видимость;
	
	Элементы.СрокПЛИнтервал.Видимость = ЗначениеЗаполнено(Объект.СрокПЛИнтервал);
	Элементы.СрокПЛ.Заголовок = ?(ЗначениеЗаполнено(Объект.СрокПЛИнтервал), "С","День");
	Элементы.ГруппаСрокИнтервал.Видимость = Не Элементы.СрокПЛИнтервал.Видимость;
	
