&НаКлиенте
Процедура ПоказатьДопПоля(Команда)
	
	Элементы.Страницы.Видимость = Не Элементы.Страницы.Видимость;
	Если Элементы.Страницы.Видимость Тогда 
		КомандаЗаголовок = "Скрыть доп. реквизиты";
	Иначе
		КомандаЗаголовок = "Показать доп. реквизиты";		
	КонецЕсли;
	Элементы.ПоказатьДопПоля.Заголовок = КомандаЗаголовок;
	
	ДополнитьЗаголовокПоказатьДопПоля();
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьЗаголовокПоказатьДопПоля()
	
	массивГосСист = Новый Массив;
	массивГосСист.Добавить("ЕГАИС");
	массивГосСист.Добавить("ВетИС");
	массивГосСист.Добавить("ГИС МТ");
	
	тзИдентификаторыГосСист = Новый ТаблицаЗначений;
	тзИдентификаторыГосСист.Колонки.Добавить("ГосСист");
	тзИдентификаторыГосСист.Колонки.Добавить("Номер");
	тзИдентификаторыГосСист.Колонки.Добавить("Колво");
	
	КраткоеОписание = "";
		
	Для каждого ГосСист Из массивГосСист Цикл
	
		Отбор = Новый Структура;
		Отбор.Вставить("Идентиф",ГосСист);
		
		Строки = Объект.ИнфПол.НайтиСтроки(Отбор);
		
		Если Строки.Количество() = 0 Тогда
			
		ИначеЕсли Строки.Количество() = 1 Тогда
			
			НоваяСтрока = тзИдентификаторыГосСист.Добавить();
			НоваяСтрока.ГосСист = ГосСист;
			НоваяСтрока.Номер = Строки[0].Значение;
			НоваяСтрока.Колво = 1;
			
		Иначе
			НоваяСтрока = тзИдентификаторыГосСист.Добавить();
			НоваяСтрока.ГосСист = ГосСист;
			НоваяСтрока.Колво = Строка(Строки.Количество());
		КонецЕсли;
		
	КонецЦикла;
	
	Если тзИдентификаторыГосСист.Количество() = 1 И тзИдентификаторыГосСист[0].Колво = 1 Тогда
		КраткоеОписание = тзИдентификаторыГосСист[0].ГосСист + " " + тзИдентификаторыГосСист[0].Номер;	
	Иначе
	
		Для каждого Стр Из тзИдентификаторыГосСист Цикл
			КраткоеОписание = ?(ЗначениеЗаполнено(КраткоеОписание), КраткоеОписание + "; " + Стр.ГосСист + " " + Стр.Колво + " шт.", КраткоеОписание + Стр.ГосСист + " " + Стр.Колво + " шт.");	
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КраткоеОписание) Тогда
		Элементы.ПоказатьДопПоля.Заголовок =  ?(Элементы.Страницы.Видимость, "Скрыть доп. реквизиты", "Показать доп. реквизиты" + " (" + КраткоеОписание + ")");
	КонецЕсли;
				
КонецПроцедуры

