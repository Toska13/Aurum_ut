
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.Страницы.Видимость = Ложь;
	ОбновитьДанныеФормы();

	СвязанныеДокументыТитулы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);

	РазблокироватьДанныеФормыДляРедактирования();

	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	УправлениеЭлементамиФормыВЗависимостиОтСтатуса();
	
	// Отказ медосмотр или техника
	Элементы.ГруппаСоздатьНовый.Видимость = (ЗначениеЗаполнено(Объект.Ссылка)
		И ТребуетсяПереотправить(ТекущийКодСостоянияДокументооборота));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// баги старой платформы при отрисовке сложных группировок:
	// в режиме интерфейса 8.2 отображаем в режиме "на отдельных закладках" шапку и тч
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
		ШапкаНаОтдельнойЗакладке = Истина;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаШапка;
	КонецЕсли;
	
	Элементы.ДанныеТ2ПараметрНастроекПодписания.Видимость = Ложь;
	Элементы.ДанныеТ3ПараметрНастроекПодписания.Видимость = Ложь;
	Элементы.ДанныеТ4ПараметрНастроекПодписания.Видимость = Ложь;
	
	ПроверитьДокумент();
	
	ВывестиВидВладенияТС();
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ТекущийКодСостоянияДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.Ссылка).Код;
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
		Или ТребуетсяПереотправить(ТекущийКодСостоянияДокументооборота) 
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;

	ЭтоВходящий = ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен;
	
	// TODO
	//ЕстьДокУчСист = ЗначениеЗаполнено(Объект.ДокументОснование);
	//Элементы.ФормаОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = ЭтоВходящий И Не ЕстьДокУчСист;

	//Элементы.ПерезаполнитьПоДокОснованию.Видимость = Не ЭтоВходящий И ЕстьДокУчСист;
	//Элементы.ОбщаяКомандаКонтурЛогистика_НайтиДокументУчетнойСистемы.Видимость = Не ЕстьДокУчСист;
	Элементы.ПользовательПодписант.Видимость = Не ЭтоВходящий;

	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(Объект.Ссылка,
																				   Объект.ДокументОснование,
																				   Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию,
																				   ТекущийСтатус);
	
	Если ТребуетсяПереотправить(ТекущийКодСостоянияДокументооборота) Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Заголовок = "Сформировать новый";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Картинка = БиблиотекаКартинок.СкопироватьОбъект;
	КонецЕсли;
	
	Если Переотправлен(ТекущийКодСостоянияДокументооборота) Или ТребуетсяПереотправить(ТекущийКодСостоянияДокументооборота) Тогда
		ПричинаОтказаВПодписиТехКонтроля = ПричинаОтказаВПодписиТехКонтроляИзТитула3(Объект.Ссылка);
	КонецЕсли;
	
	ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
	РучнойВвод = ЗначениеЗаполнено(КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(ТипЛогистическогоДокумента))
		И Не ЗначениеЗаполнено(Объект.ДокументОснование);
	
	Элементы.ОткрытьНастройкуКонвертации.Видимость = ЗначениеЗаполнено(Объект.ДокументОснование) Или РучнойВвод;
	
	Если ЗначениеЗаполнено(Объект.ОрганизацияМедик) Тогда
		ОрганизацияМедикНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.ОрганизацияМедик, "Наш");
	Иначе
		ОрганизацияМедикНаш = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОрганизацияТехСостояние) Тогда
		ОрганизацияТехСостояниеНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.ОрганизацияТехСостояние, "Наш");
	Иначе
		ОрганизацияТехСостояниеНаш = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОрганизацияОдометр) Тогда
		ОрганизацияОдометрНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.ОрганизацияОдометр, "Наш");
	Иначе
		ОрганизацияОдометрНаш = Ложь;
	КонецЕсли;
	
	ОтрисоватьДокументыОснованияСервер();
	
	ДополнитьЗаголовокПоказатьДопПоля();
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы.Видимость = СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормыВЗависимостиОтСтатуса()

	СтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);

	Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		 Или СтатусТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке")
		 Или СтатусТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена")
		 Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда

		ТолькоПросмотр = Макс(Ложь, ТолькоПросмотр);
		
	Иначе

		ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	Если ТолькоПросмотр Тогда 
		Элементы.ПерезаполнитьПоДокОснованию.Видимость = Ложь;
		Элементы.ПодменюУправление.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаФормироватьТ2СразуФлажек.Доступность = Не ТолькоПросмотр;
	Элементы.ГруппаСквознойСценарийТехКонтрольФлажек.Доступность = Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяТекущимТ2.Видимость = Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяТекущимТ31.Видимость = Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяТекущимТ32.Видимость = Не ТолькоПросмотр;
	Элементы.УстановитьДатуВремяТекущимТ4.Видимость = Не ТолькоПросмотр;
	
КонецПроцедуры

