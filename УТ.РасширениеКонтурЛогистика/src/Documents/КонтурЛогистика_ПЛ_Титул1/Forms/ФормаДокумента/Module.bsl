		Объект.ДанныеТ3ДатВрВыпНаЛин = ТекущаяДатаСервера();
	ИначеЕсли ИмяТекущегоЭлемента = "УстановитьДатуВремяТекущимТ4" Тогда
		Объект.ДанныеТ4ДатВрОдометр = ТекущаяДатаСервера();
