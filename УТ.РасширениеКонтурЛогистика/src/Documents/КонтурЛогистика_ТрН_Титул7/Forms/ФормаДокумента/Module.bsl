&НаКлиенте
Функция ОчиститьДанныеДокумента(ОбъектДокумента, ПостФикс = "") 
	
	ОбъектДокумента["ИдДок" + ПостФикс] = "";
	ОбъектДокумента["НаимДок" + ПостФикс] = "";
	ОбъектДокумента["НомерДок" + ПостФикс] = "";
	ОбъектДокумента["ДатаДок" + ПостФикс] = "";
	ОбъектДокумента["ДопСведДок" + ПостФикс] = "";
	ОбъектДокумента["СтороныСостДок" + ПостФикс] = "";
	ОбъектДокумента["ДопСостДок" + ПостФикс] = "";
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьДанныеДокумента(ОбъектДокумента, ПостФикс = "") 
	
	ОбъектДокумента["ДатаДок" + ПостФикс] = ТекущаяДата();
		
КонецФункции

&НаКлиенте
Процедура ОтметкиПАПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ОтметкиПА.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	нСтроки = Объект.Акты.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОтметки", ТекДанные.ИдентификаторСтроки));
	Для каждого Строка Из нСтроки Цикл
		Объект.Акты.Удалить(Строка);
	КонецЦикла;
	
	нСтроки = Объект.Штрафы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОтметки", ТекДанные.ИдентификаторСтроки));
	Для каждого Строка Из нСтроки Цикл
		Объект.Штрафы.Удалить(Строка);
	КонецЦикла;
	
	ПроверитьДокумент();

КонецПроцедуры

