	Ядро = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();
	
	Возврат Ядро.ПарсерJSON_Записать(Значение);
	
КонецФункции

Функция ПреобразоватьИзJSON(СтрокаJSON) Экспорт
	
	Ядро = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();
	
	Возврат Ядро.ПарсерJSON_Прочитать(СтрокаJSON);
	
КонецФункции

Функция ОписаниеЗначенияПеременнойМетрики(Значение) Экспорт
	
	Результат = Новый Структура();
	
	Результат.Вставить("value", "");
	Результат.Вставить("type",  "");
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Результат.value = Формат(Значение, "ЧН=; ЧГ=");
		Результат.type	= "number";
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Результат.value = "null";
		Результат.type	= "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Результат.value = Значение;
		Результат.type	= "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Результат.value = Строка(Значение);
		Результат.type	= "uuid";
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Результат.value = Base64Строка(Значение);
		Результат.type	= "base64";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Результат.value = Формат(Значение, "БЛ=false; БИ=true");
		Результат.type	= "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат.value = Формат(Значение, "ДЛФ=DT; ДП=");
		Результат.type	= "string";
	Иначе
		Попытка
			Результат.value = ПреобразоватьВJSON(Значение);
			Результат.type	= "string";
		Исключение
			Результат.value = "convert_error";
			Результат.type	= "string";
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

