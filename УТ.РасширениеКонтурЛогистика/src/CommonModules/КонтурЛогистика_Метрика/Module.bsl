Функция ЗаменитьGUID(ИсходныйТекст)
	
	МассивGUID = Новый Массив;
	
	// Замена GUID
	// Ищем по формату 8-4-4-4-12, 36-символов строки из 32 hex символов (0-9, a-f)
	// Пример: 6F9619FF-8B86-D011-B42D-00CF4FC964FF
	ПустойGUID = "00000000-0000-0000-0000-000000000000";
	ДлинаGUID = 36;
	СимволыИсходногоТекста = Новый Массив;
	Для Счет = 1 По СтрДлина(ИсходныйТекст) Цикл
		СимволыИсходногоТекста.Добавить(Сред(ИсходныйТекст, Счет, 1));
	КонецЦикла;
	
	Для Счет = 1 По СтрДлина(ИсходныйТекст) - ДлинаGUID Цикл
		
		ТекущийСимвол = СимволыИсходногоТекста[Счет];
		Если ТекущийСимвол <> "-" Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверим маску 8-4-4-4-12
		Если СимволыИсходногоТекста[Счет + 5] = "-"
			И СимволыИсходногоТекста[Счет + 10] = "-"
			И СимволыИсходногоТекста[Счет + 15] = "-" Тогда
			
			GUID = Сред(ИсходныйТекст, Счет - 7, ДлинаGUID);
			Если GUID <> ПустойGUID
				И КонтурЛогистика_СтдСтрКлиентСервер.ЭтоУникальныйИдентификаторЛок(GUID) Тогда
				
				// Заменим на пустой
				ИсходныйТекст = СтрЗаменить(ИсходныйТекст, GUID, ПустойGUID);
				МассивGUID.Добавить(GUID);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивGUID;
	
КонецФункции

Функция ЗаменитьTraceId(ИсходныйТекст)
	
	МассивTraceId = Новый Массив;
	
	// Замена TraceId
	// Должен быть 32 hex символов
	// Пример: 64ae03f8445b462b9e51b5291018c9fd
	СтрокаTraceId = """traceId""";
	ДлинаСтрокиTraceId = СтрДлина(СтрокаTraceId);
	ДлинаTraceId = 32;
	ПустойTraceId = "00000000000000000000000000000000";
	Счет = 1;
	Пока Истина Цикл
		
		ИндексНайденнойСтроки = КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ИсходныйТекст, СтрокаTraceId,, Счет);
		Если ИндексНайденнойСтроки = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Счет = ИндексНайденнойСтроки + ДлинаСтрокиTraceId;
		
		ИндексСледующейКовычки = КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(
			ИсходныйТекст, """",, ИндексНайденнойСтроки + ДлинаСтрокиTraceId);
		Если ИндексСледующейКовычки = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		TraceId = Сред(ИсходныйТекст, ИндексСледующейКовычки + 1, ДлинаTraceId);
		GUID = ОбогатитьTraceIdДоGUID(TraceId);
		Если TraceId <> ПустойTraceId
			И КонтурЛогистика_СтдСтрКлиентСервер.ЭтоУникальныйИдентификаторЛок(GUID) Тогда
			
			// Заменим на пустой
			ИсходныйТекст = СтрЗаменить(ИсходныйТекст, TraceId, ПустойTraceId);
			МассивTraceId.Добавить(TraceId);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивTraceId;
	
КонецФункции

Функция ОбогатитьTraceIdДоGUID(Знач TraceId)
	
	// 8-4-4-4-12
	Результат = Лев(TraceId, 8)
		+ "-" + Сред(TraceId, 9, 4)
		+ "-" + Сред(TraceId, 13, 4)
		+ "-" + Сред(TraceId, 17, 4)
		+ "-" + Прав(TraceId, 12);
	
