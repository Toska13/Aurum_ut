Функция ПреобразоватьВерсиюВСемантик(Знач Версия) Экспорт

	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат "0.0.0";
	КонецЕсли;

	Версия 			= Строка(Версия);
	МассивРазрядов 	= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(Версия, "./");
	СемантикВерсия	= "";

	Сч = 0;
	Разделитель = "";
	ТекРазряд = "";
	Для Каждого Разряд Из МассивРазрядов Цикл
		Сч = Сч + 1;
		Если Сч < 4 Тогда
			ТекРазряд = ?(КонтурЛогистика_ОбщегоНазначенияСервер.СтрокаСодержитТолькоЦифры(Разряд), Разряд, "0");
		Иначе
			ТекРазряд = СтрЗаменить(Разряд, " ", "");
		КонецЕсли;
		СемантикВерсия = СемантикВерсия + Разделитель + ТекРазряд;
		Если Сч < 3 Тогда
			Разделитель = ".";
		ИначеЕсли Сч = 3 Тогда
			Разделитель = "-";
		Иначе
			Разделитель = "";
		КонецЕсли;
	КонецЦикла;

	Пока Сч < 3 Цикл
		СемантикВерсия = СемантикВерсия + ".0";
		Сч = Сч + 1;
	КонецЦикла;

	Возврат СемантикВерсия;

КонецФункции

Функция Метрика_Переменные(ОрганизацияДиадок = Неопределено, ДобавитьНашиОрганизации = Истина, ДобавитьНастройки = Истина, ДобавитьПартнеров = Истина) Экспорт
	
	КонтекстПодсистемы = Новый Структура();
	
	КонтекстПодсистемы.Вставить("ТипСоединенияБазы", 		КонтурЛогистика_МетрикаПовтИсп.РазобратьСтрокуСоединенияИнформационнойБазы().ТипСоединения);
	КонтекстПодсистемы.Вставить("РазмерФайловойБазы", 		РазмерФайловойБазы());
	КонтекстПодсистемы.Вставить("ПользовательБазы", 		КонтурЛогистика_МетрикаПовтИсп.ТекПользовательБазы());
	КонтекстПодсистемы.Вставить("ИнфоОПроцессоре",    		КонтурЛогистика_МетрикаПовтИсп.ИнфоОПроцессоре());
	КонтекстПодсистемы.Вставить("ВерсияБСП", 				КонтурЛогистика_МетрикаПовтИсп.ВерсияБСП());
	КонтекстПодсистемы.Вставить("СинонимКонфигурации1С", 	Метаданные.Синоним);
	КонтекстПодсистемы.Вставить("РежимСовместимости", 		Строка(Метаданные.РежимСовместимости));
	КонтекстПодсистемы.Вставить("ПодсистемаКакРасширение",	КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение());
	КонтекстПодсистемы.Вставить("ОсновнойРежимЗапуска", 	Строка(Метаданные.ОсновнойРежимЗапуска));
	
	КонтекстПодсистемы.Вставить("ВерсияЛогистика", 			ПреобразоватьВерсиюВСемантик(КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика()));
	КонтекстПодсистемы.Вставить("ВерсияДанныхЛогистика", 	ПреобразоватьВерсиюВСемантик(КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияДанныхПодсистемыКонтурЛогистика()));
	
	КонтекстПодсистемы.Вставить("Окружение",				ИнформацияОбОкружении());
	
	ДанныеАвтоматическогоОбновления = КонтурЛогистика_МетрикаПовтИсп.ДанныеАвтоматическогоОбновления();
	КонтекстПодсистемы.Вставить("АвтоматическоеОбновлениеВключено", ДанныеАвтоматическогоОбновления.АвтоматическоеОбновлениеВключено);
	КонтекстПодсистемы.Вставить("РасписаниеАвтоматическогоОбновления", ДанныеАвтоматическогоОбновления.РасписаниеАвтоматическогоОбновления);
	
	текПеременные = Новый Структура();
	
	текПеременные.Вставить("КонтекстПодсистемы", КонтекстПодсистемы);
	
	Если ДобавитьНашиОрганизации Тогда 
		текПеременные.Вставить("НашиОрганизации", 	СформироватьИнформациюОНашихОрганизациях());
	КонецЕсли;
	
	Если ДобавитьНастройки Тогда 
		текПеременные.Вставить("Настройки", 		КонтурЛогистика_МетрикаПовтИсп.ИнфоОНастройках());
	КонецЕсли;
	
	Если ДобавитьПартнеров Тогда 
		текПеременные.Вставить("Партнеры", 		КонтурЛогистика_МетрикаПовтИсп.ИнфоОПартнерах());
	КонецЕсли;
	
	текПеременные.Вставить("ModuleIsProd", ?(ИнформацияОбОкружении() = "prod", 1, 0));
	ВариантУстановки = ?(КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение(), "extension", "subsystem");
	текПеременные.Вставить("ModuleVariant", ВариантУстановки);
	Если ВариантУстановки = "extension" Тогда 
		РезультатАнализа = КонтурЛогистика_ОбновлениеСервер.ХэшСуммаТекущегоРасширенияИЭталонногоОдинаковы(
									КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика());	
		текПеременные.Вставить("Custom", ?(РезультатАнализа.ХэшСуммыОдинаковы, 0, 1));
	Иначе
		текПеременные.Вставить("Custom", "Unknown");
	КонецЕсли;
	
	// установлено доп расширение?
	Аддоны = Метрика_Аддоны();
	текПеременные.Вставить("Addons", Аддоны);
	
	ТипПМ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПодключаемыйМодульТип");
	текПеременные.Вставить("UsePM", ?(ТипПМ = Перечисления.КонтурЛогистика_ТипыПМ.Отключен Или ТипПМ = Перечисления.КонтурЛогистика_ТипыПМ.ПустаяСсылка(), 0, 1));
	текПеременные.Вставить("PM", Строка(ТипПМ));
	
	Если ЗначениеЗаполнено(ОрганизацияДиадок) Тогда 
		текПеременные.Вставить("OrgInLogist", 	?(ОрганизацияДиадок.ЕстьВСервисеЛогистика, 1, 0));
		текПеременные.Вставить("OrgIsProdTRN", 	?(ОрганизацияДиадок.ПродуктивТрн, 1, 0));
		текПеременные.Вставить("OrgIsProdPL", 	?(ОрганизацияДиадок.ПродуктивЭпл, 1, 0));
		текПеременные.Вставить("AutoFriendship", ?(ОрганизацияДиадок.Автодружба, 1, 0));
		текПеременные.Вставить("IsGO", 			?(ОрганизацияДиадок.Грузоотправитель, 1, 0));
		текПеременные.Вставить("IsPRV", 		?(ОрганизацияДиадок.Перевозчик, 1, 0));
		текПеременные.Вставить("IsGP", 			?(ОрганизацияДиадок.Грузополучатель, 1, 0));
		текПеременные.Вставить("IsMed", 		?(ОрганизацияДиадок.Медик, 1, 0));
		текПеременные.Вставить("IsPL", 			?(ОрганизацияДиадок.Оформитель, 1, 0));
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияДиадок);
		текПеременные.Вставить("UseApikeyLogist", ?(ЗначениеЗаполнено(ПараметрыСервиса.ApiKey), 1, 0));
		
		// НастройкиОрганизации
		НастройкиОрганизации = КонтурЛогистика_МетрикаПовтИсп.НастройкиОрганизации(ОрганизацияДиадок);
		текПеременные.Вставить("НастройкиОрганизации", НастройкиОрганизации);
	КонецЕсли;

	Возврат текПеременные;
	
КонецФункции

Функция Метрика_Аддоны()
	
	Аддоны = Новый Соответствие;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		Возврат Аддоны;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	МассивДопРасширений = Новый Массив;

	// панелька в типовые доки
	ИмяРасширения1 = КонтурЛогистика_ИнтеграцияТиповыеСервер.ИмяДополнительногоРасширенияПоИмениКонфигурации(ИмяКонфигурации1С);
	Если ЗначениеЗаполнено(ИмяРасширения1) Тогда
		МассивДопРасширений.Добавить(ИмяРасширения1);
	КонецЕсли;
	
	// доп. реквизиты в типовые
	ИмяРасширения2 = КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСервер.ИмяДополнительногоРасширенияДополнительныеРеквизитыПоИмениКонфигурации(ИмяКонфигурации1С);
	Если ЗначениеЗаполнено(ИмяРасширения2) Тогда
		МассивДопРасширений.Добавить(ИмяРасширения2);
	КонецЕсли;
	
	Для Каждого ИмяДопРасширения Из МассивДопРасширений Цикл
		
		ОтборРасширения = Новый Структура;
		ОтборРасширения.Вставить("Имя", ИмяДопРасширения);
		Попытка
			НайденныеРасширения = РасширенияКонфигурации.Получить(ОтборРасширения);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если НайденныеРасширения.Количество() > 0 Тогда 
			Аддоны.Вставить(ИмяДопРасширения, НайденныеРасширения[0].Версия);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Аддоны;

КонецФункции

