Функция _СравнитьВерсии(Знач СтрокаВерсия1, Знач СтрокаВерсия2) Экспорт
	
	Результат = 0;
	Если СокрЛП(СтрокаВерсия1) = СокрЛП(СтрокаВерсия2) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Версия1 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(СтрокаВерсия1, ".");
	Версия2 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(СтрокаВерсия2, ".");
	
	КоличествоИтераций = Мин(Версия1.Количество(), Версия2.Количество()) - 1;
	Для Разряд = 0 По КоличествоИтераций Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат (Результат > 0) - (Результат < 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИдентификаторИБИзРегистра()
	
	ИмяСвойства = "КонтурИдентификаторИБ";
	Объект = Вычислить("Справочники.Валюты.НайтиПоКоду(643)"); // руб.
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|   ЗначенияСвойствОбъектов.Значение
	|ИЗ
	|   РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|   ЗначенияСвойствОбъектов.Объект = &Объект
	|   И ЗначенияСвойствОбъектов.Свойство.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Наименование", ИмяСвойства);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат СокрЛП(Выборка.Значение);
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ЗаписатьИдентификторИБвРегистр()
	
	ИмяСвойства = "КонтурИдентификаторИБ";
	
	Объект = Справочники.Валюты.НайтиПоКоду(643); // руб.
	Если Не ЗначениеЗаполнено(Объект) Тогда
		// Банк России исключил цифровой код 810 из Общероссийского классификатора валют в 2004 году
		Объект = Справочники.Валюты.НайтиПоКоду(810);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	НовоеСвойство                       = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	НовоеСвойство.НазначениеСвойства    = ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочники;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Имя"                      , ИмяСвойства);
	СтруктураРеквизитов.Вставить("Заголовок"                , ИмяСвойства);
	СтруктураРеквизитов.Вставить("Наименование"             , ИмяСвойства);
	СтруктураРеквизитов.Вставить("ИдентификаторДляФормул"   , ИмяСвойства);
	СтруктураРеквизитов.Вставить("ТипЗначения"              , Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	ЗаполнитьЗначенияСвойств(НовоеСвойство, СтруктураРеквизитов);
	
	НовоеСвойство.ОбменДанными.Загрузка = Истина;
	НовоеСвойство.Записать();
	
	СозданноеСвойство = НовоеСвойство.Ссылка;
	
	НоваяЗапись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	НоваяЗапись.Объект      = Объект.Ссылка;
	НоваяЗапись.Свойство    = СозданноеСвойство;
	НоваяЗапись.Значение    = Строка(Новый УникальныйИдентификатор);
	
	НоваяЗапись.Записать();
	
КонецПроцедуры

