#Область КатегорииМетрик

Процедура Метрика_ОтправитьСтатистикуСеанса(Действие, ПараметрыСобытия)
	
	Топик 		= КонтурЛогистика_МетрикаКлиентСервер.Топики().Статистика;
	Категория 	= КонтурЛогистика_МетрикаКлиентСервер.Категории().СтатистикаСеанса;
	
	// версия метрики 1.0.0 - в разрезе Наших организаций
	МассивНашихОрганизаций = КонтурЛогистика_ОбщегоНазначенияСервер.ВсеНашиОрганизации();
	
	Для каждого НашаОрганизация Из МассивНашихОрганизаций Цикл
		
		ОписаниеСобытия = ПредзаполненноеСобытие(Действие, Категория,, НашаОрганизация); 	
		ЗаполнитьПеременные(ОписаниеСобытия, Метрика_Переменные(НашаОрганизация));
		
		Если ПараметрыСобытия.ДобавитьВОчередь Тогда
			
			ЗарегистрироватьСобытие(ОписаниеСобытия, Топик, ПараметрыСобытия.СразуОтправить);
			
		Иначе
			
			ТелоЗапроса = ПреобразоватьВJSON(ОписаниеСобытия);
			РезультатОтправки = ОтправитьМетрику(ТелоЗапроса, Топик, ОписаниеСобытия.Id);
			
			Если Не РезультатОтправки.Успешно Тогда
				КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистика_Метрика.Метрика_ОтправитьСтатистикуСеанса", РезультатОтправки.ОписаниеОшибки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Метрика_ОтправкаТрафика()
	
	// при отправке трафика текущий день не учитывается
	
	ДатаОтправкиТрафикаМСК = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПоследняяДатаОтправкиТрафика");
	Если Не ЗначениеЗаполнено(ДатаОтправкиТрафикаМСК) Тогда
		ДатаОтправкиТрафикаМСК = Дата(1, 1, 1, 0, 0, 0);
	КонецЕсли;
	
	ТекущийМоментВремениМСК = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
	Если ДатаОтправкиТрафикаМСК = НачалоДня(ТекущийМоментВремениМСК) - 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоДанныхТрафика = ТрафикПоДнямВерсия2(ДатаОтправкиТрафикаМСК);
	
	Если ЗначениеЗаполнено(ДеревоДанныхТрафика) Тогда
		
		Топик 		= КонтурЛогистика_МетрикаКлиентСервер.Топики().Статистика;
		Категория 	= КонтурЛогистика_МетрикаКлиентСервер.Категории().Трафик;
		
		Для Каждого СтрокаДатыТрафика Из ДеревоДанныхТрафика.Строки Цикл
			
			Для Каждого СтрокаОрганизации Из СтрокаДатыТрафика.Строки Цикл
				
				// формируем метрику
				Переменные = Метрика_Переменные(СтрокаОрганизации.ОрганизацияДиадок, Ложь, Ложь, Истина);	
				ОписаниеСобытия = ПредзаполненноеСобытие("Отправка трафика", Категория, СтрокаДатыТрафика.ДатаДоставкиДиадок, СтрокаОрганизации.ОрганизацияДиадок);	
				
				ИмяПеременнойОрганизацияИтог = "TodayOverall";   
				Переменные.Вставить(ИмяПеременнойОрганизацияИтог, СтрокаОрганизации.Количество);
				
				Для Каждого ОтправленныеФайлы Из СтрокаОрганизации.Строки Цикл
					
					ИмяПеременнойПоТипу = ?(ОтправленныеФайлы.ТестовыйДокумент, "test", "prod") + "_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ОтправленныеФайлы.ТипДокумента);
					
					Переменные.Вставить(ИмяПеременнойПоТипу, ОтправленныеФайлы.Количество);
					
				КонецЦикла;
				
				ЗаполнитьПеременные(ОписаниеСобытия, Переменные);
				
				ТелоЗапроса = ПреобразоватьВJSON(ОписаниеСобытия);
				
				РезультатОтправки = ОтправитьМетрику(ТелоЗапроса, Топик, ОписаниеСобытия.Id);
				
				Если Не РезультатОтправки.Успешно Тогда
					
					КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не удалось отправить метрики за " + Формат(СтрокаДатыТрафика.ДатаДоставкиДиадок, "ДФ=dd.MM.yyyy;"));
					КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистика_Метрика.Метрика_ОтправкаТрафика", РезультатОтправки.ОписаниеОшибки);

					Возврат;
				КонецЕсли;
				
			КонецЦикла;
			
			Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ПоследняяДатаОтправкиТрафика", КонецДня(СтрокаДатыТрафика.ДатаДоставкиДиадок));
			
		КонецЦикла;
		
	КонецЕсли;
	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ПоследняяДатаОтправкиТрафика", НачалоДня(ТекущийМоментВремениМСК) - 1);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСобытия

Функция ПредзаполненноеСобытие(Действие, Категория, ДатаСобытия = Неопределено, ОрганизацияДиадок = Неопределено)
	
	ОписаниеСобытия = Новый Структура;
	
	ЗаполнитьID(ОписаниеСобытия);
	ЗаполнитьClientInfo(ОписаниеСобытия);
	Представление = Неопределено;
	
	Если ЗначениеЗаполнено(ОрганизацияДиадок) Тогда 
		Представление = ОрганизацияДиадок.Наименование;
	КонецЕсли;
	
	ЗаполнитьИнфо(ОписаниеСобытия, Действие, Категория,, Представление);
	ЗаполнитьВременныеМетки(ОписаниеСобытия, ДатаСобытия);
	ЗаполнитьIDЭкземпляраМодуля(ОписаниеСобытия);
	ЗаполнитьИнфоОСессии(ОписаниеСобытия, ОрганизацияДиадок);
	ЗаполнитьTraceID(ОписаниеСобытия);
	ЗаполнитьКонтекстПриложения(ОписаниеСобытия);
	
	Возврат ОписаниеСобытия;
	
КонецФункции

Процедура ЗаполнитьID(ОписаниеСобытия)
	
	ОписаниеСобытия.Вставить("Id", КонтурЛогистика_МетрикаКлиентСервер.НовыйУИД());
	
КонецПроцедуры

Процедура ЗаполнитьClientInfo(ОписаниеСобытия)
	
	ClientInfo = Новый Структура;
	ClientInfo.Вставить("ClientName", "logist");
	ClientInfo.Вставить("ClientVersion", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьНомерВерсииПодсистемыКонтурЛогистика());
	
	ОписаниеСобытия.Вставить("ClientInfo", ClientInfo);
	
КонецПроцедуры

Процедура ЗаполнитьИнфо(ОписаниеСобытия, Действие, Категория, ДопИнфо = Неопределено, Представление = Неопределено)
	
	ИнформацияОСобытии = Новый Структура();
	
	ИнформацияОСобытии.Вставить("Category", Категория);
	ИнформацияОСобытии.Вставить("Action", Действие);
	
	Если Не ДопИнфо = Неопределено Тогда
		ИнформацияОСобытии.Вставить("Label", ДопИнфо);
	КонецЕсли;
	
	Если Не Представление = Неопределено Тогда
		ИнформацияОСобытии.Вставить("View", Представление);
	КонецЕсли;
	
	ОписаниеСобытия.Вставить("Path", ИнформацияОСобытии);
	
КонецПроцедуры

Процедура ЗаполнитьВременныеМетки(ОписаниеСобытия, ДатаСобытия = Неопределено)
		
	ВременныеМетки = Новый Структура();

	Если ЗначениеЗаполнено(ОписаниеСобытия)
		И ЗначениеЗаполнено(ОписаниеСобытия.Path)
		И ЗначениеЗаполнено(ОписаниеСобытия.Path.Category)
		И ОписаниеСобытия.Path.Category = КонтурЛогистика_МетрикаКлиентСервер.Категории().Трафик Тогда
		
		// трафик сгруппирован по дате - там уже чистая дата которую не надо переводить в UTC
		ClientTime = СтрокаJSON_ПростаяДата(?(ЗначениеЗаполнено(ДатаСобытия), ДатаСобытия, КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК()));
		
	Иначе
		
		ClientTime = СтрокаJSON_УниверсальнаяДата(?(ЗначениеЗаполнено(ДатаСобытия), ДатаСобытия, КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК()));
		
	КонецЕсли;

	//ОписаниеСобытия.Вставить("ClientDate", Формат(КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК(), "ДФ=yyyy-MM-dd"));
	
	ВременныеМетки.Вставить("ClientTime", 			ClientTime);
	ВременныеМетки.Вставить("SendFromClientTime", 	"&SendFromClientTime"); // параметр будем заполнять перед отправкой

	ОписаниеСобытия.Вставить("Time", ВременныеМетки);
			
КонецПроцедуры

Процедура ЗаполнитьIDЭкземпляраМодуля(ОписаниеСобытия)
	
	ОписаниеСобытия.Вставить("ClientInstanceId", Строка(КонтурЛогистика_МетрикаПовтИсп.ИдентификаторПользователяИБ())); 
	
КонецПроцедуры	

Процедура ЗаполнитьПеременные(ОписаниеСобытия, Переменные = Неопределено)
	
	Если ОписаниеСобытия.Свойство("Variables") Тогда
		Variables = ОписаниеСобытия.Variables;
	Иначе
		Variables = Новый Соответствие;
	КонецЕсли;
	
	Если Не Переменные = Неопределено Тогда
		
		Для Каждого Элемент Из Переменные Цикл
			
			Variables.Вставить(Элемент.Ключ, ОписаниеЗначенияПеременнойМетрики(Элемент.Значение));
			
		КонецЦикла;
		
	КонецЕсли;
	
	IDБазыДанных = ПолучитьСлужебныйИдентификаторБазыДанных();
	Variables.Вставить("IDБазыДанных", ОписаниеЗначенияПеременнойМетрики(IDБазыДанных));
	
	ОписаниеСобытия.Вставить("Variables", Variables);
	
КонецПроцедуры

Процедура ЗаполнитьИнфоОСессии(ОписаниеСобытия, Знач ОрганизацияДиадок = Неопределено)

	Если ОрганизацияДиадок = Неопределено Тогда 
		ОрганизацияДиадок = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЛюбаяНашаОрганизация();
	КонецЕсли;
	
	ОписаниеСессии = Новый Структура();
	// ОписаниеСессии.Вставить("CustomSessionId", ""); не отправляем в версии метрики 1.0.0
	
	KeSession = Новый Структура();
	KeSession.Вставить("AbonId", ИдентификаторИБ());
	KeSession.Вставить("UserId", Строка(КонтурЛогистика_МетрикаПовтИсп.ИдентификаторПользователяОС()));
	
	ОписаниеСессии.Вставить("KeSession", KeSession);
	// PortalSession, NormativeSession, KeSession, KonturPassportSession - при необходимости

	ОписаниеСобытия.Вставить("Session", ОписаниеСессии);
	
	ДополнитьСобытиеИННКПП(ОписаниеСобытия, ОрганизацияДиадок);

КонецПроцедуры

Процедура ЗаполнитьTraceID(ОписаниеСобытия, TraceId = Неопределено)
	
	Если Не TraceId = Неопределено Тогда
	
		ОписаниеСобытия.Вставить("TraceId", TraceId);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтекстПриложения(ОписаниеСобытия)
	
	КонтекстПриложения = Новый Структура();
	
	// в версии метрик 2.0 перестали отпарвлять в AppVersion версию модуля т.к. дуюлирование с ClientInfo_ClientVersion
	// НомерВерсииПодсистемы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьНомерВерсииПодсистемыКонтурЛогистика();
	// КонтекстПриложения.Вставить("AppVersion", НомерВерсииПодсистемы);

	КонтекстПриложения.Вставить("Hardware", КонтурЛогистика_МетрикаПовтИсп.ОписаниеАппаратногоОбеспечения());
	КонтекстПриложения.Вставить("Platform", КонтурЛогистика_МетрикаПовтИсп.ОписаниеПрограммы());
	КонтекстПриложения.Вставить("OS", 		КонтурЛогистика_МетрикаПовтИсп.ОписаниеОС());
	
	Browser = КонтурЛогистика_МетрикаПовтИсп.ОписаниеБраузера(); 
	Если Browser.Количество() Тогда
		КонтекстПриложения.Вставить("Browser", 	Browser);
	КонецЕсли;
	
	ОписаниеСобытия.Вставить("AppContext", КонтекстПриложения);
	
КонецПроцедуры

Функция ЗаполнитьВремяОтправкиСобытия(ТелоЗапроса)

	Возврат СтрЗаменить(ТелоЗапроса, "&SendFromClientTime", СтрокаJSON_УниверсальнаяДата(ТекущаяДатаСеанса()));
	
КонецФункции

Процедура ДополнитьСобытиеИННКПП(ОписаниеСобытия, ОраганизацияДиадок = Неопределено, ИНН = Неопределено, КПП = Неопределено)
	
	NormativeSession = Новый Структура;
	PortalSession = Новый Структура;
	PortalSession.Вставить("PortalUserId", "");
	
	Если ЗначениеЗаполнено(ОраганизацияДиадок) Тогда
		
		Marker = "" + СокрЛП(ОраганизацияДиадок.ИНН) + "-" + СокрЛП(ОраганизацияДиадок.КПП);
		BoxId = ОраганизацияДиадок.ID;
		
		NormativeSession.Вставить("AccountId", BoxId);
		
		ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(ОраганизацияДиадок);
		PortalSession.PortalUserId = ДанныеАутентификации.ПортальныйИд;
		
	Иначе
		
		Marker = "" + СокрЛП(ИНН) + "-" + СокрЛП(КПП);
		
	КонецЕсли;
	
	NormativeSession.Вставить("Marker", Marker);
	
	ОписаниеСобытия.Session.Вставить("NormativeSession", NormativeSession);
	
	Если ЗначениеЗаполнено(PortalSession.PortalUserId) Тогда
		ОписаниеСобытия.Session.Вставить("PortalSession", PortalSession);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция МассивСвойствОрганизацийДляХлебныхКрошек()
	
	Перем МассивСвойствОрганизацийДляХлебныхКрошек;
	
	МассивСвойствОрганизацийДляХлебныхКрошек = Новый Массив;
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("Грузоотправитель");
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("Перевозчик");
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("Грузополучатель");
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("Оформитель");
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("Медик");
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("ТехОсмотр");
	МассивСвойствОрганизацийДляХлебныхКрошек.Добавить("Одометр");
	Возврат МассивСвойствОрганизацийДляХлебныхКрошек;

КонецФункции


// Это baseID сформированный Контур.Логистика.
// Он не равен общепродуктовому идентификатору базы, который определяется методом ИдентификаторИБ
//
// Возвращаемое значение:
//   Строка - Идентификатор информационной базы
//
Функция ПолучитьСлужебныйИдентификаторБазыДанных() Экспорт
	
	НазваниеНастрокиХраненияИдентификатора = "СлужебныйИдентификаторБазыДанных"; 
	
	Попытка
		
		ТекИдентификаторБазыДанных = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(НазваниеНастрокиХраненияИдентификатора);
		
		Если ТипЗнч(ТекИдентификаторБазыДанных) <> Тип("Строка")
			ИЛИ ТекИдентификаторБазыДанных = Неопределено
			ИЛИ Не ЗначениеЗаполнено(ТекИдентификаторБазыДанных) Тогда
			
			НайденнаяНастройка = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(НазваниеНастрокиХраненияИдентификатора);
			
			НастройкаОбъект = НайденнаяНастройка.ПолучитьОбъект();
			НастройкаОбъект.ТипЗначения = "Строка";
