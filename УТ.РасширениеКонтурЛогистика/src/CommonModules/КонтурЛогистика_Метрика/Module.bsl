	Результат = "";
	
	ПараметрыСоединения = КонтурЛогистика_СтдСтрКлиентСервер.ПараметрыИзСтрокиЛок(СтрокаСоединенияИнформационнойБазы());
	Каталог = ПараметрыСоединения.File;
	ПутьКФайлу = ОбъединитьПути(Каталог, "KonturBaseId.txt");
		
