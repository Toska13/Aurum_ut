			НастройкаОбъект.Записать();
			
			ТекИдентификаторБазыДанных = НастройкаОбъект.Значение;
			
		КонецЕсли;
		
	Исключение
		
		ТекИдентификаторБазыДанных = "НеУдалосьОпределить";
		
	КонецПопытки;
	
	Возврат ТекИдентификаторБазыДанных;
	
КонецФункции

Функция ИдентификаторИБ() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВерсияБСП = ВерсияБСП();	
	
	Если ВерсияБСП = Неопределено
		Или _СравнитьВерсии(ВерсияБСП, "2.2.1.35") <= 0 Тогда // todo заменить на КонтурСТД после появления библиотеки
		
		НайденныйРегистр = Метаданные.НайтиПоПолномуИмени("РегистрСведений.ЗначенияСвойствОбъектов");
		
		Если НайденныйРегистр = Неопределено Тогда
			
			Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
				
				Попытка
				
					Возврат МетрикаКонтурСлужебный_ИдентификаторИнформационнойБазы_Файл();
				
				Исключение
					
					Возврат "aacc64c0-e8d8-4ae7-b3f8-8300b2f70d2b";
					
				КонецПопытки;
				
			Иначе
				
				Возврат "aacc64c0-e8d8-4ae7-b3f8-8300b2f70d2b";
				
			КонецЕсли;
			
		Иначе // берем из регистра
			
			ЗаписанныйВРегистрИдентификаторИБ = ПолучитьИдентификаторИБИзРегистра();
			
			Если ЗначениеЗаполнено(ЗаписанныйВРегистрИдентификаторИБ) Тогда
				
				Возврат ЗаписанныйВРегистрИдентификаторИБ;
				
			Иначе
				
				ЗаписатьИдентификторИБвРегистр();
				Возврат ПолучитьИдентификаторИБИзРегистра();
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе // берем из БСП
		
		Возврат Вычислить("СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы()");
		
	КонецЕсли;
	
КонецФункции

