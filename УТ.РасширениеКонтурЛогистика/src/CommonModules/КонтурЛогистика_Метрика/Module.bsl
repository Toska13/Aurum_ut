
// Договоренности по заполнению:
// 1. Topic_Key
//   - Behavior 	- Поведение (действия пользователя)
//   - Log			- Журнал (дополнительная информация)
//   - Health		- Здоровье (ошибки и предупреждения)
//   - Feedback		- ОбратнаяСвязь (обратная связь от пользователей)
//   - Statistics	- Статистика (статистика и настройки)
// 2. Базовые поля:
//   - Category		- Наименование сценария, который выполняет пользователь
//                    Пример: "Просмотр уведомления"
//   - Action		- Наименование команды, которое пользователь выполняет на форме
//                    Пример: "Нажать на гиперссылку"
//   - Label		- Дополнительная информация/детализация сценария
//                    Пример: "Название инструкции"
//   - View			- Полное наименование формы или обекта метаданных (Справочник.КонтурЛогистика_СценарииАвтоматическойРаботы)
//                    Пример: "Обработка.КонтурЛогистика_РабочийСтол.Форма.Форма"
//   - TraceId		- Идентификатор, который формируется в разрезе сеанса пользователя для: Path_Category + Path_Label
//                    Пример: формируется всегда автоматически.
// 3. Variables - дополнительные данные (например для ошибок это могут быть: Код и Текст ошибки).
//
//
// Пример поведенчиских метрик:
//   КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
//     "Передача на подписание", "Передать на подписание", "Документ.КонтурЛогистика_ТрН_Титул1.Форма.ФормаДокумента", "ТрН_Титул1");

#Область ПрограммныйИнтерфейс

// Фиксируем ошибку в журнал регистрации и отправляем метрики
//
// Параметры:
//  Сценарий			 - Строка - сценарий, при котором возникает ошибка (Path_Category).
//  Ошибка				 - ИнформацияОбОшибке, Строка - описание ошибки.
//  СсылкаНаОбъект		 - Ссылка - ссылка на объект связанный с возникновением ошибки.
//  ДопИнформация		 - Строка, Структура - дополнительная информация.
//  Представление		 - Строка - операция/действие, где возникает ошибка (Path_View).
//  ЗаписыватьВЖурналРегистрации - Булево - записывать в журнал регистрации или нет.
//
Процедура ОбработатьОшибку(Сценарий, Ошибка,
	СсылкаНаОбъект = Неопределено,
	ДопИнформация = Неопределено,
	Представление = Неопределено, 
	ЗаписыватьВЖурналРегистрации = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	

	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	// Описание ошибки
	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(Ошибка);
	Иначе
		ПодробноеПредставлениеОшибки = Ошибка;
		КраткоеПредставлениеОшибки = Ошибка;
	КонецЕсли;
	
	// Форминуем комментарий для ЖР
	СтрокиОшибки = Новый Массив;
	СтрокиОшибки.Добавить(Сценарий);
	Если ЗначениеЗаполнено(ДопИнформация) Тогда
		СтрокиОшибки.Добавить(СтрокаДопИнформацииДляЖурналаРегистрации(ДопИнформация));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПодробноеПредставлениеОшибки) Тогда
		СтрокиОшибки.Добавить("Текст ошибки:");
		СтрокиОшибки.Добавить(ПодробноеПредставлениеОшибки);
	КонецЕсли;
	Комментарий = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(СтрокиОшибки, Символы.ПС);
	
	// Запись в журнал регистрации
	Если ЗаписыватьВЖурналРегистрации = Истина Тогда
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, СсылкаНаОбъект, Комментарий);
	КонецЕсли;
	
	// Описание события
	Действие = Строка(ТекущийРежимЗапуска());
	Если ПустаяСтрока(Действие) Тогда
		Действие = "Регламентное задание";
	КонецЕсли;
	ДатаСобытия = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
	ОписаниеСобытия = ПредзаполненноеСобытие(Действие, Сценарий, ДатаСобытия);
	Переменные = Метрика_Переменные();
	ЗаполнитьПеременные(ОписаниеСобытия, Переменные);
	
	// Зарегистрируем ошибку для отправки в метрики (ClickHouse)
	ЗарегистрироватьОшибку(ОписаниеСобытия, Представление, ПодробноеПредставлениеОшибки, КраткоеПредставлениеОшибки, ДопИнформация);
	
	// Отправить ошибку для оперативного мониторинга ошибок (Sentry)
	ОтправитьВОперативныйМониторингОшибок(ОписаниеСобытия, Представление, ПодробноеПредставлениеОшибки, КраткоеПредставлениеОшибки, ДопИнформация);
	
КонецПроцедуры

Процедура ЗарегистрироватьДействиеПользователя(Category, Action, View = Неопределено, Label = Неопределено, СразуОтправить = Ложь, ДопИнформация = Неопределено) Экспорт
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	Топик = КонтурЛогистика_МетрикаКлиентСервер.Топики().Поведение;
	ДатаСобытия = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
	
	ОписаниеСобытия = ПредзаполненноеСобытие(Action, Category, ДатаСобытия);
	
	Если ЗначениеЗаполнено(View) Тогда
		ОписаниеСобытия.Path.Вставить("View", View);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Label) Тогда
		ОписаниеСобытия.Path.Вставить("Label", Label);
	КонецЕсли;
	
	TraceId = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.TraceIdМетрик(Category, Label);
	ЗаполнитьTraceID(ОписаниеСобытия, TraceId);
	
	Если ДопИнформация = Неопределено Тогда
		ЗаполнитьПеременные(ОписаниеСобытия);
	Иначе
		ЗаполнитьПеременные(ОписаниеСобытия, ДопИнформация);
	КонецЕсли;
	
	ЗарегистрироватьСобытие(ОписаниеСобытия, Топик, СразуОтправить);
	
КонецПроцедуры

// Зарегистрировать статистику
//
// Параметры:
//  Переменные		 - Структура	 - описание статистических параметров
//  Category		 - Строка	 - См. шапку модля
//  Action			 - Строка	 - См. шапку модля
//  View			 - Строка	 - См. шапку модля
//  Label			 - Строка	 - См. шапку модля
//  СразуОтправить	 - Булево	 - отправлять сразу
//
Процедура ЗарегистрироватьСтатистику(Переменные, Category, Action, View = Неопределено, Label = Неопределено, СразуОтправить = Ложь) Экспорт
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	Топик = КонтурЛогистика_МетрикаКлиентСервер.Топики().Статистика;
	ДатаСобытия = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
	
	ОписаниеСобытия = ПредзаполненноеСобытие(Action, Category, ДатаСобытия);
	
	Если ЗначениеЗаполнено(View) Тогда
		ОписаниеСобытия.Path.Вставить("View", View);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Label) Тогда
		ОписаниеСобытия.Path.Вставить("Label", Label);
	КонецЕсли;
	
	TraceId = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.TraceIdМетрик(Category, Label);
	ЗаполнитьTraceID(ОписаниеСобытия, TraceId);
	
	ЗаполнитьПеременные(ОписаниеСобытия, Переменные);
	
	ЗарегистрироватьСобытие(ОписаниеСобытия, Топик, СразуОтправить);
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ОписаниеСобытия, Представление, ПодробноеПредставлениеОшибки, КраткоеПредставлениеОшибки, ДопИнформация, СразуОтправить = Истина) Экспорт
	
	Топик = КонтурЛогистика_МетрикаКлиентСервер.Топики().Журнал;
	
	ОписаниеСобытия.Path.Вставить("Label", КраткоеПредставлениеОшибки);
	Если ЗначениеЗаполнено(Представление) Тогда
		ОписаниеСобытия.Path.Вставить("View", Представление);
	КонецЕсли;
	
	Если ТипЗнч(ДопИнформация) = Тип("Структура") Тогда
		ЗаполнитьПеременные(ОписаниеСобытия, ДопИнформация);
	Иначе
		Переменные = Новый Структура("ТекстОшибки", ПодробноеПредставлениеОшибки);
		ЗаполнитьПеременные(ОписаниеСобытия, Переменные);
	КонецЕсли;
	
	ЗарегистрироватьСобытие(ОписаниеСобытия, Топик, СразуОтправить);
	
КонецПроцедуры

Процедура ЗарегистрироватьСобытие(Событие, Топик, СразуОтправить = Ложь)
	
	ТелоЗапроса = ПоставитьСобытиеВОчередьНаОтправку(Событие, Топик);
	
	Если СразуОтправить Тогда
		ОтправитьМетрику(ТелоЗапроса, Топик, Событие.Id);
	КонецЕсли;
	
КонецПроцедуры

Функция ПоставитьСобытиеВОчередьНаОтправку(Событие, Топик) Экспорт
	
	Возврат РегистрыСведений.КонтурЛогистика_СобытияМетрик.ПоставитьСобытиеВОчередьНаОтправку(Событие, Топик);
	
КонецФункции

Функция ПолучитьТелоЗапросаПоID(ID) Экспорт
	
	Возврат РегистрыСведений.КонтурЛогистика_СобытияМетрик.ПолучитьТелоЗапросаПоID(ID);
	
КонецФункции

// Отправляет пакет данных напрямую в Контур.Метрика 
Функция ОтправитьМетрики(IDСобытий = Неопределено) Экспорт

	// Получаем события для отправки
	ДеревоСобытий = ДеревоСобытийДляОтправки(IDСобытий);
	
	// Отправляем события по каждому топику
	РезультатОтправки = ОтправитьМетрикиПоТопикам(ДеревоСобытий); 
	
	// обрабатываем отпраленные/неотправленные события
	ОбработатьРезультатОтправкиСобытий(ДеревоСобытий, РезультатОтправки);
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ОтправитьМетрику(ТелоЗапроса, Топик, ID) Экспорт
	
	РаботаСВнешнимиРесурсамиЗаблокирована = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ПараметрыБлокировки_РаботаСВнешнимиРесурсамиЗаблокирована");
	Если РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
		РезультатОтправки.ОписаниеОшибки = "Включена настройка: Работа с внешними ресурсами заблокирована";
		Возврат РезультатОтправки;
	КонецЕсли;
	
	ТелоЗапроса = ЗаполнитьВремяОтправкиСобытия(ТелоЗапроса);
	
	РезультатОтправки = ОтправитьМетрикиПоТопику(ТелоЗапроса, Топик);
	
	ОбработатьРезультатОтправкиСобытия(ID, РезультатОтправки);
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ОтправитьМетрикиПоТопикам(ДеревоСобытий) Экспорт
	
	РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если ДеревоСобытий.Строки.Количество() = 0 Тогда // пустой пакет
	
		РезультатОтправки.Вставить("ТелоОтвета", "Нет данных для отправки"); 
		РезультатОтправки.Вставить("ЗапросВыполненУспешно", Ложь);
		
	Иначе
	
		Для Каждого СтрокаДерева Из ДеревоСобытий.Строки Цикл
			
			ПакетДанных = СтрокаДерева.Строки.ВыгрузитьКолонку("ТелоЗапроса");
			
			ТелоЗапроса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ПакетДанных, ",");
			ТелоЗапроса = ЗаполнитьВремяОтправкиСобытия(ТелоЗапроса);
			
			Если ПакетДанных.Количество() > 1 Тогда
				ТелоЗапроса = "[" + ТелоЗапроса + "]";
			КонецЕсли;
			
			РезультатОтправки = ОтправитьМетрикиПоТопику(ТелоЗапроса, СтрокаДерева.Топик);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ОтправитьМетрикиПоТопику(ТелоЗапроса, Топик) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();

	Запрос.Метод 				= "POST";
	Запрос.ТелоЗапроса.string 	= ТелоЗапроса;
	Если Топик = "Common_Statistics" Тогда 
		ПутьНаСервере = "/metrika-pipe/v1/sources/1CModule/topics/Common_Statistics/events";
	Иначе
		ПутьНаСервере = "/metrika-pipe/v1/sources/1CModule/topics/Logist_" + Топик + "/events";
	КонецЕсли;

	Возврат ОтправитьHTTPЗапрос(КонтурЛогистика_МетрикаПовтИсп.АдресСервера() + ПутьНаСервере, Запрос);
	
КонецФункции

Функция ДеревоСобытийДляОтправки(IDСобытий = Неопределено) Экспорт
		
	Возврат РегистрыСведений.КонтурЛогистика_СобытияМетрик.ДеревоСобытийДляОтправки(IDСобытий);
	
КонецФункции

Процедура ОбработатьРезультатОтправкиСобытий(ДеревоСобытий, РезультатОтправки) Экспорт
	
	Для Каждого СтрокаТопика Из ДеревоСобытий.Строки Цикл
		
		Для Каждого СтрокаДетали Из СтрокаТопика.Строки Цикл
			
			ОбработатьРезультатОтправкиСобытия(СтрокаДетали.ID, РезультатОтправки);
			
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбработатьРезультатОтправкиСобытия(IDСобытия, РезультатОтправки) Экспорт
	
	РегистрыСведений.КонтурЛогистика_СобытияМетрик.ОбработатьРезультатОтправкиСобытия(IDСобытия, РезультатОтправки);
	
КонецПроцедуры

Функция СформироватьТелоЗапросаПоСобытию(Событие) Экспорт
	
	Возврат ПреобразоватьВJSON(Событие);
	
КонецФункции

Процедура ОтправитьВсеМетрики() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные("Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами") Тогда
		Выполнить("ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(" +
			"Метаданные.РегламентныеЗадания.КонтурЛогистика_ОтправкаМетрик)");	
	Иначе
		КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.КонтурЛогистика_ОтправкаМетрик);
	КонецЕсли;
	
	// отправим метрики из очереди
	ОтправитьМетрики();
	
	// отправим трафик
	ОтправитьТрафик();
	
КонецПроцедуры

#Область Метрики

Процедура ПриОткрытииОсновнойФормы(ПараметрыСобытия) Экспорт
	
	Действие = КонтурЛогистика_МетрикаКлиентСервер.Действия()[ПараметрыСобытия.Действие];
	
	Метрика_ОтправитьСтатистикуСеанса(Действие, ПараметрыСобытия);
	
	ОтправитьМетрики();
	
	ОтправитьТрафик();
	
КонецПроцедуры

Процедура ОтправитьТрафик() Экспорт 
	
	Метрика_ОтправкаТрафика();
	
КонецПроцедуры

Процедура Общепродуктовая_ОтправитьЗапускМодуля(ПараметрыМетода) Экспорт
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияОбщепродуктовойМетрики = "1.0.0";
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ИмяНастройки = "ОбщепродуктоваяМетрика_Установка_Отправлена";
		
		Топик 		= КонтурЛогистика_МетрикаКлиентСервер.Топики().ОбщепродуктоваяМетрика;
		Категория 	= КонтурЛогистика_МетрикаКлиентСервер.Категории().Запуск;		
		
		Path_Action = ПараметрыМетода.Источник;
		ОписаниеСобытия = ПредзаполненноеСобытие(Path_Action, Категория); 
		
		УжеОтправлялиЭтуМетрику = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(ИмяНастройки) = Истина;
		Если Не УжеОтправлялиЭтуМетрику Тогда 
			ОписаниеСобытия.AppContext.Hardware.Вставить("CoresCount", 1);
		КонецЕсли;
		
		ОписаниеСобытия.AppContext.OS.Вставить("Version", ВерсияОбщепродуктовойМетрики); 
		
		ТелоЗапроса = ПреобразоватьВJSON(ОписаниеСобытия);
		РезультатОтправки = ОтправитьМетрику(ТелоЗапроса, Топик, ОписаниеСобытия.Id);
		
		Если РезультатОтправки.Успешно Тогда
			
			Если УжеОтправлялиЭтуМетрику <> Истина Тогда 
				Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяНастройки, Истина);
				ОбновитьПовторноИспользуемыеЗначения();
			КонецЕсли;	
			
		Иначе
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка отправки общепродуктовой метрики запуска модуля: " + РезультатОтправки.ТелоОтвета;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
		КонецЕсли;	

	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Ошибка отправки общепродуктовой метрики запуска модуля: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура Общепродуктовая_ОтправитьАвторизацию(МассивОрганизацийДиадок, Path_Action) Экспорт
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяНастройки = "ОбщепродуктоваяМетрика_Авторизация_Отправлена";
	ИспользуетсяТестовыйСервер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	Если ИспользуетсяТестовыйСервер Тогда
		ИмяНастройки = ИмяНастройки + "_ТестовыйСервер";
	КонецЕсли;
	
	Категория = КонтурЛогистика_МетрикаКлиентСервер.Категории().Авторизация;
	
	Для каждого ОрганизацияДиадок Из МассивОрганизацийДиадок Цикл
		Общепродуктовая_ОтправитьОбщепродуктовуюМетрикуПоОрганизации(Path_Action, ИмяНастройки, Категория, ОрганизацияДиадок);
	КонецЦикла;
	
КонецПроцедуры

Процедура Общепродуктовая_ОтправитьВыполнениеНастройки(ОрганизацияДиадок, Источник) Экспорт
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяНастройки = "ОбщепродуктоваяМетрика_Настройка_Отправлена";
	ИспользуетсяТестовыйСервер 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	Если ИспользуетсяТестовыйСервер Тогда 
		ИмяНастройки = ИмяНастройки + "_ТестовыйСервер"; 
	КонецЕсли;
	
	Path_Action = Источник;
	Категория 	= КонтурЛогистика_МетрикаКлиентСервер.Категории().Настройка;
	
	Общепродуктовая_ОтправитьОбщепродуктовуюМетрикуПоОрганизации(Path_Action, ИмяНастройки, Категория, ОрганизацияДиадок);
	
КонецПроцедуры

Процедура Общепродуктовая_ОтправитьВыполнениеЦелевогоДействия(ОрганизацияДиадок) Экспорт
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяНастройки = "ОбщепродуктоваяМетрика_ЦелевоеДействие_Отправлена";
	ИмяНастройкиКонтроляДня = "ОбщепродуктоваяМетрика_ЦелевоеДействие_Дата";
	ИспользуетсяТестовыйСервер 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	Если ИспользуетсяТестовыйСервер Тогда 
		ИмяНастройки 			= ИмяНастройки + "_ТестовыйСервер"; 
		ИмяНастройкиКонтроляДня = ИмяНастройкиКонтроляДня + "_ТестовыйСервер"; 
	КонецЕсли;
	
	Path_Action = "ОтправкаТитула";
	Категория 	= КонтурЛогистика_МетрикаКлиентСервер.Категории().ЦелевоеДействие;
	
	// эта метрика должна отправляться не чаще 1 раза в день
	КогдаПоследнийРазОтправляли = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСлужебнойНастройкиОрганизацииДиадок(ОрганизацияДиадок, ИмяНастройкиКонтроляДня);
	ТекДень = НачалоДня(ТекущаяДатаСеанса());
	
	Если Не ЗначениеЗаполнено(КогдаПоследнийРазОтправляли)
		Или ТипЗнч(КогдаПоследнийРазОтправляли) = Тип("Дата") И КогдаПоследнийРазОтправляли < ТекДень
		Или ТипЗнч(КогдаПоследнийРазОтправляли) <> Тип("Дата") Тогда
		
		Общепродуктовая_ОтправитьОбщепродуктовуюМетрикуПоОрганизации(Path_Action, ИмяНастройки, Категория, ОрганизацияДиадок);
		
		Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьСлужебнуюНастройку(ОрганизацияДиадок, ИмяНастройкиКонтроляДня, ТекДень);
		ОбновитьПовторноИспользуемыеЗначения();
		
	КонецЕсли;

КонецПроцедуры

Процедура Общепродуктовая_ОтправитьОбщепродуктовуюМетрикуПоОрганизации(Знач Path_Action, ИмяНастройки, Знач Категория, Знач ОрганизацияДиадок)
	
	Если ОтправкаМетрикЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ВерсияОбщепродуктовойМетрики = "1.0.0";
		Топик 		= КонтурЛогистика_МетрикаКлиентСервер.Топики().ОбщепродуктоваяМетрика;
		УжеОтправлялиЭтуМетрику = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСлужебнойНастройкиОрганизацииДиадок(ОрганизацияДиадок, ИмяНастройки) = Истина; 
		
		ОписаниеСобытия = ПредзаполненноеСобытие(Path_Action, Категория, , ОрганизацияДиадок);
		ДополнитьСобытиеИННКПП(ОписаниеСобытия, ОрганизацияДиадок);
		
		Если Не УжеОтправлялиЭтуМетрику Тогда 
			ОписаниеСобытия.AppContext.Hardware.Вставить("CoresCount", 1);
		КонецЕсли;
		
		МассивСвойствОрганизацийДляХлебныхКрошек = МассивСвойствОрганизацийДляХлебныхКрошек();
		Если МассивСвойствОрганизацийДляХлебныхКрошек.Количество() > 0 Тогда 
			ОписаниеСобытия.Session.NormativeSession.Вставить("Roles", МассивСвойствОрганизацийДляХлебныхКрошек);
		КонецЕсли;
		
		ОписаниеСобытия.AppContext.OS.Вставить("Version", ВерсияОбщепродуктовойМетрики); 
	
		ТелоЗапроса = ПреобразоватьВJSON(ОписаниеСобытия);
		РезультатОтправки = ОтправитьМетрику(ТелоЗапроса, Топик, ОписаниеСобытия.Id);
		
		Если РезультатОтправки.Успешно Тогда
			
			Если Не УжеОтправлялиЭтуМетрику Тогда 
				Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьСлужебнуюНастройку(ОрганизацияДиадок, ИмяНастройки, Истина);
				ОбновитьПовторноИспользуемыеЗначения();
			КонецЕсли;
			
		Иначе
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка отправки общепродуктовой метрики " + ИмяНастройки + ": " + РезультатОтправки.ТелоОтвета;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,ОрганизацияДиадок, ТекстОшибки);
			
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Ошибка отправки общепродуктовой метрики " + ИмяНастройки + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ОрганизацияДиадок, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ОтправитьHTTPЗапрос(АдресМетода, ПараметрыЗапроса) Экспорт
	
	РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	РезультатОтправки.Вставить("ТелоОтвета");	
	ЗапросВыполненУспешно = Ложь;
	
	Попытка
		
		РезультатЗапроса = КонтурЛогистика_HTTPТранспортКлиентСервер.ВыполнитьHTTPЗапрос(АдресМетода, ПараметрыЗапроса);
		ЗапросВыполненУспешно = Истина;
		
	Исключение
		
		РезультатОтправки.Вставить("ТелоОтвета", ОписаниеОшибки());
		
	КонецПопытки;
	
	Если ЗапросВыполненУспешно Тогда
		
		ЗапросПринят = СокрЛП(РезультатЗапроса.КодСостояния) = "200";
		
		РезультатОтправки.Успешно = ЗапросПринят;
		РезультатОтправки.Вставить("ТелоОтвета", РезультатЗапроса.ТелоОтвета);
		Если Не ЗапросПринят Тогда 
			РезультатОтправки.Вставить("ОписаниеОшибки", РезультатЗапроса.ТелоОтвета);
		КонецЕсли;
		
	КонецЕсли;

	РезультатОтправки.Вставить("ЗапросВыполненУспешно", ЗапросВыполненУспешно);
	
	Возврат РезультатОтправки;
	
КонецФункции

