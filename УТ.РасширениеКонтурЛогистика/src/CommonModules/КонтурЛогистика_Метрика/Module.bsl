	|				ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1)
	|				ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2)
	|				ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3)
	|				ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4)
	|				ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5)
	|				ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6)
	|			ТОГДА ""Перевозчик""
	|		КОГДА КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
	|			ТОГДА ""Грузополучатель""
	|		ИНАЧЕ ""Роль не определена""
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДоставкиДиадок
	|ИТОГИ
	|	СУММА(Количество)
	|ПО
	|	ДатаДоставкиДиадок"; 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", ДатаОтправкиТрафикаМСК + 1);
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК()) - 1);  // Конец вчерашнего дня
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция ТрафикПоДнямВерсия2(ДатаОтправкиТрафикаМСК) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(КонтурЛогистика_ФайлыОбмена.Ссылка) КАК Количество,
	|	КонтурЛогистика_ФайлыОбмена.ТипДокумента КАК ТипДокумента,
	|	НАЧАЛОПЕРИОДА(КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования, ДЕНЬ) КАК ДатаДоставкиДиадок,
	|	КонтурЛогистика_ФайлыОбмена.Отправитель КАК ОрганизацияДиадок,
	|	КонтурЛогистика_ФайлыОбмена.ТестовыйДокумент КАК ТестовыйДокумент
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования МЕЖДУ &НачалоПериода И &КонецПериода
	|	И КонтурЛогистика_ФайлыОбмена.Отправитель.Наш
	|	И КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования, ДЕНЬ),
	|	КонтурЛогистика_ФайлыОбмена.ТипДокумента,
	|	КонтурЛогистика_ФайлыОбмена.Отправитель,
	|	КонтурЛогистика_ФайлыОбмена.ТестовыйДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДоставкиДиадок
	|ИТОГИ
	|	СУММА(Количество)
	|ПО
	|	ДатаДоставкиДиадок,
	|	ОрганизацияДиадок"; 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", ДатаОтправкиТрафикаМСК + 1);
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК()) - 1);  // Конец вчерашнего дня
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция КатегоряПоОбъекту(ОбъектСсылка)
	
	ТипЗначенияОбъекта = ТипЗнч(ОбъектСсылка);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначенияОбъекта);
	Категоря = СтрЗаменить(ОбъектМетаданных.Имя, "КонтурЛогистика_", "");
	
	Возврат Категоря;
	
КонецФункции

Процедура ОбработатьОшибкуФормированияТекстаФайла(ДокументСсылка, ИнформацияОбОшибке, КонтекстМетода = Неопределено) Экспорт
	
	ДопИнформация = Новый Структура("КонтекстМетода", КонтекстМетода);
	
	ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЛогистическийТипПоТипуДокумента(ТипЗнч(ДокументСсылка));
	
	ОбработатьОшибкуТипаДокумента("СформироватьФайлОбмена", ТипДокумента, ИнформацияОбОшибке, ДокументСсылка, ДопИнформация);
	
КонецПроцедуры

Процедура ОбработатьОшибкуТипаДокумента(Действие, ТипДокумента, ИнформацияОбОшибке, СсылкаНаОбъект = Неопределено, ДопИнформация = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ТипДокумента) Тогда
		СокращенноеПредставлениеТипаДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.СокращенноеПредставлениеТипаДокумента(ТипДокумента);
	Иначе
		СокращенноеПредставлениеТипаДокумента = Новый Структура;
		СокращенноеПредставлениеТипаДокумента.Вставить("ПредставлениеДокумента", "");
		СокращенноеПредставлениеТипаДокумента.Вставить("НомерТитула", "");
	КонецЕсли;
	
	Если ДопИнформация = Неопределено Тогда
		ДопИнформация = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(ИнформацияОбОшибке) = Тип("Строка") Тогда
		ДопИнформация.Вставить("TextError", ИнформацияОбОшибке);
	Иначе
		ДопИнформация.Вставить("TextError", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецЕсли;
	
	ДопИнформация.Вставить("DocumentType", СокращенноеПредставлениеТипаДокумента.ПредставлениеДокумента);
	ДопИнформация.Вставить("Title", "Т" + СокращенноеПредставлениеТипаДокумента.НомерТитула);
	ДопИнформация.Вставить("Direction", "Outbound");
	
	ОбработатьОшибку(Действие, ИнформацияОбОшибке, СсылкаНаОбъект, ДопИнформация);
	
КонецПроцедуры

// Формирует строку доп. информации для журнала регистрации
//
// Параметры:
//  ДопИнформация - Массив, Соответствие, Структура, Строка, Ссылка - доп. информация
// 
// Возвращаемое значение:
//  Строка - строка доп. информации
//
Функция СтрокаДопИнформацииДляЖурналаРегистрации(ДопИнформация)
	
	ТипДопИнформации = ТипЗнч(ДопИнформация);
	СтрокиДопИнформации = Новый Массив;
	ШаблонКлючЗначение = "%1: %2";
	
	Если ТипДопИнформации = Тип("Строка") Тогда
		
		СтрокиДопИнформации.Добавить(ДопИнформация);
		
	ИначеЕсли КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоМассив(ДопИнформация) Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокиДопИнформации.Добавить(СтрокаДопИнформацииДляЖурналаРегистрации(Элемент));
		КонецЦикла;
		
	ИначеЕсли ТипДопИнформации = Тип("СписокЗначений") Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокаКлючЗначение = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
				ШаблонКлючЗначение, Элемент.Представление, СтрокаДопИнформацииДляЖурналаРегистрации(Элемент.Значение));
			СтрокиДопИнформации.Добавить(СтрокаКлючЗначение);
		КонецЦикла;
		
	ИначеЕсли КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоСтруктура(ДопИнформация)
		Или КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоСоответствие(ДопИнформация) Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокаКлючЗначение = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
				ШаблонКлючЗначение, Элемент.Ключ, СтрокаДопИнформацииДляЖурналаРегистрации(Элемент.Значение));
			СтрокиДопИнформации.Добавить(СтрокаКлючЗначение);
		КонецЦикла;
		
	Иначе
		
		СтрокиДопИнформации.Добавить(СокрЛП(ДопИнформация));
		
	КонецЕсли;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(СтрокиДопИнформации, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

#Область ОперативныйМониторингОшибок

Процедура ОтправитьВОперативныйМониторингОшибок(ОписаниеСобытия, Представление, ПодробноеПредставлениеОшибки, КраткоеПредставлениеОшибки, ДопИнформация)
	
	ОписаниеОшибки = ОписаниеОшибкиМониторгинга(ОписаниеСобытия, ПодробноеПредставлениеОшибки, КраткоеПредставлениеОшибки, ДопИнформация);
	
	ПараметрыСервиса = ПараметрыСервисаSentry();
	
	Если Не ЗначениеЗаполнено(ПараметрыСервиса.sentry_key) Тогда
		// Запись в журнал регистрации
		ТекстОшибки = "Отправка информации в сервис сбора ошибок: не удалось получить параметры подключения к сервису Sentry.";
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = КонтурЛогистика_КоннекторHTTP.НовыеПараметры();
	ДополнительныеПараметры.Прокси = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьИнтернетПрокси();
	
	Попытка
		КонтурЛогистика_ИнтеграцияSentry.ОтправитьВСервис(ОписаниеОшибки, ПараметрыСервиса, ДополнительныеПараметры);
	Исключение
		// Запись в журнал регистрации
		ТекстОшибки = "Отправка информации в сервис сбора ошибок" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Функция ОписаниеОшибкиМониторгинга(ОписаниеСобытия, ПодробноеПредставлениеОшибки, КраткоеПредставлениеОшибки, ДопИнформация)
	
	Переменные = ОписаниеСобытия.Variables;
	
	ОписаниеОшибки = КонтурЛогистика_ИнтеграцияSentry.НовыйОписаниеОшибки_();
	ОписаниеОшибки.release = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	
	ИспользуетсяТестовыйАПИ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	Если ИспользуетсяТестовыйАПИ Тогда
		ОписаниеОшибки.environment = "staging";
	Иначе
		ОписаниеОшибки.environment = "prod";
	КонецЕсли;
	
	ОписаниеОшибки.user.Вставить("username", ОписаниеСобытия.Session.NormativeSession.Marker);
	КонтурЛогистика_ИнтеграцияSentry.ДобавитьИсключение(ОписаниеОшибки, ОписаниеСобытия.Path.Category, ПодробноеПредставлениеОшибки);
	
	// Дополнительная информация (extra)
	Addons = СтрокаВОбъектДанных(Переменные.Получить("Addons").value);
	ОписаниеОшибки.extra.Вставить("Addons", Addons);
	ОписаниеОшибки.extra.Вставить("IDБазыДанных", Переменные.Получить("IDБазыДанных").value);
	ОписаниеОшибки.extra.Вставить("DocumentType", "POST");
	
	// Настройки модуля
	НастройкиМодуля = СтрокаВОбъектДанных(Переменные.Получить("Настройки").value);
	ОписаниеОшибки.extra.Вставить("Настройки", НастройкиМодуля);
	
	// Наши организации
	НашиОрганизации = СтрокаВОбъектДанных(Переменные.Получить("НашиОрганизации").value);
	ОписаниеОшибки.extra.Вставить("НашиОрганизации", НашиОрганизации);
	
	// Контекст подсистемы
	КонтекстПодсистемы = СтрокаВОбъектДанных(Переменные.Получить("КонтекстПодсистемы").value);
	ОписаниеОшибки.extra.Вставить("КонтекстПодсистемы", КонтекстПодсистемы);
	
	// Дополнительная информация
	Если ТипЗнч(ДопИнформация) = Тип("Структура") Тогда
		Для каждого ТекущаяСтрока Из ДопИнформация Цикл
			Если ТипЗнч(ТекущаяСтрока.Значение) = Тип("Структура") Тогда
				Попытка
					ПредставлениеДанных = СтрокаДопИнформацииДляЖурналаРегистрации(ТекущаяСтрока.Значение);
				Исключение
					ПредставлениеДанных = СокрЛП(ТекущаяСтрока.Значение);
				КонецПопытки;
			Иначе
				ПредставлениеДанных = СокрЛП(ТекущаяСтрока.Значение);
			КонецЕсли;
			
			ОписаниеОшибки.extra.Вставить(ТекущаяСтрока.Ключ, ПредставлениеДанных);
		КонецЦикла;
	КонецЕсли;
	
	// Теги (tags)
	ОписаниеОшибки.tags.Вставить("ModuleVariant", Переменные.Получить("ModuleVariant").value);
	ОписаниеОшибки.tags.Вставить("Source", ОписаниеСобытия.Path.Action);
	ОписаниеОшибки.tags.Вставить("release", ОписаниеСобытия.ClientInfo.ClientVersion);
	ОписаниеОшибки.tags.Вставить("PM", ?(Переменные.Получить("PM").value = "Отключен", Ложь, Истина));
	ОписаниеОшибки.tags.Вставить("ModuleIsProd", ?(Переменные.Получить("ModuleIsProd").value = "0", Ложь, Истина));
	
	Кастом = Переменные.Получить("Custom").value;
	Если Кастом = "1" Или Кастом = 1 Тогда
		Кастом = Истина;
	ИначеЕсли Кастом = "0" Или Кастом = 0 Тогда
		Кастом = Ложь;
	КонецЕсли;
	ОписаниеОшибки.tags.Вставить("Custom", Кастом);
	
	Попытка
		МассивGUID = ЗаменитьGUID(КраткоеПредставлениеОшибки);
		МассивTraceId = ЗаменитьTraceId(КраткоеПредставлениеОшибки);
	Исключение
		МассивGUID = Новый Массив;
		МассивTraceId = Новый Массив;
	КонецПопытки;
	
	ОписаниеОшибки.message = КраткоеПредставлениеОшибки;
	
	Если МассивGUID.Количество() <> 0 Тогда
		ОписаниеОшибки.extra.Вставить("GUID", КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(МассивGUID));
	КонецЕсли;
	
	Если МассивTraceId.Количество() <> 0 Тогда
		ОписаниеОшибки.extra.Вставить("TraceId", КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(МассивTraceId));
	КонецЕсли;
	
	Возврат ОписаниеОшибки;
	
КонецФункции

Функция СтрокаВОбъектДанных(Знач ВходныеДанные)
	
	Если ТипЗнч(ВходныеДанные) <> Тип("Строка") Тогда
		Возврат ВходныеДанные;
	КонецЕсли;
	
	Попытка
		ИтоговоеЗначение = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(ВходныеДанные, Истина);
		Если ИтоговоеЗначение = Неопределено Тогда
			Возврат Ложь;
		Иначе
			Возврат ИтоговоеЗначение;
		КонецЕсли;
	Исключение
		Возврат ВходныеДанные;
	КонецПопытки;
	
КонецФункции

Функция ПараметрыСервисаSentry()
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияSentry.НовыйПараметрыСервиса();
	
	ПараметрыСервисаИзСервисаОбновлений = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьСведенияОбПараметрахПодключенияSentry();
	
	ЗаполнитьЗначенияСвойств(ПараметрыСервиса, ПараметрыСервисаИзСервисаОбновлений);
	
	Возврат ПараметрыСервиса;
	
КонецФункции

Функция КонтентДляПроверкиОбновления(ТекущаяВерсия = Неопределено)
	
	ТестовоеОкружение = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	ИдентификаторЭкземпляра = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СлужебныйИдентификаторБазыДанных");
	
	Результат = Новый Структура;
	
	Результат.Вставить("client_id", ИдентификаторЭкземпляра);
	Результат.Вставить("client_is_test", ТестовоеОкружение);
	
	Результат.Вставить("conf_name", Метаданные.Имя);
	Результат.Вставить("conf_version", Метаданные.Версия);
	Результат.Вставить("platform_version", ВерсияПлатформы());
	
	Если ЗначениеЗаполнено(ТекущаяВерсия) Тогда
		Результат.Вставить("version", ТекущаяВерсия);
	Иначе
		//Результат.Вставить("version", ПустаяВерсия());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияПлатформы()
	
	СисИнфо = Новый СистемнаяИнформация;
	Результат = СисИнфо.ВерсияПриложения;
	
	Возврат Результат;
	
КонецФункции

