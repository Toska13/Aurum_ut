////////////////////////////////////////////////////////////////////////////////
// Серверные процедуры и функции для онбординга:
// - для создания выпадающего меню Помощь;
// - для настройки открытия онбординга для конкретного пользователя
//  
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает Истина, если пользователь открывал указанный онбординг.
//
// Параметры:
//  ИдентификаторОнбординга - Строка - см. КонтурЛогистика_ОнбродингКлиентСервер.ТипыОнбординга()
//
// Возвращаемое значение:
//   Булево - пользователь открывал указанный онбординг
// 
Функция ТекПользовательОткрывалОнбординг(ИдентификаторОнбординга) Экспорт
	
	Открыл = ХранилищеОбщихНастроек.Загрузить("КонтурЛогистикаОнбординг", ИдентификаторОнбординга);
	
	Возврат Открыл = Истина;
		
КонецФункции // ТекПользовательОткрывалОнбординг

// Удаляет настройку, что пользователь открывал онбординг
//
// Параметры:
//  ИдентификаторОнбординга - Строка - см. КонтурЛогистика_ОнбродингКлиентСервер.ТипыОнбординга()
// 
Процедура УдалитьТекПользовательОткрывалОнбординг(ИдентификаторОнбординга) Экспорт
	
	ХранилищеОбщихНастроек.Сохранить("КонтурЛогистикаОнбординг", ИдентификаторОнбординга, Ложь);
		
КонецПроцедуры // ТекПользовательОткрывалОнбординг


// Записывает в хранилище общих настроек, факт открытия указанного онбординга текущим пользователем
//
// Параметры:
//  ИдентификаторОнбординга - Строка - см. КонтурЛогистика_ОнбродингКлиентСервер.ТипыОнбординга()
//
Процедура ТекПользовательОткрылОнбординг(ИдентификаторОнбординга) Экспорт
	
	ХранилищеОбщихНастроек.Сохранить("КонтурЛогистикаОнбординг", ИдентификаторОнбординга, Истина);
		
КонецПроцедуры // ТекПользовательОткрылОнбординг

// Создает кнопки Помощь в переданной форме
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ПриСозданииФормы(ЭтаФорма) Экспорт
	
	ДобавитьГруппуКоманд(ЭтаФорма);	
	
КонецПроцедуры // ПриСозданииФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьГруппуКоманд(Форма)
	
	ЭлементГруппаПомощь = Форма.Элементы.Найти("КонтурЛогистикаПодключаемыйГруппаПомощь");
	
	Если ЭлементГруппаПомощь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементПодменюПомощь = СоздатьПодменюПомощь(Форма, ЭлементГруппаПомощь);
	
		ЭлементГруппаКнопокКакРаботатьСРазделом = СоздатьГруппуКнопокКакРаботатьСРазделом(Форма, ЭлементПодменюПомощь);

			СоздатьКнопкуКакРаботатьСРазделом(Форма, ЭлементГруппаКнопокКакРаботатьСРазделом);

		ЭлементГруппаКнопокЦентрПоддержки = СоздатьГруппуКнопокЦентрПоддержки(Форма, ЭлементПодменюПомощь);

			СоздатьКнопкуЦентрПоддержки(Форма, ЭлементГруппаКнопокЦентрПоддержки);
			СоздатьКнопкуИнформацияЦентрПоддержки(Форма, ЭлементГруппаКнопокЦентрПоддержки);
			СоздатьКнопкуСправка(Форма, ЭлементГруппаКнопокЦентрПоддержки);
	
КонецПроцедуры // ДобавитьГруппуКоманд

Функция СоздатьПодменюПомощь(Форма, Родитель)
	
	ИмяПодменю = "КонтурЛогистикаДинамическаяПодменюПомощь";
	
	ЭлементПодменюПомощь = Форма.Элементы.Найти(ИмяПодменю);
	
	Если ЭлементПодменюПомощь <> Неопределено Тогда
		Возврат ЭлементПодменюПомощь;
	КонецЕсли;
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Вид", ВидГруппыФормы.Подменю);
	СтруктураСвойств.Вставить("Заголовок", "Помощь");
	СтруктураСвойств.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Вопрос);
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппа(Форма, ИмяПодменю, Родитель, СтруктураСвойств);   
	
КонецФункции // СоздатьПодменюПомощь

Функция СоздатьГруппуКнопокКакРаботатьСРазделом(Форма, Родитель)
	
	ИмяГруппыКнопок = "КонтурЛогистикаДинамическаяГруппаКнопокРаботаСРазделом";
	
	ЭлементГруппыКнопок = Форма.Элементы.Найти(ИмяГруппыКнопок);
	
	Если ЭлементГруппыКнопок <> Неопределено Тогда
		Возврат ЭлементГруппыКнопок;
	КонецЕсли;
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Вид", ВидГруппыФормы.ГруппаКнопок);
	СтруктураСвойств.Вставить("Заголовок", "Как работать с разделом (Группа)");
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппа(Форма, ИмяГруппыКнопок, Родитель, СтруктураСвойств);   
	
КонецФункции // СоздатьГруппуКнопокКакРаботатьСРазделом

Функция СоздатьГруппуКнопокЦентрПоддержки(Форма, Родитель)
	
	ИмяГруппыКнопок = "КонтурЛогистикаДинамическаяГруппаКнопокЦентрПоддержки";
	
	ЭлементГруппыКнопок = Форма.Элементы.Найти(ИмяГруппыКнопок);
	
	Если ЭлементГруппыКнопок <> Неопределено Тогда
		Возврат ЭлементГруппыКнопок;
	КонецЕсли;
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Вид", ВидГруппыФормы.ГруппаКнопок);
	СтруктураСвойств.Вставить("Заголовок", "Центр поддержки (Группа)");
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппа(Форма, ИмяГруппыКнопок, Родитель, СтруктураСвойств);   
	
КонецФункции // СоздатьГруппуКнопокЦентрПоддержки

Функция СоздатьКнопкуКакРаботатьСРазделом(Форма, Родитель)
	
	ИмяКнопоки = "КонтурЛогистикаДинамическаяКнопкаКакРаботатьСРазделом";
	
	ЭлементКнопки = Форма.Элементы.Найти(ИмяКнопоки);
	
	Если ЭлементКнопки <> Неопределено Тогда
		Возврат ЭлементКнопки;
	КонецЕсли;
	
	ЗаголовокКнопки = "Как работать с этим разделом";
	
	ИмяДействия = "КонтурЛогистикаПодключаемый_ВыполнитьКоманду";
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Информация);
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьКоманду(Форма, ИмяКнопоки,, ИмяДействия, СтруктураСвойств);  
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(Форма, ИмяКнопоки, Родитель, ЗаголовокКнопки, ИмяКнопоки);
	
КонецФункции // СоздатьКнопкуКакРаботатьСРазделом

Функция СоздатьКнопкуЦентрПоддержки(Форма, Родитель)
	
	ИмяКнопоки = "КонтурЛогистикаДинамическаяКнопкаЦентрПоддержки";
	
	ЭлементКнопки = Форма.Элементы.Найти(ИмяКнопоки);
	
	Если ЭлементКнопки <> Неопределено Тогда
		Возврат ЭлементКнопки;
	КонецЕсли;
	
	ЗаголовокКнопки = "Центр поддержки";
	
	ИмяДействия = "КонтурЛогистикаПодключаемый_ВыполнитьКоманду";
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Поддержка16);

	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьКоманду(Форма, ИмяКнопоки,, ИмяДействия, СтруктураСвойств);  
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(Форма, ИмяКнопоки, Родитель, ЗаголовокКнопки, ИмяКнопоки);
	
КонецФункции // СоздатьКнопкуЦентрПоддержки

Функция СоздатьКнопкуИнформацияЦентрПоддержки(Форма, Родитель)
	
	ИмяКнопоки = "КонтурЛогистикаДинамическаяКнопкаИнформацияЦентрПоддержки";
	
	ЭлементКнопки = Форма.Элементы.Найти(ИмяКнопоки);
	
	Если ЭлементКнопки <> Неопределено Тогда
		Возврат ЭлементКнопки;
	КонецЕсли;
	
	ЗаголовокКнопки = "Информация для техподдержки";
	
	ИмяДействия = "КонтурЛогистикаПодключаемый_ВыполнитьКоманду";
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьКоманду(Форма, ИмяКнопоки,, ИмяДействия);  
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(Форма, ИмяКнопоки, Родитель, ЗаголовокКнопки, ИмяКнопоки);
	
КонецФункции // СоздатьКнопкуИнформацияЦентрПоддержки

Функция СоздатьКнопкуСправка(Форма, Родитель)
	
	ИмяКнопоки = "КонтурЛогистикаДинамическаяКнопкаСправка";
	
	ЭлементКнопки = Форма.Элементы.Найти(ИмяКнопоки);
	
	Если ЭлементКнопки <> Неопределено Тогда
		Возврат ЭлементКнопки;
	КонецЕсли;
	
	ЗаголовокКнопки = "Справка";
	
	ИмяДействия = "КонтурЛогистикаПодключаемый_ВыполнитьКоманду";
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Вопрос);
	СтруктураСвойств.Вставить("СочетаниеКлавиш", Новый СочетаниеКлавиш(Клавиша.F1));
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьКоманду(Форма, ИмяКнопоки,, ИмяДействия, СтруктураСвойств);  
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(Форма, ИмяКнопоки, Родитель, ЗаголовокКнопки, ИмяКнопоки);
	
КонецФункции // СоздатьКнопкуСправка

#КонецОбласти