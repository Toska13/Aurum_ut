Функция ЭтоВалидныйСертификат(ДанныеСертификата) Экспорт
	
	Результат = Ложь;
	
	Если ТипЗнч(ДанныеСертификата) = Тип("Структура")
		
		И ДанныеСертификата.Свойство("Субъект") И ТипЗнч(ДанныеСертификата.Субъект) = Тип("Структура")
		И ДанныеСертификата.Субъект.Свойство("CN")
		И (ДанныеСертификата.Субъект.Свойство("ИНН") ИЛИ ДанныеСертификата.Субъект.Свойство("ИННЮЛ"))
		
		И ДанныеСертификата.Свойство("Издатель") И ТипЗнч(ДанныеСертификата.Издатель) = Тип("Структура")
		И ДанныеСертификата.Издатель.Свойство("CN") 
		
	Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВсеСвойстваСертификата(ДобавитьДвоичныеДанные = Ложь, ДобавитьЗакрытыйКлюч = Истина) Экспорт
	
	Результат = Новый Структура("СерийныйНомер, Издатель, Субъект, ДатаНачала, ДатаОкончания, АлгоритмКлюча");
	
	Если ДобавитьДвоичныеДанные = Истина Тогда
		Результат.Вставить("ДвоичныеДанные");
	КонецЕсли;
	
	Если ДобавитьЗакрытыйКлюч = Истина Тогда
		Результат.Вставить("ЕстьЗакрытыйКлюч");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Отпечаток", HexСтрокаИзДвоичныхДанных(СертификатКриптографии.Отпечаток));
	
	Если СвойстваСертификата.Свойство("СерийныйНомер") Тогда
		Результат.Вставить("СерийныйНомер", HexСтрокаИзДвоичныхДанных(СертификатКриптографии.СерийныйНомер));
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("Издатель") Тогда
		Результат.Вставить("Издатель", Новый Структура(СертификатКриптографии.Издатель));
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("Субъект") Тогда
		
		Результат.Вставить("Субъект", Новый Структура(СертификатКриптографии.Субъект));
		
		Если СертификатКриптографии.Субъект.Свойство("OID2_5_4_4") Тогда
			Результат.Субъект.Вставить("Фамилия", СертификатКриптографии.Субъект.OID2_5_4_4);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("OID2_5_4_42") Тогда
			Результат.Субъект.Вставить("ИмяОтчество", СертификатКриптографии.Субъект.OID2_5_4_42);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("OGRN")Тогда
			Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OGRN);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_1") Тогда
			Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OID1_2_643_100_1);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("SNILS") Тогда
			Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.SNILS);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_3") Тогда
			Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.OID1_2_643_100_3);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("INN") Тогда
			Результат.Субъект.Вставить("ИНН", СертификатКриптографии.Субъект.INN);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_3_131_1_1")Тогда
			Результат.Субъект.Вставить("ИНН", СертификатКриптографии.Субъект.OID1_2_643_3_131_1_1);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_4")Тогда
			Результат.Субъект.Вставить("ИННЮЛ", СертификатКриптографии.Субъект.OID1_2_643_100_4);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("OGRNIP")Тогда
			Результат.Субъект.Вставить("ОГРНИП", СертификатКриптографии.Субъект.OGRNIP);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_5")Тогда
			Результат.Субъект.Вставить("ОГРНИП", СертификатКриптографии.Субъект.OID1_2_643_100_5);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("ДвоичныеДанные") Тогда
		Результат.Вставить("ДвоичныеДанные", СертификатКриптографии.Выгрузить());
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("ДатаНачала") Тогда
		Результат.Вставить("ДатаНачала", СертификатКриптографии.ДатаНачала);
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("ДатаОкончания") Тогда
		Результат.Вставить("ДатаОкончания", СертификатКриптографии.ДатаОкончания);
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("РасширенныеСвойства") Тогда
		Результат.Вставить("РасширенныеСвойства", Новый Структура(СертификатКриптографии.РасширенныеСвойства));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСертификатВМассивеПоОтпечатку(МассивСертификатов, ОтпечатокСертификата) Экспорт
	
	Результат = Неопределено;
	
	Для Каждого Сертификат Из МассивСертификатов Цикл
		
		ТекущийОтпечаток = HexСтрокаИзДвоичныхДанных(Сертификат.Отпечаток);
		
		Если НРег(ТекущийОтпечаток) = НРег(ОтпечатокСертификата) Тогда
			
			Результат = Сертификат;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РазделитьСтроку(Знач Строка, Разделитель = ",", ВключатьПустые = Истина) Экспорт
	
	Результат = Новый Массив;
	
	МассивРазделителей = Новый Массив;
	
	Для Сч = 1 По СтрДлина(Разделитель) Цикл
		СимволРазделителя = Сред(Разделитель, Сч, 1);
		МассивРазделителей.Добавить(СимволРазделителя);
	КонецЦикла;
	
	Пока Истина Цикл
		
		Поз = 0;
		
		Для Каждого СимволРазделителя Из МассивРазделителей Цикл
			
			Поз = Найти(Строка, СимволРазделителя);
			
			Если Поз > 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Поз = 0 Тогда
			Подстрока	 = СокрЛП(Строка);
			Строка		 = "";
		Иначе
			Подстрока	 = СокрЛП(Лев(Строка, Поз - 1));
			Строка		 = Сред(Строка, Поз + 1);
		КонецЕсли;
		
		Если ВключатьПустые ИЛИ ЗначениеЗаполнено(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		
		Если Поз = 0 Тогда
			Прервать; // Нет разделителя, за которым могла бы быть следующая часть строки.
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция HexСтрокаИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	
	Результат = СтрЗаменить(Строка(ДвоичныеДанные), " ", "");
		
	Возврат Результат;
	
КонецФункции

