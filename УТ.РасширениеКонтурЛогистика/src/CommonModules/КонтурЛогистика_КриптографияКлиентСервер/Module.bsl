#Область ОшибкиКриптографии

Функция ТипОшибкиКриптографии(КодОшибки, НаСервере) Экспорт

	Если КодОшибки = "100" Или КодОшибки = "2148532334" Или КодОшибки = "НеНайденСертификат" Тогда
					
		Если НаСервере Тогда
			Возврат "НеНайденСертификатНаСервере";
		Иначе
			Возврат "НеНайденСертификатНаКлиенте";
		КонецЕсли;
		
	ИначеЕсли КодОшибки = "1627" Или КодОшибки = "ИстеклаЛицензияКриптоПро" Тогда
					
		Возврат "ИстеклаЛицензияКриптоПро";	
		
	Иначе
		
		Возврат "ПрочаяОшибкаКриптографии";	
		
	КонецЕсли;
		
КонецФункции

Функция КодОшибкиМенеджераКриптографии(Описание) Экспорт
	
	Если Описание = "Значение не является значением объектного типа (Отпечаток)"
		Или Описание = "Значение не является значением объектного типа (Отпечаток)" Тогда
		Возврат "НеНайденСертификат";
	ИначеЕсли Найти(Описание, "0x0000065B") > 0 Тогда
		Возврат "ИстеклаЛицензияКриптоПро";
	Иначе
		Возврат "ПрочаяОшибкаКриптографии";	
	КонецЕсли;
	
КонецФункции

Функция ОшибкиКриптографии() Экспорт
	
	ТипыОшибок = Новый Структура;
			
	// 1. Не найден сертификат на сервере
		
	ВариантыРешения = Новый Массив;
	
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", 
		"Проверьте, что сертификат установлен на сервере приложений 1С в локальном хранилище пользователя, под которым запускается служба rphost.");
	ВариантыРешения.Добавить(ВариантРешения);	
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", 
		"Если у вас в кластере несколько физических серверов - убедитесь, что сертификат установлен на каждом.");
	ВариантыРешения.Добавить(ВариантРешения);
	
	ВариантРешения = Новый Структура;
	ФорматированнаяСтрока = Новый Массив;
	ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("Если ошибка сохранилась, то на сервере пройдите "));
	ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("диагностику",,,, "https://help.kontur.ru/diadoc"));
	ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока(" и выполните рекомендации."));		
	ВариантРешения.Вставить("Наименование", ФорматированнаяСтрока);
	ВариантыРешения.Добавить(ВариантРешения);
	
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", 
		"Если после выполнения рекомендаций ошибка сохранилась, обратитесь в техподдержку и сообщите номер диагностики.");
	ВариантыРешения.Добавить(ВариантРешения);
	
	СоставОшибки = Новый Структура;
	СоставОшибки.Вставить("ПредставлениеТипаОшибки", "Не найден сертификат на сервере");
	СоставОшибки.Вставить("ВариантыРешения", ВариантыРешения);
	
	ТипыОшибок.Вставить("НеНайденСертификатНаСервере", СоставОшибки);
	
	// 2. Не найден сертификат на клиенте
		
	ВариантыРешения = Новый Массив;
	
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", "Убедитесь, что токен с сертификатом КЭП подключен к компьютеру.");
	ВариантыРешения.Добавить(ВариантРешения);	
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", 
		"Если работаете в 1С через удаленный рабочий стол (RDP), проверьте, что в настройках удаленного рабочего " + 
		"стола включено использование локальных портов и смарт-карт.");
	ВариантыРешения.Добавить(ВариантРешения);
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", 
		"Если сертификат скопирован на удаленный рабочий стол (терминальный сервер)," + 
		"то проверьте, что он установлен в локальном хранилище пользователя, под которым вы заходите.");
	ВариантыРешения.Добавить(ВариантРешения);
	
	ВариантРешения = Новый Структура;
	ФорматированнаяСтрока = Новый Массив;
	ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("Если ошибка сохранилась, то пройдите "));
	ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("диагностику",,,, "https://help.kontur.ru/diadoc"));
	ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("."));		
	ВариантРешения.Вставить("Наименование", ФорматированнаяСтрока);
	ВариантыРешения.Добавить(ВариантРешения);
	
	ВариантРешения = Новый Структура;
	ВариантРешения.Вставить("Наименование", 
		"Если после выполнения рекомендаций ошибка сохранилась, обратитесь в техподдержку и сообщите номер диагностики.");
	ВариантыРешения.Добавить(ВариантРешения);
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
		ПредставлениеТипаОшибки = "Не найден сертификат";
	Иначе
		ПредставлениеТипаОшибки = "Не найден сертификат на клиенте";
	КонецЕсли;
	
	СоставОшибки = Новый Структура;
