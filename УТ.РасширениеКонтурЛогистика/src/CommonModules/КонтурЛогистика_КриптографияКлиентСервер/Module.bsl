
#Область МенеджерКриптографии

Функция ИнициализироватьМенеджерКриптографии(ПарольКонтейнера = Неопределено, ТипМодуляКриптографии = Неопределено, ИспользоватьИнтерактивныйРежим = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипМодуляКриптографии) Тогда
		ТипМодуляКриптографии = 80;
	КонецЕсли;
	
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить("");
	ПараметрыКонструктора.Добавить("");
	ПараметрыКонструктора.Добавить(ТипМодуляКриптографии);
	
	Если ИспользоватьИнтерактивныйРежим
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ВерсияПриложенияНиже8_3_13() Тогда
		
		ПараметрыКонструктора.Добавить(Вычислить("ИспользованиеИнтерактивногоРежимаКриптографии.Использовать"));
	КонецЕсли;
	
	МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
	
	Если ЗначениеЗаполнено(ПарольКонтейнера) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольКонтейнера;
	КонецЕсли;
	
	Возврат МенеджерКриптографии;
	
КонецФункции 

#КонецОбласти

#Область Подписание

Функция ПодписатьДанные(ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера = Неопределено, ТипМодуляКриптографии, ИспользоватьИнтерактивныйРежим = Ложь, 
	ФайлОбмена = Неопределено, ВернутьОшибку = Ложь) Экспорт
	
	Попытка
	
		Результат = ПодписатьКонтент(ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера, ТипМодуляКриптографии, ИспользоватьИнтерактивныйРежим);
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		Если ИнформацияОбОшибке.Причина = Неопределено Тогда
			Описание = ИнформацияОбОшибке.Описание;
		Иначе
			Описание = ИнформацияОбОшибке.Причина.Описание;
		КонецЕсли;
		
		КодОшибки = КодОшибкиМенеджераКриптографии(Описание);
		
		Если ЗначениеЗаполнено(ФайлОбмена) Тогда
			КонтурЛогистика_КриптографияСервер.ДобавитьОшибкуКриптографииВСтатусТитула(
				ФайлОбмена, КодОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке), "Ошибка подписания менеджером криптографии 1С");			
		КонецЕсли;
		
		Если ВернутьОшибку Тогда
			Ошибка = Новый Структура;
			Ошибка.Вставить("КодОшибки", КодОшибки);
			Ошибка.Вставить("ОписаниеОшибки", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
			Возврат Ошибка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
			
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПодписатьКонтент(ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера, ТипМодуляКриптографии, ИспользоватьИнтерактивныйРежим)
	
	МенеджерКриптографии = ИнициализироватьМенеджерКриптографии(ПарольКонтейнера, ТипМодуляКриптографии, ИспользоватьИнтерактивныйРежим);
		
	Результат = ПодписатьКонтентЧерезМенеджерКриптографии(МенеджерКриптографии, ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера);
	
	Возврат Результат;
	
КонецФункции

Функция ПодписатьКонтентЧерезМенеджерКриптографии(МенеджерКриптографии, ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера)
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата(Истина);
	
	Сертификат				 = ПолучитьДанныеСертификата(МенеджерКриптографии, ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата);
	СертификатКриптографии	 = Новый СертификатКриптографии(Сертификат.ДвоичныеДанные);
	
	Результат = МенеджерКриптографии.Подписать(ДвоичныеДанные, СертификатКриптографии);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СписокСертификатов

Функция ПолучитьСписокЛокальныхСертификатов() Экспорт
	
	Попытка
		
		ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
		СвойстваСертификата	 = ВсеСвойстваСертификата();
		
		СписокСертификатов = ПолучитьСписокСертификатов(ПараметрыПоиска, СвойстваСертификата);
		
		Результат = ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов);
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("КриптографияКлиентСервер.ПолучитьСписокЛокальныхСертификатов",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокСертификатов(ПараметрыПоиска, СвойстваСертификата)
	
	МенеджерКриптографии	 = ИнициализироватьМенеджерКриптографии();
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(МенеджерКриптографии, ПараметрыПоиска);
	
	Если ПараметрыПоиска.Свойство("Отпечаток") Тогда
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ПараметрыПоиска.Отпечаток);
		Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатКриптографии, ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	Если ПараметрыПоиска.Свойство("СерийныйНомер") Тогда
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоСерийномуНомеру(Base64Значение(ПараметрыПоиска.СерийныйНомер));
		Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатКриптографии, ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	СертификатыКриптографии = ХранилищеСертификатовКриптографии.ПолучитьВсе();
	Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатыКриптографии, ПараметрыПоиска, СвойстваСертификата);
	
КонецФункции

Функция РазобратьОтвет_ПолучитьСписокСертификатов(Ответ, ПараметрыПоиска, СвойстваСертификата)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Ответ) Тогда
		
		Если ТипЗнч(Ответ) = Тип("Массив") Тогда
			
			Для Каждого СертификатКриптографии Из Ответ Цикл
				
				Результат.Добавить(Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата));
				
				Если СвойствоСтруктуры(ПараметрыПоиска, "ТолькоПервый") = Истина Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Результат.Добавить(Новый_ОписаниеСертификата(Ответ, СвойстваСертификата));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПолучениеСертификата

Функция ПолучитьСертификат(ОтпечатокСертификата, ТипМодуля) Экспорт
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата(Истина);
	
	МенеджерКриптографии	 = ИнициализироватьМенеджерКриптографии(, ТипМодуля);
	
	Результат = ПолучитьДанныеСертификата(МенеджерКриптографии, ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСертификата(МенеджерКриптографии, ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата) Экспорт
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(МенеджерКриптографии, ПараметрыПоиска);
	
	Если ТипЗнч(ОтпечатокСертификата) = Тип("ДвоичныеДанные") Тогда
		
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ОтпечатокСертификата);
		
	Иначе
		
		СертификатыКриптографии	 = ХранилищеСертификатовКриптографии.ПолучитьВсе();
		СертификатКриптографии	 = НайтиСертификатВМассивеПоОтпечатку(СертификатыКриптографии, ОтпечатокСертификата);
		
	КонецЕсли;
	
	Результат = Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДвоичныеДанныеСертификата(ОтпечатокСертификата, ТипМодуля = Неопределено) Экспорт
	
	ПараметрыПоиска	= ПараметрыПоискаСертификатов();
	
	МенеджерКриптографии = ИнициализироватьМенеджерКриптографии(, ТипМодуля);
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(МенеджерКриптографии, ПараметрыПоиска);
	
	СертификатыКриптографии	 = ХранилищеСертификатовКриптографии.ПолучитьВсе();
	СертификатКриптографии	 = НайтиСертификатВМассивеПоОтпечатку(СертификатыКриптографии, ОтпечатокСертификата);
		
	Результат = СертификатКриптографии.Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьХранилищеСертификатов(МенеджерКриптографии, ПараметрыПоиска)
	
	ТипХранилища			 = СвойствоСтруктуры(ПараметрыПоиска, "ТипХранилища");
	РасположениеХранилища	 = СвойствоСтруктуры(ПараметрыПоиска, "РасположениеХранилища");
	
	Возврат МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилища, РасположениеХранилища);
		
КонецФункции

#КонецОбласти

#Область Расшифровка

Функция РасшифроватьДанные(ЗашифрованныеДвоичныеДанные, ПарольКонтейнера = "", ТипМодуляКриптографии = Неопределено, ИспользоватьИнтерактивныйРежим = Ложь) Экспорт
		
	МенеджерКриптографии = ИнициализироватьМенеджерКриптографии(ПарольКонтейнера, ТипМодуляКриптографии, ИспользоватьИнтерактивныйРежим);
	
	Попытка
		Результат = МенеджерКриптографии.Расшифровать(ЗашифрованныеДвоичныеДанные);
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
	КонецПопытки;
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ВспомогательныеФункции

Функция ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого Серт Из СписокСертификатов Цикл
		
		Если Не ЭтоВалидныйСертификат(Серт) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеСертификата = Новый Структура("Наименование, Фамилия, Имя, Отчество, Должность, ДатаВыдачи, СрокДействия, ОтпечатокСертификата, 
											|Организация, Издатель, Контур, Инн, ИННЮЛ, ОГРНИП, Кпп, СНИЛС, ВДиадоке, Ошибка, ИздательИНН, ИздательОГРН");
		
		ОписаниеСертификата.ДатаВыдачи			 = Серт.ДатаНачала;
		ОписаниеСертификата.СрокДействия		 = Серт.ДатаОкончания;
		ОписаниеСертификата.ОтпечатокСертификата = Серт.Отпечаток;
		
		Если Серт.Субъект.Свойство("SN") И Серт.Субъект.Свойство("G") Тогда // в старых форматах сертификатов этих полей может не быть
			ОписаниеСертификата.Наименование = Серт.Субъект.SN + " " + Серт.Субъект.G;
		Иначе
			Если Серт.Субъект.Свойство("O") Тогда   // проверка юл
				Если Серт.Субъект.Свойство("OID2_5_4_4") И Серт.Субъект.Свойство("OID2_5_4_42") Тогда
					ОписаниеСертификата.Наименование = Серт.Субъект.OID2_5_4_4 + " " + Серт.Субъект.OID2_5_4_42;	
				КонецЕсли;
			Иначе
				ОписаниеСертификата.Наименование = Серт.Субъект.CN;
			КонецЕсли;
		КонецЕсли;
		
		Если Серт.Субъект.Свойство("Фамилия") Тогда
			ОписаниеСертификата.Фамилия = Серт.Субъект.Фамилия;
		ИначеЕсли Серт.Субъект.Свойство("SN") Тогда
			ОписаниеСертификата.Фамилия = Серт.Субъект.SN;	
		КонецЕсли;
		
		ИмяОтчествоМассив = Новый Массив;
		Если Серт.Субъект.Свойство("ИмяОтчество") Тогда
			ИмяОтчествоМассив = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(Серт.Субъект.ИмяОтчество, " ");
		ИначеЕсли Серт.Субъект.Свойство("G") Тогда
			ИмяОтчествоМассив = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(Серт.Субъект.G, " ");	
		КонецЕсли;
		
		Если Серт.Субъект.Свойство("T") Тогда
			ОписаниеСертификата.Должность = Серт.Субъект.T;
		ИначеЕсли Серт.Субъект.Свойство("OID2_5_4_12") Тогда
			ОписаниеСертификата.Должность = Серт.Субъект.OID2_5_4_12;	
		КонецЕсли;
		
		Если ИмяОтчествоМассив.Количество() = 1 Тогда 
			ОписаниеСертификата.Имя = ИмяОтчествоМассив[0];
		КонецЕсли;
		Если ИмяОтчествоМассив.Количество() > 1 Тогда
			ОписаниеСертификата.Имя = ИмяОтчествоМассив[0];
			ОписаниеСертификата.Отчество = ИмяОтчествоМассив[1];
			Для Счет = 2 По ИмяОтчествоМассив.Количество() -1 Цикл
				ОписаниеСертификата.Отчество = ОписаниеСертификата.Отчество + " " + ИмяОтчествоМассив[Счет];
			КонецЦикла;
		КонецЕсли;
		
		ОписаниеСертификата.Издатель	 = Серт.Издатель.CN;
		ОписаниеСертификата.Организация	 = ?(Серт.Субъект.Свойство("O"), Серт.Субъект.O, "");
		
		ОписаниеСертификата.ИздательИНН = ПолучитьИННИздателя(Серт);		
		ОписаниеСертификата.ИздательОГРН = ПолучитьОГРНИздателя(Серт);
						
		Если Серт.Субъект.Свойство("ИННЮЛ") Тогда
			ИННЮЛ = Серт.Субъект.ИННЮЛ;
		Иначе
			ИННЮЛ = "";
		КонецЕсли;
			
		Если Серт.Субъект.Свойство("ИНН") Тогда
			ИНН = Серт.Субъект.ИНН;
		Иначе
			ИНН = "";
		КонецЕсли;
		
		// обрезаем лидирующие нули
		Если Лев(ИНН, 2) = "00" Тогда 
			ИНН = Сред(ИНН, 3);
		КонецЕсли;
		
		ОписаниеСертификата.ИНН = ИНН;
		ОписаниеСертификата.ИННЮЛ = ИННЮЛ;
		
		Если Серт.Субъект.Свойство("ОГРНИП") Тогда
			ОписаниеСертификата.ОГРНИП = Серт.Субъект.ОГРНИП;
		КонецЕсли;
		
		// здесь КПП так просто не вытащить, он вроде присутствует в хитром поле:
		// _1_2_840_113549_1_9_2	"6699000000-669901001-012522310804"	Строка
		// _1_2_840_113549_1_9_2	"6699000000-669901001-005809723989"	Строка
		
		// еще один вариант - раскладывать в массив строк и брать вторую
		
		Если Серт.Субъект.Свойство("СНИЛС") Тогда
			СНИЛС = Серт.Субъект.СНИЛС;
		Иначе
			СНИЛС = "";
		КонецЕсли;
		ОписаниеСертификата.СНИЛС = СНИЛС;
		
		Для Каждого ЭлементСтруктуры Из Серт.Субъект Цикл
			
			Если Найти(ЭлементСтруктуры.Значение, "-0" + СНИЛС) > 0
				И СтрДлина(ЭлементСтруктуры.Значение) >= 10 + 1 + 9 + 1 + СтрДлина(СНИЛС) + 1 Тогда
				// 6699000000-669901001-005809723989
				// 10        1    9    1   СНИЛС+"0"
				КПП = ЭлементСтруктуры.Значение;
				
				КПП = Сред(КПП, 12);							// 6699000000-669901001-005809723989  -> 669901001-005809723989
				КПП = СтрЗаменить(КПП, "0" + СНИЛС, "");	// 669901001-005809723989  -> -005809723989
				КПП = СтрЗаменить(КПП, "-", "");				// -005809723989 -> 005809723989
				Если СтрДлина(КПП) = 9 Тогда
					ОписаниеСертификата.КПП = КПП;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ОписаниеСертификата.КПП) Тогда
				ЭлементыКПП = РазделитьСтроку(ЭлементСтруктуры.Значение, "-");
				Если ЭлементыКПП.Количество() > 1 Тогда
					ОписаниеСертификата.КПП = ЭлементыКПП[1];
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ОписаниеСертификата.Контур = Истина;
		
		Если ОписаниеСертификата.СрокДействия < НачалоДня(ТекущаяДата()) Тогда
			
			ОписаниеСертификата.Вставить("Ошибка"	, "Срок действия сертификата истек");
			ОписаниеСертификата.Вставить("ВДиадоке"	, Ложь);
			// кажется, что их лучше вообще не показывать
			
		Иначе
			
			ОписаниеСертификата.Вставить("ВДиадоке", Истина);
			
		КонецЕсли;
		
		Если ОписаниеСертификата.ВДиадоке Тогда
			Результат.Добавить(ОписаниеСертификата);  // добавляем только валидные сертификаты
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИННИздателя(Сертификат) Экспорт
	
	Если Сертификат.Издатель.Свойство("ИННЮЛ") Тогда
		Возврат Сертификат.Издатель.ИННЮЛ;
	ИначеЕсли Сертификат.Издатель.Свойство("ИНН") Тогда
		Возврат Сертификат.Издатель.ИНН;
	ИначеЕсли Сертификат.Издатель.Свойство("OID1_2_643_100_4") Тогда
		Возврат Сертификат.Издатель.OID1_2_643_100_4;
	ИначеЕсли Сертификат.Издатель.Свойство("OID1_2_643_3_131_1_1") Тогда
		Возврат Сертификат.Издатель.OID1_2_643_3_131_1_1;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОГРНИздателя(Сертификат) Экспорт
	
	Если Сертификат.Издатель.Свойство("ОГРН") Тогда
		Возврат Сертификат.Издатель.ОГРН;	
