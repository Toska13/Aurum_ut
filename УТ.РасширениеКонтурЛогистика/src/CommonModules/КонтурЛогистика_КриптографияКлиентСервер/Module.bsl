	СоставОшибки.Вставить("ВариантыРешения", ВариантыРешения);
	
	ТипыОшибок.Вставить("НеНайденСертификатНаКлиенте", СоставОшибки);
	
	// 3. Истекла лицензия на КриптоПро
		
	ВариантыРешения = Новый Массив;
	
	ВариантРешения = Новый Структура;
		
	ВариантРешения = Новый Структура;
