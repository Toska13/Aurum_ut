#Область ПрограммныйИнтерфейс

// Возвращает типы онбординга
//
// Возвращаемое значение:
//   Структура 
//		- Ключ - представление идентификатора онбординга
//		- Значение - идентификатор онбординга
//
Функция ТипыОнбординга() Экспорт
	
	ТипыОнбординга = Новый Структура;
	ТипыОнбординга.Вставить("ПервыйЗапускАдмин", 						"admin-first-launch");
	ТипыОнбординга.Вставить("ОткрытиеНастроекКонвертацииДокументов",   	"open-nkd");
	ТипыОнбординга.Вставить("ОткрытиеНастроекКонвертацииСправочников", 	"open-nks");
	ТипыОнбординга.Вставить("ОткрытиеНастроекПодписания", 			 	"open-signing-settings");
	ТипыОнбординга.Вставить("ПервыйЗапускЭТрНЗЗ", 					 	"etrnzz-first-launch");
	ТипыОнбординга.Вставить("ПервыйЗапускЭПЛ", 						 	"epl-signing-settings");
	ТипыОнбординга.Вставить("Неопределено",								"none-type");
	
	Возврат ТипыОнбординга;
	
КонецФункции // ТипыОнбординга

// Возвращает ссылку на справку
//
// Возвращаемое значение:
//   Строка - Навигационная ссылка - Ссылка на справку
// 
Функция СсылкаСправка() Экспорт
	Возврат "https://support.kontur.ru/logistika-1s";
КонецФункции // СсылкаСправка 

