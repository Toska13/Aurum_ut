#Область ПанельСтатусыПодписиСертификатаМЧД

Процедура КомандаСтатусПодписиСертификатаМЧД(Форма, Команда) Экспорт
	
	Если Команда = "ТекстСертификат" Тогда
		ОткрытьФормуСертификата(Форма);	
	ИначеЕсли Команда = "ТекстМЧД" Тогда
		ОткрытьФормуМЧД(Форма);	
	ИначеЕсли Команда = "ТекстМЧДОшибки" Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Действие", "ОшибкиМЧД");
		
		ПредставлениеОшибкиМЧД = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПредставлениеОшибокПроверкиМЧД(Форма.ДФИ_ОшибкиМЧД);
		
		ПоказатьПредупреждение(, ПредставлениеОшибкиМЧД);
				
	ИначеЕсли Команда = "ТекстДоверять" Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Действие", "Доверять");
		ДополнительныеПараметры.Вставить("Форма", Форма);
		
		Оповещение = Новый ОписаниеОповещения("ДоверятьЗавершение", КонтурЛогистика_РаботаСЭлементамиФормыКлиент, ДополнительныеПараметры);
		
		Если Форма.Элементы.Найти("ТекстМЧДОшибки") <> Неопределено
			И Найти(Форма.Элементы.ТекстМЧДОшибки.Заголовок, "Предупреждения -") > 0 Тогда
			ЭтоПредупреждение = Истина;
		Иначе
			ЭтоПредупреждение = Ложь;	
		КонецЕсли;			
			
		ПоказатьВопрос(Оповещение, КонтурЛогистика_РаботаСЭлементамиФормыСервер.ВопросДоверятьМЧД(ЭтоПредупреждение), РежимДиалогаВопрос.ДаНетОтмена);
		
	ИначеЕсли Команда = "ТекстРазрешитьПолномочия" Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МЧД", Форма.ДФИ_МЧД);
		ПараметрыФормы.Вставить("Полномочие", Форма.ДФИ_Полномочие);
		ПараметрыФормы.Вставить("ОтпечатокСертификата", Форма.ДФИ_ОтпечатокСертификата);
		ПараметрыФормы.Вставить("КомуВыданСертификат", Форма.ДФИ_КомуВыданСертификат);		
		ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Форма.Параметры.Ключ);
		ПараметрыФормы.Вставить("ТипТитула", ТипТитула);
		ПараметрыФормы.Вставить("ЗапуститьРегЗадание", Истина);
					
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"РегистрСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Форма.ФормаВыбораНастройкиПолномочий",
			Параметрыформы,
			Форма,
			Форма,
			"ОбработчикРазрешенияПолномочий",
			ПараметрыФормы);
		
	ИначеЕсли Команда = "ТекстСсылкаВДиадок" Тогда
		
		Если Форма.Параметры.Свойство("Ключ") Тогда
		
			ГиперссылкаНаДокумент = КонтурЛогистика_ОбработкаДокументовКлиент.СсылкаВБраузереДиадок(Форма.Параметры.Ключ);
			
			Если ЗначениеЗаполнено(ГиперссылкаНаДокумент) Тогда
				КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке(ГиперссылкаНаДокумент);
			Иначе
				КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не могу получить ссылку в web-интерфейсе, возможно документ еще не отправлен");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДоверятьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда		
		КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ДоверятьМЧД(ДополнительныеПараметры.Форма);		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуСертификата(Форма) Экспорт
	
	Если Не Форма.ДФИ_СертификатЭП.Пустая() Тогда
		
		ПараметрыФормы = Новый Структура("Ключ", Форма.ДФИ_СертификатЭП);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.Форма.ФормаЭлемента",
																		ПараметрыФормы);
																		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуМЧД(Форма) Экспорт
	
	Если Не Форма.ДФИ_МЧД.Пустая() Тогда
		
		ПараметрыФормы = Новый Структура("Ключ", Форма.ДФИ_МЧД);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_МЧД.Форма.ФормаЭлемента",
																		ПараметрыФормы);	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДоверятьМЧД(Форма) Экспорт 
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("ОтпечатокСертификата", Форма.ДФИ_ОтпечатокСертификата);
	ПараметрыФоновогоЗадания.Вставить("КомуВыданСертификат", Форма.ДФИ_КомуВыданСертификат);
	ПараметрыФоновогоЗадания.Вставить("МЧД", Форма.ДФИ_МЧД);
	ПараметрыФоновогоЗадания.Вставить("ОшибкиМЧД", Форма.ДФИ_ОшибкиМЧД);
			
	КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеВыполнениеСотслеживаниемВНовойФорме("КонтурЛогистика_ДлительныеОперацииСервер.ДоверятьМЧД",
		"Удаление ошибок МЧД",
		ПараметрыФоновогоЗадания,
		"Удаление ошибок МЧД",
		Ложь,
		Истина,
		РежимОткрытияОкнаФормы.Независимый);
			
	Форма.Элементы.ГруппаСертификатМЧД.ЦветФона = Новый Цвет();
	Форма.Элементы.КартинкаСертификат.Доступность = Истина;
	Форма.Элементы.КартинкаМЧД.Видимость = Ложь;
	Форма.Элементы.ТекстМЧД.Заголовок = "МЧД (доверяем)";
	Форма.Элементы.ТекстМЧДОшибки.Видимость = Ложь;
	Форма.Элементы.ТекстДоверять.Видимость = Ложь;
	
КонецПроцедуры

Процедура ОбработчикРазрешенияПолномочий(Форма, ДополнительныеПараметры) Экспорт
	
	Если КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПроверитьПолномочияМЧД(Форма.Параметры.Ключ,
			ДополнительныеПараметры.МЧД, 
			ДополнительныеПараметры.Полномочие,	
			ДополнительныеПараметры.ТипТитула, 
			ДополнительныеПараметры.ОтпечатокСертификата) Тогда
																								
		Форма.Элементы.ГруппаПредупреждениеПолномочияМЧД.Видимость = Ложь;	
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыДокументОснование

Процедура КомандаДокументОснование(Форма, Команда) Экспорт
	
	ДокСсылка = Форма.Параметры.Ключ;
	
	Если Команда = "КомандаДокументОснованиеЗаполнить" Тогда
					
		КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьДокументЛогистики(ДокСсылка, Истина);	
		
		ДокументОснование = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ДокСсылка, "ДокументОснование");
		
		УправлениеЭлементамиДокументОснование(Форма, ДокументОснование);
		
		Форма.Модифицированность = Истина;
		
		Оповестить("КонтурЛогистика_ОбновитьДокументЛогистики");
						
	ИначеЕсли Команда = "КомандаДокументОснованиеВыбратьВручную" Тогда

		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2_13() Тогда
			
			Форма.Элементы.ДокументОснование.Видимость = Истина;
			
			Если Форма.Элементы.Найти("ТекстДокументОснование") <> Неопределено Тогда
				Форма.Элементы.ТекстДокументОснование.Видимость = Ложь;
			КонецЕсли;
			Если Форма.Элементы.Найти("ТекстДокументОснованиеНеЗаполнен") <> Неопределено Тогда
				Форма.Элементы.ТекстДокументОснованиеНеЗаполнен.Видимость = Ложь;
			КонецЕсли;
			Если Форма.Элементы.Найти("КомандаДокументОснованиеВыбратьВручную") <> Неопределено Тогда
				Форма.Элементы.КомандаДокументОснованиеВыбратьВручную.Видимость = Ложь;
			КонецЕсли;
			
			Форма.ТолькоПросмотр = Ложь;
			
		Иначе
			
			СписокТипов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СписокТиповДокументаОснования(ДокСсылка);
			
			СписокЗначений = Новый СписокЗначений;
			
			Для каждого Тип Из СписокТипов Цикл
				СписокЗначений.Добавить(Тип);
			КонецЦикла;

			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Форма", Форма);
			
			Оповещение = Новый ОписаниеОповещения("ПоказатьВыборИзСпискаПосле", КонтурЛогистика_РаботаСЭлементамиФормыКлиент, ДополнительныеПараметры);

			СписокЗначений.ПоказатьВыборЭлемента(Оповещение);
						
		КонецЕсли;
		
	ИначеЕсли Команда = "КомандаДокументОснованиеНайти" Тогда
		
		Если Не ЗначениеЗаполнено(ДокСсылка) Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Команду можно выполнять только при записанном документе");
			
			Возврат;
			
		КонецЕсли;
		
		НайдДокументОснование = КонтурЛогистика_ОбщегоНазначенияСервер.НайтиДокументОснованиеИЗаписатьВТитул(ДокСсылка);
								
		УправлениеЭлементамиДокументОснование(Форма, НайдДокументОснование);
		
		Форма.Модифицированность = Истина;
		
		Оповестить("КонтурЛогистика_ОбновитьДокументЛогистики");
		
	ИначеЕсли Команда = "КомандаПоказатьПредупреждения" Тогда
										
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Текст", Форма.ДФИ_ОписаниеПредупрежденияОбработки);
			
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"ОбщаяФорма.КонтурЛогистика_ФормаТекстовогоСообщения",
			ПараметрыФормы);
			
	ИначеЕсли Команда = "КомандаИгнорировать" Тогда
										
		КонтурЛогистика_ОбработкаДокументовКлиент.УстановитьСтатус(ДокСсылка, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен"), , Истина);	
		
		Оповестить("КонтурЛогистика_ОбновитьДокументЛогистики");
		
	ИначеЕсли Команда = "ОткрытьНастройкуКонвертации" Тогда
		
		ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Форма.Параметры.Ключ);
		КонтурЛогистика_ОбработкаДокументовКлиент.ОткрытьНастройкуКонвертации(ТипТитула, Форма.Объект.ДокументОснование);
		
	ИначеЕсли Команда = "ПерезаполнитьТитул" Тогда
		
		ТекстВопроса = "Действие полностью перезаполнит документ по Основанию. Вы АБСОЛЮТНО уверены?";
		
		ПараметрыОбработчика = Новый Структура;
		ПараметрыОбработчика.Вставить("ДокументСсылка", ДокСсылка);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,
			"Подтвердите операцию",, КонтурЛогистика_РаботаСЭлементамиФормыКлиент,
			"ОбработчикСогласияПерезаполненияПоДокументуОснования", ПараметрыОбработчика);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработчикСогласияПерезаполненияПоДокументуОснования(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Оповестить("ПерезаполнитьТитул", ДополнительныеПараметры.ДокументСсылка);
	
КонецПроцедуры

Процедура ПоказатьВыборИзСпискаПосле(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		ИмяФормы = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьНаименованиеФормыВыбораПоТипу(ВыбранныйЭлемент.Значение);	
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяФормы, , , ДополнительныеПараметры.Форма, "ОбработатьВыборДокументаОснования");
		
	КонецЕсли;
		
КонецПроцедуры

Процедура УправлениеЭлементамиДокументОснование(Форма, ДокументОснование = Неопределено) Экспорт
	
	НужнаОбработка = Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением")
		Или Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки");
				
	Если Форма.Элементы.Найти("ТекстДокументОснование") <> Неопределено Тогда
		Форма.Элементы.ТекстДокументОснование.Видимость = Не ЗначениеЗаполнено(ДокументОснование);
		Форма.Элементы.ДокументОснование.Видимость = ЗначениеЗаполнено(ДокументОснование);
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ТекстДокументОснованиеНеЗаполнен") <> Неопределено Тогда
		Форма.Элементы.ТекстДокументОснованиеНеЗаполнен.Видимость = Не ЗначениеЗаполнено(ДокументОснование);
	КонецЕсли;
	
	Если Форма.Элементы.Найти("КомандаДокументОснованиеНайти") <> Неопределено Тогда
		Форма.Элементы.КомандаДокументОснованиеНайти.Видимость = Не ЗначениеЗаполнено(ДокументОснование);
	КонецЕсли;
	
	Если Форма.Элементы.Найти("КомандаДокументОснованиеЗаполнить") <> Неопределено Тогда
		
		Форма.Элементы.КомандаДокументОснованиеЗаполнить.Видимость = НужнаОбработка;
		Форма.Элементы.КомандаДокументОснованиеЗаполнить.Заголовок = ?(ЗначениеЗаполнено(ДокументОснование), "Перезаполнить", "Заполнить");
		
		Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ)
			И Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен")
			И Форма.ТекущийСтатусДокументооборота = КонтурЛогистика_ОбработкаДокументовСервер.НайтиСостояниеДОПоКоду("r-wait-storekeeper") Тогда 
			// если он не подписан, то требуется разрешить перезаполнение
			Форма.Элементы.ПерезаполнитьПоДокОснованию.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Форма.Элементы.Найти("КомандаДокументОснованиеВыбратьВручную") <> Неопределено Тогда	
		Форма.Элементы.КомандаДокументОснованиеВыбратьВручную.Видимость = Не ЗначениеЗаполнено(ДокументОснование);
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ГруппаПанельОбработкиДокументаОбратнымМаппингом") <> Неопределено Тогда
		Форма.Элементы.ГруппаПанельОбработкиДокументаОбратнымМаппингом.Видимость = Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением");
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ФормаОбщаяКомандаКонтурЛогистика_ПропуститьОбработкуВходящегоДокумента") <> Неопределено Тогда
		Форма.Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПропуститьОбработкуВходящегоДокумента.Видимость = Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки");
	КонецЕсли;
	
	Если Форма.Элементы.Найти("Управление") <> Неопределено Тогда
		Форма.Элементы.Управление.Доступность = Не НужнаОбработка;
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ПодменюУправление") <> Неопределено Тогда
		Форма.Элементы.ПодменюУправление.Видимость = Не НужнаОбработка;
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи") <> Неопределено Тогда
		Форма.Элементы.ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи.Доступность = Не НужнаОбработка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьВыборДокументаОснование(ВыбранноеЗначение, Объект, Форма) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Объект.ДокументОснование = ВыбранноеЗначение;
		
		УправлениеЭлементамиДокументОснование(Форма, ВыбранноеЗначение);
		
		Форма.Модифицированность = Истина;
		
		Форма.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОчисткеДокументаОснование(Форма, ДокументОснование) Экспорт
	
	ДокументОснование = Неопределено;
	УправлениеЭлементамиДокументОснование(Форма, ДокументОснование);
	
	Форма.Модифицированность = Истина;
			
КонецПроцедуры

Процедура ПерезаполнитьДокументыОснования(ДокументыОснования, ДокументОснование) Экспорт
	
	ДокументыОснования.Очистить();
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		НовСтрокаДокументовОснований = ДокументыОснования.Добавить();
		НовСтрокаДокументовОснований.ДокументОснование = ДокументОснование;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеНаОснованииЭлементаУчетнойСистемы

Процедура ВыборЭлементаУчетнойСистемыДляЗаполнения(Форма) Экспорт
	
	ТипСправочникаИлиДокументаУС = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		Форма.СписокНастроекКонвертации[0].Значение, "ТипСправочникаИлиДокументаУС");
	ЭтоИмяДокумента = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИмяДокумента(ТипСправочникаИлиДокументаУС);
	
	Если ЭтоИмяДокумента Тогда
		ИмяФормыОткрыти = "Документ." + ТипСправочникаИлиДокументаУС + ".ФормаВыбора";
	Иначе
		ИмяФормыОткрыти = "Справочник." + ТипСправочникаИлиДокументаУС + ".ФормаВыбора";
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыОткрыти,, Форма, КонтурЛогистика_РаботаСЭлементамиФормыКлиент,,
		ДополнительныеПараметры, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ВыбратьЭлементУчетнойСистемыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат)
		Или ТипЗнч(Результат) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников") Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	
	// Свяжем новый объект
	НоваяСтрока = Форма.Объект.СвязанныеОбъекты.Добавить();
	НоваяСтрока.СвязанныйОбъект = Результат;
	Форма.Записать();
	
	// Заполним
	РезультатСинхронизации = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_СинхронизироватьРеквизитыУчетнойИЛогистическойСущностей(
		Результат, Форма.Объект.Ссылка, Форма.СписокНастроекКонвертации[0].Значение,,, Истина);
	Форма.Прочитать();
	
	// Обновим наименование
	Если КонтурЛогистика_РаботаСЭлементамиФормыСервер.ЕстьНастройкаКонвертацииРеквизитаНименование(Форма.СписокНастроекКонвертации[0].Значение) Тогда
		Форма.Объект.Наименование = "";
		Форма.Записать();
	КонецЕсли;
	Форма.Прочитать();
	
	Если РезультатСинхронизации.Успешно Тогда
		Сообщить("Обновлен из связного объекта.");
	Иначе
		Сообщить("Не обновлен из связного объекта.");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеТекстовогоРеквизитаВОтдельномОкне

// Открывает форму для редактирвоания текстового реквизита в отдельном окне
//
// Параметры:
//  Текст  					- Строка 				- Значение реквизита при открытии
//  Объект             		- ДанныеФормыСтруктура 	- Объект конфигурации формы
//  НаименованиеРеквизита 	- Строка    			- Наименование реквизита
//  ЭтоТЧ 					- Строка    			- Признак, что редактируемый реквизит находится в ТЧ
//  ЭлементТЧ 				- ТаблицаФормы    		- Элемент формы ТЧ. Например: Элементы.ПроизвольныеВалидации
//  ВыполнениеКода 			- Структура или Строка  - Строка с перечислением переменных с раздилителем "," ("Прем1, перем2, Перем3"). 
//													  Структура с обязательным свойством "Переменные" (Строка с перечислением переменных с раздилителем ",")
//													  Дополнительные признаки для сложного выполнения кода
Процедура ОткрытьФормуРедактированияТекста(Текст, Объект = Неопределено, НаименованиеРеквизита, ЭтоТЧ = Ложь, ЭлементТЧ = Неопределено, ВыполнениеКода = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	массПеременные = Новый Массив;
	
	ПараметрыФормы = Новый Структура;
	
	Если ЗначениеЗаполнено(ВыполнениеКода) Тогда
		
		Если ТипЗнч(ВыполнениеКода) = Тип("Структура") Тогда
			
			Если ВыполнениеКода.Свойство("Переменные") Тогда
				массПеременные = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ВыполнениеКода.Переменные, ",");	
			КонецЕсли;
			
			Если ВыполнениеКода.Свойство("ДоступныРеквизитыТ1ЭТРН") Тогда
				ПараметрыФормы.Вставить("ДоступныРеквизитыТ1ЭТРН", ВыполнениеКода.ДоступныРеквизитыТ1ЭТРН);
			КонецЕсли;
			Если ВыполнениеКода.Свойство("НомерСтрокиТоваровДокументовОснования") Тогда
				ПараметрыФормы.Вставить("НомерСтрокиТоваровДокументовОснования", ВыполнениеКода.НомерСтрокиТоваровДокументовОснования);
			КонецЕсли;
						
		ИначеЕсли ТипЗнч(ВыполнениеКода) = Тип("Строка") Тогда
			
			массПеременные = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ВыполнениеКода, ",");
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыФормы.Вставить("РежимЗаполнения", Истина);
	ПараметрыФормы.Вставить("Текст", Текст);
	ПараметрыФормы.Вставить("Переменные", массПеременные);
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("Объект", Объект);
	ПараметрыОбработчика.Вставить("НаименованиеРеквизита", НаименованиеРеквизита);
	ПараметрыОбработчика.Вставить("ЭтоТЧ", ЭтоТЧ);
	ПараметрыОбработчика.Вставить("ЭлементТЧ", ЭлементТЧ);	
	
	СистемнаяИнформация = Новый("СистемнаяИнформация");
	массВерсия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СистемнаяИнформация.ВерсияПриложения, ".");
	массВерсия.Удалить(массВерсия.Количество() - 1);
	
	ВерсияПриложения3 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(массВерсия, ".");
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПриложения3, "8.3.14") >= 0 
		И КонтурЛогистика_КриптографияКлиентПовтИсп.ТипПлатформыWindows() Тогда		
		ИмяФормы = "Обработка.КонтурЛогистика_КонсольКода1С.Форма.Форма";		
	Иначе
		ИмяФормы = "ОбщаяФорма.КонтурЛогистика_ФормаРедактированияТекста";
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяФормы, 
			ПараметрыФормы, 
			, 
			КонтурЛогистика_РаботаСЭлементамиФормыКлиент, 
			"ЗаврешениеРедактированияТекста", 
			ПараметрыОбработчика);
	
КонецПроцедуры

Процедура ЗаврешениеРедактированияТекста(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		Если ДополнительныеПараметры.ЭтоТЧ Тогда
			
			ТекДанные = ДополнительныеПараметры.ЭлементТЧ.ТекущиеДанные;
			
			Если ТекДанные <> Неопределено Тогда
				ТекДанные[ДополнительныеПараметры.НаименованиеРеквизита] = ВыбранноеЗначение;
			КонецЕсли;
				
		Иначе
			ДополнительныеПараметры.Объект[ДополнительныеПараметры.НаименованиеРеквизита] = ВыбранноеЗначение;
		КонецЕсли;
			
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область НетиповыеСправочникиВСвязанныхОбъектах

Процедура ОткрытьСвязанныйОбъект(Форма, СтандартнаяОбработка) Экспорт
	
	ТекущиеДанные = Форма.Элементы.СвязанныеОбъекты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТипЗнч(ТекущиеДанные.СвязанныйОбъект))
		И ЗначениеЗаполнено(ТекущиеДанные.УИД)
		И ЗначениеЗаполнено(ТекущиеДанные.ТипЗначенияУИД) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НайдСсылка = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСсылкуПоУИД(ТекущиеДанные.УИД, ТекущиеДанные.ТипЗначенияУИД);
		
		Если ЗначениеЗаполнено(НайдСсылка) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(НайдСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьСписокТиповДляСвязанногоОбъекта(Форма) Экспорт
	
	НетиповыеСправочники = КонтурЛогистика_ОбщегоНазначенияСервер.СписокТиповДляСвязанногоОбъекта(Форма.Объект.Ссылка);
	
	Если НетиповыеСправочники.Количество() > 0 Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораТипаСвязанногоОбъекта",
			КонтурЛогистика_РаботаСЭлементамиФормыКлиент, ДополнительныеПараметры);
		НетиповыеСправочники.ПоказатьВыборЭлемента (ОписаниеОповещения, "Выбор типа данных");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыбораТипаСвязанногоОбъекта(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметрыПослеВыбораЗначения = Новый Структура;
	ДополнительныеПараметрыПослеВыбораЗначения.Вставить("ЭтоНетиповойСправочник", ВыбранныйЭлемент.Пометка);
	ДополнительныеПараметрыПослеВыбораЗначения.Вставить("Форма", ДополнительныеПараметры.Форма);
	
	Если ВыбранныйЭлемент.Значение = "Строка"
		Или ВыбранныйЭлемент.Значение = "Число"
		Или ВыбранныйЭлемент.Значение = "Дата" Тогда
		
		ТекущиеДанные = ДополнительныеПараметры.Форма.Элементы.СвязанныеОбъекты.ТекущиеДанные;
	
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные.СвязанныйОбъект = "";
		ТекущиеДанные.УИД = "";
		ТекущиеДанные.ТипЗначенияУИД = "";
		
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
			Попытка
				ОткрытьФорму("Справочник." + ВыбранныйЭлемент.Значение + ".ФормаВыбора", ПараметрыФормы,
					ДополнительныеПараметры.Форма.Элементы.СвязанныеОбъекты);
			Исключение
				ОткрытьФорму("Документ." + ВыбранныйЭлемент.Значение + ".ФормаВыбора", ПараметрыФормы,
					ДополнительныеПараметры.Форма.Элементы.СвязанныеОбъекты);
			КонецПопытки;
		Иначе
			Попытка
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы(
					"Справочник." + ВыбранныйЭлемент.Значение + ".ФормаВыбора", ПараметрыФормы,,
					КонтурЛогистика_РаботаСЭлементамиФормыКлиент, "ПослеВыбораЗначенияСвязанногоОбъекта",
					ДополнительныеПараметрыПослеВыбораЗначения);
			Исключение
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы(
					"Документ." + ВыбранныйЭлемент.Значение + ".ФормаВыбора", ПараметрыФормы,,
					КонтурЛогистика_РаботаСЭлементамиФормыКлиент, "ПослеВыбораЗначенияСвязанногоОбъекта",
					ДополнительныеПараметрыПослеВыбораЗначения);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыбораЗначенияСвязанногоОбъекта(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ДополнительныеПараметры.Форма.Элементы.СвязанныеОбъекты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.СвязанныйОбъект = ВыбранноеЗначение;
	
	Если ДополнительныеПараметры.Свойство("ЭтоНетиповойСправочник") И ДополнительныеПараметры.ЭтоНетиповойСправочник Тогда
		
		Данные = КонтурЛогистика_РаботаСЭлементамиФормыСервер.ДанныеДляДобавленияСвязанногоОбъекта(ВыбранноеЗначение);
		
		ТекущиеДанные.УИД = Данные.УИД;
		ТекущиеДанные.ТипЗначенияУИД = Данные.ТипЗначенияУИД;
		
	Иначе
		
		ТекущиеДанные.УИД = "";
		ТекущиеДанные.ТипЗначенияУИД = "";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаВыбораСвязанногоОбъекта(Форма, СвязанныйОбъект) Экспорт
	
	ТекущиеДанные = Форма.Элементы.СвязанныеОбъекты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.СвязанныйОбъект = СвязанныйОбъект;
	
	Если КонтурЛогистика_КонвертацияСервер.ЭтоНетиповаяСсылкаДляСвязанногоОбъекта(Форма.Объект.Ссылка, СвязанныйОбъект) Тогда
		
		Данные = КонтурЛогистика_РаботаСЭлементамиФормыСервер.ДанныеДляДобавленияСвязанногоОбъекта(СвязанныйОбъект);
		
		ТекущиеДанные.УИД = Данные.УИД;
		ТекущиеДанные.ТипЗначенияУИД = Данные.ТипЗначенияУИД;
		
	Иначе
		
		ТекущиеДанные.УИД = "";
		ТекущиеДанные.ТипЗначенияУИД = "";
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаголовокПоказатьДопПоля

Функция ИмяКомандыПоказатьДопПоля(Форма) Экспорт
	
	Если Форма.Элементы.Страницы.Видимость Тогда 
		Возврат "Скрыть доп. реквизиты";
	Иначе
		Возврат "Показать доп. реквизиты";
	КонецЕсли;
	
КонецФункции

Процедура ДополнитьЗаголовокПоказатьДопПоля(Форма) Экспорт
	
	Дополнения = Новый Массив;
	
	КолвоИнфПол = Форма.Объект.ИнфПол.Количество();
	Если КолвоИнфПол > 0 Тогда
		Дополнения.Добавить("инф поля - " + Строка(КолвоИнфПол) + " шт."); 
	КонецЕсли;
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		ОписаниеЕГАИС = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьЗаголовокДопПоляГосСистИзИнфПол(Форма.Объект.ИнфПол);
		Если ЗначениеЗаполнено(ОписаниеЕГАИС) Тогда
			Дополнения.Добавить(ОписаниеЕГАИС);	
		КонецЕсли;			
	КонецЕсли;
	 		
КонецПроцедуры

#КонецОбласти

Процедура РазрешитьРедактированиеРеквизитов(Форма) Экспорт
	
	Для каждого Стр Из Форма.ДФИ_ЭлементыДляРазрешенияРедактирования Цикл
		
		Если Форма.Элементы.Найти(Стр.Значение) <> Неопределено Тогда
			Форма.Элементы[Стр.Значение].ТолькоПросмотр = Не Форма.Элементы[Стр.Значение].ТолькоПросмотр;	
		КонецЕсли;
		
	КонецЦикла;	
	
	Форма.Элементы.РазрешитьРедактированиеРеквизитов.Пометка = Не Форма.Элементы.РазрешитьРедактированиеРеквизитов.Пометка;
	
	Если (Лев(Форма.ИмяФормы, 11) = "Справочники" Или Лев(Форма.ИмяФормы, 9) = "Документы")
		И ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
	
		Если Форма.ТолькоПросмотр И Форма.Элементы.РазрешитьРедактированиеРеквизитов.Пометка Тогда
			
			Форма.ТолькоПросмотр = Ложь;
							
			Для каждого Элемент Из Форма.Элементы Цикл			
				
				Если Форма.ДФИ_ЭлементыДляРазрешенияРедактирования.НайтиПоЗначению(Элемент.Имя) <> Неопределено
					Или ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
					Продолжить;
				КонецЕсли;
				
				Попытка
					Элемент.ТолькоПросмотр = Истина;
				Исключение
					
				КонецПопытки;
				
			КонецЦикла;
					
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

