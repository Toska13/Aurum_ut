#Область ПрограммныйИнтерфейс

// Отправляет сообщения в телеграм
//
// Параметры:
//  Телефон			 - Строка	 - номер телефона.
//  Сообщения		 - Массив	 - массив из сообщений. См. МанифестСообщения().
//  ПараметрыСервиса - Структура - см. ПараметрыСервиса().
// 
// Возвращаемое значение:
//  Структура - см. МанифестРезультатаОтправки().
//
Функция ОтправитьСообщения(Телефон, Сообщения, ПараметрыСервиса = Неопределено) Экспорт
	
	Если ПараметрыСервиса = Неопределено Тогда
		ПараметрыСервиса = ПараметрыСервиса();
	КонецЕсли;
	
	Результат = МанифестРезультатаОтправки();
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Метод = "POST";
	ПараметрыЗапроса.АдресМетода = "/api/?phone_number=" + Телефон;
	
	ПараметрыЗапроса.Заголовки.Вставить("ApiKey", ПараметрыСервиса.ApiKey);
	ПараметрыЗапроса.Заголовки.Вставить("Accept", "*/*");
	
	Если Не ЗначениеЗаполнено(ПараметрыСервиса.ApiKey) Тогда
		УстановитьОшибкуРезультата(Результат, "API Key не заполнен");
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ТекущееСообщение Из Сообщения Цикл
		
		Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		
		ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
		ПараметрыЗапроса.ТелоЗапроса = СформироватьТелоЗапросаИзСообщения(ТекущееСообщение, Разделитель);
		
		Попытка
			Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
		Исключение
			УстановитьОшибкуРезультата(Результат, ОписаниеОшибки());
			Возврат Результат;
		КонецПопытки;
		
		Результат.ЕстьОшибки = Не Ответ.КодОтветаДопустимый;
		Результат.ТелоОтвета = Ответ.ТелоОтвета;
		Результат.КодСостояния = Ответ.КодОтвета;
		
		Если Результат.ЕстьОшибки Тогда
			УстановитьОшибкуРезультата(Результат,
				"Код ответа: " + Строка(Результат.КодСостояния) + ". Тело ответа:" + Результат.ТелоОтвета);
			Возврат Результат;
		КонецЕсли;
		
		Попытка
			РезультатСтруктура = КонтурЛогистика_HTTPТранспортКлиентСервер.JSONПрочитать(Ответ.ТелоОтвета);
		Исключение
			УстановитьОшибкуРезультата(Результат, "Не удалось разобрать тело ответа. Ошибка: " + ОписаниеОшибки());
			Возврат Результат;
		КонецПопытки;
		
		Результат.ApiKeyВерный = РезультатСтруктура.Получить("apikey");
		Результат.СообщениеОтправлено = РезультатСтруктура.Получить("result");
		Результат.ТелефонЗарегестрирован = РезультатСтруктура.Получить("phone_number");
		
		Если Не Результат.ApiKeyВерный Тогда
			УстановитьОшибкуРезультата(Результат, "API Key не верный");
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает признак зарегестрированности номера телефона в Телеграм
//
// Параметры:
//  Телефон			 - Строка	 - номер телефона.
//  ПараметрыСервиса - Структура	 - см. ПараметрыСервиса().
// 
// Возвращаемое значение:
//  Булево - признак, что телефон зарегестрирован в Телеграм.
//
Функция ТелефонЗарегестрирован(Телефон, ПараметрыСервиса = Неопределено) Экспорт
	
	Сообщение = МанифестСообщения();
	
	Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сообщение);
	
	Результат = ОтправитьСообщения(Телефон, Сообщения, ПараметрыСервиса);
	
	Если Результат.ЕстьОшибки Тогда
		ВызватьИсключение Результат.ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат.ТелефонЗарегестрирован;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Параметры сервиса
// 
// Возвращаемое значение:
//  Структура - см. МанифестПараметрыСервиса().
//
Функция ПараметрыСервиса() Экспорт
	
	АдресСервера = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("АдресAPIТелеграм");
	ApiKey = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПарольAPIТелеграм");
	
	Результат = МанифестПараметрыСервиса(АдресСервера);
	
	Результат.Вставить("ApiKey", ApiKey);
	Результат.Вставить("НастройкиПрокси", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.НастройкиПрокси());
	
	Возврат Результат;
	
КонецФункции

// Манифест результата отправки
// 
// Возвращаемое значение:
//  Структура
//
Функция МанифестРезультатаОтправки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", Ложь);
	Результат.Вставить("ТелоОтвета");
	Результат.Вставить("КодСостояния");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("СообщениеОтправлено");
	Результат.Вставить("ApiKeyВерный");
	Результат.Вставить("ТелефонЗарегестрирован");
	
	Возврат Результат;
	
КонецФункции

// Манифест параметров сервиса
//
// Параметры:
//  АдресСервераЛогистика	 - Строка	 - адрес сервера работы с телеграм.
// 
// Возвращаемое значение:
//  Структура - параметры сервиса.
//
Функция МанифестПараметрыСервиса(АдресСервера) Экспорт
	
	URLСтруктура = КонтурЛогистика_HTTPТранспортКлиентСервер.СтруктураURI_(АдресСервера);
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", URLСтруктура.Схема);
	Результат.Вставить("АдресВебСервиса", URLСтруктура.Хост);
	Результат.Вставить("Порт", URLСтруктура.Порт);
	Результат.Вставить("ApiKey", Неопределено);
	Результат.Вставить("НастройкиПрокси", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОписаниеНастроекПрокси());
	
	Возврат Результат;
	
КонецФункции

// Манифест сообщения
// 
// Возвращаемое значение:
//  Структура из:
//   * Тип - Строка - возможны несколько вариантов:
//      ** text - произвольная строка;
//      ** animation - анимация (gif or H.264/MPEG-4 AVC);
//      ** photo - картинка (jpg, png, ...);
//      ** video - видео файл;
//      ** document - прикрепляемый документ (pdf, txt, ...).
//   * Заголовок - Строка - подпись в одном сообщении, для всех типов, кроме текста и документа.
//   * ИмяФайла - Строка - имя файла, если в данных не строка.
//   * Данные - ДвоичныеДанные - данные в двоичном виде.
//
Функция МанифестСообщения() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Тип");
	Результат.Вставить("Заголовок");
	Результат.Вставить("ИмяФайла");
	Результат.Вставить("Данные");
	
	Возврат Результат;
	
КонецФункции

// Ключ API
// 
// Возвращаемое значение:
//  Строка - ключ.
//
Функция КлючAPI() Экспорт
	
	Возврат "16a9996aebb663de4b9530f920de42ed";
	
КонецФункции

// Символ эмоджи. Surrogates in https://apps.timwhitlock.info/emoji/tables/unicode
//
// Параметры:
//  ИмяЭмоджи	 - Строка	 - имя.
// 
// Возвращаемое значение:
//  Строка - символ.
//
Функция СимволЭмоджи(ИмяЭмоджи) Экспорт
	
	Результат = "";
	
	Если ИмяЭмоджи = "BELL" Тогда
		Результат = СимволПоСуррогатнойПаре("0xD83D", "0xDD14");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьОшибкуРезультата(Результат, ТекстОшибки)
	
	Результат.ЕстьОшибки = Истина;
	Результат.ТекстОшибки = ТекстОшибки;
	
КонецПроцедуры

Функция СформироватьТелоЗапросаИзСообщения(Сообщение, Разделитель)
	
	ЧастиТелаЗапроса = Новый Массив;
	РазделительСтрок = Символы.ВК + Символы.ПС;
	КодировкаТекстаСборки = "utf-8";
	
	// Добавляем разделитель
	ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
		"--" + Разделитель + РазделительСтрок, КодировкаТекстаСборки));
	
	// Добавляем осноное поле
	ПолеСообщения = СоздатьПолеФормы(Сообщение);
	ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
		ЗаголовкиВСтроку(ПолеСообщения.Заголовки), КодировкаТекстаСборки));
	
	Если ЗначениеЗаполнено(ПолеСообщения.Данные) Тогда
		ЧастиТелаЗапроса.Добавить(ПолеСообщения.Данные);
	КонецЕсли;
	
	// Добавляем разделитель строку
	ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
		РазделительСтрок, КодировкаТекстаСборки));
	
	Если ЗначениеЗаполнено(Сообщение.Заголовок)
		И (Сообщение.Тип = "video" Или Сообщение.Тип = "animation" Или Сообщение.Тип = "photo" Или Сообщение.Тип = "document") Тогда
		
		// Добавляем разделитель
		ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
			"--" + Разделитель + РазделительСтрок, КодировкаТекстаСборки));
		
		// Добавляем заголовок сообщения
		ПолеСообщения = СоздатьПолеЗаголовкаФормы(Сообщение);
		ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
			ЗаголовкиВСтроку(ПолеСообщения.Заголовки), КодировкаТекстаСборки));
		
		Если ЗначениеЗаполнено(ПолеСообщения.Данные) Тогда
			ЧастиТелаЗапроса.Добавить(ПолеСообщения.Данные);
		КонецЕсли;
			
		// Добавляем разделитель строку
		ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
			РазделительСтрок, КодировкаТекстаСборки));
	КонецЕсли;
	
	// Добавляем конечный разделитель
	ЧастиТелаЗапроса.Добавить(КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(
		"--" + Разделитель + "--" + РазделительСтрок, КодировкаТекстаСборки));
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.СоединитьДвоичныеДанные_КонтурЛогистика(ЧастиТелаЗапроса);
	
КонецФункции

Функция СоздатьПолеФормы(Сообщение)
	
	Поле = Новый Структура("Имя, ИмяФайла, Данные, Тип, Заголовки");
	Поле.Тип = "multipart/form-data";
	Поле.Имя = Сообщение.Тип;
	Поле.Данные = Сообщение.Данные;
	Поле.ИмяФайла = Сообщение.ИмяФайла;
	
	ЧастиОписанияКонтента = Новый Массив;
	ЧастиОписанияКонтента.Добавить("form-data");
	ЧастиОписанияКонтента.Добавить(СтрЗаменить("name=""%1""", "%1", Поле.Имя));
	Если ЗначениеЗаполнено(Поле.ИмяФайла) Тогда
		ЧастиОписанияКонтента.Добавить(СтрЗаменить("filename=""%1""", "%1", Поле.ИмяФайла));
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Disposition", КонтурЛогистика_ОбщегоНазначенияСервер.СоединитьСтрокиВXML(
		ЧастиОписанияКонтента, "; "));
	Заголовки.Вставить("Content-Type", Поле.Тип);
	
	Поле.Заголовки = Заголовки;
	
	Возврат Поле;
	
КонецФункции

Функция СоздатьПолеЗаголовкаФормы(Сообщение)
	
	Поле = Новый Структура("Имя, ИмяФайла, Данные, Тип, Заголовки");
	Поле.Тип = "multipart/form-data";
	Поле.Имя = Сообщение.Тип + "_caption";
	Поле.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(Сообщение.Заголовок);
	
	ЧастиОписанияКонтента = Новый Массив;
	ЧастиОписанияКонтента.Добавить("form-data");
	ЧастиОписанияКонтента.Добавить(СтрЗаменить("name=""%1""", "%1", Поле.Имя));
	ЧастиОписанияКонтента.Добавить(СтрЗаменить("name=""%1""", "%1", Поле.Имя));
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Disposition", КонтурЛогистика_ОбщегоНазначенияСервер.СоединитьСтрокиВXML(
		ЧастиОписанияКонтента, "; "));
	Заголовки.Вставить("Content-Type", Поле.Тип);
	
	Поле.Заголовки = Заголовки;
	
	Возврат Поле;
	
КонецФункции

Функция ЗаголовкиВСтроку(Заголовки)
	
	РазделительСтрок = Символы.ВК + Символы.ПС;
	Строки = Новый Массив;
	
	СортированныеЗаголовки = "Content-Disposition,Content-Type,Content-Location";
	Для Каждого Ключ Из КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(СортированныеЗаголовки, ",") Цикл
		Значение = КонтурЛогистика_HTTPТранспортКлиентСервер.ПолучитьЗначениеЗаголовка(Ключ, Заголовки);
		Если Значение <> Ложь И ЗначениеЗаполнено(Значение) Тогда
			Строки.Добавить(Ключ + ": " + Значение);
		КонецЕсли;
	КонецЦикла;
	
	Ключи = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ВРег(СортированныеЗаголовки), ",");
	Для Каждого Заголовок_ Из Заголовки Цикл
		Если Ключи.Найти(ВРег(Заголовок_.Ключ)) = Неопределено Тогда
			Строки.Добавить(Заголовок_.Ключ + ": " + Заголовок_.Значение);
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить(РазделительСтрок);
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.СоединитьСтрокиВXML(Строки, РазделительСтрок);
	
КонецФункции

Функция СимволПоСуррогатнойПаре(ВерхняяЧасть, НижняяЧасть)
	
	Попытка
		Возврат Символ(ЧислоИзШестнадцатеричнойСтроки(ВерхняяЧасть)) + Символ(ЧислоИзШестнадцатеричнойСтроки(НижняяЧасть));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти