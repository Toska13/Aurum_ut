// #КонецОбласти

// #Область АрхивДокументоооборота

Процедура СохранитьАрхивДокументооборота(ПараметрыФоновогоЗадания) Экспорт
	
	ОтборФайлов = ПараметрыФоновогоЗадания.ОтборФайлов;
	
	НоваяДатаГраницы = Неопределено;
	
	Если ОтборФайлов.Свойство("ФайлыОбмена") Тогда
		ФайлыОбмена = ОтборФайлов.ФайлыОбмена;
	Иначе
		ФайлыОбмена = Новый Массив;
	КонецЕсли;
	
	ДатаГраницы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ДатаГраницыСохраненияАрхиваДокументооборота");
	КаталогСохраненияАрхива = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("КаталогСохраненияАрхиваДокументооборота");
	РазбитьПоОрганизациям = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазбитьПоОрганизациямАрхивДокументооборота");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаВремяФормирования", ДатаГраницы);
	Запрос.УстановитьПараметр("ФайлыОбмена", ФайлыОбмена);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент,
	|	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования КАК ДатаВремяФормирования
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	(КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования > &ДатаВремяФормирования
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.Ссылка В (&ФайлыОбмена))
	|	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент <> НЕОПРЕДЕЛЕНО
	|	И (КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен))
	|	И (КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВремяФормирования";
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КонтурЛогистика_ОбработкаДокументовСервер.СохранитьАрхивДокументооборотаВКаталог(
			КаталогСохраненияАрхива, ВыборкаДетальныеЗаписи.ГлавныйДокумент, РазбитьПоОрганизациям);
		
		НоваяДатаГраницы = ВыборкаДетальныеЗаписи.ДатаВремяФормирования;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НоваяДатаГраницы) Тогда
		КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьНастройку("ДатаГраницыСохраненияАрхиваДокументооборота", НоваяДатаГраницы);
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьАрхивДокументооборотаЗаПериод(ПараметрыФоновогоЗадания) Экспорт
	
	МассивАрхивов = Новый Массив;
	
	Организация = Неопределено;
	ПараметрыФоновогоЗадания.Свойство("Организация", Организация);
	
	// ЭТРН
	МассивЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.МассивЗавершенныхЭТРНЗаПериод(
		ПараметрыФоновогоЗадания.ДатаНачала, КонецДня(ПараметрыФоновогоЗадания.ДатаОкончания), Организация);
	
	Для каждого Документ Из МассивЭТРН Цикл
		
		Попытка
			
			Архив = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьАрхивДокументооборотаТрН_ApiЛогистика(Документ);
			
			Если ЗначениеЗаполнено(Архив) Тогда
				МассивАрхивов.Добавить(Новый Структура("Архив, ТекущийДокумент", Архив, Документ));
			КонецЕсли;
			
		Исключение
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при сохранение архива документаоборота ЭТРН в каталог.
				|Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,
				Документ, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	// ЭПЛ
	МассивЭПЛ = КонтурЛогистика_ОбработкаДокументовСервер.МассивЗавершенныхЭПЛЗаПериод(
		ПараметрыФоновогоЗадания.ДатаНачала, КонецДня(ПараметрыФоновогоЗадания.ДатаОкончания), Организация);
	
	Для каждого Документ Из МассивЭПЛ Цикл
		
		Попытка
			
			Архив = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьАрхивДокументооборотаПЛ_ApiЛогистика(Документ);
			
			Если ЗначениеЗаполнено(Архив) Тогда
				МассивАрхивов.Добавить(Новый Структура("Архив, ТекущийДокумент", Архив, Документ));
			КонецЕсли;
			
		Исключение
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при сохранение архива документаоборота ЭПЛ в каталог.
				|Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,
				Документ, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(МассивАрхивов, ПараметрыФоновогоЗадания.Адрес);
	
КонецПроцедуры

