Функция ПолучитьПечатнуюФормуApiЛогистика(ДокументСсылка) Экспорт
	
	ПрикреплятьФайл = Ложь;
	ТихийРежим = Ложь;
	ОтпорПоДатеФайлаОбмена = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТитулДатаНачала", Неопределено);
	Запрос.УстановитьПараметр("ТитулДатаОкончания", Неопределено);
	Запрос.УстановитьПараметр("ОтборПоДатеТитула", Ложь);
	Запрос.УстановитьПараметр("ФайлОбменаДатаНачала", Неопределено);
	Запрос.УстановитьПараметр("ОтпорПоДатеФайлаОбмена", ОтпорПоДатеФайлаОбмена);
	Запрос.УстановитьПараметр("ФайлыОбмена", Новый Массив);
	Запрос.УстановитьПараметр("ДокументыТитулы", ДокументСсылка);
	Запрос.УстановитьПараметр("ВсеНашиОрганизации", Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации());
	Запрос.УстановитьПараметр("ПрикреплятьФайл", ПрикреплятьФайл);
	
	Запрос.Текст = ТекстЗапросаДанныхДляПолученияПечатныхФорм();
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаЭТРН = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЭПЛ = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаЭТРН.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭТРН, Истина, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл);
	ИначеЕсли ВыборкаЭПЛ.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭПЛ, Ложь, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл);
	Иначе
		ПечатнаяФорма = Неопределено;
	КонецЕсли;
	
	Возврат ПечатнаяФорма;
	
КонецФункции


Процедура ДобавитьПечатныеФормыЭПДВПрисоединенныеФайлы(ПараметрыФоновогоЗадания) Экспорт
	
	Перем ТитулДатаНачала, ТитулДатаОкончания, ФайлОбменаДатаНачала;
	
	ОтборФайлов = ПараметрыФоновогоЗадания.ОтборФайлов;
	Если ПараметрыФоновогоЗадания.Свойство("ТихийРежим") Тогда
		ТихийРежим = ПараметрыФоновогоЗадания.ТихийРежим;
	Иначе
		ТихийРежим = Ложь;
	КонецЕсли;
	
	ПрикреплятьФайл = Истина;
	ОтборПоДатеТитула = Ложь;
	ОтпорПоДатеФайлаОбмена = Ложь;
	
	Если ОтборФайлов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ТитулДатаНачала") И ОтборФайлов.Свойство("ТитулДатаОкончания") Тогда
		ТитулДатаНачала = ОтборФайлов.ТитулДатаНачала;
		ТитулДатаОкончания = КонецДня(ОтборФайлов.ТитулДатаОкончания);
		ОтборПоДатеТитула = (ЗначениеЗаполнено(ТитулДатаНачала) И ЗначениеЗаполнено(ТитулДатаОкончания));
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ФайлОбменаДатаНачала") Тогда
		ФайлОбменаДатаНачала = ОтборФайлов.ФайлОбменаДатаНачала;
		ОтпорПоДатеФайлаОбмена = ЗначениеЗаполнено(ФайлОбменаДатаНачала);
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ФайлыОбмена") Тогда
		ФайлыОбмена = ОтборФайлов.ФайлыОбмена;
	Иначе
		ФайлыОбмена = Новый Массив;
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ДокументыТитулы") Тогда
		ДокументыТитулы = ОтборФайлов.ДокументыТитулы;
	Иначе
		ДокументыТитулы = Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТитулДатаНачала", ТитулДатаНачала);
	Запрос.УстановитьПараметр("ТитулДатаОкончания", ТитулДатаОкончания);
	Запрос.УстановитьПараметр("ОтборПоДатеТитула", ОтборПоДатеТитула);
	Запрос.УстановитьПараметр("ФайлОбменаДатаНачала", ФайлОбменаДатаНачала);
	Запрос.УстановитьПараметр("ОтпорПоДатеФайлаОбмена", ОтпорПоДатеФайлаОбмена);
	Запрос.УстановитьПараметр("ФайлыОбмена", ФайлыОбмена);
	Запрос.УстановитьПараметр("ДокументыТитулы", ДокументыТитулы);
	Запрос.УстановитьПараметр("ВсеНашиОрганизации", Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации());
	Запрос.УстановитьПараметр("ПрикреплятьФайл", ПрикреплятьФайл);
	
	Запрос.Текст = ТекстЗапросаДанныхДляПолученияПечатныхФорм();
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаЭТРН = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЭПЛ = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЭТРН.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭТРН, Истина, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл);
	КонецЦикла;
	
	Пока ВыборкаЭПЛ.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭПЛ, Ложь, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаГлавныйДокумент, ЭтоЭТрН, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл)
	
	Если ЗначениеЗаполнено(ВыборкаГлавныйДокумент.Организация) Тогда
		Организация = ВыборкаГлавныйДокумент.Организация;
	Иначе
		
		// Попробуем получить из доп. получателей
		Если ЭтоЭТрН Тогда
			НашиДополнительныеПолучатели = КонтурЛогистика_ОбработкаДокументовСервер.НашиДополнительныеПолучателиФайлаТрН(
				ВыборкаГлавныйДокумент.ГлавныйДокумент);
		Иначе
			НашиДополнительныеПолучатели = КонтурЛогистика_ОбработкаДокументовСервер.НашиДополнительныеПолучателиФайлаПЛ(
				ВыборкаГлавныйДокумент.ГлавныйДокумент);
		КонецЕсли;
		
		Если НашиДополнительныеПолучатели.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Организация = НашиДополнительныеПолучатели[0];
	КонецЕсли;
	
	// Получим параметры сервиса
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ВыборкаГлавныйДокумент.Организация);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		// Получим печатную форму из сервиса
		Если ЭтоЭТрН Тогда
			ПечатнаяФорма = КонтурЛогистика_API_Логистика.ПолучитьПечатнуюФормуТранспортнойНакладной(
				ПараметрыСервиса, ВыборкаГлавныйДокумент.kl_id);
		Иначе
			ПечатнаяФорма = КонтурЛогистика_API_Логистика.ПолучитьПечатнуюФормуПутевогоЛиста(
				ПараметрыСервиса, ВыборкаГлавныйДокумент.kl_id, ВыборкаГлавныйДокумент.ТипПечатнойФормыПутыхЛистов);
		КонецЕсли;
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ПолучитьИПрисоединитьПечатнуюФорму",
			ИнформацияОбОшибке(), ВыборкаГлавныйДокумент.ГлавныйДокумент);
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ПечатнаяФорма) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ПрикреплятьФайл Тогда
		Возврат ПечатнаяФорма;
	КонецЕсли;
	
	// Прикрепим полученнй документ в связанным объектам
	ВыборкаДокументыОснования = ВыборкаГлавныйДокумент.Выбрать();
	Пока ВыборкаДокументыОснования.Следующий() Цикл
		
		Попытка
			
			Если ЭтоЭТрН Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭТРНДляПрисоединенныхФайлов();
			Иначе
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭПЛДляПрисоединенныхФайлов();
			КонецЕсли;
			
			Результат = КонтурЛогистика_ИнтеграцияТиповыеСервер.ПрикрепитьФайлКДокументуОснования(
				ПечатнаяФорма, ВыборкаДокументыОснования.ДокументОснование, ИмяПечатнойФормы);
				
			Если Не ТихийРежим Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Печатная форма ЭПД прикреплена к " + Строка(ВыборкаДокументыОснования.ДокументОснование);
				Сообщение.Сообщить();
			КонецЕсли;
			
			Если ОтпорПоДатеФайлаОбмена И Результат Тогда
				КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьНастройку(
					"ДатаГраницыПолученияПечатныхФормЭПД", ВыборкаГлавныйДокумент.ДатаВремяФормирования);
			КонецЕсли;
			
		Исключение
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при сохранение печатной формы в присоединенные файлы. Ошибка: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,
				ВыборкаДокументыОснования.ДокументОснование, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ПечатнаяФорма;
	
КонецФункции

Функция ТекстЗапросаДанныхДляПолученияПечатныхФорм()
	
	Возврат
	"ВЫБРАТЬ
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК ГлавныйДокумент
	|ПОМЕСТИТЬ ГлавныеДокументыПоОтбору
	|ИЗ
	|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
	|ГДЕ
	|	&ОтборПоДатеТитула
	|	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
	|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН МЕЖДУ &ТитулДатаНачала И &ТитулДатаОкончания
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул1.Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	|ГДЕ
	|	&ОтборПоДатеТитула
	|	И НЕ КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_ПЛ_Титул1.ДатаПЛ = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|				ТОГДА КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &ТитулДатаНачала И &ТитулДатаОкончания
	|			ИНАЧЕ КонтурЛогистика_ПЛ_Титул1.ДатаПЛ МЕЖДУ &ТитулДатаНачала И &ТитулДатаОкончания
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК ФайлОбмена,
	|	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент
	|ПОМЕСТИТЬ ФайлыОбменаКОбработке
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	(КонтурЛогистика_ФайлыОбмена.Ссылка В (&ФайлыОбмена)
	|				И (КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2)
	|					ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4)
	|					ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6)
	|					ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7)
	|					ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8)
	|					ИЛИ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4))
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент В (&ДокументыТитулы)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент В (&ДокументыТитулы)
	|			ИЛИ &ОтпорПоДатеФайлаОбмена
	|				И КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования > &ФайлОбменаДатаНачала
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент В
	|				(ВЫБРАТЬ
	|					ГлавныеДокументыПоОтбору.ГлавныйДокумент
	|				ИЗ
	|					ГлавныеДокументыПоОтбору))
	|	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент <> НЕОПРЕДЕЛЕНО
	|	И (КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.ДокументОснование КАК ДокументОснование,
	|	ФайлыОбменаКОбработке.ФайлОбмена КАК ФайлОбмена,
	|	ФайлыОбменаКОбработке.ГлавныйДокумент КАК ГлавныйДокумент
	|ПОМЕСТИТЬ ФайлыОбменаИДокументыОснования
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ФайлыОбменаКОбработке КАК ФайлыОбменаКОбработке
	|		ПО КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = ФайлыОбменаКОбработке.ГлавныйДокумент
	|ГДЕ
	|	НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	|	И (&ПрикреплятьФайл
	|				И КонтурЛогистика_ТрН_Титул1.ДокументОснование <> НЕОПРЕДЕЛЕНО
	|			ИЛИ НЕ &ПрикреплятьФайл)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул2.ДокументОснование,
	|	ФайлыОбменаКОбработке.ФайлОбмена,
	|	ФайлыОбменаКОбработке.ГлавныйДокумент
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ФайлыОбменаКОбработке КАК ФайлыОбменаКОбработке
	|		ПО КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = ФайлыОбменаКОбработке.ГлавныйДокумент
	|ГДЕ
	|	НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления
	|	И (&ПрикреплятьФайл
	|				И КонтурЛогистика_ТрН_Титул2.ДокументОснование <> НЕОПРЕДЕЛЕНО
	|			ИЛИ НЕ &ПрикреплятьФайл)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул3.ДокументОснование,
	|	ФайлыОбменаКОбработке.ФайлОбмена,
