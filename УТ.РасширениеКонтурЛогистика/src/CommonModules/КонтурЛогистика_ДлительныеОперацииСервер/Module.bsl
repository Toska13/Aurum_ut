Процедура СинхронизироватьКонтрагентовОрганизацииДиадок(ПараметрыФоновогоЗадания) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФоновогоЗадания();
	Результат.Успешно = Истина;
	
	Сч = 1;
	Для Каждого ОрганизацияДД Из ПараметрыФоновогоЗадания.МассивОрганизаций Цикл 
			
		Если Не ОрганизацияДД.Наш Тогда 
			Сообщить("" + ОрганизацияДД + " не отмечена как наша, контрагенты не загружены");
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			КолвоОрганизаций = ПараметрыФоновогоЗадания.МассивОрганизаций.Количество();
			
			ПараметрыФоновогоЗадания.Вставить("Результат", Результат);
			ПараметрыФоновогоЗадания.Вставить("КолвоОрганизаций", КолвоОрганизаций);
															
			Справочники.КонтурЛогистика_ОрганизацииДиадок.СинхронизироватьКонтрагентовОрганизации(ОрганизацияДД, ПараметрыФоновогоЗадания);
			
			Если КолвоОрганизаций > 1 Тогда 
				Текст = Строка(ОрганизацияДД);
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
				Результат.Прогресс = Окр(Сч / КолвоОрганизаций * 100);
				ПоместитьВоВременноеХранилище(ПараметрыФоновогоЗадания.Результат, ПараметрыФоновогоЗадания.АдресРезультата);
				Сч = Сч + 1;			
			КонецЕсли;
			
		Исключение
			
			Сообщить("Неудача при вычитывании данных из Диадок по Организации: " + ОрганизацияДД + " - " + ОписаниеОшибки());
			
		КонецПопытки;
						
	КонецЦикла;		
	
КонецПроцедуры