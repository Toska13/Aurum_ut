Процедура ВыполнитьПервичноеЗаполнениеСправочников(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	КонтурЛогистика_ОбщегоНазначенияСервер.Пауза(5);
	
	ИменаСправочников = Новый Массив;
	ИменаСправочников.Добавить("КонтурЛогистика_КлассификаторПолномочийМЧД");
	ИменаСправочников.Добавить("КонтурЛогистика_СтраныМира");
	ИменаСправочников.Добавить("КонтурЛогистика_КлассификаторУпаковок");
	ИменаСправочников.Добавить("КонтурЛогистика_СостоянияДвиженияДокументооборота");
	
	Для Каждого ТекущееИмяСправочника Из ИменаСправочников Цикл
		
		// Справочник заполнен
		Выборка = Справочники[ТекущееИмяСправочника].Выбрать();
		Если Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		
		// Заполним в транзакции
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			Справочники[ТекущееИмяСправочника].ЗаполнитьЗначениямиПоУмолчанию();
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Не удалось выполнить первичное заполнение справочника """ + ТекущееИмяСправочника + """. Текст ошибки:
				|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистика.ПервичноеЗаполнениеСправочника", ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

