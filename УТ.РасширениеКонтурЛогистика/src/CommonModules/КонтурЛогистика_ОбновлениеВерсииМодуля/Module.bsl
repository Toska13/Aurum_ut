// Сведения о версиях

Функция ТекущаяВерсияПодсистемыКонтурЛогистика() Экспорт
	
	Возврат "1.16.3";
	
КонецФункции

Функция ТекущаяВерсияДанныхПодсистемыКонтурЛогистика() Экспорт
	
	ТекВерсия = Справочники.Контурлогистика_Настройки.ЗначениеНастройки("ДанныеОбновленыДоВерсии");
	
	Возврат ?(Не ЗначениеЗаполнено(ТекВерсия), "0.0.0", ТекВерсия);
	
КонецФункции

Функция ТребуетсяВыполнитьПереходНаНовуюВерсию() Экспорт

	УстановленнаяВерсия = ТекущаяВерсияПодсистемыКонтурЛогистика();
	ВерсияДанных 		= ТекущаяВерсияДанныхПодсистемыКонтурЛогистика();
	
	Если ВерсияДанных = "0.0.0" Тогда // первый запуск подсистемы, обновление данных не требуется
		Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ДанныеОбновленыДоВерсии", УстановленнаяВерсия);
		Справочники.КонтурЛогистика_ГруппыДоступа.СоздатьГруппуДоступаСПолнымиПравами();
		Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.СоздатьПредопределенныеЭлементы();
		ВерсияДанных = УстановленнаяВерсия;
		ЗаполнитьПараметрыБлокировкиПриПервомЗапуске();
		СоздатьГруппыДоступаИПеренестиПользователей();
	КонецЕсли;
	
	РезультатСравнения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(УстановленнаяВерсия, ВерсияДанных) > 0;
	
	Если РезультатСравнения > 0 Тогда
		
		ЕстьОбновление = Истина;
		
	ИначеЕсли РезультатСравнения < 0 Тогда
		
		ЕстьОбновление = Ложь;
		Сообщить("Текущая запускаемая версия ниже, чем последняя использовавшаяся. Обратная совместимость не предусмотрена.
					|Вы можете продолжить работу, однако есть риск ошибок");
		
	Иначе // =0
		
		ЕстьОбновление = Ложь;
		
	КонецЕсли;
		
	Возврат ЕстьОбновление;

КонецФункции 

// Начальное заполнение и перенос из старой редакции

// TODO прикрутить к стартовому помощнику когда тот появится
Функция НачальноеЗаполнениеБазыДанных() Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	Справочники.КонтурЛогистика_Настройки.ЗаполнитьВсеНастройкиЗначениямиПоУмолчанию();
	СообщитьХодВыполнения(" - Основные настройки Контур.Логистика");
	
	Справочники.КонтурЛогистика_КлассификаторУпаковок.ЗаполнитьЗначениямиПоУмолчанию();
	СообщитьХодВыполнения(" - Заполнен классификатор упаковок");
	
	СообщитьХодВыполнения("Успешно завершил заполнение базовых справочников");
	Результат.Успешно = Истина;
	
	Возврат Результат;

КонецФункции 

Процедура ВыполнитьПереходНаНовуюВерсию_ФоновоеЗадание(ЗапускаемаяВерсия = Неопределено) Экспорт
	
	Попытка
		РезультатПерехода = ВыполнитьПереходНаНовуюВерсию(ЗапускаемаяВерсия);
	Исключение
		КонтурЛогистика_Метрика.ОбработатьОшибку("ВыполнитьПереходНаНовуюВерсию", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Если РезультатПерехода.Успешно = Ложь Тогда
		
		Попытка
			ТекстОшибок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(РезультатПерехода.МассивОшибок);
		Исключение
			ТекстОшибок = "Не удалось выполнить обновление";
		КонецПопытки;
		
		ВызватьИсключение "Не удалось выполнить обновление в фоне по причине: " + ТекстОшибок;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СообщитьХодВыполнения(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "" + ТекущаяДатаСеанса() + " " + Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

Функция ВыполнитьПереходНаНовуюВерсию(ДоКакойВерсииОбновить = Неопределено) Экспорт
	
	Если ДоКакойВерсииОбновить = Неопределено Тогда
		ДоКакойВерсииОбновить = ТекущаяВерсияПодсистемыКонтурЛогистика();
	КонецЕсли;
	
	СКакойВерсииОбновить = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеНастройки("ДанныеОбновленыДоВерсии");
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	Если СКакойВерсииОбновить = ДоКакойВерсииОбновить Тогда 
		Возврат Результат;
	КонецЕсли;
	
	// Всегда добавляем новые настройки и обновляем представления существующих
	СообщитьХодВыполнения("Инициализация новых общих настроек и обновление описания");
	Результат = ДобавитьНастройкиИОбновитьОписание();
	Если Не Результат.Успешно Тогда
		СообщитьРезультатыПерехода(ДоКакойВерсииОбновить, Результат);
		Возврат Результат;
	КонецЕсли;
	
	ОбработчикиОбновления = ПолучитьОбработчикиОбновления();
	
	Если ЗначениеЗаполнено(ОбработчикиОбновления) Тогда
		
		Для Каждого Обработчик Из ОбработчикиОбновления Цикл
			
			Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Обработчик.Версия, СКакойВерсииОбновить) <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Если версия обработчика больше текушей версии, то переходим на версию, до которой нужно обновить 
			Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Обработчик.Версия, ДоКакойВерсииОбновить) > 0 Тогда
				СообщитьРезультатыПерехода(ДоКакойВерсииОбновить, Результат);
				Прервать;
			КонецЕсли;
			
			Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Обработчик.Версия, СКакойВерсииОбновить) > 0 Тогда
				
				Результат = ВыполнитьСледующийШаг(Обработчик);
				СообщитьРезультатыПерехода(Обработчик.Версия, Результат);
				
				Если Не Результат.Успешно Тогда
					Прервать;
				КонецЕсли;
				
				СКакойВерсииОбновить = Обработчик.Версия;
				
			КонецЕсли;
			
			Если СКакойВерсииОбновить = ДоКакойВерсииОбновить Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ДоКакойВерсииОбновить, СКакойВерсииОбновить) >= 0 Тогда
			// На версию ДоКакойВерсииОбновить нет обработчика обновления - считаем что обновление выполнено
			Если Результат.Успешно Тогда
				СообщитьРезультатыПерехода(ДоКакойВерсииОбновить, Результат);
				Сообщить("Обновление данных на версию " + ДоКакойВерсииОбновить + " завершено");
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		СообщитьРезультатыПерехода(ДоКакойВерсииОбновить, Результат);
		
	КонецЕсли;
	
	Если Результат.Успешно = Ложь Тогда
		Попытка
			ТекстОшибок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(Результат.МассивОшибок);
		Исключение
			ТекстОшибок = "Не удалось выполнить обновление";
		КонецПопытки;
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ВыполнитьПереходНаНовуюВерсию", ТекстОшибок);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СообщитьРезультатыПерехода(Знач НоваяВерсия, Знач Результат)
	
	Сообщение = Новый СообщениеПользователю;
	
	Если Результат.Успешно Тогда
		Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ДанныеОбновленыДоВерсии", НоваяВерсия);
		Сообщение.Текст = "Выполнено обновление на релиз подсистемы " +  НоваяВерсия;
	Иначе
		Сообщение.Текст = "Не удалось выполнить обновление на релиз подсистемы " + НоваяВерсия + Символы.ПС
			+ "Ошибка: " + Результат.ОписаниеОшибки;
	КонецЕсли;
	
	Сообщение.Сообщить();
	
КонецПроцедуры

Функция ДобавитьНастройкиИОбновитьОписание()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		ТолькоНеинициализированные = Истина;
		ОбновлятьОписание = Истина;
		
		Результат = Справочники.КонтурЛогистика_Настройки.ЗаполнитьВсеНастройкиЗначениямиПоУмолчанию(,
			ТолькоНеинициализированные,, ОбновлятьОписание);
		
		Если Не Результат.Успешно Тогда
				
			ОтменитьТранзакцию();
			Возврат Результат;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Возврат Результат;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьСледующийШаг(Обработчик)
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Выполнить(Обработчик.Процедура + "(Результат)");
	
	Возврат Результат;
	
КонецФункции 

