	КонецЕсли;
	
	НайденноеРегламентноеЗадание = РегЗадания[0];
	
	НайденноеРегламентноеЗадание.Наименование = "Запуск роботов (Контур.Логистика)";
	НайденноеРегламентноеЗадание.Ключ = "КонтурЛогистика_ЗапускРоботов";
	НайденноеРегламентноеЗадание.Записать();
	
КонецПроцедуры

Процедура УдалитьУстаревшиеСтрокиМаппингаТитулов()
	
	// в 0.12.0 в модулях менеджера титулов появились манифесты реквизитов, которые не нужно настраивать в конвертации документов
	// но в старых релизах они уже добавились - выпилим их из настроек конвертации
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	               |ГДЕ
	               |	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(Выборка.Ссылка.ТипДокументаЛогистика) 
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(Выборка.Ссылка.ТипДокументаЛогистика) Тогда 
			
			НКДОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ИмяДокументаСокр = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НКДОбъект.ТипДокументаЛогистика);
			УдаляемыеИмена = Документы["КонтурЛогистика_" + ИмяДокументаСокр].КлючевыеРеквизитыСАвтоматическимЗаполнением();
			
			ТЧНастроек = НКДОбъект.ПравилаКонвертацииТитулаРеквизиты;
			ВсегоСтрок = ТЧНастроек.Количество();
			
			Для й = 1 По ВсегоСтрок Цикл 
				
				ТекНастройка = ТЧНастроек[ВсегоСтрок - й];
				
				Если УдаляемыеИмена.Найти(ТекНастройка.РеквизитТитула) <> Неопределено Тогда 
					ТЧНастроек.Удалить(ТекНастройка);
				КонецЕсли;
				
			КонецЦикла;
			
			// Для ТРН Т1 надо очистить еще в главном документе
			Если Выборка.Ссылка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				
				УдаляемыеИмена = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.КлючевыеРеквизитыСАвтоматическимЗаполнением();
				ТЧНастроек = НКДОбъект.ПравилаКонвертацииГлавногоДокумента;
				ВсегоСтрок = ТЧНастроек.Количество();
				
				Для й = 1 По ВсегоСтрок Цикл 
					
					ТекНастройка = ТЧНастроек[ВсегоСтрок - й];
					
					Если УдаляемыеИмена.Найти(ТекНастройка.РеквизитТитула) <> Неопределено Тогда 
						ТЧНастроек.Удалить(ТекНастройка);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			НКДОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтатусыСостоянийДокументооборота()
	
	ЭталоннаяТаблица = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПолучитьТаблицуПредопределенных();	
	
	Для Каждого СтрокаТаблицы Из ЭталоннаяТаблица Цикл 
		
		Попытка
			СостояниеДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду(СтрокаТаблицы.Код);
		Исключение
			СостояниеДО = Неопределено;
		КонецПопытки;
		
		Если СостояниеДО <> Неопределено Тогда
			
			СостояниеДООбъект = СостояниеДО.ПолучитьОбъект();
			
			Если СостояниеДООбъект.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			
			СостояниеДООбъект.ТребуемоеДействиеТ5 = СтрокаТаблицы.ТребуемоеДействиеТ5;
			СостояниеДООбъект.ТребуемоеДействиеТ6 = СтрокаТаблицы.ТребуемоеДействиеТ6;
			
			Попытка
				СостояниеДООбъект.Записать();
			Исключение
				// Ничего
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ДобавитьОтправителяШаблоновВНастройкуКонвертации()
	
	НастройкиКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.МассивНастроекКонвертацииПоТипуЛогистики(
								Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		
	Для Каждого Настройка Из НастройкиКонвертации Цикл 
		
		Правило = Настройка.ПравилаКонвертацииТитулаРеквизиты.Найти("ОтправительШаблона" , "РеквизитТитула");
		
		Если Правило = Неопределено Тогда 
			
			НастройкаОбъект = Настройка.ПолучитьОбъект();
			
			НовоеПравило = НастройкаОбъект.ПравилаКонвертацииТитулаРеквизиты.Добавить();
			
			НовоеПравило.РеквизитТитула = "ОтправительШаблона";
			НовоеПравило.РеквизитТитулаТипЗначения = "Организации Диадок (Контур.Логистика)";
			НовоеПравило.РеквизитТитулаКомментарий = "Указывается организация, которая готовит Титул 1 в качестве шаблона и передает его Грузоотправителю. Грузоотправитель создает из шаблона Титул 1, подписывает и отправляет Перевозчику.";
			НовоеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
			НовоеПравило.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок;
			
			НастройкаОбъект.Записать();
			
		КонецЕсли;	
		
	КонецЦикла;	
		
КонецПроцедуры	

Процедура ЗаполнитьПараметрыБлокировкиПриПервомЗапуске()
	
	// Сохраним блокировку, если она есть
	РаботаСВнешнимиРесурсамиЗаблокирована = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ПараметрыБлокировки_РаботаСВнешнимиРесурсамиЗаблокирована");
	
	Результат = КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.ТекущиеПараметрыБлокировки();
	
	КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.СохранитьПараметрыБлокировки(Результат);
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
		КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.ЗаписатьИдентификаторФайловойБазыВФайлПроверки(Результат.ИдентификаторБазы);
	КонецЕсли;
	
	// Вернем прежнее значение
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(
		"ПараметрыБлокировки_РаботаСВнешнимиРесурсамиЗаблокирована", РаботаСВнешнимиРесурсамиЗаблокирована);
	
КонецПроцедуры

Процедура ПереносДопКолонокВТабличнуюЧастьНКД()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка,
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ПутьДоп1 КАК ПутьДоп1,
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ПутьДоп2 КАК ПутьДоп2
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ПутьДоп1 <> """"
	|	ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.ПутьДоп2 <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НКДОбъект = Выборка.Ссылка.ПолучитьОбъект();
		НКДОбъект.ДополнительныеКолонки.Очистить();
		
		Если ЗначениеЗаполнено(Выборка.ПутьДоп1) Тогда
			НоваяСтрока = НКДОбъект.ДополнительныеКолонки.Добавить();
			НоваяСтрока.Заголовок = "Доп1";
			НоваяСтрока.ПутьКДанным = Выборка.ПутьДоп1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ПутьДоп2) Тогда
			НоваяСтрока = НКДОбъект.ДополнительныеКолонки.Добавить();
			НоваяСтрока.Заголовок = "Доп2";
			НоваяСтрока.ПутьКДанным = Выборка.ПутьДоп2;
		КонецЕсли;
		
		НКДОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьСтатусТитулаПодписанДляВсехПодписанныхФайловОбмена()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних(&Дата) КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|		ПО КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
		|ГДЕ
		|	НЕ КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ.ПометкаУдаления
		|	И КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
		|	И КонтурЛогистика_ФайлыОбмена.ПодписьВерна = ИСТИНА";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ВыборкаДетальныеЗаписи.Документ, 
																			Перечисления.КонтурЛогистика_СтатусыТитулов.Подписан);
																			
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьГруппыДоступаИПеренестиПользователей()
	
	// Не можем перенести бля БСП ниже 2.3.1.88
	Если Не КонтурЛогистика_ОбщегоНазначенияСервер.ВерсияСтандартнойПодсистемыВыше("2.3.1.88") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСправочникаГруппыДоступа = "Справочники.ГруппыДоступа";
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные(ИмяСправочникаГруппыДоступа) Тогда
		Возврат;
	КонецЕсли;
	
	// Создадим группы и профили доступа
	ГруппаДоступаСсылка = КонтурЛогистика_ОбщегоНазначенияСервер.СоздатьГруппыДоступа();
	
	Если Не ЗначениеЗаполнено(ГруппаДоступаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	// Перенесем пользователей в новые группы
	ПользователиСРолью = ПользователиСРолью("Роль.КонтурЛогистика_УдалитьАдминистратор");
	ДобавитьПользователейВГруппуДоступа("Администраторы (Контур.Логистика)", ПользователиСРолью);
	
	ПользователиСРолью = ПользователиСРолью("Роль.КонтурЛогистика_УдалитьПродвинутыйПользователь");
	ДобавитьПользователейВГруппуДоступа("Продвинутые пользователи (Контур.Логистика)", ПользователиСРолью);
	
	ПользователиСРолью = ПользователиСРолью("Роль.КонтурЛогистика_УдалитьПользователь");
	ДобавитьПользователейВГруппуДоступа("Пользователи (Контур.Логистика)", ПользователиСРолью);
	
КонецПроцедуры

Функция ПользователиСРолью(ИмяРоли)
	
	ИдентификаторОбъектаРоли = ИдентификаторОбъектаРоли(ИмяРоли);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторОбъектаРоли", ИдентификаторОбъектаРоли);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГруппыДоступаПользователи.Пользователь КАК Пользователь
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|			ПО ГруппыДоступа.Профиль = ПрофилиГруппДоступаРоли.Ссылка
	|		ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
	|ГДЕ
	|	ПрофилиГруппДоступаРоли.Роль = &ИдентификаторОбъектаРоли
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыДоступаПользователи.Пользователь";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
	
КонецФункции

Функция ИдентификаторОбъектаРоли(ПолноеИмя)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПолноеИмя", ПолноеИмя);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИдентификаторыОбъектовРасширений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовРасширений КАК ИдентификаторыОбъектовРасширений
	|ГДЕ
	|	НЕ ИдентификаторыОбъектовРасширений.ПометкаУдаления
	|	И ИдентификаторыОбъектовРасширений.ПолноеИмя = &ПолноеИмя";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьПользователейВГруппуДоступа(ИмяГруппы, ПользователиСРолью)
	
	ГруппаДоступа = Справочники["ГруппыДоступа"].НайтиПоНаименованию(ИмяГруппы, Истина);
	Если Не ЗначениеЗаполнено(ГруппаДоступа) Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаДоступаОбъект = ГруппаДоступа.ПолучитьОбъект();
	
	Для Каждого ПользовательСРолью Из ПользователиСРолью Цикл
		ПользовательУжеЕсть = Ложь;
		Для Каждого ТекущийПользователь Из ГруппаДоступаОбъект.Пользователи Цикл
			Если ТекущийПользователь.Пользователь = ПользовательСРолью Тогда
				ПользовательУжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ПользовательУжеЕсть Тогда
			НоваяСтрока = ГруппаДоступаОбъект.Пользователи.Добавить();
			НоваяСтрока.Пользователь = ПользовательСРолью;
		КонецЕсли;
	КонецЦикла;
	
	ГруппаДоступаОбъект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьТипПодписиВСертификате()
	
	Запрос = Новый Запрос;
	Запрос.Текст =			
		"ВЫБРАТЬ
		|	КонтурЛогистика_СертификатыЭлектроннойПодписи.Ссылка КАК Сертификат
		|ИЗ
		|	Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи КАК КонтурЛогистика_СертификатыЭлектроннойПодписи
		|ГДЕ
		|	НЕ КонтурЛогистика_СертификатыЭлектроннойПодписи.ПометкаУдаления
		|	И КонтурЛогистика_СертификатыЭлектроннойПодписи.СрокДействия > &ТекущаяДата";	
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Сертификаты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сертификат");
	
	Для каждого Сертификат Из Сертификаты Цикл
		
		СертификатОбъект = Сертификат.ПолучитьОбъект();
		
		Если Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ЭтоТестовыйСертификат(Сертификат.Издатель) Тогда
			СертификатОбъект.ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.Тестовая;
		Иначе
			СертификатОбъект.ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.УКЭП;
		КонецЕсли;
		
		СертификатОбъект.Записать();
						
	КонецЦикла;
	
	ПараметрыФоновогоЗадания = Новый Структура("Сертификаты", Сертификаты);
	КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьВФоне("КонтурЛогистика_ДлительныеОперацииСервер.ОбновитьТипПодписиЧерезДиадок",
					ПараметрыФоновогоЗадания,
					"КлючФЗ_ОбновитьТипПодписиЧерезДиадок",
					"Обноление типа подписи через Диадок");
		
КонецПроцедуры

Процедура ЗаполнитьРеквизитДействиеПриОтказеВалидацииНКД()
	
	ЗначениеПоУмолчанию = Перечисления.КонтурЛогистика_ДействияПриОтказеВалидации.ЗапретПодписания;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументовПроизвольныеВалидации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПроизвольныеВалидации КАК КонтурЛогистика_НастройкиКонвертацииДокументовПроизвольныеВалидации
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииДокументовПроизвольныеВалидации.ДействиеПриОтказеВалидации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ДействияПриОтказеВалидации.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_НастройкиКонвертацииДокументовПроизвольныеВалидации.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НКДОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Для Каждого ТекущаяСтрока Из НКДОбъект.ПроизвольныеВалидации Цикл
			Если ЗначениеЗаполнено(ТекущаяСтрока.ДействиеПриОтказеВалидации) Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяСтрока.ДействиеПриОтказеВалидации = ЗначениеПоУмолчанию;
		КонецЦикла;
		
		НКДОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнениеСпособаМаппингаДляОтказаДобавленияСтрокиВНКД()
	
	Выборка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НКД = Выборка.Ссылка;
		
		Если НКД.ПравилаКонвертацииТитулаТабЧастьПроизвольная.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НКДОб = НКД.ПолучитьОбъект();
		Для каждого ПравилоКонвертации Из НКДОб.ПравилаКонвертацииТитулаТабЧастьПроизвольная Цикл
			ПравилоКонвертации.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;	
		КонецЦикла;
		НКДОб.ОбменДанными.Загрузка = Истина;
		НКДОб.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьТЧРазрешенияРаботыСДокументамиСотрудников()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_Сотрудники.Ссылка КАК Ссылка,
	|	МАКСИМУМ(КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ Сотрудники
	|ИЗ
	|	Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_Сотрудники.РазрешенияРаботыСДокументами КАК КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами
	|		ПО КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами.Ссылка = КонтурЛогистика_Сотрудники.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_Сотрудники.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.НомерСтроки ЕСТЬ NULL";
	
	Результат = Запрос.ВыполнитьПакет();
	
	НашиОрганизации = Результат[0].Выгрузить().ВыгрузитьКолонку("Ссылка");
	ВыборкаСотрудники = Результат[2].Выбрать();
	
	Пока ВыборкаСотрудники.Следующий() Цикл
		
		СотрудникОбъект = ВыборкаСотрудники.Ссылка.ПолучитьОбъект();
		СотрудникОбъект.ОбменДанными.Загрузка = Истина;
		
		// Добавим разрешения в разрезе организаций
		Для Каждого ТекущаяОрганизация Из НашиОрганизации Цикл
			НоваяСтрока = СотрудникОбъект.РазрешенияРаботыСДокументами.Добавить();
			НоваяСтрока.Организация = ТекущаяОрганизация;
			НоваяСтрока.МожетПодписывать = Истина;
			НоваяСтрока.МожетПередаватьНаПодпись = Ложь;
		КонецЦикла;
		
		СотрудникОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСценарийВНКД()
	
	Попытка
		Т1СценарийПодписания = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1СценарийПодписания");
	Исключение
		// Значит ее уже удалили
		Возврат;
	КонецПопытки;
	
	Если Т1СценарийПодписания = Перечисления.КонтурЛогистика_СценарииПодписанияТитулов.НеподписанныйВодительПодпись Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТипДокументаЛогистика", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		Запрос.УстановитьПараметр("Сценарий", Перечисления.КонтурЛогистика_Сценарии.Отправка);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка,
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика КАК ТипДокументаЛогистика
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Сценарий = &Сценарий
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НКДОбъект = Выборка.Ссылка.ПолучитьОбъект();
			НКДОбъект.ОбменДанными.Загрузка = Истина;
			НКДОбъект.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного;
			НКДОбъект.Записать();
		КонецЦикла;
	КонецЕсли;
	
	// Удалим настройку Т1СценарийПодписания
	Попытка
		ПробоватьСоздаватьПриОтсутствии = Ложь;
		НастройкаТ1СценарийПодписания = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(
			"Т1СценарийПодписания", ПробоватьСоздаватьПриОтсутствии);
		Если ЗначениеЗаполнено(НастройкаТ1СценарийПодписания) Тогда
			НастройкаТ1СценарийПодписанияОбъект = НастройкаТ1СценарийПодписания.ПолучитьОбъект();
			НастройкаТ1СценарийПодписанияОбъект.Удалить();
		КонецЕсли;
	Исключение
		// Значит ее уже удалили
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьНастройкиКонвертацииДокументовСпецСценариев()
	
	ТипДокументаЛогистика = Новый Массив;
	ТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
	ТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3);
	ТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4);
	ТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка) КАК Ссылка,
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика КАК ТипДокументаЛогистика
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И (КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее)
	|			ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее))
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика В(&ТипДокументаЛогистика)
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя;
		ИначеЕсли Выборка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7;
		ИначеЕсли Выборка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату;
		ИначеЕсли Выборка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4;
		Иначе
			Продолжить;
		КонецЕсли;
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
			Выборка.ТипДокументаЛогистика,, СпецСценарий);
		
		Если НастройкаКонвертации <> Неопределено Тогда
			// Уже есть настройка под спец. сценарий
			Продолжить;
		КонецЕсли;
		
		// Создадим настройки со спец. сценариями
		НКДИсточникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		НовыйНКД = НКДИсточникОбъект.Скопировать();
		НовыйНКД.СпецСценарий = СпецСценарий;
		НовыйНКД.Наименование = "" + НовыйНКД.ТипДокументаЛогистика + " по предыдущему титулу" + ", " + НРег(СпецСценарий);
		
		Если Выборка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			// Особенности для ПЛ Т1, так как при смене водителя основание другое
			НовыйНКД.ТипДокумента1С = Неопределено;
			
			Для Каждого ТекущаяСтрока Из НовыйНКД.ПравилаКонвертацииТитулаРеквизиты Цикл
				ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
			КонецЦикла;
		КонецЕсли;
		
		НовыйНКД.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаменитьТребуемоеДействиеТ5СтатусаДОЗавершен()
	
	СтатусыКОбработке = Новый Массив;
	СтатусыКОбработке.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду(
		"completed"));
	СтатусыКОбработке.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду(
		"pd-wait-carrier-readdress-sign"));
	
	Для Каждого ТекущийСтатус Из СтатусыКОбработке Цикл
		
