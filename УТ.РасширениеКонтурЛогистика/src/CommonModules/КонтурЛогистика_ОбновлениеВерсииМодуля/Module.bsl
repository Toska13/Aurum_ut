Процедура ЗаполнитьДополнительныеКолонкиНКД()
	
	ВыборкаНКД = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.Выбрать();
	Пока ВыборкаНКД.Следующий() Цикл
		
		Если ВыборкаНКД.ДополнительныеКолонки.Количество() > 0 Тогда
			
			НКДОб = ВыборкаНКД.ПолучитьОбъект();
			Для каждого ДопКолонка Из НКДОб.ДополнительныеКолонки Цикл
				
				Если НКДОб.Сценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя Тогда
					Если Найти(ДопКолонка.ПутьКДанным, "ПодзапросТекущийТ1СоСменами.ДокументОснование.") = 0 Тогда
						ДопКолонка.ПутьКДанным = "ПодзапросТекущийТ1СоСменами.ДокументОснование." + ДопКолонка.ПутьКДанным;
					КонецЕсли;
				ИначеЕсли НКДОб.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
					Или НКДОб.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
					Или НКДОб.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
					Или НКДОб.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
					Или НКДОб.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
					Или НКДОб.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда					
					ДопКолонка.ДобавленИзКонструктораЗапроса = Истина;
				Иначе
					Если Найти(ДопКолонка.ПутьКДанным, "ПодзапросТекущийТитул.ДокументОснование.") = 0 Тогда
						ДопКолонка.ПутьКДанным =  "ПодзапросТекущийТитул.ДокументОснование." + ДопКолонка.ПутьКДанным;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			НКДОб.ОбменДанными.Загрузка = Истина;
			НКДОб.Записать();
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

