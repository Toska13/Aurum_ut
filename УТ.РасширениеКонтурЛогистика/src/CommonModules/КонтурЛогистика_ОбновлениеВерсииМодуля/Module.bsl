Процедура ПереходНаВерсию_0_6_0(Результат)

	СообщитьХодВыполнения("Начал обновление на 0.6.0");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		// обновим состояния движения документооборота
		СообщитьХодВыполнения("Добавление правила конвертации ""Отправитель шаблона"" для настройки конвертации документов для Титула 1");
		ДобавитьОтправителяШаблоновВНастройкуКонвертации();
		
		СообщитьХодВыполнения("Обновление названий статусов в справочнике состояний");
		Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ЗаполнитьЗначениямиПоУмолчанию(Истина);
		
		Результат.Успешно = Истина;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	СообщитьХодВыполнения("Завершил обновление на 0.6.0");
	
КонецПроцедуры

