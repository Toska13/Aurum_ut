		               |	И КонтурЛогистика_ОрганизацииДиадок.ИНН <> """"";
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
		
			Попытка
			
				ОрганизацияДиадокОбъект = Выборка.Ссылка.ПолучитьОбъект();
