Процедура СоздатьНКДРучногоВводаПЛТ1()
	
	ИспользуютсяПутевыеЛисты = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	Если Не ИспользуютсяПутевыеЛисты Тогда
		Возврат;
	КонецЕсли;
	
	ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
	Если ЗначениеЗаполнено(КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(ТипЛогистика)) Тогда
		Возврат;
	КонецЕсли;
	
	НКДОбъект = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
	НКДОбъект.Наименование = "ПЛ1 - Путевой лист (начало) ввод вручную";
	НКДОбъект.ТипДокументаЛогистика = ТипЛогистика;
	НКДОбъект.Сценарий_ОтправлятьПодписанный = Истина;
	НКДОбъект.Сценарий_ОтправлятьВФоне = Истина;
	НКДОбъект.Сценарий_ОтправлятьВСеансе = Истина;
	НКДОбъект.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
	НКДОбъект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
	НКДОбъект.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
	
	Попытка
		НКДОбъект.Записать();
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПеренестиГруппуНастроекСоответствияТоваров()
	
	ПробоватьСоздаватьПриОтсутствии = Истина;
	КаталогНастройкиСоответствияНоменклатуры = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(
		"НастройкиСоответствияНоменклатуры", ПробоватьСоздаватьПриОтсутствии);
	КаталогНастройкиКонвертации = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(
		"НастройкиКонвертации", ПробоватьСоздаватьПриОтсутствии);
	Если ЗначениеЗаполнено(КаталогНастройкиСоответствияНоменклатуры)
		И ЗначениеЗаполнено(КаталогНастройкиКонвертации) Тогда
		
		КаталогНастройкиСоответствияНоменклатурыОбъект = КаталогНастройкиСоответствияНоменклатуры.ПолучитьОбъект();
		КаталогНастройкиСоответствияНоменклатурыОбъект.Родитель = КаталогНастройкиКонвертации;
		КаталогНастройкиСоответствияНоменклатурыОбъект.Записать();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КаталогНастройкиСоответствияНоменклатуры) Тогда
		ИспользоватьИПрименятьБазовыеСоответствия = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(
			"ИспользоватьИПрименятьБазовыеСоответствия", ПробоватьСоздаватьПриОтсутствии);
		
		ИспользоватьИПрименятьБазовыеСоответствияОбъект = ИспользоватьИПрименятьБазовыеСоответствия.ПолучитьОбъект();
		ИспользоватьИПрименятьБазовыеСоответствияОбъект.Родитель = КаталогНастройкиСоответствияНоменклатуры;
		ИспользоватьИПрименятьБазовыеСоответствияОбъект.Записать();
		
		ТребоватьНаличиеБазовыхСоответствий = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(
			"ТребоватьНаличиеБазовыхСоответствий", ПробоватьСоздаватьПриОтсутствии);
		
		ТребоватьНаличиеБазовыхСоответствийОбъект = ТребоватьНаличиеБазовыхСоответствий.ПолучитьОбъект();
		ТребоватьНаличиеБазовыхСоответствийОбъект.Родитель = КаталогНастройкиСоответствияНоменклатуры;
		ТребоватьНаличиеБазовыхСоответствийОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьDirectoryIdВОрганизациях()
	
	НашиОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	
	Для Каждого Организация Из НашиОрганизации Цикл 
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Организация);
		Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ДанныеОрганизации = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ПолучитьСведенияОСобственнойОрганизации(Организация);
			
			Если ДанныеОрганизации = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ТекущаяСтрока Из ДанныеОрганизации Цикл
				Если ТекущаяСтрока.Получить("diadocBoxId") <> Организация.ID Тогда
					Продолжить;
				КонецЕсли;
				
				ОрганизацияОб = Организация.ПолучитьОбъект();
				ОрганизацияОб.DirectoryId = ТекущаяСтрока.Получить("personsDirectoryId");
				ОрганизацияОб.ОбменДанными.Загрузка = Истина;
				ОрганизацияОб.Записать();
			КонецЦикла;
			
		Исключение
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьНастройкиОрганизацииИзСервиса()
	
	// Не важно под какой организацией получаем данные
	ТочноеСовпадение = Ложь;
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ОрганизацииДиадок.ИНН КАК ИНН
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.ИНН) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущийОбъект = Выборка.Ссылка.Получитьобъект();
		ТекущийОбъект.СинхронизироватьИзСервисаЛогистика();
		ТекущийОбъект = Неопределено;
		
	КонецЦикла;
	
КонецПроцедуры

