Процедура ПереносДанныхИзНастроекПодписанияВСправочникСертификаты()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиПодписания КАК КонтурЛогистика_НастройкиПодписания
		|ГДЕ
		|	КонтурЛогистика_НастройкиПодписания.УдалитьСрокДействия >= &УдалитьСрокДействия";
	
	Запрос.УстановитьПараметр("УдалитьСрокДействия", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ОтпечатокСертификата = ВыборкаДетальныеЗаписи.УдалитьОтпечатокСертификата;
		
		Если Не ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
			Продолжить;
		КонецЕсли;
		
		НайдСертификат = Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПолучитьСертификатПоОтпечатку(ОтпечатокСертификата, ВыборкаДетальныеЗаписи.СертификатНаСервере);
		Если НайдСертификат.Пустая() Тогда
			
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УдалитьОГРНИП) Тогда
				ЭтоИП = Истина;
				ЭтоФЛ = Ложь;
			Иначе
				ЭтоИП = Ложь;
				ЭтоФЛ = Истина;
			КонецЕсли;
			
			Сертификат = Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.СоздатьЭлемент();
			
			Если Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПодписания.Ресурсы.Найти("Фамилия") <> Неопределено Тогда
				Сертификат.Фамилия = ВыборкаДетальныеЗаписи.Фамилия;
			Иначе
				Сертификат.Фамилия = ВыборкаДетальныеЗаписи.УдалитьФамилия;
			КонецЕсли;
			Если Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПодписания.Ресурсы.Найти("Имя") <> Неопределено Тогда
				Сертификат.Имя = ВыборкаДетальныеЗаписи.Имя;
			Иначе
				Сертификат.Имя = ВыборкаДетальныеЗаписи.УдалитьИмя;
			КонецЕсли;
			Если Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПодписания.Ресурсы.Найти("Отчество") <> Неопределено Тогда
				Сертификат.Отчество = ВыборкаДетальныеЗаписи.Отчество;
			Иначе
				Сертификат.Отчество = ВыборкаДетальныеЗаписи.УдалитьОтчество;
			КонецЕсли;
			Если Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПодписания.Ресурсы.Найти("Должность") <> Неопределено Тогда
				Сертификат.Должность = ВыборкаДетальныеЗаписи.Должность;
			Иначе
				Сертификат.Должность = ВыборкаДетальныеЗаписи.УдалитьДолжность;
			КонецЕсли;
			
			ДанныеСертификата = Новый Структура;
			ДанныеСертификата.Вставить("ЭтоЮЛ", Ложь);
			ДанныеСертификата.Вставить("ЭтоИП", ЭтоИП);
			ДанныеСертификата.Вставить("ЭтоФЛ", ЭтоФЛ);
			ДанныеСертификата.Вставить("Фамилия", Сертификат.Фамилия);
			ДанныеСертификата.Вставить("Имя", Сертификат.Имя);
			ДанныеСертификата.Вставить("Отчество", Сертификат.Отчество);
			ДанныеСертификата.Вставить("СрокДействия", ВыборкаДетальныеЗаписи.УдалитьСрокДействия);
			Сертификат.Наименование = СформироватьНаименованиеСертификата(ДанныеСертификата);
						
			Сертификат.ОтпечатокСертификата = ОтпечатокСертификата;									
			Сертификат.ДатаВыдачи = ВыборкаДетальныеЗаписи.УдалитьДатаВыдачи;
			Сертификат.СрокДействия = ВыборкаДетальныеЗаписи.УдалитьСрокДействия;
			Сертификат.Организация = ВыборкаДетальныеЗаписи.УдалитьОрганизация;
			Сертификат.Издатель = ВыборкаДетальныеЗаписи.УдалитьИздатель;
			Сертификат.ИНН = ВыборкаДетальныеЗаписи.УдалитьИНН;
			Сертификат.ОГРНИП = ВыборкаДетальныеЗаписи.УдалитьОГРНИП;
			Сертификат.ТипМодуляКриптографии = ВыборкаДетальныеЗаписи.УдалитьТипМодуляКриптографии;
			Сертификат.ИмяМодуляКриптографии = ВыборкаДетальныеЗаписи.УдалитьИмяМодуляКриптографии;
			Сертификат.ВводитьПарольВПрограммеЭлектроннойПодписи = ВыборкаДетальныеЗаписи.УдалитьВводитьПарольВПрограммеЭлектроннойПодписи;
			Сертификат.СертификатНаСервере = ВыборкаДетальныеЗаписи.СертификатНаСервере;
			
			Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УдалитьТипМодуляКриптографии) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УдалитьИмяМодуляКриптографии) Тогда
				ТипПрограммыЭППоУмолчанию = КонтурЛогистика_КриптографияСервер.ПолучитьТипыМодуляКриптографии()[0];
				ТипПрограммыЭП = ТипПрограммыЭППоУмолчанию.ИмяМодуляКриптографии;
				Сертификат.ТипМодуляКриптографии = ТипПрограммыЭППоУмолчанию.ТипМодуляКриптографии;
				Сертификат.ИмяМодуляКриптографии = ТипПрограммыЭППоУмолчанию.ИмяМодуляКриптографии;
			Иначе
				Сертификат.ТипМодуляКриптографии = ВыборкаДетальныеЗаписи.УдалитьТипМодуляКриптографии;
				Сертификат.ИмяМодуляКриптографии = ВыборкаДетальныеЗаписи.УдалитьИмяМодуляКриптографии;	
			КонецЕсли;
										
			Сертификат.Записать();
			
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПЗК) Тогда
				КонтурЛогистика_ОбщегоНазначенияВызовСервера.ЗаписатьПароль(
					Сертификат.Ссылка, ВыборкаДетальныеЗаписи.ПЗК, "ПЗК");
			КонецЕсли;
			
			Запись = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.СоздатьМенеджерЗаписи();
			Запись.Период = ВыборкаДетальныеЗаписи.Период;
			Запись.ОрганизацияДиадок = ВыборкаДетальныеЗаписи.ОрганизацияДиадок;
			Запись.Пользователь1С = ВыборкаДетальныеЗаписи.Пользователь1С;
			Запись.СертификатНаСервере = ВыборкаДетальныеЗаписи.СертификатНаСервере;
			Запись.ДопПараметр = ВыборкаДетальныеЗаписи.ДопПараметр;
	        Запись.Прочитать();
	        
	        Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Сертификат = Сертификат.Ссылка;
				Запись.Записать();
			КонецЕсли;
			
		Иначе
			
			Запись = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.СоздатьМенеджерЗаписи();
			Запись.Период = ВыборкаДетальныеЗаписи.Период;
			Запись.ОрганизацияДиадок = ВыборкаДетальныеЗаписи.ОрганизацияДиадок;
			Запись.Пользователь1С = ВыборкаДетальныеЗаписи.Пользователь1С;
			Запись.СертификатНаСервере = ВыборкаДетальныеЗаписи.СертификатНаСервере;
			Запись.ДопПараметр = ВыборкаДетальныеЗаписи.ДопПараметр;
	        Запись.Прочитать();
	        
	        Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Сертификат = НайдСертификат;
				Запись.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

Функция СформироватьНаименованиеСертификата(ДанныеСертификата)

	ФИО = ДанныеСертификата.Фамилия + " " + ДанныеСертификата.Имя + " " + ДанныеСертификата.Отчество;
										
	Если ДанныеСертификата.ЭтоЮЛ Тогда					
		ОформленНа = "";					
	ИначеЕсли ДанныеСертификата.ЭтоИП Тогда					
		ОформленНа = "ИП";					
	ИначеЕсли ДанныеСертификата.ЭтоФЛ Тогда					
		ОформленНа = "Физическое лицо";
	Иначе
	    ОформленНа = "";
	КонецЕсли;
	
	Возврат ФИО + ", " 
			+ Формат(ДанныеСертификата.СрокДействия, "ДФ='""по ""dd.MM.yyyy'")  
			+ ?(ЗначениеЗаполнено(ОформленНа), ", " + ОформленНа, "");
				
КонецФункции

