			НоваяСтрока.ВыражениеВычисленияСтрокаНеогр =
				"ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(""ИмяКонфигурации1С"");
				|Если ИмяКонфигурации1С = ""УАТ""
				|	Или ИмяКонфигурации1С = ""ТЛЭ""
				|	Или ИмяКонфигурации1С = ""УАТ_ПРОФ""
				|	Или ИмяКонфигурации1С = ""ERP_УАТ"" Тогда
				|	
				|	КонтурЛогистика_КонвертацияСервер.КонвертироватьПриТриггереУникальноеИмяПрограммногоВызова(""ПриФормированииПЛТ5"", Основание, Объект.Титул1);
				|КонецЕсли;
				|
				|РезультатВычисления = Истина;";
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
			
			ТекущаяНастройкаОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

