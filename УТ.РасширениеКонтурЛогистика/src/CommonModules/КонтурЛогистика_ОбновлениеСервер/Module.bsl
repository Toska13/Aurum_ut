Функция ИмяПродукта(ИмяРасширения = "")

	ИмяПродукта = БазовоеИмяПродукта();
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение() Тогда 
		
		// Так как и УТ и ERP могут быть двух версий *.4 или *.5.
		Если ИмяКонфигурации = "УФ_УТ"
			Или ИмяКонфигурации = "ERP" Тогда
			
			НомерРедакции = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Метаданные.Версия, ".")[1];
			
			Если Число(НомерРедакции) > 4 Тогда
				
				ИмяКонфигурации = "УФ_УТ_11_5";
				
				Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоРасширениеGLN() Тогда
					ИмяКонфигурации = "УФ_УТ_11_5_DEF_GLN";	
				КонецЕсли;
				
			Иначе
				
				ИмяКонфигурации = "УФ_УТ_11_4";
				
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации = "УФ_БП" Тогда
			
			Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоРасширениеGLN() Тогда
				ИмяКонфигурации = "УФ_БП_DEF_GLN";	
			КонецЕсли;
			
		КонецЕсли;
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширениеСОпределяемымиТипами() Тогда
			ИмяКонфигурации = "УФ";			
		КонецЕсли;
		
		Если Не ИмяКонфигурации = Неопределено Тогда 
			
			Соответствие = СоответствиеИмениКонфигурацииПродуктуВСервисеОбновлений();
			
			ИмяПродукта = Соответствие.Получить(ИмяКонфигурации);
			
			Если ИмяПродукта = Неопределено Тогда 
				
				ВызватьИсключение "Не найдено продукта в сервисе обновлений для конфигурации " + ИмяКонфигурации;
				
			КонецЕсли;
			
			Если ИмяРасширения = "ДополнительноеРасширение" Тогда
				ИмяПродукта = "logist_addon";
			ИначеЕсли ИмяРасширения = "ДополнительныеРеквизитыРасширение" Тогда
				ИмяПродукта = СтрЗаменить(ИмяПродукта, "logist_", "logist_additional_meta_");
			ИначеЕсли ИмяРасширения = "QR_МП_УАТ_Расширение" Тогда
				ИмяПродукта = СтрЗаменить(ИмяПродукта, "logist_", "logist_qr_");
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
			ИмяПродукта = "logist_subsystem_8_2";	
		КонецЕсли;
		
		Если ИмяКонфигурации = "УТ" И Найти(Метаданные.Версия, "10.3") > 0 Тогда
			ИмяПродукта = "logist_subsystem_ut_10";	
		ИначеЕсли ИмяКонфигурации = "УПП" Тогда
			ИмяПродукта = "logist_subsystem_upp";	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИмяПродукта;
	
КонецФункции

Функция БазовоеИмяПродукта()
	
	Возврат "logist_subsystem_8_3";
	
КонецФункции

Функция СоответствиеИмениКонфигурацииПродуктуВСервисеОбновлений()
	
	Соответствие = Новый Соответствие;
	
	Соответствие.Вставить("КЛ", 	"logist_subsystem_8_3");
	Соответствие.Вставить("ERP", 	"logist_ut_11_5");
	Соответствие.Вставить("КА_2", 	"logist_ka_2_5");
	Соответствие.Вставить("УФ_БП", 	"logist_buh_3_0");
	Соответствие.Вставить("УФ_БП_DEF_GLN", 	"logist_buh_3_0_def_gln");
	Соответствие.Вставить("УФ_УНФ", "logist_unf_1_6");
	
	Соответствие.Вставить("УФ_УТ_11_4", "logist_ut_11");
	Соответствие.Вставить("УФ_УТ_11_5", "logist_ut_11_5");
	Соответствие.Вставить("УФ_УТ_11_5_DEF_GLN", "logist_ut_11_5_def_gln");
	
	Соответствие.Вставить("УАТ_ПРОФ", "logist_uat_prof_2_2");
	Соответствие.Вставить("УАТ", "logist_uat_2_2");
	Соответствие.Вставить("ТЛЭ", "logist_uat_prof_2_2");
	Соответствие.Вставить("ERP_УАТ", "logist_erp_uat_2_5");
	
	Соответствие.Вставить("УФ", "logist_cfe_def");
	
	Возврат Соответствие;
	
КонецФункции

#Область РаботаСУведомленими

Процедура ОбновитьУведомленияПродукта(ТелоОтвета)
	
	ОбъектОтвета = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(ТелоОтвета);
	// Пример - ОбъектОтвета.notifications:
	//	content
	//		body		""
	//		title		"Тестовый заголовок"
	//		type		"html"
	//		form_name	"Имя формы"		Массив (не обязательное)
	//	date_from	"2025-06-01"
	//	date_to		"2025-06-30"
	//	id			"dffaced2-5e36-4a13-9bf8-c7675a0690d1"
	//	priority	"high"
	
	НовыеУведомления = Новый Массив;
	
	// Соберем идентификаторы
	КвалификаторыСтроки = Новый КвалификаторыСтроки(36);
	ИДВходящихУведомлений = Новый ТаблицаЗначений;
	ИДВходящихУведомлений.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка",, КвалификаторыСтроки));
	Для Каждого ТекущаяСтрока Из ОбъектОтвета.notifications Цикл
		НоваяСтрока = ИДВходящихУведомлений.Добавить();
		НоваяСтрока.Идентификатор = ТекущаяСтрока.id;
	КонецЦикла;
	
	// Получим по идентификаторам новые и на удаление уведомления
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИДВходящихУведомлений", ИДВходящихУведомлений);
	Запрос.Текст = ТекстЗапросаОбновленияУведомлений();
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаНовые = Результат[2].Выбрать();
	ВыборкаНаУдаление = Результат[3].Выбрать();
	
	// Создадим новые
	Пока ВыборкаНовые.Следующий() Цикл
		Для Каждого ТекущаяСтрока Из ОбъектОтвета.notifications Цикл
			Если ТекущаяСтрока.id <> ВыборкаНовые.Идентификатор Тогда
				Продолжить;
			КонецЕсли;
			
			НовоеУведомление = Справочники.КонтурЛогистика_УведомленияПродукта.СоздатьЭлемент();
			НовоеУведомление.Наименование = СокрЛП(ТекущаяСтрока.content.title);
			НовоеУведомление.Идентификатор = СокрЛП(ТекущаяСтрока.id);
			НовоеУведомление.ДатаНачала = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СтрокаВДатуЛок(СокрЛП(ТекущаяСтрока.date_from));
			НовоеУведомление.ДатаОкончания = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СтрокаВДатуЛок(СокрЛП(ТекущаяСтрока.date_to));
			НовоеУведомление.ТипКонтента = СокрЛП(ТекущаяСтрока.content.type);
			НовоеУведомление.Текст = СокрЛП(ТекущаяСтрока.content.body);
			НовоеУведомление.Приоритет = СокрЛП(ТекущаяСтрока.priority);
			
			Если ТекущаяСтрока.content.Свойство("form_name") Тогда
				Для Каждого form_name Из ТекущаяСтрока.content.form_name Цикл
					НовоеИмяФормы = НовоеУведомление.ИменаФорм.Добавить();
					НовоеИмяФормы.ИмяФормы = СокрЛП(form_name);
				КонецЦикла;
			КонецЕсли;
			
			НовоеУведомление.Записать();
			
			НовыеУведомления.Добавить(НовоеУведомление.Ссылка);
		КонецЦикла;
	КонецЦикла;
	
	// Удалим не актуальные
	Пока ВыборкаНаУдаление.Следующий() Цикл
		УведомлениеОбъект = ВыборкаНаУдаление.Ссылка.ПолучитьОбъект();
		УведомлениеОбъект.Удалить();
	КонецЦикла;
	
	Если НовыеУведомления.Количество() <> 0 Тогда
		
		// Отправим новые уведомления администратору
		
		// Телефон
		КонтактыАдминистратора_Телефоны = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("КонтактыАдминистратора_Телефоны");
		ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
		Если ЗначениеЗаполнено(КонтактыАдминистратора_Телефоны) И ИспользоватьОтправкуВТелеграм Тогда
			Телефоны = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(КонтактыАдминистратора_Телефоны, ";", Ложь);
			Для Каждого ТекущееУведомление Из НовыеУведомления Цикл
				ПоставитьСообщениеВОчередьНаОтправкуВТелеграм(Телефоны, ТекущееУведомление);
			КонецЦикла;
		КонецЕсли;
		
		// Электронные адреса
		КонтактыАдминистратора_Адреса = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("КонтактыАдминистратора_АдресаЭлектронныхПочт");
		ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
		Если ЗначениеЗаполнено(КонтактыАдминистратора_Адреса) И ИспользоватьОтправкуНаПочту Тогда
			Адреса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(КонтактыАдминистратора_Адреса, ";", Ложь);
			Для Каждого ТекущееУведомление Из НовыеУведомления Цикл
				ОтправитьСообщениеНаАдресЭлектроннойПочты(Адреса, ТекущееУведомление);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаОбновленияУведомлений()
	
	Возврат
	"ВЫБРАТЬ
	|	ИДВходящихУведомлений.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВходящиеИдентификаторы
	|ИЗ
	|	&ИДВходящихУведомлений КАК ИДВходящихУведомлений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВходящиеИдентификаторы.Идентификатор КАК Идентификатор,
	|	ЕСТЬNULL(КонтурЛогистика_УведомленияПродукта.Ссылка, ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_УведомленияПродукта.ПустаяСсылка)) КАК Уведомление
	|ПОМЕСТИТЬ ВходящиеУведомления
	|ИЗ
	|	ВходящиеИдентификаторы КАК ВходящиеИдентификаторы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_УведомленияПродукта КАК КонтурЛогистика_УведомленияПродукта
	|		ПО ВходящиеИдентификаторы.Идентификатор = КонтурЛогистика_УведомленияПродукта.Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВходящиеУведомления.Идентификатор КАК Идентификатор
	|ИЗ
	|	ВходящиеУведомления КАК ВходящиеУведомления
	|ГДЕ
	|	ВходящиеУведомления.Уведомление = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_УведомленияПродукта.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_УведомленияПродукта.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_УведомленияПродукта КАК КонтурЛогистика_УведомленияПродукта
	|ГДЕ
	|	НЕ КонтурЛогистика_УведомленияПродукта.Идентификатор В
	|				(ВЫБРАТЬ
	|					ВходящиеИдентификаторы.Идентификатор КАК Идентификатор
	|				ИЗ
	|					ВходящиеИдентификаторы КАК ВходящиеИдентификаторы)";
	
КонецФункции

Функция ТекстЗапросаУведомленийПользователя()
	
	Возврат
	"ВЫБРАТЬ
	|	КонтурЛогистика_УведомленияПродукта.Ссылка КАК Ссылка,
	|	МАКСИМУМ(КонтурЛогистика_УведомленияПродукта.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ УведомленияПродуктаПоИмениФормы
	|ИЗ
	|	Справочник.КонтурЛогистика_УведомленияПродукта КАК КонтурЛогистика_УведомленияПродукта
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_УведомленияПродукта.ИменаФорм КАК КонтурЛогистика_УведомленияПродуктаИменаФорм
	|		ПО (КонтурЛогистика_УведомленияПродуктаИменаФорм.Ссылка = КонтурЛогистика_УведомленияПродукта.Ссылка)
	|ГДЕ
	|	НЕ КонтурЛогистика_УведомленияПродукта.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_УведомленияПродукта.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КонтурЛогистика_УведомленияПродукта.ДатаНачала <= &ТекущаяДата
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_УведомленияПродукта.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КонтурЛогистика_УведомленияПродукта.ДатаОкончания >= &ТекущаяДата
	|		КОНЕЦ
	|	И (НЕ &ЕстьОтборПоИмениФормы
	|				И НЕ КонтурЛогистика_УведомленияПродукта.Ссылка В
	|						(ВЫБРАТЬ
	|							УведомленияПродуктаИменаФорм.Ссылка КАК Уведомление
	|						ИЗ
	|							Справочник.КонтурЛогистика_УведомленияПродукта.ИменаФорм КАК УведомленияПродуктаИменаФорм)
	|			ИЛИ &ЕстьОтборПоИмениФормы
	|				И КонтурЛогистика_УведомленияПродуктаИменаФорм.ИмяФормы = &ИмяФормы)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_УведомленияПродукта.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_УведомленияПродукта.Ссылка КАК Уведомление,
	|	КонтурЛогистика_УведомленияПродукта.Приоритет КАК Приоритет,
	|	ЕСТЬNULL(КонтурЛогистика_УведомленияПользователя.Прочитано, ЛОЖЬ) КАК Прочитано
	|ПОМЕСТИТЬ УведомленияПродукта
	|ИЗ
	|	УведомленияПродуктаПоИмениФормы КАК КонтурЛогистика_УведомленияПродукта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_УведомленияПользователя КАК КонтурЛогистика_УведомленияПользователя
	|		ПО КонтурЛогистика_УведомленияПродукта.Ссылка = КонтурЛогистика_УведомленияПользователя.Уведомление
	|			И (КонтурЛогистика_УведомленияПользователя.Пользователь1С = &ТекущийПользователь)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
КонецФункции

Функция ТекстЗапросаНеПрочитанныхУведомленийПользователя()
	
	Возврат ТекстЗапросаУведомленийПользователя() +
	"ВЫБРАТЬ
	|	УведомленияПродукта.Уведомление КАК Уведомление,
	|	УведомленияПродукта.Приоритет КАК Приоритет
	|ИЗ
	|	УведомленияПродукта КАК УведомленияПродукта
	|ГДЕ
	|	НЕ УведомленияПродукта.Прочитано";
	
КонецФункции

Функция ТекстЗапросаПоказаУведомленийПользователя() Экспорт
	
	Возврат ТекстЗапросаУведомленийПользователя() +
	"ВЫБРАТЬ
	|	УведомленияПродукта.Уведомление КАК Уведомление,
	|	УведомленияПродукта.Уведомление.Наименование КАК Заголовок,
	|	УведомленияПродукта.Уведомление.ДатаНачала КАК ДатаНачала,
	|	УведомленияПродукта.Уведомление.ДатаОкончания КАК ДатаОкончания,
	|	УведомленияПродукта.Уведомление.Текст КАК Текст,
	|	ЕСТЬNULL(УведомленияПродукта.Прочитано, ЛОЖЬ) КАК Прочитано,
	|	ВЫБОР
	|		КОГДА УведомленияПродукта.Уведомление.Приоритет = ""high""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Важное,
	|	УведомленияПродукта.Уведомление.Идентификатор КАК Идентификатор,
	|	УведомленияПродукта.Уведомление.ТипКонтента КАК ТипКонтента
	|ИЗ
	|	УведомленияПродукта КАК УведомленияПродукта";
	
КонецФункции

Процедура ПоставитьСообщениеВОчередьНаОтправкуВТелеграм(ТелефоныДляОтправки, Уведомление)
	
	ТекстЗаголовка = "<b>" + Уведомление.Наименование + "</b>
		|
		|Получение новостных сообщений можно отключить в модуле 1С Контур.Логистика в основных настройках ""Контакты администратора"".";
	
	Если Найти(Уведомление.Текст, "<html") = 0 Тогда
		ТекстСообщения = ОбернутьТекстУведомленияВHTML(Уведомление.Текст);
	Иначе
		ТекстСообщения = Уведомление.Текст;
	КонецЕсли;
	
	ПотокДанных = Новый ПотокВПамяти();
	ЗаписьТекста = Новый ЗаписьТекста(ПотокДанных);
	ЗаписьТекста.Записать(ТекстСообщения);
	ЗаписьТекста.Закрыть();
	
	ДвоичныеДанные = ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();
	
	НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
	НовоеСообщение.Тип = "document";
	НовоеСообщение.Заголовок = ТекстЗаголовка;
	НовоеСообщение.ИмяФайла = "Подробнее.html";
	НовоеСообщение.Данные = ДвоичныеДанные;
	
	Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовоеСообщение);
	
	Для Каждого Телефон Из ТелефоныДляОтправки Цикл
		РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(Телефон, Сообщения);
	КонецЦикла;
	
	РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ОтправитьСообщения(ТелефоныДляОтправки);
	
КонецПроцедуры

Процедура ОтправитьСообщениеНаАдресЭлектроннойПочты(АдресЭлектроннойПочты, Уведомление)
	
	ТекстЗаголовка = Уведомление.Наименование;
	
	Если Найти(Уведомление.Текст, "<html") = 0 Тогда
		ТекстСообщения = ОбернутьТекстУведомленияВHTML(Уведомление.Текст);
	Иначе
		ТекстСообщения = Уведомление.Текст;
	КонецЕсли;
	
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = ТекстЗаголовка;
	Письмо.Тексты.Добавить(ТекстСообщения, ТипТекстаПочтовогоСообщения.HTML);
	
	Для Каждого Получатель Из АдресЭлектроннойПочты Цикл
		Письмо.Получатели.Добавить(Получатель);
	КонецЦикла;
	
	Попытка
		КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
	Исключение
		
		ТекстОшибкиОтправкиПочты = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации("КонтурЛогистика_ОбновлениеСервер_ОтправитьСообщениеНаАдресЭлектроннойПочты",
			УровеньЖурналаРегистрации.Ошибка,, Уведомление, ТекстОшибкиОтправкиПочты);
		
	КонецПопытки;
	
КонецПроцедуры

