Процедура ПолучитьСведенияОбОбновлении(НомерВерсии, АдресРезультата, ИмяРасширения = "") Экспорт
	
	СтруктураОбновленияВерсии = ПодготовитьСтруктуруОбновленияВерсии();
	
	ИмяПродукта = ИмяПродукта(ИмяРасширения);
	Ответ = СерверОбновлений_ПроверитьНовуюВерсию(НомерВерсии, ИмяПродукта);
	
	Если Ответ.Успешно Тогда
		
		УдалосьРаспарситьОтвет = Ложь;
		
		Попытка
			ДанныеОбновления = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
			УдалосьРаспарситьОтвет = Истина;
		Исключение
			СтруктураОбновленияВерсии.Ошибка = ОписаниеОшибки();
		КонецПопытки;
		
		Если Не УдалосьРаспарситьОтвет Тогда
			ПоместитьВоВременноеХранилище(СтруктураОбновленияВерсии, АдресРезультата);
		КонецЕсли;
		
		СтруктураОбновленияВерсии.Успешно = Истина;
		СтруктураОбновленияВерсии.НомерВерсии = ДанныеОбновления.name;
		СтруктураОбновленияВерсии.ЕстьОбновление = ДанныеОбновления.contain_update;
		
		Если СтруктураОбновленияВерсии.ЕстьОбновление Тогда
			
			СтруктураОбновленияВерсии.ДатаВыхода = ДанныеОбновления.release_date;
			
			Если ЗначениеЗаполнено(ДанныеОбновления.description) Тогда
				Попытка
					ОписаниеСтруктура = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(ДанныеОбновления.description);
				Исключение
					ОписаниеСтруктура = Неопределено;
				КонецПопытки;
				
				Если ТипЗнч(ОписаниеСтруктура) = Тип("Структура") Тогда
					СтруктураОбновленияВерсии.СсылкаНаОписание = ОписаниеСтруктура.link;
					СтруктураОбновленияВерсии.КраткоеОписание = СтрЗаменить(ОписаниеСтруктура.description, "\n", Символы.ПС);
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого СсылкаНаКонтент Из ДанныеОбновления.links Цикл
				
				Если СсылкаНаКонтент.content_type = "zip"
					Или (ЗначениеЗаполнено(ИмяРасширения)
						И СсылкаНаКонтент.content_type = "extension") Тогда
					
					СтруктураОбновленияВерсии.СсылкаНаЗагрузку = СсылкаНаКонтент.href;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		СтруктураОбновленияВерсии.Ошибка = Ответ.Ошибка;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(СтруктураОбновленияВерсии, АдресРезультата);
	
КонецПроцедуры

Функция ПолучитьСведенияОбПараметрахПодключенияSentry() Экспорт
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияSentry.НовыйПараметрыСервиса();
	
	ИмяПродукта = БазовоеИмяПродукта();
	
	ОтправлятьМетрикиВТест = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОтправлятьМетрикиВТест");
	ИспользоватьТестовыйСерверДиадок = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	Если ИспользоватьТестовыйСерверДиадок Или ОтправлятьМетрикиВТест Тогда
		АдресСервера = АдресТестовогоСервераОбновлений();
	Иначе
		АдресСервера = АдресПродуктивногоСервераОбновлений();
	КонецЕсли;
	
	АдресМетода = АдресСервера + "/1c/v2/" + ИмяПродукта + "/check/1";
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	Ответ = ВыполнитьHTTPЗапрос_СерверОбновлений(АдресМетода, ПараметрыЗапроса, Истина);
	
	Если Ответ.Успешно Тогда
		
		Попытка
			
			ДанныеОбновления = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
			
			ОписаниеСтруктура = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(ДанныеОбновления.description);
			
			Если ТипЗнч(ОписаниеСтруктура) = Тип("Структура") И ОписаниеСтруктура.Свойство("sentry") Тогда
				ЗаполнитьЗначенияСвойств(ПараметрыСервиса, ОписаниеСтруктура.sentry);
			КонецЕсли;
			
		Исключение
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при получении данных из сервиса обновления.
				|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ПараметрыСервиса;
	
КонецФункции

Процедура ПолучитьИсториюВерсий(КоличествоВерсий, АдресРезультата) Экспорт
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Успешно", Ложь);
	СтруктураРезультата.Вставить("Ошибка", "");
	СтруктураРезультата.Вставить("ТаблицаИсторииВерсий", Неопределено);
	
	ИмяПродукта = ИмяПродукта();
	Ответ = СерверОбновлений_ПолучитьИсториюВерсий(ИмяПродукта, КоличествоВерсий);
	
	Если Ответ.Успешно Тогда
		
		УдалосьРаспарситьОтвет = Ложь;
		
		Попытка
			СписокВерсийСтруктура = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
			УдалосьРаспарситьОтвет = Истина;
		Исключение
			СтруктураРезультата.Ошибка = ОписаниеОшибки();
		КонецПопытки;

		Если Не УдалосьРаспарситьОтвет Тогда
			ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
		КонецЕсли;
		
		ТаблицаИсторииВерсий = ПодготовитьТаблицуИсторииВерсий();
		
		Для Каждого Версия Из СписокВерсийСтруктура.versions Цикл
			
			Если Не ЗначениеЗаполнено(Версия.release_date) Тогда
				Продолжить;
			КонецЕсли;
			
			ВерсияМассивом = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(Версия.version, ".");
			
			СтрокаТаблицы = ТаблицаИсторииВерсий.Добавить();
			СтрокаТаблицы.НомерВерсии = Версия.version;
			СтрокаТаблицы.БазоваяВерсия = ВерсияМассивом[0] + "." + ВерсияМассивом[1];
			СтрокаТаблицы.ВерсияПатча = Число(ВерсияМассивом[2]);
			СтрокаТаблицы.ДатаВыхода = Версия.release_date;
			
			Попытка
				ОписаниеСтруктура = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Версия.description);
			Исключение
				ОписаниеСтруктура = Неопределено;
			КонецПопытки;
			
			Если ТипЗнч(ОписаниеСтруктура) = Тип("Структура") Тогда
				СтрокаТаблицы.СсылкаНаОписание = ОписаниеСтруктура.link;
				СтрокаТаблицы.КраткоеОписание = СтрЗаменить(ОписаниеСтруктура.description, "\n", Символы.ПС);
			КонецЕсли;
			
			Для Каждого СсылкаНаКонтент Из Версия.links Цикл
				Если СсылкаНаКонтент.content_type = "zip" Тогда
					СтрокаТаблицы.СсылкаНаЗагрузку = СсылкаНаКонтент.href;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		СтруктураРезультата.Успешно = Истина;
		СтруктураРезультата.ТаблицаИсторииВерсий = ТаблицаИсторииВерсий;
		
	Иначе
		СтруктураРезультата.Ошибка = Ответ.Ошибка;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
	
КонецПроцедуры

Функция ЗагрузитьДанные(СсылкаНаЗагрузку, АдресРезультата = Неопределено) Экспорт

	Ответ = СерверОбновлений_ЗагрузитьКонтент(СсылкаНаЗагрузку);

	Если Ответ.Успешно Тогда

		ДвоичныеДанныеОтвет = Ответ.ТелоОтвета;

		Если НЕ АдресРезультата = Неопределено Тогда

			ПоместитьВоВременноеХранилище(ДвоичныеДанныеОтвет, АдресРезультата);
			
		Иначе
			
			Возврат ДвоичныеДанныеОтвет;

		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение Ответ.Ошибка;
		
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ХэшСуммаТекущегоРасширенияИЭталонногоОдинаковы(НомерВерсии) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ХэшСуммыОдинаковы", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	
	Ответ = СерверОбновлений_СодержимоеВерсии(НомерВерсии);
	
	Если Не Ответ.Успешно Тогда
		Результат.ТекстОшибки = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДанныеВерсии = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	// Получим хэш сумму исходного расширения
	ХэшСуммаЭталона = "";
	СписокКонтента = ДанныеВерсии.contents;
	Для Каждого ТекущаяСтрока Из СписокКонтента Цикл
		Если ТекущаяСтрока.name <> "zip" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("src_checksum")
			И ЗначениеЗаполнено(ТекущаяСтрока.src_checksum) Тогда
			
			ХэшСуммаЭталона = ТекущаяСтрока.src_checksum;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Получим хэш сумму установленного расширения
	ОтборРасширения = Новый Структура("Имя", "РасширениеКонтурЛогистика");
	НайденныеРасширения = РасширенияКонфигурации.Получить(ОтборРасширения);
	Если НайденныеРасширения.Количество() = 0 Тогда
		Результат.ТекстОшибки = "Не удалось найти текущее расширение.";
		Возврат Результат;
	КонецЕсли;
	ХэшСуммаУстановленного = Base64Строка(НайденныеРасширения[0].ХешСумма);
	
	// Сравним хэш суммы
	Если ХэшСуммаЭталона = ХэшСуммаУстановленного Тогда
		Результат.ХэшСуммыОдинаковы = Истина;
	КонецЕсли;
	
	Результат.Успешно = Истина;
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьУведомленияИзСервиса(УчитыватьПоследнююДатуПолучения) Экспорт
	
	API_Логин = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЛогинАвторизацииДиадокАПИ");
	Если Не ЗначениеЗаполнено(API_Логин) Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСВнешнимиРесурсамиЗаблокирована = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ПараметрыБлокировки_РаботаСВнешнимиРесурсамиЗаблокирована");
	Если РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат;
	КонецЕсли;
	
	Если УчитыватьПоследнююДатуПолучения Тогда
		// Проверим дату последнего получения
		ПоследняяДатаПолученияУведомлений = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПоследняяДатаПолученияУведомлений");
		ЧасВСекундах = 60 * 60;
		
		Если ЗначениеЗаполнено(ПоследняяДатаПолученияУведомлений)
			И ПоследняяДатаПолученияУведомлений + ЧасВСекундах >= ТекущаяДатаСеанса() Тогда
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СерверОбновлений_СписокУведомлений();
	
	КонтурЛогистика_Привилегированный.УстановитьНастройку("ПоследняяДатаПолученияУведомлений", ТекущаяДатаСеанса());
	
КонецПроцедуры

Функция СостоянияУведомленийПользователя(ИмяФормы = Неопределено) Экспорт
	
	СостоянияУведомлений = Новый Структура;
	СостоянияУведомлений.Вставить("ВсегоУведомлений", 0);
	СостоянияУведомлений.Вставить("ВажныхУведомлений", 0);
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ЕстьОтборПоИмениФормы", ЗначениеЗаполнено(ИмяФормы));
	Запрос.УстановитьПараметр("ИмяФормы", ИмяФормы);
	
	Запрос.Текст = ТекстЗапросаНеПрочитанныхУведомленийПользователя();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СостоянияУведомлений.ВсегоУведомлений = СостоянияУведомлений.ВсегоУведомлений + 1;
		Если Выборка.Приоритет = "high" Тогда
			СостоянияУведомлений.ВажныхУведомлений = СостоянияУведомлений.ВажныхУведомлений + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СостоянияУведомлений;
	
КонецФункции

Функция ОбернутьТекстУведомленияВHTML(Текст) Экспорт
	
	Шаблон =
	"<!DOCTYPE html>
	|<html dir=""ltr"">
	|<head>
	|<meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" />
	|<meta http-equiv=""X-UA-Compatible"" content=""IE=Edge"" />
	|<meta name=""format-detection"" content=""telephone=no"" />
	|<style type=""text/css"">
	|body{margin:0;padding:8px;}
	|p{line-height:1.15;margin:0;white-space:pre-wrap;}
	|ol,ul{margin-top:0;margin-bottom:0;}
	|img{border:none;}
	|li>p{display:inline;}
	|</style>
	|</head>
	|<body>
	|<p>&Текст</p>
	|</body>
	|</html>";
	
	Возврат СтрЗаменить(Шаблон, "&Текст", Текст);
	
КонецФункции

// Получает функциональные опции с сервера обновлений и преобразует их в соответствие "ключ → значение".
//
// Функция выполняет HTTP-запрос к серверу обновлений, получает JSON-ответ,
// десериализует его и формирует структуру данных для удобного использования.
// При возникновении ошибок на любом этапе (запрос, разбор JSON) регистрируется
// диагностическое событие и возвращается пустое соответствие.
//
// Параметры отсутствуют.
//
// Возвращаемое значение:
//   Соответствие - коллекция вида { "ИмяОпции" => "ЗначениеОпции", ... }.
//   В случае ошибки - пустое соответствие (Новый Соответствие).
//
Функция ФункциональныеОпции() Экспорт
	
	Попытка
		Ответ = СерверОбновлений_ФункциональныеОпции();
	Исключение
		
		ТекстОшибки = "Не удалось получить функциональные опции.";
		КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистикаФункциональныеОпции", ИнформацияОбОшибке(), , , ТекстОшибки);
		
		Возврат Новый Соответствие;
	КонецПопытки;
	
	Попытка
		МассивОпций = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
	Исключение
		
		ТекстОшибки = "Не удалось разобрать список функциональных опций.";
		КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистикаФункциональныеОпции", ИнформацияОбОшибке(), , , ТекстОшибки);
		
		Возврат Новый Соответствие;
		
	КонецПопытки;
	
	Результат = Новый Соответствие;
	
	Для Каждого СтруктураЗначения Из МассивОпций Цикл
		
		Результат.Вставить(СтруктураЗначения.feature, СтруктураЗначения.value); 
		
	КонецЦикла;
	
	Возврат Результат;			
		
КонецФункции

#Область ОбновлениеДопРасширений

Функция ПроверитьОбновления(Адрес, ВидРасширения = "", УникальныйИдентификатор, ПринудительнаяПроверка = Ложь) Экспорт
	
	Если ПринудительнаяПроверка Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Если НЕ ПравоДоступа("АдминистрированиеРасширенийКонфигурации",Метаданные) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	ОтборРасширения = Новый Структура;
	Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
		ОтборРасширения.Вставить("Имя", КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСервер.ИмяДополнительногоРасширенияДополнительныеРеквизитыПоИмениКонфигурации(
			ИмяКонфигурации1С));
	ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
		ОтборРасширения.Вставить("Имя", "РасширениеКонтурЛогистика_QR_МП_УАТ");
	Иначе
		ОтборРасширения.Вставить("Имя", КонтурЛогистика_ИнтеграцияТиповыеСервер.ИмяДополнительногоРасширенияПоИмениКонфигурации(
			ИмяКонфигурации1С));
	КонецЕсли;
	
	НайденныеРасширения = РасширенияКонфигурации.Получить(ОтборРасширения);
	
	Если ВидРасширения = "QR_МП_УАТ" И НайденныеРасширения.Количество() = 0 Тогда
		ОтборРасширения.Вставить("Имя", "РасширениеКонтурЛогистика_QR_МП_УАТ_33");
		НайденныеРасширения = РасширенияКонфигурации.Получить(ОтборРасширения);
	КонецЕсли;
	
	Если НайденныеРасширения.Количество() = 0 Тогда
		ТекущаяВерсияДополнительногоРасширения = "0.0.0";
	ИначеЕсли ВидРасширения = "QR_МП_УАТ" И КонтурЛогистика_ОбновлениеСерверПовтИсп.ТребуетсяОбновление_НоваяВерсияУАТ_QR_МП_УАТ() Тогда
		// Расширение для нового УАТ находится в пакете обновления той же версии, эта версия может быть уже установлена
		ТекущаяВерсияДополнительногоРасширения = "0.0.0";
	Иначе
		ТекущаяВерсияДополнительногоРасширения = НайденныеРасширения[0].Версия;
	КонецЕсли;
		
	Адрес = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("НомерВерсии", ТекущаяВерсияДополнительногоРасширения);
	
	Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
		ПараметрыФоновогоЗадания.Вставить("ИмяРасширения", "ДополнительныеРеквизитыРасширение");
	ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
		ПараметрыФоновогоЗадания.Вставить("ИмяРасширения", "QR_МП_УАТ_Расширение");
	Иначе
		ПараметрыФоновогоЗадания.Вставить("ИмяРасширения", "ДополнительноеРасширение");
	КонецЕсли;
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьВФоне(
		"КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьСведенияОбОбновлении",
		ПараметрыФоновогоЗадания,, "Получение сведений о последней версии", Адрес);
	
	Возврат РезультатЗапуска;
	
КонецФункции

Функция УстановитьОбновление(Адрес, ИмяКонфигурации1С, ВидРасширения = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
		
	ДвоичныеДанныеОтвет = ПолучитьИзВременногоХранилища(Адрес);
	
	Если ДвоичныеДанныеОтвет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		// Получим старую версию
		Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
			ИмяРасширения = КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСервер.ИмяДополнительногоРасширенияДополнительныеРеквизитыПоИмениКонфигурации(ИмяКонфигурации1С);	
		ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
			ИмяРасширения = "РасширениеКонтурЛогистика_QR_МП_УАТ";
		Иначе
			ИмяРасширения = КонтурЛогистика_ИнтеграцияТиповыеСервер.ИмяДополнительногоРасширенияПоИмениКонфигурации(ИмяКонфигурации1С);
		КонецЕсли;
		ОтборРасширения = Новый Структура;
		ОтборРасширения.Вставить("Имя", ИмяРасширения);
		
		НайденныеРасширения = РасширенияКонфигурации.Получить(ОтборРасширения);
		
		Если ВидРасширения = "QR_МП_УАТ" И НайденныеРасширения.Количество() = 0 Тогда
			ОтборРасширения.Вставить("Имя", "РасширениеКонтурЛогистика_QR_МП_УАТ_33");
			НайденныеРасширения = РасширенияКонфигурации.Получить(ОтборРасширения);
		КонецЕсли;
		
		Если НайденныеРасширения.Количество() = 0 Тогда
			ТекущееРасширение = РасширенияКонфигурации.Создать();
		Иначе
			ТекущееРасширение = НайденныеРасширения[0];
		КонецЕсли;
		
		Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
			
			ДвоичныеДанныеФайла = ДвоичныеДанныеОтвет;
			
		ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
			
			Если КонтурЛогистика_ОбновлениеСерверПовтИсп.ТребуетсяОбновление_НоваяВерсияУАТ_QR_МП_УАТ()
				И  ТекущееРасширение.Имя = "РасширениеКонтурЛогистика_QR_МП_УАТ_33" Тогда
				
				ТекущееРасширение.Удалить();
				ТекущееРасширение = РасширенияКонфигурации.Создать();
				
			КонецЕсли;
			
			Если КонтурЛогистика_ОбновлениеСерверПовтИсп.НоваяВерсияУАТ_QR_МП_УАТ(ИмяКонфигурации1С) Тогда
				ИмяФайлаРасширения = "РасширениеКонтурЛогистика_QR_МП_УАТ.cfe";
			Иначе
				ИмяФайлаРасширения = "РасширениеКонтурЛогистика_QR_МП_УАТ_33.cfe";
			КонецЕсли;
			
			ДвоичныеДанныеФайла = РазархивироватьПолученныйПакетОбновления(ДвоичныеДанныеОтвет, ИмяФайлаРасширения);
						
		Иначе
			
			Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ВерсияСтандартнойПодсистемыВыше_3_1_8() Тогда
				ИмяФайлаРасширения = "РасширениеКонтурЛогистика_Дополнение.cfe";
			Иначе
				ИмяФайлаРасширения = "РасширениеКонтурЛогистика_Дополнение_ДоБСП_3_1_8.cfe";
			КонецЕсли;
			
			ДвоичныеДанныеФайла = РазархивироватьПолученныйПакетОбновления(ДвоичныеДанныеОтвет, ИмяФайлаРасширения);
			
		КонецЕсли;
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Проверим возможность применения
		ИтогиПроверки = ТекущееРасширение.ПроверитьВозможностьПрименения(ДвоичныеДанныеФайла);
		Если ИтогиПроверки.Количество() <> 0 Тогда
			Сообщить("Проблемы применения расширения:");
			Для Каждого ТекущийИтог Из ИтогиПроверки Цикл
				Сообщить("- " + ТекущийИтог.Описание);
			КонецЦикла;
			
			Возврат Ложь;
		КонецЕсли;
		
		// Запишем расширение
		ТекущееРасширение.БезопасныйРежим = Ложь;
		ТекущееРасширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		ТекущееРасширение.Записать(ДвоичныеДанныеФайла);
		
	Исключение
		ТекстОшибки = "Не удалось обновить расширение по причине:
			|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция РазархивироватьПолученныйПакетОбновления(ДвоичныеДанныеОтвет, ИмяФайлаРасширения) 
	
	ДвоичныеДанныеФайла = Неопределено;
	
	// Разархивируем полученный пакет
	ЧтениеДанныхАрхив = Новый ЧтениеДанных(ДвоичныеДанныеОтвет);
	ПапкаДляРаспаковки = КаталогВременныхФайлов() + "KonturLogist";
	
	ЧтениеZIP = Новый ЧтениеZIPФайла(ЧтениеДанныхАрхив.ИсходныйПоток());
	ЧтениеZIP.ИзвлечьВсе(ПапкаДляРаспаковки);
	ЧтениеZIP.Закрыть();
				
	// Ищем в файлах расширение
	ФайлыЭД = НайтиФайлы(ПапкаДляРаспаковки, ИмяФайлаРасширения);
	Если ФайлыЭД.Количество() > 0 Тогда
		ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлыЭД[0].ПолноеИмя);
	Иначе
		Сообщить("Ошибка при распаковке ответа сервиса обновлений Контур");		
	КонецЕсли;
	
	// Подчищаем следы
	Попытка
		Выполнить("ФайловаяСистема.УдалитьВременныйКаталог(ПапкаДляРаспаковки)");
	Исключение
		// Ничего не делаем, если не удалось удалить временные файлы.
	КонецПопытки;
	
	Возврат ДвоичныеДанныеФайла;
	
КонецФункции

#КонецОбласти

#Область Документация

Функция ПолучитьОнбординг(ИдентификаторОнбординга) Экспорт
	
	ВерсияПодсистемы = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	ИмяПродукта = "logist_onboarding";
	
	Попытка
		Ответ = СерверОбновлений_ПолучитьИсториюВерсий(ИмяПродукта);
	Исключение
		
		ТекстОшибки = "Не удалось получить историю версий.
		|Ошибка: " + ОписаниеОшибки();
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
		Возврат Неопределено;
	КонецПопытки;
	
	Попытка
		СписокВерсийСтруктура = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
	Исключение
		
		ТекстОшибки = "Не удалось разобрать историю версий.
		|Ошибка: " + ОписаниеОшибки();
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
		Возврат Неопределено;
	КонецПопытки;
	
	Для Каждого Версия Из СписокВерсийСтруктура.versions Цикл
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПодсистемы, Версия.version) < 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Контент Из Версия.links Цикл
			
			Если Контент.content_type <> ИдентификаторОнбординга Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				ДвоичныеДанныеОтвет = ЗагрузитьДанные(Контент.href);
			Исключение
				
				ТекстОшибки = "Не удалось скачать данные версии.
				|Ошибка: " + ОписаниеОшибки();
				
				ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
				
				Возврат Неопределено;
			КонецПопытки;
			
			Попытка
				Результат = ПолучитьМиниТурОнбординга(ДвоичныеДанныеОтвет, ИдентификаторОнбординга);
				Возврат Результат;
			Исключение
				
				ТекстОшибки = "Не удалось прочитать данные по онбордингу.
				|Ошибка: " + ОписаниеОшибки();
				
				ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
				
				Возврат Неопределено;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;

	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьМиниТурОнбординга(ДвоичныеДанные, ИдентификаторОнбординга)
	
	ЧтениеДанныхАрхив = Новый ЧтениеДанных(ДвоичныеДанные);
	ПапкаДляРаспаковки = КаталогВременныхФайлов() + "KonturLogist";
	
	ЧтениеZIP = Новый ЧтениеZIPФайла(ЧтениеДанныхАрхив.ИсходныйПоток());
	ЧтениеZIP.ИзвлечьВсе(ПапкаДляРаспаковки);
	ЧтениеZIP.Закрыть();
	
	НайденныеФайлы = НайтиФайлы(ПапкаДляРаспаковки + "\" + ИдентификаторОнбординга, "*.*");
	
	Результат = Новый Массив;
	
	Номер = 1;
	
	Пока Истина Цикл
		
		ИмяФайла = ПапкаДляРаспаковки + "\" + ИдентификаторОнбординга + "\" + Номер + ".html";
		
		МойФайл = Новый Файл(ИмяФайла);
		
		Если НЕ МойФайл.Существует() Тогда 
			Прервать;
		КонецЕсли;
		
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.Прочитать(МойФайл.ПолноеИмя, КодировкаТекста.UTF8);
		
		Результат.Добавить(ТекстовыйФайл.ПолучитьТекст());
		
		Номер = Номер + 1;
		
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		
		НайденныеФайлы = НайтиФайлы(ПапкаДляРаспаковки + "\" + ИдентификаторОнбординга, "*.*");
		
		Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
			ТекстовыйФайл = Новый ТекстовыйДокумент;
			ТекстовыйФайл.Прочитать(НайденныйФайл.ПолноеИмя, КодировкаТекста.UTF8);
			
			Результат.Добавить(ТекстовыйФайл.ПолучитьТекст());
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		Выполнить("ФайловаяСистема.УдалитьВременныйКаталог(ПапкаДляРаспаковки)");
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДокументацию(ИмяФайла, ТолькоСодержимое = Истина) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Содержимое", "");
	Результат.Вставить("Ошибка", "");
	
	// Получим последнюю версию
	Ответ = СерверОбновлений_ПроверитьНовуюВерсию("1", "logist_docs");
	Если Ответ.Успешно Тогда
		
		ДвоичныеДанныеОтвет = Неопределено;
		
		Попытка
			ДанныеОбновления = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
		Исключение
			Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;
		
		Для Каждого СсылкаНаКонтент Из ДанныеОбновления.links Цикл
			
			Если СсылкаНаКонтент.content_type <> "zip" Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				// Загрузим контент
				ДвоичныеДанныеОтвет = ЗагрузитьДанные(СсылкаНаКонтент.href);
				Прервать;
			Исключение
				Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат Результат;
			КонецПопытки;
			
		КонецЦикла;
		
		Если ДвоичныеДанныеОтвет = Неопределено Тогда
			Результат.Ошибка = "Не удалось получить двоичные данныее";
			Возврат Результат;
		КонецЕсли;
		
		Результат.Успех = Истина;
		Результат.Содержимое = РазархивироватьПолученныйПакетДокументации(ДвоичныеДанныеОтвет, ИмяФайла, ТолькоСодержимое);
		
	Иначе
		
		Результат.Ошибка = Ответ.Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазархивироватьПолученныйПакетДокументации(ДвоичныеДанныеОтвет, ИмяФайла, ТолькоСодержимое)
	
	// Разархивируем полученный пакет
	ЧтениеДанныхАрхив = Новый ЧтениеДанных(ДвоичныеДанныеОтвет);
	ПапкаДляРаспаковки = КаталогВременныхФайлов() + "KonturLogist";
	
	ЧтениеZIP = Новый ЧтениеZIPФайла(ЧтениеДанныхАрхив.ИсходныйПоток());
	ЧтениеZIP.ИзвлечьВсе(ПапкаДляРаспаковки);
	ЧтениеZIP.Закрыть();
	
	// Ищем в файлах нужный
	ПолноеИмяФайлаВПакете = "";
	ФайлыЭД = НайтиФайлы(ПапкаДляРаспаковки, ИмяФайла);
	Если ФайлыЭД.Количество() > 0 Тогда
		ПолноеИмяФайлаВПакете = ФайлыЭД[0].ПолноеИмя;
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если ТолькоСодержимое Тогда
		
		// Получим содержимое
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.Прочитать(ПолноеИмяФайлаВПакете, КодировкаТекста.UTF8);
		
		Результат = ТекстовыйФайл.ПолучитьТекст();
		
		ТекстовыйФайл = Неопределено;
		
	Иначе
		
		Результат = Новый ДвоичныеДанные(ПолноеИмяФайлаВПакете);
		
	КонецЕсли;
	
	// Подчищаем следы
	Попытка
		Выполнить("ФайловаяСистема.УдалитьВременныйКаталог(ПапкаДляРаспаковки)");
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

