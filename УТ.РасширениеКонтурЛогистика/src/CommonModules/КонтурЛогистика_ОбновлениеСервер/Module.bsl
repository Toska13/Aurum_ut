Процедура СерверОбновлений_СписокУведомлений()
	
	АдресМетода = "/1c/v4/logist/notifications";
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Метод = "POST";
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ФильтрОтбораУведомлений = КонтурЛогистика_ОбновлениеСерверПовтИсп.ФильтрОтбораУведомлений();
	ПараметрыЗапроса.ТелоЗапроса.string = КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(ФильтрОтбораУведомлений);
	
	Ответ = ВыполнитьHTTPЗапрос_СерверОбновлений(АдресМетода, ПараметрыЗапроса);
	
	Если Ответ.Успешно Тогда
		Попытка
			ОбновитьУведомленияПродукта(Ответ.ТелоОтвета);
		Исключение
			КонтурЛогистика_Метрика.ОбработатьОшибку("СерверОбновлений_СписокУведомлений", ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		Если ЗначениеЗаполнено(Ответ.Ошибка) Тогда
			КонтурЛогистика_Метрика.ОбработатьОшибку("СерверОбновлений_СписокУведомлений", Ответ.Ошибка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

