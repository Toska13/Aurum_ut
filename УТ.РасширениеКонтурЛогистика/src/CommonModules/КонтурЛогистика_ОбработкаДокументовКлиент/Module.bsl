Функция ПолучитьНастройкуКонвертации(ТипЛогистическогоДокумента, ДокументОснованиеУчетнойСистемы = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ТипЛогистическогоДокумента) Тогда 
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ТипЛогистическогоДокумента, ДокументОснованиеУчетнойСистемы)
	Иначе
		НастройкаКонвертации = Неопределено;
	КонецЕсли;

	Возврат НастройкаКонвертации;
	
КонецФункции

Процедура ОткрытьНастройкуКонвертации(ТипЛогистическогоДокумента, ДокументОснованиеУчетнойСистемы) Экспорт

	Если (ТипЛогистическогоДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
		Или ТипЛогистическогоДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1"))
		И ДокументОснованиеУчетнойСистемы = Неопределено Тогда 
		
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(ТипЛогистическогоДокумента);
		
		Если НастройкаКонвертации = Неопределено Тогда // возможно документа основания нет по причине того что это обработка входящего
			НастройкаКонвертации = КонтурЛогистика_ОбработкаДокументовКлиент.ПолучитьНастройкуКонвертации(ТипЛогистическогоДокумента, ДокументОснованиеУчетнойСистемы); 
		КонецЕсли;
		
	Иначе
		НастройкаКонвертации = КонтурЛогистика_ОбработкаДокументовКлиент.ПолучитьНастройкуКонвертации(ТипЛогистическогоДокумента, ДокументОснованиеУчетнойСистемы); 
	КонецЕсли;
		
	Если НастройкаКонвертации <> Неопределено Тогда 
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(НастройкаКонвертации);
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не найдена настройка конвертации по: " + ТипЛогистическогоДокумента + " и: " + ДокументОснованиеУчетнойСистемы);
	КонецЕсли;

КонецПроцедуры

Процедура ОткрытьНастройку(ИмяПредопределенного) Экспорт
	
	Настройка 
		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройку_(ИмяПредопределенного);
	ПараметрыФормы = Новый Структура("Ключ", Настройка);
	ОткрытьФорму("Справочник.КонтурЛогистика_Настройки.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

Процедура ОтказатьсяВПодписи(ТитулСылка, Параметры) Экспорт
	
	Если ТипЗнч(ТитулСылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6") Тогда 
		// недоработочка на стороне порядка обмена - действие не описано
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("В порядке обмена законодательно не описаны действия, если послерейсовый медосмотр не пройден. 
		|Мы ожидаем, что в новой редакции порядка обмена случай будет уточнен.",
																	"Сценарий законодательно не определен");
		Возврат;
	КонецЕсли;
	
	
	Если ТипЗнч(Параметры.Источник) = Тип("УправляемаяФорма") Тогда
		Параметры.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	Если ТипЗнч(ТитулСылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5_5_02") Тогда
		
		РезультатВалидации = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьДокумент(ТитулСылка);
		Если РезультатВалидации.КоличествоОшибок > 0  Тогда
			Сообщить("При проверке обнаружены ошибки, подпись невозможна");
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("ТитулСсылка", ТитулСылка);
		ПараметрыОбработчика = Новый Структура("ТитулСсылка, Форма", ТитулСылка, Параметры.Источник);
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ПЛ_Титул5_5_02.Форма.ФормаОтказаВПодписи",
			ПараметрыФормы,,КонтурЛогистика_ОбработкаДокументовКлиент, "ПослеВводаПричиныОтказа", ПараметрыОбработчика);
			
	ИначеЕсли ТипЗнч(ТитулСылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2_5_02")
		Или ТипЗнч(ТитулСылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02") Тогда
		
		ПараметрыФормированияФайлов = Новый Структура("ЭтоОтказ");
		РезультатВалидации = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьДокумент(ТитулСылка, ПараметрыФормированияФайлов);
		Если РезультатВалидации.КоличествоОшибок > 0  Тогда
			Сообщить("При проверке обнаружены ошибки, подпись невозможна");
			Возврат;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводЗначения_КонтурЛогистика(Неопределено, "Укажите причину отказа в подписи", Тип("Строка"), 
			КонтурЛогистика_ОбработкаДокументовКлиент, "ПослеВводаПричиныОтказа", Новый Структура("ТитулСсылка, Форма", ТитулСылка, Параметры.Источник));
			
	Иначе
				
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводЗначения_КонтурЛогистика(
			Неопределено, 
			"Укажите причину отказа в подписи", 
			Тип("Строка"), 
			КонтурЛогистика_ОбработкаДокументовКлиент, 
			"ПослеВводаПричиныОтказа",
			Новый Структура("ТитулСсылка, Форма", ТитулСылка, Параметры.Источник));
			
			
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПослеВводаПричиныОтказа(Результат, ДопПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(Результат) Тогда 
		
		#Если ВебКлиент Тогда
			ПослеВводаПричиныОтказаНаВебКлиенте(Результат, ДопПараметры.ТитулСсылка, ДопПараметры.Форма);	
		#Иначе
			ПослеВводаПричиныОтказаНаКлиенте(Результат, ДопПараметры.ТитулСсылка);	
			
			Если Найти(ДопПараметры.Форма.ИмяФормы, "ФормаДокумента") Тогда 
				ДопПараметры.Форма.Закрыть();
			КонецЕсли;
			
			Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", ДопПараметры.ТитулСсылка);
			Оповестить("КонтурЛогистика_ОбновитьЗадачи");
		#КонецЕсли	
		
	Иначе
		
		ВызватьИсключение "Вы не указали причину отказа";
		
	КонецЕсли;	
	      
КонецПроцедуры

