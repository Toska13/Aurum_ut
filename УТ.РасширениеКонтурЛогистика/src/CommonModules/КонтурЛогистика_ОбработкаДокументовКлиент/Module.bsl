// Вводит документ КонтурЛогистика на основании документа учетной системы и показывает пользователю
//
// Параметры:
//  ТипЛогистика	- ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - какой тип логистического документа будем вводить
//  ДокументСсылка	- ДокументСсылка - исходный документ (например РТУ) на базе которого надо подготовить логистический документ
//  Источник		- Управляемая форма - форма, инициировавшая ввод
//
Процедура ВвестиДокументЛогистикаПоДокументу1С(ТипЛогистика, ДокументСсылка, Источник, ДокументыОснования = Неопределено) Экспорт
	
	Если НЕ КонтурЛогистика_ОбработкаДокументовСервер.ПроверкаПроведенияПройдена(ДокументСсылка, ТипЛогистика) Тогда 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Документ должен быть проведен для отражения в Контур.Логистика";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	МассивУжеВведенныхДокументов = КонтурЛогистика_ОбработкаДокументовСервер.УжеВведенныеДокументыЛогистикаПоДокументу1С(ДокументСсылка, ТипЛогистика);

	
	Если МассивУжеВведенныхДокументов.Количество() = 0 Тогда
		
		Разделители = РассчитатьРазделительДокументаУчетнойСистемы(ТипЛогистика, ДокументСсылка);
		
		Если Разделители = Неопределено ИЛИ Разделители.Количество() < 2 Тогда	// можно открыть форму нового	
			
			ДанныеЗаполнения 	= Новый Структура("ДокументОснование, ТипЛогистика", ДокументСсылка, ТипЛогистика);
			
			Если Разделители <> Неопределено И Разделители.Количество() > 0 Тогда
				ДанныеЗаполнения.Вставить("Разделитель", Разделители[0])
			КонецЕсли;
			
			Если ДокументыОснования <> Неопределено Тогда
				ДанныеЗаполнения.Вставить("ДокументыОснования", ДокументыОснования)
			КонецЕсли;
			
			ПараметрыФормы 		= Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ." + КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика) + ".ФормаОбъекта",
				ПараметрыФормы,
				,
				Источник,
				"ОбработчикОповеститьОВыполненииКоманды");
		Иначе
			
			МассивДокументовОснований = Новый Массив;
			МассивДокументовОснований.Добавить(ДокументСсылка);
			КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(МассивДокументовОснований, Ложь, ТипЛогистика);
			ОбработчикОповеститьОВыполненииКоманды();
			
		КонецЕсли;
		
	ИначеЕсли МассивУжеВведенныхДокументов.Количество() = 1 Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(МассивУжеВведенныхДокументов[0]);
		
	Иначе // в массиве более 2 документов
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(МассивУжеВведенныхДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

// Вводит документ КонтурЛогистика на основании предыдущего в цепочке титула и показывает пользователю
//
// Параметры:
//  ТипЛогистика	- ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - какой тип логистического документа будем вводить
//  Предыдущийтитул	- ДокументСсылка - исходный документ титул на базе которого надо подготовить следующий в цепочке логистический документ
//  Источник		- Управляемая форма - форма, инициировавшая ввод
//
Процедура ВвестиДокументЛогистикаИзПредыдущегоТитула(ТипЛогистика, ПредыдущийТитул, Источник = Неопределено, Знач ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда 
		
		ДопПараметры = Новый Структура;
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2") 
			ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6") Тогда 
			
			// попробовать определить второго водителя и подсунуть его доп параметром, если было несколько в Т1
			
		КонецЕсли;
		
	КонецЕсли;
	
	ГлавныйДок = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ПредыдущийТитул);
	
	МассивУжеВведенныхДокументов = КонтурЛогистика_ОбработкаДокументовСервер.УжеВведенныеДокументыЛогистикаПоГлавномуДокументу(ГлавныйДок, ТипЛогистика, ПредыдущийТитул, ДопПараметры);
	
	Если МассивУжеВведенныхДокументов.Количество() = 0 Тогда
		
		ДанныеЗаполнения 	= Новый Структура("ПредыдущийТитул, ТипЛогистика", ПредыдущийТитул, ТипЛогистика);
		Если ЗначениеЗаполнено(ГлавныйДок) И ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
			ДанныеЗаполнения.Вставить("ДокументЭТРН", ГлавныйДок);
		КонецЕсли;
		
		Для Каждого ДопПараметр Из ДопПараметры Цикл 
			ДанныеЗаполнения.Вставить(ДопПараметр.Ключ, ДопПараметр.Значение);
		КонецЦикла;
		
		ПараметрыФормы 		= Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
		
		// обработчик подключим только для формы Задач 
		Если ТипЗнч(Источник) = Тип("УправляемаяФорма") 
			И Источник.ИмяФормы = "ОбщаяФорма.КонтурЛогистика_Задачи" Тогда
			КонтекстОбработчика = Источник;
			ИмяОбработчика = "ОбработчикОповеститьОВыполненииКоманды";
			ДанныеЗаполнения.Вставить("СпецСценарий", Источник.СпецСценарий);
		Иначе
			КонтекстОбработчика = Неопределено;
			ИмяОбработчика = Неопределено 
		КонецЕсли;
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2") Тогда
			
			РазрешитьОтправлятьТ2ДоВодителя = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьОтправлятьТ2ДоВодителя");
			ТекСостояниеДО = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтатусДО(ГлавныйДок);
			
			Если Не РазрешитьОтправлятьТ2ДоВодителя И ТекСостояниеДО = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("r-wait-driver-approve") Тогда
				Сообщить("Ожидается подпись водителя");
				Возврат;
			КонецЕсли;
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
			
			РазрешитьОтправлятьТ4ДоВодителя = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьОтправлятьТ4ДоВодителя");
			ТекСостояниеДО = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтатусДО(ГлавныйДок);
			
			Если Не РазрешитьОтправлятьТ4ДоВодителя 
				И (ТекСостояниеДО = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("d-wait-driver-approve")
					Или ТекСостояниеДО = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("pd-wait-driver-approve")) Тогда
					
				Сообщить("Ожидается подпись водителя");
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(ПредыдущийТитул) <> Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
			КрайнийНеошибочныйФайл = КонтурЛогистика_ОбработкаДокументовСервер.НайтиКрайнийНеошибочныйФайлДокумента(ПредыдущийТитул);
			Если КрайнийНеошибочныйФайл = Неопределено Тогда
				ТипЛогистикаПредыдущий = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ПредыдущийТитул);
				КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Невозможно сформировать титул """ + ТипЛогистика + """, так как предыдущий титул """ + ТипЛогистикаПредыдущий + """ не был подписан. Для продолжения процесса дождитесь подписания предыдущего титула.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Документ." + КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика) + ".ФормаОбъекта",
			ПараметрыФормы,
			,
			КонтекстОбработчика,
			ИмяОбработчика);
	
	ИначеЕсли МассивУжеВведенныхДокументов.Количество() = 1 Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(МассивУжеВведенныхДокументов[0]);
		
	Иначе // в массиве более 2 документов
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(МассивУжеВведенныхДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет текущий документ КонтурЛогистика на основании документа (ищет предыдущий) в цепочке титула и показывает пользователю
//
// Параметры:
//  ТипЛогистика	- ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - какой тип логистического документа будем вводить
//  Предыдущийтитул	- ДокументСсылка - исходный документ титул на базе которого надо подготовить следующий в цепочке логистический документ
//  Источник		- Управляемая форма - форма, инициировавшая ввод
//
Процедура ЗаполнитьТекущийДокументЛогистикаИзПредыдущегоТитула(ТекущийДокумент, Источник) Экспорт
	
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьТекущийДокументЛогистикаИзПредыдущеготитула(ТекущийДокумент);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОповеститьОбИзмененииДокумента(ТекущийДокумент);
	
КонецПроцедуры

Процедура ВвестиТРНизЗЗ(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов", ПараметрКоманды);
	
	Форма = Неопределено;
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
	КонецЕсли;
	
	Если ПараметрКоманды.Количество() = 1 Тогда // через форму документа 
		
		ДокументСсылка = ПараметрКоманды[0];
		
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда 
			ДокументСсылка = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ДокументСсылка, "Титул1");
		КонецЕсли;
		
		СуществующийТитул1ЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул1ЭТрНпоЗаказЗаявке(ДокументСсылка);
		Если ЗначениеЗаполнено(СуществующийТитул1ЭТРН) Тогда 
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(СуществующийТитул1ЭТРН);
		Иначе
			
			ГОНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ДокументСсылка, "Грузоотправитель.Наш");
			Если ГОНаш <> Истина Тогда
				КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Для ввода ЭТрН требуется доступ от имени Грузоотправителя (сейчас ГО не наш)");
				Возврат;
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("Основание", ДокументСсылка);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Документ.КонтурЛогистика_ТрН_Титул1.Форма.ФормаДокумента", ПараметрыФормы, Форма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	Иначе // без открытия форм
		
		КонтурЛогистика_ОбработкаДокументовСервер.ВвестиТРНизЗЗПакетно(ПараметрКоманды);
		Оповестить("КонтурЛогистика_ВвестиДокумент");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьВидимостьНеучитываемыхИФильтраОшибок(ТаблицаДокумента, СкрытьНеучитываемые, ЭлементТаблица, ЭлементПереключателяИтогов) Экспорт
	
	// рассчет итогов по ТЧ
	КоличествоУчитываемых = ТаблицаДокумента.НайтиСтроки(Новый Структура("Учитывать", Истина)).Количество();
	КоличествоВсего = ТаблицаДокумента.Количество();
	
	ЭлементПереключателяИтогов.Видимость = КоличествоВсего <> 0;
	
	Если КоличествоВсего = КоличествоУчитываемых Тогда
		
		ЭлементПереключателяИтогов.Видимость = Ложь;
		ЭлементПереключателяИтогов.Заголовок = " ";// + КоличествоВсего + ?(КоличествоВсего = 1, " груз", " груза(ов)");
		СкрытьНеучитываемые 				 = Ложь;
		ЭлементПереключателяИтогов.Отображение = ОтображениеКнопки.Текст;
		
	Иначе
		
		ЭлементПереключателяИтогов.Видимость = Истина;
		ЭлементПереключателяИтогов.Заголовок = "Учитываемые товары (" + КоличествоУчитываемых + " из " + КоличествоВсего + ")"; // + ?(КоличествоУчитываемых = 1, " учитываемый", " учитываемые") ;
		ЭлементПереключателяИтогов.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
	КонецЕсли;
	
	// формирование отбора строк
	// ВНИМАНИЕ Отбором строк также управляет панель ошибок, поэтому действуем аккуратно
	Если СкрытьНеучитываемые = Истина Тогда
		
		Если ЭлементТаблица.ОтборСтрок = Неопределено Тогда
			
			ЭлементТаблица.ОтборСтрок = Новый ФиксированнаяСтруктура("Учитывать", Истина);
			
		Иначе
			
			ВременнаяСтруктура = Новый Структура(ЭлементТаблица.ОтборСтрок);
			ВременнаяСтруктура.Вставить("Учитывать", Истина);
			ЭлементТаблица.ОтборСтрок = Новый ФиксированнаяСтруктура(ВременнаяСтруктура);
			
		КонецЕсли;
		
	Иначе  // СырьеСкрытьНеподнадзорные = ложь
		
		Если НЕ ЭлементТаблица.ОтборСтрок = Неопределено Тогда
			
			ВременнаяСтруктура = Новый Структура(ЭлементТаблица.ОтборСтрок);
			
			Если ВременнаяСтруктура.Свойство("Учитывать") Тогда 
				ВременнаяСтруктура.Удалить("Учитывать");
				ЭлементТаблица.ОтборСтрок = Новый ФиксированнаяСтруктура(ВременнаяСтруктура);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// видимость и оформление элементов управления отборов
	Если СкрытьНеучитываемые Тогда 
		ЭлементПереключателяИтогов.Картинка = БиблиотекаКартинок.КонтурЛогистика_Вкл_Красный16;
	Иначе
		ЭлементПереключателяИтогов.Картинка = БиблиотекаКартинок.КонтурЛогистика_Выкл16;
	КонецЕсли;
	
КонецПроцедуры

Функция СсылкаВБраузереДиадок(ДокументСсылка) Экспорт
	
	Возврат КонтурЛогистика_ОбработкаДокументовСервер.СсылкаВБраузереДиадок(ДокументСсылка);
	
КонецФункции

Функция СсылкаВБраузереЛогиситка(ДокументСсылка) Экспорт
	
	Возврат КонтурЛогистика_ОбработкаДокументовСервер.СсылкаВБраузереЛогистика(ДокументСсылка);
	
КонецФункции

Функция ПодписатьФайлыОбмена(МассивФайловОбмена) Экспорт
	
	МассивПодписанныхФайловОбмена = КонтурЛогистика_ИнтеграцияДиадокКлиентСервер.ПодписатьФайлыОбмена(МассивФайловОбмена);
			
	Возврат МассивПодписанныхФайловОбмена;
	
