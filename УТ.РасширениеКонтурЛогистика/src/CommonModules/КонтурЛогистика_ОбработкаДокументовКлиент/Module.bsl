Процедура ИсправитьТитул(ТитулСсылка, ФормаВладельца) Экспорт 
	
	ФайлыКУдалению = Новый Массив;
	
	// Поиск всех файлов
	Если ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		
		ДокументЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ТитулСсылка, "ДокументЭТРН");
		
		ФайлТитула = КонтурЛогистика_ОбработкаДокументовСервер.НайтиФайлТитулаПоГлавномуДокументу(
			ДокументЭТРН, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1"));
		
		Если ЗначениеЗаполнено(ФайлТитула) Тогда
			ФайлыКУдалению.Добавить(ФайлТитула);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
		
		ДокументЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ТитулСсылка, "ДокументЭТРН");
		
		ФайлТитула = КонтурЛогистика_ОбработкаДокументовСервер.НайтиФайлТитулаПоГлавномуДокументу(
			ДокументЭТРН, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3"));
		
		Если ЗначениеЗаполнено(ФайлТитула) Тогда
			ФайлыКУдалению.Добавить(ФайлТитула);
		КонецЕсли;
		
	Иначе
		
		ФайлыКУдалению = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьСледующиеФайлыОбмена(ТитулСсылка);
		
	КонецЕсли;
	
	Если ФайлыКУдалению.Количество() Тогда
		
		ПараметрыФормы = Новый Структура("ФайлыКУдалению, Титул", ФайлыКУдалению, ТитулСсылка);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"ОбщаяФорма.КонтурЛогистика_ИсправлениеТитула", ПараметрыФормы, ФормаВладельца, КонтурЛогистика_ОбработкаДокументовКлиент,
			"ИсправитьТитул_Продолжение", ПараметрыФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ВызватьИсключение "Исправление недоступно. Проверьте, есть ли файлы обмена по данной ЭТрН.";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИсправитьТитул_Продолжение(Результат, ДопПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(Результат) Тогда 
	
		Оповестить("КонтурЛогистика_ОбновитьЗадачи");
		
		ИмяТитула = КонтурЛогистика_ОбщегоНазначенияСервер.ПолноеИмяОбъектаПоСсылке(Результат);
				
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			ИмяТитула + ".Форма.ФормаДокумента",
			Новый Структура("Ключ", Результат));
		
	КонецЕсли;

КонецПроцедуры

