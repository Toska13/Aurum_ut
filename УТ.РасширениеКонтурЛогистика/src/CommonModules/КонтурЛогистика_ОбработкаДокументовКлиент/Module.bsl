				Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
				Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
				Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", ПараметрКоманды);
			Иначе
				Состояние("Неудачная операция", 100, "не  удалось отправить", БиблиотекаКартинок.КонтурЛогистика_Отменить);
			КонецЕсли;
			
		#КонецЕсли
		
	ИначеЕсли ДействиеПоУмолч = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне") Тогда 
		
		ПараметрыФормированияФайловРеквизиты = Новый Структура;
		ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
		
		Состояние("Готовим данные", 20, "создаем документы и подписи", БиблиотекаКартинок.КонтурЛогистика_Лого16);
		МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
		
		#Если ВебКлиент Тогда
		
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ПараметрКоманды", ПараметрКоманды);
			ДополнительныеПараметры.Вставить("МассивФайловОбмена", МассивФайловОбмена);
			ДополнительныеПараметры.Вставить("ДействиеПоУмолч", ДействиеПоУмолч);
			
			Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСКриптографиейПодключено", КонтурЛогистика_ОбработкаДокументовКлиент, ДополнительныеПараметры);	
			НачатьПодключениеРасширенияРаботыСКриптографией(Оповещение);	
			
		#Иначе
		
			МассивПодписанныхФайловОбмена = ПодписатьФайлы(МассивФайловОбмена);
			
			Состояние("ГотовПереводим статус готовности", 50, "проверяем документы", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
			КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьКОтправкеПодписанные(МассивПодписанныхФайловОбмена);
			
			Если МассивПодписанныхФайловОбмена.Количество() > 0 Тогда 
				Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
				Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
				Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", ПараметрКоманды);
			Иначе
				Состояние("Неудачная операция", 100, "не  удалось сформировать подписанные файлы", БиблиотекаКартинок.КонтурЛогистика_Отменить);
			КонецЕсли;
			
		#КонецЕсли
		
	ИначеЕсли ДействиеПоУмолч = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ОбработатьВходящий") Тогда
		
		Состояние("Обрабатываем документы", 20, "Обрабатываем документы", БиблиотекаКартинок.КонтурЛогистика_Лого16);
						
		Для каждого Док Из ПараметрыВводаДокументов.МассивДокументов Цикл
			КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьДокументЛогистики(Док, Истина);	
		КонецЦикла;
		
		Состояние("Обработка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
		Оповестить("КонтурЛогистика_ОбновитьЗадачи");
		
	Иначе
		
		Сообщить("Не могу выполнить операцию - не знаю действие по умолчанию. Проверьте настройки конвертации.");
		
	КонецЕсли;

	ОповеститьОбИзменении(ТипЗнч(ПараметрКоманды[0]));

КонецПроцедуры

Процедура РасширениеРаботыСКриптографиейПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСКриптографией(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	ОповещениеПодписатьФайлыЗавершение = Новый ОписаниеОповещения("ПодписатьФайлыЗавершение", КонтурЛогистика_ОбработкаДокументовКлиент, ДополнительныеПараметры);
	
	Состояние("Подписываем документы", 60, "создаем файлы обмена", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);	
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПодписатьФайлыОбменаАсинхронно(ДополнительныеПараметры.МассивФайловОбмена, ОповещениеПодписатьФайлыЗавершение);
	
КонецПроцедуры
	
Функция ПодписатьФайлыЗавершение(МассивПодписанныхФайловОбмена, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.ДействиеПоУмолч = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе")
		Или ДополнительныеПараметры.ДействиеПоУмолч = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный") Тогда
		
		Состояние("Отправляем документы", 50, "требуется около 3 секунд на 1 документ", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
		КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлы(МассивПодписанныхФайловОбмена);
		
		Если МассивПодписанныхФайловОбмена.Количество() > 0 Тогда 
			Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
			Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
			Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", ДополнительныеПараметры.ПараметрКоманды);
		Иначе
			Состояние("Неудачная операция", 100, "не  удалось отправить", БиблиотекаКартинок.КонтурЛогистика_Отменить);
		КонецЕсли;
			
	ИначеЕсли ДополнительныеПараметры.ДействиеПоУмолч = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне")
		Или ДополнительныеПараметры.ДействиеПоУмолч = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный") Тогда
		
		Состояние("ГотовПереводим статус готовности", 50, "проверяем документы", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
		КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьКОтправкеПодписанные(МассивПодписанныхФайловОбмена);
		
		Если МассивПодписанныхФайловОбмена.Количество() > 0 Тогда 
			Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
			Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
			Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", ДополнительныеПараметры.ПараметрКоманды);
		Иначе
			Состояние("Неудачная операция", 100, "не  удалось сформировать подписанные файлы", БиблиотекаКартинок.КонтурЛогистика_Отменить);
		КонецЕсли;
		
	КонецЕсли;
	
Конецфункции

Процедура ВыполнитьСценарийПереотправка(Знач МассивТитулов, ТипЛогистика)
	
	Если Не ЗначениеЗаполнено(МассивТитулов) Тогда 		
		Возврат
	КонецЕсли;
	
	Состояние("Готовим данные", 20, "создаем документы", БиблиотекаКартинок.КонтурЛогистика_Лого16);
	МассивВведенных = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПереотправка(МассивТитулов, ТипЛогистика);
	
	Состояние("Обработка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
		
	ОповеститьОбИзменении(ТипЗнч(МассивТитулов[0]));

	Если МассивВведенных.Количество() = 1 Тогда 
		
		Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
		Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", МассивТитулов);
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(МассивВведенных[0]);		
	
	КонецЕсли;	
	
КонецПроцедуры
	
Функция ПодписатьФайлы(МассивФайловОбмена)
		
	Состояние("Подписываем документы", 60, "создаем файлы обмена", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
	
	МассивПодписанныхФайловОбмена = КонтурЛогистика_ОбработкаДокументовКлиент.ПодписатьФайлыОбмена(МассивФайловОбмена);
	
	Возврат МассивПодписанныхФайловОбмена;

КонецФункции

