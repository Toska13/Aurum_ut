Процедура ПослеВводаПричиныОтказаНаКлиенте(ПричинаОтказа, ТитулСсылка) Экспорт 
	
	// запишем причину отказа
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьПричинуОтказаВТитул(ПричинаОтказа, ТитулСсылка);
	
	МассивДокументовЛогистика = Новый Массив;
	МассивДокументовЛогистика.Добавить(ТитулСсылка);
	
	УточнениеТипаЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТитулСсылка);
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", МассивДокументовЛогистика, УточнениеТипаЛогистика); 
	
	ПараметрыФормированияФайловРеквизиты = Новый Структура;
	ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
	
	МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
	МассивПодписанныхФайловОбмена = КонтурЛогистика_ИнтеграцияДиадокКлиентСервер.ПодписатьФайлыОбмена(МассивФайловОбмена);
	
	// Отправим файлы
	Если ТипЗнч(МассивПодписанныхФайловОбмена) = Тип("Массив")
		И МассивПодписанныхФайловОбмена.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(МассивПодписанныхФайловОбмена);
		Если НЕ РезультатОтправки.Успешно Тогда
			ВызватьИсключение "Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Если ВебКлиент Тогда

Процедура ПослеВводаПричиныОтказаНаВебКлиенте(ПричинаОтказа, ТитулСсылка, Форма) Экспорт 
	
	// запишем причину отказа
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьПричинуОтказаВТитул(ПричинаОтказа, ТитулСсылка);
	
	МассивДокументовЛогистика = Новый Массив;
	МассивДокументовЛогистика.Добавить(ТитулСсылка);
	
	УточнениеТипаЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТитулСсылка);
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", МассивДокументовЛогистика, УточнениеТипаЛогистика); 
	
	ПараметрыФормированияФайловРеквизиты = Новый Структура;
	ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
	
	МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивФайловОбмена", МассивФайловОбмена);
	ДополнительныеПараметры.Вставить("ТитулСсылка", ТитулСсылка);
	ДополнительныеПараметры.Вставить("Форма", Форма);
		
	Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСКриптографиейПодключеноОтказ", КонтурЛогистика_ОбработкаДокументовКлиент, ДополнительныеПараметры);	
	НачатьПодключениеРасширенияРаботыСКриптографией(Оповещение);
		
КонецПроцедуры

Процедура РасширениеРаботыСКриптографиейПодключеноОтказ(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСКриптографией(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	ОповещениеПодписатьФайлыЗавершение = Новый ОписаниеОповещения("ПодписатьФайлыЗавершениеОтказ", КонтурЛогистика_ОбработкаДокументовКлиент, ДополнительныеПараметры);
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПодписатьФайлыОбменаАсинхронно(ДополнительныеПараметры.МассивФайловОбмена, ОповещениеПодписатьФайлыЗавершение);
	
КонецПроцедуры
	
Функция ПодписатьФайлыЗавершениеОтказ(МассивПодписанныхФайловОбмена, ДополнительныеПараметры) Экспорт
	
	// Отправим файлы
	Если ТипЗнч(МассивПодписанныхФайловОбмена) = Тип("Массив")
		И МассивПодписанныхФайловОбмена.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(МассивПодписанныхФайловОбмена);
		Если НЕ РезультатОтправки.Успешно Тогда
			ВызватьИсключение "Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Найти(ДополнительныеПараметры.Форма.ИмяФормы, "ФормаДокумента") Тогда 
		ДополнительныеПараметры.Форма.Закрыть();
	КонецЕсли;
		
	Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", ДополнительныеПараметры.ТитулСсылка);
	Оповестить("КонтурЛогистика_ОбновитьЗадачи");
		
Конецфункции

#КонецЕсли

#Область ВыполнитьДействиеПоУмолчанию

// Процедура - Выполнить текущие требуемые действия
//
// Параметры:
//  ПараметрКоманды				 - 	КонтурЛогистика_<ЛюбойТитул> - массив строго документов-титулов подсистемы
//  ПараметрыВыполненияКоманды	 - Форма - форма из которой вызвана команда
//
Процедура ВыполнитьТекущиеТребуемыеДействия(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	Попытка
		МестоВызова = ПараметрыВыполненияКоманды.Источник.ИмяФормы;
	Исключение
		МестоВызова = "";
	КонецПопытки;
	
	Если ПараметрКоманды.Количество() = 0 Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Выделите строки для которых выполнить действие");
		Возврат;
	КонецЕсли;
	
	Для Каждого Документ Из ПараметрКоманды Цикл
		
		ТребуемоеДействие = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьДействиеПоУмолчаниюДокТитул(Документ);
		
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Документ);
		ПараметрыВводаДокументов = Новый Структура("УточнениеТипаЛогистика", ТипЛогистика);
		
		ВыполнитьТребуемоеДействие(ТребуемоеДействие, Документ, ПараметрыВводаДокументов, ТипЛогистика, МестоВызова);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьТребуемоеДействие(Знач ТребуемоеДействие, Знач Документ, Знач ПараметрыВводаДокументов, Знач ТипЛогистика, МестоВызова = "") Экспорт
	
	Перем МассивДокументовЛогистика, МассивПодписанныхФайловОбмена, МассивФайловОбмена;
	
	МассивИз1Документа = Новый Массив;
	
	Если ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный") Тогда
		
		// Проверим права сотрудника
		НовоеТребуемоеДействие = КонтурЛогистика_ОбработкаДокументовСервер.ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(
			ТребуемоеДействие, Документ);
		Если ТребуемоеДействие = НовоеТребуемоеДействие Тогда
			МассивИз1Документа.Добавить(Документ);
		Иначе
			ТекстСообщения = "Нет права """ + Строка(ТребуемоеДействие) + """ по документу: " + Строка(Документ);
			Сообщить(ТекстСообщения);
		КонецЕсли;
		
		Если МассивИз1Документа.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
	Иначе
		МассивИз1Документа.Добавить(Документ);
	КонецЕсли;
	
	ПараметрыВводаДокументов.Вставить("МассивДокументов", МассивИз1Документа);
	ПараметрыВводаДокументов.Вставить("Интерактивно");
	
	МассивДокументовПодсистемы = Новый Массив;
	МассивДокументовПодсистемы.Добавить(Документ);
	
	Если ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление") Тогда
		
		Состояние("Готовим данные", 20, "создаем документы", БиблиотекаКартинок.КонтурЛогистика_Лого16);
		КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументы(МассивДокументовПодсистемы, ТипЛогистика);
		
		Состояние("Обработка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
		Оповестить("КонтурЛогистика_ВвестиДокумент");
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Переотправить") Тогда
		
		ВыполнитьСценарийПереотправка(МассивИз1Документа, ТипЛогистика);
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю") Тогда
		
		ПараметрыФормированияФайловРеквизиты = Новый Структура;
		ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Ложь);
		Если ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание") Тогда
			ПараметрыФормированияФайловРеквизиты.Вставить("ПередатьНаПодписание");
			
			ИмяСсылкиПоТипу = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьИмяСсылкиПоТипуЛогистики(ТипЛогистика);
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Передача на подписание", "Передать на подписание", МестоВызова, ИмяСсылкиПоТипу);
		ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю") Тогда
			ПараметрыФормированияФайловРеквизиты.Вставить("ПередатьНаСогласованиеВодителю");
			
			ИмяСсылкиПоТипу = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьИмяСсылкиПоТипуЛогистики(ТипЛогистика);
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Передача водителю", "Передать водителю", МестоВызова, ИмяСсылкиПоТипу);
		КонецЕсли;
		
		Состояние("Готовим данные", 20, "создаем документы и файлы обмена", БиблиотекаКартинок.КонтурЛогистика_Лого16);
		
		Если ПараметрыВводаДокументов.Свойство("ОтправитьЧерновикПовторно") И ПараметрыВводаДокументов.ОтправитьЧерновикПовторно Тогда
			МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыДляОтправкиЧерновиков(
				ПараметрыВводаДокументов.МассивДокументов, ПараметрыФормированияФайловРеквизиты);
		Иначе
			МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(
				ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
		КонецЕсли;
		
		Состояние("Отправляем документы", 50, "требуется около 3 секунд на 1 документ", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
		КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлы(МассивФайловОбмена);
		
		Если МассивФайловОбмена.Количество() > 0 Тогда 
			Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
			Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
			Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", МассивДокументовПодсистемы);
		Иначе
			Состояние("Неудачная операция", 100, "не  удалось отправить", БиблиотекаКартинок.КонтурЛогистика_Отменить);
		КонецЕсли;
		
	// как организовать отправку в фоне?
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик") Тогда
		
		Состояние("Готовим данные", 20, "создаем документы", БиблиотекаКартинок.КонтурЛогистика_Лого16);
		МассивДокументовЛогистика = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументы(МассивДокументовПодсистемы, ТипЛогистика);
		
		Состояние("Переводим статус готовности", 50, "проверяем документы", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
		КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика);
		
		Если МассивДокументовПодсистемы.Количество() = 1 И КонтурЛогистика_ОбработкаДокументовСервер.ДокументУспешноПодготовлен(МассивДокументовПодсистемы[0]) Тогда 
			Состояние("Обработка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
			Оповестить("КонтурЛогистика_ОбновитьОткрытыеТитулы");
			Оповестить("КонтурЛогистика_ЗакрытьФормыТитулов", МассивДокументовПодсистемы);
		КонецЕсли;
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный") Тогда
		
		РезультатВалидации = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьДокумент(Документ);
		Если РезультатВалидации.КоличествоОшибок > 0  Тогда
			Сообщить("При проверке обнаружены ошибки, подпись невозможна");
			Возврат;
		КонецЕсли;
		
