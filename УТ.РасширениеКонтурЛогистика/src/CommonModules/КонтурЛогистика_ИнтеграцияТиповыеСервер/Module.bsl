#Область ВызовФункцийТиповыхКонфигураций

// Вычисляет массу брутто номенклатуры на основе данных учетной системы (упаковок, едициц измерения и т.д.)
//
// Параметры:
//  СтрокаТЧТовары	 - ДокументТабличнаяЧастьСтрока	 - строка табличной части "Товары" документа основания
// 
// Возвращаемое значение:
//  Число
//
Функция МассаБрутто(СтрокаТЧТовары) Экспорт
	
	ТиповаяКонфигурацияСтрока = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Если ТиповаяКонфигурацияСтрока = "УФ_УТ"
		Или ТиповаяКонфигурацияСтрока = "КА_2"
		Или ТиповаяКонфигурацияСтрока = "ERP_УАТ"
		Или ТиповаяКонфигурацияСтрока = "ERP" Тогда
		Возврат КонтурЛогистика_ИнтеграцияТиповые_УФ_УТ.МассаБрутто(СтрокаТЧТовары);
	ИначеЕсли ТиповаяКонфигурацияСтрока = "УТ"
		Или ТиповаяКонфигурацияСтрока = "УПП"
		Или ТиповаяКонфигурацияСтрока = "КА" Тогда
		Возврат КонтурЛогистика_ИнтеграцияТиповые_ОФ_УТ.МассаБрутто(СтрокаТЧТовары);
	КонецЕсли;	
	
	Сообщить("Для конфигурации " + ТиповаяКонфигурацияСтрока + " нет функции по расчету массы брутто");
	
	Возврат 0;
	
КонецФункции

