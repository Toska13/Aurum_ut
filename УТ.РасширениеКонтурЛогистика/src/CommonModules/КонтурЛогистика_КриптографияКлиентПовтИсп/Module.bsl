
Функция ПолучитьТипПлатформы() Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Возврат СистемнаяИнформация.ТипПлатформы;
	
КонецФункции

Функция ТипПлатформыWindows() Экспорт
	
	ТипПлатформыСтрока = Строка(ПолучитьТипПлатформы());
	ТипПлатформыСтрока = НРег(ТипПлатформыСтрока);
	
	Возврат Найти(ТипПлатформыСтрока, НРег("windows")) <> 0;
	
КонецФункции

Функция ПолучитьТипыМодуляКриптографии() Экспорт
	
	Возврат КонтурЛогистика_КриптографияСервер.ПолучитьТипыМодуляКриптографии();
	
КонецФункции

Функция ПутьКМодулюCryptoPro() Экспорт
	
	ПутиКМодулямCryptoPro = ПутиКМодулямCryptoPro();
	
	Возврат ПутиКМодулямCryptoPro[ПолучитьТипПлатформы()][0];
	
КонецФункции

Функция ПутиКМодулямCryptoPro() Экспорт
	
	ПутиКриптоПро = Новый Соответствие;
	
	ПутиКриптоПро.Вставить(ТипПлатформы.Linux_x86,    ПутиКМодулямПрограммыКриптоПроНаLinux32());
	ПутиКриптоПро.Вставить(ТипПлатформы.Linux_x86_64, ПутиКМодулямПрограммыКриптоПроНаLinux64());
	ПутиКриптоПро.Вставить(ТипПлатформы.MacOS_x86,    ПутиКМодулямПрограммыКриптоПроНаMacOS());
	ПутиКриптоПро.Вставить(ТипПлатформы.MacOS_x86_64, ПутиКМодулямПрограммыКриптоПроНаMacOS());
	
	Возврат ПутиКриптоПро 
	
КонецФункции

Функция ПутиКМодулямПрограммыКриптоПроНаLinux64()
	
	МодулиПрограммы = Новый Массив;
	МодулиПрограммы.Добавить("/opt/cprocsp/lib/amd64/libcapi10.so");
	МодулиПрограммы.Добавить("/opt/cprocsp/lib/amd64/libcapi20.so");
	
	ПутиКМодулям = Новый Массив;
	ПутиКМодулям.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МодулиПрограммы, ":"));
	Возврат Новый ФиксированныйМассив(ПутиКМодулям);
	
КонецФункции

Функция ПутиКМодулямПрограммыКриптоПроНаLinux32()
	
	МодулиПрограммы = Новый Массив;
	МодулиПрограммы.Добавить("/opt/cprocsp/lib/ia32/libcapi10.so");
	МодулиПрограммы.Добавить("/opt/cprocsp/lib/ia32/libcapi20.so");
	
	ПутиКМодулям = Новый Массив;
	ПутиКМодулям.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МодулиПрограммы, ":"));
	Возврат Новый ФиксированныйМассив(ПутиКМодулям);
	
КонецФункции

Функция ПутиКМодулямПрограммыКриптоПроНаMacOS()
	
	МодулиПрограммы = Новый Массив;
	МодулиПрограммы.Добавить("/opt/cprocsp/lib/libcapi10.dylib");
	МодулиПрограммы.Добавить("/opt/cprocsp/lib/libcapi20.dylib");
	
	ПутиКМодулям = Новый Массив;
	ПутиКМодулям.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МодулиПрограммы, ":"));
	Возврат Новый ФиксированныйМассив(ПутиКМодулям);
	
КонецФункции