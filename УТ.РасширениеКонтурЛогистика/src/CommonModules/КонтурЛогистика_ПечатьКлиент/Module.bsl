Процедура РаспечататьТрН(МассивОбъектов) Экспорт
	
	ВсегдаФормироватьПечатнуюФормуИз1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ВсегдаФормироватьПечатнуюФормуИз1С");
	
	Если ВсегдаФормироватьПечатнуюФормуИз1С Тогда
		
		РаспечататьТрНИзМодуля1С(МассивОбъектов);
		
	Иначе
		
		ПечатнаяФормаPDF = КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьПечатнуюФормуApiЛогистика(МассивОбъектов);
		
		Если ПечатнаяФормаPDF = Неопределено Тогда
			
			РаспечататьТрНИзМодуля1С(МассивОбъектов);
			
		Иначе
			
			#Если ВебКлиент Тогда
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ПечатнаяФормаPDF", ПечатнаяФормаPDF);
				
				Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", КонтурЛогистика_ПечатьКлиент, ДополнительныеПараметры);
				НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
				
			#Иначе
				
				Путь = ПолучитьИмяВременногоФайла(".pdf");
				ПечатнаяФормаPDF.Записать(Путь);
				ЗапуститьПриложение(Путь);
				
			#КонецЕсли
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспечататьТрНИзМодуля1С(МассивОбъектов)
	
	ВсеДокументыЭПЛ = Истина;
	Для Каждого ТекущийОбъект Из МассивОбъектов Цикл
		Если ТипЗнч(ТекущийОбъект) <> Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
			ВсеДокументыЭПЛ = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ВсеДокументыЭПЛ Тогда
		Сообщить("Не удалось получить печатную форму. Попробуйте отправить документ или выполнить обмен");
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = КонтурЛогистика_ПечатьСервер.ПолучитьТабличныйДокументЭПД(МассивОбъектов);
	РаспечататьТрНСВыборомПринтера(ТабличныйДокумент, МассивОбъектов);
	
КонецПроцедуры

Процедура ПоказатьТабличныйДокументПользователю(МассивОбъектов) Экспорт
	
	ВсегдаФормироватьПечатнуюФормуИз1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ВсегдаФормироватьПечатнуюФормуИз1С");
	
	Если ВсегдаФормироватьПечатнуюФормуИз1С Тогда
		
		ПоказатьТабличныйДокументПользователюИзМодуля1С(МассивОбъектов);
		
	Иначе
		
		ПечатнаяФормаPDF = КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьПечатнуюФормуApiЛогистика(МассивОбъектов);
		
		Если ПечатнаяФормаPDF = Неопределено Тогда
			
			ПоказатьТабличныйДокументПользователюИзМодуля1С(МассивОбъектов);
			
		Иначе
			
			#Если ВебКлиент Тогда
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ПечатнаяФормаPDF", ПечатнаяФормаPDF);
				
				Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", КонтурЛогистика_ПечатьКлиент, ДополнительныеПараметры);
				НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
				
			#Иначе
				
				Путь = ПолучитьИмяВременногоФайла(".pdf");
				ПечатнаяФормаPDF.Записать(Путь);
				ЗапуститьПриложение(Путь);
				
			#КонецЕсли
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьТабличныйДокументПользователюИзМодуля1С(МассивОбъектов)
	
	ВсеДокументыЭПЛ = Истина;
	Для Каждого ТекущийОбъект Из МассивОбъектов Цикл
		Если ТипЗнч(ТекущийОбъект) <> Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
			ВсеДокументыЭПЛ = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ВсеДокументыЭПЛ Тогда
		Сообщить("Не удалось получить печатную форму. Попробуйте отправить документ или выполнить обмен");
		Возврат;
	КонецЕсли;
	
	ФормаПечать = ПолучитьФорму("ОбщаяФорма.КонтурЛогистика_Печать");
	ФормаПечать.ПечатнаяФорма = КонтурЛогистика_ПечатьСервер.ПолучитьТабличныйДокументЭПД(МассивОбъектов);
	
	Для Каждого ДокОформления Из МассивОбъектов Цикл
		Если ЗначениеЗаполнено(ДокОформления) Тогда 
			ФормаПечать.ДокументыОформления.Добавить(ДокОформления);
		КонецЕсли;
	КонецЦикла;
	
	ФормаПечать.Открыть();
	
КонецПроцедуры

Процедура РасширениеРаботыСФайламиПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСФайлами(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("НачатьПолучениеКаталогаВременныхФайловЗавершение", КонтурЛогистика_ПечатьКлиент, ДополнительныеПараметры);
	НачатьПолучениеКаталогаВременныхФайлов(Оповещение);
		
КонецПроцедуры

Процедура НачатьПолучениеКаталогаВременныхФайловЗавершение(ИмяКаталогаВременныхФайлов, ДополнительныеПараметры) Экспорт
	
	ИмяФайла = Строка(Новый УникальныйИдентификатор) + ".pdf";
	ИмяВременногоФайла = ИмяКаталогаВременныхФайлов + ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ИмяВременногоФайла", ИмяВременногоФайла);
	
	Оповещение = Новый ОписаниеОповещения("НачатьЗаписьПечатнаяФормаPDFЗавершение", КонтурЛогистика_ПечатьКлиент, ДополнительныеПараметры);	
	ДополнительныеПараметры.ПечатнаяФормаPDF.НачатьЗапись(Оповещение, ИмяВременногоФайла);
		
КонецПроцедуры

Процедура НачатьЗаписьПечатнаяФормаPDFЗавершение(ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("НачатьЗапускПриложенияЗаврешение", КонтурЛогистика_ПечатьКлиент);
	НачатьЗапускПриложения(Оповещение, ДополнительныеПараметры.ИмяВременногоФайла);
		
КонецПроцедуры

Процедура НачатьЗапускПриложенияЗаврешение(КодВозврата, ДополнительныеПараметры) Экспорт
			
КонецПроцедуры

Процедура РаспечататьТрНСВыборомПринтера(ТабличныйДокумент, МассивОбъектов) Экспорт 
	
	Принтер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяПринтераДляПечати");
	
	Если ЗначениеЗаполнено(Принтер) Тогда
		
		РаспечататьТрННаПринтере(ТабличныйДокумент, Принтер, МассивОбъектов);
		
	Иначе
				
		ВыбратьПринтер(ТабличныйДокумент, МассивОбъектов);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспечататьТрННаПринтере(ТабличныйДокумент, Принтер, МассивДокументов) 
		
	ТабличныйДокумент.ИмяПринтера = Принтер;
		
	ТабличныйДокумент.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
	
	// todo нужно как-то определять, что не произошло ошибок на принтере 
	// или пользователь не отказался от печати, в случае сохранения в PDF
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВыводитьЗадачуРаспечатать") Тогда 
		
		// установить документам статус работа завершена вместо Распечатать
		КонтурЛогистика_ПечатьСервер.ОтметитьДокументыРаспечатанными(МассивДокументов);
		
		Оповестить("КонтурЛогистика_ОбновитьЗадачи", МассивДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыбратьПринтер(ТабличныйДокумент, МассивОбъектов)
	
	СписокПринтеров = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПолучитьСписокПринтеров();	
	
	ДопПараметры = Новый Структура("ТабличныйДокумент, МассивОбъектов", ТабличныйДокумент, МассивОбъектов);
	
	ОписаниеОбработчика = Новый ОписаниеОповещения("ПослеВыбораПринтера", КонтурЛогистика_ПечатьКлиент, ДопПараметры);
	
	СписокПринтеров.ПоказатьВыборЭлемента(ОписаниеОбработчика, "Выберите принтер для печати");
	
КонецПроцедуры

Процедура ПослеВыбораПринтера(ВыбранныйЭлемент, ДопПараметры) Экспорт
	
	Если НЕ ВыбранныйЭлемент = Неопределено Тогда
		
		КонтурЛогистика_ПечатьСервер.ЗаписатьВыбранныйПринтерДляПечати(ВыбранныйЭлемент.Значение);
		
		ОбновитьПовторноИспользуемыеЗначения();
		
		РаспечататьТрННаПринтере(ДопПараметры.ТабличныйДокумент, ВыбранныйЭлемент.Значение, ДопПараметры.МассивОбъектов);
		
	КонецЕсли;
	
КонецПроцедуры

