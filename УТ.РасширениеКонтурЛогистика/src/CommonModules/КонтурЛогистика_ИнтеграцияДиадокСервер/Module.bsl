Функция Ядро() Экспорт

	Возврат Обработки.КонтурЛогистика_ДиадокЯдро.Создать();
	
КонецФункции

Функция Токен(boxID) Экспорт
	
	// понять способ авторизации для этого ящика (boxID)
	
	// в текущий момент только по логин-паролю
	Логин =  КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЛогинАвторизацииДиадокАПИ");
	Пароль = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПарольАвторизацииДиадокАПИ");

	Токен = Ядро().Токен_ПолучитьИзДиадока( , Логин, Пароль);

	Возврат Токен;	

КонецФункции

Функция ПодписатьФайлОбмена(ДвоичныеДанныеКонтента, Отпечаток, ПарольКонтейнера, ФайлОбмена = Неопределено, ВернутьОшибку = Ложь) Экспорт 
	
	Попытка
		
		Возврат Ядро().ПодписатьДанные(ДвоичныеДанныеКонтента, Отпечаток, ПарольКонтейнера, ФайлОбмена, ВернутьОшибку);
		
	Исключение
		
		Если ЗначениеЗаполнено(ФайлОбмена) Тогда
			ТипДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				ФайлОбмена, "ТипДокумента");
		Иначе
			ТипДокумента = Неопределено;
		КонецЕсли;
		
		КонтурЛогистика_Метрика.ОбработатьОшибкуТипаДокумента(
			"ПодписатьФайлОбменаНаСервере", ТипДокумента, ИнформацияОбОшибке(), ФайлОбмена);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции
