Функция ПоФактХЖ(ТипДокументооборота, НомерТитула)
	
	Если ТипДокументооборота = "__etrnTitle" Тогда
		
		Если НомерТитула = 1 Тогда
			Возврат "Транспортная накладная, информация грузоотправителя";
		ИначеЕсли НомерТитула = 2 Тогда
			Возврат "Транспортная накладная, информация перевозчика о приеме груза";
		ИначеЕсли НомерТитула = 3 Тогда
			Возврат "Транспортная накладная, информация грузополучателя о приеме груза";
		ИначеЕсли НомерТитула = 4 Тогда
			Возврат "Транспортная накладная, информация перевозчика о выдаче груза грузополучателю";
		ИначеЕсли НомерТитула = 5 Тогда
			Возврат "Транспортная накладная, информация перевозчика об изменении финансового состояния перевозчика и грузоотправителя в результате выполнения грузовой перевозки";
		ИначеЕсли НомерТитула = 6 Тогда
			Возврат "Транспортная накладная, информация грузоотправителя об изменении финансового состояния перевозчика и грузоотправителя в результате выполнения грузовой перевозки";
		ИначеЕсли НомерТитула = 7 Тогда
			Возврат "Транспортная накладная, информация о переадресовке";
		ИначеЕсли НомерТитула = 8 Тогда
			Возврат "Транспортная накладная, информация о заменах водителя (водителей) и (или) транспортного средства";
		Иначе
			ВызватьИсключение "Не поддерживается определение ПоФактХЖ по титулу номер " + НомерТитула + " " + ТипДокументооборота;
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		
		ВызватьИсключение "Формат Не содержит ПоФактХЖ по титулу номер " + НомерТитула + " " + ТипДокументооборота;
		
	Иначе
		
		ВызватьИсключение "Не поддерживается определение кода ПоФактХЖ по титулу номер " + НомерТитула + " " + ТипДокументооборота;
		
	КонецЕсли;	
	
КонецФункции

Функция XDTO_Подписант(НомерТитула, ТипДокументооборота = "__etrnTitle", Формат = "5.01", ПодписантСтруктура, XDTO_СвДовер = Неопределено) Экспорт

	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "Подписант", ТипДокументооборота, Формат);
	
	// ФИО
	XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, "Подписант.ФИО", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ПодписантСтруктура.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		ПодписантСтруктура.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	ПодписантСтруктура.Отчество);
	
	XDTO_Установить(XDTO_Объект, "ФИО", XDTO_ФИО);
	
	Если ТипДокументооборота = "__ForwardingReceipt" Тогда
		
		XDTO_Установить(XDTO_Объект, "Должность", ПодписантСтруктура.Должность);
		
	Иначе
		
		XDTO_Установить(XDTO_Объект, "Должн", ПодписантСтруктура.Должность);
		XDTO_Установить(XDTO_Объект, "СтатПодп", ПодписантСтруктура.СтатусПодписанта);
		Если (ПодписантСтруктура.СтатусПодписанта = "2" Или ПодписантСтруктура.СтатусПодписанта = "5") И ЗначениеЗаполнено(ПодписантСтруктура.ИдСистХран) Тогда
			XDTO_Установить(XDTO_Объект, "ИдСистХран", ПодписантСтруктура.ИдСистХран);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

// формат 2023
Функция XDTO_ПодпИнф(НомерТитула, ТипДокументооборота = "__etrnTitle", Формат = "5.01", ПодписантСтруктура) Экспорт

	ИмяТэгаПодписант = "";
	Если ТипДокументооборота = "__PL" И НомерТитула = 1 Тогда
		ИмяТэгаПодписант = "ПодпИнфСоб";
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 2  Тогда
		ИмяТэгаПодписант = "ПодпИнфМО";
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 3 И Формат = "5.01" Тогда
		ИмяТэгаПодписант = "ПодпИнфТехСост";		
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 3 И Формат = "5.02" Тогда
		ИмяТэгаПодписант = "ПодпИнфВыпуск";		
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 4 И Формат = "5.01" Тогда
		ИмяТэгаПодписант = "ПодпИнфВыезд";
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 4 И Формат = "5.02" Тогда
		ИмяТэгаПодписант = "ПодпИнфВозвр";
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 5 И Формат = "5.01" Тогда
		ИмяТэгаПодписант = "ПодпИнфЗаезд";
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 5 И Формат = "5.02" Тогда
		ИмяТэгаПодписант = "ПодпИнфПМО";
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 6  Тогда
		ИмяТэгаПодписант = "ПодпИнфМО";
		
	ИначеЕсли ТипДокументооборота = "__ZZ" И НомерТитула = 1 Тогда
		ИмяТэгаПодписант = "ПодпИнфГО";
	ИначеЕсли ТипДокументооборота = "__ZZ" И НомерТитула = 2 Тогда 
		ИмяТэгаПодписант = "ПодпИнфПрв";
		
	ИначеЕсли ТипДокументооборота = "__DF" И НомерТитула = 1 Тогда
		ИмяТэгаПодписант = "ПодпДФИнфФт";
	ИначеЕсли ТипДокументооборота = "__DF" И НомерТитула = 2 Тогда 
		ИмяТэгаПодписант = "ПодпДФИнфФщ";
		
	Иначе
		ВызватьИсключение "Пропишите имя тега для " + ТипДокументооборота + " Титул " + НомерТитула;
	КонецЕсли;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант, ТипДокументооборота, Формат);
	
	// ФИО
	XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант + ".ФИО", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ПодписантСтруктура.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		ПодписантСтруктура.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	ПодписантСтруктура.Отчество);
	
	XDTO_Установить(XDTO_Объект, "ФИО", XDTO_ФИО);
	
	XDTO_Установить(XDTO_Объект, "Должн", 		ПодписантСтруктура.Должность);
	XDTO_Установить(XDTO_Объект, "ТипПодпис", 	"1");
	
	XDTO_Установить(XDTO_Объект, "СпосПодтПолном", 	ПодписантСтруктура.СпосПодтПолном);
	
	Если ТипДокументооборота = "__PL" И Формат = "5.02" И ЗначениеЗаполнено(ПодписантСтруктура.ДопСведенияОПодписанте) Тогда
		XDTO_Установить(XDTO_Объект, "ДопСведПодп", ПодписантСтруктура.ДопСведенияОПодписанте);		
	КонецЕсли;
	
	Если ПодписантСтруктура.СпосПодтПолном = "5" Тогда
		
		XDTO_СвДоверБум = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант + ".СвДоверБум", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвДоверБум, "ДатаДовер", 	XDTO_ДатаТип(ПодписантСтруктура.СвДоверБум_ДатаДовер));
		НомерДоверенности = "без номера";
		Если ЗначениеЗаполнено(СокрЛП(ПодписантСтруктура.СвДоверБум_ВнНомДовер)) Тогда 
			НомерДоверенности = СокрЛП(ПодписантСтруктура.СвДоверБум_ВнНомДовер);
		КонецЕсли;
		XDTO_Установить(XDTO_СвДоверБум, "ВнНомДовер", 	НомерДоверенности);
		
		XDTO_Объект.СвДоверБум.Добавить(XDTO_СвДоверБум);
				
	ИначеЕсли ПодписантСтруктура.СпосПодтПолном = "3" Тогда
		
		XDTO_СвДоверЭл = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант + ".СвДоверЭл", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвДоверЭл, 	"НомДовер", 		ПодписантСтруктура.МЧД);		
		XDTO_Установить(XDTO_СвДоверЭл, 	"ИдСистХран", 		ПодписантСтруктура.ИдСистХран);
		
		Если ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
			XDTO_Установить(XDTO_СвДоверЭл, "ДатаВыдДовер", 	XDTO_ДатаТип(ПодписантСтруктура.ДатаВыпускаМЧД));
			Если Найти(НРег(ПодписантСтруктура.ИдСистХран), "http:") > 0
				Или Найти(НРег(ПодписантСтруктура.ИдСистХран), "https:") > 0
				Или Найти(НРег(ПодписантСтруктура.ИдСистХран), "www.") > 0 Тогда
				XDTO_Установить(XDTO_СвДоверЭл, "УРЛСист", 		ПодписантСтруктура.ИдСистХран);
			КонецЕсли;
		Иначе
			XDTO_Установить(XDTO_СвДоверЭл, "ДатаДовер", 		XDTO_ДатаТип(ПодписантСтруктура.ДатаВыпускаМЧД));			
		КонецЕсли;
		
		XDTO_Объект.СвДоверЭл.Добавить(XDTO_СвДоверЭл);
		
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Процедура XDTO_Подписант_СформироватьСведенияМЧД(НомерТитула, XDTO_Подписант, Знач ПодписантСтруктура, Результат) Экспорт
	
	Перем XDTO_СвДовер;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если (ПодписантСтруктура.СтатусПодписанта = "2" 
		Или ПодписантСтруктура.СтатусПодписанта = "5") И ЗначениеЗаполнено(ПодписантСтруктура.МЧДСсылка) Тогда
		
		Если ЗначениеЗаполнено(ПодписантСтруктура.МЧД) И ЗначениеЗаполнено(ПодписантСтруктура.ДатаВыпускаМЧД) Тогда
			XDTO_СвДовер = КС.XDTO_СвДовер(НомерТитула, , ПодписантСтруктура.МЧД, ПодписантСтруктура.ДатаВыпускаМЧД);
			КС.XDTO_Установить(XDTO_Подписант, "СвДовер", XDTO_СвДовер);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПодписантСтруктура.ИдСистХран) Тогда 
			КС.XDTO_Установить(XDTO_Подписант, "ИдСистХран", ПодписантСтруктура.ИдСистХран);
		КонецЕсли;
		
		Результат.Вставить("ИдентификаторМЧД",	ПодписантСтруктура.МЧД);
		
	Иначе
		XDTO_СвДовер = Неопределено;
		Результат.Вставить("ИдентификаторМЧД",	"");
	КонецЕсли;
	
КонецПроцедуры

