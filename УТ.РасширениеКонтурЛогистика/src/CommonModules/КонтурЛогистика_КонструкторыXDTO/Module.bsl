Функция XDTO_УчастЭДО(ОрганизацияСсылка, ТипДокументооборота = "__UvUtoch", Формат = Неопределено) Экспорт 
		
	XDTO_УчастЭДО = НовыйДочернийОбъектXDTO(0, "УчастЭДО", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_УчастЭДО, "ИдУчастЭДО", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(ОрганизацияСсылка));	
	
	XDTO_ИП = НовыйДочернийОбъектXDTO(0, "УчастЭДО.ИП", ТипДокументооборота, Формат);
	XDTO_ЮЛ = НовыйДочернийОбъектXDTO(0, "УчастЭДО.ЮЛ", ТипДокументооборота, Формат);
	
	Если ОрганизацияСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.Ип Тогда 
				
		XDTO_Установить(XDTO_ИП, "ИННФЛ", ОрганизацияСсылка.ИНН);
		
		XDTO_ФИО = НовыйДочернийОбъектXDTO(0, "УчастЭДО.ИП.ФИО", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ФИО, "Фамилия", 	ОрганизацияСсылка.Фамилия);
		XDTO_Установить(XDTO_ФИО, "Имя", 		ОрганизацияСсылка.Имя);
		XDTO_Установить(XDTO_ФИО, "Отчество", 	ОрганизацияСсылка.Отчество);
		
		XDTO_Установить(XDTO_ИП, "ФИО", XDTO_ФИО);
		
	ИначеЕсли ОрганизацияСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда 
		
		XDTO_Установить(XDTO_ЮЛ, "НаимОрг", ОрганизацияСсылка.НаименованиеОрганизацииПолное);
		XDTO_Установить(XDTO_ЮЛ, "ИННЮЛ", 	ОрганизацияСсылка.ИНН);
		XDTO_Установить(XDTO_ЮЛ, "КПП", 	ОрганизацияСсылка.КПП);
		
	Иначе
		ВызватьИсключение "Не поддерживаемый тип лица организации.";
	КонецЕсли;

	XDTO_Установить(XDTO_УчастЭДО, "ИП", XDTO_ИП);
	XDTO_Установить(XDTO_УчастЭДО, "ЮЛ", XDTO_ЮЛ);
	
	Возврат XDTO_УчастЭДО;
	
КонецФункции

Функция XDTO_СвУведУточ(ТитулСсылка, ТипДокументооборота = "__UvUtoch", Формат = Неопределено) Экспорт 
		
	XDTO_СвУведУточ = НовыйДочернийОбъектXDTO(0, "СвУведУточ", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СвУведУточ, "ДатаПол", XDTO_ДатаТип(ТекущаяДатаСеанса()));
	XDTO_Установить(XDTO_СвУведУточ, "ВремяПол", XDTO_ВремяТип_Устар(ТекущаяДатаСеанса()));
	XDTO_Установить(XDTO_СвУведУточ, "ТекстУведУточ", ТитулСсылка.ПричинаОтказаВПодписи);
			
	XDTO_СведПолФайл = НовыйДочернийОбъектXDTO(0, "СвУведУточ.СведПолФайл", ТипДокументооборота, Формат);
	
	Если ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда 
		XDTO_Установить(XDTO_СведПолФайл, "ИмяПолФайла", СокрЛП(ТитулСсылка.ИдФайлИнфГО));
		XDTO_Установить(XDTO_СведПолФайл, "ЭППолФайл", ТитулСсылка.ЭПГО);
	ИначеЕсли ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6") Тогда 
		XDTO_Установить(XDTO_СведПолФайл, "ИмяПолФайла", СокрЛП(ТитулСсылка.ИдФайлПУДИнфПрв));
		XDTO_Установить(XDTO_СведПолФайл, "ЭППолФайл", ТитулСсылка.ЭП);
	ИначеЕсли ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2") Тогда 
		XDTO_Установить(XDTO_СведПолФайл, "ИмяПолФайла", СокрЛП(ТитулСсылка.ИдФайлИнфСоб));
		XDTO_Установить(XDTO_СведПолФайл, "ЭППолФайл", ТитулСсылка.ЭПСоб);
	КонецЕсли;	
	
	XDTO_Установить(XDTO_СвУведУточ, "СведПолФайл", XDTO_СведПолФайл);
			
	Возврат XDTO_СвУведУточ;
	
КонецФункции

Функция XDTO_СодИнфПА(НомерТитула, Формат = Неопределено, ДокТитул7) Экспорт
	
	НомерТитула = 7;
	
	XDTO_СодИнфПА = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПА");
	XDTO_Установить(XDTO_СодИнфПА, "УИД_ТрН", 	ДокТитул7.ДокументЭТРН.УИД);
	
	XDTO_Установить(XDTO_СодИнфПА, "СодОпер", 	"Получение указания о переадресовке");
	XDTO_Установить(XDTO_СодИнфПА, "ФормаПА", 	"Электронная");
	XDTO_Установить(XDTO_СодИнфПА, "ВидДост", 	"Электроное уведомление перевозчика о переадресовке");
	
	XDTO_Установить(XDTO_СодИнфПА, "ДатВрПА", 	XDTO_ДатаВремяВЗТип(ДокТитул7.ДатВрПА));
	XDTO_Установить(XDTO_СодИнфПА, "НалКоорТочВрПА", "1");
	
	Если ЗначениеЗаполнено(ДокТитул7.ЭПУвПА) Тогда 
		XDTO_Установить(XDTO_СодИнфПА, "ЭПУвПА", ДокТитул7.ЭПУвПА);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокТитул7.НомИспр) Тогда 
		XDTO_ИспрТрН = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПА.ИспрТрН");
		XDTO_Установить(XDTO_ИспрТрН, "НомерИспр", 	ДокТитул7.НомИспр);
		XDTO_Установить(XDTO_ИспрТрН, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул7.ДатаИспр));
		XDTO_Установить(XDTO_СодИнфПА, "ИспрТрН", 	XDTO_ИспрТрН);
	КонецЕсли;	
		
	// ОснПА
	
	СоставителиОснПА = Массив_XDTO_СоставителиДокумента(НомерТитула, ДокТитул7.ДокументЭТРН, ДокТитул7.СтороныСостДокОснПА, ДокТитул7.ДопСостДокОснПА);
	
	XDTO_ОснПА = XDTO_РеквДокТип(НомерТитула,
					ДокТитул7.НаимДокОснПА,
					ДокТитул7.НомерДокОснПА,
					ДокТитул7.ДатаДокОснПА,
					ДокТитул7.ИдДокОснПА,
					ДокТитул7.ДопСведДокОснПА,
					СоставителиОснПА);
									
	XDTO_Установить(XDTO_СодИнфПА, "ОснПА", XDTO_ОснПА);								
	
	Если ЗначениеЗаполнено(ДокТитул7.НовГрузПол) Тогда 
		XDTO_НовГрузПол = XDTO_УчастникТрН(НомерТитула, Формат, ДокТитул7.НовГрузПол);
		XDTO_Установить(XDTO_СодИнфПА, "НовГрузПол", XDTO_НовГрузПол);
	КонецЕсли;

	// НовПунктВыгр
	
	XDTO_АдрВыгруз = XDTO_АдресПунктаМаршрута(ДокТитул7.АдрВыгруз, НомерТитула);
	
	XDTO_НовПунктВыгр = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПА.НовПунктВыгр"); 
	XDTO_Установить(XDTO_НовПунктВыгр, "АдрВыгруз", XDTO_АдрВыгруз);
	XDTO_Установить(XDTO_НовПунктВыгр, "ДатВрНовВыгрПА", XDTO_ДатаВремяВЗТип(ДокТитул7.ДатВрНовВыгрПА));
	XDTO_Установить(XDTO_НовПунктВыгр, "НалКоорТочВрВгрПА", 1);
	
	XDTO_Установить(XDTO_СодИнфПА, "НовПунктВыгр", XDTO_НовПунктВыгр);
		
	//ОтметПА
	Если ДокТитул7.ОтметкиПА.Количество() > 0 Тогда 
		Для Каждого СтрокаОтметПА Из ДокТитул7.ОтметкиПА Цикл
				
			XDTO_ОтметПА = XDTO_Отмет(НомерТитула, Формат, ДокТитул7, СтрокаОтметПА, "СодИнфПА.ОтметПА");
			XDTO_СодИнфПА.ОтметПА.Добавить(XDTO_ОтметПА)
				
		КонецЦикла;
	КонецЕсли;

	// ИнфПол	TODO
	Если ДокТитул7.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул7.ИнфПол Цикл
				
				//XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, ДокТитул2, ОтметГП);
				//XDTO_СодИнфПрвПрием.ОтметГП.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфПА;
	
КонецФункции

Функция XDTO_СодИнфЗамен(НомерТитула, Формат = Неопределено, ДокТитул8) Экспорт
	
	НомерТитула = 8;
	
	XDTO_СодИнфЗамен = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗамен");
	XDTO_Установить(XDTO_СодИнфЗамен, "УИД_ТрН", 	ДокТитул8.ДокументЭТРН.УИД);
	
	XDTO_Установить(XDTO_СодИнфЗамен, "СодОпер", 	Перечисления.КонтурЛогистика_СодержаниеОперацииЭстафеты.СодержаниеОперацияДляТ8(ДокТитул8));
	
	XDTO_Установить(XDTO_СодИнфЗамен, "ДатВрЗамен", 	XDTO_ДатаВремяВЗТип(ДокТитул8.ДатВрЗамен));
	XDTO_Установить(XDTO_СодИнфЗамен, "НалКоорТочВрЗам", "1");
		
	Если ЗначениеЗаполнено(ДокТитул8.НомИспр) Тогда 
		XDTO_ИспрТрН = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗамен.ИспрТрН");
		XDTO_Установить(XDTO_ИспрТрН, "НомерИспр", 	ДокТитул8.НомИспр);
		XDTO_Установить(XDTO_ИспрТрН, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул8.ДатаИспр));
		XDTO_Установить(XDTO_СодИнфЗамен, "ИспрТрН", 	XDTO_ИспрТрН);
	КонецЕсли;	
		
	// ПричЗам
					
	Если ЗначениеЗаполнено(ДокТитул8.ПричЗамТекст)  Тогда
		XDTO_Установить(XDTO_СодИнфЗамен, "ПричЗамТекст", ДокТитул8.ПричЗамТекст);		
	Иначе
		
		СоставителиПричЗам = Массив_XDTO_СоставителиДокумента(НомерТитула, ДокТитул8.ДокументЭТРН, ДокТитул8.СтороныСостДокПричЗам, ДокТитул8.ДопСостДокПричЗам);
		
		XDTO_ПричЗамДок = XDTO_РеквДокТип(НомерТитула, ДокТитул8.НаимДокПричЗам, ДокТитул8.НомерДокПричЗам, ДокТитул8.ДатаДокПричЗам,
						ДокТитул8.ИдДокПричЗам, ДокТитул8.ДопСведДокПричЗам, СоставителиПричЗам);
		
		XDTO_Установить(XDTO_СодИнфЗамен, "ПричЗамДок", XDTO_ПричЗамДок);
		
	КонецЕсли;
	
	// ЗаменВодит
	
	Если ЗначениеЗаполнено(ДокТитул8.НовыеВодители) Тогда 
		
		XDTO_ЗаменВодит = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗамен.ЗаменВодит");
		
		Для Каждого СтрокаВодитель Из ДокТитул8.НовыеВодители Цикл 
			
			// ДокПерГрВод
			
			Если ЗначениеЗаполнено(СтрокаВодитель.НаимДокПерГрВод) Тогда 
				
				СоставителиДокПерГрВод = Массив_XDTO_СоставителиДокумента(НомерТитула, ДокТитул8.ДокументЭТРН, СтрокаВодитель.СтороныСостДокПерГрВод, СтрокаВодитель.ДопСостДокПерГрВод);
			
				XDTO_ДокПерГрВод = XDTO_РеквДокТип(НомерТитула,
									СтрокаВодитель.НаимДокПерГрВод,
									СтрокаВодитель.НомерДокПерГрВод,
									СтрокаВодитель.ДатаДокПерГрВод,
									СтрокаВодитель.ИдДокПерГрВод,
									СтрокаВодитель.ДопСведДокПерГрВод,
									СоставителиДокПерГрВод);
									
				XDTO_Установить(XDTO_ЗаменВодит, "ДокПерГрВод", XDTO_ДокПерГрВод);
			
			КонецЕсли;
			
			// НовВодит
			
			XDTO_СвВодит = XDTO_СвВодит(НомерТитула, СтрокаВодитель.Водитель,, "СодИнфЗамен.ЗаменВодит.НовВодит");
			
			НайденныеПутЛисты = ДокТитул8.ПутевыеЛисты.НайтиСтроки(Новый Структура("ИдентификаторСтрокиВодители", СтрокаВодитель.ИдентификаторСтроки));
			Для Каждого НайденныйПутЛист Из НайденныеПутЛисты Цикл
				
				СостПутевогоЛиста = Массив_XDTO_СоставителиДокумента(
										НомерТитула,
										ДокТитул8.ДокументЭТРН,
										НайденныйПутЛист.СтороныСостДок,
										НайденныйПутЛист.ДопСостДок);
				
				XDTO_ПутевойЛист = XDTO_РеквДокТип(НомерТитула, НайденныйПутЛист.НаимДок, НайденныйПутЛист.НомерДок, 
									НайденныйПутЛист.ДатаДок, НайденныйПутЛист.ИдДок, НайденныйПутЛист.ДопСведДок, СостПутевогоЛиста);	
									
				XDTO_СвВодит.ПутевойЛист.Добавить(XDTO_ПутевойЛист);					
									
			КонецЦикла;
						
			XDTO_Установить(XDTO_ЗаменВодит, "НовВодит", XDTO_СвВодит);
			
			XDTO_СодИнфЗамен.ЗаменВодит.Добавить(XDTO_ЗаменВодит);					
			
		КонецЦикла;	
				
	КонецЕсли;

	// ЗаменТС
	
	Если ЗначениеЗаполнено(ДокТитул8.ЗаменТС) Тогда 
		
		XDTO_ЗаменТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗамен.ЗаменТС");
		
		Для Каждого СтрокаЗам Из ДокТитул8.ЗаменТС Цикл  
			
			ОтборСтрок = Новый Структура("ИдентификаторСтрокиЗаменТС", СтрокаЗам.ИдентификаторСтроки);
			
			// ДокПерГр
			
			НайденныеДокументы = ДокТитул8.ДокументыОПередачеГруза.НайтиСтроки(ОтборСтрок);
			
			Если ЗначениеЗаполнено(НайденныеДокументы) Тогда 
				
				Для Каждого нДокумент Из НайденныеДокументы Цикл
				
					Если ЗначениеЗаполнено(нДокумент.НаимДокПерГр) Тогда 
				
						СоставителиДокПерГр = Массив_XDTO_СоставителиДокумента(НомерТитула, ДокТитул8.ДокументЭТРН, нДокумент.СтороныСостДокПерГр, нДокумент.ДопСостДокПерГр);
					
						XDTO_ДокПерГр = XDTO_РеквДокТип(НомерТитула,
											нДокумент.НаимДокПерГр,
											нДокумент.НомерДокПерГр,
											нДокумент.ДатаДокПерГр,
											нДокумент.ИдДокПерГр,
											нДокумент.ДопСведДокПерГр,
											СоставителиДокПерГр);
											
						XDTO_Установить(XDTO_ЗаменТС, "ДокПерГр", XDTO_ДокПерГр);
						
					КонецЕсли;
				
				КонецЦикла;
				
			КонецЕсли;		
			
			// СпецУслДвиж
			
			НайденныеСпецУсловия = ДокТитул8.СпецУсловияДвижения.НайтиСтроки(ОтборСтрок);
			
			Если ЗначениеЗаполнено(НайденныеСпецУсловия) Тогда 
				
				Для Каждого СпецУсловие Из НайденныеСпецУсловия Цикл 
					
					Если ЗначениеЗаполнено(СпецУсловие.НомСР) Или ЗначениеЗаполнено(СпецУсловие.ИдСР) Тогда
						
						XDTO_СпецУслДвиж = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗамен.ЗаменТС.СпецУслДвиж"); 
						
						Если ЗначениеЗаполнено(СпецУсловие.НомСР) Тогда 
							XDTO_Установить(XDTO_СпецУслДвиж, "НомСР", 	СпецУсловие.НомСР);
							XDTO_Установить(XDTO_СпецУслДвиж, "ДатаСР", XDTO_ДатаТип(СпецУсловие.ДатаСР));				
							XDTO_Установить(XDTO_СпецУслДвиж, "СрокСР", СпецУсловие.СрокСР);
						Иначе
							XDTO_Установить(XDTO_СпецУслДвиж, "ИдСР", СпецУсловие.ИдСР);
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СпецУсловие.МршТекст) Тогда 
							
							XDTO_СведМрш = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗамен.ЗаменТС.СпецУслДвиж.СведМрш");
							XDTO_Установить(XDTO_СведМрш, "МршТекст", СпецУсловие.МршТекст);
							
							XDTO_Установить(XDTO_СпецУслДвиж, "СведМрш", XDTO_СведМрш);
							
							XDTO_ЗаменТС.СпецУслДвиж.Добавить(XDTO_СпецУслДвиж);
							
						КонецЕсли;
					
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			// ТС
			
			НайденныеТС = ДокТитул8.НовыеТранспортныеСредства.НайтиСтроки(ОтборСтрок);
			
			Для каждого НайденноеТС Из НайденныеТС Цикл
			
				XDTO_ТС = XDTO_ПараметрыТС(НомерТитула, НайденноеТС.ТранспортноеСредство, ДокТитул8);
							
				XDTO_Установить(XDTO_ЗаменТС, "ТС", XDTO_ТС);
							
			КонецЦикла;
			
			// Прицепы
			
			НайденныеПрицепы = ДокТитул8.НовыеПрицепы.НайтиСтроки(ОтборСтрок);
			
			Для каждого НайденныйПрицеп Из НайденныеПрицепы Цикл
			
				XDTO_Прицеп = XDTO_ПараметрыТС(НомерТитула, НайденныйПрицеп.Прицеп, ДокТитул8);
							
				XDTO_ЗаменТС.Прицеп.Добавить(XDTO_Прицеп);
							
			КонецЦикла;			
			
			XDTO_СодИнфЗамен.ЗаменТС.Добавить(XDTO_ЗаменТС);
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	//ОтметЗам
	Если ДокТитул8.ОтметЗам.Количество() > 0 Тогда 
		Для Каждого СтрокаОтметЗам Из ДокТитул8.ОтметЗам Цикл
				
			XDTO_ОтметЗам = XDTO_Отмет(НомерТитула, Формат, ДокТитул8, СтрокаОтметЗам, "СодИнфЗамен.ОтметЗам");
			XDTO_СодИнфЗамен.ОтметЗам.Добавить(XDTO_ОтметЗам)
				
		КонецЦикла;
	КонецЕсли;

	// ИнфПол	TODO
	Если ДокТитул8.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул8.ИнфПол Цикл
				
				//XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, ДокТитул2, ОтметГП);
				//XDTO_СодИнфПрвПрием.ОтметГП.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфЗамен;
	
КонецФункции

Функция XDTO_СвГО(НомерТитула, Формат = "5.01", ДокТитул1, ТипДокументооборота = "__etrnTitle")
	
	ДокументЭТРН = ДокТитул1.ДокументЭТРН;
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвГО", ТипДокументооборота, Формат);
	Если ДокументЭТРН.ЭтоЭкспедиция Тогда 
		ГОЭксп = "1";
	Иначе
		ГОЭксп = "0";
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "ГОЭксп", ГОЭксп);
	XDTO_Установить(XDTO_Объект, "РекИдентГО", XDTO_УчастникТрН(НомерТитула, Формат, ДокументЭТРН.Грузоотправитель));
	
	// TODO СвГО
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СВ_СвГО(НомерТитула, Формат = "5.01", ДокТитулПВ)
	
	ТипДокументооборота = "__SoprVed";
	ДокументСВ = ДокТитулПВ.ДокументСВ;
	ГО = ДокументСВ.Грузоотправитель;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвГО", "__SoprVed");
	
	Если ГО.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда 
		XDTO_Установить(XDTO_Объект, "ГО_ЮЛ", XDTO_УчастникЗНСВ_ЮЛ(НомерТитула, Формат, ГО, ТипДокументооборота));
	ИначеЕсли ГО.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
		XDTO_Установить(XDTO_Объект, "ГО_ИП", XDTO_УчастникСВФЛ(НомерТитула, Формат, ГО));
	ИначеЕсли ГО.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо Тогда
		XDTO_Установить(XDTO_Объект, "ГО_ФЛ", XDTO_УчастникСВФЛ(НомерТитула, Формат, ГО));
	Иначе
		ВызватьИсключение "Недоступный тип лица " + ДокументСВ.Грузоотправитель.ТипЛица + "для" + ГО;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитулПВ.ОтвЛицоГО) Тогда 	
		XDTO_Установить(XDTO_Объект, "ОтвПогрузФЛ", XDTO_СведОтвЛицоТип(НомерТитула, Формат, ДокТитулПВ.ОтвЛицоГО));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитулПВ.ОтвЛицоГО_ЮЛ) Тогда 	
		XDTO_Установить(XDTO_Объект, "ОтвПогрузЮЛ", XDTO_УчастникЗНСВ_ЮЛ(НомерТитула, Формат, ДокТитулПВ.ОтвЛицоГО_ЮЛ, ТипДокументооборота));
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СВ_СвГП(НомерТитула, Формат = "5.01", ДокТитулПВ)
	
	ТипДокументооборота = "__SoprVed";
	ДокументСВ = ДокТитулПВ.ДокументСВ;
	ГП = ДокументСВ.Грузополучатель;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвГП", "__SoprVed");
	
	Если ГП.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда 
		XDTO_Установить(XDTO_Объект, "ГП_ЮЛ", XDTO_УчастникЗНСВ_ЮЛ(НомерТитула, Формат, ГП, ТипДокументооборота));
	ИначеЕсли ГП.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
		XDTO_Установить(XDTO_Объект, "ГП_ИП", XDTO_УчастникСВФЛ(НомерТитула, Формат, ГП));
	ИначеЕсли ГП.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо Тогда
		XDTO_Установить(XDTO_Объект, "ГП_ФЛ", XDTO_УчастникСВФЛ(НомерТитула, Формат, ГП));
	Иначе
		ВызватьИсключение "Недоступный тип лица " + ГП.ТипЛица + "для" + ГП;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитулПВ.ОтвЛицоГП) Тогда 	
		XDTO_Установить(XDTO_Объект, "ОтвПриемФЛ", XDTO_СведОтвЛицоТип(НомерТитула, Формат, ДокТитулПВ.ОтвЛицоГП));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитулПВ.ОтвЛицоГП_ЮЛ) Тогда 	
		XDTO_Установить(XDTO_Объект, "ОтвПриемЮЛ", XDTO_УчастникЗНСВ_ЮЛ(НомерТитула, Формат, ДокТитулПВ.ОтвЛицоГП_ЮЛ, ТипДокументооборота));
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СВ_СвПер(НомерТитула, Формат = "5.01", ДокТитулПВ)
	
	ТипДокументооборота = "__SoprVed";
	ДокументСВ = ДокТитулПВ.ДокументСВ;
	Прв = ДокументСВ.Перевозчик;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвПрв", "__SoprVed");
	
	Если Прв.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда 
		XDTO_Установить(XDTO_Объект, "ПрвЮЛ", XDTO_УчастникЗНСВ_ЮЛ(НомерТитула, Формат, Прв, ТипДокументооборота));
	ИначеЕсли Прв.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
		XDTO_Установить(XDTO_Объект, "ПрвИП", XDTO_УчастникСВФЛ(НомерТитула, Формат, Прв));
	Иначе
		ВызватьИсключение "Недоступный тип лица " + Прв.ТипЛица + "для" + Прв;
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "СвОтвПрвз", XDTO_СведОтвЛицоТип(НомерТитула, Формат, ДокТитулПВ.ОтвЛицоПВ));
	
	// Сведения о водителе	СвВодит   (водителях)
	XDTO_СвВодит = XDTO_СвВодит(НомерТитула, ДокТитулПВ.Водитель, ТипДокументооборота);
	XDTO_Объект.СвВодит.Добавить(XDTO_СвВодит);
	Для Каждого ДопВодитель Из ДокТитулПВ.ДополнительныеВодители Цикл 
		XDTO_СвВодит = XDTO_СвВодит(НомерТитула, ДопВодитель.Водитель, ТипДокументооборота);
		XDTO_Объект.СвВодит.Добавить(XDTO_СвВодит);
	КонецЦикла;
	
	// Сведения о путевом листе (путевых листах)
	XDTO_ПутЛист = XDTO_ПутЛист(ДокТитулПВ, НомерТитула, ТипДокументооборота, ДокТитулПВ.ПутевойЛистНомер, ДокТитулПВ.ПутевойЛистДата, ДокТитулПВ.ПутевойЛистСрокДействия);
	XDTO_Объект.ПутевойЛист.Добавить(XDTO_ПутЛист);
	Для Каждого ДопПутевой Из ДокТитулПВ.ДополнительныеВодители Цикл
		XDTO_ПутЛист = XDTO_ПутЛист(ДокТитулПВ, НомерТитула, ТипДокументооборота, ДопПутевой.ПутевойЛистНомер, ДопПутевой.ПутевойЛистДата, ДопПутевой.ПутевойЛистСрокДействия);
		XDTO_Объект.ПутевойЛист.Добавить(XDTO_ПутЛист);
	КонецЦикла;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СведОтвЛицоТип(НомерТитула, Формат = Неопределено, ЛогистикаСотрудник)
	
	ТипДокументооборота = "__SoprVed";
	
	XDTO_Объект = НовыйБазовыйОбъектXDTO(НомерТитула, "СведОтвЛицоТип", "__SoprVed");
	
	// ФИО
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота);
	XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ЛогистикаСотрудник.Фамилия);
	XDTO_Установить(XDTO_ФИО,	 "Имя",			ЛогистикаСотрудник.Имя);
	XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ЛогистикаСотрудник.Отчество);
	XDTO_Установить(XDTO_Объект, "ФИО", 		XDTO_ФИО);
	
	// АдрМЖ
	Если ЗначениеЗаполнено(ЛогистикаСотрудник.АдресМестаЖительства) Тогда 
		
		XDTO_Адрес = НовыйБазовыйОбъектXDTO(НомерТитула, "АдресТип", ТипДокументооборота);
		
		XDTO_АдрИнф = НовыйБазовыйОбъектXDTO(НомерТитула, "АдрИнфТип", ТипДокументооборота);
		КодСтраны = "643";
		Если ЗначениеЗаполнено(ЛогистикаСотрудник.АдресМестаЖительстваСтрана) Тогда
			КодСтраны = ЛогистикаСотрудник.АдресМестаЖительстваСтрана.Код;
		КонецЕсли;
		XDTO_Установить(XDTO_АдрИнф, "КодСтр", КодСтраны);
		XDTO_Установить(XDTO_АдрИнф, "АдрТекст", ЛогистикаСотрудник.АдресМестаЖительства);
		XDTO_Установить(XDTO_Адрес, "АдрИнф", XDTO_АдрИнф);
		
		XDTO_Установить(XDTO_Объект, "АдрМЖ", 		XDTO_Адрес);
		
	КонецЕсли;
		
	// СредСвяз	
	XDTO_Контакт = НовыйБазовыйОбъектXDTO(НомерТитула, "КонтактТип", ТипДокументооборота);
	Если ЗначениеЗаполнено(ЛогистикаСотрудник.ТелефонОсновной) Тогда 
		XDTO_Контакт.Тлф.Добавить(СокрЛП(ЛогистикаСотрудник.ТелефонОсновной));
	КонецЕсли;
	Если ЗначениеЗаполнено(ЛогистикаСотрудник.ТелефонЗапасной) Тогда 
		XDTO_Контакт.Тлф.Добавить(СокрЛП(ЛогистикаСотрудник.ТелефонЗапасной));
	КонецЕсли;
	XDTO_Установить(XDTO_Объект, "СредСвяз", 		XDTO_Контакт);

	Возврат XDTO_Объект;
	
КонецФункции

