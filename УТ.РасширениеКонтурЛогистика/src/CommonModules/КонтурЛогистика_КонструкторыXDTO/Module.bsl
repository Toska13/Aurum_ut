			Иначе
				НоваяОрганизация.ДополнительныеСвойства.Вставить("ПолучитьИдентификаторУчастникаЭДОИзДиадок");
			КонецЕсли;
		
			НоваяОрганизация.ДополнительныеСвойства.Вставить("СинхронизироватьИзСервисаЛогистика");
		
			НоваяОрганизация.Записать();
			ОрганизацияДиадок = НоваяОрганизация.Ссылка;
			
		Иначе
			
