		Иначе
			XDTO_Установить(XDTO_Объект, "СвЮЛ", XDTO_УчастникЮЛ(НомерТитула, Формат, ДокументКонтейнер.Фрахтователь, ТипДокументооборота));
		КонецЕсли;
		
	КонецЕсли;
	
