	СтруктураСущности.Вставить(ДопРеквизитИмя + "_АдресГород", 			СокрЛП(ЗначениеВРеквизите.АдресГород));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_АдресНаселПункт", 	СокрЛП(ЗначениеВРеквизите.АдресНаселПункт));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_АдресУлица", 			СокрЛП(ЗначениеВРеквизите.АдресУлица));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_АдресРайон", 			СокрЛП(ЗначениеВРеквизите.АдресРайон));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_АдресДом", 			СокрЛП(ЗначениеВРеквизите.АдресДом));
