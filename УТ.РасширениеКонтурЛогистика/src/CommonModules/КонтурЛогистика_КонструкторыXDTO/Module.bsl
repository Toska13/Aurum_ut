Функция КорневаяФабрикаXDTOКонтурЛогистика(Формат) Экспорт
	
	МассивСхемXML = Новый Массив;
	
	МассивПакетов = Новый Массив;
	
	Если Формат = "5.01" Тогда
		
		ПостфиксФормата = "";
		
		ДобавитьПакетыЭТРН(МассивПакетов, ПостфиксФормата);
		ДобавитьПакетыЗаказНаряд(МассивПакетов, ПостфиксФормата);
		ДобавитьПакетыСопроводительнойВедомомсти(МассивПакетов, ПостфиксФормата);
		ДобавитьПакетыПутевогоЛиста(МассивПакетов, ПостфиксФормата);
		ДобавитьПакетыЗаказЗаявка(МассивПакетов, ПостфиксФормата);
		ДобавитьПакетыДоговораФрахтования(МассивПакетов, ПостфиксФормата);
		
	ИначеЕсли Формат = "5.02" Тогда
		
		ПостфиксФормата = "_5_02";
		
		ДобавитьПакетыПутевогоЛиста_5_02(МассивПакетов, ПостфиксФормата);
				
	ИначеЕсли Формат = "1.01" Или Формат = "1.02" Или Формат = "1.03" Тогда	
		
		// Уведомление об уточнении
		МассивПакетов.Добавить("__UvUtoch");
		
		// Экспедиторская расписка
		МассивПакетов.Добавить("__ForwardingReceipt");
		
	Иначе
		
		ВызватьИсключение "Неизвестная версия формата " + Формат;
		
	КонецЕсли;
	
	НаборСхемXML = Новый НаборСхемXML;
	
	Для Каждого ИмяПакета Из МассивПакетов Цикл 
		
		ИмяМакета = "КонтурЛогистика_XDTOПакет" + ИмяПакета;
		
		ТекстМакета	 = ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстМакета);
		
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		ПостроительСхемXML = Новый ПостроительСхемXML;
		СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
		
		НаборСхемXML.Добавить(СхемаXML);
		
	КонецЦикла;
	
	ФабрикаXDTOНакладной = Новый ФабрикаXDTO(НаборСхемXML);
	
	Возврат ФабрикаXDTOНакладной;
	
КонецФункции

Процедура ДобавитьПакетыСопроводительнойВедомомсти(Знач МассивПакетов, Знач ПостфиксФормата)
	
	МассивПакетов.Добавить("__SoprVed1" + ПостфиксФормата);
	МассивПакетов.Добавить("__SoprVed2" + ПостфиксФормата);
	МассивПакетов.Добавить("__SoprVed3" + ПостфиксФормата);

КонецПроцедуры

