Функция Конвертировать_СвВодит_вВодителяЛогистикаМедосмотра(XDTO_СвВодит, Титул1) Экспорт
	
	ВодительЛогистика = Справочники.КонтурЛогистика_Сотрудники.ПустаяСсылка();
	
	Если XDTO_СвВодит <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(Титул1) Тогда
			
			Если ЗначениеЗаполнено(Титул1.Водитель) 
				И СокрЛП(Титул1.Водитель.Фамилия) = СокрЛП(XDTO_Вычислить(XDTO_СвВодит, "ФИО.Фамилия"))
				И СокрЛП(Титул1.Водитель.Имя)	 = СокрЛП(XDTO_Вычислить(XDTO_СвВодит, "ФИО.Имя")) Тогда 
				
				ВодительЛогистика = Титул1.Водитель; 
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Титул1.Водитель2) 
				И СокрЛП(Титул1.Водитель2.Фамилия) = СокрЛП(XDTO_Вычислить(XDTO_СвВодит, "ФИО.Фамилия"))
				И СокрЛП(Титул1.Водитель2.Имя)	 = СокрЛП(XDTO_Вычислить(XDTO_СвВодит, "ФИО.Имя")) Тогда 
				
				ВодительЛогистика = Титул1.Водитель2; 
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ВодительЛогистика) Тогда // водитель мог быть заменен на другого
				
				ВодительЛогистика = Конвертировать_СвВодит_вВодителяЛогистика(XDTO_СвВодит);
				
			КонецЕсли;
			
		Иначе
			
			ВодительЛогистика = Конвертировать_СвВодит_вВодителяЛогистика(XDTO_СвВодит);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат ВодительЛогистика;
	
КонецФункции

