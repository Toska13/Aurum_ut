	Если Не ДокТитул3.ЕстьОтказВПодписи Тогда  
		XDTO_Установить(XDTO_СодИнфТехСост, "ДатВрВыпНаЛин", 			XDTO_ДатаВремяВЗТип(ДокТитул3.ДатВрВыпНаЛин));
		XDTO_Установить(XDTO_СодИнфТехСост, "НалКоорТочВрВыпНаЛин", 	"1");
	КонецЕсли;
	
	Титул1 = 		ДокТитул3.Титул1;
	ТехРаботник = 	ДокТитул3.ТехРаботник;
	ТС = 			Титул1.ТранспортноеСредство;
	Прицеп = 		Титул1.Прицеп;
	Прицеп2 = 		Титул1.Прицеп2;

	XDTO_СвОтвЛиц = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост.СвОтвЛиц", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СвОтвЛиц, "Должн", ДокТитул3.Должность);
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ТехРаботник.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		ТехРаботник.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	ТехРаботник.Отчество);
	XDTO_Установить(XDTO_СвОтвЛиц, "ФИО", XDTO_ФИО);
	
	XDTO_Установить(XDTO_СодИнфТехСост, "СвОтвЛиц", XDTO_СвОтвЛиц);
	
	// СвТС
	XDTO_СвТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост.СвТС", ТипДокументооборота, Формат);
	XDTO_ТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост.СвТС.ТС", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ТС, 	"Тип", 			Титул1.ТранспортноеСредство.ТипТС);
	XDTO_Установить(XDTO_ТС, 	"Марка", 		Титул1.ТранспортноеСредство.МаркаТС);
	XDTO_Установить(XDTO_ТС, 	"Модель", 		Титул1.ТранспортноеСредство.МодельТС);
	XDTO_Установить(XDTO_ТС, 	"РегНомер", 	Титул1.ТранспортноеСредство.РегНомер);
	XDTO_Установить(XDTO_ТС, 	"ИнвНомер", 	Титул1.ТранспортноеСредство.ИнвНомер);
	XDTO_Установить(XDTO_СвТС, "ТС", XDTO_ТС);
	
	Если ЗначениеЗаполнено(Прицеп) Тогда 
		XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост.СвТС.Прицеп", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Прицеп, 	"Марка", 		Прицеп.МаркаТС);
		XDTO_Установить(XDTO_Прицеп, 	"Модель", 		Прицеп.МодельТС);
		XDTO_Установить(XDTO_Прицеп, 	"РегНомер", 	Прицеп.РегНомер);
		XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Прицеп2) Тогда 
		XDTO_Прицеп2 = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост.СвТС.Прицеп", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Прицеп2, 	"Марка", 		Прицеп2.МаркаТС);
		XDTO_Установить(XDTO_Прицеп2, 	"Модель", 		Прицеп2.МодельТС);
		XDTO_Установить(XDTO_Прицеп2, 	"РегНомер", 	Прицеп2.РегНомер);
		XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп2);
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодИнфТехСост, "СвТС", XDTO_СвТС);
	
	Возврат XDTO_СодИнфТехСост;
	
КонецФункции

