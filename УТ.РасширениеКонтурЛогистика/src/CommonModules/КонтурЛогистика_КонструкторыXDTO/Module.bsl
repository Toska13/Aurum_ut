Функция XDTO_СвПрочУсл(НомерТитула, Формат = Неопределено, ДокТитул2, СтрокаТЧСвПрочУсл)
	
	ТипДокументооборота = "__zakazNarTitle";
	
	ДокументЗН = ДокТитул2.ДокументЗН;
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФщ.СвПрочУсл", ТипДокументооборота);
	
	// Спец. разрешение
	XDTO_Установить(XDTO_Объект,	 "НомСР", 	СтрокаТЧСвПрочУсл.НомСР);
	Если ЗначениеЗаполнено(СтрокаТЧСвПрочУсл.ДатаСР) Тогда 
		XDTO_Установить(XDTO_Объект,	 "ДатаСР", 	XDTO_ДатаТип(СтрокаТЧСвПрочУсл.ДатаСР));
	КонецЕсли;
	XDTO_Установить(XDTO_Объект,	 "СрокСР", 	СтрокаТЧСвПрочУсл.СрокСР);
	XDTO_Установить(XDTO_Объект,	 "ИдСР", 	СтрокаТЧСвПрочУсл.ИдСР);
	
	// Режим труда и отдыха водителя (экипажа) в пути следования
	XDTO_Установить(XDTO_Объект,	 "РежТрОтд", 	СтрокаТЧСвПрочУсл.РежТрОтд);
	
	// Установленный маршрут движения тяжеловесного и (или) крупногабаритного транспортного средства, транспортного средства, перевозящего опасный груз
	Если ЗначениеЗаполнено(СтрокаТЧСвПрочУсл.Маршрут) ИЛИ ЗначениеЗаполнено(СтрокаТЧСвПрочУсл.МаршрутМашиночитаемый) Тогда 
		XDTO_СведМрш = НовыйБазовыйОбъектXDTO(НомерТитула, "СведМршТип", ТипДокументооборота);
		Если ЗначениеЗаполнено(СтрокаТЧСвПрочУсл.Маршрут) Тогда 
			XDTO_Установить(XDTO_СведМрш,	 "МршТекст", 	СтрокаТЧСвПрочУсл.Маршрут);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЧСвПрочУсл.МаршрутМашиночитаемый) Тогда 
			XDTO_Установить(XDTO_СведМрш,	 "МршМашЧит", 	СтрокаТЧСвПрочУсл.МаршрутМашиночитаемый);
		КонецЕсли;
	КонецЕсли;
	
	// СвАкт
	АктыЭтойСтроки = ДокТитул2.Акты.НайтиСтроки(Новый Структура("ИдентификаторСтрокиСвПрочУсл", СтрокаТЧСвПрочУсл.ИдентификаторСтроки));
	Для Каждого СтрокаАкта Из АктыЭтойСтроки Цикл 
		XDTO_РеквДокТип = XDTO_АктПоСтрокеАкта(ДокументЗН, НомерТитула, СтрокаАкта, ТипДокументооборота)			
	КонецЦикла;
	
	Возврат XDTO_Объект;
	
КонецФункции

