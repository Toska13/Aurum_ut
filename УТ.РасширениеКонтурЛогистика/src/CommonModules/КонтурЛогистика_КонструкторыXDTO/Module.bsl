		XDTO_Установить(XDTO_СвМедРабИЛИОрг, "НаимМедОрг", 	Титул1.ОрганизацияМедик.НаименованиеОрганизацииПолное);
		XDTO_Установить(XDTO_СвМедРабИЛИОрг, "ИННЮЛ", Титул1.ОрганизацияМедик.ИНН);
		XDTO_Установить(XDTO_СвМедРабИЛИОрг, "КПП", Титул1.ОрганизацияМедик.КПП);
	КонецЕсли;
	
	// одинаковые структурно для СвМедРаб и СвМедОрг
	XDTO_Установить(XDTO_СвМедРабИЛИОрг, "Должн", ДокТитул2или5.Должность);	
	
	XDTO_ЛицензМО = НовыйБазовыйОбъектXDTO(НомерТитула, "ЛицензМОТип", ТипДокументооборота, Формат);
