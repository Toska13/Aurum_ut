Функция XDTO_СодИнфГП(НомерТитула, Формат = Неопределено, ДокТитул3) Экспорт
	
	НомерТитула = 3;
	
	XDTO_СодИнфГП = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГП");
	XDTO_Установить(XDTO_СодИнфГП, "УИД_ТрН", ДокТитул3.ДокументЭТРН.УИД);
	
	Если ДокТитул3.ОтказВПриемке Тогда
		
		XDTO_Установить(XDTO_СодИнфГП, "СодОпОтк", 	"Лицом, управомоченным на получение груза, при указанных обстоятельствах отказано в принятии от перевозчика груза с указанными характеристиками");
		XDTO_Установить(XDTO_СодИнфГП, "ПричОтк", 	ДокТитул3.ПричОтк);
		
	Иначе
		
		Если ДокТитул3.ПринятьЧастично Тогда
			XDTO_Установить(XDTO_СодИнфГП, "СодОпПр", 	"Частичная выгрузка");
		Иначе
			XDTO_Установить(XDTO_СодИнфГП, "СодОпПр", 	"Лицом, управомоченным на получение груза, при указанных обстоятельствах принят от перевозчика груз с указанными характеристиками");
		КонецЕсли;
		XDTO_ПриемГрузГП = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГП.ПриемГрузГП");
		
		ЧасовойПоясРазгрузки = ДокТитул3.МестоВыгрузки.ЧасовойПояс;		
		
		XDTO_Установить(XDTO_ПриемГрузГП, "ФДатВрПриб", XDTO_ДатаВремяВЗТип(ДокТитул3.ФДатВрПриб, ЧасовойПоясРазгрузки));
		XDTO_Установить(XDTO_ПриемГрузГП, "НалКоорТочВрФПр", "1");

		XDTO_Установить(XDTO_ПриемГрузГП, "ФДатВрУбыт", XDTO_ДатаВремяВЗТип(ДокТитул3.ФДатВрУбыт, ЧасовойПоясРазгрузки));
		XDTO_Установить(XDTO_ПриемГрузГП, "НалКоорТочВрФУб", "1");

		XDTO_Установить(XDTO_ПриемГрузГП, "ЗаявДатВрПриб", XDTO_ДатаВремяВЗТип(ДокТитул3.ЗаявДатВрПриб, ЧасовойПоясРазгрузки));
		XDTO_Установить(XDTO_ПриемГрузГП, "НалКоорТочВрЗПр", "1");
		
		XDTO_Установить(XDTO_ПриемГрузГП, "МетОпрМасс", Перечисления.КонтурЛогистика_МетодыОпределенияМассы.ЗначениеДляXDTO(ДокТитул3.МетодОпределенияМассы));
		
		XDTO_Установить(XDTO_ПриемГрузГП, "КолМестПриемЧ", ДокТитул3.КоличествоМестПринято);
		
		ОбщСвСост = ДокТитул3.ОбщееСостояние;
		Если Не ЗначениеЗаполнено(СокрЛП(ОбщСвСост)) Тогда 
			ОбщСвСост = "Без замечаний";
		КонецЕсли;
		XDTO_Установить(XDTO_ПриемГрузГП, "ОбщСвСост", ОбщСвСост);
		
		XDTO_Установить(XDTO_ПриемГрузГП, "МасБрутЗначПрием", ДокТитул3.МассаБруттоКг);
		XDTO_Установить(XDTO_ПриемГрузГП, "МасНетЗначПрием", ДокТитул3.МассаНеттоКг);
		XDTO_Установить(XDTO_ПриемГрузГП, "Объем", ДокТитул3.Объем);
		
		XDTO_АдрВыгруз = XDTO_АдресПунктаМаршрута(ДокТитул3.МестоВыгрузки, НомерТитула); 
		XDTO_Установить(XDTO_ПриемГрузГП, "АдрВыгруз", XDTO_АдрВыгруз);
		
		// Грузы
		Если ДокТитул3.РазбиватьГрузыПоСтрокам Тогда
			Заполнить_ПриемГрузГП(XDTO_ПриемГрузГП, ДокТитул3, НомерТитула, Формат);
		КонецЕсли;
		XDTO_Установить(XDTO_СодИнфГП, "ПриемГрузГП", XDTO_ПриемГрузГП);
		
		// ИнфПол (СодИнфГП, общие у титула)
		Если ДокТитул3.ИнфПол.Количество() > 0 Тогда 
			Для Каждого СтрокаИнфПол Из ДокТитул3.ИнфПол Цикл
					
					XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфГП");
					XDTO_СодИнфГП.ИнфПол.Добавить(XDTO_ИнфПол)
					
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
	// ОтметГП
	Если ДокТитул3.ОтметкиГрузополучателя.Количество() > 0 Тогда
		
		Для Каждого СтрокаОтметГП Из ДокТитул3.ОтметкиГрузополучателя Цикл
				
			XDTO_ОтметГП = XDTO_Отмет(НомерТитула, Формат, ДокТитул3, СтрокаОтметГП, "СодИнфГП.ОтметГП");
			
			// ИнфПол блока ОтметГП
			Если ДокТитул3.ОтметкиИнфПол.Количество() > 0 Тогда 
				ПоискИнфПол = Новый Структура("ИдентификаторСтрокиОтметки", СтрокаОтметГП.ИдентификаторСтроки);
				СтрокиИнфПолЭтойОтметки = ДокТитул3.ОтметкиИнфПол.НайтиСтроки(ПоискИнфПол);
				
				Для Каждого СтрокаИнфПол Из СтрокиИнфПолЭтойОтметки Цикл
					
					XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфГП.ОтметГП");
					XDTO_ОтметГП.ИнфПол.Добавить(XDTO_ИнфПол)
					
				КонецЦикла;
			КонецЕсли;
			
			XDTO_СодИнфГП.ОтметГП.Добавить(XDTO_ОтметГП)
				
		КонецЦикла;
		
	КонецЕсли;
	
	// исправление
	Если ЗначениеЗаполнено(ДокТитул3.НомИспр) Тогда 
		XDTO_ИспрТрН = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГП.ИспрТрН");
		XDTO_Установить(XDTO_ИспрТрН, "НомИспр", 	ДокТитул3.НомИспр);
		XDTO_Установить(XDTO_ИспрТрН, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул3.ДатаИспр));
		XDTO_Установить(XDTO_СодИнфГП, "ИспрТрН", 	XDTO_ИспрТрН);
	КонецЕсли;
	
	Возврат XDTO_СодИнфГП;
	
КонецФункции

Функция XDTO_СодСВИнфПрв(НомерТитула, Формат = Неопределено, ДокТитул13579) Экспорт

	ТипДО = "__SoprVed";
	
	ДокументСВ = ДокТитул13579.ДокументСВ;
	XDTO_СодСВИнфПрв = НовыйДочернийОбъектXDTO(1, "СодСВИнфПрв", ТипДО);
	XDTO_Установить(XDTO_СодСВИнфПрв, "УИД_СВ", 	ДокТитул13579.УИД_СВ);
	XDTO_Установить(XDTO_СодСВИнфПрв, "НомерСВ", 	ДокументСВ.НомерСВ);
	XDTO_Установить(XDTO_СодСВИнфПрв, "ДатаСВ", 	XDTO_ДатаТип(ДокументСВ.ДатаСВ));
	
	// исправление
	Если ЗначениеЗаполнено(ДокТитул13579.НомИспр) Тогда 
		XDTO_ИспрСВ = НовыйДочернийОбъектXDTO(1, "СодСВИнфПрв.ИспрСВ", ТипДО);
		XDTO_Установить(XDTO_ИспрСВ, "НомИспр", 	ДокТитул13579.НомИспр);
		XDTO_Установить(XDTO_ИспрСВ, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул13579.ДатаИспр));
		XDTO_Установить(XDTO_СодСВИнфПрв, "ИспрСВ", 	XDTO_ИспрСВ);
	КонецЕсли;
	
	// Сведения о грузоотправителе	СвГО
	XDTO_СвГО = XDTO_СВ_СвГО(НомерТитула, , ДокТитул13579);
	XDTO_Установить(XDTO_СодСВИнфПрв, "СвГО", 	XDTO_СвГО);
	
	// Сведения о грузополучателе	СвГП
	XDTO_СвГП = XDTO_СВ_СвГП(НомерТитула, , ДокТитул13579);
	XDTO_Установить(XDTO_СодСВИнфПрв, "СвГП", 	XDTO_СвГП);
	
	// Сведения о грузе  СвГруз
	XDTO_СвГруз = XDTO_СвГруз(НомерТитула, , ДокТитул13579, ТипДО);
	XDTO_Установить(XDTO_СодСВИнфПрв, "СвГруз", 	XDTO_СвГруз);
	
	// Сведения о контейнерах СвКонтейн
	Для Каждого СтрокаКонтейнера Из ДокТитул13579.Контейнеры Цикл 
		XDTO_СвКонтейн = XDTO_СВ_СвКонтейн(НомерТитула, , ДокТитул13579, СтрокаКонтейнера);
		XDTO_СодСВИнфПрв.СвКонтейн.Добавить(XDTO_СвКонтейн);
	КонецЦикла;
	
	// Сдача (прием) контейнера (погрузка/выгрузка) СдачКонтПогрВыгр
	XDTO_СдачКонтПогрВыгр = XDTO_СдачКонтПогрВыгр(ДокТитул13579, НомерТитула, ТипДО);
	XDTO_Установить(XDTO_СодСВИнфПрв, "СдачКонтПогрВыгр", 	XDTO_СдачКонтПогрВыгр);
	
	// Сведения о перевозчике	СвПер
	XDTO_СвПер = XDTO_СВ_СвПер(НомерТитула, , ДокТитул13579);
	XDTO_Установить(XDTO_СодСВИнфПрв, "СвПрв", 	XDTO_СвПер);
	
	// Сведения о транспортном средстве	СвТС
	XDTO_СвТС = XDTO_СвТС(НомерТитула, , ДокТитул13579, ТипДО);
	XDTO_Установить(XDTO_СодСВИнфПрв, "СвТС", 	XDTO_СвТС);
	
	Возврат XDTO_СодСВИнфПрв;
	
КонецФункции

Функция XDTO_СодСВИнфГО(НомерТитула, Формат = Неопределено, ДокТитул24) Экспорт

	ТипДО = "__SoprVed";
	
	ДокументСВ = ДокТитул24.ДокументСВ;
	XDTO_СодСВИнфГО = НовыйДочернийОбъектXDTO(2, "СодСВИнфГО", ТипДО);
	XDTO_Установить(XDTO_СодСВИнфГО, "УИД_СВ", 	ДокументСВ.УИД);
	
	// исправление
	Если ЗначениеЗаполнено(ДокТитул24.НомИспр) Тогда 
		XDTO_ИспрСВ = НовыйДочернийОбъектXDTO(2, "СодСВИнфГО.ИспрСВ", ТипДО);
		XDTO_Установить(XDTO_ИспрСВ, "НомИспр", 	ДокТитул24.НомИспр);
		XDTO_Установить(XDTO_ИспрСВ, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул24.ДатаИспр));
		XDTO_Установить(XDTO_СодСВИнфГО, "ИспрСВ", 	XDTO_ИспрСВ);
	КонецЕсли;
	
	Если ДокТитул24.ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул4 Тогда 
		// Сведения об указаниях грузоотправителя
		XDTO_УказГО = НовыйДочернийОбъектXDTO(2, "СодСВИнфГО.УказГО", ТипДО);
		XDTO_Установить(XDTO_УказГО, "УкНормПрвз", 	ДокТитул24.УкНормПрвз);
		XDTO_Установить(XDTO_УказГО, "ПредСрПрвз", 	ДокТитул24.ПредСрПрвз);
		Если ДокТитул24.ЗапрПерегруз = Истина Тогда  
			XDTO_Установить(XDTO_УказГО, "ЗапрПерегруз", 	"1");
		КонецЕсли;
		XDTO_Установить(XDTO_УказГО, "СвПломба", 	ДокТитул24.СвПломба);
		
		XDTO_ТемпРеж = НовыйДочернийОбъектXDTO(2, "СодСВИнфГО.УказГО.ТемпРеж", ТипДО);
		XDTO_Установить(XDTO_ТемпРеж, "ТемпНеНижеСВ", 	ДокТитул24.ТемпНеНижеСВ);
		XDTO_Установить(XDTO_ТемпРеж, "ТемпНеВышеСВ", 	ДокТитул24.ТемпНеВышеСВ);
		XDTO_Установить(XDTO_ТемпРеж, "ВлажнНеНижеСВ", 	ДокТитул24.ВлажнНеНижеСВ);
		XDTO_Установить(XDTO_ТемпРеж, "ВлажнНеВышеСВ", 	ДокТитул24.ВлажнНеВышеСВ);
		XDTO_Установить(XDTO_УказГО, "ТемпРеж", 	XDTO_ТемпРеж);
		
		XDTO_Установить(XDTO_СодСВИнфГО, "УказГО", 	XDTO_УказГО);
		
	КонецЕсли;
	
	// Сведения о контейнерах
	Для Каждого СтрокаКонтейнера Из ДокТитул24.Контейнеры Цикл 
		XDTO_СвКонтейн = XDTO_СВ_СвКонтейн(НомерТитула, , ДокТитул24, СтрокаКонтейнера);
		XDTO_СодСВИнфГО.СвКонтейн.Добавить(XDTO_СвКонтейн);
	КонецЦикла;
	
	// Сдача (прием) контейнера (погрузка)
	XDTO_СдачКонтПогруз = XDTO_СдачКонтПогруз(ДокТитул24, НомерТитула, ТипДО);
	XDTO_Установить(XDTO_СодСВИнфГО, "СдачКонтПогруз", 	XDTO_СдачКонтПогруз);
	
	Возврат XDTO_СодСВИнфГО;
	
КонецФункции

Функция XDTO_СодСВИнфГП(НомерТитула, Формат = Неопределено, ДокТитул68) Экспорт

	ТипДО = "__SoprVed";
	
