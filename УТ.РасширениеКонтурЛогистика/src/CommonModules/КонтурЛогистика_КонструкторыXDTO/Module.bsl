// Функция - Новый дочерний объект XDTO
//
// Параметры:
//  НомерТитула		 - Число - 1,2,3,4,5,6,7,8; 0 - если тип документоборота совпадает с именем пакета
//  ПутьВложенности	 - Строка - Путь через точку от Файл.Документ, например "Подписант.ФИО", тогда вернется XDTO: Файл.Документ.Подписант.ФИО
// 
Функция НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности, ТипДокументооборота = "__etrnTitle", Формат = "5.01", РодительДокумент = Истина)
	
	ФабрикаXDTOНакладной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
	
	МассивВложенных = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ПутьВложенности, ".");
	
	ИмяПакета = ТипДокументооборота + ?(НомерТитула = 0, "", НомерТитула);
	
	Если РодительДокумент Тогда
		ТипОбъектаXDTO = ФабрикаXDTOНакладной.Пакеты.Получить(ИмяПакета).КорневыеСвойства.Получить("Файл").Тип.Свойства.Получить("Документ").Тип;
	Иначе
		ТипОбъектаXDTO = ФабрикаXDTOНакладной.Пакеты.Получить(ИмяПакета).КорневыеСвойства.Получить("Файл").Тип;
	КонецЕсли;
	
	Для Каждого Эл Из МассивВложенных Цикл
		
		ТипОбъектаXDTO = ТипОбъектаXDTO.Свойства.Получить(Эл).Тип;
		
	КонецЦикла;
	
	XDTO_Объект = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO);
	
	Возврат XDTO_Объект;
	
КонецФункции
 
// Функция - Новый базовый объект XDTO
//
// Параметры:
//  НомерТитула		 - Число - 1,2,3,4,5,6,7,8
//  ПутьВложенности	 - Строка - Путь через точку от корневых свойств пакета(номераТитула)
Функция НовыйБазовыйОбъектXDTO(НомерТитула, ПутьВложенности, ТипДокументооборота = "__etrnTitle", Формат = "5.01")
	
	ФабрикаXDTOНакладной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
	
	МассивВложенных = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ПутьВложенности, ".");
	
	ИмяПакета = ТипДокументооборота + ?(НомерТитула = 0, "", НомерТитула);
	
	ТипОбъектаXDTO = ФабрикаXDTOНакладной.Пакеты.Получить(ИмяПакета).Получить(МассивВложенных[0]);
	
	Если МассивВложенных.Количество() > 1 Тогда
		
		МассивВложенных.Удалить(0);
		
		Для Каждого Эл Из МассивВложенных Цикл
			
			ТипОбъектаXDTO = ТипОбъектаXDTO.Свойства.Получить(Эл).Тип;
			
		КонецЦикла;
		
	КонецЕсли;
	
	XDTO_Объект = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция НовыйОбъектXDTO(мФабрика, Тип_Основной, СоздатьВложенныеОбъекты = Ложь) Экспорт
	
	Результат = мФабрика.Создать(Тип_Основной);
	
	Если СоздатьВложенныеОбъекты Тогда
		
		Для Каждого Эл Из Тип_Основной.Свойства Цикл
			
	        флСвойствоНеСписковое =	(Эл.ВерхняяГраница = 1);
			
			Если Эл.Тип.URIПространстваИмен = Тип_Основной.URIПространстваИмен 
				И флСвойствоНеСписковое	Тогда
				
				Если ТипЗнч(Эл.Тип) = Тип("ТипОбъектаXDTO") Тогда //вложенные свойства создаем только для объектов
					Результат[Эл.Имя] = НовыйОбъектXDTO(мФабрика, Эл.Тип, СоздатьВложенныеОбъекты);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, СтрокаXML)
	
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", "");
	
КонецПроцедуры

Функция XDTO_ДатаТип(Дата) Экспорт
	Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
КонецФункции	

Функция XDTO_ВремяТип(Дата) Экспорт
	Возврат Формат(Дата, "ДФ=HH:mm:ss; ДП=00:00:00");
КонецФункции	

Функция XDTO_ВремяВЗТип(ВремяВЧасовомПоясеЭтогоСеанса, Знач ТребуемыйЧасовойПояс = Неопределено)
	
	Если Не ЗначениеЗаполнено(ТребуемыйЧасовойПояс) Тогда 
		
		ТребуемыйЧасовойПояс = ЧасовойПоясСеанса();
		ВремяВТребуемомЧасовомПоясе = ВремяВЧасовомПоясеЭтогоСеанса;
		
	Иначе
		
		ВремяВТребуемомЧасовомПоясе = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
				ВремяВЧасовомПоясеЭтогоСеанса, ЧасовойПоясСеанса(), ТребуемыйЧасовойПояс);
				
	КонецЕсли;
			
	Если ЗначениеЗаполнено(ВремяВТребуемомЧасовомПоясе) Тогда 
		
		СмещениеСтандартногоВремени = СмещениеСтандартногоВремени(ТребуемыйЧасовойПояс) / 60 / 60;
		Если СмещениеСтандартногоВремени >= 0 Тогда
			ПрефиксСмещенияПояса = "+";
		Иначе
			ПрефиксСмещенияПояса = "";
		КонецЕсли;
		
		СмещениеПояса = ПрефиксСмещенияПояса + Формат(СмещениеСтандартногоВремени, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=") + ":00";
		Возврат "" + Формат(ВремяВТребуемомЧасовомПоясе, "ДФ=HH:mm:ss") + СмещениеПояса;
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

Функция XDTO_ВремяТип_Устар(Дата)
	Возврат Формат(Дата, "ДФ=HH.mm.ss");
КонецФункции	

Функция XDTO_ДатаВремяТип(Дата)
	Возврат  "" + Формат(Дата, "ДФ=dd.MM.yyyy")+ "T" + Формат(Дата, "ДФ=HH:mm:ss");
КонецФункции	

Функция XDTO_ДатаВремяВЗТип(Знач ДатаВремяВЧасовомПоясеЭтогоСеанса, Знач ТребуемыйЧасовойПояс = Неопределено) Экспорт 
	
	Если Не ЗначениеЗаполнено(ТребуемыйЧасовойПояс) Тогда 
		
		ТребуемыйЧасовойПояс = ЧасовойПоясСеанса();
		ДатаВремяВТребуемомЧасовомПоясе = ДатаВремяВЧасовомПоясеЭтогоСеанса;
		
	Иначе
		
		ДатаВремяВТребуемомЧасовомПоясе = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
				ДатаВремяВЧасовомПоясеЭтогоСеанса, ЧасовойПоясСеанса(), ТребуемыйЧасовойПояс);
				
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(ДатаВремяВТребуемомЧасовомПоясе) Тогда 
		
		СмещениеСтандартногоВремени = СмещениеСтандартногоВремени(ТребуемыйЧасовойПояс) / 60 / 60;
		Если СмещениеСтандартногоВремени >= 0 Тогда
			ПрефиксСмещенияПояса = "+";
		Иначе
			ПрефиксСмещенияПояса = "";
		КонецЕсли;
		
		СмещениеПояса = ПрефиксСмещенияПояса + Формат(СмещениеСтандартногоВремени, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=") + ":00";
		Возврат "" + Формат(ДатаВремяВТребуемомЧасовомПоясе, "ДФ=dd.MM.yyyy")+ "T"
			+ Формат(ДатаВремяВТребуемомЧасовомПоясе, "ДФ=HH:mm:ss") + СмещениеПояса;
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

// Процедура - Безопасно устанавливает значение свойства объектаXDTO 
//
// Параметры:
//  ОбъектXDTO	 - ОбъектXDTO 	- (обязательный)
//  Свойство	 - Строка 		- (обязательный)
//  Значение	 - Произвольный - (обязательный)
//
Процедура XDTO_Установить(ОбъектXDTO, Свойство, Значение, ПрисваиватьНольКакЗначение = Ложь) Экспорт
	
	Если Значение = Неопределено
		ИЛИ ТипЗнч(Значение) = Тип("Неопределено") 
		ИЛИ Значение = ""
		ИЛИ (Значение = Дата(1,1,1) И ПрисваиватьНольКакЗначение = Ложь)
		ИЛИ (Значение = 0 И ПрисваиватьНольКакЗначение = Ложь)Тогда
		
		ОбъектXDTO.Сбросить(Свойство);
		
	Иначе
						
		Попытка
			ОбъектXDTO.Установить(Свойство, Значение);
		Исключение
			ТекстОшибки = "Ошибка при установление значения свойства  """ + Строка(Свойство) + """. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение ТекстОшибки;	
		КонецПопытки;
		
	КонецЕсли
	
КонецПроцедуры

Процедура XDTO_УстановитьСУсловием(ОбъектXDTO, Свойство, Значение, ПрисваиватьНольКакЗначение = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		XDTO_Установить(ОбъектXDTO, Свойство, Значение, ПрисваиватьНольКакЗначение);
		
	КонецЕсли
	
КонецПроцедуры

