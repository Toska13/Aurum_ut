		Запрос.УстановитьПараметр("Фамилия", 		XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "ФИО.Фамилия"));
		Запрос.УстановитьПараметр("Имя", 			XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "ФИО.Имя"));
		Запрос.УстановитьПараметр("Отчество", 		XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "ФИО.Отчество"));
		Запрос.УстановитьПараметр("СНИЛС", 			XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "СНИЛС"));
		
				
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			МедикЛогистика = Выборка.Ссылка;	
		
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(МедикЛогистика) Тогда
			
			НовыйМедик = Справочники.КонтурЛогистика_Сотрудники.СоздатьЭлемент();
			
			НовыйМедик.Фамилия = XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "ФИО.Фамилия");
			НовыйМедик.Имя 	= XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "ФИО.Имя");
			НовыйМедик.Отчество = XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "ФИО.Отчество");
			НовыйМедик.СНИЛС = XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "Должн");
			НовыйМедик.Должность = XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "СНИЛС");
			НовыйМедик.РольМедик = Истина;
			НовыйМедик.Должность = XDTO_Вычислить(XDTO_СвМедРабИЛИСвМедОрг, "Должн");			
			НовыйМедик.Записать();
			
			МедикЛогистика = НовыйМедик.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат МедикЛогистика;
	
КонецФункции

Функция Конвертировать_ЛицензМОТип_вЛицензия(XDTO_ЛицензМОТип, Владелец) Экспорт
	
	Лицензия = Справочники.КонтурЛогистика_Лицензии.ПустаяСсылка(); 
	
	Если XDTO_ЛицензМОТип <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_Лицензии.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.КонтурЛогистика_Лицензии КАК КонтурЛогистика_Лицензии
		               |ГДЕ
		               |	НЕ КонтурЛогистика_Лицензии.ПометкаУдаления
		               |	И КонтурЛогистика_Лицензии.Серия = &Серия
		               |	И КонтурЛогистика_Лицензии.Номер = &Номер
		               |	И КонтурЛогистика_Лицензии.ДатаВыдачи = &ДатаВыдачи";
		
		Запрос.УстановитьПараметр("Серия", 		XDTO_Вычислить(XDTO_ЛицензМОТип, "Сер"));
		Запрос.УстановитьПараметр("Номер", 		XDTO_Вычислить(XDTO_ЛицензМОТип, "Ном"));
		Запрос.УстановитьПараметр("ДатаВыдачи", Конвертировать_ДатаТип_вДата(XDTO_Вычислить(XDTO_ЛицензМОТип, "ДатВыд")));
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			Лицензия = Выборка.Ссылка;	
		
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Лицензия) Тогда
			
			НоваяЛицензия = Справочники.КонтурЛогистика_Лицензии.СоздатьЭлемент();
			
			НоваяЛицензия.Владелец 		= Владелец;
			НоваяЛицензия.Серия 		= XDTO_Вычислить(XDTO_ЛицензМОТип, "Сер");
			НоваяЛицензия.Номер 		= XDTO_Вычислить(XDTO_ЛицензМОТип, "Ном");
			НоваяЛицензия.ДатаВыдачи 	= Конвертировать_ДатаТип_вДата(XDTO_Вычислить(XDTO_ЛицензМОТип, "ДатВыд"));
			НоваяЛицензия.СрокОкончанияДействия	= Конвертировать_ДатаТип_вДата(XDTO_Вычислить(XDTO_ЛицензМОТип, "Срок"));
			НоваяЛицензия.ВидЛицензии = Перечисления.КонтурЛогистика_ВидыЛицензий.Медицинская;
			НоваяЛицензия.Записать();
			
			Лицензия = НоваяЛицензия.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат Лицензия;
	
КонецФункции

Функция Конвертировать_РеквДокТип_вДоговорЛогистика(XDTO_РеквДокТип, Префикс = "") Экспорт
	
	ДоговорЛогистика = Справочники.КонтурЛогистика_Договоры.ПустаяСсылка();
	
	Если XDTO_РеквДокТип <> Неопределено Тогда 

		ИдДок = XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "ИдДок");
		Если ЗначениеЗаполнено(ИдДок) Тогда 
			ДоговорЛогистика = Справочники.КонтурЛогистика_Договоры.НайтиПоРеквизиту("ИдДок", ИдДок);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДоговорЛогистика) Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	КонтурЛогистика_Договоры.Ссылка КАК Ссылка
			               |ИЗ
			               |	Справочник.КонтурЛогистика_Договоры КАК КонтурЛогистика_Договоры
			               |ГДЕ
			               |	КонтурЛогистика_Договоры.НомерДокумента = &НомерДокумента
			               |	И КонтурЛогистика_Договоры.ДатаДокумента = &ДатаДокумента
			               |	И КонтурЛогистика_Договоры.Наименование = &Наименование
			               |	И НЕ КонтурЛогистика_Договоры.ПометкаУдаления";
			
			Запрос.УстановитьПараметр("НомерДокумента", СокрЛП(XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "НомерДок")));
			ДатДокXDTO = XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "ДатаДок");
			ДатаДок1С = Конвертировать_ДатаТип_вДата(ДатДокXDTO);
			Запрос.УстановитьПараметр("ДатаДокумента", ДатаДок1С);
			Запрос.УстановитьПараметр("Наименование", СокрЛП(XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "НаимДок")));
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда 
			
				ДоговорЛогистика = Выборка.Ссылка;
				
			Иначе
				
				НовыйДоговор = Справочники.КонтурЛогистика_Договоры.СоздатьЭлемент();
				НовыйДоговор.Наименование 	= СокрЛП(XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "НаимДок"));
				НовыйДоговор.НомерДокумента = СокрЛП(XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "НомерДок"));
				НовыйДоговор.ДатаДокумента 	= ДатаДок1С;
				НовыйДоговор.ДопСведения 	= СокрЛП(XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "ДопСведДок"));
				НовыйДоговор.ИдДок 			= ИдДок;
				
				СписокXDTOИлиОбъектXDTOУчастники = XDTO_ПолучитьЗначениеСвойства(XDTO_РеквДокТип, Префикс + "ИдРекСост");
				
				МассивXDTOУчастники = XDTO_ВычислитьМассивXDTO(СписокXDTOИлиОбъектXDTOУчастники);
				
				Для Каждого УчастникXDTO Из МассивXDTOУчастники Цикл
					
					текИНН = СокрЛП(XDTO_ПолучитьЗначениеСвойства(УчастникXDTO, "ИННЮЛ"));
					Если Не ЗначениеЗаполнено(текИНН) Тогда 
						текИНН = СокрЛП(XDTO_ПолучитьЗначениеСвойства(УчастникXDTO, "ИННФЛ"));
					КонецЕсли;
					
					Если ЗначениеЗаполнено(текИНН) Тогда
						
						НайденнаяОргДД = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИНН", текИНН);
						
						Если ЗначениеЗаполнено(НайденнаяОргДД) Тогда
							
							Если НайденнаяОргДД.Наш И Не ЗначениеЗаполнено(НовыйДоговор.Организация) И Не ЗначениеЗаполнено(НовыйДоговор.ОрганизацияИНН) Тогда 
								НовыйДоговор.Организация = НайденнаяОргДД;
							ИначеЕсли Не ЗначениеЗаполнено(НовыйДоговор.Контрагент) И Не ЗначениеЗаполнено(НовыйДоговор.КонтрагентИНН) Тогда
								НовыйДоговор.Контрагент = НайденнаяОргДД;
							Иначе
								НоваяСтрокаУчастника = НовыйДоговор.Участники.Добавить();
								НоваяСтрокаУчастника.Участник = НайденнаяОргДД;
							КонецЕсли;
							
						Иначе
							
							Если Не ЗначениеЗаполнено(НовыйДоговор.КонтрагентИНН) И Не ЗначениеЗаполнено(НовыйДоговор.Контрагент) Тогда
								НовыйДоговор.КонтрагентИНН = текИНН;
							Иначе
								НоваяСтрокаУчастника = НовыйДоговор.Участники.Добавить();
								НоваяСтрокаУчастника.УчастникИНН = текИНН;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				НовыйДоговор.Записать();
				ДоговорЛогистика = НовыйДоговор.Ссылка;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДоговорЛогистика;
	
КонецФункции

// XDTO_СвПогруз - для первого титула можно передать доп сведения о месте погрузки (владелец, основание доступа итд)
Функция Конвертировать_АдресПользТип_вПунктМаршрутаЛогистика(XDTO_АдресПользТип, XDTO_ВладИнфр = Неопределено) Экспорт
	
	ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.ПустаяСсылка();
	
	Если XDTO_АдресПользТип <> Неопределено Тогда 
		
		КодГАР 		= XDTO_ПолучитьЗначениеСвойства(XDTO_АдресПользТип, "КодГАР");
		GLN 		= XDTO_ПолучитьЗначениеСвойства(XDTO_АдресПользТип, "ГЛН");
		АдресРФ		= XDTO_ПолучитьЗначениеСвойства(XDTO_АдресПользТип, "АдресРФ");
		
		Если  XDTO_Вычислить(XDTO_АдресПользТип, "АдресИнф") <> Неопределено Тогда // привет разные названия тегов
			АдресИнфТекст		= XDTO_Вычислить(XDTO_АдресПользТип, "АдресИнф.АдрТекст");
			АдресИнфКодСтраны	= XDTO_Вычислить(XDTO_АдресПользТип, "АдресИнф.КодСтр");
		ИначеЕсли  XDTO_Вычислить(XDTO_АдресПользТип, "АдрИнф") <> Неопределено Тогда
			АдресИнфТекст		= XDTO_Вычислить(XDTO_АдресПользТип, "АдрИнф.АдрТекст");
			АдресИнфКодСтраны	= XDTO_Вычислить(XDTO_АдресПользТип, "АдрИнф.КодСтр");
		КонецЕсли;
		
		АдрКоммент	= XDTO_ПолучитьЗначениеСвойства(XDTO_АдресПользТип, "АдрКоммент");
		
		Если КодГАР <> Неопределено Тогда 
			ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.НайтиПоРеквизиту("КодГАР", КодГАР);
		ИначеЕсли GLN <> Неопределено Тогда 
			ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.НайтиПоРеквизиту("GLN", GLN);
		ИначеЕсли АдресИнфТекст <> Неопределено Тогда 
			ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.НайтиПоРеквизиту("АдресИнфАдрес", АдресИнфТекст);
		ИначеЕсли АдресРФ <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	КонтурЛогистика_ПунктыМаршрута.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_ПунктыМаршрута КАК КонтурЛогистика_ПунктыМаршрута
			|ГДЕ
			|	КонтурЛогистика_ПунктыМаршрута.АдресГород = &АдресГород
			|	И КонтурЛогистика_ПунктыМаршрута.АдресУлица = &АдресУлица
			|	И КонтурЛогистика_ПунктыМаршрута.АдресДом = &АдресДом
			|	И КонтурЛогистика_ПунктыМаршрута.АдресИндекс = &АдресИндекс
			|	И КонтурЛогистика_ПунктыМаршрута.АдресКодРегион = &АдресКодРегион
			|	И КонтурЛогистика_ПунктыМаршрута.АдресКорпус = &АдресКорпус
			|	И КонтурЛогистика_ПунктыМаршрута.АдресКварт = &АдресКварт
			|	И КонтурЛогистика_ПунктыМаршрута.АдресНаселПункт = &АдресНаселПункт";
			
			Запрос.УстановитьПараметр("АдресИндекс", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "Индекс", ""));
			Запрос.УстановитьПараметр("АдресКодРегион", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "КодРегион", ""));
			Запрос.УстановитьПараметр("АдресГород", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "Город", ""));
			Запрос.УстановитьПараметр("АдресНаселПункт", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "НаселПункт", ""));
			Запрос.УстановитьПараметр("АдресУлица", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "Улица", ""));
			Запрос.УстановитьПараметр("АдресДом", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "Дом", ""));
			Запрос.УстановитьПараметр("АдресКорпус", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "Корпус", ""));
			Запрос.УстановитьПараметр("АдресКварт", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдресРФ, "Кварт", ""));
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ПунктМаршрута = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПунктМаршрута) Тогда 
			
			НовыйПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.СоздатьЭлемент();
			НовыйПунктМаршрута.КодГАР 				= КодГАР;
			НовыйПунктМаршрута.GLN 					= GLN;
			НовыйПунктМаршрута.КомментарийКАдресу 	= АдрКоммент;
			НовыйПунктМаршрута.АдресИнфАдрес 		= АдресИнфТекст;
			НовыйПунктМаршрута.АдресИнфКодСтраны 	= Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду(АдресИнфКодСтраны);
			НовыйПунктМаршрута.GLN 					= GLN;
			
			Если АдресРФ <> Неопределено Тогда 
				НовыйПунктМаршрута.АдресИндекс 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Индекс");
				НовыйПунктМаршрута.АдресКодРегион 	= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "КодРегион");
				НовыйПунктМаршрута.АдресРайон 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Район");
				НовыйПунктМаршрута.АдресГород 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Город");
				НовыйПунктМаршрута.АдресНаселПункт 	= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "НаселПункт");
				НовыйПунктМаршрута.АдресУлица 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Улица");
				НовыйПунктМаршрута.АдресДом 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Дом");
				НовыйПунктМаршрута.АдресКорпус 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Корпус");
				НовыйПунктМаршрута.АдресКварт 		= XDTO_ПолучитьЗначениеСвойства(АдресРФ, "Кварт");
			КонецЕсли;
			
			Если XDTO_ВладИнфр <> Неопределено Тогда
				
				СовпГОВ = XDTO_ПолучитьЗначениеСвойства(XDTO_ВладИнфр, "СовпГОВ");
				
				Если СовпГОВ = "1" Тогда
					ИдентРекГО = XDTO_ПолучитьЗначениеСвойства(XDTO_ВладИнфр, "ИдентРекГО");
					Если ИдентРекГО <> Неопределено Тогда
						НовыйПунктМаршрута.Собственник = Конвертировать_ИдРекСостТип_вОрганизациюДиадок(ИдентРекГО);
					КонецЕсли;
				ИначеЕсли СовпГОВ = "2" Тогда
					РекВладИнф = XDTO_ПолучитьЗначениеСвойства(XDTO_ВладИнфр, "РекВладИнф");
					Если РекВладИнф <> Неопределено Тогда
						НовыйПунктМаршрута.Собственник = Конвертировать_РекИдентГО_вОрганизациюДиадок(РекВладИнф);
					КонецЕсли;
				ИначеЕсли СовпГОВ = "3" Тогда
					ОбНетИнфОВлад = XDTO_ПолучитьЗначениеСвойства(XDTO_ВладИнфр, "ОбНетИнфОВлад");
					Если ОбНетИнфОВлад <> Неопределено Тогда
						НовыйПунктМаршрута.СобственникНеУказанПричина = СокрЛП(ОбНетИнфОВлад);
					КонецЕсли;
				КонецЕсли;
								
			КонецЕсли;
			
			НовыйПунктМаршрута.Записать();
			
			ПунктМаршрута = НовыйПунктМаршрута.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПунктМаршрута;
	
КонецФункции

// для новой модельки, где есть тег-прослойка Адрес
Функция Конвертировать_АдресПользТип2023_вПунктМаршрутаЛогистика(XDTO_АдресПользТип) Экспорт
	
	// АдрКоммент, ГЛН, Коорд, Адрес
	//		Адрес: АдрРФ|АдрФИАС|АдрИнф
	
	ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.ПустаяСсылка();
	
	Если XDTO_АдресПользТип <> Неопределено Тогда 
		
		АдрКоммент	= XDTO_Вычислить(XDTO_АдресПользТип, "АдрКоммент");
		GLN 		= XDTO_Вычислить(XDTO_АдресПользТип, "ГЛН");
		
		// Адрес
			АдрРФ	= XDTO_Вычислить(XDTO_АдресПользТип, "Адрес.АдрРФ");
			АдрИнф	= XDTO_Вычислить(XDTO_АдресПользТип, "Адрес.АдрИнф");
			АдрФИАС	= XDTO_Вычислить(XDTO_АдресПользТип, "Адрес.АдрФИАС");
		
		Если АдрИнф <> Неопределено Тогда
			АдресИнфТекст		= XDTO_Вычислить(АдрИнф, "АдрТекст");
			АдресИнфКодСтраны	= XDTO_Вычислить(АдрИнф, "КодСтр");
		Иначе
			АдресИнфТекст 		= Неопределено;
			АдресИнфКодСтраны 	= Неопределено;
		КонецЕсли;
		
		
		Если GLN <> Неопределено Тогда
			
			ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.НайтиПоРеквизиту("GLN", GLN);
			
		ИначеЕсли АдресИнфТекст <> Неопределено Тогда
			
			ПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.НайтиПоРеквизиту("АдресИнфАдрес", АдресИнфТекст);
			
		ИначеЕсли АдрРФ <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	КонтурЛогистика_ПунктыМаршрута.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_ПунктыМаршрута КАК КонтурЛогистика_ПунктыМаршрута
			|ГДЕ
			|	КонтурЛогистика_ПунктыМаршрута.АдресГород = &АдресГород
			|	И КонтурЛогистика_ПунктыМаршрута.АдресУлица = &АдресУлица
			|	И КонтурЛогистика_ПунктыМаршрута.АдресДом = &АдресДом
			|	И КонтурЛогистика_ПунктыМаршрута.АдресИндекс = &АдресИндекс
			|	И КонтурЛогистика_ПунктыМаршрута.АдресКодРегион = &АдресКодРегион
			|	И КонтурЛогистика_ПунктыМаршрута.АдресКорпус = &АдресКорпус
			|	И КонтурЛогистика_ПунктыМаршрута.АдресКварт = &АдресКварт
			|	И КонтурЛогистика_ПунктыМаршрута.АдресНаселПункт = &АдресНаселПункт";
			
			Запрос.УстановитьПараметр("АдресИндекс", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "Индекс", ""));
			Запрос.УстановитьПараметр("АдресКодРегион", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "КодРегион", ""));
			Запрос.УстановитьПараметр("АдресГород", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "Город", ""));
			Запрос.УстановитьПараметр("АдресНаселПункт", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "НаселПункт", ""));
			Запрос.УстановитьПараметр("АдресУлица", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "Улица", ""));
			Запрос.УстановитьПараметр("АдресДом", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "Дом", ""));
			Запрос.УстановитьПараметр("АдресКорпус", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "Корпус", ""));
			Запрос.УстановитьПараметр("АдресКварт", XDTO_ПолучитьЗначениеСвойстваСПроверкой(АдрРФ, "Кварт", ""));
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ПунктМаршрута = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПунктМаршрута) Тогда 
			
			НовыйПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.СоздатьЭлемент();
			НовыйПунктМаршрута.GLN 					= GLN;
			НовыйПунктМаршрута.КомментарийКАдресу 	= АдрКоммент;
			НовыйПунктМаршрута.АдресИнфАдрес 		= АдресИнфТекст;
			НовыйПунктМаршрута.АдресИнфКодСтраны 	= Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду(АдресИнфКодСтраны);
			НовыйПунктМаршрута.GLN 					= GLN;
			
			Если АдрРФ <> Неопределено Тогда 
				НовыйПунктМаршрута.АдресИндекс 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Индекс");
				НовыйПунктМаршрута.АдресКодРегион 	= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "КодРегион");
				НовыйПунктМаршрута.АдресРайон 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Район");
				НовыйПунктМаршрута.АдресГород 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Город");
				НовыйПунктМаршрута.АдресНаселПункт 	= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "НаселПункт");
				НовыйПунктМаршрута.АдресУлица 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Улица");
				НовыйПунктМаршрута.АдресДом 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Дом");
				НовыйПунктМаршрута.АдресКорпус 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Корпус");
				НовыйПунктМаршрута.АдресКварт 		= XDTO_ПолучитьЗначениеСвойства(АдрРФ, "Кварт");
			КонецЕсли;
			
			НовыйПунктМаршрута.Записать();
			
			ПунктМаршрута = НовыйПунктМаршрута.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПунктМаршрута;
	
КонецФункции

// ЭТОГО СЕАНСА! Дата и время в формате ДД.ММ.ГГГГТЧЧ:ММ:СС±ЧЧ:ММ, где
//	Т - разделитель даты и времени;
//	±ЧЧ:ММ  - разница с UTC в часах, минутах
// в датувремя 1С ЭТОГО СЕАНСА
Функция Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(Строка_ДатаВремяВЗТип) Экспорт
	
	Если Не ЗначениеЗаполнено(Строка_ДатаВремяВЗТип) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	ДатаВЭтомСеансе = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(Строка_ДатаВремяВЗТип) Тогда 
		
		локДата =  Дата(Сред(Строка_ДатаВремяВЗТип, 7, 4), Сред(Строка_ДатаВремяВЗТип, 4, 2), Лев(Строка_ДатаВремяВЗТип, 2));
		
		локЧасы = Число(Сред(Строка_ДатаВремяВЗТип, 12, 2));
		локМин = Число(Сред(Строка_ДатаВремяВЗТип, 15, 2));
		локСек = Число(Сред(Строка_ДатаВремяВЗТип, 18, 2));
		
		локДатаВремя = локДата + локЧасы*3600 + локМин * 60 + локСек;
		
		ЗнакСмещенияПлюс = Сред(Строка_ДатаВремяВЗТип, 20, 1) = "+"; 	
		СмещениеЧасы = Число(Сред(Строка_ДатаВремяВЗТип, 21, 2));
		СмещениеМин = Число(Сред(Строка_ДатаВремяВЗТип, 24, 2));
		
		Если ЗнакСмещенияПлюс Тогда 
			Смещение = 0 + СмещениеЧасы*3600 + СмещениеМин*60;
		Иначе
			Смещение = 0 - СмещениеЧасы*3600 - СмещениеМин*60;
		КонецЕсли;
		
		ДатаUTC = локДатаВремя - Смещение;
		ДатаВЭтомСеансе = ДатаUTC + СмещениеСтандартногоВремени(ЧасовойПоясСеанса());
		
	КонецЕсли;

	Возврат ДатаВЭтомСеансе;
	
КонецФункции

// МСК! Дата и время в формате ДД.ММ.ГГГГТЧЧ:ММ:СС±ЧЧ:ММ, где
//	Т - разделитель даты и времени;
//	±ЧЧ:ММ  - разница с UTC в часах, минутах
// в датувремя 1С ЭТОГО СЕАНСА
Функция Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(Строка_ДатаВремяВЗТип) Экспорт
	
	Если Не ЗначениеЗаполнено(Строка_ДатаВремяВЗТип) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	ДатаМСК = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(Строка_ДатаВремяВЗТип) Тогда
	
		локДата =  Дата(Сред(Строка_ДатаВремяВЗТип, 7, 4), Сред(Строка_ДатаВремяВЗТип, 4, 2), Лев(Строка_ДатаВремяВЗТип, 2));
	
		локЧасы = Число(Сред(Строка_ДатаВремяВЗТип, 12, 2));
		локМин = Число(Сред(Строка_ДатаВремяВЗТип, 15, 2));
		локСек = Число(Сред(Строка_ДатаВремяВЗТип, 18, 2));
		
		локДатаВремя = локДата + локЧасы*3600 + локМин * 60 + локСек;
		
		ЗнакСмещенияПлюс = Сред(Строка_ДатаВремяВЗТип, 20, 1) = "+"; 	
		СмещениеЧасы = Число(Сред(Строка_ДатаВремяВЗТип, 21, 2));
		СмещениеМин = Число(Сред(Строка_ДатаВремяВЗТип, 24, 2));
		
		Если ЗнакСмещенияПлюс Тогда 
			Смещение = 0 + СмещениеЧасы*3600 + СмещениеМин*60;
		Иначе
			Смещение = 0 - СмещениеЧасы*3600 - СмещениеМин*60;
		КонецЕсли;
		
		ДатаUTC = локДатаВремя - Смещение;
		
		ДатаМСК = ДатаUTC + 3 * 3600;	
	
	КонецЕсли;

	Возврат ДатаМСК;
	
КонецФункции

Функция Конвертировать_ДатаТипИВремяТип_вДатаВремяМСК(Строка_ДатаТип, Строка_ВремяТип) Экспорт
	
	Если Не ЗначениеЗаполнено(Строка_ДатаТип) ИЛИ Не ЗначениеЗаполнено(Строка_ВремяТип) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	ДатаМСК = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(Строка_ДатаТип) И ЗначениеЗаполнено(Строка_ВремяТип) Тогда
	
		локДата =  Дата(Сред(Строка_ДатаТип, 7, 4), Сред(Строка_ДатаТип, 4, 2), Лев(Строка_ДатаТип, 2));
	
		локЧасы = Число(Сред(Строка_ВремяТип, 1, 2));
		локМин = Число(Сред(Строка_ВремяТип, 4, 2));
		локСек = Число(Сред(Строка_ВремяТип, 7, 2));
		
		локДатаВремя = локДата + локЧасы * 3600 + локМин * 60 + локСек;
		
		Смещение = 0;
		
		ДатаМСК = локДатаВремя - Смещение;
	
	КонецЕсли;
	
	Возврат ДатаМСК;
	
КонецФункции

// Дата в формате строка: ДД.ММ.ГГГГ и ГГГГ-ММ-ДД в дату 1С
Функция Конвертировать_ДатаТип_вДата(Строка_ДатаТип) Экспорт
	                         
	СконвертированнаяДата = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(Строка_ДатаТип) Тогда 
		
		Если Найти(Строка_ДатаТип, ".") > 0 Тогда
			СконвертированнаяДата = Дата(Прав(Строка_ДатаТип, 4), Сред(Строка_ДатаТип, 4, 2), Лев(Строка_ДатаТип, 2));
		Иначе
			СконвертированнаяДата = Дата(Лев(Строка_ДатаТип, 4), Сред(Строка_ДатаТип, 6, 2), Прав(Строка_ДатаТип, 2));
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Строка_ДатаТип) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	Возврат СконвертированнаяДата;
	
КонецФункции

// Дата в формате строка: ЧЧ.ММ.СС в дату 1С
Функция Конвертировать_ВремяТип_вДата(Строка_ВремяТип) Экспорт
	
	локВремя = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(Строка_ВремяТип) Тогда
	
		локЧасы = Число(Сред(Строка_ВремяТип, 1, 2));
		локМин = Число(Сред(Строка_ВремяТип, 4, 2));
		локСек = Число(Сред(Строка_ВремяТип, 7, 2));
		
		локВремя = Дата(1,1,1) + локЧасы * 3600 + локМин * 60 + локСек;
	
	КонецЕсли;
	
	Возврат локВремя;
	
КонецФункции

Функция Конвертировать_ВремяВЗТип_вВремяСеанса(Строка_ВремяТип) Экспорт
	
	локВремя = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(Строка_ВремяТип) Тогда
	
		локЧасы = Число(Сред(Строка_ВремяТип, 1, 2));
		локМин = Число(Сред(Строка_ВремяТип, 4, 2));
		локСек = Число(Сред(Строка_ВремяТип, 7, 2));
		
		локВремя = Дата(1,1,1) + локЧасы * 3600 + локМин * 60 + локСек;
		
		ЗнакСмещенияПлюс = Сред(Строка_ВремяТип, 9, 1) = "+"; 	
		СмещениеЧасы = Число(Сред(Строка_ВремяТип, 10, 2));
		СмещениеМин = Число(Сред(Строка_ВремяТип, 13, 2));
		
		Если ЗнакСмещенияПлюс Тогда 
			Смещение = 0 + СмещениеЧасы*3600 + СмещениеМин*60;
		Иначе
			Смещение = 0 - СмещениеЧасы*3600 - СмещениеМин*60;
		КонецЕсли;
		
		ДатаUTC = локВремя - Смещение;
		ДатаВЭтомСеансе = ДатаUTC + СмещениеСтандартногоВремени(ЧасовойПоясСеанса());
	
	КонецЕсли;
	
	Возврат ДатаВЭтомСеансе;
	
КонецФункции

Функция КонвертироватьДатаВремяФормированияИзXDTOФайл(XDTO, ТипДокумента) Экспорт
	
	ПутьДатИнф = "Документ.ДатИнфПрвПрием";
	ПутьВрИнф = "Документ.ВрИнфПрвПрием";
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		ПутьДатИнф = "Документ.ДатИнфГО";
		ПутьВрИнф = "Документ.ВрИнфГО";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда
		ПутьДатИнф = "Документ.ДатИнфПрвПрием";
		ПутьВрИнф = "Документ.ВрИнфПрвПрием";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		ПутьДатИнф = "Документ.ДатИнфГП";
		ПутьВрИнф = "Документ.ВрИнфГП";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		ПутьДатИнф = "Документ.ДатИнфПрвВыд";
		ПутьВрИнф = "Документ.ВрИнфПрвВыд";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		ПутьДатИнф = "Документ.ДатПУДИнфПрв";
		ПутьВрИнф = "Документ.ВрПУДИнфПрв";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
		ПутьДатИнф = "Документ.ДатПУДИнфГО";
		ПутьВрИнф = "Документ.ВрПУДИнфГО";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
		ПутьДатИнф = "Документ.ДатаИнфПА";
		ПутьВрИнф = "Документ.ВрИнфПА";
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
		ПутьДатИнф = "Документ.ДатИнфЗамен";
		ПутьВрИнф = "Документ.ВрИнфЗамен";
	Иначе
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	ДатаВремя = Конвертировать_ДатаТипИВремяТип_вДатаВремяМСК(XDTO_Вычислить(XDTO, ПутьДатИнф),XDTO_Вычислить(XDTO, ПутьВрИнф));
	
	Возврат ДатаВремя;
	
КонецФункции

Процедура Конвертировать_ТоплТип_вТЧТопливоЛогистика(XDTO_КонтейнерСодержащийТоплТип, Путь, ДокументОбъект, ИмяКонтейнера) Экспорт
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДокументОбъект[ИмяКонтейнера].Очистить();
	
	ТоплТип_raw 	= КС.XDTO_Вычислить(XDTO_КонтейнерСодержащийТоплТип, Путь);
	Массив_ТоплТип 	= КС.XDTO_ВычислитьМассивXDTO(ТоплТип_raw);
		
	Для Каждого XDTO_ТоплТип Из Массив_ТоплТип Цикл
		
		Топливо = ПолучитьТопливоИзXDTO(XDTO_ТоплТип);
		
		НоваяСтрока = ДокументОбъект[ИмяКонтейнера].Добавить();
		
		НоваяСтрока.Топливо 									= Топливо;
		НоваяСтрока.ИдентификаторСтроки 						= Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.КоличествоТоплива 							= КС.XDTO_Вычислить(XDTO_ТоплТип, "КолТопл");
		НоваяСтрока.КоличествоЧасовРаботыСВключеннымОтопителем 	= КС.XDTO_Вычислить(XDTO_ТоплТип, "ЧасРабОтоп");
		НоваяСтрока.КоличествоЧасовРаботыОборудования 			= КС.XDTO_Вычислить(XDTO_ТоплТип, "ЧасРабСпецОб");
		
		Если ИмяКонтейнера = "ОстаткиТоплива" Тогда
			КС.ЗаполнитьИнфПолИзXDTOсИдФайл(XDTO_ТоплТип, ДокументОбъект, "ИнфПолОстаткиТоплива", 
				НоваяСтрока.ИдентификаторСтроки, "ИдентификаторСтрокиОстатковТоплива");
		Иначе
			КС.ЗаполнитьИнфПолИзXDTOсИдФайл(XDTO_ТоплТип, ДокументОбъект, "ИнфПолЗаправки", 
				НоваяСтрока.ИдентификаторСтроки, "ИдентификаторСтрокиЗаправок");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТопливоИзXDTO(XDTO_ТоплТип)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ВидТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO_ТоплТип, "ВидТопл"));
		
	Если ВидТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline Тогда
		МаркаТоплива 		= Перечисления.КонтурЛогистика_ВидыТоплива.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO_ТоплТип, "ВидТопл"), 
			КС.XDTO_Вычислить(XDTO_ТоплТип, "СвМаркБенз"));
		МаркаТопливаИная 	= КС.XDTO_Вычислить(XDTO_ТоплТип, "МаркБензИной");
	ИначеЕсли ВидТоплива 	= Перечисления.КонтурЛогистика_ТипыТоплива.Diesel Тогда
		МаркаТоплива 		= Перечисления.КонтурЛогистика_ВидыТоплива.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO_ТоплТип, "ВидТопл"), 
			КС.XDTO_Вычислить(XDTO_ТоплТип, "СвМаркДизл"));
		МаркаТопливаИная 	= КС.XDTO_Вычислить(XDTO_ТоплТип, "МаркДизлИной");
	ИначеЕсли ВидТоплива 	= Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas Тогда
		МаркаТоплива 		= Перечисления.КонтурЛогистика_ВидыТоплива.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO_ТоплТип, "ВидТопл"), 
			КС.XDTO_Вычислить(XDTO_ТоплТип, "СвМаркСжГаз"));
		МаркаТопливаИная 	= КС.XDTO_Вычислить(XDTO_ТоплТип, "МаркСжГазИной");	
	КонецЕсли;
	
	ЕдИзм 					= Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.ЗначениеИзXDTO(КС.XDTO_Вычислить(XDTO_ТоплТип, "ЕдИзмТопл"));
	ЕдИзмИная 				= КС.XDTO_Вычислить(XDTO_ТоплТип, "ИнаяЕдИзм");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипТоплива", ВидТоплива);
	Запрос.УстановитьПараметр("ВидТоплива", МаркаТоплива);
	Запрос.УстановитьПараметр("ВидТопливаПрочее", МаркаТопливаИная);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдИзмИная);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоКлассификатору", ЕдИзм);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ГорючеСмазочныеМатериалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ГорючеСмазочныеМатериалы КАК КонтурЛогистика_ГорючеСмазочныеМатериалы
	|ГДЕ
	|	НЕ КонтурЛогистика_ГорючеСмазочныеМатериалы.ПометкаУдаления
	|	И НЕ КонтурЛогистика_ГорючеСмазочныеМатериалы.ЭтоГруппа
	|	И КонтурЛогистика_ГорючеСмазочныеМатериалы.ТипТоплива = &ТипТоплива
	|	И (КонтурЛогистика_ГорючеСмазочныеМатериалы.ВидТоплива = &ВидТоплива
	|		ИЛИ &ВидТоплива = НЕОПРЕДЕЛЕНО)
	|	И (КонтурЛогистика_ГорючеСмазочныеМатериалы.ВидТопливаПрочее = &ВидТопливаПрочее
	|		ИЛИ &ВидТопливаПрочее = НЕОПРЕДЕЛЕНО)
	|	И (КонтурЛогистика_ГорючеСмазочныеМатериалы.ЕдиницаИзмерения = &ЕдиницаИзмерения
	|		ИЛИ &ЕдиницаИзмерения = НЕОПРЕДЕЛЕНО)
	|	И (КонтурЛогистика_ГорючеСмазочныеМатериалы.ЕдиницаИзмеренияПоКлассификатору = &ЕдиницаИзмеренияПоКлассификатору
	|		ИЛИ &ЕдиницаИзмеренияПоКлассификатору = НЕОПРЕДЕЛЕНО)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовыйГСМ = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.СоздатьНовыйГорючеСмазочныйМатериал(
		ВидТоплива, МаркаТоплива, МаркаТопливаИная, ЕдИзмИная, ЕдИзм);
	
	Возврат НовыйГСМ;
	
КонецФункции

Процедура ЗаполнитьСтрокуОтметкиИзXDTO(XDTO_Отметка, ЗаполняемаяСтрокаОтметки, ДокОбъект, ЕстьВзвешивание = Ложь) Экспорт
	
	ЗаполняемаяСтрокаОтметки.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	ДатВрОтмет_raw	= XDTO_Вычислить(XDTO_Отметка, "ДатВрОтмет");
	ЗаполняемаяСтрокаОтметки.ДатаИВремяОтметки		= Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(ДатВрОтмет_raw);
	ЗаполняемаяСтрокаОтметки.ОписаниеОбстоятельств  = XDTO_Вычислить(XDTO_Отметка, "ОбстОтмет");
	
	// Акты - в отдельную ТЧ
	XDTO_СвАкт  = XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_Отметка, "СвАкт"));
	Для Каждого XDTO_текСвАкт Из XDTO_СвАкт Цикл
		
		НоваяСтрокаАкта = ДокОбъект.Акты.Добавить();
		НоваяСтрокаАкта.ИдентификаторСтрокиОтметки = ЗаполняемаяСтрокаОтметки.ИдентификаторСтроки;
		
		НоваяСтрокаАкта.АктНомер 		= XDTO_Вычислить(XDTO_текСвАкт, "НомерДок");
		НоваяСтрокаАкта.АктДата 		= Конвертировать_ДатаТип_вДата(XDTO_Вычислить(XDTO_текСвАкт, "ДатаДок"));
		НоваяСтрокаАкта.АктНаименование = XDTO_Вычислить(XDTO_текСвАкт, "НаимДок");
		НоваяСтрокаАкта.АктИдДок 		= XDTO_Вычислить(XDTO_текСвАкт, "ИдДок");
		НоваяСтрокаАкта.АктДопСведДок 	= XDTO_Вычислить(XDTO_текСвАкт, "ДопСведДок");
		
	КонецЦикла;
	
	// АктыВзвешивания - в отдельную ТЧ
	XDTO_СвАктВзв  = XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_Отметка, "СвАктВзв"));
	Для Каждого XDTO_текСвАктВзв Из XDTO_СвАктВзв Цикл
		
		НоваяСтрокаАкта = ДокОбъект.Акты.Добавить();
		НоваяСтрокаАкта.ИдентификаторСтрокиОтметки 	= ЗаполняемаяСтрокаОтметки.ИдентификаторСтроки;
		НоваяСтрокаАкта.АктЭтоАктВзвешивания 		= Истина;
		
		НоваяСтрокаАкта.АктНомер 		= XDTO_Вычислить(XDTO_текСвАктВзв, "НомерДок");
		НоваяСтрокаАкта.АктДата 		= Конвертировать_ДатаТип_вДата(XDTO_Вычислить(XDTO_текСвАктВзв, "ДатаДок"));
		НоваяСтрокаАкта.АктНаименование = XDTO_Вычислить(XDTO_текСвАктВзв, "НаимДок");
		НоваяСтрокаАкта.АктИдДок 		= XDTO_Вычислить(XDTO_текСвАктВзв, "ИдДок");
		НоваяСтрокаАкта.АктДопСведДок 	= XDTO_Вычислить(XDTO_текСвАктВзв, "ДопСведДок");
		
	КонецЦикла;
	
	// Штрафы
	XDTO_РазмШтр  = XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_Отметка, "РазмШтр"));
	Для Каждого XDTO_текРазмШтр Из XDTO_РазмШтр Цикл
		
		НоваяСтрокаШтр = ДокОбъект.Штрафы.Добавить();
		НоваяСтрокаШтр.ИдентификаторСтрокиОтметки = ЗаполняемаяСтрокаОтметки.ИдентификаторСтроки;
		
		НоваяСтрокаШтр.ФактКолЕдИзм 	= XDTO_Вычислить(XDTO_текРазмШтр, "ФактКолЕдИзм");
		НоваяСтрокаШтр.ИтогРазмШтрРФ 	= XDTO_Вычислить(XDTO_текРазмШтр, "ИтогРазмШтрРФ");
		НоваяСтрокаШтр.РасчШтр 		= XDTO_Вычислить(XDTO_текРазмШтр, "РасчШтр");
		
	КонецЦикла;

	// ИнфПол
	ЗаполнитьИнфПолИзXDTO(XDTO_Отметка, ДокОбъект, "ОтметкиИнфПол", ЗаполняемаяСтрокаОтметки.ИдентификаторСтроки);

	
КонецПроцедуры

Процедура ЗаполнитьИнфПолИзXDTO(XDTO_КонтейнерСодержащийИнфПол, ДокументОбъект, ИмяКонтейнера = "ИнфПол", ИдентификаторСтрокиОтметки = "" ) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиОтметки) Тогда 
		ДокументОбъект[ИмяКонтейнера].Очистить();
	КонецЕсли;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	ИнфПол_raw 		= КС.XDTO_Вычислить(XDTO_КонтейнерСодержащийИнфПол, "ИнфПол");
	ИнфПолМассив	= КС.XDTO_ВычислитьМассивXDTO(ИнфПол_raw);
	
	Для Каждого ЭлементИнфПолXDTO Из ИнфПолМассив Цикл
		
		ИнфПолТекстИнф_raw 		= КС.XDTO_Вычислить(ЭлементИнфПолXDTO, "ТекстИнф");
		ИнфПолТекстИнфМассив	= КС.XDTO_ВычислитьМассивXDTO(ИнфПолТекстИнф_raw);
		
		Для Каждого ЭлементИнфПолТекстИнфXDTO Из ИнфПолТекстИнфМассив Цикл
			
			НоваяСтрокаИнфПол = ДокументОбъект[ИмяКонтейнера].Добавить();
			НоваяСтрокаИнфПол.Идентиф 	= КС.XDTO_Вычислить(ЭлементИнфПолТекстИнфXDTO, "Идентиф");
			НоваяСтрокаИнфПол.Значение 	= КС.XDTO_Вычислить(ЭлементИнфПолТекстИнфXDTO, "Значение");
			Если ЗначениеЗаполнено(ИдентификаторСтрокиОтметки) Тогда 
				НоваяСтрокаИнфПол.ИдентификаторСтрокиОтметки = ИдентификаторСтрокиОтметки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИнфПолИзXDTOсИдФайл(XDTO_КонтейнерСодержащийИнфПол, ДокументОбъект, ИмяКонтейнера = "ИнфПол", 
	ИдентификаторСтроки = "", ИмяИдентификатораСтроки = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда 
		ДокументОбъект[ИмяКонтейнера].Очистить();
	КонецЕсли;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	ИнфПол_raw 		= КС.XDTO_Вычислить(XDTO_КонтейнерСодержащийИнфПол, "ИнфПол");
	ИнфПолМассив	= КС.XDTO_ВычислитьМассивXDTO(ИнфПол_raw);
	
	Для Каждого ЭлементИнфПолXDTO Из ИнфПолМассив Цикл
		
		ИнфПолТекстИнф_raw 		= КС.XDTO_Вычислить(ЭлементИнфПолXDTO, "ТекстИнф");
		ИнфПолТекстИнфМассив	= КС.XDTO_ВычислитьМассивXDTO(ИнфПолТекстИнф_raw);
		
		Для Каждого ЭлементИнфПолТекстИнфXDTO Из ИнфПолТекстИнфМассив Цикл
			
			НоваяСтрокаИнфПол = ДокументОбъект[ИмяКонтейнера].Добавить();
			НоваяСтрокаИнфПол.ИдФайлИнфПол 	= КС.XDTO_Вычислить(ЭлементИнфПолXDTO, "ИдФайлИнфПол");;
			НоваяСтрокаИнфПол.Идентиф 		= КС.XDTO_Вычислить(ЭлементИнфПолТекстИнфXDTO, "Идентиф");
			НоваяСтрокаИнфПол.Значение 		= КС.XDTO_Вычислить(ЭлементИнфПолТекстИнфXDTO, "Значение");
			Если ЗначениеЗаполнено(ИдентификаторСтроки) И ЗначениеЗаполнено(ИмяИдентификатораСтроки) Тогда 
				НоваяСтрокаИнфПол[ИмяИдентификатораСтроки] = ИдентификаторСтроки;
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСпецУслДвижИзXDTO(XDTO_КонтейнерСодержащийСпецУслДвиж, ДокументОбъект, ИмяКонтейнера) Экспорт
	
	ДокументОбъект[ИмяКонтейнера].Очистить();
		
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_СпецУслДвиж 	= КС.XDTO_Вычислить(XDTO_КонтейнерСодержащийСпецУслДвиж, "СпецУслДвиж");
	СпецУслДвижМассив	= КС.XDTO_ВычислитьМассивXDTO(XDTO_СпецУслДвиж);
	
	Для Каждого ЭлементСпецУслДвижXDTO Из СпецУслДвижМассив Цикл
		
		НоваяСтрока = ДокументОбъект[ИмяКонтейнера].Добавить();
		
		НоваяСтрока.СпецУсл 			= Перечисления.КонтурЛогистика_СпециальныеУсловияДвижения.ЗначениеИзXDTO(КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "СпецУсл"));
		НоваяСтрока.НомСР 				= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "НомСР");
		НоваяСтрока.ДатаСР 				= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "ДатаСР"));
		НоваяСтрока.СрокСР 				= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "СрокСР");
		НоваяСтрока.ВидСР 				= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "ВидСР");
		НоваяСтрока.НаимОИВ 			= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "НаимОИВ");
		НоваяСтрока.ИдСР 				= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "ИдСР");
		
		НоваяСтрока.СведМрш_МршТекст 	= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "СведМрш.МршТекст");
		НоваяСтрока.СведМрш_МршМашЧит 	= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "СведМрш.МршМашЧит");
								
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСвГосСистИзXDTO(XDTO_КонтейнерСодержащийИнфПол, ДокументОбъект, ИмяКонтейнера) Экспорт
	
	ДокументОбъект[ИмяКонтейнера].Очистить();
		
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_СпецУслДвиж 	= КС.XDTO_Вычислить(XDTO_КонтейнерСодержащийИнфПол, "СвГосСист");
	СпецУслДвижМассив	= КС.XDTO_ВычислитьМассивXDTO(XDTO_СпецУслДвиж);
	
	Для Каждого ЭлементСпецУслДвижXDTO Из СпецУслДвижМассив Цикл
				
		ИдНомУчетЕд_raw 	= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "ИдНомУчетЕд");
		ИдНомУчетЕдМассив	= КС.XDTO_ВычислитьМассивXDTO(ИдНомУчетЕд_raw);
		
		Для Каждого ЭлементИдНомУчетЕд Из ИдНомУчетЕдМассив Цикл
			
			НоваяСтрока = ДокументОбъект[ИмяКонтейнера].Добавить();
		
			НоваяСтрока.НаимГосСист = КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "НаимГосСист");
			НоваяСтрока.УчетЕд 		= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "УчетЕд");
			НоваяСтрока.ИнаяИнф 	= КС.XDTO_Вычислить(ЭлементСпецУслДвижXDTO, "ИнаяИнф");
			НоваяСтрока.ИдНомУчетЕд = ЭлементИдНомУчетЕд;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИсправления_ЗН(ДокОбъект, СодЗНИнф) Экспорт
	
	НомИспр						= XDTO_Вычислить(СодЗНИнф, "ИспрЗН.НомИспр");
	ДатаИспр					= XDTO_Вычислить(СодЗНИнф, "ИспрЗН.ДатаИспр");
	XDTO_ФИОИспр_Массив			= XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(СодЗНИнф, "ИспрЗН.ФИОЛиц"));
	
	ДокОбъект.ИсправлениеФИОЛиц.Очистить();
	
	Для Каждого XDTO_ФИОИспр Из XDTO_ФИОИспр_Массив Цикл 
		НовыйСотрудник = ДокОбъект.ИсправлениеФИОЛиц.Добавить();
		НовыйСотрудник.Фамилия 	= XDTO_Вычислить(XDTO_ФИОИспр, "Фамилия");
		НовыйСотрудник.Имя 		= XDTO_Вычислить(XDTO_ФИОИспр, "Имя");
		НовыйСотрудник.Отчество = XDTO_Вычислить(XDTO_ФИОИспр, "Отчество");
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДополнительныхПолучателей(XDTO_Файл, ДокументОбъект) Экспорт
	
	XDTO_ИдПолИной = XDTO_Вычислить(XDTO_Файл, "ИдПолИной");
	Если XDTO_ИдПолИной <> Неопределено Тогда 
		
		Массив_ИдПолИной = XDTO_ВычислитьМассивXDTO(XDTO_ИдПолИной);
		
		Для Каждого ИдентификаторУчастникаЭДО Из Массив_ИдПолИной Цикл
			
			НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИдентификаторУчастникаЭДО", ИдентификаторУчастникаЭДО);
			Если Не ЗначениеЗаполнено(НайденнаяОрганизация) Тогда 
				
				НоваяОргаДД = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
				НоваяОргаДД.ИдентификаторУчастникаЭДО = ИдентификаторУчастникаЭДО;
				НоваяОргаДД.Наименование = "Неизвестная организация дополнительный получатель файла обмена";
				НоваяОргаДД.Записать();
				НайденнаяОрганизация = НоваяОргаДД.Ссылка;
				
			КонецЕсли;
			
			НоваяСтрокаДопПолучателяДокумента = ДокументОбъект.ДополнительныеПолучателиФайла.Добавить();
			НоваяСтрокаДопПолучателяДокумента.ОрганизацияДиадок = НайденнаяОрганизация;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСопроводительныеДокументыИзXDTO(XDTO_СодержащийСопрДок, ДокТитулОбъект) Экспорт

	ДокТитулОбъект.СопроводительныеДокументы.Очистить();
	
	XDTO_СопрДок = XDTO_Вычислить(XDTO_СодержащийСопрДок, "СопрДок");
	Если XDTO_СопрДок <> Неопределено Тогда 
		
		XDTO_ДокКЗН_Массив 	= XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_СопрДок, "ДокКЗН"));
		Для Каждого XDTO_ДокКЗН Из XDTO_ДокКЗН_Массив Цикл 
			НовыйСопрДок = ДокТитулОбъект.СопроводительныеДокументы.Добавить();
			НовыйСопрДок.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКЗН;
			ЗаполнитьСтрокуСопрДокИзРеквДокТип(НовыйСопрДок, XDTO_ДокКЗН);
		КонецЦикла;
		
		XDTO_ДокКГр_Массив 	= XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_СопрДок, "ДокКГр"));
		Для Каждого XDTO_ДокКГр Из XDTO_ДокКГр_Массив Цикл 
			НовыйСопрДок = ДокТитулОбъект.СопроводительныеДокументы.Добавить();
			НовыйСопрДок.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКГр;
			ЗаполнитьСтрокуСопрДокИзРеквДокТип(НовыйСопрДок, XDTO_ДокКГр);
		КонецЦикла;
		
		XDTO_ДокКТрН_Массив 	= XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_СопрДок, "ДокКТрН"));
		Для Каждого XDTO_ДокКТрН Из XDTO_ДокКТрН_Массив Цикл 
			НовыйСопрДок = ДокТитулОбъект.СопроводительныеДокументы.Добавить();
			НовыйСопрДок.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКТрН;
			ЗаполнитьСтрокуСопрДокИзРеквДокТип(НовыйСопрДок, XDTO_ДокКТрН);
		КонецЦикла;
		
		XDTO_ДокПерЦенн_Массив 	= XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_СопрДок, "ДокПерЦенн"));
		Для Каждого XDTO_ДокПерЦенн Из XDTO_ДокПерЦенн_Массив Цикл 
			НовыйСопрДок = ДокТитулОбъект.СопроводительныеДокументы.Добавить();
			НовыйСопрДок.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокПерЦенн;
			ЗаполнитьСтрокуСопрДокИзРеквДокТип(НовыйСопрДок, XDTO_ДокПерЦенн);
		КонецЦикла;
		
		XDTO_РекСопрВед = XDTO_Вычислить(XDTO_СопрДок, "РекСопрВед");
		Если XDTO_РекСопрВед <> Неопределено Тогда
			НовыйСопрДок = ДокТитулОбъект.СопроводительныеДокументы.Добавить();
			НовыйСопрДок.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.СопрВед;
			ЗаполнитьСтрокуСопрДокИзРеквДокТип(НовыйСопрДок, XDTO_РекСопрВед);
		КонецЕсли;
		
	КонецЕсли;
     
КонецПроцедуры

Процедура ЗаполнитьСтрокуСопрДокИзРеквДокТип(СтрокаСопрДок, XDTO_РекСопрВед) Экспорт
	
	СтрокаСопрДок.ДокументНаименование 	=  XDTO_Вычислить(XDTO_РекСопрВед, "НаимДок");
	СтрокаСопрДок.ДокументНомер 		=  XDTO_Вычислить(XDTO_РекСопрВед, "НомерДок");
	СтрокаСопрДок.ДокументДата 			=  Конвертировать_ДатаТип_вДата(XDTO_Вычислить(XDTO_РекСопрВед, "ДатаДок"));
	СтрокаСопрДок.ДокументИдДок 		=  XDTO_Вычислить(XDTO_РекСопрВед, "ИдДок");
	СтрокаСопрДок.ДокументДопСведДок 	=  XDTO_Вычислить(XDTO_РекСопрВед, "ДопСведДок");
	
	Массив_XDTO_ИдРекСост = XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_РекСопрВед, "ИдРекСост"));
	Если Массив_XDTO_ИдРекСост.Количество() > 0 Тогда 
		СтрокаСопрДок.ДокументСоставитель = Конвертировать_ИдРекСостТип_вОрганизациюДиадок(Массив_XDTO_ИдРекСост[0]);
	КонецЕсли;
	Если Массив_XDTO_ИдРекСост.Количество() > 1 Тогда 
		СтрокаСопрДок.ДокументСоставитель2 = Конвертировать_ИдРекСостТип_вОрганизациюДиадок(Массив_XDTO_ИдРекСост[1]);
	КонецЕсли;
	
КонецПроцедуры

