Функция XDTO_ПЛ_СодИнфВозвр(НомерТитула, Формат = Неопределено, ДокТитул4) Экспорт

	ТипДокументооборота = "__PL";
		
	XDTO_СодИнфВозвр = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфВозвр", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СодИнфВозвр, "УИД_ПЛ", 		ДокТитул4.Титул1.УИД_ПЛ);
	XDTO_Установить(XDTO_СодИнфВозвр, "ДтВрВозвр", 		XDTO_ДатаВремяВЗТип(ДокТитул4.ДтВрВозвр));
	
	ТипТС = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.ЗначениеДляXDTO(ДокТитул4.Титул1.ТранспортноеСредство.ТипТСПоКлассификатору);
	XDTO_Установить(XDTO_СодИнфВозвр, 	"Тип", 			ТипТС);
	Если ДокТитул4.Титул1.ТранспортноеСредство.ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.Иной Тогда
		XDTO_Установить(XDTO_СодИнфВозвр, "ИнойТип", 	ДокТитул4.Титул1.ТранспортноеСредство.ИнойТипТС);
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфВозвр, "ОдомВозвр", 		ДокТитул4.ПоказанияОдометра);
	
	// ГСМ
	Если ДокТитул4.ОстаткиТоплива.Количество() > 0 Тогда		
		
		Для каждого ОстатокГСМ Из ДокТитул4.ОстаткиТоплива Цикл		
			
			XDTO_СвТопл = XDTO_ПЛ_XDTO_СвТопл(НомерТитула, Формат, "СодИнфВозвр.СвТоплВозвр", ТипДокументооборота, ОстатокГСМ);
			XDTO_СодИнфВозвр.СвТоплВозвр.Добавить(XDTO_СвТопл);
			
			НайдСтроки = ДокТитул4.ИнфПолОстаткиТоплива.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОстатковТоплива", ОстатокГСМ.ИдентификаторСтроки));
			Если НайдСтроки.Количество() > 0 Тогда			
				ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, "СодИнфВозвр.СвТоплВозвр", ТипДокументооборота, ДокТитул4.ИнфПолОстаткиТоплива, 
					XDTO_СвТопл, ОстатокГСМ.ИдентификаторСтроки, "ИдентификаторСтрокиОстатковТоплива");			
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого Заправка Из ДокТитул4.Заправки Цикл		
			
			XDTO_СвТопл = XDTO_ПЛ_XDTO_СвТопл(НомерТитула, Формат, "СодИнфВозвр.СвЗапрТопл", ТипДокументооборота, Заправка);
			XDTO_СодИнфВозвр.СвЗапрТопл.Добавить(XDTO_СвТопл);
			
			НайдСтроки = ДокТитул4.ИнфПолЗаправки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиЗаправок", Заправка.ИдентификаторСтроки));
			Если НайдСтроки.Количество() > 0 Тогда			
				ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, "СодИнфВозвр.СвЗапрТопл", ТипДокументооборота, ДокТитул4.ИнфПолЗаправки, 
					XDTO_СвТопл, Заправка.ИдентификаторСтроки, "ИдентификаторСтрокиЗаправок");			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// ИнфПол
	Если ДокТитул4.ИнфПол.Количество() > 0 Тогда			
		ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, "СодИнфВозвр", ТипДокументооборота, ДокТитул4.ИнфПол, XDTO_СодИнфВозвр);			
	КонецЕсли;	
	
	Возврат XDTO_СодИнфВозвр;
	
КонецФункции

Функция XDTO_ПЛ_СвЛицПл(Знач ДокТитул1, Знач НомерТитула, Знач ТипДокументооборота, Формат)
	
	Перем XDTO_Адрес, XDTO_ИдСв, XDTO_Контакт, XDTO_СвЛицПЛ;
	
	XDTO_СвЛицПЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ", ТипДокументооборота, Формат);
	
	XDTO_ИдСв 			= НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв", ТипДокументооборота, Формат);
	XDTO_ПЛ_СвЛицПЛ_ИдСв_ЗаполнитьИзОрганизацииДиадок(XDTO_ИдСв, НомерТитула, Формат, ДокТитул1.ЛицоОформившееПЛ, ТипДокументооборота);
	XDTO_Установить(XDTO_СвЛицПЛ, 	"ИдСв", 		XDTO_ИдСв);
	
	XDTO_Адрес			= НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.Адрес", ТипДокументооборота, Формат);
	XDTO_Адрес_ЗаполнитьИзОрганизацииДиадок(XDTO_Адрес, НомерТитула, Формат, ДокТитул1.ЛицоОформившееПЛ, ТипДокументооборота);
	XDTO_Установить(XDTO_СвЛицПЛ, "Адрес", XDTO_Адрес);
	
	XDTO_Контакт		= НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.Контакт", ТипДокументооборота, Формат);
	XDTO_Контакт_ЗаполнитьИзОрганизацииДиадок(XDTO_Контакт, НомерТитула, Формат, ДокТитул1.ЛицоОформившееПЛ, ТипДокументооборота);
	XDTO_Установить(XDTO_СвЛицПЛ, "Контакт", XDTO_Контакт);
	
	Если ДокТитул1.ЛицоОформившееПЛ = ДокТитул1.ТранспортноеСредство.АрендодательЛизингодатель 
		Или Не ЗначениеЗаполнено(ДокТитул1.ТранспортноеСредство.АрендодательЛизингодатель) Тогда
		XDTO_Установить(XDTO_СвЛицПЛ, "ЛицоОфПЛ", "С");
	Иначе
		XDTO_Установить(XDTO_СвЛицПЛ, "ЛицоОфПЛ", "А");
	КонецЕсли;
		
	Возврат XDTO_СвЛицПЛ;

КонецФункции

Функция XDTO_ДФ_СодДФИнфФт(НомерТитула, Формат = "5.01", ДокТитул1) Экспорт

	ТипДокументооборота = "__DF";
	
	XDTO_СодДФИнфФт = НовыйДочернийОбъектXDTO(НомерТитула, "СодДФИнфФт", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СодДФИнфФт, "УИД_ДФ", 		ДокТитул1.УИД_ДФ);
	XDTO_Установить(XDTO_СодДФИнфФт, "СрокВыпПрвз", 	ДокТитул1.СрокВыполненияПеревозки);
	
	Если ДокТитул1.ЭтоПассажиры Тогда 
		XDTO_Установить(XDTO_СодДФИнфФт, "ПрвзЛиц", 		?(ДокТитул1.КругЛицОпределен, "1", "0"));
		XDTO_Установить(XDTO_СодДФИнфФт, "ДопускПсжр", 	?(ДокТитул1.ПассажирыДопущены, "1", "0"));
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодДФИнфФт, "ИныеУслв", 	ДокТитул1.ИныеУсловия);
	XDTO_Установить(XDTO_СодДФИнфФт, "ТипТС", 	ДокТитул1.ТСТип);
	
	XDTO_СвФт = XDTO_СвФт(НомерТитула, Формат, ДокТитул1, ТипДокументооборота);
	XDTO_Установить(XDTO_СодДФИнфФт, "СвФт", 	XDTO_СвФт);
	
	XDTO_СвФщ = XDTO_СвФщ(НомерТитула, Формат, ДокТитул1, ТипДокументооборота);
	XDTO_Установить(XDTO_СодДФИнфФт, "СвФщ", 	XDTO_СвФщ);
	
	XDTO_МршПодТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодДФИнфФт.МршПодТС", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_МршПодТС, "ДатВрПодТС", 		XDTO_ДатаВремяВЗТип(ДокТитул1.ДатаИВремяПодачи));
	XDTO_Установить(XDTO_МршПодТС, "НалКоорТочВрПодТС",	"1");
	
	XDTO_МршПрвз = НовыйБазовыйОбъектXDTO(НомерТитула, "СведМршТип" , ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_МршПрвз, "МршТекст",	ДокТитул1.Маршрут);
	XDTO_Установить(XDTO_МршПрвз, "МршМашЧит",	ДокТитул1.МаршрутМашиночитаемый);
	XDTO_Установить(XDTO_МршПодТС, "МршПрвз",	XDTO_МршПрвз);
	
	XDTO_Установить(XDTO_МршПодТС, "АдрМесПодТС",	XDTO_АдресПунктаМаршрута(ДокТитул1.МестоПодачи, НомерТитула, ТипДокументооборота, Формат));
	XDTO_Установить(XDTO_СодДФИнфФт, "МршПодТС", 	XDTO_МршПодТС);
	
	Если Не ДокТитул1.ЭтоПассажиры Тогда
		
		XDTO_НаимГруз = НовыйДочернийОбъектXDTO(НомерТитула, "СодДФИнфФт.НаимГруз", ТипДокументооборота, Формат);
		Для Каждого СтрокаТовара Из ДокТитул1.Товары Цикл 
			XDTO_ОпГруз = НовыйДочернийОбъектXDTO(НомерТитула, "СодДФИнфФт.НаимГруз.ОпГруз", ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_ОпГруз, "НаимГруз", 	СтрокаТовара.ОтгрузочноеНаименование);
			XDTO_Установить(XDTO_ОпГруз, "КодТовНом", 	СокрЛП(СтрокаТовара.КодТНВЭД));
			XDTO_Установить(XDTO_ОпГруз, "СостГруз", 	СтрокаТовара.СостояниеГруза);
			XDTO_Установить(XDTO_ОпГруз, "СпУпак", 		СтрокаТовара.СпособУпаковки);
			XDTO_Установить(XDTO_ОпГруз, "ВидТар", 		СтрокаТовара.ВидТары.Код);
			XDTO_Установить_Плотн(XDTO_ОпГруз, СтрокаТовара.Плотность);
			XDTO_Установить(XDTO_ОпГруз, "ВозмРаспр", 	?(СтрокаТовара.ВозможностьРаспределения, "1", "0"));
			XDTO_Установить(XDTO_ОпГруз, "ИнфГруз", 	СтрокаТовара.ДопИнформация);
			XDTO_Установить(XDTO_ОпГруз, "Объем", 		СтрокаТовара.ОбъемКубМ);
			XDTO_Установить(XDTO_ОпГруз, "КолМест", 	СтрокаТовара.КоличествоМест);
			XDTO_ОпГруз.Марк.Добавить("Отсутствует");
			XDTO_Габар = НовыйБазовыйОбъектXDTO(НомерТитула, "ГабарТип" , ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_Габар, "ВысЗнач", 	СтрокаТовара.Высота);
			XDTO_Установить(XDTO_Габар, "ДлЗнач", 	СтрокаТовара.Длина);
			XDTO_Установить(XDTO_Габар, "ШирЗнач", 	СтрокаТовара.Ширина);
			XDTO_Установить(XDTO_ОпГруз, "Габар", 		XDTO_Габар);
			XDTO_Масса = XDTO_МассаТип(НомерТитула,
										ТипДокументооборота,
										СтрокаТовара.МассаПлановаяБруттоКг,
										СтрокаТовара.МассаПлановаяНеттоКг,
										СтрокаТовара.КоличествоПаллет,
										СтрокаТовара.МассаТарыКг,
										Формат);
			XDTO_Установить(XDTO_ОпГруз, "МасГруз", 		XDTO_Масса);
		    XDTO_НаимГруз.ОпГруз.Добавить(XDTO_ОпГруз);
		КонецЦикла;
		
		XDTO_Установить(XDTO_СодДФИнфФт, "НаимГруз", 	XDTO_НаимГруз);
		
	КонецЕсли;
	
	XDTO_РазПлатТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодДФИнфФт.РазПлатТС", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_РазПлатТС,	 "СтУсл", 		ДокТитул1.ПлатСтУсл, Истина);
	XDTO_Установить(XDTO_РазПлатТС,	 "РасхПлатДор", ДокТитул1.ПлатРасхПлатДор);
	XDTO_Установить(XDTO_РазПлатТС,	 "РасхТамПош", 	ДокТитул1.ПлатРасхТамПош);
	XDTO_Установить(XDTO_РазПлатТС,	 "РасхПром", 	ДокТитул1.ПлатРасхПром);
	XDTO_Установить(XDTO_РазПлатТС,	 "Расчет", 		ДокТитул1.ПлатРасчет);
	XDTO_Установить(XDTO_РазПлатТС,	 "РазмерПлат", 	ДокТитул1.ПлатРазмерПлат);
	XDTO_Установить(XDTO_СодДФИнфФт, "РазПлатТС", 	XDTO_РазПлатТС);
	
	// ИнфПол
	Если ДокТитул1.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул1.ИнфПол Цикл
				
			XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодДФИнфФт", ТипДокументооборота);
			XDTO_СодДФИнфФт.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодДФИнфФт;
	
КонецФункции

