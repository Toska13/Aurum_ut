	//	XDTO_Установить(XDTO_Объект, "ДатаНач", 	XDTO_ДатаТип(ДатаНач));
	//КонецЕсли;
	//XDTO_Установить(XDTO_Объект, "ВнНомДовер", 		ВнНомДовер);
	//Если ЗначениеЗаполнено(ДатаВнРегДовер) Тогда 
	//	XDTO_Установить(XDTO_Объект, "ДатаВнРегДовер", 	XDTO_ДатаТип(ДатаВнРегДовер));
	//КонецЕсли;
	//XDTO_Установить(XDTO_Объект, "СведСистОтм", 	СведСистОтм);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ПодписантУведомления(ТипДокументооборота = "__UvUtoch", Формат = "1.03", ПодписантСтруктура, XDTO_СвДовер = Неопределено) Экспорт

	ИмяТэгаПодписант = "Подписант";
	НомерТитула = 0;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант, ТипДокументооборота, Формат);
	
	// ФИО
	XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант + ".ФИО", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ПодписантСтруктура.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		ПодписантСтруктура.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	ПодписантСтруктура.Отчество);
	
	XDTO_Установить(XDTO_Объект, "ФИО", XDTO_ФИО);
	
	XDTO_Установить(XDTO_Объект, "Должн", 		ПодписантСтруктура.Должность);
	XDTO_Установить(XDTO_Объект, "ТипПодпис", 	"1");
	
	XDTO_Установить(XDTO_Объект, "СтатПодп", 	ПодписантСтруктура.СтатусПодписанта);

	Если ПодписантСтруктура.СтатусПодписанта = "3" Тогда
		
		XDTO_СвДоверБум = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант + ".СвДоверБум", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвДоверБум, "ДатаДовер", 	XDTO_ДатаТип(ПодписантСтруктура.СвДоверБум_ДатаДовер));
		НомерДоверенности = "без номера";
		Если ЗначениеЗаполнено(СокрЛП(ПодписантСтруктура.СвДоверБум_ВнНомДовер)) Тогда 
			НомерДоверенности = СокрЛП(ПодписантСтруктура.СвДоверБум_ВнНомДовер);
		КонецЕсли;
		XDTO_Установить(XDTO_СвДоверБум, "ВнНомДовер", 	НомерДоверенности);
		
		XDTO_Объект.СвДоверБум = XDTO_СвДоверБум;
		
	ИначеЕсли ПодписантСтруктура.СтатусПодписанта = "2" Тогда
		
		XDTO_СвДоверЭл = НовыйДочернийОбъектXDTO(НомерТитула, ИмяТэгаПодписант + ".СвДоверЭл", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвДоверЭл, "НомДовер", 	ПодписантСтруктура.МЧД);
		XDTO_Установить(XDTO_СвДоверЭл, "ВнНомДовер", 	ПодписантСтруктура.МЧД);
		XDTO_Установить(XDTO_СвДоверЭл, "ДатаВыдДовер", 	XDTO_ДатаТип(ПодписантСтруктура.ДатаВыпускаМЧД));
		XDTO_Установить(XDTO_СвДоверЭл, "СпособПредставл", 	"2");
		
		XDTO_Установить(XDTO_СвДоверЭл, "СвСистХран", 	ПодписантСтруктура.ИдСистХран);
		
		XDTO_Объект.СвДоверЭл = XDTO_СвДоверЭл;
		
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СодЗНИнфФт_Т1(НомерТитула, Формат = Неопределено, ДокТитул1) Экспорт

	ТипДокументооборота = "__zakazNarTitle";
	
	ДокументЗН = ДокТитул1.ДокументЗН;
	XDTO_СодЗНИнфФт = НовыйДочернийОбъектXDTO(1, "СодЗНИнфФт", ТипДокументооборота);
	Если ЗначениеЗаполнено(ДокТитул1.УИД_ЗН) Тогда 
		XDTO_Установить(XDTO_СодЗНИнфФт, "УИД_ЗН", 	ДокТитул1.УИД_ЗН);
	КонецЕсли;
	
	НомерЗаказа = ДокументЗН.НомерЗН;
	Если Не ЗначениеЗаполнено(НомерЗаказа) Тогда 
		НомерЗаказа = "Без номера";
	КонецЕсли;
	XDTO_Установить(XDTO_СодЗНИнфФт, "НомерЗН", 		НомерЗаказа);
	XDTO_Установить(XDTO_СодЗНИнфФт, "ДатаЗН", 			XDTO_ДатаТип(ДокументЗН.ДатаЗН));
	XDTO_Установить(XDTO_СодЗНИнфФт, "СвСрокВыпПрвз", 	ДокументЗН.СрокВыполненияПеревозки);
	
	// исправление
	Если ЗначениеЗаполнено(ДокТитул1.НомИспр) Тогда 
		XDTO_ИспрЗН = НовыйДочернийОбъектXDTO(1, "СодЗНИнфФт.ИспрЗН", ТипДокументооборота);
		XDTO_Установить(XDTO_ИспрЗН, "НомИспр", 	ДокТитул1.НомИспр);
		XDTO_Установить(XDTO_ИспрЗН, "ДатаИспр", 	ДокТитул1.ДатаИспр);
		XDTO_Установить(XDTO_СодЗНИнфФт, "ИспрЗН", 	XDTO_ИспрЗН);
	КонецЕсли;
	
	// Сведения о фрахтователе	СвФт
	XDTO_СвФт = XDTO_СвФт(НомерТитула, , ДокТитул1);
	XDTO_Установить(XDTO_СодЗНИнфФт, "СвФт", 	XDTO_СвФт);
	
	// Сведения об условиях фрахтования
	XDTO_СвУслФрах = XDTO_СвУслФрах(НомерТитула, , ДокТитул1);
	XDTO_Установить(XDTO_СодЗНИнфФт, "СвУслФрах", 	XDTO_СвУслФрах);
	
	// Сведения о грузе  СвГруз
	XDTO_СвГруз = XDTO_СвГруз(НомерТитула, , ДокТитул1, ТипДокументооборота);
	XDTO_Установить(XDTO_СодЗНИнфФт, "СвГруз", 	XDTO_СвГруз);
	
	// Сведения о сопроводительных документах на груз
	Если ДокТитул1.СопроводительныеДокументы.Количество() > 0 Тогда
		
		XDTO_СопрДок = XDTO_СопрДок(ДокТитул1, НомерТитула, ТипДокументооборота);
		
		XDTO_Установить(XDTO_СодЗНИнфФт, "СопрДок", 	XDTO_СопрДок);
		
	КонецЕсли;
	
	// Сведения об указаниях фрахтователя
	XDTO_СвУказФт = XDTO_СвУказФт(НомерТитула, , ДокТитул1);
	XDTO_Установить(XDTO_СодЗНИнфФт, "СвУказФт", 	XDTO_СвУказФт);
	
	// Сведения о маршруте и месте подачи транспортного средства
	XDTO_СвМршПодТС = XDTO_СвМршПодТС(НомерТитула, , ДокТитул1);
	XDTO_Установить(XDTO_СодЗНИнфФт, "СвМршПодТС", 	XDTO_СвМршПодТС);
	
	// TODO ИнфПол Информационное поле
	
	Возврат XDTO_СодЗНИнфФт;
	
КонецФункции

Функция XDTO_СопрДок(Знач ДокТитул1, Знач НомерТитула, Знач ТипДокументооборота)
	
	Если ТипДокументооборота = "__zakazNarTitle" Тогда 
		XDTO_СопрДок = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФт.СопрДок", ТипДокументооборота);
	ИначеЕсли ТипДокументооборота = "__etrnTitle" Тогда 
		XDTO_СопрДок = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СопрДок", ТипДокументооборота);
	Иначе
		ВызватьИсключение "Не реализован Функция XDTO_СопрДок для ТипДокументооборота = " + ТипДокументооборота;
	КонецЕсли;
	
	Для Каждого СтрокаСопрДокумента Из ДокТитул1.СопроводительныеДокументы Цикл
		
		Если СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКЗН 
			ИЛИ СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКГр 
			ИЛИ СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКТрН 
			ИЛИ СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокПерЦенн 
			ИЛИ СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.СопрВед Тогда
			
			XDTO_ДокРеквДокТип = НовыйБазовыйОбъектXDTO(НомерТитула, "РеквДокТип", ТипДокументооборота);
			XDTO_Установить(XDTO_ДокРеквДокТип, "НаимДок", 		СтрокаСопрДокумента.ДокументНаименование);
			XDTO_Установить(XDTO_ДокРеквДокТип, "НомерДок", 	СтрокаСопрДокумента.ДокументНомер);
			XDTO_Установить(XDTO_ДокРеквДокТип, "ДатаДок", 		XDTO_ДатаТип(СтрокаСопрДокумента.ДокументДата));
			XDTO_Установить(XDTO_ДокРеквДокТип, "ИдДок", 		СтрокаСопрДокумента.ДокументИдДок);
			XDTO_Установить(XDTO_ДокРеквДокТип, "ДопСведДок", 	СтрокаСопрДокумента.ДокументДопСведДок);
			
			Если ЗначениеЗаполнено(СтрокаСопрДокумента.ДокументСоставитель) Тогда
				ДокументСоставительИдРекСост = XDTO_ИдРекСостТип(НомерТитула, СтрокаСопрДокумента.ДокументСоставитель, ТипДокументооборота);
				XDTO_ДокРеквДокТип.ИдРекСост.Добавить(ДокументСоставительИдРекСост);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаСопрДокумента.ДокументСоставитель2) Тогда
				ДокументСоставительИдРекСост2 = XDTO_ИдРекСостТип(НомерТитула, СтрокаСопрДокумента.ДокументСоставитель2, ТипДокументооборота);
				XDTO_ДокРеквДокТип.ИдРекСост.Добавить(ДокументСоставительИдРекСост2);
			КонецЕсли;
			
			Если СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКЗН Тогда 
				XDTO_СопрДок.ДокКЗН.Добавить(XDTO_ДокРеквДокТип);
			ИначеЕсли СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКГр Тогда 
				XDTO_СопрДок.ДокКГр.Добавить(XDTO_ДокРеквДокТип);
			ИначеЕсли СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.СопрВед Тогда 
				XDTO_Установить(XDTO_СопрДок, "РекСопрВед", 	XDTO_ДокРеквДокТип);
			ИначеЕсли СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКТрН Тогда 
				XDTO_СопрДок.ДокКТрН.Добавить(XDTO_ДокРеквДокТип);
			ИначеЕсли СтрокаСопрДокумента.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокПерЦенн Тогда 
				XDTO_СопрДок.ДокПерЦенн.Добавить(XDTO_ДокРеквДокТип);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат XDTO_СопрДок;

КонецФункции

Функция XDTO_СодЗНИнфФт_Т3(НомерТитула, Формат = Неопределено, ДокТитул3) Экспорт

	ТипДокументооборота = "__zakazNarTitle";
	
	ДокументЗН = ДокТитул3.ДокументЗН;
	XDTO_СодЗНИнфФт = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФт", ТипДокументооборота);
	Если ЗначениеЗаполнено(ДокументЗН.УИД) Тогда 
		XDTO_Установить(XDTO_СодЗНИнфФт, "УИД_ЗН", 	ДокументЗН.УИД);
	Иначе
		XDTO_Установить(XDTO_СодЗНИнфФт, "УИД_ЗН", 	"Без номера");
	КонецЕсли;
	
	// Фактические дата и время подачи транспортного средства
	XDTO_Установить(XDTO_СодЗНИнфФт, "ДатВрПодТС", 	XDTO_ДатаВремяВЗТип(ДокТитул3.ДатВрПодТС));
	XDTO_Установить(XDTO_СодЗНИнфФт, "НалКоорТочВрПодТС", 	"1");
	
	Если ДокТитул3.ОтметкиФрахтователя.Количество() > 0 Тогда 
		Для Каждого СтрокаОтмет Из ДокТитул3.ОтметкиФрахтователя Цикл
				
			XDTO_Отмет = XDTO_Отмет(НомерТитула, Формат, ДокТитул3, СтрокаОтмет, "СодЗНИнфФт.ОтметФт", ТипДокументооборота);
			XDTO_СодЗНИнфФт.ОтметФт.Добавить(XDTO_Отмет)
				
		КонецЦикла;
	КонецЕсли;
	
	// TODO ИнфПол Информационное поле
	
	Возврат XDTO_СодЗНИнфФт;
	
КонецФункции

Функция XDTO_СодЗНИнфФщ_Т2(НомерТитула, Формат = Неопределено, ДокТитул2) Экспорт

	ТипДокументооборота = "__zakazNarTitle";
	
	ДокументЗН = ДокТитул2.ДокументЗН;
	XDTO_СодЗНИнфФщ = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФщ", ТипДокументооборота);
	Если ЗначениеЗаполнено(ДокументЗН.УИД) Тогда 
		XDTO_Установить(XDTO_СодЗНИнфФщ, "УИД_ЗН", 	ДокументЗН.УИД);
	Иначе
		XDTO_Установить(XDTO_СодЗНИнфФщ, "УИД_ЗН", 	"Без номера");
	КонецЕсли;
	
	// Сведения о фрахтовщике СвФщ
	XDTO_СвФщ = XDTO_СвФщ(НомерТитула, , ДокТитул2);
	XDTO_Установить(XDTO_СодЗНИнфФщ, "СвФщ", 	XDTO_СвФщ);
	
	// Сведения об информации о принятии заказ-наряда к исполнению
	XDTO_СвПринЗНИсп = XDTO_СвПринЗНИсп(НомерТитула, , ДокТитул2);
	XDTO_Установить(XDTO_СодЗНИнфФщ, "СвПринЗНИсп", 	XDTO_СвПринЗНИсп);
	
	// Сведения о транспортном средстве
	XDTO_СвТС = XDTO_СвТС(НомерТитула, , ДокТитул2, ТипДокументооборота);
	XDTO_Установить(XDTO_СодЗНИнфФщ, "СвТС", 	XDTO_СвТС);
	
	// Сведения о прочих условиях
	Для Каждого СтрокаСвПрочУсл Из ДокТитул2.СвПрочУсл Цикл 
		XDTO_СвПрочУсл = XDTO_СвПрочУсл(НомерТитула, , ДокТитул2, СтрокаСвПрочУсл);
		XDTO_СодЗНИнфФщ.СвПрочУсл.Добавить(XDTO_СвПрочУсл);
	КонецЦикла;
	
	// Сведения о размере платы за пользование транспортным средством
	Если ЗначениеЗаполнено(ДокТитул2.ПлатСтУсл) Тогда 
		XDTO_СвРазПлатТС = XDTO_СвРазПлатТС(НомерТитула, , ДокТитул2);
		XDTO_Установить(XDTO_СодЗНИнфФщ, "СвРазПлатТС", 	XDTO_СвРазПлатТС);
	КонецЕсли;
	
	// TODO ИнфПол Информационное поле
	
	Возврат XDTO_СодЗНИнфФщ;
	
КонецФункции

Функция XDTO_СодЗНИнфФщ_Т4(НомерТитула, Формат = Неопределено, ДокТитул4) Экспорт

	ТипДокументооборота = "__zakazNarTitle";
	
	ДокументЗН = ДокТитул4.ДокументЗН;
	XDTO_СодЗНИнфФщ = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФщ", ТипДокументооборота);
	Если ЗначениеЗаполнено(ДокументЗН.УИД) Тогда 
