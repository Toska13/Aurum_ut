	XDTO_Установить(XDTO_СвМедРабИЛИОрг, "ЛицензМО", XDTO_ЛицензМО);
	
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	МедРаботник.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		МедРаботник.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	МедРаботник.Отчество);
	XDTO_Установить(XDTO_СвМедРабИЛИОрг, "ФИО", XDTO_ФИО);
	
	XDTO_Установить(XDTO_СвМедРабИЛИОрг, "СНИЛС", ДокТитул2или5.МедРаботник.СНИЛС);
		
	Если МедикВШтате Тогда 
		XDTO_Установить(XDTO_СодИнфМО, "СвМедРаб", XDTO_СвМедРабИЛИОрг);
	Иначе
		XDTO_Установить(XDTO_СодИнфМО, "СвМедОрг", XDTO_СвМедРабИЛИОрг);
	КонецЕсли;
	 	
	// СвМОПред / Посл
	XDTO_СвМОПредИлиПосл = НовыйДочернийОбъектXDTO(НомерТитула, тегСодИнфМО + ".СвМО" + Постфикс, ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СвМОПредИлиПосл, "ДатВрПрМО", 		XDTO_ДатаВремяВЗТип(ДокТитул2или5.ДатВрПрМО));
	
	Если НомерТитула = 2 Тогда
		XDTO_Установить(XDTO_СвМОПредИлиПосл, "СвРезМО", ?(ДокТитул2или5.ЕстьОтказВПодписи, "2", "1"));	
	Иначе //5
		XDTO_Установить(XDTO_СвМОПредИлиПосл, "СвРезПМО", Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра.ЗначениеДляXDTO(ДокТитул2или5.РезультатМедОсмотра));
