	СтруктураСущности.Вставить(ДопРеквизитИмя + "_АдресКварт", 			СокрЛП(ЗначениеВРеквизите.АдресКварт));
	
	Возврат СтруктураСущности;

КонецФункции

Процедура ДобавитьАдрПункт(Знач XDTO_СодИнфГО, Знач НомерТитула, Знач СтрокаДокументаАдрПункт, Знач ТипДокументооборота, Формат)
	
	Перем XDTO_АдресПункт, XDTO_АдрПункт, XDTO_ОргВладИнфр;
	
	XDTO_АдрПункт = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.АдрПункт", ТипДокументооборота, Формат);
	
	Если СтрокаДокументаАдрПункт.Погрузка Тогда
		XDTO_Установить(XDTO_АдрПункт, "Опер", "Погрузка");
	ИначеЕсли СтрокаДокументаАдрПункт.Выгрузка Тогда
		XDTO_Установить(XDTO_АдрПункт, "Опер", "Выгрузка");
	КонецЕсли;
	
	XDTO_Установить(XDTO_АдрПункт, "ПорНомПункт", Формат(СтрокаДокументаАдрПункт.НомерСтроки, "ЧГ="));
	
	Если ЗначениеЗаполнено(СтрокаДокументаАдрПункт.ДатВрОпер) 
		ИЛИ ЗначениеЗаполнено(СтрокаДокументаАдрПункт.ПредВрОпер) Тогда 
		XDTO_Установить(XDTO_АдрПункт,	"ДатВрОпер", 	XDTO_ДатаВремяВЗТип(СтрокаДокументаАдрПункт.ДатВрОпер));
		XDTO_Установить(XDTO_АдрПункт,	"НалКоорТочВрОпер", 	"1");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДокументаАдрПункт.ПредВрОпер) Тогда 
		XDTO_Установить(XDTO_АдрПункт,	"ПредВрОпер", XDTO_ВремяВЗТип(СтрокаДокументаАдрПункт.ПредВрОпер));
		XDTO_Установить(XDTO_АдрПункт,	"НалКоорТочПредВрОпер", 	"1");
	КонецЕсли;
	
	Если СтрокаДокументаАдрПункт.Погрузка Тогда
		
		XDTO_ОргВладИнфр =  НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.АдрПункт.ОргВладИнфр", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ОргВладИнфр,	"НаимВладИнфр", СтрокаДокументаАдрПункт.ПунктМаршрута.Собственник.НаименованиеОрганизацииПолное);
		XDTO_Установить(XDTO_ОргВладИнфр,	"ИННВладИнфр", 	СтрокаДокументаАдрПункт.ПунктМаршрута.Собственник.ИНН);
		XDTO_Установить(XDTO_АдрПункт, "ОргВладИнфр", XDTO_ОргВладИнфр);
		
	КонецЕсли;
	
	XDTO_АдресПункт = XDTO_АдресПунктаМаршрута(СтрокаДокументаАдрПункт.ПунктМаршрута, НомерТитула, ТипДокументооборота, Формат);	
	
	XDTO_АдрПункт.АдресПункт = XDTO_АдресПункт;
	
	XDTO_СодИнфГО.АдрПункт.Добавить(XDTO_АдрПункт)

КонецПроцедуры

// Процедура - XDTO поместить доп реквизиты в инф пол
// В ЗНАЧЕНИЯХ СООТВЕТСТВИЯ МОГУТ БЫТЬ ТОЛЬКО ПРОСТЕЙШИЕ ТИПЫ!
//
// Параметры:
