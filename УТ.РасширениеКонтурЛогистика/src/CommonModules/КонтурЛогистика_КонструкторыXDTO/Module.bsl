		XDTO_Установить(XDTO_СвТСВыпуск, 	"ДтВрНачРабГрф",	XDTO_ДатаВремяВЗТип(ДокТитул3.ДтВрНачРабГрф));
		XDTO_Установить(XDTO_СвТСВыпуск, 	"ДтВрКонРабГрф",	XDTO_ДатаВремяВЗТип(ДокТитул3.ДтВрКонРабГрф));
		
		ТипТС = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.ЗначениеДляXDTO(Титул1.ТранспортноеСредство.ТипТСПоКлассификатору);
		XDTO_Установить(XDTO_СвТСВыпуск, 	"Тип", 				ТипТС);
		Если Титул1.ТранспортноеСредство.ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.Иной Тогда
			XDTO_Установить(XDTO_СвТСВыпуск, "ИнойТип", 		Титул1.ТранспортноеСредство.ИнойТипТС);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокТитул3.ПоказанияОдометра) Тогда
			XDTO_Установить(XDTO_СвТСВыпуск, "ОдомВыпуск", 		ДокТитул3.ПоказанияОдометра, Истина);
		КонецЕсли;
		
		XDTO_Установить(XDTO_СвТСВыпуск, 	"РегНомер", 		Титул1.ТранспортноеСредство.РегНомер);
		XDTO_Установить(XDTO_СвТСВыпуск, 	"ИнвНомер", 		Титул1.ТранспортноеСредство.ИнвНомер);
		
		Если ЗначениеЗаполнено(Прицеп) Тогда 
			XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, 	"СодИнфТехСост.СвТСВыпуск.РегНомПрицеп", ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_Прицеп, 						"РегНомер", 	Прицеп.РегНомер);
			XDTO_СвТСВыпуск.РегНомПрицеп.Добавить(XDTO_Прицеп);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Прицеп2) Тогда 
			XDTO_Прицеп2 = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост.СвТСВыпуск.РегНомПрицеп", ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_Прицеп2, 						"РегНомер", 	Прицеп.РегНомер2);
			XDTO_СвТСВыпуск.РегНомПрицеп.Добавить(XDTO_Прицеп2);			
		КонецЕсли;
		
		// ГСМ
		Если ДокТитул3.ОстаткиТоплива.Количество() > 0 Тогда		
			Для каждого ОстатокГСМ Из ДокТитул3.ОстаткиТоплива Цикл		
				
				XDTO_СвТоплВыезд = XDTO_ПЛ_XDTO_СвТопл(НомерТитула, Формат, "СодИнфВыпуск.СвТСВыпуск.СвТоплВыезд", ТипДокументооборота, ОстатокГСМ);
				XDTO_СвТСВыпуск.СвТоплВыезд.Добавить(XDTO_СвТоплВыезд);
				
				НайдСтроки = ДокТитул3.ИнфПолОстаткиТоплива.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОстатковТоплива", ОстатокГСМ.ИдентификаторСтроки));
				Если НайдСтроки.Количество() > 0 Тогда			
					ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, "СодИнфВыпуск.СвТСВыпуск.СвТоплВыезд", ТипДокументооборота, ДокТитул3.ИнфПолОстаткиТоплива, 
						XDTO_СвТоплВыезд, ОстатокГСМ.ИдентификаторСтроки, "ИдентификаторСтрокиОстатковТоплива");			
				КонецЕсли;
				
			КонецЦикла;						
		КонецЕсли;
		
		// ИнфПол
		Если ДокТитул3.ИнфПол.Количество() > 0 Тогда			
			ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, "СодИнфВыпуск.СвТСВыпуск",ТипДокументооборота, ДокТитул3.ИнфПол, XDTO_СвТСВыпуск);			
		КонецЕсли;
		
		XDTO_Установить(XDTO_СодИнфВыпуск, "СвТСВыпуск", XDTO_СвТСВыпуск);
		
	КонецЕсли;
		
	Возврат XDTO_СодИнфВыпуск;
	
КонецФункции

Процедура ЗаписатьПричинуОтказаВИнфПоля(НомерТитула, Формат, ПутьДочернегоОбъекта, ТипДокументооборота, XDTOДочернегоОбъекта, ДокТитул)

	Если Не ЗначениеЗаполнено(ДокТитул.ПричинаОтказаВПодписи) Тогда
		Возврат;
	КонецЕсли;
	
	XDTO_ИнфПол = НовыйДочернийОбъектXDTO(НомерТитула, ПутьДочернегоОбъекта + ".ИнфПол", ТипДокументооборота, Формат);
	
	XDTO_ТекстИнф = НовыйДочернийОбъектXDTO(НомерТитула, "" + ПутьДочернегоОбъекта + ".ИнфПол.ТекстИнф", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ТекстИнф, "Идентиф", "ПричинаОтказаВПодписи"); 
	XDTO_Установить(XDTO_ТекстИнф, "Значение", ДокТитул.ПричинаОтказаВПодписи);
	
	XDTO_ИнфПол.ТекстИнф.Добавить(XDTO_ТекстИнф);
	
	XDTOДочернегоОбъекта.ИнфПол.Добавить(XDTO_ИнфПол);
	
КонецПроцедуры

Процедура ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат = Неопределено, ПутьДочернегоОбъекта, ТипДокументооборота, 
	ТЧИнфПол, XDTOДочернегоОбъекта, ИдСтроки = "", НаименованиеКолонкиИдСтроки = "")
	
	тз = ТЧИнфПол.Выгрузить();
		
	тзСвернутая = ТЧИнфПол.Выгрузить();
	тзСвернутая.Свернуть("ИдФайлИнфПол");
	
	Для Каждого СтрокаИдФайлИнфПол Из тзСвернутая Цикл
				
		XDTO_ИнфПол = XDTO_ИнфПолСИдФайл(НомерТитула, Формат, СтрокаИдФайлИнфПол, ПутьДочернегоОбъекта, ТипДокументооборота);
		
		Если ЗначениеЗаполнено(ИдСтроки) Тогда
			СтрокаОтбор = "ИдФайлИнфПол" + "," + НаименованиеКолонкиИдСтроки; 
			НайдСтроки = тз.НайтиСтроки(Новый Структура(СтрокаОтбор, СтрокаИдФайлИнфПол.ИдФайлИнфПол, ИдСтроки));
		Иначе
			НайдСтроки = тз.НайтиСтроки(Новый Структура("ИдФайлИнфПол", СтрокаИдФайлИнфПол.ИдФайлИнфПол));
		КонецЕсли;
		
		Для Каждого СтрокаИнфПол Из НайдСтроки Цикл
			
			XDTO_ТекстИнф = XDTO_ТекстИнф(НомерТитула, Формат, СтрокаИнфПол, ПутьДочернегоОбъекта, ТипДокументооборота);
			XDTO_ИнфПол.ТекстИнф.Добавить(XDTO_ТекстИнф);
			
		КонецЦикла;
		
		Если НайдСтроки.Количество() > 0 Тогда
			XDTOДочернегоОбъекта.ИнфПол.Добавить(XDTO_ИнфПол);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция XDTO_ПЛ_XDTO_СвТопл(НомерТитула, Формат = Неопределено, ПутьДочернегоОбъекта, ТипДокументооборота, ГСМ) Экспорт
	
	XDTO_СвТопл = НовыйДочернийОбъектXDTO(НомерТитула, ПутьДочернегоОбъекта, ТипДокументооборота, Формат);
				
	XDTO_Установить(XDTO_СвТопл, "ВидТопл", Перечисления.КонтурЛогистика_ТипыТоплива.ЗначениеДляXDTO(ГСМ.Топливо.ТипТоплива));
	
	Если ГСМ.Топливо.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline Тогда
		
		XDTO_Установить(XDTO_СвТопл, "СвМаркБенз", 
			Перечисления.КонтурЛогистика_ВидыТоплива.ЗначениеДляXDTO(ГСМ.Топливо.ВидТоплива, ГСМ.Топливо.ТипТоплива));
			
		Если ГСМ.Топливо.ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other Тогда
			XDTO_Установить(XDTO_СвТопл, "МаркБензИной", ГСМ.Топливо.ВидТопливаПрочее);	
		КонецЕсли;
			
	КонецЕсли;
	
	Если ГСМ.Топливо.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Diesel Тогда
		
		XDTO_Установить(XDTO_СвТопл, "СвМаркДизл", 
			Перечисления.КонтурЛогистика_ВидыТоплива.ЗначениеДляXDTO(ГСМ.Топливо.ВидТоплива, ГСМ.Топливо.ТипТоплива));
			
		Если ГСМ.Топливо.ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other Тогда
			XDTO_Установить(XDTO_СвТопл, "МаркДизлИной", ГСМ.Топливо.ВидТопливаПрочее);	
		КонецЕсли;
			
	КонецЕсли;
	
	Если ГСМ.Топливо.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas Тогда
		
		XDTO_Установить(XDTO_СвТопл, "СвМаркСжГаз", 
			Перечисления.КонтурЛогистика_ВидыТоплива.ЗначениеДляXDTO(ГСМ.Топливо.ВидТоплива, ГСМ.Топливо.ТипТоплива));
			
		Если ГСМ.Топливо.ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other Тогда
			XDTO_Установить(XDTO_СвТопл, "МаркСжГазИной", ГСМ.Топливо.ВидТопливаПрочее);	
		КонецЕсли;
			
	КонецЕсли;
	
	XDTO_Установить(XDTO_СвТопл, "ЕдИзмТопл", 
		Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.ЗначениеДляXDTO(ГСМ.Топливо.ЕдиницаИзмеренияПоКлассификатору));
	Если ГСМ.Топливо.ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.Иное Тогда
		XDTO_Установить(XDTO_СвТопл, "ИнаяЕдИзм", ГСМ.Топливо.ЕдиницаИзмерения);	
	КонецЕсли;
	
	XDTO_Установить(XDTO_СвТопл, "КолТопл", ГСМ.КоличествоТоплива, Истина);
	XDTO_Установить(XDTO_СвТопл, "ЧасРабОтоп", ГСМ.КоличествоЧасовРаботыСВключеннымОтопителем);
	XDTO_Установить(XDTO_СвТопл, "ЧасРабСпецОб", ГСМ.КоличествоЧасовРаботыОборудования);
	
	Возврат XDTO_СвТопл;
	
КонецФункции

Функция XDTO_ПЛ_СодИнфВыезд(НомерТитула, Формат = Неопределено, ДокТитул4) Экспорт

	ТипДокументооборота = "__PL";
	ОдометрРаботник = 	ДокТитул4.ОдометрРаботник;
	
	XDTO_СодИнфВыезд = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфВыезд", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СодИнфВыезд, "УИД_ПЛ", 		ДокТитул4.УИД_ПЛ);
	XDTO_Установить(XDTO_СодИнфВыезд, "ПризнНачРейс", 		?(ДокТитул4.ЭтоСменаВодителя, "2", "1"));
	
	// показания одометра
	Если ДокТитул4.ЭтоСменаВодителя Тогда 
		
		XDTO_СвОдомПриемТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфВыезд.СвОдомПриемТС", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвОдомПриемТС, "ДатВрПриемТС", 		XDTO_ДатаВремяВЗТип(ДокТитул4.ДатВрОдометр));
		XDTO_Установить(XDTO_СвОдомПриемТС, "НалКоорТочВрПриемТС", "1");
		XDTO_Установить(XDTO_СвОдомПриемТС, "ОдомПриемТС", 		ДокТитул4.ПоказанияОдометра);
		XDTO_Установить(XDTO_СодИнфВыезд, "СвОдомПриемТС", 		XDTO_СвОдомПриемТС);
		
	Иначе
		
		XDTO_СвОдомВыезд = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфВыезд.СвОдомВыезд", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвОдомВыезд, "ДатВрВыезд", 		XDTO_ДатаВремяВЗТип(ДокТитул4.ДатВрОдометр));
		XDTO_Установить(XDTO_СвОдомВыезд, "НалКоорТочВрВыезд", 	"1");
		XDTO_Установить(XDTO_СвОдомВыезд, "ОдомВыезд", 			ДокТитул4.ПоказанияОдометра);
		XDTO_Установить(XDTO_СодИнфВыезд, "СвОдомВыезд", 		XDTO_СвОдомВыезд);
		
	КонецЕсли;
	
	//СвУплЛиц
	XDTO_СвОтвЛиц = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфВыезд.СвУплЛиц", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СвОтвЛиц, "Должн", ДокТитул4.Должность);
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ОдометрРаботник.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		ОдометрРаботник.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	ОдометрРаботник.Отчество);
	XDTO_Установить(XDTO_СвОтвЛиц, "ФИО", XDTO_ФИО);
	
	XDTO_Установить(XDTO_СодИнфВыезд, "СвУплЛиц", XDTO_СвОтвЛиц);
	
	Возврат XDTO_СодИнфВыезд;
	
КонецФункции

Функция XDTO_ПЛ_СодИнфЗаезд(НомерТитула, Формат = Неопределено, ДокТитул5) Экспорт

