		XDTO_Установить(XDTO_СвОгЗамФщ, "ИзмДатВрВыпПрвз", 	XDTO_ДатаВремяВЗТип(ДокТитул4.ИзмДатВрВыпПрвз));
		XDTO_Установить(XDTO_СвОгЗамФщ, "НалКоорТочВрВыпПрвз", 	"1");
		XDTO_Установить(XDTO_СвОгЗамФщ, "ИзмСрокВыпПрвз", 	ДокТитул4.ИзмСрокВыпПрвз);
		XDTO_Установить(XDTO_СвОгЗамФщ, "ИзмМршВыпПрвз", 	ДокТитул4.ИзмМршВыпПрвз);
		
		XDTO_Установить(XDTO_СодЗНИнфФщ, "СвОгЗамФщ", 	XDTO_СвОгЗамФщ);
		
	КонецЕсли;
	
	Если ДокТитул4.ОтметкиФрахтовщика.Количество() > 0 Тогда 
