Функция XDTO_СодИнфПрвПрием(НомерТитула, Формат = Неопределено, ДокТитул2) Экспорт
	
	НомерТитула = 2;
	
	XDTO_СодИнфПрвПрием = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрвПрием");
	XDTO_Установить(XDTO_СодИнфПрвПрием, "УИД_ТрН", 	ДокТитул2.ДокументЭТРН.УИД);
	
	XDTO_Установить(XDTO_СодИнфПрвПрием, "СодОпер", 	"Груз принят к перевозке водителем, уполномоченным перевозчиком на перевозку груза, от лица, осуществившего погрузку груза в транспортное средство");
	
	//ЗамПрвПрием
	Если ДокТитул2.ЕстьЗамечанияПеревозчика 
		Или ДокТитул2.ЗамечанияИнфПол.Количество() > 0 Тогда
		
		XDTO_ЗамПрвПрием = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрвПрием.ЗамПрвПрием");
		
		Если ДокТитул2.ЕстьЗамечанияПеревозчика Тогда
			Если ЗначениеЗаполнено(ДокТитул2.ЗамДатВрПриб) Тогда 
				XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамДатВрПриб", 	XDTO_ДатаВремяВЗТип(ДокТитул2.ЗамДатВрПриб));
				XDTO_Установить(XDTO_ЗамПрвПрием, "НалКоорТочВрПрб", "1");
			КонецЕсли;
			Если ЗначениеЗаполнено(ДокТитул2.ЗамДатВрУбыт) Тогда 
				XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамДатВрУбыт", 	XDTO_ДатаВремяВЗТип(ДокТитул2.ЗамДатВрУбыт));
				XDTO_Установить(XDTO_ЗамПрвПрием, "НалКоорТочВрУб", "1");
			КонецЕсли;
			Если ЗначениеЗаполнено(ДокТитул2.ЗамДатВрПосПрием) Тогда 
				XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамДатВрПосПрием",XDTO_ДатаВремяВЗТип(ДокТитул2.ЗамДатВрПосПрием));
				XDTO_Установить(XDTO_ЗамПрвПрием, "НалКоорТочВрПрм", "1");
			КонецЕсли;
			XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамСостГруз", 	ДокТитул2.ЗамСостГруз);
			XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамМасс", 		ДокТитул2.ЗамМасс);
			XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамКолМест", 	ДокТитул2.ЗамКолМест);
			XDTO_Установить(XDTO_ЗамПрвПрием, "ЗамПогрРаб", 	ДокТитул2.ЗамПогрРаб);
		КонецЕсли;
		
		// ИнфПол Замечаний	
		Если ДокТитул2.ЗамечанияИнфПол.Количество() > 0 Тогда
			Для Каждого СтрокаИнфПол Из ДокТитул2.ЗамечанияИнфПол Цикл
				
				XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфПрвПрием.ЗамПрвПрием");
				XDTO_ЗамПрвПрием.ИнфПол.Добавить(XDTO_ИнфПол)
				
			КонецЦикла;
		КонецЕсли;
		
		XDTO_Установить(XDTO_СодИнфПрвПрием, "ЗамПрвПрием", 	XDTO_ЗамПрвПрием);
		
	КонецЕсли;
	
	//ОтметПрвПрием	
	Если ДокТитул2.ЕстьОтметкиПеревозчика И ДокТитул2.ОтметкиПеревозчика.Количество() > 0 Тогда 
		Для Каждого СтрокаОтметПВ Из ДокТитул2.ОтметкиПеревозчика Цикл
				
			XDTO_ОтметПВ = XDTO_Отмет(НомерТитула, Формат, ДокТитул2, СтрокаОтметПВ, "СодИнфПрвПрием.ОтметПрвПрием");
			
			// ИнфПол блока ОтметПрвПрием
			Если ДокТитул2.ОтметкиИнфПол.Количество() > 0 Тогда
				
				ПоискИнфПол = Новый Структура("ИдентификаторСтрокиОтметки", СтрокаОтметПВ.ИдентификаторСтроки);
				СтрокиИнфПолЭтойОтметки = ДокТитул2.ОтметкиИнфПол.НайтиСтроки(ПоискИнфПол);
				
				Для Каждого СтрокаИнфПол Из СтрокиИнфПолЭтойОтметки Цикл
					
					XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфПрвПрием.ОтметПрвПрием");
					XDTO_ОтметПВ.ИнфПол.Добавить(XDTO_ИнфПол)
					
				КонецЦикла;
			КонецЕсли;
			
			XDTO_СодИнфПрвПрием.ОтметПрвПрием.Добавить(XDTO_ОтметПВ)
			
		КонецЦикла;
	КонецЕсли;
	
	// ИнфПол Общие	
	Если ДокТитул2.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул2.ИнфПол Цикл
				
				XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфПрвПрием");
				XDTO_СодИнфПрвПрием.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфПрвПрием;
	
КонецФункции

