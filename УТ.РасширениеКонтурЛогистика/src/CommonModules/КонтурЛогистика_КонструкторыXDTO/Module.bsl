	Если ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда
		
		XDTO_СвЮЛУч = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвЮЛУч", ТипДокументооборота, Формат);
		XDTO_СвЮЛУч.НаимОрг = ОрганизацияДиадок.ИНН;
		XDTO_Установить(XDTO_СвЮЛУч, "НаимОрг", 	ОрганизацияДиадок.НаименованиеОрганизацииПолное);
		XDTO_Установить(XDTO_СвЮЛУч, "ИННЮЛ", 		ОрганизацияДиадок.ИНН);
		XDTO_Установить(XDTO_СвЮЛУч, "КПП", 		ОрганизацияДиадок.КПП);
		XDTO_Установить(XDTO_СвЮЛУч, "ОГРН", 		ОрганизацияДиадок.ОГРН);
		XDTO_Установить(XDTO_ИдСв,	 "СвЮЛУч", XDTO_СвЮЛУч);
		
	ИначеЕсли ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП И Формат = "5.01" Тогда
		
		XDTO_СвИП = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвИП", ТипДокументооборота, Формат);
		
		XDTO_Установить(XDTO_СвИП, "ИНН", 		ОрганизацияДиадок.ИНН);
		XDTO_Установить(XDTO_СвИП, "ОГРНИП", 		ОрганизацияДиадок.ОГРН);
		XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ОрганизацияДиадок.Фамилия);
		XDTO_Установить(XDTO_ФИО,	 "Имя",			ОрганизацияДиадок.Имя);
		XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ОрганизацияДиадок.Отчество);
		XDTO_Установить(XDTO_СвИП, 	 "ФИО", 		XDTO_ФИО);
		
		XDTO_Установить(XDTO_ИдСв,	 "СвИП", 		XDTO_СвИП);
		
	ИначеЕсли ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП И Формат = "5.02" Тогда
		
		XDTO_СвИП = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвИП", ТипДокументооборота, Формат);
		
		XDTO_Установить(XDTO_СвИП, "ИННИП", 		ОрганизацияДиадок.ИНН);
		XDTO_Установить(XDTO_СвИП, "ОГРНИП", 		ОрганизацияДиадок.ОГРН);
		XDTO_Установить(XDTO_СвИП, "СвГосРегИП", 	ОрганизацияДиадок.СвидельствоГосРегистрацииИП);
		XDTO_Установить(XDTO_СвИП, "ДатаОГРНИП", 	XDTO_ДатаТип(ОрганизацияДиадок.ДатаПрисвоенияОГРНИП));
		
		XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ОрганизацияДиадок.Фамилия);
		XDTO_Установить(XDTO_ФИО,	 "Имя",			ОрганизацияДиадок.Имя);
		XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ОрганизацияДиадок.Отчество);
		XDTO_Установить(XDTO_СвИП, 	 "ФИО", 		XDTO_ФИО);
		
		XDTO_Установить(XDTO_ИдСв,	 "СвИП", 		XDTO_СвИП);
		
	ИначеЕсли ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо И Формат = "5.02" Тогда
		
		XDTO_СвФЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвФЛ", ТипДокументооборота, Формат);
		
		XDTO_Установить(XDTO_СвФЛ, "ИННФЛ", 		ОрганизацияДиадок.ИНН);
		XDTO_Установить(XDTO_СвФЛ, "ИныеСвед", 		ОрганизацияДиадок.ИныеСведенияИдентифицирующиеФЛ);
		
		XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ОрганизацияДиадок.Фамилия);
		XDTO_Установить(XDTO_ФИО,	 "Имя",			ОрганизацияДиадок.Имя);
		XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ОрганизацияДиадок.Отчество);
		XDTO_Установить(XDTO_СвФЛ, 	 "ФИО", 		XDTO_ФИО);
		
		XDTO_Установить(XDTO_ИдСв,	 "СвФЛ", 		XDTO_СвФЛ);
		
	Иначе
		
		ВызватьИсключение "У организации Диадок: " + ОрганизацияДиадок + " не указан тип ЮрЛица или такой тип не поддерживается";
		
	КонецЕсли;

КонецПроцедуры

Функция XDTO_СвИнНеУчТрН(Знач НомерТитула, Знач Формат, Знач ОрганизацияДиадок, Знач ТипДокументооборота = "__etrnTitle")
	
	Перем XDTO_СвИнНеУч;
	
		Если ТипДокументооборота = "__ZZ" Тогда 
			ИмяСвойства = "СвИнНеУчТип";
		Иначе
			ИмяСвойства = "СвИнНеУчТрНТип";
		КонецЕсли;
	
	XDTO_СвИнНеУч = НовыйБазовыйОбъектXDTO(НомерТитула, ИмяСвойства, ТипДокументооборота, Формат);
	Если ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо Тогда
		
		Если ТипДокументооборота = "__ZZ" Тогда 
			ИдСтат = "ИО";
		Иначе
			ИдСтат = "ЮЛ";
		КонецЕсли;
		XDTO_Установить(XDTO_СвИнНеУч,	 "ИдСтат",			ИдСтат);
		
	Иначе
		
		Если ТипДокументооборота = "__ZZ" Тогда 
			ИдСтат = "ИГ";
		Иначе
			ИдСтат = "ФЛ";
		КонецЕсли;
		
		XDTO_Установить(XDTO_СвИнНеУч,	 "ИдСтат",			ИдСтат);
		
	КонецЕсли;
	
	XDTO_Установить(XDTO_СвИнНеУч,	 "Стран",			ОрганизацияДиадок.ИнАдресCountry);
	XDTO_Установить(XDTO_СвИнНеУч,	 "Наим",			ОрганизацияДиадок.НаименованиеОрганизацииПолное);
	
	XDTO_Установить(XDTO_СвИнНеУч,	 "Идентиф",			ОрганизацияДиадок.ИнИдентиф);
	
	Возврат XDTO_СвИнНеУч;

КонецФункции

Процедура XDTO_Контакт_ЗаполнитьИзОрганизацииДиадок(Знач XDTO_Контакт, Знач НомерТитула, Знач Формат, Знач ОрганизацияДиадок, Знач ТипДокументооборота = "__etrnTitle")
	
	Перем ИноеСведение, ИныеСведения, Почты, Телефон, Телефоны, ЭлПочта;
	
	// Основной Телефон
	Если ЗначениеЗаполнено(ОрганизацияДиадок.ТелефонОсновной) Тогда
		XDTO_Контакт.Тлф.Добавить(ОрганизацияДиадок.ТелефонОсновной);
	КонецЕсли;
	
	Телефоны = ОрганизацияДиадок.КонтактнаяИнформация.НайтиСтроки(Новый Структура("ВидКонтактнойИнформации", Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации.Телефон));
	Для Каждого Телефон Из Телефоны Цикл
		Если Телефон.Значение <> ОрганизацияДиадок.ТелефонОсновной Тогда 
			XDTO_Контакт.Тлф.Добавить(Телефон.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Почты = ОрганизацияДиадок.КонтактнаяИнформация.НайтиСтроки(Новый Структура("ВидКонтактнойИнформации", Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации.ЭлектроннаяПочта));
	Для Каждого ЭлПочта Из Почты Цикл
		XDTO_Контакт.ЭлПочта.Добавить(ЭлПочта.Значение);	
	КонецЦикла;
	
	ИныеСведения = ОрганизацияДиадок.КонтактнаяИнформация.НайтиСтроки(Новый Структура("ВидКонтактнойИнформации", Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации.Иной));
	Для Каждого ИноеСведение Из ИныеСведения Цикл
		XDTO_Установить(XDTO_Контакт, "ИнКонт", ИноеСведение.Значение);
		Прервать; // не множественное
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти ЗаполненияГотовыхXDTO


// #Область КонвертацияИзXDTOвЛогистическиеСущности

// также умеет конвертировать ИдСвТип в ОрганизациюДиадок
Функция Конвертировать_РекИдентГО_вОрганизациюДиадок(XDTO_УчастникТрНТип, ИдентификаторУчастникаЭДО = Неопределено, ИскатьОрганизациюПоИДЭДО = Ложь) Экспорт
	
	ОрганизацияДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
	Если XDTO_УчастникТрНТип <> Неопределено Тогда 

		ИдСв = XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникТрНТип, "ИдСв");
			
		Если ИдСв <> Неопределено Тогда 
			
			СвЮЛУч = XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвЮЛУч");
			СвИП = XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвИП");
			СвФЛУчаст = XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвФЛУчаст");
			СвИнНеУч = XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвИнНеУч");
			СвФЛ = XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвФЛ");
			
			Если СвЮЛУч <> Неопределено Тогда 
				
				ОрганизацияДиадок = Конвертировать_СвЮЛУч_вОрганизациюДиадок(СвЮЛУч, ИдентификаторУчастникаЭДО, ИскатьОрганизациюПоИДЭДО);
				
			ИначеЕсли СвИП <> Неопределено Тогда 
				
				ОрганизацияДиадок = Конвертировать_СвИП_вОрганизациюДиадок(СвИП, ИдентификаторУчастникаЭДО, ИскатьОрганизациюПоИДЭДО);
				
			ИначеЕсли СвФЛУчаст <> Неопределено Тогда 
				
				ОрганизацияДиадок = Конвертировать_СвФЛУчаст_вОрганизациюДиадок(СвФЛУчаст, ИдентификаторУчастникаЭДО, ИскатьОрганизациюПоИДЭДО);
				
			ИначеЕсли СвИнНеУч <> Неопределено Тогда 
				
				ОрганизацияДиадок = Конвертировать_СвИнНеУч_вОрганизациюДиадок(СвИнНеУч, ИдентификаторУчастникаЭДО);
				
			ИначеЕсли СвФЛ <> Неопределено Тогда 
				
				ОрганизацияДиадок = Конвертировать_СвФЛУчаст_вОрганизациюДиадок(СвФЛ, ИдентификаторУчастникаЭДО, ИскатьОрганизациюПоИДЭДО);
				
			КонецЕсли;
			
			// Проверим телефоны и адреса, если не заполнены, проставим
			ПроверитьТелефон(XDTO_УчастникТрНТип, ОрганизацияДиадок);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

Функция Конвертировать_УчастникЗН_вОрганизациюДиадок(XDTO_УчастникЗНТип) Экспорт
	
	ОрганизацияДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
	Если XDTO_УчастникЗНТип <> Неопределено Тогда 
		
		УчастникЗНЮЛ = XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникЗНТип, "ФтЮЛ");
		УчастникЗНФЛ = XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникЗНТип, "ФтФЛ");

		Если УчастникЗНЮЛ <> Неопределено Тогда 
			
			ОрганизацияДиадок = Конвертировать_СвЮЛУч_вОрганизациюДиадок(УчастникЗНЮЛ);
				
			// Проверим телефоны и адреса, если не заполнены, проставим
			ПроверитьТелефон(XDTO_УчастникЗНТип, ОрганизацияДиадок);
			
		ИначеЕсли УчастникЗНФЛ <> Неопределено Тогда
			
			ОрганизацияДиадок = Конвертировать_СвФЛУчаст_вОрганизациюДиадок(УчастникЗНФЛ);
				
			// Проверим телефоны и адреса, если не заполнены, проставим
			ПроверитьТелефон(XDTO_УчастникЗНТип, ОрганизацияДиадок);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

Функция Конвертировать_УчастникСВ_вОрганизациюДиадок(XDTO_УчастникСВТип, Сторона = "ГО") Экспорт
	
	ОрганизацияДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
	Если XDTO_УчастникСВТип <> Неопределено Тогда 
		
		УчастникСВЮЛ = XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникСВТип, Сторона + "ЮЛ");
		УчастникСВФЛ = XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникСВТип, Сторона + "ФЛ");
		УчастникСВИП = XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникСВТип, Сторона + "ИП");

		Если УчастникСВЮЛ <> Неопределено Тогда 
			
			ОрганизацияДиадок = Конвертировать_СвЮЛУч_вОрганизациюДиадок(УчастникСВЮЛ);
				
			// Проверим телефоны и адреса, если не заполнены, проставим
			ПроверитьТелефон(УчастникСВЮЛ, ОрганизацияДиадок);
			
		ИначеЕсли УчастникСВФЛ <> Неопределено Тогда
			
			ОрганизацияДиадок = Конвертировать_СвФЛУчаст_вОрганизациюДиадок(УчастникСВФЛ);
				
			// Проверим телефоны и адреса, если не заполнены, проставим
			ПроверитьТелефон(УчастникСВФЛ, ОрганизацияДиадок);
			
		ИначеЕсли УчастникСВИП <> Неопределено Тогда
			
			ОрганизацияДиадок = Конвертировать_СвИП_вОрганизациюДиадок(УчастникСВИП);
				
			// Проверим телефоны и адреса, если не заполнены, проставим
			ПроверитьТелефон(УчастникСВИП, ОрганизацияДиадок);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

Процедура ПроверитьТелефон(Знач XDTO_УчастникТрНТип, Знач ОрганизацияДиадок)
	
	Перем Массив_XDTO_СписокТелефонов, НоваяСтрокаТелефона, ОргОбъект, текТелефон;
	
	Если Не ЗначениеЗаполнено(ОрганизацияДиадок.ТелефонОсновной) Тогда 
		
		Массив_XDTO_СписокТелефонов = XDTO_ВычислитьМассивXDTO(XDTO_Вычислить(XDTO_УчастникТрНТип, "Контакт.Тлф"));
		Если Массив_XDTO_СписокТелефонов.Количество() > 0 Тогда
			
			ОргОбъект = ОрганизацияДиадок.ПолучитьОбъект();
			
			Для Каждого текТелефон Из Массив_XDTO_СписокТелефонов Цикл  
				Если текТелефон = Массив_XDTO_СписокТелефонов[0] Тогда 
					ОргОбъект.ТелефонОсновной = текТелефон;
				Иначе
					
					НоваяСтрокаТелефона = ОргОбъект.КонтактнаяИнформация.Добавить();
					НоваяСтрокаТелефона.ВидКонтактнойИнформации = Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации.Телефон;
					НоваяСтрокаТелефона.Значение = текТелефон;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ОргОбъект.Записать();
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция Конвертировать_СвИП_вОрганизациюДиадок(Знач СвИП, ИдентификаторУчастникаЭДО = "", ИскатьОрганизациюПоИДЭДО = Ложь)
	
	ОрганизацияДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
	ИННФЛ = XDTO_ПолучитьЗначениеСвойства(СвИП, "ИННФЛ");
	ОГРН = XDTO_ПолучитьЗначениеСвойства(СвИП, "ОГРНИП");
	
	Если ИскатьОрганизациюПоИДЭДО Тогда
		НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(
			ИННФЛ, Неопределено, ОГРН, ИдентификаторУчастникаЭДО);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
		НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(
			ИННФЛ, Неопределено, ОГРН);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденнаяОрганизация) Тогда 
		
		НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
		НоваяОрганизация.ИНН = СокрЛП(ИННФЛ);
		НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо;
		НоваяОрганизация.ОГРН = XDTO_ПолучитьЗначениеСвойства(СвИП, "ОГРНИП");
		XDTO_ФИО = XDTO_ПолучитьЗначениеСвойства(СвИП, "ФИО");
		НоваяОрганизация.Фамилия = XDTO_ПолучитьЗначениеСвойства(XDTO_ФИО, "Фамилия");
		НоваяОрганизация.Имя = XDTO_ПолучитьЗначениеСвойства(XDTO_ФИО, "Имя");
		НоваяОрганизация.Отчество = XDTO_ПолучитьЗначениеСвойства(XDTO_ФИО, "Отчество");
		НоваяОрганизация.Наименование = СокрЛП(НоваяОрганизация.Фамилия + " " + НоваяОрганизация.Имя + " " + НоваяОрганизация.Отчество);
		НоваяОрганизация.НаименованиеОрганизацииПолное = НоваяОрганизация.Наименование;
		Если ЗначениеЗаполнено(ИдентификаторУчастникаЭДО) Тогда
			НоваяОрганизация.ИдентификаторУчастникаЭДО = ИдентификаторУчастникаЭДО;
		Иначе
			НоваяОрганизация.ДополнительныеСвойства.Вставить("ПолучитьИдентификаторУчастникаЭДОИзДиадок");
		КонецЕсли;
		
		НоваяОрганизация.ДополнительныеСвойства.Вставить("СинхронизироватьИзСервисаЛогистика");
		
		НоваяОрганизация.СвидельствоГосРегистрацииИП = XDTO_ПолучитьЗначениеСвойства(СвИП, "СвГосРегИП");
		НоваяОрганизация.ДатаПрисвоенияОГРНИП = XDTO_ПолучитьЗначениеСвойства(СвИП, "ДатаОГРНИП");
		НоваяОрганизация.ИныеСведенияИдентифицирующиеФЛ = XDTO_ПолучитьЗначениеСвойства(СвИП, "ИныеСвед");
		
		НоваяОрганизация.Записать();
		ОрганизацияДиадок = НоваяОрганизация.Ссылка;
		
	Иначе
		
		ОрганизацияДиадок = НайденнаяОрганизация;
		
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

