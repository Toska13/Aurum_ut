Функция XDTO_СвГруз(НомерТитула, Формат = "5.01", ДокТитул1, ТипДокументооборота = "__etrnTitle")
	
	Если ТипДокументооборота = "__etrnTitle" Тогда 
		КорневойТег = "СодИнфГО";
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		КорневойТег = "СодЗНИнфФт";
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		КорневойТег = "СодСВИнфПрв";
	ИначеЕсли ТипДокументооборота = "__ForwardingReceipt" Тогда
		КорневойТег = "СодЭР";
	КонецЕсли;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".СвГруз", ТипДокументооборота, Формат);
	
	// Объявленная ценность
	ИтогОбъявленнаяЦенность = ДокТитул1.Товары.Итог("ОбъявленнаяЦенность");
	ИтогОбъявленнаяЦенностьВалюта = Неопределено;	
	
	Если ИтогОбъявленнаяЦенность > 0 Тогда
		
		Для Каждого СтрокаТовара Из ДокТитул1.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТовара.ОбъявленнаяЦенностьВалюта) Тогда 
				ИтогОбъявленнаяЦенностьВалюта = СтрокаТовара.ОбъявленнаяЦенностьВалюта;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ИтогОбъявленнаяЦенностьВалюта <> Неопределено Тогда 
						
			XDTO_ЦеннГрузТип = XDTO_ЦеннГрузТип(НомерТитула,
											ИтогОбъявленнаяЦенность,
											ИтогОбъявленнаяЦенностьВалюта.Код,
											ИтогОбъявленнаяЦенностьВалюта.НаименованиеПолное,
											ТипДокументооборота,
											Формат);
		
			Если ТипДокументооборота = "__SoprVed" Тогда
				XDTO_Установить(XDTO_Объект, "ОбщСтоимГруз", 	XDTO_ЦеннГрузТип);
			Иначе
				XDTO_Установить(XDTO_Объект, "ОбЦеннГр", 	XDTO_ЦеннГрузТип);
			КонецЕсли;
		
		КонецЕсли;
						
	КонецЕсли;
	
	// Описание груза
	Для Каждого СтрокаДокумента Из ДокТитул1.Товары Цикл
		
		Если СтрокаДокумента.Учитывать = Истина Тогда 
			
			XDTO_ОпГруз = XDTO_ОпГруз(НомерТитула, Формат, ДокТитул1, СтрокаДокумента, ТипДокументооборота);
			XDTO_Объект.ОпГруз.Добавить(XDTO_ОпГруз)
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СВ_СвКонтейн(НомерТитула, Формат = "5.01", ДокТитул, СтрокаКонтейнера)
	
	ТипДокументооборота = "__SoprVed";
	Если НомерТитула = 1 Тогда 
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвКонтейн", ТипДокументооборота);
	ИначеЕсли НомерТитула = 2 Тогда 
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфГО.СвКонтейн", ТипДокументооборота);
	ИначеЕсли НомерТитула = 3 Тогда 
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфГП.СвКонтейн", ТипДокументооборота);
	Иначе
		ВызватьИсключение "Непредполагаемый НомерТитула: " + НомерТитула;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаКонтейнера.ДатВрСдПгр) Тогда
		Если НомерТитула = 1 Тогда 
			XDTO_Установить(XDTO_Объект,	 "ДатВрСдПгр", 	XDTO_ДатаВремяВЗТип(СтрокаКонтейнера.ДатВрСдПгр));
			XDTO_Установить(XDTO_Объект,	 "НалКоорТочВрСдПгр", 	"1");
		ИначеЕсли НомерТитула = 2 Тогда 
			XDTO_Установить(XDTO_Объект,	 "ДатВрСдГрКонт", 	XDTO_ДатаВремяВЗТип(СтрокаКонтейнера.ДатВрСдПгр));
			XDTO_Установить(XDTO_Объект,	 "НалКоорТочВрСдГрКонт", 	"1");
		ИначеЕсли НомерТитула = 3 Тогда 
			XDTO_Установить(XDTO_Объект,	 "ДатВрПодВыгр", 	XDTO_ДатаВремяВЗТип(СтрокаКонтейнера.ДатВрСдПгр));
			XDTO_Установить(XDTO_Объект,	 "НалКоорТочВрПодВыгр", 	"1");
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаКонтейнера.ДатВрВозврКонт) Тогда 
		XDTO_Установить(XDTO_Объект,	 "ДатВрВозврКонт", 	XDTO_ДатаВремяВЗТип(СтрокаКонтейнера.ДатВрВозврКонт));
		XDTO_Установить(XDTO_Объект,	 "НалКоорТочВрВозврКонт", 	"1");
	КонецЕсли;

	Если НомерТитула = 1 Тогда // это ошибка формата, что запрещено ГО и ГП указывать сами контейнеры в этой ТЧ?
		
		// как идентифицировать к каким конкретно контейнерам относятся указатели времени если если это не ошибка?
		
		XDTO_Установить(XDTO_Объект,	 "КодРазТипКонт", 	СтрокаКонтейнера.КодРазТипКонт);
		
		КодСтраны = "643";
		Если ЗначениеЗаполнено(СтрокаКонтейнера.КонтКодСтр) Тогда 
			КодСтраны = СтрокаКонтейнера.КонтКодСтр.Код;
		КонецЕсли;
		XDTO_Установить(XDTO_Объект,	 "КонтКодСтр", 	КодСтраны);
		
		XDTO_Установить(XDTO_Объект,	 "ГрузПодКонт", СтрокаКонтейнера.ГрузПодКонт);
		XDTO_Установить(XDTO_Объект,	 "МассаКонт", 	СтрокаКонтейнера.МассаКонт);
		XDTO_Установить(XDTO_Объект,	 "ПрТаблПломб", ?(СтрокаКонтейнера.ПрТаблПломб = Истина, "1", "0"));
		XDTO_Объект.НомКонтейн.Добавить(СтрокаКонтейнера.НомКонтейн);
		
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_Отмет(НомерТитула, Формат = Неопределено, ДокТитулС1По4, СтрокаОтметки, ИмяЭлементаВxml, ТипДокументооборота = "__etrnTitle")
	
	// у Т7 нет актов
	ЭтоТитулСАктами			 	 = ТипЗнч(ДокТитулС1По4) <> Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7"); 
	
	// у т2 и т4 нет актов взвешивания 
	ЭтоТитулСАктамиВзвешивания    = ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") 
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул3")
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул4");
								
	ЭтоТитулСоШтрафами	 		  = ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") 
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул3")
								ИЛИ ТипЗнч(ДокТитулС1По4) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул4");
								
							
								
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ИмяЭлементаВxml, ТипДокументооборота);
	
	XDTO_Установить(XDTO_Объект, "ДатВрОтмет", XDTO_ДатаВремяВЗТип(СтрокаОтметки.ДатаИВремяОтметки));
	XDTO_Установить(XDTO_Объект, "ОбстОтмет", СтрокаОтметки.ОписаниеОбстоятельств);
	
	Если ТипДокументооборота = "__etrnTitle" Тогда 
		XDTO_Установить(XDTO_Объект, "НалКоорТочВрОтм", "1");
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		XDTO_Установить(XDTO_Объект, "НалКоорТочВрОтмет", "1");
	Иначе
		ВызватьИсключение "Неподдерживаемый тип документооборота";
	КонецЕсли;
	
	// Акты
	Если ЭтоТитулСАктами Тогда 	
		ПоискАктов = Новый Структура("ИдентификаторСтрокиОтметки", СтрокаОтметки.ИдентификаторСтроки);
		Если ЭтоТитулСАктамиВзвешивания Тогда 
			ПоискАктов.Вставить("АктЭтоАктВзвешивания", Ложь);
		КонецЕсли;
		НайденныеАкты = ДокТитулС1По4.Акты.НайтиСтроки(ПоискАктов);
		
		Если ТипДокументооборота = "__etrnTitle" Тогда 
			ГлавныйДокумент = ДокТитулС1По4.ДокументЭТРН;
		ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
			ГлавныйДокумент = ДокТитулС1По4.ДокументЗН;
		Иначе
			ВызватьИсключение "Неподдерживаемый тип документооборота";
		КонецЕсли;
		
		Для Каждого СтрокаАкта Из НайденныеАкты Цикл 
			
			XDTO_Акт = XDTO_АктПоСтрокеАкта(ГлавныйДокумент, НомерТитула, СтрокаАкта, ТипДокументооборота);
			XDTO_Объект.СвАкт.Добавить(XDTO_Акт)
			
		КонецЦикла;
		
		Если ЭтоТитулСАктамиВзвешивания Тогда
			
			ПоискАктовВзвешивания = Новый Структура("ИдентификаторСтрокиОтметки, АктЭтоАктВзвешивания", СтрокаОтметки.ИдентификаторСтроки, Истина);
			НайденныеАктыВзвешивания = ДокТитулС1По4.Акты.НайтиСтроки(ПоискАктовВзвешивания);
			
			Для Каждого СтрокаАкта Из НайденныеАктыВзвешивания Цикл 
				
				XDTO_АктВзвеш = XDTO_АктПоСтрокеАкта(ГлавныйДокумент, НомерТитула, СтрокаАкта, ТипДокументооборота);
				XDTO_Объект.СвАктВзв.Добавить(XDTO_АктВзвеш);
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	// Штрафы
	Если ЭтоТитулСоШтрафами Тогда 
		ПоискШтрафов = Новый Структура("ИдентификаторСтрокиОтметки", СтрокаОтметки.ИдентификаторСтроки);
		НайденныеШтрафы = ДокТитулС1По4.Штрафы.НайтиСтроки(ПоискШтрафов);
		
		Для Каждого СтрокаШтрафа Из НайденныеШтрафы Цикл 
			
			XDTO_РазмШтр = XDTO_ШтрафПоСтрокеШтрафа(ИмяЭлементаВxml, НомерТитула, СтрокаШтрафа, ТипДокументооборота);
			XDTO_Объект.РазмШтр.Добавить(XDTO_РазмШтр);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ШтрафПоСтрокеШтрафа(Знач ВложенностьОбъекта, Знач НомерТитула, Знач СтрокаШтрафа, ТипДокументооборота = "__etrnTitle")
	
	XDTO_Штраф = НовыйДочернийОбъектXDTO(НомерТитула, ВложенностьОбъекта + ".РазмШтр", ТипДокументооборота);
	XDTO_Установить(XDTO_Штраф, "ФактКолЕдИзм"	, СтрокаШтрафа.ФактКолЕдИзм);
	XDTO_Установить(XDTO_Штраф, "ИтогРазмШтрРФ"	, СтрокаШтрафа.ИтогРазмШтрРФ);
	XDTO_Установить(XDTO_Штраф, "РасчШтр"		, СтрокаШтрафа.РасчШтр);
	
	Возврат XDTO_Штраф;

КонецФункции

Функция XDTO_АктПоСтрокеАкта(Знач ГлавныйДокумент, Знач НомерТитула, Знач СтрокаАкта, ТипДокументооборота = "__etrnTitle")
	
	XDTO_Акт = XDTO_РеквДокТип(НомерТитула,
					СтрокаАкта.АктНаименование,
					СтрокаАкта.АктНомер,
					СтрокаАкта.АктДата,
					СтрокаАкта.АктИдДок,
					СтрокаАкта.АктДопСведДок,
					Массив_XDTO_СоставителиДокумента(
						НомерТитула,
						ГлавныйДокумент,
						СтрокаАкта.СтороныСоставители,
						СтрокаАкта.ДополнительныйСоставитель,
						ТипДокументооборота),
					ТипДокументооборота);
					
	Возврат XDTO_Акт;

КонецФункции

Функция Массив_XDTO_СоставителиДокумента(НомерТитула, ГлавныйДокумент, СтороныСоставители, ДополнительныйСоставитель = Неопределено, ТипДокументооборота = "__etrnTitle") Экспорт 
	
	Массив_XDTO_ИдРекСост = Новый Массив;
	
	// СтороныСоставители
	
	МассивСторон = Перечисления.КонтурЛогистика_СтороныСоставители.МассивСоставителейЭТРН(ГлавныйДокумент, СтороныСоставители);
	Для Каждого СторонаОрганизация Из МассивСторон Цикл 
		
		XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, СторонаОрганизация, ТипДокументооборота);
		Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
		
	КонецЦикла;
	
	// ДополнительныйСоставитель
	Если ЗначениеЗаполнено(ДополнительныйСоставитель) Тогда
		
		XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, ДополнительныйСоставитель, ТипДокументооборота);
		Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
		
	КонецЕсли;
	
	Возврат Массив_XDTO_ИдРекСост;
	
КонецФункции

Функция XDTO_УказГО(НомерТитула, Формат = Неопределено, ДокТитул1)
	
	ДокументЭТРН = ДокТитул1.ДокументЭТРН;
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.УказГО");
	
	 
	XDTO_Установить(XDTO_Объект, "УкНормПрвз", ?(ЗначениеЗаполнено(ДокТитул1.УказанияВОтношенииНормПеревозки),ДокТитул1.УказанияВОтношенииНормПеревозки,"Отсутствуют"));
	XDTO_Установить(XDTO_Объект, "ЗапрПерегруз", ?(ДокТитул1.ПерегрузкаЗапрещена, "1", "0"));
	
	Если ЗначениеЗаполнено(ДокТитул1.СведенияОПломбах) Тогда 
		XDTO_Установить(XDTO_Объект, "СвПломба", ДокТитул1.СведенияОПломбах);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЭТРН.СрокДоставки) Тогда 
		XDTO_Установить(XDTO_Объект, "СрокДостГр", ДокументЭТРН.СрокДоставки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЭТРН.ДатаВремяДоставки) Тогда 
		XDTO_Установить(XDTO_Объект, "ДатВрДостГр", XDTO_ДатаВремяВЗТип(ДокументЭТРН.ДатаВремяДоставки));
		XDTO_Установить(XDTO_Объект, "НалКоорТочВрДост", "1");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитул1.ОграничениеСкорости) Тогда 
		XDTO_Установить(XDTO_Объект, "ОгрСкор", ДокТитул1.ОграничениеСкорости);
	КонецЕсли;
	
	// переадресация
	XDTO_СвПА = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.УказГО.СвПА");
	ЛицоПА = "Грузоотправитель";
	Если ДокТитул1.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузополучатель Тогда 
		ЛицоПА = "Грузополучатель";
	КонецЕсли;
	XDTO_Установить(XDTO_СвПА, "ЛицоПА", ЛицоПА);
	XDTO_Установить(XDTO_СвПА, "СпосПерУкПА", "Электронное уведомление перевозчика о переадресовке");
	XDTO_Контакт		= НовыйБазовыйОбъектXDTO(НомерТитула, "КонтактТип");
	Для Каждого стрТелефон Из ДокТитул1.ТелефоныПереадресующего Цикл 
		XDTO_Контакт.Тлф.Добавить(СокрЛП(стрТелефон.Телефон));
	КонецЦикла;
	// ДокПерПолнПА - пока не будем делать
	XDTO_Установить(XDTO_СвПА, "КонтПА", XDTO_Контакт);
	
	XDTO_Установить(XDTO_Объект, "СвПА", XDTO_СвПА);
	
	// климатический режим
	XDTO_КлимРеж		= НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.УказГО.КлимРеж");
	XDTO_Установить(XDTO_КлимРеж, "ТемпНеНиже", ДокТитул1.ТемператураНеНиже);
	XDTO_Установить(XDTO_КлимРеж, "ТемпНеВыше", ДокТитул1.ТемператураНеВыше);
	XDTO_Установить(XDTO_КлимРеж, "ВлажнНеНиже", ДокТитул1.ВлажностьНеНиже);
	XDTO_Установить(XDTO_КлимРеж, "ВлажнНеВыше", ДокТитул1.ВлажностьНеВыше);
	XDTO_Установить(XDTO_Объект, "КлимРеж", XDTO_КлимРеж);

	// маршрут перевозки
	
	Если ЗначениеЗаполнено(ДокументЭТРН.МаршрутТекст) 
		ИЛИ ЗначениеЗаполнено(ДокументЭТРН.МаршрутМашиночитаемый) Тогда 
		
		XDTO_МршПрвз = НовыйБазовыйОбъектXDTO(НомерТитула, "СведМршТип");
		XDTO_Установить(XDTO_МршПрвз, "МршТекст", ДокументЭТРН.МаршрутТекст);
		XDTO_Установить(XDTO_МршПрвз, "МршМашЧит", ДокументЭТРН.МаршрутМашиночитаемый);
		XDTO_Установить(XDTO_Объект, "МршПрвз", XDTO_МршПрвз);
		
	КонецЕсли;
	
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СвУказФт(НомерТитула, Формат = Неопределено, ДокТитул1)
	
	ДокументЗН = ДокТитул1.ДокументЗН;
	ТипДокументооборота = "__zakazNarTitle";
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФт.СвУказФт", ТипДокументооборота);
	
	Если ЗначениеЗаполнено(ДокТитул1.УкНормПрвз) Тогда  
		XDTO_Установить(XDTO_Объект, "УкНормПрвз", ДокТитул1.УкНормПрвз);
	КонецЕсли;

	XDTO_ПарТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФт.СвУказФт.ПарТС", ТипДокументооборота);
	XDTO_Установить(XDTO_ПарТС, 	"Тип", 				ДокТитул1.ТСТип);
	XDTO_Установить(XDTO_ПарТС, 	"Марка", 			ДокТитул1.ТСМарка);
	XDTO_Установить(XDTO_ПарТС, 	"Грузопод", 		ДокТитул1.ТСГрузопод);
	XDTO_Установить(XDTO_ПарТС, 	"Вместим", 			ДокТитул1.ТСВместим);
	
	XDTO_Установить(XDTO_Объект, 	"ПарТС", 			XDTO_ПарТС);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СвМршПодТС(НомерТитула, Формат = Неопределено, ДокТитул1)
	
	ДокументЗН = ДокТитул1.ДокументЗН;
	ТипДокументооборота = "__zakazNarTitle";
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФт.СвМршПодТС", ТипДокументооборота);
	XDTO_Установить(XDTO_Объект, 	"ДатВрПодТС", 		XDTO_ДатаВремяВЗТип(ДокТитул1.МаршрутДатВрПодТС));
	XDTO_Установить(XDTO_Объект, 	"НалКоорТочВрПодТС", "1");
	
	XDTO_МршПрвз = НовыйБазовыйОбъектXDTO(НомерТитула, "СведМршТип", ТипДокументооборота);
	XDTO_Установить(XDTO_МршПрвз, 	"МршТекст", ДокументЗН.Маршрут);
	XDTO_Установить(XDTO_МршПрвз, 	"МршМашЧит", ДокументЗН.МаршрутМашиночитаемый);
	XDTO_Установить(XDTO_Объект, 	"МршПрвз", XDTO_МршПрвз);
	
	XDTO_АдрМесПодТС = XDTO_АдресПунктаМаршрута(ДокументЗН.МестоПодачи, НомерТитула, ТипДокументооборота);
	XDTO_Установить(XDTO_Объект, 	"АдрМесПодТС", XDTO_АдрМесПодТС);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СвПер(НомерТитула, Формат = Неопределено, ДокТитул1)
	
	ДокументЭТРН = ДокТитул1.ДокументЭТРН;
	
	XDTO_Объект =  XDTO_УчастникТрН(НомерТитула, Формат, ДокументЭТРН.Перевозчик);	
	Возврат	XDTO_Объект;
	
КонецФункции

функция XDTO_СвВодит(НомерТитула, ВодительСсылка, ТипДокументооборота = "__etrnTitle", ПутьВложенности = "СодИнфГО.СвВодит", Формат = "5.01")
	
	Если ТипДокументооборота = "__etrnTitle" Тогда
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности, ТипДокументооборота);
		
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда	
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности, ТипДокументооборота, Формат);
		
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФщ.СвТС.СвВодит", ТипДокументооборота);
		
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвПрв.СвВодит", ТипДокументооборота);
		
	ИначеЕсли ТипДокументооборота = "__PL" И НомерТитула = 1 Тогда
		ПутьВложенности = "СодИнфСоб.СвВодит";
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности, ТипДокументооборота, Формат);
		
	ИначеЕсли ТипДокументооборота = "__PL" И (НомерТитула = 2 ИЛИ НомерТитула = 6) Тогда
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности, ТипДокументооборота, Формат);
		
	Иначе
		ВызватьИсключение "Непредполагаемое использование Функция XDTO_СвТС";
	КонецЕсли;
	
	// Водительское удостоверение
	Если ЗначениеЗаполнено(ВодительСсылка.ВУНомер)
		ИЛИ ЗначениеЗаполнено(ВодительСсылка.ВУСерия)
		ИЛИ ЗначениеЗаполнено(ВодительСсылка.ВУДатаВыдачи)
		Тогда 
		
		Если ТипДокументооборота = "__SoprVed" Тогда
			XDTO_Установить(XDTO_Объект, "НомерВУ", ВодительСсылка.ВУНомер);
			XDTO_Установить(XDTO_Объект, "СерияВУ", ВодительСсылка.ВУСерия);
			XDTO_Установить(XDTO_Объект, "ДатаВыдВУ", XDTO_ДатаТип(ВодительСсылка.ВУДатаВыдачи));
			
		ИначеЕсли ТипДокументооборота = "__PL" Тогда
			
			XDTO_ВодитУд = НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности + ".ВодитУд", ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_ВодитУд, "НомВУ", ВодительСсылка.ВУНомер);
			XDTO_Установить(XDTO_ВодитУд, "СерВУ", ВодительСсылка.ВУСерия);
			XDTO_Установить(XDTO_ВодитУд, "ДатаВыдВУ", XDTO_ДатаТип(ВодительСсылка.ВУДатаВыдачи));			
			XDTO_Установить(XDTO_Объект, "ВодитУд", XDTO_ВодитУд);
			
		Иначе
			
			XDTO_Установить(XDTO_Объект, "НомВУ", ВодительСсылка.ВУНомер);
			XDTO_Установить(XDTO_Объект, "СерВУ", ВодительСсылка.ВУСерия);
			XDTO_Установить(XDTO_Объект, "ДатаВыдВУ", XDTO_ДатаТип(ВодительСсылка.ВУДатаВыдачи));
			
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВодительСсылка.ИНН) Тогда 
		XDTO_Установить(XDTO_Объект, "ИННФЛ", ВодительСсылка.ИНН);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВодительСсылка.СНИЛС) И Формат = "5.02" Тогда 
		XDTO_Установить(XDTO_Объект, "СНИЛС", ВодительСсылка.СНИЛС);
	КонецЕсли;
	
	// телефон
	Если ТипДокументооборота = "__etrnTitle" Или ТипДокументооборота = "__SoprVed" Или ТипДокументооборота = "__ZZ" Тогда
		
		Если ЗначениеЗаполнено(ВодительСсылка.ТелефонОсновной) Тогда 
			XDTO_Объект.Тлф.Добавить(ВодительСсылка.ТелефонОсновной);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВодительСсылка.ТелефонЗапасной) Тогда 
			XDTO_Объект.Тлф.Добавить(ВодительСсылка.ТелефонЗапасной);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		
		Если ЗначениеЗаполнено(ВодительСсылка.ТелефонОсновной) Тогда
			
			XDTO_Контакт = НовыйБазовыйОбъектXDTO(НомерТитула, "КонтактТип", ТипДокументооборота, Формат);
			XDTO_Контакт.Тлф.Добавить(СокрЛП(ВодительСсылка.ТелефонОсновной));
			Если ЗначениеЗаполнено(ВодительСсылка.ТелефонЗапасной) Тогда 
				XDTO_Контакт.Тлф.Добавить(СокрЛП(ВодительСсылка.ТелефонЗапасной));
			КонецЕсли;
			XDTO_Объект.СредСвяз.Добавить(XDTO_Контакт);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
		
		XDTO_Контакт = НовыйБазовыйОбъектXDTO(НомерТитула, "КонтактТип", ТипДокументооборота, Формат);
		Если ЗначениеЗаполнено(ВодительСсылка.ТелефонОсновной) Тогда 
			XDTO_Контакт.Тлф.Добавить(ВодительСсылка.ТелефонОсновной);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВодительСсылка.АдресЭлектроннойПочты) Тогда 
			XDTO_Контакт.ЭлПочта.Добавить(ВодительСсылка.АдресЭлектроннойПочты);
		КонецЕсли;
		XDTO_Установить(XDTO_Контакт, "ИнКонт", ВодительСсылка.ИныеКонтактныеДанные);
		XDTO_Установить(XDTO_Объект, "Контакт", XDTO_Контакт);
		
		XDTO_СвДОПОГ = НовыйДочернийОбъектXDTO(НомерТитула, ПутьВложенности + ".СвДОПОГ", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвДОПОГ, "СерСвДОПОГ", ВодительСсылка.ДОПОГСерия);
		XDTO_Установить(XDTO_СвДОПОГ, "НомСвДОПОГ", ВодительСсылка.ДОПОГНомер);
		XDTO_Установить(XDTO_СвДОПОГ, "КонДатСвДОПОГ", XDTO_ДатаТип(ВодительСсылка.ДОПОГДатаОкончания));
		XDTO_Установить(XDTO_Объект, "СвДОПОГ", XDTO_СвДОПОГ);
		
	КонецЕсли;

	// ФИО
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
	
	XDTO_ФИО.Фамилия = ВодительСсылка.Фамилия;
	XDTO_ФИО.Имя = ВодительСсылка.Имя;
	Если ЗначениеЗаполнено(ВодительСсылка.Отчество) Тогда 
		XDTO_ФИО.Отчество = ВодительСсылка.Отчество;
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "ФИО", XDTO_ФИО);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_СвТС(НомерТитула, Формат = Неопределено, ДокТитул, ТипДокументооборота = "__etrnTitle")
	
	Если ТипДокументооборота = "__PL" Тогда
		
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС", ТипДокументооборота, Формат);
		
		// машина (ТС)
		XDTO_ТС = XDTO_ПараметрыТС(НомерТитула, ДокТитул.ТранспортноеСредство, ДокТитул, ТипДокументооборота);
		
		XDTO_Установить(XDTO_Объект, 	"ТС", 			XDTO_ТС);
		
		// прицеп необязателен
		Если ЗначениеЗаполнено(ДокТитул.Прицеп) Тогда 
			XDTO_Прицеп = XDTO_ПараметрыТС(НомерТитула, ДокТитул.Прицеп, ДокТитул);
			XDTO_Объект.Прицеп.Добавить(XDTO_Прицеп);
			
			Если ЗначениеЗаполнено(ДокТитул.Прицеп2) Тогда 
				XDTO_Прицеп2 = XDTO_ПараметрыТС(НомерТитула, ДокТитул.Прицеп2, ДокТитул);
				XDTO_Объект.Прицеп.Добавить(XDTO_Прицеп2);
			КонецЕсли;
		КонецЕсли;
			
	ИначеЕсли ТипДокументооборота = "__etrnTitle" Тогда
		
		ДокументЭТРН = ДокТитул.ДокументЭТРН;
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвТС");
		
		// машина (ТС)
		XDTO_ТС = XDTO_ПараметрыТС(НомерТитула, ДокументЭТРН.ТранспортноеСредство, ДокТитул, ТипДокументооборота);
		XDTO_Установить(XDTO_Объект, 	"ТС", 			XDTO_ТС);
		
		// прицеп необязателен
		Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп) Тогда 
			XDTO_Прицеп = XDTO_ПараметрыТС(НомерТитула, ДокументЭТРН.Прицеп, ДокТитул);
			XDTO_Объект.Прицеп.Добавить(XDTO_Прицеп);
			
			Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп2) Тогда
				XDTO_Прицеп2 = XDTO_ПараметрыТС(НомерТитула, ДокументЭТРН.Прицеп2, ДокТитул);
				XDTO_Объект.Прицеп.Добавить(XDTO_Прицеп2);
			КонецЕсли;
		КонецЕсли;
		
		// Сведения о специальных условиях движения СпецУслДвижТип
		Если ТипЗнч(ДокТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда 
			Для Каждого СтрокаСпецУслДвиж Из ДокТитул.СпецУслДвиж Цикл 
				XDTO_СпецУслДвиж = XDTO_СпецУслДвиж(НомерТитула, СтрокаСпецУслДвиж, ТипДокументооборота);
				XDTO_Объект.СпецУслДвиж.Добавить(XDTO_СпецУслДвиж);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодЗНИнфФщ.СвТС", ТипДокументооборота);
		
		XDTO_ПарамТС = XDTO_ПарамТСТип(НомерТитула, ДокТитул.ТранспортноеСредство, ТипДокументооборота);
		XDTO_Установить(XDTO_Объект, "Колво", 1);
		XDTO_Установить(XDTO_Объект, "РегНомер", ДокТитул.ТранспортноеСредство.РегНомер);
		XDTO_Установить(XDTO_Объект, "ПарТС", XDTO_ПарамТС);
		
		// основной водитель
		XDTO_СвВодит = XDTO_СвВодит(НомерТитула, ДокТитул.Водитель, ТипДокументооборота);
		XDTO_ПутЛист = XDTO_ПутЛист(ДокТитул, НомерТитула, ТипДокументооборота, ДокТитул.ПутевойЛистНомер, ДокТитул.ПутевойЛистДата, ДокТитул.ПутевойЛистСрокДействия);
		XDTO_СвВодит.ПутевойЛист.Добавить(XDTO_ПутЛист);
		XDTO_Объект.СвВодит.Добавить(XDTO_СвВодит);
		
		// доп водители
		Для Каждого ДопВодитель Из ДокТитул.ДополнительныеВодители Цикл 
			XDTO_СвВодит = XDTO_СвВодит(НомерТитула, ДопВодитель.Водитель, ТипДокументооборота);
			XDTO_ПутЛист = XDTO_ПутЛист(ДокТитул, НомерТитула, ТипДокументооборота, ДопВодитель.ПутевойЛистНомер, ДопВодитель.ПутевойЛистДата, ДопВодитель.ПутевойЛистСрокДействия);
			XDTO_СвВодит.ПутевойЛист.Добавить(XDTO_ПутЛист);
			XDTO_Объект.СвВодит.Добавить(XDTO_СвВодит);
		КонецЦикла;
		
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		
		ДокументСВ = ДокТитул.ДокументСВ;
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвТС", ТипДокументооборота);
		
		// машина (ТС)
		XDTO_ТС = XDTO_ПараметрыТС(НомерТитула, ДокТитул.ТранспортноеСредство, ДокТитул, ТипДокументооборота);
		XDTO_Установить(XDTO_Объект, 	"ТС", 			XDTO_ТС);
		
		// Прицеп
		Если ЗначениеЗаполнено(ДокТитул.Прицеп) Тогда 
			XDTO_Прицеп = XDTO_ПараметрыТС(НомерТитула, ДокТитул.Прицеп, ДокТитул, ТипДокументооборота);
			XDTO_Объект.Прицеп.Добавить(XDTO_Прицеп);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
		
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрв.СвТС", ТипДокументооборота, Формат);
		
		// машина (ТС)
		XDTO_ТС = XDTO_ПараметрыТС(НомерТитула, ДокТитул.ТранспортноеСредство, ДокТитул, ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Объект, "ТС", 	XDTO_ТС);
		
		// Прицеп
		Для Каждого СтрокаПрицеп Из ДокТитул.Прицепы Цикл  
			XDTO_Прицеп = XDTO_ПараметрыТС(НомерТитула, СтрокаПрицеп.Прицеп, ДокТитул, ТипДокументооборота, Формат);
			XDTO_Объект.Прицеп.Добавить(XDTO_Прицеп);
		КонецЦикла;
		
		// Сведения о специальных условиях движения СпецУслДвижТип
		Если ТипЗнч(ДокТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда 
			Для Каждого СтрокаСпецУслДвиж Из ДокТитул.СпецУсловияДвижения Цикл 
				XDTO_СпецУслДвиж = XDTO_СпецУслДвиж(НомерТитула, СтрокаСпецУслДвиж, ТипДокументооборота, Формат);
				XDTO_Объект.СпецУслДвиж.Добавить(XDTO_СпецУслДвиж);
			КонецЦикла;
		КонецЕсли;
		
		// TODO инфополя
		
	Иначе
		
		ВызватьИсключение "Непредполагаемое использование Функция XDTO_СвТС";
		
	КонецЕсли;
	
	Возврат	XDTO_Объект;
	
КонецФункции

Функция XDTO_ПутЛист(Знач ДокТитул, Знач НомерТитула, Знач ТипДокументооборота, ПутевойЛистНомер, ПутевойЛистДата, ПутевойЛистСрокДействия)
	
	Перем XDTO_ПутЛист;
	
	XDTO_ПутЛист = НовыйБазовыйОбъектXDTO(НомерТитула, "ПутЛистТип", ТипДокументооборота); 
	XDTO_Установить(XDTO_ПутЛист, "НаимПЛ", "Путевой лист");
	XDTO_Установить(XDTO_ПутЛист, "НомерПЛ", ПутевойЛистНомер);
	Если ЗначениеЗаполнено(ПутевойЛистДата) Тогда 
		XDTO_Установить(XDTO_ПутЛист, "ДатаВыпПЛ", XDTO_ДатаТип(ПутевойЛистДата));
	КонецЕсли;
	XDTO_Установить(XDTO_ПутЛист, "СвСрокПЛ", ПутевойЛистСрокДействия);

	Возврат XDTO_ПутЛист;
	
КонецФункции

Функция XDTO_СпецУслДвиж(НомерТитула, СтрокаСпецУслДвиж, ТипДокументооборота = "__etrnTitle", Формат = Неопределено)

	Если ТипДокументооборота = "__ZZ" Тогда
		XDTO_СпецУслДвиж = НовыйБазовыйОбъектXDTO(НомерТитула, "СпецУслДвижТип", ТипДокументооборота, Формат);
	ИначеЕсли ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
		XDTO_СпецУслДвиж = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СпецУслДвиж", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СпецУслДвиж, "СпецУсл", Перечисления.КонтурЛогистика_СпециальныеУсловияДвижения.ЗначениеДляXDTO(СтрокаСпецУслДвиж.СпецУсл));
	Иначе	
		XDTO_СпецУслДвиж = НовыйБазовыйОбъектXDTO(НомерТитула, "СпецУслДвижТип", ТипДокументооборота);	
	КонецЕсли;
		
	XDTO_Установить(XDTO_СпецУслДвиж, "НомСР", СтрокаСпецУслДвиж.НомСР);
	XDTO_Установить(XDTO_СпецУслДвиж, "ДатаСР", XDTO_ДатаТип(СтрокаСпецУслДвиж.ДатаСР));
	XDTO_Установить(XDTO_СпецУслДвиж, "СрокСР", СтрокаСпецУслДвиж.СрокСР);
	
	XDTO_Установить(XDTO_СпецУслДвиж, "ИдСР", СтрокаСпецУслДвиж.ИдСР);
	
	Если ТипДокументооборота = "__ZZ" Или (ТипДокументооборота = "__PL" И Формат = "5.02") Тогда
		XDTO_Установить(XDTO_СпецУслДвиж, "НаимОИВ", СтрокаСпецУслДвиж.НаимОИВ);
		XDTO_Установить(XDTO_СпецУслДвиж, "ВидСР", СтрокаСпецУслДвиж.ВидСР);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтрокаСпецУслДвиж.СведМрш_МршТекст)
		ИЛИ ЗначениеЗаполнено(СтрокаСпецУслДвиж.СведМрш_МршМашЧит) Тогда 
		
		Если ТипДокументооборота = "__ZZ" Тогда
			XDTO_СведМршТип = НовыйБазовыйОбъектXDTO(НомерТитула, "СведМршТип", ТипДокументооборота, Формат);
		ИначеЕсли ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
			XDTO_СведМршТип = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СпецУслДвиж.СведМрш", ТипДокументооборота, Формат);
		Иначе	
			XDTO_СведМршТип = НовыйБазовыйОбъектXDTO(НомерТитула, "СведМршТип", ТипДокументооборота);	
		КонецЕсли;
			
		XDTO_Установить(XDTO_СведМршТип, "МршТекст", СтрокаСпецУслДвиж.СведМрш_МршТекст);
		XDTO_Установить(XDTO_СведМршТип, "МршМашЧит", СтрокаСпецУслДвиж.СведМрш_МршМашЧит);
				
		XDTO_Установить(XDTO_СпецУслДвиж, "СведМрш", XDTO_СведМршТип);
		
	КонецЕсли;

	Возврат XDTO_СпецУслДвиж;
	
КонецФункции

Функция XDTO_СвПогруз(НомерТитула, Формат = Неопределено, ДокТитул1)
	
	ДокументЭТРН = ДокТитул1.ДокументЭТРН;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвПогруз");
	
	// обязательные
	
	ЧасовойПоясПогрузки = ДокументЭТРН.МестоПогрузки.ЧасовойПояс;
	
	XDTO_Установить(XDTO_Объект, "ЗаявПогр", XDTO_ДатаВремяВЗТип(ДокТитул1.ДатаВремяПодачиПлановая, ЧасовойПоясПогрузки));
	XDTO_Установить(XDTO_Объект, "НалКоорТочВрЗаяв", "1");
	
	XDTO_Установить(XDTO_Объект, "ФДатВрПриб", XDTO_ДатаВремяВЗТип(ДокТитул1.ДатаВремяПрибытия, ЧасовойПоясПогрузки));
	XDTO_Установить(XDTO_Объект, "НалКоорТочВрФПогр", "1");

	XDTO_Установить(XDTO_Объект, "ФДатВрУбыт", XDTO_ДатаВремяВЗТип(ДокТитул1.ДатаВремяУбытия, ЧасовойПоясПогрузки));
	XDTO_Установить(XDTO_Объект, "НалКоорТочВрФУбыт", "1");

	XDTO_Установить(XDTO_Объект, "МасБрутОтгр", ДокТитул1.МассаБруттоКг);
	XDTO_Установить(XDTO_Объект, "МетОпрМасс", Перечисления.КонтурЛогистика_МетодыОпределенияМассы.ЗначениеДляXDTO(ДокТитул1.МетодОпределенияМассы));
	
	XDTO_Установить(XDTO_Объект, "КолМестПрием", ДокТитул1.КоличествоМест);
	
	XDTO_АдресПогрузки = XDTO_АдресПунктаМаршрута(ДокументЭТРН.МестоПогрузки, НомерТитула); 
	XDTO_Установить(XDTO_Объект, "ФАдресПогр", XDTO_АдресПогрузки);
	
	XDTO_СвЛицПогрГр = XDTO_СвЛицПогрГр(НомерТитула, Формат, ДокументЭТРН);
	XDTO_Установить(XDTO_Объект, "СвЛицПогрГр", XDTO_СвЛицПогрГр);
	
	XDTO_ВладИнфр = XDTO_ВладИнфр(НомерТитула, Формат, ДокументЭТРН);
	XDTO_Установить(XDTO_Объект, "ВладИнфр", XDTO_ВладИнфр);
	
	Если ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.Собственник) 
		И НЕ ДокументЭТРН.МестоПогрузки.Собственник = ДокументЭТРН.Грузоотправитель Тогда
		
		Если ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор) Тогда
			
			XDTO_ОснДостОбИнфрДок = XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор); 
			XDTO_Установить(XDTO_Объект, "ОснДостОбИнфрДок", XDTO_ОснДостОбИнфрДок);
			
		ИначеЕсли ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуТекст) Тогда
			XDTO_Установить(XDTO_Объект, "ОснДостОбИнфрТекст", ДокументЭТРН.МестоПогрузки.ДоступКОбъектуТекст);
		КонецЕсли;
		
	КонецЕсли;
	
	// НЕобязательные
	XDTO_Установить(XDTO_Объект, "ФСостТар", СокрЛП(ДокТитул1.СостояниеТары));
	XDTO_Установить(XDTO_Объект, "ФСостУп", СокрЛП(ДокТитул1.СостояниеУпаковки));
	XDTO_Установить(XDTO_Объект, "ФСостКуз", СокрЛП(ДокТитул1.СостояниеКузова));
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ВладИнфр(Знач НомерТитула, Знач Формат, Знач ДокументЭТРН)
	
	Перем XDTO_ВладИнфр, XDTO_ИдентРекГО, XDTO_РекВладИнф;
	
	XDTO_ВладИнфр = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвПогруз.ВладИнфр");
	
	Если Не ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.Собственник) Тогда
		
		// неизвестен или его нет в природе
		XDTO_Установить(XDTO_ВладИнфр, "СовпГОВ", "3");
		Если ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.СобственникНеУказанПричина) Тогда 
			XDTO_Установить(XDTO_ВладИнфр, "ОбНетИнфОВлад", ДокументЭТРН.МестоПогрузки.СобственникНеУказанПричина);
		Иначе
			XDTO_Установить(XDTO_ВладИнфр, "ОбНетИнфОВлад", "нет возможности установить");
		КонецЕсли;
		
	ИначеЕсли ДокументЭТРН.МестоПогрузки.Собственник = ДокументЭТРН.Грузоотправитель Тогда 
		
		
		XDTO_Установить(XDTO_ВладИнфр, "СовпГОВ", "1");
		XDTO_ИдентРекГО = XDTO_ИдРекСостТип(НомерТитула, ДокументЭТРН.Грузоотправитель);
		XDTO_Установить(XDTO_ВладИнфр, "ИдентРекГО", XDTO_ИдентРекГО);
		
	Иначе
		
		// НЕ равен ГО
		XDTO_Установить(XDTO_ВладИнфр, "СовпГОВ", "2");
		
		// реквизиты юр. лица
		XDTO_РекВладИнф = XDTO_УчастникТрН(НомерТитула, Формат, ДокументЭТРН.МестоПогрузки.Собственник);
		XDTO_Установить(XDTO_ВладИнфр, "РекВладИнф", XDTO_РекВладИнф);
		
	КонецЕсли;
	Возврат XDTO_ВладИнфр;

КонецФункции

Функция XDTO_СвЛицПогрГр(Знач НомерТитула, Знач Формат, Знач ДокументЭТРН)
	
	Перем XDTO_ИдентРекГО, XDTO_ОснПогрГр, XDTO_РабЛицПогрГр, XDTO_РекЛицПогрГр, XDTO_СвЛицПогрГр, XDTO_ОПИное, XDTO_ФИО;
	
	XDTO_СвЛицПогрГр = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвПогруз.СвЛицПогрГр");
	
	Если Не ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет)
		ИЛИ ДокументЭТРН.ПогрузкуОсуществляет = ДокументЭТРН.Грузоотправитель Тогда 
		
		XDTO_Установить(XDTO_СвЛицПогрГр, "СовпГОП", "1");
		
		XDTO_ИдентРекГО = XDTO_ИдРекСостТип(НомерТитула, ДокументЭТРН.Грузоотправитель);
		XDTO_Установить(XDTO_СвЛицПогрГр, "ИдентРекГО", XDTO_ИдентРекГО);
		
	Иначе
		
		// НЕ равен ГО
		XDTO_Установить(XDTO_СвЛицПогрГр, "СовпГОП", "2");
		
		// реквизиты юрлица
		XDTO_РекЛицПогрГр = XDTO_УчастникТрН(НомерТитула, Формат, ДокументЭТРН.ПогрузкуОсуществляет);
		XDTO_Установить(XDTO_СвЛицПогрГр, "РекЛицПогрГр", XDTO_РекЛицПогрГр);
		
		// реквизиты договора
		XDTO_ОснПогрГр = XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, ДокументЭТРН.ПогрузкаДоговор);     
		XDTO_Установить(XDTO_СвЛицПогрГр, "ОснПогрГр", XDTO_ОснПогрГр);
		
		
	КонецЕсли;
	
	// работник - может быть указан при любом СовпГОП
	Если ЗначениеЗаполнено(ДокументЭТРН.ПогрузкаСотрудник) Тогда
		
		XDTO_РабЛицПогрГр = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвПогруз.СвЛицПогрГр.РабЛицПогрГр");
		XDTO_Установить(XDTO_РабЛицПогрГр, "Должность", 	ДокументЭТРН.ПогрузкаСотрудник.Должность);
		XDTO_Установить(XDTO_РабЛицПогрГр, "ИныеСвед", 	ДокументЭТРН.ПогрузкаСотрудник.ИныеСведения);
		
		Если ЗначениеЗаполнено(ДокументЭТРН.ПогрузкаСотрудник.ОснованиеПолномочийДоговор) Тогда
			
			ОснованиеПолномочий = ДокументЭТРН.ПогрузкаСотрудник.ОснованиеПолномочийДоговор;
			
			XDTO_ОПИное = XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, ОснованиеПолномочий); 
			XDTO_Установить(XDTO_РабЛицПогрГр, "ОПИное", XDTO_ОПИное);			
			
		Иначе
			
			ОснованиеПолномочий = ДокументЭТРН.ПогрузкаСотрудник.ОснованиеПолномочий;
			
			Если Не ЗначениеЗаполнено(ОснованиеПолномочий) Тогда 
				ОснованиеПолномочий = "Должностные обязанности"; 
			КонецЕсли;
			
			XDTO_Установить(XDTO_РабЛицПогрГр, "ОДолжОб", 	ОснованиеПолномочий);
			
		КонецЕсли;
		
		XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип");
		XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ДокументЭТРН.ПогрузкаСотрудник.Фамилия);
		XDTO_Установить(XDTO_ФИО,	 "Имя",			ДокументЭТРН.ПогрузкаСотрудник.Имя);
		XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ДокументЭТРН.ПогрузкаСотрудник.Отчество);
		XDTO_Установить(XDTO_РабЛицПогрГр, "ФИО", 	XDTO_ФИО);
		
		XDTO_Установить(XDTO_СвЛицПогрГр, "РабЛицПогрГр", XDTO_РабЛицПогрГр);
		
	КонецЕсли;
	
	Возврат XDTO_СвЛицПогрГр;

КонецФункции

Функция XDTO_ОпГруз(НомерТитула, Формат = Неопределено, ДокТитул1, СтрокаДокумента, ТипДокументооборота = "__etrnTitle")
	
	Если ТипДокументооборота = "__etrnTitle" ИЛИ ТипДокументооборота = "__ZZ" Тогда 
		КорневойТег = "СодИнфГО";
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		КорневойТег = "СодЗНИнфФт";
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		КорневойТег = "СодСВИнфПрв";
	ИначеЕсли ТипДокументооборота = "__ForwardingReceipt" Тогда
		КорневойТег = "СодЭР";
	КонецЕсли;
	
	Если ТипДокументооборота = "__ZZ" Тогда 
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".ОпГруз", ТипДокументооборота, Формат);
	Иначе
		XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".СвГруз.ОпГруз", ТипДокументооборота, Формат);
	КонецЕсли;
	
	// обязательные
	XDTO_Установить(XDTO_Объект, "НаимГруз", СокрЛП(СтрокаДокумента.ОтгрузочноеНаименование));
	XDTO_Установить(XDTO_Объект, "СостГруз", СокрЛП(СтрокаДокумента.СостояниеГруза));
	Если ТипДокументооборота <> "__ZZ" Тогда 
		XDTO_Установить(XDTO_Объект, "СпУпак", СокрЛП(СтрокаДокумента.СпособУпаковки));
	КонецЕсли;
	
	// ВидТары
	Если ЗначениеЗаполнено(СтрокаДокумента.ВидТары) Тогда 
		ВидТарыКод = СтрокаДокумента.ВидТары.Код;
	Иначе
		ВидТарыКод = "00";
	КонецЕсли;
	XDTO_Установить(XDTO_Объект, "ВидТар", ВидТарыКод);
	
	Если ТипДокументооборота = "__SoprVed" Тогда
		XDTO_Установить(XDTO_Объект, "Объем", СтрокаДокумента.ОбъемГруза);
		XDTO_Установить(XDTO_Объект, "ОбъемКонт", СтрокаДокумента.ОбъемКонтейнера);
	Иначе
		XDTO_Установить(XDTO_Объект, "Объем", ?(СтрокаДокумента.ОбъемКубМ = 0, 0, Макс(0.01,Окр(СтрокаДокумента.ОбъемКубМ,2))));
	КонецЕсли;
	
	Если ТипДокументооборота = "__etrnTitle" Тогда 
		XDTO_Установить(XDTO_Объект, "КолМестГр", СтрокаДокумента.КоличествоМест, Истина);
		ТегМасса = "ПлМасГруз";
		Если СтрокаДокумента.УчетГрузаВГИС Тогда 
			XDTO_Установить(XDTO_Объект, "УчГосСист", "1");
			
			// TODO СвГосСист
			
			СГСПоСтроке = ДокТитул1.СведенияГосСистем.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаДокумента.ИдентификаторСтроки));
			Если СГСПоСтроке.Количество() > 0 Тогда 
				
				XDTO_СвГосСист = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".СвГруз.ОпГруз.СвГосСист", ТипДокументооборота, Формат);
				XDTO_Установить(XDTO_СвГосСист,	"НаимГосСист", СГСПоСтроке[0].НаимГосСист);
				XDTO_Установить(XDTO_СвГосСист,	"УчетЕд", 	   СГСПоСтроке[0].УчетЕд);
				XDTO_Установить(XDTO_СвГосСист,	"ИнаяИнф", 	   СГСПоСтроке[0].ИнаяИнф);
				
				Для Каждого ОписаниеСГС Из СГСПоСтроке Цикл
					XDTO_СвГосСист.ИдНомУчетЕд.Добавить(ОписаниеСГС.ИдНомУчетЕд);
				КонецЦикла;
				
				XDTO_Установить(XDTO_Объект, "СвГосСист", XDTO_СвГосСист);
				
			КонецЕсли;
			
		КонецЕсли;
		
		// ЗакУсл - сложное ИдСвТип
		Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказчикОрганизацияДиадок) Тогда 
			XDTO_ЗакУсл 			= НовыйБазовыйОбъектXDTO(НомерТитула, "ИдСвТип", ТипДокументооборота, Формат);
			XDTO_ИдСв_ЗаполнитьИзОрганизацииДиадок(XDTO_ЗакУсл, НомерТитула, Формат, СтрокаДокумента.ЗаказчикОрганизацияДиадок);
			XDTO_Установить(XDTO_Объект, 	"ЗакУсл", 		XDTO_ЗакУсл);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
		
		ТегМасса = "МасГруз";
		
		XDTO_Установить(XDTO_Объект, "КолГрМест", СтрокаДокумента.КоличествоМест);
		XDTO_Установить(XDTO_Объект, "МетОпрМасс", Перечисления.КонтурЛогистика_МетодыОпределенияМассы.ЗначениеДляXDTO(СтрокаДокумента.МетодОпределенияМассы));
		XDTO_Установить(XDTO_Объект, "РаспрГр", ?(СтрокаДокумента.РаспрГр, "1", "0"));
		XDTO_Установить(XDTO_Объект, "ДелГр", ?(СтрокаДокумента.ДелГр, "1", "0"));
		XDTO_Установить(XDTO_Объект, "УчВодПогрГр", ?(СтрокаДокумента.УчВодПогрГр, "1", "0"));
		
		Если СтрокаДокумента.ПрГрКонт = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ПодачаПорожнегоКонтейнераГрузоотправителю Тогда
			XDTO_Установить(XDTO_Объект, "ПрГрКонт", "1");
		ИначеЕсли СтрокаДокумента.ПрГрКонт = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ПриемКПеревозкеГруженогоКонтейнера Тогда
			XDTO_Установить(XDTO_Объект, "ПрГрКонт", "0");
		КонецЕсли;
		
		// ЗакУсл - сложное ИдСвТип
		Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказчикОрганизацияДиадок) Тогда
			XDTO_ЗакУсл = XDTO_УчастникТрН(НомерТитула, Формат, СтрокаДокумента.ЗаказчикОрганизацияДиадок, ТипДокументооборота);
			XDTO_Установить(XDTO_Объект, 	"ЗакУсл", 		XDTO_ЗакУсл);
			
			// еще в этом случае обязателен ДогУслПрвз
			XDTO_ДогУслПрвз = XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, СтрокаДокумента.ДоговорПеревозкиЛогистика, ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_Объект, 	"ДогУслПрвз", 		XDTO_ДогУслПрвз);
			
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		
		ТегМасса = "МасГруз";
		
		XDTO_Установить(XDTO_Объект, "КолМест", СтрокаДокумента.КоличествоМест);
		XDTO_Установить(XDTO_Объект, "ВозмРаспр", ?(СтрокаДокумента.ВозможностьРаспределения, "1", "0"));
		
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		
		ТегМасса = "ПлМасГруз";
		
		XDTO_Установить(XDTO_Объект, "МассаКонт", СтрокаДокумента.МассаКонтейнеровБрутто);
		XDTO_Установить(XDTO_Объект, "ПлКолМест", СтрокаДокумента.КоличествоМест);
		
	ИначеЕсли ТипДокументооборота = "__ForwardingReceipt" Тогда
		
		XDTO_Установить(XDTO_Объект, "КолМестГр", СтрокаДокумента.КоличествоМест);
		
		ТегМасса = "ПлМасГруз";
		
		// ЗакУсл - сложное ИдСвТип
		Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказчикОрганизацияДиадок) Тогда 
			XDTO_ЗакУсл = НовыйБазовыйОбъектXDTO(НомерТитула, "ИдСвТип", ТипДокументооборота, Формат);
			XDTO_ИдСв_ЗаполнитьИзОрганизацииДиадок(XDTO_ЗакУсл, НомерТитула, Формат, СтрокаДокумента.ЗаказчикОрганизацияДиадок);
			XDTO_Установить(XDTO_Объект, "ЗакУсл", XDTO_ЗакУсл);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипДокументооборота = "__SoprVed" Тогда
		
		XDTO_Установить(XDTO_Объект, ТегМасса, XDTO_МассаТип(НомерТитула,
																ТипДокументооборота,
																СтрокаДокумента.ПлановаяМассаГрузаБрутто,
																0,
																СтрокаДокумента.КоличествоПаллет));
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
		
		XDTO_Установить(XDTO_Объект, ТегМасса, XDTO_МассаТип(НомерТитула,
																ТипДокументооборота,
																СтрокаДокумента.МассаПлановаяБруттоКг,
																СтрокаДокумента.МассаПлановаяНеттоКг,
																СтрокаДокумента.КоличествоПаллет,
																СтрокаДокумента.МасТар,
																Формат));
																
	Иначе
		
		XDTO_Установить(XDTO_Объект, ТегМасса, XDTO_МассаТип(НомерТитула,
																ТипДокументооборота,
																СтрокаДокумента.МассаПлановаяБруттоКг,
																СтрокаДокумента.МассаПлановаяНеттоКг,
																СтрокаДокумента.КоличествоПаллет,,
																Формат));
																
	КонецЕсли;
	
	Если ТипДокументооборота <> "__ZZ" Тогда
		СтрокиМарикровкиПоТовару = ДокТитул1.Маркировки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаДокумента.ИдентификаторСтроки));
		Если СтрокиМарикровкиПоТовару.Количество() > 0 Тогда 
			Для Каждого СтрокаМаркировки Из СтрокиМарикровкиПоТовару Цикл 
				XDTO_Объект.Марк.Добавить(СтрокаМаркировки.ЗначениеМаркировки);
			КонецЦикла;
		Иначе
			XDTO_Объект.Марк.Добавить("Отсутствует");
		КонецЕсли;
	КонецЕсли;
	
	// НЕобязательные
	Если ТипДокументооборота = "__SoprVed" Тогда
		XDTO_Установить(XDTO_Объект, "ГрузДелим", ?(СтрокаДокумента.ГрузДелим, "1", "0"));
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
		XDTO_Установить(XDTO_Объект, "ДрОГруз", СтрокаДокумента.ДопИнформация);
	Иначе
		XDTO_Установить(XDTO_Объект, "КодТовНом", СтрокаДокумента.КодТНВЭД);
		XDTO_Установить(XDTO_Объект, "ДрОГруз", СтрокаДокумента.ДопИнформация);
	КонецЕсли;
		
	Если ТипДокументооборота <> "__ZZ" И ЗначениеЗаполнено(СтрокаДокумента.Плотность) Тогда
		XDTO_Установить_Плотн(XDTO_Объект, СтрокаДокумента.Плотность);
	КонецЕсли;
	
	Если ТипДокументооборота <> "__SoprVed" И ТипДокументооборота <> "__ZZ" Тогда
		Если ЗначениеЗаполнено(СтрокаДокумента.ОбъявленнаяЦенность) Тогда 
			XDTO_ЦеннГрузТип = XDTO_ЦеннГрузТип(НомерТитула,
												СтрокаДокумента.ОбъявленнаяЦенность,
												СтрокаДокумента.ОбъявленнаяЦенностьВалюта.Код,
												СтрокаДокумента.ОбъявленнаяЦенностьВалюта.НаименованиеПолное,
												ТипДокументооборота,
												Формат);
			
			XDTO_Установить(XDTO_Объект, "ЦеннГруз", XDTO_ЦеннГрузТип);
		КонецЕсли;
	КонецЕсли;
	
	// Опасные грузы
	Если ТипДокументооборота <> "__ForwardingReceipt" Тогда
		
		ОГПоСтроке = ДокТитул1.ОпасныеГрузы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаДокумента.ИдентификаторСтроки));
		
		Для Каждого ОписаниеОГ Из ОГПоСтроке Цикл
			
			Источник = ОписаниеОГ;
			
			XDTO_СвОпГруз = XDTO_СвОпГруз(НомерТитула, ТипДокументооборота, Формат, Источник, КорневойТег);
			
			Если ТипДокументооборота = "__SoprVed" Тогда
				XDTO_Установить(XDTO_Объект, "СвОпГруз", XDTO_СвОпГруз);
				Прервать; // Опасные грузы не множественные
			ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
				XDTO_Установить(XDTO_Объект, "ИнфОпасн", XDTO_СвОпГруз);
				Прервать; // Опасные грузы не множественные
			Иначе
				XDTO_Объект.СвОпГруз.Добавить(XDTO_СвОпГруз);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Габар
	Если ЗначениеЗаполнено(СтрокаДокумента.Высота) 
		И ЗначениеЗаполнено(СтрокаДокумента.Длина) 
		И  ЗначениеЗаполнено(СтрокаДокумента.Ширина) Тогда
		
		XDTO_Габар = XDTO_ГабарТип(НомерТитула, ТипДокументооборота, СтрокаДокумента.Высота, СтрокаДокумента.Длина, СтрокаДокумента.Ширина, Формат);
		
		Если ТипДокументооборота = "__ZZ" Тогда
			XDTO_Установить(XDTO_Объект, "РазмерГрМест", XDTO_Габар);
		Иначе
			XDTO_Установить(XDTO_Объект, "Габар", XDTO_Габар);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипДокументооборота = "__zakazNarTitle" 
		ИЛИ ТипДокументооборота = "__etrnTitle" Тогда
		
		// СвКонтейн
		КонтейнерыПоСтроке = ДокТитул1.Контейнеры.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаДокумента.ИдентификаторСтроки));
		Если КонтейнерыПоСтроке.Количество() > 0 Тогда 
			
			Для Каждого ОписаниеКонтейнера Из КонтейнерыПоСтроке Цикл 
				
				XDTO_СвКонтейн = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".СвГруз.ОпГруз.СвКонтейн", ТипДокументооборота);
				XDTO_СвКонтейн.ИдКонтейн.Добавить(ОписаниеКонтейнера.ИдНомерКонтейнера);
				XDTO_Установить(XDTO_СвКонтейн, "КолКонтейн", 1);
				
				XDTO_Объект.СвКонтейн.Добавить(XDTO_СвКонтейн);
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ТипДокументооборота = "__ZZ" Тогда
		
		// Пункты погрузки и выгрузки  Пункт
		ПунктыПоСтроке = ДокТитул1.ТоварыПунктыПогрузкиВыгрузки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаДокумента.ИдентификаторСтроки));
		Для Каждого СтрокаПункта Из ПунктыПоСтроке Цикл
			
			XDTO_Пункт = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.ОпГруз.Пункт", ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_Пункт, 	"Погр", 	СтрокаПункта.Погрузка);
			XDTO_Установить(XDTO_Пункт, 	"Выгр", 	СтрокаПункта.Выгрузка);
			XDTO_Установить(XDTO_Пункт, 	"КолГрМест", СтрокаПункта.КолГрМест);
			
			XDTO_Объект.Пункт.Добавить(XDTO_Пункт);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Процедура XDTO_Установить_Плотн(XDTO_Объект, Знач Плотность)
	
	ОкругленноеЗначение = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОкруглитьПлотность(Плотность);
	
	XDTO_Установить(XDTO_Объект, "Плотн", ОкругленноеЗначение);
	
КонецПроцедуры

Функция XDTO_СвПринПоНаимБезУчДок(НомерТитула, Формат = Неопределено, ДокТитул3, СтрокаДокумента)
	
	ДокументЭТРН = ДокТитул3.ДокументЭТРН;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГП.ПриемГрузГП.СвПринПоНаим");
	
	XDTO_Установить(XDTO_Объект, "НаимГруз", СтрокаДокумента.ОтгрузочноеНаименование);
	XDTO_Установить(XDTO_Объект, "СостГруз", СтрокаДокумента.СостояниеГруза);
	Если ЗначениеЗаполнено(СтрокаДокумента.Плотность) Тогда
		XDTO_Установить_Плотн(XDTO_Объект, СтрокаДокумента.Плотность);
	КонецЕсли;
	XDTO_Установить(XDTO_Объект, "Объем", СтрокаДокумента.ОбъемКубМ);
	XDTO_Установить(XDTO_Объект, "КолМест", СтрокаДокумента.КоличествоМест, Истина); // можно отправлять 0 в разбивке грузов в Т3
	
	СтрокиМарикровкиПоТовару = ДокТитул3.Маркировки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаДокумента.ИдентификаторСтроки));
	Если СтрокиМарикровкиПоТовару.Количество() > 0 Тогда 
		Для Каждого СтрокаМаркировки Из СтрокиМарикровкиПоТовару Цикл 
			XDTO_Объект.ПерМарк.Добавить(СтрокаМаркировки.ЗначениеМаркировки);
		КонецЦикла;
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "МасГруз", XDTO_МассаТип(НомерТитула,
															,
															СтрокаДокумента.МассаБруттоКг,
															СтрокаДокумента.МассаНеттоКг,
															СтрокаДокумента.КоличествоПаллет));
	                                	
	Возврат	XDTO_Объект;
	
КонецФункции

Функция XDTO_СвПринПоНаимУчДок(НомерТитула, Формат = Неопределено, ДокТитул3, СтрокаСоответствияТоваров)
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГП.ПриемГрузГП.СвПринПоНаим");
	
	Если ЗначениеЗаполнено(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровОтправителя) Тогда 
		СтрокаОтправителя = ДокТитул3.Товары.Найти(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровОтправителя, "ИдентификаторСтроки");
	Иначе
		СтрокаОтправителя = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровПолучателя) Тогда 
		СтрокаПолучателя = ДокТитул3.ТоварыДокументаУчетнойСистемы.Найти(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровПолучателя, "ИдентификаторСтроки");
	Иначе
		СтрокаПолучателя = Неопределено;
	КонецЕсли;
	
	Если СтрокаОтправителя <> Неопределено Тогда 
		СтрокаДокументаОтправителяИлиПолучателя = СтрокаОтправителя;
	ИначеЕсли СтрокаПолучателя <> Неопределено Тогда
		СтрокаДокументаОтправителяИлиПолучателя = СтрокаПолучателя;
	Иначе
		ВызватьИсключение "Неожиданное состояние - не могу найти ни строку отправителя ни строку получателя";
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "НаимГруз", СтрокаДокументаОтправителяИлиПолучателя.ОтгрузочноеНаименование);
	XDTO_Установить(XDTO_Объект, "СостГруз", СтрокаДокументаОтправителяИлиПолучателя.СостояниеГруза);
	Если СтрокаОтправителя <> Неопределено И ЗначениеЗаполнено(СтрокаДокументаОтправителяИлиПолучателя.Плотность) Тогда 
		XDTO_Установить_Плотн(XDTO_Объект, СтрокаДокументаОтправителяИлиПолучателя.Плотность);
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "Объем", СтрокаСоответствияТоваров.ОбъемКубМ);
	XDTO_Установить(XDTO_Объект, "КолМест", СтрокаСоответствияТоваров.КоличествоМест, Истина); // можно отправлять 0 в разбивке грузов в Т3
	
	
	XDTO_Установить(XDTO_Объект, "МасГруз", XDTO_МассаТип(НомерТитула,
															,
															СтрокаСоответствияТоваров.МассаБруттоКг,
															СтрокаСоответствияТоваров.МассаНеттоКг,
															СтрокаСоответствияТоваров.КоличествоПаллет));
	                                	
	МассивУказанныхМаркировок = Новый Массив; // для контроля что уже положили в маркировки
	
	Если СтрокаОтправителя <> Неопределено Тогда 
		СтрокиМарикровкиПоТоваруОтправителя = ДокТитул3.Маркировки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаОтправителя.ИдентификаторСтроки));
		Если СтрокиМарикровкиПоТоваруОтправителя.Количество() > 0 Тогда 
			Для Каждого СтрокаМаркировки Из СтрокиМарикровкиПоТоваруОтправителя Цикл
				Если МассивУказанныхМаркировок.Найти(СтрокаМаркировки.ЗначениеМаркировки) = Неопределено Тогда 
					XDTO_Объект.ПерМарк.Добавить(СтрокаМаркировки.ЗначениеМаркировки);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
		
	Если СтрокаПолучателя <> Неопределено Тогда 
		СтрокиМарикровкиПоТоваруПолучателя = ДокТитул3.Маркировки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаПолучателя.ИдентификаторСтроки));
		Если СтрокиМарикровкиПоТоваруПолучателя.Количество() > 0 Тогда 
			Для Каждого СтрокаМаркировки Из СтрокиМарикровкиПоТоваруПолучателя Цикл 
				Если МассивУказанныхМаркировок.Найти(СтрокаМаркировки.ЗначениеМаркировки) = Неопределено Тогда 
					XDTO_Объект.ПерМарк.Добавить(СтрокаМаркировки.ЗначениеМаркировки);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
		
	Возврат	XDTO_Объект;
	
КонецФункции

Функция XDTO_ЦеннГрузТип(НомерТитула, ОбъявленнаяЦенность, Знач ВалютаКод, Знач ВалютаНаименованиеПолное, ТипДокументооборота = "__etrnTitle", Формат = "5.01")
	
	Перем XDTO_ЦеннГрузТип;
	
	Если ВалютаКод = "643" Тогда 
		ВалютаНаименованиеПолное = "Российский рубль";
	КонецЕсли;
	
	Если ТипДокументооборота = "__etrnTitle" Тогда 
		XDTO_ЦеннГрузТип = НовыйБазовыйОбъектXDTO(НомерТитула, "ЦеннГрузТип", ТипДокументооборота);
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		XDTO_ЦеннГрузТип = НовыйБазовыйОбъектXDTO(НомерТитула, "ЦеннГрузЗНТип", ТипДокументооборота);
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		XDTO_ЦеннГрузТип = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СвГруз.ОбщСтоимГруз", ТипДокументооборота);
	ИначеЕсли ТипДокументооборота = "__ForwardingReceipt" Тогда
		XDTO_ЦеннГрузТип = НовыйБазовыйОбъектXDTO(НомерТитула, "ЦеннГрузТип", ТипДокументооборота, Формат);
	Иначе
		ВызватьИсключение "непредполагаемый ТипДокументооборота в Функция XDTO_ЦеннГрузТип";
	КонецЕсли;
	
	XDTO_Установить(XDTO_ЦеннГрузТип, "СтЦеннГр", ОбъявленнаяЦенность);
	XDTO_Установить(XDTO_ЦеннГрузТип, "КодОКВ", ВалютаКод);
	XDTO_Установить(XDTO_ЦеннГрузТип, "НаимОКВ", ВалютаНаименованиеПолное);
	
	Возврат XDTO_ЦеннГрузТип;

КонецФункции

