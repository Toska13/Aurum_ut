	// ИнфПол
	Если ДокТитул2или5.ИнфПол.Количество() > 0 Тогда			
		ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, тегСодИнфМО, ТипДокументооборота, ДокТитул2или5.ИнфПол, XDTO_СодИнфМО);			
	КонецЕсли;
	
	// Если отказ, то добавим текстовое описание отказа в инф поля
	Если ДокТитул2или5.ЕстьОтказВПодписи Тогда
		ЗаписатьПричинуОтказаВИнфПоля(НомерТитула, Формат, тегСодИнфМО, ТипДокументооборота, XDTO_СодИнфМО, ДокТитул2или5);	
	КонецЕсли;
	
	Возврат XDTO_СодИнфМО;
	
КонецФункции

Функция XDTO_ПЛ_СодИнфТехСост(НомерТитула, Формат = Неопределено, ДокТитул3) Экспорт

	ТипДокументооборота = "__PL";
	
	XDTO_СодИнфТехСост = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфТехСост", ТипДокументооборота, Формат);
	
