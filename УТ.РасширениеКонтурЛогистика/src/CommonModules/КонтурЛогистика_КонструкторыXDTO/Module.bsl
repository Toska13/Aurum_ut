	// Сведения о контейнерах
	Для Каждого СтрокаКонтейнера Из ДокТитул68.Контейнеры Цикл 
		XDTO_СвКонтейн = XDTO_СВ_СвКонтейн(НомерТитула, , ДокТитул68, СтрокаКонтейнера);
		XDTO_СодСВИнфГП.СвКонтейн.Добавить(XDTO_СвКонтейн);
	КонецЦикла;
	
	// Сдача (прием) контейнера (выгрузка)
	XDTO_СдачКонтПогруз = XDTO_СдачКонтВыгр(ДокТитул68, НомерТитула, ТипДО);
	XDTO_Установить(XDTO_СодСВИнфГП, "СдачКонтВыгр", 	XDTO_СдачКонтПогруз);
	
	Возврат XDTO_СодСВИнфГП;
	
КонецФункции

Функция XDTO_СдачКонтПогрВыгр(Знач ДокТитул13579, Знач НомерТитула, Знач ТипДО)
	
	Перем XDTO_АдрМВ, XDTO_АдрМП, XDTO_СдачКонтПогрВыгр;
	
	XDTO_СдачКонтПогрВыгр = НовыйДочернийОбъектXDTO(НомерТитула, "СодСВИнфПрв.СдачКонтПогрВыгр", ТипДО);
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_ЭтоВыгрузкаКонтейнера(ДокТитул13579.ТипТитула) Тогда 
		Если ЗначениеЗаполнено(ДокТитул13579.ДатТСВыгр) Тогда 
			XDTO_Установить(XDTO_СдачКонтПогрВыгр, "ДатТСВыгр", XDTO_ДатаВремяВЗТип(ДокТитул13579.ДатТСВыгр));
			XDTO_Установить(XDTO_СдачКонтПогрВыгр, "НалКоорТочВрТСВыгр", "1");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокТитул13579.МестоВыгрузки) Тогда 
			XDTO_АдрМВ = XDTO_АдресПунктаМаршрута(ДокТитул13579.МестоВыгрузки, "1", ТипДО);
			XDTO_Установить(XDTO_СдачКонтПогрВыгр, "АдрМВ", XDTO_АдрМВ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_ЭтоПогрузкаКонтейнера(ДокТитул13579.ТипТитула) Тогда 
		Если ЗначениеЗаполнено(ДокТитул13579.ДатТСПогр) Тогда 
			XDTO_Установить(XDTO_СдачКонтПогрВыгр, "ДатТСПогр", XDTO_ДатаВремяВЗТип(ДокТитул13579.ДатТСПогр));
			XDTO_Установить(XDTO_СдачКонтПогрВыгр, "НалКоорТочВрТСПогр", "1");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокТитул13579.МестоПогрузки) Тогда 
			XDTO_АдрМП = XDTO_АдресПунктаМаршрута(ДокТитул13579.МестоПогрузки, "1", ТипДО);
			XDTO_Установить(XDTO_СдачКонтПогрВыгр, "АдрМП", XDTO_АдрМП);
		КонецЕсли;
		
	КонецЕсли;
	Возврат XDTO_СдачКонтПогрВыгр;

КонецФункции

