			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(НаимОИВ) Тогда 
			
			НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("НаименованиеОрганизацииПолное", СокрЛП(НаимОИВ));
			Если Не ЗначениеЗаполнено(НайденнаяОрганизация) Тогда 
				
				НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
				НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ОрганИсполнительнойВласти;
				НоваяОрганизация.Наименование = НаимОИВ;
				НоваяОрганизация.НаименованиеОрганизацииПолное = НоваяОрганизация.Наименование;
				НоваяОрганизация.Записать();
				ОрганизацияДиадок = НоваяОрганизация.Ссылка;
				
			Иначе
				
				ОрганизацияДиадок = НайденнаяОрганизация;
				
			КонецЕсли;
			
		ИначеЕсли ДаннИно <> Неопределено Тогда
			
			ОрганизацияДиадок = Конвертировать_СвИнНеУч_вОрганизациюДиадок(ДаннИно);
				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

Функция Конвертировать_СвТС_вТранспортноеСредствоЛогистика(XDTO_ТС, ЭтоПрицеп = Ложь) Экспорт
	
	ТСЛогистика = Справочники.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка();
	
	Если XDTO_ТС = Неопределено Тогда 
		Возврат ТСЛогистика;
	КонецЕсли;
	
	РегНомер = Конвертировать_РегНомер(XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "РегНомер"));
	Если ЗначениеЗаполнено(РегНомер) Тогда
		
		// Пробуем найти по РегНомер
		ТСЛогистика = Справочники.КонтурЛогистика_ТранспортныеСредства.НайтиПоРеквизиту("РегНомер", РегНомер);
		Если Не ЗначениеЗаполнено(ТСЛогистика) Тогда
			ТСЛогистика = НовоеТСПоXDTO(XDTO_ТС, ЭтоПрицеп);
		КонецЕсли;
		
	Иначе
		
		// Пробуем найти по ИнфНомер
		ИнвНомер = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "ИнвНомер");
		Если Не ЗначениеЗаполнено(ИнвНомер) Тогда
			Возврат ТСЛогистика;
		КонецЕсли;
		
		ТСЛогистика = Справочники.КонтурЛогистика_ТранспортныеСредства.НайтиПоРеквизиту("ИнвНомер", ИнвНомер);
		Если Не ЗначениеЗаполнено(ТСЛогистика) Тогда
			ТСЛогистика = НовоеТСПоXDTO(XDTO_ТС, ЭтоПрицеп);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТСЛогистика;
	
КонецФункции

Функция НовоеТСПоXDTO(XDTO_ТС, ЭтоПрицеп)
	
	НовоеТС = Справочники.КонтурЛогистика_ТранспортныеСредства.СоздатьЭлемент();
	НовоеТС.ЭтоПрицеп = ЭтоПрицеп;
	НовоеТС.РегНомер = Конвертировать_РегНомер(XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "РегНомер"));
	НовоеТС.ИнвНомер = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "ИнвНомер");
	
	НовоеТС.VIN = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "НомерВИН");
	НовоеТС.СТС = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "НомСТС");
	ТипВладXDTO = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "ТипВлад");
	Если ТипВладXDTO <> Неопределено Тогда	// "ТипВлад" нет в путевом листе
		НовоеТС.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.ЗначениеИзXDTO(ТипВладXDTO);
	КонецЕсли;
	НовоеТС.ТипТС = XDTO_Вычислить(XDTO_ТС, "ПарТС.Тип");
	НовоеТС.МаркаТС = XDTO_Вычислить(XDTO_ТС, "ПарТС.Марка");
	
	// Для путевых листов 5.02
	ТипТС = XDTO_Вычислить(XDTO_ТС, "Тип");
	Если ТипТС <> Неопределено Тогда
		
		ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.ЗначениеИзXDTO(ТипТС);
		Если ЗначениеЗаполнено(ТипТСПоКлассификатору) Тогда
			НовоеТС.ТипТСПоКлассификатору = ТипТСПоКлассификатору;
		Иначе
			НовоеТС.ТипТС = ТипТС;	
		КонецЕсли;
		НовоеТС.ИнойТипТС = XDTO_Вычислить(XDTO_ТС, "ИнойТип");
				
	КонецЕсли;
	МаркаТС = XDTO_Вычислить(XDTO_ТС, "Марка");
	Если МаркаТС <> Неопределено Тогда
		НовоеТС.МаркаТС = МаркаТС;
	КонецЕсли;
	НовоеТС.МодельТС = XDTO_Вычислить(XDTO_ТС, "Модель");
	НовоеТС.ИспользуетсяНесколькоВидовТоплива = ?(XDTO_Вычислить(XDTO_ТС, "ПризнТопл") = "2", Истина, Ложь);
		
	НовоеТС.ГрузоподъемностьТонн = XDTO_ВычислитьЧисло(XDTO_ТС, "ПарТС.Грузопод");
	НовоеТС.ВместимостьКубМ = XDTO_ВычислитьЧисло(XDTO_ТС, "ПарТС.Вместим");
	
	XDTO_ОснАрЛиз = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "ОснАрЛиз");
	Если XDTO_ОснАрЛиз <> Неопределено Тогда
		НовоеТС.ДоговорАрендаЛизинг = Конвертировать_РеквДокТип_вДоговорЛогистика(XDTO_ОснАрЛиз);
	КонецЕсли;
	
	// Для путевых листов 5.02
	XDTO_СвДокВлад = XDTO_ПолучитьЗначениеСвойства(XDTO_ТС, "СвДокВлад");
	Если XDTO_СвДокВлад <> Неопределено Тогда
		НовоеТС.ДоговорАрендаЛизинг = Конвертировать_РеквДокТип_вДоговорЛогистика(XDTO_СвДокВлад, "Рекв");
	КонецЕсли;
	
	НовоеТС.ДополнительныеСвойства.Вставить("ОтключитьПроверки", Истина);
	НовоеТС.Записать();
	
	Возврат НовоеТС.Ссылка;
	
КонецФункции

Функция Конвертировать_РегНомер(ИсходныйРегНомер)
	
	КонвертироватьВходящийГосНомерТСКириллицу = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"КонвертироватьВходящийГосНомерТСКириллицу");
	
	СимволыКириллицы = "АВСЕНКМОРТХУавсенкмортху";
	СимволыЛатиницы  = "ABCEHKMOPTXYabcehkmoptxy";
	
	РегНомер = ИсходныйРегНомер;
	
	// Не будем конвертировать номер, если есть не допустимые символы Латиницы в Российских номерах
	Если КонвертироватьВходящийГосНомерТСКириллицу
		И ЕстьСимолыЛатинициИностранныхНомеров(РегНомер) Тогда
		
		Возврат РегНомер;
	КонецЕсли;
	
	Для Счет = 1 По СтрДлина(СимволыКириллицы) Цикл
		
		ТекущийСимволКириллицы = Сред(СимволыКириллицы, Счет, 1);
		ТекущийСимволЛатиницы = Сред(СимволыЛатиницы, Счет, 1);
		
		Если КонвертироватьВходящийГосНомерТСКириллицу Тогда
			РегНомер = СтрЗаменить(РегНомер, ТекущийСимволЛатиницы, ТекущийСимволКириллицы);
		Иначе
			РегНомер = СтрЗаменить(РегНомер, ТекущийСимволКириллицы, ТекущийСимволЛатиницы);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РегНомер;
	
КонецФункции

Функция ЕстьСимолыЛатинициИностранныхНомеров(Знач ИсходныйРегНомер)
	
	Результат = Ложь;
	
	Буквы = "dfgijlnqrsuvwz";
	РегНомер = НРег(ИсходныйРегНомер);
	
	Для Счет = 1 По СтрДлина(Буквы) Цикл
		
		ТекущаяБуква = Сред(Буквы, Счет, 1);
		
		Если Найти(РегНомер, ТекущаяБуква) > 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Конвертировать_РабЛицПогрГр_вСотрудникаЛогистика(XDTO_РабЛицПогрГр) Экспорт
	
	СотрудникЛогистика = Справочники.КонтурЛогистика_Сотрудники.ПустаяСсылка();
	
	Если XDTO_РабЛицПогрГр <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтурЛогистика_Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
		|ГДЕ
		|	КонтурЛогистика_Сотрудники.Фамилия = &Фамилия
		|	И КонтурЛогистика_Сотрудники.Имя = &Имя
		|	И (КонтурЛогистика_Сотрудники.Отчество = &Отчество
		|			ИЛИ &Отчество = НЕОПРЕДЕЛЕНО)
		|	И КонтурЛогистика_Сотрудники.Должность = &Должность
		|	И (КонтурЛогистика_Сотрудники.ИныеСведения = &ИныеСведения
		|			ИЛИ &ИныеСведения = НЕОПРЕДЕЛЕНО)
		|	И НЕ КонтурЛогистика_Сотрудники.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Фамилия", 		XDTO_Вычислить(XDTO_РабЛицПогрГр, "ФИО.Фамилия"));
		Запрос.УстановитьПараметр("Имя", 			XDTO_Вычислить(XDTO_РабЛицПогрГр, "ФИО.Имя"));
		Запрос.УстановитьПараметр("Отчество", 		XDTO_Вычислить(XDTO_РабЛицПогрГр, "ФИО.Отчество"));
		Запрос.УстановитьПараметр("Должность", 		XDTO_Вычислить(XDTO_РабЛицПогрГр, "Должность"));
		Запрос.УстановитьПараметр("ИныеСведения", 	XDTO_Вычислить(XDTO_РабЛицПогрГр, "ИныеСвед"));
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			СотрудникЛогистика = Выборка.Ссылка;	
		
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СотрудникЛогистика) Тогда
			
			НовыйСторудник = Справочники.КонтурЛогистика_Сотрудники.СоздатьЭлемент();
			НовыйСторудник.Фамилия = XDTO_Вычислить(XDTO_РабЛицПогрГр, "ФИО.Фамилия");
			НовыйСторудник.Имя = XDTO_Вычислить(XDTO_РабЛицПогрГр, "ФИО.Имя");
			НовыйСторудник.Отчество = XDTO_Вычислить(XDTO_РабЛицПогрГр, "ФИО.Отчество");
			НовыйСторудник.Должность = XDTO_Вычислить(XDTO_РабЛицПогрГр, "Должность");
			НовыйСторудник.ИныеСведения = XDTO_Вычислить(XDTO_РабЛицПогрГр, "ИныеСвед");
			
			НовыйСторудник.Записать();
			
			СотрудникЛогистика = НовыйСторудник.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат СотрудникЛогистика;
	
КонецФункции

