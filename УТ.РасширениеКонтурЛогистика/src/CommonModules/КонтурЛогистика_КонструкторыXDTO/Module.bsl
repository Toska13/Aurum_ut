Процедура Заполнить_ПриемГрузГП(Знач XDTO_ПриемГрузГП, ДокТитул3, НомерТитула, Формат)
	
	Перем XDTO_СвПринПоНаим, СтрокаДокумента, СтрокаОтправителя, СтрокаПолучателя, СтрокаСоответствияТоваров;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т3ТоварыУчитыватьУчетныйДокумент") = Истина
		И ЗначениеЗаполнено(ДокТитул3.ДокументОснование) Тогда
		
		Если ДокТитул3.ТоварыСоответствиеСтрокТоваров.Количество() > 0 Тогда 
			
			Для Каждого СтрокаСоответствияТоваров Из ДокТитул3.ТоварыСоответствиеСтрокТоваров Цикл
				
				Если ЗначениеЗаполнено(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровОтправителя) Тогда 
					СтрокаОтправителя = ДокТитул3.Товары.Найти(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровОтправителя, "ИдентификаторСтроки");
				Иначе
					СтрокаОтправителя = Неопределено;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровПолучателя) Тогда 
					СтрокаПолучателя = ДокТитул3.ТоварыДокументаУчетнойСистемы.Найти(СтрокаСоответствияТоваров.ИдентификаторСтрокиТоваровПолучателя, "ИдентификаторСтроки");
				Иначе
					СтрокаПолучателя = Неопределено;
				КонецЕсли;
				
				Если (СтрокаОтправителя <> Неопределено ИЛИ СтрокаПолучателя <> Неопределено)
					И СтрокаСоответствияТоваров.КоличествоМест > 0 Тогда 
					
					XDTO_СвПринПоНаим = XDTO_СвПринПоНаимУчДок(НомерТитула, Формат, ДокТитул3, СтрокаСоответствияТоваров);
					XDTO_ПриемГрузГП.СвПринПоНаим.Добавить(XDTO_СвПринПоНаим)
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
		Если ДокТитул3.Товары.Количество() > 0 Тогда 
			Для Каждого СтрокаДокумента Из ДокТитул3.Товары Цикл
				Если СтрокаДокумента.Учитывать = Истина Тогда 
					
					XDTO_СвПринПоНаим = XDTO_СвПринПоНаимБезУчДок(НомерТитула, Формат, ДокТитул3, СтрокаДокумента);
					XDTO_ПриемГрузГП.СвПринПоНаим.Добавить(XDTO_СвПринПоНаим)
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

