Функция ПодготовитьТекстФайлаЛогистика(XDTO_Файл, Формат = "5.01") Экспорт
	
	// ОбъектXDTO.Проверить();
	
	ТипКодировки = "windows-1251";
	ИмяПакетаXDTO = XDTO_Файл.Тип().URIПространстваИмен;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ТипКодировки);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
	Фабрика.ЗаписатьXML(ЗаписьXML, XDTO_Файл, "Файл",,, НазначениеТипаXML.Неявное);
	
	ТекстЗапроса = ЗаписьXML.Закрыть();
	
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, ТекстЗапроса);
	
	Возврат ТекстЗапроса;

КонецФункции

Процедура СформироватьДокументыЛогистика(МассивФайловСсылок) Экспорт
	
	Для Каждого ФайлСсылка Из МассивФайловСсылок Цикл 
		
		Попытка
			
			ТекстФайла = ФайлСсылка.ТекстXML.Получить();
			Если СокрЛП(ТекстФайла) = "" Тогда 
				Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
				Продолжить;
			КонецЕсли;
			
			XDTO = ПолучитьXDTOпоXML(ТекстФайла);
			
			Если XDTO <> Неопределено Тогда 
				Если ЗначениеЗаполнено(ФайлСсылка.ТипДокумента) Тогда 
					ТипДокумента = ФайлСсылка.ТипДокумента;
				Иначе
					ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(XDTO.ИдФайл);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ТипДокумента) Тогда 
					Сообщить("По файлу " + ФайлСсылка + " не могу определить тип документа (номер титула)");
				Иначе
					
					КонтурЛогистика_ОбработкаДокументовСервер.НайтиСоздатьДокументыГлавныйИТитулПоФайлу(ФайлСсылка, ТипДокумента);
					
					ВариантПроверкиПолномочийМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВариантПроверкиПолномочийМЧД");	
					Если ВариантПроверкиПолномочийМЧД <> Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.НеПроверять Тогда
						КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьПолномочияУВходящейМЧД(ФайлСсылка, ТипДокумента);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			
			Сообщить("По файлу " + ФайлСсылка + " проблема с формированием документа Титула 1С: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция XDTO_ПолучитьЗначениеСвойстваСПроверкой(ОбъектXDTO, ИмяСвойства, ЗначениеПоУмолчанию) Экспорт
	
	ТекущееЗначение = XDTO_ПолучитьЗначениеСвойства(ОбъектXDTO, ИмяСвойства);
	
	Если ТекущееЗначение = Неопределено Тогда
		ТекущееЗначение = ЗначениеПоУмолчанию;
	КонецЕсли; 
	
	Возврат ТекущееЗначение;
	
КонецФункции

Функция XDTO_ПолучитьЗначениеСвойства(ОбъектXDTO, ИмяСвойства) Экспорт
	
	ТекЗначение = Неопределено;
	Если НЕ ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда
		Возврат ОбъектXDTO[ИмяСвойства];
	КонецЕсли;
	
	Возврат ТекЗначение;
	
КонецФункции

Функция XDTO_Вычислить(ОбъектXDTO, Путь) Экспорт 
	
	ТекущийЭлемент = ОбъектXDTO;
	
	ТипСписок = Тип("СписокXDTO");
	
	МассивСлов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(Путь, ".");
	
	Для Каждого ТекущийПуть Из МассивСлов Цикл
		
		Если ТекущийЭлемент = Неопределено Или ТипЗнч(ТекущийЭлемент) = ТипСписок Тогда
			ТекущийЭлемент = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТекущийЭлемент = XDTO_ПолучитьЗначениеСвойства(ТекущийЭлемент, ТекущийПуть);
		
	КонецЦикла;
	
	Возврат ТекущийЭлемент;

КонецФункции

Функция XDTO_ВычислитьЧисло(ОбъектXDTO, Путь) Экспорт 
	
	ТекущийЭлемент = ОбъектXDTO;
	
	ТипСписок = Тип("СписокXDTO");
	
	МассивСлов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(Путь, ".");
	
	Для Каждого ТекущийПуть Из МассивСлов Цикл
		
		Если ТекущийЭлемент = Неопределено Или ТипЗнч(ТекущийЭлемент) = ТипСписок Тогда
			ТекущийЭлемент = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТекущийЭлемент = XDTO_ПолучитьЗначениеСвойства(ТекущийЭлемент, ТекущийПуть);
		
	КонецЦикла;
	
	Если ТекущийЭлемент = Неопределено Тогда 
		ТекущийЭлемент = 0; 
	КонецЕсли;
	
	Возврат Число(ТекущийЭлемент);
	
КонецФункции

Функция XDTO_ВычислитьМассивXDTO(ОбъектИЛИСпискоXDTO) Экспорт
	
	МассивXDTO = Новый массив;
	Если ТипЗнч(ОбъектИЛИСпискоXDTO) = Тип("ОбъектXDTO") Тогда 
		МассивXDTO.Добавить(ОбъектИЛИСпискоXDTO);
	ИначеЕсли ТипЗнч(ОбъектИЛИСпискоXDTO) = Тип("Строка") Тогда
		МассивXDTO.Добавить(ОбъектИЛИСпискоXDTO);
	ИначеЕсли ТипЗнч(ОбъектИЛИСпискоXDTO) = Тип("СписокXDTO") Тогда
		Для Каждого ЭлементСпискаXDTO Из ОбъектИЛИСпискоXDTO Цикл
			МассивXDTO.Добавить(ЭлементСпискаXDTO);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ОбъектИЛИСпискоXDTO) = Тип("Массив") Тогда
		Возврат ОбъектИЛИСпискоXDTO; //уже массив
	КонецЕсли;
	
	Возврат МассивXDTO;
	
КонецФункции
// читает текст в XDTO глобальной фабрикой
Функция ПолучитьXDTOпоXML(ТекстФайла) Экспорт
	
	ЧтениеXML =	Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	Попытка
		
		ОбъектXDTO	= ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);	
		Возврат ОбъектXDTO;
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
КонецФункции

Процедура ДобавитьДополнительныхПолучателейФайла(XDTO_Файл, ДополнительныеПолучателиФайла) Экспорт

	Для Каждого стрДопПолучатель Из ДополнительныеПолучателиФайла Цикл 
		
		ИдПолИной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(стрДопПолучатель.ОрганизацияДиадок);
		XDTO_Файл.ИдПолИной.Добавить(ИдПолИной);
		
	КонецЦикла;

КонецПроцедуры

// функция удалит пустые свойства и вернет Истина, если ОбъектXDTO содержит хотя бы одно заполненное свойство
Функция УдалитьПустыеСвойстваXDTO(ОбъектXDTO) Экспорт 
	
	ЕстьЗаполненныеСвойства = Ложь;
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		
		Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
			
			ТекущееСвойствоЗаполнено = УдалитьПустыеСвойстваXDTO(ОбъектXDTO[Свойство.Имя]);
			
			Если НЕ ТекущееСвойствоЗаполнено Тогда
				ОбъектXDTO.Сбросить(Свойство.Имя);
			КонецЕсли;
			
			ЕстьЗаполненныеСвойства = ЕстьЗаполненныеСвойства или ТекущееСвойствоЗаполнено;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда
		
		Для Каждого ЭлементКоллекции Из ОбъектXDTO Цикл
			УдалитьПустыеСвойстваXDTO(ЭлементКоллекции);
		КонецЦикла;	
		
		ЕстьЗаполненныеСвойства = (ОбъектXDTO.Количество() > 0);  // если нет строк, то удалим этот тег
		
	Иначе  // уткнулись в конец ветки, в примитивный / ссылочный тип
		
		ЕстьЗаполненныеСвойства = (ЗначениеЗаполнено(ОбъектXDTO) и ОбъектXDTO <> 0);  // значение "0" не будем считать пустым
		
	КонецЕсли;
	
	Возврат ЕстьЗаполненныеСвойства;
	
КонецФункции


// #Область ПрикладныеXDTOобъекты

Функция XDTO_ФайлОбмена(НомерТитула, Формат = "5.01", ТипДокументооборота = "__etrnTitle") Экспорт
	
	ФабрикаXDTOНакладной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
	
	Если Не ЗначениеЗаполнено(НомерТитула) И ТипДокументооборота <> "__ForwardingReceipt" Тогда
		ВызватьИсключение "Не передан номер титула для генерации файла обмена";
	КонецЕсли;
	
	ТипОбъектаXDTO_Файл = ФабрикаXDTOНакладной.Пакеты.Получить(ТипДокументооборота + НомерТитула).КорневыеСвойства.Получить("Файл").Тип;
	XDTO_Файл = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO_Файл, Ложь);
	XDTO_Файл.ВерсПрог = "DiadocLogist1C " + КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	
	Если Формат = Неопределено Тогда 
		XDTO_Файл.ВерсФорм = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ФорматОбмена();
	Иначе
		XDTO_Файл.ВерсФорм = Формат;
	КонецЕсли;
	
	Возврат XDTO_Файл;
	
КонецФункции

Функция XDTO_ФайлОбменаУведомлений(ТитулСсылка, ГлавныйДокумент, Формат = "5.01", ТипДокументооборота = "__UvUtoch") Экспорт
	
	ФабрикаXDTOНакладной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
		
	ТипОбъектаXDTO_Файл = ФабрикаXDTOНакладной.Пакеты.Получить(ТипДокументооборота).КорневыеСвойства.Получить("Файл").Тип;
	XDTO_Файл = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO_Файл, Ложь);
	XDTO_Файл.ВерсПрог = "DiadocLogist1C " + КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	
	Если Формат = Неопределено Тогда 
		XDTO_Файл.ВерсФорм = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ФорматОбменаУведомленийОбУточнении();
	Иначе
		XDTO_Файл.ВерсФорм = Формат;
	КонецЕсли;
	
	ТипОбъектаXDTO_Документ = ФабрикаXDTOНакладной.Пакеты.Получить(ТипДокументооборота).КорневыеСвойства.Получить("Файл").Тип.Свойства.Получить("Документ").Тип;
	XDTO_Документ = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO_Документ, Истина);
		
	XDTO_Документ.КНД 		= "1115113";	
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ТитулСсылка) Тогда 
		
		ОргМедик = ГлавныйДокумент.ЛицоОформившееПЛ;
		Если ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияМедик) Тогда 
			ОргМедик = ГлавныйДокумент.ОрганизацияМедик;
		КонецЕсли;
		
		ЛицоУчастЭДО = ОргМедик;
		ЛицоОтпрДок = ГлавныйДокумент.ЛицоОформившееПЛ;
		
	Иначе // ТРН
		
		Если ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда 
			
			ЛицоУчастЭДО = ГлавныйДокумент.Перевозчик;
			ЛицоОтпрДок = ГлавныйДокумент.Грузоотправитель;
			
		Иначе //ТрН_Титул6
			
			ЛицоУчастЭДО = ГлавныйДокумент.Грузоотправитель;
			ЛицоОтпрДок = ГлавныйДокумент.Перевозчик;
			
		КонецЕсли;
		
	КонецЕсли;
	
	XDTO_УчастЭДО = XDTO_УчастЭДО(ЛицоУчастЭДО,, Формат);
	
	XDTO_Документ.УчастЭДО.ИдУчастЭДО = XDTO_УчастЭДО.ИдУчастЭДО;
	
	Если ЗначениеЗаполнено(XDTO_УчастЭДО.ИП.ИННФЛ) Тогда 
		XDTO_Документ.УчастЭДО.ИП.ИННФЛ = XDTO_УчастЭДО.ИП.ИННФЛ;
		ЗаполнитьЗначенияСвойств(XDTO_Документ.УчастЭДО.ИП.ФИО, XDTO_УчастЭДО.ИП.ФИО);
	Иначе 
		ЗаполнитьЗначенияСвойств(XDTO_Документ.УчастЭДО.ЮЛ, XDTO_УчастЭДО.ЮЛ);
	КонецЕсли;
	
	XDTO_ОтпрДок = XDTO_УчастЭДО(ЛицоОтпрДок,, Формат);
	
	XDTO_Документ.ОтпрДок.ИдУчастЭДО = XDTO_ОтпрДок.ИдУчастЭДО;
	
	Если ЗначениеЗаполнено(XDTO_ОтпрДок.ИП.ИННФЛ) Тогда 
		XDTO_Документ.ОтпрДок.ИП.ИННФЛ = XDTO_ОтпрДок.ИП.ИННФЛ;
		ЗаполнитьЗначенияСвойств(XDTO_Документ.ОтпрДок.ИП.ФИО, XDTO_ОтпрДок.ИП.ФИО);
	Иначе 
		ЗаполнитьЗначенияСвойств(XDTO_Документ.ОтпрДок.ЮЛ, XDTO_ОтпрДок.ЮЛ);
	КонецЕсли;
	
	XDTO_СвУведУточ = XDTO_СвУведУточ(ТитулСсылка,, Формат);
	
	XDTO_Документ.СвУведУточ = XDTO_СвУведУточ;
		
	XDTO_Файл.Документ = XDTO_Документ;
	
	Возврат XDTO_Файл;
	
КонецФункции

Функция ИдентификаторФайлаТитулаТРН(НомерТитула, ГО, ПВ, ГП, GUID, W = 0) Экспорт
	
	Если НомерТитула = 5 Или НомерТитула = 6 Тогда 
		
		// Формат ИдФайл титулов: R_Т_A_ _О__GGGGMMDD_N
		Шаблон = НСтр("ru = '%1_%2_ _%3_ _%4_%5'");
		
	Иначе	
		
		// Формат ИдФайл титулов: R_Т_A_E_О_W_GGGGMMDD_N
		Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6_%7'");
		
	КонецЕсли;

	ИдГО 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(ГО); 				
	ИдПер 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(ПВ); 		
	ИдГП	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(ГП);
	
	Если НомерТитула = 1 Тогда
		
		R_Т = "ON_TRNACLGROT";
		A	= ИдПер;
		E	= ИдГП;
		O 	= ИдГО;
				
	ИначеЕсли НомерТитула = 2 Тогда
		
		R_Т = "ON_TRNACLPPRIN";
		A	= ИдГП;
		E	= ИдГО;
		O 	= ИдПер;
			
	ИначеЕсли НомерТитула = 3 Тогда
		
		R_Т = "ON_TRNACLGRPO";
		A	= ИдПер;
		E	= ИдГО;
		O 	= ИдГП;
		
	ИначеЕсли НомерТитула = 4 Тогда
		
		R_Т = "ON_TRNACLPVYN";
		A	= ИдГП;
		E	= ИдГО;
		O 	= ИдПер;
		
	ИначеЕсли НомерТитула = 5 Тогда
		
		R_Т = "ON_TRNPUDPER";
		A	= ИдГО;
		O 	= ИдПер;
				
	ИначеЕсли НомерТитула = 6 Тогда
		
		R_Т = "ON_TRNPUDGO";
		A	= ИдПер;
		O 	= ИдГО;	
		
	ИначеЕсли НомерТитула = 7 Тогда
		
		R_Т = "ON_TRNPEREADR";
		A	= ИдГО;
		E 	= ИдГП;
		O 	= ИдПер;
		
	ИначеЕсли НомерТитула = 8 Тогда
		
		R_Т = "ON_TRNZAMEN";
		A	= ИдГО;
		E 	= ИдГП;
		O 	= ИдПер;
		
	Иначе
		
		ВызватьИсключение "Непредполагаемый номер титула транспортной накладной";
		
	КонецЕсли;
	
	GGGGMMDD 	= Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	N 			= GUID;
	
	Если НомерТитула = 5 Или НомерТитула = 6 Тогда
		
		ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон, R_Т, A, O, GGGGMMDD, N);
		
	Иначе
		
		ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон, R_Т, A, E, O, W, GGGGMMDD, N);
		
	КонецЕсли;

	Возврат ИдФайла;
	
КонецФункции	

Функция ИдентификаторыСторонИзИмениФайлаТитулаТРН(ИмяФайлаТитула) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Грузоотправитель", "");
	Результат.Вставить("Грузоперевозчик", "");
	Результат.Вставить("Грузополучатель", "");
	
	// Пример
	// ИмяФайлаТитула = ON_TRNACLGROT_2BM-8930148989-430401752-202203181037521108713_2BM-0177746613-083943828-202203181040243045820
	//  _2BM-4516065471-656245599-202203181036232312510_0_20230719_23dcde52-2302-45a9-b02e-5b502d532dd0.xml
	
	БлокиИмени = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ИмяФайлаТитула, "_");
	БлокТипаДокумента = БлокиИмени[1];
	БлокИдентификатора1 = БлокиИмени[2];
	БлокИдентификатора2 = БлокиИмени[3];
	Если БлокиИмени.Количество() > 3 Тогда
		БлокИдентификатора3 = БлокиИмени[4];
	Иначе
		БлокИдентификатора3 = "";
	КонецЕсли;
	Если БлокиИмени.Количество() > 4 Тогда
		БлокИдентификатора4 = БлокиИмени[5];
	Иначе
		БлокИдентификатора4 = "";
	КонецЕсли;
	
	Если БлокТипаДокумента = "TRNACLGROT" Тогда				// Титул 1
		
		Результат.Грузоотправитель = БлокИдентификатора3;
		Результат.Грузоперевозчик = БлокИдентификатора1;
		Результат.Грузополучатель = БлокИдентификатора2;
		
	ИначеЕсли БлокТипаДокумента = "TRNACLPPRIN" Тогда		// Титул 2
		
		Результат.Грузоотправитель = БлокИдентификатора2;
		Результат.Грузоперевозчик = БлокИдентификатора3;
		Результат.Грузополучатель = БлокИдентификатора1;
		
	ИначеЕсли БлокТипаДокумента = "TRNACLGRPO" Тогда		// Титул 3
		
		Результат.Грузоотправитель = БлокИдентификатора2;
		Результат.Грузоперевозчик = БлокИдентификатора1;
		Результат.Грузополучатель = БлокИдентификатора3;
		
	ИначеЕсли БлокТипаДокумента = "TRNACLPVYN" Тогда		// Титул 4
		
		Результат.Грузоотправитель = БлокИдентификатора2;
		Результат.Грузоперевозчик = БлокИдентификатора3;
		Результат.Грузополучатель = БлокИдентификатора1;
		
	ИначеЕсли БлокТипаДокумента = "TRNPUDPER" Тогда			// Титул 5
		
		Результат.Грузоотправитель = БлокИдентификатора1;
		Результат.Грузоперевозчик = БлокИдентификатора2;
		
	ИначеЕсли БлокТипаДокумента = "TRNPUDGO" Тогда			// Титул 6
		
		Результат.Грузоотправитель = БлокИдентификатора2;
		Результат.Грузоперевозчик = БлокИдентификатора1;
		
	ИначеЕсли БлокТипаДокумента = "TRNPEREADR" Тогда		// Титул 7
		
		Результат.Грузоотправитель = БлокИдентификатора1;
		Результат.Грузоперевозчик = БлокИдентификатора3;
		Результат.Грузополучатель = БлокИдентификатора2;
		
	ИначеЕсли БлокТипаДокумента = "TRNZAMEN" Тогда			// Титул 8
		
		Результат.Грузоотправитель = БлокИдентификатора1;
		Результат.Грузоперевозчик = БлокИдентификатора3;
		Результат.Грузополучатель = БлокИдентификатора2;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

