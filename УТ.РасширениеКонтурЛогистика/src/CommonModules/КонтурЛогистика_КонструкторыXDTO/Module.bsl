Функция XDTO_СвУчДокОбор(Знач ТипДокументооборота, НомерТитула, Формат, Отправитель, Получатель) Экспорт
	
	// Сведения об участниках электронного документооборота
	СвУчДокОбор = НовыйДочернийОбъектXDTO(НомерТитула, "СвУчДокОбор", ТипДокументооборота, Формат, Ложь);
	
	XDTO_Установить(СвУчДокОбор, "ИдОтпр", Отправитель.ИдентификаторУчастникаЭДО);
	XDTO_Установить(СвУчДокОбор, "ИдПол", Получатель.ИдентификаторУчастникаЭДО);
	
	// Сведения об операторе
	СвОЭДОтпр = НовыйДочернийОбъектXDTO(НомерТитула, "СвУчДокОбор.СвОЭДОтпр", ТипДокументооборота, Формат, Ложь);
	XDTO_Установить(СвОЭДОтпр, "НаимОрг", Отправитель.НаименованиеОрганизацииПолное);
	XDTO_Установить(СвОЭДОтпр, "ИННЮЛ", Отправитель.ИНН);
	XDTO_Установить(СвОЭДОтпр, "ИдЭДО", Лев(Отправитель.ИдентификаторУчастникаЭДО, 3));
	
	СвУчДокОбор.СвОЭДОтпр = СвОЭДОтпр;
	
	Возврат СвУчДокОбор;
	
КонецФункции

Функция XDTO_СодЭР(Знач ТипДокументооборота, НомерТитула, Формат, ДокументОбъект) Экспорт
	
	// Содержание экспедиторской расписки
	XDTO_СодЭР = НовыйДочернийОбъектXDTO(НомерТитула, "СодЭР", ТипДокументооборота, Формат);
	
	// Сведения о грузоотправителе	СвГО
	XDTO_СвГО = НовыйДочернийОбъектXDTO(НомерТитула, "СодЭР.СвГО", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СвГО, "РекИдентГО", XDTO_УчастникТрН(НомерТитула, Формат, ДокументОбъект.Грузоотправитель, ТипДокументооборота));
	XDTO_Установить(XDTO_СодЭР, "СвГО", XDTO_СвГО);
	
	// Сведения о заказчике транспортно-экспедиционных услуг
	Если ЗначениеЗаполнено(ДокументОбъект.Клиент) Тогда
		XDTO_СвКлиент = НовыйДочернийОбъектXDTO(НомерТитула, "СодЭР.СвКлиент", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_СвКлиент, "РекИдентКлиент", XDTO_УчастникТрН(НомерТитула, Формат, ДокументОбъект.Клиент, ТипДокументооборота));
		XDTO_Установить(XDTO_СодЭР, "СвКлиент", XDTO_СвКлиент);
	КонецЕсли;
	
	// Сведения об экспедиторе
	XDTO_СвЭксп = НовыйДочернийОбъектXDTO(НомерТитула, "СодЭР.СвЭксп", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СвЭксп, "РекИдентЭксп", XDTO_УчастникТрН(НомерТитула, Формат, ДокументОбъект.Экспедитор, ТипДокументооборота));
	XDTO_Установить(XDTO_СодЭР, "СвЭксп", XDTO_СвЭксп);
	
	// Сведения о грузе
	XDTO_СвГруз = XDTO_СвГруз(НомерТитула, Формат, ДокументОбъект, ТипДокументооборота);
	XDTO_Установить(XDTO_СодЭР, "СвГруз", XDTO_СвГруз);
	
	// ИнфПол
	Для Каждого СтрокаИнфПол Из ДокументОбъект.ИнфПол Цикл
		XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодЭР", ТипДокументооборота);
		XDTO_СодЭР.ИнфПол.Добавить(XDTO_ИнфПол);
	КонецЦикла;
	
	// Инфополя из доп реквизитов
	СписокДопРеквизитов = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.ИнфПол_СписокДопРеквизитов();
	
	ДопРеквизиты = Новый Структура;
	ДопРеквизиты_ЗаполнитьСтруктуруДопРеквизитовДокумента(ДокументОбъект, ДопРеквизиты, СписокДопРеквизитов);

	Если ДопРеквизиты.Количество() > 0 Тогда 
		XDTO_ПоместитьДопРеквизитыВИнфПол(XDTO_СодЭР.ИнфПол, ДопРеквизиты, НомерТитула, Формат, СтрокаИнфПол, "СодЭР", ТипДокументооборота);
	КонецЕсли;
	
	Возврат XDTO_СодЭР;
	
КонецФункции

Процедура ДопРеквизиты_ЗаполнитьСтруктуруДопРеквизитовДокумента(Знач ДокументОбъект, ДопРеквизиты, Знач СписокДопРеквизитов)
	
	Перем ДопРеквизитИмя, ДопРеквизитыСущность, ЗначениеВРеквизите, ЭлементСущности;
	
	Для Каждого ДопРеквизитИмя Из СписокДопРеквизитов Цикл 
		
		Попытка
			ЗначениеВРеквизите = ДокументОбъект[ДопРеквизитИмя];
		Исключение
			ЗначениеВРеквизите = Неопределено;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ЗначениеВРеквизите) Тогда
			
			Если ТипЗнч(ЗначениеВРеквизите) = Тип("Строка") 
				Или ТипЗнч(ЗначениеВРеквизите) = Тип("Булево")  
				Или ТипЗнч(ЗначениеВРеквизите) = Тип("Дата") 
				Или ТипЗнч(ЗначениеВРеквизите) = Тип("Число") Тогда 
				
				ДопРеквизиты.Вставить(ДопРеквизитИмя, Формат(ЗначениеВРеквизите, "ЧЦ=; ЧРД=.; ЧГ=; ДФ=dd.MM.yyyy"));
				
			ИначеЕсли ТипЗнч(ЗначениеВРеквизите) = Тип("ПеречислениеСсылка.КонтурЛогистика_СтавкиНДС") Тогда
				
				СериализованноеЗначение = Перечисления.КонтурЛогистика_СтавкиНДС.ПредставлениеСтавкиНДСПоЗначению(ЗначениеВРеквизите);
				ДопРеквизиты.Вставить(ДопРеквизитИмя, СериализованноеЗначение);
				
			Иначе
				
				Если ТипЗнч(ЗначениеВРеквизите) = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") Тогда
					ДопРеквизитыСущность = ДопРеквизиты_Инфпол_Сотрудник(ДопРеквизитИмя, ЗначениеВРеквизите);
				ИначеЕсли ТипЗнч(ЗначениеВРеквизите) = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства") Тогда
					ДопРеквизитыСущность = ДопРеквизиты_Инфпол_ТранспортноеСредство(ДопРеквизитИмя, ЗначениеВРеквизите);
				ИначеЕсли ТипЗнч(ЗначениеВРеквизите) = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда
					ДопРеквизитыСущность = ДопРеквизиты_Инфпол_ОрганизацияДиадок(ДопРеквизитИмя, ЗначениеВРеквизите);
				ИначеЕсли ТипЗнч(ЗначениеВРеквизите) = Тип("СправочникСсылка.КонтурЛогистика_Договоры") Тогда
					ДопРеквизитыСущность = ДопРеквизиты_Инфпол_Договор(ДопРеквизитИмя, ЗначениеВРеквизите);
				ИначеЕсли ТипЗнч(ЗначениеВРеквизите) = Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута") Тогда
					ДопРеквизитыСущность = ДопРеквизиты_Инфпол_ПунктМаршрута(ДопРеквизитИмя, ЗначениеВРеквизите);
				Иначе
					Сообщить("Не предусмотрено значение доп поля " + ТипЗнч(ЗначениеВРеквизите));
					ДопРеквизитыСущность = Новый Структура;
				КонецЕсли;
				
				Для каждого ЭлементСущности Из ДопРеквизитыСущность Цикл
					
					Если ЗначениеЗаполнено(ЭлементСущности.Значение) Тогда
						ДопРеквизиты.Вставить(ЭлементСущности.Ключ, Формат(ЭлементСущности.Значение, "ЧЦ=; ЧРД=.; ЧГ=; ДФ=dd.MM.yyyy"));
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ДопРеквизиты_Инфпол_Сотрудник(ДопРеквизитИмя, ЗначениеВРеквизите)

	СтруктураСущности = Новый Структура;
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_Фамилия", 			СокрЛП(ЗначениеВРеквизите.Фамилия));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_Имя", 				СокрЛП(ЗначениеВРеквизите.Имя));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_Отчество", 			СокрЛП(ЗначениеВРеквизите.Отчество));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_СНИЛС", 				СокрЛП(ЗначениеВРеквизите.СНИЛС));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ИНН", 				СокрЛП(ЗначениеВРеквизите.ИНН));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ДатаРождения", 		ЗначениеВРеквизите.ДатаРождения);
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ВУДатаВыдачи", 		ЗначениеВРеквизите.ВУДатаВыдачи);
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ВУНомер", 			СокрЛП(ЗначениеВРеквизите.ВУНомер));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ВУСерия", 			СокрЛП(ЗначениеВРеквизите.ВУСерия));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ТелефонОсновной", 	СокрЛП(ЗначениеВРеквизите.ТелефонОсновной));
	
	Возврат СтруктураСущности;

КонецФункции

Функция ДопРеквизиты_Инфпол_ТранспортноеСредство(ДопРеквизитИмя, ЗначениеВРеквизите)

	СтруктураСущности = Новый Структура;
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_РегНомер", 			СокрЛП(ЗначениеВРеквизите.РегНомер));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_СТС", 				СокрЛП(ЗначениеВРеквизите.СТС));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ТипТС", 				СокрЛП(ЗначениеВРеквизите.ТипТС));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ИнвНомер", 			СокрЛП(ЗначениеВРеквизите.ИнвНомер));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_МодельТС", 			СокрЛП(ЗначениеВРеквизите.МодельТС));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_МаркаТС", 			СокрЛП(ЗначениеВРеквизите.МаркаТС));
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ГрузоподъемностьТонн", ЗначениеВРеквизите.ГрузоподъемностьТонн);
	СтруктураСущности.Вставить(ДопРеквизитИмя + "_ВместимостьКубМ", 	ЗначениеВРеквизите.ВместимостьКубМ);
	
	Возврат СтруктураСущности;

КонецФункции

Функция ДопРеквизиты_Инфпол_ОрганизацияДиадок(ДопРеквизитИмя, ЗначениеВРеквизите)

	СтруктураСущности = Новый Структура;
