Функция ИдентификаторФайлаТитулаЭР(Получатель, Отправитель, GUID) Экспорт
	
	// Формат ИдФайл титулов: R_Т_A_О_GGGGMMDD_N
	//  R_Т – префикс FWDRECEIPT;
	//  А – идентификатор клиента получателя файла ЭР
	//  О – идентификатор экспедитора - отправителя файла ЭР
	//  GGGG – год формирования передаваемого файла обмена, MM - месяц, DD - день;
	//  N – 36 символьный глобально уникальный идентификатор GUID (Globally Unique IDentifier).
	Шаблон = НСтр("ru = '%1_%2_%3_%4_%5'");
	
	ИдПолучателя = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(Получатель);
	ИдОтпровителя = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИдентификаторУчастникаЭДО(Отправитель);
	
	R_Т = "FWDRECEIPT";
	A = ИдПолучателя;
	O = ИдОтпровителя;
	
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	N = GUID;
	
	ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон, R_Т, A, O, GGGGMMDD, N);
	
	Возврат ИдФайла;
	
КонецФункции

Функция XDTO_Документ(НомерТитула, ТипДокументооборота = "__etrnTitle", Формат = "5.01", XDTO_Подписант, ДатаФормирования, ВремяФормирования) Экспорт

	ФабрикаXDTOНакладной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
	
	ТипОбъектаXDTO_Документ = ФабрикаXDTOНакладной.Пакеты.Получить(ТипДокументооборота + НомерТитула).КорневыеСвойства.Получить("Файл").Тип.Свойства.Получить("Документ").Тип;
	XDTO_Объект = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO_Документ);
	
	Если ТипДокументооборота <> "__ForwardingReceipt" Тогда
		XDTO_Объект.КНД = КНД(ТипДокументооборота, НомерТитула, Формат);
	КонецЕсли;
	
	Если ТипДокументооборота = "__etrnTitle" Тогда
		XDTO_Объект.ПоФактХЖ = ПоФактХЖ(ТипДокументооборота, НомерТитула);
	КонецЕсли;
	
	Если ТипДокументооборота = "__etrnTitle" Тогда
		XDTO_Документ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования);
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		XDTO_ДокументЗН_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования);
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		XDTO_ДокументСВ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования);
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
		XDTO_ДокументЗЗ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования);
	ИначеЕсли ТипДокументооборота = "__PL" И Формат = "5.01" Тогда
		XDTO_ДокументПЛ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования, Формат);
	ИначеЕсли ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
		XDTO_ДокументПЛ_ЗаполнитьДатИнф_ВрИнф_5_02(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования, Формат);
	ИначеЕсли ТипДокументооборота = "__DF" Тогда
		XDTO_ДокументДФ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования);
	ИначеЕсли ТипДокументооборота = "__ForwardingReceipt" Тогда
		XDTO_ДокументЭР_ЗаполнитьДатаИнф_ВремяИнф(XDTO_Объект, ДатаФормирования, ВремяФормирования);
	КонецЕсли;
	
	Если ТипДокументооборота = "__ZZ" Тогда
		
		Если НомерТитула = 1 Тогда 
			XDTO_Установить(XDTO_Объект, "ПодпИнфГО", XDTO_Подписант);
		Иначе
			XDTO_Установить(XDTO_Объект, "ПодпИнфПрв", XDTO_Подписант);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__DF" Тогда
		
		Если НомерТитула = 1 Тогда 
			XDTO_Установить(XDTO_Объект, "ПодпДФИнфФт", XDTO_Подписант);
		Иначе
			XDTO_Установить(XDTO_Объект, "ПодпДФИнфФщ", XDTO_Подписант);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__PL" Тогда
		
		Если НомерТитула = 1 Тогда 
			XDTO_Установить(XDTO_Объект, "ПодпИнфСоб", XDTO_Подписант);
		ИначеЕсли НомерТитула = 2 Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфМО", XDTO_Подписант);
		ИначеЕсли НомерТитула = 3 И Формат = "5.01" Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфТехСост", XDTO_Подписант);
		ИначеЕсли НомерТитула = 3 И Формат = "5.02" Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфВыпуск", XDTO_Подписант);
		ИначеЕсли НомерТитула = 4 И Формат = "5.01" Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфВыезд", XDTO_Подписант);
		ИначеЕсли НомерТитула = 4 И Формат = "5.02" Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфВозвр", XDTO_Подписант);
		ИначеЕсли НомерТитула = 5 И Формат = "5.01" Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфЗаезд", XDTO_Подписант);
		ИначеЕсли НомерТитула = 5 И Формат = "5.02" Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфПМО", XDTO_Подписант);
		ИначеЕсли НомерТитула = 6 Тогда
			XDTO_Установить(XDTO_Объект, "ПодпИнфМО", XDTO_Подписант);
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__ForwardingReceipt" Тогда
		
		XDTO_Установить(XDTO_Объект, "Подписант", XDTO_Подписант);
		
	Иначе
		
		Если ТипЗнч(XDTO_Объект.Подписант) = Тип("СписокXDTO") Тогда 
			XDTO_Объект.Подписант.Добавить(XDTO_Подписант);
		Иначе
			XDTO_Установить(XDTO_Объект, "Подписант", XDTO_Подписант);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ДокументУведомления(ТитулСсылка, ДокументЭТРН, XDTO_Подписант, ТипДокументооборота = "__UvUtoch", Формат = "5.01") Экспорт

	ФабрикаXDTOНакладной = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КорневаяФабрикаXDTO(Формат);
	
	ТипОбъектаXDTO_Документ = ФабрикаXDTOНакладной.Пакеты.Получить(ТипДокументооборота).КорневыеСвойства.Получить("Файл").Тип.Свойства.Получить("Документ").Тип;
	XDTO_Объект = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO_Документ);
	
	XDTO_Объект.КНД 		= "1115113";
	
	Если ТипЗнч(XDTO_Объект.Подписант) = Тип("СписокXDTO") Тогда 
		
		XDTO_Объект.Подписант.Добавить(XDTO_Подписант);
		
	Иначе	
		
		XDTO_Установить(XDTO_Объект, "Подписант", 	XDTO_Подписант);
		
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "УчастЭДО", 	XDTO_УчастЭДО(ДокументЭТРН.Грузоотправитель));
	XDTO_Установить(XDTO_Объект, "СвУведУточ", 	XDTO_СвУведУточ(ТитулСсылка));
	XDTO_Установить(XDTO_Объект, "ОтпрДок", 	XDTO_УчастЭДО(ДокументЭТРН.Перевозчик));
	
	Возврат XDTO_Объект;
	
КонецФункции

Процедура XDTO_Документ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования)
	
	Если НомерТитула = 1 Тогда
		XDTO_Объект.ДатИнфГО 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфГО 	= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 2 Тогда
		XDTO_Объект.ДатИнфПрвПрием 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфПрвПрием 	= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 3 Тогда
		XDTO_Объект.ДатИнфГП 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфГП 	= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 4 Тогда
		XDTO_Объект.ДатИнфПрвВыд 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфПрвВыд 	= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 5 Тогда
		XDTO_Объект.ДатПУДИнфПрв 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрПУДИнфПрв 	= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 6 Тогда
		XDTO_Объект.ДатПУДИнфГО 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрПУДИнфГО 		= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 7 Тогда
		XDTO_Объект.ДатаИнфПА 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфПА 	= XDTO_ВремяТип(ВремяФормирования);
	ИначеЕсли НомерТитула = 8 Тогда
		XDTO_Объект.ДатИнфЗамен 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфЗамен 		= XDTO_ВремяТип(ВремяФормирования);
	Иначе
		ВызватьИсключение "Не поддерживается Заполнение ДатИнф и ВрИнф по титулу номер " + НомерТитула;
	КонецЕсли;
	
КонецПроцедуры

Процедура XDTO_ДокументЗН_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования)
	
	Если НомерТитула = 1 ИЛИ НомерТитула = 3 Тогда
		XDTO_Объект.ДатИнфФт 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфФт 	= XDTO_ВремяТип_Устар(ВремяФормирования);
	ИначеЕсли НомерТитула = 2 ИЛИ НомерТитула = 4 Тогда
		XDTO_Объект.ДатИнфФщ 	= XDTO_ДатаТип(ДатаФормирования);
		XDTO_Объект.ВрИнфФщ 	= XDTO_ВремяТип_Устар(ВремяФормирования);
	Иначе
		ВызватьИсключение "Не поддерживается Заполнение ДатИнф и ВрИнф в Заказ-наряде по титулу номер " + НомерТитула;
	КонецЕсли;
	
КонецПроцедуры

Процедура XDTO_ДокументДФ_ЗаполнитьДатИнф_ВрИнф(XDTO_Объект, НомерТитула, ДатаФормирования, ВремяФормирования)
	
	Если НомерТитула = 1  Тогда
		XDTO_Объект.ДатИнфФт 	= XDTO_ДатаТип(ДатаФормирования);
