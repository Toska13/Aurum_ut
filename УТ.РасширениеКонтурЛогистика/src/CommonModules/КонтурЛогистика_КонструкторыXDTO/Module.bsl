		КонецЦикла;
	КонецЕсли;
	
	// TODO ИнфПол Информационное поле
	
	Возврат XDTO_СодЗНИнфФщ;
	
КонецФункции

Функция XDTO_СодИнфГО(НомерТитула, Формат = "5.01", ДокТитул1) Экспорт

	ТипДокументооборота = "__etrnTitle";
	
	ДокументЭТРН = ДокТитул1.ДокументЭТРН;
	XDTO_СодИнфГО = НовыйДочернийОбъектXDTO(1, "СодИнфГО");
	XDTO_Установить(XDTO_СодИнфГО, "УИД_ТрН", 	ДокументЭТРН.УИД);
	XDTO_Установить(XDTO_СодИнфГО, "СодОпер", 	"Лицом, осуществляющим погрузку груза, при указанных обстоятельствах передан водителю груз с указанными характеристиками");
	XDTO_Установить(XDTO_СодИнфГО, "НомерТрН", 	ДокументЭТРН.НомерТрН);
	XDTO_Установить(XDTO_СодИнфГО, "ДатаТрН", 	XDTO_ДатаТип(ДокументЭТРН.ДатаТрН));
	
	НомерЗаказа = ДокументЭТРН.НомЗак;
	Если Не ЗначениеЗаполнено(НомерЗаказа) Тогда 
		НомерЗаказа = "Без номера";
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфГО, "НомЗак", 		НомерЗаказа);
	XDTO_Установить(XDTO_СодИнфГО, "ДатаЗак", 	XDTO_ДатаТип(ДокументЭТРН.ДатаЗак));
	
	ЗаказЗаявкаОснование = ДокументЭТРН.ЗаказЗаявкаОснование;
	
	Если ЗначениеЗаполнено(ДокументЭТРН) И ЗначениеЗаполнено(ЗаказЗаявкаОснование) Тогда 
		                      
		// Получить  ИдФайлЗак, ДатФайлЗак, ВрФайлЗак, base64_ЭП из ЗЗт1
		// (в формате нет указания что нужно именно из ЗЗт1 а не из ЗЗт2 но решили что лучше из ЗЗт1) 
		Файл1ТитулаЗЗ = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ЗаказЗаявкаОснование);
		
		Если ЗначениеЗаполнено(Файл1ТитулаЗЗ) Тогда
			
			ЗЗ_ИдФайлИнфГО 			= СтрЗаменить(Файл1ТитулаЗЗ.ИмяФайла, ".xml", "");
			ЗЗ_ДатФайлИнфГО 		= ЗаказЗаявкаОснование.ДатИнфГО;
			ЗЗ_ВрФайлИнфГО  		= ЗаказЗаявкаОснование.ВрИнфГО;
			ЗЗ_ДвоичныеДанныеПодписи = Файл1ТитулаЗЗ.Подпись.Получить();
			ЗЗ_ЭПГО 				= Base64Строка(ЗЗ_ДвоичныеДанныеПодписи);
			
			Если ЗначениеЗаполнено(ЗЗ_ИдФайлИнфГО)
				И ЗначениеЗаполнено(ЗЗ_ДатФайлИнфГО)
				И ЗначениеЗаполнено(ЗЗ_ВрФайлИнфГО)
				И ЗначениеЗаполнено(ЗЗ_ЭПГО) Тогда 
				
				XDTO_ИдЗак = НовыйДочернийОбъектXDTO(1, "СодИнфГО.ИдЗак");
				XDTO_Установить(XDTO_ИдЗак, "ИдФайлЗак", 	ЗЗ_ИдФайлИнфГО);
				XDTO_Установить(XDTO_ИдЗак, "ДатФайлЗак", 	XDTO_ДатаТип(ЗЗ_ДатФайлИнфГО));
				XDTO_Установить(XDTO_ИдЗак, "ВрФайлЗак", 	XDTO_ВремяТип(ЗЗ_ВрФайлИнфГО));
				XDTO_Установить(XDTO_ИдЗак, "ЭП", 			ЗЗ_ЭПГО);
				
				XDTO_Установить(XDTO_СодИнфГО, "ИдЗак", 	XDTO_ИдЗак);
				
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
	// исправление
	Если ЗначениеЗаполнено(ДокТитул1.НомИспр) Тогда 
		XDTO_ИспрТрН = НовыйДочернийОбъектXDTO(1, "СодИнфГО.ИспрТрН");
		XDTO_Установить(XDTO_ИспрТрН, "НомИспр", 	ДокТитул1.НомИспр);
		XDTO_Установить(XDTO_ИспрТрН, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул1.ДатаИспр));
		XDTO_Установить(XDTO_СодИнфГО, "ИспрТрН", 	XDTO_ИспрТрН);
	КонецЕсли;
	
	// Сведения о грузоотправителе	СвГО
	XDTO_СвГО = XDTO_СвГО(НомерТитула, Формат, ДокТитул1);
	XDTO_Установить(XDTO_СодИнфГО, "СвГО", 	XDTO_СвГО);
	
	// Сведения о заказчике услуг по организации перевозки груза, связанных с перевозкой груза	СвЗак
	
	Если ДокументЭТРН.ЭтоЭкспедиция = Истина Тогда 
		XDTO_СвЗак = XDTO_СвЗак(НомерТитула, Формат, ДокТитул1);
		XDTO_Установить(XDTO_СодИнфГО, "СвЗак", XDTO_СвЗак);
	КонецЕсли;
	
	// Сведения о грузополучателе	СвГП
	XDTO_СвГП = XDTO_СвГП(НомерТитула, , ДокТитул1);
	XDTO_Установить(XDTO_СодИнфГО, "СвГП", 	XDTO_СвГП);
	
	// Сведения о грузе  СвГруз
	XDTO_СвГруз = XDTO_СвГруз(НомерТитула, , ДокТитул1);
	XDTO_Установить(XDTO_СодИнфГО, "СвГруз", 	XDTO_СвГруз);
	
	// Сведения о сопроводительных документах на груз
	Если ДокТитул1.СопроводительныеДокументы.Количество() > 0 Тогда
		
		XDTO_СопрДок = XDTO_СопрДок(ДокТитул1, НомерТитула, ТипДокументооборота);
		XDTO_Установить(XDTO_СодИнфГО, "СопрДок", 	XDTO_СопрДок);
		
	КонецЕсли;
	
	// Сведения об указаниях грузоотправителя по особым условиям перевозки	УказГО
	XDTO_УказГО = XDTO_УказГО(НомерТитула, Формат, ДокТитул1);
	XDTO_Установить(XDTO_СодИнфГО, "УказГО", 	XDTO_УказГО);
	
	// Сведения о перевозчике	СвПер
	XDTO_СвПер = XDTO_СвПер(НомерТитула, Формат, ДокТитул1);
	XDTO_Установить(XDTO_СодИнфГО, "СвПер", 	XDTO_СвПер);
	
	// Сведения о водителе	СвВодит   (водителях)
	Массив_XDTO_СвВодит = Массив_XDTO_СвВодит(НомерТитула, , ДокТитул1);
	Для Каждого XDTO_Водитель Из  Массив_XDTO_СвВодит Цикл
		XDTO_СодИнфГО.СвВодит.Добавить(XDTO_Водитель);
	КонецЦикла;
	
	// Сведения о транспортном средстве	СвТС
	XDTO_СвТС = XDTO_СвТС(НомерТитула, Формат , ДокТитул1, ТипДокументооборота);
	XDTO_Установить(XDTO_СодИнфГО, "СвТС", 	XDTO_СвТС);
	
	// Сведения грузоотправителя о передаче груза при приеме груза перевозчиком	СвПогруз	
	XDTO_СвПогруз = XDTO_СвПогруз(НомерТитула, Формат , ДокТитул1);
	XDTO_Установить(XDTO_СодИнфГО, "СвПогруз", 	XDTO_СвПогруз);
	
	// ОтметГО
	Если ДокТитул1.ОтметкиГрузоотправителя.Количество() > 0 Тогда 
		Для Каждого СтрокаОтметГО Из ДокТитул1.ОтметкиГрузоотправителя Цикл
				
			XDTO_ОтметГО = XDTO_Отмет(НомерТитула, Формат, ДокТитул1, СтрокаОтметГО, "СодИнфГО.ОтметГО");
			XDTO_СодИнфГО.ОтметГО.Добавить(XDTO_ОтметГО)
				
		КонецЦикла;
	КонецЕсли;
	
	// ИнфПол (СодИнфГО, общие у титула)
	Если ДокТитул1.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул1.ИнфПол Цикл
				
				XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфГО");
				XDTO_СодИнфГО.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфГО;
	
КонецФункции

Функция XDTO_ЗЗ_СодИнфГО(НомерТитула, Формат = "5.01", ДокТитул1) Экспорт

	ТипДокументооборота = "__ZZ";
	
	XDTO_СодИнфГО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СодИнфГО, "УИД_Зак", 	ДокТитул1.УИД_Зак);
	XDTO_Установить(XDTO_СодИнфГО, "СодОпер", 	"Предоставление заказа и заявки на перевозку груза автомобильным транспортом");
	                                             
	НомерЗаказа = ДокТитул1.НомЗак;
	Если Не ЗначениеЗаполнено(НомерЗаказа) Тогда 
		НомерЗаказа = "Без номера";
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфГО, "НомЗак", 		НомерЗаказа);
	XDTO_Установить(XDTO_СодИнфГО, "ДатаЗак", 		XDTO_ДатаТип(ДокТитул1.ДатаЗак));
	
	УкНормПрвз = СокрЛП(ДокТитул1.УказанияВОтношенииНормПеревозки);
	Если УкНормПрвз = "" Тогда
		УкНормПрвз = "Отсутствуют";
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфГО, "УкНормПрвз", 	УкНормПрвз);
	
	XDTO_Установить(XDTO_СодИнфГО, "ПредСрПрвз", 	СокрЛП(ДокТитул1.ПредСрПрвз));
	
	ПрвзПищПрод = СокрЛП(ДокТитул1.ПрвзПищПрод);
	Если ПрвзПищПрод = "" Тогда
		ПрвзПищПрод = "Отсутствуют";
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфГО, "ПрвзПищПрод", 	ПрвзПищПрод);
	
	XDTO_Установить(XDTO_СодИнфГО, "ИныеУслв", 		СокрЛП(ДокТитул1.ИныеУслв));
	XDTO_Установить(XDTO_СодИнфГО, "КонПунктМрш", 	СокрЛП(ДокТитул1.КонПунктМрш));
	
	// ПромПунктМрш
	Для Каждого СтрокаДокумента Из ДокТитул1.ПромПунктМрш Цикл
		XDTO_СодИнфГО.ПромПунктМрш.Добавить(СокрЛП(СтрокаДокумента.ПромПунктМрш));
	КонецЦикла;
	
	// СвГО
	XDTO_СвГО = XDTO_УчастникТрН(НомерТитула, Формат, ДокТитул1.Грузоотправитель, ТипДокументооборота);
	XDTO_Установить(XDTO_СодИнфГО, "СвГО", 	XDTO_СвГО);
	
	// СвПрв
	XDTO_СвПрв = XDTO_УчастникТрН(НомерТитула, Формат, ДокТитул1.Перевозчик, ТипДокументооборота);
	XDTO_Установить(XDTO_СодИнфГО, "СвПрв", 	XDTO_СвПрв);
	
	// СвЛицГО   (необязательный)
	Для Каждого СтрокаДокументаСвЛицГО Из ДокТитул1.СвЛицГО Цикл
		
		XDTO_СвЛицГО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвЛицГО", ТипДокументооборота, Формат);
		
		// полномочие
		XDTO_Установить(XDTO_СвЛицГО, "Полн", Перечисления.КонтурЛогистика_ПолномочияДействий.ЗначениеДляXDTO(СтрокаДокументаСвЛицГО.Полномочие));
		
		// лицо
		XDTO_РеквЛицГО = XDTO_УчастникТрН(НомерТитула, Формат, СтрокаДокументаСвЛицГО.Участник, ТипДокументооборота);
		XDTO_Установить(XDTO_СвЛицГО, "РеквЛицГО", XDTO_РеквЛицГО);
		
		// документ
		Массив_XDTO_ИдРекСост = Новый Массив;
		Если ЗначениеЗаполнено(СтрокаДокументаСвЛицГО.ДокументСоставитель) Тогда 
			//XDTO_ИдРекСост = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.СвЛицГО.РеквДокПолн.ИдРекСост", ТипДокументооборота, Формат);
			XDTO_ИдРекСост = XDTO_ИдРекСостТип(НомерТитула, СтрокаДокументаСвЛицГО.ДокументСоставитель, ТипДокументооборота);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСост);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДокументаСвЛицГО.ДокументСоставитель2) Тогда 
			XDTO_ИдРекСост = XDTO_ИдРекСостТип(НомерТитула, СтрокаДокументаСвЛицГО.ДокументСоставитель2, ТипДокументооборота);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСост);
		КонецЕсли;
		
		XDTO_Установить(XDTO_СвЛицГО, "РеквДокПолн", XDTO_РеквДокТип(НомерТитула,
																		СтрокаДокументаСвЛицГО.ДокументНаименование,
																		СтрокаДокументаСвЛицГО.ДокументНомер,
																		СтрокаДокументаСвЛицГО.ДокументДата,
																		СтрокаДокументаСвЛицГО.ДокументИдДок,
																		СтрокаДокументаСвЛицГО.ДокументДопСведДок,
																		Массив_XDTO_ИдРекСост,
																		ТипДокументооборота,
																		Формат));
		
		
		XDTO_СодИнфГО.СвЛицГО.Добавить(XDTO_СвЛицГО);
		
	КонецЦикла;
	
	// ПунктПод
	XDTO_ПунктПод = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.ПунктПод", ТипДокументооборота, Формат);
	
	ЧасовойПоясПогрузки = ДокТитул1.ПунктПод.ЧасовойПояс;
	
	XDTO_Установить(XDTO_ПунктПод,	"ДатВрПод", 	XDTO_ДатаВремяВЗТип(ДокТитул1.ДатВрПод, ЧасовойПоясПогрузки));
	XDTO_Установить(XDTO_ПунктПод,	"НалКоорТочВрПод", 	"1");
	
	XDTO_Установить(XDTO_ПунктПод,	"ПредВрПод", XDTO_ВремяВЗТип(ДокТитул1.ПредВрПод, ЧасовойПоясПогрузки));
	XDTO_Установить(XDTO_ПунктПод,	"НалКоорТочПредВрПод", 	"1");
	
	XDTO_АдрПунктПод = XDTO_АдресПунктаМаршрута(ДокТитул1.ПунктПод, НомерТитула, ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ПунктПод,	"АдрПунктПод", 	XDTO_АдрПунктПод);
	
	XDTO_Установить(XDTO_СодИнфГО, "ПунктПод", 	XDTO_ПунктПод);
	
	// АдрПункт
	Для Каждого СтрокаДокументаАдрПункт Из ДокТитул1.АдрПункт Цикл
		
		ДобавитьАдрПункт(XDTO_СодИнфГО, НомерТитула, СтрокаДокументаАдрПункт, ТипДокументооборота, Формат);
			
	КонецЦикла;
	
	
	// ОпГруз
	Для Каждого СтрокаДокумента Из ДокТитул1.Товары Цикл
		
		Если СтрокаДокумента.Учитывать = Истина Тогда 
			
			XDTO_ОпГруз = XDTO_ОпГруз(НомерТитула, Формат , ДокТитул1, СтрокаДокумента, ТипДокументооборота);
			XDTO_СодИнфГО.ОпГруз.Добавить(XDTO_ОпГруз)
			
		КонецЕсли;
		
	КонецЦикла;
	
	// ПарТСПрвз
	XDTO_ПарТСПрвз = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.ПарТСПрвз", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_ПарТСПрвз, 	"Тип", 				ДокТитул1.ТСТип);
	XDTO_Установить(XDTO_ПарТСПрвз, 	"Грузопод", 		ДокТитул1.ТСГрузопод);
	XDTO_Установить(XDTO_ПарТСПрвз, 	"Вместим", 			ДокТитул1.ТСВместим);
	XDTO_Установить(XDTO_ПарТСПрвз, 	"ТипПогр", 			ДокТитул1.ТСТипПогр);
	XDTO_Установить(XDTO_ПарТСПрвз, 	"ТипКуз", 			ДокТитул1.ТСТипКуз);
	XDTO_Установить(XDTO_ПарТСПрвз, 	"ДрПарам", 			ДокТитул1.ТСДрПарам);
	
	XDTO_Установить(XDTO_СодИнфГО, "ПарТСПрвз", 	XDTO_ПарТСПрвз);
	
	// ТемпРеж
	Если ЗначениеЗаполнено(ДокТитул1.ТемператураНеНиже) Или ЗначениеЗаполнено(ДокТитул1.ТемператураНеВыше) Тогда 
		XDTO_ТемпРеж = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.ТемпРеж", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ТемпРеж, "ТемпНеНиже", 	ДокТитул1.ТемператураНеНиже);
		XDTO_Установить(XDTO_ТемпРеж, "ТемпНеВыше", 	ДокТитул1.ТемператураНеВыше);
		XDTO_Установить(XDTO_СодИнфГО, "ТемпРеж", 	XDTO_ТемпРеж);
	КонецЕсли;
	
	// ВлажнРеж	
	Если ЗначениеЗаполнено(ДокТитул1.ВлажностьНеНиже) Или ЗначениеЗаполнено(ДокТитул1.ВлажностьНеВыше) Тогда
		XDTO_ВлажнРеж = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.ВлажнРеж", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ВлажнРеж, "ВлажнНеНиже", 	ДокТитул1.ВлажностьНеНиже);
		XDTO_Установить(XDTO_ВлажнРеж, "ВлажнНеВыше", 	ДокТитул1.ВлажностьНеВыше);
		XDTO_Установить(XDTO_СодИнфГО, "ВлажнРеж", 	XDTO_ВлажнРеж);
	КонецЕсли;
	
	// TODO ИнфПол (СодИнфГО, общие у титула)
	Если ДокТитул1.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул1.ИнфПол Цикл
				
				XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфГО", ТипДокументооборота);
				XDTO_СодИнфГО.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфГО;
	
КонецФункции

Функция XDTO_ЗЗ_СодИнфПрв(НомерТитула, Формат = Неопределено, ДокТитул2) Экспорт

	ТипДокументооборота = "__ZZ";
	
	XDTO_СодИнфПрв = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрв", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СодИнфПрв, "УИД_Зак", 	ДокТитул2.УИД_Зак);
	
	Если Не ДокТитул2.ЕстьОтказВПодписи Тогда 
		
		XDTO_Установить(XDTO_СодИнфПрв, "СодОпер", "1");
		
		// СвЛицОргПрвз
		XDTO_СвЛицОргПрвз = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрв.СвЛицОргПрвз", ТипДокументооборота, Формат);
		
		Если ЗначениеЗаполнено(ДокТитул2.СвЛицОргПрвз.ТелефонОсновной) Тогда 
			XDTO_СвЛицОргПрвз.Тлф.Добавить(СокрЛП(ДокТитул2.СвЛицОргПрвз.ТелефонОсновной));
		КонецЕсли;
		Если ЗначениеЗаполнено(ДокТитул2.СвЛицОргПрвз.ТелефонЗапасной) Тогда 
			XDTO_СвЛицОргПрвз.Тлф.Добавить(СокрЛП(ДокТитул2.СвЛицОргПрвз.ТелефонЗапасной));
		КонецЕсли;
	
		XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрв.СвЛицОргПрвз.ФИО", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ДокТитул2.СвЛицОргПрвз.Фамилия);
		XDTO_Установить(XDTO_ФИО,	 "Имя",			ДокТитул2.СвЛицОргПрвз.Имя);
		XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ДокТитул2.СвЛицОргПрвз.Отчество);	
		XDTO_Установить(XDTO_СвЛицОргПрвз, "ФИО", XDTO_ФИО);
		
		XDTO_Установить(XDTO_СодИнфПрв, "СвЛицОргПрвз", XDTO_СвЛицОргПрвз);
		
		// СвВодит
		Для Каждого Водитель Из ДокТитул2.Водители Цикл 
			XDTO_СвВодит = XDTO_СвВодит(НомерТитула, Водитель.СвВодит, ТипДокументооборота, "СодИнфПрв.СвВодит", Формат);
			XDTO_СодИнфПрв.СвВодит.Добавить(XDTO_СвВодит);
		КонецЦикла;
		
		// СвТС
		XDTO_СвТС = XDTO_СвТС(НомерТитула, Формат, ДокТитул2, ТипДокументооборота);
		XDTO_Установить(XDTO_СодИнфПрв, "СвТС", XDTO_СвТС);
		
		// СвЛицПрв
		Если ЗначениеЗаполнено(ДокТитул2.СвЛицПрв) Тогда 
			XDTO_СвЛицПрв = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрв.СвЛицПрв", ТипДокументооборота, Формат);
			
			XDTO_Установить(XDTO_СвЛицПрв, "РеквЛицПрв", XDTO_УчастникТрН(НомерТитула, Формат, ДокТитул2.СвЛицПрв, ТипДокументооборота));
			
			Массив_XDTO_ИдРекСост = Новый Массив;
			Если ЗначениеЗаполнено(ДокТитул2.РеквДоверСоставитель) Тогда 
				XDTO_ИдРекСост = XDTO_ИдРекСостТип(НомерТитула, ДокТитул2.РеквДоверСоставитель, ТипДокументооборота);
				Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСост);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДокТитул2.РеквДоверСоставитель2) Тогда 
				XDTO_ИдРекСост = XDTO_ИдРекСостТип(НомерТитула, ДокТитул2.РеквДоверСоставитель2, ТипДокументооборота);
				Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСост);
			КонецЕсли;
			
			XDTO_Установить(XDTO_СвЛицПрв, "РеквДовер", XDTO_РеквДокТип(НомерТитула,
																				ДокТитул2.РеквДоверНаименование,
																				ДокТитул2.РеквДоверНомер,
																				ДокТитул2.РеквДоверДата,
																				ДокТитул2.РеквДоверИдДок,
																				ДокТитул2.РеквДоверДопСведДок,
																				Массив_XDTO_ИдРекСост,
																				ТипДокументооборота,
																				Формат));	
			
			XDTO_Установить(XDTO_СодИнфПрв, "СвЛицПрв", XDTO_СвЛицПрв);
		КонецЕсли;
		
		// РазмПлатРасчет
		XDTO_РазмПлатРасчет = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфПрв.РазмПлатРасчет", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_РазмПлатРасчет, "КодОКВ", 	"643");
		XDTO_Установить(XDTO_РазмПлатРасчет, "ВалНаим", 	"Российский рубль");
		
		Если ЗначениеЗаполнено(ДокТитул2.Расчет) Тогда 
			XDTO_Установить(XDTO_РазмПлатРасчет, "Расчет", ДокТитул2.Расчет);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокТитул2.СтТовБезНДС)
			Или ЗначениеЗаполнено(ДокТитул2.СтТовУчНал) Тогда
			XDTO_Установить(XDTO_РазмПлатРасчет, "СтТовБезНДС", ДокТитул2.СтТовБезНДС);
			XDTO_УстановитьСУсловием(XDTO_РазмПлатРасчет, "СтТовУчНал", ДокТитул2.СтТовУчНал);
			
			СтавкаНДС = Перечисления.КонтурЛогистика_СтавкиНДС.ПредставлениеСтавкиНДСПоЗначению(ДокТитул2.НалСт);
			XDTO_Установить(XDTO_РазмПлатРасчет, "НалСт", СтавкаНДС);
		КонецЕсли;	
			
		XDTO_Установить(XDTO_СодИнфПрв, "РазмПлатРасчет", XDTO_РазмПлатРасчет);
		
	Иначе
		XDTO_Установить(XDTO_СодИнфПрв, "СодОпер", "2");
		XDTO_Установить(XDTO_СодИнфПрв, "ПричОтк", ДокТитул2.ПричинаОтказаВПодписи);
	КонецЕсли;	
	
	// TODO ИнфПол (СодИнфГО, общие у титула)
	Если ДокТитул2.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул2.ИнфПол Цикл
				
				XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфПрв", ТипДокументооборота);
				XDTO_СодИнфПрв.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфПрв;
	
КонецФункции

Функция XDTO_ПЛ_СодИнфСоб(НомерТитула, Формат = "5.01", ДокТитул1) Экспорт

	ТипДокументооборота = "__PL";
	
	XDTO_СодИнфСоб = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СодИнфСоб, "УИД_ПЛ", 		ДокТитул1.УИД_ПЛ);
	
	XDTO_Установить(XDTO_СодИнфСоб, "ОбМедОсмПосле", ?(ДокТитул1.ОбязМедосмотрПосле, "1", "2"));
	
	XDTO_Установить(XDTO_СодИнфСоб, "ВидПрв", Перечисления.КонтурЛогистика_ВидыПеревозки.ЗначениеДляXDTO(ДокТитул1.ВидПеревозки));
	
	Если ДокТитул1.ВидПеревозки = Перечисления.КонтурЛогистика_ВидыПеревозки.КП Тогда
		
		ВидКП = Перечисления.КонтурЛогистика_ВидыКоммерческихПеревозок.ЗначениеДляXDTO(ДокТитул1.ВидКоммерческойПеревозки);
		XDTO_Установить(XDTO_СодИнфСоб, "ВидКП", ВидКП);
		
		Если ДокТитул1.ВидКоммерческойПеревозки = Перечисления.КонтурЛогистика_ВидыКоммерческихПеревозок.ПГ Тогда
			
			XDTO_МестоОтправления = XDTO_АдресПунктаМаршрута(ДокТитул1.МестоОтправления, НомерТитула, ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_СодИнфСоб, "МестОтпр", XDTO_МестоОтправления);
			
			// АдрПункт
			Для Каждого СтрокаДокументаАдрПункт Из ДокТитул1.АдресаПунктов Цикл
				XDTO_АдрПункт = XDTO_АдресПунктаМаршрута(СтрокаДокументаАдрПункт.ПунктМаршрута, НомерТитула, ТипДокументооборота, Формат);
				XDTO_СодИнфСоб.АдрПункт.Добавить(XDTO_АдрПункт);
			КонецЦикла;
			
			// Если нет маршрута - скопируем туда место отправления
			Если ДокТитул1.АдресаПунктов.Количество() = 0 Тогда 
				XDTO_АдрПункт = XDTO_АдресПунктаМаршрута(ДокТитул1.МестоОтправления, НомерТитула, ТипДокументооборота, Формат);
				XDTO_СодИнфСоб.АдрПункт.Добавить(XDTO_АдрПункт);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодИнфСоб, "ВидСообщ", Перечисления.КонтурЛогистика_ВидыПутейСообщений.ЗначениеДляXDTO(ДокТитул1.ВидСообщения));
	
	XDTO_СрокПЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СрокПЛ", ТипДокументооборота, Формат);
	
	Если Не ЗначениеЗаполнено(ДокТитул1.СрокПЛИнтервал) Тогда
		// не указан интервал - это ПЛ на 1 день
		XDTO_Установить(XDTO_СрокПЛ, "ПЛДень", 		"1");
		XDTO_Установить(XDTO_СрокПЛ, "ДатаИспПЛ", 	XDTO_ДатаТип(ДокТитул1.СрокПЛ));
	Иначе
		// указан интервал дат ПЛ
		XDTO_Установить(XDTO_СрокПЛ, "ПЛДень", 		"2");
		XDTO_Установить(XDTO_СрокПЛ, "ДатаНачИспПЛ", 	XDTO_ДатаТип(ДокТитул1.СрокПЛ));
		XDTO_Установить(XDTO_СрокПЛ, "ДатаКонИспПЛ", 	XDTO_ДатаТип(ДокТитул1.СрокПЛИнтервал));
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфСоб, "СрокПЛ", 		XDTO_СрокПЛ);
	
	XDTO_СвЛицПЛ = XDTO_ПЛ_СвЛицПл(ДокТитул1, НомерТитула, ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СодИнфСоб, "СвЛицПЛ", 		XDTO_СвЛицПЛ);
	
	Если ЗначениеЗаполнено(ДокТитул1.Грузоотправитель) Тогда 
		
		XDTO_СодИнфСоб.СвГО.Добавить(XDTO_УчастникТрН(НомерТитула, Формат, ДокТитул1.Грузоотправитель, ТипДокументооборота));
		
		Для Каждого СтрокаДопГрузополучателя Из ДокТитул1.ДополнительныеГрузоотправители Цикл 
			Если ЗначениеЗаполнено(СтрокаДопГрузополучателя.Грузоотправитель) Тогда 
				XDTO_СодИнфСоб.СвГО.Добавить(XDTO_УчастникТрН(НомерТитула, Формат, СтрокаДопГрузополучателя.Грузоотправитель, ТипДокументооборота));
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// СвТС
	XDTO_СвТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС", ТипДокументооборота, Формат);
	
	XDTO_ТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.ТС", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ТС, 	"Тип", 			ДокТитул1.ТранспортноеСредство.ТипТС);
	XDTO_Установить(XDTO_ТС, 	"Марка", 		ДокТитул1.ТранспортноеСредство.МаркаТС);
	XDTO_Установить(XDTO_ТС, 	"Модель", 		ДокТитул1.ТранспортноеСредство.МодельТС);
	XDTO_Установить(XDTO_ТС, 	"РегНомер", 	ДокТитул1.ТранспортноеСредство.РегНомер);
	XDTO_Установить(XDTO_ТС, 	"ИнвНомер", 	ДокТитул1.ТранспортноеСредство.ИнвНомер);
	XDTO_Установить(XDTO_СвТС, "ТС", XDTO_ТС);
	
	Если ЗначениеЗаполнено(ДокТитул1.Прицеп) Тогда 
		XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.Прицеп", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Прицеп, 	"Марка", 		ДокТитул1.Прицеп.МаркаТС);
		XDTO_Установить(XDTO_Прицеп, 	"Модель", 		ДокТитул1.Прицеп.МодельТС);
		XDTO_Установить(XDTO_Прицеп, 	"РегНомер", 	ДокТитул1.Прицеп.РегНомер);
		XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитул1.Прицеп2) Тогда 
		XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.Прицеп", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Прицеп, 	"Марка", 		ДокТитул1.Прицеп2.МаркаТС);
		XDTO_Установить(XDTO_Прицеп, 	"Модель", 		ДокТитул1.Прицеп2.МодельТС);
		XDTO_Установить(XDTO_Прицеп, 	"РегНомер", 	ДокТитул1.Прицеп2.РегНомер);
		XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп);
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодИнфСоб, "СвТС", XDTO_СвТС);

	// СвВодит
	XDTO_СодИнфСоб.СвВодит.Добавить(XDTO_СвВодит(НомерТитула, ДокТитул1.Водитель, ТипДокументооборота, ,Формат));
	Если ЗначениеЗаполнено(ДокТитул1.Водитель)
		И ЗначениеЗаполнено(ДокТитул1.Водитель.СНИЛС) Тогда
		
		Водитель = ДокТитул1.Водитель;
		ФамилияИО = Водитель.Фамилия + " " + Лев(Водитель.Имя, 1) + "." + ?(Водитель.Отчество = "", "", " " + Лев(Водитель.Отчество, 1) + ".");
		СтруктураИнфПол = Новый Структура("Идентиф, Значение", "СНИЛС " + ФамилияИО , Водитель.СНИЛС);
		XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтруктураИнфПол, "СодИнфСоб", ТипДокументооборота);
		XDTO_СодИнфСоб.ИнфПол.Добавить(XDTO_ИнфПол);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитул1.Водитель2) Тогда
		XDTO_СодИнфСоб.СвВодит.Добавить(XDTO_СвВодит(НомерТитула, ДокТитул1.Водитель2, ТипДокументооборота, ,Формат));
		Если ЗначениеЗаполнено(ДокТитул1.Водитель2)
			И ЗначениеЗаполнено(ДокТитул1.Водитель2.СНИЛС) Тогда
			
			Водитель = ДокТитул1.Водитель2;
			ФамилияИО = Водитель.Фамилия + " " + Лев(Водитель.Имя, 1) + "." + ?(Водитель.Отчество = "", "", " " + Лев(Водитель.Отчество, 1) + ".");
			СтруктураИнфПол = Новый Структура("Идентиф, Значение", "СНИЛС " + ФамилияИО , Водитель.СНИЛС);
			XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтруктураИнфПол, "СодИнфСоб", ТипДокументооборота);
			XDTO_СодИнфСоб.ИнфПол.Добавить(XDTO_ИнфПол);
			
		КонецЕсли;
	КонецЕсли;
		
	Для Каждого СтрокаДопВодителя Из ДокТитул1.ДополнительныеВодители Цикл 
		Если ЗначениеЗаполнено(СтрокаДопВодителя.Водитель) Тогда 
			XDTO_СодИнфСоб.СвВодит.Добавить(XDTO_СвВодит(НомерТитула, СтрокаДопВодителя.Водитель, ТипДокументооборота, ,Формат));
		КонецЕсли;
	КонецЦикла;
	
	// ИнфПол
	Если ДокТитул1.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул1.ИнфПол Цикл
				
			XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфСоб", ТипДокументооборота);
			XDTO_СодИнфСоб.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфСоб;
	
КонецФункции

Функция XDTO_ПЛ_СодИнфСоб_5_02(НомерТитула, Формат = "5.02", ДокТитул1) Экспорт

	ТипДокументооборота = "__PL";
	
	XDTO_СодИнфСоб = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СодИнфСоб, "УИД_ПЛ", 		ДокТитул1.УИД_ПЛ);
	
	XDTO_Установить(XDTO_СодИнфСоб, "ОбМедОсмПосле", ?(ДокТитул1.ОбязМедосмотрПосле, "1", "2"));
	
	XDTO_Установить(XDTO_СодИнфСоб, "ВидПрв", Перечисления.КонтурЛогистика_ВидыПеревозки.ЗначениеДляXDTO(ДокТитул1.ВидПеревозки));
			
	Если ДокТитул1.ВидПеревозки = Перечисления.КонтурЛогистика_ВидыПеревозки.КП Тогда		
		ВидКП = Перечисления.КонтурЛогистика_ВидыКоммерческихПеревозок.ЗначениеДляXDTO(ДокТитул1.ВидКоммерческойПеревозки);
		XDTO_Установить(XDTO_СодИнфСоб, "ВидКП", ВидКП);		
	КонецЕсли;
	
	XDTO_СодИнфСоб.ВидСообщ.Добавить(Перечисления.КонтурЛогистика_ВидыПутейСообщений.ЗначениеДляXDTO(ДокТитул1.ВидСообщения));  
	
	XDTO_СрокПЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СрокПЛ", ТипДокументооборота, Формат);
	
	Если Не ЗначениеЗаполнено(ДокТитул1.СрокПЛИнтервал) Тогда
		// не указан интервал - это ПЛ на 1 день
		XDTO_Установить(XDTO_СрокПЛ, "ПЛДень", 		"1");
		XDTO_Установить(XDTO_СрокПЛ, "ДатаИспПЛ", 	XDTO_ДатаТип(ДокТитул1.СрокПЛ));
	Иначе
		// указан интервал дат ПЛ
		XDTO_Установить(XDTO_СрокПЛ, "ПЛДень", 		"2");
		XDTO_Установить(XDTO_СрокПЛ, "ДатаНачИспПЛ", 	XDTO_ДатаТип(ДокТитул1.СрокПЛ));
		XDTO_Установить(XDTO_СрокПЛ, "ДатаКонИспПЛ", 	XDTO_ДатаТип(ДокТитул1.СрокПЛИнтервал));
	КонецЕсли;
	XDTO_Установить(XDTO_СодИнфСоб, "СрокПЛ", 		XDTO_СрокПЛ);
	
	XDTO_СвЛицПЛ = XDTO_ПЛ_СвЛицПл(ДокТитул1, НомерТитула, ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_СодИнфСоб, "СвЛицПЛ", 		XDTO_СвЛицПЛ);
		
	// СвТС
	XDTO_СвТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС", ТипДокументооборота, Формат);
	
	XDTO_ТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.ТС", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_ТС, "Тип", 	Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.ЗначениеДляXDTO(ДокТитул1.ТранспортноеСредство.ТипТСПоКлассификатору));
	XDTO_Установить(XDTO_ТС, "ТипВлад", Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.ЗначениеДляXDTO(ДокТитул1.ТранспортноеСредство.ВидВладения));
	Если ДокТитул1.ТранспортноеСредство.ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.Иной Тогда
		XDTO_Установить(XDTO_ТС, "ИнойТип", ДокТитул1.ТранспортноеСредство.ИнойТипТС);
	КонецЕсли;
	Если ДокТитул1.ТранспортноеСредство.ИспользуетсяНесколькоВидовТоплива Тогда
		XDTO_Установить(XDTO_ТС, "ПризнТопл", "2");
	Иначе
		XDTO_Установить(XDTO_ТС, "ПризнТопл", "1");
	КонецЕсли;
		
	XDTO_Установить(XDTO_ТС, 	"Марка", 		ДокТитул1.ТранспортноеСредство.МаркаТС);
	XDTO_Установить(XDTO_ТС, 	"Модель", 		ДокТитул1.ТранспортноеСредство.МодельТС);
	XDTO_Установить(XDTO_ТС, 	"РегНомер", 	ДокТитул1.ТранспортноеСредство.РегНомер);
	XDTO_Установить(XDTO_ТС, 	"ИнвНомер", 	ДокТитул1.ТранспортноеСредство.ИнвНомер);
	
	Если Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.ДляВидаВладенияТребуетсяУказатьДоговор(ДокТитул1.ТранспортноеСредство.ВидВладения) Тогда			
		XDTO_РеквДокТип = XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, ДокТитул1.ТранспортноеСредство.ДоговорАрендаЛизинг, ТипДокументооборота, Формат); 
		XDTO_ТС.СвДокВлад.Добавить(XDTO_РеквДокТип);		
	КонецЕсли;
	
	XDTO_Установить(XDTO_СвТС, "ТС", XDTO_ТС);
	
	Если ЗначениеЗаполнено(ДокТитул1.Прицеп) Тогда 
		XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.Прицеп", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Прицеп, 	"Марка", 		ДокТитул1.Прицеп.МаркаТС);
		XDTO_Установить(XDTO_Прицеп, 	"Модель", 		ДокТитул1.Прицеп.МодельТС);
		XDTO_Установить(XDTO_Прицеп, 	"РегНомер", 	ДокТитул1.Прицеп.РегНомер);
		XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокТитул1.Прицеп2) Тогда 
		XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.Прицеп", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Прицеп, 	"Марка", 		ДокТитул1.Прицеп2.МаркаТС);
		XDTO_Установить(XDTO_Прицеп, 	"Модель", 		ДокТитул1.Прицеп2.МодельТС);
		XDTO_Установить(XDTO_Прицеп, 	"РегНомер", 	ДокТитул1.Прицеп2.РегНомер);
		XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп);
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодИнфСоб, "СвТС", XDTO_СвТС);
	
	// Водители
	XDTO_СодИнфСоб.СвВодит.Добавить(XDTO_СвВодит(НомерТитула, ДокТитул1.Водитель, ТипДокументооборота,, Формат));
	Если ЗначениеЗаполнено(ДокТитул1.Водитель2) Тогда
		XDTO_СодИнфСоб.СвВодит.Добавить(XDTO_СвВодит(НомерТитула, ДокТитул1.Водитель2, ТипДокументооборота,, Формат));		
	КонецЕсли;
	
	Для Каждого СтрокаДопВодителя Из ДокТитул1.ДополнительныеВодители Цикл 
		Если ЗначениеЗаполнено(СтрокаДопВодителя.Водитель) Тогда 
			XDTO_СодИнфСоб.СвВодит.Добавить(XDTO_СвВодит(НомерТитула, СтрокаДопВодителя.Водитель, ТипДокументооборота, ,Формат));
		КонецЕсли;
	КонецЦикла;
	
	//СвГосСист
	XDTO_Установить(XDTO_СодИнфСоб, "УчГосСист", ?(ДокТитул1.СведенияГосСистем.Количество() > 0, "1", "0"));
		
	Если ДокТитул1.СведенияГосСистем.Количество() > 0 Тогда 
		
		тз = ДокТитул1.СведенияГосСистем.Выгрузить();
		
		тзСвернутая = ДокТитул1.СведенияГосСистем.Выгрузить();
		тзСвернутая.Свернуть("НаимГосСист, УчетЕд, ИнаяИнф");
		
		Для Каждого Стр Из тзСвернутая Цикл
			
			XDTO_СвГосСист = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвГосСист", ТипДокументооборота, Формат);
			XDTO_Установить(XDTO_СвГосСист,	"НаимГосСист", Стр.НаимГосСист);
			XDTO_Установить(XDTO_СвГосСист,	"УчетЕд", Стр.УчетЕд);
			XDTO_Установить(XDTO_СвГосСист,	"ИнаяИнф", Стр.ИнаяИнф);
						
			НайдСтроки = тз.НайтиСтроки(Новый Структура("НаимГосСист, УчетЕд, ИнаяИнф", Стр.НаимГосСист, Стр.УчетЕд, Стр.ИнаяИнф));			
			Для Каждого НайдСтрока Из НайдСтроки Цикл
				XDTO_СвГосСист.ИдНомУчетЕд.Добавить(НайдСтрока.ИдНомУчетЕд);	
			КонецЦикла;
			
			XDTO_СодИнфСоб.СвГосСист.Добавить(XDTO_СвГосСист)
						
		КонецЦикла;	
				
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодИнфСоб, "ОтмСпецУсл", ?(ДокТитул1.СпецУслДвиж.Количество() > 0, "1", "0"));
	
	// СпецУслДвиж
	Если ДокТитул1.СпецУслДвиж.Количество() > 0 Тогда	
		
		Для Каждого СтрокаСпецУслДвиж Из ДокТитул1.СпецУслДвиж Цикл			
			XDTO_СпецУслДвиж = XDTO_СпецУслДвиж(НомерТитула, СтрокаСпецУслДвиж, ТипДокументооборота, Формат);
			XDTO_СодИнфСоб.СпецУслДвиж.Добавить(XDTO_СпецУслДвиж);			
		КонецЦикла;
		
	КонецЕсли;
	
	// ИнфПол
	Если ДокТитул1.ИнфПол.Количество() > 0 Тогда			
		ВыгрузитьИнфПолСИдФайл(НомерТитула, Формат, "СодИнфСоб",ТипДокументооборота, ДокТитул1.ИнфПол, XDTO_СодИнфСоб);			
	КонецЕсли;	
	
	Возврат XDTO_СодИнфСоб;
	
КонецФункции

Функция XDTO_ПЛ_СодИнфМО(НомерТитула, Формат = Неопределено, ДокТитул2или6) Экспорт

	ТипДокументооборота = "__PL";
	
	XDTO_СодИнфМО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфМО", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СодИнфМО, "УИД_ПЛ", 		ДокТитул2или6.УИД_ПЛ);
	
	Если НомерТитула = 2 Тогда 
		XDTO_Установить(XDTO_СодИнфМО, "ВидМО", ?(ДокТитул2или6.ВидМОПредсменный, "1", "2"));
		Постфикс = "Пред";
	Иначе // 6
		XDTO_Установить(XDTO_СодИнфМО, "ВидМО", ?(ДокТитул2или6.ВидМОПослесменный, "1", "2"));
		Постфикс = "Посл";
	КонецЕсли;
	 	
	Титул1 = ДокТитул2или6.Титул1;
	МедРаботник = ДокТитул2или6.МедРаботник;
	Лицензия = ДокТитул2или6.МедЛицензия;
	
	МедикВШтате = Титул1.ЛицоОформившееПЛ = Титул1.ОрганизацияМедик Или Не ЗначениеЗаполнено(Титул1.ОрганизацияМедик);
	
	Если МедикВШтате Тогда 
		
		// СвМедРаб // если в штате
		XDTO_СвМедРабИЛИОрг = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфМО.СвМедРаб", ТипДокументооборота, Формат);
		
	Иначе
		// СвМедОрг	// если медик сторонний
