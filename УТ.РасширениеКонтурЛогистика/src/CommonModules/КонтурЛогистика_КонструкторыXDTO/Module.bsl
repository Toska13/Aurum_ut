Функция Конвертировать_СвВодит_вВодителяЛогистика(XDTO_СвВодит) Экспорт
	
	ВодительЛогистика = Справочники.КонтурЛогистика_Сотрудники.ПустаяСсылка();
	
	Если XDTO_СвВодит <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_Сотрудники.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
		               |ГДЕ
		               |	КонтурЛогистика_Сотрудники.Фамилия = &Фамилия
		               |	И КонтурЛогистика_Сотрудники.Имя = &Имя
		               |	И (КонтурЛогистика_Сотрудники.Отчество = &Отчество
		               |			ИЛИ &Отчество = НЕОПРЕДЕЛЕНО)
		               |	И НЕ КонтурЛогистика_Сотрудники.ПометкаУдаления
		               |	И (КонтурЛогистика_Сотрудники.ИНН = &ИНН
		               |			ИЛИ &ИНН = НЕОПРЕДЕЛЕНО)
					   |	И (КонтурЛогистика_Сотрудники.СНИЛС = &СНИЛС
		               |			ИЛИ &СНИЛС = НЕОПРЕДЕЛЕНО)
		               |	И (КонтурЛогистика_Сотрудники.ВУДатаВыдачи = &ВУДатаВыдачи
		               |			ИЛИ &ВУДатаВыдачи = НЕОПРЕДЕЛЕНО)";
		
		Запрос.УстановитьПараметр("Фамилия", 		XDTO_Вычислить(XDTO_СвВодит, "ФИО.Фамилия"));
		Запрос.УстановитьПараметр("Имя", 			XDTO_Вычислить(XDTO_СвВодит, "ФИО.Имя"));
		Запрос.УстановитьПараметр("Отчество", 		XDTO_Вычислить(XDTO_СвВодит, "ФИО.Отчество"));
		Запрос.УстановитьПараметр("ИНН", 			XDTO_Вычислить(XDTO_СвВодит, "ИННФЛ"));
		Запрос.УстановитьПараметр("СНИЛС", 			XDTO_Вычислить(XDTO_СвВодит, "СНИЛС"));
		
		ДатаВыдВУ_ДатаТип = XDTO_Вычислить(XDTO_СвВодит, "ДатаВыдВУ");
		Если ДатаВыдВУ_ДатаТип = Неопределено Тогда 
			ДатаВыдВУ_ДатаТип = XDTO_Вычислить(XDTO_СвВодит, "ВодитУд.ДатаВыдВУ");
		КонецЕсли;
		
		ВУДатаВыдачи = Конвертировать_ДатаТип_вДата(ДатаВыдВУ_ДатаТип);
		
		Запрос.УстановитьПараметр("ВУДатаВыдачи", 	ВУДатаВыдачи);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда		
			ВодительЛогистика = Выборка.Ссылка;		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВодительЛогистика) Тогда
			Возврат ВодительЛогистика;
		КонецЕсли;		
			
		НовыйВодитель = Справочники.КонтурЛогистика_Сотрудники.СоздатьЭлемент();
		
		НовыйВодитель.Фамилия = XDTO_Вычислить(XDTO_СвВодит, "ФИО.Фамилия");
		НовыйВодитель.Имя 	= XDTO_Вычислить(XDTO_СвВодит, "ФИО.Имя");
		НовыйВодитель.Отчество = XDTO_Вычислить(XDTO_СвВодит, "ФИО.Отчество");
		НовыйВодитель.ИНН = XDTO_Вычислить(XDTO_СвВодит, "ИННФЛ");
		НовыйВодитель.СНИЛС = XDTO_Вычислить(XDTO_СвВодит, "СНИЛС");
		НовыйВодитель.ВУДатаВыдачи = ВУДатаВыдачи;
		НовыйВодитель.ВУНомер = XDTO_Вычислить(XDTO_СвВодит, "НомВУ");
		Если НовыйВодитель.ВУНомер = "" Тогда
			НовыйВодитель.ВУНомер = XDTO_Вычислить(XDTO_СвВодит, "ВодитУд.НомВУ");
		КонецЕсли;
		НовыйВодитель.ВУСерия = XDTO_Вычислить(XDTO_СвВодит, "СерВУ");
		Если НовыйВодитель.ВУСерия = "" Тогда
			НовыйВодитель.ВУСерия = XDTO_Вычислить(XDTO_СвВодит, "ВодитУд.СерВУ");
		КонецЕсли;
		НовыйВодитель.РольВодитель = Истина;
		
		// контактные данные			
		XDTO_Контакт = XDTO_Вычислить(XDTO_СвВодит, "Контакт");
		Если XDTO_Контакт = Неопределено Тогда
			XDTO_Телефоны = XDTO_Вычислить(XDTO_СвВодит, "Тлф");
			ЗаполнитьТелефоныСотрудника(XDTO_Телефоны, НовыйВодитель);
		Иначе						
			XDTO_Телефоны = XDTO_Вычислить(XDTO_Контакт, "Тлф");
			ЗаполнитьТелефоныСотрудника(XDTO_Телефоны, НовыйВодитель);;
			
			XDTO_ЭлПочта = XDTO_Вычислить(XDTO_Контакт, "ЭлПочта");
			Если XDTO_ЭлПочта <> Неопределено Тогда
				Если ТипЗнч(XDTO_ЭлПочта) = Тип("Строка") Тогда 
					НовыйВодитель.АдресЭлектроннойПочты = XDTO_ЭлПочта;
				Иначе
					МассивЭлПочты = XDTO_ВычислитьМассивXDTO(XDTO_ЭлПочта);
					Если МассивЭлПочты.Количество() > 0 Тогда 
						НовыйВодитель.АдресЭлектроннойПочты = МассивЭлПочты[0];
					КонецЕсли;				
				КонецЕсли;
			КонецЕсли;
			
			НовыйВодитель.ИныеКонтактныеДанные = XDTO_Вычислить(XDTO_Контакт, "ИнКонт");
		КонецЕсли;	
					
		// ДОПОГ
		XDTO_СвДОПОГ = XDTO_Вычислить(XDTO_СвВодит, "СвДОПОГ");
		Если XDTO_СвДОПОГ <> Неопределено Тогда
			НовыйВодитель.ДОПОГНомер = XDTO_Вычислить(XDTO_СвДОПОГ, "НомСвДОПОГ");
			НовыйВодитель.ДОПОГСерия = XDTO_Вычислить(XDTO_СвДОПОГ, "СерСвДОПОГ");
			НовыйВодитель.ДОПОГДатаОкончания = XDTO_Вычислить(XDTO_СвДОПОГ, "КонДатСвДОПОГ");
		КонецЕсли;
		
		НовыйВодитель.Записать();
		
		ВодительЛогистика = НовыйВодитель.Ссылка;		
		
	КонецЕсли; 
	
	Возврат ВодительЛогистика;
	
КонецФункции

Процедура ЗаполнитьТелефоныСотрудника(XDTO_Телефоны, НовыйСотрудник)
	
	Если ТипЗнч(XDTO_Телефоны) = Тип("Строка") Тогда 
		НовыйСотрудник.ТелефонОсновной = XDTO_Телефоны;
	Иначе
		МассивТелефонов = XDTO_ВычислитьМассивXDTO(XDTO_Телефоны);
		Если МассивТелефонов.Количество() > 0 Тогда 
			НовыйСотрудник.ТелефонОсновной = МассивТелефонов[0];
		КонецЕсли;
		Если МассивТелефонов.Количество() > 1 Тогда 
			НовыйСотрудник.ТелефонЗапасной = МассивТелефонов[1];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

