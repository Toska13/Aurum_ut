	XDTO_СодСВИнфГП = НовыйДочернийОбъектXDTO(3, "СодСВИнфГП", ТипДО);
	XDTO_Установить(XDTO_СодСВИнфГП, "УИД_СВ", 	ДокументСВ.УИД);
	
