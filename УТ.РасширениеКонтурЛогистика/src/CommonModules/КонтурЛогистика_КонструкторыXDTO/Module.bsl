Функция XDTO_СвОпГруз(НомерТитула, ТипДокументооборота, Формат, Источник, КорневойТег)
	
	Если ТипДокументооборота = "__ZZ" Тогда 
		XDTO_СвОпГруз = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфГО.ОпГруз.ИнфОпасн", ТипДокументооборота, Формат);
	Иначе
		XDTO_СвОпГруз = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".СвГруз.ОпГруз.СвОпГруз", ТипДокументооборота, Формат);
	КонецЕсли;
	
	XDTO_Установить(XDTO_СвОпГруз, 	"НомООН",		Источник.НомерООН);
	XDTO_Установить(XDTO_СвОпГруз, 	"НадОтгНаим", 	Источник.НадлежащееОтгрузочноеНаименование);
	XDTO_Установить(XDTO_СвОпГруз, 	"ТехНаим", 		Источник.ТехническоеНаименование);
	XDTO_Установить(XDTO_СвОпГруз, 	"Описание", 	Источник.Описание);
	XDTO_Установить(XDTO_СвОпГруз, 	"Клас", 		Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.ЗначениеДляXDTO(Источник.Класс));
	XDTO_Установить(XDTO_СвОпГруз, 	"КласКод", 		Источник.КлассификационныйКод);
	XDTO_Установить(XDTO_СвОпГруз, 	"ГрУп", 		Перечисления.КонтурЛогистика_ГруппыУпаковки.ЗначениеДляXDTO(Источник.ГруппаУпаковки));
	XDTO_Установить(XDTO_СвОпГруз, 	"ЗнОп", 		Источник.ЗнакОпасности);
	XDTO_Установить(XDTO_СвОпГруз, 	"КодОгрЧерТун", Источник.КодОграниченияТуннели);
	
	Если Источник.Класс = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс7 Тогда 
		XDTO_Установить(XDTO_СвОпГруз, 	"НазРадионук", 		Источник.Радионуклиды);
		XDTO_Установить(XDTO_СвОпГруз, 	"ОписФизХимФорм", 	Источник.ОписаниеФизХимФормы);
		XDTO_Установить(XDTO_СвОпГруз, 	"МаксАкт", 			Источник.МаксАктивностьРадиации);
		XDTO_Установить(XDTO_СвОпГруз, 	"КатУпак", 			Источник.КатегорияУпаковки);
		XDTO_Установить(XDTO_СвОпГруз, 	"ТранспортныйИндекс", Источник.ТрансИндекс);
		Если ТипДокументооборота = "__ZZ" Тогда
			XDTO_Установить(XDTO_СвОпГруз, 	"ИндексБез", Источник.ИндексБез);
		Иначе
			XDTO_Установить(XDTO_СвОпГруз, 	"ИндексБезопасности", Источник.ИндексБез);
		КонецЕсли;
		XDTO_Установить(XDTO_СвОпГруз, 	"ОпозЗнак", 		Источник.ОпознавательныйЗнакСертификатов);
		XDTO_Установить(XDTO_СвОпГруз, 	"ПолнАктГр",		Источник.ПолнаяАктивностьГруза);
	КонецЕсли;
	
	Если Источник.Класс = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс1 Тогда 
		XDTO_Установить(XDTO_СвОпГруз, 	"ОбМасНетВзрСод", 		Источник.ОбМасНетВзрСод);
		XDTO_Установить(XDTO_СвОпГруз, 	"ОбМасНетВзрСодВсех", 	Источник.ОбМасНетВзрСодВсех);
	КонецЕсли;
	
	Если Источник.Класс = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс2 Тогда 
		XDTO_Установить(XDTO_СвОпГруз, 	"ПроцСмеси", 		Источник.ПроцСмеси);
		XDTO_Установить(XDTO_СвОпГруз, 	"ДатИстВрУдер", 	XDTO_ДатаТип(Источник.ДатаИстеченияВремениУдержания));
	КонецЕсли;
	
	XDTO_Установить(XDTO_СвОпГруз, 	"КонтТемпер", 		Источник.КонтрольнаяТемпература);
	XDTO_Установить(XDTO_СвОпГруз, 	"АварТемпер", 		Источник.АварийнаяТемпература);
	
	Возврат XDTO_СвОпГруз;
	
КонецФункции

Функция Массив_XDTO_СвВодит(НомерТитула, Формат = Неопределено, ДокТитул1, ТипДокументооборота = "__etrnTitle")
	
	Массив = Новый Массив;
	
	СоставителиПутевогоЛиста = Массив_XDTO_СоставителиДокумента(
								НомерТитула,
								ДокТитул1.ДокументЭТРН,
								Перечисления.КонтурЛогистика_СтороныСоставители.ПВ);

	// Прототип ТрН Т1 может не обладать почти всеми реквизитами							
	Если ТипДокументооборота = "__etrnTitle" И НомерТитула = 1 И Не ЗначениеЗаполнено(ДокТитул1.Водитель) Тогда 
		Возврат Массив;
	КонецЕсли;
								
	// первый водитель
	XDTO_Объект = XDTO_СвВодит(НомерТитула, ДокТитул1.Водитель, ТипДокументооборота);
	Если ЗначениеЗаполнено(ДокТитул1.ПутевойЛистНомер) или ЗначениеЗаполнено(ДокТитул1.ПутевойЛистДата) Тогда 
		XDTO_ПутевойЛист = XDTO_РеквДокТип(НомерТитула, "Путевой лист", ДокТитул1.ПутевойЛистНомер, ДокТитул1.ПутевойЛистДата,,, СоставителиПутевогоЛиста);
		XDTO_Объект.ПутевойЛист.Добавить(XDTO_ПутевойЛист);
	КонецЕсли;
	Массив.Добавить(XDTO_Объект);
	
	// второй водитель
	Если ЗначениеЗаполнено(ДокТитул1.Водитель2) Тогда 
		XDTO_Объект = XDTO_СвВодит(НомерТитула, ДокТитул1.Водитель2, ТипДокументооборота);
		Если ЗначениеЗаполнено(ДокТитул1.ПутевойЛистНомер) или ЗначениеЗаполнено(ДокТитул1.ПутевойЛистДата) Тогда 
			XDTO_ПутевойЛист = XDTO_РеквДокТип(НомерТитула, "Путевой лист", ДокТитул1.ПутевойЛистНомер, ДокТитул1.ПутевойЛистДата,,, СоставителиПутевогоЛиста);
			XDTO_Объект.ПутевойЛист.Добавить(XDTO_ПутевойЛист);
		КонецЕсли;
		Массив.Добавить(XDTO_Объект);
	КонецЕсли;
	
	// доп водители из ТЧ ДополнительныеВодители
	Для Каждого ДопВодитель Из ДокТитул1.ДополнительныеВодители Цикл
		
		XDTO_Объект = XDTO_СвВодит(1, ДопВодитель.Водитель);
		Если ЗначениеЗаполнено(ДопВодитель.ПутевойЛистНомер) или ЗначениеЗаполнено(ДопВодитель.ПутевойЛистДата) Тогда 
			XDTO_ПутевойЛист = XDTO_РеквДокТип(НомерТитула, "Путевой лист", ДопВодитель.ПутевойЛистНомер, ДопВодитель.ПутевойЛистДата,,, СоставителиПутевогоЛиста);
			XDTO_Объект.ПутевойЛист.Добавить(XDTO_ПутевойЛист);
		КонецЕсли;
		Массив.Добавить(XDTO_Объект);
		
	КонецЦикла;
	
	// телефон указанный в ЭТРН (если указан) приоритетней
	Если ЗначениеЗаполнено(ДокТитул1.ДокументЭТРН.ТелефонВодителя) Тогда 
		
		Для Каждого XDTO_Водитель Из Массив Цикл
			
			XDTO_Водитель.Тлф.очистить();
			XDTO_Водитель.Тлф.Добавить(ДокТитул1.ДокументЭТРН.ТелефонВодителя);

		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

// не путать с ПарамТСТип
Функция XDTO_ПараметрыТС(НомерТитула, ТранспСредствоСсылка, ДокТитул, ТипДокументооборота = "__etrnTitle", Формат = Неопределено)
	
	Если ТипДокументооборота = "__etrnTitle" ИЛИ ТипДокументооборота = "__SoprVed" Или ТипДокументооборота = "__ZZ" Тогда
		
		Если ТипДокументооборота = "__etrnTitle" Тогда
			XDTO_Объект = НовыйБазовыйОбъектXDTO(НомерТитула, "ПараметрыТСТип", ТипДокументооборота);
			
			// Прототип ТрН Т1 может не обладать почти всеми реквизитами							
			Если НомерТитула = 1 И Не ЗначениеЗаполнено(ТранспСредствоСсылка) Тогда 
				Возврат XDTO_Объект;
			КонецЕсли;
			
		ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда 
			XDTO_Объект = НовыйБазовыйОбъектXDTO(НомерТитула, "ПараметрыТССВТип", ТипДокументооборота);
		ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
			XDTO_Объект = НовыйБазовыйОбъектXDTO(НомерТитула, "ПараметрыТСТип", ТипДокументооборота, Формат);
		КонецЕсли;
		
		XDTO_Установить(XDTO_Объект, 	"НомСТС", 			ТранспСредствоСсылка.СТС);
		XDTO_Установить(XDTO_Объект, 	"НомерВИН", 		ТранспСредствоСсылка.VIN);
		XDTO_Установить(XDTO_Объект, 	"РегНомер", 		ТранспСредствоСсылка.РегНомер);
		XDTO_Установить(XDTO_Объект, 	"ТипВлад", 			Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.ЗначениеДляXDTO(ТранспСредствоСсылка.ВидВладения));
		
		XDTO_ПарамТСТип = XDTO_ПарамТСТип(НомерТитула, ТранспСредствоСсылка, ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_Объект, 	"ПарТС", 		XDTO_ПарамТСТип);
		
		Если Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.ДляВидаВладенияТребуетсяУказатьДоговор(ТранспСредствоСсылка.ВидВладения) Тогда 
			
			XDTO_ОснАрЛиз = XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, ТранспСредствоСсылка.ДоговорАрендаЛизинг, ТипДокументооборота); 
			Если ТипДокументооборота = "__SoprVed" Тогда
				XDTO_Установить(XDTO_Объект, "ОснАрЛиз", XDTO_ОснАрЛиз);
			Иначе
				XDTO_Объект.ОснАрЛиз.Добавить(XDTO_ОснАрЛиз);
			КонецЕсли;
			
		КонецЕсли;
			
	ИначеЕсли ТипДокументооборота = "__zakazNarTitle" Тогда
		
		ВызватьИсключение "Непредполагаемое использование Функция XDTO_СвТС";
		
	Иначе
		
		ВызватьИсключение "Непредполагаемое использование Функция XDTO_СвТС";
		
	КонецЕсли;
	
	Возврат	XDTO_Объект;
	
КонецФункции

// не путать с ПараметрыТС
Функция XDTO_ПарамТСТип(НомерТитула, ТранспСредствоСсылка, ТипДокументооборота = "__etrnTitle", Формат = Неопределено)
	
	Если ТипДокументооборота = "__etrnTitle" 
		ИЛИ ТипДокументооборота = "__zakazNarTitle"  Тогда
		
		XDTO_Объект 		= НовыйБазовыйОбъектXDTO(НомерТитула, "ПарамТСТип", ТипДокументооборота);
		
	ИначеЕсли ТипДокументооборота = "__ZZ" Тогда
		
		XDTO_Объект 		= НовыйБазовыйОбъектXDTO(НомерТитула, "ПарамТСТип", ТипДокументооборота, Формат);
		
	ИначеЕсли ТипДокументооборота = "__SoprVed" Тогда
		
		XDTO_Объект 		= НовыйБазовыйОбъектXDTO(НомерТитула, "ПараметрыТССВТип.ПарТС", ТипДокументооборота);
		
	Иначе
		
		ВызватьИсключение "Непредполагаемое использование Функция XDTO_ПарамТСТип";
		
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, 	"Тип", 				ТранспСредствоСсылка.ТипТС);
	XDTO_Установить(XDTO_Объект, 	"Марка", 			ТранспСредствоСсылка.МаркаТС);
	XDTO_Установить(XDTO_Объект, 	"Грузопод", 		ТранспСредствоСсылка.ГрузоподъемностьТонн, Истина);
	XDTO_Установить(XDTO_Объект, 	"Вместим", 			ТранспСредствоСсылка.ВместимостьКубМ, Истина);
	
	Возврат	XDTO_Объект;
	
КонецФункции

Функция XDTO_АдрПункт(НомерТитула, Формат = "5.01", СтрокаДокументаАдрПункт, ТипДокументооборота = "__ZZ")
	
	Если ТипДокументооборота = "__ZZ" Тогда 
		КорневойТег = "СодИнфГО";
	Иначе
		ВызватьИсключение "Не предусмотрен тип документооборота " + ТипДокументооборота;
	КонецЕсли;
	
	XDTO_Объект = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".АдрПункт", ТипДокументооборота);
	
	Если СтрокаДокументаАдрПункт.Погрузка Тогда
		XDTO_Установить(XDTO_Объект, "Опер", "Погрузка");
	ИначеЕсли СтрокаДокументаАдрПункт.Выгрузка Тогда
		XDTO_Установить(XDTO_Объект, "Опер", "Выгрузка");
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, "ПорНомПункт", Формат(СтрокаДокументаАдрПункт.НомерСтроки, "ЧГ="));
	
	Если ЗначениеЗаполнено(СтрокаДокументаАдрПункт.ДатВрОпер) 
		ИЛИ ЗначениеЗаполнено(СтрокаДокументаАдрПункт.ПредВрОпер) Тогда 
		XDTO_Установить(XDTO_Объект,	"ДатВрОпер", 	XDTO_ДатаВремяВЗТип(СтрокаДокументаАдрПункт.ДатВрОпер));
		XDTO_Установить(XDTO_Объект,	"НалКоорТочВрОпер", 	"1");
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаДокументаАдрПункт.ПредВрОпер) Тогда 
		XDTO_Установить(XDTO_Объект,	"ПредВрОпер", XDTO_ВремяВЗТип(СтрокаДокументаАдрПункт.ПредВрОпер));
		XDTO_Установить(XDTO_Объект,	"НалКоорТочПредВрОпер", 	"1");
	КонецЕсли;
	
	//XDTO_АдресПользТип = XDTO_АдресПунктаМаршрута(СтрокаДокументаАдрПункт.ПунктМаршрута, НомерТитула, ТипДокументооборота, Формат);	
	XDTO_АдресПользТип = НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".АдрПункт.АдресПункт", ТипДокументооборота, Формат);
	//XDTO_АдресПользТип = НовыйБазовыйОбъектXDTO(НомерТитула, "АдресПользТип", ТипДокументооборота, Формат);
	
	XDTO_Объект.АдресПункт = XDTO_АдресПользТип;
	
	Если СтрокаДокументаАдрПункт.Погрузка Тогда
		XDTO_ОргВладИнфр =  НовыйДочернийОбъектXDTO(НомерТитула, КорневойТег + ".АдрПункт.ОргВладИнфр", ТипДокументооборота);
		XDTO_Установить(XDTO_ОргВладИнфр,	"НаимВладИнфр", СтрокаДокументаАдрПункт.ПунктМаршрута.Собственник.НаименованиеОрганизацииПолное);
		XDTO_Установить(XDTO_ОргВладИнфр,	"ИННВладИнфр", 	СтрокаДокументаАдрПункт.ПунктМаршрута.Собственник.ИНН);
		XDTO_Установить(XDTO_Объект, "АдресПункт", XDTO_ОргВладИнфр);
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_АдресПунктаМаршрута(ПунктМаршрутаСсылка, НомерТитула, ТипДокументооборота = "__etrnTitle", Формат = "5.01")
	
	// Вы там у себя в ФНС можете наконец закончить перетасовывать каждый год эту вложенность??? 
	
	XDTO_АдресПольз = НовыйБазовыйОбъектXDTO(НомерТитула, "АдресПользТип", ТипДокументооборота, Формат);
	
	ЕстьПрослойкаАдрес = ТипДокументооборота = "__ZZ" Или ТипДокументооборота = "__PL" Или ТипДокументооборота = "__DF";
	
	Если ЕстьПрослойкаАдрес Тогда // есть доп. прослойка
		XDTO_Адрес = НовыйБазовыйОбъектXDTO(НомерТитула, "АдресТип", ТипДокументооборота, Формат);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПунктМаршрутаСсылка.КодГАР) И Не ЕстьПрослойкаАдрес Тогда
		
		XDTO_Установить(XDTO_АдресПольз, "КодГАР", ПунктМаршрутаСсылка.КодГАР);
		
	ИначеЕсли ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресКодРегион) И ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИндекс) Тогда
	
		XDTO_АдрРФ = НовыйБазовыйОбъектXDTO(НомерТитула, "АдрРФТип", ТипДокументооборота, Формат);
						
		ТаблицаРегионовРФ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
		СтрокаРегион = ТаблицаРегионовРФ.Найти(ПунктМаршрутаСсылка.АдресКодРегион, "Код");
		Если СтрокаРегион = Неопределено Или ПунктМаршрутаСсылка.АдресКодРегион = "99" Тогда
			НаимРегион = "иные";
		Иначе
			НаимРегион = СтрокаРегион.Наименование;
		КонецЕсли;
		
		XDTO_Установить(XDTO_АдрРФ, "Индекс", ПунктМаршрутаСсылка.АдресИндекс);
		XDTO_Установить(XDTO_АдрРФ, "КодРегион", ПунктМаршрутаСсылка.АдресКодРегион);
		
		Если ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
			XDTO_Установить(XDTO_АдрРФ, "НаимРегион", НаимРегион);	
		КонецЕсли;
		
		XDTO_Установить(XDTO_АдрРФ, "Район", ПунктМаршрутаСсылка.АдресРайон);
		XDTO_Установить(XDTO_АдрРФ, "Город", ПунктМаршрутаСсылка.АдресГород);
		XDTO_Установить(XDTO_АдрРФ, "НаселПункт", ПунктМаршрутаСсылка.АдресНаселПункт);
		XDTO_Установить(XDTO_АдрРФ, "Улица", ПунктМаршрутаСсылка.АдресУлица);
		XDTO_Установить(XDTO_АдрРФ, "Дом", ПунктМаршрутаСсылка.АдресДом);
		XDTO_Установить(XDTO_АдрРФ, "Корпус", ПунктМаршрутаСсылка.АдресКорпус);
		XDTO_Установить(XDTO_АдрРФ, "Кварт", ПунктМаршрутаСсылка.АдресКварт);
			
		Если ТипДокументооборота = "__zakazNarTitle" Тогда
			XDTO_Установить(XDTO_АдресПольз, "АдрРФ", XDTO_АдрРФ);
		ИначеЕсли ЕстьПрослойкаАдрес Тогда 
			XDTO_Установить(XDTO_Адрес, "АдрРФ", XDTO_АдрРФ);
			XDTO_Установить(XDTO_АдресПольз, "Адрес", XDTO_Адрес);
		Иначе
			XDTO_Установить(XDTO_АдресПольз, "АдресРФ", XDTO_АдрРФ);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ПунктМаршрутаСсылка.АдресИнфАдрес) Тогда
		
		XDTO_АдрИнф = НовыйБазовыйОбъектXDTO(НомерТитула, "АдрИнфТип", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_АдрИнф, "КодСтр", ПунктМаршрутаСсылка.АдресИнфКодСтраны.Код);
		XDTO_Установить(XDTO_АдрИнф, "АдрТекст", ПунктМаршрутаСсылка.АдресИнфАдрес);
		Если ТипДокументооборота = "__etrnTitle" ИЛИ ТипДокументооборота = "__SoprVed" Тогда 
			XDTO_Установить(XDTO_АдресПольз, "АдресИнф", XDTO_АдрИнф);
		ИначеЕсли ЕстьПрослойкаАдрес Тогда 
			XDTO_Установить(XDTO_Адрес, "АдрИнф", XDTO_АдрИнф);
			XDTO_Установить(XDTO_АдресПольз, "Адрес", XDTO_Адрес);
		Иначе
			XDTO_Установить(XDTO_АдресПольз, "АдрИнф", XDTO_АдрИнф);
		КонецЕсли;
		
	Иначе
		
		// С появлением прототипов ТрН Т1 много полей стали необязательными
		Если НомерТитула <> 1 Тогда
			ВызватьИсключение "У пункта маршрута: " + ПунктМаршрутаСсылка + " не заполнен ни один из адресов.";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПунктМаршрутаСсылка.GLN) Тогда
		XDTO_Установить(XDTO_АдресПольз, "ГЛН", ПунктМаршрутаСсылка.GLN);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПунктМаршрутаСсылка.КомментарийКАдресу) Тогда
		XDTO_Установить(XDTO_АдресПольз, "АдрКоммент", ПунктМаршрутаСсылка.КомментарийКАдресу);
	КонецЕсли;
	
	Возврат XDTO_АдресПольз;
	
КонецФункции

Функция XDTO_УчастникТрН(НомерТитула, Формат = "5.01", ОрганизацияДиадок, ТипДокументооборота = "__etrnTitle")
	
	Если ТипЗнч(ОрганизацияДиадок) <> Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда 
		ВызватьИсключение "Пока не реализовано использование Сотрудников в качестве лица-участника " + ОрганизацияДиадок;
	КонецЕсли;
	
	Если ТипДокументооборота = "__ZZ" Или ТипДокументооборота = "__PL" Тогда 
		XDTO_Объект 		= НовыйБазовыйОбъектXDTO(НомерТитула, "УчастникТип", ТипДокументооборота, Формат);
	Иначе 
		XDTO_Объект 		= НовыйБазовыйОбъектXDTO(НомерТитула, "УчастникТрНТип", ТипДокументооборота, Формат);
	КонецЕсли;
	
	// Прототип ТрН Т1 может без участников
	Если ТипДокументооборота = "__etrnTitle" И НомерТитула = 1 И Не ЗначениеЗаполнено(ОрганизацияДиадок) Тогда 
		Возврат XDTO_Объект;
	КонецЕсли;
	
	
	// нет требований как заполянять ИнфУчаст и сценариев появления КакаяТоОрганизацияУчастник
	//XDTO_ИнфДляУчаст 	= НовыйБазовыйОбъектXDTO(НомерТитула, "УчастникТрНТип.ИнфДляУчаст");
	//XDTO_Установить(XDTO_ИнфДляУчаст, "ИННУчаст", 	КакаяТоОрганизацияУчастник.ИНН);
	//XDTO_Установить(XDTO_ИнфДляУчаст, "ИнфУчаст", 	КакаяТоОрганизацияУчастник.КакаяТоТекстоваяИнформация);
	//XDTO_Установить(XDTO_Объект,	 "ИнфДляУчаст", XDTO_ИнфДляУчаст);
	
	XDTO_ИдСв 			= НовыйБазовыйОбъектXDTO(НомерТитула, "ИдСвТип", ТипДокументооборота, Формат);
	XDTO_ИдСв_ЗаполнитьИзОрганизацииДиадок(XDTO_ИдСв, НомерТитула, Формат, ОрганизацияДиадок, ТипДокументооборота);
	XDTO_Установить(XDTO_Объект, 	"ИдСв", 		XDTO_ИдСв);
	
	XDTO_Адрес			= НовыйБазовыйОбъектXDTO(НомерТитула, "АдресТип", ТипДокументооборота, Формат);
	XDTO_Адрес_ЗаполнитьИзОрганизацииДиадок(XDTO_Адрес, НомерТитула, Формат, ОрганизацияДиадок, ТипДокументооборота);
	XDTO_Установить(XDTO_Объект, "Адрес", XDTO_Адрес);
	
	// контакт
	XDTO_Контакт		= НовыйБазовыйОбъектXDTO(НомерТитула, "КонтактТип", ТипДокументооборота, Формат);
	XDTO_Контакт_ЗаполнитьИзОрганизацииДиадок(XDTO_Контакт, НомерТитула, Формат, ОрганизацияДиадок, ТипДокументооборота);
	
	Если ТипДокументооборота = "__ZZ" Тогда
		XDTO_Установить(XDTO_Объект, "Конт", XDTO_Контакт);
	Иначе
		XDTO_Установить(XDTO_Объект, "Контакт", XDTO_Контакт);
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ДопСвУчФХЖТип(НомерТитула, ДокТитул)
	
	XDTO_ДопСвУчФХЖТип = НовыйБазовыйОбъектXDTO(НомерТитула, "ДопСвУчФХЖТип");
	XDTO_УстановитьСУсловием(XDTO_ДопСвУчФХЖТип, "ОКПО", ДокТитул.ОКПО);
	XDTO_УстановитьСУсловием(XDTO_ДопСвУчФХЖТип, "СтруктПодр", ДокТитул.СтруктурноеПодразделение);
	XDTO_УстановитьСУсловием(XDTO_ДопСвУчФХЖТип, "ИнфДляУчаст", ДокТитул.ПорядокИспользованияФайлаОбмена);
	XDTO_УстановитьСУсловием(XDTO_ДопСвУчФХЖТип, "КраткНазв", ДокТитул.КраткоеНазвание);
	
	Если ЗначениеЗаполнено(ДокТитул.НомерСчета) Тогда
		XDTO_БанкРекв = НовыйБазовыйОбъектXDTO(НомерТитула, "ДопСвУчФХЖТип.БанкРекв");
		XDTO_СвБанк = НовыйБазовыйОбъектXDTO(НомерТитула, "ДопСвУчФХЖТип.БанкРекв.СвБанк");
		
		XDTO_УстановитьСУсловием(XDTO_СвБанк, "НаимБанк", ДокТитул.НаименованиеБанка);
		XDTO_УстановитьСУсловием(XDTO_СвБанк, "БИК", ДокТитул.БИК);
		XDTO_УстановитьСУсловием(XDTO_СвБанк, "КорСчет", ДокТитул.КорСчет);
		
		XDTO_Установить(XDTO_БанкРекв, "НомерСч", ДокТитул.НомерСчета);
		XDTO_Установить(XDTO_БанкРекв, "СвБанк", XDTO_СвБанк);
		
		XDTO_Установить(XDTO_ДопСвУчФХЖТип, "БанкРекв", XDTO_БанкРекв);
	КонецЕсли;
	
	Возврат XDTO_ДопСвУчФХЖТип;
	
КонецФункции

Функция XDTO_УчастникЗНФЛ(НомерТитула, Формат = Неопределено, ОрганизацияДиадок)
	
