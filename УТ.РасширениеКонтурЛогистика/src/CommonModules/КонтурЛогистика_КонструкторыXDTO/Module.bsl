		Если ДокТитул4.ЗамечанияИнфПол.Количество() > 0 Тогда 
			Для Каждого СтрокаИнфПол Из ДокТитул4.ЗамечанияИнфПол Цикл
				
				XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодПрвВыд.ЗамПрвВыд");
				XDTO_ЗамПрвВыд.ИнфПол.Добавить(XDTO_ИнфПол)
				
			КонецЦикла;
		КонецЕсли;
		
		XDTO_Установить(XDTO_СодПрвВыд, "ЗамПрвВыд", 	XDTO_ЗамПрвВыд);
		
	КонецЕсли;
	
	// ИнфПол Основные документа
	Если ДокТитул4.ИнфПол.Количество() > 0 Тогда 
		Для Каждого СтрокаИнфПол Из ДокТитул4.ИнфПол Цикл
				
			XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодПрвВыд");
			XDTO_СодПрвВыд.ИнфПол.Добавить(XDTO_ИнфПол)
				
		КонецЦикла;
	КонецЕсли;
	
	//ОтметПрвПрием	
	Если ДокТитул4.ОтметкиПеревозчика.Количество() > 0 Тогда 
		Для Каждого СтрокаОтметПВ Из ДокТитул4.ОтметкиПеревозчика Цикл
				
			XDTO_ОтметПВ = XDTO_Отмет(НомерТитула, Формат, ДокТитул4, СтрокаОтметПВ, "СодПрвВыд.ОтметПрвВыд");
			
			// ИнфПол блока ОтметПрвВыд
			Если ДокТитул4.ОтметкиИнфПол.Количество() > 0 Тогда
				
				ПоискИнфПол = Новый Структура("ИдентификаторСтрокиОтметки", СтрокаОтметПВ.ИдентификаторСтроки);
				СтрокиИнфПолЭтойОтметки = ДокТитул4.ОтметкиИнфПол.НайтиСтроки(ПоискИнфПол);
				
				Для Каждого СтрокаИнфПол Из СтрокиИнфПолЭтойОтметки Цикл
					
					XDTO_ИнфПол = XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодПрвВыд.ОтметПрвВыд");
					XDTO_ОтметПВ.ИнфПол.Добавить(XDTO_ИнфПол)
					
				КонецЦикла;
				
			КонецЕсли;
			
			XDTO_СодПрвВыд.ОтметПрвВыд.Добавить(XDTO_ОтметПВ)
				
		КонецЦикла;
	КонецЕсли;

	Возврат XDTO_СодПрвВыд;
	
КонецФункции

Функция XDTO_СодФХЖ1(НомерТитула, Формат = Неопределено, ДокТитул5) Экспорт 
	
	НомерТитула = 5;
	
	XDTO_СодФХЖ1 = НовыйДочернийОбъектXDTO(НомерТитула, "СодФХЖ1");
	XDTO_Установить(XDTO_СодФХЖ1, "УИД_ТрН", ДокТитул5.ДокументЭТРН.УИД);
	
	XDTO_Установить(XDTO_СодФХЖ1, "СодФХЖ", 	"Вверенный грузоотправителем груз доставлен в пункт назначения и выдан управомоченному на получение груза с учетом приведенных в транспортной накладной обстоятельств перевозки");
	XDTO_Установить(XDTO_СодФХЖ1, "ВалКод", 	"643");
	XDTO_Установить(XDTO_СодФХЖ1, "ВалНаим", 	"Российский рубль");
	
	XDTO_Установить(XDTO_СодФХЖ1, "СтТовБезНДС", ДокТитул5.СтоимостьБезНДС);
	XDTO_УстановитьСУсловием(XDTO_СодФХЖ1, "СтТовУчНал", ДокТитул5.СтоимостьСНДС);
	XDTO_УстановитьСУсловием(XDTO_СодФХЖ1, "Расчет", ДокТитул5.ПорядокРасчета);
	
	Если ЗначениеЗаполнено(ДокТитул5.СтоимостьБезНДС) Или ЗначениеЗаполнено(ДокТитул5.СтоимостьСНДС) Тогда  
		СтавкаНДС = Перечисления.КонтурЛогистика_СтавкиНДС.ПредставлениеСтавкиНДСПоЗначению(ДокТитул5.СтавкаНДС);
		XDTO_Установить(XDTO_СодФХЖ1, "НалСт", СтавкаНДС);
	КонецЕсли;
	
	XDTO_СумНал = НовыйДочернийОбъектXDTO(НомерТитула, "СодФХЖ1.СумНал");
	Если ДокТитул5.СтавкаНДС = Перечисления.КонтурЛогистика_СтавкиНДС.БезНДС Тогда
		XDTO_Установить(XDTO_СумНал, "БезНДС", "без НДС");
	Иначе	
		XDTO_Установить(XDTO_СумНал, "СумНДС", ДокТитул5.СуммаНДС);
	КонецЕсли;	
	
	XDTO_Установить(XDTO_СодФХЖ1, "СумНал", XDTO_СумНал);
	
	Если ЗначениеЗаполнено(ДокТитул5.НомИспр) Тогда 
		XDTO_ИспрТрН = НовыйДочернийОбъектXDTO(НомерТитула, "СодФХЖ1.ИспрПУД");
		XDTO_Установить(XDTO_ИспрТрН, "НомерИспр", 	ДокТитул5.НомИспр);
		XDTO_Установить(XDTO_ИспрТрН, "ДатаИспр", 	XDTO_ДатаТип(ДокТитул5.ДатаИспр));
		XDTO_Установить(XDTO_СодФХЖ1, "ИспрПУД", 	XDTO_ИспрТрН);
	КонецЕсли;
	
	XDTO_Установить(XDTO_СодФХЖ1, "ДопСвПрв", 	XDTO_ДопСвУчФХЖТип(НомерТитула, ДокТитул5));
	
	Возврат XDTO_СодФХЖ1;
	
КонецФункции	

