	XDTO_Установить(XDTO_СвМОПредИлиПосл, "СНИЛС", 	ДокТитул2или5.Водитель.СНИЛС);
	
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ДокТитул2или5.Водитель.Фамилия);
