	// контакт
	XDTO_Контакт		= НовыйБазовыйОбъектXDTO(НомерТитула, "КонтактТип", ТипДокументооборота);
	XDTO_Контакт_ЗаполнитьИзОрганизацииДиадок(XDTO_Контакт, НомерТитула, Формат, ОрганизацияДиадок);
	XDTO_Установить(XDTO_Объект, "Контакт", XDTO_Контакт);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_РеквДокТип(НомерТитула, Наименование = Неопределено, Знач Номер = Неопределено, Дата = Неопределено, ИдДок = Неопределено, ДопСведДок = Неопределено, Массив_XDTO_ИдРекСост = Неопределено, ТипДокументооборота = "__etrnTitle", Формат = "5.01") Экспорт 
	
	Если ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
		Префикс = "Рекв";
	Иначе
	    Префикс = "";
	КонецЕсли;
	
	XDTO_Объект = НовыйБазовыйОбъектXDTO(НомерТитула, "РеквДокТип", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_Объект, 		Префикс + "ИдДок", 		СокрЛП(ИдДок));
	
	Если Не ЗначениеЗаполнено(Номер) Тогда 
		Номер = "Без номера";
	КонецЕсли;
	XDTO_Установить(XDTO_Объект, 		Префикс + "НаимДок", 		СокрЛП(Наименование));
	XDTO_Установить(XDTO_Объект, 		Префикс + "НомерДок", 	СокрЛП(Номер));
	Если ЗначениеЗаполнено(Дата) Тогда 
		XDTO_Установить(XDTO_Объект, 	Префикс + "ДатаДок", 		XDTO_ДатаТип(Дата));
	КонецЕсли;
	
	XDTO_Установить(XDTO_Объект, 		Префикс + "ДопСведДок", 	СокрЛП(ДопСведДок));
	
	Если Массив_XDTO_ИдРекСост <> Неопределено Тогда 
		Для Каждого XDTO_ИдРекСост Из Массив_XDTO_ИдРекСост Цикл 
			
			Если ТипДокументооборота = "__PL" И Формат = "5.02" Тогда
				XDTO_Объект.РеквИдРекСост.Добавить(XDTO_ИдРекСост);	
			Иначе
				XDTO_Объект.ИдРекСост.Добавить(XDTO_ИдРекСост);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции


Функция XDTO_РеквДокТипПоСсылкеДоговору(НомерТитула, ДоговорСсылка, ТипДокументооборота = "__etrnTitle", Формат = "5.01") Экспорт
	
	Если не ЗначениеЗаполнено(ДоговорСсылка) Тогда 
		Возврат НовыйБазовыйОбъектXDTO(НомерТитула, "РеквДокТип", ТипДокументооборота, Формат);
	КонецЕсли;
	
	Массив_XDTO_ИдРекСост = Новый Массив;
	
	// организация
	Если ЗначениеЗаполнено(ДоговорСсылка.Организация) Тогда 
		XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, ДоговорСсылка.Организация, ТипДокументооборота,,,,, Формат);
		Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
	ИначеЕсли ЗначениеЗаполнено(ДоговорСсылка.ОрганизацияИНН) Тогда
		Если СтрДлина(СокрЛП(ДоговорСсылка.ОрганизацияИНН)) = 10 Тогда 
			XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, Неопределено, ТипДокументооборота, ДоговорСсылка.ОрганизацияИНН,,,, Формат);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
		ИначеЕсли СтрДлина(СокрЛП(ДоговорСсылка.ОрганизацияИНН)) = 12 Тогда
			XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, Неопределено, ТипДокументооборота,, ДоговорСсылка.ОрганизацияИНН,,, Формат);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДоговорСсылка.Контрагент) Тогда 
		XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, ДоговорСсылка.Контрагент, ТипДокументооборота,,,,, Формат);
		Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
	ИначеЕсли ЗначениеЗаполнено(ДоговорСсылка.КонтрагентИНН) Тогда
		Если СтрДлина(СокрЛП(ДоговорСсылка.КонтрагентИНН)) = 10 Тогда 
			XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, Неопределено, ТипДокументооборота, ДоговорСсылка.КонтрагентИНН,,,, Формат);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
		ИначеЕсли СтрДлина(СокрЛП(ДоговорСсылка.КонтрагентИНН)) = 12 Тогда
			XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, Неопределено, ТипДокументооборота,, ДоговорСсылка.КонтрагентИНН,,, Формат);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
		КонецЕсли;
	КонецЕсли;
	
	// другие участники
	Для Каждого стрУчастник Из ДоговорСсылка.Участники Цикл
		
		Если ЗначениеЗаполнено(стрУчастник.Участник) Тогда 
			
			XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, стрУчастник.Участник, ТипДокументооборота,,,,, Формат);
			Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
			
		ИначеЕсли ЗначениеЗаполнено(стрУчастник.УчастникИНН) Тогда
			
			Если СтрДлина(СокрЛП(стрУчастник.УчастникИНН)) = 10 Тогда 
				XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, Неопределено, ТипДокументооборота, стрУчастник.УчастникИНН,,,, Формат);
				Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
			ИначеЕсли СтрДлина(СокрЛП(стрУчастник.УчастникИНН)) = 12 Тогда
				XDTO_ИдРекСостУчастник = XDTO_ИдРекСостТип(НомерТитула, Неопределено, ТипДокументооборота, ,стрУчастник.УчастникИНН,,, Формат);
				Массив_XDTO_ИдРекСост.Добавить(XDTO_ИдРекСостУчастник);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	XDTO_Объект = XDTO_РеквДокТип(НомерТитула,
									ДоговорСсылка.Наименование,
									ДоговорСсылка.НомерДокумента,
									ДоговорСсылка.ДатаДокумента,
									ДоговорСсылка.ИдДок,
									ДоговорСсылка.ДопСведения,
									Массив_XDTO_ИдРекСост,
									ТипДокументооборота,
									Формат);
	
	Возврат XDTO_Объект;
	
КонецФункции

// если передана ОрганизацияДиадокСсылка - возьмем из нее, если не передана - соберем из реквизитов 
Функция XDTO_ИдРекСостТип(НомерТитула, ОрганизацияДиадокСсылка = Неопределено, ТипДокументооборота = "__etrnTitle", ИННЮЛ = Неопределено, 
	ИННФЛ = Неопределено, XDTO_ДаннИно = Неопределено, НаимОИВ = Неопределено, Формат = "5.01")
	
	XDTO_Объект 		= НовыйБазовыйОбъектXDTO(НомерТитула, "ИдРекСостТип", ТипДокументооборота, Формат);
	
	Если ЗначениеЗаполнено(ОрганизацияДиадокСсылка) Тогда
		Если ОрганизацияДиадокСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда
			
			XDTO_Установить(XDTO_Объект, 	"ИННЮЛ", 		ОрганизацияДиадокСсылка.ИНН);
			
		ИначеЕсли ОрганизацияДиадокСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо 
			ИЛИ ОрганизацияДиадокСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
			
			XDTO_Установить(XDTO_Объект, 	"ИННФЛ", 		ОрганизацияДиадокСсылка.ИНН);
			
		ИначеЕсли ОрганизацияДиадокСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ОрганИсполнительнойВласти Тогда
			
			XDTO_Установить(XDTO_Объект, 	"НаимОИВ", 		ОрганизацияДиадокСсылка.Наименование);
			
		ИначеЕсли ОрганизацияДиадокСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо 
			ИЛИ ОрганизацияДиадокСсылка.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйФизЛицо Тогда
			
			XDTO_СвИнНеУчТрН = XDTO_СвИнНеУчТрН(НомерТитула, Формат, ОрганизацияДиадокСсылка, ТипДокументооборота);
			XDTO_Установить(XDTO_Объект, 	"ДаннИно", 		XDTO_СвИнНеУчТрН);
			
		Иначе
			
			ВызватьИсключение "У организации " + ОрганизацияДиадокСсылка +  " не указан Тип Юр лица, не могу указать эту организацию в xml";
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ИННЮЛ) Тогда
			XDTO_Установить(XDTO_Объект, 	"ИННЮЛ", 		ИННЮЛ);
	ИначеЕсли ЗначениеЗаполнено(ИННФЛ) Тогда
			XDTO_Установить(XDTO_Объект, 	"ИННФЛ", 		ИННФЛ);
	ИначеЕсли ЗначениеЗаполнено(НаимОИВ) Тогда
			XDTO_Установить(XDTO_Объект, 	"НаимОИВ", 		НаимОИВ);
	ИначеЕсли XDTO_ДаннИно <> Неопределено Тогда
			XDTO_Установить(XDTO_Объект, 	"ДаннИно", 		XDTO_ДаннИно);
			
	КонецЕсли;
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ИнфПолСИдФайл(НомерТитула, Формат = Неопределено, СтрокаИнфПол, ПутьДочернегоОбъекта, ТипДокументооборота = "__etrnTitle") Экспорт
	
	XDTO_ИнфПол = НовыйДочернийОбъектXDTO(НомерТитула, "" + ПутьДочернегоОбъекта + ".ИнфПол", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ИнфПол, "ИдФайлИнфПол", СтрокаИнфПол.ИдФайлИнфПол);
	
	Возврат XDTO_ИнфПол; 
	
КонецФункции

Функция XDTO_ТекстИнф(НомерТитула, Формат = Неопределено, СтрокаИнфПол, ПутьДочернегоОбъекта, ТипДокументооборота = "__etrnTitle")
	
	XDTO_ИнфПолТекстИнф = НовыйДочернийОбъектXDTO(НомерТитула, "" + ПутьДочернегоОбъекта + ".ИнфПол.ТекстИнф", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ИнфПолТекстИнф, "Идентиф", СтрокаИнфПол.Идентиф); 
	XDTO_Установить(XDTO_ИнфПолТекстИнф, "Значение", СтрокаИнфПол.Значение); 
	
	Возврат XDTO_ИнфПолТекстИнф;
	
КонецФункции
	
// #КонецОбласти ПрикладныеXDTOобъекты

// #Область ЗаполненияГотовыхXDTO

Процедура XDTO_Адрес_ЗаполнитьИзОрганизацииДиадок(Знач XDTO_Адрес, Знач НомерТитула, Знач Формат, Знач ОрганизацияДиадок, Знач ТипДокументооборота = "__etrnTitle")
	
	Перем XDTO_АдрИнф;
	
	Если ЗначениеЗаполнено(ОрганизацияДиадок.АдресКодГАР) Тогда 
		Если ТипДокументооборота = "__ZZ" Тогда 
			ИмяСвойства = "АдрФИАС";
		Иначе
			ИмяСвойства = "КодГАР";
		КонецЕсли;
		XDTO_Установить(XDTO_Адрес, ИмяСвойства, ОрганизацияДиадок.АдресКодГАР);
		
	ИначеЕсли ЗначениеЗаполнено(ОрганизацияДиадок.АдресZipCode) И ЗначениеЗаполнено(ОрганизацияДиадок.АдресRegion) Тогда
		
		XDTO_АдрРФ = НовыйБазовыйОбъектXDTO(НомерТитула, "АдрРФТип", ТипДокументооборота, Формат);
		
		Если ТипДокументооборота = "__PL" И Формат = "5.02" Тогда		
			
			ТаблицаРегионовРФ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
			СтрокаРегион = ТаблицаРегионовРФ.Найти(ОрганизацияДиадок.АдресRegion, "Код");
			Если СтрокаРегион = Неопределено Или ОрганизацияДиадок.АдресRegion = "99" Тогда
				НаимРегион = "иные";
			Иначе
				НаимРегион = СтрокаРегион.Наименование;
			КонецЕсли;
			
			XDTO_Установить(XDTO_АдрРФ, "Индекс", ОрганизацияДиадок.АдресZipCode);
			XDTO_Установить(XDTO_АдрРФ, "КодРегион", ОрганизацияДиадок.АдресRegion);
			XDTO_Установить(XDTO_АдрРФ, "НаимРегион", НаимРегион);
			XDTO_Установить(XDTO_АдрРФ, "Город", ОрганизацияДиадок.АдресCity);
			XDTO_Установить(XDTO_АдрРФ, "Улица", ОрганизацияДиадок.АдресStreet);
			XDTO_Установить(XDTO_АдрРФ, "Дом", ОрганизацияДиадок.АдресBuilding);
		Иначе
			
			XDTO_Установить(XDTO_АдрРФ, "Индекс", ОрганизацияДиадок.АдресZipCode);
			XDTO_Установить(XDTO_АдрРФ, "КодРегион", ОрганизацияДиадок.АдресRegion);
			XDTO_Установить(XDTO_АдрРФ, "Район", ОрганизацияДиадок.АдресTerritory);
			XDTO_Установить(XDTO_АдрРФ, "Город", ОрганизацияДиадок.АдресCity);
			XDTO_Установить(XDTO_АдрРФ, "НаселПункт", ОрганизацияДиадок.АдресLocality);
			XDTO_Установить(XDTO_АдрРФ, "Улица", ОрганизацияДиадок.АдресStreet);
			XDTO_Установить(XDTO_АдрРФ, "Дом", ОрганизацияДиадок.АдресBuilding);
			XDTO_Установить(XDTO_АдрРФ, "Корпус", ОрганизацияДиадок.АдресBlock);
			XDTO_Установить(XDTO_АдрРФ, "Кварт", ОрганизацияДиадок.АдресApartment);
			
		КонецЕсли;
		
		XDTO_Установить(XDTO_Адрес, "АдрРФ", XDTO_АдрРФ);
		
	ИначеЕсли ЗначениеЗаполнено(ОрганизацияДиадок.АдресПредставление) Тогда
		
		XDTO_АдрИнф = НовыйБазовыйОбъектXDTO(НомерТитула, "АдрИнфТип", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_АдрИнф, "КодСтр", "643");
		XDTO_Установить(XDTO_АдрИнф, "АдрТекст", ОрганизацияДиадок.АдресПредставление);
		
		XDTO_Установить(XDTO_Адрес, "АдрИнф", XDTO_АдрИнф);
	Иначе
		
		ВызватьИсключение "У организации Диадок: " + ОрганизацияДиадок + " не заполнен ни один из адресов.";
	КонецЕсли;

КонецПроцедуры

Процедура XDTO_ИдСв_ЗаполнитьИзОрганизацииДиадок(Знач XDTO_ИдСв, Знач НомерТитула, Знач Формат, Знач ОрганизацияДиадок, Знач ТипДокументооборота = "__etrnTitle")
	
	Перем XDTO_СвИП, XDTO_СвЮЛУч, XDTO_ФИО;
	
	Если ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда
		
		Если ТипДокументооборота = "__ZZ" Или ТипДокументооборота = "__PL" Тогда 
			ИмяСвойства = "СвЮЛУчТип";
		Иначе
			ИмяСвойства = "СвЮЛУчТрНТип";
		КонецЕсли;
		XDTO_СвЮЛУч = НовыйБазовыйОбъектXDTO(НомерТитула, ИмяСвойства, ТипДокументооборота, Формат);
		
		XDTO_СвЮЛУч.НаимОрг = ОрганизацияДиадок.ИНН;
		XDTO_Установить(XDTO_СвЮЛУч, "НаимОрг", 	ОрганизацияДиадок.НаименованиеОрганизацииПолное);
		XDTO_Установить(XDTO_СвЮЛУч, "ИННЮЛ", 		ОрганизацияДиадок.ИНН);
		XDTO_Установить(XDTO_СвЮЛУч, "КПП", 		ОрганизацияДиадок.КПП);
		XDTO_Установить(XDTO_ИдСв,	 "СвЮЛУч", XDTO_СвЮЛУч);
		
	ИначеЕсли ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
		
		Если ТипДокументооборота = "__ZZ" Или ТипДокументооборота = "__PL" Тогда 
			ИмяСвойства = "СвИПТип";
		Иначе
			ИмяСвойства = "СвИПТрНТип";
		КонецЕсли;
		
		Если ТипДокументооборота = "__PL" Тогда 
			ИмяПоляИНН = "ИНН";
		Иначе
			ИмяПоляИНН = "ИННФЛ";
		КонецЕсли;
		
		XDTO_СвИП = НовыйБазовыйОбъектXDTO(НомерТитула, ИмяСвойства, ТипДокументооборота, Формат);
		
		XDTO_Установить(XDTO_СвИП, ИмяПоляИНН, 		ОрганизацияДиадок.ИНН);
		XDTO_Установить(XDTO_СвИП, "ОГРНИП", 		ОрганизацияДиадок.ОГРН);
		XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
		XDTO_Установить(XDTO_ФИО,	 "Фамилия", 	ОрганизацияДиадок.Фамилия);
		XDTO_Установить(XDTO_ФИО,	 "Имя",			ОрганизацияДиадок.Имя);
		XDTO_Установить(XDTO_ФИО,	 "Отчество", 	ОрганизацияДиадок.Отчество);
		XDTO_Установить(XDTO_СвИП, 	 "ФИО", 		XDTO_ФИО);
		
		XDTO_Установить(XDTO_ИдСв,	 "СвИП", 		XDTO_СвИП);
		
	ИначеЕсли ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо Тогда
		// TODO
		
	ИначеЕсли ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо 
		ИЛИ ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйФизЛицо Тогда
		
		XDTO_СвИнНеУчТрН = XDTO_СвИнНеУчТрН(НомерТитула, Формат, ОрганизацияДиадок, ТипДокументооборота);
		XDTO_Установить(XDTO_ИдСв,	 "СвИнНеУч", 		XDTO_СвИнНеУчТрН);
		
	Иначе
		Если ТипДокументооборота = "__etrnTitle" И НомерТитула = 1 Тогда 
			// прототип ТрН Т1 может и без этого
		Иначе
			ВызватьИсключение "У организации Диадок: " + ОрганизацияДиадок + " не указан тип ЮрЛица.";
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// форматом заведено отдельное определение типа без возможности указать Иностранное ЮЛ или физлицо
Процедура XDTO_ПЛ_СвЛицПЛ_ИдСв_ЗаполнитьИзОрганизацииДиадок(Знач XDTO_ИдСв, Знач НомерТитула, Знач Формат, Знач ОрганизацияДиадок, Знач ТипДокументооборота = "__etrnTitle")
	
