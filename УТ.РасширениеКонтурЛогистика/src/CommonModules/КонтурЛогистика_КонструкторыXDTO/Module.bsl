		Иначе
			ВызватьИсключение "Не поддерживается определение кода КНД по титулу номер " + НомерТитула + " " + ТипДокументооборота;
		КонецЕсли;
		
	ИначеЕсли ТипДокументооборота = "__PL" Тогда
		
		Если НомерТитула = 1 Тогда
			Возврат "1110380";
		ИначеЕсли НомерТитула = 2 Тогда
			Возврат "1110381";
		ИначеЕсли НомерТитула = 3 Тогда
			Возврат "1110382";
		ИначеЕсли НомерТитула = 4 И Формат = "5.01" Тогда
			Возврат "1110383";
		ИначеЕсли НомерТитула = 4 И Формат = "5.02" Тогда
			Возврат "1110384";
		ИначеЕсли НомерТитула = 5 И Формат = "5.01" Тогда
			Возврат "1110384";
		ИначеЕсли НомерТитула = 5 И Формат = "5.02" Тогда
			Возврат "1110385";
		ИначеЕсли НомерТитула = 6 Тогда
