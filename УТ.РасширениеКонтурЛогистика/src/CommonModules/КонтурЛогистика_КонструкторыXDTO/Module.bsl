		XDTO_Установить(XDTO_СвОдомЗаезд, "ДатВрЗаезд", 		XDTO_ДатаВремяВЗТип(ДокТитул5.ДатВрОдометр));
		XDTO_Установить(XDTO_СвОдомЗаезд, "НалКоорТочВрЗаезд", 	"1");
		XDTO_Установить(XDTO_СвОдомЗаезд, "ОдомЗаезд", 			ДокТитул5.ПоказанияОдометра);
		XDTO_Установить(XDTO_СодИнфЗаезд, "СвОдомЗаезд", 		XDTO_СвОдомЗаезд);
		
	КонецЕсли;
	
	//СвУплЛиц
	XDTO_СвОтвЛиц = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфЗаезд.СвУплЛиц", ТипДокументооборота, Формат);
	
	XDTO_Установить(XDTO_СвОтвЛиц, "Должн", ДокТитул5.Должность);
	XDTO_ФИО = НовыйБазовыйОбъектXDTO(НомерТитула, "ФИОТип", ТипДокументооборота, Формат);
	XDTO_Установить(XDTO_ФИО, "Фамилия", 	ОдометрРаботник.Фамилия);
	XDTO_Установить(XDTO_ФИО, "Имя", 		ОдометрРаботник.Имя);
	XDTO_Установить(XDTO_ФИО, "Отчество", 	ОдометрРаботник.Отчество);
	XDTO_Установить(XDTO_СвОтвЛиц, "ФИО", XDTO_ФИО);
	
	XDTO_Установить(XDTO_СодИнфЗаезд, "СвУплЛиц", XDTO_СвОтвЛиц);
	
	Возврат XDTO_СодИнфЗаезд;
	
