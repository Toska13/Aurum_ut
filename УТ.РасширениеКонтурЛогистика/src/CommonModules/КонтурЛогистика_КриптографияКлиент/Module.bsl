#Если Не ТолстыйКлиентОбычноеПриложение И Не ТолстыйКлиентУправляемоеПриложение Тогда

#Область МенеджерКриптографии

Функция НачатьИнициализациюМенеджераКриптографии(Оповещение, 
												ТипМодуля = Неопределено, 
												ИмяМодуля = Неопределено, 
												ИспользоватьИнтерактивныйРежим = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипМодуля) И Не ЗначениеЗаполнено(ИмяМодуля) Тогда
		
		ТипМодуля = 80;
		ИмяМодуля = "";
		
	КонецЕсли;
	
	ПутьМодуляКриптографии = "";
	
	Если Не КонтурЛогистика_КриптографияКлиентПовтИсп.ТипПлатформыWindows() Тогда
		
		Если Найти(ИмяМодуля, "Crypto-Pro") > 0 Тогда
			ПутьМодуляКриптографии = КонтурЛогистика_КриптографияКлиентПовтИсп.ПутьКМодулюCryptoPro();
		КонецЕсли;
		
	КонецЕсли;
	
	МенеджерКриптографии = Новый МенеджерКриптографии();
	Если ИспользоватьИнтерактивныйРежим
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ВерсияПриложенияНиже8_3_13() Тогда
		
		ИспользованиеИнтерактивногоРежима = Вычислить("ИспользованиеИнтерактивногоРежимаКриптографии.Использовать");
		МенеджерКриптографии.НачатьИнициализацию(Оповещение, "", ПутьМодуляКриптографии, ТипМодуля, ИспользованиеИнтерактивногоРежима);
	Иначе
		МенеджерКриптографии.НачатьИнициализацию(Оповещение, "", ПутьМодуляКриптографии, ТипМодуля);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область Подписание

Процедура ПодписатьАсинхронно(ОповещениеЗавершения, 
							 ДвоичныеДанные, 
							 ОтпечатокСертификата, 
							 ТипМодуля, 
							 ИмяМодуля, 
							 ПарольКонтейнера, 
							 ИспользоватьИнтерактивныйРежим) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата", ОтпечатокСертификата);
	ДополнительныеПараметры.Вставить("ПарольКонтейнера", ПарольКонтейнера);
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения", ОповещениеЗавершения);
	
	Оповещение = Новый ОписаниеОповещения("Подписать_ПолучениеСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПолучитьСертификатАсинхронно(Оповещение, ОтпечатокСертификата, ТипМодуля, ИмяМодуля, ИспользоватьИнтерактивныйРежим);
	
КонецПроцедуры

Процедура Подписать_ПолучениеСертификатаЗавершение(Сертификат, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(ДополнительныеПараметры.ПарольКонтейнера) Тогда
		ДополнительныеПараметры.МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ДополнительныеПараметры.ПарольКонтейнера;
	КонецЕсли;
	
	Попытка
		ДополнительныеПараметры.МенеджерКриптографии.НачатьПодписывание(ДополнительныеПараметры.ОповещениеЗавершения, ДополнительныеПараметры.ДвоичныеДанные, Сертификат);
	Исключение
		КонтурЛогистика_Метрика.ОбработатьОшибку("ПодписатьАсинхронно", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Сертификат);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ПолучениеСертификата

Процедура ПолучитьСертификатАсинхронно(ОповещениеЗавершения, 
									  ОтпечатокСертификата, 
									  ТипМодуля, 
									  ИмяМодуля, 
									  ИспользоватьИнтерактивныйРежим = Ложь) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата",	ОтпечатокСертификата);
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения",	ОповещениеЗавершения);
	ОповещениеПолучениеСертификатаЗавершение = Новый ОписаниеОповещения("ПолучениеСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры,
		"ОбработатьОшибкиПолученияСертификатов", ЭтотОбъект);
	
	ДополнительныеПараметры = Новый Структура;	
	ДополнительныеПараметры.Вставить("ОповещениеПолучениеСертификатаЗавершение", ОповещениеПолучениеСертификатаЗавершение);
	
	Оповещение = Новый ОписаниеОповещения("ПолучениеСертификата_ИнициализацияМенеджераЗавершение", ЭтотОбъект, ДополнительныеПараметры,
		"ОбработатьОшибкиПолученияСертификатов", ЭтотОбъект);
	НачатьИнициализациюМенеджераКриптографии(Оповещение, ТипМодуля, ИмяМодуля, ИспользоватьИнтерактивныйРежим);
	
КонецПроцедуры

Функция ПолучениеСертификатаЗавершение(Сертификаты, ДополнительныеПараметры) Экспорт
	
	НайтиСертификатПоОтпечатку(ДополнительныеПараметры.ОповещениеЗавершения, Сертификаты,
		ДополнительныеПараметры.ОтпечатокСертификата, ДополнительныеПараметры.МенеджерКриптографии);
	
КонецФункции

Функция НайтиСертификатПоОтпечатку(Оповещение, Сертификаты, ОтпечатокСертификата, МенеджерКриптографии) Экспорт
	
	Результат = "";
	
	Для каждого Сертификат Из Сертификаты Цикл
		
		ОтпечатокСертификатаСтрока = КонтурЛогистика_КриптографияКлиентСервер.HexСтрокаИзДвоичныхДанных(Сертификат.Отпечаток);
		
		Если НРег(ОтпечатокСертификатаСтрока) = НРег(ОтпечатокСертификата) Тогда
			
			Результат = Сертификат;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Оповещение.ДополнительныеПараметры.Вставить("МенеджерКриптографии", МенеджерКриптографии);
	
	ВыполнитьОбработкуОповещения(Оповещение, Результат);
	
КонецФункции

Функция ПолучениеСертификата_ИнициализацияМенеджераЗавершение(МенеджерКриптографии, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("МенеджерКриптографии", МенеджерКриптографии);
	
	Оповещение = Новый ОписаниеОповещения("ПолучениеСертификата_ПолучениеХранилищаСертификатов_Завершение", ЭтотОбъект, ДополнительныеПараметры,
		"ОбработатьОшибкиПолученияСертификатов", ЭтотОбъект);
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	МенеджерКриптографии.НачатьПолучениеХранилищаСертификатов(Оповещение, ПараметрыПоиска.ТипХранилища, ПараметрыПоиска.РасположениеХранилища);
	
КонецФункции

Функция ПолучениеСертификата_ПолучениеХранилищаСертификатов_Завершение(ХранилищеСертификатов, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.ОповещениеПолучениеСертификатаЗавершение.ДополнительныеПараметры.Вставить("МенеджерКриптографии", ДополнительныеПараметры.МенеджерКриптографии);
	
	ХранилищеСертификатов.НачатьПолучениеВсех(ДополнительныеПараметры.ОповещениеПолучениеСертификатаЗавершение);
	
КонецФункции

Функция ПараметрыПоискаСертификатов()
	
	Результат = Новый Структура;	
	Результат.Вставить("ТипХранилища",			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	Результат.Вставить("РасположениеХранилища",	РасположениеХранилищаСертификатовКриптографии.ДанныеПользователяОС);
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСертификата(Оповещение, ОтпечатокСертификата, ТипМодуля, ИмяМодуля) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения", Оповещение);
	
	ОповещениеПолучитьСертификатЗавершение = Новый ОписаниеОповещения(
		"ПолучитьДанныеСертификат_ПолучитьСертификатЗавершение", ЭтотОбъект, ДополнительныеПараметры,
		"ОбработатьОшибкиПолученияСертификатов", ЭтотОбъект);
	ПолучитьСертификатАсинхронно(ОповещениеПолучитьСертификатЗавершение, ОтпечатокСертификата, ТипМодуля, ИмяМодуля);
	
КонецФункции

Процедура ПолучитьДанныеСертификат_ПолучитьСертификатЗавершение(Сертификат, ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("НачатьВыгрузкуДанныхСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры,
		"ОбработатьОшибкиПолученияСертификатов", ЭтотОбъект);
	Сертификат.НачатьВыгрузку(Оповещение);
	
КонецПроцедуры

Процедура НачатьВыгрузкуДанныхСертификатаЗавершение(ДанныеСертификата, ДополнительныеПараметры) Экспорт
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеЗавершения, ДанныеСертификата);
	
КонецПроцедуры

Процедура ОбработатьОшибкиПолученияСертификатов(ИнформацияОбОшибке, СтандартнаяОбработка, Контекст) Экспорт
	
	// Исключение будет отображаться для пользователя
	СтандартнаяОбработка = Истина;
	
	Если ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
		Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Иначе
		Ошибка = ИнформацияОбОшибке;
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ОбработатьОшибку("ПолучитьСертификатАсинхронно", Ошибка, Контекст);
	
КонецПроцедуры

#КонецОбласти

#Область СписокСертификатов

Процедура ПолучитьСписокЛокальныхСертификатовАсинхронно(Оповещение) Экспорт 
	
	ОповещениеИнициализацияМенеджераЗавершение = Новый ОписаниеОповещения(
		"ПолучитьСписокЛокальныхСертификатов_ИнициализацияМенеджераЗавершение", ЭтотОбъект, Оповещение,
		"ОбработатьОшибкиПолученияЛокальныхСертификатов", ЭтотОбъект);
	НачатьИнициализациюМенеджераКриптографии(ОповещениеИнициализацияМенеджераЗавершение);
	
КонецПроцедуры

Процедура ПолучитьСписокЛокальныхСертификатовЗавершение(СертификатыКриптографии, Оповещение) Экспорт 
	
	СвойстваСертификата = КонтурЛогистика_КриптографияКлиентСервер.ВсеСвойстваСертификата();
	
	СписокСертификатов = Новый Массив;

	Для Каждого СертификатКриптографии Из СертификатыКриптографии Цикл
		
		СписокСертификатов.Добавить(КонтурЛогистика_КриптографияКлиентСервер.Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата));
		
	КонецЦикла;
	
	Результат = КонтурЛогистика_КриптографияКлиентСервер.ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов);
	
	ВыполнитьОбработкуОповещения(Оповещение, Результат);
		
КонецПроцедуры

Процедура ПолучитьСписокЛокальныхСертификатов_ИнициализацияМенеджераЗавершение(МенеджерКриптографии, ДополнительныеПараметры) Экспорт 
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьСписокЛокальныхСертификатов_ПолучениеХранилищаСертификатовЗавершение",
		ЭтотОбъект, ДополнительныеПараметры, "ОбработатьОшибкиПолученияЛокальныхСертификатов", ЭтотОбъект);
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ТипХранилища",			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	ПараметрыПоиска.Вставить("РасположениеХранилища",	РасположениеХранилищаСертификатовКриптографии.ДанныеПользователяОС);
	
	МенеджерКриптографии.НачатьПолучениеХранилищаСертификатов(Оповещение, ПараметрыПоиска.ТипХранилища, ПараметрыПоиска.РасположениеХранилища);
	
КонецПроцедуры

Процедура ПолучитьСписокЛокальныхСертификатов_ПолучениеХранилищаСертификатовЗавершение(Хранилище, ДополнительныеПараметры) Экспорт 
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьСписокЛокальныхСертификатовЗавершение",
		ЭтотОбъект, ДополнительныеПараметры, "ОбработатьОшибкиПолученияЛокальныхСертификатов", ЭтотОбъект);
	Хранилище.НачатьПолучениеВсех(Оповещение);
	
КонецПроцедуры

Процедура ОбработатьОшибкиПолученияЛокальныхСертификатов(ИнформацияОбОшибке, СтандартнаяОбработка, Контекст) Экспорт
	
	// Исключение будет отображаться для пользователя
	СтандартнаяОбработка = Истина;
	
	Если ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
		Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Иначе
		Ошибка = ИнформацияОбОшибке;
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ОбработатьОшибку("ПолучитьСписокЛокальныхСертификатовАсинхронно", Ошибка, Контекст);
	
КонецПроцедуры

#КонецОбласти

#Область Расшифровка

&НаКлиенте
Функция РасшифроватьДанныеАсинхронно(ОписаниеОповещения, ЗашифрованныеДвоичныеДанные, ПарольКонтейнера = Неопределено, ИспользоватьИнтерактивныйРежим = Ложь) Экспорт 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения",		ОписаниеОповещения);
	ДополнительныеПараметры.Вставить("ЗашифрованныеДвоичныеДанные",	ЗашифрованныеДвоичныеДанные);
	ДополнительныеПараметры.Вставить("ПарольКонтейнера",			ПарольКонтейнера);
	
	Оповещение = Новый ОписаниеОповещения("РасшифроватьДанные_Завершение", ЭтотОбъект, ДополнительныеПараметры);
	НачатьИнициализациюМенеджераКриптографии(Оповещение, , , ИспользоватьИнтерактивныйРежим);
	
КонецФункции

&НаКлиенте
Функция РасшифроватьДанные_Завершение(МенеджерКриптографии, ДополнительныеПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ПарольКонтейнера) Тогда		
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ДополнительныеПараметры.ПарольКонтейнера;
	КонецЕсли;
	
	МенеджерКриптографии.НачатьРасшифровку(ДополнительныеПараметры.ОповещениеЗавершения, ДополнительныеПараметры.ЗашифрованныеДвоичныеДанные);
	
КонецФункции

#КонецОбласти

#КонецЕсли

