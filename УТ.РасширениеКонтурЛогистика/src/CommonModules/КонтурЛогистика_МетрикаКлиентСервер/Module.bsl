Функция Новый_ОписаниеКонтекста() Экспорт
	
	Результат = Новый Структура();
	
	// необязательные
	
	Результат.Вставить("OS", 		Новый_ОписаниеКонтекста_OS()); 			// Информация об используемой ОС
	Результат.Вставить("Hardware", 	Новый_ОписаниеКонтекста_Hardware()); 	// Информация об используемом железе
	Результат.Вставить("Browser", 	Новый_ОписаниеКонтекста_Browser()); 	// Информация об используемом браузере
	Результат.Вставить("Platform", 	Новый_ОписаниеКонтекста_Platform()); 	// Информация об используемой платформе для приложения
	Результат.Вставить("AppVersion", ""); 									// Версия запущенного приложения.
	
	Возврат Результат;
	
КонецФункции

