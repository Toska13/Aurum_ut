Функция Новый_ОписаниеСессии() Экспорт
	
	Результат = Новый Структура();
	
	// необязательные
	
	Результат.Вставить("CustomSessionId", 		"");									// УИД пользовательской сессии.
	Результат.Вставить("PortalSession", 		Новый_ОписаниеСессииPortal());			// Портальная сессия пользователя.
	Результат.Вставить("NormativeSession", 		Новый_ОписаниеСессииNormative());		// Норматив сессия пользователя.
	Результат.Вставить("KeSession", 			Новый_ОписаниеСессииKe());				// Экстерн сессия пользователя.
	Результат.Вставить("KonturPassportSession", Новый_ОписаниеСессииKonturPassport());	// Сессия Контур.Паспорт.
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОписаниеСессииPortal() Экспорт
	
	Результат = Новый Структура();
	
	// необязательные
		
	Результат.Вставить("AuthSid", 		"");	// Кука, идентификатор портальной сессии, зашифрованные sid + userId. 
												// При отправке ОБЯЗАТЕЛЬНО хэшировать через функцию sha1.
												
	Результат.Вставить("Sid", 			"");	// Идентификатор портальной сессии. 
												// При отправке ОБЯЗАТЕЛЬНО хэшировать через функцию sha1.
												
	Результат.Вставить("PortalUserId", 	"");	// Идентификатор портального пользователя.	
		
	Возврат Результат;
	
КонецФункции

