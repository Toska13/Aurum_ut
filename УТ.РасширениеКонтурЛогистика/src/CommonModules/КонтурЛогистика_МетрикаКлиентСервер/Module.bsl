#Область ПрограммныйИнтерфейс

#Область Контракты

Функция Новый_СобытиеМетрики() Экспорт

	Результат = Новый Структура();
	
	// обязательные 
	
	Результат.Вставить("Id", 	НовыйУИД());					// Уникальный идентификатор события.
	Результат.Вставить("Path", 	Новый_ОписаниеМетрики());		// Информация о событии.
	Результат.Вставить("Time", 	Новый_МоментВремениМетрики());	// Временные метки, связанные с событием.

	// необязательные
	
	Результат.Вставить("ClientInstanceId", 	"");							// Уникальный идентификатор источника события.
	Результат.Вставить("Variables", 		Новый Соответствие());			// Произвольные пользовательские переменные.
	Результат.Вставить("Session", 			Новый_ОписаниеСессии());		// Информация о сессии пользователя.
	Результат.Вставить("TraceId", 			"");							// Идентификатор для связи с другими событиями.
	Результат.Вставить("AppContext", 		Новый_ОписаниеКонтекста());		// Контекст в котором запущено приложение.
	Результат.Вставить("ClientInfo", 		Новый_ОписаниеИнфоКлиента());	// Информация о клиенте, который отправил событие.
	

	Возврат Результат;

КонецФункции

Функция Новый_ОписаниеМетрики() Экспорт
	
	Результат = Новый Структура;
	
	// обязательные
	
	Результат.Вставить("Category", 	"");	// Категория событий, к которой относится данное событие.
	Результат.Вставить("Action", 	"");	// Действие породившее данное событие.
	
	// необязательные
	
	Результат.Вставить("Label", "");	// Дополнительная информация о событии.
	Результат.Вставить("View", 	"");	// Имя или идентификатор представления. Например, название или URL страницы
	
	Возврат Результат;
	
КонецФункции

