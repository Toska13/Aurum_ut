Функция Топики() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Поведение" , "Behavior");
	Результат.Вставить("Журнал" , "Log");
	Результат.Вставить("Здоровье" , "Health");
	Результат.Вставить("ОбратнаяСвязь" , "Feedback");
	Результат.Вставить("Статистика" , "Statistics");
	Результат.Вставить("ОбщепродуктоваяМетрика", "Common_Statistics");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Категории() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("СтатистикаСеанса", "Статистика сеанса");
	Результат.Вставить("КонтекстМодуля", "Контекст модуля");
	Результат.Вставить("Трафик", "Трафик");
	
	Результат.Вставить("Запуск", "Запуск");
	Результат.Вставить("Авторизация", "Авторизация");
	Результат.Вставить("Настройка", "Настройка");
	Результат.Вставить("ЦелевоеДействие", "Целевое действие");
	
	// Так же может быть любой тип метаданных без префикса "КонтурЛогистика_"
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Действия() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ОткрытиеОсновнойФормы", "Открытие основной формы");
	Результат.Вставить("ЗакрытиеОсновнойФормы", "Закрытие основной формы");
	Результат.Вставить("ОтправкаТрафика", "Отправка трафика");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ПараметрыМетодаДляФЗ(Действие = "", ДобавитьВОчередь = Ложь, СразуОтправить = Ложь) Экспорт
	
	Возврат Новый Структура("Действие, ДобавитьВОчередь, СразуОтправить", Действие, ДобавитьВОчередь, СразуОтправить);
	
КонецФункции

