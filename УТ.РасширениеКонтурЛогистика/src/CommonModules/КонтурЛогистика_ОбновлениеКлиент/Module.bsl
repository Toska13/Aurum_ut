КонецФункции

Функция ПроверяемаяВерсияНовееУстановленной(УстановленнаяВерсия, ПроверяемаяВерсия) Экспорт
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ПроверяемаяВерсия, УстановленнаяВерсия) > 0;
	
КонецФункции

Функция ТекстНадписиНоваяВерсияПодсистемы(ВерсияПодсистемыДоступная, ДоступнаяВерсияДатаВыхода) Экспорт
	
	КоличествоДнейСВыхода = (НачалоДня(ТекущаяДата()) - НачалоДня(ДоступнаяВерсияДатаВыхода)) / (60 * 60 * 24);
	ФормаМножественногоЧисла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ФормаМножественногоЧисла_("день", "дня", "дней", КоличествоДнейСВыхода);
	
	ТекстНадписи = "Доступна v " + ВерсияПодсистемыДоступная + " уже " + КоличествоДнейСВыхода + " " + ФормаМножественногоЧисла;
	
	Возврат ТекстНадписи;
	
КонецФункции

Процедура ПроверитьНаличиеУведомлений(Форма) Экспорт
	
	ИмяТекущейФомры = Форма.ИмяФормы;
	ИмяФормыРабочегоСтола = "Обработка.КонтурЛогистика_РабочийСтол.Форма.Форма";
	ЭтоРабочийСтол = (ИмяТекущейФомры = ИмяФормыРабочегоСтола);
	
	Если ЭтоРабочийСтол Тогда
		СостоянияУведомлений = КонтурЛогистика_ОбновлениеСервер.СостоянияУведомленийПользователя();
	Иначе
		СостоянияУведомлений = КонтурЛогистика_ОбновлениеСервер.СостоянияУведомленийПользователя(ИмяТекущейФомры);
	КонецЕсли;
	
	// Обновим отображение оповещения на фомре
	Если ЭтоРабочийСтол Тогда
		ОбновитьОтображениеУведомленийНаФорме(Форма, СостоянияУведомлений);
	КонецЕсли;
	
	// Покажем уведомления
	Если СостоянияУведомлений.ВсегоУведомлений > 0 Тогда
		ПараметрыФормы = Новый Структура;
		Если Не ЭтоРабочийСтол Тогда
			ПараметрыФормы.Вставить("ИмяФормы", ИмяТекущейФомры);
		КонецЕсли;
		
		ОткрытьФормуСпискаУведомленийПользователя(Форма, ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуСпискаУведомленийПользователя(Форма, ПараметрыФормы = Неопределено) Экспорт
	
	ПараметрыОбработчика = Новый Структура("Форма", Форма);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_УведомленияПользователя.Форма.ФормаСпискаУведомлений", ПараметрыФормы,,
		КонтурЛогистика_ОбновлениеКлиент, "ПоказУведомленийЗавершение", ПараметрыОбработчика);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПоказУведомленийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура")
		И ДополнительныеПараметры.Свойство("Форма") Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	
	ОбновитьОтображениеУведомленийНаФорме(Форма);
	
КонецПроцедуры

Процедура ОбновитьОтображениеУведомленийНаФорме(Форма, СостоянияУведомлений = Неопределено)
	
	Если СостоянияУведомлений = Неопределено Тогда
		СостоянияУведомлений = КонтурЛогистика_ОбновлениеСервер.СостоянияУведомленийПользователя();
	КонецЕсли;
	
	НайденныйЭлемент = Форма.Элементы.Найти("ФормаОткрытьУведомления");
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СостоянияУведомлений.ВсегоУведомлений = 0 Тогда
		ЦветФона = Новый Цвет;
	ИначеЕсли СостоянияУведомлений.ВажныхУведомлений <> 0 Тогда
		ЦветФона = Новый Цвет(237, 125, 125);
	Иначе
		ЦветФона = Новый Цвет(250, 227, 143)
	КонецЕсли;
	НайденныйЭлемент.ЦветФона = ЦветФона;
	
КонецПроцедуры

#КонецОбласти