	КонецЕсли;
	
	ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамСостГруз, "состояние груза - "));
	ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамРабВыгр, "разгрузочные работы - "));
	
	Возврат ОписаниеПоказателейИзМассива(ОписанияПоказателей);
	
КонецФункции

Функция ОписаниеПоказателейИзМассива(ОписанияПоказателей, Префикс = "", Постфикс = "", Разделитель = ", ") Экспорт 
	
	Описание = "";
	
	Если ОписанияПоказателей.Количество() Тогда
		
		СоединеннаяСтрока = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ОписанияПоказателей, Разделитель);
		
		Описание = СокрЛП(Префикс + СоединеннаяСтрока + Постфикс);
		
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции	

Функция ДобавитьОписаниеВМассив(Массив, Описание, ДобавитьПоказатель = Истина) Экспорт

	Если ЗначениеЗаполнено(Описание) Тогда 
		
		Массив.Добавить(Описание);
		
	КонецЕсли;	

КонецФункции 

Функция ОписаниеПоказателя(Показатель, Префикс = "", Постфикс = "", НольКакЗначение = Ложь) Экспорт

	Описание = "";
	
	Если ЗначениеЗаполнено(Показатель) Или НольКакЗначение Тогда 
		
		Описание = Префикс + Показатель + Постфикс;
		
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ОписаниеИтоговогоРазмераШтрафа(Отметка) 
	
	ОписанияПоказателей = Новый Массив;
	
	ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(Отметка.РасчШтр, "Расчет - "));
	ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(Формат(Отметка.ИтогРазмШтрРФ, "ЧДЦ=2; ЧГ=0"), "размер штрафа - "));
		
	Возврат ОписаниеПоказателейИзМассива(ОписанияПоказателей);	
	
КонецФункции	

Процедура ЗаполнитьОписанияПоказателей(Источник, ОписанияПоказателей, МассивПоказателей, ПрефиксыРеквизитов = "", ПостфиксыРеквизитов = "");
	
	ТелефоныСотрудника = Новый Массив;
	
	Для Каждого Показатель Из МассивПоказателей Цикл 
		
		Если Показатель = "Телефоны" Тогда 
			
			ЗначениеПоказателя = "";
			
			СтруктураПоиска = Новый Структура("ВидКонтактнойИнформации", Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации.Телефон);
			ВыборкаТелефоны = Источник.КонтактнаяИнформация.Выбрать();
			
			Пока ВыборкаТелефоны.НайтиСледующий(СтруктураПоиска) Цикл  
				
				ЗначениеПоказателя = ЗначениеПоказателя + ?(ПустаяСтрока(ЗначениеПоказателя), "", ", ") + СокрЛП(ВыборкаТелефоны.Значение); 
				
			КонецЦикла;
			
		ИначеЕсли Показатель = "ТелефонОсновной" Или Показатель = "ТелефонЗапасной" Тогда  
			
			ЗначениеПоказателя = "";
			
			Если ЗначениеЗаполнено(Источник[Показатель]) Тогда  
				
				ТелефоныСотрудника.Добавить(Источник[Показатель]);
				
			КонецЕсли;	
			
		ИначеЕсли Показатель = "ФамилияИО" Тогда  
			
			Имя 		= "";
			Отчество 	= "";
			
			Если ЗначениеЗаполнено(Источник.Имя) Тогда 
				
				Имя = Лев(Источник.Имя, 1) + ".";
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Источник.Отчество) Тогда 
				
				Отчество = Лев(Источник.Отчество, 1) + ".";
				
			КонецЕсли;
			
			ЗначениеПоказателя =  СокрЛП(Имя + Отчество + " " + Источник.Фамилия);
			
		ИначеЕсли Показатель = "ВУВодителя" Тогда
			
			Если ЗначениеЗаполнено(Источник.ВУДатаВыдачи) Тогда
				ЗначениеПоказателя = Источник[Показатель] + " от " + Формат(Источник.ВУДатаВыдачи, "ДФ=dd.MM.yyyy");
			Иначе
				ЗначениеПоказателя = Источник[Показатель];
			КонецЕсли;
			
		Иначе
			
			ЗначениеПоказателя = Источник[Показатель];
			
		КонецЕсли;
		
		Префикс = "";
		
		Если ТипЗнч(ПрефиксыРеквизитов) = Тип("Структура") И ПрефиксыРеквизитов.Свойство(Показатель) Тогда 
			
			Префикс = ПрефиксыРеквизитов[Показатель];
			
		КонецЕсли;
			
		Постфикс = "";
		
		Если ТипЗнч(ПостфиксыРеквизитов) = Тип("Структура") И ПостфиксыРеквизитов.Свойство(Показатель) Тогда 
			
			Постфикс = ПрефиксыРеквизитов[Показатель];
			
		КонецЕсли;
		
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ЗначениеПоказателя, Префикс, Постфикс));
		
	КонецЦикла;
	
	Если ТелефоныСотрудника.Количество() Тогда
		
		ОписаниеТелефоновСотрудника = ОписаниеПоказателейИзМассива(ТелефоныСотрудника, "тел.: ");
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеТелефоновСотрудника);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьВыбранныйПринтерДляПечати(ВыбранныйПринтер) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйПринтер) Тогда
		ЗаписанныйПринтер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяПринтераДляПечати");

		Если НЕ ЗначениеЗаполнено(ЗаписанныйПринтер) Тогда
			НастройкаИмяПринтераДляПечати = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного("ИмяПринтераДляПечати");
			НастройкаОбъект = НастройкаИмяПринтераДляПечати.ПолучитьОбъект();
			НастройкаОбъект.Значение = ВыбранныйПринтер;
			НастройкаОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтметитьДокументыРаспечатанными(МассивДокументов) Экспорт 
	
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОтметитьДокументыРаспечатанными(МассивДокументов);
	
