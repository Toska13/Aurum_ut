Функция ОписаниеПунктаМаршрута(ДанныеПунктов, ПунктМаршрута, ПунктМаршрутаСтрокаТЗ = Неопределено)
	
	Если Не ЗначениеЗаполнено(ПунктМаршрута) Тогда
		Возврат "";
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("ПунктМаршрута", ПунктМаршрута);
	НайденныеПункты = ДанныеПунктов.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеПункты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекущийПункт = НайденныеПункты[0];
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресИнфАдрес) Тогда
		ОписаниеАдреса = "РОССИЯ, " + ТекущийПункт.АдресИнфАдрес;
	Иначе
		ОписаниеАдреса = АдресПунктаМаршрутаПоЭлементам(ТекущийПункт);
	КонецЕсли;
	
	Если ПунктМаршрутаСтрокаТЗ <> Неопределено
		И ПунктМаршрутаСтрокаТЗ.Погрузка 
		И ЗначениеЗаполнено(ТекущийПункт.СобственникИНН) Тогда
		
		ОписаниеАдреса = ОписаниеАдреса + " (ИНН владельца: " + ТекущийПункт.СобственникИНН + ")";
	КонецЕсли;
	
	
	Если ПунктМаршрутаСтрокаТЗ <> Неопределено
		И (ПунктМаршрутаСтрокаТЗ.Погрузка Или ПунктМаршрутаСтрокаТЗ.Выгрузка) Тогда
		Если ПунктМаршрутаСтрокаТЗ.Погрузка Тогда
			ОперацияЭтогоПункта = " погрузки";
		ИначеЕсли ПунктМаршрутаСтрокаТЗ.Выгрузка Тогда
			ОперацияЭтогоПункта = " выгрузки";
		Иначе
			ОперацияЭтогоПункта = " операции";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПунктМаршрутаСтрокаТЗ.ДатВрОпер) Тогда
			ОписаниеАдреса = ОписаниеАдреса + Символы.ПС + "Дата и время" + ОперацияЭтогоПункта + " - " +
				Формат(ПунктМаршрутаСтрокаТЗ.ДатВрОпер, "ДФ='dd.MM.yyyy hh:mm';");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПунктМаршрутаСтрокаТЗ.ПредВрОпер) Тогда
			ОписаниеАдреса = ОписаниеАдреса + Символы.ПС + "Предельная длительность" + ОперацияЭтогоПункта + " - " +
				Формат(ПунктМаршрутаСтрокаТЗ.ПредВрОпер, "ДФ='hh:mm';");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОписаниеАдреса;
	
КонецФункции

Функция АдресПунктаМаршрутаПоЭлементам(ТекущийПункт)
	
	ПредставлениеРегиона = ТекущийПункт.АдресИндекс;
	Если ЗначениеЗаполнено(ТекущийПункт.АдресКодРегион) Тогда
		РегионыРФ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Код", ТекущийПункт.АдресКодРегион);
		
		НайденныеСтроки = РегионыРФ.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			ПредставлениеРегиона = НайденныеСтроки[0].Наименование;
		КонецЕсли;
	КонецЕсли;
	
	АдресПредставление = СокрЛП(""
		+ ТекущийПункт.АдресИндекс
		+ ?(ЗначениеЗаполнено(ПредставлениеРегиона), ", ", "")
		+ ПредставлениеРегиона);
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресРайон) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресРайон; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресГород) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресГород; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресНаселПункт) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресНаселПункт; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресУлица) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресУлица; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресДом) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресДом; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресКорпус) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресКорпус; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПункт.АдресКварт) Тогда 
		АдресПредставление = АдресПредставление + ", " + ТекущийПункт.АдресКварт; 	
	КонецЕсли;

	Возврат АдресПредставление;
	
КонецФункции

Функция ОписаниеГрузаЭЗЗ(Груз, ДанныеОпасныхГрузов)
	
	// Наименование
	ОписаниеГруза = Формат(Груз.КоличествоМест, "ЧГ=0;") + " " +
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьГрузовыеМестаВСклонении(Груз.КоличествоМест);
	
	// Кол-во мест, паллетов, делимость и распределимость
	Если ЗначениеЗаполнено(Груз.КоличествоПаллет) Тогда
		ОписаниеГруза = ОписаниеГруза + " (" + Груз.КоличествоПаллет + " " +
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьПаллетыВСклонении(Груз.КоличествоПаллет) + ")";
	КонецЕсли;
	
	ОписаниеГруза = ОписаниеГруза + " - " + ?(Груз.ДелГр, "делимый груз", "неделимый груз") +
		?(Груз.РаспрГр, ", возможно распределение по длине грузовой платформы", 
		", невозможно распределение по длине грузовой платформы") + Символы.ПС;
	
	// Состояние, вид тары			
	ОписаниеГруза = ОписаниеГруза + "Состояние груза: " + Груз.СостояниеГруза + "; вид тары: " + 
		НРег(Груз.ВидТары) + Символы.ПС;
	
	// Габариты, объем
	ОписаниеГруза = ОписаниеГруза + "Длина " + Груз.Длина + " м, ширина " + Груз.Ширина + " м, высота " + Груз.Высота + 
		" м, объем " + Груз.ОбъемКубМ + " куб.м" + Символы.ПС;
	
	// Масса
	ОписаниеГруза = ОписаниеГруза + "Масса брутто " + Груз.МассаПлановаяБруттоКг + " кг";
	
	Если Груз.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._01 Тогда
		ОписаниеГруза = ОписаниеГруза + " (взвешивание по общей массе)";
	ИначеЕсли Груз.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._02 Тогда
		ОписаниеГруза = ОписаниеГруза + " (взвешивание поосно)";
	ИначеЕсли Груз.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03 Тогда
		ОписаниеГруза = ОписаниеГруза + " (расчетная масса)";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Груз.МассаПлановаяНеттоКг) Тогда
		ОписаниеГруза = ОписаниеГруза + ", масса нетто " + Груз.МассаПлановаяНеттоКг + " кг";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Груз.МасТар) Тогда
		ОписаниеГруза = ОписаниеГруза + ", масса тары " + Груз.МасТар + " кг";
	КонецЕсли;
	
	
	
	// Контейнер
	Если НРег(Груз.ОтгрузочноеНаименование) = "контейнер" Тогда
		ОписаниеГруза = ОписаниеГруза + Символы.ПС;
		
		Если Груз.ПрГрКонт = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ПодачаПорожнегоКонтейнераГрузоотправителю Тогда
			ОписаниеГруза = ОписаниеГруза + "Перевозка порожнего контейнера";
		ИначеЕсли Груз.ПрГрКонт = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ПриемКПеревозкеГруженогоКонтейнера Тогда
			ОписаниеГруза = ОписаниеГруза + "Перевозка груженого контейнера";
		КонецЕсли;
		
		Если Груз.ПрГрКонт <> Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.НетКонтейнера Тогда
			Если Груз.УчВодПогрГр Тогда
				ОписаниеГруза = ОписаниеГруза + ", водитель участвует в погрузке";
			Иначе
				ОписаниеГруза = ОписаниеГруза + ", водитель не участвует в погрузке";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Другая информация
	Если ЗначениеЗаполнено(Груз.ДопИнформация) Тогда
		ОписаниеГруза = ОписаниеГруза + Символы.ПС + Груз.ДопИнформация;
	КонецЕсли;
	
	// Опасный груз
	ОпасныеГрузыТовар = ДанныеОпасныхГрузов.Скопировать(
		Новый Структура("ИдентификаторСтроки", Груз.ИдентификаторСтроки));
		
	Для Каждого ОпасныйГруз Из ОпасныеГрузыТовар Цикл
		ОписаниеГруза = ОписаниеГруза + Символы.ПС + ОписаниеОпасногоГруза(ОпасныйГруз);
	КонецЦикла;
	
	Возврат ОписаниеГруза;
	
КонецФункции

Функция ОписаниеОпасногоГруза(ОпасныйГруз)
	// https://www.proftrans-consult.com/DOPOG/dopog_05-04.html
	
	Если ЗначениеЗаполнено(ОпасныйГруз.тТехническоеНаименование) Тогда
		Префикс = "т"; // берем данные непосредственно из таблицы
	ИначеЕсли ЗначениеЗаполнено(ОпасныйГруз.ОписаниеОпасногоГруза) Тогда
		Префикс = "о"; // берем данные из справочника
	Иначе
		Возврат ""; // что-то пошло не так
	КонецЕсли;
	
	// a Код ООН
	Описание = ОпасныйГруз[Префикс + "НомерООН"] + " ";
	
	// b Наименования
	Описание = Описание + ВРег(ОпасныйГруз[Префикс + "НадлежащееОтгрузочноеНаименование"]);
	
	Если ЗначениеЗаполнено(ОпасныйГруз[Префикс + "ТехническоеНаименование"]) Тогда
		Описание = Описание + " (" + ОпасныйГруз[Префикс + "ТехническоеНаименование"] + ")";
	КонецЕсли;
	
	Описание = Описание + Символы.ПС;
	
	// c Класс опасности
	Описание = Описание + ОпасныйГруз[Префикс + "Класс"] + Символы.ПС;
	Описание = Описание + "Знак опасности: " + ОпасныйГруз[Префикс + "ЗнакОпасности"] + Символы.ПС;
	
	// d Группа упаковки
	Описание = Описание + "ГУ: " + ОпасныйГруз[Префикс + "ГруппаУпаковки"] + Символы.ПС;
	
	// k Код ограничения проезда через туннели
	Если ОпасныйГруз[Префикс + "КодОграниченияТуннели"] <> "-" Тогда
		Описание = Описание + "Код ограничения проезда через туннели: " + ОпасныйГруз[Префикс + "КодОграниченияТуннели"] +
			Символы.ПС;
	КонецЕсли;	
	
	// И только потом все остальное
	Если ОпасныйГруз[Префикс + "Класс"] = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс1 Тогда
		Описание = Описание + "Классификационный код: " + ОпасныйГруз[Префикс + "КлассификационныйКод"] +
			Символы.ПС +
			"Общая масса нетто взрывчатого содержимого: " + ОпасныйГруз[Префикс + "ОбМасНетВзрСод"] + Символы.ПС +
			"Общая масса нетто взрывчатого содержимого в килограммах для всех веществ и изделий: " +
			ОпасныйГруз[Префикс + "ОбМасНетВзрСодВсех"] + Символы.ПС;
	ИначеЕсли ОпасныйГруз[Префикс + "Класс"] = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс7 Тогда
		Описание = Описание + "Радионуклиды: " + ОпасныйГруз[Префикс + "Радионуклиды"] + Символы.ПС +
			"Описание физической и химической формы: " + ОпасныйГруз[Префикс + "ОписаниеФизХимФормы"] + Символы.ПС +
			"Максимальная активность радиоактивного содержимого во время перевозки: " + 
				ОпасныйГруз[Префикс + "МаксАктивностьРадиации"] + Символы.ПС +
			"Категория упаковки: " + ОпасныйГруз[Префикс + "КатегорияУпаковки"] + Символы.ПС +
			"Транспортный индекс: "  + ОпасныйГруз[Префикс + "ТранспортныйИндекс"] + Символы.ПС +
			"Индекс безопасности по критичности: " + ОпасныйГруз[Префикс + "ИндексБезопасности"] + Символы.ПС +
			"Опознавательный знак сертификатов: " + ОпасныйГруз[Префикс + "ОпознавательныйЗнакСертификатов"] + 
				Символы.ПС +
			"Полная активность груза: " + ОпасныйГруз[Префикс + "ПолнаяАктивностьГруза"] + Символы.ПС;
	ИначеЕсли ОпасныйГруз[Префикс + "Класс"] = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс2 Тогда
		// Класс 2 - состав смеси, дата истечения времени удержания
		Если ЗначениеЗаполнено(ОпасныйГруз[Префикс + "ПроцСмеси"]) Тогда
			Описание = Описание + "Процентный состав смеси: " + ОпасныйГруз[Префикс + "ПроцСмеси"] + Символы.ПС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОпасныйГруз[Префикс + "ДатаИстеченияВремениУдержания"]) Тогда
			Описание = Описание + "Дата истечения времени удержания: " + 
				Формат(ОпасныйГруз[Префикс + "ДатаИстеченияВремениУдержания"], "ДФ=dd.MM.yyyy;") + Символы.ПС;
		КонецЕсли;
	ИначеЕсли ОпасныйГруз[Префикс + "Класс"] = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс4_1 Или
		ОпасныйГруз[Префикс + "Класс"] = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс5_2 Тогда
		// Класс 4.1 и 5.2 - контрольная температура, аварийная температура	
		Если ЗначениеЗаполнено(ОпасныйГруз[Префикс + "КонтрольнаяТемпература"]) Тогда
			Описание = Описание + "Контольная температура: " + ОпасныйГруз[Префикс + "КонтрольнаяТемпература"] + Символы.ПС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОпасныйГруз[Префикс + "АварийнаяТемпература"]) Тогда
			Описание = Описание + "Аварийная температура: " + ОпасныйГруз[Префикс + "АварийнаяТемпература"] + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОпасныйГруз[Префикс + "Описание"]) Тогда
		Описание = Описание + ОпасныйГруз[Префикс + "Описание"] + Символы.ПС;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ОписаниеУсловийРасчетовЭЗЗ(Шапка)
	
	Если ЗначениеЗаполнено(Шапка.Титул2Расчет) Тогда
		Описание = Шапка.Титул2Расчет;
	Иначе
		Если Шапка.Титул2НалСт = Перечисления.КонтурЛогистика_СтавкиНДС.БезНДС Тогда
			Описание = Строка(Шапка.Титул2СтоимостьБезНДС) + "руб. (НДС не облагается)";
		Иначе
			Описание = Строка(Шапка.Титул2СтоимостьБезНДС) + "руб. (без учета НДС) / " +
				Строка(Шапка.Титул2СтоимостьСНДС) + " руб. (с учетом НДС " + Строка(Шапка.Титул2НалСт) + ")";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ОписаниеТранспортногоСредстваЭЗЗ(ДанныеТС, ТранспортноеСредство, ДанныеДоговоров)
	
	Если Не ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Возврат "";
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("ТранспортноеСредство", ТранспортноеСредство);
	НайденныеТС = ДанныеТС.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеТС.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТС = НайденныеТС[0];
	
	Описание = ТС.ТипТС + " " + ТС.МаркаТС + ?(ЗначениеЗаполнено(ТС.МодельТС), " " + ТС.МодельТС, "") + " " +
		ТС.РегНомер + Символы.ПС;
		
	Описание = Описание + "Грузоподъемность " + ТС.ГрузоподъемностьТонн + " т, вместимость " + 
		ТС.ВместимостьКубМ + " куб.м" + Символы.ПС;
	
	Если ТС.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1 Тогда
		Описание = Описание + "В собственности";
	ИначеЕсли ТС.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.СовместнаяСобственностьСупругов_2 Тогда
		Описание = Описание + "В совместной собственности супругов";
	ИначеЕсли ТС.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Аренда_3 Тогда
		Описание = Описание + "В аренде (" + ОписаниеДоговораЭЗЗ(ДанныеДоговоров, ТС.ДоговорАрендаЛизинг) + ")";
	ИначеЕсли ТС.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Лизинг_4 Тогда
		Описание = Описание + "В лизинге (" + ОписаниеДоговораЭЗЗ(ДанныеДоговоров, ТС.ДоговорАрендаЛизинг) + ")";
	ИначеЕсли ТС.ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.БезвозмездноеПользование_5 Тогда
		Описание = Описание + "В безвозмездном пользовании (" + ОписаниеДоговораЭЗЗ(ДанныеДоговоров, ТС.ДоговорАрендаЛизинг) + ")";
	КонецЕсли;
		
	Возврат Описание;
	
КонецФункции

Функция ОписаниеСпецРазрешения(СпецРазрешение)
	
	Если ЗначениеЗаполнено(СпецРазрешение.ИдСР) Тогда
		Описание = "Идентификатор разрешения " + СпецРазрешение.ИдСР;
	Иначе
		Описание = "Специальное разрешение от " + Формат(СпецРазрешение.ДатаСР, "ДФ=dd.MM.yyyy;") + " № " +
			СпецРазрешение.НомСР + Символы.ПС +
			"Срок действия: " + СпецРазрешение.СрокСР + Символы.ПС +
			"Кем выдано: " + СпецРазрешение.НаимОИВ;
		Если ЗначениеЗаполнено(СпецРазрешение.СведМрш_МршТекст) Тогда
			Описание = Описание + Символы.ПС + "Маршрут: " + СпецРазрешение.СведМрш_МршТекст;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ИмяПечатнойФормыЭТРНДляПрисоединенныхФайлов() Экспорт
	
