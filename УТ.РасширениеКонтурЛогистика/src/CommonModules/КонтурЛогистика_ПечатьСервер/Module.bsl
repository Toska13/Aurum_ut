Функция ОписаниеОрганизации_(ВыборкаОрганизации, Организация, СписокПоказателей = "") Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "";
	КонецЕсли;
	
	ОписанияПоказателей = Новый Массив;
	
	ПрефиксыРеквизитов = Новый Структура;
	ПрефиксыРеквизитов.Вставить("ИНН", "ИНН ");
	ПрефиксыРеквизитов.Вставить("КПП", "КПП ");
	ПрефиксыРеквизитов.Вставить("Телефоны", "тел.: ");
	
	ВыборкаОрганизации.Сбросить();
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		
		Если ВыборкаОрганизации.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокПоказателей = "" Тогда
			СписокПоказателей = "ПолноеНаименование,ИНН,КПП,ЮридическийАдрес,ТелефонОсновной";
		КонецЕсли;
		
		Если ВыборкаОрганизации.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо
			Или ВыборкаОрганизации.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
			
			СписокПоказателей = "ПолноеНаименование,ИНН,ЮридическийАдрес";
		КонецЕсли;
		
		Показатели = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СписокПоказателей);
		
		ЗаполнитьОписанияПоказателей(ВыборкаОрганизации, ОписанияПоказателей, Показатели, ПрефиксыРеквизитов);
		
		Прервать;
		
	КонецЦикла;
	
	ОписаниеОрганизации = ОписаниеПоказателейИзМассива(ОписанияПоказателей);
	
	Возврат ОписаниеОрганизации;
	
КонецФункции

