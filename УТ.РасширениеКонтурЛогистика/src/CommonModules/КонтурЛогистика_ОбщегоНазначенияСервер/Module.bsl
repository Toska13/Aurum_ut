Функция НеобходимыеНастройкиДляРаботыПодсистемыЗаполнены() Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("ТекСтраницаПомошника", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстДействия", "");
	
	// Проверка, что корректно заполнены типы реквизита "Значение" справочника "КонтурЛогистика_Настройки"
	МассивУстановленныхТипов = Метаданные.Справочники.КонтурЛогистика_Настройки.Реквизиты.Значение.Тип.Типы();
	
	ТаблицаНастроек = Справочники.КонтурЛогистика_Настройки.ТаблицаНастроекПоУмолчанию();
	МассивТиповПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СвернутьМассив_(ТаблицаНастроек.ВыгрузитьКолонку("ТипЗначения"));
	
	МассивНеУстановленныхТипов = Новый Массив;
	
	Для Каждого ТипСтрока Из МассивТиповПоУмолчанию Цикл
		
		Если ЗначениеЗаполнено(ТипСтрока)
			И МассивУстановленныхТипов.Найти(Тип(ТипСтрока)) = Неопределено Тогда
			
			МассивНеУстановленныхТипов.Добавить(ТипСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивНеУстановленныхТипов.Количество() Тогда
		
		ТипыСтрокой = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МассивНеУстановленныхТипов, ", ");
		
		Результат.ТекСтраницаПомошника = "ВводЛогинаПароля";
		Результат.ТекстОшибки = "Для реквизита ""Значение"" справочника ""КонтурЛогистика_Настройки"" не указаны типы: "
			+ ТипыСтрокой;
		Результат.ТекстДействия = "Откройте конфигуратор и для реквизита ""Значение"" справочника ""КонтурЛогистика_Настройки"" настройте типы: "
			+ ТипыСтрокой;
		
	КонецЕсли;
	
	// Проверка заполненности логина и пароля
	РежимАвторизации = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("РежимАвторизации");
	
	Если РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПароль
		Или РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПарольИApiKey Тогда
		
		API_Логин = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", "ЛогинАвторизацииДиадокАПИ");
		API_Пароль = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", "ПарольАвторизацииДиадокАПИ");
		
		Если Не ЗначениеЗаполнено(API_Логин.Значение) Или Не ЗначениеЗаполнено(API_Пароль.Значение) Тогда 
			
			Результат.ТекСтраницаПомошника = "ВводЛогинаПароля";
			Результат.ТекстОшибки = "Не указаны логин или пароль от сервиса Диадок";
			Результат.ТекстДействия = "Укажите логин или пароль от сервиса Диадок";
			
			Возврат Результат;
			
		Иначе
			
			Попытка
				
				ПолученныйТокен = КонтурЛогистика_API_Диадок.Диадок_АПИ_Authenticate_ЛогинПароль(API_Логин.Значение, API_Пароль.Значение);
				
				Если Не ЗначениеЗаполнено(ПолученныйТокен) Тогда
					
					Результат.ТекСтраницаПомошника = "ВводЛогинаПароля";
					Результат.ТекстОшибки = "Логин или пароль от сервиса Диадок указаны не верно";
					Результат.ТекстДействия = "Укажите правильные логин и пароль от сервиса Диадок";
					
					Возврат Результат;
					
				КонецЕсли;
				
			Исключение
				
				Результат.ТекСтраницаПомошника = "ВводЛогинаПароля";
				Результат.ТекстОшибки = ОписаниеОшибки();
				Результат.ТекстДействия = "Укажите правильные логин и пароль от сервиса Диадок";
				
			КонецПопытки;
			
		КонецЕсли;
		
	ИначеЕсли РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow Тогда
		
		// Проверим аутентификацию по OIDC
		ЕстьАвторизации = ЕстьПортальныеАвторизации();
		
		Если Не ЕстьАвторизации Тогда
			
			Результат.ТекСтраницаПомошника = "ВводЛогинаПароля";
			Результат.ТекстОшибки = "Необходимо выполнить авторизацию в сервис Контур.Диадок";
			Результат.ТекстДействия = "Авторизоваться в сервисе Контур.Диадок";
			
			Возврат Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверка настройки организаций и настроек конвертации
	ЛюбаяНашаОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЛюбаяНашаОрганизация();
	Если ЛюбаяНашаОрганизация = Неопределено Тогда
		
		Результат.ТекСтраницаПомошника = "МоиОрганизации";
		Результат.ТекстОшибки = "Не выбрана ни одна орнанизация для работы с ЭТрН";
		Результат.ТекстДействия = "Установите флаг ""Наша"" в стартовом помошнике или флаг ""Наш"" в карточке организации";
		
		Возврат Результат;
		
	КонецЕсли;
	
	// Проверка заполнения Apikey
	Если РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ApiKey
		И РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПарольИApiKey Тогда
		
		ТочноеСовпадение = Ложь;
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
		Если Не ЗначениеЗаполнено(ПараметрыСервиса.ApiKey) Тогда
			
			Результат.ТекСтраницаПомошника = "МоиОрганизации";
			Результат.ТекстОшибки = "Для режима авторизации """ + РежимАвторизации
				+ """ хотя бы для одной нашей организации должен быть указан Api key";
			Результат.ТекстДействия = "Заполните Api key для любой организации с флагом ""Наша"" в "
				+ "стартовом помошнике или настройку ""Logistics api key"" в карточке организации";
			
			Возврат Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьНашиГО = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГОВОрганизациях();
	ЕстьНашиГП = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГПВОрганизациях();
	ЕстьНашиПВ = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиПВВОрганизациях();
	
	ЕстьОформитель 	= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Оформитель");
	ЕстьМедик 		= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Медик");
	ЕстьТехОсмотр 	= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("ТехОсмотр");
	ЕстьОдометр 	= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Одометр");

	ИспользуетсяТРН = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользуетсяТРН");
	
	Если ИспользуетсяТРН Тогда
		
		Если Не ЕстьНашиГО
			И Не ЕстьНашиГП
			И Не ЕстьНашиПВ
			И Не ЕстьОформитель
			И Не ЕстьМедик
			И Не ЕстьТехОсмотр
			И Не ЕстьОдометр Тогда
			
			Результат.ТекСтраницаПомошника = "МоиОрганизации";
			Результат.ТекстОшибки = "Не указаны роли для наших организаций";
			Результат.ТекстДействия = "Укажите роли для наших организаций";
			
			Возврат Результат;
			
