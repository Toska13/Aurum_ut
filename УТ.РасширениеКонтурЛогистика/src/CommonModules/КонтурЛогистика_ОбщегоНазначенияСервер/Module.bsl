Функция НастройкиДополнительныхРеквизитовЗаполнены() Экспорт
	
	Если Метаданные.Справочники.Найти("КонтурЛогистика_НастройкиДополнительныхРеквизитов") = Неопределено Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	СправочникКонтурЛогистика_НастройкиДополнительныхРеквизитов = Вычислить("Справочники.КонтурЛогистика_НастройкиДополнительныхРеквизитов");
	
	Выборка = СправочникКонтурЛогистика_НастройкиДополнительныхРеквизитов.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьНастройкиДополнительныхРеквизитов(ПерезаполнитьНастройкиКонвертации = Ложь, ТихийРежим = Ложь) Экспорт
	КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСервер.ЗаполнитьНастройкиДополнительныхРеквизитов(ПерезаполнитьНастройкиКонвертации, ТихийРежим);
	КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыОФ.ЗаполнитьНастройкиДополнительныхРеквизитов(ПерезаполнитьНастройкиКонвертации, ТихийРежим);
КонецПроцедуры

Процедура ДобавитьДополнительныйРеквизитВНКД(НастройкаКонвертацииОбъект, ИмяРеквизита, ИмяДополнительногоРеквизита) Экспорт
	
	Если НастройкаКонвертацииОбъект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или НастройкаКонвертацииОбъект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или НастройкаКонвертацииОбъект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда 
		ЕстьТовары = Истина;
	Иначе
		ЕстьТовары = Ложь;
	КонецЕсли;
	
	Если НастройкаКонвертацииОбъект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				
		СформироватьРеквизитДляНКД(НастройкаКонвертацииОбъект.ПравилаКонвертацииГлавногоДокумента, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяГлавногоДокументаКонтурЛогистика(НастройкаКонвертацииОбъект.ТипДокументаЛогистика), 
			ИмяРеквизита, ИмяДополнительногоРеквизита);
				
		СформироватьРеквизитДляНКД(НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаРеквизиты, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НастройкаКонвертацииОбъект.ТипДокументаЛогистика), 
			ИмяРеквизита, ИмяДополнительногоРеквизита);	
						
	Иначе
		
		СформироватьРеквизитДляНКД(НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаРеквизиты, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НастройкаКонвертацииОбъект.ТипДокументаЛогистика), 
			ИмяРеквизита, ИмяДополнительногоРеквизита);
		
	КонецЕсли;
		
	Если ЕстьТовары Тогда 
		СформироватьРеквизитДляНКД(НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаТабЧастьТовары, 
			"ТЧ" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НастройкаКонвертацииОбъект.ТипДокументаЛогистика), 
			ИмяРеквизита, ИмяДополнительногоРеквизита);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьДополнительныйРеквизитВНКС(НастройкаКонвертацииОбъект, ИмяРеквизита, ИмяДополнительногоРеквизита) Экспорт
	
	РеквизитОбъектМетаданных = Метаданные.Справочники[НастройкаКонвертацииОбъект.ТипСправочникаЛогистика].Реквизиты.Найти(ИмяРеквизита);
	
	Если РеквизитОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	НоваяСтрокаТч = НастройкаКонвертацииОбъект.ПравилаКонвертации.Добавить();
	НоваяСтрокаТч.РеквизитСправочникаЛогистика = РеквизитОбъектМетаданных.Имя;
	НоваяСтрокаТч.Картинка = 3;
	НоваяСтрокаТч.РеквизитСправочникаЛогистикаТипЗначения = РеквизитОбъектМетаданных.Тип;
	НоваяСтрокаТч.РеквизитСправочникаЛогистикаПредставление = РеквизитОбъектМетаданных.Синоним;
	НоваяСтрокаТч.РеквизитСправочникаЛогистикаКомментарий = РеквизитОбъектМетаданных.Комментарий;	
			
	НоваяСтрокаТч.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС;
	НоваяСтрокаТч.ВыражениеВычисления = ИмяДополнительногоРеквизита;	
				
	НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
			
КонецПроцедуры

Процедура СформироватьРеквизитДляНКД(ТабличнаяЧастьНастройки, Знач ИмяДокЛогистика, ИмяРеквизита, ИмяДополнительногоРеквизита)
	
	Если Лев(ИмяДокЛогистика,2) = "ТЧ" Тогда
		ЭтоТЧ = Истина;
		ИмяДокЛогистика = Сред(ИмяДокЛогистика, 3);
		МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].ТабличныеЧасти.Товары.Реквизиты;
	Иначе
		ЭтоТЧ = Ложь;
		МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].Реквизиты;
	КонецЕсли;
	
	РеквизитОбъектМетаданных = МетаданыеРеквизитов.Найти(ИмяРеквизита);
	
	Если РеквизитОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	НоваяСтрокаТч = ТабличнаяЧастьНастройки.Добавить();
	НоваяСтрокаТч.РеквизитТитула = РеквизитОбъектМетаданных.Имя;
	НоваяСтрокаТч.Картинка = 3;
	НоваяСтрокаТч.РеквизитТитулаТипЗначения = РеквизитОбъектМетаданных.Тип;
	НоваяСтрокаТч.РеквизитТитулаКомментарий = РеквизитОбъектМетаданных.Комментарий;	
			
	НоваяСтрокаТч.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования;
	НоваяСтрокаТч.ВыражениеВычисления = ИмяДополнительногоРеквизита;	
				
	НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
	
КонецПроцедуры

Процедура ВыполнитьНастройкуАвтоконвертации(СписокНастроекКонвертации, НастройкаДопРеквизита, ЭтоРеквизитТЧ, ИмяДополнительногоРеквизита, СвойстваАвтоконвертации) Экспорт
	            		
	НастройкаКонвертации = Неопределено;
	ДоступныеПравилаКонвертации = Новый Массив;
	Если ТипЗнч(СвойстваАвтоконвертации.ТипОбъектаЛогистика) = Тип("Строка") Тогда
		
		Отбор = Новый Структура("РеквизитСправочникаЛогистика", СвойстваАвтоконвертации.РеквизитСправочникаИлиДокументаЛогистика);
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкуКонвертации(
			СвойстваАвтоконвертации.ТипОбъекта1С, СвойстваАвтоконвертации.ТипОбъектаЛогистика, СвойстваАвтоконвертации.РеквизитТитула);
			
		ДоступныеПравилаКонвертации.Добавить("ПравилаКонвертации");
		
		СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС;
		
	Иначе
		
		Отбор = Новый Структура("РеквизитТитула", СвойстваАвтоконвертации.РеквизитСправочникаИлиДокументаЛогистика);
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
			СвойстваАвтоконвертации.ТипОбъектаЛогистика, СвойстваАвтоконвертации.ТипОбъекта1С);
			
		Если ЭтоРеквизитТЧ Тогда
			ДоступныеПравилаКонвертации.Добавить("ПравилаКонвертацииТитулаТабЧастьТовары");	
		Иначе
			ДоступныеПравилаКонвертации.Добавить("ПравилаКонвертацииГлавногоДокумента");
			ДоступныеПравилаКонвертации.Добавить("ПравилаКонвертацииТитулаРеквизиты");
		КонецЕсли;
		
		СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования;
		
	КонецЕсли;
				
	Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		Возврат;	
	КонецЕсли;
	
	НастройкаКонвертацииОбъект = НастройкаКонвертации.ПолучитьОбъект();
		
	НастройкаИзменена = Ложь;
	РеквизитЕстьВНастройкеКонвертации = Ложь;
		
	Для каждого ИмяПравилаКонвертации Из ДоступныеПравилаКонвертации Цикл
		
		ПравилаКонвертацииТЧ = НастройкаКонвертацииОбъект[ИмяПравилаКонвертации].НайтиСтроки(Отбор);
	
		Если ПравилаКонвертацииТЧ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитЕстьВНастройкеКонвертации = Истина;
				
		Для каждого ПравилоКонвертацииСтрока Из ПравилаКонвертацииТЧ Цикл
			
			Если ЗначениеЗаполнено(НастройкаДопРеквизита) И НастройкаДопРеквизита.Отображать Тогда
				Если Не (ПравилоКонвертацииСтрока.СпособМаппинга = СпособМаппинга И ПравилоКонвертацииСтрока.ВыражениеВычисления = ИмяДополнительногоРеквизита) Тогда
					ПравилоКонвертацииСтрока.СпособМаппинга = СпособМаппинга;
					ПравилоКонвертацииСтрока.ВыражениеВычисления = ИмяДополнительногоРеквизита;
					НастройкаИзменена = Истина;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(НастройкаДопРеквизита) И Не НастройкаДопРеквизита.Отображать Тогда
				Если ПравилоКонвертацииСтрока.СпособМаппинга = СпособМаппинга И ПравилоКонвертацииСтрока.ВыражениеВычисления = ИмяДополнительногоРеквизита Тогда
					ПравилоКонвертацииСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
					ПравилоКонвертацииСтрока.ВыражениеВычисления = "";
					НастройкаИзменена = Истина;
				КонецЕсли;
			Иначе
				Если ПравилоКонвертацииСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять Тогда
					ПравилоКонвертацииСтрока.СпособМаппинга = СпособМаппинга;
					ПравилоКонвертацииСтрока.ВыражениеВычисления = ИмяДополнительногоРеквизита;
					НастройкаИзменена = Истина;
				КонецЕсли;
			КонецЕсли;		
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Не РеквизитЕстьВНастройкеКонвертации И 
		(ЗначениеЗаполнено(НастройкаДопРеквизита) И НастройкаДопРеквизита.Отображать 
			Или Не ЗначениеЗаполнено(НастройкаДопРеквизита)) Тогда
			
		Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьДополнительныйРеквизитВНКД(НастройкаКонвертацииОбъект, СвойстваАвтоконвертации.РеквизитСправочникаИлиДокументаЛогистика, ИмяДополнительногоРеквизита);
		Иначе
			КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьДополнительныйРеквизитВНКС(НастройкаКонвертацииОбъект, СвойстваАвтоконвертации.РеквизитСправочникаИлиДокументаЛогистика, ИмяДополнительногоРеквизита)
		КонецЕсли;
		
		НастройкаИзменена = Истина;
		
	КонецЕсли;
	
	Если НастройкаИзменена Тогда
		
		НастройкаКонвертацииОбъект.Записать();
		
		Если СписокНастроекКонвертации.Найти(НастройкаКонвертацииОбъект.Ссылка) = Неопределено Тогда
			СписокНастроекКонвертации.Добавить(НастройкаКонвертацииОбъект.Ссылка);
		КонецЕсли;
		
	КонецЕсли;						
			
КонецПроцедуры

Процедура ВывестиСообщенияЗаполненияНастроекДополнительнымиРеквизитами(СписокНастроекКонвертации) Экспорт
	
	Если СписокНастроекКонвертации.Количество() > 0 Тогда
		
		Для каждого НастройкаКонвертации Из СписокНастроекКонвертации Цикл
			Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников") Тогда
				ТипНастройки = "НКС";
			Иначе
				ТипНастройки = "НКД";
			КонецЕсли;
			Сообщить("Заполнение " + ТипНастройки + " " + """" + НастройкаКонвертации.Наименование + """" + " дополнительными реквизитами выполнено");
		КонецЦикла;
		
	Иначе

		Сообщить("Настройки конвертации в актульном состоянии");	
		
	КонецЕсли;
	
КонецПроцедуры

#Область Аутентификация

Функция ДанныеАутентификацииПоОрганизации(Знач Организация = Неопределено, Знач boxID = Неопределено) Экспорт
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(Организация, boxID);
	
	// Аутентификация не выполнялась
	Если Не ЗначениеЗаполнено(ДанныеАутентификации.ТокенДоступа) Тогда
		Возврат ДанныеАутентификации;
	КонецЕсли;
	
	// Токен доступа не просрочен
	Если ДанныеАутентификации.ДатаОкончания > ТекущаяДатаСеанса() Тогда
		ДанныеАутентификации.Успех = Истина;
		Возврат ДанныеАутентификации;
	КонецЕсли;
	
	// Пробуем обновить токен
	Результат = ОбновитьСессиюОрганизации(ДанныеАутентификации.Организация);
	Если Результат Тогда
		
		ОбновитьПовторноИспользуемыеЗначения();
		ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(Организация, boxID);
		Если ДанныеАутентификации.ДатаОкончания > ТекущаяДатаСеанса() Тогда
			ДанныеАутентификации.Успех = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеАутентификации;
	
КонецФункции

Функция ДанныеАутентификацииЛюбойОрганизации() Экспорт
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииЛюбойОрганизации();
	
	// Аутентификация не выполнялась
	Если Не ЗначениеЗаполнено(ДанныеАутентификации.ТокенДоступа) Тогда
		Возврат ДанныеАутентификации;
	КонецЕсли;
	
	// Токен доступа не просрочен
	Если ДанныеАутентификации.ДатаОкончания > ТекущаяДатаСеанса() Тогда
		ДанныеАутентификации.Успех = Истина;
		Возврат ДанныеАутентификации;
	КонецЕсли;
	
	// Пробуем обновить токен
	Результат = ОбновитьСессиюОрганизации(ДанныеАутентификации.Организация);
	Если Результат Тогда
		
		ОбновитьПовторноИспользуемыеЗначения();
		ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(ДанныеАутентификации.Организация);
		Если ДанныеАутентификации.ДатаОкончания > ТекущаяДатаСеанса() Тогда
			ДанныеАутентификации.Успех = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеАутентификации;
	
КонецФункции

Функция ОбновитьСессиюОрганизации(Знач Организация)
	
	// Сформируем отбор сессии
	ОтборСессий = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОтборСессий(Организация);
	
	// Инициализируем библиотеку аутентификации
	Аутентификатор = КлиентАутентификации(ОтборСессий);
	
	// Получаем текущую сессию
	ТекущаяСессия = Аутентификатор.ПолучитьСессию();
	
	Если ТекущаяСессия = Неопределено Тогда
		// Сессия отсутствует или невалидна
		Возврат Ложь;
	Иначе
		// Сессия обновлена
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция КлиентАутентификации(Знач ОтборСессий = Неопределено)
	
	ИспользоватьТестовыйСерверДиадок = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользоватьТестовыйСерверДиадок");
	КонфигурацияПриложения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонфигурацияПриложения(ИспользоватьТестовыйСерверДиадок);
	КонфигурацияПровайдера = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонфигурацияПровайдера(ИспользоватьТестовыйСерверДиадок);
	Если ОтборСессий = Неопределено Тогда
		Отбор = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОтборСессий();
	Иначе
		Отбор = ОтборСессий;
	КонецЕсли;
	
	Результат = Обработки.КонтурЛогистика_Аутентификатор.Создать();
	Результат.УстановитьКонфигурациюПриложения(КонфигурацияПриложения);
	Результат.УстановитьКонфигурациюПровайдера(КонфигурацияПровайдера);
	Результат.УстановитьХранилищеСессий("КонтурЛогистика_Аутентификация");
	Результат.УстановитьОтборСессий(Отбор);
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьСессиюАутентификацииПоОрганизации(Организация) Экспорт
	
	ОтборСессий = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОтборСессий(Организация);
	
	УведомлятьАдминистратора = Ложь;
	РегистрыСведений.КонтурЛогистика_Аутентификация.УдалитьСессию(ОтборСессий, УведомлятьАдминистратора);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

Процедура ОчиститьВсеАвторизации() Экспорт
	
	РегистрыСведений.КонтурЛогистика_Аутентификация.ОчиститьВсеАвторизации();
	
КонецПроцедуры

Функция ЕстьПортальныеАвторизации() Экспорт
	
	Возврат РегистрыСведений.КонтурЛогистика_Аутентификация.ЕстьАвторизации();
	
КонецФункции

Процедура ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка, ТипДокумента, ТаблицаОшибок) Экспорт
	
	// Проверка только для OIDC
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	Если РежимАвторизации <> Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow Тогда
		Возврат;
	КонецЕсли;
		
	// Определим отправителя файла
	ОтправительФайла = Неопределено;
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда
		
		// ЭТрН
		ДокументЭТРН = ДокументОбъектИлиСсылка.ДокументЭТРН;
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			
			Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.Составитель) Тогда
				
				ОтправительФайла = ДокументОбъектИлиСсылка.Составитель;
				
			ИначеЕсли ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку
				И ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет) Тогда
				
				ОтправительФайла = ДокументЭТРН.ПогрузкуОсуществляет;
				
			Иначе
				
				ОтправительФайла = ДокументЭТРН.Грузоотправитель;
				
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
			
			ОтправительФайла = ДокументОбъектИлиСсылка.ДокументЭТРН.Перевозчик;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			
			Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.Грузополучатель) Тогда 
				ОтправительФайла = ДокументОбъектИлиСсылка.Грузополучатель;
			Иначе
				ОтправительФайла = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузополучатель;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
			
			ОтправительФайла = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузоотправитель;
			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		
		// Путевой лист
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			
			ОтправительФайла = ДокументОбъектИлиСсылка.ЛицоОформившееПЛ;
			
		Иначе
			
			Титул1 = ДокументОбъектИлиСсылка.Титул1;
			Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
				Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				ОтправительФайла = ?(ОргМедикСторонняя, Титул1.ОрганизацияМедик, Титул1.ЛицоОформившееПЛ);
				
			ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
				
				ОргТехСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияТехСостояние) И Титул1.ОрганизацияТехСостояние <> Титул1.ЛицоОформившееПЛ;
				ОтправительФайла = ?(ОргТехСторонняя, Титул1.ОрганизацияТехСостояние, Титул1.ЛицоОформившееПЛ);
				
			ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
				
				ОргОдометрСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияОдометр) И Титул1.ОрганизацияОдометр <> Титул1.ЛицоОформившееПЛ;
				ОтправительФайла = ?(ОргОдометрСторонняя, Титул1.ОрганизацияОдометр, Титул1.ЛицоОформившееПЛ);
				
			ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
				
				ОргОдометрСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияОдометр) И Титул1.ОрганизацияОдометр <> Титул1.ЛицоОформившееПЛ;
				ОтправительФайла = ?(ОргОдометрСторонняя, Титул1.ОрганизацияОдометр, Титул1.ЛицоОформившееПЛ);
				
			ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
				Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				ОтправительФайла = ?(ОргМедикСторонняя, Титул1.ОрганизацияМедик, Титул1.ЛицоОформившееПЛ);			
				
			ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02
				Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
				
				ОтправительФайла = ДокументОбъектИлиСсылка.Титул1.ЛицоОформившееПЛ;
				
			КонецЕсли;
			
		КонецЕсли;
			
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокумента) Тогда
		
		// Заказ (заявка)
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			
			ОтправительФайла = ДокументОбъектИлиСсылка.Грузоотправитель;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
			
			ОтправительФайла = ДокументОбъектИлиСсылка.Титул1.Перевозчик;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтправительФайла) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем авторизацию отправителя файла
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОтправительФайла);
	Если ПараметрыСервиса.РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow
		И Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		
		КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
		ТекстОшибки = "Организация отправитель не авторизована";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок,,,, КатегорияОшибка, ТекстОшибки, "Авторизоваться");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ЕстьНастройкиКонвертацииДокументов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	Не КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

#КонецОбласти

#Область НастройкиПользователей

Функция УстановитьНастройкуПоказыватьТехническиеКомандыНаРабочемСтоле() Экспорт
	
	Если (КонтурЛогистика_Привилегированный.РольСуществует("КонтурЛогистика_НастройкаПодсистемы") 
			И РольДоступна("КонтурЛогистика_НастройкаПодсистемы"))
		 Или (КонтурЛогистика_Привилегированный.РольСуществует("КонтурЛогистика_ПолныеПраваЛогистика") 
		 	И РольДоступна("КонтурЛогистика_ПолныеПраваЛогистика"))
		 Или (КонтурЛогистика_Привилегированный.РольСуществует("КонтурЛогистика_УдалитьАдминистратор") 
		 	И РольДоступна("КонтурЛогистика_УдалитьАдминистратор"))
		 Или (КонтурЛогистика_Привилегированный.РольСуществует("КонтурЛогистика_УдалитьПродвинутыйПользователь") 
		 	И РольДоступна("КонтурЛогистика_УдалитьПродвинутыйПользователь"))
		Или (КонтурЛогистика_Привилегированный.РольСуществует("УчетнаяСистема_Администрирование") 
		 	И РольДоступна("УчетнаяСистема_Администрирование"))
		Или (КонтурЛогистика_Привилегированный.РольСуществует("АдминистраторСистемы") 
		 	И РольДоступна("АдминистраторСистемы")) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ПереносСопоставленийОрганизацийМодулейКонтура

Функция ПереносСопоставленийОрганизацийСОбъектамиУС(ОрганизацииДиадок, ПараметрыУстановкиМодулейКонтура) Экспорт
	
	Результат = Ложь;
	
	Для Каждого ТекущаяОрганизация Из ОрганизацииДиадок Цикл
		
		АдресЯщикаДиадок = КонтурЛогистика_API_Диадок.ИдентификаторВАдресЯщика(ТекущаяОрганизация.Ссылка.ID);
		ОрганизацииСопоставленные = ПереносСопоставленийОрганизацииСОбъектамиУС(АдресЯщикаДиадок, ПараметрыУстановкиМодулейКонтура);
		
		Если ОрганизацииСопоставленные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Перенесем связи в карточку
		ОрганизацияОбъект = ТекущаяОрганизация.Ссылка.ПолучитьОбъект();
		Для Каждого ТекущаяСопоставленнаяОрганизация Из ОрганизацииСопоставленные Цикл
			
			// Проверим дубли
			ЕстьДубли = Ложь;
			Для Каждого ТекущаяСвязь Из ОрганизацияОбъект.СвязанныеОбъекты Цикл
				Если ТекущаяСвязь.СвязанныйОбъект = ТекущаяСопоставленнаяОрганизация Тогда
					ЕстьДубли = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьДубли Тогда
				Прервать;
			КонецЕсли;
			
			НоваяСтрока = ОрганизацияОбъект.СвязанныеОбъекты.Добавить();
			НоваяСтрока.СвязанныйОбъект = ТекущаяСопоставленнаяОрганизация;
			
		КонецЦикла;
		
		// Почистим пустые строки
		НаУдаление = Новый Массив;
		Для Каждого ТекущаяСвязь Из ОрганизацияОбъект.СвязанныеОбъекты Цикл
			Если ЗначениеЗаполнено(ТекущаяСвязь.СвязанныйОбъект) Тогда
				Продолжить;
			КонецЕсли;
			
			НаУдаление.Добавить(ТекущаяСвязь);
		КонецЦикла;
		Для Каждого ТекущаяСтрокаНаУдаление Из НаУдаление Цикл
			ОрганизацияОбъект.СвязанныеОбъекты.Удалить(ТекущаяСтрокаНаУдаление);
		КонецЦикла;
		
		Попытка
			ОрганизацияОбъект.Записать();
			Результат = Истина;
		Исключение
			НичегоНеДелаем = Истина;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПереносСопоставленийОрганизацииСОбъектамиУС(АдресЯщикаДиадок, ПараметрыУстановкиМодулейКонтура)
	
	Результат = Новый Массив;
	
	Если ПараметрыУстановкиМодулейКонтура = Неопределено Тогда
		
		ПараметрыУстановкиМодулейКонтура = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПараметрыУстановкиМодулей();
		
	КонецЕсли;
	
	Если ПараметрыУстановкиМодулейКонтура.Диадок.МодульУстановлен Тогда
		
		СопоставленныеОрганизации = СопоставленныеОрганизацииДиадок(ПараметрыУстановкиМодулейКонтура.Диадок, АдресЯщикаДиадок);
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, СопоставленныеОрганизации);
		
	КонецЕсли;
	
	Если Результат.Количество() = 0 И ПараметрыУстановкиМодулейКонтура.EDI.МодульУстановлен Тогда
		
		СопоставленныеОрганизации = СопоставленныеОрганизацииEDI(АдресЯщикаДиадок);
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, СопоставленныеОрганизации);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СопоставленныеОрганизацииДиадок(НастройкиДиадок, АдресЯщикаДиадок)
	
	Результат = Новый Массив;
	
	Если НастройкиДиадок.ИспользоватьТиповуюПодсистему1С Тогда
		
		// Получи свойство по имени настройки
		ИмяСвойства = "ЯщикДиадокДляОрганизации";
		Если НастройкиДиадок.ЭтоУФ Тогда
			СвойствоНастройки = ПланыВидовХарактеристик["ДополнительныеРеквизитыИСведения"].НайтиПоНаименованию(ИмяСвойства, Истина);
		Иначе
			СвойствоНастройки = ПланыВидовХарактеристик["СвойстваОбъектов"].НайтиПоНаименованию(ИмяСвойства, Истина);
		КонецЕсли;
		
		Если СвойствоНастройки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Получим значение по свойству
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство", СвойствоНастройки);
		Запрос.УстановитьПараметр("Значение", АдресЯщикаДиадок);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Свойство = &Свойство
		|	И ЗначенияСвойствОбъектов.Значение = &Значение";
		
		Если НастройкиДиадок.ЭтоУФ Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗначенияСвойствОбъектов", "ДополнительныеСведения");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Объект) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.Добавить(Выборка.Объект);
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИмяСправочника", "Организации");
		Запрос.УстановитьПараметр("ID", АдресЯщикаДиадок);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Диадок_ЮрФизЛица.СвязанныйСправочник1 КАК СвязанныйСправочник1,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник2 КАК СвязанныйСправочник2,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник3 КАК СвязанныйСправочник3
		|ИЗ
		|	Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
		|ГДЕ
		|	Диадок_ЮрФизЛица.ИмяСправочника = &ИмяСправочника
		|	И Диадок_ЮрФизЛица.ID = &ID";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник1) Тогда
				Результат.Добавить(Выборка.СвязанныйСправочник1);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник2) Тогда
				Результат.Добавить(Выборка.СвязанныйСправочник2);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник3) Тогда
				Результат.Добавить(Выборка.СвязанныйСправочник3);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СопоставленныеОрганизацииEDI(АдресЯщикаДиадок)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", "DiadocBoxId");
	Запрос.УстановитьПараметр("Значение", АдресЯщикаДиадок);
	
	Запрос.Текст =
