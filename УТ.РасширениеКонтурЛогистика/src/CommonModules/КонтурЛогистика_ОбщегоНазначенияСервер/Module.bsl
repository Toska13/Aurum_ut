КонецФункции

Процедура ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены, ТабличнаяЧасть, ИменаРеквизитовТаблицы)
	
	Для Каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл
		
		Для Каждого ТенкущееИмяРеквизита Из ИменаРеквизитовТаблицы Цикл
			
			ТекущаяСтрока[ТенкущееИмяРеквизита] = СтрЗаменить(ТекущаяСтрока[ТенкущееИмяРеквизита], ПодстрокаПоиска, ПодстрокаЗамены);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеДоступностьюФормПоГруппамДоступа(Форма)
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ДоступыПользователя = ДоступыПользователя(ТекущийПользователь);
	
	ПолныйДоступ = ДоступыПользователя.ПолныйДоступ;
	
	Если ПолныйДоступ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоФормаСписка = (Найти(Форма.ИмяФормы, "ФормаСписка") <> 0);
	ЭтоФормаВыбора = (Найти(Форма.ИмяФормы, "ФормаВыбора") <> 0);
	
	// Справочники
	Если Лев(Форма.ИмяФормы, 11) = "Справочник." Тогда
		
		ИмяСправочника = СтрЗаменить(Форма.ИмяФормы, "Справочник.", "");
		Если ЭтоФормаСписка Тогда
			ИмяСправочника = СтрЗаменить(ИмяСправочника, ".ФормаСписка", "");
		ИначеЕсли ЭтоФормаВыбора Тогда
			ИмяСправочника = СтрЗаменить(ИмяСправочника, ".ФормаВыбора", "");
		Иначе
			ИмяСправочника = СтрЗаменить(ИмяСправочника, ".ФормаЭлемента", "");
		КонецЕсли;
		ИмяСправочника = СтрЗаменить(ИмяСправочника, ".Форма", "");
		
		ДоступКСправочникам = ДоступыПользователя.ДоступКСправочникам;
		
		ТолькоПросмотрЭлементов = ДоступКСправочникам.ТолькоПросмотр.Получить(ИмяСправочника);
		СозданиеРедактированиеЭлементов = ДоступКСправочникам.СозданиеРедактирование.Получить(ИмяСправочника);
		
	// Документы
	ИначеЕсли Лев(Форма.ИмяФормы, 9) = "Документ." Тогда
		
		ИмяТипаДокумента = СтрЗаменить(Форма.ИмяФормы, "Документ.", "");
		Если ЭтоФормаСписка Тогда
			ИмяТипаДокумента = СтрЗаменить(ИмяТипаДокумента, ".ФормаСписка", "");
		ИначеЕсли ЭтоФормаВыбора Тогда
			ИмяТипаДокумента = СтрЗаменить(ИмяТипаДокумента, ".ФормаВыбора", "");
		Иначе
			ИмяТипаДокумента = СтрЗаменить(ИмяТипаДокумента, ".ФормаДокумента", "");
		КонецЕсли;
		ИмяТипаДокумента = СтрЗаменить(ИмяТипаДокумента, ".Форма", "");
		ИмяТипаДокумента = СтрЗаменить(ИмяТипаДокумента, "КонтурЛогистика_", "");
		ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СсылкаПоИмени(ИмяТипаДокумента);
		
		ДоступКТитулам = ДоступыПользователя.ДоступКТитулам;
		
		Если ЗначениеЗаполнено(ТипДокумента) Тогда
			
			// По титулам
			ТолькоПросмотрЭлементов = ДоступКТитулам.ТолькоПросмотр.Получить(ТипДокумента);
			СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТипДокумента);
			
		Иначе
			
			// Главные документы
			Если ИмяТипаДокумента = "ЭлектроннаяТранспортнаяНакладная" Тогда
				
				СозданиеРедактированиеЭлементов =
					(ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1)
						Или ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2)
						Или ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
						Или ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4));
				
				Если СозданиеРедактированиеЭлементов Тогда
					ТолькоПросмотрЭлементов = Ложь;
				Иначе
					ТолькоПросмотрЭлементов =
						(ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1)
							Или ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2)
							Или ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
							Или ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4));
				КонецЕсли;
				
			ИначеЕсли ИмяТипаДокумента = "ЭлектронныйЗаказНаряд" Тогда
				
				СозданиеРедактированиеЭлементов =
					(ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1)
						Или ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2)
						Или ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3)
						Или ДоступКТитулам.СозданиеРедактирование.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4));
				
				Если СозданиеРедактированиеЭлементов Тогда
					ТолькоПросмотрЭлементов = Ложь;
				Иначе
					ТолькоПросмотрЭлементов =
						(ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1)
							Или ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2)
							Или ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3)
							Или ДоступКТитулам.ТолькоПросмотр.Получить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4));
				КонецЕсли;
				
			ИначеЕсли ИмяТипаДокумента = "ЭлектроннаяСопроводительнаяВедомость" Тогда
				// TODO - Не понятно как расчитать
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если ТолькоПросмотрЭлементов = Неопределено Или СозданиеРедактированиеЭлементов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотрЭлементов И Не СозданиеРедактированиеЭлементов Тогда
		ВызватьИсключение "У вас нет доступа. Обратитесь к администратору.";
	КонецЕсли;
	
	Форма.ТолькоПросмотр = ТолькоПросмотрЭлементов;
	
	Если Форма.ТолькоПросмотр Тогда
		СкрытьЭлементФормы(Форма, "ФормаГруппаЗаполнитьИз");
		СкрытьЭлементФормы(Форма, "ДобавитьИзДиадока");
		
		СкрытьЭлементФормы(Форма, "ВнестиИсправлениеТитула");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПропуститьОбработкуВходящегоДокумента");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ОтказатьсяВПодписи");
		
		// ПодменюУправление
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_СформироватьФайлыОбмена");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПропуститьДокумент");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ИзменитьСтатусДокумента");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ИзменитьСтатусДокумента1");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ИзменитьСостояниеДокумента");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыЛогистика");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыДиадок");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ВнестиИсправлениеТитула");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ВвестиСледующийТитул");
	КонецЕсли;
	
КонецПроцедуры

Процедура СкрытьЭлементФормы(Форма, ИмяЭлемента)
	
	НайденныйЭлемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйЭлемент.Видимость = Ложь;
	НайденныйЭлемент.Доступность = Ложь;
	
КонецПроцедуры

Процедура УправлениеСтатусомПодписиИКолбасойТитулов(Форма) Экспорт
	
	ТекТитулСсылка = Форма.Объект.Ссылка;
	Если ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1");
	ИначеЕсли ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектронныйЗаказНаряд") Тогда
		ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1");
	ИначеЕсли ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость") Тогда
		ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1");
	Иначе
		ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТекТитулСсылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипТитула) Тогда 
		Возврат;
	КонецЕсли;
	
	НомерТекТипа = Число(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипТитула));
	
	Если Не ЗначениеЗаполнено(ТекТитулСсылка) И НомерТекТипа = "1" Тогда
		Возврат; // В незаписанном Т1 можно не выполнять запросы - ничего еще нет, а дефолтная колбаса в титуле верная
	КонецЕсли;
	
	// Вывести статусы подписи сертификата и МЧД
	УправлениеСтатусомПодписиИМЧД(Форма);
	
	// Вывести команды для документа учетной системы
	УправлениеКомандамиДокументаУчетнойСистемы(Форма);
	
	// Вывести команды настройки НКД и перезаполнения титула
	УправлениеКомандамиПерезаполненияТитула(Форма);
	
	// Вывести панель обратного маппинга
	УпралениеПанельюОбработкиДокументаОбратнымМаппингом(Форма, ТипТитула);
	
	// Реализовано для ПЛ, ТРН и ЗЗ
	Если Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипТитула)
		И Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипТитула)
		И Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипТитула)
		И Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипТитула) Тогда
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекТитулСсылка) Тогда
		ГлавныйДокумент = ОпределитьГлавныйДокументПриПустойСсылкеТекущего(ТекТитулСсылка, Форма);
	Иначе
		ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ТекТитулСсылка);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Путевой Лист
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ТекТитулСсылка) Тогда
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипТитула) Тогда
			УправлениеКолбасойТитуловПЛ_5_02(ГлавныйДокумент, ТекТитулСсылка, ТипТитула, Форма);
		Иначе
			УправлениеКолбасойТитуловПЛ(ГлавныйДокумент, ТекТитулСсылка, ТипТитула, Форма);
		КонецЕсли;
		
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// ТрН
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипТитула) Тогда
		
		// В эту таблицу попадут только успешно доставленные/полученные документы
		ТаблицаСостояний = ПолучитьТаблицуТитуловПеревозкиТРН(ГлавныйДокумент);
		
		ТаблицаСостоянийСвернутая = ТаблицаСостояний.Скопировать();
		ТаблицаСостоянийСвернутая.Свернуть("НомерТитула");
		
		УправлениеКолбасойТитуловТРН(НомерТекТипа, ТаблицаСостояний, ТаблицаСостоянийСвернутая, ТекТитулСсылка, Форма);
		
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Заказ-Заявка
	
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипТитула) Тогда
		
		УправлениеКолбасойТитуловЗЗ(ГлавныйДокумент, ТекТитулСсылка, ТипТитула, Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьГлавныйДокументПриПустойСсылкеТекущего(Знач ТекТитулСсылка, Знач Форма)
	
	ГлавныйДокумент = Неопределено;
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ТекТитулСсылка) Тогда 
		ГлавныйДокумент = Форма.Объект.ДокументЭТРН;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ТекТитулСсылка) 
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(ТекТитулСсылка) 
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулДФ(ТекТитулСсылка) Тогда
		Если ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02")
			Или ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")  
			Или ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1") Тогда 
			ГлавныйДокумент = ТекТитулСсылка;
			
		Иначе
			ГлавныйДокумент = Форма.Объект.Титул1;
		КонецЕсли;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗН(ТекТитулСсылка) Тогда
		ГлавныйДокумент = Форма.Объект.ДокументЗН;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулСВ(ТекТитулСсылка) Тогда
		ГлавныйДокумент = Форма.Объект.ДокументСВ;
		
	Иначе
		ГлавныйДокумент = Неопределено;
	КонецЕсли;

	Возврат ГлавныйДокумент;
	
КонецФункции

Процедура УправлениеКолбасойТитуловПЛ(Знач ГлавныйДокумент, Знач ТекТитулСсылка, Знач ТипТитула, Знач Форма)
	
	Перем ДваВодителя, НомерТитула, ОбязательныйМО, стрНомерТитула, СтрокаДокументаТ1, СтрокаДокументаЭтапа, СтрокиДокументовЭтогоЭтапа, ТаблицаСостояний, ТаблицаСостоянийСвернутая, Титул2ТекущийВодитель, Титул6ТекущийВодитель, ЭлементГруппаПункт, ЭлементДобавитьЕщеТитул, ЭлементПункт, ЭлементСоединитель;
	
	ОбязательныйМО = Ложь;
	ДваВодителя = Ложь;
	Титул2ТекущийВодитель = Неопределено;  // требуется если сейчас открыта Т2
	Титул6ТекущийВодитель = Неопределено;  // требуется если сейчас открыта Т6
	Форма.Элементы["ИконкаОтправитьQR"].Доступность = Ложь; // далее дадим доступ если сейчас в рейсе
	Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Ложь; // далее дадим доступ если сейчас в рейсе
		
	Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		
		ДваВодителя = ЗначениеЗаполнено(Форма.Объект.Водитель2);
		ОбязательныйМО = Форма.Объект.ОбязМедосмотрПосле;
		Если ОбязательныйМО Тогда 
			Форма.Элементы.Найти("Пункт6").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
			Форма.Элементы.Найти("Пункт6доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
		Иначе
			Форма.Элементы.Найти("Пункт6").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущийНеобязательный;
			Форма.Элементы.Найти("Пункт6доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущийНеобязательный;
		КонецЕсли;
		
	ИначеЕсли ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		
		Титул2ТекущийВодитель = Форма.Объект.Водитель;
		
	ИначеЕсли ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		
		Титул6ТекущийВодитель = Форма.Объект.Водитель;	
		
	КонецЕсли;
	
	// в эту таблицу попадут только успешно доставленные/полученные документы
	ТаблицаСостояний = ПолучитьТаблицуТитуловПеревозкиПЛ(ГлавныйДокумент);
	
	// Отказ в подписи Т2 внешним медиком
	Если ГлавныйДокумент.ЕстьОтказВПодписи И Не ГлавныйДокумент.ОрганизацияМедик.Наш Тогда
		
		// Добавим мнимый титул 2 с отказом, так как при отказе не оформляется титул.
		НоваяСтрока = ТаблицаСостояний.Добавить();
		НоваяСтрока.Титул = Документы.КонтурЛогистика_ПЛ_Титул2.ПустаяСсылка();
		НоваяСтрока.НомерТитула = 2;
		НоваяСтрока.ЕстьОтказВПодписи = Истина;
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Водитель2) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерТитула", 2);
			ПараметрыОтбора.Вставить("Водитель", ГлавныйДокумент.Водитель);
			
			НайденныеСтроки = ТаблицаСостояний.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока.Водитель = ГлавныйДокумент.Водитель;
			Иначе
				НоваяСтрока.Водитель = ГлавныйДокумент.Водитель2;
			КонецЕсли;
		Иначе
			НоваяСтрока.Водитель = ГлавныйДокумент.Водитель;
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаСостоянийСвернутая = ТаблицаСостояний.Скопировать();
	ТаблицаСостоянийСвернутая.Свернуть("НомерТитула");
	
	СтрокаДокументаТ1 = Неопределено;
	
	Для Каждого стрНомерТитула Из ТаблицаСостоянийСвернутая Цикл
		
		НомерТитула = стрНомерТитула.НомерТитула;
		
		СтрокиДокументовЭтогоЭтапа = ТаблицаСостояний.НайтиСтроки(Новый Структура("НомерТитула", НомерТитула));
		
		ЭлементГруппаПункт = Форма.Элементы.Найти("ГруппаПункт" + НомерТитула);
		ЭлементСоединитель = Форма.Элементы.Найти("Соединитель" + (НомерТитула-1)); // соединитель от предыдущего пункта
		ЭлементДобавитьЕщеТитул = Форма.Элементы.Найти("Пункт" + НомерТитула + "Добавить");
		
		// обойдем документы этого этапа
		Для Каждого СтрокаДокументаЭтапа Из СтрокиДокументовЭтогоЭтапа Цикл 
			
			// запомним на будущее строку титула 1
			Если НомерТитула = 1 Тогда
				
				СтрокаДокументаТ1 = СтрокаДокументаЭтапа;
				ПозиционироватьТекущийТ2илиТ6(СтрокаДокументаТ1, Титул2ТекущийВодитель, Титул6ТекущийВодитель, Форма);
				
			КонецЕсли;
			
			// в медосмотре надо выводить медосмотр конкретного водителя 1 или 2
			Если НомерТитула = 2 
				ИЛИ НомерТитула = 6 Тогда
				
				Если СтрокаДокументаТ1 <> Неопределено И СтрокаДокументаТ1.Водитель = СтрокаДокументаЭтапа.Водитель Тогда 
					ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула);
				ИначеЕсли СтрокаДокументаТ1 <> Неопределено И СтрокаДокументаТ1.Водитель2 = СтрокаДокументаЭтапа.Водитель Тогда
					ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула + "доп");
				КонецЕсли;
				
			Иначе
				ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула);
			КонецЕсли;
			
			// включить картинку и соединитель этапа
			Если ЭлементПункт <> Неопределено Тогда
				УправлениеКолбасойТитуловУстановитьКартинкуПунктуПоСостояниюСтроки(СтрокаДокументаЭтапа, ТекТитулСсылка, ЭлементПункт);
			КонецЕсли;
			
			Если ЭлементСоединитель <> Неопределено Тогда 
				ЭлементСоединитель.Картинка = БиблиотекаКартинок.КонтурЛогистика_СоединительИстинаДвойной;
			КонецЕсли;
			
			// установить особенности цепочки
			Если СтрокаДокументаЭтапа.НомерТитула = 1 Тогда
				
				Если СтрокаДокументаЭтапа.ОбязМедосмотрПосле = Истина Тогда
					
					ОбязательныйМО = Истина;
					
					Если ТипТитула <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
						Форма.Элементы.Найти("Пункт6").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
						Форма.Элементы.Найти("Пункт6доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
					КонецЕсли;
					
				КонецЕсли;
				
				Если СтрокаДокументаЭтапа.ДваВодителя = Истина Тогда
					ДваВодителя = Истина;
				Иначе
					ДваВодителя = Ложь;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 4 Тогда
				
				Форма.Элементы["ИконкаОтправитьQR"].Доступность = Истина;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Истина;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 5 Тогда
				
				Форма.Элементы["ИконкаОтправитьQR"].Доступность = Ложь;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Форма.Элементы.Найти("Пункт2доп").Видимость = ДваВодителя;
	Форма.Элементы.Найти("Пункт6доп").Видимость = ДваВодителя;

КонецПроцедуры

Процедура УправлениеКолбасойТитуловПЛ_5_02(Знач ГлавныйДокумент, Знач ТекТитулСсылка, Знач ТипТитула, Знач Форма)
	
	Перем ДваВодителя, НомерТитула, ОбязательныйМО, стрНомерТитула, СтрокаДокументаТ1, СтрокаДокументаЭтапа, СтрокиДокументовЭтогоЭтапа, ТаблицаСостояний, ТаблицаСостоянийСвернутая, Титул2ТекущийВодитель, Титул6ТекущийВодитель, ЭлементГруппаПункт, ЭлементДобавитьЕщеТитул, ЭлементПункт, ЭлементСоединитель;
	
	ОбязательныйМО = Ложь;
	ДваВодителя = Ложь;
	Титул2ТекущийВодитель = Неопределено;  // требуется если сейчас открыта Т2
	Титул5ТекущийВодитель = Неопределено;  // требуется если сейчас открыта Т5
	Форма.Элементы["ИконкаОтправитьQR"].Доступность = Ложь; // далее дадим доступ если сейчас в рейсе
	Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Видимость = Ложь;
		
	Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		ДваВодителя = ЗначениеЗаполнено(Форма.Объект.Водитель2);
		ОбязательныйМО = Форма.Объект.ОбязМедосмотрПосле;
		Если ОбязательныйМО Тогда 
			Форма.Элементы.Найти("Пункт5").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
			Форма.Элементы.Найти("Пункт5доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
		Иначе
			Форма.Элементы.Найти("Пункт5").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущийНеобязательный;
			Форма.Элементы.Найти("Пункт5доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущийНеобязательный;
		КонецЕсли;
		
	ИначеЕсли ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
		
		Титул2ТекущийВодитель = Форма.Объект.Водитель;
		
	ИначеЕсли ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
		
		Титул5ТекущийВодитель = Форма.Объект.Водитель;
		
	КонецЕсли;
	
	// в эту таблицу попадут только успешно доставленные/полученные документы
	ТаблицаСостояний = ПолучитьТаблицуТитуловПеревозкиПЛ(ГлавныйДокумент);
	
	// Отказ в подписи Т2 внешним медиком
	Если ГлавныйДокумент.ЕстьОтказВПодписи И Не ГлавныйДокумент.ОрганизацияМедик.Наш Тогда
		
		// Добавим мнимый титул 2 с отказом, так как при отказе не оформляется титул.
		НоваяСтрока = ТаблицаСостояний.Добавить();
		НоваяСтрока.Титул = Документы.КонтурЛогистика_ПЛ_Титул2.ПустаяСсылка();
		НоваяСтрока.НомерТитула = 2;
		НоваяСтрока.ЕстьОтказВПодписи = Истина;
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Водитель2) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерТитула", 2);
			ПараметрыОтбора.Вставить("Водитель", ГлавныйДокумент.Водитель);
			
			НайденныеСтроки = ТаблицаСостояний.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока.Водитель = ГлавныйДокумент.Водитель;
			Иначе
				НоваяСтрока.Водитель = ГлавныйДокумент.Водитель2;
			КонецЕсли;
		Иначе
			НоваяСтрока.Водитель = ГлавныйДокумент.Водитель;
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаСостоянийСвернутая = ТаблицаСостояний.Скопировать();
	ТаблицаСостоянийСвернутая.Свернуть("НомерТитула");
	
	СтрокаДокументаТ1 = Неопределено;
	
	Для Каждого стрНомерТитула Из ТаблицаСостоянийСвернутая Цикл
		
		НомерТитула = стрНомерТитула.НомерТитула;
		
		СтрокиДокументовЭтогоЭтапа = ТаблицаСостояний.НайтиСтроки(Новый Структура("НомерТитула", НомерТитула));
		
		ЭлементГруппаПункт = Форма.Элементы.Найти("ГруппаПункт" + НомерТитула);
		ЭлементСоединитель = Форма.Элементы.Найти("Соединитель" + (НомерТитула-1)); // соединитель от предыдущего пункта
		ЭлементДобавитьЕщеТитул = Форма.Элементы.Найти("Пункт" + НомерТитула + "Добавить");
		
		// обойдем документы этого этапа
		Для Каждого СтрокаДокументаЭтапа Из СтрокиДокументовЭтогоЭтапа Цикл 
			
			// запомним на будущее строку титула 1
			Если НомерТитула = 1 Тогда
				
				СтрокаДокументаТ1 = СтрокаДокументаЭтапа;
				ПозиционироватьТекущийТ2илиТ5_5_02(СтрокаДокументаТ1, Титул2ТекущийВодитель, Титул5ТекущийВодитель, Форма);
				
			КонецЕсли;
			
			// в медосмотре надо выводить медосмотр конкретного водителя 1 или 2
			Если НомерТитула = 2 Или НомерТитула = 5 Тогда
				
				Если СтрокаДокументаТ1 <> Неопределено И СтрокаДокументаТ1.Водитель = СтрокаДокументаЭтапа.Водитель Тогда 
					ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула);
				ИначеЕсли СтрокаДокументаТ1 <> Неопределено И СтрокаДокументаТ1.Водитель2 = СтрокаДокументаЭтапа.Водитель Тогда
					ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула + "доп");
				КонецЕсли;
				
			Иначе
				ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула);
			КонецЕсли;
			
			// включить картинку и соединитель этапа
			Если ЭлементПункт <> Неопределено Тогда
				УправлениеКолбасойТитуловУстановитьКартинкуПунктуПоСостояниюСтроки(СтрокаДокументаЭтапа, ТекТитулСсылка, ЭлементПункт);
			КонецЕсли;
			
			Если ЭлементСоединитель <> Неопределено Тогда 
				ЭлементСоединитель.Картинка = БиблиотекаКартинок.КонтурЛогистика_СоединительИстинаДвойной;
			КонецЕсли;
			
			// установить особенности цепочки
			Если СтрокаДокументаЭтапа.НомерТитула = 1 Тогда
				
				Если СтрокаДокументаЭтапа.ОбязМедосмотрПосле = Истина Тогда
					
					ОбязательныйМО = Истина;
					
					Если ТипТитула <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
						Форма.Элементы.Найти("Пункт5").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
						Форма.Элементы.Найти("Пункт5доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
					КонецЕсли;
					
				КонецЕсли;
				
				Если СтрокаДокументаЭтапа.ДваВодителя = Истина Тогда
					ДваВодителя = Истина;
				Иначе
					ДваВодителя = Ложь;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 3 Тогда
				
				Форма.Элементы["ИконкаОтправитьQR"].Доступность = Истина;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Видимость = Истина;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 4 Тогда
				
				Форма.Элементы["ИконкаОтправитьQR"].Доступность = Ложь;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Видимость = Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Форма.Элементы.Найти("Пункт2доп").Видимость = ДваВодителя;
	Форма.Элементы.Найти("Пункт5доп").Видимость = ДваВодителя;

КонецПроцедуры

Процедура УправлениеКолбасойТитуловТРН(Знач НомерТекТипа, Знач ТаблицаСостояний, Знач ТаблицаСостоянийСвернутая, Знач ТекТитулСсылка, Знач Форма)
	
	Перем ЕстьВозвратнаяЦепочка, ИмяЭлементаПункт, НомерТитула, стрНомерТитула, СтрокаДокументаЭтапа, СтрокиДокументовЭтогоЭтапа, ЭлементГруппаПункт, ЭлементДобавитьЕщеТитул, ЭлементПункт, ЭлементСоединитель;
	
	ЕстьВозвратнаяЦепочка = ТаблицаСостоянийСвернутая.Найти(4, "НомерТитула") <> Неопределено 
							И (ТаблицаСостояний.НайтиСтроки(Новый Структура("НомерТитула, ОтказВПриемке", 4, Истина)).Количество() > 0
								ИЛИ ТаблицаСостояний.НайтиСтроки(Новый Структура("НомерТитула, ПринятьЧастично", 4, Истина)).Количество() > 0);
	
	ЭлементПункт7Добавить = Форма.Элементы.Найти("Пункт7Добавить");
	ЭлементПункт8Добавить = Форма.Элементы.Найти("Пункт8Добавить");
	
	Если ЭлементПункт7Добавить <> Неопределено Тогда
		ЭлементПункт7Добавить.Доступность = Ложь;
		ЭлементПункт7Добавить.Видимость = Ложь;
	КонецЕсли;
	
	Если ЭлементПункт8Добавить <> Неопределено Тогда
		ЭлементПункт8Добавить.Доступность = Ложь;
		ЭлементПункт8Добавить.Видимость = Ложь;
	КонецЕсли;
	
	Форма.Элементы["ГруппаВозврат"].Видимость = Ложь;
	Форма.Элементы.Отделитель.Видимость = Истина;
	
	// Для Т3,4,7 понять мы сейчас прямой или возвратный
	Если НомерТекТипа = 3 Тогда 
		
		Если Форма.Объект.ЭтоПриемВозврата Тогда 
			Форма.Элементы.Найти("ПунктПриемкаВозврата").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
		Иначе
			Форма.Элементы.Найти("Пункт3").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
		КонецЕсли;
		
	ИначеЕсли НомерТекТипа = 4 Тогда 
		
		Если Форма.Объект.ЭтоПриемВозврата Тогда 
			Форма.Элементы.Найти("ПунктРазгрузкаВозврата").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
		Иначе
			Форма.Элементы.Найти("Пункт4").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
		КонецЕсли;
		
	ИначеЕсли НомерТекТипа = 7 Тогда 
		
		Если Форма.Объект.ЭтоВозвратнаяЦепочка Тогда 
			Форма.Элементы.Найти("ПунктПереадресовкаВозврата").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
		Иначе
			Форма.Элементы.Найти("Пункт7").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
		КонецЕсли;
		
	КонецЕсли;
	
	// для простых (без возврата) цепочек, где есть Т3 и там не было введено переадресаций и эстафет уберем эти пункты в колбасе 
	Если ТаблицаСостоянийСвернутая.Найти(7, "НомерТитула") = Неопределено 
		И ТаблицаСостоянийСвернутая.Найти(3, "НомерТитула") <> Неопределено
		И Не ЕстьВозвратнаяЦепочка Тогда
		Форма.Элементы["ГруппаПункт7"].Видимость = Ложь;
	КонецЕсли;
	
	Если ТаблицаСостоянийСвернутая.Найти(8, "НомерТитула") = Неопределено 
		И ТаблицаСостоянийСвернутая.Найти(3, "НомерТитула") <> Неопределено
		И Не ЕстьВозвратнаяЦепочка Тогда
		Форма.Элементы["ГруппаПункт8"].Видимость = Ложь;
	КонецЕсли;
	
	НомИспрТ1 = 0;
	НомИспрТ3 = 0;
	
	Для Каждого стрНомерТитула Из ТаблицаСостоянийСвернутая Цикл
		
		НомерТитула = стрНомерТитула.НомерТитула;
		
		Если НомерТитула = 17 Тогда 
			ИмяЭлементаПункт = "ПереадресовкаВозврата";
		ИначеЕсли НомерТитула = 23 Тогда
			ИмяЭлементаПункт = "ПриемкаВозврата";
		ИначеЕсли НомерТитула = 24 Тогда
			ИмяЭлементаПункт = "РазгрузкаВозврата";
		Иначе
			ИмяЭлементаПункт = НомерТитула;
		КонецЕсли;
		
		СтрокиДокументовЭтогоЭтапа = ТаблицаСостояний.НайтиСтроки(Новый Структура("НомерТитула", НомерТитула));
		
		Если НомерТитула = 6 И СтрокиДокументовЭтогоЭтапа.Количество() > 1 Тогда
			// Для титула 6 после отказа может прийти положительный титул
			// Оставляем только последний
			СтрокаПоследнегоТитула = Неопределено;
			Для Каждого СтрокаДокументаЭтапа Из СтрокиДокументовЭтогоЭтапа Цикл
				Если СтрокаПоследнегоТитула = Неопределено Тогда
					СтрокаПоследнегоТитула = СтрокаДокументаЭтапа;
					Продолжить;
				КонецЕсли;
				
				Если СтрокаДокументаЭтапа.Титул.Дата > СтрокаПоследнегоТитула.Титул.Дата Тогда
					СтрокаПоследнегоТитула = СтрокаДокументаЭтапа;
				КонецЕсли;
			КонецЦикла;
			СтрокиДокументовЭтогоЭтапа = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаПоследнегоТитула);
		КонецЕсли;
		
		ЭлементГруппаПункт = Форма.Элементы.Найти("ГруппаПункт" + ИмяЭлементаПункт);
		ЭлементСоединитель = Форма.Элементы.Найти("Соединитель" + (НомерТитула-1)); // соединитель от предыдущего пункта
		ЭлементДобавитьЕщеТитул = Форма.Элементы.Найти("Пункт" + НомерТитула + "Добавить");
		
		// обойдем документы этого этапа
		Для Каждого СтрокаДокументаЭтапа Из СтрокиДокументовЭтогоЭтапа Цикл 
			
			ЭлементПункт = Форма.Элементы.Найти("Пункт" + ИмяЭлементаПункт);
			
			// включить картинку и соединитель этапа
			Если ЭлементПункт <> Неопределено Тогда
				УправлениеКолбасойТитуловУстановитьКартинкуПунктуПоСостояниюСтроки(СтрокаДокументаЭтапа, ТекТитулСсылка, ЭлементПункт);
				
				// Выделим вводимый титул исправления
				Если СтрокаДокументаЭтапа.НомерТитула = НомерТекТипа
					И Не ЗначениеЗаполнено(ТекТитулСсылка) Тогда
					
					Если (НомерТитула = 3 Или НомерТитула = 4)
						И Форма.Объект.ЭтоПриемВозврата Тогда
						// Не перекрашиваем т.к. сейчас вводится на обратной цепочке
					Иначе
						ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ЭлементСоединитель <> Неопределено Тогда 
				ЭлементСоединитель.Картинка = БиблиотекаКартинок.КонтурЛогистика_СоединительИстинаДвойной;
			КонецЕсли;
			
			// Вывод номера исправления
			ЭлементНадписиПункти = Форма.Элементы.Найти("НадписьИспрПункт" + ИмяЭлементаПункт);
			Если ЭлементНадписиПункти <> Неопределено И СтрокаДокументаЭтапа.НомИспр <> 0 Тогда
				ЭлементНадписиПункти.Видимость = Истина;
				ЭлементНадписиПункти.Заголовок = ЭлементНадписиПункти.Заголовок + Строка(СтрокаДокументаЭтапа.НомИспр);
				ЭлементНадписиПункти.Подсказка = "Исправление " + Строка(СтрокаДокументаЭтапа.НомИспр);
			КонецЕсли;
			
			// установить особенности цепочки
			Если СтрокаДокументаЭтапа.НомерТитула = 1 Тогда
				
				НомИспрТ1 = СтрокаДокументаЭтапа.НомИспр;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 2 Тогда
				
				Если СтрокаДокументаЭтапа.Статус <> Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
					И СтрокаДокументаЭтапа.ЕстьОтказВПодписи <> Истина Тогда 
					Форма.Элементы["ИконкаОтправитьQR"].Доступность = Истина;
					Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Истина;
					
					Если ЭлементПункт7Добавить <> Неопределено Тогда
						ЭлементПункт7Добавить.Доступность = Истина;
					КонецЕсли;
					Если ЭлементПункт8Добавить <> Неопределено Тогда
						ЭлементПункт8Добавить.Доступность = Истина;
					КонецЕсли;
				КонецЕсли;
				
				// Выделим соединитель и номер исправления красным если номера исправлений не совпадают
				Если НомИспрТ1 <> СтрокаДокументаЭтапа.НомИспр Тогда
					ЭлементСоединитель.Картинка = БиблиотекаКартинок.КонтурЛогистика_СоединительИстинаДвойнойКрасный;
					ЭлементНадписьИспрПунктТ1 = Форма.Элементы.Найти("НадписьИспрПункт1");
					Если ЭлементНадписьИспрПунктТ1 <> Неопределено Тогда
						ЭлементНадписьИспрПунктТ1.ЦветТекста = WebЦвета.Красный;
					КонецЕсли;
					ЭлементНадписьИспрПунктТ2 = Форма.Элементы.Найти("НадписьИспрПункт2");
					Если ЭлементНадписьИспрПунктТ2 <> Неопределено Тогда
						ЭлементНадписьИспрПунктТ2.ЦветТекста = WebЦвета.Красный;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 3 Тогда
				
				Форма.Элементы["ИконкаОтправитьQR"].Доступность = Ложь;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Ложь;
				
				Если ЭлементПункт7Добавить <> Неопределено Тогда
					ЭлементПункт7Добавить.Доступность = Ложь;
				КонецЕсли;
				Если ЭлементПункт8Добавить <> Неопределено Тогда
					ЭлементПункт8Добавить.Доступность = Ложь;
				КонецЕсли;
				
				Если СтрокаДокументаЭтапа.ПринятьЧастично Или СтрокаДокументаЭтапа.ОтказВПриемке Тогда 
					Форма.Элементы["ГруппаВозврат"].Видимость = Истина;
					Форма.Элементы.Отделитель.Видимость = Ложь;
				КонецЕсли;
				
				НомИспрТ3 = СтрокаДокументаЭтапа.НомИспр;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 4 Тогда
				
				// Выделим соединитель и номер исправления красным если номера исправлений не совпадают
				Если НомИспрТ3 <> СтрокаДокументаЭтапа.НомИспр Тогда
					ЭлементСоединитель.Картинка = БиблиотекаКартинок.КонтурЛогистика_СоединительИстинаДвойнойКрасный;
					ЭлементНадписьИспрПунктТ3 = Форма.Элементы.Найти("НадписьИспрПункт3");
					Если ЭлементНадписьИспрПунктТ3 <> Неопределено Тогда
						ЭлементНадписьИспрПунктТ3.ЦветТекста = WebЦвета.Красный;
					КонецЕсли;
					ЭлементНадписьИспрПунктТ4 = Форма.Элементы.Найти("НадписьИспрПункт4");
					Если ЭлементНадписьИспрПунктТ4 <> Неопределено Тогда
						ЭлементНадписьИспрПунктТ4.ЦветТекста = WebЦвета.Красный;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 5 И Не НомерТекТипа = 6 Тогда
				
				Форма.Элементы.Найти("Пункт6").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 7 Тогда
				
				Если ЭлементПункт7Добавить <> Неопределено Тогда
					ЭлементПункт7Добавить.Видимость = Истина;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 8 Тогда
				
				Если ЭлементПункт8Добавить <> Неопределено Тогда
					ЭлементПункт8Добавить.Видимость = Истина;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 17 Тогда
				
				Форма.Элементы["ИконкаОтправитьQRВозврат"].Доступность = Истина;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Истина;
				Если ЭлементПункт7Добавить <> Неопределено Тогда
					ЭлементПункт7Добавить.Доступность = Ложь;
				КонецЕсли;
				Если ЭлементПункт8Добавить <> Неопределено Тогда
					ЭлементПункт8Добавить.Доступность = Ложь;
				КонецЕсли;
				
			ИначеЕсли СтрокаДокументаЭтапа.НомерТитула = 23 Тогда
				
				Форма.Элементы["ИконкаОтправитьQRВозврат"].Доступность = Ложь;
				Форма.Элементы["ФормаОбщаяКомандаКонтурЛогистика_ОтправитьQRКод"].Доступность = Ложь;
				Если ЭлементПункт7Добавить <> Неопределено Тогда
					ЭлементПункт7Добавить.Доступность = Ложь;
				КонецЕсли;
				Если ЭлементПункт8Добавить <> Неопределено Тогда
					ЭлементПункт8Добавить.Доступность = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеКолбасойТитуловЗЗ(Знач ГлавныйДокумент, Знач ТекТитулСсылка, Знач ТипТитула, Знач Форма)
	
	Перем НомерТитула, стрНомерТитула, СтрокаДокументаТ1, СтрокаДокументаЭтапа, СтрокиДокументовЭтогоЭтапа, ТаблицаСостояний, ТаблицаСостоянийСвернутая, ЭлементГруппаПункт, ЭлементДобавитьЕщеТитул, ЭлементПункт, ЭлементСоединитель;
	
	// в эту таблицу попадут только успешно доставленные/полученные документы
	ТаблицаСостояний = ПолучитьТаблицуТитуловПеревозкиЗЗ(ГлавныйДокумент);
	
	ТаблицаСостоянийСвернутая = ТаблицаСостояний.Скопировать();
	ТаблицаСостоянийСвернутая.Свернуть("НомерТитула");
	
	СтрокаДокументаТ1 = Неопределено;
	
	Для Каждого стрНомерТитула Из ТаблицаСостоянийСвернутая Цикл
		
		НомерТитула = стрНомерТитула.НомерТитула;
		
		СтрокиДокументовЭтогоЭтапа = ТаблицаСостояний.НайтиСтроки(Новый Структура("НомерТитула", НомерТитула));
		
		ЭлементГруппаПункт = Форма.Элементы.Найти("ГруппаПункт" + НомерТитула);
		ЭлементСоединитель = Форма.Элементы.Найти("Соединитель" + (НомерТитула-1)); // соединитель от предыдущего пункта
		ЭлементДобавитьЕщеТитул = Форма.Элементы.Найти("Пункт" + НомерТитула + "Добавить");
		
		// обойдем документы этого этапа
		Для Каждого СтрокаДокументаЭтапа Из СтрокиДокументовЭтогоЭтапа Цикл 
						
			ЭлементПункт = Форма.Элементы.Найти("Пункт" + НомерТитула);
			
			// включить картинку и соединитель этапа
			Если ЭлементПункт <> Неопределено Тогда
				УправлениеКолбасойТитуловУстановитьКартинкуПунктуПоСостояниюСтроки(СтрокаДокументаЭтапа, ТекТитулСсылка, ЭлементПункт);
			КонецЕсли;
			
			Если ЭлементСоединитель <> Неопределено Тогда 
				ЭлементСоединитель.Картинка = БиблиотекаКартинок.КонтурЛогистика_СоединительИстинаДвойной;
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеКолбасойТитуловУстановитьКартинкуПунктуПоСостояниюСтроки(Знач СтрокаДокументаЭтапа, Знач ТекТитулСсылка, Знач ЭлементПункт)
	
	Если СтрокаДокументаЭтапа.Титул = ТекТитулСсылка Тогда
		
		Если СтрокаДокументаЭтапа.Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка 
			Или СтрокаДокументаЭтапа.ЕстьОтказВПодписи = Истина Тогда 
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийОшибка;
		Иначе
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийВыполнен;
		КонецЕсли;
		
	Иначе
		
		Если СтрокаДокументаЭтапа.Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктОшибка;
		ИначеЕсли СтрокаДокументаЭтапа.ЕстьОтказВПодписи = Истина Тогда 
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктОтказ;
		Иначе
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктВыполнен;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПозиционироватьТекущийТ2илиТ6(Знач СтрокаДокументаТ1, Знач Титул2ТекущийВодитель, Знач Титул6ТекущийВодитель, Знач Форма)
	
	Если СтрокаДокументаТ1 <> Неопределено Тогда 
		Если Титул2ТекущийВодитель <> Неопределено Тогда 
			Если СтрокаДокументаТ1.Водитель = Титул2ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт2").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			ИначеЕсли СтрокаДокументаТ1.Водитель2 = Титул2ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт2доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			КонецЕсли;
		ИначеЕсли Титул6ТекущийВодитель <> Неопределено Тогда
			Если СтрокаДокументаТ1.Водитель = Титул6ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт6").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			ИначеЕсли СтрокаДокументаТ1.Водитель2 = Титул6ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт6доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПозиционироватьТекущийТ2илиТ5_5_02(Знач СтрокаДокументаТ1, Знач Титул2ТекущийВодитель, Знач Титул5ТекущийВодитель, Знач Форма)
	
	Если СтрокаДокументаТ1 <> Неопределено Тогда 
		Если Титул2ТекущийВодитель <> Неопределено Тогда 
			Если СтрокаДокументаТ1.Водитель = Титул2ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт2").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			ИначеЕсли СтрокаДокументаТ1.Водитель2 = Титул2ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт2доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			КонецЕсли;
		ИначеЕсли Титул5ТекущийВодитель <> Неопределено Тогда
			Если СтрокаДокументаТ1.Водитель = Титул5ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт5").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			ИначеЕсли СтрокаДокументаТ1.Водитель2 = Титул5ТекущийВодитель Тогда
				Форма.Элементы.Найти("Пункт5доп").Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуТитуловПеревозкиПЛ(ГлавныйДокумент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		Запрос.Текст = ТекстЗапросаПолученияТаблицыТитуловПеревозкиПЛ(ГлавныйДокумент);
	Иначе
		Запрос.Текст = ТекстЗапросаПолученияТаблицыТитуловПеревозкиПЛ_5_02(ГлавныйДокумент);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Титул1", ГлавныйДокумент);
	СтатусыУспешнойДоставки = СтатусыБылаПопыткаТранспорта();
	Запрос.УстановитьПараметр("СтатусыУспешнойДоставки", СтатусыУспешнойДоставки);
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();
	
КонецФункции

Функция ТекстЗапросаПолученияТаблицыТитуловПеревозкиПЛ(ГлавныйДокумент)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_ПЛ_Титул1.Ссылка КАК Ссылка,
	               |	1 КАК НомерТитула,
	               |	КонтурЛогистика_ПЛ_Титул1.ОбязМедосмотрПосле КАК ОбязМедосмотрПосле,
	               |	NULL КАК ЕстьОтказВПодписи,
	               |	КонтурЛогистика_ПЛ_Титул1.ЭтоСменаВодителя КАК ЭтоСменаВодителя,
	               |	КонтурЛогистика_ПЛ_Титул1.Водитель2 <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка) КАК ДваВодителя,
	               |	КонтурЛогистика_ПЛ_Титул1.Водитель КАК Водитель,
	               |	КонтурЛогистика_ПЛ_Титул1.Водитель2 КАК Водитель2
	               |ПОМЕСТИТЬ ВТ_ДокументыТитулы
	               |ИЗ
