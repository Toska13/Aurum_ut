Функция СтрокаТипа(ТипДанных)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипДанных);
	СтрокаТипа = ОбъектМетаданных.ПолноеИмя();
	
	Если ЭтоПеречисление_(СтрокаТипа) Тогда
		СтрокаТипа = СтрЗаменить(СтрокаТипа, "Перечисление", "ПеречислениеСсылка");
	КонецЕсли;
	
	Если ЭтоСправочник_(СтрокаТипа) Тогда
		СтрокаТипа = СтрЗаменить(СтрокаТипа, "Справочник", "СправочникСсылка");
	КонецЕсли;
	
	Возврат СтрокаТипа;
	
КонецФункции

Функция ПреобразоватьЗначениеКТипу(ЗначениеСтрока, ТипЗначения) Экспорт
	
	ЗначениеПреобразованное = ЗначениеСтрока;
	                               
	Если ТипЗначения = "Число" Тогда
		
		Если НЕ ЗначениеЗаполнено(ЗначениеСтрока) Тогда 
			ЗначениеПреобразованное = 0;
		Иначе
			ЗначениеПреобразованное = Число(ЗначениеСтрока);
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = "Строка" Тогда
		
		Если НЕ ЗначениеЗаполнено(ЗначениеСтрока) Тогда 
			ЗначениеПреобразованное = "";
		Иначе
			ЗначениеПреобразованное = СокрЛП(ЗначениеСтрока);
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = "Булево" Тогда
		
		Если НЕ ЗначениеЗаполнено(ЗначениеСтрока) Тогда 
			ЗначениеПреобразованное = Ложь;
		Иначе
			ЗначениеПреобразованное = Булево(ЗначениеСтрока);
		КонецЕсли;
		
	ИначеЕсли Лев(ТипЗначения, 16) = "СправочникСсылка" 
		ИЛИ Лев(ТипЗначения, 18) = "ПеречислениеСсылка" Тогда
		
		ОписаниеТипов = Новый ОписаниеТипов(ТипЗначения);
		
		Если ЗначениеЗаполнено(ЗначениеСтрока) Тогда 
			ЗначениеПреобразованное = ОписаниеТипов.ПривестиЗначение(ПредопределенноеЗначение(ЗначениеСтрока));
		Иначе
			ЗначениеПреобразованное = ОписаниеТипов.ПривестиЗначение("");
		КонецЕсли;
		
	Иначе
		
		ЗначениеПреобразованное = ЗначениеСтрока;
		
	КонецЕсли;
	
	Возврат ЗначениеПреобразованное;
	
КонецФункции

// Позволяет определить, есть ли среди реквизитов объекта реквизит с переданным именем.
//
// Параметры:
//  ИмяРеквизита - Строка - имя реквизита;
//  МетаданныеОбъекта - ОбъектМетаданных - объект, в котором требуется проверить наличие реквизита.
//  ИскатьВСтандартныхРеквизитах - Булево - будет продолжен поиск среди стандартных реквизитов, 
//											если реквизит не найдер среди реквизитов
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьРеквизитОбъекта_(ИмяРеквизита, МетаданныеОбъекта, ИскатьВСтандартныхРеквизитах = Ложь) Экспорт

	РеквизитНайден = Ложь;
	
	Реквизиты = МетаданныеОбъекта.Реквизиты; // КоллекцияОбъектовМетаданных
	
	Если Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда  
		
		Если ИскатьВСтандартныхРеквизитах Тогда
			
			Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл 
				
				Если Реквизит.Имя = ИмяРеквизита Тогда 
					
					РеквизитНайден = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;	
						
		КонецЕсли;	
		
	Иначе
		
		РеквизитНайден = Истина;
		
	КонецЕсли;	
	
	Возврат РеквизитНайден;

КонецФункции

//Проверяет есть ли в строке символы отличные от "0123456789"
// Возвращаемое значение:
//	Булево
Функция СтрокаСодержитТолькоЦифры(СтрокаПроверки) Экспорт 
	
	Для й = 1 По СтрДлина(СтрокаПроверки) Цикл
		
		ПроверяемыйСимвол = Сред(СтрокаПроверки, й, 1);
		
		Если ПроверяемыйСимвол < "0" ИЛИ ПроверяемыйСимвол > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция КонтрольнаяСуммаИННФЛСовпадает(ИНН) Экспорт 
	КС1_Диадок = УмножитьВектора(ИНН, "7:2:4:10:3:5:9:4:6:8:");
	КС2_Диадок = УмножитьВектора(ИНН, "3:7:2:4:10:3:5:9:4:6:8:");
	Возврат  (((КС1_Диадок % 11) % 10) = число(сред(ИНН, 11, 1))) и (((КС2_Диадок % 11) % 10) = число(сред(ИНН, 12, 1)))
КонецФункции

Функция УмножитьВектора(ИНН, Множители)
	Результат = 0;
	н=0;
	пока найти(Множители, ":")>0 цикл 
		н = н+1;
		Множитель = число(лев(Множители, найти(Множители, ":")-1));
		Множители = прав(Множители, СтрДлина(Множители)- найти(Множители, ":"));
		
		Результат = Результат + Множитель * число(сред(ИНН, н, 1));
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

