Функция СтруктураСчетчиковРабочегоСтола() Экспорт
	
	ИспользуемыеТитулы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьМассивТитуловОформляемыхТекущимПользователем();
	
	ИспользуемыеСвязиДокументовПоТитулам = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СвязиДокументовПоТитулам();
	
	УдалитьНедоступныеТипыДокументов(ИспользуемыеТитулы);
	
	Счетчики = Новый Структура();
	
	Для Каждого ИспользуемыйТитул Из ИспользуемыеТитулы Цикл
		
		ЗначенияСчетчиков = Новый Структура("Задач, Ошибок, Настроено, ОшибкаЗапроса, СвязиДокументов");
		ДобавимСвязиДокументов(ИспользуемыеСвязиДокументовПоТитулам, ИспользуемыйТитул, ЗначенияСчетчиков);
		
		Если ИспользуемыйТитул = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
			Счетчики.Вставить("ТрН_Титул7", ЗначенияСчетчиков);
		ИначеЕсли ИспользуемыйТитул = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			Счетчики.Вставить("ТрН_Титул13", ЗначенияСчетчиков);
		ИначеЕсли ИспользуемыйТитул = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда
			Счетчики.Вставить("ТрН_Титул14", ЗначенияСчетчиков);
		КонецЕсли;
		
		ЗначенияСчетчиков = Новый Структура("Задач, Ошибок, Настроено, ОшибкаЗапроса, СвязиДокументов");
		ДобавимСвязиДокументов(ИспользуемыеСвязиДокументовПоТитулам, ИспользуемыйТитул, ЗначенияСчетчиков);
		
		Счетчики.Вставить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ИспользуемыйТитул), ЗначенияСчетчиков);
		
	КонецЦикла;
	
	Возврат Счетчики;
	
КонецФункции

Процедура УдалитьНедоступныеТипыДокументов(ИспользуемыеТитулы)
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ЗЗ_Титул1) Тогда
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2);
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ПЛ_Титул1) Тогда
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ПЛ_Титул1_5_02) Тогда
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02);
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ТрН_Титул2) Тогда
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7);
		НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8);
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиИУдалитьТипДокументаИзСчетчиков(ИспользуемыеТитулы, ТипДокумента)
	
	ИндексУдаления = ИспользуемыеТитулы.Найти(ТипДокумента);
	Если ИндексУдаления <> Неопределено Тогда
		ИспользуемыеТитулы.Удалить(ИндексУдаления);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавимСвязиДокументов(ИспользуемыеСвязиДокументовПоТитулам, ИспользуемыйТитул, ЗначенияСчетчиков)
	
	ТекущиеНастройкиСвязи = ИспользуемыеСвязиДокументовПоТитулам.Получить(ИспользуемыйТитул);
	Если ТекущиеНастройкиСвязи <> Неопределено Тогда
		ЗначенияСчетчиков.СвязиДокументов = ТекущиеНастройкиСвязи;
	КонецЕсли;
		
КонецПроцедуры

Процедура УстановитьОграниченияТипа(ИмяТипаЛогистика, ЭлементФормы) Экспорт

	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	локОписаниеТипов = Справочники.КонтурЛогистика_Настройки.ПолучитьОписаниеТипаСущности(ИмяТипаЛогистика);
	
	Если ЗначениеЗаполнено(локОписаниеТипов) Тогда 
		ЭлементФормы.ОграничениеТипа = локОписаниеТипов;
	Иначе
		Если Не ИмяТипаЛогистика = "Характеристика" Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() Тогда
			Сообщить("Не указан тип " + ИмяТипаЛогистика + " в справочнике КонтурЛогистика_Настройки");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьОграничениеТипаЕдиницИзмерения(ЭлементФормы) Экспорт

	ОписаниеЕдиницыИзмерения = Справочники.КонтурЛогистика_Настройки.ПолучитьОписаниеТиповЕдиницИзмерения();
	Если ЗначениеЗаполнено(ОписаниеЕдиницыИзмерения) Тогда 
		ЭлементФормы.ОграничениеТипа = ОписаниеЕдиницыИзмерения;
	Иначе
		 Сообщить("Не указан тип единиц измерения в регистре НастройкиКонвертации");
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьВидимостьХарактеристик(ЭлементФормы) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	ТипХарактеристики = Справочники.КонтурЛогистика_Настройки.ПолучитьОписаниеТипаСущности("Характеристика");
	
	ЭлементФормы.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() 
								И (КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИспользуютсяХарактеристики() И ТипХарактеристики <> Неопределено);
	
КонецПроцедуры

Процедура ЗаполнитьСписокЕдиницИзмерения(Номенклатура, СписокВыбора = Неопределено) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Номенклатура",				Номенклатура);
	Если ИмяКонфигурации = "УТ" 
		ИЛИ ИмяКонфигурации = "УФ_УНФ"
		ИЛИ ИмяКонфигурации = "УПП" 
		ИЛИ ИмяКонфигурации = "КА" 
		ИЛИ ИмяКонфигурации = "КЛ" 
		ИЛИ ИмяКонфигурации = "УС_3" Тогда 
		ПараметрыВыбора.Вставить("Отбор", Новый Структура("Владелец", Номенклатура));
	Иначе
		ПараметрыВыбора.Вставить("Отбор",						Новый Структура);
	КонецЕсли;
	ПараметрыВыбора.Вставить("СтрокаПоиска",				""); 
	ПараметрыВыбора.Вставить("ДобавлятьПустуюУпаковку",		Истина); 
	ПараметрыВыбора.Вставить("ВыборГруппИЭлементов",		ИспользованиеГруппИЭлементов.Элементы); 
	
	ТипЕдиницИзмерения = Справочники.КонтурЛогистика_Настройки.ПолучитьИмяСправочникаСущности("ЕдиницаИзмерения");
	
	СписокВыбора = Новый СписокЗначений;
	
	Если ИмяКонфигурации = "УФ_УНФ" Тогда
		
		ПараметрыВыбора.Вставить("Отбор", Новый Структура("Владелец", Номенклатура));
		ТипЕдиницИзмерения = Справочники.КонтурЛогистика_Настройки.ПолучитьИмяСправочникаСущности("Упаковка");
		ДанныеВыбораЕдИзм = Справочники[ТипЕдиницИзмерения].ПолучитьДанныеВыбора(ПараметрыВыбора);
		
		Для Каждого ЭлементСписка Из ДанныеВыбораЕдИзм Цикл
			СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЦикла;
			
	Иначе
		
		МассивТипов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ТипЕдиницИзмерения, ",");
		
		Для Каждого Тип из МассивТипов Цикл
			
			СписокВыбораПромежуточный = Справочники[Тип].ПолучитьДанныеВыбора(ПараметрыВыбора);
			
			Для Каждого ЭлементСписка Из СписокВыбораПромежуточный Цикл
				Если ТипЗнч(ЭлементСписка.Значение)= Тип("Структура") Тогда
					СписокВыбора.Добавить(ЭлементСписка.Значение.Значение, ЭлементСписка.Представление);
				Иначе
					СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьБазовуюЕдиницуИзмерения(Номенклатура) Экспорт
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		
		ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
		
		Если ИмяКонфигурации = "УТ" 
			Или ИмяКонфигурации = "УПП" Тогда 
			Возврат Номенклатура.ЕдиницаХраненияОстатков;
		ИначеЕсли ИмяКонфигурации = "БП" Тогда 
			Возврат Номенклатура.БазоваяЕдиницаИзмерения;
		Иначе
			Возврат Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСписокВыбораСправочника(ИмяСправочника, ПараметрыВыбора) Экспорт
	
	СписокВыбора = Справочники[ИмяСправочника].ПолучитьДанныеВыбора(ПараметрыВыбора);
	Возврат СписокВыбора;
	
КонецФункции

Функция ТекПользовательАдминистратор() Экспорт
	
	Результат = Ложь;
	
	Результат = (РольДоступна("КонтурЛогистика_ПолныеПраваЛогистика")
		Или (КонтурЛогистика_Привилегированный.РольСуществует("ПолныеПрава")
			И РольДоступна("ПолныеПрава"))
		Или (КонтурЛогистика_Привилегированный.РольСуществует("АдминистраторСистемы")
			И РольДоступна("АдминистраторСистемы"))
		Или (КонтурЛогистика_Привилегированный.РольСуществует("УчетнаяСистема_Администрирование")
			И РольДоступна("УчетнаяСистема_Администрирование")));
	
	Возврат Результат;
	
КонецФункции

Функция ТекПользовательАдминистраторУчетнойСистемы() Экспорт
	
	Результат = Ложь;
	
	Результат = (КонтурЛогистика_Привилегированный.РольСуществует("ПолныеПрава") И РольДоступна("ПолныеПрава"))
	ИЛИ (КонтурЛогистика_Привилегированный.РольСуществует("АдминистраторСистемы") И РольДоступна("АдминистраторСистемы"))
	ИЛИ (КонтурЛогистика_Привилегированный.РольСуществует("УчетнаяСистема_Администрирование") И РольДоступна("УчетнаяСистема_Администрирование"));
	Возврат Результат;
	
КонецФункции

Функция ЭтоМассивДокументовУчетнойСистемы(МассивУчетныхДокументовИлиДокументовЛогистика) Экспорт
	
	Если МассивУчетныхДокументовИлиДокументовЛогистика.Количество() = 0 Тогда 
		Возврат Истина;
	КонецЕсли;
	
	//предполагаем что все документы массива одного варианта т.е. либо все жоки учетной системы или все Логистики
	
	МассивЛогистическихТиповУчетныхДокументов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьВсеТипыНастроенныхУчетныхДокументовТипами();
	МассивТиповДокументовКонтурЛогистика = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьВсеТипыДокументовКонтурЛогистикаТипами();
	
	ПервыйДокументСписка = МассивУчетныхДокументовИлиДокументовЛогистика[0];
	
	Если МассивЛогистическихТиповУчетныхДокументов.Найти(ТипЗнч(ПервыйДокументСписка)) <> Неопределено Тогда
		
		Возврат Истина;
		
	ИначеЕсли МассивТиповДокументовКонтурЛогистика.Найти(ТипЗнч(ПервыйДокументСписка)) <> Неопределено Тогда
		
		Возврат Ложь;
		
	Иначе
		
		ВызватьИсключение "Для документов этого типа в настройках конвертации не указаны правила конвертации (Справочник Настройки конвертации (Контур.Логистика))";
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьВсеТипыНастроенныхУчетныхДокументовСтроками() Экспорт
	
	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьВсеТипыНастроенныхУчетныхДокументовСтроками();	
	
