Функция ДопСведенияДляОтправкиПисьмаВТехПоддержку()
	
	Организации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	
	Если ЗначениеЗаполнено(Организации) Тогда
		
		МассивСтрок = Новый Массив;
		
		Для Каждого Организация Из Организации Цикл
			
			Наименование = Организация.Наименование;
			ИНН			 = Организация.ИНН;
			
			Если ЗначениеЗаполнено(Организация.КПП) Тогда
				КПП = Организация.КПП;
			Иначе
				КПП = "-";
			КонецЕсли;
			
			МассивСтрок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("- %1 (%2/%3)", Наименование, ИНН, КПП));
			
		КонецЦикла;
		
		СтрокаОрганизаций = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МассивСтрок, Символы.ПС);
		
	Иначе
		
		СтрокаОрганизаций = НСтр("ru = 'В модуле нет настроенных организаций'");
		
	КонецЕсли;
	
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
	НСтр("ru = 'Организации:
	|%1
	|
	|Версия модуля: %2
	|Версия платформы: %3
	|Версия режима совместимости: %4
	|Конфигурация: ""%5""'")
	, СтрокаОрганизаций
	, КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика()
	, ИнформацияОСистеме.ВерсияПриложения
	, Строка(Метаданные.РежимСовместимости)
	, КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.Контур_ОпределитьКонфигурацию());
	
	Возврат Результат;
	
КонецФункции

