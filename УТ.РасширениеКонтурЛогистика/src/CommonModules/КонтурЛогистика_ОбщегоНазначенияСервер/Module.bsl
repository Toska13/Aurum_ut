Процедура УправлениеПользователемПодписантом(Форма)
	
	Попытка
		
		Если Форма.ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик Тогда
			Возврат;
		КонецЕсли;
		
		ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		
		// Проверим идентичность пользователя титула и текущего
		Если Форма.Объект.ПользовательПодписант = ПользовательПодписант Тогда
			Возврат;
		КонецЕсли;
		
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Форма.Объект.Ссылка);
		
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(
			ТипЛогистика, Форма.Объект.ДокументОснование);
		
		Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда
			Возврат;
		КонецЕсли;
		
		// Проверим настройку в НКД
		ПодписантТекущийПользователь = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			НастройкаКонвертации, "ПодписантТекущийПользователь");
		
		Если Не ПодписантТекущийПользователь Тогда
			Возврат;
		КонецЕсли;
		
		// Установим текущего пользователя в подписанта титула
		Форма.Объект.ПользовательПодписант = ПользовательПодписант;
		Форма.Модифицированность = Истина;
		
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
КонецПроцедуры

Процедура УправлениеСвязямиДокументов(Форма)
	
	Если Не Форма.Параметры.Свойство("Ключ") Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Форма.Параметры.Ключ)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Форма.Параметры.Ключ)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЭР(Форма.Параметры.Ключ) Тогда
		
		СвязанныйДокумент = РегистрыСведений.КонтурЛогистика_СвязиДокументов.СвязанныйДокумент(Форма.Параметры.Ключ);
		
		Если Не ЗначениеЗаполнено(СвязанныйДокумент.ДокументПодчиненный) Тогда
			Возврат;
		КонецЕсли;
		
		Если СвязанныйДокумент.ДокументПодчиненный = Форма.Параметры.Ключ Тогда
			ОтображаемыйДокумент = СвязанныйДокумент.ДокументОсновной;
			ОтображаемДокументОснование = Истина;
		Иначе
			ОтображаемыйДокумент = СвязанныйДокумент.ДокументПодчиненный;
			ОтображаемДокументОснование = Ложь;
		КонецЕсли;
		
		// Создать реквизиты формы
		Типы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ОтображаемыйДокумент));
		ОписаниеТипа = Новый ОписаниеТипов(Типы);
		ПредставлениеСвязанногоДокумента = Новый РеквизитФормы("ПредставлениеСвязанногоДокумента", ОписаниеТипа);
		
		ДополнительныеРеквизиты = Новый Массив;
		ДополнительныеРеквизиты.Добавить(ПредставлениеСвязанногоДокумента);
		
		Форма.ИзменитьРеквизиты(ДополнительныеРеквизиты);
		
		Форма.ПредставлениеСвязанногоДокумента = ОтображаемыйДокумент;
		
		// Вывести реквизиты на форму
		КонтурЛогистика_РаботаСЭлементамиФормыСервер.ВывестиСвязанныеОбъекты(
			Форма.Параметры.Ключ, ОтображаемДокументОснование, Форма, ОтображаемыйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеВидимостьюКомандФормДокументов(Форма)
	
	Если Найти(Форма.ИмяФормы, "Документ.КонтурЛогистика_ТрН_Титул1") = 0
		И Найти(Форма.ИмяФормы, "Документ.КонтурЛогистика_ТрН_Титул3") = 0 Тогда
		
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание");
		СкрытьЭлементФормы(Форма, "ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителю");
	КонецЕсли;
	
КонецПроцедуры

Функция ПредыдущийТипДокумента(ТипЛогистика) Экспорт

	Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПредыдущийТипДокумента(ТипЛогистика);

