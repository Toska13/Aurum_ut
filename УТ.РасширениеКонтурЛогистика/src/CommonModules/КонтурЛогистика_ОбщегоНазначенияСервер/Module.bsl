Процедура ОбновитьПоказанияОстатокаТопливаНаФорме(Форма)
	
	ГруппаТоплива = Форма.Элементы.Найти("ГруппаПоказанияТоплива");
	Если ГруппаТоплива = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Найти(Форма.ИмяФормы, "Документ.КонтурЛогистика_ПЛ_Титул4") > 0 Тогда
		ТипПоказаний = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде;
	ИначеЕсли Найти(Форма.ИмяФормы, "Документ.КонтурЛогистика_ПЛ_Титул5") > 0 Тогда
		ТипПоказаний = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаЗаезде;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титул1", Форма.Объект.Титул1);
	Запрос.УстановитьПараметр("ТипДанных", РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ);
	Запрос.УстановитьПараметр("ТипПоказаний", ТипПоказаний);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.Количество КАК Количество,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1 КАК Реквизит1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|		ПО КонтурЛогистика_ПЛ_Титул1.kl_id = КонтурЛогистика_ПроизвольныеДанные.Разрез1
	|			И (КонтурЛогистика_ПЛ_Титул1.Ссылка = &Титул1)
	|			И (КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных)
	|			И (КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &ТипПоказаний)
	|			И (КонтурЛогистика_ПроизвольныеДанные.СинхронизацияССервисом = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыСинхронизации.НеНачата)
	|				ИЛИ КонтурЛогистика_ПроизвольныеДанные.СинхронизацияССервисом = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыСинхронизации.УспешноЗавершена))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Форма.ОстатокТоплива = Выборка.Количество;
		Форма.ГорючеСмазочныеМатериалы = Выборка.Реквизит1;
		
		ГруппаТоплива.Видимость = Истина;
	Иначе
		ГруппаТоплива.Видимость = Ложь;
	КонецЕсли;
	
