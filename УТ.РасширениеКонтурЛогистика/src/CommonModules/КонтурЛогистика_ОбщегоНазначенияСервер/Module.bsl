#Область ДружбаКонтрагентов

Функция УстановленыОтношения(Орг1, Орг2, ПроверитьАпиКлючОрг1 = Ложь, ПроверитьАвтодружбу = Истина) Экспорт
	
	УстановленыОтношения = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПроверитьОтношения(Орг1, Орг2, ПроверитьАпиКлючОрг1, ПроверитьАвтодружбу);
	Если Не УстановленыОтношения Тогда
		УстановленыОтношения = КонтурЛогистика_ОбщегоНазначенияСервер.ПроверитьОтношения(Орг1, Орг2, ПроверитьАпиКлючОрг1, ПроверитьАвтодружбу);		
	КонецЕсли;	
	
	Возврат УстановленыОтношения;
	
КонецФункции

Функция ПроверитьОтношения(Орг1, Орг2, ПроверитьАпиКлючОрг1 = Ложь, ПроверитьАвтодружбу = Истина) Экспорт
	
	УстановленыОтношения = Ложь;
	
	СтатусОтношений = ПолучитьСтатусОтношений(Орг1, Орг2);
	
	Если СтатусОтношений = Неопределено Тогда
		
		Попытка
			
			Если Орг1.Наш Тогда
				Counteragent = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetCounteragent(Орг1, Орг2);
			Иначе
				Counteragent = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetCounteragent(Орг2, Орг1);
			КонецЕсли;
			СтатусОтношений = КонтурЛогистика_ОбщегоНазначенияСервер.СтатусОтношенияСКонтрагентом(Counteragent);
		
			Если Не Counteragent.Свойство("ПартнерскиеОтношенияНеУстановлены") Тогда
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаписатьСтатусы(Орг1, Орг2, СтатусОтношений, СтатусОтношений);	
			КонецЕсли;
			
		Исключение
		 	СтатусОтношений = Неопределено;
		КонецПопытки
		
	КонецЕсли;
	
	АвтодружбаОрг1 = Орг1.Автодружба;
	АвтодружбаОрг2 = Орг2.Автодружба;
	Если Не Орг1.ЕстьВСервисеЛогистика Тогда 
		АвтодружбаОрг1 = Истина; // если орга автосгенерится - она будет с автодружбой issue/KL-3513
	КонецЕсли;
	Если Не Орг2.ЕстьВСервисеЛогистика Тогда 
		АвтодружбаОрг2 = Истина; // если орга автосгенерится - она будет с автодружбой issue/KL-3513
	КонецЕсли;
	
	Если АвтодружбаОрг1 И АвтодружбаОрг2 Тогда
		УстановленыОтношения = Истина;
	КонецЕсли;
	
	Если СтатусОтношений = Неопределено И (Не АвтодружбаОрг1 Или Не АвтодружбаОрг2) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	АвторизацияВыполненаОрг1 = Ложь;
	Если ПроверитьАпиКлючОрг1 Тогда
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Орг1);
		АвторизацияВыполненаОрг1 = ПараметрыСервиса.АвторизацияВыполнена;
	КонецЕсли;
		
	Если (СокрЛП(Орг1.Sociability) = "AllOrganizations" И СокрЛП(Орг2.Sociability) = "AllOrganizations")
		Или ((ПроверитьАпиКлючОрг1 И АвторизацияВыполненаОрг1
				Или Не ПроверитьАпиКлючОрг1)
			И (СокрЛП(Орг1.Sociability) = "CounteragentsOnly" Или СокрЛП(Орг2.Sociability) = "CounteragentsOnly")
			И ПроверитьАвтодружбу
			И АвтодружбаОрг1 И АвтодружбаОрг2) Тогда
		
			Если СтатусОтношений = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.IsRejectedByMe
				Или СтатусОтношений = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.RejectsMe Тогда
				УстановленыОтношения = Ложь;
			Иначе
				УстановленыОтношения = Истина; 
			КонецЕсли;
		
	Иначе
		
		Если СтатусОтношений = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.IsMyCounteragent Тогда
			УстановленыОтношения = Истина;		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УстановленыОтношения;
	
КонецФункции

Функция ПолучитьСтатусОтношений(Орг1, Орг2)
	
 	Найд1 = Орг1.Контрагенты.Найти(Орг2, "Контрагент");
	Если Найд1 <> Неопределено Тогда
		Статус1 = Найд1.Статус;
	Иначе
		Статус1 = Неопределено;
	КонецЕсли;
	
	Найд2 = Орг2.Контрагенты.Найти(Орг1, "Контрагент");
	Если Найд2 <> Неопределено Тогда
		Статус2 = Найд2.Статус;
	Иначе
		Статус2 = Неопределено;
	КонецЕсли;
	
	Если Статус1 = Статус2 Тогда
		Возврат Статус1;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СтатусОтношенияСКонтрагентом(Counteragent) Экспорт
	
	ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.ПустаяСсылка();
	
	Если Counteragent.Свойство("ПартнерскиеОтношенияНеУстановлены") Тогда		
		ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.NotInCounteragentList;				
	ИначеЕсли Counteragent.Свойство("CurrentStatus") Тогда		
		ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов[Counteragent.CurrentStatus];				
	КонецЕсли;
	
	Возврат ТекущийСтатус;
	
КонецФункции

Процедура ЗаписатьСтатусы(Организация, Контрагент, СтатусОрганизации, СтатусКонтрагента) Экспорт
	
	ОрганизацияОбъект = Организация.ПолучитьОбъект();
	
	СтрокаКонтрагент = ОрганизацияОбъект.Контрагенты.Найти(Контрагент, "Контрагент");
	Если СтрокаКонтрагент = Неопределено Тогда
		
		Если ОрганизацияОбъект.Контрагенты.Количество() < 99999 Тогда
			СтрокаКонтрагент = ОрганизацияОбъект.Контрагенты.Добавить();
			СтрокаКонтрагент.Контрагент = Контрагент;
			СтрокаКонтрагент.Статус = СтатусОрганизации;
			ОрганизацияОбъект.Записать();
		Иначе
			КонтурЛогистика_Метрика.Метрика_Отправить_Ошибку(, 
				"ЗаписатьСтатусы", 
				"Табличная часть объекта будет содержать более 99999 строк. КонтурЛогистика_ОрганизацииДиадок.Контрагенты", 
				"Переполнение табличной части Контрагенты у организации Диадок при попытки добавления контрагента в проверке отношений");	
		КонецЕсли;
		
	Иначе
		Если СтрокаКонтрагент.Статус <> СтатусОрганизации Тогда						
			СтрокаКонтрагент.Статус = СтатусОрганизации;
			ОрганизацияОбъект.Записать();			
		КонецЕсли;
	КонецЕсли;
	
	КонтрагентОбъект = Контрагент.ПолучитьОбъект();
	
	СтрокаКонтрагент = КонтрагентОбъект.Контрагенты.Найти(Организация, "Контрагент");
	Если СтрокаКонтрагент = Неопределено Тогда
		
		Если КонтрагентОбъект.Контрагенты.Количество() < 99999 Тогда
			СтрокаКонтрагент = КонтрагентОбъект.Контрагенты.Добавить();
			СтрокаКонтрагент.Контрагент = Организация;
			СтрокаКонтрагент.Статус = СтатусКонтрагента;
			КонтрагентОбъект.Записать();
		Иначе
			КонтурЛогистика_Метрика.Метрика_Отправить_Ошибку(, 
				"ЗаписатьСтатусы", 
				"Табличная часть объекта будет содержать более 99999 строк. КонтурЛогистика_ОрганизацииДиадок.Контрагенты", 
				"Переполнение табличной части Контрагенты у организации Диадок при попытки добавления контрагента в проверке отношений");	
		КонецЕсли;
		
	Иначе
		Если СтрокаКонтрагент.Статус <> СтатусКонтрагента Тогда					
			СтрокаКонтрагент.Статус = СтатусКонтрагента;
			КонтрагентОбъект.Записать();			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьНаименованиеФормыВыбораПоТипу(Тип) Экспорт
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	
	ИмяФормы = "";
	
	Если ОбъектМетаданных <> Неопределено Тогда
		ИмяФормы = "Документ." + ОбъектМетаданных.Имя + ".ФормаВыбора";
	КонецЕсли;
	
	Возврат ИмяФормы;	
	
КонецФункции

Функция НайтиДокументОснованиеИЗаписатьВТитул(ДокументТитул) Экспорт 
	
	НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляТекущегоТитула(ДокументТитул);
	Если ЗначениеЗаполнено(НайденныйДокУчСист) Тогда 
		
		ДокументТитулОбъект = ДокументТитул.ПолучитьОбъект();
		ДокументТитулОбъект.ДокументОснование = НайденныйДокУчСист;
		ДокументТитулОбъект.Записать();
		
	КонецЕсли;
	
	Возврат НайденныйДокУчСист;
		
КонецФункции

#Область БезопасноеХранилище

////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции для работы с хранилищем паролей.

// Записывает конфиденциальные данные в безопасное хранилище.
// Вызывающий код должен самостоятельно устанавливать привилегированный режим.
//
// Безопасное хранилище недоступно для чтения пользователям (кроме администраторов),
// а доступно только коду, который делает обращения только к своей части данных и
// в том контексте, который предполагает чтение или запись конфиденциальных данных.
//
// Параметры:
//  Владелец - ПланОбменаСсылка
//           - СправочникСсылка
//           - Строка - ссылка на объект информационной базы,
//             представляющий объект-владелец сохраняемого пароля или строка до 128 символов.
//             Для объектов других типов в качестве владельца рекомендуется использовать ссылку на
//             элемент метаданных этого типа в справочнике ИдентификаторыОбъектовМетаданных
//             или ключ в виде строки с учетом имен подсистем.
//             Например, для БСП:
//               Владелец = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("РегистрСведений.АдресныеОбъекты");
//             если нужно 1 хранилище на подсистему БСП:
//               Владелец = "СтандартныеПодсистемы.УправлениеДоступом";
//             если нужно более 1 хранилища на подсистему БСП:
//               Владелец = "СтандартныеПодсистемы.УправлениеДоступом.<Уточнение>";
//
//  Данные  - Произвольный - данные помещаемые в безопасное хранилище. Неопределенно - удаляет все данные.
//             Для удаления данных по ключу следует использовать процедуру УдалитьДанныеИзБезопасногоХранилища.
//  Ключ    - Строка       - ключ сохраняемых настроек, по умолчанию "Пароль".
//                           Ключ должен соответствовать правилам имен идентификаторов:
//                           1. Первым символом ключа должна быть буква или символ подчеркивания (_).
//                           2. Каждый из последующих символов может быть буквой, цифрой или символом подчеркивания (_).
//
// Пример:
//  Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
//      Если ТекущийПользовательМожетИзменятьПароль Тогда
//          УстановитьПривилегированныйРежим(Истина);
//          ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Логин, "Логин");
//          ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Пароль);
//          УстановитьПривилегированныйРежим(Ложь);
//      КонецЕсли;
//  КонецПроцедуры
//
Процедура ЗаписатьДанныеВБезопасноеХранилище(Владелец, Данные, Ключ = "Пароль") Экспорт
	
	Проверить(ЗначениеЗаполнено(Владелец),
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			НСтр("ru = 'Недопустимое значение параметра %1 в %2.
			           |параметр должен содержать ссылку; передано значение: %3 (тип %4).'"),
			"Владелец", "ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище", Владелец, ТипЗнч(Владелец)));
			
	Проверить(ТипЗнч(Ключ) = Тип("Строка"),
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			НСтр("ru = 'Недопустимое значение параметра %1 в %2.
			           |параметр должен содержать строку; передано значение: %3 (тип %4).'"),
			"Ключ", "ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище", Ключ, ТипЗнч(Ключ)));
	
	БезопасноеХранилищеДанных = РегистрыСведений.КонтурЛогистика_БезопасноеХранилищеДанных.СоздатьМенеджерЗаписи();
		
	БезопасноеХранилищеДанных.Владелец = Владелец;
	БезопасноеХранилищеДанных.Прочитать();
	Если Данные <> Неопределено Тогда
		Если БезопасноеХранилищеДанных.Выбран() Тогда
			ДанныеДляСохранения = БезопасноеХранилищеДанных.Данные.Получить();
			Если ТипЗнч(ДанныеДляСохранения) <> Тип("Структура") Тогда
				ДанныеДляСохранения = Новый Структура();
			КонецЕсли;
			ДанныеДляСохранения.Вставить(Ключ, Данные);
			ДанныеДляХранилищеЗначения = Новый ХранилищеЗначения(ДанныеДляСохранения, Новый СжатиеДанных(6));
			БезопасноеХранилищеДанных.Данные = ДанныеДляХранилищеЗначения;
			БезопасноеХранилищеДанных.Записать();
		Иначе
			ДанныеДляСохранения = Новый Структура(Ключ, Данные);
			ДанныеДляХранилищеЗначения = Новый ХранилищеЗначения(ДанныеДляСохранения, Новый СжатиеДанных(6));
			БезопасноеХранилищеДанных.Данные = ДанныеДляХранилищеЗначения;
			БезопасноеХранилищеДанных.Владелец = Владелец;
			БезопасноеХранилищеДанных.Записать();
		КонецЕсли;
	Иначе
		БезопасноеХранилищеДанных.Удалить();
	КонецЕсли;
	
КонецПроцедуры

// Возвращает данные из безопасного хранилища.
// Вызывающий код должен самостоятельно устанавливать привилегированный режим.
//
// Безопасное хранилище недоступно для чтения пользователям (кроме администраторов),
// а доступно только коду, который делает обращения только к своей части данных и
// в том контексте, который предполагает чтение или запись конфиденциальных данных.
//
// Параметры:
//  Владелец    - ПланОбменаСсылка
//              - СправочникСсылка
//              - Строка - ссылка на объект информационной базы,
//                  представляющий объект-владелец сохраняемого пароля или строка до 128 символов.
//  Ключи       - Строка - содержит список имен сохраненных данных, указанных через запятую.
//  ОбщиеДанные - Булево - Истина, если требуется в модели сервиса получить данные из общих данных в разделенном режиме.
// 
// Возвращаемое значение:
//  Произвольный, Структура, Неопределено - данные из безопасного хранилища. Если указан один ключ,
//                            то возвращается его значение, иначе структура.
//                            Если данные отсутствуют - Неопределенно.
//
// Пример:
//	Процедура ПриЧтенииНаСервере(ТекущийОбъект)
//		
//		Если ТекущийПользовательМожетИзменятьПароль Тогда
//			УстановитьПривилегированныйРежим(Истина);
//			Логин  = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка, "Логин");
//			Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка);
//			УстановитьПривилегированныйРежим(Ложь);
//		Иначе
//			Элементы.ГруппаЛогинИПароль.Видимость = Ложь;
//		КонецЕсли;
//		
//	КонецПроцедуры
//
Функция ПрочитатьДанныеИзБезопасногоХранилища(Владелец, Ключи = "Пароль", ОбщиеДанные = Неопределено) Экспорт
	
	Проверить(ЗначениеЗаполнено(Владелец),
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			НСтр("ru = 'Недопустимое значение параметра %1 в %2.
			           |параметр должен содержать ссылку; передано значение: %3 (тип %4).'"),
			"Владелец", "ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища", Владелец, ТипЗнч(Владелец)));
	
	ИмяБезопасногоХранилищаДанных = "КонтурЛогистика_БезопасноеХранилищеДанных";
	
	Результат = ДанныеИзБезопасногоХранилища(Владелец, ИмяБезопасногоХранилищаДанных, Ключи);
	
	Возврат Результат;

КонецФункции

// Удаляет конфиденциальные данные в безопасное хранилище.
// Вызывающий код должен самостоятельно устанавливать привилегированный режим.
//
// Безопасное хранилище недоступно для чтения пользователям (кроме администраторов),
// а доступно только коду, который делает обращения только к своей части данных и
// в том контексте, который предполагает чтение или запись конфиденциальных данных.
//
// Параметры:
//  Владелец - ПланОбменаСсылка
//           - СправочникСсылка
//           - Строка - ссылка на объект информационной базы,
//               представляющий объект-владелец сохраняемого пароля или строка до 128 символов.
//  Ключи    - Строка - содержит список имен удаляемых данных, указанных через запятую. 
//               Неопределено - удаляет все данные.
//
// Пример:
//	Процедура ПередУдалением(Отказ)
//		
//		// Проверка значения свойства ОбменДанными.Загрузка отсутствует, так как удалять данные
//		// из безопасного хранилища нужно даже при удалении объекта при обмене данными.
//		
//		УстановитьПривилегированныйРежим(Истина);
//		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Ссылка);
//		УстановитьПривилегированныйРежим(Ложь);
//		
//	КонецПроцедуры
//
Процедура УдалитьДанныеИзБезопасногоХранилища(Владелец, Ключи = Неопределено) Экспорт
	
	Проверить(ЗначениеЗаполнено(Владелец),
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			НСтр("ru = 'Недопустимое значение параметра %1 в %2.
			           |параметр должен содержать ссылку; передано значение: %3 (тип %4).'"),
			"Владелец", "ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища", Владелец, ТипЗнч(Владелец)));
	
	БезопасноеХранилищеДанных = РегистрыСведений.КонтурЛогистика_БезопасноеХранилищеДанных.СоздатьМенеджерЗаписи();
	
	БезопасноеХранилищеДанных.Владелец = Владелец;
	БезопасноеХранилищеДанных.Прочитать();
	Если ТипЗнч(БезопасноеХранилищеДанных.Данные) = Тип("ХранилищеЗначения") Тогда
		ДанныеДляСохранения = БезопасноеХранилищеДанных.Данные.Получить();
		Если Ключи <> Неопределено И ТипЗнч(ДанныеДляСохранения) = Тип("Структура") Тогда
			СписокКлючей = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Ключи, ",", Ложь);
			Если БезопасноеХранилищеДанных.Выбран() И СписокКлючей.Количество() > 0 Тогда
				Для каждого КлючДляУдаления Из СписокКлючей Цикл
					Если ДанныеДляСохранения.Свойство(КлючДляУдаления) Тогда
						ДанныеДляСохранения.Удалить(КлючДляУдаления);
					КонецЕсли;
				КонецЦикла;
				ДанныеДляХранилищеЗначения = Новый ХранилищеЗначения(ДанныеДляСохранения, Новый СжатиеДанных(6));
				БезопасноеХранилищеДанных.Данные = ДанныеДляХранилищеЗначения;
				БезопасноеХранилищеДанных.Записать();
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	БезопасноеХранилищеДанных.Удалить();
	
КонецПроцедуры

// Получить пароль из безапасного хранилища
//
// Параметры: См. КонтурЛогистика_ОбщегоНазначенияСервер.ПрочитатьДанныеИзБезопасногоХранилища
//
// Возвращаемое значение:
//  Строка - Пароль
//
Функция ПолучитьПароль(СсылкаНаОбъект, Ключ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Пароли = ПрочитатьДанныеИзБезопасногоХранилища(СсылкаНаОбъект, Ключ);
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Пароли = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Пароли[Ключ];
	КонецЕсли;
	
КонецФункции

// Записать пароль в ббезапасное хранилище
//
// Параметры: См. КонтурЛогистика_ОбщегоНазначенияСервер.ЗаписатьДанныеВБезопасноеХранилище
//
Процедура ЗаписатьПароль(Владелец, Данные, Ключ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ЗаписатьДанныеВБезопасноеХранилище(Владелец, Данные, Ключ);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

