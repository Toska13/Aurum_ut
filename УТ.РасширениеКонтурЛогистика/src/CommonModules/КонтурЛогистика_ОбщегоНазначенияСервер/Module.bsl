	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.Количество КАК Количество,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1 КАК Реквизит1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|		ПО КонтурЛогистика_ПЛ_Титул1.kl_id = КонтурЛогистика_ПроизвольныеДанные.Разрез1
	|			И (КонтурЛогистика_ПЛ_Титул1.Ссылка = &Титул1)
	|			И (КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных)
	|			И (КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &ТипПоказаний)";
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ПЛ_Титул1", "КонтурЛогистика_ПЛ_Титул1_5_02");
