Процедура НачатьТранзакцию_() Экспорт
	
	Если СокрЛП(КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.РежимУправленияБлокировкойДанных()) = "АвтоматическийИУправляемый" Тогда
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);	
	Иначе
		НачатьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьОрганизациюИзСервисаЛогистика(Организация) Экспорт
	ОрганизацияОбъект = Организация.ПолучитьОбъект();
	ОрганизацияОбъект.СинхронизироватьИзСервисаЛогистика();
КонецПроцедуры

Процедура ДобавитьРодителяВПуть(Родители, ЭлементСсылка)
	
	Если ЗначениеЗаполнено(ЭлементСсылка.Родитель) Тогда
		Родители.Вставить(0, ЭлементСсылка.Родитель.Наименование);
		ДобавитьРодителяВПуть(Родители, ЭлементСсылка.Родитель)
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПутьОтРодителяКЭлементу(ЭлементСсылка) Экспорт
	
	Родители = Новый Массив;
	ДобавитьРодителяВПуть(Родители, ЭлементСсылка);
	Путь = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(Родители, " -> ");	
	
	Возврат Путь;
	
КонецФункции

Процедура УправлениеКомандамиПерезаполненияТитула(Форма)
	
	Если Не Форма.Параметры.Свойство("Ключ") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Форма.Параметры.Ключ)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Форма.Параметры.Ключ) Тогда
		
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		
		Возврат;
	КонецЕсли;
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Форма.Параметры.Ключ);
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
		ТипЛогистика, Форма.Объект.ДокументОснование);
	
	// Добавим команду открытия настроек
	ЭлементОткрытьНастройкуКонвертации = Форма.Элементы.Найти("ОткрытьНастройкуКонвертации");
	Если ЭлементОткрытьНастройкуКонвертации = Неопределено Тогда
		
		Если ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
			ЭлементГруппаНомерДата = Форма.Элементы.Найти("ГруппаНомерДата");
		ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ_5_02(Форма.Параметры.Ключ)
			И Форма.Элементы.Найти("ГруппаДокументОснование") <> Неопределено
			И Форма.Элементы.ГруппаДокументОснование.Видимость Тогда
			ЭлементГруппаНомерДата = Форма.Элементы.Найти("ГруппаДокументОснование");	
		Иначе
			ЭлементГруппаНомерДата = Форма.Элементы.Найти("ГруппаНомерДата");
		КонецЕсли;
		
		Если ЭлементГруппаНомерДата = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СвойстваЭлемента = Новый Структура;
		СвойстваЭлемента.Вставить("Подсказка", "Открыть настройку конвертации");
		СвойстваЭлемента.Вставить("Вид", ВидДекорацииФормы.Картинка);
		СвойстваЭлемента.Вставить("Ширина", 2);
		СвойстваЭлемента.Вставить("Высота", 1);
		СвойстваЭлемента.Вставить("Гиперссылка", Истина);
		СвойстваЭлемента.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Настройки);
		СвойстваЭлемента.Вставить("ВертикальноеПоложениеВГруппе", ВертикальноеПоложениеЭлемента.Верх);
		
		СобытияЭлемента = Новый Структура;
		СобытияЭлемента.Вставить("Нажатие", "КомандаДокументОснование");
		
		ЭлементОткрытьНастройкуКонвертации = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
			Форма, "ОткрытьНастройкуКонвертации", ЭлементГруппаНомерДата, СвойстваЭлемента, СобытияЭлемента);
		
	Иначе
		
		ЭлементОткрытьНастройкуКонвертации.Видимость = Истина;
		
	КонецЕсли;
	
	Если Форма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	// Добавим команду перезаполнения
	ЭлементПерезаполнитьПоДокОснованию = Форма.Элементы.Найти("ПерезаполнитьПоДокОснованию");
	Если ЭлементПерезаполнитьПоДокОснованию <> Неопределено Тогда
		ЭлементПерезаполнитьПоДокОснованию.Видимость = Истина;
		Возврат;
	КонецЕсли;
	
	ЭлементПерезаполнитьТитул = Форма.Элементы.Найти("ПерезаполнитьТитул");
	Если ЭлементПерезаполнитьТитул = Неопределено Тогда
		
		Если ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
			ЭлементГруппаНомерДата = Форма.Элементы.Найти("ГруппаНомерДата");
		ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ_5_02(Форма.Параметры.Ключ)
			И Форма.Элементы.Найти("ГруппаДокументОснование") <> Неопределено
			И Форма.Элементы.ГруппаДокументОснование.Видимость Тогда
			ЭлементГруппаНомерДата = Форма.Элементы.Найти("ГруппаДокументОснование");
			Форма.Элементы.Переместить(ЭлементОткрытьНастройкуКонвертации, ЭлементГруппаНомерДата);
		Иначе
			ЭлементГруппаНомерДата = Форма.Элементы.Найти("ГруппаНомерДата");
		КонецЕсли;
		
		Если ЭлементГруппаНомерДата = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СвойстваЭлемента = Новый Структура;
		СвойстваЭлемента.Вставить("Заголовок", "Перезаполнить");
		СвойстваЭлемента.Вставить("Вид", ВидДекорацииФормы.Надпись);
		СвойстваЭлемента.Вставить("Гиперссылка", Истина);
		СвойстваЭлемента.Вставить("ЦветТекста", ЦветаСтиля.ЦветТекстаФормы);
		СвойстваЭлемента.Вставить("ВертикальноеПоложениеВГруппе", ВертикальноеПоложениеЭлемента.Верх);
		
		СобытияЭлемента = Новый Структура;
		СобытияЭлемента.Вставить("Нажатие", "КомандаДокументОснование");
		
		ЭлементПерезаполнитьТитул = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
			Форма, "ПерезаполнитьТитул", ЭлементГруппаНомерДата, СвойстваЭлемента, СобытияЭлемента, ЭлементОткрытьНастройкуКонвертации);
		
		// Добавим иконку
		СвойстваЭлемента = Новый Структура;
		СвойстваЭлемента.Вставить("Вид", ВидДекорацииФормы.Картинка);
		СвойстваЭлемента.Вставить("Ширина", 2);
		СвойстваЭлемента.Вставить("Высота", 1);
		СвойстваЭлемента.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Повторить);
		СвойстваЭлемента.Вставить("ВертикальноеПоложениеВГруппе", ВертикальноеПоложениеЭлемента.Центр);
		
		// Иконку решили убрать т.к. это просто картинка и она по факту только мешается
		//КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
		//	Форма, "ПерезаполнитьТитулКартнка", ЭлементГруппаНомерДата, СвойстваЭлемента,, ЭлементПерезаполнитьТитул);
		
	Иначе
		
		ЭлементПерезаполнитьТитул.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗаголовокДопПоляГосСистИзИнфПол(Знач ИнфПол) Экспорт
	
	ГосСистемы = Новый Массив;
	ГосСистемы.Добавить("ЕГАИС");
	ГосСистемы.Добавить("ВетИС");
	ГосСистемы.Добавить("ГИС МТ");
	
	тзИдентификаторыГосСист = Новый ТаблицаЗначений;
	тзИдентификаторыГосСист.Колонки.Добавить("ГосСист");
	тзИдентификаторыГосСист.Колонки.Добавить("Номер");
	тзИдентификаторыГосСист.Колонки.Добавить("Колво");
	
	КраткоеОписание = "";
		
	Для каждого ГосСист Из ГосСистемы Цикл
	
		Отбор = Новый Структура;
		Отбор.Вставить("Идентиф",ГосСист);
		
		Строки = ИнфПол.НайтиСтроки(Отбор);
		
		Если Строки.Количество() = 0 Тогда
			
		ИначеЕсли Строки.Количество() = 1 Тогда			
			НоваяСтрока = тзИдентификаторыГосСист.Добавить();
			НоваяСтрока.ГосСист = ГосСист;
			НоваяСтрока.Номер = Строки[0].Значение;
			НоваяСтрока.Колво = 1;			
		Иначе
			НоваяСтрока = тзИдентификаторыГосСист.Добавить();
			НоваяСтрока.ГосСист = ГосСист;
			НоваяСтрока.Колво = Строка(Строки.Количество());
		КонецЕсли;
		
	КонецЦикла;
	
	Если тзИдентификаторыГосСист.Количество() = 1 И тзИдентификаторыГосСист[0].Колво = 1 Тогда
		КраткоеОписание = тзИдентификаторыГосСист[0].ГосСист + " " + тзИдентификаторыГосСист[0].Номер;	
	Иначе
				
		Для каждого Стр Из тзИдентификаторыГосСист Цикл
			ОписаниеГосСистемы =  Стр.ГосСист + " " + Стр.Колво + " шт.";
			КраткоеОписание = ?(ЗначениеЗаполнено(КраткоеОписание), КраткоеОписание + "; " + ОписаниеГосСистемы, КраткоеОписание + ОписаниеГосСистемы);			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат КраткоеОписание; 
					
КонецФункции

Функция ОрганизацияДляЗапросаУИДов(ДокументОбъектСсылка) Экспорт
	
	ДанныеФайла = Неопределено;
	Организация = Неопределено;
	
	Попытка
		ДанныеФайла = Справочники.КонтурЛогистика_ФайлыОбмена.ПолучитьОсновныеДанныеФайла(ДокументОбъектСсылка);
	Исключение
		ТекстОшибки = "Ошибка при отпределение организации для запроса УИДов. Ошибка: " + ОписаниеОшибки();
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ДокументОбъектСсылка, ТекстОшибки);
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДанныеФайла) И ДанныеФайла.Свойство("Отправитель") Тогда
		Организация = ДанныеФайла.Отправитель;
	КонецЕсли;
	
	Если (ТипЗнч(ДокументОбъектСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") 
		Или ТипЗнч(ДокументОбъектСсылка) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1"))
		И ЗначениеЗаполнено(ДокументОбъектСсылка.Составитель) Тогда
		Организация = ДокументОбъектСсылка.Составитель;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ТочноеСовпадение = Ложь;
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
		Организация = ПараметрыСервиса.ОрганизацияДиадок;
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

Функция ПолучитьДатуНачалаДействияЭПЛ502() Экспорт
	
	РезультатПоУмолчанию = Дата("20260901000000");
	
	Попытка
		
		Результат = КонтурЛогистика_ФункциональныеОпции.ДатаНачалаДействияЭПЛ502();
		Если Результат = Неопределено Или Результат = Дата(1, 1, 1) Тогда
			Результат = РезультатПоУмолчанию;
		КонецЕсли;
		
	Исключение
		Результат = РезультатПоУмолчанию;
	КонецПопытки;
	
	Если Результат < ТекущаяДатаСеанса() 
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист") = Истина Тогда
		
		ВключитьИспользованияЭПЛ502();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ВключитьИспользованияЭПЛ502() Экспорт
	
	Попытка
		
		Результат = КонтурЛогистика_ФункциональныеОпции.ВключитьНастройкуИспользованияЭПЛ502();
		Если Результат = Неопределено Или Не Результат Тогда
			Возврат;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
	
		Если ЗначениеЗаполнено(Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", "ИспользуетсяПутевойЛист_5_02")) Тогда
			Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ИспользуетсяПутевойЛист_5_02", Истина);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	Исключение
		
	КонецПопытки;
		
КонецПроцедуры

// Пометить на удаление

Функция СформироватьТекстВопроса(ПараметрКоманды) Экспорт
	
	Возврат ?(ПараметрКоманды.ПометкаУдаления, 
			"Снять с " + """" + СокрЛП(ПараметрКоманды.Ссылка) + """" + " пометку на удаление?",
			"Пометить " + """" + СокрЛП(ПараметрКоманды.Ссылка) + """" + " на удаление?");
	
КонецФункции

Процедура ПометитьНаУдаление(ПараметрКоманды) Экспорт
	
	Если Метаданные.Справочники.Содержит(ПараметрКоманды.Метаданные()) Тогда
		ПараметрКоманды.ПолучитьОбъект().УстановитьПометкуУдаления(Не ПараметрКоманды.ПометкаУдаления, Ложь);
	ИначеЕсли Метаданные.Документы.Содержит(ПараметрКоманды.Метаданные()) Тогда
		ПараметрКоманды.ПолучитьОбъект().УстановитьПометкуУдаления(Не ПараметрКоманды.ПометкаУдаления);
	КонецЕсли;	
		
КонецПроцедуры

// Фамилия и Инициалы

Функция ФамилияИнициалы(Знач ФамилияИмяОтчество) Экспорт
	
	Если ТипЗнч(ФамилияИмяОтчество) = Тип("Строка") Тогда
		ФамилияИмяОтчество = ЧастиИмени(ФамилияИмяОтчество);
	КонецЕсли;
	
	Фамилия = ФамилияИмяОтчество.Фамилия;
	Имя = ФамилияИмяОтчество.Имя;
	Отчество = ФамилияИмяОтчество.Отчество;
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Фамилия;
	КонецЕсли;
	
	Если ПустаяСтрока(Отчество) Тогда
		Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("%1 %2.", Фамилия, Лев(Имя, 1));
	КонецЕсли;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("%1 %2. %3.", Фамилия, Лев(Имя, 1), Лев(Отчество, 1));
	
КонецФункции

Функция ЧастиИмени(ФамилияИмяОтчество)
	
	Результат = Новый Структура("Фамилия,Имя,Отчество");
	
	ЧастиИмени = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ФамилияИмяОтчество, " ", Ложь);
	
	Если ЧастиИмени.Количество() >= 1 Тогда
		Результат.Фамилия = ЧастиИмени[0];
	КонецЕсли;
	
	Если ЧастиИмени.Количество() >= 2 Тогда
		Результат.Имя = ЧастиИмени[1];
	КонецЕсли;
	
	Если ЧастиИмени.Количество() >= 3 Тогда
		Результат.Отчество = ЧастиИмени[2];
	КонецЕсли;
	
	Если ЧастиИмени.Количество() > 3 Тогда
		ДополнительныеЧастиОтчества = Новый Массив;
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'оглы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'улы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'уулу'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'кызы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'гызы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'угли'"));
		
		Если ДополнительныеЧастиОтчества.Найти(НРег(ЧастиИмени[3])) <> Неопределено Тогда
			Результат.Отчество = Результат.Отчество + " " + ЧастиИмени[3];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

