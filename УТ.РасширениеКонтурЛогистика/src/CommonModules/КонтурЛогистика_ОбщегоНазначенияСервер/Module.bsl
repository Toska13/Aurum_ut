Функция ТипыДокументаОснования(ИмяДокументаЛогистика) Экспорт
	
	Титул1 = Метаданные.Документы.Найти(ИмяДокументаЛогистика);
	
	Если Титул1 = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	РеквизитДокументОснование = Титул1.Реквизиты.Найти("ДокументОснование");
	
	Если РеквизитДокументОснование = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат РеквизитДокументОснование.Тип.Типы();
	
КонецФункции

Функция ПоказатьКомандуЗаполненияДополнения(ИмяДополнения, СтруктураДляПоиска) Экспорт
	
	Если ЕстьДополнение(ИмяДополнения, СтруктураДляПоиска) Тогда		
		
		Если СтруктураДляПоиска.ТипНастройки = "НКС" Тогда
			
			ТаблицаНастроек = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьТаблицуНастроекКонвертацииСправочниковПоУмолчанию(,,,, 
																															"ЗначенияПоУмолчаниюДляДополнений",
																															ИмяДополнения);
				
			ВариантыНастроек = ТаблицаНастроек.Скопировать(, "ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
			ВариантыНастроек.Свернуть("ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
							
			Если ЗначениеЗаполнено(ВариантыНастроек) Тогда 
	
				Для Каждого ВариантНастройки Из ВариантыНастроек Цикл
					
					Если СтруктураДляПоиска.ТипСправочникаИлиДокументаУС = ВариантНастройки.ТипСправочникаИлиДокументаУС
						И СтруктураДляПоиска.ТипСправочникаЛогистика = ВариантНастройки.ТипСправочникаЛогистика
						И СтруктураДляПоиска.ТипДокументаОснования = ВариантНастройки.ТипДокументаОснования
						И Строка(СтруктураДляПоиска.РеквизитТитула) = ВариантНастройки.РеквизитТитула  Тогда
						
						Возврат Истина;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли СтруктураДляПоиска.ТипНастройки = "НКД" Тогда
			
			ТаблицаНастроек = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьТаблицуНастроекКонвертацииДокументововПоУмолчанию(,,, 
																															"ЗначенияПоУмолчаниюДляДополнений", ИмяДополнения);
			
			ВариантыНастроек = ТаблицаНастроек.Скопировать(, "ТипДокументаЛогистика, ТипДокумента1С");
			ВариантыНастроек.Свернуть("ТипДокументаЛогистика, ТипДокумента1С");
							
			Если ЗначениеЗаполнено(ВариантыНастроек) Тогда 
	
				Для Каждого ВариантНастройки Из ВариантыНастроек Цикл
					
					Если СтруктураДляПоиска.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СсылкаПоИмени(ВариантНастройки.ТипДокументаЛогистика)
						И СтруктураДляПоиска.ТипДокумента1С = ВариантНастройки.ТипДокумента1С Тогда
						
						Возврат Истина;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьДополнение(ИмяДополнения, СтруктураДляПоиска)
	
	Если ИмяДополнения = "КТ2000" И Метаданные.НайтиПоПолномуИмени("Справочник.алкПунктыРазгрузки") <> Неопределено Тогда
		Возврат Истина;
	ИначеЕсли ИмяДополнения = "ВуИзРСФЛ" 
		И Метаданные.НайтиПоПолномуИмени("РегистрСведений.ДокументыФизическихЛиц") <> Неопределено 
		И ЗначениеЗаполнено(СтруктураДляПоиска.ТипДокумента1С) 
		И Метаданные.Документы.Найти(СтруктураДляПоиска.ТипДокумента1С).Реквизиты.Найти("Водитель") <> Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;		
	
КонецФункции

