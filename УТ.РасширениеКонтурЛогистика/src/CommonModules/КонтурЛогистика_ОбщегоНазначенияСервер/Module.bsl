&НаСервере
Функция МассивТиповЗначенийЭлементов(Справочники = Неопределено, 
	Перечисления = Неопределено, ПримитивныеТипы = Неопределено, ИмяСправочника = "КонтурЛогистика_Настройки") Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	
	Типы = Метаданные.Справочники[ИмяСправочника].Реквизиты.Значение.Тип.Типы();
	
	Для Каждого СтрокаМассива Из Типы Цикл
		
		Если ЭтоПримитивныйТип(СтрокаМассива) Тогда 
			Если ПримитивныеТипы <> Неопределено Тогда			
				СписокВыбора.Добавить(СтрокаМассива, СтрокаМассива);
			КонецЕсли;
		Иначе
			
			СтрокаТипа = СтрокаТипа(СтрокаМассива);
			Добавить = (Справочники <> Неопределено И ЭтоСправочник_(СтрокаТипа))
						ИЛИ (Перечисления <> Неопределено И ЭтоПеречисление_(СтрокаТипа));
			
			Если Добавить Тогда
				СписокВыбора.Добавить(СтрокаТипа, СтрокаМассива);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СписокВыбора.СортироватьПоЗначению();
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ЭтоПримитивныйТип(ПроверяемыйТип)
	
	ПримитивныеТипы = Новый Массив;
	ПримитивныеТипы.Добавить(Тип("Булево"));
	ПримитивныеТипы.Добавить(Тип("Строка"));
	ПримитивныеТипы.Добавить(Тип("Дата"));
	ПримитивныеТипы.Добавить(Тип("Число"));
	
	ЭтоПримитивныйТип = ПримитивныеТипы.Найти(ПроверяемыйТип) <> Неопределено;
	
	Возврат ЭтоПримитивныйТип;
	
КонецФункции

Функция ЭтоОбъектМетаданныхПоИмени(ПолноеИмя, ИмяОбъекта)
	
	ЭтоОбъектМетаданныхПоИмени = Ложь;
	ИмяРасширенное = ИмяОбъекта + "Ссылка";
	
	ЧастиИмени = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(
		ПолноеИмя,
		".");
			
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат ЭтоОбъектМетаданныхПоИмени;
	КонецЕсли;
	
	Если ЧастиИмени[0] = ИмяОбъекта 
		ИЛИ ЧастиИмени[0] = ИмяРасширенное Тогда
		
		ЭтоОбъектМетаданныхПоИмени = Истина;
		
	КонецЕсли;
	
	Возврат ЭтоОбъектМетаданныхПоИмени;
	
КонецФункции

