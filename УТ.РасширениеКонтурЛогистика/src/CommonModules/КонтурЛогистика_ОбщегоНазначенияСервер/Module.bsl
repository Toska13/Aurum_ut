Функция ЭтоHTTPЗапросОтправкиТитула(ПараметрыЗапроса) Экспорт
	
	Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") И ПараметрыЗапроса.Свойство("АдресМетода") Тогда
		
		АдресМетода = ПараметрыЗапроса.АдресМетода;
		массивАдресМетода = КонтурЛогистика_СтдСтрКлиентСервер.РазложитьСтрокуВМассивПодстрокЛок(АдресМетода, "/");
		
		Если (массивАдресМетода.Найти("documents") <> Неопределено И массивАдресМетода.Найти("waybill") <> Неопределено)
			Или (массивАдресМетода.Найти("documents") <> Неопределено И массивАдресМетода.Найти("epl") <> Неопределено)
			Или (массивАдресМетода.Найти("PostMessage") <> Неопределено)
			Или (массивАдресМетода.Найти("PostMessagePatch") <> Неопределено) Тогда				
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьОбщуюНастройку(ИмяНастройки) Экспорт
	
	Возврат Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", ИмяНастройки);
	
