// Версия стандартной подсистемы выше указанной
//
// Параметры:
//  ВерсияСравнения	 - Строка	 - версия сравнения в формате "*.*.*.*"
// 
// Возвращаемое значение:
//  Булево - истина, если версия стандартной подсистемы выше, чем указанная ВерсияСравнения
//
Функция ВерсияСтандартнойПодсистемыВыше(ВерсияСравнения) Экспорт
	
	МодульОбновлениеИнформационнойБазыСлужебный = ОбщийМодуль("ОбновлениеИнформационнойБазыСлужебный");
	Если МодульОбновлениеИнформационнойБазыСлужебный = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ВерсияИБ = МодульОбновлениеИнформационнойБазыСлужебный.ВерсияИБ("СтандартныеПодсистемы");
	Исключение
		// Не удалось получить версию, возможно нет БСП или не корректно интегрирована
		Возврат Ложь;
	КонецПопытки;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	Если МодульОбщегоНазначенияКлиентСервер = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (МодульОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияИБ, ВерсияСравнения) > 0);
	
КонецФункции

