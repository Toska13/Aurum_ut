Функция СоздатьГруппыДоступа() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГруппаПрофиляГруппДоступа = Неопределено;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		// Создаем группы доступа
		ИмяГруппы = "Контур.Логистика";
		ГруппаПрофиляГруппДоступа = Справочники["ПрофилиГруппДоступа"].НайтиПоНаименованию(ИмяГруппы, Истина);
		Если Не ЗначениеЗаполнено(ГруппаПрофиляГруппДоступа) Тогда
			ГруппаПрофиляГруппДоступаОбъект = Справочники["ПрофилиГруппДоступа"].СоздатьГруппу();
			ГруппаПрофиляГруппДоступаОбъект.Наименование = ИмяГруппы;
			ГруппаПрофиляГруппДоступаОбъект.Записать();
			ГруппаПрофиляГруппДоступа = ГруппаПрофиляГруппДоступаОбъект.Ссылка;
		КонецЕсли;
		
		ГруппаГруппыДоступа = Справочники["ГруппыДоступа"].НайтиПоНаименованию(ИмяГруппы, Истина);
		Если Не ЗначениеЗаполнено(ГруппаГруппыДоступа) Тогда
			ГруппаГруппыДоступаОбъект = Справочники["ГруппыДоступа"].СоздатьГруппу();
			ГруппаГруппыДоступаОбъект.Наименование = ИмяГруппы;
			ГруппаГруппыДоступаОбъект.Записать();
			ГруппаГруппыДоступа = ГруппаГруппыДоступаОбъект.Ссылка;
		КонецЕсли;
		
		СоздатьПрофильАдминистратора(ГруппаПрофиляГруппДоступа, ГруппаГруппыДоступа);
		СоздатьПрофильПродвинутогоПользователя(ГруппаПрофиляГруппДоступа, ГруппаГруппыДоступа);
		СоздатьПрофильПользователя(ГруппаПрофиляГруппДоступа, ГруппаГруппыДоступа);
		
		ГруппаПрофиляГруппДоступа = ГруппаПрофиляГруппДоступа.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "При создании групп доступов возникла ошибка:
			|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(ТекстОшибки);
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ГруппаПрофиляГруппДоступа;
	
КонецФункции

