Функция ПолучитьТаблицуТитуловПеревозкиЗЗ(ГлавныйДокумент)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_ЗЗ_Титул1.Ссылка КАК Ссылка,
	               |	1 КАК НомерТитула,
	               |	ЛОЖЬ КАК ЕстьОтказВПодписи
	               |ПОМЕСТИТЬ ВТ_ДокументыТитулы
	               |ИЗ
	               |	Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
	               |ГДЕ
	               |	КонтурЛогистика_ЗЗ_Титул1.Ссылка = &Титул1
	               |	И НЕ КонтурЛогистика_ЗЗ_Титул1.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтурЛогистика_ЗЗ_Титул2.Ссылка,
	               |	2,
	               |	КонтурЛогистика_ЗЗ_Титул2.ЕстьОтказВПодписи
	               |ИЗ
	               |	Документ.КонтурЛогистика_ЗЗ_Титул2 КАК КонтурЛогистика_ЗЗ_Титул2
	               |ГДЕ
	               |	КонтурЛогистика_ЗЗ_Титул2.Титул1 = &Титул1
	               |	И НЕ КонтурЛогистика_ЗЗ_Титул2.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ДокументыТитулы.Ссылка КАК Титул,
	               |	ВТ_ДокументыТитулы.НомерТитула КАК НомерТитула,
	               |	МАКСИМУМ(ЕСТЬNULL(КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПустаяСсылка))) КАК Статус,
	               |	ВТ_ДокументыТитулы.ЕстьОтказВПодписи КАК ЕстьОтказВПодписи
	               |ИЗ
	               |	ВТ_ДокументыТитулы КАК ВТ_ДокументыТитулы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних(
	               |				,
	               |				Документ В
	               |					(ВЫБРАТЬ
	               |						ВТ_ДокументыТитулы.Ссылка КАК Ссылка
	               |					ИЗ
	               |						ВТ_ДокументыТитулы КАК ВТ_ДокументыТитулы)) КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	               |		ПО ВТ_ДокументыТитулы.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
	               |ГДЕ
	               |	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус В(&СтатусыУспешнойДоставки)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ДокументыТитулы.Ссылка,
	               |	ВТ_ДокументыТитулы.НомерТитула,
	               |	ВТ_ДокументыТитулы.ЕстьОтказВПодписи
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Титул";
	
	Запрос.УстановитьПараметр("Титул1", ГлавныйДокумент);
	СтатусыУспешнойДоставки = СтатусыБылаПопыткаТранспорта();
	Запрос.УстановитьПараметр("СтатусыУспешнойДоставки", СтатусыУспешнойДоставки);
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();
	
