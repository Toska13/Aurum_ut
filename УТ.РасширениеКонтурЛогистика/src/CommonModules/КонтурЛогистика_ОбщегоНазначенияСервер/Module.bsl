	Соответствие.Вставить("КонтурЛогистика_ТранспортныеСредства", "Транспортные средства (Контур.Логистика)");
	Соответствие.Вставить("КонтурЛогистика_Лицензии", "Лицензии (Контур.Логистика)");
	Соответствие.Вставить("КонтурЛогистика_ГорючеСмазочныеМатериалы", "Горюче-смазочные материалы (Контур.Логистика)");
	
	Для Каждого КлючИЗначение Из Соответствие Цикл 
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкиКонвертацииПоТипуСправочникаЛогистики(КлючИЗначение.Ключ);
		
		Если НастройкаКонвертации = Неопределено Тогда 
			
			ЗначениеАвтоконвертации = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_" + КлючИЗначение.Ключ);
			Если ЗначениеАвтоконвертации = Истина Тогда 
				
				Результат.ТекСтраницаПомошника 	= "СтраницаНастройки";
				Результат.ТекстОшибки 			= "Для справочника """ + КлючИЗначение.Значение + """ включена автоконвертация. Но настройка конвертации не найдена.";
				Результат.ТекстДействия 		= "Выключите автоконвертацию для справочника """ + КлючИЗначение.Значение + """ или создайде настройку конвертации для этого справочника.";
				
				Возврат Результат;
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;	
		
	// todo доблять по мере необходимости
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеОрганизацииУСОрганизациямДД(МассивОрганизациДДИлиСсылка) Экспорт 
	
	Таблица = Неопределено;
	
	// проверка наличия справочников "Организации" и "Контрагенты" в конфигурации
	// в случае с КЛ "УчетнаяСистема_Организации" и "УчетнаяСистема_Контрагенты"
	
	ЕстьСправочникОрганизации = Ложь;
	ЕстьСправочникКонтрагенты = Ложь;
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	ЭтоКонфигурацияКЛ = ИмяКонфигурации = "КЛ";

	Если ЭтоКонфигурацияКЛ Тогда 
		
		НазваниеСправочникаОрганизации = "УчетнаяСистема_Организации";
		НазваниеСправочникаКонтрагенты = "УчетнаяСистема_Контрагенты";
		
	Иначе
		
		НазваниеСправочникаОрганизации = "Организации";
		НазваниеСправочникаКонтрагенты = "Контрагенты";
		
	КонецЕсли;	
	
	МД_Организации = Метаданные.Справочники.Найти(НазваниеСправочникаОрганизации);
	
	Если МД_Организации = Неопределено Тогда 
		НазваниеСправочникаОрганизации = "Фирмы";
		МД_Организации = Метаданные.Справочники.Найти(НазваниеСправочникаОрганизации);
		Если МД_Организации = Неопределено Тогда
			// да что ты **** такое?
			ЕстьСправочникОрганизации = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Не МД_Организации = Неопределено Тогда 
		
		Если Не МД_Организации.Реквизиты.Найти("ИНН") = Неопределено 
			И Не МД_Организации.Реквизиты.Найти("КПП") = Неопределено Тогда 

			ЕстьСправочникОрганизации = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	МД_Контрагенты = Метаданные.Справочники.Найти(НазваниеСправочникаКонтрагенты);
	Если Не МД_Контрагенты = Неопределено Тогда 
		
		Если Не МД_Контрагенты.Реквизиты.Найти("ИНН") = Неопределено 
			И Не МД_Контрагенты.Реквизиты.Найти("КПП") = Неопределено Тогда 

			ЕстьСправочникКонтрагенты = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	// поиск организаций
	
	ТекстЗапроса = "";
	
	Если ЕстьСправочникОрганизации И ЕстьСправочникКонтрагенты Тогда  
	
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК ОрганизацияДД,
		|	УчетнаяСистема_Организации.Ссылка КАК ОрганизацияУС
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетнаяСистема_Организации КАК УчетнаяСистема_Организации
		|		ПО КонтурЛогистика_ОрганизацииДиадок.ИНН = УчетнаяСистема_Организации.ИНН
		|			И КонтурЛогистика_ОрганизацииДиадок.КПП = УчетнаяСистема_Организации.КПП
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка В(&МассивОрганизациДД)
		|	И НЕ УчетнаяСистема_Организации.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка,
		|	УчетнаяСистема_Контрагенты.Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетнаяСистема_Контрагенты КАК УчетнаяСистема_Контрагенты
		|		ПО КонтурЛогистика_ОрганизацииДиадок.ИНН = УчетнаяСистема_Контрагенты.ИНН
		|			И КонтурЛогистика_ОрганизацииДиадок.КПП = УчетнаяСистема_Контрагенты.КПП
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка В(&МассивОрганизациДД)
		|	И НЕ УчетнаяСистема_Контрагенты.ПометкаУдаления";	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.УчетнаяСистема_Организации", "Справочник." + НазваниеСправочникаОрганизации);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.УчетнаяСистема_Контрагенты", "Справочник." + НазваниеСправочникаКонтрагенты);
		
	ИначеЕсли ЕстьСправочникОрганизации Тогда 
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК ОрганизацияДД,
		|	УчетнаяСистема_Организации.Ссылка КАК ОрганизацияУС
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетнаяСистема_Организации КАК УчетнаяСистема_Организации
		|		ПО КонтурЛогистика_ОрганизацииДиадок.ИНН = УчетнаяСистема_Организации.ИНН
		|			И КонтурЛогистика_ОрганизацииДиадок.КПП = УчетнаяСистема_Организации.КПП
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка В(&МассивОрганизациДД)
		|	И НЕ УчетнаяСистема_Организации.ПометкаУдаления";	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.УчетнаяСистема_Организации", "Справочник." + НазваниеСправочникаОрганизации);
		
	ИначеЕсли ЕстьСправочникКонтрагенты Тогда 
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК ОрганизацияДД,
		|	УчетнаяСистема_Контрагенты.Ссылка КАК ОрганизацияУС
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетнаяСистема_Контрагенты КАК УчетнаяСистема_Контрагенты
		|		ПО КонтурЛогистика_ОрганизацииДиадок.ИНН = УчетнаяСистема_Контрагенты.ИНН
		|			И КонтурЛогистика_ОрганизацииДиадок.КПП = УчетнаяСистема_Контрагенты.КПП
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка В(&МассивОрганизациДД)
		|	И НЕ УчетнаяСистема_Контрагенты.ПометкаУдаления";	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.УчетнаяСистема_Контрагенты", "Справочник." + НазваниеСправочникаКонтрагенты);
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("МассивОрганизациДД", МассивОрганизациДДИлиСсылка);
		Таблица = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;	
	
	Возврат Таблица;
	
КонецФункции

Функция ОпределитьКонфигурацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ИмяКонфигурации1С = Неопределено;
	
	НастройкаИмяКонфы = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", "ИмяКонфигурации1С");
	Если ЗначениеЗаполнено(НастройкаИмяКонфы) И ЗначениеЗаполнено(НастройкаИмяКонфы.Значение) Тогда // настройка может быть еще не инициализирована.
		// но при попытке её инициализировать механизм вновь обратиться к ОпределитьКонфигурацию() и мы зациклимся. Поэтому сначала проверяем инициализацию.
		ИмяКонфигурации1С = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИмяКонфигурации1С");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда 
		Возврат ИмяКонфигурации1С;
	КонецЕсли;
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.Контур_ОпределитьКонфигурацию();
	
	Если ИмяКонфигурации1С = Неопределено Тогда
		
		Если Не ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда
			Сообщить ("Не удалось определить конфигурацию. Задайте настройку ""Имя конфигурации 1С"" в справочнике ""Настройки (Контур.Логистика)""!");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИмяКонфигурации1С;

КонецФункции

