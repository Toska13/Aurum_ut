Функция ЗначениеОбщейНастройкиДД(НастройкиДиадок, ИмяНастройки) Экспорт
	
	Если НастройкиДиадок.ИспользоватьТиповуюПодсистему1С Тогда
		
		ИмяСвойства = "DDPro_" + ИмяНастройки;
		
		// Получи свойство по имени настройки
		Если НастройкиДиадок.ЭтоУФ Тогда
			СвойствоНастройки = ПланыВидовХарактеристик["ДополнительныеРеквизитыИСведения"].НайтиПоНаименованию(ИмяСвойства, Истина);
		Иначе
			СвойствоНастройки = ПланыВидовХарактеристик["СвойстваОбъектов"].НайтиПоНаименованию(ИмяСвойства, Истина);
		КонецЕсли;
		
		Если СвойствоНастройки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Получим значение по свойству
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство", СвойствоНастройки);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Свойство = &Свойство";
		
		Если НастройкиДиадок.ЭтоУФ Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗначенияСвойствОбъектов", "ДополнительныеСведения");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Значение;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИмяСправочника", "ОбщиеНастройки");
		Запрос.УстановитьПараметр("ИмяРеквизита", ИмяНастройки);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Диадок_ДополнительныеСправочникиДополнительныеРеквизиты.Значение КАК Значение
		|ИЗ
		|	Справочник.Диадок_ДополнительныеСправочники.ДополнительныеРеквизиты КАК Диадок_ДополнительныеСправочникиДополнительныеРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ДополнительныеСправочники КАК Диадок_ДополнительныеСправочники
		|		ПО Диадок_ДополнительныеСправочникиДополнительныеРеквизиты.Ссылка = Диадок_ДополнительныеСправочники.Ссылка
		|ГДЕ
		|	Диадок_ДополнительныеСправочники.ИмяСправочника = &ИмяСправочника
		|	И Диадок_ДополнительныеСправочникиДополнительныеРеквизиты.ИмяРеквизита = &ИмяРеквизита";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Значение;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

