#Область ПрограммныйИнтерфейс

Функция ТекущийМоментВремениМСК() Экспорт
	
	УниверсальноеВремя = УниверсальноеВремя(ТекущаяДатаСеанса(), Неопределено);
	МоментВремени 	   = МестноеВремя(УниверсальноеВремя, "GMT+3");     
	
	Возврат МоментВремени;
	
КонецФункции

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка, ЭлементыДляРазрешенияРедактирования = Неопределено) Экспорт
	
	Если Форма.Параметры.Свойство("ТекущийЭлемент") Тогда 
		
		НайденноеПоле = Форма.Элементы.Найти(Форма.Параметры.ТекущийЭлемент);
		Если Не НайденноеПоле = Неопределено Тогда
			Форма.ТекущийЭлемент = НайденноеПоле;
		КонецЕсли;
		
		Если Форма.Параметры.ТекущийЭлемент = "Собственник" Тогда 
			Форма.Элементы.АдресСтраницы.ТекущаяСтраница = Форма.Элементы.ДанныеСобственника;
		ИначеЕсли Форма.Параметры.ТекущийЭлемент = "АдресКодРегион" Тогда 
			Форма.Элементы.АдресСтраницы.ТекущаяСтраница = Форма.Элементы.АдресРФ;
		ИначеЕсли Форма.Параметры.ТекущийЭлемент = "АдресИндекс" Тогда 
			Форма.Элементы.АдресСтраницы.ТекущаяСтраница = Форма.Элементы.АдресРФ;
		ИначеЕсли Форма.Параметры.ТекущийЭлемент = "АдресИнфАдрес" Тогда 
			Форма.Элементы.АдресСтраницы.ТекущаяСтраница = Форма.Элементы.ПростойТекстГАР;
		ИначеЕсли Форма.Параметры.ТекущийЭлемент = "АдресИнфКодСтраны" Тогда 
			Форма.Элементы.АдресСтраницы.ТекущаяСтраница = Форма.Элементы.ПростойТекстГАР;		
		КонецЕсли;
		
	КонецЕсли;
	
	Если Найти(Форма.ИмяФормы, "Документ.КонтурЛогистика") > 0 Тогда
		УправлениеПользователемПодписантом(Форма);
		УправлениеСвязямиДокументов(Форма);
		УправлениеСтатусомПодписиИКолбасойТитулов(Форма);
		УправлениеВидимостьюКомандФормДокументов(Форма);
		УправлениеЭлементамиИнформированияОТопливе(Форма);
	КонецЕсли;
	
	СтруктураРеквизитаФормы = Новый Структура("СписокНастроекКонвертации", Неопределено);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитаФормы, Форма);
	
	Если СтруктураРеквизитаФормы.СписокНастроекКонвертации <> Неопределено Тогда
		
		СписокЗначенийНКС = СтруктураРеквизитаФормы.СписокНастроекКонвертации;
		
		Для Каждого ЭлСписка Из СписокЗначенийНКС Цикл
			
			Если ЭлСписка.Значение.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
				Форма.Элементы.СвязанныеОбъектыСоздатьНаОсновании.Доступность = Истина;
				
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	УправлениеРазрешениемРедактированияРеквизитов(Форма, ЭлементыДляРазрешенияРедактирования);
	
	// Группы доступа
	УправлениеДоступностьюФормПоГруппамДоступа(Форма);
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_ФормаСписка(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	// Группы доступа
	УправлениеДоступностьюФормПоГруппамДоступа(Форма);
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_ФормаВыбора(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	// Группы доступа
	УправлениеДоступностьюФормПоГруппамДоступа(Форма);
	
КонецПроцедуры

Процедура УправлениеСтатусомПодписиИМЧД(Знач Форма)
	
	Перем ДополнительныеРеквизитыФормы;
	
	Если Не Форма.Параметры.Свойство("Ключ") Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Форма.Параметры.Ключ)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Форма.Параметры.Ключ)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЭР(Форма.Параметры.Ключ) Тогда
		
		// Создать реквизиты формы
		ДополнительныеРеквизитыФормы = КонтурЛогистика_РаботаСЭлементамиФормыСервер.ДополнительныеРеквизитыФормыДляПанелиСтатусовПодписи(Форма);
		Если ДополнительныеРеквизитыФормы.Количество() > 0 Тогда
			Форма.ИзменитьРеквизиты(ДополнительныеРеквизитыФормы);
		КонецЕсли;
		
		// Вывести реквизиты на форму
		КонтурЛогистика_РаботаСЭлементамиФормыСервер.ВывестиСтатусыПодписиСертификатаМЧД(Форма.Параметры.Ключ, Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеКомандамиДокументаУчетнойСистемы(Знач Форма)
	
	Перем ДополнительныеРеквизитыФормы;
	
	Если Форма.Параметры.Свойство("Ключ") Тогда
		
		Если (КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ)) 
			Или (КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Форма.Параметры.Ключ))
			Или (КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Форма.Параметры.Ключ))
		Тогда
		
			ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Форма.Параметры.Ключ);
			НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика);
			
			КонтурЛогистика_РаботаСЭлементамиФормыСервер.ОтображениеКомандыПропуститьОбработкуВходящегоДокумента(Форма, НастройкаКонвертации);
				
			Если ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
				Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
				Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") 
				Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
				
				Если Форма.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
					ИЛИ Форма.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
					ИЛИ Форма.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
					КонтурЛогистика_РаботаСЭлементамиФормыСервер.ВывестиКомандыДокументаОснования(Форма.Параметры.Ключ, Форма, НастройкаКонвертации);	
				КонецЕсли;	
				
			Иначе
								
				КонтурЛогистика_РаботаСЭлементамиФормыСервер.ВывестиКомандыДокументаОснования(Форма.Параметры.Ключ, Форма, НастройкаКонвертации);				
				
			КонецЕсли;
		
		КонецЕсли;
					
	КонецЕсли;
	
КонецПроцедуры

Процедура УпралениеПанельюОбработкиДокументаОбратнымМаппингом(Знач Форма, ТипТитула)
	
	Перем ДополнительныеРеквизитыФормы;
	
	Если Форма.Параметры.Свойство("Ключ") Тогда
		
		Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ) 
			ИЛИ КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Форма.Параметры.Ключ)
			ИЛИ КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Форма.Параметры.Ключ)
			Тогда
			
			ДополнительныеРеквизитыФормы = КонтурЛогистика_РаботаСЭлементамиФормыСервер.ДополнительныеРеквизитыФормыДляОбработкиДокументаОбратнымМаппингом(Форма);
			Если ДополнительныеРеквизитыФормы.Количество() > 0 Тогда
				Форма.ИзменитьРеквизиты(ДополнительныеРеквизитыФормы);
			КонецЕсли;
		   						
			КонтурЛогистика_РаботаСЭлементамиФормыСервер.ВывестиПанельОбработкиДокументаОбратнымМаппингом(Форма.Параметры.Ключ, Форма, ТипТитула);
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура УправлениеРазрешениемРедактированияРеквизитов(Форма, ЭлементыДляРазрешенияРедактирования)
			
	Если ЗначениеЗаполнено(ЭлементыДляРазрешенияРедактирования) Тогда
		
		Для каждого Стр Из ЭлементыДляРазрешенияРедактирования Цикл
	
			Если Форма.Элементы.Найти(Стр) <> Неопределено Тогда
				Форма.Элементы[Стр].ТолькоПросмотр = Истина;				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭлементыДляРазрешенияРедактирования)
		И ТипЗнч(ЭлементыДляРазрешенияРедактирования) = Тип("Массив")
		И ЭлементыДляРазрешенияРедактирования.Количество() > 0
		И КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор() Тогда
		
		КонтурЛогистика_РаботаСЭлементамиФормыСервер.ДобавитьРеквизитЭлементыДляРазрешенияРедактирования(Форма);
		
		Для каждого Стр Из ЭлементыДляРазрешенияРедактирования Цикл
	
			Если Форма.Элементы.Найти(Стр) <> Неопределено Тогда
				Форма.ДФИ_ЭлементыДляРазрешенияРедактирования.Добавить(Стр);
			КонецЕсли;
			
		КонецЦикла;
		
		КонтурЛогистика_РаботаСЭлементамиФормыСервер.ДобавитьЭлементыФормыДляРазрешенияРедактирования(Форма);
								
	КонецЕсли;
	
КонецПроцедуры

Процедура ПреобразоватьПериод(Период) Экспорт
	
	Если ЗначениеЗаполнено(Период) Тогда

		Год = 3600 * 24 * 365;
		Если Период.ДатаОкончания = Дата(1, 1, 1) Или Период.ДатаОкончания > ТекущаяДатаСеанса() + Год Тогда

			Если НачалоДня(Период.ДатаНачала) = НачалоДня(ТекущаяДатаСеанса()) Тогда
				Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Последние7Дней);
			Иначе
				Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
				Период.ДатаОкончания = Период.ДатаНачала + 3600 * 24 * 7;
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры	

// Останавливает выполнение кода на заданное время. 
//
// Параметры:
//  Секунд - Число - время ожидания в секундах.
//
Процедура Пауза(Секунд) Экспорт
	
	ВремяОжидания = Окр(Секунд);
	
    Если ВремяОжидания <> 0 Тогда
        
        НастройкиПрокси = Новый ИнтернетПрокси(Ложь);
		НастройкиПрокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
		НастройкиПрокси.НеИспользоватьПроксиДляАдресов.Добавить("127.0.0.0");

		Попытка
			Соединение = Новый HTTPСоединение("127.0.0.0", , , , НастройкиПрокси, ВремяОжидания);
			Соединение.Получить(Новый HTTPЗапрос);
		Исключение
			ВремяОжидания = 0;
		КонецПопытки;
        
    КонецЕсли;
	
КонецПроцедуры	

// Расчитывает хеш-суммы по строке данных.
// Источник: https://www.strchr.com/hash_functions
//
// Параметры:
//  ИсходныеДанные	 - Строка, ДвоичныеДанные	 - исходные данные.
//  РазмерКлюча		 - Число	 - размер получаемого ключа, как Максимальная величина + 1 (18446744073709551615; 64 бита).
// 
// Возвращаемое значение:
//  Число - хеш-сумма строки данных.
//
Функция ХешСумма(ИсходныеДанные, РазмерКлюча = 18446744073709551616) Экспорт
	
	// Приведем к строке
	Если ТипЗнч(ИсходныеДанные) = Тип("ДвоичныеДанные") Тогда
		СтрокаДанных = Base64Строка(ИсходныеДанные);
	Иначе
		СтрокаДанных = ИсходныеДанные;
	КонецЕсли;
	
	// Используем данные функции Kernighan and Ritchie's.
	ХешСумма = 0;	// Начальное значение
	Множитель = 31;	// Множитель (влияет накачество хеш и производительность)
	
	ДлинаСтроки = СтрДлина(СтрокаДанных);
	
	Для Счет = 1 По ДлинаСтроки цикл
		ХешСумма = Множитель * ХешСумма + КодСимвола(Сред(СтрокаДанных, Счет, 1));
	КонецЦикла;
	
	Возврат ХешСумма % РазмерКлюча;
	
КонецФункции

// Соединяет строки в XML
//
Функция СоединитьСтрокиВXML(Строки, Разделитель = "") Экспорт
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	
	ЭтоМассивСтрок = Истина;
	ЭтоПерваяСтрока = Истина;
	
	Для Каждого Элемент Из Строки Цикл
		
		Строка = Элемент;
		Если ЭтоПерваяСтрока Тогда
			Запись.ЗаписатьБезОбработки(Строка);
			ЭтоПерваяСтрока = Ложь;
		Иначе
			Запись.ЗаписатьБезОбработки(Разделитель);
			Запись.ЗаписатьБезОбработки(Строка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Двоичные данные из строки - аналог ПолучитьДвоичныеДанныеИзСтроки.
//
// Параметры:
//  Строка			 - Строка	 - строка текста.
//  КодировкаТекста_ - Строка	 - кодировка.
//  ЗаписатьBOM		 - Булево	 - признак BOM.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - двоичные данные.
//
Функция ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(Строка, КодировкаТекста_ = "utf-8", ЗаписатьBOM = Ложь) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	Если ЗаписатьBOM Тогда
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста_);
	Иначе	
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.ANSI);
	КонецЕсли;
	
	ЗаписьТекста.Закрыть();
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста_,, Истина, Символы.ПС);
	ЗаписьТекста.Записать(Строка);
	ЗаписьТекста.Закрыть();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат ДвоичныеДанные;
	
КонецФункции

// Соединить двоичные данные - аналог СоединитьДвоичныеДанные.
//
Функция СоединитьДвоичныеДанные_КонтурЛогистика(МассивДвоичныхДанных) Экспорт
	
	// Аналог СоединитьДвоичныеДанные для 8.2
	МассивИменДвоичныхДанных = Новый Массив;
	
	Для Каждого Элемент Из МассивДвоичныхДанных Цикл
		
		// BSLLS:MissingTemporaryFileDeletion-off
		// Диагностика не находит удаления
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		// BSLLS:MissingTemporaryFileDeletion-on
		МассивИменДвоичныхДанных.Добавить(ИмяВременногоФайла);
		
		Элемент.Записать(ИмяВременногоФайла);
		
	КонецЦикла;
	
	ИмяВременногоФайлаРезультат = ПолучитьИмяВременногоФайла();
	
	ОбъединитьФайлы(МассивИменДвоичныхДанных, ИмяВременногоФайлаРезультат);	
	
	ДвоичныеДанныеСоединенные = Новый ДвоичныеДанные(ИмяВременногоФайлаРезультат);
	
	// Удаление файлов
	УдалитьФайлы(ИмяВременногоФайлаРезультат);
	Для Каждого ИмяВременногоФайла Из МассивИменДвоичныхДанных Цикл
		УдалитьФайлы(ИмяВременногоФайла);
	КонецЦикла;
	
	Возврат ДвоичныеДанныеСоединенные;
	
КонецФункции

// Список значений настройки
//
// Параметры:
//  ИмяНастройки - Строка	 - Имя настройки
// 
// Возвращаемое значение:
//  Массив - значения из саписка значений
//
Функция СписокЗначенийНастройки(ИмяНастройки) Экспорт
	
	ПробоватьСоздаватьПриОтсутствии = Ложь;
	
	Настройка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройку_(ИмяНастройки, ПробоватьСоздаватьПриОтсутствии);
	
	Возврат Справочники.КонтурЛогистика_Настройки.СписокЗначенийНастройки(Настройка);
	
КонецФункции

// Определяет можно ли использовать криптографию на сервере
//
// Возвращаемое значение:
//  Булево - Истина, если использовать криптографию на сервере можно
//
Функция МожноИспользоватьКриптографиюНаСервере() Экспорт
	
	Результат = (КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая"
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьПодписьНаСервере"));
	
	Возврат Результат;
	
КонецФункции

// Возвращает разрешения в разрезе титулов и справочников
//
Функция ДоступыПользователя(Пользователь) Экспорт
	
	Возврат Справочники.КонтурЛогистика_ГруппыДоступа.ДоступыПользователя(Пользователь);
	
КонецФункции

// Процедура устанавливает ограничения доступа на уровне записей
//
// Параметры:
//  ИменаПараметровСеанса - Массив
//                        - Неопределено - имена параметров сеанса для инициализации.
//                                         Массив устанавливаемых идентификаторов параметров сеанса,
//                                         которые нужно инициализировать, если обработчик вызывается
//                                         перед использованием неинициализированных параметров сеанса.
//                                         Неопределено, если обработчик события вызывается системой при начале сеанса.
//
Процедура УстановитьОграниченияДоступаНаУровнеЗаписей(ИменаПараметровСеанса) Экспорт
	
	Если ИменаПараметровСеанса = Неопределено
		Или (ИменаПараметровСеанса.Найти("КонтурЛогистика_ОграничениеДоступаНаУровнеЗаписейВключено") = Неопределено
			И ИменаПараметровСеанса.Найти("КонтурЛогистика_ДоступныеОрганизации") = Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	// Роль с полными правами
	Если РольДоступна("КонтурЛогистика_ПолныеПраваЛогистика") Тогда
		
		ОграничениеДоступаНаУровнеЗаписейВключено = Ложь;
		ДоступныеОрганизации = Новый Массив;
		
	Иначе
		
		ИспользоватьОграниченияДоступаПоОрганизацииНаУровнеЗаписей = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ИспользоватьОграниченияДоступаПоОрганизацииНаУровнеЗаписей");
		
		Если ИспользоватьОграниченияДоступаПоОрганизацииНаУровнеЗаписей Тогда
			// Берем из БСП
			ДоступныеОрганизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДоступныеОрганизацииБСП(ПараметрыСеанса.ТекущийПользователь);
		Иначе
			// Беерм из групп доступа
			ДоступныеОрганизации = Справочники.КонтурЛогистика_ГруппыДоступа.ДоступныеОрганизации(ПараметрыСеанса.ТекущийПользователь);
		КонецЕсли;
		
		Если ДоступныеОрганизации.ПолныйДоступ Тогда
			ОграничениеДоступаНаУровнеЗаписейВключено = Ложь;
			ДоступныеОрганизации = Новый Массив;
		Иначе
			ОграничениеДоступаНаУровнеЗаписейВключено = Истина;
			ДоступныеОрганизации = ДоступныеОрганизации.Организации;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыСеанса.КонтурЛогистика_ОграничениеДоступаНаУровнеЗаписейВключено = ОграничениеДоступаНаУровнеЗаписейВключено;
	ПараметрыСеанса.КонтурЛогистика_ДоступныеОрганизации = Новый ФиксированныйМассив(ДоступныеОрганизации);
	
КонецПроцедуры

// Разрешения работы с документами пользователя из настроек сотрудника
//
// Параметры:
//  Пользователь - ОпределяемыйТип.КонтурЛогистика_Пользователи1С	 - текущий пользователь 1С.
//  Организация	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - ограничения по организации.
// 
// Возвращаемое значение:
//  Структура - МожетПодписывать и МожетПередаватьНаПодпись
//
Функция РазрешенияРаботыСДокументамиПользователя(Пользователь, Организация) Экспорт
	
	РазрешенияРаботы = Новый Структура;
	РазрешенияРаботы.Вставить("МожетПодписывать", Истина);	// Если не найдем, то разрешаем
	РазрешенияРаботы.Вставить("МожетПередаватьНаПодпись", Ложь);
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат РазрешенияРаботы;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("УИДПользователя", Строка(Пользователь.УникальныйИдентификатор()));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_СотрудникиСвязанныеОбъекты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СотрудникиПоУИД
	|ИЗ
	|	Справочник.КонтурЛогистика_Сотрудники.СвязанныеОбъекты КАК КонтурЛогистика_СотрудникиСвязанныеОбъекты
	|ГДЕ
	|	КонтурЛогистика_СотрудникиСвязанныеОбъекты.УИД = &УИДПользователя
	|	ИЛИ КонтурЛогистика_СотрудникиСвязанныеОбъекты.СвязанныйОбъект = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_СотрудникиСвязанныеОбъекты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СотрудникиПоФизЛицу
	|ИЗ
	|	Справочник.КонтурЛогистика_Сотрудники.СвязанныеОбъекты КАК КонтурЛогистика_СотрудникиСвязанныеОбъекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаПользователи КАК Справочник_Пользователи
	|		ПО КонтурЛогистика_СотрудникиСвязанныеОбъекты.СвязанныйОбъект = Справочник_Пользователи.ФизическоеЛицо
	|ГДЕ
	|	Справочник_Пользователи.Ссылка = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СотрудникиПоУИД.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Сотрудники
	|ИЗ
	|	СотрудникиПоУИД КАК СотрудникиПоУИД
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СотрудникиПоФизЛицу.Ссылка
	|ИЗ
	|	СотрудникиПоФизЛицу КАК СотрудникиПоФизЛицу
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами.МожетПодписывать КАК МожетПодписывать,
	|	КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами.МожетПередаватьНаПодпись КАК МожетПередаватьНаПодпись
	|ИЗ
	|	Справочник.КонтурЛогистика_Сотрудники.РазрешенияРаботыСДокументами КАК КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сотрудники КАК Сотрудники
	|		ПО КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами.Ссылка = Сотрудники.Ссылка
	|ГДЕ
	|	КонтурЛогистика_СотрудникиРазрешенияРаботыСДокументами.Организация = &Организация";
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	Если ИмяКонфигурации = "КЛ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаПользователи", "УчетнаяСистема_Пользователи");
	ИначеЕсли ИмяКонфигурации = "УПП" Или ИмяКонфигурации = "УТ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаПользователи", "Пользователи");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФизическоеЛицо", "ФизЛицо");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаПользователи", "Пользователи");
	КонецЕсли;
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(РазрешенияРаботы, Выборка);
		КонецЕсли;
		
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
	Возврат РазрешенияРаботы;
	
КонецФункции

// Заменяет подстроку поиска на подсроку замены во всех выражениях вычисления
//
// Параметры:
//  ПодстрокаПоиска	 - Строка	 - подстрока поиска
//  ПодстрокаЗамены	 - Строка	 - подстрока замены
//
Процедура ЗаменитьПодстрокуВВыраженияхВычисления(ПодстрокаПоиска, ПодстрокаЗамены) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодстрокаПоиска", "%" + ПодстрокаПоиска + "%");
	Запрос.Текст = ТекстЗапросаПоискаПодстрокиВВыраженииВычисления();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекущийСправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ТекущийСправочникОбъект.ОбменДанными.Загрузка = Истина;
		
		Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда
			
			// НКД
			ТекущийСправочникОбъект.ДопСвязанныйДокументВыражениеВычисления = СтрЗаменить(
				ТекущийСправочникОбъект.ДопСвязанныйДокументВыражениеВычисления, ПодстрокаПоиска, ПодстрокаЗамены);
			
			ИменаРеквизитовТаблицы = Новый Массив;
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисления");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисления2");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисленияСтрокаНеогр");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПравилаКонвертацииГлавногоДокумента, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПравилаКонвертацииТитулаРеквизиты, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПравилаКонвертацииТитулаТабЧастьТовары, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПравилаКонвертацииТитулаТабЧастьПроизвольная, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.Переменные, ИменаРеквизитовТаблицы);
			
			ИменаРеквизитовТаблицы = Новый Массив;
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисления");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисленияТипЗначения");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисленияСтрокаНеогр");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ЗаполнениеДокУчСист, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ЗаполнениеДокУчСистТЧТовары, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ЗаполнениеДокУчСистТЧПроизвольная, ИменаРеквизитовТаблицы);
			
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисления2");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПеременныеДокУчСист, ИменаРеквизитовТаблицы);
			
			ИменаРеквизитовТаблицы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ВыражениеВычисления");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ТаблицаСоответствий, ИменаРеквизитовТаблицы);
			
		ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников") Тогда
			
			// НКС
			ИменаРеквизитовТаблицы = Новый Массив;
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисления");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисления2");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисленияСтрокаНеогр");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПравилаКонвертации, ИменаРеквизитовТаблицы);
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ПравилаОбратнойКонвертации, ИменаРеквизитовТаблицы);
			
			ИменаРеквизитовТаблицы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ВыражениеВычисления");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ТаблицаСоответствий, ИменаРеквизитовТаблицы);
			
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисленияТипЗначения");
			ИменаРеквизитовТаблицы.Добавить("ВыражениеВычисленияСтрокаНеогр");
			
			ЗаменитьПодстрокуВРеквизитахТабличнойЧасти(ПодстрокаПоиска, ПодстрокаЗамены,
				ТекущийСправочникОбъект.ЗаполнениеСпрУчСист, ИменаРеквизитовТаблицы);
			
		Иначе
			
			// Связи документов
			ТекущийСправочникОбъект.ПоискаПодчиненногоВыражениеВычисления = СтрЗаменить(
				ТекущийСправочникОбъект.ПоискаПодчиненногоВыражениеВычисления, ПодстрокаПоиска, ПодстрокаЗамены);
			
			ТекущийСправочникОбъект.ОтборВыражениеВычисления = СтрЗаменить(
				ТекущийСправочникОбъект.ОтборВыражениеВычисления, ПодстрокаПоиска, ПодстрокаЗамены);
			
			ТекущийСправочникОбъект.РасчетОснованияЗаполнения_ВыражениеВычисления = СтрЗаменить(
				ТекущийСправочникОбъект.РасчетОснованияЗаполнения_ВыражениеВычисления, ПодстрокаПоиска, ПодстрокаЗамены);
			
		КонецЕсли;
		
		ТекущийСправочникОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Сокращенное представление типа документа
//
// Параметры:
//  ТипДокумента	 - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов	 - тип логистического документа.
// 
// Возвращаемое значение:
//  Структура - сокращенное представление типа документа:
//    * ПредставлениеДокумента - Строка - краткое наименование типа титула;
//    * НомерТитула            - Строка - номер титула.
//
Функция СокращенноеПредставлениеТипаДокумента(ТипДокумента) Экспорт
	
	ПредставлениеДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СокращенноеПредставлениеДокумента(ТипДокумента);
	НомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипДокумента);
	
	Результат = Новый Структура;
	Результат.Вставить("ПредставлениеДокумента", ПредставлениеДокумента);
	Результат.Вставить("НомерТитула", НомерТитула);
	
	Возврат Результат;
	
КонецФункции

// Привести к указанному часовому поясучасовому поясу
//
// Параметры:
//  ДатаИзменения		 - Дата	 - датя для изменения
//  ИсходныйЧасовойПояс	 - Строка	 - исходный часовой пояс
//  НовыйЧасовойПояс	 - Строка	 - новый часовой пояс
// 
// Возвращаемое значение:
//  Дата - измененная дата
//
Функция ПривестиКЧасовомуПоясу(Знач ДатаИзменения, ИсходныйЧасовойПояс, НовыйЧасовойПояс = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаИзменения) Тогда
		Возврат ДатаИзменения;
	КонецЕсли;
	
	ЭтоТолькоВремя = Не ЗначениеЗаполнено(НачалоДня(ДатаИзменения)); 
	
	Если ЭтоТолькоВремя Тогда
		// проблема - метод УниверсальноеВремя() не умеет работать с чистым временем без норм даты
		ДатаИзменения = ДатаИзменения + (НачалоДня(ТекущаяДатаСеанса()) - '00010101');
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсходныйЧасовойПояс) Тогда
		УниверсальноеВремя = УниверсальноеВремя(ДатаИзменения, ИсходныйЧасовойПояс);
	Иначе
		УниверсальноеВремя = УниверсальноеВремя(ДатаИзменения, Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовыйЧасовойПояс) Тогда
		Результат = МестноеВремя(УниверсальноеВремя, НовыйЧасовойПояс);
	Иначе
		Результат = МестноеВремя(УниверсальноеВремя, Неопределено);
	КонецЕсли;
	
	Если ЭтоТолькоВремя Тогда 
		Результат = Результат - (НачалоДня(Результат) - '00010101'); // допускаем перевод в предыдущий день
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ссылка веб списка сотрудников логистики
//
// Параметры:
//  Организация	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - организация
// 
// Возвращаемое значение:
//  Строка - ссылка на список сотрудников
//
Функция СсылкаВебСпискаСотрудниковЛогистики(Организация) Экспорт
	
	СсылкаНастройкиВеб = "";
	
	ИспользоватьТестовыйСерверДиадок = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	
	Если ИспользоватьТестовыйСерверДиадок Тогда
		АдресСервера = "https://logist-staging.kontur.ru";
	Иначе
		АдресСервера = "https://logist.kontur.ru";
	КонецЕсли;
	
	boxID = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(Организация, "ID");
	
	СсылкаНастройкиВеб = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1/%2/administrator?mode=employees", АдресСервера, boxID);
	
	Возврат СсылкаНастройкиВеб;
	
КонецФункции

