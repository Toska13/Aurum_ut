Функция СтроковоеПредставлениеОписаниеТипов_(ОписаниеТипа) Экспорт
	
	стрТип = "";
	Для каждого Тип Из ОписаниеТипа.Типы() Цикл
		Если Тип = Тип("Булево") Или Тип = Тип("Строка") Или Тип = Тип("Дата") Или Тип = Тип("Число") Тогда
			стрТип = стрТип + Строка(Тип) + ";";
		Иначе
			
			стрТип = стрТип + СтроковоеПредставлениеТипа_(Тип) + ";";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Лев(стрТип, СтрДлина(стрТип) - 1);
	
КонецФункции

Функция СтроковоеПредставлениеТипа_(Тип) Экспорт
	
	Представление = "";
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(Тип) Тогда
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		ПолноеИмя = Метаданные.НайтиПоТипу(Тип).ПолноеИмя();
		ИмяОбъекта = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ПолноеИмя, ".")[1];
		
		Если ОбъектМетаданных <> Неопределено Тогда
			
			Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
				Представление = "СправочникСсылка";		
			ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
				Представление = "ДокументСсылка";		
			ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
				Представление = "БизнесПроцессСсылка";		
			ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
				Представление = "ПланВидовХарактеристикСсылка";		
			ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
				Представление = "ПланСчетовСсылка";	
			ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
				Представление = "ПланВидовРасчетаСсылка";		
			ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
				Представление = "ЗадачаСсылка";		
			ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
				Представление = "ПланОбменаСсылка";		
			ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
				Представление = "ПеречислениеСсылка";		
			КонецЕсли;
			
		КонецЕсли;
			
		Результат = ?(Представление = "", Представление, Представление + "." + ИмяОбъекта);
		
	ИначеЕсли Тип = Тип("Неопределено") Тогда
		Результат = "Неопределено";		
	ИначеЕсли Тип = Тип("Строка") Тогда
		Результат = "Строка";
	ИначеЕсли Тип = Тип("Число") Тогда
		Результат = "Число";
	ИначеЕсли Тип = Тип("Булево") Тогда
		Результат = "Булево";
	ИначеЕсли Тип = Тип("Дата") Тогда
		Результат = "Дата";	
	Иначе		
		Результат = Строка(Тип);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуПоУИД(УИД, Тип) Экспорт
	
	Если Найти(Тип, "Справочник") Тогда
		Возврат Справочники[СтрЗаменить(Тип, "Справочник.", "")].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	ИначеЕсли Найти(Тип, "Документ") Тогда
		Возврат Документы[СтрЗаменить(Тип, "Документ.", "")].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция СписокТиповДляСвязанногоОбъекта(СправочникСсылка) Экспорт
	
	СписокТипов = Новый СписокЗначений;
	
	ОбъектМетаданных = СправочникСсылка.Метаданные();
	Для каждого ТекущийТип Из ОбъектМетаданных.ТабличныеЧасти.СвязанныеОбъекты.Реквизиты.СвязанныйОбъект.Тип.Типы() Цикл
		Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТекущийТип) Тогда
			СписокТипов.Добавить(Метаданные.НайтиПоТипу(ТекущийТип).Имя, Метаданные.НайтиПоТипу(ТекущийТип).Синоним);
		Иначе
			НовыйЭлемент = СписокТипов.Добавить(Строка(ТекущийТип));
			Если СписокТипов.Индекс(НовыйЭлемент) > 0 Тогда
				СписокТипов.Сдвинуть(НовыйЭлемент, -СписокТипов.Индекс(НовыйЭлемент));
			конецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ВсеНКС = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьВсеНастройкиКонвертации();
	
	НайденныеНКС = ВсеНКС.НайтиСтроки(Новый Структура("ТипСправочникаЛогистика", ОбъектМетаданных.Имя));
	Для каждого ТекущаяНКС Из НайденныеНКС Цикл
		ОбъектМетаданныхТекущейНКД = Метаданные.Справочники.Найти(ТекущаяНКС.Ссылка.ТипСправочникаИлиДокументаУС);
		Если ОбъектМетаданныхТекущейНКД = Неопределено Тогда
			ОбъектМетаданныхТекущейНКД = Метаданные.Документы.Найти(ТекущаяНКС.Ссылка.ТипСправочникаИлиДокументаУС);
			Если ОбъектМетаданныхТекущейНКД = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТипОбъекта = Тип("ДокументСсылка." + ТекущаяНКС.Ссылка.ТипСправочникаИлиДокументаУС);
		Иначе
			ТипОбъекта = Тип("СправочникСсылка." + ТекущаяНКС.Ссылка.ТипСправочникаИлиДокументаУС);
		КонецЕсли;
		
		Если Не ОбъектМетаданных.ТабличныеЧасти.СвязанныеОбъекты.Реквизиты.СвязанныйОбъект.Тип.СодержитТип(ТипОбъекта) Тогда
			
			СписокТипов.Добавить(ТекущаяНКС.Ссылка.ТипСправочникаИлиДокументаУС, Строка(ТипОбъекта), Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(СправочникСсылка) = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") Тогда
		ТипыПользователей1С = Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПодписания.Измерения.Пользователь1С.Тип.Типы();
		Для Каждого ТекущийТипПользователя Из ТипыПользователей1С Цикл
			Если СписокТипов.НайтиПоЗначению(ТекущийТипПользователя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Добавим тип
			СписокТипов.Добавить(
				Метаданные.НайтиПоТипу(ТекущийТипПользователя).Имя,
				Метаданные.НайтиПоТипу(ТекущийТипПользователя).Синоним,
				Истина);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокТипов;
	
КонецФункции

Функция НашиСНастройкойЧтениеЛентыДД(ЧитатьЛентуДиадок) Экспорт
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.НашиСНастройкойЧтениеЛентыДД(ЧитатьЛентуДиадок);
	
