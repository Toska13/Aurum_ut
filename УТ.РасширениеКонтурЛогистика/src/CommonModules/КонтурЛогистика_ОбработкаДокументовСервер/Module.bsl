			ТекстОшибки = "Перевозчик, " + Перевозчик + ", ещё не подключен к ЭДО.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Перевозчик", КатегорияОшибка, ТекстОшибки, "Пригласить в ЭДО");
			
		ИначеЕсли Не Перевозчик.ЕстьВСервисеЛогистика Тогда
			
			ТекстОшибки = "Перевозчик, " + Перевозчик + ", впервые будет работать с ЭПД в сервисе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Перевозчик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		ИначеЕсли Не Перевозчик.ПродуктивТрн Тогда
			
			ТекстОшибки = "Перевозчик, " + Перевозчик + ", работает в тестовом режиме. "
				+ "Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Перевозчик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
