				+ "Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Грузоотправитель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Перевозчик
	Если ЗначениеЗаполнено(Перевозчик) Тогда
		
		Если Не ЗначениеЗаполнено(Перевозчик.ИдентификаторУчастникаЭДО) Тогда
			
			ОрганизацииБезИДУчастникаЭДО.Вставить(Перевозчик, Перевозчик);
			
