//  ТаблицаЗначений - выгрузка из табличной части "ДополнительныеПолучателиФайла" документа "КонтурЛогистика_ТрН_Титул1"
// 
//  Если титул 1 не найден, вернется пустая таблица с той же структурой.
//
Функция НайтиДопПолучателейФайла(ДокументЭТРН) Экспорт
	
	ДополнительныеПолучатели = Новый ТаблицаЗначений;
	ДополнительныеПолучатели.Колонки.Добавить("ОрганизацияДиадок", Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок"));
	
