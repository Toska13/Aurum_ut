	|	КонтурЛогистика_ТрН_Титул2.ВрИнфПрвПрием КАК ВрИнфПрвПрием
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = &ДокументЭТРН
	|	И КонтурЛогистика_ТрН_Титул2.ДатИнфПрвПрием <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_ТрН_Титул2.ДатИнфПрвПрием,
	|	КонтурЛогистика_ТрН_Титул2.ВрИнфПрвПрием";
	
	Запрос.УстановитьПараметр("ДокументЭТРН", ЛюбойТитулТрН.ДокументЭТРН);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать(); // Отладка Результат.Выгрузить()
	
	Если Выборка.Следующий() Тогда 
		ПервоначальнаВерсияТ2 = Выборка.Ссылка;	
	Иначе
		ПервоначальнаВерсияТ2 = Неопределено;
	КонецЕсли;
	
	Возврат ПервоначальнаВерсияТ2;
	
КонецФункции

Функция РассчитатьРазделительДокументаУчетнойСистемы(ТипЛогистика, ДокументОснованиеУчетнойСистемы) Экспорт
	
	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.РассчитатьРазделительДокументаУчетнойСистемы(ТипЛогистика, ДокументОснованиеУчетнойСистемы);
	
КонецФункции

Процедура ЗаполнитьПредставлениеРеквизитовДокументаОснования(ТипЛогистическогоДокумента, МассивКонвертируемыхРеквизитов, Форма) Экспорт
	
	Объект = Форма.Объект;
	Представления = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьПредставлениеРеквизитовДокументаОснования(ТипЛогистическогоДокумента, Объект.ДокументОснование, Объект, МассивКонвертируемыхРеквизитов);
	
	Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл
		
		Значение = Неопределено;
		ИмяЭлементаЛогистика = Эл.Значение; // сконвертированного
		ИмяЭлементаНадписиСопоставить = "ДокУчСист_" + Эл.Ключ + "_Сопоставить";
		ИмяЭлементаЗначениеИзДокУчСист = "ДокУчСист_" + Эл.Ключ;
		
		
		Если Представления.Свойство("ДокУчСист_" + Эл.Ключ, Значение) Тогда
			
			// Есть значение в реквизите ДокУчСист_ххх извлеченного из Документа учетной системы
			
			текВыражение = "Форма.ДокУчСист_" + Эл.Ключ + " = Значение";
			Выполнить (текВыражение);
			
			// определим доступность команды сопоставления
			
			Если ЗначениеЗаполнено(ИмяЭлементаЛогистика) Тогда
				
				ПутьПроверкиДанных = Форма.Элементы.Найти(ИмяЭлементаЛогистика).ПутьКДанным;
				
				РеквизитИзвлеченИзДокумента = ЗначениеЗаполнено(Форма[ИмяЭлементаЗначениеИзДокУчСист]);
				
				Если РеквизитИзвлеченИзДокумента Тогда // если этот элемент выведен на форму и он рассчитан из документа уч сист
					
					Если Форма.Элементы.Найти(ИмяЭлементаЛогистика) <> Неопределено Тогда
						
						ЗначениеВРеквизите = Вычислить(ПутьПроверкиДанных);
						НужноСопоставить = Не ЗначениеЗаполнено(ЗначениеВРеквизите);
						
					Иначе
						
						НужноСопоставить = Ложь;
						
					КонецЕсли;
					
					Форма.Элементы.Найти(ИмяЭлементаЛогистика).Видимость = Не НужноСопоставить;
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Видимость = НужноСопоставить;
					Форма.Элементы.Найти(ИмяЭлементаЗначениеИзДокУчСист).Видимость = НужноСопоставить ИЛИ Форма.РеквизитыУчетногоДокументаВидимы;
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Заголовок = "Сопоставить";
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Подсказка = "Установить новое соответствие";
					
				Иначе // не извлечен из документа Уч сист
					
					Форма.Элементы.Найти(ИмяЭлементаЗначениеИзДокУчСист).Видимость = Ложь;
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Видимость = Ложь;
					
					Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
						
						Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Подсказка = "Не извлечен или не заполнен в док. основании. Открыть исходный документ";
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если Форма.Элементы.Найти(ИмяЭлементаЛогистика) <> Неопределено Тогда
				Форма.Элементы.Найти(ИмяЭлементаЛогистика).Видимость 	= Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПредставлениеРеквизитовДокументаОснования(ТипЛогистическогоДокумента, ДокументОснование, Знач ДокументТитулОбъект, МассивКонвертируемыхРеквизитов) Экспорт

	СтруктураПредставлений = Новый Структура();
	Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл
		СтруктураПредставлений.Вставить("ДокУчСист_" + Эл.Ключ);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистическогоДокумента,
																														ДокументОснование);
		
		Если НастройкаКонвертации <> Неопределено Тогда
			
			Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ДокументТитулОбъект, ДокументОснование, НастройкаКонвертации, "");
			
			Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл
				
				НастройкаКонвертацииРеквизита = НастройкаКонвертации.ПравилаКонвертацииТитулаРеквизиты.Найти(Эл.Ключ,
				"РеквизитТитула");
				ТекущийОбъектДляВычисления = ДокументТитулОбъект;
				
				Если НастройкаКонвертацииРеквизита = Неопределено Тогда 
					// Настройка не введена
					Продолжить;
				КонецЕсли;	
				
				РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(ДокументОснование,
					НастройкаКонвертацииРеквизита,
					НастройкаКонвертации,
					ТекущийОбъектДляВычисления,
					Ложь,
					Переменные);
				
				Если РезультатВычисления.Успешно Тогда
					СтруктураПредставлений.Вставить("ДокУчСист_" + Эл.Ключ, РезультатВычисления.Значение);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат СтруктураПредставлений;

КонецФункции

Процедура Валидатор_ПроверитьДружбуКонтрагентов(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Грузоотправитель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузоотправитель;
		Перевозчик = ДокументОбъектИлиСсылка.ДокументЭТРН.Перевозчик;
		Грузополучатель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузополучатель;
		ЛОП = ДокументОбъектИлиСсылка.ДокументЭТРН.ПогрузкуОсуществляет;
		
		ОрганизацииБезИДУчастникаЭДО = Валидатор_ТРН_ПроверитьРегистрациюЛицВЛогистике(
			Грузоотправитель, Грузополучатель, ЛОП, Перевозчик, ТаблицаОшибок);
		
		Если Грузоотправитель <> Перевозчик
			И ОрганизацииБезИДУчастникаЭДО.Получить(Грузоотправитель) = Неопределено
			И ОрганизацииБезИДУчастникаЭДО.Получить(Перевозчик) = Неопределено
			И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Грузоотправитель, Перевозчик, Истина)
			И (Грузоотправитель.Наш Или Перевозчик.Наш) Тогда
			
			ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Грузоотправитель, Перевозчик, Истина);
		КонецЕсли;
		
		Если Грузоотправитель <> Грузополучатель
			И ОрганизацииБезИДУчастникаЭДО.Получить(Грузоотправитель) = Неопределено
			И ОрганизацииБезИДУчастникаЭДО.Получить(Грузополучатель) = Неопределено
			И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Грузоотправитель, Грузополучатель)
			И (Грузоотправитель.Наш Или Грузополучатель.Наш) Тогда
			
			ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Грузоотправитель, Грузополучатель);
		КонецЕсли;
		
		Если Перевозчик <> Грузополучатель
			И ОрганизацииБезИДУчастникаЭДО.Получить(Перевозчик) = Неопределено
			И ОрганизацииБезИДУчастникаЭДО.Получить(Грузополучатель) = Неопределено
			И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Перевозчик, Грузополучатель)
			И (Перевозчик.Наш Или Грузополучатель.Наш) Тогда
			
			ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Перевозчик, Грузополучатель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЛОП)
			И ОрганизацииБезИДУчастникаЭДО.Получить(ЛОП) = Неопределено Тогда
			
			Если ЛОП <> Грузоотправитель
				И ОрганизацииБезИДУчастникаЭДО.Получить(Грузоотправитель) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(ЛОП, Грузоотправитель, Истина)
				И (ЛОП.Наш Или Грузоотправитель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, ЛОП, Грузоотправитель, Истина);
			КонецЕсли;
			
			Если ЛОП <> Перевозчик
				И ОрганизацииБезИДУчастникаЭДО.Получить(Перевозчик) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(ЛОП, Перевозчик)
				И (ЛОП.Наш Или Перевозчик.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, ЛОП, Перевозчик);
			КонецЕсли;
			
			Если ЛОП <> Грузополучатель
				И ОрганизацииБезИДУчастникаЭДО.Получить(Грузополучатель) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(ЛОП, Грузополучатель)
				И (ЛОП.Наш Или Грузополучатель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, ЛОП, Грузополучатель);
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого Получатель Из ДокументОбъектИлиСсылка.ДополнительныеПолучателиФайла Цикл
			
			Если ОрганизацииБезИДУчастникаЭДО.Получить(Получатель.ОрганизацияДиадок) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Получатель.ОрганизацияДиадок <> Грузоотправитель
				И ОрганизацииБезИДУчастникаЭДО.Получить(Грузоотправитель) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Получатель.ОрганизацияДиадок, Грузоотправитель) 
				И (Получатель.ОрганизацияДиадок.Наш Или Грузоотправитель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Получатель.ОрганизацияДиадок, Грузоотправитель);
			КонецЕсли;
			
			Если Получатель.ОрганизацияДиадок <> Перевозчик
				И ОрганизацииБезИДУчастникаЭДО.Получить(Перевозчик) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Получатель.ОрганизацияДиадок, Перевозчик)
				И (Получатель.ОрганизацияДиадок.Наш Или Перевозчик.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Получатель.ОрганизацияДиадок, Перевозчик);
			КонецЕсли;
			
			Если Получатель.ОрганизацияДиадок <> Грузополучатель
				И ОрганизацииБезИДУчастникаЭДО.Получить(Грузополучатель) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Получатель.ОрганизацияДиадок, Грузополучатель)
				И (Получатель.ОрганизацияДиадок.Наш Или Грузополучатель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Получатель.ОрганизацияДиадок, Грузополучатель);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЛОП)
				И Получатель.ОрганизацияДиадок <> ЛОП
				И ОрганизацииБезИДУчастникаЭДО.Получить(ЛОП) = Неопределено
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Получатель.ОрганизацияДиадок, ЛОП)
				И (Получатель.ОрганизацияДиадок.Наш Или ЛОП.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Получатель.ОрганизацияДиадок, ЛОП);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
		
		Грузоотправитель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузоотправитель;
		Перевозчик = ДокументОбъектИлиСсылка.ДокументЭТРН.Перевозчик;
		Грузополучатель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузополучатель;
		ЛОП = ДокументОбъектИлиСсылка.ДокументЭТРН.ПогрузкуОсуществляет;
		НовГрузополучатель = ДокументОбъектИлиСсылка.НовГрузПол;
		
		ОрганизацииБезИДУчастникаЭДО = Валидатор_ТРН_ПроверитьРегистрациюЛицВЛогистике(
			Грузоотправитель, НовГрузополучатель, ЛОП, Перевозчик, ТаблицаОшибок);
		
		Если ЗначениеЗаполнено(НовГрузополучатель)
			И НовГрузополучатель <> ДокументОбъектИлиСсылка.ПредГрузополучатель
			И ОрганизацииБезИДУчастникаЭДО.Получить(НовГрузополучатель) = Неопределено Тогда
			
			Если Грузоотправитель <> НовГрузополучатель
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Грузоотправитель, НовГрузополучатель)
				И (Грузоотправитель.Наш Или НовГрузополучатель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Грузоотправитель, НовГрузополучатель);
			КонецЕсли;
			
			Если Перевозчик <> НовГрузополучатель
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Перевозчик, НовГрузополучатель)
				И (Перевозчик.Наш Или НовГрузополучатель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Перевозчик, НовГрузополучатель);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЛОП)
				И ЛОП <> НовГрузополучатель
				И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(ЛОП, НовГрузополучатель)
				И (ЛОП.Наш Или НовГрузополучатель.Наш) Тогда
				
				ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, ЛОП, НовГрузополучатель);
			КонецЕсли;
			
			ДополнительныеПолучателиФайла = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДопПолучателейФайла(ДокументОбъектИлиСсылка.ДокументЭТРН);
			Для Каждого Получатель Из ДополнительныеПолучателиФайла Цикл
				
				Если Получатель.ОрганизацияДиадок <> НовГрузополучатель
					И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Получатель.ОрганизацияДиадок, НовГрузополучатель)
