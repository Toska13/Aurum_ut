			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодЗНИнфФщ.УИД_ЗН"); 
			
		ИначеЕсли КНД = "1110347" Тогда 
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодСВИнфПрв.УИД_СВ"); 
