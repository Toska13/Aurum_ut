		ИначеЕсли КНД = "1110346" Тогда 
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодФХЖ2.УИД_ТрН");
			
		ИначеЕсли КНД = "1110380" Тогда 
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфСоб.УИД_ПЛ");
		ИначеЕсли КНД = "1110381" Тогда 
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфМО.УИД_ПЛ");
		ИначеЕсли КНД = "1110382" Тогда 
			Если Формат = "5.02" Тогда
				УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфВыпуск.УИД_ПЛ");
			Иначе
				УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфТехСост.УИД_ПЛ");
			КонецЕсли;			
		ИначеЕсли КНД = "1110383" Тогда 
