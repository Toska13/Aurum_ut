Процедура ПроверитьПолномочияУВходящейМЧД(ФайлСсылка, ТипТитула) Экспорт
	
	Титул = ФайлСсылка.СвязанныйДокумент;
	
	МЧД = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", ФайлСсылка.ИдентификаторМЧД);
	Если МЧД.Пустая() Или Не ЗначениеЗаполнено(ФайлСсылка.Отпечаток) Или Не МЧД.ПроверятьПолномочия Тогда
		Возврат;
	КонецЕсли;
	
	Полномочие = Перечисления.КонтурЛогистика_Полномочия.ПолучитьПолномочиеПоТипуЛогистическогоДокумента(ТипТитула);
	
	Если Не РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.ПроверитьПолномочияМЧД(Титул, МЧД, Полномочие, ТипТитула, ФайлСсылка.Отпечаток) Тогда
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД);
		
		КодОшибки = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД();
		ОписаниеОшибки = "Проверка полномочий не пройдена";
		
		СтруктураОшибки.Вставить("КодОшибки", КодОшибки);
		СтруктураОшибки.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", "Проверка полномочий не пройдена");
		
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
							Титул, Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка, , , СтруктураОшибки);
							
		ФайлОб = ФайлСсылка.ПолучитьОбъект();
		ФайлОб.ПолномочияМЧДНеПрошлиПроверку = Истина;
		ФайлОб.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументЛогистики(ДокументЛогистика, УстановитьСтатусОбработан = Ложь, БылиОшибкиПриКонвертации = Ложь) Экспорт
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументУчетнойСистемыПоТитулу(ДокументЛогистика, УстановитьСтатусОбработан, БылиОшибкиПриКонвертации);
	
	Попытка
	
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументЛогистика);
		
		НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляТекущегоТитула(ДокументЛогистика);
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика, ДокументЛогистика.ДокументОснование);
		
		ДокументЛогистикаОбъект = ДокументЛогистика.ПолучитьОбъект();
		ДокументУчетнойСистемы = ДокументЛогистика.ДокументОснование;
		
		Если НастройкаКонвертации.ЗапускатьКонвертациюПослеОбработкиВходящего И ЗначениеЗаполнено(НайденныйДокУчСист) Тогда 
			
			Переменные = Неопределено; // ЗаполнитьДокументТитулПоДокументуУчетнойСистемы рассчитает их сама
			
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
				ДокументЛогистикаОбъект, НастройкаКонвертации, ДокументУчетнойСистемы, Переменные, Истина);
				
			Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				ДокументЛогистикаОбъект.ЗаполнитьИСконвертироватьТовары(НастройкаКонвертации, Переменные);
			КонецЕсли;
				
			
		КонецЕсли;
		
		ДокументЛогистикаОбъект.ЗаполнитьРеквизитыПоПользователю();
		ДокументЛогистикаОбъект.Записать();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при очистке старых данных по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();	
		
	КонецПопытки;
	
КонецПроцедуры

