	КНД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.КНД");
	
	Формат = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "ВерсФорм");
	Если Не ЗначениеЗаполнено(Формат) Тогда
		Формат = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КНД) Тогда 
		
		Если КНД = "1110350" Тогда
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодЗНИнфФт.УИД_ЗН"); 
