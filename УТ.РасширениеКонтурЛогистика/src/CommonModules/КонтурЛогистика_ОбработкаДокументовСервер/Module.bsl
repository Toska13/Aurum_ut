	Если ЗначениеЗаполнено(Титул1) Тогда		
		
		ДополнительныеПолучатели = Титул1.ДополнительныеПолучателиФайла.Выгрузить();		
		
	КонецЕсли;
	
	Возврат ДополнительныеПолучатели;
	
