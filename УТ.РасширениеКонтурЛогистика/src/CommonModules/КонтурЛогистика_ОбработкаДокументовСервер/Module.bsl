#Область ПрограммныйИнтерфейс

// В отличие от ИзготовитьФайлыОбмена принимает на вход только документы подсистеы КонтурЛогистика
Функция СформироватьФайлыОбменаПоМассивуДокументов(МассивЛогистическихДокументов, ПараметрыФормированияФайловРеквизиты = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Вставить("МассивУспешныхТитулов", Новый Массив);
	Результат.Успешно = Истина;
	
	Для Каждого Документ Из МассивЛогистическихДокументов Цикл 
		
		// для подписания требуется проставить подписанта текущим пользователем
		Если ПараметрыФормированияФайловРеквизиты <> Неопределено
			И ПараметрыФормированияФайловРеквизиты.Свойство("ТребуетсяПодпись")
			И ПараметрыФормированияФайловРеквизиты.ТребуетсяПодпись = Истина
			И Не ЗначениеЗаполнено(Документ.ПользовательПодписант) Тогда
			
			Попытка
				
				ДокументОбъект = Документ.ПолучитьОбъект();
				ДокументОбъект.ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
				ДокументОбъект.Записать();
				
			Исключение
				Сообщить("В Базе данных отсутствует параметр сеанса ТекущийПользователь. Невозможно выбрать подписанта"); 
			КонецПопытки;
			
		КонецЕсли;
		
		// разные типы
		
		Массив1Документа = Новый Массив;
		Массив1Документа.Добавить(Документ);
		
		Если ЭтоТитулТрн(Документ) Тогда
			
			// для ТРН укажем конкретный kl-id (иначе если это титул-обновление, он может не обновить текущий, а создать новый)
			Если ЗначениеЗаполнено(Документ)
				И ЗначениеЗаполнено(Документ.ДокументЭТРН)
				И ЗначениеЗаполнено(Документ.ДокументЭТРН.kl_id)
				Тогда
					
					Если ПараметрыФормированияФайловРеквизиты = Неопределено Тогда
						ПараметрыФормированияФайловРеквизиты = Новый Структура;
					КонецЕсли;
					
					ПараметрыФормированияФайловРеквизиты.Вставить("kl_id", Документ.ДокументЭТРН.kl_id);
					
			КонецЕсли;
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		ИначеЕсли ЭтоТитулЗН(Документ) Тогда
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		ИначеЕсли ЭтоТитулСВ(Документ) Тогда
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		ИначеЕсли ЭтоТитулЗЗ(Документ) Тогда
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		ИначеЕсли ЭтоТитулПЛ(Документ) Тогда
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		ИначеЕсли ЭтоТитулДФ(Документ) Тогда
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		ИначеЕсли ЭтоТитулЭР(Документ) Тогда
			
			РезультатПо1Документу = СформироватьФайлыОбменаПоДокументам(Массив1Документа, ПараметрыФормированияФайловРеквизиты);
			
		Иначе
			Сообщить( "Тип документа " + ТипЗнч(Документ) + " не поддерживается функцией СформироватьФайлыОбменаПоМассивуДокументов");
			Продолжить;
		КонецЕсли;
		
		Если РезультатПо1Документу.Свойство("МассивФайловОбмена") Тогда 
			
			Для Каждого ФайлОбмена Из РезультатПо1Документу.МассивФайловОбмена Цикл 
				
				Результат.МассивФайловОбмена.Добавить(ФайлОбмена);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если РезультатПо1Документу.Успешно Тогда
			Результат.МассивУспешныхТитулов.Добавить(Документ);
			УстановитьСтатусФайлыСформированы(Массив1Документа);	

		Иначе	
			Результат.Успешно 			= Ложь;
			Результат.ОписаниеОшибки 	= Результат.ОписаниеОшибки + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатПо1Документу);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьТитулыПоЗагруженнымФайламОбмена(МассивФайлов = Неопределено) Экспорт

	Если МассивФайлов = Неопределено Тогда 
		
		МассивФайлов = Справочники.КонтурЛогистика_ФайлыОбмена.МассивНеобработанныхПолученныхФайлов();
		
	КонецЕсли;
	
	КонтурЛогистика_КонструкторыXDTO.СформироватьДокументыЛогистика(МассивФайлов);
	
КонецПроцедуры

Процедура ДобавитьOuterDocflowsВФайл(ФайлОбмена, ПараметрыЗапроса, OuterDocflowsМассив, ДатаСобытия) Экспорт 
	
	ФайлОбменаОбъект 	= ФайлОбмена.ПолучитьОбъект();
	ТЧ_OuterDocflows 	= ФайлОбменаОбъект.OuterDocflows;
	
	ЗаписыватьФайл = Ложь;
	
	Для Каждого элементOuterDocflows Из OuterDocflowsМассив Цикл 
		
		Если ТЧ_OuterDocflows.Найти(элементOuterDocflows.OuterDocflowEntityId, "OuterDocflowEntityId") = Неопределено Тогда 
		
			ДвоичныеДанныеФайла = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().АПИ_GetEntityContent(
				ПараметрыЗапроса.ПараметрыСервиса,
				ПараметрыЗапроса.BoxId,
				ПараметрыЗапроса.MessageId,
				элементOuterDocflows.OuterDocflowEntityId);
			
			ТекстОтвета = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайла);
			
			СтрокаТЧ = ТЧ_OuterDocflows.Добавить();
			СтрокаТЧ.DocflowNamedId 		= элементOuterDocflows.DocflowNamedId;
			СтрокаТЧ.OuterDocflowEntityId 	= элементOuterDocflows.OuterDocflowEntityId;
			СтрокаТЧ.Текст 					= Новый ХранилищеЗначения(ТекстОтвета, Новый СжатиеДанных(9));
			СтрокаТЧ.ДатаСобытия 			= ДатаСобытия;
			
			ЗаписыватьФайл = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗаписыватьФайл Тогда 
		ФайлОбменаОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбработатьOuterDocflowsНеобработанныхФайлов(МассивФайлов = Неопределено) Экспорт 
	
	Если МассивФайлов = Неопределено Тогда 
		
		МассивФайлов = Справочники.КонтурЛогистика_ФайлыОбмена.МассивФайловСНеобработаннымOuterDocflows();
		
	КонецЕсли;	
	
	Для Каждого Файл Из МассивФайлов Цикл 
		
		// TODO нужно отрефакторить!!!
		
		ТЧ_OuterDocflows = Файл.OuterDocflows.Выгрузить();
		
		ЭтоТитулТРН = КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Файл.СвязанныйДокумент);
		
		ЗамечанияОбработаны = Ложь;
		
		Для Каждого СтрокаТЧ Из ТЧ_OuterDocflows Цикл 
			
			Если СтрокаТЧ.Обработан Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТЧ.DocflowNamedId = "KlDriverConfirm"
				И ЭтоТитулТРН Тогда
				
				ТекстОтвета = СтрокаТЧ.Текст.Получить();
				ОбработатьЗамечанияВодителяДиадок(Файл, ТекстОтвета, СтрокаТЧ.Обработан);
				
			ИначеЕсли СтрокаТЧ.DocflowNamedId = "KlMt" Тогда
				
				ТекстОтвета = СтрокаТЧ.Текст.Получить();
				ОбработатьОтветМинтранса(Файл, ТекстОтвета, СтрокаТЧ.Обработан);
				
			ИначеЕсли СтрокаТЧ.DocflowNamedId = "kl-driverResolution" Тогда
				
				ТекстОтвета = СтрокаТЧ.Текст.Получить();
				ЗамечанияВодителя = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(ТекстОтвета);
				ЗамечанияВодителя.Вставить("ЗамДатВрПриб",
					КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьДатуJSONЛок(ЗамечанияВодителя.ЗамДатВрПриб));
				ЗамечанияВодителя.Вставить("ЗамДатВрУбыт",
					КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьДатуJSONЛок(ЗамечанияВодителя.ЗамДатВрУбыт));
				ЗамечанияВодителя.Вставить("ЗамДатВрПосПрием",
					КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьДатуJSONЛок(ЗамечанияВодителя.ЗамДатВрПосПрием));
				ЗамечанияВодителя.Вставить("ЗамДатВрПосВыгр",
					КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьДатуJSONЛок(ЗамечанияВодителя.ЗамДатВрПосВыгр));
				
				ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СледующийТипДокумента(Файл.ТипДокумента);
				КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьЗамечанияВодителяЛогистика(Файл, ЗамечанияВодителя, ТипТитула);
				
				СтрокаТЧ.Обработан = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// записываем результат обработки строк в файл
		ФайлОбъект = Файл.ПолучитьОбъект();
		
		Для СЧ = 0 По ТЧ_OuterDocflows.Количество() - 1 Цикл 
			Если Не СтрокаТЧ.Обработан Тогда 
				Продолжить;
			КонецЕсли;

			ФайлОбъект.OuterDocflows[Сч].Обработан = Истина;
			
		КонецЦикла;	
		
		ФайлОбъект.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры	

// в отличие от СформироватьФайлыОбменаПоМассивуДокументов может принимать на вход как документы подсистемы так и документы учетной системы (но не в перемешку и те и другие!) 
Функция ИзготовитьФайлыОбмена(ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты = Неопределено) Экспорт
	
	УточнениеТипаЛогистика = ПараметрыВводаДокументов.УточнениеТипаЛогистика;
	МассивДокументов = ПараметрыВводаДокументов.МассивДокументов;
	Интерактивно = ПараметрыВводаДокументов.Свойство("Интерактивно");
	
	// массив документов может быть разного тиипа - 
	//		это моугут быть документы учетной системы (более ожидаемо) 
	//		или это могут быть документы Логистика (менее ожидаемо)
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоМассивДокументовУчетнойСистемы(МассивДокументов) Тогда
		
		// 1) Доформируем документы Логистика там где они еще не созданы
		
		РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(МассивДокументов, Ложь, УточнениеТипаЛогистика);
		
		МассивДокументовЛогистика = РезультатВвода.ВведенныеДокументы;
		// МассивДокументовЛогистика - здесь лежат введенные документы. они могли быть введены только что или раньше (даже в другом сеансе), важно что мы продолжим работу с ними здесь пока не дойдем до отправки неподписанного
		
	Иначе // команда применена к уже логистическим документам
		
		МассивДокументовЛогистика = МассивДокументов;
		
	КонецЕсли;
	
	// Далее работа с логистическими документами
	
	// 2) Проверим пользователя подписанта
	Если Интерактивно Тогда
		ПроверитьУстановитьТекущегоПользователяПодписанта(МассивДокументовЛогистика);
	КонецЕсли;
	
	// 3) Сформируем файлы
	
	// Отфильтруем документы в соответсвии с настройкой сценария подписания
	РазрешенныеДокументы = ДокументыРазрешенныеКОтправкеСценариемПодписания(МассивДокументовЛогистика);
	
	УведомитьОбОтказах(МассивДокументовЛогистика, РазрешенныеДокументы);
	
	РезультатФормированияФайлов = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьФайлыОбменаПоМассивуДокументов(
		РазрешенныеДокументы, ПараметрыФормированияФайловРеквизиты);
		
	Если НЕ РезультатФормированияФайлов.Успешно Тогда
		
		Сообщить("Не удалось сформировать xml файлы для документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормированияФайлов));
		
	КонецЕсли;
	
	// заново получим файлы документов
	
	ТолькоИсходящие = Истина;
	МассивФайловОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.КрайниеФайлыДокументов(РазрешенныеДокументы, ТолькоИсходящие);
	
	Возврат МассивФайловОбмена;
	
КонецФункции

Процедура ПроверитьУстановитьТекущегоПользователяПодписанта(МассивДокументовЛогистика)
	
	ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
	
	Для Каждого ТекущийДокумент Из МассивДокументовЛогистика Цикл
		
		Попытка
			РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
				ТекущийДокумент, "ДокументОснование, ПользовательПодписант");
		Исключение
			Продолжить;
		КонецПопытки;
		
		// Проверим идентичность пользователя титула и текущего
		Если РеквизитыДокумента.ПользовательПодписант = ПользовательПодписант Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТекущийДокумент);
		
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(
			ТипЛогистика, РеквизитыДокумента.ДокументОснование);
		
		Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверим настройку в НКД
		ПодписантТекущийПользователь = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			НастройкаКонвертации, "ПодписантТекущийПользователь");
		
		Если Не ПодписантТекущийПользователь Тогда
			Продолжить;
		КонецЕсли;
		
		// Установим текущего пользователя в подписанта титула
		ТекущийДокументОбъект = ТекущийДокумент.ПолучитьОбъект();
		ТекущийДокументОбъект.ПользовательПодписант = ПользовательПодписант;
		ТекущийДокументОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзготовитьФайлыОбменаДокументовИзШаблонов(ФайлыОбмена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФайлыОбмена", ФайлыОбмена);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка В(&ФайлыОбмена)
	|	И КонтурЛогистика_ФайлыОбмена.ШаблонОснование <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ФайлыОбмена.ПустаяСсылка)
	|	И КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка)
	|	И КонтурЛогистика_ФайлыОбмена.MessageID = """"";
	
	ФайлыОбменаДляФормирования = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если ФайлыОбменаДляФормирования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(ФайлыОбменаДляФормирования);
	Если РезультатОтправки.Успешно Тогда
		КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьКПодписаниюФайлыОбменаПатчем(ФайлыОбменаДляФормирования);
	Иначе
		Сообщить("Проблемы при отправке документов: "
			+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает документам в регистр КонтурЛогистика_СтатусыТитулов статус ПодготовленКОтправке
// проверяет возможность (валидация документа) и текущий статус
//
// Параметры:
//  МассивДокументов - Массив - документов для перевод в статус ПодготовленКОтправке
// 
// Возвращаемое значение:
//   - Результат - стандартная структура результата
//
Функция ПодготовитьДокументыКОтправке(МассивДокументов, ПереотправлятьОшибки = Ложь, ПараметрыФормированияФайлов = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	Если ПараметрыФормированияФайлов <> Неопределено 
		И ПараметрыФормированияФайлов.Свойство("Сценарий")
		И ПараметрыФормированияФайлов.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного Тогда
		
		ЭтоПодписаниеСуществующегоЧерновика = Истина;
	Иначе
		ЭтоПодписаниеСуществующегоЧерновика = Ложь;
	КонецЕсли;
	
	// Переход в статус ПодготовленКОтправке возможен из Статусов:
	// 	Черновик
	// 	Ошибка
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		Если ПараметрыФормированияФайлов <> Неопределено
			И (ПараметрыФормированияФайлов.Свойство("ПередатьНаПодписание")
				Или ПараметрыФормированияФайлов.Свойство("ПередатьНаСогласованиеВодителю")) Тогда
			
			ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик;
		Иначе
			
			// м.б. уже в этом состоянии? (или ушел еще дальше вперед)
			ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументСсылка, Истина);
			
		КонецЕсли;
		
		Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
			Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
			Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи
			Или (ЭтоПодписаниеСуществующегоЧерновика = Ложь
				И (ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан
					ИЛИ ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)) Тогда
			
			// Также это может быть подпись неподписанного черновика - такое тоже разрешено
			ЭтоПодписьНеподписанного = Ложь;
			Если ПараметрыФормированияФайлов <> Неопределено
				И ПараметрыФормированияФайлов.Свойство("ТребуетсяПодпись")
				И ПараметрыФормированияФайлов.ТребуетсяПодпись = Истина Тогда
				
				КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументСсылка);
				Если ЗначениеЗаполнено(КрайнийФайл) И Не КрайнийФайл.ПодписьВерна Тогда 
					ЭтоПодписьНеподписанного = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ЭтоПодписьНеподписанного = Ложь Тогда 
				Продолжить; // без ругани, просто это действие уже выполнено
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка И ПереотправлятьОшибки = Ложь Тогда
			Результат.МассивОшибок.Добавить("Невозможно подготовить к отправке " + ДокументСсылка + "т.к. документ в состоянии Ошибка");
			Результат.Успешно = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
			И ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
			И ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			И ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
			И ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
			И ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
			
			Результат.МассивОшибок.Добавить("Невозможно подготовить к отправке "
				+ ДокументСсылка + " т.к. документ в состоянии: " + ТекущийСтатус + " а ожидается черновик или ошибка.");
			Результат.Успешно = Ложь;
			
			Продолжить;
			
		КонецЕсли;
		
		// Выполнить валидацию документа
		РезультатВалидации = ПроверитьДокумент(ДокументСсылка, ПараметрыФормированияФайлов);
		
		Если РезультатВалидации.КоличествоОшибок > 0 Тогда
			Результат.ОписаниеОшибки = "Были ошибки при подготовке документов!";
			Для Каждого Ошибка Из РезультатВалидации.МассивОшибок Цикл
				Результат.МассивОшибок.Добавить("Ошибка в " + ДокументСсылка + " - " + Ошибка);
			КонецЦикла;
			Результат.Успешно = Ложь;
			Продолжить;
		Иначе
			УстановитьТитулГотовымКОтправке(ДокументСсылка);
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокумент(Знач ДокументСсылка, ПараметрыФормированияФайлов = Неопределено) Экспорт
	
