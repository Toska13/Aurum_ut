	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|		ПО ТитулыБезГлавного.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Файл
	|ПОМЕСТИТЬ ФайлыБезГлавныхИТитулов
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования < &ДатаУстаревания
	|	И (КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент = ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЗЗ_Титул1.ПустаяСсылка)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент.Представление ЕСТЬ NULL)
	|	И (ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент) = ТИП(Документ.КонтурЛогистика_ЗЗ_Титул1)
	|					ТОГДА КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЗЗ_Титул1.ПустаяСсылка)
	|				КОГДА ТИПЗНАЧЕНИЯ(КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент) = ТИП(Документ.КонтурЛогистика_ЗЗ_Титул2)
	|					ТОГДА КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЗЗ_Титул2.ПустаяСсылка)
	|			КОНЕЦ
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент.Представление ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГлавныеСТитулами.ГлавныйДокумент КАК ГлавныйДокумент,
	|	ГлавныеСТитулами.Титул КАК Титул,
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Файл
	|ПОМЕСТИТЬ ВсеДанные
	|ИЗ
	|	ГлавныеСТитулами КАК ГлавныеСТитулами
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|		ПО ГлавныеСТитулами.ГлавныйДокумент = КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент
	|			И ГлавныеСТитулами.Титул = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
	|ГДЕ
	|	НЕ ГлавныеСТитулами.ГлавныйДокумент В
	|				(ВЫБРАТЬ
	|					т.ГлавныйДокумент
	|				ИЗ
	|					ГлавныеНеУдалять КАК т)
	|	И НЕ ГлавныеСТитулами.Титул ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГлавныеБезТитулов.ГлавныйДокумент,
	|	NULL,
	|	КонтурЛогистика_ФайлыОбмена.Ссылка
	|ИЗ
	|	ГлавныеБезТитулов КАК ГлавныеБезТитулов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|		ПО ГлавныеБезТитулов.ГлавныйДокумент = КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	ТитулыСФайламиБезГлавных.Титул,
	|	ТитулыСФайламиБезГлавных.Файл
	|ИЗ
	|	ТитулыСФайламиБезГлавных КАК ТитулыСФайламиБезГлавных
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	NULL,
	|	ФайлыБезГлавныхИТитулов.Файл
	|ИЗ
	|	ФайлыБезГлавныхИТитулов КАК ФайлыБезГлавныхИТитулов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеДанные.ГлавныйДокумент КАК ГлавныйДокумент,
	|	ВсеДанные.Титул КАК Титул,
	|	ВсеДанные.Файл КАК Файл
	|ИЗ
	|	ВсеДанные КАК ВсеДанные
	|ИТОГИ ПО
	|	ГлавныйДокумент,
	|	Титул";
	
	Запрос.УстановитьПараметр("ДатаУстаревания", ДатаУстаревания);
	
	ДеревоДанных = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Возврат ДеревоДанных;

КонецФункции

