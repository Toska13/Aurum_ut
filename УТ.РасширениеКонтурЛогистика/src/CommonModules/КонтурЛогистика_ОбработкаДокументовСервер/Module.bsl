Процедура ДобавитьУИДМинтрансаВЭТрН(ДокументЭТрН, uid)
	
	Если ДокументЭТрН.УИД <> uid Тогда
		
		ДокументЭТрНОбъект = ДокументЭТрН.ПолучитьОбъект();
		ДокументЭТрНОбъект.УИД = uid;
		ДокументЭТрНОбъект.Записать();
		
	КонецЕсли;
	
