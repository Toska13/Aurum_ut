КонецФункции

Функция РазбитьДокументыНаМассивыПоТипам(МассивДокументовЛогистика)
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументыТ1", 	Новый Массив);
	//Результат.Вставить("ДокументыТ2", 	Новый Массив);
	Результат.Вставить("ДокументыТ3", 	Новый Массив);
	//Результат.Вставить("ДокументыТ4", 	Новый Массив);
	//Результат.Вставить("ДокументыТ5", 	Новый Массив);
	//Результат.Вставить("ДокументыТ6", 	Новый Массив);
	//Результат.Вставить("ДокументыТ7", 	Новый Массив);
	//Результат.Вставить("ДокументыТ8", 	Новый Массив);
	Результат.Вставить("ДокументыЭР", 	Новый Массив);
	Результат.Вставить("Другие", 	Новый Массив);
	
	Для Каждого ДокументЛогистика Из МассивДокументовЛогистика Цикл
		
		// сейчас мы явно ограничены ядром в сценариях - можно подписывать из черновиков только Т1 и Т3 трн и экспедиторскую расписку
		Если ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
			Результат.ДокументыТ1.Добавить(ДокументЛогистика);
		ИначеЕсли ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
			Результат.ДокументыТ3.Добавить(ДокументЛогистика);
		ИначеЕсли ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
			Результат.ДокументыЭР.Добавить(ДокументЛогистика);
		Иначе
			Результат.Другие.Добавить(ДокументЛогистика);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыРазрешенныеКОтправкеСценариемПодписания(МассивДокументовЛогистика) Экспорт
	
	РазрешенныеДокументы = Новый Массив;
	
	МассивыДокументовПоТитулам = РазбитьДокументыНаМассивыПоТипам(МассивДокументовЛогистика);
	
	Если МассивыДокументовПоТитулам.ДокументыТ1.Количество() > 0 Тогда 
		
		ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(
			ТипЛогистическогоДокумента, МассивыДокументовПоТитулам.ДокументыТ1[0].ДокументОснование);
			
		Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
			НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(
				ТипЛогистическогоДокумента);
		КонецЕсли;
			
		МассивДокументовЭтогоТипа = МассивыДокументовПоТитулам.ДокументыТ1;
		
		ВычленитьРазрешенныеКОтправкеДокументыИзМассива(РазрешенныеДокументы, МассивДокументовЭтогоТипа, НастройкаКонвертации);
		
	КонецЕсли;
	
	Если МассивыДокументовПоТитулам.ДокументыТ3.Количество() > 0 Тогда 
		
		ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(
			ТипЛогистическогоДокумента, МассивыДокументовПоТитулам.ДокументыТ3[0].ДокументОснование);
		МассивДокументовЭтогоТипа = МассивыДокументовПоТитулам.ДокументыТ3;
		
		ВычленитьРазрешенныеКОтправкеДокументыИзМассива(РазрешенныеДокументы, МассивДокументовЭтогоТипа, НастройкаКонвертации);
		
	КонецЕсли;
	
	Если МассивыДокументовПоТитулам.ДокументыЭР.Количество() > 0 Тогда 
		
		Для Каждого ТекущийДокумент Из МассивыДокументовПоТитулам.ДокументыЭР Цикл
			ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ТекущийДокумент, Истина);
			ТекКодСостоянияДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ТекущийДокумент).Код;
			Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
				Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
				Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
				Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
				Или ТекКодСостоянияДО = "fr-сheck-forwarder"
				Или ТекКодСостоянияДО = "fr-сheck-cargo-owner" Тогда
				
				РазрешенныеДокументы.Добавить(ТекущийДокумент);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// другие типы титулов сейчас проверям только просто по статусу
	Для Каждого Документ Из МассивыДокументовПоТитулам.Другие Цикл 
		ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Документ, Истина);
		Если (ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
			ИЛИ ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
			ИЛИ ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
			ИЛИ ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка) Тогда
			
			// требуется ли дополнительно проверять статус документооборота?
			// кажется что здесь это может быть лишним запросом
			РазрешенныеДокументы.Добавить(Документ);
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат РазрешенныеДокументы;
	
КонецФункции

Процедура ВычленитьРазрешенныеКОтправкеДокументыИзМассива(РазрешенныеДокументы, Знач МассивДокументовЭтогоТипа, Знач НастройкаКонвертации)
	
	Для Каждого Документ Из МассивДокументовЭтогоТипа Цикл 
		
		Если ДокументМожноОтправлять(Документ, НастройкаКонвертации) Тогда
			РазрешенныеДокументы.Добавить(Документ);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ДокументМожноОтправлять(ДокументСсылка, НастройкаКонвертации) Экспорт
	
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		ПодписьПолученногоЧерновикаРазрешена = НастройкаКонвертации.Сценарий_РазрешитьПодписыватьПолученныйЧерновик;
		ПодписьОтправленногоЧерновикаРазрешена = НастройкаКонвертации.Сценарий_РазрешитьПодписыватьПослеОтправки;
		ПодписьВМодулеРазрешена = НастройкаКонвертации.Сценарий_ОтправлятьПодписанный;
		ОтправкаНеподписанногоРазрешена = НастройкаКонвертации.Сценарий_ОтправлятьНеподписанный;
	Иначе
		ПодписьПолученногоЧерновикаРазрешена = Ложь;
		ПодписьОтправленногоЧерновикаРазрешена = Ложь;
		ПодписьВМодулеРазрешена = Ложь;
		ОтправкаНеподписанногоРазрешена = Ложь;
	КонецЕсли;
	
	СостояниеТитулаИНастройки = СостояниеТитулаИНастройки(ДокументСсылка);
	СтатусТитула = СостояниеТитулаИНастройки.СтатусТитула;
	Сценарий = СостояниеТитулаИНастройки.Сценарий;
	
	Если (СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка)
		И (ПодписьВМодулеРазрешена Или ОтправкаНеподписанногоРазрешена)Тогда
		
		// требуется ли дополнительно проверять статус документооборота?
		// кажется что здесь это может быть лишним запросом
		Возврат Истина;
		
	ИначеЕсли (СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением)
		И (ПодписьПолученногоЧерновикаРазрешена Или ОтправкаНеподписанногоРазрешена) Тогда
		
		Файл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументСсылка);
		Если Файл <> Неопределено И Не Файл.ПодписьВерна Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
		
		Если (СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-storekeeper"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-storekeeper"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-storekeeper"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-consignor-sign"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-consignee-sign"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-consignee-sign")
			И (Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного)
			И ПодписьОтправленногоЧерновикаРазрешена Тогда
			
			Файл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументСсылка);
			Если Файл <> Неопределено И Не Файл.ПодписьВерна Тогда
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ВыполнитьДействиеПоУмолчанию

Функция ИзготовитьФайлыДляОтправкиЧерновиков(МассивДокументов, ПараметрыФормированияФайловРеквизиты = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		РезультатФормирования = ДокОбъект.СформироватьФайлОбмена(ПараметрыФормированияФайловРеквизиты);
		
		Если РезультатФормирования.Успешно Тогда
			
			Для каждого текЗаявка Из РезультатФормирования.МассивФайловОбмена Цикл
				Результат.МассивФайловОбмена.Добавить(текЗаявка);
			КонецЦикла;
			
		Иначе
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормирования));
			
			// если файл не сформирован, то должна быть ошибка
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументСсылка, Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат.МассивФайловОбмена;
	
КонецФункции

Функция ВвестиДокументы(МассивДокументов, УточнениеТипаЛогистика)Экспорт
	
	РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(МассивДокументов, Ложь, УточнениеТипаЛогистика);
		
	МассивДокументовЛогистика = РезультатВвода.ВведенныеДокументы;
	Возврат МассивДокументовЛогистика;
	
КонецФункции

Процедура ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика) Экспорт
	
	// Отправим файлы
	Если ТипЗнч(МассивДокументовЛогистика) = Тип("Массив")
		И МассивДокументовЛогистика.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьДокументыКОтправке(МассивДокументовЛогистика, Истина);
		Если НЕ РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьКОтправкеПодписанные(МассивПодписанныхФайловОбмена) Экспорт
	
	МассивДокументовЛогистика = Новый Массив;
	Для Каждого ФайлОбмена Из МассивПодписанныхФайловОбмена Цикл 
		МассивДокументовЛогистика.Добавить(ФайлОбмена.СвязанныйДокумент);
	КонецЦикла;
	
	ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика)
	
КонецПроцедуры

Процедура ОтправитьФайлы(МассивФайловОбмена) Экспорт
	
	// Отправим файлы
	Если ТипЗнч(МассивФайловОбмена) = Тип("Массив")
		И МассивФайловОбмена.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(МассивФайловОбмена);
		Если Не РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: "
				+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВвестиСледующиеДокументыТитулыПакетно(УточнениеТипаЛогистика, МассивДокументов, МассивДанныеЗаполнения) Экспорт

	РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(МассивДокументов, УточнениеТипаЛогистика, Ложь, МассивДанныеЗаполнения);

	МассивДокументовЛогистика = РезультатВвода.ВведенныеДокументы;
	Возврат МассивДокументовЛогистика;

КонецФункции

Функция ВвестиДокументыПереотправка(МассивТитулов, ТипЛогистика) Экспорт
	
	МассивВведенных = Новый Массив; 
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	
	Для Каждого Титул Из МассивТитулов Цикл 
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
				
				НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
					ТипЛогистика, 
					Титул.ДокументОснование);
				
				ДокументЭТрНОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
				КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументЭТрНОбъект, Титул.ДокументОснование, НастройкаКонвертации);
				ДокументЭТрНОбъект.Записать();
				ДокументЭТРН = ДокументЭТрНОбъект.Ссылка;
				
				НовыйТитул = Титул.Скопировать();
				НовыйТитул.ДокументЭТРН = ДокументЭТРН;
				НовыйТитул.Записать();
				
				Состояние 			= "forwarded";
				ДобавляемыйТитул 	= НовыйТитул.Ссылка;
				ПредыдущийГлавный	= Титул.ДокументЭТРН;
				
			ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
				
				НовыйТитул = Титул.Скопировать();
				НовыйТитул.УИД_Зак = "";
				НовыйТитул.Записать();
				
				Состояние 			= "forwarded";
				ДобавляемыйТитул 	= НовыйТитул.Ссылка;
				ПредыдущийГлавный	= Титул;
				
			ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
				
				Состояние 			= "completed";		
				ДобавляемыйТитул 	= Титул;
				ПредыдущийГлавный	= Титул.ДокументЭТРН;
				
			ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
				Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
				
				НовыйТитул = Титул.Скопировать();
				НовыйТитул.УИД_ПЛ = "";
				НовыйТитул.Записать();
				
				Состояние 			= "forwarded";
				ДобавляемыйТитул 	= НовыйТитул.Ссылка;
				ПредыдущийГлавный	= Титул;
				
			Иначе
				
				ВызватьИсключение "Не удалось ввести переотправку по Титулу: " + Титул.Ссылка;
				
			КонецЕсли;
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДобавляемыйТитул, Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ПредыдущийГлавный, Состояние);
			
			МассивВведенных.Добавить(ДобавляемыйТитул);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ВызватьИсключение "Не удалось ввести переотправку по Титулу: " + Титул.Ссылка;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат МассивВведенных;
	
КонецФункции	

// Вспомогательные

Функция ДокументУспешноПодготовлен(ДокументТитул) Экспорт

	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументТитул, Истина);
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьСледующийПоЦепочкеТипТитула(ДокументСсылка) Экспорт

	Возврат Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПолучитьСледующийПоЦепочкеТипТитулаЭТРН(ДокументСсылка.ДокументЭТРН);	

КонецФункции

Функция ПолучитьДействиеПоУмолчаниюДокУчСист(ДокументСсылка, ТипыЛогистика) Экспорт

	Если ТипыЛогистика.Количество() = 1 Тогда
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипыЛогистика[0], ДокументСсылка);
		Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
			Возврат НастройкаКонвертации.СценарийПоУмолчанию;
		Иначе
			Сообщить("Не могу определить какой вводить тип титула из документа (не найдена настройка конвертации)");
			Возврат Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПустаяСсылка();
		КонецЕсли;
		
	Иначе
		
		Сообщить("Не могу определить какой вводить тип титула из документа (найдено несколько)"); // TODO спросить у пользователя
		Возврат Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДействиеПоУмолчаниюДокТитул(ДокументТитулСсылка, ТипДокОснования = Неопределено) Экспорт
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументТитулСсылка);
	
	Если ТипДокОснования = Неопределено
		И ЗначениеЗаполнено(ДокументТитулСсылка.ДокументОснование) Тогда
		
		ТипДокОснования = ТипЗнч(ДокументТитулСсылка.ДокументОснование);
	КонецЕсли;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика, ТипДокОснования);
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации) И ЗначениеЗаполнено(ТипДокОснования) Тогда 
		// поищем без указания типа документа основания
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика);
	КонецЕсли;
	
	Возврат ПолучитьТребуемоеДействиеПоДокТитулИНастройкеКонвертации(ДокументТитулСсылка, НастройкаКонвертации);
	
КонецФункции

// Рассчитает текущее требуемое действие с титулом (будет запрошен его статус если передать)
//
// Параметры:
//  ДокументТитулСсылка	 - Любой Документ-титул подсистемы
//  НастройкаКонвертации - необязательно - если не передан запросим 
//  СтатусТитула - необязательно - если передать, то не будем запрашивать из регистра КонтурЛогистика_СтатусыТитулов. Используйте для записи в регистр КонтурЛогистика_СтатусыТитулов нового статуса 
// 
// Возвращаемое значение:
//  ТребуемоеДействие - что сейчас требуется делать с документом.
//
Функция ПолучитьТребуемоеДействиеПоДокТитулИНастройкеКонвертации(ДокументТитулСсылка, НастройкаКонвертации = Неопределено, СтатусТитула = Неопределено) Экспорт
	
	ТребуемоеДействие = Неопределено;
	
	// Узнаем сценарий
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		НаправлениеКонвертации = НастройкаКонвертации.НаправлениеКонвертации;
	Иначе
		Сообщить("Не могу определить действие по умолчанию с документом (не найдена настройка конвертации)");
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаправлениеКонвертации) Тогда
		Сообщить("В настройке конвертации " + НастройкаКонвертации
			+ " не выбрано направление конвертации. Требуемое действие не может быть определено");
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	// Расчитаем требуемое действие по статусу ДО
	СостояниеТитулаИНастройки = СостояниеТитулаИНастройки(ДокументТитулСсылка, НастройкаКонвертации);
	ТребуемоеДействие = ПолучитьТребуемоеДействиеПоСтатусуДО(СостояниеТитулаИНастройки);
	
	Если Не ЗначениеЗаполнено(ТребуемоеДействие) Тогда
		
		// Узнаем ТД по сценарию
		Если НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
			
			ТребуемоеДействие = ПолучитьТребуемоеДействиеИсходящего(СостояниеТитулаИНастройки);
			
		ИначеЕсли НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
			
			ТребуемоеДействие = ПолучитьТребуемоеДействиеВходящего(СостояниеТитулаИНастройки.СтатусТитула);
			
		ИначеЕсли НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее Тогда
			
			ТребуемоеДействие = ПолучитьТребуемоеДействиеСложныйОбмен(СостояниеТитулаИНастройки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТребуемоеДействие = ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(ТребуемоеДействие, ДокументТитулСсылка);
	
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ПолучитьТребуемоеДействиеПоСтатусуДО(Знач СостояниеТитулаИНастройки)
	
	ТребуемоеДействие = Неопределено;
	
	Если СостояниеТитулаИНастройки.КодСтатусаДО = "r-rejected"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "c-rejected"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "zz-rejected"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "pl-rejected-cheсkup"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "pl-rejected-techInspection" Тогда
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Переотправить;
		
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(СостояниеТитулаИНастройки.ТипЛогистика) Тогда
		
		Если СостояниеТитулаИНастройки.КодСтатусаДО = "fr-сheck-forwarder" Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ПолучитьТребуемоеДействиеСложныйОбмен(Знач СостояниеТитулаИНастройки)
	
	Перем НайденныйВходящийФайл, ТребуемоеДействие;
	
	СтатусТитула = СостояниеТитулаИНастройки.СтатусТитула;
	СценарийРаботы = СостояниеТитулаИНастройки.Сценарий;
	
	Если СценарийРаботы = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного Тогда
		
		Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик  Тогда
			// черновик набили сами а не загрузили из сервиса
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли СценарийРаботы = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика Тогда 
		
		Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки  Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Обработать;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик  Тогда
			// черновик набили сами а не загрузили из сервиса
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
			
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли СценарийРаботы = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного Тогда 
		
		Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки  Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Обработать;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик  Тогда
			// черновик набили сами а не загрузили из сервиса
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли СценарийРаботы = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного Тогда
		
		Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением  Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
			
			// Как понять в ТД ПодготовленКОтправке, СформированыФайлыОбмена, Ошибка - что эта проблема возникла при первой отправке черновика или уже при подписании? 
			// Ответ: надо найти полученный файл - если он найдется, то требуется отправить подписанный
			
			НайденныйВходящийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаТитула(
				СостояниеТитулаИНастройки.ДокументТитулСсылка,, Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен);
			Если ЗначениеЗаполнено(НайденныйВходящийФайл) Тогда
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			Иначе
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
			КонецЕсли;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки  Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Обработать;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик  Тогда
			// еще не отправленный
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
			
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	Иначе
		Сообщить("В настройке конвертации " + СостояниеТитулаИНастройки.НастройкаКонвертации
			+ " не выбран сценарий работы. Требуемое действие не может быть определено");
	КонецЕсли;
	
	Возврат ТребуемоеДействие;

КонецФункции

Функция ПолучитьТребуемоеДействиеВходящего(Знач СтатусТитула)
	
	ТребуемоеДействие = Неопределено;
	
	Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
		ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан
		ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением
		ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
		Тогда 
		// уже обработан
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		
	ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки Тогда 
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Обработать;
	Иначе
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
	КонецЕсли;
	
	Возврат ТребуемоеДействие;

КонецФункции

Функция ПолучитьТребуемоеДействиеИсходящего(Знач СостояниеТитулаИНастройки)
	
	ТребуемоеДействие = Неопределено;
	
	Сценарий = СостояниеТитулаИНастройки.Сценарий;
	
	Если Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка Тогда
		
		Если СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
			Или СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
			Или СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена Тогда
			
			ТребуемоеДействие = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию);
		ИначеЕсли СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен Тогда
			
			Если СостояниеТитулаИНастройки.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе
				Или СостояниеТитулаИНастройки.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне Тогда
				
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			КонецЕсли;
		ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-storekeeper"		// Приемка, Кладовщик
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-storekeeper"
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-storekeeper"
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-consignor-sign"	// Оформление, Грузоотправитель
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-consignee-sign"
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-consignee-sign" Тогда
			
			ТребуемоеДействие = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию, Истина);
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	Иначе
		
		Если СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-storekeeper"			// Приемка, Кладовщик
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-storekeeper"
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-storekeeper" Тогда
			
			Если Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного Тогда
				
				Если СостояниеТитулаИНастройки.НастройкаКонвертации.ОбязательноБезЗамечаний Тогда
					Попытка
						Если СостояниеТитулаИНастройки.НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
							КомментарииВодителя = СостояниеТитулаИНастройки.ДокументТитулСсылка.ДокументЭТРН.КомментарииВодителяПриПогрузке;
						Иначе
							КомментарииВодителя = СостояниеТитулаИНастройки.ДокументТитулСсылка.ДокументЭТРН.КомментарииВодителяПриВыгрузке;
						КонецЕсли;
					Исключение
						КомментарииВодителя = "";
					КонецПопытки;
					
					Если КомментарииВодителя = "" Тогда
						Если Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного Тогда
							// Подписание
							ТребуемоеДействие = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию, Истина);
						Иначе
							// Согласование кладовщик
							ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание;
						КонецЕсли;
					Иначе
						// Согласование водитель
						ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю;
					КонецЕсли;
					
				Иначе
					Если Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного Тогда
						// Согласование кладовщик
						ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание;
					Иначе
						// Подписание
						ТребуемоеДействие = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию, Истина);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного Тогда
				
				// Согласование кладовщик
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание;
				
			КонецЕсли;
			
		ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-consignor-sign"	// Оформление, Грузоотправитель
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-consignee-sign"
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-consignee-sign" Тогда
			
			// Подписание
			ТребуемоеДействие = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию, Истина);
			
		Иначе
			
			Если СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
				Или СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
				Или СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена Тогда
				
				Если Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного Тогда
					
					// Согласование кладовщик
					ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание;
					
				ИначеЕсли Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного
					Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного Тогда
					
					// Согласование водитель
					ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю;
					
				Иначе
					
					// Черновик
					ТребуемоеДействие = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию,, Истина);
					
				КонецЕсли;
				
			Иначе
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ТребуемоеДействиеПоСценариюПоУмолчанию(Знач СценарийПоУмолчанию, Знач ТолькоПодисание = Ложь, Знач ТолькоЧерновик = Ложь)
	
	Если СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе Тогда
		
		Если ТолькоЧерновик Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		КонецЕсли;
		
	ИначеЕсли СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне Тогда
		
		Если ТолькоЧерновик Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный;
		КонецЕсли;
		
	ИначеЕсли СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе Тогда
		
		Если ТолькоПодисание Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
		КонецЕсли;
		
	ИначеЕсли СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВФоне Тогда
		
		Если ТолькоПодисание Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик;
		КонецЕсли;
		
	ИначеЕсли СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.СоздатьЧерновик Тогда
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		
	Иначе
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		
	КонецЕсли;
	
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(Знач ТекущееТребуемоеДействие, Знач ДокументТитулСсылка) Экспорт
	
	ТребуемоеДействие = ТекущееТребуемоеДействие;
	
	ТипДокумента = ТипЗнч(ДокументТитулСсылка);
	Если ТипДокумента <> Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
		И ТипДокумента <> Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
		
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	Если ТребуемоеДействие <> Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
		И ТребуемоеДействие <> Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный
		И ТребуемоеДействие <> Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание Тогда
		
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	// Получим разрешения
	ТекущийПользователь = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
	Если Не ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументТитулСсылка.ДокументЭТРН) Тогда
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		ЗначенияРеквизтовЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ДокументТитулСсылка.ДокументЭТРН,
			"ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку, ПогрузкуОсуществляет, ПогрузкуОсуществляет, Грузоотправитель");
		
		Если ЗначенияРеквизтовЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку
			И ЗначениеЗаполнено(ЗначенияРеквизтовЭТРН.ПогрузкуОсуществляет) Тогда
			
			ТекущаяОрганизация = ЗначенияРеквизтовЭТРН.ПогрузкуОсуществляет;
		Иначе
			ТекущаяОрганизация = ЗначенияРеквизтовЭТРН.Грузоотправитель;
		КонецЕсли;
	Иначе
		Грузополучатель = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ДокументТитулСсылка, "Грузополучатель");
		
		Если ЗначениеЗаполнено(Грузополучатель) Тогда
			ТекущаяОрганизация = Грузополучатель;
		Иначе
			ТекущаяОрганизация = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				ДокументТитулСсылка.ДокументЭТРН, "Грузополучатель");
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяОрганизация) Тогда
		Возврат ТребуемоеДействие;
	КонецЕсли;
	
	РазрешенияРаботы = КонтурЛогистика_ОбщегоНазначенияСервер.РазрешенияРаботыСДокументамиПользователя(
		ТекущийПользователь, ТекущаяОрганизация);
	
	// Ничего не доступно
	Если Не РазрешенияРаботы.МожетПодписывать И Не РазрешенияРаботы.МожетПередаватьНаПодпись Тогда
		Возврат Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоСотрудника;
	КонецЕсли;
	
	Если ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
		И Не РазрешенияРаботы.МожетПередаватьНаПодпись Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоСотрудника;
	КонецЕсли;
	
	Если (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
		Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный)
		И Не РазрешенияРаботы.МожетПодписывать Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоСотрудника;
	КонецЕсли;
	
	// Все доступно, оставляем как есть
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция СостояниеТитулаИНастройки(Знач ДокументТитулСсылка, Знач НастройкаКонвертации = Неопределено) Экспорт
	
	СостояниеТитулаИНастройки = Новый Структура;
	СостояниеТитулаИНастройки.Вставить("ДокументТитулСсылка", ДокументТитулСсылка);
	СостояниеТитулаИНастройки.Вставить("ТребуемоеДействие");
	СостояниеТитулаИНастройки.Вставить("СтатусДО");
	СостояниеТитулаИНастройки.Вставить("КодСтатусаДО");
	СостояниеТитулаИНастройки.Вставить("СтатусТитула");
	СостояниеТитулаИНастройки.Вставить("КрайнийФайлОбмена");
	СостояниеТитулаИНастройки.Вставить("ТипЛогистика");
	СостояниеТитулаИНастройки.Вставить("НастройкаКонвертации");
	СостояниеТитулаИНастройки.Вставить("Сценарий");
	СостояниеТитулаИНастройки.Вставить("СценарийПоУмолчанию");
	
	СостояниеТитулаИНастройки.ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументТитулСсылка);
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		СостояниеТитулаИНастройки.НастройкаКонвертации = НастройкаКонвертации;
	Иначе
		// Найдем НКД если не передали
		Если ЗначениеЗаполнено(ДокументТитулСсылка.ДокументОснование) Тогда
			ТипДокументаОснования = ТипЗнч(ДокументТитулСсылка.ДокументОснование);
			Объектметаданных = Метаданные.НайтиПоТипу(ТипДокументаОснования);
			ИмяТипа1СДокумента = Объектметаданных.Имя;
		Иначе
			ИмяТипа1СДокумента = Неопределено;
		КонецЕсли;
		
		СостояниеТитулаИНастройки.НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(
			СостояниеТитулаИНастройки.ТипЛогистика, ИмяТипа1СДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СостояниеТитулаИНастройки.НастройкаКонвертации) Тогда
		Сценарии = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			СостояниеТитулаИНастройки.НастройкаКонвертации, "Сценарий, СценарийПоУмолчанию");
		
		СостояниеТитулаИНастройки.Сценарий = Сценарии.Сценарий;
		СостояниеТитулаИНастройки.СценарийПоУмолчанию = Сценарии.СценарийПоУмолчанию;
	КонецЕсли;
	
	// Статус документооборота
	ГлавныйДокумент = ОпределитьГлавныйДокументПоТитулу(ДокументТитулСсылка);
	Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда
		СостояниеТитулаИНастройки.СтатусДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ГлавныйДокумент, Истина);
		Если ЗначениеЗаполнено(СостояниеТитулаИНастройки.СтатусДО) Тогда
			СостояниеТитулаИНастройки.КодСтатусаДО = СостояниеТитулаИНастройки.СтатусДО.Код;
		КонецЕсли;
	КонецЕсли;
	
	// Статус титула
	СостояниеТитулаИНастройки.СтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументТитулСсылка, Истина);
	
	// Крайний файл обмена
	СостояниеТитулаИНастройки.КрайнийФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументТитулСсылка);
	
	Возврат СостояниеТитулаИНастройки;
	
КонецФункции

Функция ПолучитьТипыЛогистики(ДокументСсылка, УточнениеТипаЛогистика) Экспорт
	
	Перем ТипыЛогистика;
	
	Если ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда		
		ТипыЛогистика = Новый Массив;
		ТипыЛогистика.Добавить(УточнениеТипаЛогистика);			
	Иначе
		ТипыЛогистика = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьТипыЛогистикаПоДокументу1С(ДокументСсылка);
	КонецЕсли;
	
	Возврат ТипыЛогистика;

КонецФункции 

#КонецОбласти

#Область АрхивДокументоооборота

Функция ПолучитьАрхивДокументооборотаТрН_ApiЛогистика(ДокументЭТрН) Экспорт
	
	АрхивДокументооборота = Неопределено;
	
	Если ЗначениеЗаполнено(СокрЛП(ДокументЭТрН.kl_id)) Тогда
	
		МассивНашихОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
		Если Не МассивНашихОрганизации.Найти(ДокументЭТрН.Грузоотправитель) = Неопределено Тогда
			Организация = ДокументЭТрН.Грузоотправитель;
		ИначеЕсли Не МассивНашихОрганизации.Найти(ДокументЭТрН.Перевозчик) = Неопределено Тогда
			Организация = ДокументЭТрН.Перевозчик;
		ИначеЕсли Не МассивНашихОрганизации.Найти(ДокументЭТрН.Грузополучатель) = Неопределено Тогда
			Организация = ДокументЭТрН.Грузополучатель;
		ИначеЕсли  Не МассивНашихОрганизации.Найти(ДокументЭТрН.ЭкспедицияЗаказчик) = Неопределено Тогда
			Организация =   ДокументЭТрН.ЭкспедицияЗаказчик;
		Иначе
			ВызватьИсключение "В документе ЭТрН: " + ДокументЭТрН + " нет наших организаций";
		КонецЕсли;
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Организация);
		Если ПараметрыСервиса.АвторизацияВыполнена Тогда
			
			Попытка
				АрхивДокументооборота = КонтурЛогистика_API_Логистика.ПолучитьПолныйДокументооборотПоПеревозке(ПараметрыСервиса, ДокументЭТрН.kl_id);
			Исключение
				ТипТитул1 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
				КонтурЛогистика_Метрика.ОбработатьОшибкуТипаДокумента(
					"ПолучитьАрхивДокументооборотаТрН_ApiЛогистика", ТипТитул1, ИнформацияОбОшибке(), ДокументЭТрН);
				ВызватьИсключение;
			КонецПопытки;
			
		Иначе
			
			ВызватьИсключение "Нет авторизации у организации: " + Строка(Организация);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АрхивДокументооборота;
	
КонецФункции

Функция ПолучитьАрхивДокументооборотаПЛ_ApiЛогистика(Титул1) Экспорт
	
	АрхивДокументооборота = Неопределено;
	
	ИдентификаторПеревозки = СокрЛП(Титул1.kl_id);
	
	Если Не ЗначениеЗаполнено(ИдентификаторПеревозки) Тогда
		Возврат АрхивДокументооборота;
	КонецЕсли;
	
	МассивНашихОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	Если Не МассивНашихОрганизации.Найти(Титул1.ЛицоОформившееПЛ) = Неопределено Тогда
		Организация = Титул1.ЛицоОформившееПЛ;
	ИначеЕсли Не МассивНашихОрганизации.Найти(Титул1.Грузоотправитель) = Неопределено Тогда
		Организация = Титул1.Грузоотправитель;
	ИначеЕсли Не МассивНашихОрганизации.Найти(Титул1.ОрганизацияМедик) = Неопределено Тогда
		Организация = Титул1.ОрганизацияМедик;
	ИначеЕсли Не МассивНашихОрганизации.Найти(Титул1.ОрганизацияТехСостояние) = Неопределено Тогда
		Организация = Титул1.ОрганизацияТехСостояние;
	ИначеЕсли Не МассивНашихОрганизации.Найти(Титул1.ОрганизацияОдометр) = Неопределено Тогда
		Организация = Титул1.ОрганизацияОдометр;
	Иначе
		ВызватьИсключение "В документе ЭПЛ: " + Титул1 + " нет наших организаций";
	КонецЕсли;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Организация);
	Если ПараметрыСервиса.АвторизацияВыполнена Тогда
		
		Попытка
			АрхивДокументооборота = КонтурЛогистика_API_Логистика.ПолучитьПолныйДокументооборотПоПутевомуЛисту(
				ПараметрыСервиса, ИдентификаторПеревозки, Титул1.ТранспортноеСредство.ТипПечатнойФормыПутыхЛистов);
		Исключение
			ТипТитул1 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
			КонтурЛогистика_Метрика.ОбработатьОшибкуТипаДокумента(
				"ПолучитьАрхивДокументооборотаПЛ_ApiЛогистика", ТипТитул1, ИнформацияОбОшибке(), Титул1);
			ВызватьИсключение;
		КонецПопытки;
		
	Иначе
		
		ВызватьИсключение "Нет авторизации у организации: " + Строка(Организация);
		
	КонецЕсли;
	
	Возврат АрхивДокументооборота;
	
КонецФункции

Процедура СохранитьАрхивДокументооборотаВКаталог(Каталог, ГлавныйДокумент, РазбитьПоОрганизациям = Ложь) Экспорт
	
	Попытка
		
		ТипДокумента = ТипЗнч(ГлавныйДокумент);
		Если ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
			Архив = ПолучитьАрхивДокументооборотаТрН_ApiЛогистика(ГлавныйДокумент);
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
			Архив = ПолучитьАрхивДокументооборотаПЛ_ApiЛогистика(ГлавныйДокумент);
		Иначе
			Архив = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Каталог) И ЗначениеЗаполнено(Архив) Тогда
			
			// Подключаемый модуль (ПМ)
			ПараметрыПМ = Новый Структура("Архив", Архив);
			Результат = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
				"СохранитьАрхивДокументооборота", Истина, ПараметрыПМ);
			Если Результат <> Неопределено И Результат Тогда
				Возврат;
			КонецЕсли;
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗаписатьАрхивВКаталог(
				Архив, Каталог, ГлавныйДокумент, РазбитьПоОрганизациям);
			
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Ошибка при сохранение архива документаоборота в каталог.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ГлавныйДокумент, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Функция МассивЗавершенныхЭТРНЗаПериод(ДатаНачала, ДатаОкончания, Организация = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Документ
		|ИЗ
		|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних(&КонПериода, Состояние = &Состояние) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
		|		ПО КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла
		|			ПО КонтурЛогистика_ТрН_Титул1.Ссылка = КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла.Ссылка
		|		ПО КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка = КонтурЛогистика_ТрН_Титул1.ДокументЭТРН
		|ГДЕ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН МЕЖДУ &НачПериода И &КонПериода
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = &Организация
		|			ИЛИ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Перевозчик = &Организация
		|			ИЛИ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузополучатель = &Организация
		|			ИЛИ КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла.ОрганизацияДиадок = &Организация
		|			ИЛИ &БезФильтраОрганизация)";
	
	Запрос.УстановитьПараметр("НачПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Состояние", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("completed"));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезФильтраОрганизация", ?(ЗначениеЗаполнено(Организация), Ложь, Истина));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Документ");
	
КонецФункции

Функция МассивЗавершенныхЭПЛЗаПериод(ДатаНачала, ДатаОкончания, Организация = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Состояние", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-completed"));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ФильтрПоОрганизации", ЗначениеЗаполнено(Организация));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтурЛогистика_ПЛ_Титул1.Ссылка КАК Документ
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул1.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул1ДополнительныеПолучателиФайла
	|		ПО КонтурЛогистика_ПЛ_Титул1.Ссылка = КонтурЛогистика_ПЛ_Титул1ДополнительныеПолучателиФайла.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних(, Состояние = &Состояние) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
	|		ПО КонтурЛогистика_ПЛ_Титул1.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА КонтурЛогистика_ПЛ_Титул1.ДатаПЛ = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|				ТОГДА КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИНАЧЕ КонтурЛогистика_ПЛ_Титул1.ДатаПЛ МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		КОНЕЦ
	|	И (КонтурЛогистика_ПЛ_Титул1.ЛицоОформившееПЛ = &Организация
	|			ИЛИ КонтурЛогистика_ПЛ_Титул1.Грузоотправитель = &Организация
	|			ИЛИ КонтурЛогистика_ПЛ_Титул1.ОрганизацияМедик = &Организация
	|			ИЛИ КонтурЛогистика_ПЛ_Титул1.ОрганизацияТехСостояние = &Организация
	|			ИЛИ КонтурЛогистика_ПЛ_Титул1.ОрганизацияОдометр = &Организация
	|			ИЛИ КонтурЛогистика_ПЛ_Титул1ДополнительныеПолучателиФайла.ОрганизацияДиадок = &Организация
	|			ИЛИ НЕ &ФильтрПоОрганизации)
	|	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &Состояние";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");
	
КонецФункции

Функция ПолучитьПодкаталогАрхиваМесяц(ДатаДокумента) Экспорт
	
	Если ДатаДокумента = Дата(1, 1, 1) Тогда
		Возврат "";
	Иначе
		Возврат Формат(ДатаДокумента, "ДФ='\yyyy\ММ MMММ'");
	КонецЕсли;
	
КонецФункции

Функция ИмяАрхива(ПрефиксИмениФайла, НомерДокумента, ДатаДокумента) Экспорт
	
	Возврат ПрефиксИмениФайла + " " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy") + ".zip";
	
КонецФункции

Функция ПодкаталогОрганизации(ГлавныйДокумент, Роль) Экспорт
	
	Попытка
		Наш = ГлавныйДокумент[Роль].Наш;
	Исключение
		Наш = Ложь;
	КонецПопытки;
	
	Если Не Наш Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ИНН = ГлавныйДокумент[Роль].ИНН;
	Исключение
		ИНН = "";
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Возврат "\" + Строка(ИНН);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область КопированиеТитула

Процедура ДобавитьНомерКопииКНомеруДокумента(НомерДокумента, ТипЛогистика) Экспорт
	
	Попытка
	
		ЧастиНомера = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(НомерДокумента, " ", Ложь);
		Колво = ЧастиНомера.Количество();
		
		Если Колво > 1 
			И Лев(ЧастиНомера[Колво - 1], 1) = "(" 
			И Прав(ЧастиНомера[Колво - 1], 1) = ")" 
			И НомерКопииСодержитТолькоЦифры(ЧастиНомера[Колво - 1]) Тогда
			
			ЧастиНомера.Удалить(Колво - 1);
			НомерПоследнейКопии = НомерПоследнейКопии(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ЧастиНомера, " "), ТипЛогистика);
			
		Иначе
			
			НомерПоследнейКопии = НомерПоследнейКопии(НомерДокумента, ТипЛогистика);
			
		КонецЕсли;
		
		ЧастиНомера = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(НомерПоследнейКопии, " ", Ложь);
		
		Колво = ЧастиНомера.Количество();
		Если Колво = 1 Тогда
			НомерДокумента = НомерПоследнейКопии + " (1)";
		ИначеЕсли Колво > 1 Тогда
			
			НомерКопии = ЧастиНомера[Колво - 1];
			НомерКопии = СтрЗаменить(НомерКопии, "(", "");
			НомерКопии = СтрЗаменить(НомерКопии, ")", "");
					
			НовыйНомерКопии = Строка(Число(НомерКопии) + 1);
			ЧастиНомера[Колво - 1] = "(" + НовыйНомерКопии + ")";
			НомерДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ЧастиНомера, " ");
					
		КонецЕсли;
	
	Исключение
		
		НомерДокумента = НомерДокумента + " (1)";
		
	КонецПопытки
		
КонецПроцедуры

Функция НомерПоследнейКопии(НомерДокумента, ТипЛогистика)

	Запрос = Новый Запрос;
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
			|ГДЕ
			|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
			|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
			|ГДЕ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ПЛ_Титул1_5_02 КАК КонтурЛогистика_ПЛ_Титул1
			|ГДЕ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ЗЗ_Титул1.НомЗак КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
			|ГДЕ
			|	КонтурЛогистика_ЗЗ_Титул1.НомЗак ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ЗЗ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ЗЗ_Титул1.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ЗЗ_Титул1.НомЗак УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ЭкспедиторскаяРасписка.НомерДок КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ЭкспедиторскаяРасписка КАК КонтурЛогистика_ЭкспедиторскаяРасписка
			|ГДЕ
			|	КонтурЛогистика_ЭкспедиторскаяРасписка.НомерДок ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ЭкспедиторскаяРасписка.ПометкаУдаления
			|	И КонтурЛогистика_ЭкспедиторскаяРасписка.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ЭкспедиторскаяРасписка.НомерДок УБЫВ";
	Иначе
		Возврат НомерДокумента;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента + "%");
	Запрос.УстановитьПараметр("НачДата", НачалоГода(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонДата", КонецГода(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЧастиНомера = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ВыборкаДетальныеЗаписи.Номер, " ", Ложь);
		Колво = ЧастиНомера.Количество();
		
		Если Колво > 1 
			И Лев(ЧастиНомера[Колво - 1], 1) = "(" 
			И Прав(ЧастиНомера[Колво - 1], 1) = ")" 
			И НомерКопииСодержитТолькоЦифры(ЧастиНомера[Колво - 1]) Тогда			
								
			ЧастиНомера.Удалить(Колво - 1);
			Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ЧастиНомера, " ") = НомерДокумента Тогда
				Возврат ВыборкаДетальныеЗаписи.Номер;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НомерДокумента;
	
КонецФункции

Функция НомерКопииСодержитТолькоЦифры(НомерКопии)
	
	НомерКопииБезСкобок = Сред(НомерКопии, 2, СтрДлина(НомерКопии) - 2);
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаСодержитТолькоЦифры(НомерКопииБезСкобок);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьСтатусФайлыСформированы(МассивДокументов)
	
	ДокументыНаОбработку = Справочники.КонтурЛогистика_ФайлыОбмена.МассивДокументовСКрайнимиПолученнымиНеподписаннымиФайлами(
		МассивДокументов);
	
	ДокументыНаОбработкуБезЭР = Новый Массив;
	Для Каждого Полученный Из ДокументыНаОбработку Цикл
		Если ТипЗнч(Полученный) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
			Продолжить;
		КонецЕсли;
		ДокументыНаОбработкуБезЭР.Добавить(Полученный);
	КонецЦикла;
	
	УказатьПользователя = Истина;

	Для Каждого Полученный Из ДокументыНаОбработкуБезЭР Цикл
		
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
			Полученный, 
			Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена,
			УказатьПользователя);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыЗапросаПодготовкиКПодписи(BoxID, ПараметрыСервиса, МассивДокументов)
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("BoxID", 		   BoxID);
	Параметры.Вставить("ПараметрыСервиса", ПараметрыСервиса);
	Параметры.Вставить("МассивДокументов", МассивДокументов);
	
	Возврат Параметры;
	
КонецФункции

Функция МассивДокументовДиадокИзФайлов(МассивФайлов)
	
	МассивДокументов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.MessageID КАК MessageID,
	|	КонтурЛогистика_ФайлыОбмена.DocumentId КАК DocumentId,
	|	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка В(&МассивФайлов)";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокументИд = Новый Структура;
		ДокументИд.Вставить("MessageID",  Выборка.MessageID);
		ДокументИд.Вставить("EntityId", Выборка.DocumentId);
		
		Документ = Новый Структура;
		Документ.Вставить("DocumentId", ДокументИд);
		Документ.Вставить("Signer");
		
		Если ТипЗнч(Выборка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
			
			РезультатВыбораОрганизацииПодписанта = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьОрганизациюПодписантаИДатуПодписи(
				Выборка.ГлавныйДокумент);
			ДатаГлавного = РезультатВыбораОрганизацииПодписанта.ДатаГлавного;
			ОрганизацияГлавного = РезультатВыбораОрганизацииПодписанта.ОрганизацияГлавного;
			
			РеквизитыГлавного = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
				Выборка.ГлавныйДокумент, "ПользовательПодписант, ПараметрНастроекПодписания");
			ПодписантСтруктура = КонтурЛогистика_ОбработкаДокументовСервер.ВыбратьПодписанта(
				ОрганизацияГлавного, РеквизитыГлавного.ПользовательПодписант, ДатаГлавного,
				Выборка.ГлавныйДокумент, РеквизитыГлавного.ПараметрНастроекПодписания);
			
			ДеталиПодписанта = Новый Структура;
			ДеталиПодписанта.Вставить("Surname", ПодписантСтруктура.Фамилия);
			ДеталиПодписанта.Вставить("FirstName", ПодписантСтруктура.Имя);
			ДеталиПодписанта.Вставить("Patronymic", ПодписантСтруктура.Отчество);
			ДеталиПодписанта.Вставить("Inn", "");
			
			Подписант = Новый Структура;
			Подписант.Вставить("SignerDetails", ДеталиПодписанта);
			
			Документ.Вставить("Signer", Подписант);
			
		КонецЕсли;
		
		МассивДокументов.Добавить(Документ);
		
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ФайлОбменаПоMessageIdEntityId(МассивФайлов, MessageId, EntityId)
	
	ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.ПустаяСсылка();
	
	Для Каждого Файл Из МассивФайлов Цикл
		
		Если Файл.MessageID = MessageId
			И Файл.DocumentId = EntityId Тогда
			
			ФайлОбмена = Файл;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ФайлОбмена;
	
КонецФункции

Процедура ПоказатьСообщение(Текст, Ссылка = Неопределено)
	
	ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
	ПараметрыСообщения.Текст 	  = Текст;
	ПараметрыСообщения.КлючДанных = Ссылка;
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);	
	
КонецПроцедуры

Процедура УведомитьОбОтказах(МассивДокументовЛогистика, РазрешенныеДокументы)
	
	Отказы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		МассивДокументовЛогистика,
		РазрешенныеДокументы);
		
	Если Отказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СообщениеНепропущенных = НСтр("ru = 'Часть документов не будет отправлена. Это связано с их состоянием документооборота "
		+ "и настройкой сценария подписания.'");
	ПоказатьСообщение(СообщениеНепропущенных);
	
	Для Каждого ДокументСОтказомВОперации Из Отказы Цикл
		ПоказатьСообщение(ДокументСОтказомВОперации, ДокументСОтказомВОперации);
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСостояниеДОПоКоду(КодАнгл, ОтвСторона = Неопределено) Экспорт
	Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду(КодАнгл, ОтвСторона);
КонецФункции	

Процедура ЗаписатьПричинуОтказаВТитул(ПричинаОтказа, ТитулСсылка) Экспорт

	ТитулОбъект = ТитулСсылка.ПолучитьОбъект();
	ТитулОбъект.ЕстьОтказВПодписи = Истина;
	ТитулОбъект.ПричинаОтказаВПодписи = ПричинаОтказа;
	ТитулОбъект.Записать();
	
КонецПроцедуры

// Проверяет состояние созданного титула исзодя из состояния файла обмена 
//
// Параметры:
//  ДопСведения	 - Структура - Структура, с ключом "ФайлОснование"
// 
// Возвращаемое значение:
//  Результат - Булево
//
Функция ЭтоВходящийДокумент(Знач ДопСведения) Экспорт 
	
	Результат = Ложь;
	
	Если ТипЗнч(ДопСведения) = Тип("Структура") 
		И ДопСведения.Свойство("ФайлОснование") Тогда 
		
		СостояниеФайла = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ДопСведения.ФайлОснование, "Состояние");
		
		Результат = СостояниеФайла = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция НомерДатаИсправленияПоИмениФайла(ИмяФайла) Экспорт
	
	ДанныеИсправления = Новый Структура("НомИспр, ДатаИспр", 0, Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент.НомИспр, 0) КАК НомИспр,
	|	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент.ДатаИспр КАК ДатаИспр
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.ИмяФайла = &ИмяФайла";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ДанныеИсправления, Выборка);
		КонецЕсли;
	Исключение
		// Ничего не делаем
	КонецПопытки;
	
	Возврат ДанныеИсправления;
	
КонецФункции

Процедура РасчетОсобенностейДокументооборота(ТитулСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипТитула = ТипЗнч(ТитулСсылка);
	
	Если ТипТитула = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		
		// Обрабатываем только, когда перевозчик наш, текущий титул это исправление
		// Только на стороне перевозчика
		ДокументЭТРН = ТитулСсылка.ДокументЭТРН;
		Если Не ДокументЭТРН.Перевозчик.Наш Тогда
			Возврат;
		КонецЕсли;
		
		Титул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2, ДокументЭТРН);
		
		Если ТитулСсылка.НомИспр > Титул2.НомИспрГО Тогда
			Особенность = Перечисления.КонтурЛогистика_ТипыОсобенностейДокументооборота.ОбработатьИсправлениеТитула1;
			РегистрыСведений.КонтурЛогистика_ОсобенностиДокументооборота.УстановитьОсобенность(ДокументЭТРН, Особенность);
		КонецЕсли;
		
	ИначеЕсли ТипТитула = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда
		
		// Обрабатываем только, когда перевозчик наш, текущий титул это исправление
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТитулСсылка", ТитулСсылка);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ТрН_Титул2.Ссылка КАК Ссылка,
		|	КонтурЛогистика_ТрН_Титул2.ИдФайлИнфГО КАК ИдФайлИнф,
		|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН КАК ДокументЭТРН,
		|	КонтурЛогистика_ТрН_Титул2.НомИспрГО КАК НомИспр
		|ИЗ
		|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
		|ГДЕ
		|	КонтурЛогистика_ТрН_Титул2.Ссылка = &ТитулСсылка
		|	И КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.Перевозчик.Наш
		|	И КонтурЛогистика_ТрН_Титул2.НомИспрГО <> 0";
		
		Результат = Запрос.Выполнить();
		
		Если Результат.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		Если Не Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;
		
		НомерДатаИсправленияТ1 = КонтурЛогистика_ОбработкаДокументовСервер.НомерДатаИсправленияПоИмениФайла(Выборка.ИдФайлИнф);
		
		Если Выборка.НомИспр >= НомерДатаИсправленияТ1.НомИспр Тогда
			Особенность = Перечисления.КонтурЛогистика_ТипыОсобенностейДокументооборота.ПустаяСсылка();
			РегистрыСведений.КонтурЛогистика_ОсобенностиДокументооборота.УстановитьОсобенность(Выборка.ДокументЭТРН, Особенность);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоТитул12Исправления(ТитулСсылка)
	
	ТипТитула = ТипЗнч(ТитулСсылка);
	
	Если ТипТитула = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		
		Если ТитулСсылка.НомИспр <> 0 
			И Не ТитулСсылка.ПометкаУдаления Тогда
			
			Возврат Истина;
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	ИначеЕсли ТипТитула = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда 
		
		Если ТитулСсылка.НомИспрГО <> 0 
			И Не ТитулСсылка.ПометкаУдаления Тогда
			
			Возврат Истина;
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Функция МожноВвестиТитулы(ГлавныйДокумент) Экспорт
	
	Результат = Новый Структура;
	
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ГлавныйДокумент).Код;
	
	ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
	ИспользуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
	ИспользуетсяПутевойЛист = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	
	// Заказ (заявка)
	// Титул 2
	Если ИспользуетсяЗаказЗаявка И ТекущийСтатусДокументооборота = "zz-wait-carrier" Тогда
		
		Результат.Вставить("ЗЗ_Титул2", "Ввести согласование заявки (Т2)");
		
	КонецЕсли;
	
	// ЭТрН
	Если ИспользуетсяТРН Тогда
		
		// Титул 2
		Если ТекущийСтатусДокументооборота = "r-wait-carrier-sign" Тогда
			
			Результат.Вставить("ТрН_Титул2", "Ввести погрузку (Т2)");
			
		// Титул 3
		ИначеЕсли ТекущийСтатусДокументооборота = "on-the-way"
			Или ТекущийСтатусДокументооборота = "pd-on-the-way" Тогда
			
			Результат.Вставить("ТрН_Титул3", "Ввести приемку (Т3)");
			
		// Титул 4
		ИначеЕсли ТекущийСтатусДокументооборота = "d-wait-carrier-sign"
			Или ТекущийСтатусДокументооборота = "pd-wait-carrier-sign" Тогда
			
			Результат.Вставить("ТрН_Титул4", "Ввести разгрузку (Т4)");
			
		// Титул 5
		ИначеЕсли ТекущийСтатусДокументооборота = "completed"
			Или ТекущийСтатусДокументооборота = "pd-wait-carrier-readdress-sign" Тогда
			
			Результат.Вставить("ТрН_Титул5", "Ввести стоимость (Т5)");
			
		// Титул 6
		ИначеЕсли ТекущийСтатусДокументооборота = "c-wait-consignor-sign" Тогда
			
			Результат.Вставить("ТрН_Титул6", "Ввести согласование (Т6)");
			
		КонецЕсли;
		
		// Титул 7
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7;
		СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4;
		Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
			И МожноВвестиТитул(ГлавныйДокумент, ТипЛогистика, СпецСценарий) Тогда
			
			Результат.Вставить("ТрН_Титул7", "Ввести переадресацию (Т7)");
			
		КонецЕсли;
		
		// Титул 8
		Если ТекущийСтатусДокументооборота = "on-the-way"
			Или ТекущийСтатусДокументооборота = "pd-on-the-way"
			Или ТекущийСтатусДокументооборота = "completed" Тогда
			
			Результат.Вставить("ТрН_Титул8", "Ввести смену водителя (Т8)");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Путевой лист
	Если ИспользуетсяПутевойЛист Тогда
			
		// Титул 2
		Если ТекущийСтатусДокументооборота = "pl-wait-checkupBefore"
			Или ТекущийСтатусДокументооборота = "pl-wait-checkupBefore2ndDriver" Тогда
			
			Результат.Вставить("ПЛ_Титул2", "Ввести медосмотр (Т2)");
			
		// Титул 3
		ИначеЕсли ТекущийСтатусДокументооборота = "pl-wait-techInspection" Тогда
			
			Результат.Вставить("ПЛ_Титул3", "Ввести тех. контроль (Т3)");
			
		// Титул 2 и 3
		ИначеЕсли ТекущийСтатусДокументооборота = "pl-wait-techOrChekupBefore" Тогда
			
			Результат.Вставить("ПЛ_Титул2", "Ввести медосмотр (Т2)");
			Результат.Вставить("ПЛ_Титул3", "Ввести тех. контроль (Т3)");
			
		// Титул 4
		ИначеЕсли ТекущийСтатусДокументооборота = "pl-wait-odometerBefore" Тогда
			
			Результат.Вставить("ПЛ_Титул4", "Ввести выезд ТС (Т4)");
			
		// Титул 5
		ИначеЕсли ТекущийСтатусДокументооборота = "pl-on-the-way" Тогда
			
			Результат.Вставить("ПЛ_Титул5", "Ввести заезд ТС (Т5)");
			
		// Титул 6
		ИначеЕсли ТекущийСтатусДокументооборота = "pl-wait-checkupAfter" Тогда
			
			Результат.Вставить("ПЛ_Титул6", "Ввести медосмотр (Т6)");
			
		КонецЕсли;
		
		// Титул 1 смена водителя
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
		СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя;
		Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			И МожноВвестиТитул(ГлавныйДокумент, ТипЛогистика, СпецСценарий) Тогда
			
			Результат.Вставить("ПЛ_Титул1", "Ввести смену водитея (Т1)");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МожноВвестиТитул(ГлавныйДокумент, ТипЛогистика, СпецСценарий)
	
	ТипДокументаКонфигурации = "Предыдущий титул";
	НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ТипЛогистика);
	РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий, НастройкаКонвертации);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
	Запрос.Текст = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
	
	Для Каждого ПараметрЗапроса Из РезультатаФормированияЗапроса.СтруктураПараметровЗапроса Цикл
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;
	
	// Определяем дополнительные параметры запроса в зависимости от типа титула и специального сценария
	ПараметрыСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПараметрыСпискаПоТипуЛогистики(ТипЛогистика, СпецСценарий);
	Для Каждого ТекущийПараметр Из ПараметрыСписка Цикл
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
	КонецЦикла;
	
	// Заменим строку с условием по дате НачалоПериодаПоследующийТитул на условие по главному документу
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
		
		СтрокаПоиска = "КонтурЛогистика_ТрН_Титул7.Дата МЕЖДУ &НачалоПериодаПоследующийТитул И &ОкончаниеПериодаПоследующийТитул";
		Если Найти(Запрос.Текст, СтрокаПоиска) <> 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, СтрокаПоиска, "КонтурЛогистика_ТрН_Титул7.ДокументЭТРН = &ГлавныйДокумент");
		КонецЕсли;
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		
		СтрокаПоиска = "КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &НачалоПериодаПоследующийТитул И &ОкончаниеПериодаПоследующийТитул";
		Если Найти(Запрос.Текст, СтрокаПоиска) <> 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, СтрокаПоиска, "КонтурЛогистика_ПЛ_Титул1.Ссылка = &ГлавныйДокумент");
		КонецЕсли;
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		СтрокаПоиска = "КонтурЛогистика_ПЛ_Титул1_5_02.Дата МЕЖДУ &НачалоПериодаПоследующийТитул И &ОкончаниеПериодаПоследующийТитул";
		Если Найти(Запрос.Текст, СтрокаПоиска) <> 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, СтрокаПоиска, "КонтурЛогистика_ПЛ_Титул1_5_02.Ссылка = &ГлавныйДокумент");
		КонецЕсли;
		
	КонецЕсли;
	
	СекундВЧасе = 60 * 60;
	ПятьСутокВСекундах = СекундВЧасе * 24 * 5;
	СмещениеОкончанияПериода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СмещениеОкончанияПериодаСпискаЗадач") * СекундВЧасе;
	ОкончаниеПериода = КонецДня(ТекущаяДатаСеанса()) + СмещениеОкончанияПериода;
	
	Запрос.УстановитьПараметр("НачалоПериода", ТекущаяДатаСеанса() - ПятьСутокВСекундах);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ТребуемоеДействие <> Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция НужноСворачиватьТовары(Знач ТЗ_ТоварыВременная, Знач Партнер, Знач СворачиватьТовары) Экспорт
	
	КолУчТоваров = ТЗ_ТоварыВременная.НайтиСтроки(Новый Структура("Учитывать", Истина)).Количество();
	
	Если КолУчТоваров <= 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Партнер) Тогда
		Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(Партнер, "СворачиватьТовары");
	Иначе
		Возврат СворачиватьТовары;
	КонецЕсли;
	
КонецФункции

#КонецОбласти