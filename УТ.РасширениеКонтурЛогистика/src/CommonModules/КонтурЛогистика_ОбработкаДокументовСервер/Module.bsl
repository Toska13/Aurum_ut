	Возврат КС.XDTO_Вычислить(СодИнфПрвXDTO, "ЗамПрв" + ПостФикс) <> Неопределено;
	                                           
КонецФункции

Функция ЕстьОтметкиПеревозчикаXDTO(ОтметПрвXDTO) Экспорт 
		
	Возврат Не ОтметПрвXDTO = Неопределено;
	                                           
КонецФункции	

Процедура ЗаполнитьЗамечанияПеревозчикаXDTO(СодИнфПрвXDTO, НайденныйТитулОбъект, ЭтоПогрузка = Истина) Экспорт 
	
	КС = КонтурЛогистика_КонструкторыXDTO;

	СтруктураЗамечаний = ЗамечанияВодителяXDTO(СодИнфПрвXDTO, ЭтоПогрузка);
	ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, СтруктураЗамечаний);	
	
КонецПроцедуры

Процедура ЗаполнитьОтметкиПеревозчикаXDTO(ОтметПрвXDTO, НайденныйТитулОбъект) Экспорт 
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если Не ОтметПрвXDTO = Неопределено Тогда
		
		Если ТипЗнч(ОтметПрвXDTO) = Тип("ОбъектXDTO") Тогда
			
			ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, ОтметПрвXDTO);
			
		Иначе
			
			Для Каждого Отметка Из ОтметПрвXDTO Цикл
				
				ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, Отметка);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, Отметка, ОтметкаВФорматеXDTO = Истина)
	
	ДатаИВремяОтметки = Неопределено;
	ОписаниеОбстоятельств = Неопределено;
	
	Если ОтметкаВФорматеXDTO Тогда
		КС = КонтурЛогистика_КонструкторыXDTO;
		СвойствоДатВрОтмет = Отметка.Свойства().Получить("ДатВрОтмет");
		
		Если СвойствоДатВрОтмет <> Неопределено Тогда
			ДатаИВремяОтметки = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(Отметка.ДатВрОтмет);
		КонецЕсли;
		
		ОписаниеОбстоятельств = Отметка.ОбстОтмет;
	Иначе
		ДатаИВремяОтметки = Отметка.ДатаИВремяОтметки;
		ОписаниеОбстоятельств = Отметка.ОписаниеОбстоятельств;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаИВремяОтметки) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьТЧОтметкиИнфПол = Ложь;
	
	Если ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул2")
		Или ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул4") Тогда
		
		ИмяТЧ = "ОтметкиПеревозчика";
		ЕстьТЧОтметкиИнфПол = Истина;
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1") Тогда
		
		ИмяТЧ = "ОтметкиГрузоотправителя";
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул4") Тогда
		
		ИмяТЧ = "ОтметкиГрузополучателя";
		ЕстьТЧОтметкиИнфПол = Истина;
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул7") Тогда
		
		ИмяТЧ = "ОтметкиПА";
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул8") Тогда
		
		ИмяТЧ = "ОтметЗам";
		
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ДатаИВремяОтметки, ОписаниеОбстоятельств", ДатаИВремяОтметки, ОписаниеОбстоятельств);
	НайденныеОтметки = НайденныйТитулОбъект[ИмяТЧ].НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеОтметки.Количество() <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Добавляем отметку
	НоваяОтметка = НайденныйТитулОбъект[ИмяТЧ].Добавить();
	
	Если Не ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул7") Тогда
		НоваяОтметка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	НоваяОтметка.ДатаИВремяОтметки = ДатаИВремяОтметки;
	НоваяОтметка.ОписаниеОбстоятельств = ОписаниеОбстоятельств;
	
	Если ЕстьТЧОтметкиИнфПол И ОтметкаВФорматеXDTO Тогда
		КС.ЗаполнитьИнфПолИзXDTO(Отметка, НайденныйТитулОбъект, "ОтметкиИнфПол", НоваяОтметка.ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКомментарииВодителяВЭТрН(ДокументЭТРН, ЗамечанияВодителя, ТипТитула)
	
	Если ДокументЭТРН = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	РеквизитЭТрН = ?(ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2"), 
						"КомментарииВодителяПриПогрузке", 
						"КомментарииВодителяПриВыгрузке");		
	
	ВЭТрНЕстьКомментарииВодителя 	= ЗначениеЗаполнено(ДокументЭТРН[РеквизитЭТрН]);
	ЗамечанияВодителяОдинаковы 		= ВЭТрНЕстьКомментарииВодителя И ДокументЭТРН[РеквизитЭТрН] = ЗамечанияВодителя;
	
	Если Не ВЭТрНЕстьКомментарииВодителя Или Не ЗамечанияВодителяОдинаковы Тогда 
		ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
		Если ДокументЭТРНОбъект <> Неопределено Тогда // мог быть объект не найден в ДокументЭТРН
			ДокументЭТРНОбъект[РеквизитЭТрН] = ЗамечанияВодителя;
			ДокументЭТРНОбъект.Записать();		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Функция НайтиСоздатьТитулПоЭТРН(Знач ФайлСсылка, ТипТитула, Перезаполнить = Ложь)
	
	ПредыдущийТипВЦепочке = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредыдущийПоЦепочкеТипЛогистика(ТипТитула);
	ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ПредыдущийТипВЦепочке , ФайлСсылка.ГлавныйДокумент);
	
	Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		И ЗначениеЗаполнено(ПредыдущийТитул)
		И ПредыдущийТитул.ЭтоПриемВозврата Тогда
		
		НайденныйИлиСозданныйТитул = НайтиПриемкуТрнТ4Возвратную(ФайлСсылка.ГлавныйДокумент);
		
	Иначе
	
		НайденныйИлиСозданныйТитул = НайтиТитул(ТипТитула, ФайлСсылка.ГлавныйДокумент);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйИлиСозданныйТитул) И Не Перезаполнить Тогда
		Возврат НайденныйИлиСозданныйТитул
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйИлиСозданныйТитул) Тогда
		ТитулОбъект = НайденныйИлиСозданныйТитул.ПолучитьОбъект();
	Иначе
		ТитулОбъект = Документы[КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипТитула)].СоздатьДокумент();
		ТитулОбъект.Дата = ТекущаяДатаСеанса();
		ТитулОбъект.УстановитьВремя();
		ТитулОбъект.ДокументЭТРН = ФайлСсылка.ГлавныйДокумент;
	КонецЕсли;
	
	ТитулОбъект.Заполнить(Новый Структура("ПредыдущийТитул,ТипЛогистика", ПредыдущийТитул, ТипТитула));
	
	ТитулОбъект.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	
	ТитулОбъект.Записать();
	
	НайденныйИлиСозданныйТитул = ТитулОбъект.Ссылка;
	
	Возврат НайденныйИлиСозданныйТитул;

КонецФункции

Процедура ОбработкаПолученияПредставленияДокументаТитулаТрН(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	
	НомерТрН = "";
	ДатаТрН = "";
	ТестовыйДокумент = Ложь;
	
	Если ЗначениеЗаполнено(Данные.Ссылка) И ЗначениеЗаполнено(Данные.Ссылка.ДокументЭТРН) Тогда
		РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			Данные.Ссылка.ДокументЭТРН, "НомерТрН, ДатаТрН, ТестовыйДокумент");
		
		НомерТрН = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(РеквизитыДокумента.НомерТрН);
		ДатаТрН = Формат(РеквизитыДокумента.ДатаТрН, "ДФ=dd.MM.yy");
		ТестовыйДокумент = РеквизитыДокумента.ТестовыйДокумент;
	КонецЕсли;
	
	Заголовок = "";
	Если Номер = "1" Тогда 
		Заголовок = "Оформление грузоотправителем";
	ИначеЕсли Номер = "2" Тогда 
		Заголовок = "Погрузка перевозчиком";
	ИначеЕсли Номер = "3" Тогда 
		Заголовок = "Приемка, грузополучателем";
	ИначеЕсли Номер = "4" Тогда 
		Заголовок = "Разгрузка перевозчиком";
	ИначеЕсли Номер = "5" Тогда 
		Заголовок = "Выставление стоимости перевозчиком";
	ИначеЕсли Номер = "6" Тогда 
		Заголовок = "Согласование стоимости грузоотправителем";
	ИначеЕсли Номер = "7" Тогда 
		Заголовок = "Переадресация перевозчиком";
	ИначеЕсли Номер = "8" Тогда 
		Заголовок = "Замена ТС/водителя перевозчиком";
	КонецЕсли;
	
	Представление = "ЭТрН №" + НомерТрН + " от " + ДатаТрН + " " + Заголовок + " (Титул " + Номер + ")";
	
	Если ТестовыйДокумент = Истина Тогда
		Представление = Представление + " - Тестовый";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставленияДокументаТитулаЗН(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	НомерЗН = "";
	ДатаЗН = "";
	Если ЗначениеЗаполнено(Данные.Ссылка) И ЗначениеЗаполнено(Данные.Ссылка.ДокументЗН) Тогда 
		НомерЗН = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(Данные.Ссылка.ДокументЗН.НомерЗН);
		ДатаЗН = Формат(Данные.Ссылка.ДокументЗН.ДатаЗН,"ДФ=dd.MM.yy");
