				УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфВозвр.УИД_ПЛ");
			Иначе
				УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфЗаезд.УИД_ПЛ");
			КонецЕсли;
		ИначеЕсли КНД = "1110385" Тогда 
			Если Формат = "5.02" Тогда
				УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфПМО.УИД_ПЛ");
			Иначе
