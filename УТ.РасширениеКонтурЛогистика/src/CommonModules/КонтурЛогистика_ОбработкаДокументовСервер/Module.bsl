КонецПроцедуры

Процедура ОбработкаПолученияПредставленияДокументаТитулаЗЗ(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	
	НомЗак = "";
	ДатаЗак = "";
	ТестовыйДокумент = Ложь;
	
	Если ЗначениеЗаполнено(Данные.Ссылка) Тогда
		РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			Данные.Ссылка, "НомЗак, ДатаЗак, ТестовыйДокумент");
		
		НомЗак = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(РеквизитыДокумента.НомЗак);
		ДатаЗак = Формат(РеквизитыДокумента.ДатаЗак, "ДФ=dd.MM.yy");
		ТестовыйДокумент = РеквизитыДокумента.ТестовыйДокумент;
	КонецЕсли;
	
	Представление = "Заказ (заявка) №" + НомЗак + " от " + ДатаЗак + " Титул " + Номер;
	
	Если ТестовыйДокумент = Истина Тогда
		Представление = Представление + " - Тестовый";
	КонецЕсли;
	
КонецПроцедуры

