	КонецЕсли;
	
КонецФункции

Функция ЭтоТитулЗЗ(ДокТитулСсылка) Экспорт
	
	ТипЗнчОбъекта = ТипЗнч(ДокТитулСсылка);
	
	Если ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2")
		Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЭтоТитулДФ(ДокТитулСсылка) Экспорт
	
	ТипЗнчОбъекта = ТипЗнч(ДокТитулСсылка);
	
	Если ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул2")
		Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЭтоТитулЭР(ДокТитулСсылка) Экспорт
	
	ТипЗнчОбъекта = ТипЗнч(ДокТитулСсылка);
	
	Если ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЭтоТитулПЛ(ДокТитулСсылка) Экспорт
	
	ТипЗнчОбъекта = ТипЗнч(ДокТитулСсылка);
	
	Если ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")		
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2_5_02")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4_5_02")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5_5_02")
		Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЭтоТитулПЛ_5_02(ДокТитулСсылка) Экспорт
	
	ТипЗнчОбъекта = ТипЗнч(ДокТитулСсылка);
	
	Если ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2_5_02")
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02") 
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4_5_02") 
		Или ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5_5_02") Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьГлавныйДокументПоТитулу(ДокТитулСсылка) Экспорт
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ДокТитулСсылка) Тогда
		
		ГлавныйДокумент = ДокТитулСсылка.ДокументЭТрН;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗН(ДокТитулСсылка) Тогда
		
		ГлавныйДокумент = ДокТитулСсылка.ДокументЗН;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулСВ(ДокТитулСсылка) Тогда
		
		ГлавныйДокумент = ДокТитулСсылка.ДокументСВ;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЭР(ДокТитулСсылка) Тогда
		
		ГлавныйДокумент = ДокТитулСсылка;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(ДокТитулСсылка)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ДокТитулСсылка) Тогда
		
		Если ТипЗнч(ДокТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
			Или ТипЗнч(ДокТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(ДокТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
			ГлавныйДокумент = ДокТитулСсылка;
		Иначе
			ГлавныйДокумент = ДокТитулСсылка.Титул1;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

// Процедура - Валидатор проверить подписанта
//
// Параметры:
//  Объект			  - ДокументСсылка, ДокументОбъект - проверяемый документ может передаваться как ссылкой так и объектом
//  ТаблицаОшибок	  - ТаблицаЗначений - в талицу положим найденные ошибки, можно передать таблицу с уже найденными ошибками, см. КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок()
//  ТребуемоеДействие - Перечисления.КонтурЛогистика_ТребуемыеДействия
//  ПараметрыФормированияФайлов - Структура - Значения реквизитов заполнения файла обмена
//
Процедура Валидатор_ПроверитьПодписанта(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок, ТребуемоеДействие = Неопределено,
	ПараметрыФормированияФайлов = Неопределено) Экспорт
	
    РезультатВыбораОрганизацииПодписанта = ОпределитьОрганизациюПодписантаИДатуПодписи(ДокументОбъектИлиСсылка);
	ДатаГлавного = РезультатВыбораОрганизацииПодписанта.ДатаГлавного;
    ОрганизацияГлавного = РезультатВыбораОрганизацииПодписанта.ОрганизацияГлавного;
	ПодписантСтруктура = Неопределено;
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	
	Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ДокументОснование) Тогда
		НастрокаКонвертацииДокумента = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертацииРасширенная(
			ТипТитула, ДокументОбъектИлиСсылка.ДокументОснование);
	Иначе
		НастрокаКонвертацииДокумента = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертацииРасширенная(
			ТипТитула, "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастрокаКонвертацииДокумента) Тогда
		НастрокаКонвертацииДокумента = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипТитула);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастрокаКонвертацииДокумента) Тогда
		
		// Проверка что подпись (если требуется) будет успешной
		Если НастрокаКонвертацииДокумента.Сценарий_ОтправлятьПодписанный 
			И НЕ НастрокаКонвертацииДокумента.Сценарий_ОтправлятьНеподписанный Тогда
			
			Категория = КатегорияОшибка;
			Если ЗначениеЗаполнено(ОрганизацияГлавного) Тогда 
				ПодписантСтруктура = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
					ОрганизацияГлавного, ДокументОбъектИлиСсылка.ПользовательПодписант, ДатаГлавного,
					ДокументОбъектИлиСсылка, ДокументОбъектИлиСсылка.ПараметрНастроекПодписания);
				Валидатор_ПроверитьПодписантаПроверитьУсловия(Категория, ТаблицаОшибок, ПодписантСтруктура, ТипТитула, ТребуемоеДействие, ДокументОбъектИлиСсылка);
			КонецЕсли;
			
		ИначеЕсли НастрокаКонвертацииДокумента.Сценарий_ОтправлятьНеподписанный И НЕ НастрокаКонвертацииДокумента.Сценарий_ОтправлятьПодписанный Тогда
			
			// все ок
			
		ИначеЕсли НастрокаКонвертацииДокумента.Сценарий_ОтправлятьНеподписанный И НастрокаКонвертацииДокумента.Сценарий_ОтправлятьПодписанный Тогда
			
			Категория = КатегорияПредупреждение;
			
			Если ЗначениеЗаполнено(ОрганизацияГлавного) Тогда 
				ПодписантСтруктура = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
					ОрганизацияГлавного, ДокументОбъектИлиСсылка.ПользовательПодписант, ДатаГлавного,
					ДокументОбъектИлиСсылка, ДокументОбъектИлиСсылка.ПараметрНастроекПодписания);
				Валидатор_ПроверитьПодписантаПроверитьУсловия(Категория, ТаблицаОшибок, ПодписантСтруктура, ТипТитула, ТребуемоеДействие, ДокументОбъектИлиСсылка);
			КонецЕсли;
			
		Иначе // не отмечен ни один из способов отправки
			
			ТекстОшибки = "Не настроен сценарий отправки (подписанны/неподписанный) в регистре ""Настройки подписания (Контур.Логистика)""";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"НастрокаКонвертации", КатегорияПредупреждение, ТекстОшибки, "Настроить");
			
		КонецЕсли;
				
		// Проверка обязательного документа учетной системы
		Если НастрокаКонвертацииДокумента.ОбязательныйДокументУчетнойСистемыДляОтправки = Истина
			И Не ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ДокументОснование) Тогда 
			
			ТекстОшибки = "Не выбран обязательный документ основание (проверка настройки конвертации)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ДокументОснование", КатегорияОшибка, ТекстОшибки, "Выбрать связанный документ");
			
		КонецЕсли;
		
		// Произвольная проверка
		Если НастрокаКонвертацииДокумента.ПроизвольныеВалидации.Количество() > 0 Тогда
			
			Объект = ДокументОбъектИлиСсылка;
			
			Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
				ДокументОбъектИлиСсылка, ДокументОбъектИлиСсылка.ДокументОснование, НастрокаКонвертацииДокумента, "");
			
			Для Каждого СтрокаВалидации Из НастрокаКонвертацииДокумента.ПроизвольныеВалидации Цикл
				
				Если Не СтрокаВалидации.Активна Или Не ЗначениеЗаполнено(СтрокаВалидации.ТекстВалидации) Тогда
					Продолжить;
				КонецЕсли;
				
				ВычисленноеЗначение = Неопределено;
				ВыражениеВычисления = СтрокаВалидации.ТекстВалидации;
				Если ВыражениеВычисления <> Неопределено Тогда
					
					РезультатВычисления = Неопределено;
					Попытка
						
						Параметры = Новый Структура;
						Параметры.Вставить("ДатаГлавного", ДатаГлавного);
						Параметры.Вставить("ОрганизацияГлавного", ОрганизацияГлавного);
						Параметры.Вставить("Объект", Объект);
						Параметры.Вставить("НастрокаКонвертацииДокумента", НастрокаКонвертацииДокумента);
						Параметры.Вставить("СтрокаВалидации", СтрокаВалидации);
						
						ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
							ВыражениеВычисления, Параметры);
						
					Исключение
						
						ВычисленноеЗначение = Неопределено;
						Сообщить("Ошибка вычисления кастомной валидации: " + ОписаниеОшибки());
						
					КонецПопытки;
					
				КонецЕсли;
				
				Если ВычисленноеЗначение <> Истина Тогда
					
					Если ЗначениеЗаполнено(СтрокаВалидации.ТекстОшибки) Тогда
						ТекстОшибки = СтрокаВалидации.ТекстОшибки;
					Иначе
						ТекстОшибки = "Ошибка кастомной валидации (настройки конветрации)";
					КонецЕсли;
					
					Если СтрокаВалидации.ДействиеПриОтказеВалидации = Перечисления.КонтурЛогистика_ДействияПриОтказеВалидации.Предупреждение Тогда
						КатегорияОшибкиОбъекта = КатегорияПредупреждение;
					ИначеЕсли СтрокаВалидации.ДействиеПриОтказеВалидации = Перечисления.КонтурЛогистика_ДействияПриОтказеВалидации.ТолькоРучноеПодписание Тогда
						
						Если ТипЗнч(ПараметрыФормированияФайлов) = Тип("Структура")
							И ПараметрыФормированияФайлов.Свойство("СформированАвтоматическимСценарием") Тогда
							
							КатегорияОшибкиОбъекта = КатегорияОшибка;
						Иначе
							КатегорияОшибкиОбъекта = КатегорияПредупреждение;
						КонецЕсли;
						
					Иначе
						КатегорияОшибкиОбъекта = КатегорияОшибка;
					КонецЕсли;
					
					Если КатегорияОшибкиОбъекта = КатегорияОшибка Тогда
						ТекущееДействие = "Исправить";
					Иначе
						ТекущееДействие = "Внимание";
					КонецЕсли;
					
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
						ТаблицаОшибок, "", "", "", КатегорияОшибкиОбъекта, ТекстОшибки, ТекущееДействие);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверка ДополнительныеПолучателиФайла
	Если ДокументОбъектИлиСсылка.Метаданные().ТабличныеЧасти.Найти("ДополнительныеПолучателиФайла") <> Неопределено Тогда
		Для каждого ДопПолучатель из ДокументОбъектИлиСсылка.ДополнительныеПолучателиФайла Цикл
			Если Не ЗначениеЗаполнено(ДопПолучатель.ОрганизацияДиадок) Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "ДополнительныеПолучателиФайла", ДопПолучатель.НомерСтроки, 
					"", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, "Не заполнен дополнительный получатель файла", "Заполнить");		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Валидатор_ПроверитьМедика(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	МедРаботник = ДокументОбъектИлиСсылка.МедРаботник;
	
	МедОрганизация = Неопределено;
	Если ДокументОбъектИлиСсылка.Титул1.ЛицоОформившееПЛ <> ДокументОбъектИлиСсылка.Титул1.ОрганизацияМедик Тогда
		МедОрганизация = ДокументОбъектИлиСсылка.Титул1.ОрганизацияМедик;		
	КонецЕсли;
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	
	Если ЗначениеЗаполнено(МедРаботник) Тогда 
		
		Если Не ЗначениеЗаполнено(МедРаботник.Фамилия) Тогда 
			ТекстОшибки = "У мед. работника не указана фамилия";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедРаботник.Фамилия", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(МедРаботник.Имя) Тогда 
			ТекстОшибки = "У мед. работника не указан о имя";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедРаботник.Имя", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	     	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МедОрганизация) Тогда 
		
		Если Не ЗначениеЗаполнено(МедОрганизация.НаименованиеОрганизацииПолное) Тогда 
			ТекстОшибки = "У мед. организации не указано полное наименование";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедОрганизация.НаименованиеОрганизацииПолное", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(МедОрганизация.ИНН) Тогда 
			ТекстОшибки = "У мед. орагнизации не указан ИИ";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедОрганизация.ИНН", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;				
	
	КонецЕсли;

КонецПроцедуры

Процедура Валидатор_ПроверитьМедЛицензию(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	Лицензия = ДокументОбъектИлиСсылка.МедЛицензия;
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	
	Если ЗначениеЗаполнено(Лицензия) Тогда 
		
		Если Не ЗначениеЗаполнено(Лицензия.Серия) Тогда 
			ТекстОшибки = "В мед. лицензии не указана серия";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедЛицензия.Серия", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(Лицензия.Номер) Тогда 
			ТекстОшибки = "В мед. лицензии не указан номер";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедЛицензия.Номер", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(Лицензия.ДатаВыдачи) Тогда 
			ТекстОшибки = "В мед. лицензии не указана дата выдачи";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедЛицензия.ДатаВыдачи", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(Лицензия.СрокОкончанияДействия) И Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипЛогистика) Тогда			
			ТекстОшибки = "В мед. лицензии не указан срок окончания действия";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"МедЛицензия.СрокОкончанияДействия", КатегорияОшибка, ТекстОшибки, "Указать");			
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

Процедура Валидатор_ПроверитьСведенияОТопливе(Знач Объект, ТаблицаОшибок, ИмяТаблицыГСМ) Экспорт
	
	Если Объект[ИмяТаблицыГСМ].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяТаблицыГСМ = "ОстаткиТоплива" Тогда
		ДополнениеТекстаОшибки = " в остатках";	
	ИначеЕсли ИмяТаблицыГСМ = "Заправки" Тогда
		ДополнениеТекстаОшибки = " в заправках";
	Иначе
		ДополнениеТекстаОшибки = "";
	КонецЕсли;
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Для каждого ГСМ Из Объект[ИмяТаблицыГСМ] Цикл
			
		Если Не ЗначениеЗаполнено(ГСМ.Топливо) Тогда
			
			ТекстОшибки = "Не заполнено топливо" + ДополнениеТекстаОшибки;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТаблицыГСМ, ГСМ.НомерСтроки, 
				"ГСМ.Топливо", КатегорияОшибка, ТекстОшибки, "Указать");	
		
		Иначе
		
			Если Не ЗначениеЗаполнено(ГСМ.Топливо.ТипТоплива) Тогда
				
				ТекстОшибки = "Не заполнен вид топлива" + ДополнениеТекстаОшибки;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТаблицыГСМ, ГСМ.НомерСтроки, 
					"ГСМ.Топливо.ТипТоплива", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если ГСМ.Топливо.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline И Не ЗначениеЗаполнено(ГСМ.Топливо.ВидТоплива)
				ИЛИ ГСМ.Топливо.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Diesel И Не ЗначениеЗаполнено(ГСМ.Топливо.ВидТоплива)
				ИЛИ ГСМ.Топливо.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas И Не ЗначениеЗаполнено(ГСМ.Топливо.ВидТоплива)Тогда
				
				ТекстОшибки = "Не заполнена марка топлива" + ДополнениеТекстаОшибки;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТаблицыГСМ, ГСМ.НомерСтроки, 
					"ГСМ.Топливо.ВидТоплива", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ГСМ.Топливо.ЕдиницаИзмеренияПоКлассификатору) Тогда
				
				ТекстОшибки = "Не заполнен единица измерения топлива" + ДополнениеТекстаОшибки;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТаблицыГСМ, ГСМ.НомерСтроки, 
					"ГСМ.Топливо.ЕдиницаИзмеренияПоКлассификатору", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если ГСМ.Топливо.ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.Иное
				И Не ЗначениеЗаполнено(ГСМ.Топливо.ЕдиницаИзмерения) Тогда
				
				ТекстОшибки = "Не заполнен иная единица измерения топлива" + ДополнениеТекстаОшибки;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТаблицыГСМ, ГСМ.НомерСтроки, 
					"ГСМ.Топливо.ЕдиницаИзмерения", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ГСМ.КоличествоТоплива) Тогда
				
				ТекстОшибки = "Не заполнено количество топлива" + ДополнениеТекстаОшибки;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТаблицыГСМ, ГСМ.НомерСтроки, 
					"ГСМ.КоличествоТоплива", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьОрганизациюПодписантаИДатуПодписи(Знач ДокументОбъектИлиСсылка) Экспорт
	
	Результат = Новый Структура("ОрганизацияГлавного, ДатаГлавного");
	
	ТипЗнчСсылкиОбъекта = ТипЗнч(ДокументОбъектИлиСсылка.Ссылка);
	
	Если ЭтоТитулЗН(ДокументОбъектИлиСсылка.Ссылка) Тогда
		
		ГлавныйДокумент = ДокументОбъектИлиСсылка.ДокументЗН;
		Результат.ДатаГлавного = ГлавныйДокумент.ДатаЗН;
		
		Если ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул1") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Фрахтователь;
			
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул2") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Фрахтовщик;
			
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул3")Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Фрахтователь;
			
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул4") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Фрахтовщик;
			
		КонецЕсли;
		
		
	ИначеЕсли ЭтоТитулТрн(ДокументОбъектИлиСсылка.Ссылка) Тогда
		
		ГлавныйДокумент = ДокументОбъектИлиСсылка.ДокументЭТРН;
		Результат.ДатаГлавного = ГлавныйДокумент.ДатаТрН;
		
		Если ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
			Результат.ОрганизацияГлавного = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ОрганизацияДляПолученияНастроекПодписания(ГлавныйДокумент);
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Перевозчик;
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
			
			// Если после Т7 в Т3 стоит другой грузополучатель
			Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.Грузополучатель)
				И ДокументОбъектИлиСсылка.Грузополучатель <> ГлавныйДокумент.Грузополучатель Тогда
				
				Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Грузополучатель;
			Иначе
				Результат.ОрганизацияГлавного = ГлавныйДокумент.Грузополучатель;
			КонецЕсли;
			
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Перевозчик;
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Перевозчик;
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Грузоотправитель;
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Перевозчик;
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8") Тогда
			Результат.ОрганизацияГлавного = ГлавныйДокумент.Перевозчик;
		КонецЕсли;
		
	ИначеЕсли ЭтоТитулПЛ(ДокументОбъектИлиСсылка.Ссылка) Тогда
		
		
		Если ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
			
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.ЛицоОформившееПЛ;
			Результат.ДатаГлавного = ДокументОбъектИлиСсылка.ДатаПЛ;
			
		Иначе
			
			ГлавныйДокумент = ДокументОбъектИлиСсылка.Титул1;
			Если ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2") Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияМедик), ГлавныйДокумент.ОрганизацияМедик, ГлавныйДокумент.ЛицоОформившееПЛ);
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияТехСостояние), ГлавныйДокумент.ОрганизацияТехСостояние, ГлавныйДокумент.ЛицоОформившееПЛ);
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4") Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияОдометр), ГлавныйДокумент.ОрганизацияОдометр, ГлавныйДокумент.ЛицоОформившееПЛ);
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5") Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияОдометр), ГлавныйДокумент.ОрганизацияОдометр, ГлавныйДокумент.ЛицоОформившееПЛ);
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6") Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияМедик), ГлавныйДокумент.ОрганизацияМедик, ГлавныйДокумент.ЛицоОформившееПЛ);				
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2_5_02") Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияМедик), ГлавныйДокумент.ОрганизацияМедик, ГлавныйДокумент.ЛицоОформившееПЛ);
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02")Тогда
				Результат.ОрганизацияГлавного = ГлавныйДокумент.ЛицоОформившееПЛ;
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4_5_02") Тогда
				Результат.ОрганизацияГлавного = ГлавныйДокумент.ЛицоОформившееПЛ;
			ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5_5_02") Тогда
				Результат.ОрганизацияГлавного = ?(ЗначениеЗаполнено(ГлавныйДокумент.ОрганизацияМедик), ГлавныйДокумент.ОрганизацияМедик, ГлавныйДокумент.ЛицоОформившееПЛ);				
			КонецЕсли;
			Результат.ДатаГлавного = ГлавныйДокумент.ДатаПЛ;
			
		КонецЕсли;
		
	ИначеЕсли ЭтоТитулЗЗ(ДокументОбъектИлиСсылка.Ссылка) Тогда
		
		Если ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
			
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Грузоотправитель;
			Результат.ДатаГлавного = ДокументОбъектИлиСсылка.ДатаЗак;
			
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
			
			ГлавныйДокумент = ДокументОбъектИлиСсылка.Титул1;
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Титул1.Перевозчик;
			Результат.ДатаГлавного = ГлавныйДокумент.ДатаЗак;
			
		КонецЕсли;
		
	ИначеЕсли ЭтоТитулДФ(ДокументОбъектИлиСсылка.Ссылка) Тогда
		
		Если ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1") Тогда
			
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Фрахтователь;
			Результат.ДатаГлавного = ДокументОбъектИлиСсылка.Дата;
			
		ИначеЕсли ТипЗнчСсылкиОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул2") Тогда
			
			ГлавныйДокумент = ДокументОбъектИлиСсылка.Титул1;
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Титул1.Фрахтовщик;
			Результат.ДатаГлавного = ГлавныйДокумент.Дата;
			
		КонецЕсли;
		
	ИначеЕсли ЭтоТитулЭР(ДокументОбъектИлиСсылка.Ссылка) Тогда
		
		СтатусДокументаоборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка);
		
		Если СтатусДокументаоборота = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("fr-сheck-cargo-owner") Тогда
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Грузоотправитель;
		Иначе
			Результат.ОрганизацияГлавного = ДокументОбъектИлиСсылка.Экспедитор;
		КонецЕсли;
		
		Результат.ДатаГлавного = ДокументОбъектИлиСсылка.ДатаДок;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Валидатор_ПроверитьПодписантаПроверитьУсловия(Знач Категория, ТаблицаОшибок, ПодписантСтруктура, ТипТитула, ТребуемоеДействие = Неопределено, ДокументОбъектИлиСсылка = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ПодписантСтруктура.ПометкаУдаленияСертификат) И ПодписантСтруктура.ПометкаУдаленияСертификат Тогда 
		ТекстОшибки = "Невозможна подпись: Сертификат помечен на удаление";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"Подписант.Сертификат", Категория, ТекстОшибки, "Настроить");
	КонецЕсли;
			
	Если Не ЗначениеЗаполнено(ПодписантСтруктура.ОтпечатокСертификата) Тогда
		ТекстОшибки = "Выберите сертификат и МЧД для подписания";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"Подписант", Категория, ТекстОшибки, "Настроить");
		Возврат; // более не спамить страшными предупреждениями
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПодписантСтруктура.СтатусПодписанта) Тогда 
		ТекстОшибки = "Невозможна подпись: Настройте Статус подписанта в регистре ""Настройки подписания (Контур.Логистика)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
		"Подписант", Категория, ТекстОшибки, "Настроить");
	КонецЕсли;
	
	ЗапретОтправкиТитулаПриОшибкахМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЗапретОтправкиТитулаПриОшибкахМЧД");
	Если Категория = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение Тогда
		КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ИначеЕсли ЗапретОтправкиТитулаПриОшибкахМЧД Тогда
		КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	Иначе
		КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;		
	КонецЕсли;
	ПояснениеКОшибкеМЧД = " В настройках включен запрет отправки титула при ошибках в МЧД";
	
	Если ПодписантСтруктура.СтатусПодписанта = "2" Или ПодписантСтруктура.СтатусПодписанта = "5"
		Или (ПодписантСтруктура.СпосПодтПолном = "3" И Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипТитула)) Тогда 
		// это электронная МЧД
		
		Если Не ЗначениеЗаполнено(ПодписантСтруктура.МЧДСсылка) Тогда
			
			ТекстОшибки = "Невозможна подпись: В настройке подписания отсутствует МЧД";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Подписант", Категория, ТекстОшибки, "Настроить");
			
		Иначе
		
			Если ЗначениеЗаполнено(ПодписантСтруктура.ПометкаУдаленияМЧД) И ПодписантСтруктура.ПометкаУдаленияМЧД Тогда 
				
				ТекстОшибки = "МЧД помечена на удаление.";
				Если КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка Тогда
					ТекстОшибки = ТекстОшибки + ПояснениеКОшибкеМЧД;
				КонецЕсли;
				
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Подписант.МЧДСсылка", КатегорияМЧД, ТекстОшибки, "Настроить");
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ПодписантСтруктура.ИдСистХран) Тогда
				
				ТекстОшибки = "В МЧД отсутствуют данные о системе хранения.";
				Если КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка Тогда
					ТекстОшибки = ТекстОшибки + ПояснениеКОшибкеМЧД;
				КонецЕсли;
				
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"Подписант.МЧДСсылка", КатегорияМЧД, ТекстОшибки, "Настроить");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ПодписантСтруктура.СтатусПроверки) Тогда
				
				ТекстОшибки = "Проверка МЧД не выполнялась. Рекомендуется проверить МЧД в регистре ""Настройки подписания (Контур.Логистика)""";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"Подписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Проверить");
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПодписантСтруктура.СтатусПроверки) И
				Не КонтурЛогистика_МашиночитаемыеДовернностиСервер.МЧДВалидна(ПодписантСтруктура.СтатусПроверки) Тогда
				
				ТекстОшибки = "МЧД не прошла проверку.";
				Если КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка Тогда
					ТекстОшибки = ТекстОшибки + ПояснениеКОшибкеМЧД;
				КонецЕсли;
				
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"Подписант", КатегорияМЧД, ТекстОшибки, "Настроить");
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПодписантСтруктура.ДатаОкончанияМЧД) И ТекущаяДатаСеанса() > КонецДня(ПодписантСтруктура.ДатаОкончанияМЧД) Тогда
				
				ТекстОшибки = "Срок действия МЧД истек.";
				Если КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка Тогда
					ТекстОшибки = ТекстОшибки + ПояснениеКОшибкеМЧД;
				КонецЕсли;
				
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"Подписант.МЧДСсылка", КатегорияМЧД, ТекстОшибки, "Настроить");
				
			КонецЕсли;
			
			КолвоДнейПроверкиМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КоличествоДнейДляПредупрежденияПроверкиМЧД();
			Если КонтурЛогистика_МашиночитаемыеДовернностиСервер.МЧДВалидна(ПодписантСтруктура.СтатусПроверки) И 
				ПодписантСтруктура.ДнейПослеПроверкиМЧД > КолвоДнейПроверкиМЧД Тогда
				
				ТекстОшибки = "Проверка МЧД не выполнялась " + Строка(КолвоДнейПроверкиМЧД) + " дней. Проверьте МЧД в регистре ""Настройки подписания (Контур.Логистика)""";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"Подписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Проверить");
				
			КонецЕсли;
			
			СпособПередачиМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособПередачиМЧД");	
			Если СпособПередачиМЧД = Перечисления.КонтурЛогистика_СпособыПередачиМЧД.Файл
				И КонтурЛогистика_МашиночитаемыеДовернностиСервер.МЧДВалидна(ПодписантСтруктура.СтатусПроверки)
				И (Не ЗначениеЗаполнено(ПодписантСтруктура.МЧДССылка.XMLфайлМЧД.Получить()) 
					Или Не ЗначениеЗаполнено(ПодписантСтруктура.МЧДССылка.XMLфайлМЧД.Получить()))	
			Тогда
			
				ТекстОшибки = "Невозможна подпись: В МЧД отсутствуют файлы с доверенностью и электронной подписью";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"Подписант.МЧДСсылка", Категория, ТекстОшибки, "Настроить");
				
			КонецЕсли;
			
			ВариантПроверкиПолномочийМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВариантПроверкиПолномочийМЧД");	
			
			// особенность отправки в адрес торговых сетей - способ передачи МЧД
			Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
					И ДокументОбъектИлиСсылка <> Неопределено
					И ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ДокументЭТРН) Тогда

					ВариантПроверкиПолномочийМЧД_ГП = Неопределено;
					ВариантПроверкиПолномочийМЧД_ПВ = Неопределено;
					
					Если  ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ДокументЭТРН.ПартнерГрузополучатель) Тогда
						ВариантПроверкиПолномочийМЧД_ГП = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВариантПроверкиПолномочийМЧД", ДокументОбъектИлиСсылка.ДокументЭТРН.ПартнерГрузополучатель);
					КонецЕсли;
					Если  ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ДокументЭТРН.ПартнерПеревозчик) Тогда
						ВариантПроверкиПолномочийМЧД_ПВ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВариантПроверкиПолномочийМЧД", ДокументОбъектИлиСсылка.ДокументЭТРН.ПартнерПеревозчик);
					КонецЕсли;
					
					Если ВариантПроверкиПолномочийМЧД_ГП = Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.ПроверятьСОшибкой
						Или ВариантПроверкиПолномочийМЧД_ПВ = Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.ПроверятьСОшибкой Тогда 
						
						ВариантПроверкиПолномочийМЧД = Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.ПроверятьСОшибкой;
					КонецЕсли;

			КонецЕсли;
			
			Если ВариантПроверкиПолномочийМЧД <> Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.НеПроверять Тогда 
					
				Полномочие = Перечисления.КонтурЛогистика_Полномочия.ПолучитьПолномочиеПоТипуЛогистическогоДокумента(ТипТитула, ТребуемоеДействие);		
				Если Не РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.ПроверитьПолномочияМЧД( ДокументОбъектИлиСсылка,
																										ПодписантСтруктура.МЧДСсылка, 
																										Полномочие, 
																										ТипТитула, 
																										ПодписантСтруктура.ОтпечатокСертификата) Тогда
																										
					Если ВариантПроверкиПолномочийМЧД = Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.ПроверятьСОшибкой Тогда
						КатегорияПолномочияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
					Иначе
						КатегорияПолномочияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
					КонецЕсли;	
						
					ТекстОшибки = "У МЧД нет разрешенных полномочий для подписания титула";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
						"Подписант.ПроверятьПолномочия", КатегорияПолномочияМЧД, ТекстОшибки, "Настроить");	
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодписантСтруктура.Сертификат) И Не ЗначениеЗаполнено(ПодписантСтруктура.МЧДСсылка) Тогда
		
		СертификатВыдан = Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ТипВладельцаСертификата(ПодписантСтруктура.Сертификат);
		Если ПодписантСтруктура.Сертификат.ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.УКЭП
			И СертификатВыдан = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо 
			И (ПодписантСтруктура.СтатусПодписанта = "1"
			ИЛИ ПодписантСтруктура.СтатусПодписанта = "2"
			ИЛИ ПодписантСтруктура.СтатусПодписанта = "4"
			ИЛИ ПодписантСтруктура.СтатусПодписанта = "5"
			ИЛИ ПодписантСтруктура.СпосПодтПолном = "2"
			ИЛИ ПодписантСтруктура.СпосПодтПолном = "3") Тогда
			
			ТекстОшибки = "Сертификат физ. лица без МЧД не будет обладать юридической силой.";
			Если КатегорияМЧД = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка Тогда
				ТекстОшибки = ТекстОшибки + ПояснениеКОшибкеМЧД;
			КонецЕсли;
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Подписант", КатегорияМЧД, ТекстОшибки, "Настроить");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПодписантСтруктура.Фамилия)
		ИЛИ Не ЗначениеЗаполнено(ПодписантСтруктура.Имя) Тогда 
		ТекстОшибки = "Невозможна подпись: Укажите ФИО подписанта в регистре ""Настройки подписания (Контур.Логистика)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Подписант", Категория, ТекстОшибки, "Настроить");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПодписантСтруктура.ОтпечатокСертификата) Тогда 
		ТекстОшибки = "Невозможна подпись: Укажите сертификат для подписания в регистре ""Настройки подписания (Контур.Логистика)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Подписант", Категория, ТекстОшибки, "Настроить");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодписантСтруктура.СрокДействия) Тогда
		
		Если НачалоДня(ТекущаяДатаСеанса()) > ПодписантСтруктура.СрокДействия Тогда
			
			ТекстОшибки = "Невозможна подпись: Срок действия сертификата истек";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Подписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Настроить");
			
		Иначе		
			
			РазницаВДнях = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазницаВДнях(ПодписантСтруктура.СрокДействия, ТекущаяДатаСеанса());
			Если РазницаВДнях <= 10 Тогда
				ТекстОшибки = "Срок действия сертификата истекает " + ?(РазницаВДнях = 0, "сегодня", "через " + Строка(РазницаВДнях) + " дней");
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Подписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Настроить");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 
		ИЛИ ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2
	Тогда
	
		Если Не ЗначениеЗаполнено(ПодписантСтруктура.Должность) Тогда 
			ТекстОшибки = "Невозможна подпись: Укажите должность в сертификате";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Подписант.Сертификат", Категория, ТекстОшибки, "Настроить");
		КонецЕсли;	
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодписантСтруктура.Сертификат) Тогда
		
		Если ПодписантСтруктура.Сертификат.ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.УНЭП 
			И ТипТитула <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда			
			ТекстОшибки = "Невозможна подпись: Замените сертификат на КЭП";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Подписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Настроить");			
		ИначеЕсли ПодписантСтруктура.Сертификат.ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.Тестовая Тогда			
			ТекстОшибки = "Документ будет подписан тестовым сертификатом и не будет обладать юридической силой";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Подписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Настроить");			
		ИначеЕсли ПодписантСтруктура.Сертификат.ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.ПустаяСсылка() Тогда
			ТекстОшибки = "Тип подписи сертификата не удалось определить";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Подписант.Сертификат", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Настроить");			
		КонецЕсли;
						
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипТитула) И Не ЗначениеЗаполнено(ПодписантСтруктура.Должность) Тогда 
		ТекстОшибки = "Невозможна подпись: Укажите должность подписанта в сертификате регистра ""Настройки подписания (Контур.Логистика)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Подписант.Сертификат", Категория, ТекстОшибки, "Настроить");
	КонецЕсли;

КонецПроцедуры

