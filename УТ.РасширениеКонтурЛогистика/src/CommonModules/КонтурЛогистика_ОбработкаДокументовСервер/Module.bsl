			КонтурЛогистика_ПанельОшибокСервер.УдалитьВТаблицеОшибок(ТаблицаОшибок, "ГлавныйДокумент.Грузоотправитель");
			
			ТекстОшибки = "Грузоотправитель, " + Грузоотправитель + ", ещё не подключен к ЭДО.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Грузоотправитель", КатегорияОшибка, ТекстОшибки, "Пригласить в ЭДО");
			
		ИначеЕсли Не Грузоотправитель.ЕстьВСервисеЛогистика Тогда
			
			ТекстОшибки = "Грузоотправитель, " + Грузоотправитель + ", впервые будет работать с ЭПД в сервисе.";
