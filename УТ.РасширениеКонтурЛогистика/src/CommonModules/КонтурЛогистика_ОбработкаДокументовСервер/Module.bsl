			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"ЛОП", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		ИначеЕсли Не ЛОП.ПродуктивТрн Тогда 
			
			ТекстОшибки = "Лицо, осуществл. погрузку, " + ЛОП + ", работает в тестовом режиме. "
				+ "Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ЛОП", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацииБезИДУчастникаЭДО;
	
