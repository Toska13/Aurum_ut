		ИначеЕсли КНД = "1110349" Тогда 
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодСВИнфГП.УИД_СВ"); 
		
		ИначеЕсли КНД = "1110339" Тогда 
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфГО.УИД_ТрН");
