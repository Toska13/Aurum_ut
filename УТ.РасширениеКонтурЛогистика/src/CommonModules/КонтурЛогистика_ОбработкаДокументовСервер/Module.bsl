Функция НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(ТипЛогистическогоДокументаКоторыйИщем, ГлавныйДокумент, ПроверитьПодпись = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Если ищем себя же, то просто вернуть себя
	ТипЛогистикаГлавныйДокумент = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ГлавныйДокумент);
	Если ТипЛогистикаГлавныйДокумент = ТипЛогистическогоДокументаКоторыйИщем Тогда
		Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ГлавныйДокумент);
	КонецЕсли;
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистическогоДокументаКоторыйИщем);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул2.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|		ПО КонтурЛогистика_ТрН_Титул2.Ссылка = КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = &ГлавныйДокумент
	|	И НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления
	|	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	|	И (КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен)
	|			ИЛИ КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен))
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ТрН_Титул2.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_ТрН_Титул2.Дата УБЫВ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТрН_Титул2", ИмяТитула);
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипЛогистическогоДокументаКоторыйИщем) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".ДокументЗН");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(ТипЛогистическогоДокументаКоторыйИщем) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".ДокументСВ");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистическогоДокументаКоторыйИщем)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистическогоДокументаКоторыйИщем) Тогда
		
		Если ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".Ссылка");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".Титул1");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПроверитьПодпись Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления", 
			"И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления И КонтурЛогистика_ФайлыОбмена.ПодписьВерна");	
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция УдалитьДокументыВДиадоке(МассивСвязанныхДокументов) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	МассивСторон = Новый Массив;
	
	Состояния = Новый Массив;
	Состояния.Добавить("Получен");
	
	ВходящиеФайлы = Справочники.КонтурЛогистика_ФайлыОбмена.ФайлыВСостояниях(МассивСвязанныхДокументов, Состояния);
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		Для Каждого Входящий Из ВходящиеФайлы Цикл
			
			Если Входящий.Отправитель.Наш И МассивСторон.Найти(Входящий.Отправитель) = Неопределено Тогда 
				
				КонтурЛогистика_API_Диадок.Диадок_АПИ_Delete(Входящий.Отправитель, 
				Входящий.MessageId, 
				Входящий.DocumentId);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию(); 
		
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#Область ПодготовкаКПатчу

Функция ПодготовитьКПодписаниюФайлыОбменаПатчем(МассивФайловОбмена) Экспорт
	
	Подготовленные = Новый Массив;
		
	ФайлыКПодготовке 
		= Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлыКоторыеТребуетсяПатчить(
			МассивФайловОбмена);
			
	Если ФайлыКПодготовке.Количество() = 0 Тогда
		Возврат Подготовленные;
	КонецЕсли;
	
	BoxID 			 = ФайлыКПодготовке[0].Отправитель.ID;
	ПараметрыСервиса = КонтурЛогистика_API_Диадок.ЛогистикаПараметрыСервиса_Диадок(BoxID);
	ДокументыДиадок  = МассивДокументовДиадокИзФайлов(ФайлыКПодготовке);
	ПараметрыЗапроса = ПараметрыЗапросаПодготовкиКПодписи(BoxID, ПараметрыСервиса, ДокументыДиадок);
	Ядро 			 = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();
	
	РезультатЗапроса = Ядро.ПодготовитьКПодписанию(ПараметрыЗапроса);
	
	Для Каждого Пропатченный Из РезультатЗапроса.DocumentPatchedContents Цикл
		
		ФайлОбмена = ФайлОбменаПоMessageIdEntityId(ФайлыКПодготовке, 
			Пропатченный.DocumentId.MessageId, 
			Пропатченный.DocumentId.EntityId);
			
		Если Не ЗначениеЗаполнено(ФайлОбмена) Тогда
			Продолжить;
		КонецЕсли;
			
		ОбъектФайла 				 	  = ФайлОбмена.ПолучитьОбъект();
		ОбъектФайла.PatchedContentId 	  = Пропатченный.PatchedContentId;
		ОбъектФайла.ТребуетсяПодпись      = Истина; //важно установтиь этот признак иначе он не будет подписан
		
		Если ОбъектФайла.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен Тогда
			// сбросим состояние файла в "Не отправлен" если мы патчем отправленный нами файл чтобы команда подписания выполнилась
			ОбъектФайла.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправлен;
		КонецЕсли;
		
		ТекстXML 
			= ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Пропатченный.Content), КодировкаТекста.ANSI);
		ОбъектФайла.ТекстXML 		 	  = Новый ХранилищеЗначения(ТекстXML, Новый СжатиеДанных(9));
		ОбъектФайла.ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		ОбъектФайла.Записать();
		
		Подготовленные.Добавить(ФайлОбмена);
		
	КонецЦикла;	
	
	Возврат Подготовленные;
	
КонецФункции

Функция НайтиФайлыКоторыеТребуетсяПатчить(МассивФайловОбмена) Экспорт
	
	Возврат Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлыКоторыеТребуетсяПатчить(МассивФайловОбмена);
	
КонецФункции

