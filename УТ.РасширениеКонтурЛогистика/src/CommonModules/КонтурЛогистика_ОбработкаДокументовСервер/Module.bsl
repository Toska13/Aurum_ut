Процедура ДобавитьПредупреждениеМинтрансаВТитул(ФайлОбменаСсылка, СтруктураJSON)

	ОписаниеПредупреждения = "Предупреждение: " + Формат(СтруктураJSON.requestStatus, "ЧГ=0") + " " + ?(ЗначениеЗаполнено(СтруктураJSON.comment), СтруктураJSON.comment, "");
	
	ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
	
	ФайлОбменаОбъект.ОписаниеПредупреждения = ОписаниеПредупреждения; 
	
	ФайлОбменаОбъект.Записать();
		
КонецПроцедуры

Процедура ДобавитьОшибкуМинтрансаВТитул(ФайлОбменаСсылка, СтруктураJSON, УдалитьФайлыИТитулы = Ложь)

	ОписаниеОшибки = "Ошибка: " + СтруктураJSON.requestStatus + " " + ?(ЗначениеЗаполнено(СтруктураJSON.comment), СтруктураJSON.comment, "");
	
	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаГИС);
	СтруктураОшибки.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	СтруктураОшибки.Вставить("МассивОшибок", СтруктураJSON.errors);
	СтруктураОшибки.Вставить("КодОшибки", СтруктураJSON.requestStatus);
	
	ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
	
	ФайлОбменаОбъект.Состояние 		= Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки;
	ФайлОбменаОбъект.ОписаниеОшибок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(СтруктураОшибки); 
	
	СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", ФайлОбменаОбъект.ОписаниеОшибок);
	
	ФайлОбменаОбъект.Записать();
	
	Если УдалитьФайлыИТитулы Тогда 
		ФайлОбменаОбъект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
		
		НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка;
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ФайлОбменаСсылка.СвязанныйДокумент, НовыйСтатусТитула, , , СтруктураОшибки);
		
		Если УдалитьФайлыИТитулы Тогда
			ТитулОбъект = ФайлОбменаСсылка.СвязанныйДокумент.ПолучитьОбъект();
			ТитулОбъект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработатьЗамечанияВодителяДиадок(Файл, ТекстXML, ЗачечанияОбработаны)
	
	Попытка
		
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);
		
		КС = КонтурЛогистика_КонструкторыXDTO;
		
		Документ 	= КС.XDTO_Вычислить(XDTO, "CarrierTitle.Файл.Документ");
		ИдФайл 		= КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "CarrierTitle.Файл.ИдФайл");
		
		ЭтоНашПеревозчик 	= Файл.Получатель.Наш И Файл.Получатель.Перевозчик;
		ТипТитула 			= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(ИдФайл);
		ЭтоПогрузка 		= ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2;
		
		СодИнфПрв 	= СодИнфПрвXDTO(Документ, ТипТитула);
		ОтметПрв 	= ОтметПрвXDTO(СодИнфПрв, ТипТитула);
		
		Постфикс = ?(ЭтоПогрузка, "Прием", "Выд");
		ЗамПрв = КС.XDTO_Вычислить(СодИнфПрв, "ЗамПрв" + ПостФикс);
		
		ЕстьЗамечанияПеревозчика = ЗамПрв <> Неопределено;
		ЕстьОтметкиПеревозчика = ЕстьОтметкиПеревозчикаXDTO(ОтметПрв);
		
		Если ЕстьЗамечанияПеревозчика Или ЕстьОтметкиПеревозчика Тогда
			СтруктураЗамечаний = ЗамечанияВодителяXDTO(СодИнфПрв, ЭтоПогрузка);
			ЗаполнитьКомментарииВодителяВЭТрН(Файл.ГлавныйДокумент, СтруктураЗамечаний.ЗамечанияВодителя, ТипТитула);
		КонецЕсли;
		
		Если ЭтоНашПеревозчик И (ЕстьЗамечанияПеревозчика Или ЕстьОтметкиПеревозчика) Тогда
			
			НайденныйТитул = НайтиСоздатьТитулПоЭТРН(Файл, ТипТитула);
			НайденныйТитулОбъект = НайденныйТитул.ПолучитьОбъект();
			
			// Уже получили комментарии из Логистики
			Если НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика Или НайденныйТитулОбъект.ЕстьОтметкиПеревозчика Тогда
				Возврат;
			КонецЕсли;
			
			Если ЕстьЗамечанияПеревозчика Тогда
				ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, СтруктураЗамечаний);
				КонтурЛогистика_КонструкторыXDTO.ЗаполнитьИнфПолИзXDTO(ЗамПрв, НайденныйТитулОбъект, "ЗамечанияИнфПол");
			КонецЕсли;
			
			Если ЕстьОтметкиПеревозчика Тогда
				ЗаполнитьОтметкиПеревозчикаXDTO(ОтметПрв, НайденныйТитулОбъект);
			КонецЕсли;
			
			// Перенесем ОтметкиПеревозчика в СтруктураЗамечаний для формирования сообщений
			Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
				Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
				
				Для Каждого ТекущаяОтметка Из НайденныйТитулОбъект.ОтметкиПеревозчика Цикл
					НоваяОтметка = КонтурЛогистика_Уведомления.НоваяОтметкаПеревозчика();
					НоваяОтметка.Вставить("ДатаИВремяОтметки", ТекущаяОтметка.ДатаИВремяОтметки);
					НоваяОтметка.Вставить("ОписаниеОбстоятельств", ТекущаяОтметка.ОписаниеОбстоятельств);
					
					СтруктураЗамечаний.ОтметкиПеревозчика.Добавить(НоваяОтметка);
				КонецЦикла;
			КонецЕсли;
			
			НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика = ЕстьЗамечанияПеревозчика;
			НайденныйТитулОбъект.ЕстьОтметкиПеревозчика = ЕстьОтметкиПеревозчика;
			
			НайденныйТитулОбъект.Записать();
			
			Если ЕстьЗамечанияПеревозчика И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
				Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4) Тогда
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(НайденныйТитулОбъект.Ссылка);
			КонецЕсли;
			
			Если ЕстьЗамечанияПеревозчика
				И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4) Тогда
				
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(НайденныйТитулОбъект.Ссылка);
			КонецЕсли;
			
			// Отправка сообщений с замечаниями
			КонтурЛогистика_Уведомления.ОтправитьУведомленияОЗамечанияхВодителя(НайденныйТитулОбъект.ДокументЭТРН, СтруктураЗамечаний, ЭтоПогрузка);
			
		КонецЕсли;
		
		ЗачечанияОбработаны = Истина;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Обработка замечаний водителя из OuterDocflow.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьЗамечанияВодителяЛогистика(Файл, ЗамечанияВодителя, ТипТитула) Экспорт
	
	Попытка
		
		Если Не ЗначениеЗаполнено(Файл.ГлавныйДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоНашПеревозчик = (Файл.Получатель.Наш И Файл.Получатель.Перевозчик);
		ЭтоПогрузка = (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2);
		
		ЕстьЗамечанияПеревозчика = ЗамечанияВодителя.ЕстьЗамечания;
		ЕстьОтметкиПеревозчика = (ЗамечанияВодителя.ОтметкиПеревозчика.Количество() <> 0);
		
		Если ЕстьЗамечанияПеревозчика Тогда
			ЗаполнитьКомментарииВодителяВЭТрН(Файл.ГлавныйДокумент, ЗамечанияВодителя.ПредставлениеЗамечанийВодителя, ТипТитула);
		КонецЕсли;
		
		Если ЭтоНашПеревозчик И (ЕстьЗамечанияПеревозчика Или ЕстьОтметкиПеревозчика) Тогда
			
			НайденныйТитул = НайтиСоздатьТитулПоЭТРН(Файл, ТипТитула, Истина);
			НайденныйТитулОбъект = НайденныйТитул.ПолучитьОбъект();
			
			// Уже получили комментарии из Диадок
			Если (НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика И НайденныйТитулОбъект.ЗамечанияВодителя = ЗамечанияВодителя.ПредставлениеЗамечанийВодителя)
				Или НайденныйТитулОбъект.ЕстьОтметкиПеревозчика Тогда
				
				Возврат;
			КонецЕсли;
			
			Если ЕстьЗамечанияПеревозчика Тогда
				ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, ЗамечанияВодителя);
				
				Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
					
					НайденныйТитулОбъект.ЗамечанияВодителя = ЗамечанияВодителя.ПредставлениеЗамечанийВодителя;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЕстьОтметкиПеревозчика Тогда
				Для Каждого ОтметкаПеревозчика Из ЗамечанияВодителя.ОтметкиПеревозчика Цикл
					ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, ОтметкаПеревозчика, Ложь);
				КонецЦикла;
			КонецЕсли;
			
			НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика = ЕстьЗамечанияПеревозчика;
			НайденныйТитулОбъект.ЕстьОтметкиПеревозчика = ЕстьОтметкиПеревозчика;
			
			НайденныйТитулОбъект.Записать();
			
			Если ЕстьЗамечанияПеревозчика
				И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4) Тогда
				
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(НайденныйТитулОбъект.Ссылка);
			КонецЕсли;
			
			// Отправка сообщений с замечаниями
			КонтурЛогистика_Уведомления.ОтправитьУведомленияОЗамечанияхВодителя(НайденныйТитулОбъект.ДокументЭТРН, ЗамечанияВодителя, ЭтоПогрузка);
			
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Обработка замечаний водителя из ленты Логистики.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьЗамечанияВодителяЛогистика(Файл, ЗамечанияВодителя, ТипТитула) Экспорт
	
	Попытка
		
		ЭтоНашПеревозчик = (Файл.Получатель.Наш И Файл.Получатель.Перевозчик);
		
		Если Не ЗначениеЗаполнено(Файл.ГлавныйДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьКомментарииВодителяВЭТрН(Файл.ГлавныйДокумент, ЗамечанияВодителя.ПредставлениеЗамечанийВодителя, ТипТитула);
		
		Если ЭтоНашПеревозчик Тогда
			
			НайденныййТитул = НайтиТитул(ТипТитула, Файл.ГлавныйДокумент);
			Если Не ЗначениеЗаполнено(НайденныййТитул) Тогда
				// Нет титула, не надо удалять замечания
				Возврат;
			КонецЕсли;
			
			// Найдем и перезаполним уже созданный титул (могут доехать данные подписи)
			НайденныйТитул = НайтиСоздатьТитулПоЭТРН(Файл, ТипТитула, Истина);
			НайденныйТитулОбъект = НайденныйТитул.ПолучитьОбъект();
			
			ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, ЗамечанияВодителя);
			
			Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
				Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
				
				НайденныйТитулОбъект.ЗамечанияВодителя = ЗамечанияВодителя.ПредставлениеЗамечанийВодителя;
				НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика = Ложь;
			КонецЕсли;
			
			НайденныйТитулОбъект.Записать();
			
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Удаление замечаний водителя из ленты Логистики.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Функция ЗамечанияВодителяXDTO(СодИнфПрвXDTO, ЭтоПогрузка = Истина)
	
	Если ЭтоПогрузка Тогда
		ИмяРодителя = "ЗамПрвПрием";
	Иначе
		ИмяРодителя = "ЗамПрвВыд";
	КонецЕсли;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СтруктураЗамечаний = Новый Структура;
	СтруктураЗамечаний.Вставить("ЗамДатВрПриб", 	Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамДатВрУбыт", 	Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамДатВрПосПрием", Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамДатВрПосВыгр", 	Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамСостГруз", 		"");
	СтруктураЗамечаний.Вставить("ЗамМасс", 			"");
	СтруктураЗамечаний.Вставить("ЗамКолМест", 		"");
	СтруктураЗамечаний.Вставить("ЗамПогрРаб", 		"");
	СтруктураЗамечаний.Вставить("ЗамРабВыгр", 		"");
	СтруктураЗамечаний.Вставить("ЗамечанияВодителя", "");
	СтруктураЗамечаний.Вставить("ОтметкиПеревозчика", Новый Массив);
	
	ЗамДатВрПриб_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрПриб");
	Если ЗначениеЗаполнено(ЗамДатВрПриб_raw) Тогда
		СтруктураЗамечаний.ЗамДатВрПриб = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПриб_raw);
	Иначе
		ЗамДатВрПриб_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатаВрПриб");
		
		Если ЗначениеЗаполнено(ЗамДатВрПриб_raw) Тогда
			СтруктураЗамечаний.ЗамДатВрПриб = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПриб_raw);
		КонецЕсли;
	КонецЕсли;
	
	ЗамДатВрУбыт_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрУбыт");
	Если ЗначениеЗаполнено(ЗамДатВрУбыт_raw) Тогда
		СтруктураЗамечаний.ЗамДатВрУбыт = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрУбыт_raw);
	КонецЕсли;
	
	СтруктураЗамечаний.ЗамСостГруз = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамСостГруз");
	
	Если ЭтоПогрузка Тогда
		
		ЗамДатВрПосПрием_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрПосПрием");
		Если ЗначениеЗаполнено(ЗамДатВрПосПрием_raw) Тогда
			СтруктураЗамечаний.ЗамДатВрПосПрием = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПосПрием_raw);
		КонецЕсли;
		
		СтруктураЗамечаний.ЗамМасс 		= КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамМасс");
		СтруктураЗамечаний.ЗамКолМест 	= КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамКолМест");
		СтруктураЗамечаний.ЗамПогрРаб 	= КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамПогрРаб");
		
		СтруктураЗамечаний.ЗамечанияВодителя = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(СтруктураЗамечаний);
		
	Иначе
		
		ЗамДатВрПосВыгр_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрПосВыгр");
		Если ЗначениеЗаполнено(ЗамДатВрПосВыгр_raw) Тогда
			СтруктураЗамечаний.ЗамДатВрПосВыгр = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПосВыгр_raw);
		КонецЕсли;
		
		СтруктураЗамечаний.ЗамРабВыгр = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамРабВыгр");
		СтруктураЗамечаний.ЗамечанияВодителя = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(СтруктураЗамечаний, Истина);
		
	КонецЕсли;
	
	Возврат СтруктураЗамечаний;
	
КонецФункции

Функция СодИнфПрвXDTO(ДокументXDTO, ТипТитула)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2") Тогда 
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодИнфПрвПрием");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодПрвВыд");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7") Тогда
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодПрвВыд");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8") Тогда
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодИнфЗамен");
		
