		Если Не ЗначениеЗаполнено(Перевозчик.ИдентификаторУчастникаЭДО) Тогда
			
			ОрганизацииБезИДУчастникаЭДО.Вставить(Перевозчик, Перевозчик);
			
			КонтурЛогистика_ПанельОшибокСервер.УдалитьВТаблицеОшибок(ТаблицаОшибок, "Перевозчик");
			
			ТекстОшибки = "Перевозчик, " + Перевозчик + ", ещё не подключен к ЭДО.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Перевозчик", КатегорияОшибка, ТекстОшибки, "Пригласить в ЭДО");
			
		ИначеЕсли Не Перевозчик.ЕстьВСервисеЛогистика Тогда
			
			ТекстОшибки = "Перевозчик, " + Перевозчик + ", ещё не подключен к сервису Логистика.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Перевозчик", КатегорияОшибка, ТекстОшибки, "Отправить приглашение");
			
		ИначеЕсли Не Перевозчик.ПродуктивТрн Тогда
			
			ТекстОшибки = "Перевозчик, " + Перевозчик + ", работает в тестовом режиме. "
				+ "Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"Перевозчик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацииБезИДУчастникаЭДО;
	
КонецФункции

Процедура Валидатор_ПЛ_ПроверитьРегистрациюЛицВЛогистике(Знач Оформитель, Знач Медик, Знач Техник, Знач Одометр, Знач ТаблицаОшибок)
	
