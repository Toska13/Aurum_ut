	КонецЕсли;
	
	// Грузополучатель
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		
		Если Не ЗначениеЗаполнено(Грузополучатель.ИдентификаторУчастникаЭДО) Тогда
			
			ОрганизацииБезИДУчастникаЭДО.Вставить(Грузополучатель, Грузополучатель);
			
			КонтурЛогистика_ПанельОшибокСервер.УдалитьВТаблицеОшибок(ТаблицаОшибок, "ГлавныйДокумент.Грузополучатель");
			
			ТекстОшибки = "Грузополучатель, " + Грузополучатель + ", ещё не подключен к ЭДО.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Грузополучатель", КатегорияОшибка, ТекстОшибки, "Пригласить в ЭДО");
			
		ИначеЕсли Не Грузополучатель.ЕстьВСервисеЛогистика Тогда 
			
			ТекстОшибки = "Грузополучатель, " + Грузополучатель + ", впервые будет работать с ЭПД в сервисе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Грузополучатель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		ИначеЕсли Не Грузополучатель.ПродуктивТрн Тогда
			
			ТекстОшибки = "Грузополучатель, " + Грузополучатель + ", работает в тестовом режиме. "
				+ "Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Грузополучатель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// ЛОП
	Если ЗначениеЗаполнено(ЛОП) Тогда
		
		Если Не ЗначениеЗаполнено(ЛОП.ИдентификаторУчастникаЭДО) Тогда
			
			ОрганизацииБезИДУчастникаЭДО.Вставить(ЛОП, ЛОП);
			
			КонтурЛогистика_ПанельОшибокСервер.УдалитьВТаблицеОшибок(ТаблицаОшибок, "ГлавныйДокумент.ЛОП");
			
