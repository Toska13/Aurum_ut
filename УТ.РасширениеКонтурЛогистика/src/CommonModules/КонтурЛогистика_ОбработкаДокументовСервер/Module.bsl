// выполняет транспорт 
// всех неотправленны файлов КонтурЛогистика_ФайлыОбмена у которых
// у титула транспортный статус КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
Процедура ОтправитьВсеФайлыОжидающиеОтправки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка,
	               |	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент КАК СвязанныйДокумент
	               |ПОМЕСТИТЬ ВТ_ФайлыКОтправке
	               |ИЗ
	               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	               |ГДЕ
	               |	НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	               |	И (КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправленПодписан)
	               |			ИЛИ КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправлен))
	               |	И (НЕ КонтурЛогистика_ФайлыОбмена.ОтправительШаблона = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)
	               |			ИЛИ (НЕ КонтурЛогистика_ФайлыОбмена.ТребуетсяПодпись
	               |				ИЛИ КонтурЛогистика_ФайлыОбмена.ПодписьВерна))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ФайлыКОтправке.Ссылка КАК ФайлСсылка,
	               |	ВТ_ФайлыКОтправке.СвязанныйДокумент КАК ТитулСсылка,
	               |	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК СтатусТитула
	               |ИЗ
	               |	ВТ_ФайлыКОтправке КАК ВТ_ФайлыКОтправке
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних(
	               |				,
	               |				Документ В
	               |					(ВЫБРАТЬ
	               |						ВТ_ФайлыКОтправке.СвязанныйДокумент КАК СвязанныйДокумент
	               |					ИЗ
	               |						ВТ_ФайлыКОтправке КАК ВТ_ФайлыКОтправке)) КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	               |		ПО ВТ_ФайлыКОтправке.СвязанныйДокумент = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
	               |ГДЕ
	               |	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Подписан)";
	
	Результат = Запрос.Выполнить();
	МассивСсылокНаФайлы = Результат.Выгрузить().ВыгрузитьКолонку("ФайлСсылка");
	
	ОтправитьФайлыВДиадок(МассивСсылокНаФайлы);	
	
КонецПроцедуры

Процедура ОтправитьВсеДокументыБезФайловОжидающиеОтправки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ КАК Документ,
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|ГДЕ
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = Значение(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
	|	И НЕ КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ.ПометкаУдаления";
	
	
	Результат = Запрос.Выполнить();
	МассивДокументовЛогистика = Результат.Выгрузить().ВыгрузитьКолонку("Документ");
	
	РезультатФормированияФайлов = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьФайлыОбменаПоМассивуДокументов(МассивДокументовЛогистика);	
	МассивФайловОбмена = РезультатФормированияФайлов.МассивФайловОбмена;
	
	Если МассивФайловОбмена.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(МассивФайловОбмена);
		Если НЕ РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОтветМинтранса(ФайлОбменаСсылка, ТекстJSONОтветМинтранса, ЗачечанияОбработаны)
	
	Попытка
		
		ГлавныйДокумент = ФайлОбменаСсылка.ГлавныйДокумент;
		
		Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(ФайлОбменаСсылка.СвязанныйДокумент) Тогда 
			УИД = ГлавныйДокумент.УИД_Зак;
		ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
			УИД = ГлавныйДокумент.УИД_ПЛ;
		Иначе	
			УИД = ГлавныйДокумент.УИД;
		КонецЕсли;
		
		СтруктураJSON = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().ПарсерJSON_Прочитать(ТекстJSONОтветМинтранса);
		
		Если Не ЗначениеЗаполнено(УИД) Тогда
			
			Если СтруктураJSON.requestStatus = 5000 Тогда
				
				ДобавитьУИДМинтрансаВЭТрНИТитул(ГлавныйДокумент, СтруктураJSON.uid);
				
			ИначеЕсли ЭтоСтатусМинтрансаОшибка(СтруктураJSON.requestStatus) Тогда
				
				ДобавитьОшибкуМинтрансаВТитул(ФайлОбменаСсылка, СтруктураJSON);
				
			КонецЕсли;
			
		Иначе
			
			Если СтруктураJSON.requestStatus = 5000 И УИД = СтруктураJSON.uid Тогда 
				
				// ничего делать не нужно, все хорошо
				
			ИначеЕсли СтруктураJSON.requestStatus = 5000 И Не УИД = СтруктураJSON.uid Тогда
				
				// произошло изменение УИД Минтранса, такого быть не должно
				
				//ВызватьИсключение "УИД в ЭТРН " + УИД+ " отличается от УИД, пришедшего от Минтранса";
				
			ИначеЕсли ЭтоСтатусМинтрансаПредупреждение(СтруктураJSON.requestStatus) Тогда
				
				ДобавитьПредупреждениеМинтрансаВТитул(ФайлОбменаСсылка, СтруктураJSON);
				
			ИначеЕсли ЭтоСтатусМинтрансаОшибка(СтруктураJSON.requestStatus) Тогда
				
				// Пришла ошибка от Минтранса, когда документооборот уже идет или завершен
				// удаляем все титулы и файлы до первого титула, в первом титуле ставим ошибку в файл и титул.
				// Кроме Т5 и Т6 ЭТрН
				
				ТаблицаФайлов = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиВсеФайлыПоГлавномуДокументу(ГлавныйДокумент); 
				
				Для Каждого Файл Из ТаблицаФайлов Цикл
					
					Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
						Или ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
						
						Если Файл.НомерТитула = 5 Или Файл.НомерТитула = 6 Тогда
							УдалитьФайлыИТитулы = Ложь;
							ДобавитьОшибкуМинтрансаВТитул(Файл.Ссылка, СтруктураJSON, УдалитьФайлыИТитулы);
						КонецЕсли;
						
					Иначе
						
						УдалитьФайлыИТитулы = (Не Файл.НомерТитула = 1);
						ДобавитьОшибкуМинтрансаВТитул(Файл.Ссылка, СтруктураJSON, УдалитьФайлыИТитулы);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗачечанияОбработаны = Истина;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Обработка ответа Минтранса.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоСтатусМинтрансаУспешный(requestStatus)
	
	МассивУспешныхСтатусов = Новый Массив;
	МассивУспешныхСтатусов.Добавить(1000211000);
	МассивУспешныхСтатусов.Добавить(1000211050);
	МассивУспешныхСтатусов.Добавить(2000211000);
	МассивУспешныхСтатусов.Добавить(4000211000);
	МассивУспешныхСтатусов.Добавить(4000211050);
	МассивУспешныхСтатусов.Добавить(5000);
	МассивУспешныхСтатусов.Добавить(5009);
	
	ОписаниеТипа = Новый ОписаниеТипов("Число");
		
	Если МассивУспешныхСтатусов.Найти(ОписаниеТипа.ПривестиЗначение(requestStatus)) <> Неопределено Тогда 
		ЭтоУспешный = Истина;
	Иначе 
		ЭтоУспешный = Ложь;
	КонецЕсли;
	
	Возврат ЭтоУспешный;
	
