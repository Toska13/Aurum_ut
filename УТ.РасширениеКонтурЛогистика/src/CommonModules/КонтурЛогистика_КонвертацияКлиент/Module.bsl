// конвертация справочников

Процедура ПерейтиКНастройкеКонвертацииСправочника(Форма) Экспорт 
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбработчикПоказаВыбораЭлемента", 
		КонтурЛогистика_КонвертацияКлиент, 
		Новый Структура("Форма", Форма));
	
	Форма.СписокНастроекКонвертации.ПоказатьВыборЭлемента(
		ОписаниеОповещения,
		"Выберите настройку конвертации справочников");
	
КонецПроцедуры

Процедура СоздатьНастройкуКонвертации(Форма) Экспорт 
	
	ПараметрыФормы = Новый Структура("ТипСправочникаЛогистика", "КонтурЛогистика_Договоры");
	
	ОткрытьФормуЭлементаНастроекКонвертации(Форма, ПараметрыФормы);
		
КонецПроцедуры

Процедура ОбработчикПоказаВыбораЭлемента(Результат, ДопПараметры) Экспорт
	
	Если Не Результат = Неопределено И ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда 
		
		ПараметрыФормы = Новый Структура("Ключ", Результат.Значение);
	
		ОткрытьФормуЭлементаНастроекКонвертации(ДопПараметры.Форма, ПараметрыФормы);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОткрытьФормуЭлементаНастроекКонвертации(Форма, ПараметрыФормы)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаЭлемента",
		ПараметрыФормы,
		Форма,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры	

Процедура ОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник) Экспорт 
	
	Если ИмяСобытия = "ПослеЗаписиНастроекКонвертацииСправочников" Тогда 
		
		ОбработчикЗакрытияФормыКонвертации(Форма, Параметр);		
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработчикЗакрытияФормыКонвертации(Форма, Параметр) 
	
	Если ЗначениеЗаполнено(Форма.НастройкаКонвертации) Тогда
			
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьСписокНастроекКонвертации(Форма.СписокНастроекКонвертации, Параметр);
		УправлениеВидимостьюЭлементовФормы(Форма);
		
		Форма.ОбновитьОтображениеДанных();
		
	Иначе 
		
		Форма.Элементы.ПерейтиКНастройкеКонвертацииСправочника.Видимость 	= Ложь;
		Форма.Элементы.НастройкаКонвертацииСправочника.Видимость 			= Ложь;
		Форма.Элементы.КартинкаНастройкиКонвртацииСоздать.Видимость 		= Ложь;
		Форма.Элементы.СоздатьНастройкуКонвертации.Видимость 				= Ложь;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеВидимостьюЭлементовФормы(Форма)
	
	Элементы = Форма.Элементы;
	
	СписокНастроекКонвертации = Форма.СписокНастроекКонвертации;
	
	Элементы.ПерейтиКНастройкеКонвертацииСправочника.Видимость 	= Ложь;
	Элементы.НастройкаКонвертацииСправочника.Видимость 			= Ложь;
	Элементы.КартинкаНастройкиКонвртацииСоздать.Видимость 		= Ложь;
	Элементы.СоздатьНастройкуКонвертации.Видимость 				= Ложь;
	
	Если Форма.СписокНастроекКонвертации.Количество() > 1 Тогда 
		
		Элементы.ПерейтиКНастройкеКонвертацииСправочника.Видимость = Истина;
		
		Элементы.ПерейтиКНастройкеКонвертацииСправочника.Заголовок = "Найдено " + СписокНастроекКонвертации.Количество() + " настройки конвертации. Нажмите для перехода к нужной";
		
	ИначеЕсли СписокНастроекКонвертации.Количество() = 1 Тогда	
		
		Элементы.НастройкаКонвертацииСправочника.Видимость = Истина;
		
		Форма.НастройкаКонвертацииСправочника = Форма.СписокНастроекКонвертации[0].Значение;
		
	Иначе
		
		Элементы.КартинкаНастройкиКонвртацииСоздать.Видимость 	= Истина;
		Элементы.СоздатьНастройкуКонвертации.Видимость 			= Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьСоответствияНоменклатуры(текНоменклатура, текЕдиница, текХарактеристика, Форма) Экспорт
	
	Если ЗначениеЗаполнено(текНоменклатура) Тогда

		СтруктураЗаписиОтбора = Новый Структура();
		СтруктураЗаписиОтбора.Вставить("Номенклатура", текНоменклатура);
		
		ВведеноСоответствийНоменклатуры = КонтурЛогистика_КонвертацияСервер.КоличествоСоответствийНоменклатуры(СтруктураЗаписиОтбора);
		
		Если ВведеноСоответствийНоменклатуры > 1 Тогда

			СтруктураЗаписиОтбора.Вставить("Сопоставление", Истина);			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Форма.ФормаНабораЗаписей",
																		   СтруктураЗаписиОтбора,
																		   Форма,
																		   Форма,
																		   "ОбработчикИзмененияСоответствий",
																		   текНоменклатура);

		 ИначеЕсли ВведеноСоответствийНоменклатуры = 1 Тогда
			 
			КлючПервогоСоответствияНоменклатуры = КонтурЛогистика_КонвертацияСервер.КлючПервогоСоответствияНоменклатуры(СтруктураЗаписиОтбора);
				
			СтруктураЗаписиОтбора.Вставить("Номенклатура", КлючПервогоСоответствияНоменклатуры.Номенклатура);
			СтруктураЗаписиОтбора.Вставить("УпаковкаЕдиницаИзмерения", КлючПервогоСоответствияНоменклатуры.УпаковкаЕдиницаИзмерения);
			СтруктураЗаписиОтбора.Вставить("Характеристика", КлючПервогоСоответствияНоменклатуры.Характеристика);
			
			МассивСтруктурЗаписи = Новый Массив;
			МассивСтруктурЗаписи.Добавить(СтруктураЗаписиОтбора);
			КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.КонтурЛогистика_БазовыеСоответствияНоменклатуры", МассивСтруктурЗаписи);
			
			ПараметрыФормыЗаписи = Новый Структура("Ключ", КлючЗаписи);
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Форма.ФормаЗаписи",
																			   ПараметрыФормыЗаписи,
																			   Форма,
																			   Форма,
																			   "ОбработчикИзмененияСоответствий",
																			   текНоменклатура);

			
		Иначе // ВведеноСоответствийНоменклатуры = 0

			СтруктураЗаписиОтбора.Вставить("Сопоставление", Истина);
			
			Если ЗначениеЗаполнено(текЕдиница) Тогда 
				СтруктураЗаписиОтбора.Вставить("УпаковкаЕдиницаИзмерения", текЕдиница);
			КонецЕсли;
			Если ЗначениеЗаполнено(текХарактеристика) Тогда 
				СтруктураЗаписиОтбора.Вставить("Характеристика", текХарактеристика);
			КонецЕсли;

			
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Форма.ФормаЗаписи",
																		   СтруктураЗаписиОтбора,
																		   Форма,
																		   Форма,
																		   "ОбработчикИзмененияСоответствий",
																		   текНоменклатура);

																		   
		КонецЕсли;

	КонецЕсли;																	   
	
КонецПроцедуры

Процедура КонвертироватьОбъектСправочникаЛогистикиВОбъектУС(Форма, НастройкаКонвертацииСправочника) Экспорт 
	
	ЭлСправочникаУС = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_КонвертироватьОбъектЛогистикиВОбъектУС(
		НастройкаКонвертацииСправочника, Форма.Объект.Ссылка, Новый Структура);
		
	Если ТипЗнч(ЭлСправочникаУС) = Тип("Структура")
		И ЭлСправочникаУС.Свойство("ОписаниеОшибки") Тогда
		Сообщить(ЭлСправочникаУС.ОписаниеОшибки);
		Возврат;		
	КонецЕсли;
	
	НайденныеСвязанныеОбъекты = Форма.Объект.СвязанныеОбъекты.НайтиСтроки(Новый Структура("СвязанныйОбъект", ЭлСправочникаУС));
	Если ЗначениеЗаполнено(ЭлСправочникаУС) и НайденныеСвязанныеОбъекты.Количество() = 0 Тогда 
		НоваяСтрока = Форма.Объект.СвязанныеОбъекты.Добавить();
		НоваяСтрока.СвязанныйОбъект = ЭлСправочникаУС;
		
		Форма.Модифицированность = Истина;
	КонецЕсли;
			
КонецПроцедуры
