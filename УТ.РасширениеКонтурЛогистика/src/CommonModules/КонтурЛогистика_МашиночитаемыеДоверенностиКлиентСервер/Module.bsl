Функция КодОшибкиСтатусаПолномочияМЧД() Экспорт
	Возврат "Полномочия";
КонецФункции

Функция СписокМЧДИзАрхива(Путь, МЧД = Неопределено) Экспорт
			
	ВременныйКаталог = ПолучитьИмяВременногоФайла() + ПолучитьРазделительПути();
	СоздатьКаталог(ВременныйКаталог);
	
	Попытка
		ЧтениеZipФайла = Новый ЧтениеZipФайла(Путь);
		ЧтениеZipФайла.ИзвлечьВсе(ВременныйКаталог);
		ЧтениеZipФайла.Закрыть();
	Исключение
		
		Ошибка			= ИнформацияОбОшибке();
		ПодробнаяОшибка	= ПодробноеПредставлениеОшибки(Ошибка);
		
		Сообщить(ПодробнаяОшибка);
		
	КонецПопытки;
	
	СписокМЧД = Новый СписокЗначений;
	
	Файлы = НайтиФайлы(ВременныйКаталог, "*", Истина);
	
	Если Файлы.Количество() = 2 Тогда
		
		ФайлXML = Неопределено;
		ФайлПодписи = Неопределено;
		
		Для каждого Файл Из Файлы Цикл
			
			Если Файл.Расширение = ".xml" Тогда
				ФайлXML = Файл;
			ИначеЕсли КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.ФайлСРасширениемПодписи(Файл) Тогда
				ФайлПодписи = Файл;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ФайлXML <> Неопределено И ФайлПодписи <> Неопределено Тогда
			ДвоичныеДанныеДоверенности = Новый ДвоичныеДанные(ФайлXML.ПолноеИмя);
			ДвоичныеДанныеПодписи = Новый ДвоичныеДанные(ФайлПодписи.ПолноеИмя);
			СписокМЧД.Добавить(Новый Структура("ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи", ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи), Файл.ИмяБезРасширения);
		КонецЕсли;			
		
	Иначе
	
				
		ФайлыXML = НайтиФайлы(ВременныйКаталог, "*.xml", Истина);
				
		Для каждого Файл Из ФайлыXML Цикл
			
			Если Лев(ВРег(Файл.Имя), 8) = "ON_EMCHD" Или Лев(ВРег(Файл.Имя), 8) = "ON_DOVEL" Или Лев(ВРег(Файл.Имя), 8) = "ON_DOVBB" Тогда
				
				Если ЗначениеЗаполнено(МЧД) Тогда
					
					Если Найти(Файл.Имя, МЧД.ИдентификаторДоверенности) = 0 Тогда
						Продолжить;	
					КонецЕсли;
					
				КонецЕсли;
				
				КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.ДобавитьМЧДВСписок(Файл, СписокМЧД, ВременныйКаталог);
				
			Иначе
				
				// Проверим МЧД по содержимому xml	
				Попытка
					
					ДвоичныеДанныеДоверенности = Новый ДвоичныеДанные(Файл.ПолноеИмя);
					
					ДанныеДоверенности = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПолучитьДанныеМЧДИзДвоичныхДанных(ДвоичныеДанныеДоверенности);
					
					Если Не ЗначениеЗаполнено(ДанныеДоверенности) Тогда
						Продолжить;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(МЧД) Тогда
					
						Если ДанныеДоверенности.ИдентификаторДоверенности <> МЧД.ИдентификаторДоверенности Тогда
							Продолжить;	
						КонецЕсли;
						
					КонецЕсли;
					
					КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.ДобавитьМЧДВСписок(Файл, СписокМЧД, ВременныйКаталог);
					
				Исключение
					
					Продолжить;
					
				КонецПопытки;
				
			КонецЕсли;
					
		КонецЦикла;
		
	КонецЕсли;
		
	УдалитьВременныйКаталог(ВременныйКаталог);
	
	Возврат СписокМЧД;
	
КонецФункции

Процедура ДобавитьМЧДВСписок(Файл, СписокМЧД, Каталог) Экспорт

	ФайлXML = Файл;
	ФайлПодписи = НайтиФайлПодписиМЧД(Файл.ИмяБезРасширения, Каталог);
	
	Если ФайлПодписи = Неопределено Тогда
		Сообщить("У файла МЧД " + Файл.Имя + " нет файла подписи");
		Возврат;
	КонецЕсли;				
		
	ДвоичныеДанныеДоверенности = Новый ДвоичныеДанные(ФайлXML.ПолноеИмя);
	ДвоичныеДанныеПодписи = Новый ДвоичныеДанные(ФайлПодписи.ПолноеИмя);
	СписокМЧД.Добавить(Новый Структура("ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи", ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи), Файл.ИмяБезРасширения);

КонецПроцедуры

Функция НайтиФайлПодписиМЧД(ИмяФайлаМЧД, Каталог) Экспорт
	
	Файлы = НайтиФайлы(Каталог, "*", Истина);
	
	Для каждого Файл Из Файлы Цикл
		
		// Проверка (НРег(Файл.Имя) = НРег(ИмяФайлаМЧД + ".xml"), чтобы обработать случай: 
		//	ON_EMCHD_613dff97-b366-40aa-b870-5fda91336e86.xml       файл МЧД
		//	ON_EMCHD_613dff97-b366-40aa-b870-5fda91336e86.sgn       файл подписи - верный
		//	ИЛИ
		//	ON_EMCHD_613dff97-b366-40aa-b870-5fda91336e86.xml.sgn   файл подписи - верный
		
		Если ФайлСРасширениемПодписи(Файл)
			И (НРег(Файл.ИмяБезРасширения) = НРег(ИмяФайлаМЧД)
			Или НРег(Файл.ИмяБезРасширения) = НРег(ИмяФайлаМЧД + ".xml")) Тогда 
			
			Возврат Файл;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ФайлСРасширениемПодписи(Файл) Экспорт
	
	Если НРег(Файл.Расширение) = ".sig" Или НРег(Файл.Расширение) = ".p7s" Или НРег(Файл.Расширение) = ".sgn" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура УдалитьВременныйКаталог(ВременныйКаталог) 
	
	Попытка	
		
		Файлы = НайтиФайлы(ВременныйКаталог, "*", Истина);
		Для каждого ВыбФайл Из Файлы Цикл 
			Если ВыбФайл.ПолучитьТолькоЧтение() Тогда
				ВыбФайл.УстановитьТолькоЧтение(Ложь);
			КонецЕсли;	                           
		КонецЦикла;
		УдалитьФайлы(ВременныйКаталог);
		
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

