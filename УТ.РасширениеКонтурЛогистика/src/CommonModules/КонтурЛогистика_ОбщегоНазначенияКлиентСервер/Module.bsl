	Результат.Вставить("Опции", Опции);
	
	КлючПрод = "f2522ba9-10ee-5164-9409-1e10195a75b4";
	КлючТест = "b92b41db-e729-97b8-b1f9-9539101b57d2";
	
	Если ИспользоватьТестовыйСерверДиадок Тогда
		
		АдресТестовогоСервера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("АдресТестовогоLogisticsAPI");
		Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(АдресТестовогоСервера, "test") > 0 Тогда
