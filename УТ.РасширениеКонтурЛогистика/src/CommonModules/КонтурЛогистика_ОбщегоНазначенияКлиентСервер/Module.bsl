// Часовой пояс по коду региона
//
// Параметры:
//  ВходящийКодРегион	 - Строка	 - код региона.
// 
// Возвращаемое значение:
//  Строка - часовой пояс региона.
//
Функция ЧасовойПоясПоКодуРегиона(Знач ВходящийКодРегион) Экспорт
	
	КодРегион = СокрЛП(ВходящийКодРегион);
	
	КодРегион = КонтурЛогистика_СтдСтрКлиентСервер.ДополнитьСтрокуЛок(КодРегион, 2, "0");
	
	Если КодРегион = "39" Тогда
		
		ЧасовойПояс = "Europe/Kaliningrad";
		
	ИначеЕсли КодРегион = "01"
		Или КодРегион = "05"
