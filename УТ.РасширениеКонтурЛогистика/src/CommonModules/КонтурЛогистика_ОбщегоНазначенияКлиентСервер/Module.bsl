	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция КонфигурацияПровайдера(ИспользоватьТестовыйСерверДиадок) Экспорт
	
	ИмяСервера = "https://identity.kontur.ru";
	
	Если ИспользоватьТестовыйСерверДиадок Тогда
		
		АдресТестовогоСервера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("АдресТестовогоLogisticsAPI");
		Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(АдресТестовогоСервера, "test") > 0 Тогда
			ИмяСервера = "https://identity.testkontur.ru";
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Тип", "urn:ietf:params:oauth:grant-type:device_code");
	Результат.Вставить("Хост", ИмяСервера);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ОтборСессий(КлючОбъекта = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Если КлючОбъекта = Неопределено Тогда
		Результат.Вставить("КлючОбъекта", ПредопределенноеЗначение("Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка"));
	Иначе
		Результат.Вставить("КлючОбъекта", КлючОбъекта);
	КонецЕсли;
	Результат.Вставить("КлючНастроек", "ТокенДоступа");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

