Функция ПараметрыСообщения() Экспорт
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("КлючДанных",  Неопределено);
	Параметры.Вставить("Поле", 		  "");
	Параметры.Вставить("ПутьКДанным", "");
	Параметры.Вставить("Текст", 	  "");
	
	Возврат Параметры;
	
КонецФункции

Процедура ПоказатьСообщение(ПараметрыСообщения, ОбъектДанных = Неопределено) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	ЗаполнитьЗначенияСвойств(Сообщение, ПараметрыСообщения);
	Если ОбъектДанных <> Неопределено Тогда
		Сообщение.УстановитьДанные(ОбъектДанных);
	КонецЕсли;
	Сообщение.Сообщить();
	
КонецПроцедуры

