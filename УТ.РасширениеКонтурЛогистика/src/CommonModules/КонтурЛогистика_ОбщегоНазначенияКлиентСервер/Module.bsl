// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является простым типом данных
//
Функция ЭтоПростойТип(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Число") Тогда
		
		Результат = Истина
		
	Иначе
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
