Функция МассивСтруктур_Найти(МассивСтруктур, Значение, Ключ) Экспорт 
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(МассивСтруктур) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИскатьПоВсемКлючам			 = Ложь;
	ИскатьПоМассивуКлючей		 = Ложь;
	ИскатьВоВложенныхСтруктурах	 = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		
		ИскатьПоВсемКлючам = Истина;
		
	ИначеЕсли Найти(Ключ, ",") > 0 Тогда
		
		ИскатьПоМассивуКлючей = Истина;
		
	ИначеЕсли Найти(Ключ, ".") > 0 Тогда
		
		ИскатьВоВложенныхСтруктурах = Истина;
		
	КонецЕсли;
	
	Если ИскатьПоМассивуКлючей Тогда
		МассивКлючей = РазделитьСтроку(Ключ, ",");
	КонецЕсли;
	
	ЭлементНайден = Ложь;
	
	Для Каждого Элемент Из МассивСтруктур Цикл
		
		Если ИскатьПоМассивуКлючей Тогда
			
			Для каждого ТекущийКлюч Из МассивКлючей Цикл
				
				Если Элемент[ТекущийКлюч] = Значение Тогда
					Результат = Элемент;
					ЭлементНайден = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ИскатьПоВсемКлючам Тогда
			
			Для каждого КлючИЗначение Из Элемент Цикл
				
				Если КлючИЗначение.Значение = Значение Тогда
					Результат = Элемент;
					ЭлементНайден = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ИскатьВоВложенныхСтруктурах Тогда
			
			ТекущееЗначение = СвойствоСтруктуры(Элемент, Ключ);
			
			Если ТекущееЗначение = Значение Тогда
				Результат = Элемент;
				ЭлементНайден = Истина;
			КонецЕсли;
			
		Иначе
			
			Если Элемент[Ключ] = Значение Тогда
				Результат = Элемент;
				ЭлементНайден = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭлементНайден Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли строка уникальным идентификатором.
// В качестве уникального идентификатора предполагается строка вида
// "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX", где X = [0..9,a..f].
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если переданная строка является уникальным идентификатором.
//
Функция ЭтоУникальныйИдентификатор(Знач Значение) Экспорт
	
	Шаблон = "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX";
	
	Если СтрДлина(Шаблон) <> СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если КодСимвола(Шаблон, Позиция) = 88 // X
			И ((КодСимвола(Значение, Позиция) < 48 Или КодСимвола(Значение, Позиция) > 57) // 0..9
			И (КодСимвола(Значение, Позиция) < 97 Или КодСимвола(Значение, Позиция) > 102) // a..f
			И (КодСимвола(Значение, Позиция) < 65 Или КодСимвола(Значение, Позиция) > 70)) // A..F
			Или КодСимвола(Шаблон, Позиция) = 45 И КодСимвола(Значение, Позиция) <> 45 Тогда // -
				Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПараметрыИзСтроки(Знач СтрокаПараметров, Знач Разделитель = ";") Экспорт
	Результат = Новый Структура;
	
	ОписаниеПараметра = "";
	НайденоНачалоСтроки = Ложь;
	НомерПоследнегоСимвола = СтрДлина(СтрокаПараметров);
	Для НомерСимвола = 1 По НомерПоследнегоСимвола Цикл
		Символ =Сред(СтрокаПараметров, НомерСимвола, 1);
		Если Символ = """" Тогда
			НайденоНачалоСтроки = Не НайденоНачалоСтроки;
		КонецЕсли;
		Если Символ <> Разделитель Или НайденоНачалоСтроки Тогда
			ОписаниеПараметра = ОписаниеПараметра + Символ;
		КонецЕсли;
		Если Символ = Разделитель И Не НайденоНачалоСтроки Или НомерСимвола = НомерПоследнегоСимвола Тогда
			Позиция = Найти(ОписаниеПараметра, "=");
			Если Позиция > 0 Тогда
				ИмяПараметра = СокрЛП(Лев(ОписаниеПараметра, Позиция - 1));
				ЗначениеПараметра = СокрЛП(Сред(ОписаниеПараметра, Позиция + 1));
				ЗначениеПараметра = СократитьДвойныеКавычки(ЗначениеПараметра);
				Результат.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
			ОписаниеПараметра = "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция СократитьДвойныеКавычки(Знач Значение) Экспорт
	
	КоличествоСимволовПоиска = 1;
	ЧислоСимволовОтступа = 2;
	
	Пока Лев(Значение, КоличествоСимволовПоиска) = """" Цикл
		Значение = Сред(Значение, ЧислоСимволовОтступа); 
	КонецЦикла; 
	
	Пока Прав(Значение, КоличествоСимволовПоиска) = """" Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции

// Округлить плотность, так как по формату N(5.2), а в 1С 7.2
//
// Параметры:
//  Плотность	 - Число	 - плотность
// 
// Возвращаемое значение:
//  Число - округленное значение плотности, если требуется
//
Функция ОкруглитьПлотность(Знач Плотность) Экспорт
	
	Попытка
		Если СтрДлина(СтрЗаменить(Формат(Плотность, "ЧГ="), ",", "")) > 5 Тогда
			ДлинаЦелойЧасти = СтрДлина(Формат(Цел(Плотность), "ЧГ="));
			Возврат Окр(Плотность, 5 - ДлинаЦелойЧасти);
		Иначе
			Возврат Плотность;
		КонецЕсли;
	Исключение
		Возврат Плотность;
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьАрхивВКаталог(Архив, Каталог, ГлавныйДокумент, РазбитьПоОрганизациям = Ложь) Экспорт
	
	ДанныеДокумента = Новый Структура("Номер, Дата");
	
	ТипДокумента = ТипЗнч(ГлавныйДокумент);
	ЭтоЭТрН = ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная");
	ЭтоЭПЛ = ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1");
	
	Если ЭтоЭТрН Тогда
		
		ТекущиеДанныеДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ГлавныйДокумент, "НомерТрН, ДатаТрН");
		ДанныеДокумента.Номер = ТекущиеДанныеДокумента.НомерТрН;
		ДанныеДокумента.Дата = ТекущиеДанныеДокумента.ДатаТрН;
		
		ПрефиксИмениФайла = "ЭТрН";
		
	ИначеЕсли ЭтоЭПЛ Тогда
		
		ТекущиеДанныеДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ГлавныйДокумент, "НомерПЛ, ДатаПЛ, Дата");
		
		Если ЗначениеЗаполнено(ТекущиеДанныеДокумента.НомерПЛ) Тогда
			ДанныеДокумента.Номер = ТекущиеДанныеДокумента.НомерПЛ;
		Иначе
			ДанныеДокумента.Номер = "Без номера";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущиеДанныеДокумента.ДатаПЛ) Тогда
			ДанныеДокумента.Дата = ТекущиеДанныеДокумента.ДатаПЛ;
		Иначе
			ДанныеДокумента.Дата = ТекущиеДанныеДокумента.Дата;
		КонецЕсли;
		
		ПрефиксИмениФайла = "ЭПЛ";
		
	Иначе
		
		ДанныеДокумента.Номер = "";
		ДанныеДокумента.Дата = "";
		
		ПрефиксИмениФайла = "";
		
	КонецЕсли;
	
	ПодкаталогМесяц = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьПодкаталогАрхиваМесяц(ДанныеДокумента.Дата);
	
	ИмяФайла = КонтурЛогистика_ОбработкаДокументовСервер.ИмяАрхива(ПрефиксИмениФайла, ДанныеДокумента.Номер, ДанныеДокумента.Дата);
	
	Если Не РазбитьПоОрганизациям Тогда
		Архив.Записать(Каталог + ПодкаталогМесяц + "\" + ИмяФайла);
	КонецЕсли;
	
	// Разбиваем по организациям
	Если ЭтоЭТрН Тогда
		
		ПодкаталогГрузоотправитель = КонтурЛогистика_ОбработкаДокументовСервер.ПодкаталогОрганизации(ГлавныйДокумент, "Грузоотправитель");
		Если ЗначениеЗаполнено(ПодкаталогГрузоотправитель) Тогда
			Архив.Записать(Каталог + ПодкаталогГрузоотправитель + ПодкаталогМесяц + "\" + ИмяФайла);
		КонецЕсли;
		
		ПодкаталогПеревозчик = КонтурЛогистика_ОбработкаДокументовСервер.ПодкаталогОрганизации(ГлавныйДокумент, "Перевозчик");
		Если ЗначениеЗаполнено(ПодкаталогПеревозчик) Тогда
			Архив.Записать(Каталог + ПодкаталогПеревозчик + ПодкаталогМесяц + "\" + ИмяФайла);
		КонецЕсли;
		
		ПодкаталогГрузополучатель = КонтурЛогистика_ОбработкаДокументовСервер.ПодкаталогОрганизации(ГлавныйДокумент, "Грузополучатель");
		Если ЗначениеЗаполнено(ПодкаталогГрузополучатель) Тогда
			Архив.Записать(Каталог + ПодкаталогГрузополучатель + ПодкаталогМесяц + "\" + ИмяФайла);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоЭПЛ Тогда
		
		ПодкаталогЛицоОформившееПЛ = КонтурЛогистика_ОбработкаДокументовСервер.ПодкаталогОрганизации(ГлавныйДокумент, "ЛицоОформившееПЛ");
		Если ЗначениеЗаполнено(ПодкаталогЛицоОформившееПЛ) Тогда
			Архив.Записать(Каталог + ПодкаталогЛицоОформившееПЛ + ПодкаталогМесяц + "\" + ИмяФайла);
		КонецЕсли;
		
		ПодкаталогГрузоотправитель = КонтурЛогистика_ОбработкаДокументовСервер.ПодкаталогОрганизации(ГлавныйДокумент, "Грузоотправитель");
		Если ЗначениеЗаполнено(ПодкаталогГрузоотправитель) Тогда
			Архив.Записать(Каталог + ПодкаталогГрузоотправитель + ПодкаталогМесяц + "\" + ИмяФайла);
		КонецЕсли;
		
		ПодкаталогОрганизацияМедик = КонтурЛогистика_ОбработкаДокументовСервер.ПодкаталогОрганизации(ГлавныйДокумент, "ОрганизацияМедик");
		Если ЗначениеЗаполнено(ПодкаталогОрганизацияМедик) Тогда
			Архив.Записать(Каталог + ПодкаталогОрганизацияМедик + ПодкаталогМесяц + "\" + ИмяФайла);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УбратьНедопустимыеСимволыФС(Строка) Экспорт
	
	НедопустимыеСимволы = Новый Массив;
	НедопустимыеСимволы.Добавить("<");
	НедопустимыеСимволы.Добавить(">");
	НедопустимыеСимволы.Добавить(":");
	НедопустимыеСимволы.Добавить(Символ(34));
	НедопустимыеСимволы.Добавить("\");
	НедопустимыеСимволы.Добавить("/");
	НедопустимыеСимволы.Добавить("|");
	НедопустимыеСимволы.Добавить("?");
	
	Для каждого Симв Из НедопустимыеСимволы Цикл
		Строка = СтрЗаменить(Строка, Симв, "");	
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции

Функция ПодписантСтруктура(Объект) Экспорт
	
	РезультатВыбораОрганизацииПодписанта = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьОрганизациюПодписантаИДатуПодписи(Объект);
	ДатаГлавного = РезультатВыбораОрганизацииПодписанта.ДатаГлавного;
    ОрганизацияГлавного = РезультатВыбораОрганизацииПодписанта.ОрганизацияГлавного;
	
	ПользовательПодписант = Объект.ПользовательПодписант;
	ПараметрНастроекПодписания = Объект.ПараметрНастроекПодписания;
	ПодписантСтруктура 	= КонтурЛогистика_ОбработкаДокументовСервер.ВыбратьПодписанта(
		ОрганизацияГлавного, ПользовательПодписант, ДатаГлавного, Объект, ПараметрНастроекПодписания);
		
	ПодписантСтруктура.Вставить("ОрганизацияГлавного", ОрганизацияГлавного);
		
	Возврат ПодписантСтруктура;
	
КонецФункции

Функция ЭтоПримитивныйТип(ПроверяемыйТип) Экспорт
	
	ПримитивныеТипы = Новый Массив;
	ПримитивныеТипы.Добавить(Тип("Булево"));
	ПримитивныеТипы.Добавить(Тип("Строка"));
	ПримитивныеТипы.Добавить(Тип("Дата"));
	ПримитивныеТипы.Добавить(Тип("Число"));
	
	ЭтоПримитивныйТип = ПримитивныеТипы.Найти(ПроверяемыйТип) <> Неопределено;
	
	Возврат ЭтоПримитивныйТип;
	
КонецФункции

Функция СтрокаИзЧисел(Значение) Экспорт

    Если СтрДлина(Значение) = 0 Тогда
        Возврат "";
    КонецЕсли;

    РезультатЧисло = "";
	Для инд = 1 по СтрДлина(Значение) Цикл
		
        Символ = Сред(Значение, инд, 1);

        Если Найти("0123456789", Символ) = 0 Тогда
            Продолжить;
        КонецЕсли;

        РезультатЧисло = "" + РезультатЧисло + Символ;
		
    КонецЦикла;

    Возврат РезультатЧисло;

КонецФункции

Функция ЗначениеВФорматеСНИЛС(Значение) Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоФорматСНИЛС = Истина;
	
	Если СтрДлина(Значение) = 14 И Сред(Значение, 4, 1) = "-" И Сред(Значение, 8, 1) = "-" И Сред(Значение, 12, 1) = " " Тогда
		
		Для Индекс = 1 По СтрДлина(Значение) Цикл
			
			Если Индекс = 4 Или Индекс = 8 Или Индекс = 12 Тогда
				Продолжить;
			КонецЕсли;
			
			СимволИзСНИЛС = Сред(Значение, Индекс, 1);
			
			Если Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоЧисло(СимволИзСНИЛС) Тогда
				ЭтоФорматСНИЛС = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ЭтоФорматСНИЛС = Ложь;	
		
	КонецЕсли;
	
	Возврат ЭтоФорматСНИЛС;
	
КонецФункции

Функция ПривестиЗначениеКФорматуСНИЛС(Значение) Экспорт
	
	СтрокаИзЧисел = СтрокаИзЧисел(Значение);
	
	Если СтрДлина(СтрокаИзЧисел) <> 11 Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Лев(СтрокаИзЧисел, 3) + "-" + Сред(СтрокаИзЧисел, 4, 3) + "-" + Сред(СтрокаИзЧисел, 7, 3)  + " " + Прав(СтрокаИзЧисел, 2);
	
КонецФункции

