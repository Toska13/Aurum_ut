#КонецОбласти

#Область НетиповыеСправочникиВСвязанныхОбъектах

Функция ДанныеДляДобавленияСвязанногоОбъекта(СвязанныйОбъект) Экспорт
	
	Данные = Новый Структура;
	
	Данные.Вставить("УИД", СвязанныйОбъект.УникальныйИдентификатор());
	Данные.Вставить("ТипЗначенияУИД", СвязанныйОбъект.Метаданные().ПолноеИмя());
	
	Возврат Данные;
	
КонецФункции

Процедура УстановитьСвязьОбъектовЛогистикаУчСист(ЭлементСправочника_Ссылка, ОбъектУчетнойСистемы) Экспорт
	
	ЭтоНетиповаяСсылка = КонтурЛогистика_КонвертацияСервер.ЭтоНетиповаяСсылкаДляСвязанногоОбъекта(
		ЭлементСправочника_Ссылка, ОбъектУчетнойСистемы);
	Если ЭтоНетиповаяСсылка Тогда
		УИД = ОбъектУчетнойСистемы.УникальныйИдентификатор();
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	Если ЭтоНетиповаяСсылка Тогда
		
		// Для нетиповой найдем по колонке УИД
		ПараметрыОтбора.Вставить("УИД", Строка(УИД));
		
	Иначе
		
		// Поищем по ссылке в колонке СвязанныйОбъект
		ПараметрыОтбора.Вставить("СвязанныйОбъект", ОбъектУчетнойСистемы);
		
	КонецЕсли;
	
	НайденныеСтроки = ЭлементСправочника_Ссылка.СвязанныеОбъекты.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() <> 0 Тогда
		// Уже есть связанный объект
		Возврат;
	КонецЕсли;
	
	// Добавим новый связанный объект
	ТекущийОбъект = ЭлементСправочника_Ссылка.ПолучитьОбъект();
	
	НоваяСвязь = ТекущийОбъект.СвязанныеОбъекты.Добавить();
	НоваяСвязь.СвязанныйОбъект = ОбъектУчетнойСистемы;
	
	Если ЭтоНетиповаяСсылка Тогда
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьДанныеДляНетиповогоСправочникаВСвязанныхОбъектах(
			НоваяСвязь, ОбъектУчетнойСистемы);
	КонецЕсли;
	
	ТекущийОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти
