			Выполнить("ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(" +
				"Метаданные.РегламентныеЗадания.КонтурЛогистика_ПоискСозданиеСвязанныхДокументов)");
		КонецЕсли;
	Иначе
		КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.КонтурЛогистика_ПоискСозданиеСвязанныхДокументов);
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СвязиДокументов.ОбработатьОчередь();
	
КонецПроцедуры

Процедура КонтурЛогистика_ОтправкаМетрик() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Справочники.КонтурЛогистика_Настройки.НастройкиВыполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные("Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами") Тогда
		МетаданныеРЗ = Метаданные.РегламентныеЗадания.Найти("КонтурЛогистика_ОтправкаМетрик");
		Если МетаданныеРЗ = Неопределено Тогда
			Выполнить("ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания()");
		Иначе
			Выполнить("ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(" +
				"Метаданные.РегламентныеЗадания.КонтурЛогистика_ОтправкаМетрик)");
		КонецЕсли;
	Иначе
		КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.КонтурЛогистика_ОтправкаМетрик);
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ОтправитьМетрики();
	
КонецПроцедуры

Процедура ОтменитьВыполнениеЗадания(Знач РегламентноеЗадание, ТекстДляЖурнала) Экспорт
	
	ТекущийСеанс = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущийСеанс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РегламентноеЗадание = Неопределено Тогда
		Для Каждого Задание Из Метаданные.РегламентныеЗадания Цикл
			Если Задание.ИмяМетода = ТекущийСеанс.ИмяМетода Тогда
				РегламентноеЗадание = Задание;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если РегламентноеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
	ЗаписьЖурналаРегистрации(ИмяСобытия,
		УровеньЖурналаРегистрации.Предупреждение,
		РегламентноеЗадание,
		,
		"Отмена регламентного задания. " + Строка(ТекстДляЖурнала));
	
	ТекущийСеанс.Отменить();
	
КонецПроцедуры
