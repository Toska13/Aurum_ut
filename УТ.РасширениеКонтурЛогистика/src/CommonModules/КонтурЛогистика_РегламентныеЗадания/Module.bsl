// РЕГЛАМЕНТНЫЕ ЗАДАНИЯ КОНФИГУРАЦИИ 

Процедура КонтурЛогистика_ОчиститьУстаревшиеДанные() Экспорт
	
	// Момент "устаревания" файлов и документов задается в настройках 
	// КонтурЛогистика_Настройки.УдалятьДанныеЧерезДней
	
	// Варианты связи между собой ЭТрН, титула и Файла:
	// | N | ЭТрН | Титул | Файл |
	// | 1 |   +  |   +   |   +  |
	// | 2 |   +  |   +   |   -  |
	// | 3 |   +  |   -   |   +  |
	// | 4 |   +  |   -   |   -  |
	// | 5 |   -  |   +   |   +  |
	// | 6 |   -  |   -   |   +  |
	// | 7 |   -  |   +   |   -  |	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Справочники.КонтурЛогистика_Настройки.НастройкиВыполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные("Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами") Тогда
		МетаданныеРЗ = Метаданные.РегламентныеЗадания.Найти("КонтурЛогистика_ОчисткаУстаревшихДанных");
		Если МетаданныеРЗ = Неопределено Тогда
			Выполнить("ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания()");
		Иначе
			Выполнить("ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(" +
				"Метаданные.РегламентныеЗадания.КонтурЛогистика_ОчисткаУстаревшихДанных)");
		КонецЕсли;
	Иначе
		КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.КонтурЛогистика_ОчисткаУстаревшихДанных);
	КонецЕсли;
	
	КонтурЛогистика_ДлительныеОперацииСервер.УдалитьСтарыеДанные();
	
КонецПроцедуры

