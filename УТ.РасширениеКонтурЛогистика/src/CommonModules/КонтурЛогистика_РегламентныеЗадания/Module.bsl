// Заявки

Функция СформироватьПараметрыПотокаОбработкиЗаявок(ПланОбработкиЗаявок)
	
	ВыборкаЗаявок = ПланОбработкиЗаявок.Выбрать();
	
	//сформируем заявки которые попробуют отправиться в этом потоке
	ОграничениеЗаявокНаПоток = 50;
	Счетчик = 0;
	МассивЗаявок = Новый массив;
	Пока Счетчик < ОграничениеЗаявокНаПоток И ВыборкаЗаявок.Следующий() Цикл
		
		МассивЗаявок.Добавить(ВыборкаЗаявок.Ссылка);	
		
	КонецЦикла;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(МассивЗаявок);
	
	Возврат МассивПараметров;
	
КонецФункции

// ТипОперации - "Отправить" / "Проверить" / "Обработать"
Функция ПланОбработкиЗаявок(ТипОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_Заявки.IssuerID КАК IssuerID,
	               |	КонтурЛогистика_Заявки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Заявки КАК КонтурЛогистика_Заявки
	               |ГДЕ
	               |	НЕ КонтурЛогистика_Заявки.ПометкаУдаления
	               |	И НЕ КонтурЛогистика_Заявки.РезультатОбработан
	               |	И КонтурЛогистика_Заявки.Состояние В(&Состояния)
	               |	И (НЕ &ЭтоОтправка
	               |			ИЛИ КонтурЛогистика_Заявки.ДатаПланируемойОтправки <= &ТекущаяДатаМСК)
	               |	И НЕ КонтурЛогистика_Заявки.ТипЗаявки В (&НеприкладныеТипыСинхронизации)
	               |ИТОГИ ПО
	               |	IssuerID";
	
	Запрос.УстановитьПараметр("ЭтоОтправка",Ложь);
	Запрос.УстановитьПараметр("НеприкладныеТипыСинхронизации", Справочники.КонтурЛогистика_Заявки.МассивТиповНеприкладныхТиповЗаявокСинхронизации());
	Запрос.УстановитьПараметр("ТекущаяДатаМСК", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени());
	
	СписокСостояний = Новый Массив;
	Если ТипОперации = "Отправить" Тогда 
		Запрос.УстановитьПараметр("ЭтоОтправка",Истина);
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.НеОтправлена"));
		
	ИначеЕсли ТипОперации = "Проверить" Тогда 
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.ACCEPTED"));
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.IN_PROCESS"));
		
	ИначеЕсли ТипОперации = "Обработать" Тогда 
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.REJECTED"));
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.COMPLETED"));
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.ЗавершенаАварийноНеОтправлена"));
		СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СостоянияЗаявок.ЗавершенаАварийноОтправлена"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Состояния",СписокСостояний);
	
	Результат = Запрос.Выполнить();
	ВыборкаIssuerID = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "IssuerID");
	
	Возврат ВыборкаIssuerID;	

КонецФункции 

