// Служебные процедуры и функции

Процедура FF(a, b, c, d, X, s, t, СтруктураПременных)
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._AND(b, c, СтруктураПременных.EAX);
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._NOT(b, СтруктураПременных.EBX);
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._AND(СтруктураПременных.EBX, d, СтруктураПременных.ECX);
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._OR(СтруктураПременных.EAX, СтруктураПременных.ECX, СтруктураПременных.EBX);

	X1 = X + t;
	Если X1 >= СтруктураПременных.Stepen32 Тогда
		X1 = X1 - СтруктураПременных.Stepen32;
	КонецЕсли;
	Для инд = 0 По 31 Цикл
		инд1 = 31 - инд;
		Степ = СтруктураПременных.Степень[инд1];
		Если X1 >= Степ Тогда
			X1 = X1 - Степ;
			СтруктураПременных.EDX[инд1] = Истина;
		Иначе
			СтруктураПременных.EDX[инд1] = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._ADD(СтруктураПременных.EBX, a, СтруктураПременных.ECX);
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._ADD(СтруктураПременных.ECX, СтруктураПременных.EDX, СтруктураПременных.EAX);
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._ROL(СтруктураПременных.EAX, s, СтруктураПременных.ECX);
	
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	._ADD(СтруктураПременных.ECX, b, a);
	
КонецПроцедуры

