// Программный интерфейс

// Расчитать хеш MD5.
// 
// Параметры:
//  ДанныеДляХеширования - ДвоичныеДанные, Строка - Двоичные данные для хеш
// 
// Возвращаемое значение:
//  Строка - хеш MD5
Функция MD5Лок(Знач ДанныеДляХеширования) Экспорт
	СтруктураПременных = ИнициализацияСтруктурыПеременных();

	Если ТипЗнч(ДанныеДляХеширования) = Тип("Строка") Тогда
		ДанныеДляХеширования =
		КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
		.ПолучитьДвоичныеДанныеИзСтрокиЛок(ДанныеДляХеширования);
	КонецЕсли;

	СтруктураЧтениеДанных =
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	.ЧтениеДанных(ДанныеДляХеширования);

	Расчет(СтруктураПременных, СтруктураЧтениеДанных);
	СтруктураПременных.A = 0;
	СтруктураПременных.B = 0;
	СтруктураПременных.C = 0;
	СтруктураПременных.D = 0;

	Для i = 0 По 31 Цикл
		Степ = СтруктураПременных.Степень[i];
		Если СтруктураПременных.A_[i] Тогда
			СтруктураПременных.A = СтруктураПременных.A + Степ;
		КонецЕсли;

		Если СтруктураПременных.B_[i] Тогда
			СтруктураПременных.B = СтруктураПременных.B + Степ;
		КонецЕсли;

		Если СтруктураПременных.C_[i] Тогда
			СтруктураПременных.C = СтруктураПременных.C + Степ;
		КонецЕсли;

		Если СтруктураПременных.D_[i] Тогда
			СтруктураПременных.D = СтруктураПременных.D + Степ;
		КонецЕсли;
	КонецЦикла;

	Возврат НРег(
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	.Dec2Hex(СтруктураПременных.A, 8, Истина) +
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	.Dec2Hex(СтруктураПременных.B, 8, Истина) +
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	.Dec2Hex(СтруктураПременных.C, 8, Истина) +
	КонтурЛогистика_КоннекторHTTPДвоичныеДанные82Служебный
	.Dec2Hex(СтруктураПременных.D, 8, Истина)
	);
КонецФункции

