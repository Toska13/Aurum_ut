Функция ОписаниеСтруктурыProfile()
	
	Результат = Новый Структура;
	
	name = Новый Структура;
	name.Вставить("lastName");
	name.Вставить("firstName");
	name.Вставить("middleName");
	
	Результат.Вставить("name", name);
	
	Результат.Вставить("birthday");
	Результат.Вставить("snils");
	Результат.Вставить("inn");
	Результат.Вставить("phone");
	Результат.Вставить("email");
	
	Возврат Результат;
	
КонецФункции

