КонецФункции

Функция УдалитьФизическоеЛицо(Знач ПараметрыСервиса, directoryId, personId) Экспорт 
	
	// /v1/directories/{directoryId}/persons/{personId}
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Метод = "DELETE";
	
	ПараметрыЗапроса.АдресМетода = "/v1/directories/{directoryId}/persons/{personId}";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{directoryId}", directoryId);
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{personId}", personId);
	
	КонтурЛогистика_API_Логистика.ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 200 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОтправитьПриглашение(Знач ПараметрыСервиса, directoryId, personId, Сценарий) Экспорт 
	
	// /v1/directories/{directoryId}/invites
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Метод = "POST";
	
	ПараметрыЗапроса.АдресМетода = "/v1/directories/{directoryId}/invites";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{directoryId}", directoryId);
	
	КонтурЛогистика_API_Логистика.ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Приглашение = Новый Структура("personId, scenarioName", personId, Сценарий);
	ПараметрыЗапроса.ТелоЗапроса = КонтурЛогистика_API_Логистика.JsonЗаписать(Приглашение);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = КонтурЛогистика_API_Логистика.JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

