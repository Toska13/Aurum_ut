#Область Структуры

Функция Person(Сотрудник, Телефон = Неопределено, IdentityDocumentId = Неопределено) Экспорт 
	
	Person = Новый Структура;
	
	Person.Вставить("profile", Новый Структура);
	
	Person.profile.Вставить("name", Новый Структура);
	
	Person.profile.name.Вставить("lastName", Сотрудник.Фамилия);
	Person.profile.name.Вставить("firstName", Сотрудник.Имя);
	
	Если ЗначениеЗаполнено(Сотрудник.Отчество) Тогда
		Person.profile.name.Вставить("middleName", Сотрудник.Отчество);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник.ДатаРождения) Тогда
		Person.profile.Вставить("birthday", ДатаВСтроку(Сотрудник.ДатаРождения));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник.СНИЛС) Тогда 
		Person.profile.Вставить("snils", Сотрудник.СНИЛС);
	КонецЕсли;
	Если ЗначениеЗаполнено(Сотрудник.ИНН) Тогда 
		Person.profile.Вставить("inn", Сотрудник.ИНН);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Телефон) Тогда
		Person.profile.Вставить("phone", Телефон);
	Иначе
		Person.profile.Вставить("phone", Сотрудник.ТелефонОсновной);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник.АдресЭлектроннойПочты) Тогда
		Person.profile.Вставить("email", Сотрудник.АдресЭлектроннойПочты);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник.ВУСерия)
		И ЗначениеЗаполнено(Сотрудник.ВУНомер)
		И ЗначениеЗаполнено(Сотрудник.ВУДатаВыдачи) Тогда
		
		Person.Вставить("identityDocuments", Новый Структура);
		Person.identityDocuments.Вставить("driverLicense", Новый Структура);
		
		Если ЗначениеЗаполнено(IdentityDocumentId) Тогда
			Person.identityDocuments.driverLicense.Вставить("id", IdentityDocumentId);
		КонецЕсли;
		
		Person.identityDocuments.driverLicense.Вставить("series", Сотрудник.ВУСерия);
		Person.identityDocuments.driverLicense.Вставить("number", Сотрудник.ВУНомер);
		
		Person.identityDocuments.driverLicense.Вставить("validityPeriod", Новый Структура);
		Person.identityDocuments.driverLicense.validityPeriod.Вставить("begin", ДатаВСтроку(Сотрудник.ВУДатаВыдачи));
		
	КонецЕсли;
	
	Возврат Person;
	
КонецФункции

Функция ИмяСценарияПриглашения(Сценарий) Экспорт
	
	Если Сценарий = Перечисления.КонтурЛогистика_СценарииПриглашенийФизическихЛиц.Водитель Тогда
		Возврат "logistics.driver";
	Иначе
		ВызватьИсключение "Сценарий " + Строка(Сценарий) + " не поддерживается";
	КонецЕсли;
	
КонецФункции

