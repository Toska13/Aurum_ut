#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьПараметрыПолучениеСпискаФизическихЛиц(ПараметрыЗапроса, ПереданныеПараметры)
	
	Если ТипЗнч(ПереданныеПараметры) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
		
	Если ПереданныеПараметры.Получить("ids") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("ids", ПереданныеПараметры.Получить("ids"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("name") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("name", ПереданныеПараметры.Получить("name"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("snils") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("snils", ПереданныеПараметры.Получить("snils"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("inn") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("inn", ПереданныеПараметры.Получить("inn"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("birthday.begin") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("birthday.begin", ПереданныеПараметры.Получить("birthday.begin"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("birthday.end") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("birthday.end", ПереданныеПараметры.Получить("birthday.end"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("userId") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("userId", ПереданныеПараметры.Получить("userId"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("tags") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("tags", ПереданныеПараметры.Получить("tags"));
	КонецЕсли;
	Если ПереданныеПараметры.Получить("skip") <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("skip", ПереданныеПараметры.Получить("skip"));
	КонецЕсли;
	
	Если ПереданныеПараметры.Получить("ids") = Неопределено Тогда 
		Если ПереданныеПараметры.Получить("count") <> Неопределено Тогда
			ПараметрыЗапроса.Параметры.Вставить("count", ПереданныеПараметры.Получить("count"));
		Иначе
			ПараметрыЗапроса.Параметры.Вставить("count", 1000);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция НормализоватьСписокФизическихЛиц(СписокФизическихЛицВходящий) Экспорт
	
	СписокФизическихЛиц = Новый Массив;
	
	Если СписокФизическихЛицВходящий.Получить("items") = Неопределено Тогда
		Возврат СписокФизическихЛиц;
	КонецЕсли;
	
	Для каждого Элемент Из СписокФизическихЛицВходящий["items"] Цикл
		
		ФизЛицо = НормализоватьФизическоеЛицо(Элемент);
		
		СписокФизическихЛиц.Добавить(ФизЛицо);
		
	КонецЦикла;
		
	Возврат СписокФизическихЛиц;
	
КонецФункции

Функция НормализоватьФизическоеЛицо(ДанныеСоответствия) Экспорт
	
	ФизЛицо = Новый Структура;
	ФизЛицо.Вставить("id", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "id"));
	ФизЛицо.Вставить("userId", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "userId"));
	
	ФизЛицо.Вставить("ДанныеСотрудника", Новый Структура);
	
	стрДатаРождения = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "profile.birthday");
	ФизЛицо.ДанныеСотрудника.Вставить("ДатаРождения", СтрокуВДату(стрДатаРождения));
	
	ФизЛицо.ДанныеСотрудника.Вставить(
		"СНИЛС", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "profile.snils"));
	ФизЛицо.ДанныеСотрудника.Вставить(
		"ИНН", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "profile.inn"));
	ФизЛицо.ДанныеСотрудника.Вставить(
		"ТелефонОсновной", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "profile.phone"));
	ФизЛицо.ДанныеСотрудника.Вставить(
		"АдресЭлектроннойПочты", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(ДанныеСоответствия, "profile.email"));
	
	ФизЛицо.ДанныеСотрудника.Вставить("Фамилия", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "profile.name.lastName"));
	ФизЛицо.ДанныеСотрудника.Вставить("Имя", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "profile.name.firstName"));
	ФизЛицо.ДанныеСотрудника.Вставить("Отчество", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "profile.name.middleName"));
		
	Категории = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "identityDocuments.driverLicense.driversCategories");
	Если Категории <> Неопределено Тогда
		ФизЛицо.ДанныеСотрудника.Вставить("ВУКатегории", Категории);
	КонецЕсли;
	
	ФизЛицо.ДанныеСотрудника.Вставить("ВУИд",  КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "identityDocuments.driverLicense.id"));
	ФизЛицо.ДанныеСотрудника.Вставить("ВУСерия", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "identityDocuments.driverLicense.series"));
	ФизЛицо.ДанныеСотрудника.Вставить("ВУНомер", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "identityDocuments.driverLicense.number"));
		
	ДатаНачалаВУ = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "identityDocuments.driverLicense.validityPeriod.begin");
	ФизЛицо.ДанныеСотрудника.Вставить("ВУДатаВыдачи", СтрокуВДату(ДатаНачалаВУ));
	
	ДатаОкончанияВУ = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "identityDocuments.driverLicense.validityPeriod.end");
	ФизЛицо.ДанныеСотрудника.Вставить("ВУДатаОкончания", СтрокуВДату(ДатаОкончанияВУ));
	
	ФизЛицо.Вставить("Версия", КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		ДанныеСоответствия, "meta.version"));
	
	Возврат ФизЛицо;
	
КонецФункции

#КонецОбласти

#Область ОписаниеСтруктур

Функция ОписаниеСтруктурыФизическогоЛица() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("id");
	Результат.Вставить("userId");
	
	profile = ОписаниеСтруктурыProfile();
	Результат.Вставить("profile", profile);
	
	identityDocuments = ОписаниеСтруктурыIdentityDocuments();
	Результат.Вставить("identityDocuments", identityDocuments);
	
	Результат.Вставить("tags", Новый Массив);
	
	Meta = ОписаниеСтруктурыMeta();
	Результат.Вставить("Meta", Meta);
	
	Возврат Результат
	
