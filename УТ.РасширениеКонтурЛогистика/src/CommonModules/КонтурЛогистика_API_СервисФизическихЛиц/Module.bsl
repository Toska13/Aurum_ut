#Область ПрограммныйИнтерфейс

#Область Методы

Функция СписокФизическихЛиц(Знач ПараметрыСервиса, directoryId, Параметры = Неопределено) Экспорт 
	
	// /v1/directories/{directoryId}/persons
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/v1/directories/{directoryId}/persons";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{directoryId}", directoryId);
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		ЗаполнитьПараметрыПолучениеСпискаФизическихЛиц(ПараметрыЗапроса, Параметры);
	КонецЕсли;
	
	КонтурЛогистика_API_Логистика.ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = КонтурЛогистика_API_Логистика.JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьФизическоеЛицо(Знач ПараметрыСервиса, directoryId, personId) Экспорт 
	
	// /v1/directories/{directoryId}/persons/{personId}
	
	Результат = Новый Структура;
	Результат.Вставить("ФизЛицо", Неопределено);
	Результат.Вставить("ФизЛицоУдалено", Ложь);
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/v1/directories/{directoryId}/persons/{personId}";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{directoryId}", directoryId);
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{personId}", personId);
	
	КонтурЛогистика_API_Логистика.ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(410);
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 410 Тогда
		Результат.ФизЛицоУдалено = Истина;
	Иначе
		Результат.ФизЛицо = КонтурЛогистика_API_Логистика.JsonПрочитать(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзменитьФизическоеЛицо(Знач ПараметрыСервиса, Person, directoryId, personId) Экспорт 
	
	// v1/directories/{directoryId}/persons/{personId}
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Метод = "PATCH";
	
	ПараметрыЗапроса.АдресМетода = "v1/directories/{directoryId}/persons/{personId}";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{directoryId}", directoryId);
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{personId}", personId);
	
	КонтурЛогистика_API_Логистика.ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	ПараметрыЗапроса.ТелоЗапроса = КонтурЛогистика_API_Логистика.JsonЗаписать(Person);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = КонтурЛогистика_API_Логистика.JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

