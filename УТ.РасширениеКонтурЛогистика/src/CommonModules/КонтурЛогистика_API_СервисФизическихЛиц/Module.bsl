#Область СлужебныеПроцедурыИФункции

Функция МанифестПараметрыСервиса(АдресСервераЛогистика) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("ЭтоСервисФизическихЛиц");
	
	URL_Структура = КонтурЛогистика_API_Логистика.URL_Структура(АдресСервераЛогистика);
	
	Результат.Вставить("Схема", URL_Структура.Схема);
	
	Результат.Вставить("АдресВебСервиса", URL_Структура.Хост + "/" + URL_Структура.ПутьНаСервере);
	
	Результат.Вставить("Порт", URL_Структура.Порт);
	Результат.Вставить("ApiKey", Неопределено);
	Результат.Вставить("НастройкиПрокси", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОписаниеНастроекПрокси());
	Результат.Вставить("Таймаут", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ТаймаутHTTP"));
	
	Возврат Результат;
	
КонецФункции

// Преобразует дату в строку формата "2025-05-06"
Функция ДатаВСтроку(Дата)
	
	Если ТипЗнч(Дата) = Тип("Дата") Тогда
		Возврат Формат(Год(Дата), "ЧЦ=4; ЧВН=; ЧГ=0") + "-" + Формат(Месяц(Дата), "ЧЦ=2; ЧВН=; ЧГ=0") + "-" + Формат(День(Дата), "ЧЦ=2; ЧВН=; ЧГ=0");
	Иначе
		Возврат Дата;
	КонецЕсли;
	
КонецФункции

// Преобразует строку формата "2025-05-06" в дату 
Функция СтрокуВДату(стрДата)
	
	Если ТипЗнч(стрДата) = Тип("Строка") Тогда
		Возврат Дата(Число(Лев(стрДата, 4)), Число(Сред(стрДата, 6, 2)), Число(Прав(стрДата, 2)));
	Иначе
		Возврат стрДата;
	КонецЕсли;
	
КонецФункции

