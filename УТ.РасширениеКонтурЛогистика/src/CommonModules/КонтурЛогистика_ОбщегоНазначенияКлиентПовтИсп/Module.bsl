Процедура ПроверитьРежимТестирования() Экспорт
	
	РежимТестирования = ЭтоРежимТестирования();
	
	Если РежимТестирования Тогда
		// Установим блокироку если проходит тестирование
		КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьНастройку(
			"ПараметрыБлокировки_РаботаСВнешнимиРесурсамиЗаблокирована", Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоРежимТестирования() Экспорт
	
	Результат = Неопределено;
	
	Попытка
		ИмяТипа = "ТестируемоеПриложение";
		Результат = Тип(ИмяТипа);
	Исключение
		НичегоНеДелакм = Истина;
	КонецПопытки;
	
	РежимТестирования = (Результат <> Неопределено);
	
	Возврат РежимТестирования;
	
КонецФункции

