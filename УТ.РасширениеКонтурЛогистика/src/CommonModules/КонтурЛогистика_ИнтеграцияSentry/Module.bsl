#Область СлужебныеПроцедурыИФункции

#Область РаботаСДанными

Процедура ДополнитьОписаниеОшибки(ОписаниеОшибки, ПараметрыСервиса)
	
	// timestamp
	Если Не ЗначениеЗаполнено(ОписаниеОшибки.timestamp) Тогда
		ОписаниеОшибки.timestamp = ТекущееВремяUnix();
	КонецЕсли;
	
	// logger
	Если Не ЗначениеЗаполнено(ОписаниеОшибки.logger) Тогда
		ОписаниеОшибки.logger = ПараметрыСервиса.project_name;
	КонецЕсли;
	
	// platform
	Если Не ЗначениеЗаполнено(ОписаниеОшибки.platform) Тогда
		ОписаниеОшибки.platform = "Other";
	КонецЕсли;
	
	// level
	Если Не ЗначениеЗаполнено(ОписаниеОшибки.level) Тогда
		ОписаниеОшибки.level = УровниОшибок().Ошибка;
	КонецЕсли;
	
	// environment
	Если Не ЗначениеЗаполнено(ОписаниеОшибки.environment) Тогда
		ОписаниеОшибки.environment = "prod";
	КонецЕсли;
	
	// Информация о системе
	Если Не ЗначениеЗаполнено(ОписаниеОшибки.contexts) Тогда
		ДополнитьИнформациейОСистеме(ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьИнформациейОСистеме(ОписаниеОшибки)
	
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	
	Контент = ОписаниеОшибки.contexts;
	
	// Устройство
	Если Контент.Получить("device") = Неопределено Тогда
		ОписаниеУстройства = Новый Соответствие;
		ОписаниеУстройства.Вставить("type", "device");
		ОписаниеУстройства.Вставить("name", ИмяКомпьютера());
		ОписаниеУстройства.Вставить("memory_size", ИнформацияОСистеме.ОперативнаяПамять);
		ОписаниеУстройства.Вставить("processor", ИнформацияОСистеме.Процессор);
		
		Контент.Вставить("device", ОписаниеУстройства);
	КонецЕсли;
	
	// ОС
	Если Контент.Получить("os") = Неопределено Тогда
		Если КонтурЛогистика_СтдОбщегоНазначения.ЭтоWindowsСерверЛок() Тогда
			ИмяСистемы = "windows";
		ИначеЕсли КонтурЛогистика_СтдОбщегоНазначения.ЭтоLinuxСерверЛок() Тогда
			ИмяСистемы = "linux";
		ИначеЕсли КонтурЛогистика_СтдОбщегоНазначения.ЭтоLinuxСерверЛок() Тогда
			ИмяСистемы = "macos";
		Иначе
			ИмяСистемы = "";
		КонецЕсли;
		
		ОписаниеОперационнойСистемы = Новый Соответствие;
		ОписаниеОперационнойСистемы.Вставить("name", ИмяСистемы);
		ОписаниеОперационнойСистемы.Вставить("version", ИнформацияОСистеме.ВерсияОС);
		
		Контент.Вставить("os", ОписаниеОперационнойСистемы);
	КонецЕсли;
	
	// Приложение
	Если Контент.Получить("app") = Неопределено Тогда
		ОписаниеПриложения = Новый Соответствие;
		ОписаниеПриложения.Вставить("name", Метаданные.Синоним);
		ОписаниеПриложения.Вставить("type", "runtime");
		ОписаниеПриложения.Вставить("version", Метаданные.Версия);
		
		Контент.Вставить("app", ОписаниеПриложения);
	КонецЕсли;
	
	// Платформа
	Если Контент.Получить("platform") = Неопределено Тогда
		ОписаниеПлатформы = Новый Соответствие;
		ОписаниеПлатформы.Вставить("type", "app");
		ОписаниеПлатформы.Вставить("name", "1С");
		ОписаниеПлатформы.Вставить("raw_description", Строка(Метаданные.ОсновнойРежимЗапуска));
		ОписаниеПлатформы.Вставить("version", ИнформацияОСистеме.ВерсияПриложения);
		
		Контент.Вставить("platform", ОписаниеПлатформы);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ИнтеграцияСервиса

Функция ЗаголовокАвторизации(ПараметрыСервиса, ЗаголовокКлиент)
	
	ТекущееВремяUnix = Формат(ТекущееВремяUnix(), "ЧРД=.; ЧН=0; ЧГ=0");
	
	Заголовок = КонтурЛогистика_СтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
		"Sentry sentry_timestamp=%1, sentry_client=%2, sentry_version=%3, sentry_key=%4",
		ТекущееВремяUnix, ЗаголовокКлиент, ВерсияФормата(), ПараметрыСервиса.sentry_key);
	
	Возврат Заголовок;
	
КонецФункции

Функция ЗаголовокКлиент(ИмяПроекта, ВерсияПодсистемы)
	
	Возврат ИмяПроекта + "/" + ВерсияПодсистемы;
	
КонецФункции

Функция ВерсияФормата()
	
	Возврат "7";
	
КонецФункции

Функция ТекущееВремяUnix()
	
	НачалоВремениUnix = 62135596800000;
	
	МоментВремени = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВремениUNIX) / 1000;
	
	Возврат МоментВремени;
	
КонецФункции

#КонецОбласти

#КонецОбласти