
#Область ПрограммныйИнтерфейс

// Отправить в сервис описание ошибки
//
// Параметры:
//  ОписаниеОшибки			 - Структура	 - См. НовыйОписаниеОшибки().
//  ПараметрыСервиса		 - Структура	 - См. НовыйПараметрыСервиса().
//  ДополнительныеПараметры	 - Неопределено, Структура	 - См. КонтурЛогистика_КоннекторHTTP.НовыеПараметры().
//
Процедура ОтправитьВСервис(ОписаниеОшибки, ПараметрыСервиса, ДополнительныеПараметры = Неопределено) Экспорт
	
	ДополнитьОписаниеОшибки(ОписаниеОшибки, ПараметрыСервиса);
	
	// Объект для хранения параметров сессии
	Сессия = КонтурЛогистика_КоннекторHTTP.СоздатьСессию();
	Сессия.ПараметрыЗапроса.Вставить("project_number", ПараметрыСервиса.project_number);
	
	// Заголовки
	ЗаголовокКлиент = ЗаголовокКлиент(ПараметрыСервиса.project_name, ОписаниеОшибки.release);
	Сессия.Заголовки.Вставить("X-Sentry-Auth", ЗаголовокАвторизации(ПараметрыСервиса, ЗаголовокКлиент));
	Сессия.Заголовки.Вставить("User-Agent", ЗаголовокКлиент);
	Сессия.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	// Заполнить общие настройки HTTP
	ОписаниеСервиса = КонтурЛогистика_КоннекторHTTP.РазобратьURL(ПараметрыСервиса.sentry_server);
	ЗаполнитьЗначенияСвойств(Сессия, ОписаниеСервиса);
	
	URL = КонтурЛогистика_СтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
		"%1/api/%2/store/", ПараметрыСервиса.sentry_server, ПараметрыСервиса.project_number);
	
	Данные = КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(ОписаниеОшибки);
	
	Ответ = КонтурЛогистика_КоннекторHTTP.Post(URL, Данные, ДополнительныеПараметры, Сессия);
	
КонецПроцедуры

// Добавляет описание исключения в раздел exception
//
// Параметры:
//  ОписаниеОшибки		 - Структура	 - См. НовыйОписаниеОшибки.
//  Тип					 - Строка		 - Тип ошибки.
//  ПредставлениеОшибки	 - Строка		 - Представление ошибки.
//
Процедура ДобавитьИсключение(ОписаниеОшибки, Тип, ПредставлениеОшибки) Экспорт
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("type", Тип);
	Ошибка.Вставить("value", ПредставлениеОшибки);
	
	ОписаниеОшибки.exception["values"].Добавить(Ошибка);
	
КонецПроцедуры

// Значения поля level (уровни ошибок)
// 
// Возвращаемое значение:
//  Структура - параметры сервиса:
//  * Ошибка         - Строка - error.
//  * Предупреждение - Строка - warning.
//
Функция УровниОшибок() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "error");
	Результат.Вставить("Предупреждение", "warning");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
КонецФункции

#Область Конструкторы

// Описание ошибки
//  В общем случае логи группируются по issue в соответствии с дефолтным алгоритмом, описанным в документации Sentry.
//  По этому алгоритму в простейшем случае логи будут сгруппированы таким образом: в один issue попадут логи с одинаковыми исключениями,
//  файлами и функциями, указанными в stacktrace исключения (внутри значения тега exception). Если в логе нет исключения (тега exception),
//  то - по значению тега message.
// 
// Возвращаемое значение:
//  Структура - параметры сервиса:
//  * level - Строка - Уровень ошибки (см. УровниОшибок(), заполняется автоматически error, если не заполнено).
//  * message - Строка - Сообщение, содержащееся в логе.
//  * exception - Соответствие - Структурированная информация об исключении со структурированным стектрейсом. См. ДобавитьИсключение().
//  * timestamp - Строка - Время Unix (заполняется автоматически).
//  * platform - Строка - В Sentry нет платформы 1С, поэтому other (заполняется автоматически).
//  * environment - Строка - окружение (error или fatal).
//  * release - Строка - имя (номер) релиза приложения, сгенерировавшего ошибку.
//  * transaction - Строка - Идентификатор трассировки.
//  * fingerprint - Строка - Метка (или набор меток), предназначенная для группировки ивентов.
//  * logger - Строка - Имя проекта (заполняется автоматически).
//  * tags - Соответствие - Sentry-теги - короткие строки данных. Отображаются вверху страницы Issue.
//                          Могут быть использованы для поиска и фильтрации.
//  * extra - Соответствие - Какая-либо дополнительная информация.
//  * contexts - Соответствие - Контекст. Автоматически заполняется:
//          ** os - информация об операционной системе;
//          ** device - информация об устройстве;
//          ** app - детальная информация о приложении;
//          ** platform - информация о платформе.
//  * user - Соответствие - Структурированная информация о пользователе.
//
Функция НовыйОписаниеОшибки_() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("level");
	Результат.Вставить("message");
	Результат.Вставить("exception", Новый Соответствие);
	Результат.exception.Вставить("values", Новый Массив);
	
	Результат.Вставить("timestamp");
	Результат.Вставить("platform");
	Результат.Вставить("environment");
	Результат.Вставить("release");
	Результат.Вставить("transaction");
	Результат.Вставить("fingerprint");
	Результат.Вставить("logger");
	
	Результат.Вставить("tags", Новый Соответствие);
	Результат.Вставить("extra", Новый Соответствие);
	Результат.Вставить("contexts", Новый Соответствие);
	Результат.Вставить("user",  Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

// Описание параметров сервиса
// 
// Возвращаемое значение:
//  Структура - параметры сервиса:
//  * sentry_server  - Строка - адрес сервера sentry (https://sentry.kontur.host).
//  * sentry_key     - Строка - DSN-key проекта (Project Settings - Client Keys).
//  * project_number - Строка - Номер проекта (Project Settings - Client Keys - DNS, последние цифры).
//  * project_name   - Строка - Имя проекта.
//
Функция НовыйПараметрыСервиса() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("sentry_server");
	Результат.Вставить("sentry_key");
	Результат.Вставить("project_number");
	Результат.Вставить("project_name");
	
	Возврат Результат;
	
КонецФункции

