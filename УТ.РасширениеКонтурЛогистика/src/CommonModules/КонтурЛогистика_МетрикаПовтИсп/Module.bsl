КонецФункции

Функция ОписаниеПрограммы() Экспорт

	СисИнфо = Новый СистемнаяИнформация();

	Если Найти(СисИнфо.ТипПлатформы, "64") > 0 Тогда
		BitSet = "x64";
	Иначе
		BitSet = "x86";
	КонецЕсли;

	ТекущийРежимЗапуска	 = ТекущийРежимЗапуска();
	RunMode 	         = ?(ТекущийРежимЗапуска = Неопределено, "Регламентное задание", Строка(ТекущийРежимЗапуска));

	Результат = Новый Структура();
	Результат.Вставить("Name", 					"1С:Предприятие 8 " + BitSet);
	Результат.Вставить("Configuration", 		Метаданные.Имя);
	Результат.Вставить("ConfigurationVersion", 	КонтурЛогистика_Метрика.ПреобразоватьВерсиюВСемантик(Метаданные.Версия));
	Результат.Вставить("RunMode", 				RunMode);
	Результат.Вставить("Version", 				КонтурЛогистика_Метрика.ПреобразоватьВерсиюВСемантик(СисИнфо.ВерсияПриложения));

	Возврат Результат;

КонецФункции

