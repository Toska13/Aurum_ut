Функция НастройкиОрганизации(ОрганизацияДиадок) Экспорт
	
	СписокИсключений = Новый Массив;
	СписокИсключений.Добавить(Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey);
	СписокИсключений.Добавить(Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий);
	СписокИсключений.Добавить(Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата);
	СписокИсключений.Добавить(Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДатаПЛ);
	СписокИсключений.Добавить(Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийПЛ);
	
	НастройкиОрганизации = Новый Соответствие();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияДиадок", ОрганизацияДиадок);
	Запрос.УстановитьПараметр("СписокИсключений", СписокИсключений);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЛогистика_НастройкиОрганизаций.Настройка КАК Настройка,
	|	КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки КАК ЗначениеНастройки
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
	|ГДЕ
	|	КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок = &ОрганизацияДиадок
	|	И НЕ КонтурЛогистика_НастройкиОрганизаций.Настройка В(&СписокИсключений)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НастройкиОрганизации.Вставить(Строка(Выборка.Настройка), Строка(Выборка.ЗначениеНастройки));
	КонецЦикла;
	
	Возврат НастройкиОрганизации;
	
КонецФункции

Функция ДанныеАвтоматическогоОбновления() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Данные = Новый Структура;
	Данные.Вставить("АвтоматическоеОбновлениеВключено", Ложь);
	Данные.Вставить("РасписаниеАвтоматическогоОбновления", "");
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение() Тогда
		Возврат Данные;
	КонецЕсли;
	
	ИмяОбъекта = "РасширениеКонтурЛогистикаБандл";
	Идентификатор = "РасширениеКонтурЛогистикаБандл.ffdfc67a4c844632b3af1b6ef03dc40b";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеОтчетыИОбработкиКоманды.РегламентноеЗаданиеGUID КАК РегламентноеЗаданиеGUID
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
	|		ПО (ДополнительныеОтчетыИОбработкиКоманды.Ссылка = ДополнительныеОтчетыИОбработки.Ссылка)
	|ГДЕ
	|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
	|	И ДополнительныеОтчетыИОбработкиКоманды.Идентификатор = &Идентификатор";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Данные;
	КонецПопытки;
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.РегламентноеЗаданиеGUID) Тогда
		РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Выборка.РегламентноеЗаданиеGUID);
		
		Данные.АвтоматическоеОбновлениеВключено = РегламентноеЗадание.Использование;
		Данные.РасписаниеАвтоматическогоОбновления = Строка(РегламентноеЗадание.Расписание);
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция ИдентификаторПользователяОС() Экспорт
 
    СистемнаяИнформация1 = Новый СистемнаяИнформация;
    СистемнаяИнформация2 = Новый СистемнаяИнформация;
 
    Если СистемнаяИнформация1.ИдентификаторКлиента = СистемнаяИнформация2.ИдентификаторКлиента Тогда
        ИдентификаторКлиента = СистемнаяИнформация1.ИдентификаторКлиента;
    Иначе
        // https://devtrainingforum.v8.1c.ru/forum/thread.jsp?id=588350&threadtype=0
        // Константа - Ошибка идентификации клиента, переменный идентификатор
        ИдентификаторКлиента = Новый УникальныйИдентификатор("d808d128-2d0e-498e-a728-20bdbe6aae56");
    КонецЕсли; 
 
    Если Строка(ИдентификаторКлиента) = "00000000-0000-0000-0000-000000000000" Тогда
        // Константа - Ошибка идентификации клиента, пустой идентификатор
        ИдентификаторКлиента = Новый УникальныйИдентификатор("d808d128-7a45-43c4-88f2-7d666470b842");
    КонецЕсли;  
 
    Возврат ИдентификаторКлиента;
 
КонецФункции

Функция АдресСервера() Экспорт
	
	// метрики всегда отправляются на бой. в самой метрике есть признак "Окружение", 
	// по которому будем определять какой сервер ДД используется тестовый или боевой
	
	ОтправлятьМетрикиВТест 				= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОтправлятьМетрикиВТест");
	ИспользоватьТестовыйСерверДиадок 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	
	URLАдреса_Контур = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.URLАдреса_Контур();
	
	Если ИспользоватьТестовыйСерверДиадок Или ОтправлятьМетрикиВТест Тогда 	
	
		Возврат URLАдреса_Контур.СервисПорталТестовый;
		
	Иначе
		
		Возврат URLАдреса_Контур.СервисПортал;
		
	КонецЕсли;
		
КонецФункции

Функция ОтправкаМетрикНаТестовыйСерверЗаблокирована() Экспорт
	
	ОтправлятьМетрикиВТест 				= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОтправлятьМетрикиВТест");
	ИспользоватьТестовыйСерверДиадок 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	
	Возврат ИспользоватьТестовыйСерверДиадок И НЕ ОтправлятьМетрикиВТест;
	
КонецФункции

