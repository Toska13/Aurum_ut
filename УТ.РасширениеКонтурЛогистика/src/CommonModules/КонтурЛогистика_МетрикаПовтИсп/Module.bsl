Функция ОписаниеОС() Экспорт

	СисИнфо = Новый СистемнаяИнформация();
	ТипОС = НРег(СисИнфо.ТипПлатформы);

	Если Найти(ТипОС, НРег("Linux")) > 0 Тогда
		Name = "Linux";
	ИначеЕсли Найти(ТипОС, НРег("MacOS")) > 0 Тогда
		Name = "MacOS";
	ИначеЕсли Найти(ТипОС, НРег("Windows")) > 0 Тогда
		Name = "Windows";
	КонецЕсли;

	Если Найти(ТипОС, "64") > 0 Тогда
		BitSet = "x64";
	Иначе
		BitSet = "x86";
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Name", 		Name);
	Результат.Вставить("BitSet", 	BitSet);
	Результат.Вставить("Version", 	"1.0.0");

	Возврат Результат;

КонецФункции

Функция ОписаниеБраузера() Экспорт

	Результат = Новый Структура();
