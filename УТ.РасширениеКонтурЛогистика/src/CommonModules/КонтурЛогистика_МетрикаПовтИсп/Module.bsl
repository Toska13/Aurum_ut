Функция ИнфоОНастройках() Экспорт
		
	Настройки = Новый Соответствие();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_Настройки.ИмяПредопределенногоДляРасширения КАК ИмяПредопределенногоДляРасширения,
	               |	КонтурЛогистика_Настройки.Значение КАК Значение
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Настройки КАК КонтурЛогистика_Настройки
	               |ГДЕ
	               |	НЕ КонтурЛогистика_Настройки.ИмяПредопределенногоДляРасширения = """"
	               |	И НЕ КонтурЛогистика_Настройки.ЭтоГруппа
	               |	И НЕ КонтурЛогистика_Настройки.ИмяПредопределенногоДляРасширения ПОДОБНО ""%Пароль%""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Настройки.Вставить(Выборка.ИмяПредопределенногоДляРасширения, Строка(Выборка.Значение));
			
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции

