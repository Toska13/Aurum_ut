Функция КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(ОбъектУчетнойСистемы, ТипОбъекта) Экспорт

	НайденныйОбъект = Неопределено;
	
	// TODO объединить в 1 текст запроса
	
	Если ТипОбъекта = "ОрганизацияДиадок" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок.СвязанныеОбъекты КАК КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.СвязанныйОбъект = &СвязанныйОбъект
		|	И НЕ КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("СвязанныйОбъект", ОбъектУчетнойСистемы);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			НайденныйОбъект = Выборка.Ссылка;
		
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = "ТранспортноеСредство" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ТранспортныеСредстваСвязанныеОбъекты.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.КонтурЛогистика_ТранспортныеСредства.СвязанныеОбъекты КАК КонтурЛогистика_ТранспортныеСредстваСвязанныеОбъекты
		               |ГДЕ
		               |	КонтурЛогистика_ТранспортныеСредстваСвязанныеОбъекты.СвязанныйОбъект = &СвязанныйОбъект
		               |	И НЕ КонтурЛогистика_ТранспортныеСредстваСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("СвязанныйОбъект", ОбъектУчетнойСистемы);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			НайденныйОбъект = Выборка.Ссылка;
		
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = "ПунктМаршрута" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ПунктыМаршрутаСвязанныеОбъекты.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.КонтурЛогистика_ПунктыМаршрута.СвязанныеОбъекты КАК КонтурЛогистика_ПунктыМаршрутаСвязанныеОбъекты
		               |ГДЕ
		               |	КонтурЛогистика_ПунктыМаршрутаСвязанныеОбъекты.СвязанныйОбъект = &СвязанныйОбъект
		               |	И НЕ КонтурЛогистика_ПунктыМаршрутаСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("СвязанныйОбъект", ОбъектУчетнойСистемы);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			НайденныйОбъект = Выборка.Ссылка;
		
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = "Сотрудник" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_СотрудникиСвязанныеОбъекты.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.КонтурЛогистика_Сотрудники.СвязанныеОбъекты КАК КонтурЛогистика_СотрудникиСвязанныеОбъекты
		               |ГДЕ
		               |	КонтурЛогистика_СотрудникиСвязанныеОбъекты.СвязанныйОбъект = &СвязанныйОбъект
		               |	И НЕ КонтурЛогистика_СотрудникиСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("СвязанныйОбъект", ОбъектУчетнойСистемы);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			НайденныйОбъект = Выборка.Ссылка;
		
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = "Договор" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ДоговорыСвязанныеОбъекты.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.КонтурЛогистика_Договоры.СвязанныеОбъекты КАК КонтурЛогистика_ДоговорыСвязанныеОбъекты
		               |ГДЕ
		               |	КонтурЛогистика_ДоговорыСвязанныеОбъекты.СвязанныйОбъект = &СвязанныйОбъект
		               |	И НЕ КонтурЛогистика_ДоговорыСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("СвязанныйОбъект", ОбъектУчетнойСистемы);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
			НайденныйОбъект = Выборка.Ссылка;
		
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "Не реализована конвертация " + ТипОбъекта;
		
	КонецЕсли;
	
	Возврат	НайденныйОбъект;

КонецФункции

Процедура ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументОбъект, ДокументУчетнойСистемы, Знач НастройкаКонвертации, Переменные = Неопределено) Экспорт
	
	ВычисленноеЗначение = Неопределено;
	РодительскаяНастройка = НастройкаКонвертации;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьДочерниеНастройкиКонвертации(НастройкаКонвертации) Тогда
		ДопСвязанныйДокумент = ПереключитьсяНаДочернююНастройкуЕслиОнаПредусмотрена(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации);
	КонецЕсли;
	
	Если Переменные = Неопределено Тогда
		Переменные = ДвижокКонвертации_ВычислитьПеременные(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации, "");
	КонецЕсли;
	
	ЗаполнитьДокументПоНастройкеКонвертации(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации, Переменные, ДокументОбъект, РодительскаяНастройка, ДопСвязанныйДокумент);
		
КонецПроцедуры

Процедура ЗаполнитьДокументПоНастройкеКонвертации(ДокументОбъект, ДокументУчетнойСистемы, Знач НастройкаКонвертации, Переменные, ОбъектИспользуемыйДляВычисления, РодительскаяНастройка = Неопределено, ДопСвязанныйДокумент = Неопределено)
	
	Для Каждого ПравилоКонвертацииТитула Из НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента Цикл
		
		ТекущаяНастройкаКонвертации = НастройкаКонвертации;
		ТекущееПравилоКонвертацииТитула = ПравилоКонвертацииТитула;
		
		// Возьмем настройку и правило из родителя
		Если ПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзРодительскойНастройки
			И ЗначениеЗаполнено(РодительскаяНастройка) Тогда
			
			ТекущаяНастройкаКонвертации = РодительскаяНастройка;
			
			// Найдем правило в родителе
			Для Каждого ТекущаяСтрока Из РодительскаяНастройка.ПравилаКонвертацииГлавногоДокумента Цикл
				Если ТекущаяСтрока.РеквизитТитула <> ПравилоКонвертацииТитула.РеквизитТитула Тогда
					Продолжить;
				КонецЕсли;
				
				ТекущееПравилоКонвертацииТитула = ТекущаяСтрока;
				Прервать;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
			Или ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента
			И ЗначениеЗаполнено(ДопСвязанныйДокумент) Тогда
			Основание = ДопСвязанныйДокумент;
		Иначе
			Основание = ДокументУчетнойСистемы;
		КонецЕсли;
		
		РезультатРасчета = ДвижокКонвертации_ВычислитьРеквизитОснования(
			Основание, ТекущееПравилоКонвертацииТитула, ТекущаяНастройкаКонвертации, ОбъектИспользуемыйДляВычисления,, Переменные);
			
		Если РезультатРасчета.Успешно Тогда
			
			Попытка
				ДокументОбъект[ТекущееПравилоКонвертацииТитула.РеквизитТитула] = РезультатРасчета.Значение;
				
				// для реквизитов Лиц в некоторых документах авторассчитываем партнера
				ОпределитьПартнера(ДокументОбъект, НастройкаКонвертации, ПравилоКонвертацииТитула, РезультатРасчета);
				
			Исключение
				Сообщить("Не смог присвоить реквизит: " + ТекущееПравилоКонвертацииТитула.РеквизитТитула + " документу " + ДокументОбъект);
			КонецПопытки;
			
		Иначе
			
			Сообщить("Не смог рассчитать реквизит: " + ТекущееПравилоКонвертацииТитула.РеквизитТитула
				+ " по причине: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатРасчета));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ТелефонВодителя)
		И ЗначениеЗаполнено(ДокументОбъект.ТранспортноеСредство) 
		И ЗначениеЗаполнено(ДокументОбъект.ТранспортноеСредство.Телефон) Тогда 
		
		ДокументОбъект.ТелефонВодителя = ДокументОбъект.ТранспортноеСредство.Телефон;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьПартнера(Знач ДокументОбъект, Знач НастройкаКонвертации, Знач ПравилоКонвертацииТитула, Знач РезультатРасчета)
	
	Перем Партнер;
	
	// особые доконвертации Партнеров Для ЭТРН и ПЛт1
	Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда 
		Если ПравилоКонвертацииТитула.РеквизитТитула = "Грузоотправитель" Тогда
			
			Партнер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(РезультатРасчета.Значение);
			Если ЗначениеЗаполнено(Партнер) Тогда
				ДокументОбъект.ПартнерГрузоотправитель = Партнер;
			КонецЕсли;
			
		ИначеЕсли ПравилоКонвертацииТитула.РеквизитТитула = "Перевозчик" Тогда 
			
			Партнер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(РезультатРасчета.Значение);
			Если ЗначениеЗаполнено(Партнер) Тогда
				ДокументОбъект.ПартнерПеревозчик = Партнер;
			КонецЕсли;
			
		ИначеЕсли ПравилоКонвертацииТитула.РеквизитТитула = "Грузополучатель" Тогда 
			
			Партнер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(РезультатРасчета.Значение);
			Если ЗначениеЗаполнено(Партнер) Тогда
				ДокументОбъект.ПартнерГрузополучатель = Партнер;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда 
		
		Если ПравилоКонвертацииТитула.РеквизитТитула = "ОрганизацияМедик" Тогда
			Партнер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПартнераОрганизацииДиадок(РезультатРасчета.Значение);
			Если ЗначениеЗаполнено(Партнер) Тогда
				ДокументОбъект.ПартнерМедик = Партнер;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьЭТРНПриРучномВводе(Титул1, ДокументУчетнойСистемы, Знач НастройкаКонвертации, Переменные = Неопределено, ДанныеФормы = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Титул1.ДокументЭТРН) Тогда
		ДокументОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
	Иначе
		ДокументОбъект = Титул1.ДокументЭТРН.ПолучитьОбъект();
	КонецЕсли;
		
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьДочерниеНастройкиКонвертации(НастройкаКонвертации) Тогда 
		
		ПереключитьсяНаДочернююНастройкуЕслиОнаПредусмотрена(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации);

	КонецЕсли;
	
	ЗаполнитьДокументПоНастройкеКонвертации(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации, Переменные, Титул1);
	
	ДокументОбъект.Записать();
	Титул1.ДокументЭТРН = ДокументОбъект.Ссылка;
	
КонецПроцедуры

Функция ПереключитьсяНаДочернююНастройкуЕслиОнаПредусмотрена(Знач ДокументОбъект, Знач ДокументУчетнойСистемы, НастройкаКонвертации)
	
	Перем ВыражениеВычисления, ДочерняяНастройкаКонвертации, МассивДочернихНастроекКонвертации, Объект, Основание, РезультатВычисления;
	
	ВычисленноеЗначение = Неопределено;
	
	// Обойдем все дочерние и вычислим в них ДопСвязанныйДокументВыражениеВычисления
	// если оно заполнено, вычисление удалось и тип вычисленного значения совпадает с указанным в ТипДополнительногоСвязанногоДокумента
	// то меняем настройку конвертации на дочернюю
	
	МассивДочернихНастроекКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьМассивДочернихНастроекКонвертации(НастройкаКонвертации);
	
	Для Каждого ДочерняяНастройкаКонвертации Из МассивДочернихНастроекКонвертации Цикл
		
		Если ЗначениеЗаполнено(ДочерняяНастройкаКонвертации.ДопСвязанныйДокументВыражениеВычисления) Тогда
			
			Основание = ДокументУчетнойСистемы;
			Объект = ДокументОбъект;
			
			ВыражениеВычисления = ДочерняяНастройкаКонвертации.ДопСвязанныйДокументВыражениеВычисления;
			РезультатВычисления = Неопределено;
			
			Попытка
				
				Параметры = Новый Структура;
				Параметры.Вставить("Объект", Объект);
				Параметры.Вставить("Основание", Основание);
				Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
				Параметры.Вставить("ДочерняяНастройкаКонвертации", ДочерняяНастройкаКонвертации);
				
				ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
					ВыражениеВычисления, Параметры);
				
				Если ВычисленноеЗначение <> Неопределено
					И (ВычисленноеЗначение = Истина Или ЗначениеЗаполнено(ВычисленноеЗначение)) Тогда
					
					ТипДополнительногоДокумента = Тип("ДокументСсылка." + ДочерняяНастройкаКонвертации.ТипДополнительногоСвязанногоДокумента);
					
					Если ВычисленноеЗначение = Истина Тогда
						
						НастройкаКонвертации = ДочерняяНастройкаКонвертации;
						Прервать; // другие не смотрим
						
					ИначеЕсли ТипЗнч(ВычисленноеЗначение) = ТипДополнительногоДокумента Тогда
						
						НастройкаКонвертации = ДочерняяНастройкаКонвертации;
						Прервать; // другие не смотрим
						
					КонецЕсли;
					
				КонецЕсли;
				
			Исключение
				
				// // ну нет так нет - дочерняя настойка не будет применяться
				Продолжить;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВычисленноеЗначение;
	
КонецФункции

Процедура ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ДокументОбъект, Знач НастройкаКонвертации, ДокументУчетнойСистемы = Неопределено,
	Переменные = Неопределено, ПерезаполнитьГлавныйДокументЕслиСуществует = Ложь) Экспорт
	
	Если ДокументУчетнойСистемы = Неопределено Тогда
		ДокументУчетнойСистемы = ДокументОбъект.ДокументОснование;
	КонецЕсли;
	
	ВычисленноеЗначение = Неопределено;
	РодительскаяНастройка = НастройкаКонвертации;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьДочерниеНастройкиКонвертации(НастройкаКонвертации) Тогда
		ВычисленноеЗначение = ПереключитьсяНаДочернююНастройкуЕслиОнаПредусмотрена(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации);
	КонецЕсли;
	
	Если Переменные = Неопределено Тогда
		Переменные = ДвижокКонвертации_ВычислитьПеременные(ДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации, "");
	КонецЕсли;
	
	Для Каждого ПравилоКонвертацииТитула Из НастройкаКонвертации.ПравилаКонвертацииТитулаРеквизиты Цикл
		
		ТекущаяНастройкаКонвертации = НастройкаКонвертации;
		ТекущееПравилоКонвертацииТитула = ПравилоКонвертацииТитула;
		
		// Возьмем настройку и правило из родителя
		Если ПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзРодительскойНастройки
			И ЗначениеЗаполнено(РодительскаяНастройка) Тогда
			
			ТекущаяНастройкаКонвертации = РодительскаяНастройка;
			
			// Найдем правило в родителе
			Для Каждого ТекущаяСтрока Из РодительскаяНастройка.ПравилаКонвертацииТитулаРеквизиты Цикл
				Если ТекущаяСтрока.РеквизитТитула <> ПравилоКонвертацииТитула.РеквизитТитула Тогда
					Продолжить;
				КонецЕсли;
				
				ТекущееПравилоКонвертацииТитула = ТекущаяСтрока;
				Прервать;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
			Или ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда
			
			// Мы хотим сразу заполнить пользователя подписанта, так как при расчете следующих реквизитов может понадобиться
			Если ТекущееПравилоКонвертацииТитула.РеквизитТитула = "ПользовательПодписант"
				И ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда
				
				Попытка
					ДокументОбъект.ЗаполнитьРеквизитыПоПользователю();
				Исключение
					// Ничего не делаем
				КонецПопытки;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Если ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента Тогда
			Основание = ВычисленноеЗначение;
		Иначе
			Основание = ДокументУчетнойСистемы;
		КонецЕсли;
		
		Попытка
			
			РезультатРасчета = ДвижокКонвертации_ВычислитьРеквизитОснования(
				Основание, ТекущееПравилоКонвертацииТитула, ТекущаяНастройкаКонвертации, ДокументОбъект,, Переменные);
			
		Исключение
			
			РезультатРасчета = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
			РезультатРасчета.ОписаниеОшибки = ОписаниеОшибки();
			
		КонецПопытки;
		
		Если РезультатРасчета.Успешно Тогда
			
			Попытка
				
				// КАСТОМНОЕ ПРИСВАИВАНИЕ В ТИТУЛ	
				Если Прав(ТекущееПравилоКонвертацииТитула.РеквизитТитула, 6) = "Массив" Тогда
					
					ИмяТЧ = СтрЗаменить(ТекущееПравилоКонвертацииТитула.РеквизитТитула, "Массив", "");
					Если ИмяТЧ = "ТелефоныПереадресующего"  Тогда
						
						Если ТипЗнч(РезультатРасчета.Значение) = Тип("Строка") Тогда
							
							Если ЗначениеЗаполнено(РезультатРасчета.Значение) Тогда 
								ДокументОбъект.ТелефоныПереадресующего.Очистить();
								НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
								НоваяСтрока.Телефон = РезультатРасчета.Значение;
							КонецЕсли;
							
						ИначеЕсли ТипЗнч(РезультатРасчета.Значение) = Тип("Массив") Тогда 
							
							Если РезультатРасчета.Значение.Количество() > 0 Тогда 
								ДокументОбъект.ТелефоныПереадресующего.Очистить();
								Для Каждого Телефон Из РезультатРасчета.Значение Цикл
									НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
									НоваяСтрока.Телефон = Телефон;
								КонецЦикла;
							КонецЕсли;
							
						КонецЕсли;
						
					ИначеЕсли ИмяТЧ = "ДополнительныеВодителиМассив"  Тогда
						
						// надо определиться, ждем ли мы здесь уже сконвертированное значение ил инесконвертированное
						
					КонецЕсли;
					
				ИначеЕсли Лев(ТекущееПравилоКонвертацииТитула.РеквизитТитула, 11) = "ДопРеквизит" Тогда
					
					ЗаполнитьДопРеквизитыПоДокументуУчетнойСистемы(ДокументОбъект, ТекущееПравилоКонвертацииТитула, РезультатРасчета);
					
				ИначеЕсли Прав(ТекущееПравилоКонвертацииТитула.РеквизитТитула, 14) = "МассивСтруктур"
					И ТипЗнч(РезультатРасчета.Значение) = Тип("Массив") Тогда
					
					ИмяТабличнойЧасти = СтрЗаменить(ТекущееПравилоКонвертацииТитула.РеквизитТитула, "МассивСтруктур", "");
					
					Для Каждого ТекущаяСтрокаМассива Из РезультатРасчета.Значение Цикл
						
						НоваяСтрока = ДокументОбъект[ИмяТабличнойЧасти].Добавить();
						
						Для Каждого ТекущаяСтрокаЗначения Из ТекущаяСтрокаМассива Цикл
							
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
							ПараметрыОтбора.Вставить("ИмяРеквизитаТабличнойЧасти", ТекущееПравилоКонвертацииТитула.РеквизитТитула);
							ПараметрыОтбора.Вставить("РеквизитТитула", ТекущаяСтрокаЗначения.Ключ);
							
							НайденныеПравилаКонвертации = НастройкаКонвертации.ПравилаКонвертацииМассивовСтруктур.НайтиСтроки(ПараметрыОтбора);
							Если НайденныеПравилаКонвертации.Количество() = 0 Тогда
								НоваяСтрока[ТекущаяСтрокаЗначения.Ключ] = ТекущаяСтрокаЗначения.Значение;
							Иначе
								
								Для Каждого ТекущееПравило Из НайденныеПравилаКонвертации Цикл
									
									РезультатКонвертации = ДвижокКонвертации_Конвертировать(
										ТекущаяСтрокаЗначения.Значение, ТекущееПравило, ДокументУчетнойСистемы,
										НастройкаКонвертации, ДокументОбъект, Переменные);
									
									Если РезультатКонвертации.Успешно Тогда
										НоваяСтрока[ТекущаяСтрокаЗначения.Ключ] = РезультатКонвертации.Значение;
									Иначе
										НоваяСтрока[ТекущаяСтрокаЗначения.Ключ] = ТекущаяСтрокаЗначения.Значение;
									КонецЕсли;
									
								КонецЦикла;
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЦикла;
				
				// ОБЫЧНОЕ ПРИСВАИВАНИЕ В РЕКВИЗИТ ТИТУЛА	
				Иначе
					
					ДокументОбъект[ТекущееПравилоКонвертацииТитула.РеквизитТитула] = РезультатРасчета.Значение;
					
					// для реквизитов Лиц в некоторых документах авторассчитываем партнера
					ОпределитьПартнера(ДокументОбъект, НастройкаКонвертации, ПравилоКонвертацииТитула, РезультатРасчета);
					
			    КонецЕсли;
			Исключение
				Сообщить("Не смог присвоить реквизит: " + ТекущееПравилоКонвертацииТитула.РеквизитТитула + " документу " + ДокументОбъект);
			
			КонецПопытки;
			
		Иначе
			Сообщить("Не смог рассчитать реквизит: " + ТекущееПравилоКонвертацииТитула.РеквизитТитула + " по причине: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатРасчета));
		КонецЕсли;
		
	КонецЦикла;
	
	// Произвольные табличные части титула
	
	// Ключом одного заполнения является уникальное значение ИмяТЧТитула + ПутьТЧИсходногоДокумента
	// В разрезе него и будем действовать
	ТаблицаЗаполненияПроизвольныхТЧ = НастройкаКонвертации.ПравилаКонвертацииТитулаТабЧастьПроизвольная.Выгрузить();
	ТаблицаЗаполненияПроизвольныхТЧ.Свернуть("ИмяТЧТитула, ПутьТЧИсходногоДокумента");
	
	Для Каждого ГруппировкаТЧ Из ТаблицаЗаполненияПроизвольныхТЧ Цикл
		
		Попытка
			
			СтрокиКонвертации = НастройкаКонвертации.ПравилаКонвертацииТитулаТабЧастьПроизвольная.НайтиСтроки(Новый Структура("ИмяТЧТитула, ПутьТЧИсходногоДокумента", ГруппировкаТЧ.ИмяТЧТитула, ГруппировкаТЧ.ПутьТЧИсходногоДокумента)); 
			
			// Если в ПутьТЧИсходногоДокумента - число - значит мы добавляем только 1 строку
			// Если там что-то еще - будем пробовать делать обход указанной там ТЧ
			Если КонтурЛогистика_ОбщегоНазначенияСервер.СтрокаСодержитТолькоЦифры(ГруппировкаТЧ.ПутьТЧИсходногоДокумента) Тогда 
				
				Если Не ОтказДобавленияСтроки(ДокументУчетнойСистемы, ДокументУчетнойСистемы, СтрокиКонвертации, НастройкаКонвертации, ДокументОбъект, Переменные) Тогда
					НоваяСтрокаТЧ = ДокументОбъект[ГруппировкаТЧ.ИмяТЧТитула].Добавить();
					ЗаполнитьСтрокуПроизвольнойТЧ(НоваяСтрокаТЧ, ДокументУчетнойСистемы, ДокументУчетнойСистемы, СтрокиКонвертации, НастройкаКонвертации, ДокументОбъект, Переменные);
				КонецЕсли;
					
			Иначе
				
				// вычислим указанную ТЧ
				ТЧКонтейнерДокументаОснования = ДвижокКонвертации_ВычислитьПроизвольнуюТабЧастьПоВыражениюВычисления(ДокументУчетнойСистемы, СтрокиКонвертации[0], Истина, Переменные);
				
				Если ТЧКонтейнерДокументаОснования <> Неопределено Тогда
					
					Для Каждого СтрокаКонтейнераОснования Из ТЧКонтейнерДокументаОснования Цикл
						
						Попытка
																					
							Если Не ОтказДобавленияСтроки(СтрокаКонтейнераОснования, ДокументУчетнойСистемы, СтрокиКонвертации, НастройкаКонвертации, ДокументОбъект, Переменные) Тогда
								НоваяСтрокаТЧ = ДокументОбъект[ГруппировкаТЧ.ИмяТЧТитула].Добавить();
								ЗаполнитьСтрокуПроизвольнойТЧ(НоваяСтрокаТЧ, СтрокаКонтейнераОснования, ДокументУчетнойСистемы, СтрокиКонвертации, НастройкаКонвертации, ДокументОбъект, Переменные);
							КонецЕсли;
							
						Исключение
							
							КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
								"Не смог рассчитать строку произвольной ТЧ: " + ГруппировкаТЧ.ИмяТЧТитула + " _ " + ГруппировкаТЧ.ПутьТЧИсходногоДокумента + " по причине: " + ОписаниеОшибки());
							
							
						КонецПопытки;
						
					КонецЦикла;
					
				Иначе
					КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не смог рассчитать произвольную ТЧ: " + ГруппировкаТЧ.ИмяТЧТитула + " _ " + ГруппировкаТЧ.ПутьТЧИсходногоДокумента + " Проверьте путь ");
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не смог рассчитать строки произвольной ТЧ: " + ГруппировкаТЧ.ИмяТЧТитула + " _ " + ГруппировкаТЧ.ПутьТЧИсходногоДокумента + " по причине: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ПерезаполнитьГлавныйДокументЕслиСуществует Тогда
		
		ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументОбъект);
		Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда
			
			Попытка
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ГлавныйДокументОбъект, ДокументУчетнойСистемы, НастройкаКонвертации, Переменные);
				ГлавныйДокументОбъект.Записать();
			Исключение
				Сообщить("Не смогли перезаполнить главный документ: " + ГлавныйДокумент + "
					|Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверим есть ли участники перевозки в сервисе Логистика. Если нет, то обновим данные из Логистики
	Попытка
		ОбновитьУчастниковПеревозкиИзЛогистики(ДокументОбъект);	
	Исключение
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Ошибка обновления из Логистики при конвертации документа: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьУчастниковПеревозкиИзЛогистики(ДокументОбъект)
	
	// Не важно под какой организацией получаем данные
	ТочноеСовпадение = Ложь;
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1") Тогда
		
		Грузоотправитель = ДокументОбъект.ДокументЭТРН.Грузоотправитель;
		Перевозчик = ДокументОбъект.ДокументЭТРН.Перевозчик;
		Грузополучатель = ДокументОбъект.ДокументЭТРН.Грузополучатель;
		ЛОП = ДокументОбъект.ДокументЭТРН.ПогрузкуОсуществляет;
		
		Если ЗначениеЗаполнено(Грузоотправитель) И Не Грузоотправитель.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(Грузоотправитель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Перевозчик) И Не Перевозчик.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(Перевозчик);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Грузополучатель) И Не Грузополучатель.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(Грузополучатель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЛОП) И Не ЛОП.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ЛОП);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ПЛ_Титул1") Тогда
		
		ЛицоОформившееПЛ = ДокументОбъект.ЛицоОформившееПЛ;
		ОрганизацияМедик = ДокументОбъект.ОрганизацияМедик;
		ОрганизацияТехСостояние = ДокументОбъект.ОрганизацияТехСостояние;
		ОрганизацияОдометр = ДокументОбъект.ОрганизацияОдометр;
		
		Если ЗначениеЗаполнено(ЛицоОформившееПЛ) И Не ЛицоОформившееПЛ.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ЛицоОформившееПЛ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОрганизацияМедик) И ОрганизацияМедик <> ЛицоОформившееПЛ И Не ОрганизацияМедик.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ОрганизацияМедик);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОрганизацияТехСостояние) И ОрганизацияТехСостояние <> ЛицоОформившееПЛ И Не ОрганизацияТехСостояние.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ОрганизацияТехСостояние);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОрганизацияОдометр) И ОрганизацияОдометр <> ЛицоОформившееПЛ И Не ОрганизацияОдометр.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ОрганизацияОдометр);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		
		ЛицоОформившееПЛ = ДокументОбъект.ЛицоОформившееПЛ;
		ОрганизацияМедик = ДокументОбъект.ОрганизацияМедик;
		
		Если ЗначениеЗаполнено(ЛицоОформившееПЛ) И Не ЛицоОформившееПЛ.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ЛицоОформившееПЛ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОрганизацияМедик) И ОрганизацияМедик <> ЛицоОформившееПЛ И Не ОрганизацияМедик.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(ОрганизацияМедик);
		КонецЕсли;		
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЗЗ_Титул1") Тогда
		
		Грузоотправитель = ДокументОбъект.Грузоотправитель;
		Перевозчик = ДокументОбъект.Перевозчик;
		
		Если ЗначениеЗаполнено(Грузоотправитель) И Не Грузоотправитель.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(Грузоотправитель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Перевозчик) И Не Перевозчик.ЕстьВСервисеЛогистика Тогда
			КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(Перевозчик);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОтказДобавленияСтроки(Знач СтрокаТЧУчетногоДокумента , Знач ДокументУчетнойСистемы, Знач СтрокиКонвертации, Знач НастройкаКонвертации, ДокументОбъект, Переменные)
	
	ОтказДобавленияСтроки = Ложь;
	 		
	Если СтрокиКонвертации.Количество() > 0 И Не ЗначениеЗаполнено(СтрокиКонвертации[0].СпособМаппингаДобавлятьСтроку) Тогда
		Возврат ОтказДобавленияСтроки;
	КонецЕсли;
	
	РезультатВычисления = ДвижокКонвертации_ВычислитьОтказДобавленияСтроки(СтрокаТЧУчетногоДокумента, СтрокиКонвертации[0], НастройкаКонвертации, ДокументОбъект, Переменные);
	
	Если Не РезультатВычисления.Успешно  Тогда			
		Сообщить("Не удалось рассчитать: отказ добавления строки" + 
			" по " + ДокументУчетнойСистемы + " - " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатВычисления));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатВычисления.Значение) И ТипЗнч(РезультатВычисления.Значение) = Тип("Булево") И РезультатВычисления.Значение Тогда
		ОтказДобавленияСтроки = Истина;
	КонецЕсли;
						
	Возврат ОтказДобавленияСтроки;
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьОтказДобавленияСтроки(Основание, ПравилоКонвертации, НастройкаКонвертации, Объект = Неопределено,
	Переменные = Неопределено, ДокументОснование = Неопределено)
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	ВычисленноеЗначение = Неопределено;
	
	Попытка
		
		Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияДобавлятьСтроку) 
			Или ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогрДобавлятьСтроку) 
			Или ПравилоКонвертации.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять Тогда 
										
			Если ПравилоКонвертации.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула Тогда
				
				Если Объект = Неопределено Тогда
					ВызватьИсключение "ДвижокКонвертации: Ошибка при вычислении " + ПравилоКонвертации.РеквизитТитула + " не передан ДокументОбъект";
				КонецЕсли;
				
				текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(Объект, ПравилоКонвертации, Истина, Переменные, Истина);
				
				ВычисленноеЗначение = текРеквизит;
				
				Результат.Успешно = Истина;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда
				
				РезультатВычисления = Неопределено;
								
				Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогрДобавлятьСтроку) Тогда
					ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогрДобавлятьСтроку;
				Иначе
					ВыражениеВычисления = Неопределено;
				КонецЕсли;
				
				Если ВыражениеВычисления <> Неопределено Тогда
					
					Если Найти(ВыражениеВычисления, "РезультатВычисления") Тогда
						
						РезультатВычисления = Ложь;
						
						Выполнить(ВыражениеВычисления);
						ВычисленноеЗначение = РезультатВычисления;
											
					Иначе
						
						ВычисленноеЗначение = Вычислить(ВыражениеВычисления);
						
					КонецЕсли;			
										
				Иначе
					
					ВычисленноеЗначение = Неопределено;
					
				КонецЕсли;
				
				Результат.Успешно = Истина;
					
			ИначеЕсли ПравилоКонвертации.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
				Или ПравилоКонвертации.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда
				
				ВычисленноеЗначение = Неопределено;
				Результат.Вставить("Значение", ВычисленноеЗначение);
				Результат.Успешно = Истина;
				Возврат Результат;
				
			Иначе // НеЗаполнять
				
				ВычисленноеЗначение = Неопределено;
				
			КонецЕсли;
			
		Иначе
			
			Результат.ОписаниеОшибки = "Не указано выражение вычисления";
			ВычисленноеЗначение = Неопределено;
			
		КонецЕсли;
		
	Исключение
		
		ВычисленноеЗначение = Неопределено;
		Результат.ОписаниеОшибки = "Не удалось вычислить " + ПравилоКонвертации.ВыражениеВычисления + ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр + " по причине: " + ОписаниеОшибки();
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Результат.ОписаниеОшибки);
		
	КонецПопытки;
	
	Результат.Вставить("Значение", ВычисленноеЗначение);
		
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтрокуПроизвольнойТЧ(НоваяСтрокаТЧ, Знач СтрокаТЧУчетногоДокумента , Знач ДокументУчетнойСистемы, Знач СтрокиКонвертации, Знач НастройкаКонвертации, ДокументОбъект, Переменные)
	
	Для Каждого СтрокаНастройкиКонвертацииТЧ Из СтрокиКонвертации Цикл
		
		Если СтрокаНастройкиКонвертацииТЧ.РеквизитТитула = "ИдентификаторСтроки"
			И (СтрокаНастройкиКонвертацииТЧ.ИмяТЧТитула = "ОстаткиТоплива" Или СтрокаНастройкиКонвертацииТЧ.ИмяТЧТитула = "Заправки") Тогда
			
			Попытка
				НоваяСтрокаТЧ[СтрокаНастройкиКонвертацииТЧ.РеквизитТитула] = Новый УникальныйИдентификатор;				
			Исключение
				Сообщить("Не удалось рассчитать: " + СтрокаНастройкиКонвертацииТЧ.РеквизитТитула + 
					" по " + ДокументУчетнойСистемы + " - " + ПодробноеПредставлениеОшибки(ОписаниеОшибки()));
			КонецПопытки;
			
		КонецЕсли;
		
		Если СтрокаНастройкиКонвертацииТЧ.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
			Или СтрокаНастройкиКонвертацииТЧ.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда 
			Продолжить;
		КонецЕсли;
				
		РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(СтрокаТЧУчетногоДокумента, СтрокаНастройкиКонвертацииТЧ, НастройкаКонвертации, ДокументОбъект,, Переменные);
				
		Если РезультатВычисления.Успешно  Тогда
			
			НоваяСтрокаТЧ[СтрокаНастройкиКонвертацииТЧ.РеквизитТитула] = РезультатВычисления.Значение;
			
		Иначе
			Сообщить("Не удалось рассчитать: " + СтрокаНастройкиКонвертацииТЧ.РеквизитТитула + 
			" по " + ДокументУчетнойСистемы + " - " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатВычисления));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДопРеквизитыПоДокументуУчетнойСистемы(ДокументОбъект, Знач ПравилоКонвертацииТитула, Знач РезультатРасчета)
	
	Если ПравилоКонвертацииТитула.РеквизитТитула = "ДопРеквизитНовыйВодитель" Тогда
		
		ДокументОбъект.НовыеВодители.Очистить();
		Если ЗначениеЗаполнено(РезультатРасчета.Значение) Тогда 
			НоваяСтрокаТС = ДокументОбъект.НовыеВодители.Добавить();
			НоваяСтрокаТС.Водитель = РезультатРасчета.Значение;
			НоваяСтрокаТС.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
	ИначеЕсли ПравилоКонвертацииТитула.РеквизитТитула = "ДопРеквизитНовоеТранспортноеСредство" Тогда
		
		
		ДокументОбъект.НовыеТранспортныеСредства.Очистить();
		
		Если ЗначениеЗаполнено(РезультатРасчета.Значение) Тогда
			
			ПроверитьДобавитьБазовуюСтрокуЗаменыТС(ДокументОбъект);
			
			НоваяСтрокаТС = ДокументОбъект.НовыеТранспортныеСредства.Добавить();
			НоваяСтрокаТС.ТранспортноеСредство = РезультатРасчета.Значение;
			НоваяСтрокаТС.ИдентификаторСтрокиЗаменТС = ДокументОбъект.ЗаменТС[0].ИдентификаторСтроки;
			
		КонецЕсли;
		
	ИначеЕсли ПравилоКонвертацииТитула.РеквизитТитула = "ДопРеквизитНовыйПрицеп" Тогда
		
		ДокументОбъект.НовыеПрицепы.Очистить();
		
		Если ЗначениеЗаполнено(РезультатРасчета.Значение) Тогда
			
			ПроверитьДобавитьБазовуюСтрокуЗаменыТС(ДокументОбъект);
			
			НоваяСтрокаПрицеп = ДокументОбъект.НовыеПрицепы.Добавить();
			НоваяСтрокаПрицеп.Прицеп = РезультатРасчета.Значение;
			НоваяСтрокаПрицеп.ИдентификаторСтрокиЗаменТС = ДокументОбъект.ЗаменТС[0].ИдентификаторСтроки;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДобавитьБазовуюСтрокуЗаменыТС(Знач ДокументОбъект)
	
	Перем НовСтрЗаменТС, УжеЕстьСтрокаЗаменТС;
	
	УжеЕстьСтрокаЗаменТС = ДокументОбъект.ЗаменТС.Количество() > 0;
	Если Не УжеЕстьСтрокаЗаменТС Тогда
		НовСтрЗаменТС = ДокументОбъект.ЗаменТС.Добавить();
		НовСтрЗаменТС.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
	КонецЕсли;

КонецПроцедуры

Функция ДвижокКонвертации_ВычислитьПеременные(Знач ДокументОбъект, Знач ДокументУчетнойСистемы, Знач НастройкаКонвертации, ИмяТабчасти) Экспорт
	
	Перем Переменные, ПравилоКонвертацииПеременной, РезультатРасчета;
	
	Переменные = Новый Структура;
	Для Каждого ПравилоКонвертацииПеременной Из НастройкаКонвертации.Переменные Цикл 
		
		Если ПравилоКонвертацииПеременной.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
			Или ПравилоКонвертацииПеременной.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда 
			Продолжить;
		КонецЕсли;
		
		Если (Не ЗначениеЗаполнено(ПравилоКонвертацииПеременной.ИмяТабчасти) И Не ЗначениеЗаполнено(ИмяТабчасти))
			Или (ЗначениеЗаполнено(ПравилоКонвертацииПеременной.ИмяТабчасти) И ПравилоКонвертацииПеременной.ИмяТабЧасти = ИмяТабчасти) Тогда
			
			РезультатРасчета = ДвижокКонвертации_ВычислитьРеквизитОснования(ДокументУчетнойСистемы, ПравилоКонвертацииПеременной, НастройкаКонвертации, ДокументОбъект);  
			Если РезультатРасчета.Успешно Тогда
				
				Переменные.Вставить(ПравилоКонвертацииПеременной.Имя, РезультатРасчета.Значение);
				
			Иначе
				Сообщить("Не смог рассчитать настроенную переменную конвертации: " 
				+ ПравилоКонвертацииПеременной.Имя 
				+ " по причине: " 
				+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатРасчета));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Переменные;

КонецФункции

Процедура КонвертироватьТовары1сВЛогистику(ТЗТоварыВременная, ДокументОбъект = Неопределено) Экспорт

	СконвертированныеТоварыДокумента = ПолучитьСконвертированныеТоварыДокумента(ТЗТоварыВременная, ДокументОбъект);
	
	Если СконвертированныеТоварыДокумента.Количество() > 0 Тогда 
		Для Каждого СтрокаТоваровДокументаВременная Из ТЗТоварыВременная Цикл
			ЗаполнитьСтрокуТоваровСконвертированнымиЗначениями(СтрокаТоваровДокументаВременная, СконвертированныеТоварыДокумента, ДокументОбъект);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСконвертированныеТоварыДокумента(ТЗТоварыВременная, ДокументОбъект) Экспорт
	
	Перем НоваяСтрока, СконвертированныеТоварыДокумента, СтрокаТоваров, ТабТоваров, ТЗТовары;
	
	ТабТоваров 	= КонтурЛогистика_КонвертацияСервер.Манифест_ТабТоваров();
	ТЗТовары = ТЗТоварыВременная.Скопировать(,"Номенклатура,УпаковкаЕдиницаИзмерения,Характеристика,Количество");
	
	Для Каждого СтрокаТоваров ИЗ ТЗТовары Цикл
		
		НоваяСтрока = ТабТоваров.Добавить();
		
		НоваяСтрока.Номенклатура 		= СтрокаТоваров.Номенклатура;
		НоваяСтрока.УпаковкаЕдиницаИзмерения = СтрокаТоваров.УпаковкаЕдиницаИзмерения;
		НоваяСтрока.Характеристика 		= СтрокаТоваров.Характеристика;
		НоваяСтрока.Количество 			= СтрокаТоваров.Количество;
		
	КонецЦикла;
	
	ТабСконвертированныеТовары = ПолучитьТаблицуБазовыхСоответствийТоваров(ТабТоваров);
	
	Возврат ТабСконвертированныеТовары;

КонецФункции

Функция СвернутьТовары(ТЗТоварыВременная, ДокументОбъект, НастройкаКонвертации) Экспорт 
	
	// Рассчитаем дополнительную колонку по которой будем сворачивать номенклатуру
	
	ЭтоТитул1ТрН =  НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	ЭтоТитул1ЗЗ	 =  НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1;
	
	ЕстьОпасныеГрузы 	= ЭтоТитул1ТрН Или ЭтоТитул1ЗЗ;
	ЕстьМаркировки 		= Не ЭтоТитул1ЗЗ;
	
	МассивОбязПолейГруппировки = Новый Массив;
	МассивОбязПолейГруппировки.Добавить("ОтгрузочноеНаименование");
	МассивОбязПолейГруппировки.Добавить("СостояниеГруза");
	
	Если ЭтоТитул1ТрН Тогда
		МассивОбязПолейГруппировки.Добавить("СпособУпаковки");
		МассивОбязПолейГруппировки.Добавить("ВидТары");
	КонецЕсли;
	
	Если ЭтоТитул1ЗЗ Тогда
		МассивОбязПолейГруппировки.Добавить("ВидТары");
	КонецЕсли;
	
	ТЗТоварыВременная.Колонки.Добавить("КолонкаГруппировкиСтрок", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(1000));
	
	Для Каждого СтрокаТоваров Из ТЗТоварыВременная Цикл
		
		УсловиеГруппировки = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ВычислитьУсловиеГруппировкиСтрокиТоваров(СтрокаТоваров, ДокументОбъект, НастройкаКонвертации);
		
		Для Каждого ИмяКолонки Из МассивОбязПолейГруппировки Цикл 
			УсловиеГруппировки = УсловиеГруппировки + "," + Строка(СтрокаТоваров[ИмяКолонки]);
		КонецЦикла;	
		
		СтрокаТоваров.КолонкаГруппировкиСтрок = УсловиеГруппировки;	
	КонецЦикла;	
	
	// Проверим, что в таблице нет строк с пустым условием группировки
	
	СтрокиСПустымУсловиемГруппировки = ТЗТоварыВременная.НайтиСтроки(Новый Структура("КолонкаГруппировкиСтрок, Учитывать", "", Истина));
	Если СтрокиСПустымУсловиемГруппировки.Количество() Тогда 
		Возврат ТЗТоварыВременная; 
	КонецЕсли;	

	ТЗТоварыСвернутая 		= ТЗТоварыВременная.СкопироватьКолонки();

	Если ЭтоТитул1ТрН Или ЭтоТитул1ЗЗ Тогда 
		ТЗОпаснГрузыВременная 	= ДокументОбъект.ОпасныеГрузы.ВыгрузитьКолонки();
	КонецЕсли;
	
	Если Не ЭтоТитул1ЗЗ Тогда 
		ТЗМаркировкиВременная 	= ДокументОбъект.Маркировки.ВыгрузитьКолонки();
	КонецЕсли;	
		
	// Добавим в свернутую таблицу учитываемые товары, предварительно их свернув по рассчитанной доп. колонке и обязательным полям
	// Если в результате сворачивания одна свернутая строка соответствует одной строке до сворачивания, то
	// в результирующую таблицу запишем её, если строк несколько - то первую
	
	Если ЭтоТитул1ТрН Тогда 
		КолонкиСвертки = "Количество,КоличествоМест,МассаПлановаяБруттоКг,ОбъемКубМ,МассаПлановаяНеттоКг,КоличествоПаллет,ОбъявленнаяЦенность";
	ИначеЕсли ЭтоТитул1ЗЗ Тогда	
		КолонкиСвертки = "Количество,КоличествоМест,МассаПлановаяБруттоКг,ОбъемКубМ,МассаПлановаяНеттоКг,КоличествоПаллет,Высота,Длина,Ширина";
	Иначе 
		КолонкиСвертки = "Количество,ОбъемКубМ,КоличествоМест,МассаБруттоКг,МассаНеттоКг,КоличествоПаллет";	
	КонецЕсли;	
	
	ТЗТоварыДляСвертки = ТЗТоварыВременная.Скопировать(Новый Структура("Учитывать", Истина));
	ТЗТоварыДляСвертки.Свернуть("КолонкаГруппировкиСтрок", КолонкиСвертки);
		
	Для Каждого СтрокаТЗСвернутая Из ТЗТоварыДляСвертки Цикл 
		
		НайденныеУчТовары = ТЗТоварыВременная.НайтиСтроки(Новый Структура("КолонкаГруппировкиСтрок,Учитывать", СтрокаТЗСвернутая.КолонкаГруппировкиСтрок, Истина));
		
		НоваяСтрока = ТЗТоварыСвернутая.Добавить();
		
		Если НайденныеУчТовары.Количество() > 1 Тогда
			НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.Свернута 			= Истина;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеУчТовары[0],, "ИдентификаторСтроки,УпаковкаЕдиницаИзмерения,Номенклатура,Характеристика,Свернута");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗСвернутая);
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеУчТовары[0]);
		КонецЕсли;
		
		// Заполнение связных с учитываемыми товарами таблиц
		
		МассивМаркировок 			= Новый Массив;
		МассивОписаниеОпасногоГруза = Новый Массив;
		
		Для Каждого СтрокаТоваровУч Из НайденныеУчТовары Цикл 
			
			// Заполнение маркировок		
			
			Если ЕстьМаркировки Тогда
				
				НайденныеМаркировки = ДокументОбъект.Маркировки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТоваровУч.ИдентификаторСтроки));
				Для Каждого СтрокаМаркировки Из НайденныеМаркировки Цикл 
					МассивМаркировок.Добавить(СтрокаМаркировки.ЗначениеМаркировки);
				КонецЦикла;
			
			КонецЕсли;
			
			// Заполнение опасных грузов
			
			Если ЕстьОпасныеГрузы Тогда 
				
				НайденныеОпаснГрузы = ДокументОбъект.ОпасныеГрузы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТоваровУч.ИдентификаторСтроки));
				Для Каждого СтрокаОпаснГруза Из НайденныеОпаснГрузы Цикл
					Если ЗначениеЗаполнено(СтрокаОпаснГруза.ОписаниеОпасногоГруза)
						И ТЗОпаснГрузыВременная.Найти(НоваяСтрока.ИдентификаторСтроки, "ИдентификаторСтрокиТоваров") = Неопределено Тогда 
						НоваяСтрокаОпаснГруза = ТЗОпаснГрузыВременная.Добавить();
						НоваяСтрокаОпаснГруза.ИдентификаторСтрокиТоваров = НоваяСтрока.ИдентификаторСтроки;
						ЗаполнитьЗначенияСвойств(НоваяСтрокаОпаснГруза, СтрокаОпаснГруза,, "ИдентификаторСтрокиТоваров");
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;	
		
		Если ЕстьМаркировки Тогда
		
			МассивМаркировок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СвернутьМассив_(МассивМаркировок);		
			Для Каждого ЗначениеМаркировки Из МассивМаркировок Цикл  
				НоваяСтрокаМаркировки = ТЗМаркировкиВременная.Добавить();
				НоваяСтрокаМаркировки.ИдентификаторСтрокиТоваров 	= НоваяСтрока.ИдентификаторСтроки;
				НоваяСтрокаМаркировки.ЗначениеМаркировки 			= ЗначениеМаркировки;
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;	
		
	// Добавим в свернутую таблицу неучитываемые товары 
	
	НайденныеНеучТовары = ТЗТоварыВременная.Скопировать(Новый Структура("Учитывать", Ложь));
	Для Каждого СтрокаТоваровНеуч Из НайденныеНеучТовары Цикл 		
		НоваяСтрока = ТЗТоварыСвернутая.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваровНеуч);
		
		Если ЕстьМаркировки Тогда
		
			// Добавим маркировки неучитываемых товаров		
			НайденныеМаркировки = ДокументОбъект.Маркировки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТоваровНеуч.ИдентификаторСтроки));
			Для Каждого СтрокаМаркировки Из НайденныеМаркировки Цикл
				НоваяСтрокаМаркировки = ТЗМаркировкиВременная.Добавить();
				НоваяСтрокаМаркировки.ИдентификаторСтрокиТоваров 	= НоваяСтрока.ИдентификаторСтроки;
				НоваяСтрокаМаркировки.ЗначениеМаркировки 			= СтрокаМаркировки.ЗначениеМаркировки;
			КонецЦикла;
		
		КонецЕсли;
		
		// Добавим опасные грузы неучитываемых товаров
		Если ЕстьОпасныеГрузы Тогда 
			НайденныеОпаснГрузы = ДокументОбъект.ОпасныеГрузы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТоваровНеуч.ИдентификаторСтроки));
			Для Каждого СтрокаОпаснГруза Из НайденныеОпаснГрузы Цикл
				Если ЗначениеЗаполнено(СтрокаОпаснГруза.ОписаниеОпасногоГруза) Тогда 
					НоваяСтрокаОпаснГруза = ТЗОпаснГрузыВременная.Добавить();
					НоваяСтрокаОпаснГруза.ИдентификаторСтрокиТоваров = НоваяСтрока.ИдентификаторСтроки;
					ЗаполнитьЗначенияСвойств(НоваяСтрокаОпаснГруза, СтрокаОпаснГруза,, "ИдентификаторСтрокиТоваров");
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьМаркировки Тогда
		ДокументОбъект.Маркировки.Загрузить(ТЗМаркировкиВременная);
	КонецЕсли;
	
	Если ЕстьОпасныеГрузы Тогда 
		ДокументОбъект.ОпасныеГрузы.Загрузить(ТЗОпаснГрузыВременная);
	КонецЕсли;
	
	Возврат ТЗТоварыСвернутая;
	
КонецФункции
	
Функция ПолучитьСвязанныеОбъекты(Ссылка) Экспорт
	
	Возврат Ссылка.СвязанныеОбъекты.Выгрузить().ВыгрузитьКолонку("СвязанныйОбъект");
	
КонецФункции

// Функция - Получить таблицу базовых соответствий товаров
//
// Параметры:
//  ТабТоваров	 - ТаблицаЗначений	 - *Номенклатура
//  	*ЕдиницаИзмерения
//  	*Характеристика
// 
// Возвращаемое значение:
//  ТаблицаЗначений - соответствия переданных товаров (использование характеристики вычисляется)
//
Функция ПолучитьТаблицуБазовыхСоответствийТоваров(ТабТоваров) Экспорт

	ИспользуютсяХарактеристики = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики");
	
	// Выполнить запросы, дать управление ПМ, заполить таблицу ТабСконвертированныеТовары
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.УпаковкаЕдиницаИзмерения КАК УпаковкаЕдиницаИзмерения,
	|	Товары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТабТоваров КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.УпаковкаЕдиницаИзмерения КАК УпаковкаЕдиницаИзмерения,
	|	ВТ_Товары.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА &НесопоставленныеПропускать
	|			ТОГДА ЕСТЬNULL(БазовыеСоответствия.Учитывать, ЛОЖЬ)
	|		ИНАЧЕ ЕСТЬNULL(БазовыеСоответствия.Учитывать, ИСТИНА)
	|	КОНЕЦ КАК Учитывать,
	|	БазовыеСоответствия.КоэффициентПересчетаМест КАК КоэффициентПересчетаМест,
	|	БазовыеСоответствия.КодТНВЭД КАК КодТНВЭД,
	|	БазовыеСоответствия.ОтгрузочноеНаименование КАК ОтгрузочноеНаименование,
	|	БазовыеСоответствия.СостояниеГруза КАК СостояниеГруза,
	|	БазовыеСоответствия.МассаБруттоКг КАК МассаБруттоКг,
	|	БазовыеСоответствия.ОбъемКубМ КАК ОбъемКубМ,
	|	БазовыеСоответствия.МассаНеттоКг КАК МассаНеттоКг,
	|	БазовыеСоответствия.ДопИнформация КАК ДопИнформация,
	|	БазовыеСоответствия.ОбъявленнаяЦенность КАК ОбъявленнаяЦенность,
	|	БазовыеСоответствия.ОбъявленнаяЦенностьВалюта КАК ОбъявленнаяЦенностьВалюта,
	|	БазовыеСоответствия.СпособУпаковки КАК СпособУпаковки,
	|	БазовыеСоответствия.ВидТары КАК ВидТары,
	|	БазовыеСоответствия.Плотность КАК Плотность,
	|	БазовыеСоответствия.УчетГрузаВГИС КАК УчетГрузаВГИС,
	|	БазовыеСоответствия.ЗначениеМаркировки КАК ЗначениеМаркировки,
	|	БазовыеСоответствия.ОписаниеОпасногоГруза КАК ОписаниеОпасногоГруза,
	|	БазовыеСоответствия.Высота КАК Высота,
	|	БазовыеСоответствия.Длина КАК Длина,
	|	БазовыеСоответствия.Ширина КАК Ширина,
	|	БазовыеСоответствия.Насыпной КАК Насыпной
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры КАК БазовыеСоответствия
	|		ПО ВТ_Товары.Номенклатура = БазовыеСоответствия.Номенклатура
	|			И (ВТ_Товары.УпаковкаЕдиницаИзмерения = БазовыеСоответствия.УпаковкаЕдиницаИзмерения
	|				ИЛИ БазовыеСоответствия.УпаковкаЕдиницаИзмерения = &ПустаяЕдиницаИзмерения)
	|			И (&ИспользуютсяХарактеристики = ЛОЖЬ
	|				ИЛИ ВТ_Товары.Характеристика = БазовыеСоответствия.Характеристика
	|				ИЛИ ВТ_Товары.Характеристика = &ПустаяХарактеристика
	|					И БазовыеСоответствия.Характеристика = НЕОПРЕДЕЛЕНО)";
	
	Запрос.УстановитьПараметр("ТабТоваров", ТабТоваров);
	
	Запрос.УстановитьПараметр("ПустаяЕдиницаИзмерения", Справочники[Справочники.КонтурЛогистика_Настройки.ПолучитьИмяСправочникаСущности("ЕдиницаИзмерения")].ПустаяСсылка());

	Запрос.УстановитьПараметр("ИспользуютсяХарактеристики", ИспользуютсяХарактеристики);
	Если ИспользуютсяХарактеристики И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() Тогда 
		Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники[Справочники.КонтурЛогистика_Настройки.ПолучитьИмяСправочникаСущности("Характеристика")].ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("ПустаяХарактеристика", Неопределено);
	КонецЕсли;
	
	НесопоставленныеПропускать = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("НесопоставленныеТоварыПропускать");
	Запрос.УстановитьПараметр("НесопоставленныеПропускать", НесопоставленныеПропускать);
	
	Если НесопоставленныеПропускать Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВНУТРЕННЕЕ", "ЛЕВОЕ");	
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	ТабСоответствий = Результат.Выгрузить();
	
	Возврат ТабСоответствий;

КонецФункции

Процедура ЗаполнитьСтрокуТоваровСконвертированнымиЗначениями(СтрокаТоваровВременная, СконвертированныеТоварыДокумента, ДокументОбъект = Неопределено) Экспорт
	
	СтрокаТоваровВременная.Учитывать = Истина; // по умолчанию учитываем
	
	Если ДокументОбъект <> Неопределено Тогда 
		ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъект.Ссылка);
	Иначе
		ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	КонецЕсли;
	
	
	ПоискСредиБазовыхСоответствий = Новый Структура;
	ПоискСредиБазовыхСоответствий.Вставить("Номенклатура", СтрокаТоваровВременная.Номенклатура);	
	ПоискСредиБазовыхСоответствий.Вставить("УпаковкаЕдиницаИзмерения", СтрокаТоваровВременная.УпаковкаЕдиницаИзмерения);
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики") = Истина Тогда 
		ПоискСредиБазовыхСоответствий.Вставить("Характеристика", СтрокаТоваровВременная.Характеристика);
	КонецЕсли;
	
	ДанныеКонвертацииПоСтрокеТовара = СконвертированныеТоварыДокумента.НайтиСтроки(ПоискСредиБазовыхСоответствий);
	
	Если ДанныеКонвертацииПоСтрокеТовара.Количество() >= 1 Тогда // первое попавшееся если несколько
		
		Если ДанныеКонвертацииПоСтрокеТовара[0].Учитывать = Ложь Тогда 
			ДвижокКонвертации_ОчиститьЛогистическиеДанныеСтроки(СтрокаТоваровВременная, ТипТитула);
			СтрокаТоваровВременная.Учитывать = Ложь;
			Возврат;
		КонецЕсли;
				
		Для Каждого Колонка Из СконвертированныеТоварыДокумента.Колонки Цикл
			
			ИмяРеквизита = Колонка.Имя;
			
			// особые реквизиты
			
			Если ИмяРеквизита = "Номенклатура" 
				ИЛИ ИмяРеквизита = "УпаковкаЕдиницаИзмерения" 
				ИЛИ ИмяРеквизита = "Характеристика" 
				Тогда 
				Продолжить;
			КонецЕсли;
			
			Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 
				И ИмяРеквизита = "КодТНВЭД" Тогда 
				Продолжить;
			КонецЕсли;	
			
			Если ИмяРеквизита = "КоэффициентПересчетаМест" Тогда
				
				Коэфф = ДанныеКонвертацииПоСтрокеТовара[0].КоэффициентПересчетаМест;
				Если Коэфф = 0 Тогда 
					Коэфф = 1; // незаполнено - не пересчитываем
				КонецЕсли;
				
				СтрокаТоваровВременная.КоличествоМест = СтрокаТоваровВременная.Количество * Коэфф;
				Продолжить;
				
			ИначеЕсли ИмяРеквизита = "МассаБруттоКг" Тогда
				
				Коэфф = ДанныеКонвертацииПоСтрокеТовара[0].МассаБруттоКг;
				Если Коэфф <> 0 Тогда
					
					Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
						Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
						Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
						Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
						
						Если Не ЗначениеЗаполнено(СтрокаТоваровВременная.МассаПлановаяБруттоКг) Тогда
							СтрокаТоваровВременная.МассаПлановаяБруттоКг = СтрокаТоваровВременная.Количество * Коэфф;
						КонецЕсли;
						
					Иначе
						СтрокаТоваровВременная.МассаБруттоКг = СтрокаТоваровВременная.Количество * Коэфф;
					КонецЕсли;
					
				КонецЕсли;
				
				Продолжить;
				
			ИначеЕсли ИмяРеквизита = "ЗначениеМаркировки" Тогда
				
				Если ДокументОбъект <> Неопределено 
					И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
						ИЛИ ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1)
					И ЗначениеЗаполнено(ДанныеКонвертацииПоСтрокеТовара[0].ЗначениеМаркировки) Тогда
					
					НоваяСтрокаМаркировки = ДокументОбъект.Маркировки.Добавить();
					НоваяСтрокаМаркировки.ИдентификаторСтрокиТоваров = СтрокаТоваровВременная.ИдентификаторСтроки;
					НоваяСтрокаМаркировки.ЗначениеМаркировки = ДанныеКонвертацииПоСтрокеТовара[0].ЗначениеМаркировки;
					
				ИначеЕсли ДокументОбъект <> Неопределено 
					И ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 
					И ЗначениеЗаполнено(ДанныеКонвертацииПоСтрокеТовара[0].ЗначениеМаркировки) Тогда
					
					СтрокаТоваровВременная.Маркировка = ДанныеКонвертацииПоСтрокеТовара[0].ЗначениеМаркировки; 
					
				КонецЕсли;
				
				Продолжить;
				
			ИначеЕсли ИмяРеквизита = "ОписаниеОпасногоГруза" Тогда
				
				Если ДокументОбъект <> Неопределено 
					И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
						ИЛИ ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1)
					И ЗначениеЗаполнено(ДанныеКонвертацииПоСтрокеТовара[0].ОписаниеОпасногоГруза) Тогда
					
					НоваяСтрокаОГ = ДокументОбъект.ОпасныеГрузы.Добавить();
					НоваяСтрокаОГ.ИдентификаторСтрокиТоваров = СтрокаТоваровВременная.ИдентификаторСтроки;
					НоваяСтрокаОГ.ОписаниеОпасногоГруза = ДанныеКонвертацииПоСтрокеТовара[0].ОписаниеОпасногоГруза;
					
					ЗаполнитьЗначенияСвойств(НоваяСтрокаОГ, НоваяСтрокаОГ.ОписаниеОпасногоГруза);
					
				КонецЕсли;
				Продолжить;
				
			ИначеЕсли ИмяРеквизита = "УчетГрузаВГИС" 
				И Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипТитула) Тогда
				
				Продолжить;
				
			ИначеЕсли ИмяРеквизита = "Насыпной" Тогда
				
				Если ДанныеКонвертацииПоСтрокеТовара[0].Насыпной Тогда				
					СтрокаТоваровВременная.КоличествоМест = 1;					
				КонецЕсли;
					
				Продолжить;
				
			КонецЕсли;
			
			// обычные реквизиты
			
			ИмяРеквизитаСтрокиТоваров = ОпределитьИмяРеквизитаТЧВТитуле(ДокументОбъект, ИмяРеквизита);
			
			Если ЗначениеЗаполнено(ИмяРеквизитаСтрокиТоваров) 
				И НЕ ЗначениеЗаполнено(СтрокаТоваровВременная[ИмяРеквизитаСтрокиТоваров]) 
				ИЛИ ИмяРеквизита = "Учитывать" Тогда 
				
				СтрокаТоваровВременная[ИмяРеквизитаСтрокиТоваров] = ДанныеКонвертацииПоСтрокеТовара[0][ИмяРеквизита];
				
			КонецЕсли;
			
			Если ИмяРеквизита = "УчетГрузаВГИС"
				И ЗначениеЗаполнено(ИмяРеквизитаСтрокиТоваров) 
				И СтрокаТоваровВременная.УчетГрузаВГИС = Ложь 
				И ДанныеКонвертацииПоСтрокеТовара[0]["УчетГрузаВГИС"] = Истина Тогда
				
				СтрокаТоваровВременная.УчетГрузаВГИС = Истина;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
	Иначе // Не введены базовые соответствия по этому товару
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ТребоватьНаличиеБазовыхСоответствий")
			И ЗначениеЗаполнено(СтрокаТоваровВременная.Номенклатура) Тогда 
			ДвижокКонвертации_ОчиститьЛогистическиеДанныеСтроки(СтрокаТоваровВременная, ТипТитула);		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьИмяРеквизитаТЧВТитуле(Знач ДокументОбъект, Знач ИмяРеквизита)
	
	Перем ИмяРеквизитаСтрокиТоваров;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул3") Тогда
		Если ИмяРеквизита = "ВидТары" 
		ИЛИ ИмяРеквизита = "ДопИнформация" 
		ИЛИ ИмяРеквизита = "ЗначениеМаркировки" 
		ИЛИ ИмяРеквизита = "КодТНВЭД" 
		ИЛИ ИмяРеквизита = "ОбъявленнаяЦенность" 
		ИЛИ ИмяРеквизита = "ОбъявленнаяЦенностьВалюта" 
		ИЛИ ИмяРеквизита = "ОписаниеОпасногоГруза" 
		ИЛИ ИмяРеквизита = "Плотность" 
		ИЛИ ИмяРеквизита = "СпособУпаковки" 
		ИЛИ ИмяРеквизита = "УчетГрузаВГИС"
		ИЛИ ИмяРеквизита = "Высота"
		ИЛИ ИмяРеквизита = "Длина"
		ИЛИ ИмяРеквизита = "Ширина"
		Тогда
			
			Возврат Неопределено; // в Т3 нет такого реквизита у ТЧ ТоварыДокументаУчетнойСистемы
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЗЗ_Титул1") Тогда
		Если ИмяРеквизита = "ОбъявленнаяЦенность"
			Или ИмяРеквизита = "ОбъявленнаяЦенностьВалюта"
			Или ИмяРеквизита = "СпособУпаковки"
			Или ИмяРеквизита = "Плотность" 
			Или ИмяРеквизита = "УчетГрузаВГИС" Тогда
			
			Возврат Неопределено; // в ЗЗ нет такого реквизита
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяРеквизита = "МассаБруттоКг" Тогда
		Если ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1") Тогда 
			ИмяРеквизитаСтрокиТоваров = "МассаПлановаяБруттоКг";
		ИначеЕсли ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул3") Тогда 
			ИмяРеквизитаСтрокиТоваров = "МассаБруттоКг";
		ИначеЕсли ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЗН_Титул1") Тогда 
			ИмяРеквизитаСтрокиТоваров = "МассаПлановаяБруттоКг";
		ИначеЕсли ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЗЗ_Титул1") Тогда 
			ИмяРеквизитаСтрокиТоваров = "МассаПлановаяБруттоКг";	
		Иначе
			ВызватьИсключение "Не реализовано заполнение";
		КонецЕсли;
		
	ИначеЕсли ИмяРеквизита = "МассаНеттоКг" Тогда
		Если ДокументОбъект <> Неопределено
			И (ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1")
				Или ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЭкспедиторскаяРасписка"))Тогда
			
			ИмяРеквизитаСтрокиТоваров = "МассаПлановаяНеттоКг";
		ИначеЕсли ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул3") Тогда
			ИмяРеквизитаСтрокиТоваров = "МассаНеттоКг";
		ИначеЕсли ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЗН_Титул1") Тогда
			ИмяРеквизитаСтрокиТоваров = "МассаПлановаяНеттоКг";
		ИначеЕсли ДокументОбъект <> Неопределено И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ЗЗ_Титул1") Тогда
			ИмяРеквизитаСтрокиТоваров = "МассаПлановаяНеттоКг";
		Иначе
			ВызватьИсключение "Не реализовано заполнение";
		КонецЕсли;
	Иначе
		ИмяРеквизитаСтрокиТоваров = ИмяРеквизита;
	КонецЕсли;
	
	Возврат ИмяРеквизитаСтрокиТоваров;

КонецФункции

// Функция - Выполняет вычисление по 1 правилу
//
// Параметры:
//  Основание			 - ДокументСсылка, СправочникСсылка, СтрокаТабличнойЧасти - Документ из которого извлекать данные или строка его табличной части
//  ПравилоКонвертации	 - СтрокаТабличнойЧасти - Справочника КонтурЛогистика_НастройкиКонвертации (любой из 3х табличных частей)
//  Объект				 - ЗаполняемыйДокументОбъект - Документ, чье наполнение сейчас производится. (нужен для маппинга способом РеквизитЗаполненногоТитула)
// 
// Возвращаемое значение:
//   Произвольный, Неопределено 
//
Функция ДвижокКонвертации_ВычислитьРеквизитОснования(Основание, ПравилоКонвертации, НастройкаКонвертации, Объект = Неопределено,
	ПрименятьКонвертациюВЛогистСущности = Истина, Переменные = Неопределено, ДокументОснование = Неопределено,
	ДокументОснованиеТаблицыТовары = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	ВычисленноеЗначение = Неопределено;
	
	// TODO прописать все возможные валидации от СпособМаппинга
	Попытка
		
		Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) 
			ИЛИ ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) 
			ИЛИ ЗначениеЗаполнено(ПравилоКонвертации.КлючДопСвойстваРеквизита) 
			ИЛИ ЗначениеЗаполнено(ПравилоКонвертации.СвойствоОбъекта) Тогда 
			
			Если ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение Тогда 
				
				ВычисленноеЗначение = ПравилоКонвертации.ВыражениеВычисления;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначениеОбщейНастройки Тогда
				
				ВычисленноеЗначение = ПравилоКонвертации.ВыражениеВычисления.Значение;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования
				Или ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС
				Или ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента Тогда
				
				текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(Основание, ПравилоКонвертации,, Переменные);
				
				ВычисленноеЗначение = текРеквизит;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула Тогда
				
				Если Объект = Неопределено Тогда
					ВызватьИсключение "ДвижокКонвертации: Ошибка при вычислении " + ПравилоКонвертации.РеквизитТитула + " не передан ДокументОбъект";
				КонецЕсли;
				
				текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(Объект, ПравилоКонвертации, Истина, Переменные);
				
				ВычисленноеЗначение = текРеквизит;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула Тогда
				
				Если Объект = Неопределено Тогда
					ВызватьИсключение "ДвижокКонвертации: Ошибка при вычислении " + ПравилоКонвертации.РеквизитТитула + " не передан ДокументОбъект";
				КонецЕсли;
				ТипПредыдущегоТитула = ПравилоКонвертации.ВыражениеВычисления2;
				
				Если Не ЗначениеЗаполнено(ТипПредыдущегоТитула) Тогда
					ВызватьИсключение "ДвижокКонвертации: Ошибка при вычислении " +
						ПравилоКонвертации.РеквизитТитула +
						" для способа конвертации ""Из предыдущего титула"" не указано из какого по счету титула извлекать данные";
				Иначе
					
					Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипПредыдущегоТитула) Тогда
						ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ТипПредыдущегоТитула, Объект.ДокументЭТРН);
					Иначе
						ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ТипПредыдущегоТитула, Объект.Титул1);
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ТипПредыдущегоТитула) Тогда
						ВызватьИсключение "ДвижокКонвертации: Ошибка при вычислении " +
							ПравилоКонвертации.РеквизитТитула +
							" для способа конвертации ""Из предыдущего титула"" не смог найти предыдущий титул: " + ТипПредыдущегоТитула;
						
					Иначе
						
						текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(ПредыдущийТитул, ПравилоКонвертации,, Переменные);
						
						ВычисленноеЗначение = текРеквизит;
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда
				
				РезультатВычисления = Неопределено;
				
				Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) Тогда
					ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр;
				ИначеЕсли ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) Тогда
					ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисления;
				Иначе
					ВыражениеВычисления = Неопределено;
				КонецЕсли;
				
				Если ВыражениеВычисления <> Неопределено Тогда
					
					Параметры = Новый Структура;
					Параметры.Вставить("Основание", Основание);
					Параметры.Вставить("ПравилоКонвертации", ПравилоКонвертации);
					Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
					Параметры.Вставить("Объект", Объект);
					Параметры.Вставить("Переменные", Переменные);
					Параметры.Вставить("ДокументОснование", ДокументОснование);
					Параметры.Вставить("ДокументОснованиеТаблицыТовары", ДокументОснованиеТаблицыТовары);
					
					ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
						ВыражениеВычисления, Параметры);			
										
				Иначе
					
					ВычисленноеЗначение = Неопределено;
					
				КонецЕсли;
					
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопСвойство 
				ИЛИ ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопРеквизит Тогда
				
				ВычисленноеЗначение = ДвижокКонвертации_ВычислитьДопСвойствоРевизитаДокумента(Основание, ПравилоКонвертации, Переменные);
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.КонтактнаяИнформация Тогда
				
				ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
				Если ИмяКонфигурации1С = "УТ"
					Или ИмяКонфигурации1С = "УПП" Тогда
					
					ВычисленноеЗначение = ДвижокКонвертации_ВычислитьКонтактнуюИнформациюСтараяРевизитаДокумента(Основание, ПравилоКонвертации, ИмяКонфигурации1С);
				Иначе
					ВычисленноеЗначение = ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРевизитаДокумента(Основание, ПравилоКонвертации);
				КонецЕсли;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначенияСвойствОбъектов Тогда
				
				Запрос = Новый Запрос;
				
				Запрос.Текст = "ВЫБРАТЬ
				|	ЗначенияСвойствОбъектов.Значение
				|ИЗ
				|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
				|ГДЕ
				|	ЗначенияСвойствОбъектов.Объект = &Объект
				|	И ЗначенияСвойствОбъектов.Свойство.Код = &Свойство";
				
				Запрос.УстановитьПараметр("Объект", ?(ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления), Основание[ПравилоКонвертации.ВыражениеВычисления], Основание));
				Запрос.УстановитьПараметр("Свойство", ПравилоКонвертации.СвойствоОбъекта);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					ВычисленноеЗначение = Выборка.Значение;
				КонецЕсли;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДокументФизическогоЛица Тогда
				
				ВычисленноеЗначение = ДвижокКонвертации_ВычислитьДокументФизическогоЛицаДляРевизитаДокумента(Основание, ПравилоКонвертации);
						
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов Тогда
				
				Запрос = Новый Запрос;
				
				Запрос.Текст = "ВЫБРАТЬ
               |	ДоговорыКонтрагентов.Ссылка КАК Ссылка
               |ИЗ
               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
               |ГДЕ
               |	ДоговорыКонтрагентов.Владелец = &Объект
               |	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
               |	И ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
               |
               |УПОРЯДОЧИТЬ ПО
               |	ДоговорыКонтрагентов.Дата ВОЗР";
				
				МетаданныеСправочника = Вычислить("Метаданные.Справочники.ДоговорыКонтрагентов");
				
				Если КонтурЛогистика_ОбщегоНазначенияСервер.ЕстьРеквизитОбъекта_("Контрагент", МетаданныеСправочника) Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "Владелец", "Контрагент");
				КонецЕсли;
				
				Если Метаданные.Справочники.Найти("СтатусыДоговоровКонтрагентов") = Неопределено Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)", "Истина");
				КонецЕсли;
				
				Запрос.УстановитьПараметр("Объект", Основание[ПравилоКонвертации.ВыражениеВычисления]);
				Запрос.УстановитьПараметр("Дата", Основание.Дата);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Количество() = 1 Или ПравилоКонвертации.ВыражениеВычисления2 = Истина Тогда
							
					Если Выборка.Следующий() Тогда
						ВычисленноеЗначение = Выборка.Ссылка;
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
				Или ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда
				
				ВычисленноеЗначение = Неопределено;
				Результат.Вставить("Значение", ВычисленноеЗначение);
				Результат.Успешно = Истина;
				Возврат Результат;
				
			Иначе // НеЗаполнять
				
				ВычисленноеЗначение = Неопределено;
				
			КонецЕсли;
			
		Иначе
			
			Результат.ОписаниеОшибки = "Не указано выражение вычисления";
			ВычисленноеЗначение = Неопределено;
			
		КонецЕсли;
		
	Исключение
		
		ВычисленноеЗначение = Неопределено;
		Результат.ОписаниеОшибки = ДвижокКонвертации_ОписаниеОшибкиКонвертации(НастройкаКонвертации, ПравилоКонвертации, ОписаниеОшибки());
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Результат.ОписаниеОшибки, ?(ЗначениеЗаполнено(НастройкаКонвертации), НастройкаКонвертации, Неопределено));
		
	КонецПопытки;
	
	// извлеченное значение заполнено?
	ВычисленноеЗначениеНеПустое = ДвижокКонвертации_ВычисленноеЗначениеНеПустое(ВычисленноеЗначение);
	
	СконвертированноеЗначение = Неопределено;
	Если Не ПрименятьКонвертациюВЛогистСущности Тогда
		
		СконвертированноеЗначение = ВычисленноеЗначение;
		
	Иначе
		
		Если ВычисленноеЗначениеНеПустое 
			Или (Не ВычисленноеЗначениеНеПустое 
				И ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьПоТаблицеСоответствий) Тогда 
			
			Если ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки
				Или ПравилоКонвертации.СпособКонвертацииЗначения.Пустая() Тогда 
				
				СконвертированноеЗначение = ВычисленноеЗначение;
				
			Иначе
				
				РезультатКонвертации = ДвижокКонвертации_Конвертировать(ВычисленноеЗначение, ПравилоКонвертации, Основание, НастройкаКонвертации, Объект, Переменные);
				Если РезультатКонвертации.Успешно Тогда 
					СконвертированноеЗначение = РезультатКонвертации.Значение;
				Иначе
					СконвертированноеЗначение = Неопределено;
					Результат.ОписаниеОшибки = РезультатКонвертации.ОписаниеОшибки;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Результат.Успешно = Истина;
			Результат.ОписаниеОшибки = "Извлечененное значение пустое";
			СконвертированноеЗначение = Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СконвертированноеЗначение <> Неопределено Тогда 
		Результат.Успешно = Истина; // но это не значит что СконвертированноеЗначение = Неопределено это ошибка. Например прицеп может быть не указан и это не ошибка
	КонецЕсли;
	
	// особые доконвертации
	Если Не Метаданные.НайтиПоТипу(Тип(ПравилоКонвертации)).Реквизиты.Найти("РеквизитТитула") = Неопределено
		И ЗначениеЗаполнено(СконвертированноеЗначение)
		И ПравилоКонвертации.РеквизитТитула = "ДатаТрН" Тогда  
		
		СконвертированноеЗначение = НачалоДня(СконвертированноеЗначение);   
		
	КонецЕсли;
	
	Результат.Вставить("Значение", СконвертированноеЗначение);
	
	Возврат Результат
	
КонецФункции

Функция ДвижокКонвертации_ВычисленноеЗначениеНеПустое(Знач ВычисленноеЗначение)
	
	Перем Пустое;
	
	Пустое = Ложь;
	
	Если ВычисленноеЗначение = "" 
		ИЛИ ВычисленноеЗначение = Неопределено 
		ИЛИ ВычисленноеЗначение = Дата(1,1,1) 
		ИЛИ (ВычисленноеЗначение = 0 И ТипЗнч(ВычисленноеЗначение) = Тип("Число")) 
		ИЛИ (ТипЗнч(ВычисленноеЗначение) = Тип("Массив") И ВычисленноеЗначение.Количество() = 0) Тогда 
		
		Пустое = Истина;
		
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТипЗнч(ВычисленноеЗначение)) Тогда
		
		Попытка
			
			Если ВычисленноеЗначение.Пустая() Тогда 
				Пустое = Истина;
			КонецЕсли;
			
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Не Пустое;

КонецФункции

Функция ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(Знач Основание, Знач ПравилоКонвертации, ОснованиеЯвляетсяОбъектом = Ложь, Переменные, ВичислениеОтказДобавленияСтроки = Ложь)
	
	Перем МассивРеквизитов, РасчетныйРеквизит, текРеквизит;
	
	Если Не ОснованиеЯвляетсяОбъектом И Не ЗначениеЗаполнено(Основание) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВичислениеОтказДобавленияСтроки Тогда
		ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисленияДобавлятьСтроку;
	ИначеЕсли ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) И ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда
		ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр;
	ИначеЕсли ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) Тогда
		ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисления;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Найти(ПравилоКонвертации.ВыражениеВычисления, "Переменные.") > 0 Тогда 
		
		// объектом доп. свойства является переменная
		Параметры = Новый Структура;
		Параметры.Вставить("ПравилоКонвертации", ПравилоКонвертации);
		Параметры.Вставить("Основание", Основание);
		Параметры.Вставить("Переменные", Переменные);
		
		текРеквизит = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			СокрЛП(ВыражениеВычисления), Параметры);
		
	Иначе
		
		// реквизиты могут быть составными через точку
		
		текРеквизит = Основание;
		МассивРеквизитов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СокрЛП(ВыражениеВычисления), ".");
		Для Каждого РасчетныйРеквизит Из МассивРеквизитов Цикл
			
			ИндексКвадратнойСкобкиОткрытия = Найти(РасчетныйРеквизит, "[");
			ИндексКвадратнойСкобкиЗакрытия = Найти(РасчетныйРеквизит, "]");
			Если ИндексКвадратнойСкобкиОткрытия = 0 Или ИндексКвадратнойСкобкиЗакрытия = 0 Тогда
				
				текРеквизит = текРеквизит[РасчетныйРеквизит];
				
				КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСервер.ПроверитьВычислитьДополнительныйРеквизит(РасчетныйРеквизит, текРеквизит);
								
			Иначе
				// Наличие конкретного элемента. Наример: ДокументыОснования[0]
				ИмяРеквизита = Лев(РасчетныйРеквизит, ИндексКвадратнойСкобкиОткрытия - 1);
				ИндексСтроки = Сред(РасчетныйРеквизит, ИндексКвадратнойСкобкиОткрытия + 1, СтрДлина(РасчетныйРеквизит) - ИндексКвадратнойСкобкиЗакрытия + 1);
				текРеквизит = текРеквизит[ИмяРеквизита][Число(ИндексСтроки)];
			КонецЕсли;
									
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат текРеквизит;

КонецФункции

Функция ДвижокКонвертации_ВычислитьПроизвольнуюТабЧастьПоВыражениюВычисления(Знач Основание, Знач ПравилоКонвертации, ОснованиеЯвляетсяОбъектом = Ложь, Переменные)
	
	Перем МассивРеквизитов, РасчетныйРеквизит, текРеквизит;
	
	Если Не ОснованиеЯвляетсяОбъектом И Не ЗначениеЗаполнено(Основание) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПравилоКонвертации.ПутьТЧИсходногоДокумента) Тогда
		ВыражениеВычисления = ПравилоКонвертации.ПутьТЧИсходногоДокумента;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВыражениеВычисления <> Неопределено Тогда
		
		Параметры = Новый Структура;
		Параметры.Вставить("Основание", Основание);
		Параметры.Вставить("ПравилоКонвертации", ПравилоКонвертации);
		Параметры.Вставить("Переменные", Переменные);
		
		ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			ВыражениеВычисления, Параметры);
		
	Иначе
		
		ВычисленноеЗначение = Неопределено;
		
	КонецЕсли;
	
	Возврат ВычисленноеЗначение;
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьДопСвойствоРевизитаДокумента(ДокументОснование, ПравилоКонвертации, Переменные)
	
	Значение = Неопределено;
	
	Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) Или ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) Тогда 
		ОбъектСДопСвойствомРеквизитомСсылка = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(ДокументОснование, ПравилоКонвертации,, Переменные);
	Иначе
		ОбъектСДопСвойствомРеквизитомСсылка = ДокументОснование; // сам исходный документ
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПравилоКонвертации.КлючДопСвойстваРеквизита) Тогда
		ИмяПВХ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяПВХДопСвойства");
		Свойство = ПланыВидовХарактеристик[ИмяПВХ].НайтиПоРеквизиту("Имя", ПравилоКонвертации.КлючДопСвойстваРеквизита);
	Иначе
		Вызватьисключение "Не передан ключ допсвойства объекта"
	КонецЕсли;
	
	Если ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопСвойство Тогда 
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ОбъектСДопСвойствомРеквизитомСсылка);
		Запрос.УстановитьПараметр("Свойство", Свойство);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|    ДополнительныеСведения.Значение
		|ИЗ
		|    РегистрСведений.УчетнаяСистема_ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|    ДополнительныеСведения.Объект = &Ссылка
		|    И ДополнительныеСведения.Свойство = &Свойство";   
		
		// Кастомизация имени УчетнаяСистема_ДополнительныеСведения
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УчетнаяСистема_ДополнительныеСведения", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяРегистраДопСвойства"));
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Количество() = 0 Тогда
			Значение = Неопределено;
		Иначе
			Результат.Следующий();
			Значение = Результат.Значение;
		КонецЕсли; 
		
	ИначеЕсли ПравилоКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопРеквизит Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Свойство",Свойство);
		
		Массив = ОбъектСДопСвойствомРеквизитомСсылка.ДополнительныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
		
		Если Массив.Количество() = 0 Тогда
			Значение = Неопределено;
		Иначе
			Значение = Массив[0].Значение;
		КонецЕсли;
		
	Иначе
		
		Вызватьисключение "Не предполагаемый способ маппинга"
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРевизитаДокумента(Основание, ПравилоКонвертации)
	
	Попытка
		// Определим имя справочника для расчета родителя контактной информации
		ИмяСправочника = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(Основание);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ИмяВидаКонтактнойИнформации = "Справочники.ВидыКонтактнойИнформации.Справочник" + ИмяСправочника;
	
	Попытка
		РодительВидаКонтактнойИнформации = Вычислить(ИмяВидаКонтактнойИнформации);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(РодительВидаКонтактнойИнформации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РодительВидаКонтактнойИнформации", РодительВидаКонтактнойИнформации);
	Запрос.УстановитьПараметр("ИдентификаторДляФормул", ПравилоКонвертации.ВыражениеВычисления);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка КАК ВидКИ
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	НЕ ВидыКонтактнойИнформации.ПометкаУдаления
	|	И ВидыКонтактнойИнформации.Родитель = &РодительВидаКонтактнойИнформации
	|	И ВидыКонтактнойИнформации.ИдентификаторДляФормул = &ИдентификаторДляФормул";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// Значит в текущей версии конфигурации нет реквизита "ИдентификаторДляФормул"
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ИдентификаторДляФормул", ".Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
	КонецПопытки;
	
	Если Выборка.Следующий() Тогда
		Возврат Вычислить("УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Основание, Выборка.ВидКИ, ТекущаяДатаСеанса())");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьДокументФизическогоЛицаДляРевизитаДокумента(Основание, ПравилоКонвертации)
		
	Если Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления)
		Или Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления2) Тогда
		Возврат Неопределено;
	КонецЕсли;   
	
	НаименованиеРеквизита = ПравилоКонвертации.ВыражениеВычисления;
	НаименованиеВидаДокумента = ПравилоКонвертации.ВыражениеВычисления2;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", НаименованиеВидаДокумента);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыДокументовФизическихЛиц.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыДокументовФизическихЛиц КАК ВидыДокументовФизическихЛиц
	|ГДЕ
	|	ВидыДокументовФизическихЛиц.Наименование = &Наименование
	|	И НЕ ВидыДокументовФизическихЛиц.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ВидДокументаФЛ = Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ФизЛицо", Основание);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыФизическихЛицСрезПоследних." + НаименованиеРеквизита + " КАК Значение
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&ТекущаяДата, Физлицо = &ФизЛицо) КАК ДокументыФизическихЛицСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьКонтактнуюИнформациюСтараяРевизитаДокумента(Основание, ПравилоКонвертации, ИмяКонфигурации1С)
	
	Если Лев(ПравилоКонвертации.ВыражениеВычисления, 5) = "Адрес" Тогда
		
		// Адрес
		ТипАдреса = Вычислить("СтрЗаменить(ПравилоКонвертации.ВыражениеВычисления, ""Адрес"", """")");
		Возврат Вычислить("УправлениеКонтактнойИнформацией.ПолучитьАдресИзКонтактнойИнформации(Основание, ТипАдреса)");
		
	Иначе
		
		// Телефон
		Если ИмяКонфигурации1С = "УТ" Тогда
			
			Возврат Вычислить("УправлениеКонтактнойИнформацией.ПолучитьТелефонИзКонтактнойИнформации(Основание)");
			
		Иначе
			
			ВидТелефона = Вычислить("Справочники.ВидыКонтактнойИнформации[ПравилоКонвертации.ВыражениеВычисления]");
			Возврат Вычислить("УправлениеКонтактнойИнформацией.ПолучитьТелефонИзКонтактнойИнформации(Основание, ВидТелефона)");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция ДвижокКонвертации_Конвертировать(ВычисленноеЗначение, ПравилоКонвертации, ДокументОснование, НастройкаКонвертации, ТекДокументОбъект = Неопределено, Переменные = Неопределено)
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	СконвертированноеЗначение = Неопределено;
	
	Попытка
		
		Если ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок 
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПодразделениеДиадок
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута 
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство 
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника 
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор 
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВЛицензию 
			ИЛИ ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВГорючеСмазочныйМатериал
			Тогда
			
			// может быть ситуация при которой ВычисленноеЗначение уже требуемого (сконвертированного) типа 
			// и требуется просто вернуть его без конвертации
			НайденныйТипЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.СоответствиеТиповЗначениям().Получить(ТипЗнч(ВычисленноеЗначение));
			Если НайденныйТипЗначения <> Неопределено
				И НайденныйТипЗначения = ПравилоКонвертации.СпособКонвертацииЗначения Тогда 
				
				Результат.Успешно = Истина;
				Результат.Вставить("Значение", ВычисленноеЗначение);
				Возврат Результат;
				
			КонецЕсли;
			
			// выполняется конвертация запросом
			Попытка
				СсылкаНаОбъектЛогистика = КонтурЛогистика_КонвертацияСерверПовтИсп.ДвижокКонвертации_ВыполнитьЗапросКонвертации(ВычисленноеЗначение, ПравилоКонвертации.СпособКонвертацииЗначения);
			Исключение
				СсылкаНаОбъектЛогистика = Неопределено;
			КонецПопытки;
			
			Если СсылкаНаОбъектЛогистика <> Неопределено Тогда
					
				ЗаполнитьРезультатКонвертацииИлиСинхронизации(Результат,
															  СконвертированноеЗначение,
															  ПравилоКонвертации,
															  ВычисленноеЗначение,
															  ДокументОснование,
															  СсылкаНаОбъектЛогистика,
															  Переменные,
															  "СИНХРОНИЗАЦИЯ",
															  ТекДокументОбъект);
				
			Иначе
				
				ЗаполнитьРезультатКонвертацииИлиСинхронизации(Результат,
															  СконвертированноеЗначение,
															  ПравилоКонвертации,
															  ВычисленноеЗначение,
															  ДокументОснование,
															  ,
															  Переменные,
															  "КОНВЕРТАЦИЯ",
															  ТекДокументОбъект);
															  
			КонецЕсли;
			
		ИначеЕсли ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьМассивСтруктур Тогда
			
			СконвертированноеЗначение = ВычисленноеЗначение;
			
		ИначеЕсли ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьПоТаблицеСоответствий Тогда
			
			НайденныеСтроки = НайтиЗначениеВТаблицеСоответствий(НастройкаКонвертации, ПравилоКонвертации, ВычисленноеЗначение);
			НайденныеСтрокиСНеопределено = НайтиЗначениеВТаблицеСоответствий(НастройкаКонвертации, ПравилоКонвертации, Неопределено);
			
			Если НайденныеСтроки.Количество() Тогда
				
				СконвертированноеЗначение = НайденныеСтроки[0].ВыражениеВычисления;
				
			ИначеЕсли НайденныеСтрокиСНеопределено.Количество() И Не ЗначениеЗаполнено(ВычисленноеЗначение) Тогда
				
				СконвертированноеЗначение = НайденныеСтрокиСНеопределено[0].ВыражениеВычисления;
				
			Иначе
				
				НайденныеСтроки = НайтиЗначениеВТаблицеСоответствий(НастройкаКонвертации, ПравилоКонвертации, "<в остальных случаях>");
				
				Если НайденныеСтроки.Количество() Тогда
					
					СконвертированноеЗначение = НайденныеСтроки[0].ВыражениеВычисления;	
					
				Иначе
				
					Результат.ОписаниеОшибки = "Неудача при конвертации значения: " + ВычисленноеЗначение
						+ " по документу: " + ДокументОснование + " по настройке конвертации: " + НастройкаКонвертации;
					
				КонецЕсли;	
				
			КонецЕсли;
			
		Иначе
			
			ВызватьИсключение "Неизвестный способ конвертации по настройке: " + ПравилоКонвертации.СпособКонвертацииЗначения;
			
		КонецЕсли;
		
	Исключение
		
		Результат.ОписаниеОшибки = "Неудача при конвертации значения: " + ВычисленноеЗначение
			+ " по документу: " + ДокументОснование
			+ " по настройке конвертации: " + НастройкаКонвертации + Символы.ПС
			+ " по причине:" + ОписаниеОшибки();
		
	КонецПопытки;
	
	Результат.Успешно = (Не СконвертированноеЗначение = Неопределено);
	Результат.Вставить("Значение", СконвертированноеЗначение);
	
	Возврат Результат;
	
КонецФункции

Функция НайтиЗначениеВТаблицеСоответствий(НастройкаКонвертации, ПравилоКонвертации, Значение)
	
	ЭтоПравилаКонвертацииДокументов = (Не ТипЗнч(ПравилоКонвертации) =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииСправочников.ПравилаКонвертации"));
	
	ТаблицаСоответствий = НастройкаКонвертации.ТаблицаСоответствий;
	
	Если ЭтоПравилаКонвертацииДокументов Тогда
		
		ПараметрыОтбора = ОтборТаблицыСоответствийНастройкиКонвертацииДокументов(ПравилоКонвертации);
		ПараметрыОтбора.Вставить("ИзвлеченноеЗначение", Значение);
		
		НайденныеСтроки = ТаблицаСоответствий.НайтиСтроки(ПараметрыОтбора);
		
	Иначе
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("РеквизитСправочникаЛогистика", ПравилоКонвертации.РеквизитСправочникаЛогистика);
		ПараметрыОтбора.Вставить("ИзвлеченноеЗначение", Значение);
		
		НайденныеСтроки = ТаблицаСоответствий.НайтиСтроки(ПараметрыОтбора);
		
	КонецЕсли;
	
	Возврат НайденныеСтроки;
	
КонецФункции

Функция ПолучитьПервоеСоответствие(Основание)
	
	СвязанныеОбъекты = Основание.СвязанныеОбъекты;
	Если СвязанныеОбъекты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущиеДанные = СвязанныеОбъекты[0];
	Если Не КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТипЗнч(ТекущиеДанные.СвязанныйОбъект))
		И ЗначениеЗаполнено(ТекущиеДанные.УИД)
		И ЗначениеЗаполнено(ТекущиеДанные.ТипЗначенияУИД) Тогда
		
		НайденнаяСсылка = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСсылкуПоУИД(ТекущиеДанные.УИД, ТекущиеДанные.ТипЗначенияУИД);
		
		Возврат НайденнаяСсылка;
		
	Иначе
		
		Возврат ТекущиеДанные.СвязанныйОбъект;
		
	КонецЕсли;
	
КонецФункции

Функция ОтборТаблицыСоответствийНастройкиКонвертацииДокументов(ПравилоКонвертации)
	
	ОтбораТаблицыСоответствий = Новый Структура("ИмяТабличнойЧасти, ИмяРеквизитаЗначения");
	
	ТипЗнчПравила = ТипЗнч(ПравилоКонвертации);
	
	Если ТипЗнчПравила =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.ПравилаКонвертацииГлавногоДокумента") Тогда
		
		ОтбораТаблицыСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииГлавногоДокумента";
		ОтбораТаблицыСоответствий.ИмяРеквизитаЗначения = ПравилоКонвертации.РеквизитТитула;
		
	ИначеЕсли ТипЗнчПравила =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.ПравилаКонвертацииТитулаРеквизиты") Тогда
		
		ОтбораТаблицыСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииТитулаРеквизиты";
		ОтбораТаблицыСоответствий.ИмяРеквизитаЗначения = ПравилоКонвертации.РеквизитТитула;
		
	ИначеЕсли ТипЗнчПравила =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.ПравилаКонвертацииТитулаТабЧастьТовары") Тогда
		
		ОтбораТаблицыСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииТитулаТабЧастьТовары";
		ОтбораТаблицыСоответствий.ИмяРеквизитаЗначения = ПравилоКонвертации.РеквизитТитула;
		
	ИначеЕсли ТипЗнчПравила =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.Переменные") Тогда
		
		ОтбораТаблицыСоответствий.ИмяТабличнойЧасти = "Переменные";
		ОтбораТаблицыСоответствий.ИмяРеквизитаЗначения = Строка(ПравилоКонвертации.ИмяТабЧасти)
			+ "_" + Строка(ПравилоКонвертации.Имя);
		
	ИначеЕсли ТипЗнчПравила =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.ПравилаКонвертацииТитулаТабЧастьПроизвольная") Тогда
		
		ОтбораТаблицыСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииТитулаТабЧастьПроизвольная";
		ОтбораТаблицыСоответствий.ИмяРеквизитаЗначения = Строка(ПравилоКонвертации.ИмяТЧТитула)
			+ "_" + Строка(ПравилоКонвертации.РеквизитТитула);
		
	ИначеЕсли ТипЗнчПравила =
		Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПравилаКонвертации") Тогда
		
		ОтбораТаблицыСоответствий = Новый Структура;
		ОтбораТаблицыСоответствий.Вставить("РеквизитРегистраСведений", ПравилоКонвертации.РеквизитРегистраСведений);
		
	КонецЕсли;
	
	Возврат ОтбораТаблицыСоответствий;
	
КонецФункции

Функция ДвижокКонвертации_СинхронизироватьРеквизитыУчетнойИЛогистическойСущностей(УчетнаяСущность, ЛогистическаяСущность,
	НастройкаКонвертацииСправочников, ДокументОснование = Неопределено, Переменные = Неопределено, СинхронизироватьВсегда = Ложь) Экспорт 
	
	РезультатСинхронизации = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	РезультатСинхронизации.Успешно = Истина;
	РезультатСинхронизации.Вставить("Значение", ЛогистическаяСущность);
	
	Если СинхронизироватьВсегда Или НастройкаКонвертацииСправочников.ОбновлятьРеквизитыИзУчетнойСистемы Тогда 
	
		РезультатВычисления = ВычислитьРеквизитыСсылкиУчетнойСистемыПоНастройкеКонвертации(УчетнаяСущность, 
								НастройкаКонвертацииСправочников, ДокументОснование,, Переменные);
		
		Если Не РезультатВычисления.Успешно Тогда 
						
			Возврат РезультатВычисления;
			
		КонецЕсли;	
		
		ВычисленныеРеквизиты = РезультатВычисления.Значение;
		
		ОбъектЛогистики = ЛогистическаяСущность.ПолучитьОбъект();
		
		Для Каждого ВычисленныйРеквизит Из ВычисленныеРеквизиты Цикл
			
			Если ЗначениеЗаполнено(ВычисленныйРеквизит.Ошибка) Тогда
				РезультатСинхронизации.МассивОшибок.Добавить(ВычисленныйРеквизит.Ошибка);
			КонецЕсли;
			
			Если Не ВычисленныйРеквизит.Обновить И Не СинхронизироватьВсегда Тогда
				Продолжить;
			КонецЕсли;
			
			Если НастройкаКонвертацииСправочников.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
				И (ВычисленныйРеквизит.Реквизит = "МожетПодписывать"
					Или ВычисленныйРеквизит.Реквизит = "МожетПередаватьНаПодпись") Тогда
				
				// Заполним разрешения
				Для Каждого ТекущееРазрешение Из ОбъектЛогистики.РазрешенияРаботыСДокументами Цикл
					ТекущееРазрешение[ВычисленныйРеквизит.Реквизит] = ВычисленныйРеквизит.Значение;
				КонецЦикла;
				
			Иначе
				
				ОбъектЛогистики[ВычисленныйРеквизит.Реквизит] = ВычисленныйРеквизит.Значение;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОбъектЛогистики.Записать();
		
	КонецЕсли;
	
	Если РезультатСинхронизации.МассивОшибок.Количество() <> 0 Тогда
		РезультатСинхронизации.Успешно = Ложь;
		РезультатСинхронизации.ОписаниеОшибки = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(
			РезультатСинхронизации.МассивОшибок, Символы.ПС + Символы.ПС);
	КонецЕсли;
	
	Возврат РезультатСинхронизации;
	
КонецФункции

Процедура ДвижокКонвертации_ОчиститьЛогистическиеДанныеСтроки(СтрокаТоваров, ТипТитула) Экспорт
	
	// Очистим визуально заметные реквизиты
	СтрокаТоваров.КоличествоМест 			= 0;
	Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		ИЛИ ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
		Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		СтрокаТоваров.МассаПлановаяБруттоКг 	= 0;
		СтрокаТоваров.МассаПлановаяНеттоКг		= 0;
		СтрокаТоваров.ВидТары 					= Справочники.КонтурЛогистика_КлассификаторУпаковок.ПустаяСсылка();
		СтрокаТоваров.ОтгрузочноеНаименование	= "";
		СтрокаТоваров.ДопИнформация				= "";
		
		Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
			СтрокаТоваров.УчетГрузаВГИС			= ложь;
		КонецЕсли;
		
		Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
			ИЛИ ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда 
			
		    СтрокаТоваров.СпособУпаковки		= "";
			СтрокаТоваров.КодТНВЭД				= "";
			СтрокаТоваров.ОбъявленнаяЦенность	= 0;
			СтрокаТоваров.Плотность				= 0;
			
		КонецЕсли;
		
	ИначеЕсли ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		СтрокаТоваров.МассаБруттоКг 	= 0;
		СтрокаТоваров.МассаНеттоКг		= 0;
		
	Иначе
		ВызватьИсключение "Не реализовано";
	КонецЕсли;
	
	СтрокаТоваров.СостояниеГруза		= "";
	СтрокаТоваров.ОбъемКубМ				= 0;
	Если НЕ ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда 
		СтрокаТоваров.КоличествоПаллет		= 0;
	КонецЕсли;
	
КонецПроцедуры

Функция ДвижокКонвертации_КонвертироватьВычисленноеЗначениеВОбъектЛогистики(ВычисленноеЗначение, ПравилоКонвертации, ДокументОснование, НастройкаКонвертацииСправочников, ТекДокументОбъект = Неопределено, Переменные = Неопределено)
					
	// ВЫЧИСЛЕНИЕ РЕКВИЗИТОВ СПРАВОЧНИКА ЛОГИСТИКА

	РезультатВычисления = ВычислитьРеквизитыСсылкиУчетнойСистемыПоНастройкеКонвертации(ВычисленноеЗначение, 
							НастройкаКонвертацииСправочников,
							ДокументОснование,
							ТекДокументОбъект,
							Переменные);
	
	Если Не РезультатВычисления.Успешно Тогда 
				
		Возврат РезультатВычисления;
		
	КонецЕсли;	
	
	ВычисленныеРеквизиты = РезультатВычисления.Значение;
	
	// ПОИСК ЛОГИСТИЧЕСКОЙ СУЩНОСТИ ПО ОПРЕДЕЛЕННЫМ ПОЛЯМ ПОИСКА
	
	РезультатПоиска = ПоискОбъектаЛогистикиПоКлючевымРеквизитам(ВычисленноеЗначение, ПравилоКонвертации.СпособКонвертацииЗначения, ВычисленныеРеквизиты);	
	
	Если РезультатПоиска.Успешно Тогда 
		
		Возврат ДвижокКонвертации_СинхронизироватьРеквизитыУчетнойИЛогистическойСущностей(ВычисленноеЗначение, РезультатПоиска.Значение, НастройкаКонвертацииСправочников, ДокументОснование, Переменные);
				
	Иначе
		
		Если Не РезультатПоиска.СоздатьОбъект Тогда 
						
			Возврат РезультатПоиска;
			
		КонецЕсли;
	
	КонецЕсли;
	
	МенеджерСправочника = МодульМенеджераПоСпособуКонвертации(ПравилоКонвертации.СпособКонвертацииЗначения);
	
	// КОНВЕРТАЦИЯ УЧЕТНОЙ СУЩНОСТИ В ЛОГИСТИЧЕСКУЮ СУЩНОСТЬ
	
	Если ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок Тогда  
			
		РезультатКонвертации = Справочники.КонтурЛогистика_ОрганизацииДиадок.КонвертироватьВычисленноеЗначениеВОбъектЛогистики(ВычисленныеРеквизиты, ВычисленноеЗначение);
		
	Иначе
		
		РезультатКонвертации = КонвертироватьВычисленноеЗначениеВОбъектЛогистики(ВычисленныеРеквизиты, ВычисленноеЗначение, МенеджерСправочника);
		
	КонецЕсли;
		
	Возврат РезультатКонвертации;
	
КонецФункции		

Функция ДвижокКонвертации_КонвертироватьОбъектЛогистикиВОбъектУС(НастройкаКонвертацииСправочников, РеквизитДокОснования, Переменные) Экспорт
	
	ВычисленноеЗначение = Неопределено;
	
	// ВЫЧИСЛЕНИЕ РЕКВИЗИТОВ ДЛЯ ЗАПОЛНЕНИЯ СПРАВОЧНИКА УС           

	РезультатВычисления = ВычислитьРеквизитыЛогистикиПоНастройкеКонвертацииУчСист(РеквизитДокОснования,
							НастройкаКонвертацииСправочников,
							Переменные);
	
	Если Не РезультатВычисления.Успешно Тогда 
				
		Возврат РезультатВычисления;
		
	КонецЕсли;	
	
	ВычисленныеРеквизиты = РезультатВычисления.Значение;
	ТипСправочникаИлиДокументаУС = НастройкаКонвертацииСправочников.ТипСправочникаИлиДокументаУС;
	
	// ПОИСК ЭЛЕМЕНТА СПРАВОЧНИКА ПО КЛЮЧЕВЫМ ПОЛЯМ ПОИСКА
	
	РезультатПоиска = ПоискОбъектаУСПоКлючевымРеквизитам(ВычисленноеЗначение, НастройкаКонвертацииСправочников, ВычисленныеРеквизиты);	
	
	Если РезультатПоиска.Успешно Тогда 
		
		Возврат ВычисленноеЗначение; 
				
	Иначе
		
		Если Не РезультатПоиска.СоздатьОбъект Тогда 
						
			Возврат РезультатПоиска;
			
		КонецЕсли;
	
	КонецЕсли;
		
	// КОНВЕРТАЦИЯ ЛОГИСТИЧЕСКАЯ СУЩНОСТЬ В УЧЕТНУЮ СУЩНОСТЬ
	РезультатКонвертации = СконвертироватьСправочникУчетнойСистемыПоДаннымНКС(ВычисленныеРеквизиты, ТипСправочникаИлиДокументаУС);
	
	Возврат РезультатКонвертации;
	
КонецФункции

Функция ПоискОбъектаУСПоКлючевымРеквизитам(ВычисленноеЗначение, НастройкаКонвертацииСправочников, ВычисленныеРеквизиты)
	
	ТипСправочникаИлиДокументаУС = НастройкаКонвертацииСправочников.ТипСправочникаИлиДокументаУС;

	РезультатПоиска = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	РезультатПоиска.Вставить("СоздатьОбъект", Ложь);
		
	Запрос = БазовыйЗапросДляПоискаУчСист(ТипСправочникаИлиДокументаУС);	
	ОшибкаДобавления = ДобавитьПараметрыВЗапросПоискаСправочникаУС(Запрос, ВычисленныеРеквизиты);
	
	Если ЗначениеЗаполнено(ОшибкаДобавления) Тогда 
		
		РезультатПоиска.Успешно = Ложь;
		РезультатПоиска.ОписаниеОшибки = ОшибкаДобавления;
		
	Иначе
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			РезультатПоиска.Успешно = Истина;
			РезультатПоиска.Вставить("Значение", Выборка.Ссылка);
			
			ВычисленноеЗначение = Выборка.Ссылка;
			
		Иначе
			
			РезультатПоиска.Успешно = Ложь;
			РезультатПоиска.ОписаниеОшибки = "Объект Справочника " + ТипСправочникаИлиДокументаУС + " не найден по ключевым полям.";
			РезультатПоиска.СоздатьОбъект = НастройкаКонвертацииСправочников.СоздаватьЭлементСправочникаУчетнойСистемы;
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат РезультатПоиска;

КонецФункции

Функция ВычислитьРеквизитыЛогистикиПоНастройкеКонвертацииУчСист(РеквизитДокОснования, НастройкаКонвертацииСправочников, Переменные = Неопределено) 
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ВычисленныеРеквизиты = ОписаниеТаблицыВычисленныхРеквизитов();
	
	Для Каждого ПравилоКонвертацииСправочника Из НастройкаКонвертацииСправочников.ЗаполнениеСпрУчСист Цикл 
		          
		Если ПравилоКонвертацииСправочника.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять
			Или ПравилоКонвертацииСправочника.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.Очистить 
			Или ПравилоКонвертацииСправочника.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПустаяСсылка() Тогда 
			Продолжить;
		КонецЕсли;
		
		Значение = ПравилоКонвертацииСправочника.ВыражениеВычисления;
		
		ВычисленныйРеквизит = ВычисленныеРеквизиты.Добавить();         
		
		ВычисленныйРеквизит.Реквизит 						= ПравилоКонвертацииСправочника.Реквизит; //Реквизит УС
		ВычисленныйРеквизит.Ошибка 							= "";
		ВычисленныйРеквизит.ТипАлгоритма 					= ПравилоКонвертацииСправочника.ТипАлгоритма; 
		ВычисленныйРеквизит.КлючевоеПоле 					= ПравилоКонвертацииСправочника.КлючевоеПоле;
		ВычисленныйРеквизит.СпособРасчета 					= ПравилоКонвертацииСправочника.СпособРасчета;
		ВычисленныйРеквизит.ОбновитьИзДокУчСист 			= ПравилоКонвертацииСправочника.ОбновитьИзДокУчСист;
		ВычисленныйРеквизит.ВыражениеВычисления			 	= ПравилоКонвертацииСправочника.ВыражениеВычисления;
		ВычисленныйРеквизит.ВыражениеВычисленияСтрокаНеогр 	= ПравилоКонвертацииСправочника.ВыражениеВычисленияСтрокаНеогр;
		
		Если ПравилоКонвертацииСправочника.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ФиксированноеЗначение Тогда
			ВычисленныйРеквизит.Значение = Значение; 
		ИначеЕсли ПравилоКонвертацииСправочника.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика Тогда 
			ВычисленныйРеквизит.Значение = РеквизитДокОснования[Значение];
		Иначе
			ВычисленныйРеквизит.Значение = Значение;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВычисленныеРеквизиты.Количество() Тогда 
		
		Результат.Успешно = Истина;
		Результат.Вставить("Значение", ВычисленныеРеквизиты); 
		
	Иначе
									
		Результат.ОписаниеОшибки = "Не заданы правила конвертации или правила настроены некорректно";
		
	КонецЕсли;	
	
	Возврат Результат;	
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьРеквизитОснованияУчСист(Основание, ПравилоКонвертации, НастройкаКонвертации, Объект = Неопределено, ПрименятьКонвертациюВЛогистСущности = Истина, Переменные = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	ВычисленноеЗначение = Неопределено;
	
	Попытка
		
		Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) 
			ИЛИ ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) 
			ИЛИ ЗначениеЗаполнено(ПравилоКонвертации.КлючДопСвойстваРеквизита) 
			ИЛИ ЗначениеЗаполнено(ПравилоКонвертации.СвойствоОбъекта) Тогда 
			
			Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика Тогда
				
				текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления(Основание, ПравилоКонвертации,, Переменные);
				
				ВычисленноеЗначение = текРеквизит;
				
			Иначе // НеЗаполнять
				
				ВычисленноеЗначение = Неопределено;
				
			КонецЕсли;
			
		Иначе
			
			Результат.ОписаниеОшибки = "Не указано выражение вычисления";
			ВычисленноеЗначение = Неопределено;
			
		КонецЕсли;
		
	Исключение
		
		ВычисленноеЗначение = Неопределено;
		Результат.ОписаниеОшибки = ДвижокКонвертации_ОписаниеОшибкиКонвертации(НастройкаКонвертации, ПравилоКонвертации, ОписаниеОшибки());
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Результат.ОписаниеОшибки, ?(ЗначениеЗаполнено(НастройкаКонвертации), НастройкаКонвертации, Неопределено));
		
	КонецПопытки;
	
	// извлеченное значение заполнено?
	ВычисленноеЗначениеНеПустое = ДвижокКонвертации_ВычисленноеЗначениеНеПустое(ВычисленноеЗначение);
	
	СконвертированноеЗначение = Неопределено;
	Если Не ПрименятьКонвертациюВЛогистСущности Тогда
		
		СконвертированноеЗначение = ВычисленноеЗначение;
		
	Иначе
		
		Если ВычисленноеЗначениеНеПустое 
			Или (Не ВычисленноеЗначениеНеПустое 
				И ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьПоТаблицеСоответствий) Тогда 
			
			Если ПравилоКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки
				Или ПравилоКонвертации.СпособКонвертацииЗначения.Пустая() Тогда 
				
				СконвертированноеЗначение = ВычисленноеЗначение;
				
			Иначе
				
				РезультатКонвертации = ДвижокКонвертации_Конвертировать(ВычисленноеЗначение, ПравилоКонвертации, Основание, НастройкаКонвертации, Объект, Переменные);
				Если РезультатКонвертации.Успешно Тогда 
					СконвертированноеЗначение = РезультатКонвертации.Значение;
				Иначе
					СконвертированноеЗначение = Неопределено;
					Результат.ОписаниеОшибки = РезультатКонвертации.ОписаниеОшибки;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Результат.Успешно = Истина;
			Результат.ОписаниеОшибки = "Извлечененное значение пустое";
			СконвертированноеЗначение = Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СконвертированноеЗначение <> Неопределено Тогда 
		Результат.Успешно = Истина; // но это не значит что СконвертированноеЗначение = Неопределено это ошибка. Например прицеп может быть не указан и это не ошибка
	КонецЕсли;
	
	// особые доконвертации
	Если Не Метаданные.НайтиПоТипу(Тип(ПравилоКонвертации)).Реквизиты.Найти("РеквизитТитула") = Неопределено 
		И ПравилоКонвертации.РеквизитТитула = "ДатаТрН" Тогда  
		
		СконвертированноеЗначение = НачалоДня(СконвертированноеЗначение);   
		
	КонецЕсли;
	
	Результат.Вставить("Значение", СконвертированноеЗначение);
	
	Возврат Результат
	
КонецФункции

Процедура ДвижокКонвертации_ЗаполнитьТабЧастьТоварыПоДокументуУчетнойСистемы(ТЗ_ТоварыВременная, Знач НастройкаКонвертации, ДокументОбъект,
	ДокументОснование = Неопределено, Переменные = Неопределено) Экспорт
	
	Если ДокументОснование = Неопределено Тогда
		ДокументОснование = ДокументОбъект.ДокументОснование;
	КонецЕсли;
	
	ВычисленноеЗначение = Неопределено;
	РодительскаяНастройка = НастройкаКонвертации;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьДочерниеНастройкиКонвертации(НастройкаКонвертации) Тогда
		ВычисленноеЗначение = ПереключитьсяНаДочернююНастройкуЕслиОнаПредусмотрена(ДокументОбъект, ДокументОснование, НастройкаКонвертации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации.ИмяТабЧастьТовары) И Не НастройкаКонвертации.НетТабЧастиТовары Тогда 
		Возврат;
	КонецЕсли;
	
	Если Переменные = Неопределено Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ДокументОбъект, ДокументОснование, НастройкаКонвертации, "");
	КонецЕсли;
	
	Если НастройкаКонвертации.ТоварыИзДополнительногоДокумента Тогда
		Основание = ВычисленноеЗначение;
	Иначе
		Основание = ДокументОснование;
	КонецЕсли;
	
	Если НастройкаКонвертации <> Неопределено
		И (ЗначениеЗаполнено(Основание)
			Или НастройкаКонвертации.ТипДокумента1С = "") Тогда
		
		// Получить массив контейнеров с табчастями (ТРНка может быть по нескольким документам РТУ - у каждого своя ТЧ,
		// если документов всего один - то в массиве контенеров будет 1 элемент)
		Если ЗначениеЗаполнено(НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары) И Не НастройкаКонвертации.НетТабЧастиТовары Тогда
			
			Если Найти(НРег(НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары), "переменные.") > 0 Тогда
				МассивКонтейнеровсТабЧастями = Вычислить(НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары);
				
			ИначеЕсли Найти(НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары, ".") > 0 Тогда
				
				ВыражениеВычисленияТЧ = "ТекущийПараметр." + НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары;
				ПараметрыВычисления = Новый Структура("ТекущийПараметр", Основание);
				МассивКонтейнеровсТабЧастями = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьВБезопасномРежиме(ВыражениеВычисленияТЧ, ПараметрыВычисления);
				
			Иначе
				МассивКонтейнеровсТабЧастями = Основание[НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары];
			КонецЕсли;
			
		Иначе
			МассивКонтейнеровсТабЧастями = Новый Массив;
			МассивКонтейнеровсТабЧастями.Добавить(Основание); // таб. часть товаров - реквизит самого документа
		КонецЕсли;
		
		// Может быть необязательно массивом, но обязан поддерживать обход!
		Для Каждого ЭлементКоллекцииКонтейнеров Из МассивКонтейнеровсТабЧастями Цикл 
			
			ДокументОснованиеТаблицыТовары = Неопределено;
			
			// Обойти контейнеры - извлечь ТЧ
			Если НастройкаКонвертации.НетТабЧастиТовары Тогда
				
				ТЧ_Контейнера = Новый Массив;
				ТЧ_Контейнера.Добавить(Основание);
				
			ИначеЕсли ЗначениеЗаполнено(НастройкаКонвертации.ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ) Тогда 
				// Элементы коллекции - строки ТЧ, содаржащие контейнер, надо сначала обратиться к ячейке ТЧ для получения контейнера
				
				ТЧ_Контейнера = ЭлементКоллекцииКонтейнеров[НастройкаКонвертации.ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ][НастройкаКонвертации.ИмяТабЧастьТовары];
				
				ДокументОснованиеТаблицыТовары = ЭлементКоллекцииКонтейнеров[НастройкаКонвертации.ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ];
				
			Иначе
				
				// Элементы коллекции - уже контейнеры
				Если Найти(НРег(НастройкаКонвертации.ИмяТабЧастьТовары), "переменные.") > 0 Тогда
					
					ТЧ_Контейнера = Вычислить(НастройкаКонвертации.ИмяТабЧастьТовары);
					
				ИначеЕсли Найти(НастройкаКонвертации.ИмяТабЧастьТовары, ".") > 0 Тогда
					
					ВыражениеВычисленияТЧ = "ТекущийПараметр." + НастройкаКонвертации.ИмяТабЧастьТовары;
					ПараметрыВычисления = Новый Структура("ТекущийПараметр", ЭлементКоллекцииКонтейнеров);
					ТЧ_Контейнера = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьВБезопасномРежиме(ВыражениеВычисленияТЧ, ПараметрыВычисления);
					
				Иначе
					
					ТЧ_Контейнера = ЭлементКоллекцииКонтейнеров[НастройкаКонвертации.ИмяТабЧастьТовары];
					ДокументОснованиеТаблицыТовары = ЭлементКоллекцииКонтейнеров;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Для Каждого СтрокаТЧТоваровУчетногоДокумента Из ТЧ_Контейнера Цикл
				
				Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
					И ЗначениеЗаполнено(ДокументОбъект.Разделитель) 
					И НЕ СтрокаТоваровПодходитПоРазделителю(СтрокаТЧТоваровУчетногоДокумента, НастройкаКонвертации, ДокументОбъект,  ДокументОбъект.Разделитель) Тогда  
					Продолжить;
				КонецЕсли;
				
				Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
					И НЕ СтрокаТоваровПодходитПоРазделителю(СтрокаТЧТоваровУчетногоДокумента, НастройкаКонвертации, ДокументОбъект) Тогда  
					Продолжить;
				КонецЕсли;
				
				НоваяСтрокаТоваров = ТЗ_ТоварыВременная.Добавить();
				НоваяСтрокаТоваров.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
				
				Если НастройкаКонвертации.НетТабЧастиТовары Тогда
					ИмяТабЧастьТовары = "";
				Иначе
					
					ИмяТабЧастьТовары = НастройкаКонвертации.ИмяТабЧастьТовары;
					
					ПеременныеТЧ = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ДокументОбъект, Основание, 
						НастройкаКонвертации, ИмяТабЧастьТовары);
					
					Для Каждого ПеременнаяТЧ Из ПеременныеТЧ Цикл 
						Переменные.Вставить(ПеременнаяТЧ.Ключ, ПеременнаяТЧ.Значение);
					КонецЦикла;
					
				КонецЕсли;
				
				ЗаполнитьСтрокуТЧТовары(НоваяСтрокаТоваров, СтрокаТЧТоваровУчетногоДокумента, НастройкаКонвертации, РодительскаяНастройка, 
					ДокументОбъект, Основание, Переменные, ДокументОснованиеТаблицыТовары)
				 								
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуТЧТовары(НоваяСтрокаТоваров, СтрокаТЧТоваровУчетногоДокумента, НастройкаКонвертации, РодительскаяНастройка = Неопределено, 
	ДокументОбъект, Основание = Неопределено, Переменные = Неопределено, ДокументОснованиеТаблицыТовары = Неопределено) Экспорт
	
	Если Переменные = Неопределено Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ДокументОбъект, ДокументОбъект.ДокументОснование, НастройкаКонвертации, "");
	КонецЕсли;
	
	Для Каждого СтрокаНастройкиКонвертацииТЧТовары Из НастройкаКонвертации.ПравилаКонвертацииТитулаТабЧастьТовары Цикл
					
		ТекущаяНастройкаКонвертации = НастройкаКонвертации;
		ТекущееПравилоКонвертацииТитула = СтрокаНастройкиКонвертацииТЧТовары;
		
		// Возьмем настройку и правило из родителя
		Если СтрокаНастройкиКонвертацииТЧТовары.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзРодительскойНастройки
			И ЗначениеЗаполнено(РодительскаяНастройка) Тогда
			
			ТекущаяНастройкаКонвертации = РодительскаяНастройка;
			
			// Найдем правило в родителе
			Для Каждого ТекущаяСтрока Из РодительскаяНастройка.ПравилаКонвертацииТитулаТабЧастьТовары Цикл
				Если ТекущаяСтрока.РеквизитТитула <> СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула Тогда
					Продолжить;
				КонецЕсли;
				
				ТекущееПравилоКонвертацииТитула = ТекущаяСтрока;
				Прервать;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТекущееПравилоКонвертацииТитула.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			СтрокаТЧТоваровУчетногоДокумента, ТекущееПравилоКонвертацииТитула, ТекущаяНастройкаКонвертации,
			ДокументОбъект,, Переменные, Основание, ДокументОснованиеТаблицыТовары);
		
		Если РезультатВычисления.Успешно Тогда
			
			Если ТекущееПравилоКонвертацииТитула.РеквизитТитула = "МаркировкиМассив" Тогда
				
				// Ожидаем в РезультатВычисления.Значение массив или строка
				ДвижокКонвертации_ЗаполнитьРеквизитПоСтрокеТоваров(
					ДокументОбъект, Основание, НоваяСтрокаТоваров, РезультатВычисления, ТекущееПравилоКонвертацииТитула);
				
			ИначеЕсли ТекущееПравилоКонвертацииТитула.РеквизитТитула = "КонтейнерыМассив" Тогда
				
				// Ожидаем в РезультатВычисления.Значение массив или строка
				ДвижокКонвертации_ЗаполнитьРеквизитПоСтрокеТоваров(
					ДокументОбъект, Основание, НоваяСтрокаТоваров, РезультатВычисления, ТекущееПравилоКонвертацииТитула);
				
			ИначеЕсли ТекущееПравилоКонвертацииТитула.РеквизитТитула = "ОпасныеГрузыМассивСтруктур" Тогда
				
				// Ожидаем в РезультатВычисления.Значение МассивСтруктур
				ДвижокКонвертации_ЗаполнитьОпасныеГрузыПоСтрокеТоваров(
					ДокументОбъект, Основание, НоваяСтрокаТоваров, РезультатВычисления, ТекущееПравилоКонвертацииТитула);
				
			ИначеЕсли ТекущееПравилоКонвертацииТитула.РеквизитТитула = "СведенияГосСистемыМассивСтруктур" Тогда
				
				// Ожидаем в РезультатВычисления.Значение МассивСтруктур(НаимГосСист,УчетЕд,ИнаяИнф,ИдНомУчетЕд)
				ДвижокКонвертации_ЗаполнитьСведенияГосСистемПоСтрокеТоваров(
					ДокументОбъект, Основание, НоваяСтрокаТоваров, РезультатВычисления, ТекущееПравилоКонвертацииТитула);
				
			Иначе
				
				// Простой реквизит ТЧ товары
				НоваяСтрокаТоваров[ТекущееПравилоКонвертацииТитула.РеквизитТитула] = РезультатВычисления.Значение;
				
			КонецЕсли;
		Иначе
			Сообщить("Не удалось рассчитать: " + ТекущееПравилоКонвертацииТитула.РеквизитТитула
				+ " по " + Основание + " - " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатВычисления));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДвижокКонвертации_ЗаполнитьРеквизитПоСтрокеТоваров(ДокументОбъект, Знач ДокументОснование, Знач НоваяСтрокаТоваров, Знач РезультатВычисления, Знач СтрокаНастройкиКонвертацииТЧТовары)
	
	// Не считаем пустое значение как ошибка
	Если РезультатВычисления.Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Определим имя таблицы данных и имя реквизита данных
	Если СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула = "МаркировкиМассив" Тогда
		ИмяТаблицыДанных = "Маркировки";
		ИмяРеквизитаДанных = "ЗначениеМаркировки";
	ИначеЕсли СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула = "КонтейнерыМассив" Тогда
		ИмяТаблицыДанных = "Контейнеры";
		ИмяРеквизитаДанных = "ИдНомерКонтейнера";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(РезультатВычисления.Значение) = Тип("Строка") Тогда
		
		НоваяСтрока = ДокументОбъект[ИмяТаблицыДанных].Добавить();
		НоваяСтрока.ИдентификаторСтрокиТоваров = НоваяСтрокаТоваров.ИдентификаторСтроки;
		НоваяСтрока[ИмяРеквизитаДанных] = РезультатВычисления.Значение;
		
	ИначеЕсли ТипЗнч(РезультатВычисления.Значение) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из РезультатВычисления.Значение Цикл
			НоваяСтрока = ДокументОбъект[ИмяТаблицыДанных].Добавить();
			НоваяСтрока.ИдентификаторСтрокиТоваров = НоваяСтрокаТоваров.ИдентификаторСтроки;
			НоваяСтрока[ИмяРеквизитаДанных] = ЭлементМассива;
		КонецЦикла;
		
	Иначе
		
		ТекстСообщения =
			"Ошибка в вычисленном значении: "
			+ СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула + " по " + ДокументОснование + " - "
			+ "Ожидается строка или массив, а вычислено: " + ТипЗнч(РезультатВычисления.Значение) + " значение: " + РезультатВычисления.Значение;
		
		Сообщить(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДвижокКонвертации_ЗаполнитьОпасныеГрузыПоСтрокеТоваров(ДокументОбъект, Знач ДокументОснование, Знач НоваяСтрокаТоваров, Знач РезультатВычисления, Знач СтрокаНастройкиКонвертацииТЧТовары)
	
	// Не считаем пустое значение как ошибка
	Если РезультатВычисления.Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(РезультатВычисления.Значение);
	
	Если ТипЗначения = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из РезультатВычисления.Значение Цикл
			НоваяСтрока = ДокументОбъект.ОпасныеГрузы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
			НоваяСтрока.ИдентификаторСтрокиТоваров = НоваяСтрокаТоваров.ИдентификаторСтроки;
		КонецЦикла;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.КонтурЛогистика_ОписанияОпасныхГрузов") Тогда
		
		Если ЗначениеЗаполнено(РезультатВычисления.Значение) Тогда
			НоваяСтрока = ДокументОбъект.ОпасныеГрузы.Добавить();
			НоваяСтрока.ОписаниеОпасногоГруза = РезультатВычисления.Значение;
			НоваяСтрока.ИдентификаторСтрокиТоваров = НоваяСтрокаТоваров.ИдентификаторСтроки;
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения =
			"Ошибка в вычисленном значении: "
			+ СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула + " по " + ДокументОснование + " - "
			+ "Ожидается массив структур или описание опасного груза ссылка, а вычислено: "
			+ ТипЗнч(РезультатВычисления.Значение) + " значение: " + РезультатВычисления.Значение;
		
		Сообщить(ТекстСообщения);
		
	КонецЕсли;

КонецПроцедуры

Процедура ДвижокКонвертации_ЗаполнитьСведенияГосСистемПоСтрокеТоваров(ДокументОбъект, Знач ДокументОснование, Знач НоваяСтрокаТоваров, Знач РезультатВычисления, Знач СтрокаНастройкиКонвертацииТЧТовары)
	
	// Не считаем пустое значение как ошибка
	Если РезультатВычисления.Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(РезультатВычисления.Значение) = Тип("Массив") Тогда
		
		Для Каждого ТекущаяСтрока Из РезультатВычисления.Значение Цикл
			НоваяСтрока = ДокументОбъект.СведенияГосСистем.Добавить();
			НоваяСтрока.ИдентификаторСтрокиТоваров = НоваяСтрокаТоваров.ИдентификаторСтроки;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
	Иначе
		
		ТекстСообщения =
			"Ошибка в вычисленном значении: "
			+ СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула + " по " + ДокументОснование + " - "
			+ "Ожидается МассивСтруктур(НаимГосСист,УчетЕд,ИнаяИнф,ИдНомУчетЕд), а вычислено: " + ТипЗнч(РезультатВычисления.Значение)
			+ " значение: " + РезультатВычисления.Значение;
		
		Сообщить(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДвижокКонвертации_ОписаниеОшибкиКонвертации(НастройкаКонвертации, ПравилоКонвертации, ПодробноеОписаниеОшибки)
	
	ОписаниеОшибки = "";
	
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
			
		ОписаниеОшибки = ?(ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов"), "НКД: ", "НКС: ") + НастройкаКонвертации.Наименование;
		
		стрТип = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Строка(ТипЗнч(ПравилоКонвертации)), ":", Ложь);
		Если стрТип.Количество() > 1 Тогда
			ОписаниеОшибки = ОписаниеОшибки + ": " + стрТип[стрТип.Количество() - 1] + Символы.ПС;
		Иначе
			ОписаниеОшибки = ОписаниеОшибки + Символы.ПС;
		КонецЕсли;
			
	КонецЕсли;
	
	ОписаниеОшибки = ОписаниеОшибки + "Не удалось вычислить " + ПравилоКонвертации.ВыражениеВычисления + ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр + " по причине: " + ПодробноеОписаниеОшибки;
	
	Возврат ОписаниеОшибки;
	
КонецФункции

Функция СтрокаТоваровПодходитПоРазделителю(СтрокаТоваровДокументаОснования, НастройкаКонвертации, ДокументОбъект, РазделительВДокументе = Неопределено)

	Если ЗначениеЗаполнено(РазделительВДокументе) 
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		РезультатВычисления = Неопределено;
		
		Если ЗначениеЗаполнено(НастройкаКонвертации.РазделительУсловиеСтрокиТоваров) Тогда
			ВыражениеВычисления = НастройкаКонвертации.РазделительУсловиеСтрокиТоваров;
		Иначе
			ВыражениеВычисления = Неопределено;
		КонецЕсли;
		
		Если ВыражениеВычисления <> Неопределено Тогда
			
			Параметры = Новый Структура;
			Параметры.Вставить("СтрокаТоваровДокументаОснования", СтрокаТоваровДокументаОснования);
			Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
			Параметры.Вставить("ДокументОбъект", ДокументОбъект);
			Параметры.Вставить("РазделительВДокументе", РазделительВДокументе);
			
			ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
				ВыражениеВычисления, Параметры);
			
		Иначе
			
			ВычисленноеЗначение = Истина;
			
		КонецЕсли;
		
		Если ВычисленноеЗначение = Истина Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		
		Возврат  Истина;
		
	КонецЕсли;
	
КонецФункции

Функция ВычислитьРеквизитыСсылкиУчетнойСистемыПоНастройкеКонвертации(СсылкаУчетнойСистемы, НастройкаКонвертацииСправочников, ДокументОснование = Неопределено, ТекДокументОбъект = Неопределено, Переменные = Неопределено) 
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ВычисленныеРеквизиты = ОписаниеТаблицыВычисленныхРеквизитов();
	
	Для Каждого ПравилоКонвертацииСправочника Из НастройкаКонвертацииСправочников.ПравилаКонвертации Цикл 
		
		Если ПравилоКонвертацииСправочника.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
			Или ПравилоКонвертацииСправочника.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда 
			Продолжить;
		КонецЕсли;
		
		ВычисленныйРеквизит = ВычисленныеРеквизиты.Добавить();         
		
		ВычисленныйРеквизит.Реквизит 	= ПравилоКонвертацииСправочника.РеквизитСправочникаЛогистика;
		ВычисленныйРеквизит.Ошибка 		= "";
		ВычисленныйРеквизит.Обновить	= ПравилоКонвертацииСправочника.ОбновитьИзУчетнойСистемы;
		
		Если ПравилоКонвертацииСправочника.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования Тогда 
			Основание = ДокументОснование;
		Иначе
			Основание = СсылкаУчетнойСистемы; // любые другие способы 
		КонецЕсли;
		
		РезультатРасчета = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			Основание, ПравилоКонвертацииСправочника, НастройкаКонвертацииСправочников, ТекДокументОбъект,, Переменные, ДокументОснование);
		
		Если РезультатРасчета.Успешно Тогда
			
			Если ЗначениеЗаполнено(РезультатРасчета.Значение) Тогда
				РезультатРасчета.Значение = ДополнительноОбработатьРезультатКонвертации(РезультатРасчета.Значение, НастройкаКонвертацииСправочников, ПравилоКонвертацииСправочника);
			КонецЕсли;
			ВычисленныйРеквизит.Значение = РезультатРасчета.Значение;
			
		Иначе
			
			ВычисленныйРеквизит.Ошибка = РезультатРасчета.ОписаниеОшибки;
			Если ЗначениеЗаполнено(ВычисленныйРеквизит.Ошибка) Тогда
				Результат.МассивОшибок.Добавить(ВычисленныйРеквизит.Ошибка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат.МассивОшибок.Количество() = 0 Тогда
		
		Результат.Успешно = Истина;
		Результат.Вставить("Значение", ВычисленныеРеквизиты);
		
	Иначе
		
		Результат.ОписаниеОшибки = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(
			Результат.МассивОшибок, Символы.ПС + Символы.ПС);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДополнительноОбработатьРезультатКонвертации(РезультатРасчетаЗначение, НастройкаКонвертацииСправочников, ПравилоКонвертацииСправочника)
	
	// Уберем из регистрационного номера транспортного средства лишние символы
	Если НастройкаКонвертацииСправочников.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства"
		И ПравилоКонвертацииСправочника.РеквизитСправочникаЛогистика = "РегНомер"
		И ТипЗнч(РезультатРасчетаЗначение) = Тип("Строка") Тогда
	
		УдалитьЛишниеСимволыИзСтроки(РезультатРасчетаЗначение);
		
	ИначеЕсли НастройкаКонвертацииСправочников.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (ПравилоКонвертацииСправочника.РеквизитСправочникаЛогистика = "ВУСерия"
			Или ПравилоКонвертацииСправочника.РеквизитСправочникаЛогистика = "ВУНомер")
		И ТипЗнч(РезультатРасчетаЗначение) = Тип("Строка") Тогда
		
		УдалитьЛишниеСимволыИзСтроки(РезультатРасчетаЗначение);
		
	КонецЕсли;
	
	Возврат РезультатРасчетаЗначение
	
КонецФункции

Процедура УдалитьЛишниеСимволыИзСтроки(ЗначениеСтроки)
	
	ЛишниеСимволы = Новый Массив;
	ЛишниеСимволы.Добавить(" ");
	ЛишниеСимволы.Добавить(Символы.НПП);
	ЛишниеСимволы.Добавить("_");
	
	Для Каждого Символ Из ЛишниеСимволы Цикл
		ЗначениеСтроки = СтрЗаменить(ЗначениеСтроки, Символ, "");
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатКонвертацииИлиСинхронизации(Результат, 
														СконвертированноеЗначение, 
														ПравилоКонвертации, 
														УчетнаяСущность, 
														ДокументОснование, 
														ЛогистическаяСущность = Неопределено,
														Переменные = Неопределено,
														ТипФункция = "КОНВЕРТАЦИЯ",
														ТекДокументОбъект = Неопределено)
														
	ЭтоКонвертация = ТипФункция = "КОНВЕРТАЦИЯ";
														
	ЭтоПравилоКонвертацииПеременных	= ТипЗнч(ПравилоКонвертации) = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.Переменные");
	
	Если Не ЭтоКонвертация И ЭтоПравилоКонвертацииПеременных Тогда 
		СконвертированноеЗначение = ЛогистическаяСущность;
		Возврат
	КонецЕсли;	
	
    ШаблонОшибки = НСтр("ru = 'Неудача при синхронизации значения: %1 по документу: %2 по настройке конвертации: %3.'");
	
	Если ЭтоПравилоКонвертацииПеременных Тогда
		
		ШаблонОшибки = СтрЗаменить(ШаблонОшибки, "синхронизации значения", "конвертации переменной"); 
		Реквизит = ПравилоКонвертации.Имя;
		
	Иначе
		
		Если ЭтоКонвертация Тогда
			ШаблонОшибки = СтрЗаменить(ШаблонОшибки, "синхронизации", "конвертации");
		КонецЕсли;
		
		Если ТипЗнч(ПравилоКонвертации) = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииСправочников.ПравилаКонвертации") Тогда
			Реквизит = ПравилоКонвертации.РеквизитСправочникаЛогистика;
		ИначеЕсли ТипЗнч(ПравилоКонвертации) = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПравилаКонвертации") Тогда
			Реквизит = ПравилоКонвертации.РеквизитРегистраСведений;
		Иначе
			Реквизит = ПравилоКонвертации.РеквизитТитула;
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонОшибки,
			УчетнаяСущность, 
			ДокументОснование,
			Реквизит);
	
		
	Ссылка = ?(ВычисленноеЗначениеСсылка(УчетнаяСущность), УчетнаяСущность, ДокументОснование);
	
	ОМ_УчетнаяСущность 	= ОбъектМетеданныхПоСсылке(Ссылка);	
	ОМ_Логистика 		= ОбъектМетаданныхПоСпособуКонвертации(ПравилоКонвертации.СпособКонвертацииЗначения);
	
	Если ТипЗнч(ПравилоКонвертации) = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииДокументов.ПравилаКонвертацииТитулаТабЧастьПроизвольная") 
		И ЗначениеЗаполнено(ПравилоКонвертации.ИмяРеквизитаПоискаНКС) Тогда
		
		РезультатПоиска = ПолучитьНастройкуКонвертацииСправочников(
			ОМ_УчетнаяСущность, ОМ_Логистика, ПравилоКонвертации.КонвертироватьПоНастройке, ПравилоКонвертации.ИмяРеквизитаПоискаНКС);
		
	Иначе
			
		РезультатПоиска = ПолучитьНастройкуКонвертацииСправочников(
			ОМ_УчетнаяСущность, ОМ_Логистика, ПравилоКонвертации.КонвертироватьПоНастройке, Реквизит);
			
	КонецЕсли;
		
	// Если вычисленное значение = строка, то поищем НКС из строки в объект
	Если Не РезультатПоиска.Успешно И ТипЗнч(УчетнаяСущность) = Тип("Строка") Тогда
		РезультатПоиска = ПолучитьНастройкуКонвертацииСправочников(
			Новый Структура("Имя", "Строка"), ОМ_Логистика, ПравилоКонвертации.КонвертироватьПоНастройке, Реквизит);		
	КонецЕсли;
		
	Если РезультатПоиска.Успешно Тогда 
		
		Если ЭтоКонвертация Тогда 
			
			Если ВключенаНастройкаАвтоконвертации(ОМ_Логистика.Имя) Тогда
				
				РезультатКонвертацииИлиСинхронизации = ДвижокКонвертации_КонвертироватьВычисленноеЗначениеВОбъектЛогистики(
					УчетнаяСущность, ПравилоКонвертации, ДокументОснование, РезультатПоиска.Значение, ТекДокументОбъект, Переменные);
				
			Иначе
				
				Результат.ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + "Не найдено соответствие и не включена автоконвертация";
				Возврат;
				
			КонецЕсли;

		Иначе
			
			РезультатКонвертацииИлиСинхронизации = ДвижокКонвертации_СинхронизироватьРеквизитыУчетнойИЛогистическойСущностей(
				УчетнаяСущность, ЛогистическаяСущность, РезультатПоиска.Значение, ДокументОснование, Переменные);	
			
		КонецЕсли;
	
		Если РезультатКонвертацииИлиСинхронизации.Успешно Тогда 
			
			СконвертированноеЗначение = РезультатКонвертацииИлиСинхронизации.Значение;
			
		Иначе
			
			Результат.ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + РезультатКонвертацииИлиСинхронизации.ОписаниеОшибки;
			
		КонецЕсли;
		
	Иначе
		
		Если ЭтоКонвертация Тогда 
			
			ШаблонОшибкиПолученияНастройки = НСтр("ru = 'Конвертация из справочника/документа учетной системы: %1 в справочник Логистики: %2.'");
		
			ОшибкаПолученияНастройки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонОшибкиПолученияНастройки,
										ОМ_УчетнаяСущность.Имя,
										ОМ_Логистика.Имя);
				
			ДобавитьОписаниеОшибкиКРезультату(ОшибкаПолученияНастройки, РезультатПоиска); 
			
			Результат.ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + РезультатПоиска.ОписаниеОшибки;
			
			
		Иначе
			
			СконвертированноеЗначение = ЛогистическаяСущность;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Функция КонвертироватьЗначениеВОбъектЛогистики(ОбъектУчетнойСистемы, НастройкаКонвертации, СпособКонвертацииЗначения, ЭтоКонвертация) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ИмяСправочникаЛогистикаПоСпособуКонвертации = Перечисления.КонтурЛогистика_СпособыКонвертации.ИмяСправочникаЛогистикаПоСпособуКонвертации(
		СпособКонвертацииЗначения);
	
	ПравилоКонвертации = Новый Структура;
	ПравилоКонвертации.Вставить("СпособКонвертацииЗначения", СпособКонвертацииЗначения);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СвязанныйОбъект", ОбъектУчетнойСистемы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_Справочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочникаЛогистикаПоСпособуКонвертации + ".СвязанныеОбъекты КАК КонтурЛогистика_Справочник
	|ГДЕ
	|	НЕ КонтурЛогистика_Справочник.Ссылка.ПометкаУдаления
	|	И КонтурЛогистика_Справочник.СвязанныйОбъект = &СвязанныйОбъект";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Не ЭтоКонвертация Тогда
			Результат = ДвижокКонвертации_СинхронизироватьРеквизитыУчетнойИЛогистическойСущностей(
				ОбъектУчетнойСистемы, Выборка.Ссылка, НастройкаКонвертации);
		КонецЕсли;
		
	Иначе
		
		Если ВключенаНастройкаАвтоконвертации(ИмяСправочникаЛогистикаПоСпособуКонвертации) Тогда
			
			Результат = ДвижокКонвертации_КонвертироватьВычисленноеЗначениеВОбъектЛогистики(
				ОбъектУчетнойСистемы, ПравилоКонвертации,, НастройкаКонвертации);
			
		Иначе
			
			ВызватьИсключение "Не найдено соответствие и не включена автоконвертация";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Удалить_СопоставитьВычисленноеЗначениеКлючевомуРеквизитуЛогистики(ВычисленноеЗначение, НастройкаКонвертацииСправочников, ВыражениеВычисленияДляСопоставления) 
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ВычисленныеРеквизиты = ОписаниеТаблицыВычисленныхРеквизитов();
	
	СтруктураПоиска = Новый Структура("ВыражениеВычисления", ВыражениеВычисленияДляСопоставления);   
	
	НайденныеПравилаКонвертации = НастройкаКонвертацииСправочников.ПравилаКонвертации.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого Правило Из НайденныеПравилаКонвертации Цикл
	
		Если Правило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
			Или Правило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически Тогда 
			Продолжить;
		КонецЕсли;
		
		ВычисленныйРеквизит = ВычисленныеРеквизиты.Добавить();         
		
		ВычисленныйРеквизит.Реквизит 	= Правило.РеквизитСправочникаЛогистика;
		ВычисленныйРеквизит.Ошибка 		= "";
		ВычисленныйРеквизит.Значение	= ВычисленноеЗначение;
		
	КонецЦикла;
	
	Если ВычисленныеРеквизиты.Количество() Тогда 
		
		Результат.Успешно = Истина;
		Результат.Вставить("Значение", ВычисленныеРеквизиты); 
		
	Иначе
									
		Результат.ОписаниеОшибки = "Не заданы правила конвертации или правила настроенны некорректно.";
		
	КонецЕсли;
			
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьНастройкуКонвертацииСправочников(ОбъектМетеданныхУС, ОбъектМетаданныхЛогистика, КонвертироватьПоНастройке, РеквизитТитула)
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если ОбъектМетеданныхУС = Неопределено Тогда 
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не задан объект для конвертации.";
		Возврат Результат;
		
	КонецЕсли;
	
	// 1. В начале используем "КонвертироватьПоНастройке"
	Если ЗначениеЗаполнено(КонвертироватьПоНастройке) Тогда
		
		Результат.Успешно = Истина;
		Результат.Вставить("Значение", КонвертироватьПоНастройке);
		Возврат Результат;
		
	КонецЕсли;
	
	// 2. Если не заполнена, то ищем по реквизиту титула
	НастройкиКонвертацииСправочников = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкуКонвертации(
											ОбъектМетеданныхУС.Имя,
											ОбъектМетаданныхЛогистика.Имя,
											РеквизитТитула);
											
	Если НастройкиКонвертацииСправочников = Неопределено Тогда 
		
		Результат.ОписаниеОшибки = "Не задана настройка конвертации.";
		
	Иначе
		
		Результат.Успешно = Истина;
		Результат.Вставить("Значение", НастройкиКонвертацииСправочников);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПоискОбъектаЛогистикиПоКлючевымРеквизитам(ВычисленноеЗначение, СпособКонвертацииЗначения, ВычисленныеРеквизиты) Экспорт
		
	РезультатПоиска = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	РезультатПоиска.Вставить("СоздатьОбъект", Ложь);
	
	МенеджерСправочника = МодульМенеджераПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	Запрос = БазовыйЗапросДляПоиска(СпособКонвертацииЗначения);	
	ОшибкаДобавления = ДобавитьПараметрыВЗапросПоискаСправочникаЛогистики(Запрос, ВычисленныеРеквизиты, МенеджерСправочника);
	
	Если ЗначениеЗаполнено(ОшибкаДобавления) Тогда 
		
		РезультатПоиска.Успешно = Ложь;
		РезультатПоиска.ОписаниеОшибки = ОшибкаДобавления;
		
	Иначе
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			РезультатПоиска.Успешно = Истина;
			РезультатПоиска.Вставить("Значение", Выборка.Ссылка);
			
			Если ВычисленноеЗначение <> Неопределено Тогда
				ДобавитьВычисленноеЗначениеВСвязныеОбъектыЛогистики(Выборка.Ссылка, ВычисленноеЗначение, Истина);
			КонецЕсли;
			
		Иначе
			
			РезультатПоиска.Успешно = Ложь;
			РезультатПоиска.ОписаниеОшибки = "Объект Контур.Логистика не найден по ключевым реквизитам.";
			РезультатПоиска.СоздатьОбъект = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат РезультатПоиска;

КонецФункции

Функция ПоискОбъектаЛогистикиПоРеквизитамУниверсальный(СпособКонвертацииЗначения, ВычисленныеРеквизитыСоответствие) Экспорт
		
	РезультатПоиска = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	МассивИгнорируемыхПриПоискеРеквизитов = Новый Массив;
	МассивИгнорируемыхПриПоискеРеквизитов.Добавить("ТелефонОсновной");
	МассивИгнорируемыхПриПоискеРеквизитов.Добавить("ТелефонЗапасной");
	МассивИгнорируемыхПриПоискеРеквизитов.Добавить("ВУСерия");
	МассивИгнорируемыхПриПоискеРеквизитов.Добавить("ВУДатаВыдачи");
	МассивИгнорируемыхПриПоискеРеквизитов.Добавить("ВУНомер");
	
	Если ВычисленныеРеквизитыСоответствие.Количество() = 0 Тогда 
		РезультатПоиска.Успешно = Ложь;
		РезультатПоиска.ОписаниеОшибки = "При поиске объекта не передан ни один реквизит для поиска";
		Возврат РезультатПоиска;
	КонецЕсли;

	// приведет значения к нужным типам
	ОбъектМетаданных = ОбъектМетаданныхПоСпособуКонвертации(СпособКонвертацииЗначения);
	РеквизитыОбъектаМетаданных = ОбъектМетаданных.Реквизиты;
	
	РеквизитыУсловияСтруктура = Новый Структура;
	Для Каждого ВычисленныйРеквизит Из ВычисленныеРеквизитыСоответствие Цикл 
		
		Если МассивИгнорируемыхПриПоискеРеквизитов.Найти(ВычисленныйРеквизит.Ключ) <> Неопределено Тогда 
			Продолжить; // этот ключ не используется при поиске
		КонецЕсли;
		
		НайденныйРеквизитМетаданных = РеквизитыОбъектаМетаданных.Найти(ВычисленныйРеквизит.Ключ);
		Если НайденныйРеквизитМетаданных <> Неопределено Тогда
			Если НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Дата")) Тогда 
				РеквизитыУсловияСтруктура.Вставить(ВычисленныйРеквизит.Ключ, КонтурЛогистика_КонструкторыXDTO.Конвертировать_ДатаТип_вДата(ВычисленныйРеквизит.Значение));
				
			ИначеЕсли НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Булево")) Тогда 
				РеквизитыУсловияСтруктура.Вставить(ВычисленныйРеквизит.Ключ, Булево(ВычисленныйРеквизит.Значение));
				
			ИначеЕсли НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Число")) Тогда 
				РеквизитыУсловияСтруктура.Вставить(ВычисленныйРеквизит.Ключ, Число(ВычисленныйРеквизит.Значение));
				
			ИначеЕсли НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Строка")) Тогда 
				РеквизитыУсловияСтруктура.Вставить(ВычисленныйРеквизит.Ключ, ВычисленныйРеквизит.Значение);
				
			Иначе
				// поиск по сложным типам не делаем
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// сформируем запрос к справочнику
	Запрос = БазовыйЗапросДляПоиска(СпособКонвертацииЗначения);
	
	ДобавитьПараметрыВЗапросУниверсальногоПоискаСправочникаЛогистики(Запрос, РеквизитыУсловияСтруктура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		РезультатПоиска.Успешно = Истина;
		РезультатПоиска.Вставить("Значение", Выборка.Ссылка);
		
	Иначе
		
		РезультатПоиска.Успешно = Ложь;
		РезультатПоиска.ОписаниеОшибки = "Объект Контур.Логистика не найден по реквизитам.";
		
	КонецЕсли;	
	
	Возврат РезультатПоиска;

КонецФункции

Функция СоздатьОбъектЛогистикиПоРеквизитамУниверсальный(СпособКонвертацииЗначения, ВычисленныеРеквизитыСоответствие) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("СозданныйОбъектСсылка", Неопределено);
	ОбъектМетаданных = ОбъектМетаданныхПоСпособуКонвертации(СпособКонвертацииЗначения);
	РеквизитыОбъектаМетаданных = ОбъектМетаданных.Реквизиты;
	
	РеквизитыСущностиСтруктура = Новый Структура;
	Для Каждого ВычисленныйРеквизит Из ВычисленныеРеквизитыСоответствие Цикл 
		
		НайденныйРеквизитМетаданных = РеквизитыОбъектаМетаданных.Найти(ВычисленныйРеквизит.Ключ);
		Если НайденныйРеквизитМетаданных <> Неопределено Тогда
			Если НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Дата")) Тогда 
				РеквизитыСущностиСтруктура.Вставить(ВычисленныйРеквизит.Ключ, КонтурЛогистика_КонструкторыXDTO.Конвертировать_ДатаТип_вДата(ВычисленныйРеквизит.Значение));
				
			ИначеЕсли НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Булево")) Тогда 
				РеквизитыСущностиСтруктура.Вставить(ВычисленныйРеквизит.Ключ, Булево(ВычисленныйРеквизит.Значение));
				
			ИначеЕсли НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Число")) Тогда 
				РеквизитыСущностиСтруктура.Вставить(ВычисленныйРеквизит.Ключ, Число(ВычисленныйРеквизит.Значение));
				
			ИначеЕсли НайденныйРеквизитМетаданных.Тип.СодержитТип(Тип("Строка")) Тогда 
				РеквизитыСущностиСтруктура.Вставить(ВычисленныйРеквизит.Ключ, ВычисленныйРеквизит.Значение);
				
			Иначе
				// по сложным типам не делаем
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	МенеджерСправочника = МодульМенеджераПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	Если МенеджерСправочника = Неопределено Тогда
		
		Результат.ОписаниеОшибки = "Не нашел модуль менеджера для конвертации.";
		Результат.Успешно = Ложь;
		Возврат Результат;
	
	КонецЕсли;
	
	Попытка
		
		НовыйОбъектЛогистики = МенеджерСправочника.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовыйОбъектЛогистики, РеквизитыСущностиСтруктура);
		НовыйОбъектЛогистики.Записать();
		
		Результат.Успешно = Истина;
		Результат.Вставить("СозданныйОбъектСсылка", НовыйОбъектЛогистики.Ссылка);
	Исключение
		
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		Результат.Успешно = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции
	
Функция КонвертироватьВалютуИзЛогистикиВ1С(КодВалюты, НаименованиеВалюты = Неопределено) Экспорт
	
	НайденнаяВалюта = Неопределено;
	
	Попытка
		
		ИмяСправочника = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяСправочникаВалюты");
		
		Если ЗначениеЗаполнено(КодВалюты) Тогда
			НайденнаяВалюта = Справочники[ИмяСправочника].НайтиПоКоду(КодВалюты);
		ИначеЕсли ЗначениеЗаполнено(НаименованиеВалюты) Тогда
			НайденнаяВалюта = Справочники[ИмяСправочника].НайтиПоНаименованию(НаименованиеВалюты);
		Иначе
			НайденнаяВалюта = Справочники[ИмяСправочника].НайтиПоКоду("643");
		КонецЕсли;
		
	Исключение
		
		Сообщить("Не могу сконвертировать валюту их xml в 1С: " + ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат НайденнаяВалюта;
	
КонецФункции

Функция КонвертироватьВычисленноеЗначениеВОбъектЛогистики(ВычисленныеРеквизиты, ВычисленноеЗначение, Менеджер) Экспорт 
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если Менеджер = Неопределено Тогда
		
		Результат.ОписаниеОшибки = "Не нашел модуль менеджера для конвертации.";
		Возврат Результат;
	
	КонецЕсли;
	
	НовыйОбъектЛогистики = Менеджер.СоздатьЭлемент();
	
	Для Каждого ВычисленныйРеквизит Из ВычисленныеРеквизиты Цикл
		
		Если Не ЗначениеЗаполнено(ВычисленныйРеквизит.Значение) Тогда 
			
			Продолжить;
			
		КонецЕсли;
		
		Если (ВычисленныйРеквизит.Реквизит = "МожетПодписывать" Или ВычисленныйРеквизит.Реквизит = "МожетПередаватьНаПодпись")
			И ТипЗнч(Менеджер) = Тип("СправочникМенеджер.КонтурЛогистика_Сотрудники") Тогда
			
			Если НовыйОбъектЛогистики.РазрешенияРаботыСДокументами.Количество() = 0 Тогда
				НовыйОбъектЛогистики.ЗаполнитьРазрешенияРаботыСДокументами();
			КонецЕсли;
			
			// Заполним разрешения
			Для Каждого ТекущееРазрешение Из НовыйОбъектЛогистики.РазрешенияРаботыСДокументами Цикл
				ТекущееРазрешение[ВычисленныйРеквизит.Реквизит] = ВычисленныйРеквизит.Значение;
			КонецЦикла;
			
		Иначе
			
			НовыйОбъектЛогистики[ВычисленныйРеквизит.Реквизит] = ВычисленныйРеквизит.Значение;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьВычисленноеЗначениеВСвязныеОбъектыЛогистики(НовыйОбъектЛогистики, ВычисленноеЗначение); 
			
	Результат.Успешно = Истина;
	Результат.Вставить("Значение", НовыйОбъектЛогистики.Ссылка);
		
	Возврат Результат;
	
КонецФункции

Функция БазовыйЗапросДляПоиска(СпособКонвертацииЗначения) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_Справочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Договоры КАК КонтурЛогистика_Справочник
	|ГДЕ
	|	НЕ КонтурЛогистика_Справочник.ПометкаУдаления";
	
	ИмяСправочникаЛогистика = Перечисления.КонтурЛогистика_СпособыКонвертации.ИмяСправочникаЛогистикаПоСпособуКонвертации(
								СпособКонвертацииЗначения);	
								
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_Договоры", ИмяСправочникаЛогистика);
	
	Возврат Запрос;
	
КонецФункции

Функция БазовыйЗапросДляПоискаУчСист(ТипСправочникаУС)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СправочникУС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК СправочникУС
	|ГДЕ
	|	НЕ СправочникУС.ПометкаУдаления";
								
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ОрганизацииДиадок", ТипСправочникаУС);
	
	Возврат Запрос;
	
КонецФункции

// ВернутьНайденноеЗначение - если Истина, то пытаемся найти значение по всем полям поиска
Функция ДобавитьПараметрыВЗапросПоискаСправочникаЛогистики(Запрос, ВычисленныеРеквизиты, МенеджерСправочника, ВернутьНайденноеЗначение = Ложь) Экспорт 
	
	КлючиПоиска = МенеджерСправочника.ПолучитьОписаниеКлючейПоиска();
		
	ПараметрыДобавлены = Ложь;
	
	Для Каждого БлокУсловий Из КлючиПоиска Цикл 
		
		ТекстПараметров = "";
		ПараметрыЗапроса = Новый Структура;
		
		Если ВернутьНайденноеЗначение Тогда
			
			Тип = Тип(СтрЗаменить(Строка(МенеджерСправочника), "СправочникМенеджер", "СправочникСсылка"));  
			СоответствиеТиповЗначениям = Перечисления.КонтурЛогистика_СпособыКонвертации.СоответствиеТиповЗначениям();
			
			СпособКонвертации = СоответствиеТиповЗначениям[Тип];
			Если ЗначениеЗаполнено(СпособКонвертации) Тогда
				Запрос = БазовыйЗапросДляПоиска(Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника);
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ОписаниеУсловия Из БлокУсловий Цикл 
			
			ВычисленныйРеквизит = ВычисленныеРеквизиты.Найти(ОписаниеУсловия.Параметр, "Реквизит");
			
			Если Не ВычисленныйРеквизит = Неопределено И (ЗначениеЗаполнено(ВычисленныйРеквизит.Значение) 
															Или ВычисленныйРеквизит.Реквизит = "Отчество" И ВычисленныйРеквизит.Значение = "") Тогда
															// отсутствие отчества - это тоже отчество
				
				СтрокаПоиска = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ОписаниеУсловия.ШаблонСтрокиПоиска,
								   ОписаниеУсловия.Параметр);
				
		    	ТекстПараметров = ТекстПараметров + СтрокаПоиска;
				
				ПараметрыЗапроса.Вставить(ОписаниеУсловия.Параметр, ВычисленныйРеквизит.Значение);
				
				ПараметрыДобавлены = Истина;
				
			Иначе
								
				ПараметрыДобавлены = Ложь;
				
				Прервать;
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		Если ПараметрыДобавлены Тогда
			
			Запрос.Текст = Запрос.Текст + ТекстПараметров;
			
			Для Каждого Параметр Из ПараметрыЗапроса Цикл 
				
				Запрос.Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
				
			КонецЦикла;	
			
			Если ВернутьНайденноеЗначение Тогда
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Возврат Выборка.Ссылка;
				Иначе
					Возврат "";
				КонецЕсли;  
			
			Иначе
			
				Прервать;
				
			КонецЕсли;
						
		КонецЕсли;	
		
	КонецЦикла;	
	
	ОписаниеОшибки = "";
	
	// TODO передалать описание ошибки
	Если Не ПараметрыДобавлены Тогда 
		
		ОписаниеОшибки = МенеджерСправочника.ТекстОшибкиНеЗаполненыКлючевыеРеквизиты();
		
	КонецЕсли;	
	
	Возврат ОписаниеОшибки;
			
КонецФункции

Процедура ДобавитьПараметрыВЗапросУниверсальногоПоискаСправочникаЛогистики(Запрос, РеквизитыУсловияСтруктура) 
	
	Для Каждого РеквизитПоиска Из РеквизитыУсловияСтруктура Цикл 
		
		Запрос.Текст = Запрос.Текст + " И КонтурЛогистика_Справочник." + РеквизитПоиска.Ключ + " = &" + РеквизитПоиска.Ключ;
		Запрос.УстановитьПараметр(РеквизитПоиска.Ключ, РеквизитПоиска.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьПараметрыВЗапросПоискаСправочникаУС(Запрос, ВычисленныеРеквизиты) 
		
	ПараметрыДобавлены = Ложь;
	ШаблонСтрокиПоиска = " И СправочникУС.%1 = &%1";
	ТекстПараметров = "";
	ПараметрыЗапроса = Новый Структура;
	
	Для Каждого ВычисленныйРеквизит Из ВычисленныеРеквизиты Цикл 
		
		Параметр = ВычисленныйРеквизит.Реквизит;		
		
		Если ВычисленныйРеквизит.КлючевоеПоле = Истина Тогда
			
			СтрокаПоиска = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиПоиска, Параметр);
			
			ТекстПараметров = ТекстПараметров + СтрокаПоиска;
			
			ПараметрыЗапроса.Вставить(Параметр, ВычисленныйРеквизит.Значение);
				
			ПараметрыДобавлены = Истина;
			
		КонецЕсли;			
		
	КонецЦикла;
	
	Если ПараметрыДобавлены Тогда
		
		Запрос.Текст = Запрос.Текст + ТекстПараметров;
		
		Для Каждого Параметр Из ПараметрыЗапроса Цикл 
			
			Запрос.Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
			
		КонецЦикла;	 
						
	Иначе 
		
		ОписаниеОшибки = "Отсутствуют, либо не заполнены ключевые поля";
		
	КонецЕсли;	
	
	Возврат ОписаниеОшибки;
			
КонецФункции

