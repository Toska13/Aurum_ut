Процедура ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, СтрокаКлючей, ШаблонСтрокиПоиска) Экспорт 
	
	БлокУсловия = Новый Массив;
	
	Массив = КонтурЛогистика_ИнтеграцияДиадокСервер.Ядро().РазделитьСтроку(СтрокаКлючей);
	
	Для Каждого КлючПоиска Из Массив Цикл 
		
		ОписаниеУсловия = Новый Структура;
		
		ОписаниеУсловия.Вставить("Параметр", КлючПоиска);
		ОписаниеУсловия.Вставить("ШаблонСтрокиПоиска", ШаблонСтрокиПоиска);	
		
		БлокУсловия.Добавить(ОписаниеУсловия);
		
	КонецЦикла;	
	
	КлючиПоиска.Добавить(БлокУсловия);
	
КонецПроцедуры

Функция Манифест_ТабТоваров() Экспорт

	ИспользуютсяХарактеристики = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользуютсяХарактеристики");
	
	ТипНоменклатуры = Справочники.КонтурЛогистика_Настройки.ПолучитьИмяСправочникаСущности("Номенклатура");
	ОписаниеТиповЕдиницИзмерения = Справочники.КонтурЛогистика_Настройки.ПолучитьОписаниеТиповЕдиницИзмерения();
	
	ТабТоваров = Новый ТаблицаЗначений;
	ТабТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка." + ТипНоменклатуры));
	ТабТоваров.Колонки.Добавить("УпаковкаЕдиницаИзмерения", ОписаниеТиповЕдиницИзмерения);
	ТабТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Если ИспользуютсяХарактеристики И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() Тогда 
		ТипХарактеристики = Справочники.КонтурЛогистика_Настройки.ПолучитьИмяСправочникаСущности("Характеристика");
		ТабТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка." + ТипХарактеристики));
	Иначе
		ТабТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("Строка", ,
													  Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	КонецЕсли;
	
	Возврат ТабТоваров;

КонецФункции

Функция Удалить_ДвижокКонвертации_ЗаполнитьТабЧастьТовары(ДокументТитулОбъект, НастройкаКонвертации) Экспорт
	//TODO отрефачить дублирвоание в модулях объектов Т1 и Т3 
	ДокументОснование = ДокументТитулОбъект.ДокументОснование;
	
	Если не ЗначениеЗаполнено(НастройкаКонвертации.ИмяТабЧастьТовары) Тогда 
		ВызватьИсключение "В настройке конвертации требуется указать как вычислять таб часть товаров: " + НастройкаКонвертации;
	КонецЕсли;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументТитулОбъект.Ссылка);
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
		ДокументТитулОбъект.Товары.Очистить();
		ТЗ_ТоварыВременная = ДокументТитулОбъект.Товары.Выгрузить(); 
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		ДокументТитулОбъект.ТоварыДокументаУчетнойСистемы.Очистить();
		ТЗ_ТоварыВременная = ДокументТитулОбъект.ТоварыДокументаУчетнойСистемы.Выгрузить(); 
	Иначе
		ВызватьИсключение "Не ожидаемый тип титула";
	КонецЕсли;
			
	Если ЗначениеЗаполнено(ДокументОснование) И НастройкаКонвертации <> Неопределено Тогда
		
		// получить массив контейнеров с табчастями (ТРНка может быть по нескольким документам РТУ - у каждого своя ТЧ, если доквсего один - то в массиве контенеров будет 1 элемент)
		Если ЗначениеЗаполнено(НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары) Тогда 
			МассивКонтейнеровсТабЧастями = ДокументОснование[НастройкаКонвертации.ПутьКоллекцияТабЧастьТовары];
		Иначе
			МассивКонтейнеровсТабЧастями = Новый Массив;
			МассивКонтейнеровсТабЧастями.Добавить(ДокументОснование); // таб. часть товаров - реквизит самого документа
		КонецЕсли;
		
		// может быть необязательно массивом, но обязан поддерживать обход!
		Для Каждого ЭлементКоллекцииКонтейнеров Из МассивКонтейнеровсТабЧастями Цикл 
			
			// обойти контейнеры - извлечь ТЧ
			Если ЗначениеЗаполнено(НастройкаКонвертации.ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ) Тогда 
				// элементы коллекции - строки ТЧ, содаржащие контейнер, надо сначала обратиться к ячейке ТЧ для получения контейнера
				ТЧ_Контейнера = ЭлементКоллекцииКонтейнеров[НастройкаКонвертации.ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ][НастройкаКонвертации.ИмяТабЧастьТовары];
			Иначе
				// элементы коллекции - уже контейнеры
				ТЧ_Контейнера = ЭлементКоллекцииКонтейнеров[НастройкаКонвертации.ИмяТабЧастьТовары];
			КонецЕсли;
			
			Для Каждого СтрокаТЧТоваровУчетногоДокумента Из ТЧ_Контейнера Цикл
				
				НоваяСтрокаТоваров = ТЗ_ТоварыВременная.Добавить();
				
				Для Каждого СтрокаНастройкиКонвертацииТЧТовары Из НастройкаКонвертации.ПравилаКонвертацииТитулаТабЧастьТовары Цикл
					
					Если СтрокаНастройкиКонвертацииТЧТовары.СпособМаппинга <> Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять Тогда 
						
						РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитДокумента(СтрокаТЧТоваровУчетногоДокумента, СтрокаНастройкиКонвертацииТчТовары, ДокументТитулОбъект);
						
						Если РезультатВычисления.Успешно  Тогда 
							НоваяСтрокаТоваров[СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула] = РезультатВычисления.Значение;
						Иначе
							Сообщить("Не удалось рассчитать: " + СтрокаНастройкиКонвертацииТЧТовары.РеквизитТитула + 
							" по " + ДокументОснование + " - " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатВычисления));
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТЗ_ТоварыВременная;
	
КонецФункции

Процедура СгенерироватьИдентификаторыСтрок(ТЗ_ТоварыВременная) Экспорт

	Для Каждого СтрокаТоваров Из ТЗ_ТоварыВременная Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ИдентификаторСтроки) Тогда 
			СтрокаТоваров.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Функция ВключенаНастройкаАвтоконвертации(ИмяСправочника) Экспорт
	
	Возврат Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_" + ИмяСправочника);
	
КонецФункции

#Область ОбратныйМаппингДокументов
	          
Процедура СконвертироватьДокументУчетнойСистемыПоТитулу(Основание, 
														ДокументОбъект, 
														Знач НастройкаКонвертации, 
														УстановитьСтатусОбработан = Ложь, 
														ПроверитьНастройкуКонвертации = Ложь, 
														ДанныеДляПроверки = Неопределено,
														ОшибкиПриКонвертации = Ложь) Экспорт
	
	ДанныеДляПроверки = Новый Структура;		
		
	Переменные = ДвижокКонвертации_ВычислитьПеременные_ОбратныйМаппинг(Основание, ДокументОбъект.Ссылка, НастройкаКонвертации, "", ПроверитьНастройкуКонвертации, ДанныеДляПроверки);
		
	// Реквизиты
	
	тзПроцессЗаполнения = Новый ТаблицаЗначений;
	тзПроцессЗаполнения.Колонки.Добавить("ТипАлгоритма");
	тзПроцессЗаполнения.Колонки.Добавить("ДанныеДляЗаполнения");
	тзПроцессЗаполнения.Колонки.Добавить("ПроизвольныйКод");
	тзПроцессЗаполнения.Колонки.Добавить("Реквизит");
	тзПроцессЗаполнения.Колонки.Добавить("ОбновитьЗначение");
	
	Для каждого ПравилоКонвертации Из НастройкаКонвертации.ЗаполнениеДокУчСист Цикл
		
		Если ПравилоКонвертации.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
			
			НоваяСтрока = тзПроцессЗаполнения.Добавить();
			НоваяСтрока.ТипАлгоритма = ПравилоКонвертации.ТипАлгоритма;
			НоваяСтрока.ПроизвольныйКод = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр;
			
			Продолжить;
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять
			ИЛИ (ПравилоКонвертации.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить
				И ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.Очистить) 
			ИЛИ ( Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) И Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр)
				И Не ЗначениеЗаполнено(ПравилоКонвертации.КонвертироватьПоНастройке)) Тогда
				
			Продолжить;

		КонецЕсли;
		
		Результат = ВычислитьЗначениеРеквизитаУчСист(ПравилоКонвертации, Основание, ДокументОбъект, Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации);
		
		ДобавитьРеквизитВСтруктуруЗаполнения(тзПроцессЗаполнения, ПравилоКонвертации, Результат.Значение);
				
	КонецЦикла;
	
	Для каждого Алгоритм Из тзПроцессЗаполнения Цикл
		
		Если Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит И ЗначениеЗаполнено(Алгоритм.ДанныеДляЗаполнения) Тогда
			
			Если Не ЗначениеЗаполнено(ДокументОбъект[Алгоритм.Реквизит]) 
				Или (ЗначениеЗаполнено(ДокументОбъект[Алгоритм.Реквизит]) И Алгоритм.ОбновитьЗначение) Тогда
				ЗаполнитьЗначенияСвойств(ДокументОбъект, Алгоритм.ДанныеДляЗаполнения);
		    КонецЕсли;
			
		ИначеЕсли Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить 
			И ЗначениеЗаполнено(Алгоритм.ДанныеДляЗаполнения) 
			И Алгоритм.ДанныеДляЗаполнения.Количество() > 0 Тогда
			
			ДокументОбъект.Заполнить(Алгоритм.ДанныеДляЗаполнения);
			
		ИначеЕсли Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик И ЗначениеЗаполнено(Алгоритм.ПроизвольныйКод) Тогда
					
			Выполнить(Алгоритм.ПроизвольныйКод);
								
		КонецЕсли;
		
	КонецЦикла;
	
	// Табличная часть Товары
	
	Если ЗначениеЗаполнено(НастройкаКонвертации.ИмяТЧТоварыДокУчСист) Тогда
		
		ИмяТЧТовары = НастройкаКонвертации.ИмяТЧТоварыДокУчСист;
		
		ДокументОбъект[ИмяТЧТовары].Очистить();
		
		ДанныеДляПроверки.Вставить(ИмяТЧТовары, Новый Массив);		
		 		
		Если НастройкаКонвертации.НетТЧТоварыДокЛогистика Тогда
			
			НоваяСтрокаТЧ = ДокументОбъект[ИмяТЧТовары].Добавить();
			
			СтрокаПроверка = Новый Структура;
			СтрокаПроверка.Вставить("НомерСтроки", 1);
					
			ДанныеДляПроверки[ИмяТЧТовары].Добавить(СтрокаПроверка);
						
			Для каждого ПравилоКонвертации Из НастройкаКонвертации.ЗаполнениеДокУчСистТЧТовары Цикл
							
				Если Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) И Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) Тогда
					Продолжить;
				КонецЕсли;
				
				Результат = ВычислитьЗначениеРеквизитаУчСист(ПравилоКонвертации, Основание, ДокументОбъект, Переменные, СтрокаПроверка, ПроверитьНастройкуКонвертации);
				
				Если Результат.Успешно Тогда
					НоваяСтрокаТЧ[ПравилоКонвертации.Реквизит] = Результат.Значение;	
				КонецЕсли;
												
			КонецЦикла;	
			
		Иначе
			
			Для каждого Стр Из Основание[НастройкаКонвертации.ИмяТЧТоварыДокЛогистика] Цикл
				
				НоваяСтрокаТЧ = ДокументОбъект[ИмяТЧТовары].Добавить();
				
				СтрокаПроверка = Новый Структура;
				СтрокаПроверка.Вставить("НомерСтроки", Стр.НомерСтроки);
					
				ДанныеДляПроверки[ИмяТЧТовары].Добавить(СтрокаПроверка);
						
				ПеременныеТЧ = ДвижокКонвертации_ВычислитьПеременные_ОбратныйМаппинг(Основание, ДокументОбъект.Ссылка, НастройкаКонвертации, НастройкаКонвертации.ИмяТЧТоварыДокЛогистика, ПроверитьНастройкуКонвертации, ДанныеДляПроверки);
			
				Для Каждого ПеременнаяТЧ Из ПеременныеТЧ Цикл 
					Переменные.Вставить(ПеременнаяТЧ.Ключ, ПеременнаяТЧ.Значение);
				КонецЦикла;
				
				Для каждого ПравилоКонвертации Из НастройкаКонвертации.ЗаполнениеДокУчСистТЧТовары Цикл
								
					Если Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) И Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) Тогда
						Продолжить;
					КонецЕсли;
					
					Результат = ВычислитьЗначениеРеквизитаУчСист(ПравилоКонвертации, Стр, ДокументОбъект, Переменные, СтрокаПроверка, ПроверитьНастройкуКонвертации);
					
					Если Результат.Успешно Тогда
						НоваяСтрокаТЧ[ПравилоКонвертации.Реквизит] = Результат.Значение;	
					КонецЕсли;
													
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЕсли;
	
	// Произвольные табличные части титула
	
	ТаблицаЗаполненияПроизвольныхТЧ = НастройкаКонвертации.ЗаполнениеДокУчСистТЧПроизвольная.Выгрузить();
	ТаблицаЗаполненияПроизвольныхТЧ.Свернуть("ИмяТЧ, ПутьТЧИсходногоДокумента");
			
	Для Каждого ГруппировкаТЧ Из ТаблицаЗаполненияПроизвольныхТЧ Цикл
		
		Попытка
			
			СтрокиКонвертации = НастройкаКонвертации.ЗаполнениеДокУчСистТЧПроизвольная.НайтиСтроки(Новый Структура("ИмяТЧ, ПутьТЧИсходногоДокумента", ГруппировкаТЧ.ИмяТЧ, ГруппировкаТЧ.ПутьТЧИсходногоДокумента)); 
			
			ДанныеДляПроверки.Вставить(ГруппировкаТЧ.ИмяТЧ, Новый Массив);		
			
			ДокументОбъект[ГруппировкаТЧ.ИмяТЧ].Очистить();
			
			Если КонтурЛогистика_ОбщегоНазначенияСервер.СтрокаСодержитТолькоЦифры(ГруппировкаТЧ.ПутьТЧИсходногоДокумента) Тогда 
				
				СтрокаПроверка = Новый Структура;
				СтрокаПроверка.Вставить("НомерСтроки", 1);
					
				ДанныеДляПроверки[ГруппировкаТЧ.ИмяТЧ].Добавить(СтрокаПроверка);
				
				НоваяСтрокаТЧ = ДокументОбъект[ГруппировкаТЧ.ИмяТЧ].Добавить();
				ЗаполнитьСтрокуПроизвольнойТЧУчСист(НоваяСтрокаТЧ, Основание, СтрокиКонвертации, НастройкаКонвертации, ДокументОбъект, "", ПроверитьНастройкуКонвертации, СтрокаПроверка);
				
			Иначе
												
				// вычислим указанную ТЧ
				ТЧКонтейнерДокументаОснования = ДвижокКонвертации_ВычислитьПроизвольнуюТабЧастьПоВыражениюВычисления(Основание, СтрокиКонвертации[0], Истина, "");
												
				Если ТЧКонтейнерДокументаОснования <> Неопределено Тогда
					
					ДокументОбъект[ГруппировкаТЧ.ИмяТЧ].Очистить();
					
					Для Каждого СтрокаКонтейнераОснования Из ТЧКонтейнерДокументаОснования Цикл
						
						СтрокаПроверка = Новый Структура;
						СтрокаПроверка.Вставить("НомерСтроки", Стр.НомерСтроки);
						
						ДанныеДляПроверки[ГруппировкаТЧ.ИмяТЧ].Добавить(СтрокаПроверка);
																																	
						НоваяСтрокаТЧ = ДокументОбъект[ГруппировкаТЧ.ИмяТЧ].Добавить();
						ЗаполнитьСтрокуПроизвольнойТЧУчСист(НоваяСтрокаТЧ, СтрокаКонтейнераОснования, СтрокиКонвертации, НастройкаКонвертации, ДокументОбъект, "", ПроверитьНастройкуКонвертации, СтрокаПроверка);
																	
					КонецЦикла;
					
				Иначе
					КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не смог рассчитать произвольную ТЧ: " + ГруппировкаТЧ.ИмяТЧТитула + " _ " + ГруппировкаТЧ.ПутьТЧИсходногоДокумента + " Проверьте путь ");
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не смог рассчитать строки произвольной ТЧ: " + ГруппировкаТЧ.ИмяТЧТитула + " _ " + ГруппировкаТЧ.ПутьТЧИсходногоДокумента + " по причине: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ДокументОбъект.Дата = Дата(1, 1, 1) Тогда
		ДокументОбъект.Дата = ТекущаяДатаСеанса();	
	КонецЕсли;
	
	Если Не ПроверитьНастройкуКонвертации Тогда
	
		ДокументОбъект.Записать();
		
		Если Не ЗначениеЗаполнено(Основание.ДокументОснование) Тогда
			ОснованиеОб = Основание.ПолучитьОбъект();
			ОснованиеОб.ДокументОснование = ДокументОбъект.Ссылка;
			ОснованиеОб.Записать();
		КонецЕсли;
		
		Если НастройкаКонвертации.ПроводитьДокУчСис Тогда
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не удалось провести документ");
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если УстановитьСтатусОбработан Тогда
		
		ОшибкиКонвертации = Новый Массив;
		ПолучитьОшибкиКонвертации(ДанныеДляПроверки, ОшибкиКонвертации);				
				
		Если ОшибкиКонвертации.Количество() > 0 Тогда
			
			ОшибкиПриКонвертации = Истина;
			
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОбработанСПредупреждением);
			СтруктураОшибки.Вставить("КодОшибки", "");
			СтруктураОшибки.Вставить("ОписаниеОшибки", "Ошибка при конвертации");
			СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ОшибкиКонвертации, ";" + Символы.ПС));
			СтруктураОшибки.Вставить("Количество", ОшибкиКонвертации.Количество());
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Основание, 
				Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением, , , СтруктураОшибки);
				
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Документ обработан с предупреждением: " + Строка(Основание));	
			
		Иначе
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Основание, 
				Перечисления.КонтурЛогистика_СтатусыТитулов.Получен);			
						
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СконвертироватьСправочникУчетнойСистемыПоДаннымНКС(ВычисленныеРеквизиты, ТипСправочникаИлиДокументаУС) Экспорт
														
	СправочникОбъект = Справочники[ТипСправочникаИлиДокументаУС].СоздатьЭлемент();															
	
	// Реквизиты
	
	тзПроцессЗаполнения = Новый ТаблицаЗначений;
	тзПроцессЗаполнения.Колонки.Добавить("ТипАлгоритма");
	тзПроцессЗаполнения.Колонки.Добавить("ДанныеДляЗаполнения");
	тзПроцессЗаполнения.Колонки.Добавить("ПроизвольныйКод");
	тзПроцессЗаполнения.Колонки.Добавить("Реквизит");
	тзПроцессЗаполнения.Колонки.Добавить("ОбновитьЗначение");
	
	Для Каждого СтрокаРеквизита Из ВычисленныеРеквизиты Цикл
		
		Если СтрокаРеквизита.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
			
			НоваяСтрока = тзПроцессЗаполнения.Добавить();
			НоваяСтрока.ТипАлгоритма = СтрокаРеквизита.ТипАлгоритма;
			НоваяСтрока.ПроизвольныйКод = СтрокаРеквизита.ВыражениеВычисленияСтрокаНеогр;
			
			Продолжить;
		КонецЕсли;
		
		Если СтрокаРеквизита.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять
			ИЛИ (СтрокаРеквизита.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить
				И СтрокаРеквизита.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.Очистить) 
			ИЛИ ( Не ЗначениеЗаполнено(СтрокаРеквизита.ВыражениеВычисления) И Не ЗначениеЗаполнено(СтрокаРеквизита.ВыражениеВычисленияСтрокаНеогр)) Тогда
				
			Продолжить;

		КонецЕсли;
		
		ДобавитьРеквизитВСтруктуруЗаполнения(тзПроцессЗаполнения, СтрокаРеквизита, СтрокаРеквизита.Значение);
				
	КонецЦикла;
	
	Для Каждого Алгоритм Из тзПроцессЗаполнения Цикл
		
		Если Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит И ЗначениеЗаполнено(Алгоритм.ДанныеДляЗаполнения) Тогда
			
			Если Не ЗначениеЗаполнено(СправочникОбъект[Алгоритм.Реквизит]) 
				Или (ЗначениеЗаполнено(СправочникОбъект[Алгоритм.Реквизит]) И Алгоритм.ОбновитьЗначение) Тогда
				ЗаполнитьЗначенияСвойств(СправочникОбъект, Алгоритм.ДанныеДляЗаполнения);
		    КонецЕсли;
			
		ИначеЕсли Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить 
			И ЗначениеЗаполнено(Алгоритм.ДанныеДляЗаполнения) 
			И Алгоритм.ДанныеДляЗаполнения.Количество() > 0 Тогда
			
			СправочникОбъект.Заполнить(Алгоритм.ДанныеДляЗаполнения);
			
		ИначеЕсли Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик И ЗначениеЗаполнено(Алгоритм.ПроизвольныйКод) Тогда
					
			Выполнить(Алгоритм.ПроизвольныйКод);
								
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка
		СправочникОбъект.Записать();
	Исключение
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не удалось создать и записать элемент справочника " + ОписаниеОшибки());
		
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат СправочникОбъект.Ссылка;
	
КонецФункции

Процедура ПолучитьОшибкиКонвертации(ДанныеДляПроверки, ОшибкиКонвертации, ИмяТЧ = "")
	
	НомерСтроки = "";
	
	Для каждого Стр Из ДанныеДляПроверки Цикл
		
		Если Стр.Ключ = "НомерСтроки" Тогда
			НомерСтроки = Стр.Значение;
		КонецЕсли;
		
		Если ТипЗнч(Стр.Значение) = Тип("Структура") И Стр.Значение.Свойство("ТекстОшибки") И ЗначениеЗаполнено(Стр.Значение.ТекстОшибки) Тогда
			
			Если ЗначениеЗаполнено(ИмяТЧ) И ЗначениеЗаполнено(НомерСтроки) Тогда
				
				ОшибкиКонвертации.Добавить("ТЧ " + ИмяТЧ + " Строка " + Строка(НомерСтроки) + ": " + Стр.Ключ + " - " + Стр.Значение.ТекстОшибки);
				
			Иначе
				
				ОшибкиКонвертации.Добавить(Стр.Ключ + " - " + Стр.Значение.ТекстОшибки);
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Стр.Значение) = Тип("Массив") Тогда
			
			Для каждого Стр2 Из Стр.Значение Цикл
				
				Если ТипЗнч(Стр2) = Тип("Структура") Тогда
					
					ПолучитьОшибкиКонвертации(Стр2, ОшибкиКонвертации, Стр.Ключ);
					
				КонецЕсли;
												
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
		
		
КонецПроцедуры

Функция ВычислитьЗначениеРеквизитаУчСист(ПравилоКонвертации, Основание, Объект, Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации, ЭтоПеременная = Ложь)
	
	РеквизитПроверка = Новый Структура;
	РеквизитПроверка.Вставить("Наименование");			
	РеквизитПроверка.Вставить("Значение");
	РеквизитПроверка.Вставить("ТекстОшибки");
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	ВычисленноеЗначение = Неопределено;
	
	Если ЗначениеЗаполнено(РеквизитПроверка) Тогда
		РеквизитПроверка.Наименование = ?(ЭтоПеременная, ПравилоКонвертации.Имя, ПравилоКонвертации.Реквизит);
	КонецЕсли;
	
	Попытка
	
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ФиксированноеЗначение Тогда
			ВычисленноеЗначение = ПолучитьФиксированноеЗначение(ПравилоКонвертации.ВыражениеВычисления, ПравилоКонвертации.ВыражениеВычисленияТипЗначения, ПравилоКонвертации.ВыражениеВычисленияУИД);
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод Тогда
			
			РезультатВычисления = Неопределено;
			
			Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) Тогда
				ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр;
			ИначеЕсли ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) Тогда
				ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисления;
			Иначе
				ВыражениеВычисления = Неопределено;
			КонецЕсли;
			
			Если ВыражениеВычисления <> Неопределено Тогда
				
				Параметры = Новый Структура;
				Параметры.Вставить("ПравилоКонвертации", ПравилоКонвертации);
				Параметры.Вставить("Основание", Основание);
				Параметры.Вставить("Объект", Объект);
				Параметры.Вставить("Переменные", Переменные);
				Параметры.Вставить("ДанныеДляПроверки", ДанныеДляПроверки);
				
				ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
					ВыражениеВычисления, Параметры);
				
			Иначе
				
				ВычисленноеЗначение = Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика Тогда
			
			текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления_ДокУчСист(Основание, ПравилоКонвертации, , Переменные, ПроверитьНастройкуКонвертации);
				
			ВычисленноеЗначение = текРеквизит;
			
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика Тогда
			
			текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления_ДокУчСист(Основание, ПравилоКонвертации, , Переменные, ПроверитьНастройкуКонвертации);
			
			ВычисленноеЗначение = текРеквизит;
			
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитУчСист Тогда
			
			текРеквизит = ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления_ДокУчСист(Объект.Ссылка, ПравилоКонвертации, , Переменные, ПроверитьНастройкуКонвертации);
				
			ВычисленноеЗначение = текРеквизит;
			
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие Тогда
			
			РеквизитДокОснования = ПравилоКонвертации.Выражениевычисления;
			
			ТипПравила = ТипЗнч(ПравилоКонвертации);
			Если ТипПравила = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ЗаполнениеДокУчСист")
				Или ТипПравила = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ЗаполнениеДокУчСистТЧ")
				Или ТипПравила = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПеременныеДокУчСист") Тогда
				
				// Найдем первое соответствие
				ВычисленноеЗначение = ПолучитьПервоеСоответствие(Основание[РеквизитДокОснования]);
			Иначе
				ВычисленноеЗначение = Неопределено;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ВычисленноеЗначение) Тогда
				ВычисленноеЗначение = ДвижокКонвертации_КонвертироватьОбъектЛогистикиВОбъектУС(
					ПравилоКонвертации.КонвертироватьПоНастройке, Основание[РеквизитДокОснования], Переменные);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.Очистить Тогда			
			ВычисленноеЗначение = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РеквизитПроверка) Тогда
			РеквизитПроверка.Значение = ВычисленноеЗначение;
		КонецЕсли;
		
	Исключение
		
		ВычисленноеЗначение = Неопределено;
		Результат.ОписаниеОшибки = "Не удалось вычислить " + ПравилоКонвертации.ВыражениеВычисления + ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр + " по причине: " + ОписаниеОшибки();
		
		Если Не ПроверитьНастройкуКонвертации Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Результат.ОписаниеОшибки);
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(РеквизитПроверка) Тогда
			РеквизитПроверка.ТекстОшибки = Результат.ОписаниеОшибки;
		КонецЕсли;
		
	КонецПопытки;
	
	ДанныеДляПроверки.Вставить(РеквизитПроверка.Наименование, РеквизитПроверка);
	
	//ВычисленноеЗначениеНеПустое = ДвижокКонвертации_ВычисленноеЗначениеНеПустое(ВычисленноеЗначение);
	
	СконвертированноеЗначение = Неопределено;
	
	СконвертированноеЗначение = ВычисленноеЗначение;
	
	//TODO: добавить конвертацию
	
	Если СконвертированноеЗначение <> Неопределено Тогда 
		Результат.Успешно = Истина;
	КонецЕсли;
	
	Результат.Вставить("Значение", ВычисленноеЗначение);
	
	Возврат Результат; 
	
КонецФункции

Процедура ЗаполнитьСтрокуПроизвольнойТЧУчСист(НоваяСтрокаТЧ, Знач ДокументТитул, Знач СтрокиКонвертации, Знач НастройкаКонвертации, Объект, Переменные, ПроверитьНастройкуКонвертации, СтрокаПроверка)
	
	Для Каждого СтрокаНастройкиКонвертацииТЧ Из СтрокиКонвертации Цикл
		
		Если СтрокаНастройкиКонвертацииТЧ.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять Тогда
			Продолжить;
		КонецЕсли;
		
		//Если ПроверитьНастройкуКонвертации Тогда		
		//	РеквизитПроверка = Новый Структура;
		//	РеквизитПроверка.Вставить("Наименование");			
		//	РеквизитПроверка.Вставить("Значение");
		//	РеквизитПроверка.Вставить("ТекстОшибки");
		//КонецЕсли;
		
		РезультатВычисления = ВычислитьЗначениеРеквизитаУчСист(СтрокаНастройкиКонвертацииТЧ, ДокументТитул, Объект, Переменные, СтрокаПроверка, ПроверитьНастройкуКонвертации);
		
		//Если ПроверитьНастройкуКонвертации Тогда						
		//	СтрокаПроверка.Вставить(РеквизитПроверка.Наименование, РеквизитПроверка);						
		//КонецЕсли;
		
		Если РезультатВычисления.Успешно  Тогда
			
			НоваяСтрокаТЧ[СтрокаНастройкиКонвертацииТЧ.Реквизит] = РезультатВычисления.Значение;
			
		Иначе
			
			Если Не ПроверитьНастройкуКонвертации Тогда
				Сообщить("Не удалось рассчитать: " + СтрокаНастройкиКонвертацииТЧ.Реквизит + 
					" по " + ДокументТитул + " - " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатВычисления));
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьФиксированноеЗначение(ВыражениеВычисления, ВыбранныйТипЗначения, УИД) Экспорт
	
	Если ПустаяСтрока(ВыбранныйТипЗначения) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВыбранныйТипЗначения = "Строка" 
		ИЛИ ВыбранныйТипЗначения = "Число"
		ИЛИ ВыбранныйТипЗначения = "Дата"
		ИЛИ ВыбранныйТипЗначения = "Булево" Тогда
		
		Возврат ВыражениеВычисления;
		
	Иначе
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(ВыбранныйТипЗначения));
		
		Если Метаданные.Справочники.Содержит(ОбъектМетаданных) И ЗначениеЗаполнено(УИД) Тогда
		    	
				Возврат Справочники[МетаДанные.НайтиПоТипу(Тип(ВыбранныйТипЗначения)).Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				
		ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) И ЗначениеЗаполнено(УИД) Тогда
		    	
				Возврат Документы[МетаДанные.НайтиПоТипу(Тип(ВыбранныйТипЗначения)).Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				
		ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) И ЗначениеЗаполнено(УИД) Тогда
		    	
				Возврат ПланыСчетов[МетаДанные.НайтиПоТипу(Тип(ВыбранныйТипЗначения)).Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				
		ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) И ЗначениеЗаполнено(УИД) Тогда
		    	
				Возврат ПланыВидовРасчета[МетаДанные.НайтиПоТипу(Тип(ВыбранныйТипЗначения)).Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				
		ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) И ЗначениеЗаполнено(УИД) Тогда
		    	
				Возврат ПланыВидовХарактеристик[МетаДанные.НайтиПоТипу(Тип(ВыбранныйТипЗначения)).Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				
		ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		
			Возврат Перечисления[ОбъектМетаданных.Имя][ВыражениеВычисления];
		
		КонецЕсли;
		
	КонецЕсли;	
	
КонецФункции

Функция ДвижокКонвертации_ВычислитьРеквизитПоВыражениюВычисления_ДокУчСист(Знач Основание, Знач ПравилоКонвертации, ОснованиеЯвляетсяОбъектом = Ложь, Переменные, ПроверитьНастройкуКонвертации)
	
	Перем МассивРеквизитов, РасчетныйРеквизит, текРеквизит;
	
	Если Не ОснованиеЯвляетсяОбъектом И Не ЗначениеЗаполнено(Основание) И Не ПроверитьНастройкуКонвертации Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр) И ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод Тогда
		ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр;
	ИначеЕсли ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления) Тогда
		ВыражениеВычисления = ПравилоКонвертации.ВыражениеВычисления;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Найти(ПравилоКонвертации.ВыражениеВычисления, "Переменные.") > 0 Тогда 
		
		// объектом доп. свойства является переменная
		Параметры = Новый Структура;
		Параметры.Вставить("Основание", Основание);
		Параметры.Вставить("ПравилоКонвертации", ПравилоКонвертации);
		Параметры.Вставить("Переменные", Переменные);
		
		текРеквизит = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			СокрЛП(ВыражениеВычисления), Параметры);
		
	Иначе
		
		// реквизиты могут быть составными через точку
		
		текРеквизит = Основание;
		МассивРеквизитов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СокрЛП(ВыражениеВычисления), ".");
		Для Каждого РасчетныйРеквизит Из МассивРеквизитов Цикл 
			текРеквизит = текРеквизит[РасчетныйРеквизит];
		КонецЦикла;
		
	КонецЕсли;	
		
	Возврат текРеквизит;

КонецФункции

Процедура ДобавитьРеквизитВСтруктуруЗаполнения(тзПроцессЗаполнения, ПравилоКонвертации, ВычисленноеЗначение)
	
	Если ПравилоКонвертации.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить Тогда		
		
		Найд = тзПроцессЗаполнения.Найти(ПравилоКонвертации.ТипАлгоритма, "ТипАлгоритма");
		Если Найд = Неопределено Тогда
			
			НоваяСтрока = тзПроцессЗаполнения.Добавить();
			НоваяСтрока.ТипАлгоритма = ПравилоКонвертации.ТипАлгоритма;
			НоваяСтрока.ДанныеДляЗаполнения = Новый Структура(ПравилоКонвертации.Реквизит, ВычисленноеЗначение);
			НоваяСтрока.Реквизит = ПравилоКонвертации.Реквизит;
			НоваяСтрока.ОбновитьЗначение = ПравилоКонвертации.ОбновитьИзДокУчСист;
			
		Иначе
			Найд.ДанныеДляЗаполнения.Вставить(ПравилоКонвертации.Реквизит, ВычисленноеЗначение);
		КонецЕсли;
		
	ИначеЕсли ПравилоКонвертации.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит Тогда
			
		НоваяСтрока = тзПроцессЗаполнения.Добавить();
		НоваяСтрока.ТипАлгоритма = ПравилоКонвертации.ТипАлгоритма;
		НоваяСтрока.ДанныеДляЗаполнения = Новый Структура(ПравилоКонвертации.Реквизит, ВычисленноеЗначение);
		НоваяСтрока.Реквизит = ПравилоКонвертации.Реквизит;
		НоваяСтрока.ОбновитьЗначение = ПравилоКонвертации.ОбновитьИзДокУчСист;
			
	КонецЕсли;
	
КонецПроцедуры

Функция ДвижокКонвертации_ВычислитьПеременные_ОбратныйМаппинг(Знач Основание, Знач ДокументОбъект, Знач НастройкаКонвертации, ИмяТабчасти, ПроверитьНастройкуКонвертации, ДанныеДляПроверки) Экспорт
	
	ДанныеДляПроверки.Вставить("Переменные", Новый Структура);
	
	Переменные = Новый Структура;
	
	Для каждого ПравилоКонвертации Из НастройкаКонвертации.ПеременныеДокУчСист Цикл
		
		РеквизитПроверка = Новый Структура;
		РеквизитПроверка.Вставить("Наименование");
		РеквизитПроверка.Вставить("Значение");
		РеквизитПроверка.Вставить("ТекстОшибки");
		
		Если ПравилоКонвертации.СпособРасчета <> Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять
			И ПравилоКонвертации.СпособРасчета <> Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.Очистить
			И (Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления)
				И Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр)) Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если ПравилоКонвертации.ИмяТабЧасти = ИмяТабчасти Тогда
			
			Результат = ВычислитьЗначениеРеквизитаУчСист(ПравилоКонвертации, Основание, ДокументОбъект, "", РеквизитПроверка, ПроверитьНастройкуКонвертации, Истина);
			
			Переменные.Вставить(ПравилоКонвертации.Имя, Результат.Значение);
			
			Если ЗначениеЗаполнено(РеквизитПроверка.Наименование) Тогда
				ДанныеДляПроверки.Переменные.Вставить(РеквизитПроверка.Наименование, РеквизитПроверка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Переменные;
	
КонецФункции

Процедура ЗаполнитьДокументУчетнойСистемыПоТитулу(ДокументДогистика, УстановитьСтатусОбработан = Ложь, БылиОшибкиПриКонвертации = Ложь) Экспорт
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументДогистика);
	
	НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляТекущегоТитула(ДокументДогистика);
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
								ТипЛогистика, 
								ДокументДогистика.ДокументОснование);
								
	Если Не НастройкаКонвертации.ОбратныйМаппинг Тогда
		
		Если ЗначениеЗаполнено(НайденныйДокУчСист) И Не ЗначениеЗаполнено(ДокументДогистика.ДокументОснование) Тогда
			ДокументДогистикаОб = ДокументДогистика.ПолучитьОбъект();
			ДокументДогистикаОб.ДокументОснование = НайденныйДокУчСист;
			ДокументДогистикаОб.Записать();
		КонецЕсли;	
			
		Сообщить("Обратный маппинг не настроен");
		
		Возврат;
		
	КонецЕсли;
	
	ДокОб = Неопределено;
		
	Если ЗначениеЗаполнено(ДокументДогистика.ДокументОснование) Тогда
		ДокОб = ДокументДогистика.ДокументОснование.ПолучитьОбъект();
	Иначе
			
		Если ЗначениеЗаполнено(НайденныйДокУчСист) Тогда
			ДокОб = НайденныйДокУчСист.ПолучитьОбъект();
		Иначе
			Если НастройкаКонвертации.СоздаватьДокУчСис Тогда
				ДокОб = Документы[НастройкаКонвертации.ТипДокумента1С].СоздатьДокумент();	
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДокОб <> Неопределено Тогда		
		КонтурЛогистика_КонвертацияСервер.СконвертироватьДокументУчетнойСистемыПоТитулу(ДокументДогистика, ДокОб, НастройкаКонвертации, УстановитьСтатусОбработан, , , БылиОшибкиПриКонвертации);		 				
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КонвертацияРС

Процедура КонвертироватьПриТриггереПоСтатусуДО(ДокументСтатусаДО, СтатусДО) Экспорт
	
	Если ТипЗнч(ДокументСтатусаДО) <> Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеТитула1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		ДокументСтатусаДО, "ДокументОснование, ЛицоОформившееПЛ, kl_id");
	
	ДокументУчетнойСистемы = ДанныеТитула1.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументУчетнойСистемы) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРесурса = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(ДокументУчетнойСистемы);
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НастройкаДляОбработкиПоСтатусу(
		СтатусДО, ИмяРесурса);
	
	Если НастройкаКонвертации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонвертироватьОбъектУчетнойСистемыВРС(НастройкаКонвертации, ДокументУчетнойСистемы, ДокументСтатусаДО);
	
КонецПроцедуры

Процедура КонвертироватьПриТриггереУникальноеИмяПрограммногоВызова(Знач ИмяПрограммногоВызова, Знач УчетныйДокумент, Знач ДокументЛогистики) Экспорт
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НастройкаПоТриггерУникальноеИмяПрограммногоВызова(
		ИмяПрограммногоВызова);
	
	Если НастройкаКонвертации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонвертироватьОбъектУчетнойСистемыВРС(НастройкаКонвертации, УчетныйДокумент, ДокументЛогистики);
	
КонецПроцедуры

Процедура КонвертироватьОбъектУчетнойСистемыВРС(Знач НастройкаКонвертации, Знач ДокументУчетнойСистемы, Знач ДокументЛогистики, Переменные = Неопределено) Экспорт
	
	Попытка
		
		// Описание записи
		ТекущаяЗапись = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.МанифестЗаписи();
		
		// Для способа маппинга - Из предыдущего титула
		Если ЗначениеЗаполнено(ДокументЛогистики) Тогда
			ТекущаяЗапись.Вставить("Титул1", ДокументЛогистики);
		КонецЕсли;
		
		// Конвертация
		ОшибкиКонвертации = Новый Массив;
		КонвертироватьВРеквизитыРС(ТекущаяЗапись, НастройкаКонвертации, ДокументУчетнойСистемы, Переменные, ОшибкиКонвертации);
		
		// Проверка заполнения обязательных реквизитов
		Если Не ЗначениеЗаполнено(ТекущаяЗапись.ОрганизацияДиадок)
			Или Не ЗначениеЗаполнено(ТекущаяЗапись.ТипДанных)
			Или Не ЗначениеЗаполнено(ТекущаяЗапись.Разрез1)
			Или Не ЗначениеЗаполнено(ТекущаяЗапись.Разрез2) Тогда
			
			Возврат;
		КонецЕсли;
		
		// Запишем в РС
		НаборЗаписей = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОрганизацияДиадок.Установить(ТекущаяЗапись.ОрганизацияДиадок);
		НаборЗаписей.Отбор.ТипДанных.Установить(ТекущаяЗапись.ТипДанных);
		НаборЗаписей.Отбор.Разрез1.Установить(ТекущаяЗапись.Разрез1);
		НаборЗаписей.Отбор.Разрез2.Установить(ТекущаяЗапись.Разрез2);
		Если ТекущаяЗапись.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.Заправка Тогда
			НаборЗаписей.Отбор.Разрез3.Установить(ТекущаяЗапись.Разрез3);
		КонецЕсли;
		НаборЗаписей.Прочитать();
		
		// Уже есть и еще не отправлено, то перезаполним
		Если НаборЗаписей.Количество() = 0 Тогда
			
			НоваяЗапись = НаборЗаписей.Добавить();
			
		Иначе
			
			НоваяЗапись = НаборЗаписей[0];
			Если НоваяЗапись.СинхронизацияССервисом <> Перечисления.КонтурЛогистика_СтатусыСинхронизации.НеНачата Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекущаяЗапись);
		
		// Обработана на строне 1С
		Если ОшибкиКонвертации.Количество() = 0 Тогда
			НоваяЗапись.СинхронизацияСОбъектом1С = Перечисления.КонтурЛогистика_СтатусыСинхронизации.УспешноЗавершена;
			НоваяЗапись.СинхронизацияССервисом = Перечисления.КонтурЛогистика_СтатусыСинхронизации.НеНачата;
		Иначе
			НоваяЗапись.СинхронизацияСОбъектом1С = Перечисления.КонтурЛогистика_СтатусыСинхронизации.Ошибка;
			НоваяЗапись.СинхронизацияССервисом = Перечисления.КонтурЛогистика_СтатусыСинхронизации.Пропустить;
			
			НоваяЗапись.ТекстОшибки = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(ОшибкиКонвертации, Символы.ПС + Символы.ПС);
		КонецЕсли;
		
		НоваяЗапись.ДокументОснование = ДокументУчетнойСистемы;
		НоваяЗапись.НастройкаКонвертацииРС = НастройкаКонвертации;
		
		НаборЗаписей.Записать();
		
	Исключение
		
		ТекстОшибки = "Ошибка при конвертации в РС объекта: " + Строка(ДокументУчетнойСистемы) + "
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонтурЛогистика_Метрика.ОбработатьОшибку("КонвертацияСервер.КонвертироватьОбъектУчетнойСистемыВРС",
			ТекстОшибки, НастройкаКонвертации);
		
		Возврат;
		
	КонецПопытки;
	
	МестоВызова = "КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемыВРС";
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Конвертация регистра сведений", "Конвертация учетного документа в РС", МестоВызова, НастройкаКонвертации.ОтборТипДанных);
	
КонецПроцедуры

Процедура КонвертироватьВРеквизитыРС(ТекущаяЗапись, НастройкаКонвертации, ДокументУчетнойСистемы, Переменные, ОшибкиКонвертации)
	
	ПравилаКонвертации = НастройкаКонвертации.ПравилаКонвертации;
	
	Для Каждого ПравилоКонвертацииРеквизита Из ПравилаКонвертации Цикл
		
		РезультатРасчета = ДвижокКонвертации_ВычислитьРеквизитОснования(
			ДокументУчетнойСистемы, ПравилоКонвертацииРеквизита, НастройкаКонвертации, ТекущаяЗапись,, Переменные);
		
		Если Не РезультатРасчета.Успешно Тогда
			
			ТекстОшибки = "Не смог рассчитать реквизит: " + ПравилоКонвертацииРеквизита.РеквизитРегистраСведений
				+ " по причине: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатРасчета);
			
			ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ;
			Если ПравилоКонвертацииРеквизита.РеквизитРегистраСведений = "Реквизит1"
				И НастройкаКонвертации.ОтборТипДанных = ТипДанных Тогда
				
				ПредставленияПолей = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ПараметрыПолейПоТипуДанных(ТипДанных);
				
				ПояснениеОшибки = "Проверьте, что ГСМ сопоставлено со справочником ""Горюче-смазочные материалы"".";
				ТекстОшибки = ПояснениеОшибки + Символы.ПС + Символы.ПС
					+ СтрЗаменить(ТекстОшибки, ПравилоКонвертацииРеквизита.РеквизитРегистраСведений,
						ПредставленияПолей[ПравилоКонвертацииРеквизита.РеквизитРегистраСведений].Заголовок);
			КонецЕсли;
			
			ОшибкиКонвертации.Добавить(ТекстОшибки);
			
		КонецЕсли;
		
		ТекущаяЗапись[ПравилоКонвертацииРеквизита.РеквизитРегистраСведений] = РезультатРасчета.Значение;
		
		// Подключаемый модуль
		Отказ = Ложь;
		ПараметрыПМ = Новый Структура;
		ПараметрыПМ.Вставить("ТекущаяЗапись", ТекущаяЗапись);
		ПараметрыПМ.Вставить("НастройкаКонвертации", НастройкаКонвертации);
		ПараметрыПМ.Вставить("ДокументУчетнойСистемы", ДокументУчетнойСистемы);
		ПараметрыПМ.Вставить("Переменные", Переменные);
		ПараметрыПМ.Вставить("Отказ", Отказ);
		
		КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"КонвертироватьВРеквизитыРС_После", Истина, ПараметрыПМ);
		Если ПараметрыПМ.Отказ Тогда
			ТекущаяЗапись.ОрганизацияДиадок = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьПроизвольныеДанныеРС() Экспорт
	
	ЕстьУспешныеКонвертации = Ложь;
	
	// Получим данные для обработки
	ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.УстановитьПараметр("СинхронизацияСОбъектом1С", Перечисления.КонтурЛогистика_СтатусыСинхронизации.НеНачата);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок КАК ОрганизацияДиадок,
	|	КонтурЛогистика_ПроизвольныеДанные.ТипДанных КАК ТипДанных,
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез1 КАК Разрез1,
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез2 КАК Разрез2,
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез3 КАК Разрез3,
	|	КонтурЛогистика_ПроизвольныеДанные.Количество КАК Количество,
	|	КонтурЛогистика_ПроизвольныеДанные.Дата КАК Дата,
	|	КонтурЛогистика_ПроизвольныеДанные.Ответственный КАК Ответственный,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1 КАК Реквизит1
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных
	|	И КонтурЛогистика_ПроизвольныеДанные.СинхронизацияСОбъектом1С = &СинхронизацияСОбъектом1С";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбработатьСтрокуПроизвольныхДанныхРС(Выборка);
		ЕстьУспешныеКонвертации = Истина;
	КонецЦикла;
	
	Если ЕстьУспешныеКонвертации Тогда
		МестоВызова = "КонтурЛогистика_КонвертацияСервер.ОбработатьПроизвольныеДанныеРС";
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Конвертация регистра сведений", "Конвертация РС в учетный документ", МестоВызова, ТипДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьСтрокуПроизвольныхДанныхРС(Знач ДанныеЗаписи) Экспорт
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.КонтурЛогистика_ПроизвольныеДанные");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировкиДанных.УстановитьЗначение("ОрганизацияДиадок", ДанныеЗаписи.ОрганизацияДиадок);
		ЭлементБлокировкиДанных.УстановитьЗначение("ТипДанных", ДанныеЗаписи.ТипДанных);
		ЭлементБлокировкиДанных.УстановитьЗначение("Разрез1", ДанныеЗаписи.Разрез1);
		ЭлементБлокировкиДанных.УстановитьЗначение("Разрез2", ДанныеЗаписи.Разрез2);
		ЭлементБлокировкиДанных.УстановитьЗначение("Разрез3", ДанныеЗаписи.Разрез3);
		БлокировкаДанных.Заблокировать();
		
		Статус = Перечисления.КонтурЛогистика_СтатусыСинхронизации.УспешноЗавершена;
		НастройкаКонвертации = Неопределено;
		ДокументУчетнойСистемы = Неопределено;
		ТекстОшибки = "";
		
		Попытка
			
			Если ДанныеЗаписи.ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ Тогда
				// Определяем только во типу показаний топлива (Разрез2)
				НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НастройкаДляКонвертацииВОбъект1С(
					ДанныеЗаписи.ТипДанных, "", ДанныеЗаписи.Разрез2, "");
			Иначе
				НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НастройкаДляКонвертацииВОбъект1С(
					ДанныеЗаписи.ТипДанных, ДанныеЗаписи.Разрез1, ДанныеЗаписи.Разрез2, ДанныеЗаписи.Разрез3);
			КонецЕсли;
			
			Если НастройкаКонвертации <> Неопределено Тогда
				ДокументУчетнойСистемы = КонвертироватьДанныеРСВОбъектУчетнойСистемы(НастройкаКонвертации, ДанныеЗаписи);
				ЕстьУспешныеКонвертации = Истина;
			КонецЕсли;
			
		Исключение
			
			Статус = Перечисления.КонтурЛогистика_СтатусыСинхронизации.Ошибка;
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
		КонецПопытки;
		
		РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ОбновитьСтатусыСинхронизации(
			ДанныеЗаписи,, Статус, ТекстОшибки, НастройкаКонвертации, ДокументУчетнойСистемы);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Коныертация произволных данные из РС в объект 1С: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Функция КонвертироватьДанныеРСВОбъектУчетнойСистемы(Знач НастройкаКонвертации, Знач ДанныеЗаписи)
	
	УчетныйДокумент = Неопределено;
	Если ЗначениеЗаполнено(НастройкаКонвертации.ПоискУчетногоДокумента) Тогда
		// Найдем по коду
		Параметры = Новый Структура;
		Параметры.Вставить("ДанныеЗаписи", ДанныеЗаписи);
		
		УчетныйДокумент = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			СокрЛП(НастройкаКонвертации.ПоискУчетногоДокумента), Параметры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УчетныйДокумент) Тогда
		// Берем на редактирование
		УчетныйДокументОбъект = УчетныйДокумент.ПолучитьОбъект();
	ИначеЕсли НастройкаКонвертации.СоздаватьДокУчСис Тогда
		// Создадим новый
		УчетныйДокументОбъект = Документы[НастройкаКонвертации.ИмяРесурса].СоздатьДокумент();
	Иначе
		// Не нашли и не надо создавать
		Возврат Неопределено;
	КонецЕсли;
	
	ПроверитьНастройкуКонвертации = Ложь;
	ДанныеДляПроверки = Новый Структура;
	Переменные = ДвижокКонвертации_ВычислитьПеременные_ОбратныйМаппинг(
		ДанныеЗаписи, УчетныйДокумент, НастройкаКонвертации, "", ПроверитьНастройкуКонвертации, ДанныеДляПроверки);
	
	// Заполним - ЗаполнениеДокУчСист
	КонвертироватьДанныеРСВЗаполнениеДокУчСист(НастройкаКонвертации, ДанныеЗаписи, УчетныйДокументОбъект,
		Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации);
	
	// Заполним - ЗаполнениеДокУчСистТЧ
	КонвертироватьДанныеРСВЗаполнениеДокУчСистТЧ(НастройкаКонвертации, ДанныеЗаписи, УчетныйДокументОбъект,
		Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации);
	
	// Финальная обработка документа
	Если УчетныйДокументОбъект.Дата = Дата(1, 1, 1) Тогда
		УчетныйДокументОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	// Подключаемый модуль
	Отказ = Ложь;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("УчетныйДокументОбъект", УчетныйДокументОбъект);
	ПараметрыПМ.Вставить("НастройкаКонвертации", НастройкаКонвертации);
	ПараметрыПМ.Вставить("ДанныеЗаписи", ДанныеЗаписи);
	ПараметрыПМ.Вставить("Переменные", Переменные);
	ПараметрыПМ.Вставить("Отказ", Отказ);
	
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"КонвертироватьДанныеРСВОбъектУчетнойСистемы_После", Истина, ПараметрыПМ);
	Если ПараметрыПМ.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Запишем документ
	Если Не ПроверитьНастройкуКонвертации Тогда
		
		Если НастройкаКонвертации.ПроводитьДокУчСис Тогда
			УчетныйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			УчетныйДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УчетныйДокументОбъект.Ссылка;
	
КонецФункции

Процедура КонвертироватьДанныеРСВЗаполнениеДокУчСист(НастройкаКонвертации, ДанныеЗаписи, УчетныйДокументОбъект, Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации)
	
	ПроцессЗаполнения = Новый ТаблицаЗначений;
	ПроцессЗаполнения.Колонки.Добавить("ТипАлгоритма");
	ПроцессЗаполнения.Колонки.Добавить("ДанныеДляЗаполнения");
	ПроцессЗаполнения.Колонки.Добавить("ПроизвольныйКод");
	ПроцессЗаполнения.Колонки.Добавить("Реквизит");
	ПроцессЗаполнения.Колонки.Добавить("ОбновитьЗначение");
	
	Для Каждого ПравилоКонвертации Из НастройкаКонвертации.ЗаполнениеДокУчСист Цикл
		
		Если ПравилоКонвертации.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
			
			НоваяСтрока = ПроцессЗаполнения.Добавить();
			НоваяСтрока.ТипАлгоритма = ПравилоКонвертации.ТипАлгоритма;
			НоваяСтрока.ПроизвольныйКод = ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр;
			
			Продолжить;
			
		КонецЕсли;
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять
			Или (ПравилоКонвертации.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить
				И ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.Очистить)
			Или (Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисления)
				И Не ЗначениеЗаполнено(ПравилоКонвертации.ВыражениеВычисленияСтрокаНеогр)
				И Не ЗначениеЗаполнено(ПравилоКонвертации.КонвертироватьПоНастройке)) Тогда
				
			Продолжить;
		КонецЕсли;
		
		Результат = ВычислитьЗначениеРеквизитаУчСист(
			ПравилоКонвертации, ДанныеЗаписи, УчетныйДокументОбъект, Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации);
		
		ДобавитьРеквизитВСтруктуруЗаполнения(ПроцессЗаполнения, ПравилоКонвертации, Результат.Значение);
		
	КонецЦикла;
	
	Для Каждого Алгоритм Из ПроцессЗаполнения Цикл
		
		Если Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит
			И ЗначениеЗаполнено(Алгоритм.ДанныеДляЗаполнения) Тогда
			
			Если Не ЗначениеЗаполнено(УчетныйДокументОбъект[Алгоритм.Реквизит])
				Или (ЗначениеЗаполнено(УчетныйДокументОбъект[Алгоритм.Реквизит])
					И Алгоритм.ОбновитьЗначение) Тогда
				
				ЗаполнитьЗначенияСвойств(УчетныйДокументОбъект, Алгоритм.ДанныеДляЗаполнения);
			КонецЕсли;
			
		ИначеЕсли Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить
			И ЗначениеЗаполнено(Алгоритм.ДанныеДляЗаполнения)
			И Алгоритм.ДанныеДляЗаполнения.Количество() > 0 Тогда
			
			УчетныйДокументОбъект.Заполнить(Алгоритм.ДанныеДляЗаполнения);
			
		ИначеЕсли Алгоритм.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик
			И ЗначениеЗаполнено(Алгоритм.ПроизвольныйКод) Тогда
			
			Параметры = Новый Структура;
			Параметры.Вставить("ДанныеЗаписи", ДанныеЗаписи);
			Параметры.Вставить("ДокументОбъект", УчетныйДокументОбъект);
			Параметры.Вставить("Переменные", Переменные);
			
			КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
				СокрЛП(Алгоритм.ПроизвольныйКод), Параметры);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура КонвертироватьДанныеРСВЗаполнениеДокУчСистТЧ(НастройкаКонвертации, ДанныеЗаписи, УчетныйДокументОбъект, Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации)
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации.ИмяТабличнойЧастиЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	// Найдем или создадим строку ТЧ
	Если ЗначениеЗаполнено(НастройкаКонвертации.ПоискСтрокиТабличнойЧасти) Тогда
		Параметры = Новый Структура;
		Параметры.Вставить("ДанныеЗаписи", ДанныеЗаписи);
		Параметры.Вставить("ДокументОбъект", УчетныйДокументОбъект);
		Параметры.Вставить("Переменные", Переменные);
		
		НоваяСтрока = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			СокрЛП(НастройкаКонвертации.ПоискСтрокиТабличнойЧасти), Параметры);
		
		Если НоваяСтрока = Неопределено Тогда
			// Не создаем строку
			Возврат;
		КонецЕсли;
	Иначе
		НоваяСтрока = УчетныйДокументОбъект[НастройкаКонвертации.ИмяТабличнойЧастиЗаполнения].Добавить();
	КонецЕсли;
	
	Для Каждого ПравилоКонвертации Из НастройкаКонвертации.ЗаполнениеДокУчСистТЧ Цикл
		
		Если ПравилоКонвертации.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатВычисления = ВычислитьЗначениеРеквизитаУчСист(
			ПравилоКонвертации, ДанныеЗаписи, УчетныйДокументОбъект, Переменные, ДанныеДляПроверки, ПроверитьНастройкуКонвертации);
		
		Если РезультатВычисления.Успешно Тогда
			
			НоваяСтрока[ПравилоКонвертации.Реквизит] = РезультатВычисления.Значение;
			
		Иначе
			
			Если Не ПроверитьНастройкуКонвертации Тогда
				ТекстСообщения = "Не удалось рассчитать: " + ПравилоКонвертации.Реквизит
					+ " - " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатВычисления);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередачаДанныхЗаправкаГСМПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИспользуетсяПутевойЛист = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	Если Не ИспользуетсяПутевойЛист Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	Если ИмяКонфигурации1С <> "УАТ"
		И ИмяКонфигурации1С <> "ТЛЭ"
		И ИмяКонфигурации1С <> "УАТ_ПРОФ"
		И ИмяКонфигурации1С <> "ERP_УАТ" Тогда
		
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) <> Тип("ДокументОбъект.уатЗаправкаГСМ") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез3 КАК Разрез3
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ДокументОснование = &ДокументОснование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НастройкаПоТриггерУникальноеИмяПрограммногоВызова(
		"ПередачаДанныхЗаправкаГСМПриЗаписи");
	
	Если НастройкаКонвертации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяЗаправка Из Источник.Заправки Цикл
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДокументОснование", ТекущаяЗаправка.ПутевойЛист);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул1.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул1.ДокументОснование = &ДокументОснование";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДокументЛогистики = Выборка.Ссылка;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Переменные = Новый Структура;
		Переменные.Вставить("НомерСтроки", ТекущаяЗаправка.НомерСтроки);
		
		КонвертироватьОбъектУчетнойСистемыВРС(НастройкаКонвертации, Источник.Ссылка, ДокументЛогистики, Переменные);
		
	КонецЦикла;
	
	МестоВызова = "КонтурЛогистика_КонвертацияСервер.ПередачаДанныхЗаправкаГСМПриЗаписиПриЗаписи";
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Конвертация регистра сведений", "Конвертация учетного документа в РС", МестоВызова, НастройкаКонвертации.ОтборТипДанных);
	
КонецПроцедуры

#КонецОбласти

// в переданном документе-титуле (объекте) собирает указанные доп. реквизиты из данных переданных в ИнфоПолнях
Процедура ДопРеквизиты_ЗаполнитьИзИнфПол(Знач МассивДопРеквизитовДокумента, ДокументТитулОбъект, СоздаватьСущностьЕслиНеНайдена = Ложь) Экспорт
	
	ИнфПол = ДокументТитулОбъект.ИнфПол;
	
	Если ИнфПол.Количество() > 0 Тогда 
		
		Для Каждого ДопРеквизит Из МассивДопРеквизитовДокумента Цикл 
			
			// найдем такие строки ТЧ Инфпол
			ИмяСущности = ДопРеквизит;
			РеквизитыСущности = Новый Соответствие;
			Для Каждого СтрокаИнфПол Из ИнфПол Цикл 
				
				РазложенныйИдентиф = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СтрокаИнфПол.Идентиф, "_");
				ЭтоСсылочнаяСущность = РазложенныйИдентиф.Количество() > 1;
				
				Если РазложенныйИдентиф[0] = ИмяСущности Тогда
					Если ЭтоСсылочнаяСущность Тогда 
						РеквизитыСущности.Вставить(РазложенныйИдентиф[1], СтрокаИнфПол.Значение); 
					Иначе
						РеквизитыСущности.Вставить("ПростоеЗначение", СтрокаИнфПол.Значение);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если РеквизитыСущности.Количество() = 0 Тогда 
				Продолжить; // в инфополях не пришел этот допреквизит
			КонецЕсли;
			
			// Попробуем найти эту сущность и подставить в документ
			Попытка
				ТипЗначенияСущности = ТипЗнч(ДокументТитулОбъект[ИмяСущности]);
			Исключение
				// такого реквизита нет - ок, хотя это конечно косяк
				Продолжить;
			КонецПопытки;
			
			Если ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок")
				Или ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута")
				Или ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники")
				Или ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства")
				Или ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_Договоры") Тогда
				
				// будем искать сущность и если не найдем - создадим
				
				Если ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда
					СпособКонвертации = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок;
				ИначеЕсли ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута") Тогда
					СпособКонвертации = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута;
				ИначеЕсли ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") Тогда
					СпособКонвертации = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника;
				ИначеЕсли ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства") Тогда
					СпособКонвертации = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство;
				ИначеЕсли ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_Договоры") Тогда
					СпособКонвертации = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор;	
				КонецЕсли;
				
				РезультатПоиска = КонтурЛогистика_КонвертацияСервер.ПоискОбъектаЛогистикиПоРеквизитамУниверсальный(
									СпособКонвертации,
									РеквизитыСущности);
									
				Если РезультатПоиска.Успешно Тогда
										
					ДокументТитулОбъект[ИмяСущности] = РезультатПоиска.Значение;
					
					Если ТипЗначенияСущности = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") 
						И ЗначениеЗаполнено(РезультатПоиска.Значение) Тогда 
						
						СинхронизироватьТелефонИВУСотрудника(РезультатПоиска.Значение, РеквизитыСущности);
						
					КонецЕсли;
					
				Иначе
					
					РезультатСоздания = КонтурЛогистика_КонвертацияСервер.СоздатьОбъектЛогистикиПоРеквизитамУниверсальный(
											СпособКонвертации,
											РеквизитыСущности);
											
					Если РезультатСоздания.Успешно Тогда
												
						ДокументТитулОбъект[ИмяСущности] = РезультатСоздания.СозданныйОбъектСсылка;
						
						Если ИмяСущности = "Водитель" Или ИмяСущности = "Водитель2" Тогда 
							ВодительОбъект = РезультатСоздания.СозданныйОбъектСсылка.ПолучитьОбъект();
							ВодительОбъект.РольВодитель = Истина;
							ВодительОбъект.Записать();
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ТипЗначенияСущности = Тип("ПеречислениеСсылка.КонтурЛогистика_СтавкиНДС") Тогда
				
				локЗначение = РеквизитыСущности["ПростоеЗначение"];
				Если локЗначение <> Неопределено Тогда 
					ДокументТитулОбъект[ИмяСущности] = Перечисления.КонтурЛогистика_СтавкиНДС.СтавкаНДСПоПредставлению(локЗначение);
				КонецЕсли;
				
			Иначе
				
				// примитив - просто присвоить
				
				Если ТипЗначенияСущности = Тип("Строка") Тогда
					локЗначение = РеквизитыСущности["ПростоеЗначение"];
					Если локЗначение <> Неопределено Тогда 
						ДокументТитулОбъект[ИмяСущности] = РеквизитыСущности["ПростоеЗначение"];
					КонецЕсли;
				ИначеЕсли ТипЗначенияСущности = Тип("Булево") Тогда 
					локЗначение = РеквизитыСущности["ПростоеЗначение"];
					Если локЗначение <> Неопределено Тогда 
						ДокументТитулОбъект[ИмяСущности] = Булево(РеквизитыСущности["ПростоеЗначение"]);
					КонецЕсли;
				ИначеЕсли ТипЗначенияСущности = Тип("Дата") Тогда 
					локЗначение = РеквизитыСущности["ПростоеЗначение"];
					Если локЗначение <> Неопределено Тогда 
						ДокументТитулОбъект[ИмяСущности] = Дата(РеквизитыСущности["ПростоеЗначение"]);
					КонецЕсли;
				ИначеЕсли ТипЗначенияСущности = Тип("Число") Тогда
					локЗначение = РеквизитыСущности["ПростоеЗначение"];
					Если локЗначение <> Неопределено Тогда 
						ДокументТитулОбъект[ИмяСущности] = Число(РеквизитыСущности["ПростоеЗначение"]);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура СинхронизироватьТелефонИВУСотрудника(Знач СотрудникСсылка, Знач РеквизитыСущности)
	
	Перем ПроверяемыйРеквизит, СотрудникОбъект;
	
	// проверим что не изменились реквизиты телефон и данный ВУ 
	Для Каждого ПроверяемыйРеквизит Из РеквизитыСущности Цикл
		
		Если СотрудникСсылка[ПроверяемыйРеквизит.Ключ] <> ПроверяемыйРеквизит.Значение Тогда 
			
			СотрудникОбъект = СотрудникСсылка.ПолучитьОбъект();
			
			Если ТипЗНЧ(СотрудникОбъект[ПроверяемыйРеквизит.Ключ]) = Тип("Дата") Тогда 
				СотрудникОбъект[ПроверяемыйРеквизит.Ключ] = КонтурЛогистика_КонструкторыXDTO.Конвертировать_ДатаТип_вДата(ПроверяемыйРеквизит.Значение);
			Иначе
				СотрудникОбъект[ПроверяемыйРеквизит.Ключ] = ПроверяемыйРеквизит.Значение;
			КонецЕсли;
			
			СотрудникОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// конвертация справочников

Процедура НастройкиКонвертацииСправочников_ПриСозданииНаСервере(Форма, ИмяСправочника, Родитель, Элемент) Экспорт
	
	СоздатьРеквизитыФормы(Форма);
	ДобавитьЭлементыНаФорму(Форма, Родитель, Элемент);
	
	ОпределитьНастроЙкуАвтоконвертации(Форма, ИмяСправочника);
	
	Если ЗначениеЗаполнено(Форма.НастройкаКонвертации) И Форма.НастройкаКонвертации.Значение = Истина Тогда
		
		ЗаполнитьСписокНастроекКонвертации(Форма.СписокНастроекКонвертации, ИмяСправочника);
		УправлениеВидимостьюЭлементовФормы(Форма);
		
	Иначе
		
		Форма.Элементы.ПерейтиКНастройкеКонвертацииСправочника.Видимость 	= Ложь;
		Форма.Элементы.НастройкаКонвертацииСправочника.Видимость 			= Ложь;
		Форма.Элементы.КартинкаНастройкиКонвртацииСоздать.Видимость 		= Ложь;
		Форма.Элементы.СоздатьНастройкуКонвертации.Видимость 				= Ложь;
		Форма.Элементы.КнопкаВыбораЭлементаУчетнойСистемы.Видимость 		= Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьНастроЙкуАвтоконвертации(Форма, ИмяСправочника)
	
	ИмяПредопределенного = "Автоконвертация_" + ИмяСправочника;
	
	Форма.НастройкаКонвертации = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);	
	
КонецПроцедуры

Процедура СоздатьРеквизитыФормы(Форма)
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	ТипРеквизита = Новый ОписаниеТипов("Строка");
	
	РеквизитФормы = Новый РеквизитФормы(
		"НастройкаКонвертации", Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_Настройки"), "", "Настройка конвертации");
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
	
	РеквизитФормы = Новый РеквизитФормы(
		"НастройкаКонвертацииСправочника", Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников"),
		"", "Настройка конвертации справочников");
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
	
	РеквизитФормы = Новый РеквизитФормы(
		"СписокНастроекКонвертации", Новый ОписаниеТипов("СписокЗначений"), "", "Список настроек конвертации");
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Процедура ДобавитьЭлементыНаФорму(Форма, Родитель, Элемент)
	
	Элементы = Форма.Элементы;
	
	Группа = Элементы.Вставить("ГруппаНастройкиКонвертации", Тип("ГруппаФормы"), Родитель, Элемент);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Попытка
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Исключение
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	КонецПопытки;
	Группа.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Форма.Элементы.Добавить("НастройкаКонвертацииСправочника", Тип("ПолеФормы"), Группа);
	НовыйЭлемент.Вид 						= ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.ПутьКДанным 				= "НастройкаКонвертацииСправочника";
	НовыйЭлемент.Гиперссылка 				= Истина;
	НовыйЭлемент.ЦветТекста 				= ЦветаСтиля.ЦветТекстаФормы;
	НовыйЭлемент.АвтоМаксимальнаяШирина 	= Ложь;
	НовыйЭлемент.ПоложениеЗаголовка 		= ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.РастягиватьПоГоризонтали 	= Истина;
	
	НовыйЭлемент = Форма.Элементы.Добавить("ПерейтиКНастройкеКонвертацииСправочника", Тип("ДекорацияФормы"), Группа);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Найдено 3 настройки конвертации. Нажмите для перехода к нужной";
	НовыйЭлемент.Гиперссылка 				= Истина;
	НовыйЭлемент.ЦветТекста 				= ЦветаСтиля.ЦветТекстаФормы;
	НовыйЭлемент.АвтоМаксимальнаяШирина 	= Ложь;
	НовыйЭлемент.РастягиватьПоГоризонтали 	= Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "ПерейтиКНастройкеКонвертацииСправочника");
	
	// Элементы создания НКС
	ГруппаСоздание = Элементы.Добавить("ГруппаНастройкиКонвертации_СоздатьЭлемент", Тип("ГруппаФормы"), Группа);
	ГруппаСоздание.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Попытка
		ГруппаСоздание.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Исключение
		ГруппаСоздание.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	КонецПопытки;
	ГруппаСоздание.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Форма.Элементы.Добавить("КартинкаНастройкиКонвртацииСоздать", Тип("ДекорацияФормы"), ГруппаСоздание);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка = БиблиотекаКартинок.СоздатьЭлементСписка;
	
	НовыйЭлемент = Форма.Элементы.Добавить("СоздатьНастройкуКонвертации", Тип("ДекорацияФормы"), ГруппаСоздание);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Создать настройку конвертации";
	НовыйЭлемент.Гиперссылка 				= Истина;
	НовыйЭлемент.ЦветТекста 				= ЦветаСтиля.ЦветТекстаФормы;
	НовыйЭлемент.АвтоМаксимальнаяШирина 	= Ложь;
	НовыйЭлемент.РастягиватьПоГоризонтали 	= Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "СоздатьНастройкуКонвертации");
	
	// Элемент выбора для заполнения эелемента учетной системы для нового элемента справочника
	СвойстваКоманды = Новый Структура;
	СвойстваКоманды.Вставить("Подсказка", "Заполнить текущий элемент данными выбранного значения учетной системы");
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьКоманду(
		Форма, "ВыборЭлементаУчетнойСистемы",, "ВыбратьЭлементУчетнойСистемы", СвойстваКоманды);
	
	СвойстваКнопки = Новый Структура;
	СвойстваКнопки.Вставить("ЦветТекста", ЦветаСтиля.ЦветТекстаФормы);
	ВидКнопкиОбычная = 1;
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(
		Форма, "КнопкаВыбораЭлементаУчетнойСистемы", Форма.Элементы.ФормаКоманднаяПанель, "Заполнить из",
		"ВыборЭлементаУчетнойСистемы", ВидКнопкиОбычная, СвойстваКнопки);
	
КонецПроцедуры

Процедура ЗаполнитьСписокНастроекКонвертации(СписокНастроекКонвертации, ИмяСправочника) Экспорт 
	
	СписокНастроекКонвертации.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиКонвертацииСправочников.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК НастройкиКонвертацииСправочников
	|ГДЕ
	|	НастройкиКонвертацииСправочников.ТипСправочникаЛогистика = &ТипСправочникаЛогистика
	|	И НастройкиКонвертацииСправочников.ТипСправочникаИлиДокументаУС <> ""Строка""
	|	И НЕ НастройкиКонвертацииСправочников.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТипСправочникаЛогистика", ИмяСправочника);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокНастроекКонвертации.Добавить(Выборка.Ссылка);	
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура УправлениеВидимостьюЭлементовФормы(Форма) Экспорт
	
	ЭтоНовый = Не ЗначениеЗаполнено(Форма.Объект.Ссылка);
	
	Элементы = Форма.Элементы;
	
	СписокНастроекКонвертации = Форма.СписокНастроекКонвертации;
	
	Элементы.ПерейтиКНастройкеКонвертацииСправочника.Видимость 	= Ложь;
	Элементы.НастройкаКонвертацииСправочника.Видимость 			= Ложь;
	Элементы.КартинкаНастройкиКонвртацииСоздать.Видимость 		= Ложь;
	Элементы.СоздатьНастройкуКонвертации.Видимость 				= Ложь;
	Элементы.КнопкаВыбораЭлементаУчетнойСистемы.Видимость 		= Ложь;
	
	Если ЭтоНовый И СписокНастроекКонвертации.Количество() <> 0
		И ТипЗнч(Форма.Объект.Ссылка) <> Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок")
		И ТипЗнч(Форма.Объект.Ссылка) <> Тип("СправочникСсылка.КонтурЛогистика_ПодразделенияДиадок") Тогда
		
		Элементы.КнопкаВыбораЭлементаУчетнойСистемы.Видимость = Истина;
		Элементы.КнопкаВыбораЭлементаУчетнойСистемы.Заголовок =
			"Заполнить из " + Строка(Форма.СписокНастроекКонвертации[0].Значение.ТипСправочникаИлиДокументаУС);
		
	ИначеЕсли Форма.СписокНастроекКонвертации.Количество() > 1 Тогда
		
		Элементы.ПерейтиКНастройкеКонвертацииСправочника.Видимость = Истина;
		Элементы.ПерейтиКНастройкеКонвертацииСправочника.Заголовок =
			"Найдено " + СписокНастроекКонвертации.Количество() + " настройки конвертации. Нажмите для перехода к нужной";
		
	ИначеЕсли СписокНастроекКонвертации.Количество() = 1 Тогда
		
		Элементы.НастройкаКонвертацииСправочника.Видимость = Истина;
		
		Форма.НастройкаКонвертацииСправочника = Форма.СписокНастроекКонвертации[0].Значение;
		
	Иначе
		
		Элементы.КартинкаНастройкиКонвртацииСоздать.Видимость 	= Истина;
		Элементы.СоздатьНастройкуКонвертации.Видимость 			= Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НаНоменклатуруУжеЕстьКакоеЛибоБазовоеСоответствие(текНоменклатура) Экспорт

	ВыборкаПоНоменклатуре = РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Выбрать(Новый Структура("Номенклатура",
																													 текНоменклатура));
	Если ВыборкаПоНоменклатуре.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция КоличествоСоответствийНоменклатуры(СтруктураЗаписиОтбора) Экспорт

	Возврат РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.КоличествоСоответствийНоменклатуры(СтруктураЗаписиОтбора);

КонецФункции

Функция КлючПервогоСоответствияНоменклатуры(СтруктураЗаписиОтбора) Экспорт

	Возврат РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.КлючПервогоСоответствияНоменклатуры(СтруктураЗаписиОтбора);

КонецФункции
