Функция ОбъектМетаданныхПоСпособуКонвертации(СпособКонвертацииЗначения)

	ОбъектМетаданных = Неопределено;
	
	Если СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок Тогда 
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_ОрганизацииДиадок;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_Договоры;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПодразделениеДиадок Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_ПодразделенияДиадок;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_ПунктыМаршрута;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_Сотрудники;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_ТранспортныеСредства;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВЛицензию Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_Лицензии;
		
	ИначеЕсли СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВГорючеСмазочныйМатериал Тогда
		
		ОбъектМетаданных = Метаданные.Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы;
		
	КонецЕсли;
	
	Возврат ОбъектМетаданных;
	
КонецФункции

функция ВычисленноеЗначениеСсылка(ВычисленноеЗначение)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТипЗнч(ВычисленноеЗначение));
	
КонецФункции	

Процедура ДобавитьВычисленноеЗначениеВСвязныеОбъектыЛогистики(СсылкаИлиОбъектЛогистики, ВычисленноеЗначение, ЭтоСсылкаЛогистики = Ложь) Экспорт
	
	ОбъектЛогистики = ?(ЭтоСсылкаЛогистики, СсылкаИлиОбъектЛогистики.ПолучитьОбъект(), СсылкаИлиОбъектЛогистики);
	
	НоваяСтрока = ОбъектЛогистики.СвязанныеОбъекты.Добавить();
	НоваяСтрока.СвязанныйОбъект = ВычисленноеЗначение;
	
	ОбъектМетаданныхВычисленноеЗначение = Метаданные.НайтиПоТипу(ТипЗнч(ВычисленноеЗначение));
	Если ОбъектМетаданныхВычисленноеЗначение <> Неопределено
		И (Метаданные.Справочники.Содержит(ОбъектМетаданныхВычисленноеЗначение)
		Или Метаданные.Документы.Содержит(ОбъектМетаданныхВычисленноеЗначение))
		И Не ОбъектЛогистики.МетаДанные().ТабличныеЧасти.СвязанныеОбъекты.Реквизиты.СвязанныйОбъект.Тип.СодержитТип(ТипЗнч(ВычисленноеЗначение)) Тогда 
		
		НоваяСтрока.УИД = ВычисленноеЗначение.УникальныйИдентификатор();		
		НоваяСтрока.ТипЗначенияУИД = ОбъектМетаданныхВычисленноеЗначение.ПолноеИмя();
		
	КонецЕсли;
	
	ОбъектЛогистики.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляНетиповогоСправочникаВСвязанныхОбъектах(ДанныеДляЗаполнения, СсылкаЛогистика) Экспорт
	
	ДанныеДляЗаполнения.УИД = СсылкаЛогистика.УникальныйИдентификатор();		
	ДанныеДляЗаполнения.ТипЗначенияУИД = СсылкаЛогистика.МетаДанные().ПолноеИмя();
	
КонецПроцедуры

