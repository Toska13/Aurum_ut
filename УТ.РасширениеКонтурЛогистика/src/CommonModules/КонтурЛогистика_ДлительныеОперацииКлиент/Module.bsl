Функция ПараметрыЗапускаФоновогоЗаданияВФормеФоновогоЗадания() Экспорт

	ПараметрыФормы = Новый Структура;                                      // Пример
	
	ПараметрыФормы.Вставить("ИдентификаторФоновогоЗадания", "");			// если передать то форма будет только следить за этим ФЗ
	ПараметрыФормы.Вставить("ЗапуститьМетод", "");						// "КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТестоваяДлительнаяОперация");
	ПараметрыФормы.Вставить("КлючФоновогоЗадания", ""); 				// "Тест1");
	ПараметрыФормы.Вставить("ПараметрыЗапускаемогоМетода" , Неопределено);
	ПараметрыФормы.Вставить("ПредставлениеЗадачи" , "");				// "Обновление чего-то");
	ПараметрыФормы.Вставить("ЗакрытьПриУспешномВыполнении" , Ложь);
	ПараметрыФормы.Вставить("ОтображатьПрогресс" , Ложь);

	Возврат ПараметрыФормы;
	
КонецФункции

