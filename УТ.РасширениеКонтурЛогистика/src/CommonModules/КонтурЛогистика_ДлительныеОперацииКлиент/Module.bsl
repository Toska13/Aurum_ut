// Открывает форму слежения за фоновым заданием
Процедура ЗапуститьФоновоеВыполнениеСотслеживаниемВНовойФорме(ЗапускаемыйМетодФоновогоЗадания,
														КлючФоновогоЗадания,
														ПараметрыЗапускаемогоМетода = Неопределено,
														ПредставлениеЗадачи = "Фоновая задача",
														ЗакрытьПриУспешномВыполнении = Истина,
														ОтображатьПрогресс = Ложь,
														Режим = Неопределено) Экспорт
	
														
	Если Режим = Неопределено Тогда 
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;
														
	ПараметрыЗапускаФоновогоЗадания = КонтурЛогистика_ДлительныеОперацииКлиент.ПараметрыЗапускаФоновогоЗаданияВФормеФоновогоЗадания();
	
	ПараметрыЗапускаФоновогоЗадания.ЗапуститьМетод 					= ЗапускаемыйМетодФоновогоЗадания;
	ПараметрыЗапускаФоновогоЗадания.КлючФоновогоЗадания 			= КлючФоновогоЗадания;
	ПараметрыЗапускаФоновогоЗадания.ПараметрыЗапускаемогоМетода 	= ПараметрыЗапускаемогоМетода;
	ПараметрыЗапускаФоновогоЗадания.ПредставлениеЗадачи 			= ПредставлениеЗадачи;
	ПараметрыЗапускаФоновогоЗадания.ЗакрытьПриУспешномВыполнении 	= ЗакрытьПриУспешномВыполнении;
	ПараметрыЗапускаФоновогоЗадания.ОтображатьПрогресс 				= ОтображатьПрогресс;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФоновоеЗадание",
		ПараметрыЗапускаФоновогоЗадания,
		,
		,
		,
		, Режим);
	
КонецПроцедуры

