////////////////////////////////////////////////////////////////////////////////
// Предоставляет серверные методы для работы с функциональными опциями,
// включая получение значений по ключам, приведение типов и сбор кастомных метрик.
//  
////////////////////////////////////////////////////////////////////////////////
	
#Область ПрограммныйИнтерфейс

// Возвращает полный набор функциональных опций.
//
// Возвращаемое значение:
//   Соответствие из см. КонтурЛогистика_ОбновлениеСервер.ФункциональныеОпции
//
Функция ФункциональныеОпции() Экспорт 
	
	Возврат КонтурЛогистика_ОбновлениеСервер.ФункциональныеОпции();
	
КонецФункции

// Возвращает дату начала действия ЭПЛ 5.02, полученную из функциональной опции "DateStartEPL502".
//
// Возвращаемое значение:
//   Дата - дата, если опция задана и успешно приведена к типу "Дата";
//                         в противном случае - Неопределено.
//
Функция ДатаНачалаДействияЭПЛ502() Экспорт
	
	ОписаниеТипов = Новый ОписаниеТипов("Дата");
	
	ЗначениеОпции = ФункциональнаяОпция("DateStartEPL502", ОписаниеТипов);
	
	Возврат ЗначениеОпции;
	
КонецФункции

// Возвращает признак начала использования ЭПЛ 5.02, полученную из функциональной опции "StartUseEPL502".
//
// Возвращаемое значение:
//   Булево - если опция успешно приведена к типу "Булево" и имеет значение Истина, то включаем настройку "ИспользуетсяПутевойЛист_5_02";
//   в противном случае - Неопределено и ничего не делаем.
//
Функция ВключитьНастройкуИспользованияЭПЛ502() Экспорт
	
	ОписаниеТипов = Новый ОписаниеТипов("Булево");
	
	ЗначениеОпции = ФункциональнаяОпция("StartUseEPL502", ОписаниеТипов);
	
	Возврат ЗначениеОпции;
	
КонецФункции

// Выполняет расчёт и сбор всех кастомных метрик, определённых в функциональных опциях с префиксом "CustomMetric_".
//
// Метрики представляют собой исполняемые выражения, которые выполняются в безопасном режиме.
//
Процедура СобратьКастомныеМетрики() Экспорт
	
	ФункциональныеОпции = КонтурЛогистика_ФункциональныеОпции.ФункциональныеОпции();
	
	КоличествоСимволов = 13;
	
	Для Каждого ЭлементСоответствия Из ФункциональныеОпции Цикл 
		Если Нрег(Лев(ЭлементСоответствия.Ключ, КоличествоСимволов)) = Нрег("CustomMetric_") Тогда
			Попытка                                                                                           
				ПараметрыВыполнения = Новый Структура;
				ПараметрыВыполнения.Вставить("РезультатВычисления");
				
				КонтурЛогистика_ОбщегоНазначенияСервер.ВыполнитьВБезопасномРежиме(ЭлементСоответствия.Значение,
					ПараметрыВыполнения);
			Исключение
				КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистикаКастомнаяМетрика",
				 ИнформацияОбОшибке(), , , ЭлементСоответствия.Ключ, Ложь);

			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

// Получает значение функциональной опции по имени и приводит его к указанному типу.
//
// Параметры:
//   ИмяФункциональнойОпции - Строка - имя опции (например, "DateStartEPL502").
//   ОписаниеТипа - ОписаниеТипов - описание типа для приведения значения.
// 
// Возвращаемое значение:
//   Произвольный - Значение приведённого типа, если опция не найдена или приведение
//	 невозможно вернет неоппределено.
//
Функция ФункциональнаяОпция(ИмяФункциональнойОпции, ОписаниеТипа)
	
	ФункциональныеОпции = КонтурЛогистика_ФункциональныеОпцииПовтИсп.ФункциональныеОпции();
	Значение = ФункциональныеОпции.Получить(ИмяФункциональнойОпции);
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка 
		Результат = ОписаниеТипа.ПривестиЗначение(Значение);
	Исключение
		КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистикаФункциональнаяОпция",
		 ИнформацияОбОшибке(), , , ИмяФункциональнойОпции);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти