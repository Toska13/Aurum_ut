#Область ПрограммныйИнтерфейс

Функция СостояниеЭПД(МассивДокументовУчетнойСистемы) Экспорт
	
	Заголовок = "Перевозочные";	
	Картинка = БиблиотекаКартинок.КонтурЛогистика_Грузовик;
	Подсказка = "";
	
	ВведеноЭПД = 0;
	Незавершенных = 0;
	Завершенных = 0;
	Задач = 0;
	Вводов = 0;
	ВводовПромежуточных = 0;
	ВыполнитьОбменов = 0;
	ЕстьQR = Ложь;
	ВидимостьКоманды = Истина;
	
	Если ПодсистемаНастроена() Тогда 
		
		Если УТекПользователяЕстьПраваКПодсистеме() Тогда 
			
			ДеревоЗадач = СостояниеЭПДДерево(МассивДокументовУчетнойСистемы);
			
			Для Каждого Строка1 Из ДеревоЗадач.Строки Цикл 
				Для Каждого Строка2 Из Строка1.Строки Цикл
					
					ВыполнитьРасчетыСчетчиков(ВведеноЭПД, Вводов, ЕстьQR, Завершенных, Задач, Незавершенных, ВыполнитьОбменов, Строка2);
					
					Для Каждого СтрокаЭПД Из Строка2.Строки Цикл 
						
						ВыполнитьРасчетыСчетчиков(ВведеноЭПД, Вводов, ЕстьQR, Завершенных, Задач, Незавершенных, ВыполнитьОбменов, СтрокаЭПД);
						
					КонецЦикла;
				КонецЦикла;
				
				Если Строка1.ТребуемоеДействие = "Ввести док. основание для ЭПД"  Тогда 
					ВводовПромежуточных = ВводовПромежуточных + 1;
					Задач = Задач + 1;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ВведеноЭПД > 0 И 
				(Задач > 0 Или ВводовПромежуточных > 0 )
				Тогда
				
				Заголовок = "Перевозочные (" + ВведеноЭПД + "), задачи (" + Задач + ")";
				Если ЕстьQR Тогда 
					Картинка = БиблиотекаКартинок.КонтурЛогистика_QR16;
				Иначе
					Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеЧерный;
				КонецЕсли;
				
				Подсказка = "Есть задачи для вас";
				
			Иначе
				
				Если ВведеноЭПД > 0 Тогда // нет наших задач
					Заголовок = "Перевозочные (" + ВведеноЭПД + ")";
					Если ЕстьQR Тогда 
						Картинка = БиблиотекаКартинок.КонтурЛогистика_QR16;
						Подсказка = "Есть QR код для ГИБДД";
						
					ИначеЕсли Завершенных = ВведеноЭПД
						И Задач = 0 Тогда
						
						Картинка = БиблиотекаКартинок.КонтурЛогистика_Галочка;
						Подсказка = "Работа завершена";
						Заголовок = "Перевозочные завершены";
						
					Иначе
						Картинка = БиблиотекаКартинок.КонтурЛогистика_Водитель;
						Подсказка = "Ждем другого участника";
					КонецЕсли;
					
				ИначеЕсли Вводов > 0 Тогда // есть что оформить и нет ни одного ЭПД
					Заголовок = "Оформить перевозочные (" + Вводов + ")";
					Картинка = БиблиотекаКартинок.КонтурЛогистика_Добавить;
					Подсказка = "Начать оформление ЭПД";
					
				ИначеЕсли ВводовПромежуточных > 0 Тогда // треубется ввести промежуточные документы (Транспортная накладная на ERP)
					Заголовок = "Оформить перевозочные (" + ВводовПромежуточных + ")";
					Картинка = БиблиотекаКартинок.КонтурЛогистика_Добавить;
					Подсказка = "Требуется промежуточный документ Транспортная накладная";
					
				Иначе
					
					Заголовок = "ЭПД не требуется";
					Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктБудущий;
					ВидимостьКоманды = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ВыполнитьОбменов > 0 Тогда 
				Картинка = БиблиотекаКартинок.КонтурЛогистика_ВыполнитьОбмен;
				Подсказка = "Выполнить обмен";
			КонецЕсли;
			
		Иначе // нет прав до подсистемы
			
			ВидимостьКоманды = Истина;
			Подсказка = "Запросить права у Администратора базы данных к подсистеме";
			
		КонецЕсли;
		
	Иначе // Подсистема не настроена
		
		ТаблицаДокументовУчетнойСистемыДляЭПД = Новый ТаблицаЗначений;
		ТаблицаДокументовУчетнойСистемыДляЭПД.Колонки.Добавить("ДокументОснование");
		ТаблицаДокументовУчетнойСистемыДляЭПД.Колонки.Добавить("ДокументОснованиеЭПД");
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
		Если ТаблицаДокументовУчетнойСистемыДляЭПД.Количество() > 0 Тогда
			ВидимостьКоманды = Истина;
			Подсказка = "Настроить перевозочные документы";

		Иначе // по этому документу учетной системы не предусмотрен ввод ЭПД (втч может быть еще не успели реализовать)
			ВидимостьКоманды = Ложь;
		КонецЕсли;

	КонецЕсли;
	
	Возврат Новый Структура("ВидимостьКоманды, Заголовок, ВведеноЭПД, Незавершенных, Задач, Вводов, Картинка, Подсказка", ВидимостьКоманды, Заголовок, ВведеноЭПД, Незавершенных, Задач, Вводов, Картинка, Подсказка);
	
КонецФункции


Функция ТекущаяВерсияПодсистемыКонтурЛогистика() Экспорт

	Возврат КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();

КонецФункции

Функция ТекущаяВерсияИнтеграцииКонтурЛогистика() Экспорт

	Возврат 1;

КонецФункции

Функция ПодсистемаНастроена() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЛюбаяНастроеннаяОрга = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЛюбаяНашаОрганизация();
	ПодсистемаНастроена =  ЗначениеЗаполнено(ЛюбаяНастроеннаяОрга);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПодсистемаНастроена;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СостояниеЭПДДерево(МассивДокументовУчетнойСистемы) Экспорт

	РезультатДерево = Новый ДеревоЗначений;
	РезультатДерево.Колонки.Добавить("ДокументОснование");
	РезультатДерево.Колонки.Добавить("ДокументОснованиеЭПД");
	РезультатДерево.Колонки.Добавить("ДокументЭПД");
	РезультатДерево.Колонки.Добавить("ТипЭПД");
	РезультатДерево.Колонки.Добавить("Статус");
	РезультатДерево.Колонки.Добавить("ТребуемоеДействие");
	РезультатДерево.Колонки.Добавить("ГрузоотправительНаш");
	РезультатДерево.Колонки.Добавить("ПеревозчикНаш");
	РезультатДерево.Колонки.Добавить("ГрузополучательНаш");
	// 1. Понимаем учетные документы соответствующие переданному.

	текМассивДокументовУчетнойСистемы = КонтурЛогистика_СтдКоллекцииКлиентСервер.СвернутьМассивЛок(МассивДокументовУчетнойСистемы);
    ТаблицаДокументовУчетнойСистемыДляЭПД = НайтиСоотвУчетныеДокументы(текМассивДокументовУчетнойСистемы);

	// 2. Спрашиваем подсистему какие оформлены документы и какие у них статусы
	
	МассивДокументовУчетнойСистемыДляЭПД = КонтурЛогистика_СтдКоллекцииКлиентСервер.СвернутьМассивЛок(
												ТаблицаДокументовУчетнойСистемыДляЭПД.ВыгрузитьКолонку("ДокументОснованиеЭПД"));
	
	Если ТаблицаДокументовУчетнойСистемыДляЭПД.Количество() > 0 Тогда 
		
		Запрос = СформироватьТекстЗапросаСвязанныхЭПДпоУчДок(МассивДокументовУчетнойСистемыДляЭПД);
		РезультатЗапроса = Запрос.Выполнить();
		ОбщаяТаблица = РезультатЗапроса.Выгрузить();
		
		Для Каждого текДокОснование Из текМассивДокументовУчетнойСистемы Цикл 
			
			
			НайденныеСтрокиДокОснЭПД = ТаблицаДокументовУчетнойСистемыДляЭПД.НайтиСтроки(Новый Структура("ДокументОснование", текДокОснование));
			
			Если НайденныеСтрокиДокОснЭПД.Количество() > 0 Тогда
				
				СтрокаДокОсн = РезультатДерево.Строки.Добавить();
				СтрокаДокОсн.ДокументОснование = текДокОснование;
				
				Для Каждого НайденнаяСтрокаДокОснЭПД Из НайденныеСтрокиДокОснЭПД Цикл 
					
					ТребуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
					ТребуетсяЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
					
					Если СтрокаДокОсн.ДокументОснование = НайденнаяСтрокаДокОснЭПД.ДокументОснованиеЭПД Тогда 
						СтрокаДокОснЭПД = СтрокаДокОсн;
					Иначе
						СтрокаДокОснЭПД = СтрокаДокОсн.Строки.Добавить();
					КонецЕсли;
					СтрокаДокОснЭПД.ДокументОснованиеЭПД = НайденнаяСтрокаДокОснЭПД.ДокументОснованиеЭПД;
					
					НайденныеСтрокиЭПД = ОбщаяТаблица.НайтиСтроки(Новый Структура("ДокументОснованиеЭПД", СтрокаДокОснЭПД.ДокументОснованиеЭПД));
					Если НайденныеСтрокиЭПД.Количество() > 0 Тогда 
						
						Для Каждого НайденнаяСтрокаЭПД Из НайденныеСтрокиЭПД Цикл 
							
							СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
							СтрокаЭПД.ДокументЭПД = НайденнаяСтрокаЭПД.Ссылка;
							СтрокаЭПД.ТипЭПД = НайденнаяСтрокаЭПД.Тип;
							СтрокаЭПД.Статус = НайденнаяСтрокаЭПД.Состояние;
							СтрокаЭПД.ТребуемоеДействие = ОпределитьТребуемоеДействие(СтрокаЭПД.ДокументЭПД, НайденнаяСтрокаЭПД.Состояние, НайденнаяСтрокаЭПД);
							Если СтрокаЭПД.ТипЭПД = "Заказ (заявка)" Тогда 
								ТребуетсяЗЗ = Ложь;
							ИначеЕсли СтрокаЭПД.ТипЭПД = "Транспортная накладная" Тогда 
								ТребуетсяТРН = Ложь;
							КонецЕсли;
							
						КонецЦикла;
					КонецЕсли;
					
					Если ТребуетсяЗЗ Тогда 
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = "Заказ (заявка)";
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					Если ТребуетсяТРН Тогда 
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = "Транспортная накладная";
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				Если УчетныйДокументПодразумеваетЭПД(текДокОснование) Тогда 
					
					СтрокаДокОсн = РезультатДерево.Строки.Добавить();
					СтрокаДокОсн.ДокументОснование = текДокОснование;
					
					СтрокаДокОсн.ТребуемоеДействие = "Ввести док. основание для ЭПД";
					Если ИспользуетсяУправлениеДоставкой() Тогда 
						СтрокаДокОсн.Статус = "Управление доставкой вкл.";	
					КонецЕсли;
					
				// Иначе
				// решено не выводить такой переданный докумнет-основание в таблицу чтобы он не замусоривал список
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		//требуется ввод док уч сист - основания для ЭПД
		Для Каждого текДокОснование Из текМассивДокументовУчетнойСистемы Цикл 
			
			Если УчетныйДокументПодразумеваетЭПД(текДокОснование) Тогда 
				
				СтрокаДокОсн = РезультатДерево.Строки.Добавить();
				СтрокаДокОсн.ДокументОснование = текДокОснование;
				СтрокаДокОсн.ТребуемоеДействие = "Ввести док. основание для ЭПД";
				Если ИспользуетсяУправлениеДоставкой() Тогда 
					СтрокаДокОсн.Статус = "Управление доставкой вкл.";	
				КонецЕсли;
			Иначе
				
				// решено не выводить такой переданный докумнет-основание в таблицу чтобы он не замусоривал список
				
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Возврат РезультатДерево;
	
КонецФункции

Функция НайтиСоотвУчетныеДокументы(Знач МассивДокументовУчетнойСистемы) Экспорт
	
	ТаблицаДокументовУчетнойСистемыДляЭПД = Новый ТаблицаЗначений;
	ТаблицаДокументовУчетнойСистемыДляЭПД.Колонки.Добавить("ДокументОснование");
	ТаблицаДокументовУчетнойСистемыДляЭПД.Колонки.Добавить("ДокументОснованиеЭПД");

	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Если ИмяКонфигурации = "УФ_БП" 
		ИЛИ ИмяКонфигурации = "БП" Тогда 
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УФ_УТ" 
		ИЛИ ИмяКонфигурации = "ERP" 
		ИЛИ ИмяКонфигурации = "КА_2" Тогда
		
		Если ИспользуетсяУправлениеДоставкой() Тогда 
			
			//найти связанныеТРН
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ТранспортнаяНакладнаяДокументыОснования.Ссылка КАК ДокументОснованиеЭПД,
			|	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование КАК ДокументОснование
			|ИЗ
			|	Документ.ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
			|ГДЕ
			|	НЕ ТранспортнаяНакладнаяДокументыОснования.Ссылка.ПометкаУдаления
			|	И ТранспортнаяНакладнаяДокументыОснования.ДокументОснование В (&ДокументыОснование)";
			
			Запрос.УстановитьПараметр("ДокументыОснование", МассивДокументовУчетнойСистемы);
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Количество() > 0 Тогда  
				Пока Выборка.Следующий() Цикл
					Строка = ТаблицаДокументовУчетнойСистемыДляЭПД.Добавить();
					Строка.ДокументОснование = Выборка.ДокументОснование;
					Строка.ДокументОснованиеЭПД = Выборка.ДокументОснованиеЭПД;
				КонецЦикла;
			КонецЕсли;
		Иначе
			ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "КЛ" Тогда
		
		//найти связанныеТРН
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТранспортнаяНакладнаяДокументыОснования.Ссылка КАК ДокументОснованиеЭПД,
		               |	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование КАК ДокументОснование
		               |ИЗ
		               |	Документ.УчетнаяСистема_ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
		               |ГДЕ
		               |	НЕ ТранспортнаяНакладнаяДокументыОснования.Ссылка.ПометкаУдаления
		               |	И ТранспортнаяНакладнаяДокументыОснования.ДокументОснование В(&ДокументыОснование)";
		
		Запрос.УстановитьПараметр("ДокументыОснование", МассивДокументовУчетнойСистемы);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Количество() > 0 Тогда  
			Пока Выборка.Следующий() Цикл
				Строка = ТаблицаДокументовУчетнойСистемыДляЭПД.Добавить();
				Строка.ДокументОснование = Выборка.ДокументОснование;
				Строка.ДокументОснованиеЭПД = Выборка.ДокументОснованиеЭПД;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "УФ_УНФ" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УАТ" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УТ" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УПП" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	Иначе
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	КонецЕсли;
	
	Возврат ТаблицаДокументовУчетнойСистемыДляЭПД;
	
