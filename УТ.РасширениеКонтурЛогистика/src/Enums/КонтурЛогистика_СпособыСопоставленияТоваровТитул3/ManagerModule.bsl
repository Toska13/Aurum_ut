Функция ОчередностьПоиска(Способ) экспорт
	
	Очередность = Новый Массив;
	
	Если Способ = Номенклатура 
		ИЛИ Способ = НоменклатураМаркировка 
		ИЛИ Способ = НоменклатураМаркировкаНаименование 
		ИЛИ Способ = НоменклатураНаименование 
		ИЛИ Способ = НоменклатураНаименованиеМаркировка 
		Тогда
		
		Очередность.Добавить("Номенклатура");
		
	КонецЕсли;	
		
	Если Способ = НоменклатураНаименованиеМаркировка 
		ИЛИ Способ = НаименованиеМаркировка 
		Тогда
		
		Очередность.Добавить("Наименование");
		Очередность.Добавить("Маркировка");
		
	ИначеЕсли Способ = НоменклатураМаркировкаНаименование 
		ИЛИ Способ = МаркировкаНаименование 
		Тогда
		
		Очередность.Добавить("Маркировка");
		Очередность.Добавить("Наименование");
		
	ИначеЕсли Способ = НоменклатураНаименование 
		ИЛИ Способ = Наименование 
		Тогда
		
		Очередность.Добавить("Наименование");
		
	ИначеЕсли Способ = НоменклатураМаркировка
		ИЛИ Способ = Маркировка 
		Тогда
		
		Очередность.Добавить("Маркировка");
		
	КонецЕсли;
	
	Возврат Очередность;
	
КонецФункции