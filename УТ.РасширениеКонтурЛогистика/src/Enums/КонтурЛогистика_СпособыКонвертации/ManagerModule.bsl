Функция ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертации) Экспорт
	
	Если СпособКонвертации = КонвертироватьВОрганизациюДиадок Тогда 
		ИмяСправочника = "КонтурЛогистика_ОрганизацииДиадок";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВПунктМаршрута Тогда 
		ИмяСправочника = "КонтурЛогистика_ПунктыМаршрута";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВСотрудника Тогда 
		ИмяСправочника = "КонтурЛогистика_Сотрудники";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВТранспортноеСредство Тогда 
		ИмяСправочника = "КонтурЛогистика_ТранспортныеСредства";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВДоговор Тогда 
		ИмяСправочника = "КонтурЛогистика_Договоры";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВПодразделениеДиадок Тогда 
		ИмяСправочника = "КонтурЛогистика_ПодразделенияДиадок";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВЛицензию Тогда 
		ИмяСправочника = "КонтурЛогистика_Лицензии";
		
	ИначеЕсли СпособКонвертации = КонвертироватьВГорючеСмазочныйМатериал Тогда 
		ИмяСправочника = "КонтурЛогистика_ГорючеСмазочныеМатериалы";
		
	Иначе
		
		ИмяСправочника = "";
	КонецЕсли;
	
	Возврат ИмяСправочника;

КонецФункции

Функция СоответствиеТиповЗначениям() Экспорт
	
	Соответствие = Новый Соответствие;
	
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок"), КонвертироватьВОрганизациюДиадок);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута"), КонвертироватьВПунктМаршрута);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_Сотрудники"), КонвертироватьВСотрудника);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства"), КонвертироватьВТранспортноеСредство);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_Договоры"), КонвертироватьВДоговор);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_ПодразделенияДиадок"), КонвертироватьВПодразделениеДиадок);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_Лицензии"), КонвертироватьВЛицензию);
	Соответствие.Вставить(Тип("СправочникСсылка.КонтурЛогистика_ГорючеСмазочныеМатериалы"), КонвертироватьВГорючеСмазочныйМатериал);
	
	Возврат Соответствие;
	
КонецФункции