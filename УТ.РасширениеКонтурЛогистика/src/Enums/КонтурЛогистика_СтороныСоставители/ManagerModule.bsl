Функция МассивСоставителейЭТРН(ГлавныйДокумент, СтороныПеречислениеСсылка) Экспорт 
	
	МассивСторон = новый Массив;
	
	Если СтороныПеречислениеСсылка = ГО 
		ИЛИ СтороныПеречислениеСсылка = ГОиГП 
		ИЛИ СтороныПеречислениеСсылка = ГОиПВ 
		ИЛИ СтороныПеречислениеСсылка = ГОиПВиГП Тогда 
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Грузоотправитель) Тогда 
			МассивСторон.Добавить(ГлавныйДокумент.Грузоотправитель);
		КонецЕсли;
	
	КонецЕсли;
	
	Если СтороныПеречислениеСсылка = ПВ 
		ИЛИ СтороныПеречислениеСсылка = ГПиПВ 
		ИЛИ СтороныПеречислениеСсылка = ГОиПВ 
		ИЛИ СтороныПеречислениеСсылка = ГОиПВиГП Тогда 
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Перевозчик) Тогда 
			МассивСторон.Добавить(ГлавныйДокумент.Перевозчик);
		КонецЕсли;
	
	КонецЕсли;
	
	Если СтороныПеречислениеСсылка = ГП 
		ИЛИ СтороныПеречислениеСсылка = ГПиПВ 
		ИЛИ СтороныПеречислениеСсылка = ГОиГП 
		ИЛИ СтороныПеречислениеСсылка = ГОиПВиГП Тогда 
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Грузополучатель) Тогда 
			МассивСторон.Добавить(ГлавныйДокумент.Грузополучатель);
		КонецЕсли;
	
	КонецЕсли;
	
	Если СтороныПеречислениеСсылка = Фт 
		ИЛИ СтороныПеречислениеСсылка = ФтиФщ  Тогда 
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Фрахтователь) Тогда 
			МассивСторон.Добавить(ГлавныйДокумент.Фрахтователь);
		КонецЕсли;
	
	КонецЕсли;
	
	Если СтороныПеречислениеСсылка = Фщ 
		ИЛИ СтороныПеречислениеСсылка = ФтиФщ  Тогда 
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.Фрахтовщик) Тогда 
			МассивСторон.Добавить(ГлавныйДокумент.Фрахтовщик);
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат МассивСторон;
	
КонецФункции

Функция СоставителиИзМассиваСторон(ГлавныйДокумент, МассивСторон) Экспорт 
	
	Составитель = ПустаяСсылка();
	ДопСоставитель = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
	Составители = Новый Структура("Составитель, ДопСоставитель", Составитель, ДопСоставитель);
	
	ЭтоГО = Ложь;
	ЭтоГП = Ложь;
	ЭтоПВ = Ложь;
	
	Для Каждого Сторона Из МассивСторон Цикл 
		
		Если Сторона = ГлавныйДокумент.Грузоотправитель Тогда 
			ЭтоГО = Истина;
		ИначеЕсли Сторона = ГлавныйДокумент.Грузополучатель Тогда 
			ЭтоГП = Истина;
		ИначеЕсли Сторона = ГлавныйДокумент.Перевозчик Тогда 
			ЭтоПВ = Истина;
		ИначеЕсли Не ЗначениеЗаполнено(ДопСоставитель) Тогда 
			ДопСоставитель = Сторона;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если ЭтоГО И ЭтоГП И ЭтоПВ Тогда 
		Составитель = ГОиПВиГП;
		
	ИначеЕсли ЭтоГО И ЭтоГП Тогда
		Составитель = ГОиГП;
		
	ИначеЕсли ЭтоГО И ЭтоПВ Тогда
		Составитель = ГОиПВ;
		
	ИначеЕсли ЭтоГП И ЭтоПВ Тогда	
	 	Составитель = ГПиПВ;
		
	ИначеЕсли ЭтоГО Тогда 
		Составитель = ГО;
		
	ИначеЕсли ЭтоПВ Тогда 
		Составитель = ПВ;
		
	ИначеЕсли ЭтоГП Тогда 
		Составитель = ГП;
				
	КонецЕсли;	
	
	Составители.Составитель 	= Составитель;
	Составители.ДопСоставитель 	= ДопСоставитель;
	
	Возврат Составители;
	
КонецФункции	
