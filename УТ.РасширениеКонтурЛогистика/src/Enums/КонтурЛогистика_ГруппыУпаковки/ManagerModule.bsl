Функция ЗначениеДляXDTO(Ссылка) Экспорт
	
	Если Ссылка = Отсутствует Тогда
		Результат = "-";
	ИначеЕсли Ссылка = Группа1 Тогда
		Результат = "1";
	ИначеЕсли Ссылка = Группа2 Тогда
		Результат = "2";
	ИначеЕсли Ссылка = Группа3 Тогда
		Результат = "3";
	Иначе
		ВызватьИсключение "Для заполнения в xml передано неверное значение группы упаковки: " + Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеИзXDTO(ЗначениеИзXDTO) Экспорт
	
	Результат = ПустаяСсылка();
	
	Если Результат = "-" Тогда
		Результат = Отсутствует;
	ИначеЕсли ЗначениеИзXDTO = "1" Тогда
		Результат = Группа1;
	ИначеЕсли ЗначениеИзXDTO = "2" Тогда
		Результат = Группа2;
	ИначеЕсли ЗначениеИзXDTO = "3" Тогда
		Результат = Группа3;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
