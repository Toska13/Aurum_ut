Функция ЗначениеДляXDTO(Ссылка) Экспорт
	
	Если Ссылка= КП Тогда 
		Результат = "КП";
	ИначеЕсли Ссылка= СН Тогда 
		Результат = "СН";
	ИначеЕсли Ссылка= СТ Тогда 
		Результат = "СТ";
	Иначе
		
		ВызватьИсключение "Для заполнения в xml передано неверное значение Вида перевозки: " + Ссылка;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеИзXDTO(Строка) Экспорт
	
	Если Строка= "КП" Тогда 
		Результат = КП;
	ИначеЕсли Строка= "СН" Тогда 
		Результат = СН;
	ИначеЕсли Строка= "СТ" Тогда 
		Результат = СТ;
	Иначе
		
		Результат = ПустаяСсылка();
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

