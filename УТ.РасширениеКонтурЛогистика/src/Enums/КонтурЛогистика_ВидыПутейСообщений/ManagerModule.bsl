Функция ЗначениеДляXDTO(Ссылка) Экспорт
	
	Если Ссылка= Г Тогда 
		Результат = "Г";
	ИначеЕсли Ссылка= П Тогда 
		Результат = "П";
	ИначеЕсли Ссылка= М Тогда 
		Результат = "М";
	Иначе
		
		ВызватьИсключение "Для заполнения в xml передано неверное значение Вида путей сообщения: " + Ссылка;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеИзXDTO(Строка) Экспорт
	
	Если Строка= "Г" Тогда 
		Результат = Г;
	ИначеЕсли Строка= "П" Тогда 
		Результат = П;
	ИначеЕсли Строка= "М" Тогда 
		Результат = М;
	Иначе
		
		Результат = ПустаяСсылка();
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

