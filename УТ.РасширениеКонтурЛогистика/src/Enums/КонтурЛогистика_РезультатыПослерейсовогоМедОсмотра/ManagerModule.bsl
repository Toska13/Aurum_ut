#Область СлужебныйПрограммныйИнтерфейс

Функция ЗначениеДляXDTO(Значение) Экспорт
	
	Если Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._1 Тогда
		
		Результат = "1";
		
	ИначеЕсли Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._2 Тогда
		
		Результат = "2";
		
	ИначеЕсли Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._3 Тогда
		
		Результат = "3";
		
	ИначеЕсли Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._4 Тогда
		
		Результат = "4";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеИзXDTO(Значение) Экспорт
	
	Если Значение = "1" Тогда 
		
		Результат = _1;
		
	ИначеЕсли Значение = "2" Тогда 
		
		Результат = _2;
		
	ИначеЕсли Значение = "3" Тогда 
		
		Результат = _3;
		
	ИначеЕсли Значение = "4" Тогда 
		
		Результат = _4;
		
	Иначе		
		
		Результат = ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстДляПричиныОтказа(Значение) Экспорт
	
	Если Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._2 Тогда
		
		Результат = "выявлены признаки воздействия вредных и (или) опасных производственных факторов рабочей среды и трудового процесса на состояние здоровья работника";
		
	ИначеЕсли Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._3 Тогда
		
		Результат = "выявлены признаки острого профессионального заболевания или отравления";
		
	ИначеЕсли Значение = Перечисления.КонтурЛогистика_РезультатыПослерейсовогоМедОсмотра._4 Тогда
		
		Результат = "выявлены признаки алкогольного, наркотического или иного токсического опьянения";
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

