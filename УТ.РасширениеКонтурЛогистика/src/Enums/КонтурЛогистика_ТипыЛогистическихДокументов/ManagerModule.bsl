Функция ЛогистическийТипПоТипуДокумента(ТипДокумента) Экспорт
	
	// ЭТрН
	Если ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		Возврат ТрН_Титул1;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда
		Возврат ТрН_Титул2;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
		Возврат ТрН_Титул3;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4") Тогда
		Возврат ТрН_Титул4;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5") Тогда
		Возврат ТрН_Титул5;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6") Тогда
		Возврат ТрН_Титул6;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7") Тогда
		Возврат ТрН_Титул7;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8") Тогда
		Возврат ТрН_Титул8;
	
	// ПЛ
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		Возврат ПЛ_Титул1;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2") Тогда
		Возврат ПЛ_Титул2;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3") Тогда
		Возврат ПЛ_Титул3;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4") Тогда
		Возврат ПЛ_Титул4;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5") Тогда
		Возврат ПЛ_Титул5;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6") Тогда
		Возврат ПЛ_Титул6;
	
	// ЗЗ
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		Возврат ЗЗ_Титул1;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
		Возврат ЗЗ_Титул2;
	
	// ЗН
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул1") Тогда
		Возврат ЗН_Титул1;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул2") Тогда
		Возврат ЗН_Титул2;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул3") Тогда
		Возврат ЗН_Титул3;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул4") Тогда
		Возврат ЗН_Титул4;
	
	// ДФ
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1") Тогда
		Возврат ДФ_Титул1;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул2") Тогда
		Возврат ДФ_Титул2;
	
	// ЭР
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
		Возврат ЭкспедиторскаяРасписка;
		
	// ПЛ 5.02
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		Возврат ПЛ_Титул1_5_02;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2_5_02") Тогда
		Возврат ПЛ_Титул2_5_02;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02") Тогда
		Возврат ПЛ_Титул3_5_02;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4_5_02") Тогда
		Возврат ПЛ_Титул4_5_02;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5_5_02") Тогда
		Возврат ПЛ_Титул5_5_02;
	КонецЕсли;
	
КонецФункции