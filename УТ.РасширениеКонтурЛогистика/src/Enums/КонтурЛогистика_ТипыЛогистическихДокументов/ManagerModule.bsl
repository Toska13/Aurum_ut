	Иначе
		Имя = ""
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

// Умеет как по ИдФайл так и по FileName (с расширением xml)
Функция ОпределитьТипДокументаПоFileName(FileName, ТипИсходногоДокумента = Неопределено, ВерсияДокумента = Неопределено) Экспорт 
	
	// Обязательные ТрН
	Если Лев(СокрЛП(FileName), 13) = "ON_TRNACLGROT" Тогда
		Возврат ТрН_Титул1;
	ИначеЕсли Лев(СокрЛП(FileName), 14) = "ON_TRNACLPPRIN" Тогда
		Возврат ТрН_Титул2;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_TRNACLGRPO" Тогда
		Возврат ТрН_Титул3;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_TRNACLPVYN" Тогда
		Возврат ТрН_Титул4;
	
	// Необязательные ТрН
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_TRNPUDPER" Тогда // Фиксация стоимости ПВ
		Возврат ТрН_Титул5;
	ИначеЕсли Лев(СокрЛП(FileName), 11) = "ON_TRNPUDGO" Тогда // Фиксация стоимости ГО
		Возврат ТрН_Титул6;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_TRNPEREADR" Тогда // Переадресация
		Возврат ТрН_Титул7;
	ИначеЕсли Лев(СокрЛП(FileName), 11) = "ON_TRNZAMEN" Тогда // Эстафета (О смене водителя или транспортного средства)
		Возврат ТрН_Титул8;
	
	// Обязательные ЗН
	ИначеЕсли Лев(СокрЛП(FileName), 14) = "ON_ZAKAZNARPOD" Тогда // Подача ТС
		Возврат ЗН_Титул3;
	ИначеЕсли Лев(СокрЛП(FileName), 14) = "ON_ZAKAZNARSOG" Тогда // Согласование заявки
		Возврат ЗН_Титул2;
	ИначеЕсли Лев(СокрЛП(FileName), 14) = "ON_ZAKAZNARVOZ" Тогда // Возврат ТС
		Возврат ЗН_Титул4;
	ИначеЕсли Лев(СокрЛП(FileName), 11) = "ON_ZAKAZNAR" Тогда // Заявка
		Возврат ЗН_Титул1;
	
	// Уведомление об отказе в подписи Т1 и Т5
	ИначеЕсли Лев(СокрЛП(FileName), 10) = "DP_UVUTOCH" Тогда
		
		Если ТипИсходногоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			Возврат ТрН_Титул2;
		ИначеЕсли ТипИсходногоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
			Возврат ТрН_Титул6;
		ИначеЕсли ТипИсходногоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			Возврат ПЛ_Титул2;
		Иначе
			Возврат ПустаяСсылка();
		КонецЕсли;
	
	// СВ
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_SOPVEDPER1" Тогда
		Возврат СВ_Титул1;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_SOPVEDPER2" Тогда
		Возврат СВ_Титул3;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_SOPVEDPER3" Тогда
		Возврат СВ_Титул5;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_SOPVEDPER5" Тогда
		Возврат СВ_Титул7;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_SOPVEDPER4" Тогда
		Возврат СВ_Титул9;
	
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_SOPVEDGO1" Тогда
		Возврат СВ_Титул2;
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_SOPVEDGO2" Тогда
		Возврат СВ_Титул4;
	
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_SOPVEDGP1" Тогда
		Возврат СВ_Титул6;
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_SOPVEDGP2" Тогда
		Возврат СВ_Титул8;
	
	// ПЛ
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_PTLSSOBTS" Тогда
		Если ЗначениеЗаполнено(ВерсияДокумента) И (ВерсияДокумента = "kl_epl_05_02_01" Или ВерсияДокумента = "5.02") Тогда
			Возврат ПЛ_Титул1_5_02;
		Иначе
			Возврат ПЛ_Титул1;
		КонецЕсли;
	ИначеЕсли Лев(СокрЛП(FileName), 11) = "ON_PTLSPRMO" Тогда
		Если ЗначениеЗаполнено(ВерсияДокумента) И (ВерсияДокумента = "kl_epl_05_02_01" Или ВерсияДокумента = "5.02") Тогда
			Возврат ПЛ_Титул2_5_02;
		Иначе
			Возврат ПЛ_Титул2;
		КонецЕсли;		
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_PTLSVIPTS" Тогда
		Если ЗначениеЗаполнено(ВерсияДокумента) И (ВерсияДокумента = "kl_epl_05_02_01" Или ВерсияДокумента = "5.02") Тогда
			Возврат ПЛ_Титул3_5_02;
		Иначе
			Возврат ПЛ_Титул3;
		КонецЕсли;		
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_PTLSODVZD" Тогда
		Возврат ПЛ_Титул4;
	ИначеЕсли Лев(СокрЛП(FileName), 13) = "ON_PTLSODPARK" Тогда
		Возврат ПЛ_Титул5;
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_PTLSPOSMO" Тогда
		Если ЗначениеЗаполнено(ВерсияДокумента) И (ВерсияДокумента = "kl_epl_05_02_01" Или ВерсияДокумента = "5.02") Тогда
			Возврат ПЛ_Титул5_5_02;
		Иначе
			Возврат ПЛ_Титул6;
		КонецЕсли;
	ИначеЕсли Лев(СокрЛП(FileName), 12) = "ON_PTLSVOZVR" Тогда
		Возврат ПЛ_Титул4_5_02;
	
	// ЗЗ
	ИначеЕсли Лев(СокрЛП(FileName), 10) = "ON_ZAKZVGO" Тогда
		Возврат ЗЗ_Титул1;
	ИначеЕсли Лев(СокрЛП(FileName), 11) = "ON_ZAKZVPER" Тогда
		Возврат ЗЗ_Титул2;
	
	// ЭР
	ИначеЕсли Лев(СокрЛП(FileName), 10) = "FWDRECEIPT" Тогда
		Возврат ЭкспедиторскаяРасписка;
	
	Иначе
		Возврат ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция НомерТитула(ТипЛогистическогоДокумента) Экспорт
	
	Если ТипЛогистическогоДокумента = ТрН_Титул1 Тогда
		Возврат "1"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул2 Тогда
		Возврат "2"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул3 Тогда
		Возврат "3"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул4 Тогда
		Возврат "4"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул5 Тогда
		Возврат "5"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул6 Тогда
		Возврат "6"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул7 Тогда
		Возврат "7"
	ИначеЕсли ТипЛогистическогоДокумента = ТрН_Титул8 Тогда
