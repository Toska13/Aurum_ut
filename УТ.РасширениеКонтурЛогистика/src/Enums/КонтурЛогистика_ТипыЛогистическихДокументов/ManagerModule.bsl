		Возврат ПЛ_Титул4;
		
	ИначеЕсли ТекущийТипДокумента = ПЛ_Титул4 Тогда
		
		Возврат ПЛ_Титул5;
		
	ИначеЕсли ТекущийТипДокумента = ПЛ_Титул5 Тогда
		
		Возврат ПЛ_Титул6;
		
