Функция МассивВсехТипов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ТипыЛогистическихДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов КАК КонтурЛогистика_ТипыЛогистическихДокументов";
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	
