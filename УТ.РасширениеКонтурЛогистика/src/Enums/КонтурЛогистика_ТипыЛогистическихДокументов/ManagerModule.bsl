		Возврат СВ_Титул8;
		
	ИначеЕсли ТекущийТипДокумента = СВ_Титул8 Тогда
		
		Возврат СВ_Титул9;
		
	ИначеЕсли ТекущийТипДокумента = СВ_Титул9 Тогда
		
