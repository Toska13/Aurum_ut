Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СценарииАвтоматическойРаботы") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДанныеВыбора = Новый СписокЗначений;
		
		ДанныеВыбора.Добавить(ТрН_Титул1);
		ДанныеВыбора.Добавить(ТрН_Титул2);
		ДанныеВыбора.Добавить(ТрН_Титул3);
		ДанныеВыбора.Добавить(ТрН_Титул4);
		ДанныеВыбора.Добавить(ТрН_Титул5);
		ДанныеВыбора.Добавить(ТрН_Титул6);
		ДанныеВыбора.Добавить(ТрН_Титул7);
		ДанныеВыбора.Добавить(ТрН_Титул8);
		
		ДанныеВыбора.Добавить(ЗЗ_Титул1);
		ДанныеВыбора.Добавить(ЗЗ_Титул2);
		
		ДанныеВыбора.Добавить(ПЛ_Титул1);
		ДанныеВыбора.Добавить(ПЛ_Титул2);
		ДанныеВыбора.Добавить(ПЛ_Титул3);
		ДанныеВыбора.Добавить(ПЛ_Титул4);
		ДанныеВыбора.Добавить(ПЛ_Титул5);
		ДанныеВыбора.Добавить(ПЛ_Титул6);
		
		ДанныеВыбора.Добавить(ПЛ_Титул1_5_02);
		ДанныеВыбора.Добавить(ПЛ_Титул2_5_02);
		ДанныеВыбора.Добавить(ПЛ_Титул3_5_02);
		ДанныеВыбора.Добавить(ПЛ_Титул4_5_02);
		ДанныеВыбора.Добавить(ПЛ_Титул5_5_02);
		
		ДанныеВыбора.Добавить(ЭкспедиторскаяРасписка);
		
	КонецЕсли;
	
