		Имя = "ТРН";
	ИначеЕсли ЭтоЗН(Ссылка) Тогда
		Имя = "ЗН"
	ИначеЕсли ЭтоСВ(Ссылка) Тогда
		Имя = "СВ"
	ИначеЕсли ЭтоЗЗ(Ссылка) Тогда
		Имя = "ЗЗ"
	ИначеЕсли ЭтоДФ(Ссылка) Тогда
		Имя = "ДФ"
	ИначеЕсли ЭтоПЛ(Ссылка) Тогда
		Имя = "ПЛ"
	ИначеЕсли ЭтоЭР(Ссылка) Тогда
