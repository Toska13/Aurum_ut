//&НаКлиенте
Функция РассчитатьХэш_Native(ДвоичныеДанныеИмяФайла, НаименованиеХешФункции)
	
	Результат = 0;
	
	ТипХешФункции		 = ТипХешФункцииПоНаименованию(НаименованиеХешФункции);
	ХешированиеДанных	 = НовоеХешированиеДанных(ТипХешФункции);
	
	Если ТипЗнч(ДвоичныеДанныеИмяФайла) = Тип("ДвоичныеДанные") Тогда
		
		ХешированиеДанных.Добавить(ДвоичныеДанныеИмяФайла);
		
	Иначе
		
		ХешированиеДанных.ДобавитьФайл(ДвоичныеДанныеИмяФайла);
		
	КонецЕсли;
	
	ХешСумма = ХешированиеДанных.ХешСумма;
	
	Если ТипЗнч(ХешСумма) = Тип("ДвоичныеДанные") Тогда
		
		ХешСумма = HexСтрокаИзДвоичныхДанных(Результат);
		
	КонецЕсли;
	
	Результат = ВРег(ХешСумма);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция НовоеХешированиеДанных(ТипХешФункции)
	
	ПараметрыКонструктора = Новый Массив(1);
	ПараметрыКонструктора.Установить(0, ТипХешФункции);
	
	Результат = Новый ("ХешированиеДанных", ПараметрыКонструктора);
	
	Возврат Результат;
	
КонецФункции

Функция ТипХешФункцииПоНаименованию(НаименованиеХешФункции)
	
	ТипыХешФункции = Новый Соответствие;
	ТипыХешФункции.Вставить("CRC32"	, "ХешФункция.CRC32");
	ТипыХешФункции.Вставить("MD5"	, "ХешФункция.MD5");
	ТипыХешФункции.Вставить("SHA1"	, "ХешФункция.SHA1");
	ТипыХешФункции.Вставить("SHA256", "ХешФункция.SHA256");
	
	ТипХешФункцииСтрокой = ТипыХешФункции.Получить(НаименованиеХешФункции);
	
	Результат = Вычислить(ТипХешФункцииСтрокой);
	
	Возврат Результат;
	
КонецФункции

