	Таймаут 			 = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ТаймаутHTTP");
	ЗащищенноеСоединение = ЗащищенноеСоединениеOpenSSL();
	
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(АдресВебСервиса);
	ПараметрыКонструктора.Добавить(Порт);
	ПараметрыКонструктора.Добавить(ИмяПользователя);
	ПараметрыКонструктора.Добавить(Пароль);
	ПараметрыКонструктора.Добавить(Прокси);
	ПараметрыКонструктора.Добавить(Таймаут);
	
	Если Схема = "https" Тогда
		ПараметрыКонструктора.Добавить(ЗащищенноеСоединение);
	КонецЕсли;
	
	Результат = Новый("HTTPСоединение", ПараметрыКонструктора);
	
	Возврат Результат;
	
