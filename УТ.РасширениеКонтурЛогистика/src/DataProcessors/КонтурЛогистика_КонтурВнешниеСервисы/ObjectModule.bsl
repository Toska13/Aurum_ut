//&НаКлиенте
Функция ПолучитьСписокСертификатов_Native(ПараметрыПоиска, СвойстваСертификата)
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(ПараметрыПоиска);
	
	Если ПараметрыПоиска.Свойство("Отпечаток") Тогда
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ПараметрыПоиска.Отпечаток);
		Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатКриптографии, ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	Если ПараметрыПоиска.Свойство("СерийныйНомер") Тогда
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоСерийномуНомеру(Base64Значение(ПараметрыПоиска.СерийныйНомер));
		Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатКриптографии, ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	СертификатыКриптографии = ХранилищеСертификатовКриптографии.ПолучитьВсе();
	Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатыКриптографии, ПараметрыПоиска, СвойстваСертификата);
	
КонецФункции

//&НаКлиенте
Функция ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов)
	
	Результат = Новый Массив;
	
	Для Каждого Серт Из СписокСертификатов Цикл
		
		Если Не ЭтоВалидныйСертификат(Серт) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеСертификата = Новый Структура("Наименование, ДатаВыдачи, СрокДействия, ОтпечатокСертификата, Организация, Издатель, Контур, Инн, Кпп, ВДиадоке, Ошибка");
		
		ОписаниеСертификата.ДатаВыдачи			 = Серт.ДатаНачала;
		ОписаниеСертификата.СрокДействия		 = Серт.ДатаОкончания;
		ОписаниеСертификата.ОтпечатокСертификата = Серт.Отпечаток;
		
		Если Серт.Субъект.Свойство("SN") И Серт.Субъект.Свойство("G") Тогда // в старых форматах сертификатов этих полей может не быть
			ОписаниеСертификата.Наименование = Серт.Субъект.SN + " " + Серт.Субъект.G;
		Иначе
			ОписаниеСертификата.Наименование = Серт.Субъект.CN;
		КонецЕсли;
		
		ОписаниеСертификата.Издатель	 = Серт.Издатель.CN;
		ОписаниеСертификата.Организация	 = ?(Серт.Субъект.Свойство("O"), Серт.Субъект.O, "");
		
		Если Серт.Субъект.Свойство("ИННЮЛ") Тогда
			ИНН = Серт.Субъект.ИННЮЛ;
		ИначеЕсли Серт.Субъект.Свойство("ИНН") Тогда
			ИНН = Серт.Субъект.ИНН;
		Иначе
			ИНН = "";
		КонецЕсли;
		
		// обрезаем лидирующие нули
		Если Лев(ИНН, 2) = "00" Тогда 
			ИНН = Сред(ИНН, 3);
		КонецЕсли;
		
		ОписаниеСертификата.ИНН = ИНН;
		
		// здесь КПП так просто не вытащить, он вроде присутствует в хитром поле:
		// _1_2_840_113549_1_9_2	"6699000000-669901001-012522310804"	Строка
		// _1_2_840_113549_1_9_2	"6699000000-669901001-005809723989"	Строка
		
		// еще один вариант - раскладывать в массив строк и брать вторую
		
		Если Серт.Субъект.Свойство("СНИЛС") Тогда
			СНИЛС = Серт.Субъект.СНИЛС;
		Иначе
			СНИЛС = "";
		КонецЕсли;
		
		Для Каждого ЭлементСтруктуры Из Серт.Субъект Цикл
			
			Если Найти(ЭлементСтруктуры.Значение, "-0" + СНИЛС) > 0
				И СтрДлина(ЭлементСтруктуры.Значение) >= 10 + 1 + 9 + 1 + СтрДлина(СНИЛС) + 1 Тогда
				// 6699000000-669901001-005809723989
				// 10        1    9    1   СНИЛС+"0"
				КПП = ЭлементСтруктуры.Значение;
				
				КПП = Сред(КПП, 12);							// 6699000000-669901001-005809723989  -> 669901001-005809723989
				КПП = СтрЗаменить(КПП, "0" + СНИЛС, "");	// 669901001-005809723989  -> -005809723989
				КПП = СтрЗаменить(КПП, "-", "");				// -005809723989 -> 005809723989
				Если СтрДлина(КПП) = 9 Тогда
					ОписаниеСертификата.КПП = КПП;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ОписаниеСертификата.КПП) Тогда
				ЭлементыКПП = РазделитьСтроку(ЭлементСтруктуры.Значение, "-");
				Если ЭлементыКПП.Количество() > 1 Тогда
					ОписаниеСертификата.КПП = ЭлементыКПП[1];
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ОписаниеСертификата.Контур = Истина;
		
		Если ОписаниеСертификата.СрокДействия < НачалоДня(ТекущаяДата()) Тогда
			
			ОписаниеСертификата.Вставить("Ошибка"	, "Срок действия сертификата истек");
			ОписаниеСертификата.Вставить("ВДиадоке"	, Ложь);
			// кажется, что их лучше вообще не показывать
			
		Иначе
			
			ОписаниеСертификата.Вставить("ВДиадоке", Истина);
			
		КонецЕсли;
		
		Если ОписаниеСертификата.ВДиадоке Тогда
			Результат.Добавить(ОписаниеСертификата);  // добавляем только валидные сертификаты
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция РазобратьОтвет_ПолучитьСписокСертификатов(Ответ, ПараметрыПоиска, СвойстваСертификата)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Ответ) Тогда
		
		Если ТипЗнч(Ответ) = Тип("Массив") Тогда
			
			Для Каждого СертификатКриптографии Из Ответ Цикл
				
				Результат.Добавить(КонтурЛогистика_КриптографияКлиентСервер.Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата));
				
				Если СвойствоСтруктуры(ПараметрыПоиска, "ТолькоПервый") = Истина Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Результат.Добавить(КонтурЛогистика_КриптографияКлиентСервер.Новый_ОписаниеСертификата(Ответ, СвойстваСертификата));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПолучитьДанныеСертификата(ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата)
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(ПараметрыПоиска);
	
	Если ТипЗнч(ОтпечатокСертификата) = Тип("ДвоичныеДанные") Тогда
		
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ОтпечатокСертификата);
		
	Иначе
		
		СертификатыКриптографии	 = ХранилищеСертификатовКриптографии.ПолучитьВсе();
		СертификатКриптографии	 = НайтиСертификатВМассивеПоОтпечатку(СертификатыКриптографии, ОтпечатокСертификата);
		
	КонецЕсли;
	
	Результат = Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПодписатьКонтент(ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера)
	
	ТипыМодулей = ТипыМодулейКриптографии(ОтпечатокСертификата);
	
	Для Каждого ТипМодуля Из ТипыМодулей Цикл
		
		МенеджерКриптографии = ИнициализироватьМенеджерКриптографии(ПарольКонтейнера, ТипМодуля);
		
		Попытка
			Результат = ПодписатьКонтентЧерезМенеджерКриптографии(МенеджерКриптографии, ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера);
			Прервать;
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Если ТипыМодулей.Найти(ТипМодуля) = ТипыМодулей.ВГраница() Тогда
				ВызватьИсключение;
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЗапомнитьПодходящийТипМодуляКриптографии(ТипМодуля, ОтпечатокСертификата);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПодписатьКонтентЧерезМенеджерКриптографии(МенеджерКриптографии, ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера)
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата(Истина);
	
	Сертификат				 = ПолучитьДанныеСертификата(ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата);
	СертификатКриптографии	 = Новый СертификатКриптографии(Сертификат.ДвоичныеДанные);
	
	Результат = МенеджерКриптографии.Подписать(ДвоичныеДанные, СертификатКриптографии);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ЗашифроватьКонтент(ДвоичныеДанные, МассивСертификатов)
	
	СертификатыКриптографии = Новый Массив;
	
	Для Каждого ДвоичныеДанныеСертификата Из МассивСертификатов Цикл 
		СертификатыКриптографии.Добавить(Новый СертификатКриптографии(ДвоичныеДанныеСертификата));
	КонецЦикла;
	
	МенеджерКриптографии = ИнициализироватьМенеджерКриптографии();
	
	Результат = МенеджерКриптографии.Зашифровать(ДвоичныеДанные, СертификатыКриптографии);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция РасшифроватьКонтент(ЗашифрованныеДвоичныеДанные, ПарольКонтейнера)
	
	ТипыМодулей = ТипыМодулейКриптографии();
	
	Для Каждого ТипМодуля Из ТипыМодулей Цикл
		
		МенеджерКриптографии = ИнициализироватьМенеджерКриптографии(ПарольКонтейнера, ТипМодуля);
		
		Попытка
			Результат = МенеджерКриптографии.Расшифровать(ЗашифрованныеДвоичныеДанные);
			Прервать;
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Если ТипыМодулей.Найти(ТипМодуля) = ТипыМодулей.ВГраница() Тогда
				ВызватьИсключение;
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЗапомнитьПодходящийТипМодуляКриптографии(ТипМодуля);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПроверитьПодпись_Native(ДвоичныеДанные, ДвоичныеДанныеПодписи)
	
	СертификатКриптографии = Неопределено;
	
	МенеджерКриптографии = ИнициализироватьМенеджерКриптографии();
	МенеджерКриптографии.ПроверитьПодпись(ДвоичныеДанные, ДвоичныеДанныеПодписи, СертификатКриптографии);
	
	Результат = Новый_ОписаниеСертификата(СертификатКриптографии, ВсеСвойстваСертификата(Истина));
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПолучитьСертификатИзПодписи_Native(ДвоичныеДанныеПодписи)
	
	МенеджерКриптографии	 = ИнициализироватьМенеджерКриптографии();
	СертификатыКриптографии	 = МенеджерКриптографии.ПолучитьСертификатыИзПодписи(ДвоичныеДанныеПодписи);
	
	СертификатКриптографии = Неопределено;
	
	Если ЗначениеЗаполнено(СертификатыКриптографии) Тогда
		
		Если СертификатыКриптографии.Количество() = 1 Тогда
			СертификатКриптографии = СертификатыКриптографии[0];	
		Иначе
			
			Для каждого Сертификат Из СертификатыКриптографии Цикл
				
				Если Не Сертификат.Субъект.Свойство("SN") Тогда
					Продолжить;
				Иначе
					СертификатКриптографии = Сертификат;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СертификатКриптографии = Неопределено Тогда
				СертификатКриптографии = СертификатыКриптографии[0];		
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Результат = Новый_ОписаниеСертификата(СертификатКриптографии, ВсеСвойстваСертификата(Истина));
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ЭтоВалидныйСертификат(ДанныеСертификата)
	
	Результат = Ложь;
	
	Если ТипЗнч(ДанныеСертификата) = Тип("Структура")
		
		И ДанныеСертификата.Свойство("Субъект") И ТипЗнч(ДанныеСертификата.Субъект) = Тип("Структура")
		И ДанныеСертификата.Субъект.Свойство("CN")
		И (ДанныеСертификата.Субъект.Свойство("ИНН") ИЛИ ДанныеСертификата.Субъект.Свойство("ИННЮЛ"))
		
		И ДанныеСертификата.Свойство("Издатель") И ТипЗнч(ДанныеСертификата.Издатель) = Тип("Структура")
		И ДанныеСертификата.Издатель.Свойство("CN") 
		
	Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ИнициализироватьМенеджерКриптографии(ПарольКонтейнера = Неопределено, ТипМодуляКриптографии = Неопределено)
	
	Если ТипМодуляКриптографии = Неопределено Тогда
		
		ТипМодуляКриптографии = ПодходящийТипМодуляКриптографии();
		
		Если Не ЗначениеЗаполнено(ТипМодуляКриптографии) Тогда
			ТипМодуляКриптографии = ТипыМодулейКриптографии().Получить(0);
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить("");
	ПараметрыКонструктора.Добавить("");
	ПараметрыКонструктора.Добавить(ТипМодуляКриптографии);
	
	МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
	
	УстановитьПарольДоступаКЗакрытомуКлючу(МенеджерКриптографии, ПарольКонтейнера);
	
	Возврат МенеджерКриптографии;
	
КонецФункции

//&НаКлиенте
Функция НачатьИнициализациюМенеджераКриптографии(Знач ОписаниеОповещения)
	
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить("");
	ПараметрыКонструктора.Добавить("");
	ПараметрыКонструктора.Добавить(75);
	
	МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
	
	МенеджерКриптографии.НачатьИнициализацию(ОписаниеОповещения, "", "", 75);
	
КонецФункции

//&НаКлиенте
Процедура УстановитьПарольДоступаКЗакрытомуКлючу(МенеджерКриптографии, ПарольКонтейнера)
	
	Если ЗначениеЗаполнено(ПарольКонтейнера) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольКонтейнера;
	КонецЕсли;
	
КонецПроцедуры

//&НаКлиенте
Процедура ЗапомнитьПодходящийТипМодуляКриптографии(ТипМодуляКриптографии, ОтпечатокСертификата = "")
	
	ПодходящиеТипы = Кэш_Прочитать("ПодходящиеТипыМодулейКриптографии");
	
	Если ПодходящиеТипы = Неопределено Тогда
		ПодходящиеТипы = Новый Соответствие;
		Кэш_Поместить("ПодходящиеТипыМодулейКриптографии", ПодходящиеТипы);
	КонецЕсли;
	
	ПодходящиеТипы.Вставить(ОтпечатокСертификата, ТипМодуляКриптографии);
	
КонецПроцедуры

//&НаКлиенте
Функция ПодходящийТипМодуляКриптографии(ОтпечатокСертификата = "")
	
	Результат = Неопределено;
	
	ПодходящиеТипы = Кэш_Прочитать("ПодходящиеТипыМодулейКриптографии");
	
	Если ЗначениеЗаполнено(ПодходящиеТипы) Тогда
		Результат = ПодходящиеТипы[ОтпечатокСертификата];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ТипыМодулейКриптографии(ОтпечатокСертификата = "")
	
	Результат = Новый Массив;
	Результат.Добавить(80);
	Результат.Добавить(75);
	
	ПодходящийТипМодуля = ПодходящийТипМодуляКриптографии(ОтпечатокСертификата);
	
	Если ЗначениеЗаполнено(ПодходящийТипМодуля) Тогда
		
		ИндексПодходящего = Результат.Найти(ПодходящийТипМодуля);
		
		Если ИндексПодходящего > 0 Тогда
			
			// Переместим подходящий модуль в начало массива
			Результат.Удалить(ИндексПодходящего);
			Результат.Вставить(0, ПодходящийТипМодуля);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПолучитьХранилищеСертификатов(ПараметрыПоиска)
	
	МенеджерКриптографии	 = ИнициализироватьМенеджерКриптографии();
	
	ТипХранилища			 = СвойствоСтруктуры(ПараметрыПоиска, "ТипХранилища");
	РасположениеХранилища	 = СвойствоСтруктуры(ПараметрыПоиска, "РасположениеХранилища");
	
	Возврат МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилища, РасположениеХранилища);
	
КонецФункции

//&НаКлиенте
Функция Новый_ОписаниеСертификата(СертификатКриптографии, СвойстваСертификата)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Отпечаток", HexСтрокаИзДвоичныхДанных(СертификатКриптографии.Отпечаток));
	
	Если СвойстваСертификата.Свойство("СерийныйНомер") Тогда
		Результат.Вставить("СерийныйНомер", HexСтрокаИзДвоичныхДанных(СертификатКриптографии.СерийныйНомер));
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("Издатель") Тогда
		Результат.Вставить("Издатель", Новый Структура(СертификатКриптографии.Издатель));
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("Субъект") Тогда
		
		Результат.Вставить("Субъект", Новый Структура(СертификатКриптографии.Субъект));
		
		Если СертификатКриптографии.Субъект.Свойство("OGRN")Тогда
			Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OGRN);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_1") Тогда
			Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OID1_2_643_100_1);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("SNILS") Тогда
			Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.SNILS);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_3") Тогда
			Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.OID1_2_643_100_3);
		КонецЕсли;
		
		Если СертификатКриптографии.Субъект.Свойство("INN") Тогда
			Результат.Субъект.Вставить("ИНН", СертификатКриптографии.Субъект.INN);
		ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_3_131_1_1")Тогда
			Результат.Субъект.Вставить("ИНН", СертификатКриптографии.Субъект.OID1_2_643_3_131_1_1);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("ДвоичныеДанные") Тогда
		Результат.Вставить("ДвоичныеДанные", СертификатКриптографии.Выгрузить());
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("ДатаНачала") Тогда
		Результат.Вставить("ДатаНачала", СертификатКриптографии.ДатаНачала);
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("ДатаОкончания") Тогда
		Результат.Вставить("ДатаОкончания", СертификатКриптографии.ДатаОкончания);
	КонецЕсли;
	
	Если СвойстваСертификата.Свойство("РасширенныеСвойства") Тогда
		Результат.Вставить("РасширенныеСвойства", Новый Структура(СертификатКриптографии.РасширенныеСвойства));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПараметрыПоискаСертификатов()
	
	Результат = Новый Структура;
	
	Если ИспользоватьВнешнююКриптографию() Тогда
		
		Результат.Вставить("ТипХранилища",			"ПерсональныеСертификаты");
		Результат.Вставить("РасположениеХранилища",	"ДанныеПользователяОС");
		
	Иначе
		
		Результат.Вставить("ТипХранилища",			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Результат.Вставить("РасположениеХранилища",	РасположениеХранилищаСертификатовКриптографии.ДанныеПользователяОС);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Процедура ВыполнитьОбработкуОповещенияПереопределенная(ОписаниеОповещения, Результат)
	
	Если ЭтоСтруктура(ОписаниеОповещения) Тогда
		
		Если ЗначениеЗаполнено(ОписаниеОповещения.ДополнительныеПараметры) Тогда 
			Выполнить("ОписаниеОповещения.Модуль.ОписаниеОповещения.ИмяПроцедуры(Результат, ОписаниеОповещения.ДополнительныеПараметры)");
		//Иначе
		//	Выполнить("ОписаниеОповещения.Модуль.ОписаниеОповещения.ИмяПроцедуры(Результат)");
		КонецЕсли;
		
	Иначе
		Выполнить("ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат)");
	КонецЕсли;
	
КонецПроцедуры

//&НаКлиенте
Функция НайтиСертификатВМассивеПоОтпечатку(МассивСертификатов, ОтпечатокСертификата)
	
	Результат = Неопределено;
	
	Для Каждого Сертификат Из МассивСертификатов Цикл
		
		ТекущийОтпечаток = HexСтрокаИзДвоичныхДанных(Сертификат.Отпечаток);
		
		Если ВРег(ТекущийОтпечаток) = ВРег(ОтпечатокСертификата) Тогда
			
			Результат = Сертификат;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

