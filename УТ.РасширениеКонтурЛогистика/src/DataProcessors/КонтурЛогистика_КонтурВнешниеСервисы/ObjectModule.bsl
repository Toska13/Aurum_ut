// Определяет какой транспорт нужно использовать
// в зависимости от версии приложения.
//
// Возвращаемое значение:
//   Булево - Истина, если приложение старше 8.3.6.
//
//&НаКлиенте
Функция ИспользоватьВнешнийHTTP()
	
	Если НЕ ПриложениеСтаршеВерсии("8.3.6") Тогда
		
		// В версии "8.3.6" HTTPЗапрос получил необходимый нам параметр ИспользоватьBOM.
		
		Результат = Ложь;
		
	Иначе
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает объект HTTP cоединение по адресу вэб сервиса.
//
// Параметры:
//  ПараметрыСервиса - Структура - см. функцию ядра ПараметрыСервиса().
//
// Возвращаемое значение:
//   HTTPСоединение - если ИспользоватьВнешнийHTTP() = Ложь;
//   COMОбъект      - если ИспользоватьВнешнийHTTP() = Истина;
//
//&НаКлиенте
Функция HTTPСоединение(ПараметрыСервиса)
	
	Результат = Неопределено;
	
	АдресВебСервиса				 = ПараметрыСервиса.АдресВебСервиса;
	ИспользоватьНовоеСоединение	 = ПараметрыСервиса.ИспользоватьНовоеСоединение;
	
	Если ИспользоватьНовоеСоединение Тогда
		Кэш_Поместить("HTTPСоединения", Неопределено);
	КонецЕсли;
	
	HTTPСоединения = Кэш_Прочитать("HTTPСоединения");
	
	Если HTTPСоединения = Неопределено Тогда
		HTTPСоединения = Новый Соответствие;
		Кэш_Поместить("HTTPСоединения", HTTPСоединения);
	КонецЕсли;
	
	Результат = HTTPСоединения.Получить(АдресВебСервиса);
	
	Если Результат = Неопределено Тогда
		
		Если ИспользоватьВнешнийHTTP() Тогда
			
			Результат = ПолучитьCOMОбъект("", "WinHttp.WinHttpRequest.5.1");
			УстановитьПараметрыПрокси_COM(ПараметрыСервиса, Результат);
			
		Иначе
			
			Прокси		 = НовыйИнтернетПрокси(ПараметрыСервиса.НастройкиПрокси);
			Результат	 = НовоеHTTPСоединение(ПараметрыСервиса, Прокси);
		
		КонецЕсли;
		
		Если НЕ ИспользоватьНовоеСоединение Тогда
			HTTPСоединения.Вставить(АдресВебСервиса, Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Процедура ОбработатьОшибкуHTTP(ПараметрыСервиса, ПараметрыЗапроса, ТекстОшибки)
	
	Метод			 = ПараметрыЗапроса.Метод;
	АдресМетода		 = ПараметрыЗапроса.АдресМетода;
	АдресВебСервиса	 = ПараметрыСервиса.АдресВебСервиса;
	ДопИнформация	 = Новый Массив;
	
	ВидОперации = Общее_ПодставитьПараметрыВСтроку(НСтр(
	"ru = 'HTTP запрос в сервис %1'"), АдресВебСервиса);
	
	ДопИнформация.Добавить(Общее_ПодставитьПараметрыВСтроку(НСтр(
	"ru = 'Метод: %1'"), Метод));
	
	ДопИнформация.Добавить(Общее_ПодставитьПараметрыВСтроку(НСтр(
	"ru = 'Адрес метода: https:// %1%2'"), АдресВебСервиса, АдресМетода));
	
	Если ИспользоватьВнешнийHTTP() Тогда
		ДопИнформация.Добавить("Использован внешний HTTP транспорт");
	КонецЕсли;
	
	Ядро.Ошибка_Обработать(ВидОперации, ТекстОшибки, ДопИнформация);
	
КонецПроцедуры

//&НаКлиенте
Функция ВыполнитьHTTPЗапрос_Native(ПараметрыСервиса, ПараметрыЗапроса)
	
	ДопустимыеКодыОтвета		 = ПараметрыЗапроса.ДопустимыеКодыОтвета;
	ТелоОтветаКакДвоичныеДанные	 = ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные;
	
	Ответ = ОтправитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	КодОтвета			 = Ответ.КодСостояния;
	ЗаголовкиОтвета		 = Ответ.Заголовки;
	КодОтветаДопустимый	 = ДопустимыеКодыОтвета.Найти(КодОтвета) <> Неопределено;
	
	Если ТелоОтветаКакДвоичныеДанные И КодОтветаДопустимый Тогда
		ТелоОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Иначе
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодОтвета"			, КодОтвета);
	Результат.Вставить("ТелоОтвета"			, ТелоОтвета);
	Результат.Вставить("Заголовки"			, ЗаголовкиОтвета);
	Результат.Вставить("КодОтветаДопустимый", КодОтветаДопустимый);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ВыполнитьHTTPЗапрос_Plugin(ПараметрыСервиса, ПараметрыЗапроса)
	
	ДопустимыеКодыОтвета		 = ПараметрыЗапроса.ДопустимыеКодыОтвета;
	ТелоОтветаКакДвоичныеДанные	 = ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные;
	
