//{		ИНТЕРФЕЙС

Функция ТребуетсяПлагин() Экспорт
	
	Если ИспользоватьВнешнийHTTP()
		Или ИспользоватьВнешнююКриптографию() Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПараметрыHTTPЗапроса() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Метод");
	Результат.Вставить("АдресМетода");
	Результат.Вставить("ТелоЗапроса");
	Результат.Вставить("Параметры"					, Новый Структура);
	Результат.Вставить("Заголовки"					, Новый Соответствие);
	Результат.Вставить("ДопустимыеКодыОтвета"		, Новый Массив);
	Результат.Вставить("ТелоОтветаКакДвоичныеДанные", Ложь);
	
	Результат.Метод = "GET";
	
	Результат.Заголовки.Вставить("Accept"		, "application/json");
	Результат.Заголовки.Вставить("Content-Type"	, "application/json;charset=utf-8");
	Результат.Заголовки.Вставить("User-Agent"	, КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеUserAgent());
	//Результат.Заголовки.Вставить("Cache-Control", "max-age=0");
	
	Результат.ДопустимыеКодыОтвета.Добавить(200);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса) Экспорт
	
	Попытка
		
		Если ИспользоватьВнешнийHTTP() Тогда
			
			Результат = ВыполнитьHTTPЗапрос_COM(ПараметрыСервиса, ПараметрыЗапроса);
			
		Иначе
			
			Результат = ВыполнитьHTTPЗапрос_Native(ПараметрыСервиса, ПараметрыЗапроса);
			
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ОбработатьОшибкуHTTP(ПараметрыСервиса, ПараметрыЗапроса, ТекстОшибки);
		
		Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоHTTPЗапросОтправкиТитула(ПараметрыЗапроса) Тогда
			Результат = Новый Структура;
			Результат.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаСоединения);
			Результат.Вставить("ОписаниеОшибки", "Ошибка при отправке документов");
			Результат.Вставить("ПодробноеОписаниеОшибки", ТекстОшибки);
			Возврат Результат;			
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Если НЕ Результат.КодОтветаДопустимый Тогда
		
		КодОтвета = Результат.КодОтвета;
		ТелоОтвета = НРег(Результат.ТелоОтвета);
		
		Если ЭтоОшибкаАвторизации(КодОтвета, ТелоОтвета) Тогда
			
			ОчиститьКонтекстСеанса();
			
			ТекстОшибки = НСтр("ru = 'Прошло слишком много времени с последней авторизации.
					|Для продолжения работы необходимо перезапустить модуль Диадока.'");
			
		ИначеЕсли ЭтоОшибкаОрганизацияНеНайдена(КодОтвета, ТелоОтвета) Тогда

			ТекстОшибки = НСтр("ru = 'Организация не найдена в Диадоке (или найдено более 1 организации) по ИНН.
				|Убедитесь что в ИНН нет ошибки.
				|Пригласите контрагента в Диадок в веб-интерфейсе.
				|
				| (" + ТелоОтвета + ")'");

		Иначе
			
			СтрокаОшибки = НСтр(
					"ru = 'Ошибка HTTP запроса
					|Код ошибки: %1
					|%2'");
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(СтрокаОшибки, Результат.КодОтвета, Результат.ТелоОтвета);
			
		КонецЕсли;
		
		ОбработатьОшибкуHTTP(ПараметрыСервиса, ПараметрыЗапроса, ТекстОшибки);
		
		Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоHTTPЗапросОтправкиТитула(ПараметрыЗапроса) Тогда
			Результат.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаСервиса);
			Результат.Вставить("ОписаниеОшибки", "Ошибка при отправке документов");
			Результат.Вставить("ПодробноеОписаниеОшибки", ТекстОшибки);
			Возврат Результат;			
		КонецЕсли;
		
		ВызватьИсключение ТекстОшибки;
				
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удаление токена из контекста сеанса.
//
// Параметры:
//  Токен - Строка - Токен, по которому нужно очистить контекст сеанса.
//
Процедура ОчиститьКонтекстСеанса()
	
	Ядро.ОчиститьКонтекстИКэшСеанса();
	
КонецПроцедуры

// Проверяет ответ HTTP-запроса на предмет наличия ошибки авторизации по токену.
//
// Параметры:
//  КодОтвета  - Число - Код ответа HTTP-сервиса.
//  ТелоОтвета - Строка - Текстовый ответ HTTP-сервиса.
//
// Возвращаемое значение:
//   Булево - Результат проверки ошибки авторизации.
//     * Истина - Произошла ошибка авторизации.
//     * Ложь   - Авторизация прошла учпешно.
//
Функция ЭтоОшибкаАвторизации(КодОтвета, ТелоОтвета)
	
	Результат = КодОтвета = 401
				И ТелоОтвета = "invalid auth token";
									
	Возврат Результат

КонецФункции

Функция ЭтоОшибкаОрганизацияНеНайдена(КодОтвета, ТелоОтвета)
	
	Результат = КодОтвета = 404
				И Найти(ТелоОтвета, "no organization found") <> 0;
									
	Возврат Результат

КонецФункции

//&НаКлиенте
Функция ПолучитьСписокЛокальныхСертификатов() Экспорт
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата();
	
	Если ИспользоватьВнешнююКриптографию() Тогда
		ПараметрыПоиска.Вставить("ЕстьЗакрытыйКлюч", Истина);
		СписокСертификатов = Плагин_ПолучитьСписокСертификатов(ПараметрыПоиска, СвойстваСертификата);
	Иначе
		СписокСертификатов = ПолучитьСписокСертификатов_Native(ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	Результат = КонтурЛогистика_КриптографияКлиентСервер.ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПолучитьСертификат(ОтпечатокСертификата) Экспорт
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата(Истина);
	
	Если ИспользоватьВнешнююКриптографию() Тогда
		ПараметрыПоиска.Вставить("Отпечаток", ОтпечатокСертификата);
		Результат = Плагин_ПолучитьДанныеСертификата(ПараметрыПоиска, СвойстваСертификата);
	Иначе
		Результат = ПолучитьДанныеСертификата(ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	Возврат Результат;
	
