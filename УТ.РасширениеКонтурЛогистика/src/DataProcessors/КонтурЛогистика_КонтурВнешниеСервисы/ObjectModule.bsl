	КодОтветаДопустимый	 = ДопустимыеКодыОтвета.Найти(КодОтвета) <> Неопределено;
	
	Если ТелоОтветаКакДвоичныеДанные Тогда
		
		Если КодОтветаДопустимый Тогда
			ТелоОтвета = Ответ.ТелоОтвета;
		Иначе
			ТелоОтвета = Плагин_ПреобразоватьКонтент(Ответ.ТелоОтвета, Новый Структура("Строка"));
		КонецЕсли;
		
	Иначе
		
		ТелоОтвета = Ответ.ТелоОтвета;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодОтвета"			, КодОтвета);
	Результат.Вставить("ТелоОтвета"			, ТелоОтвета);
	Результат.Вставить("Заголовки"			, ЗаголовкиОтвета);
	Результат.Вставить("КодОтветаДопустимый", КодОтветаДопустимый);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ВыполнитьHTTPЗапрос_COM(ПараметрыСервиса, ПараметрыЗапроса)
	
	ДопустимыеКодыОтвета		 = ПараметрыЗапроса.ДопустимыеКодыОтвета;
	ТелоОтветаКакДвоичныеДанные	 = ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные;
	
	Соединение = ОтправитьHTTPЗапрос_COM(ПараметрыСервиса, ПараметрыЗапроса);
	
	КодОтвета			 = Число(Соединение.Status);
	ЗаголовкиОтвета		 = ЗаголовкиHTTPОтвета_COM(Соединение);
	КодОтветаДопустимый	 = ДопустимыеКодыОтвета.Найти(КодОтвета) <> Неопределено;
	
	Если ТелоОтветаКакДвоичныеДанные И КодОтветаДопустимый Тогда
		
		Если Соединение.responseBody = Неопределено Тогда
			ТелоОтвета = Неопределено;
		Иначе
			ТелоОтвета = ДвоичныеДанныеHTTPОтвета_COM(Соединение);
		КонецЕсли;
		
	Иначе
		
		ТелоОтвета = Соединение.ResponseText;
		
		Если НЕ ЗначениеЗаполнено(ТелоОтвета) И НЕ КодОтветаДопустимый Тогда
			ТелоОтвета = Соединение.StatusText;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодОтвета"			, КодОтвета);
	Результат.Вставить("ТелоОтвета"			, ТелоОтвета);
	Результат.Вставить("Заголовки"			, ЗаголовкиОтвета);
	Результат.Вставить("КодОтветаДопустимый", КодОтветаДопустимый);
	
	Возврат Результат;
	
КонецФункции

// Вычисляет адрес ресурса по имени метода API и его параметрам.
//
//&НаКлиенте
Функция АдресРесурсаHTTP(ИмяМетода, Параметры = Неопределено)
	
	ПараметрыСтрокой = "";
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		
		Если Найти(ИмяМетода, "?") = 0 Тогда
			Разделитель = "?";
		Иначе
			Разделитель = "&";
		КонецЕсли;
		
		Для Каждого Параметр Из Параметры Цикл
			// Метод Общее_ПодставитьПараметрыВСтроку использовать нельзя, в параметрах может быть %n
			ПараметрыСтрокой = ПараметрыСтрокой + Разделитель + Параметр.Ключ + "=" + Параметр.Значение;
			Разделитель = "&";
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = ИмяМетода + ПараметрыСтрокой;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ОтправитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод		 = ПараметрыЗапроса.Метод;
	АдресМетода	 = ПараметрыЗапроса.АдресМетода;
	ТелоЗапроса	 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры	 = ПараметрыЗапроса.Параметры;
	Заголовки	 = ПараметрыЗапроса.Заголовки;
	
	Соединение	 = HTTPСоединение(ПараметрыСервиса);
	АдресРесурса = АдресРесурсаHTTP(АдресМетода, Параметры);
	HTTPЗапрос	 = НовыйHTTPЗапрос(АдресРесурса, Заголовки);
	
	Если Метод = "GET" Тогда
		
		Результат = Соединение.Получить(HTTPЗапрос);
		
	ИначеЕсли Метод = "POST" Тогда
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			
			Если ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
				
				HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8,
				ПредопределенноеЗначение("ИспользованиеByteOrderMark.НеИспользовать"));
				
			Иначе
				
				HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ОтправитьHTTPЗапрос_Plugin(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод			 = ПараметрыЗапроса.Метод;
	АдресМетода		 = ПараметрыЗапроса.АдресМетода;
	ТелоЗапроса		 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры		 = ПараметрыЗапроса.Параметры;
	Заголовки		 = ПараметрыЗапроса.Заголовки;
	
	Схема	 = ПараметрыСервиса.Схема;
	Порт	 = ПараметрыСервиса.Порт;
	
	СтрокаЗапроса	 = Схема + "://" + ПараметрыСервиса.АдресВебСервиса +
					   ?(ЗначениеЗаполнено(Порт), ":" + Формат(Порт, "ЧГ=0"), "") + АдресМетода;
	
	ПараметрыЗапросаДляПлагина = Новый Структура;
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		ПараметрыЗапросаДляПлагина.Вставить("Параметры", Параметры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		ПараметрыЗапросаДляПлагина.Вставить("Заголовки", Заголовки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		ПараметрыЗапросаДляПлагина.Вставить("ТелоЗапроса", ТелоЗапроса);
	КонецЕсли;
	
	Если ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные Тогда
		ПараметрыЗапросаДляПлагина.Вставить("ТелоОтвета", Новый Структура("ДвоичныеДанные"));
	Иначе
		ПараметрыЗапросаДляПлагина.Вставить("ТелоОтвета", Новый Структура("Строка"));
	КонецЕсли;
	
	Результат = Плагин_ВыполнитьHTTPЗапрос(Метод, СтрокаЗапроса, ПараметрыЗапросаДляПлагина);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ОтправитьHTTPЗапрос_COM(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод		 = ПараметрыЗапроса.Метод;
	АдресМетода	 = ПараметрыЗапроса.АдресМетода;
	ТелоЗапроса	 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры	 = ПараметрыЗапроса.Параметры;
	Заголовки	 = ПараметрыЗапроса.Заголовки;
	
	Схема	 = ПараметрыСервиса.Схема;
	Порт	 = ПараметрыСервиса.Порт;
	
	Соединение		 = HTTPСоединение(ПараметрыСервиса);
	АдресРесурса	 = АдресРесурсаHTTP(АдресМетода, Параметры);
	РежимПрокси		 = ПараметрыСервиса.НастройкиПрокси.РежимПрокси;
	СтрокаЗапроса	 = Схема + "://" + ПараметрыСервиса.АдресВебСервиса +
					   ?(ЗначениеЗаполнено(Порт), ":" + Формат(Порт, "ЧГ=0"), "") + АдресРесурса;
	
	Соединение.Open(Метод, СтрокаЗапроса, 0);
	
	Если РежимПрокси = "UseProxy" Тогда
		ВыполнитьАвторизациюНаПрокси_COM(ПараметрыСервиса, Соединение);
	КонецЕсли;
	
	Для Каждого Элемент Из Заголовки Цикл
		Соединение.SetRequestHeader(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Если ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
		Соединение.Send(Base64Строка(ТелоЗапроса));
	Иначе 
		Соединение.Send(ТелоЗапроса);
	КонецЕсли;
	
	Возврат Соединение;
	
КонецФункции

//&НаКлиенте
Функция ЗаголовкиHTTPОтвета_COM(Соединение)
	
	Результат = Новый Соответствие;
	
	ЗаголовкиСтрокой = Соединение.GetAllResponseHeaders();
	МассивЗаголовков = РазделитьСтроку(ЗаголовкиСтрокой, Символы.ПС, Ложь);
	
	Для Каждого ЗаголовокСтрокой Из МассивЗаголовков Цикл
		
		ЧастиЗаголовка = РазделитьСтроку(ЗаголовокСтрокой, ":");
		
		Ключ	 = ЧастиЗаголовка[0];
		Значение = ЧастиЗаголовка[1];
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ДвоичныеДанныеHTTPОтвета_COM(Соединение)
	
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
	
	Попытка
		Поток = Новый COMОбъект("ADODB.Stream");
	Исключение
		ОписаниеОшибки = "Не удалось инициализировать COM-объект ""ADODB.Stream""";
		ВызватьИсключение ОписаниеОшибки;
	КонецПопытки;
	
	Поток.Type = 1;  //Бинарный
	Поток.Mode = 3; 
	Поток.Open();
	Поток.Write(Соединение.responseBody);
	Поток.SaveToFile(ИмяФайлаОтвета);
	Поток.Close();	
	
	Результат = Новый ДвоичныеДанные(ИмяФайлаОтвета);
	
	УдалитьФайлы(ИмяФайлаОтвета);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Процедура УстановитьПараметрыПрокси_COM(ПараметрыСервиса, Соединение)
	
	// Значения констант: https://msdn.microsoft.com/en-us/library/windows/desktop/aa384059(v=vs.85).aspx
	
	НастройкиПрокси	 = ПараметрыСервиса.НастройкиПрокси;
	РежимПрокси		 = НастройкиПрокси.РежимПрокси;
	
	Если РежимПрокси = "NoProxy" Тогда
		
		Соединение.SetProxy(1, "");  // HTTPREQUEST_PROXYSETTING_DIRECT = 1
		
	ИначеЕсли РежимПрокси = "UseDefaultProxy" Тогда
		
		Соединение.SetProxy(0, "");  // HTTPREQUEST_PROXYSETTING_PRECONFIG = 0
		
	ИначеЕсли РежимПрокси = "UseProxy" Тогда
		
		АдресПроксиСервера	= НастройкиПрокси.АдресПроксиСервера;
		Порт				= НастройкиПрокси.ПортПроксиСервера;
		
		Если Не ЗначениеЗаполнено(АдресПроксиСервера) Тогда
			ВызватьИсключение "Заполните настройки прокси";
		КонецЕсли;
		
		ProxyServer = АдресПроксиСервера + ":" + Формат(Порт, "ЧГ=0");
		
		Соединение.SetProxy(2, ProxyServer);  // HTTPREQUEST_PROXYSETTING_PROXY = 2
			
		// Логин и пароль необходимо указать после установки соединения - т.е. после вызова метода Open
		// Это вынесено в отдельный метод - ВыполнитьАвторизациюНаПрокси_COM
		
	КонецЕсли;
	
КонецПроцедуры

//&НаКлиенте
Процедура ВыполнитьАвторизациюНаПрокси_COM(ПараметрыСервиса, Соединение)
	
	// Значения констант: https://msdn.microsoft.com/en-us/library/windows/desktop/aa384058(v=vs.85).aspx
	
	НастройкиПрокси = ПараметрыСервиса.НастройкиПрокси;
	
	Логин	 = НастройкиПрокси.ЛогинПроксиСервера;
	Пароль	 = НастройкиПрокси.ПарольПроксиСервера;
	
	Если ЗначениеЗаполнено(Логин) Тогда
		Соединение.SetCredentials(Логин, Пароль, 1);  // HTTPREQUEST_SETCREDENTIALS_FOR_PROXY = 1
	КонецЕсли;
	
КонецПроцедуры

//&НаКлиенте
Функция НовыйИнтернетПрокси(НастройкиПрокси)
	
	РежимПрокси	= НастройкиПрокси.РежимПрокси;
	
	Если РежимПрокси = "UseProxy" Тогда
		
		Результат = Новый ИнтернетПрокси;
		
		АдресПроксиСервера	= НастройкиПрокси.АдресПроксиСервера;
		Порт				= НастройкиПрокси.ПортПроксиСервера;
		Логин				= НастройкиПрокси.ЛогинПроксиСервера;
		Пароль				= НастройкиПрокси.ПарольПроксиСервера;
		
		Если Не ЗначениеЗаполнено(АдресПроксиСервера) Тогда
			ВызватьИсключение "Заполните настройки прокси";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Логин) Тогда
			
			Результат.Установить("http"	, АдресПроксиСервера, Порт, Логин, Пароль, Ложь);
			Результат.Установить("https", АдресПроксиСервера, Порт, Логин, Пароль, Ложь);
			
		Иначе
			
			Результат.Установить("http"	, АдресПроксиСервера, Порт);
			Результат.Установить("https", АдресПроксиСервера, Порт);
			
		КонецЕсли;
		
	ИначеЕсли РежимПрокси = "UseDefaultProxy" Тогда
		
		Результат = Новый ИнтернетПрокси(Истина);
		// Будет использован прокси по умолчанию:
		// либо из файла inetcfg.xml, если он расположен на данной машине, либо из настроек Internet Explorer.
		// Пример файла inetcfg.xml можно найти в официальной документации:
		// https://its.1c.ru/db/v8doc#content:26:1:issogl1_3.13.inetcfg.xml
		
	Иначе
		
		Результат = Новый ИнтернетПрокси(Ложь);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция НовоеHTTPСоединение(ПараметрыСервиса, Прокси)
	
	АдресВебСервиса = ПараметрыСервиса.АдресВебСервиса;
	
	Схема				 = ПараметрыСервиса.Схема;
	Порт				 = ПараметрыСервиса.Порт;
	ИмяПользователя		 = Неопределено;
