	ТелоОтвета_ПолучениеПечатнойФормы = "";
	
	Отказ = Ложь;
	
	ПроверитьЗаполненностьПоля(ApiKey, "Api-key", Отказ);
	ПроверитьЗаполненностьПоля(ИдПеревозки_ПолучениеПФ, "Идентификатор перевозки", Отказ);
	
	Если Отказ Тогда 
		Возврат
	КонецЕсли;
	
	Ответ = ПолучитьПечатнуюФормуТранспортнойНакладнойНаСервере();
	
	Если ЗначениеЗаполнено(ПутьСохраниния_ПолучениеПечатнойФормы) Тогда 
			
		Ответ.Записать(ПутьСохраниния_ПолучениеПечатнойФормы);
		
	КонецЕсли;	
	
	ТелоОтвета_ПолучениеПечатнойФормы = Ответ;
	
