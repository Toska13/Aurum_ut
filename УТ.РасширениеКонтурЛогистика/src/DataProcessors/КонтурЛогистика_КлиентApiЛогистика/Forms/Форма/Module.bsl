&НаСервере
Процедура ПолучитьСведенияОПеревозкахНаСервере()
	
	ТипФильтрации 		= ?(ТипФильтрацииПоДатеСоздания, "Created", "Modified");
	СпособСортировки 	= ?(СпособСортировкиВозр, "Ascending", "Descending");
	
	СоответствиеДанных  = КонтурЛогистика_API_Логистика.ПолучитьСведенияОПеревозках(ПараметрыСервисаЛогистика(), 
							ДатаНачалаСведенийОПеервозках, 
							ДатаОкончанияСведенийОПеервозках, 
							СтатусПеревозок, 
							КолЗаписейПропустить, 
							КоличествоЗаписей, 
							ТипФильтрации, 
							СпособСортировки);
							
	ТелоОтвета_ПолучениеСведенийОПеревозках = КонтурЛогистика_API_Логистика.JsonЗаписать(СоответствиеДанных);						
	
