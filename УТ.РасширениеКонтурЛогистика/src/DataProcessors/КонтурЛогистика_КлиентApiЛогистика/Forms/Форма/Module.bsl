&НаКлиенте
Процедура ОбработчикПослеВыбораФайла(ВыбранныеФайлы, ДопПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда 
		Сообщить("Отказ от выбора файла");
		Возврат
	КонецЕсли;	
	
	ЭтаФорма[ДопПараметры.ИмяРеквизита] = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция АдресСервераЛогистика(ИспользуемыйСерверЛогистики)
	
	Если ИспользуемыйСерверЛогистики = 0 Тогда 
		Возврат "https://logist-api.kontur.ru";
	ИначеЕсли ИспользуемыйСерверЛогистики = 1 Тогда 
		Возврат "https://logist-api.testkontur.ru";
	ИначеЕсли ИспользуемыйСерверЛогистики = 2 Тогда
		Возврат "https://logist-api-staging.kontur.ru";
	Иначе
		Сообщить("Неизвесный адрес сервера");
	КонецЕсли;	
		
КонецФункции

&НаКлиенте
Процедура ПроверитьЗаполненностьПоля(Реквизит, Синоним, Отказ)
	
	Если Не ЗначениеЗаполнено(Реквизит) Тогда 
		
		Сообщить("Не заполнено поле """ + Синоним + """");
		Отказ = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФайла_()
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлТитула);
	
	ДокументXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	Возврат ДокументXDTO.ИдФайл;
	
КонецФункции	

&НаСервере
Функция ПараметрыСервисаЛогистика()
	
	АдресСервера = АдресСервераЛогистика(ИспользуемыйСерверЛогистики);
	ПараметрыСервисаСервера = КонтурЛогистика_API_Логистика.МанифестПараметрыСервиса(АдресСервера);
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика();
	ЗаполнитьЗначенияСвойств(ПараметрыСервиса, ПараметрыСервисаСервера, "Схема, АдресВебСервиса, Порт");
	
	Возврат ПараметрыСервиса;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьПутьДляСохраненияФайлов(ИмяРеквизитаПути, Фильтр)

	ВыбратьФайл("ОбработчикПослеВыбораФайла", 
		ЭтаФорма, 
		РежимДиалогаВыбораФайла.Сохранение,
		"Выберите путь для сохранения ответа",,
		Фильтр,,, 
		Новый Структура("ИмяРеквизита", ИмяРеквизитаПути));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСохраненныйФайл(РеквизитПути)

	Если ЗначениеЗаполнено(РеквизитПути) Тогда
		ФайлНаДиске = Новый Файл(РеквизитПути);
		Если ФайлНаДиске.Существует() Тогда 
			ЗапуститьПриложение(РеквизитПути);
		Иначе
			Сообщить("Файл на диске не существует");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АдресСтраницыСправки(ИмяМетода)
	
	Соответствие = Новый Соответствие();
	
	Соответствие.Вставить("ОтправкаТитула", 				"/method?type=post&path=%2Fv1%2Fdocuments%2Fwaybill");
	Соответствие.Вставить("ПолучениеЛентыСобытий", 			"/method?type=get&path=%2Fv1%2Fevents");
	Соответствие.Вставить("ПолучениеУИДа", 					"/method?type=get&path=%2Fv1%2Fmintransgateway%2Fuuid");
	Соответствие.Вставить("ПолучениеСведенийОбОрганизации", "/method?type=get&path=%2Fv1%2Forganizations%2Fmy");
	Соответствие.Вставить("ПолучениеРеестраДокументов", 	"/method?type=get&path=%2Fv1%2Fregistry");
	Соответствие.Вставить("ПолучениеСведенийОПеревозках", 	"/method?type=get&path=%2Fv1%2Ftransportations");
	Соответствие.Вставить("ПолучениеСведенийОПеревозке", 	"/method?type=get&path=%2Fv1%2Ftransportations%2F%7Bid%7D");
	Соответствие.Вставить("ПолучениеФайловТитула", 			"/method?type=get&path=%2Fv1%2Ftransportations%2F%7BtransportationId%7D%2Ftitles%2F%7BtitleId%7D");
	Соответствие.Вставить("ПолучениеПечатнойФормы", 		"/method?type=get&path=%2Fv1%2Ftransportations%2F%7BtransportationId%7D%2Fprint-form");
	Соответствие.Вставить("ПолучениеДО", 					"/method?type=get&path=%2Fv1%2Ftransportations%2F%7BtransportationId%7D%2Ffull-docflow");
	
	Возврат "https://developer.kontur.ru/doc/logistics.api" + Соответствие.Получить(ИмяМетода); 
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура Декорация_УстановитьИмяСервера(Форма)
	
	Форма.Элементы.Декорация_ИмяСервера.Заголовок = АдресСервераЛогистика(Форма.ИспользуемыйСерверЛогистики);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусыПеревозок()
		
	Макет = Обработки.КонтурЛогистика_КлиентApiЛогистика.ПолучитьМакет("ПредопределенныеЭлементы");
	
	Область = Макет.ПолучитьОбласть("Данные");
	
	Для Сч = 1 По Область.ВысотаТаблицы Цикл
		
		Наименование				= ПолучитьТекстЯчейкиОбласти(Область, Сч, 1);
		НаименованиеСостоянияАнгл 	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 3);
		
		Элементы.СтатусПеревозок.СписокВыбора.Добавить(НаименованиеСостоянияАнгл, Наименование);
				
	КонецЦикла;
		
КонецПроцедуры	

&НаСервере
Функция ПолучитьТекстЯчейкиОбласти(Область, Строка, Колонка)
	
	Возврат Строка(Область.ПолучитьОбласть("R" + Формат(Строка, "ЧГ=0") + "C" + Формат(Колонка, "ЧГ=0")).ТекущаяОбласть.Текст);
	
КонецФункции

&НаКлиенте
Процедура ВыбратьФайл(ИмяОбработчика,
								КонтекстОбработчика,
								РежимДиалога,
								Заголовок = "",
								НачальноеИмя = "",
								Фильтр = Неопределено,
								МножественныйВыбор = Ложь,
								Расширение = "",
								ДополнительныеПараметры = Неопределено) Экспорт
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалога);
	ДиалогВыбораФайла.ПолноеИмяФайла = НачальноеИмя;
	ДиалогВыбораФайла.Заголовок = Заголовок;
	ДиалогВыбораФайла.Фильтр = Фильтр;
	ДиалогВыбораФайла.МножественныйВыбор = МножественныйВыбор;
	ДиалогВыбораФайла.Расширение = Расширение;
	
	ОписаниеОбработчика = Неопределено;
		
	ОписаниеОбработчика = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика, ДополнительныеПараметры);
	ДиалогВыбораФайла.Показать(ОписаниеОбработчика);
		
КонецПроцедуры

# КонецОбласти

