
Функция СостояниеЗаданий() Экспорт
	
	Перем Обработка;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("РегламентныеАктивно");
	Результат.Вставить("РегламентныеВсего");
	Результат.Вставить("ФоновыеВыполняется");
	Результат.Вставить("ФоновыеАварийЗаЧас");
	
	Обработка = Создать();
	// условия формирования	
	Обработка.ОтображатьТолькоФоновыеКонтурЛогистика = Истина;
	Обработка.МинутНазадФоновые = ПоказыватьФоновыеПоУмолчаниюМинутНазад();	
	
	Обработка.ПерезаполнитьРегламентныеЗадания();
	Результат.Вставить("РегламентныеВсего", Обработка.РегламентныеЗаданияПодсистемы.Количество());
	Результат.Вставить("РегламентныеАктивно", Обработка.РегламентныеЗаданияПодсистемы.НайтиСтроки(
		Новый Структура("Использование", Истина)).Количество());
		
		Если  КонтурЛогистика_ДлительныеОперацииСервер.МенеджерФоновыхЗаданийДоступен() Тогда
			Обработка.ПерезаполнитьФоновыеЗадания();
			Результат.Вставить("ФоновыеВыполняется", Обработка.ФоновыеЗаданияПодсистемы.НайтиСтроки(
															Новый Структура("Состояние", "Задание выполняется")).Количество());
			Результат.Вставить("ФоновыеАварийЗаЧас", Обработка.ФоновыеЗаданияПодсистемы.НайтиСтроки(
															Новый Структура("Состояние", "Задание завершено с ошибками")).Количество());
		Иначе
			Результат.Вставить("ФоновыеВыполняется", 0);
			Результат.Вставить("ФоновыеАварийЗаЧас", 0);
		КонецЕсли;
		
	Обработка = Неопределено;
	
	Возврат Результат
	
КонецФункции

// при выводе фоновых заданий за какое время их фильтровать
Функция ПоказыватьФоновыеПоУмолчаниюМинутНазад() Экспорт
	
	Возврат 15; // минут
	
КонецФункции
