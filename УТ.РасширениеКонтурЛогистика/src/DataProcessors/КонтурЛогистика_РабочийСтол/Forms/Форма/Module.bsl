&НаКлиенте
Процедура ОткрытьЗадачи_ЭТРН_Титул(Команда)
	
	ВыбранныйТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов." + Сред(Команда.Имя, 15));
	СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
	
	ОткрытьЗадачи_ЭТРН_ТипСценарий(ВыбранныйТипЛогистика, СпецСценарий);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗадачи_ЭТРН_ТипСценарий(Знач ВыбранныйТипЛогистика, СпецСценарий)
	
	Перем КлючФормыЗадач, ПараметрыЗадач;
	
	ЭтоОбычноеПриложение = Ложь;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭтоОбычноеПриложение = Истина;
	#КонецЕсли
	
	Если ЗадачиВОтдельныхФормах ИЛИ ЭтоОбычноеПриложение Тогда 
		
		КлючФормыЗадач = Строка(Новый УникальныйИдентификатор);
		
	Иначе
		
		КлючФормыЗадач = "ЗадачиЛогистика";
		УстановитьОткрытойФормеЗадачНовыеПараметры(ВыбранныйТипЛогистика, СпецСценарий);
		
	КонецЕсли;
	
	ПараметрыЗадач = ПолучитьПараметрыФормыЗадач(ВыбранныйТипЛогистика, КлючФормыЗадач, СпецСценарий);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_Задачи", ПараметрыЗадач,, ЭтаФорма, "ОбновитьЗадачи",, РежимОткрытияОкнаФормы.Независимый, КлючФормыЗадач);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗадачи_ПЛ_Титул(Команда)
	
	ВыбранныйТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов." + Сред(Команда.Имя, 15));
	СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
	
	ОткрытьЗадачи_ПЛ_ТипСценарий(ВыбранныйТипЛогистика, СпецСценарий);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗадачи_ПЛ_ТипСценарий(Знач ВыбранныйТипЛогистика, СпецСценарий)
	
	Перем КлючФормыЗадач, ПараметрыЗадач;
	
	ЭтоОбычноеПриложение = Ложь;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭтоОбычноеПриложение = Истина;
	#КонецЕсли
	
	Если ЗадачиВОтдельныхФормах ИЛИ ЭтоОбычноеПриложение Тогда 
		
		КлючФормыЗадач = Строка(Новый УникальныйИдентификатор);
		
	Иначе
		
		КлючФормыЗадач = "ЗадачиЛогистика";
		УстановитьОткрытойФормеЗадачНовыеПараметры(ВыбранныйТипЛогистика, СпецСценарий);
		
	КонецЕсли;
	
	ПараметрыЗадач = ПолучитьПараметрыФормыЗадач(ВыбранныйТипЛогистика, КлючФормыЗадач, СпецСценарий);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_Задачи", 
																	ПараметрыЗадач,,
																	ЭтаФорма, 
																	"ОбновитьЗадачи",,
																	РежимОткрытияОкнаФормы.Независимый,
																	КлючФормыЗадач);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыФормыЗадач(Знач ВыбранныйТипЛогистика, Знач КлючФормыЗадач, СпецСценарий)
	
	Перем ПараметрыЗадач;
	
	ПараметрыЗадач = Новый Структура("ТипЛогистика", ВыбранныйТипЛогистика);
	ПараметрыЗадач.Вставить("Период", Период);
	ПараметрыЗадач.Вставить("Ключ", КлючФормыЗадач);
	ПараметрыЗадач.Вставить("СпецСценарий", СпецСценарий);
	
	Возврат ПараметрыЗадач;

КонецФункции

&НаКлиенте
Процедура УстановитьОткрытойФормеЗадачНовыеПараметры(Знач ВыбранныйТипЛогистика , Знач СпецСценарий)
	
	Перем ОткрытыеОкна, текОкно, Форма;
	
	ОткрытыеОкна = ПолучитьОкна();
	
	Если ОткрытыеОкна <> Неопределено Тогда 
	
		Для Каждого текОкно Из ОткрытыеОкна Цикл 
			
			Если Лев(текОкно.Заголовок, 6) = "Задачи" Тогда
				
				Для Каждого Форма Из текОкно.Содержимое Цикл
					
					Если Форма.ИмяФормы = "ОбщаяФорма.КонтурЛогистика_Задачи" Тогда
						
						Форма.Период 		= Период;
						Форма.ТипЛогистика 	= ВыбранныйТипЛогистика;
						Форма.СпецСценарий 	= СпецСценарий;
						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

