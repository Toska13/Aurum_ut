
// События формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНачалаДействияЭПЛ_5_02 = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДатуНачалаДействияЭПЛ502();
	Команды["ВключитьФорматЭПЛ502"].Подсказка = Команды["ВключитьФорматЭПЛ502"].Подсказка 
		+ " Переход доступен с " + Формат(ДатаНачалаДействияЭПЛ_5_02, "ДФ=dd.MM.yyyy");
	Команды["ОтключитьФорматЭПЛ501"].Подсказка = Команды["ОтключитьФорматЭПЛ501"].Подсказка 
		+ " Переход доступен с " + Формат(ДатаНачалаДействияЭПЛ_5_02, "ДФ=dd.MM.yyyy");
		
	Если ЗначениеЗаполнено(Параметры.Период) Тогда 
		Период = Параметры.Период;
		ПериодВнешнийМодуль = Параметры.Период; 
		КонтурЛогистика_ОбщегоНазначенияСервер.ПреобразоватьПериод(ПериодВнешнийМодуль);
	КонецЕсли;
	
	ЭтоТестовыйРежим = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок"); 
	ТекВерсия = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	ЭтаФорма.Заголовок = "Контур.Логистика для 1С " + ТекВерсия;
	Если ЭтоТестовыйРежим Тогда 
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " - Тестовое окружение";
	КонецЕсли;
	
	ИспользоватьЗапускРоботовНаКлиенте = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЗапускРоботовНаКлиенте_Использовать");
	Если ИспользоватьЗапускРоботовНаКлиенте Тогда
		ИнтервалЗапускаРоботовНаКлиенте = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЗапускРоботовНаКлиенте_ИнтервалЗапуска");
		Элементы.ФормаЗапускРоботовНаКлиенте.Заголовок = "Запуск роботов на клиенте (" + ИнтервалЗапускаРоботовНаКлиенте + " сек.)";
	КонецЕсли;
	Элементы.ФормаЗапускРоботовНаКлиенте.Видимость = ИспользоватьЗапускРоботовНаКлиенте;
	
	ИспользоватьГруппыДоступа = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьГруппыДоступа");
	
	Элементы.СостояниеОбмена.Видимость = Ложь; // будет показан после открытия если требуется
	
	ТекПользовательЯвляетсяАдминистратором = КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор();
	
	ВидимостьТехническихКоманд = КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьНастройкуПоказыватьТехническиеКомандыНаРабочемСтоле();
	
	НашиОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации(); 
	
	ЗадачиВОтдельныхФормах = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЗадачиВОтдельныхФормах");
	
	УстановитьВидимостьДоступностьЭлементов();
	
	СкрытьСлужебныеЭлементыВиджетаОбновления_Сервер();
	
	ВерсияПодсистемыУстановленная = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	
	ОбновитьОтображениеБаннеров();
	
	ДобавитьРеквизитыСвязейДокументов();
	
	ОбновитьОтображениеПоГруппамДоступа();
	
	ПроверкаУстановкиПараметровСеанса();
	
	ПроверкаДокументСсылкаВОсновании();
	
	Если Параметры.Свойство("ЗапускРоботовНаКлиентеПриОткрытии") Тогда
		ЗапускРоботовНаКлиентеПриОткрытии = Истина;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьНастройкиДополнительныхРеквизитов(, Истина); 	
	
	ПроверитьАктуальностьСерфисаФЛ();
	
	КонтурЛогистика_ОнбордингСервер.ПриСозданииФормы(ЭтаФорма);
	
	КонтурЛогистика_ФункциональныеОпции.СобратьКастомныеМетрики();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		
	Если ИмяСобытия = "ЗавершениеФоновогоЗадания"
		И Параметр.Свойство("КлючФЗ")
		И Параметр.КлючФЗ = "ОбновлениеДанныхПодсистемы" Тогда
		
		ОбновитьРежимВиджетаОбновления();
		ПерерисоватьВиджетОбновления();
		
	ИначеЕсли ИмяСобытия = "ЗавершениеФоновогоЗадания"
		И Параметр.Свойство("КлючФЗ")
		И (Параметр.КлючФЗ = "Выполнение обмена"
		Или Параметр.КлючФЗ = "СинхронизироватьВсеГраницы") Тогда
		
		ОбновитьСчетчикиПереходов(, Истина);
		ОбновитьСчетчикОшибокАвтоматическойРаботы();
		
	ИначеЕсли ИмяСобытия = "ОбновитьРабочийСтол" Тогда
		
		ОбновитьОтображениеБаннеров();
		ОбновитьРабочийСтолПриОткрытии();
		УстановитьВидимостьФункциональныхБлоков();
		ОбновитьСчетчикОшибокАвтоматическойРаботы();
		ПроверитьАктуальностьСерфисаФЛ();
		ОбновитьОтображениеАвторизаций();
		КонтурЛогистика_ОнбордингКлиент.ЗапуститьОнбординг(ЭтаФорма, Ложь);
		УстановитьНастройкиЭлементовДляЭПЛ_5_02();
		
	ИначеЕсли ИмяСобытия = "ВыполнитьПроверкуСертификатов" Тогда
		
		ВыполнитьПроверкуСертификатов();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_Аутентификация" Тогда
		
		ОбновитьОтображениеАвторизаций();
		
	ИначеЕсли ИмяСобытия = "ВыполнитьОбменНаРабочемСтоле" Тогда
		
		ВыполнитьОбмен();
		
	КонецЕсли;
	
	Если ИмяСобытия = "ЗавершениеФоновогоЗадания" 
		И Параметр.Свойство("КлючФЗ")
		И Параметр.КлючФЗ = "ОбновлениеСотрудниковИзСервиса"  Тогда
		
		ПроверитьАктуальностьСерфисаФЛ();		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ПериодВнешнийМодуль) Тогда
		Период = ПериодВнешнийМодуль;
	КонецЕсли;	
	
	КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПроверитьРежимТестирования();
	
	Если ЗначениеЗаполнено(СтраницаСтартовогоПомошника) Тогда
		
		УстановитьВидимостьФункциональныхБлоков();
		ОбновитьСчетчикОшибокАвтоматическойРаботы();
		
		Если ТекПользовательЯвляетсяАдминистратором Тогда
			
			ПодключитьОбработчикОжидания("ОткрытьСтартовыйПомощник", 1, Истина);
			
		КонецЕсли;
		
	Иначе
		
		ОбновитьРабочийСтолПриОткрытии(Истина);
		
	КонецЕсли;
	
	Если ИспользоватьЗапускРоботовНаКлиенте
		И (ЗапускРоботовНаКлиентеПриОткрытии Или ЗапущенЗапускРоботовНаКлиенте) Тогда
		
		ЗапущенЗапускРоботовНаКлиенте = Ложь;
		ЗапускРоботовНаКлиенте(Неопределено);
	КонецЕсли;
	
	// Метрики
	КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание("КонтурЛогистика_Метрика.ПриОткрытииОсновнойФормы",
		КонтурЛогистика_МетрикаКлиентСервер.ПараметрыМетодаДляФЗ("ОткрытиеОсновнойФормы"),, "Отправка метрики", Неопределено);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Источник", "РабочийСтол");
	КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание("КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьЗапускМодуля",
		ПараметрыМетода,, "Отправка метрики запуска модуля", Неопределено);
	
	ПриИзмененииАвтообновленияФормы(АвтообновлениеФормы);
	
	ЗапретОткрытияНесколькихЭкземпляров(Отказ);
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ТребуетсяОбновление_НоваяВерсияУАТ_QR_МП_УАТ() Тогда
		НачатьОбновлениеРасширенияQR_МП_УАТ();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОткрытьОнбординг", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОнбординг()
	
	КонтурЛогистика_ОнбордингКлиент.ПриОткрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен()
	
	АдресРезультатаВыполнитьОбмен = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьОбмен",,
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьОбмен",
			"Фоновое задание Выполнение обмена",
			АдресРезультатаВыполнитьОбмен);
	
	Если РезультатЗапуска.Статус = "Выполняется" Тогда
		
		ИдентификаторФЗ_ВыполнитьОбмен = РезультатЗапуска.ИдентификаторЗадания;
		
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьОбмен.Заголовок = "Обмен выполняется";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьОбмен.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПесочныеЧасы;
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыполнитьОбмен", 0.1, Истина);
		
	ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
		
		ПроверитьФоновоеЗаданиеВыполнитьОбмен();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеВыполнитьОбмен() Экспорт
	
	ИнтервалОбработчикаОжидания = 2;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ВыполнитьОбмен);
	
	Если ЗаданиеЕщеВыполняется Тогда 
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыполнитьОбмен", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		// Проверим результат выполнения фонового задания
		Результат = ПолучитьИзВременногоХранилища(АдресРезультатаВыполнитьОбмен);
		Если Результат <> Неопределено И Не Результат.Успешно Тогда
			ПротоколВыполненияОбмена = "";
			Для Каждого ТекущееСообщение Из Результат.МассивОшибок Цикл
				ПротоколВыполненияОбмена = ПротоколВыполненияОбмена + ТекущееСообщение + Символы.ПС;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ПротоколВыполненияОбмена) Тогда
				ПодключитьОбработчикОжидания("ПоказатьПротоколВыполненияОбмена", 1, Истина);
			КонецЕсли;
		КонецЕсли;
		
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьОбмен.Заголовок = "Выполнить обмен";
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьОбмен.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВыполнитьОбмен;
		
		Оповестить("ОбновитьРабочийСтол");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколВыполненияОбмена()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Протокол выполнения обмена");
	ПараметрыФормы.Вставить("Текст", ПротоколВыполненияОбмена);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФормаТекстовогоСообщения", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаВТолстомКлиентеЗавершение(Результат) Экспорт
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	Элементы.ОткрытьОписаниеНовойВерсии.Видимость = Ложь;
	Элементы.ГруппаВыполняетсяОбновлениеДанных.Видимость = Ложь;
	Элементы.ПодменюОбновитьМодуль.Видимость = Ложь;
	Элементы.Обновление_ОткрытьФормуОбновленияДанных.Видимость = Ложь;
	Если Элементы.Найти("ФормаСправочникКонтурЛогистика_ГруппыДоступаОткрытьСписок") <> Неопределено Тогда
		Элементы.ФормаСправочникКонтурЛогистика_ГруппыДоступаОткрытьСписок.Видимость = ИспользоватьГруппыДоступа;
	КонецЕсли;
	
	// Обратная совместимость с 8.2
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2_13() Тогда		
		Элементы.ЗадачиЭТРН.ОтображатьЗаголовок = Ложь;
		Элементы.ЗадачиЗН.ОтображатьЗаголовок = Ложь;
		Элементы.ЗадачиЗЗ.ОтображатьЗаголовок = Ложь;
		Элементы.ЗадачиПЛ.ОтображатьЗаголовок = Ложь;
		Элементы.ЗадачиПЛ_5_02.ОтображатьЗаголовок = Ложь;
		Элементы.ДекорацияЗадачи.Высота = 2;
		Элементы.Период.Высота = 2;		
	Иначе
		Элементы.ЗаголовокЭТРН.Видимость = Ложь;
		Элементы.ЗаголовокЗЗ.Видимость = Ложь;
		Элементы.ЗаголовокЗН.Видимость = Ложь;
		Элементы.ГруппаЗаголовокПЛОФ.Видимость = Ложь;
		Элементы.ГруппаЗаголовокПЛОФ_5_02.Видимость = Ложь;
	КонецЕсли;
			
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		Элементы.ЗадачиЭР.ОтображатьЗаголовок = Ложь;
		Элементы.ЗадачиСД.ОтображатьЗаголовок = Ложь;
	Иначе
		Элементы.ЗаголовокЭР.Видимость = Ложь;
		Элементы.ЗаголовокСД.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ФормаПоказатьТехническиеКоманды.Видимость = Не ВидимостьТехническихКоманд;	
	УстановитьВидимостьТехническихКоманд();
		
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьТехническихКоманд()
	
	СкрываемыеЭлементы = Новый Массив;
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_НастройкиОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_НастройкиКонвертацииДокументовОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_НастройкиКонвертацииСправочниковОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_НастройкиКонвертацииРегистровСведенийОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_НастройкиСвязейДокументовОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_СценарииАвтоматическойРаботыОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаОбработкаКонтурЛогистика_ФоновыеИРегламентныеЗаданияОткрыть");
	СкрываемыеЭлементы.Добавить("ФормаСправочникКонтурЛогистика_ГруппыДоступаОткрытьСписок");
	СкрываемыеЭлементы.Добавить("ФормаОбработкаКонтурЛогистика_СтартовыйПомощникОткрыть");
	СкрываемыеЭлементы.Добавить("ФормаГруппаОбновление");
	СкрываемыеЭлементы.Добавить("ПереходКДокументам");
	
	Для каждого СкрываемыйЭлемент Из СкрываемыеЭлементы Цикл
		Если Элементы.Найти(СкрываемыйЭлемент) <> Неопределено Тогда
			Если СкрываемыйЭлемент = "ФормаСправочникКонтурЛогистика_ГруппыДоступаОткрытьСписок" Тогда
				Элементы[СкрываемыйЭлемент].Видимость = ВидимостьТехническихКоманд И ИспользоватьГруппыДоступа;	
			Иначе
				Элементы[СкрываемыйЭлемент].Видимость = ВидимостьТехническихКоманд;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
				
КонеЦпроцедуры

&НаСервере
Процедура УстановитьВидимостьФункциональныхБлоков()
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	ПользовательАдминистратор = КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор();
	
	ИспользуетсяЗаказНаряд = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказНаряд");
	ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
	ИспользуетсяПутевойЛист = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	ИспользуетсяПутевойЛист_5_02 = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист_5_02");
	ИспользуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
	ИспользуетсяЭкспедиторскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЭкспедиторскаяРасписка");
	
	Элементы.ЗадачиЗЗ.Видимость = ИспользуетсяЗаказЗаявка
		И (ПользовательАдминистратор Или ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ЗЗ_Титул1));
	Элементы.ЗадачиПЛ.Видимость = ИспользуетсяПутевойЛист
		И (ПользовательАдминистратор Или ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ПЛ_Титул1));
	Элементы.ЗадачиПЛ_5_02.Видимость = ИспользуетсяПутевойЛист_5_02
		И (ПользовательАдминистратор Или ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ПЛ_Титул1_5_02));
	Элементы.ЗадачиЭТРН.Видимость = ИспользуетсяТРН
		И (ПользовательАдминистратор Или ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ТрН_Титул2));
	
	Элементы.ЗадачиЭРИнтервал.Видимость = ИспользуетсяЭкспедиторскаяРасписка
		И (ПользовательАдминистратор Или ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ЭкспедиторскаяРасписка));
	Элементы.ЗадачиЭР.Видимость = Элементы.ЗадачиЭРИнтервал.Видимость;
	
	Элементы.ЗадачиЗНИнтервал.Видимость = ИспользуетсяЗаказНаряд
		И (ПользовательАдминистратор Или ПравоДоступа("Чтение", Метаданные.Документы.КонтурЛогистика_ЭлектронныйЗаказНаряд));
	Элементы.ЗадачиЗН.Видимость = Элементы.ЗадачиЗНИнтервал.Видимость;
			
	СтандартныйЗаголовокПЛ = "Путевые листы";
	ЗаголовокПЛ_5_01 = "Путевые листы 5.01 " + Символы.ПС + "(действует до " + Формат(ДатаНачалаДействияЭПЛ_5_02, "ДФ=dd.MM.yyyy") + ")";
	ЗаголовокПЛ_5_02 = "Путевые листы 5.02 " + Символы.ПС + "(с " + Формат(ДатаНачалаДействияЭПЛ_5_02, "ДФ=dd.MM.yyyy") + ")";
	
	Если ИспользуетсяПутевойЛист И Не ИспользуетсяПутевойЛист_5_02 Тогда		
		Элементы.ЗаголовокПЛОФ.Заголовок = ЗаголовокПЛ_5_01;
		Элементы.ЗадачиПЛ.Заголовок = ЗаголовокПЛ_5_01;
		Элементы.ОтключитьФорматЭПЛ501.Видимость = Ложь;
		Элементы.ВключитьФорматЭПЛ502.Видимость = Истина;
		Элементы.ВключитьФорматЭПЛ502.Доступность = Истина;
	ИначеЕсли Не ИспользуетсяПутевойЛист И ИспользуетсяПутевойЛист_5_02 Тогда		
		Элементы.ЗаголовокПЛОФ_5_02.Заголовок = СтандартныйЗаголовокПЛ;
		Элементы.ЗадачиПЛ_5_02.Заголовок = СтандартныйЗаголовокПЛ;
		Элементы.ОтключитьФорматЭПЛ501.Видимость = Ложь;
		Элементы.ВключитьФорматЭПЛ502.Видимость = Ложь;
	ИначеЕсли ИспользуетсяПутевойЛист И ИспользуетсяПутевойЛист_5_02 Тогда
		Элементы.ЗаголовокПЛОФ.Заголовок = ЗаголовокПЛ_5_01;
		Элементы.ЗадачиПЛ.Заголовок = ЗаголовокПЛ_5_01;
		Элементы.ЗаголовокПЛОФ_5_02.Заголовок = ЗаголовокПЛ_5_02;
		Элементы.ЗадачиПЛ_5_02.Заголовок = ЗаголовокПЛ_5_02;
		Элементы.ОтключитьФорматЭПЛ501.Видимость = Истина;
		Элементы.ОтключитьФорматЭПЛ501.Доступность = ДоступностьВключенияОтключенияЭПЛФормата502 
			И КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502();
		Элементы.ВключитьФорматЭПЛ502.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ИнструкцияПереходаНаФорматЭПЛ_5_02.Видимость = ИспользуетсяПутевойЛист Или Не ИспользуетсяПутевойЛист_5_02;
		
	УстановитьДоступностьПунктов();
	
	УстановитьДоступностьКоманд();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПунктов()
	
	Перем ВсеТипы, ГруппаПункт, МассивТитуловОформляемыхЭтимПользователем, текИмяЭлемента, ТипТитула, ТитулНастроен, ЭлементДругойУчастник, ЭлементОформить;
	
	МассивТитуловОформляемыхЭтимПользователем = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьМассивТитуловОформляемыхТекущимПользователем();
	ВсеТипы = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.МассивВсехТипов();
	
	// Группы доступа
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	ДоступКТитулам = ДоступыПользователя.ДоступКТитулам;
	ПолныйДоступ = ДоступыПользователя.ПолныйДоступ;
	
	Для Каждого ТипТитула Из ВсеТипы Цикл
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипТитула)
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипТитула)
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипТитула)
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипТитула) Тогда
			
			текИмяЭлемента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипТитула);
			
			ЭлементОформить = Элементы.Найти("ОткрытьЗадачи_" + текИмяЭлемента);
			ЭлементДругойУчастник = Элементы.Найти("Задачи_" + текИмяЭлемента + "ДругойУчастник");
			ЭлементДругойПользователь = Элементы.Найти("Задачи_" + текИмяЭлемента + "ДругойПользователь");
			ГруппаПункт = Элементы.Найти("Пункт_" + текИмяЭлемента);
			
			ТолькоПросмотрЭлементов = ДоступКТитулам.ТолькоПросмотр.Получить(ТипТитула);
			СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТипТитула);
			ТитулДоступенПользователю = (ПолныйДоступ Или ТолькоПросмотрЭлементов Или СозданиеРедактированиеЭлементов);
			
			ТитулНастроен = МассивТитуловОформляемыхЭтимПользователем.Найти(ТипТитула) <> Неопределено;
			
			Если  ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
				Элементы.ОткрытьЗадачиНовыйПутевойПослеСменыВодителей.Доступность = ТитулНастроен И ТитулДоступенПользователю;
			КонецЕсли;
			
			Если ЭлементОформить <> Неопределено Тогда
				ЭлементОформить.Видимость = ТитулНастроен И ТитулДоступенПользователю;
			КонецЕсли;
			
			Если ГруппаПункт <> Неопределено Тогда
				ГруппаПункт.Доступность = ТитулНастроен;
			КонецЕсли;
			
			Если ЭлементДругойУчастник <> Неопределено Тогда
				ЭлементДругойУчастник.Видимость = Не ТитулНастроен;
			КонецЕсли;
			
			Если ЭлементДругойПользователь <> Неопределено Тогда
				ЭлементДругойПользователь.Видимость = ТитулНастроен И Не ТитулДоступенПользователю;
			КонецЕсли;
			
			Если текИмяЭлемента = "ТрН_Титул4"
				Или текИмяЭлемента = "ТрН_Титул2"
				Или текИмяЭлемента = "ТрН_Титул1" Тогда // особые
				
				Если текИмяЭлемента = "ТрН_Титул4" Тогда // еще разгрузка возврата
					ЭлементОформить = Элементы.Найти("ОткрытьЗадачи_ТРН_Титул4ПоВозврату");
					ЭлементДругойУчастник = Элементы.Найти("Задачи_ТРН_Титул14ДругойУчастник");
					ЭлементДругойПользователь = Элементы.Найти("Задачи_ТРН_Титул14ДругойПользователь");
					ГруппаПункт = Элементы.Найти("Пункт_ТРН_Титул14");
				ИначеЕсли текИмяЭлемента = "ТрН_Титул1" Тогда // еще приемка возврата
					ЭлементОформить = Элементы.Найти("ОткрытьЗадачи_ТРН_Титул3Переадресовки");
					ЭлементДругойУчастник = Элементы.Найти("Задачи_ТРН_Титул13ДругойУчастник");
					ЭлементДругойПользователь = Элементы.Найти("Задачи_ТРН_Титул13ДругойПользователь");
					ГруппаПункт = Элементы.Найти("Пункт_ТРН_Титул13");
				ИначеЕсли текИмяЭлемента = "ТрН_Титул2" Тогда // еще замены в пути
					// Титул 8
					ЭлементОформить = Элементы.Найти("ОткрытьЗадачи_ТРН_Титул8");
					ЭлементДругойУчастник = Элементы.Найти("Задачи_ТРН_Титул8ДругойУчастник");
					ЭлементДругойПользователь = Элементы.Найти("Задачи_ТРН_Титул8ДругойПользователь");
					ГруппаПункт = Элементы.Найти("Пункт_ТРН_Титул8");
					ГруппаПункт.Доступность = ТитулНастроен;
					
					ЭлементОформить.Видимость = ТитулНастроен;
					ЭлементДругойУчастник.Видимость = Не ТитулНастроен;
					
					// Титул 7
					ЭлементОформить = Элементы.Найти("ОткрытьЗадачи_ТРН_Титул7");
					ЭлементДругойУчастник = Элементы.Найти("Задачи_ТРН_Титул7ДругойУчастник");
					ЭлементДругойПользователь = Элементы.Найти("Задачи_ТРН_Титул7ДругойПользователь");
					ГруппаПункт = Элементы.Найти("Пункт_ТРН_Титул7");
				КонецЕсли;
				
				ГруппаПункт.Доступность = ТитулНастроен;
				ЭлементОформить.Видимость = ТитулНастроен И ТитулДоступенПользователю;
				ЭлементДругойУчастник.Видимость = Не ТитулНастроен;
				ЭлементДругойПользователь.Видимость = ТитулНастроен И Не ТитулДоступенПользователю;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Связи документов
	ИспользуемыеСвязиДокументовПоТитулам = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СвязиДокументовПоТитулам();
	Для Каждого ТекущиеСвязи Из ИспользуемыеСвязиДокументовПоТитулам Цикл
		
		Для Каждого ТекущаяСвязь Из ТекущиеСвязи.Значение Цикл
			
			ТолькоПросмотрЭлементов = ДоступКТитулам.ТолькоПросмотр.Получить(ТекущаяСвязь.ТипДокументаПодчиненный);
			СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТекущаяСвязь.ТипДокументаПодчиненный);
			ТитулДоступенПользователю = (ПолныйДоступ Или ТолькоПросмотрЭлементов Или СозданиеРедактированиеЭлементов);
			
			ПостфиксИмениЭлементов = ТекущаяСвязь.ИмяТипаДокументаОсновной + "_" + ТекущаяСвязь.ИмяТипаДокументаПодчиненный;
			ЭлементДругойПользователь = Элементы.Найти("СвязиДокументов_ДругойПользователь_" + ПостфиксИмениЭлементов);
			
			Если ЭлементДругойПользователь <> Неопределено Тогда
				ЭлементДругойПользователь.Видимость = Не ТитулДоступенПользователю;
				
				ЭлементОформить = Элементы.Найти("СвязиДокументов_ОткрытьЗадачи_" + ПостфиксИмениЭлементов);
				Если ЭлементОформить <> Неопределено Тогда
					ЭлементОформить.Видимость = ТитулДоступенПользователю;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКоманд()
	
	// Настройка полномочий МЧД
	ВариантПроверкиПолномочийМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВариантПроверкиПолномочийМЧД");	
	Элементы.ФормаРегистрСведенийКонтурЛогистика_НастройкиПолномочийМЧДОткрытьСписок.Видимость = ВариантПроверкиПолномочийМЧД <> Перечисления.КонтурЛогистика_ВариантыПроверкиПолномочийМЧД.НеПроверять;
	
	// Сохранение печтаной формы в присоединенные файлы
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_СохранитьПечатныеФормыЭПДВПрисоединенныеФайлыЗаПериод.Видимость = СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеБаннеров()
	
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.НеобходимыеНастройкиДляРаботыПодсистемыЗаполнены();
	СтраницаСтартовогоПомошника = Результат.ТекСтраницаПомошника;
	
	Элементы.БаннерСтартовыйПомошник.Видимость = Ложь;
	Элементы.БаннерНеНастроено.Видимость = Ложь;
	Элементы.Страницы.ТекущаяСтраница = Элементы.Колонки;
	
	Если ЗначениеЗаполнено(СтраницаСтартовогоПомошника) Тогда
	
		Если ТекПользовательЯвляетсяАдминистратором Тогда
			Элементы.ОшибкаНастройки.Заголовок = Результат.ТекстОшибки;
			Элементы.БаннерСтартовыйПомошник.Видимость = Истина;
		Иначе
			Элементы.БаннерНеНастроено.Видимость = Истина;
			
			ТекстОшибки = "Подсистема не настроена и пользователь не является администратором.
			|Ошибка: " + Результат.ТекстОшибки;
			КонтурЛогистика_Метрика.ОбработатьОшибку("КонтурЛогистика_РабочийСтол.Форма.ПодсистемаНеНастроена", ТекстОшибки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СпециальноеОформление()

	НовогоднееОформление = Ложь;
	
	ТекДень = День(ТекущаяДатаСеанса());
	ТекМесяц = Месяц(ТекущаяДатаСеанса());
	
	Если ТекМесяц = 12 И ТекДень > 16 Тогда 
		НовогоднееОформление = Истина;
	КонецЕсли;
	
	Если ТекМесяц = 1 И ТекДень < 15 Тогда 
		НовогоднееОформление = Истина;
	КонецЕсли;
	
	Если НовогоднееОформление Тогда 
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьОбмен.Картинка 	= БиблиотекаКартинок.КонтурЛогистика_Елка;
		Элементы.ПодменюНастройки.Картинка 									= БиблиотекаКартинок.КонтурЛогистика_Снежинка;
	КонецЕсли;

КонецПроцедуры

// Команды Формы

&НаКлиенте
Процедура ОткрытьСписокСвязей(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_СвязиДокументов.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтартовыйПомощник() Экспорт
	
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("НачальнаяСтраница", СтраницаСтартовогоПомошника);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", ПараметрыОткрытияФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяЗапускСтартовогоПомощника()
	
	Возврат СтраницаСтартовогоПомошника <> "";

КонецФункции

&НаКлиенте
Функция ТребуетсяОткрытьФормуПереходаНаНовуюВерсию()
		
	Возврат НЕ СтраницаСтартовогоПомошника <> "" 
				И КонтурЛогистика_ОбновлениеВерсииМодуля.ТребуетсяВыполнитьПереходНаНовуюВерсию();
				
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуОбновленияПриНеобходимости()
	
	Если ТребуетсяОткрытьФормуПереходаНаНовуюВерсию() Тогда
		
		Попытка
			
			ЗапуститьАвтообновлениеДанных();
			
			ПодключитьОбработчикОжидания("АвтопересчетСтатусаПодсистемы", 10, Истина);
		Исключение
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ОбновлениеПодсистемы",,,
			ЭтаФорма, 
			"ОбновитьЗадачи",,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьАвтообновлениеДанных()
	
	ЗаданиеВыгрузки = ФоновыеЗадания.Выполнить("КонтурЛогистика_ОбновлениеВерсииМодуля.ВыполнитьПереходНаНовуюВерсию_ФоновоеЗадание", , "КонтурЛогистика_Обновление", "Обновление данных при запуске нового релиза подсистемы");
	Элементы.Обновление_ОткрытьФормуОбновленияДанных.Заголовок = "обновление данных...";
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗадачи(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	ОбновитьСчетчики();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРабочийСтолПриОткрытии(ПриОткрытии = Ложь)
	
	Если Не ОбработчикиОжиданияВыполнились Тогда
		
		Если Не ЗначениеЗаполнено(Период) Или Период.ДатаОкончания = Дата(1,1,1) Тогда
			Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Последние7Дней);
		КонецЕсли;
		
		ПерерисоватьВиджетОбновления();
		Обновление_ПроверитьОбновление();
		ВыполнитьПроверкуСертификатов();
		ОбновитьСчетчикОшибокАвтоматическойРаботы();
		Если ПриОткрытии Тогда
			ПолучитьУведомленияИзСервиса();
		КонецЕсли;
		
		ОбновитьСчетчики(Истина);
		ПодключитьОбработчикОжидания("АвтопересчетСтатусаПодсистемы", 1.5, Истина);
		ПодключитьОбработчикОжидания("ОткрытьФормуОбновленияПриНеобходимости", 1, Истина);
		ПодключитьОбработчикОжидания("ОткрытьФормуПроверкиСертификатов", 0.5, Истина);
		ПодключитьОбработчикОжидания("ОткрытьФормуПринятиеРешенияОБлокировке", 1.5, Истина);
		ПодключитьОбработчикОжидания("ОбновитьОтображениеАвторизаций", 2, Истина);
		
		ОбработчикиОжиданияВыполнились = Истина; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверкаДокументСсылкаВОсновании()
	
	Элементы.БаннерДокументСсылкаВОсновании.Видимость = Ложь;
	
	ПодсистемаКакРасширение = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение();
	Если ПодсистемаКакРасширение Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПроверяемыеДокументы = Новый Массив;
	ПроверяемыеДокументы.Добавить("КонтурЛогистика_ДФ_Титул1");
	Если  КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка") Тогда
		ПроверяемыеДокументы.Добавить("КонтурЛогистика_ЗЗ_Титул1");
	КонецЕсли;
	Если  КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказНаряд") Тогда
		ПроверяемыеДокументы.Добавить("КонтурЛогистика_ЗН_Титул1");
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист") Тогда
		ПроверяемыеДокументы.Добавить("КонтурЛогистика_ПЛ_Титул1");
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист_5_02") Тогда
		ПроверяемыеДокументы.Добавить("КонтурЛогистика_ПЛ_Титул1_5_02");
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН") Тогда
		ПроверяемыеДокументы.Добавить("КонтурЛогистика_ТрН_Титул1");
	КонецЕсли;
	Если  КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЭкспедиторскаяРасписка") Тогда
		ПроверяемыеДокументы.Добавить("КонтурЛогистика_ЭкспедиторскаяРасписка");
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ПроверяемыеДокументы Цикл
		// Проверим наличие настройки для данного типа
		ТекущийТипЛогистик = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов[СтрЗаменить(ТекущаяСтрока, "КонтурЛогистика_", "")];
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТекущийТипЛогистик);
		Если НастройкаКонвертации = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверим наличие документ ссылки в реквизите документ основания
		Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьДокументСсылкаВОснованииПоТипу(ТекущаяСтрока) Тогда
			Продолжить;
		КонецЕсли;
		
		Элементы.ДекорацияДокументСсылкаВОсновании.Заголовок = Элементы.ДекорацияДокументСсылкаВОсновании.Заголовок + "
			| - " + ТекущаяСтрока;
		Элементы.БаннерДокументСсылкаВОсновании.Видимость = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеПоГруппамДоступа()
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	Если ДоступыПользователя.ПолныйДоступ Тогда
		Возврат;
	КонецЕсли;
	
	// Справочники
	ДоступКСправочникам = ДоступыПользователя.ДоступКСправочникам;
	ПереченьДоступныхСправочников = Справочники.КонтурЛогистика_ГруппыДоступа.ПереченьДоступныхСправочников();
	Для Каждого ТекущйиСправочник Из ПереченьДоступныхСправочников Цикл
		
		ТолькоПросмотрЭлементов = ДоступКСправочникам.ТолькоПросмотр.Получить(ТекущйиСправочник);
		СозданиеРедактированиеЭлементов = ДоступКСправочникам.СозданиеРедактирование.Получить(ТекущйиСправочник);
		
		Элементы["ФормаСправочник" + ТекущйиСправочник + "ОткрытьСписок"].Доступность =
			(ТолькоПросмотрЭлементов Или СозданиеРедактированиеЭлементов);
		
	КонецЦикла;
	
	// Механизмы
	ДоступКМеханизмам = ДоступыПользователя.ДоступКМеханизмам;
	
	МеханизмСоответствия = Перечисления.КонтурЛогистика_ВидыМеханизмов.СоответствияНоменклатуры;
	ТолькоПросмотрЭлементов = ДоступКМеханизмам.ТолькоПросмотр.Получить(МеханизмСоответствия);
	СозданиеРедактированиеЭлементов = ДоступКМеханизмам.СозданиеРедактирование.Получить(МеханизмСоответствия);
	Элементы.ФормаРегистрСведенийКонтурЛогистика_БазовыеСоответствияНоменклатурыОткрытьСписок.Доступность =
		(ТолькоПросмотрЭлементов Или СозданиеРедактированиеЭлементов);
	
КонецПроцедуры

&НаСервере
Процедура ПроверкаУстановкиПараметровСеанса()
	
	Попытка
		ПараметрСеанса = ПараметрыСеанса.КонтурЛогистика_ОграничениеДоступаНаУровнеЗаписейВключено;
		Элементы.БаннерНетПараметровСеанса.Видимость = Ложь;
	Исключение
		Элементы.БаннерНетПараметровСеанса.Видимость = Истина;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНетПараметровСеансаНажатие(Элемент)
	
	СсылкаНаСправку = "https://support.kontur.ru/logistika-1s/41553-obnovlenie_modulya#id-Обновлениемодуля-НепосредственноеобновлениеврежимеПодсистемакосновнойконфигурации";
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.РежимЗапускаКлиентскогоПриложения() = РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение Тогда
		ЗапуститьПриложение(СсылкаНаСправку);
	Иначе
		ПерейтиПоНавигационнойСсылке(СсылкаНаСправку);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиСценариеАвтоматическойРаботы(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСчетчикОшибокАвтоматическойРаботы()
	
	ПредставлениеКоличестваОшибок = ПредставлениеКоличестваОшибокАвтоматическойРаботы();
	
	Если ПредставлениеКоличестваОшибок = "" Тогда
		Элементы.ФормаОшибкиСценариеАвтоматическойРаботы.Видимость = Ложь;
	Иначе
		Элементы.ФормаОшибкиСценариеАвтоматическойРаботы.Видимость = Истина;
		Элементы.ФормаОшибкиСценариеАвтоматическойРаботы.Заголовок = ПредставлениеКоличестваОшибок;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеКоличестваОшибокАвтоматическойРаботы()
	
	Возврат РегистрыСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ПредставлениеКоличестваОшибок();
	
КонецФункции

&НаКлиенте
Процедура ПолучитьУведомленияИзСервиса()
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("УчитыватьПоследнююДатуПолучения", Ложь);
	
	НаименованиеФЗ = "Получение уведомлений из сервиса (ТихийРежим)";
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		"КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьУведомленияИзСервиса", ПараметрыМетода,, НаименованиеФЗ);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		КонтурЛогистика_ОбновлениеКлиент.ПроверитьНаличиеУведомлений(ЭтаФорма);
	Иначе
		ИдентификаторФЗ_ПолучитьУведомления = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПолучитьУведомления", 3, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПолучитьУведомления() Экспорт
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаданиеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ПолучитьУведомления);
	
	Если ЗаданиеВыполняется Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПолучитьУведомления", 3, Истина);
	Иначе
		КонтурЛогистика_ОбновлениеКлиент.ПроверитьНаличиеУведомлений(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьУведомления(Команда)
	
	КонтурЛогистика_ОбновлениеКлиент.ОткрытьФормуСпискаУведомленийПользователя(ЭтаФорма);
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Просмотр уведомлений", "Нажать на колокольчик", ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретОткрытияНесколькихЭкземпляров(Отказ)
	
	ОткрытыеОкна = ПолучитьОкна();
	
	Если ОткрытыеОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоРабочихСтолов = 0;
	ОткрытокеОкноРабочегоСтола = Неопределено;
	Для Каждого ТекущееОкно Из ОткрытыеОкна Цикл
		Если ТекущееОкно.Заголовок = Заголовок
			И ТекущееОкно.Содержимое[0].УникальныйИдентификатор <> УникальныйИдентификатор Тогда
			
			КоличествоРабочихСтолов = КоличествоРабочихСтолов + 1;
			ОткрытокеОкноРабочегоСтола = ТекущееОкно;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоРабочихСтолов = 1 Тогда
		Отказ = Истина;
		ОткрытокеОкноРабочегоСтола.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТехническиеКоманды(Команда)
	
	ВидимостьТехническихКоманд = Истина;
	УстановитьВидимостьДоступностьЭлементов();	
	
КонецПроцедуры

#Область ПроверкаСертификатов

&НаКлиенте
Процедура ВыполнитьПроверкуСертификатов()
	
	ВыполнитьПроверкуСертификатовНаСервере();		
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкуСертификатовНаСервере()

	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.СертификатыДляПроверки(ТекПользователь, ТекПользовательЯвляетсяАдминистратором);
	
	КолвоПроблемныхСертификатов = Результат.КолвоПроблемныхСертификатов;
	КолвоПроблемныхМЧД = Результат.КолвоПроблемныхМЧД;
	КолвоНеПрошедшихПроверкуМЧД = Результат.КолвоНеПрошедшихПроверкуМЧД;
	
	Элементы.ПроверитьСертификаты.Заголовок = "";
	
	Если КолвоПроблемныхСертификатов > 0 И КолвоПроблемныхМЧД > 0 Тогда
		
		Элементы.ПроверитьСертификаты.Видимость = Истина;
		Элементы.ПроверитьСертификаты.Заголовок = "Истекает срок действия " 
				+ Строка(КолвоПроблемныхСертификатов) + " " 
				+ ?(КолвоПроблемныхСертификатов = 1, "сертификата", "сертификатов")
				+ " и " + Строка(КолвоПроблемныхМЧД) + " МЧД";
		Элементы.ПроверитьСертификаты.ЦветТекста = Новый Цвет(255, 0, 0);
		
	ИначеЕсли КолвоПроблемныхСертификатов > 0 И КолвоПроблемныхМЧД = 0 Тогда
		
		Элементы.ПроверитьСертификаты.Видимость = Истина;
		Элементы.ПроверитьСертификаты.Заголовок = "Истекает срок действия " 
				+ Строка(КолвоПроблемныхСертификатов) + " " 
				+ ?(КолвоПроблемныхСертификатов = 1, "сертификата", "сертификатов");
		Элементы.ПроверитьСертификаты.ЦветТекста = Новый Цвет(255, 0, 0);
		
	ИначеЕсли КолвоПроблемныхСертификатов = 0 И КолвоПроблемныхМЧД > 0 Тогда
		
		Элементы.ПроверитьСертификаты.Видимость = Истина;
		Элементы.ПроверитьСертификаты.Заголовок = "Истекает срок действия " + Строка(КолвоПроблемныхМЧД) + " МЧД";
		Элементы.ПроверитьСертификаты.ЦветТекста = Новый Цвет(255, 0, 0);
				
	КонецЕсли;
	
	Если КолвоНеПрошедшихПроверкуМЧД > 0 Тогда
		
		Элементы.ПроверитьСертификаты.Видимость = Истина;
		
		Если ЗначениеЗаполнено(Элементы.ПроверитьСертификаты.Заголовок) Тогда
			Элементы.ПроверитьСертификаты.Заголовок = Элементы.ПроверитьСертификаты.Заголовок + " и есть ошибки в " + Строка(КолвоНеПрошедшихПроверкуМЧД) + " МЧД";
		Иначе
			Элементы.ПроверитьСертификаты.Заголовок = Элементы.ПроверитьСертификаты.Заголовок + " Есть ошибки в " + Строка(КолвоНеПрошедшихПроверкуМЧД) + " МЧД";
		КонецЕсли;
		
		Элементы.ПроверитьСертификаты.ЦветТекста = Новый Цвет(255, 0, 0);
		
	КонецЕсли;
	
	Если КолвоПроблемныхСертификатов = 0 И КолвоПроблемныхМЧД = 0 И КолвоНеПрошедшихПроверкуМЧД = 0 Тогда		
		Элементы.ПроверитьСертификаты.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

