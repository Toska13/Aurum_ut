Процедура ОбработчикОбновитьСчетчикиПереходов(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	ОбновитьСчетчикиПереходов();
КонецПроцедуры

&НаКлиенте
Процедура АвтопересчетСтатусаПодсистемы()
	
	ВерсияПодсистемыУстарела();
	ОбновитьРежимВиджетаОбновления();
	ПерерисоватьВиджетОбновления();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРежимВиджетаОбновления()
	
	Если ИдетПроцессОбновленияВерсии() Тогда
		
		РежимВиджетаОбновления = 3;
		
	ИначеЕсли КонтурЛогистика_ОбновлениеВерсииМодуля.ТребуетсяВыполнитьПереходНаНовуюВерсию() Тогда
		
		РежимВиджетаОбновления = 2;
		
	ИначеЕсли ВерсияПодсистемыУстарела Тогда
		
		РежимВиджетаОбновления = 1;
		
	Иначе
		
		РежимВиджетаОбновления = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерерисоватьВиджетОбновления()
	
	Элементы.ГруппаВыполняетсяОбновлениеДанных.Видимость = Ложь;
	
	Если РежимВиджетаОбновления = 1 Тогда
		// есть новая версия и её надо скачать
		
		Элементы.ПодменюОбновитьМодуль.Видимость = Истина;
		Элементы.ФормаОбновление_ЗагрузитьИУстановить.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение();
		Элементы.Обновление_ОткрытьФормуОбновленияДанных.Видимость = Ложь;
		
	ИначеЕсли РежимВиджетаОбновления = 2 Тогда
		// установлена последняя версия но надо обновтиь данные
		
		Элементы.ПодменюОбновитьМодуль.Видимость = Ложь;
		Элементы.Обновление_ОткрытьФормуОбновленияДанных.Видимость = Истина;
		
	ИначеЕсли РежимВиджетаОбновления = 3 Тогда
		// все ок
		
		Элементы.ПодменюОбновитьМодуль.Видимость = Ложь;
		Элементы.Обновление_ОткрытьФормуОбновленияДанных.Видимость = Ложь;
		
	Иначе
		
		Элементы.Обновление_ОткрытьФормуОбновленияДанных.Видимость = Ложь;
		Элементы.ПодменюОбновитьМодуль.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВерсияПодсистемыУстарела()
	
	ВерсияПодсистемыУстарела = КонтурЛогистика_ОбновлениеКлиент.ПроверяемаяВерсияНовееУстановленной(
									ВерсияПодсистемыУстановленная, 
									ВерсияПодсистемыДоступная);
	
КонецПроцедуры

