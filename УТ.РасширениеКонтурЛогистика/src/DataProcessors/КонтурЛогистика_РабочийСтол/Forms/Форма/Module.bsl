&НаКлиенте
Процедура НачатьОбновлениеРасширенияQR_МП_УАТ()
	
	Если ЗначениеЗаполнено(ИдентификаторФЗ_ПроверитьОбновление) Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_ПередОбновлениемQR", 1, Истина);
	Иначе
		ОбновитьРасширениеQR_МП_УАТ();
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьОбновления_ПередОбновлениемQR() Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен()
		И КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
			ИдентификаторФЗ_ПроверитьОбновление) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_ПередОбновлениемQR", 2, Истина);
		
	Иначе
		
		ОбновитьРасширениеQR_МП_УАТ();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРасширениеQR_МП_УАТ()
		
	РезультатЗапуска = КонтурЛогистика_ОбновлениеСервер.ПроверитьОбновления(
		АдресВХранилище_ПроверитьОбновлениеQR, "QR_МП_УАТ", УникальныйИдентификатор, Истина);
				
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторФЗ_ПроверитьОбновлениеQR = РезультатЗапуска.ИдентификаторЗадания;
	
	Если ЗначениеЗаполнено(ИдентификаторФЗ_ПроверитьОбновлениеQR) Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_QR", 1, Истина);
	Иначе
		ЗаполнитьДанныеОбОбновленииНаФормеИзХранилищаQR(
			АдресВХранилище_ПроверитьОбновлениеQR, ИдентификаторФЗ_ПроверитьОбновлениеQR,
			АдресВХранилище_ЗагрузитьОбновлениеQR, ИдентификаторФЗ_ЗагрузитьОбновлениеQR);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьОбновления_QR() Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен()
		И КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
			ИдентификаторФЗ_ПроверитьОбновлениеQR) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_QR", 2, Истина);
		
	Иначе
		
		ЗаполнитьДанныеОбОбновленииНаФормеИзХранилищаQR(
			АдресВХранилище_ПроверитьОбновлениеQR, ИдентификаторФЗ_ПроверитьОбновлениеQR,
			АдресВХранилище_ЗагрузитьОбновлениеQR, ИдентификаторФЗ_ЗагрузитьОбновлениеQR);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеОбОбновленииНаФормеИзХранилищаQR(АдресВХранилище_Проверить, ИдентификаторФЗ_Проверить, АдресВХранилище_Загрузить, ИдентификаторФЗ_Загрузить)
	
	СтруктураОбновленияВерсии = ПолучитьИзВременногоХранилища(АдресВХранилище_Проверить);
	
	Если СтруктураОбновленияВерсии = Неопределено Тогда
		
	Иначе
		
		ИдентификаторФЗ_Проверить = "";
		
		Если Не СтруктураОбновленияВерсии.Успешно Тогда
			
			Если ЗначениеЗаполнено(СтруктураОбновленияВерсии.Ошибка) Тогда
				
				СообщениеОбОшибке = Новый СообщениеПользователю();
				СообщениеОбОшибке.Текст = СтруктураОбновленияВерсии.Ошибка;
				СообщениеОбОшибке.Сообщить();
				
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(СтруктураОбновленияВерсии.СсылкаНаЗагрузку) Тогда
				НачатьЗагрузкуОбновленияQR(АдресВХранилище_Загрузить, ИдентификаторФЗ_Загрузить, СтруктураОбновленияВерсии.СсылкаНаЗагрузку);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуОбновленияQR(Адрес, ИдентификаторФЗ, СсылкаНаЗагрузку)
		
	Адрес = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("СсылкаНаЗагрузку", СсылкаНаЗагрузку);
	
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьЗагрузкуДанных(
		Адрес, ПараметрыФоновогоЗадания);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		УстановитьОбновлениеПослеЗагрузки_QR();
	Иначе
		ИдентификаторФЗ = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление_QR", 1, Истина);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ЗагрузитьОбновление_QR() Экспорт
	
	Если КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ЗагрузитьОбновлениеQR) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление_QR", 2, Истина);
	Иначе
		УстановитьОбновлениеПослеЗагрузки_QR();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбновлениеПослеЗагрузки_QR()
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ОпределитьКонфигурацию();
	Успех = КонтурЛогистика_ОбновлениеСервер.УстановитьОбновление(АдресВХранилище_ЗагрузитьОбновлениеQR, ИмяКонфигурации1С, "QR_МП_УАТ");
	
КонецПроцедуры

#КонецОбласти

#Область СвязиДокументов

&НаКлиенте
Процедура ОткрытьЗадачи_СД(Команда)
	
	Начало = Найти(Команда.Имя, "__");
	Если Начало = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Остаток = Прав(Команда.Имя, СтрДлина(Команда.Имя) - Начало - 1);
	
	Серединка = Найти(Остаток, "__");
	Если Серединка = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокументаОсновной = ТипЛогистическихДокументовСсылкаПоИмени(Лев(Остаток, Серединка - 1));
	ТипДокументаПодчиненный = ТипЛогистическихДокументовСсылкаПоИмени(Прав(Остаток, СтрДлина(Остаток) - Серединка - 1));
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Период", Период);
	ПараметрыОткрытия.Вставить("ОтборСтатус", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыСвязейДокументов.ВОчереди"));
	ПараметрыОткрытия.Вставить("ОтборТипДокументаОсновной", ТипДокументаОсновной);
	ПараметрыОткрытия.Вставить("ОтборТипДокументаПодчиненный", ТипДокументаПодчиненный);
	ПараметрыОткрытия.Вставить("ОткрытСРабочегоСтола");
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_СвязиДокументов.ФормаСписка", ПараметрыОткрытия,
		ЭтаФорма,,,, РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипЛогистическихДокументовСсылкаПоИмени(ИмяЭлемента)
	
	Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СсылкаПоИмени(ИмяЭлемента);
	
КонецФункции

&НаСервере
Процедура ДобавитьРеквизитыСвязейДокументов()
	
	ИспользуемыеТитулы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьМассивТитуловОформляемыхТекущимПользователем();
	
	ИспользуемыеСвязиДокументовПоТитулам = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СвязиДокументовПоТитулам();
	
	Для Каждого ТекущиеСвязи Из ИспользуемыеСвязиДокументовПоТитулам Цикл
		
		ТекущаяСвязь = ТекущиеСвязи.Значение[0];
		
		// Ищем родителя
		ИмяРодителя = "Пункт_" + ТекущаяСвязь.ИмяТипаДокументаОсновной;
		ГруппаРодитель = Элементы.Найти(ИмяРодителя);
		Если ГруппаРодитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Сбросим ширину стыковочной группы для уменьшения размера
		ИмяГруппыЗадачОснования = "Задачи_" + ТекущаяСвязь.ИмяТипаДокументаОсновной;
		ГруппаЗадачОснования = Элементы.Найти(ИмяГруппыЗадачОснования);
		Если ГруппаЗадачОснования = Неопределено Тогда
			ГруппаЗадачОснования = Элементы.Найти(СтрЗаменить(ИмяГруппыЗадачОснования, "ТрН", "ЭТРН"));
			Если ГруппаЗадачОснования <> Неопределено Тогда
				ГруппаЗадачОснования.Ширина = 0;
			КонецЕсли;
		Иначе
			ГруппаЗадачОснования.Ширина = 0;
		КонецЕсли;
		
		// Если несколько связей для одного типа, то объединяем их по вертикали
		ГруппаОбъединитель = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(
			ЭтаФорма, "ГруппаОбъединительДокументов_" + ТекущаяСвязь.ИмяТипаДокументаОсновной, ГруппаРодитель, 1);
		
		Для Каждого ТекущаяСвязь Из ТекущиеСвязи.Значение Цикл
			ПостфиксИмениЭлементов = ТекущаяСвязь.ИмяТипаДокументаОсновной + "_" + ТекущаяСвязь.ИмяТипаДокументаПодчиненный;
			ДобавитьРеквизитыСвязиДокумента(ТекущаяСвязь, ГруппаОбъединитель, ПостфиксИмениЭлементов);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыСвязиДокумента(ТекущаяСвязь, ГруппаРодитель, ПостфиксИмениЭлементов)
	
	// Создаем команду для открытия списка задач
	ИмяКоманды = "ОткрытьЗадачи_СД__" + ТекущаяСвязь.ИмяТипаДокументаОсновной + "__" + ТекущаяСвязь.ИмяТипаДокументаПодчиненный;
	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		КомандаОткрытьЗадачи = Команды.Добавить(ИмяКоманды);
		КомандаОткрытьЗадачи.Действие = "ОткрытьЗадачи_СД";
	КонецЕсли;
	
	// Группа подчиненного документа
	ГлавнаяГруппа = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(
		ЭтаФорма, "ГруппаСвязиДокументов_" + ПостфиксИмениЭлементов, ГруппаРодитель, 3);
	
	// Декарация стрелочка
	СвойстваДекарации = СвойстваДекарации(ВидДекорацииФормы.Картинка, 1, 5, БиблиотекаКартинок.КонтурЛогистика_ТреугольникВправо);
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
		ЭтаФорма, "СвязиДокументов_Картинка_" + ПостфиксИмениЭлементов, ГлавнаяГруппа, СвойстваДекарации);
	
	// Группа задач
	ЗаголовокГруппы = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПредставлениеТипа(ТекущаяСвязь.ТипДокументаПодчиненный);
	СвойстваГруппы = Новый Структура;
	СвойстваГруппы.Вставить("Заголовок", ЗаголовокГруппы);
	СвойстваГруппы.Вставить("ОтображатьЗаголовок", Истина);
	СвойстваГруппы.Вставить("ЦветТекстаЗаголовка", ЦветаСтиля.ЦветТекстаФормы);
	СвойстваГруппы.Вставить("Высота", 2);
	СвойстваГруппы.Вставить("РастягиватьПоГоризонтали", Ложь);
	СвойстваГруппы.Вставить("ГоризонтальноеПоложениеПодчиненных", ГоризонтальноеПоложениеЭлемента.Лево);
	
	ГруппаЗадач = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(
		ЭтаФорма, "СвязиДокументов_Задачи_" + ПостфиксИмениЭлементов, ГлавнаяГруппа, 3,,, СвойстваГруппы);
	
	// Растяжитель задач
	СвойстваДекарации = СвойстваДекарации(ВидДекорацииФормы.Надпись, 1, 1);
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
		ЭтаФорма, "СвязиДокументов_РастяжительЗадач1_" + ПостфиксИмениЭлементов, ГруппаЗадач, СвойстваДекарации);
	
	// Команда открытия задач
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(
		ЭтаФорма, "СвязиДокументов_ОткрытьЗадачи_" + ПостфиксИмениЭлементов, ГруппаЗадач, "Оформить", ИмяКоманды);
	
	// Другой пользователь
	СвойстваДекарации = СвойстваДекарации(ВидДекорацииФормы.Надпись, 0, 0,, "другой пользователь");
	ЭлементДругойПользователь = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
		ЭтаФорма, "СвязиДокументов_ДругойПользователь_" + ПостфиксИмениЭлементов, ГруппаЗадач, СвойстваДекарации);
	ЭлементДругойПользователь.Видимость = Ложь;
	ЭлементДругойПользователь.Доступность = Ложь;
	
	// Растяжитель задач
	СвойстваДекарации = СвойстваДекарации(ВидДекорацииФормы.Надпись, 1, 1);
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
		ЭтаФорма, "СвязиДокументов_РастяжительЗадач2_" + ПостфиксИмениЭлементов, ГлавнаяГруппа, СвойстваДекарации);
	
КонецПроцедуры

&НаСервере
Функция СвойстваДекарации(Вид, Высота, Ширина, Картинка = Неопределено, Заголовок = Неопределено)
	
	СвойстваДекарации = Новый Структура;
	СвойстваДекарации.Вставить("Вид", Вид);
	СвойстваДекарации.Вставить("Высота", Высота);
	СвойстваДекарации.Вставить("Ширина", Ширина);
	
	Если Вид = ВидДекорацииФормы.Надпись Тогда
		СвойстваДекарации.Вставить("АвтоМаксимальнаяШирина", Ложь);
	Иначе
		СвойстваДекарации.Вставить("Картинка", Картинка);
	КонецЕсли;
	
	Если Заголовок <> Неопределено Тогда
		СвойстваДекарации.Вставить("Заголовок", Заголовок);
	КонецЕсли;
	
	Возврат СвойстваДекарации;
	
КонецФункции

