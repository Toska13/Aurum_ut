&НаКлиенте
Процедура ВключитьФорматЭПЛ502(Команда)
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Включить новый формат");	
	Кнопки.Добавить("Отменить");
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Добавим отображение нового формата ЭПЛ 5.02 (старый 5.01 не отключим).
	|Вы сможете проверить отправку в новом формате заранее до обязательности.
	|Продолжить?",
		Кнопки, "Подтвердите переход",, ЭтаФорма, "ОбработчикВключенияФорматаЭПЛ502");
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработчикВключенияФорматаЭПЛ502(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = "Отменить" Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеНастройкиСервер("ИспользуетсяПутевойЛист_5_02", Истина);
		
	Оповестить("ОбновитьРабочийСтол");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗначениеНастройкиСервер(ИмяПредопределенного, УстанавливаемоеЗначение)
	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяПредопределенного, УстанавливаемоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура РабочееМестоПЛ_5_02(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Период", Период);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Обработка.КонтурЛогистика_РабочееМестоПутевойЛист_5_02.Форма.Форма", ПараметрыФормы,,,,, РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНастройкиЭлементовДляЭПЛ_5_02()
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
	
		Элементы.ЗадачиПЛ.Ширина = 40;
		Элементы.ЗаголовокПЛОФ.Ширина = 40;
		Элементы.ЗадачиПЛ_5_02.Ширина = 40;
		Элементы.ЗаголовокПЛОФ_5_02.Ширина = 40;
		
		Если ИспользуетсяПутевойЛист И ИспользуетсяПутевойЛист_5_02 Тогда
			Элементы.ЗаголовокПЛОФ.Высота = 5;
			Элементы.ЗаголовокПЛОФ_5_02.Высота = 5;
		Иначе
			Элементы.ЗаголовокПЛОФ.Высота = 2;
			Элементы.ЗаголовокПЛОФ_5_02.Высота = 2;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти