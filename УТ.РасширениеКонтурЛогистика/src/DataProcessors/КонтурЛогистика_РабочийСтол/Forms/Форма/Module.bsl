&НаКлиенте
Процедура Обновление_ПроверитьОбновление(Команда = Неопределено)
	
	ОбновитьФорму_ЗапущенаПроверкаОбновления(Истина);
	
	Элементы.ЛоадерПроверитьОбновление.Видимость = Истина;
	
	АдресВХранилище_ПроверитьОбновление = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	
	ПараметрыФоновогоЗадания.Вставить("НомерВерсии", ВерсияПодсистемыУстановленная);
	
	ТихийРежим = Истина;
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьПолучениеСведенийОбОбновлении(
		АдресВХранилище_ПроверитьОбновление, ПараметрыФоновогоЗадания, ТихийРежим);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища();
	Иначе
		ИдентификаторФЗ_ПроверитьОбновление = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_Загрузить(Команда)
	
	Если ЗначениеЗаполнено(ДоступнаяВерсияСсылкаНаЗагрузку) Тогда

		СтруктураОбновления = Новый Структура("СсылкаНаЗагрузку, НомерВерсии", 
										ДоступнаяВерсияСсылкаНаЗагрузку, ВерсияПодсистемыДоступная);

		ВыбратьКаталогИЗагрузитьОбновлениеПодсистемы(СтруктураОбновления);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ЗагрузитьИУстановить(Команда)
	
	Результат = КонтурЛогистика_ОбновлениеСервер.ХэшСуммаТекущегоРасширенияИЭталонногоОдинаковы(ВерсияПодсистемыУстановленная);
	
	Если Результат.Успешно Тогда
		
		Если Результат.ХэшСуммыОдинаковы Тогда
			
			// Расширение не менялось. Приступим к установке нового.
			ОповещениеВопросУстановки = Новый ОписаниеОповещения("Обновление_ЗагрузитьИУстановитьВопрос", ЭтаФорма);
			
			ТекстВопроса = "Вы уверены, что хотите установить обновления подсистемы Контур.Логистика?
				|После установки обновления 1С будет закрыта!";
			
			ПоказатьВопрос(ОповещениеВопросУстановки, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Да);
			
		Иначе
			
			// Расшерение было изменено. Автоматически обновление не возможно.
			ТекстСообщения = "Модуль был изменен. Автоматическое обновление не доступно.";
			
			Сообщить(ТекстСообщения);
			
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = "При получении данных версии подсистемы возникла ошибка:
			|" + Результат.ТекстОшибки;
		
		Сообщить(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ЗагрузитьИУстановитьВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// Закроем открытые окна
	Попытка
		Закрыть();
	Исключение
		// Ничего не делаем
	КонецПопытки;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.ОбновитьМодульДоПоследнейВерсии(ДоступнаяВерсияСсылкаНаЗагрузку);
	
	Если Результат Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаКоманды_ПроверитьОбновления

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьОбновления() Экспорт

	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен() И
		КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ПроверитьОбновление, Элементы.ЛоадерПроверитьОбновление) Тогда

		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 2, Истина);

	Иначе

		ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища()
	
	Перем СообщениеОбОшибке, СтруктураОбновленияВерсии;
	
	СтруктураОбновленияВерсии = ПолучитьИзВременногоХранилища(АдресВХранилище_ПроверитьОбновление);
	
	Если СтруктураОбновленияВерсии = Неопределено Тогда
		
		// todo метрика
		
		ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь);
		
	Иначе
		
		Если НЕ СтруктураОбновленияВерсии.Успешно Тогда
			
			Если ЗначениеЗаполнено(СтруктураОбновленияВерсии.Ошибка) Тогда
				
				СообщениеОбОшибке = Новый СообщениеПользователю();
				СообщениеОбОшибке.Текст = СтруктураОбновленияВерсии.Ошибка;
				СообщениеОбОшибке.Сообщить();
				
			КонецЕсли;
			
		Иначе
			
			ОбновитьРеквизитыФормыПоСтруктуреОбновленияВерсии(СтруктураОбновленияВерсии);
			ОбновитьРежимВиджетаОбновления();
			ПерерисоватьВиджетОбновления();
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеквизитыФормыПоСтруктуреОбновленияВерсии(СтруктураОбновленияВерсии)
	
	ВерсияПодсистемыДоступная = СтруктураОбновленияВерсии.НомерВерсии;
	ДатаВыходаВерсии = СтруктураОбновленияВерсии.ДатаВыхода;
	ДоступнаяВерсияСсылкаНаЗагрузку = СтруктураОбновленияВерсии.СсылкаНаЗагрузку;
	ДоступнаяВерсияСсылкаНаОписание = СтруктураОбновленияВерсии.СсылкаНаОписание;
	
	ВерсияПодсистемыУстарела();

	Если ВерсияПодсистемыУстарела Тогда

		ДатаВыходаВерсииМассивом = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ДатаВыходаВерсии, ".");

		ДоступнаяВерсияДатаВыхода = Дата(ДатаВыходаВерсииМассивом[2], ДатаВыходаВерсииМассивом[1], ДатаВыходаВерсииМассивом[0]);

	Иначе

		ДоступнаяВерсияДатаВыхода = Неопределено;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму_ЗапущенаПроверкаОбновления(ПроверкаВыполняется)
	
	Элементы.Обновление_ПроверитьОбновление.Видимость       = НЕ ПроверкаВыполняется;
	Элементы.ЛоадерПроверитьОбновление.Видимость            = ПроверкаВыполняется;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаКоманды_ЗагрузитьОбновление

&НаКлиенте
Процедура ВыбратьКаталогИЗагрузитьОбновлениеПодсистемы(СтруктураОбновления)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ЗагрузитьОбновлениеПодсистемыВКаталог", 
		ЭтаФорма, 
		РежимДиалогаВыбораФайла.ВыборКаталога, 
		"Выберите каталог хранения обновлений", 
		КаталогЗагрузкиОбновлений, 
		Неопределено, 
		Ложь, 
		"", 
		СтруктураОбновления);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбновлениеПодсистемыВКаталог(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		КаталогОбновленияВерсии = СформироватьНазваниеКаталогаВерсий(Результат, ДополнительныеПараметры);
		
		СоздатьКаталогВерсии(КаталогОбновленияВерсии);
		
		СсылкаНаЗагрузку = ДополнительныеПараметры.СсылкаНаЗагрузку;
		
		НачатьЗагрузкуОбновления(СсылкаНаЗагрузку);

	Иначе
		
		СообщениеНеВыбранКаталог = Новый СообщениеПользователю();
		СообщениеНеВыбранКаталог.Текст = "Не выбран каталог загрузки архива версии. Загрузка остановлена.";
		СообщениеНеВыбранКаталог.Сообщить();
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуОбновления(СсылкаНаЗагрузку)
	
	Элементы.ЛоадерЗагрузкаОбновления.Видимость = Истина;
	
	АдресВХранилище_ЗагрузитьОбновление = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	
	ПараметрыФоновогоЗадания.Вставить("СсылкаНаЗагрузку", СсылкаНаЗагрузку);
	
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьЗагрузкуДанных(
		АдресВХранилище_ЗагрузитьОбновление, ПараметрыФоновогоЗадания);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		ЗаполнитьЗагруженныеДанныеОбновленииНаФормеИзХранилища();
	Иначе
		ИдентификаторФЗ_ЗагрузитьОбновление = РезультатЗапуска.ИдентификаторЗадания;
		
		Если Не ИдентификаторФЗ_ЗагрузитьОбновление = Неопределено Тогда
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление", 1, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ЗагрузитьОбновление() Экспорт
	
	Если КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ЗагрузитьОбновление, Элементы.ЛоадерЗагрузкаОбновления) Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление", 2, Истина);
	Иначе
		ЗаполнитьЗагруженныеДанныеОбновленииНаФормеИзХранилища();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗагруженныеДанныеОбновленииНаФормеИзХранилища()
	
	ДвоичныеДанныеОбновленияПодсистемы = ПолучитьИзВременногоХранилища(АдресВХранилище_ЗагрузитьОбновление);
	
	Если ДвоичныеДанныеОбновленияПодсистемы = Неопределено Тогда
		// todo добавить метрику
	Иначе
		
		АрхивВерсии = КаталогОбновленияВерсии + "\update.zip";
		
		ДвоичныеДанныеОбновленияПодсистемы.Записать(АрхивВерсии);
		
		РаспаковатьZipАрхив(АрхивВерсии, КаталогОбновленияВерсии);
		
		ЗапуститьПриложение(КаталогОбновленияВерсии);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспаковатьZipАрхив(ПутьКАрхиву, КаталогРаспаковки) Экспорт
	
	Архив = Новый ЧтениеZipФайла(ПутьКАрхиву);
	
	Архив.ИзвлечьВсе(КаталогРаспаковки);
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьНазваниеКаталогаВерсий(Результат, ДополнительныеПараметры)
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		КаталогЗагрузкиОбновлений = Результат;
	Иначе
		КаталогЗагрузкиОбновлений = Результат[0];
	КонецЕсли;

	НомерВерсии = ДополнительныеПараметры.НомерВерсии;
	
	Возврат КаталогЗагрузкиОбновлений + "\" + НомерВерсии;
	
КонецФункции

&НаКлиенте
Процедура СоздатьКаталогВерсии(СоздаваемыйКаталог)
	
	КаталогВерсии = Новый Файл(СоздаваемыйКаталог);

	Если НЕ КаталогВерсии.Существует() Тогда

		СоздатьКаталог(СоздаваемыйКаталог);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДатаГраницыСинхронизации

&НаКлиенте
Процедура ОткрытьОрганизациюДляОрганизации(Команда)
	
	ПараметрыФормы = Новый Структура("Ключ", ОрганизацияГраницыСинхронизации);

	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",
		ПараметрыФормы ,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикОбновитьСчетчикиПереходов",,
		РежимОткрытияОкнаФормы.Независимый, 
		Истина);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьСчетчикиПереходов(Команда = Неопределено, ТихийРежим = Ложь)
	
	АдресВХранилище_СчетчикиПереходов = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("Период", Период);
	
	РезультатЗапуска = НачатьРасчетСчетчиков(АдресВХранилище_СчетчикиПереходов, ПараметрыФоновогоЗадания, ТихийРежим);
	
	Если РезультатЗапуска <> Неопределено Тогда
		
		Если РезультатЗапуска.Статус = "Выполнено" Тогда
			ЗаполнитьДанныеСчетчиковПереходовИзХранилища();
		Иначе
			ИдентификаторФЗ_СчетчикиПереходов = РезультатЗапуска.ИдентификаторЗадания;
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьСчетчикиПереходов", 0.1, Истина);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция НачатьРасчетСчетчиков(АдресХранилища, ПараметрыФоновогоЗадания = Неопределено, ТихийРежим = Ложь)
	
	НаименованиеФЗ = "Расчет индикаторов системы";
	Если ТихийРежим Тогда
		НаименованиеФЗ = НаименованиеФЗ + "(ТихийРежим)";
	КонецЕсли;
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		"КонтурЛогистика_ДлительныеОперацииСервер.РассчитатьСчетчикиПереходов",
		ПараметрыФоновогоЗадания,
		,
		НаименованиеФЗ,
		АдресХранилища);
		
	Элементы.ЛоадерСчетчикиПереходов.Видимость = РезультатЗапуска.Статус = "Выполняется";
		
	Если РезультатЗапуска.Статус = "Выполняется" ИЛИ РезультатЗапуска.Статус = "Выполнено" Тогда
		
		Возврат РезультатЗапуска;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьСчетчикиПереходов() Экспорт
	
	Если КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_СчетчикиПереходов, Элементы.ЛоадерСчетчикиПереходов) Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьСчетчикиПереходов", 1, Истина);
	Иначе
		ЗаполнитьДанныеСчетчиковПереходовИзХранилища();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеСчетчиковПереходовИзХранилища()
	
	Перем СообщениеОбОшибке, СчетчикиПереходаСтруктура;
	
	СчетчикиПереходаСтруктура = ПолучитьИзВременногоХранилища(АдресВХранилище_СчетчикиПереходов);
	
	Если СчетчикиПереходаСтруктура = Неопределено Тогда
		
		// TODO написать метрику
		
	Иначе
		
		Если ТипЗнч(СчетчикиПереходаСтруктура) <> Тип("Структура") Тогда
			
			СообщениеОбОшибке = Новый СообщениеПользователю();
			СообщениеОбОшибке.Текст = "Ошибка рассчета индикаторов";
			СообщениеОбОшибке.Сообщить();
			
		Иначе
			
			// разложить счетчики по форме
			ДанныеГраницы = СчетчикиПереходаСтруктура.ДанныеГраницы;
			ПредставлениеДанных = КонтурЛогистика_ОбщегоНазначенияКлиент.ПредставлениеДанныхГраницыСинхронизации(ДанныеГраницы);
			ЗаполнитьЗначенияСвойств(Элементы.СостояниеОбмена, ПредставлениеДанных);
			
			Для Каждого Счетчик Из СчетчикиПереходаСтруктура Цикл
				Если Счетчик.Ключ = "ДанныеГраницы" Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(Счетчик.Значение) = Тип("Структура")
					И Счетчик.Значение.Задач <> Неопределено Тогда
					
					ЗаполнитьДанныеСчетчикаЭлемента(Счетчик.Ключ, Счетчик.Значение, Ложь);
					
					СчетчикСвязиДокументов = Счетчик.Значение.СвязиДокументов;
					Если СчетчикСвязиДокументов <> Неопределено Тогда
						Для Каждого СвязьДокументов Из СчетчикСвязиДокументов Цикл
							СчетчикКлюч = СвязьДокументов.ИмяТипаДокументаОсновной + "_" + СвязьДокументов.ИмяТипаДокументаПодчиненный;
							ЗаполнитьДанныеСчетчикаЭлемента(СчетчикКлюч, СвязьДокументов, Истина);
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеСчетчикаЭлемента(СчетчикКлюч, СчетчикДанные, ЭтоСвязиДокументов)
	
	Если ЭтоСвязиДокументов Тогда
		
		ИмяЭлементаКнопка = "СвязиДокументов_ОткрытьЗадачи_" + СчетчикКлюч;
		ИмяЭлементаПункт = "СвязиДокументов_Картинка_" + СчетчикКлюч;
		
	Иначе
		
		ИмяЭлементаКнопка = "ОткрытьЗадачи_" + СчетчикКлюч;
		ИмяЭлементаПункт = "Картинка_" + СчетчикКлюч;
		
		Если СчетчикКлюч = "ТрН_Титул13" Тогда 
			ИмяЭлементаКнопка = "ОткрытьЗадачи_ТРН_Титул3Переадресовки";
		ИначеЕсли СчетчикКлюч = "ТрН_Титул14" Тогда 
			ИмяЭлементаКнопка = "ОткрытьЗадачи_ТРН_Титул4ПоВозврату";
		ИначеЕсли СчетчикКлюч = "ТрН_Титул7" Тогда 
			ИмяЭлементаКнопка = "ОткрытьЗадачи_ТРН_Титул7";
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлементКнопкаПерехода = Элементы.Найти(ИмяЭлементаКнопка);
	ЭлементПункт = Элементы.Найти(ИмяЭлементаПункт);
	
	Если ЭлементКнопкаПерехода = Неопределено Или ЭлементПункт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СчетчикДанные.Задач = 0 И СчетчикДанные.Ошибок = 0 Тогда
		
		Если СчетчикДанные.ОшибкаЗапроса Тогда
			ПредставлениеЗадач = "ошибка расчета";
		Иначе
			ПредставлениеЗадач = "нет задач";
		КонецЕсли;
		
		ЭлементКнопкаПерехода.Вид = ВидКнопкиФормы.Гиперссылка;
		ЭлементКнопкаПерехода.ЦветТекста = Новый Цвет(160, 160, 160);
		
		Если Не ЭтоСвязиДокументов Тогда
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_Пункт;
			
			Если СчетчикКлюч = "ТрН_Титул13"
				Или СчетчикКлюч = "ТрН_Титул14"
				Или СчетчикКлюч = "ТрН_Титул14"
				Или СчетчикКлюч = "ПЛ_Титул6" Тогда
				ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктНеобязательныйНаш;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ПредставлениеЗадач = "" + Число(СчетчикДанные.Задач) + " "
			+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьЗадачиВСклонении(Число(СчетчикДанные.Задач));
		ЭлементКнопкаПерехода.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		ЭлементКнопкаПерехода.ЦветТекста = Новый Цвет(51, 51, 51);
		
		Если Не ЭтоСвязиДокументов Тогда
			ЭлементПункт.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктВыполнен;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлементКнопкаПерехода.Заголовок = ПредставлениеЗадач;
	
	Если Число(СчетчикДанные.Ошибок) > 0 Тогда
		ПредставлениеОшибок = "" + Число(СчетчикДанные.Ошибок) + " "
			+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьОшибкиВСклонении(Число(СчетчикДанные.Ошибок));
		
		Если СчетчикДанные.Задач = 0 Тогда 
			ЭлементКнопкаПерехода.Заголовок = ПредставлениеОшибок;
		Иначе
			ЭлементКнопкаПерехода.Заголовок = ЭлементКнопкаПерехода.Заголовок + ", " + ПредставлениеОшибок;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

