		Результат = МетодСервера(Истина, "ОбработкаОбъект().Метрика_НазваниеКатегории");
		
		Кэш_Поместить("Метрика_НазваниеКатегорииНаКлиенте", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

