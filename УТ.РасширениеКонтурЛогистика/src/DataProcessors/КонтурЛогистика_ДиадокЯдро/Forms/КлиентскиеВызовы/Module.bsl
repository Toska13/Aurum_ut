&НаКлиенте
Процедура Метрика_ДобавитьСтатистику_ПоКонтексту(Категория, Действие, Метка = Неопределено, ДопПеременные = Неопределено) Экспорт
	
	Если Не ИспользоватьМетрики() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиКонтекста	= КонтекстСеанса_СтрокиКонтекста();
	
	Для Каждого Элемент Из СтрокиКонтекста Цикл
		
		СтрокаКонтекста = Элемент.Значение;
		
		Переменные = Новый Соответствие;
		Переменные.Вставить("BoxID", АдресЯщикаВИдентификатор(СтрокаКонтекста.BoxId));
		
		Если ДопПеременные <> Неопределено Тогда
			Для каждого Переменная Из ДопПеременные Цикл
				Переменные.Вставить(Переменная.Ключ, Переменная.Значение);			
			КонецЦикла; 
		КонецЕсли;	
		
		ИдентификаторБазы1С = ОбщиеНастройки_Прочитать("ИдентификаторБазы1С");
		Переменные.Вставить("BaseID", ИдентификаторБазы1С);

		Метрика_ЗаписатьСтатистику(Категория, Действие, Метка, Переменные);
		
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура Метрика_ДобавитьСтатистику_СУчетомЗаполненияКонтекста(КатегорияМетрики, ДействиеМетрики, Метка = Неопределено, ДопПеременные = Неопределено) Экспорт

	КонтекстСеансаЗаполнен = КонтекстСеанса_ЕстьСтроки();
	Если КонтекстСеансаЗаполнен Тогда
		Метрика_ДобавитьСтатистику_ПоКонтексту(КатегорияМетрики, ДействиеМетрики, Метка, ДопПеременные);
	Иначе
		Метрика_ДобавитьСтатистику_ДляОрганизации("", КатегорияМетрики, ДействиеМетрики, Метка, ДопПеременные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Метрика_ДобавитьСтатистику_МассовоеДействиеПоДокументам(Категория, Действие, ДокументыДляОбработки) Экспорт
	
	Если Не ИспользоватьМетрики() Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеДокументов = Новый Соответствие;
	
	СоответствиеОрганизаций1С = Новый Соответствие;
	
	Для Каждого Документ Из ДокументыДляОбработки Цикл
		
		// может прийти как массив строк списка, так и массив документов
		Если Документ.Свойство("Идентификаторы") Тогда
			BoxId = Документ.Идентификаторы.BoxId;
		Иначе
			
			Организация1С	= Документ.Организация;
			BoxId			= СоответствиеОрганизаций1С[Организация1С];
			
			Если BoxId = Неопределено Тогда
				
				Идентификаторы			= МетодСервера(Истина, "ОбработкаОбъект().Новый_ИдентификаторыСправочника", Организация1С);
				УчастникДО_Организации	= МетодСервера(Истина, "ОбработкаОбъект().Организации_ЗаполнитьУчастникаДО", Идентификаторы);
				
				BoxId = УчастникДО_Организации.BoxId;
				
				СоответствиеОрганизаций1С.Вставить(Организация1С, BoxId);
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если СоответствиеДокументов[BoxId] = Неопределено Тогда
			СоответствиеДокументов.Вставить(BoxId, 1);
		Иначе
			КоличествоДокументов = СоответствиеДокументов[BoxId];
			СоответствиеДокументов.Вставить(BoxId, КоличествоДокументов + 1);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Элемент Из СоответствиеДокументов Цикл
		
		Переменные = Новый Соответствие;
		Переменные.Вставить("BoxID",					АдресЯщикаВИдентификатор(Элемент.Ключ));
		Переменные.Вставить("Количество документов",	Элемент.Значение);
		
		ИдентификаторБазы1С = ОбщиеНастройки_Прочитать("ИдентификаторБазы1С");
		Переменные.Вставить("BaseID", ИдентификаторБазы1С);

		Метрика_ЗаписатьСтатистику(Категория, Действие, , Переменные);
		
	КонецЦикла;
	
КонецПроцедуры

