	Иначе
		
		ОписаниеФормы	 = ПолученныеФормы_ПрочитатьПоИмениФормы(ФормаМодуля.ИмяФормы);
		Результат		 = СвойствоСтруктуры(ОписаниеФормы, "ИмяМодуля");
		
	КонецЕсли;
	
	Возврат Результат;
	
