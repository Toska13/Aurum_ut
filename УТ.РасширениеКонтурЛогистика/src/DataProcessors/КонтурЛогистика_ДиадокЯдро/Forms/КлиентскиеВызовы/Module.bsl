Функция Подписант_ПредставлениеПодписанта(BoxId) Экспорт
	
	ОтпечатокСертификата	= КонтекстСеанса_Прочитать(BoxId, "ОтпечатокСертификата");
	Результат				= Сертификаты_ПредставлениеПодписанта(ОтпечатокСертификата);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Подписант_ЭтоСотрудникОрганизации(BoxId) Экспорт
	
	Результат = Ложь;
	
	ОтпечатокСертификата	= КонтекстСеанса_Прочитать(BoxId, "ОтпечатокСертификата");
	ДанныеСертификата		= Сертификаты_ДанныеСертификата(ОтпечатокСертификата);
	
	Если ДанныеСертификата <> Неопределено Тогда
		
		Субъект = ДанныеСертификата.Субъект;
		
		Если Субъект.Свойство("ИННЮЛ") Тогда
			ИНН = Субъект.ИННЮЛ;
		ИначеЕсли Субъект.Свойство("ИНН") Тогда
			ИНН = Субъект.ИНН;
		Иначе
			ИНН = "";
		КонецЕсли;
		
		ИНН = ?(Лев(ИНН, 2) = "00", Сред(ИНН, 3), ИНН);
		
		Результат = (СтрДлина(ИНН) = 10);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Документы_ИсторияДО_ЗаполнениеПодписанта(ИсторияДО) Экспорт
	
	Для каждого Событие Из ИсторияДО Цикл
		
		Если ЗначениеЗаполнено(Событие.ДанныеПодписи) Тогда
			
			ДанныеПодписанта = ДанныеПодписантаИзПодписи(Событие.ДанныеПодписи);
			
			Событие.Организация	= ДанныеПодписанта.Организация;
			Событие.Подписант	= ФамилияИО(ДанныеПодписанта.Подписант);
			Событие.Должность	= ДанныеПодписанта.Должность;
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеПодписантаИзПодписи(ДвоичныеДанныеПодписи) Экспорт
	
	Сертификат = ВнешниеСервисы_ПолучитьСертификатИзПодписи(Base64Значение(ДвоичныеДанныеПодписи));
	
	SN	= СвойствоСтруктуры(Сертификат.Субъект, "SN",	"");
	G	= СвойствоСтруктуры(Сертификат.Субъект, "G",	"");
	GN	= СвойствоСтруктуры(Сертификат.Субъект, "GN",	"");
	
	Результат = Новый Структура;
	Результат.Вставить("Организация",	СвойствоСтруктуры(Сертификат.Субъект, "O", ""));
	Результат.Вставить("Подписант", 	СокрЛП(SN + ?(ЗначениеЗаполнено(G), " " + G, "") + ?(ЗначениеЗаполнено(GN), " " + GN, "")));
	Результат.Вставить("Должность",		СвойствоСтруктуры(Сертификат.Субъект, "T", ""));
	
	Возврат Результат;
	
КонецФункции

