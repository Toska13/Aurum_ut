	Результат = ВнешниеСервисы_ПолучитьСертификатИзПодписи(ЗашифрованныеДанные);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьГОСТСертификата(ОтпечатокСертификата) Экспорт 
	
	Попытка
		СвойстваСертификата = ВнешниеСервисы_ПолучитьСертификат(ОтпечатокСертификата);
	Исключение
		
		ВидОперации		 = НСтр("ru = 'Получение сертификата'");
		ТекстОшибки		 = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДопИнформация	 = Общее_ПодставитьПараметрыВСтроку("Отпечаток сертификата: %1", ОтпечатокСертификата);
		
		Ошибка_Обработать(ВидОперации, ТекстОшибки, ДопИнформация);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	OID			= СвойстваСертификата.АлгоритмКлюча.OID;
	Результат	= МетодСервера(Истина, "ОбработкаОбъект().СоответствиеГОСТСертификата_OID")[OID];
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Сертификаты_ПредставлениеПодписанта(ОтпечатокСертификата, ВыводитьОрганизацию = Истина) Экспорт
	
	Результат = "";
	
	СписокСертификатов = Сертификаты_СписокСертификатов();
	
	Для Каждого Сертификат Из СписокСертификатов Цикл
		Если Сертификат.ОтпечатокСертификата = ОтпечатокСертификата Тогда
			
			Если ВыводитьОрганизацию Тогда
				Результат = Результат + Сертификат.Организация + ", ";
			КонецЕсли;
			
			Результат = Результат + Сертификат.Наименование;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

