&НаКлиенте
Функция ОнлайнСчета_ПолучитьСписокСчетов(ФормаВладелец)
	
	Модуль_ОнлайнСчета 		= Модуль_ОнлайнСчета(ЭтаФорма);
	ФормаМодуляОнлайнСчета 	= Модуль_ОнлайнСчета.ПолучитьФормуСчетовНаОплату(ФормаВладелец);
	
	ФормаМодуляОнлайнСчета.ЗаполнитьОнлайнСчетаПоОрганизациям();
	
	СчетаНаОплатуСервиса 	= ФормаМодуляОнлайнСчета.СчетаНаОплатуСервиса;
	ФормаМодуляОнлайнСчета 	= Неопределено;
	
	Возврат СчетаНаОплатуСервиса;
	
КонецФункции

&НаКлиенте
Процедура Метрика_ДобавитьСтатистику_ОнлайнСчетаПослеАвторизации(Форма) Экспорт
	
	Если Не ИспользоватьМетрики() Тогда
		Возврат;
	КонецЕсли;
	
	ОнлайнСчетаОрганизаций = ОнлайнСчета_ПолучитьСписокСчетов(Форма);
	
	Категория	 = "Онлайн счета";
	Действие	 = "Авторизация";
	Метка		 = "Продление обслуживания";
		
	Для Каждого Организация Из ОнлайнСчетаОрганизаций Цикл
		
		BoxID = АдресЯщикаВИдентификатор(Организация.BoxId);
		
		Для Каждого ОписаниеСчета Из Организация.МассивСчетов Цикл
			
			AccountId			= ОписаниеСчета.ИДЛицевогоСчета;
			BillId				= ОписаниеСчета.ИДТарифа;
			SubscriptionEndDate	= ОписаниеСчета.ДатаОкончанияПодписки;
			
			Переменные = Новый Соответствие;
			Переменные.Вставить("BoxID",				BoxId);
			Переменные.Вставить("AccountId",			AccountId);
			Переменные.Вставить("BillId",				BillId);
			Переменные.Вставить("SubscriptionEndDate",	SubscriptionEndDate);
			
			ИдентификаторБазы1С = ОбщиеНастройки_Прочитать("ИдентификаторБазы1С");
			Переменные.Вставить("BaseID", ИдентификаторБазы1С);
			
			Метрика_ЗаписатьСтатистику(Категория, Действие, Метка, Переменные);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

