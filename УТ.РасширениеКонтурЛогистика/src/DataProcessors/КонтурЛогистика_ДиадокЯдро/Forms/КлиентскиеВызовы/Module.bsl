&НаКлиенте
Процедура Инициализировать(ОсновнойМодуль, СуществующийКонтекст) Экспорт
	
	Объект.ОбщийКонтекстКлиентСервер = СуществующийКонтекст;
	
	ПолученныеФормы_ДобавитьОписание("ОсновнойМодуль", ОсновнойМодуль);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуЯдра() Экспорт
	
	Метрики_Отправить();
	
	МетодСервера(Ложь, "ОбработкаОбъект().ЗавершитьРаботуЯдра");
	
	ОчиститьОбщийКонтекст();
	
	КонтекстСеанса_Очистить();
	
	ОчиститьКэшМодулей();
	
	ОчиститьКэш();
	
КонецПроцедуры

// Проверят изменился ли файл текущей обработки
// с момента её последнего использования
// 
// Возвращаемое значение:
//  Булево - Истина, если файл изменился или обработка подключена повторно
//
&НаКлиенте
Функция ФайлТекущейОбработкиИзменился() Экспорт
	
	Попытка
		
		Результат = МетодСервера(Истина, "ОбработкаОбъект().ФайлТекущейОбработкиИзменился");
		
	Исключение
		
		Ошибка		 = ИнформацияОбОшибке();
		ТекстОшибки	 = КраткоеПредставлениеОшибки(Ошибка);
		
		Если ТекстОшибки = "Неизвестный идентификатор формы" Тогда
			Результат = Истина; // Это значит что обработка поключена повторно
		Иначе
			ВызватьИсключение;
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

