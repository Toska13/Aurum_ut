// Возвращает значение из общего контекста.
//
&НаКлиенте
Функция ОбщийКонтекст_Прочитать(ИмяПараметра) Экспорт
	
	Результат = СвойствоСтруктуры(Объект.ОбщийКонтекстКлиентСервер, ИмяПараметра);
	
	Возврат Результат;
	
КонецФункции

// Помещяет в общий контекст новое значение
//
&НаКлиенте
Процедура ОбщийКонтекст_Поместить(Ключ, Значение) Экспорт
	
	Если Объект.ОбщийКонтекстКлиентСервер = Неопределено Тогда
		Объект.ОбщийКонтекстКлиентСервер = Новый Структура;
	КонецЕсли;
	
	Объект.ОбщийКонтекстКлиентСервер.Вставить(Ключ, Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОбщийКонтекст()
	
	Если Не ЗначениеЗаполнено(Объект.ОбщийКонтекстКлиентСервер) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Объект.ОбщийКонтекстКлиентСервер Цикл
		
		Если ЭтоАдресИзВременногоХранилища(Элемент.Значение) Тогда
			ВременноеХранилище_Удалить(Элемент.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ОбщийКонтекстКлиентСервер.Очистить();
	
КонецПроцедуры

