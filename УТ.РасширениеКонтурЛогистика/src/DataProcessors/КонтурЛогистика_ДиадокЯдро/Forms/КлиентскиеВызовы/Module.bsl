&НаКлиенте
Функция СоздатьМодуль(ИмяМодуля, ИмяНовойФормы, ВладелецНовойФормы = Неопределено)
	
	Результат = КэшМодулей_Прочитать(ИмяМодуля);
	
	Если Результат = Неопределено Тогда
		
		ОписаниеОбработки = ПодключенныеОбработки_Прочитать(ИмяМодуля);
		
		Если НЕ ЗначениеЗаполнено(ОписаниеОбработки) Тогда
			
			ПодключитьМодуль(ИмяМодуля);
			
			ОписаниеОбработки = ПодключенныеОбработки_Прочитать(ИмяМодуля);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеОбработки) Тогда
			
			Если ВладелецНовойФормы = Неопределено Тогда
				ВладелецНовойФормы = ЭтаФорма;
			КонецЕсли;
			
			Результат = ПолучитьФорму("ВнешняяОбработка." + ОписаниеОбработки.Имя + ".Форма." + ИмяНовойФормы, , ВладелецНовойФормы);
			
			КэшМодулей_Поместить(ИмяМодуля, Результат);
			
			ПолученныеФормы_ДобавитьОписание(ИмяМодуля, Результат)
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СоздатьМодульПМ(ИмяМодуля)
	
	Результат = КэшМодулей_Прочитать(ИмяМодуля);
	
	Если Результат = Неопределено Тогда
		
		ОписаниеОбработки = ПодключенныеОбработки_Прочитать(ИмяМодуля);
		
		Если НЕ ЗначениеЗаполнено(ОписаниеОбработки) Тогда
			
			ПодключитьМодуль(ИмяМодуля);
			
			ОписаниеОбработки = ПодключенныеОбработки_Прочитать(ИмяМодуля);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеОбработки) Тогда
			
			ПолноеИмя = ПолноеИмяМодуля(ИмяМодуля);
			
			Если ПолноеИмя = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
			
			Попытка
				Результат = ПолучитьФорму(ПолноеИмя + ".Форма.ПодключаемыйМодуль");
			Исключение
				Возврат Результат;
			КонецПопытки;
			
			КэшМодулей_Поместить(ИмяМодуля, Результат);
			
			ПолученныеФормы_ДобавитьОписание(ИмяМодуля, Результат)
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолноеИмяМодуля(ИмяМодуля)
	
	Результат = Неопределено;
	
	ОбработкаОбъект = ОбработкаОбъект();
	ИмяКонструктора = "Модуль_" + ИмяМодуля;
	Модуль = Вычислить("ОбработкаОбъект." + ИмяКонструктора + "(ОбработкаОбъект)");
	Если Модуль = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Модуль.Метаданные().ПолноеИмя();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодключитьМодуль(ИмяМодуля)
	
	ОписаниеОбработки = ПодключитьМодульНаСервере(ИмяМодуля);
	ПодключенныеОбработки_Поместить(ИмяМодуля, ОписаниеОбработки);
	
КонецПроцедуры

&НаСервере
Функция ПодключитьМодульНаСервере(ИмяМодуля)
	
	ОбработкаОбъект = ОбработкаОбъект();
	
	ИмяКонструктора = "Модуль_" + ИмяМодуля;
	
	Модуль = Вычислить("ОбработкаОбъект." + ИмяКонструктора + "(ОбработкаОбъект)");
	
	// После подключения модуля нужно передать на клиента новый общий контекст.
	Объект.ОбщийКонтекстКлиентСервер = ОбработкаОбъект.ОбщийКонтекстКлиентСервер;
	
	ПодключенныеОбработки = ОбработкаОбъект.СвойствоСтруктуры(Объект.ОбщийКонтекстКлиентСервер
																, "ПодключенныеОбработки"
																, Новый Соответствие);
	
	Результат = ПодключенныеОбработки.Получить(ИмяМодуля);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КэшМодулей_Прочитать(ИмяМодуля)
	
	Результат = Неопределено;
	
	Если РежимОтладкиВключен() Тогда
		Возврат Результат;
	КонецЕсли;
	
	КэшМодулей = Кэш_Прочитать("КэшМодулей");
	
	Если ЗначениеЗаполнено(КэшМодулей) Тогда
		Результат = КэшМодулей[ИмяМодуля];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КэшМодулей_Поместить(ИмяМодуля, Модуль)
	
	Если РежимОтладкиВключен() Тогда
		Возврат;
	КонецЕсли;
	
	КэшМодулей = Кэш_Прочитать("КэшМодулей");
	
	Если КэшМодулей = Неопределено Тогда
		
		КэшМодулей = Новый Соответствие;
		
		Кэш_Поместить("КэшМодулей", КэшМодулей);
		
	КонецЕсли;
	
	КэшМодулей.Вставить(ИмяМодуля, Модуль);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКэшМодулей()
	
	Если РежимОтладкиВключен() Тогда
		Возврат;
	КонецЕсли;
	
	КэшМодулей = Кэш_Прочитать("КэшМодулей");
	
	Если Не ЗначениеЗаполнено(КэшМодулей) Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваДляОчистки = Новый Структура;
	СвойстваДляОчистки.Вставить("Ядро");
	СвойстваДляОчистки.Вставить("ОсновнойМодуль");
	
	Для Каждого Элемент Из КэшМодулей Цикл
		
		Модуль = Элемент.Значение;
		
		Если Модуль <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(Модуль, СвойстваДляОчистки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	КэшМодулей.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключенныеОбработки_Поместить(ИмяМодуля, ОписаниеОбработки)
	
	ПодключенныеОбработки = Объект.ОбщийКонтекстКлиентСервер["ПодключенныеОбработки"];
	
	Если ПодключенныеОбработки = Неопределено Тогда
		
		ПодключенныеОбработки = Новый Соответствие;
		
		Объект.ОбщийКонтекстКлиентСервер["ПодключенныеОбработки"] = ПодключенныеОбработки;
		
	КонецЕсли;
	
	ПодключенныеОбработки.Вставить(ИмяМодуля, ОписаниеОбработки);
	
КонецПроцедуры

&НаКлиенте
Функция ПодключенныеОбработки_Прочитать(ИмяМодуля)
	
	Результат = Неопределено;
	
	ПодключенныеОбработки = Объект.ОбщийКонтекстКлиентСервер["ПодключенныеОбработки"];
	
	Если ПодключенныеОбработки <> Неопределено Тогда
		
		Результат = ПодключенныеОбработки[ИмяМодуля];
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолученныеФормы_ДобавитьОписание(ИмяМодуля, ФормаМодуля)
	
	ОписаниеФормы = НовоеОписаниеПолученнойФормы();
	ОписаниеФормы.ИмяМодуля = ИмяМодуля;
	
	ЗаполнитьЗначенияСвойств(ОписаниеФормы, ФормаМодуля);
	
	ПолученныеФормы_Поместить(ИмяМодуля, ОписаниеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолученныеФормы_Поместить(ИмяМодуля, ОписаниеФормы)
	
	ПолученныеФормы = Кэш_Прочитать("ПолученныеФормы");
	
	Если ПолученныеФормы = Неопределено Тогда
		
