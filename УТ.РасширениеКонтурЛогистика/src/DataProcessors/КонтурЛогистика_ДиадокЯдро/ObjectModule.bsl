Функция АПИ_ВсеДоступныеТипыДокументов()
	
	Результат = Новый Структура;
	
	КонтекстСеанса = КонтекстСеанса_СтрокиКонтекста();
	
	Для Каждого КлючИЗначение Из КонтекстСеанса Цикл
		
		СтрокаКонтекста = КлючИЗначение.Значение;
		
		BoxId			 = СтрокаКонтекста.BoxId;
		ПараметрыСервиса = ПараметрыСервиса_Диадок(BoxId);
		
		Ответ = АПИ_GetDocumentTypes(ПараметрыСервиса, BoxId);
		
		Для Каждого DocumentType Из Ответ.DocumentTypes Цикл
			Результат.Вставить(DocumentType.Name, DocumentType);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

