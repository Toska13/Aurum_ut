Процедура ПроверитьСертификатНаУстаревшийГОСТ(СтрокаКонтекста) Экспорт
	
	Результат = "";
	
	ДатаПерехода = ДатаЗапретаГОСТ2001();
	
	ГОСТСертификата			= СтрокаКонтекста.ГОСТСертификата;
	ОтпечатокСертификата	= СтрокаКонтекста.ОтпечатокСертификата;
	
	Если ГОСТСертификата = "2001"
		И УниверсальноеВремя(ТекущаяДата()) > ДатаПерехода Тогда
		
		ТекстОшибки = "Сертификат "
		+ ОтпечатокСертификата
		+ Символы.ПС + "выпущен по устаревшему ГОСТ-2001."
		+ Символы.ПС + "Вы не можете подписывать документы этим сертификатом." 
		+ Символы.ПС;
		
		ВидОперации = "Подписание документа";		
		Ошибка_Обработать(ВидОперации, ТекстОшибки, , ТекстОшибки);

		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
