		ТекстОшибки		 = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДопИнформация	 = Общее_ПодставитьПараметрыВСтроку("Отпечаток сертификата: %1", ОтпечатокСертификата);
		
