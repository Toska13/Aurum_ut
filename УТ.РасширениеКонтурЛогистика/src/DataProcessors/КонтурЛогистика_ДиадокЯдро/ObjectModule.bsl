// Получает данные из временного хранилища.
// Для 8.1 значение получается из специального соответствия в общем кэше.
//
// Параметры:
//  Адрес - Строка                  - адрес во временном хранилище;
//        - УникальныйИдентификатор - идентификатор в общем кэше;
//
// Возвращаемое значение: 
//   Произвольный - данные из временого хранилища.
//   Неопределено - если по указаному адресу данных нет.
//
Функция ВременноеХранилище_Прочитать(Адрес) Экспорт
	
	Результат = Неопределено;
	
	Если ПриложениеСтаршеВерсии("8.2") Тогда
		
		КэшВременногоХранилища = Кэш_Прочитать("КэшВременногоХранилища");
		
		Если КэшВременногоХранилища <> Неопределено Тогда
			
			Результат = КэшВременногоХранилища.Получить(Адрес);
			
		КонецЕсли;
		
	Иначе
		
		Результат = Вычислить("ПолучитьИзВременногоХранилища(Адрес)");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Помещает значение во временное хранилище.
// Для 8.1 значение помещяется в специальное соответствие в общем кэше.
//
// Параметры:
//  Данные - Произвольный            - данные, которые нужно поместить;
//  Адрес  - Строка                  - адрес во временном хранилище;
//         - УникальныйИдентификатор - идентификатор, по которому нужно создать новый адрес;
//
// Возвращаемое значение: 
//   Строка - адрес во временном хранилище.
//
Функция ВременноеХранилище_Поместить(Значение, Адрес = Неопределено) Экспорт
	
	Если ПриложениеСтаршеВерсии("8.2") Тогда
		
		КэшВременногоХранилища = Кэш_Прочитать("КэшВременногоХранилища");
		
		Если КэшВременногоХранилища = Неопределено Тогда
			
			КэшВременногоХранилища = Новый Соответствие;
			
			Кэш_Поместить("КэшВременногоХранилища", КэшВременногоХранилища);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Адрес) И ТипЗнч(Адрес) = Тип("Строка") Тогда
			Результат = Адрес;
		Иначе
			Результат = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		
		КэшВременногоХранилища.Вставить(Результат, Значение);
		
	Иначе
		
		Если ЗначениеЗаполнено(Адрес) Тогда
			Результат = Вычислить("ПоместитьВоВременноеХранилище(Значение, Адрес)");
		Иначе
			Результат = Вычислить("ПоместитьВоВременноеХранилище(Значение)");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удаляет данные из временного хранилища
// Для 8.1 значение удаляется из специального кэша
//
// Параметры:
//  Адрес - Строка                  - адрес во временном хранилище;
//        - УникальныйИдентификатор - идентификатор в общем кэше;
//
Процедура ВременноеХранилище_Удалить(Адрес) Экспорт
	
	Если ПриложениеСтаршеВерсии("8.2") Тогда
		
		КэшВременногоХранилища = Кэш_Прочитать("КэшВременногоХранилища");
		
		Если КэшВременногоХранилища <> Неопределено Тогда
			
			КэшВременногоХранилища.Удалить(Адрес);
			
		КонецЕсли;
		
	Иначе
		
		Выполнить("УдалитьИзВременногоХранилища(Адрес)");
		
	КонецЕсли;
	
КонецПроцедуры

