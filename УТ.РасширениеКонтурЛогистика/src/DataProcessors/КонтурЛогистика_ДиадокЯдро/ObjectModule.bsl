	Модуль_МетодыAPI = Модуль_МетодыAPI(ЭтотОбъект);
	
	Результат = Модуль_МетодыAPI.DD_API_DS_EditDocumentPacketCommand(DocumentId);
	
	Если МассивDocumentIdAddDocumentsToPacket <> Неопределено Тогда  
		Для Каждого DocumentIdAddDocumentsToPacket Из МассивDocumentIdAddDocumentsToPacket Цикл 
			
			СтруктураДобавляемогоВПакет = Модуль_МетодыAPI.DD_API_DS_DocumentId(DocumentIdAddDocumentsToPacket.MessageId,
																				DocumentIdAddDocumentsToPacket.EntityId);
			Результат.AddDocumentsToPacket.Добавить(СтруктураДобавляемогоВПакет);
			
		КонецЦикла;
	КонецЕсли;
	
	Если МассивDocumentIdRemoveDocumentsFromPacket <> Неопределено Тогда  
		Для Каждого DocumentIdRemoveDocumentsFromPacket Из МассивDocumentIdRemoveDocumentsFromPacket Цикл 
			
			СтруктураУдаляемыхИзПакета = Модуль_МетодыAPI.DD_API_DS_DocumentId(DocumentIdRemoveDocumentsFromPacket.MessageId,
																				DocumentIdRemoveDocumentsFromPacket.EntityId);
			Результат.RemoveDocumentsFromPacket.Добавить(СтруктураУдаляемыхИзПакета);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
