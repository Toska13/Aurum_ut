Функция ПараметрыСервиса_Диадок(BoxId = Неопределено, ИспользоватьСлужебнуюУчетнуюЗапись = Ложь) Экспорт
	
	Результат = ПараметрыСервиса(BoxId, ИспользоватьСлужебнуюУчетнуюЗапись);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") = Истина Тогда 
		АдресСервиса = ОбщийКонтекст_Прочитать("АдресТестовогоDiadocAPI");
	Иначе
		АдресСервиса = ОбщийКонтекст_Прочитать("АдресDiadocAPI");
	КонецЕсли;
	
	Результат.Вставить("РежимАвторизации", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации"));
	
	URL_Структура = URL_Структура(АдресСервиса);
	
	Результат.Схема				 = URL_Структура.Схема;
	Результат.АдресВебСервиса	 = URL_Структура.Хост;
	Результат.Порт				 = URL_Структура.Порт;
	Результат.КлючРазработчика	 = ОбщийКонтекст_Прочитать("КлючРазработчика");
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыСервиса_Контур(BoxId = Неопределено, ИспользоватьСлужебнуюУчетнуюЗапись = Ложь) Экспорт
	
	Результат = ПараметрыСервиса(BoxId, ИспользоватьСлужебнуюУчетнуюЗапись);
	
	АдресСервиса = ОбщийКонтекст_Прочитать("АдресKonturAPI");
	
	URL_Структура = URL_Структура(АдресСервиса);
	
	Результат.Схема				 = URL_Структура.Схема;
	Результат.АдресВебСервиса	 = URL_Структура.Хост;
	Результат.Порт				 = URL_Структура.Порт;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыСервиса(BoxId = Неопределено, ИспользоватьСлужебнуюУчетнуюЗапись = Ложь)
	
	Модуль_МетодыAPI = Модуль_МетодыAPI(ЭтотОбъект);
	
	Результат = Модуль_МетодыAPI.ПараметрыСервиса();
	
	Если ИспользоватьСлужебнуюУчетнуюЗапись Тогда
		
		Результат.Токен = КонтекстСеанса_ТокенДоступа("");
		
	ИначеЕсли BoxId <> Неопределено Тогда
		
		Результат.Токен = КонтекстСеанса_ТокенДоступа(BoxId);
		
	КонецЕсли;
	
	НастройкиПрокси = Результат.НастройкиПрокси;
	
	ТипПрокси							 = ОбщиеНастройки_Прочитать("РежимПрокси");
	ТипПроксиСтрокой					 = Перечисления.КонтурЛогистика_ТипыПрокси.ТипПроксиСтрокой(ТипПрокси);
	
	НастройкиПрокси.РежимПрокси			 = ТипПроксиСтрокой;
	НастройкиПрокси.АдресПроксиСервера	 = ОбщиеНастройки_Прочитать("АдресПроксиСервера");
	НастройкиПрокси.ЛогинПроксиСервера	 = ОбщиеНастройки_Прочитать("ЛогинПроксиСервера");
	НастройкиПрокси.ПарольПроксиСервера	 = ОбщиеНастройки_Прочитать("ПарольПроксиСервера");
	НастройкиПрокси.ПортПроксиСервера	 = ОбщиеНастройки_Прочитать("ПортПроксиСервера");
	
	Возврат Результат;
	
КонецФункции

// Разбирает строку URI на составные части и возвращает их в виде структуры
// На основе RFC 3986 (метод из БСП)
//
// Параметры:
//  СтрокаURI - Строка - ссылка на ресурс в формате:
//                       <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>.
//
// Возвращаемое значение:
//  Структура - составные части URI согласно формату:
//   * Схема         - Строка - схема из URI.
//   * Логин         - Строка - логин из URI.
//   * Пароль        - Строка - пароль из URI.
//   * ИмяСервера    - Строка - часть <хост>:<порт> из URI.
//   * Хост          - Строка - хост из URI.
//   * Порт          - Строка - порт из URI.
//   * ПутьНаСервере - Строка - часть <путь>?<параметры>#<якорь> из URI.
//
Функция URL_Структура(Знач СтрокаURI) Экспорт
	
	СтрокаURI = СокрЛП(СтрокаURI);
	
	// схема
	Схема = "";
	Позиция = Найти(СтрокаURI, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(СтрокаURI, Позиция - 1));
		СтрокаURI = Сред(СтрокаURI, Позиция + 3);
	КонецЕсли;
	
	// Строка соединения и путь на сервере.
	СтрокаСоединения = СтрокаURI;
	ПутьНаСервере = "";
	Позиция = Найти(СтрокаСоединения, "/");
	Если Позиция > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, Позиция + 1);
		СтрокаСоединения = Лев(СтрокаСоединения, Позиция - 1);
	КонецЕсли;
	
	// Информация пользователя и имя сервера.
	СтрокаАвторизации = "";
	ИмяСервера = СтрокаСоединения;
	Позиция = Найти(СтрокаСоединения, "@");
	Если Позиция > 0 Тогда
		СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
		ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
	КонецЕсли;
	
	// логин и пароль
	Логин = СтрокаАвторизации;
	Пароль = "";
	Позиция = Найти(СтрокаАвторизации, ":");
	Если Позиция > 0 Тогда
		Логин = Лев(СтрокаАвторизации, Позиция - 1);
		Пароль = Сред(СтрокаАвторизации, Позиция + 1);
	КонецЕсли;
	
	// хост и порт
	Хост = ИмяСервера;
	Порт = "";
	Позиция = Найти(ИмяСервера, ":");
	Если Позиция > 0 Тогда
		Хост = Лев(ИмяСервера, Позиция - 1);
		Порт = Сред(ИмяСервера, Позиция + 1);
		Если Не ВСтрокеТолькоЦифры(Порт) Тогда
			Порт = "";
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИмяСервера", ИмяСервера);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", ?(ПустаяСтрока(Порт), Неопределено, Число(Порт)));
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	
	Возврат Результат;

	
КонецФункции

