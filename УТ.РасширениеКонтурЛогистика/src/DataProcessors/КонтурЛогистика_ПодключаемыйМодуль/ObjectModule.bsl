// Это подключаемый модуль НаСервере
// Подключаемого модуля НаКлиенте в текущей редакции не существует (нет потребности)
// РЕКОМЕНДУЕТСЯ добавлять РАСШИРЕНИЯ к текущим событиям ПМ
//   в случае, если расширения недоступны, рекомендуется разблокировать изменение Этой обработки (КонтурЛогистика_ПодключаемыйМодуль)  
//   и вносить изменения непосредственно в обработчики из блока Прикладные обработчики


// ТОЧКА ВХОДА

// Маршрутизирует вызов в конкретные обработчики (которые можно модифицировать), 
// возвращает результат работы ПМ (Результат необязателен, результатом может быть ИЗМЕНЕНИЕ параметров)
//
// Параметры:
//  ИмяСобытия							 - Строка - Название события для понимания места его возникновения и назначения
//  СтандартнаяОбработкаКМ	 			- Флаг   - В ряде событий предоставляет возможность отказаться от типового поведения системы после выполнения события
//  ПараметрыПодключаемогоМодуля		 - Структура, Произвольный - Передаются параметры для работы конкретного события (можно изменять значенияэтиз паратмеров в ПМ)
// 
// Возвращаемое значение:
//  Произвольный - результат выполнения ПМ
//
Функция ОбработатьСобытиеКонтурЛогистика(ИмяСобытия, Параметры, СтандартнаяОбработкаКМ = Истина) Экспорт
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию(); 
	
	// Рекомендуется использовать расширения.
	
	// Обработчики Событий и переходы к процедурам обработки
	// ----------------------------------------------------------------------------------------------------------------
	
	// ОБЩИЕ
	Если ИмяСобытия = "ПолучитьТекущегоПользователя1С" Тогда
		
		ТекПользователь = ПолучитьТекущегоПользователя1С();
		
		Возврат ТекПользователь;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ПослеУстановкиСостояния" Тогда
		
		ДокументЛогистика 	= Параметры.ДокументЛогистика;
		Состояние 	= Параметры.Состояние;
		
		ПослеУстановкиСостояния(ДокументЛогистика, Состояние);
		
	КонецЕсли;
	
	// Кастомизация выбора сертификата
	Если ИмяСобытия = "ВыбратьПодписанта_ДопПараметр" Тогда
		
		ДопПараметр = ВыбратьПодписанта_ДопПараметр(Параметры);
		
		Возврат ДопПараметр;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ВыбратьПодписанта_ЗаменаМеханизма" Тогда
		
		Возврат ВыбратьПодписанта_ЗаменаМеханизма(Параметры, СтандартнаяОбработкаКМ);
		
	КонецЕсли;
	
	Если ИмяСобытия = "ПодписатьДанные_ЗаменаМеханизма" Тогда		 
				
		Возврат ПодписатьДанные_ЗаменаМеханизма(Параметры, СтандартнаяОбработкаКМ);
		
	КонецЕсли;
	
	// СПИСОК ЗАДАЧ
	Если ИмяСобытия = "СписокЗадач_ЗаменитьТекстЗапросаСпискаЗадачИнтеграция" Тогда
		
		СписокЗадач_ЗаменитьТекстЗапросаСпискаЗадачИнтеграция(Параметры);
		
	КонецЕсли;
		
	Если ИмяСобытия = "СписокЗадач_ЗадачиДинамическийСписокПриПолученииДанныхНаСервере" Тогда
		
		СписокЗадач_ЗадачиДинамическийСписокПриПолученииДанныхНаСервере(Параметры);
		
	КонецЕсли;
	
	// СПРАВОЧНИКИ
	
	Если ИмяСобытия = "КонтурЛогистика_Договоры_ПередЗаписью_После" Тогда
		КонтурЛогистика_Договоры_ПередЗаписью_После(Параметры);	
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурЛогистика_ОрганизацииДиадок_ПередЗаписью_После" Тогда
		КонтурЛогистика_ОрганизацииДиадок_ПередЗаписью_После(Параметры);
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурЛогистика_ПодразделенияДиадок_ПередЗаписью_После" Тогда
		КонтурЛогистика_ПодразделенияДиадок_ПередЗаписью_После(Параметры);
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурЛогистика_ПунктыМаршрута_ПередЗаписью_После" Тогда
		КонтурЛогистика_ПунктыМаршрута_ПередЗаписью_После(Параметры);
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурЛогистика_Сотрудники_ПередЗаписью_После" Тогда
		КонтурЛогистика_Сотрудники_ПередЗаписью_После(Параметры);
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурЛогистика_ТранспортныеСредства_ПередЗаписью_После" Тогда
		КонтурЛогистика_ТранспортныеСредства_ПередЗаписью_После(Параметры);
	КонецЕсли;
	
	// ДОКУМЕНТЫ ТИТУЛЫ
	
	// После ОбработкаЗаполнения
	Если ИмяСобытия = "ТрН_Титул1_ОбработкаЗаполнения_После" Тогда
		ТрН_Титул1_ОбработкаЗаполнения_После(Параметры);
	ИначеЕсли ИмяСобытия = "ТрН_Титул1_ПередЗаписью_После" Тогда
		ТрН_Титул1_ПередЗаписью_После(Параметры);
	КонецЕсли;
	
	Если ИмяСобытия = "ТрН_Титул2_ОбработкаЗаполнения_После" Тогда
		ТрН_Титул2_ОбработкаЗаполнения_После(Параметры);
