		ПЛ_Титул3_5_02_ОбработкаЗаполнения_После(Параметры);
	ИначеЕсли ИмяСобытия = "ПЛ_Титул3_5_02_ПередЗаписью_После" Тогда
		ПЛ_Титул3_5_02_ПередЗаписью_После(Параметры);
	КонецЕсли;
	
	Если ИмяСобытия = "ПЛ_Титул4_5_02_ОбработкаЗаполнения_После" Тогда
		ПЛ_Титул4_5_02_ОбработкаЗаполнения_После(Параметры);
	ИначеЕсли ИмяСобытия = "ПЛ_Титул4_5_02_ПередЗаписью_После" Тогда
		ПЛ_Титул4_5_02_ПередЗаписью_После(Параметры);
