		ПЛ_Титул5_5_02_ПередЗаписью_После(Параметры);
	КонецЕсли;
	 		
	// ДОКУМЕНТЫ ДОГОВОР ФРАХТОВАНИЯ
	
	Если ИмяСобытия = "ДФ_Титул1_ОбработкаЗаполнения_После" Тогда
		ДФ_Титул1_ОбработкаЗаполнения_После(Параметры);
	ИначеЕсли ИмяСобытия = "ДФ_Титул1_ПередЗаписью_После" Тогда
		ДФ_Титул1_ПередЗаписью_После(Параметры);
