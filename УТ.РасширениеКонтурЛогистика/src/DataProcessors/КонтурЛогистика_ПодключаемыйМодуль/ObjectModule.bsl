		ЭкспедиторскаяРасписка_ПередЗаписью_После(Параметры);
	КонецЕсли;
		
	// ФАЙЛЫ ОБМЕНА
	
	Если ИмяСобытия = "ФайлОбмена_ПриСоздании" Тогда
		ФайлОбмена_ПриСоздании(Параметры);
	КонецЕсли;
	
	// КОНВЕРТАЦИИ
	
	Если ИмяСобытия = "Конвертация_СоздатьОрганизациюДиадокИзВычисленныхРеквизитов" Тогда 
		Возврат Конвертация_СоздатьОрганизациюДиадокИзВычисленныхРеквизитов(Параметры);
	КонецЕсли;
	
	Если ИмяСобытия = "НайтиДокументУчетнойСистемыПоНастройкеКонвертации_ЗаменаМеханизма" Тогда 
		Возврат НайтиДокументУчетнойСистемыПоНастройкеКонвертации_ЗаменаМеханизма(Параметры, СтандартнаяОбработкаКМ);
	КонецЕсли;
	
	Если ИмяСобытия = "НайтиДокументУчетнойСистемыПоНастройкеКонвертации_ЗаменаТекстаЗапроса" Тогда 
		Возврат НайтиДокументУчетнойСистемыПоНастройкеКонвертации_ЗаменаТекстаЗапроса(Параметры);
	КонецЕсли;
	
	Если ИмяСобытия = "КонвертироватьВРеквизитыРС_После" Тогда
		КонвертироватьВРеквизитыРС_После(Параметры);
	КонецЕсли;
	
	Если ИмяСобытия = "КонвертироватьДанныеРСВОбъектУчетнойСистемы_После" Тогда
		КонвертироватьДанныеРСВОбъектУчетнойСистемы_После(Параметры);
	КонецЕсли;
	
	// ПРИКЛАДНЫЕ
	
	// ПРОЧЕЕ
	Если ИмяСобытия = "ПослеЗавершенияРаботыСТитулом" Тогда
		
		ДокументТитул 	= Параметры.Документ;
		ПрисвоенныйСтатус 	= Параметры.Статус;
		
		ПослеЗавершенияРаботыСТитулом(ДокументТитул, ПрисвоенныйСтатус);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ПолучитьЗначениеДополнительногоПараметраДляПроверкиПолномочийМЧД" Тогда
		
		ДокументТитул 	= Параметры.Документ;
		
		Возврат ПолучитьЗначениеДополнительногоПараметраДляПроверкиПолномочийМЧД(ДокументТитул);
				
	КонецЕсли;
	
	//НАСТРОЙКИ АРХИВА
	Если ИмяСобытия = "СохранитьПечатнуюФормуЭПД" Тогда	
		
		ПечатнаяФорма 	= Параметры.ПечатнаяФорма;
		Документ1С 	= Параметры.Документ1С;
		
		Возврат СохранитьПечатнуюФормуЭПД(ПечатнаяФорма, Документ1С);
		
	КонецЕсли;
	
	Если ИмяСобытия = "СохранитьАрхивДокументооборота" Тогда	
		
		Архив 	= Параметры.Архив;
		
		Возврат СохранитьАрхивДокументооборота(Архив);
		
	КонецЕсли;
	
	Если ИмяСобытия = "СведенияОВнешнейОбработке" Тогда
		Возврат СведенияОВнешнейОбработке();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


