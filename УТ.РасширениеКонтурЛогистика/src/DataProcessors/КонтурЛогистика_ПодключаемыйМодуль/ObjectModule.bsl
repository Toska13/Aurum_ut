	ДанныеСертификата.Вставить("Отпечаток");                // тип Строка - Отпечаток сертификата
	ДанныеСертификата.Вставить("Представление");            // тип Строка - Представление сертификата в виде: <ФИО>, по <срок действия>, <тип владельца> (ФЛ|ИП|ЮЛ)
	                                                        // Например: Иванов Иван Иванович, по 23.03.2026, Физическое лицо
	ДанныеСертификата.Вставить("СертификатНаСервере", Истина);
	
	// Установить СтандартнаяОбработкаКМ = Ложь, чтобы отказаться от типового поведения системы
	//СтандартнаяОбработкаКМ = Ложь;
	
	ПодписанныеДанные = Неопределено;
	
	// Напишите алгоритм подписания и верните результат подписания в двоичных данных. Заполните стуктуру с данными сертификата, которым были подписаны
	// данные. Данные сертификата запишутся в файл обмена.
	
	Параметры.ДанныеСертификата = ДанныеСертификата;	
				
	Возврат ПодписанныеДанные;
	
КонецФункции

