&НаКлиенте
Функция Прочитать(Строка) Экспорт
	
	#Если ВебКлиент Тогда
		
		ТекстОшибки = НСтр("ru = 'Вэб клиенте не поддерживается чтение из строки JSON'");
		
		ВызватьИсключение ТекстОшибки;
		
	#КонецЕсли
	
	Результат = Платформа_ПрочитатьJSON(Строка);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Записать(Значение) Экспорт
	
	#Если ВебКлиент Тогда
		
		ТекстОшибки = НСтр("ru = 'Вэб клиенте не поддерживается запись в строку JSON'");
		
		ВызватьИсключение ТекстОшибки;
		
	#КонецЕсли
	
	Результат = Платформа_ЗаписатьJSON(Значение);
	
	Возврат Результат;
	
КонецФункции

//}		ПРОГРАММНЫЙ ИНТЕРФЕЙС

//**********************************************
//{		ЧТЕНИЕ И ЗАПИСЬ JSON

&НаКлиенте
Функция Платформа_ПрочитатьJSON(Строка)
	
	ЧерезВременныйФайл = Ложь;
	
	Чтение = Новый("ЧтениеJSON");
	Чтение.УстановитьСтроку(Строка);
	
	Попытка
		Результат = Вычислить("ПрочитатьJSON(Чтение)");
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЧерезВременныйФайл = Истина;
	КонецПопытки;
	
	Если ЧерезВременныйФайл Тогда
		
		Кодировка	 = "utf-8";
		ИмяВремФайла = ПолучитьИмяВременногоФайла();
		
		ТД = Новый ТекстовыйДокумент;
		ТД.УстановитьТекст(Строка);
		ТД.Записать(ИмяВремФайла, Кодировка);
		ТД = Неопределено;
		
		Чтение = Новый("ЧтениеJSON");
		Чтение.ОткрытьФайл(ИмяВремФайла, Кодировка);
		
		Попытка
			Результат = Вычислить("ПрочитатьJSON(Чтение)");
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонецПопытки;
		
		УдалитьФайлы(ИмяВремФайла);
		
	КонецЕсли;
	
	Чтение.Закрыть();
	
	Если ЧерезВременныйФайл Тогда
		УдалитьФайлы(ИмяВремФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Платформа_ЗаписатьJSON(Значение)
	
	Запись = Новый ("ЗаписьJSON");
	Запись.УстановитьСтроку();
	
	Выполнить("ЗаписатьJSON(Запись, Значение)");
	
	Результат = Запись.Закрыть();
	
	Возврат Результат;
	
КонецФункции

//}		ЧТЕНИЕ И ЗАПИСЬ JSON