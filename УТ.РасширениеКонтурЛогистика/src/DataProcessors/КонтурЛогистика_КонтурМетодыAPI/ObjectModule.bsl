Функция DD_API_GetDocuments(ПараметрыСервиса, boxId, filterCategory
	, counteragentBoxId		 = Неопределено
	, toDepartmentId		 = Неопределено
	, timestampFromTicks	 = Неопределено
	, timestampToTicks		 = Неопределено
	, fromDocumentDate		 = Неопределено
	, toDocumentDate		 = Неопределено
	, departmentId			 = Неопределено
	, excludeSubdepartments	 = Неопределено
	, afterIndexKey			 = Неопределено
	, sortDirection			 = Неопределено) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/http/GetDocuments.html
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/V3/GetDocuments";
	
	ПараметрыЗапроса.Параметры.Вставить("boxId"			, boxId);
	ПараметрыЗапроса.Параметры.Вставить("filterCategory", filterCategory);
	
	Если ЗначениеЗаполнено(counteragentBoxId) Тогда
