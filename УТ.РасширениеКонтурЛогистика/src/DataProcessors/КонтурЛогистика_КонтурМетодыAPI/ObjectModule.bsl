Функция DD_API_AcquireCounteragent(ПараметрыСервиса, myOrgId, AcquireCounteragentRequest) Экспорт 

	//http://api-docs.diadoc.ru/ru/latest/http/AcquireCounteragent.html
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/V2/AcquireCounteragent";
	
	ПараметрыЗапроса.Параметры.Вставить("myOrgId", myOrgId);
	
	ПараметрыЗапроса.ТелоЗапроса = ПарсерJSON_Записать(AcquireCounteragentRequest);
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	AsyncMethodResult = ПарсерJSON_Прочитать(Ответ.ТелоОтвета);
	
	Результат = AsyncMethodResult.taskId;
	
	Возврат Результат;
	
КонецФункции

Функция DD_API_AcquireCounteragentResult(ПараметрыСервиса, taskId) Экспорт 

	//http://api-docs.diadoc.ru/ru/latest/http/AcquireCounteragentResult.html
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/AcquireCounteragentResult";
	
	ПараметрыЗапроса.Параметры.Вставить("taskId", taskId);
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(204); //операция еще выполняется на сервере
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 200 Тогда
	
		AcquireCounteragentResult = ПарсерJSON_Прочитать(Ответ.ТелоОтвета);
		OrgId = СвойствоСтруктуры(AcquireCounteragentResult, "orgId");
	
	КонецЕсли; 
	
	ВремяОжидания = Ответ.Заголовки["Retry-After"];
	ВремяОжидания = ЧислоИзСтроки(ВремяОжидания);
	
	Результат = Новый Структура;
	Результат.Вставить("ВремяОжидания"	, ВремяОжидания);
	Результат.Вставить("OrgId"			, OrgId);
	
	Возврат Результат;
	
КонецФункции

Функция DD_API_Authenticate(ПараметрыСервиса, Сертификат = Неопределено, Логин = Неопределено, Пароль = Неопределено) Экспорт 
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		
		ТипАутентификации = ТипАутентификацииСертификат();
		ТелоЗапроса = Сертификат;
		МедиаТип = МедиаТипБинарныеДанные();
		ТелоОтветаКакДвоичныеДанные = Истина;
		
	ИначеЕсли ЗначениеЗаполнено(Логин) Тогда
		
		ТипАутентификации = ТипАутентификацииПароль();
		ТелоЗапроса = ТелоЗапросаЛогинПароль(Логин, Пароль);
		МедиаТип = МедиаТипJSON();
		ТелоОтветаКакДвоичныеДанные = Ложь;
		
	Иначе
		
		Ошибка = "Некорректные параметры аутентификации! Должен быть указан сертификат или логин и пароль.";
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/V3/Authenticate";
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные = ТелоОтветаКакДвоичныеДанные;
	
	ПараметрыЗапроса.Параметры.Вставить("type", ТипАутентификации);
	
	ДобавитьТелоЗапроса(ПараметрыЗапроса, ТелоЗапроса, МедиаТип);
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	// BadRequest: данные в запросе имеют неверный формат или отсутствуют обязательные параметры
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(400);
	
	// Unauthorized: 
	// - в запросе отсутствует HTTP-заголовок Authorization
	// - или в этом заголовке отсутствует параметр ddauth_api_client_id
	// - или переданный в нем ключ разработчика не зарегистрирован в Диадоке;
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(401);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета <> 200 Тогда
		
		Если ТелоОтветаКакДвоичныеДанные Тогда
			ТекстОшибки = ПолучитьСтрокуИзДвоичныхДанных(Ответ.ТелоОтвета);	
		Иначе	
			ТекстОшибки = Ответ.ТелоОтвета;
		КонецЕсли;
		
		Если Найти(ТекстОшибки, "Wrong password provided for login") > 0
			Или Найти(ТекстОшибки, "Could not find password query param") > 0
			Или Найти(ТекстОшибки, "invalid authentication method") > 0 Тогда
			ТекстОшибки = "Неправильный логин или пароль";
		КонецЕсли;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Результат = Ответ.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

Функция DD_API_AuthenticateConfirm(ПараметрыСервиса, РасшифрованныйТокен, ОтпечатокСертификата) Экспорт
	
