		Результат.Вставить("DepartmentId", DepartmentId);
	КонецЕсли;
	
	МассивTypeNamedIds = Новый Массив;
	МассивTypeNamedIds.Добавить("LogisticsWaybill");
	МассивTypeNamedIds.Добавить("LogisticsWaybillForwarding");
	МассивTypeNamedIds.Добавить("LogisticsWorkOrder");
	МассивTypeNamedIds.Добавить("LogisticsEpl");
	МассивTypeNamedIds.Добавить("LogisticsOrderRequest");
	МассивTypeNamedIds.Добавить("LogisticsCharterAgreement");
	МассивTypeNamedIds.Добавить("XmlForwardingReceipt");
	Результат.Вставить("TypeNamedIds", МассивTypeNamedIds);
	
	Возврат Результат;
	
