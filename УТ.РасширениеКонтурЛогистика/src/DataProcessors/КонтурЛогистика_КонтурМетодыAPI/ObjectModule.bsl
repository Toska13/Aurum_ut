	// http://api-docs.diadoc.ru/ru/latest/http/PostMessage.html
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/V3/PostMessage";
	
	ДобавитьИдентификаторОперации(ПараметрыЗапроса, OperationId);
	
	ПараметрыЗапроса.ТелоЗапроса = ПарсерJSON_Записать(MessageToPost);
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.Свойство("КодОтветаДопустимый") И Ответ.КодОтветаДопустимый Тогда
	
		Message = ПарсерJSON_Прочитать(Ответ.ТелоОтвета);
		
		ВремяОжидания = Ответ.Заголовки["Retry-After"];
		ВремяОжидания = ЧислоИзСтроки(ВремяОжидания);
		
		Результат = Новый Структура;
		Результат.Вставить("ВремяОжидания"		, ВремяОжидания);
		Результат.Вставить("Message"			, Message);
		Результат.Вставить("КодОтветаДопустимый", Ответ.КодОтветаДопустимый);
		
	Иначе
		Результат = Ответ;	
	КонецЕсли;
		
	Возврат Результат;
		
