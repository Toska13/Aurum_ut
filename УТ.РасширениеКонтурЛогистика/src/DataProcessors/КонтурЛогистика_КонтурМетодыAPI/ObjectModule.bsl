		ConfidantCertificateToPrevalidate.Вставить("Thumbprint", ДанныеДляПроверкиДоверенности.ОтпечатокСертификата);
	КонецЕсли;
	
	Результат = Новый Структура;	
	Результат.Вставить("ConfidantCertificate", ConfidantCertificateToPrevalidate);
	Результат.Вставить("FullId ", FullId);
			
