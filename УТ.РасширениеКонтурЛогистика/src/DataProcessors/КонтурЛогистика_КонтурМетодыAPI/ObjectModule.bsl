// Возвращает заполненный контракт МЧД для постинга
// Признак UseDefault всегда Ложь, поскольку нельзя одновременное заполненное свойство FullId и UseDefault = True.
//
// Параметры:
//  RegistrationNumber	 - Строка	 - идентификатор МЧД
//  IssuerInn			 - Строка	 - ИНН доверителя
// 
// Возвращаемое значение:
//  Структура - конракт МЧД для постинга документов
//
Функция DD_API_DS_PowerOfAttorneyToPost(ДанныеДоверенностиДляПостинга) Экспорт
	
	SendAsFile = Ложь;
	
	Если ДанныеДоверенностиДляПостинга.Свойство("Идентификатор") И		
		ДанныеДоверенностиДляПостинга.Свойство("ИНН") Тогда
		
		PowerOfAttorneyFullId = Новый Структура;
		PowerOfAttorneyFullId.Вставить("RegistrationNumber"	, ДанныеДоверенностиДляПостинга.Идентификатор);
		PowerOfAttorneyFullId.Вставить("IssuerInn"			, ДанныеДоверенностиДляПостинга.ИНН);
		
		Если ДанныеДоверенностиДляПостинга.Свойство("ИННПредставителя") Тогда
			PowerOfAttorneyFullId.Вставить("RepresentativeInn", ДанныеДоверенностиДляПостинга.ИННПредставителя);		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеДоверенностиДляПостинга.Свойство("Контент") И 
		ДанныеДоверенностиДляПостинга.Свойство("Подпись") Тогда
		
		Content_v3_1 = Новый Структура;
		Content_v3_1.Вставить("Content", ДанныеДоверенностиДляПостинга.Контент);
		
		Content_v3_2 = Новый Структура;
		Content_v3_2.Вставить("Content", ДанныеДоверенностиДляПостинга.Подпись);
		
		PowerOfAttorneySignedContent = Новый Структура;
		PowerOfAttorneySignedContent.Вставить("Content"	  , Content_v3_1);
		PowerOfAttorneySignedContent.Вставить("Signature" , Content_v3_2);
		
	КонецЕсли;
	
	Если ДанныеДоверенностиДляПостинга.Свойство("ДоставкаФайлом") Тогда
		SendAsFile = ДанныеДоверенностиДляПостинга.ДоставкаФайлом;	
	КонецЕсли;
		
	Результат = Новый Структура;	
	Если ЗначениеЗаполнено(PowerOfAttorneyFullId) Тогда
		Результат.Вставить("FullId", PowerOfAttorneyFullId);
		Результат.Вставить("UseDefault", Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(PowerOfAttorneySignedContent) Тогда
		Результат.Вставить("Content", PowerOfAttorneySignedContent);
	КонецЕсли;
	Результат.Вставить("SendAsFile", SendAsFile);
			
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция DD_API_DS_PowerOfAttorneyToRegister(ДанныеДоверенностиДляРегистрации) Экспорт

	Если ДанныеДоверенностиДляРегистрации.Свойство("Идентификатор") И		
		ДанныеДоверенностиДляРегистрации.Свойство("ИННДоверителя") Тогда
		
		PowerOfAttorneyFullId = Новый Структура;
		PowerOfAttorneyFullId.Вставить("RegistrationNumber"	, ДанныеДоверенностиДляРегистрации.Идентификатор);
		PowerOfAttorneyFullId.Вставить("IssuerInn"			, ДанныеДоверенностиДляРегистрации.ИННДоверителя);
		
		Если ДанныеДоверенностиДляРегистрации.Свойство("ИННПредставителя") Тогда
			PowerOfAttorneyFullId.Вставить("RepresentativeInn"	, ДанныеДоверенностиДляРегистрации.ИННПредставителя);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеДоверенностиДляРегистрации.Свойство("Контент") И 
		ДанныеДоверенностиДляРегистрации.Свойство("Подпись") Тогда
		
		Content_v3_1 = Новый Структура;
		Content_v3_1.Вставить("Content", ДанныеДоверенностиДляРегистрации.Контент);
		
		Content_v3_2 = Новый Структура;
		Content_v3_2.Вставить("Content", ДанныеДоверенностиДляРегистрации.Подпись);
		
		PowerOfAttorneySignedContent = Новый Структура;
		PowerOfAttorneySignedContent.Вставить("Content"	  , Content_v3_1);
		PowerOfAttorneySignedContent.Вставить("Signature" , Content_v3_2);
		
	КонецЕсли;
	
	Результат = Новый Структура;	
	Если ЗначениеЗаполнено(PowerOfAttorneyFullId) Тогда
		Результат.Вставить("FullId"		, PowerOfAttorneyFullId);		
	КонецЕсли;
	Если ЗначениеЗаполнено(PowerOfAttorneySignedContent) Тогда
		Результат.Вставить("Content"	, PowerOfAttorneySignedContent);
	КонецЕсли;
		
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция DD_API_DS_PowerOfAttorneyPrevalidateRequest(ДанныеДляПроверкиДоверенности) Экспорт

	FullId   = Новый Структура;
	FullId.Вставить("RegistrationNumber", ДанныеДляПроверкиДоверенности.ИдентификаторДоверенности);
	FullId.Вставить("IssuerInn", ДанныеДляПроверкиДоверенности.ИННДоверителя);
	FullId.Вставить("RepresentativeInn", ДанныеДляПроверкиДоверенности.ИННПредставителя);
	
	Content_v3 = Новый Структура;
	Content_v3.Вставить("Content", ДанныеДляПроверкиДоверенности.ДвоичныеДанныеСертификата);
	
	ConfidantCertificateToPrevalidate = Новый Структура;
	Если ЗначениеЗаполнено(ДанныеДляПроверкиДоверенности.ДвоичныеДанныеСертификата) Тогда	
		ConfidantCertificateToPrevalidate.Вставить("Content", Content_v3);
