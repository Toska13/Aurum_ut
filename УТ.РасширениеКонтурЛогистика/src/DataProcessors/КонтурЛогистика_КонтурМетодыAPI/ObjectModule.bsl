	КонецЕсли;
	
	Если ЗначениеЗаполнено(timestampFromTicks) Тогда
		ПараметрыЗапроса.Параметры.Вставить("timestampFromTicks", timestampFromTicks);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(timestampToTicks) Тогда
		ПараметрыЗапроса.Параметры.Вставить("timestampToTicks", timestampToTicks);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(fromDocumentDate) Тогда
		ПараметрыЗапроса.Параметры.Вставить("fromDocumentDate", fromDocumentDate);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(toDocumentDate) Тогда
		ПараметрыЗапроса.Параметры.Вставить("toDocumentDate", toDocumentDate);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(departmentId) Тогда
		ПараметрыЗапроса.Параметры.Вставить("departmentId", departmentId);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(excludeSubdepartments) Тогда
		ПараметрыЗапроса.Параметры.Вставить("excludeSubdepartments", excludeSubdepartments);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(afterIndexKey) Тогда
		ПараметрыЗапроса.Параметры.Вставить("afterIndexKey", afterIndexKey);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(sortDirection) Тогда
		ПараметрыЗапроса.Параметры.Вставить("sortDirection", sortDirection);
	КонецЕсли;
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
