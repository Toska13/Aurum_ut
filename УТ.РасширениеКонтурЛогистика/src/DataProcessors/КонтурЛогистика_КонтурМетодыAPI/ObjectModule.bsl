//
// Если переданы параметры Content и Signature, параметры NameOnShelf и SignatureNameOnShelf не указываются
// Если переданы параметры NameOnShelf и SignatureNameOnShelf, параметры Content и Signature не указываются
//
Функция DD_API_DS_SignedContent(Content = Неопределено,
