//  SignerCertificate			 - Строка		 - Двоичные данные сертификата закодированные по алгоритму base64
//  SignerCertificateThumbprint	 - Строка		 - Отпечаток сертификата
//  SignerDetails				 - Структура	 - см. функцию DD_API_DS_ExtendedSignerDetails
//
// Если передан параметр BoxId, то с ним необходимо передать один из параметров SignerCertificate или SignerCertificateThumbprint
// Если передан параметр SignerDetails, то остальные параметры являются не обязательными
//
Функция DD_API_DS_ExtendedSigner(BoxId = Неопределено,
								 SignerCertificate = Неопределено,
								 SignerCertificateThumbprint = Неопределено,
								 SignerDetails = Неопределено) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/proto/utd/ExtendedSigner.html
	
	Результат = Новый Структура;
	
	Если ЗначениеЗаполнено(BoxId) И ЗначениеЗаполнено(SignerCertificate) Тогда
		Результат.Вставить("BoxId",				 BoxId);
		Результат.Вставить("SignerCertificate",	 SignerCertificate);
	ИначеЕсли ЗначениеЗаполнено(BoxId) И ЗначениеЗаполнено(SignerCertificateThumbprint) Тогда
		Результат.Вставить("BoxId",							 BoxId);
		Результат.Вставить("SignerCertificateThumbprint",	 SignerCertificateThumbprint);
	ИначеЕсли ЗначениеЗаполнено(SignerDetails) Тогда
		Результат.Вставить("SignerDetails", SignerDetails);
	Иначе
		ВызватьИсключение "Указаны неверные параметры при инициализации структуры ExtendedSigner";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

