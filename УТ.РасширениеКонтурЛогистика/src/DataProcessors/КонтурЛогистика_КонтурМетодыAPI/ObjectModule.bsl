//  SignerStatus	 - Строка	 - см. http://api-docs.diadoc.ru/ru/latest/proto/utd/ExtendedSignerDetailsToPost.html?highlight=SignerStatus
//
Функция DD_API_DS_ExtendedSignerDetailsToPost(SignerType, SignerPowers, SignerStatus,
											  JobTitle = Неопределено,
											  SignerInfo = Неопределено,
											  SignerPowersBase = Неопределено,
											  SignerOrgPowersBase = Неопределено,
											  RegistrationCertificate = Неопределено) Экспорт
	
	// http://api-docs.diadoc.ru/ru/latest/proto/utd/ExtendedSignerDetailsToPost.html?highlight=ExtendedSignerToPost
	
	Результат = Новый Структура;
	Результат.Вставить("SignerType",	SignerType);
	Результат.Вставить("SignerPowers",	SignerPowers);
	Результат.Вставить("SignerStatus",	SignerStatus);
	
	Если ЗначениеЗаполнено(JobTitle) Тогда
		Результат.Вставить("JobTitle", JobTitle);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(SignerInfo) Тогда
		Результат.Вставить("SignerInfo", SignerInfo);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(SignerPowersBase) Тогда
		Результат.Вставить("SignerPowersBase", SignerPowersBase);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(SignerOrgPowersBase) Тогда
		Результат.Вставить("SignerOrgPowersBase", SignerOrgPowersBase);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(RegistrationCertificate) Тогда
		Результат.Вставить("RegistrationCertificate", RegistrationCertificate);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру для получения списка событий
//
// Параметры
//  Filter	 - Структура	 - см. функцию DD_API_DS_TimeBasedFilter
//
Функция DD_API_DS_GetDocflowEventsRequest(Filter, AfterIndexKey = "", PopulateDocuments = false, InjectEntityContent = false, PopulatePreviousDocumentStates = false, DepartmentId = Неопределено) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/proto/GetDocflowEventsRequest.html
	
	Результат = Новый Структура;
	Результат.Вставить("Filter", Filter);
	
	Если ЗначениеЗаполнено(AfterIndexKey) Тогда
		Результат.Вставить("AfterIndexKey", AfterIndexKey);
	КонецЕсли;
	
	Если PopulateDocuments = Истина Тогда
		Результат.Вставить("PopulateDocuments", Истина);
	КонецЕсли;
	
	Если InjectEntityContent = Истина Тогда
		Результат.Вставить("InjectEntityContent", Истина);
	КонецЕсли;
	
