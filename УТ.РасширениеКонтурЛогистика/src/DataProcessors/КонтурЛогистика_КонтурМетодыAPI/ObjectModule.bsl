	Результат.Вставить("OrgId", OrgId);
	Результат.Вставить("Inn", Inn);
	Результат.Вставить("FullName", FullName);
	Результат.Вставить("Boxes", Новый Массив);
	Результат.Вставить("Department", Новый Массив);
	Результат.Вставить("Sociability", Sociability);
	
	Результат.Boxes.Добавить(DD_API_DS_Box(BoxId, FullName));
	
	Возврат Результат;
	
