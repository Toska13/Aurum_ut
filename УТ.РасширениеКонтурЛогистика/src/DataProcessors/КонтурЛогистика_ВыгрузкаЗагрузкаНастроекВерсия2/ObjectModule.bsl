Перем мМассивТиповНастроек;
Перем мОбъектыДляВыгрузки;

Перем тзОбъектыДляЗагрузки;
Перем мДопУИДыДляЗагрузки;
Перем мВсеЗагруженныеУИД;

#Область Выгрузка

Процедура ВыполнитьВыгрузку(Адрес, СтруктураАдресаПМ, ОбъектыДляВыгрузки, ВариантВыгрузки, КаталогВыгрузки, ВыводитьСообщение = Истина) Экспорт
	
	мОбъектыДляВыгрузки = Новый Массив;
	мКонстантыДляВыгрузки = Новый Массив;
	
	Если ВыводитьСообщение Тогда
		ШаблонНачалоВыгрузки = "Начало выгрузки: %Дата";
		СообщениеНачалоВыгрузки = СтрЗаменить(ШаблонНачалоВыгрузки, "%Дата", ТекущаяДатаСеанса());
		Сообщить(СообщениеНачалоВыгрузки);
	КонецЕсли;
	
	Для каждого ОбъектДляВыгрузки Из ОбъектыДляВыгрузки Цикл
		
		Если Не ОбъектДляВыгрузки.Выгружать Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбъектДляВыгрузки.ИмяОбъектаМетаданных = "Константы" Тогда	
			мКонстантыДляВыгрузки.Добавить(ОбъектДляВыгрузки.Ссылка);	
		ИначеЕсли мОбъектыДляВыгрузки.Найти(ОбъектДляВыгрузки.Ссылка) = Неопределено Тогда
			мОбъектыДляВыгрузки.Добавить(ОбъектДляВыгрузки.Ссылка);
			НайтиСсылки(ОбъектДляВыгрузки.Ссылка, ВариантВыгрузки);
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураJSON = Новый Структура;
	
	ВыгрузитьСвойстваКонфигурации(СтруктураJSON);
	ВыгрузитьОпределяемыеТипы(СтруктураJSON);
	ВыгрузитьТипыДокументаОснования(СтруктураJSON);
	ВыгрузитьТипыОбщихКоманд(СтруктураJSON);
	
	мВыгруженныеОбъекты = Новый Массив;
	мВыгруженныеКонстанты = Новый Массив;
	
	// Выгрузим константы
	Для Каждого ИмяКонстанты Из мКонстантыДляВыгрузки Цикл
		
		Попытка
			
			ВыгрузитьКонстанту(мВыгруженныеКонстанты, ИмяКонстанты);
			
		Исключение
			
			Сообщить("Ошибка выгрузки константы """ + ИмяКонстанты + ". " + ОписаниеОшибки()); 
			
 		КонецПопытки;
		
	КонецЦикла;
	
	СтруктураJSON.Вставить("Константы", мВыгруженныеКонстанты);
	
	// Выгрузим справочники
	Для Каждого ПрочаяСсылка Из мОбъектыДляВыгрузки Цикл
		
		Попытка
			
			Структ = ВыгрузитьСсылку(ПрочаяСсылка);
			мВыгруженныеОбъекты.Добавить(Структ);
			
			Если ПрочаяСсылка.Наименование = "Путь до файла обработки epf" Тогда
				ВыгрузитьФайлПМ(ПрочаяСсылка, СтруктураАдресаПМ);	
			КонецЕсли;
			
		Исключение
			
			Сообщить("Ошибка выгрузки объекта """ + ПрочаяСсылка + ". " + ОписаниеОшибки()); 
			
		КонецПопытки;
		
	КонецЦикла;
		
	СтруктураJSON.Вставить("Объекты", мВыгруженныеОбъекты);
	
	// Проверим на недоспустимые типы и удалим ХранилищаЗначений
	Для Каждого ТекущееЗначение Из мВыгруженныеОбъекты Цикл
		ВыявитьНедопустимыйТипИУдалимХранилищаЗначений(ТекущееЗначение);
	КонецЦикла;
	Для Каждого ТекущееЗначение Из мВыгруженныеКонстанты Цикл
		ВыявитьНедопустимыйТипИУдалимХранилищаЗначений(ТекущееЗначение);
	КонецЦикла;
			
	Ядро = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();
	Модуль = Ядро.Модуль_ПарсерJSON(ЭтотОбъект);
	Результат = Модуль.Записать(СтруктураJSON);
	
	ИмяФайла = ПолучитьИмяВременногоФайла("json");
	
	Файл = Новый ТекстовыйДокумент;
	Файл.УстановитьТекст(Результат);
	Файл.Записать(ИмяФайла);
		
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор());
	УдалитьФайлы(ИмяФайла);
	
	Если ВыводитьСообщение Тогда
	
		ШаблонВыгружено = "Выгружено объектов: %Выгружено";
		СообщениеВыгружено = СтрЗаменить(ШаблонВыгружено, "%Выгружено", мОбъектыДляВыгрузки.Количество() + мКонстантыДляВыгрузки.Количество());
		Сообщить(СообщениеВыгружено);
		
		ШаблонОкончание = "Окончание выгрузки: %Дата";
		СообщениеОкончание = СтрЗаменить(ШаблонОкончание, "%Дата", ТекущаяДатаСеанса());
		Сообщить(СообщениеОкончание);
		
		Сообщить("Выгрузка данных успешно завершена");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьСвойстваКонфигурации(СтруктураJSON)

	СвойстваКонфигурации = Новый Структура;
	СвойстваКонфигурации.Вставить("Имя", Метаданные.Имя);
	СвойстваКонфигурации.Вставить("Версия", Метаданные.Версия);
	СвойстваКонфигурации.Вставить("ПодробнаяИнформация", Метаданные.ПодробнаяИнформация);
	
	СтруктураJSON.Вставить("СвойстваКонфигурации", СвойстваКонфигурации);	
	
КонецПроцедуры

Процедура ВыгрузитьОпределяемыеТипы(СтруктураJSON)
	
	Если Метаданные.ОпределяемыеТипы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпределяемыхТипов = Новый Массив;
	
	Для каждого ОпределяемыйТип Из Метаданные.ОпределяемыеТипы Цикл
		
		Если Лев(ОпределяемыйТип.Имя, 16) <> "КонтурЛогистика_" Тогда
			Продолжить;
		КонецЕсли;
		
		Типы = ПолучитьМассивТипов(ОпределяемыйТип.Тип);
				
		СтруктураОпределяемогоТипа = Новый Структура();
		СтруктураОпределяемогоТипа.Вставить("Имя", ОпределяемыйТип.Имя);
		СтруктураОпределяемогоТипа.Вставить("Типы", Типы);
		ТипыОпределяемыхТипов.Добавить(СтруктураОпределяемогоТипа);
		
	КонецЦикла;
	
	Если ТипыОпределяемыхТипов.Количество() > 0 Тогда
		СтруктураJSON.Вставить("ОпределяемыеТипы", ТипыОпределяемыхТипов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьКонстанту(мВыгруженныеКонстанты, ИмяКонстанты)
	
	КонстантаОбъектМетаданных = Метаданные.Константы.Найти(ИмяКонстанты);
	
	Если КонстантаОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Значение = Константы[ИмяКонстанты].Получить();
	
	СтруктураДанныхКонстанты = Новый Структура;
	СтруктураДанныхКонстанты.Вставить("Имя", ИмяКонстанты);
	СтруктураДанныхКонстанты.Вставить("Тип", КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеТипа_(ТипЗнч(Значение)));
	СтруктураДанныхКонстанты.Вставить("Значение", ВыгрузитьЗначение(Значение));
	СтруктураДанныхКонстанты.Вставить("Синоним", КонстантаОбъектМетаданных.Синоним);
	мВыгруженныеКонстанты.Добавить(СтруктураДанныхКонстанты);
		
КонецПроцедуры

Процедура ВыгрузитьТипыДокументаОснования(СтруктураJSON)
	
	ТипыДокументаОснования = Новый Массив;
	
	Для каждого ДокументОбъектДанных Из Метаданные.Документы Цикл
		
		РеквизитДокументОснование = ДокументОбъектДанных.Реквизиты.Найти("ДокументОснование");
		
		Если Лев(ДокументОбъектДанных.Имя, 16) <> "КонтурЛогистика_"
			Или РеквизитДокументОснование = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Типы = ПолучитьМассивТипов(РеквизитДокументОснование.Тип);
				
		СтруктураТипаДокументаОснования = Новый Структура();
		СтруктураТипаДокументаОснования.Вставить("ИмяДокумента", ДокументОбъектДанных.Имя);
		СтруктураТипаДокументаОснования.Вставить("Типы", Типы);
		ТипыДокументаОснования.Добавить(СтруктураТипаДокументаОснования);
		
	КонецЦикла;
	
	Если ТипыДокументаОснования.Количество() > 0 Тогда
		СтруктураJSON.Вставить("ТипыДокументаОснования", ТипыДокументаОснования);
	КонецЕсли;
		
КонецПроцедуры

Процедура ВыгрузитьТипыОбщихКоманд(СтруктураJSON)
		
	ТипыОбщихКоманд = Новый Массив;
	
	Для каждого ОбщаяКоманда Из Метаданные.ОбщиеКоманды Цикл
		
		Если Лев(ОбщаяКоманда.Имя, 16) <> "КонтурЛогистика_" Тогда
			Продолжить;
		КонецЕсли;
		
		Типы = ПолучитьМассивТипов(ОбщаяКоманда.ТипПараметраКоманды);
				
		СтруктураТипаОбщейКоманды = Новый Структура();
		СтруктураТипаОбщейКоманды.Вставить("Имя", ОбщаяКоманда.Имя);
		СтруктураТипаОбщейКоманды.Вставить("Типы", Типы);
		ТипыОбщихКоманд.Добавить(СтруктураТипаОбщейКоманды); 
		
	КонецЦикла;			
	
	Если ТипыОбщихКоманд.Количество() > 0 Тогда
		СтруктураJSON.Вставить("ОбщиеКоманды", ТипыОбщихКоманд);
	КонецЕсли;
		
КонецПроцедуры

Процедура ВыявитьНедопустимыйТипИУдалимХранилищаЗначений(ВходныеДанные)
	
	ТипЗначениея = ТипЗнч(ВходныеДанные);
	
	Если ТипЗначениея = Тип("Массив") Тогда
		Для Каждого ТекущееЗначение Из ВходныеДанные Цикл
			ВыявитьНедопустимыйТипИУдалимХранилищаЗначений(ТекущееЗначение);
			ДанныеНаУдаление = Новый Массив;
			Если ТипЗнч(ТекущееЗначение) = Тип("ХранилищеЗначения") Тогда
				ДанныеНаУдаление.Добавить(ТекущееЗначение);
			КонецЕсли;
			Для Каждого ТекущееЗначениеНаУдаление Из ДанныеНаУдаление Цикл
				ВходныеДанные.Удалить(ТекущееЗначениеНаУдаление);
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ТипЗначениея = Тип("Структура") Тогда
		Для Каждого ТекущаяСтрока Из ВходныеДанные Цикл
			Если ТипЗнч(ТекущаяСтрока.Значение) = Тип("ХранилищеЗначения") Тогда
				ВходныеДанные.Вставить(ТекущаяСтрока.Ключ, Неопределено);
			Иначе
				ВыявитьНедопустимыйТипИУдалимХранилищаЗначений(ТекущаяСтрока.Значение);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗначениея = Тип("Булево")
		Или ТипЗначениея = Тип("Число")
		Или ТипЗначениея = Тип("Строка")
		Или ТипЗначениея = Тип("Дата")
		Или ВходныеДанные = Неопределено Тогда
		
		Возврат;
	Иначе
		// Что-то не так
		ТекстСообщения = "Тип: " + Строка(ТипЗначениея);
		Попытка
			ТекстСообщения = ТекстСообщения + ", значение: " + Строка(ВходныеДанные);
		Исключение
			ТекстСообщения = ТекстСообщения + ", не удалось определить значение.";
		КонецПопытки;
		Сообщить(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСсылки(Значение, ВариантВыгрузки)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	
	Если ОбъектМетаданных.Иерархический И ЗначениеЗаполнено(Значение.Родитель) Тогда
		
		Если мОбъектыДляВыгрузки.Найти(Значение.Родитель) = Неопределено Тогда
			мОбъектыДляВыгрузки.Добавить(Значение.Родитель);
			НайтиСсылки(Значение.Родитель, ВариантВыгрузки);
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		// Может попасться план видов характеристик - у него нет владельцев, а понять что перед нами
		// в переменной Значение здесь он проблематично
		// Решение - не проверять, упасть и пропустить выгрузку владельца, которого у ПВХ нет
		Если ОбъектМетаданных.Владельцы.Количество() > 0 И ЗначениеЗаполнено(Значение.Владелец) Тогда
			
			Если мОбъектыДляВыгрузки.Найти(Значение.Владелец) = Неопределено Тогда
				мОбъектыДляВыгрузки.Добавить(Значение.Владелец);
				НайтиСсылки(Значение.Владелец, ВариантВыгрузки);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
	Для каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		
		Если Не ЗначениеЗаполнено(Значение[Реквизит.Имя]) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗнч(Значение[Реквизит.Имя]));
		Если ОбъектМД <> Неопределено И Метаданные.Справочники.Содержит(ОбъектМД) Тогда
			
			Если ВариантВыгрузки = "ТолькоНастройки" И мМассивТиповНастроек.Найти(ТипЗнч(Значение[Реквизит.Имя])) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если мОбъектыДляВыгрузки.Найти(Значение[Реквизит.Имя]) = Неопределено Тогда
				мОбъектыДляВыгрузки.Добавить(Значение[Реквизит.Имя]);
				НайтиСсылки(Значение[Реквизит.Имя], ВариантВыгрузки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
		
		Если ОбъектМетаданных.Имя ="КонтурЛогистика_ОрганизацииДиадок" 
			И ТЧ.Имя = "Контрагенты"
			И Не Настройка_ВыгружатьТаблицуКонтрагентыВОрганизацииДД Тогда
			
			Продолжить;
		КонецЕсли;
		
		Для каждого Стр Из Значение[ТЧ.Имя] Цикл 
			
			Для каждого Реквизит Из ТЧ.Реквизиты Цикл
				
				Если Не ЗначениеЗаполнено(Стр[Реквизит.Имя]) Тогда
					Продолжить;
				КонецЕсли;
				
				ОбъектМД = Метаданные.НайтиПоТипу(ТипЗнч(Стр[Реквизит.Имя]));
				Если ОбъектМД <> Неопределено И Метаданные.Справочники.Содержит(ОбъектМД) Тогда
					
					Если ВариантВыгрузки = "ТолькоНастройки" И мМассивТиповНастроек.Найти(ТипЗнч(Стр[Реквизит.Имя])) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Если мОбъектыДляВыгрузки.Найти(Стр[Реквизит.Имя]) = Неопределено Тогда
						мОбъектыДляВыгрузки.Добавить(Стр[Реквизит.Имя]);
						НайтиСсылки(Стр[Реквизит.Имя], ВариантВыгрузки);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВыгрузитьЗначение(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") И Значение = 0 Тогда
		Возврат "0";
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если ОбъектМетаданных <> Неопределено И (Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.Документы.Содержит(ОбъектМетаданных) 
		Или Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных)) Тогда
		
		Возврат Строка(Значение.УникальныйИдентификатор());
		
	ИначеЕсли ОбъектМетаданных <> Неопределено И Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		
		Возврат Строка(ПолучитьИмяПеречисления(ОбъектМетаданных, Значение));
		
	ИначеЕсли ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда 
		
		Возврат Значение;
		
	Иначе
		
		Возврат Строка(Значение);
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИмяПеречисления(ОбъектМетаданных, Значение)
	
	Возврат ОбъектМетаданных.ЗначенияПеречисления.Получить(Перечисления[ОбъектМетаданных.Имя].Индекс(Значение)).Имя;
	
КонецФункции

Функция ВыгрузитьСсылку(Ссылка)
	
	СтруктураСправочника = Новый Структура;
	СтруктураСправочника.Вставить("УИД", Строка(Ссылка.УникальныйИдентификатор()));
	СтруктураСправочника.Вставить("Тип", КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеТипа_(ТипЗнч(Ссылка)));
	СтруктураСправочника.Вставить("ЭтоГруппа", Строка(Ссылка.ЭтоГруппа));
	
	МассивРеквизиты = Новый Массив;
	МассивТабличныеЧасти = Новый Массив;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектМетаданных.Имя = "КонтурЛогистика_НастройкиДополнительныхРеквизитов" Тогда                                                         
		Путь = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьПутьОтРодителяКЭлементу(Ссылка);
		СтруктураСправочника.Вставить("ПутьКЭлементу", Путь);		
	КонецЕсли;
	
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		
		Если ОбъектМетаданных.ДлинаНаименования > 0 Тогда
			
			СтруктураРеквизита = Новый Структура;
			СтруктураРеквизита.Вставить("Имя", "Наименование");
			СтруктураРеквизита.Вставить("Тип", "Строка");
			СтруктураРеквизита.Вставить("Значение", Ссылка.Наименование);
			
			МассивРеквизиты.Добавить(СтруктураРеквизита);
			
		КонецЕсли;
		
		Если ОбъектМетаданных.ДлинаКода > 0 Тогда
			
			СтруктураРеквизита = Новый Структура;
			СтруктураРеквизита.Вставить("Имя", "Код");
			СтруктураРеквизита.Вставить("Тип", Строка(ОбъектМетаданных.ТипКода));
			СтруктураРеквизита.Вставить("Значение", Ссылка.Код);
			
			МассивРеквизиты.Добавить(СтруктураРеквизита);
			
		КонецЕсли;
		
		Если ОбъектМетаданных.Иерархический Тогда
			
			СтруктураРеквизита = Новый Структура;
			СтруктураРеквизита.Вставить("Имя", "Родитель");
			СтруктураРеквизита.Вставить("Тип", КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеТипа_(ТипЗнч(Ссылка)));
			СтруктураРеквизита.Вставить("Значение", Строка(Ссылка.Родитель.УникальныйИдентификатор()));
			
			МассивРеквизиты.Добавить(СтруктураРеквизита);
			
		КонецЕсли;
		
		Если ОбъектМетаданных.Владельцы.Количество() > 0 Тогда
			
			СтруктураРеквизита = Новый Структура;
			СтруктураРеквизита.Вставить("Имя", "Владелец");
			СтруктураРеквизита.Вставить("Тип", КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеТипа_(ТипЗнч(Ссылка.Владелец)));
			СтруктураРеквизита.Вставить("Значение", Строка(Ссылка.Владелец.УникальныйИдентификатор()));
			
			МассивРеквизиты.Добавить(СтруктураРеквизита);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		
		Если Ссылка.ЭтоГруппа И Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		СтроковоеПредставление = КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеТипа_(ТипЗнч(Ссылка[Реквизит.Имя]));
		ЗначениеРеквизита = ВыгрузитьЗначение(Ссылка[Реквизит.Имя]);
		
		СтруктураРеквизита = Новый Структура;
		СтруктураРеквизита.Вставить("Имя", Реквизит.Имя);
		СтруктураРеквизита.Вставить("Тип", СтроковоеПредставление);
		СтруктураРеквизита.Вставить("Значение", ЗначениеРеквизита);
		
		Если СтроковоеПредставление = "ХранилищеЗначения" Тогда 
			СтруктураРеквизита.Вставить("Значение", Неопределено);
		КонецЕсли;
		
		МассивРеквизиты.Добавить(СтруктураРеквизита);
		
	КонецЦикла;
	
	СтруктураСправочника.Вставить("Реквизиты", МассивРеквизиты);
	
	Для каждого ТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
		
		Если Ссылка.ЭтоГруппа И ТЧ.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбъектМетаданных.Имя ="КонтурЛогистика_ОрганизацииДиадок" 
			И ТЧ.Имя = "Контрагенты"
			И Не Настройка_ВыгружатьТаблицуКонтрагентыВОрганизацииДД Тогда
			Продолжить;	
		КонецЕсли;
		
		СтруктураТЧ = Новый Структура;
		СтруктураТЧ.Вставить("Имя", ТЧ.Имя);
		
		МассивСтрокиТЧ = Новый Массив;
		
		Для каждого Стр Из Ссылка[ТЧ.Имя] Цикл 
			
			МассивРеквизиты = Новый Массив;
			
			Для каждого Реквизит Из ТЧ.Реквизиты Цикл
			
				СтруктураРеквизита = Новый Структура;
				СтруктураРеквизита.Вставить("Имя", Реквизит.Имя);
				СтруктураРеквизита.Вставить("Тип", КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеТипа_(ТипЗнч(Стр[Реквизит.Имя])));
				СтруктураРеквизита.Вставить("Значение", ВыгрузитьЗначение(Стр[Реквизит.Имя]));
				
				Если СтроковоеПредставление = "ХранилищеЗначения" Тогда
					СтруктураРеквизита.Вставить("Значение", Неопределено);
				КонецЕсли;
				
				МассивРеквизиты.Добавить(СтруктураРеквизита);
				
			КонецЦикла;
			
			МассивСтрокиТЧ.Добавить(МассивРеквизиты);
			
		КонецЦикла;
		
		СтруктураТЧ.Вставить("СтрокиТЧ", МассивСтрокиТЧ);
			
		МассивТабличныеЧасти.Добавить(СтруктураТЧ);
		
	КонецЦикла;
	
	СтруктураСправочника.Вставить("ТабличныеЧасти", МассивТабличныеЧасти);	
	
	Возврат СтруктураСправочника;
	
КонецФункции

Процедура ВыгрузитьФайлПМ(Ссылка, СтруктураАдресаПМ)
	
	ЗначениеЭлемента = Ссылка.Значение;
	
	Если Ссылка.ТипЗначения = "Строка" Тогда
		
		Если Не ЗначениеЗаполнено(ЗначениеЭлемента) Тогда
			Возврат;
		КонецЕсли;
		
		МассивПутиФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ЗначениеЭлемента, "\");
		ПоследнийЭлемент = МассивПутиФайла.Количество() - 1;
		СтруктураАдресаПМ.Вставить("ИмяФайлаВыгрузки", МассивПутиФайла[ПоследнийЭлемент]);
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ЗначениеЭлемента);
		СтруктураАдресаПМ.Вставить("АдресПМ", ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор()));
		
	Иначе
		
		ДвоичныеДанные = ЗначениеЭлемента.ХранилищеВнешнейОбработки.Получить();
		
		Если Не ДвоичныеДанные = Неопределено Тогда
			СтруктураАдресаПМ.Вставить("АдресПМ", ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор()));
			СтруктураАдресаПМ.Вставить("ИмяФайлаВыгрузки", ЗначениеЭлемента.Наименование + ".epf");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Загрузка

Процедура ВыполнитьЗагрузку(СтруктураJSON, ОбъектыДляЗагрузки = Неопределено, ЗагрузитьВсе, Загружено, ЖурналВыгрузкиЗагрузки = Неопределено) Экспорт
	
	тзОбъектыДляЗагрузки = Новый ТаблицаЗначений;
	тзОбъектыДляЗагрузки.Колонки.Добавить("Наименование");
	тзОбъектыДляЗагрузки.Колонки.Добавить("Загружать");
	тзОбъектыДляЗагрузки.Колонки.Добавить("Данные");
	тзОбъектыДляЗагрузки.Колонки.Добавить("УИД");
	тзОбъектыДляЗагрузки.Колонки.Добавить("НайденноеЗначение");
	
	// Добавляем объекты из JSON в таблицу значений
	Для каждого ОбъектДляЗагрузки Из СтруктураJSON.Объекты Цикл
		
		НоваяСтрока = тзОбъектыДляЗагрузки.Добавить();
		НоваяСтрока.УИД = ОбъектДляЗагрузки.УИД;
		НоваяСтрока.Данные = ОбъектДляЗагрузки;
		
		Если ОбъектДляЗагрузки.ЭтоГруппа = "Нет" Тогда
			СтруктураДляПоиска = СтруктураДляПоиска(ОбъектДляЗагрузки.Тип);
		Иначе
			СтруктураДляПоиска = СтруктураДляПоискаГруппы(ОбъектДляЗагрузки.Тип);
		КонецЕсли;
		
		Если ЗагрузитьВсе Тогда
			
			НоваяСтрока.Загружать = Истина;
			НоваяСтрока.НайденноеЗначение = НайтиОбъектПоПолямПоиска(ОбъектДляЗагрузки, СтруктураДляПоиска, Ложь);
			
		Иначе
			
			НайденныеСтроки = ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("УИД, Загружать", ОбъектДляЗагрузки.УИД, Истина));
			
			НоваяСтрока.Загружать = (НайденныеСтроки.Количество() <> 0);
			НоваяСтрока.НайденноеЗначение = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Ссылка, Неопределено);
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.НайденноеЗначение)
				Или мМассивТиповНастроек.Найти(Тип(ОбъектДляЗагрузки.Тип)) <> Неопределено Тогда
				
				НоваяСтрока.НайденноеЗначение = НайтиОбъектПоПолямПоиска(ОбъектДляЗагрузки, СтруктураДляПоиска, Ложь);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Загружаем не загруженные ранее объекты
	Для каждого ОбъектЗагрузки Из тзОбъектыДляЗагрузки Цикл
		
		Если Не ОбъектЗагрузки.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		ЗагрузитьОбъект(ОбъектЗагрузки, ЖурналВыгрузкиЗагрузки);
		
		мВсеЗагруженныеУИД.Добавить(ОбъектЗагрузки.УИД);
		
		Загружено = Загружено + 1;
		
	КонецЦикла;
	
	// Загрузим дополнительные ссылки из настроек
	Пока мДопУИДыДляЗагрузки.Количество() > 0 Цикл
		
		мДопУИДыДляЗагрузкиКопия = мДопУИДыДляЗагрузки.Скопировать();
		мДопУИДыДляЗагрузки.Очистить();
		
		Для каждого УИД Из мДопУИДыДляЗагрузкиКопия Цикл
			
			Если мВсеЗагруженныеУИД.Найти(УИД.Значение) = Неопределено Тогда
				
				ОбъектДляЗагрузки = тзОбъектыДляЗагрузки.Найти(УИД.Значение, "УИД");
				Если ОбъектДляЗагрузки <> Неопределено Тогда
					
					ЗагрузитьОбъект(ОбъектДляЗагрузки, ЖурналВыгрузкиЗагрузки);
					
					мВсеЗагруженныеУИД.Добавить(УИД.Значение);
					
					Загружено = Загружено + 1;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ОбъектыДляЗагрузки <> Неопределено Тогда
		
		Для Каждого ОбъектДляЗагрузки Из ОбъектыДляЗагрузки Цикл
			
			Если Не ОбъектДляЗагрузки.Загружать Тогда
				Продолжить;
			КонецЕсли;
			
			НайдСтр = тзОбъектыДляЗагрузки.Найти(ОбъектДляЗагрузки.УИД, "УИД");
			Если НайдСтр <> Неопределено И ЗначениеЗаполнено(НайдСтр.НайденноеЗначение) Тогда
				ОбъектДляЗагрузки.Ссылка = НайдСтр.НайденноеЗначение;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьОбъект(СтруктураДанных, ЖурналВыгрузкиЗагрузки)
	
	ОбъектДляЗагрузки = СтруктураДанных.Данные;
	
	Тип = Тип(ОбъектДляЗагрузки.Тип);
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерОбъекта = ПолучитьМенеджерОбъекта(ОбъектМетаданных);
	
	Если МенеджерОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.НайденноеЗначение) Тогда
		
		// Не будем перезаполнять объекты метаданных, если они уже есть
		Если Не ЭтоОбъектМетаданныхЛогистики(ОбъектМетаданных.Имя) Тогда
			Возврат;
		КонецЕсли;
		
		НайденнаяСсылка = СтруктураДанных.НайденноеЗначение;
		
	Иначе
		
		Если Настройка_СоздаватьОбъектыУчетнойСистемы
			Или ЭтоОбъектМетаданныхЛогистики(ОбъектМетаданных.Имя) Тогда
			
			НайденнаяСсылка = Неопределено;
			
		Иначе
			
			// Если не создавать, то вывесим оповещение об этом
			Если ЖурналВыгрузкиЗагрузки = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ТекстСообщения = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
				"Не удалось найти объект с типом: ""%1"", УИД: ""%2""",
				СтруктураДанных.Данные.Тип, СтруктураДанных.Данные.УИД);
			
			НоваяСтрока = ЖурналВыгрузкиЗагрузки.Добавить();
			НоваяСтрока.Сообщение = ТекстСообщения;
			НоваяСтрока.ПредставлениеОбъектаМетаданных = СтруктураДанных.Данные.Тип;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		
		НайдОбъект = НайденнаяСсылка.ПолучитьОбъект();
		
	Иначе
		
		НайденнаяСсылка = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектДляЗагрузки.УИД));
		НайдОбъект = НайденнаяСсылка.ПолучитьОбъект();
		
		Если НайдОбъект = Неопределено Тогда
		
			Если ОбъектДляЗагрузки.ЭтоГруппа = "Да" Тогда
				НайдОбъект = МенеджерОбъекта.СоздатьГруппу();
			Иначе
				НайдОбъект = МенеджерОбъекта.СоздатьЭлемент();
			КонецЕсли;
			
			НайдОбъект.УстановитьСсылкуНового(НайденнаяСсылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	МассивРеквизитовИсточник = Новый Массив;
	
	Для каждого Реквизит Из ОбъектДляЗагрузки.Реквизиты Цикл
		
		МассивРеквизитовИсточник.Добавить(Реквизит.Имя);
		
		Если (ОбъектДляЗагрузки.ЭтоГруппа = "Да" И Реквизит.Тип = "Null")
			Или Не ЕстьРеквизитУОбъекта(ОбъектДляЗагрузки, НайдОбъект, Реквизит.Имя, ЖурналВыгрузкиЗагрузки) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НайдОбъект[Реквизит.Имя] = ЗагрузитьРеквизит(ОбъектДляЗагрузки, Реквизит, НайдОбъект,,, ЖурналВыгрузкиЗагрузки);
		
	КонецЦикла;
	
	ПроверкаНаличияРеквизитов(МассивРеквизитовИсточник, ОбъектДляЗагрузки, НайдОбъект,,, ЖурналВыгрузкиЗагрузки);
	
	Для каждого ТЧ Из ОбъектДляЗагрузки.ТабличныеЧасти Цикл
		
		Если ЖурналВыгрузкиЗагрузки <> Неопределено
			И НайдОбъект.Метаданные().ТабличныеЧасти.Найти(ТЧ.Имя) = Неопределено Тогда
			
			Предупреждение = "Табличная часть " + ТЧ.Имя + " не была загружен, так как отсутствует в конфигурации";
			ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, НайдОбъект);
			
			Продолжить;
			
		КонецЕсли;
		
		МассивРеквизитовТЧИсточник = Новый Массив;
		
		НайдОбъект[ТЧ.Имя].Очистить();
		
		Для каждого СтрокаТЧ Из ТЧ.СтрокиТЧ Цикл
			
			НоваяСтрока = НайдОбъект[ТЧ.Имя].Добавить();
			
			Для каждого Реквизит Из СтрокаТЧ Цикл
				
				МассивРеквизитовТЧИсточник.Добавить(Реквизит.Имя);
				
				Если Не ЕстьРеквизитТЧУОбъекта(ОбъектДляЗагрузки, НайдОбъект,
					ТЧ.Имя, Реквизит.Имя, НоваяСтрока.НомерСтроки, ЖурналВыгрузкиЗагрузки) Тогда
					
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока[Реквизит.Имя] = ЗагрузитьРеквизит(
					ОбъектДляЗагрузки, Реквизит, НайдОбъект, ТЧ, НоваяСтрока.НомерСтроки, ЖурналВыгрузкиЗагрузки);
				
			КонецЦикла;
			
			ПроверкаНаличияРеквизитов(МассивРеквизитовИсточник, ОбъектДляЗагрузки, НайдОбъект,
				ТЧ.Имя, МассивРеквизитовТЧИсточник, ЖурналВыгрузкиЗагрузки);
			
		КонецЦикла;
		
	КонецЦикла;
	
	НайдОбъект.ОбменДанными.Загрузка = Истина;
	
	НайдОбъект.Записать();
	
	НайдСтр = тзОбъектыДляЗагрузки.Найти(СтруктураДанных.УИД, "УИД");
	Если НайдСтр <> Неопределено И НайдСтр.Загружать И Не ЗначениеЗаполнено(НайдСтр.НайденноеЗначение) Тогда
		НайдСтр.НайденноеЗначение = НайдОбъект.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверкаНаличияРеквизитов(МассивРеквизитовИсточник, ОбъектДляЗагрузки, НайдОбъект, ИмяТЧ = Неопределено, МассивРеквизитовТЧИсточник = Неопределено, ЖурналВыгрузкиЗагрузки)
	
	Если НайдОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивРеквизитовТЧИсточник) Тогда
		
		МассивРеквизитовТЧПриемник = Новый Массив;
		Для каждого Реквизит Из НайдОбъект.МетаДанные().ТабличныеЧасти[ИмяТЧ].Реквизиты Цикл
			МассивРеквизитовТЧПриемник.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Для каждого Реквизит Из МассивРеквизитовТЧПриемник Цикл
			
			Если ЖурналВыгрузкиЗагрузки <> Неопределено И МассивРеквизитовТЧИсточник.Найти(Реквизит) = Неопределено Тогда
				Предупреждение = "В табличной части " + ИмяТЧ + " реквизит " + Реквизит
					+ " не был заполнен, так как отсутствует в файле выгрузки";
				ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, НайдОбъект);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		МассивРеквизитовПриемник = Новый Массив;
		Для каждого Реквизит Из НайдОбъект.МетаДанные().Реквизиты Цикл
			МассивРеквизитовПриемник.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Для каждого Реквизит Из МассивРеквизитовПриемник Цикл
			
			Если ЖурналВыгрузкиЗагрузки <> Неопределено И МассивРеквизитовИсточник.Найти(Реквизит) = Неопределено Тогда
				Предупреждение = "Реквизит " + Реквизит + " не был заполнен, так как отсутствует в файле выгрузки";
				ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, НайдОбъект);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьРеквизитУОбъекта(ОбъектДляЗагрузки, ЗагружаемыйОбъект, ИмяРеквизита, ЖурналВыгрузкиЗагрузки)
	
	Если ЗагружаемыйОбъект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено
		Или (ИмяРеквизита = "Наименование" И ЗагружаемыйОбъект.Метаданные().ДлинаНаименования > 0)
		Или (ИмяРеквизита = "Код" И ЗагружаемыйОбъект.Метаданные().ДлинаКода > 0) 
		Или (ИмяРеквизита = "Родитель" И ЗагружаемыйОбъект.Метаданные().Иерархический) 
		Или (ИмяРеквизита = "Владелец" И ЗагружаемыйОбъект.Метаданные().Владельцы.Количество() > 0) Тогда
		
		Возврат Истина;
		
	Иначе
		
		Если ЖурналВыгрузкиЗагрузки <> Неопределено Тогда
			
			Предупреждение = "Реквизит " + ИмяРеквизита + " не был загружен, так как отсутствует в конфигурации";
			ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, ЗагружаемыйОбъект);
			
		КонецЕсли;
			
		Возврат Ложь;
		
	КонецЕсли;
	
Конецфункции

Функция ЕстьРеквизитТЧУОбъекта(ОбъектДляЗагрузки, ЗагружаемыйОбъект, ИмяТЧ, ИмяРеквизита, НомерСтроки, ЖурналВыгрузкиЗагрузки)
	
	Если ЗагружаемыйОбъект.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		
		Возврат Истина;
		
	Иначе
		
		Если ЖурналВыгрузкиЗагрузки <> Неопределено Тогда
			
			Предупреждение = "В табличной части """ + ИмяТЧ + """ в строке " + Строка(НомерСтроки) + " не загрузился реквизит """ + ИмяРеквизита + """. В конфигурации отсутствует реквизит";
			ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, ЗагружаемыйОбъект);
			
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецЕсли;
	
Конецфункции

Функция ЗагрузитьРеквизит(ОбъектДляЗагрузки, Реквизит, ЗагружаемыйОбъект, ТЧ = Неопределено, НомерСтроки = Неопределено, ЖурналВыгрузкиЗагрузки)
	
	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(Реквизит.Тип));
	Исключение
		Сообщить("Ошибка загрузки реквизита: """ + Реквизит.Тип + ". Тип реквизита отсутствует в метаданных");
		Возврат "";
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Реквизит.Значение) И Реквизит.Тип = "Неопределено" Тогда
		Возврат Неопределено;
	ИначеЕсли Не ЗначениеЗаполнено(Реквизит.Значение) 
		И ОбъектМетаданных <> Неопределено Тогда
		
		Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Возврат Справочники[ОбъектМетаданных.Имя].ПустаяСсылка();
		ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
			Возврат Документы[ОбъектМетаданных.Имя].ПустаяСсылка();
		ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Возврат Перечисления[ОбъектМетаданных.Имя].ПустаяСсылка();	
		Иначе
			Возврат ""
		КонецЕсли;
		
	ИначеЕсли Не ЗначениеЗаполнено(Реквизит.Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЖурналВыгрузкиЗагрузки <> Неопределено И Реквизит.Имя = "ВыражениеВычисленияУИД" Тогда
		
		Предупреждение = "В табличной части """ + ТЧ.Имя + """ в строке " + Строка(НомерСтроки)
			+ " не загрузился реквизит """ + Реквизит.Имя + """. Объекты учетной системы не переносятся";
		ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, ЗагружаемыйОбъект);
		
		Возврат "";
		
	КонецЕсли;
	
	Если Тип(Реквизит.Тип) = Тип("Строка") Тогда
		Возврат Реквизит.Значение;
	ИначеЕсли Тип(Реквизит.Тип) = Тип("Число") Тогда
		Возврат Число(Реквизит.Значение);
	ИначеЕсли Тип(Реквизит.Тип) = Тип("Дата") Тогда
		Возврат Дата(Реквизит.Значение);
	ИначеЕсли Тип(Реквизит.Тип) = Тип("Булево") Тогда
		Возврат ?(Реквизит.Значение = "Да", Истина, Ложь);
	ИначеЕсли ОбъектМетаданных <> Неопределено И Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		
		Если ЖурналВыгрузкиЗагрузки <> Неопределено И Метаданные.Перечисления[ОбъектМетаданных.Имя].ЗначенияПеречисления.Найти(Реквизит.Значение) = Неопределено Тогда
			
			Предупреждение = "У реквизита """ + Реквизит.Имя + """ не найдено значение """ + Реквизит.Значение + """ перечисления """ + ОбъектМетаданных.Имя;
			ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, ЗагружаемыйОбъект);
			
			Возврат Перечисления[ОбъектМетаданных.Имя].ПустаяСсылка();
			
		Иначе
			Возврат Перечисления[ОбъектМетаданных.Имя][Реквизит.Значение];
		КонецЕсли;
		
	ИначеЕсли ОбъектМетаданных <> Неопределено И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		
		НайдСтр = тзОбъектыДляЗагрузки.Найти(Реквизит.Значение, "УИД");
		
		Если НайдСтр <> Неопределено И НайдСтр.НайденноеЗначение <> Неопределено Тогда
			НайдЗнач = НайдСтр.НайденноеЗначение;
		Иначе
			
			НайдЗнач = Справочники[ОбъектМетаданных.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизит.Значение));
			ДобавитьУИДДляДопЗагрузки(Реквизит.Значение, Тип(Реквизит.Тип));
			
			Если Реквизит.Имя <> "Родитель" И НайдЗнач.ПолучитьОбъект() = Неопределено И ЖурналВыгрузкиЗагрузки <> Неопределено Тогда
				ПроверитьНаличиеУИДВВыгрузке(ОбъектДляЗагрузки, Реквизит, ЗагружаемыйОбъект, ТЧ, НомерСтроки, ЖурналВыгрузкиЗагрузки);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат НайдЗнач;
		
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьНаличиеУИДВВыгрузке(ОбъектДляЗагрузки, Реквизит, ЗагружаемыйОбъект, ТЧ = Неопределено, НомерСтроки = Неопределено, ЖурналВыгрузкиЗагрузки)
	
	НайдУИД = тзОбъектыДляЗагрузки.Найти(Реквизит.Значение, "УИД");
	Если НайдУИД = Неопределено Тогда
		
		Если ЗначениеЗаполнено(ТЧ) Тогда
			Предупреждение = "В табличной части " + ТЧ.Имя + " в строке " + Строка(НомерСтроки)
				+ " у реквизита " + Реквизит.Имя + " ссылка <объект не найден>";
		Иначе
			Предупреждение = "У реквизита " + Реквизит.Имя + " ссылка <объект не найден>";
		КонецЕсли;
		ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, ЗагружаемыйОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУИДДляДопЗагрузки(УИД, Тип)
	
	Если УИД = "00000000-0000-0000-0000-000000000000" Тогда
		Возврат;
	КонецЕсли;
	
	Если мДопУИДыДляЗагрузки.НайтиПоЗначению(УИД) = Неопределено Тогда
		мДопУИДыДляЗагрузки.Добавить(УИД);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Чтение

Процедура ПрочитатьПередЗагрузкой(СтруктураJSON, НастройкиЗагрузки, ОбъектыДляЗагрузки, Загружено, ЖурналВыгрузкиЗагрузки) Экспорт

	ПроверитьТипы(СтруктураJSON, ЖурналВыгрузкиЗагрузки);
	
	// Прочитаем константы
	Если СтруктураJSON.Свойство("Константы") Тогда
	
		Для Каждого Константа Из СтруктураJSON.Константы Цикл
			
			КонстантаОбъектМетаданных = Метаданные.Константы.Найти(Константа.Имя);
		
			Если КонстантаОбъектМетаданных = Неопределено Тогда
				Предупреждение = "В конфигурации нет константы """ + Константа.Синоним + """";
				ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, "Константа """ + Константа.Синоним + """");
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ОбъектыДляЗагрузки.Добавить();
			НоваяСтрока.Наименование = КонстантаОбъектМетаданных.Синоним + " (Значение: " + Строка(Константа.Значение) + ")";
			НоваяСтрока.ИмяОбъектаМетаданных = "Список констант";
			НоваяСтрока.ПредставлениеОбъектаМетаданных = "Список констант";
			НоваяСтрока.Ссылка = Константы[Константа.Имя].Получить();
			
			Загружено = Загружено + 1;
			
			Если НастройкиЗагрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", "Список констант")).Количество() = 0 Тогда
				НоваяСтрока = НастройкиЗагрузки.Добавить();
				НоваяСтрока.Загружать = Ложь;
				НоваяСтрока.Наименование = "Список констант";
				НоваяСтрока.ИмяОбъектаМетаданных = "Список констант";
				НоваяСтрока.ПредставлениеОбъектаМетаданных = "Список констант";
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Прочитаем справочники
	Для Каждого ОбъектДляЗагрузки Из СтруктураJSON.Объекты Цикл
		
		Попытка
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(ОбъектДляЗагрузки.Тип));
		Исключение
			Сообщить("Ошибка чтения объекта: """ + ОбъектДляЗагрузки.Тип + ". Тип реквизита отсутствует в метаданных");
			Продолжить;
		КонецПопытки;
		
		НоваяСтрока = ОбъектыДляЗагрузки.Добавить();
		НоваяСтрока.Наименование = НайтиЗначениеРеквизитаВМассивеСтруктур("Наименование", ОбъектДляЗагрузки.Реквизиты);
		НоваяСтрока.ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
		НоваяСтрока.ПредставлениеОбъектаМетаданных = ОбъектМетаданных.Синоним;
		НоваяСтрока.ЭтоГруппа = ?(ОбъектДляЗагрузки.ЭтоГруппа = "Да", Истина, Ложь);
		НоваяСтрока.УИД = ОбъектДляЗагрузки.УИД;
		
		Если ОбъектДляЗагрузки.ЭтоГруппа = "Нет" Тогда
			СтруктураДляПоиска = СтруктураДляПоиска(ОбъектДляЗагрузки.Тип);
		Иначе
			СтруктураДляПоиска = СтруктураДляПоискаГруппы(ОбъектДляЗагрузки.Тип);
		КонецЕсли;
		
		НоваяСтрока.Ссылка = НайтиОбъектПоПолямПоиска(ОбъектДляЗагрузки, СтруктураДляПоиска, Истина, ОбъектыДляЗагрузки);
		
		Если ОбъектДляЗагрузки.Свойство("ПутьКЭлементу") Тогда
			НоваяСтрока.Наименование = НоваяСтрока.Наименование + " (" + ОбъектДляЗагрузки.ПутьКЭлементу + ")";		
		КонецЕсли;
		
		Загружено = Загружено + 1;
		
		Если мМассивТиповНастроек.Найти(Тип(ОбъектДляЗагрузки.Тип)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкиЗагрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", ОбъектМетаданных.Имя)).Количество() = 0 Тогда
			НоваяСтрока = НастройкиЗагрузки.Добавить();
			НоваяСтрока.Загружать = Ложь;
			НоваяСтрока.Наименование = ОбъектМетаданных.Синоним;
			НоваяСтрока.ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
			НоваяСтрока.ПредставлениеОбъектаМетаданных = ОбъектМетаданных.Синоним;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьТипы(СтруктураJSON, ЖурналВыгрузкиЗагрузки)
	
	// Выполним проверку определяемых типов перед загрузкой	
	Если Метаданные.ОпределяемыеТипы.Количество() > 0 И СтруктураJSON.Свойство("ОпределяемыеТипы") Тогда
		
		Для Каждого ОбъектПроверки Из СтруктураJSON.ОпределяемыеТипы Цикл
			
			ИмяОпределяемогоТипа = ОбъектПроверки.Имя;
			
			ОпределяемыйТипОбъектДанных = Метаданные.ОпределяемыеТипы.Найти(ИмяОпределяемогоТипа);
			Если ОпределяемыйТипОбъектДанных = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТипыИсточник = ОбъектПроверки.Типы;
			ТипыПриемник = ПолучитьМассивТипов(ОпределяемыйТипОбъектДанных.Тип);
			
			Если КонтурЛогистика_СтдКоллекцииКлиентСервер.СравнитьКоллекции(ТипыИсточник, ТипыПриемник) <> 0 Тогда
				
				ПодробноеОписание = "";
				Для каждого Тип Из ТипыИсточник Цикл
					Если ТипыПриемник.Найти(Тип) = Неопределено Тогда
						ПодробноеОписание = ПодробноеОписание + "В базе приемнике отсутствует тип " + Тип + " из базы источника" + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
				Для каждого Тип Из ТипыПриемник Цикл
					Если ТипыИсточник.Найти(Тип) = Неопределено Тогда
						ПодробноеОписание = ПодробноеОписание + "В базе источнике отсутствует тип " + Тип + " из базы приемника" + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
				
				ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, "Не совпадают типы у определяемого типа", 
					"Определяемый тип """ + ОпределяемыйТипОбъектДанных.Синоним + """",, ПодробноеОписание);	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Выполним проверку типов документа основания титулов перед загрузкой
	Если СтруктураJSON.Свойство("ТипыДокументаОснования") Тогда
		
		Для Каждого ОбъектПроверки Из СтруктураJSON.ТипыДокументаОснования Цикл
			
			ИмяДокумента = ОбъектПроверки.ИмяДокумента;
			
			ДокументОбъектДанных = Метаданные.Документы.Найти(ИмяДокумента);
			Если ДокументОбъектДанных = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитДокументОснование = ДокументОбъектДанных.Реквизиты.Найти("ДокументОснование");
			Если ДокументОбъектДанных.Реквизиты.Найти("ДокументОснование") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТипыИсточник = ОбъектПроверки.Типы;
			ТипыПриемник = ПолучитьМассивТипов(РеквизитДокументОснование.Тип);
			
			Если КонтурЛогистика_СтдКоллекцииКлиентСервер.СравнитьКоллекции(ТипыИсточник, ТипыПриемник) <> 0 Тогда
				
				ПодробноеОписание = "";
				Для каждого Тип Из ТипыИсточник Цикл
					Если ТипыПриемник.Найти(Тип) = Неопределено Тогда
						ПодробноеОписание = ПодробноеОписание + "В базе приемнике отсутствует тип документа " + Тип + " из базы источника" + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
				Для каждого Тип Из ТипыПриемник Цикл
					Если ТипыИсточник.Найти(Тип) = Неопределено Тогда
						ПодробноеОписание = ПодробноеОписание + "В базе источнике отсутствует тип документа " + Тип + " из базы приемника" + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
				
				ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, "Не совпадают типы у реквизита ДокументОснование", 
					ДокументОбъектДанных.Синоним,, ПодробноеОписание);
											
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Выполним проверку типов общих команд перед загрузкой
	Если СтруктураJSON.Свойство("ОбщиеКоманды") Тогда
		
		Для Каждого ОбъектПроверки Из СтруктураJSON.ОбщиеКоманды Цикл
			
			ИмяОбщейКоманды = ОбъектПроверки.Имя;
			
			ОбщаяКомандаОбъектДанных = Метаданные.ОбщиеКоманды.Найти(ИмяОбщейКоманды);
			Если ОбщаяКомандаОбъектДанных = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТипыИсточник = ОбъектПроверки.Типы;
			ТипыПриемник = ПолучитьМассивТипов(ОбщаяКомандаОбъектДанных.ТипПараметраКоманды);
			
			Если КонтурЛогистика_СтдКоллекцииКлиентСервер.СравнитьКоллекции(ТипыИсточник, ТипыПриемник) <> 0 Тогда
				
				ПодробноеОписание = "";
				Для каждого Тип Из ТипыИсточник Цикл
					Если ТипыПриемник.Найти(Тип) = Неопределено Тогда
						ПодробноеОписание = ПодробноеОписание + "В базе приемнике отсутствует тип " + Тип + " из базы источника" + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
				Для каждого Тип Из ТипыПриемник Цикл
					Если ТипыИсточник.Найти(Тип) = Неопределено Тогда
						ПодробноеОписание = ПодробноеОписание + "В базе источнике отсутствует тип " + Тип + " из базы приемника" + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
				
				ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, "Не совпадают типы у параметра общей команды", 
					"Общая команда """ + ОбщаяКомандаОбъектДанных.Синоним + """",, ПодробноеОписание);	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПредупреждение(ЖурналВыгрузкиЗагрузки, Предупреждение, ОбъектДляЗагрузки, ЗагружаемыйОбъект = Неопределено, ПодробноеОписание = "")
	
	НоваяСтрока = ЖурналВыгрузкиЗагрузки.Добавить();
	НоваяСтрока.Сообщение = Предупреждение;
	
	Если ТипЗнч(ОбъектДляЗагрузки) = Тип("Строка") Тогда
		
		НоваяСтрока.ПредставлениеОбъектаМетаданных = ОбъектДляЗагрузки;
		НоваяСтрока.Ссылка = ОбъектДляЗагрузки; 
		
	Иначе
		
		НоваяСтрока.ПредставлениеОбъектаМетаданных = ЗагружаемыйОбъект.Метаданные().Синоним;
		
		Если ЗначениеЗаполнено(ЗагружаемыйОбъект.Ссылка) Тогда
			НоваяСтрока.Ссылка = ЗагружаемыйОбъект.Ссылка;
		Иначе
			УникальныйИдентификатор = Новый УникальныйИдентификатор(ОбъектДляЗагрузки.УИД);
			ОбъектСправочник = Справочники[Метаданные.НайтиПоТипу(Тип(ОбъектДляЗагрузки.Тип)).Имя];
			НоваяСтрока.Ссылка = ОбъектСправочник.ПолучитьСсылку(УникальныйИдентификатор);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодробноеОписание) Тогда
		НоваяСтрока.ПодробноеОписание = ПодробноеОписание;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМенеджерОбъекта(ОбъектМетаданных)
	
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Справочники[ОбъектМетаданных.Имя];
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат Документы[ОбъектМетаданных.Имя];
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		Возврат ПланыСчетов[ОбъектМетаданных.Имя];
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		Возврат ПланыВидовХарактеристик[ОбъектМетаданных.Имя];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция СтруктураДляПоиска(ИмяОбъекта)
	
	ИмяСправочника = СтрЗаменить(ИмяОбъекта, "СправочникСсылка.", "");
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	ВариантыПоиска = Новый Массив;
	
	Попытка
		ВариантыПоиска = Справочники[ИмяСправочника].ПолучитьОписаниеКлючейПоиска();
	Исключение
		
	КонецПопытки;
	
	Если ИмяСправочника = "КонтурЛогистика_Настройки" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "ИмяПредопределенногоДляРасширения", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииСправочников" Тогда
		
		СтрокаКлючей = "ТипСправочникаИлиДокументаУС,ТипСправочникаЛогистика,ТипДокументаОснования,РеквизитТитула";
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, СтрокаКлючей, ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииДокументов" Тогда
		
		СтрокаКлючей = "ТипДокументаЛогистика,ТипДокумента1С,СпецСценарий,Родитель";
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, СтрокаКлючей, ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииРегистровСведений" Тогда
		
		СтрокаКлючей = "ТипРесурса,ИмяРесурса,ОтборТипДанных,НаправлениеКонвертации";
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, СтрокаКлючей, ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_СценарииАвтоматическойРаботы" Тогда
		
		СтрокаКлючей = "Сценарий,ТипЛогистическогоДокумента";
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, СтрокаКлючей, ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_Договоры" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "Наименование,НомерДокумента,ДатаДокумента", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_КлассификаторУпаковок" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "Код", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_НастройкиСвязейДокументов" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "Наименование,ТипДокументаОсновной,ТипДокументаПодчиненный", ШаблонСтрокиПоиска);
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "ТипДокументаОсновной,ТипДокументаПодчиненный", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_ОписанияОпасныхГрузов" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "НомерООН", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_ПодразделенияДиадок" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "ID,IDВладелец", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_СтраныМира" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "Код", ШаблонСтрокиПоиска);
		
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_СостоянияДвиженияДокументооборота" Тогда
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "Код", ШаблонСтрокиПоиска);
			
	ИначеЕсли ИмяСправочника = "КонтурЛогистика_НастройкиДополнительныхРеквизитов" Тогда
		
		СтрокаКлючей = "";
		Если КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСерверПовтИсп.РасширениеСДополнительнымиРеквизитамиУстановлено() Тогда 
			СтрокаКлючей = "Идентификатор,Расположение,Родитель";
		ИначеЕсли КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыОФПовтИсп.КонфигурацияСДополнительнымиРеквизитамиУстановлена() Тогда
			СтрокаКлючей = "Реквизит,Объект,ТЧ,Родитель";
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, СтрокаКлючей, ШаблонСтрокиПоиска);
		
	Иначе
		
		// Возможно это справочник учетной системы
		ОбъектМетаданных = Метаданные.Справочники.Найти(ИмяСправочника);
		Если ОбъектМетаданных <> Неопределено Тогда
			
			// Пробуем найти ИНН и КПП
			РеквизитИНН = ОбъектМетаданных.Реквизиты.Найти("ИНН");
			Если РеквизитИНН <> Неопределено Тогда
				
				СтрокаКлючей = "ИНН";
				
				РеквизитКПП = ОбъектМетаданных.Реквизиты.Найти("КПП");
				Если РеквизитКПП <> Неопределено Тогда
					СтрокаКлючей = СтрокаКлючей + ", КПП";
				КонецЕсли;
				
				КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
					ВариантыПоиска, СтрокаКлючей, ШаблонСтрокиПоиска);
				
			КонецЕсли;
			
			// Если нет реквизитов ИНН, тогда ищем по коду, если его длина установлена, иначе по наименованию
			Если РеквизитИНН = Неопределено Тогда
				
				Попытка
					ДлинаКода = ОбъектМетаданных.СтандартныеРеквизиты.Код.Тип.КвалификаторыСтроки.Длина;
				Исключение
					ДлинаКода = 0;
				КонецПопытки;
				
				Если ДлинаКода = 0 Тогда
					СтрокаКлюча = "Наименование";
				Иначе
					СтрокаКлюча = "Код";
				КонецЕсли;
				
				КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
					ВариантыПоиска, СтрокаКлюча, ШаблонСтрокиПоиска);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураДляПоиска = Новый Структура;
	СтруктураДляПоиска.Вставить("ИмяСправочника", ИмяСправочника);
	СтруктураДляПоиска.Вставить("ВариантыПоиска", ВариантыПоиска);
	
	Возврат СтруктураДляПоиска;
	
КонецФункции

Функция НайтиОбъектПоПолямПоиска(ОбъектДляЗагрузки, СтруктураДляПоиска, РежимЧтения, ОбъектыДляЗагрузки = Неопределено)
	
	// вначале попробуем найти по УИД
	Если ЗначениеЗаполнено(ОбъектДляЗагрузки.УИД) И ЗначениеЗаполнено(ОбъектДляЗагрузки.Тип) Тогда                                                        
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(ОбъектДляЗагрузки.Тип));
		
		Если ОбъектМетаданных <> Неопределено Тогда
							
			МенеджерОбъекта = ПолучитьМенеджерОбъекта(ОбъектМетаданных);
		
			Если МенеджерОбъекта <> Неопределено Тогда			
				
				НайденнаяСсылка = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектДляЗагрузки.УИД));
				НайдОбъект = НайденнаяСсылка.ПолучитьОбъект();
		
				Если НайдОбъект <> Неопределено Тогда	
					Возврат НайденнаяСсылка;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураДляПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого КлючиПоиска Из СтруктураДляПоиска.ВариантыПоиска Цикл
		
		ТекстЗапроса = "ВЫБРАТЬ КонтурЛогистика_Справочник.Ссылка КАК Ссылка ИЗ Справочник.%1 КАК КонтурЛогистика_Справочник ГДЕ ИСТИНА";
		ТекстЗапроса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			ТекстЗапроса, СтруктураДляПоиска.ИмяСправочника);
		
		Запрос = Новый Запрос;
		
		Для каждого Ключ Из КлючиПоиска Цикл
			
			ТекстЗапроса = ТекстЗапроса + Ключ.ШаблонСтрокиПоиска;
			ТекстЗапроса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ТекстЗапроса, Ключ.Параметр);
			
			ТипРеквизита = НайтиТипРеквизитаВМассивеСтруктур(Ключ.Параметр, ОбъектДляЗагрузки.Реквизиты);
			ПараметрЗначение = НайтиЗначениеРеквизитаВМассивеСтруктур(Ключ.Параметр, ОбъектДляЗагрузки.Реквизиты);
			
			Если СтруктураДляПоиска.ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииДокументов" 
				И Ключ.Параметр = "СпецСценарий" 
				И Не ЗначениеЗаполнено(ТипРеквизита) Тогда				
			   	Запрос.УстановитьПараметр(Ключ.Параметр, Перечисления["КонтурЛогистика_СпецСценарииЗадач"].ПустаяСсылка());
			Иначе
				ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(ТипРеквизита));
			КонецЕсли;
			
			Если ОбъектМетаданных <> Неопределено И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
				
				Если ПараметрЗначение = "00000000-0000-0000-0000-000000000000" Тогда
					
					МенеджерОбъекта = ПолучитьМенеджерОбъекта(ОбъектМетаданных);
					ПараметрЗначение = МенеджерОбъекта.ПустаяСсылка()
					
				Иначе
				
					Если РежимЧтения Тогда
						
						НайденныйОбъект = ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("УИД", ПараметрЗначение));
						Если ЗначениеЗаполнено(НайденныйОбъект)
							И НайденныйОбъект.Количество() > 0
							И ЗначениеЗаполнено(НайденныйОбъект[0].Ссылка) Тогда
							
							ПараметрЗначение = НайденныйОбъект[0].Ссылка;
						КонецЕсли;
						
					Иначе
						
						НайденныйОбъект = тзОбъектыДляЗагрузки.Найти(ПараметрЗначение, "УИД");
						Если ЗначениеЗаполнено(НайденныйОбъект) И НайденныйОбъект.НайденноеЗначение <> Неопределено Тогда
							ПараметрЗначение = НайденныйОбъект.НайденноеЗначение;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Запрос.УстановитьПараметр(Ключ.Параметр, ПараметрЗначение);
			
		КонецЦикла;
		
		Запрос.Текст = ТекстЗапроса;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиЗначениеРеквизитаВМассивеСтруктур(ИмяРеквизита, ВходныеДанные)
	
	Для каждого ТекущаяСтрока Из ВходныеДанные Цикл
		
		Если ТипЗнч(ТекущаяСтрока) = Тип("Структура")
			И ТекущаяСтрока.Свойство("Имя")
			И ТекущаяСтрока.Свойство("Значение")
			И ТекущаяСтрока.Имя = ИмяРеквизита Тогда
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(ТекущаяСтрока.Тип));
			
			Если Тип(ТекущаяСтрока.Тип) = Тип("Строка") Тогда
				
				Возврат ТекущаяСтрока.Значение;
				
			ИначеЕсли Тип(ТекущаяСтрока.Тип) = Тип("Число") Тогда
				
				Возврат Число(ТекущаяСтрока.Значение);
				
			ИначеЕсли Тип(ТекущаяСтрока.Тип) = Тип("Дата") Тогда
				
				Если ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
					Возврат Дата(ТекущаяСтрока.Значение);
				Иначе
					Возврат Дата(1, 1, 1);
				КонецЕсли;
				
			ИначеЕсли Тип(ТекущаяСтрока.Тип) = Тип("Булево") Тогда
				
				Возврат ?(ТекущаяСтрока.Значение = "Да", Истина, Ложь);
				
			ИначеЕсли ОбъектМетаданных <> Неопределено
				И Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
				
				Если ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
					Возврат Перечисления[ОбъектМетаданных.Имя][ТекущаяСтрока.Значение];
				Иначе
					Возврат Перечисления[ОбъектМетаданных.Имя].ПустаяСсылка();
				КонецЕсли;
				
			Иначе
				
				Возврат ТекущаяСтрока.Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция НайтиТипРеквизитаВМассивеСтруктур(ИмяРеквизита, ВходныеДанные)
	
	Для каждого ТекущаяСтрока Из ВходныеДанные Цикл
		
		Если ТипЗнч(ТекущаяСтрока) = Тип("Структура")
			И ТекущаяСтрока.Свойство("Имя")
			И ТекущаяСтрока.Свойство("Тип")
			И ТекущаяСтрока.Имя = ИмяРеквизита Тогда
			
			Возврат ТекущаяСтрока.Тип;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ЭтоОбъектМетаданныхЛогистики(ИмяОбъектаМетаданных)
	
	Возврат (Лев(ИмяОбъектаМетаданных, 16) = "КонтурЛогистика_");
	
КонецФункции

Функция СтруктураДляПоискаГруппы(ИмяОбъекта)
	
	ИмяСправочника = СтрЗаменить(ИмяОбъекта, "СправочникСсылка.", "");
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	ВариантыПоиска = Новый Массив;
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(
			ВариантыПоиска, "Наименование,Родитель", ШаблонСтрокиПоиска);
			
	СтруктураДляПоиска = Новый Структура;
	СтруктураДляПоиска.Вставить("ИмяСправочника", ИмяСправочника);
	СтруктураДляПоиска.Вставить("ВариантыПоиска", ВариантыПоиска);
	
	Возврат СтруктураДляПоиска;
	
КонецФункции

Функция ПолучитьМассивТипов(ОснованиеТипа)
	
	Типы = Новый Массив;
	
	Для каждого Тип Из ОснованиеТипа.Типы() Цикл
			
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Типы.Добавить(ОбъектМетаданных.Имя);
		
	КонецЦикла;
	
	Возврат Типы;
	
КонецФункции

