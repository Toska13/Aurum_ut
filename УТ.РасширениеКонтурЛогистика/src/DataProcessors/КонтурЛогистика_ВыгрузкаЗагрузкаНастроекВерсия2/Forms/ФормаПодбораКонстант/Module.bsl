
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗакрыватьПриВыборе") Тогда
		ЭтаФорма.ЗакрыватьПриВыборе = Параметры.ЗакрыватьПриВыборе; 	
	КонецЕсли;
	
	Для каждого Константа Из Константы Цикл
		
		Значение = Константа.Получить();
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Продолжить;
		КонецЕсли;
		
		КонстантаОбъектМетаданных = Константа.СоздатьМенеджерЗначения().Метаданные();
		
		ПеречислениеОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоПримитивныйТип(ТипЗнч(Значение))
			Или (ПеречислениеОбъектМетаданных <> Неопределено И Метаданные.Перечисления.Содержит(ПеречислениеОбъектМетаданных)) Тогда			
			НоваяСтрока = СписокКонстант.Добавить();	
			НоваяСтрока.Имя = КонстантаОбъектМетаданных.Имя;
			НоваяСтрока.Синоним = КонстантаОбъектМетаданных.Синоним;		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКонстантВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СписокКонстант.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыбранныеДанные = Новый Структура("Имя, Синоним", ТекущиеДанные.Имя, ТекущиеДанные.Синоним);
	ОповеститьОВыборе(ТекущиеДанные);
			
КонецПроцедуры
