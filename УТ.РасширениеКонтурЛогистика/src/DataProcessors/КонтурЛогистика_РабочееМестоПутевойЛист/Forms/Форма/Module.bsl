&НаКлиенте
Процедура ЗадачиМедосмотрПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ЗадачиМедосмотр.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполненияВручнуюМедосмотр Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура("МедРаботник, МедЛицензия, Должность, ДатВрПрМО");
	
	Если ОтборМедосмотр = "Предсменный" Тогда
		ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2");
	ИначеЕсли ОтборМедосмотр = "Послесменный" Тогда
		ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6");
	Иначе
		Возврат;
	КонецЕсли;
	
	// Есть черновик, заполним данные заполнения из него
	Если ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик") Тогда
		Элементы.ДанныеЗаполненияВручнуюМедосмотр.Доступность = Ложь;
		Элементы.ДекорацияДанныеЗаполненияВручнуюМедосмотр.Видимость = Истина;
		ДанныеЗаполнения = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ТекущиеДанные.ДокументЛогистика, ДанныеЗаполнения);
	Иначе
		Элементы.ДанныеЗаполненияВручнуюМедосмотр.Доступность = Истина;
		Элементы.ДекорацияДанныеЗаполненияВручнуюМедосмотр.Видимость = Ложь;
		ЗаполнитьЧерезНастройкиКонвертации(ДанныеЗаполнения, ТипДокументаЛогистика, ТекущиеДанные.ПредыдущийТитул);
	КонецЕсли;
	
	МедРаботник = ДанныеЗаполнения.МедРаботник;
	МедЛицензия = ДанныеЗаполнения.МедЛицензия;
	МедДолжность = ДанныеЗаполнения.Должность;
	МедДатВрПрМО = ДанныеЗаполнения.ДатВрПрМО;
	
	ЗаполнитьПоказанияТоплива(ТекущиеДанные);
	
КонецПроцедуры

