&НаКлиенте
Процедура ОбновитьВидимостьДоступностьОбъектовЗаполнения()
	
	Если ТекущиВидАРМ = "Диспетчер" Тогда
		
		Элементы.ДиспетчерПоказанияОдометраДатаИВремя.Видимость = Не ДиспетчерПоказанияОдометраДатаИВремяВсегдаТекущее;
		Элементы.ДиспетчерПоказанияОдометраДатаИВремяСейчас.Видимость = Не ДиспетчерПоказанияОдометраДатаИВремяВсегдаТекущее;
		
		Элементы.ГруппаДиспетчерСменаВодитель2.Видимость = (ЗначениеЗаполнено(ДиспетчерВодитель2));
		Элементы.КартинкаВодительПлюс1.Видимость = Не Элементы.ГруппаДиспетчерСменаВодитель2.Видимость;
		
	ИначеЕсли СвойМедик И ТекущиВидАРМ = "Медосмотр" Тогда
		
		Элементы.МедДатаИВремяПроведения.Видимость = Не МедВремяВсегдаТекущее;
		Элементы.ДекорацияДанныеЗаполненияВручнуюМедосмотр.Видимость = Ложь;
		
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		
		Элементы.ТехКонтрольДатВрКонтТехСост.Видимость = Не ТехКонтрольДатВрКонтВсегдаТекущее;
		Элементы.ТехКонтрольДатВрКонтТехСостСейчас.Видимость = Не ТехКонтрольДатВрКонтВсегдаТекущее;
		
		Элементы.ТехКонтрольДатВрВыпНаЛин.Видимость = Не ТехКонтрольДатВрВыпВсегдаТекущее;
		Элементы.ТехКонтрольДатВрВыпНаЛинСейчас.Видимость = Не ТехКонтрольДатВрВыпВсегдаТекущее;
		
		Элементы.ДекорацияДанныеЗаполненияВручнуюТехКонтроль.Видимость = Ложь;
		
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		
		Элементы.ПоказанияОдометраДатаИВремя.Видимость = Не ПоказанияОдометраДатаИВремяВсегдаТекущее;
		Элементы.ПоказанияОдометраДатаИВремяСейчас.Видимость = Не ПоказанияОдометраДатаИВремяВсегдаТекущее;
		
		Элементы.ДекорацияДанныеЗаполненияВручнуюПоказанияОдометра.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСпискиЗадач()
	
	Если ТекущиВидАРМ = "Диспетчер" Тогда
		Элементы.ЗадачиДиспетчер.Обновить();
		Элементы.ЗадачиДиспетчер.ВыделенныеСтроки.Очистить();
	ИначеЕсли СвойМедик И ТекущиВидАРМ = "Медосмотр" Тогда
		Элементы.ЗадачиМедосмотр.Обновить();
		Элементы.ЗадачиМедосмотр.ВыделенныеСтроки.Очистить();
		Элементы.СписокМедосмотр.Обновить();
		ЗадачиМедосмотрПриАктивизацииСтроки(Неопределено);
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		Элементы.ЗадачиТехКонтроль.Обновить();
		Элементы.ЗадачиТехКонтроль.ВыделенныеСтроки.Очистить();
		ЗадачиТехКонтрольПриАктивизацииСтроки(Неопределено);
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		Элементы.ЗадачиПоказанияОдометра.Обновить();
		Элементы.ЗадачиПоказанияОдометра.ВыделенныеСтроки.Очистить();
		Элементы.СписокПоказанияОдометра.Обновить();
		ЗадачиПоказанияОдометраПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеСтранициЗадачНаКлиенте()
	
	Элементы.ГруппаЗадач.ТекущаяСтраница = Элементы["Группа" + ТекущиВидАРМ];
	
	ШрифтСтандарт = Новый Шрифт();
	Элементы.ФормаДиспетчер.Шрифт = ШрифтСтандарт;
	Элементы.ФормаМедосмотр.Шрифт = ШрифтСтандарт;
	Элементы.ФормаТехКонтроль.Шрифт = ШрифтСтандарт;
	Элементы.ФормаПоказанияОдометра.Шрифт = ШрифтСтандарт;
	
	АвтоЦветФона = Новый Цвет();
	Элементы.ФормаДиспетчер.ЦветФона = АвтоЦветФона;
	Элементы.ФормаМедосмотр.ЦветФона = АвтоЦветФона;
	Элементы.ФормаТехКонтроль.ЦветФона = АвтоЦветФона;
	Элементы.ФормаПоказанияОдометра.ЦветФона = АвтоЦветФона;
	
	Элементы.ФормаДиспетчер.Доступность = Истина;
	Элементы.ФормаМедосмотр.Доступность = Истина;
	Элементы.ФормаТехКонтроль.Доступность = Истина;
	Элементы.ФормаПоказанияОдометра.Доступность = Истина;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82()
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		
		Элементы["Форма" + ТекущиВидАРМ].Доступность = Ложь;
	Иначе
		Элементы["Форма" + ТекущиВидАРМ].Шрифт = Новый Шрифт(,, Истина);
		Элементы["Форма" + ТекущиВидАРМ].ЦветФона = WebЦвета.Золотой;
	КонецЕсли;
	
	Элементы["Задачи" + ТекущиВидАРМ + "ПодписатьТитул"].КнопкаПоУмолчанию = Истина;
	Если ТекущиВидАРМ = "Диспетчер" И ОтборДиспетчер = "ВПути" Тогда
		Элементы.ЗадачиДиспетчерСменаВодителя.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
	Заголовок = "Путевой лист (ф. 5.01): рабочее место";
	
	Если ТекущиВидАРМ = "Диспетчер" Тогда
		
		Заголовок = Заголовок + " диспетчера";
		
		Если ОтборДиспетчер = "" Тогда
			ОтборДиспетчер = "НеПодписанные";
		КонецЕсли;
		
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1");
		
		ОтборДиспетчерПриИзменении(Неопределено);
		
	ИначеЕсли СвойМедик И ТекущиВидАРМ = "Медосмотр" Тогда
		
		Заголовок = Заголовок + " медика";
		
		Если ОтборМедосмотр = "" Тогда
			ОтборМедосмотр = "Предсменный";
		КонецЕсли;
		
		Если ОтборМедосмотр = "Предсменный" Или ОтборМедосмотр = "Послесменный" Тогда
			Элементы.ГруппаМедосмотрСписки.ТекущаяСтраница = Элементы.ГруппаМедосмотрЗадачи;
		Иначе
			Элементы.ГруппаМедосмотрСписки.ТекущаяСтраница = Элементы.ГруппаМедосмотрСписок;
		КонецЕсли;
		
		ОтборМедосмотрПриИзменении(Неопределено);
		
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		
		Заголовок = Заголовок + " тех. контролера";
		
		Если ОтборТехКонтроль = "" Тогда
			ОтборТехКонтроль = "НеПодписанные";
		КонецЕсли;
		
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3");
		
		ОтборТехКонтрольПриИзменении(Неопределено);
		
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		
		Заголовок = Заголовок + " показания одометра";
		
		Если ОтборПоказанияОдометра = "" Тогда
			ОтборПоказанияОдометра = "Выезд";
		КонецЕсли;
		
		Если ОтборМедосмотр = "Выезд" Или ОтборМедосмотр = "Заезд" Тогда
			Элементы.ГруппаПоказанияОдометраСписки.ТекущаяСтраница = Элементы.ГруппаПоказанияОдометраЗадачи;
		Иначе
			Элементы.ГруппаПоказанияОдометраСписки.ТекущаяСтраница = Элементы.ГруппаПоказанияОдометраСписок;
		КонецЕсли;
		
		ОтборПоказанияОдометраПриИзменении(Неопределено);
		
	КонецЕсли;
	
	ОбновитьВидимостьДоступностьОбъектовЗаполнения();
	
	ПереместитьПанельТоплива();
	
КонецПроцедуры

&НаСервереБезКонтекста
