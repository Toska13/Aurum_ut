&НаСервереБезКонтекста
Функция ТребуемыхДействийАктивные()
	
	МассивТД = Новый Массив;
	
	// мои
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Оформить"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Переотправить"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВОчередиОтправки"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ЗапроситьОбъяснение"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОбрабатываетсяСервером"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Отправляется"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПровестиДокумент"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Распечатать"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВвестиНаОсновании"));

	// требующие обработки сервером
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен"));
	МассивТД.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВОчередиОтправки"));
	
	Возврат МассивТД;
	
КонецФункции

&НаСервере
Процедура ПодготовитьСписки()
	
	ТекстИндексаКартинкиСтатусаПодписанияТ1 = ТекстИндексаКартинкиСтатусаПодписанияТ1();
	ТекстИндексаКартинкиСтатусаПодписанияТ23456 = ТекстИндексаКартинкиСтатусаПодписанияТ23456();
	
	// Диспетчер
	РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, "Все типы");
	
	Если РезультатаФормированияЗапроса.ПолныйТекстЗапроса <> "" Тогда
		ЕстьНастройкиКонвертацииТ1 = Истина;
		
		ЗадачиДиспетчер.ТекстЗапроса = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
		УстановитьПараметрыДинамическогоСписка(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, Неопределено);
		Для Каждого ПараметрЗапроса Из РезультатаФормированияЗапроса.СтруктураПараметровЗапроса Цикл
			ЗадачиДиспетчер.Параметры.УстановитьЗначениеПараметра(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
		КонецЦикла;
		
		// Добавим поля "ИндексКартинкиСтатусаПодписания" и "Водитель2"
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ЗадачиДиспетчер.ТекстЗапроса);
		
		Если Найти(ЗадачиДиспетчер.ТекстЗапроса, "КАК ОбъединеннаяТаблица") = 0 Тогда
			
			// Один тип учетного документа
			ЭтоПерваяСтрока = Истина;
			Для Каждого ОператорЗапроса Из СхемаЗапроса.ПакетЗапросов[0].Операторы Цикл
				ПолеИндексаКартинки = ОператорЗапроса.ВыбираемыеПоля.Добавить(ТекстИндексаКартинкиСтатусаПодписанияТ1);
				ПолеВодитель2 = ОператорЗапроса.ВыбираемыеПоля.Добавить("КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель2");
				
				Если ЭтоПерваяСтрока Тогда
					ИндексПоляИндексаКартинки = ОператорЗапроса.ВыбираемыеПоля.Индекс(ПолеИндексаКартинки);
					СхемаЗапроса.ПакетЗапросов[0].Колонки[ИндексПоляИндексаКартинки].Псевдоним = "ИндексКартинкиСтатусаПодписания";
					
					ИндексПоляВодитель2 = ОператорЗапроса.ВыбираемыеПоля.Индекс(ПолеВодитель2);
					СхемаЗапроса.ПакетЗапросов[0].Колонки[ИндексПоляВодитель2].Псевдоним = "Водитель2";
					
					ЭтоПерваяСтрока = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			// Изменим вычисление поля "Водитель"
			ВыражениеВычисленияВодителя = Строка(СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти("Водитель").Поля[0]);
			ПолеВодителя = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Найти(ВыражениеВычисленияВодителя);
			ИндексПоляВодитель = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Индекс(ПолеВодителя);
			СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Установить(ИндексПоляВодитель, Новый ВыражениеСхемыЗапроса("ВЫБОР
				|	КОГДА КонтурЛогистика_ПЛ_Титул1.Ссылка ЕСТЬ NULL
				|		ТОГДА втДокументы.Водитель
				|	ИНАЧЕ КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель
				|КОНЕЦ"));
			
		Иначе
			
			// Несколько типов учетного документа
			ЭтоПерваяСтрока = Истина;
			Для Каждого ОператорЗапроса Из СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Операторы Цикл
				ТекущиеКолонкиЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Колонки;
				
				ПолеИндексаКартинки = ОператорЗапроса.ВыбираемыеПоля.Добавить(ТекстИндексаКартинкиСтатусаПодписанияТ1);
				ПолеВодитель2 = ОператорЗапроса.ВыбираемыеПоля.Добавить("КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель2");
				
				Если ЭтоПерваяСтрока Тогда
					ИндексПоляИндексаКартинки = ОператорЗапроса.ВыбираемыеПоля.Индекс(ПолеИндексаКартинки);
					ТекущиеКолонкиЗапроса[ИндексПоляИндексаКартинки].Псевдоним = "ИндексКартинкиСтатусаПодписания";
					
					ИндексПоляВодитель2 = ОператорЗапроса.ВыбираемыеПоля.Индекс(ПолеВодитель2);
					ТекущиеКолонкиЗапроса[ИндексПоляВодитель2].Псевдоним = "Водитель2";
					
					// Изменим вычисление поля "Водитель"
					ВыражениеВычисленияВодителя = Строка(ТекущиеКолонкиЗапроса.Найти("Водитель").Поля[0]);
					ПолеВодителя = ОператорЗапроса.ВыбираемыеПоля.Найти(ВыражениеВычисленияВодителя);
					ИндексПоляВодитель = ОператорЗапроса.ВыбираемыеПоля.Индекс(ПолеВодителя);
					ОператорЗапроса.ВыбираемыеПоля.Установить(ИндексПоляВодитель, Новый ВыражениеСхемыЗапроса("ВЫБОР
						|	КОГДА КонтурЛогистика_ПЛ_Титул1.Ссылка ЕСТЬ NULL
						|		ТОГДА втДокументы.Водитель
						|	ИНАЧЕ КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель
						|КОНЕЦ"));
					
					ЭтоПерваяСтрока = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			// Добавим итоговые поля в объединенную талицу
			СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Добавить("ОбъединеннаяТаблица.ИндексКартинкиСтатусаПодписания");
			СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Добавить("ОбъединеннаяТаблица.Водитель2");
			
		КонецЕсли;
		
		ЗадачиДиспетчер.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
		
		ОтобразитьОтборДополнительныеКолонки("ЗадачиДиспетчер", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
		
	КонецЕсли;
	
	// Медосмотр
	Если СвойМедик Тогда
		ПолныйТекстЗапросаТ2 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2, Неопределено,,,, Ложь).ПолныйТекстЗапроса;
		ПолныйТекстЗапросаТ6 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6, Неопределено,,,, Ложь).ПолныйТекстЗапроса;
		ЗадачиМедосмотр.ТекстЗапроса = ПолныйТекстЗапросаТ2 + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|" + СтрЗаменить(ПолныйТекстЗапросаТ6, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
		ЗадачиМедосмотр.ТекстЗапроса = СтрЗаменить(ЗадачиМедосмотр.ТекстЗапроса, "КОНЕЦ КАК ТребуемоеДействие,",
			ТекстИндексаКартинкиСтатусаПодписанияТ23456);
		
		УстановитьПараметрыДинамическогоСписка(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2, Неопределено);
		УстановитьПараметрыДинамическогоСписка(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6, Неопределено);
		
		ДобавитьДополнительныеКолонкиВОбъединенныйЗапрос(ЗадачиМедосмотр,           
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
		
		ОтобразитьОтборДополнительныеКолонки("ЗадачиМедосмотр", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
	КонецЕсли;
	
	// Тех контроль
	РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3, Неопределено);
	ЗадачиТехКонтроль.ТекстЗапроса = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
	УстановитьПараметрыДинамическогоСписка(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3, Неопределено);
	Для Каждого ПараметрЗапроса Из РезультатаФормированияЗапроса.СтруктураПараметровЗапроса Цикл
		ЗадачиТехКонтроль.Параметры.УстановитьЗначениеПараметра(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;
	ЗадачиТехКонтроль.ТекстЗапроса = СтрЗаменить(ЗадачиТехКонтроль.ТекстЗапроса, "КОНЕЦ КАК ТребуемоеДействие,",
		ТекстИндексаКартинкиСтатусаПодписанияТ23456);
	
	ОтобразитьОтборДополнительныеКолонки("ЗадачиТехКонтроль", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3);
	
	// Показания одометра
	РезультатаФормированияЗапросаТ4 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4, Неопределено);
	РезультатаФормированияЗапросаТ5 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5, Неопределено);
	ЗадачиПоказанияОдометра.ТекстЗапроса = РезультатаФормированияЗапросаТ4.ПолныйТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|" + СтрЗаменить(РезультатаФормированияЗапросаТ5.ПолныйТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
	
	ЗадачиПоказанияОдометра.ТекстЗапроса = СтрЗаменить(ЗадачиПоказанияОдометра.ТекстЗапроса, "КОНЕЦ КАК ТребуемоеДействие,",
		ТекстИндексаКартинкиСтатусаПодписанияТ23456);
	
	УстановитьПараметрыДинамическогоСписка(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4, Неопределено);
	УстановитьПараметрыДинамическогоСписка(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5, Неопределено);
	
	ДобавитьДополнительныеКолонкиВОбъединенныйЗапрос(ЗадачиПоказанияОдометра,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	
	ОтобразитьОтборДополнительныеКолонки("ЗадачиПоказанияОдометра", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	
	// Статус документооборота в пути
	Если СписокМедосмотр.Параметры.Элементы.Найти("СтатусДокументооборотаВПути") <> Неопределено Тогда
		СписокМедосмотр.Параметры.УстановитьЗначениеПараметра(
			"СтатусДокументооборотаВПути", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостояниеПутевогоЛистаВПути());
	КонецЕсли;
	Если СписокПоказанияОдометра.Параметры.Элементы.Найти("СтатусДокументооборотаВПути") <> Неопределено Тогда
		СписокПоказанияОдометра.Параметры.УстановитьЗначениеПараметра(
			"СтатусДокументооборотаВПути", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостояниеПутевогоЛистаВПути());
	КонецЕсли;
	
КонецПроцедуры

