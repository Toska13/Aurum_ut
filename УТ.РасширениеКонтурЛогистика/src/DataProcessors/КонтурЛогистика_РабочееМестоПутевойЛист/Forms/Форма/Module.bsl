&НаКлиенте
Процедура СменаВодителя(Команда)
	
	ОчиститьСообщения();
	
	ТекущийСписокЗадач = Элементы.ЗадачиДиспетчер;
	
	Если ТекущийСписокЗадач.ВыделенныеСтроки.Количество() > 1 Тогда
		Сообщить("Нельзя оформить смену водителя для нескольких документов.");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеСменыВодителя() Тогда
		Возврат;
	КонецЕсли;
	
	Титул5Ссылка = ОтправкаСменыВодителяТитула5(ТекущийСписокЗадач);
	Если Титул5Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтправкаСменыВодителяТитула1(Титул5Ссылка);
	
	// Очистим важные поля заполнения
	ДиспетчерНомерСменыВодителя = "";
	ДиспетчерВодитель = Неопределено;
	ДиспетчерПоказанияОдометраПоказания = 0;
	
	ОбновитьСпискиЗадач();
	
	ТумблерСменаВодителяЗакрыть(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеСменыВодителя()
	
	Результат = Истина;
	
	// Номер
	Если Не ДиспетчерПрежнийНомер И Не ЗначениеЗаполнено(ДиспетчерНомерСменыВодителя) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить номер";
		ПараметрыСообщения.ПутьКДанным  = "ДиспетчерНомерСменыВодителя";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	// Водитель
	Если Не ЗначениеЗаполнено(ДиспетчерВодитель) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить водителя";
		ПараметрыСообщения.ПутьКДанным  = "ДиспетчерВодитель";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	// Ответственный
	Если Не ДиспетчерПрежнийРаботник И Не ЗначениеЗаполнено(ДиспетчерПоказанияОдометраРаботник) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить ответственного";
		ПараметрыСообщения.ПутьКДанным  = "ДиспетчерПоказанияОдометраРаботник";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	// Показания одометра
	Если Не ЗначениеЗаполнено(ДиспетчерПоказанияОдометраПоказания) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить показания одометра";
		ПараметрыСообщения.ПутьКДанным  = "ДиспетчерПоказанияОдометраПоказания";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	// Дата и время
	Если Не ДиспетчерПоказанияОдометраДатаИВремяВсегдаТекущее И Не ЗначениеЗаполнено(ДиспетчерПоказанияОдометраДатаИВремя) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить дату и время";
		ПараметрыСообщения.ПутьКДанным  = "ДиспетчерПоказанияОдометраДатаИВремя";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОтправкаСменыВодителяТитула5(ТекущийСписокЗадач)
	
	ОбработанныеДокументы = Новый Массив;
	
	ДокументыКОбработке = ДокументыКОбработкеИзСпискаЗадач(ТекущийСписокЗадач, Истина);
	
	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5");
	РезультатИзготовления = ИзготовитьФайлыОбмена(ДокументыКОбработке, ОбработанныеДокументы);
	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1");
	
	Если РезультатИзготовления.Успех Тогда
		ИзготовленныеФайлыОбмена = РезультатИзготовления.ИзготовленныеФайлыОбмена;
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(РезультатИзготовления.ДокументСОшибкой);
		Возврат Неопределено;
	КонецЕсли;
	
	ПодписанныеФайлыОбмена = ПодписатьФайлы(ИзготовленныеФайлыОбмена);
	Если ТипЗнч(ПодписанныеФайлыОбмена) = Тип("Массив") И ПодписанныеФайлыОбмена.Количество() = 0 Тогда
		ДокументЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ИзготовленныеФайлыОбмена[0], "СвязанныйДокумент");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ДокументЛогистика);
		Возврат Неопределено;
	КонецЕсли;
	
	РезультатОтправкиУспешно = ОтправитьПодписанныеФайлы(ПодписанныеФайлыОбмена);
	
	Если РезультатОтправкиУспешно Тогда
		Если ОбработанныеДокументы.Количество() = 1 Тогда
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ОбработанныеДокументы[0]);
			ПоказатьОповещениеПользователя("Отправлен", НавигационнаяСсылка, Строка(ОбработанныеДокументы[0]));
		Иначе
			ПоказатьОповещениеПользователя(,, "Отправлено документов: " + Строка(Формат(ОбработанныеДокументы.Количество(), "ЧДЦ=0; ЧГ=")));
		КонецЕсли;
	Иначе
		ДокументЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ПодписанныеФайлыОбмена[0], "СвязанныйДокумент");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ДокументЛогистика);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбработанныеДокументы[0];
	
КонецФункции

&НаКлиенте
Функция ОтправкаСменыВодителяТитула1(Титул5Ссылка)
	
	Результат = Истина;
	
	ОбработанныеДокументы = Новый Массив;
	
	Титул1Ссылка = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		Титул5Ссылка, "Титул1");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Водитель", ДиспетчерВодитель);
	Если ЗначениеЗаполнено(ДиспетчерВодитель2) Тогда
		ДополнительныеПараметры.Вставить("Водитель2", ДиспетчерВодитель2);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ПредыдущийПЛ", Титул1Ссылка);
	Если Не ДиспетчерПрежнийНомер Тогда
		ДополнительныеПараметры.Вставить("НомерПЛ", ДиспетчерНомерСменыВодителя);
	КонецЕсли;
	
	ДанныеОтправки = Новый Структура;
	ДанныеОтправки.Вставить("ПредыдущийТитул", Титул5Ссылка);
	ДанныеОтправки.Вставить("ДокументЛогистика", Титул5Ссылка);
	ДанныеОтправки.Вставить("ДополнительныеПараметры", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры));
	
	ДокументыКОбработке = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеОтправки);
	
	РезультатИзготовления = ИзготовитьФайлыОбменаСменыВодителя(ДокументыКОбработке, ОбработанныеДокументы);
	
	Если РезультатИзготовления.Успех Тогда
		ИзготовленныеФайлыОбмена = РезультатИзготовления.ИзготовленныеФайлыОбмена;
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(РезультатИзготовления.ДокументСОшибкой);
		Возврат Ложь;
	КонецЕсли;
	
	ПодписанныеФайлыОбмена = ПодписатьФайлы(ИзготовленныеФайлыОбмена);
	Если ТипЗнч(ПодписанныеФайлыОбмена) = Тип("Массив") И ПодписанныеФайлыОбмена.Количество() = 0 Тогда
		ДокументЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ИзготовленныеФайлыОбмена[0], "СвязанныйДокумент");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ДокументЛогистика);
		Возврат Ложь;
	КонецЕсли;
	
	РезультатОтправкиУспешно = ОтправитьПодписанныеФайлы(ПодписанныеФайлыОбмена);
	
	Если РезультатОтправкиУспешно Тогда
		Если ОбработанныеДокументы.Количество() = 1 Тогда
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ОбработанныеДокументы[0]);
			ПоказатьОповещениеПользователя("Отправлен", НавигационнаяСсылка, Строка(ОбработанныеДокументы[0]));
		Иначе
			ПоказатьОповещениеПользователя(,, "Отправлено документов: " + Строка(Формат(ОбработанныеДокументы.Количество(), "ЧДЦ=0; ЧГ=")));
		КонецЕсли;
		
		СоздатьЧерновикТ4(ОбработанныеДокументы[0], Титул5Ссылка);
	Иначе
		ДокументЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ПодписанныеФайлыОбмена[0], "СвязанныйДокумент");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ДокументЛогистика);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьЧерновикТ4(Титул1Ссылка, Титул5Ссылка)
	
	ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4;
	МассивПредыдущихТитулов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Титул1Ссылка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПоказанияОдометра", Титул5Ссылка.ПоказанияОдометра);
	
	МассивДополнительныеПараметры = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры);
	
	РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
		МассивПредыдущихТитулов, ТипЛогистика, Ложь, МассивДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьТитул(Команда)
	
	ОчиститьСообщения();
	
	Если ПоказанияОдометраПоказания = 0 И ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводЗначения_КонтурЛогистика(
			0, "Укажите показания одометра", Тип("Число"), ЭтаФорма, "ОбработчикПродолжитьПодписание");
		
	Иначе
		
		Если ПодписыватьБезВопросов Тогда
			ПодписатьТитулНаКлиенте();
		Иначе
			
			// Формируем текст заголовка
			ТекущийСписокЗадач = Элементы["Задачи" + ТекущиВидАРМ];
			Если ТекущийСписокЗадач.ВыделенныеСтроки.Количество() = 1 Тогда
				ТекущиеДанные = ТекущийСписокЗадач.ДанныеСтроки(ТекущийСписокЗадач.ВыделенныеСтроки[0]);
				
				Если ТекущиеДанные.ИндексКартинкиСтатусаПодписания = ИндексКартинкиОтказ() Тогда
					ОформитьТитул(Неопределено);
					Возврат;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТекущиеДанные.НомерТрН) Тогда
					ТекстЗаголовка = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
						"Путевой лист №%1 от %2", ТекущиеДанные.НомерТрН, Формат(ТекущиеДанные.ДатаТрН, "ДФ=dd.MM.yy"));
				Иначе
					ТекстЗаголовка = "Подписание...";
				КонецЕсли;
			Иначе
				ТекстЗаголовка = "Выбрано документов: " + Формат(ТекущийСписокЗадач.ВыделенныеСтроки.Количество(), "ЧДЦ=0; ЧГ=0");
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ТекстВопроса", "Выполнить подписание?");
			ПараметрыФормы.Вставить("Заголовок", ТекстЗаголовка);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"ОбщаяФорма.КонтурЛогистика_ВопросРасширенный", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
				"ПодписатьТитулВопросЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПродолжитьПодписание(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Параметр1) Тогда
		ПоказанияОдометраПоказания = Параметр1;
		ПодписатьТитул(ЭтаФорма.Команды.Найти("ПодписатьТитул"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьТитулВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("БольшеНеСпрашивать") Тогда
		ПодписыватьБезВопросов = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.Ответ Тогда
		Возврат;
	КонецЕсли;
	
	ПодписатьТитулНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьТитулНаКлиенте()
	
	ТекущийСписокЗадач = Элементы["Задачи" + ТекущиВидАРМ];
	
	Если Не ПроверитьЗаполнениеПередПодписанием(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиВидАРМ = "ПоказанияОдометра"
		И ДанныеЗаполненияВручнуюПоказанияОдометра
		И ТекущийСписокЗадач.ВыделенныеСтроки.Количество() > 1 Тогда
		
		Сообщить("Нельзя подписать несколько документов показания одометра, так как в режиме ""Вручную"" для каждого документа свои показания.");
		Возврат;
	КонецЕсли;
	
	ОбработанныеДокументы = Новый Массив;
	
	ДокументыКОбработке = ДокументыКОбработкеИзСпискаЗадач(ТекущийСписокЗадач);
	
	РезультатИзготовления = ИзготовитьФайлыОбмена(ДокументыКОбработке, ОбработанныеДокументы);
	Если РезультатИзготовления.Успех Тогда
		ИзготовленныеФайлыОбмена = РезультатИзготовления.ИзготовленныеФайлыОбмена;
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(РезультатИзготовления.ДокументСОшибкой);
		Возврат;
	КонецЕсли;
	
	ПодписанныеФайлыОбмена = ПодписатьФайлы(ИзготовленныеФайлыОбмена);
	Если ТипЗнч(ПодписанныеФайлыОбмена) = Тип("Массив") И ПодписанныеФайлыОбмена.Количество() = 0 Тогда
		ДокументЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ИзготовленныеФайлыОбмена[0], "СвязанныйДокумент");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ДокументЛогистика.СвязанныйДокумент);
		Возврат;
	КонецЕсли;
	
	РезультатОтправкиУспешно = ОтправитьПодписанныеФайлы(ПодписанныеФайлыОбмена);
	
	Если ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		ОтправитьQRКодыДокументов(ПодписанныеФайлыОбмена);
	КонецЕсли;
	
	Если РезультатОтправкиУспешно Тогда
		Если ОбработанныеДокументы.Количество() = 1 Тогда
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ОбработанныеДокументы[0]);
			ПоказатьОповещениеПользователя("Отправлен", НавигационнаяСсылка, Строка(ОбработанныеДокументы[0]));
		Иначе
			ПоказатьОповещениеПользователя(,, "Отправлено документов: " + Строка(Формат(ОбработанныеДокументы.Количество(), "ЧДЦ=0; ЧГ=")));
		КонецЕсли;
	Иначе
		ДокументЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ПодписанныеФайлыОбмена[0], "СвязанныйДокумент");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ДокументЛогистика);
	КонецЕсли;
	
	Если ТекущиВидАРМ = "ПоказанияОдометра" И РезультатОтправкиУспешно Тогда
		ПоказанияОдометраПоказания = 0;
	КонецЕсли;
	
	ОбновитьСпискиЗадач();
	
КонецПроцедуры

&НаСервере
Функция ИзготовитьФайлыОбмена(ДокументыКОбработке, ОбработанныеДокументы)
	
	РезультатИзготовления = Новый Структура;
	РезультатИзготовления.Вставить("Успех", Истина);
	РезультатИзготовления.Вставить("ИзготовленныеФайлыОбмена", Новый Массив);
	РезультатИзготовления.Вставить("ДокументСОшибкой");
	
	Для Каждого ТекущаяСтрока Из ДокументыКОбработке Цикл
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			
			Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументЛогистика) Тогда
				МассивДокументов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.ДокументЛогистика);
			Иначе
				МассивДокументов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.Документ1С);
			КонецЕсли;
			
			ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика",
				МассивДокументов, ТипЛогистика);
			
		Иначе
			
			МассивПредыдущихТитулов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.ПредыдущийТитул);
			
			РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
				МассивПредыдущихТитулов, ТипЛогистика, Ложь, ТекущаяСтрока.ДополнительныеПараметры);
			ВведенныеДокументы = РезультатВвода.ВведенныеДокументы;
			
			ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", ВведенныеДокументы);
			
		КонецЕсли;
		
		ПараметрыФормированияФайловРеквизиты = Новый Структура;
		ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
		
		// Изготавливаем файл
		МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(
			ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
		
		Если МассивФайловОбмена.Количество() = 0 Тогда
			// Не удалось сфоромировать
			РезультатИзготовления.Успех = Ложь;
			
			УжеВведенныеДокументы = КонтурЛогистика_ОбработкаДокументовСервер.УжеВведенныеДокументыЛогистикаПоДокументу1С(
				ПараметрыВводаДокументов.МассивДокументов[0], ТипЛогистика);
			Если УжеВведенныеДокументы.Количество() > 0 Тогда
				РезультатИзготовления.ДокументСОшибкой = УжеВведенныеДокументы[0];
			Иначе
				РезультатИзготовления.ДокументСОшибкой = ПараметрыВводаДокументов.МассивДокументов[0];
			КонецЕсли;
			
			Возврат РезультатИзготовления;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			РезультатИзготовления.ИзготовленныеФайлыОбмена, МассивФайловОбмена, Истина);
		
		// Для оповещения
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			Если МассивФайловОбмена.Количество() <> 0 Тогда
				ОбработанныеДокументы.Добавить(МассивФайловОбмена[0].ГлавныйДокумент);
			КонецЕсли;
		Иначе
			ОбработанныеДокументы.Добавить(ВведенныеДокументы[0]);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатИзготовления;
	
КонецФункции

&НаСервере
Функция ИзготовитьФайлыОбменаСменыВодителя(ДокументыКОбработке, ОбработанныеДокументы)
	
	РезультатИзготовления = Новый Структура;
	РезультатИзготовления.Вставить("Успех", Истина);
	РезультатИзготовления.Вставить("ИзготовленныеФайлыОбмена", Новый Массив);
	РезультатИзготовления.Вставить("ДокументСОшибкой");
	
	Для Каждого ТекущаяСтрока Из ДокументыКОбработке Цикл
		
		МассивПредыдущихТитулов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.ПредыдущийТитул);
		
		РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
			МассивПредыдущихТитулов, ТипЛогистика, Ложь, ТекущаяСтрока.ДополнительныеПараметры);
		ВведенныеДокументы = РезультатВвода.ВведенныеДокументы;
		
		ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", ВведенныеДокументы);
		
		ПараметрыФормированияФайловРеквизиты = Новый Структура;
		ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
		
		// Изготавливаем файл
		МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(
			ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
		
		Если МассивФайловОбмена.Количество() = 0 Тогда
			// Не удалось сфоромировать
			РезультатИзготовления.Успех = Ложь;
			
			УжеВведенныеДокументы = КонтурЛогистика_ОбработкаДокументовСервер.УжеВведенныеДокументыЛогистикаПоДокументу1С(
				ПараметрыВводаДокументов.МассивДокументов[0], ТипЛогистика);
			Если УжеВведенныеДокументы.Количество() > 0 Тогда
				РезультатИзготовления.ДокументСОшибкой = УжеВведенныеДокументы[0];
			Иначе
				РезультатИзготовления.ДокументСОшибкой = ПараметрыВводаДокументов.МассивДокументов[0];
			КонецЕсли;
			
			Возврат РезультатИзготовления;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			РезультатИзготовления.ИзготовленныеФайлыОбмена, МассивФайловОбмена, Истина);
		
		// Для оповещения
		ОбработанныеДокументы.Добавить(ВведенныеДокументы[0]);
		
	КонецЦикла;
	
	Возврат РезультатИзготовления;
	
КонецФункции

&НаКлиенте
Функция ПодписатьФайлы(ИзготовленныеФайлыОбмена)
	
	Возврат КонтурЛогистика_ОбработкаДокументовКлиент.ПодписатьФайлыОбмена(ИзготовленныеФайлыОбмена);
	
КонецФункции

&НаСервере
Функция ОтправитьПодписанныеФайлы(ФайлыОбменаКОтправке)
	
	Если ФайлыОбменаКОтправке.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Непосредственно отправка
	РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(ФайлыОбменаКОтправке);
	
	Если Не РезультатОтправки.Успешно Тогда
		ТекстОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Проблемы при отправке документов: " + ТекстОшибки);
	КонецЕсли;
	
	Возврат РезультатОтправки.Успешно;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьQRКодыДокументов(МассивФайлов)
	
	Если Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеНастройки("АвтоматическоеПолучениеИОтправкаQRКодов") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыКОбработке = Новый Массив;
	
	Для Каждого ТекущийДокумент Из МассивФайлов Цикл
		ГлавныйДок = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ТекущийДокумент, "ГлавныйДокумент");
		Если ЗначениеЗаполнено(ГлавныйДок) Тогда 
			ДокументыКОбработке.Добавить(ГлавныйДок);  
		КонецЕсли;
	КонецЦикла;
	
	Если ДокументыКОбработке.Количество() <> 0 Тогда
		
		КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание("КонтурЛогистика_ДлительныеОперацииСервер.ОчередьОтправкиQRКодовПолучитьОтправить",
								Новый Структура("ДокументыКОбработке", ДокументыКОбработке),
								"ПолучениеИОтправкаQRКодовПоток_" + Строка(Новый УникальныйИдентификатор),
								"Получение и отправка QR кодов")
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПередПодписанием(ТихийРежим)
	
	Результат = Истина;
	
	Если СвойМедик И ТекущиВидАРМ = "Медосмотр" Тогда
		
		Если Не ЗначениеЗаполнено(МедРаботник) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Медработник";
				ПараметрыСообщения.ПутьКДанным = "МедРаботник";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(МедЛицензия) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Лицензия";
				ПараметрыСообщения.ПутьКДанным = "МедЛицензия";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
		Если Не МедВремяВсегдаТекущее И Не ЗначениеЗаполнено(МедДатВрПрМО) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Дата и время проведеня";
				ПараметрыСообщения.ПутьКДанным = "МедДатВрПрМО";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		
		Если Не ЗначениеЗаполнено(ТехКонтрольРаботник) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Тех. работник";
				ПараметрыСообщения.ПутьКДанным = "ТехКонтрольРаботник";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
		Если Не ТехКонтрольДатВрКонтВсегдаТекущее И Не ЗначениеЗаполнено(ТехКонтрольДатВрКонтТехСост) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Дата и время проведения";
				ПараметрыСообщения.ПутьКДанным = "ТехКонтрольДатВрКонтТехСост";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
		Если Не ТехКонтрольДатВрВыпВсегдаТекущее И Не ЗначениеЗаполнено(ТехКонтрольДатВрВыпНаЛин) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Вып. на линию";
				ПараметрыСообщения.ПутьКДанным = "ТехКонтрольДатВрВыпНаЛин";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		
		Если Не ЗначениеЗаполнено(ПоказанияОдометраРаботник) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Ответственный";
				ПараметрыСообщения.ПутьКДанным = "ПоказанияОдометраРаботник";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПоказанияОдометраПоказания) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Показания одометра";
				ПараметрыСообщения.ПутьКДанным = "ПоказанияОдометраПоказания";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
		Если Не ПоказанияОдометраДатаИВремяВсегдаТекущее И Не ЗначениеЗаполнено(ПоказанияОдометраДатаИВремя) Тогда
			Если Не ТихийРежим Тогда
				ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
				ПараметрыСообщения.Текст = "Не заполнено поле Дата и время";
				ПараметрыСообщения.ПутьКДанным = "ПоказанияОдометраДатаИВремя";
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			КонецЕсли;
			
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтказатьТитул(Команда)
	
	ОчиститьСообщения();
	
	Если Элементы["Задачи" + ТекущиВидАРМ].ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеПередПодписанием(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводЗначения_КонтурЛогистика("", "Укажите причину отказа в подписи",
		Тип("Строка"), ЭтаФорма, "ПослеВводаПричиныОтказа");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПричиныОтказа(ПричинаОтказа, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ПричинаОтказа) Тогда 
		
		//Возврат;
		ВызватьИсключение "Вы не указали причину отказа";
		
	КонецЕсли;
	
	ДокументыКОбработке = ДокументыКОбработкеИзСпискаЗадач(Элементы["Задачи" + ТекущиВидАРМ]);
	
	ОтказатьТитулНаКлиенте(ПричинаОтказа, ДокументыКОбработке);
	
	ОбновитьСпискиЗадач();
	
	Оповестить("КонтурЛогистика_ОбновитьЗадачи");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьТитулНаКлиенте(ПричинаОтказа, ДокументыКОбработке)
	
	Для Каждого ТекущаяСтрока Из ДокументыКОбработке Цикл
		
		МассивПредыдущихТитулов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.ПредыдущийТитул);
		
		РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
			МассивПредыдущихТитулов, ТипЛогистика, Ложь, ТекущаяСтрока.ДополнительныеПараметры);
		ВведенныеДокументы = РезультатВвода.ВведенныеДокументы;
		
		Для Каждого ТекущийДокумент Из ВведенныеДокументы Цикл
			#Если ВебКлиент Тогда
				КонтурЛогистика_ОбработкаДокументовКлиент.ПослеВводаПричиныОтказаНаВебКлиенте(ПричинаОтказа, ТекущийДокумент, ЭтаФорма);
			#Иначе
				КонтурЛогистика_ОбработкаДокументовКлиент.ПослеВводаПричиныОтказаНаКлиенте(ПричинаОтказа, ТекущийДокумент);
			#КонецЕсли
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДокументыКОбработкеИзСпискаЗадач(ТекущийСписокЗадач, ЭтоСменаВодителя = Ложь)
	
	ДокументыКОбработке = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из ТекущийСписокЗадач.ВыделенныеСтроки Цикл
		ТекущиеДанные = ТекущийСписокЗадач.ДанныеСтроки(ТекущаяСтрока);
		
		// Не даем подписать титул с отказом медика или тех контроля
		Если ТекущиеДанные.ИндексКартинкиСтатусаПодписания = ИндексКартинкиОтказ() Тогда
			Продолжить;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		
		Если ЭтоСменаВодителя Тогда
			
			ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
				ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4"),
				ТекущиеДанные.ДокументЛогистика);
			
			ДополнительныеПараметры.Вставить("ЭтоСменаВодителя", ЭтоСменаВодителя);
			Если ДиспетчерПрежнийРаботник Тогда
				
				Если ЗначениеЗаполнено(ПредыдущийТитул) Тогда
					ДанныеОтветственногоИзПредыдущегоТитула = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
						ПредыдущийТитул, "ОдометрРаботник, Должность");
					ДополнительныеПараметры.Вставить("ОдометрРаботник", ДанныеОтветственногоИзПредыдущегоТитула.ОдометрРаботник);
					ДополнительныеПараметры.Вставить("Должность", ДанныеОтветственногоИзПредыдущегоТитула.Должность);
				КонецЕсли;
				
			Иначе
				
				Если ЗначениеЗаполнено(ДиспетчерПоказанияОдометраРаботник) Тогда
					ДополнительныеПараметры.Вставить("ОдометрРаботник", ДиспетчерПоказанияОдометраРаботник);
				КонецЕсли;
				Если ЗначениеЗаполнено(ДиспетчерПоказанияОдометраДолжнось) Тогда
					ДополнительныеПараметры.Вставить("Должность", ДиспетчерПоказанияОдометраДолжнось);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДиспетчерПоказанияОдометраПоказания) Тогда
				ДополнительныеПараметры.Вставить("ПоказанияОдометра", ДиспетчерПоказанияОдометраПоказания);
			КонецЕсли;
			Если ДиспетчерПоказанияОдометраДатаИВремяВсегдаТекущее Тогда
				ДополнительныеПараметры.Вставить("ДатВрОдометр", ТекущаяДатаСеансаНаСервере());
			ИначеЕсли ЗначениеЗаполнено(ДиспетчерПоказанияОдометраДатаИВремя) Тогда
				ДополнительныеПараметры.Вставить("ДатВрОдометр", ДиспетчерПоказанияОдометраДатаИВремя);
			КонецЕсли;
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6") Тогда
			
			// если в Т2 Т3 Т6 выделено несколько строк то мы сейчас не пересчитываем значения для каждой строки и берем те что указаны справа
			// даже если выбрано ДанныеЗаполненияВручнуюПоказанияОдометра = ложь
			
			ДополнительныеПараметры.Вставить("Водитель", ТекущиеДанные.Водитель);
			
			Если ЗначениеЗаполнено(МедРаботник) Тогда
				ДополнительныеПараметры.Вставить("МедРаботник", МедРаботник);
			КонецЕсли;
			Если ЗначениеЗаполнено(МедЛицензия) Тогда
				ДополнительныеПараметры.Вставить("МедЛицензия", МедЛицензия);
			КонецЕсли;
			Если ЗначениеЗаполнено(МедДолжность) Тогда
				ДополнительныеПараметры.Вставить("Должность", МедДолжность);
			КонецЕсли;
			Если МедВремяВсегдаТекущее Тогда
				ДополнительныеПараметры.Вставить("ДатВрПрМО", ТекущаяДатаСеансаНаСервере());
			ИначеЕсли ЗначениеЗаполнено(МедДатВрПрМО) Тогда
				ДополнительныеПараметры.Вставить("ДатВрПрМО", МедДатВрПрМО);
			КонецЕсли;
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3") Тогда
			
			// если в Т2 Т3 Т6 выделено несколько строк то мы сейчас не пересчитываем значения для каждой строки и берем те что указаны справа
			// даже если выбрано ДанныеЗаполненияВручнуюПоказанияОдометра = ложь
			
			Если ЗначениеЗаполнено(ТехКонтрольРаботник) Тогда
				ДополнительныеПараметры.Вставить("ТехРаботник", ТехКонтрольРаботник);
			КонецЕсли;
			Если ЗначениеЗаполнено(ТехКонтрольДолжность) Тогда
				ДополнительныеПараметры.Вставить("Должность", ТехКонтрольДолжность);
			КонецЕсли;
			Если ТехКонтрольДатВрКонтВсегдаТекущее Тогда
				ДополнительныеПараметры.Вставить("ДатВрКонтТехСост", ТекущаяДатаСеансаНаСервере());
			ИначеЕсли ЗначениеЗаполнено(ТехКонтрольДатВрКонтТехСост) Тогда
				ДополнительныеПараметры.Вставить("ДатВрКонтТехСост", ТехКонтрольДатВрКонтТехСост);
			КонецЕсли;
			Если ТехКонтрольДатВрВыпВсегдаТекущее Тогда
				ДополнительныеПараметры.Вставить("ДатВрВыпНаЛин", ТекущаяДатаСеансаНаСервере());
			ИначеЕсли ЗначениеЗаполнено(ТехКонтрольДатВрВыпНаЛин) Тогда
				ДополнительныеПараметры.Вставить("ДатВрВыпНаЛин", ТехКонтрольДатВрВыпНаЛин);
			КонецЕсли;
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5") Тогда
			
			// если в Т4 Т5 выделено несколько строк то мы точно должны пересчитывать значения для каждой строки
			
			Если Не ДанныеЗаполненияВручнуюПоказанияОдометра
				И ТекущийСписокЗадач.ВыделенныеСтроки.Количество() > 1 Тогда // требуется пересчитывать значения заполнения для каждой строки если выделено несколько
				ЗаполнитьТекПоказанияОдометраРеквизитыЧерезНастройкуКонвертации(ТекущиеДанные);
			КонецЕсли;
			
			Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5") Тогда
				ДополнительныеПараметры.Вставить("ЭтоСменаВодителя", ПоказанияОдометраЭтоСменаВодителя);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПоказанияОдометраРаботник) Тогда
				ДополнительныеПараметры.Вставить("ОдометрРаботник", ПоказанияОдометраРаботник);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПоказанияОдометраДолжнось) Тогда
				ДополнительныеПараметры.Вставить("Должность", ПоказанияОдометраДолжнось);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПоказанияОдометраПоказания) Тогда
				ДополнительныеПараметры.Вставить("ПоказанияОдометра", ПоказанияОдометраПоказания);
			КонецЕсли;
			Если ПоказанияОдометраДатаИВремяВсегдаТекущее Тогда
				ДополнительныеПараметры.Вставить("ДатВрОдометр", ТекущаяДатаСеансаНаСервере());
			ИначеЕсли ЗначениеЗаполнено(ПоказанияОдометраДатаИВремя) Тогда
				ДополнительныеПараметры.Вставить("ДатВрОдометр", ПоказанияОдометраДатаИВремя);
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеОтправки = Новый Структура;
		ДанныеОтправки.Вставить("ПредыдущийТитул", ТекущиеДанные.ПредыдущийТитул);
		ДанныеОтправки.Вставить("ДополнительныеПараметры", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры));
		
		Если ЭтоСменаВодителя Тогда
			ДанныеОтправки.Вставить("ПредыдущийТитул", ПредыдущийТитул);
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1") Тогда
			ДанныеОтправки.Вставить("Документ1С", ТекущиеДанные.Документ1С);
			ДанныеОтправки.Вставить("ДокументЛогистика", ТекущиеДанные.ДокументЛогистика);
		КонецЕсли;
		
		ДокументыКОбработке.Добавить(ДанныеОтправки);
	КонецЦикла;
	
	Возврат ДокументыКОбработке;
	
КонецФункции

&НаКлиенте
