&НаКлиенте
Процедура ЗадачиПоказанияОдометраПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ЗадачиПоказанияОдометра.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполненияВручнуюПоказанияОдометра Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтборПоказанияОдометра <> "Выезд" И ОтборПоказанияОдометра <> "Заезд" Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТекПоказанияОдометраРеквизитыЧерезНастройкуКонвертации(ТекущиеДанные);
	
	ЗаполнитьПоказанияТоплива(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекПоказанияОдометраРеквизитыЧерезНастройкуКонвертации(Знач ТекущиеДанные)
	
	Перем ДанныеЗаполнения, ТипДокументаЛогистика;
	
	Если ОтборПоказанияОдометра = "Заезд" Тогда
		ОдометраПоказанияПредыдущие = ПоказанияОдометраТитула4(ТекущиеДанные.ГлавныйДокумент);
	КонецЕсли;
	
	Если ОтборПоказанияОдометра = "Выезд" Тогда
		ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4");
	ИначеЕсли ОтборПоказанияОдометра = "Заезд" Тогда
		ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5");
	Иначе
		ВызватьИсключение "ОтборПоказанияОдометра не заполнен";
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура("ЭтоСменаВодителя, ОдометрРаботник, Должность, ПоказанияОдометра, ДатВрОдометр");
	
	// Есть черновик, заполним данные заполнения из него
	Если ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик") Тогда
		Элементы.ДанныеЗаполненияВручнуюПоказанияОдометра.Доступность = Ложь;
		Элементы.ДекорацияДанныеЗаполненияВручнуюПоказанияОдометра.Видимость = Истина;
		ДанныеЗаполнения = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ТекущиеДанные.ДокументЛогистика, ДанныеЗаполнения);
	Иначе
		Элементы.ДанныеЗаполненияВручнуюПоказанияОдометра.Доступность = Истина;
		Элементы.ДекорацияДанныеЗаполненияВручнуюПоказанияОдометра.Видимость = Ложь;
		ЗаполнитьЧерезНастройкиКонвертации(ДанныеЗаполнения, ТипДокументаЛогистика, ТекущиеДанные.ПредыдущийТитул);
	КонецЕсли;
	
	ПоказанияОдометраЭтоСменаВодителя = ДанныеЗаполнения.ЭтоСменаВодителя;
	ПоказанияОдометраРаботник = ДанныеЗаполнения.ОдометрРаботник;
	ПоказанияОдометраДолжнось = ДанныеЗаполнения.Должность;
	ПоказанияОдометраПоказания = ДанныеЗаполнения.ПоказанияОдометра;
	ПоказанияОдометраДатаИВремя = ДанныеЗаполнения.ДатВрОдометр;

КонецПроцедуры

&НаКлиенте
