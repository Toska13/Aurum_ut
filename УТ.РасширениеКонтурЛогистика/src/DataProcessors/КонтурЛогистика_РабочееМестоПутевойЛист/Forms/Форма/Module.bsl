#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Период", Период);
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период.ДатаНачала = НачалоДня(ТекущаяДатаСеанса() - 1 * 24 * 3600);
		Период.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ИспользуютсяПутевыеЛисты = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	СвойМедик = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Медик");
	Если Не СвойМедик Тогда
		Элементы.ФормаМедосмотр.Видимость = Ложь;
	КонецЕсли;
	
	СвойТехОсмотр = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("ТехОсмотр");
	Если Не СвойТехОсмотр Тогда
		Элементы.ФормаТехКонтроль.Видимость = Ложь;
	КонецЕсли;
	
	Если ИспользуютсяПутевыеЛисты Тогда
		ПодготовитьСписки();
		ПодготовитьЭлементыДанныхУчетногоДокумента();
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82()
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		
		Элементы.ОтборДиспетчер.ОдинаковаяШиринаКолонок = Истина;
		Элементы.ОтборМедосмотр.ОдинаковаяШиринаКолонок = Истина;
		Элементы.ОтборТехКонтроль.ОдинаковаяШиринаКолонок = Истина;
		Элементы.ОтборПоказанияОдометра.ОдинаковаяШиринаКолонок = Истина;
		Элементы.ДекорацияЗадачиДиспетчерСменаВодителя.Высота = 2;
		Элементы.ГруппаЗадачиДиспетчерСменаВодителя.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	ПроверитьСоздатьПКДПутевыхЛистов(СвойМедик);
	
	ОбновитьВидимостьДоступностьПоГруппамДоступа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ИспользуютсяПутевыеЛисты Тогда
		
		Если Не ЗначениеЗаполнено(ТекущиВидАРМ) Тогда
			ТекущиВидАРМ = "Диспетчер";
		КонецЕсли;
		
		Если ТекущиВидАРМ = "Медик" И Не СвойМедик Тогда
			ТекущиВидАРМ = "Диспетчер";
		КонецЕсли;
		
		Если ТекущиВидАРМ = "Диспетчер" И Не Элементы.ФормаДиспетчер.Видимость Тогда
			ТекущиВидАРМ = "Медик";
		КонецЕсли;
		Если ТекущиВидАРМ = "Медик" И Не Элементы.ФормаМедосмотр.Видимость Тогда
			ТекущиВидАРМ = "ТехКонтроль";
		КонецЕсли;
		Если ТекущиВидАРМ = "ТехКонтроль" И Не Элементы.ФормаТехКонтроль.Видимость Тогда
			ТекущиВидАРМ = "ПоказанияОдометра";
		КонецЕсли;
		Если ТекущиВидАРМ = "ПоказанияОдометра" И Не Элементы.ФормаПоказанияОдометра.Видимость Тогда
			Закрыть();
			Сообщить("У вас нет доступа. Обратитесь к администратору.");
		КонецЕсли;
		
		ПриСменеСтранициЗадачНаКлиенте();
		
		ПриИзмененииАвтообновленияФормы(АвтообновлениеФормы);
		
		ОборудованиеУстановитьВидимостьВыключения();
		ИспользоватьПодключаемоеОборудование = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ИспользоватьОборудование");
		Если ИспользоватьПодключаемоеОборудование Тогда
			
			ПодключитьОбработчикОжидания("ОткрытьФормуПодключенноеОборудованиеОбработчикОжидания", 0.5, Истина);
			
		КонецЕсли;
		
		Элементы.ГруппаДиспетчерВПутиЗаполнение.Видимость = Ложь;
		
		ПолучитьУведомленияИзСервиса();
		
	Иначе
		
		Закрыть();
		
		Сообщить("Использование путевых листов отключено");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ВвестиДокумент"
		Или ИмяСобытия = "КонтурЛогистика_ЗакрытиеФормыСлеженияЗаФайлами"
		Или ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов"
		Или ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
		Или (ИмяСобытия = "ЗавершениеФоновогоЗадания"
			И Параметр.Свойство("КлючФЗ")
			И Лев(Параметр.КлючФЗ, 17) = "Выполнение обмена") Тогда
		
		ОбновитьСпискиЗадач();
		
	ИначеЕсли ИмяСобытия = "TracksData"
		И Источник = "ПодключаемоеОборудование"
		И КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ИспользоватьОборудование") Тогда
		
		ОбработкаОповещения_ПЛ_РМ_ИспользоватьОборудование(Параметр);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод Тогда
		
		Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
			Период.ДатаНачала = ТекущаяДатаСеансаНаСервере() - 5 * 86400;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
			Период.ДатаОкончания = КонецДня(ТекущаяДатаСеансаНаСервере());
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТекущиВидАРМ = "Диспетчер" Тогда
		
		УстановитьПараметрыДинамическогоСписка(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1"));
		
	ИначеЕсли СвойМедик И ТекущиВидАРМ = "Медосмотр" Тогда
		
		Если ОтборМедосмотр = "Предсменный" Тогда
			УстановитьПараметрыДинамическогоСписка(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2"));
		ИначеЕсли ОтборМедосмотр = "Послесменный" Тогда
			УстановитьПараметрыДинамическогоСписка(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6"));
		Иначе
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокМедосмотр, "ДатВрПрМО",
				Период.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,, Истина);
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокМедосмотр, "ДатВрПрМО2",
				Период.ДатаОкончания, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,, Истина);
		КонецЕсли;
		
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		
		УстановитьПараметрыДинамическогоСписка(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3"));
		
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		
		Если ОтборПоказанияОдометра = "Выезд" Тогда
			УстановитьПараметрыДинамическогоСписка(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4"));
		ИначеЕсли ОтборПоказанияОдометра = "Заезд" Тогда
			УстановитьПараметрыДинамическогоСписка(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5"));
		Иначе
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокПоказанияОдометра, "ДатВрОдометр",
				Период.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,, Истина);
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокПоказанияОдометра, "ДатВрОдометр2",
				Период.ДатаОкончания, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДиспетчерПриИзменении(Элемент)
	
	Если ОтборДиспетчер = "НеПодписанные" Тогда
		ИндексыНеПодписанных = Новый Массив;
		ИндексыНеПодписанных.Добавить(ИндексКартинкиЧерновик());
		ИндексыНеПодписанных.Добавить(ИндексКартинкиОтказ());
		ИндексыНеПодписанных.Добавить(ИндексКартинкиОшибка());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиДиспетчер, "ИндексКартинкиСтатусаПодписания",
			ИндексыНеПодписанных, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборДиспетчер = "Подписанные" Тогда
		ИндексыПодписанный = Новый Массив;
		ИндексыПодписанный.Добавить(ИндексКартинкиВыполнитьОбмен());
		ИндексыПодписанный.Добавить(ИндексКартинкиГотово());
		ИндексыПодписанный.Добавить(ИндексКартинкиОтказ());
		ИндексыПодписанный.Добавить(ИндексКартинкиQRКод());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиДиспетчер, "ИндексКартинкиСтатусаПодписания",
			ИндексыПодписанный, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборДиспетчер = "ВПути" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиДиспетчер, "ИндексКартинкиСтатусаПодписания",
			ИндексКартинкиQRКод(), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборДиспетчер = "Все" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиДиспетчер, "ИндексКартинкиСтатусаПодписания",
			0, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонецЕсли;
	
	ОтборПоНеПодписанным = (ОтборДиспетчер = "НеПодписанные");
	ОтборПодписанные = (ОтборДиспетчер = "Подписанные");
	ОтборВПути = (ОтборДиспетчер = "ВПути");
	
	Элементы.ЗадачиДиспетчерПодписатьТитул.Видимость = (Не ОтборПодписанные И Не ОтборВПути);
	Элементы.ЗадачиДиспетчерСменаВодителя.Видимость = Не ОтборПоНеПодписанным;
	Элементы.ЗадачиДиспетчерОформитьТитул.Видимость = (Не ОтборПодписанные И Не ОтборВПути);
	Элементы.ЗадачиДиспетчерСоздатьТитул1.Видимость = Не ОтборВПути;
	Элементы.ЗадачиДиспетчерСоздатьТитул1Копированием.Видимость = Не ОтборВПути;
	Элементы.ЗадачиДиспетчерСтатусЭТРН.Видимость = Не ОтборПоНеПодписанным;
	Элементы.ГруппаДиспетчерДокументДанныеТитула.Видимость = Не ОтборПоНеПодписанным;
	
	Если ОтборДиспетчер = "ВПути" Тогда
		Элементы.ЗадачиДиспетчерСменаВодителя.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ЗадачиДиспетчерПодписатьТитул.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ЗадачиДиспетчер.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.ГруппаТумблерСменаВодителя.Видимость = (ТекущиеДанные.ИндексКартинкиСтатусаПодписания = ИндексКартинкиQRКод());
		Элементы.ГруппаДиспетчерВПутиЗаполнение.Видимость = (Не Элементы.ГруппаТумблерСменаВодителя.Видимость);
	Иначе
		Элементы.ГруппаТумблерСменаВодителя.Видимость = Ложь;
		Элементы.ГруппаДиспетчерВПутиЗаполнение.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ДиспетчерНомерСменыВодителя.Видимость = Не ДиспетчерПрежнийНомер;
	Элементы.ДиспетчерПоказанияОдометраРаботник.Видимость = Не ДиспетчерПрежнийРаботник;
	Элементы.ДиспетчерПоказанияОдометраДолжнось.Видимость = Не ДиспетчерПрежнийРаботник;
	
	ПериодПриИзменении(Неопределено);
	
	ОбновитьВидимостьДоступностьОбъектовЗаполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборМедосмотрПриИзменении(Элемент)
	
	Если ОтборМедосмотр = "Предсменный" Или ОтборМедосмотр = "Послесменный" Тогда
		
		Элементы.ГруппаМедосмотрСписки.ТекущаяСтраница = Элементы.ГруппаМедосмотрЗадачи;
		Элементы.МедосмотрЗадачиНайти.Видимость = Истина;
		Элементы.МедосмотрСписокНайти.Видимость = Ложь;
		
		Если ОтборМедосмотр = "Предсменный" Тогда
			ОтобразитьОтборДополнительныеКолонки("ЗадачиМедосмотр", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2"));   
		Иначе
			ОтобразитьОтборДополнительныеКолонки("ЗадачиМедосмотр", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6"));  
		КонецЕсли;
		
	Иначе
		Элементы.ГруппаМедосмотрСписки.ТекущаяСтраница = Элементы.ГруппаМедосмотрСписок;
		Элементы.МедосмотрЗадачиНайти.Видимость = Ложь;
		Элементы.МедосмотрСписокНайти.Видимость = Истина;
		УдалитьДополнительныеКолонкиИОтборы("ЗадачиМедосмотр");
	КонецЕсли;
	
	Если ОтборМедосмотр = "Предсменный" Тогда
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2");
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиМедосмотр, "СтатусЭТРН",
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостоянияМедосмотрПредсменный(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиМедосмотр, "ТребуемоеДействие",
			ТребуемыхДействийАктивные(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборМедосмотр = "Послесменный" Тогда
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6");
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиМедосмотр, "СтатусЭТРН",
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостоянияМедосмотрПослесменный(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиМедосмотр, "ТребуемоеДействие",
			ТребуемыхДействийАктивные(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборМедосмотр = "Подписанные" Тогда
		ИндексыПодписанный = Новый Массив;
		ИндексыПодписанный.Добавить(ИндексКартинкиВыполнитьОбмен());
		ИндексыПодписанный.Добавить(ИндексКартинкиГотово());
		ИндексыПодписанный.Добавить(ИндексКартинкиQRКод());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокМедосмотр, "ИндексКартинкиСтатусаПодписания",
			ИндексыПодписанный, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборМедосмотр = "НеПройденныеМедосмотры" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокМедосмотр, "ИндексКартинкиСтатусаПодписания",
			3, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборМедосмотр = "Все" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокМедосмотр, "ИндексКартинкиСтатусаПодписания",
			0, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонецЕсли;
	
	Если Элементы.ГруппаМедосмотрЗаполнение.Скрыта()
		И Не ПроверитьЗаполнениеПередПодписанием(Истина) Тогда
		
		Элементы.ГруппаМедосмотрЗаполнение.Показать();
	КонецЕсли;
	
	ПериодПриИзменении(Неопределено);
	
	ЗадачиМедосмотрПриАктивизацииСтроки(Неопределено);
	
	Если ОтборМедосмотр = "Предсменный" Или ОтборМедосмотр = "Послесменный" Тогда
		ЕстьДоступ = ЕстьДоступСозданиеРедактированиеЭлементов(ТипЛогистика);
		
		Элементы.ЗадачиМедосмотрПодписатьТитул.Доступность = ЕстьДоступ;
		Элементы.ЗадачиМедосмотрОтказатьТитул.Доступность = ЕстьДоступ;
		Элементы.ГруппаМедосмотрЗаполнение.Доступность = ЕстьДоступ;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборТехКонтрольПриИзменении(Элемент)
	
	Если ОтборТехКонтроль = "НеПодписанные" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "СтатусЭТРН",
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостоянияТехКонтроль(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "ДокументЛогистика",,
			ВидСравненияКомпоновкиДанных.Заполнено,, Ложь);
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "СтатусЭТРН",
			Неопределено, ВидСравненияКомпоновкиДанных.ВСписке,, Ложь);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "ДокументЛогистика",,
			ВидСравненияКомпоновкиДанных.Заполнено,, Истина);
	КонецЕсли;
	
	Если ОтборТехКонтроль = "НеПодписанные" Тогда
		ИндексыНеПодписанных = Новый Массив;
		ИндексыНеПодписанных.Добавить(ИндексКартинкиЧерновик());
		ИндексыНеПодписанных.Добавить(ИндексКартинкиОшибка());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "ИндексКартинкиСтатусаПодписания",
			ИндексыНеПодписанных, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборТехКонтроль = "Подписанные" Тогда
		ИндексыПодписанный = Новый Массив;
		ИндексыПодписанный.Добавить(ИндексКартинкиВыполнитьОбмен());
		ИндексыПодписанный.Добавить(ИндексКартинкиГотово());
		ИндексыПодписанный.Добавить(ИндексКартинкиQRКод());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "ИндексКартинкиСтатусаПодписания",
			ИндексыПодписанный, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборТехКонтроль = "ВыпускНеРазрешен" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "ИндексКартинкиСтатусаПодписания",
			3, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборТехКонтроль = "Все" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, "ИндексКартинкиСтатусаПодписания",
			0, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонецЕсли;
	
	Элементы.ЗадачиТехКонтрольПодписатьТитул.Видимость = (ОтборТехКонтроль = "НеПодписанные");
	Элементы.ЗадачиТехКонтрольОтказатьТитул.Видимость = (ОтборТехКонтроль = "НеПодписанные");
	
	Если Элементы.ГруппаТехКонтрольЗаполнение.Скрыта()
		И Не ПроверитьЗаполнениеПередПодписанием(Истина) Тогда
		
		Элементы.ГруппаТехКонтрольЗаполнение.Показать();
	КонецЕсли;
	
	ПериодПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоказанияОдометраПриИзменении(Элемент)
	
	ЭтоЗаезд = (ОтборПоказанияОдометра = "Заезд");
	
	Элементы.ПоказанияОдометраЭтоСменаВодителя.Видимость = ЭтоЗаезд;
	
	Если ОтборПоказанияОдометра = "Выезд" Или ОтборПоказанияОдометра = "Заезд" Тогда
		
		Элементы.ГруппаПоказанияОдометраСписки.ТекущаяСтраница = Элементы.ГруппаПоказанияОдометраЗадачи;
		Элементы.ПоказанияОдометраЗадачиНайти.Видимость = Истина;
		Элементы.ПоказанияОдометраСписокНайти.Видимость = Ложь;
		
		Если ОтборПоказанияОдометра = "Выезд" Тогда
			ОтобразитьОтборДополнительныеКолонки("ЗадачиПоказанияОдометра", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4"));
		Иначе
			ОтобразитьОтборДополнительныеКолонки("ЗадачиПоказанияОдометра", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5"));
		КонецЕсли;
		
	Иначе
		Элементы.ГруппаПоказанияОдометраСписки.ТекущаяСтраница = Элементы.ГруппаПоказанияОдометраСписок;
		Элементы.ПоказанияОдометраЗадачиНайти.Видимость = Ложь;
		Элементы.ПоказанияОдометраСписокНайти.Видимость = Истина;
		УдалитьДополнительныеКолонкиИОтборы("ЗадачиПоказанияОдометра");
	КонецЕсли;
	
	Элементы.ГруппаПоказанияОдометраПредыдущие.Видимость = ЭтоЗаезд;
	Элементы.ДекорацияПоказанияОдометраПоказания.Видимость = Не ЭтоЗаезд;
	
	Если ОтборПоказанияОдометра = "Выезд" Тогда
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4");
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиПоказанияОдометра, "СтатусЭТРН",
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостоянияПоказанияОдометраВыезд(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиПоказанияОдометра, "ТребуемоеДействие",
			ТребуемыхДействийАктивные(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборПоказанияОдометра = "Заезд" Тогда
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5");
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиПоказанияОдометра, "СтатусЭТРН",
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостоянияПоказанияОдометраЗаезд(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиПоказанияОдометра, "ТребуемоеДействие",
			ТребуемыхДействийАктивные(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборПоказанияОдометра = "Подписанные" Тогда
		ИндексыПодписанный = Новый Массив;
		ИндексыПодписанный.Добавить(ИндексКартинкиВыполнитьОбмен());
		ИндексыПодписанный.Добавить(ИндексКартинкиГотово());
		ИндексыПодписанный.Добавить(ИндексКартинкиQRКод());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокПоказанияОдометра, "ИндексКартинкиСтатусаПодписания",
			ИндексыПодписанный, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	ИначеЕсли ОтборПоказанияОдометра = "Все" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокПоказанияОдометра, "ИндексКартинкиСтатусаПодписания",
			0, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонецЕсли;
	
	Если Элементы.ГруппаПоказанияОдометраЗаполнение.Скрыта()
		И Не ПроверитьЗаполнениеПередПодписанием(Истина) Тогда
		
		Элементы.ГруппаПоказанияОдометраЗаполнение.Показать();
	КонецЕсли;
	
	ПериодПриИзменении(Неопределено);
	
	ЗадачиПоказанияОдометраПриАктивизацииСтроки(Неопределено);
	
	Если ОтборПоказанияОдометра = "Выезд" Или ОтборПоказанияОдометра = "Заезд" Тогда
		ЕстьДоступ = ЕстьДоступСозданиеРедактированиеЭлементов(ТипЛогистика);
		
		Элементы.ЗадачиПоказанияОдометраПодписатьТитул.Доступность = ЕстьДоступ;
		Элементы.ГруппаПоказанияОдометраЗаполнение.Доступность = ЕстьДоступ;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗадачиДиспетчер

&НаКлиенте
Процедура ЗадачиДиспетчерВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = Поле.Имя;
	
	Если ИмяКолонки = "ЗадачиДиспетчерСтатусЭТРН" И ТекущиеДанные.ИндексКартинкиСтатусаПодписания = 5 Тогда
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ДокументСсылка", ТекущиеДанные.ДокументЛогистика);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ОтправкаQRКода", ПараметрыОткрытия);
		
	ИначеЕсли ИмяКолонки = "ЗадачиДиспетчерДокументЛогистика" Тогда
		
		ПоказываемТитул = Неопределено;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументЛогистика) Тогда 
			ПоказываемТитул = ТекущиеДанные.ДокументЛогистика;
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ПредыдущийТитул) Тогда
			ПоказываемТитул = ТекущиеДанные.ПредыдущийТитул;
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДокументЭТРН) Тогда
			ПоказываемТитул = ТекущиеДанные.ДокументЭТРН;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоказываемТитул) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ПоказываемТитул, ЭтаФорма);
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Документ1С) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.Документ1С, ЭтаФорма);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиДиспетчерПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ЗадачиДиспетчер.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаДиспетчерВодитель2.Видимость = ЗначениеЗаполнено(ТекущиеДанные.Водитель2);
	
	ЭтоСправочникЛогистики = ТипЗнч(ТекущиеДанные.ТранспортноеСредство) = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства");
	
	Если ЕстьНастройкиКонвертацииТС Тогда
		ГрузоподъемностьВТоннах = Элементы.Найти("ДиспетчерДокументТранспортноеСредствоГрузоподъемностьВТоннах");
		Если ГрузоподъемностьВТоннах <> Неопределено Тогда
			ГрузоподъемностьВТоннах.Видимость = Не ЭтоСправочникЛогистики;
		КонецЕсли;
		
		ВместимостьВКубическихМетрах = Элементы.Найти("ДиспетчерТранспортноеСредствоВместимостьВКубическихМетрах");
		Если ВместимостьВКубическихМетрах <> Неопределено Тогда
			ВместимостьВКубическихМетрах.Видимость = Не ЭтоСправочникЛогистики;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияТонн.Видимость = ЭтоСправочникЛогистики;
		Элементы.ДекорацияКубМ.Видимость = ЭтоСправочникЛогистики;
	КонецЕсли;
	
	Если Элементы.Найти("ДиспетчерДокументТранспортноеСредствоГрузоподъемностьВТоннахКЛ") <> Неопределено Тогда
		Элементы.ДиспетчерДокументТранспортноеСредствоГрузоподъемностьВТоннахКЛ.Видимость = ЭтоСправочникЛогистики;
	КонецЕсли;
	Если Элементы.Найти("ДиспетчерТранспортноеСредствоВместимостьВКубическихМетрахКЛ") <> Неопределено Тогда
		Элементы.ДиспетчерТранспортноеСредствоВместимостьВКубическихМетрахКЛ.Видимость = ЭтоСправочникЛогистики;
	КонецЕсли;
	
	// В пути
	СтатусВПути = (ТекущиеДанные.ИндексКартинкиСтатусаПодписания = ИндексКартинкиQRКод());
	Если СтатусВПути Тогда
		Если Не Элементы.ГруппаДиспетчерВПутиЗаполнение.Видимость
			И Не Элементы.ГруппаТумблерСменаВодителя.Видимость Тогда
			
			Элементы.ГруппаТумблерСменаВодителя.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГруппаТумблерСменаВодителя.Видимость = Ложь;
		Элементы.ГруппаДиспетчерВПутиЗаполнение.Видимость = Ложь;
	КонецЕсли;
	
	Если СтатусВПути
		И ((ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") И ТекущийЭлемент.Имя = "ЗадачиДиспетчер")
			Или (ТипЗнч(ТекущийЭлемент) = Тип("КнопкаФормы") И ТекущийЭлемент.Имя = "ТумблерСменаВодителя")) Тогда
		ДанныеЗаполнения = Новый Структура("ЭтоСменаВодителя, ОдометрРаботник, Должность, ПоказанияОдометра, ДатВрОдометр, Титул1");
		
		ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5");
		ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4"), ТекущиеДанные.ДокументЛогистика);
		
		ЗаполнитьЧерезНастройкиКонвертации(ДанныеЗаполнения, ТипДокументаЛогистика, ПредыдущийТитул);
		
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Титул1) Тогда
			ДиспетчерНомерСменыВодителя = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				ДанныеЗаполнения.Титул1, "НомерПЛ");
		КонецЕсли;
		ДиспетчерПоказанияОдометраРаботник = ДанныеЗаполнения.ОдометрРаботник;
		ДиспетчерПоказанияОдометраДолжнось = ДанныеЗаполнения.Должность;
