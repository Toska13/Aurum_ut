		|			ИЛИ КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
		|			ТОГДА 2
		|		КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
		|			ТОГДА 4
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК ИндексКартинкиСтатусаПодписания,";
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыДинамическогоСписка(ТипЛогистика, СпецСценарий = Неопределено)
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		ТекущийСписокЗадач = ЗадачиДиспетчер;
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		
		ТекущийСписокЗадач = ЗадачиМедосмотр;
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		ТекущийСписокЗадач = ЗадачиТехКонтроль;
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		
		ТекущийСписокЗадач = ЗадачиПоказанияОдометра;
	КонецЕсли;
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 И Не ЕстьНастройкиКонвертацииТ1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущийСписокЗадач.Параметры.Элементы.Найти("НачалоПериода") <> Неопределено Тогда
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
	КонецЕсли;
	
	// Введенные титулы могут по дате отличаться от предыдущих - расширим диапазон анализа текущего документа
	Если ТекущийСписокЗадач.Параметры.Элементы.Найти("НачалоПериодаПоследующийТитул") <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
			ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПоследующийТитул", Период.ДатаНачала);
		Иначе
			ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПоследующийТитул", Период.ДатаНачала - 5 * 86400);
		КонецЕсли;
	КонецЕсли;
	
	// Определяем дополнительные параметры запроса в зависимости от типа титула и специального сценария
	ПараметрыСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПараметрыСпискаПоТипуЛогистики(
		ТипЛогистика, СпецСценарий);
	Для Каждого ТекущийПараметр Из ПараметрыСписка Цикл
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
	КонецЦикла;
	
	// Введенные титулы могут по дате отличаться от предыдущих - расширим диапазон анализа текущего документа
	СекундВЧасе = 60 * 60;
	СмещениеОкончанияПериода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СмещениеОкончанияПериодаСпискаЗадач") * СекундВЧасе;
	ОкончаниеПериода = Период.ДатаОкончания + СмещениеОкончанияПериода;
	ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра("ОкончаниеПериода", ОкончаниеПериода);
	Если ТекущийСписокЗадач.Параметры.Элементы.Найти("ОкончаниеПериодаПоследующийТитул") <> Неопределено Тогда
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра("ОкончаниеПериодаПоследующийТитул", ОкончаниеПериода + 5 * 86400);
	КонецЕсли;
	
	Если ТекущийСписокЗадач.Параметры.Элементы.Найти("ТекущийПользователь") <> Неопределено Тогда
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	КонецЕсли;
	
	// Статус документооборота в пути
	Если ТекущийСписокЗадач.Параметры.Элементы.Найти("СтатусДокументооборотаВПути") <> Неопределено Тогда
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра(
			"СтатусДокументооборотаВПути", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостояниеПутевогоЛистаВПути());
	КонецЕсли;
	
	// Параметр - Сценарий
	Если ЗначениеЗаполнено(ТекущийСписокЗадач.ТекстЗапроса) И Найти(ТекущийСписокЗадач.ТекстЗапроса, "&Сценарий") > 0 Тогда
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра(
			"Сценарий", Перечисления.КонтурЛогистика_Сценарии.Отправка);
	КонецЕсли;
	
	// Парамерт - НаправлениеКонвертации
	Если ЗначениеЗаполнено(ТекущийСписокЗадач.ТекстЗапроса) И Найти(ТекущийСписокЗадач.ТекстЗапроса, "&НаправлениеКонвертации") > 0 Тогда
		ТекущийСписокЗадач.Параметры.УстановитьЗначениеПараметра(
			"НаправлениеКонвертации", Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОформитьОтображениеДокументЛогистика(Строки)
	
	Для Каждого СтрокаСписка Из Строки Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ДокументЛогистика)
			И Не ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ПредыдущийТитул) Тогда
			
			ПредставлениеДокументаЛогистика = "";
			ПредставлениеПредыдущегоТитула = "";
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ДокументЛогистика) Тогда
			
			ПредставлениеДокументаЛогистика = "" // может быть ТрН или ЗН или СВ
				+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(СтрокаСписка.Значение.Данные.НомерТрН) 
				+ " от " 
				+ Формат(СтрокаСписка.Значение.Данные.ДатаТрН, "ДФ=dd.MM");
			ПредставлениеПредыдущегоТитула = "";
			
		Иначе
			ПредставлениеПредыдущегоТитула = ""  // может быть ТрН или ЗН или СВ
				+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(СтрокаСписка.Значение.Данные.НомерТрН) 
				+ " от " 
				+ Формат(СтрокаСписка.Значение.Данные.ДатаТрН, "ДФ=dd.MM");
			ПредставлениеДокументаЛогистика = "";
		КонецЕсли;
		
		ОфДокЛогистика = СтрокаСписка.Значение.Оформление.Получить("ДокументЛогистика");
		Если ЗначениеЗаполнено(ОфДокЛогистика) Тогда 
			ОфДокЛогистика.УстановитьЗначениеПараметра("Текст", ПредставлениеДокументаЛогистика);
		КонецЕсли;
		
		ОфПредыдущийТитул = СтрокаСписка.Значение.Оформление.Получить("ПредыдущийТитул");
		Если ЗначениеЗаполнено(ОфПредыдущийТитул) Тогда 
			ОфПредыдущийТитул.УстановитьЗначениеПараметра("Текст", ПредставлениеПредыдущегоТитула);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьЭлементыДанныхУчетногоДокумента()
	
	ПараметрыВодителя = Новый Структура("ВУНомер, ВУСерия, ВУДатаВыдачи");
	ПараметрыТранспортногоСредства = Новый Структура("РегНомер, ВместимостьКубМ, ГрузоподъемностьТонн");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.РеквизитСправочникаЛогистика КАК РеквизитСправочникаЛогистика,
	|	КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.ВыражениеВычисления КАК ВыражениеВычисления
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.ПравилаКонвертации КАК КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК КонтурЛогистика_НастройкиКонвертацииСправочников
	|		ПО КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.Ссылка = КонтурЛогистика_НастройкиКонвертацииСправочников.Ссылка
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииСправочников.ТипСправочникаЛогистика = ""КонтурЛогистика_Сотрудники""
	|	И КонтурЛогистика_НастройкиКонвертацииСправочников.РеквизитТитула = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.Водитель)
	|	И КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.СпособМаппинга = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС)
	|	И НЕ КонтурЛогистика_НастройкиКонвертацииСправочников.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.РеквизитСправочникаЛогистика = "ВУНомер" Тогда
			ПараметрыВодителя.ВУНомер = Выборка.ВыражениеВычисления;
		КонецЕсли;
		
		Если Выборка.РеквизитСправочникаЛогистика = "ВУСерия" Тогда
			ПараметрыВодителя.ВУСерия = Выборка.ВыражениеВычисления;
		КонецЕсли;
		
		Если Выборка.РеквизитСправочникаЛогистика = "ВУДатаВыдачи" Тогда
			ПараметрыВодителя.ВУДатаВыдачи = Выборка.ВыражениеВычисления;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.РеквизитСправочникаЛогистика КАК РеквизитСправочникаЛогистика,
	|	КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.ВыражениеВычисления КАК ВыражениеВычисления
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.ПравилаКонвертации КАК КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК КонтурЛогистика_НастройкиКонвертацииСправочников
	|		ПО КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.Ссылка = КонтурЛогистика_НастройкиКонвертацииСправочников.Ссылка
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииСправочников.ТипСправочникаЛогистика = ""КонтурЛогистика_ТранспортныеСредства""
	|	И КонтурЛогистика_НастройкиКонвертацииСправочниковПравилаКонвертации.СпособМаппинга = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС)
	|	И НЕ КонтурЛогистика_НастройкиКонвертацииСправочников.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.РеквизитСправочникаЛогистика = "РегНомер" Тогда
			ПараметрыТранспортногоСредства.РегНомер = Выборка.ВыражениеВычисления;
		КонецЕсли;
		
		Если Выборка.РеквизитСправочникаЛогистика = "ВместимостьКубМ" Тогда
			ПараметрыТранспортногоСредства.ВместимостьКубМ = Выборка.ВыражениеВычисления;
		КонецЕсли;
		
		Если Выборка.РеквизитСправочникаЛогистика = "ГрузоподъемностьТонн" Тогда
			ПараметрыТранспортногоСредства.ГрузоподъемностьТонн = Выборка.ВыражениеВычисления;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПараметрыВодителя.ВУНомер) И ЗначениеЗаполнено(ПараметрыВодителя.ВУСерия) Тогда
		
		// Водитель 1
		ГруппаВодитель = Элементы.ГруппаДанныеВодителя;
		
		ИмяЭлемента = "ДиспетчерДокументВодительВУСерия";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель." + ПараметрыВодителя.ВУСерия;
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "Водительское удостоверение");
		
		ИмяЭлемента = "ДиспетчерДокументВодительВУНомер";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель." + ПараметрыВодителя.ВУНомер;
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным);
		
		Если ЗначениеЗаполнено(ПараметрыВодителя.ВУДатаВыдачи) Тогда
			ИмяЭлемента = "ДиспетчерДокументВодительВУДатаВыдачи";
			ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель." + ПараметрыВодителя.ВУДатаВыдачи;
			НовыйЭлемент = ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "от");
		КонецЕсли;
		
		// Водитель 2
		ГруппаВодитель = Элементы.ГруппаДанныеВодителя2;
		
		ИмяЭлемента = "ДиспетчерДокументВодитель2ВУСерия";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель2." + ПараметрыВодителя.ВУСерия;
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "Водительское удостоверение");
		
		ИмяЭлемента = "ДиспетчерДокументВодитель2ВУНомер";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель2." + ПараметрыВодителя.ВУНомер;
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным);
		
		Если ЗначениеЗаполнено(ПараметрыВодителя.ВУДатаВыдачи) Тогда
			ИмяЭлемента = "ДиспетчерДокументВодитель2ВУДатаВыдачи";
			ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель2." + ПараметрыВодителя.ВУДатаВыдачи;
			НовыйЭлемент = ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "от");
		КонецЕсли;
	Иначе
		
		// Водитель 1
		ГруппаВодитель = Элементы.ГруппаДанныеВодителя;
		
		ИмяЭлемента = "ДиспетчерДокументВодительВУСерия";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель.ВУСерия";
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "Водительское удостоверение");
		
		ИмяЭлемента = "ДиспетчерДокументВодительВУНомер";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель.ВУНомер";
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным);
		
		Если ЗначениеЗаполнено(ПараметрыВодителя.ВУДатаВыдачи) Тогда
			ИмяЭлемента = "ДиспетчерДокументВодительВУДатаВыдачи";
			ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель.ВУДатаВыдачи";
			НовыйЭлемент = ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "от");
		КонецЕсли;
		
		// Водитель 2
		ГруппаВодитель = Элементы.ГруппаДанныеВодителя2;
		
		ИмяЭлемента = "ДиспетчерДокументВодитель2ВУСерия";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель2.ВУСерия";
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "Водительское удостоверение");
		
		ИмяЭлемента = "ДиспетчерДокументВодитель2ВУНомер";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель2.ВУНомер";
		ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным);
		
		Если ЗначениеЗаполнено(ПараметрыВодителя.ВУДатаВыдачи) Тогда
			ИмяЭлемента = "ДиспетчерДокументВодитель2ВУДатаВыдачи";
			ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.Водитель2.ВУДатаВыдачи";
			НовыйЭлемент = ДобавитьЭлементОтображения(ГруппаВодитель, ИмяЭлемента, ПутьКДанным, "от");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыТранспортногоСредства.ГрузоподъемностьТонн)
		И ЗначениеЗаполнено(ПараметрыТранспортногоСредства.ВместимостьКубМ) Тогда
		
		ЕстьНастройкиКонвертацииТС = Истина;
		
		ИмяЭлемента = "ДиспетчерДокументТранспортноеСредствоГрузоподъемностьВТоннах";
		Если ЗначениеЗаполнено(ПараметрыТранспортногоСредства.ГрузоподъемностьТонн) Тогда
			ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.ТранспортноеСредство." + ПараметрыТранспортногоСредства.ГрузоподъемностьТонн;
		КонецЕсли;
		НовыйЭлемент = ДобавитьЭлементОтображения(Элементы.ГруппаТСГрузоподъемность, ИмяЭлемента, ПутьКДанным, "Грузоподъемность");
		Если НовыйЭлемент <> Неопределено Тогда
			Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаТСГрузоподъемность, Элементы.ДекорацияТонн);
		КонецЕсли;
		
		ИмяЭлемента = "ДиспетчерТранспортноеСредствоВместимостьВКубическихМетрах";
		ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.ТранспортноеСредство." + ПараметрыТранспортногоСредства.ВместимостьКубМ;
		НовыйЭлемент = ДобавитьЭлементОтображения(Элементы.ГруппаТСВместимость, ИмяЭлемента, ПутьКДанным, "Вместимость");
		Если НовыйЭлемент <> Неопределено Тогда
			Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаТСВместимость, Элементы.ДекорацияКубМ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыТранспортногоСредства.РегНомер) Тогда
			ИмяЭлемента = "ДиспетчерДокументТранспортноеСредствоРегНомер";
			ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.ТранспортноеСредство." + ПараметрыТранспортногоСредства.РегНомер;
			НовыйЭлемент = ДобавитьЭлементОтображения(Элементы.ГруппаДиспетчерДокументТС, ИмяЭлемента, ПутьКДанным, "Гос. рег. номер");
			Если НовыйЭлемент <> Неопределено Тогда
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаДиспетчерДокументТС, Элементы.ГруппаТСГрузоподъемность);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЕстьНастройкиКонвертацииТС = Ложь;
	КонецЕсли;
	
	ИмяЭлемента = "ДиспетчерДокументТранспортноеСредствоГрузоподъемностьВТоннахКЛ";
	ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.ТранспортноеСредство.ГрузоподъемностьТонн";
	НовыйЭлемент = ДобавитьЭлементОтображения(Элементы.ГруппаТСГрузоподъемность, ИмяЭлемента, ПутьКДанным, "Грузоподъемность");
	Если НовыйЭлемент <> Неопределено Тогда
		Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаТСГрузоподъемность, Элементы.ДекорацияТонн);
	КонецЕсли;
	
	ИмяЭлемента = "ДиспетчерТранспортноеСредствоВместимостьВКубическихМетрахКЛ";
	ПутьКДанным = "Элементы.ЗадачиДиспетчер.ТекущиеДанные.ТранспортноеСредство.ВместимостьКубМ";
	НовыйЭлемент = ДобавитьЭлементОтображения(Элементы.ГруппаТСВместимость, ИмяЭлемента, ПутьКДанным, "Вместимость");
	Если НовыйЭлемент <> Неопределено Тогда
		Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаТСВместимость, Элементы.ДекорацияКубМ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьЭлементОтображения(ГруппаРодитель, ИмяЭлемента, ПутьКДанным, Заголовок = "")
	
	НовыйЭлемент = Неопределено;
	
	Попытка
		НовыйЭлемент = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаРодитель);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = ПутьКДанным;
		НовыйЭлемент.Шрифт = Новый Шрифт(,, Истина);
		НовыйЭлемент.ЦветРамки = ЦветаСтиля.ЦветФонаФормы;
		НовыйЭлемент.КнопкаВыбора = Ложь;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.МаксимальнаяШирина = 8;
		
		Если ЗначениеЗаполнено(Заголовок) Тогда
			НовыйЭлемент.Заголовок = Заголовок;
		Иначе
			НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		КонецЕсли;
	Исключение
		// Не требуется  
	КонецПопытки;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеВыполнитьОбмен() Экспорт
	
	ИнтервалОбработчикаОжидания = 2;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ВыполнитьОбмен, Элементы.ЛоадерВыполнитьОбмен);
	
	Если ЗаданиеЕщеВыполняется Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыполнитьОбмен", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		// Проверим результат выполнения фонового задания
		Результат = ПолучитьИзВременногоХранилища(АдресРезультатаВыполнитьОбмен);
		Если Результат <> Неопределено И Не Результат.Успешно Тогда
			ТекстСообщения = "";
			Для Каждого ТекущееСообщение Из Результат.МассивОшибок Цикл
				ТекстСообщения = ТекстСообщения + ТекущееСообщение + Символы.ПС;
			КонецЦикла;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заголовок", "Протокол выполнения обмена");
			ПараметрыФормы.Вставить("Текст", ТекстСообщения);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФормаТекстовогоСообщения", ПараметрыФормы);
		КонецЕсли;
		
		ИдентификаторФЗ_ВыполнитьОбмен = "";
		
		Для Каждого ТекущаяКоманда Из ЭлементыКодмандОбмена() Цикл
			ТекущаяКоманда.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВыполнитьОбмен;
			ТекущаяКоманда.Заголовок = "Выполнить обмен";
			ТекущаяКоманда.ЦветТекста = Новый Цвет(77,77,77);
		КонецЦикла;
		
		ОбновитьСпискиЗадач();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭлементыКодмандОбмена()
	
	КомандыОбмена = Новый Массив;
	КомандыОбмена.Добавить(Элементы.ДиспетчерВыполнитьОбмен);
	КомандыОбмена.Добавить(Элементы.МедосмотрВыполнитьОбмен);
	КомандыОбмена.Добавить(Элементы.ТехКонтрольВыполнитьОбмен);
	КомандыОбмена.Добавить(Элементы.ПоказанияОдометраВыполнитьОбмен);
	
	Возврат КомандыОбмена;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьСоздатьПКДПутевыхЛистов(СвойМедик)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборТипов = Новый Массив;
	НаборТипов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3);
	НаборТипов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	НаборТипов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	
	Если СвойМедик Тогда
		НаборТипов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
		НаборТипов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
	КонецЕсли;
	
	Для Каждого ТекущийТипДокумента Из НаборТипов Цикл
		
		// Проверяем наличие настроек конвертации для путевых листов
		Настройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТекущийТипДокумента);
		
		Если Настройка <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТекущийТипДокумента);
		
		Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьНастройкуПЛДляТитуловКромеТитула1(
			ТекущийТипДокумента, НомерТитула);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьЧерезНастройкиКонвертации(ДанныеЗаполнения, ТипДокументаЛогистика, ПредыдущийТитул)
	
	НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ТипДокументаЛогистика);
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		Возврат;
	КонецЕсли;
	
	НомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипДокументаЛогистика);
	ИмяДокумента = "КонтурЛогистика_ПЛ_Титул" + Строка(НомерТитула);
	
	ДанныеЗаполненияТитула = Новый Структура;
	ДанныеЗаполненияТитула.Вставить("ПредыдущийТитул", ПредыдущийТитул);
	
	ДокументТитулОбъект = Документы[ИмяДокумента].СоздатьДокумент();
	ДокументТитулОбъект.Заполнить(ДанныеЗаполненияТитула);
	
	ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, ДокументТитулОбъект);
	
	ДокументТитулОбъект = Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьДоступСозданиеРедактированиеЭлементов(ТипыПутевыхЛистов)
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	Если ДоступыПользователя.ПолныйДоступ Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДоступКТитулам = ДоступыПользователя.ДоступКТитулам;
	
	СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТипыПутевыхЛистов);
	
	Возврат СозданиеРедактированиеЭлементов;
	
КонецФункции

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоГруппамДоступа()
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	Если ДоступыПользователя.ПолныйДоступ Тогда
		Возврат;
	КонецЕсли;
	
	ДоступКТитулам = ДоступыПользователя.ДоступКТитулам;
	
	ТипыПутевыхЛистов = Новый Массив;
	ТипыПутевыхЛистов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
	ТипыПутевыхЛистов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
	ТипыПутевыхЛистов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3);
	ТипыПутевыхЛистов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	ТипыПутевыхЛистов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	ТипыПутевыхЛистов.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
	
	Для Каждого ТекущийТип Из ТипыПутевыхЛистов Цикл
		
		ТолькоПросмотрЭлементов = ДоступКТитулам.ТолькоПросмотр.Получить(ТекущийТип);
		СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТекущийТип);
		
		ИмяТипа = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТекущийТип);
		
		ИмяМетода = "ОбновитьВидимостьДоступностьПо" + ИмяТипа + "(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)";
		
		Выполнить(ИмяМетода);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоПЛ_Титул1(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)
	
	Элементы.ФормаДиспетчер.Видимость = СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов;
	
	Элементы.ЗадачиДиспетчерПодписатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиДиспетчерСменаВодителя.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиДиспетчерОформитьТитул.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиДиспетчерСоздатьТитул1.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиДиспетчерСоздатьТитул1Копированием.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоПЛ_Титул2(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)
	
	Элементы.ФормаМедосмотр.Видимость = СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов;
	
	Элементы.ЗадачиМедосмотрПодписатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиМедосмотрОтказатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	
	Элементы.ГруппаМедосмотрЗаполнение.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоПЛ_Титул3(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)
	
	Элементы.ФормаТехКонтроль.Видимость = СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов;
	
	Элементы.ЗадачиТехКонтрольПодписатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиТехКонтрольОтказатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	
	Элементы.ГруппаТехКонтрольЗаполнение.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоПЛ_Титул4(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)
	
	Элементы.ФормаПоказанияОдометра.Видимость = СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов;
	
	Элементы.ЗадачиПоказанияОдометраПодписатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	
	Элементы.ГруппаПоказанияОдометраЗаполнение.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоПЛ_Титул5(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)
	
	Если Элементы.ФормаПоказанияОдометра.Видимость Тогда
		Если СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов Тогда
			// Есть доступ на Т4 и Т5
		Иначе
			// Есть доступ на Т4
			Элементы.ФормаПоказанияОдометра.Заголовок = "Показания одометра (Т4)";
			
			ЭлементУдаления = Элементы.ОтборПоказанияОдометра.СписокВыбора.НайтиПоЗначению("Заезд");
			Элементы.ОтборПоказанияОдометра.СписокВыбора.Удалить(ЭлементУдаления);
		КонецЕсли;
	Иначе
		// Есть доступ на Т5
		Элементы.ФормаПоказанияОдометра.Видимость = СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов;
		Элементы.ФормаПоказанияОдометра.Заголовок = "Показания одометра (Т5)";
		
		ЭлементУдаления = Элементы.ОтборПоказанияОдометра.СписокВыбора.НайтиПоЗначению("Выезд");
		Элементы.ОтборПоказанияОдометра.СписокВыбора.Удалить(ЭлементУдаления);
	КонецЕсли;
	
	Элементы.ЗадачиПоказанияОдометраПодписатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	
	Элементы.ГруппаПоказанияОдометраЗаполнение.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьДоступностьПоПЛ_Титул6(ТолькоПросмотрЭлементов, СозданиеРедактированиеЭлементов)
	
	Если Элементы.ФормаМедосмотр.Видимость Тогда
		Если СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов Тогда
			// Есть доступ на Т2 и Т6
		Иначе
			// Есть доступ на Т2
			Элементы.ФормаМедосмотр.Заголовок = "Медосмотр (Т2)";
			
			ЭлементУдаления = Элементы.ОтборМедосмотр.СписокВыбора.НайтиПоЗначению("Послесменный");
			Элементы.ОтборМедосмотр.СписокВыбора.Удалить(ЭлементУдаления);
		КонецЕсли;
	Иначе
		// Есть доступ на Т6
		Элементы.ФормаМедосмотр.Видимость = СозданиеРедактированиеЭлементов Или ТолькоПросмотрЭлементов;
		Элементы.ФормаМедосмотр.Заголовок = "Медосмотр (Т6)";
		
		ЭлементУдаления = Элементы.ОтборМедосмотр.СписокВыбора.НайтиПоЗначению("Предсменный");
		Элементы.ОтборМедосмотр.СписокВыбора.Удалить(ЭлементУдаления);
	КонецЕсли;
	
	Элементы.ЗадачиМедосмотрПодписатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ЗадачиМедосмотрОтказатьТитул.Доступность = СозданиеРедактированиеЭлементов;
	
	Элементы.ГруппаМедосмотрЗаполнение.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьУведомленияИзСервиса()
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("УчитыватьПоследнююДатуПолучения", Ложь);
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		"КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьУведомленияИзСервиса", ПараметрыМетода,, "Получение уведомлений из сервиса");
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		КонтурЛогистика_ОбновлениеКлиент.ПроверитьНаличиеУведомлений(ЭтаФорма);
	Иначе
		ИдентификаторФЗ_ПолучитьУведомления = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПолучитьУведомления", 3, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПолучитьУведомления() Экспорт
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаданиеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ПолучитьУведомления);
	
	Если ЗаданиеВыполняется Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПолучитьУведомления", 3, Истина);
	Иначе
		КонтурЛогистика_ОбновлениеКлиент.ПроверитьНаличиеУведомлений(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеЗапроса()
	
	Если ТекущиВидАРМ = "Диспетчер" Тогда
		
		ТекущийДинамическийСписок = ЗадачиДиспетчер;
		
	ИначеЕсли СвойМедик И ТекущиВидАРМ = "Медосмотр" Тогда
		
		Если ОтборМедосмотр = "" Или ОтборМедосмотр = "Предсменный" Или ОтборМедосмотр = "Послесменный" Тогда
			ТекущийДинамическийСписок = ЗадачиМедосмотр;
		Иначе
			ТекущийДинамическийСписок = СписокМедосмотр;
		КонецЕсли;		
		
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		
		ТекущийДинамическийСписок = ЗадачиТехКонтроль;
		
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		
		Заголовок = Заголовок + " показания одометра";
		
		Если ОтборПоказанияОдометра = "" Тогда
			ОтборПоказанияОдометра = "Выезд";
		КонецЕсли;
		
		Если ОтборПоказанияОдометра = "" Или ОтборМедосмотр = "Выезд" Или ОтборМедосмотр = "Заезд" Тогда
			ТекущийДинамическийСписок = ЗадачиПоказанияОдометра;
		Иначе
			ТекущийДинамическийСписок = СписокПоказанияОдометра;
		КонецЕсли;
				
	КонецЕсли;
	
	СписокПараметров = Новый СписокЗначений;
	Для каждого Параметр Из ТекущийДинамическийСписок.Параметры.Элементы Цикл
		
		Если Не Параметр.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		СписокПараметров.Добавить(Параметр.Значение, Строка(Параметр.Параметр));
		
	КонецЦикла;
	
	Отборы = Новый СписокЗначений;	
	ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, ТекущийДинамическийСписок.Отбор.Элементы);	
	Для каждого ПользовательскаяНастройка Из  ТекущийДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ПользовательскаяНастройка) = Тип("ОтборКомпоновкиДанных") Тогда
			ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, ПользовательскаяНастройка.Элементы);	
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ТекстЗапроса", ТекущийДинамическийСписок.ТекстЗапроса);
	ДанныеЗапроса.Вставить("ПараметрыЗапроса", СписокПараметров);
	ДанныеЗапроса.Вставить("Отборы", Отборы);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Процедура ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, Элементы)
	
	Для каждого Отбор Из Элементы Цикл
		
		Если Не Отбор.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДанныеОтбора = Новый Структура;
			ДанныеОтбора.Вставить("Имя", Строка(Отбор.ТипГруппы));
			ДанныеОтбора.Вставить("ЭтоГруппа", Истина);
			ДанныеОтбора.Вставить("Элементы", Новый СписокЗначений);
						
			Отборы.Добавить(ДанныеОтбора, Строка(Отбор.ТипГруппы));
			
			ДобавитьЭлементыОтбораКомпоновкиДанных(ДанныеОтбора.Элементы, Отбор.Элементы);
		Иначе
			ДанныеОтбора = Новый Структура;
			ДанныеОтбора.Вставить("Имя", Строка(Отбор.ЛевоеЗначение));
			ДанныеОтбора.Вставить("ВидСравнения", Отбор.ВидСравнения);
			ДанныеОтбора.Вставить("Значение", Отбор.ПравоеЗначение);
			ДанныеОтбора.Вставить("ЭтоГруппа", Ложь);
			
			Отборы.Добавить(ДанныеОтбора, Строка(Отбор.ЛевоеЗначение));	
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

#Область ПодключенноеОборудование

&НаКлиенте
Процедура ОткрытьФормуПодключенноеОборудование(ПодключитьОборудованиеПриОткрытии = Истина)

	ПоддерживаемыеТипыПодключаемогоОборудования = "СчитывательМагнитныхКарт";
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("УникальныйИдентификатор",           УникальныйИдентификатор);
	ПараметрыОткрытия.Вставить("ПодключитьОборудованиеПриОткрытии", ПодключитьОборудованиеПриОткрытии);
	ПараметрыОткрытия.Вставить("ПоддерживаемыеТипыПодключаемогоОборудования", ПоддерживаемыеТипыПодключаемогоОборудования);
	
	ОткрытьФорму("Документ.ЧекККМ.Форма.ПодключенноеОборудование", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодключенноеОборудованиеОбработчикОжидания()
	
	ОткрытьФормуПодключенноеОборудование(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеОтключитьОтбор(Команда)
	
	ОборудованиеОтборЗначениеОтбора = Неопределено;
	
	ПолеОтбора_Диспетчер = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_Диспетчер");
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиДиспетчер, ПолеОтбора_Диспетчер,
		ОборудованиеОтборЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	
	ПолеОтбора_Медосмотр = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_Медосмотр");
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиМедосмотр, ПолеОтбора_Медосмотр,
		ОборудованиеОтборЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокМедосмотр, ПолеОтбора_Медосмотр,
		ОборудованиеОтборЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
		
	ПолеОтбора_ТехКонтроль = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_ТехКонтроль");
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиТехКонтроль, ПолеОтбора_ТехКонтроль,
		ОборудованиеОтборЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	
	ПолеОтбора_Одометр = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_Одометр");
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗадачиПоказанияОдометра, ПолеОтбора_Одометр,
		ОборудованиеОтборЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокПоказанияОдометра, ПолеОтбора_Одометр,
		ОборудованиеОтборЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно,, Ложь);
		
	ОборудованиеУстановитьВидимостьВыключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеУстановитьВидимостьВыключения()

	Элементы.ГруппаДиспетчерОборудованиеОтбор.Видимость = ЗначениеЗаполнено(ОборудованиеОтборЗначениеОтбора) 
															И ЗначениеЗаполнено(ПолеОтбора_Диспетчер);
	Элементы.ГруппаМедосмотрОборудованиеОтбор.Видимость = ЗначениеЗаполнено(ОборудованиеОтборЗначениеОтбора) 
															И ЗначениеЗаполнено(ПолеОтбора_Медосмотр);
	Элементы.ГруппаТехКонтрольОборудованиеОтбор.Видимость = ЗначениеЗаполнено(ОборудованиеОтборЗначениеОтбора) 
															И ЗначениеЗаполнено(ПолеОтбора_ТехКонтроль);
	Элементы.ГруппаОдометрОборудованиеОтбор.Видимость = ЗначениеЗаполнено(ОборудованиеОтборЗначениеОтбора)
															И ЗначениеЗаполнено(ПолеОтбора_Одометр);

КонецПроцедуры

&НаСервере
Процедура РассчитатьЗначениеОтбора(Параметр)
	
	КодРасчетаЗначенияОтбора = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЛ_РМ_КодРасчетаЗначенияОтбора");
	
	Если ЗначениеЗаполнено(КодРасчетаЗначенияОтбора) Тогда
		
		Параметры = Новый Структура;
		Параметры.Вставить("Параметр", Параметр);
		
		ОборудованиеОтборЗначениеОтбора = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			КодРасчетаЗначенияОтбора, Параметры);
		
	Иначе
		
		ОборудованиеОтборЗначениеОтбора = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаОповещения_ПЛ_РМ_ИспользоватьОборудование(Параметр)
	
	РассчитатьЗначениеОтбора(Параметр);
	
	Если ЗначениеЗаполнено(ОборудованиеОтборЗначениеОтбора) Тогда
		
		Состояние(ОборудованиеОтборЗначениеОтбора,, "Применен отбор по значению", БиблиотекаКартинок.КонтурЛогистика_Отбор);
		
		// Диспетчер
		ПолеОтбора_Диспетчер = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_Диспетчер");
		ТекущееИспользование = ЗначениеЗаполнено(ПолеОтбора_Диспетчер);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЗадачиДиспетчер, ПолеОтбора_Диспетчер, ОборудованиеОтборЗначениеОтбора,
			ВидСравненияКомпоновкиДанных.Равно,, ТекущееИспользование);
		
		// Медосмотр
		ПолеОтбора_Медосмотр = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_Медосмотр");
		ТекущееИспользование = ЗначениеЗаполнено(ПолеОтбора_Медосмотр);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЗадачиМедосмотр, ПолеОтбора_Медосмотр, ОборудованиеОтборЗначениеОтбора,
			ВидСравненияКомпоновкиДанных.Равно,, ТекущееИспользование);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокМедосмотр, ПолеОтбора_Медосмотр, ОборудованиеОтборЗначениеОтбора,
			ВидСравненияКомпоновкиДанных.Равно,, ТекущееИспользование);
		
		// ТехКонтроль
		ПолеОтбора_ТехКонтроль = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_ТехКонтроль");
		ТекущееИспользование = ЗначениеЗаполнено(ПолеОтбора_ТехКонтроль);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЗадачиТехКонтроль, ПолеОтбора_ТехКонтроль, ОборудованиеОтборЗначениеОтбора,
			ВидСравненияКомпоновкиДанных.Равно,, ТекущееИспользование);
		
		// Одометр
		ПолеОтбора_Одометр = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПЛ_РМ_ПолеОтбора_Одометр");
		ТекущееИспользование = ЗначениеЗаполнено(ПолеОтбора_Одометр);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЗадачиПоказанияОдометра, ПолеОтбора_Одометр, ОборудованиеОтборЗначениеОтбора,
			ВидСравненияКомпоновкиДанных.Равно,, ТекущееИспользование);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокПоказанияОдометра, ПолеОтбора_Одометр, ОборудованиеОтборЗначениеОтбора,
			ВидСравненияКомпоновкиДанных.Равно,, ТекущееИспользование);
		
	Иначе
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не найдено значение для отбора. Не указано соответствие?");
		ОборудованиеОтключитьОтбор(Неопределено);
		
	КонецЕсли;
	
	ОборудованиеУстановитьВидимостьВыключения();
	
КонецПроцедуры

&НаКлиенте
Процедура МедРаботникПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(МедРаботник) Тогда 
		
		МедЛицензия = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(МедРаботник, "МедЛицензия");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАвтообновлениеФормы(Команда)
	
	ПриИзмененииАвтообновленияФормы(Не АвтообновлениеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииАвтообновленияФормы(ПерАвтообновление)
	
	АвтообновлениеФормы = ПерАвтообновление;
	
	Если АвтообновлениеФормы = Ложь Тогда
		ЗаголовокКнопки = "Включить автообновление формы";
		ОтключитьОбработчикОжидания("ОбновитьСпискиЗадач");
	Иначе
		ПериодОбновления = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ПериодОбновленияФорм");	
		
		ЗаголовокКнопки = "Отключить автообновление формы";
		ПодключитьОбработчикОжидания("ОбновитьСпискиЗадач", ПериодОбновления, Ложь);
	КонецЕсли;
	
	Элементы.ЗадачиДиспетчерИзменитьАвтообновлениеФормы.Заголовок = ЗаголовокКнопки;
	Элементы.ЗадачиМедосмотрИзменитьАвтообновлениеФормы.Заголовок = ЗаголовокКнопки;
	Элементы.ЗадачиТехКонтрольИзменитьАвтообновлениеФормы.Заголовок = ЗаголовокКнопки;
	Элементы.ЗадачиПоказанияОдометраИзменитьАвтообновлениеФормы.Заголовок = ЗаголовокКнопки;
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеКолонки

&НаСервере
Функция ДобавитьДополнительныеКолонкиВОбъединенныйЗапрос(ДинСписок, ТипЛогистики1, ТипЛогистики2)
	
	СхемаЗапроса = Новый СхемаЗапроса();
	СхемаЗапроса.УстановитьТекстЗапроса(ДинСписок.ТекстЗапроса);
	
	НастройкаКонвертации1 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистики1);
	НастройкаКонвертации2 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистики2);
	
	ОператорЗапроса1 = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
	ОператорЗапроса2 = СхемаЗапроса.ПакетЗапросов[0].Операторы[1];
	
	Для инд = 1 По 99 Цикл
		
		ДополнительноеПоле =  СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти("Доп" + Строка(инд));
		Если ДополнительноеПоле <> Неопределено Тогда
			Индекс = СхемаЗапроса.ПакетЗапросов[0].Колонки.Индекс(ДополнительноеПоле);
			СхемаЗапроса.ПакетЗапросов[0].Колонки.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
			
	НомерСтроки = 1;
	Для каждого ДопКолонка Из НастройкаКонвертации1.ДополнительныеКолонки Цикл
		
		ИмяКолонки = "Доп" + Строка(НомерСтроки);
		
		ДополнительноеПоле =  СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(ИмяКолонки);
		Если ДополнительноеПоле = Неопределено Тогда
			
			НовоеПоле = ОператорЗапроса1.ВыбираемыеПоля.Добавить(ДопКолонка.ПутьКДанным);
			СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(НовоеПоле).Псевдоним = ИмяКолонки;
											
		Иначе
									
			ИндексДополнительногоПоля =  СхемаЗапроса.ПакетЗапросов[0].Колонки.Индекс(ДополнительноеПоле);			
			СхемаЗапроса.ПакетЗапросов[0].Колонки.Удалить(ИндексДополнительногоПоля);
			
			НовоеПоле = ОператорЗапроса1.ВыбираемыеПоля.Добавить(ДопКолонка.ПутьКДанным);
			ИндексНовогоПоля = ОператорЗапроса1.ВыбираемыеПоля.Индекс(НовоеПоле);			
			СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(НовоеПоле).Псевдоним = ИмяКолонки;
			
		КонецЕсли;
						
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Для каждого ДопКолонка Из НастройкаКонвертации2.ДополнительныеКолонки Цикл
		
		ИмяКолонки = "Доп" + Строка(НомерСтроки);
		
		Если ОператорЗапроса1.ВыбираемыеПоля.Найти(ДопКолонка.ПутьКДанным) = Неопределено Тогда
			ПолеУжеЕсть = Ложь;
		Иначе
			ПолеУжеЕсть = Истина;
		КонецЕсли;
				
		Если ПолеУжеЕсть Тогда
			НовоеПоле = ОператорЗапроса1.ВыбираемыеПоля.Добавить("NULL");
			СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(НовоеПоле).Псевдоним = ИмяКолонки;
		Иначе
			НовоеПоле = ОператорЗапроса2.ВыбираемыеПоля.Добавить(ДопКолонка.ПутьКДанным);
			СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(НовоеПоле).Псевдоним = ИмяКолонки;
		КонецЕсли;
											
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	ДинСписок.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецФункции

&НаСервере
Процедура ОтобразитьОтборДополнительныеКолонки(СписокЗадачИмя, ТипЛогистика)
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика);
	
	УдалитьДополнительныеКолонкиИОтборы(СписокЗадачИмя);
					
	Для каждого ДопКолонка Из НастройкаКонвертации.ДополнительныеКолонки Цикл
		
		ИмяКолонки = "Доп" + Формат(ДопКолонка.НомерСтроки, "ЧГ=0");
		
		Элемент = Элементы.Найти(СписокЗадачИмя + ИмяКолонки);
		Если Элемент = Неопределено Тогда
			Элемент = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(ЭтаФорма, СписокЗадачИмя + "Колонка" + ИмяКолонки, Элементы[СписокЗадачИмя], , ДопКолонка.Заголовок, СписокЗадачИмя + "." + ИмяКолонки);	
		КонецЕсли;		
				
	КонецЦикла;
					
	Для каждого ДопКолонка Из НастройкаКонвертации.ДополнительныеКолонки Цикл
		
		ИмяКолонки = "Доп" + Формат(ДопКолонка.НомерСтроки, "ЧГ=0");
		
		ИмяДопРеквизита = СписокЗадачИмя + "ОтборКолонка" + ИмяКолонки;
		
		Если Элементы.Найти(ИмяДопРеквизита) <> Неопределено Тогда
			Элементы[ИмяДопРеквизита].Видимость = ДопКолонка.Отбор;	
		ИначеЕсли Не ДопКолонка.Отбор Тогда
			Продолжить;
		КонецЕсли;
							
		Типы = Новый Массив;                                                                      
		стрТипы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ДопКолонка.Тип, ";");
		Для каждого стрТип Из стрТипы Цикл
			Типы.Добавить(Тип(стрТип));	
		КонецЦикла;
		ОписаниеТипов = Новый ОписаниеТипов(Типы);
		
		КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизит(ЭтаФорма, ИмяДопРеквизита, ОписаниеТипов);
												
		Если Элементы.Найти(ИмяДопРеквизита) = Неопределено Тогда
		
			СобытияЭФ = Новый Структура;  
			СобытияЭФ.Вставить("ПриИзменении", "УстановитьОтборДинСписка");
			
			СвойстваЭФ = Новый Структура;  
			СвойстваЭФ.Вставить("КнопкаОчистки", Истина);
			СвойстваЭФ.Вставить("РастягиватьПоГоризонтали", Истина);
			
			Если ДопКолонка.НомерСтроки % 3 = 1 Или ДопКолонка.НомерСтроки = 1 Тогда
				Родитель = ИмяГруппыОтбораДополнительныеКолонки(СписокЗадачИмя, 1);
			ИначеЕсли ДопКолонка.НомерСтроки % 3 = 2 Или ДопКолонка.НомерСтроки = 2 Тогда
				Родитель = ИмяГруппыОтбораДополнительныеКолонки(СписокЗадачИмя, 2);
			Иначе
				Родитель = ИмяГруппыОтбораДополнительныеКолонки(СписокЗадачИмя, 3);
			КонецЕсли;
			
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздПоле(ЭтаФорма, ИмяДопРеквизита, Родитель, ДопКолонка.Заголовок, 1, ИмяДопРеквизита, СвойстваЭФ, СобытияЭФ);
						
		Иначе
			
			Элементы[ИмяДопРеквизита].Заголовок = ДопКолонка.Заголовок;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьДополнительныеКолонкиИОтборы(СписокЗадачИмя)
	
	Для каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если Лев(Реквизит.Имя, СтрДлина(СписокЗадачИмя + "Отбор")) = СписокЗадачИмя + "Отбор" Тогда	
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.УдлРеквизитИЭлемент(ЭтаФорма, Реквизит.Имя);				
		КонецЕсли;
	КонецЦикла;	
	
	Для инд = 1 По 99 Цикл
		
		ИмяКолонки = "Доп" + Формат(инд, "ЧГ=0");
		
		Элемент = Элементы.Найти(СписокЗадачИмя + "Колонка" + ИмяКолонки);
		Если Элемент <> Неопределено Тогда
			Элементы.Удалить(Элемент);	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборДинСписка(Элемент)
	
	СтрДляПоиска = СтрЗаменить(Элемент.Имя, "ОтборКолонка", "");
	ПолеОтбора = Прав(СтрДляПоиска, СтрДлина(СтрДляПоиска) - Найти(СтрДляПоиска, "Доп") + 1);
	СписокЗадачИмя = Лев(СтрДляПоиска, Найти(СтрДляПоиска, "Доп") - 1);
	
	Для каждого Отбор Из ЭтаФорма[СписокЗадачИмя].Отбор.Элементы Цикл
			
		Если Строка(Отбор.ЛевоеЗначение) = ПолеОтбора Тогда
			ЭтаФорма[СписокЗадачИмя].Отбор.Элементы.Удалить(Отбор);
			Прервать;
		КонецЕсли;				
			
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ЭтаФорма[Элемент.Имя]) Тогда
				
		ЭлементОтбора = ЭтаФорма[СписокЗадачИмя].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеОтбора);
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма[Элемент.Имя];
		
		Если ТипЗнч(ЭтаФорма[Элемент.Имя]) = Тип("Строка") Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
		Иначе
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИмяГруппыОтбораДополнительныеКолонки(СписокЗадачИмя, Инд)
	
	Если СписокЗадачИмя = "ЗадачиДиспетчер" Тогда
		ИмяГруппы = "ГруппаДиспетчерОтборыДополнительныеКолонки" + Строка(Инд);
	ИначеЕсли СписокЗадачИмя = "ЗадачиМедосмотр" Тогда
		ИмяГруппы = "ГруппаМедосмотрОтборыДополнительныеКолонки" + Строка(Инд);
	ИначеЕсли СписокЗадачИмя = "ЗадачиТехКонтроль" Тогда
		ИмяГруппы = "ГруппаТехКонтрольОтборыДополнительныеКолонки" + Строка(Инд);
	ИначеЕсли СписокЗадачИмя = "ЗадачиПоказанияОдометра" Тогда
		ИмяГруппы = "ГруппаПоказанияОдометраОтборыДополнительныеКолонки" + Строка(Инд);
	КонецЕсли;
	
	Возврат Элементы[ИмяГруппы];
	
КонецФункции

#КонецОбласти

#Область ПоказанияТоплива

&НаКлиенте
Процедура ЗаполнитьПоказанияТоплива(ТекущиеДанные)
	
	Если ТекущиВидАРМ = "Медосмотр" Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказанияТопливаНаВыезде = 0;
		ПоказанияТопливаНаЗаезде = 0;
		ПоказанияТопливаНаЗаправках.Очистить();
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("ПредыдущийТитул") И ЗначениеЗаполнено(ТекущиеДанные.ПредыдущийТитул) Тогда
		ТекущийДокумент = ТекущиеДанные.ПредыдущийТитул;
	ИначеЕсли ТекущиеДанные.Свойство("Титул1") И ЗначениеЗаполнено(ТекущиеДанные.Титул1) Тогда
		ТекущийДокумент = ТекущиеДанные.Титул1;
	ИначеЕсли ТекущиеДанные.Свойство("ДокументЛогистика") И ЗначениеЗаполнено(ТекущиеДанные.ДокументЛогистика) Тогда
		ТекущийДокумент = ТекущиеДанные.ДокументЛогистика;
	Иначе
		ТекущийДокумент = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийДокумент) Тогда
		
		ДанныеПоказанияТоплива = ДанныеПоказанияТопливаПоДокументу(ТекущийДокумент);
		
		ПоказанияТопливаНаВыезде = ДанныеПоказанияТоплива.НаВыезде;
		ПоказанияТопливаНаЗаезде = ДанныеПоказанияТоплива.НаЗаезде;
		ПоказанияТопливаНаЗаправках.ЗагрузитьЗначения(ДанныеПоказанияТоплива.Заправка);
		
	Иначе
		
		ПоказанияТопливаНаВыезде = 0;
		ПоказанияТопливаНаЗаезде = 0;
		ПоказанияТопливаНаЗаправках.Очистить();
		
	КонецЕсли;
	
	Элементы.ПоказанияТопливаНаВыезде.ТолькоПросмотр = Истина;
	Элементы.ПоказанияТопливаНаЗаезде.ТолькоПросмотр = Истина;
	Элементы.ПоказанияТопливаНаЗаправках.ТолькоПросмотр = Истина;
	
	Возврат;
	
	Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		ТекущийСтатусаДО = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтатусДО(ТекущийДокумент);
	Иначе
		Титул1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ТекущийДокумент, "Титул1");
		ТекущийСтатусаДО = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтатусДО(Титул1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийСтатусаДО) Тогда
		ТекущийКодСтатусаДО = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ТекущийСтатусаДО, "Код");
	Иначе
		ТекущийКодСтатусаДО = "";
	КонецЕсли;
	
	ОбновитьВидимостьДоступностьПоказанийТоплива();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьДоступностьПоказанийТоплива()
	
	Если ТекущийКодСтатусаДО = "pl-on-the-way" Тогда
		
		// В пути
		Элементы.ПоказанияТопливаНаВыезде.Доступность = Ложь;
		Элементы.ПоказанияТопливаНаЗаезде.Доступность = Истина;
		Элементы.ПоказанияТопливаНаЗаправках.Доступность = Истина;
		
	ИначеЕсли ТекущийКодСтатусаДО = "pl-completed"
		Или ТекущийКодСтатусаДО = "pl-changeover"
		Или ТекущийКодСтатусаДО = "pl-rejected-cheсkup"
		Или ТекущийКодСтатусаДО = "pl-rejected-techInspection" Тогда
		
		// Завершена
		Элементы.ПоказанияТопливаНаВыезде.Доступность = Ложь;
		Элементы.ПоказанияТопливаНаЗаезде.Доступность = Ложь;
		Элементы.ПоказанияТопливаНаЗаправках.Доступность = Ложь;
		
	Иначе
		
		// Не начата
		Элементы.ПоказанияТопливаНаВыезде.Доступность = Истина;
		Элементы.ПоказанияТопливаНаЗаезде.Доступность = Ложь;
		Элементы.ПоказанияТопливаНаЗаправках.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьПанельТоплива()
	
	Если ТекущиВидАРМ = "Диспетчер" Тогда
		НовыйРодитель = Элементы.ГруппаДиспетчерДокументИЗаполнение;
	ИначеЕсли ТекущиВидАРМ = "Медосмотр" Тогда
		Возврат;
	ИначеЕсли ТекущиВидАРМ = "ТехКонтроль" Тогда
		НовыйРодитель = Элементы.ГруппаТехКонтрольЗаполнение;
	ИначеЕсли ТекущиВидАРМ = "ПоказанияОдометра" Тогда
		НовыйРодитель = Элементы.ГруппаПоказанияОдометраЗаполнение;
	КонецЕсли;
	
	Элементы.Переместить(Элементы.ДекорацияГруппаПоказанияТопливаУдлинитель, НовыйРодитель);
	Элементы.Переместить(Элементы.ГруппаПоказанияТоплива, НовыйРодитель);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеПоказанияТопливаПоДокументу(ДокументЛогистика)
	
	ДанныеПоказанияТоплива = Новый Структура;
	ДанныеПоказанияТоплива.Вставить("НаЗаезде", 0);
	ДанныеПоказанияТоплива.Вставить("НаВыезде", 0);
	ДанныеПоказанияТоплива.Вставить("Заправка", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументЛогистика);
	Запрос.УстановитьПараметр("ТипДанных", РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул1.ЛицоОформившееПЛ КАК ЛицоОформившееПЛ,
	|	КонтурЛогистика_ПЛ_Титул1.kl_id КАК kl_id
	|ПОМЕСТИТЬ ДанныеТитула1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул1.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул2.Титул1.ЛицоОформившееПЛ,
	|	КонтурЛогистика_ПЛ_Титул2.Титул1.kl_id
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул2.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул3.Титул1.ЛицоОформившееПЛ,
	|	КонтурЛогистика_ПЛ_Титул3.Титул1.kl_id
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул3 КАК КонтурЛогистика_ПЛ_Титул3
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул3.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул4.Титул1.ЛицоОформившееПЛ,
	|	КонтурЛогистика_ПЛ_Титул4.Титул1.kl_id
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул4 КАК КонтурЛогистика_ПЛ_Титул4
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул4.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул5.Титул1.ЛицоОформившееПЛ,
	|	КонтурЛогистика_ПЛ_Титул5.Титул1.kl_id
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул5 КАК КонтурЛогистика_ПЛ_Титул5
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул5.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул6.Титул1.ЛицоОформившееПЛ,
	|	КонтурЛогистика_ПЛ_Титул6.Титул1.kl_id
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул6 КАК КонтурЛогистика_ПЛ_Титул6
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул6.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТитула1.ЛицоОформившееПЛ КАК ЛицоОформившееПЛ,
	|	ДанныеТитула1.kl_id КАК kl_id
	|ПОМЕСТИТЬ ДанныеТитула1Сгруппированные
	|ИЗ
	|	ДанныеТитула1 КАК ДанныеТитула1
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеТитула1.ЛицоОформившееПЛ,
	|	ДанныеТитула1.kl_id
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез2 КАК Разрез2,
	|	КонтурЛогистика_ПроизвольныеДанные.Количество КАК Количество
	|ИЗ
	|	ДанныеТитула1Сгруппированные КАК ДанныеТитула1Сгруппированные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|		ПО ДанныеТитула1Сгруппированные.ЛицоОформившееПЛ = КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок
	|			И ДанныеТитула1Сгруппированные.kl_id = КонтурЛогистика_ПроизвольныеДанные.Разрез1
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде Тогда
			ДанныеПоказанияТоплива.НаВыезде = Выборка.Количество;
		ИначеЕсли Выборка.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаЗаезде Тогда
			ДанныеПоказанияТоплива.НаЗаезде = Выборка.Количество;
		ИначеЕсли Выборка.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.Заправка Тогда
			ДанныеПоказанияТоплива.Заправка.Добавить(Выборка.Количество);
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеПоказанияТоплива;
	
КонецФункции

#КонецОбласти

#КонецОбласти