Процедура ОткрытьСписокИсходныхДокументов(Команда)
	
	ТипыДокументов1СМассив = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(ТипЛогистика);
	
	Для Каждого ВозможныйТипДокументаКонфигурации Из ТипыДокументов1СМассив Цикл
		Если Не ЗначениеЗаполнено(ВозможныйТипДокументаКонфигурации) Тогда
			Продолжить;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Документ." + ВозможныйТипДокументаКонфигурации + ".ФормаСписка",,,,,, РежимОткрытияОкнаФормы.Независимый);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьТитул(Команда)
	
	Если Элементы.ЗадачиДиспетчер.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ЗадачиДиспетчер.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументЛогистика) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.ДокументЛогистика);
		Возврат;
	КонецЕсли;
	
	ДокументСсылка = ТекущиеДанные.Документ1С;
	
	Разделители = КонтурЛогистика_ОбработкаДокументовКлиент.РассчитатьРазделительДокументаУчетнойСистемы(ТипЛогистика, ДокументСсылка);
	Если Разделители = Неопределено Или Разделители.Количество() < 2 Тогда	// Можно открыть форму нового
		
		ДанныеЗаполнения = Новый Структура("ДокументОснование, ТипЛогистика", ДокументСсылка, ТипЛогистика);
		
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Документ." + КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика) + ".ФормаОбъекта",
			ПараметрыФормы);
		
	Иначе
		
		ДокументыОснования = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументСсылка);
		КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(ДокументыОснования, Ложь, ТипЛогистика);
		ОбновитьСпискиЗадач();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТитул1(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Документ.КонтурЛогистика_ПЛ_Титул1.Форма.ФормаДокумента",, ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТитул1Копированием(Команда)
	
	Если Элементы.ЗадачиДиспетчер.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ЗадачиДиспетчер.ТекущиеДанные;
	
	ТекстОшибкиСоздания = "Создать копированием можно только титулы введенные вручную";
	Если ЗначениеЗаполнено(ТекущиеДанные.Документ1С) Тогда
		Сообщить(ТекстОшибкиСоздания);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ДокументЛогистика) Тогда
		Сообщить(ТекстОшибкиСоздания);
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ИндексКартинкиСтатусаПодписания = ИндексКартинкиОтказ() Тогда
		// Открываем текущий
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.ДокументЛогистика, ЭтаФорма);
	Иначе
		// Формируем новый
		ПараметрыФомры = Новый Структура;
		ПараметрыФомры.Вставить("ЗначениеКопирования", ТекущиеДанные.ДокументЛогистика);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Документ.КонтурЛогистика_ПЛ_Титул1.Форма.ФормаДокумента", ПараметрыФомры,
			ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

