  <attributes>
    <name>СписокПоказанияОдометра</name>
    <title>
      <key>ru</key>
      <value>Список показания одометра</value>
    </title>
    <id>25</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ВидПоказанияОдометра</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ДатВрОдометр</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ДатВрОдометр2</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ИндексКартинкиСтатусаПодписания</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ОдометрРаботник</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ПоказанияОдометра</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.Статус</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.ТестовыйДокумент</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоказанияОдометра.Титул1</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
    &quot;Выезд&quot; КАК ВидПоказанияОдометра,
    КонтурЛогистика_ПЛ_Титул4.Ссылка КАК Ссылка,
    КонтурЛогистика_ПЛ_Титул4.Номер КАК Номер,
    КонтурЛогистика_ПЛ_Титул4.Дата КАК Дата,
    КонтурЛогистика_ПЛ_Титул4.УИД_ПЛ КАК УИД_ПЛ,
    КонтурЛогистика_ПЛ_Титул4.ДокументОснование КАК ДокументОснование,
    КонтурЛогистика_ПЛ_Титул4.Титул1 КАК Титул1,
    КонтурЛогистика_ПЛ_Титул4.Титул1.ТестовыйДокумент КАК ТестовыйДокумент,
    КонтурЛогистика_ПЛ_Титул4.Титул3 КАК Титул3,
    NULL КАК Титул4,
    КонтурЛогистика_ПЛ_Титул4.ЭтоСменаВодителя КАК ЭтоСменаВодителя,
    КонтурЛогистика_ПЛ_Титул4.Комментарий КАК Комментарий,
    КонтурЛогистика_ПЛ_Титул4.ДатИнфВыезд КАК ДатИнф,
    КонтурЛогистика_ПЛ_Титул4.ВрИнфВыезд КАК ВрИнф,
    КонтурЛогистика_ПЛ_Титул4.ДатВрОдометр КАК ДатВрОдометр,
    КонтурЛогистика_ПЛ_Титул4.ДатВрОдометр КАК ДатВрОдометр2,
    КонтурЛогистика_ПЛ_Титул4.ПоказанияОдометра КАК ПоказанияОдометра,
    КонтурЛогистика_ПЛ_Титул4.ОдометрРаботник КАК ОдометрРаботник,
    КонтурЛогистика_ПЛ_Титул4.Должность КАК Должность,
    КонтурЛогистика_ПЛ_Титул4.ТипПодпис КАК ТипПодпис,
    КонтурЛогистика_ПЛ_Титул4.СпосПодтПолном КАК СпосПодтПолном,
    КонтурЛогистика_ПЛ_Титул4.Фамилия КАК Фамилия,
    КонтурЛогистика_ПЛ_Титул4.Имя КАК Имя,
    КонтурЛогистика_ПЛ_Титул4.Отчество КАК Отчество,
    КонтурЛогистика_ПЛ_Титул4.ПользовательПодписант КАК ПользовательПодписант,
    КонтурЛогистика_ПЛ_Титул4.ПараметрНастроекПодписания КАК ПараметрНастроекПодписания,
    КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус,
    ВЫБОР
        КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &amp;СтатусДокументооборотаВПути
            ТОГДА 5
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус ЕСТЬ NULL
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
            ТОГДА 0
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
            ТОГДА 1
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
                ТОГДА 2
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
            ТОГДА 4
        ИНАЧЕ 3
    КОНЕЦ КАК ИндексКартинкиСтатусаПодписания
ИЗ
    Документ.КонтурЛогистика_ПЛ_Титул4 КАК КонтурЛогистика_ПЛ_Титул4
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
        ПО (КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ = КонтурЛогистика_ПЛ_Титул4.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
        ПО КонтурЛогистика_ПЛ_Титул4.Титул1 = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    &quot;Заезд&quot;,
    КонтурЛогистика_ПЛ_Титул5.Ссылка,
    КонтурЛогистика_ПЛ_Титул5.Номер,
    КонтурЛогистика_ПЛ_Титул5.Дата,
    КонтурЛогистика_ПЛ_Титул5.УИД_ПЛ,
    КонтурЛогистика_ПЛ_Титул5.ДокументОснование,
    КонтурЛогистика_ПЛ_Титул5.Титул1,
    КонтурЛогистика_ПЛ_Титул5.Титул1.ТестовыйДокумент,
    NULL,
    КонтурЛогистика_ПЛ_Титул5.Титул4,
    КонтурЛогистика_ПЛ_Титул5.ЭтоСменаВодителя,
    КонтурЛогистика_ПЛ_Титул5.Комментарий,
    КонтурЛогистика_ПЛ_Титул5.ДатИнфЗаезд,
    КонтурЛогистика_ПЛ_Титул5.ВрИнфЗаезд,
    КонтурЛогистика_ПЛ_Титул5.ДатВрОдометр,
    КонтурЛогистика_ПЛ_Титул5.ДатВрОдометр,
    КонтурЛогистика_ПЛ_Титул5.ПоказанияОдометра,
    КонтурЛогистика_ПЛ_Титул5.ОдометрРаботник,
    КонтурЛогистика_ПЛ_Титул5.Должность,
    КонтурЛогистика_ПЛ_Титул5.ТипПодпис,
    КонтурЛогистика_ПЛ_Титул5.СпосПодтПолном,
    КонтурЛогистика_ПЛ_Титул5.Фамилия,
    КонтурЛогистика_ПЛ_Титул5.Имя,
    КонтурЛогистика_ПЛ_Титул5.Отчество,
    КонтурЛогистика_ПЛ_Титул5.ПользовательПодписант,
    КонтурЛогистика_ПЛ_Титул5.ПараметрНастроекПодписания,
    КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус,
    ВЫБОР
        КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &amp;СтатусДокументооборотаВПути
            ТОГДА 5
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус ЕСТЬ NULL
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
            ТОГДА 0
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
            ТОГДА 1
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
                ТОГДА 2
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
            ТОГДА 4
        ИНАЧЕ 3
    КОНЕЦ
ИЗ
    Документ.КонтурЛогистика_ПЛ_Титул5 КАК КонтурЛогистика_ПЛ_Титул5
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
        ПО (КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ = КонтурЛогистика_ПЛ_Титул5.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
        ПО КонтурЛогистика_ПЛ_Титул5.Титул1 = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
