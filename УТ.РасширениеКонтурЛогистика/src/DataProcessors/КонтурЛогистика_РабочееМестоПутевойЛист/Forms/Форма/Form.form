  <attributes>
    <name>СписокМедосмотр</name>
    <title>
      <key>ru</key>
      <value>Список медосмотр</value>
    </title>
    <id>17</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ДокументОснование</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ВидМОПослесменный</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ВидМедосмотра</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ДатВрПрМО</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ДатВрПрМО2</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ИндексКартинкиСтатусаПодписания</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.Статус</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокМедосмотр.ТестовыйДокумент</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
    КонтурЛогистика_ПЛ_Титул2.Ссылка КАК Ссылка,
    КонтурЛогистика_ПЛ_Титул2.Номер КАК Номер,
    КонтурЛогистика_ПЛ_Титул2.Дата КАК Дата,
    КонтурЛогистика_ПЛ_Титул2.УИД_ПЛ КАК УИД_ПЛ,
    КонтурЛогистика_ПЛ_Титул2.Титул1 КАК Титул1,
    КонтурЛогистика_ПЛ_Титул2.Титул1.ТестовыйДокумент КАК ТестовыйДокумент,
    КонтурЛогистика_ПЛ_Титул2.Комментарий КАК Комментарий,
    КонтурЛогистика_ПЛ_Титул2.ДатИнфМО КАК ДатИнфМО,
    КонтурЛогистика_ПЛ_Титул2.ВрИнфМО КАК ВрИнфМО,
    КонтурЛогистика_ПЛ_Титул2.ЭПСоб КАК ЭП,
    КонтурЛогистика_ПЛ_Титул2.Должность КАК Должность,
    КонтурЛогистика_ПЛ_Титул2.ТипПодпис КАК ТипПодпис,
    КонтурЛогистика_ПЛ_Титул2.СпосПодтПолном КАК СпосПодтПолном,
    КонтурЛогистика_ПЛ_Титул2.Фамилия КАК Фамилия,
    КонтурЛогистика_ПЛ_Титул2.Имя КАК Имя,
    КонтурЛогистика_ПЛ_Титул2.Отчество КАК Отчество,
    КонтурЛогистика_ПЛ_Титул2.ПользовательПодписант КАК ПользовательПодписант,
    КонтурЛогистика_ПЛ_Титул2.ПричинаОтказаВПодписи КАК ПричинаОтказаВПодписи,
    КонтурЛогистика_ПЛ_Титул2.ЕстьОтказВПодписи КАК ЕстьОтказВПодписи,
    КонтурЛогистика_ПЛ_Титул2.МедРаботник КАК МедРаботник,
    КонтурЛогистика_ПЛ_Титул2.ДатВрПрМО КАК ДатВрПрМО,
    КонтурЛогистика_ПЛ_Титул2.ДатВрПрМО КАК ДатВрПрМО2,
    КонтурЛогистика_ПЛ_Титул2.Водитель КАК Водитель,
    КонтурЛогистика_ПЛ_Титул2.МедЛицензия КАК МедЛицензия,
    ЛОЖЬ КАК ВидМОПослесменный,
    &quot;Предсменный&quot; КАК ВидМедосмотра,
    ВЫБОР
        КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &amp;СтатусДокументооборотаВПути
            ТОГДА 5
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус ЕСТЬ NULL
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
            ТОГДА 0
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
            ТОГДА 1
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
                ТОГДА 2
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
            ТОГДА 4
        ИНАЧЕ 3
    КОНЕЦ КАК ИндексКартинкиСтатусаПодписания,
    КонтурЛогистика_ПЛ_Титул2.Титул1.НомерПЛ КАК Титул1НомерПЛ,
    КонтурЛогистика_ПЛ_Титул2.Титул1.ДатаПЛ КАК Титул1ДатаПЛ,
    КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус
ИЗ
    Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
        ПО КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ = КонтурЛогистика_ПЛ_Титул2.Ссылка
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
        ПО КонтурЛогистика_ПЛ_Титул2.Титул1 = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    КонтурЛогистика_ПЛ_Титул6.Ссылка,
    КонтурЛогистика_ПЛ_Титул6.Номер,
    КонтурЛогистика_ПЛ_Титул6.Дата,
    КонтурЛогистика_ПЛ_Титул6.УИД_ПЛ,
    КонтурЛогистика_ПЛ_Титул6.Титул1,
    КонтурЛогистика_ПЛ_Титул6.Титул1.ТестовыйДокумент,
    КонтурЛогистика_ПЛ_Титул6.Комментарий,
    КонтурЛогистика_ПЛ_Титул6.ДатИнфМО,
    КонтурЛогистика_ПЛ_Титул6.ВрИнфМО,
    КонтурЛогистика_ПЛ_Титул6.ЭПЗаезд,
    КонтурЛогистика_ПЛ_Титул6.Должность,
    КонтурЛогистика_ПЛ_Титул6.ТипПодпис,
    КонтурЛогистика_ПЛ_Титул6.СпосПодтПолном,
    КонтурЛогистика_ПЛ_Титул6.Фамилия,
    КонтурЛогистика_ПЛ_Титул6.Имя,
    КонтурЛогистика_ПЛ_Титул6.Отчество,
    КонтурЛогистика_ПЛ_Титул6.ПользовательПодписант,
    КонтурЛогистика_ПЛ_Титул6.ПричинаОтказаВПодписи,
    КонтурЛогистика_ПЛ_Титул6.ЕстьОтказВПодписи,
    КонтурЛогистика_ПЛ_Титул6.МедРаботник,
    КонтурЛогистика_ПЛ_Титул6.ДатВрПрМО,
    КонтурЛогистика_ПЛ_Титул6.ДатВрПрМО,
    КонтурЛогистика_ПЛ_Титул6.Водитель,
    КонтурЛогистика_ПЛ_Титул6.МедЛицензия,
    ИСТИНА,
    &quot;Послесменный&quot;,
    ВЫБОР
        КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &amp;СтатусДокументооборотаВПути
            ТОГДА 5
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус ЕСТЬ NULL
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
            ТОГДА 0
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
            ТОГДА 1
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
            ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
                ТОГДА 2
        КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
            ТОГДА 4
        ИНАЧЕ 3
    КОНЕЦ,
    КонтурЛогистика_ПЛ_Титул6.Титул1.НомерПЛ,
    КонтурЛогистика_ПЛ_Титул6.Титул1.ДатаПЛ,
    КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус
ИЗ
    Документ.КонтурЛогистика_ПЛ_Титул6 КАК КонтурЛогистика_ПЛ_Титул6
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
        ПО КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ = КонтурЛогистика_ПЛ_Титул6.Ссылка
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
        ПО КонтурЛогистика_ПЛ_Титул6.Титул1 = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
