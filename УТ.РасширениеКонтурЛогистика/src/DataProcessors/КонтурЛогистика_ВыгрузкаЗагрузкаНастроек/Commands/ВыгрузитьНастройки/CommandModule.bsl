
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОчиститьСообщения();
	
	АдресФайлаВоВременномХранилище = "";	
	
	ВыгрузитьНастройки(АдресФайлаВоВременномХранилище, ПараметрКоманды);
	
	Если Не ПустаяСтрока(АдресФайлаВоВременномХранилище) Тогда
		
		ИмяФайла = "Файл выгрузки.xml";
		ПолучитьФайл(АдресФайлаВоВременномХранилище, ИмяФайла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьНастройки(АдресФайлаВоВременномХранилище, МассивСсылок);

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xml");
	
	ИмяОбъектаМетаданных = МассивСсылок[0].Метаданные().Имя;
	
	ОбъектыДляВыгрузки = Новый ТаблицаЗначений;
	ОбъектыДляВыгрузки.Колонки.Добавить("Выгружать");
	ОбъектыДляВыгрузки.Колонки.Добавить("ИмяОбъектаМетаданныхВладелец");
	ОбъектыДляВыгрузки.Колонки.Добавить("Ссылка");
	
	Для Каждого Ссылка Из МассивСсылок Цикл 
		
		НовыйОбъектВыгрузки = ОбъектыДляВыгрузки.Добавить();
		
		НовыйОбъектВыгрузки.Выгружать 						= Истина;
		НовыйОбъектВыгрузки.ИмяОбъектаМетаданныхВладелец 	= ИмяОбъектаМетаданных;
		НовыйОбъектВыгрузки.Ссылка 							= Ссылка;
		
	КонецЦикла;	
	
	НастройкиВыгрузки = Новый Массив;
	НастройкиВыгрузки.Добавить(ИмяОбъектаМетаданных);

	ОбработкаОбъект = Обработки.КонтурЛогистика_ВыгрузкаЗагрузкаНастроек.Создать();
	ОбработкаОбъект.ВыполнитьВыгрузку(ИмяВременногоФайла, НастройкиВыгрузки, ОбъектыДляВыгрузки);
	
	Файл = Новый Файл(ИмяВременногоФайла);
	
	Если Файл.Существует() Тогда
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);                       
		АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
		УдалитьФайлы(ИмяВременногоФайла);
		
	КонецЕсли;
	
КонецПроцедуры

