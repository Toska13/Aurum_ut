&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды.Количество() = 0 Тогда
		Сообщить("Не выбраны объекты для сохранения файлов обмена на жесткий диск");
		Возврат;
	КонецЕсли;

	#Если ВебКлиент Тогда
			
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОбъектСсылка", ПараметрКоманды);
		
		Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", ЭтотОбъект, ДополнительныеПараметры);	
		НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
									
	#Иначе
			
		КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
			"ВыборКаталогаВыгрузкиЗаверешение", ЭтотОбъект, РежимДиалогаВыбораФайла.ВыборКаталога,
			"Укажите каталог для сохранения файлов обмена",,,,, ПараметрКоманды);
		
	#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталогаВыгрузкиЗаверешение(Результат, ОбъектыВыгрузки) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Каталог = Результат;
	Иначе
		Каталог = Результат[0];
	КонецЕсли;
	
	Адрес = "";
	Адрес = СформироватьДанныеФайлов(ОбъектыВыгрузки);
	
	СохранитьФайлыОбмена(Каталог, Адрес);
	
	ЗапуститьПриложение(Каталог);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлыОбмена(Каталог, Адрес)
	
	МассивДанныхФайловОбмена = ПолучитьИзВременногоХранилища(Адрес);
	
	Для каждого ДанныеФайла Из МассивДанныхФайловОбмена Цикл
		
		Если ЗначениеЗаполнено(ДанныеФайла.ИмяКаталога) Тогда
			КаталогСохранения = СокрЛП(Каталог + "\" + ДанныеФайла.ИмяКаталога);
		Иначе
			КаталогСохранения = СокрЛП(Каталог);
		КонецЕсли;
		
		СоздатьКаталогСохранения(КаталогСохранения);
		
		Если ЗначениеЗаполнено(ДанныеФайла.XMLФайл) Тогда
			ДанныеФайла.XMLФайл.Записать(КаталогСохранения + "\" + ДанныеФайла.ИмяФайла + ".xml");
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеФайла.Подпись) Тогда
			ДанныеФайла.Подпись.Записать(КаталогСохранения + "\" + ДанныеФайла.ИмяФайла + ".xml.sig");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКаталогСохранения(ИмяКаталога)
	
	КаталогНаДиске = Новый Файл(ИмяКаталога);
    Если Не КаталогНаДиске.Существует() Тогда
       	СоздатьКаталог(ИмяКаталога);
	КонецЕсли;
	
Конецпроцедуры

&НаСервере
Функция СформироватьДанныеФайлов(ОбъектыВыгрузки)
	
	ДанныеФайловОбмена = Новый Массив;
			
	Для каждого ОбъектВыгрузки Из ОбъектыВыгрузки Цикл
	
		Если ТипЗнч(ОбъектВыгрузки) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
			ФайлОбмена = ОбъектВыгрузки;
		
			ДанныеФайла = СформироватьДанныеФайла(ФайлОбмена);			
			ДанныеФайловОбмена.Добавить(ДанныеФайла);
						
		ИначеЕсли ТипЗнч(ОбъектВыгрузки) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
			
			ДокументЭТРН = ОбъектВыгрузки;
			
			ТаблицаТитулов = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьТаблицуТитуловПеревозкиТРН(ДокументЭТРН);
			
			Для каждого Документ Из ТаблицаТитулов Цикл
				Если ЗначениеЗаполнено(Документ.Титул) Тогда
					
					КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Документ.Титул);
			
					Если ЗначениеЗаполнено(КрайнийФайл) Тогда
						ДанныеФайла = СформироватьДанныеФайла(КрайнийФайл);
						ДанныеФайловОбмена.Добавить(ДанныеФайла);
					КонецЕсли;
					
				КонецЕсли;				
			КонецЦикла;
			
		Иначе // титулы ТрН, ПЛ, ЗЗ
			
			Документ = ОбъектВыгрузки;
			
			КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Документ);
			
			Если ЗначениеЗаполнено(КрайнийФайл) Тогда
				ДанныеФайла = СформироватьДанныеФайла(КрайнийФайл);
				ДанныеФайловОбмена.Добавить(ДанныеФайла);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Адрес = ПоместитьВоВременноеХранилище(ДанныеФайловОбмена, Новый УникальныйИдентификатор);
	
	Возврат Адрес;
	
КонецФункции

&НаСервере
Функция СформироватьДанныеФайла(ФайлОбмена)
	
	ДвоичныеДанныеКонтентаФайла = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлОбмена);
	
	ИмяФайла = "" + Формат(ФайлОбмена.Код, "ЧГ=0") + " " + ФайлОбмена.ТипДокумента 
		+ ?(ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент), " по " + Строка(ФайлОбмена.ГлавныйДокумент), "");
	
	ДанныеФайла = Новый Структура;
	ДанныеФайла.Вставить("ИмяФайла",  КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УбратьНедопустимыеСимволыФС(ИмяФайла));
	ДанныеФайла.Вставить("XMLФайл", ДвоичныеДанныеКонтентаФайла);
	ДанныеФайла.Вставить("Подпись", ФайлОбмена.Подпись.Получить());
	ДанныеФайла.Вставить("ИмяКаталога", ИмяКаталога(ФайлОбмена));
		
	Возврат ДанныеФайла;
	
Конецфункции

&НаСервере
Функция ИмяКаталога(ФайлОбмена)
	
	Если Не ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяКаталога = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УбратьНедопустимыеСимволыФС(Строка(ФайлОбмена.ГлавныйДокумент));
		
	Если ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент) 
		И ТипЗнч(ФайлОбмена.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
		И ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент.УИД) Тогда
		
		ИмяКаталога = ИмяКаталога + " " + Лев(ФайлОбмена.ГлавныйДокумент.УИД, 7) + " ";
		
	ИначеЕсли ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент) 
		И ТипЗнч(ФайлОбмена.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		И ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент.УИД_ПЛ) Тогда
		
		ИмяКаталога = ИмяКаталога + " " + Лев(ФайлОбмена.ГлавныйДокумент.УИД_ПЛ, 7) + " ";
		
	ИначеЕсли ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент) 
		И ТипЗнч(ФайлОбмена.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
		И ЗначениеЗаполнено(ФайлОбмена.ГлавныйДокумент.УИД_Зак) Тогда
		
		ИмяКаталога = ИмяКаталога + " " + Лев(ФайлОбмена.ГлавныйДокумент.УИД_Зак, 7) + " ";
		
	КонецЕсли;
	
	Возврат ИмяКаталога;
	
КонецФункции

#Область ВебКлиент

&НаКлиенте
Процедура РасширениеРаботыСФайламиПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСФайлами(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ВыборКаталогаВыгрузкиЗаверешениеАсинх", ЭтотОбъект, РежимДиалогаВыбораФайла.ВыборКаталога,
		"Укажите каталог для сохранения файлов обмена",,,,, ДополнительныеПараметры.ОбъектСсылка);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталогаВыгрузкиЗаверешениеАсинх(Результат, ОбъектыВыгрузки) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		ИмяКаталога = Результат;
	Иначе
		ИмяКаталога = Результат[0];
	КонецЕсли;
	
	Адрес = "";
	Адрес = СформироватьДанныеФайлов(ОбъектыВыгрузки);
	
	СохранитьФайлыОбменаАсинх(ИмяКаталога, Адрес);
			
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлыОбменаАсинх(ИмяКаталога, Адрес)
	
	МассивДанныхФайловОбмена = ПолучитьИзВременногоХранилища(Адрес);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Инд", 0);
	ДополнительныеПараметры.Вставить("Колво", МассивДанныхФайловОбмена.Количество());
	ДополнительныеПараметры.Вставить("МассивДанныхФайловОбмена", МассивДанныхФайловОбмена);
	ДополнительныеПараметры.Вставить("КорневойКаталог", ИмяКаталога);
	
	СохранитьФайлОбменаАсинх(ДополнительныеПараметры);
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлОбменаАсинх(ДополнительныеПараметры)
	
	ДанныеФайла = ДополнительныеПараметры.МассивДанныхФайловОбмена[ДополнительныеПараметры.Инд];
	
	Если ЗначениеЗаполнено(ДанныеФайла.ИмяКаталога) Тогда
		КаталогСохранения = СокрЛП(ДополнительныеПараметры.КорневойКаталог + "\" + ДанныеФайла.ИмяКаталога);
	Иначе
		КаталогСохранения = СокрЛП(ДополнительныеПараметры.КорневойКаталог);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДанныеФайла", ДанныеФайла);
		
	Оповещение = Новый ОписаниеОповещения("НачатьСозданиеКаталогаЗавершение", ЭтотОбъект, ДополнительныеПараметры);	
	НачатьСозданиеКаталога(Оповещение, КаталогСохранения);		
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСозданиеКаталогаЗавершение(КаталогСохранения, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("КаталогСохранения", КаталогСохранения);
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ДанныеФайла.XMLФайл) Тогда
		Оповещение = Новый ОписаниеОповещения("НачатьЗаписьXMLФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ДополнительныеПараметры.ДанныеФайла.XMLФайл.НачатьЗапись(Оповещение, КаталогСохранения + "\" + ДополнительныеПараметры.ДанныеФайла.ИмяФайла + ".xml");
	КонецЕсли;			
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаписьXMLФайлаЗавершение(ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ДанныеФайла.Подпись) Тогда
		Оповещение = Новый ОписаниеОповещения("НачатьЗаписьПодписиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ДополнительныеПараметры.ДанныеФайла.Подпись.НачатьЗапись(Оповещение, ДополнительныеПараметры.КаталогСохранения + "\" + ДополнительныеПараметры.ДанныеФайла.ИмяФайла + ".xml.sig");
	Иначе
		
		Если ДополнительныеПараметры.МассивДанныхФайловОбмена.Количество() - 1 = ДополнительныеПараметры.Инд Тогда
			Оповещение = Новый ОписаниеОповещения("НачатьЗапускПриложенияЗавершение", ЭтотОбъект);
			НачатьЗапускПриложения(Оповещение, ДополнительныеПараметры.КорневойКаталог);
		Иначе
			ДополнительныеПараметры.Вставить("Инд", ДополнительныеПараметры.Инд + 1);
			СохранитьФайлОбменаАсинх(ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаписьПодписиЗавершение(ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.МассивДанныхФайловОбмена.Количество() - 1 = ДополнительныеПараметры.Инд Тогда
		Оповещение = Новый ОписаниеОповещения("НачатьЗапускПриложенияЗавершение", ЭтотОбъект);
		НачатьЗапускПриложения(Оповещение, ДополнительныеПараметры.КорневойКаталог);	
	Иначе
		ДополнительныеПараметры.Вставить("Инд", ДополнительныеПараметры.Инд + 1);
		СохранитьФайлОбменаАсинх(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗапускПриложенияЗавершение(КодВозврата, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

#КонецОбласти