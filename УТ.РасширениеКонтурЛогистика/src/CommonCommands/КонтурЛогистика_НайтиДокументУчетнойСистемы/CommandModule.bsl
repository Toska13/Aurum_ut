
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	УточнениеТипаЛогистика = "";
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
		Если Форма.Элементы.Найти("ТипЛогистика") <> Неопределено Тогда
			УточнениеТипаЛогистика = Форма.ТипЛогистика;
		КонецЕсли;
	Иначе
		Форма = Неопределено;
	КонецЕсли;
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", ПараметрКоманды, УточнениеТипаЛогистика);

	Состояние("Обработка", 50, "Ищем документы учетной системы", БиблиотекаКартинок.КонтурЛогистика_Лого16);
	НайтиДокументыУчетнойСистемыИПривязатьКТитулам(ПараметрыВводаДокументов);
	
	Состояние("Обработка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
	Оповестить("КонтурЛогистика_ОбновитьЗадачи", ПараметрКоманды);
	
	Если ПараметрыВводаДокументов.МассивДокументов.Количество() = 1 Тогда
		Оповестить("КонтурЛогистика_ИзменениеДокумента", ПараметрыВводаДокументов.МассивДокументов[0]);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиДокументыУчетнойСистемыИПривязатьКТитулам(ПараметрыВводаДокументов)
	
	КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументыУчетнойСистемыИПривязатьКТитулам(ПараметрыВводаДокументов);	
	
КонецПроцедуры