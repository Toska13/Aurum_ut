
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ДокументЭТрН = ПараметрКоманды;
	Если Не ЭтоНашПеревозчик(ДокументЭТрН) Тогда
		
		ВызватьИсключение "В документе ЭТРН у организации-перевозчика не стоит один из флагов ""Наш"" или ""Перевозчик""";
		
	КонецЕсли;
	
	Форма = ПараметрыВыполненияКоманды.Источник;
	
	ДокументЛогистика = Неопределено;
	
	Если форма.ИмяФормы = "ОбщаяФорма.КонтурЛогистика_Задачи" Тогда 
		
		ТекДанные = Форма.Элементы.ЗадачиДинамическийСписок.ТекущиеДанные;
		
		Если Не ТекДанные = Неопределено Тогда 
			
			ДокументЛогистика = ТекДанные.ДокументЛогистика;
			
		КонецЕсли;	
		
	ИначеЕсли Форма.ИмяФормы = "Документ.КонтурЛогистика_ТрН_Титул2.Форма.ФормаДокумента" Тогда 
		
		ДокументЛогистика = Форма.Объект.Ссылка;
		
	Иначе
		
		НайденныйТ4 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4"), ДокументЭТрН);
		Если ЗначениеЗаполнено(НайденныйТ4) Тогда 
			ДокументЛогистика = НайденныйТ4;
		Иначе
			НайденныйТ2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2"), ДокументЭТрН);
			Если ЗначениеЗаполнено(НайденныйТ2) Тогда 
				ДокументЛогистика = НайденныйТ2;
			Иначе
				ВызватьИсключение "Сначала надо ввести/получить титул 2 (начать перевозку) ";
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументЛогистика) Тогда 
		
		Если ПеревозчикНаш(ДокументЛогистика) Тогда 
			
			Если МожноСоздаватьТитул(ДокументЛогистика) Тогда 
				
				ДанныеЗаполнения = Новый Структура("ПредыдущийТитул, ТипЛогистика", ДокументЛогистика, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8"));
				
			Иначе
				
				ВызватьИсключение "Создавать Титул 8(перевозчик, смена водителя|ТС) можно только из состояния документооборота ""В пути"" и ""Завершен""(если была неполняая приемка)" ;
			
			КонецЕсли;	
			
		Иначе	
			
			ВызватьИсключение "Может ввести только ""Наш"" перевозчик";
			
		КонецЕсли;
	
	Иначе
		
		ВызватьИсключение "Можно ввести новый только если введен титул в текущем списке.";
		
	КонецЕсли;
				
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ТрН_Титул8.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения));
	
КонецПроцедуры

&НаСервере
Функция ПеревозчикНаш(ТитулСсылка)
	
	Возврат ТитулСсылка.ДокументЭТРН.Перевозчик.Наш;
	
КонецФункции


&НаСервере
Функция МожноСоздаватьТитул(ТитулСсылка)
	
	Статус = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ТитулСсылка.ДокументЭТРН, Истина);
	Если Статус = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("on-the-way")
		Или Статус = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pd-on-the-way")
		Или Статус = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("completed") Тогда
		Возврат Истина;
	Иначе
		Возврат ложь;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ЭтоНашПеревозчик(ДокументЭТрН)
	
	Возврат ДокументЭТрН.Перевозчик.Перевозчик И ДокументЭТрН.Перевозчик.Наш;
	
КонецФункции	
