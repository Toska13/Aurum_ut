
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ЗапроситьНовоеСостяние(ПараметрКоманды);

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьНовоеСостяние(ПараметрКоманды)

	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Документ = ПараметрКоманды[0];
	Иначе
		Документ = ПараметрКоманды;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
	Тогда
		КодРодителя = "trn";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5")
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6")
	Тогда
		КодРодителя = "pl";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") 
		Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2")	
	Тогда
		КодРодителя = "zz";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодРодителя) Тогда
		
		НастройкиКД = Новый НастройкиКомпоновкиДанных;
		
		Группа = НастройкиКД.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
        Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
		
		ОтборСписка = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Родитель");
	    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ОтборСписка.ПравоеЗначение = НайтиРодителяПоКоду(КодРодителя);
	    ОтборСписка.Использование = Истина;
		
		ОтборСписка = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Родитель");
	    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ОтборСписка.ПравоеЗначение = ПредопределенноеЗначение("Справочник.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка");
	    ОтборСписка.Использование = Истина;
	    	
		ПараметрыВыбора = Новый Структура;
		ПараметрыВыбора.Вставить("ФиксированныеНастройки", НастройкиКД);
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_СостоянияДвиженияДокументооборота.ФормаВыбора",
																   ПараметрыВыбора,
																   ,
																   ЭтотОбъект,
																   "ОбработчикВводаНовогоСостояния",
																   ПараметрКоманды);	 

КонецПроцедуры

&НаСервере
Функция НайтиРодителяПоКоду(Код)
	Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду(Код);
КонецФункции

&НаКлиенте
Процедура ОбработчикВводаНовогоСостояния(НовоеСостояние, МассивДокументов) Экспорт
	
	Если НовоеСостояние <> Неопределено И МассивДокументов.Количество() > 0 Тогда
		
		УстановитьНовоеСостояниеСервер(НовоеСостояние, МассивДокументов);
		
		Если ТипЗнч(МассивДокументов) = Тип("Массив")
			И МассивДокументов.Количество() > 0 Тогда
			
			Для Каждого ДокументСсылка Из МассивДокументов Цикл
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОповеститьОбИзмененииДокумента(ДокументСсылка)			
			КонецЦикла;
			Оповестить("КонтурЛогистика_ОбновитьЗадачи");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНовоеСостояниеСервер(НовоеСостояние, МассивДокументов)
	
	Попытка
		
		Для Каждого Документ Из МассивДокументов Цикл
			
			ГлавныйДокумент = Неопределено;
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")
			Тогда
				ГлавныйДокумент = Документ.ДокументЭТРН;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5")
				Или ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6")
			Тогда
				ГлавныйДокумент = Документ.Титул1;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
				ГлавныйДокумент = Документ.Титул1;
			Иначе
			 	ГлавныйДокумент = Документ;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда
				РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ГлавныйДокумент, НовоеСостояние);
			КонецЕсли
				
		КонецЦикла;
		
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось изменить состояние документа по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки;
	
КонецПроцедуры