
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	УточнениеТипаЛогистика = "";
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
		Если Форма.Элементы.Найти("ТипЛогистика") <> Неопределено Тогда
			УточнениеТипаЛогистика = Форма.ТипЛогистика;
		КонецЕсли;
	Иначе
		Форма = Неопределено;
	КонецЕсли;
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", ПараметрКоманды, УточнениеТипаЛогистика);
									
	Если ПараметрКоманды.Количество() = 1 Тогда // через форму документа 
		
		ДокументСсылка = ПараметрКоманды[0];
		
		Если ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда		
			ТипыЛогистикаДляДокумента = Новый Массив;
			ТипыЛогистикаДляДокумента.Добавить(УточнениеТипаЛогистика);			
		Иначе
			ТипыЛогистикаДляДокумента = ТипыЛогистикаПоДокументу1ССервер(ДокументСсылка);
		КонецЕсли;
		
		// при неоднозначном определении документа мерк - спросим
		Если ТипыЛогистикаДляДокумента.Количество() = 1 Тогда
			
			ВвестиДокументЛогистикаПоДокументу1С(ТипыЛогистикаДляДокумента[0], ПараметрыВводаДокументов);
			
		Иначе
			
			СписокВыбора = новый СписокЗначений;
			СписокВыбора.ЗагрузитьЗначения(ТипыЛогистикаДляДокумента);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьИзСписка_КонтурЛогистика(СписокВыбора,
			,
			ЭтотОбъект,
			"ВвестиДокументЛогистикаПоДокументу1С",
			ПараметрыВводаДокументов,
			Форма);
			
		КонецЕсли;
		
	Иначе // без открытия форм
		
		ВвестиДокументыПакетно(Истина, ПараметрыВводаДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиДокументЛогистикаПоДокументу1С(ТипЛогистикаДляДокумента, ПараметрыВводаДокументов) Экспорт
	
	Если ТипЗнч(ТипЛогистикаДляДокумента) = Тип("ЭлементСпискаЗначений") Тогда 
		ТипЛогистикаДляДокумента = ТипЛогистикаДляДокумента.Значение;
	КонецЕсли;
	
	ДокументСсылка = ПараметрыВводаДокументов.МассивДокументов[0];
	ТипЛогистика = ПараметрыВводаДокументов.УточнениеТипаЛогистика;
	
	КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаПоДокументу1С(ТипЛогистикаДляДокумента, ДокументСсылка, ЭтотОбъект);
	
КонецПроцедуры

