
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура;
	
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда 
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не передан документ, по которому нужно показать файлы обмена");
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
		ПараметрыФормы.Вставить("ОтборГлавныйДокумент", ПараметрКоманды);
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектронныйЗаказНаряд") Тогда 
		ПараметрыФормы.Вставить("ОтборГлавныйДокумент", ПараметрКоманды);
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		Или ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда 
		ОтборСписокФайлов = ВсеФайлыОбменаПЛ(ПараметрКоманды);
		ПараметрыФормы.Вставить("ОтборСписокФайлов", ОтборСписокФайлов);
	Иначе
		ПараметрыФормы.Вставить("ОтборСвязанныйДокумент", ПараметрКоманды);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ОтборСостояние", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Все"));
	
	ОткрытьФорму("Справочник.КонтурЛогистика_ФайлыОбмена.ФормаСписка",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник,
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно,
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
				
КонецПроцедуры

&НаСервере
Функция ВсеФайлыОбменаПЛ(ГлавныйДокумент)
	
	тзВсеФайлы = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиВсеФайлыПоГлавномуДокументу(ГлавныйДокумент);
	
	СписокФайлов = Новый СписокЗначений;
	СписокФайлов.ЗагрузитьЗначения(тзВсеФайлы.ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокФайлов;
	
КонецФункции
