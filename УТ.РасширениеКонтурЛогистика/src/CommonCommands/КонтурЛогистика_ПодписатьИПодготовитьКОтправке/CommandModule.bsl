
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	УточнениеТипаЛогистика = "";
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
		Если Форма.Элементы.Найти("ТипЛогистика") <> Неопределено Тогда
			УточнениеТипаЛогистика = Форма.ТипЛогистика;
		КонецЕсли;
	Иначе
		Форма = Неопределено;
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	Для Каждого ТекущийДокументСсылка Из ПараметрКоманды Цикл
		ТекущееТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный");
		НовоеТребуемоеДействие = КонтурЛогистика_ОбработкаДокументовСервер.ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(
			ТекущееТребуемоеДействие, ТекущийДокументСсылка);
		Если ТекущееТребуемоеДействие = НовоеТребуемоеДействие Тогда
			МассивДокументов.Добавить(ТекущийДокументСсылка);
		Иначе
			ТекстСообщения = "Нет права подписания по документу: " + Строка(ТекущийДокументСсылка);
			Сообщить(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВводаДокументов = Новый Структура;
	ПараметрыВводаДокументов.Вставить("МассивДокументов", МассивДокументов);
	ПараметрыВводаДокументов.Вставить("УточнениеТипаЛогистика", УточнениеТипаЛогистика);
	ПараметрыВводаДокументов.Вставить("Интерактивно");

	Состояние("Готовим данные", 20, "создаем документы и подписи", БиблиотекаКартинок.КонтурЛогистика_Лого16);
	МассивФайловОбмена = ИзготовитьФайлыОбмена(ПараметрыВводаДокументов);
	
	Состояние("Формируем документы из шаблона", 30, "подготавливаем документ из шаблона", БиблиотекаКартинок.КонтурЛогистика_Лого16);
	КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбменаДокументовИзШаблонов(МассивФайловОбмена);
	
	#Если ВебКлиент Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрКоманды", МассивДокументов);
		ДополнительныеПараметры.Вставить("МассивФайловОбмена", МассивФайловОбмена);
		
		Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСКриптографиейПодключено", ЭтотОбъект, ДополнительныеПараметры);	
		НачатьПодключениеРасширенияРаботыСКриптографией(Оповещение);
		
	#Иначе
		
		МассивПодписанныхФайловОбмена = ПодписатьФайлы(МассивФайловОбмена);
		
		// Ранее здесь использовался перевод титула в статус подготовлен к отправке.
		// Теперь, когда у титулов появился статус "Подписан", это не требуется
		// Выполнение обмена отправит в фоне титулы в статусе "Подписан"		
		
		Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
		ОповеститьОбИзменении(ТипЗнч(МассивДокументов[0]));
		Оповестить("КонтурЛогистика_ОбновитьЗадачи", МассивДокументов);
		
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСКриптографиейПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСКриптографией(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	ОповещениеПодписатьФайлыЗавершение = Новый ОписаниеОповещения("ПодписатьФайлыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Состояние("Подписываем документы", 60, "создаем файлы обмена", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);	
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПодписатьФайлыОбменаАсинхронно(ДополнительныеПараметры.МассивФайловОбмена, ОповещениеПодписатьФайлыЗавершение);
	
КонецПроцедуры

&НаКлиенте	
Функция ПодписатьФайлыЗавершение(МассивПодписанныхФайловОбмена, ДополнительныеПараметры) Экспорт
	
	// Ранее здесь использовался перевод титула в статус подготовлен к отправке.
	// Теперь, когда у титулов появился статус "Подписан", это не требуется
	// Выполнение обмена отправит в фоне титулы в статусе "Подписан"		
	
	Состояние("Отправка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
	ОповеститьОбИзменении(ТипЗнч(ДополнительныеПараметры.ПараметрКоманды[0]));
	Оповестить("КонтурЛогистика_ОбновитьЗадачи", ДополнительныеПараметры.ПараметрКоманды);
	
Конецфункции

&НаСервере
Функция ИзготовитьФайлыОбмена(ПараметрыВводаДокументов)
	
	ПараметрыФормированияФайловРеквизиты = Новый Структура;
	ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
	
	МассивФайловОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);	
	Возврат МассивФайловОбмена;
	
КонецФункции
	
&НаКлиенте	
Функция ПодписатьФайлы(МассивФайловОбмена)
		
	Состояние("Подписываем документы", 60, "создаем файлы обмена", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
	
	МассивПодписанныхФайловОбмена = КонтурЛогистика_ОбработкаДокументовКлиент.ПодписатьФайлыОбмена(МассивФайловОбмена);
	
	Возврат МассивПодписанныхФайловОбмена;

КонецФункции

&НаСервере
Процедура ПодготовитьКОтправке(МассивПодписанныхФайловОбмена)
	
	МассивДокументовЛогистика = Новый Массив;
	Для Каждого ФайлОбмена Из МассивПодписанныхФайловОбмена Цикл 
		МассивДокументовЛогистика.Добавить(ФайлОбмена.СвязанныйДокумент);
	КонецЦикла;

	Если ТипЗнч(МассивДокументовЛогистика) = Тип("Массив")
		И МассивДокументовЛогистика.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьДокументыКОтправке(МассивДокументовЛогистика, Истина);
		Если НЕ РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры




