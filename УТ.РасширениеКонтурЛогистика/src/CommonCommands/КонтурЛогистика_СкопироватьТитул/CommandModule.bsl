&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Документ = ПараметрКоманды;
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Сообщить("Титул не создан");
		Возврат;
	КонецЕсли;
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Документ);	
	
	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда
		
		ДокументЭТРН = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Документ, "ДокументЭТРН");
		Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
			Сообщить("Титул не привязан к ЭТРН");
			Возврат;
		КонецЕсли;		
	
	КонецЕсли;
	
	ДанныеЗаполнения 	= Новый Структура("Титул, ТипЛогистика, Скопировать", Документ, ТипЛогистика, Истина);		
	ПараметрыФормы 		= Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
			
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ." + КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика) + ".ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Процедура ПроверкаКопированияТитула(Титул, ТипЛогистика)
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Титул);
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
	
		Если Не ЗначениеЗаполнено(Титул.ДокументЭТРН) Тогда
			Сообщить("Титул не привязан к ЭТРН");
			Возврат;
		КонецЕсли;		
	
	КонецЕсли;
	
КонецПроцедуры
