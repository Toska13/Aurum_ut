
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	УточнениеТипаЛогистика = "";
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
		Если Форма.Элементы.Найти("ТипЛогистика") <> Неопределено Тогда
			УточнениеТипаЛогистика = Форма.ТипЛогистика;
		КонецЕсли;
	Иначе
		Форма = Неопределено;
	КонецЕсли;
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов, УточнениеТипаЛогистика", ПараметрКоманды, УточнениеТипаЛогистика);
	
	
	Если ПараметрКоманды.Количество() = 1 Тогда // через форму документа 
		
		ДокументСсылка = ПараметрКоманды[0];
		
		Если не ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда
			
			Если КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулТрн(ДокументСсылка) Тогда
				
				ДокЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументСсылка);
				УточнениеТипаЛогистика = ОпределитьСледующийПоЦепочкеТипТитулаЭТРН(ДокЭТРН);
				
			ИначеЕсли КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулПЛ(ДокументСсылка) Тогда
				
				ДокТ1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументСсылка);
				УточнениеТипаЛогистика = ОпределитьСледующийПоЦепочкеТипТитулаПЛ(ДокТ1);
				
			ИначеЕсли КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулЗЗ(ДокументСсылка) Тогда
				
				ДокТ1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументСсылка);
				УточнениеТипаЛогистика = ОпределитьСледующийПоЦепочкеТипТитулаЗЗ(ДокТ1);	
				
			ИначеЕсли КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулДФ(ДокументСсылка) Тогда
				
				ДокТ1 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументСсылка);
				УточнениеТипаЛогистика = ОпределитьСледующийПоЦепочкеТипТитулаДФ(ДокТ1);	
				
			ИначеЕсли КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулЗН(ДокументСсылка) Тогда
				
				ДокЗН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументСсылка);
				УточнениеТипаЛогистика = ОпределитьСледующийПоЦепочкеТипТитулаЗН(ДокЗН);
				
			ИначеЕсли КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулСВ(ДокументСсылка) Тогда
				
				ДокСВ = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ДокументСсылка);
				УточнениеТипаЛогистика = ОпределитьСледующийПоЦепочкеТипТитулаСВ(ДокСВ);
				
			КонецЕсли;
		
		КонецЕсли;
		
		КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаИзПредыдущегоТитула(УточнениеТипаЛогистика, ДокументСсылка, Форма);
		
	Иначе // без открытия форм
		
		ВвестиДокументыПакетно(УточнениеТипаЛогистика, ПараметрКоманды);
		Оповестить("КонтурЛогистика_ВвестиДокумент");

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьСледующийПоЦепочкеТипТитулаЭТРН(ДокументСсылка)

	Возврат Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПолучитьСледующийПоЦепочкеТипТитулаЭТРН(ДокументСсылка);	

КонецФункции

&НаСервере
Функция ОпределитьСледующийПоЦепочкеТипТитулаПЛ(ДокументСсылка)

	// TODO требуетя реализовать многообразие последовательности титулов.
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументСсылка);
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипЛогистика) Тогда
		Возврат Документы.КонтурЛогистика_ПЛ_Титул1.ПолучитьСледующийПоЦепочкеТипТитулаПЛ_5_02(ДокументСсылка);
	Иначе
		Возврат Документы.КонтурЛогистика_ПЛ_Титул1.ПолучитьСледующийПоЦепочкеТипТитулаПЛ(ДокументСсылка);	
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьСледующийПоЦепочкеТипТитулаЗЗ(ДокументСсылка)

	Возврат Документы.КонтурЛогистика_ЗЗ_Титул1.ПолучитьСледующийПоЦепочкеТипТитулаЗЗ(ДокументСсылка);	

КонецФункции

&НаСервере
Функция ОпределитьСледующийПоЦепочкеТипТитулаДФ(ДокументСсылка)

	Возврат Документы.КонтурЛогистика_ДФ_Титул1.ПолучитьСледующийПоЦепочкеТипТитулаДФ(ДокументСсылка);	

КонецФункции

&НаСервере
Функция ОпределитьСледующийПоЦепочкеТипТитулаЗН(ДокументСсылка)

	Возврат Документы.КонтурЛогистика_ЭлектронныйЗаказНаряд.ПолучитьСледующийПоЦепочкеТипТитулаЗН(ДокументСсылка);	

КонецФункции

&НаСервере
Функция ОпределитьСледующийПоЦепочкеТипТитулаСВ(ДокументСсылка)

	Возврат Документы.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.ПолучитьСледующийПоЦепочкеТипТитулаСВ(ДокументСсылка);	

КонецФункции

&НаСервере
Процедура ВвестиДокументыПакетно(УточнениеТипаЛогистика, МассивДокументов)

	КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(МассивДокументов, УточнениеТипаЛогистика, Ложь);

КонецПроцедуры
