
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОбновитьТитулыНаСервере(ПараметрКоманды);
	
	Если ПараметрКоманды.Количество() = 1 И ЗначениеЗаполнено(ПараметрКоманды[0])Тогда 
		
		Если ЕстьОтправленныйФайлОбмена(ПараметрКоманды[0]) Тогда 
			
			ПараметрыФормы = Новый Структура("ОтборДокумент", ПараметрКоманды[0]);
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_СтатусыТитулов.ФормаСписка", ПараметрыФормы);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Оповестить("КонтурЛогистика_ОбновитьЗадачи");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТитулыНаСервере(МассивДокументовТитулов)
	
	Для Каждого ДокументТитул Из МассивДокументовТитулов Цикл 
		
		Если ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
			ИЛИ ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
			ИЛИ ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
			ИЛИ ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
			ИЛИ ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
			ИЛИ ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
			ИЛИ ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")
			 Тогда
			 
			 ТитулПоКоторомуЗапрашиваем = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументТитул.ДокументЭТРН);
			 Если Не ЗначениеЗаполнено(ТитулПоКоторомуЗапрашиваем) Тогда 
				 ТитулПоКоторомуЗапрашиваем = ДокументТитул;
			 КонецЕсли;
		Иначе
			ТитулПоКоторомуЗапрашиваем = ДокументТитул;
		КонецЕсли;
		
		
		ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ТитулПоКоторомуЗапрашиваем);
		
		Если ФайлОбмена = Неопределено Тогда
			
			Результат = Неопределено;
			
		Иначе
			
			ВремяЗапросаМСК = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
			Результат = КонтурЛогистика_API_Диадок.ПрочитатьТитулИзДиадока(ФайлОбмена);
			
			Если Результат.Успешно Тогда 
				
				// отразить изменения в базе данных
				CustomDataМассив = Результат.Титул.CustomData;
				
				ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(ТитулПоКоторомуЗапрашиваем);
				
				Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда 
					
					Для Каждого элементCustomData Из CustomDataМассив Цикл 
						
						Если элементCustomData.Key = "kl-id" Тогда
							
							Если Не ЗначениеЗаполнено(СокрЛП(ГлавныйДокумент.kl_id)) Тогда
								
								ДокументЭТРНОбъект = ГлавныйДокумент.ПолучитьОбъект();
								ДокументЭТРНОбъект.kl_id = элементCustomData.Value;
								ДокументЭТРНОбъект.Записать();
								
							ИначеЕсли ГлавныйДокумент.kl_id <> элементCustomData.Value Тогда
								
								Сообщить("Перепутаны идентификатор kl_id в 1С модуле: " + ГлавныйДокумент.kl_id + " и в сервисе: " + элементCustomData.Value);
								
							КонецЕсли;
							
							
						ИначеЕсли элементCustomData.Key = "kl-status" Тогда
							
							Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоКодуСостояниюСервиса(
								элементCustomData.Value);
							ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
								ФайлОбмена, "", Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок);
							РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
								ГлавныйДокумент, Состояние, ВремяЗапросаМСК,,, ДопДанные);
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
			Иначе
				
				Сообщить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(Результат));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьОтправленныйФайлОбмена(ДокументТитул)
	
	ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументТитул);
	Если ФайлОбмена = Неопределено Тогда 
		Возврат Ложь;
	ИначеЕсли ФайлОбмена.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
