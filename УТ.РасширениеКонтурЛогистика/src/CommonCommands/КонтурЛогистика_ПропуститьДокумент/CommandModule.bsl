
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	УточнениеТипаЛогистика = "";
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
		Если Форма.Элементы.Найти("ТипЛогистика")<> Неопределено Тогда
			УточнениеТипаЛогистика = Форма.ТипЛогистика;
		КонецЕсли;
	Иначе
		Форма = Неопределено;
	КонецЕсли;        
	
	СтруктураМассивов = ПолучитьСтруктуруМассивовДокументов(ПараметрКоманды);
	
	ПараметрыВводаДокументов = Новый Структура("МассивДокументов1С, МассивДокументовЛогистика, УточнениеТипаЛогистика, РежимПропуститьДокументы", 
		СтруктураМассивов.МассивДокументов1С, СтруктураМассивов.МассивДокументовЛогистика, УточнениеТипаЛогистика, Истина);
	
	Если ПараметрКоманды.Количество() > 4 Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Вы уверены что хотите пропустить " + ПараметрКоманды.Количество() + " документов?",
		РежимДиалогаВопрос.ДаНетОтмена,
		"Подтвердите обработку",
		,
		ЭтотОбъект,
		"ПропуститьДокументыПакетно",
		ПараметрыВводаДокументов);
	Иначе
		
		ПропуститьДокументыПакетно(Истина, ПараметрыВводаДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПропуститьДокументыПакетно(Подтверждено = Истина, ПараметрыВводаПакетно) Экспорт
	
	МассивДокументов1С = ПараметрыВводаПакетно.МассивДокументов1С;
	МассивДокументовЛогистика = ПараметрыВводаПакетно.МассивДокументовЛогистика;
	
	УточнениеТипаЛогистика = ПараметрыВводаПакетно.УточнениеТипаЛогистика;
	
	Если Подтверждено = Истина ИЛИ Подтверждено = КодВозвратаДиалога.Да Тогда 
		
			ПропуститьДокументыПакетноСервер(МассивДокументов1С, МассивДокументовЛогистика, УточнениеТипаЛогистика);
			Оповестить("КонтурЛогистика_ВвестиДокумент");
			
			Для Каждого ДокументСсылка Из ПараметрыВводаПакетно.МассивДокументовЛогистика Цикл
				ОповеститьОбИзменении(ДокументСсылка);
			КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПропуститьДокументыПакетноСервер(МассивДокументов1С, МассивДокументовЛогистика, УточнениеТипаЛогистика = Неопределено)
	
	КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(МассивДокументов1С, Ложь, УточнениеТипаЛогистика, Истина);
	ПропуститьДокументыЛогистика(МассивДокументовЛогистика);// пропустим те документы, что созданы ранее

КонецПроцедуры

&НаСервере
Процедура ПропуститьДокументыЛогистика(МассивСсылок)
	
	МенеджерРС = РегистрыСведений.КонтурЛогистика_СтатусыТитулов;
	МенеджерПеречисления = Перечисления.КонтурЛогистика_СтатусыТитулов; 
	
	МассивСтатусовИзКоторыхМожноПропустить = Новый Массив;
	МассивСтатусовИзКоторыхМожноПропустить.Добавить(МенеджерПеречисления.Черновик);
	МассивСтатусовИзКоторыхМожноПропустить.Добавить(МенеджерПеречисления.Ошибка);
	
	СтатусПропущен = МенеджерПеречисления.Пропущен;
	
	Для Каждого ДокументСсылка Из МассивСсылок Цикл
		
		ТекущийСтатус = МенеджерРС.ПолучитьСтатус(ДокументСсылка, Истина);
		
		Если ТекущийСтатус <> СтатусПропущен Тогда
			
			Если МассивСтатусовИзКоторыхМожноПропустить.Найти(ТекущийСтатус) <> Неопределено Тогда
				
				МенеджерРС.УстановитьСтатус(ДокументСсылка, СтатусПропущен); // Здесь же снимается резерв
				
			//ИначеЕсли ТекущийСтатус = МенеджерПеречисления.РаботаЗавершенаРаспечатан Тогда
			//	
			//	МенеджерРС.УстановитьСтатус(ДокументСсылка, МенеджерПеречисления.РаботаЗавершена); // такие документы считаем завершенными штатно
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Неподходящий статус документа " + ДокументСсылка + ": " + ТекущийСтатус;
				Сообщение.Сообщить();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруМассивовДокументов(ИсходныйМассивСсылок)
	
	МассивДокументов1С = Новый Массив;
	МассивДокументовЛогистика = Новый Массив;
	
	Для Каждого Ссылка Из ИсходныйМассивСсылок Цикл
	
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") 
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") 
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") 
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
			Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")Тогда
			
			Если ЗначениеЗаполнено(Ссылка.ДокументОснование) Тогда
				МассивДокументов1С.Добавить(Ссылка.ДокументОснование);
				МассивДокументовЛогистика.Добавить(Ссылка);
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "У документа " + Ссылка + " отсутствует основание!";
				Сообщение.Сообщить();
			КонецЕсли;
		Иначе
			МассивДокументов1С.Добавить(Ссылка);
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат Новый Структура("МассивДокументов1С, МассивДокументовЛогистика", МассивДокументов1С, МассивДокументовЛогистика);
	
КонецФункции
