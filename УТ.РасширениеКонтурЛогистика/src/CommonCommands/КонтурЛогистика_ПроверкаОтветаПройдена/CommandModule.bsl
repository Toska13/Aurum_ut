
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Форма = ПараметрыВыполненияКоманды.Источник;
	
	УстановитьСостояниеДО(ПараметрКоманды);
	
	Если Найти(Форма.ИмяФормы, "ФормаДокумента") Тогда 
		Форма.Закрыть();
	КонецЕсли;	
	
	Оповестить("КонтурЛогистика_ОбновитьЗадачи");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДО(ТитулСсылка)
	
	Если ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда 
		
		ГлавныйДокумент = ТитулСсылка.Титул1;
		
		ОформитьЭТрНПослеЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОформитьЭТрНПослеЗЗ"); 
		// особенности отправки в разрезе партнеров 
		Если ЗначениеЗаполнено(ГлавныйДокумент)
			И ЗначениеЗаполнено(ГлавныйДокумент.ПартнерПеревозчик) Тогда
			
			ОформитьЭТрНПослеЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОформитьЭТрНПослеЗЗ", ГлавныйДокумент.ПартнерПеревозчик);
			
		КонецЕсли;
		
		Если ОформитьЭТрНПослеЗЗ Тогда 
			
			// Если ТРН не введена то требуемое действие - ввести. Если введена - то завершено
			НайденнаяТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрНпоЗаказЗаявке(ГлавныйДокумент);
			Если ЗначениеЗаполнено(НайденнаяТРН) Тогда 
				Состояние 	= "zz-enterBasedOnConsignorAfter";
			Иначе 
				Состояние 	= "zz-wait-enterBasedOnConsignor";
			КонецЕсли;
		Иначе
			Состояние 	= "zz-completed";
		КонецЕсли;
		
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ГлавныйДокумент, Состояние,, Истина);
	
КонецПроцедуры	