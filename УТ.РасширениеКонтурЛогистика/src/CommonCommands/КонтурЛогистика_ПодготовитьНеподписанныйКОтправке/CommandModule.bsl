
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	УточнениеТипаЛогистика = "";
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		Форма = ПараметрыВыполненияКоманды.Источник;
		Если Форма.Элементы.Найти("ТипЛогистика") <> Неопределено Тогда
			УточнениеТипаЛогистика = Форма.ТипЛогистика;
		КонецЕсли;
	Иначе
		Форма = Неопределено;
	КонецЕсли;
	
	Состояние("Готовим данные", 20, "создаем документы", БиблиотекаКартинок.КонтурЛогистика_Лого16);
	МассивДокументовЛогистика = ВвестиДокументы(ПараметрКоманды, УточнениеТипаЛогистика);

	Состояние("Переводим статус готовности", 50, "проверяем документы", БиблиотекаКартинок.КонтурЛогистика_ЛогоСПодписью);
	ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика);
	
	Состояние("Обработка завершена", 100, "список задач обновлен", БиблиотекаКартинок.КонтурЛогистика_Окончание);
	ОповеститьОбИзменении(ТипЗнч(ПараметрКоманды[0]));
	Оповестить("КонтурЛогистика_ОбновитьЗадачи", ПараметрКоманды);

КонецПроцедуры

&НаСервере
Функция ВвестиДокументы(МассивДокументов, УточнениеТипаЛогистика)
	
	РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(МассивДокументов, Ложь, УточнениеТипаЛогистика);
		
	МассивДокументовЛогистика = РезультатВвода.ВведенныеДокументы;
	Возврат МассивДокументовЛогистика;
	
КонецФункции

&НаСервере
Процедура ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика)
	
	// Отправим файлы
	Если ТипЗнч(МассивДокументовЛогистика) = Тип("Массив")
		И МассивДокументовЛогистика.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьДокументыКОтправке(МассивДокументовЛогистика, Истина);
		Если НЕ РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры



