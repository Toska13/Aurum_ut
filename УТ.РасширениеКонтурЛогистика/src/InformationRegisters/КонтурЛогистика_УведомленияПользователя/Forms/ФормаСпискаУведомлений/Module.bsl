
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ИмяФормы", ФильтрИмяФормы);
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ЗаполнитьУведомления();
	
	УстановитьСвойстваФормыТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтборПрочитанныеПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы = Ложь Или ЗавершениеРаботы = Неопределено Тогда
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Просмотр уведомлений", "Закрыть форму уведомлений", ЭтаФорма.ИмяФормы);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура НадписьОнлайнКонсультантНажатие(Элемент)
	
	КонтурЛогистика_ЦентрПоддержкиКлиент.ОткрытьЦентрПоддержки();
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПисьмоВТехподдержкуНажатие(Элемент)
	
	КонтурЛогистика_ЦентрПоддержкиКлиент.НаписатьПисьмоВТехПоддержку();
	
КонецПроцедуры

&НаКлиенте
Процедура УведомленияПриАктивизацииСтроки(Элемент)
	
	УстановитьДоступностьКнопкиПрочитано();
	
	Если ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы")
		И ТекущийЭлемент.Имя = "Уведомления" Тогда
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Просмотр уведомлений", "Выбрать уведомление", ЭтаФорма.ИмяФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПрочитанныеПриИзменении(Элемент)
	
	СтруктураПоиска = Новый Структура;
	
	Если Не ОтборПрочитано Тогда
		СтруктураПоиска.Вставить("Прочитано", Ложь);
	КонецЕсли;
	
	Элементы.Уведомления.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФормуУведомлений(Команда)
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Просмотр уведомлений", "Закрыть форму уведомлений", ЭтаФорма.ИмяФормы);
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьУведомление(Команда)
	
	УстановитьПометкуОПрочтении();
	
	УстановитьДоступностьКнопкиПрочитано();
	
	Если Не ОтборПрочитано Тогда
		ЕстьНеПрочитанныеУведомления = Ложь;
		Для Каждого ТекущаяСтрока Из Уведомления Цикл
			Если Не ТекущаяСтрока.Прочитано Тогда
				ЕстьНеПрочитанныеУведомления = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьНеПрочитанныеУведомления Тогда
			// Закрываем, если нет не прочитанных и прочитанные скрываются
			Закрыть();
		КонецЕсли;
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Просмотр уведомлений", "Прочитать уведомление", ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьСвойстваФормыТакси()
	
	НастройкиЭлемента = Новый Структура;
	НастройкиЭлемента.Вставить("ВертикальноеПоложениеВГруппе", ВертикальноеПоложениеЭлемента.Центр);
	НастройкиЭлемента.Вставить("ВертикальноеПоложение", ВертикальноеПоложениеЭлемента.Центр);
	
	ЗаполнитьЗначенияСвойств(Элементы.НадписьОнлайнКонсультант, НастройкиЭлемента);
	ЗаполнитьЗначенияСвойств(Элементы.НадписьПисьмоВТехподдержку, НастройкиЭлемента);
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82()
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		
		НастройкиЭлемента = Новый Структура;
		НастройкиЭлемента.Вставить("Ширина", 15);
		ЗаполнитьЗначенияСвойств(Элементы.НадписьОнлайнКонсультант, НастройкиЭлемента);
		
		НастройкиЭлемента = Новый Структура;
		НастройкиЭлемента.Вставить("Ширина", 40);
		ЗаполнитьЗначенияСвойств(Элементы.НадписьПисьмоВТехподдержку, НастройкиЭлемента);
		
		НастройкиЭлемента = Новый Структура;
		НастройкиЭлемента.Вставить("Высота", 16);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкиЭлемента);
		
	КонецЕсли;
	
	// Условное оформление
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Уведомления.Прочитано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Уведомления");
	
	ШрифтТаблицы = Элементы.Уведомления.Шрифт;
	Шрифт = Новый Шрифт(ШрифтТаблицы,,,Истина);
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Шрифт);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУведомления()
	
	Уведомления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ЕстьОтборПоИмениФормы", ЗначениеЗаполнено(ФильтрИмяФормы));
	Запрос.УстановитьПараметр("ИмяФормы", ФильтрИмяФормы);
	Запрос.Текст = КонтурЛогистика_ОбновлениеСервер.ТекстЗапросаПоказаУведомленийПользователя();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Уведомления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если Найти(Выборка.Текст, "<html") = 0 Тогда
			НоваяСтрока.Текст = КонтурЛогистика_ОбновлениеСервер.ОбернутьТекстУведомленияВHTML(Выборка.Текст);
		Иначе
			НоваяСтрока.Текст = Выборка.Текст;
		КонецЕсли;
		
	КонецЦикла;
	
	Уведомления.Сортировать("Важное Desc, ДатаНачала Desc, Прочитано Desc");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопкиПрочитано()
	
	Элементы.ПрочитатьУведомление.Доступность = Ложь;
	
	ТекущиеДанные = Элементы.Уведомления.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено
		И Не ТекущиеДанные.Прочитано Тогда
		
		Элементы.ПрочитатьУведомление.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуОПрочтении()
	
	ТекущиеДанные = Элементы.Уведомления.ТекущиеДанные;
	ТекущиеДанные.Прочитано = Истина;
	
	СохранитьПризнакПрочтенияУведомления(ТекущиеДанные.Уведомление, ТекущийПользователь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьПризнакПрочтенияУведомления(Уведомление, ТекущийПользователь)
	
	РегистрыСведений.КонтурЛогистика_УведомленияПользователя.УстановитьПризнакПрочитано(Уведомление, ТекущийПользователь);
	
КонецПроцедуры

#КонецОбласти