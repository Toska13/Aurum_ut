#Область ПрограммныйИнтерфейс

Процедура ДобавитьОшибку(СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки) Экспорт
	
	Если ЗначениеЗаполнено(ОбъектОбработки) Тогда
		ТипДокументаСтрокой = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(ОбъектОбработки);
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЛогистическийТипПоТипуДокумента(ТипДокументаСтрокой);
	Иначе
		ТипЛогистика = Неопределено;
	КонецЕсли;
	
	// Добавляем письмо в очередь
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СценарииАвтоматическойРаботы.Установить(СценарииАвтоматическойРаботы);
	НаборЗаписей.Отбор.ТипЛогистика.Установить(ТипЛогистика);
	НаборЗаписей.Отбор.ОбъектОбработки.Установить(ОбъектОбработки);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		ТекущаяЗапись = НаборЗаписей.Добавить();
		ТекущаяЗапись.СценарииАвтоматическойРаботы = СценарииАвтоматическойРаботы;
		ТекущаяЗапись.ТипЛогистика = ТипЛогистика;
		ТекущаяЗапись.ОбъектОбработки = ОбъектОбработки;
		
		Отправитель = Неопределено;
		ИспользоватьОтправкуВТелеграм = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
		ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
		
		Если ИспользоватьОтправкуВТелеграм Или ИспользоватьОтправкуНаПочту Тогда
			
			// Рассчитаем реквизиты отправки по документу
			Если ЗначениеЗаполнено(ОбъектОбработки) Тогда
				Отправитель = ОтправительПоДокументу(СценарииАвтоматическойРаботы, ОбъектОбработки);
				
				Если ЗначениеЗаполнено(Отправитель) Тогда
					ТекущаяЗапись.ОповещениеТелефон = Отправитель.ТелефонУведомленияОшибокРоботов;
					ТекущаяЗапись.ОповещениеАдресЭлектроннойПочты = Отправитель.АдресЭлектроннойПочтыУведомленияОшибокРоботов;
				КонецЕсли;
			КонецЕсли;
			
			// Если не удалось взять по документу, то берем из сценария
			Если Не ЗначениеЗаполнено(ТекущаяЗапись.ОповещениеТелефон)
				И Не ЗначениеЗаполнено(ТекущаяЗапись.ОповещениеАдресЭлектроннойПочты) Тогда
				
				ТекущаяЗапись.ОповещениеТелефон = СценарииАвтоматическойРаботы.ТелефонУведомленияОшибокРоботов;
				ТекущаяЗапись.ОповещениеАдресЭлектроннойПочты = СценарииАвтоматическойРаботы.АдресЭлектроннойПочтыУведомленияОшибокРоботов;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИспользоватьОтправкуВТелеграм И ЗначениеЗаполнено(ТекущаяЗапись.ОповещениеТелефон) Тогда
			
			// Поставим в очередь сообщение на отправку
			ПоставитьСообщениеВОчередьНаОтправкуВТелеграм(
				ТекущаяЗапись.ОповещениеТелефон, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, Отправитель);
			
		КонецЕсли;
		
		Если ИспользоватьОтправкуНаПочту И ЗначениеЗаполнено(ТекущаяЗапись.ОповещениеАдресЭлектроннойПочты) Тогда
			
			// Отправляем письмо на почту
			ОтправитьСообщениеНаАдресЭлектроннойПочты(
				ТекущаяЗапись.ОповещениеАдресЭлектроннойПочты, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, Отправитель);
			
		КонецЕсли;
		
	Иначе
		ТекущаяЗапись = НаборЗаписей[0];
	КонецЕсли;
	
	ТекущаяЗапись.ТекстОшибки = ТекстОшибки;
	ТекущаяЗапись.ДатаСобытия = ТекущаяДатаСеанса();
	
	// Нет смысла фиксировать пустой текст ошибки
	Если ТекстОшибки = "" Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПредставлениеКоличестваОшибок(ТипЛогистика = Неопределено) Экспорт
	
	ПредставлениеКоличестваОшибок = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипЛогистика", ТипЛогистика);
	Запрос.УстановитьПараметр("ТипЛогистикаЗаполнена", ЗначениеЗаполнено(ТипЛогистика));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ОбъектОбработки) КАК КоличествоОшибок,
	|	МИНИМУМ(КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ДатаСобытия) КАК МинимальнаяДатаСобытия
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы КАК КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы
	|ГДЕ
	|	(&ТипЛогистикаЗаполнена
	|				И КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ТипЛогистика = &ТипЛогистика
	|			ИЛИ НЕ &ТипЛогистикаЗаполнена)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.КоличествоОшибок = 0 Тогда
			ПредставлениеКоличестваОшибок = "";
		Иначе
			ПредставлениеКоличестваОшибок = Формат(Выборка.КоличествоОшибок, "ЧГ=0")
				+ " " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьОшибкиВСклонении(Выборка.КоличествоОшибок)
				+ " с " + Формат(Выборка.МинимальнаяДатаСобытия, "ДФ=dd.MM.yy");
		КонецЕсли;
		
	Иначе
		
		ПредставлениеКоличестваОшибок = "";
		
	КонецЕсли;
	
	Возврат ПредставлениеКоличестваОшибок;
	
КонецФункции

Процедура УдалитьЗапись(СценарииАвтоматическойРаботы, ОбъектОбработки = Неопределено) Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СценарииАвтоматическойРаботы.Установить(СценарииАвтоматическойРаботы);
	НаборЗаписей.Отбор.ОбъектОбработки.Установить(ОбъектОбработки);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КоличествоОшибокПоТипуЛогистики(ТипЛогистика)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипЛогистика", ТипЛогистика);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ОбъектОбработки) КАК ОбъектОбработки
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы КАК КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы
	|ГДЕ
	|	КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ТипЛогистика = &ТипЛогистика";
	
	Резульата = Запрос.Выполнить();
	
	Если Резульата.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = Резульата.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ОбъектОбработки;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ОтправительПоДокументу(СценарииАвтоматическойРаботы, ОбъектОбработки)
	
	Попытка
		
		ДанныеФайлаОтправки = Справочники.КонтурЛогистика_ФайлыОбмена.ПолучитьОсновныеДанныеФайла(
			ОбъектОбработки, СценарииАвтоматическойРаботы.ТипЛогистическогоДокумента);
		Отправитель = ДанныеФайлаОтправки.Отправитель;
		
	Исключение
		
		Отправитель = Неопределено;
		
	КонецПопытки;
	
	Возврат Отправитель;
	
КонецФункции

Процедура ПоставитьСообщениеВОчередьНаОтправкуВТелеграм(Телефон, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, Отправитель)
	
	ТекстЗаголовка = ТекстЗаголовкаСообщения(ОбъектОбработки);
	
	ФорматHTML = Ложь;
	ТекстСообщения = ТекстСообщенияОбОшибке(ТекстЗаголовка, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, ФорматHTML, Отправитель);
	
	НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
	НовоеСообщение.Тип = "text";
	НовоеСообщение.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(ТекстСообщения);
	
	Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовоеСообщение);
	
	РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(Телефон, Сообщения);
	
КонецПроцедуры

Процедура ОтправитьСообщениеНаАдресЭлектроннойПочты(АдресЭлектроннойПочты, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, Отправитель)
	
	ТекстЗаголовка = ТекстЗаголовкаСообщения(ОбъектОбработки);
	
	ФорматHTML = Истина;
	ТекстСообщения = ТекстСообщенияОбОшибке(ТекстЗаголовка, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, ФорматHTML, Отправитель);
	
	ШаблонПисьма = ШаблонПисьмаHTML();
	ТекстПисьма = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонПисьма, ТекстСообщения);
	
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = ТекстЗаголовка;
	Письмо.Тексты.Добавить(ТекстПисьма, ТипТекстаПочтовогоСообщения.HTML);
	
	Получатели = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(АдресЭлектроннойПочты, ";", Ложь);
	Для Каждого Получатель Из Получатели Цикл
		Письмо.Получатели.Добавить(Получатель);
	КонецЦикла;
	
	Попытка
		
		ТекстОшибкиОтправки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
		
		Если ЗначениеЗаполнено(ТекстОшибкиОтправки) Тогда
			ЗаписьЖурналаРегистрации("КонтурЛогистика_Робот_" + СценарииАвтоматическойРаботы,
				УровеньЖурналаРегистрации.Ошибка,, ОбъектОбработки, ТекстОшибкиОтправки);
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибкиОтправкиПочты = "Роботы, сценарий: " + Строка(СценарииАвтоматическойРаботы) + "
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ОбъектОбработки, ТекстОшибкиОтправкиПочты);
		
	КонецПопытки;
	
КонецПроцедуры

Функция ТекстЗаголовкаСообщения(ОбъектОбработки)
	
	Если ЗначениеЗаполнено(ОбъектОбработки) Тогда
		ТекстЗаголовка = "ОШИБКА ОБРАБОТКИ ДОКУМЕНТА";
	Иначе
		ТекстЗаголовка = "ОШИБКА АВТОМАТИЧЕСКОЙ ОБРАБОТКИ";
	КонецЕсли;
	
	Возврат ТекстЗаголовка;
	
КонецФункции

Функция ТекстСообщенияОбОшибке(ТекстЗаголовка, СценарииАвтоматическойРаботы, ОбъектОбработки, ТекстОшибки, ФорматHTML, Отправитель)
	
	Если ФорматHTML Тогда
		ШаблонЗаголовка = "<b>%1</b>";
		ШаблонСтроки = "<p>%1</p>";
		ШаблонСтрокиКода = "<p><code>%1</code></p>";
	Иначе
		ШаблонЗаголовка = "<b>%1</b>";
		ШаблонСтроки = "%1";
		ШаблонСтрокиКода = "<code>%1</code>";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	// Заголовок для Телеграм
	Если Не ФорматHTML Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка, ТекстЗаголовка));
	КонецЕсли;
	
	// Отправитель
	Если ЗначениеЗаполнено(Отправитель) Тогда
		ОтправительПредставление = "Организация: " + Строка(Отправитель);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки,
			?(ФорматHTML, "", Символы.ПС) + ОтправительПредставление + ?(ФорматHTML, "<br><br>", "")));
	КонецЕсли;
	
	// Объект обработки
	Если ЗначениеЗаполнено(ОбъектОбработки) Тогда
		ОбъектОбработкиПредставление = Строка(ОбъектОбработки);
	Иначе
		ОбъектОбработкиПредставление = Строка(СценарииАвтоматическойРаботы);
	КонецЕсли;
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки,
		?(ФорматHTML, "", Символы.ПС) + ОбъектОбработкиПредставление));
	
	// Текст ошибки
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки,
		?(ФорматHTML, "<br>", Символы.ПС) + "Текст ошибки:"));
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиКода,
		?(ФорматHTML, "<br>", "") + ТекстОшибки));
	
	ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	
	Возврат ТекстСообщения;
	
КонецФункции

