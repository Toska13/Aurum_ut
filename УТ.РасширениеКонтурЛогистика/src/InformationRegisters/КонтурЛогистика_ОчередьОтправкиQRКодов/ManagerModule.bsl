Функция ТекстПодробнойИнформации(ПараметрыОтправки, ФорматHTML)
	
	Если ФорматHTML Тогда
		ШаблонСтрокиЛиста = "<tr><th>%1</th><td>%2</td></tr>";
	Иначе
		ШаблонСтрокиЛиста = "<b>%1:</b> %2";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	Если ФорматHTML Тогда
		Строки.Добавить("<table class=""table table-condensed"">");
		Строки.Добавить("<tbody>");
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыОтправки.Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		
		// ЭТрН
		
		// Адреса
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Откуда", ПараметрыОтправки.АдресОткуда));
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Куда", ПараметрыОтправки.АдресКуда));
		
		// Дата и время
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"План подачи", ПараметрыОтправки.Дата1));
		Если ЗначениеЗаполнено(ПараметрыОтправки.Дата2) Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
				"Срок доставки", ПараметрыОтправки.Дата2));
		КонецЕсли;
		
		// Транспорт, водители и груз
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Автомобиль (прицеп)", КонтурЛогистика_Уведомления.ТекстТранспорта(ПараметрыОтправки)));
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Водители",
			Строка(ПараметрыОтправки.Сотрудник1) + ?(ЗначениеЗаполнено(ПараметрыОтправки.Сотрудник2), ", " + ПараметрыОтправки.Сотрудник2, "")));
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Количество мест", Строка(ПараметрыОтправки.КоличествоМест)));
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Общая масса брутто", Строка(ПараметрыОтправки.ОбщаяМасса) + " кг"));
		
	Иначе
		
		// ПЛ
		
		// Адрес
		Если ЗначениеЗаполнено(ПараметрыОтправки.АдресОткуда) Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
				"Место отправления", ПараметрыОтправки.АдресОткуда));
		КонецЕсли;
		
		// Дата и время
		Если ЗначениеЗаполнено(ПараметрыОтправки.Дата2) Тогда
			
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
				"Срок действия"));
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
				"    с", Формат(ПараметрыОтправки.Дата1, "ДФ=dd.MM.yyyy")));
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
				"    по", Формат(ПараметрыОтправки.Дата2, "ДФ=dd.MM.yyyy")));
			
		Иначе
			
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
				"Срок действия", Формат(ПараметрыОтправки.Дата1, "ДФ=dd.MM.yyyy")));
			
		КонецЕсли;
				
		// Транспорт и водители
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Автомобиль, прицеп", КонтурЛогистика_Уведомления.ТекстТранспорта(ПараметрыОтправки)));
					
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЛиста,
			"Водители",
			Строка(ПараметрыОтправки.Сотрудник1) + ?(ЗначениеЗаполнено(ПараметрыОтправки.Сотрудник2), ", " + ПараметрыОтправки.Сотрудник2, "")));
		
	КонецЕсли;
	
	Если ФорматHTML Тогда
		Строки.Добавить("</tbody></table>");
	КонецЕсли;
	
	ТекстПодробнойИнформации = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	
	Возврат ТекстПодробнойИнформации;
	
КонецФункции

Функция ТипДокументаСтрокой(Документ)
	
	ТипДокумента = ТипЗнч(Документ);
	
	Если ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8") Тогда
		
		Возврат "ЭТрН";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4") Тогда
		
		Возврат "ПЛ";
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

Процедура УстановитьДанныеКода(ДокументСсылка, ДвочиныеДанныеКода)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ТекущаяЗапись = НаборЗаписей.Добавить();
		ТекущаяЗапись.Документ = ДокументСсылка;
	Иначе
		ТекущаяЗапись = НаборЗаписей[0];
	КонецЕсли;
	
	ТекущаяЗапись.КодПолучен = Истина;
	ТекущаяЗапись.ДанныеКода = Новый ХранилищеЗначения(ДвочиныеДанныеКода, Новый СжатиеДанных(9));
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

