#Область ПрограммныйИнтерфейс

// Добавляет в очередь получения и отправки.
//
// Параметры:
//  ГлавныйДокумент		 - ДокументСсылка.КонтурЛогистика_ПЛ_Титул1,ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная 	 - главный документ.
//  ОтправленныйТитул	 - ДокументСсылка	 - отправляемый титул.
//
Процедура ДобавитьВОчередь(ГлавныйДокумент, ОтправленныйТитул) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("АвтоматическоеПолучениеИОтправкаQRКодов") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПоддерживаемыйТипТитула(ОтправленныйТитул) Тогда
		Возврат;
	КонецЕсли;
	
	// Данные для формирования письма
	ПараметрыОтправки = КонтурЛогистика_Уведомления.ДанныеПоДокументу(ГлавныйДокумент);
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.АдресПочтыСотрудника1)
		Или ЗначениеЗаполнено(ПараметрыОтправки.АдресПочтыСотрудника2) Тогда
		
		// Формируем письмо
		Письмо = СформироватьПисьмо(ПараметрыОтправки);
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыОтправки.Телефон1)
		И Не ЗначениеЗаполнено(ПараметрыОтправки.Телефон2) Тогда
		
		// Ни телефоны, ни адреса почт получателей не заполнены
		Возврат;
		
	КонецЕсли;
	
	// Добавляем письмо в очередь
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ГлавныйДокумент);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Документ = ГлавныйДокумент;
	НоваяЗапись.УИДМинтранса = ПараметрыОтправки.УИДМинтранса;
	НоваяЗапись.kl_id = ПараметрыОтправки.kl_id;
	НоваяЗапись.Письмо = Новый ХранилищеЗначения(Письмо);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Формируем письмо для отправки водителям
//
// Параметры:
//  ПараметрыОтправки	 - Структура	 - см. ПараметрыОтправкиQRКодаПоДокументу.
// 
// Возвращаемое значение:
//  ИнтернетПочтовоеСообщение - письмо.
//
Функция СформироватьПисьмо(ПараметрыОтправки) Экспорт
	
	ТекстПодробнойИнформации = ТекстПодробнойИнформации(ПараметрыОтправки, Истина);
	
	ШаблонПисьма = ТекстПисьмаQR();
	ШаблонПисьма = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
		ШаблонПисьма, ПараметрыОтправки.УИДМинтранса, ТекстПодробнойИнформации);
	
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = ТемаПисьма(ПараметрыОтправки);
	Письмо.Тексты.Добавить(ШаблонПисьма, ТипТекстаПочтовогоСообщения.HTML);
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.АдресПочтыСотрудника1) Тогда
		Письмо.Получатели.Добавить(СокрЛП(ПараметрыОтправки.АдресПочтыСотрудника1));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.АдресПочтыСотрудника2) Тогда
		Письмо.Получатели.Добавить(СокрЛП(ПараметрыОтправки.АдресПочтыСотрудника2));
	КонецЕсли;
	
	Возврат Письмо;
	
КонецФункции

// Формируем сообщения в телеграм
//
// Параметры:
//  ПараметрыОтправки	 - Структура	 - см. ПараметрыОтправкиQRКодаПоДокументу.
//  ДвоичныеДанныеQRКода - ДвоичныеДанные - двоичные данные QR кода.
// 
// Возвращаемое значение:
//  Массив из Структур - см. КонтурЛогистика_РаботаСТелеграм.МанифестСообщения().
//
Функция СформироватьСообщенияВТелеграм(ПараметрыОтправки, ДвоичныеДанныеQRКода) Экспорт
	
	// Заголовок
	ТекстСообщения = "<b>" + ТемаПисьма(ПараметрыОтправки) + "</b>" + Символы.ПС + Символы.ПС;
	
	// Подробная информация
	ТекстСообщения = ТекстСообщения + ТекстПодробнойИнформации(ПараметрыОтправки, Ложь) + Символы.ПС + Символы.ПС;
	
	// УИД Минтранса
	ТекстСообщения = ТекстСообщения + "<b>УИД Минтранса: </b>" + Строка(ПараметрыОтправки.УИДМинтранса);
	
	Сообщения = Новый Массив;
	НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
	НовоеСообщение.Тип = "animation";
	НовоеСообщение.Заголовок = ТекстСообщения;
	НовоеСообщение.ИмяФайла = "QRCode.gif";
	НовоеСообщение.Данные = ДвоичныеДанныеQRКода;
	Сообщения.Добавить(НовоеСообщение);
	
	Возврат Сообщения;
	
КонецФункции

// Получает и отправляет QR-код
//
// Параметры:
//  Документы - Массив из ДокументСсылка	 - если заполнен, то обрабатывается только он.
//
Процедура ПолучитьОтправить(Документы = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документы) Тогда
		УдалитьУстаревшиеОтправкиQRКодов();
	КонецЕсли;
	
	ПолучитьQRКоды(Документы);
	
	ОтправитьQRКоды(Документы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоддерживаемыйТипТитула(Документ)
	
	ТипДокумента = ТипЗнч(Документ);
	
	Если ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4")
		Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02")Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура УдалитьУстаревшиеОтправкиQRКодов()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ОчередьОтправкиQRКодов КАК КонтурЛогистика_ОчередьОтправкиQRКодов
	|ГДЕ
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.ДатаНачалаПолучения > ДАТАВРЕМЯ(1, 1, 1)
	|	И РАЗНОСТЬДАТ(КонтурЛогистика_ОчередьОтправкиQRКодов.ДатаНачалаПолучения, &ТекущаяДата, ДЕНЬ) > 30";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Документ);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьQRКоды(Документы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы", Документы);
	Запрос.УстановитьПараметр("ОтборПоДокументу", ЗначениеЗаполнено(Документы));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.Документ КАК Документ,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.Документ.ХешСуммаQRКода КАК ХешСуммаQRКода,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.ДатаНачалаПолучения КАК ДатаНачалаПолучения,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.УИДМинтранса КАК УИДМинтранса,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.kl_id КАК kl_id
	|ПОМЕСТИТЬ ДокументыБезКодов
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ОчередьОтправкиQRКодов КАК КонтурЛогистика_ОчередьОтправкиQRКодов
	|ГДЕ
	|	НЕ КонтурЛогистика_ОчередьОтправкиQRКодов.КодПолучен
	|	И (&ОтборПоДокументу
	|				И КонтурЛогистика_ОчередьОтправкиQRКодов.Документ В (&Документы)
	|			ИЛИ НЕ &ОтборПоДокументу)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыБезКодов.УИДМинтранса КАК УИДМинтранса,
	|	ДокументыБезКодов.kl_id КАК kl_id,
	|	ДокументыБезКодов.Документ КАК Документ,
	|	ДокументыБезКодов.ХешСуммаQRКода КАК ХешСуммаQRКода,
	|	ДокументыБезКодов.ДатаНачалаПолучения КАК ДатаНачалаПолучения
	|ИЗ
	|	ДокументыБезКодов КАК ДокументыБезКодов
	|ГДЕ
	|	ДокументыБезКодов.ДатаНачалаПолучения = ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыБезКодов.УИДМинтранса КАК УИДМинтранса,
	|	ДокументыБезКодов.kl_id КАК kl_id,
	|	ДокументыБезКодов.Документ КАК Документ,
	|	ДокументыБезКодов.ХешСуммаQRКода КАК ХешСуммаQRКода,
	|	ДокументыБезКодов.ДатаНачалаПолучения КАК ДатаНачалаПолучения
	|ИЗ
	|	ДокументыБезКодов КАК ДокументыБезКодов
	|ГДЕ
	|	ДокументыБезКодов.ДатаНачалаПолучения <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаПовторноеПолучение = Результат[2].Выбрать();
	Пока ВыборкаПовторноеПолучение.Следующий() Цикл
		
		ОрганизацияДиадок = АвторизованнаяОрганизацияПоДокументу(ВыборкаПовторноеПолучение.Документ);
		
		ПолучитьQRКод(ВыборкаПовторноеПолучение.kl_id, ОрганизацияДиадок,
			ВыборкаПовторноеПолучение.Документ, ВыборкаПовторноеПолучение.ХешСуммаQRКода);
	КонецЦикла;
	
	ТЗПерваяПопытка = Результат[1].Выгрузить();
	Если ТЗПерваяПопытка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Установим дату начала получения, чтобы при следующей попытки получения кодов не долбиться в минтранс
	ТекущаяДата = ТекущаяДатаСеанса();
	Для Каждого ТекущаяСтрока Из ТЗПерваяПопытка Цикл
		УстановитьДатуНачалаПолучения(ТекущаяСтрока.Документ, ТекущаяДата);
	КонецЦикла;
	
	ПараметрыОбработчикаОжидания = Новый Структура;
	ПараметрыОбработчикаОжидания.Вставить("МаксимальноеКоличествоПопыток", 10);
	ПараметрыОбработчикаОжидания.Вставить("МинимальныйИнтервал", 1);
	ПараметрыОбработчикаОжидания.Вставить("МаксимальныйИнтервал", 10);
	ПараметрыОбработчикаОжидания.Вставить("КоэффициентУвеличенияИнтервала", 1.4);
	
	ТекущаяПопытка = 1;
	ТекущийИнтервал = ПараметрыОбработчикаОжидания.МинимальныйИнтервал;
	
	Пока Истина Цикл
		
		// Получаем QR коды
		СтрокиНаУдаление = Новый Массив;
		Для Каждого ТекущаяСтрока Из ТЗПерваяПопытка Цикл
			ОрганизацияДиадок = АвторизованнаяОрганизацияПоДокументу(ТекущаяСтрока.Документ);
			
			Успех = ПолучитьQRКод(ТекущаяСтрока.kl_id, ОрганизацияДиадок, ТекущаяСтрока.Документ, ТекущаяСтрока.ХешСуммаQRКода);
			
			Если Успех Тогда
				СтрокиНаУдаление.Добавить(ТекущаяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		// Удаляем строки с уже полученными кодами
		Для Каждого ТекущаяСтрока Из СтрокиНаУдаление Цикл
			ТЗПерваяПопытка.Удалить(ТекущаяСтрока);
		КонецЦикла;
		
		// Все получили, выходим
		Если ТЗПерваяПопытка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		// Максимальное количество попыток, выходим
		Если ТекущаяПопытка >= ПараметрыОбработчикаОжидания.МаксимальноеКоличествоПопыток Тогда
			Прервать;
		КонецЕсли;
		
		ТекущаяПопытка = ТекущаяПопытка + 1;
		
		// Расчитываем паузу
		ТекущийИнтервал = ТекущийИнтервал * ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала;
		Если ТекущийИнтервал > ПараметрыОбработчикаОжидания.МаксимальныйИнтервал Тогда
			ТекущийИнтервал = ПараметрыОбработчикаОжидания.МаксимальныйИнтервал;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияСервер.Пауза(ТекущийИнтервал);
		
	КонецЦикла;
	
КонецПроцедуры

Функция АвторизованнаяОрганизацияПоДокументу(Документ) Экспорт
	
	ОрганизацииУчастницы = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель КАК Грузоотправитель,
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Перевозчик КАК Перевозчик,
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузополучатель КАК Грузополучатель,
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПогрузкуОсуществляет КАК ПогрузкуОсуществляет,
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ЭкспедицияЗаказчик КАК ЭкспедицияЗаказчик,
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ВозвратПолучатель КАК ВозвратПолучатель,
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПереадресовкаИсходныйПолучатель КАК ПереадресовкаИсходныйПолучатель
		|ИЗ
		|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		|ГДЕ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка = &Документ";
		
		Выбокра = Запрос.Выполнить().Выбрать();
		Если Выбокра.Следующий() Тогда
			Если ЗначениеЗаполнено(Выбокра.Грузоотправитель) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.Грузоотправитель);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.Перевозчик) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.Перевозчик);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.Грузополучатель) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.Грузополучатель);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ПогрузкуОсуществляет) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ПогрузкуОсуществляет);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ЭкспедицияЗаказчик) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ЭкспедицияЗаказчик);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ВозвратПолучатель) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ВозвратПолучатель);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ПереадресовкаИсходныйПолучатель) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ПереадресовкаИсходныйПолучатель);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда	
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул1.ЛицоОформившееПЛ КАК ЛицоОформившееПЛ,		
		|	КонтурЛогистика_ПЛ_Титул1.ОрганизацияМедик КАК ОрганизацияМедик
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул1_5_02 КАК КонтурЛогистика_ПЛ_Титул1
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул1.Ссылка = &Документ";
		
		Выбокра = Запрос.Выполнить().Выбрать();
		Если Выбокра.Следующий() Тогда
			Если ЗначениеЗаполнено(Выбокра.ЛицоОформившееПЛ) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ЛицоОформившееПЛ);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ОрганизацияМедик) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ОрганизацияМедик);
			КонецЕсли;			
		КонецЕсли;	
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул1.ЛицоОформившееПЛ КАК ЛицоОформившееПЛ,
		|	КонтурЛогистика_ПЛ_Титул1.Грузоотправитель КАК Грузоотправитель,
		|	КонтурЛогистика_ПЛ_Титул1.ОрганизацияМедик КАК ОрганизацияМедик,
		|	КонтурЛогистика_ПЛ_Титул1.ОрганизацияТехСостояние КАК ОрганизацияТехСостояние,
		|	КонтурЛогистика_ПЛ_Титул1.ОрганизацияОдометр КАК ОрганизацияОдометр
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул1.Ссылка = &Документ";
		
		Выбокра = Запрос.Выполнить().Выбрать();
		Если Выбокра.Следующий() Тогда
			Если ЗначениеЗаполнено(Выбокра.ЛицоОформившееПЛ) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ЛицоОформившееПЛ);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.Грузоотправитель) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.Грузоотправитель);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ОрганизацияМедик) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ОрганизацияМедик);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ОрганизацияТехСостояние) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ОрганизацияТехСостояние);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выбокра.ОрганизацияОдометр) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ОрганизацияОдометр);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОрганизацииУчастницы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ТекущаяОрганизация Из ОрганизацииУчастницы Цикл
		ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ТекущаяОрганизация);
		Если ПараметрыСервисаЛогистика.АвторизацияВыполнена Тогда
			Возврат ТекущаяОрганизация;
		КонецЕсли;
	КонецЦикла;
	
	Возврат АвторизованнаяОрганизацияНаблюдатель(Документ);
	
КонецФункции

Функция АвторизованнаяОрганизацияНаблюдатель(Документ)
	
	ОрганизацииУчастницы = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла.ОрганизацияДиадок КАК ОрганизацияДиадок
		|ПОМЕСТИТЬ Итого
		|ИЗ
		|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла
		|		ПО КонтурЛогистика_ТрН_Титул1.Ссылка = КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла.Ссылка
		|ГДЕ
		|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ТрН_Титул7.НовГрузПол
		|ИЗ
		|	Документ.КонтурЛогистика_ТрН_Титул7 КАК КонтурЛогистика_ТрН_Титул7
		|ГДЕ
		|	КонтурЛогистика_ТрН_Титул7.ДокументЭТРН = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Итого.ОрганизацияДиадок КАК ОрганизацияДиадок
		|ИЗ
		|	Итого КАК Итого";
		
		Выбокра = Запрос.Выполнить().Выбрать();
		Если Выбокра.Следующий() Тогда
			Если ЗначениеЗаполнено(Выбокра.ОрганизацияДиадок) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ОрганизацияДиадок);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул1ДополнительныеПолучателиФайла.ОрганизацияДиадок КАК ОрганизацияДиадок
		|ПОМЕСТИТЬ Итого
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул1.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул1ДополнительныеПолучателиФайла
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул1ДополнительныеПолучателиФайла.Ссылка = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул2ДополнительныеПолучателиФайла.ОрганизацияДиадок
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул2.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул2ДополнительныеПолучателиФайла
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул2ДополнительныеПолучателиФайла.Ссылка.Титул1 = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул3ДополнительныеПолучателиФайла.ОрганизацияДиадок
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул3.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул3ДополнительныеПолучателиФайла
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул3ДополнительныеПолучателиФайла.Ссылка.Титул1 = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул4ДополнительныеПолучателиФайла.ОрганизацияДиадок
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул4.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул4ДополнительныеПолучателиФайла
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул4ДополнительныеПолучателиФайла.Ссылка.Титул1 = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул5ДополнительныеПолучателиФайла.ОрганизацияДиадок
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул5.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул5ДополнительныеПолучателиФайла
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул5ДополнительныеПолучателиФайла.Ссылка.Титул1 = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ПЛ_Титул6ДополнительныеПолучателиФайла.ОрганизацияДиадок
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул6.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ПЛ_Титул6ДополнительныеПолучателиФайла
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул6ДополнительныеПолучателиФайла.Ссылка.Титул1 = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Итого.ОрганизацияДиадок КАК ОрганизацияДиадок
		|ИЗ
		|	Итого КАК Итого
		|
		|СГРУППИРОВАТЬ ПО
		|	Итого.ОрганизацияДиадок";
		
		Выбокра = Запрос.Выполнить().Выбрать();
		Если Выбокра.Следующий() Тогда
			Если ЗначениеЗаполнено(Выбокра.ОрганизацияДиадок) Тогда
				ОрганизацииУчастницы.Добавить(Выбокра.ОрганизацияДиадок);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОрганизацииУчастницы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ТекущаяОрганизация Из ОрганизацииУчастницы Цикл
		ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ТекущаяОрганизация);
		Если ПараметрыСервисаЛогистика.АвторизацияВыполнена Тогда
			Возврат ТекущаяОрганизация;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьQRКод(Знач kl_id, ОрганизацияДиадок, ДокументСсылка, ХешСуммаQRКода)
	
	Если Не ЗначениеЗаполнено(kl_id) Тогда
		kl_id = КонтурЛогистика_Уведомления.ИдентификаторДокументаЛогистикиИзФайлов(ДокументСсылка);
	КонецЕсли;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияДиадок);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		ВызватьИсключение "Ни у одной из наших организаций не заполнена авторизация в Логистике";
	КонецЕсли;
	
	Попытка
		Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ДокументСсылка)
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда			
			Результат = КонтурЛогистика_API_Логистика.ПолучитьQRКодЭТрНGIFФайла(ПараметрыСервиса, kl_id);		
		ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ_5_02(ДокументСсылка) 
			И Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502() Тогда
			// До вступления в силу ЭПЛ 5.02 формируем тестовый код со строкой "Тестовая перевозка ЭПЛ 5.02"
			Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТестовыйQRКодДляЭПЛ502();		
		ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ДокументСсылка) Тогда
			Результат = КонтурЛогистика_API_Логистика.ПолучитьQRКодЭПЛGIFФайла(ПараметрыСервиса, kl_id);
		Иначе
			ВызватьИсключение "Не удалось определить тип документа";
		КонецЕсли;
	Исключение
		// Возникла ошибка или код еще не сформирован
		Результат = Неопределено;
		
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("kl_id", kl_id);
		КонтурЛогистика_Метрика.ОбработатьОшибку("ПолучитьQRКод", ИнформацияОбОшибке(), ДокументСсылка, ДопИнформация);
	КонецПопытки;
	
	Если ТипЗнч(Результат) <> Тип("ДвоичныеДанные") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НоваяХешСуммаQRКода = КонтурЛогистика_ОбщегоНазначенияСервер.ХешСумма(Результат);
	
	Если ХешСуммаQRКода = НоваяХешСуммаQRКода Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Запишем хеш-сумму в главный документ для дальнего определения формирования нового QR-кода (Т7 и Т8).
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.ХешСуммаQRКода = НоваяХешСуммаQRКода;
	ДокументОбъект.Записать();
	
	// Запишем двоичные данные кода в регистр.
	УстановитьДанныеКода(ДокументСсылка, Результат);
	
	Возврат Истина;
	
КонецФункции

Процедура ОтправитьQRКоды(Документы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ТелефоныДляОтправки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы", Документы);
	Запрос.УстановитьПараметр("ОтборПоДокументу", ЗначениеЗаполнено(Документы));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.Документ КАК Документ,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.ДанныеКода КАК ДанныеКода,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.Письмо КАК Письмо,
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.ТекстОшибки КАК ТекстОшибки
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ОчередьОтправкиQRКодов КАК КонтурЛогистика_ОчередьОтправкиQRКодов
	|ГДЕ
	|	КонтурЛогистика_ОчередьОтправкиQRКодов.КодПолучен
	|	И (&ОтборПоДокументу
	|				И КонтурЛогистика_ОчередьОтправкиQRКодов.Документ В (&Документы)
	|			ИЛИ НЕ &ОтборПоДокументу)
	|	И ПОДСТРОКА(КонтурЛогистика_ОчередьОтправкиQRКодов.ТекстОшибки, 1, 1) = """"";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	РеквизитыОтправителя = КонтурЛогистика_РаботаСПочтовымиСообщениями.РеквизитыОтправителя();
	
	Пока Выборка.Следующий() Цикл
		
		ДвоичныеДанные = Выборка.ДанныеКода.Получить();
		
		Если ИспользоватьОтправкуВТелеграм И Не ЗначениеЗаполнено(Выборка.ТекстОшибки) Тогда
			// Добавляем сообщение в очередь на отправку в Телеграм
			Телефоны = ДобавитьВОчередьQRКодВТелеграм(Выборка.Документ, ДвоичныеДанные);
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТелефоныДляОтправки, Телефоны, Истина);
		КонецЕсли;
		
		Если ИспользоватьОтправкуНаПочту Тогда
			
			ТекстОшибки = Неопределено;
			
			// Формируем письмо
			Письмо = Выборка.Письмо.Получить();
			
			Если Письмо <> Неопределено Тогда
				// Добавляем QR-код
				Вложение = Письмо.Вложения.Добавить(ДвоичныеДанные, "QR");
				Вложение.Идентификатор = "QR";
				Вложение.СпособКодирования = СпособКодированияИнтернетПочтовогоВложения.MIME;
				Вложение.ТипСодержимого = "image/gif";
				
				// Отправляем письмо
				Попытка
					ТекстОшибки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо, РеквизитыОтправителя);
				Исключение
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
				
			КонецЕсли;
			
			Если ТекстОшибки = Неопределено Тогда
				// Удаляем запись
				НаборЗаписей = СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Документ.Установить(Выборка.Документ);
				НаборЗаписей.Записать();
			Иначе
				// Запишем текст ошибки
				УстановитьТекстОшибки(Выборка.Документ, ТекстОшибки);
			КонецЕсли;
			
		Иначе
			
			// Удаляем запись
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Документ.Установить(Выборка.Документ);
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользоватьОтправкуВТелеграм И ТелефоныДляОтправки.Количество() > 0 Тогда
		// По добавленным сообщениям отправляем в Телеграм
		РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ОтправитьСообщения(ТелефоныДляОтправки);
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьВОчередьQRКодВТелеграм(Документ, ДвоичныеДанныеQRКода)
	
	ТелефоныДляОтправки = Новый Массив;
	
	// Данные для формирования письма
	ПараметрыОтправки = КонтурЛогистика_Уведомления.ДанныеПоДокументу(Документ);
	
	Если Не ЗначениеЗаполнено(ПараметрыОтправки.Телефон1) И Не ЗначениеЗаполнено(ПараметрыОтправки.Телефон2) Тогда
		Возврат ТелефоныДляОтправки;
	КонецЕсли;
	
	Сообщения = РегистрыСведений.КонтурЛогистика_ОчередьОтправкиQRКодов.СформироватьСообщенияВТелеграм(
		ПараметрыОтправки, ДвоичныеДанныеQRКода);
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.Телефон1) Тогда
		РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(ПараметрыОтправки.Телефон1, Сообщения);
		ТелефоныДляОтправки.Добавить(ПараметрыОтправки.Телефон1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.Телефон2) Тогда
		РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(ПараметрыОтправки.Телефон2, Сообщения);
		ТелефоныДляОтправки.Добавить(ПараметрыОтправки.Телефон2);
	КонецЕсли;
	
	Возврат ТелефоныДляОтправки;
	
КонецФункции

Функция ТемаПисьма(ПараметрыОтправки)
	
	// Пример: QR ЭТрН №445 от 25.08.2023 У654АП 99
	
	ТипДокументаСтрокой = ТипДокументаСтрокой(ПараметрыОтправки.Документ);
	
	ШаблонТемыПисьма = "QR %1 №%2 от %3 %4";
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонТемыПисьма,
		ТипДокументаСтрокой,
		СокрЛП(ПараметрыОтправки.НомерДокумента),
		Формат(ПараметрыОтправки.ДатаДокумента, "ДЛФ=D;"),
		ПараметрыОтправки.ГосНомерАвто);
	
КонецФункции

