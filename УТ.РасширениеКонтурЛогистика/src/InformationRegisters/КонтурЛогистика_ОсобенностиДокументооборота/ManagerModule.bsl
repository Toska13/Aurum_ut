#Область ПрограммныйИнтерфейс

Процедура УстановитьОсобенность(Документ, Особенность, Период = Неопределено) Экспорт
	
	Если Период = Неопределено Тогда
		Период = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Период);
	НаборЗаписей.Отбор.Документ.Установить(Документ);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ТекущаяЗапись = НаборЗаписей.Добавить();
		ТекущаяЗапись.Период = Период;
		ТекущаяЗапись.Документ = Документ;
	Иначе
		ТекущаяЗапись = НаборЗаписей[0];
	КонецЕсли;
	
	ТекущаяЗапись.Особенность = Особенность;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьОсобенность(Документ, Период = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Период", Период);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсобенностиДокументооборотаСрезПоследних.Особенность КАК Особенность
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ОсобенностиДокументооборота.СрезПоследних(&Период, Документ = &Документ) КАК ОсобенностиДокументооборотаСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Особенность;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти