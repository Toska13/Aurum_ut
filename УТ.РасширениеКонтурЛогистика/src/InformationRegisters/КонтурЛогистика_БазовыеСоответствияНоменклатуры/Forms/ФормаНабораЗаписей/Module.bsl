
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") И ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		
		ЭлементОтбора = НаборЗаписей.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = Параметры.Номенклатура;
		
		Если Параметры.Свойство("Характеристика") И ЗначениеЗаполнено(Параметры.Характеристика) Тогда
			
			ЭлементОтбора = НаборЗаписей.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Характеристика");
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ПравоеЗначение = Параметры.Характеристика;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Параметры.Свойство("Сопоставление", Сопоставление) Тогда
		
		Элементы.НаборЗаписейВыбратьЗапись.Видимость = Ложь;
		Элементы.ДекорацияОписание.Видимость = Ложь;
		
	КонецЕсли;
	
	ОбновитьОтображениеПоГруппамДоступа();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеПоГруппамДоступа()
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	Если ДоступыПользователя.ПолныйДоступ Тогда
		Возврат;
	КонецЕсли;
	
	// Механизмы
	ДоступКМеханизмам = ДоступыПользователя.ДоступКМеханизмам;
	
	МеханизмСоответствия = Перечисления.КонтурЛогистика_ВидыМеханизмов.СоответствияНоменклатуры;
	ТолькоПросмотрЭлементов = ДоступКМеханизмам.ТолькоПросмотр.Получить(МеханизмСоответствия);
	СозданиеРедактированиеЭлементов = ДоступКМеханизмам.СозданиеРедактирование.Получить(МеханизмСоответствия);
	
	Если Не ТолькоПросмотрЭлементов И Не СозданиеРедактированиеЭлементов Тогда
		ВызватьИсключение "У вас нет доступа. Обратитесь к администратору.";
	КонецЕсли;
	
	Элементы.НаборЗаписей.ТолькоПросмотр = ТолькоПросмотрЭлементов;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗапись(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры
