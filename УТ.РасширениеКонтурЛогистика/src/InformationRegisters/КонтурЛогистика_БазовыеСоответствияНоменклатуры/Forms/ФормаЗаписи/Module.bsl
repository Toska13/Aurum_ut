&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") И ЗначениеЗаполнено(Параметры.Номенклатура) Тогда 
		Запись.Номенклатура = Параметры.Номенклатура;
		
		Запись.ОтгрузочноеНаименование =  Запись.Номенклатура.Наименование;
		Запись.СостояниеГруза	=  "Без замечаний";
		Запись.СпособУпаковки 	=  "В таре";
		Запись.ВидТары 			=  Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду("CT");
	КонецЕсли;
	
	Если Параметры.Свойство("УпаковкаЕдиницаИзмерения") И ЗначениеЗаполнено(Параметры.УпаковкаЕдиницаИзмерения) Тогда 
		Запись.УпаковкаЕдиницаИзмерения = Параметры.УпаковкаЕдиницаИзмерения;
	КонецЕсли;
	
	Если Параметры.Свойство("Характеристика") И  ЗначениеЗаполнено(Параметры.Характеристика) Тогда 
		Запись.Характеристика = Параметры.Характеристика;
	КонецЕсли;
	
	// у заказа (заявки) еще доп. поля обязательны
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка") Тогда 
		
		Элементы.Высота.АвтоОтметкаНезаполненного = Истина;
		Элементы.Ширина.АвтоОтметкаНезаполненного = Истина;
		Элементы.Длина.АвтоОтметкаНезаполненного = Истина;
		Элементы.ОбъемКубМ.АвтоОтметкаНезаполненного = Истина;
		
	КонецЕсли;
	
	УстановитьТипы();
	
	ОбновитьОтображениеПоГруппамДоступа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипы()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьОграниченияТипа("Номенклатура" , Элементы.Номенклатура);
	КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьОграничениеТипаЕдиницИзмерения(Элементы.УпаковкаЕдиницаИзмерения);
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьВидимостьХарактеристик(Элементы.Характеристика);
	
	Если Элементы.Характеристика.Видимость Тогда
		КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьОграниченияТипа("Характеристика" , Элементы.Характеристика);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Декорация1Нажатие(Элемент)
	КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Товары с одинаковым описанием будут свернуты в 1 строку (если другие реквизиты это позволят)");
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияНачалоВыбораЗавершение(ВыбранноеЗначение, ДопПараметр = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВыбранноеЗначение.Значение)  Тогда
		Запись.УпаковкаЕдиницаИзмерения = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьБазовуюЕдиницуИзмерения(Запись.Номенклатура);
    иначе
        Запись.УпаковкаЕдиницаИзмерения = ВыбранноеЗначение.Значение;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УпаковкаЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	КонтурЛогистика_ОбщегоНазначенияКлиент.ЕдиницаИзмеренияНачалоВыбора(Запись.Номенклатура, Элемент, ЭтаФорма, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	КонтурЛогистика_ОбщегоНазначенияКлиент.ХарактеристикаНачалоВыбора(Запись.Номенклатура, Запись.Характеристика, Элемент, ЭтаФорма, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаНачалоВыбораЗавершение(ВыбранноеЗначение, ДопПараметр = Неопределено) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено И ЗначениеЗаполнено(ВыбранноеЗначение.Значение)  Тогда
		
		Если ТипЗнч(ВыбранноеЗначение.Значение) = Тип("Структура") Тогда
			Запись.Характеристика = ВыбранноеЗначение.Значение.Значение;
		Иначе 
			Запись.Характеристика = ВыбранноеЗначение.Значение;
		КонецЕсли;
		
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НасыпнойПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ГруппаКоэффициентПересчетаМест.Доступность = Не Запись.Насыпной;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеПоГруппамДоступа()
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	Если ДоступыПользователя.ПолныйДоступ Тогда
		Возврат;
	КонецЕсли;
	
	// Механизмы
	ДоступКМеханизмам = ДоступыПользователя.ДоступКМеханизмам;
	
	МеханизмСоответствия = Перечисления.КонтурЛогистика_ВидыМеханизмов.СоответствияНоменклатуры;
	ТолькоПросмотрЭлементов = ДоступКМеханизмам.ТолькоПросмотр.Получить(МеханизмСоответствия);
	СозданиеРедактированиеЭлементов = ДоступКМеханизмам.СозданиеРедактирование.Получить(МеханизмСоответствия);
	
	Если Не ТолькоПросмотрЭлементов И Не СозданиеРедактированиеЭлементов Тогда
		ВызватьИсключение "У вас нет доступа. Обратитесь к администратору.";
	КонецЕсли;
	
	ЭтаФорма.ТолькоПросмотр = ТолькоПросмотрЭлементов;
	
КонецПроцедуры

&НаКлиенте
Процедура КоВсемСоответствиям(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Форма.ФормаНабораЗаписей",
		Новый Структура("Номенклатура", Запись.Номенклатура));
		
КонецПроцедуры

&НаКлиенте
Процедура ПлотностьПриИзменении(Элемент)
	
	Запись.Плотность = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОкруглитьПлотность(Запись.Плотность);
	
КонецПроцедуры
