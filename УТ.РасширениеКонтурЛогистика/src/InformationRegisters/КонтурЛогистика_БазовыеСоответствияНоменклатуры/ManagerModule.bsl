Функция КоличествоСоответствийНоменклатуры(СтруктураЗаписиОтбора) Экспорт

	ВыборкаПоНоменклатуре = РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Выбрать(СтруктураЗаписиОтбора);
	СоответствийПоНоменклатуре = 0;																												 
	Пока ВыборкаПоНоменклатуре.Следующий() Цикл 
		СоответствийПоНоменклатуре = СоответствийПоНоменклатуре + 1;
	КонецЦикла;
		
	Возврат СоответствийПоНоменклатуре;

КонецФункции

Функция КлючПервогоСоответствияНоменклатуры(СтруктураЗаписиОтбора) Экспорт

	Результат = Новый Структура();
	
	Результат.Вставить("Номенклатура", Неопределено);
	Результат.Вставить("УпаковкаЕдиницаИзмерения", Неопределено);
	Результат.Вставить("Характеристика", Неопределено);
	
	ВыборкаПоНоменклатуре = РегистрыСведений.КонтурЛогистика_БазовыеСоответствияНоменклатуры.Выбрать(СтруктураЗаписиОтбора);
	
	Если ВыборкаПоНоменклатуре.Следующий() Тогда  
		ЗаполнитьЗначенияСвойств(Результат, ВыборкаПоНоменклатуре);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции
