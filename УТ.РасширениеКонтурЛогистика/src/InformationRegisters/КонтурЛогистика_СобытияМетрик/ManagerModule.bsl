#Область ПрограммныйИнтерфейс

Функция ПоставитьСобытиеВОчередьНаОтправку(Событие, Топик) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.КонтурЛогистика_СобытияМетрик.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.ДатаСобытия	= ТекущаяДатаСеанса();
	МенеджерЗаписи.Топик 		= Топик;
	МенеджерЗаписи.Категория 	= Событие.Path.Category;
	МенеджерЗаписи.Действие 	= Событие.Path.Action;
	МенеджерЗаписи.Пользователь	= ПараметрыСеанса.ТекущийПользователь;
	
	МенеджерЗаписи.ID = Событие.id;
	МенеджерЗаписи.ClientInstanceId = Событие.ClientInstanceId;
	
	Если Событие.Session.Свойство("CustomSessionId") Тогда
		МенеджерЗаписи.CustomSessionId = Событие.Session.CustomSessionId;
	КонецЕсли;
	
	МенеджерЗаписи.ТелоЗапроса = КонтурЛогистика_Метрика.СформироватьТелоЗапросаПоСобытию(Событие);
	
	МенеджерЗаписи.Записать();
	
	Возврат МенеджерЗаписи.ТелоЗапроса;
	
КонецФункции

Функция ДеревоСобытийДляОтправки(IDСобытий = Неопределено) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СобытияМетрик.ID КАК ID,
	|	СобытияМетрик.Топик КАК Топик,
	|	СобытияМетрик.ТелоЗапроса КАК ТелоЗапроса
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СобытияМетрик КАК СобытияМетрик
	|ГДЕ
	|	НЕ СобытияМетрик.СобытиеДоставлено
	|	И СобытияМетрик.ID В(&IDСобытий)
	|ИТОГИ ПО
	|	Топик";
	
	Если IDСобытий = Неопределено Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И СобытияМетрик.ID В(&IDСобытий)", "");
	КонецЕсли;	
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("IDСобытий", IDСобытий);
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция ПолучитьТелоЗапросаПоID(ID) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СобытияМетрик.ТелоЗапроса
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СобытияМетрик КАК СобытияМетрик
	|ГДЕ
	|	СобытияМетрик.ID = &ID";
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Параметры.Вставить("ID", ID);
	
	ТелоЗапроса = "";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТелоЗапроса = Выборка.ТелоЗапроса;
	КонецЕсли;	
	
	Возврат ТелоЗапроса;
	
КонецФункции

Процедура ОбработатьРезультатОтправкиСобытия(IDСобытия, РезультатОтправки) Экспорт 
	
	НаборЗаписей = РегистрыСведений.КонтурЛогистика_СобытияМетрик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ID.Установить(IDСобытия);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() Тогда 
		
		ТекЗапись = НаборЗаписей[0];
		
		ТекЗапись.ТелоОтвета 			= РезультатОтправки.ТелоОтвета;
		ТекЗапись.СобытиеДоставлено 	= РезультатОтправки.Успешно;
		ТекЗапись.ЗапросВыполненУспешно = РезультатОтправки.ЗапросВыполненУспешно;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;	
	
КонецПроцедуры	

