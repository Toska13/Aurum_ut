#Область ОбработчикиСобытий

// Код процедур и функций
&НаКлиенте
Процедура ОтправитьМетрики(Команда)
	
	ОтправитьМетрикиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтправитьМетрикиНаСервере()
	
	IDСобытий = Новый Массив;
	
	Для Каждого Строка Из Элементы.Список.ВыделенныеСтроки Цикл 
		IDСобытий.Добавить(Строка.ID);
	КонецЦикла;
	
	КонтурЛогистика_Метрика.ОтправитьМетрики(IDСобытий);
	
КонецПроцедуры

#КонецОбласти

