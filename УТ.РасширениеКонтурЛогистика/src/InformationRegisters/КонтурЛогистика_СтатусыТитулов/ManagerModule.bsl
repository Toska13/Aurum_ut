#Область ПрограммныйИнтерфейс

Функция ПолучитьСтатус(Документ, ЧерновикДляПустого = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик;
	КонецЕсли;
	
	СрезПоследних = СрезПоследних(, Новый Структура("Документ", Документ));
	Если СрезПоследних.Количество() > 0 Тогда
		Возврат СрезПоследних[0].Статус;
	КонецЕсли;
		
	Если ЧерновикДляПустого Тогда
		Возврат Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПодробноеОписаниеОшибки(Документ) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПодробноеОписаниеОшибки", "");
	Результат.Вставить("КоличествоОшибок", 0);
	
	СрезПоследних = СрезПоследних(, Новый Структура("Документ", Документ));
	Если СрезПоследних.Количество() > 0 Тогда
		Результат.Вставить("ПодробноеОписаниеОшибки", СрезПоследних[0].ПодробноеОписаниеОшибки);
		Результат.Вставить("КоличествоОшибок", СрезПоследних[0].КоличествоОшибок);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтатусРасширенный(Документ) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик;
	КонецЕсли;
	
	СрезПоследних = СрезПоследних(, Новый Структура("Документ", Документ));
	Если СрезПоследних.Количество() > 0 Тогда
		Возврат СрезПоследних[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьСтатус(Документ, Статус, УказатьПользователя = Ложь, ПроверятьПоследовательностьСтатуса = Ложь, СтруктураОшибки = Неопределено) Экспорт
	
	СрезПоследних = СрезПоследних( , Новый Структура("Документ", Документ));
	
	Если СрезПоследних.Количество() = 0 
		Или СрезПоследних[0].Статус <> Статус 
		Или (ЗначениеЗаполнено(СтруктураОшибки) И Не ТакаяОшибкаЕсть(Документ, СтруктураОшибки)) Тогда
		
		Если ПроверятьПоследовательностьСтатуса = Истина 
			И СрезПоследних.Количество() > 0 
			И НовыйСтатусПредыдущийВЦепочке(СрезПоследних[0].Статус, Статус) = Истина Тогда
			
			ВызватьИсключение "Попытка установить более старый статус в цепочке статусов";
			
		КонецЕсли;
		
		Если Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки И ДокументОбработан(Документ) Тогда
			Возврат;	
		КонецЕсли;
		
		Запись = СоздатьМенеджерЗаписи();
		Запись.Документ = Документ;
		Запись.Период = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
		Запись.Статус = Статус;
		
		Если ЗначениеЗаполнено(СтруктураОшибки) Тогда
			
			Запись.ТипОшибки = СтруктураОшибки.ТипОшибки;
			Запись.КодОшибки = СтруктураОшибки.КодОшибки;
			Запись.ОписаниеОшибки = СтруктураОшибки.ОписаниеОшибки;
			Запись.ПодробноеОписаниеОшибки = СтруктураОшибки.ПодробноеОписаниеОшибки;
			
			Если СтруктураОшибки.Свойство("Количество") Тогда
				Запись.КоличествоОшибок = СтруктураОшибки.Количество;	
			КонецЕсли;
			
			ПредПериод = СрезПоследних[0].Период;
			Если ЗначениеЗаполнено(ПредПериод) И Запись.Период <= ПредПериод Тогда
				Запись.Период = ПредПериод + 1;
			КонецЕсли;
			
		КонецЕсли;
		
		Если УказатьПользователя = Истина Тогда
			
			Попытка
				
				Запись.Пользователь1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
				
			Исключение
				
				КонтурЛогистика_Метрика.Метрика_Отправить_Ошибку( , "УстановитьСтатус", ОписаниеОшибки(),
				"не смогли определить тек пользователя 1С");
				
			КонецПопытки;
		КонецЕсли;
		
		Запись.Записать();
		
		// Если требуется, то документ добавится в очередь на поиск/создание связанного документа
		Если ЗначениеЗаполнено(Документ) Тогда
			РегистрыСведений.КонтурЛогистика_СвязиДокументов.ДобавитьВОчередь(Документ);
		КонецЕсли;
		
	КонецЕсли;
	
	// вызовем ПМ для кастомных завершающих действий с документом типовой конфишурации
	Если Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
		ИЛИ Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен Тогда 
		
		КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"ПослеЗавершенияРаботыСТитулом",
			Ложь,
			Новый Структура("Документ,Статус", Документ, Статус));
			
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЧерновикДляНовогоДокумента(ДокументСсылка) Экспорт

		// Статус Черновик для нового документа
	Если Не ДокументСсылка.ПометкаУдаления Тогда
		
		ТекСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументСсылка, Ложь);
		Если Не ЗначениеЗаполнено(ТекСтатус) Тогда 
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументСсылка, 
										Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик, Истина, Истина);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьСтатусыДокументам(МассивДокументов, НовыйСтатус, УказатьПользователя = Ложь, ПроверятьПоследовательностьСтатуса = Ложь) Экспорт
	
	Попытка
		
		Для Каждого Документ Из МассивДокументов Цикл
			
			УстановитьСтатус(Документ, НовыйСтатус, УказатьПользователя, ПроверятьПоследовательностьСтатуса);
			
		КонецЦикла;
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось изменить статус документа по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
КонецПроцедуры 

Функция ТакаяОшибкаЕсть(Документ, СтруктураОшибки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СтатусыТитулов.Документ КАК Документ,
		|	КонтурЛогистика_СтатусыТитулов.Статус КАК Статус,
		|	КонтурЛогистика_СтатусыТитулов.КодОшибки КАК КодОшибки
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СтатусыТитулов КАК КонтурЛогистика_СтатусыТитулов
		|ГДЕ
		|	КонтурЛогистика_СтатусыТитулов.Документ = &Документ
		|	И КонтурЛогистика_СтатусыТитулов.ТипОшибки = &ТипОшибки
		|	И КонтурЛогистика_СтатусыТитулов.Статус = &Статус
		|	И КонтурЛогистика_СтатусыТитулов.КодОшибки = &КодОшибки";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("КодОшибки", СтруктураОшибки.КодОшибки);
	Запрос.УстановитьПараметр("Статус", Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка);
	Запрос.УстановитьПараметр("ТипОшибки", СтруктураОшибки.ТипОшибки);
	    
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Пока РезультатЗапроса.Количество() > 0 Цикл
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ДокументОбработан(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СтатусыТитулов.Документ КАК Документ,
		|	КонтурЛогистика_СтатусыТитулов.Статус КАК Статус,
		|	КонтурЛогистика_СтатусыТитулов.КодОшибки КАК КодОшибки
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СтатусыТитулов КАК КонтурЛогистика_СтатусыТитулов
		|ГДЕ
		|	КонтурЛогистика_СтатусыТитулов.Документ = &Документ
		|	И КонтурЛогистика_СтатусыТитулов.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	    
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Пока РезультатЗапроса.Количество() > 0 Цикл
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДоверятьМЧД(ОтпечатокСертификата, КомуВыданСертификат, МЧД, ОшибкиМЧД) Экспорт
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
	
		КонтурЛогистика_МашиночитаемыеДовернностиСервер.ДобавитьДоверенныеСертификаты(МЧД, ОтпечатокСертификата, КомуВыданСертификат, ОшибкиМЧД);
		
		УдалитьОшибкиМЧД(ОтпечатокСертификата, МЧД, ОшибкиМЧД);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Доверять МЧД
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение.Сообщить();
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Изменения не зафиксированы";
		Сообщение.Сообщить();
				
	КонецПопытки;
			
КонецПроцедуры

Процедура УдалитьОшибкиМЧД(ОтпечатокСертификата, МЧД, ОшибкиМЧД) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Игнорируем ошибки МЧД";
	Сообщение.Сообщить();
	
	КодОшибкиПолномочияМЧД = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент КАК СвязанныйДокумент,
		|	КонтурЛогистика_СтатусыТитулов.Период КАК Период,
		|	КонтурЛогистика_СтатусыТитулов.Статус КАК Статус
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов КАК КонтурЛогистика_СтатусыТитулов
		|		ПО КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = КонтурЛогистика_СтатусыТитулов.Документ
		|ГДЕ
		|	КонтурЛогистика_ФайлыОбмена.ИдентификаторМЧД = &ИдентификаторМЧД
		|	И КонтурЛогистика_ФайлыОбмена.Отпечаток = &Отпечаток";
	
	Если ОшибкиМЧД = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД() Тогда
		Запрос.Текст = Запрос.Текст +
			"	И КонтурЛогистика_СтатусыТитулов.КодОшибки = &КодОшибкиПолномочияМЧД";
		
	Иначе
		Запрос.Текст = Запрос.Текст +
			"	И КонтурЛогистика_ФайлыОбмена.ОшибкиПроверкиМЧД ПОДОБНО ""%"" + &ОшибкиПроверкиМЧД + ""%""
			|	И КонтурЛогистика_СтатусыТитулов.КодОшибки <> &КодОшибкиПолномочияМЧД";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
		"	И КонтурЛогистика_СтатусыТитулов.ТипОшибки = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД)
		|	И КонтурЛогистика_СтатусыТитулов.Период > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -7), ДЕНЬ)
		|ИТОГИ ПО
		|	СвязанныйДокумент";
	
	Запрос.УстановитьПараметр("ИдентификаторМЧД", МЧД.ИдентификаторДоверенности);
	Запрос.УстановитьПараметр("Отпечаток", ОтпечатокСертификата);
	Запрос.УстановитьПараметр("ОшибкиПроверкиМЧД", ОшибкиМЧД);
	Запрос.УстановитьПараметр("КодОшибкиПолномочияМЧД", КодОшибкиПолномочияМЧД);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокумент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокумент.Следующий() Цикл		
			
		ЕстьОшибки = Ложь;
		
		Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ВыборкаДокумент.СвязанныйДокумент) 
				ИЛИ КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ВыборкаДокумент.СвязанныйДокумент)
				ИЛИ КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(ВыборкаДокумент.СвязанныйДокумент) Тогда
				
			ВыборкаДетальныеЗаписи = ВыборкаДокумент.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		
					
					Запись = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.СоздатьМенеджерЗаписи();
					Запись.Период = ВыборкаДетальныеЗаписи.Период;
					Запись.Документ = ВыборкаДетальныеЗаписи.СвязанныйДокумент;
					Запись.Удалить();
					
					ЕстьОшибки = Истина;			
								
			КонецЦикла;
				
		КонецЕсли;
		
		Если ЕстьОшибки Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Строка(ВыборкаДокумент.СвязанныйДокумент);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЦикла;
		
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Игнорирование ошибок МЧД завершено";
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// возвращает признак верной очередности нового статуса в соотв. с ожидаемым порядком в графе статусов
Функция НовыйСтатусПредыдущийВЦепочке(ТекСтатус, НовыйСтатус)
	
	НовыйСтатусПозднееВЦепочке = Истина; // дефолтно - все плохо
	
	// статусы РаботаЗавершенаРаспечатан и РаботаЗавершена и РаботаЗавершенаОтказВПодписи равнозначны,
	// поэтому можем переходить из одного статуса в другой
	МассивСтатусовЗавершен = Новый Массив;
	МассивСтатусовЗавершен.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан);
	МассивСтатусовЗавершен.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи);
	МассивСтатусовЗавершен.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена);
	
	Если Не МассивСтатусовЗавершен.Найти(ТекСтатус) = Неопределено 
		И Не МассивСтатусовЗавершен.Найти(НовыйСтатус) = Неопределено Тогда  
		Возврат Не НовыйСтатусПозднееВЦепочке;
	КонецЕсли;	
	
	МассивМодельПоследовательностиСтатусов = Новый Массив;
	
	// костыль: возможно отправлять подписанный после того как ранее был отрпавлен неподписанный
	Если НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
		И (ТекСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
			ИЛИ ТекСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан
			// костыль2: возможно подписывать сформированный, если при подписании была ошибка
			ИЛИ ТекСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена) 
			Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекСтатус) И ЗначениеЗаполнено(НовыйСтатус) Тогда
	
		// ожидаемая модель цепочки состояний Документа	(последовательность Элементов в массиве)
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке);

		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена);
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Подписан);
						
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан);
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи);
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена);
			
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен); // Пропускать можно из любого статуса
		МассивМодельПоследовательностиСтатусов.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Удален); // Удалять можно из любого статуса
		
		// ошибка - нет в таблице, номер 0
		
		НомерНовогоСтатуса = МассивМодельПоследовательностиСтатусов.Найти(НовыйСтатус);
		Если НомерНовогоСтатуса = Неопределено Тогда
			НомерНовогоСтатуса = 0;
		КонецЕсли;
		
		НомерТекущегоСтатуса = МассивМодельПоследовательностиСтатусов.Найти(ТекСтатус);
		Если НомерТекущегоСтатуса = Неопределено Тогда
			НомерТекущегоСтатуса = 0;
		КонецЕсли;
		
		Если НомерНовогоСтатуса > 0 И НомерНовогоСтатуса < НомерТекущегоСтатуса Тогда
			НовыйСтатусПозднееВЦепочке = Ложь; // устанавливаемый статус не ожидается в цепочке
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НЕ НовыйСтатусПозднееВЦепочке;

КонецФункции

#КонецОбласти
