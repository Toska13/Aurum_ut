////////////////////////////////////////////////////////////////////////////////
// Хранение данных аутентификации
//
// Храним данные только одной учетной записи для одной организации.
//
// Хранение токенов:
//   ТокенДоступа - храним в безопасном хранилище, где
//     * Владелец - КонтурЛогистика_ОрганизацииДиадок
//     * Данные   - токен доступа
//     * Ключ     - "ТокенДоступа"
//   ТокенОбновления - храним в безопасном хранилище, где
//     * Владелец - КонтурЛогистика_ОрганизацииДиадок
//     * Данные   - токен обновления
//     * Ключ     - "ТокенОбновления"
//

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выбирает сессии из хранилища.
//
// Параметры:
//   Отбор - Структура - см. Авторизатор.ОтборСессий
//
// Возвращаемое значение:
//   ВыборкаИзРезультатаЗапроса - выборка с данными сессий.
Функция ВыбратьСессии(Отбор) Экспорт
	
	Организация = Отбор.КлючОбъекта;
	
	Если Организация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка() Тогда
		ВладелецДанных = "ОрганизацияПустаяСсылка";
	Иначе
		ВладелецДанных = Организация;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ТокеныДоступа = КонтурЛогистика_ОбщегоНазначенияСервер.ПрочитатьДанныеИзБезопасногоХранилища(
		ВладелецДанных, "ТокенДоступа, ТокенОбновления");
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ТокеныДоступа = Неопределено Тогда
		ТокенДоступа = "";
		ТокенОбновления = "";
	Иначе
		ТокенДоступа = ТокеныДоступа["ТокенДоступа"];
		ТокенОбновления = ТокеныДоступа["ТокенОбновления"];
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТокенДоступа", ТокенДоступа);
	Запрос.УстановитьПараметр("ТокенОбновления", ТокенОбновления);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_Аутентификация.Организация КАК Организация,
	|	&ТокенДоступа КАК ТокенДоступа,
	|	&ТокенОбновления КАК ТокенОбновления,
	|	КонтурЛогистика_Аутентификация.ДатаОкончания КАК ДатаОкончания,
	|	КонтурЛогистика_Аутентификация.ВремяЖизни КАК ВремяЖизни,
	|	КонтурЛогистика_Аутентификация.УниверсальнаяДатаОкончания КАК УниверсальнаяДатаОкончания,
	|	КонтурЛогистика_Аутентификация.УниверсальнаяДатаОкончанияМС КАК УниверсальнаяДатаОкончанияМС,
	|	КонтурЛогистика_Аутентификация.Тип КАК Тип,
	|	КонтурЛогистика_Аутентификация.ПортальныйИд КАК ПортальныйИд,
	|	КонтурЛогистика_Аутентификация.Имя КАК Имя,
	|	КонтурЛогистика_Аутентификация.Фамилия КАК Фамилия,
	|	КонтурЛогистика_Аутентификация.Отчество КАК Отчество,
	|	КонтурЛогистика_Аутентификация.ФИО КАК ФИО,
	|	КонтурЛогистика_Аутентификация.Телефон КАК Телефон,
	|	КонтурЛогистика_Аутентификация.Почта КАК Почта
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_Аутентификация КАК КонтурЛогистика_Аутентификация
	|ГДЕ
	|	КонтурЛогистика_Аутентификация.Организация = &Организация";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Сохраняет сессию в хранилище общих настроек
//
// Параметры:
//	Отбор 	- Структура - см. Авторизатор.ОтборСессий
//	Сессия	- Структура - см. Авторизатор.МодельОтветТокен
//			Если указан пользователь, не являющийся текущим пользователем, 
//			т.е. делается попытка обратиться к настройкам, не принадлежащим текущему пользователю, 
//			то требуется наличие у текущего пользователя права АдминистрированиеДанных.
//
Процедура СохранитьСессию(Отбор, Сессия) Экспорт
	
	Организация = Отбор.КлючОбъекта;
	
	Если Организация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка() Тогда
		ВладелецДанных = "ОрганизацияПустаяСсылка";
	Иначе
		ВладелецДанных = Организация;
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Организация = Организация;
	
	ЗаполнитьЗначенияСвойств(НоваяЗапись, Сессия);
	
	// Запишем токены
	УстановитьПривилегированныйРежим(Истина);
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаписатьДанныеВБезопасноеХранилище(
		ВладелецДанных, Сессия.ТокенДоступа, "ТокенДоступа");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаписатьДанныеВБезопасноеХранилище(
		ВладелецДанных, Сессия.ТокенОбновления, "ТокенОбновления");
	УстановитьПривилегированныйРежим(Ложь);
	
	НоваяЗапись.ДатаОкончания = МестноеВремя(НоваяЗапись.УниверсальнаяДатаОкончания);
	
	НаборЗаписей.Записать();
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Удаляет сессию в хранилище общих настроек
//
// Параметры:
//	Отбор 						- Структура - см. Авторизатор.ОтборСессий
//	УведомлятьАдминистратора 	- Булево - отправлять уведомление администратору
//
Процедура УдалитьСессию(Отбор, УведомлятьАдминистратора = Истина) Экспорт
	
	Организация = Отбор.КлючОбъекта;
	ДанныеПользователя = Новый Структура("ФИО, Телефон, Почта");
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() <> 0 Тогда
		ДанныеПользователя.ФИО = НаборЗаписей[0].ФИО;
		ДанныеПользователя.Телефон = НаборЗаписей[0].Телефон;
		ДанныеПользователя.Почта = НаборЗаписей[0].Почта;
	КонецЕсли;
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
	Если ЗначениеЗаполнено(Организация) И УведомлятьАдминистратора Тогда
		
		// Отправим уведомления администратору о разлогировании
		
		// Телефон
		КонтактыАдминистратора_Телефоны = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(
			"КонтактыАдминистратора_Телефоны");
		ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
		Если ЗначениеЗаполнено(КонтактыАдминистратора_Телефоны) И ИспользоватьОтправкуВТелеграм Тогда
			Телефоны = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(КонтактыАдминистратора_Телефоны, ";", Ложь);
			ПоставитьСообщениеВОчередьНаОтправкуВТелеграм(Телефоны, Организация, ДанныеПользователя);
		КонецЕсли;
		
		// Электронные адреса
		КонтактыАдминистратора_Адреса = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(
			"КонтактыАдминистратора_АдресаЭлектронныхПочт");
		ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
		Если ЗначениеЗаполнено(КонтактыАдминистратора_Адреса) И ИспользоватьОтправкуНаПочту Тогда
			ОтправитьСообщениеНаАдресЭлектроннойПочты(КонтактыАдминистратора_Адреса, Организация, ДанныеПользователя);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Подменяет общую аутентификацию под конкретные организации
//
// Параметры:
//  ОрганизацииПодмены	 - Массив	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок
//
Процедура ПодменитьОбщуюАутентификациюПодКонкретные(ОрганизацииПодмены) Экспорт
	
	Если ОрганизацииПодмены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Найдем общую запись и токены
	НаборЗаписейОбщей = СоздатьНаборЗаписей();
	НаборЗаписейОбщей.Отбор.Организация.Установить(Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка());
	НаборЗаписейОбщей.Прочитать();
	
	Если НаборЗаписейОбщей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТокеныДоступа = КонтурЛогистика_ОбщегоНазначенияСервер.ПрочитатьДанныеИзБезопасногоХранилища(
		"ОрганизацияПустаяСсылка", "ТокенДоступа, ТокенОбновления");
	Если ТокеныДоступа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбщаяЗапись = НаборЗаписейОбщей[0];
	ТокенДоступа = ТокеныДоступа["ТокенДоступа"];
	ТокенОбновления = ТокеныДоступа["ТокенОбновления"];
	
	// Установим для каждой организации
	Для Каждого ТекущаяОрганизация Из ОрганизацииПодмены Цикл
		
		НаборЗаписейТекущий = СоздатьНаборЗаписей();
		НаборЗаписейТекущий.Отбор.Организация.Установить(ТекущаяОрганизация);
		
		НоваяЗапись = НаборЗаписейТекущий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ОбщаяЗапись);
		НоваяЗапись.Организация = ТекущаяОрганизация;
		
		// Запишем токены
		КонтурЛогистика_ОбщегоНазначенияСервер.ЗаписатьДанныеВБезопасноеХранилище(
			ТекущаяОрганизация, ТокенДоступа, "ТокенДоступа");
		КонтурЛогистика_ОбщегоНазначенияСервер.ЗаписатьДанныеВБезопасноеХранилище(
			ТекущаяОрганизация, ТокенОбновления, "ТокенОбновления");
		
		НаборЗаписейТекущий.Записать();
		
	КонецЦикла;
	
	// Очистим общую
	НаборЗаписейОбщей.Очистить();
	НаборЗаписейОбщей.Записать();
	
КонецПроцедуры

// Данные аутентификации по организации
//
// Параметры:
//  Организация	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - организация.
//  boxID		 - Строка	 - boxID организации.
// 
// Возвращаемое значение:
//  Структура - состоит из:
//   * Успех         - Булево - признак успеха
//   * ТокенДоступа  - Строка - токена доступа
//   * DiadocBoxId   - Строка - boxId организации
//   * Организация   - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - организация под которой идет аутентификация
//   * ДатаОкончания - Дата - дата окончания действия токена
//   * ФИО           - Строка - ФИО пользователя
//   * ПортальныйИд  - Строка - портальный ИД
//
Функция ДанныеАутентификацииПоОрганизации(Знач Организация = Неопределено, Знач boxID = Неопределено) Экспорт
	
	ДанныеАутентификации = Новый Структура;
	ДанныеАутентификации.Вставить("Успех", Ложь);
	ДанныеАутентификации.Вставить("ТокенДоступа");
	ДанныеАутентификации.Вставить("DiadocBoxId");
	ДанныеАутентификации.Вставить("Организация");
	ДанныеАутентификации.Вставить("ДатаОкончания");
	ДанныеАутентификации.Вставить("ФИО");
	ДанныеАутентификации.Вставить("ПортальныйИд");
	
	Если Не ЗначениеЗаполнено(Организация) И Не ЗначениеЗаполнено(boxID) Тогда
		Возврат ДанныеАутентификации;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЕстьОтборПоОрганизации", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("boxID", boxID);
	Запрос.УстановитьПараметр("ЕстьОтборПоboxID", ЗначениеЗаполнено(boxID));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_Аутентификация.Организация КАК Организация,
	|	КонтурЛогистика_Аутентификация.Организация.ID КАК DiadocBoxId,
	|	КонтурЛогистика_Аутентификация.ДатаОкончания КАК ДатаОкончания,
	|	КонтурЛогистика_Аутентификация.ФИО КАК ФИО,
	|	КонтурЛогистика_Аутентификация.ПортальныйИд КАК ПортальныйИд
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_Аутентификация КАК КонтурЛогистика_Аутентификация
	|ГДЕ
	|	(&ЕстьОтборПоОрганизации
	|				И КонтурЛогистика_Аутентификация.Организация = &Организация
	|			ИЛИ НЕ &ЕстьОтборПоОрганизации)
	|	И (&ЕстьОтборПоboxID
	|				И КонтурЛогистика_Аутентификация.Организация.ID = &boxID
	|			ИЛИ НЕ &ЕстьОтборПоboxID)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ДанныеАутентификации.DiadocBoxId = Выборка.DiadocBoxId;
		ДанныеАутентификации.Организация = Выборка.Организация;
		ДанныеАутентификации.ДатаОкончания = Выборка.ДатаОкончания;
		ДанныеАутентификации.ФИО = Выборка.ФИО;
		ДанныеАутентификации.ПортальныйИд = Выборка.ПортальныйИд;
		
		УстановитьПривилегированныйРежим(Истина);
		ТокеныДоступа = КонтурЛогистика_ОбщегоНазначенияСервер.ПрочитатьДанныеИзБезопасногоХранилища(
			Выборка.Организация, "ТокенДоступа");
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ТокеныДоступа <> Неопределено Тогда
			ДанныеАутентификации.ТокенДоступа = ТокеныДоступа["ТокенДоступа"];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеАутентификации;
	
КонецФункции

// Данные аутентификации по любой организации
//
// Возвращаемое значение:
//  Структура - состоит из:
//   * ТокенДоступа  - Строка - токена доступа
//   * DiadocBoxId   - Строка - boxId организации
//   * Организация   - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - организация под которой идет аутентификация
//   * ДатаОкончания - Дата - дата окончания действия токена
//
Функция ДанныеАутентификацииЛюбойОрганизации() Экспорт
	
	ДанныеАутентификации = Новый Структура;
	ДанныеАутентификации.Вставить("Успех", Ложь);
	ДанныеАутентификации.Вставить("ТокенДоступа");
	ДанныеАутентификации.Вставить("DiadocBoxId");
	ДанныеАутентификации.Вставить("Организация");
	ДанныеАутентификации.Вставить("ДатаОкончания");
	ДанныеАутентификации.Вставить("ФИО");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_Аутентификация.Организация КАК Организация,
	|	КонтурЛогистика_Аутентификация.Организация.ID КАК DiadocBoxId,
	|	КонтурЛогистика_Аутентификация.ДатаОкончания КАК ДатаОкончания,
	|	КонтурЛогистика_Аутентификация.ФИО КАК ФИО
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_Аутентификация КАК КонтурЛогистика_Аутентификация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ДанныеАутентификации.DiadocBoxId = Выборка.DiadocBoxId;
		ДанныеАутентификации.Организация = Выборка.Организация;
		ДанныеАутентификации.ДатаОкончания = Выборка.ДатаОкончания;
		ДанныеАутентификации.ФИО = Выборка.ФИО;
		
		Если Выборка.Организация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка() Тогда
			ВладелецДанных = "ОрганизацияПустаяСсылка";
		Иначе
			ВладелецДанных = Выборка.Организация;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		ТокеныДоступа = КонтурЛогистика_ОбщегоНазначенияСервер.ПрочитатьДанныеИзБезопасногоХранилища(
			ВладелецДанных, "ТокенДоступа");
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ТокеныДоступа <> Неопределено Тогда
			ДанныеАутентификации.ТокенДоступа = ТокеныДоступа["ТокенДоступа"];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеАутентификации;
	
КонецФункции

