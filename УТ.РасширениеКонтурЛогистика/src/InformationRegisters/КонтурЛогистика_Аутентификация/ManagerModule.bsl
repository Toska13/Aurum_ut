Процедура ПоставитьСообщениеВОчередьНаОтправкуВТелеграм(Телефоны, Организация, ДанныеПользователя)
	
	ТекстЗаголовка = "Требуется повторная авторизация в модуле Контур.Диадок.Логистика 1С";
	
	ФорматHTML = Ложь;
	ТекстСообщения = ТекстСообщенияОРазлогировании(ТекстЗаголовка, Организация, ДанныеПользователя, ФорматHTML);
	
	НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
	НовоеСообщение.Тип = "text";
	НовоеСообщение.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(ТекстСообщения);
	
	Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовоеСообщение);
	
	Для Каждого Телефон Из Телефоны Цикл
		РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(Телефон, Сообщения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправитьСообщениеНаАдресЭлектроннойПочты(Адреса, Организация, ДанныеПользователя)
	
	ТекстЗаголовка = "Требуется повторная авторизация в модуле Контур.Диадок.Логистика 1С";
	
	ФорматHTML = Истина;
	ТекстСообщения = ТекстСообщенияОРазлогировании(ТекстЗаголовка, Организация, ДанныеПользователя, ФорматHTML);
	
	ШаблонПисьма = ШаблонПисьмаHTML();
	ТекстПисьма = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонПисьма, ТекстСообщения);
	
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = ТекстЗаголовка;
	Письмо.Тексты.Добавить(ТекстПисьма, ТипТекстаПочтовогоСообщения.HTML);
	
	Получатели = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Адреса, ";", Ложь);
	Для Каждого Получатель Из Получатели Цикл
		Письмо.Получатели.Добавить(Получатель);
	КонецЦикла;
	
	Попытка
		
		ТекстОшибкиОтправки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
		
		Если ЗначениеЗаполнено(ТекстОшибкиОтправки) Тогда
			ЗаписьЖурналаРегистрации("КонтурЛогистика_Аутентификация",
				УровеньЖурналаРегистрации.Ошибка,, Организация, ТекстОшибкиОтправки);
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибкиОтправкиПочты = "Аутентификация: " + Строка(ДанныеПользователя.ФИО) + "
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, Организация, ТекстОшибкиОтправкиПочты);
		
	КонецПопытки;
	
КонецПроцедуры

Функция ТекстСообщенияОРазлогировании(ТекстЗаголовка, Организация, ДанныеПользователя, ФорматHTML)
	
	Попытка
		ИмяБазыДанных = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
		Если Не ЗначениеЗаполнено(ИмяБазыДанных) Тогда
			ИмяБазыДанных = СтрокаСоединенияИнформационнойБазы();
		КонецЕсли;
	Исключение
		ИмяБазыДанных = "<не удалось получить>";
	КонецПопытки;
	
	
	ШаблонСтрокиСсылки = "<a href=""%1"">%2</a>";
	Если ФорматHTML Тогда
		ШаблонЗаголовка = "<b>%1</b>";
		ШаблонСтроки = "<tr><th>%1</th><td>%2</td></tr>";
		ШаблонСтрокиДопИнформации = "<p>%1</p>";
	Иначе
		ШаблонЗаголовка = "<b>%1</b>";
		ШаблонСтроки = "<b><u>%1:</u></b> %2";
		ШаблонСтрокиДопИнформации = "<i>%1</i>";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	// Заголовок для Телеграм
	Если Не ФорматHTML Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка, ТекстЗаголовка));
	КонецЕсли;
	
	// Требуемое действие
	СсылкаАвторизации = "https://support.kontur.ru/logistika-1s/82041-avtorizaciya_v_module";
	
	ТекстСсылки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
		ШаблонСтрокиСсылки, СсылкаАвторизации, "Инструкция");
	ТекстТребуемоеДействие = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
		"Обмен с сервисом Диадок.Логистика для организации ""%1"" прекращен. Авторизуйтесь повторно в модуле 1С. "
		+ ТекстСсылки, Строка(Организация));
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
		?(ФорматHTML, "<br>", Символы.ПС) + ТекстТребуемоеДействие));
	
	// Начало таблицы
	Если ФорматHTML Тогда
		Строки.Добавить("<br><br>");
		Строки.Добавить("<table class=""table table-condensed"">");
		Строки.Добавить("<tbody>");
	КонецЕсли;
	
	// Организация
	ОтправительПредставление = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(Организация);
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки,
		?(ФорматHTML, "", Символы.ПС) + "Организация", ОтправительПредставление));
	
	// Представление пользователя
	ПредставлениеПользователя = ДанныеПользователя.ФИО;
	Если ЗначениеЗаполнено(ДанныеПользователя.Телефон) Или ЗначениеЗаполнено(ДанныеПользователя.Почта) Тогда
		
		ПредставлениеПользователя = ПредставлениеПользователя + " (";
		
		Если ЗначениеЗаполнено(ДанныеПользователя.Телефон) Тогда
			ПредставлениеПользователя = ПредставлениеПользователя + ДанныеПользователя.Телефон;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеПользователя.Почта) Тогда
			ПредставлениеПользователя = ПредставлениеПользователя
				+ ?(ЗначениеЗаполнено(ДанныеПользователя.Телефон), ", ", "")
				+ ДанныеПользователя.Почта;
		КонецЕсли;
		
		ПредставлениеПользователя = ПредставлениеПользователя + ")";
	КонецЕсли;
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки,
		?(ФорматHTML, "", Символы.ПС) + "Пользователь", ПредставлениеПользователя));
	
	// Путь к базе
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки,
		?(ФорматHTML, "", Символы.ПС) + "Путь к базе 1С", ИмяБазыДанных));
	
	// Конец таблицы
	Если ФорматHTML Тогда
		Строки.Добавить("</tbody></table>");
	КонецЕсли;
	
	ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	
	Возврат ТекстСообщения;
	
КонецФункции

