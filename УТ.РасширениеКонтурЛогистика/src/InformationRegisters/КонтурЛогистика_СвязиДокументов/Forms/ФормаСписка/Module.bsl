#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Период", Период);
	Параметры.Свойство("ОтборСтатус", ОтборСтатус);
	Параметры.Свойство("ОтборТипДокументаОсновной", ОтборТипДокументаОсновной);
	Параметры.Свойство("ОтборТипДокументаПодчиненный", ОтборТипДокументаПодчиненный);
	
	Если Параметры.Свойство("ОткрытСРабочегоСтола") Тогда
		Элементы.ОтборТипДокументаОсновной.ТолькоПросмотр = Истина;
		Элементы.ОтборТипДокументаПодчиненный.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Или Период.ДатаОкончания = Дата(1,1,1) Тогда
		Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтборы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	ОбновитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОчистка(Элемент, СтандартнаяОбработка)
	
	ОбновитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПериодВыбор(Элемент, ЭтаФорма, "ОбработчикВыборПериода");
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодВыбор(ЭлементФормы, КонтекстОбраотчика, ИмяОбработчика, ПараметрыОбработчика = Неопределено)
	
	МассивПериодов = Новый Массив;
	МассивПериодов.Добавить(Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня));
	МассивПериодов.Добавить(Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера));
	МассивПериодов.Добавить(Новый СтандартныйПериод(ВариантСтандартногоПериода.Завтра));
	МассивПериодов.Добавить(Новый СтандартныйПериод(ВариантСтандартногоПериода.Последние7Дней));
	МассивПериодов.Добавить(Новый СтандартныйПериод(ВариантСтандартногоПериода.ЭтаНеделя));
	МассивПериодов.Добавить(Новый СтандартныйПериод(ВариантСтандартногоПериода.ПрошлаяНеделя));
	
	Меню = Новый СписокЗначений;
	Для каждого ЭлементПериод Из МассивПериодов Цикл
		Меню.Добавить(ЭлементПериод, Строка(ЭлементПериод));
	КонецЦикла;
	
	Меню.Добавить(Новый СтандартныйПериод, НСтр("ru = 'Произвольный период'"));
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьИзСписка_КонтурЛогистика(
		Меню, ЭлементФормы, КонтекстОбраотчика, ИмяОбработчика, ПараметрыОбработчика)
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыборПериода(ВыбранноеЗначение, ДопПараметр = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение.Значение = Новый СтандартныйПериод Тогда
		
		Диалог = Новый ДиалогРедактированияСтандартногоПериода;
		Диалог.Период = ?(ТипЗнч(Период) = Тип("СтандартныйПериод"), Период, Новый СтандартныйПериод);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВыборПериода_КонтурЛогистика(Диалог, ЭтаФорма, "ПериодВыборПроизвольныйПериод"); 
		
	Иначе
		
		Период = ВыбранноеЗначение.Значение;
		ПериодПриИзменении();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодВыборПроизвольныйПериод(ВыбранноеЗначение, ДополнительныеДанные) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Период = ВыбранноеЗначение;
	ПериодПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент = Неопределено)
	
	Если Период.ДатаНачала = Дата(1,1,1) Тогда 
		Период.ДатаНачала = НачалоДня(ТекущаяДата()) - 7 * 24 * 3600;
	КонецЕсли;
	
	Если Период.ДатаОкончания = Дата(1,1,1) Тогда 
		Период.ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;
	
	ОбновитьОтборы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДокументОсновной"
		И ЗначениеЗаполнено(ТекущиеДанные.ДокументОсновной) Тогда
		
		СтандартнаяОбработка = Ложь;
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.ДокументОсновной);
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДокументПодчиненный"
		И ЗначениеЗаполнено(ТекущиеДанные.ДокументПодчиненный) Тогда
		
		СтандартнаяОбработка = Ложь;
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.ДокументПодчиненный);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обработать(Команда)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		ОбработатьСвязь(ДанныеСтроки.ТипДокументаОсновной, ДанныеСтроки.ТипДокументаПодчиненный, ДанныеСтроки.ДокументОсновной);
	КонецЦикла;
	
	Сообщить("Обработка завершена");
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтборы()
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Список, "ДатаНачала", Период.ДатаНачала, ЗначениеЗаполнено(Период.ДатаНачала));
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Список, "ДатаОкончания", Период.ДатаОкончания, ЗначениеЗаполнено(Период.ДатаОкончания));
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "Статус", ОтборСтатус,
		ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборСтатус));
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "ТипДокументаОсновной", ОтборТипДокументаОсновной,
		ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборТипДокументаОсновной));
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "ТипДокументаПодчиненный", ОтборТипДокументаПодчиненный,
		ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборТипДокументаПодчиненный));
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСвязь(ТипДокументаОсновной, ТипДокументаПодчиненный, ДокументОсновной)
	
	РегистрыСведений.КонтурЛогистика_СвязиДокументов.ОбработатьОчередь(ТипДокументаОсновной, ТипДокументаПодчиненный, ДокументОсновной);
	
КонецПроцедуры

#КонецОбласти