#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Процедура ДобавитьВОчередь(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипДокументаСтрокой = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(ДокументСсылка);
	ЛогистическийТип = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЛогистическийТипПоТипуДокумента(ТипДокументаСтрокой);
	
	// 1. Проверяем есть ли настройка связи документов для текущего документа
	НастройкиСвязейДокументов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НастройкиСвязиДокументов(ЛогистическийТип);
	Если НастройкиСвязейДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Проверим есть ли уже созданные связи по полученным настройкам из шага 1
	НетСвязейПоНастройкам = НетСвязейПоНастройкам(ДокументСсылка, НастройкиСвязейДокументов);
	
	// 3. Проверить возможность формирования связи по условиям из настроек связи и добавить в очередь
	Для Каждого ТекущаяНастройка Из НетСвязейПоНастройкам Цикл
		Если Не Справочники.КонтурЛогистика_НастройкиСвязейДокументов.НужноСоздатьСвязь(ДокументСсылка, ТекущаяНастройка) Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыНастройки = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ТекущаяНастройка, "ТипДокументаОсновной, ТипДокументаПодчиненный");
		
		// Поставим в очередь
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОсновной.Установить(ДокументСсылка);
		НаборЗаписей.Отбор.ТипДокументаОсновной.Установить(РеквизитыНастройки.ТипДокументаОсновной);
		НаборЗаписей.Отбор.ТипДокументаПодчиненный.Установить(РеквизитыНастройки.ТипДокументаПодчиненный);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДокументОсновной = ДокументСсылка;
		НоваяЗапись.ТипДокументаОсновной = РеквизитыНастройки.ТипДокументаОсновной;
		НоваяЗапись.ТипДокументаПодчиненный = РеквизитыНастройки.ТипДокументаПодчиненный;
		
		НоваяЗапись.Статус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.ВОчереди;
		НоваяЗапись.ДатаПостановкиВОчередь = ТекущаяДатаСеанса();
		
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьОчередь(ТипДокументаОсновной = Неопределено, ТипДокументаПодчиненный = Неопределено, ДокументОсновной = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ТипДокументаОсновной) И ЗначениеЗаполнено(ТипДокументаПодчиненный) И ЗначениеЗаполнено(ДокументОсновной) Тогда
		ЕстьОтбор = Истина;
	Иначе
		ЕстьОтбор = Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЕстьОтбор", ЕстьОтбор);
	Запрос.УстановитьПараметр("ТипДокументаОсновной", ТипДокументаОсновной);
	Запрос.УстановитьПараметр("ТипДокументаПодчиненный", ТипДокументаПодчиненный);
	Запрос.УстановитьПараметр("ДокументОсновной", ДокументОсновной);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_СвязиДокументов.ТипДокументаОсновной КАК ТипДокументаОсновной,
	|	КонтурЛогистика_СвязиДокументов.ТипДокументаПодчиненный КАК ТипДокументаПодчиненный,
	|	КонтурЛогистика_СвязиДокументов.ДокументОсновной КАК ДокументОсновной,
	|	КонтурЛогистика_СвязиДокументов.ДокументПодчиненный КАК ДокументПодчиненный,
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК НастройкаСвязи
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СвязиДокументов КАК КонтурЛогистика_СвязиДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|		ПО (КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного
	|				ИЛИ КонтурЛогистика_НастройкиСвязейДокументов.ВводитьНаОсновании)
	|			И КонтурЛогистика_СвязиДокументов.ТипДокументаОсновной = КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаОсновной
	|			И КонтурЛогистика_СвязиДокументов.ТипДокументаПодчиненный = КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаПодчиненный
	|ГДЕ
	|	КонтурЛогистика_СвязиДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыСвязейДокументов.ВОчереди)
	|	И (НЕ &ЕстьОтбор
	|			ИЛИ &ЕстьОтбор
	|				И КонтурЛогистика_СвязиДокументов.ТипДокументаОсновной = &ТипДокументаОсновной
	|				И КонтурЛогистика_СвязиДокументов.ТипДокументаПодчиненный = &ТипДокументаПодчиненный
	|				И КонтурЛогистика_СвязиДокументов.ДокументОсновной = &ДокументОсновной)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПараметрыСтатуса = МанифестПараметровСтатуса(Выборка.ТипДокументаОсновной, Выборка.ТипДокументаПодчиненный,
			Выборка.ДокументОсновной, Выборка.ДокументПодчиненный);
		
		// Проверим, что еще не создано
		Если ЗначениеЗаполнено(Выборка.ДокументПодчиненный) Тогда
			НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.РаботаЗавершена;
			УстановитьСтатус(ПараметрыСтатуса, НовыйСтатус);
			Продолжить;
		КонецЕсли;
		
		// Не нашли настройку связи
		Если Не ЗначениеЗаполнено(Выборка.НастройкаСвязи) Тогда
			НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.Ошибка;
			ТекстОшибки = "Не найдена настройка связей документов";
			УстановитьСтатус(ПараметрыСтатуса, НовыйСтатус, ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		// Получим подчиненный документ
		Попытка
			ДокументПодчиненный = Справочники.КонтурЛогистика_НастройкиСвязейДокументов.СформироватьНайтиПодчиненныйДокумент(
				Выборка.ДокументОсновной, Выборка.НастройкаСвязи);
		Исключение
			НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.Ошибка;
			ТекстОшибки = "Не удалось найти/сформировать подчиненный документ";
			ПодробноеОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			УстановитьСтатус(ПараметрыСтатуса, НовыйСтатус, ТекстОшибки, ПодробноеОписаниеОшибки);
			Продолжить;
		КонецПопытки;
		
		// Обновим статус обработки
		Если ЗначениеЗаполнено(ДокументПодчиненный) Тогда
			ПараметрыСтатуса.ДокументПодчиненный = ДокументПодчиненный;
			НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.РаботаЗавершена;
			УстановитьСтатус(ПараметрыСтатуса, НовыйСтатус);
		Иначе
			НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.Ошибка;
			ТекстОшибки = "Не удалось найти/сформировать подчиненный документ";
			УстановитьСтатус(ПараметрыСтатуса, НовыйСтатус, ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьСтатус(ПараметрыСтатуса, НовыйСтатус, ОписаниеОшибки = "", ПодробноеОписаниеОшибки = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТипДокументаОсновной.Установить(ПараметрыСтатуса.ТипДокументаОсновной);
	НаборЗаписей.Отбор.ТипДокументаПодчиненный.Установить(ПараметрыСтатуса.ТипДокументаПодчиненный);
	НаборЗаписей.Отбор.ДокументОсновной.Установить(ПараметрыСтатуса.ДокументОсновной);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ТекущаяЗапись = НаборЗаписей.Добавить();
		ТекущаяЗапись.ТипДокументаОсновной = ПараметрыСтатуса.ТипДокументаОсновной;
		ТекущаяЗапись.ТипДокументаПодчиненный = ПараметрыСтатуса.ТипДокументаПодчиненный;
		ТекущаяЗапись.ДокументОсновной = ПараметрыСтатуса.ДокументОсновной;
	Иначе
		ТекущаяЗапись = НаборЗаписей[0];
	КонецЕсли;
	
	ТекущаяЗапись.ДокументПодчиненный = ПараметрыСтатуса.ДокументПодчиненный;
	ТекущаяЗапись.Статус = НовыйСтатус;
	ТекущаяЗапись.ОписаниеОшибки = ОписаниеОшибки;
	ТекущаяЗапись.ПодробноеОписаниеОшибки = ПодробноеОписаниеОшибки;
	
	Если НовыйСтатус = Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.РаботаЗавершена Тогда
		ТекущаяЗапись.ДатаУстановкиСвязи = ТекущаяДатаСеанса();
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция МанифестПараметровСтатуса(ТипДокументаОсновной, ТипДокументаПодчиненный, ДокументОсновной, ДокументПодчиненный = Неопределено)
	
	ПараметрыСтатуса = Новый Структура;
	ПараметрыСтатуса.Вставить("ТипДокументаОсновной", ТипДокументаОсновной);
	ПараметрыСтатуса.Вставить("ТипДокументаПодчиненный", ТипДокументаПодчиненный);
	ПараметрыСтатуса.Вставить("ДокументОсновной", ДокументОсновной);
	ПараметрыСтатуса.Вставить("ДокументПодчиненный", ДокументПодчиненный);
	
	Возврат ПараметрыСтатуса;
	
КонецФункции

Функция СвязанныйДокумент(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("ТипДокументаОсновной, ТипДокументаПодчиненный, ДокументОсновной, ДокументПодчиненный,
		|Статус, ОписаниеОшибки, ПодробноеОписаниеОшибки, ДатаПостановкиВОчередь, ДатаУстановкиСвязи");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_СвязиДокументов.ТипДокументаОсновной КАК ТипДокументаОсновной,
	|	КонтурЛогистика_СвязиДокументов.ТипДокументаПодчиненный КАК ТипДокументаПодчиненный,
	|	КонтурЛогистика_СвязиДокументов.ДокументОсновной КАК ДокументОсновной,
	|	КонтурЛогистика_СвязиДокументов.ДокументПодчиненный КАК ДокументПодчиненный,
	|	КонтурЛогистика_СвязиДокументов.Статус КАК Статус,
	|	КонтурЛогистика_СвязиДокументов.ОписаниеОшибки КАК ОписаниеОшибки,
	|	КонтурЛогистика_СвязиДокументов.ПодробноеОписаниеОшибки КАК ПодробноеОписаниеОшибки,
	|	КонтурЛогистика_СвязиДокументов.ДатаПостановкиВОчередь КАК ДатаПостановкиВОчередь,
	|	КонтурЛогистика_СвязиДокументов.ДатаУстановкиСвязи КАК ДатаУстановкиСвязи
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СвязиДокументов КАК КонтурЛогистика_СвязиДокументов
	|ГДЕ
	|	КонтурЛогистика_СвязиДокументов.ДокументОсновной = &ДокументСсылка
	|	ИЛИ КонтурЛогистика_СвязиДокументов.ДокументПодчиненный = &ДокументСсылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СчетчикПоОтбору(Статус, Период, ТипДокументаОсновной, ТипДокументаПодчиненный) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Статус", Статус);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТипДокументаОсновной", ТипДокументаОсновной);
	Запрос.УстановитьПараметр("ТипДокументаПодчиненный", ТипДокументаПодчиненный);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК Ссылка,
	|	КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаПодчиненный КАК ТипДокументаПодчиненный,
	|	КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаОсновной КАК ТипДокументаОсновной
	|ПОМЕСТИТЬ НастройкиСвязейДокументов
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
	|	И (КонтурЛогистика_НастройкиСвязейДокументов.ВводитьНаОсновании
	|			ИЛИ КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного)
	|	И КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаОсновной = &ТипДокументаОсновной
	|	И КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаПодчиненный = &ТипДокументаПодчиненный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(КонтурЛогистика_СвязиДокументов.ДокументОсновной) КАК КоличествоСвязей
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СвязиДокументов КАК КонтурЛогистика_СвязиДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиСвязейДокументов КАК НастройкиСвязейДокументов
	|		ПО КонтурЛогистика_СвязиДокументов.ТипДокументаОсновной = НастройкиСвязейДокументов.ТипДокументаОсновной
	|			И КонтурЛогистика_СвязиДокументов.ТипДокументаПодчиненный = НастройкиСвязейДокументов.ТипДокументаПодчиненный
	|ГДЕ
	|	КонтурЛогистика_СвязиДокументов.Статус = &Статус
	|	И КонтурЛогистика_СвязиДокументов.ДатаПостановкиВОчередь МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоСвязей;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НетСвязейПоНастройкам(ДокументОсновной, НастройкиСвязейДокументов)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НетСвязейПоНастройкам = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОсновной", ДокументОсновной);
	Запрос.УстановитьПараметр("НастройкиСвязейДокументов", НастройкиСвязейДокументов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_СвязиДокументов.ДокументОсновной КАК ДокументОсновной,
	|	КонтурЛогистика_СвязиДокументов.ДокументПодчиненный КАК ДокументПодчиненный,
	|	КонтурЛогистика_СвязиДокументов.ТипДокументаОсновной КАК ТипДокументаОсновной,
	|	КонтурЛогистика_СвязиДокументов.ТипДокументаПодчиненный КАК ТипДокументаПодчиненный
	|ПОМЕСТИТЬ СуществующиеСвязи
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_СвязиДокументов КАК КонтурЛогистика_СвязиДокументов
	|ГДЕ
