#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИзменениеНомера") Тогда
		
		ФорматированнаяСтрока = Новый Массив;
		ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("Сотруднику необходимо самостоятельно изменить номер телефона в личном кабинете по ссылке "));
		ФорматированнаяСтрока.Добавить(Новый ФорматированнаяСтрока("https://cabinet.kontur.ru/",,,, "https://cabinet.kontur.ru/"));
		Элементы.Описание.Заголовок = Новый ФорматированнаяСтрока(ФорматированнаяСтрока);
		
		ЭтаФорма.Заголовок = "Изменение телефона";
		Элементы.ГруппаОсновное.Видимость = Ложь;
		
		Возврат;
		
	КонецЕсли;
	
	Параметры.Свойство("Сотрудник", Сотрудник);
	Параметры.Свойство("Организация", Организация);
	Параметры.Свойство("PersonId", PersonId);
	
	Если Параметры.Свойство("ОрганизацияВПриглашение") И ЗначениеЗаполнено(Параметры.ОрганизацияВПриглашение) Тогда
		Организация = Параметры.ОрганизацияВПриглашение;
	КонецЕсли;
	
	Элементы.Организация.ТолькоПросмотр = ЗначениеЗаполнено(Организация);
	Элементы.Сотрудник.ТолькоПросмотр = ЗначениеЗаполнено(Сотрудник);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Телефон = Сотрудник.ТелефонОсновной;
	КонецЕсли;
	
	Сценарий = Перечисления.КонтурЛогистика_СценарииПриглашенийФизическихЛиц.Водитель;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	Телефон = СокрЛП(Телефон);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Не заполнена организация");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Сообщить("Не заполнен сотрудник");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Сообщить("Не заполнен телефон");
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = КонтурЛогистика_СервисФизическихЛицСервер.ПроверитьДаныеПередОтправкойПриглашения(Организация, Сотрудник, Сценарий, Телефон);
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ВладелецФормы <> Неопределено И ЭтаФорма.ВладелецФормы.ИмяФормы = "Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаЭлемента" Тогда
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя("Добавление сотрудника", "Отправить приглашение", 
			"РегистрСведений.КонтурЛогистика_СервисФизическихЛиц.Форма.ФормаОтправкиПриглашения", "Сотрудник");
	Иначе
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя("Добавление сотрудника", "Отправить приглашение", 
			"РегистрСведений.КонтурЛогистика_СервисФизическихЛиц.Форма.ФормаОтправкиПриглашения", "Организация");
	КонецЕсли;
	
	Результат = КонтурЛогистика_СервисФизическихЛицСервер.ОтправитьПриглашение(Организация, Сотрудник, Сценарий, Телефон);
	
	Если Результат.ЕстьОшибка Тогда
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("PersonId", PersonId);
		
		DirectoryId = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Организация, "DirectoryId");
		ДопИнформация.Вставить("DirectoryId", DirectoryId);
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ОтправитьПриглашение", Результат.ОписаниеОшибки, Сотрудник, ДопИнформация);
	КонецЕсли;
	
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		ТелефонОсновной = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Сотрудник, "ТелефонОсновной");
		Телефон = ТелефонОсновной;
	Иначе
		Телефон = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ОтборРоль", "Водители");
	ПараметрыВыбора.Вставить("НеИзменятьОтборРоль", Истина);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_Сотрудники.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, ЭтаФорма, "ОбработчикВыбораСотрудника");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработчикВыбораСотрудника(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Сотрудник = ВыбранноеЗначение;
	
	СотрудникПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиКД = Новый НастройкиКомпоновкиДанных;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наш");
	ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСписка.ПравоеЗначение = Истина;
	ОтборСписка.Использование = Истина;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ФиксированныеНастройки", НастройкиКД);

	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, ЭтаФорма, "ОбработчикаВыбораОрганизации");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикаВыбораОрганизации(ВыбранноеЗначение, ДополнительныеПараметры) ЭКспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ВыбранноеЗначение;
	
КонецПроцедуры

#КонецОбласти

