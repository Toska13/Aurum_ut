#Область ПрограммныйИнтерфейс

Функция ОтправитьПриглашение(Организация, Сотрудник, Сценарий, Телефон, Статус = Неопределено, PersonId = Неопределено) Экспорт
	
	Результат = СоздатьФлИОтправитьПриглашение(Организация, Сотрудник, Сценарий, Телефон, Статус, PersonId);
	
	ДобавитьЗаписьВСервисФизическихЛиц(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьПриглашение(Организация, Сотрудник, СценарийПриглашения, PersonId, ПриглашениеПринято = Ложь) Экспорт
	
	Результат = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ПолучитьФизическоеЛицо(Организация, PersonId);
	
	Если Результат.ФизЛицоУдалено Тогда
		РеквизитыДляЗаписи = Новый Структура("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.Удалено);
	Иначе
		
		Если Результат.ФизЛицо.Свойство("UserId") И ЗначениеЗаполнено(Результат.ФизЛицо.UserId) 
			И ЗначениеЗаполнено(Сотрудник) 
			И ЗначениеЗаполнено(Организация)
			И ЗначениеЗаполнено(СценарийПриглашения) Тогда
			
			РеквизитыДляЗаписи = Новый Структура(
				"UserId, Статус", Результат.ФизЛицо.UserId, Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение);
			КонтурЛогистика_СервисФизическихЛицСервер.ИзменитьЗапись(Организация, Сотрудник, РеквизитыДляЗаписи);
			
			ПриглашениеПринято = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьФлИОтправитьПриглашение(Организация, Сотрудник, Сценарий, Телефон, Статус = Неопределено, Знач PersonId = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("Сотрудник", Сотрудник);
	Результат.Вставить("СценарийПриглашения", Сценарий);
	Результат.Вставить("Телефон", Телефон);
	Результат.Вставить("ЕстьОшибка", Ложь);
	
	Если ЗначениеЗаполнено(PersonId) Тогда
		
		Попытка
		
			Ответ = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ИзменитьФизическоеЛицо(Организация, Сотрудник, PersonId, Телефон);
			Результат.Вставить("PersonId", PersonId);
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Результат.Вставить("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеСоздано);
			Результат.Вставить("ОписаниеОшибки", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Результат.Вставить("ЕстьОшибка", Истина);
			
			Возврат Результат;
			
		КонецПопытки;
		
	ИначеЕсли Не ЗначениеЗаполнено(Статус) Или Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеСоздано Тогда
		
		Попытка
			
			Ответ = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.СоздатьФизическоеЛицо(Организация, Сотрудник, Телефон);
			
			PersonId = Ответ.Получить("id");
			Результат.Вставить("PersonId", PersonId);
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Результат.Вставить("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеСоздано);
			Результат.Вставить("ОписаниеОшибки", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Результат.Вставить("ЕстьОшибка", Истина);
			
			Возврат Результат;
			
		КонецПопытки;
		
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Статус) 
		Или Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеОтправленоПриглашение
		Или Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение Тогда
		
		Попытка
			
			Ответ = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ОтправитьПриглашение(Организация, PersonId, Сценарий);
			
			InviteId = Ответ.Получить("id");
			Результат.Вставить("InviteId", InviteId);
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Результат.Вставить("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеОтправленоПриглашение);
			Результат.Вставить("ОписаниеОшибки", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Результат.Вставить("ЕстьОшибка", Истина);
			
			Возврат Результат;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Результат.Вставить("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьЗаписьВСервисФизическихЛиц(Данные)
	
	Запись = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, Данные);
	
	Если Данные.Статус <> Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеСоздано Тогда
		ЗаполнитьЗначенияСвойств(Запись, Данные.Сотрудник);
	КонецЕсли;
	
	Запись.Записать();
	
КонецПроцедуры
 
#КонецОбласти