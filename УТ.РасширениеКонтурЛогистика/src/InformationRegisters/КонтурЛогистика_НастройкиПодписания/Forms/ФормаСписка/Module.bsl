
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекПользовательПродвинутый = (КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
		Или РольДоступна("КонтурЛогистика_НастройкаПодписания"));
	Если Не ТекПользовательПродвинутый Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("Сертификат") Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Сертификат");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		ЭлементОтбора.ПравоеЗначение = Параметры.Сертификат;
		
		СертификатОтбор = Параметры.Сертификат;
		
		Элементы.СертификатОтбор.Видимость = Истина;
		
	КонецЕсли;
	
	КонтурЛогистика_ОнбордингСервер.ПриСозданииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	ПодключитьОбработчикОжидания("ОткрытьОнбординг", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОнбординг()
	
	КонтурЛогистика_ОнбордингКлиент.ПриОткрытииФормы(ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	Оповестить("ВыполнитьПроверкуСертификатов");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ЗначениеЗаполнено(СертификатОтбор) Тогда
		
		Отказ = истина;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Сертификат", СертификатОтбор);
	
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
							"РегистрСведений.КонтурЛогистика_НастройкиПодписания.Форма.ФормаЗаписи",
							Параметрыформы,
							ЭтаФорма,
							ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтурЛогистикаПодключаемый_ВыполнитьКоманду(Команда)
	
    КонтурЛогистика_ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры