Процедура ДобавитьФильтрСоединениеПоОрганизации(ТекстЗапроса, ВариантФильтрации, ИмяПараметраСписка, ИмяРеквизита)
	
	Если ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.УказатьСписок Тогда
		
		ШаблонТекста = "
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОрганизацииДиадок КАК ВТ_ОрганизацииДиадок_%1
			|	ПО ВТ_ОрганизацииДиадок_%1.Ссылка В (&%2)
			|		И втДокументы.%1 = ВТ_ОрганизацииДиадок_%1.СвязанныйОбъект";
		
		ТекстСоединения = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(ШаблонТекста,
			ИмяРеквизита, ИмяПараметраСписка);
		
	ИначеЕсли ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеКромеУказанных Тогда
		
		ШаблонТекста = "
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОрганизацииДиадок КАК ВТ_ОрганизацииДиадок_%1
			|	ПО НЕ ВТ_ОрганизацииДиадок_%1.Ссылка В (&%2)
			|		И втДокументы.%1 = ВТ_ОрганизацииДиадок_%1.СвязанныйОбъект";
		
		ТекстСоединения = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(ШаблонТекста,
			ИмяРеквизита, ИмяПараметраСписка);
		
	Иначе
		
		ТекстСоединения = "";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ТекстСоединения;
	
КонецПроцедуры

Процедура ДобавитьФильтрУсловиеПоОрганизации(ТекстЗапроса, ВариантФильтрации, ПутьДоРеквизита, ИмяПараметраСписка)
	
	Если ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.УказатьСписок Тогда
		
		ШаблонТекста = "%1 В (&%2)";
		
		ТекстУсловия = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			ШаблонТекста, ПутьДоРеквизита, ИмяПараметраСписка);
		
	ИначеЕсли ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеКромеУказанных Тогда
		
		ШаблонТекста = "НЕ %1 В (&%2)";
		
		ТекстУсловия = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			ШаблонТекста, ПутьДоРеквизита, ИмяПараметраСписка);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекстЗапроса = "" Тогда
		ТекстЗапроса = ТекстУсловия;
	Иначе
		ТекстЗапроса = ТекстЗапроса + "
			|И " + ТекстУсловия;
	КонецЕсли;
	
КонецПроцедуры

Функция ДополнитьЗапросСценарияПоТипуЛогистики(ТипЛогистика, ВходнойТекстЗапроса, СценарийСсылка)
		
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
