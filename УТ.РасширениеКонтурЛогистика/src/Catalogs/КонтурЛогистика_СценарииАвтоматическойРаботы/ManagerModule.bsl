		ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокГрузоотправителейВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул3.ДокументЭТРН.Грузоотправитель",
			"СписокГрузоотправителейДиадок");
		ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокПеревозчиковВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул3.ДокументЭТРН.Перевозчик",
			"СписокПеревозчиковДиадок");
		ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокГрузополучателейВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул3.ДокументЭТРН.Грузополучатель",
			"СписокГрузополучателейДиадок");
		ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокПунктовМаршрутаОтправкиВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул3.ДокументЭТРН.МестоПогрузки",
			"СписокПунктовМаршрутаОтправки");
		ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокПунктовМаршрутаПрибытияВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул3.ДокументЭТРН.МестоДоставки",
			"СписокПунктовМаршрутаПрибытия");
		
		ТекстЗапроса = СтрЗаменить(ВходнойТекстЗапроса,
			"И НЕ КонтурЛогистика_ТрН_Титул3.ПометкаУдаления",
			ТекстДополнительногоУсловия);
		
		Если СценарийСсылка.СписокСостоянийДокументооборота.Количество() > 0 Тогда 
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
			"//ДопУсловиеГДЕ",
			"
			|	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В(&ТребуемыеСостояниеЭТРНДляОтправки)
			|	//ДопУсловиеГДЕ ");
		КонецЕсли;
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		ТекстВТОрганизацииДиадок = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка КАК Ссылка,
			|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.СвязанныйОбъект КАК СвязанныйОбъект
			|ПОМЕСТИТЬ ВТ_ОрганизацииДиадок
			|ИЗ
			|	Справочник.КонтурЛогистика_ОрганизацииДиадок.СвязанныеОбъекты КАК КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты
			|ГДЕ
			|	НЕ КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		ТекстЗапроса = ТекстВТОрганизацииДиадок + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|" + ВходнойТекстЗапроса;
		
		ТекстДополнительногоСоединенияИЗ = "";
		ДобавитьФильтрСоединениеПоОрганизации(ТекстДополнительногоСоединенияИЗ,
			СценарийСсылка.СписокГрузоотправителейВариантФильтрации,
			"СписокГрузоотправителейДиадок", "Отправитель");
		ДобавитьФильтрСоединениеПоОрганизации(ТекстДополнительногоСоединенияИЗ,
			СценарийСсылка.СписокПеревозчиковВариантФильтрации,
			"СписокПеревозчиковДиадок", "Перевозчик");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ДопСоединениеИЗ", ТекстДополнительногоСоединенияИЗ);
		
		Если СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.СогласованиеДокументов Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ДопУсловиеГДЕ",
				"	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В(&ТребуемыеСостояниеЭТРНДляСогласования)
				|	//ДопУсловиеГДЕ ");
		ИначеЕсли СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьВходящихДокументов Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ДопУсловиеГДЕ",
				"	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В(&ТребуемыеСостояниеЭТРНДляПодписаниеВходящих)
				|	//ДопУсловиеГДЕ ");
		КонецЕсли;
		
	Иначе
		
		ТекстЗапроса = ВходнойТекстЗапроса;
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаПатчаПодписью(ТипЛогистика, СценарийСсылка)

	Текст = "ВЫБРАТЬ
	        |	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка,
	        |	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.Перевозчик КАК Перевозчик,
	        |	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ГлавныйДокумент
	        |ПОМЕСТИТЬ ВТ_ДокументыПодсистемы
	        |ИЗ
	        |	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	        |ГДЕ
	        |	КонтурЛогистика_ТрН_Титул1.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	        |	И НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_ДокументыПодсистемы.Ссылка КАК Ссылка,
	        |	ВТ_ДокументыПодсистемы.Перевозчик КАК Перевозчик,
	        |	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус,
	        |	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК Состояние
	        |ИЗ
	        |	ВТ_ДокументыПодсистемы КАК ВТ_ДокументыПодсистемы
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
	        |		ПО ВТ_ДокументыПодсистемы.ГлавныйДокумент = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	        |		ПО ВТ_ДокументыПодсистемы.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ";
	
	ТекстДополнительногоУсловия = "";
	ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокПеревозчиковВариантФильтрации,
		"ВТ_ДокументыПодсистемы.Перевозчик",
		"СписокПеревозчиковДиадок");
	ДобавитьФильтрУсловиеПоОрганизации(ТекстДополнительногоУсловия, СценарийСсылка.СписокСостоянийДокументооборотаВариантФильтрации,
		"КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние",
		"СписокСостоянийДокументооборота");
	
	Если ТекстДополнительногоУсловия <> "" Тогда
		Текст = Текст + "
			|ГДЕ
			|" + ТекстДополнительногоУсловия;
	КонецЕсли;
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
		//запрос реализован на Т1 и замены не требуются
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		Текст = СтрЗаменить(Текст, "Титул1", "Титул3");
	Иначе
		ВызватьИсключение "Для типа " + ТипЛогистика + " требуется уточнить запрос построения списка для подписи существующего черновика";
	КонецЕсли;
	
	Возврат Текст;	

КонецФункции

Процедура ВыполнитьПодписьВходящихДокументов(СценарийСсылка, БезПодписанияНаСервере)
	
	Если Не ЗначениеЗаполнено(СценарийСсылка.Сценарий) Тогда
		Возврат;
	КонецЕсли;
	
	Если СценарийСсылка.ТипЛогистическогоДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		Возврат;
	КонецЕсли;
	
	// Требуется выбрать задачи
	Запрос = СформироватьЗапросСпискаЗадачРобота(СценарийСсылка);
	
	ДобавитьДопФильтры(Запрос, СценарийСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	// Отладка: Результат.Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		// Выполним проверку дополнительного условия из сценария на языке 1С
		Если Не ПроверитьДополнительноеУсловиеНаЯзыке1С(СценарийСсылка, Выборка) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыФормированияФайловРеквизиты = Новый Структура;
		ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
		ПараметрыФормированияФайловРеквизиты.Вставить("СформированАвтоматическимСценарием", Истина);
		
		ПараметрыВводаДокументов = Новый Структура;
		ПараметрыВводаДокументов.Вставить("МассивДокументов", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
			Выборка.ДокументЛогистика));
		ПараметрыВводаДокументов.Вставить("УточнениеТипаЛогистика", СценарийСсылка.ТипЛогистическогоДокумента);
		
		// Изготавливаем файлы
		КоличествоСообщенийДо = ПолучитьСообщенияПользователю().Количество();
		ФайлыОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбмена(
			ПараметрыВводаДокументов, ПараметрыФормированияФайловРеквизиты);
		
		Если ФайлыОбмена.Количество() = 0 Тогда
			// Не удалось изготовить файл, фиксируем ошибку
			СообщенияПользователю = ПолучитьСообщенияПользователю();
			КоличествоСообщенийПосле = СообщенияПользователю.Количество();
			Если КоличествоСообщенийДо <> КоличествоСообщенийПосле Тогда
				ЗафиксироватьСообщения(СценарийСсылка, Выборка.ДокументЛогистика, СообщенияПользователю, КоличествоСообщенийДо);
			КонецЕсли;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Сформирован файл обмена: " + ФайлыОбмена[0] + " по: " + Выборка.ДокументЛогистика);
		
		КонтурЛогистика_ОбработкаДокументовСервер.ИзготовитьФайлыОбменаДокументовИзШаблонов(ФайлыОбмена);
		
		// Подписываем файлы
		КоличествоСообщенийДо = ПолучитьСообщенияПользователю().Количество();
		ПодписанныеФайлыОбмена = КонтурЛогистика_ИнтеграцияДиадокКлиентСервер.ПодписатьФайлыОбмена(
			ФайлыОбмена,, БезПодписанияНаСервере);
		
		Если ПодписанныеФайлыОбмена.Количество() = 0 Тогда
			// Не удалось подписать файл, фиксируем ошибку
			СообщенияПользователю = ПолучитьСообщенияПользователю();
			КоличествоСообщенийПосле = СообщенияПользователю.Количество();
			Если КоличествоСообщенийДо <> КоличествоСообщенийПосле Тогда
				ЗафиксироватьСообщения(СценарийСсылка, Выборка.ДокументЛогистика, СообщенияПользователю, КоличествоСообщенийДо);
			КонецЕсли;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Подписан файл обмена: " + ПодписанныеФайлыОбмена[0] + " по: " + Выборка.ДокументЛогистика);
		
		// Отправка
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(ПодписанныеФайлыОбмена);
		Если РезультатОтправки.Успешно Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
				"Отправлен подписанный: " + ПодписанныеФайлыОбмена[0]);
			Если ПодписанныеФайлыОбмена.Количество() <> 0 Тогда
				СнятьОшибкиСценариевАвтоматическойРаботы(СценарийСсылка, Выборка.ДокументЛогистика);
			КонецЕсли;
		Иначе
			ТекстОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки);
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
				"Проблемы при отправке документов: " + ТекстОшибки);
			ЗафиксироватьОшибкуВРегистреИЖурнале(СценарийСсылка, Выборка.ДокументЛогистика, ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьСогласованиеДокументов(СценарийСсылка)
	
	Если Не ЗначениеЗаполнено(СценарийСсылка.Сценарий) Тогда
		Возврат;
	КонецЕсли;
	
	Если СценарийСсылка.ТипЛогистическогоДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		Возврат;
	КонецЕсли;
	
	// Требуется выбрать задачи
	Запрос = СформироватьЗапросСпискаЗадачРобота(СценарийСсылка);
	
	ДобавитьДопФильтры(Запрос, СценарийСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	// Отладка: Результат.Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		// Выполним проверку дополнительного условия из сценария на языке 1С
		Если Не ПроверитьДополнительноеУсловиеНаЯзыке1С(СценарийСсылка, Выборка) Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлыОбмена = КонтурЛогистика_ОбработкаДокументовСервер.ФайлыОбменаСогласованния(Выборка.ДокументЛогистика);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Сформирован файл обмена: " + ФайлыОбмена[0] + " по: " + Выборка.ДокументЛогистика);
		
		СогласованныеФайлыОбмена = КонтурЛогистика_ИнтеграцияДиадокКлиентСервер.СогласоватьФайлыОбмена(ФайлыОбмена);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Подписан файл обмена: " + СогласованныеФайлыОбмена[0] + " по: " + Выборка.ДокументЛогистика);
		
		Если ТипЗнч(СогласованныеФайлыОбмена) = Тип("Массив") И СогласованныеФайлыОбмена.Количество() > 0 Тогда
			
			РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьСогласованныеФайлыВДиадок(СогласованныеФайлыОбмена);
			Если РезультатОтправки.Успешно Тогда
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Отправлен подписанный: " + СогласованныеФайлыОбмена[0]);
				
			Иначе
				
				ТекстСообщения = "Проблемы при отправке документов: "
					+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки);
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ТекстСообщения);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаОбработкиВходящихДокументовЛогистики(ТипЛогистика, СценарийСсылка)
	
	// базовый текст на примере ТРН Т2
	ТекстЗапроса = "ВЫБРАТЬ
		|	КонтурЛогистика_ТрН_Титул2.Ссылка КАК ДокументДогистика,
		|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус
		|ИЗ
		|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
		|		ПО (КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ = КонтурЛогистика_ТрН_Титул2.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
		|		ПО (КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ = КонтурЛогистика_ТрН_Титул2.ДокументЭТРН)
		|ГДЕ
		|	КонтурЛогистика_ТрН_Титул2.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления
		|	И КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки)
		|	//ДопУсловиеГДЕ";
	
	ТекстЗамены = "И НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления";
	ДобавитьФильтрУсловиеПоОрганизации(ТекстЗамены, СценарийСсылка.СписокГрузоотправителейВариантФильтрации,
		"КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.Грузоотправитель",
		"СписокГрузоотправителейДиадок");
	
	// для ПЛ реквизит "Перевозчик" называется "ЛицоОформившееПЛ"
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика) Тогда
		ДобавитьФильтрУсловиеПоОрганизации(ТекстЗамены, СценарийСсылка.СписокПеревозчиковВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.ЛицоОформившееПЛ",
			"СписокПеревозчиковДиадок");
	Иначе // ТРН / ЗЗ
		ДобавитьФильтрУсловиеПоОрганизации(ТекстЗамены, СценарийСсылка.СписокПеревозчиковВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.Перевозчик",
			"СписокПеревозчиковДиадок");
	КонецЕсли;
	
	// для ТРН можно фильтровать еще по ГП и пунктам отгрузки / приемки
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипЛогистика) Тогда
		ДобавитьФильтрУсловиеПоОрганизации(ТекстЗамены, СценарийСсылка.СписокГрузополучателейВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.Грузополучатель",
			"СписокГрузополучателейДиадок");
		ДобавитьФильтрУсловиеПоОрганизации(ТекстЗамены, СценарийСсылка.СписокПунктовМаршрутаОтправкиВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.МестоПогрузки",
			"СписокПунктовМаршрутаОтправки");
		ДобавитьФильтрУсловиеПоОрганизации(ТекстЗамены, СценарийСсылка.СписокПунктовМаршрутаПрибытияВариантФильтрации,
			"КонтурЛогистика_ТрН_Титул2.ДокументЭТРН.МестоДоставки",
			"СписокПунктовМаршрутаПрибытия");
	КонецЕсли;
	
	// дополнить текст собранными условиями
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"И НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления", ТекстЗамены);
	
	// еще фильтр по состояниям документооборота 
	Если СценарийСсылка.СписокСостоянийДокументооборота.Количество() > 0 Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"//ДопУсловиеГДЕ",
		"
		|	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В(&ТребуемыеСостояниеЭТРНДляОтправки)
		|	//ДопУсловиеГДЕ ");
	КонецЕсли;
	
	Имя = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	
	// замена типа титула
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТрН_Титул2", Имя);
	
	// Для ПЛ и ЗЗ реквизит содержащий главный документ называется не "ДокументЭТРН" а "Титул1" , а для их Т1 "Ссылка" 
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика) Тогда
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда 
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументЭТРН", "Ссылка");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументЭТРН", "Титул1");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;	

КонецФункции

Процедура ВыполнитьВсеАктивныеСценарииОбработкиВходящихДокументов() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = ТекстЗапросаВсехАктивныхСценариев();
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, 
			"И ЕСТЬNULL(ВТ_РоботыСРасписанием.СейчасАктивен, ИСТИНА)", 
			"И ЕСТЬNULL(ВТ_РоботыСРасписанием.СейчасАктивен, ИСТИНА) И КонтурЛогистика_СценарииАвтоматическойРаботы.Ссылка.Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ОбработатьВходящиеДокументыЛогистики)");
	
	Запрос.УстановитьПараметр("ТекущееВремя", Дата(1,1,1) + (ТекущаяДатаСеанса() - НачалоДня(ТекущаяДатаСеанса())));
	Запрос.УстановитьПараметр("ДеньНедели", ДеньНедели(ТекущаяДатаСеанса()));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ВыполнитьСценарийАвтоотправки(Выборка.Ссылка);
			
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ЗафиксироватьОшибкуВРегистреИЖурнале(Выборка.Ссылка,, ТекстОшибки);
			
			Сообщить("КонтурЛогистика_Робот_" + Выборка.Ссылка + ": " + ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПроверитьДополнительноеУсловиеНаЯзыке1С(Сценарий, Выборка)
	
	ДополнительноеУсловиеНа1С = Сценарий.ДополнительноеУсловиеНа1С;
	Если Не ЗначениеЗаполнено(ДополнительноеУсловиеНа1С) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("Сценарий", Сценарий);
	Параметры.Вставить("Выборка", Выборка);
	
	РезультатВычисления = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
		ДополнительноеУсловиеНа1С, Параметры);
	
	Возврат РезультатВычисления;
	
КонецФункции

#Область ПереходНаЭПЛ502

Процедура ПеренестиСценарииАвтоотправкиДляЭПЛВФормат502(ТихийРежим = Истина) Экспорт
	
	ТипыДокументаЛогистика = Новый Массив;
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СценарииАвтоматическойРаботы.Ссылка КАК Ссылка,
		|	КонтурЛогистика_СценарииАвтоматическойРаботы.НастройкаКонвертации КАК НастройкаКонвертации
		|ИЗ
		|	Справочник.КонтурЛогистика_СценарииАвтоматическойРаботы КАК КонтурЛогистика_СценарииАвтоматическойРаботы
		|ГДЕ
		|	НЕ КонтурЛогистика_СценарииАвтоматическойРаботы.ПометкаУдаления
		|	И КонтурЛогистика_СценарииАвтоматическойРаботы.ТипЛогистическогоДокумента В (&ТипыДокументаЛогистика)";	
	
	Запрос.УстановитьПараметр("ТипыДокументаЛогистика", ТипыДокументаЛогистика);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
		
			ПеренестиСценарийАвтоотправкиДляЭПЛВФормат502(ВыборкаДетальныеЗаписи.Ссылка);
		
		Исключение
			
			ТекстОшибки = "Ошибка при переносе сценария автоотправки в формат 5.02. Ошибка: " + ОписаниеОшибки();
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
			Если Не ТихийРежим Тогда
				Сообщить(ТекстОшибки);
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Перенос сценариев автоотправки выполнен");
		
КонецПроцедуры

Процедура ПеренестиСценарийАвтоотправкиДляЭПЛВФормат502(СценарийАвтоотправки)
	
	Если СценарийАвтоотправки.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
	ИначеЕсли СценарийАвтоотправки.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02;
	ИначеЕсли СценарийАвтоотправки.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;
	ИначеЕсли СценарийАвтоотправки.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02;
	ИначеЕсли СценарийАвтоотправки.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СценарийАвтоотправки.НастройкаКонвертации) Тогда
		
		Если ЗначениеЗаполнено(СценарийАвтоотправки.НастройкаКонвертации) Тогда
			Родитель = СценарийАвтоотправки.НастройкаКонвертации.Родитель;
		Иначе
			Родитель = Неопределено;
		КонецЕсли;
		
		НастройкаКонвертации502 = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.НайтиНастройкуКонвертацииДокументов(
			ТипЭПЛ502, СценарийАвтоотправки.НастройкаКонвертации.ТипДокумента1С, Родитель);		
		
	КонецЕсли;
		
	СценарийАвтоотправки502 = НайтиСценарийАвтоматическойРаботы(СценарийАвтоотправки.Сценарий, ТипЭПЛ502, НастройкаКонвертации502);
	
	Если ЗначениеЗаполнено(СценарийАвтоотправки502) Тогда
		Возврат;	
	КонецЕсли;	
	
	СценарийАвтоотправки502Объект = СценарийАвтоотправки.Скопировать();
	СценарийАвтоотправки502Объект.ТипЛогистическогоДокумента = ТипЭПЛ502;	
	СценарийАвтоотправки502Объект.Включен = Ложь;
	СценарийАвтоотправки502Объект.СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка();
    СценарийАвтоотправки502Объект.НастройкаКонвертации = НастройкаКонвертации502;
	
	СценарийАвтоотправки502Объект.СписокГрузоотправителейДиадок.Очистить();
	СценарийАвтоотправки502Объект.СписокПунктовМаршрутаОтправки.Очистить();
	СценарийАвтоотправки502Объект.СписокПунктовМаршрутаПрибытия.Очистить();
	
	СценарийАвтоотправки502Объект.Записать();
		
КонецПроцедуры

Функция НайтиСценарийАвтоматическойРаботы(Сценарий, ТипЛогистическогоДокумента, НастройкаКонвертации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СценарииАвтоматическойРаботы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_СценарииАвтоматическойРаботы КАК КонтурЛогистика_СценарииАвтоматическойРаботы
		|ГДЕ
		|	НЕ КонтурЛогистика_СценарииАвтоматическойРаботы.ПометкаУдаления
		|	И КонтурЛогистика_СценарииАвтоматическойРаботы.ТипЛогистическогоДокумента = &ТипЛогистическогоДокумента
		|   И КонтурЛогистика_СценарииАвтоматическойРаботы.НастройкаКонвертации = &НастройкаКонвертации
		|	И КонтурЛогистика_СценарииАвтоматическойРаботы.Сценарий = &Сценарий";
	
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	Запрос.УстановитьПараметр("НастройкаКонвертации", НастройкаКонвертации);
	Запрос.УстановитьПараметр("ТипЛогистическогоДокумента", ТипЛогистическогоДокумента);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти