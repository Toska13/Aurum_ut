
// ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(СписокГрузоотправителейВариантФильтрации) Тогда 
		СписокГрузоотправителейВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(СписокПеревозчиковВариантФильтрации) Тогда 
		СписокПеревозчиковВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(СписокГрузополучателейВариантФильтрации) Тогда 
		СписокГрузополучателейВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(СписокПунктовМаршрутаОтправкиВариантФильтрации) Тогда 
		СписокПунктовМаршрутаОтправкиВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(СписокПунктовМаршрутаПрибытияВариантФильтрации) Тогда 
		СписокПунктовМаршрутаПрибытияВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(СписокСостоянийДокументооборотаВариантФильтрации) Тогда 
		СписокСостоянийДокументооборотаВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора;
	КонецЕсли;
	
	ЕстьИнтервалыАктивности = ИнтервалыАктивности.Количество() > 0;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Найти(ДополнительноеУсловиеГДЕ, "&Параметр") > 0
		И Не ЗначениеЗаполнено(ДополнительноеУсловиеГДЕВычислениеПараметра)
		И Не ЗначениеЗаполнено(ДополнительноеУсловиеГДЕПараметрИзЗначенияНастройки) Тогда
		
		
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить вычисление параметра дополнительного условия.";
		ПараметрыСообщения.ПутьКДанным  = "Объект.ДополнительноеУсловиеГДЕПараметрИзЗначенияНастройки";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если (Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковДокументов
		Или Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИОтправкаНеподписанных
		Или Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИПодготовкаКОтправкеНеподписанных
		Или Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИОтправка
		Или Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИПодготовкаКОтправке)
		И ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		И ОбработкаОтказа
		И Не ЗначениеЗаполнено(ДополнительноеУсловиеГДЕОбработкаОтказа) Тогда
		
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить вычисление дополнительного условия";
		ПараметрыСообщения.ПутьКДанным  = "Объект.ДополнительноеУсловиеГДЕОбработкаОтказа";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры
