
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
	
	ЗаполнитьСписокВыбораНастройкиКонвертации();
	ЗаполнитьСписокВыбораСценария();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	
	ИнтервалыАктивностиПриИзменении();
	
	УправлениеФильтромСостоянияДокументооборота();
	
	ОбновитьДоступностьПерезаполнятьЧерновики();
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
			ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграм();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеОбщейНастройки"
		И Параметр = "ИспользоватьОтправкуВТелеграм" Тогда
		
		ИспользоватьОтправкуВТелеграм = ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
		УстановитьВидимостьЭлементов();
		
		Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
			ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграм();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзменениеНастройкиУчетнойЗаписиЭлектроннойПочты" Тогда
		
		ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
		УстановитьВидимостьЭлементов();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТипЛогистическогоДокументаПриИзмененииНаСервере()
	
	ЗаполнитьСписокВыбораНастройкиКонвертации();
	ЗаполнитьСписокВыбораСценария();
	
	УстановитьСостоянияПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЛогистическогоДокументаПриИзменении(Элемент)
	
	СброситьСпецСценарий();
	ТипЛогистическогоДокументаПриИзмененииНаСервере();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	ТипДокумента = Объект.ТипЛогистическогоДокумента;
	
	Элементы.БаннерНеРеализованоПоПВ.Видимость = Ложь;
	Элементы.БаннерНеРеализованоПоГП.Видимость = Ложь;
	Элементы.БаннерНеРеализованоПоПунктамОтправки.Видимость = Ложь;
	Элементы.БаннерНеРеализованоПоПунктамПрибытия.Видимость = Ложь;
	Элементы.БаннерНеРеализованоПоСостояниюЭТрН.Видимость = Ложь;
	Элементы.БаннерНеРеализованоПоСостояниюПЛ.Видимость = Ложь;
	Элементы.ДекорацияПримерДляТ1.Видимость = Ложь;
	Элементы.ДекорацияПримерДляТ2.Видимость = Ложь;
	Элементы.ДекорацияПримерДляПЛ.Видимость = Ложь;
	Элементы.ТолькоБезЗамечанийУчастников.Видимость = Ложь;
	Элементы.БаннерСостоянияПодписьРанееОтправленного.Видимость = Ложь;
	Элементы.ПерезаполнятьЧерновики.Видимость = Ложь;
	
	Если ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда
		
		Элементы.БаннерНеРеализованоПоПунктамОтправки.Видимость = Истина;
		Элементы.БаннерНеРеализованоПоПунктамПрибытия.Видимость = Истина;
		Элементы.БаннерНеРеализованоПоСостояниюЭТрН.Видимость =
			(Объект.Сценарий <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного"));
		
		Элементы.ДекорацияПримерДляТ1.Видимость = Истина;
		
	ИначеЕсли ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1") Тогда
		
		Элементы.БаннерНеРеализованоПоПунктамОтправки.Видимость = Истина;
		Элементы.БаннерНеРеализованоПоПунктамПрибытия.Видимость = Истина;
		Элементы.БаннерНеРеализованоПоСостояниюПЛ.Видимость = Истина;
		
		Элементы.ДекорацияПримерДляТ1.Видимость = Истина;
		
	ИначеЕсли ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2")
		Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда
		
		Элементы.БаннерНеРеализованоПоПунктамОтправки.Видимость = Истина;
		Элементы.БаннерНеРеализованоПоПунктамПрибытия.Видимость = Истина;
		Элементы.БаннерНеРеализованоПоСостояниюПЛ.Видимость = Истина;
		
		Элементы.ДекорацияПримерДляПЛ.Видимость = Истина;
		
	Иначе
		
		Элементы.ДекорацияПримерДляТ2.Видимость = Истина;
		Элементы.ТолькоБезЗамечанийУчастников.Видимость = Истина;
		
	КонецЕсли;
	
	Если ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда
		Элементы.ГруппаСписокПеревозчиковДиадок.Заголовок = "По ЭК";
		Элементы.БаннерНеРеализованоПоГП.Видимость = Истина;
	Иначе
		Элементы.ГруппаСписокПеревозчиковДиадок.Заголовок = "По ПВ";
	КонецЕсли;
	
	Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного")
		И Объект.СписокСостоянийДокументооборота.Количество() = 0 Тогда
		
		Элементы.БаннерСостоянияПодписьРанееОтправленного.Видимость = Истина;
	КонецЕсли;
	
	ОбновитьДоступностьПерезаполнятьЧерновики();
	
	Элементы.ГруппаТелефонУведомленияОшибокРоботов.Видимость = ИспользоватьОтправкуВТелеграм;
	Элементы.ГруппаНастройкиТелеграм.Видимость = Не ИспользоватьОтправкуВТелеграм;
	
	Элементы.АдресЭлектроннойПочтыУведомленияОшибокРоботов.Видимость = ИспользоватьОтправкуНаПочту;
	Элементы.ГруппаНастройкиПочты.Видимость = Не ИспользоватьОтправкуНаПочту;
	
	Если ЭтоОбработкаОтказа() Тогда
		Элементы.ОбработкаОтказа.Видимость = Истина;
		Элементы.ДополнительноеУсловиеГДЕОбработкаОтказа.Видимость = Объект.ОбработкаОтказа;
	Иначе
		Элементы.ОбработкаОтказа.Видимость = Ложь;
		Элементы.ДополнительноеУсловиеГДЕОбработкаОтказа.Видимость = Ложь;
	КонецЕсли;
	
	// Спец. сценарии
	УстановитьВидимостьЭлементовСпецСценария();
	
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовСпецСценария()
	
	ТипДокумента = Объект.ТипЛогистическогоДокумента;
	
	Элементы.ТрнТитул3ПослеТитула7.Видимость =
		(ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3"));
	Элементы.ТрнТитул7ПослеТитула4.Видимость =
		(ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7"));
	Элементы.ТрнТитул4ПоВозврату.Видимость =
		(ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4"));
	Элементы.ПЛТитул1ПослеСменыВодителя.Видимость =
		(ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
			И Не Объект.ПерезаполнятьЧерновики);
	ТрнТитул3ПослеТитула7 =
		(Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7"));
	ТрнТитул7ПослеТитула4 =
		(Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4"));
	ТрнТитул4ПоВозврату =
		(Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату"));
	ПЛТитул1ПослеСменыВодителя =
		(Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя"));
		
КонецПроцедуры

&НаКлиенте
Процедура СброситьСпецСценарий()
	
	ТипДокумента = Объект.ТипЛогистическогоДокумента;
	
	Если (ТрнТитул3ПослеТитула7
			И ТипДокумента <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3"))
		Или (ТрнТитул7ПослеТитула4
			И ТипДокумента <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7"))
		Или (ТрнТитул4ПоВозврату
			И ТипДокумента <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4"))
		Или (ПЛТитул1ПослеСменыВодителя
			И ТипДокумента <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")) Тогда
		
		Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоОбработкаОтказа()
	
	Если (Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковДокументов")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИОтправкаНеподписанных")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИПодготовкаКОтправкеНеподписанных")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИОтправка")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИПодготовкаКОтправке"))
		И (Объект.ТипЛогистическогоДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
			Или Объект.ТипЛогистическогоДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")) Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ИнтервалыАктивностиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда 
		
		Элемент.ТекущиеДанные.ВремяПо = Дата(1981,01,01,23,59,59);
		Элемент.ТекущиеДанные.ПН = Истина;
		Элемент.ТекущиеДанные.ВТ = Истина;
		Элемент.ТекущиеДанные.СР = Истина;
		Элемент.ТекущиеДанные.ЧТ = Истина;
		Элемент.ТекущиеДанные.ПТ = Истина;
		Элемент.ТекущиеДанные.СБ = Истина;
		Элемент.ТекущиеДанные.ВС = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалыАктивностиПриИзменении(Элемент = Неопределено)
	
	Если Объект.ИнтервалыАктивности.Количество() > 0 Тогда 
		Элементы.ГруппаИнтервалыАктивности.Картинка = БиблиотекаКартинок.КонтурЛогистика_Вкл_Красный;
	Иначе
		Элементы.ГруппаИнтервалыАктивности.Картинка = БиблиотекаКартинок.КонтурЛогистика_Выкл;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораСценария()
	
	СписокВыбора = Новый Массив;
	СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковДокументов);
	СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИПодготовкаКОтправкеНеподписанных);
	СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИОтправкаНеподписанных);
	СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИПодготовкаКОтправке);
	СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИОтправка);
	
	СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ОбработатьВходящиеДокументыЛогистики);
	
	Если Объект.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Объект.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного);
	КонецЕсли;
	
	Если Объект.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьВходящихДокументов);
		СписокВыбора.Добавить(Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.СогласованиеДокументов);
	КонецЕсли;
	
	Элементы.Сценарий.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораНастройкиКонвертации()
	
	Элементы.НастройкаКонвертации.СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.ТипЛогистическогоДокумента) Тогда
		Возврат;
	КонецЕсли;
		
	НастройкиКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.МассивНастроекКонвертацииПоТипуЛогистики(
		Объект.ТипЛогистическогоДокумента, Истина);
	
	Если НастройкиКонвертации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ОбработатьВходящиеДокументыЛогистики Тогда
		
		Для Каждого НастройкаКонвертации Из НастройкиКонвертации Цикл
			Если НастройкаКонвертации.ОбратныйМаппинг Тогда
				Элементы.НастройкаКонвертации.СписокВыбора.Добавить(НастройкаКонвертации);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого НастройкаКонвертации Из НастройкиКонвертации Цикл
			Если Объект.СпецСценарий = НастройкаКонвертации.СпецСценарий Тогда
				Элементы.НастройкаКонвертации.СписокВыбора.Добавить(НастройкаКонвертации);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	// Согласующую подпись поддерживает только экспедиторская расписка
	Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.СогласованиеДокументов")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьВходящихДокументов") Тогда
		Объект.ТипЛогистическогоДокумента =
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка");
	КонецЕсли;
	
	ЗаполнитьСписокВыбораНастройкиКонвертации();
	
	УстановитьСостоянияПоУмолчанию();
	
	УправлениеФильтромСостоянияДокументооборота();
	
	ОбновитьДоступностьПерезаполнятьЧерновики();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительноеУсловиеГДЕВычислениеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстРедактирования = СтрЗаменить(Объект.ДополнительноеУсловиеГДЕВычислениеПараметра, "¶", Символы.ПС);
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		ТекстРедактирования, Объект, "ДополнительноеУсловиеГДЕВычислениеПараметра");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостоянияПоУмолчанию()
	
	Если Объект.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного
		И ЗначениеЗаполнено(Объект.ТипЛогистическогоДокумента) Тогда
		
		Объект.СписокСостоянийДокументооборота.Очистить();
		
		Если Объект.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
			ДобавитьСостояние(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-consignor-sign"));			
		ИначеЕсли Объект.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			ДобавитьСостояние(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-consignee-sign"));			
		КонецЕсли;
		
	КонецЕсли;
	
	Объект.ОбработкаОтказа = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСостояние(Состояние)
	
	НоваяСтрока = Объект.СписокСостоянийДокументооборота.Добавить();
	НоваяСтрока.Состояние = Состояние;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФильтромСостоянияДокументооборота()
	
	ВсеБезОтбора = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.ВсеБезОтбора");
	УказатьСписок = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок");
	ВсеКромеУказанных = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.ВсеКромеУказанных");
	
	Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного") Тогда
		
		НайдВсеБезОтбора = Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.НайтиПоЗначению(ВсеБезОтбора);
		Если НайдВсеБезОтбора <> Неопределено Тогда
			Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Удалить(НайдВсеБезОтбора);	
		КонецЕсли;
		
		НайдВсеБезОтбора = Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.НайтиПоЗначению(ВсеКромеУказанных);
		Если НайдВсеБезОтбора <> Неопределено Тогда
			Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Удалить(НайдВсеБезОтбора);	
		КонецЕсли;
		
		Объект.СписокСостоянийДокументооборотаВариантФильтрации = УказатьСписок;
		
	Иначе
		
		НайдВсеБезОтбора = Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.НайтиПоЗначению(ВсеБезОтбора);
		Если НайдВсеБезОтбора = Неопределено Тогда
			Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Добавить(ВсеБезОтбора, "Все без отбора");	
		КонецЕсли;
		
		НайдВсеБезОтбора = Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.НайтиПоЗначению(ВсеКромеУказанных);
		Если НайдВсеБезОтбора = Неопределено Тогда
			Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Добавить(ВсеКромеУказанных, "Все кроме указанных");	
		КонецЕсли;
		
		Если Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Количество() > 2
			И Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Получить(1).Значение <> УказатьСписок Тогда
			
			Элементы.СписокСостоянийДокументооборотаВариантФильтрации.СписокВыбора.Сдвинуть(0, 1);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.БаннерСостоянияПодписьРанееОтправленного.Видимость = Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного")
			И Объект.СписокСостоянийДокументооборота.Количество() = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного")
		И Объект.СписокСостоянийДокументооборота.Количество() = 0 Тогда
		
		Сообщить("Для сценария необходимо заполнить фильтр по состоянию документооборота");
		Отказ = Истина;
		
	КонецЕсли;
	
	Если Объект.СписокГрузоотправителейВариантФильтрации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок") Тогда 
		
		Если Объект.СписокГрузоотправителейДиадок.Количество() = 0 Тогда 
			Отказ = Истина;
			КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Для фильтрации по грузоотправителям нужно указать их в таблице.
				|Иначе робот никогда не выполнится.", , "Объект.СписокГрузоотправителейДиадок");
			ЭтаФорма.ТекущийЭлемент = Элементы.СписокГрузоотправителейДиадок;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.СписокПеревозчиковВариантФильтрации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок") Тогда 
		
		Если Объект.СписокПеревозчиковДиадок.Количество() = 0 Тогда 
			Отказ = Истина;
			КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Для фильтрации по перевозчикам нужно указать их в таблице.
				|Иначе робот никогда не выполнится.", , "Объект.СписокПеревозчиковДиадок");
			ЭтаФорма.ТекущийЭлемент = Элементы.СписокПеревозчиковДиадок;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.СписокГрузополучателейВариантФильтрации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок") Тогда 
		
		Если Объект.СписокГрузополучателейДиадок.Количество() = 0 Тогда 
			Отказ = Истина;
			КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Для фильтрации по грузополучателям нужно указать их в таблице.
				|Иначе робот никогда не выполнится.", , "Объект.СписокГрузополучателейДиадок");
			ЭтаФорма.ТекущийЭлемент = Элементы.СписокГрузополучателейДиадок;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.СписокСостоянийДокументооборотаВариантФильтрации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок") Тогда 
		
		Если Объект.СписокСостоянийДокументооборота.Количество() = 0 Тогда 
			Отказ = Истина;
			КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Для фильтрации по состоянию документооборота нужно указать их в таблице.
				|Иначе робот никогда не выполнится.", , "Объект.СписокСостоянийДокументооборота");
			ЭтаФорма.ТекущийЭлемент = Элементы.СписокСостоянийДокументооборота;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.СписокПунктовМаршрутаОтправкиВариантФильтрации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок") Тогда 
		
		Если Объект.СписокПунктовМаршрутаОтправки.Количество() = 0 Тогда 
			Отказ = Истина;
			КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Для фильтрации по пунктам отправки нужно указать их в таблице.
				|Иначе робот никогда не выполнится.", , "Объект.СписокПунктовМаршрутаОтправки");
			ЭтаФорма.ТекущийЭлемент = Элементы.СписокПунктовМаршрутаОтправки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.СписокПунктовМаршрутаПрибытияВариантФильтрации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыФильтрации.УказатьСписок") Тогда 
		
		Если Объект.СписокПунктовМаршрутаПрибытия.Количество() = 0 Тогда 
			Отказ = Истина;
			КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Для фильтрации по пунктам прибытия нужно указать их в таблице.
				|Иначе робот никогда не выполнится.", , "Объект.СписокПунктовМаршрутаПрибытия");
			ЭтаФорма.ТекущийЭлемент = Элементы.СписокПунктовМаршрутаПрибытия;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСостоянийДокументооборотаПриИзменении(Элемент)
	
	Элементы.БаннерСостоянияПодписьРанееОтправленного.Видимость = Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного")
			И Объект.СписокСостоянийДокументооборота.Количество() = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительноеУсловиеНа1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		Объект.ДополнительноеУсловиеНа1С, Объект, "ДополнительноеУсловиеНа1С");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьПерезаполнятьЧерновики()
	
	ТипДокумента = Объект.ТипЛогистическогоДокумента;
	
	Если (Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИОтправкаНеподписанных")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИПодготовкаКОтправкеНеподписанных")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИОтправка")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИПодготовкаКОтправке"))
		И (ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
			Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8")
			Или (ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
				И Объект.СпецСценарий <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя"))
			Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
			Или ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")) Тогда
		
		Элементы.ПерезаполнятьЧерновики.Видимость = Истина;
	Иначе
		Элементы.ПерезаполнятьЧерновики.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтправкуВТелеграм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ПолучитьНастройкуПоИмениПредопределенного("ИспользоватьОтправкуВТелеграм"));
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_Настройки.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтправкуНаПочту(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастройкаУчетнойЗаписиЭлектроннойПочты",, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодключитьТелеграмНажатие(Элемент)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_QRКодБотаКаналаТелеграм",,
		ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьГруппыТелеграм()
	
	Элементы.ДекорацияИдетПроверкаТелеграм.Видимость = Ложь;
	Элементы.ДекорацияРезультатУспехТелеграм.Видимость = Ложь;
	Элементы.ДекорацияПодключитьТелеграм.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
		Элементы.ГруппаПроверкаТелеграм.Видимость = Истина;
		
		Если ИдетПроверкаТелефонаУведомленияОшибокРоботовВТелеграм Тогда
			Элементы.ДекорацияИдетПроверкаТелеграм.Видимость = Истина;
		ИначеЕсли ТелефонУведомленияОшибокРоботовЗарегестрированВТелеграм Тогда
			Элементы.ДекорацияРезультатУспехТелеграм.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПодключитьТелеграм.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГруппаПроверкаТелеграм.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграм()
	
	ИдетПроверкаТелефонаУведомленияОшибокРоботовВТелеграм = Истина;
	ПодключитьОбработчикОжидания("ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграмВФоне", 0.1, Истина);
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграмВФоне()
	
	ТелефонУведомленияОшибокРоботовЗарегестрированВТелеграм = ПроверитьРегистрациюТелеграмНаСервере(Объект.ТелефонУведомленияОшибокРоботов);
	ИдетПроверкаТелефонаУведомленияОшибокРоботовВТелеграм = Ложь;
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьРегистрациюТелеграмНаСервере(Телефон)
	
	Попытка
		ТелефонЗарегестрированВТелеграм = КонтурЛогистика_РаботаСТелеграм.ТелефонЗарегестрирован(Телефон);
	Исключение
		ТелефонЗарегестрированВТелеграм = Ложь;
	КонецПопытки;
	
	Возврат ТелефонЗарегестрированВТелеграм;
	
КонецФункции

&НаСервереБезКонтекста
Функция НастройкиОтправкиПочтыЗаполнены()
	
	Возврат КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкуПоИмениПредопределенного(ИмяПредопределенного)
	
	Возврат Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеНастройки(ИмяПредопределенного)
	
	Возврат Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(ИмяПредопределенного);
	
КонецФункции

&НаКлиенте
Процедура ТелефонУведомленияОшибокРоботовПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
		ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграмВФоне();
	Иначе
		ОбновитьВидимостьГруппыТелеграм();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеЗапроса()
	
	ДанныеЗапроса = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Объект.Сценарий) Тогда
		Сообщить("Не выбран сценарий");
		Возврат ДанныеЗапроса;
	КонецЕсли;
		
	Запрос = Справочники.КонтурЛогистика_СценарииАвтоматическойРаботы.СформироватьЗапросСпискаЗадачРобота(Объект.Ссылка);
	
	Справочники.КонтурЛогистика_СценарииАвтоматическойРаботы.ДобавитьДопФильтры(Запрос, Объект.Ссылка);
	
	СписокПараметров = Новый СписокЗначений;
	Для каждого Параметр Из Запрос.Параметры Цикл
		
		Если Найти(Запрос.Текст, "&" + Параметр.Ключ) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СписокПараметров.Добавить(Параметр.Значение, Строка(Параметр.Ключ));
		
	КонецЦикла;
	
	ДанныеЗапроса.Вставить("ТекстЗапроса", Запрос.Текст);
	ДанныеЗапроса.Вставить("ПараметрыЗапроса", СписокПараметров);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьТекстЗапроса(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Сообщить("Необходимо записать сценарий автоматической обработки");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = ДанныеЗапроса();
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФормаТекстаЗапроса", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтказаПриИзменении(Элемент)
	
	Элементы.ДополнительноеУсловиеГДЕОбработкаОтказа.Видимость = Объект.ОбработкаОтказа;
	
КонецПроцедуры

&НаКлиенте
Процедура СпецСценарийПриИзменении(Элемент)
	
	Если ЭтаФорма[Элемент.Имя] Тогда
		Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач." + Элемент.Имя);
	Иначе
		Объект.СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
	КонецЕсли;
	
	ЗаполнитьСписокВыбораНастройкиКонвертации();
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнятьЧерновикиПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры
