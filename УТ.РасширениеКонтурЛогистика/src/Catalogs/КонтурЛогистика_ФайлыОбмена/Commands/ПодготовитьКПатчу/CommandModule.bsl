#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	Подготовленные = КонтурЛогистика_ОбработкаДокументовКлиент.ПодготовленныеКПатчуФайлыОбмена(ПараметрКоманды);
		
	ВывестиСообщениеОРезультатеПодготовки(ПараметрКоманды, Подготовленные);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьСообщение(Текст, Ссылка = Неопределено)
	
	ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
	ПараметрыСообщения.Текст 	  = Текст;
	ПараметрыСообщения.КлючДанных = Ссылка;
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщениеОРезультатеПодготовки(Исходные, Подготовленные)
	
	Неподготовленные = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазностьМассивов(
						   Исходные,
						   Подготовленные);
			
	Если Неподготовленные.Количество() > 0 Тогда
		
		ТекстСообщения = Нстр("ru = 'Не удалось подготовить некоторые выбранные файлы:'");
		ПоказатьСообщение(ТекстСообщения);
		
		Для Каждого Неподготовленный Из Неподготовленные Цикл
			
			ПоказатьСообщение(Неподготовленный, Неподготовленный);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти