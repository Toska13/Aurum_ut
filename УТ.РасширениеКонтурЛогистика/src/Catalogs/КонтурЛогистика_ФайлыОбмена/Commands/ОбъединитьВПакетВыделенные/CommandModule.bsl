
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Результат = ДобавитьВПакетСервер(ПараметрКоманды);
	
	Если Результат.Успешно Тогда 
		Состояние("В пакете!", , "Файлы объединены в пакет", БиблиотекаКартинок.КонтурЛогистика_ОбъединитьВПакет);
	Иначе
		Состояние("Не удалось объединить в пакет",, "Подробности выведены в сообщения", БиблиотекаКартинок.КонтурЛогистика_ИсправитьОшибки);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьООшибкиВыполненияФункции(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьВПакетСервер(ПараметрКоманды)
	
	МассивСтруктурDocumentId = Новый Массив;
	Для й = 1 По ПараметрКоманды.Количество() - 1 Цикл 
		МассивСтруктурDocumentId.Добавить(Новый Структура("MessageId, EntityId", ПараметрКоманды[й].MessageID, ПараметрКоманды[й].DocumentId));
	КонецЦикла;
	
	Результат = КонтурЛогистика_API_Диадок.ВыполнитьЗапросПрисоединитьДокументыКПакету(ПараметрКоманды[0], МассивСтруктурDocumentId);
	
	Возврат Результат;

КонецФункции 