Функция СформироватьОшибкуОтправкиФайлаОбмена(РезультатОтправки)
	
	СтруктураОшибки = Новый Структура;
	
	Если РезультатОтправки.Свойство("ТипОшибки") Тогда
		СтруктураОшибки.Вставить("ТипОшибки", РезультатОтправки.ТипОшибки);
	Иначе
		СтруктураОшибки.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ПустаяСсылка());
	КонецЕсли;
	Если РезультатОтправки.Свойство("КодОтвета") Тогда
		СтруктураОшибки.Вставить("КодОшибки", РезультатОтправки.КодОтвета);
	Иначе
		СтруктураОшибки.Вставить("КодОшибки", "");
	КонецЕсли;
	Если РезультатОтправки.Свойство("ОписаниеОшибки") Тогда
		СтруктураОшибки.Вставить("ОписаниеОшибки", РезультатОтправки.ОписаниеОшибки);
	Иначе
		СтруктураОшибки.Вставить("ОписаниеОшибки", "");
	КонецЕсли;
	Если РезультатОтправки.Свойство("ПодробноеОписаниеОшибки") Тогда
		СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", РезультатОтправки.ПодробноеОписаниеОшибки);
	Иначе
		СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", "");
	КонецЕсли;
	
	Возврат СтруктураОшибки;
	
КонецФункции