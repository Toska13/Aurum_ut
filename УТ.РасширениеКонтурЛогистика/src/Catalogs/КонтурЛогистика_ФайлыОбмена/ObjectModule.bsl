Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаВремяФормирования) Тогда
		ДатаВремяФормирования = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
	КонецЕсли;

	Если Код = 0 Тогда
		УстановитьНовыйКод();
	КонецЕсли;

	Наименование = "" + Код + " " + ТипДокумента
		+ ?(ЗначениеЗаполнено(ГлавныйДокумент), " по " + Строка(ГлавныйДокумент), "");

	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда 
		// во всех исходящих имя файла уже должно быть определено, технически нет смысла заново его рассчитывать т.к. мы можем рассчитать его неверно
		ИмяФайла = Удалить_ИмяФайлаТитула(СвязанныйДокумент);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КаналТранспорта) Тогда // может быть уже указан в момент заполнения
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ЭтотОбъект.ТипДокумента)
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ЭтотОбъект.ТипДокумента) Тогда
			
			ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ЭтотОбъект.Отправитель);
			Если ПараметрыСервиса.АвторизацияВыполнена Тогда
	
				КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
				
			Иначе
				
				КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок;
				
			КонецЕсли;
			
		Иначе
			
			// Остальные ЭПД сейчас только через Диадок
			КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТестовыйДокумент
		И ЗначениеЗаполнено(ГлавныйДокумент)
		И (ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
			Или ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02")
			Или ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
			Или ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка")) Тогда
		
		ПризнакДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ГлавныйДокумент, "ТестовыйДокумент");
		Если ПризнакДокумента <> ТестовыйДокумент Тогда
			
			// Обновим признак в документе
			КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
			Попытка
				ЗаблокироватьДанныеДляРедактирования(ГлавныйДокумент);
				
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.ТестовыйДокумент = ТестовыйДокумент;
				ГлавныйДокументОбъект.Записать();
				
				РазблокироватьДанныеДляРедактирования(ГлавныйДокумент);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				ОтменитьТранзакцию();
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

//Возвращает идетентификатор файлов титула
Функция Удалить_ИмяФайлаТитула(ДокументТитула)

	ИдФайла = "";

	НетГлавногоДокумента = КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(ДокументТитула)
						Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ДокументТитула);
	
	Если Не ЗначениеЗаполнено(ДокументТитула) Тогда

		ВызватьИсключение "Не переданы документ Титул  - не могу сформировать имя файла";
		
	КонецЕсли;
	
	Если Не НетГлавногоДокумента И Не ЗначениеЗаполнено(ГлавныйДокумент) Тогда

		ВызватьИсключение "Не переданы Главный докуменн  - не могу сформировать имя файла";
		
	КонецЕсли;
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(ДокументТитула) Тогда
		
		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда 
			ДокТитул1 = ДокументТитула;
		Иначе
			ДокТитул1 = ДокументТитула.Титул1;
		КонецЕсли;
		
		Если ДокументТитула.ДополнительныеПолучателиФайла.Количество() > 0 Тогда 
			W = 1;
		Иначе
			W = 0;
		КонецЕсли;
	
		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда 
			НомерТитула = 1;
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2")
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2_5_02") Тогда 
			НомерТитула = 2;
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3_5_02") Тогда 
			НомерТитула = 3;
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4")
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4_5_02") Тогда 
			НомерТитула = 4;
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5")
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5_5_02") Тогда 
			НомерТитула = 5;
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул6") Тогда 
			НомерТитула = 6;
		Иначе
			ВызватьИсключение "Непредполагаемый тип документа";
		КонецЕсли;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ДокументТитула) Тогда
			ИдФайла = КонтурЛогистика_КонструкторыXDTO.ИдентификаторФайлаТитулаПЛ_5_02(НомерТитула, ДокТитул1.ЛицоОформившееПЛ, ДокТитул1.ОрганизацияМедик, 
				GUID, W);	
		Иначе
			ИдФайла = КонтурЛогистика_КонструкторыXDTO.ИдентификаторФайлаТитулаПЛ(НомерТитула, ДокТитул1.ЛицоОформившееПЛ, ДокТитул1.ОрганизацияМедик, 
				ДокТитул1.ОрганизацияТехСостояние, ДокТитул1.ОрганизацияОдометр, GUID, W);
		КонецЕсли;
	
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулДФ(ДокументТитула) Тогда
		
		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1") Тогда 
			ДокТитул1 = ДокументТитула;
		Иначе
			ДокТитул1 = ДокументТитула.Титул1;
		КонецЕсли;
		
		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1") Тогда 
			НомерТитула = 1;
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул2") Тогда 
			НомерТитула = 2;
		Иначе
			ВызватьИсключение "Непредполагаемый тип документа";
		КонецЕсли;
		
		ИдФайла = КонтурЛогистика_КонструкторыXDTO.ИдентификаторФайлаТитулаДФ(НомерТитула, 
																			?(ЗначениеЗаполнено(ДокТитул1.Составитель), ДокТитул1.Составитель, ДокТитул1.Фрахтователь),
																			ДокТитул1.Фрахтовщик,
																			GUID)
	
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ДокументТитула) Тогда 
		
		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
			И ДокументТитула.ЕстьОтказВПодписи Тогда 		
			
			Возврат КонтурЛогистика_КонструкторыXDTO.ИдентификаторФайлаУведомлений(ГлавныйДокумент.Грузоотправитель, ГлавныйДокумент.Перевозчик, GUID);
			
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
			И ДокументТитула.ЕстьОтказВПодписи Тогда	
			
			Возврат КонтурЛогистика_КонструкторыXDTO.ИдентификаторФайлаУведомлений(ГлавныйДокумент.Перевозчик, ГлавныйДокумент.Грузоотправитель, GUID);
			
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5") 
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6") Тогда  
			
			// Формат ИдФайл титулов: R_Т_A_ _О__GGGGMMDD_N
			Шаблон = НСтр("ru = '%1_%2_ _%3_ _%4_%5'");
			
		Иначе
			
			// Формат ИдФайл титулов: R_Т_A_E_О_W_GGGGMMDD_N
			Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6_%7'");
			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ГлавныйДокумент.ПогрузкуОсуществляет)
			И ГлавныйДокумент.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку Тогда 
			ИдГО 	= ГлавныйДокумент.ПогрузкуОсуществляет.ИдентификаторУчастникаЭДО;   // ЛОП вытесняет собой ГО в документообороте (кроме Т5, там остается ГО, как плательщик)
		Иначе
			ИдГО 	= ГлавныйДокумент.Грузоотправитель.ИдентификаторУчастникаЭДО; 
		КонецЕсли;
		ИдГоДляТ5 = ГлавныйДокумент.Грузоотправитель.ИдентификаторУчастникаЭДО; // в т5 всегда истинный ГО
		
		ИдПер 	= ГлавныйДокумент.Перевозчик.ИдентификаторУчастникаЭДО;

		ИдГП	= ГлавныйДокумент.Грузополучатель.ИдентификаторУчастникаЭДО; // для Т3 И Т4 может быть другим (ниже)

		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда

			R_Т = "ON_TRNACLGROT";
			A	= ИдПер;
			E	= ИдГП;
			O 	= ИдГО;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") Тогда

			R_Т = "ON_TRNACLPPRIN";
			A	= ИдГП;
			E	= ИдГО;
			O 	= ИдПер;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
			
			// это другой ГП
			Если ЗначениеЗаполнено(ДокументТитула.Грузополучатель) Тогда
				ИдГП = 	ДокументТитула.Грузополучатель.ИдентификаторУчастникаЭДО;
			КонецЕсли;

			R_Т = "ON_TRNACLGRPO";
			A	= ИдПер;
			E	= ИдГО;
			O 	= ИдГП;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4") Тогда
			
			// это другой ГП
			Если ЗначениеЗаполнено(ДокументТитула.Грузополучатель) Тогда
				ИдГП = 	ДокументТитула.Грузополучатель.ИдентификаторУчастникаЭДО;
			КонецЕсли;

			R_Т = "ON_TRNACLPVYN";
			A	= ИдГП;
			E	= ИдГО;
			O 	= ИдПер;
			
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5") Тогда
			
			R_Т = "ON_TRNPUDPER";
			A	= ИдГоДляТ5;
			O 	= ИдПер;
			
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6") Тогда

			R_Т = "ON_TRNPUDGO";
			A	= ИдПер;
			O 	= ИдГО;	

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7") Тогда

			R_Т = "ON_TRNPEREADR";
			A	= ИдГО;
			E 	= ИдГП;
			O 	= ИдПер;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8") Тогда

			R_Т = "ON_TRNZAMEN";
			A	= ИдГО;
			E 	= ИдГП;
			O 	= ИдПер;
			
		Иначе

			ВызватьИсключение "Непредполагаемый номер титула транспортной накладной";

		КонецЕсли;

		GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd"); // явно берем из сеанса, по часовому поясу сеанса
		N = Строка(GUID);

		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5") 
			Или ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")Тогда
			
			ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон,
																							  R_Т,
																							  A,
																							  O,
																							  GGGGMMDD,
																							  N);
			
		Иначе	
			
			W = 0;
			
			Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
				И ЗначениеЗаполнено(ДокументТитула.НовГрузПол) Тогда
				
				W = 1;	
				
				// указаны доп получатели
			Иначе
				
				ДополнительныеПолучателиФайла = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДопПолучателейФайла(ДокументТитула.ДокументЭТРН);
				Если ДополнительныеПолучателиФайла.Количество() > 0 Тогда				
					W = 1;					
				КонецЕсли;
				
			КонецЕсли;
			
			ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон,
																							  R_Т,
																							  A,
																							  E,
																							  O,
																							  W,
																							  GGGGMMDD,
																							  N);
  		КонецЕсли;

	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(ДокументТитула) Тогда
		
		// Формат ИдФайл титулов: R_Т_A_О_W_GGGGMMDD_N
		Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6'");
				
		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
			
			ИдГО 	= ДокументТитула.Грузоотправитель.ИдентификаторУчастникаЭДО;
			ИдПер 	= ДокументТитула.Перевозчик.ИдентификаторУчастникаЭДО;

			R_Т = "ON_ZAKZVGO";
			A	= ИдПер;
			O	= ИдГО;
			
		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда

			ИдГО 	= ДокументТитула.Титул1.Грузоотправитель.ИдентификаторУчастникаЭДО;
			ИдПер 	= ДокументТитула.Титул1.Перевозчик.ИдентификаторУчастникаЭДО;
			
			R_Т = "ON_ZAKZVPER";
			A	= ИдГО;
			O	= ИдПер;
			
		КонецЕсли;
		
		Если ДокументТитула.ДополнительныеПолучателиФайла.Количество() > 0 Тогда
			W = 1;
		Иначе
			W = 0;
		КонецЕсли;
		
		GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd"); // явно берем из сеанса, по часовому поясу сеанса
		N = Строка(GUID);
		
		ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон,
																							R_Т,
																							A,
																							O,
																							W,
																							GGGGMMDD,
																							N);
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗН(ДокументТитула) Тогда
		Шаблон = НСтр("ru = '%1_%2_%3_%4_%5'");

		ИдФТ 	= ГлавныйДокумент.Фрахтователь.ИдентификаторУчастникаЭДО;
		ИдФЩ 	= ГлавныйДокумент.Фрахтовщик.ИдентификаторУчастникаЭДО;

		Если ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул1") Тогда

			R_Т = "ON_ZAKAZNAR";
			A	= ИдФЩ;
			O 	= ИдФТ;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул2") Тогда

			R_Т = "ON_ZAKAZNARSOG";
			A	= ИдФТ;
			O 	= ИдФЩ;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул3") Тогда

			R_Т = "ON_ZAKAZNARPOD";
			A	= ИдФЩ;
			O 	= ИдФТ;

		ИначеЕсли ТипЗнч(ДокументТитула) = Тип("ДокументСсылка.КонтурЛогистика_ЗН_Титул4") Тогда

			R_Т = "ON_ZAKAZNARVOZ";
			A	= ИдФТ;
			O 	= ИдФЩ;

		Иначе

			ВызватьИсключение "Непредполагаемый номер титула заказ наряда";

		КонецЕсли;

		W = 0; // Всегда 0
		GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
		N = GUID;

		ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон,
																						  R_Т,
																						  A,
																						  O,
																						  GGGGMMDD,
																						  N);

	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулСВ(ДокументТитула) Тогда

		НомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ДокументТитула.ТипТитула);

		Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6'");

		ИдГО 	= ГлавныйДокумент.Грузоотправитель.ИдентификаторУчастникаЭДО;
		ИдПер 	= ГлавныйДокумент.Перевозчик.ИдентификаторУчастникаЭДО;
		ИдГП	= ГлавныйДокумент.Грузополучатель.ИдентификаторУчастникаЭДО;

		Если НомерТитула = "1" Тогда

			R_Т = "ON_SOPVEDPER1";

			A	= ИдГО;
			E	= ИдГП;
			O 	= ИдПер;

		ИначеЕсли НомерТитула = "2" Тогда

			R_Т = "ON_SOPVEDGO1";
			A	= ИдПер;
			E	= ИдГП;
			O 	= ИдГО;

		ИначеЕсли НомерТитула = "3" Тогда

			R_Т = "ON_SOPVEDPER2";

			A	= ИдГО;
			E	= ИдГП;
			O 	= ИдПер;

		ИначеЕсли НомерТитула = "4" Тогда

			R_Т = "ON_SOPVEDGO2";
			A	= ИдПер;
			E	= ИдГП;
			O 	= ИдГО;

		ИначеЕсли НомерТитула = "5" Тогда

			R_Т = "ON_SOPVEDPER3";

			A	= ИдГО;
			E	= ИдГП;
			O 	= ИдПер;

		ИначеЕсли НомерТитула = "6" Тогда

			R_Т = "ON_SOPVEDGP1";

			A	= ИдПер;
			E	= ИдГО;
			O 	= ИдГП;

		ИначеЕсли НомерТитула = "7" Тогда

			R_Т = "ON_SOPVEDPER5";

			A	= ИдГО;
			E	= ИдГП;
			O 	= ИдПер;

		ИначеЕсли НомерТитула = "8" Тогда

			R_Т = "ON_SOPVEDGP2";

			A	= ИдПер;
			E	= ИдГО;
			O 	= ИдГП;

		ИначеЕсли НомерТитула = "9" Тогда

			R_Т = "ON_SOPVEDPER4";

			A	= ИдГО;
			E	= ИдГП;
			O 	= ИдПер;

		Иначе
			ВызватьИсключение "Непредполагаемый номер титула Сопроводоительной ведомости";

		КонецЕсли;

		GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
		N = GUID;

		ИдФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Шаблон,
																						  R_Т,
																						  A,
																						  E,
																						  O,
																						  GGGGMMDD,
																						  N);

	Иначе

		ВызватьИсключение "Непредполагаемый тип ДокументТитула";

	КонецЕсли;
	
	Возврат ИдФайла;

КонецФункции	

// Функция - Отправить Выполняет отправку файла обмена из состояния Не отправлена
//
// Параметры:
//  ИгнорироватьПроверкуСостояния (необ) - Булево - Позволяет принудительно оправить из любого состояния, а не только из "Не отправлен"
// 
// Возвращаемое значение:
//  Структура - Стандартная структура возврата функции
//
Функция Отправить(ИгнорироватьПроверкуСостояния = Ложь) Экспорт
	
	ЭтоШаблон = ЗначениеЗаполнено(ОтправительШаблона);
	ЭтоДокументИзШаблона = (ЗначениеЗаполнено(ШаблонОснование)
		И Не ЗначениеЗаполнено(MessageID));
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если Не ЭтоШаблон И Не ЭтоДокументИзШаблона И ТребуетсяПодпись И Не ПодписьВерна Тогда
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Файл обмена " + Строка(Ссылка)
			+ " не содержит корректную подпись, при этом требуется подпись для отправки";
		
		Возврат Результат;
		
	КонецЕсли;
	
	Прочитать();
	
	ОтправитьЗапросБлокировкаНаложена = Истина;
	
	Попытка
		Заблокировать();
	Исключение
		// В случае блокировки - не выполнять отправку
		ОтправитьЗапросБлокировкаНаложена = Ложь;
		Результат.Успешно = Ложь;
		Результат.Массивошибок.Добавить("Файл обмена " + Код + " Ошибка при отправке: " + ОписаниеОшибки());
	КонецПопытки;
	
	Если ОтправитьЗапросБлокировкаНаложена Тогда
		
		Если ИгнорироватьПроверкуСостояния <> Истина
			И Состояние <> Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправлен
			И Состояние <> Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправленПодписан Тогда
			
			Результат.Успешно = Ложь;
			Результат.ОписаниеОшибки = "Файл обмена "
				+ Ссылка + " находится в состоянии "
				+ Состояние+ ", сначала переведите его в состояние ""Не отправлен""";
			
			Возврат Результат;
			
		КонецЕсли;
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
			
			ОтправитьДанныеГСМ();
		КонецЕсли;
		
		// Возможно потребуется добавить ДатаПланируемойОтправки , тогда раскомментировать:
		//Проверить что пришло время отправки
		//Если ЗначениеЗаполнено(ДатаПланируемойОтправки) И ДатаПланируемойОтправки > КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремениМСК() Тогда 
		//	Результат.Успешно = Ложь;
		//	Результат.Массивошибок.Добавить("Файл обмена " + Код + " должен быть отправлен не ранее " + ДатаПланируемойОтправки + " (МСК)");
		//	Возврат Результат;
		//КонецЕсли;
		
		РезультатОтправкиЗаявки = ВыполнитьЗапросОтправкиФайлаОбмена();
		
		Разблокировать();
		
		ЗаполнитьЗначенияСвойств(Результат, РезультатОтправкиЗаявки);
		
		// Добавим дату отправки
		Если КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика
			И ТипЗнч(РезультатОтправкиЗаявки) = Тип("Структура")
			И РезультатОтправкиЗаявки.Свойство("ДатаОтветаСервисаМСК")
			И ЗначениеЗаполнено(РезультатОтправкиЗаявки.ДатаОтветаСервисаМСК) Тогда
			
			Результат.Вставить("ДатаВремяМСК", РезультатОтправкиЗаявки.ДатаОтветаСервисаМСК);
		ИначеЕсли КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок
			И ЗначениеЗаполнено(ДатаЭДО) Тогда
			
			ДатаОтветаСервисаМСК = МестноеВремя(ДатаЭДО, "GMT+3");
			Результат.Вставить("ДатаВремяМСК", ДатаОтветаСервисаМСК);
		Иначе
			Результат.Вставить("ДатаВремяМСК", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени());
		КонецЕсли;
		
		// Добавляем в очередь получения и отправку QR-кода
		Если Результат.Успешно
			И ТребуетсяПодпись
			И ЗначениеЗаполнено(ГлавныйДокумент)
			И ЗначениеЗаполнено(СвязанныйДокумент) Тогда
			
			РегистрыСведений.КонтурЛогистика_ОчередьОтправкиQRКодов.ДобавитьВОчередь(ГлавныйДокумент, СвязанныйДокумент);
		КонецЕсли;
		
		// Заполним данные подписи в черновиках Т2 и Т4
		Если (ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
				Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
			И ПодписьВерна
			И ЗначениеЗаполнено(ГлавныйДокумент)
			И ЗначениеЗаполнено(СвязанныйДокумент)
			И Получатель.Наш Тогда
			
			Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				ТипТекущегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
				ТипСледующегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2;
				ИмяРеквизитаПроверки = "ЭПГО";
			Иначе
				ТипТекущегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
				ТипСледующегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4;
				ИмяРеквизитаПроверки = "ЭПГП";
			КонецЕсли;
			
			Попытка
				ТитулыСледующегоТитула = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитулыГлавногоПоТипу(
					ТипСледующегоТитула, ГлавныйДокумент);
				Если ТитулыСледующегоТитула.Количество() <> 0
					И Не ЗначениеЗаполнено(ТитулыСледующегоТитула[0][ИмяРеквизитаПроверки]) Тогда
					
					ТитулСледующегоТитула = ТитулыСледующегоТитула[0].ПолучитьОбъект();
					ТитулСледующегоТитула.ЗаполнитьУказателиНаПредыдущийТитул(СвязанныйДокумент, Ссылка);
					ТитулСледующегоТитула.Записать();
				КонецЕсли;
			Исключение
				ТекстОшибки = "Ошибка при обновлении подписи черновиков Т2 и Т4: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				КонтурЛогистика_Метрика.ОбработатьОшибку("НайтиСоздатьДокументыГлавныйИТитулПоФайлу", ТекстОшибки, Ссылка);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Инициирует отправку и отражает в файле состояние отправки, ошибки, полученные данные
// 
Функция ВыполнитьЗапросОтправкиФайлаОбмена()
	
	ЭтоШаблон = ЗначениеЗаполнено(ОтправительШаблона);
	ЭтоФайлДляПатча = ЗначениеЗаполнено(PatchedContentId);
	ЭтоДокументИзШаблона = (ЗначениеЗаполнено(ШаблонОснование)
		И Не ЗначениеЗаполнено(MessageID));
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда
			РезультатТранспорта = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьТитулТрНИзФайла(Ссылка);
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
			РезультатТранспорта = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьТитулПутевогоЛистаИзФайла(Ссылка);
		Иначе
			ВызватьИсключение "В канал API_КонтурЛогистика сейчас можно отправить только ЭТрН или ЭПЛ";
		КонецЕсли;
	
	Иначе
		
		Если ЭтоФайлДляПатча Тогда
			РезультатТранспорта = КонтурЛогистика_API_Диадок.ВыполнитьЗапросПатчаПодписьюФайлаОбмена(Ссылка);
		ИначеЕсли ЭтоДокументИзШаблона Тогда
			
			// Создаем файл из шаблона
			РезультатТранспорта = КонтурЛогистика_API_Диадок.ВыполнитьЗапросСозданияДокументаИзШаблона(Ссылка);
			Если РезультатТранспорта.Успешно Тогда
				Если РезультатТранспорта.РезультатОтправки.Свойство("Message") Тогда
					ДатаЭДО = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(
						РезультатТранспорта.РезультатОтправки.Message.TimestampTicks);
					DocumentId = Ссылка.ШаблонОснование.DocumentId;
					MessageId = РезультатТранспорта.РезультатОтправки.Message.MessageId;
					ПодписьВерна = Ложь;
					Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен;
					Записать();
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ЭтоШаблон Тогда
			РезультатТранспорта = КонтурЛогистика_API_Диадок.ВыполнитьЗапросОтправкиШаблона(Ссылка);
		Иначе
			РезультатТранспорта = КонтурЛогистика_API_Диадок.ВыполнитьЗапросОтправкиФайлаОбмена(Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатТранспорта.Успешно = Истина Тогда
		
		Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен;
		
		Если КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда
			
			Если РезультатТранспорта.Свойство("transportationId") Тогда
				kl_id = РезультатТранспорта.transportationId;
			ИначеЕсли РезультатТранспорта.Свойство("eplId") Тогда
				kl_id = РезультатТранспорта.eplId;
			Иначе
				kl_id = "";
			КонецЕсли;
			
			Если РезультатТранспорта.Свойство("draftId") И ЗначениеЗаполнено(РезультатТранспорта.draftId) Тогда 
				kl_draftId = РезультатТранспорта.draftId;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ГлавныйДокумент)
				И НЕ ЗначениеЗаполнено(ГлавныйДокумент.kl_id)
				И ЗначениеЗаполнено(kl_id) Тогда
				
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.kl_id = kl_id;
				ГлавныйДокументОбъект.Записать();
				
			КонецЕсли;
			
		Иначе
			
			Если ЭтоШаблон Тогда
				Если РезультатТранспорта.РезультатОтправки.Свойство("Template") Тогда
					ЗаполнитьИдентификаторыПослеОтправкиШаблона(РезультатТранспорта.РезультатОтправки.Template);
				КонецЕсли;
			Иначе
				Если РезультатТранспорта.РезультатОтправки.Свойство("Message") Тогда
					ЗаполнитьИдентификаторыПослеОтправкиПакета(РезультатТранспорта.РезультатОтправки.Message);
				Иначе
					ЗаполнитьИдентификаторыПослеОтправкиОтветногоТитула(РезультатТранспорта.РезультатОтправки.MessagePatch);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Записать();
		
		Если ЗначениеЗаполнено(СвязанныйДокумент) Тогда
			
			ТипСвязанногоДокумента = ТипЗнч(СвязанныйДокумент);
			
			НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена;
			
			Если (ТипСвязанногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2") 
				Или ТипСвязанногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6") 
				Или ТипСвязанногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул2") 
				Или ТипСвязанногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3")) 
				И СвязанныйДокумент.ЕстьОтказВПодписи Тогда 
				
				НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи;
				
			КонецЕсли;
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(СвязанныйДокумент, НовыйСтатусТитула);
			
			// Отправка сообщений с замечаниями
			Если НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
				И КонтурЛогистика_Уведомления.ТребуетсяОтправкаУведомленияОЗамечаниях(СвязанныйДокумент) Тогда
				
				ЭтоПогрузка = (ТипСвязанногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2"));
				Попытка
					КонтурЛогистика_Уведомления.ОтправитьУведомленияОЗамечанияхВодителя(
						ГлавныйДокумент, Неопределено, ЭтоПогрузка, СвязанныйДокумент);
				Исключение
					ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
					ТекстОшибки = "Ошибка при отправке файла: " + Строка(Ссылка) + "
						|Текст ошибки: " + ОписаниеОшибки();
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, Ссылка, ТекстОшибки);
				КонецПопытки;
			КонецЕсли;
			
			// Расчитаем особенности ДО
			Если НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена Тогда
				КонтурЛогистика_ОбработкаДокументовСервер.РасчетОсобенностейДокументооборота(СвязанныйДокумент);
			КонецЕсли;
			
		КонецЕсли;

	Иначе

		Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки;
		ОписаниеОшибок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатТранспорта);
		Записать();

		Если ЗначениеЗаполнено(СвязанныйДокумент) Тогда
			НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка;
			
			Если ЗначениеЗаполнено(РезультатТранспорта.РезультатОтправки) Тогда				
				СтруктураОшибки = СформироватьОшибкуОтправкиФайлаОбмена(РезультатТранспорта.РезультатОтправки);										
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(СвязанныйДокумент, НовыйСтатусТитула,,, СтруктураОшибки);
			Иначе
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(СвязанныйДокумент, НовыйСтатусТитула);
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат РезультатТранспорта;

КонецФункции 

Функция ОтправитьСогласование() Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Прочитать();
	
	ОтправитьЗапросБлокировкаНаложена = Истина;
	
	Попытка
		Заблокировать();
	Исключение
		
		// В случае блокировки - не выполнять отправку
		ОтправитьЗапросБлокировкаНаложена = Ложь;
		
		Результат.Успешно = Ложь;
		Результат.Массивошибок.Добавить("Файл обмена " + Код + " Ошибка при отправке: " + ОписаниеОшибки());
		
	КонецПопытки;
	
	Если Не ОтправитьЗапросБлокировкаНаложена Тогда
		Возврат Результат;
	КонецЕсли;
	
	РезультатОтправкиЗаявки = Новый Структура;
	
	Если ВтораяПодписьСостояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправлен
		Или ВтораяПодписьСостояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправленПодписан Тогда
		
		Если СогласующиеПодписи.Количество() <> 0 Тогда
			РезультатОтправкиЗаявки = ВыполнитьЗапросОтправкиСогласованияФайлаОбмена(СогласующиеПодписи[0]);
		КонецЕсли;
	КонецЕсли;
	
	Разблокировать();
	
	ЗаполнитьЗначенияСвойств(Результат, РезультатОтправкиЗаявки);
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьЗапросОтправкиСогласованияФайлаОбмена(ТекущаяСтрока)
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда
		ВызватьИсключение "В канал API_КонтурЛогистика не возможно согласовывать документы";
	КонецЕсли;
	
	РезультатТранспорта = КонтурЛогистика_API_Диадок.ВыполнитьЗапросПатчаСогласующейПодписьюФайлаОбмена(
		Ссылка, ТекущаяСтрока.ПользовательПодписант, ТекущаяСтрока.ПараметрНастроекПодписания);
	
	Если РезультатТранспорта.Успешно = Истина Тогда
		ТекущееСостояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен;
	Иначе
		ТекущееСостояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки;
		ОписаниеОшибок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатТранспорта);
	КонецЕсли;
	
	ВтораяПодписьСостояние = ТекущееСостояние;
	
	Записать();
	
	Возврат РезультатТранспорта;
	
КонецФункции

Процедура ОтправитьДанныеГСМ()
	
	ДанныеТитула1 = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(
		ГлавныйДокумент, "ЛицоОформившееПЛ, kl_id");
	ОтборДанных = Новый Структура;
	ОтборДанных.Вставить("ОрганизацияДиадок", ДанныеТитула1.ЛицоОформившееПЛ);
	ОтборДанных.Вставить("ТипДанных", РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ);
	ОтборДанных.Вставить("Разрез1", ДанныеТитула1.kl_id);
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
		
		ОтборДанных.Вставить("Разрез2", Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде);
		
		КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьПроизволныеДанные(ОтборДанных);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		
		ОтборДанных.Вставить("Разрез2", Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.Заправка);
		
		КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьПроизволныеДанные(ОтборДанных);
		
		//
		
		ОтборДанных.Вставить("Разрез2", Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаЗаезде);
		
		КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьПроизволныеДанные(ОтборДанных);
		
	КонецЕсли;
	
КонецПроцедуры

// структурно взята из ДД1С, полноcтью переписана на заполнение из метаданных КонтурЛогистика
Процедура ЗаполнитьИдентификаторыПослеОтправкиПакета(Message)
	
	ДатаСоздания = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(Message.TimestampTicks);

	Если Не ЗначениеЗаполнено(MessageID) Тогда 
		
		// новый пакет
		ДатаЭДО		= ДатаСоздания;
		MessageId	= Message.MessageId;
		
		Для Каждого Entity Из Message.Entities Цикл
			
			// Титул
			Если Entity.EntityType = "Attachment"
				И Entity.AttachmentType = "Title"
				И Entity.Свойство("DocumentInfo")
				И Entity.DocumentInfo.Свойство("CustomDocumentId")
				И Entity.DocumentInfo.CustomDocumentId = Формат(Код, "ЧГ=") Тогда
				
				DocumentId = Entity.EntityId;
				Если Entity.Свойство("PacketId") Тогда 
					PacketId = Entity.PacketId;
				КонецЕсли;
				
			КонецЕсли;
			
			// Доверенность
			Если Entity.EntityType = "Attachment"
				И Entity.AttachmentType = "PowerOfAttorney"
				И Entity.Свойство("PowerOfAttorneyInfo")
				И Entity.PowerOfAttorneyInfo.Свойство("FullId")
				И Entity.PowerOfAttorneyInfo.FullId.Свойство("RegistrationNumber")
				Тогда
				
				ИдентификаторМЧД = Entity.PowerOfAttorneyInfo.FullId.RegistrationNumber;
				
			КонецЕсли;
			
			// Иначе пока не обрабатываем другие Entities и AttachmentType

		КонецЦикла;

		Если Не ЗначениеЗаполнено(DocumentId) Тогда
			ВызватьИсключение "Из Диадока не получен DocumentId по файлу: " + Ссылка;
		КонецЕсли;

	Иначе
		
		// TODO неясен сценарий
		
	КонецЕсли;

КонецПроцедуры

