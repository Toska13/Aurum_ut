		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			
			ОргМедикСторонняя = ЗначениеЗаполнено(ДокументЗаказчик.ОрганизацияМедик) И ДокументЗаказчик.ОрганизацияМедик <> ДокументЗаказчик.ЛицоОформившееПЛ;
			
			НовыйФайлОбмена.Отправитель = ДокументЗаказчик.ЛицоОформившееПЛ;
			НовыйФайлОбмена.Получатель 	= ?(ОргМедикСторонняя, ДокументЗаказчик.ОрганизацияМедик, ДокументЗаказчик.ЛицоОформившееПЛ) ;
			НовыйФайлОбмена.ГлавныйДокумент = ДокументЗаказчик;
			
		Иначе
			
			Титул1 = ДокументЗаказчик.Титул1;
			НовыйФайлОбмена.ГлавныйДокумент = Титул1;
			
			Если  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
				
				Если Не ПолучитьДанные Тогда
					Если ДокументЗаказчик.ЕстьОтказВПодписи Тогда 
						// УоУ в случае отказа - это патч к титулу 1 - требуется положить в него MessageID и DocumentId исходного Т1
						ФайлТитула1 = НайтиФайлТитулаПоГлавномуДокументу(Титул1, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
						Если Не ЗначениеЗаполнено(ФайлТитула1) Тогда
							ВызватьИсключение "Не могу найти Файл Титула 1 для ПЛ " + Титул1 + " невозможно сформировать титул перевозчика";
						КонецЕсли;
						НовыйФайлОбмена.MessageID 		= ФайлТитула1.MessageID;
						НовыйФайлОбмена.DocumentId 		= ФайлТитула1.DocumentId;
					КонецЕсли;
				КонецЕсли;
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Отправитель = ?(ОргМедикСторонняя, Титул1.ОрганизацияМедик, Титул1.ЛицоОформившееПЛ);
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Отправитель = ?(ОргМедикСторонняя, Титул1.ОрганизацияМедик, Титул1.ЛицоОформившееПЛ);
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
				
				ОргТехСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияТехСостояние) И Титул1.ОрганизацияТехСостояние <> Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Отправитель = ?(ОргТехСторонняя, Титул1.ОрганизацияТехСостояние, Титул1.ЛицоОформившееПЛ);
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
				
				НовыйФайлОбмена.Отправитель = Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
				
				ОргОдометрСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияОдометр) И Титул1.ОрганизацияОдометр <> Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Отправитель = ?(ОргОдометрСторонняя, Титул1.ОрганизацияОдометр, Титул1.ЛицоОформившееПЛ);
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
				
				НовыйФайлОбмена.Отправитель = Титул1.ЛицоОформившееПЛ;
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				
				Если ОргМедикСторонняя И Титул1.ОбязМедосмотрПосле Тогда 
					НовыйФайлОбмена.Получатель = Титул1.ОрганизацияМедик;
				Иначе
					НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				КонецЕсли;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
				
				ОргОдометрСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияОдометр) И Титул1.ОрганизацияОдометр <> Титул1.ЛицоОформившееПЛ;
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				
				НовыйФайлОбмена.Отправитель = ?(ОргОдометрСторонняя, Титул1.ОрганизацияОдометр, Титул1.ЛицоОформившееПЛ);
				
				Если Не ОргОдометрСторонняя И ОргМедикСторонняя И Титул1.ОбязМедосмотрПосле Тогда 
					НовыйФайлОбмена.Получатель = Титул1.ОрганизацияМедик;
				Иначе
					НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				КонецЕсли;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Отправитель = ?(ОргМедикСторонняя, Титул1.ОрганизацияМедик, Титул1.ЛицоОформившееПЛ) ;
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			ИначеЕсли  ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
				
				ОргМедикСторонняя = ЗначениеЗаполнено(Титул1.ОрганизацияМедик) И Титул1.ОрганизацияМедик <> Титул1.ЛицоОформившееПЛ;
				НовыйФайлОбмена.Отправитель = ?(ОргМедикСторонняя, Титул1.ОрганизацияМедик, Титул1.ЛицоОформившееПЛ) ;
				НовыйФайлОбмена.Получатель = Титул1.ЛицоОформившееПЛ;
				
			Иначе	
				ВызватьИсключение "нужно прописать маршрутизацию для этого титула";
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ПолучитьДанные Тогда
			НовыйФайлОбмена.ОтправительПодразделение = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиОрганизацииДиадок(НовыйФайлОбмена.Отправитель, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.ПодразделениеОтправительПутевогоЛиста);
			НовыйФайлОбмена.ПолучательПодразделение = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиОрганизацииДиадок(НовыйФайлОбмена.Получатель, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.ПодразделениеПолучательПутевогоЛиста);
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
			
			// Пока только Диадок
			НовыйФайлОбмена.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок;
			НовыйФайлОбмена.ГлавныйДокумент = ДокументЗаказчик;
			
			ТекущийКодСостоянияДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ДокументЗаказчик.Ссылка);
			Если Не ЗначениеЗаполнено(ТекущийКодСостоянияДО) Тогда
				НовыйФайлОбмена.ОтправительШаблона = ДокументЗаказчик.ОтправительШаблона;
			КонецЕсли;
			
			НовыйФайлОбмена.Отправитель = ДокументЗаказчик.Экспедитор;
			НовыйФайлОбмена.Получатель = ДокументЗаказчик.Грузоотправитель;
			
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "Не предполагаемый титул";
		
	КонецЕсли;
	
	Возврат НовыйФайлОбмена;
	
КонецФункции

// вернет непомеченный на удаление, последний по КОДУ файл обмена документа
Функция КрайнийФайлДокумента(ДокументСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	|	И КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = &СвязанныйДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_ФайлыОбмена.Код УБЫВ";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", ДокументСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Возврат Выборка.Ссылка;
		
	Иначе 
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

// Возвращает таблицу значений с колонками ФайлОбмена и СвязанныйДокумент
//
// Параметры:
//  МассивДокументовЛогистика - массив ссылок документов, по которым хотим получить файлы
//  МассивСостояний - массив из допустимых значений перечисления КонтурЛогистика_СосотоянияФайловОбмена
//  СтатусПодписания - Число - один из вариантов:
//		0 - все (подписанные и неподписанные)
//		1 - только подписанные
//		2 - только неподписанные
//
Функция ТаблицаКрайниеФайлыСоСвязаннымиДокументами(МассивДокументовЛогистика, 
	МассивСостояний, СтатусПодписания = 0) Экспорт
	
	ВсеСостояния = МассивСостояний.Количество() = 0;
	НеЗависитОтПодписи = СтатусПодписания = 0;
	Подписан = СтатусПодписания = 1;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СвязанныеДокументы",  МассивДокументовЛогистика);
	Запрос.УстановитьПараметр("МассивСостояний", 	 МассивСостояний);
	Запрос.УстановитьПараметр("ВсеСостояния", 	 	 ВсеСостояния);
	Запрос.УстановитьПараметр("Подписан", 			 Подписан);
	Запрос.УстановитьПараметр("НеЗависитОтПодписи",  НеЗависитОтПодписи);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования) КАК ДатаВремяФормирования,
	|	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент КАК СвязанныйДокумент
	|ПОМЕСТИТЬ врКрайние
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	|	И КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент В(&СвязанныеДокументы)
	|	И (КонтурЛогистика_ФайлыОбмена.Состояние В (&МассивСостояний)
	|			ИЛИ &ВсеСостояния = ИСТИНА)
	|	И (КонтурЛогистика_ФайлыОбмена.ПодписьВерна = &Подписан
	|			ИЛИ &НеЗависитОтПодписи = ИСТИНА)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФайлыОбмена.Ссылка КАК ФайлОбмена,
	|	ФайлыОбмена.СвязанныйДокумент КАК СвязанныйДокумент
	|ИЗ
	|	врКрайние КАК врКрайние
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ФайлыОбмена КАК ФайлыОбмена
	|		ПО врКрайние.ДатаВремяФормирования = ФайлыОбмена.ДатаВремяФормирования
	|			И врКрайние.СвязанныйДокумент = ФайлыОбмена.СвязанныйДокумент";
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();
	
КонецФункции

Функция МассивДокументовСКрайнимиПолученнымиНеподписаннымиФайлами(МассивДокументовЛогистика) Экспорт
	
	ЗначениеПолучен = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеПеречисления("СосотоянияФайловОбмена", "Получен");
	
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(ЗначениеПолучен);
	
	Неподписанные = 2;
	
	ТаблицаКрайнихФайловДокументов = ТаблицаКрайниеФайлыСоСвязаннымиДокументами(
		МассивДокументовЛогистика, 
		МассивСостояний, 
		Неподписанные);
		
	ДокументыСПолученнымиНеподписанными = ТаблицаКрайнихФайловДокументов.ВыгрузитьКолонку(
		"СвязанныйДокумент");
	
	Возврат ДокументыСПолученнымиНеподписанными;
	
КонецФункции

Функция КрайниеФайлыДокументов(МассивДокументовЛогистика, ТолькоИсходящие = Ложь) Экспорт
	
	ДопустимыеСостояния = Новый Массив;
	Если ТолькоИсходящие Тогда
		ДопустимыеСостояния.Добавить(Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправлен);
		ДопустимыеСостояния.Добавить(Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправленПодписан);
		ДопустимыеСостояния.Добавить(Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен);
		ДопустимыеСостояния.Добавить(Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки);
	КонецЕсли;
	
	ТаблицаКрайнихФайловДокументов = ТаблицаКрайниеФайлыСоСвязаннымиДокументами(
		МассивДокументовЛогистика, ДопустимыеСостояния);
		
	КрайниеФайлы = ТаблицаКрайнихФайловДокументов.ВыгрузитьКолонку("ФайлОбмена");
	
	Возврат КрайниеФайлы;
	
КонецФункции

// вернет в том числе непомеченный на удаление, первый по ДатаВремяФормирования файл обмена документа
Функция ПервыйФайлДокумента(ДокументСсылка, Состояние = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	               |ГДЕ
	               |	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = &СвязанныйДокумент
	               |	И ВЫБОР
	               |			КОГДА &Состояние = НЕОПРЕДЕЛЕНО
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ КонтурЛогистика_ФайлыОбмена.Состояние В (&Состояние)
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", ДокументСсылка);
	Запрос.УстановитьПараметр("Состояние", Состояние);
	
