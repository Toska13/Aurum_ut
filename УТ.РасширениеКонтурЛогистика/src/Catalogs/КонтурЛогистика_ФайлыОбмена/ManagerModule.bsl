Функция ПолучитьСледующиеФайлыОбмена(ТекущийТитул) Экспорт
	
	ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьГлавныйДокументПоТитулу(ТекущийТитул); 
			
	МассивФайлов = Новый Массив;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТекущийТитул);
	ТекНомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипДокумента);
			
	ВсеФайлы = НайтиВсеФайлыПоГлавномуДокументу(ТекущийТитул.ДокументЭТрН);
	
	Для Каждого СтрокаФайла Из ВсеФайлы Цикл 
		
		Если Число(ТекНомерТитула) > СтрокаФайла.НомерТитула Тогда 
			Продолжить;	
		КонецЕсли;	
		
		МассивФайлов.Добавить(СтрокаФайла.Ссылка);
		
	КонецЦикла;	
	
	Возврат МассивФайлов;
	
КонецФункции

Функция НайтиВсеФайлыПоГлавномуДокументу(ГлавныйДокумент) Экспорт 
	
	ПостФиксТитула = "";
	Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
		ПоследнийНомерТитула = 8; // todo скоро будет 9
		ПрефиксТитула = "ТрН";
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда 	
		ПоследнийНомерТитула = 2;
		ПрефиксТитула = "ЗЗ";
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		ПоследнийНомерТитула = 6;
		ПрефиксТитула = "ПЛ";
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		ПоследнийНомерТитула = 5;
		ПрефиксТитула = "ПЛ";
		ПостФиксТитула = "_5_02";
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектронныйЗаказНаряд") Тогда 
		ПоследнийНомерТитула = 4;
		ПрефиксТитула = "ЗН";
	Иначе
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
					
	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	
	Для Сч = 1 По ПоследнийНомерТитула Цикл 
		
		ТекстПодЗапроса = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ФайлыОбмена.Ссылка,
		|	КонтурЛогистика_ФайлыОбмена.ТипДокумента,
		|	" + Сч + " КАК НомерТитула
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|ГДЕ
		|	НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
		|	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент = &ГлавныйДокумент
		|	И КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов." 
			+ ПрефиксТитула + "_Титул" + Строка(Сч) + ПостФиксТитула + ")";
		
		Если Не Сч = 1 Тогда 
			
			ТекстПодЗапроса = СтрЗаменить(ТекстПодЗапроса, " КАК НомерТитула", "");
			
		КонецЕсли;
		
		Если Не Сч = ПоследнийНомерТитула Тогда 
			
			ТекстПодЗапроса = ТекстПодЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";
			
		КонецЕсли;	
		
		ТекстЗапроса = ТекстЗапроса + ТекстПодЗапроса;
		
	КонецЦикла;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
		
	Возврат Запрос.Выполнить().Выгрузить(); 
	
КонецФункции	

// Понимает в зависимости от номера титула кто был исходным отправителем документа
Функция ОтправительИПолучательПоFileName(FileName, ВерсияДокумента = Неопределено) Экспорт
	
	ЭтоОтказВПодписи = (Лев(СокрЛП(FileName), 10) = "DP_UVUTOCH");
	
	Результат = Новый Структура();
	Результат.Вставить("Отправитель");
	Результат.Вставить("Получатель");
	
	ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(FileName,, ВерсияДокумента);
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			
			МассивКлючей_R_Т_A_E_F_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
			КлючA = МассивКлючей_R_Т_A_E_F_О_W[2];
			КлючE = МассивКлючей_R_Т_A_E_F_О_W[3];
			КлючF = МассивКлючей_R_Т_A_E_F_О_W[4];
			КлючО = МассивКлючей_R_Т_A_E_F_О_W[5];
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
			
			МассивКлючей_R_Т_A_E_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
			КлючA = МассивКлючей_R_Т_A_E_О_W[2];
			КлючE = МассивКлючей_R_Т_A_E_О_W[3];
			КлючО = МассивКлючей_R_Т_A_E_О_W[4];
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
			
			МассивКлючей_R_Т_A_О = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
			КлючA = МассивКлючей_R_Т_A_О[2];
			КлючО = МассивКлючей_R_Т_A_О[3];
			
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокумента) Тогда
			
			МассивКлючей_R_Т_A_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
			КлючA = МассивКлючей_R_Т_A_О_W[2];
			КлючО = МассивКлючей_R_Т_A_О_W[3];
			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокумента) Тогда
		
		МассивКлючей_R_Т_A_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
		
		КлючA = МассивКлючей_R_Т_A_О_W[2];
		КлючО = МассивКлючей_R_Т_A_О_W[3];
		
	ИначеЕсли ЭтоОтказВПодписи Тогда
		
		МассивКлючей_R_Т_A_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
		
		КлючA = МассивКлючей_R_Т_A_О_W[2];
		КлючО = МассивКлючей_R_Т_A_О_W[3];
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипДокумента) Тогда
		
		МассивКлючей_R_Т_A_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
		
		КлючA = МассивКлючей_R_Т_A_О_W[1];
		КлючО = МассивКлючей_R_Т_A_О_W[2];
		
	ИначеЕсли Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
			
			ПодготовленныйFileName = СтрЗаменить(FileName, "__", "_");
			
			МассивКлючей_R_Т_A_О = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ПодготовленныйFileName, "_");
			
			КлючA = МассивКлючей_R_Т_A_О[2];
			КлючО = МассивКлючей_R_Т_A_О[3];
			
		Иначе
			
			МассивКлючей_R_Т_A_E_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
			
			КлючA = МассивКлючей_R_Т_A_E_О_W[2];
			КлючE = МассивКлючей_R_Т_A_E_О_W[3];
			КлючО = МассивКлючей_R_Т_A_E_О_W[4];
			
			ОргE = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИдентификаторУчастникаЭДО", КлючE);
			
		КонецЕсли;
		
	Иначе
		
		МассивКлючей_R_Т_A_О_W = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(FileName, "_");
		
		КлючA = МассивКлючей_R_Т_A_О_W[2];
		КлючО = МассивКлючей_R_Т_A_О_W[3];
		
	КонецЕсли;
	
	ОргA = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиСоздатьПоИдентификаторуЭДО(КлючA);
	ОргО = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиСоздатьПоИдентификаторуЭДО(КлючО);
	
	// Транспортная накладная
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргE);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргE); 
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда 
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	// Заказ-Наряд и ПутевойЛист одинаково
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипДокумента)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокумента)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипДокумента) Тогда
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	ИначеЕсли ЭтоОтказВПодписи Тогда
		
		Результат.Вставить("Отправитель", ОргО);
		Результат.Вставить("Получатель", ОргA);
		
	Иначе
		
		ВызватьИсключение "непредполагаемый тип титула";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьПолучателяПоИдПолИной(ИдПолИной) Экспорт 
	
	// ИдПолИной - Идентификатор иного получателя файла обмена информации о переадресовке
	
	// TODO в структуре ИдПолИной может быть несколько идентификаторов от каких-либо смежных систем
	// если структура заполнена, то новый получатель в ней только один в случае с Т7
	
	Получатель = Неопределено;
	
	Если ЗначениеЗаполнено(ИдПолИной) И ТипЗнч(ИдПолИной) = Тип("Строка") Тогда 
		
		Получатель = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИдентификаторУчастникаЭДО", ИдПолИной);	
		
	КонецЕсли;	
	
	Возврат Получатель;
	
КонецФункции	

// необработанные полученные - по котором нет в системе док ЭТРН или док титул
Функция МассивНеобработанныхПолученныхФайлов() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	               |ГДЕ
	               |	КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен)
	               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	               |	И (КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент = ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПустаяСсылка)
	               |			ИЛИ КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = НЕОПРЕДЕЛЕНО)
	               |	И НЕ КонтурЛогистика_ФайлыОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка)
	               |	И КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования > &ОтсечкаДатаВремяФормирования
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования";
	
	
	Запрос.УстановитьПараметр("ОтсечкаДатаВремяФормирования", КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК() - 60*24*3600);
	
	Результат = Запрос.Выполнить();
	МассивНеобработанных = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивНеобработанных;
	
КонецФункции

Функция МассивФайловСНеобработаннымOuterDocflows() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбменаOuterDocflows.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена.OuterDocflows КАК КонтурЛогистика_ФайлыОбменаOuterDocflows
	|ГДЕ
	|	НЕ КонтурЛогистика_ФайлыОбменаOuterDocflows.Обработан
	|	И НЕ КонтурЛогистика_ФайлыОбменаOuterDocflows.Ссылка.ПометкаУдаления
	|	И НЕ КонтурЛогистика_ФайлыОбменаOuterDocflows.Ссылка.ГлавныйДокумент = НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ФайлыОбменаOuterDocflows.Ссылка";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция ШаблоныВМассивеФайлов(МассивФайлов) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка В(&МассивФайлов)
	|	И НЕ КонтурЛогистика_ФайлыОбмена.ОтправительШаблона = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПрототипыВМассивеФайлов(МассивФайлов) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.Ссылка В(&МассивФайлов)
	|	И КонтурЛогистика_ФайлыОбмена.КаналТранспорта = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика)
	|	И НЕ КонтурЛогистика_ФайлыОбмена.ТребуетсяПодпись";
	
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ФайлыВСостояниях(МассивСвязанныхДокументов, МассивИменСостояний) Экспорт
	
	МассивЗначенийСтатусов = Новый Массив;
	Для Каждого ИмяСостояния Из МассивИменСостояний Цикл
		
		МассивЗначенийСтатусов.Добавить(
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.%1)",
				ИмяСостояния));
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСвязанныхДокументов", МассивСвязанныхДокументов);
	Запрос.УстановитьПараметр("МассивСтатусов", МассивЗначенийСтатусов);
	Запрос.Текст = "ВЫБРАТЬ
   |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
   |ИЗ
   |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
   |ГДЕ
   |	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент В(&МассивСвязанныхДокументов)
   |	И КонтурЛогистика_ФайлыОбмена.Состояние В(%1)";
	
	Запрос.Текст = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(Запрос.Текст, 
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(МассивЗначенийСтатусов, ", "));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Патчить требуется либо входящие либо уже отправленные неподписанными
Функция НайтиФайлыКоторыеТребуетсяПатчить(МассивФайлов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК ФайлОбмена
	               |ИЗ
	               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	               |ГДЕ
	               |	КонтурЛогистика_ФайлыОбмена.Ссылка В(&МассивФайлов)
	               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПодписьВерна
	               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	               |	И (КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен)
	               |			ИЛИ КонтурЛогистика_ФайлыОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен))
	               |	И КонтурЛогистика_ФайлыОбмена.КаналТранспорта = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_КаналыТранспорта.Диадок)";
	
	ПолученныеНеподписанныеФайлы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ФайлОбмена");
	
	Возврат ПолученныеНеподписанныеФайлы;
	
КонецФункции

Функция ЭтоВходящийНеподписанный(ФайлСсылка) Экспорт
	
	Если ФайлСсылка = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(ФайлСсылка);
	
	ЗначениеВходящий   = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеПеречисления("СосотоянияФайловОбмена", "Получен");
	ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовСсылок(Ссылки, "ПодписьВерна,Состояние");
		
	ЭтоВходящийНеподписанный = Не ЗначенияРеквизитов[0].ПодписьВерна
		И ЗначенияРеквизитов[0].Состояние = ЗначениеВходящий;
		
	Возврат ЭтоВходящийНеподписанный;
	
КонецФункции

Функция ПодписьСогласующего(ФайлОбмена, ПользовательПодписант, ПараметрНастроекПодписания) Экспорт
	
	ПодписьСогласующего = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФайлОбмена", ФайлОбмена);
	Запрос.УстановитьПараметр("ПользовательПодписант", ПользовательПодписант);
	Запрос.УстановитьПараметр("ПараметрНастроекПодписания", ПараметрНастроекПодписания);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_ФайлыОбменаСогласующиеПодписи.Подпись КАК Подпись
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена.СогласующиеПодписи КАК КонтурЛогистика_ФайлыОбменаСогласующиеПодписи
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбменаСогласующиеПодписи.Ссылка = &ФайлОбмена
	|	И КонтурЛогистика_ФайлыОбменаСогласующиеПодписи.ПользовательПодписант = &ПользовательПодписант
	|	И КонтурЛогистика_ФайлыОбменаСогласующиеПодписи.ПараметрНастроекПодписания = &ПараметрНастроекПодписания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПодписьСогласующего = Выборка.Подпись.Получить();
	КонецЕсли;
	
	Возврат ПодписьСогласующего;
	
КонецФункции

Функция РазличныеУИДВCustomDataФайла(ФайлОбмена) Экспорт
	
	Если Не ЗначениеЗаполнено(ФайлОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Key", "mt-id");
	
	массивУИД = ФайлОбмена.CustomData.НайтиСтроки(Отбор);
		
	массивРазличныхУИД = Новый Массив;
	
	Для каждого Стр Из массивУИД Цикл
		
		НайдУИД = массивРазличныхУИД.Найти(Стр.Value);
		Если НайдУИД = Неопределено Тогда
			массивРазличныхУИД.Добавить(Стр.Value);
		КонецЕсли;
		
	КонецЦикла;
		
	Возврат массивРазличныхУИД.Количество() > 1;	
	
КонецФункции
