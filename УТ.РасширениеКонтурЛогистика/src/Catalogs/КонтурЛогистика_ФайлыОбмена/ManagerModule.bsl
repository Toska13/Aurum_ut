Процедура ЗаписатьПодписьИРазблокировать(ФайлОбменаСсылка, ДанныеПодписи, ДанныеСертификата) Экспорт
	
	ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
	ФайлОбменаОбъект.Подпись = Новый ХранилищеЗначения(ДанныеПодписи);
	
	Если ДанныеСертификата.Свойство("Отпечаток") Тогда
		ФайлОбменаОбъект.Отпечаток = ДанныеСертификата.Отпечаток;
	КонецЕсли;
	Если ДанныеСертификата.Свойство("Представление") Тогда
		ФайлОбменаОбъект.КомуВыданСертификат = ДанныеСертификата.Представление;	
	КонецЕсли;
	Если ДанныеСертификата.Свойство("СертификатНаСервере") Тогда
		ФайлОбменаОбъект.СертификатНаСервере = ДанныеСертификата.СертификатНаСервере;
	КонецЕсли;
	
	ФайлОбменаОбъект.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправленПодписан;
	ФайлОбменаОбъект.ПодписьВерна = Истина;
			
	ФайлОбменаОбъект.Записать();
	ФайлОбменаОбъект.Разблокировать();
	
КонецПроцедуры

Процедура ЗаписатьПодписьСогласовавшегоИРазблокировать(ФайлОбменаСсылка, ДанныеПодписи, ДанныеСертификата) Экспорт
	
	ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
	
	Если ФайлОбменаОбъект.СогласующиеПодписи.Количество() = 0 Тогда
		ТекущаяСтрока = ФайлОбменаОбъект.СогласующиеПодписи.Добавить();
	Иначе
		ТекущаяСтрока = ФайлОбменаОбъект.СогласующиеПодписи[0];
	КонецЕсли;
	
	ТекущаяСтрока.ПользовательПодписант = ДанныеСертификата.ПользовательПодписант;
	ТекущаяСтрока.ПараметрНастроекПодписания = ДанныеСертификата.ПараметрНастроекПодписания;
	
	ТекущаяСтрока.Подпись = Новый ХранилищеЗначения(ДанныеПодписи);
	ТекущаяСтрока.Отпечаток = ДанныеСертификата.Отпечаток;
	ТекущаяСтрока.КомуВыданСертификат = ДанныеСертификата.Представление;
	ТекущаяСтрока.СертификатНаСервере = ДанныеСертификата.СертификатНаСервере;
	
	ФайлОбменаОбъект.ВтораяПодписьВерна = Истина;
	ФайлОбменаОбъект.ВтораяПодписьСостояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправленПодписан;
	
	ФайлОбменаОбъект.Записать();
	ФайлОбменаОбъект.Разблокировать();
	
КонецПроцедуры

