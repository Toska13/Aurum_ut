
// Создает в базе новый элемент справочника КонтурЛогистика_ФайлыОбмена по переданному тексту и параметрам
//
// Параметры:
//  ТекстФайла		 - Строка - Текст xml отправляемого в диадок формализованного Титула в утвержденном формате
//  ТипДокумента	 - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - что за титул
//  ДокументЗаказчик - ДокументСсылка - (необ) - привязать файл обмена к конкретному документу-титулу. Стороны обмена будут взяты из документа
//  Отправитель		 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - (необ) обязательно передавать при отсутствии ДокументЗаказчик
//  Получатель		 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - (необ) обязательно передавать при отсутствии ДокументЗаказчик
// 
// Возвращаемое значение:
//  Структура - стандартная структура возврата - см. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция СоздатьФайлОбмена(РезультатФормированияТекста, ТипДокумента, ПараметрыФайлаРеквизиты, ДокументЗаказчик = Неопределено, Отправитель = Неопределено, Получатель = Неопределено) Экспорт
	
	ТекстФайла = РезультатФормированияТекста.ТекстФайла;
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("Файл", Неопределено);
	
	Попытка
		
		НовыйФайлОбмена = СоздатьЭлемент();
		
		// Все переданные параметры присвоим в создаваемый файл
		КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьПараметрыФормированияФайла(НовыйФайлОбмена, ПараметрыФайлаРеквизиты);
		
		// Необходимость отправки подписанного/неподписанного, если не была задана в ПараметрыФайлаРеквизиты
		// может быть определена по настр. конв. док.
		Если ПараметрыФайлаРеквизиты = Неопределено
			Или Не ПараметрыФайлаРеквизиты.Свойство("ТребуетсяПодпись") Тогда
			
			Если ЗначениеЗаполнено(ДокументЗаказчик) 
				И ЗначениеЗаполнено(ДокументЗаказчик.ДокументОснование) Тогда
				
				НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
					ТипДокумента, ДокументЗаказчик.ДокументОснование);
				Если НастройкаКонвертации <> Неопределено Тогда
					НовыйФайлОбмена.ТребуетсяПодпись = Не НастройкаКонвертации.Сценарий_ОтправлятьНеподписанный;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ПараметрыФайлаРеквизиты) = Тип("Структура") Тогда
			
			Если ПараметрыФайлаРеквизиты.Свойство("ТребуетсяПодпись") Тогда
				НовыйФайлОбмена.ТребуетсяПодпись = ПараметрыФайлаРеквизиты.ТребуетсяПодпись;
			КонецЕсли;
			
			Если ПараметрыФайлаРеквизиты.Свойство("ПередатьНаПодписание") Тогда
				НовыйФайлОбмена.ПередатьНаПодписание = Истина;
			КонецЕсли;
			
			Если ПараметрыФайлаРеквизиты.Свойство("ПередатьНаСогласованиеВодителю") Тогда
				НовыйФайлОбмена.ПередатьНаСогласованиеВодителю = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		НовыйФайлОбмена.ТекстXML = Новый ХранилищеЗначения(ТекстФайла, Новый СжатиеДанных(9));
		НовыйФайлОбмена.GUID = РезультатФормированияТекста.GUID;
		НовыйФайлОбмена.ИмяФайла = РезультатФормированияТекста.ИдФайл;
		
		Если РезультатФормированияТекста.Свойство("ИдентификаторМЧД") Тогда
			НовыйФайлОбмена.ИдентификаторМЧД = РезультатФормированияТекста.ИдентификаторМЧД;
			НовыйФайлОбмена.СпособПередачиМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособПередачиМЧД");
			НовыйФайлОбмена.ДоставкаМЧДФайлом = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ДоставкаМЧДФайлом");
			
			// особенность отправки в адрес торговых сетей - способ передачи МЧД
			Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
					И ЗначениеЗаполнено(ДокументЗаказчик)
					И ЗначениеЗаполнено(ДокументЗаказчик.ДокументЭТРН)
					И ЗначениеЗаполнено(ДокументЗаказчик.ДокументЭТРН.ПартнерГрузополучатель) Тогда
					
			НовыйФайлОбмена.СпособПередачиМЧД 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособПередачиМЧД", ДокументЗаказчик.ДокументЭТРН.ПартнерГрузополучатель);
			НовыйФайлОбмена.ДоставкаМЧДФайлом	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ДоставкаМЧДФайлом", ДокументЗаказчик.ДокументЭТРН.ПартнерГрузополучатель);
			
			КонецЕсли;
		
		КонецЕсли;
		
		НовыйФайлОбмена.ТипДокумента = ТипДокумента;
		НовыйФайлОбмена.Состояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.НеОтправлен");
		НовыйФайлОбмена.СоздавшийПользователь = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
		
		Если ЗначениеЗаполнено(ДокументЗаказчик) Тогда
			
			НовыйФайлОбмена.СвязанныйДокумент 	= ДокументЗаказчик;
			НовыйФайлОбмена.ПользовательПодписант 	= ДокументЗаказчик.ПользовательПодписант;
			НовыйФайлОбмена.ПараметрНастроекПодписания = ДокументЗаказчик.ПараметрНастроекПодписания;
			
			ПолучитьОсновныеДанныеФайла(ДокументЗаказчик, ТипДокумента, НовыйФайлОбмена);
			
		Иначе
			
			Если ЗначениеЗаполнено(Отправитель) Тогда
				НовыйФайлОбмена.Отправитель = Отправитель;
			Иначе
				ВызватьИсключение "Не передан Отправитель сообщения";
			КонецЕсли;
			Если ЗначениеЗаполнено(Получатель) Тогда
				НовыйФайлОбмена.Получатель = Получатель;
			Иначе
				ВызватьИсключение "Не передан Получатель сообщения";
			КонецЕсли;
			
		КонецЕсли;
		
		НовыйФайлОбмена.ВерсияФормата = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ФорматОбмена(ТипДокумента);
		НовыйФайлОбмена.ВерсияПрограммы = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
		
		// Вызов подключаемого модуля
		КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ФайлОбмена_ПриСоздании",, НовыйФайлОбмена);
		
		Если (НовыйФайлОбмена.ПередатьНаПодписание Или НовыйФайлОбмена.ПередатьНаСогласованиеВодителю)
			И НовыйФайлОбмена.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок Тогда
			
			ТекстОшибки = "Нельзя передать на подписание и на согласование водителю, если обмен выполняется только через Диадок.
				|Необходимо в стартовом помощнике выбрать использование ApiKey Логистика и заполнить ключ для организации.";
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		НовыйФайлОбмена.Записать();
		
		Результат.Успешно = Истина;
		Результат.Вставить("Файл", НовыйФайлОбмена.Ссылка);
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.МассивОшибок.Добавить("Не удалось создать заявку в базе по причине: " + ОписаниеОшибки())
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Заполняет данные файла в зависимости от титула. Если Файл в параметрах не указан, то возвращает стуктуру
// с заполненными реквизитами файла.
Функция ПолучитьОсновныеДанныеФайла(ДокументЗаказчик, ТипДокумента = Неопределено, НовыйФайлОбмена = Неопределено) Экспорт
	
	Если НовыйФайлОбмена = Неопределено Тогда
		НовыйФайлОбмена = Новый Структура;
		Для каждого Реквизит Из Метаданные.Справочники.КонтурЛогистика_ФайлыОбмена.Реквизиты Цикл
			НовыйФайлОбмена.Вставить(Реквизит.Имя);
		КонецЦикла;
		ПолучитьДанные = Истина;	
	Иначе
		ПолучитьДанные = Ложь;	
	КонецЕсли;
	
	Если ТипДокумента = Неопределено Тогда
		ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументЗаказчик.Ссылка);
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			
			ДокументЭТРН = ДокументЗаказчик.ДокументЭТРН;
			Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
				ВызватьИсключение "Не привязан документ эТрН";
			КонецЕсли;
			НовыйФайлОбмена.ГлавныйДокумент = ДокументЭТРН;
			НовыйФайлОбмена.ОтправительШаблона = ДокументЗаказчик.ОтправительШаблона;
			
			НовыйФайлОбмена.ОтправительПодразделение 	= ДокументЭТРН.ГрузоотправительПодразделение;
			НовыйФайлОбмена.ПолучательПодразделение 	= ДокументЭТРН.ПеревозчикПодразделение;
			
			Если ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку И ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет) Тогда 
				НовыйФайлОбмена.Отправитель = ДокументЭТРН.ПогрузкуОсуществляет;
				НовыйФайлОбмена.ОтправительПодразделение 	= ДокументЭТРН.ПогрузкуОсуществляетПодразделение;			
			Иначе
				НовыйФайлОбмена.Отправитель = ДокументЭТРН.Грузоотправитель;
			КонецЕсли;
			
			НовыйФайлОбмена.Получатель 	= ДокументЭТРН.Перевозчик;
			
			// если отправитель не наш и указан отдельный составитель, должен отправляться в апи логистики
			Если ЗначениеЗаполнено(НовыйФайлОбмена.Составитель)
				И Не НовыйФайлОбмена.Отправитель.Наш Тогда
				
				НовыйФайлОбмена.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
				НовыйФайлОбмена.ТребуетсяПодпись = Ложь;
				
			КонецЕсли;
			
			Если ДокументЗаказчик.ЭтоПрототип
				Или ЗначениеЗаполнено(ДокументЗаказчик.Составитель) И ДокументЗаказчик.Составитель <> ДокументЗаказчик.ДокументЭТРН.Грузоотправитель Тогда
				
				НовыйФайлОбмена.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
				НовыйФайлОбмена.ТребуетсяПодпись = Ложь;
			КонецЕсли;
			
			ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(НовыйФайлОбмена.Отправитель);
			Если ПараметрыСервиса.АвторизацияВыполнена Тогда
				НовыйФайлОбмена.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументЭТРН.kl_id) Тогда 
				НовыйФайлОбмена.kl_id 		= ДокументЭТРН.kl_id;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда
			
			ДокументЭТРН = ДокументЗаказчик.ДокументЭТРН;
			Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
				ВызватьИсключение "Не привязан документ эТрН";
			КонецЕсли;
			НовыйФайлОбмена.ГлавныйДокумент = ДокументЭТРН;
			
			НовыйФайлОбмена.Отправитель = ДокументЭТРН.Перевозчик;
			
			НовыйФайлОбмена.ОтправительПодразделение 	= ДокументЭТРН.ПеревозчикПодразделение;
			НовыйФайлОбмена.ПолучательПодразделение 	= ДокументЭТРН.ГрузоотправительПодразделение;
			
			Если ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку И ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет) Тогда 
				НовыйФайлОбмена.Получатель = ДокументЭТРН.ПогрузкуОсуществляет;
				НовыйФайлОбмена.ПолучательПодразделение 	= ДокументЭТРН.ПогрузкуОсуществляетПодразделение;
			Иначе
				НовыйФайлОбмена.Получатель 	= ДокументЭТРН.Грузоотправитель;
			КонецЕсли;
			
			НовыйФайлОбмена.kl_id 		= ДокументЭТРН.kl_id;
			
			Если Не ПолучитьДанные Тогда
				// титул 2 технологически - это патч к титулу 1 - требуется положить в него MessageID и DocumentId исходного Т1
				ФайлТитула1 = НайтиФайлТитулаПоГлавномуДокументу(ДокументЭТРН, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
				Если Не ЗначениеЗаполнено(ФайлТитула1) Тогда
					ВызватьИсключение "Не могу найти Файл Титула 1 для ЭТрН " + ДокументЭТРН + " невозможно сформировать титул перевозчика";
				КонецЕсли;
				НовыйФайлОбмена.MessageID 		= ФайлТитула1.MessageID;
				НовыйФайлОбмена.DocumentId 		= ФайлТитула1.DocumentId;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			
			ДокументЭТРН = ДокументЗаказчик.ДокументЭТРН;
			Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
				ВызватьИсключение "Не привязан документ эТрН";
			КонецЕсли;
			НовыйФайлОбмена.ГлавныйДокумент = ДокументЭТРН;
			
			Если ЗначениеЗаполнено(ДокументЗаказчик.Грузополучатель) Тогда 
				НовыйФайлОбмена.Отправитель = ДокументЗаказчик.Грузополучатель;
			Иначе
				НовыйФайлОбмена.Отправитель = ДокументЭТРН.Грузополучатель;
			КонецЕсли;
			
			НовыйФайлОбмена.Получатель 	= ДокументЭТРН.Перевозчик;
			
			НовыйФайлОбмена.ОтправительПодразделение 	= ДокументЭТРН.ГрузополучательПодразделение;
			НовыйФайлОбмена.ПолучательПодразделение 	= ДокументЭТРН.ПеревозчикПодразделение;
			НовыйФайлОбмена.kl_id 		= ДокументЭТРН.kl_id;
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
			
			ДокументЭТРН = ДокументЗаказчик.ДокументЭТРН;
			Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
				ВызватьИсключение "Не привязан документ эТрН";
			КонецЕсли;
			
			НовыйФайлОбмена.ГлавныйДокумент = ДокументЭТРН;
			НовыйФайлОбмена.Отправитель = ДокументЭТРН.Перевозчик;
			НовыйФайлОбмена.Получатель 	= ДокументЭТРН.Грузополучатель;
			НовыйФайлОбмена.kl_id 		= ДокументЭТРН.kl_id;
			
			Если ЗначениеЗаполнено(ДокументЗаказчик.Грузополучатель) Тогда 
				НовыйФайлОбмена.Получатель = ДокументЗаказчик.Грузополучатель;
			Иначе
				НовыйФайлОбмена.Получатель = ДокументЭТРН.Грузополучатель;
			КонецЕсли;
			
			НовыйФайлОбмена.ОтправительПодразделение 	= ДокументЭТРН.ПеревозчикПодразделение;
			НовыйФайлОбмена.ПолучательПодразделение 	= ДокументЭТРН.ГрузополучательПодразделение;
			
			Если Не ПолучитьДанные Тогда
				// титул 4 технологически - это патч к титулу 3 - требуется положить в него MessageID и DocumentId исходного Т3
