#Область ПрограммныйИнтерфейс

Функция ПолучитьОписаниеКлючейПоиска() Экспорт
	
	// Поиск лицензии осуществляется по:
	// 1. Владелец + Серия + Номер
	// 2. Владелец + Номер
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	КлючиПоиска = Новый Массив;
	
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "Владелец,Серия,Номер", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "Владелец,Номер", ШаблонСтрокиПоиска);
	
	Возврат КлючиПоиска;
	
КонецФункции

Функция ТекстОшибкиНеЗаполненыКлючевыеРеквизиты() Экспорт
	
	ТекстОшибки = "Ошибка при поиске Лицензии. Не заполнен один из ключевых реквизитов в одном из вариантов поиска: 
		|1. Владелец + Серия + Номер
		|2. Владелец + Номер";
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция НайтиЛицензиюПоНомерСерии(НомерЛицензии, СерияЛицензии = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛицензии", НомерЛицензии);
	Запрос.УстановитьПараметр("СерияЛицензии", СерияЛицензии);
	Запрос.УстановитьПараметр("ЗаполненаСерияЛицензии", ЗначениеЗаполнено(СерияЛицензии));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_Лицензии.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Лицензии КАК КонтурЛогистика_Лицензии
	|ГДЕ
	|	НЕ КонтурЛогистика_Лицензии.ПометкаУдаления
	|	И КонтурЛогистика_Лицензии.Номер = &НомерЛицензии
	|	И ВЫБОР
	|			КОГДА &ЗаполненаСерияЛицензии
	|				ТОГДА КонтурЛогистика_Лицензии.Серия = &СерияЛицензии
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

