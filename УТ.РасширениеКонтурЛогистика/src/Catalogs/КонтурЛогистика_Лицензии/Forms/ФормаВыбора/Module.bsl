
// ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектУчетнойСистемы", ОбъектУчетнойСистемы);
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		СуществующееСопоставление = КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(ОбъектУчетнойСистемы, "ТранспортноеСредство");
		
		Элементы.СуществующееСопоставление.Видимость = ЗначениеЗаполнено(СуществующееСопоставление);
		
		Элементы.ГруппаСвязанныйОбъект.Видимость = Истина;
		Элементы.ОбъектУчетнойСистемы.ТолькоПросмотр = Истина;
		ОбъектУчетнойСистемыУстановитьСвязь = Истина;
		Элементы.Список.МножественныйВыбор = Ложь;
		Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		
	Иначе
		
		Элементы.ГруппаСвязанныйОбъект.Видимость = Ложь;
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере_ФормаВыбора(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

// ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
	Выбрать(Неопределено);
	
КонецПроцедуры

// ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда
			
			ТекстВопроса = Строка(ОбъектУчетнойСистемы) + " уже сопоставлен с " + Строка(СуществующееСопоставление)
				+ ". Создать еще одно сопоставление?";
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Создать");
			Кнопки.Добавить("Отменить");
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, Кнопки,,, ЭтаФорма, "ОбработчикВопросаПоСопоставлению");
			
		Иначе
			
			Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
				УстановитьСвязьСОбъектом();
			КонецЕсли;
			
			ЗакрытьФормуВыборомЗначения();
			
		КонецЕсли;
	Иначе
		ЗакрытьФормуВыборомЗначения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюЛицензию(Команда)
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ОбъектУчетнойСистемыСсылка", ОбъектУчетнойСистемы);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
		
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_Лицензии.ФормаОбъекта", ПараметрыФормы,, ЭтаФорма, "ОбработчикСозданиеОбъекта");
	
КонецПроцедуры

// СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработчикВопросаПоСопоставлению(ПараметрОбработчика, ДополнительныеПараметры) Экспорт
	
	Если ПараметрОбработчика = "Создать" Тогда
		
		Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
			УстановитьСвязьСОбъектом();
		КонецЕсли;
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСвязьСОбъектом()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не могу определить выбранную строку");
		Возврат;
		
	КонецЕсли;
	
	УстановитьСвязьСервер(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязьСервер(Ссылка)
	
	Если Ссылка.ПометкаУдаления Тогда
		ВызватьИсключение "Невозможно создать сопоставление т.к. Организация Диадок помечена на удаление.
			|Выберите другую Организацию или снимите пометку удаления.";
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыСервер.УстановитьСвязьОбъектовЛогистикаУчСист(Ссылка, ОбъектУчетнойСистемы);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуВыборомЗначения()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	ВыбранноеЗначение = ТекущиеДанные.Ссылка;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ОповеститьОВыборе(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСозданиеОбъекта(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	// Проверить что создали новое и связали с объектом и закрыть эту форму
	СозданнаяЛицензия = СозданнаяЛицензия(ОбъектУчетнойСистемы);
	Если ЗначениеЗаполнено(СозданнаяЛицензия) Тогда
		ОповеститьОВыборе(СозданнаяЛицензия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СозданнаяЛицензия(ОбъектУчСист = Неопределено)
	
	Если ЗначениеЗаполнено(ОбъектУчСист) Тогда
		
		СуществующееСопоставление = КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(
			ОбъектУчСист, "ТранспортноеСредство");
		
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда
			Возврат СуществующееСопоставление;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции
