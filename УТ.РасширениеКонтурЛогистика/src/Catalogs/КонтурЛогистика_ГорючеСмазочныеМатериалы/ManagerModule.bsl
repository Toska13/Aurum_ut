// Возвращает описание ключей поиска элемента справочника
// 
// Возвращаемое значение:
//  Массив - описание ключей поиска, см. КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам
//
Функция ПолучитьОписаниеКлючейПоиска() Экспорт
	
	// Поиск ГСМ осуществляется по:
	// 1. Наименование + ТипТоплива + ВидТоплива
	// 2. Наименование
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	КлючиПоиска = Новый Массив;
	
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "Наименование,ТипТоплива,ВидТоплива", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "Наименование", ШаблонСтрокиПоиска);
	
	Возврат КлючиПоиска;
	
КонецФункции

// Текст ошибки не заполнены ключевые реквизиты
// 
// Возвращаемое значение:
//  Строка - описание ошибки
//
Функция ТекстОшибкиНеЗаполненыКлючевыеРеквизиты() Экспорт
	
	ТекстОшибки = "Ошибка при поиске Горюче-смазочных материалов. Не заполнен один из ключевых реквизитов в одном из вариантов поиска:
		|1. Наименование + ТипТоплива + ВидТоплива
		|2. Наименование";
	
	Возврат ТекстОшибки;
	
КонецФункции

// Получает горюче-смазочный материал
//
// Параметры:
//  ТипТоплива		 - ПеречислениеСсылка.КонтурЛогистика_ТипыТоплива	 - тип топлива
//  ВидТоплива		 - ПеречислениеСсылка.КонтурЛогистика_ВидыТоплива	 - вид топлива
//  ВидТопливаПрочее - Строка	 - вид топливо для прочих
//  ЕдиницаИзмерения - Строка	 - единица измерения
//  СоздаватьНовый	 - Булево	 - признак создавать новый, если не нашли по параметрам
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_ГорючеСмазочныеМатериалы - найденный горюче-смазочный материал
//
Функция ПолучитьГорючеСмазочныйМатериал(ТипТоплива, ВидТоплива, ВидТопливаПрочее, ЕдиницаИзмерения, СоздаватьНовый = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипТоплива", ТипТоплива);
	Запрос.УстановитьПараметр("ВидТоплива", ВидТоплива);
	Запрос.УстановитьПараметр("ВидТопливаПрочее", ВидТопливаПрочее);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ГорючеСмазочныеМатериалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ГорючеСмазочныеМатериалы КАК КонтурЛогистика_ГорючеСмазочныеМатериалы
	|ГДЕ
	|	НЕ КонтурЛогистика_ГорючеСмазочныеМатериалы.ПометкаУдаления
	|	И НЕ КонтурЛогистика_ГорючеСмазочныеМатериалы.ЭтоГруппа
	|	И КонтурЛогистика_ГорючеСмазочныеМатериалы.ТипТоплива = &ТипТоплива
	|	И КонтурЛогистика_ГорючеСмазочныеМатериалы.ВидТоплива = &ВидТоплива
	|	И КонтурЛогистика_ГорючеСмазочныеМатериалы.ВидТопливаПрочее = &ВидТопливаПрочее
	|	И КонтурЛогистика_ГорючеСмазочныеМатериалы.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Если Не СоздаватьНовый Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	// Создадим новый	
	НовыйЭлемент = СоздатьНовыйГорючеСмазочныйМатериал(ТипТоплива, ВидТоплива, ВидТопливаПрочее, ЕдиницаИзмерения);
	
	Возврат НовыйЭлемент;
	
КонецФункции

Функция СоздатьНовыйГорючеСмазочныйМатериал(ТипТоплива, ВидТоплива, ВидТопливаПрочее, ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору = Неопределено) Экспорт
	
	НовыйЭлемент = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.СоздатьЭлемент();
	
	Если ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas Тогда
		НовыйЭлемент.Родитель = НайтиДобавитьГруппу("СжатыйПриродныйГаз");
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Diesel Тогда
		НовыйЭлемент.Родитель = НайтиДобавитьГруппу("ДизельноеТопливо");
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline Тогда
		НовыйЭлемент.Родитель = НайтиДобавитьГруппу("Бензин");
	Иначе
		НовыйЭлемент.Родитель = НайтиДобавитьГруппу("Другие", "Другие");
	КонецЕсли;
	
	НовыйЭлемент.Наименование = СформироватьНаименованиеЭлемента(ТипТоплива, ВидТоплива, ВидТопливаПрочее);
	НовыйЭлемент.ТипТоплива = ТипТоплива;
	НовыйЭлемент.ВидТоплива = ВидТоплива;
	НовыйЭлемент.ВидТопливаПрочее = ВидТопливаПрочее;
	НовыйЭлемент.ЕдиницаИзмерения = ЕдиницаИзмерения;
	Если ЗначениеЗаполнено(ЕдиницаИзмеренияПоКлассификатору) Тогда
		НовыйЭлемент.ЕдиницаИзмеренияПоКлассификатору = ЕдиницаИзмеренияПоКлассификатору;	
	КонецЕсли;
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

// Получает предопределенный горюче-смазочный материал
//
// Параметры:
//  ИмяПредопределенногоДляРасширения	 - Строка - имя предопределенного элемента
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_ГорючеСмазочныеМатериалы - найденный горюче-смазочный материал
//
Функция ПолучитьПредопределенныйГорючеСмазочныйМатериал(ИмяПредопределенногоДляРасширения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяПредопределенногоДляРасширения", ИмяПредопределенногоДляРасширения);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ГорючеСмазочныеМатериалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ГорючеСмазочныеМатериалы КАК КонтурЛогистика_ГорючеСмазочныеМатериалы
	|ГДЕ
	|	НЕ КонтурЛогистика_ГорючеСмазочныеМатериалы.ПометкаУдаления
	|	И КонтурЛогистика_ГорючеСмазочныеМатериалы.ИмяПредопределенногоДляРасширения = &ИмяПредопределенногоДляРасширения";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

// Создаем предопределенные элементы
//
Процедура СоздатьПредопределенныеЭлементы() Экспорт
	
	НайтиДобавитьЭлемент("Биодизель",, Перечисления.КонтурЛогистика_ТипыТоплива.Biodiesel,, "", "л", 
		Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.л);
	
	ДобавитьГруппу_СжатыйПриродныйГаз();
	
	ДобавитьГруппу_ДизельноеТопливо();
	
	НайтиДобавитьЭлемент("Электричество",, Перечисления.КонтурЛогистика_ТипыТоплива.Electricity,, "", "кВт*ч", 
		Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.кВтЧ);
	
	ДобавитьГруппу_Бензин();
	
	НайтиДобавитьЭлемент("СжиженныйНефтянойГаз",, Перечисления.КонтурЛогистика_ТипыТоплива.LiquefiedPetroleumGas,, "", "л СНГ",
		Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.лСНГ);
	
	НайтиДобавитьГруппу("Другие", "Другие");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьГруппу_СжатыйПриродныйГаз()
	
	// Группа
	ИмяГруппы = "СжатыйПриродныйГаз";
	ТекущаяГруппа = НайтиДобавитьГруппу(ИмяГруппы, "Сжатый природный газ");
	
	// Элементы
	ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas;
	ЕдиницаИзмерения = "куб. м СПГ";
	ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.КубМСПГ;
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Пропан", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.Propane, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Метан", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.Methane, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Другой", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.Other, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
КонецПроцедуры

Процедура ДобавитьГруппу_ДизельноеТопливо()
	
	// Группа
	ИмяГруппы = "ДизельноеТопливо";
	ТекущаяГруппа = НайтиДобавитьГруппу(ИмяГруппы, "Дизельное топливо");
	
	// Элементы
	ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Diesel;
	ЕдиницаИзмерения = "л";
	ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.л;
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Межсезонное", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.MidSeason, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Зимнее", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.Winter, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Арктическое", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.ArcticDiesel, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Другой", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.Other, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
КонецПроцедуры

Процедура ДобавитьГруппу_Бензин()
	
