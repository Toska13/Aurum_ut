	НайтиДобавитьЭлемент(ИмяГруппы + "_АИ-95", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.AI95, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_АИ-98", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.AI98, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
	НайтиДобавитьЭлемент(ИмяГруппы + "_Другой", ТекущаяГруппа, ТипТоплива,
		Перечисления.КонтурЛогистика_ВидыТоплива.Other, "", ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору);
	
КонецПроцедуры

Функция НайтиДобавитьГруппу(ИмяПредопределенногоДляРасширения, Наименование = Неопределено)
	
	НайденнаяГруппа = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.ПолучитьПредопределенныйГорючеСмазочныйМатериал(
		ИмяПредопределенногоДляРасширения);
	
	Если ЗначениеЗаполнено(НайденнаяГруппа) Тогда
		Возврат НайденнаяГруппа;
	КонецЕсли;
	
	Если Наименование = Неопределено Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	НоваяГруппа = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.СоздатьГруппу();
	НоваяГруппа.Наименование = Наименование;
	НоваяГруппа.ИмяПредопределенногоДляРасширения = ИмяПредопределенногоДляРасширения;
	НоваяГруппа.Записать();
	
	Возврат НоваяГруппа.Ссылка;
	
КонецФункции

Функция НайтиДобавитьЭлемент(ИмяПредопределенногоДляРасширения, Родитель, ТипТоплива, ВидТоплива, ВидТопливаПрочее, 
	ЕдиницаИзмерения, ЕдиницаИзмеренияПоКлассификатору)
	
	НайденныйЭлемент = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.ПолучитьПредопределенныйГорючеСмазочныйМатериал(
		ИмяПредопределенногоДляРасширения);
	
	Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда
		Возврат НайденныйЭлемент;
	КонецЕсли;
	
	НовыйЭлемент = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.СоздатьЭлемент();
	НовыйЭлемент.ИмяПредопределенногоДляРасширения = ИмяПредопределенногоДляРасширения;
	НовыйЭлемент.Наименование = СформироватьНаименованиеЭлемента(ТипТоплива, ВидТоплива, ВидТопливаПрочее);
	НовыйЭлемент.Родитель = Родитель;
	НовыйЭлемент.ТипТоплива = ТипТоплива;
	НовыйЭлемент.ВидТоплива = ВидТоплива;
	НовыйЭлемент.ВидТопливаПрочее = ВидТопливаПрочее;
	НовыйЭлемент.ЕдиницаИзмерения = ЕдиницаИзмерения;
	НовыйЭлемент.ЕдиницаИзмеренияПоКлассификатору = ЕдиницаИзмеренияПоКлассификатору;
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Функция СформироватьНаименованиеЭлемента(ТипТоплива, ВидТоплива, ВидТопливаПрочее)
	
	Результат = Строка(ТипТоплива);
	
	Если ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other Тогда
		
		Результат = Результат + " " + Строка(ВидТопливаПрочее);
		
	ИначеЕсли ЗначениеЗаполнено(ВидТоплива) Тогда
		
		Результат = Результат + " " + Строка(ВидТоплива);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПереходНаЭПЛ502

Процедура ЗаполнитьЕдИзмГСМПоКлассификатору(ТихийРежим = Истина) Экспорт
	
	Выборка = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ГСМ = Выборка.Ссылка;
		
		Если ГСМ.ЭтоГруппа Или ЗначениеЗаполнено(ГСМ.ЕдиницаИзмеренияПоКлассификатору) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕдиницаИзмеренияПоКлассификатору = Неопределено;
		
		Если ГСМ.ТипТоплива	= Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline
			Или ГСМ.ТипТоплива	= Перечисления.КонтурЛогистика_ТипыТоплива.Diesel
			Или ГСМ.ТипТоплива	= Перечисления.КонтурЛогистика_ТипыТоплива.Biodiesel Тогда
			ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.л;
		ИначеЕсли ГСМ.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.LiquefiedPetroleumGas Тогда
			ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.лСНГ;
		ИначеЕсли ГСМ.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas Тогда
			ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.КубМСПГ;
		ИначеЕсли ГСМ.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Electricity Тогда
			ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.кВтЧ;
		ИначеЕсли ГСМ.ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Other Тогда
			ЕдиницаИзмеренияПоКлассификатору = Перечисления.КонтурЛогистика_ЕдиницыИзмеренияГСМ.Иное;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЕдиницаИзмеренияПоКлассификатору) Тогда
			ГСМбъект = ГСМ.ПолучитьОбъект();
			ГСМбъект.ЕдиницаИзмеренияПоКлассификатору = ЕдиницаИзмеренияПоКлассификатору;
			ГСМбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ТихийРежим Тогда
		Сообщить("Заполнение едницицы измерения ГСМ по классфикатору выполнено");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли