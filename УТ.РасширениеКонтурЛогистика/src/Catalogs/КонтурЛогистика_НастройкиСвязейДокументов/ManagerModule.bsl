#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция СформироватьНайтиПодчиненныйДокумент(ДокументОсновной, НастройкаСвязи) Экспорт
	
	Перем ДокументПодчиненный;
	
	ДанныеНастройкиСвязи = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		НастройкаСвязи, "ТипДокументаПодчиненный, ПоискПодчиненного, ПоискаПодчиненногоВыражениеВычисления,
		|ВводитьНаОсновании, НастройкиКонвертацииПодчиненного,
		|РасчетОснованияЗаполнения_Расчитывать, РасчетОснованияЗаполнения_СпособМаппинга, РасчетОснованияЗаполнения_ВыражениеВычисления");
	
	// Выполним поиск уже существующего
	Если ДанныеНастройкиСвязи.ПоискПодчиненного Тогда
		ДокументПодчиненный = РезультатВычисленияВыражения(ДокументОсновной, ДанныеНастройкиСвязи.ПоискаПодчиненногоВыражениеВычисления);
		
		Если ЗначениеЗаполнено(ДокументПодчиненный) Тогда
			Возврат ДокументПодчиненный;
		КонецЕсли;
	КонецЕсли;
	
	// Введем на основании новый документ
	Если ДанныеНастройкиСвязи.ВводитьНаОсновании Тогда
		
		// Документ основание для заполнения
		Если ДанныеНастройкиСвязи.РасчетОснованияЗаполнения_Расчитывать Тогда
			ДокументОснованиеДляЗаполнения = ВычислитьДокументОснование(ДокументОсновной, ДанныеНастройкиСвязи);
		Иначе
			ДокументОснованиеДляЗаполнения = ДокументОсновной;
		КонецЕсли;
		
		ДокументыОснованиеДляЗаполнения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснованиеДляЗаполнения);
		
		// Формируем новый документ
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоДокументПодсистемы(ДокументОснованиеДляЗаполнения) Тогда
			РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
				ДокументыОснованиеДляЗаполнения, ДанныеНастройкиСвязи.ТипДокументаПодчиненный, Ложь, Новый Массив);
		Иначе
			РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументыПакетно(
				ДокументыОснованиеДляЗаполнения, Ложь, ДанныеНастройкиСвязи.ТипДокументаПодчиненный);
		КонецЕсли;
		
		// Не удалось сформировать
		Если РезультатВвода.ВведенныеДокументы.Количество() = 0 Тогда
			Возврат ДокументПодчиненный;
		Иначе
			ДокументПодчиненный = РезультатВвода.ВведенныеДокументы[0];
		КонецЕсли;
		
		// Заполним из НКД
		Если ДанныеНастройкиСвязи.РасчетОснованияЗаполнения_Расчитывать
			И ЗначениеЗаполнено(ДанныеНастройкиСвязи.НастройкиКонвертацииПодчиненного) Тогда
			
			ДокументПодчиненныйОбъект = ДокументПодчиненный.ПолучитьОбъект();
			
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
				ДокументПодчиненныйОбъект, ДанныеНастройкиСвязи.НастройкиКонвертацииПодчиненного, ДокументОсновной,, Истина);
			
			ДокументПодчиненныйОбъект.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДокументПодчиненный;
	
КонецФункции

Функция НастройкиСвязиДокументов(ТипДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаОсновной = &ТипДокумента
	|	И НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
	|	И (КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного
	|			ИЛИ КонтурЛогистика_НастройкиСвязейДокументов.ВводитьНаОсновании)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция НастройкиСвязиДокументовПодчиненных(ТипДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаПодчиненный = &ТипДокумента
	|	И НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
	|	И (КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного
	|			ИЛИ КонтурЛогистика_НастройкиСвязейДокументов.ВводитьНаОсновании)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция НужноСоздатьСвязь(ДокументОсновной, НастройкаСвязи) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НастройкаСвязи.ПометкаУдаления Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьГлавныйДокументПоТитулу(ДокументОсновной);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
	Запрос.УстановитьПараметр("ДокументОсновной", ДокументОсновной);
	Запрос.УстановитьПараметр("НастройкаСвязи", НастройкаСвязи);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов.Ссылка КАК Ссылка,
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов.ОтборСтатусыТитулов КАК КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних(, Документ = &ДокументОсновной) КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов.Статус = КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов.Ссылка = &НастройкаСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов.НомерСтроки КАК КоличествоСтрок
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов.ОтборСтатусыТитулов КАК КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыТитулов.Ссылка = &НастройкаСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК Состояние
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов.ОтборСтатусыДокументооборота КАК КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних(, Документ = &ГлавныйДокумент) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
	|		ПО КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота.Статус = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота.Ссылка = &НастройкаСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота.НомерСтроки КАК КоличествоСтрок
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов.ОтборСтатусыДокументооборота КАК КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборСтатусыДокументооборота.Ссылка = &НастройкаСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.ОтборВыражениеВычисления КАК ОтборВыражениеВычисления
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка = &НастройкаСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.ОтборПутьККонтрагенту КАК ОтборПутьККонтрагенту,
	|	КонтурЛогистика_НастройкиСвязейДокументовОтборКонтрагенты.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов.ОтборКонтрагенты КАК КонтурЛогистика_НастройкиСвязейДокументовОтборКонтрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|		ПО КонтурЛогистика_НастройкиСвязейДокументовОтборКонтрагенты.Ссылка = КонтурЛогистика_НастройкиСвязейДокументов.Ссылка
	|ГДЕ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка = &НастройкаСвязи
	|	И КонтурЛогистика_НастройкиСвязейДокументов.ОтборПутьККонтрагенту <> """"
	|ИТОГИ ПО
	|	ОтборПутьККонтрагенту";
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Проверим статусы титулов
	Выборка = Результат[1].Выбрать();
	Если Выборка.Следующий() Тогда	// Иначе нет отбора по статусам
		
		ОтборСтатусТитулаПрошел = (Не Результат[0].Пустой());
		Если Не ОтборСтатусТитулаПрошел Тогда
			// Есть отбор по статусам, но ни один не верен
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверим статусы документооборота
	Выборка = Результат[3].Выбрать();
	Если Выборка.Следующий() Тогда	// Иначе нет отбора по статусам
		
		ОтборСтатусДокументооборотаПрошел = (Не Результат[2].Пустой());
		Если Не ОтборСтатусДокументооборотаПрошел Тогда
			// Есть отбор по статусам, но ни один не верен
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверим дополнительное условие
	Выборка = Результат[4].Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ОтборВыражениеВычисления) Тогда
		
		НужноСоздатьСвязь = РезультатВычисленияВыражения(ДокументОсновной, Выборка.ОтборВыражениеВычисления);
		Если Не НужноСоздатьСвязь Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверим контрагентов
	ВыборкаПоПути = Результат[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоПути.Следующий() Цикл
		
		ЗначениеКонтрагентаДокумента = Вычислить("ДокументОсновной." + ВыборкаПоПути.ОтборПутьККонтрагенту);
		
		Выборка = ВыборкаПоПути.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Контрагент = ЗначениеКонтрагентаДокумента Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Ложь;
		
	КонецЦикла;
	
	// Если не сработол ни один отбор, то создаем
	Возврат Истина;
	
КонецФункции

Функция ЕстьНастройкиПоискПодчиненного() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного";
	
	Возврат (Не Запрос.Выполнить().Пустой());
	
КонецФункции

Функция ЕстьНастройкиВводитьНаОсновании() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
