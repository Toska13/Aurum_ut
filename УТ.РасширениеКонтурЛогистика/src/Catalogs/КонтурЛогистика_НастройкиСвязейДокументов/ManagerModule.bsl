КонецФункции

Функция СвязиДокументовПоТитулам() Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.Ссылка КАК НастройкаСвязи,
	|	КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаОсновной КАК ТипДокументаОсновной,
	|	КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаПодчиненный КАК ТипДокументаПодчиненный
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
	|	И (КонтурЛогистика_НастройкиСвязейДокументов.ВводитьНаОсновании
	|			ИЛИ КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного)
	|ИТОГИ ПО
	|	ТипДокументаОсновной";
	
	ВыборкаПоТипу = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоТипу.Следующий() Цикл
		
		НаборНастроек = Новый Массив;
		
		Выборка = ВыборкаПоТипу.Выбрать();
		Пока Выборка.Следующий() Цикл
			ИмяТипаДокументаОсновной = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(
				Выборка.ТипДокументаОсновной);
			ИмяТипаДокументаПодчиненный = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(
				Выборка.ТипДокументаПодчиненный);
			
			ТекущаяНастройка = Новый Структура;
			ТекущаяНастройка.Вставить("ТипДокументаОсновной", Выборка.ТипДокументаОсновной);
			ТекущаяНастройка.Вставить("ТипДокументаПодчиненный", Выборка.ТипДокументаПодчиненный);
			ТекущаяНастройка.Вставить("ИмяТипаДокументаОсновной", ИмяТипаДокументаОсновной);
			ТекущаяНастройка.Вставить("ИмяТипаДокументаПодчиненный", ИмяТипаДокументаПодчиненный);
			ТекущаяНастройка.Вставить("Задач", 0);
			ТекущаяНастройка.Вставить("Ошибок", 0);
			ТекущаяНастройка.Вставить("Настроено", Истина);
			ТекущаяНастройка.Вставить("ОшибкаЗапроса", Ложь);
			
			НаборНастроек.Добавить(ТекущаяНастройка);
		КонецЦикла;
		
		Результат.Вставить(ВыборкаПоТипу.ТипДокументаОсновной, НаборНастроек);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатВычисленияВыражения(ДокументОсновной, ВыражениеВычисления, ТихийРежим = Истина)
	
	Перем ВычисленноеЗначение, РезультатВычисления;
	
	Попытка
		
		Параметры = Новый Структура;
		Параметры.Вставить("ДокументОсновной", ДокументОсновной);
		
		ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			ВыражениеВычисления, Параметры);
		
	Исключение
		
		// Для тестирования будем отображать ошибку
		Если Не ТихийРежим Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат ВычисленноеЗначение;
	
КонецФункции

Функция ВычислитьДокументОснование(ДокументОсновной, ДанныеНастройкиСвязи)
	
	ДокументОснование = Неопределено;
	
	ВыражениеВычисления = СокрЛП(ДанныеНастройкиСвязи.РасчетОснованияЗаполнения_ВыражениеВычисления);
	
	МаппингВычислитьВыражение = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение;
	Если ДанныеНастройкиСвязи.РасчетОснованияЗаполнения_СпособМаппинга = МаппингВычислитьВыражение Тогда
		
		Параметры = Новый Структура;
		Параметры.Вставить("ДокументОсновной", ДокументОсновной);
		Параметры.Вставить("ДанныеНастройкиСвязи", ДанныеНастройкиСвязи);
		
		ДокументОснование = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			ВыражениеВычисления, Параметры);
		
	Иначе
		
		// Реквизиты могут быть составными через точку
		ТекущийРеквизит = ДокументОсновной;
		ЧастиВыраженияВычисления = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ВыражениеВычисления, ".");
		
		Для Каждого РасчетныйРеквизит Из ЧастиВыраженияВычисления Цикл
			
			ИндексКвадратнойСкобкиОткрытия = Найти(РасчетныйРеквизит, "[");
			ИндексКвадратнойСкобкиЗакрытия = Найти(РасчетныйРеквизит, "]");
			Если ИндексКвадратнойСкобкиОткрытия = 0 Или ИндексКвадратнойСкобкиЗакрытия = 0 Тогда
				ТекущийРеквизит = ТекущийРеквизит[РасчетныйРеквизит];
			Иначе
				// Наличие конкретного элемента. Наример: ДокументыОснования[0]
				ИмяРеквизита = Лев(РасчетныйРеквизит, ИндексКвадратнойСкобкиОткрытия - 1);
				ИндексСтроки = Сред(РасчетныйРеквизит, ИндексКвадратнойСкобкиОткрытия + 1,
					СтрДлина(РасчетныйРеквизит) - ИндексКвадратнойСкобкиЗакрытия + 1);
				
				ТекущийРеквизит = ТекущийРеквизит[ИмяРеквизита][Число(ИндексСтроки)];
			КонецЕсли;
			
		КонецЦикла;
		
		ДокументОснование = ТекущийРеквизит;
		
	КонецЕсли;
	
	Возврат ДокументОснование;
	
КонецФункции

#КонецОбласти

#КонецЕсли