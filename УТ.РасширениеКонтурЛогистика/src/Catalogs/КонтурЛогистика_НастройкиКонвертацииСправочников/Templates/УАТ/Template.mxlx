							<v8:content>РезультатВычисления = "";
Если ЗначениеЗаполнено(Основание) И ЗначениеЗаполнено(Основание.ФизическоеЛицо) Тогда
	ДанныеФИО = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Основание.ФизическоеЛицо.ФИО, " ");
	Если ДанныеФИО.Количество() &gt; 3 Тогда
		РезультатВычисления = ДанныеФИО[2] + " " + ДанныеФИО[3];
	ИначеЕсли ДанныеФИО.Количество() &gt; 2 Тогда
		РезультатВычисления = ДанныеФИО[2];
	КонецЕсли;
КонецЕсли;</v8:content>
