Функция ПолучитьНастройкуКонвертации(ТипСправочникаИлиДокументаУС, ТипСправочникаЛогистика, РеквизитТитула, ТолькоСОбновлениемРеквизитов = Ложь, ТолькоСРеквизитомТитула = Ложь) Экспорт 
	
	НастройкаКонвертации = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииСправочников.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК КонтурЛогистика_НастройкиКонвертацииСправочников
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииСправочников.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииСправочников.ТипСправочникаИлиДокументаУС = &ТипСправочникаИлиДокументаУС
	|	И КонтурЛогистика_НастройкиКонвертацииСправочников.ТипСправочникаЛогистика = &ТипСправочникаЛогистика
	|	И (КонтурЛогистика_НастройкиКонвертацииСправочников.РеквизитТитула = &РеквизитТитула
	|			ИЛИ КонтурЛогистика_НастройкиКонвертацииСправочников.РеквизитТитула = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.ПустаяСсылка))
	|	И &ОбновлятьРеквизитыИзУчетнойСистемы
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_НастройкиКонвертацииСправочников.РеквизитТитула УБЫВ";
	
	Запрос.УстановитьПараметр("ТипСправочникаИлиДокументаУС", ТипСправочникаИлиДокументаУС);
	Запрос.УстановитьПараметр("ТипСправочникаЛогистика", ТипСправочникаЛогистика);
	
	ИмяПеречисления = ?(РеквизитТитула = "МестоВыгрузки", "МестоДоставки", РеквизитТитула);
	
	Если ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Попытка
			ЗначениеПеречисленияРеквизитТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников." + ИмяПеречисления);
		Исключение
			ЗначениеПеречисленияРеквизитТитула = Неопределено;
		КонецПопытки;
	Иначе
		ЗначениеПеречисленияРеквизитТитула = Неопределено;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("РеквизитТитула", ЗначениеПеречисленияРеквизитТитула);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, 
		"&ОбновлятьРеквизитыИзУчетнойСистемы", 
		?(ТолькоСОбновлениемРеквизитов, "КонтурЛогистика_НастройкиКонвертацииСправочников.ОбновлятьРеквизитыИзУчетнойСистемы", "ИСТИНА"));
		
	Если ТолькоСРеквизитомТитула Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
			"КонтурЛогистика_НастройкиКонвертацииСправочников.РеквизитТитула = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.ПустаяСсылка)", 
			"Ложь");
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда  	
		
		НастройкаКонвертации = Выборка.Ссылка;
		
	КонецЕсли;	
	
	Возврат НастройкаКонвертации;
	
КонецФункции	

