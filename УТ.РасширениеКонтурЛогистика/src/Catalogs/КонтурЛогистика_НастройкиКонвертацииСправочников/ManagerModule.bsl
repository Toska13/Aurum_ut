Функция ЗаполнитьАвтоматическиДляТекущейКонфигурации() Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ТаблицаНастроек = ТаблицаНастроекКонвертацииСправочников();
	
	ВариантыНастроек = ТаблицаНастроек.Скопировать(, "ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
	ВариантыНастроек.Свернуть("ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
		
	Если ЗначениеЗаполнено(ВариантыНастроек) Тогда 
	
		Для Каждого ВариантНастройки Из ВариантыНастроек Цикл 
		
			КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
			
			Попытка
				
				// Создадим новую настройку конвертации
				ИмяПеречисления = ?(ВариантНастройки.РеквизитТитула = "МестоВыгрузки", "МестоДоставки",
					ВариантНастройки.РеквизитТитула);
				
				НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.СоздатьЭлемент();
				ЗаполнитьЗначенияСвойств(НоваяНастройка, ВариантНастройки);
				
				Если ЗначениеЗаполнено(ИмяПеречисления) Тогда
					НоваяНастройка.РеквизитТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников." + ИмяПеречисления);
				Иначе
					НоваяНастройка.РеквизитТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.ПустаяСсылка");
				КонецЕсли;
				
				НоваяНастройка.Наименование = "Конвертация из " + НоваяНастройка.ТипСправочникаИлиДокументаУС + 
				" в " + НоваяНастройка.ТипСправочникаЛогистика +
				?(ЗначениеЗаполнено(НоваяНастройка.РеквизитТитула), " реквизит " + НоваяНастройка.РеквизитТитула, "");
				
				Отбор = Новый Структура;
				Отбор.Вставить("ТипСправочникаИлиДокументаУС", 	ВариантНастройки.ТипСправочникаИлиДокументаУС);
				Отбор.Вставить("ТипСправочникаЛогистика", 		ВариантНастройки.ТипСправочникаЛогистика);
				Отбор.Вставить("ТипДокументаОснования", 		ВариантНастройки.ТипДокументаОснования);
				Отбор.Вставить("РеквизитТитула", 				ВариантНастройки.РеквизитТитула);
				
				НайденныеПравила = ТаблицаНастроек.НайтиСтроки(Отбор);
				
				Для Каждого Правило Из НайденныеПравила Цикл 
					
					Если Правило.РеквизитСправочникаЛогистика = "Код" 
						Или Правило.РеквизитСправочникаЛогистика = "Наименование" Тогда 
						Продолжить;
					КонецЕсли;
					
					НовоеПравило = НоваяНастройка.ПравилаКонвертации.Добавить();
					ЗаполнитьЗначенияСвойств(НовоеПравило, Правило);
					
					ОбработатьФиксированноеЗначение(НовоеПравило, Правило);
					
				КонецЦикла;
				
				НоваяНастройка.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
				
				НоваяНастройка.Записать();
				
				// включим автоконвертацию
				ИмяПредопределенного = "Автоконвертация_" + ВариантНастройки.ТипСправочникаЛогистика;
				Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяПредопределенного, Истина);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				Результат.Успешно = Ложь;
				Результат.ОписаниеОшибки = "Не удалось заполнить настройки конвертации справочников для текущей конфигурации. Создайте их вручную.";
				
			КонецПопытки;
			
		КонецЦикла;	
	
		Результат.Успешно = Истина;
		
	Иначе
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Для текущей конфигурации настройки конвертации справочников по умолчанию не найдены. Создайте их вручную."
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьФиксированноеЗначение(Знач НовоеПравило, Знач Правило)
		
	Перем ВычисленноеЗначение;
	
	КолонкаТипЗначения 	= "РеквизитСправочникаЛогистикаТипЗначения";
	
	Если Правило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение Тогда 
			
		Если Правило[КолонкаТипЗначения] = "Число" Тогда 
			ВычисленноеЗначение = Число(Правило.ВыражениеВычисления);
		ИначеЕсли Правило[КолонкаТипЗначения] = "Строка" Тогда
			ВычисленноеЗначение = Строка(Правило.ВыражениеВычисления);            
		ИначеЕсли Правило[КолонкаТипЗначения] = "Булево" Тогда
			ВычисленноеЗначение = Булево(Правило.ВыражениеВычисления);
		ИначеЕсли Правило[КолонкаТипЗначения] = "Дата" Тогда	
			ВычисленноеЗначение = Дата(Правило.ВыражениеВычисления);
		Иначе  
			
			Попытка
				Параметры = Новый Структура;
				Параметры.Вставить("Правило", Правило);
				
				ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
					Правило.ВыражениеВычисления, Параметры);
			Исключение 
				Сообщить("Проблема с установкой правила конвертации: " + Правило.РеквизитСправочникаЛогистика + " - " + ОписаниеОшибки()); 
			КонецПопытки;  
			
		КонецЕсли;
		
		НовоеПравило.ВыражениеВычисления = ВычисленноеЗначение;

	КонецЕсли
	
КонецПроцедуры

Функция ЗаполнитьТекущуюНастройкуЗначениямиПоУмолчанию(НастройкаКонвСправОбъект, ИмяМакета = Неопределено, ИмяКонфигурации = Неопределено, ЭтоНовый = Истина) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ТаблицаДефолтныхНастроек = ПолучитьТаблицуОписанияРеквизитовСправочника(НастройкаКонвСправОбъект.ТипСправочникаЛогистика);
	
	ТаблицаНастроек = ТаблицаНастроекКонвертацииСправочников(НастройкаКонвСправОбъект.ТипСправочникаЛогистика,
															НастройкаКонвСправОбъект.ТипСправочникаИлиДокументаУС,
															НастройкаКонвСправОбъект.ТипДокументаОснования,
															Строка(НастройкаКонвСправОбъект.РеквизитТитула),
															ИмяМакета,
															ИмяКонфигурации);
	
	ВариантыНастроек = ТаблицаНастроек.Скопировать(, "ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
	ВариантыНастроек.Свернуть("ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
	
	Если ВариантыНастроек.Количество() = 0 Тогда
		
		Результат.ОписаниеОшибки = "В макете не найдена дефолтная настройка конвертации по: ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула";
		Результат.Успешно = Ложь;
		
	Иначе
		
		Если ЭтоНовый Тогда
		
			ВариантНастройки = ВариантыНастроек[0];	
			ЗаполнитьЗначенияСвойств(НастройкаКонвСправОбъект, ВариантНастройки);
			
			ИмяПеречисления = ?(ВариантНастройки.РеквизитТитула = "МестоВыгрузки", "МестоДоставки", ВариантНастройки.РеквизитТитула);
			
			НастройкаКонвСправОбъект.Наименование = "Конвертация из " + НастройкаКонвСправОбъект.ТипСправочникаИлиДокументаУС + " в " + НастройкаКонвСправОбъект.ТипСправочникаЛогистика;
			Если ЗначениеЗаполнено(ИмяПеречисления) Тогда
				НастройкаКонвСправОбъект.РеквизитТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников." + ИмяПеречисления);
			КонецЕсли;
			
			НастройкаКонвСправОбъект.ПравилаКонвертации.Очистить();
			
			Для Каждого Правило Из ТаблицаНастроек Цикл 
				
				Если Правило.РеквизитСправочникаЛогистика = "Код" 
					Или Правило.РеквизитСправочникаЛогистика = "Наименование" Тогда 
					Продолжить;
				КонецЕсли;
				
				НовоеПравило = НастройкаКонвСправОбъект.ПравилаКонвертации.Добавить();	
				ЗаполнитьЗначенияСвойств(НовоеПравило, Правило);
				
				Если Не ЗначениеЗаполнено(НовоеПравило.РеквизитСправочникаЛогистикаКомментарий) Тогда 
					
					НайденнаяСтркаСКомментариемДефолта = ТаблицаДефолтныхНастроек.Найти(НовоеПравило.РеквизитСправочникаЛогистика, "Имя");
					Если НайденнаяСтркаСКомментариемДефолта <> Неопределено
						И ЗначениеЗаполнено(НайденнаяСтркаСКомментариемДефолта.Комментарий) Тогда 
						НовоеПравило.РеквизитСправочникаЛогистикаКомментарий = НайденнаяСтркаСКомментариемДефолта.Комментарий;
					КонецЕсли;
					
				КонецЕсли;
				
				ОбработатьФиксированноеЗначение(НовоеПравило, Правило);
				
			КонецЦикла;	
			
			Результат.Успешно = Истина;
			
		Иначе
			
			Для Каждого Правило Из ТаблицаНастроек Цикл
			
				НайденныеПравила = НастройкаКонвСправОбъект.ПравилаКонвертации.НайтиСтроки(Новый Структура("РеквизитСправочникаЛогистика", Правило.РеквизитСправочникаЛогистика));
				Если НайденныеПравила.Количество() Тогда 
						
					НовоеПравило = НайденныеПравила[0];
					ЗаполнитьЗначенияСвойств(НовоеПравило, Правило);
						
				КонецЕсли;
					
			КонецЦикла;
				
			Результат.Успешно = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция УдалитьВсеНастройки() Экспорт 
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
	
		Выборка = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.Выбрать();
		Пока Выборка.Следующий() Цикл 
			
			Если Не Выборка.ПометкаУдаления Тогда 
								
				НастройкаОбъект = Выборка.ПолучитьОбъект();
				НастройкаОбъект.УстановитьПометкуУдаления(Истина);
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		Результат.Успешно = Истина;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не удалось удалить настройки конвертации справочников.";	
		
	КонецПопытки;

	Возврат Результат;
	
КонецФункции
	
Функция НастройкиВыполнены() Экспорт 
	
	НастроекВключено = 0 +
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_Договоры"))
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_Лицензии"))
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_ОрганизацииДиадок"))
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_ПодразделенияДиадок"))
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_ПунктыМаршрута"))
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_Сотрудники"))
	+ Число(Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Автоконвертация_КонтурЛогистика_ТранспортныеСредства"));
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонтурЛогистика_НастройкиКонвертацииСправочников.ТипСправочникаЛогистика) КАК Количество
	               |ИЗ
	               |	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК КонтурЛогистика_НастройкиКонвертацииСправочников
	               |ГДЕ
	               |	НЕ КонтурЛогистика_НастройкиКонвертацииСправочников.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Количество >= НастроекВключено;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции 
