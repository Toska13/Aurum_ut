	ОпределяемыеТипы = Новый Массив;
	
	ОпределяемыеТипы.Добавить("КонтурЛогистика_Договор");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_Контрагент");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_Организация");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_ОрганизацияКонтрагент");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_ОрганизацияКонтрагентПартнер");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_Перевозчик");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_Подразделение");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_ПунктМаршрутаУчетнойСистемы");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_ТранспортноеСредство");
	ОпределяемыеТипы.Добавить("КонтурЛогистика_ФизическиеЛица");
			
	Возврат ОпределяемыеТипы;
	
КонецФункции

Функция ИменаКонвертируемыхСправочниковЛогистика() Экспорт 
	
	Имена = Новый Массив;
	
	Имена.Добавить("КонтурЛогистика_ГорючеСмазочныеМатериалы");
	Имена.Добавить("КонтурЛогистика_Договоры");
	Имена.Добавить("КонтурЛогистика_Лицензии");
	Имена.Добавить("КонтурЛогистика_ОрганизацииДиадок");
	Имена.Добавить("КонтурЛогистика_ПодразделенияДиадок");
	Имена.Добавить("КонтурЛогистика_ПунктыМаршрута");
	Имена.Добавить("КонтурЛогистика_Сотрудники");
	Имена.Добавить("КонтурЛогистика_ТранспортныеСредства");
	
	Возврат Имена;
	
КонецФункции

Процедура ЗаполнитьПравилаКонвертации(ПравилаКонвертации, ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования = Неопределено, РеквизитТитула = Неопределено) Экспорт 
		
	ПравилаКонвертации.Очистить();
	
	ОписанияРеквизитовСправочника = ПолучитьТаблицуОписанияРеквизитовСправочника(ТипСправочникаЛогистика);
		
	Для Каждого ОписаниеРеквизита Из ОписанияРеквизитовСправочника Цикл 
		
		ПравилоКонвертации = ПравилаКонвертации.Добавить();
		
		ПравилоКонвертации.РеквизитСправочникаЛогистика 				= ОписаниеРеквизита.Имя;
		ПравилоКонвертации.РеквизитСправочникаЛогистикаПредставление 	= ?(ЗначениеЗаполнено(ОписаниеРеквизита.Синоним), ОписаниеРеквизита.Синоним, ОписаниеРеквизита.Имя);

		Настройка = ПолучитьНастройкуПоУмолчаниюДляПоля(ТипСправочникаЛогистика, 
			ТипСправочникаИлиДокументаУС, 
			ОписаниеРеквизита.Имя, 
			ТипДокументаОснования, 
			РеквизитТитула);
		
		Если Настройка = Неопределено Тогда
			
			Настройка = ПолучитьНастройкуДляПоля("РеквизитСправочникаЛогистика", ОписаниеРеквизита.Тип);			
						
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(ПравилоКонвертации, Настройка);
		
		Если Не ЗначениеЗаполнено(ПравилоКонвертации.РеквизитСправочникаЛогистикаКомментарий) Тогда 
			
			ПравилоКонвертации.РеквизитСправочникаЛогистикаКомментарий 	= ОписаниеРеквизита.Комментарий;
			
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(ПравилоКонвертации.Картинка) Тогда 
			
			ПравилоКонвертации.Картинка = 3;
			
		КонецЕсли;
		
	КонецЦикла;		
	
	ПравилаКонвертации.Сортировать("Картинка, РеквизитСправочникаЛогистикаПредставление");
	
КонецПроцедуры				

Функция ТаблицаНастроекКонвертацииСправочников(ТипСправочникаЛогистика = Неопределено, 
												ТипСправочникаИлиДокументаУС = Неопределено, 
												ТипДокументаОснования = Неопределено, 
												РеквизитТитула = Неопределено,
												ИмяМакета = Неопределено,
												ИмяКонфигурации = Неопределено) Экспорт
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуНастроекКонвертацииСправочниковПоУмолчанию(ТипСправочникаЛогистика, 
																													ТипСправочникаИлиДокументаУС, 
																													ТипДокументаОснования, 
																													РеквизитТитула,
																													ИмяМакета,
																													ИмяКонфигурации);
	
КонецФункции

Функция ПолучитьТаблицуНастроекКонвертацииСправочниковПоУмолчанию(ТипСправочникаЛогистика = Неопределено, 
																ТипСправочникаИлиДокументаУС = Неопределено, 
																ТипДокументаОснования = Неопределено, 
																РеквизитТитула = Неопределено, 
																ИмяМакета = Неопределено,
																ИмяКонфигурации = Неопределено) Экспорт

	ПравилаКонвертации = Новый ТаблицаЗначений;
	ПравилаКонвертации.Колонки.Добавить("ТипСправочникаЛогистика");
	ПравилаКонвертации.Колонки.Добавить("ТипСправочникаИлиДокументаУС");
	ПравилаКонвертации.Колонки.Добавить("ТипДокументаОснования");
	ПравилаКонвертации.Колонки.Добавить("РеквизитТитула");
	
	РеквизитыТЗ = Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ТабличныеЧасти.ПравилаКонвертации.Реквизиты;
	
	Для Каждого Реквизит Из РеквизитыТЗ Цикл 
		ПравилаКонвертации.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;	
	
	// разделение общего макета на макеты по конфигурациям
	ИмяКонфигурацииДляНКС = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ИмяКонфигурацииДляНастроекКонвертации(ИмяКонфигурации);
	
	Если ИмяКонфигурацииДляНКС = Неопределено Тогда 
		Возврат ПравилаКонвертации;
	КонецЕсли;
	
	ИзвлеченныеОбласти = Новый Массив;
	
	Если ИмяМакета = "ЗначенияПоУмолчаниюДляДополнений" Тогда 
		Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьМакет(ИмяМакета);
		Попытка 
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурации));
		Исключение
			Возврат ПравилаКонвертации;
		КонецПопытки;	
	Иначе		
		Попытка
			ИзвлеченныеОбласти = ИзвлечьОбластиИзМакетов(ИмяКонфигурацииДляНКС);
		Исключение
			Возврат ПравилаКонвертации;
		КонецПопытки;	
	КонецЕсли;   
	
	Для Каждого Область Из ИзвлеченныеОбласти Цикл
	
		Для Сч = 1 По Область.ВысотаТаблицы Цикл
			
			ТипСправочникаЛогистикаИзМакета			= ПолучитьТекстЯчейкиОбласти(Область, Сч, 2);
			ТипСправочникаИлиДокументаУСИзМакета	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 3);
			ТипДокументаОснованияИзМакета			= ПолучитьТекстЯчейкиОбласти(Область, Сч, 4);
			РеквизитТитулаИзМакета					= ПолучитьТекстЯчейкиОбласти(Область, Сч, 5);
			
			Если Не ТипСправочникаЛогистика = Неопределено И Не ТипСправочникаИлиДокументаУС = Неопределено Тогда 
				
				Если Не ИмяКонфигурацииДляНКС = ПолучитьТекстЯчейкиОбласти(Область, Сч, 1) 
					Или Не ТипСправочникаЛогистика = ТипСправочникаЛогистикаИзМакета
					Или Не ТипСправочникаИлиДокументаУС = ТипСправочникаИлиДокументаУСИзМакета
					Тогда
					Продолжить;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(ТипДокументаОснования) И Не ТипДокументаОснования = ТипДокументаОснованияИзМакета Тогда 
					Продолжить;	
				КонецЕсли;
				
				Если ЗначениеЗаполнено(РеквизитТитула) И Не Строка(РеквизитТитула) = РеквизитТитулаИзМакета Тогда 
					Продолжить;	
				КонецЕсли;
				
			КонецЕсли;
		
			НовоеПравило = ПравилаКонвертации.Добавить();
			
			НовоеПравило.ТипСправочникаЛогистика		= ТипСправочникаЛогистикаИзМакета;
			НовоеПравило.ТипСправочникаИлиДокументаУС	= ТипСправочникаИлиДокументаУСИзМакета;
			НовоеПравило.ТипДокументаОснования			= ТипДокументаОснованияИзМакета;
			НовоеПравило.РеквизитТитула					= РеквизитТитулаИзМакета;
			
			ИмяРеквизита = ПолучитьТекстЯчейкиОбласти(Область, Сч, 7); 
			
			НовоеПравило.РеквизитСправочникаЛогистика				= ИмяРеквизита;
			НовоеПравило.РеквизитСправочникаЛогистикаПредставление	= ПредставлениеПоИмениРеквизитаОбъектаМетеданных(ТипСправочникаЛогистикаИзМакета, ИмяРеквизита);
			НовоеПравило.РеквизитСправочникаЛогистикаТипЗначения	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 8);
			НовоеПравило.РеквизитСправочникаЛогистикаКомментарий	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 9);
			
			НовоеПравило.Картинка					= ПолучитьТекстЯчейкиОбласти(Область, Сч, 6);;

			НовоеПравило.КлючДопСвойстваРеквизита	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 12);
			
			НовоеПравило.СпособМаппинга				= ЗначениеПеречисленияПоСтроке(Перечисления.КонтурЛогистика_СпособыМаппингаПоля, 
														ПолучитьТекстЯчейкиОбласти(Область, Сч, 10));
														
			НовоеПравило.СпособКонвертацииЗначения	= ЗначениеПеречисленияПоСтроке(Перечисления.КонтурЛогистика_СпособыКонвертации, 
														ПолучитьТекстЯчейкиОбласти(Область, Сч, 13));													
			Если НовоеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда 
				НовоеПравило.ВыражениеВычисленияСтрокаНеогр = ПолучитьТекстЯчейкиОбласти(Область, Сч, 11);
			Иначе
				НовоеПравило.ВыражениеВычисления			= ПолучитьТекстЯчейкиОбласти(Область, Сч, 11);
			КонецЕсли;
					
		КонецЦикла;
		
	КонецЦикла;
	
	Если ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
		НовоеПравило = ПравилаКонвертации.Добавить();
		НовоеПравило.РеквизитСправочникаЛогистика = "МожетПодписывать";
		НовоеПравило.РеквизитСправочникаЛогистикаПредставление = "Может подписывать";
		НовоеПравило.РеквизитСправочникаЛогистикаТипЗначения = "Булево";
		НовоеПравило.РеквизитСправочникаЛогистикаКомментарий = "По умолчанию равно истина";
		НовоеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
		НовоеПравило.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
		НовоеПравило.Картинка = 3;
		
		НовоеПравило = ПравилаКонвертации.Добавить();
		НовоеПравило.РеквизитСправочникаЛогистика = "МожетПередаватьНаПодпись";
		НовоеПравило.РеквизитСправочникаЛогистикаПредставление = "Может передавать на подпись";
		НовоеПравило.РеквизитСправочникаЛогистикаТипЗначения = "Булево";
		НовоеПравило.РеквизитСправочникаЛогистикаКомментарий = "По умолчанию равно ложь";
		НовоеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
		НовоеПравило.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
		НовоеПравило.Картинка = 3;
	КонецЕсли;
	
	Возврат ПравилаКонвертации;
	
КонецФункции

Функция ИзвлечьОбластиИзМакетов(ИмяКонфигурацииДляНКС) Экспорт
	
	ИзвлеченныеОбласти = Новый Массив;
	
	Если ИмяКонфигурацииДляНКС = "УФ_УТ" Тогда
		
		Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьМакет(ИмяКонфигурацииДляНКС);
		ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКС));
		
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеДоставкой") Тогда
		
			Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьМакет("УФ_УТ_ГО_РТУ");
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКС));	
			
		ИначеЕсли НЕ ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
			
			Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьМакет("УФ_УТ_ГО_ТН");
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКС));
			
		Иначе
			
			Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьМакет("УФ_УТ_ГО_ТН_ЗнП");
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКС));
			
		КонецЕсли;
		
	Иначе
		
		Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьМакет(ИмяКонфигурацииДляНКС);
		ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКС));
		
	КонецЕсли;
	
	Возврат ИзвлеченныеОбласти;
		
КонецФункции

Функция ОписаниеСтандартныхРеквизитовСправочника(ИмяСправочника) Экспорт 
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьОписаниеРеквизитовСправочника(ИмяСправочника);		
	
КонецФункции

Функция ПолучитьТаблицуОписанияРеквизитовСправочника(ИмяСправочника) Экспорт 
	
	ТаблицаОписаниеРеквизитов = Новый ТаблицаЗначений;
	
	ТаблицаОписаниеРеквизитов.Колонки.Добавить("Имя", 			КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(100));
	ТаблицаОписаниеРеквизитов.Колонки.Добавить("Синоним", 		КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
	ТаблицаОписаниеРеквизитов.Колонки.Добавить("Комментарий", 	КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(1000));
	ТаблицаОписаниеРеквизитов.Колонки.Добавить("Тип", 			КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
		
	Для Каждого ОписаниеРеквизита Из Метаданные.Справочники[ИмяСправочника].Реквизиты Цикл 
		
		ЗаполнитьЗначенияСвойств(ТаблицаОписаниеРеквизитов.Добавить(), ОписаниеРеквизита);
		
	КонецЦикла;
	
	Для Каждого ОписаниеРеквизита Из Метаданные.Справочники[ИмяСправочника].СтандартныеРеквизиты Цикл 
		
		Если ОписаниеРеквизита.Имя = "Код" Или ОписаниеРеквизита.Имя = "Наименование" Тогда 
			
			ЗаполнитьЗначенияСвойств(ТаблицаОписаниеРеквизитов.Добавить(), ОписаниеРеквизита);
						
		КонецЕсли;
		
		Если ОписаниеРеквизита.Имя = "Владелец" И ИмяСправочника = "КонтурЛогистика_Лицензии" Тогда
			
			ЗаполнитьЗначенияСвойств(ТаблицаОписаниеРеквизитов.Добавить(), ОписаниеРеквизита);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаОписаниеРеквизитов.Сортировать("Синоним");
	
	Возврат ТаблицаОписаниеРеквизитов;
	
КонецФункции

Функция ПолучитьНастройкуПоУмолчаниюДляПоля(ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ИмяПоля, ТипДокументаОснования = Неопределено, РеквизитТитула = Неопределено) Экспорт 

	Настройка = Неопределено;
	
	ТаблицаНастроек = ТаблицаНастроекКонвертацииСправочников(ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула);
	
	Если ТаблицаНастроек.Количество() Тогда 
		
		НайденнаяНастройка = ТаблицаНастроек.НайтиСтроки(Новый Структура("РеквизитСправочникаЛогистика", ИмяПоля));
		
		Если НайденнаяНастройка.Количество() Тогда 
			
			Настройка = КонтурЛогистика_ОбщегоНазначенияСервер.СтрокаТаблицыЗначенийВСтруктуру_(НайденнаяНастройка[0]);
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Настройка;

