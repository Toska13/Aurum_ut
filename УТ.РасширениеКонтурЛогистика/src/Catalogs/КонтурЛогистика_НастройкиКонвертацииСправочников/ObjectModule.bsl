Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// проверка наименования
	Если Не Наименование = Ссылка.Наименование И Не ПометкаУдаления Тогда 
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_НастройкиКонвертацииСправочников.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК КонтурЛогистика_НастройкиКонвертацииСправочников
			|ГДЕ
			|	КонтурЛогистика_НастройкиКонвертацииСправочников.Наименование = &Наименование
			|	И НЕ КонтурЛогистика_НастройкиКонвертацииСправочников.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			Сообщить("Укажите другое наименование. В базе уже есть настройка конвертации справочников с наименованием: " + Наименование);
			Отказ = Истина;
		КонецЕсли;	
		
	КонецЕсли;
		
КонецПроцедуры

