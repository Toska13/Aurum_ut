Процедура ЗаполнитьЗначениямиПоУмолчаниюНаСервере()
	
	АвтоманическоеЗаполненияПравилКонвертации();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениямиПоУмолчанию(Команда)
	ЗаполнитьЗначениямиПоУмолчаниюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если (ЗавершениеРаботы = Ложь Или ЗавершениеРаботы = Неопределено)
		И Не Объект.Ссылка.Пустая() Тогда
		
		Оповестить("ОбновитьСтартовыйПомошник");
		Оповестить("ОбновитьРабочийСтол", Объект.Ссылка);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииЛюбойТаблицыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Найти(Поле.Имя, "ВыражениеВычисления") > 0
		И Элемент.ТекущиеДанные <> Неопределено
		И (Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение")
			ИЛИ Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования"))
		Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НачалоВыбораВыражения(СтандартнаяОбработка, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущуюДефолтами(Команда)
	
	ЗаполнитьТекущуюДефолтамиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущуюДефолтамиНаСервере()
	
	НастройкаОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатЗаполениния = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ЗаполнитьТекущуюНастройкуЗначениямиПоУмолчанию(НастройкаОбъект);
	
	Если РезультатЗаполениния.Успешно = Ложь Тогда 
		Сообщить(РезультатЗаполениния.ОписаниеОшибки);
	КонецЕсли;
	НастройкаОбъект.ПравилаКонвертации.Сортировать("Картинка");	
	ЗначениеВРеквизитФормы(НастройкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьПоНастройкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СпособКонвертацииЗначения = Элементы.ПравилаКонвертации.ТекущиеДанные.СпособКонвертацииЗначения;
	
	ИмяСправочника = ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	ЗначениеОтбора = Новый Структура("ТипСправочникаЛогистика", ИмяСправочника);
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"КонвертироватьПоНастройкеНачалоВыбораЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьПоНастройкеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПравилаКонвертации.ТекущиеДанные.КонвертироватьПоНастройке = Результат;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения)
	
	Возврат Перечисления.КонтурЛогистика_СпособыКонвертации.ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
КонецФункции

&НаКлиенте
Процедура КонвертироватьПоНастройкеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПравилаКонвертации.ТекущиеДанные;
	
	КонвертироватьПоНастройке = ТекущиеДанные.КонвертироватьПоНастройке;
	
	Если Не ЗначениеЗаполнено(КонвертироватьПоНастройке) Тогда
		Возврат;
	КонецЕсли;
	
	СпособКонвертацииЗначения = ТекущиеДанные.СпособКонвертацииЗначения;
	ИмяСправочника = ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	ТипСправочникаЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		КонвертироватьПоНастройке, "ТипСправочникаЛогистика");
	
	Если ИмяСправочника <> ТипСправочникаЛогистика Тогда
		Сообщить("Выбрана не подходящая настройка конвертации под способ конвертации значения.");
		ТекущиеДанные.КонвертироватьПоНастройке = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьКонтактнаяИнформацияОбъекта()
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	Если ИмяКонфигурации1С = "УТ"
		Или ИмяКонфигурации1С = "УПП" Тогда
		
		// Для УТ 10 и УПП
		Если Метаданные.РегистрыСведений.Найти("КонтактнаяИнформация") <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		
		// Для новых конфигураций
		Если Не ЗначениеЗаполнено(Объект.ТипСправочникаИлиДокументаУС) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ПолноеИмяСправочника = "Справочник." + Объект.ТипСправочникаИлиДокументаУС;
		
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяСправочника);
		
		Если ОбъектМетаданных <> Неопределено
			И ОбъектМетаданных.ТабличныеЧасти.Найти("КонтактнаяИнформация") <> Неопределено Тогда
			
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьДляПрочих(Команда)
	
	ТекДанные = Элементы.ПравилаКонвертации.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("РеквизитСправочникаЛогистика, ИзвлеченноеЗначение", ТекДанные.РеквизитСправочникаЛогистика, "<в остальных случаях>");  
	Если Объект.ТаблицаСоответствий.НайтиСтроки(Отбор).Количество() = 0 Тогда
		НоваяСтрока = Объект.ТаблицаСоответствий.Добавить();
		НоваяСтрока.РеквизитСправочникаЛогистика = ТекДанные.РеквизитСправочникаЛогистика;
		НоваяСтрока.ИзвлеченноеЗначение = "<в остальных случаях>";
		НоваяСтрока.СпособМаппинга = ТекДанные.СпособМаппинга;
	КонецЕсли;
	
	Элементы.ТаблицаСоответствий.Обновить();
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекДанныеПравилаКонвертации = Элементы.ПравилаКонвертации.ТекущиеДанные;
	ТекДанныеТаблицаСоответствий = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	Если ТекДанныеПравилаКонвертации = Неопределено Или ТекДанныеТаблицаСоответствий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("РеквизитСправочникаЛогистика, ИзвлеченноеЗначение", 
		ТекДанныеПравилаКонвертации.РеквизитСправочникаЛогистика, ТекДанныеТаблицаСоответствий.ИзвлеченноеЗначение);  
			
	Если ЗначениеЗаполнено(ТекДанныеТаблицаСоответствий.ИзвлеченноеЗначение) Или ТекДанныеТаблицаСоответствий.ИзвлеченноеЗначение = Неопределено Тогда
	
		Если Объект.ТаблицаСоответствий.НайтиСтроки(Отбор).Количество() > 1 
			И Не ОтменаРедактирования Тогда
			Сообщить("Такое извлеченное значение уже есть");
			Отказ = Истина;
		КонецЕсли;
		
	Иначе
		
		Если Объект.ТаблицаСоответствий.НайтиСтроки(Отбор).Количество() > 0 
			И Не ОтменаРедактирования Тогда
			Сообщить("Такое извлеченное значение уже есть");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УправлениеОтображениемЗаполнениемДляДополнений()
	
	СтруктураДляПоиска = Новый Структура("ТипНастройки, ТипСправочникаИлиДокументаУС, ТипСправочникаЛогистика, РеквизитТитула, ТипДокументаОснования", 
		"НКС", Объект.ТипСправочникаИлиДокументаУС, Объект.ТипСправочникаЛогистика, Объект.РеквизитТитула, Объект.ТипДокументаОснования);
		
	Элементы.ФормаЗаполнитьДополнениеКТ2000.Видимость = КонтурЛогистика_ОбщегоНазначенияСервер.ПоказатьКомандуЗаполненияДополнения("КТ2000", СтруктураДляПоиска);	
			
КонецПроцедуры

&НаКлиенте
