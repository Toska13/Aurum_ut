	ТекДанные.РеквизитСправочникаЛогистикаПредставление = "";
	ТекДанные.РеквизитСправочникаЛогистикаТипЗначения 	= "";
	ТекДанные.РеквизитСправочникаЛогистикаКомментарий 	= "";
	ТекДанные.СпособМаппинга 							= "";
	ТекДанные.ВыражениеВычисления 						= "";
	ТекДанные.КлючДопСвойстваРеквизита 					= "";
	ТекДанные.ВыражениеВычисления2 						= "";
