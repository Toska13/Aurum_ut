	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Настройки.Форма.ФормаЭлемента",
		Новый Структура("Ключ", НастройкаАвтоконвертации),
