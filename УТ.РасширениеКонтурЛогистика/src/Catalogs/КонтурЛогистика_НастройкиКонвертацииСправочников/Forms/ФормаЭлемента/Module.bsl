
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивТиповДокументов = ТипыДокументовУСИзНастроекКонвертацииДокументов();
	
	ЗаполнитьСписокВыбораТипСправочникаИлиДокументаУС(МассивТиповДокументов);
	ЗаполнитьСписокВыбораТипДокументаОснования(МассивТиповДокументов);
	ЗаполнитьСписокВыбораТипСправочникаЛогистика();
		
	// условие при открытии формы из настроек
	Если Параметры.Свойство("ТипСправочникаЛогистика") Тогда
		
		Объект.ТипСправочникаЛогистика = Параметры.ТипСправочникаЛогистика;
		
		УстановитьНаименованиеОбъекта(ЭтаФорма);
		АвтоманическоеЗаполненияПравилКонвертации();
		
	КонецЕсли;
	
	ЗаполнитьДеревоРеквизитовСпрУчСист();
		
	ТипСправочникаИлиДокументаУСПриИзмененииНаСервере();	
	ОбработатьИзменениеНастройкиАвтоконвертации();
	
	УправлениеВидимостьюПодсказок(ЭтаФорма, Истина);
	
	ВидимостьКолонкиОбновлять(ЭтаФорма);
	
	ЗаполнитьДеревоРеквизитовСпрУчСист();
	
	// обратная совместимость8.2
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда 
		Элементы.ТипСправочникаЛогистика.КнопкаСпискаВыбора 		= Истина;
		Элементы.ТипСправочникаИлиДокументаУС.КнопкаСпискаВыбора 	= Истина;
		Элементы.ТипДокументаОснования.КнопкаСпискаВыбора 			= Истина;
	КонецЕсли;
	
	//может быть после обновления
	Если Не ЗначениеЗаполнено(Объект.НаправлениеКонвертации) Тогда 
		Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;		
	КонецЕсли;
	
	УправлениеОтображениемЗаполнениемДляДополнений();
	
	ЕстьЗначенияСвойствОбъектов = ЕстьРегистрСведений("ЗначенияСвойствОбъектов");
	
	ЕстьДокументыФизическихЛиц = ЕстьРегистрСведений("ДокументыФизическихЛиц");
	
	ВидимостьКомандыОбновлятьПоВыделенным(ЭтаФорма);
	
	ТипСправочникаИлиДокументаУС_Старый = Объект.ТипСправочникаИлиДокументаУС;
	 		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
		
		Для Каждого ТекущаяСтрока Из Объект.ПравилаКонвертации Цикл
			Если ЗначениеЗаполнено(ТекущаяСтрока.РеквизитСправочникаЛогистикаПредставление) Тогда
				Продолжить;
			КонецЕсли;
			
			НомерСтрокиТЧ = Формат(Объект.ПравилаКонвертации.Индекс(ТекущаяСтрока), "ЧДЦ=; ЧН=; ЧГ=");
			
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Необходимо заполнить конвертацию реквизита";
			ПараметрыСообщения.Поле = "Объект.ПравилаКонвертации[" + НомерСтрокиТЧ + "].РеквизитСправочникаЛогистикаПредставление";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			Отказ = Истина;
			Прервать;
		КонецЦикла;
		
	Иначе
		
		СохранитьДеревоРеквизитовСпрУчСистВТаблЧасть(Отказ);
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораТипСправочникаИлиДокументаУС(МассивТиповДокументов)
	
	СписокВыбора = Элементы.ТипСправочникаИлиДокументаУС.СписокВыбора;
	СписокВыбора.Очистить();
	
	// заполним Справочники
	
	Для Каждого ОбъектМД Из Метаданные.Справочники Цикл 
		
		Если Найти(ОбъектМД.Имя, "КонтурЛогистика_") = 0 Тогда 
			СписокВыбора.Добавить(ОбъектМД.Имя, ОбъектМД.Синоним, , БиблиотекаКартинок.Справочник);
		КонецЕсли;	
		
	КонецЦикла;
	
	// заполним Документы
	
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл 
		
		Если Найти(ОбъектМД.Имя, "КонтурЛогистика_") = 0 Тогда 
			СписокВыбора.Добавить(ОбъектМД.Имя, ОбъектМД.Синоним, , БиблиотекаКартинок.Документ);
		КонецЕсли;	
		
	КонецЦикла;
	
	СписокВыбора.Добавить("Строка", "Строка", , БиблиотекаКартинок.Реквизит);
	
	УсловноеОформлениеСпискаВыбора(СписокВыбора, "Объект.ТипСправочникаИлиДокументаУС", "ТипСправочникаИлиДокументаУС");
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокВыбораТипДокументаОснования(МассивТиповДокументов)
	
	СписокВыбора = Элементы.ТипДокументаОснования.СписокВыбора;
	СписокВыбора.Очистить();
	
	ДобавитьТипВСписокВыбора(СписокВыбора, МассивТиповДокументов);
	
	УсловноеОформлениеСпискаВыбора(СписокВыбора, "Объект.ТипДокументаОснования", "ТипДокументаОснования");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораТипСправочникаЛогистика()
	
	СписокВыбора = Элементы.ТипСправочникаЛогистика.СписокВыбора;
	СписокВыбора.Очистить();
	
	Имена = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ИменаКонвертируемыхСправочниковЛогистика();
	
	Для Каждого Имя Из Имена Цикл
		
		ОбъектМетаданных = Метаданные.Справочники.Найти(Имя);
		
		Если Не ОбъектМетаданных = Неопределено Тогда 
			
			СписокВыбора.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним, , БиблиотекаКартинок.Справочник);
			
		КонецЕсли;
			
	КонецЦикла;

	УсловноеОформлениеСпискаВыбора(СписокВыбора, "Объект.ТипСправочникаЛогистика", "ТипСправочникаЛогистика");
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ДобавитьТипВСписокВыбора(СписокВыбора, МассивТиповДокументов)

	Для Каждого ТипДокументаУС Из МассивТиповДокументов Цикл
		
		ОбъектМетаданных = Метаданные.Документы.Найти(ТипДокументаУС);
				
		Если Не ОбъектМетаданных = Неопределено Тогда 
			
			СписокВыбора.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним, , БиблиотекаКартинок.Документ);
			
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипыДокументовУСИзНастроекКонвертацииДокументов()
	
	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.НастроенныеТипыДокументовУчетнойСистемы();
	
КонецФункции	

&НаКлиенте
Процедура ТипСправочникаИлиДокументаУСПриИзменении(Элемент)
	
	ТипСправочникаИлиДокументаУСПриИзмененииНаСервере();
	
	Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее") Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
			"Изменение справочника перезаполнит табличную часть. Продолжить?", РежимДиалогаВопрос.ДаНет,,,
			ЭтаФорма, "ВопросПерезаполненияВходящееЗавершение");
	Иначе
		Если Объект.ПравилаКонвертации.Количество() = 0 Тогда
			ПерезаполнитьНКС();
		Иначе
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
				"Табличная часть не пустая. Перезаполнить табличную часть?", РежимДиалогаВопрос.ДаНетОтмена,,,
				ЭтаФорма, "ВопросПерезаполненияИсходящееЗавершение");
		КонецЕсли;
	КонецЕсли;
	
	УправлениеОтображениемТипСправочникаИлиДокументаУС();
	Если Объект.ТипСправочникаИлиДокументаУС = "Строка" И ЗначениеЗаполнено(Объект.ТипДокументаОснования) Тогда
		Объект.ТипДокументаОснования = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПерезаполненияВходящееЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ТипСправочникаИлиДокументаУС = ТипСправочникаИлиДокументаУС_Старый;
		Возврат;
	КонецЕсли;
	
	ПерезаполнитьНКС();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПерезаполненияИсходящееЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Объект.ТипСправочникаИлиДокументаУС = ТипСправочникаИлиДокументаУС_Старый;
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		ПерезаполнитьТабличнуюЧасть = Истина;
	Иначе
		ПерезаполнитьТабличнуюЧасть = Ложь;
	КонецЕсли;
	
	ПерезаполнитьНКС(ПерезаполнитьТабличнуюЧасть);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьНКС(ПерезаполнитьТабличнуюЧасть = Истина)
	
	УстановитьНаименованиеОбъекта(ЭтаФорма);
	
	ЗаполнитьАвтоматически(ПерезаполнитьТабличнуюЧасть);
	
	ТипСправочникаИлиДокументаУС_Старый = Объект.ТипСправочникаИлиДокументаУС;
	
	ЭтаФорма.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ТипСправочникаИлиДокументаУСПриИзмененииНаСервере()
	
	ВидимостьПоля = Ложь;
	ЗаголовокПоля = "Справочник/документ учетной системы/строка";
	
	Если ЗначениеЗаполнено(Объект.ТипСправочникаИлиДокументаУС) Тогда
		
		Если Не Метаданные.Документы.Найти(Объект.ТипСправочникаИлиДокументаУС) = Неопределено Тогда
			
			ЗаголовокПоля = "Документ учетной системы";
			
			Объект.ТипДокументаОснования = "";
			
		ИначеЕсли Не Метаданные.Справочники.Найти(Объект.ТипСправочникаИлиДокументаУС) = Неопределено
			И Не ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда	
			
			ЗаголовокПоля = "Справочник учетной системы";
			
			ВидимостьПоля = Истина;
			
		ИначеЕсли Объект.ТипСправочникаИлиДокументаУС = "Строка"
			И Не ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда	
			
			ЗаголовокПоля = "Из строки";
									
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗаголовокРеквизитаСправочникаДокументаУС(ЭтаФорма);
	УсловноеОформлениеСпискаВыбораСпособМаппинга();
	
	Элементы.ТипСправочникаИлиДокументаУС.Заголовок = ЗаголовокПоля;
	Элементы.ТипДокументаОснования.Видимость = ВидимостьПоля;
	
	ЕстьКонтактнаяИнформацияОбъекта = ЕстьКонтактнаяИнформацияОбъекта();
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВставитьСпособМаппингаВСписокВыбора(СписокВыбора, ТипДокументаОснования)
	
	СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования");
	СписокВыбора.Вставить(0, СпособМаппинга);

КонецПроцедуры

&НаСервере
Процедура УсловноеОформлениеСпискаВыбора(СписокВыбора, ПутьКДанным, ИмяЭлемента)

	Для Каждого СтрокаСписка Из СписокВыбора Цикл 
							
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", СтрокаСписка.Представление);
		
		ЭлементУсловия  = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементУсловия.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(ПутьКДанным);
		ЭлементУсловия.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементУсловия.ПравоеЗначение 	= СтрокаСписка.Значение;
		
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
		
	КонецЦикла;
	
КонецПроцедуры

