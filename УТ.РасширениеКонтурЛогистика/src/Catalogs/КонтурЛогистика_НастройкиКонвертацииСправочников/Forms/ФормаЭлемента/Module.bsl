КонецПроцедуры

&НаКлиенте
Процедура УдалитьПовторныеЭлементыСпискаВыбора(СписокВыбора)
		
	МассивУд = Новый Массив;
	
	Для Каждого Строка Из Объект.ПравилаКонвертации Цикл 
		
		НайденныйЭлемент = СписокВыбора.НайтиПоЗначению(Строка.РеквизитСправочникаЛогистика);
		
		Если Не НайденныйЭлемент = Неопределено Тогда 
			
			МассивУд.Добавить(НайденныйЭлемент);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого ЭлементСписка Из МассивУд Цикл 
		
		СписокВыбора.Удалить(ЭлементСписка);
		
	КонецЦикла;
		
КонецПроцедуры	

&НаКлиенте
Процедура УдалитьСтандартныеРеквизитыИзСпискаВыбора(СписокВыбора)

	СтандартныеРеквизиты = Новый Массив;
	
	СтандартныеРеквизиты.Добавить("Ссылка");
	СтандартныеРеквизиты.Добавить("ПометкаУдаления");
	СтандартныеРеквизиты.Добавить("ИмяПредопределенныхДанных");
	СтандартныеРеквизиты.Добавить("Предопределенный");

	МассивУд = Новый Массив;
	
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл 
		
		НайденныйЭлемент = СписокВыбора.НайтиПоЗначению(Реквизит);
		
		Если Не НайденныйЭлемент = Неопределено Тогда 
			
			МассивУд.Добавить(НайденныйЭлемент);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого ЭлементСписка Из МассивУд Цикл 
		
		СписокВыбора.Удалить(ЭлементСписка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораВыражения(СтандартнаяОбработка, Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		УспешнаяЗапись = ЭтаФорма.Записать();
		Если Не УспешнаяЗапись Тогда 
			Сообщить("Не удалось записать настройку. Запишите вручную, затем переходите к настройке.");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда 
		ТекДанные = Элемент.ТекущиеДанные;
	Иначе
		ТекДанные = Элемент.Родитель.Родитель.ТекущиеДанные;
	КонецЕсли;
		
	ПараметрыФормыНастройки = Новый Структура;
	// ключи, неизменяемые
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекДанные.РеквизитСправочникаЛогистика);
	
	// изменяемые в открываемой форме
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекДанные.СпособМаппинга);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекДанные.ВыражениеВычисления);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления2", ТекДанные.ВыражениеВычисления2);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекДанные.ВыражениеВычисленияСтрокаНеогр);
	ПараметрыФормыНастройки.Вставить("КлючДопСвойстваРеквизита", ТекДанные.КлючДопСвойстваРеквизита);
	ПараметрыФормыНастройки.Вставить("ЕстьКонтактнаяИнформацияОбъекта", ЕстьКонтактнаяИнформацияОбъекта);
	ПараметрыФормыНастройки.Вставить("ЕстьЗначенияСвойствОбъектов", ЕстьЗначенияСвойствОбъектов);
	ПараметрыФормыНастройки.Вставить("ЕстьДокументыФизическихЛиц", ЕстьДокументыФизическихЛиц);
	ПараметрыФормыНастройки.Вставить("СвойствоОбъекта", ТекДанные.СвойствоОбъекта);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник",
		ПараметрыФормыНастройки,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикРедактированиеСтрокиВДопФорме",
		Элемент.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикРедактированиеСтрокиВДопФорме(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено И ТипЗнч(ВыбранноеЗначение) = тип("Структура") И ИмяЭлемента <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		Если ТипЗнч(Элементы[ИмяЭлемента]) = Тип("ТаблицаФормы") Тогда 
			ТабФормы  = Элементы[ИмяЭлемента];
		Иначе
			ТабФормы  = Элементы[ИмяЭлемента].Родитель.Родитель;
		КонецЕсли;

		ТабФормы.ТекущиеДанные.СпособМаппинга 					= ВыбранноеЗначение.СпособМаппинга;
		ТабФормы.ТекущиеДанные.ВыражениеВычисления 				= ВыбранноеЗначение.ВыражениеВычисления;
		ТабФормы.ТекущиеДанные.ВыражениеВычисления2 			= ВыбранноеЗначение.ВыражениеВычисления2;
		ТабФормы.ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр	= ВыбранноеЗначение.ВыражениеВычисленияСтрокаНеогр;
		ТабФормы.ТекущиеДанные.КлючДопСвойстваРеквизита 		= ВыбранноеЗначение.КлючДопСвойстваРеквизита;
		ТабФормы.ТекущиеДанные.СвойствоОбъекта 					= ВыбранноеЗначение.СвойствоОбъекта;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораРеквизитаОбъекта(ТекВыражениеВычисления, ТипСправочникаИлиДокумента)
	
	ПолноеИмяСправочника 	= "Справочник." + ТипСправочникаИлиДокумента;
	ПолноеИмяДокумента 		= "Документ." 	+ ТипСправочникаИлиДокумента;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяСправочника);  
	
	Если ОбъектМетаданных = Неопределено Тогда 
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяДокумента);
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Если ЗначениеЗаполнено(ТипСправочникаИлиДокумента) Тогда 
		
		Если СокрЛП(ТекВыражениеВычисления) = "" Тогда
			
			КонтейнерКоллекцииРеквизитов = ОбъектМетаданных.Реквизиты;
			
		Иначе
			
			МассивВложенности = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ТекВыражениеВычисления,".");
			
			КонтейнерКоллекцииРеквизитов = ОбъектМетаданных.Реквизиты;
			
			Для Каждого текРеквизит Из МассивВложенности Цикл
				
				Попытка
					Если КонтейнерКоллекцииРеквизитов = Неопределено Тогда 
						ТипТекущегоЭлемента = ОбъектМетаданных.Реквизиты[текРеквизит].Тип.Типы()[0];
						КонтейнерКоллекцииРеквизитов = Метаданные.НайтиПоТипу(ТипТекущегоЭлемента).Реквизиты;
					Иначе
					    ТипТекущегоЭлемента = КонтейнерКоллекцииРеквизитов[текРеквизит].Тип.Типы()[0];
						КонтейнерКоллекцииРеквизитов = Метаданные.НайтиПоТипу(ТипТекущегоЭлемента).Реквизиты;
						Прервать;
					КонецЕсли;
				Исключение
					КонтейнерКоллекцииРеквизитов = Неопределено;
					Прервать;
				КонецПопытки;
			КонецЦикла;
			
		КонецЕсли;
		
		Если КонтейнерКоллекцииРеквизитов <> Неопределено Тогда 
			Для Каждого Реквизит Из КонтейнерКоллекцииРеквизитов Цикл
				СписокВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним, , БиблиотекаКартинок.Реквизит);
			КонецЦикла;
		КонецЕсли;
		// если выводим для документа - то еще стандартные реквизиты
		Если СокрЛП(ТекВыражениеВычисления) = "" Тогда
			Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл				
				Синоним = ?(Не ЗначениеЗаполнено(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним);				
				СписокВыбора.Добавить(Реквизит.Имя, Синоним, , БиблиотекаКартинок.Реквизит);				
			КонецЦикла;
		КонецЕсли;
		
		// Сотрудники
		Если ТипСправочникаИлиДокумента = "КонтурЛогистика_Сотрудники" Тогда
			СписокВыбора.Добавить("МожетПодписывать", "Может подписывать", , БиблиотекаКартинок.Реквизит);
			СписокВыбора.Добавить("МожетПередаватьНаПодпись", "Может передавать на подпись", , БиблиотекаКартинок.Реквизит);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикВыбораЗначенияСписка(ВыбранноеЗначение = Неопределено, Элемент = Неопределено) Экспорт
		
	Если ВыбранноеЗначение <> Неопределено и Элемент <> Неопределено Тогда
		
		ТекДанные = Элементы.ПравилаКонвертации.ТекущиеДанные;
		
		ПредставлениеПоля 	= СтрЗаменить(Элемент.Имя, "ПравилаКонвертации", "");
		ИмяПоля 			= СтрЗаменить(ПредставлениеПоля, "Представление", "");
		
		Если ИмяПоля = "РеквизитСправочникаЛогистика" Тогда 
			
			ТекДанные[ИмяПоля]			 = ВыбранноеЗначение.Значение;		
			ТекДанные[ПредставлениеПоля] = ВыбранноеЗначение.Представление;
			
			Настройка = ПолучитьНастройкуПоУмолчаниюДляПоля(Объект.ТипСправочникаЛогистика, Объект.ТипСправочникаИлиДокументаУС, ВыбранноеЗначение.Значение, Объект.ТипДокументаОснования, Объект.РеквизитТитула);
			
			Если Настройка = Неопределено Тогда 
				
				Настройка = НастройкаДляПоля(ИмяПоля, Объект.ТипСправочникаЛогистика, ВыбранноеЗначение.Значение); 
								
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ТекДанные, Настройка);
			
			УстановитьОтборСтрокТаблицыСоответствий();
			
		ИначеЕсли ИмяПоля = "ВыражениеВычисления" Тогда 
			
			Если ЗначениеЗаполнено(СокрЛП(ТекДанные.ВыражениеВычисления)) Тогда
				
				ТекДанные.ВыражениеВычисления = "" + СокрЛП(ТекДанные.ВыражениеВычисления) + "." + ВыбранноеЗначение.Значение;
				
			Иначе                        
				
				ТекДанные.ВыражениеВычисления = ВыбранноеЗначение.Значение;  
				
			КонецЕсли;		
			
		ИначеЕсли ИмяПоля = "СпособМаппинга" Тогда 
			
			ТекДанные.СпособМаппинга = ВыбранноеЗначение.Значение;
			
			Если ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") Тогда 
				
				ТекДанные.ВыражениеВычисления = "Основание.Дата";
				
			ИначеЕсли ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ЗначениеОбщейНастройки") Тогда 
				
				ТекДанные.ВыражениеВычисления = ПредопределенноеЗначение("Справочник.КонтурЛогистика_Настройки.ПустаяСсылка");
				
			ИначеЕсли ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение") Тогда 
				
				Если ТекДанные.РеквизитСправочникаЛогистикаТипЗначения = "Булево" Тогда 
					
					ТекДанные.ВыражениеВычисления = Ложь;
					
				ИначеЕсли ТекДанные.РеквизитСправочникаЛогистикаТипЗначения = "Строка" Тогда
					
					ТекДанные.ВыражениеВычисления = "";
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура ОбработчикВводДопСвойства(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено И ТипЗнч(ВыбранноеЗначение) = тип("Структура") И ИмяЭлемента <> Неопределено Тогда
		Элементы[ИмяЭлемента].Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления 		= ВыбранноеЗначение.ВыражениеВычисления;
		Элементы[ИмяЭлемента].Родитель.Родитель.ТекущиеДанные.КлючДопСвойстваРеквизита 	= ВыбранноеЗначение.КлючДопСвойстваРеквизита;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВведенКодВычисления(ВыбранноеЗначение = Неопределено, Элемент = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено и Элемент <> Неопределено Тогда
		Элемент.Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления = ВыбранноеЗначение;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкаДляПоля(ИмяПоля, ТипСправочникаЛогистика, ИмяРеквизита)
	
	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкуДляПоля(ИмяПоля);
	
КонецФункции	
	
&НаСервереБезКонтекста
Функция ПолучитьНастройкуПоУмолчаниюДляПоля(ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ИмяПоля, ТипДокументаОснования = Неопределено, РеквизитТитула = Неопределено)

	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкуПоУмолчаниюДляПоля(ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ИмяПоля, ТипДокументаОснования, РеквизитТитула);

КонецФункции

&НаКлиенте
Процедура ЗаполнитьАвтоматически(ПерезаполнитьТабличнуюЧасть = Истина)
	
	АвтоманическоеЗаполненияПравилКонвертации(ПерезаполнитьТабличнуюЧасть);
	
КонецПроцедуры

&НаСервере
Процедура АвтоманическоеЗаполненияПравилКонвертации(ПерезаполнитьТабличнуюЧасть = Истина)
	
	Если ПерезаполнитьТабличнуюЧасть Тогда
		ЗаполнитьПравилаКонвертации();
	КонецЕсли;
	ЗаполнитьПравилаКонвертацииЗначений();
	ЗаполнитьДеревоРеквизитовСпрУчСистПоСправочнику1С();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПравилаКонвертации()
	
	Если ЗначениеЗаполнено(Объект.ТипСправочникаЛогистика) Тогда
		
		Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ЗаполнитьПравилаКонвертации(
			Объект.ПравилаКонвертации,
			Объект.ТипСправочникаЛогистика,
			Объект.ТипСправочникаИлиДокументаУС,
			Объект.ТипДокументаОснования,
			Объект.РеквизитТитула);
		
		ЗаполнитьПравилаДляРеквизита();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПравилаДляРеквизита()
	
	Если Объект.РеквизитТитула = Перечисления.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.Водитель Тогда
		УстановитьНастрокуЗаполненияРеквизита("РольВодитель");
	ИначеЕсли Объект.РеквизитТитула = Перечисления.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.МестоДоставки Тогда
		УстановитьНастрокуЗаполненияРеквизита("Прибытие");
	ИначеЕсли Объект.РеквизитТитула = Перечисления.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.МестоПогрузки Тогда
		УстановитьНастрокуЗаполненияРеквизита("Отправление");
	ИначеЕсли Объект.РеквизитТитула = Перечисления.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.Прицеп Тогда
		УстановитьНастрокуЗаполненияРеквизита("ЭтоПрицеп");
	ИначеЕсли Объект.РеквизитТитула = Перечисления.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.ПогрузкаСотрудник Тогда
		УстановитьНастрокуЗаполненияРеквизита("РольКладовщик");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастрокуЗаполненияРеквизита(РеквизитСправочникаЛогистика)
	
	Для Каждого ТекущаяСтрока Из Объект.ПравилаКонвертации Цикл
		Если ТекущаяСтрока.РеквизитСправочникаЛогистика <> РеквизитСправочникаЛогистика Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение;
		ТекущаяСтрока.ВыражениеВычисления = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПравилаКонвертацииЗначений()

	Объект.ТаблицаСоответствий.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийСпособМаппингаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	Если ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение") Тогда 
					
		ТекДанные.ВыражениеВычисления = "";
			
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//НачалоВыбораВыражения(СтандартнаяОбработка, Элемент);
	
КонецПроцедуры

&НаСервере
Функция БазовыйСписокВыбораСпособаМаппинга()
	
	// метка НКС-1 (поиск в подсистеме по метке покажет связанные)
	// на момент реализации неочевидна необходимость использования способов маппинга ИзПредыдущегоТитула и РеквизитЗаполненногоТитула в настройке конвернтации справочника
	
	Список = Новый СписокЗначений;
	
	МенеджерПеречисления = "Перечисление.КонтурЛогистика_СпособыМаппингаПоля.";
	
	Список.Добавить(ПредопределенноеЗначение(МенеджерПеречисления + "ВычислитьВыражение"));
	Список.Добавить(ПредопределенноеЗначение(МенеджерПеречисления + "ФиксированноеЗначение"));
	Список.Добавить(ПредопределенноеЗначение(МенеджерПеречисления + "ЗначениеОбщейНастройки"));
	Список.Добавить(ПредопределенноеЗначение(МенеджерПеречисления + "ДопСвойство"));
	Список.Добавить(ПредопределенноеЗначение(МенеджерПеречисления + "ДопРеквизит"));
	Список.Добавить(ПредопределенноеЗначение(МенеджерПеречисления + "НеЗаполнять"));
	
	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура ТипДокументаОснованияПриИзменении(Элемент)
	
	ЭтаФорма.Записать();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииСпособМаппингаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокВыбора = СписокВыбораСпособаМаппинга();
	
	Элементы.ПравилаКонвертацииСпособМаппинга.СписокВыбора.Очистить();
	
	Для Каждого СтрокаСписка Из СписокВыбора Цикл
		ЗаполнитьЗначенияСвойств(Элементы.ПравилаКонвертацииСпособМаппинга.СписокВыбора.Добавить(), СтрокаСписка);
	КонецЦикла;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьИзСписка_КонтурЛогистика(
		СписокВыбора, Элемент, ЭтаФорма, "ВыборСпособаМаппинга",, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСпособаМаппинга(ЭлементСпискаЗначений = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если ЭлементСпискаЗначений <> Неопределено Тогда
		Элементы.ПравилаКонвертации.ТекущиеДанные.СпособМаппинга = ЭлементСпискаЗначений.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокВыбораСпособаМаппинга()
	
	СписокВыбора = БазовыйСписокВыбораСпособаМаппинга();
	
	Если Объект.ТипСправочникаИлиДокументаУС <> "Строка" Тогда
		ВставитьСпособМаппингаВСписокВыбора(СписокВыбора, Объект.ТипДокументаОснования);	
		СписокВыбора.Вставить(0, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС);
	КонецЕсли;
	
	// Контактная информация
	Если ЕстьКонтактнаяИнформацияОбъекта Тогда
		Позиция = СписокВыбора.Количество() - 1;	// Предпоследняя
		СписокВыбора.Вставить(Позиция, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.КонтактнаяИнформация);
	КонецЕсли;
	
	// Значения свойств объектов
	Если ЕстьЗначенияСвойствОбъектов Тогда
		Позиция = СписокВыбора.Количество() - 1;
		СписокВыбора.Вставить(Позиция, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначенияСвойствОбъектов);
	КонецЕсли;
	
	// Документы физических лиц
	Если ЕстьДокументыФизическихЛиц Тогда
		Позиция = СписокВыбора.Количество() - 1;
		СписокВыбора.Вставить(Позиция, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДокументФизическогоЛица);
	КонецЕсли;
			
	Возврат СписокВыбора;
	
КонецФункции

