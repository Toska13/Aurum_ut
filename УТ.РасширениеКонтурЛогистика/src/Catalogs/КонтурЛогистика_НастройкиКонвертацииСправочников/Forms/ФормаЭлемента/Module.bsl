&НаКлиенте
Процедура ПравилаКонвертацииПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрокТаблицыСоответствий();	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокТаблицыСоответствий()

	ТекДанные = Элементы.ПравилаКонвертации.ТекущиеДанные;
	
	Если Текданные = Неопределено Тогда 
		
		Элементы.ГруппаТаблицаСоответствия.Видимость = Ложь;
		
		Возврат
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекДанные.РеквизитСправочникаЛогистика) 
		И ТекДанные.СпособКонвертацииЗначения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьПоТаблицеСоответствий") Тогда  
		
		Элементы.ГруппаТаблицаСоответствия.Видимость = Истина;
		
		Элементы.ТаблицаСоответствий.ОтборСтрок = Новый ФиксированнаяСтруктура("РеквизитСправочникаЛогистика", ТекДанные.РеквизитСправочникаЛогистика);
		
	Иначе
		
		Элементы.ГруппаТаблицаСоответствия.Видимость = Ложь;
		
		Элементы.ТаблицаСоответствий.ОтборСтрок = Неопределено;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииСпособКонвертацииЗначенияПриИзменении(Элемент)
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекПравило = Элементы.ПравилаКонвертации.ТекущиеДанные;
	
	Если НоваяСтрока Тогда 
	
		Элемент.ТекущиеДанные.РеквизитСправочникаЛогистика 	= ТекПравило.РеквизитСправочникаЛогистика;
		Элемент.ТекущиеДанные.СпособМаппинга 				= ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение");
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОформлениеТумблера()
		
	Элементы.Вкл.Видимость 	= НастройкаАвтоконвертацииВключена;
	Элементы.Выкл.Видимость = Не НастройкаАвтоконвертацииВключена;
	
КонецПроцедуры	

&НаСервере
Процедура ОпределитьНастройкуАвтоконвертации()
	
	НастройкаАвтоконвертации = Справочники.КонтурЛогистика_Настройки.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.ТипСправочникаЛогистика) Тогда 
		
		ИмяПредопределенного = "Автоконвертация_" + Объект.ТипСправочникаЛогистика;
		
		НастройкаАвтоконвертации = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
				
	КонецЕсли;	
	
	Элементы.ГруппаТумблер.Видимость = ЗначениеЗаполнено(Объект.ТипСправочникаЛогистика);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьВключенаНастройкаАвтоконвертации()
		
	Если ЗначениеЗаполнено(НастройкаАвтоконвертации) Тогда 
		
		ИмяПредопределенного = "Автоконвертация_" + Объект.ТипСправочникаЛогистика;
		
		НастройкаАвтоконвертацииВключена = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(ИмяПредопределенного);
				
	КонецЕсли;	
		
КонецПроцедуры

