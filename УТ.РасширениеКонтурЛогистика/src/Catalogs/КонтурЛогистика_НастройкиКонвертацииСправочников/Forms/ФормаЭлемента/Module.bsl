&НаКлиенте
Процедура УстановитьОбновлятьПоВыделеннымСтрокам(Команда)
		
	УстановитьЗначениеОбновлятьПоВыделеннымСтрокам(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеОбновлятьПоВыделеннымСтрокам(Значение)
		
	ВыделенныеСтроки = Элементы.ПравилаКонвертации.ВыделенныеСтроки;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		текСтрока = Объект.ПравилаКонвертации.НайтиПоИдентификатору(ВыделеннаяСтрока);
		текСтрока.ОбновитьИзУчетнойСистемы = Значение;
				
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОбновлятьПоВыделеннымСтрокам(Команда)
	
	УстановитьЗначениеОбновлятьПоВыделеннымСтрокам(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеОбновлятьДляНастроенныхСтрок()
		
	Для Каждого Строка Из Объект.ПравилаКонвертации Цикл
		
		Если Строка.СпособМаппинга <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять") Тогда
			Строка.ОбновитьИзУчетнойСистемы = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НаправлениеКонвертацииПриИзменении(Элемент)
	
	УправлениеЭлементамиОбратногоМаппинга();
	
	УстановитьНаименованиеОбъекта(ЭтаФорма);
	
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
	
		Если Объект.ЗаполнениеСпрУчСист.Количество() = 0 Тогда
			ЗаполнитьДеревоРеквизитовСпрУчСистПоСправочнику1С();
		КонецЕсли;
		
		Если Элементы.ТипСправочникаИлиДокументаУС.СписокВыбора.НайтиПоЗначению("Строка") <> Неопределено Тогда
			Элементы.ТипСправочникаИлиДокументаУС.СписокВыбора.Удалить(Элементы.ТипСправочникаИлиДокументаУС.СписокВыбора.НайтиПоЗначению("Строка"));
		КонецЕсли;
		
	Иначе
		
		Если Элементы.ТипСправочникаИлиДокументаУС.СписокВыбора.НайтиПоЗначению("Строка") = Неопределено Тогда
			Элементы.ТипСправочникаИлиДокументаУС.СписокВыбора.Добавить("Строка", "Строка",, БиблиотекаКартинок.Реквизит);
		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементыФормы()
		
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
		Элементы.Переместить(Элементы.ГруппаДекорацияСтрелка, Элементы.Группа2, Элементы.ТипДокументаОснования);
		Элементы.Переместить(Элементы.ГруппаТипСправочникаИлиДокументаУС, Элементы.Группа2, Элементы.ТипДокументаОснования);		
	Иначе
		Элементы.Переместить(Элементы.ГруппаТипСправочникаИлиДокументаУС, Элементы.Группа2, Элементы.ТипСправочникаЛогистика);
		Элементы.Переместить(Элементы.ГруппаДекорацияСтрелка, Элементы.Группа2, Элементы.ТипСправочникаЛогистика);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиОбратногоМаппинга()

	ЭтоОбратныйМаппингПер = ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации);
	
	Элементы.СтраницаТитулУчСпр.Видимость = ЭтоОбратныйМаппингПер;
	
	Элементы.ГруппаСоздавать.Видимость = ЭтоОбратныйМаппингПер;
	
	Элементы.СтраницаУчСпрТитул.Видимость = Не ЭтоОбратныйМаппингПер;
	
	Элементы.ТипДокументаОснования.Видимость = Не ЭтоОбратныйМаппингПер;
	
	ИзменитьОписаниеТипаСправочников();
	
	ПереместитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОписаниеТипаСправочников()

	ЭтоОбратныйМаппингПер = ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации);
	
	Если ЭтоОбратныйМаппингПер Тогда
		Элементы.ТипСправочникаЛогистика.Подсказка = "укажите из какого справочника Контур.Логистика брать значения для заполнения " 
			+ "реквизитов справочника учетной системы";
		
		Элементы.ТипСправочникаИлиДокументаУС.Заголовок = "Справочник учетной системы";
		Элементы.ТипСправочникаИлиДокументаУС.Подсказка = "укажите для какого справочника учетной системы производится настройка "
			+ "конвертации";
	Иначе
		Элементы.ТипСправочникаЛогистика.Подсказка = "укажите для какого справочника Контур.Логистика производится настройка "
			+ "конвертации";
			
		Если Не ЗначениеЗаполнено(Объект.ТипСправочникаИлиДокументаУС) Тогда
			Элементы.ТипСправочникаИлиДокументаУС.Заголовок = "Справочник/документ учетной системы/строка";
			Элементы.ТипСправочникаИлиДокументаУС.Подсказка = "укажите из какого справочника или документа учетной системы или строки брать "
			+ "значения для заполнения реквизитов справочника Контур.Логистика";
		КонецЕсли;
	КонецЕсли;		
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОбратныйМаппинг(НаправлениеКонвертации)
	
	Если НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ИскатьСоздаватьСпрУчСисПриИзменении(Элемент)
	
	Объект.СоздаватьЭлементСправочникаУчетнойСистемы = (ИскатьСоздаватьСпрУчСис = "Искать и создать");
	
	ИзменитьОтображениеЭлементовПриИскатьСоздать();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтображениеЭлементовПриИскатьСоздать()
	
	Если ИскатьСоздаватьСпрУчСис = "Искать и создать" Тогда
		Элементы.ДеревоРеквизитовСпрУчСистТипАлгоритма.Видимость = Истина;
		ИзменитьОтображениеТаблицыДеревоРеквизитовСпрУчСистСервер(Истина);
	Иначе
		Элементы.ДеревоРеквизитовСпрУчСистТипАлгоритма.Видимость = Ложь;
		ИзменитьОтображениеТаблицыДеревоРеквизитовСпрУчСистСервер(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьОтображениеТаблицыДеревоРеквизитовСпрУчСистСервер(Дерево)
	
	Если Дерево Тогда
		Элементы.ДеревоРеквизитовСпрУчСист.Отображение = ОтображениеТаблицы.Дерево;
	Иначе
		Элементы.ДеревоРеквизитовСпрУчСист.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПереключательИскатьСоздаватьСпрУчСис()
	
	Если Объект.СоздаватьЭлементСправочникаУчетнойСистемы Тогда
		ИскатьСоздаватьСпрУчСис = "Искать и создать";
	Иначе
		ИскатьСоздаватьСпрУчСис = "Искать";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеЭлементамиОбратногоМаппинга();
	
	ИзменитьПереключательИскатьСоздаватьСпрУчСис();
	
	ИзменитьОтображениеЭлементовПриИскатьСоздать();
	
	УправлениеОтображениемТипСправочникаИлиДокументаУС();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеОтображениемТипСправочникаИлиДокументаУС()
	
	НаправлениеКонвертацииВходящее = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	НаправлениеКонвертацииВходящееЗначениеВыбора = Элементы.НаправлениеКонвертации.СписокВыбора.НайтиПоЗначению(НаправлениеКонвертацииВходящее);
	
	Если Объект.ТипСправочникаИлиДокументаУС = "Строка" Тогда
		
		Если НаправлениеКонвертацииВходящееЗначениеВыбора <> Неопределено Тогда
			Элементы.НаправлениеКонвертации.СписокВыбора.Удалить(НаправлениеКонвертацииВходящееЗначениеВыбора);
		КонецЕсли;
		
		Элементы.ТипДокументаОснования.Видимость = Ложь;
		
	Иначе
		
		Если НаправлениеКонвертацииВходящееЗначениеВыбора = Неопределено Тогда
			Элементы.НаправлениеКонвертации.СписокВыбора.Добавить(НаправлениеКонвертацииВходящее, "Справочник логистика → Справочник учетной системы");
		КонецЕсли;
		
		Элементы.ТипДокументаОснования.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРеквизитУчСист(Команда)
	
	ТекДанные = Элементы.ДеревоРеквизитовСпрУчСист.ТекущиеДанные;
	
	СпискиРеквизитов = СписокРеквизитовДляДобавления();
	
	ПараметрыФормыНастройки = Новый Структура;
	ПараметрыФормыНастройки.Вставить("ТипСправочника1С", Объект.ТипСправочникаИлиДокументаУС);
	ПараметрыФормыНастройки.Вставить("ТипСправочникаЛогистика", Объект.ТипСправочникаЛогистика);
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	ПараметрыФормыНастройки.Вставить("СписокРеквизитов", СпискиРеквизитов.СписокРеквизитов);
	ПараметрыФормыНастройки.Вставить("СписокРевизитовМетодаЗаполнить", СпискиРеквизитов.СписокРевизитовМетодаЗаполнить);
	ПараметрыФормыНастройки.Вставить("СписокРевизитовУказать", СпискиРеквизитов.СписокРевизитовУказать);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаДобавленияРеквизитаУчСист",
		ПараметрыФормыНастройки,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикДобавленияРеквизитаУчСист"
		,
		);
	
КонецПроцедуры

&НаКлиенте
Функция СписокРеквизитовДляДобавления() Экспорт
	
	МассивТекущихРеквизитов = Новый Массив;	
	МассивРеквизитовОбъектаМетаданных = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СписокРеквизитовОбъектаМетаданных(Объект.ТипСправочникаИлиДокументаУС, "Справочник");
	СписокРевизитовМетодаЗаполнить = Новый СписокЗначений;
	СписокРевизитовУказать = Новый СписокЗначений;
	
	Для каждого Алгоритм Из ДеревоРеквизитовСпрУчСист.ПолучитьЭлементы() Цикл
		
		Если ЗначениеЗаполнено(Алгоритм.Реквизит) Тогда
			МассивТекущихРеквизитов.Добавить(Алгоритм.Реквизит);
		КонецЕсли;
		
		Если Алгоритм.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит") Тогда
			СписокРевизитовУказать.Добавить(Алгоритм.Реквизит);
		КонецЕсли;		
		
		Для каждого Стр Из Алгоритм.ПолучитьЭлементы() Цикл
			
			Если ЗначениеЗаполнено(Стр.Реквизит) Тогда
				
				МассивТекущихРеквизитов.Добавить(Стр.Реквизит);
				
				Если Стр.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") Тогда
					СписокРевизитовМетодаЗаполнить.Добавить(Стр.Реквизит);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	МассивРеквизитов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивРеквизитовОбъектаМетаданных, МассивТекущихРеквизитов); 
	
	СписокРеквизитов = Новый СписокЗначений();
	СписокРеквизитов.ЗагрузитьЗначения(МассивРеквизитов);
	
	Результат = Новый Структура("СписокРеквизитов, СписокРевизитовМетодаЗаполнить, СписокРевизитовУказать", 
			СписокРеквизитов, СписокРевизитовМетодаЗаполнить, СписокРевизитовУказать);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикДобавленияРеквизитаУчСист(ЗаполненныеДанные, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ЗаполненныеДанные) Тогда
		
		Если ЗаполненныеДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит")
			Или ЗаполненныеДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик") Тогда
			НоваяСтрока = ДеревоРеквизитовСпрУчСист.ПолучитьЭлементы().Добавить();
		ИначеЕсли ЗаполненныеДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") Тогда
			НоваяСтрока = ПолучитьГруппуЗаполнить(ЗаполненныеДанные).ПолучитьЭлементы().Добавить();	
		КонецЕсли;
		
		НоваяСтрока.ТипАлгоритма = ЗаполненныеДанные.ТипАлгоритма;
		НоваяСтрока.Реквизит = ЗаполненныеДанные.Реквизит;
		НоваяСтрока.РеквизитТипЗначения = ЗаполненныеДанные.РеквизитТипЗначения;
		НоваяСтрока.СпособРасчета = ЗаполненныеДанные.СпособРасчета;
		НоваяСтрока.ВыражениеВычисления = ЗаполненныеДанные.ВыражениеВычисления; 
		НоваяСтрока.ВыражениеВычисленияУИД = ЗаполненныеДанные.ВыражениеВычисленияУИД;	
		НоваяСтрока.ВыражениеВычисленияТипЗначения = ЗаполненныеДанные.ВыражениеВычисленияТипЗначения;
		НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = ЗаполненныеДанные.ВыражениеВычисленияСтрокаНеогр;
		
		Элементы.ДеревоРеквизитовСпрУчСист.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьГруппуЗаполнить(ЗаполненныеДанные)
	
	Для каждого Стр Из ДеревоРеквизитовСпрУчСист.ПолучитьЭлементы() Цикл
		
		Если Стр.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") 
			И Не ЗначениеЗаполнено(Стр.Реквизит) Тогда
			
			Возврат Стр;
			
		КонецЕсли;
		
	КонецЦикла
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоРеквизитовСпрУчСистПоСправочнику1С()
	
	дз = Новый ДеревоЗначений;
	Для каждого РеквизитТЧ Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ТабличныеЧасти.ЗаполнениеСпрУчСист.Реквизиты Цикл
		дз.Колонки.Добавить(РеквизитТЧ.Имя);
	КонецЦикла;
		
	МетаданныеСпр = Метаданные.Справочники.Найти(Объект.ТипСправочникаИлиДокументаУС);
	
	Если МетаданныеСпр <> Неопределено Тогда
		
		СтрокаТипАлгоритмаЗаполнить = дз.Строки.Добавить();
		СтрокаТипАлгоритмаЗаполнить.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
		СтрокаТипАлгоритмаЗаполнить.Скрыть = Истина;
		
		СтрокаТипАлгоритма = дз.Строки.Добавить();
		СтрокаТипАлгоритма.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик;
		СтрокаТипАлгоритма.Скрыть = Истина;
		
		Для каждого Рекв Из МетаданныеСпр.Реквизиты Цикл
			
			СтрокаЗапись = СтрокаТипАлгоритмаЗаполнить.Строки.Добавить();
			СтрокаЗапись.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
			СтрокаЗапись.Реквизит = Рекв.Имя;
			СтрокаЗапись.РеквизитТипЗначения = Рекв.Тип;
			СтрокаЗапись.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
			
		Конеццикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(дз, "ДеревоРеквизитовСпрУчСист");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРеквизитовСпрУчСист()
	
	дз = Новый ДеревоЗначений;
	Для каждого РеквизитТЧ Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ТабличныеЧасти.ЗаполнениеСпрУчСист.Реквизиты Цикл
		дз.Колонки.Добавить(РеквизитТЧ.Имя);
	КонецЦикла;
	
	СтрокаТипАлгоритмаЗаполнить = "";
	
	Для каждого Стр Из Объект.ЗаполнениеСпрУчСист Цикл
		
		Если Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить И Не ЗначениеЗаполнено(Стр.Реквизит) Тогда
			СтрокаТипАлгоритмаЗаполнить = дз.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТипАлгоритмаЗаполнить, Стр);	
			СтрокаТипАлгоритмаЗаполнить.Скрыть = Истина;
		ИначеЕсли Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить И ЗначениеЗаполнено(Стр.Реквизит) Тогда
			СтрокаЗапись = СтрокаТипАлгоритмаЗаполнить.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗапись, Стр);
		ИначеЕсли Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит 
			ИЛИ Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
			СтрокаЗапись = дз.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗапись, Стр);
			
			Если Не ЗначениеЗаполнено(СтрокаЗапись.Реквизит) Тогда
				СтрокаТипАлгоритмаЗаполнить.Скрыть = Истина;
			КонецЕсли;
			
		КонецЕсли;	
		
	Конеццикла;
		
	ЗначениеВРеквизитФормы(дз, "ДеревоРеквизитовСпрУчСист");
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДеревоРеквизитовСпрУчСистВТаблЧасть(Отказ)
	
	ЕстьКлючевоеПоле = Ложь;
	дз = РеквизитФормыВЗначение("ДеревоРеквизитовСпрУчСист");
	
	Для Каждого Стр Из дз.Строки Цикл
		
		Если Стр.Строки.Количество() = 0 И Стр.КлючевоеПоле = Истина Тогда
				
			ПроверитьЗаполнениеКлючевогоПоля(ЕстьКлючевоеПоле, Стр, Отказ);
			
		Иначе
			
			Для Каждого Стр2 Из Стр.Строки Цикл
				
				Если Стр2.КлючевоеПоле = Истина Тогда
					
					ПроверитьЗаполнениеКлючевогоПоля(ЕстьКлючевоеПоле, Стр2, Отказ);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЕстьКлючевоеПоле Тогда 
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "В таблице не выбрано поле для поиска";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;
	
	Объект.ЗаполнениеСпрУчСист.Очистить();	
	
	Для каждого Стр Из дз.Строки Цикл
		
		НоваяСтрока = Объект.ЗаполнениеСпрУчСист.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
		Для Каждого Стр2 Из Стр.Строки Цикл
			
			НоваяСтрока = Объект.ЗаполнениеСпрУчСист.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр2);
			
		КонецЦикла;
		
	КонецЦикла
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеКлючевогоПоля(ЕстьКлючевоеПоле, Строка, Отказ)
	
	ЕстьКлючевоеПоле = Истина;
	
	Если Не ЗначениеЗаполнено(Строка.ВыражениеВычисления) И Не ЗначениеЗаполнено(Строка.ВыражениеВычисленияСтрокаНеогр) Тогда 
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Для поля поиска """ + Строка.Реквизит + """ не заполнено выражение вычисления";
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовСпрУчСистВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
