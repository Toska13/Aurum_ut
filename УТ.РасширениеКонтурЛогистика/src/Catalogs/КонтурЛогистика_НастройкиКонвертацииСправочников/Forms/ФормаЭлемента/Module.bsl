&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНаименованиеОбъекта(Форма)
	
	Объект = Форма.Объект;
	
	Если ЗначениеЗаполнено(Объект.ТипСправочникаИлиДокументаУС)
		Или ЗначениеЗаполнено(Объект.ТипСправочникаЛогистика) Тогда
		
		КраткоеИмяСправочникаЛогистика = СтрЗаменить(Объект.ТипСправочникаЛогистика, "КонтурЛогистика_", "");
		
		Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
			Объект.Наименование = КраткоеИмяСправочникаЛогистика + " в " + Объект.ТипСправочникаИлиДокументаУС;
		Иначе
			Объект.Наименование = Объект.ТипСправочникаИлиДокументаУС + " в " + КраткоеИмяСправочникаЛогистика;
		КонецЕсли;
		
	Иначе
		Объект.Наименование = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСправочникаЛогистикаПриИзменении(Элемент)
	
	УстановитьНаименованиеОбъекта(ЭтаФорма);
	ЗаполнитьАвтоматически();
	
	ОбработатьИзменениеНастройкиАвтоконвертации();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеНастройкиАвтоконвертации()
		
	ОпределитьНастройкуАвтоконвертации();
	ОпределитьВключенаНастройкаАвтоконвертации();
	
	ОформлениеТумблера();
	
КонецПроцедуры

