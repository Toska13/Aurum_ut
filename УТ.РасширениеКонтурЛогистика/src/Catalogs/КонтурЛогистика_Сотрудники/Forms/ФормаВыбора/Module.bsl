
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.ОтборРоль) Тогда 
		ОтборРоль = Параметры.ОтборРоль;
	Иначе
		ОтборРоль = "Все";	
	КонецЕсли;
	
	Если Параметры.Свойство("НеИзменятьОтборРоль") И Параметры.НеИзменятьОтборРоль Тогда
		Элементы.ОтборРоль.ТолькоПросмотр = Истина;	
	КонецЕсли;
	
	Параметры.Свойство("ОбъектУчетнойСистемы", ОбъектУчетнойСистемы);
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		СуществующееСопоставление = КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(ОбъектУчетнойСистемы, "Сотрудник");
		
		Элементы.СуществующееСопоставление.Видимость = ЗначениеЗаполнено(СуществующееСопоставление);
		
		Элементы.ГруппаСвязанныйОбъект.Видимость = Истина;
		Элементы.ОбъектУчетнойСистемы.ТолькоПросмотр = Истина;
		ОбъектУчетнойСистемыУстановитьСвязь = Истина;
		Элементы.Список.МножественныйВыбор = Ложь;
		Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		
	Иначе 
		
		Элементы.ГруппаСвязанныйОбъект.Видимость = Ложь;
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере_ФормаВыбора(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборДинСписка();
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРольПриИзменении(Элемент)
	
	УстановитьОтборДинСписка();
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	
	Элементы.ГруппаВУВодителя.Видимость = (ОтборРоль = "Водители");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборДинСписка()

	Список.Отбор.Элементы.Очистить();
	
	Если  ОтборРоль = "Водители" 
		ИЛИ ОтборРоль = "Кладовщики" 
		ИЛИ ОтборРоль = "Механики" 
		ИЛИ ОтборРоль = "Медики" Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = Истина;
		
		Если ОтборРоль = "Водители" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РольВодитель");
		ИначеЕсли ОтборРоль = "Медики" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РольМедик");
		ИначеЕсли ОтборРоль = "Механики" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РольМеханик");
		Иначе
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РольКладовщик");
		КонецЕсли;
		ЭлементОтбора.ПравоеЗначение = Истина;
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовогоСотрудника(Команда)
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ОбъектУчетнойСистемыСсылка", ОбъектУчетнойСистемы);
	
	ПараметрыФормы 		= Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
		
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.ФормаОбъекта",
			ПараметрыФормы,
			,
			ЭтаФорма,
			"ОбработчикСозданиеОбъекта");
			
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда = Неопределено)
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда
			                 
			ТекстВопроса = Строка(ОбъектУчетнойСистемы) +" уже сопоставлен с " + Строка(СуществующееСопоставление)+". Создать еще одно сопоставление?";
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Создать");	
			Кнопки.Добавить("Отменить");
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, Кнопки, , , ЭтаФорма, "ОбработчикВопросаПоСопоставлению");
			
		Иначе	
			
			Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
				УстановитьСвязьСОбъектом();
			КонецЕсли;
			
			ЗакрытьФормуВыборомЗначения();
			
		КонецЕсли;
		
	Иначе
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВопросаПоСопоставлению(ПараметрОбработчика, ДополнительныеПараметры) Экспорт
	
	Если ПараметрОбработчика = "Создать" Тогда
		
		Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
			УстановитьСвязьСОбъектом();
		КонецЕсли;
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСозданиеОбъекта(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт

	// проверить что создали новое и связали с объектом и закрыть эту форму
	СозданныйСотрудник = СозданныйСотрудник(ОбъектУчетнойСистемы);
	Если ЗначениеЗаполнено(СозданныйСотрудник) Тогда 
		ОповеститьОВыборе(СозданныйСотрудник);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуВыборомЗначения()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	ВыбранноеЗначение = ТекДанные.Ссылка;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ОповеститьОВыборе(ВыбранноеЗначение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
	Выбрать(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСвязьСОбъектом()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не могу определить выбранную строку");
		Возврат;
		
	КонецЕсли;
	
	УстановитьСвязьСервер(ТекДанные.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязьСервер(Сотрудник_Ссылка)

	Если Сотрудник_Ссылка.ПометкаУдаления Тогда
		ВызватьИсключение "Невозможно создать сопоставление т.к. Сотрудник помечен на удаление. Выберите другого Сотрудника или снимите пометку удаления.";	
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыСервер.УстановитьСвязьОбъектовЛогистикаУчСист(Сотрудник_Ссылка, ОбъектУчетнойСистемы);
	
КонецПроцедуры

&НаСервере
Функция СозданныйСотрудник(ОбъектУчСист = Неопределено)
	
	Если ЗначениеЗаполнено(ОбъектУчСист) Тогда 
		
		СуществующееСопоставление = КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(ОбъектУчСист, "Сотрудник");
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда 
			Возврат СуществующееСопоставление;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СинхронизироватьРеквизитыИзСвязногоОбъекта(ЛогистическаяСущность, УчетнаяСущность, НастройкаКонвертации)
	
	Возврат КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_СинхронизироватьРеквизитыУчетнойИЛогистическойСущностей(
		УчетнаяСущность, ЛогистическаяСущность, НастройкаКонвертации);
		
КонецФункции	

&НаКлиенте
Процедура ОбновитьИВыбрать(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не могу определить выбранную строку");
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда
			                 
			ТекстВопроса = Строка(ОбъектУчетнойСистемы) +" уже сопоставлен с " + Строка(СуществующееСопоставление)+". Создать еще одно сопоставление?";
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Создать");	
			Кнопки.Добавить("Отменить");
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, Кнопки, , , ЭтаФорма, "ОбработчикВопросаПоСопоставлениюСОбновлением");
			
		Иначе	
			
			Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
				
				Если ЭтоСсылка_(ОбъектУчетнойСистемы) Тогда 
					
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("Отбор", ПараметрыДляФормыОтбора(ОбъектУчетнойСистемы));			
					ПараметрыФормы.Вставить("РежимВыбора", Истина);
									
					КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
						"Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.ФормаВыбора", 
						ПараметрыФормы,
						ЭтаФорма, 
						ЭтаФорма, 
						"ПриЗакрытииФормыВыбора",
						Новый Структура("ОбъектЛогистики", ТекДанные.Ссылка), 
						РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
					
				Иначе
					
					УстановитьСвязьСОбъектом();
					
				КонецЕсли;	
					
			КонецЕсли;
			
			ЗакрытьФормуВыборомЗначения();
			
		КонецЕсли;
		
	Иначе
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбора(НастройкаКонвертации, ДопПараметры) Экспорт
	
    Если НастройкаКонвертации = Неопределено Тогда
        Возврат;
    КонецЕсли;
     
	РезультатСинхронизации = СинхронизироватьРеквизитыИзСвязногоОбъекта(ДопПараметры.ОбъектЛогистики, ОбъектУчетнойСистемы, НастройкаКонвертации);
	
	Если Не РезультатСинхронизации.Успешно Тогда 
		
		ВызватьИсключение "Не удалось синхронизировать реквизиты " + ДопПараметры.ОбъектЛогистики + " из " + ОбъектУчетнойСистемы + Символы.ПС + РезультатСинхронизации.ОписаниеОшибки;
		
	Иначе
		
		УстановитьСвязьСОбъектом();
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВопросаПоСопоставлениюСОбновлением(ПараметрОбработчика, ДопПараметры) Экспорт
	
	Если ПараметрОбработчика = "Создать" Тогда
		
		Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
			УстановитьСвязьСОбъектом();
		КонецЕсли;
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыДляФормыОтбора(ОбъектУчетнойСистемы)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТипСправочникаЛогистика", "КонтурЛогистика_Сотрудники");
	ПараметрыОтбора.Вставить("ОбновлятьРеквизитыИзУчетнойСистемы", Истина);
	ПараметрыОтбора.Вставить("ТипСправочникаИлиДокументаУС", ОбъектУчетнойСистемы.Метаданные().Имя);
	
	Возврат ПараметрыОтбора;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоСсылка_(Ссылка)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТипЗнч(Ссылка));	
	
КонецФункции	
