&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	КонтурЛогистика_КонвертацияКлиент.ОбработкаОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);
  
 	Если ИмяСобытия = "КонтурЛогистика_ОбновитьФизическиеЛица" Тогда		
		
		ЭтаФорма.Прочитать();
		Элементы.ФизическиеЛица.Обновить();
