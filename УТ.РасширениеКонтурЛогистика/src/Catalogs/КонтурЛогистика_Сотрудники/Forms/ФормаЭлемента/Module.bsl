КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставление()

	Объект.Наименование = СокрЛП(Объект.Фамилия);
	
	Если ЗначениеЗаполнено(Объект.Имя) Тогда 
		Объект.Наименование = Объект.Наименование + " " + Лев(СокрЛП(Объект.Имя), 1) + ".";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Отчество) Тогда 
		Объект.Наименование = Объект.Наименование + " " + Лев(СокрЛП(Объект.Отчество), 1) + ".";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.ГруппаКладовщик.Видимость = Объект.РольКладовщик;
	Элементы.ГруппаВУ.Видимость = Объект.РольВодитель;
	Элементы.ГруппаДОПОГ.Видимость = Объект.РольВодитель;
	Элементы.ГруппаАдресЭП.Видимость = Объект.РольВодитель;
	Элементы.ГруппаМедикРеквизиты.Видимость = Объект.РольМедик;
	Элементы.ГруппаТелеграм.Видимость = ИспользоватьОтправкуВТелеграм;
	
	Если Не Объект.РольВодитель Тогда 
		Элементы.ТелефонОсновной.АвтоОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		
		Если ЗначениеЗаполнено(Объект.ТелефонОсновной) Тогда
			ИдетПроверкаТелефонаВТелеграм = Истина;
			ПодключитьОбработчикОжидания("ПроверитьРегистрациюТелеграм", 0.1, Истина);
		КонецЕсли;
		
		ОбновитьВидимостьГруппыТелеграм();
		
	КонецЕсли;
	
	ПереключательОснованиеПолномочийИзмененен();
	
	ОбновитьЗаголовкиСтраниц();
		
КонецПроцедуры

&НаКлиенте
Процедура РольВодительПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
	Если ДоступенСервисФизЛиц И Объект.РольВодитель Тогда		
		
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
			Записать();
		КонецЕсли;
		
		ФизическиеЛица.Параметры.УстановитьЗначениеПараметра("Сотрудник", Объект.Ссылка);
		
	КонецЕсли;
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
		
КонецПроцедуры

&НаКлиенте
Процедура РольКладовщикПриИзменении(Элемент)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

