&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// +++ КонтурЛогистика_НастройкиКонвертацииСправочников
	КонтурЛогистика_КонвертацияСервер.НастройкиКонвертацииСправочников_ПриСозданииНаСервере(
		ЭтаФорма, "КонтурЛогистика_Сотрудники", ЭтаФорма, Элементы.ГруппаСтраницы);
	// --- КонтурЛогистика_НастройкиКонвертацииСправочников
	
	Элементы.СинхронизироватьОбъектЛогистикиСОбъектомУС.Видимость = Объект.СвязанныеОбъекты.Количество() = 1;
	
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);	
	
	Если ЗначениеЗаполнено(Объект.ОснованиеПолномочийДоговор) Тогда
		ПереключательОснованиеПолномочий = "Иные основания";
	Иначе
		ПереключательОснованиеПолномочий = "Должностные обязанности";
	КонецЕсли;
	
	Параметры.Свойство("ОткрытьПриглашение", ОткрытьПриглашение);
	Параметры.Свойство("ОрганизацияВПриглашение", ОрганизацияВПриглашение);
	
	ИнициализироватьСервисФизическихЛиц();	
	
	УстановитьТекущийЭлемент();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	
	Если ОткрытьПриглашение Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.ФизическиеЛица;
		ДобавитьФизическоеЛицо(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("КонтурЛогистика_Сотрудники", Объект.Ссылка);
	Оповестить("КонтурЛогистика_ПерепроверитьДокумент");
	Оповестить("КонтурЛогистика_ОбновитьФизическиеЛица");
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ДоступенСервисФизЛиц И Объект.РольВодитель Тогда		
		ФизическиеЛица.Параметры.УстановитьЗначениеПараметра("Сотрудник", Объект.Ссылка);		
		ОбновитьКолонкиРасхожденийВСпискеФизическихЛиц();		
	Иначе	
		УстановитьВидимостьИПараметрыФизическихЛиц();
	КонецЕсли;
	
КонецПроцедуры

