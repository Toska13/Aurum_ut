Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		
		Наименование = СокрЛП(Фамилия);
		
		Если ЗначениеЗаполнено(Имя) Тогда 
			Наименование = Наименование + " " + Лев(СокрЛП(Имя), 1) + ".";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отчество) Тогда 
			Наименование = Наименование + " " + Лев(СокрЛП(Отчество), 1) + ".";
		КонецЕсли;
		
		Если РольВодитель И
			(ЗначениеЗаполнено(ВУСерия) Или ЗначениеЗаполнено(ВУНомер)) Тогда
			
			Наименование = Наименование + " ("
				+ ?(ЗначениеЗаполнено(ВУСерия), ВУСерия + " ", "") + ВУНомер + ")";
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВФорматеСНИЛС(СНИЛС) Тогда
		СНИЛС = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПривестиЗначениеКФорматуСНИЛС(СНИЛС);
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ", ЭтотОбъект, Отказ);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("КонтурЛогистика_Сотрудники_ПередЗаписью_После", Истина, ПараметрыПМ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ОбъектУчетнойСистемыСсылка")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ОбъектУчетнойСистемыСсылка) Тогда 
		
		ОбъектУчетнойСистемыСсылка = ДанныеЗаполнения.ОбъектУчетнойСистемыСсылка;
		
		Наименование = Строка(ОбъектУчетнойСистемыСсылка);
		НоваяСвязь = СвязанныеОбъекты.Добавить();
		НоваяСвязь.СвязанныйОбъект = ОбъектУчетнойСистемыСсылка;
		
		Если КонтурЛогистика_КонвертацияСервер.ЭтоНетиповаяСсылкаДляСвязанногоОбъекта(Ссылка, ОбъектУчетнойСистемыСсылка) Тогда
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьДанныеДляНетиповогоСправочникаВСвязанныхОбъектах(НоваяСвязь, ОбъектУчетнойСистемыСсылка)
		КонецЕсли;
		
		// TODO включить после реализации справочника конвертации справочников
		// Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ЗаполнитьСущность(ЭтотОбъект, ОбъектУчетнойСистемыСсылка, Перечисления.КонтурЛогистика_СправочникиКонтурЛогистика);
		
	КонецЕсли;
	
	// Заполним разрешения
	ЗаполнитьРазрешенияРаботыСДокументами();
	
КонецПроцедуры

Процедура ЗаполнитьРазрешенияРаботыСДокументами() Экспорт
	
	НашиОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	Для Каждого ТекущаяОрганизация Из НашиОрганизации Цикл
		НоваяСтрока = РазрешенияРаботыСДокументами.Добавить();
		НоваяСтрока.Организация = ТекущаяОрганизация;
		НоваяСтрока.МожетПодписывать = Истина;
		НоваяСтрока.МожетПередаватьНаПодпись = Ложь;
	КонецЦикла;
	
КонецПроцедуры