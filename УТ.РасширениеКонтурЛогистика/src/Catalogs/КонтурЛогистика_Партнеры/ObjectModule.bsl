
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		КодПартнераКонтур 	= ДанныеЗаполнения.КодПартнераКонтур;
		Наименование 		= ДанныеЗаполнения.Наименование;
		ДатаОбновления 		= ДанныеЗаполнения.ДатаОбновления;
		ГП = Истина;
		
		ДанныеСети = КонтурЛогистика_ИнтеграцияEDI_Сервер.ПолучитьСтруктуруДанныхТорговойСети(КодПартнераКонтур); 	
		
		ЗаполнитьДанныеОрганизаций(ДанныеСети);
		
		ЗаполнитьДанныеТочекДоставки(ДанныеСети);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеТочекДоставки(Знач ДанныеСети)
	
	Перем НоваяСтрокаТочкиДоставки, СтрДоставки;
	
	ПунктыМаршрута.Очистить();
	
	Для Каждого СтрДоставки Из ДанныеСети.ТочкиДоставки Цикл
		
		НоваяСтрокаТочкиДоставки = ПунктыМаршрута.Добавить();
		НоваяСтрокаТочкиДоставки.GLN 			= СтрДоставки.GLN;
		НоваяСтрокаТочкиДоставки.АдресИндекс 	= СтрДоставки.Индекс;
		НоваяСтрокаТочкиДоставки.АдресСтрока	= СтрДоставки.Адрес;
		НоваяСтрокаТочкиДоставки.АдресКодРегион	= СтрДоставки.КодРегиона;
		НоваяСтрокаТочкиДоставки.Название		= СтрДоставки.Наименование;
		НоваяСтрокаТочкиДоставки.Прибытие		= Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеОрганизаций(Знач ДанныеСети)
	
	Перем НайденнаяОрганизация, НоваяОрганизация, НоваяСтрокаОрги, СтрОрганизации;
	
	МассивОрганизаций = Новый Массив;
	ОрганизацииДиадок.Очистить();
	
	Для Каждого СтрОрганизации Из ДанныеСети.ЮрФизЛица Цикл 
		
		// найти/создать оргу
		НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(СтрОрганизации.ИНН, СтрОрганизации.КПП);
		
		Если ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
			
			Если НайденнаяОрганизация.GLN <> СтрОрганизации.GLN И СокрЛП(НайденнаяОрганизация.GLN) = "" Тогда 
				НоваяОрганизация = НайденнаяОрганизация.ПолучитьОбъект();
				НоваяОрганизация.GLN = СтрОрганизации.GLN;
				НоваяОрганизация.Грузополучатель = Истина;
				НоваяОрганизация.Записать();
			КонецЕсли;
			
		Иначе
			
			НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
			НоваяОрганизация.GLN = СтрОрганизации.GLN;
			НоваяОрганизация.ИНН = СтрОрганизации.ИНН;
			НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
			НоваяОрганизация.Наименование = СтрОрганизации.Наименование;
			НоваяОрганизация.НаименованиеОрганизацииПолное = СтрОрганизации.Наименование;
			НоваяОрганизация.Грузополучатель = Истина;
			НоваяОрганизация.Записать();
			
			МассивОрганизаций.Добавить(НоваяОрганизация.Ссылка);
			
			Попытка
				
				// синхронизировать из логистики
				Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ApiKeyЗаполненДляОрганизаций() Тогда 
					НоваяОрганизация.СинхронизироватьИзСервисаЛогистика();
				КонецЕсли;
				
			Исключение
				// проблема - нет в диадоке, не ожидаем такого. Anyway, ок, че, пусть остается
			КонецПопытки;
			
			НайденнаяОрганизация = НоваяОрганизация.Ссылка;
			
		КонецЕсли;
		
		НоваяСтрокаОрги = ОрганизацииДиадок.Добавить();
		НоваяСтрокаОрги.Организация = НайденнаяОрганизация;
		НоваяСтрокаОрги.boxId = НайденнаяОрганизация.ID;
		НоваяСтрокаОрги.ГП = Истина;
		
	КонецЦикла;
	
	// запустим автосоответствия для вновь созданных
	Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиИЗаполнитьСвязныеОрганизацииДляОрганизацииДиадок(МассивОрганизаций);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Отказ = Ложь Тогда 
		ОбработатьУстаревшиеТочкиДоставки();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьУстаревшиеТочкиДоставки()
	
	Перем Выборка, Запрос, ПунктМаршрутаОбъект, Результат;
	
	// пометить удаленными точки доставки с этим кодом сети в которых есть GLN и такого GLN теперь нет в 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ПунктыМаршрута.Ссылка КАК Ссылка,
	               |	КонтурЛогистика_ПунктыМаршрута.GLN КАК GLN
	               |ПОМЕСТИТЬ ВТ_ПунктыМаршрутаПартнера
	               |ИЗ
	               |	Справочник.КонтурЛогистика_ПунктыМаршрута КАК КонтурЛогистика_ПунктыМаршрута
	               |ГДЕ
	               |	НЕ КонтурЛогистика_ПунктыМаршрута.ПометкаУдаления
	               |	И КонтурЛогистика_ПунктыМаршрута.GLN <> """"
	               |	И КонтурЛогистика_ПунктыМаршрута.КодПартнераКонтур = &КодПартнераКонтур
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтурЛогистика_ПартнерыПунктыМаршрута.GLN КАК GLN
	               |ПОМЕСТИТЬ ВТ_АктуальныеGLN
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Партнеры.ПунктыМаршрута КАК КонтурЛогистика_ПартнерыПунктыМаршрута
	               |ГДЕ
	               |	КонтурЛогистика_ПартнерыПунктыМаршрута.Ссылка.КодПартнераКонтур = &КодПартнераКонтур
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ПунктыМаршрутаПартнера.Ссылка КАК Ссылка,
	               |	ВТ_АктуальныеGLN.GLN КАК GLNАктуальный,
	               |	ВТ_ПунктыМаршрутаПартнера.GLN КАК GLNТекущий
	               |ИЗ
	               |	ВТ_ПунктыМаршрутаПартнера КАК ВТ_ПунктыМаршрутаПартнера
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АктуальныеGLN КАК ВТ_АктуальныеGLN
	               |		ПО ВТ_ПунктыМаршрутаПартнера.GLN = ВТ_АктуальныеGLN.GLN
	               |ГДЕ
	               |	ВТ_АктуальныеGLN.GLN ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("КодПартнераКонтур", КодПартнераКонтур);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПунктМаршрутаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПунктМаршрутаОбъект.Наименование = "УДАЛЕН ПАРТНЕРОМ " + ПунктМаршрутаОбъект.Наименование;
		ПунктМаршрутаОбъект.GLN = "";
		ПунктМаршрутаОбъект.Записать();
		ПунктМаршрутаОбъект.УстановитьПометкуУдаления(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	// проверим что не ввели дубли настроек
	ТабНастроек = Настройки.Выгрузить(,"Настройка");
	СтрокНастроек = ТабНастроек.Количество();
	ТабНастроек.Свернуть("Настройка");
	СтрокСвернутых = ТабНастроек.Количество();
	Если СтрокНастроек <> СтрокСвернутых Тогда
		Отказ = Истина;
		Сообщить("В партнере есть дубли настроек. Перед записью удалите дублирующиеся строки");
	КонецЕсли;
	
КонецПроцедуры


