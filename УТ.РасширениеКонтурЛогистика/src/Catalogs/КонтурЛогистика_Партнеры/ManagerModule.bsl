Функция ОпределитьПартнераОрганизацииДиадок(ОрганизацияДиадок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ПартнерыОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Партнеры.ОрганизацииДиадок КАК КонтурЛогистика_ПартнерыОрганизацииДиадок
	|ГДЕ
	|	КонтурЛогистика_ПартнерыОрганизацииДиадок.Организация = &Организация
	|	И НЕ КонтурЛогистика_ПартнерыОрганизацииДиадок.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Организация",ОрганизацияДиадок);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

Функция ЗначениеНастройки(ПартнерСсылка, Знач НастройкаПартнераИлиОбщая) Экспорт 
	
	Если ТипЗнч(НастройкаПартнераИлиОбщая) = Тип("Строка") Тогда
		
		// по имени настройки поищем сначала в партнере а потом общую
		
		НастройкаПартнераИлиОбщая = Справочники.КонтурЛогистика_НастройкиПартнеров.ПолучитьСсылкуПоИмениПредопределенного(НастройкаПартнераИлиОбщая);
		Если Не ЗначениеЗаполнено(НастройкаПартнераИлиОбщая) Тогда 
			НастройкаПартнераИлиОбщая = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(НастройкаПартнераИлиОбщая);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НастройкаПартнераИлиОбщая) Тогда 
			ВызватьИсключение "Не существует настройки с именем " + НастройкаПартнераИлиОбщая + " ни в справочнике настроек партнера, ни в справочнике общих настроек";
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_Партнеры.Значение КАК ЗначениеНастройки
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Партнеры.Настройки КАК КонтурЛогистика_Партнеры
	               |ГДЕ
	               |	КонтурЛогистика_Партнеры.Ссылка = &Ссылка
	               |	И КонтурЛогистика_Партнеры.Настройка = &Настройка
	               |	И НЕ КонтурЛогистика_Партнеры.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", ПартнерСсылка);
	Запрос.УстановитьПараметр("Настройка", НастройкаПартнераИлиОбщая);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ЗначениеНастройки;
	Иначе
		Возврат НастройкаПартнераИлиОбщая.Значение;
	КонецЕсли;
	
КонецФункции

// тех у которых есть КодПартнераКонтур
Функция МассивСинхронизируемыхПартнеров() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_Партнеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Партнеры КАК КонтурЛогистика_Партнеры
	|ГДЕ
	|	НЕ КонтурЛогистика_Партнеры.ПометкаУдаления
	|	И КонтурЛогистика_Партнеры.КодПартнераКонтур <> """"";
	
	Результат = Запрос.Выполнить();
	МассивПартнеров = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");	
	
	Возврат МассивПартнеров;
	
КонецФункции

Функция ДобавленныеПартнеры() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КонтурЛогистика_Партнеры.КодПартнераКонтур КАК КодПартнераКонтур
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Партнеры КАК КонтурЛогистика_Партнеры
	               |ГДЕ
	               |	НЕ КонтурЛогистика_Партнеры.ПометкаУдаления
	               |	И КонтурЛогистика_Партнеры.КодПартнераКонтур <> """"";
	
	Результат = Запрос.Выполнить();
	МассивКодовПартнеров = Результат.Выгрузить().ВыгрузитьКолонку("КодПартнераКонтур");	
	
	Возврат МассивКодовПартнеров;

КонецФункции 
