Функция НовоеСостоянийПоУсловиям(Знач ТекущееСостояние, Знач ГлавныйДокумент) Экспорт
	
	Если ТипЗнч(ГлавныйДокумент) <> Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
		Или Не ЗначениеЗаполнено(ГлавныйДокумент) Тогда
		
		Возврат ТекущееСостояние;
	КонецЕсли;
	
	// Подмена статуса *-wait-driver-approve на *-wait-driver-draftApprove
	СостояниеПогрузкаВодитель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("r-wait-driver-approve");
	СостояниеРазгрузкаВодитель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("d-wait-driver-approve");
	СостояниеРазгрузкаВозвратВодитель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("pd-wait-driver-approve");
	
	Если ТекущееСостояние = СостояниеПогрузкаВодитель
		Или ТекущееСостояние = СостояниеРазгрузкаВодитель
		Или ТекущееСостояние = СостояниеРазгрузкаВозвратВодитель Тогда
		
		Если ТекущееСостояние = СостояниеПогрузкаВодитель Тогда
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		Иначе
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
		КонецЕсли;
		
		ФайлТитула = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлТитулаПоГлавномуДокументу(ГлавныйДокумент, ТипДокумента);
		Если Не ЗначениеЗаполнено(ФайлТитула) Тогда
			Возврат ТекущееСостояние;
		КонецЕсли;
		
		РеквизитыФайлаТитула = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(ФайлТитула, "ПодписьВерна, Отпечаток");
		Если РеквизитыФайлаТитула.ПодписьВерна
			И ЗначениеЗаполнено(РеквизитыФайлаТитула.Отпечаток) Тогда
			
			Возврат ТекущееСостояние;
		Иначе
			
			Если ТекущееСостояние = СостояниеПогрузкаВодитель Тогда
				Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("r-wait-driver-draftApprove");
			ИначеЕсли ТекущееСостояние = СостояниеРазгрузкаВодитель Тогда
				Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("d-wait-driver-draftApprove");
			ИначеЕсли ТекущееСостояние = СостояниеРазгрузкаВозвратВодитель Тогда
				Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("pd-wait-driver-draftApprove");
			Иначе
				Возврат ТекущееСостояние;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//
	
	// Не записываем статус "Погрузка, На подписи грузоотправителя", если в одной базе ГО и ПВ
	Если ТекущееСостояние = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеСостоянияДО("r-wait-consignor-sign-delivery") Тогда
		
		Если ГлавныйДокумент.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку И ЗначениеЗаполнено(ГлавныйДокумент.ПогрузкуОсуществляет) Тогда
			ИстинныйГрузоотправитель = ГлавныйДокумент.ПогрузкуОсуществляет;
		Иначе
			ИстинныйГрузоотправитель = ГлавныйДокумент.Грузоотправитель;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИстинныйГрузоотправитель) И ИстинныйГрузоотправитель.Наш Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	//
	
	Возврат ТекущееСостояние;
	
КонецФункции