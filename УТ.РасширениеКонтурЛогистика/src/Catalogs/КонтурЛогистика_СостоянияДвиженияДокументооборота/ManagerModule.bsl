Функция НайтиСостояниеДОПоКоду(КодАнгл, ОтветственнаяСторона = Неопределено) Экспорт 
	
	Состояние = ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_СостоянияДвиженияДокументооборота.Ссылка КАК Ссылка,
	|	КонтурЛогистика_СостоянияДвиженияДокументооборота.ОтветственнаяСторона КАК ОтветственнаяСторона
	|ИЗ
	|	Справочник.КонтурЛогистика_СостоянияДвиженияДокументооборота КАК КонтурЛогистика_СостоянияДвиженияДокументооборота
	|ГДЕ
	|	КонтурЛогистика_СостоянияДвиженияДокументооборота.Код = &КодАнгл
	|	И НЕ КонтурЛогистика_СостоянияДвиженияДокументооборота.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КодАнгл", КодАнгл);
	
	НайденныеСостояния = Запрос.Выполнить().Выгрузить();
	Если ЗначениеЗаполнено(НайденныеСостояния) Тогда
		
		Состояние = НайденныеСостояния[0].Ссылка;
		
		Если Не ОтветственнаяСторона = Неопределено Тогда 
			нСтрока = НайденныеСостояния.Найти(ОтветственнаяСторона, "ОтветственнаяСторона");
			Состояние = ?(нСтрока = Неопределено, НайденныеСостояния[0].Ссылка, нСтрока.Ссылка);
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "Не найдено состояние документооборота по коду: " + КодАнгл;
		
	КонецЕсли;	
	
	Возврат Состояние;
	
КонецФункции	

