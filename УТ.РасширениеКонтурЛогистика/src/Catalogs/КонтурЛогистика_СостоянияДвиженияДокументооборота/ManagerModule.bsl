Функция ТребуемоеДействиеУчастникаПоСостоянию(СостояниеДО, ГОнаш, ПВНаш, ГПНаш) Экспорт
	
	КодСостояния = СостояниеДО.Код;
	ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
	
	// ТРН
	Если КодСостояния = "new" Тогда
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен;
		
	ИначеЕсли КодСостояния = "wait-mintrans-api"
		Или КодСостояния = "r-wait-consignor-sign-delivery"
		Или КодСостояния = "r-consignor-signed"
		Или КодСостояния = "d-wait-consignee-sign-delivery"
		Или КодСостояния = "r-carrier-signed"
		Или КодСостояния = "d-consingee-singed"
		Или КодСостояния = "d-carrier-signed"
		Или КодСостояния = "pd-carrier-signed"
		Или КодСостояния = "pd-consingee-singed"
		Или КодСостояния = "c-carrier-signed"
		Или КодСостояния = "c-consignor-sign" Тогда
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен;
		
	ИначеЕсли КодСостояния = "r-wait-storekeeper"
		Или КодСостояния = "r-wait-consignor-sign"
		Или КодСостояния = "c-wait-consignor-sign" Тогда
		
		Если ГОнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "r-wait-driver-approve"
		Или КодСостояния = "r-wait-driver-draftApprove"
		Или КодСостояния = "d-wait-driver-approve"
		Или КодСостояния = "r-wait-driver-draftApprove"
		Или КодСостояния = "pd-wait-driver-approve"
		Или КодСостояния = "pd-wait-driver-draftApprove" Тогда
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		
	ИначеЕсли КодСостояния = "r-wait-carrier-sign"
		Или КодСостояния = "d-wait-carrier-sign"
		Или КодСостояния = "pd-wait-carrier-sign"
		Или КодСостояния = "pd-wait-carrier-readdress-sign" Тогда
		
		Если ПВНаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "on-the-way" Тогда
		
		Если ГПНаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ДождатьсяПрибытия;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "d-wait-storekeeper"
		Или КодСостояния = "d-wait-consignee-sign"
		или КодСостояния = "pd-wait-consignee-sign" Тогда
		
		Если ГПНаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "pd-on-the-way"
		Или КодСостояния = "pd-wait-storekeeper" Тогда
		
		Если ГОнаш Или ГПНаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
		Иначе
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "completed"
		Или КодСостояния = "c-completed" Тогда
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		
	ИначеЕсли КодСостояния = "revoked"
		Или КодСостояния = "r-rejected" Тогда
		
		Если ГОнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Переотправить;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "d-rejected" Тогда
		
		Если ГОнаш Или ПВНаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ЗапроситьОбъяснение;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "c-rejected" Тогда
		Если ГОнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Переотправить;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
		
	// Заказ (заявка)	
	ИначеЕсли КодСостояния = "zz-wait-carrier" Тогда
		Если ПВнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "zz-сheckAnswer" Тогда
		Если ГОнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "zz-wait-enterBasedOnCarrier" Тогда
		Если ПВнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВвестиНаОсновании;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника;
		КонецЕсли;

	ИначеЕсли КодСостояния = "zz-wait-enterBasedOnConsignor" Тогда
		Если ГОнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВвестиНаОсновании;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "zz-enterBasedOnConsignorAfter"
		Или КодСостояния = "zz-enterBasedOnCarrierAfter" Тогда
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		
	ИначеЕсли КодСостояния = "zz-rejected" Тогда
		Если ГОнаш Тогда 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Переотправить;
		Иначе 
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли КодСостояния = "zz-rejectedConsignor"
		Или КодСостояния = "zz-completed" 
		Или КодСостояния = "zz-createNewZZ" Тогда
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		
	КонецЕсли;

	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ЗаполнитьЗначениямиПоУмолчанию(ОбновитьОписанияИНаименования = Ложь) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	ТаблицаПредопределенных = ПолучитьТаблицуПредопределенных();
	
	Если ЗначениеЗаполнено(ТаблицаПредопределенных) Тогда 
	
		Для Каждого СтрокаПредопределенного Из ТаблицаПредопределенных Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаПредопределенного.Ссылка) ИЛИ ОбновитьОписанияИНаименования = Истина Тогда
				
				Если ЗначениеЗаполнено(СтрокаПредопределенного.Ссылка) Тогда 
					СостояниеОбъект = СтрокаПредопределенного.Ссылка.ПолучитьОбъект();
					Если Не СостояниеОбъект.ЭтоГруппа Тогда
						СостояниеОбъект.Родитель = НайтиРодителя(СтрокаПредопределенного.Родитель);
					КонецЕсли;
				Иначе
					Если ЭтоГруппа(СтрокаПредопределенного) Тогда
						СостояниеОбъект = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.СоздатьГруппу();
					Иначе
						СостояниеОбъект = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.СоздатьЭлемент();
						СостояниеОбъект.Родитель = НайтиРодителя(СтрокаПредопределенного.Родитель);
					КонецЕсли;
				КонецЕсли;
				
				Если СостояниеОбъект.ЭтоГруппа Тогда
					ЗаполнитьЗначенияСвойств(СостояниеОбъект, СтрокаПредопределенного, "Код, Наименование");
				Иначе
					ЗаполнитьЗначенияСвойств(СостояниеОбъект, СтрокаПредопределенного, "Код, Наименование, Описание, НаименованиеСостоянияАнгл, ТребуемоеДействиеТ1,  ТребуемоеДействиеТ2,  ТребуемоеДействиеТ3,  ТребуемоеДействиеТ4, ТребуемоеДействиеТ5, ТребуемоеДействиеТ6, Картинка, ОтветственнаяСторона, НомерВыполненногоТитула, Комментарий");
				КонецЕсли;
				
				// проставим стороны
				Если СтрокаПредопределенного.ОтветственнаяСторона = "ГО" Тогда 
					СостояниеОбъект.ОтветственнаяСторона = Перечисления.КонтурЛогистика_СтороныСоставители.ГО;
				ИначеЕсли СтрокаПредопределенного.ОтветственнаяСторона = "ГП" Тогда 
					СостояниеОбъект.ОтветственнаяСторона = Перечисления.КонтурЛогистика_СтороныСоставители.ГП; 
				ИначеЕсли СтрокаПредопределенного.ОтветственнаяСторона = "ПВ" Тогда 
					СостояниеОбъект.ОтветственнаяСторона = Перечисления.КонтурЛогистика_СтороныСоставители.ПВ; 
				КонецЕсли;
								
				СостояниеОбъект.Записать();
				
				СтрокаПредопределенного.Ссылка = СостояниеОбъект.Ссылка;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Результат.Успешно = Истина;
		
	Иначе
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Предопределенные настройки состояний движения документооборота не найдены.";
		
	КонецЕсли;	
		
	Возврат Результат;
	
КонецФункции

Функция ЭтоГруппа(СтрокаПредопределенного)
	
	Если СтрокаПредопределенного.ТребуемоеДействиеТ1.Пустая()
		И СтрокаПредопределенного.ТребуемоеДействиеТ2.Пустая()
		И СтрокаПредопределенного.ТребуемоеДействиеТ3.Пустая()
		И СтрокаПредопределенного.ТребуемоеДействиеТ4.Пустая()
		И СтрокаПредопределенного.ТребуемоеДействиеТ5.Пустая()
		И СтрокаПредопределенного.ТребуемоеДействиеТ6.Пустая()
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьТаблицуПредопределенных() Экспорт
	
	ТаблицаПредопределенных = Новый ТаблицаЗначений;
	ТаблицаПредопределенных.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,
		Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	ТаблицаПредопределенных.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",,
		Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));
	ТаблицаПредопределенных.Колонки.Добавить("НаименованиеСостоянияАнгл", Новый ОписаниеТипов("Строка",,
		Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	ТаблицаПредопределенных.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка",,
		Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаПредопределенных.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_СостоянияДвиженияДокументооборота"));
	ТаблицаПредопределенных.Колонки.Добавить("ТребуемоеДействиеТ1", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТребуемыеДействия"));
	ТаблицаПредопределенных.Колонки.Добавить("ТребуемоеДействиеТ2", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТребуемыеДействия"));
	ТаблицаПредопределенных.Колонки.Добавить("ТребуемоеДействиеТ3", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТребуемыеДействия"));
	ТаблицаПредопределенных.Колонки.Добавить("ТребуемоеДействиеТ4", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТребуемыеДействия"));
	ТаблицаПредопределенных.Колонки.Добавить("ТребуемоеДействиеТ5", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТребуемыеДействия"));
	ТаблицаПредопределенных.Колонки.Добавить("ТребуемоеДействиеТ6", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТребуемыеДействия"));
	ТаблицаПредопределенных.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Число",
														 Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаПредопределенных.Колонки.Добавить("ОтветственнаяСторона", Новый ОписаниеТипов("Строка"));
	ТаблицаПредопределенных.Колонки.Добавить("НомерВыполненногоТитула", Новый ОписаниеТипов("Число",
														 Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаПредопределенных.Колонки.Добавить("Родитель", Новый ОписаниеТипов("Строка",,
		Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	ТаблицаПредопределенных.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка",,
		Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	
	Макет = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПолучитьМакет("ПредопределенныеЭлементы");
	Область = Макет.ПолучитьОбласть("Данные");
	
	Для Сч = 1 По Область.ВысотаТаблицы Цикл
		
		НоваяСтрокаТаблицы = ТаблицаПредопределенных.Добавить();
		
		НоваяСтрокаТаблицы.Наименование				 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 1);
		НоваяСтрокаТаблицы.Код						 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 2);
		НоваяСтрокаТаблицы.НаименованиеСостоянияАнгл = ПолучитьТекстЯчейкиОбласти(Область, Сч, 3);
		НоваяСтрокаТаблицы.Описание					 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 4);
		НоваяСтрокаТаблицы.Картинка					 = Число(ПолучитьТекстЯчейкиОбласти(Область, Сч, 11));
		НоваяСтрокаТаблицы.ОтветственнаяСторона		 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 12);
		НоваяСтрокаТаблицы.НомерВыполненногоТитула	 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 13);
		НоваяСтрокаТаблицы.Родитель					 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 14);
		НоваяСтрокаТаблицы.Комментарий				 = ПолучитьТекстЯчейкиОбласти(Область, Сч, 15);
		
		НайденнаяСсылка = НайтиПоКоду(НоваяСтрокаТаблицы.Код);
		
		Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда 
		
			НоваяСтрокаТаблицы.Ссылка = НайденнаяСсылка;
			
		КонецЕсли;
				
		НоваяСтрокаТаблицы.ТребуемоеДействиеТ1 = ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, 5);
		НоваяСтрокаТаблицы.ТребуемоеДействиеТ2 = ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, 6);
		НоваяСтрокаТаблицы.ТребуемоеДействиеТ3 = ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, 7);
		НоваяСтрокаТаблицы.ТребуемоеДействиеТ4 = ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, 8);
		НоваяСтрокаТаблицы.ТребуемоеДействиеТ5 = ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, 9);
		НоваяСтрокаТаблицы.ТребуемоеДействиеТ6 = ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, 10);
	
	КонецЦикла;
	
	Возврат ТаблицаПредопределенных;
	
КонецФункции

Функция НайтиРодителя(Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СостоянияДвиженияДокументооборота.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_СостоянияДвиженияДокументооборота КАК КонтурЛогистика_СостоянияДвиженияДокументооборота
		|ГДЕ
		|	КонтурЛогистика_СостоянияДвиженияДокументооборота.ЭтоГруппа = &ЭтоГруппа
		|	И КонтурЛогистика_СостоянияДвиженияДокументооборота.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("ЭтоГруппа", Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка();
	
КонецФункции

Функция ТребуемоеДействиеПоТекстуЯчейкиОбласти(Область, Сч, НомерКолонки)
	
	ТекстЯчейки = ПолучитьТекстЯчейкиОбласти(Область, Сч, НомерКолонки);
	
	Попытка
		ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия." + ТекстЯчейки);
	Исключение
		ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПустаяСсылка")
	КонецПопытки;
	
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ПолучитьТекстЯчейкиОбласти(Область, Строка, Колонка)
	
	Возврат Строка(Область.ПолучитьОбласть("R" + Формат(Строка, "ЧГ=0") + "C" + Формат(Колонка, "ЧГ=0")).ТекущаяОбласть.Текст);
	
КонецФункции

Функция Состояние1СПоКодуСостояниюСервиса(КодСостояния) Экспорт
	
	Выборка = ПолучитьВыборку1ЭлементаПоКодуСтатуса(КодСостояния);
	
	Если Выборка.Следующий() Тогда 
		
		Возврат Выборка.Ссылка;
		
	Иначе
		
		ЗаполнитьЗначениямиПоУмолчанию();
		
		Выборка = ПолучитьВыборку1ЭлементаПоКодуСтатуса(КодСостояния);
		Если Выборка.Следующий() Тогда 
			
			Возврат Выборка.Ссылка;
			
		Иначе
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Непредполагаемое наименование кода логистического статуса: " + КодСостояния);
			Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка();
			
		КонецЕсли;
		
	КонецЕсли;
	
