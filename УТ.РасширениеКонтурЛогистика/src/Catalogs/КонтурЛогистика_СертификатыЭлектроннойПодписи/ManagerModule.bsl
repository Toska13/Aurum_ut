Функция СформироватьНаименованиеСертификата(Сертификат) Экспорт

	ФИО = Сертификат.Фамилия + " " + Сертификат.Имя + " " + Сертификат.Отчество;
	
	Если Сертификат.ТипВладельцаСертификата = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Или ЗначениеЗаполнено(Сертификат.ИННЮЛ) Тогда
		ОформленНа = Сертификат.Организация;
	ИначеЕсли Сертификат.ТипВладельцаСертификата = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Или ЗначениеЗаполнено(Сертификат.ОГРНИП) Тогда
		ОформленНа = "ИП";
	Иначе
		ОформленНа = "Физическое лицо";
	КонецЕсли;
	
	Возврат ФИО + ", " 
			+ Формат(Сертификат.СрокДействия, "ДФ='""по ""dd.MM.yyyy'")  
			+ ?(ЗначениеЗаполнено(ОформленНа), ", " + ОформленНа, "");
				
КонецФункции

Функция ПолучитьСертификатПоОтпечатку(ОтпечатокСертификата, СертификатНаСервере) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СертификатыЭлектроннойПодписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи КАК КонтурЛогистика_СертификатыЭлектроннойПодписи
		|ГДЕ
		|	КонтурЛогистика_СертификатыЭлектроннойПодписи.ОтпечатокСертификата = &ОтпечатокСертификата
		|	И КонтурЛогистика_СертификатыЭлектроннойПодписи.СертификатНаСервере = &СертификатНаСервере";
	
	Запрос.УстановитьПараметр("ОтпечатокСертификата", ОтпечатокСертификата);
	Запрос.УстановитьПараметр("СертификатНаСервере", СертификатНаСервере);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПустаяСсылка();	
	КонецЕсли;
	
КонецФункции

Функция ТипВладельцаСертификата(Сертификат) Экспорт
	
	Если ЗначениеЗаполнено(Сертификат.ТипВладельцаСертификата) Тогда
		Возврат Сертификат.ТипВладельцаСертификата;		
	Иначе
		
		Если ЗначениеЗаполнено(Сертификат.ИННЮЛ) Тогда
			Возврат Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
		ИначеЕсли ЗначениеЗаполнено(Сертификат.ОГРНИП) Тогда
			Возврат Перечисления.КонтурЛогистика_ТипыЛиц.ИП;
		Иначе
			Возврат Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьПроверкуСертификатаЧерезДиадок(boxId, ДвоичныеДанныеСертификата) Экспорт
	
	Результат = Новый Структура;
	
	Сертификат = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
	ИздательИНН = КонтурЛогистика_КриптографияКлиентСервер.ПолучитьИННИздателя(Сертификат);
	ИздательОГРН = КонтурЛогистика_КриптографияКлиентСервер.ПолучитьОГРНИздателя(Сертификат);
	Если Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ЭтоТестовыйСертификат(Сертификат.Издатель.CN, ИздательИНН, ИздательОГРН) Тогда			
		ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.Тестовая;
	Иначе
		ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.ПустаяСсылка();
	КонецЕсли;
	
	Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_VerifyCertificate(boxId, ДвоичныеДанныеСертификата);
		
	Если ЗначениеЗаполнено(Ответ) И Ответ.Свойство("IsValid") И НЕ ЗначениеЗаполнено(ТипПодписи) Тогда
		ТипПодписи = ?(Ответ.IsValid, Перечисления.КонтурЛогистика_ТипыПодписи.УКЭП, Перечисления.КонтурЛогистика_ТипыПодписи.УНЭП);		
	Иначе  
		Если Не ЗначениеЗаполнено(ТипПодписи) Тогда
			ТипПодписи = Перечисления.КонтурЛогистика_ТипыПодписи.ПустаяСсылка();					
		КонецЕсли;
	КонецЕсли;	
	Результат.Вставить("ТипПодписи", ТипПодписи);
	
	ТипВладельцаСертификата = Перечисления.КонтурЛогистика_ТипыЛиц.ПустаяСсылка();
	Если ЗначениеЗаполнено(Ответ) И Ответ.Свойство("SubjectType") Тогда
		
		Если Ответ.SubjectType = "PhysicalPerson" Тогда
			ТипВладельцаСертификата = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо;
		ИначеЕсли Ответ.SubjectType = "IndividualEntity" Тогда
			ТипВладельцаСертификата = Перечисления.КонтурЛогистика_ТипыЛиц.ИП;
		ИначеЕсли Ответ.SubjectType = "PhLegalEntityysicalPerson" Тогда
			ТипВладельцаСертификата = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
		КонецЕсли;
		Результат.Вставить("ТипВладельцаСертификата", ТипВладельцаСертификата);
		
	КонецЕсли;

	ДатаПроверкиТипаПодписи = ТекущаяДатаСеанса();
	Результат.Вставить("ДатаПроверкиТипаПодписи", ДатаПроверкиТипаПодписи);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоТестовыйСертификат(Издатель, ИНН = "", ОГРН = "") Экспорт
	
	Если (ИНН = "000000000000" Или ИНН = "000000000") И ОГРН = "0000000000000" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Тестовые = Новый Массив;
	Тестовые.Добавить("easycert");
	
	Для каждого Тест Из Тестовые Цикл
		Если Найти(НРег(Издатель), Тест) > 0 Тогда
			Возврат Истина;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#Область ПереходНаЭПЛ502

Процедура ЗаполнитьДолжностьИзДанныхСертификата() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СертификатыЭлектроннойПодписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи КАК КонтурЛогистика_СертификатыЭлектроннойПодписи
		|ГДЕ
		|	НЕ КонтурЛогистика_СертификатыЭлектроннойПодписи.ПометкаУдаления
		|	И КонтурЛогистика_СертификатыЭлектроннойПодписи.СрокДействия >= &ТекущаяДата
		|	И КонтурЛогистика_СертификатыЭлектроннойПодписи.Должность = """"";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеСертификата = ВыборкаДетальныеЗаписи.Ссылка.ДанныеСертификата.Получить();		
		Если ТипЗнч(ДанныеСертификата) = Тип("ДвоичныеДанные") Тогда
			
			СертификатКриптографии = Новый СертификатКриптографии(ДанныеСертификата);
			
			Должность = "";
			Если СертификатКриптографии.Субъект.Свойство("T") Тогда
				Должность = СертификатКриптографии.Субъект.T;
			ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID2_5_4_12") Тогда
				Должность = СертификатКриптографии.Субъект.OID2_5_4_12;	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Должность) Тогда
				СертификатОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				СертификатОбъект.Должность = Должность;
				СертификатОбъект.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти