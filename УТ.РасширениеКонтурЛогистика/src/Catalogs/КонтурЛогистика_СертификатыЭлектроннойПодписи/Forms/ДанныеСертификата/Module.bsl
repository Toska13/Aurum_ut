
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДанныеСертификата = Неопределено;
	
	Если Параметры.Свойство("СертификатСсылка") И ЗначениеЗаполнено(Параметры.СертификатСсылка) И ЗначениеЗаполнено(Параметры.СертификатСсылка.ДанныеСертификата.Получить()) Тогда
		ДанныеСертификата = Параметры.СертификатСсылка.ДанныеСертификата.Получить();
	ИначеЕсли Параметры.Свойство("АдресСертификата") Тогда		
		ДанныеСертификата = ПолучитьИзВременногоХранилища(Параметры.АдресСертификата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСертификата) Тогда
		
		Сертификат = Новый СертификатКриптографии(ДанныеСертификата); 	
		
		КомуВыдан = Параметры.КомуВыдан;
		КемВыдан = Параметры.КемВыдан;
		Истекает = Параметры.Истекает;
				
		ЗаполнитьСубъект(Сертификат.Субъект);
		ЗаполнитьИздатель(Сертификат.Издатель);
		ЗаполнитьВнутреннееСодержание(Сертификат);
			
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСубъект(Субъект)
	
	Для каждого Стр Из Субъект Цикл
		
		НоваяСтрока = тзСубьект.Добавить();
		НоваяСтрока.Ключ = Стр.Ключ;
		НоваяСтрока.Значение = Стр.Значение;
		
	КонецЦикла

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИздатель(Издатель)
	
	Для каждого Стр Из Издатель Цикл
		
		НоваяСтрока = тзИздатель.Добавить();
		НоваяСтрока.Ключ = Стр.Ключ;
		НоваяСтрока.Значение = Стр.Значение;
		
	КонецЦикла

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВнутреннееСодержание(Сертификат)
	
	ВнутреннееСодержание = Новый Массив;
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "Версия", "Версия"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "ДатаНачала", "Дата начала"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "ДатаОкончания", "Дата окончания"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "ИспользоватьДляПодписи", "Использовать для подписи"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "ИспользоватьДляШифрования", "Использовать для шифрования"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "ОткрытыйКлюч", "Открытый ключ"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "Отпечаток", "Отпечаток"));
	ВнутреннееСодержание.Добавить(Новый Структура("Ключ, Представление", "СерийныйНомер", "Серийный номер"));
	
	Для каждого Стр Из ВнутреннееСодержание Цикл
		
		Попытка
			НоваяСтрока = тзВнутреннееСодержание.Добавить();
			НоваяСтрока.Ключ = Стр.Представление;
			НоваяСтрока.Значение = Сертификат[Стр.Ключ];
		Исключение
			
		КонецПопытки;
		
	КонецЦикла	
	
КонецПроцедуры