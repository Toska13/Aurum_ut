		|	ПланыВидовХарактеристик.уатПраваИНастройки.ОсновнойВидЗаправки);
		|АЗСпоУмолчанию = уатПраваИНастройки.уатПолучитьПраваИНастройкиПользователя(СтруктураОбъектовНастроек,
		|	ПланыВидовХарактеристик.уатПраваИНастройки.ОсновнаяАЗС);
		|
		|ДокументОбъект.ВидДвиженияГСМ = ВидДвиженияГСМпоУмолчанию;
		|Если (АЗСпоУмолчанию.ЭтоАЗССклад И (ВидДвиженияГСМпоУмолчанию = Перечисления.уатВидыДвиженияГСМ.ЗаправкаСклад
		|		Или ВидДвиженияГСМпоУмолчанию = Перечисления.уатВидыДвиженияГСМ.ЗаправкаПластиковаяКартаСклад
		|		Или ВидДвиженияГСМпоУмолчанию = ПредопределенноеЗначение(""Перечисление.уатВидыДвиженияГСМ.ЗаправкаТалоны"")))
		|	Или (Не АЗСпоУмолчанию.ЭтоАЗССклад И (ВидДвиженияГСМпоУмолчанию = Перечисления.уатВидыДвиженияГСМ.ЗаправкаПоставщик
		|		Или ВидДвиженияГСМпоУмолчанию = Перечисления.уатВидыДвиженияГСМ.ЗаправкаПластиковаяКарта
		|		Или ВидДвиженияГСМпоУмолчанию = Перечисления.уатВидыДвиженияГСМ.ЗаправкаНаличные)) Тогда
		|	
		|	ДокументОбъект.АЗС = АЗСпоУмолчанию;
		|КонецЕсли;
		|	
		|Попытка
		|	ДокументОбъект.Записать();
		|Исключение
		|	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(""Не удалось добавить заправку ГСМ: "" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		|КонецПопытки;
		|
		|РезультатВычисления = Истина;";
	
	// ТЧ ЗаполнениеДокУчСистТЧ
	НоваяСтрока = ОбъектНКД.ЗаполнениеДокУчСистТЧ.Добавить();
	НоваяСтрока.Реквизит = "Дата";
	НоваяСтрока.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод;
	НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = "Основание.Дата";
	
	НоваяСтрока = ОбъектНКД.ЗаполнениеДокУчСистТЧ.Добавить();
	НоваяСтрока.Реквизит = "Количество";
	НоваяСтрока.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод;
	НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = "Основание.Количество";
	
	// ТЧ ПеременныеДокУчСист
	НоваяСтрока = ОбъектНКД.ПеременныеДокУчСист.Добавить();
	НоваяСтрока.Имя = "ДокументОснования";
	НоваяСтрока.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод;
	НоваяСтрока.ВыражениеВычисленияСтрокаНеогр =
		"Запрос = Новый Запрос;
		|Запрос.УстановитьПараметр(""kl_id"", Основание.Разрез1);
		|
		|Запрос.Текст =
		|""ВЫБРАТЬ
		||	КонтурЛогистика_ПЛ_Титул1.ДокументОснование КАК ДокументОснование
		||ИЗ
		||	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
		||ГДЕ
		||	КонтурЛогистика_ПЛ_Титул1.kl_id = &kl_id"";
		|
		|Выборка = Запрос.Выполнить().Выбрать();
		|Если Выборка.Следующий() Тогда
		|	РезультатВычисления = Выборка.ДокументОснование;
		|Иначе
		|	РезультатВычисления = Неопределено;
		|КонецЕсли;";
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьЗаполнениеДокУчСистПоДокументу1C(ОбъектНКД)
	
	СтрокаТипАлгоритмаЗаполнить = ОбъектНКД.ЗаполнениеДокУчСист.Добавить();
	СтрокаТипАлгоритмаЗаполнить.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
	
	МетаданныеДок = Метаданные.Документы.Найти(ОбъектНКД.ИмяРесурса);
	
	Если МетаданныеДок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из МетаданныеДок.Реквизиты Цикл
		СтрокаЗапись = ОбъектНКД.ЗаполнениеДокУчСист.Добавить();
		СтрокаЗапись.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
		СтрокаЗапись.Реквизит = ТекущаяСтрока.Имя;
		СтрокаЗапись.РеквизитТипЗначения = ТекущаяСтрока.Тип;
		СтрокаЗапись.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПравилаКонвертации(ОбъектНКД) Экспорт
	
	ПараметрыПолей = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ПараметрыПолейПоТипуДанных(ОбъектНКД.ОтборТипДанных);
	
	Для Каждого ТекущаяСтрока Из Метаданные.РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.Измерения Цикл
		НоваяСтрока = ДобавитьПравилоКонвертации(ТекущаяСтрока, ОбъектНКД, ПараметрыПолей);
		НоваяСтрока.Картинка = 2;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Метаданные.РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.Ресурсы Цикл
		НоваяСтрока = ДобавитьПравилоКонвертации(ТекущаяСтрока, ОбъектНКД, ПараметрыПолей);
		НоваяСтрока.Картинка = 2;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Метаданные.РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.Реквизиты Цикл
		
		Если ТекущаяСтрока.Имя = "ДокументОснование"
			Или ТекущаяСтрока.Имя = "СинхронизацияССервисом"
			Или ТекущаяСтрока.Имя = "СинхронизацияСОбъектом1С"
			Или ТекущаяСтрока.Имя = "ТекстОшибки" Тогда
			
			Возврат;
		КонецЕсли;
		
		НоваяСтрока = ДобавитьПравилоКонвертации(ТекущаяСтрока, ОбъектНКД, ПараметрыПолей);
		НоваяСтрока.Картинка = 3;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьПравилоКонвертации(ТекущаяСтрока, ОбъектНКД, ПараметрыПолей)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("РеквизитРегистраСведений", ТекущаяСтрока.Имя);
	
	НайденныеСтроки = ОбъектНКД.ПравилаКонвертации.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		ТекущаяСтрокаКонвертации = ОбъектНКД.ПравилаКонвертации.Добавить();
		ТекущаяСтрокаКонвертации.РеквизитРегистраСведений = ТекущаяСтрока.Имя;
		ТекущаяСтрокаКонвертации.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
		ТекущаяСтрокаКонвертации.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
	Иначе
		ТекущаяСтрокаКонвертации = НайденныеСтроки[0];
	КонецЕсли;
	
	ТекущаяСтрокаКонвертации.РеквизитРегистраСведенийТипЗначения = Строка(ТекущаяСтрока.Тип);
	ТекущаяСтрокаКонвертации.РеквизитРегистраСведенийКомментарий = ТекущаяСтрока.Комментарий;
	
	Если ПараметрыПолей.Свойство(ТекущаяСтрока.Имя) Тогда
		ТекущаяСтрокаКонвертации.РеквизитРегистраСведенийПредставление = ПараметрыПолей[ТекущаяСтрока.Имя].Заголовок;
	Иначе
		ТекущаяСтрокаКонвертации.РеквизитРегистраСведенийПредставление = ТекущаяСтрока.Синоним;
	КонецЕсли;
	
	Возврат ТекущаяСтрокаКонвертации;
	
КонецФункции

#КонецОбласти

#КонецЕсли