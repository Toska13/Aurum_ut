#Область ПрограммныйИнтерфейс

// Есть настройки конвертации РСПо статусу ДО
//
// Параметры:
//  СтатусДО - КонтурЛогистика_СостоянияДвиженияДокументооборота	 - Состояние ДО
// 
// Возвращаемое значение:
//  Булево - есть настройка для обработки по статусу
//
Функция ЕстьНастройкиКонвертацииРСПоСтатусуДО(Знач СтатусДО) Экспорт
	
	НаправленияКонвертаций = Новый Массив;
	НаправленияКонвертаций.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее);
	НаправленияКонвертаций.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтатусДО", СтатусДО);
	Запрос.УстановитьПараметр("НаправленияКонвертаций", НаправленияКонвертаций);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ТриггерСтатусыДО КАК КонтурЛогистика_НастройкиКонвертацииРегистровСведенийТриггерСтатусыДО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиКонвертацииРегистровСведений КАК КонтурЛогистика_НастройкиКонвертацииРегистровСведений
	|		ПО КонтурЛогистика_НастройкиКонвертацииРегистровСведенийТриггерСтатусыДО.Ссылка = КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Ссылка
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НаправлениеКонвертации В(&НаправленияКонвертаций)
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведенийТриггерСтатусыДО.СтатусДО = &СтатусДО";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Настройка для обработки по статусу
//
// Параметры:
//  СтатусДО	 - КонтурЛогистика_СостоянияДвиженияДокументооборота	 - Состояние ДО
//  ИмяРесурса	 - Строка												 - Тип учетного документа строкой
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииРегистровСведений - настройка для обработки по статусу
//
Функция НастройкаДляОбработкиПоСтатусу(Знач СтатусДО, Знач ИмяРесурса) Экспорт
	
	НаправленияКонвертаций = Новый Массив;
	НаправленияКонвертаций.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее);
	НаправленияКонвертаций.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаправленияКонвертаций", НаправленияКонвертаций);
	Запрос.УстановитьПараметр("ИмяРесурса", ИмяРесурса);
	Запрос.УстановитьПараметр("СтатусДО", СтатусДО);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ТриггерСтатусыДО КАК КонтурЛогистика_НастройкиКонвертацииРегистровСведенийТриггерСтатусыДО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиКонвертацииРегистровСведений КАК КонтурЛогистика_НастройкиКонвертацииРегистровСведений
	|		ПО КонтурЛогистика_НастройкиКонвертацииРегистровСведенийТриггерСтатусыДО.Ссылка = КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Ссылка
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НаправлениеКонвертации В(&НаправленияКонвертаций)
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ИмяРесурса = &ИмяРесурса
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведенийТриггерСтатусыДО.СтатусДО = &СтатусДО";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Настройка для конвертации в объект 1С
//
// Параметры:
//  ТипДанных	 - Строка		 - См. РС.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных()
//  Разрез1		 - Составной	 - См. РС.КонтурЛогистика_ПроизвольныеДанные.Разрез1
//  Разрез2		 - Составной	 - См. РС.КонтурЛогистика_ПроизвольныеДанные.Разрез2
//  Разрез3		 - Составной	 - См. РС.КонтурЛогистика_ПроизвольныеДанные.Разрез3
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииРегистровСведений - настройка для конвертации в объект 1С
//
Функция НастройкаДляКонвертацииВОбъект1С(Знач ТипДанных, Знач Разрез1, Знач Разрез2, Знач Разрез3) Экспорт
	
	НаправленияКонвертаций = Новый Массив;
	НаправленияКонвертаций.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее);
	НаправленияКонвертаций.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаправленияКонвертаций", НаправленияКонвертаций);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.УстановитьПараметр("Разрез1", Разрез1);
	Запрос.УстановитьПараметр("Разрез2", Разрез2);
	Запрос.УстановитьПараметр("Разрез3", Разрез3);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииРегистровСведений КАК КонтурЛогистика_НастройкиКонвертацииРегистровСведений
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НаправлениеКонвертации В(&НаправленияКонвертаций)
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборТипДанных = &ТипДанных
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборРазрез1 = """"
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборРазрез1 = &Разрез1
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборРазрез2 = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыПоказанийТоплива.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборРазрез2 = &Разрез2
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборРазрез3 = """"
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ОтборРазрез3 = &Разрез3
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Настройка по триггер уникальное имя программного вызова
//
// Параметры:
//  УникальноеИмя	 - Строка	 - Уникальное имя для поиска
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииРегистровСведений - настройка для обработки
//
Функция НастройкаПоТриггерУникальноеИмяПрограммногоВызова(Знач УникальноеИмя) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТриггерУникальноеИмяПрограммногоВызова", УникальноеИмя);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииРегистровСведений КАК КонтурЛогистика_НастройкиКонвертацииРегистровСведений
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ТриггерУникальноеИмяПрограммногоВызова = &ТриггерУникальноеИмяПрограммногоВызова";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Заполнить автоматически для текущей конфигурации
//
Процедура ЗаполнитьАвтоматическиДляТекущейКонфигурации() Экспорт
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	Если ИмяКонфигурации1С <> "УАТ"
		И ИмяКонфигурации1С <> "ТЛЭ"
		И ИмяКонфигурации1С <> "УАТ_ПРОФ"
		И ИмяКонфигурации1С <> "ERP_УАТ" Тогда
		
		Возврат;
	КонецЕсли;
	
	ТекущаяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НайтиПоНаименованию("ГСМ - На выезде");
	Если Не ЗначениеЗаполнено(ТекущаяНастройка) Тогда
		НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.СоздатьЭлемент();
		ЗаполнитьГСМНаВыезде_УАТ(НоваяНастройка);
		НоваяНастройка.Записать();
	КонецЕсли;
	
	ТекущаяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НайтиПоНаименованию("ГСМ - На заезде");
	Если Не ЗначениеЗаполнено(ТекущаяНастройка) Тогда
		НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.СоздатьЭлемент();
		ЗаполнитьГСМЗаезд_УАТ(НоваяНастройка);
		НоваяНастройка.Записать();
	КонецЕсли;
	
	ТекущаяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.НайтиПоНаименованию("ГСМ - Заправка");
	Если Не ЗначениеЗаполнено(ТекущаяНастройка) Тогда
		НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.СоздатьЭлемент();
		ЗаполнитьГСМЗаправки_УАТ(НоваяНастройка);
		НоваяНастройка.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область НКРС_УАТ

Процедура ЗаполнитьГСМНаВыезде_УАТ(ОбъектНКД)
	
	// Реквизиты
	ОбъектНКД.Наименование = "ГСМ - На выезде";
	ОбъектНКД.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее;
	ОбъектНКД.ИмяРесурса = "уатПутевойЛист";
	ОбъектНКД.ОтборТипДанных = "ГорючеСмазочныеМатериалы";
	ОбъектНКД.ОтборРазрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде;
	ОбъектНКД.ИмяТабличнойЧастиЗаполнения = "РасходГСМ";
	ОбъектНКД.ПоискУчетногоДокумента =
		"Запрос = Новый Запрос;
		|Запрос.УстановитьПараметр(""kl_id"", ДанныеЗаписи.Разрез1);
		|
		|Запрос.Текст =
		|""ВЫБРАТЬ
		||	КонтурЛогистика_ПЛ_Титул1.ДокументОснование КАК ДокументОснование
		||ИЗ
		||	Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
		||ГДЕ
		||	КонтурЛогистика_ПЛ_Титул1.kl_id = &kl_id"";
		|
		|Выборка = Запрос.Выполнить().Выбрать();
		|Если Выборка.Следующий() Тогда
		|	РезультатВычисления = Выборка.ДокументОснование;
		|Иначе
		|	РезультатВычисления = Неопределено;
		|КонецЕсли;";
	ОбъектНКД.ПоискСтрокиТабличнойЧасти =
		"Для Каждого ТекСтрока Из ДокументОбъект.РасходГСМ Цикл
		|	Если ДокументОбъект.ТранспортноеСредство = ТекСтрока.ТС Тогда
		|		РезультатВычисления = ТекСтрока;
		|		Прервать;
		|	КонецЕсли;
		|КонецЦикла;";
	ЗаполнитьЗаполнениеДокУчСистПоДокументу1C(ОбъектНКД);
	
	// ТЧ ТриггерСтатусыДО
	НоваяСтрока = ОбъектНКД.ТриггерСтатусыДО.Добавить();
	НоваяСтрока.СтатусДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-checkupBefore");
	НоваяСтрока = ОбъектНКД.ТриггерСтатусыДО.Добавить();
	НоваяСтрока.СтатусДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-techOrChekupBefore");
	
	// ТЧ ПравилаКонвертации
	ЗаполнитьПравилаКонвертации(ОбъектНКД);
	Для Каждого ТекущаяСтрока Из ОбъектНКД.ПравилаКонвертации Цикл
		
		Если ТекущаяСтрока.РеквизитРегистраСведений = "ОрганизацияДиадок" Тогда
			
			ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования;
			ТекущаяСтрока.ВыражениеВычисления = "Организация";
			ТекущаяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок;
			
		ИначеЕсли ТекущаяСтрока.РеквизитРегистраСведений = "ТипДанных" Тогда
			
			ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение;
			ТекущаяСтрока.ВыражениеВычисленияСтрокаНеогр = "РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ";
			
		ИначеЕсли ТекущаяСтрока.РеквизитРегистраСведений = "Разрез1" Тогда
			
			ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула;
			ТекущаяСтрока.ВыражениеВычисления = "kl_id";
			ТекущаяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
			
		ИначеЕсли ТекущаяСтрока.РеквизитРегистраСведений = "Разрез2" Тогда
			
			ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение;
			ТекущаяСтрока.ВыражениеВычисления = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде;
			
		ИначеЕсли ТекущаяСтрока.РеквизитРегистраСведений = "Количество" Тогда
			
			ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение;
			ТекущаяСтрока.ВыражениеВычисленияСтрокаНеогр =
				"Для Каждого ТекСтрока Из Основание.РасходГСМ Цикл
				|	Если Основание.ТранспортноеСредство = ТекСтрока.ТС Тогда
				|		РезультатВычисления = ТекСтрока.ОстатокПриВыезде;
				|		Прервать;
				|	КонецЕсли;
				|КонецЦикла;";
			
		ИначеЕсли ТекущаяСтрока.РеквизитРегистраСведений = "Дата" Тогда
			
