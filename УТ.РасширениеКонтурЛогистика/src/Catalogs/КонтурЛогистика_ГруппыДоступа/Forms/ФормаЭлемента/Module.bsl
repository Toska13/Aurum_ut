КонецПроцедуры

&НаКлиенте
Процедура ДоступныВсеОрганизацииПриИзменении(Элемент)
	
	ОбновитьВидимотьДоступность();
	
	ОбновитьЗаголовкиСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеОрганизацииПриИзменении(Элемент)
	
	ОбновитьЗаголовкиСтраниц();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимотьДоступность()
	
	Элементы.Пользователи.Доступность = Не Объект.ВсеПользователи;
	
	Элементы.ДоступныеОрганизации.Доступность = Не Объект.ВсеОрганизации;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФильтрПомеченных()
	
	Если ФильтрПомеченных = "ТолькоВыбранные" Тогда
		Элементы.ДоступКМеханизмам.ОтборСтрок = Новый ФиксированнаяСтруктура("ТолькоВыбранные", Истина);
		Элементы.ДоступКСправочникам.ОтборСтрок = Новый ФиксированнаяСтруктура("ТолькоВыбранные", Истина);
		Элементы.ДоступКТитулам.ОтборСтрок = Новый ФиксированнаяСтруктура("ТолькоВыбранные", Истина);
	Иначе
		Элементы.ДоступКМеханизмам.ОтборСтрок = Неопределено;
		Элементы.ДоступКСправочникам.ОтборСтрок = Неопределено;
		Элементы.ДоступКТитулам.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПризнакТолькоВыбранные()
	
	Для Каждого ТекущаяСтрока Из Объект.ДоступКМеханизмам Цикл
		ТекущаяСтрока.ТолькоВыбранные = (ТекущаяСтрока.ТолькоПросмотр Или ТекущаяСтрока.СозданиеРедактирование);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ДоступКСправочникам Цикл
		ТекущаяСтрока.ТолькоВыбранные = (ТекущаяСтрока.ТолькоПросмотр Или ТекущаяСтрока.СозданиеРедактирование);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ДоступКТитулам Цикл
		ТекущаяСтрока.ТолькоВыбранные = (ТекущаяСтрока.ТолькоПросмотр Или ТекущаяСтрока.СозданиеРедактирование);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредопределеннымиДанными()
	
	// Справочиники
	Перечень = Справочники.КонтурЛогистика_ГруппыДоступа.ПереченьДоступныхСправочников();
	Для Каждого ТекущаяСтрока Из Перечень Цикл
		ДобавитьНовуюСтроку("ДоступКСправочникам", "ИмяСправочника", ТекущаяСтрока);
	КонецЦикла;
	Объект.ДоступКСправочникам.Сортировать("ИмяСправочника");
	
	// Титулы
	ВсеТитулы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ВсеТипыЛогистическихДокументов();
	Для Каждого ТекущийТитул Из ВсеТитулы Цикл
		ДобавитьНовуюСтроку("ДоступКТитулам", "ТипЛогистика", ТекущийТитул);
	КонецЦикла;
	Объект.ДоступКТитулам.Сортировать("ТипЛогистика");
	
	// Механизмы
	ВсеВидыМеханизмов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ВсеВидыМеханизмов();
	Для Каждого ТекущийВид Из ВсеВидыМеханизмов Цикл
		ДобавитьНовуюСтроку("ДоступКМеханизмам", "ВидМеханизма", ТекущийВид);
	КонецЦикла;
	Объект.ДоступКМеханизмам.Сортировать("ВидМеханизма");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНовуюСтроку(ИмяТабличнойЧасти, ИмяКолонки, ИскомоеЗначение)
	
	Для Каждого ТекущаяСтрока Из Объект[ИмяТабличнойЧасти] Цикл
		Если ТекущаяСтрока[ИмяКолонки] = ИскомоеЗначение Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрока = Объект[ИмяТабличнойЧасти].Добавить();
	НоваяСтрока[ИмяКолонки] = ИскомоеЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТолькоПросмотрСозданиеРедактированиеПоСтроке(ТекущиеДанные, ИмяЭлемента)
	
	Если ТекущиеДанные.ТолькоПросмотр И ТекущиеДанные.СозданиеРедактирование Тогда
		
		Если Найти(ИмяЭлемента, "ТолькоПросмотр") = 0 Тогда
			ТекущиеДанные.ТолькоПросмотр = Ложь;
		Иначе
			ТекущиеДанные.СозданиеРедактирование = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущиеДанные.ТолькоВыбранные = (ТекущиеДанные.ТолькоПросмотр Или ТекущиеДанные.СозданиеРедактирование);
	
	УстановитьФильтрПомеченных();
	
	ОбновитьЗаголовкиСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовкиСтраниц()
	
	// ДоступКСправочникам
	КоличествоВыделенных = 0;
	Для Каждого ТекущаяСтрока Из Объект.ДоступКСправочникам Цикл
		Если Не ТекущаяСтрока.ТолькоВыбранные Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВыделенных = КоличествоВыделенных + 1;
	КонецЦикла;
	
	Элементы.ГруппаДоступКСправочникам.Заголовок = "Справочники ("
		+ Формат(КоличествоВыделенных, "ЧН=0; ЧГ=0") + " из " + Формат(Объект.ДоступКСправочникам.Количество(), "ЧН=0; ЧГ=0") + ")";
	
	// ГруппаДоступКТитулам
	КоличествоВыделенных = 0;
	Для Каждого ТекущаяСтрока Из Объект.ДоступКТитулам Цикл
		Если Не ТекущаяСтрока.ТолькоВыбранные Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВыделенных = КоличествоВыделенных + 1;
	КонецЦикла;
	
	Элементы.ГруппаДоступКТитулам.Заголовок = "Титулы ("
		+ Формат(КоличествоВыделенных, "ЧН=0; ЧГ=0") + " из " + Формат(Объект.ДоступКТитулам.Количество(), "ЧН=0; ЧГ=0") + ")";
	
	// ДоступКСправочникам
	КоличествоВыделенных = 0;
	Для Каждого ТекущаяСтрока Из Объект.ДоступКМеханизмам Цикл
		Если Не ТекущаяСтрока.ТолькоВыбранные Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВыделенных = КоличествоВыделенных + 1;
	КонецЦикла;
	
	Элементы.ГруппаДоступКМеханизмам.Заголовок = "Механизмы ("
		+ Формат(КоличествоВыделенных, "ЧН=0; ЧГ=0") + " из " + Формат(Объект.ДоступКМеханизмам.Количество(), "ЧН=0; ЧГ=0") + ")";
	
	// ДоступныеОрганизации
	Если Объект.ВсеОрганизации Тогда
		Элементы.ГруппаДоступКОрганизациям.Заголовок = "Организации (все)";
	Иначе
		Элементы.ГруппаДоступКОрганизациям.Заголовок = "Организации (" + Формат(Объект.ДоступныеОрганизации.Количество(), "ЧН=0; ЧГ=0") + ")";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти