&НаКлиенте
Процедура КонтактыПолучателейУведомленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контекст", Объект.Ссылка);
	ПараметрыОткрытия.Вставить("ТипКонтакта", ТекущиеДанные.Тип);
	ПараметрыОткрытия.Вставить("ЗначениеКонтакта", ТекущиеДанные.Контакт);
	ПараметрыОткрытия.Вставить("ТрНЗамечанияОтВодителя", ТекущиеДанные.ТрНЗамечанияОтВодителя);
	ПараметрыОткрытия.Вставить("ТрНЗамечанияОтПеревозчика", ТекущиеДанные.ТрНЗамечанияОтПеревозчика);
	ПараметрыОткрытия.Вставить("ТрНОтказПВ", ТекущиеДанные.ТрНОтказПВ);
	ПараметрыОткрытия.Вставить("ТрНОтказГП", ТекущиеДанные.ТрНОтказГП);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаВыбораКонтакта";
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ИзменениеКонтактнойИнформацииЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонтактыПолучателейУведомлений(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед добавлением необходимо сохранить");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контекст", Объект.Ссылка);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаВыбораКонтакта";
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ДобавлениеКонтактнойИнформацииЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеКонтактнойИнформацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Объект.КонтактыПолучателейУведомлений.Добавить();
	НоваяСтрока.Тип = Результат.ТипКонтакта;
	НоваяСтрока.Контакт = Результат.ЗначениеКонтакта;
	НоваяСтрока.ТрНЗамечанияОтВодителя = Результат.ТрНЗамечанияОтВодителя;
	НоваяСтрока.ТрНЗамечанияОтПеревозчика = Результат.ТрНЗамечанияОтПеревозчика;
	НоваяСтрока.ТрНОтказПВ = Результат.ТрНОтказПВ;
	НоваяСтрока.ТрНОтказГП = Результат.ТрНОтказГП;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеКонтактнойИнформацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.Тип = Результат.ТипКонтакта;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.Контакт = Результат.ЗначениеКонтакта;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНЗамечанияОтВодителя = Результат.ТрНЗамечанияОтВодителя;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНЗамечанияОтПеревозчика = Результат.ТрНЗамечанияОтПеревозчика;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНОтказПВ = Результат.ТрНОтказПВ;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНОтказГП = Результат.ТрНОтказГП;
	
КонецПроцедуры

