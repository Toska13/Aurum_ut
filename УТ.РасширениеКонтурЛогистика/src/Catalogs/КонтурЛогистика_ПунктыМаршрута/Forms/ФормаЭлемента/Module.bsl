&НаКлиенте
Процедура СоздатьНаОсновании(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед добавлением необходимо сохранить");
		Возврат;
	КонецЕсли;
			
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	ИмяТипаСправочника = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(Объект.Ссылка);
	
	ЗначениеОтбора = Новый Структура("НаправлениеКонвертации, ТипСправочникаЛогистика", НаправлениеКонвертации, ИмяТипаСправочника); 
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"СоздатьНаОснованииНачалоВыбораЗавершение", Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьНаОснованииНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат = Неопределено Тогда
		Сообщить("Не выбрана настройка конвертации справочника");
		Возврат;
	КонецЕсли;
	
	НастройкаКонвертацииСправочника = Результат;
	КонтурЛогистика_КонвертацияКлиент.КонвертироватьОбъектСправочникаЛогистикиВОбъектУС(ЭтаФорма, НастройкаКонвертацииСправочника);
	
	Элементы.СинхронизироватьОбъектЛогистикиСОбъектомУС.Видимость = Объект.СвязанныеОбъекты.Количество() = 1;

КонецПроцедуры        

&НаКлиенте
Процедура АдресКодРегионПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.АдресКодРегион) Тогда
		Возврат;
	КонецЕсли;
	
	ЧасовойПоясЛок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЧасовойПоясПоКодуРегиона(Объект.АдресКодРегион);
	
	Если ЗначениеЗаполнено(Объект.ЧасовойПояс)
		И Объект.ЧасовойПояс <> ЧасовойПоясЛок Тогда
		
		ТекстВопроса = "Часовой пояс заполнен и не совпадает с значением по умолчанию. Перезаполнить?";
		ДополнительныеПараметры = Новый Структура("ЧасовойПоясЛок", ЧасовойПоясЛок);
		Оповещение = Новый ОписаниеОповещения("АдресКодРегионПриИзмененииЗавершение", ЭтаФорма, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса,РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Да);
	Иначе
		Объект.ЧасовойПояс = ЧасовойПоясЛок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресКодРегионПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет
		Или Ответ = КодВозвратаДиалога.Отмена
		Или Ответ = Неопределено Тогда
		
		Возврат;
	КонецЕсли;
	
	Объект.ЧасовойПояс = ДополнительныеПараметры.ЧасовойПоясЛок;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораЧасовыхПоясов()
	
	Элементы.ЧасовойПояс.СписокВыбора.Очистить();
	Элементы.ЧасовойПояс.СписокВыбора.ЗагрузитьЗначения(ПолучитьДопустимыеЧасовыеПояса());
	
	Для Каждого ТекущаяСтрока Из Элементы.ЧасовойПояс.СписокВыбора Цикл
		ТекущаяСтрока.Представление = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(ТекущаяСтрока.Значение);
	КонецЦикла;
	
КонецПроцедуры

