#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Заголовок", Заголовок);
	Параметры.Свойство("ЗначениеСтрока", ЗначениеСтрока);
	Параметры.Свойство("ЗначениеБулево", ЗначениеБулево);
	
	Если Параметры.Свойство("ТипВыбораНастройки") Тогда
		Если Параметры.ТипВыбораНастройки = Тип("Строка") Тогда
			Элементы.ЗначениеСтрока.Видимость = Истина;
			Элементы.ЗначениеБулево.Видимость = Ложь;
		Иначе
			Элементы.ЗначениеСтрока.Видимость = Ложь;
			Элементы.ЗначениеБулево.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("ПараметрыРедактирования") Тогда
		Параметры.ПараметрыРедактирования.Свойство("Комментарий", Комментарий);
		Параметры.ПараметрыРедактирования.Свойство("ПодсказкаВвода", Элементы.ЗначениеСтрока.ПодсказкаВвода);
		Параметры.ПараметрыРедактирования.Свойство("ПодсказкаВвода", Элементы.ЗначениеБулево.ПодсказкаВвода);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Комментарий.Видимость = ЗначениеЗаполнено(Комментарий);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Принять(Команда)
	
	Если Элементы.ЗначениеСтрока.Видимость Тогда
		Закрыть(ЗначениеСтрока);
	Иначе
		Закрыть(ЗначениеБулево);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти
