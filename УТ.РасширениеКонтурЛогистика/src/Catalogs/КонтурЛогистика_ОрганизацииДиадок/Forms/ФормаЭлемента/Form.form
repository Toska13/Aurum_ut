    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>КонтрагентыДинСписок.СвязанныеОбъекты</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>КонтрагентыДинСписок.Картинка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>КонтрагентыДинСписок.ТребуемоеДействие</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Контрагент КАК Контрагент,
	КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Статус КАК Статус,
	КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Контрагент.КоличествоСопоставлений КАК ОрганизацииВБазе,
	ВЫБОР
		КОГДА КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Контрагент.КоличествоСопоставлений > 0
			ТОГДА &quot;&quot;
		ИНАЧЕ &quot;Сопоставить&quot;
	КОНЕЦ КАК ТребуемоеДействие,
	ВЫБОР
		КОГДА КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Контрагент.КоличествоСопоставлений > 0
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК Картинка
ИЗ
	Справочник.КонтурЛогистика_ОрганизацииДиадок.Контрагенты КАК КонтурЛогистика_ОрганизацииДиадокКонтрагенты
ГДЕ
	КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Ссылка = &amp;ОрганизацияСсылка</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
