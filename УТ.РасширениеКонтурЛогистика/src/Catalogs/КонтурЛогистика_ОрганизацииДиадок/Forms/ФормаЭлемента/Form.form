  <attributes>
    <name>КонтрагентыДинСписок</name>
    <title>
      <key>ru</key>
      <value>Контрагенты дин список</value>
    </title>
    <id>10</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
