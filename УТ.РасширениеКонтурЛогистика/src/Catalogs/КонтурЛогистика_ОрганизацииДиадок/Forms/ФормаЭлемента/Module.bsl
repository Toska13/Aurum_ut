Процедура СохранитьНастройкиОрганизации()
	
	КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.СохранитьНастройкиОрганизации(Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗначениеНастройкиСервер(Ссылка, Настройка, НовоеЗначение)
	
	Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(Ссылка, Настройка, НовоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНастройку(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводСтроки_КонтурЛогистика(
		"", "Введите имя настойки", Ложь, ЭтаФорма, "ДобавлениеНастройкиЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеНастройкиЗавершение(ИмяНастройки, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	ТекЗначение = ПолучитьЗначениеНастройки(ИмяНастройки);
	Если ТекЗначение <> Неопределено Тогда 
		Сообщить("Настройка с именем """ + ИмяНастройки + """ уже есть");
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеНастройки(ИмяНастройки, "");
	
	Элементы.НастройкиДинСписок.Обновить();
	
