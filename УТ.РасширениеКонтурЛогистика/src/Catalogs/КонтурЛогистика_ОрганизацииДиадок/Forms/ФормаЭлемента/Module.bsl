&НаКлиенте
Процедура СвязанныеОбъектыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОбработкаВыбораСвязанногоОбъекта(ЭтаФорма, ВыбранноеЗначение);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОсновании(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед добавлением необходимо сохранить");
		Возврат;
	КонецЕсли;
			
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	ИмяТипаСправочника = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(Объект.Ссылка);
	
	ЗначениеОтбора = Новый Структура("НаправлениеКонвертации, ТипСправочникаЛогистика", НаправлениеКонвертации, ИмяТипаСправочника); 
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"СоздатьНаОснованииНачалоВыбораЗавершение", Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОснованииНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат = Неопределено Тогда
		Сообщить("Не выбрана настройка конвертации справочника");
		Возврат;
	КонецЕсли;
	
	НастройкаКонвертацииСправочника = Результат;
	КонтурЛогистика_КонвертацияКлиент.КонвертироватьОбъектСправочникаЛогистикиВОбъектУС(ЭтаФорма, НастройкаКонвертацииСправочника);
	
КонецПроцедуры

#Область Авторизация

&НаСервере
Процедура ОбновитьГруппуАвторизацииНаПортале()
	
	АвторизацияВыполнена = Ложь;
	
	Если Не АвторизацияПоOIDC Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		АвторизацияНаПорталеИконка = 0;
		АвторизацияНаПортале = "Авторизоваться";
		Возврат;
	КонецЕсли;
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(Объект.Ссылка);
	Если ЗначениеЗаполнено(ДанныеАутентификации.ТокенДоступа) Тогда
		
		АвторизацияНаПорталеИконка = 2;
		АвторизацияНаПортале = "Выйти (" + ДанныеАутентификации.ФИО + ")";
		АвторизацияВыполнена = Истина;
		
	Иначе
		
		АвторизацияНаПорталеИконка = 0;
		АвторизацияНаПортале = "Авторизоваться";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьАвторизации()
	
	Элементы.ГруппаАвторизация.Видимость = (АвторизацияПоOIDC И Объект.Наш);
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияНаПорталеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если АвторизацияНаПортале = "Авторизоваться" Тогда
		
		ВыполнитьАвторизациюНаПортале();
		
	Иначе
		
		УдалитьАвторизациюНаПортале();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвторизациюНаПорталеПриОткрытии()
	
	ВыполнитьАвторизациюНаПортале();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвторизациюНаПортале(ПриУстановкеПризнакаНаш = Ложь)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Организация", Объект.Ссылка);
	Если ПриУстановкеПризнакаНаш Тогда
		ДополнительныеПараметры.Вставить("ПриУстановкеПризнакаНаш");
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеАутентификации", ЭтаФорма, ДополнительныеПараметры);
	
	ОтборСессий = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОтборСессий(Объект.Ссылка);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПолучениеСессии(Оповещение, ОтборСессий);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьАвторизациюНаПортале()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УдалитьСессиюАутентификацииПоОрганизации(Объект.Ссылка);
	
	ОбновитьГруппуАвторизацииНаПортале();
	
	ОбновитьВидимостьАвторизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеАутентификации(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получим доступные организации
	МоиОрганизацииДиадок = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetMyOrganizations(Результат.ТокенДоступа);
	
	Если МоиОрганизацииДиадок.Organizations.Количество() = 0 Тогда
		Сообщить("У вас нет доступа в эту организацию");
		КонтурЛогистика_ОбщегоНазначенияСервер.УдалитьСессиюАутентификацииПоОрганизации(ДополнительныеПараметры.Организация);
		Возврат;
	КонецЕсли;
	
	// Проверим, что текущая организация доступна текущему пользователю
	ОрганизацияДоступна = Ложь;
	ТекущийOrgId = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ДополнительныеПараметры.Организация, "OrgId");
	Для Каждого ТекущаяСтрока Из МоиОрганизацииДиадок.Organizations Цикл
		Если ТекущаяСтрока.OrgId = ТекущийOrgId Тогда
			ОрганизацияДоступна = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ОрганизацияДоступна Тогда
		КонтурЛогистика_ОбщегоНазначенияСервер.УдалитьСессиюАутентификацииПоОрганизации(ДополнительныеПараметры.Организация);
		Сообщить("Авторизованный пользователь не имеет доступа к выбранной организации: "
			+ Строка(ДополнительныеПараметры.Организация));
		Возврат;
	КонецЕсли;
	
	РезультатПроверкиПрав = КонтурЛогистика_API_Диадок.ПроверкаПравДляРаботыСервисом(Объект.Ссылка, Результат.ТокенДоступа);
	Если Не РезультатПроверкиПрав.ПравДостаточно Тогда
		
		Если РезультатПроверкиПрав.ПереченьНедостающихПрав.Количество() <> 0 Тогда
			ОткрытьФормуПроверкиПравДоступа(Объект.Ссылка, Результат.ТокенДоступа, Результат.ФИО);
		ИначеЕсли Не РезультатПроверкиПрав.ОплатаТарифа Тогда
			Сообщить("Необходима оплата тарифа АПИ");
		ИначеЕсли РезультатПроверкиПрав.ТекстОшибки <> "" Тогда
			Сообщить(РезультатПроверкиПрав.ТекстОшибки);
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияСервер.УдалитьСессиюАутентификацииПоОрганизации(Объект.Ссылка);
		
	КонецЕсли;
	
	Если Не КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ПравДостаточноДляРаботыСервисом(Объект.Ссылка, Результат.ТокенДоступа) Тогда
		
		ОткрытьФормуПроверкиПравДоступа(Объект.Ссылка, Результат.ТокенДоступа, Результат.ФИО);
		
		КонтурЛогистика_ОбщегоНазначенияСервер.УдалитьСессиюАутентификацииПоОрганизации(Объект.Ссылка);
		
	КонецЕсли;
	
	ОбновитьГруппуАвторизацииНаПортале();
	
	ОбновитьВидимостьАвторизации();
	
	Если ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("ПриУстановкеПризнакаНаш") Тогда
		ОбработатьПриВключенииНаш();
	КонецЕсли;
	
	Если АвторизацияВыполнена Тогда
		// Отправить метрику успешной авторизации
		ОрганизацийДД = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
		КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьАвторизацию(ОрганизацийДД, "OIDC_Админ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПроверкиПравДоступа(Организация, ТокенДоступа, ФИО)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("Токен", ТокенДоступа);
	ПараметрыФормы.Вставить("ФИО", ФИО);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_Аутентификация.Форма.ФормаПроверкиПравДоступа", ПараметрыФормы,
		ЭтаФорма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ФильтрПоИнфоПолям

&НаКлиенте
Процедура ФильтрПоИнфоПолямКодомПриИзменении(Элемент)
	
	ТребуетсяОбновитьПовторноИспользуемыеЗначения = Истина;
	
	ОбновитьВидимостьФильтраПоИнфоПолям();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьФильтраПоИнфоПолям()
	
	Элементы.ГруппаФильтрПоИнфоПолямМаппинг.Видимость = Не Объект.ФильтрПоИнфоПолямКодом;
	Элементы.ГруппаФильтрПоИнфоПолямКодом.Видимость = Объект.ФильтрПоИнфоПолямКодом;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоИнфоПолямКодомВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ФильтрПоИнфоПолямВыражениеВычисления) Тогда
		// Добавим пример
		Объект.ФильтрПоИнфоПолямВыражениеВычисления =
		"//Пример:
		|//Доступны: Организация (ссылка) и ИнфоПоля (соответствие).
		|//Для Каждого ТекущееПоле Из ИнфоПоля Цикл
		|//	Если ТекущееПоле.Ключ = ""НомерПодразделения"" И ТекущееПоле.Значение = ""13"" Тогда
		|//		РезультатВычисления = Истина;
		|//		Прервать;
		|//	КонецЕсли;
		|//КонецЦикла;";
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		Объект.ФильтрПоИнфоПолямВыражениеВычисления, Объект, "ФильтрПоИнфоПолямВыражениеВычисления");
	
	ТребуетсяОбновитьПовторноИспользуемыеЗначения = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоИнфоПолямВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		УспешнаяЗапись = ЭтаФорма.Записать();
		Если Не УспешнаяЗапись Тогда 
			Сообщить("Не удалось записать настройку. Запишите вручную, затем переходите к настройке.");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ФильтрПоИнфоПолям.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СпособМаппинга) Тогда
		ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение");
	КонецЕсли;
	
	ПараметрыФормыНастройки = Новый Структура(
		"ВыражениеВычисления, ВыражениеВычисления2, ВыражениеВычисленияСтрокаНеогр, ИмяНастраиваемогоПоля, СвойствоОбъекта,
		|КлючДопСвойстваРеквизита, НастройкаКонвертации, СпособМаппинга, ИмяТабЧастьТовары, ПутьКоллекцияТабЧастьТовары,
		|ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ");
	ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекущиеДанные.Ключ);
	
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации",
		ПредопределенноеЗначение("Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка"));
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекущиеДанные.СпособМаппинга);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекущиеДанные.ВыражениеВычисления);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр);
	ПараметрыФормыНастройки.Вставить("НастройкаИнфоПолей");
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник", ПараметрыФормыНастройки,
		ЭтаФорма, ЭтаФорма, "ОбработчикРедактированиеСтрокиВДопФорме", "ФильтрПоИнфоПолям");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикРедактированиеСтрокиВДопФорме(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено
		И ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
		И ИмяЭлемента <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		ТекущиеДанные = Элементы[ИмяЭлемента].ТекущиеДанные;
		ТекущиеДанные.СпособМаппинга = ВыбранноеЗначение.СпособМаппинга;
		ТекущиеДанные.ВыражениеВычисления = ВыбранноеЗначение.ВыражениеВычисления;
		ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр = ВыбранноеЗначение.ВыражениеВычисленияСтрокаНеогр;
		
		ТребуетсяОбновитьПовторноИспользуемыеЗначения = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтключениеЧтенияЛенты

&НаКлиенте
Процедура ЧитатьЛентуДиадокФлажекВклВыклНажатие(Элемент)
	
	ЧитатьЛентуДиадок = Не ЧитатьЛентуДиадок;
	
	ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
	ИспользуетсяЭкспедиторскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЭкспедиторскаяРасписка");
	
	Если Не ЧитатьЛентуДиадок И (ИспользуетсяЗаказЗаявка Или ИспользуетсяЭкспедиторскаяРасписка) Тогда
		ТекстВопроса = ТекстВопросаДляВыключенияЧтенияЛентыСобытийДиадок(ИспользуетсяЗаказЗаявка, ИспользуетсяЭкспедиторскаяРасписка);
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, РежимДиалогаВопрос.ДаНет,
			,, ЭтаФорма,
			"ВыключениеНастройкиЧитатьЛентуДиадокЗавершение");
	Иначе
	
		УстановитьЗначениеНастройкиЧитатьЛентуДиадок();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстВопросаДляВыключенияЧтенияЛентыСобытийДиадок(ИспользуетсяЗаказЗаявка, ИспользуетсяЭкспедиторскаяРасписка)
	
	ТекстВопроса = "";
	
	Если ИспользуетсяЗаказЗаявка И ИспользуетсяЭкспедиторскаяРасписка Тогда
		ТекстВопроса = "В модуле используются документы Заказ (заявка) и Экспедиторская расписка.";
	ИначеЕсли ИспользуетсяЗаказЗаявка И Не ИспользуетсяЭкспедиторскаяРасписка Тогда
		ТекстВопроса = "В модуле используется документ Заказ (заявка).";
	ИначеЕсли Не ИспользуетсяЗаказЗаявка И ИспользуетсяЭкспедиторскаяРасписка Тогда
		ТекстВопроса = "В модуле используется документ Экспедиторская расписка.";
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + " " + "Обновление статусов документов происходит только через ленту Диадок. После выключения настройки статусы документов обновляться не будут. Выключить настройку?";
			
	Возврат ТекстВопроса;
		
КонецФункции

&НаКлиенте
Процедура ВыключениеНастройкиЧитатьЛентуДиадокЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ЧитатьЛентуДиадок = Не ЧитатьЛентуДиадок;
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеНастройкиЧитатьЛентуДиадок();		
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеНастройкиЧитатьЛентуДиадок()
		
	УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок"), ЧитатьЛентуДиадок);
			
	Если ЧитатьЛентуДиадок И ЗначениеЗаполнено(АктуальностьЛентыСобытийДиадокДата) Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазницаВДнях(НачалоДня(ТекущаяДата()), НачалоДня(АктуальностьЛентыСобытийДиадокДата)) > 14 Тогда
			УстановитьЗначениеНастройкиСервер(
				Объект.Ссылка, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата"), НачалоДня(ТекущаяДата()));
		КонецЕсли;
		
	КонецЕсли;
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();	
	ОбновитьВидимостьДоступностьГраниц();
			
КонецПроцедуры

&НаКлиенте
Процедура ЧитатьЛентуЛогистикиФлажекВклВыклНажатие(Элемент)
	
	ЧитатьЛентуЛогистики = Не ЧитатьЛентуЛогистики;
	ЕстьКлючАПИЛогистики = ЕстьКлючАПИЛогистики();
	
	Если ЧитатьЛентуЛогистики И Не АвторизацияПоOIDC И Не ЕстьКлючАПИЛогистики Тогда
		
		ПараметрыФормы = Новый Структура("КлючАПИ", "");
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВводаАпиКлюча", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"ИзменениеНастройкиКлючАПИПриУстановкеЧтенияЛентыЛогистики",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеНастройкиЧитатьЛентуЛогистики()
		
	УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики"), ЧитатьЛентуЛогистики);
		
	ДатаГраницыСинхронизацииЛогистика = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"));
	
	Если ЧитатьЛентуЛогистики И ЗначениеЗаполнено(ДатаГраницыСинхронизацииЛогистика) Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазницаВДнях(НачалоДня(ТекущаяДата()), НачалоДня(АктуальностьЛентыСобытийДиадокДата)) > 14 Тогда
			УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"), НачалоДня(ТекущаяДата()));
			УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий"), "");	
		КонецЕсли;
		
	КонецЕсли;
	
	Записать();
		
	Элементы.НастройкиДинСписок.Обновить();		
	ОбновитьВидимостьДоступностьГраниц();
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеНастройкиКлючАПИПриУстановкеЧтенияЛентыЛогистики(НовоеЗначение, ДополнительныеПараметры) Экспорт
	
	Если НовоеЗначение = Неопределено Тогда
		ЧитатьЛентуЛогистики = Не ЧитатьЛентуЛогистики;
		ОбновитьВидимостьДоступностьГраниц();
	Иначе		
			
		УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"), НовоеЗначение);
		УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		 		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыПослеУдаления(Элемент)
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#Область СервисФизическихЛиц

&НаСервере
Процедура ИнициализироватьСервисФизическихЛиц()
	
	ДоступенСервисФизЛиц = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступенСервисФизЛиц(Объект.Ссылка);
	
	ОтборФизическиеЛица = "Все";
	ФизическиеЛица.Параметры.УстановитьЗначениеПараметра("Организация", Объект.Ссылка);
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИПараметрыФизическихЛиц()

	Если ЗначениеЗаполнено(Объект.Ссылка) И ДоступенСервисФизЛиц Тогда
		Элементы.СтраницаФизическиеЛица.Видимость = Истина;
	Иначе
		Элементы.СтраницаФизическиеЛица.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	МастерДанныеСотрудников = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МастерДанныеСотрудников");
	Если МастерДанныеСотрудников = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_МастерДанныеСотрудников.Модуль1с") Тогда
		Элементы.ОткрытьНастройкуМастерДанные.Заголовок = "Источник данных: 1С";
		Элементы.СинхронизироватьФизическиеЛица.Заголовок = "Выгрузить всех в сервис";
	Иначе
		Элементы.ОткрытьНастройкуМастерДанные.Заголовок = "Источник данных: сервис";
		Элементы.СинхронизироватьФизическиеЛица.Заголовок = "Обновить всех из сервиса";
	КонецЕсли;
	
	Элементы.ФизическиеЛицаПроверитьПриглашения.Видимость = КонтурЛогистика_СервисФизическихЛицСервер.ЕстьНепринятыеПриглашения(, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФизическоеЛицо(Команда)
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Добавление сотрудника", "Добавить сотрудника", "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента", "Организация");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Ссылка);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_СервисФизическихЛиц.Форма.ФормаОтправкиПриглашения", 
		ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОтправкиПриглашения");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОтправкиПриглашения(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.ФизическиеЛица.Обновить();
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборФизическиеЛицаПриИзменении(Элемент)
	
	ФизическиеЛица.Отбор.Элементы.Очистить();
	
	Если ОтборФизическиеЛица = "НеПринятые" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "Статус",
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборФизическиеЛица = "Ошибка" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "ЕстьОшибка",
			Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборФизическиеЛица = "ЕстьРасхождения" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "ЕстьРасхождения",
			Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборФизическиеЛица = "Удалены" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "Статус",
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.Удалено"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьФизическиеЛица(Команда)
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("Организация", Объект.Ссылка);
	
	Прогресс = Новый Структура("ПорядковыйНомер, Колво", 0, 0);
	
	МастерДанныеСотрудников = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МастерДанныеСотрудников");
	Если МастерДанныеСотрудников = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_МастерДанныеСотрудников.Модуль1с") Тогда
		
		АдресПрогрессаВыгрузкиСотрудниковВСервис = ПоместитьВоВременноеХранилище(Прогресс, ЭтаФорма.УникальныйИдентификатор);
		
		ПараметрыФоновогоЗадания.Вставить("АдресПрогресса", АдресПрогрессаВыгрузкиСотрудниковВСервис);
		
		РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыгрузитьСотрудниковВСервисФизическихЛиц",
			ПараметрыФоновогоЗадания,
			"КлючФЗ_ВыгрузитьСотрудниковВСервисФизическихЛиц",
			"Выгрузить сотрудник в сервис физических лиц");
			
		Сообщить("Выполняется выгрузка сотрудников в сервис");
			
		Если РезультатЗапуска.Статус = "Выполняется" Тогда
			
			ИдентификаторФЗ_ВыгрузитьСотрудниковВСервис = РезультатЗапуска.ИдентификаторЗадания;
			
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц", 0.1, Истина);
			
		ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
			
			ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц();
			
		КонецЕсли;
		
	Иначе
		
		АдресПрогрессаЗагрузкиСотрудниковИзСервиса = ПоместитьВоВременноеХранилище(Прогресс, ЭтаФорма.УникальныйИдентификатор);

		ПараметрыФоновогоЗадания.Вставить("АдресПрогресса", АдресПрогрессаЗагрузкиСотрудниковИзСервиса);
			
		РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.ЗагрузитьСотрудниковИзСервисаФизическихЛиц",
			ПараметрыФоновогоЗадания,
			"КлючФЗ_ЗагрузитьСотрудниковИзСервисаФизическихЛиц",
			"Загрузить сотрудников из сервиса физических лиц");
			
		Сообщить("Выполняется обновление сотрудников из сервиса");
			
		Если РезультатЗапуска.Статус = "Выполняется" Тогда
			
			ИдентификаторФЗ_ЗагрузитьСотрудниковИзСервиса = РезультатЗапуска.ИдентификаторЗадания;
			
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеЗагрузкиСотрудниковИзСервисаФизическихЛиц", 0.1, Истина);
			
		ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
			
			ПроверитьФоновоеЗаданиеЗагрузкиСотрудниковИзСервисаФизическихЛиц();
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц() Экспорт
	
	ИнтервалОбработчикаОжидания = 1;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ВыгрузитьСотрудниковВСервис, Элементы.ЛоадерВыполнитьОбмен);
	
	Если ЗаданиеЕщеВыполняется Тогда 
		
		Прогресс = ПолучитьИзВременногоХранилища(АдресПрогрессаВыгрузкиСотрудниковВСервис);
		
		Если Прогресс.КолВо > 0 Тогда
			Пояснение = ?(ЗначениеЗаполнено(Прогресс.Сотрудник), Строка(Прогресс.ПорядковыйНомер) + " " + СокрЛП(Прогресс.Сотрудник), "");
			Состояние("Выполняется выгрузка сотрудников", Прогресс.ПорядковыйНомер / Прогресс.КолВо * 100, Пояснение);
			Элементы.ФизическиеЛица.Обновить();
		Иначе
			Состояние("Выполняется выгрузка сотрудников",);	
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		Элементы.ФизическиеЛица.Обновить();
		
		Сообщить("Выгрузка сотрудников в сервис выполнена");
		
	КонецЕсли;

КонецПроцедуры

