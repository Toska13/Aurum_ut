&НаСервере
Процедура ОбновитьДанныеДинамическихСписков()

	//Подразделения.Параметры.УстановитьЗначениеПараметра("OrgId", Объект.OrgId);	
	
	ЭлементОтбора = Подразделения.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   	
