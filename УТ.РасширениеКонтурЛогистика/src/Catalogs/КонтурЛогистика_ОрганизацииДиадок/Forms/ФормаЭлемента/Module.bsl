	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИНН", Объект.ИНН);
	ПараметрыФормы.Вставить("КПП", Объект.КПП);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВыбораПоИННКПП",
