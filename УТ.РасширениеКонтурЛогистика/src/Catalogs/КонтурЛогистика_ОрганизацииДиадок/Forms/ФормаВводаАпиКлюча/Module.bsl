#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("КлючАПИ", КлючАПИ);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Принять(Команда)
	
	Если ЗначениеЗаполнено(КлючАПИ) Тогда
		ПроверитьАпиКлюч();	
	КонецЕсли;
	
	Закрыть(КлючАПИ);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьАпиКлюч()
	
	Попытка
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика();
		ПараметрыСервиса.Вставить("ApiKey", КлючАПИ);
		
		КонтурЛогистика_API_Логистика.ПолучитьСведенияОСобственнойОрганизации(ПараметрыСервиса);
						
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		
	КонецПопытки;
		
КонецПроцедуры

#КонецОбласти

