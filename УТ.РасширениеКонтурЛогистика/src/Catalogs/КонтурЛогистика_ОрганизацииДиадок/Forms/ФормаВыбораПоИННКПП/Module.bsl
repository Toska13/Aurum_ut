#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ИНН", ИНН);
	Параметры.Свойство("КПП", КПП);
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Заголовок = Заголовок + ": ИНН " + ИНН;
		
		Если ЗначениеЗаполнено(КПП) Тогда
			Заголовок = Заголовок + ", КПП " + КПП;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		ЗапроситьИзДиадокаИЗаполнитьСписок();
	Иначе
		Элементы.Найти.КнопкаПоУмолчанию = Истина;
		Элементы.ФормаВыбрать.КнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	
	Если Параметры.РежимПоиска Тогда 
		Заголовок = "Поиск по ИНН в Диадоке";
	КонецЕсли;
	
	// Не важно под какой организацией получаем данные
	ТочноеСовпадение = Ложь;
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
	Если ПараметрыСервиса.АвторизацияВыполнена Тогда
		Элементы.ОрганизацииЕстьВСервисеЛогистика.Видимость = Истина;
	Иначе
		Элементы.ОрганизацииЕстьВСервисеЛогистика.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОрганизации

&НаКлиенте
Процедура ОрганизацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыборОрганизации();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыборОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВДД(Команда)
	
	Если ЗначениеЗаполнено(СокрЛП(ИНН)) Тогда 
		
		Организации.Очистить();
		ЗапроситьИзДиадокаИЗаполнитьСписок();
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.Видимость = Организации.Количество() = 0;
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.КнопкаПоУмолчанию = Организации.Количество() = 0;
		
		Элементы.Найти.КнопкаПоУмолчанию = Ложь;

	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Обязательно указать ИНН для поиска");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыборОрганизации()
	
	ТекущиеДанные = Элементы.Организации.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.РежимПоиска Тогда
		
		Данные = ДанныеПоОрганизации(ТекущиеДанные.OrgId);
		Если Данные <> Неопределено Тогда 
			НайденнаяОрга = ДобавитьОрганизациюИзДД(Данные);
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(НайденнаяОрга);
			Оповестить("КонтурЛогистика_ОбновитьОрганизации");
		КонецЕсли;
		
	Иначе
		
		ТекстВопроса = "Организация Диадок будет перезаполнена. Продолжить?";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса,,,, ЭтаФорма, "ВыборЗавершение");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьОрганизациюИзДД(Данные)
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(Данные);
	
КонецФункции

&НаКлиенте
Процедура ВыборЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет
		Или Ответ = КодВозвратаДиалога.Отмена Тогда
		
		Возврат;
	КонецЕсли;
	
	Данные = ДанныеПоОрганизации(Элементы.Организации.ТекущиеДанные.OrgId);
	
	Закрыть(Данные);
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеПоОрганизации(OrgId)
	
	ДанныеОрганизаций = ПолучитьИзВременногоХранилища(АдремХранилищаВходныхДанных);
	
	Если ДанныеОрганизаций = Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Данные могли устареть. Повторите поиск");
		Элементы.Найти.КнопкаПоУмолчанию = Истина;
		
	Иначе
		
		Для Каждого ТекущаяСтрока Из ДанныеОрганизаций Цикл
			Если ТекущаяСтрока.OrgId = OrgId Тогда
				Возврат ТекущаяСтрока;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуОрганизаций(ДанныеОрганизаций)
	
	Для Каждого ТекущаяСтрока Из ДанныеОрганизаций Цикл
		
		НоваяСтрока = Организации.Добавить();
		НоваяСтрока.OrgId = ТекущаяСтрока.OrgId;
		НоваяСтрока.НаименованиеОрганизацииПолное = ТекущаяСтрока.FullName;
		
		Если ТекущаяСтрока.Свойство("ShortName") Тогда
			НоваяСтрока.Наименование = ТекущаяСтрока.ShortName;
		Иначе
			НоваяСтрока.Наименование = НоваяСтрока.НаименованиеОрганизацииПолное;
		КонецЕсли;
		
		Если СтрДлина(ТекущаяСтрока.Inn) = 12 Тогда
			НоваяСтрока.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИП");
		ИначеЕсли ТекущаяСтрока.IsForeign Тогда
			НоваяСтрока.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо");
		Иначе 
			НоваяСтрока.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ЮрЛицо");
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("Kpp") Тогда
			НоваяСтрока.КПП = ТекущаяСтрока.Kpp;
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("Ogrn") Тогда
			НоваяСтрока.ОГРН = ТекущаяСтрока.Ogrn;
		КонецЕсли;
		
		НоваяСтрока.Тестовая = ТекущаяСтрока.IsTest;
		НоваяСтрока.Роуминг = ТекущаяСтрока.IsRoaming;
		НоваяСтрока.Активная = ТекущаяСтрока.IsActive;
		
		Если ТекущаяСтрока.Свойство("FnsParticipantId") Тогда
			
			НоваяСтрока.ИдентификаторУчастникаЭДО = ТекущаяСтрока.FnsParticipantId;
			
			НоваяСтрока.ЭДОПровайдер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПровайдераПоИдентификатору(ТекущаяСтрока.FnsParticipantId);
			
		КонецЕсли;
		
		// Не важно под какой организацией получаем данные
		ТочноеСовпадение = Ложь;
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
		Если ПараметрыСервиса.АвторизацияВыполнена Тогда
			
			Попытка
				
				ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика();
				СтруктураДанных = КонтурЛогистика_API_Логистика.ПолучитьРеквизитыОрганизации(ПараметрыСервисаЛогистика, ИНН, НоваяСтрока.КПП);
				
				Если СтруктураДанных.Количество() > 0 Тогда
					
					// найти именно с таким FnsParticipantId
					Для Каждого ОрганизацияДД Из СтруктураДанных Цикл 
						
						Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторУчастникаЭДО) 
							И ОрганизацияДД.Получить("fnsParticipantId") = НоваяСтрока.ИдентификаторУчастникаЭДО  Тогда 
							НоваяСтрока.ЕстьВСервисеЛогистика = ОрганизацияДД.Получить("isLogistics");
							Прервать;
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
				
			Исключение
			    // нет в логистике
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Организации.Сортировать("Роуминг");
	
КонецПроцедуры

&НаСервере
Процедура ЗапроситьИзДиадокаИЗаполнитьСписок()
	
	Перем Данные, ДанныеОрганизаций;
	
	Данные = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganizationsByInnKpp(СокрЛП(ИНН), КПП);
	
	Если ТипЗнч(Данные) <> Тип("Структура") И Не Данные.Свойство("Organizations") Тогда
		
		Организации.Очистить();
		
	Иначе
		
		ДанныеОрганизаций = Данные.Organizations;
		
		Если ТипЗнч(ДанныеОрганизаций) <> Тип("Массив") Тогда
			
			Организации.Очистить();
			
		Иначе
			
			ЗаполнитьТаблицуОрганизаций(ДанныеОрганизаций);
			
			АдремХранилищаВходныхДанных = ПоместитьВоВременноеХранилище(ДанныеОрганизаций, Новый УникальныйИдентификатор);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИННПриИзменении(Элемент)
	ИНН = СокрЛП(ИНН);
КонецПроцедуры

#КонецОбласти