Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьпредставлениеАдреса();
	
	КоличествоСопоставлений = СвязанныеОбъекты.Количество();
	
	Если Наш Тогда
		ОбновитьПовторноИспользуемыеЗначения();
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			// Добавим разрешения
			НашПередЗаписью = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Ссылка, "Наш");
			Если Не НашПередЗаписью Тогда
				Справочники.КонтурЛогистика_Сотрудники.ДобавитьРазрешенияПоОрганизации(Ссылка);
			КонецЕсли;
		Иначе
			// Новый объект, добавим разрешения после записи, когда появится ссылка
			ДополнительныеСвойства.Вставить("ДобавитьРазрешенияПоОрганизацииПриЗаписи");
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьПровайдера();
	
	Если ДополнительныеСвойства.Свойство("ПолучитьИдентификаторУчастникаЭДОИзДиадок") И ЗначениеЗаполнено(ИНН) Тогда
		ПолучитьИдентификаторУчастникаЭДОИзДиадок();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда 
		Наименование = НаименованиеОрганизацииПолное;
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ", ЭтотОбъект, Отказ);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("КонтурЛогистика_ОрганизацииДиадок_ПередЗаписью_После", Истина, ПараметрыПМ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства <> Неопределено
		И ДополнительныеСвойства.Свойство("ДобавитьРазрешенияПоОрганизацииПриЗаписи") Тогда
		
		Справочники.КонтурЛогистика_Сотрудники.ДобавитьРазрешенияПоОрганизации(Ссылка);
	КонецЕсли;
	
	Если ДополнительныеСвойства <> Неопределено
		И ДополнительныеСвойства.Свойство("СинхронизироватьИзСервисаЛогистика") И ЗначениеЗаполнено(ИНН) Тогда
		
		ДополнительныеСвойства.Удалить("СинхронизироватьИзСервисаЛогистика");
		СинхронизироватьИзСервисаЛогистика();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьпредставлениеАдреса()
	
	// Представление региона
	ПредставлениеРегиона = АдресRegion;
	Если ЗначениеЗаполнено(АдресRegion) Тогда
		РегионыРФ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Код", АдресRegion);
		
		НайденныеСтроки = РегионыРФ.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			ПредставлениеРегиона = НайденныеСтроки[0].Наименование;
		КонецЕсли;
	КонецЕсли;
	
	АдресПредставление = СокрЛП(""
		+ АдресZipCode
		+ ?(ЗначениеЗаполнено(ПредставлениеРегиона), ", ", "")
		+ ПредставлениеРегиона);
	
	Если ЗначениеЗаполнено(АдресTerritory) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресTerritory; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресCity) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресCity; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресLocality) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресLocality; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресStreet) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресStreet; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресBuilding) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресBuilding; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресBlock) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресBlock; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресApartment) Тогда 
		АдресПредставление = АдресПредставление + ", " + АдресApartment; 	
	КонецЕсли;

	Если ЗначениеЗаполнено(ИнАдресCountry) Тогда 
		АдресПредставление = АдресПредставление + ", " + ИнАдресCountry; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнАдресAddress) Тогда 
		АдресПредставление = АдресПредставление + ", " + ИнАдресAddress; 	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП("" + АдресZipCode + АдресRegion + ИнАдресAddress))
		И ЗначениеЗаполнено(СокрЛП(АдресСтрока)) Тогда
		
		АдресПредставление = АдресСтрока;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПровайдера()
		
	Провайдер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПровайдераПоИдентификатору(ИдентификаторУчастникаЭДО);
	
	Роуминговая = Провайдер <> "Контур";
	
КонецПроцедуры

Процедура ПолучитьИдентификаторУчастникаЭДОИзДиадок()
	
	Данные = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganizationsByInnKpp(ИНН, КПП);
	
	Если ТипЗнч(Данные) <> Тип("Структура") И Не Данные.Свойство("Organizations") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОрганизаций = Данные.Organizations;
	
	Если ТипЗнч(ДанныеОрганизаций) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеОрганизаций.Количество() = 1 Тогда
		
		ТекущаяСтрока = ДанныеОрганизаций[0];
		Если ТекущаяСтрока.Свойство("FnsParticipantId") Тогда
			ИдентификаторУчастникаЭДО = ТекущаяСтрока.FnsParticipantId;
		КонецЕсли;
		
	Иначе
		
		Для Каждого ТекущаяСтрока Из ДанныеОрганизаций Цикл
			
			Если Не ТекущаяСтрока.Свойство("FnsParticipantId") Или ТекущаяСтрока.IsTest Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ТекущаяСтрока.IsRoaming И ТекущаяСтрока.IsActive Тогда
				ИдентификаторУчастникаЭДО = ТекущаяСтрока.FnsParticipantId;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьИзСервисаЛогистика() Экспорт
	
	Если Ссылка.Пустая() Тогда
		Сообщить("Перед синхронизацией из сервиса Логистика сначала запишите организацию в справочник");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка.ИНН) Тогда 
		Сообщить("У организации: " + Ссылка + " не заполнен ИНН - невозможно обновить данные");
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ДанныеОрганизации = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ПолучитьРеквизитыОрганизации(Ссылка);
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		Если Найти(ТекстОшибки, "NotFound") Тогда 
			Возврат;
		Иначе
			КонтурЛогистика_Метрика.ОбработатьОшибку("СинхронизироватьИзСервисаЛогистика", ИнформацияОбОшибке(), Ссылка);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	КонецПопытки;
	
	Если ДанныеОрганизации.Количество() = 1 Тогда 
		
		ИсточникЗаполнения = Неопределено;
		Если Не ЗначениеЗаполнено(Ссылка.ID) Или 
			(ЗначениеЗаполнено(Ссылка.ID) И ДанныеОрганизации[0].Получить("diadocBoxId") = Ссылка.ID) Тогда 
			ИсточникЗаполнения = ДанныеОрганизации[0];			
		КонецЕсли;
		
	Иначе
		
		ИсточникЗаполнения = Неопределено;
		Для Каждого ОрганизацияДД Из ДанныеОрганизации Цикл 
			
			Если Не ЗначениеЗаполнено(Ссылка.ID) Или ОрганизацияДД.Получить("diadocBoxId") = Ссылка.ID Тогда 
				ИсточникЗаполнения = ОрганизацияДД;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Если ИсточникЗаполнения = Неопределено Тогда
		ТекстОшибки = "Организация с ИНН-КПП: " + Ссылка.ИНН + "-" + Ссылка.КПП + " не найдена в сервисе Логистика с boxId: " + Ссылка.ID;
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ID 					= ИсточникЗаполнения.Получить("diadocBoxId");
	ИдентификаторУчастникаЭДО = ИсточникЗаполнения.Получить("fnsParticipantId");
	
	ЕстьВСервисеЛогистика = ИсточникЗаполнения.Получить("isLogistics");
	Автодружба_raw 		= ИсточникЗаполнения.Получить("autoRelationMode");
	Автодружба 			= НРег(Автодружба_raw) = "enabled";               
	
	ПродуктивТрн_raw 	= ИсточникЗаполнения.Получить("transportationsSettings").Получить("workMode");
	ПродуктивТрн 		= НРег(ПродуктивТрн_raw) = "production";
	
	ПродуктивЭпл_raw 	= ИсточникЗаполнения.Получить("eplsSettings").Получить("workMode");
	ПродуктивЭпл 		= НРег(ПродуктивЭпл_raw) = "production";
	
	Попытка
		ДанныеОрганизации = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ПолучитьСведенияОСобственнойОрганизации(Ссылка);
		Если ДанныеОрганизации <> Неопределено Тогда
			Для Каждого ТекущаяСтрока Из ДанныеОрганизации Цикл
				Если ТекущаяСтрока.Получить("diadocBoxId") <> ID Тогда
					Продолжить;
				КонецЕсли;
				
				DirectoryId = ТекущаяСтрока.Получить("personsDirectoryId");
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Заполнение personsDirectoryId в организации", УровеньЖурналаРегистрации.Ошибка,, Ссылка, ТекстОшибки);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Истина);
	Записать();
	
	// Получим настройки организации
	Если ЕстьВСервисеЛогистика Тогда
		ПолучитьНастройкиОрганизации();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьНастройкиОрганизации()
	
	Попытка
		
		ДанныеОрганизации = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ПолучитьНастройкиОрганизации(Ссылка);
		
		Если ДанныеОрганизации = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		РазрешитьВодителямВноситьПоказанияГСМ = ДанныеОрганизации.driverPermissions.canEditFuelReadings;
		
		НастройкаРазрешения = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.РазрешитьВодителямВноситьПоказанияГСМ;
		
		Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(Ссылка, НастройкаРазрешения, РазрешитьВодителямВноситьПоказанияГСМ);
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("СинхронизироватьИзСервисаЛогистика", ИнформацияОбОшибке(), Ссылка);
		ВызватьИсключение ОписаниеОшибки();
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ФильтрПоИнфоПолямЗагружатьБезКлючей = Истина;
	
КонецПроцедуры
