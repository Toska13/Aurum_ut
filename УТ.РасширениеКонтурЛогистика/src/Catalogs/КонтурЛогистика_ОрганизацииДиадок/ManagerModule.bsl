Процедура НайтиИЗаполнитьСвязныеОрганизацииДляОрганизацииДиадок(МассивОрганизацийДД) Экспорт

	ТаблицаСоответствий = КонтурЛогистика_ОбщегоНазначенияСервер.СоответствиеОрганизацииУСОрганизациямДД(МассивОрганизацийДД);
	
	Если Не ТаблицаСоответствий = Неопределено Тогда 
		
		Для Каждого ОрганизацияДД Из МассивОрганизацийДД Цикл 
			
			ОбновитьСвязныеОбъектыПоОрганизации(ОрганизацияДД, ТаблицаСоответствий);
			
		КонецЦикла;	
		
	КонецЕсли;

КонецПроцедуры

// Загружать документ по фильтру инфо полей
//
// Параметры:
//  Организация - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - организация по которой применяется фильтр.
//  ИнфоПоля 	- Соответствие	 - данные инфо полей в соответствий, где ключ - имя поля, значение - значение инфо поля.
// 
// Возвращаемое значение:
//  Булево - признак, что требуется загрузить документ.
//
Функция ЗагружатьДокументПоФильтруИнфоПолей(Организация, ИнфоПоля) Экспорт
	
	// Если нет фильтра, то ничего не делаем
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьФильтрПоИнфоПолям(Организация) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Нет инфо полей = загружать, если уставновлен признак
	Если ИнфоПоля.Количество() = 0 И Организация.ФильтрПоИнфоПолямЗагружатьБезКлючей Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Организация.ФильтрПоИнфоПолямКодом Тогда
		
		// Попытаемся перегнать соответствия в структуру, так как в ПовтИсп можно использовать только примитивные типы
		Попытка
			ИнфоПоляСтруктура = Новый Структура;
			Для Каждого ТекущийЭлемент Из ИнфоПоля Цикл
				ИнфоПоляСтруктура.Вставить(ТекущийЭлемент.Ключ, ТекущийЭлемент.Значение);
			КонецЦикла;
		Исключение
			ИнфоПоляСтруктура = Новый Структура;
		КонецПопытки;
		
		// Вычислим условие
		Если ИнфоПоляСтруктура.Количество() = 0 Тогда
			// Так как не все значения можно перегнать в структуру, то оставляем соответствие
			Возврат ЗагружатьДокументПоФильтруВыраженияВычисления(Организация, ИнфоПоля);
		Иначе
			Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗагружатьДокументПоФильтруВыраженияВычисления(Организация, ИнфоПоляСтруктура);
		КонецЕсли;
		
	Иначе
		
		// Вычислим по таблице ФильтрПоИнфоПолям
		ОжидаемыеЗначенияИнфоПолей = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьОжидаемыеЗначенияИнфоПолей(Организация);
		
		Для Каждого ТекущееОжидаемоеИнфоПоле Из ОжидаемыеЗначенияИнфоПолей Цикл
			
			ЗначениеВходногоИнфоПоля = ИнфоПоля.Получить(ТекущееОжидаемоеИнфоПоле.Ключ);
			Если ЗначениеВходногоИнфоПоля = Неопределено Тогда
				// Не нашли во входящих. Должны сработать все условия
				Возврат Ложь;
			КонецЕсли;
			
			Если ЗначениеВходногоИнфоПоля = ТекущееОжидаемоеИнфоПоле.Значение Тогда
				Продолжить;
			Иначе
				// Не совпало. Должны сработать все условия
				Возврат Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		// Все условия по фильтру выполнены
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

// Есть фильтр по инфо полям
//
// Параметры:
//  Организация	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - органиазция
// 
// Возвращаемое значение:
//  Булево - признак наличия фильтра
//
Функция ЕстьФильтрПоИнфоПолям(Организация) Экспорт
	
	Если Организация.ФильтрПоИнфоПолямКодом И ЗначениеЗаполнено(Организация.ФильтрПоИнфоПолямВыражениеВычисления) Тогда
		Возврат Истина;
	ИначеЕсли Не Организация.ФильтрПоИнфоПолямКодом И Организация.ФильтрПоИнфоПолям.Количество() <> 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Получить ожидаемые значения инфо полей
//
// Параметры:
//  Организация	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - органиазция
// 
// Возвращаемое значение:
//  Соответствие - значения инфо полей, которые мы ожидаем
//
Функция ПолучитьОжидаемыеЗначенияИнфоПолей(Организация) Экспорт
	
	ПолучитьОжидаемыеЗначенияИнфоПолей = Новый Соответствие;
	
	Для Каждого ТекущаяСтрока Из Организация.ФильтрПоИнфоПолям Цикл
		
		Если ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда
			
			Если Найти(ТекущаяСтрока.ВыражениеВычисленияСтрокаНеогр, "РезультатВычисления") Тогда
				РезультатВычисления = Неопределено;
				Выполнить(ТекущаяСтрока.ВыражениеВычисленияСтрокаНеогр);
				ОжидаемоеЗначениеИнфоПоля = РезультатВычисления;
			Иначе
				ОжидаемоеЗначениеИнфоПоля = Вычислить(ТекущаяСтрока.ВыражениеВычисленияСтрокаНеогр);
			КонецЕсли;
			
		ИначеЕсли ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначениеОбщейНастройки Тогда
			
			ОжидаемоеЗначениеИнфоПоля = ТекущаяСтрока.ВыражениеВычисления.Значение;
			
		ИначеЕсли ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение Тогда
			
			ОжидаемоеЗначениеИнфоПоля = ТекущаяСтрока.ВыражениеВычисления;
			
		Иначе
			// Не доступный метод, не учитываем
			Продолжить;
		КонецЕсли;
		
		ПолучитьОжидаемыеЗначенияИнфоПолей.Вставить(ТекущаяСтрока.Ключ, Строка(ОжидаемоеЗначениеИнфоПоля));
		
	КонецЦикла;
	
	Возврат ПолучитьОжидаемыеЗначенияИнфоПолей;
	
КонецФункции

// Загружать дкумент по фильтру выражения вычисления
//
// Параметры:
//  Организация	 - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок	 - органиазция
//  ИнфоПоля	 - Соответствие, Структура	 - ключ - имя инфо коля, значение - значение инфо поля
// 
// Возвращаемое значение:
//  Булево - признак загружать дкумент по фильтру
//
Функция ЗагружатьДокументПоФильтруВыраженияВычисления(Организация, ИнфоПоля) Экспорт
	
	Если Найти(Организация.ФильтрПоИнфоПолямВыражениеВычисления, "РезультатВычисления") Тогда
		РезультатВычисления = Ложь;
		Выполнить(Организация.ФильтрПоИнфоПолямВыражениеВычисления);
		Возврат РезультатВычисления;
	Иначе
		Возврат Вычислить(Организация.ФильтрПоИнфоПолямВыражениеВычисления);
	КонецЕсли;
	
КонецФункции

Функция ИННИРолиНашихОрганизаций() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.ИНН КАК ИНН,
	|	МАКСИМУМ(КонтурЛогистика_ОрганизацииДиадок.Грузоотправитель) КАК Грузоотправитель,
	|	МАКСИМУМ(КонтурЛогистика_ОрганизацииДиадок.Перевозчик) КАК Перевозчик,
	|	МАКСИМУМ(КонтурЛогистика_ОрганизацииДиадок.Грузополучатель) КАК Грузополучатель,
	|	МАКСИМУМ(КонтурЛогистика_ОрганизацииДиадок.Медик) КАК Медик,
	|	МАКСИМУМ(КонтурЛогистика_ОрганизацииДиадок.ТехОсмотр) КАК ТехОсмотр
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ОрганизацииДиадок.ИНН";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("РежимОграниченияДоступаПоОрганизации")
		И ПараметрыСеанса.КонтурЛогистика_ОграничениеДоступаНаУровнеЗаписейВключено Тогда
		
		Параметры.Отбор.Вставить("Ссылка", ПараметрыСеанса.КонтурЛогистика_ДоступныеОрганизации);
	КонецЕсли;
	
КонецПроцедуры
