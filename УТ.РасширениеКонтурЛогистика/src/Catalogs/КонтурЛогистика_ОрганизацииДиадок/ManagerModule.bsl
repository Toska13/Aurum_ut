	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаГраницыСинхронизации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеГраницы, Выборка);
	КонецЕсли;
	
	Возврат ДанныеГраницы;
	
КонецФункции

#Область НастройкиОрганизацийРеквизитыОрганизации

Функция СинхронизироватьНастройкиОрганизации(ОрганизацияСсылка) Экспорт
	
	Результат = Новый Структура;
	
	Попытка
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияСсылка);
		Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
				"Не удалось получить настройку автоприглашения из сервиса Логистика. Нет авторизации в сервисе Логистика.");
			Возврат Результат;
		КонецЕсли;
		
		ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
		
		// Заполним свойство Sociability, регулирующее прием документов от контрагентов
		Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization(ОрганизацияСсылка);
		Если Ответ.Свойство("Sociability") Тогда
			ОрганизацияОбъект.Sociability = Ответ.Sociability;
			Результат.Вставить("Sociability", Ответ.Sociability);
		КонецЕсли;
		
		
		// Получим свойство автодружбы из Логистики
		МассивДанныхЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ПолучитьРеквизитыОрганизации(ОрганизацияСсылка);
		Если МассивДанныхЛогистика <> Неопределено И МассивДанныхЛогистика.Количество() > 0 Тогда
			
			ДанныеОрганизации = МассивДанныхЛогистика[0];
			
			Если ДанныеОрганизации.Получить("autoRelationMode") <> Неопределено Тогда
				АвтоДружба = ?(ДанныеОрганизации["autoRelationMode"] = "enabled", Истина, Ложь);
				ОрганизацияОбъект.Автодружба = АвтоДружба;
				Результат.Вставить("Автодружба", АвтоДружба);
			КонецЕсли;
			
		КонецЕсли;
		
		ОрганизацияОбъект.Записать();
		
	Исключение
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Ошибки при получение настроек Контрагентов: " + ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат Результат;
	
Конецфункции

#КонецОбласти

#КонецОбласти

Функция ПолучитьДоступныйФункционал(Организация) Экспорт
	
	ИспользуетсяТРН	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
		
	ДоступныйФункционал = Новый Структура;
	ДоступныйФункционал.Вставить("ТрН", ИспользуетсяТРН И ЕстьРольТрН(Организация));
	ДоступныйФункционал.Вставить("ПЛ", 	КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИспользуетсяПутевойЛист() И ЕстьРольПЛ(Организация));
	
	Возврат ДоступныйФункционал;
	
КонецФункции

Функция ЕстьРольТрН(Организация) Экспорт
	
	Возврат Организация.Грузоотправитель Или Организация.Перевозчик Или Организация.Грузополучатель;
	
КонецФункции

Функция ЕстьРольПЛ(Организация) Экспорт
	
	Возврат Организация.Оформитель Или Организация.Медик Или Организация.ТехОсмотр Или Организация.Одометр;
	
КонецФункции

Функция НайтиСоздатьПоИдентификаторуЭДО(ИдентификаторУчастникаЭДО) Экспорт
	
	НайденныйЭлемент = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИдентификаторУчастникаЭДО", ИдентификаторУчастникаЭДО);
	
	Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда 
		Возврат НайденныйЭлемент;
	Иначе
		
		НоваяОрга = СоздатьЭлемент();
		НоваяОрга.ИдентификаторУчастникаЭДО = ИдентификаторУчастникаЭДО;
		НоваяОрга.Наименование = "Организация " + ИдентификаторУчастникаЭДО;
		НоваяОрга.Записать();
		
		ВспомМассив = Новый Массив;
		ВспомМассив.Добавить(НоваяОрга.Ссылка);
		
		Попытка
		
			Справочники.КонтурЛогистика_ОрганизацииДиадок.АктуализироватьИзДиадока(ВспомМассив);
		
		Исключение
		   КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не удалось синхронизировать организацию Диадок с идентификатором " + ИдентификаторУчастникаЭДО + " Требуется опознать организацию");
		КонецПопытки;
		
		Возврат НоваяОрга.Ссылка;
		
	КонецЕсли;
	
	
КонецФункции

// ищем по всем комбинациям ИНН/КПП/ОГРН
Функция НайтиОрганизациюПоКлючевымРеквизитам(ИНН = Неопределено, КПП = Неопределено, ОГРН = Неопределено, ИдентификаторУчастникаЭДО = Неопределено) Экспорт
	
	ОрганизацияДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИНН) Или ЗначениеЗаполнено(ОГРН) Тогда
		
		Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(ИдентификаторУчастникаЭДО) Тогда
			
			НайденнаяОрганизацияИдЭДО = НайтиОрганизациюПоИННИдентификаторуЭДО(ИНН, ИдентификаторУчастникаЭДО);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяОрганизацияИдЭДО) Тогда
			
			ОрганизацияДиадок = НайденнаяОрганизацияИдЭДО;
			
		Иначе
			
			НайденнаяОрганизацияИНН_КПП = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
			Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) Тогда
				
				НайденнаяОрганизацияИНН_КПП = НайтиОрганизациюПоИННКПП(СокрЛП(ИНН), СокрЛП(КПП));
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденнаяОрганизацияИНН_КПП) Тогда
				
				ОрганизацияДиадок = НайденнаяОрганизацияИНН_КПП;
				
			Иначе
				
				НайденнаяОрганизацияИНН = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
				Если ЗначениеЗаполнено(ИНН) Тогда 
					НайденнаяОрганизацияИНН = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИНН", СокрЛП(ИНН));
				КонецЕсли;
				
				Если  ЗначениеЗаполнено(НайденнаяОрганизацияИНН) Тогда
					
					ОрганизацияДиадок = НайденнаяОрганизацияИНН;
					
				Иначе
					
					// последняя попытка - по ОГРН // в старом формате ПЛ 2023 может не прийти ИНН
					НайденнаяОрганизацияОГРН = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
					Если ЗначениеЗаполнено(ОГРН) И Не ЗначениеЗаполнено(ИНН) Тогда
						НайденнаяОрганизацияОГРН = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ОГРН", СокрЛП(ОГРН));
					КонецЕсли;
						
					Если ЗначениеЗаполнено(НайденнаяОрганизацияОГРН) Тогда
						ОрганизацияДиадок = НайденнаяОрганизацияОГРН;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;

КонецФункции

Функция НайтиОрганизациюПоИННКПП(ИНН, КПП)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.ИНН = &ИНН
	|	И КонтурЛогистика_ОрганизацииДиадок.КПП = &КПП";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
КонецФункции

Функция НайтиОрганизациюПоИННИдентификаторуЭДО(ИНН, ИдентификаторУчастникаЭДО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадок.ИНН = &ИНН
		|	И КонтурЛогистика_ОрганизацииДиадок.ИдентификаторУчастникаЭДО = &ИдентификаторУчастникаЭДО";
	
	Запрос.УстановитьПараметр("ИдентификаторУчастникаЭДО", ИдентификаторУчастникаЭДО);
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка; 
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
КонецФункции

Функция СписокОрганизацийПоИНН(ИНН) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|ГДЕ
		|	Не КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
		|	И КонтурЛогистика_ОрганизацииДиадок.Наш
		|	И КонтурЛогистика_ОрганизацииДиадок.ИНН = &ИНН";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
		
	тз = Запрос.Выполнить().Выгрузить();
	
	Если тз.Количество() = 0 Тогда
		
		МассивОрганизаций = Новый Массив;
		
	Иначе
			
		МассивОрганизаций = тз.ВыгрузитьКолонку("Ссылка");
		
	КонецЕсли;
	
	Возврат МассивОрганизаций;	
	
КонецФункции

Функция ЗаполнитьОрганизациюИзДанныхЛогистики(ДанныеОрганизации, ОрганизацияКЗаполнению) Экспорт
	
	ОрганизацияОбъект = ОрганизацияКЗаполнению.ПолучитьОбъект();
	
	Если ДанныеОрганизации.Получить("autoRelationMode") <> Неопределено Тогда
		ОрганизацияОбъект.Автодружба = ?(ДанныеОрганизации["autoRelationMode"] = "enabled", Истина, Ложь);
	КонецЕсли;
	
	ОрганизацияОбъект.Записать();
	
КонецФункции

