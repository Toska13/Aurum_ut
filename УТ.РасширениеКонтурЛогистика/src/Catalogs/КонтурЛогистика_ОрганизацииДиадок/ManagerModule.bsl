Процедура АктуализироватьИзДиадока(МассивОрганизаций) Экспорт 
	
	Для Каждого ОрганизацияДД Из МассивОрганизаций Цикл 
		
		Попытка
		
			ДанныеДД = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization(ОрганизацияДД);
			ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеДД, ОрганизацияДД);
						
		Исключение
			
			Сообщить("Неудача при вычитывании данных из Диадок по Организации: " + ОрганизацияДД + " - " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	ОбновитьСвязанныеОбъекты(МассивОрганизаций);
	
КонецПроцедуры

Процедура ОбновитьСвязанныеОбъекты(МассивИлиОрганизацияСсылка) Экспорт 
	
	ТаблицаСоответствий = КонтурЛогистика_ОбщегоНазначенияСервер.СоответствиеОрганизацииУСОрганизациямДД(МассивИлиОрганизацияСсылка);
	
	Если Не ТаблицаСоответствий = Неопределено Тогда
		
		Если ТипЗнч(МассивИлиОрганизацияСсылка) = Тип("Массив") Тогда 
			
			Для Каждого СтрокаОрганизации Из МассивИлиОрганизацияСсылка Цикл 
				
				ОбновитьСвязныеОбъектыПоОрганизации(СтрокаОрганизации, ТаблицаСоответствий);
				
			КонецЦикла;	
			
		Иначе
			
			ОбновитьСвязныеОбъектыПоОрганизации(МассивИлиОрганизацияСсылка, ТаблицаСоответствий);
			
		КонецЕсли;	
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьСвязныеОбъектыПоОрганизации(ОрганизацияСсылка, ТаблицаСоответствий) Экспорт 
	
	НужнаЗапись = Ложь;
	
	ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
	
	НайденныеСвязи = ТаблицаСоответствий.НайтиСтроки(Новый Структура("ОрганизацияДД", ОрганизацияОбъект.Ссылка));
	
	Для Каждого Связь Из НайденныеСвязи Цикл 
		
		// а что если в организации уже что-то есть в сязных объектах? проверим от дублей
		Если ОрганизацияОбъект.СвязанныеОбъекты.Количество() 
			И Не ОрганизацияОбъект.СвязанныеОбъекты.Найти(Связь.ОрганизацияУС, "СвязанныйОбъект") = Неопределено Тогда  
			Продолжить;
		КонецЕсли;	
		
		// добавляем в организацию ДД новый связный объект
		НовыйСвязныйОбъект = ОрганизацияОбъект.СвязанныеОбъекты.Добавить();
		НовыйСвязныйОбъект.СвязанныйОбъект = Связь.ОрганизацияУС;
		
		НужнаЗапись = Истина;
		
	КонецЦикла;		
	
	Если НужнаЗапись Тогда 
		ОрганизацияОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры	

Функция ЗаполнитьОрганизациюИзДанныхДиадока(Знач ДанныеОднойОрганизации, Знач ОрганизацияКЗаполнению = Неопределено, СинхронизироватьКонтрагентовОрганизации = Ложь) Экспорт
	
	// Найти организацию если не передана
	
	Если ОрганизацияКЗаполнению = Неопределено Тогда 
		
		ОрганизацияКЗаполнению = НайтиПоРеквизиту("OrgId", ДанныеОднойОрганизации.OrgId);
		Если Не ЗначениеЗаполнено(ОрганизацияКЗаполнению) Тогда 
			ОрганизацияОбъект = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
		Иначе
			ОрганизацияОбъект =  ОрганизацияКЗаполнению.ПолучитьОбъект();
		КонецЕсли;
		
	Иначе
		
		ОрганизацияОбъект =  ОрганизацияКЗаполнению.ПолучитьОбъект();
		
	КонецЕсли;
	
	Попытка
		// Заполнить поля
		ЗаполнитьПоляОрганизацииПоДаннымСервиса(ОрганизацияОбъект, ДанныеОднойОрганизации);
		
		ОрганизацияОбъект.Записать();
		
		// Не важно под какой организацией получаем данные
		ТочноеСовпадение = Ложь;
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
		Если ПараметрыСервиса.АвторизацияВыполнена Тогда
			ОрганизацияОбъект.СинхронизироватьИзСервисаЛогистика();
		КонецЕсли;
		
		СинхронизироватьПодразделения(ДанныеОднойОрганизации);
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗаполнитьОрганизациюИзДанныхДиадока", ИнформацияОбОшибке(), ОрганизацияОбъект.Ссылка);
		
		Если Не СинхронизироватьКонтрагентовОрганизации Тогда
			ВызватьИсключение;
		Иначе
			Сообщить(ИнформацияОбОшибке.Описание);	
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат ОрганизацияОбъект.Ссылка;
	
КонецФункции

Процедура ЗаполнитьПоляОрганизацииПоДаннымСервиса(ОрганизацияОбъект, ДанныеОднойОрганизации)
	
	Если ДанныеОднойОрганизации.Свойство("FnsParticipantId") Тогда 
		ОрганизацияОбъект.ИдентификаторУчастникаЭДО = ДанныеОднойОрганизации.FnsParticipantId;
	КонецЕсли;
	
	Если ДанныеОднойОрганизации.Свойство("Sociability") Тогда 
		ОрганизацияОбъект.Sociability = ДанныеОднойОрганизации.Sociability;
	КонецЕсли;
	
	ОрганизацияОбъект.НаименованиеОрганизацииПолное = ДанныеОднойОрганизации.FullName;
	Если ДанныеОднойОрганизации.Свойство("ShortName") Тогда 
		ОрганизацияОбъект.Наименование 				= ДанныеОднойОрганизации.ShortName;
	Иначе
		ОрганизацияОбъект.Наименование 				= ОрганизацияОбъект.НаименованиеОрганизацииПолное;
	КонецЕсли;
	
	ОрганизацияОбъект.ИНН 						= ДанныеОднойОрганизации.Inn;
	
	Если ДанныеОднойОрганизации.Свойство("Ogrn") Тогда 
		ОрганизацияОбъект.ОГРН 					= ДанныеОднойОрганизации.Ogrn;
	КонецЕсли;
	
	Если СтрДлина(ОрганизацияОбъект.ИНН) = 12 Тогда
		
		Если ЗначениеЗаполнено(ОрганизацияОбъект.ОГРН) Тогда
			ОрганизацияОбъект.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП;
		Иначе
			ОрганизацияОбъект.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо;
		КонецЕсли;
		
		ФИОМассив = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ОрганизацияОбъект.Наименование, " ");
		ОрганизацияОбъект.Фамилия = ФИОМассив[0];
		ОрганизацияОбъект.Имя = ФИОМассив[1];
		Если ФИОМассив.Количество() > 2 Тогда 
			ОрганизацияОбъект.Отчество = ФИОМассив[2];
		КонецЕсли;
		
	ИначеЕсли ДанныеОднойОрганизации.IsForeign = Истина Тогда 
		ОрганизацияОбъект.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо;
	Иначе 
		ОрганизацияОбъект.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
	КонецЕсли;
	
	Если ДанныеОднойОрганизации.Свойство("Kpp") Тогда 
		ОрганизацияОбъект.КПП 					= ДанныеОднойОрганизации.Kpp;
	КонецЕсли;
	
	ОрганизацияОбъект.Тестовая 					= ДанныеОднойОрганизации.IsTest;
	ОрганизацияОбъект.OrgId 					= ДанныеОднойОрганизации.OrgId;
	
	Если ДанныеОднойОрганизации.Boxes.Количество() > 0 Тогда 
		ОрганизацияОбъект.ID 					= ДанныеОднойОрганизации.Boxes[0].BoxIdGuid;
	КонецЕсли;
	
	Если ДанныеОднойОрганизации.Свойство("Address") Тогда 
		Если ДанныеОднойОрганизации.Address.Свойство("RussianAddress") И ТипЗнч(ДанныеОднойОрганизации.Address.RussianAddress) =  Тип("Структура") Тогда
			
			Для Каждого ЭлементАдреса Из ДанныеОднойОрганизации.Address.RussianAddress Цикл 
				
				Если ЭлементАдреса.Ключ = "ZipCode" 
					ИЛИ ЭлементАдреса.Ключ = "City" 
					ИЛИ ЭлементАдреса.Ключ = "Region" 
					ИЛИ ЭлементАдреса.Ключ = "Street" 
					ИЛИ ЭлементАдреса.Ключ = "Locality" 
					ИЛИ ЭлементАдреса.Ключ = "Territory" 
					ИЛИ ЭлементАдреса.Ключ = "Apartment" 
					ИЛИ ЭлементАдреса.Ключ = "Block" 
					ИЛИ ЭлементАдреса.Ключ = "Building" 
					Тогда
					
					ОрганизацияОбъект["Адрес" + ЭлементАдреса.Ключ] = ЭлементАдреса.Значение;		
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ДанныеОднойОрганизации.Address.Свойство("ForeignAddress") И ТипЗнч(ДанныеОднойОрганизации.Address.ForeignAddress) =  Тип("Структура") Тогда
			
			Для Каждого ЭлементАдреса Из ДанныеОднойОрганизации.Address.ForeignAddress Цикл 
				
				Если ЭлементАдреса.Ключ = "Address" 
					ИЛИ ЭлементАдреса.Ключ = "Country" 
					Тогда
					
					ОрганизацияОбъект["ИнАдрес" + ЭлементАдреса.Ключ] = ЭлементАдреса.Значение;		
					
				КонецЕсли;
				
			КонецЦикла;
			
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьПодразделения(ДанныеОднойОрганизации)

	Справочники.КонтурЛогистика_ПодразделенияДиадок.СинхронизироватьПоОрганизации(ДанныеОднойОрганизации);

КонецПроцедуры

Процедура СинхронизироватьКонтрагентовОрганизации(ОрганизацияСсылка, ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	Попытка
		
		ПараметрыУстановкиМодулей = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПараметрыУстановкиМодулей();
		
		ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
		
		ОрганизацияОбъект.Контрагенты.Очистить();
		
		ПоследнийIndexKey = Неопределено;
		ВычитаноКонтрагентовВИтерации = 0;
		КоличествоУдовлетворяетЗапросу = 10000;
		ВсегоВычитывать = 10000;
		ВсегоКонтрагентов = 0;
						
		Счетчик = 1;
		Пока ВычитаноКонтрагентовВИтерации < КоличествоУдовлетворяетЗапросу Цикл
			
			ПорцияДанныеКонтрагентовОрганизацииДД = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetCounteragents(ОрганизацияСсылка, ПоследнийIndexKey);
			ВычитаноКонтрагентовВИтерации = ПорцияДанныеКонтрагентовОрганизацииДД.Counteragents.Количество();
			КоличествоУдовлетворяетЗапросу = ПорцияДанныеКонтрагентовОрганизацииДД.TotalCount;
			
			Если Счетчик = 1 Тогда
				ВсегоКонтрагентов = ПорцияДанныеКонтрагентовОрганизацииДД.TotalCount;		
			КонецЕсли;
			
			Если ВычитаноКонтрагентовВИтерации > 0 Тогда 
				
				Если Счетчик = ВсегоВычитывать Тогда
					Прервать;	
				КонецЕсли;
				
				ПоследнийВычитанный = ПорцияДанныеКонтрагентовОрганизацииДД.Counteragents[ВычитаноКонтрагентовВИтерации - 1]; 
				ПоследнийIndexKey = ПоследнийВычитанный.IndexKey;
				
				Для Каждого Строка Из ПорцияДанныеКонтрагентовОрганизацииДД.Counteragents Цикл
					
					СтатусСвязи = Перечисления.КонтурЛогистика_СтатусыКонтрагентов[Строка.CurrentStatus];
					// неочевидна необходимость фильтровать по Статусу связи. Пропускать разорванные нами/ими связи?
					
					// ликвидированные организации загружать не будем
					Если Строка.Organization.Свойство("LiquidationDate") И ЗначениеЗаполнено(Строка.Organization.LiquidationDate) Тогда
						Счетчик = Счетчик + 1;
						Продолжить;
					КонецЕсли;
					
					// создадим организации-контрагентов
					КонтрагентСсылка = ЗаполнитьОрганизациюИзДанныхДиадока(Строка.Organization,, Истина);
					
					Если ПараметрыУстановкиМодулей.Диадок.МодульУстановлен
						И КонтрагентСсылка.СвязанныеОбъекты.Количество() = 0 Тогда
						
						// сопоставим контрагента, если найдем в других модулях
						СвязаныеОбъектыКонтрагентовИзМодулейКонтура(КонтрагентСсылка, ПараметрыУстановкиМодулей);
					КонецЕсли;
					
					// привяжем к Организации
					СтрокаКонтрагента = ОрганизацияОбъект.Контрагенты.Добавить();
					СтрокаКонтрагента.Контрагент = КонтрагентСсылка;
					СтрокаКонтрагента.Статус = СтатусСвязи;
					
					Если ПараметрыФоновогоЗадания <> Неопределено И ПараметрыФоновогоЗадания.КолвоОрганизаций = 1 Тогда 
						Текст = Формат(Счетчик, "ЧГ=0") + ". " + Строка(КонтрагентСсылка);
						КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
						ПараметрыФоновогоЗадания.Результат.Прогресс = Окр(Счетчик / ?(ВсегоВычитывать <= ВсегоКонтрагентов, ВсегоВычитывать, ВсегоКонтрагентов) * 100);
						ПоместитьВоВременноеХранилище(ПараметрыФоновогоЗадания.Результат, ПараметрыФоновогоЗадания.АдресРезультата);													
					КонецЕсли;
										
					Если Счетчик = ВсегоВычитывать Тогда
						Прервать;	
					КонецЕсли;
					
					Счетчик = Счетчик + 1;
									
				КонецЦикла;			
				
			Иначе
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОрганизацияОбъект.Записать();
				
	Исключение
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Ошибки при вычитывании из Диадока Контрагентов: " + ОписаниеОшибки());	
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СвязаныеОбъектыКонтрагентовИзМодулейКонтура(КонтрагентСсылка, ПараметрыУстановкиМодулей)
	
	СвязаныыеОбъектыКонтрагента = ПолучитьСвязаныыеОбъектыКонтрагентовИзМодулейКонтура(
		ПараметрыУстановкиМодулей.Диадок, КонтрагентСсылка.ID);
	
	Если СвязаныыеОбъектыКонтрагента.Количество() <> 0 Тогда
		
		КонтрагентОбъект = КонтрагентСсылка.ПолучитьОбъект();
		
		Для Каждого ТекущийСвязанныйОбъект Из СвязаныыеОбъектыКонтрагента Цикл
			НоваяСтрока = КонтрагентОбъект.СвязанныеОбъекты.Добавить();
			НоваяСтрока.СвязанныйОбъект = ТекущийСвязанныйОбъект;
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		КонтрагентОбъект.Записать();
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСвязаныыеОбъектыКонтрагентовИзМодулейКонтура(НастройкиДиадок, boxID)
	
	Результат = Новый Массив;
	
	АдресЯщикаДиадок = КонтурЛогистика_API_Диадок.ИдентификаторВАдресЯщика(boxID);
	
	Если НастройкиДиадок.ИспользоватьТиповуюПодсистему1С Тогда
		
		// Получи свойство по имени настройки
		Если Не НастройкиДиадок.Свойство("СвойствоНастройкиКонтрагента") Тогда
			ИмяСвойства = "ДДКонтр_";
			Если НастройкиДиадок.ЭтоУФ Тогда
				СвойствоНастройкиКонтрагента = ПланыВидовХарактеристик["ДополнительныеРеквизитыИСведения"].НайтиПоНаименованию(
					ИмяСвойства, Истина);
			Иначе
				СвойствоНастройкиКонтрагента = ПланыВидовХарактеристик["СвойстваОбъектов"].НайтиПоНаименованию(
					ИмяСвойства, Истина);
			КонецЕсли;
			НастройкиДиадок.Вставить("СвойствоНастройкиКонтрагента", СвойствоНастройкиКонтрагента);
			
			Если СвойствоНастройкиКонтрагента = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		// Получим контрагентов
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство", НастройкиДиадок.СвойствоНастройкиКонтрагента);
		Запрос.УстановитьПараметр("Значение", АдресЯщикаДиадок);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Свойство = &Свойство
		|	И ЗначенияСвойствОбъектов.Значение = &Значение";
		
		Если НастройкиДиадок.ЭтоУФ Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗначенияСвойствОбъектов", "ДополнительныеСведения");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Объект) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.Добавить(Выборка.Объект);
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИмяСправочника", "Контрагенты");
		Запрос.УстановитьПараметр("ID", АдресЯщикаДиадок);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Диадок_ЮрФизЛица.СвязанныйСправочник1 КАК СвязанныйСправочник1,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник2 КАК СвязанныйСправочник2,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник3 КАК СвязанныйСправочник3
		|ИЗ
		|	Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
		|ГДЕ
		|	Диадок_ЮрФизЛица.ИмяСправочника = &ИмяСправочника
		|	И Диадок_ЮрФизЛица.ID = &ID";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник1) Тогда
				Результат.Добавить(Выборка.СвязанныйСправочник1);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник2) Тогда
				Результат.Добавить(Выборка.СвязанныйСправочник2);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник3) Тогда
				Результат.Добавить(Выборка.СвязанныйСправочник3);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТекстПодробногоОписанияОшибки(ОрганизацияСсылка, ПредставлениеТиповДокумента)
	
	ОписаниеОшибки = "";
	
	Если ЗначениеЗаполнено(ПредставлениеТиповДокумента) Тогда 
	
		СтрокаШаблона = НСтр("ru = 'Для организации ""%1"" (ИНН - %2, BoxId - %3) не настроены типы документов ""%4"". 
                              |Прошу включить эти типы в сервисе Диадок.'");
			
		ОписаниеОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(СтрокаШаблона, 
							ОрганизацияСсылка.НаименованиеОрганизацииПолное, 
							ОрганизацияСсылка.КПП, 
							ОрганизацияСсылка.ID, 
							ПредставлениеТиповДокумента);
						
	КонецЕсли;
	
	Возврат ОписаниеОшибки;
	
КонецФункции	

Функция ПолучитьТекстЯчейкиОбласти(Область, Строка, Колонка)
	
	Возврат Строка(Область.ПолучитьОбласть("R" + Формат(Строка, "ЧГ=0") + "C" + Формат(Колонка, "ЧГ=0")).ТекущаяОбласть.Текст);
	
КонецФункции

Функция ПолучитьОписаниеКлючейПоиска() Экспорт
	
	// Поиск организации осуществляется по:
	// 1. ИНН + КПП
	// 2. ИНН
	// 3. ОГРН
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	КлючиПоиска = Новый Массив;
		
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "ИНН,КПП", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "ИНН", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "ОГРН", ШаблонСтрокиПоиска);
	
	Возврат КлючиПоиска;
	
КонецФункции	

Функция ТекстОшибкиНеЗаполненыКлючевыеРеквизиты() Экспорт
	
	ТекстОшибки = "Ошибка при поиске Организации Диадок. Не заполнен один из ключевых реквизитов в одном из вариантов поиска: 
					|1. ИНН + КПП 
					|2. ИНН
					|3. ОГРН";
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция КонвертироватьВычисленноеЗначениеВОбъектЛогистики(ВычисленныеРеквизиты, ВычисленноеЗначение) Экспорт 
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
		
	ОписаниеСтрокиИНН = ВычисленныеРеквизиты.Найти("ИНН", "Реквизит");
	ОписаниеСтрокиКПП = ВычисленныеРеквизиты.Найти("КПП", "Реквизит");
	
	Если ОписаниеСтрокиИНН = Неопределено Тогда 
		
		Результат.ОписаниеОшибки = НСтр("ru = 'Неудача при конвертации значения: нет необходимого для создания организации реквизита ИНН.'");
		
		Возврат Результат;
		
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ОписаниеСтрокиИНН.Ошибка) Тогда
		
		Результат.ОписаниеОшибки = ОписаниеСтрокиИНН.Ошибка;
		
		Возврат Результат;
		
	КонецЕсли;	
		
	ИНН = ОписаниеСтрокиИНН.Значение;
	КПП = Неопределено;
	
	Если Не ОписаниеСтрокиКПП = Неопределено И ЗначениеЗаполнено(ОписаниеСтрокиКПП.Значение) Тогда
		
		КПП = ОписаниеСтрокиКПП.Значение;
		
	КонецЕсли;
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииЛюбойОрганизации();
	ПараметрыСервиса = КонтурЛогистика_API_Диадок.ЛогистикаПараметрыСервиса_Диадок(ДанныеАутентификации.DiadocBoxId);
	ДанныеДД = ДанныеОрганизацийДиадока(ПараметрыСервиса, ИНН, КПП);
	
	Если ДанныеДД = Неопределено И КПП <> Неопределено Тогда
		// Если есть КПП и не нашли по ИНН-КПП, то попробуем найти по ИНН
		ДанныеДД = ДанныеОрганизацийДиадока(ПараметрыСервиса, ИНН);
	КонецЕсли;
	
	Если ДанныеДД = Неопределено Тогда
		
		// дадим кастомное создание Организации, если не нашли в ДД
		ОрганизацияСсылка = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
								"Конвертация_СоздатьОрганизациюДиадокИзВычисленныхРеквизитов",
								Ложь,
								Новый Структура("ВычисленныеРеквизиты, ВычисленноеЗначение", ВычисленныеРеквизиты, ВычисленноеЗначение));
								
		Если ОрганизацияСсылка = Неопределено Тогда 
			
			НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
			НоваяОрганизация.ИНН 			= ИНН;
			НоваяОрганизация.КПП 			= КПП;
			НоваяОрганизация.ТипЛица 		= Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
			НоваяОрганизация.Наименование 	= "Неизвестная организация, ИНН - " + ИНН;
			НоваяОрганизация.Записать();
			
			// Не важно под какой организацией получаем данные
			ТочноеСовпадение = Ложь;
			ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
			Если ПараметрыСервиса.АвторизацияВыполнена Тогда
				НоваяОрганизация.СинхронизироватьИзСервисаЛогистика();
			КонецЕсли;
			
			ОрганизацияСсылка = НоваяОрганизация.Ссылка;
			
		КонецЕсли;
		
	Иначе
		
		ОрганизацияСсылка = ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеДД);
		
	КонецЕсли;
	
	Если ВычисленныеРеквизиты.Количество() <> 0 Тогда
		
		// Заполним вычисленные реквизиты при конвертации
		ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
		
		Для Каждого ВычисленныйРеквизит Из ВычисленныеРеквизиты Цикл
			Если Не ЗначениеЗаполнено(ВычисленныйРеквизит.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			// ИНН и КПП заполнили из данных Диадока
			Если ДанныеДД <> Неопределено
				И (ВычисленныйРеквизит.Реквизит = "ИНН" Или ВычисленныйРеквизит.Реквизит = "КПП") Тогда
				
				Продолжить;
			КонецЕсли;
			
			ОрганизацияОбъект[ВычисленныйРеквизит.Реквизит] = ВычисленныйРеквизит.Значение;
		КонецЦикла;
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьВычисленноеЗначениеВСвязныеОбъектыЛогистики(ОрганизацияОбъект, ВычисленноеЗначение);
		
	Иначе
		
		КонтурЛогистика_КонвертацияСервер.ДобавитьВычисленноеЗначениеВСвязныеОбъектыЛогистики(ОрганизацияОбъект, ВычисленноеЗначение, Истина);
		
	КонецЕсли;
	
	Результат.Успешно = Истина;
	Результат.Вставить("Значение", ОрганизацияСсылка);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеОрганизацийДиадока(ПараметрыСервиса, Знач ИНН, Знач КПП = Неопределено)
	
	Попытка
		
		ДанныеОрганизаций = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().АПИ_GetOrganizationsByInnKpp(ПараметрыСервиса, ИНН, КПП);
		
		Если ТипЗнч(ДанныеОрганизаций) <> Тип("Структура") И Не ДанныеОрганизаций.Свойство("Organizations") Тогда
			
			ДанныеДД = Неопределено;
			
		ИначеЕсли ДанныеОрганизаций.Organizations.Количество() = 1 Тогда
			
			ДанныеДД = ДанныеОрганизаций.Organizations[0];
			
		ИначеЕсли ДанныеОрганизаций.Organizations.Количество() = 0 Тогда
			
			ДанныеДД = Неопределено;
			
		Иначе
			
			ДанныеДД = Неопределено;
			
			// Приоритетно берем организацию не из роуминга
			Для Каждого ТекущаяСтрока Из ДанныеОрганизаций.Organizations Цикл
				Если ДанныеДД = Неопределено Тогда
					ДанныеДД = ТекущаяСтрока;
					Продолжить;
				КонецЕсли;
				
				Если Не ТекущаяСтрока.IsRoaming Тогда
					ДанныеДД = ТекущаяСтрока;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	Исключение
		
		ДанныеДД = Неопределено;
		
	КонецПопытки;
	
	Возврат ДанныеДД;
	
КонецФункции

#Область НастройкиОрганизаций

Процедура СконвертироватьНастройкиИзСтарыхВНовые() Экспорт
	
	// простые
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадокУдалитьНастройки.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ОрганизацииДиадокУдалитьНастройки.НомерСтроки КАК НомерСтроки,
	|	КонтурЛогистика_ОрганизацииДиадокУдалитьНастройки.Настройка КАК Настройка,
	|	КонтурЛогистика_ОрганизацииДиадокУдалитьНастройки.ЗначениеНастройки КАК ЗначениеНастройки
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок.УдалитьНастройки КАК КонтурЛогистика_ОрганизацииДиадокУдалитьНастройки";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Настройка <> Неопределено
			И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			
			УстановитьНастройку(Выборка.Ссылка, Выборка.Настройка, Выборка.ЗначениеНастройки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// служебные
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ОрганизацииДиадокСлужебные.Ссылка КАК Ссылка,
	               |	КонтурЛогистика_ОрганизацииДиадокСлужебные.НомерСтроки КАК НомерСтроки,
	               |	КонтурЛогистика_ОрганизацииДиадокСлужебные.Настройка КАК Настройка,
	               |	КонтурЛогистика_ОрганизацииДиадокСлужебные.ЗначениеНастройки КАК ЗначениеНастройки
	               |ИЗ
	               |	Справочник.КонтурЛогистика_ОрганизацииДиадок.УдалитьСлужебные КАК КонтурЛогистика_ОрганизацииДиадокСлужебные";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		УстановитьСлужебнуюНастройку(Выборка.Ссылка, Выборка.Настройка, Выборка.ЗначениеНастройки)
		
	КонецЦикла;
	
	// отметим успешный перенос
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок КАК ОрганизацияДиадок
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций";

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл

		УстановитьСлужебнуюНастройку(Выборка.ОрганизацияДиадок, "ПереносНаНовыеНастройкиВыполнен", Истина)

	КонецЦикла;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

Процедура СконвертироватьНастройкуВВидеРеквизитаИзСтаройВНовую(Настройка) Экспорт
	
	Если Настройка = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ОрганизацииДиадок.УдалитьAfterIndexKey КАК УдалитьAfterIndexKey,
			|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
			|ГДЕ
			|	КонтурЛогистика_ОрганизацииДиадок.УдалитьAfterIndexKey <> &УдалитьAfterIndexKey";
		
		Запрос.УстановитьПараметр("УдалитьAfterIndexKey", "");
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			УстановитьНастройку(ВыборкаДетальныеЗаписи.Ссылка, Настройка, ВыборкаДетальныеЗаписи.УдалитьAfterIndexKey);
		КонецЦикла;
			
	КонецЕсли;
	
	Если Настройка = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ОрганизацииДиадок.УдалитьДатаГраницыСинхронизации КАК УдалитьДатаГраницыСинхронизации,
			|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
			|ГДЕ
			|	КонтурЛогистика_ОрганизацииДиадок.УдалитьДатаГраницыСинхронизации <> &УдалитьДатаГраницыСинхронизации";
		
		Запрос.УстановитьПараметр("УдалитьДатаГраницыСинхронизации", Дата(1, 1, 1));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			УстановитьНастройку(ВыборкаДетальныеЗаписи.Ссылка, Настройка, ВыборкаДетальныеЗаписи.УдалитьДатаГраницыСинхронизации);
		КонецЦикла;
			
	КонецЕсли;
		
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

Функция ПереносНастроекВыполнен(Настройка = Неопределено) Экспорт

	Запрос = Новый Запрос;
	
	// если есть хоть одна запись - значит настройки перенесены
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_НастройкиОрганизацийСлужебные.ЗначениеНастройки КАК ЗначениеНастройки
	               |ИЗ
	               |	РегистрСведений.КонтурЛогистика_НастройкиОрганизацийСлужебные КАК КонтурЛогистика_НастройкиОрганизацийСлужебные
	               |ГДЕ
	               |	КонтурЛогистика_НастройкиОрганизацийСлужебные.Настройка = &Настройка";
	
	Если ЗначениеЗаполнено(Настройка) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_НастройкиОрганизацийСлужебные", "КонтурЛогистика_НастройкиОрганизаций");
		Запрос.УстановитьПараметр("Настройка", Настройка);				
	Иначе
		Запрос.УстановитьПараметр("Настройка", "ПереносНаНовыеНастройкиВыполнен");				
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();

КонецФункции

Функция ЗначениеНастройки(ОрганизацияДиадокСсылка, НастройкаОрганизации) Экспорт 
	
	// контроль переноса существующих настроек в новые
	ПереносНаНовыеНастройкиВыполнен = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПереносНастроекОрганизацииВыполнен();
	Если ПереносНаНовыеНастройкиВыполнен <> Истина Тогда 
		СконвертироватьНастройкиИзСтарыхВНовые();
	КонецЕсли;
	Если НастройкаОрганизации = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок
		Или НастройкаОрганизации = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата Тогда
		ПереносНаНовыеНастройкиВыполнен = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПереносНастроекОрганизацииВыполнен(НастройкаОрганизации);
		Если ПереносНаНовыеНастройкиВыполнен <> Истина Тогда 
			СконвертироватьНастройкуВВидеРеквизитаИзСтаройВНовую(НастройкаОрганизации);
		КонецЕсли;	
	КонецЕсли;
	
	// получение настройки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки КАК ЗначениеНастройки
	               |ИЗ
	               |	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
	               |ГДЕ
	               |	КонтурЛогистика_НастройкиОрганизаций.Настройка = &Настройка
	               |	И КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок = &ОрганизацияДиадок";
	
	Запрос.УстановитьПараметр("ОрганизацияДиадок", ОрганизацияДиадокСсылка);
	Запрос.УстановитьПараметр("Настройка", НастройкаОрганизации);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ЗначениеНастройки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЗначениеСлужебнойНастройки(ОрганизацияДиадокСсылка, НастройкаОрганизации) Экспорт 
	
	// контроль переноса существующих настроек в новые
	ПереносНаНовыеНастройкиВыполнен = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПереносНастроекОрганизацииВыполнен();
	Если ПереносНаНовыеНастройкиВыполнен <> Истина Тогда 
		СконвертироватьНастройкиИзСтарыхВНовые();
	КонецЕсли;
	
	// получение настройки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_НастройкиОрганизацийСлужебные.ЗначениеНастройки КАК ЗначениеНастройки
	               |ИЗ
	               |	РегистрСведений.КонтурЛогистика_НастройкиОрганизацийСлужебные КАК КонтурЛогистика_НастройкиОрганизацийСлужебные
	               |ГДЕ
	               |	КонтурЛогистика_НастройкиОрганизацийСлужебные.Настройка = &Настройка
	               |	И КонтурЛогистика_НастройкиОрганизацийСлужебные.ОрганизацияДиадок = &ОрганизацияДиадок";
	
	Запрос.УстановитьПараметр("ОрганизацияДиадок", ОрганизацияДиадокСсылка);
	Запрос.УстановитьПараметр("Настройка", НастройкаОрганизации);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ЗначениеНастройки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура УстановитьНастройку(ОрганизацияДиадокСсылка, НастройкаОрганизации, УстанавливаемоеЗначение) Экспорт 
	
	МенеджерЗаписи = РегистрыСведений.КонтурЛогистика_НастройкиОрганизаций.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ОрганизацияДиадок = ОрганизацияДиадокСсылка;
	МенеджерЗаписи.Настройка = НастройкаОрганизации;
	МенеджерЗаписи.ЗначениеНастройки = УстанавливаемоеЗначение;
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры

Процедура УстановитьСлужебнуюНастройку(ОрганизацияДиадокСсылка, НастройкаОрганизации, УстанавливаемоеЗначение) Экспорт 
	
