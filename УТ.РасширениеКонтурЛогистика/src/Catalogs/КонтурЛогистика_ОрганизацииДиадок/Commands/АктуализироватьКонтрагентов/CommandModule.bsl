&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура("МассивОрганизаций", ПараметрКоманды);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Обновление таблицы контрагентов может занять продолжительное время. Вы АБСОЛЮТНО уверены?",
			РежимДиалогаВопрос.ДаНет,
			,
			,
			ЭтотОбъект,
			"КомандаПодтверждена",
			ПараметрыКоманды);	 	
									
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтверждена(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ПараметрыФоновогоЗадания = Новый Структура;
		ПараметрыФоновогоЗадания.Вставить("МассивОрганизаций", ДополнительныеПараметры.МассивОрганизаций);
	
		КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеВыполнениеСотслеживаниемВНовойФорме("КонтурЛогистика_ДлительныеОперацииСервер.СинхронизироватьКонтрагентовОрганизацииДиадок",
				"Синхронизировать контрагентов организации",
				ПараметрыФоновогоЗадания,
				"Синхронизировать контрагентов организации",
				Ложь,
				Истина);
		 		
	КонецЕсли;
	
КонецПроцедуры

