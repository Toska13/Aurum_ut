				</c>
			</c>
			<c>
				<c>
					<f>45</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>	Запрос = Новый Запрос;
	Запрос.Текст = 
"ВЫБРАТЬ
| алкТранспортнаяИнформация.ТранспортноеСредство КАК ТранспортноеСредство,
| алкТранспортнаяИнформация.Водитель КАК Водитель,
| алкТранспортнаяИнформация.Перевозчик КАК Перевозчик,
| алкТранспортнаяИнформация.ЗаказчикСам КАК ЗаказчикСам,
| алкТранспортнаяИнформация.Заказчик КАК Заказчик,
| алкТранспортнаяИнформация.ВидПеревозки КАК ВидПеревозки,
| алкТранспортнаяИнформация.СрокДоставки КАК СрокДоставки,
| алкТранспортнаяИнформация.ДатаТН КАК ДатаТН,
| алкТранспортнаяИнформация.НомерТН КАК НомерТН
|ПОМЕСТИТЬ ВрТаб
|ИЗ
| РегистрСведений.алкТранспортнаяИнформация КАК алкТранспортнаяИнформация
|ГДЕ
| алкТранспортнаяИнформация.Объект = &amp;Объект
| И НЕ алкТранспортнаяИнформация.Водитель = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
| ВрТаб.ТранспортноеСредство КАК ТранспортноеСредство,
| ВрТаб.Водитель КАК Водитель,
| ВрТаб.Перевозчик КАК Перевозчик,
| ВрТаб.ЗаказчикСам КАК ЗаказчикСам,
| ВрТаб.Заказчик КАК Заказчик,
| ВрТаб.ВидПеревозки КАК ВидПеревозки,
| ВрТаб.СрокДоставки КАК СрокДоставки,
| ВрТаб.ДатаТН КАК ДатаТН,
| ВрТаб.НомерТН КАК НомерТН,
| ДокументыФизическихЛицСрезПоследних.Серия КАК Серия,
| ДокументыФизическихЛицСрезПоследних.Номер КАК Номер,
| ДокументыФизическихЛицСрезПоследних.ДатаВыдачи КАК ДатаВыдачи
|ИЗ
| ВрТаб КАК ВрТаб
|  ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)) КАК ДокументыФизическихЛицСрезПоследних
|  ПО ВрТаб.Водитель = ДокументыФизическихЛицСрезПоследних.Физлицо";
	
	Запрос.УстановитьПараметр("Объект", Основание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = Запрос.Выполнить().Выбрать();
Если Выборка.Следующий() Тогда
РезультатВычисления = Выборка;
КонецЕсли;</v8:content>
						</v8:item>
					</tl>
				</c>
