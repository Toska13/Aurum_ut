							<v8:lang>ru</v8:lang>
							<v8:content>ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
Если ИмяКонфигурации1С = "УАТ"
	Или ИмяКонфигурации1С = "ТЛЭ"
	Или ИмяКонфигурации1С = "УАТ_ПРОФ"
	Или ИмяКонфигурации1С = "ERP_УАТ" Тогда
	
	КонтурЛогистика_КонвертацияСервер.КонвертироватьПриТриггереУникальноеИмяПрограммногоВызова("ПриФормированииПЛТ5", Основание, Объект.Титул1);
КонецЕсли;

РезультатВычисления = Истина;</v8:content>
