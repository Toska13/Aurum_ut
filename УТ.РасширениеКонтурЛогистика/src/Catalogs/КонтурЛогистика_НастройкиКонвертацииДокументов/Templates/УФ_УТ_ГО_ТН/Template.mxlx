							<v8:lang>ru</v8:lang>
							<v8:content>Если Основание.ДокументыОснования.Количество() &gt; 0 Тогда
	ДокОсн = Основание.ДокументыОснования[0].ДокументОснование;
	Если ТипЗнч(ДокОсн) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		РезультатВычисления = ДокОсн.Валюта;
	Иначе
		РезультатВычисления = Справочники.Валюты.НайтиПоКоду("643");
	КонецЕсли;
Иначе
	РезультатВычисления = Справочники.Валюты.НайтиПоКоду("643");
