			<c>
				<c>
					<f>60</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
|    КонтурEDI_Сообщения.НомерЗаказа КАК НомерЗаказа
|ИЗ
|    Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
|ГДЕ
|    ВЫРАЗИТЬ(КонтурEDI_Сообщения.Документ КАК Документ.ЗаказКлиента) = &amp;Документ

|    И КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""";
Запрос.УстановитьПараметр("Документ", Основание.ДокументыОснования[0].ДокументОснование.ЗаказКлиента);
ВыборкаК = Запрос.Выполнить().Выбрать();
Если ВыборкаК.Следующий() Тогда
  РезультатВычисления = ВыборкаК.НомерЗаказа;
Иначе
