			"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления 
			|И КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.Грузополучатель.Наш
			|И КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.Грузополучатель.Грузополучатель");
			
		КонецЕсли;
				
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного))",
		"ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного))
		|И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&СостоянияДляОтправкиПослеОбработки)");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)",
		"&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)
		|И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&СостоянияДляОтправкиПослеОбработки)");
		
		// Чтобы не отображались в списке если был возврат, а отображались в возвратной цепочке
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1",
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА 
		|				ВЫБОР 
		|					КОГДА ЕСТЬNULL(ПодзапросПредыдущийТитул.ДокументЭТРН.КоличествоПереадресовок, 0) = 1
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника)
		|					ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ3
		|				КОНЕЦ");
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"ПодзапросПредыдущийТитул.ДокументЭТРН.ТранспортноеСредство КАК ТранспортноеСредство,",
		"ПодзапросПредыдущийТитул.ДокументЭТРН.ТранспортноеСредство КАК ТранспортноеСредство,
		|ПодзапросТекущийТитул.Ссылка.СтоимостьБезНДС КАК СтоимостьБезНДС,");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ПредыдущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ПредыдущийТитул.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ПредыдущийТитул.ПринятьЧастично
		|И НЕ КонтурЛогистика_ПредыдущийТитул.ОтказВПриемке");
		
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"ПодзапросПредыдущийТитул.ДокументЭТРН.ТранспортноеСредство КАК ТранспортноеСредство,",
		"ПодзапросПредыдущийТитул.ДокументЭТРН.ТранспортноеСредство КАК ТранспортноеСредство,
		|ПодзапросПредыдущийТитул.Ссылка.СтоимостьБезНДС КАК СтоимостьБезНДС,");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"Документ.КонтурЛогистика_ТрН_Титул6 КАК КонтурЛогистика_ТекущийТитул",
		"Документ.КонтурЛогистика_ТрН_Титул6 КАК КонтурЛогистика_ТекущийТитул
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
		|	ПО КонтурЛогистика_ТекущийТитул.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
