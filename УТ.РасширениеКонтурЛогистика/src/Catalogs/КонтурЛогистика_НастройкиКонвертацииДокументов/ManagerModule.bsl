Функция НастройкиВыполненыДляТипаДокумента(ТипДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Количество
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка";
	
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий(); 
	
