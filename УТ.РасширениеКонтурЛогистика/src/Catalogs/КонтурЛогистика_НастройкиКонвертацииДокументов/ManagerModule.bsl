Процедура ЗаполнитьПравилаКонвертации(НастройкаКонвертацииОбъект, ЭтоНовыйОбъект = Ложь, ТаблицаПравил = Неопределено) Экспорт 
	
	Если Не ЗначениеЗаполнено(ТаблицаПравил) Тогда
		ТаблицаПравил = ТаблицаНастроекКонвертацииДокументов(НастройкаКонвертацииОбъект.ТипДокументаЛогистика, НастройкаКонвертацииОбъект.ТипДокумента1С, ЭтоНовыйОбъект); 	
	КонецЕсли;
		
	Если ТаблицаПравил.Количество() = 0 Тогда 
		
		Сообщить("Для этой типовой конфигурации сейчас не реализовано автоматическое заполнение для " + НастройкаКонвертацииОбъект.ТипДокументаЛогистика 
		+ " по учетному документу: " + ?(ЗначениеЗаполнено(НастройкаКонвертацииОбъект.ТипДокумента1С),НастройкаКонвертацииОбъект.ТипДокумента1С, " <без исходного документа>") 
		+ Символы.ПС );
		
	Иначе
		
		Если ТаблицаПравил.Количество() > 0 И ЗначениеЗаполнено(ТаблицаПравил[0].ТипДокумента1С) Тогда 
			НастройкаКонвертацииОбъект.ТипДокумента1С = ТаблицаПравил[0].ТипДокумента1С;
		КонецЕсли;
		
		Для Каждого Правило Из ТаблицаПравил Цикл 
			
			
			Если Не ЗначениеЗаполнено(Правило.ТабЧасть) Тогда 
				
				Если ЗначениеЗаполнено(Правило.ВыражениеВычисления) Тогда
					НастройкаКонвертацииОбъект[Правило.РеквизитТитула] = Правило.ВыражениеВычисления;
				ИначеЕсли ЗначениеЗаполнено(Правило.ВыражениеВычисления2) Тогда
					НастройкаКонвертацииОбъект[Правило.РеквизитТитула] = Правило.ВыражениеВычисления2;
				Иначе
					НастройкаКонвертацииОбъект[Правило.РеквизитТитула] = Правило.ВыражениеВычисленияСтрокаНеогр;
				КонецЕсли;
				
			Иначе
				
				ЭтоПеременные = Правило.ТабЧасть = "Переменные";
				КлючОтбора = ?(ЭтоПеременные, "Имя", "РеквизитТитула");
				
				Если Лев(Правило.Имя, 7) = "ПутьДоп" Тогда
					ПараметрыОтбора = Новый Структура("НомерСтроки", Число(СтрЗаменить(Правило.Имя, "ПутьДоп", "")));
					НайденныеПравила = НастройкаКонвертацииОбъект[Правило.ТабЧасть].НайтиСтроки(ПараметрыОтбора);
					Если НайденныеПравила.Количество() = 0 Тогда
						НовоеПравило = НастройкаКонвертацииОбъект[Правило.ТабЧасть].Добавить();
						НовоеПравило.Заголовок = Правило.РеквизитТитулаКомментарий;
						НовоеПравило.ПутьКДанным = Правило.ВыражениеВычисления;
						Если Правило.ТабЧасть = "ДополнительныеКолонки" Тогда
							НовоеПравило.ДобавленИзКонструктораЗапроса = Истина;
						КонецЕсли;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				
				НайденныеПравила = НастройкаКонвертацииОбъект[Правило.ТабЧасть].НайтиСтроки(Новый Структура(КлючОтбора, Правило.РеквизитТитула));
				Если НайденныеПравила.Количество() Тогда
					
					НовоеПравило = НайденныеПравила[0];
					ИнициализироватьСтрокуПравилКонвертации(НовоеПравило);
					
				Иначе
					
					НовоеПравило = НастройкаКонвертацииОбъект[Правило.ТабЧасть].Добавить();
					
				КонецЕсли;	
				
				ЗаполнитьЗначенияСвойств(НовоеПравило, Правило);
				
				ОбработатьФиксированноеЗначение(НовоеПравило, Правило, ЭтоПеременные);
				
			КонецЕсли;	
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьФиксированноеЗначение(Знач НовоеПравило, Знач Правило, ЭтоПеременные = Ложь)
	
	Перем ВычисленноеЗначение;
	
	КолонкаТипЗначения 	= ?(ЭтоПеременные, "ИмяТипЗначения", "РеквизитТитулаТипЗначения");
	
	Если Правило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение Тогда 
			
		Если Правило[КолонкаТипЗначения] = "Число" Тогда 
			ВычисленноеЗначение = Число(Правило.ВыражениеВычисления);
		ИначеЕсли Правило[КолонкаТипЗначения] = "Строка" Тогда
			ВычисленноеЗначение = Строка(Правило.ВыражениеВычисления);            
		ИначеЕсли Правило[КолонкаТипЗначения] = "Булево" Тогда
			ВычисленноеЗначение = Булево(Правило.ВыражениеВычисления);
		ИначеЕсли Правило[КолонкаТипЗначения] = "Дата" Тогда	
			ВычисленноеЗначение = Дата(Правило.ВыражениеВычисления);
		Иначе  
			
			Попытка
				Параметры = Новый Структура;
				Параметры.Вставить("Правило", Правило);
				
				ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
					Правило.ВыражениеВычисления, Параметры);
			Исключение 
				РеквизитТитула = ?(ЭтоПеременные, "Имя", "РеквизитТитула");
				Сообщить("Проблема с установкой правила конвертации: " + Правило[РеквизитТитула] + " - " + ОписаниеОшибки()); 
			КонецПопытки;  
			
		КонецЕсли;
		
		НовоеПравило.ВыражениеВычисления = ВычисленноеЗначение;

	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьСтрокуПравилКонвертации(СтрокаПравил)
	
	СтрокаПравил.СпособМаппинга 			= Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
	СтрокаПравил.ВыражениеВычисления		= "";
	СтрокаПравил.КлючДопСвойстваРеквизита 	= "";
	СтрокаПравил.ВыражениеВычисления2 		= "";
	СтрокаПравил.СпособКонвертацииЗначения 	= Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
	
КонецПроцедуры	

Функция ТаблицаНастроекКонвертацииДокументов(ТипДокументаЛогистика = Неопределено, ТипДокумента1С = Неопределено, ЭтоНовый = Ложь) Экспорт
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуНастроекКонвертацииДокументововПоУмолчанию(ТипДокументаЛогистика, ТипДокумента1С, ЭтоНовый);
	
КонецФункции

Функция ПолучитьТаблицуНастроекКонвертацииДокументововПоУмолчанию(ТипДокументаЛогистика = Неопределено, ТипДокумента1С = Неопределено, ЭтоНовый, ИмяМакета = "КЛ", ИмяКонфигурации = "") Экспорт

	ПравилаКонвертации = Новый ТаблицаЗначений;
	ПравилаКонвертации.Колонки.Добавить("ТипДокументаЛогистика");
	ПравилаКонвертации.Колонки.Добавить("ТипДокумента1С");
	ПравилаКонвертации.Колонки.Добавить("ТабЧасть");  
	
	// для ТЧ Переменные
	ПравилаКонвертации.Колонки.Добавить("Имя");
	ПравилаКонвертации.Колонки.Добавить("ИмяТипЗначения");
	ПравилаКонвертации.Колонки.Добавить("ИмяТабЧасти");
	
	// для ТЧ ПравилаКонвертацииТитулаТабЧастьПроизвольная
	ПравилаКонвертации.Колонки.Добавить("ИмяТЧТитула");
	ПравилаКонвертации.Колонки.Добавить("ПутьТЧИсходногоДокумента");
	ПравилаКонвертации.Колонки.Добавить("ИмяРеквизитаПоискаНКС");
	
	РеквизитыТЗ = Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.ПравилаКонвертацииГлавногоДокумента.Реквизиты;
	
	Для Каждого Реквизит Из РеквизитыТЗ Цикл 
		ПравилаКонвертации.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;	
	
	// разделение общего макета на макеты по конфигурациям
	ИмяКонфигурацииДляНКД = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ИмяКонфигурацииДляНастроекКонвертации(ИмяКонфигурации);
	
	Если ИмяКонфигурацииДляНКД = Неопределено Тогда 
		Возврат ПравилаКонвертации;
	КонецЕсли;
	
	ИзвлеченныеОбласти = Новый Массив;
	
	Если ИмяМакета = "ЗначенияПоУмолчаниюДляДополнений" Тогда 
		Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьМакет(ИмяМакета);
		Попытка 
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурации));
		Исключение
			Возврат ПравилаКонвертации;
		КонецПопытки;	
	Иначе		
		Попытка				
			ИзвлеченныеОбласти = ИзвлечьОбластиИзМакетов(ИмяКонфигурацииДляНКД);
		Исключение
			Возврат ПравилаКонвертации;
		КонецПопытки;	
	КонецЕсли;
	
	Для Каждого Область Из ИзвлеченныеОбласти Цикл 
	
		Для Сч = 1 По Область.ВысотаТаблицы Цикл
			
			ТипДокументаЛогистикаИзМакета	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 2);
			ТипДокумента1СИзМакета			= ПолучитьТекстЯчейкиОбласти(Область, Сч, 3);
			
			Если Не ТипДокументаЛогистика = Неопределено И (Не ТипДокумента1С = Неопределено Или ЭтоНовый) Тогда
				
				Если Не ИмяКонфигурацииДляНКД = ПолучитьТекстЯчейкиОбласти(Область, Сч, 1) 
					Или Не ПолучитьИмяЭлементаПеречисленияПоЗначению_(ТипДокументаЛогистика) = ТипДокументаЛогистикаИзМакета
					Или (Не ТипДокумента1С = ТипДокумента1СИзМакета И (Не ЭтоНовый Или Не ТипДокумента1С = Неопределено))
					Тогда
					Продолжить;
				КонецЕсли;	
				
			КонецЕсли;
			
			НовоеПравило = ПравилаКонвертации.Добавить();
			
			НовоеПравило.ТипДокументаЛогистика	= ТипДокументаЛогистикаИзМакета;
			НовоеПравило.ТипДокумента1С			= ТипДокумента1СИзМакета;
			
			ТабЧасть	 		= ПолучитьТекстЯчейкиОбласти(Область, Сч, 4);
			ИмяРеквизита 		= ПолучитьТекстЯчейкиОбласти(Область, Сч, 6);
			ВыражениеВычисления = ПолучитьТекстЯчейкиОбласти(Область, Сч, 10);
			
			НовоеПравило.РеквизитТитула				= ИмяРеквизита;
			НовоеПравило.Имя						= ИмяРеквизита;
			НовоеПравило.РеквизитТитулаТипЗначения	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 7);
			НовоеПравило.ИмяТипЗначения 			= НовоеПравило.РеквизитТитулаТипЗначения;
			НовоеПравило.ТабЧасть					= ТабЧасть;
			НовоеПравило.РеквизитТитулаКомментарий	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 8);
			
			НовоеПравило.Картинка					= ПолучитьТекстЯчейкиОбласти(Область, Сч, 5);

			НовоеПравило.КлючДопСвойстваРеквизита	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 11);
			НовоеПравило.ИмяТабЧасти				= ПолучитьТекстЯчейкиОбласти(Область, Сч, 13);
			
			НовоеПравило.ИмяТЧТитула				= ПолучитьТекстЯчейкиОбласти(Область, Сч, 14);
			НовоеПравило.ПутьТЧИсходногоДокумента	= ПолучитьТекстЯчейкиОбласти(Область, Сч, 15);
			НовоеПравило.ИмяРеквизитаПоискаНКС		= ПолучитьТекстЯчейкиОбласти(Область, Сч, 16);
			
			НовоеПравило.СпособМаппинга				= ЗначениеПеречисленияПоСтроке(Перечисления.КонтурЛогистика_СпособыМаппингаПоля, 
														ПолучитьТекстЯчейкиОбласти(Область, Сч, 9));
														
			НовоеПравило.СпособКонвертацииЗначения	= ЗначениеПеречисленияПоСтроке(Перечисления.КонтурЛогистика_СпособыКонвертации, 
														ПолучитьТекстЯчейкиОбласти(Область, Сч, 12));
					
			Если НовоеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда 
				НовоеПравило.ВыражениеВычисленияСтрокаНеогр = ВыражениеВычисления;
				
			// Для случая, когда способ маппинга "Не заполнять", а потом нужно переключиться на "Вычислить выражение на языке 1С" 
			// и введеный код должен отображаться в поле "Код на языке 1С".
			ИначеЕсли НовоеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять 
				И ЗначениеЗаполнено(ВыражениеВычисления)
				И Найти(ВыражениеВычисления, "РезультатВычисления") > 0 Тогда 
				НовоеПравило.ВыражениеВычисленияСтрокаНеогр = ВыражениеВычисления;
			Иначе
				Если СтрДлина(ВыражениеВычисления) > 255 Тогда
					НовоеПравило.ВыражениеВычисленияСтрокаНеогр = ВыражениеВычисления;
				Иначе
					НовоеПравило.ВыражениеВычисления = ВыражениеВычисления;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;

	Возврат ПравилаКонвертации;
	
КонецФункции

Функция ИзвлечьОбластиИзМакетов(ИмяКонфигурацииДляНКД) Экспорт
	
	ИзвлеченныеОбласти = Новый Массив;
	
	Если ИмяКонфигурацииДляНКД = "УФ_УТ" Тогда
		
		Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьМакет(ИмяКонфигурацииДляНКД);
		ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКД));
		
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеДоставкой") Тогда
		
			Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьМакет("УФ_УТ_ГО_РТУ");
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКД));
			
		ИначеЕсли НЕ ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
			
			Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьМакет("УФ_УТ_ГО_ТН");
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКД));
			
		Иначе
			
			Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьМакет("УФ_УТ_ГО_ТН_ЗнП");
			ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКД));
			
		КонецЕсли;
		
	Иначе
		
		Макет = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьМакет(ИмяКонфигурацииДляНКД);
		ИзвлеченныеОбласти.Добавить(Макет.ПолучитьОбласть(ИмяКонфигурацииДляНКД));
		
	КонецЕсли;
	
	Возврат ИзвлеченныеОбласти;
		
КонецФункции

Функция ИмяКонфигурацииДляНастроекКонвертации(Знач ИмяКонфигурации = Неопределено) Экспорт
	
	ИмяКонфигурацииДляНКД = ИмяКонфигурации;
	
	Если Не ЗначениеЗаполнено(ИмяКонфигурацииДляНКД) Тогда
		
		ИмяКонфигурацииДляНКД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
		
	КонецЕсли;
	
	Если ИмяКонфигурацииДляНКД = "УАТ_ПРОФ" Или ИмяКонфигурацииДляНКД = "ТЛЭ" Тогда // метка не разделяем ТЛЭ и УАТ_ПРОФ			
		ИмяКонфигурацииДляНКД = "ТЛЭ_УАТ_ПРОФ";
	КонецЕсли;

	Возврат ИмяКонфигурацииДляНКД;
	
КонецФункции 

Функция ПолучитьТекстЯчейкиОбласти(Область, Строка, Колонка)
	
	Возврат Строка(Область.ПолучитьОбласть("R" + Формат(Строка, "ЧГ=0") + "C" + Формат(Колонка, "ЧГ=0")).ТекущаяОбласть.Текст);
	
КонецФункции

Функция ЗначениеПеречисленияПоСтроке(ПеречислениеМенеджер, ЗначениеСтрока) Экспорт 
	
	ЗначениеПеречисления = "";
	
	Если ЗначениеЗаполнено(ЗначениеСтрока) Тогда 
		
		ЗначениеПеречисления = ПеречислениеМенеджер[ЗначениеСтрока];
		
	КонецЕсли;	
	
	Возврат ЗначениеПеречисления;
	
КонецФункции

Функция ПолучитьИмяЭлементаПеречисленияПоЗначению_(Знач ПеречислениеСсылка)
	
	Если Не ЗначениеЗаполнено(ПеречислениеСсылка) Тогда 
		Возврат "";
	КонецЕсли;	
	
	ИмяМетаданных = ПеречислениеСсылка.Метаданные().Имя;
	НазваниеМенеджера = "ПеречислениеМенеджер." + ИмяМетаданных;    
	Менеджер = Новый (НазваниеМенеджера); 
	Имя = ПеречислениеСсылка.Метаданные().ЗначенияПеречисления[Менеджер.Индекс(ПеречислениеСсылка)].Имя;
	
	Возврат Имя;
	
КонецФункции

Процедура СоздатьНастройкиТитуловИзМакетаЗначенияПоУмолчанию() Экспорт 
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГОВОрганизациях() 
		И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Оформитель") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользуетсяЗаказЗаявка 		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
	ИспользуетсяТРН 				= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
	ИспользуетсяПутевойЛист 		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	ИспользуетсяПутевойЛист_5_02 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист_5_02");
	
	ТаблицаНастроек = ТаблицаНастроекКонвертацииДокументов(,, Истина);
	
	ВариантыНастроек = ТаблицаНастроек.Скопировать(, "ТипДокументаЛогистика, ТипДокумента1С");
	ВариантыНастроек.Свернуть("ТипДокументаЛогистика, ТипДокумента1С");
	
	Если Не ЗначениеЗаполнено(ВариантыНастроек) Тогда
		
		// Нет ни одной предопределенной настройки
		// Создаем пустые настройки для титулов
		Если ИспользуетсяТРН Тогда 
			НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
			НоваяНастройка.ТипДокументаЛогистика 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
			НоваяНастройка.Наименование 			= "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
			НоваяНастройка.НаправлениеКонвертации 	= Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			НоваяНастройка.Записать();
		КонецЕсли;
	
		Если ИспользуетсяЗаказЗаявка Тогда 
			НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
			НоваяНастройка.ТипДокументаЛогистика 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1;
			НоваяНастройка.Наименование 			= "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
			НоваяНастройка.НаправлениеКонвертации 	= Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			НоваяНастройка.Записать();
		КонецЕсли;
	
		Если ИспользуетсяПутевойЛист Тогда 
			НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
			НоваяНастройка.ТипДокументаЛогистика 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
			НоваяНастройка.Наименование 			= "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
			НоваяНастройка.НаправлениеКонвертации 	= Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			НоваяНастройка.Записать();
			
			// Спец. сценарий
			НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
			НоваяНастройка.ТипДокументаЛогистика 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
			НоваяНастройка.Наименование 			= "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С
				+ ", " + НРег(Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя);
			НоваяНастройка.НаправлениеКонвертации 	= Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			НоваяНастройка.Записать();
			
		КонецЕсли;
		
		Если ИспользуетсяПутевойЛист_5_02 Или ИспользуетсяПутевойЛист Тогда 
			НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
			НоваяНастройка.ТипДокументаЛогистика 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
			НоваяНастройка.Наименование 			= "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
			НоваяНастройка.НаправлениеКонвертации 	= Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			НоваяНастройка.Записать(); 								
		КонецЕсли;
	
		Возврат;
		
	КонецЕсли;
	
	Для Каждого ВариантНастройки Из ВариантыНастроек Цикл 
		
		ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СсылкаПоИмени(ВариантНастройки.ТипДокументаЛогистика);
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокументаЛогистика) Тогда
			
			Если Не ИспользуетсяЗаказЗаявка Тогда
				Продолжить;
			КонецЕсли; 
			
			Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГОВОрганизациях()
				Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокументаЛогистика)
			И Не ИспользуетсяПутевойЛист 
			И Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокументаЛогистика) Тогда
			Продолжить;
		КонецЕсли;		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокументаЛогистика)
			И КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502()
			И Не ИспользуетсяПутевойЛист_5_02 Тогда
			Продолжить;
		КонецЕсли;
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокументаЛогистика)
			И Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502()
			И Не ИспользуетсяПутевойЛист Тогда
			Продолжить;
		КонецЕсли;
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокументаЛогистика)
			И Не ИспользуетсяТРН Тогда
			Продолжить;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			СоздатьНастройкуИзМакета(ТаблицаНастроек, ВариантНастройки, ТипДокументаЛогистика);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Не удалось заполнить настройки конвертации документов для Титула 1 для текущей конфигурации.
			|Ошибка: " + ОписаниеОшибки();
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьНастройкуИзМакета(ТаблицаНастроек, ВариантНастройки, ТипДокументаЛогистика)
	
	НайденнаяНастройка = ПолучитьНастройкуКонвертации(ТипДокументаЛогистика, ВариантНастройки.ТипДокумента1С);
	Если Не НайденнаяНастройка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создадим новую настройку конвертации
	НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
	
	НоваяНастройка.ТипДокументаЛогистика 	= ТипДокументаЛогистика;
	НоваяНастройка.ТипДокумента1С 			= ВариантНастройки.ТипДокумента1С;
	
	Если ЗначениеЗаполнено(НоваяНастройка.ТипДокумента1С) Тогда
		НаименованиеКонвертации = "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
	Иначе
		НаименованиеКонвертации = "" + НоваяНастройка.ТипДокументаЛогистика + " по предыдущему титулу";
	КонецЕсли;
	НоваяНастройка.Наименование = НаименованиеКонвертации;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТипДокументаЛогистика", ВариантНастройки.ТипДокументаЛогистика);
	Отбор.Вставить("ТипДокумента1С", 		ВариантНастройки.ТипДокумента1С);
	
	НайденныеПравила = ТаблицаНастроек.НайтиСтроки(Отбор);
	
	Для Каждого Правило Из НайденныеПравила Цикл 
		
		Если Не ЗначениеЗаполнено(Правило.ТабЧасть) Тогда 
			
			НоваяНастройка[Правило.РеквизитТитула] = Правило.ВыражениеВычисления;
			
		Иначе
			
			НовоеПравило = НоваяНастройка[Правило.ТабЧасть].Добавить();
			
			Если Правило.ТабЧасть = "ДополнительныеКолонки" Тогда
				НовоеПравило.ДобавленИзКонструктораЗапроса = Истина;
			КонецЕсли;
			
			Если Лев(Правило.Имя, 7) = "ПутьДоп" Тогда

				НовоеПравило.Заголовок = Правило.РеквизитТитулаКомментарий;
				НовоеПравило.ПутьКДанным = Правило.ВыражениеВычисления;
				Продолжить; 
					
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НовоеПравило, Правило);
			
			ОбработатьФиксированноеЗначение(НовоеПравило, Правило);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьРеквизитыНастройкиКонвертацииПоУмолчанию(НоваяНастройка);
	
	НоваяНастройка.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
	НоваяНастройка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
	
	НоваяНастройка.ПравилаКонвертацииГлавногоДокумента.Сортировать("Картинка Возр, РеквизитТитула");
	НоваяНастройка.ПравилаКонвертацииТитулаРеквизиты.Сортировать("Картинка Возр, РеквизитТитула");
	НоваяНастройка.ПравилаКонвертацииТитулаТабЧастьТовары.Сортировать("Картинка Возр, РеквизитТитула");
		
	НоваяНастройка.Записать();
	
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		
		// Спец. сценарий
		НовыйНКД = НоваяНастройка.Скопировать();
		НовыйНКД.СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя;
		НовыйНКД.Наименование = "" + НовыйНКД.ТипДокументаЛогистика + " по предыдущему титулу" + ", " + НРег(Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя);
		
		// Особенности для ПЛ Т1, так как при смене водителя основание другое
		НовыйНКД.ТипДокумента1С = Неопределено;
		Для Каждого ТекущаяСтрока Из НовыйНКД.ПравилаКонвертацииТитулаРеквизиты Цикл
			ТекущаяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
		КонецЦикла;
		
		// Для Спец. сценария очистим скопированные доп. колонки
		НовыйНКД.ДополнительныеКолонки.Очистить();
		
		НовыйНКД.Записать();
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура СоздатьНастройкуТРНДляТитуловКромеТитула1(ТипДокументаЛогистика, НомерТитула, СпецСценарий = Неопределено) Экспорт 
	
 	Если (НомерТитула = 2 Или НомерТитула = 4 Или НомерТитула = 5 Или НомерТитула = 7 Или НомерТитула = 8) 
		И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиПВВОрганизациях() Тогда 
		Возврат;
	ИначеЕсли НомерТитула = 3 
		И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГПВОрганизациях()
		И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГОВОрганизациях() Тогда
		Возврат;
	ИначеЕсли НомерТитула = 6 
		И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГОВОрганизациях()Тогда	
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		НайденнаяНастройка = ПолучитьНастройкуКонвертации(ТипДокументаЛогистика,, СпецСценарий);
		
		Если Не НайденнаяНастройка = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		// создаем настройку
		
		НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
		
		НоваяНастройка.ТипДокументаЛогистика = ТипДокументаЛогистика;
		
		Если ЗначениеЗаполнено(НоваяНастройка.ТипДокумента1С) Тогда 
			НоваяНастройка.Наименование = "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
		Иначе
			НоваяНастройка.Наименование = "" + НоваяНастройка.ТипДокументаЛогистика + " по предыдущему титулу";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпецСценарий) Тогда
			НоваяНастройка.Наименование = НоваяНастройка.Наименование + ", " + НРег(СпецСценарий);
		КонецЕсли;
		
		Если НоваяНастройка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			ИЛИ НоваяНастройка.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда 
			ЕстьТовары = Истина;
		Иначе
			ЕстьТовары = Ложь;
		КонецЕсли;
		
		СформироватьРеквизитыДокументаДляТитула(НоваяНастройка.ПравилаКонвертацииГлавногоДокумента,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяГлавногоДокументаКонтурЛогистика(НоваяНастройка.ТипДокументаЛогистика));
			
		СформироватьРеквизитыДокументаДляТитула(НоваяНастройка.ПравилаКонвертацииТитулаРеквизиты, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НоваяНастройка.ТипДокументаЛогистика));	
		
		Если ЕстьТовары Тогда 
			СформироватьРеквизитыДокументаДляТитула(НоваяНастройка.ПравилаКонвертацииТитулаТабЧастьТовары, 
				"ТЧ" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НоваяНастройка.ТипДокументаЛогистика));
		КонецЕсли;	
		
		ЗаполнитьРеквизитыНастройкиКонвертацииПоУмолчанию(НоваяНастройка);
		
		НоваяНастройка.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		НоваяНастройка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
		НоваяНастройка.СпецСценарий = СпецСценарий;
		
		НоваяНастройка.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "Не удалось заполнить настройки конвертации для Титула " + НомерТитула + " для текущей конфигурации. Создайте их вручную.
					  |Ошибка: " + ОписаниеОшибки();
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);

	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьНастройкуПЛДляТитуловКромеТитула1(ТипДокументаЛогистика, НомерТитула) Экспорт 
	
 	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокументаЛогистика) Тогда
		
		Если (НомерТитула = 2 Или НомерТитула = 5) 
			И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Медик") Тогда 
			Возврат;
		ИначеЕсли (НомерТитула = 3 Или НомерТитула = 4) 
			И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Оформитель") Тогда 
			Возврат;
		КонецЕсли;
		
	Иначе
		
		Если (НомерТитула = 2 ИЛИ НомерТитула = 6) 
			И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Медик") Тогда 
			Возврат;
		ИначеЕсли НомерТитула = 3 
			И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("ТехОсмотр") Тогда
			Возврат;
		ИначеЕсли (НомерТитула = 4 ИЛИ НомерТитула = 5) 
			И Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Одометр")Тогда	
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	// если уже есть какая-то натсройка конвертации документа с этим типом лог. документа то пропускаем (была создана ранее иным механизмом)
	НайденнаяНастройка = ПолучитьНастройкуКонвертации(ТипДокументаЛогистика);
	Если Не НайденнаяНастройка = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		// создаем новую настройку
		НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
		НоваяНастройка.ТипДокументаЛогистика = ТипДокументаЛогистика;
		
		Если ЗначениеЗаполнено(НоваяНастройка.ТипДокумента1С) Тогда 
			НоваяНастройка.Наименование = "" + НоваяНастройка.ТипДокументаЛогистика + " по " + НоваяНастройка.ТипДокумента1С;
		Иначе
			НоваяНастройка.Наименование = "" + НоваяНастройка.ТипДокументаЛогистика + " по предыдущему титулу";
		КонецЕсли; 
		
		СформироватьРеквизитыДокументаДляТитула(НоваяНастройка.ПравилаКонвертацииТитулаРеквизиты, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НоваяНастройка.ТипДокументаЛогистика));	
		
		ЗаполнитьРеквизитыНастройкиКонвертацииПоУмолчанию(НоваяНастройка);
		
		НоваяНастройка.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		НоваяНастройка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
		
		НоваяНастройка.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "Не удалось заполнить настройки конвертации для Титула " + НомерТитула + " для текущей конфигурации. Создайте их вручную.
					  |Ошибка: " + ОписаниеОшибки();
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьНастройкуЗЗДляТитуловПРВ(ТипДокументаЛогистика) Экспорт 
	
 	Если НЕ Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиПВВОрганизациях() Тогда 
		Возврат;
	КонецЕсли;	
	
	// если уже есть какая-то настройка конвертации документа с этим типом лог. документа то пропускаем (была создана ранее иным механизмом)
	НайденнаяНастройка = ПолучитьНастройкуКонвертации(ТипДокументаЛогистика);
	Если Не НайденнаяНастройка = Неопределено Тогда 
		Возврат;
	КонецЕсли;   
	
	ТаблицаНастроек = ТаблицаНастроекКонвертацииДокументов(ТипДокументаЛогистика,, Истина);
	
	ВариантыНастроек = ТаблицаНастроек.Скопировать(, "ТипДокументаЛогистика, ТипДокумента1С");
	ВариантыНастроек.Свернуть("ТипДокументаЛогистика, ТипДокумента1С");
	
	Если Не ЗначениеЗаполнено(ВариантыНастроек) Тогда
		Возврат;
	КонецЕсли; 
		
	Для Каждого ВариантНастройки Из ВариантыНастроек Цикл
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			СоздатьНастройкуИзМакета(ТаблицаНастроек, ВариантНастройки, ТипДокументаЛогистика);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Не удалось заполнить настройки конвертации документов для " + ТипДокументаЛогистика + " для текущей конфигурации.
			|Ошибка: " + ОписаниеОшибки();
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ВариантНастройки.ТипДокумента1С) Тогда
			
			СоздатьНастройкуЗЗДляВхТитула1(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, ВариантНастройки.ТипДокумента1С);	
			
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьНастройкуЗЗДляВхТитула1(ТипДокументаЛогистика, ТипДокумента1С = Неопределено) Экспорт 
	
 	Если НЕ Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиПВВОрганизациях() Тогда 
		Возврат;
	КонецЕсли;	
	
	// если уже есть какая-то настройка конвертации документа с этим типом лог. документа то пропускаем (была создана ранее иным механизмом)
	НайденнаяНастройка = ПолучитьНастройкуКонвертации(ТипДокументаЛогистика);
	Если Не НайденнаяНастройка = Неопределено Тогда 
		Возврат;
	КонецЕсли;   
			
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		// создаем новую настройку
		НоваяНастройка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СоздатьЭлемент();
		НоваяНастройка.ТипДокументаЛогистика  = ТипДокументаЛогистика;
		НоваяНастройка.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее;
		
		Если ЗначениеЗаполнено(ТипДокумента1С) Тогда
			НоваяНастройка.ТипДокумента1С		  = ТипДокумента1С;	
			НоваяНастройка.Наименование 		  = "" + НоваяНастройка.ТипДокументаЛогистика + " по " + ТипДокумента1С;
			НоваяНастройка.СоздаватьДокУчСис 	  = Истина;
			НоваяНастройка.Сценарий 			  = Перечисления.КонтурЛогистика_Сценарии.Загрузка;
			НоваяНастройка.СценарийПоУмолчанию	  = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ОбработатьВходящий;
		Иначе
			НоваяНастройка.Наименование 		  = "" + НоваяНастройка.ТипДокументаЛогистика + " по предыдущему титулу";
			НоваяНастройка.Сценарий 			  = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаНеОбрабатывать;
		КонецЕсли;		
		
		СформироватьРеквизитыДокументаДляТитула(НоваяНастройка.ПравилаКонвертацииТитулаРеквизиты, 
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НоваяНастройка.ТипДокументаЛогистика));	
		
		ЗаполнитьРеквизитыНастройкиКонвертацииПоУмолчанию(НоваяНастройка);
				
		НоваяНастройка.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "Не удалось заполнить настройки конвертации для " + ТипДокументаЛогистика + " для текущей конфигурации. Создайте их вручную.
		|Ошибка: " + ОписаниеОшибки();
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СформироватьРеквизитыДокументаДляТитула(ТабличнаяЧастьНастройки, Знач ИмяДокЛогистика)
	
	Если Лев(ИмяДокЛогистика,2) = "ТЧ" Тогда
		ЭтоТЧ = Истина;
		ИмяДокЛогистика = Сред(ИмяДокЛогистика, 3);
		МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].ТабличныеЧасти.Товары.Реквизиты;
	Иначе
		ЭтоТЧ = Ложь;
		МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].Реквизиты;
	КонецЕсли;
	
	Если ЭтоТЧ Тогда 
		МассивОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивОбязательныхРеквизитовТЧ();
		МассивУсловноОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивУсловноОбязательныхРеквизитовТЧ();
	Иначе
		МассивОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивОбязательныхРеквизитов();
		МассивУсловноОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивУсловноОбязательныхРеквизитов();
	КонецЕсли;
	
	КлючевыеРеквизитыСАвтоматическимЗаполнением = Документы["КонтурЛогистика_" + ИмяДокЛогистика].КлючевыеРеквизитыСАвтоматическимЗаполнением();
	
	// реквизиты из метаданных
	Для Каждого Реквизит Из МетаданыеРеквизитов Цикл
		
		// реквизиты связи с предыдущими титулами и прочие ключевые, которые программа сама знает как заполнять
		КлючевыеРеквизитыСАвтоматическимЗаполнением = Документы["КонтурЛогистика_" + ИмяДокЛогистика].КлючевыеРеквизитыСАвтоматическимЗаполнением();
		Если КлючевыеРеквизитыСАвтоматическимЗаполнением.Найти(Реквизит.Имя) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		// реквизиты - исключения, которые не требуется заполнять в настройке конвертации - их заполнение регламентируется самим докумнетом
		Если ЭтоРеквизитИсключение(Реквизит.Имя) Тогда 
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуТЗОписанияРеквизитов(МассивОбязательныхРеквизитов, Реквизит, ТабличнаяЧастьНастройки, МассивУсловноОбязательныхРеквизитов);
		
	КонецЦикла;
	
	Если ЭтоТЧ Тогда 
		ТаблицаДополнительныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивДополнительныхРеквизитовТЧ();
	Иначе
		ТаблицаДополнительныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивДополнительныхРеквизитов();
	КонецЕсли;
	
	Для Каждого Реквизит Из ТаблицаДополнительныхРеквизитов Цикл
		ДобавитьСтрокуТЗОписанияРеквизитов(МассивОбязательныхРеквизитов, Реквизит, ТабличнаяЧастьНастройки, МассивУсловноОбязательныхРеквизитов);
	КонецЦикла;
	
	ТабличнаяЧастьНастройки.Сортировать("Картинка Возр, РеквизитТитула");
	
КонецПроцедуры	

Функция ЭтоРеквизитИсключение(Имя) Экспорт
	
	Если Имя = "УИД"
		ИЛИ Имя = "УИД_ПЛ"  
		ИЛИ Имя = "УИД_Зак"  
		ИЛИ Имя = "НомИспр"  
		ИЛИ Имя = "ДатаИспр"  
		ИЛИ Имя = "ДокументОснование"  
		ИЛИ Имя = "Разделитель"  
		ИЛИ Имя = "ДокументЭТРН"  
		ИЛИ Имя = "ДокументЗН"  
		ИЛИ Имя = "ИдентификаторСтроки"
		ИЛИ Имя = "Свернута"
		ИЛИ Имя = "КомментарииВодителяПриПогрузке"
		ИЛИ Имя = "КомментарииВодителяПриВыгрузке"
		ИЛИ Имя = "ВозвратМесто"
		ИЛИ Имя = "ПереадресовкаМесто"
		ИЛИ Имя = "ВозвратПолучатель"
		ИЛИ Имя = "ПереадресовкаПолучатель"
		ИЛИ Имя = "КоличествоПереадресовок"
		ИЛИ Имя = "КоличествоСменВодителей"
		ИЛИ Имя = "КоличествоСменТС" 
		ИЛИ Имя = "СозданВручную" Тогда
		
		Возврат Истина;
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции 

Процедура ДобавитьСтрокуТЗОписанияРеквизитов(Знач МассивОбязательныхРеквизитов, Знач Реквизит, ТабличнаяЧастьНастройки, Знач МассивУсловноОбязательныхРеквизитов)
	
	НоваяСтрокаТч = ТабличнаяЧастьНастройки.Добавить();
	НоваяСтрокаТч.РеквизитТитула = Реквизит.Имя;
	Если МассивОбязательныхРеквизитов.Найти(Реквизит.Имя) <> Неопределено Тогда 
		НоваяСтрокаТч.Картинка = 1;
	ИначеЕсли МассивУсловноОбязательныхРеквизитов.Найти(Реквизит.Имя) <> Неопределено Тогда 
		НоваяСтрокаТч.Картинка = 2;
	Иначе
		НоваяСтрокаТч.Картинка = 3;
	КонецЕсли;
	НоваяСтрокаТч.РеквизитТитулаТипЗначения = Реквизит.Тип;
	НоваяСтрокаТч.РеквизитТитулаКомментарий = Реквизит.Комментарий;
	
	Попытка
		
		Если Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Договоры") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ПодразделенияДиадок") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПодразделениеДиадок;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Лицензии") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВЛицензию;
		ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ГорючеСмазочныеМатериалы") Тогда 
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВГорючеСмазочныйМатериал;
		Иначе
			НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
		КонецЕсли;
		
	Исключение
		
		НоваяСтрокаТч.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
		
	КонецПопытки;
	
	НоваяСтрокаТч.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
	НоваяСтрокаТч.ВыражениеВычисления = "";
	
КонецПроцедуры

Функция РассчитатьРазделительДокументаУчетнойСистемы(ТипЛогистика, ДокументОснованиеУчетнойСистемы) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОснованиеУчетнойСистемы) Тогда 
		
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ТипЛогистика, ДокументОснованиеУчетнойСистемы)
		
	Иначе
		
		НастройкаКонвертации = Неопределено;
		
	КонецЕсли;

	Если НастройкаКонвертации = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(НастройкаКонвертации.Разделитель) 
		Или НастройкаКонвертации.Разделитель = Перечисления.КонтурЛогистика_ВариантыРазделителя.НеРазделять Тогда 
		
		Разделитель = Неопределено;
		
	Иначе
		
		Основание = ДокументОснованиеУчетнойСистемы;
		
		// разделитель задан кодом на языке 1С
		Если НастройкаКонвертации.Разделитель = Перечисления.КонтурЛогистика_ВариантыРазделителя.ВычислитьМассивВыражениемНаЯзыке1С Тогда
			
			ВыражениеВычисления = НастройкаКонвертации.РазделительКодНа1С;
			РезультатВычисления = Неопределено;
			
			Параметры = Новый Структура;
			Параметры.Вставить("ТипЛогистика", ТипЛогистика);
			Параметры.Вставить("Основание", Основание);
			Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
			
			ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
				ВыражениеВычисления, Параметры);
			
			Разделитель = ВычисленноеЗначение;
			
		// разделитель в табличной части
		ИначеЕсли НастройкаКонвертации.Разделитель = Перечисления.КонтурЛогистика_ВариантыРазделителя.РеквизитТабличнойЧастиДокумента Тогда
			
			Табчасть = Основание[НастройкаКонвертации.РазделительИмяТЧ];
			МассивРазделителейНесвернутый = Табчасть.ВыгрузитьКолонку(НастройкаКонвертации.РазделительИмяРеквизита);
			
			МассивРазделителейСвернутый = Новый Массив;
			Соответствие = Новый Соответствие;
			Для каждого ЭлементМассива Из МассивРазделителейНесвернутый Цикл
				Соответствие.Вставить(ЭлементМассива);
			КонецЦикла;
			Для каждого КлючИЗначение Из Соответствие Цикл
				МассивРазделителейСвернутый.Добавить(КлючИЗначение.Ключ);
			КонецЦикла;
			
			Разделитель = МассивРазделителейСвернутый;
			
		ИначеЕсли НастройкаКонвертации.Разделитель = Перечисления.КонтурЛогистика_ВариантыРазделителя.СвязанныеДокументы Тогда
			
			ВызватьИсключение "Вариант заполнения разделителя СвязанныеДокументы не реализован в этой версии";
		Иначе
			Разделитель = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Разделитель) = Тип("Массив") Тогда 
		Разделитель = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СвернутьМассив_(Разделитель);
	КонецЕсли;
	
	Возврат Разделитель;
	
КонецФункции

Функция ВычислитьУсловиеГруппировкиСтрокиТоваров(СтрокаТоваров, Объект, НастройкаКонвертации) Экспорт 
	
	// может быть задана в партнере
	Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И ЗначениеЗаполнено(Объект.ДокументЭТРН) 
		И ЗначениеЗаполнено(Объект.ДокументЭТРН.ПартнерГрузополучатель) Тогда 
		
		УсловиеГруппировкиСтрокТоваровПартнера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(Объект.ДокументЭТРН.ПартнерГрузополучатель, "УсловиеГруппировкиСтрокТоваров");
		
	Иначе
		
		УсловиеГруппировкиСтрокТоваровПартнера = "";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УсловиеГруппировкиСтрокТоваровПартнера)
		Или ЗначениеЗаполнено(НастройкаКонвертации.УсловиеГруппировкиСтрокТоваров) Тогда 
		
		Если ЗначениеЗаполнено(УсловиеГруппировкиСтрокТоваровПартнера) Тогда
			ВыражениеВычисления = УсловиеГруппировкиСтрокТоваровПартнера;
		Иначе
			ВыражениеВычисления = НастройкаКонвертации.УсловиеГруппировкиСтрокТоваров;
		КонецЕсли;
		
		РезультатВычисления = Неопределено;
		
		Параметры = Новый Структура;
		Параметры.Вставить("СтрокаТоваров", СтрокаТоваров);
		Параметры.Вставить("Объект", Объект);
		Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
		
		ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			ВыражениеВычисления, Параметры);
		
		Возврат Строка(ВычисленноеЗначение);
		
	Иначе
		
		Возврат "Неопределено";
		
	КонецЕсли;	
	
КонецФункции	

Функция ЕстьМаппингОтправителяШаблонаВТ1() Экспорт

	ЕстьМаппинг = Ложь;

	Настройка = ПолучитьНастройкуКонвертации(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
	
	Если Не Настройка = Неопределено Тогда
		
		НайденноеПравило = Настройка.ПравилаКонвертацииТитулаРеквизиты.Найти("ОтправительШаблона", "РеквизитТитула");

		Если Не НайденноеПравило = Неопределено
			 И ЗначениеЗаполнено(НайденноеПравило.СпособМаппинга)
			 И Не НайденноеПравило.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять Тогда

			ЕстьМаппинг = Истина;

		КонецЕсли;

	КонецЕсли;	
	
	Возврат ЕстьМаппинг;
	
КонецФункции

Функция ЕстьДочерниеНастройкиКонвертации(НастройкаКонвертацииДокументаСсылка) Экспорт
	
	Возврат ПолучитьМассивДочернихНастроекКонвертации(НастройкаКонвертацииДокументаСсылка).Количество() > 0;
	
КонецФункции

Функция ПолучитьМассивДочернихНастроекКонвертации(НастройкаКонвертацииДокументаСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертацииДокументаСсылка) 
		ИЛИ ЗначениеЗаполнено(НастройкаКонвертацииДокументаСсылка.Родитель) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = &Ссылка
	|	И (КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее)
	|		ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее))";
	
	Запрос.УстановитьПараметр("Ссылка", НастройкаКонвертацииДокументаСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МассивНастроек = новый Массив;
	
	Пока Выборка.Следующий() Цикл  
	
		МассивНастроек.Добавить(Выборка.Ссылка);	
	
	КонецЦикла;
	
	Возврат МассивНастроек;
	
КонецФункции

Функция ТипыДокументаОснованияНастроеныДляТитула(НомерТитула) Экспорт 
	
	ТипыНастроены = Истина;
	
	РеквизитМД = Метаданные.Документы["КонтурЛогистика_ТрН_Титул1"].Реквизиты.ДокументОснование;
	
	МассивТипов = РеквизитМД.Тип.Типы();
	
	Если МассивТипов.Количество() = 1 И МассивТипов.Найти(Тип("ДокументСсылка.КонтурЛогистика_Вспомогательный")) = 0 Тогда 
		
		ТипыНастроены = Ложь;
		
	КонецЕсли;
	
	Возврат ТипыНастроены;
		
КонецФункции

Функция НужнаОбработка(НастройкаКонвертацииДокументаСсылка) Экспорт
	
	Если НастройкаКонвертацииДокументаСсылка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Загрузка
		Или НастройкаКонвертацииДокументаСсылка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного
		Или НастройкаКонвертацииДокументаСсылка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика
		Или НастройкаКонвертацииДокументаСсылка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного Тогда
		
		Возврат Истина
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Функция ПоискОснованийКодНа1СПоУсолчанию(ТипДокумента1С) Экспорт
	
	ПоискОснованийКодНа1СПоУмолчанию = 
		"Запрос = Новый Запрос;
		|Запрос.Текст = ""ВЫБРАТЬ
		|	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
		|	|ИЗ
		|	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|	|ГДЕ
		|	|	НАЧАЛОПЕРИОДА (РеализацияТоваровУслуг.Дата, ДЕНЬ) = &Дата
		|	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|	| 	И РеализацияТоваровУслуг.Контрагент = &Контрагент"";
		|Запрос.УстановитьПараметр(""Дата"", НачалоДня(ДокументОснование.Дата));
		|Запрос.УстановитьПараметр(""Контрагент"", ДокументОснование.Контрагент);
		|Результат = Запрос.Выполнить();
		|МассивДокументыОснования= Результат.Выгрузить().ВыгрузитьКолонку(""Ссылка"");";
	
	Если ЗначениеЗаполнено(ТипДокумента1С) Тогда
		ПоискОснованийКодНа1СПоУмолчанию = СтрЗаменить(ПоискОснованийКодНа1СПоУмолчанию, "РеализацияТоваровУслуг", ТипДокумента1С);
	КонецЕсли;

	Возврат ПоискОснованийКодНа1СПоУмолчанию;
	
КонецФункции

#Область ДинамическоеФормированиеЗапросаСпискаЗадач

Процедура МеханизмКастомизацииСписков(ТипЛогистика, СпецСценарий, НастройкаКонвертации, РезультатаФормированияЗапроса, ТипДокументаКонфигурации, ИспользоватьДопКолонки = Истина)
	
	ТекущийТекстЗапроса = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
	
	Если Не ЗначениеЗаполнено(ТекущийТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьДопУсловиеГДЕ = (Найти(ТекущийТекстЗапроса, "//ДопУсловиеГДЕ") <> 0);
	
	// Дополнительные источники
	ТипыДокументов1С = Новый Массив;
	Если ТипДокументаКонфигурации = "Все типы" Или ТипДокументаКонфигурации = Неопределено Или ТипДокументаКонфигурации = "Ручной ввод" Тогда
		НастроенныеТипыДокументов1СМассив = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьТипыЗначенияДокумента1С(ТипЛогистика);
		Для Каждого ТипДокумента Из НастроенныеТипыДокументов1СМассив Цикл
			Если ЗначениеЗаполнено(ТипДокумента) Тогда
				ТипыДокументов1С.Добавить(ТипДокумента);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ТипыДокументов1С.Добавить(ТипДокументаКонфигурации);
	КонецЕсли;
	
	НастройкиКонвертации = Новый Соответствие;
	Для Каждого ТекущийТипДокументаКонфигурации Из ТипыДокументов1С Цикл
		
		НастройкаКонвертацииСсылка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
			ТипЛогистика, ТекущийТипДокументаКонфигурации, СпецСценарий);
		Если Не ЗначениеЗаполнено(НастройкаКонвертацииСсылка) Тогда
			Продолжить;
		КонецЕсли;
		НастройкиКонвертации.Вставить(ТекущийТипДокументаКонфигурации, НастройкаКонвертацииСсылка);
		
		Если ЗначениеЗаполнено(НастройкаКонвертацииСсылка.ДополнительныеИсточники) Тогда
			СтрокаПоискаДокумента = "Документ." + НастройкаКонвертацииСсылка.ТипДокумента1С + " КАК " + НастройкаКонвертацииСсылка.ТипДокумента1С;
			ТекущийТекстЗапроса = СтрЗаменить(ТекущийТекстЗапроса, СтрокаПоискаДокумента, НастройкаКонвертацииСсылка.ДополнительныеИсточники);
		КонецЕсли;
		
	КонецЦикла;
	
	// Требуемое действие для статуса СформированыФайлыОбмена при отправке в фоне / не в фоне
	ТребуемоеДействиеПараметр = "&ТребуемоеДействиеКостыль";
	Если НастройкаКонвертации.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе
		Или НастройкаКонвертации.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе Тогда
		
		ТекущийТекстЗапроса = СтрЗаменить(ТекущийТекстЗапроса, ТребуемоеДействиеПараметр,
			"ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление)");
		
	Иначе	
		
		ТекущийТекстЗапроса = СтрЗаменить(ТекущийТекстЗапроса, ТребуемоеДействиеПараметр, 
			"ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен)");
		
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекущийТекстЗапроса);
	
	// Дополнительные условия
	Для Каждого ТекущийТипДокументаКонфигурации Из ТипыДокументов1С Цикл
		
		НастройкаКонвертацииСсылка = НастройкиКонвертации.Получить(ТекущийТипДокументаКонфигурации);
		Если НастройкаКонвертацииСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Основные колонки
		Если СпецСценарий <> Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя Тогда
			ДобавитьОсновныеКолонки(НастройкаКонвертацииСсылка, СхемаЗапроса);
		КонецЕсли;
		
		// Дополнительные колонки
		Если СпецСценарий <> Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя
			И ТипДокументаКонфигурации <> "Ручной ввод" И ТипыДокументов1С.Количество() = 1 Тогда
			ДобавитьДополнительныеКолонки(НастройкаКонвертацииСсылка, СхемаЗапроса);
		КонецЕсли;
		
		ОператорЗапроса = НайтиОператорПоПсевдонимуИсточникаРекурсивно(СхемаЗапроса.ПакетЗапросов[0].Операторы, НастройкаКонвертацииСсылка.ТипДокумента1С);
		Если ОператорЗапроса <> Неопределено Тогда
			Для Каждого ТекущееУсловие Из НастройкаКонвертацииСсылка.ДополнительныеУсловия Цикл
				ОператорЗапроса.Отбор.Добавить(ТекущееУсловие.ТекстУсловия);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатаФормированияЗапроса.ПолныйТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Если ЕстьДопУсловиеГДЕ Тогда
		ВернутьДопУсловияИСоединенияВТекстЗапроса(РезультатаФормированияЗапроса.ПолныйТекстЗапроса);
	КонецЕсли;
	
	// Дополнительные параметры
	Для Каждого ТекущийТипДокументаКонфигурации Из ТипыДокументов1С Цикл
		НастройкаКонвертацииСсылка = НастройкиКонвертации.Получить(ТекущийТипДокументаКонфигурации);
		Если НастройкаКонвертацииСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьДополнительныеПараметры(НастройкаКонвертацииСсылка, РезультатаФормированияЗапроса);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОсновныеКолонки(НастройкаКонвертации, СхемаЗапроса)
	
	ИмяТаблицыИсточникаДанных = ИмяТаблицыИсточникаДанных(НастройкаКонвертации.ТипДокументаЛогистика);
	ИменаДополнительныхТаблиц = ИменаДополнительныхТаблиц(НастройкаКонвертации);
	ИменаОсновныхКолонок = ИменаОсновныхКолонокСписка();
	
	Для Каждого ИмяКолонки Из ИменаОсновныхКолонок Цикл
		
		ОператорЗапроса = НайтиОператорПоПсевдонимуИсточникаРекурсивно(
			СхемаЗапроса.ПакетЗапросов[0].Операторы, НастройкаКонвертации.ТипДокумента1С);
		ИсточникОператора = НайтиИсточникПоПсевдонимуРекурсивно(
			СхемаЗапроса.ПакетЗапросов[0].Операторы, ИмяТаблицыИсточникаДанных, НастройкаКонвертации.ТипДокумента1С);
		
		Если ИсточникОператора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ВыбираемыеПоляИтоговойВыборки = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
		
		ПутьКДанным = НастройкаКонвертации["Путь" + ИмяКолонки];
		
		// Добавим только с данными из дополнительных таблиц
		Для Каждого ТекущееИмяТаблицы Из ИменаДополнительныхТаблиц Цикл
			
			Если Найти(ПутьКДанным, ТекущееИмяТаблицы) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Добавим дополнительные колонки в "втДокументы"
			ДополнительноеПоле = ИсточникОператора.Источник.ДоступныеПоля.Найти(ИмяКолонки);
			Если ДополнительноеПоле <> Неопределено Тогда
				// Изменим существующее
				ИндексДополнительногоПоля = ИсточникОператора.Источник.ДоступныеПоля.Индекс(ДополнительноеПоле);
				
				ВыражениеСхемыЗапроса = Новый ВыражениеСхемыЗапроса(ПутьКДанным);
				ОператорЗапроса.ВыбираемыеПоля.Установить(ИндексДополнительногоПоля, ВыражениеСхемыЗапроса);
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДополнительныеКолонки(НастройкаКонвертации, СхемаЗапроса)
	
	ИмяТаблицыИсточникаДанных = ИмяТаблицыИсточникаДанных(НастройкаКонвертации.ТипДокументаЛогистика);
	ИменаДополнительныхТаблиц = ИменаДополнительныхТаблиц(НастройкаКонвертации);
	
	Если НастройкаКонвертации.Сценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя Тогда
		ПрефиксПутиКДанным = "ПодзапросТекущийТ1СоСменами.ДокументОснование";
	ИначеЕсли НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
		Или НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		ПрефиксПутиКДанным = НастройкаКонвертации.ТипДокумента1С;
	Иначе
		ПрефиксПутиКДанным = "ПодзапросТекущийТитул.ДокументОснование";
	КонецЕсли;
	
	Для Каждого ТекущаяКолонка Из НастройкаКонвертации.ДополнительныеКолонки Цикл
			
		Если Не ТекущаяКолонка.ДобавленИзКонструктораЗапроса Тогда			
			ДобавитьДополнительнуюКолонку(НастройкаКонвертации, СхемаЗапроса, ТекущаяКолонка);																		
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ИмяТаблицыИсточникаДанных) Тогда
		
		// Первые титулы на основе учетного документа
		ОператорЗапроса = НайтиОператорПоПсевдонимуИсточникаРекурсивно(
			СхемаЗапроса.ПакетЗапросов[0].Операторы, НастройкаКонвертации.ТипДокумента1С);
		ИсточникОператора = НайтиИсточникПоПсевдонимуРекурсивно(
			СхемаЗапроса.ПакетЗапросов[0].Операторы, ИмяТаблицыИсточникаДанных, НастройкаКонвертации.ТипДокумента1С);
		
		Если ИсточникОператора = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОператорЗапросаИсточникаДанных = НайтиОператорПоПсевдонимуИсточникаРекурсивно(
			СхемаЗапроса.ПакетЗапросов[0].Операторы, ИсточникОператора.Источник.Псевдоним, НастройкаКонвертации.ТипДокумента1С);
		Если ОператорЗапросаИсточникаДанных = Неопределено Тогда
			ВыбираемыеПоляВыборки = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
		Иначе
			ВыбираемыеПоляВыборки = ОператорЗапросаИсточникаДанных.ВыбираемыеПоля;
		КонецЕсли;
		
		Для Каждого ТекущаяКолонка Из НастройкаКонвертации.ДополнительныеКолонки Цикл
			
			Если Не ТекущаяКолонка.ДобавленИзКонструктораЗапроса Тогда
				Продолжить;	
			КонецЕсли;
			
			ИмяКолонки = "Доп" + Формат(ТекущаяКолонка.НомерСтроки, "ЧГ=0");
			
			// Опеределим путь к данным
			ПутьКДанным = ПутьКДаннымДопКолонки(ИменаДополнительныхТаблиц, ПрефиксПутиКДанным, ТекущаяКолонка.ПутьКДанным);
			
			// Добавим дополнительные колонки в "втДокументы"
			ДополнительноеПоле = ИсточникОператора.Источник.ДоступныеПоля.Найти(ИмяКолонки);
			Если ДополнительноеПоле = Неопределено Тогда
				// Значит ее нет в штатном запросе, добавим.
				НовоеПоле = ОператорЗапроса.ВыбираемыеПоля.Добавить(ПутьКДанным);
				ИндексНовогоПоля = ОператорЗапроса.ВыбираемыеПоля.Индекс(НовоеПоле);
				
				ИсточникОператора.Источник.Запрос.Колонки[ИндексНовогоПоля].Псевдоним = ИмяКолонки;
			Иначе
				// Изменим существующее
				ИндексДополнительногоПоля = ИсточникОператора.Источник.ДоступныеПоля.Индекс(ДополнительноеПоле);
				
				ВыражениеСхемыЗапроса = Новый ВыражениеСхемыЗапроса(ПутьКДанным);
				ОператорЗапроса.ВыбираемыеПоля.Установить(ИндексДополнительногоПоля, ВыражениеСхемыЗапроса);
			КонецЕсли;
			
			// Добавим дополнительные колонки в итоговую выборку по документу
			Попытка
				НовоеПоле = ВыбираемыеПоляВыборки.Найти(ИмяКолонки);
				Если НовоеПоле = Неопределено Тогда
					ВыбираемыеПоляВыборки.Добавить(ИмяТаблицыИсточникаДанных + "." + ИмяКолонки);
				КонецЕсли;
			Исключение
				// Падает исключение, если не нашел по имени
				НичегоНеДелаем = Истина;
			КонецПопытки;
			
			// Добавим дополнительные колонки в итоговую выборку
			Попытка
				ВыбираемыеПоляИтоговойВыборки = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
				НовоеПоле = ВыбираемыеПоляИтоговойВыборки.Найти(ИмяКолонки);
				Если НовоеПоле = Неопределено Тогда
					ИмяТаблицыИсточникаИтоговыхДанных = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(
						СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля[0], ".")[0];
					ВыбираемыеПоляИтоговойВыборки.Добавить(ИмяТаблицыИсточникаИтоговыхДанных + "." + ИмяКолонки);
				КонецЕсли;
			Исключение
				// Падает исключение, если не нашел по имени
				НичегоНеДелаем = Истина;
			КонецПопытки;			
			
		КонецЦикла;
		
	Иначе
		
		// Для не первых титулов
		ОператорЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
		
		ВыбираемыеПоляИтоговойВыборки = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
		
		Для Каждого ТекущаяКолонка Из НастройкаКонвертации.ДополнительныеКолонки Цикл
			
			Если Не ТекущаяКолонка.ДобавленИзКонструктораЗапроса Тогда
				Продолжить;	
			КонецЕсли;
			
			ИмяКолонки = "Доп" + Формат(ТекущаяКолонка.НомерСтроки, "ЧГ=0");
			
			// Опеределим путь к данным
			ПутьКДанным = ПутьКДаннымДопКолонки(ИменаДополнительныхТаблиц, ПрефиксПутиКДанным, ТекущаяКолонка.ПутьКДанным);
			
			// Добавим дополнительные колонки
			ДополнительноеПоле = СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(ИмяКолонки);
			Если ДополнительноеПоле = Неопределено Тогда
				// Значит ее нет в штатном запросе, добавим.
				НовоеПоле = ОператорЗапроса.ВыбираемыеПоля.Добавить(ПутьКДанным);
				ИндексНовогоПоля = ОператорЗапроса.ВыбираемыеПоля.Индекс(НовоеПоле);
				
				СхемаЗапроса.ПакетЗапросов[0].Колонки[ИндексНовогоПоля].Псевдоним = ИмяКолонки;
			Иначе
				// Изменим существующее
				ИндексДополнительногоПоля = СхемаЗапроса.ПакетЗапросов[0].Колонки.Индекс(ДополнительноеПоле);
				
				ВыражениеСхемыЗапроса = Новый ВыражениеСхемыЗапроса(ПутьКДанным);
				ОператорЗапроса.ВыбираемыеПоля.Установить(ИндексДополнительногоПоля, ВыражениеСхемыЗапроса);
			КонецЕсли;
			
			// Добавим дополнительные колонки в итоговую выборку
			НовоеПоле = ВыбираемыеПоляИтоговойВыборки.Найти(ПутьКДанным);
			Если НовоеПоле = Неопределено Тогда
				ВыбираемыеПоляИтоговойВыборки.Добавить(ПутьКДанным);
			КонецЕсли;			
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьДополнительнуюКолонку(НастройкаКонвертации, СхемаЗапроса, ТекущаяКолонка)
				
	ИмяКолонки = "Доп" + Формат(ТекущаяКолонка.НомерСтроки, "ЧГ=0");
	Источник = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ТекущаяКолонка.ПутьКДанным, ".")[0];
	
	ОператорЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
	
	ДополнительнаяКолонка = СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(ИмяКолонки);
	Если ДополнительнаяКолонка = Неопределено Тогда
					
		Если ТекущаяКолонка.СтрокаНеограниченнойДлины Тогда						
			ПутьКДанным = "ВЫРАЗИТЬ(" + ТекущаяКолонка.ПутьКДанным + " КАК СТРОКА(1000))";
			НовоеПоле = ОператорЗапроса.ВыбираемыеПоля.Добавить(ПутьКДанным);
		Иначе
			НовоеПоле = ОператорЗапроса.ВыбираемыеПоля.Добавить(ТекущаяКолонка.ПутьКДанным);
		КонецЕсли;
		
		ИндексНовогоПоля = ОператорЗапроса.ВыбираемыеПоля.Индекс(НовоеПоле);				
		СхемаЗапроса.ПакетЗапросов[0].Колонки[ИндексНовогоПоля].Псевдоним = ИмяКолонки;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(НастройкаКонвертации.ТипДокументаЛогистика) = "1"
			И Источник = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НастройкаКонвертации.ТипДокументаЛогистика) 
			И СхемаЗапроса.ПакетЗапросов[0].Операторы.Количество() > 1 Тогда
			
			Если ТекущаяКолонка.СтрокаНеограниченнойДлины Тогда						
				ПутьКДанным = "ВЫРАЗИТЬ(" + ТекущаяКолонка.ПутьКДанным + " КАК СТРОКА(1000))";
				НовоеПоле = СхемаЗапроса.ПакетЗапросов[0].Операторы[1].ВыбираемыеПоля.Добавить(ПутьКДанным);
			Иначе
				НовоеПоле = СхемаЗапроса.ПакетЗапросов[0].Операторы[1].ВыбираемыеПоля.Добавить(ТекущаяКолонка.ПутьКДанным);
			КонецЕсли;
				
		КонецЕсли;
						
	Иначе
		
		ИндексДополнительногоПоля = СхемаЗапроса.ПакетЗапросов[0].Колонки.Индекс(ДополнительнаяКолонка);				
		
		Если ТекущаяКолонка.СтрокаНеограниченнойДлины Тогда						
			ПутьКДанным = "ВЫРАЗИТЬ(" + ТекущаяКолонка.ПутьКДанным + " КАК СТРОКА(1000))";
			ВыражениеСхемыЗапроса = Новый ВыражениеСхемыЗапроса(ПутьКДанным);
		Иначе
			ВыражениеСхемыЗапроса = Новый ВыражениеСхемыЗапроса(ТекущаяКолонка.ПутьКДанным);
		КонецЕсли;
		
		ОператорЗапроса.ВыбираемыеПоля.Установить(ИндексДополнительногоПоля, ВыражениеСхемыЗапроса);
		
		ДополнительнаяКолонка.Псевдоним = ИмяКолонки;
										
	КонецЕсли;
				
КонецПроцедуры

Функция ПутьКДаннымДопКолонки(ИменаДополнительныхТаблиц, ПрефиксПутиКДанным, ТекущийПутьКДанным) Экспорт
	
	ПутьКДанным = "";
	
	Если ТекущийПутьКДанным = "" Тогда
		Возврат ПутьКДанным;
	КонецЕсли;
	
	// предопределенный источник для титулов кроме 1
	Если Лев(ТекущийПутьКДанным, 25) = "ПодзапросПредыдущийТитул." Тогда 
		Возврат ТекущийПутьКДанным;
	КонецЕсли;
	
	Если Найти(ТекущийПутьКДанным, ПрефиксПутиКДанным) <> 0 Тогда
		Возврат ТекущийПутьКДанным;
	КонецЕсли;
	
	Для Каждого ТекущееИмяТаблицы Из ИменаДополнительныхТаблиц Цикл
		Если Найти(ТекущийПутьКДанным, ТекущееИмяТаблицы) <> 0 Тогда
			ПутьКДанным = ТекущийПутьКДанным;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПутьКДанным = "" Тогда
		ПутьКДанным = ПрефиксПутиКДанным + "." + ТекущийПутьКДанным;
	КонецЕсли;
	
	Возврат ПутьКДанным;
	
КонецФункции

Процедура ДобавитьДополнительныеПараметры(НастройкаКонвертации, РезультатаФормированияЗапроса)
	
	Для Каждого ТекущийПараметр Из НастройкаКонвертации.ДополнительныеПараметры Цикл
		
		Если ЗначениеЗаполнено(ТекущийПараметр.Значение) Тогда
			
			ТекущееЗначение = ТекущийПараметр.Значение;
			
		ИначеЕсли ЗначениеЗаполнено(ТекущийПараметр.Вычисление) Тогда
			
			Параметры = Новый Структура;
			Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
			Параметры.Вставить("ТекущийПараметр", ТекущийПараметр);
			
			ТекущееЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
				ТекущийПараметр.Вычисление, Параметры);
			
		Иначе
			
			ТекущееЗначение = Неопределено;
			
		КонецЕсли;
		
		Если ТекущееЗначение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатаФормированияЗапроса.СтруктураПараметровЗапроса.Вставить(ТекущийПараметр.Имя, ТекущееЗначение);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОбязательныеУсловияЗапроса(ТекстЗапроса, ТипДокумента1С) Экспорт
	
	ОбязательныеУсловияЗапроса = Новый Массив;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ОператорЗапроса = НайтиОператорПоПсевдонимуИсточникаРекурсивно(СхемаЗапроса.ПакетЗапросов[0].Операторы, ТипДокумента1С);
	Если ОператорЗапроса <> Неопределено Тогда
		Для Каждого ТекущийОтбор Из ОператорЗапроса.Отбор Цикл
			ОбязательныеУсловияЗапроса.Добавить(Строка(ТекущийОтбор));
		КонецЦикла;
	КонецЕсли;
	
	Возврат ОбязательныеУсловияЗапроса;
	
КонецФункции

Функция НайтиОператорПоПсевдонимуИсточникаРекурсивно(Операторы, Псевдоним, ТипДокумента1С = Неопределено)
	
	Для Каждого ТекущийОператор Из Операторы Цикл
		
		РезультатПоиска = ТекущийОператор.Источники.НайтиПоПсевдониму(Псевдоним);
		
		Если РезультатПоиска <> Неопределено Тогда
			
			Если ТипДокумента1С = Неопределено Тогда
				Возврат ТекущийОператор;
			Иначе
				// Проверим, что внутри есть нужная таблица
				НайденныйОператор = НайтиОператорПоПсевдонимуИсточникаРекурсивно(РезультатПоиска.Источник.Запрос.Операторы, ТипДокумента1С);
				Если НайденныйОператор <> Неопределено Тогда
					Возврат ТекущийОператор;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ТекущийИсточник Из ТекущийОператор.Источники Цикл
			Если ТипЗнч(ТекущийИсточник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
				
				РезультатПоиска = НайтиОператорПоПсевдонимуИсточникаРекурсивно(
					ТекущийИсточник.Источник.Запрос.Операторы, Псевдоним, ТипДокумента1С);
				
				Если РезультатПоиска <> Неопределено Тогда
					Возврат РезультатПоиска;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции

Функция НайтиИсточникПоПсевдонимуРекурсивно(Операторы, Псевдоним, ТипДокумента1С = Неопределено)
	
	Для Каждого ТекущийОператор Из Операторы Цикл
		
		РезультатПоиска = ТекущийОператор.Источники.НайтиПоПсевдониму(Псевдоним);
		
		Если РезультатПоиска <> Неопределено Тогда
			
			Если ТипДокумента1С = Неопределено Тогда
				Возврат РезультатПоиска;
			Иначе
				// Проверим, что внутри есть нужная таблица
				НайденныйОператор = НайтиОператорПоПсевдонимуИсточникаРекурсивно(РезультатПоиска.Источник.Запрос.Операторы, ТипДокумента1С);
				Если НайденныйОператор <> Неопределено Тогда
					Возврат РезультатПоиска;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ТекущийИсточник Из ТекущийОператор.Источники Цикл
			Если ТипЗнч(ТекущийИсточник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
				
				РезультатПоиска = НайтиИсточникПоПсевдонимуРекурсивно(ТекущийИсточник.Источник.Запрос.Операторы, Псевдоним, ТипДокумента1С);
				
				Если РезультатПоиска <> Неопределено Тогда
					Возврат РезультатПоиска;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции

Функция ИмяТаблицыИсточникаДанных(ТипДокументаЛогистика)
	
	ИмяТаблицыИсточникаДанных = "";
	
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		ИмяТаблицыИсточникаДанных = "втДокументы";
		
	Иначе
		
		ИмяТаблицыИсточникаДанных = "";
		
	КонецЕсли;
	
	Возврат ИмяТаблицыИсточникаДанных;
	
КонецФункции

Функция ИменаТаблицИзДополнительныхИсточников(ДополнительныеИсточники) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ДополнительныеИсточники) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	" + ДополнительныеИсточники;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	Для Каждого ТекущийИсточник Из СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники Цикл
		Результат.Добавить(ТекущийИсточник.Источник.Псевдоним);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИменаДополнительныхТаблиц(НастройкаКонвертации, ТекущиеИсточники = Неопределено) Экспорт
	
	ИменаДополнительныхТаблиц = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИменаТаблицИзДополнительныхИсточников(
		НастройкаКонвертации.ДополнительныеИсточники);
	
	НайденныйЭлемент = ИменаДополнительныхТаблиц.Найти(НастройкаКонвертации.ТипДокумента1С);
	Если НайденныйЭлемент <> Неопределено Тогда
		ИменаДополнительныхТаблиц.Удалить(НайденныйЭлемент);
	КонецЕсли;
	
	Если ТекущиеИсточники <> Неопределено Тогда		
		Для каждого Источник Из ТекущиеИсточники Цикл
			Если Найти(НастройкаКонвертации.ДополнительныеИсточники, Источник.Источник.Псевдоним) = 0 Тогда
				ИменаДополнительныхТаблиц.Добавить(Источник.Источник.Псевдоним);		
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
	Возврат ИменаДополнительныхТаблиц;
	
КонецФункции

