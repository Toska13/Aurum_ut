	//	
	//Иначе
		
		МассивТипов1С.Добавить(ТипДокументаКонфигурации1С);
		
	//КонецЕсли;
	
	Для Каждого ТипДокументаКонфигурации Из МассивТипов1С Цикл
		
		// сформируем заново
		ИтоговыйТекстЗапроса1Документа = БазовыйТекстЗапроса;
		
		// спросить настройки конвертации документа 1с по типу док мерк
		НастройкаКонвертацииСсылка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика, ТипДокументаКонфигурации);
		
		Если НастройкаКонвертацииСсылка = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		// TODO для запроса с отправкой титула на основании другого титула - сделать свои обработчики кастомизации
		//// Замены:
		//
		//// реквизитов >> колонок списка задач
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Организация");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Контрагент");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Перевозчик");
		//
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Грузоотправитель");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Грузополучатель");
		//
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Доп1");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Доп2");
		
		// самого документа учетной системы
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, "КонтурЛогистика_Вспомогательный", НастройкаКонвертацииСсылка.ТипДокумента1С);
		
		// Меняем кастомные поля:
		// TODO сделать кастомизацию////////////////////////////////////////////
		КастомизированныйТекстЗапроса = ИтоговыйТекстЗапроса1Документа;
		////////////////////////////////////////////////////////////////////////
		
		
		МассивЗапросов.Добавить(КастомизированныйТекстЗапроса);
		
	КонецЦикла;	
		
	Для Каждого ТекстЗапроса Из МассивЗапросов Цикл
		
		Если ПолныйТекстЗапроса = "" Тогда 
			
			ПолныйТекстЗапроса = ТекстЗапроса;
			
		Иначе
			
			ПолныйТекстЗапроса = ПолныйТекстЗапроса + "
				|ОБЪЕДИНИТЬ ВСЕ
				|" +
			СтрЗаменить(ТекстЗапроса, " РАЗРЕШЕННЫЕ", "");	
		
		КонецЕсли;
		
	КонецЦикла;
	
	// подменяем источник требуемого действия для состояния документооборотв
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда 
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "Состояние.ТребуемоеДействиеТ1", "Состояние.ТребуемоеДействиеТ3"); 
	КонецЕсли;
	
	Если МассивЗапросов.Количество() > 1 Тогда // 8.2 не работает с объединенным запросом в ДС, нужно обернуть
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
		ПолныйТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ (
		|" + ПолныйТекстЗапроса + "
		|) КАК ОбъединеннаяТаблица";
	КонецЕсли;
	
	Возврат Новый Структура("ПолныйТекстЗапроса, СтруктураПараметровЗапроса", ПолныйТекстЗапроса, СтруктураПараметровЗапроса);

КонецФункции

Функция СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(ТипЛогистика, ТипДокументаКонфигурации1С, Знач БазовыйТекстЗапроса,
	СпецСценарий = Неопределено, НастройкаКонвертацииСсылка = Неопределено) Экспорт
	
	СпозиционироватьТекстЗапросаНаУказанныйТитул(ТипЛогистика, БазовыйТекстЗапроса);
	
	СтруктураПараметровЗапроса = Новый Структура; // сюда сложим параметры, потребовавшиеся при кастомизации
	
	ИтоговыйТекстЗапроса1Документа = БазовыйТекстЗапроса;
	
	// УсловиеНАШ - на сторону ПВ или ГП
	Если ЗначениеЗаполнено(НастройкаКонвертацииСсылка) 
		И НастройкаКонвертацииСсылка.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
		
		СформироватьОтборНаш(ИтоговыйТекстЗапроса1Документа, ТипЛогистика);
		
	КонецЕсли;
	
	ВыполнитьЗаменуВТекстеЗапросаПоДатеПредыдущего(ИтоговыйТекстЗапроса1Документа, ТипЛогистика);
	
	Если СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату 
		И ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		
		// требуется уточнить что в Т3 был прием возврата
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления",
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления 
		|И КонтурЛогистика_ПредыдущийТитул.ЭтоПриемВозврата");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления 
		|И КонтурЛогистика_ТекущийТитул.ЭтоПриемВозврата");
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		
		// требуется уточнить что в Т3 был НЕ прием возврата
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления",
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ПредыдущийТитул.ЭтоПриемВозврата");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ТекущийТитул.ЭтоПриемВозврата");
		
		// Чтобы не отображались в списке если был возврат, а отображались в возвратной цепочке
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1",
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА 
		|				ВЫБОР 
		|					КОГДА ПодзапросТекущийТитул.Ссылка.ПринятьЧастично Или ПодзапросТекущийТитул.Ссылка.ОтказВПриемке
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника)
		|					ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ4
		|				КОНЕЦ");
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		// требуется уточнить что в Т3 был НЕ прием возврата
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ТекущийТитул.ЭтоПриемВозврата");
		
		// грузополучатель должен быть наш (новый грузополучатель если была переадресовка с 0.11.0 размещается в ДокументЭТРН.Грузополучатель)
		// также у него должен быть флажок роли Грузополучатель
		Если ЗначениеЗаполнено(НастройкаКонвертацииСсылка) 
