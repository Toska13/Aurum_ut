Функция ТипыДокументаОснованияТитула(ТипДокумента, НомерТитула) Экспорт 
	
	Если ТипДокумента = "ПЛ_Титул_5_02" Тогда
		ИмяДокумента = "КонтурЛогистика_ПЛ_Титул" + НомерТитула + "_5_02";
	Иначе
		ИмяДокумента = "КонтурЛогистика_" + ТипДокумента + НомерТитула;	
	КонецЕсли;
	
	РеквизитМД = Метаданные.Документы[ИмяДокумента].Реквизиты.ДокументОснование;
	
	Возврат РеквизитМД.Тип.Типы();
				
