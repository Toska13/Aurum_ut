Функция МанифестРеквизитовПоУмолчанию(ИмяКонфигурации, ТипЛогистическогоДокумента, ТипДокумента1С)

	РеквизитыИЗначения = Новый Структура;
	
	Если ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		РеквизитыИЗначения.Вставить("ПутьНомерТРН", 			"Номер");
		РеквизитыИЗначения.Вставить("ПутьДатаТРН", 				"Дата");
		
		Если ИмяКонфигурации = "ТЛЭ"
			Или ИмяКонфигурации = "УАТ_ПРОФ"
			Или ИмяКонфигурации = "УАТ"
			Или ИмяКонфигурации = "ERP_УАТ" Тогда
			
			РеквизитыИЗначения.Вставить("ПутьПеревозчик", 			"Организация");
			РеквизитыИЗначения.Вставить("ПутьКонтрагент", 			"Контрагент");
			РеквизитыИЗначения.Вставить("ПутьГрузоотправитель", 	"Контрагент");
			РеквизитыИЗначения.Вставить("ПутьМестоПогрузки", 		"Гараж");
			РеквизитыИЗначения.Вставить("ПутьВодитель", 			"Водитель1");
			РеквизитыИЗначения.Вставить("ПутьТранспортноеСредство", "ТранспортноеСредство");
			
		ИначеЕсли ИмяКонфигурации = "КЛ" Тогда
			
			РеквизитыИЗначения.Вставить("ПутьПеревозчик", 			"Организация");
			РеквизитыИЗначения.Вставить("ПутьГрузоотправитель", 	"Организация");
			РеквизитыИЗначения.Вставить("ПутьМестоПогрузки", 		"Склад");
			РеквизитыИЗначения.Вставить("ПутьВодитель", 			"Водитель");
			РеквизитыИЗначения.Вставить("ПутьТранспортноеСредство", "ТранспортноеСредство");
			
		КонецЕсли;
		
	ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		
		РеквизитыИЗначения.Вставить("ПоискУчВариант", Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1);
		РеквизитыИЗначения.Вставить("ПутьПоискУчДокСвязь", "ДокументОснование");
		
	ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		
		РеквизитыИЗначения.Вставить("ПоискУчВариант", Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1);
		РеквизитыИЗначения.Вставить("ПутьПоискУчДокСвязь", "ДокументОснование");
		
	ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
		
		РеквизитыИЗначения.Вставить("ПоискУчВариант", Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1);
		РеквизитыИЗначения.Вставить("ПутьПоискУчДокСвязь", "ДокументОснование");
		
	ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		
		РеквизитыИЗначения.Вставить("ПоискУчВариант", Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1);
		РеквизитыИЗначения.Вставить("ПутьПоискУчДокСвязь", "ДокументОснование");
		
	ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		
		РеквизитыИЗначения.Вставить("ПоискУчВариант", Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1);
		РеквизитыИЗначения.Вставить("ПутьПоискУчДокСвязь", "ДокументОснование");
		
	ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
		
