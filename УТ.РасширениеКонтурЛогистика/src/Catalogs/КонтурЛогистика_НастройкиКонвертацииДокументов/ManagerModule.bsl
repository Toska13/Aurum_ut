Функция НастройкиВыполнены() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка) КАК Количество
	               |ИЗ
	               |	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	               |ГДЕ
	               |	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления"; 
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Количество > 0;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
