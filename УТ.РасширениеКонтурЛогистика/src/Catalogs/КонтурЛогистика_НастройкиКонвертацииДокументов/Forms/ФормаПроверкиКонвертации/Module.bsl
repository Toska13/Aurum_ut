
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("НастройкаКонвертации", НастройкаКонвертации);
	
	ТипРеквизита = Новый ОписаниеТипов("ДокументСсылка.КонтурЛогистика_" 
			+ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(НастройкаКонвертации.ТипДокументаЛогистика));
	
	Элементы.ОбъектЛогистика.ОграничениеТипа = ТипРеквизита;
	ОбъектЛогистика = ТипРеквизита.ПривестиЗначение();
	
	Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда
		
		ПредставлениеОбъекта1С = "";
		МетаданныеОбъекта1С = Метаданные.НайтиПоПолномуИмени("Документ." + НастройкаКонвертации.ТипДокумента1С);
		Если МетаданныеОбъекта1С <> Неопределено Тогда
			ПредставлениеОбъекта1С = МетаданныеОбъекта1С.Синоним;	
		КонецЕсли;
		
		Элементы.ОбъектЛогистика.Заголовок = "Документ логистика";
		Элементы.ТипОбъекта1С.Заголовок = "Учетный документ:";
		Элементы.Объект1С.Заголовок = ПредставлениеОбъекта1С;
				
	Иначе
		Элементы.ОбъектЛогистика.Заголовок = "Справочник";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	Реквизиты.Очистить();
	Товары.Очистить();
	ПрочиеТЧ.Очистить();
	Переменные.Очистить();
	
	Элементы.СтраницаРеквизиты.Картинка = Новый Картинка;
	Элементы.СтраницаТовары.Картинка = Новый Картинка;
	Элементы.СтраницаПрочиеТЧ.Картинка = Новый Картинка;
	Элементы.СтраницаПеременные.Картинка = Новый Картинка;
	
	ЕстьОшибкиВыполненияКонвертации = Ложь;
	
	ДокОб = Документы[НастройкаКонвертации.ТипДокумента1С].СоздатьДокумент();
	
	ДанныеДляПроверки = Неопределено;
	КонтурЛогистика_КонвертацияСервер.СконвертироватьДокументУчетнойСистемыПоТитулу(ОбъектЛогистика, ДокОб, НастройкаКонвертации, Ложь, Истина, ДанныеДляПроверки);
	
	Для каждого Реквизит Из ДокОб.Метаданные().Реквизиты Цикл
		
		НоваяСтрока = Реквизиты.Добавить();
		НоваяСтрока.Наименование = Реквизит.Имя;
		НоваяСтрока.ТипРеквизита = Реквизит.Тип;
		НоваяСтрока.Значение = ОбработатьЗначение(ДокОб[Реквизит.Имя]);
		
		Если ЗначениеЗаполнено(ДанныеДляПроверки) 
			И ДанныеДляПроверки.Свойство(Реквизит.Имя)
			И ЗначениеЗаполнено(ДанныеДляПроверки[Реквизит.Имя].ТекстОшибки) Тогда
		
			НоваяСтрока.ТекстОшибки = ДанныеДляПроверки[Реквизит.Имя].ТекстОшибки;
			ЕстьОшибкиВыполненияКонвертации = Истина;
			
			Элементы.СтраницаРеквизиты.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НастройкаКонвертации.ИмяТЧТоварыДокУчСист) Тогда
	
		Для каждого СтрокаТЧ Из ДокОб[НастройкаКонвертации.ИмяТЧТоварыДокУчСист] Цикл
			
			Для каждого РеквизитТЧ Из ДокОб.Метаданные().ТабличныеЧасти[НастройкаКонвертации.ИмяТЧТоварыДокУчСист].Реквизиты Цикл
				
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.НомерСтроки = СтрокаТЧ.НомерСтроки;
				НоваяСтрока.Наименование = РеквизитТЧ.Имя;
				НоваяСтрока.ТипРеквизита = РеквизитТЧ.Тип;
				НоваяСтрока.Значение = СтрокаТЧ[РеквизитТЧ.Имя];
				
				Если ПроверитьОшибкиТЧ(НоваяСтрока, ЕстьОшибкиВыполненияКонвертации, ДанныеДляПроверки, НастройкаКонвертации.ИмяТЧТоварыДокУчСист, СтрокаТЧ.НомерСтроки, РеквизитТЧ.Имя) Тогда
					Элементы.СтраницаТовары.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
				КонецЕсли;
								
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого ПрочаяТЧ Из ДокОб.Метаданные().ТабличныеЧасти Цикл
		
		Если ПрочаяТЧ.Имя = НастройкаКонвертации.ИмяТЧТоварыДокУчСист Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаТЧ Из ДокОб[ПрочаяТЧ.Имя] Цикл
				
			Для каждого РеквизитТЧ Из ДокОб.Метаданные().ТабличныеЧасти[ПрочаяТЧ.Имя].Реквизиты Цикл
				
				НоваяСтрока = ПрочиеТЧ.Добавить();
				НоваяСтрока.ИмяТЧ = ПрочаяТЧ.Имя;
				НоваяСтрока.НомерСтроки = СтрокаТЧ.НомерСтроки;
				НоваяСтрока.Наименование = РеквизитТЧ.Имя;
				НоваяСтрока.ТипРеквизита = РеквизитТЧ.Тип;
				НоваяСтрока.Значение = СтрокаТЧ[РеквизитТЧ.Имя];
				
				Если ПроверитьОшибкиТЧ(НоваяСтрока, ЕстьОшибкиВыполненияКонвертации, ДанныеДляПроверки, ПрочаяТЧ.Имя, СтрокаТЧ.НомерСтроки, РеквизитТЧ.Имя) Тогда
					Элементы.СтраницаПрочиеТЧ.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для каждого Реквизит Из НастройкаКонвертации.ПеременныеДокУчСист Цикл
		
		Если ДанныеДляПроверки.Свойство("Переменные") И ДанныеДляПроверки.Переменные.Свойство(Реквизит.Имя) Тогда
		
			НоваяСтрока = Переменные.Добавить();
			НоваяСтрока.Наименование = Реквизит.Имя;
			НоваяСтрока.ТипРеквизита = Реквизит.ИмяТипЗначения;
			НоваяСтрока.Значение = ДанныеДляПроверки.Переменные[Реквизит.Имя].Значение;
			
			Если ЗначениеЗаполнено(ДанныеДляПроверки.Переменные[Реквизит.Имя].ТекстОшибки) Тогда
				НоваяСтрока.ТекстОшибки = ДанныеДляПроверки.Переменные[Реквизит.Имя].ТекстОшибки;
				ЕстьОшибкиВыполненияКонвертации = Истина;
				
				Элементы.СтраницаПеременные.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВосклицаниеКрасное;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
				
	Если ЕстьОшибкиВыполненияКонвертации Тогда
		Элементы.ТекстОписаниеВыполненияКонвертации.Заголовок = "Есть ошибки";
		Элементы.ТекстОписаниеВыполненияКонвертации.ЦветТекста = Новый Цвет(255, 0, 0);
	Иначе
		Элементы.ТекстОписаниеВыполненияКонвертации.Заголовок = "Сконвертировано";
		Элементы.ТекстОписаниеВыполненияКонвертации.ЦветТекста = Новый Цвет(0, 150, 70);
	КонецЕсли;
	
	
	// проверим проведение
	Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") 
		И НастройкаКонвертации.ПроводитьДокУчСис Тогда
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
		Попытка
			
			ДокОб.Записать(РежимЗаписиДокумента.Проведение);
			
			Элементы.ТекстОписанияПроведения.Заголовок = "Проведен";
			Элементы.ТекстОписанияПроведения.ЦветТекста = Новый Цвет(0, 150, 70);
			Элементы.ТекстОписанияПроведения.Гиперссылка = Ложь;
			
		Исключение
			
			Ошибка			= ИнформацияОбОшибке();
			ПодробнаяОшибка	= ПодробноеПредставлениеОшибки(Ошибка);
			
			ОписаниеОшибкиПроведения = ПодробнаяОшибка;
			
			Элементы.ТекстОписанияПроведения.Заголовок = "Не проведен";
			Элементы.ТекстОписанияПроведения.Гиперссылка = Истина;
			Элементы.ТекстОписанияПроведения.ЦветТекста = Новый Цвет(255, 0, 0);
			
		КонецПопытки;
			
		ОтменитьТранзакцию();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ОбработатьЗначение(Значение)
	
	Если (ТипЗнч(Значение) = Тип("Дата") И Значение = Дата(1, 1, 1))
		Или (ТипЗнч(Значение) = Тип("Число") И Значение = 0) Тогда
		Возврат "";	
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьОшибкиТЧ(НоваяСтрока, ЕстьОшибкиВыполненияКонвертации, ДанныеДляПроверки, ИмяТЧ, НомерСтроки, ИмяРеквизита)
	
	Если ЗначениеЗаполнено(ДанныеДляПроверки)
		И ДанныеДляПроверки[ИмяТЧ].Количество() > 0
		И ЗначениеЗаполнено(ДанныеДляПроверки[ИмяТЧ].Получить(НомерСтроки - 1))
		И ДанныеДляПроверки[ИмяТЧ].Получить(НомерСтроки - 1).Свойство(ИмяРеквизита)
		И ЗначениеЗаполнено(ДанныеДляПроверки[ИмяТЧ].Получить(НомерСтроки - 1)[ИмяРеквизита].ТекстОшибки) 
	Тогда
		
		НоваяСтрока.ТекстОшибки = ДанныеДляПроверки[ИмяТЧ].Получить(НомерСтроки - 1)[ИмяРеквизита].ТекстОшибки;	
		ЕстьОшибкиВыполненияКонвертации = Истина;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ЗначениеЗаполнено(ОбъектЛогистика) Тогда
		Сообщить("Не выбран объект для конвертации");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектБДПриИзменении(Элемент)
	
	Реквизиты.Очистить();
	Товары.Очистить();
	ПрочиеТЧ.Очистить();
	
	Элементы.ТекстОписаниеВыполненияКонвертации.Заголовок = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстОписанияПроведенияНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Текст", ОписаниеОшибкиПроведения);
		
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ФормаТекстовогоСообщения",
		ПараметрыФормы);
	
КонецПроцедуры
