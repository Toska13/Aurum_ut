#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("НастройкиКонвертацииДокументов") Тогда
		НастройкиКонвертацииДокументов = Параметры.НастройкиКонвертацииДокументов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиКонвертацииДокументов) Тогда
		ВызватьИсключение "Не заполнена настройка конвертации документов";
	КонецЕсли;
	
	ЗаполняемДанныеФормы();
	
	СобратьТекстЗапроса();
	
	Элементы.УсловияЗапросаОбязательные.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияГруппыКолонкиСпискаНажатие(Элемент)
	
	Элементы.КолонкиСписка.Видимость = Не Элементы.КолонкиСписка.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГруппыУсловияЗапросаОбязательныеНажатие(Элемент)
	
	Элементы.УсловияЗапросаОбязательные.Видимость = Не Элементы.УсловияЗапросаОбязательные.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГруппаУсловияЗапросаДополнительныеНажатие(Элемент)
	
	Элементы.ДополнительныеУсловия.Видимость = Не Элементы.ДополнительныеУсловия.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГруппыДополнительныеПараметрыНажатие(Элемент)
	
	Элементы.ДополнительныеПараметры.Видимость = Не Элементы.ДополнительныеПараметры.Видимость;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДополнительныеПараметры

&НаКлиенте
Процедура ДополнительныеПараметрыПриИзменении(Элемент)
	
	Модифицированность = Истина;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПараметрыВычислениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		Элементы.ДополнительныеПараметры.ТекущиеДанные.Вычисление, ЭтаФорма, "Вычисление", Истина, Элементы.ДополнительныеПараметры);
	
	Модифицированность = Истина;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КонструкторЗапроса(Команда)
	
	ТекстЗапроса = ЗапросБезОбязательныхУсловий();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("КонструкторЗапросаЗавершение", ЭтаФорма);
	
	Конструктор = Новый КонструкторЗапроса(ТекстЗапроса);
	Конструктор.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзмененияИЗакрыть(Команда)
	
	Результат = СохранитьИзмененияНаСервере();
	
	Если Результат Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	СохранитьИзмененияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБезИзменений(Команда)
	
	Если Модифицированность Тогда
		
		ОповещениеВопросУстановки = Новый ОписаниеОповещения("ЗакрытьБезИзмененийЗавершение", ЭтаФорма);
		
		ТекстВопроса = "Вы уверены, что хотите закрыть без сохранения?";
		
		ПоказатьВопрос(ОповещениеВопросУстановки, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Да);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБезИзмененийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Закрыть();
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	
	ПредставлениеКоличества = Формат(КолонкиСписка.Количество(), "ЧГ=0");
	Элементы.ДекорацияГруппыКолонкиСписка.Заголовок =
		"Выбираемые поля" + ?(ЗначениеЗаполнено(ПредставлениеКоличества), " (" + ПредставлениеКоличества + ")", "");
	
	ПредставлениеКоличества = Формат(УсловияЗапросаОбязательные.Количество(), "ЧГ=0");
	Элементы.ДекорацияГруппыУсловияЗапросаОбязательные.Заголовок =
		"Условия запроса - обязательные" + ?(ЗначениеЗаполнено(ПредставлениеКоличества), " (" + ПредставлениеКоличества + ")", "");
	
	ПредставлениеКоличества = Формат(ДополнительныеУсловия.Количество(), "ЧГ=0");
	Элементы.ДекорацияГруппаУсловияЗапросаДополнительные.Заголовок =
		"Условия запроса - дополнительные" + ?(ЗначениеЗаполнено(ПредставлениеКоличества), " (" + ПредставлениеКоличества + ")", "");
	
	ПредставлениеКоличества = Формат(ДополнительныеПараметры.Количество(), "ЧГ=0");
	Элементы.ДекорацияГруппыДополнительныеПараметры.Заголовок =
		"Дополнительные параметры" + ?(ЗначениеЗаполнено(ПредставлениеКоличества), " (" + ПредставлениеКоличества + ")", "");
	
	Элементы.СохранитьИзмененияИЗакрыть.Доступность = Модифицированность;
	Элементы.СохранитьИзменения.Доступность = Модифицированность;
	
КонецПроцедуры

&НаКлиенте
Процедура КонструкторЗапросаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ПеренестиИзмененияКонструктораВДанныеФормы(Результат);
	
	Модифицированность = Истина;
	
	ОбновитьВидимостьДоступность();
	
	СобратьТекстЗапроса();
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиИзмененияКонструктораВДанныеФормы(НовыйТекстЗапроса)
	
	ИменаОсновныхКолонокСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ИменаОсновныхКолонокСписка();
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(НовыйТекстЗапроса);
	
	ОсновнойЗапросВыбора = СхемаЗапроса.ПакетЗапросов[0];
	
	ОператорВыбораУчетныхДокументов = ОсновнойЗапросВыбора.Операторы[0];
	
	// Дополнительные колонки
	КолонкиСписка.Очистить();
	ТипNull = Новый ОписаниеТипов(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Тип("Null")));
	Для Каждого ТекущаяКолонка Из ОсновнойЗапросВыбора.Колонки Цикл
		Если (Лев(ТекущаяКолонка.Псевдоним, 3) <> "Доп"
			И ТекущаяКолонка.Псевдоним <> "Отправитель"
			И ТекущаяКолонка.Псевдоним <> "Получатель"
			И ИменаОсновныхКолонокСписка.Найти(ТекущаяКолонка.Псевдоним) = Неопределено)
			Или ТекущаяКолонка.ТипЗначения = ТипNull Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяКолонка.Псевдоним = "Отправитель" Тогда
			ТекущийПсевдоним = "Грузоотправитель";
		ИначеЕсли ТекущаяКолонка.Псевдоним = "Получатель" Тогда
			ТекущийПсевдоним = "Грузополучатель";
		Иначе
			ТекущийПсевдоним = ТекущаяКолонка.Псевдоним;
		КонецЕсли;
		
		ИндексКолонки = ОсновнойЗапросВыбора.Колонки.Индекс(ТекущаяКолонка);
		ПутьКДанным = Строка(ОператорВыбораУчетныхДокументов.ВыбираемыеПоля.Получить(ИндексКолонки));
		СтрокаПодзамены = НастройкиКонвертацииДокументов.ТипДокумента1С + ".";
		Если Лев(ПутьКДанным, СтрДлина(СтрокаПодзамены)) = СтрокаПодзамены Тогда
			// Если путь начинается с типа документа 1С, то удаляем относительный путь
			ПутьКДанным = СтрЗаменить(ПутьКДанным, СтрокаПодзамены, "");
		КонецЕсли;
		ПутьКДанным = УбратьПустыеЗначения(ПутьКДанным);
		
		Если ПутьКДанным = "" И Лев(ТекущийПсевдоним, 3) = "Доп" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока = КолонкиСписка.Добавить();
		ТекущаяСтрока.Заголовок = ТекущийПсевдоним;
		ТекущаяСтрока.ПутьКДанным = ПутьКДанным;
		ТекущаяСтрока.ЭтоДополнительная = (Лев(ТекущийПсевдоним, 3) = "Доп");
		Если Лев(ТекущийПсевдоним, 3) = "Доп" Тогда
			ТекущаяСтрока.Тип = КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеОписаниеТипов_(ТекущаяКолонка.ТипЗначения);			
		КонецЕсли;
	КонецЦикла;
	
	// Дополнительные условия
	ДополнительныеУсловия.Очистить();
	Для Каждого ТекущийОтбор Из ОператорВыбораУчетныхДокументов.Отбор Цикл
		НоваяСтрока = ДополнительныеУсловия.Добавить();
		НоваяСтрока.ТекстУсловия = Строка(ТекущийОтбор);
	КонецЦикла;
	
	// Добавим обязательные условия
	Для Каждого ТекущееУсловие Из УсловияЗапросаОбязательные Цикл
		ОператорВыбораУчетныхДокументов.Отбор.Добавить(Строка(ТекущееУсловие.Значение));
	КонецЦикла;
	
	ТекстЗапросаТаблицыВтДокументы = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	// Дополнительные источники
	ДополнительныеИсточники = ДополнительныеИсточникиИзЗапроса(ТекстЗапросаТаблицыВтДокументы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УбратьПустыеЗначения(ПутьКДанным)
	
	Если ПутьКДанным = """"""
		Или ПутьКДанным = "ДАТАВРЕМЯ(1, 1, 1)"
		Или ПутьКДанным = "ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)"
		Или ПутьКДанным = "ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ПунктыМаршрута.ПустаяСсылка)" Тогда
		
		Возврат "";
	КонецЕсли;
	
	Возврат ПутьКДанным;
	
КонецФункции

&НаСервере
Функция ДополнительныеИсточникиИзЗапроса(ТекстЗапроса)
	
	ТекстДополнительныеИсточники = "";
	
	РезультатПоискаУсловия = Найти(ТекстЗапроса, Строка(УсловияЗапросаОбязательные[0].Значение));
	
	Если РезультатПоискаУсловия <> 0 Тогда
		
		// Поиск последнего условия ГДЕ
		ТекстПоиска = "ГДЕ" + Символы.ПС;
		
		ТекущийТекстЗапроса = ТекстЗапроса;
		Пока Истина Цикл
			
			ИндексУсловияГде = Найти(ТекущийТекстЗапроса, ТекстПоиска);
			
			Если ИндексУсловияГде = 0 Тогда
				Прервать;
			КонецЕсли;
			
			// Сократим запрос
			ТекущийТекстЗапроса = Прав(ТекущийТекстЗапроса, СтрДлина(ТекущийТекстЗапроса) - ИндексУсловияГде);
			
		КонецЦикла;
		
		ТекстДополнительныеИсточники = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - СтрДлина(ТекущийТекстЗапроса) - 1);
		
		// Поиск первого условия ИЗ
		ТекстПоиска = "ИЗ" + Символы.ПС;
		
		ИндексУсловияИз = Найти(ТекстДополнительныеИсточники, ТекстПоиска);
		Если ИндексУсловияИз <> 0 Тогда
			
			ЧислоСимволов = СтрДлина(ТекстДополнительныеИсточники) - ИндексУсловияИз - 1;
			ТекстДополнительныеИсточники = СокрЛП(Прав(ТекстДополнительныеИсточники, ЧислоСимволов));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстДополнительныеИсточники;
	
КонецФункции

&НаСервере
Функция ЗапросБезОбязательныхУсловий()
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапросаТаблицыВтДокументы);
	
	ОсновнойЗапросВыбора = СхемаЗапроса.ПакетЗапросов[0];
	ОператорВыбораУчетныхДокументов = ОсновнойЗапросВыбора.Операторы[0];
	
	// Удаляем обязательные условия
	Для Каждого ТекущееУсловие Из УсловияЗапросаОбязательные Цикл
		НайденноеУсловие = ОператорВыбораУчетныхДокументов.Отбор.Найти(Строка(ТекущееУсловие.Значение));
		ИндексУсловия = ОператорВыбораУчетныхДокументов.Отбор.Индекс(НайденноеУсловие);
		ОператорВыбораУчетныхДокументов.Отбор.Удалить(ИндексУсловия);
	КонецЦикла;
	
	Возврат СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецФункции

&НаСервере
Функция СохранитьИзмененияНаСервере()
	
	Если Не ОбработкаПроверкиЗаполнения() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектНастроек = НастройкиКонвертацииДокументов.ПолучитьОбъект();
	ОбъектНастроек.ДополнительныеИсточники = ДополнительныеИсточники;
	ОбъектНастроек.ДополнительныеУсловия.Загрузить(ДополнительныеУсловия.Выгрузить());
	ОбъектНастроек.ДополнительныеПараметры.Загрузить(ДополнительныеПараметры.Выгрузить());
	
	// Дополнительные колонки
	НомерДопКолонки = 0;
	Для Каждого ТекущаяКолонка Из КолонкиСписка Цикл
		Если ТекущаяКолонка.ЭтоДополнительная Тогда
			НомерДопКолонки = НомерДопКолонки + 1;
			
			Отбор = Новый Структура("ДобавленИзКонструктораЗапроса, ПутьКДанным", Истина, ТекущаяКолонка.ПутьКДанным);
			НайдСтроки = ОбъектНастроек.ДополнительныеКолонки.НайтиСтроки(Отбор);
			Если НайдСтроки.Количество() = 0 Тогда
				ТекущаяДопКолонка = ОбъектНастроек.ДополнительныеКолонки.Добавить();
				ТекущаяДопКолонка.Заголовок = "Доп" + Формат(НомерДопКолонки, "ЧГ=");
			Иначе
				ТекущаяДопКолонка = НайдСтроки[0];
			КонецЕсли;
			
			ТекущаяДопКолонка.ПутьКДанным = ТекущаяКолонка.ПутьКДанным;
			ТекущаяДопКолонка.Тип = ТекущаяКолонка.Тип;
			ТекущаяДопКолонка.ДобавленИзКонструктораЗапроса = Истина;
		Иначе
			ОбъектНастроек["Путь" + ТекущаяКолонка.Заголовок] = ТекущаяКолонка.ПутьКДанным;
		КонецЕсли;
	КонецЦикла;
	
	ОбъектНастроек.Записать();
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОбработкаПроверкиЗаполнения()
	
	Результат = Истина;
	
	Для Каждого ТекущаяСтрока Из ДополнительныеПараметры Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Имя) Тогда
			
			НомерСтрокиТЧ = Формат(ДополнительныеПараметры.Индекс(ТекущаяСтрока), "ЧДЦ=; ЧН=; ЧГ=");
			
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Не заполнено имя параметра";
			ПараметрыСообщения.Поле = "ДополнительныеПараметры[" + НомерСтрокиТЧ + "].Имя";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			
			Результат = Ложь;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Значение) И Не ЗначениеЗаполнено(ТекущаяСтрока.Вычисление) Тогда
			
			НомерСтрокиТЧ = Формат(ДополнительныеПараметры.Индекс(ТекущаяСтрока), "ЧДЦ=; ЧН=; ЧГ=");
			
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Должно быть заполнено или значение или выражение вычисления";
			ПараметрыСообщения.Поле = "ДополнительныеПараметры[" + НомерСтрокиТЧ + "].Значение";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			
			Результат = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполняемДанныеФормы()
	
	// Вычленим запрос учетного документа
	ИспользоватьМеханизмКастомизации = Ложь;
	РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		НастройкиКонвертацииДокументов.ТипДокументаЛогистика, НастройкиКонвертацииДокументов.ТипДокумента1С,,
		НастройкиКонвертацииДокументов, ИспользоватьМеханизмКастомизации);
	ЭталонныйТекстЗапроса = ЗапросУчетногоДокументаИзПолногоЗапроса(
		РезультатаФормированияЗапроса.ПолныйТекстЗапроса, НастройкиКонвертацииДокументов.ТипДокумента1С);
	
	// Условия запроса обязательные
	ИспользоватьМеханизмКастомизации = Истина;
	РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		НастройкиКонвертацииДокументов.ТипДокументаЛогистика, НастройкиКонвертацииДокументов.ТипДокумента1С,,
		НастройкиКонвертацииДокументов, ИспользоватьМеханизмКастомизации);
	УсловияЗапросаОбязательные.ЗагрузитьЗначения(Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ОбязательныеУсловияЗапроса(
		РезультатаФормированияЗапроса.ПолныйТекстЗапроса, НастройкиКонвертацииДокументов.ТипДокумента1С));
	
	// Заполним из объекта таблицы
	ОбъектНастроек = НастройкиКонвертацииДокументов.ПолучитьОбъект();
	
	ДополнительныеИсточники = ОбъектНастроек.ДополнительныеИсточники;
	ДополнительныеУсловия.Загрузить(ОбъектНастроек.ДополнительныеУсловия.Выгрузить());
	ДополнительныеПараметры.Загрузить(ОбъектНастроек.ДополнительныеПараметры.Выгрузить());
	
	// Колонки списка
	// Дополнительные
	КолонкиСписка.Очистить();
	
	Для каждого ДопКолонка Из ОбъектНастроек.ДополнительныеКолонки Цикл
		
		Если Не ДопКолонка.ДобавленИзКонструктораЗапроса Тогда
			Продолжить;	
		КонецЕсли;
		
		НоваяСтрока = КолонкиСписка.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДопКолонка);
		
	КонецЦикла;
	
	Счет = 0;
	Для Каждого ТекущаяКолонка Из КолонкиСписка Цикл
		Счет = Счет + 1;
		ТекущаяКолонка.Заголовок = "Доп" + Формат(Счет, "ЧГ=");
		ТекущаяКолонка.ЭтоДополнительная = Истина;
	КонецЦикла;
	// Основные
	ИменаОсновныхКолонокСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ИменаОсновныхКолонокСписка();
	Для Каждого ИмяКолонки Из ИменаОсновныхКолонокСписка Цикл
		НоваяСтрока = КолонкиСписка.Добавить();
		НоваяСтрока.Заголовок = ИмяКолонки;
		НоваяСтрока.ПутьКДанным = НастройкиКонвертацииДокументов["Путь" + ИмяКолонки];
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СобратьТекстЗапроса()
	
	// Дополнительные источники
	Если ЗначениеЗаполнено(ДополнительныеИсточники) Тогда
		СтрокаПоискаДокумента = "Документ." + НастройкиКонвертацииДокументов.ТипДокумента1С + " КАК " + НастройкиКонвертацииДокументов.ТипДокумента1С;
		НовыйТекстЗапроса = СтрЗаменить(ЭталонныйТекстЗапроса, СтрокаПоискаДокумента, ДополнительныеИсточники);
	Иначе
		НовыйТекстЗапроса = ЭталонныйТекстЗапроса;
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(НовыйТекстЗапроса);
	
	// Обязательные условия
	Для Каждого ТекущееУсловие Из УсловияЗапросаОбязательные Цикл
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить(ТекущееУсловие.Значение);
	КонецЦикла;
	
	// Дополнительные условия
	Для Каждого ТекущееУсловие Из ДополнительныеУсловия Цикл
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить(ТекущееУсловие.ТекстУсловия);
	КонецЦикла;
	
	// Список колонок
	ИменаДополнительныхТаблиц = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ИменаДополнительныхТаблиц(НастройкиКонвертацииДокументов,
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники);
	Для Каждого ТекущаяКолонка Из КолонкиСписка Цикл
		Если ТекущаяКолонка.Заголовок = "Грузоотправитель" Тогда
			ТекущийЗаголовок = "Отправитель";
		ИначеЕсли ТекущаяКолонка.Заголовок = "Грузополучатель" Тогда
			ТекущийЗаголовок = "Получатель";
		Иначе
			ТекущийЗаголовок = ТекущаяКолонка.Заголовок;
		КонецЕсли;
		
		ПутьКДанным = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПутьКДаннымДопКолонки(
			ИменаДополнительныхТаблиц, НастройкиКонвертацииДокументов.ТипДокумента1С, ТекущаяКолонка.ПутьКДанным);
		
		Если Не ЗначениеЗаполнено(ПутьКДанным) Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаСхемы = СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(ТекущийЗаголовок);
		Если КолонкаСхемы = Неопределено И Лев(ТекущийЗаголовок, 3) = "Доп" Тогда
			// Добавим новую доп колонку
			НовоеПоле = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Добавить(ПутьКДанным);
			ИндексНовогоПоля = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Индекс(НовоеПоле);
			СхемаЗапроса.ПакетЗапросов[0].Колонки[ИндексНовогоПоля].Псевдоним = ТекущийЗаголовок;
		Иначе
			// Изменим существующую
			ИндексКолонки = СхемаЗапроса.ПакетЗапросов[0].Колонки.Индекс(КолонкаСхемы);
			ВыражениеСхемы = Новый ВыражениеСхемыЗапроса(ПутьКДанным);
			Попытка
				СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Установить(ИндексКолонки, ВыражениеСхемы);
			Исключение
				НичегоНеДелаем = Истина;
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапросаТаблицыВтДокументы = СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапросУчетногоДокументаИзПолногоЗапроса(Знач ТекстЗапроса, ТипДокумента1С)
	
	СтрокаПоискаДокумента = "Документ." + ТипДокумента1С + " КАК " + ТипДокумента1С;
	
	ИндексДокумент = Найти(ТекстЗапроса, СтрокаПоискаДокумента);
	Если ИндексДокумент = 0 Тогда
		ВызватьИсключение "Не удалось найти запрос учетного документа из основного запроса списка";
	КонецЕсли;
	
	// Найдем ближайший "ВЫБРАТЬ"
	ТекущийТекстЗапроса = ТекстЗапроса;
	СтрокаПоискаВыбрать = "ВЫБРАТЬ";
	Пока Истина Цикл
		
		ИндексВыбрать = Найти(ТекущийТекстЗапроса, СтрокаПоискаВыбрать);
		ИндексДокумент = Найти(ТекущийТекстЗапроса, СтрокаПоискаДокумента);
		Если ИндексВыбрать = 0 Или ИндексДокумент = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если ИндексВыбрать > ИндексДокумент Тогда
			Прервать;
		КонецЕсли;
		
		// Сократим запрос
		ТекущийТекстЗапроса = Прав(ТекущийТекстЗапроса, СтрДлина(ТекущийТекстЗапроса) - ИндексВыбрать);
		
	КонецЦикла;
	
	Возврат "В" + Лев(ТекущийТекстЗапроса, ИндексДокумент + СтрДлина(СтрокаПоискаДокумента));
	
КонецФункции

#КонецОбласти