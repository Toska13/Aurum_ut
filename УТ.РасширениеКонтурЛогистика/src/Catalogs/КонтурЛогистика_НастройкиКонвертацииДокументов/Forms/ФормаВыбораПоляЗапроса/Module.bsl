#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УровнейВложенности = 3;
	
	Если Параметры.Свойство("НастройкаКонвертации") Тогда
		НастройкаКонвертации = Параметры.НастройкаКонвертации;
		ЗаполнитьДеревоЗначений(Параметры.НастройкаКонвертации);
	КонецЕсли;
		
	Если Параметры.Свойство("ПроизвольноеВыражение") Тогда
		ПроизвольноеВыражение = Параметры.ПроизвольноеВыражение;
		ВариантВыбора = "ПроизвольноеВыражение";
	Иначе
		ВариантВыбора = "ПолеЗапроса";	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеОтображениемЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВариантВыбораПриИзменении(Элемент)
	
	УправлениеОтображениемЭлементовФормы();	
	
КонецПроцедуры

&НаСервере
Процедура УровнейВложенностиПриИзмененииНаСервере()
	
	ЗаполнитьДеревоЗначений(НастройкаКонвертации);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВариантВыбора = "ПолеЗапроса" Тогда
	
		Закрыть(Элементы.ДеревоРеквизитов.ТекущиеДанные.ПолныйПуть);
		
	Иначе
		
		ПроизвольноеВыражение = ПроизвольноеВыражение + Элементы.ДеревоРеквизитов.ТекущиеДанные.ПолныйПуть;
		ВыбранныйТип = Элементы.ДеревоРеквизитов.ТекущиеДанные.Тип;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УровнейВложенностиПриИзменении(Элемент)
	
	УровнейВложенностиПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьПоле(Команда)
	
	Если ВариантВыбора = "ПолеЗапроса" Тогда
	
		Закрыть(Элементы.ДеревоРеквизитов.ТекущиеДанные.ПолныйПуть);
		
	Иначе
		
		Закрыть(ПроизвольноеВыражение);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура УправлениеОтображениемЭлементовФормы()
	
	Элементы.ПроизвольноеВыражение.Видимость = ВариантВыбора = "ПроизвольноеВыражение";
	Элементы.ГруппаПодсказкаПроизвольноеВыражение.Видимость = ВариантВыбора = "ПроизвольноеВыражение";
	
	Если ВариантВыбора = "ПолеЗапроса" Тогда 
		Элементы.ДеревоРеквизитов.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Иначе
		Элементы.ДеревоРеквизитов.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЗначений(НастройкаКонвертации)
		
	ТекстЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		НастройкаКонвертации.ТипДокументаЛогистика, НастройкаКонвертации.ТипДокумента1С,,,, Ложь);
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса.ПолныйТекстЗапроса);
	
	дз = РеквизитФормыВЗначение("ДеревоПолейЗапроса");
	
	дз.Строки.Очистить();
	
	Для каждого Источник Из СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники Цикл
				
		Если Найти(Источник.Источник.Псевдоним, "КонтурЛогистика_Статусы") > 0 
			Или Найти(Источник.Источник.Псевдоним, "КонтурЛогистика_ДвижениеДокументооборота") > 0 
			Или Найти(Источник.Источник.Псевдоним, "КонтурЛогистика_ОсобенностиДокументооборота") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = дз.Строки.Добавить();
		НоваяСтрока.ИмяПоля = Источник.Источник.Псевдоним;
		НоваяСтрока.ПолныйПуть = Источник.Источник.Псевдоним;
		НоваяСтрока.Представление = Источник.Источник.Псевдоним;
				
		Для каждого Поле Из Источник.Источник.ДоступныеПоля Цикл
			
			Если ТипЗнч(Поле) = Тип("ДоступнаяВложеннаяТаблицаСхемыЗапроса") Тогда
				Продолжить;
			КонецЕсли;
			
			Уровень = 2;
			
			НоваяСтрока2 = НоваяСтрока.Строки.Добавить();
			НоваяСтрока2.ИмяПоля = Поле.Имя;
			НоваяСтрока2.Тип = КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеОписаниеТипов_(Поле.ТипЗначения);
			НоваяСтрока2.ПолныйПуть = НоваяСтрока.ПолныйПуть + "." + Поле.Имя;
			НоваяСтрока2.Представление = Поле.Имя;
			
			ЗаполнитьПоле(НоваяСтрока2, Поле.Поля, Уровень + 1, НоваяСтрока2.ПолныйПуть, Поле.ТипЗначения);			
				
		КонецЦикла;
						
	КонецЦикла;
	
	ЗначениеВДанныеФормы(дз, ДеревоПолейЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоле(ТекущееПоле, ДоступныеПоля, Уровень, ПолныйПуть, ТипЗначения)
	
	Если Уровень > УровнейВложенности Тогда
		Возврат;	
	КонецЕсли;
	
	Для каждого Поле Из ДоступныеПоля Цикл
		
		Если ТипЗнч(Поле) = Тип("ДоступнаяВложеннаяТаблицаСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТекущееПоле.Строки.Добавить()	;
		НоваяСтрока.ИмяПоля = Поле.Имя;
		НоваяСтрока.Тип = КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеОписаниеТипов_(Поле.ТипЗначения);
		НоваяСтрока.ПолныйПуть = ПолныйПуть + "." + Поле.Имя;
		
		Синоним = СинонимПоля(ТипЗначения, Поле.Имя);
		НоваяСтрока.Представление = Синоним;
		
		ЗаполнитьПоле(НоваяСтрока, Поле.Поля, Уровень + 1, НоваяСтрока.ПолныйПуть, Поле.ТипЗначения);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СинонимПоля(ИсточникТипы, ИмяПоля)
	
	Для каждого Тип Из ИсточникТипы.Типы() Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		
		Если ОбъектМетаданных = Неопределено 
			Или (Не Метаданные.Справочники.Содержит(ОбъектМетаданных) И Не Метаданные.Документы.Содержит(ОбъектМетаданных)) Тогда
			Возврат ИмяПоля;
		КонецЕсли;
		
		Реквизит = Метаданные.НайтиПоТипу(Тип).Реквизиты.Найти(ИмяПоля);
		
		Если Реквизит <> Неопределено Тогда			
			Возврат Реквизит.Синоним;			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИмяПоля;
	
КонецФункции
