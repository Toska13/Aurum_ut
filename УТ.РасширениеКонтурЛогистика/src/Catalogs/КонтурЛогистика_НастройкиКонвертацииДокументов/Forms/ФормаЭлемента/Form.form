                        </dataPath>
                        <titleLocation>Top</titleLocation>
                        <toolTip>
                          <key>ru</key>
                          <value>Можно настроить ввод нескольких ТРН из одного документа учетной системы. Для этого требуется понять по какому принципу разделять документ на разные ТРН. Предлагается вычислить массив разделителей и по количеству элементов в нем создать N ТРН.</value>
                        </toolTip>
                        <toolTipRepresentation>Button</toolTipRepresentation>
                        <handlers>
                          <event>OnChange</event>
                          <name>РазделительПриИзменении</name>
