      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления КАК ПометкаУдаления,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.Код КАК Код,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.Наименование КАК Наименование,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика КАК ТипДокументаЛогистика,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С КАК ТипДокумента1С,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.УсловиеЗапроса КАК УсловиеЗапроса,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.СценарийПоУмолчанию КАК СценарийПоУмолчанию,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ПроводитьДокУчСис КАК ПроводитьДокУчСис,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации КАК НаправлениеКонвертации,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ОбратныйМаппинг КАК ОбратныйМаппинг,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.Сценарий КАК Сценарий,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ДополнительныеИсточники КАК ДополнительныеИсточники,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ТоварыИзДополнительногоДокумента КАК ТоварыИзДополнительногоДокумента,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий КАК СпецСценарий,
    ВЫБОР
        КОГДА СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка)
            ТОГДА 0
        ИНАЧЕ 1
    КОНЕЦ КАК ИконкаСпецСценарий,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ТипДополнительногоСвязанногоДокумента КАК ТипДополнительногоСвязанногоДокумента,
    СправочникКонтурЛогистика_НастройкиКонвертацииДокументов.ТолькоПроведенные КАК ТолькоПроведенные
ИЗ
    Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК СправочникКонтурЛогистика_НастройкиКонвертацииДокументов</queryText>
      <mainTable>Catalog.КонтурЛогистика_НастройкиКонвертацииДокументов</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
