
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", ЭтотОбъект);	
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
		
КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСФайламиПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСФайлами(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
			"ЗагрузитьИзФайлаЗавершение", 
			ЭтотОбъект, 
			РежимДиалогаВыбораФайла.Открытие, 
			"Выберите архив с доверенностью и подписью", 
			, "Архив (*.zip)|*.zip");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(МассивВыбранныхФайлов, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(МассивВыбранныхФайлов) Тогда 
		
		ВыбранныйФайлПуть = МассивВыбранныхФайлов[0];
						
		СписокМЧД = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.СписокМЧДИзАрхива(ВыбранныйФайлПуть);
		
		Если СписокМЧД.Количество() = 0 Тогда
			
			Сообщить("В архиве нет файлов МЧД");
		
		ИначеЕсли СписокМЧД.Количество() = 1 Тогда
			
			ЗагруженнаяМЧД = Неопределено;
			КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьМЧДИзАрхива(
				СписокМЧД[0].Значение.ДвоичныеДанныеДоверенности, СписокМЧД[0].Значение.ДвоичныеДанныеПодписи, , ЗагруженнаяМЧД);
			
			Оповестить("ОбновитьСписокМЧД", ЗагруженнаяМЧД);
			
			Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
				
				Сообщить("Загружена МЧД: " + СокрЛП(ЗагруженнаяМЧД));
				
			Иначе
			
				НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ЗагруженнаяМЧД);
	       		ПоказатьОповещениеПользователя("Загружена МЧД:", 
	        		НавигационнаяСсылка, 
	        		ЗагруженнаяМЧД,,СтатусОповещенияПользователя.Важное);
					
			КонецЕсли;
				
		Иначе
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СписокМЧД", СписокМЧД);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_МЧД.Форма.ФормаВыбораМЧДДляЗагрузкиИзФайла", ПараметрыФормы, , ЭтотОбъект, "ОбработатьВыборМЧД");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборМЧД(СписокМЧДДляЗагрузки, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(СписокМЧДДляЗагрузки) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого МЧД Из СписокМЧДДляЗагрузки Цикл
		
		ЗагруженнаяМЧД = Неопределено;
		КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьМЧДИзАрхива(МЧД.Значение.ДвоичныеДанныеДоверенности, МЧД.Значение.ДвоичныеДанныеПодписи, ,ЗагруженнаяМЧД);
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
			
			Сообщить("Загружена МЧД: " + СокрЛП(ЗагруженнаяМЧД));
			
		Иначе
		
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ЗагруженнаяМЧД);
       		ПоказатьОповещениеПользователя("Загружена МЧД:", 
        		НавигационнаяСсылка, 
        		ЗагруженнаяМЧД,,СтатусОповещенияПользователя.Важное);
				
		КонецЕсли;
		
	КонецЦикла;
	
	Оповестить("ОбновитьСписокМЧД", ЗагруженнаяМЧД);
	
КонецПроцедуры
