			ТОГДА 0
			ИНАЧЕ 1
	КОНЕЦ КАК КартинкаПередоверие,			
	СправочникКонтурЛогистика_МЧД.Ссылка,
	СправочникКонтурЛогистика_МЧД.ПометкаУдаления,
