&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектУчетнойСистемы", ОбъектУчетнойСистемы);
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		СуществующееСопоставление = КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(ОбъектУчетнойСистемы, "ТранспортноеСредство");
		
		Элементы.СуществующееСопоставление.Видимость = ЗначениеЗаполнено(СуществующееСопоставление);
		
		Элементы.ГруппаСвязанныйОбъект.Видимость = Истина;
		Элементы.ОбъектУчетнойСистемы.ТолькоПросмотр = Истина;
		ОбъектУчетнойСистемыУстановитьСвязь = Истина;
		Элементы.Список.МножественныйВыбор = Ложь;
		Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		
	Иначе
		
		Элементы.ГруппаСвязанныйОбъект.Видимость = Ложь;
		
	КонецЕсли;
	
	Если Параметры.Свойство("ОтборЭтоПрицеп") Тогда		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "ЭтоПрицеп", Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);		
	ИначеЕсли Параметры.Свойство("ОтборЭтоТС") Тогда		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "ЭтоПрицеп", Ложь, ВидСравненияКомпоновкиДанных.Равно, , Истина);		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере_ФормаВыбора(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда
			                 
			ТекстВопроса = Строка(ОбъектУчетнойСистемы) +" уже сопоставлен с " + Строка(СуществующееСопоставление)+". Создать еще одно сопоставление?";
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Создать");	
			Кнопки.Добавить("Отменить");
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, Кнопки, , , ЭтаФорма, "ОбработчикВопросаПоСопоставлению");
			
		Иначе	
			
			Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
				УстановитьСвязьСОбъектом();
			КонецЕсли;
			
			ЗакрытьФормуВыборомЗначения();
			
		КонецЕсли;
	Иначе
		ЗакрытьФормуВыборомЗначения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВопросаПоСопоставлению(ПараметрОбработчика, ДополнительныеПараметры) Экспорт
	
	Если ПараметрОбработчика = "Создать" Тогда
		
		Если ОбъектУчетнойСистемыУстановитьСвязь = Истина Тогда 
			УстановитьСвязьСОбъектом();
		КонецЕсли;
		
		ЗакрытьФормуВыборомЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСвязьСОбъектом()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не могу определить выбранную строку");
		Возврат;
		
	КонецЕсли;
	
	УстановитьСвязьСервер(ТекДанные.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязьСервер(ТС_Ссылка)

	Если ТС_Ссылка.ПометкаУдаления Тогда
		ВызватьИсключение "Невозможно создать сопоставление т.к. Организация Диадок помечена на удаление. Выберите другую Организацию или снимите пометку удаления.";	
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыСервер.УстановитьСвязьОбъектовЛогистикаУчСист(ТС_Ссылка, ОбъектУчетнойСистемы);
			
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуВыборомЗначения()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	ВыбранноеЗначение = ТекДанные.Ссылка;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ОповеститьОВыборе(ВыбранноеЗначение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовоеТС(Команда)
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ОбъектУчетнойСистемыСсылка", ОбъектУчетнойСистемы);
	
	ПараметрыФормы 		= Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
		
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_ТранспортныеСредства.ФормаОбъекта",
			ПараметрыФормы,
			,
			ЭтаФорма,
			"ОбработчикСозданиеОбъекта");
	
КонецПроцедуры
		
&НаКлиенте
Процедура ОбработчикСозданиеОбъекта(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт

	// проверить что создали новое и связали с объектом и закрыть эту форму
	СозданноеТС = СозданноеТС(ОбъектУчетнойСистемы);
	Если ЗначениеЗаполнено(СозданноеТС) Тогда 
		ОповеститьОВыборе(СозданноеТС);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СозданноеТС(ОбъектУчСист = Неопределено)
	
	Если ЗначениеЗаполнено(ОбъектУчСист) Тогда 
		
		СуществующееСопоставление = КонтурЛогистика_КонвертацияСервер.КонвертироватьОбъектУчетнойСистемы_В_ОбъектЛогистика(ОбъектУчСист, "ТранспортноеСредство");
		Если ЗначениеЗаполнено(СуществующееСопоставление) Тогда 
			Возврат СуществующееСопоставление;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции
	

&НаСервере
Процедура СоздатьНовоеТСНаСервере()
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ОбъектУчетнойСистемыСсылка", ОбъектУчетнойСистемы);
	
	НовоеТС = Справочники.КонтурЛогистика_ТранспортныеСредства.СоздатьЭлемент();
	НовоеТС.Заполнить(ДанныеЗаполнения);
	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ОбъектУчетнойСистемы) Тогда
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
	Выбрать(Неопределено);
	
КонецПроцедуры
