#Область ПрограммныйИнтерфейс

Функция ПолучитьОписаниеКлючейПоиска() Экспорт
	
	// Поиск договора осуществляется по:
	// 1. Рег. номер
	// 2. VIN
	// 3. СТС
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	КлючиПоиска = Новый Массив;
		
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "РегНомер", ШаблонСтрокиПоиска); // TODO научиться искать без пробелов
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "VIN", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска, "СТС", ШаблонСтрокиПоиска);

	Возврат КлючиПоиска;
	
КонецФункции

Функция ТекстОшибкиНеЗаполненыКлючевыеРеквизиты() Экспорт
	
	ТекстОшибки = "Ошибка при поиске Транспортного средства. Не заполнен один из ключевых реквизитов в одном из вариантов поиска: 
					|1. Рег. номер 
					|2. VIN
					|3. СТС";
	
	Возврат ТекстОшибки;
	
КонецФункции

// Параметры:
//  ДанныеТС - СправочникОбъект - данные, содержащие сведения, необходимые для проверки (ВидВладения, АрендодательЛизингодатель, ДоговорАрендаЛизинг)
//  Отказ	 - Булево - стандартный флаг прерывания обработчиков
//
// Возвращаемое значение:
//	Результат - Структура (см. ОписаниеРезультатаПроверки()) - возвращает сведения об ошибках заполнения транспортного средства
//
Функция РезультатПроверкиАрендатораДоговора(ДанныеТС, Отказ) Экспорт
	
	
	Результат = ОписаниеРезультатаПроверки();
	Результат.ДанныеОбъекта = ДанныеТС;
	
	ПроверкаНужна = ДанныеТС.ВидВладения = ЗначениеПеречисления("ВидыВладенияТранспортнымСредством", "Аренда_3")
				ИЛИ ДанныеТС.ВидВладения = ЗначениеПеречисления("ВидыВладенияТранспортнымСредством", "Лизинг_4")
				ИЛИ ДанныеТС.ВидВладения = ЗначениеПеречисления("ВидыВладенияТранспортнымСредством", "БезвозмездноеПользование_5");
		
	Если Не ПроверкаНужна ИЛИ Отказ Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеТС.ДоговорАрендаЛизинг) Тогда
		
		ЗафиксироватьОшибку(Результат, "ДоговорАрендаЛизинг",
			 НСтр("ru = 'Поле ""Договор аренды / лизинга / безв. польз."" должно быть заполнено для этого вида владения'"));
			 
	ИначеЕсли Не ЗначениеЗаполнено(ДанныеТС.ДоговорАрендаЛизинг.ДатаДокумента) 
			 И Не ЗначениеЗаполнено(ДанныеТС.ДоговорАрендаЛизинг.ИдДок) Тогда

		ЗафиксироватьОшибку(Результат, "ДоговорАрендаЛизинг.ДатаДокумента",
			 НСтр("ru = 'Поле ""Договор аренды / лизинга / безв. польз."" должен содержать Дату или Идентификатор'"));
			 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выводит сообщения об ошибках из результата, полученного функцией РезультатПроверкиАрендатораДоговора(ДанныеТС, Отказ)
//
Процедура ВывестиРезультатПроверкиПолей(РезультатПроверки) Экспорт
	
	Если Не РезультатПроверки.ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
	
	Для Каждого ОшибкаПоля Из РезультатПроверки.ОшибкиПолей Цикл
		ПараметрыСообщения.Текст = ОшибкаПоля.ТекстОшибки;
		ПараметрыСообщения.Поле  = ОшибкаПоля.ИмяПоля;
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения, 
			РезультатПроверки.ДанныеОбъекта);
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиТранспортноеСредствоПоРегНомер(РегНомер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РегНомер", РегНомер);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТранспортныеСредства.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ТранспортныеСредства КАК КонтурЛогистика_ТранспортныеСредства
	|ГДЕ
	|	КонтурЛогистика_ТранспортныеСредства.РегНомер = &РегНомер
	|	И НЕ КонтурЛогистика_ТранспортныеСредства.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

// Тип печатной формы по типу транспортного средства
//
// Параметры:
//  ТипТранспортногоСредства - Строка	 - ТипТС из карточки транспорта
// 
// Возвращаемое значение:
//  Строка - имя печатной формы
//
Функция ТипПечатнойФормыПоТипуТранспортногоСредства(Знач ТипТранспортногоСредства) Экспорт
	
	ЗанчениеПоУмолчанию = Перечисления.КонтурЛогистика_ТипыПечатныхФормПутыхЛистов.ГрузовогоАвтомобиляФорма4С;
	
	Если ТипТранспортногоСредства = Неопределено
		Или Не ЗначениеЗаполнено(ТипТранспортногоСредства)
		Или ТипЗнч(ТипТранспортногоСредства) <> Тип("Строка") Тогда
		
		Возврат ЗанчениеПоУмолчанию;
	КонецЕсли;
	
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(НРег(ТипТранспортногоСредства), "легковой") <> 0 Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыПечатныхФормПутыхЛистов.ЛегковогоАвтомобиляФорма3;
		
	ИначеЕсли КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(НРег(ТипТранспортногоСредства), "грузовой") <> 0
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(НРег(ТипТранспортногоСредства), "тягач") <> 0 Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыПечатныхФормПутыхЛистов.ГрузовогоАвтомобиляФорма4С;
		
	Иначе
		
		Возврат ЗанчениеПоУмолчанию;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ПереходНаЭПЛ502

Процедура ЗаполнитьТипТСПоКлассификатору(ТихийРежим = Истина) Экспорт
	
	Выборка = Справочники.КонтурЛогистика_ТранспортныеСредства.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТС = Выборка.Ссылка;
		
		Если ТС.ЭтоПрицеп Или ЗначениеЗаполнено(ТС.ТипТСПоКлассификатору) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипТСПоКлассификатору = Неопределено;  
		Если Найти(НРег(ТС.ТипТС), "грузов") > 0 Или Найти(НРег(ТС.ТипТС), "тягач") > 0 Тогда
			ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.Грузовой;
		ИначеЕсли Найти(НРег(ТС.ТипТС), "легков") > 0 Тогда
			ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.Легковой;
		ИначеЕсли Найти(НРег(ТС.ТипТС), "автобус") > 0 Тогда
			ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.Автобус;
		ИначеЕсли Найти(НРег(ТС.ТипТС), "трамвай") > 0 Или Найти(НРег(ТС.ТипТС), "троллейбус") > 0 Тогда
			ТипТСПоКлассификатору = Перечисления.КонтурЛогистика_ТипыТранспортныхСредств.ТрамвайТроллейбус;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипТСПоКлассификатору) Тогда
			ТСОбъект = ТС.ПолучитьОбъект();
			ТСОбъект.ТипТСПоКлассификатору = ТипТСПоКлассификатору;
			ТСОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ТихийРежим Тогда
		Сообщить("Заполнение типа ТС по классификатору выполнено");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗафиксироватьОшибку(Результат, ИмяПоля, ТекстОшибки)
	
	Результат.ЕстьОшибки = Истина;
	ОшибкаПоля = ОписаниеОшибкиПоля();
	ОшибкаПоля.ИмяПоля 	   = ИмяПоля;
	ОшибкаПоля.ТекстОшибки = ТекстОшибки;
	Результат.ОшибкиПолей.Добавить(ОшибкаПоля);	
	
КонецПроцедуры

Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения);
	
КонецФункции

Функция ОписаниеОшибкиПоля()
	
	Возврат Новый Структура("ИмяПоля, ТекстОшибки");
	
КонецФункции

Функция ОписаниеРезультатаПроверки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", 	Ложь);
	Результат.Вставить("ДанныеОбъекта", Неопределено);
	Результат.Вставить("ОшибкиПолей", 	Новый Массив);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти