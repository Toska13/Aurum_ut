<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Документ</dataPath>
			<field>Документ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусДокументооборота</dataPath>
			<field>СтатусДокументооборота</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус документооборота</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Титул1</dataPath>
			<field>Титул1</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул1</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МассаБруттоКг</dataPath>
			<field>МассаБруттоКг</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Общий вес (брутто) кг</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Титул3</dataPath>
			<field>Титул3</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул3</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЭТРН</dataPath>
			<field>ЭТРН</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>ЭТрН</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТранспортноеСредство</dataPath>
			<field>ТранспортноеСредство</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоПогрузки</dataPath>
			<field>МестоПогрузки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоДоставки</dataPath>
			<field>МестоДоставки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВремяЗагрузки</dataPath>
			<field>ВремяЗагрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Время загрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВремяРазгрузки</dataPath>
			<field>ВремяРазгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Время разгрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МассаНетто</dataPath>
			<field>МассаНетто</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вес (нетто) кг</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Водитель</dataPath>
			<field>Водитель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Водитель2</dataPath>
			<field>Водитель2</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Второй водитель</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтгрузочноеНаименование</dataPath>
			<field>ОтгрузочноеНаименование</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МассаБрутто</dataPath>
			<field>МассаБрутто</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вес (брутто) кг</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК СтатусДокументооборота,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка КАК Титул1,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.МассаБруттоКг КАК МассаБруттоКг,
	КонтурЛогистика_ТрН_Титул3.Ссылка КАК Титул3,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК ЭТРН,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ТранспортноеСредство КАК ТранспортноеСредство,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.МестоПогрузки КАК МестоПогрузки,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.МестоДоставки КАК МестоДоставки,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.ДатаВремяУбытия КАК ВремяЗагрузки,
	КонтурЛогистика_ТрН_Титул3.ФДатВрУбыт КАК ВремяРазгрузки,
	КонтурЛогистика_ТрН_Титул1Товары.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА КонтурЛогистика_ТрН_Титул1Товары.ОтгрузочноеНаименование = ""
			ТОГДА КонтурЛогистика_ТрН_Титул1Товары.Номенклатура
		ИНАЧЕ КонтурЛогистика_ТрН_Титул1Товары.ОтгрузочноеНаименование
	КОНЕЦ КАК ОтгрузочноеНаименование,
	СУММА(КонтурЛогистика_ТрН_Титул1Товары.Количество) КАК Количество,
	СУММА(КонтурЛогистика_ТрН_Титул1Товары.МассаПлановаяНеттоКг) КАК МассаНетто,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.Водитель КАК Водитель,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.Водитель2 КАК Водитель2,
	СУММА(КонтурЛогистика_ТрН_Титул1Товары.МассаПлановаяБруттоКг) КАК МассаБрутто
ИЗ
	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул3 КАК КонтурЛогистика_ТрН_Титул3
		ПО (КонтурЛогистика_ТрН_Титул3.ДокументЭТРН = КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1.Товары КАК КонтурЛогистика_ТрН_Титул1Товары
		ПО (КонтурЛогистика_ТрН_Титул1Товары.Ссылка.ДокументЭТРН = КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних({(&amp;КонецПериода)}, ) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
		ПО (КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ = КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка)
ГДЕ
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
	И ВЫБОР
			КОГДА КонтурЛогистика_ТрН_Титул3.Ссылка &lt;&gt; ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ТрН_Титул3.ПустаяСсылка)
				ТОГДА НЕ КонтурЛогистика_ТрН_Титул3.ЭтоПриемВозврата
			ИНАЧЕ ИСТИНА
		КОНЕЦ
{ГДЕ
	(КонтурЛогистика_ТрН_Титул1Товары.Ссылка.Водитель = &amp;Водитель
			ИЛИ КонтурЛогистика_ТрН_Титул1Товары.Ссылка.Водитель2 = &amp;Водитель),
	(КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&amp;СпСостояние))}

СГРУППИРОВАТЬ ПО
	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.МассаБруттоКг,
	КонтурЛогистика_ТрН_Титул3.Ссылка,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ТранспортноеСредство,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.МестоПогрузки,
	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.МестоДоставки,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.ДатаВремяУбытия,
	КонтурЛогистика_ТрН_Титул3.ФДатВрУбыт,
	КонтурЛогистика_ТрН_Титул1Товары.Номенклатура,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.Водитель,
	КонтурЛогистика_ТрН_Титул1Товары.Ссылка.Водитель2,
	ВЫБОР
		КОГДА КонтурЛогистика_ТрН_Титул1Товары.ОтгрузочноеНаименование = ""
			ТОГДА КонтурЛогистика_ТрН_Титул1Товары.Номенклатура
		ИНАЧЕ КонтурЛогистика_ТрН_Титул1Товары.ОтгрузочноеНаименование
	КОНЕЦ</query>
	</dataSet>
	<calculatedField>
		<dataPath>ФИОВодителя</dataPath>
		<expression>Водитель.Фамилия + " " + Водитель.Имя + " " + Водитель.Отчество</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ФИО водителя</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ВУ</dataPath>
		<expression>Водитель.ВУСерия + " " + Водитель.ВУНомер</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ВУ</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ВУ2</dataPath>
		<expression>Водитель2.ВУСерия + " " + Водитель2.ВУНомер</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ВУ 2-го водителя</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ФИОВодителя2</dataPath>
		<expression>Водитель2.Фамилия + " " + Водитель2.Имя + " " + Водитель2.Отчество</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ФИО 2-го водителя</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>НеполнаяПриемка</dataPath>
		<expression>Титул3.ОтказВПриемке ИЛИ Титул3.ПринятьЧастично</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Неполная приемка</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>КОНЕЦПЕРИОДА(&amp;Период.ДатаОкончания, "День")</expression>
		<availableAsField>false</availableAsField>
		<denyIncompleteValues>true</denyIncompleteValues>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
		<availableAsField>false</availableAsField>
		<denyIncompleteValues>true</denyIncompleteValues>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Today</v8:variant>
		</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>Водитель</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Водитель</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.КонтурЛогистика_Сотрудники</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>СпСостояние</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сп состояние</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.КонтурЛогистика_СостоянияДвиженияДокументооборота</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<template>
		<name>Макет1</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">ЭТРН.НомерТрН</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>Расшифровка</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:Parameter">Расшифровка</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:DetailsAreaTemplateParameter">
			<dcsat:name>Расшифровка</dcsat:name>
			<dcsat:fieldExpression>
				<dcsat:field>ЭТРН</dcsat:field>
				<dcsat:expression>ЭТРН</dcsat:expression>
			</dcsat:fieldExpression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>ЭТРН.НомерТрН</dcsat:name>
			<dcsat:expression>ЭТРН.НомерТрН</dcsat:expression>
		</parameter>
	</template>
	<template>
		<name>Макет2</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
