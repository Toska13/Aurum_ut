&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПоказатьВсе") Тогда
		ПоказатьВсе = Параметры.ПоказатьВсе;
	КонецЕсли;
	
	ИспользоватьКриптографию1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьКриптографию1С");
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Серверная"
		И КонтурЛогистика_ОбщегоНазначенияСервер.МожноИспользоватьКриптографиюНаСервере() Тогда
		
		ЗаполнитьТаблицуСертификатовНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если Вебклиент Тогда
		
		Элементы.Авторизоваться.Видимость = Ложь;
		ЗаполнитьТаблицуСертификатовНаКлиентеАсинхронно();
		
	#Иначе
	
		ЗаполнитьТаблицуСертификатовНаКлиенте();			
			
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура Авторизоваться(Команда)
	
	АвторизацияПоСертификату();
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияПоСертификату()
	
	ДанныеТекущейСтроки = Элементы.ТаблицаСертификатов.ТекущиеДанные;
	
	Если ИспользоватьКриптографию1С Тогда 
				
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"ОбщаяФорма.КонтурЛогистика_ВводПЗК",
			Новый Структура("ДанныеСертификата, Авторизация", ДанныеСертификата(ДанныеТекущейСтроки), Истина),
			ЭтаФорма,
			ЭтаФорма,
			"ОбработчикВводаПЗК",
			Новый Структура("ДанныеТекущейСтроки", ДанныеТекущейСтроки), 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	Иначе
		
		АвторизацияПоСертификатуПродолжение(ДанныеТекущейСтроки);
		
	КонецЕсли;	
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВводаПЗК(Результат, ДопПараметры = Неопределено) Экспорт 
	
	ДанныеТекущейСтроки = ДопПараметры.ДанныеТекущейСтроки;
	
	Если Результат = Неопределено Тогда
		
		ДанныеТекущейСтроки.Выбран				= Ложь;
		ДанныеТекущейСтроки.ОшибкаАвторизации	= Истина;	
		
		ТекстОшибки = "Не введен пароль закрытого ключа сертификата.";
		ДобавитьОшибкуАвторизации(ДанныеТекущейСтроки.ОтпечатокСертификата, ТекстОшибки);
		
	Иначе	
		
		ДанныеТекущейСтроки.ПЗК = Результат;
	
		АвторизацияПоСертификатуПродолжение(ДанныеТекущейСтроки);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияПоСертификатуПродолжение(ДанныеТекущейСтроки)
	
	ДанныеТекущейСтроки.ОшибкаАвторизации	= Ложь;
	ДанныеТекущейСтроки.Авторизован		 	= Ложь;
			
	ПЗК 					= ?(ЗначениеЗаполнено(ДанныеТекущейСтроки.ПЗК),  ДанныеТекущейСтроки.ПЗК, Неопределено);	
	ОтпечатокСертификата 	= ДанныеТекущейСтроки.ОтпечатокСертификата;
	
	Попытка
		
		Если Не ДанныеТекущейСтроки.СертификатНаСервере Тогда 	
			Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК);			
		Иначе				
			Авторизация_ПоСертификатуНаСервере(ОтпечатокСертификата, ПЗК);		
		КонецЕсли;
		
		ДанныеТекущейСтроки.Авторизован = Истина;
		
	Исключение
				
		ДобавитьОшибкуАвторизации(ОтпечатокСертификата, ИнформацияОбОшибке()); 
		
		ДанныеТекущейСтроки.Выбран				= Ложь;
		ДанныеТекущейСтроки.ОшибкаАвторизации	= Истина;
		
		ОбработкаОшибокАвторизацииПоСертификатам();
		
	КонецПопытки;
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьОшибкуАвторизации(ОтпечатокСертификата ,ИнформацияОбОшибке)
	
	ОшибкаАвторизации = Новый Структура;
		
	ОшибкаАвторизации.Вставить("ОтпечатокСертификата", "ОтпечатокСертификата");
	ОшибкаАвторизации.Вставить("ИнформацияОбОшибке", ИнформацияОбОшибке);

КонецПроцедуры

//Обрабатывает ошибки возникающие при авторизации по сертификату, выводит сообщение пользователю что авторизация не прошла
//
// Параметры:
//  ОшибкиАвторизации - Массив структур описывающих ошибки подключения
//   *ОтпечатокСертификата			 - Строка				 - отпечаток сертификата
//   *ИнформацияОбОшибке			 - ИнформацияОбОшибке	 - ИнформацияОбОшибке()
//
&НаКлиенте
Процедура ОбработкаОшибокАвторизацииПоСертификатам()
	
	Если ТипЗнч(ОшибкаАвторизации) = Тип("Структура") И ОшибкаАвторизации.Количество() > 0 Тогда
			
		ИдентификаторОшибки = "";
		
		Если ТипЗнч(ОшибкаАвторизации.ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда 
		
			ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ОшибкаАвторизации.ИнформацияОбОшибке);
			
			Если Найти(ПодробноеПредставлениеОшибки, "401") И Найти(ПодробноеПредставлениеОшибки, "is not authorized") Тогда
				ИдентификаторОшибки = "Сертификат не имеет доступа в Диадок";
			ИначеЕсли Найти(ПодробноеПредставлениеОшибки, "0x80090022") Тогда 	
				ИдентификаторОшибки = "Provider could not perform the action since the context was acquired as silent.";
			Иначе
				
				Если ОшибкаАвторизации.ИнформацияОбОшибке.Причина = Неопределено Тогда
					ОписаниеОшибки = ОшибкаАвторизации.ИнформацияОбОшибке.Описание;
				Иначе
					ОписаниеОшибки = ОшибкаАвторизации.ИнформацияОбОшибке.Причина.Описание;
				КонецЕсли;
				
				ИдентификаторОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
					"Не удалось авторизоваться по сертификату:
					|%1" + Символы.ПС,
					ОписаниеОшибки);
				
			КонецЕсли;
		
		Иначе
			
			ИдентификаторОшибки = ОшибкаАвторизации.ИнформацияОбОшибке;
			
		КонецЕсли;
				
		ШаблонОшибки = "%1
						|Попробуйте авторизироватьсся в веб-версии
						|или обратитесь в техподдержку";
	
		ТекстОшибки = КонтурЛогистика_ИнтеграцияДиадокКлиентПовтИсп.ЯдроНаКлиенте().Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки, ИдентификаторОшибки);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстОшибки);
		
	КонецЕсли;
	
	ОшибкаАвторизации = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Функция Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК)
	
	Возврат Модуль_ЯдроНаКлиенте().Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК);
		
КонецФункции

&НаСервереБезКонтекста
Функция Авторизация_ПоСертификатуНаСервере(ОтпечатокСертификата, ПЗК)
		
	Возврат Модуль_ЯдроНаСервере().Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК);
	
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте()

	Возврат КонтурЛогистика_ИнтеграцияДиадокКлиентПовтИсп.ЯдроНаКлиенте();	

КонецФункции

&НаСервереБезКонтекста
Функция Модуль_ЯдроНаСервере()

	Возврат КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();	

КонецФункции 

&НаКлиенте
Процедура ЗаполнитьТаблицуСертификатовНаКлиенте()
	                                      
	Если ЗначениеЗаполнено(ТекстОшибкиПолученияСертификатов) Тогда 
				
		Возврат
		
	КонецЕсли;
	
	СписокСертификатов = Новый Массив;
	
	ИспользоватьКриптографию1С = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ИспользоватьКриптографию1С");
	
	Если ИспользоватьКриптографию1С Тогда
		
		СписокСертификатов = КонтурЛогистика_КриптографияКлиентСервер.ПолучитьСписокЛокальныхСертификатов();	
		
	Иначе
	
		Ядро = Модуль_ЯдроНаКлиенте();
		
		Попытка
					
			Ядро.ПроверитьПодключениеКонтурПлагина();
			
			СписокСертификатов = Ядро.Сертификаты_СписокСертификатов();
			
		Исключение
			
			ОписаниеОшибкиПодключенияПлагина = ОписаниеОшибки();
			
			Если ОписаниеОшибкиПодключенияПлагина <> Неопределено И Найти(ОписаниеОшибкиПодключенияПлагина, "Ошибка при установке плагина") > 0 Тогда
				
				ПодключитьОбработчикОжидания("ОткрытьФормуОписанияОшибки", 0.5, Истина);  // для ОФ
				
			Иначе
				
				ПриНеудачномПолученииСертификатов(ЭтаФорма);
										
			КонецЕсли;					
			 			
		КонецПопытки;
			
	КонецЕсли;
	
	ДобавитьСертификатВТаблицу(СписокСертификатов, ТаблицаСертификатов, Ядро, Ложь, ПоказатьВсе);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОписанияОшибки()
	
	ПараметрыФормы = Новый Структура("ТипОшибки, ОписаниеОшибки", "ОшибкаПриПодключениеПлагина", ОписаниеОшибкиПодключенияПлагина);
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ОписаниеОшибкиСРешением", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуСертификатовНаКлиентеАсинхронно()	
	
	Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСКриптографиейПодключено", ЭтаФорма);	
	НачатьПодключениеРасширенияРаботыСКриптографией(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСКриптографиейПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСКриптографией(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", ЭтаФорма);	
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСФайламиПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСФайлами(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьТаблицуСертификатовЗавершение", ЭтаФорма);	
	КонтурЛогистика_КриптографияКлиент.ПолучитьСписокЛокальныхСертификатовАсинхронно(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуСертификатовЗавершение(СписокСертификатов, ДополнительныеПараметры) Экспорт
	
	ДобавитьСертификатВТаблицу(СписокСертификатов, ТаблицаСертификатов, , Ложь, ПоказатьВсе);		
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСертификатовНаСервере()
	
	ТаблицаСертификатов.Очистить(); 
	
	ТекстОшибкиПолученияСертификатов = "";
	
	СписокСертификатов = Новый Массив;
	
	ИспользоватьКриптографию1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьКриптографию1С");
	
	Если ИспользоватьКриптографию1С Тогда
		
		СписокСертификатов = КонтурЛогистика_КриптографияКлиентСервер.ПолучитьСписокЛокальныхСертификатов();	
		
	Иначе
	
		Ядро = Модуль_ЯдроНаСервере();
		
		Попытка
					
			Ядро.ПроверитьПодключениеКонтурПлагина();
			
			СписокСертификатов = Ядро.Сертификаты_СписокСертификатов();
			
		Исключение
			
			ПриНеудачномПолученииСертификатов(ЭтаФорма);
			 	
		КонецПопытки;
		
	КонецЕсли;
	
	ДобавитьСертификатВТаблицу(СписокСертификатов, ТаблицаСертификатов, Ядро);
	
КонецПроцедуры

&НаКлиентеНаСервереБЕзКонтекста
Процедура ПриНеудачномПолученииСертификатов(Форма)
	
	Форма.ТаблицаСертификатов.Очистить();
		
	Ошибка = ИнформацияОбОшибке();
	
	Форма.ДекорацияСертификатНедоступен = КраткоеПредставлениеОшибки(Ошибка);
	
	Форма.ТекстОшибкиПолученияСертификатов	 = ПодробноеПредставлениеОшибки(Ошибка);
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСертификатВТаблицу(СписокСертификатов, ТаблицаСертификатов, Ядро, СертификатНаСервере = Истина, ПоказатьВсеСертификаты = Ложь)
	
	Для Каждого Сертификат Из СписокСертификатов Цикл
		
		Если Не ПоказатьВсеСертификаты Тогда
			НайдСертификат = ПолучитьСертификатПоОтпечатку(Сертификат.ОтпечатокСертификата, СертификатНаСервере);
			Если Не НайдСертификат.Пустая() Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Стр = ТаблицаСертификатов.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Сертификат);
		
		Если СтрДлина(Стр.ИНН) = 12 Тогда
			Стр.КПП = "";
		КонецЕсли; 
		
		ИНН_КПП = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыВМассив(Стр.ИНН, Стр.КПП), "-");
		Стр.Представление = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыВМассив(ИНН_КПП, Стр.Организация), " • ");
		Стр.ИстекаетСрок = 60*60*24*30 >= (Стр.СрокДействия - ТекущаяДата());
		
		Стр.СертификатНаСервере = СертификатНаСервере;
						
	КонецЦикла;
	
	ТаблицаСертификатов.Сортировать("ВДиадоке убыв, Наименование, ДатаВыдачи убыв");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСертификатПоОтпечатку(ОтпечатокСертификата, СертификатНаСервере)
	
	Возврат Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПолучитьСертификатПоОтпечатку(ОтпечатокСертификата, СертификатНаСервере);
	
КонецФункции

&НаКлиенте
Функция НетДоступаКСертификатам()
	
	Результат = Элементы.РежимыАвторизации.ТекущаяСтраница = Элементы.СтраницаВходПоСертификатуНедоступен;
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура ТаблицаСертификатовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаСертификатовКартинкаДанныеСертификата" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДанныеТекущейСтроки = Элементы.ТаблицаСертификатов.ТекущиеДанные;
		
		ОткрытьФормуСДаннымиСертификата(ДанныеТекущейСтроки);
		
	ИначеЕсли Поле.Имя = "ТаблицаСертификатовВыбрать"
		ИЛИ Поле.Имя = "ТаблицаСертификатовНаименование"
		ИЛИ Поле.Имя = "ТаблицаСертификатовПредставление"
		Тогда
		
		ДанныеТекущейСтроки = Элементы.ТаблицаСертификатов.ТекущиеДанные;
					
		ЭтаФорма.Закрыть(ДанныеСертификата(ДанныеТекущейСтроки));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеСертификата(ДанныеТекущейСтроки)

	ДанныеСертификата = ОписаниеДанныхСертификата();
	ЗаполнитьЗначенияСвойств(ДанныеСертификата, ДанныеТекущейСтроки);
	
	Возврат Новый Структура("ДополнительныеПараметры", Новый Структура("ДанныеСертификата", ДанныеСертификата));

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеДанныхСертификата()
	
