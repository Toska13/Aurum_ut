    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
    КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка,
    КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН КАК ДокументЭТРННомерТрН,
    КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН КАК ДокументЭТРНДатаТрН
ПОМЕСТИТЬ Документы
ИЗ
    Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    КонтурЛогистика_ПЛ_Титул1.Ссылка,
    КонтурЛогистика_ПЛ_Титул1.НомерПЛ,
    КонтурЛогистика_ПЛ_Титул1.ДатаПЛ
ИЗ
    Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    КонтурЛогистика_ЗЗ_Титул1.Ссылка,
    КонтурЛогистика_ЗЗ_Титул1.НомЗак,
    КонтурЛогистика_ЗЗ_Титул1.ДатаЗак
ИЗ
    Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    Документы.Ссылка КАК Ссылка,
    Документы.ДокументЭТРННомерТрН КАК ДокументНомер,
    Документы.ДокументЭТРНДатаТрН КАК ДокументДата,
    ЕСТЬNULL(КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)) КАК ДокументСостояние
ИЗ
    Документы КАК Документы
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних(
                ,
                Документ В
                    (ВЫБРАТЬ
                        Документы.Ссылка КАК Ссылка
                    ИЗ
                        Документы КАК Документы)) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
        ПО Документы.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
