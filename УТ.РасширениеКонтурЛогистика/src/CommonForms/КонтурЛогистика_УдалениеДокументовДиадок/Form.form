  <title>
    <key>ru</key>
    <value>Удаление документов из сервиса Диадок</value>
  </title>
  <items xsi:type="form:FormGroup">
    <name>Группа6</name>
    <id>184</id>
    <items xsi:type="form:Decoration">
      <name>Декорация4</name>
      <id>186</id>
      <visible>true</visible>
      <enabled>true</enabled>
