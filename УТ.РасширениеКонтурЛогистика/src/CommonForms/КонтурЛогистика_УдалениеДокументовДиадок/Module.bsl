&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПереданаЭТрН = ТипЗнч(Параметры.ГлавныйДокументИлиТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная");
	
	Если ПереданаЭТрН Тогда 
		
		ГлавныйДокумент = Параметры.ГлавныйДокументИлиТитул;		
		Элементы.ДокументЭТрН.Заголовок = "Документ ЭТрН (будет удален)";
		НомерТитула = 1;
		
	Иначе 
		
		ТитулСсылка 	= Параметры.ГлавныйДокументИлиТитул;
		ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьГлавныйДокументПоТитулу(ТитулСсылка);
				
		ТипДокумента 	= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТитулСсылка);
		ЭтоПЛ 			= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента);
		НомерТитула 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипДокумента);
				
	КонецЕсли;	
	
	Файлы = КонтурЛогистика_ОбработкаДокументовСервер.НайтиВсеФайлыПоГлавномуДокументу(ГлавныйДокумент);
	
	Если Файлы.Количество() Тогда 
	
		Для Каждого Файл Из Файлы Цикл 
			
			Если Не Файл.Ссылка.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен 
				И Не Файл.Ссылка.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен Тогда 
				Продолжить;
			КонецЕсли;	
			
			Если Файл.Ссылка.Отправитель.Наш Или Файл.Ссылка.Получатель.Наш Тогда 
				
				НоваяСтрока = ФайлыНаУдаление.Добавить();
				
				НоваяСтрока.Файл 		= Файл.Ссылка;
				НоваяСтрока.MessageID 	= Файл.Ссылка.MessageID;
				НоваяСтрока.Отправитель = Файл.Ссылка.Отправитель;
				НоваяСтрока.Получатель 	= Файл.Ссылка.Получатель;
				НоваяСтрока.НомерТитула = Файл.НомерТитула;
				
				Если ПереданаЭТрН Тогда 
					
					НоваяСтрока.Отметка = Истина;
					
				Иначе	
					
					Если Не ЭтоПЛ Тогда  
						
						Если (НомерТитула = 1 Или НомерТитула = 2) И (Файл.НомерТитула = 1 Или Файл.НомерТитула = 2) Тогда 
							
							НоваяСтрока.Отметка = Истина;
							
						ИначеЕсли (НомерТитула = 3 Или НомерТитула = 4) И (Файл.НомерТитула = 3 Или Файл.НомерТитула = 4) Тогда	
							
							НоваяСтрока.Отметка = Истина;
							
						ИначеЕсли (НомерТитула = 5 Или НомерТитула = 6) И (Файл.НомерТитула = 5 Или Файл.НомерТитула = 6) Тогда	
							
							НоваяСтрока.Отметка = Истина;	
							
						Иначе 	
							
							НоваяСтрока.Отметка = НомерТитула = Файл.НомерТитула;	
							
						КонецЕсли;
						
					Иначе
						
						НоваяСтрока.Отметка = НомерТитула = Файл.НомерТитула;
						
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли;	
					
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение "Документы для удаления в сервисе Диадок не найдены.";
		
	КонецЕсли;	
	
	Элементы.ДокументЭТрН.Видимость = ПереданаЭТрН;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьУдалениеДокументовДиадок(Команда)
	
	Если Не ЗначениеЗаполнено(ФайлыНаУдаление) Тогда 
		ВызватьИсключение "Нет документов для удаления в сервисе Диадок для наших организаций.";
	КонецЕсли;	
	
	нСтроки = ФайлыНаУдаление.НайтиСтроки(Новый Структура("Отметка", Истина));
	Если Не ЗначениеЗаполнено(нСтроки) Тогда 
		ВызватьИсключение "Не выбраны документы для удаления в сервисе Диадок.";
	КонецЕсли;
		
	Для Каждого нСтрока Из нСтроки Цикл 
		Если Не ЗначениеЗаполнено(нСтрока.MessageID) Тогда 
			ВызватьИсключение "Не для всех выбранных документов для удаления в сервисе Диадок указан MessageID.";
		КонецЕсли;	
	КонецЦикла;	
		
	ПродолжитьУдалениеДокументовДиадокНаСервере();	
	
	Закрыть();
	
	Сообщить("Документ удален в сервисе Диадок");
	
КонецПроцедуры

&НаСервере
Процедура ПродолжитьУдалениеДокументовДиадокНаСервере()
	
	МассивMessageId = Новый Массив;
	
	Для Каждого Файл Из ФайлыНаУдаление Цикл
		Если Файл.Отметка И МассивMessageId.Найти(Файл.MessageID) = Неопределено Тогда 
			МассивMessageId.Добавить(Файл.MessageID);
		КонецЕсли;	
	КонецЦикла;	
		
	Для Каждого MessageId Из МассивMessageId Цикл
		
		НайденныеФайлы = ФайлыНаУдаление.НайтиСтроки(Новый Структура("MessageID, Отметка", MessageID, Истина));
		
		МассивСторон = Новый Массив;
		МассивФайлов = Новый Массив;
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка 
			
			Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
				
				Если НайденныйФайл.Отправитель.Наш 
					И МассивСторон.Найти(НайденныйФайл.Отправитель) = Неопределено Тогда 
					МассивСторон.Добавить(НайденныйФайл.Отправитель);
				КонецЕсли;
				
				Если НайденныйФайл.Получатель.Наш 
					И МассивСторон.Найти(НайденныйФайл.Получатель) = Неопределено 
					И НайденныйФайл.Файл.ПодписьВерна Тогда 
					МассивСторон.Добавить(НайденныйФайл.Получатель);
				КонецЕсли;
				
				МассивФайлов.Добавить(НайденныйФайл.Файл);
				
			КонецЦикла;
			
			КонтурЛогистика_ОбработкаДокументовСервер.УдалитьФайлыИСвязныеОбъекты(МассивФайлов);
			
			Для Каждого Сторона Из МассивСторон Цикл 
									
				КонтурЛогистика_API_Диадок.Диадок_АПИ_Delete(Сторона, MessageId); 
													
			КонецЦикла;	
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию(); 
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			КодОшибки = Сред(ТекстОшибки, Найти(ТекстОшибки, "Код ошибки: ") + 12, 3);
			РасшифровкаОшибки = КодыОшибок().Получить(КодОшибки);
			Если РасшифровкаОшибки = Неопределено Тогда
				
				ТекстИсключения = "Не удалось удалить документы в сервисе Диадок"; 
				
			Иначе		
				 
				ШаблонИсключения = "Не удалось удалить документы в сервисе Диадок.
						             |%1
						             |BoxID - %2
						             |MessageID - %3";
				
				ТекстИсключения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонИсключения, РасшифровкаОшибки, Сторона.ID, MessageId);
				
			КонецЕсли;			 
			
			ВызватьИсключение ТекстИсключения;
			
		КонецПопытки;
				
	КонецЦикла;	
	
	ОтмеченныеФайлы = ФайлыНаУдаление.НайтиСтроки(Новый Структура("Отметка", Истина));
	Если ОтмеченныеФайлы.Количество() = ФайлыНаУдаление.Количество() 
		И ПереданаЭТрН Тогда 
		
		ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
		ГлавныйДокументОбъект.УстановитьПометкуУдаления(Истина);
						
		РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ГлавныйДокумент, "completed");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ФайлыОтметкаПриИзменении(Элемент)
	
	Если Не ЭтоПЛ Тогда 
		
		ТекДанные = Элементы.Файлы.ТекущиеДанные;
		
		ТекОтметка 		= ТекДанные.Отметка;
		ТекНомерТитула 	= ТекДанные.НомерТитула;
		
		НомерЗависимогоТитула = 0;
		
		Если ТекНомерТитула = 1 Тогда 
			НомерЗависимогоТитула = 2;
		ИначеЕсли ТекНомерТитула = 2 Тогда 
			НомерЗависимогоТитула = 1;
		ИначеЕсли ТекНомерТитула = 3 Тогда 
			НомерЗависимогоТитула = 4;
		ИначеЕсли ТекНомерТитула = 4 Тогда 
			НомерЗависимогоТитула = 3;
		ИначеЕсли ТекНомерТитула = 5 Тогда
			НомерЗависимогоТитула = 6;
		ИначеЕсли ТекНомерТитула = 6 Тогда
			НомерЗависимогоТитула = 5;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(НомерЗависимогоТитула) Тогда 
			нСтроки = ФайлыНаУдаление.НайтиСтроки(Новый Структура("НомерТитула", НомерЗависимогоТитула));
			Если ЗначениеЗаполнено(нСтроки) Тогда 
				нСтроки[0].Отметка = ТекОтметка;
			КонецЕсли;	
		КонецЕсли;	
		
		Элементы.ДокументЭТрН.Заголовок = "Документ ЭТрН:";
		
		ОтмеченныеФайлы = ФайлыНаУдаление.НайтиСтроки(Новый Структура("Отметка", Истина));
		Если ОтмеченныеФайлы.Количество() = ФайлыНаУдаление.Количество() Тогда 
			
			Элементы.ДокументЭТрН.Заголовок = "Документ ЭТрН (будет удален)";
			
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КодыОшибок()
	
	КодыОшибок = Новый Соответствие;
	
	КодыОшибок.Вставить("400", "Данные в запросе имеют неверный формат или отсутствуют обязательные параметры.");
	КодыОшибок.Вставить("401", "В запросе отсутствует HTTP-заголовок Authorization или в этом заголовке содержатся некорректные авторизационные данные.");
	КодыОшибок.Вставить("402", "У организации с указанным идентификатором boxId закончилась подписка на API.");
	КодыОшибок.Вставить("403", "Доступ к ящику с предоставленным авторизационным токеном запрещен.");
	КодыОшибок.Вставить("404", "Не найдено сообщение или документ с указанными идентификаторами.");
	КодыОшибок.Вставить("405", "Используется неподходящий HTTP-метод.");
	КодыОшибок.Вставить("409", "Осуществляется попытка повторного удаления документа или сообщения.");
	КодыОшибок.Вставить("500", "При обработке запроса возникла непредвиденная ошибка.");
	
	Возврат КодыОшибок;
	
КонецФункции	

