
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.НадписьУстановлена.Видимость = Ложь;
	Элементы.ГруппаДействияСДоступнойВерсией.Видимость = Ложь;
	Элементы.ЛоадерПроверитьОбновление.Видимость = Ложь;
	Элементы.ЛоадерЗагрузкаОбновления.Видимость = Ложь;
	Элементы.ЛоадерПолучитьИсториюВерсий.Видимость = Ложь;
	Элементы.ГруппаЗагрузкаАрхивнойВерсии.Видимость = Ложь;
	Элементы.ДекорацияСтатусВыполненияЗагрузки.Видимость = Ложь;
	
	ВерсияПодсистемыУстановленная = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	
	ЗаголовокОписанияВерсии = "Краткое описание версии:";
	КоличествоВерсий = 10;
	
	Элементы.ЗагрузитьИУстановитьОбновление.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьГруппуТекущаяВерсияДанных();
	ПроверитьОбновление();
	ПолучитьИсториюВерсий();
	
	ПодключитьОбработчикОжидания("ОбновитьГруппуТекущаяВерсияДанных", 15, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоВерсийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДанныеСтроки = ДеревоВерсий.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "СсылкаНаОписание" Тогда 	
		
		Если ЗначениеЗаполнено(ДанныеСтроки.СсылкаНаОписание) Тогда
			
			ОткрытьОписаниеВВебе(ДанныеСтроки.СсылкаНаОписание);

		КонецЕсли;
			
	ИначеЕсли Поле.Имя = "КартинкаЗагрузить" Тогда
		
		Если ЗначениеЗаполнено(ДанныеСтроки.СсылкаНаЗагрузку) Тогда
			
			ЗагрузкаНовойВерсии = Ложь;
			
			СтруктураОбновления = Новый Структура("СсылкаНаЗагрузку, НомерВерсии", 
											ДанныеСтроки.СсылкаНаЗагрузку, ДанныеСтроки.НомерВерсии);
			
			ВыбратьКаталогИЗагрузитьОбновлениеПодсистемы(СтруктураОбновления);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВерсийПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДеревоВерсий.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
	
	ОписаниеВерсии = ДанныеСтроки.КраткоеОписание;
	
	СформироватьЗаголовокОписанияВерсии(ДанныеСтроки);
	
КонецПроцедуры

#КонецОбласти


#Область КомандыФормы

&НаКлиенте
Процедура ОткрытьОписаниеУстановленнойВерсии(Команда)
	
	ОткрытьОписаниеВВебе(УстановленнаяВерсияСсылкаНаОписание);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОписаниеДоступнойВерсии(Команда)
	
	ОткрытьОписаниеВВебе(ДоступнаяВерсияСсылкаНаОписание);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбновление(Команда = Неопределено)
	
	ОбновитьФорму_ПроверитьОбновление(Истина);
	
	Элементы.ЛоадерПроверитьОбновление.Видимость = Истина;
	
	АдресВХранилище_ПроверитьОбновление = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	
	ПараметрыФоновогоЗадания.Вставить("НомерВерсии", ВерсияПодсистемыУстановленная);
	
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьПолучениеСведенийОбОбновлении(
		АдресВХранилище_ПроверитьОбновление, ПараметрыФоновогоЗадания);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		ПроверитьОбновленияРезультатИзХранилища();
		Элементы.ЛоадерПроверитьОбновление.Видимость = Ложь;
	Иначе
		ИдентификаторФЗ_ПроверитьОбновление = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбновление(Команда)
	
	Если ЗначениеЗаполнено(ДоступнаяВерсияСсылкаНаЗагрузку) Тогда
		
		ЗагрузкаНовойВерсии = Истина;

		СтруктураОбновления = Новый Структура("СсылкаНаЗагрузку, НомерВерсии", 
										ДоступнаяВерсияСсылкаНаЗагрузку, ВерсияПодсистемыДоступная);

		ВыбратьКаталогИЗагрузитьОбновлениеПодсистемы(СтруктураОбновления);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИсториюВерсий(Команда = Неопределено)
	
	Если КоличествоВерсий = 0 Тогда
		
		КоличествоВерсий = 10;
		
	КонецЕсли;
	
	Элементы.ОбновитьИсториюВерсий.Видимость = Ложь;
	Элементы.НадписьПолучаюИсториюВерсий.Видимость = Истина;
	Элементы.ЛоадерПолучитьИсториюВерсий.Видимость = Истина;
	
	АдресВХранилище_ПолучитьИсториюВерсий = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	
	ПараметрыФоновогоЗадания.Вставить("КоличествоВерсий", КоличествоВерсий);
	
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьПолучениеИсторииВерсий(
		АдресВХранилище_ПолучитьИсториюВерсий, ПараметрыФоновогоЗадания);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		ПолучитьИсториюВерсийИзРезультата();
		Элементы.ЛоадерПолучитьИсториюВерсий.Видимость = Ложь;
	Иначе
		ИдентификаторФЗ_ПолучитьисториюВерсий = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПолучитьИсториюВерсий", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКОбновлениюДанных(Команда)
	
	ОткрытьФорму("ОбщаяФорма.КонтурЛогистика_ОбновлениеПодсистемы");

КонецПроцедуры

#КонецОбласти


#Область ОбработкаКоманды_ПроверитьОбновления

&НаКлиенте
Процедура ПроверитьОбновленияРезультатИзХранилища()
	
	ОбновитьФорму_ПроверитьОбновление(Ложь);
	
	КонтурЛогистика_ОбновлениеСервер.ПолучитьСведенияОбОбновлении(ВерсияПодсистемыУстановленная, АдресВХранилище_ПроверитьОбновление);
	
	СтруктураОбновленияВерсии = ПолучитьИзВременногоХранилища(АдресВХранилище_ПроверитьОбновление);
	
	Если СтруктураОбновленияВерсии = Неопределено Тогда
		
		КонтурЛогистика_Метрика.ОбработатьОшибку(
			"ПроверкаФоновогоЗаданияПроверитьНаличиеНовойВерсии", "СтруктураОбновленияВерсии = Неопределено");
		
	Иначе
		
		УдалитьИзВременногоХранилища(АдресВХранилище_ПроверитьОбновление);
		
		Если Не СтруктураОбновленияВерсии.Успешно Тогда
			
			Если ЗначениеЗаполнено(СтруктураОбновленияВерсии.Ошибка) Тогда
				СообщениеОбОшибке = Новый СообщениеПользователю();
				СообщениеОбОшибке.Текст = СтруктураОбновленияВерсии.Ошибка;
				СообщениеОбОшибке.Сообщить();
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
		ОбновитьРеквизитыФормыПоСтруктуреОбновленияВерсии(СтруктураОбновленияВерсии);
		ОбновитьЭлементыФормыПослеПроверкиОбновления();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьОбновления() Экспорт
	
	ЗаданиеАктивно = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ПроверитьОбновление, Элементы.ЛоадерПроверитьОбновление);
	
	Если ЗаданиеАктивно Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 2, Истина);
	Иначе
		ПроверитьОбновленияРезультатИзХранилища();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеквизитыФормыПоСтруктуреОбновленияВерсии(СтруктураОбновленияВерсии)

	ВерсияПодсистемыДоступная = СтруктураОбновленияВерсии.НомерВерсии;
	ДатаВыходаВерсии = СтруктураОбновленияВерсии.ДатаВыхода;
	ДоступнаяВерсияСсылкаНаЗагрузку = СтруктураОбновленияВерсии.СсылкаНаЗагрузку;
	ДоступнаяВерсияСсылкаНаОписание = СтруктураОбновленияВерсии.СсылкаНаОписание;
	ВерсияПодсистемыУстарела = КонтурЛогистика_ОбновлениеКлиент.ПроверяемаяВерсияНовееУстановленной(
									ВерсияПодсистемыУстановленная, 
									ВерсияПодсистемыДоступная);

	Если ВерсияПодсистемыУстарела Тогда

		ДатаВыходаВерсииМассивом = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ДатаВыходаВерсии, ".");

		ДоступнаяВерсияДатаВыхода = Дата(ДатаВыходаВерсииМассивом[2], ДатаВыходаВерсииМассивом[1], ДатаВыходаВерсииМассивом[0]);

	Иначе

		ДоступнаяВерсияДатаВыхода = Неопределено;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыФормыПослеПроверкиОбновления()
	
	Элементы.ГруппаДействияСДоступнойВерсией.Видимость = ВерсияПодсистемыУстарела;
	
	Если ВерсияПодсистемыУстарела Тогда
		
		ТекстНадписиНовойВерсии = КонтурЛогистика_ОбновлениеКлиент.ТекстНадписиНоваяВерсияПодсистемы(
							ВерсияПодсистемыДоступная, 
							ДоступнаяВерсияДатаВыхода);
							
		ЦветНадписиНовойВерсии = WebЦвета.Красный;
		
	Иначе
		
		ТекстНадписиНовойВерсии = "Обновление не требуется";
		ЦветНадписиНовойВерсии = WebЦвета.Зеленый;
		
	КонецЕсли;
	
	Элементы.НадписьНоваяВерсияПодсистемы.Заголовок = ТекстНадписиНовойВерсии;
	Элементы.НадписьНоваяВерсияПодсистемы.ЦветТекста = ЦветНадписиНовойВерсии;
	Элементы.ВерсияПодсистемыУстановленная.ЦветТекста = ЦветНадписиНовойВерсии;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму_ПроверитьОбновление(КомандаВыполняется)
	
	Элементы.ПроверитьОбновления.Доступность = НЕ КомандаВыполняется;
	Элементы.НадписьНоваяВерсияПодсистемы.Видимость = НЕ КомандаВыполняется;
	Элементы.НадписьВыполняетсяПроверкаОбновления.Видимость = КомандаВыполняется;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработкаКоманды_ПолучитьИсториюВерсий

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПолучитьИсториюВерсий() Экспорт
	
	ЗаданиеАктивно = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ПолучитьИсториюВерсий, Элементы.ЛоадерПолучитьИсториюВерсий);
	
	Если ЗаданиеАктивно Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПолучитьИсториюВерсий", 2, Истина);
	Иначе
		ПолучитьИсториюВерсийИзРезультата();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИсториюВерсийИзРезультата()
	
	Элементы.ОбновитьИсториюВерсий.Видимость = Истина;
	Элементы.НадписьПолучаюИсториюВерсий.Видимость = Ложь;
	
	ОбработатьРезультатПолученияИсторииВерсий();
	РаскрытьГруппуСУстановленнойВерсией();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатПолученияИсторииВерсий()

	СтруктураРезультата = ПолучитьИзВременногоХранилища(АдресВХранилище_ПолучитьИсториюВерсий);

	Если СтруктураРезультата = Неопределено Тогда
		
		КонтурЛогистика_Метрика.ОбработатьОшибку(
			"ПроверкаФоновогоЗаданияПолучениеИсторииВерсий", "СтруктураРезультата = Неопределено");
		
	Иначе

		Если НЕ СтруктураРезультата.Успешно Тогда

			СообщениеОбОшибке = Новый СообщениеПользователю();
			СообщениеОбОшибке.Текст = СтруктураРезультата.Ошибка;
			СообщениеОбОшибке.Сообщить();

			Возврат;

		КонецЕсли;

		ТаблицаИсторииВерсий = СтруктураРезультата.ТаблицаИсторииВерсий;

		Если ТаблицаИсторииВерсий = Неопределено Тогда
			
			КонтурЛогистика_Метрика.ОбработатьОшибку(
				"ПроверкаФоновогоЗаданияПолучитьИсториюВерсий", "ТаблицаИсторииВерсий = Неопределено");
			
		Иначе

			ЗаполнитьТаблицуВерсий(ТаблицаИсторииВерсий);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуВерсий(ТаблицаИсторииВерсий)

	БазоваяВерсияУстановленная = "";

	ДеревоВерсийЗначение = РеквизитФормыВЗначение("ДеревоВерсий");

	ДеревоВерсийЗначение.Строки.Очистить();

	Для Каждого СтрокаТаблицы Из ТаблицаИсторииВерсий Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.НомерВерсии)
				ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.СсылкаНаЗагрузку) Тогда
			Продолжить;
		КонецЕсли;

		ВеткаВерсии = ДеревоВерсийЗначение.Строки.Найти(СтрокаТаблицы.БазоваяВерсия);

		Если ВеткаВерсии = Неопределено Тогда

			ВеткаВерсии = ДеревоВерсийЗначение.Строки.Добавить();

			ЗаполнитьЭлементДереваВерсий(ВеткаВерсии, СтрокаТаблицы);

		Иначе

			Если ВеткаВерсии.ВерсияПатча < СтрокаТаблицы.ВерсияПатча Тогда

				ЗаполнитьЭлементДереваВерсий(ВеткаВерсии, СтрокаТаблицы);

			КонецЕсли;

		КонецЕсли;

		СтрокаВерсии = ВеткаВерсии.Строки.Добавить();

		Если СтрокаТаблицы.НомерВерсии = ВерсияПодсистемыУстановленная Тогда
			ЭтоТекущаяВерсия = Истина;

			БазоваяВерсияУстановленная = СтрокаТаблицы.БазоваяВерсия;
		Иначе
			ЭтоТекущаяВерсия = Ложь;
		КонецЕсли;

		ЗаполнитьЭлементДереваВерсий(СтрокаВерсии, СтрокаТаблицы, ЭтоТекущаяВерсия);

	КонецЦикла;

	ДеревоВерсийЗначение.Строки.Сортировать("ВерсияПатча УБЫВ", Истина);
	ДеревоВерсийЗначение.Строки.Сортировать("НомерВерсии УБЫВ");

	ЗначениеВРеквизитФормы(ДеревоВерсийЗначение, "ДеревоВерсий");

	Если ТаблицаИсторииВерсий.Количество() > 0 Тогда
		Элементы.ДеревоВерсий.ТекущаяСтрока = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаскрытьГруппуСУстановленнойВерсией()
	
	Если НЕ ЗначениеЗаполнено(БазоваяВерсияУстановленная) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ГруппыВерсии = ДеревоВерсий.ПолучитьЭлементы();
	
	Для Каждого ГруппаВерсии Из ГруппыВерсии Цикл
		
		Если ГруппаВерсии.БазоваяВерсия = БазоваяВерсияУстановленная Тогда
			
			Элементы.ДеревоВерсий.Развернуть(ГруппаВерсии.ПолучитьИдентификатор());
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЭлементДереваВерсий(ЗаполняемыйЭлемент, ЗаполняющийЭлемент, ЭтоТекущаяВерсия = Ложь)
	
	ЗаполнитьЗначенияСвойств(ЗаполняемыйЭлемент, ЗаполняющийЭлемент);

	ЗаполняемыйЭлемент.ПредставлениеВерсии = ЗаполняющийЭлемент.НомерВерсии + " от " + ЗаполняющийЭлемент.ДатаВыхода;
	ЗаполняемыйЭлемент.КартинкаЗагрузить = 0;
	ЗаполняемыйЭлемент.ТекущаяВерсия = ЭтоТекущаяВерсия;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработкаКоманды_ЗагрузитьОбновление

&НаКлиенте
Процедура ВыбратьКаталогИЗагрузитьОбновлениеПодсистемы(СтруктураОбновления)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ЗагрузитьОбновлениеПодсистемыВКаталог", 
		ЭтаФорма, 
		РежимДиалогаВыбораФайла.ВыборКаталога, 
		"Выберите каталог хранения обновлений", 
		КаталогОбновлений, 
		Неопределено, 
		Ложь, 
		"", 
		СтруктураОбновления);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбновлениеПодсистемыВКаталог(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		КаталогОбновленияВерсии = СформироватьНазваниеКаталогаВерсий(Результат, ДополнительныеПараметры);
		
		СоздатьКаталогВерсии(КаталогОбновленияВерсии);
		
		СсылкаНаЗагрузку = ДополнительныеПараметры.СсылкаНаЗагрузку;
		
		НачатьЗагрузкуОбновления(СсылкаНаЗагрузку);

	Иначе
		
		СообщениеНеВыбранКаталог = Новый СообщениеПользователю();
		СообщениеНеВыбранКаталог.Текст = "Не выбран каталог загрузки архива версии. Загрузка остановлена.";
		СообщениеНеВыбранКаталог.Сообщить();
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуОбновления(СсылкаНаЗагрузку)
	
	ОбновитьФорму_ЗагрузитьОбновление(Истина);
	
	ИдентификаторЛоадера = ВидимыйЛоадерЗагрузкиОбновления();
	
	Элементы[ИдентификаторЛоадера].Видимость = Истина;
	
	АдресВХранилище_ЗагрузитьОбновление = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	
	ПараметрыФоновогоЗадания.Вставить("СсылкаНаЗагрузку", СсылкаНаЗагрузку);
	
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьЗагрузкуДанных(
											АдресВХранилище_ЗагрузитьОбновление, 
											ПараметрыФоновогоЗадания);
											
	ИдентификаторФЗ_ЗагрузитьОбновление = РезультатЗапуска.ИдентификаторЗадания;
	
	ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ЗагрузитьОбновление() Экспорт
	
	ИдентификаторЛоадера = ВидимыйЛоадерЗагрузкиОбновления();
	
	ЗаданиеАктивно = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ЗагрузитьОбновление, Элементы[ИдентификаторЛоадера], Элементы.ДекорацияСтатусВыполненияЗагрузки);
	
	Если ЗаданиеАктивно Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление", 2, Истина);
		
	Иначе
		
		ОбновитьФорму_ЗагрузитьОбновление(Ложь);
		
		ДвоичныеДанныеОбновленияПодсистемы = ПолучитьИзВременногоХранилища(АдресВХранилище_ЗагрузитьОбновление);
		
		Если ДвоичныеДанныеОбновленияПодсистемы = Неопределено Тогда
			
			ОписаниеОшибки = Элементы.ДекорацияСтатусВыполненияЗагрузки.Заголовок;
			Сообщить(ОписаниеОшибки);
			Элементы.ДекорацияСтатусВыполненияЗагрузки.Видимость = Ложь;
			
			КонтурЛогистика_Метрика.ОбработатьОшибку(
				"ПроверкаФоновогоЗаданияЗагрузкаОбновления", ОписаниеОшибки);
			
		Иначе
			
			АрхивВерсии = КаталогОбновленияВерсии + "\update.zip";
			
			ДвоичныеДанныеОбновленияПодсистемы.Записать(АрхивВерсии);
			
			РаспаковатьZipАрхив(АрхивВерсии, КаталогОбновленияВерсии);
			
			ЗапуститьПриложение(КаталогОбновленияВерсии);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспаковатьZipАрхив(ПутьКАрхиву, КаталогРаспаковки) Экспорт
	
	Архив = Новый ЧтениеZipФайла(ПутьКАрхиву);
	
	Архив.ИзвлечьВсе(КаталогРаспаковки);
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьНазваниеКаталогаВерсий(Результат, ДополнительныеПараметры)
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		КаталогОбновлений = Результат;
	Иначе
		КаталогОбновлений = Результат[0];
	КонецЕсли;

	НомерВерсии = ДополнительныеПараметры.НомерВерсии;
	
	Возврат КаталогОбновлений + "\" + НомерВерсии;
	
КонецФункции

&НаКлиенте
Процедура СоздатьКаталогВерсии(СоздаваемыйКаталог)
	
	КаталогВерсии = Новый Файл(СоздаваемыйКаталог);

	Если НЕ КаталогВерсии.Существует() Тогда

		СоздатьКаталог(СоздаваемыйКаталог);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму_ЗагрузитьОбновление(КомандаВыполняется)

	Если ЗагрузкаНовойВерсии Тогда

		Элементы.ЗагрузитьОбновление.Доступность = НЕ КомандаВыполняется;

	Иначе
		
		Элементы.ГруппаЗагрузкаАрхивнойВерсии.Видимость = КомандаВыполняется;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВидимыйЛоадерЗагрузкиОбновления()
	
	Если ЗагрузкаНовойВерсии Тогда
		
		Возврат "ЛоадерЗагрузкаОбновления";
		
	Иначе
		
		Возврат "ЛоадерЗагрузкаИзАрхива";
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти


&НаКлиенте
Процедура СформироватьЗаголовокОписанияВерсии(ДанныеСтроки)
	
	ЗаголовокОписанияВерсии = "Краткое описание версии v " + ДанныеСтроки.ПредставлениеВерсии + ":";
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОписаниеВВебе(СсылкаНаОписание)
	
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке(СсылкаНаОписание);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГруппуТекущаяВерсияДанных()
	
	ТребуетсяОбновлениеДанных = КонтурЛогистика_ОбновлениеВерсииМодуля.ТребуетсяВыполнитьПереходНаНовуюВерсию();
	ТекущаяВерсияДанных = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияДанныхПодсистемыКонтурЛогистика();
	
	Элементы.ПерейтиКОбновлениюДанных.Видимость = ТребуетсяОбновлениеДанных;
	
	Если ТребуетсяОбновлениеДанных Тогда
		
		ЦветВерсии = WebЦвета.Красный;
		
	Иначе
		
		ЦветВерсии = WebЦвета.Зеленый;
		
	КонецЕсли;
	
	Элементы.ТекущаяВерсияДанных.ЦветТекста = ЦветВерсии;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗахватитьВХранилище(Команда)
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Обработка.КонтурЛогистика_ЗахватПодсистемыВХранилище.Форма.Форма");
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИУстановитьОбновление(Команда)
	
	Результат = КонтурЛогистика_ОбновлениеСервер.ХэшСуммаТекущегоРасширенияИЭталонногоОдинаковы(ВерсияПодсистемыУстановленная);
	
	Если Результат.Успешно Тогда
		
		Если Результат.ХэшСуммыОдинаковы Тогда
			
			// Расширение не менялось. Приступим к установке нового.
			ОповещениеВопросУстановки = Новый ОписаниеОповещения("ЗагрузитьИУстановитьОбновлениеВопрос", ЭтаФорма);
			
			ТекстВопроса = "Вы уверены, что хотите установить обновления подсистемы Контур.Логистика?
				|После установки обновления 1С будет закрыта!";
			
			ПоказатьВопрос(ОповещениеВопросУстановки, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Да);
			
		Иначе
			
			// Расшерение было изменено. Автоматически обновление не возможно.
			ОповещениеВопросУстановки = Новый ОписаниеОповещения("ЗагрузитьОбновлениеВопрос", ЭтаФорма);
			
			ТекстВопроса = "Модуль был изменен. Автоматическое обновление не доступно.
				|Загрузить новую версию подсистемы Контур.Логистика?";
			
			ПоказатьВопрос(ОповещениеВопросУстановки, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Нет);
			
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = "При получении данных версии подсистемы возникла ошибка:
			|" + Результат.ТекстОшибки;
		
		Сообщить(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИУстановитьОбновлениеВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// Закроем открытые окна
	Попытка
		Закрыть();
		ВладелецФормы.Закрыть();
	Исключение
		// Ничего не делаем
	КонецПопытки;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.ОбновитьМодульДоПоследнейВерсии(ДоступнаяВерсияСсылкаНаЗагрузку);
	
	Если Результат Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбновлениеВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьОбновление(Неопределено);
	
КонецПроцедуры
