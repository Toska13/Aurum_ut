        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.РеквизитДополнительногоДокумента</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Реквизит предыдущего титула</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ИзПредыдущегоТитула</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Вычислить выражение на языке 1С</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ВычислитьВыражение</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Из текущего титула</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.РеквизитЗаполненногоТитула</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Фикс. значение</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ФиксированноеЗначение</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Значение общей настройки</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ЗначениеОбщейНастройки</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Доп. сведение</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ДопСвойство</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Доп. реквизит</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ДопРеквизит</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Контактная информация</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.КонтактнаяИнформация</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Договоры контрагентов</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ДоговорыКонтрагентов</value>
