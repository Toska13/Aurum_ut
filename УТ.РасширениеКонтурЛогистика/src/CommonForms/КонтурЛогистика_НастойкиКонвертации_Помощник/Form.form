      <columnsCount>5</columnsCount>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Реквизит справочника учётной системы</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.РеквизитСправочникаДокументаУС</value>
