      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Реквизит документа основания</value>
        </presentation>
        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.РеквизитДокументаОснования</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Реквизит дополнительного документа</value>
