        <value xsi:type="core:ReferenceValue">
          <value>Enum.КонтурЛогистика_СпособыМаппингаПоля.EnumValue.ЗначенияСвойствОбъектов</value>
        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
