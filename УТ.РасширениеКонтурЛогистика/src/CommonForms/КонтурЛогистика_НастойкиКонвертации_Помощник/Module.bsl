
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СпособыМаппингаНаУдаление = Новый Массив;
	
	ДобавлениеКСтрокеСпискаСвойств = "";
	
	Если Параметры.Свойство("НетТабЧастиТовары") Тогда
		ДобавлениеКСтрокеСпискаСвойств = ", НетТабЧастиТовары";	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры,
		"ВыражениеВычисления, ВыражениеВычисления2, ВыражениеВычисленияСтрокаНеогр, ИмяНастраиваемогоПоля, СвойствоОбъекта,
		|КлючДопСвойстваРеквизита, НастройкаКонвертации, СпособМаппинга, ИмяТабЧастьТовары, ПутьКоллекцияТабЧастьТовары,
		|ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ" + ДобавлениеКСтрокеСпискаСвойств);
	Элементы.ВыражениеВычисления_ЗначениеОбщейНастройки.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_Настройки");
			
	Если ЗначениеЗаполнено(ВыражениеВычисления) И СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда
		ВыражениеВычисленияСтрокаНеогр = ВыражениеВычисления;
		ВыражениеВычисления = "";
	КонецЕсли;
	
	Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов
		И ТипЗнч(ВыражениеВычисления2) = Тип("Булево") Тогда
		
		ВернутьПервый = ВыражениеВычисления2;
	КонецЕсли;
	
	УровнейВложенностиДереваРеквизитов = 1;
	
	Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула Тогда
		ИзПредыдущегоТитула_Титул = ВыражениеВычисления2;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ПутьПроизвольнаяТабЧасть) Тогда
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопРеквизит);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопСвойство);
	КонецЕсли;
			
	Параметры.Свойство("ЕстьКонтактнаяИнформацияОбъекта", ЕстьКонтактнаяИнформацияОбъекта);
	Если ЕстьКонтактнаяИнформацияОбъекта Тогда
		ИдентификаторВидаКонтактнойИнформации = ВыражениеВычисления;
		ЗаполнитьСписокВыбораВидамиКонтактнойИнформации();
	Иначе
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.КонтактнаяИнформация);
	КонецЕсли;
		
	Параметры.Свойство("ЕстьЗначенияСвойствОбъектов", ЕстьЗначенияСвойствОбъектов);
	Если Не ЕстьЗначенияСвойствОбъектов Тогда
		Элементы.СпособМаппинга.СписокВыбора.Удалить(
			Элементы.СпособМаппинга.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначенияСвойствОбъектов));
	КонецЕсли;
		
	Параметры.Свойство("ЕстьДокументыФизическихЛиц", ЕстьДокументыФизическихЛиц);
	Если ЕстьДокументыФизическихЛиц Тогда
		ИдентификаторВидаДокумента = ВыражениеВычисления2;
	Иначе
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДокументФизическогоЛица);
	КонецЕсли;
	
	Параметры.Свойство("ЕстьДоговорыКонтрагентов", ЕстьДоговорыКонтрагентов);
	Если Не ЕстьДоговорыКонтрагентов Тогда
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов);
	КонецЕсли;
	
	Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда 
		
		Если Параметры.Свойство("ТипДополнительногоСвязанногоДокумента", ТипДополнительногоСвязанногоДокумента) Тогда
			ТипОснования = ТипДополнительногоСвязанногоДокумента;
			
			Если Параметры.ИмяТабЧастьТовары <> "" Тогда
				СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
			КонецЕсли;
		Иначе
			ТипОснования = НастройкаКонвертации.ТипДокумента1С;
			СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента);
		КонецЕсли;
		
		Элементы.ТипДокументаОснования.Видимость = Ложь;
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС);
		
		Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			Или ЗначениеЗаполнено(Параметры.ПутьПроизвольнаяТабЧасть)Тогда
			
			СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПутьКоллекцияТабЧастьТовары) Тогда
			УточнениеТипДокументаСодержащийТЧТовары = "";
		Иначе
			УточнениеТипДокументаСодержащийТЧТовары = ТипОснования;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НастройкаКонвертации.ТипДокумента1С) Тогда
			
			Элементы.СпособМаппинга.СписокВыбора.Удалить(
				Элементы.СпособМаппинга.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования));
				
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииРегистровСведений") Тогда
		
		ТипОснования = НастройкаКонвертации.ИмяРесурса;
		
		Элементы.УточнениеТипДокументаСодержащийТЧТовары.Видимость = Ложь;
		Элементы.ИзПредыдущегоТитула_Титул.ТолькоПросмотр = Истина;
		
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС);
		
	Иначе
		// значит ТипЗнч(НастройкаКонвертации) = СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников 
		
		ТипОснования = НастройкаКонвертации.ТипСправочникаИлиДокументаУС;
		ТипДокументаОснования = НастройкаКонвертации.ТипДокументаОснования;
		
		Если ЗначениеЗаполнено(ТипОснования) И Не ЗначениеЗаполнено(ТипДокументаОснования) Тогда
			
			Если Метаданные.Документы.Найти(НастройкаКонвертации.ТипСправочникаИлиДокументаУС) <> Неопределено Тогда
				ТипДокументаОснования = НастройкаКонвертации.ТипСправочникаИлиДокументаУС;
				СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС);
			ИначеЕсли Метаданные.Справочники.Найти(НастройкаКонвертации.ТипСправочникаИлиДокументаУС) <> Неопределено Тогда
				СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников") Тогда
			Элементы.УточнениеТипДокументаСодержащийТЧТовары.Видимость = Ложь;
			СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента);
		КонецЕсли;
		
		// метка НКС-1 (поиск в подсистеме по метке покажет связанные)
		// на момент реализации неочевидна необходимость использования этих способов маппинга в настройке конвернтации справочника
		
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула);
		
		Если ТипОснования = "Строка" Тогда
			
			Элементы.ГруппаВычислитьВыражениеДеревоРеквизитов.Видимость = Ложь;
			
			СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС);
			СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если Параметры.ИмяНастраиваемогоПоля = "ОтказДобавленияСтроки" Тогда
		
		Элементы.ИмяНастраиваемогоПоля.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ИмяНастраиваемогоПоля = "Отказ добавления строки";
		
		УдаляемыеСпособыМаппинга = Новый Массив;
		
		Для каждого ЭлСпособМаппинга Из Элементы.СпособМаппинга.СписокВыбора Цикл
			
			Если ЭлСпособМаппинга.Значение = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять
				Или ЭлСпособМаппинга.Значение = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула
				Или ЭлСпособМаппинга.Значение = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение Тогда
				Продолжить;
			КонецЕсли;
			
			УдаляемыеСпособыМаппинга.Добавить(ЭлСпособМаппинга);
			
		КонецЦикла;
		
		Для каждого УдСпособМаппинга Из УдаляемыеСпособыМаппинга Цикл
			Элементы.СпособМаппинга.СписокВыбора.Удалить(УдСпособМаппинга);	
		КонецЦикла;
		
		Элементы.ВычислитьВыражениеПояснеине1.Заголовок = "Для отказа добавления строки присвойте в переменную РезультатВычисления значение Истина" 
														+ " В остальных случаях новая строка будет добавлена";
		Элементы.РеквизитДокументаОснованияПояснение6.Заголовок = "Выберите из дерева реквизитов или напишите вложенность (через точку) обращаясь к реквизитам."
																+ " Если выбранный реквизит имеет тип Булево и равен Истина, то новая строка добавлена не будет." 
																+ " В остальных случаях новая строка будет добавлена";
		Элементы.РеквизитДокументаОснованияПояснение7.Заголовок = "Отказ добавления строки вычисляться не будет. 
																 |Новая строка будет добавлена";
																
	КонецЕсли;
	
	Если Параметры.Свойство("НастройкаИнфоПолей") Тогда
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопРеквизит);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопСвойство);
		СпособыМаппингаНаУдаление.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять);
	КонецЕсли;
	
	Для Каждого ТекущееЗначение Из СпособыМаппингаНаУдаление Цикл
		НайденноеЗначение = Элементы.СпособМаппинга.СписокВыбора.НайтиПоЗначению(ТекущееЗначение);
		Если НайденноеЗначение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элементы.СпособМаппинга.СписокВыбора.Удалить(НайденноеЗначение);
	КонецЦикла;
	
	ПерейтиКСтранице();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособМаппингаПриИзменении(Элемент)
	
	ПерейтиКСтранице();
		
КонецПроцедуры

&НаСервере
Процедура ПерейтиКСтранице()
	
	ИмяСпособаМаппинга = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяЗначенияПеречисления_КонтурЛогистика(СпособМаппинга);
	Если ИмяСпособаМаппинга = "РеквизитДополнительногоДокумента" Тогда
		ИмяСпособаМаппинга = "РеквизитДокументаОснования";
	КонецЕсли;
	Элементы.ВариантыЗаполнения.ТекущаяСтраница = Элементы[ИмяСпособаМаппинга];
	
	Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования
		И ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда
		
		ТипОснования = НастройкаКонвертации.ТипДокумента1С;
		
		Если Не ЗначениеЗаполнено(ПутьКоллекцияТабЧастьТовары) И Не ЗначениеЗаполнено(УточнениеТипДокументаСодержащийТЧТовары) Тогда
			УточнениеТипДокументаСодержащийТЧТовары = ТипОснования;
		КонецЕсли;
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента Тогда
		ТипОснования = ТипДополнительногоСвязанногоДокумента;
		
	КонецЕсли;
	
	Если (СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования  	
		ИЛИ СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула  	
		ИЛИ СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС  	
		ИЛИ СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула 	
		ИЛИ СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение 
		ИЛИ СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДокументФизическогоЛица 
		ИЛИ СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов)
		И ТипОснования <> "Строка" Тогда 	
		
		Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования Тогда
			
			// Подсунуть список выбора документов 1С
			Для Каждого ДокМета Из Метаданные.Документы Цикл
				
				Элементы.УточнениеТипДокументаСодержащийТЧТовары.СписокВыбора.Добавить(ДокМета.Имя, ДокМета.Синоним, , БиблиотекаКартинок.Документ);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение")
			И Не ЗначениеЗаполнено(ВыражениеВычисленияСтрокаНеогр) Тогда
			
			Если ИмяНастраиваемогоПоля = "ОпасныеГрузыМассивСтруктур" Тогда
				ВыражениеВычисленияСтрокаНеогр =
					"//Пример:
					|//РезультатВычисления = Новый Массив;
					|//// КлассификационныйКод и ГруппаУпаковки не обязательны
					|//ОпГруз = Справочники.КонтурЛогистика_ОписанияОпасныхГрузов.ПолучитьОписаниеОпасногоГруза(
					|//	Объект.НомерООН, Объект.КлассификационныйКод, Объект.ГруппаУпаковки);
					|//РезультатВычисления.Добавить(ОпГруз);";
			Иначе
				ВыражениеВычисленияСтрокаНеогр =
					"//Примеры:
					|//РезультатВычисления = Основание.МойРеквизит;
					|//РезультатВычисления = Объект.МойРеквизит;
					|//РезультатВычисления = МояФункция(Объект);";
			КонецЕсли;
			
		КонецЕсли;
		
		Попытка
			ПостроитьДеревоРеквизитов();
		Исключение
			Сообщить("Неудача при построении дерева реквизитов по причине: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)
	
	Если ЗначениеЗаполнено(ВыражениеВычисленияСтрокаНеогр) И СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") Тогда 
		ВыражениеВычисления = "";
	Иначе
		ВыражениеВычисленияСтрокаНеогр = "";
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов") Тогда 
		ВыражениеВычисления2 = ВернутьПервый;	
	КонецЕсли;
	
	ПоляРезультата = "ВыражениеВычисления, ВыражениеВычисления2, ВыражениеВычисленияСтрокаНеогр, ИмяНастраиваемогоПоля, КлючДопСвойстваРеквизита, НастройкаКонвертации, 
	|СпособМаппинга, ИмяТабЧастьТовары, ПутьКоллекцияТабЧастьТовары, ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ, СвойствоОбъекта";
	СтруктураВыполнения = Новый Структура(ПоляРезультата);
	ЗаполнитьЗначенияСвойств(СтруктураВыполнения, ЭтаФорма, ПоляРезультата);
	
	ОповеститьОВыборе(СтруктураВыполнения);
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоРеквизитов()
	
	Дерево = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СформироватьДеревоРеквизитов(
		СпособМаппинга, НастройкаКонвертации, НетТабЧастиТовары, ИмяТабЧастьТовары, ТипОснования,
		УточнениеТипДокументаСодержащийТЧТовары, ТипДокументаОснования, ИзПредыдущегоТитула_Титул, УровнейВложенностиДереваРеквизитов);
	
	// Если не ясен ТипДокументаСодержащийТЧТовары
	Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда 
		Если НетТабЧастиТовары = Ложь И ЗначениеЗаполнено(ИмяТабЧастьТовары) Тогда
			Если НЕ ЗначениеЗаполнено(УточнениеТипДокументаСодержащийТЧТовары) Тогда 
				Элементы.УточнениеТипДокументаСодержащийТЧТовары.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоРеквизитовДокумента");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовДокументаОснованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") Тогда 
		ВыбранныйВДеревеТекст = "Основание." + Элемент.ТекущиеДанные.ПолныйПуть;
	Иначе
		ВыбранныйВДеревеТекст = Элемент.ТекущиеДанные.ПолныйПуть;
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") Тогда
		Если ЗначениеЗаполнено(ВыражениеВычисленияСтрокаНеогр) Тогда
			
			Элементы.ВыражениеВычисленияСтрокаНеогр_ВычислитьВыражение.ВыделенныйТекст = ВыбранныйВДеревеТекст;
			
		Иначе
			
			ВыражениеВычисленияСтрокаНеогр = "" + ВыбранныйВДеревеТекст;
			
		КонецЕсли;
		
		ЭтаФорма.ТекущийЭлемент = Элементы.ВыражениеВычисленияСтрокаНеогр_ВычислитьВыражение;
		
	Иначе
		
		ВыражениеВычисления = ВыбранныйВДеревеТекст;
		
	КонецЕсли;

	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзПредыдущегоТитула_ТитулПриИзменении(Элемент)
	
	ВыражениеВычисления2 = ИзПредыдущегоТитула_Титул;
	ПостроитьДеревоРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура УточнениеТипДокументаСодержащийТЧТоварыПриИзменении(Элемент)
	ПостроитьДеревоРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура УровнейВложенностиДереваРеквизитовПриИзменении(Элемент)
	ПостроитьДеревоРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ВыражениеВычисленияСтрокаНеогр_ВычислитьВыражениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстРедактирования = СтрЗаменить(Элементы.ВыражениеВычисленияСтрокаНеогр_ВычислитьВыражение.ТекстРедактирования, "¶", Символы.ПС);
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		ТекстРедактирования, ЭтаФорма, "ВыражениеВычисленияСтрокаНеогр",,, "Объект, Основание");
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторВидаКонтактнойИнформацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы("Справочник.ВидыКонтактнойИнформации.ФормаВыбора",, ЭтаФорма,
		ЭтаФорма, "ИдентификаторВидаКонтактнойИнформацииНачалоВыбораЗаверешени", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторВидаКонтактнойИнформацииНачалоВыбораЗаверешени(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ИдентификаторВидаКонтактнойИнформации = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Результат, "ИдентификаторДляФормул");
	Исключение
		// Значит в текущей версии конфигурации нет реквизита "ИдентификаторДляФормул"
		ИдентификаторВидаКонтактнойИнформации = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Результат, "Наименование");
	КонецПопытки;
	
	ВыражениеВычисления = ИдентификаторВидаКонтактнойИнформации;
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторВидаДокументаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы("Справочник.ВидыДокументовФизическихЛиц.ФормаВыбора",, ЭтаФорма,
		ЭтаФорма, "ИдентификаторВидаДокументаНачалоВыбораЗаверешение", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторВидаДокументаНачалоВыбораЗаверешение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ИдентификаторВидаДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Результат, "ИдентификаторДляФормул");
	Исключение
		// Значит в текущей версии конфигурации нет реквизита "ИдентификаторДляФормул"
		ИдентификаторВидаДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Результат, "Наименование");
	КонецПопытки;
	
	ВыражениеВычисления2 = ИдентификаторВидаДокумента;
	
КонецПроцедуры                

&НаСервере
Процедура ЗаполнитьСписокВыбораВидамиКонтактнойИнформации()
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	Если (ИмяКонфигурации1С <> "УТ"
		И ИмяКонфигурации1С <> "УПП")
		Или Метаданные.РегистрыСведений.Найти("КонтактнаяИнформация") = Неопределено Тогда
		
		Элементы.ГруппаСтараяВерсияКонтактнойИнформации.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаНоваяВерсияКонтактнойИнформации.Видимость = Ложь;
	
	// Адреса
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("АдресЮридический", "Юредический адрес");
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("АдресФактический", "Фактический адрес");
	Если ИмяКонфигурации1С = "УПП" Тогда
		Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("АдресПочтовый", "Почтовый адрес");
	КонецЕсли;
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("АдресРегистрации", "Адрес регистрации");
	
	// Телефоны
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("ТелефонОрганизации", "Телефон организации");
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("ТелефонКонтрагента", "Телефон контрагента");
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("ТелефонФизЛица", "Телефон физ.лица домашний");
	Элементы.ИдентификаторВидаКонтактнойИнформацииСтарая.СписокВыбора.Добавить("ТелефонСлужебный", "Телефон физ.лица служебный");
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторВидаКонтактнойИнформацииСтараяПриИзменении(Элемент)
	
	ВыражениеВычисления = ИдентификаторВидаКонтактнойИнформации;
	
КонецПроцедуры
