		АдресПочтыСотрудника2 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Сотрудник2, "АдресЭлектроннойПочты");
	КонецЕсли;
	
	ОбновитьВидемостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура Сотрудник1Нажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаВыбора",,
		ЭтаФорма, ЭтаФорма, "ВыборСотрудника1");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСотрудника1(Результат, ДополнительныеПараметры) Экспорт
	
	Сотрудник1 = Результат;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			Сотрудник1, "АдресЭлектроннойПочты, ТелефонОсновной");
		
		АдресПочтыСотрудника1 = ЗначенияРеквизитов.АдресЭлектроннойПочты;
		Телефон1 = ЗначенияРеквизитов.ТелефонОсновной;
	Иначе
		АдресПочтыСотрудника1 = "";
		Телефон1 = "";
	КонецЕсли;
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		Если ЗначениеЗаполнено(Телефон1) Тогда
			ПроверитьРегистрациюТелефона1Телеграм();
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьВидемостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура Сотрудник2Нажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаВыбора",,
		ЭтаФорма, ЭтаФорма, "ВыборСотрудника2");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСотрудника2(Результат, ДополнительныеПараметры) Экспорт
	
	Сотрудник2 = Результат;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			Сотрудник2, "АдресЭлектроннойПочты, ТелефонОсновной");
		
		АдресПочтыСотрудника2 = ЗначенияРеквизитов.АдресЭлектроннойПочты;
		Телефон2 = ЗначенияРеквизитов.ТелефонОсновной;
	Иначе
		АдресПочтыСотрудника2 = "";
	КонецЕсли;
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		Если ЗначениеЗаполнено(Телефон2) Тогда
			ПроверитьРегистрациюТелефона2Телеграм();
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьВидемостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодключитьТелеграм1Нажатие(Элемент)
	
