	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		ОтправитьВТелеграм = ЗначениеЗаполнено(Телефон1) Или ЗначениеЗаполнено(Телефон2);
	Иначе
		ОтправитьВТелеграм = Ложь;
	КонецЕсли;
	
	Если ИспользоватьОтправкуНаПочту Тогда
		ОтправитьНаПочту = ЗначениеЗаполнено(АдресПочтыСотрудника1) Или ЗначениеЗаполнено(АдресПочтыСотрудника2);
	Иначе
		ОтправитьНаПочту = Ложь;
	КонецЕсли;
	
	Если Не ОтправитьВТелеграм И Не ОтправитьНаПочту Тогда
		Сообщить("Не заполнены адреса и телефоны отправки");
		Возврат;
	КонецЕсли;
	
	Успех = ОтправитьПисьмаИСообщенияВТелеграм();
	
	Если Успех Тогда
		Закрыть();
		ПоказатьОповещениеПользователя("QR-код отправлен.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Повторить(Команда)
	
	ПолучитьQRКод();
	
	ОбновитьВидемостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Сотрудник1НеЗаполнен(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаВыбора",,
		ЭтаФорма, ЭтаФорма, "ВыборСотрудника1");
	
КонецПроцедуры

&НаКлиенте
Процедура Сотрудник2НеЗаполнен(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаВыбора",,
