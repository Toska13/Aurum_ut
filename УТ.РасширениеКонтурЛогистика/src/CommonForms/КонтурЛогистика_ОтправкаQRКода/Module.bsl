Функция НастройкиОтправкиПочтыЗаполнены()
	
	Возврат КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
КонецФункции

&НаСервереБезКонтекста
Функция ИндексВодительПочта(Водитель)
	
	ИндексВодительПочта = 0;
	
	Если ЗначениеЗаполнено(Водитель) Тогда
		Если ЗначениеЗаполнено(Водитель.АдресЭлектроннойПочты) Тогда
			ИндексВодительПочта = 0;
		Иначе
			ИндексВодительПочта = 1;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИндексВодительПочта;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьГруппыТелеграм()
	
	// Телефон 1
	Элементы.ДекорацияИдетПроверкаТелеграм1.Видимость = Ложь;
	Элементы.ДекорацияРезультатУспехТелеграм1.Видимость = Ложь;
	Элементы.ДекорацияПодключитьТелеграм1.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Телефон1) Тогда
		Элементы.ГруппаПроверкаТелеграм1.Видимость = Истина;
		
		Если ИдетПроверкаТелефона1ВТелеграм Тогда
			Элементы.ДекорацияИдетПроверкаТелеграм1.Видимость = Истина;
		ИначеЕсли Телефон1ЗарегестрированВТелеграм Тогда
			Элементы.ДекорацияРезультатУспехТелеграм1.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПодключитьТелеграм1.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГруппаПроверкаТелеграм1.Видимость = Ложь;
	КонецЕсли;
	
	// Телефон 2
	Элементы.ДекорацияИдетПроверкаТелеграм2.Видимость = Ложь;
	Элементы.ДекорацияРезультатУспехТелеграм2.Видимость = Ложь;
	Элементы.ДекорацияПодключитьТелеграм2.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Телефон2) Тогда
		Элементы.ГруппаПроверкаТелеграм2.Видимость = Истина;
		
		Если ИдетПроверкаТелефона2ВТелеграм Тогда
			Элементы.ДекорацияИдетПроверкаТелеграм2.Видимость = Истина;
		ИначеЕсли Телефон2ЗарегестрированВТелеграм Тогда
			Элементы.ДекорацияРезультатУспехТелеграм2.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПодключитьТелеграм2.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГруппаПроверкаТелеграм2.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефона1Телеграм()
	
	ИдетПроверкаТелефона1ВТелеграм = Истина;
	ПодключитьОбработчикОжидания("ПроверитьРегистрациюТелефона1ТелеграмВФоне", 0.1, Истина);
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

