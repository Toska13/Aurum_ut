КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтправкуВТелеграм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ПолучитьНастройкуПоИмениПредопределенного("ИспользоватьОтправкуВТелеграм"));
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_Настройки.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтправкуНаПочту(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастройкаУчетнойЗаписиЭлектроннойПочты",, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидемостьДоступность()
	
	Если ЗначениеЗаполнено(Сотрудник1) Тогда
		Элементы.Сотрудник1.Видимость = Истина;
		Элементы.Сотрудник1НеЗаполнен.Видимость = Ложь;
	Иначе
		Элементы.Сотрудник1.Видимость = Ложь;
		Элементы.Сотрудник1НеЗаполнен.Видимость = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник2) Тогда
		Элементы.Сотрудник2.Видимость = Истина;
		Элементы.Сотрудник2НеЗаполнен.Видимость = Ложь;
	Иначе
		Элементы.Сотрудник2.Видимость = Ложь;
		Элементы.Сотрудник2НеЗаполнен.Видимость = Истина;
	КонецЕсли;
	
	Элементы.ГруппаТелефон1.Видимость = ИспользоватьОтправкуВТелеграм;
	Элементы.ГруппаНастройкиТелеграм.Видимость = Не ИспользоватьОтправкуВТелеграм;
	Элементы.ГруппаТелефон2.Видимость = ИспользоватьОтправкуВТелеграм;
	Элементы.ДекорацияЗаглушкаТелефон.Видимость = Не ИспользоватьОтправкуВТелеграм;
	
	Элементы.АдресПочтыСотрудника1.Видимость = ИспользоватьОтправкуНаПочту;
	Элементы.ГруппаНастройкиПочты.Видимость = Не ИспользоватьОтправкуНаПочту;
	Элементы.АдресПочтыСотрудника2.Видимость = ИспользоватьОтправкуНаПочту;
	Элементы.ДекорацияЗаглушкаПочта.Видимость = Не ИспользоватьОтправкуНаПочту;
	
	Элементы.ГруппаСотрудник1.Видимость = (ИспользоватьОтправкуВТелеграм Или ИспользоватьОтправкуНаПочту);
	Элементы.ГруппаСотрудник2.Видимость = (ИспользоватьОтправкуВТелеграм Или ИспользоватьОтправкуНаПочту);
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка
		И ЗначениеЗаполнено(УИДМинтранса) Тогда
		
		Элементы.ФормаПовторить.Видимость = Истина;
	Иначе
		Элементы.ФормаПовторить.Видимость = Ложь;
	КонецЕсли;
	
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьQRКод()
	
	ТекстОтветаСервиса = "";
	
	АдресХранилищаДвоичныхДанных = ПоместитьВоВременноеХранилище(, УникальныйИдентификатор);
	
	Если Не ЗначениеЗаполнено(kl_id) Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка;
		Элементы.ФормаОтправить.Видимость = Ложь;
		Элементы.ФормаПовторить.Видимость = Ложь;
		Элементы.УИДМинтранс.Видимость = ЗначениеЗаполнено(УИДМинтранса);
		Элементы.kl_id.Видимость = ЗначениеЗаполнено(kl_id);
		Элементы.НадписьОшибка.Видимость = Ложь;
		Элементы.НадписьОшибкаАвторизации.Видимость = Ложь;
		Элементы.НадписьОшибкаАпикей.Видимость = Ложь;
		Элементы.НадписьОшибкаKLID.Видимость = Истина;
		Элементы.ГруппаОтветСервиса.Видимость = ЗначениеЗаполнено(ТекстОтветаСервиса);
		Возврат;
	КонецЕсли;
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("kl_id", kl_id);
	Если ЗначениеЗаполнено(ОрганизацияДиадок) Тогда
		ПараметрыФоновогоЗадания.Вставить("ОрганизацияДиадок", ОрганизацияДиадок);
	Иначе
		ПараметрыФоновогоЗадания.Вставить("ОрганизацияДиадок", Неопределено);
	КонецЕсли;
	
	Если ЭтоЭТрН Тогда
		ИмяМетода = "КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьQRКодЭТрНGIFФайла";
	ИначеЕсли ЭтоЭПЛ Или ЭтоЭПЛ_5_02 Тогда
		ИмяМетода = "КонтурЛогистика_ДлительныеОперацииСервер.ПолучитьQRКодЭПЛGIFФайла";
	Иначе
		ВызватьИсключение "Не удалось определить тип документа";
	КонецЕсли;
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		ИмяМетода, ПараметрыФоновогоЗадания,, "Получение QR-кода", АдресХранилищаДвоичныхДанных);
	
	Если РезультатЗапуска.Статус = "Выполняется" Тогда
		
		ИдентификаторЗадания = РезультатЗапуска.ИдентификаторЗадания;
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОжидание;
		Элементы.ФормаОтправить.Видимость = Ложь;
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание", 0.1, Истина);
		
	ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
		
		ОбработатьРезультатКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтправитьПисьмаИСообщенияВТелеграм()
	
	УспехОтправкиНаПочту = Истина;
	УспехОтправкиВТелеграм = Истина;
	
	ДвоичныеДанныеQRКода = ПолучитьИзВременногоХранилища(АдресХранилищаДвоичныхДанных);
	
	Если ИспользоватьОтправкуНаПочту
		И (ЗначениеЗаполнено(АдресПочтыСотрудника1) Или ЗначениеЗаполнено(АдресПочтыСотрудника2)) Тогда
		
		УспехОтправкиНаПочту = ОтправитьПисьмо(ДвоичныеДанныеQRКода);
	КонецЕсли;
	
	Если ИспользоватьОтправкуВТелеграм
		И (ЗначениеЗаполнено(Телефон1) Или ЗначениеЗаполнено(Телефон2)) Тогда
		
		УспехОтправкиВТелеграм = ОтправитьВТелеграм(ДвоичныеДанныеQRКода);
	КонецЕсли;
	
	Возврат (УспехОтправкиНаПочту И УспехОтправкиВТелеграм);
	
КонецФункции

&НаСервере
Функция ОтправитьПисьмо(ДвоичныеДанныеQRКода)
	
	Письмо = ПолучитьИзВременногоХранилища(АдресХранилищаПисьма);
	Письмо.Получатели.Очистить();
	Если ЗначениеЗаполнено(АдресПочтыСотрудника1) Тогда
		Письмо.Получатели.Добавить(АдресПочтыСотрудника1);
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресПочтыСотрудника2) Тогда
		Письмо.Получатели.Добавить(АдресПочтыСотрудника2);
	КонецЕсли;
	
	Вложение = Письмо.Вложения.Добавить(ДвоичныеДанныеQRКода, "QR");
	Вложение.Идентификатор = "QR";
	Вложение.СпособКодирования = СпособКодированияИнтернетПочтовогоВложения.MIME;
	Вложение.ТипСодержимого = "image/gif";
	
	ТекстОшибки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Сообщить("Не удалось отправить на почту.
			|Ошибка: " + ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОтправитьВТелеграм(ДвоичныеДанныеQRКода)
	
	ПараметрыОтправки = ПолучитьИзВременногоХранилища(АдресХранилищаПараметровОтправки);
	
	Сообщения = РегистрыСведений.КонтурЛогистика_ОчередьОтправкиQRКодов.СформироватьСообщенияВТелеграм(
		ПараметрыОтправки, ДвоичныеДанныеQRКода);
	
	ЕстьОшибки = ОтправитьВТелеграмНаТелефон(Телефон1, Сообщения);
	
	ЕстьОшибки = (ОтправитьВТелеграмНаТелефон(Телефон2, Сообщения) Или ЕстьОшибки);
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Функция ОтправитьВТелеграмНаТелефон(Телефон, Сообщения)
	
	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = КонтурЛогистика_РаботаСТелеграм.ОтправитьСообщения(Телефон, Сообщения);
	
	Если Результат.ЕстьОшибки Тогда
		Сообщить("Не удалось отправить в Телеграм по номеру: " + Строка(Телефон) + "
			|Ошибка: " + Результат.ТекстОшибки);
		Возврат Истина;
	КонецЕсли;
	
	Если Не Результат.ТелефонЗарегестрирован Тогда
		Сообщить("Не удалось отправить в Телеграм по номеру: " + Строка(Телефон) + "
			|Ошибка: номер телефона не зарегестрирован в Телеграм боте");
		Возврат Истина;
	КонецЕсли;
	
	Если Не Результат.СообщениеОтправлено Тогда
		Сообщить("Не удалось отправить в Телеграм по номеру: " + Строка(Телефон));
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьФоновоеЗадание() Экспорт
	
	ЗаданиеАктивно = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторЗадания, Элементы.ДекорацияЛоадерТемп);
	
	Если ЗаданиеАктивно Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание", 2, Истина);
		
	Иначе
		
		ОбработатьРезультатКлиент();
		
	КонецЕсли;
	
	ОбновитьВидемостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатКлиент()
	
	ОбработатьРезультат();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультат()
	
	Результат = ПолучитьИзВременногоХранилища(АдресХранилищаДвоичныхДанных);
	
	// До вступления в силу ЭПЛ 5.02 формируем тестовый код со строкой "Тестовая перевозка ЭПЛ 5.02"
	Если ЭтоЭПЛ_5_02 И Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502() Тогда
		
		Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТестовыйQRКодДляЭПЛ502();			
		ПоместитьВоВременноеХранилище(Результат, АдресХранилищаДвоичныхДанных)
		
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("ДвоичныеДанные") Тогда
		
		Картинка = АдресХранилищаДвоичныхДанных;
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаQRКод;
		Элементы.ФормаОтправить.Видимость = Истина;
		Элементы.ФормаПовторить.Видимость = Ложь;
		
	Иначе
		
		ТекстОтветаСервиса = Результат;
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка;
		Элементы.НадписьОшибка.Видимость = Истина;
		Элементы.НадписьОшибкаАвторизации.Видимость = Ложь;
		Элементы.НадписьОшибкаАпикей.Видимость = Ложь;
		Элементы.НадписьОшибкаKLID.Видимость = Ложь;
		Элементы.ФормаОтправить.Видимость = Ложь;
		Элементы.ФормаПовторить.Видимость = Истина;
		
	КонецЕсли;
	
	Элементы.ГруппаОтветСервиса.Видимость = ЗначениеЗаполнено(ТекстОтветаСервиса);
	
КонецПроцедуры

