#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("ДокументСсылка") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
	
	ПараметрыОтправки = КонтурЛогистика_Уведомления.ДанныеПоДокументу(Параметры.ДокументСсылка);
	
	Письмо = РегистрыСведений.КонтурЛогистика_ОчередьОтправкиQRКодов.СформироватьПисьмо(ПараметрыОтправки);
	
	kl_id = ПараметрыОтправки.kl_id;
	УИДМинтранса = ПараметрыОтправки.УИДМинтранса;
	Сотрудник1 = ПараметрыОтправки.Сотрудник1;
	Телефон1 = ПараметрыОтправки.Телефон1;
	АдресПочтыСотрудника1 = ПараметрыОтправки.АдресПочтыСотрудника1;
	Сотрудник2 = ПараметрыОтправки.Сотрудник2;
	Телефон2 = ПараметрыОтправки.Телефон2;
	АдресПочтыСотрудника2 = ПараметрыОтправки.АдресПочтыСотрудника2;
	ТемаПисьма = Письмо.Тема;
	
	АдресХранилищаПисьма = ПоместитьВоВременноеХранилище(Письмо, УникальныйИдентификатор);
	АдресХранилищаПараметровОтправки = ПоместитьВоВременноеХранилище(ПараметрыОтправки, УникальныйИдентификатор);
	
	ЭтоЭТрН = (КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Параметры.ДокументСсылка)
		Или ТипЗнч(Параметры.ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная"));
	ЭтоЭПЛ = КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Параметры.ДокументСсылка);
	ЭтоЭПЛ_5_02 = КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ_5_02(Параметры.ДокументСсылка);
	
	ОрганизацияДиадок = РегистрыСведений.КонтурЛогистика_ОчередьОтправкиQRКодов.АвторизованнаяОрганизацияПоДокументу(
		ПараметрыОтправки.Документ);
	
	Если Не ЗначениеЗаполнено(kl_id) Тогда
		kl_id = КонтурЛогистика_Уведомления.ИдентификаторДокументаЛогистикиИзФайлов(Параметры.ДокументСсылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыСервиса(ОрганизацияСсылка)
	
	Возврат КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияСсылка);
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ГруппаОтветСервиса.Видимость = ЗначениеЗаполнено(ТекстОтветаСервиса);
	
	ПараметрыСервиса = ПолучитьПараметрыСервиса(ОрганизацияДиадок);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка;
		Элементы.ФормаОтправить.Видимость = Ложь;
		Элементы.ФормаПовторить.Видимость = Ложь;
		Элементы.УИДМинтранс.Видимость = ЗначениеЗаполнено(УИДМинтранса);
		Элементы.kl_id.Видимость = ЗначениеЗаполнено(kl_id);
		Элементы.НадписьОшибка.Видимость = Ложь;
		Элементы.НадписьОшибкаKLID.Видимость = Ложь;
		
		Если ПараметрыСервиса.РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow") Тогда
			Элементы.НадписьОшибкаАвторизации.Видимость = Истина;
			Элементы.НадписьОшибкаАпикей.Видимость = Ложь;
		Иначе
			Элементы.НадписьОшибкаАвторизации.Видимость = Ложь;
			Элементы.НадписьОшибкаАпикей.Видимость = Истина;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УИДМинтранса) Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОшибка;
		Элементы.ФормаОтправить.Видимость = Ложь;
		Элементы.ФормаПовторить.Видимость = Ложь;
		Элементы.УИДМинтранс.Видимость = ЗначениеЗаполнено(УИДМинтранса);
		Элементы.kl_id.Видимость = ЗначениеЗаполнено(kl_id);
		Элементы.НадписьОшибка.Видимость = Истина;
		Элементы.НадписьОшибкаАвторизации.Видимость = Ложь;
		Элементы.НадписьОшибкаАпикей.Видимость = Ложь;
		Элементы.НадписьОшибкаKLID.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ПолучитьQRКод();
	
	ОбновитьВидемостьДоступность();
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		Если ЗначениеЗаполнено(Телефон1) Тогда
			ПроверитьРегистрациюТелефона1Телеграм();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Телефон2) Тогда
			ПроверитьРегистрациюТелефона2Телеграм();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_Сотрудники" Тогда
		
		Если Параметр = Сотрудник1 Тогда
			АдресПочтыСотрудника1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Сотрудник1, "АдресЭлектроннойПочты");
		КонецЕсли;
		
		Если Параметр = Сотрудник2 Тогда
			АдресПочтыСотрудника2 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Сотрудник2, "АдресЭлектроннойПочты");
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзменениеОбщейНастройки"
		И Параметр = "ИспользоватьОтправкуВТелеграм" Тогда
		
		ИспользоватьОтправкуВТелеграм = ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
		ОбновитьВидемостьДоступность();
		
		Если ЗначениеЗаполнено(Телефон1) Тогда
			ПроверитьРегистрациюТелефона1Телеграм();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Телефон2) Тогда
			ПроверитьРегистрациюТелефона2Телеграм();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзменениеНастройкиУчетнойЗаписиЭлектроннойПочты" Тогда
		
		ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
		ОбновитьВидемостьДоступность();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Водитель1ПриИзменении(Элемент)
	
