&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаПротокол.Видимость = Ложь;
	ПеречитатьДанныеОВерсиях();
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбновление(Команда)
	
	
	Если ТребуетсяОбновление Тогда
		
		Завершено = Ложь;
		ЗавершеноАварийно = Ложь;
		ОбновитьВидимостьЭлементов();
		
		Попытка
			
			УдалосьЗапуститьФоновое = ЗапуститьФоновоеЗаданиеОбновления();
			
		Исключение
			
			УдалосьЗапуститьФоновое = Ложь;
			
			Элементы.ОбновитьСинхронно.Видимость = Истина;
			ФоновоеЗаданиеНедоступно = Истина;
			Элементы.ПродолжитьОбновление.Видимость = Ложь;
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
				"В базе не активен менеджер заданий, так бывает если у вас давно не обновлялась платформа 1С" + Символы.ПС + "Придется выполнять обновление синхронно, сеанс при этом временно ""зависнет""");
			
		КонецПопытки;
		
		Если УдалосьЗапуститьФоновое Тогда
			
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеКлиент", 0.1, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗаданиеОбновления()
	
	//ФоновыеЗадания.ПолучитьФоновыеЗадания() - вычислить для просмотра
	
	
	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(ТекущаяВерсияДанных);
	
	ЗаданиеВыгрузки = ФоновыеЗадания.Выполнить("КонтурЛогистика_ОбновлениеВерсииМодуля.ВыполнитьПереходНаНовуюВерсию_ФоновоеЗадание", ПараметрыВызова, "КонтурЛогистика_Обновление", "Обновление данных при запуске нового релиза подсистемы");
	
	ИдентификаторФоновогоЗадания = ЗаданиеВыгрузки.УникальныйИдентификатор;
	
	Элементы.ГруппаПрогрессОбновления.Видимость = Истина;
	Элементы.ГруппаПротокол.Видимость = Истина;
	Элементы.ГруппаПродолжитьОбновление.Видимость = Ложь;
	
	Возврат Истина;
	
КонецФункции // ЗапуститьФоновоеЗаданиеОбновления()

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеКлиент() Экспорт
	
	ПроверитьФоновоеЗаданиеОбновленияСервер(ИдентификаторФоновогоЗадания);
	
	Если ЗавершеноАварийно ИЛИ Завершено Тогда
		
		ОбновитьПовторноИспользуемыеЗначения();
		Элементы.ГруппаПрогрессОбновления.Видимость = ложь;
		ПеречитатьДанныеОВерсиях();
		ОбновитьВидимостьЭлементов();
		Оповестить("ЗавершениеФоновогоЗадания", Новый Структура("ИдентификаторЗадания,КлючФЗ,Успешно", 
												ИдентификаторФоновогоЗадания, "ОбновлениеДанныхПодсистемы", Завершено));
		
	Иначе
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеКлиент", 3, Истина);
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьФоновоеЗаданиеКлиент()

&НаСервере
Процедура ПроверитьФоновоеЗаданиеОбновленияСервер(ИдентификаторФоновогоЗадания)

	ЗаданиеОбновления = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФоновогоЗадания);
	
	СообщенияФонового = ЗаданиеОбновления.ПолучитьСообщенияПользователю();
	ВывестиПротокол(СообщенияФонового);
	
	Если ЗаданиеОбновления.Состояние = СостояниеФоновогоЗадания.Завершено 
		ИЛИ ЗаданиеОбновления.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		
		Завершено = Истина;
		
		ЗавершеноАварийно = (ЗаданиеОбновления.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно);
	Иначе
		Завершено = Ложь;
		ЗавершеноАварийно = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПротокол(СообщенияФонового)

	ПротоколОбновления = "";
	Для Каждого Сообщение из СообщенияФонового Цикл
		ПротоколОбновления = Сообщение.Текст + Символы.ПС + ПротоколОбновления ;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеречитатьДанныеОВерсиях()
	
	АктивнаяВерсияДанных = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияДанныхПодсистемыКонтурЛогистика();
	ТекущаяВерсияДанных = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	ТребуетсяОбновление = КонтурЛогистика_ОбновлениеВерсииМодуля.ТребуетсяВыполнитьПереходНаНовуюВерсию();
	
КонецПроцедуры // ПеречитатьДанныеОВерсиях()

&НаСервере
Процедура ОбновитьВидимостьЭлементов()
	
	// ТребуетсяОбновление могло получить устаревшие данные, опираемся на Завершено
	УспешноЗавершено = Завершено И НЕ ЗавершеноАварийно;
	
	Элементы.ГруппаАварийноеЗавершение.Видимость = ЗавершеноАварийно;
	Элементы.ГруппаЗавершеноУспешно.Видимость = УспешноЗавершено;
	
	Элементы.ГруппаПродолжитьОбновление.Видимость = ТребуетсяОбновление И НЕ УспешноЗавершено;
	
	Элементы.НадписьВывод.Заголовок = ?(ТребуетсяОбновление И НЕ УспешноЗавершено,  "Требуется обновление подсистемы", "Обновление подсистемы не требуется");
	
	Если ЗавершеноАварийно Тогда 
		
		Элементы.ПродолжитьОбновление.Заголовок = "Попробовать еще раз";	
		
	ИначеЕсли Завершено Тогда
		
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ОбновитьСинхронноНаСервере()
	
	КонтурЛогистика_ОбновлениеВерсииМодуля.ВыполнитьПереходНаНовуюВерсию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСинхронно(Команда)
	
	Элементы.ГруппаПрогрессОбновления.Видимость = Истина;
	
	ПодключитьОбработчикОжидания("ЗапускаторОбновленияСинхронно", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапускаторОбновленияСинхронно()

	ОбновитьСинхронноНаСервере();
	
	Элементы.ГруппаПрогрессОбновления.Видимость = Ложь;
	
	ПеречитатьДанныеОВерсиях();
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры 


&НаКлиенте
Процедура ОбратитьсяВТехподдержку(Команда)
	
	КонтурЛогистика_ЦентрПоддержкиКлиент.ОткрытьЦентрПоддержки();
	
КонецПроцедуры

