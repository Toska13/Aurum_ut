    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ЗадачиДинамическийСписокТрнТитул7ПослеТитула4.ГлавныйДокумент</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ЗадачиДинамическийСписокТрнТитул7ПослеТитула4.Дата</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ЗадачиДинамическийСписокТрнТитул7ПослеТитула4.Документ1С</segments>
