    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ЗадачиДинамическийСписок.ТребуемоеДействие</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВЫБОР
		КОГДА КонтурЛогистика_ТрН_Титул1.Ссылка ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.Оформить)
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление)
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен)
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен)
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
			ТОГДА ВЫБОР
					КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &amp;Т1НастройкаСостояниеРаспечатать
							И &amp;ВыводитьЗадачуРаспечатать
						ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.Распечатать)
					ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1
				КОНЕЦ
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки)
		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление)
	КОНЕЦ КАК ТребуемоеДействие,
	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыОсобенностейДокументооборота.ПустаяСсылка) КАК ОсобенностиДокументооборота,
	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус,
	втДокументы.Ссылка КАК Документ1С,
	КонтурЛогистика_ТрН_Титул1.Ссылка КАК ДокументЛогистика,
	втДокументы.Номер КАК Номер,
	НАЧАЛОПЕРИОДА(втДокументы.Дата, ДЕНЬ) КАК Дата,
	втДокументы.Организация КАК Организация,
	втДокументы.Контрагент КАК Контрагент,
	втДокументы.Перевозчик КАК Перевозчик,
	втДокументы.Отправитель КАК Отправитель,
	втДокументы.Получатель КАК Получатель,
	втДокументы.Доп1 КАК Доп1,
	втДокументы.Доп2 КАК Доп2,
	КонтурЛогистика_ТрН_Титул1.Номер КАК ЛогистикаДокументНомер,
	КонтурЛогистика_ТрН_Титул1.Дата КАК ЛогистикаДокументДата,
	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ГлавныйДокумент,
	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.ТестовыйДокумент КАК ТестовыйДокумент,
	ВЫБОР
		КОГДА КонтурЛогистика_ТрН_Титул1.Ссылка ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК КартинкаЛогистика,
	втДокументы.Ссылка.Проведен КАК Документ1СПроведен,
	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ДокументЭТРН,
	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК СтатусЭТРН,
	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.НомерТрН, втДокументы.НомерТРН) КАК НомерТрН,
	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.ДатаТрН, втДокументы.ДатаТРН) КАК ДатаТрН,
	ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ТрН_Титул1.ПустаяСсылка) КАК ПредыдущийТитул,
	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КомментарииВодителяПриПогрузке &lt;> &quot;&quot;
		ИЛИ КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КомментарииВодителяПриВыгрузке &lt;> &quot;&quot; КАК КомментарииВодителя,
	ВЫБОР
		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 0
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 0
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 0
			ТОГДА 0
		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 0
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 0
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 1
			ТОГДА 1
		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 0
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 1
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 0
			ТОГДА 2
		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 1
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 0
				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 0
			ТОГДА 3
		ИНАЧЕ 4
	КОНЕЦ КАК КартинкаПереадресовокЗамен,
	КонтурЛогистика_ТрН_Титул1.ОтправительШаблона КАК ОтправительШаблона,
	втДокументы.МестоПогрузки КАК МестоПогрузки,
	втДокументы.МестоДоставки КАК МестоДоставки,
	втДокументы.Водитель КАК Водитель,
	втДокументы.ТранспортноеСредство КАК ТранспортноеСредство,
    ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка) КАК ВодительЛогистика
ИЗ
	(ВЫБРАТЬ
		КонтурЛогистика_Вспомогательный.Ссылка КАК Ссылка,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаОрганизация КАК Организация,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаКонтрагент КАК Контрагент,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаПеревозчик КАК Перевозчик,
		КонтурЛогистика_Вспомогательный.Номер КАК Номер,
		КонтурЛогистика_Вспомогательный.Дата КАК Дата,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаГрузоотправитель КАК Отправитель,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаГрузополучатель КАК Получатель,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаДоп1 КАК Доп1,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаДоп2 КАК Доп2,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаМестоПогрузки КАК МестоПогрузки,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаМестоДоставки КАК МестоДоставки,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаНомерТРН КАК НомерТРН,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаДатаТРН КАК ДатаТРН,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаВодитель КАК Водитель,
		КонтурЛогистика_Вспомогательный.ИмяРеквизитаТранспортноеСредство КАК ТранспортноеСредство
	ИЗ
		Документ.КонтурЛогистика_Вспомогательный КАК КонтурЛогистика_Вспомогательный
	ГДЕ
		КонтурЛогистика_Вспомогательный.Дата МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
		И НЕ КонтурЛогистика_Вспомогательный.ПометкаУдаления
		И (КонтурЛогистика_Вспомогательный.ИмяРеквизитаОрганизация В (&amp;НашиОрганизацииУчСист)
				ИЛИ &amp;БезФильтраОрганизация)
		И (КонтурЛогистика_Вспомогательный.ИмяРеквизитаПеревозчик В (&amp;НастроенныеПеревозчикиУчСист)
				ИЛИ &amp;БезФильтраПеревозчик)
		И (КонтурЛогистика_Вспомогательный.ИмяРеквизитаКонтрагент В (&amp;НастроенныеГрузополучателиУчСист)
				ИЛИ &amp;БезФильтраКонтрагент)) КАК втДокументы
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
			ПО КонтурЛогистика_ТрН_Титул1.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
			ПО КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
		ПО втДокументы.Ссылка = КонтурЛогистика_ТрН_Титул1.ДокументОснование
			И (НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления)
ГДЕ
	ИСТИНА   //ДопУсловиеГДЕ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
    </extInfo>
