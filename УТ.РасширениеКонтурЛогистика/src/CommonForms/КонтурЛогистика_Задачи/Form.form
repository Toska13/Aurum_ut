    <name>ЗадачиДинамическийСписокТрнТитул3ПослеТитула7</name>
    <title>
      <key>ru</key>
      <value>Задачи динамический список</value>
    </title>
    <id>19</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
