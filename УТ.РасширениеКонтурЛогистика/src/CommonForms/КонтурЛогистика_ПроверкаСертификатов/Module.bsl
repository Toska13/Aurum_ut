#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	ТекПользовательЯвляетсяАдминистратором = КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор();
	
	Отказ = ВыполнитьПроверку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ТекПользовательЯвляетсяАдминистратором Тогда		
		Элементы.СертификатыПользователь.Видимость = Ложь;		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы = Неопределено Или Не ЗавершениеРаботы Тогда
		Оповестить("ВыполнитьПроверкуСертификатов");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ОбновитьФормуПроверкиСертификатов" Тогда
		
		Если ВыполнитьПроверку() Тогда
			Закрыть();	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ТаблицаСертификатов

&НаСервере
Функция ВыполнитьПроверку()
	
	ОчиститьТаблицуСертификатов();
	
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.СертификатыДляПроверки(ТекПользователь, ТекПользовательЯвляетсяАдминистратором);
	
	ЭтаФорма.Заголовок = "";
	Если Результат.КолвоПроблемныхСертификатов > 0 И Результат.КолвоПроблемныхМЧД > 0 Тогда		
		ЭтаФорма.Заголовок = "Истекает срок действия сертификатов и МЧД";		
	ИначеЕсли Результат.КолвоПроблемныхСертификатов > 0 И Результат.КолвоПроблемныхМЧД = 0 Тогда
		ЭтаФорма.Заголовок = "Истекает срок действия сертификатов";
	ИначеЕсли Результат.КолвоПроблемныхСертификатов = 0 И Результат.КолвоПроблемныхМЧД > 0 Тогда
		ЭтаФорма.Заголовок = "Истекает срок действия МЧД";
	КонецЕсли;
	
	Если Результат.КолвоНеПрошедшихПроверкуМЧД > 0 Тогда		
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ?(ЗначениеЗаполнено(ЭтаФорма.Заголовок) , " и есть ошибки в МЧД", "Есть ошибки в МЧД");;
	КонецЕсли;
	
	Если Результат.СертификатыДЗ.Строки.Количество() > 0 Тогда
		
		Элементы.СертификатыДопПараметр.Видимость = Результат.ЗаполненДопПараметр;
		
		ЗаполнитьТаблицуСертификатов(Результат.СертификатыДЗ);
		
	Иначе		
		Возврат Истина;		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОчиститьТаблицуСертификатов()
	
	СертификатыДЗ = РеквизитФормыВЗначение("Сертификаты"); 
    СертификатыДЗ.Строки.Очистить(); 
    ЗначениеВРеквизитФормы(СертификатыДЗ, "Сертификаты");
		
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьТаблицуСертификатов()
	
	Строки = Сертификаты.ПолучитьЭлементы();
	
	Для Каждого Строка Из Строки Цикл
		
	    ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
	    Элементы.Сертификаты.Развернуть(ИдентификаторСтроки);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСертификатов(СертификатыДЗ)
	
	ЗначениеВДанныеФормы(СертификатыДЗ, Сертификаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросыИОтветыНажатие(Элемент)
	
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке("https://support.kontur.ru/ca/ustanovka-i-kopirovaniye");
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекКолонка = Поле;
		ИмяКолонки = ТекКолонка.Имя;
					
		Если ИмяКолонки = "СертификатыОрганизация" Тогда
			
			ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
			
			Если Элементы.Сертификаты.Развернут(ИдентификаторСтроки) Тогда				
				Элементы.Сертификаты.Свернуть(ИдентификаторСтроки);				
			Иначе				
				Элементы.Сертификаты.Развернуть(ИдентификаторСтроки);				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИмяКолонки = "СертификатыДействия" И ТекущиеДанные.Действия = "Проверить" Тогда
			
			ТекущаяНастройкаСертификата = Сертификаты.НайтиПоИдентификатору(Элементы.Сертификаты.ТекущаяСтрока);
			
			СтруктураЗаписи = Новый Структура("ОрганизацияДиадок, Пользователь1С, СертификатНаСервере, ДопПараметр, Период",
				ТекущаяНастройкаСертификата.ОрганизацияДиадок, ТекущаяНастройкаСертификата.Пользователь, ТекущаяНастройкаСертификата.СертификатНаСервере,
				ТекущаяНастройкаСертификата.ДопПараметр, ТекущаяНастройкаСертификата.Период);
			
			МассивКонструктораКлюча = Новый Массив;
			МассивКонструктораКлюча.Добавить(СтруктураЗаписи);
			
			КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.КонтурЛогистика_НастройкиПодписания", МассивКонструктораКлюча);
			ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_НастройкиПодписания.Форма.ФормаЗаписи", ПараметрыФормы, 
				,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
						
		ИначеЕсли ИмяКолонки = "СертификатыДействия" И ТекущиеДанные.Действия = "Заменить" Тогда
						
			ТекущаяНастройкаСертификата = Сертификаты.НайтиПоИдентификатору(Элементы.Сертификаты.ТекущаяСтрока);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Сертификат", ТекущаяНастройкаСертификата.Сертификат);
			ПараметрыФормы.Вставить("МЧД", ТекущаяНастройкаСертификата.МЧД);
			Если ЗначениеЗаполнено(ТекущаяНастройкаСертификата.ДопПараметр) Тогда
				ПараметрыФормы.Вставить("ДопПараметр", ТекущаяНастройкаСертификата.ДопПараметр);
			КонецЕсли;
			ПараметрыФормы.Вставить("СостояниеСертификата", ТекущаяНастройкаСертификата.СостояниеСертификата);
			ПараметрыФормы.Вставить("СостояниеМЧД", ТекущаяНастройкаСертификата.СостояниеМЧД);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ДействияПроверкиСертификатМЧД", ПараметрыФормы, , , , , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НапомнитьПозжеНажатие(Элемент)
	
	Оповестить("ВыполнитьПроверкуСертификатов");
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти
