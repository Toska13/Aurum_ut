&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Титул = Параметры.Титул;
	ДокументЭТрН = Титул.ДокументЭТрН;
	ДокументОснование = Титул.ДокументОснование;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Титул);
	НомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипДокумента);
			
	Если НомерТитула = 1 Тогда 
		ИсключаяСвойства = "Акты, Штрафы, ТелефоныПереадресующего, ДополнительныеВодители";
	ИначеЕсли НомерТитула = 5 Тогда 
		ИсключаяСвойства= "";
	Иначе 
		ИсключаяСвойства = "Акты, Штрафы";
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Титул,, ИсключаяСвойства);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДокументЭТрН);
	
	ИмяТаблицыОтметок = ИмяТаблицыОтметок();
	
	Если ЗначениеЗаполнено(ИмяТаблицыОтметок) Тогда 
		
		Для Каждого СтрокаОтметки Из Титул[ИмяТаблицыОтметок] Цикл
			ЗаполнитьЗначенияСвойств(Отметки.Добавить(), СтрокаОтметки);	
		КонецЦикла;
		
		Для Каждого СтрокаАкт Из Титул.Акты Цикл
			ЗаполнитьЗначенияСвойств(Акты.Добавить(), СтрокаАкт);	
		КонецЦикла;
		
		Для Каждого СтрокаШтраф Из Титул.Штрафы Цикл
			ЗаполнитьЗначенияСвойств(Штрафы.Добавить(), СтрокаШтраф);	
		КонецЦикла;
		
	КонецЕсли;
	
	Если НомерТитула = 1 Тогда 
		
		Для Каждого Строка Из Титул.ТелефоныПереадресующего Цикл
			ЗаполнитьЗначенияСвойств(ТелефоныПереадресующего.Добавить(), Строка);	
		КонецЦикла;
		
		Для Каждого Строка Из Титул.ДополнительныеВодители Цикл
			ЗаполнитьЗначенияСвойств(ДополнительныеВодители.Добавить(), Строка);	
		КонецЦикла;
		
	КонецЕсли;	
	
	НомИспр = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьНомерИсправленияТитула(Титул);
	ДатаИспр = ТекущаяДата(); 
	
	Элементы.Декорация1.Заголовок = "Исправление №" + НомИспр + " от " + Формат(ДатаИспр, "ДФ='dd.MM.yyyy ""г.""'");
	
	Для Каждого Файл Из Параметры.ФайлыКУдалению Цикл 
		
		НоваяСтрока = ФайлыНаУдаление.Добавить();
		НоваяСтрока.Файл = Файл;
		
		нСтроки = ТитулыНаУдаление.НайтиСтроки(Новый Структура("Титул", Файл.СвязанныйДокумент));	
		Если Не нСтроки.Количество() Тогда 
			НоваяСтрока = ТитулыНаУдаление.Добавить();
			НоваяСтрока.Титул = Файл.СвязанныйДокумент;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.СтраницаОтметки.Видимость = ЗначениеЗаполнено(ИмяТаблицыОтметок);
	Элементы.СтраницаТитул1.Видимость  = НомерТитула = 1;
	
	Элементы.Страницы.Видимость = НомерТитула <= 3;
	Элементы.ГруппаИсправлениеТитула.Видимость = НомерТитула > 3;
	
КонецПроцедуры	

&НаСервере
Функция ИмяТаблицыОтметок()

	Если НомерТитула = 1 Тогда
		
		ИмяТаблицыОтметок = "ОтметкиГрузоотправителя";
		
	ИначеЕсли НомерТитула = 3 Тогда 	
		
		ИмяТаблицыОтметок = "ОтметкиГрузополучателя";
		
	ИначеЕсли НомерТитула = 7 Тогда 	
		
		ИмяТаблицыОтметок = "ОтметкиПА";
		
	ИначеЕсли НомерТитула = 8 Тогда 	
		
		ИмяТаблицыОтметок = "ОтметЗам";	
		
	Иначе
		
		ИмяТаблицыОтметок = "";
		
	КонецЕсли;	

	Возврат ИмяТаблицыОтметок;
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьИсправление(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат
	КонецЕсли;	
	
	Успешно = Истина;
	ПродолжитьИсправлениеНаСервере(Успешно);
	
	Если Успешно Тогда 
		
		Закрыть(ИсправленныйТитул);
		
		Если Не ВладелецФормы = Неопределено И Найти(ВладелецФормы.ИмяФормы, "ФормаДокумента") Тогда
			ВладелецФормы.Закрыть();
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПродолжитьИсправлениеНаСервере(Успешно)
		
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
		
		Если НомерТитула > 3 Тогда
			
			НовыйТитул = Титул.Скопировать();
			
			НовыйТитул.Дата = ТекущаяДатаСеанса();
			НовыйТитул.ДатаИспр = ДатаИспр;
			НовыйТитул.НомИспр = НомИспр;
			НовыйТитул.Записать();
			
			ИсправленныйТитул = НовыйТитул.Ссылка;
			
				
		Иначе		
			
			Если НомерТитула = 1 Тогда 
				ИсключаяСвойства = "Акты, Штрафы, ТелефоныПереадресующего, ДополнительныеВодители";
			Иначе 
				ИсключаяСвойства = "Акты, Штрафы";
			КонецЕсли;
			
			// Создание титула исправления
			
			НовыйТитул = Титул.Скопировать();
			ЗаполнитьЗначенияСвойств(НовыйТитул, ЭтаФорма,, ИсключаяСвойства);
			
			ИмяТаблицыОтметок = ИмяТаблицыОтметок();
			
			НовыйТитул[ИмяТаблицыОтметок].Очистить();
			Для Каждого СтрокаОтметки Из Отметки Цикл
				ЗаполнитьЗначенияСвойств(НовыйТитул[ИмяТаблицыОтметок].Добавить(), СтрокаОтметки);	
			КонецЦикла;
			
			НовыйТитул.Акты.Очистить();
			Для Каждого СтрокаАкт Из Акты Цикл
				ЗаполнитьЗначенияСвойств(НовыйТитул.Акты.Добавить(), СтрокаАкт);	
			КонецЦикла;
			
			НовыйТитул.Штрафы.Очистить();
			Для Каждого СтрокаШтраф Из Штрафы Цикл
				ЗаполнитьЗначенияСвойств(НовыйТитул.Штрафы.Добавить(), СтрокаШтраф);	
			КонецЦикла;
			
			// Добавление Телефонов ПА и Доп. водителей
			Если НомерТитула = 1 Тогда 
				
				НовыйТитул.ТелефоныПереадресующего.Очистить();
				Для Каждого Строка Из ТелефоныПереадресующего Цикл
					ЗаполнитьЗначенияСвойств(НовыйТитул.ТелефоныПереадресующего.Добавить(), Строка);	
				КонецЦикла;
				
				НовыйТитул.ДополнительныеВодители.Очистить();
				Для Каждого Строка Из ДополнительныеВодители Цикл
					ЗаполнитьЗначенияСвойств(НовыйТитул.ДополнительныеВодители.Добавить(), Строка);	
				КонецЦикла;
				
			КонецЕсли;	
			
			НовыйТитул.Записать();
			
			ИсправленныйТитул = НовыйТитул.Ссылка;
			
			// Изменение в ЭТрН
			
			ДокументЭТрНОбъект = ДокументЭТрН.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(ДокументЭТрНОбъект, ЭтаФорма, "ТранспортноеСредство, Прицеп, Прицеп2, НомЗак, ДатаЗак, МестоДоставки");
			
			Если НомерТитула = 1 Тогда 
				
				ДокументЭТрНОбъект.КомментарииВодителяПриПогрузке = "";
				ДокументЭТрНОбъект.КомментарииВодителяПриВыгрузке = "";
				
			ИначеЕсли НомерТитула = 3 Тогда  
				
				ДокументЭТрНОбъект.КомментарииВодителяПриВыгрузке = "";
				
			КонецЕсли;	
			
			ДокументЭТрНОбъект.Записать();
				
		КонецЕсли;		
				
		// Удаление Файлов и титулов

		МассивФайлов = Новый Массив();
		Для Каждого Строка Из ФайлыНаУдаление Цикл
			МассивФайлов.Добавить(Строка.Файл);
		КонецЦикла;	
				
		КонтурЛогистика_ОбработкаДокументовСервер.УдалитьФайлыИСвязныеОбъекты(МассивФайлов);		
				
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Успешно = Ложь;
		ОтменитьТранзакцию();
		
		ВызватьИсключение "Не удалось внести исправление";
		
	КонецПопытки;	

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОтметкиДобавить(Команда)
	
	НоваяСтрока = Отметки.Добавить();
	НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
	НоваяСтрока.ДатаИВремяОтметки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
		
КонецПроцедуры

