&НаСервере
Процедура ОбработатьСтрокуОбъекта(ТекущаяСтрока)
	
	ТекущиеДанные = ДанныеЗагрузки.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если ТекущиеДанные.Действие = "создать" Тогда
		
		СоздатьОбъектПоСтроке(ТекущиеДанные);
		
	ИначеЕсли ТекущиеДанные.Действие = "перезаполнить" Тогда
		
		ПерезаполнитьОбъектПоСтроке(ТекущиеДанные);
		
	КонецЕсли;
	
	НайтиОбъектЛогистикиПоКлючамПоиска(ТекущиеДанные);
	
	ПолучитьЗначенияРеквизитовНайденныхОбъектов(ТекущиеДанные.ОбъектЛогистики);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьНаСервере()
	
	ДобавитьВПротокол("=== Начало обработки ===");
	
	Для Каждого ТекущаяСтрока Из ДанныеЗагрузки Цикл
		
		Если Не ТекущаяСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяСтрока.Действие = "создать" Тогда
			
			СоздатьОбъектПоСтроке(ТекущаяСтрока);
			
		ИначеЕсли ТекущаяСтрока.Действие = "перезаполнить" Тогда
			
			ПерезаполнитьОбъектПоСтроке(ТекущаяСтрока);
			
		Иначе
			
			ВызватьИсключение "Неопознанное действие";
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьВПротокол("=== Окончание обработки ===");
	
	НайтиОбъектЛогистикиПоКлючамПоиска();
	
	ПолучитьЗначенияРеквизитовНайденныхОбъектов();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОбъектПоСтроке(ТекущаяСтрока)
	
	Попытка
		
		ОбъектЛогистика = Справочники[ИмяСправочникаЛогистики].СоздатьЭлемент();
		
		ЗаполнитьЗначенияСвойств(ОбъектЛогистика, ТекущаяСтрока);
		
		ОбъектЛогистика.Записать();
		
		ТекстСообщения = "создан - " + ПредставлениеОбъекта(ОбъектЛогистика);
		ДобавитьВПротокол(ТекстСообщения);
		
	Исключение
		
		ТекстСообщения = "Ошибка при создании объекта: " + ПредставлениеОбъекта(ОбъектЛогистика)
			+ " - Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьВПротокол(ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьОбъектПоСтроке(ТекущаяСтрока)
	
	Попытка
		
		ОбъектЛогистика = ТекущаяСтрока.ОбъектЛогистики.ПолучитьОбъект();
		
		Для Каждого ТекущийРеквизит Из ДобавленныеРеквизитыДанныхЗагрузки Цикл
			
			ИмяРеквизита = СтрЗаменить(ТекущийРеквизит, "ДанныеЗагрузки.", "");
			
			// Пропустим технические реквизиты
			Если ИмяРеквизита = "ОбъектЛогистики"
				Или Лев(ИмяРеквизита, 11) = "ЗнчОбъекта_" Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеРеквизита = ТекущаяСтрока[ИмяРеквизита];
			
			// Не очищаем реквизит объекта, если признак игногрировать и реквизит не заполнен
			Если ИгнорироватьПустыеЗначения И Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектЛогистика[ИмяРеквизита] = ЗначениеРеквизита;
			
		КонецЦикла;
		
		ОбъектЛогистика.Записать();
		
		ТекстСообщения = "перезаполнен - " + ПредставлениеОбъекта(ОбъектЛогистика);
		ДобавитьВПротокол(ТекстСообщения);
		
	Исключение
		
		ТекстСообщения = "Ошибка при перезаполнении объекта: " + ПредставлениеОбъекта(ОбъектЛогистика)
			+ " - Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьВПротокол(ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеОбъекта(ОбъектЛогистика)
	
	Возврат Строка(ОбъектЛогистика.Ссылка) + " (код: " + Строка(ОбъектЛогистика.Код) + ")";
	
КонецФункции

&НаСервере
Процедура ДобавитьВПротокол(ТекстСообщения)
	
	Протокол = Строка(ТекущаяДатаСеанса()) + " " + ТекстСообщения
		+ ?(Протокол = "", "", Символы.ПС) + Протокол;
	
КонецПроцедуры

#КонецОбласти