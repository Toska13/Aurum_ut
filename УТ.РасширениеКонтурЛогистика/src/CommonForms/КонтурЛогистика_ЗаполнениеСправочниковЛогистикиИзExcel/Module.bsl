#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИменаСправочникаов = Новый Массив;
	ИменаСправочникаов.Добавить("КонтурЛогистика_Договоры");
	ИменаСправочникаов.Добавить("КонтурЛогистика_Лицензии");
	ИменаСправочникаов.Добавить("КонтурЛогистика_ОрганизацииДиадок");
	ИменаСправочникаов.Добавить("КонтурЛогистика_ПунктыМаршрута");
	ИменаСправочникаов.Добавить("КонтурЛогистика_Сотрудники");
	ИменаСправочникаов.Добавить("КонтурЛогистика_ТранспортныеСредства");
	
	Элементы.ИмяСправочникаЛогистики.СписокВыбора.ЗагрузитьЗначения(ИменаСправочникаов);
	
	Элементы.ВычитаннаяТаблица.Видимость = Ложь;
	
	Если Параметры.Свойство("ТипСправочникаЛогистика") Тогда
		ИмяСправочникаЛогистики = Параметры.ТипСправочникаЛогистика;
		СформироватьСтруктуруДанныхЗагрузкиПоСправочнику();
		Заголовок = "Заполнение справочника " + ИмяСправочникаЛогистики + " из Excel";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяСправочникаЛогистикиПриИзменении(Элемент)
	
	СформироватьСтруктуруДанныхЗагрузкиПоСправочнику();
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДанныеExcelНажатие(Элемент)
	
	Элементы.ВычитаннаяТаблица.Видимость = Не Элементы.ВычитаннаяТаблица.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПротоколНажатие(Элемент)
	
	Элементы.Протокол.Видимость = Не Элементы.Протокол.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(ИмяСправочникаЛогистики) Тогда
		Сообщить("Не выбран справочник загрузка");
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ВыборФайлаЗагрузкиЗавершение", ЭтаФорма, РежимДиалогаВыбораФайла.Открытие, "Прочитать табличный документ из файла",,
		"Лист Excel (*.xls, *.xlsx)|*.xls;*.xlsx");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанныеЗагрузки

&НаКлиенте
Процедура ДанныеЗагрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДанныеЗагрузки.ТекущиеДанные;
	
	Если Поле = Элементы.ДанныеЗагрузкиДействие
		И ЗначениеЗаполнено(ТекущиеДанные.Действие) Тогда
		
		ОбработатьСтрокуОбъекта(Элементы.ДанныеЗагрузки.ТекущаяСтрока);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыУчетнойСистемыПометкаПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Сообщить("Не заполнен путь к файлу");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяСправочникаЛогистики) Тогда
		Сообщить("Не выбран справочник загрузка");
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилищаЗагруженногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
	
	ПрочитатьФайл();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьШаблон(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяСправочникаЛогистики) Тогда
		Сообщить("Не выбран справочник загрузка");
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ВыборФайлаСохраненияШаблонаЗавершение", ЭтаФорма, РежимДиалогаВыбораФайла.Сохранение, "Сохранить шаблон в файл",,
		"Лист Excel (*.xls, *.xlsx)|*.xls;*.xlsx");
	
	СохранитьШаблонНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьДействиеПерезаполнить(Команда)
	
	Для Каждого ТекущаяСтрока Из ДанныеЗагрузки Цикл
		Если ТекущаяСтрока.Действие <> "перезаполнить" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока.Пометка = Истина;
	КонецЦикла;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьДействиеСоздать(Команда)
	
	Для Каждого ТекущаяСтрока Из ДанныеЗагрузки Цикл
		Если ТекущаяСтрока.Действие <> "создать" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока.Пометка = Истина;
	КонецЦикла;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого ТекущаяСтрока Из ДанныеЗагрузки Цикл
		ТекущаяСтрока.Пометка = Ложь;
	КонецЦикла;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого ТекущаяСтрока Из ДанныеЗагрузки Цикл
		ТекущаяСтрока.Пометка = Истина;
	КонецЦикла;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура Обработать(Команда)
	
	ОбработатьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПротокол(Команда)
	
	Протокол = "";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	
	Элементы.ДанныеЗагрузки.Видимость = ЗначениеЗаполнено(ИмяСправочникаЛогистики);
	
	КоличествоВыделенныхСтрок = 0;
	Для Каждого ТекущаяСтрока Из ДанныеЗагрузки Цикл
		Если Не ТекущаяСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВыделенныхСтрок = КоличествоВыделенныхСтрок + 1;
	КонецЦикла;
	
	Элементы.ФормаОбработать.Доступность = (КоличествоВыделенныхСтрок <> 0);
	Если КоличествоВыделенныхСтрок = 0 Тогда
		Элементы.ФормаОбработать.Заголовок = "Загрузить";
	Иначе
		Элементы.ФормаОбработать.Заголовок = "Загрузить "
			+ Строка(КоличествоВыделенныхСтрок) + " из " + Строка(ДанныеЗагрузки.Количество());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСтруктуруДанныхЗагрузкиПоСправочнику()
	
	Если Не ЗначениеЗаполнено(ИмяСправочникаЛогистики) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеСправочника = Метаданные.Справочники[ИмяСправочникаЛогистики];
	
	// Удалим старые элементы
	Для Каждого ТекущееИмяКолонки Из ДобавленныеКолонкиДанныхЗагрузки Цикл
		НайденныйЭлемент = Элементы.Найти(ТекущееИмяКолонки.Значение);
		Если НайденныйЭлемент <> Неопределено Тогда
			Элементы.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	// Удалим не нужные реквизиты
	Если ДобавленныеРеквизитыДанныхЗагрузки.Количество() <> 0 Тогда
		ИзменитьРеквизиты(, ДобавленныеРеквизитыДанныхЗагрузки.ВыгрузитьЗначения());
	КонецЕсли;
	
	// Очистим все
	ДанныеЗагрузки.Очистить();
	ДобавленныеРеквизитыДанныхЗагрузки.Очистить();
	ДобавленныеКолонкиДанныхЗагрузки.Очистить();
	ИменаКлючейПоиска.Очистить();
	ГруппаРодитель = Элементы.ДанныеЗагрузки;
	
	// Создадим реквизит и колонку объекта Логистики
	СоздатьРеквизитИКолонкиОбъектаЛогистики();
	
	// Создадим реквизиты таблицы значений
	СоздатьРеквизитыОбъекта(МетаданныеСправочника);
	
	// Создадим колонки новых реквизитов талицы значений
	ПервыйЭлемент = Неопределено;
	СоздатьКолонкиРеквизитовОбъекта(МетаданныеСправочника, ГруппаРодитель, ПервыйЭлемент);
	
	// Группа "Ключи поиска"
	ГруппаКлючиПоиска = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаКолонокТаблицыФормы(
		ЭтаФорма, "ГруппаКлючиПоиска", Элементы.ДанныеЗагрузки, 1,, Истина, "Ключи поиска");
	Элементы.Переместить(ГруппаКлючиПоиска, Элементы.ДанныеЗагрузки, ПервыйЭлемент);
	
	// Элементы ключей поиска
	ОписаниеКлючейПоиска = Справочники[ИмяСправочникаЛогистики].ПолучитьОписаниеКлючейПоиска();
	Для Каждого БлокУсловий Из ОписаниеКлючейПоиска Цикл
		Для Каждого ТекущееОписаниеКлючя Из БлокУсловий Цикл
			
			ИменаКлючейПоиска.Добавить(ТекущееОписаниеКлючя.Параметр);
			
			// Ищем колонку
			НайденныйЭлемент = Элементы.Найти("ДанныеЗагрузки" + ТекущееОписаниеКлючя.Параметр);
			Если НайденныйЭлемент = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Элементы.Переместить(НайденныйЭлемент, ГруппаКлючиПоиска);
			
		КонецЦикла;
	КонецЦикла;
	
	// Условное оформление
	УстановитьУсловноеОформление(ДобавленныеРеквизитыДанныхЗагрузки);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитИКолонкиОбъектаЛогистики()
	
	// Реквизит ОбъектЛогистики
	ПараметрыДобавляемыхРеквизитов = Новый Структура;
	ПараметрыДобавляемыхРеквизитов.Вставить("ОбъектЛогистики",
		КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.ОписаниеТипаСправочник(ИмяСправочникаЛогистики));
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизитыТаблицы(ЭтаФорма, "ДанныеЗагрузки", ПараметрыДобавляемыхРеквизитов);
	
	ДобавленныеРеквизитыДанныхЗагрузки.Добавить("ДанныеЗагрузки.ОбъектЛогистики");
	
	// Колонка ОбъектЛогистики
	ЭлементОбъектЛогистики = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(
		ЭтаФорма, "ДанныеЗагрузкиОбъектЛогистики", Элементы.ДанныеЗагрузкиГруппаОбъектЛогистики, 0,
		"Объект Логистики", "ДанныеЗагрузки.ОбъектЛогистики");
	ЭлементОбъектЛогистики.ОтображатьВШапке = Ложь;
	Элементы.Переместить(ЭлементОбъектЛогистики,
		Элементы.ДанныеЗагрузкиГруппаОбъектЛогистики, Элементы.ДанныеЗагрузкиОшибкаПоискаОбъектаЛогистики);
	
	ДобавленныеКолонкиДанныхЗагрузки.Добавить("ДанныеЗагрузкиОбъектЛогистики");
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыОбъекта(МетаданныеСправочника)
	
	ПараметрыДобавляемыхРеквизитов = Новый Структура;
	Для Каждого ТекущийРеквизит Из МетаданныеСправочника.СтандартныеРеквизиты Цикл
		Если ТекущийРеквизит.Имя <> "Наименование" И ТекущийРеквизит.Имя <> "Владелец" Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыДобавляемыхРеквизитов.Вставить(ТекущийРеквизит.Имя, ТекущийРеквизит.Тип);
		ПараметрыДобавляемыхРеквизитов.Вставить("ЗнчОбъекта_" + ТекущийРеквизит.Имя, ТекущийРеквизит.Тип);
		ДобавленныеРеквизитыДанныхЗагрузки.Добавить("ДанныеЗагрузки." + ТекущийРеквизит.Имя);
		ДобавленныеРеквизитыДанныхЗагрузки.Добавить("ДанныеЗагрузки.ЗнчОбъекта_" + ТекущийРеквизит.Имя);
	КонецЦикла;
	Для Каждого ТекущийРеквизит Из МетаданныеСправочника.Реквизиты Цикл
		ПараметрыДобавляемыхРеквизитов.Вставить(ТекущийРеквизит.Имя, ТекущийРеквизит.Тип);
		ПараметрыДобавляемыхРеквизитов.Вставить("ЗнчОбъекта_" + ТекущийРеквизит.Имя, ТекущийРеквизит.Тип);
		ДобавленныеРеквизитыДанныхЗагрузки.Добавить("ДанныеЗагрузки." + ТекущийРеквизит.Имя);
		ДобавленныеРеквизитыДанныхЗагрузки.Добавить("ДанныеЗагрузки.ЗнчОбъекта_" + ТекущийРеквизит.Имя);
	КонецЦикла;
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизитыТаблицы(ЭтаФорма, "ДанныеЗагрузки", ПараметрыДобавляемыхРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКолонкиРеквизитовОбъекта(МетаданныеСправочника, ГруппаРодитель, ПервыйЭлемент)
	
	Для Каждого ТекущийРеквизит Из МетаданныеСправочника.СтандартныеРеквизиты Цикл
		Если ТекущийРеквизит.Имя <> "Наименование" И ТекущийРеквизит.Имя <> "Владелец" Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьРеквизита = "ДанныеЗагрузки." + ТекущийРеквизит.Имя;
		ИмяКолонки = "ДанныеЗагрузки" + ТекущийРеквизит.Имя;
		
		ОписаниеСвойствКолонки = Новый Структура;
		ОписаниеСвойствКолонки.Вставить("Ширина", 10);
		
		НовыйЭлемент = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(
			ЭтаФорма, ИмяКолонки, ГруппаРодитель, 0, ТекущийРеквизит.Имя, ПутьРеквизита,,, ОписаниеСвойствКолонки);
		
		Если ДобавленныеКолонкиДанныхЗагрузки.Количество() = 1 Тогда
			ПервыйЭлемент = НовыйЭлемент;
		КонецЕсли;
		ДобавленныеКолонкиДанныхЗагрузки.Добавить(ИмяКолонки);
	КонецЦикла;
	
	Для Каждого ТекущийРеквизит Из МетаданныеСправочника.Реквизиты Цикл
		ПутьРеквизита = "ДанныеЗагрузки." + ТекущийРеквизит.Имя;
		ИмяКолонки = "ДанныеЗагрузки" + ТекущийРеквизит.Имя;
		
		ОписаниеСвойствКолонки = Новый Структура;
		ОписаниеСвойствКолонки.Вставить("Ширина", 10);
		
		НовыйЭлемент = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(
			ЭтаФорма, ИмяКолонки, ГруппаРодитель, 0, ТекущийРеквизит.Имя, ПутьРеквизита,,, ОписаниеСвойствКолонки);
		
		ДобавленныеКолонкиДанныхЗагрузки.Добавить(ИмяКолонки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление(ДобавленныеРеквизитыДанныхЗагрузки)
	
	УсловноеОформление.Элементы.Очистить();
	
	// Ошибка поиска объекта
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеЗагрузкиОшибкаПоискаОбъектаЛогистики");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеЗагрузки.ОшибкаПоискаОбъектаЛогистики");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	//
	
	// Скроем колонку ошибок, если их нет
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеЗагрузкиОшибкаПоискаОбъектаЛогистики");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеЗагрузки.ОшибкаПоискаОбъектаЛогистики");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	
	//
	
	// Покажем расхождения существующего объекта и новых данных
	Для Каждого ПолноеИмяРеквизитаДанных Из ДобавленныеРеквизитыДанныхЗагрузки Цикл
		Если Найти(ПолноеИмяРеквизитаДанных, "ДанныеЗагрузки.ЗнчОбъекта_") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизитаДанных = СтрЗаменить(ПолноеИмяРеквизитаДанных, "ДанныеЗагрузки.ЗнчОбъекта_", "");
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеЗагрузки" + ИмяРеквизитаДанных);
		
		ГруппаОтбораИ = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбораИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		
		ОтборЭлемента = ГруппаОтбораИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеЗагрузки.ОбъектЛогистики");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
		ОтборЭлемента = ГруппаОтбораИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеЗагрузки." + ИмяРеквизитаДанных);
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		ОтборЭлемента.ПравоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеЗагрузки.ЗнчОбъекта_" + ИмяРеквизитаДанных);
		ОтборЭлемента.Использование = Истина;
		
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗагрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = Результат[0];
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайл()
	
	ДобавитьВПротокол("=== Начало чтения Excel ===");
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранилищаЗагруженногоФайла);
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	
	ВычитаннаяТаблица.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	
	ДанныеЗагрузки.Очистить();
	
	ОбработатьВычитаннуюТаблицу();
	
	НайтиОбъектЛогистикиПоКлючамПоиска();
	
	ПолучитьЗначенияРеквизитовНайденныхОбъектов();
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	ДобавитьВПротокол("=== Окончание чтения Excel ===");
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВычитаннуюТаблицу()
	
	СоответствияТипЗначенияКПолномуИмени = Новый Соответствие;
	
	КоличествоСтрок = ВычитаннаяТаблица.ВысотаТаблицы;
	КоличествоСтолбцов = ВычитаннаяТаблица.ШиринаТаблицы;
	
	// Разберем заголовки
	ИменаКолонок = Новый Соответствие;
	Для НомерКолонки = 1 По КоличествоСтолбцов Цикл
		ЯчекаТаблицы = ВычитаннаяТаблица.Область("R1C" + Формат(НомерКолонки, "ЧГ=0"));
		ИменаКолонок.Вставить(НомерКолонки, ЯчекаТаблицы.Текст);
	КонецЦикла;
	
	// Считаем, что первая строка = Заголовок
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		НоваяСтрока = ДанныеЗагрузки.Добавить();
		
		СтрокаЗаполнена = Ложь;
		Для НомерКолонки = 1 По КоличествоСтолбцов Цикл
			
			ЯчекаТаблицы = ВычитаннаяТаблица.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C" + Формат(НомерКолонки, "ЧГ=0"));
			
			ТекущееИмяКолонки = ИменаКолонок.Получить(НомерКолонки);
			ТипПоля = ТипЗнч(НоваяСтрока[ТекущееИмяКолонки]);
			
			Если Не ЗначениеЗаполнено(ЯчекаТаблицы.Текст) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				
				Если ТипПоля = Тип("Строка")
					Или ТипПоля = Тип("Булево")
					Или ТипПоля = Тип("Неопределено") Тогда
					
					НоваяСтрока[ТекущееИмяКолонки] = ЯчекаТаблицы.Текст;
					
				ИначеЕсли ТипПоля = Тип("Число") Тогда
					
					ТипЧисло = Новый ОписаниеТипов("Число");
					НоваяСтрока[ТекущееИмяКолонки] = ТипЧисло.ПривестиЗначение(ЯчекаТаблицы.Текст);
					
				ИначеЕсли ТипПоля = Тип("Дата") Тогда
					
					НоваяСтрока[ТекущееИмяКолонки] = Дата(СтрЗаменить(ЯчекаТаблицы.Текст, ".", ""));
					
				Иначе
					
					ПолноеИмяОбъекта = СоответствияТипЗначенияКПолномуИмени.Получить(ТипПоля);
					Если ПолноеИмяОбъекта = Неопределено Тогда
						ПолноеИмяОбъекта = Метаданные.НайтиПоТипу(ТипПоля).ПолноеИмя();
						СоответствияТипЗначенияКПолномуИмени.Вставить(ТипПоля, ПолноеИмяОбъекта);
					КонецЕсли;
					
					НоваяСтрока[ТекущееИмяКолонки] = РасчитатьОбъект(СокрЛП(ЯчекаТаблицы.Текст), ПолноеИмяОбъекта);
					
				КонецЕсли;
				
			Исключение
				
				ТекстСообщения = "Ошибка конвертации поля - " + ТекущееИмяКолонки
					+ " - Текст ошибки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ДобавитьВПротокол(ТекстСообщения);
				
			КонецПопытки;
			
			СтрокаЗаполнена = Макс(СтрокаЗаполнена, ЗначениеЗаполнено(НоваяСтрока[ТекущееИмяКолонки]));
			
		КонецЦикла;
		
		Если Не СтрокаЗаполнена Тогда
			ДанныеЗагрузки.Удалить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РасчитатьОбъект(ТекстЯчейки, ПолноеИмяОбъекта)
	
	Если Лев(ПолноеИмяОбъекта, 12) = "Перечисление" Тогда
		
		ВыражениеВычисления = СтрЗаменить(ПолноеИмяОбъекта, "Перечисление", "Перечисления") + "[ТекстЯчейки]";
		Возврат Вычислить(ВыражениеВычисления);
		
	ИначеЕсли ПолноеИмяОбъекта = "Справочник.КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		// ИНН;КПП или ИНН
		ИндексРазделителя = Найти(ТекстЯчейки, ";");
		Если ИндексРазделителя > 0 Тогда
			ИНН = Лев(ТекстЯчейки, ИндексРазделителя - 1);
			КПП = Прав(ТекстЯчейки, СтрДлина(ТекстЯчейки) - ИндексРазделителя);
		Иначе
			ИНН = ТекстЯчейки;
			КПП = Неопределено;
		КонецЕсли;
		
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(ИНН, КПП);
		
	ИначеЕсли ПолноеИмяОбъекта = "Справочник.КонтурЛогистика_ТранспортныеСредства" Тогда
		
		Возврат Справочники.КонтурЛогистика_ТранспортныеСредства.НайтиТранспортноеСредствоПоРегНомер(ТекстЯчейки);
		
	ИначеЕсли ПолноеИмяОбъекта = "Справочник.КонтурЛогистика_Договоры" Тогда
		
		// Номер;Дата;ИННКонтрагента или Номер;Дата
		ИндексРазделителя = Найти(ТекстЯчейки, ";");
		Если ИндексРазделителя = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		НомерДокумента = Лев(ТекстЯчейки, ИндексРазделителя - 1);
		
		ОстатокТекста = Прав(ТекстЯчейки, СтрДлина(ТекстЯчейки) - ИндексРазделителя);
		ИндексРазделителя = Найти(ОстатокТекста, ";");
		Если ИндексРазделителя = 0 Тогда
			ДатаДокумента = Дата(СтрЗаменить(СокрЛП(ОстатокТекста), ".", ""));
			КонтрагентИНН = Неопределено;
		Иначе
			ДатаДокумента = Дата(СтрЗаменить(СокрЛП(Лев(ОстатокТекста, ИндексРазделителя - 1)), ".", ""));
			КонтрагентИНН = СокрЛП(Прав(ОстатокТекста, СтрДлина(ОстатокТекста) - ИндексРазделителя));
		КонецЕсли;
		
		Возврат Справочники.КонтурЛогистика_Договоры.НайтиДоговорПоНомерДатаКонтрагентИНН(
			НомерДокумента, ДатаДокумента, КонтрагентИНН);
		
	ИначеЕсли ПолноеИмяОбъекта = "Справочник.КонтурЛогистика_СтраныМира" Тогда
		
		Возврат Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду(ТекстЯчейки);
		
	ИначеЕсли ПолноеИмяОбъекта = "Справочник.КонтурЛогистика_Лицензии" Тогда
		
		// Номер;Серия или Номер
		ИндексРазделителя = Найти(ТекстЯчейки, ";");
		Если ИндексРазделителя > 0 Тогда
			НомерЛицензии = Лев(ТекстЯчейки, ИндексРазделителя - 1);
			СерияЛицензии = Прав(ТекстЯчейки, СтрДлина(ТекстЯчейки) - ИндексРазделителя);
		Иначе
			НомерЛицензии = ТекстЯчейки;
			СерияЛицензии = Неопределено;
		КонецЕсли;
		
		Возврат Справочники.КонтурЛогистика_Лицензии.НайтиЛицензиюПоНомерСерии(
			НомерЛицензии, СерияЛицензии);
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура НайтиОбъектЛогистикиПоКлючамПоиска(ТекущиеДанные = Неопределено)
	
	СоответствиеТиповЗначениям = Перечисления.КонтурЛогистика_СпособыКонвертации.СоответствиеТиповЗначениям();
	СпособыКонвертации = СоответствиеТиповЗначениям.Получить(Тип("СправочникСсылка." + ИмяСправочникаЛогистики));
	
	ПравилоКонвертации = Новый Структура;
	ПравилоКонвертации.Вставить("СпособКонвертацииЗначения", СпособыКонвертации);
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Для Каждого ТекущиеДанные Из ДанныеЗагрузки Цикл
			НайтиОбъектЛогистикиПоКлючамПоискаПоСтроке(ТекущиеДанные, ПравилоКонвертации);
		КонецЦикла;
		
	Иначе
		
		НайтиОбъектЛогистикиПоКлючамПоискаПоСтроке(ТекущиеДанные, ПравилоКонвертации);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиОбъектЛогистикиПоКлючамПоискаПоСтроке(ТекущиеДанные, ПравилоКонвертации)
	
	ВычисленныеРеквизиты = КонтурЛогистика_КонвертацияСервер.ОписаниеТаблицыВычисленныхРеквизитов();
	Для Каждого ИмяКлючаПоиска Из ИменаКлючейПоиска Цикл
		НоваяСтрока = ВычисленныеРеквизиты.Добавить();
		НоваяСтрока.Реквизит = ИмяКлючаПоиска.Значение;
		НоваяСтрока.Значение = ТекущиеДанные[ИмяКлючаПоиска.Значение];
	КонецЦикла;
	
	РезультатПоиска = КонтурЛогистика_КонвертацияСервер.ПоискОбъектаЛогистикиПоКлючевымРеквизитам(,
		ПравилоКонвертации.СпособКонвертацииЗначения, ВычисленныеРеквизиты);
	
	ТекущиеДанные.ОшибкаПоискаОбъектаЛогистики = "";
	Если РезультатПоиска.Успешно Тогда
		ТекущиеДанные.ОбъектЛогистики = РезультатПоиска.Значение;
		ТекущиеДанные.Действие = "перезаполнить";
	Иначе
		ТекущиеДанные.ОшибкаПоискаОбъектаЛогистики = РезультатПоиска.ОписаниеОшибки;
		ТекущиеДанные.Действие = "создать";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЗначенияРеквизитовНайденныхОбъектов(ОбъектЛогистики = Неопределено)
	
	Если ОбъектЛогистики = Неопределено Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Действие", "перезаполнить");
		
		НайденныеСтроки = ДанныеЗагрузки.НайтиСтроки(ПараметрыОтбора);
		НайденныеОбъекты = Новый Массив;
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			НайденныеОбъекты.Добавить(ТекущаяСтрока.ОбъектЛогистики);
		КонецЦикла;
		
	Иначе
		
		НайденныеОбъекты = Новый Массив;
		НайденныеОбъекты.Добавить(ОбъектЛогистики);
		
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НайденныеОбъекты", НайденныеОбъекты);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	<ИмяСправочникаЛогистики>.*
	|ИЗ
	|	Справочник.<ИмяСправочникаЛогистики> КАК <ИмяСправочникаЛогистики>
	|ГДЕ
	|	<ИмяСправочникаЛогистики>.Ссылка В(&НайденныеОбъекты)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ИмяСправочникаЛогистики>", ИмяСправочникаЛогистики);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Для Каждого ТекущиеДанные Из ДанныеЗагрузки Цикл
			Если ТекущиеДанные.ОбъектЛогистики <> Выборка.Ссылка Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ПолноеИмяРеквизитаДанных Из ДобавленныеРеквизитыДанныхЗагрузки Цикл
				Если Найти(ПолноеИмяРеквизитаДанных, "ДанныеЗагрузки.ЗнчОбъекта_") = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяРеквизитаДанных = СтрЗаменить(ПолноеИмяРеквизитаДанных, "ДанныеЗагрузки.", "");
				
				Попытка
					ТекущиеДанные[ИмяРеквизитаДанных] = Выборка[СтрЗаменить(ИмяРеквизитаДанных, "ЗнчОбъекта_", "")];
				Исключение
					НичегоНеДелаем = Истина;
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаСохраненияШаблонаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = Результат[0];
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьШаблонНаСервере();
	
	ШаблонФайла.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьШаблонНаСервере()
	
	ВременныйТД = Новый ТабличныйДокумент;
	
	КопияДанныеЗагрузки = ДанныеЗагрузки.Выгрузить();
	
	// Удалим технические колонки
	КолонкиДляУдаления = Новый Массив;
	Для Каждого ТекущаяКолонка Из КопияДанныеЗагрузки.Колонки Цикл
		Если Лев(ТекущаяКолонка.Имя, 11) <> "ЗнчОбъекта_" Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкиДляУдаления.Добавить(ТекущаяКолонка);
	КонецЦикла;
	Для Каждого ТекущаяКолонка Из КолонкиДляУдаления Цикл
		КопияДанныеЗагрузки.Колонки.Удалить(ТекущаяКолонка);
	КонецЦикла;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(КопияДанныеЗагрузки);
	Построитель.Вывести(ВременныйТД);
	
	ШаблонФайла.Очистить();
	
	ОписаниеКолонок = ОписаниеКолонок();
	
	// Заполним пример
	КоличествоСтолбцов = ВременныйТД.ШиринаТаблицы;
	Для НомерСтолбца = 5 По КоличествоСтолбцов Цикл
		
		ИмяСтолбца = ВременныйТД.Область("R4C" + Формат(НомерСтолбца, "ЧГ=0")).Текст;
		
		ОписаниеКолоноки = ОписаниеКолонок.Получить(ИмяСтолбца);
		Если ЗначениеЗаполнено(ОписаниеКолоноки) Тогда
			ВременныйТД.Область("R5C" + Формат(НомерСтолбца, "ЧГ=0")).Текст = ОписаниеКолоноки;
		Иначе
			ВременныйТД.Область("R5C" + Формат(НомерСтолбца, "ЧГ=0")).Текст = ИмяСтолбца;
		КонецЕсли;
		
	КонецЦикла;
	
	// Выведем без пустой шапки и технических колонок
	ШаблонФайла.Вывести(ВременныйТД.ПолучитьОбласть("R4C5:R5C" + Формат(КоличествоСтолбцов, "ЧГ=0")));
	
КонецПроцедуры

