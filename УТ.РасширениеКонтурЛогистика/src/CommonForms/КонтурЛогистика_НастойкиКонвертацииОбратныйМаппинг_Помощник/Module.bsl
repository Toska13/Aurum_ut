&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ВычислитьВыражениеПояснеине", Элементы.ВычислитьВыражениеПояснеине.Заголовок);
	
	РеквизитУчСис = Параметры.Реквизит;
	Если Параметры.Свойство("ТипДокумента1С") Тогда
		ТипОбъекта1С = Параметры.ТипДокумента1С;
		ТипДокументаЛогистика = Параметры.ТипДокументаЛогистика;
	Иначе
		ТипОбъекта1С = Параметры.ТипСправочника1С; //Параметры.ТипСправочникаУчСис;
		ТипДокументаЛогистика = Параметры.ТипСправочникаЛогистика;
	КонецЕсли;
	СпособМаппинга = Параметры.СпособМаппинга;
	НастройкаКонвертации = Параметры.НастройкаКонвертации;
	ТипАлгоритма = Параметры.ТипАлгоритма;
	Таблица = Параметры.Таблица;
	ИмяТЧ = Параметры.ИмяТЧ;
	ИмяТЧИсходногоДокумента = СтрЗаменить(Параметры.ИмяТЧИсходногоДокумента, "Основание.", "");
	Параметры.Свойство("ТипОснования", ТипОснования);
	
	Если Не ЗначениеЗаполнено(СпособМаппинга) Тогда
		СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие;
	КонецЕсли;
	
	Если ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
		СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод;
		Элементы.СпособРасчета.Доступность = Ложь;
	Иначе
		ТипРеквизита = ОпределитьТипРеквизита();
		
		Если ЗначениеЗаполнено(ТипРеквизита) Тогда
			Элементы.ВыражениеВычисленияФиксированноеЗначение.ОграничениеТипа = ТипРеквизита;
			ВыражениеВычисленияФиксированноеЗначение = ТипРеквизита.ПривестиЗначение(ВыражениеВычисленияФиксированноеЗначение);
		КонецЕсли;			
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяТЧИсходногоДокумента) Тогда		
		НайдСпособРасчета = Элементы.СпособРасчета.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика);
		Если НайдСпособРасчета <> Неопределено Тогда
			Элементы.СпособРасчета.СписокВыбора.Удалить(НайдСпособРасчета);
		КонецЕсли;
	КонецЕсли;

	Если НастройкаКонвертации.НетТЧТоварыДокЛогистика Тогда
		НайдСпособРасчета = Элементы.СпособРасчета.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика);
		Если НайдСпособРасчета <> Неопределено Тогда
			Элементы.СпособРасчета.СписокВыбора.Удалить(НайдСпособРасчета);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииСправочников") Тогда
		НайдСпособРасчета = Элементы.СпособРасчета.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие);
		Если НайдСпособРасчета <> Неопределено Тогда
			Элементы.СпособРасчета.СписокВыбора.Удалить(НайдСпособРасчета);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ГруппаПояснениеРезультатВычисления.Видимость = ТипАлгоритма <> Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик;
	
	УровнейВложенностиДереваРеквизитов = 1;
			
	ЗаполнитьФорму(Параметры);
		
	ПерейтиКСтранице();
			
КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоРеквизитов(СпособМаппинга)
	
	ИзПредыдущегоТитула_Титул = "";
	
	ИмяТабЧастьТовары = ИмяТЧИсходногоДокумента;
	НетТабЧастиТовары = Не ЗначениеЗаполнено(ИмяТЧИсходногоДокумента);
	
	Если ЗначениеЗаполнено(ТипОснования) Тогда
		ТипОснованияЛок = ТипОснования;
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитУчСист Тогда
		ТипОснованияЛок = ТипОбъекта1С;
	ИначеЕсли Таблица = "ЗаполнениеСпрУчСист" Тогда
		ТипОснованияЛок = ТипДокументаЛогистика;
	Иначе
		ТипОснованияЛок = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипДокументаЛогистика);
	КонецЕсли;
	
	Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика
		И ЗначениеЗаполнено(ИмяТЧИсходногоДокумента) Тогда
		
		УточнениеТипДокументаСодержащийТЧТовары = ТипОснованияЛок;
	Иначе
		УточнениеТипДокументаСодержащийТЧТовары = "";
	КонецЕсли;
	
	Дерево = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СформироватьДеревоРеквизитов(
		СпособМаппинга, НастройкаКонвертации, НетТабЧастиТовары, ИмяТабЧастьТовары,
		ТипОснованияЛок, УточнениеТипДокументаСодержащийТЧТовары, ТипДокументаЛогистика,
		ИзПредыдущегоТитула_Титул, УровнейВложенностиДереваРеквизитов);
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоРеквизитовДокумента");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФорму(Параметры)

	Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ФиксированноеЗначение Тогда
		ЗаполнитьФиксированноеЗначение(Параметры);
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод Тогда
		Параметры.Свойство("ВыражениеВычисленияСтрокаНеогр", ВыражениеВычисления_ПроизвольныйКод);
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика Тогда
		Параметры.Свойство("ВыражениеВычисления", ВыражениеВычисления_РеквизитЛогистика);
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика Тогда
		Параметры.Свойство("ВыражениеВычисления", ВыражениеВычисления_РеквизитТЧЛогистика);
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие Тогда
		Параметры.Свойство("ВыражениеВычисления", ВыражениеВычисления_ПервоеСоответствие);
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитУчСист Тогда
		Параметры.Свойство("ВыражениеВычисления", ВыражениеВычисления_РеквизитУчСист);
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять Тогда
		
		ВыражениеВычисления = "";
		Если ЗначениеЗаполнено(Параметры.ВыражениеВычисления) Тогда
			ВыражениеВычисления = Параметры.ВыражениеВычисления;	
		ИначеЕсли ЗначениеЗаполнено(Параметры.ВыражениеВычисленияСтрокаНеогр) Тогда
			ВыражениеВычисления = Параметры.ВыражениеВычисленияСтрокаНеогр;
		КонецЕсли;
			
		ВыражениеВычисления_ПервоеСоответствие = ВыражениеВычисления;
		ВыражениеВычисления_РеквизитУчСист = ВыражениеВычисления;
		ВыражениеВычисления_РеквизитТЧЛогистика = ВыражениеВычисления;
		ВыражениеВычисления_РеквизитЛогистика = ВыражениеВычисления;
		ВыражениеВычисления_ПроизвольныйКод = ВыражениеВычисления;
		ЗаполнитьФиксированноеЗначение(Параметры);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФиксированноеЗначение(Параметры)

	Если ПустаяСтрока(Параметры.ВыражениеВычисления) Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйТипЗначения = Параметры.ВыбранныйТипЗначения;
	
	УИД = Неопределено;
	Параметры.Свойство("ВыражениеВычисленияУИД", УИД);
			
	ВыражениеВычисления_ФиксированноеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьФиксированноеЗначение(Параметры.ВыражениеВычисления, Параметры.ВыбранныйТипЗначения, УИД);
	
КонецПроцедуры

&НаСервере
Функция ОпределитьТипРеквизита()

	Если Таблица = "ПеременныеДокУчСист" Тогда
		Возврат "";	
	Иначе
		
		Если ПустаяСтрока(ИмяТЧ) Тогда
			
			Если Таблица = "ЗаполнениеСпрУчСист" Тогда
				Возврат Метаданные.Справочники[ТипОбъекта1С].Реквизиты[РеквизитУчСис].Тип;
			Иначе
				Возврат Метаданные.Документы[ТипОбъекта1С].Реквизиты[РеквизитУчСис].Тип;
			КонецЕсли;
			
		Иначе
			Возврат Метаданные.Документы[ТипОбъекта1С].ТабличныеЧасти[ИмяТЧ].Реквизиты[РеквизитУчСис].Тип;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОК(Команда)
	
	ЗаполненныеДанные = ПодготовитьДанные();
	
	ОповеститьОВыборе(ЗаполненныеДанные);	
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанные()
	
	ЗаполненныеДанные = Новый Структура;
	ЗаполненныеДанные.Вставить("СпособРасчета", СпособМаппинга);
	ЗаполненныеДанные.Вставить("ВыражениеВычисления", "");
	ЗаполненныеДанные.Вставить("ВыражениеВычисленияУИД", "");
	ЗаполненныеДанные.Вставить("ВыражениеВычисленияТипЗначения", "");
	ЗаполненныеДанные.Вставить("ВыражениеВычисленияСтрокаНеогр", "");
	
	Если СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ФиксированноеЗначение Тогда
	
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение));
				
		Если ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Строка") 
			ИЛИ ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Число")
			ИЛИ ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Дата")
			ИЛИ ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Булево") Тогда
			ЗаполненныеДанные.Вставить("ВыражениеВычисления", ВыражениеВычисления_ФиксированноеЗначение);	
		ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			ЗаполненныеДанные.Вставить("ВыражениеВычисления", ОбъектМетаданных.ЗначенияПеречисления.Получить(Перечисления[ОбъектМетаданных.Имя].Индекс(ВыражениеВычисления_ФиксированноеЗначение)).Имя);
		Иначе
			ЗаполненныеДанные.Вставить("ВыражениеВычисления", Строка(ВыражениеВычисления_ФиксированноеЗначение));
			ЗаполненныеДанные.Вставить("ВыражениеВычисленияУИД", ВыражениеВычисления_ФиксированноеЗначение.УникальныйИдентификатор());	
		КонецЕсли;
		
		ТипСтрокой = ПолучитьСтроковоеПредставлениеТипа(ВыражениеВычисления_ФиксированноеЗначение);
		ЗаполненныеДанные.Вставить("ВыражениеВычисленияТипЗначения", ТипСтрокой);
		
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод Тогда
		
		ЗаполненныеДанные.Вставить("ВыражениеВычисленияСтрокаНеогр", ВыражениеВычисления_ПроизвольныйКод);
		
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика Тогда
		
		ЗаполненныеДанные.Вставить("ВыражениеВычисления", ВыражениеВычисления_РеквизитЛогистика);
		
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика Тогда
		
		ЗаполненныеДанные.Вставить("ВыражениеВычисления", ВыражениеВычисления_РеквизитТЧЛогистика);
		
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитУчСист Тогда
		
		ЗаполненныеДанные.Вставить("ВыражениеВычисления", ВыражениеВычисления_РеквизитУчСист);
		
	ИначеЕсли СпособМаппинга = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие Тогда
		
		ЗаполненныеДанные.Вставить("ВыражениеВычисления", ВыражениеВычисления_ПервоеСоответствие);
		
	КонецЕсли;
	
	Возврат ЗаполненныеДанные;
	
КонецФункции 

&НаСервере
Функция ПолучитьСтроковоеПредставлениеТипа(Ссылка)
	                                       
	ОбъектМетаданых = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	
	ПредставлениеТипа = "";
	
	Если ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Строка") 
		ИЛИ ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Число")
		ИЛИ ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Дата")
		ИЛИ ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение) = Тип("Булево") Тогда
		ПредставлениеТипа = Строка(ТипЗнч(ВыражениеВычисления_ФиксированноеЗначение));
	ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМетаданых) Тогда
		ПредставлениеТипа = "СправочникСсылка." + ОбъектМетаданых.Имя;
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданых) Тогда
		ПредставлениеТипа = "ДокументСсылка." + ОбъектМетаданых.Имя;
	ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданых) Тогда
		ПредставлениеТипа = "ПеречислениеСсылка." + ОбъектМетаданых.Имя;
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданых) Тогда
		ПредставлениеТипа = "ПланСчетовСсылка." + ОбъектМетаданых.Имя;
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданых) Тогда
		ПредставлениеТипа = "ПланВидовРасчетаСсылка." + ОбъектМетаданых.Имя;
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданых) Тогда
		ПредставлениеТипа = "ПланВидовХарактеристикСсылка." + ОбъектМетаданых.Имя;
	КонецЕсли;
	
	Возврат ПредставлениеТипа;
	
КонецФункции

&НаКлиенте
Процедура СпособРасчетаПриИзменении(Элемент)
	
	ПерейтиКСтранице();
	
КонецПроцедуры

&НаСервере
Процедура ПерейтиКСтранице()
	
	ИмяСпособаМаппинга = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяЗначенияПеречисления_КонтурЛогистика(СпособМаппинга);
	Элементы.ВариантыЗаполнения.ТекущаяСтраница = Элементы[ИмяСпособаМаппинга];
	
	Попытка
		
		ПостроитьДеревоРеквизитов(СпособМаппинга);
		
	Исключение
			
		Сообщить("Неудача при построении дерева реквизитов по причине: " + ОписаниеОшибки());
			
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовДокументаОснованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод") Тогда 
		ВыбранныйВДеревеТекст = "Основание." + Элемент.ТекущиеДанные.ПолныйПуть;
	Иначе
		ВыбранныйВДеревеТекст = Элемент.ТекущиеДанные.ПолныйПуть;
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод") Тогда
		
		Если ЗначениеЗаполнено(ВыражениеВычисления_ПроизвольныйКод) Тогда
			
			Элементы.ВыражениеВычисления_ПроизвольныйКод.ВыделенныйТекст = ВыбранныйВДеревеТекст;
			
		Иначе
			
			ВыражениеВычисления_ПроизвольныйКод = "" + ВыбранныйВДеревеТекст;
			
		КонецЕсли;
		
		ЭтаФорма.ТекущийЭлемент = Элементы.ВыражениеВычисления_ПроизвольныйКод;
				
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика") Тогда
		
		ВыражениеВычисления_РеквизитЛогистика = ВыбранныйВДеревеТекст;
		
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика") Тогда
		
		ВыражениеВычисления_РеквизитТЧЛогистика = ВыбранныйВДеревеТекст;
		
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие") Тогда
		
		ВыражениеВычисления_ПервоеСоответствие = ВыбранныйВДеревеТекст;
		
	КонецЕсли;
	
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитУчСист") Тогда
		
		ВыражениеВычисления_РеквизитУчСист = ВыбранныйВДеревеТекст;
		
	КонецЕсли;

	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УровнейВложенностиДереваРеквизитовПриИзменении(Элемент)
	
	ПостроитьДеревоРеквизитов(СпособМаппинга);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыражениеВычисления_ПроизвольныйКодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстРедактирования = СтрЗаменить(Элементы.ВыражениеВычисления_ПроизвольныйКод.ТекстРедактирования, "¶", Символы.ПС);
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		ТекстРедактирования, ЭтаФорма, "ВыражениеВычисления_ПроизвольныйКод",,, "Объект, Основание");
	
КонецПроцедуры
