#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Период.ДатаНачала = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	Период.ДатаОкончания = КонецМесяца(Период.ДатаНачала);
	
	КомандаСохранить = Команды.Найти("СохранитьАрхив");
	Если КомандаСохранить <> Неопределено Тогда
		Команды.Найти("СохранитьАрхив").Подсказка =
			"Если документов за период меньше 1000, то загрузка архива из сервиса будет выполнена в фоне
			|и далее сеанс будет заблокирован на время сохранения архивов в каталог. Если документов больше 1000,
			|то сеанс будет заблокирован на все время загрузки из сервиса и сохранения в каталог.";
	КонецЕсли;
	
	ОбновитьКолвоДокументовДляАрхива();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьАрхив(Команда)
	
	Если КолвоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КолвоДокументов <= 1000 Тогда
		СохранитьАрхивВФоне();
	Иначе
		Элементы.ТекстКолвоДокКВыгрузке.Заголовок = "Выполняется загрузка из сервиса и сохранение архива";
		Элементы.ЛоадерСохранениеАрхива.Видимость = Ложь;
		
		СохранитьАрхивПачками();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КаталогАрхиваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ОбработатьВыборКаталогаАрхиваДокументооборота",
		ЭтаФорма,
		РежимДиалогаВыбораФайла.ВыборКаталога,
		"Выберите каталог сохранения архива документооборота");
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ОбновитьКолвоДокументовДляАрхива();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОбновитьКолвоДокументовДляАрхива();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СохранениеАрхива

&НаКлиенте
Процедура СохранитьАрхивВФоне(Команда = Неопределено)
	
	ПроверитьЗаполнениеРеквизитов();
	
	Адрес = ПоместитьВоВременноеХранилище("");
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("ДатаНачала", Период.ДатаНачала);
	ПараметрыФоновогоЗадания.Вставить("ДатаОкончания", Период.ДатаОкончания);
	ПараметрыФоновогоЗадания.Вставить("Адрес", Адрес);
	ПараметрыФоновогоЗадания.Вставить("Организация", Организация);
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		"КонтурЛогистика_ДлительныеОперацииСервер.СохранитьАрхивДокументооборотаЗаПериод",
		ПараметрыФоновогоЗадания,
		"КлючФЗ_СохранитьАрхивДокументооборотаЗаПериод",
		"Сохранение архива документооборота за период");
		
	Если РезультатЗапуска.Статус = "Выполняется" Тогда
		
		ИдентификаторФЗ_СохранениеАрхива = РезультатЗапуска.ИдентификаторЗадания;
		
		Элементы.ТекстКолвоДокКВыгрузке.Заголовок = "Загрузка архива из сервиса";
		Элементы.ЛоадерСохранениеАрхива.Видимость = Истина;
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеСохранениеАрхива", 0.1, Истина);
		
	ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
		
		ПроверитьФоновоеЗаданиеСохранениеАрхива();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьАрхивПачками(Команда = Неопределено)
	
	ПроверитьЗаполнениеРеквизитов();
	
	ДокументыКВыгрузке = ДокументыКВыгрузке(Период.ДатаНачала, КонецДня(Период.ДатаОкончания), Организация);
	
	Счет = 1;
	РазмерПачки = 500;
	Для каждого ТекущийДокумент Из ДокументыКВыгрузке Цикл
		
		Если Счет = 1 Тогда
			
			ПачкаДокументов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущийДокумент);
			
		ИначеЕсли ПачкаДокументов.Количество() = РазмерПачки Тогда
			
			Адрес = ОбработатьПачкуДокументов(ПачкаДокументов);
			
			Архивы = ПолучитьИзВременногоХранилища(Адрес);
			
			СохранитьАрхивыВКаталог(Архивы);
			
			ПачкаДокументов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущийДокумент);
			
		ИначеЕсли Счет = ДокументыКВыгрузке.Количество() Тогда
			
			ПачкаДокументов.Добавить(ТекущийДокумент);
			
			Адрес = ОбработатьПачкуДокументов(ПачкаДокументов);
			
			Архивы = ПолучитьИзВременногоХранилища(Адрес);
			
			СохранитьАрхивыВКаталог(Архивы);
			
		Иначе
			
			ПачкаДокументов.Добавить(ТекущийДокумент);
			
		КонецЕсли;
		
		Счет = Счет + 1;
		
		ОбработкаПрерыванияПользователя();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьАрхивыВКаталог(МассивАрхивов)
	
	Для Индекс = 0 По МассивАрхивов.Количество() - 1 Цикл
		
		// Подключаемый модуль (ПМ)
		ПараметрыПМ = Новый Структура("Архив", МассивАрхивов[Индекс].Архив);
		Результат = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"СохранитьАрхивДокументооборота", Истина, ПараметрыПМ);
		Если Результат <> Неопределено И Результат Тогда
			
			Прогресс = (Индекс + 1) * 100 / МассивАрхивов.Количество();
			Состояние("Выполняется сохранение архива доументов", Прогресс, МассивАрхивов[Индекс].ТекущийДокумент);
			
			Продолжить;
			
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗаписатьАрхивВКаталог(
			МассивАрхивов[Индекс].Архив, КаталогАрхива, МассивАрхивов[Индекс].ТекущийДокумент, РазбитьПоОрганизациям);
		
		Прогресс = (Индекс + 1) * 100 / МассивАрхивов.Количество();
		
		Состояние("Выполняется сохранение архива доументов", Прогресс, МассивАрхивов[Индекс].ТекущийДокумент);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьПачкуДокументов(Пачка)
	
	Архивы = Новый Массив;
	
	Для каждого ТекущийДокумент Из Пачка Цикл
		
		Попытка
			
			ТипДокумента = ТипЗнч(ТекущийДокумент);
			Если ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
				Архив = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьАрхивДокументооборотаТрН_ApiЛогистика(ТекущийДокумент);
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
				Архив = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьАрхивДокументооборотаПЛ_ApiЛогистика(ТекущийДокумент);
			Иначе
				Архив = Неопределено;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Архив) Тогда
				ДанныеАрхива = Новый Структура;
				ДанныеАрхива.Вставить("Архив", Архив);
				ДанныеАрхива.Вставить("Документ", ТекущийДокумент);
				
				Архивы.Добавить(ДанныеАрхива);
			КонецЕсли;
			
		Исключение
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при сохранение архива документаоборота в каталог.
				|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ТекущийДокумент, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Архивы);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеСохранениеАрхива() Экспорт
	
	ИнтервалОбработчикаОжидания = 2;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_СохранениеАрхива, Элементы.ЛоадерСохранениеАрхива);
	
	Если ЗаданиеЕщеВыполняется Тогда 
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеСохранениеАрхива", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		Элементы.ТекстКолвоДокКВыгрузке.Заголовок = "Загрузка архива закончена";
		Элементы.ЛоадерСохранениеАрхива.Видимость = Ложь;
		
		МассивАрхивов = ПолучитьИзВременногоХранилища(Адрес);
		
		СохранитьАрхивыВКаталог(МассивАрхивов);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбработатьВыборКаталогаАрхиваДокументооборота(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		КаталогАрхива = Результат[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеРеквизитов()
	
	Если Не ЗначениеЗаполнено(КаталогАрхива) Тогда
		Сообщить("Не заполнен каталог архива");
		Возврат;
	КонецЕсли;
	
	Если Период.ДатаНачала = Дата(1, 1, 1) Или Период.ДатаОкончания = Дата(1, 1, 1) Тогда
		Сообщить("Не заполнен период");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКолвоДокументовДляАрхива()
	
	ДокументыКВыгрузке = ДокументыКВыгрузке(Период.ДатаНачала, КонецДня(Период.ДатаОкончания), Организация);
	
	КолвоДокументов = ДокументыКВыгрузке.Количество();
	
	Если КолвоДокументов = 0 Тогда
		Элементы.ТекстКолвоДокКВыгрузке.Заголовок = "Архивов для загрузки нет";
	ИначеЕсли КолвоДокументов <= 1000 Тогда
		Элементы.ТекстКолвоДокКВыгрузке.Заголовок = "Будет загружено архивов: " + Строка(КолвоДокументов)
			+ ". После загрузки архива из сервиса сеанс будет заблокирован на время сохранения в каталог";
	Иначе
		Элементы.ТекстКолвоДокКВыгрузке.Заголовок = "Будет загружено архивов: " + Строка(КолвоДокументов)
			+ ". Сеанс будет заблокирован на время загрузки из сервиса и сохранения в каталог";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДокументыКВыгрузке(Знач ДатаНачала, Знач ДатаОкончания, Знач Организация)
	
	ДокументыКВыгрузке = Новый Массив;
	
	МассивЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.МассивЗавершенныхЭТРНЗаПериод(ДатаНачала, ДатаОкончания, Организация);
	МассивЭПЛ = КонтурЛогистика_ОбработкаДокументовСервер.МассивЗавершенныхЭПЛЗаПериод(ДатаНачала, ДатаОкончания, Организация);
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументыКВыгрузке, МассивЭТРН);
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументыКВыгрузке, МассивЭПЛ);
	
	Возврат ДокументыКВыгрузке;
	
КонецФункции

#КонецОбласти