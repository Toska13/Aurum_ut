		<dataSource>ИсточникДанных1</dataSource>
		<query>// ВНИМАНИЕ!!! НЕ ПОЛЬЗОВАТЬСЯ КОНСТРУКТОРОМ, ИНАЧЕ ВСЕ КОММЕНТАРИИ УДАЛЯТСЯ!!!

//	РежимЗапроса  - Число - принимает значения от 0 до 6, определяет, какие данные будут получены из 1С
// 				0 - получение товара с упаковкой по ID
// 				1 - получение товара по штрихкоду/Коду/Артикулу
// 				2 - получение ID Товара + ID Упаковки (наименование)
// 				3 - получение упаковки по ID упаковки и ID товара
// 				4 - получение списка товаров по ID и по ID упаковок
// 				5 - получение списка товаров по родителям
// 				6 - получение списка товаров по наименованию

// Запрос для отбора номенклатуры по ШК и алкокоду для режима = 1
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	Штрихкоды.Номенклатура
ПОМЕСТИТЬ ВТ_НоменклатураПоКодам
ИЗ
	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
ГДЕ
	НЕ Штрихкоды.Номенклатура.ПометкаУдаления	
	//&lt;*ТекстЗаменыУсловиеВТ_НоменклатураПоКодам_Штрихкод*&gt;

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	КлассификаторАлкогольнойПродукцииЕГАИС.Номенклатура
ИЗ
	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
ГДЕ
	НЕ КлассификаторАлкогольнойПродукцииЕГАИС.ПометкаУдаления
	И НЕ КлассификаторАлкогольнойПродукцииЕГАИС.Номенклатура.ПометкаУдаления
	И ВЫБОР
			КОГДА &amp;РежимЗапроса = "ПоискПоАртикулуКодуШК"
				ТОГДА КлассификаторАлкогольнойПродукцииЕГАИС.Код = &amp;СтрокаПоиска				
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ		
;

// Запрос для получения реквизитов номенклатуры с учетом режима и отборов
// Ключ уникальности - номенклатура
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ  //%ПЕРВЫЕ_N%
	Номенклатура.Ссылка КАК Номенклатура,
	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	Номенклатура.НаборУпаковок КАК НаборУпаковок,
	ЕСТЬNULL(Номенклатура.АлкогольнаяПродукция, ЛОЖЬ) КАК АлкогольнаяПродукция,
	"" КАК Маркировка,
	ЕСТЬNULL(Номенклатура.ВидАлкогольнойПродукции.Маркируемый, ЛОЖЬ) КАК Маркируемый,
	ЕСТЬNULL(Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,	
	ЕСТЬNULL(Номенклатура.Производитель.Наименование, "") КАК Производитель,
	ВЫБОР
		КОГДА &amp;ВыгружатьАртикул
			ТОГДА ЕСТЬNULL(Номенклатура.Артикул, "")
		ИНАЧЕ ""
	КОНЕЦ КАК Артикул,
	ВЫБОР
		КОГДА Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Весовой,
	ВЫБОР
		КОГДА &amp;ВыгружатьКод
			ТОГДА Номенклатура.Код
		ИНАЧЕ ""
	КОНЕЦ КАК Код,
	Номенклатура.Наименование,	
	Номенклатура.ЭтоГруппа,
	ЕСТЬNULL(Номенклатура.ВидНоменклатуры.ИспользоватьСерии, ЛОЖЬ) И ЕСТЬNULL(Номенклатура.ВидНоменклатуры.НастройкаИспользованияСерий, ЛОЖЬ) &lt;&gt; ЗНАЧЕНИЕ(Перечисление.НастройкиИспользованияСерийНоменклатуры.ЭкземплярТовара) КАК ИспользоватьСерии,
	ЕСТЬNULL(Номенклатура.ВидНоменклатуры.ИспользоватьСерии, ЛОЖЬ) И ЕСТЬNULL(Номенклатура.ВидНоменклатуры.НастройкаИспользованияСерий, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.НастройкиИспользованияСерийНоменклатуры.ЭкземплярТовара) КАК ИспользоватьСерийныеНомера,	
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ЕСТЬNULL(Номенклатура.ВидНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ) 
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ИспользоватьХарактеристики,	
	Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик,
	ВЫБОР 
		КОГДА Номенклатура.ВидНоменклатуры.ВладелецХарактеристик &lt;&gt; ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
			ТОГДА Номенклатура.ВидНоменклатуры.ВладелецХарактеристик
		ИНАЧЕ Номенклатура.ВладелецХарактеристик
	КОНЕЦ КАК ВладелецХарактеристик,
	ЕСТЬNULL(Номенклатура.ВесИспользовать
			И Номенклатура.ВесМожноУказыватьВДокументах
		ИЛИ Номенклатура.ОбъемИспользовать
			И Номенклатура.ОбъемМожноУказыватьВДокументах
		ИЛИ Номенклатура.ДлинаИспользовать
			И Номенклатура.ДлинаМожноУказыватьВДокументах
		ИЛИ Номенклатура.ПлощадьИспользовать
			И Номенклатура.ПлощадьМожноУказыватьВДокументах, Ложь) КАК Мерный 		
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	НЕ Номенклатура.ПометкаУдаления
	//&lt;*ТекстЗаменыУсловиеВТ_Номенклатура*&gt;	
{ГДЕ
	Номенклатура.Ссылка.* КАК Product_Id_GUID}

//%УПОРЯДОЧИТЬ ПО Номенклатура.ЭтоГруппа УБЫВ

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

// Номенклатура, по которой включено использование характеристик
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Номенклатура.Номенклатура,
	ВТ_Номенклатура.ЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_Номенклатура_СХарактеристиками
ИЗ ВТ_Номенклатура КАК ВТ_Номенклатура
ГДЕ
	&amp;ИспользоватьХарактеристикиНоменклатуры
	И ВТ_Номенклатура.ИспользоватьХарактеристики
;

// Алкогольные данные. Ключ уникальности - (номенклатура + характеристика + алкогольная продукция)
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
					И ВТ_Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
					И КлассификаторАлкогольнойПродукцииЕГАИС.Характеристика.Владелец = ВТ_Номенклатура.ВидНоменклатуры
				ИЛИ ВТ_Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
					И КлассификаторАлкогольнойПродукцииЕГАИС.Характеристика.Владелец = ВТ_Номенклатура.Номенклатура
			ТОГДА КлассификаторАлкогольнойПродукцииЕГАИС.Характеристика
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ КАК Характеристика,
	ВТ_Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	КлассификаторАлкогольнойПродукцииЕГАИС.Код КАК АлкоКод,
	КлассификаторАлкогольнойПродукцииЕГАИС.Наименование КАК АлкоНаим,
	КлассификаторАлкогольнойПродукцииЕГАИС.Объем КАК АлкоОбъем,
	КлассификаторАлкогольнойПродукцииЕГАИС.Крепость КАК АлкоКрепость,
	КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции.Код КАК АлкоКодВ,
	КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции.Наименование КАК АлкоНаимВ,
	КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции.Маркируемый КАК АлкоМарк,
	КлассификаторАлкогольнойПродукцииЕГАИС.Производитель.Наименование КАК АлкоПроизводитель,
	КлассификаторАлкогольнойПродукцииЕГАИС.Производитель.ИНН КАК ПроизвИНН,
	КлассификаторАлкогольнойПродукцииЕГАИС.Производитель.КПП КАК ПроизвКПП
ПОМЕСТИТЬ ВТ_Алкоголь
ИЗ
	ВТ_Номенклатура КАК ВТ_Номенклатура
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	ПО ВТ_Номенклатура.Номенклатура = КлассификаторАлкогольнойПродукцииЕГАИС.Номенклатура
		И (НЕ КлассификаторАлкогольнойПродукцииЕГАИС.ПометкаУдаления)
		И (НЕ КлассификаторАлкогольнойПродукцииЕГАИС.Номенклатура.ПометкаУдаления)

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика

;

// выбрали все упаковки и привязанные к ним ШК, алкокоды, если они есть
// ключ уникальности - (код + номенклатура + характеристика + упаковка)
////////////////////////////////////////////////////////////////////////////////

// выбираем все упаковки для отобранной номенклатуры, даже если у них нет ШК
ВЫБРАТЬ
	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ЕСТЬNULL(ШтрихкодыНоменклатуры.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ КАК Характеристика,
	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Ссылка, ВТ_Номенклатура.ЕдиницаИзмерения) КАК Упаковка,
	ВЫБОР
		КОГДА ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Числитель, 0) &lt;&gt; 0
			ТОГДА УпаковкиЕдиницыИзмерения.Числитель
		ИНАЧЕ 1
	КОНЕЦ КАК Коэффициент,
	ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "") КАК Штрихкод,
	ЛОЖЬ КАК Базовый
ПОМЕСТИТЬ ВТ_ШК_ДляУпаковки
ИЗ
	ВТ_Номенклатура КАК ВТ_Номенклатура
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
			//ПО (УпаковкиЕдиницыИзмерения.Владелец = ВЫБОР
			//		КОГДА ВТ_Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
			//			ТОГДА ВТ_Номенклатура.Номенклатура
			//		ИНАЧЕ ВТ_Номенклатура.НаборУпаковок
			//	КОНЕЦ)			
		ПО (ВЫБОР
				КОГДА ВТ_Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ПустаяСсылка)
					ТОГДА УпаковкиЕдиницыИзмерения.Ссылка = ВТ_Номенклатура.ЕдиницаИзмерения
				КОГДА ВТ_Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
					ТОГДА УпаковкиЕдиницыИзмерения.Владелец = ВТ_Номенклатура.Номенклатура
				ИНАЧЕ УпаковкиЕдиницыИзмерения.Владелец = ВТ_Номенклатура.НаборУпаковок
			КОНЕЦ)
			И (НЕ УпаковкиЕдиницыИзмерения.ПометкаУдаления)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		ПО ВТ_Номенклатура.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
			И (УпаковкиЕдиницыИзмерения.Ссылка = ШтрихкодыНоменклатуры.Упаковка)
ГДЕ
	ВЫБОР
			КОГДА &amp;РежимЗапроса = "ПоискПоАртикулуКодуШК"
				ТОГДА ШтрихкодыНоменклатуры.Штрихкод = &amp;СтрокаПоиска
						ИЛИ ШтрихкодыНоменклатуры.Штрихкод = &amp;ЧислоПоиска
			КОГДА &amp;РежимЗапроса = "ПоискПоНоменклатуреУпаковке"
					ИЛИ &amp;РежимЗапроса = "ПоискПоМассивамНоменклатурыУпаковки"
				ТОГДА УпаковкиЕдиницыИзмерения.Ссылка В (&amp;ПараметрУпаковки)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ

// выбираем все единицы хранения, даже если у них нет ШК
ВЫБРАТЬ
	ВТ_Номенклатура.Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ЕСТЬNULL(ШтрихкодыНоменклатуры.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ,
	ВТ_Номенклатура.ЕдиницаИзмерения,
	1,
	ВЫБОР
		КОГДА &amp;РежимЗапроса &lt;&gt; "ПоискПоАртикулуКодуШК"
				И &amp;РежимЗапроса &lt;&gt; "ПоискПоНоменклатуреУпаковке"
				И &amp;РежимЗапроса &lt;&gt; "ПоискПоМассивамНоменклатурыУпаковки"
				И ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "") ПОДОБНО "2_[0-9][0-9][0-9][0-9][0-9]00000_"
			ТОГДА ЕСТЬNULL(ПОДСТРОКА(ШтрихкодыНоменклатуры.Штрихкод, 3, 5), "")
		ИНАЧЕ ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "")
	КОНЕЦ,
	ИСТИНА
ИЗ
	ВТ_Номенклатура КАК ВТ_Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		ПО ВТ_Номенклатура.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
			И (ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
ГДЕ
	ВЫБОР
			КОГДА &amp;РежимЗапроса = "ПоискПоАртикулуКодуШК"
				ТОГДА ШтрихкодыНоменклатуры.Штрихкод = &amp;СтрокаПоиска
						ИЛИ ШтрихкодыНоменклатуры.Штрихкод = &amp;ЧислоПоиска
			КОГДА &amp;РежимЗапроса = "ПоискПоНоменклатуреУпаковке"
					ИЛИ &amp;РежимЗапроса = "ПоискПоМассивамНоменклатурыУпаковки"
				ТОГДА ВТ_Номенклатура.ЕдиницаИзмерения В (&amp;ПараметрУпаковки)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ
    
// выбираем единицы хранения без характеристик для номенклатуры, по которой включено использование характеристик
// (для возможности просмотра на ТСД всего списка характеристик, а не только тех, по которым заведены штрихкоды)
ВЫБРАТЬ
	ВТ_Номенклатура_СХарактеристиками.Номенклатура,
	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	ВТ_Номенклатура_СХарактеристиками.ЕдиницаИзмерения,
	1,
	ВЫБОР
		КОГДА &amp;РежимЗапроса &lt;&gt; "ПоискПоАртикулуКодуШК"
				И &amp;РежимЗапроса &lt;&gt; "ПоискПоНоменклатуреУпаковке"
				И &amp;РежимЗапроса &lt;&gt; "ПоискПоМассивамНоменклатурыУпаковки"
				И ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "") ПОДОБНО "2_[0-9][0-9][0-9][0-9][0-9]00000_"
			ТОГДА ЕСТЬNULL(ПОДСТРОКА(ШтрихкодыНоменклатуры.Штрихкод, 3, 5), "")
		ИНАЧЕ ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "")
	КОНЕЦ,
	ИСТИНА
ИЗ
	ВТ_Номенклатура_СХарактеристиками КАК ВТ_Номенклатура_СХарактеристиками
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		ПО ВТ_Номенклатура_СХарактеристиками.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
			И (ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
			И (ШтрихкодыНоменклатуры.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
ГДЕ
	ВЫБОР
		КОГДА &amp;РежимЗапроса = "ПоискПоАртикулуКодуШК"
			ТОГДА ШтрихкодыНоменклатуры.Штрихкод = &amp;СтрокаПоиска
					ИЛИ ШтрихкодыНоменклатуры.Штрихкод = &amp;ЧислоПоиска
		КОГДА &amp;РежимЗапроса = "ПоискПоНоменклатуреУпаковке"
				ИЛИ &amp;РежимЗапроса = "ПоискПоМассивамНоменклатурыУпаковки"
			ТОГДА ВТ_Номенклатура_СХарактеристиками.ЕдиницаИзмерения В (&amp;ПараметрУпаковки)
		ИНАЧЕ ИСТИНА
	КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ

// выбираем все весовые ШК
ВЫБРАТЬ
	ВТ_Номенклатура.Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ЕСТЬNULL(ШтрихкодыНоменклатуры.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА ВТ_Номенклатура.ЕдиницаИзмерения
		ИНАЧЕ ШтрихкодыНоменклатуры.Упаковка
	КОНЕЦ,
	ВЫБОР
		КОГДА ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА 1
		ИНАЧЕ ВЫБОР
				КОГДА ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка.Числитель, 0) &lt;&gt; 0
					ТОГДА ШтрихкодыНоменклатуры.Упаковка.Числитель
				ИНАЧЕ 1
			КОНЕЦ
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;РежимЗапроса = "ПоискПоАртикулуКодуШК"
				ИЛИ &amp;РежимЗапроса = "ПоискПоНоменклатуреУпаковке"
				ИЛИ &amp;РежимЗапроса = "ПоискПоМассивамНоменклатурыУпаковки"
			ТОГДА ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "")
		ИНАЧЕ ЕСТЬNULL(ПОДСТРОКА(ШтрихкодыНоменклатуры.Штрихкод, 3, 5), "")
	КОНЕЦ,
	ИСТИНА
ИЗ
	ВТ_Номенклатура КАК ВТ_Номенклатура
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		ПО ВТ_Номенклатура.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
			И (ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
ГДЕ
	ВЫБОР
			КОГДА &amp;РежимЗапроса = "ПоискПоАртикулуКодуШК"
				ТОГДА ШтрихкодыНоменклатуры.Штрихкод = &amp;СтрокаПоиска
			КОГДА &amp;РежимЗапроса = "ПоискПоНоменклатуреУпаковке"
					ИЛИ &amp;РежимЗапроса = "ПоискПоМассивамНоменклатурыУпаковки"
				ТОГДА ВТ_Номенклатура.ЕдиницаИзмерения В (&amp;ПараметрУпаковки)
			ИНАЧЕ ШтрихкодыНоменклатуры.Штрихкод ПОДОБНО "2[0-9_][0-9][0-9][0-9][0-9][0-9]00000[0-9_]"
		КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ
	
	// выбираем алкокоды только для маркируемого алкоголя
ВЫБРАТЬ
	ВТ_Алкоголь.Номенклатура,
	ВТ_Алкоголь.Характеристика,
	ВТ_Алкоголь.ЕдиницаИзмерения,
	1,
	ВТ_Алкоголь.АлкоКод,
	ЛОЖЬ
ИЗ
	ВТ_Алкоголь КАК ВТ_Алкоголь
ГДЕ
	ВТ_Алкоголь.АлкоМарк
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ВТ_ШК_ДляУпаковки.Номенклатура КАК Номенклатура,
	ВТ_ШК_ДляУпаковки.Характеристика КАК Характеристика,
	ВТ_ШК_ДляУпаковки.Упаковка КАК Упаковка,
	ВТ_ШК_ДляУпаковки.Коэффициент КАК Коэффициент,
	ВТ_ШК_ДляУпаковки.Штрихкод КАК Штрихкод,
	ВТ_ШК_ДляУпаковки.Базовый КАК Базовый
ПОМЕСТИТЬ ВТ_ШК_Упаковки
ИЗ
	ВТ_ШК_ДляУпаковки КАК ВТ_ШК_ДляУпаковки
{ГДЕ
	ВТ_ШК_ДляУпаковки.Номенклатура КАК Product_Id_GUID}

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика
;
// Цены. Ключ уникальности - (номенклатура + характеристика)
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ЦеныНоменклатурыСрезПоследних.Характеристика
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ КАК Характеристика,
	ВЫБОР
		КОГДА ЦеныНоменклатурыСрезПоследних.Упаковка &lt;&gt; ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА ЦеныНоменклатурыСрезПоследних.Упаковка
		ИНАЧЕ ЦеныНоменклатурыСрезПоследних.Номенклатура.ЕдиницаИзмерения
	КОНЕЦ КАК Упаковка,
	МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена
ПОМЕСТИТЬ ВТ_Цены
ИЗ
	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			{(&amp;ДатаЦен)},
			Номенклатура В
				(ВЫБРАТЬ
					ВТ_Номенклатура.Номенклатура
				ИЗ
					ВТ_Номенклатура
				ГДЕ ВЫБОР
						КОГДА &amp;РежимЗапроса = "СписокНоменклатурыДляГрупп"
							ТОГДА НЕ ВТ_Номенклатура.ЭтоГруппа
						ИНАЧЕ ИСТИНА
					КОНЕЦ)
			И &amp;ВыгружатьЦены {(ВидЦены = &amp;ВидЦены)}) КАК ЦеныНоменклатурыСрезПоследних

СГРУППИРОВАТЬ ПО
	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ЦеныНоменклатурыСрезПоследних.Характеристика
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА ЦеныНоменклатурыСрезПоследних.Упаковка &lt;&gt; ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА ЦеныНоменклатурыСрезПоследних.Упаковка
		ИНАЧЕ ЦеныНоменклатурыСрезПоследних.Номенклатура.ЕдиницаИзмерения
	КОНЕЦ
	
ИНДЕКСИРОВАТЬ ПО	
	Номенклатура,
	Характеристика,
	Упаковка	
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Номенклатура КАК Номенклатура,
	Характеристика,
	Упаковка,
	Цена
ПОМЕСТИТЬ ВТ_ЦеныТолькоБазовые
ИЗ ВТ_Цены
ГДЕ
	ВТ_Цены.Упаковка = ВТ_Цены.Номенклатура.ЕдиницаИзмерения

ИНДЕКСИРОВАТЬ ПО
	Номенклатура, Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ Номенклатура, Характеристика, МИНИМУМ(Упаковка)
ПОМЕСТИТЬ ВТ_ОднаУпаковка
ИЗ ВТ_Цены 
СГРУППИРОВАТЬ ПО 
	Номенклатура, Характеристика

ИНДЕКСИРОВАТЬ ПО
	Номенклатура, Характеристика
;	

////////////////////////////////////////////////////////////////////////////////
// Цены по одной паре (номенклатура, характеристиа), в приоритете базовая упаковка
ВЫБРАТЬ
	Номенклатура КАК Номенклатура,
	Характеристика,
	Упаковка,
	Цена 
ПОМЕСТИТЬ ВТ_ЦеныБазовые
ИЗ ВТ_ЦеныТолькоБазовые

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТ_Цены.Номенклатура КАК Номенклатура,
	ВТ_Цены.Характеристика,
	ВТ_Цены.Номенклатура.ЕдиницаИзмерения,
	ВТ_Цены.Цена / (
		ВЫБОР
			КОГДА ВТ_Цены.Упаковка.Числитель &lt;&gt; 0
				ТОГДА ВТ_Цены.Упаковка.Числитель
			ИНАЧЕ 1
		КОНЕЦ / ВЫБОР
			КОГДА ВТ_Цены.Упаковка.Знаменатель &lt;&gt; 0
				ТОГДА ВТ_Цены.Упаковка.Знаменатель
			ИНАЧЕ 1
		КОНЕЦ) 
ИЗ ВТ_Цены КАК ВТ_Цены

	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныТолькоБазовые КАК ВТ_ЦеныТолькоБазовые
	ПО ВТ_Цены.Номенклатура = ВТ_ЦеныТолькоБазовые.Номенклатура
		И ВТ_Цены.Характеристика = ВТ_ЦеныТолькоБазовые.Характеристика		
		
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОднаУпаковка КАК ВТ_ОднаУпаковка
	ПО ВТ_Цены.Номенклатура = ВТ_ОднаУпаковка.Номенклатура
		И ВТ_Цены.Характеристика = ВТ_ОднаУпаковка.Характеристика
		И ВТ_Цены.Упаковка = ВТ_ОднаУпаковка.Упаковка		
ГДЕ 
	ВТ_ЦеныТолькоБазовые.Номенклатура ЕСТЬ NULL	

ИНДЕКСИРОВАТЬ ПО
	Номенклатура, 
	Характеристика, 
	Упаковка
;

// Остатки. Ключ уникальности - (номенклатура + характеристика)
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ТоварыНаСкладахОстатки.Характеристика
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ КАК Характеристика,
	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК Количество
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(
			,
			Номенклатура В
				(ВЫБРАТЬ
					ВТ_Номенклатура.Номенклатура
				ИЗ
					ВТ_Номенклатура
				ГДЕ ВЫБОР
						КОГДА &amp;РежимЗапроса = "СписокНоменклатурыДляГрупп"
							ТОГДА НЕ ВТ_Номенклатура.ЭтоГруппа
						ИНАЧЕ ИСТИНА
					КОНЕЦ)
			И &amp;ВыгружатьОстатки {(Склад В (&amp;Склад))}) КАК ТоварыНаСкладахОстатки		

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладахОстатки.Номенклатура,
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ТоварыНаСкладахОстатки.Характеристика
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	КОНЕЦ

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика
;

// Ключ уникальности - (Код =&gt; Упаковка + Характеристика + Номенклатура)
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 
	
	ВТ_Номенклатура.Номенклатура 					КАК Product_Id_GUID,
	ВТ_Номенклатура.Наименование 					КАК Product_Name,
	ВТ_Номенклатура.Код 		 					КАК Product_Barcode,
	ВТ_Номенклатура.ЭтоГруппа	 					КАК Product_ЭтоГруппа,
	ВТ_Номенклатура.Артикул		 					КАК Product_Marking,
	ВТ_Номенклатура.Весовой		 	  				КАК Product_Весовой,
	ВТ_Номенклатура.Мерный 							КАК Product_Мерный,
	ВТ_Номенклатура.ЕдиницаИзмерения                КАК Product_BasePackingId_GUID,
	ВТ_Номенклатура.Маркировка						КАК Product_Маркировка,
	
	// Поля штрихкодов
	ВТ_ШК_Упаковки.Штрихкод										КАК Packing_Barcode,
	ВТ_ШК_Упаковки.Характеристика 								КАК Packing_ИдХарактеристики_GUID,
	ЕСТЬNULL(ВТ_ШК_Упаковки.Характеристика.Наименование, "")	КАК Packing_ИмяХарактеристики,
	//ВЫБОР
	//	КОГДА ВТ_Номенклатура.ЭтоГруппа
	//		ТОГДА ЛОЖЬ
	//	ИНАЧЕ ВТ_ШК_Упаковки.Базовый
	//КОНЕЦ КАК ФлагБазовойЕдиницы,
	ВТ_ШК_Упаковки.Упаковка 							КАК Packing_Id_GUID,
	ВТ_ШК_Упаковки.Упаковка 							КАК Packing_ИдЕдиницыИзмерения_GUID,
	ЕСТЬNULL(ВТ_ШК_Упаковки.Упаковка.Наименование, "")	КАК Packing_Name,
	ВТ_ШК_Упаковки.Коэффициент 							КАК Packing_UnitsQuantity,
	
	// Поля алкоголя
	ВТ_Номенклатура.АлкогольнаяПродукция 			КАК Product_Алко,
	ЕСТЬNULL(ВТ_Алкоголь.АлкоКод, "") 				КАК Packing_АлкоКод,
	//ЕСТЬNULL(ВТ_Алкоголь.АлкоНаим, "") 				КАК Product_АлкоНаим,
	ВЫБОР КОГДА ЕСТЬNULL(ВТ_ШК_Упаковки.Штрихкод = ВТ_Алкоголь.АлкоКод,Ложь) 
			ТОГДА
				ЕСТЬNULL(ВТ_Алкоголь.АлкоОбъем, 0)
				ИНАЧЕ 0
	КОНЕЦ 				КАК Packing_АлкоОбъем,
	ВЫБОР КОГДА ЕСТЬNULL(ВТ_ШК_Упаковки.Штрихкод = ВТ_Алкоголь.АлкоКод,Ложь) 
			ТОГДА
				ЕСТЬNULL(ВТ_Алкоголь.АлкоКрепость, 0) 
		ИНАЧЕ 0
	КОНЕЦ  			КАК Packing_АлкоКрепость,
	//ЕСТЬNULL(ВТ_Алкоголь.АлкоКодВ, "") КАК АлкоКодВ,
	//ЕСТЬNULL(ВТ_Алкоголь.АлкоНаимВ, "") КАК АлкоНаимВ,
	ЕСТЬNULL(ВТ_Алкоголь.АлкоМарк, ВТ_Номенклатура.Маркируемый) КАК Product_АлкоМарк,
	ВЫБОР
		КОГДА ВТ_Номенклатура.АлкогольнаяПродукция
			ТОГДА ЕСТЬNULL(ВТ_Алкоголь.АлкоПроизводитель, ВТ_Номенклатура.Производитель)
		ИНАЧЕ ""
	КОНЕЦ 											КАК Packing_АлкоПроизводитель,
	ЕСТЬNULL(ВТ_Алкоголь.ПроизвИНН, "") 			КАК Packing_АлкоПроизвИНН,
	ЕСТЬNULL(ВТ_Алкоголь.ПроизвКПП, "") 			КАК Packing_АлкоПроизвКПП,	
	                                      
	// Остатки и цены
	ВЫБОР 
		КОГДА ЕСТЬNULL(ВТ_Цены.Цена, 0) &lt;&gt; 0 
			ТОГДА ВТ_Цены.Цена
		КОГДА ВТ_ЦеныБазовые.Цена ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ ВТ_ЦеныБазовые.Цена * 
				ВЫБОР
					КОГДА ВТ_ШК_Упаковки.Упаковка.Числитель &lt;&gt; 0
						ТОГДА ВТ_ШК_Упаковки.Упаковка.Числитель
					ИНАЧЕ 1
				КОНЕЦ / ВЫБОР
					КОГДА ВТ_ШК_Упаковки.Упаковка.Знаменатель &lt;&gt; 0
						ТОГДА ВТ_ШК_Упаковки.Упаковка.Знаменатель
					ИНАЧЕ 1
				КОНЕЦ
	КОНЕЦ КАК Packing_price,
	ЕСТЬNULL(ВТ_Остатки.Количество, 0)/ВТ_ШК_Упаковки.Коэффициент 		КАК Packing_qty,
	
	// Связь с характеристиками
	ВЫБОР
		КОГДА &amp;ИспользоватьХарактеристикиНоменклатуры
			ТОГДА ВЫБОР
					КОГДА ВТ_Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
						ТОГДА ВТ_Номенклатура.ВидНоменклатуры
					КОГДА ВТ_Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
						ТОГДА ВТ_Номенклатура.ВладелецХарактеристик	
					КОГДА ВТ_Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
						ТОГДА ВТ_Номенклатура.Номенклатура
					ИНАЧЕ NULL
				КОНЕЦ
		ИНАЧЕ NULL
	КОНЕЦ 											КАК Product_КлючХарактеристик_GUID,
	ВТ_Номенклатура.ИспользоватьХарактеристики 		КАК Product_ПоХарактеристикам,
	
	// Связь с сериями
	ВТ_Номенклатура.ИспользоватьСерии 				КАК Product_ПоСериям,	
	ВТ_Номенклатура.ИспользоватьСерийныеНомера		КАК Product_ПоСН,
	ВЫБОР КОГДА 
		ВТ_Номенклатура.ВидНоменклатуры.НастройкаИспользованияСерий = Значение(Перечисление.НастройкиИспользованияСерийНоменклатуры.ПартияТоваров)
	ТОГДА
		ВЫБОР КОГДА ВТ_ШК_Упаковки.Характеристика &lt;&gt; ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		ТОГДА 
			ВТ_ШК_Упаковки.Характеристика
		ИНАЧЕ
			ВТ_Номенклатура.Номенклатура
		КОНЕЦ
	ИНАЧЕ
		ВТ_Номенклатура.ВидНоменклатуры
	КОНЕЦ 										КАК Product_КлючСерий_GUID,
	"" 												КАК Packing_ИдСерии_GUID	
ИЗ
	ВТ_ШК_Упаковки КАК ВТ_ШК_Упаковки
	
		// т.к. в каждой упаковке указана номенклатура, то можно использовать внутреннее соединение
		// для получения полей номенклатуры
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
		ПО ВТ_ШК_Упаковки.Номенклатура = ВТ_Номенклатура.Номенклатура		
		
		// для получения цен
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
		ПО ВТ_ШК_Упаковки.Номенклатура = ВТ_Цены.Номенклатура
			И ВТ_ШК_Упаковки.Характеристика = ВТ_Цены.Характеристика
			И ВТ_ШК_Упаковки.Упаковка = ВТ_Цены.Упаковка
			
		// для расчета цен из других упаковок
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныБазовые КАК ВТ_ЦеныБазовые
		ПО ВТ_ШК_Упаковки.Номенклатура = ВТ_ЦеныБазовые.Номенклатура
			И ВТ_ШК_Упаковки.Характеристика = ВТ_ЦеныБазовые.Характеристика
			
		// для получения остатков
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		ПО ВТ_ШК_Упаковки.Номенклатура = ВТ_Остатки.Номенклатура
			И ВТ_ШК_Упаковки.Характеристика = ВТ_Остатки.Характеристика
			
		// для получения алкогольных данных	
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Алкоголь КАК ВТ_Алкоголь
		ПО ВТ_ШК_Упаковки.Номенклатура = ВТ_Алкоголь.Номенклатура
			И ВТ_ШК_Упаковки.Характеристика = ВТ_Алкоголь.Характеристика			
			И ((ВТ_Номенклатура.Маркируемый = Истина и ВТ_ШК_Упаковки.Штрихкод = ВТ_Алкоголь.АлкоКод) ИЛИ ВТ_Номенклатура.Маркируемый  = Ложь)
{ГДЕ
	ВТ_Номенклатура.Номенклатура.* КАК Product_Id_GUID}

УПОРЯДОЧИТЬ ПО
	ВТ_Номенклатура.ЭтоГруппа УБЫВ,
	ВТ_Номенклатура.Наименование,
	ВТ_Номенклатура.Номенклатура,
	ВТ_ШК_Упаковки.Штрихкод	
// ВНИМАНИЕ!!! НЕ ПОЛЬЗОВАТЬСЯ КОНСТРУКТОРОМ, ИНАЧЕ ВСЕ КОММЕНТАРИИ УДАЛЯТСЯ!!!</query>
	</dataSet>
	<parameter>
		<name>ИспользоватьХарактеристикиНоменклатуры</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
