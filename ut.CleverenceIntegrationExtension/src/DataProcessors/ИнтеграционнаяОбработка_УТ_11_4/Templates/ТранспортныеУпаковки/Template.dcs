<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ТранспортныеУпаковки</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ШтрихкодТранспортнойУпаковки</dataPath>
			<field>ШтрихкодТранспортнойУпаковки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Штрихкод транспортной упаковки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдТранспортнойУпаковки_GUID</dataPath>
			<field>ИдТранспортнойУпаковки_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ид транспортной упаковки GUID</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИмяТранспортнойУпаковки</dataPath>
			<field>ИмяТранспортнойУпаковки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Имя транспортной упаковки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдРодителя_GUID</dataPath>
			<field>ИдРодителя_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ид родителя GUID</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Расформирована</dataPath>
			<field>Расформирована</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Расформирована</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдЕдиницыИзмерения_GUID</dataPath>
			<field>ИдЕдиницыИзмерения_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ид единицы измерения GUID</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдТовара_GUID</dataPath>
			<field>ИдТовара_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ид товара GUID</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдСерии_GUID</dataPath>
			<field>ИдСерии_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ид серии GUID</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдХарактеристики_GUID</dataPath>
			<field>ИдХарактеристики_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ид характеристики GUID</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИмяТовара</dataPath>
			<field>ИмяТовара</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Имя товара</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИмяХарактеристики</dataPath>
			<field>ИмяХарактеристики</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Имя характеристики</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИмяСерии</dataPath>
			<field>ИмяСерии</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Имя серии</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ВложенныеШК.Штрихкод КАК Штрихкод,
	ВложенныеШК.Ссылка КАК Ссылка
ПОМЕСТИТЬ ВложенныеШК
ИЗ
	Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ВложенныеШК
ГДЕ
	(ВложенныеШК.Штрихкод.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МонотоварнаяУпаковка)
			ИЛИ ВложенныеШК.Штрихкод.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МультитоварнаяУпаковка))
{ГДЕ
	ВложенныеШК.Ссылка КАК ИдРодителя_GUID,
	ВложенныеШК.Штрихкод КАК ИдТранспортнойУпаковки_GUID,
	ВложенныеШК.Штрихкод.ЗначениеШтрихкода КАК ШтрихкодТранспортнойУпаковки}

ИНДЕКСИРОВАТЬ ПО
	Штрихкод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	ШтрихкодыУпаковокТоваров.ТипУпаковки КАК ТипУпаковки,
	ШтрихкодыУпаковокТоваров.ТипШтрихкода КАК ТипШтрихкода,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода
ПОМЕСТИТЬ втШтрихкодыУпаковокТоваров
ИЗ
	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
ГДЕ
	НЕ &amp;ОтборПоРодителю
	И (ШтрихкодыУпаковокТоваров.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МонотоварнаяУпаковка)
		ИЛИ ШтрихкодыУпаковокТоваров.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МультитоварнаяУпаковка))
{ГДЕ
	ШтрихкодыУпаковокТоваров.Ссылка КАК ИдТранспортнойУпаковки_GUID,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ШтрихкодТранспортнойУпаковки}
	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	ШтрихкодыУпаковокТоваров.ТипУпаковки КАК ТипУпаковки,
	ШтрихкодыУпаковокТоваров.ТипШтрихкода КАК ТипШтрихкода,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода
ИЗ
	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
ГДЕ
	&amp;ОтборПоРодителю
	И (ШтрихкодыУпаковокТоваров.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МонотоварнаяУпаковка)
		ИЛИ ШтрихкодыУпаковокТоваров.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МультитоварнаяУпаковка))
	И ШтрихкодыУпаковокТоваров.Ссылка В
		(ВЫБРАТЬ ВложенныеШК.Штрихкод КАК Штрихкод
			ИЗ ВложенныеШК КАК ВложенныеШК)
{ГДЕ
	ШтрихкодыУпаковокТоваров.Ссылка КАК ИдТранспортнойУпаковки_GUID,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ШтрихкодТранспортнойУпаковки}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(ВложенныеШК.Ссылка, ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка)) КАК ИдРодителя_GUID,
	втШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ШтрихкодТранспортнойУпаковки,
	втШтрихкодыУпаковокТоваров.Ссылка КАК ИдТранспортнойУпаковки_GUID,
	втШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ИмяТранспортнойУпаковки,
	втШтрихкодыУпаковокТоваров.Ссылка.Номенклатура КАК ИдТовара_GUID,
	ВЫБОР
		КОГДА втШтрихкодыУпаковокТоваров.Ссылка.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА ЕСТЬNULL(втШтрихкодыУпаковокТоваров.Ссылка.Номенклатура.ЕдиницаИзмерения, "")
		ИНАЧЕ втШтрихкодыУпаковокТоваров.Ссылка.Упаковка
	КОНЕЦ КАК ИдЕдиницыИзмерения_GUID,
	втШтрихкодыУпаковокТоваров.Ссылка.Характеристика КАК ИдХарактеристики_GUID,
	втШтрихкодыУпаковокТоваров.Ссылка.Серия КАК ИдСерии_GUID,
	втШтрихкодыУпаковокТоваров.Ссылка.Количество КАК Количество,
	ЕСТЬNULL(втШтрихкодыУпаковокТоваров.Ссылка.Номенклатура.Наименование, "") КАК ИмяТовара,
	ЕСТЬNULL(втШтрихкодыУпаковокТоваров.Ссылка.Характеристика.Наименование, "") КАК ИмяХарактеристики,
	ЕСТЬNULL(втШтрихкодыУпаковокТоваров.Ссылка.Серия.Наименование, "") КАК ИмяСерии,
	ЛОЖЬ КАК Расформирована
ИЗ
	втШтрихкодыУпаковокТоваров КАК втШтрихкодыУпаковокТоваров
		ЛЕВОЕ СОЕДИНЕНИЕ ВложенныеШК КАК ВложенныеШК
		ПО (ВложенныеШК.Штрихкод = втШтрихкодыУпаковокТоваров.Ссылка)
{ГДЕ
	ВложенныеШК.Ссылка КАК ИдРодителя_GUID}</query>
	</dataSet>
	<parameter>
		<name>ОтборПоРодителю</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отбор по родителю</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИдРодителя_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИдТранспортнойУпаковки_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИмяТранспортнойУпаковки</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ШтрихкодТранспортнойУпаковки</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Расформирована</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИдТовара_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИдЕдиницыИзмерения_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИдХарактеристики_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИдСерии_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИмяТовара</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИмяХарактеристики</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИмяСерии</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Количество</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">ИдРодителя_GUID</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">ИдТранспортнойУпаковки_GUID</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">ИмяТранспортнойУпаковки</dcsset:left>
					<dcsset:comparisonType>Contains</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:string"/>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">ШтрихкодТранспортнойУпаковки</dcsset:left>
					<dcsset:comparisonType>Contains</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:string"/>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>