#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Настройка = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения",
		ИмяПредопределенногоДляРасширения);
		
	ЭтоПользовательскаяНастройка = Справочники.КонтурЛогистика_Настройки.ЭтоПользовательскаяНастройка(ЭтотОбъект);	
	ЭтоНовыйОбъект = НЕ ЗначениеЗаполнено(Ссылка);
	
	Если ЭтоПользовательскаяНастройка Тогда
		
		Если (ЭтоНовыйОбъект И ЗначениеЗаполнено(Настройка))
			ИЛИ (Не ЭтоНовыйОбъект И ЗначениеЗаполнено(Настройка) И Настройка<>Ссылка) Тогда
		
			СтрокаИсключения = НСтр("ru = 'Уже существует настройка с указанным идентификатором. "
				+"Задайте другой идентификатор, пожалуйста.'");
			ВызватьИсключение СтрокаИсключения;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПредопределенногоДляРасширения = "ПодключаемыйМодульТип" Тогда 
		
		ПМПуть = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного("ПодключаемыйМодульПуть");
		ПМПутьОбъект = ПМПуть.ПолучитьОбъект();
		
		Если Значение = Перечисления.КонтурЛогистика_ТипыПМ.ВСправочнике Тогда
					
			Если Не Метаданные.Справочники.Найти("УчетнаяСистема_ВнешниеОбработки") = Неопределено Тогда 
				ПМПутьОбъект.ТипЗначения = "СправочникСсылка.УчетнаяСистема_ВнешниеОбработки";
			ИначеЕсли Не Метаданные.Справочники.Найти("ВнешниеОбработки") = Неопределено Тогда 	
				ПМПутьОбъект.ТипЗначения = "СправочникСсылка.ВнешниеОбработки";
			ИначеЕсли Не Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда 	
				ПМПутьОбъект.ТипЗначения = "СправочникСсылка.ДополнительныеОтчетыИОбработки";
			Иначе
				ПМПутьОбъект.ТипЗначения = "Строка";
			КонецЕсли;
			
		Иначе
			
			ПМПутьОбъект.Значение 		= "";
			ПМПутьОбъект.ТипЗначения 	= "Строка";
			
		КонецЕсли;
		
		ПМПутьОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ИмяПредопределенногоДляРасширения = "РазмерПулаПолученияУИДМинтранса" Тогда
		// Диапазон
		Если Значение < 1 Или Значение > 1000 Тогда
			Отказ = Истина;
			Сообщить("Значение должно быть в диапазоне от 1 до 1000.");
		КонецЕсли;
		
		// Целое
		Если Цел(Значение) <> Значение Тогда
			Отказ = Истина;
			Сообщить("Значение должно быть целым числом.");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти