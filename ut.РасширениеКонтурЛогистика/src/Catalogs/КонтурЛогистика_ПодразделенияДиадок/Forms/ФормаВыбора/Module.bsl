&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		// На 8.2 при группировке по организации возникает ошибка: Некорректное использование поля Организация
		ПолеОрганизация = Новый ПолеКомпоновкиДанных("Организация");
		Для Каждого ТекущаяСтрока Из Список.Группировка.Элементы Цикл
			Если ТекущаяСтрока.Поле <> ПолеОрганизация Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяСтрока.Использование = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере_ФормаВыбора(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("РазвернутьДеревоПодразделений", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоПодразделений()
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Список.Развернуть(Элементы.Список.ТекущаяСтрока);
	
КонецПроцедуры
