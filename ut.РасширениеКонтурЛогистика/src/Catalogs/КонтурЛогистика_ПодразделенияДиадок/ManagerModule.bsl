Процедура СинхронизироватьПоОрганизации(ДанныеОднойОрганизации) Экспорт

	Для Каждого ПодразделениеДанныеДД Из ДанныеОднойОрганизации.Departments Цикл 
		
		НайденноеПодразделение =  НайтиПоРеквизиту("ID", ПодразделениеДанныеДД.DepartmentId);
		
		Если ЗначениеЗаполнено(НайденноеПодразделение) Тогда
			
			Подразделениеобъект = НайденноеПодразделение.ПолучитьОбъект();
		Иначе
			
			Подразделениеобъект = Справочники.КонтурЛогистика_ПодразделенияДиадок.СоздатьЭлемент();
			
		КонецЕсли;
		
		Подразделениеобъект.Наименование = ПодразделениеДанныеДД.Name;
		Если ПодразделениеДанныеДД.Свойство("Abbreviation") Тогда 
			Подразделениеобъект.КраткоеОбозначение 	= ПодразделениеДанныеДД.Abbreviation;
		КонецЕсли;
		Подразделениеобъект.Отключено 			= ПодразделениеДанныеДД.IsDisabled;
		
		Если ПодразделениеДанныеДД.Address.Свойство("RussianAddress") И ТипЗнч(ПодразделениеДанныеДД.Address.RussianAddress) =  Тип("Структура") Тогда
			
			Для Каждого ЭлементАдреса Из ПодразделениеДанныеДД.Address.RussianAddress Цикл 
				
				Если ЭлементАдреса.Ключ = "ZipCode" 
					ИЛИ ЭлементАдреса.Ключ = "City" 
					ИЛИ ЭлементАдреса.Ключ = "Region" 
					ИЛИ ЭлементАдреса.Ключ = "Street" 
					ИЛИ ЭлементАдреса.Ключ = "Locality" 
					ИЛИ ЭлементАдреса.Ключ = "Territory" 
					ИЛИ ЭлементАдреса.Ключ = "Apartment" 
					ИЛИ ЭлементАдреса.Ключ = "Block" 
					ИЛИ ЭлементАдреса.Ключ = "Building" 
					Тогда
					
					Подразделениеобъект["Адрес" + ЭлементАдреса.Ключ] = ЭлементАдреса.Значение;		
					
			 	КонецЕсли;
			 
			КонецЦикла;
			
		ИначеЕсли ПодразделениеДанныеДД.Address.Свойство("ForeignAddress") И ТипЗнч(ПодразделениеДанныеДД.Address.ForeignAddress) =  Тип("Структура") Тогда
			
			Для Каждого ЭлементАдреса Из ПодразделениеДанныеДД.Address.ForeignAddress Цикл 
				
				Если ЭлементАдреса.Ключ = "Address" 
					ИЛИ ЭлементАдреса.Ключ = "Country" 
					Тогда
					
					Подразделениеобъект["ИнАдрес" + ЭлементАдреса.Ключ] = ЭлементАдреса.Значение;		
					
			 	КонецЕсли;
			 
			КонецЦикла;
			
		КонецЕсли;
		
		Если ПодразделениеДанныеДД.ParentDepartmentId = "00000000-0000-0000-0000-000000000000" Тогда 
			Подразделениеобъект.IDРодитель = "";
		Иначе
			Подразделениеобъект.IDРодитель = ПодразделениеДанныеДД.ParentDepartmentId;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Подразделениеобъект.IDРодитель) Тогда
			Подразделениеобъект.Родитель = НайтиПоРеквизиту("ID", Подразделениеобъект.IDРодитель); 
		КонецЕсли;
	
		Подразделениеобъект.ID = ПодразделениеДанныеДД.DepartmentId;
		Подразделениеобъект.IDВладелец = ДанныеОднойОрганизации.OrgId;
		
		Подразделениеобъект.Записать();
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПодразделениеПоId(ID, IDВладелец) Экспорт
	
	Если ID = "00000000-0000-0000-0000-000000000000" Или ID = ""  Тогда 
		Возврат ПустаяСсылка();
	Иначе
		
		НайденноеПодразделение = НайтиПоРеквизиту("ID", ID);
		Если ЗначениеЗаполнено(НайденноеПодразделение) Тогда 
			
			Возврат НайденноеПодразделение;
			
		Иначе
			
			НовоеПодразделение = СоздатьЭлемент();
			НовоеПодразделение.IDВладелец = IDВладелец; //(ОрганизацияДиадок)
			НовоеПодразделение.ID = ID;
			НовоеПодразделение.Записать();
			
			Возврат НовоеПодразделение.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции
