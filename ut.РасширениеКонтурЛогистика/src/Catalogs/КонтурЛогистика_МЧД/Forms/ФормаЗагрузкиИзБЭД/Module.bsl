
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Метаданные.РегистрыСведений.Найти("ЖурналМашиночитаемыхДоверенностей") <> Неопределено Тогда		
		
		СписокМЧД = ПолучитьСписокМЧДИзЖурнала();
		
		Для каждого Стр Из СписокМЧД Цикл
			
			НоваяСтрока = Список.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
							
			НоваяСтрока.Доверители = ПолучитьПредставлениеСубъекта(Стр.Доверители);
			НоваяСтрока.Представители = ПолучитьПредставлениеСубъекта(Стр.Представители);
			
		КонецЦикла;
		
	ИначеЕсли Метаданные.Справочники.Найти("МашиночитаемыеДоверенностиОрганизаций") <> Неопределено Тогда
		
		СписокМЧД = ПолучитьСписокМЧДИзСправочника();
		
		Для каждого Стр Из СписокМЧД Цикл
			
			НоваяСтрока = Список.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
							
			Если Метаданные.Справочники.МашиночитаемыеДоверенностиОрганизаций.Реквизиты.Найти("ДоверительЮЛ_НаимОрг") <> Неопределено Тогда
				
				НоваяСтрока.Доверители = Стр.Доверенность.ДоверительЮЛ_НаимОрг;
				Если Метаданные.Справочники.МашиночитаемыеДоверенностиОрганизаций.Реквизиты.Найти("ДоверительЮЛ_ИНН") <> Неопределено Тогда
					НоваяСтрока.Доверители = НоваяСтрока.Доверители + " ИНН " + Стр.Доверенность.ДоверительЮЛ_ИНН;
				КонецЕсли;
				
				Если Метаданные.Справочники.МашиночитаемыеДоверенностиОрганизаций.ТабличныеЧасти.Найти("Представители") <> Неопределено Тогда
				
					Для Каждого СтрПредставитель Из Стр.Доверенность.Представители Цикл
						НоваяСтрока.Представители = НоваяСтрока.Представители + СтрПредставитель.Представитель;
						Если Метаданные.Справочники.МашиночитаемыеДоверенностиОрганизаций.ТабличныеЧасти.Представители.Реквизиты.Найти("ФЛ_ИНН") <> Неопределено Тогда
							НоваяСтрока.Представители = НоваяСтрока.Представители + " ИНН " + СтрПредставитель.ФЛ_ИНН + "; ";
						КонецЕсли;
					КонецЦикла;
					
				ИначеЕсли Метаданные.Справочники.МашиночитаемыеДоверенностиОрганизаций.Реквизиты.Найти("Представитель") <> Неопределено Тогда
					
					НоваяСтрока.Представители = Стр.Доверенность.Представитель;
					Если Метаданные.Справочники.МашиночитаемыеДоверенностиОрганизаций.Реквизиты.Найти("ПредставительФЛ_ИНН") <> Неопределено Тогда
						НоваяСтрока.Представители = НоваяСтрока.Представители + " ИНН " + Стр.Доверенность.ПредставительФЛ_ИНН;
					КонецЕсли;					
				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокМЧДИзЖурнала()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналМашиночитаемыхДоверенностей.Номер КАК Идентификатор,
		|	ЖурналМашиночитаемыхДоверенностей.ВсеДоверители КАК Доверители,
		|	ЖурналМашиночитаемыхДоверенностей.ВсеПредставители КАК Представители,
		|	ЖурналМашиночитаемыхДоверенностей.ДатаВыдачи КАК ДатаВыдачи,
		|	ЖурналМашиночитаемыхДоверенностей.ДатаОкончанияДействия КАК СрокДействия,
		|	ЖурналМашиночитаемыхДоверенностей.Доверенность КАК Доверенность
		|ИЗ
		|	РегистрСведений.ЖурналМашиночитаемыхДоверенностей КАК ЖурналМашиночитаемыхДоверенностей
		|ГДЕ
		|	Не ЖурналМашиночитаемыхДоверенностей.ПометкаУдаления
		|	И ЖурналМашиночитаемыхДоверенностей.ДатаОкончанияДействия > &ТекДата";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДатаСеанса());
	
	Возврат Запрос.Выполнить().Выгрузить();
	 		
КонецФункции

&НаСервере
Функция ПолучитьСписокМЧДИзСправочника()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МашиночитаемыеДоверенностиОрганизаций.Номер КАК Идентификатор,		
		|	МашиночитаемыеДоверенностиОрганизаций.ДатаВыдачи КАК ДатаВыдачи,
		|	МашиночитаемыеДоверенностиОрганизаций.ДатаОкончанияДействия КАК СрокДействия,
		|	МашиночитаемыеДоверенностиОрганизаций.Ссылка КАК Доверенность
		|ИЗ
		|	Справочник.МашиночитаемыеДоверенностиОрганизаций КАК МашиночитаемыеДоверенностиОрганизаций
		|ГДЕ
		|	ЖурналМашиночитаемыхДоверенностей.Действует
		|	И Не ЖурналМашиночитаемыхДоверенностей.ПометкаУдаления
		|	И ЖурналМашиночитаемыхДоверенностей.ДатаОкончанияДействия > &ТекДата";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДатаСеанса());
	
	Возврат Запрос.Выполнить().Выгрузить();
	 		
КонецФункции

&НаСервере
Процедура ЗагрузитьМЧД(Доверенность)
	
	ДвоичныеДанныеXMLФайлМЧД = Неопределено;
	ДвоичныеДанныеЭлектроннаяПодпись = Неопределено;
	
	Если ТипЗнч(Доверенность) = Тип("СправочникСсылка.МЧД003") Тогда
		ДвоичныеДанныеXMLФайлМЧД = Доверенность.ФайлМЧД.Получить();
		Если Доверенность.Подписи.Количество() > 0 Тогда
			ДвоичныеДанныеЭлектроннаяПодпись = Доверенность.Подписи[0].Подпись.Получить();	
		КонецЕсли;		
	ИначеЕсли ТипЗнч(Доверенность) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиОрганизаций") 
		Или ТипЗнч(Доверенность) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиКонтрагентов") Тогда
		ДвоичныеДанныеXMLФайлМЧД = Доверенность.XMLфайлМЧД.Получить();
		ДвоичныеДанныеЭлектроннаяПодпись = Доверенность.ЭлектроннаяПодпись.Получить();			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДвоичныеДанныеXMLФайлМЧД) И ЗначениеЗаполнено(ДвоичныеДанныеЭлектроннаяПодпись) Тогда
		КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьМЧДИзФайла(ДвоичныеДанныеXMLФайлМЧД, ДвоичныеДанныеЭлектроннаяПодпись, , Истина); 	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;  
	
	Для каждого ВыдСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ЗагрузитьМЧД(Список.Получить(ВыдСтрока).Доверенность);	
	КонецЦикла;
	
	Закрыть();
	
КонецПроцедуры

#Область ПредставлениеСубъектов

&НаСервере
Функция ПолучитьПредставлениеСубъекта(ТекстJson)

	Представление = "";
	ДанныеСубъекта = Вычислить("ОбщегоНазначенияБЭД.JSONЗначение(ТекстJson)");
	Если ЗначениеЗаполнено(ДанныеСубъекта) Тогда
		Массив = Новый Массив;
		Для Каждого Субъект Из ДанныеСубъекта Цикл
			Массив.Добавить(СформироватьПредставлениеСубъекта(Субъект));
		КонецЦикла;
		КоличествоСубъектов = Массив.Количество();
		Если КоличествоСубъектов > 1 Тогда
			Массив[0] = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("[%2] %1", Массив[0], КоличествоСубъектов);
		КонецЕсли;
		Представление = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Массив, "; ");
	Иначе
		Представление = "";
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПредставлениеСубъекта(Субъект)
	
	Журнал = РегистрыСведений.ЖурналМашиночитаемыхДоверенностей;
	ТипыДоверителей = Журнал.ТипыДоверителей();
	ТипыПредставителей = Журнал.ТипыПредставителей();
	
	Если Субъект.Тип = ТипыДоверителей.ЮридическоеЛицо
		Или Субъект.Тип = ТипыПредставителей.ЮридическоеЛицо Тогда
		Возврат ПредставлениеЮридическогоЛица(Субъект.ДанныеЮридическогоЛица);
	ИначеЕсли Субъект.Тип = ТипыДоверителей.ИндивидуальныйПредприниматель 
		Или Субъект.Тип = ТипыПредставителей.ИндивидуальныйПредприниматель Тогда
		Возврат ПредставлениеИндивидуальногоПредпринимателя(Субъект.ДанныеИндивидуальногоПредпринимателя);
	ИначеЕсли Субъект.Тип = ТипыДоверителей.ФизическоеЛицо
		Или Субъект.Тип = ТипыПредставителей.ФизическоеЛицо Тогда
		Возврат ПредставлениеФизическогоЛица(Субъект.ДанныеФизическогоЛица);
	ИначеЕсли Субъект.Тип = ТипыДоверителей.ИностраннаяОрганизация Тогда
		Возврат ПредставлениеИностраннойОрганизации(Субъект.ДанныеИностраннойОрганизации);
	ИначеЕсли Субъект.Тип = ТипыПредставителей.ФилиалИностраннойОрганизации Тогда
		Возврат ПредставлениеИностраннойОрганизации(Субъект.ДанныеФилиалаИностраннойОрганизации);
	ИначеЕсли Субъект.Тип = ТипыПредставителей.ФилиалЮридическогоЛица Тогда
		Возврат ПредставлениеЮридическогоЛица(Субъект.ДанныеФилиалаЮридическогоЛица);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеЮридическогоЛица(Знач Данные)
	
	ЗаполнитьПустыеПоля(Данные, "КПП");
	Шаблон = НСтр("ru='[Наименование] ИНН: [ИНН] КПП: [КПП]';");
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, Данные);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеИндивидуальногоПредпринимателя(Знач Данные)
	
