&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборПериод = "Все";
	ОтборНаши = "Наши";
	УстановитьОтбор();
	
	Если ЕстьБЭДсМЧД() Тогда
		Элементы.ФормаЗагрузитьИзБЭД.Видимость = Истина;
	КонецЕсли;
	
	КонтурЛогистика_ОнбордингСервер.ПриСозданииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОткрытьОнбординг", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОнбординг()
	
	КонтурЛогистика_ОнбордингКлиент.ПриОткрытииФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписокМЧД" Или ИмяСобытия = "ЗавершениеФоновогоЗадания" Тогда
		
		Элементы.Список.Обновить();
		
		Если ЗначениеЗаполнено(Параметр) Тогда
			Элементы.Список.ТекущаяСтрока = Параметр;
		КонецЕсли;
		
	КонецЕсли;   
	
	Если ИмяСобытия = "МЧДЗагруженыНаСервере" Тогда
		Для каждого Сообщение Из Параметр Цикл
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;   
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	УстановитьОтбор();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтбор()
	
	Список.Отбор.Элементы.Очистить();
		
	Если ОтборПериод = "Действующие" Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаОкончания");
	    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	    ЭлементОтбора.Использование = Истина;
	    ЭлементОтбора.ПравоеЗначение = ТекущаяДатаСеанса();
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ЭлементОтбора.Использование = Истина;
	    ЭлементОтбора.ПравоеЗначение = Ложь;
		
	КонецЕсли;
	
	Если ОтборНаши = "Наши" Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наша");
	    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ЭлементОтбора.Использование = Истина;
	    ЭлементОтбора.ПравоеЗначение = Истина;
		
	ИначеЕсли ОтборНаши = "Входящие" Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наша");
	    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ЭлементОтбора.Использование = Истина;
	    ЭлементОтбора.ПравоеЗначение = Ложь;
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборНашиПриИзменении(Элемент)
	
	УстановитьОтбор();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзБЭД(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_МЧД.Форма.ФормаЗагрузкиИзБЭД",
		,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикЗавершениеЗагрузки");
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершениеЗагрузки(ДанныеДляЗагрузки, ДополнительныеПараметры) Экспорт
	
	Оповестить("ОбновитьСписокМЧД");
	
КонецПроцедуры

&НаСервере
Функция ЕстьБЭДсМЧД()
		
	Если Метаданные.РегистрыСведений.Найти("ЖурналМашиночитаемыхДоверенностей") <> Неопределено 
		ИЛИ Метаданные.РегистрыСведений.Найти("МашиночитаемыеДоверенностиОрганизаций") <> Неопределено
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	 	
КонецФункции

&НаКлиенте
Процедура КонтурЛогистикаПодключаемый_ВыполнитьКоманду(Команда)
	
    КонтурЛогистика_ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры