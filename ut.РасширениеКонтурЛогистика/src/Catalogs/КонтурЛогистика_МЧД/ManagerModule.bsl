	МассивСвПолнXDTO = КС.XDTO_ВычислитьМассивXDTO(СвПолнXDTO);
	
	Для Каждого СтрокаПолномочий Из МассивСвПолнXDTO Цикл
		Если КС.XDTO_Вычислить(СтрокаПолномочий, "ТекстПолн") <> Неопределено Тогда
			ОбластьПереченьПолномочий.Параметры.ПереченьПолномочий = СтрокаПолномочий.ТекстПолн;
		Иначе
			ОбластьПереченьПолномочий.Параметры.ПереченьПолномочий = СтрокаПолномочий.КодПолн + " - " + СтрокаПолномочий.СодержПолн;
		КонецЕсли;	
		ТабличныйДокумент.Вывести(ОбластьПереченьПолномочий);
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(ОбластьОтступЗаполнение);
		
КонецПроцедуры

Функция ПолучитьФИОизXDTO(ФИОXDTO)
	
	СтруктураФИО = Новый Структура;
	
	Для каждого Стр Из ФИОXDTO.Свойства() Цикл
		СтруктураФИО.Вставить(Стр.Имя, ФИОXDTO[Стр.Имя]); 	
	КонецЦикла;
	
	Возврат ПолучитьПредставлениеФИО(СтруктураФИО)
	
КонецФункции

Функция ПолучитьДокументУдостоверяющейЛичностьИзXDTO(ДокУдЛичнXDTO)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ВидыДокументов = ВидыДокументовФизическихЛиц();
	
	КемВыдан = КС.XDTO_Вычислить(ДокУдЛичнXDTO, "ВыдДок");
	КодПодразделения = КС.XDTO_Вычислить(ДокУдЛичнXDTO, "КодВыдДок");
	
	ПредставлениеДокумента = ВидыДокументов.Получить(КС.XDTO_Вычислить(ДокУдЛичнXDTO, "КодВидДок"))
				+ " серия и номер " + КС.XDTO_Вычислить(ДокУдЛичнXDTO, "СерНомДок")
				+ " дата выдачи " + КС.XDTO_Вычислить(ДокУдЛичнXDTO, "ДатаДок")
				+ ?(КемВыдан = Неопределено, "", " кем выдан " + КемВыдан)
				+ ?(КодПодразделения = Неопределено, "", " код подразделения " + КодПодразделения);
	
	Возврат ПредставлениеДокумента;
	
КонецФункции

#КонецОбласти

// Формирует типы представителей.
// 
// Возвращаемое значение:
//  Структура:
// * ЮридическоеЛицо - Строка
// * ИндивидуальныйПредприниматель - Строка
// * ФизическоеЛицо - Строка
// * ФилиалЮридическогоЛица - Строка
// * ФилиалИностраннойОрганизации - Строка
Функция ТипыПредставителей(Формат) Экспорт
	
	Если Формат = "002" Тогда
		Результат = Новый Структура();
		Результат.Вставить("ЮридическоеЛицо", "ЮЛ");
		Результат.Вставить("ИндивидуальныйПредприниматель", "ИП");
		Результат.Вставить("ФизическоеЛицо", "ФЛ");
	КонецЕсли;
	
	Если Формат = "003" Тогда
		Результат = Новый Структура();
		Результат.Вставить("ЮридическоеЛицо", "1");
		Результат.Вставить("ИндивидуальныйПредприниматель", "2");
		Результат.Вставить("ФизическоеЛицо", "3");
		Результат.Вставить("ФилиалЮридическогоЛица", "4");
		Результат.Вставить("ФилиалИностраннойОрганизации", "5");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует типы доверителей.
// 
// Возвращаемое значение:
//  Структура:
// * ЮридическоеЛицо - Строка
// * ИностраннаяОрганизация - Строка
// * ИндивидуальныйПредприниматель - Строка
// * ФизическоеЛицо - Строка
Функция ТипыДоверителей()
	
	Результат = Новый Структура();
	Результат.Вставить("ЮридическоеЛицо", "1");
	Результат.Вставить("ИностраннаяОрганизация", "2");
	Результат.Вставить("ИндивидуальныйПредприниматель", "3");
	Результат.Вставить("ФизическоеЛицо", "4");
	Возврат Результат;
	
КонецФункции

// Формирует типы доверителей.
// 
// Возвращаемое значение:
//  Структура:
// * Текстовое      - Строка - текстовое человекочитаемое полномочие.
// * Машиночитаемое - Строка - машиночитаемое полномочие.
Функция ТипыПолномочий()
	
