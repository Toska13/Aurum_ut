Функция ПолучитьПредставлениеФИО(ФИО) Экспорт

	Представление = "";

	Если ТипЗнч(ФИО) = Тип("ОбъектXDTO") Тогда		
		Фамилия = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ФИО, "Фамилия");
		Имя = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ФИО, "Имя");
		Отчество = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ФИО, "Отчество");		
	Иначе 		
		Фамилия = ФИО.Фамилия;
		Имя = ФИО.Имя;
		Отчество = ФИО.Отчество;				
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Фамилия) Тогда
		Представление = Фамилия;
	КонецЕсли;
	Если ЗначениеЗаполнено(Имя) Тогда
		Представление = Представление + " " + Имя;
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчество) Тогда
		Представление = Представление + " " + Отчество;
	КонецЕсли;
	
	Возврат Представление;

КонецФункции

Функция ПолучитьФИОПредставителей(МЧД) Экспорт
	
	Представители = "";
	
	Для каждого Представитель Из МЧД.Представители Цикл
		
		Если Представитель.ТипПредставителя = "3" Тогда
			Представители = Представители 
				+ КонтурЛогистика_ОбщегоНазначенияСервер.ФамилияИнициалы(ПолучитьПредставлениеФИО(Представитель))
				+ ?(Представитель = МЧД.Представители[МЧД.Представители.Количество() - 1], "", ",");
									  
		ИначеЕсли Представитель.ТипПредставителя = "2" Тогда
			Представители = Представители 
				+ ?(ЗначениеЗаполнено(Представитель.НаименованиеОрганизации), Представитель.НаименованиеОрганизации, "ИП " + КонтурЛогистика_ОбщегоНазначенияСервер.ФамилияИнициалы(ПолучитьПредставлениеФИО(Представитель)))
				+ ?(Представитель = МЧД.Представители[МЧД.Представители.Количество() - 1], "", ",");
		Иначе
			Представители = Представители 
				+ Представитель.НаименованиеОрганизации
				+ ?(Представитель = МЧД.Представители[МЧД.Представители.Количество() - 1], "", ",");	
		КонецЕсли;
	КонецЦикла;
								
	Возврат Представители;
	
КонецФункции

Функция НаименованиеМЧД(МЧД) Экспорт
	
	Поля = Новый Массив;
	Поля.Добавить(ПолучитьФИОПредставителей(МЧД));
	Поля.Добавить(Формат(МЧД.ДатаОкончания, "ДФ='""до"" dd.MM.yyyy'"));
	Поля.Добавить(МЧД.ОрганизацияДиадок.Наименование);
	Поля.Добавить(МЧД.ИдентификаторДоверенности);
		
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Поля, ", ");	
	
КонецФункции

