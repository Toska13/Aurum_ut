
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Получатель = Неопределено;
	ТЧКонтрагенты = ПараметрыВыполненияКоманды.Источник.Элементы.Найти("КонтрагентыДинСписок");
	Если ТЧКонтрагенты <> Неопределено Тогда
		Если ТЧКонтрагенты.ТекущиеДанные <> Неопределено Тогда	
			Получатель =  ТЧКонтрагенты.ТекущиеДанные.Контрагент;
		КонецЕсли;
	КонецЕсли;
	
	Наша = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ПараметрКоманды, "Наш");
	Если Не Наша Тогда
		Сообщить("Выберите нашу организацию");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Получатель) Тогда
		ПараметрыФормы = Новый Структура("Отправитель, Получатель", ПараметрКоманды, Получатель);
	Иначе
		ПараметрыФормы = Новый Структура("Отправитель", ПараметрКоманды);		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"ОбщаяФорма.КонтурЛогистика_ФормаДружбыКонтрагентов",
			Параметрыформы);
	
КонецПроцедуры
