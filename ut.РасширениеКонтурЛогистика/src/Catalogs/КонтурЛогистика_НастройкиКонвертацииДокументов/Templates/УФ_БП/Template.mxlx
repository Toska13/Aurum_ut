			<c>
				<c>
					<f>45</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ВычислитьВыражение</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>38</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>РезультатВычисления = Новый Структура;
	РезультатВычисления.Вставить("Серия", "");
	РезультатВычисления.Вставить("Номер", "");
	РезультатВычисления.Вставить("ДатаВыдачи", Дата(1, 1, 1, 0, 0, 0));
	
	Если ЗначениеЗаполнено(Основание.Водитель) Тогда
		
		ФизЛицо = Справочники.ФизическиеЛица.НайтиПоНаименованию(Основание.Водитель); 
		
		Если Не ФизЛицо = Неопределено Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ДокументыФизическихЛиц.Серия КАК Серия,
			|	ДокументыФизическихЛиц.Номер КАК Номер,
			|	ДокументыФизическихЛиц.ДатаВыдачи КАК ДатаВыдачи
			|ИЗ
			|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
			|			&amp;ДатаСреза,
			|			Физлицо = &amp;ФизЛицо
			|				И ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)) КАК ДокументыФизическихЛиц";
			
			Запрос.УстановитьПараметр("ДатаСреза", Основание.Дата);
			Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо); 
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда 
				ЗаполнитьЗначенияСвойств(РезультатВычисления, Выборка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>44</f>
					<tl/>
				</c>
			</c>
