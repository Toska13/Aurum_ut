			<c>
				<c>
					<f>38</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>РезультатВычисления = Справочники.ФизическиеЛица.ПустаяСсылка();

Если ЗначениеЗаполнено(Основание.Водитель) Тогда
		
	ФизЛицо = Справочники.ФизическиеЛица.НайтиПоНаименованию(Основание.Водитель); 
		
	Если Не ФизЛицо = Неопределено Тогда 
		РезультатВычисления = ФизЛицо;		
