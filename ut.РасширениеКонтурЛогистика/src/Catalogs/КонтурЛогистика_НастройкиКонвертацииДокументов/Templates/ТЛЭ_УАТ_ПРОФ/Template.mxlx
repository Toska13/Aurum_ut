							<v8:content>ПЛ_Титул6</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>39</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>уатПутевойЛист</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>40</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ПравилаКонвертацииТитулаРеквизиты</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>41</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>1</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>42</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>МедЛицензия</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>43</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Лицензии (Контур.Логистика)</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>44</f>
					<tl/>
				</c>
			</c>
			<c>
				<c>
					<f>45</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ВычислитьВыражение</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>38</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Если ЗначениеЗаполнено(Основание) Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	уатРегистрационныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.уатРегистрационныеДокументы КАК уатРегистрационныеДокументы
		|ГДЕ
		|	уатРегистрационныеДокументы.ВладелецДокументов = &amp;ВладелецДокументов
		|	И уатРегистрационныеДокументы.ВидДокумента = ЗНАЧЕНИЕ(Справочник.уатВидыДокументов.МедицинскаяЛицензия)
		|	И уатРегистрационныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.уатСтатусыДействия.Действует)
		|	И НЕ уатРегистрационныеДокументы.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	уатРегистрационныеДокументы.ДатаВыдачи УБЫВ";
	
	

    Если ТипЗнч(Основание) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
        Запрос.УстановитьПараметр("ВладелецДокументов", Основание.МедработникВозврат);
    Иначе
        Запрос.УстановитьПараметр("ВладелецДокументов", Основание.МедицинскийРаботник);
    КонецЕсли;

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		РезультатВычисления = ВыборкаДетальныеЗаписи.Ссылка;	
	КонецЕсли;
КонецЕсли;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
			<c>
				<c>
					<f>44</f>
					<tl/>
				</c>
			</c>
			<c>
