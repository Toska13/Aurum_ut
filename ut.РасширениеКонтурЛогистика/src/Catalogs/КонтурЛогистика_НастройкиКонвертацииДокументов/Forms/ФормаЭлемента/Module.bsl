	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеЗаполнения);
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
	ЗаполнитьСпискиВыбораРеквизитовДокумента();
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьИзПравил(ИмяТабличнойЧасти, ИмяРеквизита, ЭтоГлавныйДокумент)
	
	ТаблицаПравил = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТаблицаНастроекКонвертацииДокументов(
		Объект.ТипДокументаЛогистика, Объект.ТипДокумента1С, Ложь);
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("РеквизитТитулаТипЗначения");
	ДанныеВозврата.Вставить("РеквизитТитулаКомментарий");
	ДанныеВозврата.Вставить("СпособМаппинга");
	ДанныеВозврата.Вставить("СпособКонвертацииЗначения");
	
	Для Каждого ТекущаяСтрока Из ТаблицаПравил Цикл
		Если ТекущаяСтрока.ТабЧасть <> ИмяТабличнойЧасти
			Или ТекущаяСтрока.Имя <> ИмяРеквизита Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВозврата.РеквизитТитулаТипЗначения = ТекущаяСтрока.РеквизитТитулаТипЗначения;
		ДанныеВозврата.РеквизитТитулаКомментарий = ТекущаяСтрока.РеквизитТитулаКомментарий;
		ДанныеВозврата.СпособМаппинга = ТекущаяСтрока.СпособМаппинга;
		ДанныеВозврата.СпособКонвертацииЗначения = ТекущаяСтрока.СпособКонвертацииЗначения;
		
		Возврат ДанныеВозврата;
	КонецЦикла;
	
	Если ЭтоГлавныйДокумент Тогда
		ИмяДокумента = "КонтурЛогистика_"
			+ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяГлавногоДокументаКонтурЛогистика(Объект.ТипДокументаЛогистика);
	Иначе
		ИмяДокумента = "КонтурЛогистика_"
			+ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДокумента) Тогда
		
		МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
		Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
			Если Реквизит.Имя = ИмяРеквизита Тогда
				ДанныеВозврата.РеквизитТитулаТипЗначения = Строка(Реквизит.Тип);
				ДанныеВозврата.РеквизитТитулаКомментарий = Реквизит.Комментарий;
				ДанныеВозврата.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
				ДанныеВозврата.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ДанныеВозврата;
	
КонецФункции

