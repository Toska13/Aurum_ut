&НаКлиенте
Процедура НачалоВыбораВыражения(СтандартнаяОбработка, Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		УспешнаяЗапись = ЭтаФорма.Записать();
		Если Не УспешнаяЗапись Тогда 
			Сообщить("Не удалось записать настройку. Запишите вручную, затем переходите к настройке.");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда 
		ТекДанные = Элемент.ТекущиеДанные;
	Иначе
		ТекДанные = Элемент.Родитель.Родитель.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ИзРодительскойНастройки") Тогда
		Сообщить("Для способа ""Из родительской настройки"" не доступно");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыНастройки = Новый Структура;
	// ключи, неизменяемые
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	Если ТекДанные.Свойство("РеквизитТитула") Тогда 
		ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекДанные.РеквизитТитула);
	Иначе
		ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекДанные.Имя);
	КонецЕсли;
	
	// особые, только для КонтурЛогистика_НастройкиКонвертацииДокументов
	Если Элемент.Имя = "ПравилаКонвертацииТитулаТабЧастьТоварыВыражениеВычисления"
		ИЛИ Элемент.Имя = "ПравилаКонвертацииТитулаТабЧастьТовары"
		ИЛИ (Элемент.Имя = "ПеременныеВыражениеВычисления" И ТекДанные.ИмяТабЧасти <> "") Тогда 
		
		ПараметрыФормыНастройки.Вставить("ИмяТабЧастьТовары", Объект.ИмяТабЧастьТовары);
		
		ПараметрыФормыНастройки.Вставить("ПутьКоллекцияТабЧастьТовары", Объект.ПутьКоллекцияТабЧастьТовары);
		ПараметрыФормыНастройки.Вставить("ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ", Объект.ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ);
		
	КонецЕсли;
	
	Если Элемент.Имя = "ПравилаКонвертацииТитулаТабЧастьПроизвольнаяВыражениеВычисления" 
		И ЗначениеЗаполнено(ТекДанные.ИмяТЧТитула) 
		И Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаСодержитТолькоЦифры(ТекДанные.ИмяТЧТитула) Тогда 
		
		ПараметрыФормыНастройки.Вставить("ПутьПроизвольнаяТабЧасть", ТекДанные.ПутьТЧИсходногоДокумента);
		
	КонецЕсли;
	
	// ТЧ переменные
	Если ТекДанные.Свойство("ИмяТипЗначения") Тогда 
		ТекДанные.ИмяТипЗначения = "";
	КонецЕсли;
	
	// изменяемые в открываемой форме
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекДанные.СпособМаппинга);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекДанные.ВыражениеВычисления);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления2", ТекДанные.ВыражениеВычисления2);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекДанные.ВыражениеВычисленияСтрокаНеогр);
	ПараметрыФормыНастройки.Вставить("КлючДопСвойстваРеквизита", ТекДанные.КлючДопСвойстваРеквизита);
	ПараметрыФормыНастройки.Вставить("НетТабЧастиТовары", Объект.НетТабЧастиТовары);
	ПараметрыФормыНастройки.Вставить("ЕстьЗначенияСвойствОбъектов", ЕстьЗначенияСвойствОбъектов);
	ПараметрыФормыНастройки.Вставить("ЕстьДоговорыКонтрагентов", ЕстьДоговорыКонтрагентов);
	ПараметрыФормыНастройки.Вставить("СвойствоОбъекта", ТекДанные.СвойствоОбъекта);
	
	Если Объект.ТоварыИзДополнительногоДокумента
		И Найти(Элемент.Имя, "ТабЧасть") <> 0 Тогда
		
		ПараметрыФормыНастройки.Вставить("ТипДополнительногоСвязанногоДокумента", Объект.ТипДополнительногоСвязанногоДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ТипДополнительногоСвязанногоДокумента)
		И ЗначениеЗаполнено(Объект.Родитель)
		И Найти(Элемент.Имя, "ТабЧасть") = 0
		И Найти(Элемент.Имя, "Переменные") = 0 Тогда
		
		ПараметрыФормыНастройки.Вставить("ТипДополнительногоСвязанногоДокумента", Объект.ТипДополнительногоСвязанногоДокумента);
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник",
		ПараметрыФормыНастройки,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикРедактированиеСтрокиВДопФорме",
		Элемент.Имя);
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораРеквизитаОбъекта(ТекВыражениеВычисления, ТипДокумента1С)
	
	СписокВыбора = Новый СписокЗначений;
	Если ЗначениеЗаполнено(ТипДокумента1С) Тогда 
		
		Если СокрЛП(ТекВыражениеВычисления) = "" Тогда
			КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипДокумента1С].Реквизиты;
			
		Иначе
			
			МассивВложенности = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ТекВыражениеВычисления,".");
			
			КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипДокумента1С].Реквизиты;
			
			Для Каждого текРеквизит Из МассивВложенности Цикл
				
				Попытка
					Если КонтейнерКоллекцииРеквизитов = Неопределено Тогда 
						ТипТекущегоЭлемента = Метаданные.Документы[ТипДокумента1С].Реквизиты[текРеквизит].Тип.Типы()[0];
						КонтейнерКоллекцииРеквизитов = Метаданные.НайтиПоТипу(ТипТекущегоЭлемента).Реквизиты;
					Иначе
					    ТипТекущегоЭлемента = КонтейнерКоллекцииРеквизитов[текРеквизит].Тип.Типы()[0];
						КонтейнерКоллекцииРеквизитов = Метаданные.НайтиПоТипу(ТипТекущегоЭлемента).Реквизиты;
						Прервать;
					КонецЕсли;
				Исключение
					КонтейнерКоллекцииРеквизитов = Неопределено;
					Прервать;
				КонецПопытки;
			КонецЦикла;
			
		КонецЕсли;
		
		Если КонтейнерКоллекцииРеквизитов <> Неопределено Тогда 
			Для Каждого Реквизит Из КонтейнерКоллекцииРеквизитов Цикл
				СписокВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним, , БиблиотекаКартинок.Реквизит);
			КонецЦикла;
		КонецЕсли;
		// если выводим для документа - то еще стандартные реквизиты
		Если СокрЛП(ТекВыражениеВычисления) = "" Тогда
			Для Каждого Реквизит Из Метаданные.Документы[ТипДокумента1С].СтандартныеРеквизиты Цикл
				СписокВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним, , БиблиотекаКартинок.Реквизит);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикВыборВыражениеВычисления(ВыбранноеЗначение = Неопределено, Элемент = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено и Элемент <> Неопределено Тогда
		Если ЗначениеЗаполнено(СокрЛП(Элемент.Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления)) Тогда 
			Элемент.Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления = "" + СокрЛП(Элемент.Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления) + "." + ВыбранноеЗначение.Значение;
		Иначе
			Элемент.Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления = ВыбранноеЗначение.Значение;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВведенКодВычисления(ВыбранноеЗначение = Неопределено, Элемент = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено и Элемент <> Неопределено Тогда
		Элемент.Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления = ВыбранноеЗначение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВводДопСвойства(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено И ТипЗнч(ВыбранноеЗначение) = тип("Структура") И ИмяЭлемента <> Неопределено Тогда
		Элементы[ИмяЭлемента].Родитель.Родитель.ТекущиеДанные.ВыражениеВычисления 		= ВыбранноеЗначение.ВыражениеВычисления;
		Элементы[ИмяЭлемента].Родитель.Родитель.ТекущиеДанные.КлючДопСвойстваРеквизита 	= ВыбранноеЗначение.КлючДопСвойстваРеквизита;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикРедактированиеСтрокиВДопФорме(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт

	Если ВыбранноеЗначение <> Неопределено И ТипЗнч(ВыбранноеЗначение) = тип("Структура") И ИмяЭлемента <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		Если ТипЗнч(Элементы[ИмяЭлемента]) = Тип("ТаблицаФормы") Тогда 
			ТабФормы  = Элементы[ИмяЭлемента];
		Иначе
			ТабФормы  = Элементы[ИмяЭлемента].Родитель.Родитель;
		КонецЕсли;

		ТабФормы.ТекущиеДанные.СпособМаппинга 					= ВыбранноеЗначение.СпособМаппинга;
		ТабФормы.ТекущиеДанные.ВыражениеВычисления 				= ВыбранноеЗначение.ВыражениеВычисления;
		ТабФормы.ТекущиеДанные.ВыражениеВычисления2 			= ВыбранноеЗначение.ВыражениеВычисления2;
		ТабФормы.ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр	= ВыбранноеЗначение.ВыражениеВычисленияСтрокаНеогр;
		ТабФормы.ТекущиеДанные.КлючДопСвойстваРеквизита 		= ВыбранноеЗначение.КлючДопСвойстваРеквизита;
		ТабФормы.ТекущиеДанные.СвойствоОбъекта 					= ВыбранноеЗначение.СвойствоОбъекта;
		
		Если ТабФормы.Имя = "Переменные" Тогда 
			Если ВыбранноеЗначение.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение") 
				И ЗначениеЗаполнено(ВыбранноеЗначение.ВыражениеВычисления) 
				И Не ЗначениеЗаполнено(ТабФормы.ТекущиеДанные.ИмяТипЗначения) Тогда  	
				ТабФормы.ТекущиеДанные.ИмяТипЗначения = Строка(ТипЗНЧ(ВыбранноеЗначение.ВыражениеВычисления))
			Иначе	
				ТабФормы.ТекущиеДанные.ИмяТипЗначения = "";
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ЗакончитьРедактированиеСтроки(Ложь);	

КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииГлавногоДокументаСпособМаппингаПриИзменении(Элемент)
	
	ТекДанные = Элемент.Родитель.ТекущиеДанные;
	Если ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") Тогда 
		ТекДанные.ВыражениеВычисления = "Основание.Дата";
		
	ИначеЕсли ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ЗначениеОбщейНастройки") Тогда 
		ТекДанные.ВыражениеВычисления = ПредопределенноеЗначение("Справочник.КонтурЛогистика_Настройки.ПустаяСсылка");
		
	ИначеЕсли ТекДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение") Тогда 
		Если ТекДанные.РеквизитТитулаТипЗначения = "Булево" Тогда 
			ТекДанные.ВыражениеВычисления = Ложь;
		ИначеЕсли ТекДанные.РеквизитТитулаТипЗначения = "Строка" Тогда
			ТекДанные.ВыражениеВычисления = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииГлавногоДокументаВыражениеВычисленияОчистка(Элемент, СтандартнаяОбработка)
	Элемент.Родитель.Родитель.ТекущиеДанные.КлючДопСвойстваРеквизита = "";
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьПовторноИспользуемыеЗначения();
	ПроверитьДополнительныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если (Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее")
			Или Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее"))
		И Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")  Тогда 
		
		Если ЗначениеЗаполнено(Объект.ТипДокумента1С)
			И (Не ЗначениеЗаполнено(Объект.ПутьОрганизация)
			ИЛИ Не ЗначениеЗаполнено(Объект.ПутьПеревозчик))
			Тогда
			
			Сообщить("Для титула 1 рекомендуется указывать: 1) Исходный документ учетной системы, 2) Путь до Организации и 3) Путь до Перевозчика!");
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Объект.Родитель) И Не ЗначениеЗаполнено(Объект.ДопСвязанныйДокументВыражениеВычисления) Тогда 
		
		Отказ = Истина;
		Сообщить("Для дочерних настроек обязательно указывать Вычисление дополнительного документа (реквизит ДопСвязанныйДокументВыражениеВычисления), иначе она никогда не применится");
		
	КонецЕсли;
	
	Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее") И Не ЗначениеЗаполнено(Объект.Сценарий) Тогда 
		
		Отказ = Истина;
		Сообщить("Не выбран сценарий");
		
	КонецЕсли;
	
	Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее") 
		И Не ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда 
		
		Отказ = Истина;
		Сообщить("Не выбран документ учетной системы");
		
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ПравилаКонвертацииГлавногоДокумента Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.РеквизитТитула) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиТЧ = Формат(Объект.ПравилаКонвертацииГлавногоДокумента.Индекс(ТекущаяСтрока), "ЧДЦ=; ЧН=; ЧГ=");
		
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить конвертицию реквизита";
		ПараметрыСообщения.Поле = "Объект.ПравилаКонвертацииГлавногоДокумента[" + НомерСтрокиТЧ + "].РеквизитТитула";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Отказ = Истина;
		Прервать;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ПравилаКонвертацииТитулаРеквизиты Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.РеквизитТитула) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиТЧ = Формат(Объект.ПравилаКонвертацииТитулаРеквизиты.Индекс(ТекущаяСтрока), "ЧДЦ=; ЧН=; ЧГ=");
		
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить конвертицию реквизита";
		ПараметрыСообщения.Поле = "Объект.ПравилаКонвертацииТитулаРеквизиты[" + НомерСтрокиТЧ + "].РеквизитТитула";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Отказ = Истина;
		Прервать;
	КонецЦикла;
	
	// Поиск учетного документа по Номеру и Дате Главного Документа
	Если Объект.ПоискУчВариант = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоНомеруИДате") Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ПутьПоискУчДокНомер) Тогда
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Необходимо заполнить номер ЭТРН в реквизите";
			ПараметрыСообщения.Поле = "Объект.ПутьПоискУчДокНомер";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ПутьОрганизация) Тогда
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Необходимо заполнить организацию в реквизите";
			ПараметрыСообщения.Поле = "Объект.ПутьОрганизация";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	// Дополнительные колонки
	Для Каждого ТекущаяСтрока Из Объект.ДополнительныеКолонки Цикл
				
		НомерСтрокиТЧ = Формат(Объект.ДополнительныеКолонки.Индекс(ТекущаяСтрока), "ЧДЦ=; ЧН=; ЧГ=");
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Заголовок) Тогда
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Необходимо заполнить заголовок дополнительной колонки";
			ПараметрыСообщения.Поле = "Объект.ДополнительныеКолонки[" + НомерСтрокиТЧ + "].Заголовок";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			
			Отказ = Истина;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ПутьКДанным) Тогда
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Необходимо заполнить путь к данным дополнительной колонки";
			ПараметрыСообщения.Поле = "Объект.ДополнительныеКолонки[" + НомерСтрокиТЧ + "].ПутьКДанным";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			
			Отказ = Истина;
			
		КонецЕсли;
		
		Если ТекущаяСтрока.Отбор И Не ЗначениеЗаполнено(ТекущаяСтрока.Тип) Тогда
			ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
			ПараметрыСообщения.Текст = "Не заполнен тип дополнительной колонки. Необходимо перезаполнить путь к данным дополнительной колонки";
			ПараметрыСообщения.Поле = "Объект.ДополнительныеКолонки[" + НомерСтрокиТЧ + "].ПутьКДанным";
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
			
			Отказ = Истина;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ЭтоНовый = НЕ ЗначениеЗаполнено(Объект.Ссылка);
	Если ЭтоНовый Тогда 
		ПроверитьВозможностьЗаписиНастройки(Отказ);		
	КонецЕсли;
	
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
		СохранитьДеревоРеквизитовДокУчСистВТаблЧасть();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НеЗаполнятьВыделенныеСтроки(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПравилаКонвертацииГлавногоДокумента Тогда 
		
		ВыделенныеСтроки = Элементы.ПравилаКонвертацииГлавногоДокумента.ВыделенныеСтроки;
		Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			текСтрока = Объект.ПравилаКонвертацииГлавногоДокумента.НайтиПоИдентификатору(ВыделеннаяСтрока);
			текСтрока.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять");
		КонецЦикла;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПравилаКонвертацииТитулаРеквизиты Тогда
		
		ВыделенныеСтроки = Элементы.ПравилаКонвертацииТитулаРеквизиты.ВыделенныеСтроки;
		Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			текСтрока = Объект.ПравилаКонвертацииТитулаРеквизиты.НайтиПоИдентификатору(ВыделеннаяСтрока);
			текСтрока.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять");
		КонецЦикла;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПравилаКонвертацииТитулаТабЧастьТовары Тогда
		
		ВыделенныеСтроки = Элементы.ПравилаКонвертацииТитулаТабЧастьТовары.ВыделенныеСтроки;
		Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			текСтрока = Объект.ПравилаКонвертацииТитулаТабЧастьТовары.НайтиПоИдентификатору(ВыделеннаяСтрока);
			текСтрока.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениямиПоУмолчанию(Команда)
	ЗаполнитьЗначениямиПоУмолчаниюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениямиПоУмолчаниюНаСервере()
		
	Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ЗаполнитьПравилаКонвертации(Объект);
		
КонецПроцедуры

&НаКлиенте
Процедура ПутьПеревозчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДокументУчетнойСистемы", 	объект.ТипДокумента1С);
	ПараметрыФормы.Вставить("ПутьПеревозчика", 			Объект.ПутьПеревозчик);
	ПараметрыФормы.Вставить("СписокВыбораРеквизитов", 	Элементы.ПутьПеревозчик.СписокВыбора.ВыгрузитьЗначения());
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаВыбораПеревозчика",
		ПараметрыФормы, 
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикВыбораПутиПеревозчика",, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораПутиПеревозчика(Результат, ДопПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Отмена Тогда 
		Возврат
	КонецЕсли;	

	Объект.ПутьПеревозчик = Результат;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если (ЗавершениеРаботы = Ложь Или ЗавершениеРаботы = Неопределено)
		И Не Объект.Ссылка.Пустая() Тогда
		
		Оповестить("ОбновитьСтартовыйПомошник");
		Оповестить("ОбновитьРабочийСтол", Объект.Ссылка);
		Оповестить("КонтурЛогистика_ОбновитьФормуСпискаЗадач");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииЛюбойТаблицыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Найти(Поле.Имя, "ВыражениеВычисления") > 0
		И (Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение")
			Или Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования")) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НачалоВыбораВыражения(СтандартнаяОбработка, Элемент);
		
	КонецЕсли;
	
	Если Найти(Поле.Имя, "КонвертироватьПоНастройке") > 0
		И Элемент.ТекущиеДанные.СпособКонвертацииЗначения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьМассивСтруктур") Тогда
		
		КонвертироватьПоНастройкеНачалоВыбора(Элемент, Неопределено, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазделительПриИзменении(Элемент)
	УстановитьВидимостьРеквизитовРазделителя();
	ОчиститьРеквизитыРазделителя();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьРеквизитовРазделителя()

	Если Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.ПустаяСсылка")
		ИЛИ Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.НеРазделять")
		Тогда 
		
		Элементы.ГруппаУсловияРазделителя.Видимость = Ложь;
		Элементы.УсловиеФильтраТоваров.Видимость 	= Ложь;
		
	Иначе
		
		Элементы.ГруппаУсловияРазделителя.Видимость = Истина;
		
		Элементы.РазделительКодНа1С.Видимость 		= Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.ВычислитьМассивВыражениемНаЯзыке1С");
		Элементы.РазделительИмяТЧ.Видимость 		= Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.РеквизитТабличнойЧастиДокумента");
		Элементы.РазделительИмяРеквизита.Видимость 	= Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.РеквизитТабличнойЧастиДокумента");
		
		Элементы.УсловиеФильтраТоваров.Видимость 	= Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.ВычислитьУсловиеФильтраНаЯзыке1С");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ОбновитьСтартовыйПомошник");
	Оповестить("ОбновитьРабочийСтол", Объект.Ссылка);
	Оповестить("КонтурЛогистика_ПерепроверитьДокумент");
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
КонецПроцедуры

&НаКлиенте
Процедура НетТабЧастиТоварыПриИзменении(Элемент)
	
	УстановитьВидимостьСтраницыТабчастьТовары();
	УстановитьВидимостьДопУсловийСворачивания();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьСтраницыТабчастьТовары()
	
	Если Объект.НетТабЧастиТовары Тогда 
		Элементы.СтраницыТабчастьТовары.ТекущаяСтраница = Элементы.СтраницаНетТабчастиТовары;
	Иначе
		Элементы.СтраницыТабчастьТовары.ТекущаяСтраница = Элементы.СтраницаЕстьТабчастьТовары;
	КонецЕсли;
	
	Элементы.ТоварыИзДополнительногоДокумента.Видимость = ЗначениеЗаполнено(Объект.Родитель) И Не Объект.НетТабЧастиТовары;
	
	Если Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") 
		И Не ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда
		Элементы.СтраницыТабчастьТовары.Видимость = Ложь;	
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура РодительПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Родитель) И Не ЕстьВозможностьСоздаватьДочерние(Объект.Родитель) Тогда
		Объект.Родитель = Неопределено;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	ЭтоЗависимаяНастройкаДопДокумента 			= ЗначениеЗаполнено(Объект.Родитель);
	
	Элементы.БаннерЗависимаяНастройка.Видимость = ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.ТипДополнительногоСвязанногоДокумента.Видимость = ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.ГруппаДопДокумент.Видимость 		= ЭтоЗависимаяНастройкаДопДокумента;
	
	Элементы.ТипДокумента1С.Доступность 		= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.ТипДокументаЛогистика.Доступность 	= Не ЭтоЗависимаяНастройкаДопДокумента;
	
	Элементы.СтраницаВалидации.Видимость 		= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.Группа3.Видимость 					= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.ГруппаСценарии.Доступность 		= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.Группа3.Доступность 				= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.ГруппаПоискУчДок.Доступность 		= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.СтраницаДочерние.Видимость 		= Не ЭтоЗависимаяНастройкаДопДокумента;
	Элементы.ДочерниеНастройкиКонвертацииСоздатьДочернюю.Видимость 		= Не ЭтоЗависимаяНастройкаДопДокумента;
	
	Если Элементы.ГруппаПутиИдентификации.Видимость Тогда
		Элементы.ГруппаПутиИдентификации.Видимость = Не ЭтоЗависимаяНастройкаДопДокумента;
		Элементы.ГруппаПутиИдентификации.Доступность = Не ЭтоЗависимаяНастройкаДопДокумента;
	КонецЕсли;
	
	Если Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
		Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
		Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
		Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")
		Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда
		
		Элементы.ГруппаКонструкторЗапросаУчетныхДокументов.Видимость = Истина;
	Иначе
		Элементы.ГруппаКонструкторЗапросаУчетныхДокументов.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовСпецСценария();
	
КонецПроцедуры 

&НаКлиенте
Процедура СоздатьДочернюю(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ДанныеЗаполнения 	= Новый Структура("Родитель, ТипДокументаЛогистика, ТипДокумента1С", Объект.Ссылка, Объект.ТипДокументаЛогистика, Объект.ТипДокумента1С);
		ПараметрыФормы 		= Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
		ОткрытьФорму("Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ФормаОбъекта", ПараметрыФормы);
		
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Можно вводить дочерние настройки только для записанных настроек конвертации. Сначала запишите текущий элемент.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СворачиватьТабЧастьТоварыПриИзменении(Элемент)
		
	Если Объект.СворачиватьТабЧастьТовары 
		И Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3") 
		И Не ТекНастройкаСопоставленияТоваровТ3 = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыСопоставленияТоваровТитул3.Наименование") Тогда 
		
		ТекстВопроса = "При конвертации документов автоматичести сопоставляются товары из Титула Т1 и товары учетного документа
			            |Текущая настройка сопоставления - """ + ТекНастройкаСопоставленияТоваровТ3 + """
			            |Необходимая настройка сопоставления при сворачивании - ""Наименование""
			            |Установить необходимую настройку сопоставления?'";
				
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
			ТекстВопроса, 
			РежимДиалогаВопрос.ДаНет,,, 
			ЭтаФорма, 
			"СворачиватьТабЧастьТоварыПриИзмененииПродолжение");  
		
	Иначе	
		
		СворачиватьТабЧастьТоварыПриИзмененииНаКлиенте();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СворачиватьТабЧастьТоварыПриИзмененииПродолжение(Ответ, ДопПараметры) Экспорт 

	Если Ответ = КодВозвратаДиалога.Да Тогда 
		
		ИзменитьЗначениеНастройкеСопоставления();
		СворачиватьТабЧастьТоварыПриИзмененииНаКлиенте();
		
		ТекНастройкаСопоставленияТоваровТ3 = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыСопоставленияТоваровТитул3.Наименование");
		
	Иначе
		
		Объект.СворачиватьТабЧастьТовары = Ложь;
		
	КонецЕсли;	

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьЗначениеНастройкеСопоставления()

	КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьНастройку(
		"Т3СпособСопоставленияТоваров", 
		Перечисления.КонтурЛогистика_СпособыСопоставленияТоваровТитул3.Наименование);

КонецПроцедуры

&НаКлиенте
Процедура СворачиватьТабЧастьТоварыПриИзмененииНаКлиенте()

	УстановитьВидимостьДопУсловийСворачивания();
	
	Если Объект.СворачиватьТабЧастьТовары Тогда 
		Объект.УсловиеГруппировкиСтрокТоваров = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГруппыРазделителей()
	
	Если Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
		Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1") Тогда
		
		Элементы.ГруппаРазделительТ1.Видимость = Истина;
		
		Если Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1") Тогда
			Элементы.Разделитель.Заголовок = СтрЗаменить(Элементы.Разделитель.Заголовок, "ТРН", "ПЛ");
			Элементы.Разделитель.Подсказка = СтрЗаменить(Элементы.Разделитель.Подсказка, "ТРН", "ПЛ");
		КонецЕсли;
	Иначе
		Элементы.ГруппаРазделительТ1.Видимость = Ложь;
	КонецЕсли;
		
	Элементы.ГруппаРазделительТ3.Видимость
		= Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДопУсловийСворачивания()

	Элементы.ГруппаУсловиеСворачивания.Видимость = Объект.СворачиватьТабЧастьТовары;	

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыРазделителя()
	
	Если Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.ПустаяСсылка")
		Или Объект.Разделитель = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыРазделителя.НеРазделять") Тогда 
		
		Объект.РазделительИмяРеквизита 			= "";
		Объект.РазделительИмяТЧ 				= "";
		Объект.РазделительКодНа1С 				= "";
		Объект.РазделительУсловиеСтрокиТоваров 	= "";
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоискУчВариантыПриИзменении(Элемент)
	
	УправлениеВидимостьюВариантовПоиска();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюВариантовПоиска()

	Элементы.ГруппаПоискУчДокНомер.Видимость 	= Ложь;
	Элементы.ГруппаПоискУчДокСвязь.Видимость 	= Ложь;
	Элементы.ГруппаПоискУчДокСвой.Видимость 	= Ложь;
	
	Если Объект.ПоискУчВариант = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоНомеруИДате") Тогда
		Элементы.ГруппаПоискУчДокНомер.Видимость 	= Истина;
	ИначеЕсли Объект.ПоискУчВариант = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1") Тогда
		Элементы.ГруппаПоискУчДокСвязь.Видимость 	= Истина;
	ИначеЕсли Объект.ПоискУчВариант = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.СвойАлгоритм") Тогда	
		Элементы.ГруппаПоискУчДокСвой.Видимость 	= Истина;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииТитулаТабЧастьПроизвольнаяИмяТЧТитулаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.ИмяТЧТитула) 
		И Не ЗначениеЗаполнено(Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.ПутьТЧИсходногоДокумента)
		И Не ЗначениеЗаполнено(Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.РеквизитТитула)
		И ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда 
		
		ИмяТЧ = Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.ИмяТЧТитула;
		ИдентификаторСтроки = Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущаяСтрока;
		ЗаполнитьМассивРеквизитовПроизвольнойТЧ(ИмяТЧ, ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМассивРеквизитовПроизвольнойТЧ(ИмяТЧ, ИдентификаторСтроки)
	
	ИмяДок = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика);
	
	РеквизитыТЧ = Метаданные.Документы["КонтурЛогистика_" + ИмяДок].ТабличныеЧасти[ИмяТЧ].Реквизиты;
	
	ЗаполняемаяСтрока = Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Для Каждого РеквизитТЧ Из РеквизитыТЧ Цикл
				
		Если ЗаполняемаяСтрока.РеквизитТитула = "" Тогда 
			НоваяСтрока = ЗаполняемаяСтрока;
		Иначе
			НоваяСтрока = Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.Добавить();
			НоваяСтрока.ИмяТЧТитула = ЗаполняемаяСтрока.ИмяТЧТитула;
		КонецЕсли;
		
		НоваяСтрока.РеквизитТитула 				= РеквизитТЧ.Имя;
		НоваяСтрока.РеквизитТитулаТипЗначения 	= РеквизитТЧ.Тип;
		НоваяСтрока.РеквизитТитулаКомментарий 	= РеквизитТЧ.Комментарий;
		НоваяСтрока.СпособМаппинга 				= Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(Объект.ТипДокументаЛогистика)
			И (ИмяТЧ = "ОстаткиТоплива" Или ИмяТЧ = "Заправки")
			И РеквизитТЧ.Имя = "ИдентификаторСтроки" Тогда
			НоваяСтрока.СпособМаппинга 			= Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически;
		КонецЕсли;
		
		Если РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Договоры") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор;
		ИначеЕсли РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок;
		ИначеЕсли РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ПодразделенияДиадок") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПодразделениеДиадок;
		ИначеЕсли РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута;
		ИначеЕсли РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника;
		ИначеЕсли РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство;
		ИначеЕсли РеквизитТЧ.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Лицензии") Тогда 
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВЛицензию;
		Иначе
			НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
		КонецЕсли;
		
		НоваяСтрока.СпособМаппингаДобавлятьСтроку = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииТитулаТабЧастьПроизвольнаяПутьТЧИсходногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ИмяИсходногоДокументаУчСист", 	Объект.ТипДокумента1С);
	ПараметрыФормы.Вставить("КакВычислитьТабЧасть", Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.ПутьТЧИсходногоДокумента);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаВыбораТЧИсходногоДокумента",
		ПараметрыФормы, 
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикВыбораТЧИсходногоДокумента",, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработчикВыбораТЧИсходногоДокумента(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда 
		Возврат
	КонецЕсли;	

	ПоискТакихЖеСтрок = Новый Структура("ИмяТЧТитула,ПутьТЧИсходногоДокумента", Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.ИмяТЧТитула, Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные.ПутьТЧИсходногоДокумента);
	СтрокиКЗаполнениюТЧИсходного = Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.НайтиСтроки(ПоискТакихЖеСтрок);
	
	Для Каждого СтрокаГруппы Из СтрокиКЗаполнениюТЧИсходного Цикл 
		СтрокаГруппы.ПутьТЧИсходногоДокумента = Результат;
	КонецЦикла;
	
	Модифицированность = Истина;
	
	Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ЗакончитьРедактированиеСтроки(Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииТитулаТабЧастьПроизвольнаяВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НачалоВыбораВыражения(СтандартнаяОбработка, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьПоНастройкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяТабличнойЧасти = СтрЗаменить(Элемент.Имя, "КонвертироватьПоНастройке", "");
	
	ТекущиеДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	СпособКонвертацииЗначения = ТекущиеДанные.СпособКонвертацииЗначения;
	
	ИмяСправочника = ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	Если СпособКонвертацииЗначения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьМассивСтруктур") Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипДокументаЛогистика", Объект.ТипДокументаЛогистика);
		ПараметрыФормы.Вставить("ИмяТабличнойЧасти", СтрЗаменить(ТекущиеДанные.РеквизитТитула, "МассивСтруктур", ""));
		ПараметрыФормы.Вставить("ИмяРеквизитаТабличнойЧасти", ТекущиеДанные.РеквизитТитула);
		
		ПравилаКонвертацииМассиваСтруктур = ПравилаКонвертацииМассиваСтруктур(
			ПараметрыФормы.ИмяТабличнойЧасти, ПараметрыФормы.ИмяРеквизитаТабличнойЧасти);
		ПараметрыФормы.Вставить("ПравилаКонвертацииМассиваСтруктур", ПравилаКонвертацииМассиваСтруктур);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаПравилаКонвертацииМассивовСтруктур",
			ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"КонвертироватьПоНастройкеМассиваСтруктурНачалоВыбораЗавершение", ПараметрыФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
		НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее");
		ЗначениеОтбора = Новый Структура("ТипСправочникаЛогистика, НаправлениеКонвертации", ИмяСправочника, НаправлениеКонвертации);
		ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
		ПараметрыОбработчика = Новый Структура("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"КонвертироватьПоНастройкеНачалоВыбораЗавершение", ПараметрыОбработчика, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПравилаКонвертацииМассиваСтруктур(ИмяТабличнойЧасти, ИмяРеквизитаТабличнойЧасти)
	
	ПравилаКонвертацииМассиваСтруктур = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Объект.ПравилаКонвертацииМассивовСтруктур Цикл
		Если ТекущаяСтрока.ИмяТабличнойЧасти <> ИмяТабличнойЧасти
			Или ТекущаяСтрока.ИмяРеквизитаТабличнойЧасти <> ИмяРеквизитаТабличнойЧасти Тогда
			
			Продолжить;
		КонецЕсли;
		
		ПравилоКонвертацииТекущее = Новый Структура;
		ПравилоКонвертацииТекущее.Вставить("РеквизитТитула", ТекущаяСтрока.РеквизитТитула);
		ПравилоКонвертацииТекущее.Вставить("СпособКонвертацииЗначения", ТекущаяСтрока.СпособКонвертацииЗначения);
		ПравилоКонвертацииТекущее.Вставить("КонвертироватьПоНастройке", ТекущаяСтрока.КонвертироватьПоНастройке);
		
		ПравилаКонвертацииМассиваСтруктур.Добавить(ПравилоКонвертацииТекущее);
	КонецЦикла;
	
	Возврат ПравилаКонвертацииМассиваСтруктур;
	
КонецФункции

&НаКлиенте
Процедура КонвертироватьПоНастройкеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы[ДополнительныеПараметры.ИмяТабличнойЧасти].ТекущиеДанные.КонвертироватьПоНастройке = Результат;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьПоНастройкеМассиваСтруктурНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Результат Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИмяТабличнойЧасти", ДополнительныеПараметры.ИмяТабличнойЧасти);
		ПараметрыОтбора.Вставить("ИмяРеквизитаТабличнойЧасти", ДополнительныеПараметры.ИмяРеквизитаТабличнойЧасти);
		ПараметрыОтбора.Вставить("РеквизитТитула", ТекущаяСтрока.РеквизитТитула);
		
		НайденныеСтроки = Объект.ПравилаКонвертацииМассивовСтруктур.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ПравилаКонвертацииМассивовСтруктур.Добавить();
			НоваяСтрока.ИмяТабличнойЧасти = ДополнительныеПараметры.ИмяТабличнойЧасти;
			НоваяСтрока.ИмяРеквизитаТабличнойЧасти = ДополнительныеПараметры.ИмяРеквизитаТабличнойЧасти;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		Иначе
			Для Каждого ТекущаяНайденнаяСтрока Из НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(ТекущаяНайденнаяСтрока, ТекущаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения)
	
	Возврат Перечисления.КонтурЛогистика_СпособыКонвертации.ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
КонецФункции

&НаКлиенте
Процедура КонвертироватьПоНастройкеПриИзменении(Элемент)
	
	ИмяТабличнойЧасти = СтрЗаменить(Элемент.Имя, "КонвертироватьПоНастройке", "");
	
	ТекущиеДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	КонвертироватьПоНастройке = ТекущиеДанные.КонвертироватьПоНастройке;
	
	Если Не ЗначениеЗаполнено(КонвертироватьПоНастройке) Тогда
		Возврат;
	КонецЕсли;
	
	СпособКонвертацииЗначения = ТекущиеДанные.СпособКонвертацииЗначения;
	ИмяСправочника = ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	ТипСправочникаЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		КонвертироватьПоНастройке, "ТипСправочникаЛогистика");
	
	Если ИмяСправочника <> ТипСправочникаЛогистика Тогда
		Сообщить("Выбрана не подходящая настройка конвертации под способ конвертации значения.");
		ТекущиеДанные.КонвертироватьПоНастройке = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДочерниеНастройкиКонвертацииПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДочерниеНастройкиКонвертации.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопСвязанныйДокументВыражениеВычисленияДочернего = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ТекущиеДанные.Ссылка, "ДопСвязанныйДокументВыражениеВычисления");
	
	Элементы.ДопСвязанныйДокументВыражениеВычисленияДочернего.Заголовок = "Способ расчета дополнительного (" + Строка(ТекущиеДанные.Ссылка) + ")";
	
