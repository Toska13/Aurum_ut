&НаСервере
Процедура ЗаполнитьСписокВыбораИмяТЧТоварыДокУчСист()
	
	Элементы.ИмяТЧТоварыДокУчСист.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда 
		
		Для Каждого текТЧ Из Метаданные.Документы[Объект.ТипДокумента1С].ТабличныеЧасти Цикл
			
			Элементы.ИмяТЧТоварыДокУчСист.СписокВыбора.Добавить(текТЧ.Имя);
			
		КонецЦикла;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораИмяТЧТоварыДокЛогистика()
	
	Элементы.ИмяТЧТоварыДокЛогистика.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда 
		
		ДокументЛогистика = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика);
		
		Для Каждого текТЧ Из Метаданные.Документы[ДокументЛогистика].ТабличныеЧасти Цикл
			
			Элементы.ИмяТЧТоварыДокЛогистика.СписокВыбора.Добавить(текТЧ.Имя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРеквизитовДокУчСист()
	
	дз = Новый ДеревоЗначений;
	Для каждого РеквизитТЧ Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.ЗаполнениеДокУчСист.Реквизиты Цикл
		дз.Колонки.Добавить(РеквизитТЧ.Имя);
	КонецЦикла;
	
	СтрокаТипАлгоритмаЗаполнить = "";
	
	Для каждого Стр Из Объект.ЗаполнениеДокУчСист Цикл
		
		Если Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить И Не ЗначениеЗаполнено(Стр.Реквизит) Тогда
			СтрокаТипАлгоритмаЗаполнить = дз.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТипАлгоритмаЗаполнить, Стр);	
		ИначеЕсли Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить И ЗначениеЗаполнено(Стр.Реквизит) Тогда
			СтрокаЗапись = СтрокаТипАлгоритмаЗаполнить.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗапись, Стр);
		ИначеЕсли Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит 
			ИЛИ Стр.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
			СтрокаЗапись = дз.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗапись, Стр);
		КонецЕсли;	
		
	Конеццикла;
		
	ЗначениеВРеквизитФормы(дз, "ДеревоРеквизитовДокУчСист");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораДокУчСистПроизвольнойТЧ()

	Элементы.ЗаполнениеДокУчСистТЧПроизвольнаяИмяТЧТитула.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда 
		
		Для Каждого текТЧ Из Метаданные.Документы[Объект.ТипДокумента1С].ТабличныеЧасти Цикл
			
			Если текТЧ.Имя = Объект.ИмяТЧТоварыДокУчСист Тогда 
				Продолжить;
			КонецЕсли;
			
			Элементы.ЗаполнениеДокУчСистТЧПроизвольнаяИмяТЧТитула.СписокВыбора.Добавить(текТЧ.Имя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРеквизитУчСист(Команда)
	
	ТекДанные = Элементы.ДеревоРеквизитовДокУчСист.ТекущиеДанные;
	
	СпискиРеквизитов = СписокРеквизитовДляДобавления();
	
	ПараметрыФормыНастройки = Новый Структура;
	ПараметрыФормыНастройки.Вставить("ТипДокумента1С", Объект.ТипДокумента1С);
	ПараметрыФормыНастройки.Вставить("ТипДокументаЛогистика", Объект.ТипДокументаЛогистика);
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	ПараметрыФормыНастройки.Вставить("СписокРеквизитов", СпискиРеквизитов.СписокРеквизитов);
	ПараметрыФормыНастройки.Вставить("СписокРевизитовМетодаЗаполнить", СпискиРеквизитов.СписокРевизитовМетодаЗаполнить);
	ПараметрыФормыНастройки.Вставить("СписокРевизитовУказать", СпискиРеквизитов.СписокРевизитовУказать);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаДобавленияРеквизитаУчСист",
		ПараметрыФормыНастройки,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикДобавленияРеквизитаУчСист"
		,
		);
	
КонецПроцедуры

&НаКлиенте
Функция СписокРеквизитовДляДобавления() Экспорт
	
	МассивТекущихРеквизитов = Новый Массив;	
	МассивРеквизитовОбъектаМетаданных = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СписокРеквизитовОбъектаМетаданных(Объект.ТипДокумента1С, "Документ");
	СписокРевизитовМетодаЗаполнить = Новый СписокЗначений;
	СписокРевизитовУказать = Новый СписокЗначений;
	
	Для каждого Алгоритм Из ДеревоРеквизитовДокУчСист.ПолучитьЭлементы() Цикл
		
		Если ЗначениеЗаполнено(Алгоритм.Реквизит) Тогда
			МассивТекущихРеквизитов.Добавить(Алгоритм.Реквизит);
		КонецЕсли;
		
		Если Алгоритм.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит") Тогда
			СписокРевизитовУказать.Добавить(Алгоритм.Реквизит);
		КонецЕсли;		
		
		Для каждого Стр Из Алгоритм.ПолучитьЭлементы() Цикл
			
			Если ЗначениеЗаполнено(Стр.Реквизит) Тогда
				
				МассивТекущихРеквизитов.Добавить(Стр.Реквизит);
				
				Если Стр.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") Тогда
					СписокРевизитовМетодаЗаполнить.Добавить(Стр.Реквизит);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	МассивРеквизитов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивРеквизитовОбъектаМетаданных, МассивТекущихРеквизитов); 
	
	СписокРеквизитов = Новый СписокЗначений();
	СписокРеквизитов.ЗагрузитьЗначения(МассивРеквизитов);
	
	Результат = Новый Структура("СписокРеквизитов, СписокРевизитовМетодаЗаполнить, СписокРевизитовУказать", 
			СписокРеквизитов, СписокРевизитовМетодаЗаполнить, СписокРевизитовУказать);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикДобавленияРеквизитаУчСист(ЗаполненныеДанные, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ЗаполненныеДанные) Тогда
		
		Если ЗаполненныеДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит")
			Или ЗаполненныеДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик") Тогда
			НоваяСтрока = ДеревоРеквизитовДокУчСист.ПолучитьЭлементы().Добавить();
		ИначеЕсли ЗаполненныеДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") Тогда
			НоваяСтрока = ПолучитьГруппуЗаполнить(ЗаполненныеДанные).ПолучитьЭлементы().Добавить();	
		КонецЕсли;
		
		НоваяСтрока.ТипАлгоритма = ЗаполненныеДанные.ТипАлгоритма;
		НоваяСтрока.Реквизит = ЗаполненныеДанные.Реквизит;
		НоваяСтрока.РеквизитТипЗначения = ЗаполненныеДанные.РеквизитТипЗначения;
		НоваяСтрока.СпособРасчета = ЗаполненныеДанные.СпособРасчета;
		НоваяСтрока.ВыражениеВычисления = ЗаполненныеДанные.ВыражениеВычисления; 
		НоваяСтрока.ВыражениеВычисленияУИД = ЗаполненныеДанные.ВыражениеВычисленияУИД;	
		НоваяСтрока.ВыражениеВычисленияТипЗначения = ЗаполненныеДанные.ВыражениеВычисленияТипЗначения;
		НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = ЗаполненныеДанные.ВыражениеВычисленияСтрокаНеогр;
		
		Элементы.ДеревоРеквизитовДокУчСист.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьГруппуЗаполнить(ЗаполненныеДанные)
	
	Для каждого Стр Из ДеревоРеквизитовДокУчСист.ПолучитьЭлементы() Цикл
		
		Если Стр.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") 
			И Не ЗначениеЗаполнено(Стр.Реквизит) Тогда
			
			Возврат Стр;
			
		КонецЕсли;
		
	КонецЦикла
	
КонецФункции

&НаКлиенте
Процедура ДеревоРеквизитовДокУчСистВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоВыбораВыраженияУчСист(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораВыраженияУчСист(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыНастройки = Новый Структура;
	
	Если Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаЗаполнениеДокУчСис" Тогда
		ТекДанные = Элементы.ДеревоРеквизитовДокУчСист.ТекущиеДанные;
		ПараметрыФормыНастройки.Вставить("Таблица", "ЗаполнениеДокУчСист");
		ПараметрыФормыНастройки.Вставить("ТипАлгоритма", ТекДанные.ТипАлгоритма);
		ПараметрыФормыНастройки.Вставить("ИмяТЧ", "");
		ПараметрыФормыНастройки.Вставить("ИмяТЧИсходногоДокумента", "");
	ИначеЕсли Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаЗаполнениеДокУчСистТЧТовары" Тогда
		ТекДанные = Элементы.ЗаполнениеДокУчСистТЧТовары.ТекущиеДанные;
		ПараметрыФормыНастройки.Вставить("Таблица", "ЗаполнениеДокУчСистТЧТовары");
		ПараметрыФормыНастройки.Вставить("ТипАлгоритма", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.ПустаяСсылка()"));
		ПараметрыФормыНастройки.Вставить("ИмяТЧ", ТекДанные.ИмяТЧ);
		ПараметрыФормыНастройки.Вставить("ИмяТЧИсходногоДокумента", Объект.ИмяТЧТоварыДокЛогистика);
	ИначеЕсли Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаЗаполнениеДокУчСистТЧПроизвольная" Тогда
		ТекДанные = Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные;
		ПараметрыФормыНастройки.Вставить("Таблица", "ЗаполнениеДокУчСистТЧПроизвольная");
		ПараметрыФормыНастройки.Вставить("ТЧИсходногоДокументаПроизвольная", ТекДанные.ПутьТЧИсходногоДокумента);
		ПараметрыФормыНастройки.Вставить("ТипАлгоритма", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.ПустаяСсылка()"));
		ПараметрыФормыНастройки.Вставить("ИмяТЧ", ТекДанные.ИмяТЧ);
		ПараметрыФормыНастройки.Вставить("ИмяТЧИсходногоДокумента", ТекДанные.ПутьТЧИсходногоДокумента);
	ИначеЕсли Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаПеременныеДокУчСист" Тогда
		ТекДанные = Элементы.ПеременныеДокУчСист.ТекущиеДанные;
		ПараметрыФормыНастройки.Вставить("Таблица", "ПеременныеДокУчСист");
		ПараметрыФормыНастройки.Вставить("ТипАлгоритма", "");
		ПараметрыФормыНастройки.Вставить("ИмяТЧ", "");
		ПараметрыФормыНастройки.Вставить("ИмяТЧИсходногоДокумента", "");
	КонецЕсли;
		
	ПараметрыФормыНастройки.Вставить("ТипДокументаУчСис", Объект.ТипДокумента1С);
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекДанные.СпособРасчета);
	
	Если Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаПеременныеДокУчСист" Тогда
		ПараметрыФормыНастройки.Вставить("Реквизит", ТекДанные.Имя);
		ПараметрыФормыНастройки.Вставить("ТипЗначения", ТекДанные.ИмяТипЗначения);	
	Иначе	
		ПараметрыФормыНастройки.Вставить("Реквизит", ТекДанные.Реквизит);
		ПараметрыФормыНастройки.Вставить("ТипЗначения", ТекДанные.РеквизитТипЗначения);
	КонецЕсли;
		
	ПараметрыФормыНастройки.Вставить("ВыбранныйТипЗначения", ТекДанные.ВыражениеВычисленияТипЗначения);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияУИД", ТекДанные.ВыражениеВычисленияУИД);   
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекДанные.ВыражениеВычисления);
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	ПараметрыФормыНастройки.Вставить("ТипДокументаЛогистика", Объект.ТипДокументаЛогистика);
	ПараметрыФормыНастройки.Вставить("ТипДокумента1С", Объект.ТипДокумента1С);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекДанные.ВыражениеВычисленияСтрокаНеогр);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертацииОбратныйМаппинг_Помощник",
		ПараметрыФормыНастройки,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикДокУчСист"
		,
		Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикДокУчСист(ЗаполненныеДанные = Неопределено, ИмяЭлемента = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ЗаполненныеДанные) Тогда
		
		Если Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаЗаполнениеДокУчСис" Тогда
			ТекДанные = Элементы.ДеревоРеквизитовДокУчСист.ТекущиеДанные;
			
		ИначеЕсли Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаЗаполнениеДокУчСистТЧТовары" Тогда
			ТекДанные = Элементы.ЗаполнениеДокУчСистТЧТовары.ТекущиеДанные;
		ИначеЕсли Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаЗаполнениеДокУчСистТЧПроизвольная" Тогда
			ТекДанные = Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные;
		ИначеЕсли Элементы.СтраницыОбратногоМаппинга.ТекущаяСтраница.Имя = "ГруппаПеременныеДокУчСист" Тогда
			ТекДанные = Элементы.ПеременныеДокУчСист.ТекущиеДанные;
			ТекДанные.ИмяТипЗначения = ЗаполненныеДанные.ВыражениеВычисленияТипЗначения;
		КонецЕсли;
			
		ТекДанные.СпособРасчета = ЗаполненныеДанные.СпособРасчета;
		ТекДанные.ВыражениеВычисления = ЗаполненныеДанные.ВыражениеВычисления;
		ТекДанные.ВыражениеВычисленияТипЗначения = ЗаполненныеДанные.ВыражениеВычисленияТипЗначения;
		ТекДанные.ВыражениеВычисленияУИД = ЗаполненныеДанные.ВыражениеВычисленияУИД;		
		ТекДанные.ВыражениеВычисленияСтрокаНеогр = ЗаполненныеДанные.ВыражениеВычисленияСтрокаНеогр;
				
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовДокУчСистВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыборВыраженияУчСист(Элемент, Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиОбратногоМаппинга()

	Элементы.СтраницаТитулУчДок.Видимость = ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) И МожноНастроитьОбратныйМаппинг();
	
	Элементы.СтраницаУчДокТитул.Видимость = Объект.НаправлениеКонвертации <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	Элементы.ЗапускатьКонвертациюПослеОбработкиВходящего.Видимость = Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее");
		
	Элементы.ИмяТЧТоварыДокЛогистика.Видимость = Не Объект.НетТЧТоварыДокЛогистика;
	
	Элементы.ГруппаТчТоварыДокУчСист.Видимость = ЗначениеЗаполнено(Объект.ИмяТЧТоварыДокУчСист);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1с()
	
	дз = Новый ДеревоЗначений;
	Для каждого РеквизитТЧ Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.ЗаполнениеДокУчСист.Реквизиты Цикл
		дз.Колонки.Добавить(РеквизитТЧ.Имя);
	КонецЦикла;
		
	МетаданныеДок = Метаданные.Документы.Найти(Объект.ТипДокумента1С);
	
	Если МетаданныеДок <> Неопределено Тогда
		
		СтрокаТипАлгоритмаЗаполнить = дз.Строки.Добавить();		
		СтрокаТипАлгоритмаЗаполнить.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
						
		СтрокаТипАлгоритма = дз.Строки.Добавить();		
		СтрокаТипАлгоритма.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик;
		
		Для каждого Рекв Из МетаданныеДок.Реквизиты Цикл
			
			СтрокаЗапись = СтрокаТипАлгоритмаЗаполнить.Строки.Добавить();
			СтрокаЗапись.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
			СтрокаЗапись.Реквизит = Рекв.Имя;
			СтрокаЗапись.РеквизитТипЗначения = Рекв.Тип;
			СтрокаЗапись.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
			
		Конеццикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(дз, "ДеревоРеквизитовДокУчСист");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция МожноНастроитьОбратныйМаппинг()

	Для каждого Тип Из Метаданные.Документы.КонтурЛогистика_ТрН_Титул1.Реквизиты.ДокументОснование.Тип.Типы() Цикл
		
		ДокМета = Метаданные.НайтиПоТипу(Тип);
		
		Если ДокМета.Имя = Объект.ТипДокумента1С Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнениеДокУчСистТЧТоварыВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоВыбораВыраженияУчСист(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДокУчСистТЧПроизвольнаяПутьТЧИсходногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ИмяИсходногоДокументаУчСист", 	Объект.ТипДокумента1С);
	ПараметрыФормы.Вставить("КакВычислитьТабЧасть", Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.ПутьТЧИсходногоДокумента);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаВыбораТЧИсходногоДокумента",
		ПараметрыФормы, 
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикВыбораТЧИсходногоДокументаОбратныйМаппинг",, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораТЧИсходногоДокументаОбратныйМаппинг(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда 
		Возврат
	КонецЕсли;	

	ПоискТакихЖеСтрок = Новый Структура("ИмяТЧ,ПутьТЧИсходногоДокумента", Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.ИмяТЧ, Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.ПутьТЧИсходногоДокумента);
	СтрокиКЗаполнениюТЧИсходного = Объект.ЗаполнениеДокУчСистТЧПроизвольная.НайтиСтроки(ПоискТакихЖеСтрок);
	
	Для Каждого СтрокаГруппы Из СтрокиКЗаполнениюТЧИсходного Цикл 
		СтрокаГруппы.ПутьТЧИсходногоДокумента = Результат;
	КонецЦикла;
	
	Модифицированность = Истина;
	
	Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ЗакончитьРедактированиеСтроки(Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДокУчСистТЧПроизвольнаяВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоВыбораВыраженияУчСист(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНастройкиРеквизитовДляОбратногоМаппинга(Команда)

	ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1с();	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНастройкиТЧТоварыДляОбратногоМаппинга(Команда)
	
	ЗаполнитьПравилаКонвертацийТЧТовары();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПравилаКонвертацийТЧТовары()
	
	Объект.ЗаполнениеДокУчСистТЧТовары.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.ТипДокумента1С) Или Не ЗначениеЗаполнено(Объект.ИмяТЧТоварыДокУчСист) Тогда
		Возврат;
	КонецЕсли;

	МетаданныеДок = Метаданные.Документы[Объект.ТипДокумента1С].ТабличныеЧасти[Объект.ИмяТЧТоварыДокУчСист];
	
	Если МетаданныеДок <> Неопределено Тогда
		
		Для каждого Рекв Из МетаданныеДок.Реквизиты Цикл
			
			НоваяСтрока = Объект.ЗаполнениеДокУчСистТЧТовары.Добавить();
			НоваяСтрока.Реквизит = Рекв.Имя;
			НоваяСтрока.ИмяТЧ = Объект.ИмяТЧТоварыДокУчСист;
			НоваяСтрока.РеквизитТипЗначения = Рекв.Тип;
			НоваяСтрока.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
			
		Конеццикла;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовДокУчСистТипАлгоритмаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоРеквизитовДокУчСист.ТекущиеДанные;
	ТекСтрока = Элементы.ДеревоРеквизитовДокУчСист.ТекущаяСтрока;
	
	ТекДанныеСтруктура = СтруктураСтрокиДереваРеквизитовДокУчСист();
	ЗаполнитьЗначенияСвойств(ТекДанныеСтруктура, ТекДанные);
	
	ТипАлгоритма = ТекДанные.ТипАлгоритма;
	ТипАлгоритмаРодителя = ?(ТекДанные.ПолучитьРодителя() = Неопределено, Неопределено, ТекДанные.ПолучитьРодителя().ТипАлгоритма);
		
	Если ТипАлгоритма <> ТипАлгоритмаРодителя Тогда 
		
		Если ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит") Тогда
			НоваяСтрока = ДеревоРеквизитовДокУчСист.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанныеСтруктура);
		КонецЕсли;
		
		Для каждого Стр Из ДеревоРеквизитовДокУчСист.ПолучитьЭлементы() Цикл
			
			Если Стр.ТипАлгоритма = ТипАлгоритма 
				И ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") 
				И Не ЗначениеЗаполнено(Стр.Реквизит) Тогда
				
				НоваяСтрока = Стр.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанныеСтруктура);
												
			КонецЕсли;
			
			Если Стр.ТипАлгоритма = ТипАлгоритмаРодителя Тогда
				
				Стр.ПолучитьЭлементы().Удалить(ДеревоРеквизитовДокУчСист.НайтиПоИдентификатору(ТекСтрока));
				
			КонецЕсли;
			
		КонецЦикла;
	
		Если Не ЗначениеЗаполнено(ТипАлгоритмаРодителя) Тогда
			ДеревоРеквизитовДокУчСист.ПолучитьЭлементы().Удалить(ДеревоРеквизитовДокУчСист.НайтиПоИдентификатору(ТекСтрока));									
		КонецЕсли;
		
		Элементы.ДеревоРеквизитовДокУчСист.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтруктураСтрокиДереваРеквизитовДокУчСист()
	
	ТекДанныеСтруктура = Новый Структура;
	Для каждого РеквизитТЧ Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.ЗаполнениеДокУчСист.Реквизиты Цикл
		ТекДанныеСтруктура.Вставить(РеквизитТЧ.Имя);
	КонецЦикла;
	
	Возврат ТекДанныеСтруктура;
	
КонецФункции

&НаКлиенте
Процедура ИмяТЧТоварыДокУчСистПриИзменении(Элемент)
	
	ЗаполнитьПравилаКонвертацийТЧТовары();
	ЗаполнитьСписокВыбораДокУчСистПроизвольнойТЧ();
	УправлениеЭлементамиОбратногоМаппинга();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДокУчСистТЧПроизвольнаяИмяТЧТитулаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.ИмяТЧ) 
		И Не ЗначениеЗаполнено(Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.ПутьТЧИсходногоДокумента)
		И Не ЗначениеЗаполнено(Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.Реквизит)
		И ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда 
		
		ИмяТЧ = Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущиеДанные.ИмяТЧ;
		ИдентификаторСтроки = Элементы.ЗаполнениеДокУчСистТЧПроизвольная.ТекущаяСтрока;
		ЗаполнитьМассивРеквизитовДокУчСистПроизвольнойТЧ(ИмяТЧ, ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМассивРеквизитовДокУчСистПроизвольнойТЧ(ИмяТЧ, ИдентификаторСтроки)
	
	РеквизитыТЧ = Метаданные.Документы[Объект.ТипДокумента1С].ТабличныеЧасти[ИмяТЧ].Реквизиты;
	
	ЗаполняемаяСтрока = Объект.ЗаполнениеДокУчСистТЧПроизвольная.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Для Каждого РеквизитТЧ Из РеквизитыТЧ Цикл
		
		Если ЗаполняемаяСтрока.Реквизит = "" Тогда 
			НоваяСтрока = ЗаполняемаяСтрока;
		Иначе
			НоваяСтрока = Объект.ЗаполнениеДокУчСистТЧПроизвольная.Добавить();
			НоваяСтрока.ИмяТЧ = ЗаполняемаяСтрока.ИмяТЧ;
		КонецЕсли;
		
		НоваяСтрока.Реквизит 				= РеквизитТЧ.Имя;
		НоваяСтрока.РеквизитТипЗначения 	= РеквизитТЧ.Тип;
		НоваяСтрока.СпособРасчета 				= Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
				
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьДеревоРеквизитовДокУчСистВТаблЧасть()
	
	Объект.ЗаполнениеДокУчСист.Очистить();
	
	дз = РеквизитФормыВЗначение("ДеревоРеквизитовДокУчСист");
	
	Для каждого Стр Из дз.Строки Цикл
		
		НоваяСтрока = Объект.ЗаполнениеДокУчСист.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
		Для Каждого Стр2 Из Стр.Строки Цикл
			
			НоваяСтрока = Объект.ЗаполнениеДокУчСист.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр2);
			
		КонецЦикла;
		
	КонецЦикла
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовДокУчСистТипАлгоритмаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоРеквизитовДокУчСист.ТекущиеДанные;
	
	Если (ТекДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") 
		ИЛИ ТекДанные.ТипАлгоритма = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик"))
		И ТекДанные.ПолучитьРодителя() = Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
	Конецесли;
	
	Если ТекДанные.ТипАлгоритма <> ВыбранноеЗначение Тогда
		
		СпискиРеквизитов = СписокРеквизитовДляДобавления();
		
		Если ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит") 
			И СпискиРеквизитов.СписокРевизитовУказать.НайтиПоЗначению(ТекДанные.Реквизит) <> Неопределено Тогда
			Сообщить("В указать уже есть такой реквизит");
			СтандартнаяОбработка = Ложь;
		ИначеЕсли ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить") 
			И СпискиРеквизитов.СписокРевизитовМетодаЗаполнить.НайтиПоЗначению(ТекДанные.Реквизит) <> Неопределено Тогда
			Сообщить("В методе заполнить уже есть такой реквизит");
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НетТЧТоварыДокЛогистикаПриИзменении(Элемент)
	
	УправлениеЭлементамиОбратногоМаппинга();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДокУчСистТЧТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыборВыраженияУчСист(Элемент, Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДокУчСистТЧПроизвольнаяВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыборВыраженияУчСист(Элемент, Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборВыраженияУчСист(Элемент, Поле)
	
	Если Найти(Поле.Имя, "ВыражениеВычисления") > 0
		И Элемент.ТекущиеДанные <> Неопределено
		И (ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВыражениеВычисления)
			ИЛИ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр))
		Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НачалоВыбораВыраженияУчСист(Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКонвертацию(Команда)
	
	Если Модифицированность Тогда
		Сообщить("Настройки не сохранены");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаКонвертации", Объект.Ссылка);
		
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаПроверкиКонвертации",
		ПараметрыФормы);		
	
КонецПроцедуры

&НаКлиенте
Процедура НаправлениеКонвертацииПриИзменении(Элемент)
	
	УправлениеЭлементамиОбратногоМаппинга();
	
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
	
		Если Объект.ЗаполнениеДокУчСист.Количество() = 0 Тогда
			ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1с();
		КонецЕсли;
		
		Объект.ИмяТЧТоварыДокУчСист = "";
		Объект.ИмяТЧТоварыДокУчСист = "";
		
		ЗаполнитьСписокВыбораДокУчСистПроизвольнойТЧ();
		
		ЗаполнитьСписокВыбораИмяТЧТоварыДокУчСист();
		ЗаполнитьСписокВыбораИмяТЧТоварыДокЛогистика();
		
		Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее")
			И ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда
			ПроверитьРекизитыПуть();
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьЗаголовокТипДокумента1С();
	
	Объект.Сценарий = "";
	
	ЗаполнитьСценарии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеременныеДокУчСистВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоВыбораВыраженияУчСист(Элемент);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОбратныйМаппинг(НаправлениеКонвертации)
	
	Если НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее")
		ИЛИ НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее")
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПроверитьВозможностьЗаписиНастройки(Отказ)
	
	ЕстьПрямойМаппинг = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
		|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
		|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ОбратныйМаппинг
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", Объект.ТипДокументаЛогистика);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ЕстьПрямойМаппинг = Истина;
	КонецЕсли;
	
	ЕстьОбратныйМаппинг = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
		|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ОбратныйМаппинг
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", Объект.ТипДокументаЛогистика);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ЕстьОбратныйМаппинг = Истина;
	КонецЕсли;
	
	
	Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее") Тогда 
		
		Если ЕстьОбратныйМаппинг Тогда
			Сообщить("Уже есть настройка для данного титула с обратным маппингом");
			Отказ = Истина;
		КонецЕсли;
		
	Иначе
		
		Если ЕстьПрямойМаппинг Или ЕстьОбратныйМаппинг Тогда
			Сообщить("Уже есть настройка для данного титула");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокТипДокумента1С()
	
	Если Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
		Элементы.ТипДокумента1С.Заголовок = "По док. учетной системы";	
	ИначеЕсли Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
		Элементы.ТипДокумента1С.Заголовок = "В док. учетной системы";
	ИначеЕсли Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее Тогда
		Элементы.ТипДокумента1С.Заголовок = "Док. учетной системы";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПроведение()
	
	МетаданныеТипДокумента1С = Метаданные.НайтиПоПолномуИмени("Документ." + Объект.ТипДокумента1С);
	Если МетаданныеТипДокумента1С <> Неопределено Тогда
		Если МетаданныеТипДокумента1С.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			Элементы.ПроводитьДокУчСис.Доступность = Истина;
		Иначе
			Элементы.ПроводитьДокУчСис.Доступность = Ложь;
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСценарии()
	
	УправлениеСценарием();
	
	Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее") Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Сценарий) Тогда
			Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.Отправка");
		КонецЕсли;
		
		Объект.СценарийПоУмолчанию = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе");
		
	ИначеЕсли Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее") Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Сценарий) Тогда
			Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.Загрузка");
		КонецЕсли;
		
		Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаНеОбрабатывать") Тогда
			Объект.СценарийПоУмолчанию = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ПустаяСсылка");
		Иначе
			Объект.СценарийПоУмолчанию = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ОбработатьВходящий");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеСценарием()
	
	Элементы.ОбязательноБезЗамечаний.Видимость = Ложь;
	Элементы.ПодписантТекущийПользователь.Видимость = Ложь;
	Элементы.Сценарий.СписокВыбора.Очистить();
	Элементы.СценарийПоУмолчанию.СписокВыбора.Очистить();
	
	Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее") Тогда
		
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.Отправка"));
		Если Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
			Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3" )Тогда
			
			Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного"));
			Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного"));
			Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного"));
			Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного"));
			Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного"));
			
			Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного")
				Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного") Тогда
				
				Элементы.ОбязательноБезЗамечаний.Видимость = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Объект.ТипДокументаЛогистика <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда
			Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВФоне"));
			Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе"));
			Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.СоздатьЧерновик"));
		КонецЕсли;
		
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне"));
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе"));
		
		Элементы.ПодписантТекущийПользователь.Видимость = Истина;
		
	ИначеЕсли Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее") Тогда
		
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_Сценарии.Загрузка"));
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаНеОбрабатывать"));
		
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ОбработатьВходящий"));
		
	Иначе
		
		Элементы.Сценарий.Видимость = Истина;
		
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного"));
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного"));
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика"));
		Элементы.Сценарий.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного"));
		
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВФоне"));
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе"));
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне"));
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе"));
		Элементы.СценарийПоУмолчанию.СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.СоздатьЧерновик"));
		
		Если (Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
				Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3"))
			И (Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного")
				Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного")
				Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного")) Тогда
			
			Элементы.ПодписантТекущийПользователь.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.СценарийПоУмолчанию.Видимость =
		(Объект.Сценарий <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаНеОбрабатывать"));
	
КонецПроцедуры

&НаСервере
Процедура УправлениеОтображениемНаправленияКонвертации()
	
	Если Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			
		Найд = Элементы.НаправлениеКонвертации.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее);	
		Если Найд <> Неопределено Тогда
			Элементы.НаправлениеКонвертации.СписокВыбора.Удалить(Найд);
		КонецЕсли;
		
	Иначе
		
		Найд = Элементы.НаправлениеКонвертации.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее);	
		Если Найд = Неопределено Тогда
			Элементы.НаправлениеКонвертации.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее);
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	ЗаполнитьСценарии();
	
	Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного")
		Или Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного") Тогда
		
		Объект.Сценарий_ОтправлятьНеподписанный = Истина;
		Объект.Сценарий_ОтправлятьПодписанный = Истина;
	КонецЕсли;
	
	Если Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.Отправка") Тогда
		Объект.Сценарий_ОтправлятьПодписанный = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьРекизитыПуть()
	
	Если Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		И Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		И Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДокМетаданные = Метаданные.Документы.Найти(Объект.ТипДокумента1С);
	
	Если ДокМетаданные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьОрганизация) = Неопределено Тогда
		Объект.ПутьОрганизация = "";
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьКонтрагент) = Неопределено Тогда
		Объект.ПутьКонтрагент = "";
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьГрузоотправитель) = Неопределено Тогда
		Объект.ПутьГрузоотправитель = "";
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьПеревозчик) = Неопределено Тогда
		Объект.ПутьПеревозчик = "";
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьГрузополучатель) = Неопределено Тогда
		Объект.ПутьГрузополучатель = "";
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьВодитель) = Неопределено Тогда
		Объект.ПутьВодитель = "";
	КонецЕсли;
	
	Если ДокМетаданные.Реквизиты.Найти(Объект.ПутьТранспортноеСредство) = Неопределено Тогда
		Объект.ПутьТранспортноеСредство = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ТаблицаСоответствий

&НаКлиенте
Процедура ТаблицаСоответствийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОтбораТаблицыСоответствий = ТекущееОписаниеОтбораТаблицыСоответствий();
	
	ТекущиеДанные = Элементы[ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаЗначения = ИмяРеквизитаЗначенияПоОписаниеОтбора(ОписаниеОтбораТаблицыСоответствий, ТекущиеДанные);
	
	Элемент.ТекущиеДанные.ИмяТабличнойЧасти = ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти;
	Элемент.ТекущиеДанные.ИмяРеквизитаЗначения = ИмяРеквизитаЗначения;
	Элемент.ТекущиеДанные.НужнаяСтрока = Истина;
	Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокТаблицыСоответствий()
	
	// Определим имя табличной части и реквизита
	ОписаниеОтбораТаблицыСоответствий = ТекущееОписаниеОтбораТаблицыСоответствий();
	
	Если ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти = Неопределено Тогда
		Элементы.ГруппаТаблицаСоответствий.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы[ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ГруппаТаблицаСоответствий.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	КонвертироватьПоТаблицеСоответствийЗначение = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьПоТаблицеСоответствий");
	
	Если ТекущиеДанные.СпособКонвертацииЗначения = КонвертироватьПоТаблицеСоответствийЗначение Тогда
		
		ИмяРеквизитаЗначения = ИмяРеквизитаЗначенияПоОписаниеОтбора(ОписаниеОтбораТаблицыСоответствий, ТекущиеДанные);
		
		Если ЗначениеЗаполнено(ИмяРеквизитаЗначения) Тогда
			
			Для Каждого ТекущаяСтрока Из Объект.ТаблицаСоответствий Цикл
				ТекущаяСтрока.НужнаяСтрока = (ТекущаяСтрока.ИмяТабличнойЧасти = ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти
					И ТекущаяСтрока.ИмяРеквизитаЗначения = ИмяРеквизитаЗначения);
			КонецЦикла;
			
			Элементы.ТаблицаСоответствий.ОтборСтрок = Новый ФиксированнаяСтруктура("НужнаяСтрока", Истина);
			Элементы.ГруппаТаблицаСоответствий.Видимость = Истина;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Скрываем, если нет необходимости
	Элементы.ГруппаТаблицаСоответствий.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьБлокировкуЯчейкиВыражениеВычисления(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	СпособМаппингаАвтоматически = (Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_СпособыМаппингаПоля.Автоматически"));
	
	Элементы[Элемент.Имя + "ВыражениеВычисления"].ТолькоПросмотр = СпособМаппингаАвтоматически;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяРеквизитаЗначенияПоОписаниеОтбора(ОписаниеОтбораТаблицыСоответствий, ТекущиеДанные)
	
	Если Найти(ОписаниеОтбораТаблицыСоответствий.ИмяРеквизита, ".") > 0 Тогда
		ЧастиПути = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(
			ОписаниеОтбораТаблицыСоответствий.ИмяРеквизита, ".", Ложь);
		
		ЗначениеИмяТабличнойЧасти = ТекущиеДанные[ЧастиПути[0]];
		ЗначениеИмяРеквизита = ТекущиеДанные[ЧастиПути[1]];
		
		ИмяРеквизитаЗначения = Строка(ЗначениеИмяТабличнойЧасти) + "_" + Строка(ЗначениеИмяРеквизита);
	Иначе
		ИмяРеквизитаЗначения = ТекущиеДанные[ОписаниеОтбораТаблицыСоответствий.ИмяРеквизита];
	КонецЕсли;
	
	Возврат ИмяРеквизитаЗначения;
	
КонецФункции

&НаКлиенте
Функция ТекущееОписаниеОтбораТаблицыСоответствий()
	
	ОтборСоответствий = Новый Структура;
	ОтборСоответствий.Вставить("ИмяТабличнойЧасти");
	ОтборСоответствий.Вставить("ИмяРеквизита");
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПравилаКонвертацииГлавногоДокумента Тогда
		
		ОтборСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииГлавногоДокумента";
		ОтборСоответствий.ИмяРеквизита = "РеквизитТитула";
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПравилаКонвертацииТитулаРеквизиты Тогда
		
		ОтборСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииТитулаРеквизиты";
		ОтборСоответствий.ИмяРеквизита = "РеквизитТитула";
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПравилаКонвертацииТитулаТабЧастьТовары Тогда
		
		ОтборСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииТитулаТабЧастьТовары";
		ОтборСоответствий.ИмяРеквизита = "РеквизитТитула";
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ПрочиеТабЧасти Тогда
		
		ОтборСоответствий.ИмяТабличнойЧасти = "ПравилаКонвертацииТитулаТабЧастьПроизвольная";
		ОтборСоответствий.ИмяРеквизита = "ИмяТЧТитула.РеквизитТитула";
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтранцаПеременные Тогда
		
		ОтборСоответствий.ИмяТабличнойЧасти = "Переменные";
		ОтборСоответствий.ИмяРеквизита = "ИмяТабЧасти.Имя";
		
	Иначе
		
		ОтборСоответствий.ИмяТабличнойЧасти = Неопределено;
		
	КонецЕсли;
	
	Возврат ОтборСоответствий;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
	УстановитьБлокировкуЯчейкиВыражениеВычисления(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииСпособКонвертацииЗначенияПриИзменении(Элемент)
	
	ИмяТабличнойЧасти = СтрЗаменить(Элемент.Имя, "СпособКонвертацииЗначения", "");
	
	ТекущиеДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ИмяТабличнойЧасти <> "Переменные"
		И Найти(ТекущиеДанные.РеквизитТитула, "МассивСтруктур") = 0
		И ТекущиеДанные.СпособКонвертацииЗначения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьМассивСтруктур") Тогда
		
		Сообщить("Нельзя использовать способ конвертации ""Массив структур"" для текущего реквизита");
		ТекущиеДанные.СпособКонвертацииЗначения = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыКонвертации.БезДопОбработки");
	КонецЕсли;
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДляПрочих(Команда)
	
	ОписаниеОтбораТаблицыСоответствий = ТекущееОписаниеОтбораТаблицыСоответствий();
	
	ТекДанные = Элементы[ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти].ТекущиеДанные;
		
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаЗначения = ИмяРеквизитаЗначенияПоОписаниеОтбора(ОписаниеОтбораТаблицыСоответствий, ТекДанные);
	
	Отбор = Новый Структура("ИмяРеквизитаЗначения, ИзвлеченноеЗначение, ИмяТабличнойЧасти", 
		ТекДанные.РеквизитТитула, "<в остальных случаях>", ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти);  
	Если Объект.ТаблицаСоответствий.НайтиСтроки(Отбор).Количество() = 0 Тогда
		НоваяСтрока = Объект.ТаблицаСоответствий.Добавить();
		НоваяСтрока.ИмяТабличнойЧасти = ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти;
		НоваяСтрока.ИмяРеквизитаЗначения = ИмяРеквизитаЗначения;
		НоваяСтрока.ИзвлеченноеЗначение = "<в остальных случаях>";
		НоваяСтрока.СпособМаппинга = ТекДанные.СпособМаппинга;
	КонецЕсли;
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
	Элементы.ТаблицаСоответствий.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ОписаниеОтбораТаблицыСоответствий = ТекущееОписаниеОтбораТаблицыСоответствий();
	
	ТекДанные = Элементы[ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ТекДанныеТаблицаСоответствий = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Или ТекДанныеТаблицаСоответствий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаЗначения = ИмяРеквизитаЗначенияПоОписаниеОтбора(ОписаниеОтбораТаблицыСоответствий, ТекДанные);
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ИмяРеквизитаЗначения", ИмяРеквизитаЗначения);
	ОтборСтрок.Вставить("ИзвлеченноеЗначение", ТекДанныеТаблицаСоответствий.ИзвлеченноеЗначение);
	ОтборСтрок.Вставить("ИмяТабличнойЧасти", ОписаниеОтбораТаблицыСоответствий.ИмяТабличнойЧасти);
	
	Если Объект.ТаблицаСоответствий.НайтиСтроки(ОтборСтрок).Количество() > 1
		И Не ОтменаРедактирования Тогда
		
		Сообщить("Такое извлеченное значение уже есть");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#Область ЗаполнениеДополнений

&НаСервере
Процедура УправлениеОтображениемЗаполнениемДляДополнений()
	
	СтруктураДляПоиска = Новый Структура("ТипНастройки, ТипДокументаЛогистика, ТипДокумента1С", 
		"НКД", Объект.ТипДокументаЛогистика, Объект.ТипДокумента1С);
	
	Элементы.ФормаЗаполнитьДополнениеКТ2000.Видимость = 
		КонтурЛогистика_ОбщегоНазначенияСервер.ПоказатьКомандуЗаполненияДополнения("КТ2000", СтруктураДляПоиска);
	Элементы.ФормаЗаполнитьДополнениеВуИзРСФЛ.Видимость = 
		КонтурЛогистика_ОбщегоНазначенияСервер.ПоказатьКомандуЗаполненияДополнения("ВуИзРСФЛ", СтруктураДляПоиска);
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДополнениеКТ2000(Команда)
	ЗаполнитьДополнение("КТ2000", "КТ-2000");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнение(ИмяДополнения, ПредставлениеДополнения)
	
	ТаблицаПравил = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьТаблицуНастроекКонвертацииДокументововПоУмолчанию(
		Объект.ТипДокументаЛогистика, Объект.ТипДокумента1С, Ложь, "ЗначенияПоУмолчаниюДляДополнений", ИмяДополнения);
	Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ЗаполнитьПравилаКонвертации(Объект, Ложь, ТаблицаПравил);
	
	Сообщить("Реквизиты для " + ПредставлениеДополнения + " заполнены");													
		
	ТаблицаНастроек = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ТаблицаНастроекКонвертацииСправочников(,,,,
		"ЗначенияПоУмолчаниюДляДополнений", ИмяДополнения);
	
	ВариантыНастроек = ТаблицаНастроек.Скопировать(,
		"ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
	ВариантыНастроек.Свернуть("ТипСправочникаЛогистика, ТипСправочникаИлиДокументаУС, ТипДокументаОснования, РеквизитТитула");
	
	Если Не ЗначениеЗаполнено(ВариантыНастроек) Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ВариантНастройки Из ВариантыНастроек Цикл
		
		НКС = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкуКонвертации(
			ВариантНастройки.ТипСправочникаИлиДокументаУС, ВариантНастройки.ТипСправочникаЛогистика, ВариантНастройки.РеквизитТитула);
		
		Если ЗначениеЗаполнено(НКС) Тогда
			НКСОбъект = НКС.ПолучитьОбъект();
		Иначе
			НКСОбъект = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.СоздатьЭлемент();
			НКСОбъект.ТипСправочникаИлиДокументаУС = ВариантНастройки.ТипСправочникаИлиДокументаУС;
			НКСОбъект.ТипСправочникаЛогистика = ВариантНастройки.ТипСправочникаЛогистика;
			НКСОбъект.Наименование = Строка(НКСОбъект.ТипСправочникаИлиДокументаУС) + " в " + Строка(НКСОбъект.ТипСправочникаЛогистика);
			Если ЗначениеЗаполнено(ВариантНастройки.РеквизитТитула) Тогда
				НКСОбъект.РеквизитТитула = Перечисления.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников[
					ВариантНастройки.РеквизитТитула];
				НКСОбъект.Наименование = НКСОбъект.Наименование + " (" + Строка(ВариантНастройки.РеквизитТитула) + ")";
			КонецЕсли;
			НКСОбъект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			
			Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ЗаполнитьПравилаКонвертации(
				НКСОбъект.ПравилаКонвертации, НКСОбъект.ТипСправочникаЛогистика, НКСОбъект.ТипСправочникаИлиДокументаУС,
				НКСОбъект.ТипДокументаОснования, НКСОбъект.РеквизитТитула);
		КонецЕсли;
		
		РезультатЗаполнения = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ЗаполнитьТекущуюНастройкуЗначениямиПоУмолчанию(
			НКСОбъект, "ЗначенияПоУмолчаниюДляДополнений", ИмяДополнения, Ложь);
		
		Если РезультатЗаполнения.Успешно Тогда
			НКСОбъект.Записать();
			Сообщить("В НКС " + НКСОбъект.Наименование + " реквизиты для " + ПредставлениеДополнения + " заполнены");
		Иначе
			Сообщить(РезультатЗаполнения.ОписаниеОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьНКСДополнением(НКСОбъект, ИмяДополнения)
	
	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ЗаполнитьТекущуюНастройкуЗначениямиПоУмолчанию(
		НКСОбъект, "ЗначенияПоУмолчаниюДляДополнений", ИмяДополнения, Ложь);
		
КонецФункции

#КонецОбласти

&НаСервере
Функция ЕстьЗначенияСвойствОбъектов()
	
	ОбъектМетаданных = Метаданные.РегистрыСведений.Найти("ЗначенияСвойствОбъектов");
	
	Если ОбъектМетаданных <> Неопределено Тогда		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЕстьДоговорыКонтрагентов()
	
	ОбъектМетаданных = Метаданные.Справочники.Найти("ДоговорыКонтрагентов");
	
	Если ОбъектМетаданных <> Неопределено Тогда		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ПроверитьДоговорыКонтрагентов()
	
	ЕстьДоговорыКонтрагентов = ЕстьДоговорыКонтрагентов();
	
	Если ЕстьДоговорыКонтрагентов Тогда
		
		Позиция = Элементы.ПравилаКонвертацииГлавногоДокументаСпособМаппинга.СписокВыбора.Количество() - 1;
		Элементы.ПравилаКонвертацииГлавногоДокументаСпособМаппинга.СписокВыбора.Вставить(Позиция, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов);
		
		Позиция = Элементы.ПравилаКонвертацииТитулаРеквизитыСпособМаппинга.СписокВыбора.Количество() - 1;
		Элементы.ПравилаКонвертацииТитулаРеквизитыСпособМаппинга.СписокВыбора.Вставить(Позиция, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов);
		
		Позиция = Элементы.ПеременныеСпособМаппинга.СписокВыбора.Количество() - 1;
		Элементы.ПеременныеСпособМаппинга.СписокВыбора.Вставить(Позиция, Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпособМаппингаРеквизитов()
	
	Элементы.ПравилаКонвертацииГлавногоДокументаСпособМаппинга.СписокВыбора.ЗагрузитьЗначения(ЗначенияМаппинга());
	Элементы.ПравилаКонвертацииТитулаРеквизитыСпособМаппинга.СписокВыбора.ЗагрузитьЗначения(ЗначенияМаппинга());
	Элементы.ПравилаКонвертацииТитулаТабЧастьТоварыСпособМаппинга.СписокВыбора.ЗагрузитьЗначения(ЗначенияМаппинга(Истина));
	Элементы.ПеременныеСпособМаппинга.СписокВыбора.ЗагрузитьЗначения(ЗначенияМаппинга(, Истина));
	
КонецПроцедуры

&НаСервере
Функция ЗначенияМаппинга(ДляТабЧастиТовары = Ложь, ДляПеременных = Ложь)
	
	ЗначенияМаппинга = Новый Массив;
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение);
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначениеОбщейНастройки);
	Если Не ДляТабЧастиТовары Или (ДляТабЧастиТовары И Не Объект.ТоварыИзДополнительногоДокумента) Тогда
		ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Родитель) И Не ДляПеременных Тогда
		Если Не ДляТабЧастиТовары Или (ДляТабЧастиТовары И Объект.ТоварыИзДополнительногоДокумента) Тогда
			ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента);
		КонецЕсли;
		ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзРодительскойНастройки);
	КонецЕсли;
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула);
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула);
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение);
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопСвойство);
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопРеквизит);
	Если ЕстьЗначенияСвойствОбъектов() Тогда
		ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначенияСвойствОбъектов);
	КонецЕсли;
	ЗначенияМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять);
	
	Возврат ЗначенияМаппинга;
	
КонецФункции

