&НаКлиенте
Процедура ДокУчСистКонвертироватьПоНастройкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяТабличнойЧасти = СтрЗаменить(Элемент.Имя, "КонвертироватьПоНастройке", "");
		
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	ЗначениеОтбора = Новый Структура("НаправлениеКонвертации", НаправлениеКонвертации); 
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	ПараметрыОбработчика = Новый Структура("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"КонвертироватьПоНастройкеНачалоВыбораЗавершение", ПараметрыОбработчика, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовДокУчСистВыражениеВычисленияСтрокаНеогрНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоВыбораВыраженияУчСист(Элемент);

КонецПроцедуры

&НаСервере
Процедура ОбновитьПоискОснованийКодНа1С(БезПроверки = Ложь)
	
	ИспользуютсяМногиеКОдному = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользуютсяМногиеКОдному");
	Если (Не ЗначениеЗаполнено(Объект.Ссылка) 
		И ИспользуютсяМногиеКОдному
		И Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И ЗначениеЗаполнено(Объект.ТипДокумента1С)
		И Не ЗначениеЗаполнено(Объект.ПоискОснованийКодНа1С))
		Или БезПроверки Тогда
		Объект.ПоискОснованийКодНа1С = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПоискОснованийКодНа1СПоУсолчанию(Объект.ТипДокумента1С);		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьШаблонПоискОснованийКодНа1СНажатие(Элемент)
	
	ОбновитьПоискОснованийКодНа1С(Истина);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыИзДополнительногоДокументаПриИзменении(Элемент)
	
	РеквизитДокументаОснования = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования");
	РеквизитДополнительногоДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента");
	
	Для Каждого ТекущаяСтрока Из Объект.ПравилаКонвертацииТитулаТабЧастьТовары Цикл
		Если Объект.ТоварыИзДополнительногоДокумента И ТекущаяСтрока.СпособМаппинга = РеквизитДокументаОснования Тогда
			ТекущаяСтрока.СпособМаппинга = РеквизитДополнительногоДокумента;
		КонецЕсли;
		
		Если Не Объект.ТоварыИзДополнительногоДокумента И ТекущаяСтрока.СпособМаппинга = РеквизитДополнительногоДокумента Тогда
			ТекущаяСтрока.СпособМаппинга = РеквизитДокументаОснования;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ПравилаКонвертацииТитулаТабЧастьТоварыСпособМаппинга.СписокВыбора.ЗагрузитьЗначения(ЗначенияМаппинга(Истина));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныеВалидацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДействиеПриОтказеВалидации) Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.ТекущиеДанные.ДействиеПриОтказеВалидации = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_ДействияПриОтказеВалидации.ЗапретПодписания");
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииТитулаТабЧастьПроизвольнаяВыражениеВычисленияДобавлятьСтрокуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	ТекДанные = Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормыНастройки = Новый Структура;
	
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", "ОтказДобавленияСтроки");
	
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекДанные.СпособМаппингаДобавлятьСтроку);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекДанные.ВыражениеВычисленияДобавлятьСтроку);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления2", "");
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекДанные.ВыражениеВычисленияСтрокаНеогрДобавлятьСтроку);
	ПараметрыФормыНастройки.Вставить("КлючДопСвойстваРеквизита", "");
	ПараметрыФормыНастройки.Вставить("НетТабЧастиТовары", Истина);
	ПараметрыФормыНастройки.Вставить("ЕстьЗначенияСвойствОбъектов", Ложь);
	ПараметрыФормыНастройки.Вставить("ЕстьДоговорыКонтрагентов", Ложь);
	ПараметрыФормыНастройки.Вставить("СвойствоОбъекта", "");
	
	Если Элемент.Имя = "ПравилаКонвертацииТитулаТабЧастьПроизвольнаяВыражениеВычисленияДобавлятьСтроку" 
		И ЗначениеЗаполнено(ТекДанные.ИмяТЧТитула) 
		И Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаСодержитТолькоЦифры(ТекДанные.ИмяТЧТитула) Тогда 
		
		ПараметрыФормыНастройки.Вставить("ПутьПроизвольнаяТабЧасть", ТекДанные.ПутьТЧИсходногоДокумента);
		
	КонецЕсли;
			
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник",
		ПараметрыФормыНастройки,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикРедактированиеДобавлятьСтрокуВДопФорме",
		Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикРедактированиеДобавлятьСтрокуВДопФорме(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяТЧТитула", ТекДанные.ИмяТЧТитула);
	Отбор.Вставить("ПутьТЧИсходногоДокумента", ТекДанные.ПутьТЧИсходногоДокумента);
	Строки = Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.НайтиСтроки(Отбор);
	Для каждого Стр Из Строки Цикл
		Стр.СпособМаппингаДобавлятьСтроку 					= ВыбранноеЗначение.СпособМаппинга;
		Стр.ВыражениеВычисленияДобавлятьСтроку 				= ВыбранноеЗначение.ВыражениеВычисления;
		Стр.ВыражениеВычисленияСтрокаНеогрДобавлятьСтроку 	= ВыбранноеЗначение.ВыражениеВычисленияСтрокаНеогр;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииТитулаТабЧастьПроизвольнаяСпособМаппингаДобавлятьСтрокуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольная.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено 
		Или ТекущиеДанные.СпособМаппингаДобавлятьСтроку <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять") Тогда
		Возврат;	
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяТЧТитула", ТекущиеДанные.ИмяТЧТитула);
	Отбор.Вставить("ПутьТЧИсходногоДокумента", ТекущиеДанные.ПутьТЧИсходногоДокумента);
	Строки = Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.НайтиСтроки(Отбор);
	Для каждого Стр Из Строки Цикл
		Стр.СпособМаппингаДобавлятьСтроку = ТекущиеДанные.СпособМаппингаДобавлятьСтроку;				
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДополнениеВуИзРСФЛ(Команда)
	ЗаполнитьДополнение("ВуИзРСФЛ", "Данные ВУ из РС ФЛ");
КонецПроцедуры

#Область ДополнительныеКолонки

&НаКлиенте
Процедура ОбновитьОтображениеДополнительныхКолонок()
	
	Элементы.ГруппаДопКолонки.Заголовок = "Дополнительные колонки";
	Если Объект.ДополнительныеКолонки.Количество() <> 0 Тогда
		Элементы.ГруппаДопКолонки.Заголовок = Элементы.ГруппаДопКолонки.Заголовок
			+ " (" + Объект.ДополнительныеКолонки.Количество() + ")";
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеКолонкиПриИзменении(Элемент)
	
	ОбновитьОтображениеДополнительныхКолонок();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеКолонкиПутьКДаннымПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДополнительныеКолонки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьПутьКДаннымДполнительнойКолонки(ТекДанные);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеКолонкиПутьКДаннымНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДополнительныеКолонки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ДобавленИзКонструктораЗапроса Тогда
		Сообщить("Для изменения пути к данным перейдите в конструктор запроса");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаКонвертации", Объект.Ссылка);
			
	Если Найти(СокрЛП(ТекДанные.ПутьКДанным), " ") > 0 Тогда
		ПараметрыФормы.Вставить("ПроизвольноеВыражение", ТекДанные.ПутьКДанным);		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаВыбораПоляЗапроса", ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ПослеВыбораПоляЗапроса");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПоляЗапроса(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт 
	
	ТекДанные = Элементы.ДополнительныеКолонки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Или ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ПутьКДанным = ВыбранноеЗначение;
	
	ПроверитьПутьКДаннымДполнительнойКолонки(ТекДанные);
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПутьКДаннымДполнительнойКолонки(ТекущиеДанные)
	
	Попытка
			
		Результат = ПолучитьТипДополнительнойКолонки(ТекущиеДанные.НомерСтроки, ТекущиеДанные.ПутьКДанным);
		ТекущиеДанные.Тип = Результат.Тип;
		ТекущиеДанные.СтрокаНеограниченнойДлины = Результат.СтрокаНеограниченнойДлины;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Тип) Тогда
			Объект.ДополнительныеКолонки.НайтиПоИдентификатору(Элементы.ДополнительныеКолонки.ТекущаяСтрока).Картинка = 1;
		Иначе
			Объект.ДополнительныеКолонки.НайтиПоИдентификатору(Элементы.ДополнительныеКолонки.ТекущаяСтрока).Картинка = 0;
		КонецЕсли;		 
		
	Исключение
		
		Объект.ДополнительныеКолонки.НайтиПоИдентификатору(Элементы.ДополнительныеКолонки.ТекущаяСтрока).Картинка = 0;
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));	
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипДополнительнойКолонки(НомерСтроки, ПутьКДанным)
	
	Результат = Новый Структура;
	Результат.Вставить("Тип");
	Результат.Вставить("СтрокаНеограниченнойДлины", Ложь);
	
	ТекстЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(Объект.ТипДокументаЛогистика, Объект.ТипДокумента1С,,,, Ложь);
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса.ПолныйТекстЗапроса);
	
	ОператорЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
	
	ИмяКолонки = "Доп" + Формат(НомерСтроки, "ЧГ=0");
	
	ДопКолонка = СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(ИмяКолонки);
	Если ДопКолонка = Неопределено Тогда
		
		НовоеПоле = ОператорЗапроса.ВыбираемыеПоля.Добавить(ПутьКДанным);
				
		ДопКолонка = СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(НовоеПоле);
		Если ДопКолонка <> Неопределено Тогда
			ДопКолонка.Псевдоним = ИмяКолонки;	
		КонецЕсли;
		
	Иначе
		
		Индекс = ОператорЗапроса.ВыбираемыеПоля.Индекс(ДопКолонка.Поля[0]);
		ВыражениеСхемыЗапроса = Новый ВыражениеСхемыЗапроса(ПутьКДанным);
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Установить(Индекс, ВыражениеСхемыЗапроса);
		
	КонецЕсли;
	
	Результат.Тип = КонтурЛогистика_ОбщегоНазначенияСервер.СтроковоеПредставлениеОписаниеТипов_(ДопКолонка.ТипЗначения);
	
	Если ДопКолонка.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Если ДопКолонка.ТипЗначения.КвалификаторыСтроки.Длина = 0 Тогда
			Результат.СтрокаНеограниченнойДлины = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

&НаСервере
Процедура ПроверитьДополнительныеКолонки()
	
	Для каждого ДопКолонка Из Объект.ДополнительныеКолонки Цикл
		
		Если ДопКолонка.ДобавленИзКонструктораЗапроса Тогда
			ДопКолонка.Картинка = 1;
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			Результат = ПолучитьТипДополнительнойКолонки(ДопКолонка.НомерСтроки, ДопКолонка.ПутьКДанным);
			
			Если ЗначениеЗаполнено(Результат.Тип) Тогда
				ДопКолонка.Картинка = 1;
			Иначе
				ДопКолонка.Картинка = 0;	
			КонецЕсли;		 
			
		Исключение
			
			ДопКолонка.Картинка = 0;
			
		КонецПопытки;
						
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДополнительнаяКолонкаДобавленнаяЧерезКонстукторЗапроса()
	
	Для каждого ДопКолонка Из Объект.ДополнительныеКолонки Цикл
		
		Если ДопКолонка.ДобавленИзКонструктораЗапроса Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ДополнительныеКолонкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Сообщить("Необходимо записать настройки");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

