
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДочерниеНастройкиКонвертации.Параметры.УстановитьЗначениеПараметра("ЭтаНастройкаКонвертации", Объект.Ссылка);

	Если Не ЗначениеЗаполнено(Объект.СценарийПоУмолчанию) Тогда 
		
		Объект.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
		
	КонецЕсли;
	
	Если Параметры.Свойство("ТипДокументаЛогистика") Тогда 
		Объект.ТипДокументаЛогистика = Параметры.ТипДокументаЛогистика; 
	КонецЕсли;
	Если Параметры.Свойство("ТипДокумента1С") Тогда 
		Объект.ТипДокумента1С = Параметры.ТипДокумента1С;
	КонецЕсли;
	
	ЭтоНовыйОбъект = РеквизитФормыВЗначение("Объект").ЭтоНовый();
	Если ЭтоНовыйОбъект И Не ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.Сценарий_ОтправлятьПодписанный = Истина;
		Объект.Сценарий_ОтправлятьВСеансе = Истина;
		Объект.Сценарий_ОтправлятьВФоне = Истина;
		Если ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда 
			Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ЗаполнитьПравилаКонвертации(Объект, ЭтоНовыйОбъект);
		КонецЕсли;
		Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
	КонецЕсли;
	
	// подсунуть список выбора документов 1С
	Для Каждого ДокМета Из Метаданные.Документы Цикл 
		
		Элементы.ТипДокумента1С.СписокВыбора.Добавить(ДокМета.Имя, ДокМета.Синоним, , БиблиотекаКартинок.Документ);
		Элементы.ТипДополнительногоСвязанногоДокумента.СписокВыбора.Добавить(ДокМета.Имя, ДокМета.Синоним, , БиблиотекаКартинок.Документ);
		
	КонецЦикла;
	
	ЗаполнитьСпискиВыбораРеквизитовДокумента();
	ЗаполнитьСпособМаппингаРеквизитов();
	ЗаполнитьСписокВыбораПроизвольнойТЧ();
	СформироватьРеквизитыДокументов();
	СформироватьВидимостьЭлементов();
	
	// привет, обратная совместимость с 8.2
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда 
		Элементы.ТипДокумента1С.КнопкаСпискаВыбора = Истина;
		Элементы.ТипДополнительногоСвязанногоДокумента.КнопкаСпискаВыбора = Истина;
		
		МассивИменЭлементовСоСпискомВыбораРеквизита = МассивИменЭлементовСоСпискомВыбораРеквизита();
		Для Каждого текЭлемент Из МассивИменЭлементовСоСпискомВыбораРеквизита Цикл 
			Элементы[текЭлемент].КнопкаСпискаВыбора = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.Родитель) Тогда
		Объект.Код = "";
	КонецЕсли;
	
	ТекНастройкаСопоставленияТоваровТ3 = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("Т3СпособСопоставленияТоваров");
	
	ЗаполнитьДеревоРеквизитовДокУчСист();
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) И Метаданные.Документы.Найти(Объект.ТипДокумента1С) <> Неопределено Тогда
		ЗаполнитьСписокВыбораИмяТЧТоварыДокУчСист();
		ЗаполнитьСписокВыбораИмяТЧТоварыДокЛогистика();
		ЗаполнитьСписокВыбораДокУчСистПроизвольнойТЧ();
	КонецЕсли;
	
	ЭтоНовыйОбъект = РеквизитФормыВЗначение("Объект").ЭтоНовый();
	Если ЭтоНовыйОбъект Тогда
		ОбновитьЗаголовокТипДокумента1С();
		Объект.Сценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_Сценарии.Отправка");
	КонецЕсли;
	
	ПроверитьПроведение();
	
	УправлениеОтображениемНаправленияКонвертации();
	
	УправлениеОтображениемЗаполнениемДляДополнений();
	
	ПроверитьДоговорыКонтрагентов();
		
	ПроверитьДополнительныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтоНовый = Объект.Ссылка.Пустая();
	Если ЭтоНовый И ЗначениеЗаполнено(Объект.Родитель) И Не ЕстьВозможностьСоздаватьДочерние(Объект.Родитель) Тогда
		Закрыть();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		Элементы.ГруппаДопКолонки.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьРеквизитовРазделителя();
	Если Параметры.Свойство("ТипДокументаЛогистика") Тогда
		УстановитьЗаголовок();
	КонецЕсли;
	УстановитьВидимостьСтраницыТабчастьТовары();
	УстановитьДоступностьЭлементов();
	УстановитьВидимостьГруппыРазделителей();
	УстановитьВидимостьДопУсловийСворачивания();
	УправлениеВидимостьюВариантовПоиска();
	УправлениеЭлементамиОбратногоМаппинга();
	
	Если ЭтоНовый Тогда
		УстановитьЗаголовок();
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		Элементы.ЗаполнениеДокУчСистТЧПроизвольнаяИмяТЧТитула.КнопкаСпискаВыбора = Истина;
	КонецЕсли;
	
	УправлениеСценарием();
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
	ОбновитьОтображениеДополнительныхКолонок();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораРеквизитовДокумента()

	МассивИменЭлементовСоСпискомВыбораРеквизита = МассивИменЭлементовСоСпискомВыбораРеквизита();
	
	Для Каждого ИмяЭлементаФормы Из МассивИменЭлементовСоСпискомВыбораРеквизита Цикл 
		Элементы[ИмяЭлементаФормы].СписокВыбора.Очистить();
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.ТипДокумента1С) И Метаданные.Документы.Найти(Объект.ТипДокумента1С) <> Неопределено Тогда 
		
		Для Каждого Реквизит Из Метаданные.Документы[Объект.ТипДокумента1С].Реквизиты Цикл
			Для Каждого ИмяЭлементаФормы Из МассивИменЭлементовСоСпискомВыбораРеквизита Цикл 
				Элементы[ИмяЭлементаФормы].СписокВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним, , БиблиотекаКартинок.Реквизит);
			КонецЦикла;
		КонецЦикла;
		Для Каждого Реквизит Из Метаданные.Документы[Объект.ТипДокумента1С].СтандартныеРеквизиты Цикл
			Для Каждого ИмяЭлементаФормы Из МассивИменЭлементовСоСпискомВыбораРеквизита Цикл 
				Элементы[ИмяЭлементаФормы].СписокВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним, , БиблиотекаКартинок.Реквизит);
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	// Добавим по возможности реквизиты дополнительных источников
	Если ЗначениеЗаполнено(Объект.ДополнительныеИсточники) Тогда
		ИменаДополнительныхТаблиц = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ИменаДополнительныхТаблиц(Объект.Ссылка);
		Для Каждого ТекущееИмяТаблицы Из ИменаДополнительныхТаблиц Цикл
			Попытка
				Для Каждого Реквизит Из Метаданные.Документы[ТекущееИмяТаблицы].Реквизиты Цикл
					Для Каждого ИмяЭлементаФормы Из МассивИменЭлементовСоСпискомВыбораРеквизита Цикл 
						Элементы[ИмяЭлементаФормы].СписокВыбора.Добавить(ТекущееИмяТаблицы + "." + Реквизит.Имя,
							Реквизит.Синоним + " (" + ТекущееИмяТаблицы + ")", , БиблиотекаКартинок.Реквизит);
					КонецЦикла;
				КонецЦикла;
			Исключение
				НичегоНеДелаем = Истина;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда
		
		// Заполним список выбора для реквизитов главного документа
		Элементы.ПравилаКонвертацииГлавногоДокументаРеквизитТитула.СписокВыбора.Очистить();
		ИмяГлавногоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяГлавногоДокументаКонтурЛогистика(
			Объект.ТипДокументаЛогистика);
		Если ЗначениеЗаполнено(ИмяГлавногоДокумента) Тогда
			
			МетаданныеДокумента = Метаданные.Документы["КонтурЛогистика_" + ИмяГлавногоДокумента];
			Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
				Элементы.ПравилаКонвертацииГлавногоДокументаРеквизитТитула.СписокВыбора.Добавить(
					Реквизит.Имя, Реквизит.Синоним,, БиблиотекаКартинок.Реквизит);
			КонецЦикла;
			
			УдалитьПовторныеЭлементыСпискаВыбора(
				Элементы.ПравилаКонвертацииГлавногоДокументаРеквизитТитула.СписокВыбора,
				"ПравилаКонвертацииГлавногоДокумента");
			
		КонецЕсли;
		
		// Заполним список выбора для реквизитов титула
		Элементы.ПравилаКонвертацииТитулаРеквизитыРеквизитТитула.СписокВыбора.Очистить();
		ИмяДокумента = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика);
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			
			МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
			Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
				Элементы.ПравилаКонвертацииТитулаРеквизитыРеквизитТитула.СписокВыбора.Добавить(
					Реквизит.Имя, Реквизит.Синоним,, БиблиотекаКартинок.Реквизит);
			КонецЦикла;
			
			УдалитьПовторныеЭлементыСпискаВыбора(
				Элементы.ПравилаКонвертацииТитулаРеквизитыРеквизитТитула.СписокВыбора,
				"ПравилаКонвертацииТитулаРеквизиты");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПовторныеЭлементыСпискаВыбора(СписокВыбора, ИмяТаблицы)
	
	МассивУд = Новый Массив;
	
	Для Каждого Строка Из Объект[ИмяТаблицы] Цикл
		
		НайденныйЭлемент = СписокВыбора.НайтиПоЗначению(Строка.РеквизитТитула);
		
		Если Не НайденныйЭлемент = Неопределено Тогда
			МассивУд.Добавить(НайденныйЭлемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из МассивУд Цикл
		
		Попытка
			СписокВыбора.Удалить(ЭлементСписка);
		Исключение
			НичегоНеДелаем = Истина;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПроизвольнойТЧ()

	Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольнаяИмяТЧТитула.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда 
		
		ИмяДок = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика);
		
		Для Каждого текТЧ Из Метаданные.Документы["КонтурЛогистика_" + ИмяДок].ТабличныеЧасти Цикл
			
			Если текТЧ.Имя = "Товары" Тогда 
				Продолжить;
			КонецЕсли;
			
			Элементы.ПравилаКонвертацииТитулаТабЧастьПроизвольнаяИмяТЧТитула.СписокВыбора.Добавить(текТЧ.Имя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МассивИменЭлементовСоСпискомВыбораРеквизита()
	
	Перем МассивИменЭлементовСоСпискомВыбораРеквизита;
	
	МассивИменЭлементовСоСпискомВыбораРеквизита = Новый Массив;
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьОрганизация");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьКонтрагент");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьГрузоотправитель");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьПеревозчик");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьГрузополучатель");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьДоп1");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьДоп2");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьМестоПогрузки");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьМестоДоставки");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьНомерТРН");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьДатаТРН");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьВодитель");
	МассивИменЭлементовСоСпискомВыбораРеквизита.Добавить("ПутьТранспортноеСредство");
	Возврат МассивИменЭлементовСоСпискомВыбораРеквизита;

КонецФункции

&НаСервере
Процедура ТипДокумента1СПриИзмененииНаСервере()
	
	ЗаполнитьСпискиВыбораРеквизитовДокумента();
	ЗаполнитьСписокВыбораПроизвольнойТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДокумента1СПриИзменении(Элемент)
	
	ТипДокумента1СПриИзмененииНаСервере();
	УстановитьЗаголовок();
	ОбработатьИзменениеКлючевыхТипов();
	
	Если Не ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда				
		Объект.СоздаватьДокУчСис = Ложь;
	Иначе
		
		Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
			
			Объект.ИмяТЧТоварыДокУчСист = "";
			
			ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1с();	
			ЗаполнитьСписокВыбораДокУчСистПроизвольнойТЧ();			
			ЗаполнитьСписокВыбораИмяТЧТоварыДокУчСист();
			
			Объект.ЗаполнениеДокУчСистТЧТовары.Очистить();
			Объект.ЗаполнениеДокУчСистТЧПроизвольная.Очистить();
			
			Если Объект.НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее")
				И ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда
				ПроверитьРекизитыПуть();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	УправлениеЭлементамиОбратногоМаппинга();
	
	Объект.ПроводитьДокУчСис = Ложь;
	
	ПроверитьПроведение();
	
	УправлениеОтображениемЗаполнениемДляДополнений();
	
	ОбновитьПоискОснованийКодНа1С();
	
	УстановитьВидимостьСтраницыТабчастьТовары();
			
КонецПроцедуры

&НаКлиенте
Процедура ТипДокументаЛогистикаПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовСпецСценария();
	УстановитьЗаголовок();
	ОбработатьИзменениеКлючевыхТипов(Истина);
	УстановитьДоступностьЭлементов();
	УстановитьВидимостьГруппыРазделителей();
	УправлениеОтображениемНаправленияКонвертации();
	УправлениеОтображениемЗаполнениемДляДополнений();
	ЗаполнитьСпискиВыбораРеквизитовДокумента();
	ОбновитьПоискОснованийКодНа1С();
	
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
	
		Если Объект.ЗаполнениеДокУчСист.Количество() = 0 Тогда
			ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1с();
		КонецЕсли;
		
		Объект.ИмяТЧТоварыДокЛогистика = "";
		
		ЗаполнитьСписокВыбораДокУчСистПроизвольнойТЧ();
		
		ЗаполнитьСписокВыбораИмяТЧТоварыДокЛогистика();
		
	КонецЕсли;
	
	Если Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка")
		И (Объект.СценарийПоУмолчанию <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе")
			Или Объект.СценарийПоУмолчанию <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВФоне")) Тогда
		
		Объект.СценарийПоУмолчанию = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе");
	КонецЕсли;
	
	УправлениеСценарием();
	
	Объект.ДополнительныеКолонки.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДополнительногоСвязанногоДокументаПриИзменении(Элемент)
	
	УстановитьЗаголовок();
	ОбработатьИзменениеКлючевыхТипов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовок()
	
	Попытка
		
		Если ЗначениеЗаполнено(Объект.ТипДокумента1С) Тогда
			Объект.Наименование = "" + Объект.ТипДокументаЛогистика + " по " + Объект.ТипДокумента1С;
		ИначеЕсли Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
			Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
			Или Объект.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02") Тогда 
			Объект.Наименование = "" + Объект.ТипДокументаЛогистика + " ввод вручную";
		Иначе
			Объект.Наименование = "" + Объект.ТипДокументаЛогистика + " по предыдущему титулу";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ТипДополнительногоСвязанногоДокумента) И ЗначениеЗаполнено(Объект.Родитель) Тогда
			Объект.Наименование = "" + Объект.ТипДополнительногоСвязанногоДокумента + " - " + Объект.Наименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.СпецСценарий) Тогда
			Объект.Наименование = Объект.Наименование + ", " + НРег(Объект.СпецСценарий);
		КонецЕсли;
		
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьВидимостьЭлементов()
	
	ЭтоТитул1 = Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	ЭтоТитул1ПЛ = Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
	ЭтоТитул1ПЛ_5_02 = Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
	
	Элементы.ДекорацияПутьОрганизация.Видимость = ЭтоТитул1;
	Элементы.ДекорацияПутьПеревозчик.Видимость = ЭтоТитул1;
	Элементы.ГруппаНастройки.Видимость = ЗначениеЗаполнено(Объект.ТипДокументаЛогистика);
	
	Элементы.ПутьПеревозчик.КнопкаВыбора 			= ЭтоТитул1;
	Элементы.ПутьПеревозчик.КнопкаВыпадающегоСписка = Не ЭтоТитул1;
			
	ЭтоТитул1Или8 = Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8;
		
	Элементы.ДекорацияПримерУсловияТ1.Видимость = ЭтоТитул1Или8;
	Элементы.ДекорацияПримерУсловияТ2.Видимость = Не ЭтоТитул1Или8;
	
	Элементы.ГруппаПравилаКонвертацииГлавногоДокумента.Видимость = 
		Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
		ИЛИ Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 
		ИЛИ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(Объект.ТипДокументаЛогистика) 
		ИЛИ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(Объект.ТипДокументаЛогистика);
		
		
	Элементы.ГруппаОсновные.Видимость = ЗначениеЗаполнено(Объект.ТипДокумента1С);
	Элементы.ГруппаПрочее.Видимость = Не Элементы.ГруппаОсновные.Видимость;
	Элементы.ГруппаПоискОснованийКодНа1С.Видимость = (ЭтоТитул1 И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") = Истина)
													Или (ЭтоТитул1ПЛ И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдномуЭПЛ") = Истина);
													
	Элементы.ДекорацияПримерУсловияТРН.Видимость = (ЭтоТитул1 И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") = Истина);
	Элементы.ДекорацияПримерУсловияПЛ.Видимость = (ЭтоТитул1ПЛ И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдномуЭПЛ") = Истина);
	
	ЭтоЭкспедиторскаяРасписка = (Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка);
	
	Элементы.ПутьГрузоотправитель.Видимость = Не ЭтоЭкспедиторскаяРасписка И Не ЭтоТитул1ПЛ_5_02;
	Элементы.ПутьГрузополучатель.Видимость = Не ЭтоЭкспедиторскаяРасписка И Не ЭтоТитул1ПЛ;
	Элементы.ПутьМестоПогрузки.Видимость = Не ЭтоЭкспедиторскаяРасписка И Не ЭтоТитул1ПЛ;
	Элементы.ПутьМестоДоставки.Видимость = Не ЭтоЭкспедиторскаяРасписка И Не ЭтоТитул1ПЛ;
	Элементы.ПутьНомерТРН.Видимость = Не ЭтоЭкспедиторскаяРасписка;
	Элементы.ПутьДатаТРН.Видимость = Не ЭтоЭкспедиторскаяРасписка;
	Элементы.ПутьВодитель.Видимость = Не ЭтоЭкспедиторскаяРасписка;
	Элементы.ПутьТранспортноеСредство.Видимость = Не ЭтоЭкспедиторскаяРасписка;
	
	Если ЭтоЭкспедиторскаяРасписка Тогда
		Элементы.ПутьОрганизация.Заголовок = "Грузоотправитель";
		Элементы.ПутьПеревозчик.Заголовок = "Экспедитор";
		Элементы.ПутьКонтрагент.Заголовок = "Клиент";
	Иначе
		Элементы.ПутьОрганизация.Заголовок = "Организация";
		Элементы.ПутьПеревозчик.Заголовок = "Перевозчик";
		Элементы.ПутьКонтрагент.Заголовок = "Контрагент";
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Объект.Родитель) Тогда
		Элементы.ГруппаПутиИдентификации.Видимость = ЭтоТитул1Или8;
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеКлючевыхТипов(ОчищатьПравилаКонкертации = Ложь)
	
	// переопределить списки выбора в реквизитах маппинга
	// если там стало несовместимо - очистить
	
	// СформироватьРеквизитыГлавногоДокумента();
	
	// сформируем допустимые главные реквизиты
	СформироватьРеквизитыДокументов(ОчищатьПравилаКонкертации);
	СформироватьВидимостьЭлементов();

КонецПроцедуры

&НаСервере
Процедура СформироватьРеквизитыДокументов(ОчищатьПравилаКонкертации = Ложь)
	
	Если не ЗначениеЗаполнено(Объект.ТипДокументаЛогистика) Тогда 
		Возврат;
	КонецЕсли;
	
	// Табчасть Товары только для 1 и 3 титула
	Если Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ДФ_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		ЕстьТовары = Истина;
	Иначе
		ЕстьТовары = Ложь;
	КонецЕсли;
	
	НастройкаКонвертацииОбъект = РеквизитФормыВЗначение("Объект");
	БылаМодификация = Ложь;
	
	Если ОчищатьПравилаКонкертации Тогда
		НастройкаКонвертацииОбъект.ПравилаКонвертацииГлавногоДокумента.Очистить();
		НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаРеквизиты.Очистить();
		НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаТабЧастьТовары.Очистить();
	КонецЕсли;
	
	ТЗРеквизитыГлавногоДокумента = РеквизитФормыВЗначение("РеквизитыГлавногоДокумента");
	ТЗРеквизитыГлавногоДокумента.Очистить();
	// ревизиты главного только для ТрН т1 , СВ и ЗН
	Если Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(Объект.ТипДокументаЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(Объект.ТипДокументаЛогистика) Тогда
		
		СформироватьРеквизитыДокументаКонтурЛогистика(
			БылаМодификация,
			ТЗРеквизитыГлавногоДокумента,
			НастройкаКонвертацииОбъект.ПравилаКонвертацииГлавногоДокумента,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяГлавногоДокументаКонтурЛогистика(Объект.ТипДокументаЛогистика));
			
	КонецЕсли;
	
	ТЗРеквизитыТитула = РеквизитФормыВЗначение("РеквизитыТитула");
	ТЗРеквизитыТитула.Очистить();
	СформироватьРеквизитыДокументаКонтурЛогистика(
		БылаМодификация,
		ТЗРеквизитыТитула,
		НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаРеквизиты,
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика));
	
	Если ЕстьТовары Тогда 
		ТЗРеквизитыТабЧастиТовары = РеквизитФормыВЗначение("РеквизитыТабЧастиТовары");
		ТЗРеквизитыТабЧастиТовары.Очистить();
		СформироватьРеквизитыДокументаКонтурЛогистика(
			БылаМодификация,
			ТЗРеквизитыТабЧастиТовары,
			НастройкаКонвертацииОбъект.ПравилаКонвертацииТитулаТабЧастьТовары,
			"ТЧ" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаЛогистика));
	КонецЕсли;
		
	Если БылаМодификация Тогда
		ЗначениеВРеквизитФормы(ТЗРеквизитыГлавногоДокумента,"РеквизитыГлавногоДокумента");
		ЗначениеВРеквизитФормы(ТЗРеквизитыТитула,			"РеквизитыТитула");
		Если ЕстьТовары Тогда 
			ЗначениеВРеквизитФормы(ТЗРеквизитыТабЧастиТовары,	"РеквизитыТабЧастиТовары");
		КонецЕсли;
		ЗначениеВРеквизитФормы(НастройкаКонвертацииОбъект,	"Объект");
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	Элементы.ГруппаПравилаКонвертацииТитулаТабЧастьТовары.Видимость = ЕстьТовары;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьРеквизитыДокументаКонтурЛогистика(БылаМодификация, РеквизитыТаблицаЗначений, ТабличнаяЧастьНастройки, Знач ИмяДокЛогистика)
	
	Перем НайденнаяСтрокаОписания, НоваяСтрока, НужныйИндексКартинки, Реквизит, МетаданыеРеквизитов, СтрокаТЧ, СтрокаТЗ;
	
	Если ИмяДокЛогистика = "" Тогда
		Возврат; // у некоторых документов нет главного, например у заказ-заявки
	КонецЕсли;
	
	Если Лев(ИмяДокЛогистика,2) = "ТЧ" Тогда
		ЭтоТЧ = Истина;
		ИмяДокЛогистика = Сред(ИмяДокЛогистика, 3);
		
		Если ИмяДокЛогистика = "ТрН_Титул3" Тогда // в Т3 товары документа основанияч в дургой ТЧ
			МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].ТабличныеЧасти.ТоварыДокументаУчетнойСистемы.Реквизиты;
		Иначе
			МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].ТабличныеЧасти.Товары.Реквизиты;
		КонецЕсли;
		
	Иначе
		ЭтоТЧ = Ложь;
		МетаданыеРеквизитов = Метаданные.Документы["КонтурЛогистика_" + ИмяДокЛогистика].Реквизиты;
	КонецЕсли;
	
	Если ЭтоТЧ Тогда 
		МассивОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивОбязательныхРеквизитовТЧ();
	Иначе
		МассивОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивОбязательныхРеквизитов();
	КонецЕсли;
	Если ЭтоТЧ Тогда 
		МассивУсловноОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивУсловноОбязательныхРеквизитовТЧ();
	Иначе
		МассивУсловноОбязательныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивУсловноОбязательныхРеквизитов();
	КонецЕсли;	
	
	КлючевыеРеквизитыСАвтоматическимЗаполнением = Документы["КонтурЛогистика_" + ИмяДокЛогистика].КлючевыеРеквизитыСАвтоматическимЗаполнением();
	
	// реквизиты из метаданных
	Для Каждого Реквизит Из МетаданыеРеквизитов Цикл
		
		// реквизиты связи с предыдущими титулами и прочие ключевые, которые программа сама знает как заполнять
		Если КлючевыеРеквизитыСАвтоматическимЗаполнением.Найти(Реквизит.Имя) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		// реквизиты - исключения, которые не требуется заполнять в настройке конвертации - их заполнение регламентируется самим докумнетом
		Если Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ЭтоРеквизитИсключение(Реквизит.Имя) Тогда 
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуТЗОписанияРеквизитов(МассивОбязательныхРеквизитов, Реквизит, РеквизитыТаблицаЗначений, МассивУсловноОбязательныхРеквизитов);
		
	КонецЦикла;
	
	Если ЭтоТЧ Тогда 
		ТаблицаДополнительныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивДополнительныхРеквизитовТЧ();
	Иначе
		ТаблицаДополнительныхРеквизитов = Документы["КонтурЛогистика_" + ИмяДокЛогистика].МассивДополнительныхРеквизитов();
	КонецЕсли;
	Для Каждого Реквизит Из ТаблицаДополнительныхРеквизитов Цикл
		ДобавитьСтрокуТЗОписанияРеквизитов(МассивОбязательныхРеквизитов, Реквизит, РеквизитыТаблицаЗначений, МассивУсловноОбязательныхРеквизитов);
	КонецЦикла;
	
	// манипуляции с ТЧ
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧастьНастройки Цикл 
		
		НайденнаяСтрокаОписания = РеквизитыТаблицаЗначений.Найти(СтрокаТЧ.РеквизитТитула, "Имя");
		Если НайденнаяСтрокаОписания = Неопределено Тогда 
			НужныйИндексКартинки = 0;
		Иначе
			НужныйИндексКартинки = НайденнаяСтрокаОписания.Картинка;
		КонецЕсли;
		
		Если СтрокаТЧ.Картинка <> НужныйИндексКартинки Тогда
			СтрокаТЧ.Картинка = НужныйИндексКартинки;
			БылаМодификация = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	// добавим недостающие значения из ТЗ
	Для Каждого СтрокаТЗ Из РеквизитыТаблицаЗначений Цикл 
		
		Если ТабличнаяЧастьНастройки.Найти(СтрокаТЗ.Имя, "РеквизитТитула") = Неопределено Тогда
			
			НоваяСтрока = ТабличнаяЧастьНастройки.Добавить();
			НоваяСтрока.РеквизитТитула = СтрокаТЗ.Имя;
			НоваяСтрока.РеквизитТитулаТипЗначения = СтрокаТЗ.ТипЗначения;
			НоваяСтрока.РеквизитТитулаКомментарий = СтрокаТЗ.Комментарий;
			НоваяСтрока.Картинка = СтрокаТЗ.Картинка;
			Если НоваяСтрока.Картинка = 3 ИЛИ НоваяСтрока.Картинка = 2 Тогда
				НоваяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять;
			ИначеЕсли РеквизитИмеетДефолтныйАлгоритмЗаполнения(НоваяСтрока.РеквизитТитула) Тогда
				НоваяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.Автоматически;
			Иначе
				НоваяСтрока.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования;
			КонецЕсли;
			НоваяСтрока.ВыражениеВычисления = "";
			
			Если ЗначениеЗаполнено(СтрокаТЗ.СпособКонвертацииПоУмолчанию) Тогда 
				НоваяСтрока.СпособКонвертацииЗначения = СтрокаТЗ.СпособКонвертацииПоУмолчанию;
			Иначе
				НоваяСтрока.СпособКонвертацииЗначения = Перечисления.КонтурЛогистика_СпособыКонвертации.БезДопОбработки;
			КонецЕсли;
			БылаМодификация = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	Если БылаМодификация Тогда
		ТабличнаяЧастьНастройки.Сортировать("Картинка Возр, РеквизитТитула");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РеквизитИмеетДефолтныйАлгоритмЗаполнения(ИмяРеквизита)

	Если ИмяРеквизита = "ПользовательПодписант"
		Или ИмяРеквизита = "ДатВрПрМО"
		Или ИмяРеквизита = "ДатВрКонтТехСост"
		Или ИмяРеквизита = "ДатВрВыпНаЛин"
		Или ИмяРеквизита = "ДатВрОдометр"
		Или ИмяРеквизита = "ЭтоЭкспедиция"
		Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	Если (ИмяРеквизита = "НомерТрН" Или ИмяРеквизита = "ДатаТрН")
		И Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(Объект.ТипДокументаЛогистика)
		И Объект.ТипДокументаЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
		Возврат Истина;
	КонецЕсли;
		
	Если ИмяРеквизита = "Водитель"
		
		И (Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или Объект.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6) Тогда 
		Возврат Истина;
		
	КонецЕсли;
		
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуТЗОписанияРеквизитов(Знач МассивОбязательныхРеквизитов, Знач Реквизит, РеквизитыТаблицаЗначений, Знач МассивУсловноОбязательныхРеквизитов)
	
	Перем НоваяСтрокаТЗ;
	
	НоваяСтрокаТЗ = РеквизитыТаблицаЗначений.Добавить();
	НоваяСтрокаТЗ.Имя = Реквизит.Имя;
	НоваяСтрокаТЗ.Синоним = Реквизит.Синоним;
	Если МассивОбязательныхРеквизитов.Найти(Реквизит.Имя) <> Неопределено Тогда 
		НоваяСтрокаТЗ.Картинка = 1;
	ИначеЕсли МассивУсловноОбязательныхРеквизитов.Найти(Реквизит.Имя) <> Неопределено Тогда 
		НоваяСтрокаТЗ.Картинка = 2;
	Иначе
		НоваяСтрокаТЗ.Картинка = 3;
	КонецЕсли;
	НоваяСтрокаТЗ.ТипЗначения = Реквизит.Тип;
	НоваяСтрокаТЗ.Комментарий = Реквизит.Комментарий;
	
	Попытка
		
		Если ТипЗнч(Реквизит.Тип) <> Тип("Строка") Тогда // отсеим придуманные псевдо типы 
			
			Если Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Договоры") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ПодразделенияДиадок") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПодразделениеДиадок;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ПунктыМаршрута") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ТранспортныеСредства") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_Лицензии") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВЛицензию;
			ИначеЕсли Реквизит.Тип.Типы()[0] = Тип("СправочникСсылка.КонтурЛогистика_ГорючеСмазочныеМатериалы") Тогда 
				НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВГорючеСмазочныйМатериал;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		НоваяСтрокаТЗ.СпособКонвертацииПоУмолчанию = Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство;
		
	КонецПопытки;
	
КонецПроцедуры

