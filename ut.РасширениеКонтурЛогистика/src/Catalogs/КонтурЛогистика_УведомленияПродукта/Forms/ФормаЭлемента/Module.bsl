
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоПросмотр = Истина;
	
	Если Объект.ИменаФорм.Количество() <> 0 Тогда
		Элементы.СтраницаИмяФормы.Заголовок = Элементы.СтраницаИмяФормы.Заголовок
			+ " (" + Формат(Объект.ИменаФорм.Количество(), "ЧГ=0") + ")";
	КонецЕсли;
	
	Если Найти(Объект.Текст, "<html") = 0 Тогда
		ТекстHTML = КонтурЛогистика_ОбновлениеСервер.ОбернутьТекстУведомленияВHTML(Объект.Текст);
	Иначе
		ТекстHTML = Объект.Текст;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти