#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокВыбораПутьККонтрагенту();
	
	ОбновитьСписокВыбораРеквизитаДокусентаОснования();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НайденныйЭлемент = Элементы.КонвертироватьИзДокумента.СписокВыбора.НайтиПоИдентификатору(0);
	НайденныйЭлемент.Представление = Строка(Объект.ТипДокументаОсновной);
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Не Объект.ПоискПодчиненного И Не Объект.ВводитьНаОсновании Тогда
		Сообщить("Необходимо выбрать хотя бы одно из действий (поиск, ввод на основании)");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипДокументаОсновнойПриИзменении(Элемент)
	
	ЗаполнитьСписокВыбораПутьККонтрагенту();
	
	Объект.ОтборПутьККонтрагенту = "";
	
	НайденныйЭлемент = Элементы.КонвертироватьИзДокумента.СписокВыбора.НайтиПоИдентификатору(0);
	НайденныйЭлемент.Представление = Строка(Объект.ТипДокументаОсновной);
	
	Если ЗначениеЗаполнено(Объект.ТипДокументаОсновной) Тогда
		ОбновитьСписокВыбораРеквизитаДокусентаОснования();
	КонецЕсли;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКонвертацииПодчиненногоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТипДокумента1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(Объект.ТипДокументаОсновной);
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТипДокументаЛогистика", Объект.ТипДокументаПодчиненный);
	Отбор.Вставить("ТипДокумента1С", ТипДокумента1С);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ФормаВыбора", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"НастройкиКонвертацииПодчиненногоНачалоВыбораЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКонвертацииПодчиненногоНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.НастройкиКонвертацииПодчиненного = Результат;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПутьККонтрагентуПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКонтрагентыПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискПодчиненногоПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ВводитьНаОснованииПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискаПодчиненногоВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстРедактирования = СтрЗаменить(Объект.ПоискаПодчиненногоВыражениеВычисления, "¶", Символы.ПС);
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		ТекстРедактирования, Объект, "ПоискаПодчиненногоВыражениеВычисления",,, "ДокументОсновной");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(Объект.ОтборВыражениеВычисления,
	                                                                            Объект,
																				"ОтборВыражениеВычисления",,, "ДокументОсновной");
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьИзДокументаПриИзменении(Элемент)
	
	Объект.РасчетОснованияЗаполнения_Расчитывать = (КонвертироватьИзДокумента = 1);
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьИзДокумента1ПриИзменении(Элемент)
	
	Объект.РасчетОснованияЗаполнения_Расчитывать = (КонвертироватьИзДокумента = 1);
	
	Если Объект.РасчетОснованияЗаполнения_Расчитывать И Не ЗначениеЗаполнено(Объект.РасчетОснованияЗаполнения_СпособМаппинга) Тогда
		Объект.РасчетОснованияЗаполнения_СпособМаппинга =
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования");
	КонецЕсли;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетОснованияЗаполнения_СпособМаппингаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.РасчетОснованияЗаполнения_СпособМаппинга) Тогда
		Объект.РасчетОснованияЗаполнения_СпособМаппинга =
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ТипДокументаОсновной) Тогда
		ОбновитьСписокВыбораРеквизитаДокусентаОснования();
	КонецЕсли;
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбораРеквизитаДокусентаОснования()
	
	Если Не ЗначениеЗаполнено(Объект.ТипДокументаОсновной) Тогда
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.СписокВыбора.ЗагрузитьЗначения(Новый Массив);
		Возврат;
	КонецЕсли;
	
	СпособРеквизитДокументаОснования = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования");
	Если Не ЗначениеЗаполнено(Объект.РасчетОснованияЗаполнения_СпособМаппинга) Тогда
		Объект.РасчетОснованияЗаполнения_СпособМаппинга = СпособРеквизитДокументаОснования;
	КонецЕсли;
	
	Если Объект.РасчетОснованияЗаполнения_СпособМаппинга = СпособРеквизитДокументаОснования Тогда
		
		ИмяДокумента = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаОсновной);
		
		ИменаРеквизитов = Новый Массив;
		Для Каждого ТекущийРеквизит Из Метаданные.Документы[ИмяДокумента].Реквизиты Цикл
			ИменаРеквизитов.Добавить(ТекущийРеквизит.Имя);
		КонецЦикла;
		
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.СписокВыбора.ЗагрузитьЗначения(ИменаРеквизитов);
		
	Иначе
		
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.СписокВыбора.ЗагрузитьЗначения(Новый Массив);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетОснованияЗаполнения_ВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.РасчетОснованияЗаполнения_СпособМаппинга =
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекстРедактирования = СтрЗаменить(Объект.РасчетОснованияЗаполнения_ВыражениеВычисления, "¶", Символы.ПС);
		
		КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
			ТекстРедактирования, Объект, "РасчетОснованияЗаполнения_ВыражениеВычисления");
	КонецЕсли;
	
КонецПроцедуры

