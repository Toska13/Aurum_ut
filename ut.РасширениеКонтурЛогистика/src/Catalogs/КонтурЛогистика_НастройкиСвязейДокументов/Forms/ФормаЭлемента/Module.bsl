#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	
	Элементы.ОтборКонтрагентыПредупреждение.Видимость =
		(Объект.ОтборКонтрагенты.Количество() <> 0 И Не ЗначениеЗаполнено(Объект.ОтборПутьККонтрагенту));
	
	Элементы.ПоискаПодчиненногоВыражениеВычисления.Видимость = Объект.ПоискПодчиненного;
	Элементы.ГруппаВводНаОснованииЭтап1.Видимость = Объект.ВводитьНаОсновании;
	Элементы.ГруппаВводНаОснованииЭтап2.Видимость = Объект.ВводитьНаОсновании;
	
	Если Объект.РасчетОснованияЗаполнения_Расчитывать Тогда
		КонвертироватьИзДокумента = 1;
		Элементы.ГруппаВводНаОснованииЭтап2.Доступность = Истина;
	Иначе
		КонвертироватьИзДокумента = 0;
		Элементы.ГруппаВводНаОснованииЭтап2.Доступность = Ложь;
	КонецЕсли;
	
	Элементы.РасчетОснованияЗаполнения_СпособМаппинга.Доступность = Объект.РасчетОснованияЗаполнения_Расчитывать;
	Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.Доступность = Объект.РасчетОснованияЗаполнения_Расчитывать;
	
	МаппингВычислитьВыражение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение");
	Если Объект.РасчетОснованияЗаполнения_СпособМаппинга = МаппингВычислитьВыражение Тогда
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.КнопкаВыпадающегоСписка = Неопределено;
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.КнопкаВыбора = Истина;
	Иначе
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.КнопкаВыпадающегоСписка = Истина;
		Элементы.РасчетОснованияЗаполнения_ВыражениеВычисления.КнопкаВыбора = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПутьККонтрагенту()
	
	ЗначенияПутейККонтрагенту = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ТипДокументаОсновной) Тогда
		
		// Из главного документа
		ИмяГлавного = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяОсновногоДокументаДляТипаЛогистики(Объект.ТипДокументаОсновной);
		Если ЗначениеЗаполнено(ИмяГлавного) Тогда
			ИмяГлавногоДокумента = "КонтурЛогистика_" + ИмяГлавного;
			ИмяРеквизитаГлавного = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ИмяРеквизитаГлавногооДокумента(Объект.ТипДокументаОсновной);
			ДополнитьЗначенияПутейККонтрагенту(ЗначенияПутейККонтрагенту, ИмяГлавногоДокумента, ИмяРеквизитаГлавного);
		КонецЕсли;
		
		// Из основного документа
		ИмяТекущего = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(Объект.ТипДокументаОсновной);
		ИмяТекущегоДокумента = "КонтурЛогистика_" + ИмяТекущего;
		ДополнитьЗначенияПутейККонтрагенту(ЗначенияПутейККонтрагенту, ИмяТекущегоДокумента, "");
	
	КонецЕсли;
	
	Элементы.ОтборПутьККонтрагенту.СписокВыбора.ЗагрузитьЗначения(ЗначенияПутейККонтрагенту);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнитьЗначенияПутейККонтрагенту(ЗначенияПутейККонтрагенту, ИмяДокумента, ИмяРеквизитаГлавного)
	
	ТипКонтрагента = Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок");
	
	Для Каждого ТекущийРеквизит Из Метаданные.Документы[ИмяДокумента].Реквизиты Цикл
		Если ТекущийРеквизит.Тип <> ТипКонтрагента Тогда
			Продолжить;
		КонецЕсли;
		
		ПутейККонтрагенту = ТекущийРеквизит.Имя;
		
		Если ЗначениеЗаполнено(ИмяРеквизитаГлавного) Тогда
			ПутейККонтрагенту = ИмяРеквизитаГлавного + "." + ПутейККонтрагенту;
		КонецЕсли;
		
		ЗначенияПутейККонтрагенту.Добавить(ПутейККонтрагенту);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти