
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипРесурса = "Документ";
	ЗаполнитьСписокВыбораИмяРесурса();
	ЗаполнитьСписокВыбораСпособМаппинга();
	
	ТипыДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных();
	Для Каждого ТекущийТипДанных Из ТипыДанных Цикл
		Элементы.ОтборТипДанных.СписокВыбора.Добавить(ТекущийТипДанных.Значение, ТекущийТипДанных.Значение);
	КонецЦикла;
	Если ТипыДанных.Количество() = 1 Тогда
		Элементы.ОтборТипДанных.Видимость = Ложь;
		Если Не ЗначениеЗаполнено(Объект.ОтборТипДанных) Тогда
			Объект.ОтборТипДанных = Элементы.ОтборТипДанных.СписокВыбора[0].Значение;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьЗначенияСвойствОбъектов = ЕстьРегистрСведений("ЗначенияСвойствОбъектов");
	
	ТриггерСтатусДО.ЗагрузитьЗначения(Объект.ТриггерСтатусыДО.Выгрузить().ВыгрузитьКолонку("СтатусДО"));
	
	Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ЗаполнитьПравилаКонвертации(Объект);
	
	ЗаполнитьДеревоРеквизитовДокУчСист();
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации)
		И Метаданные.Документы.Найти(Объект.ИмяРесурса) <> Неопределено Тогда
		
		ЗаполнитьСписокВыбораИмяТабличнойЧастиЗаполнения();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ИмяТабличнойЧастиЗаполнения) Тогда
		ЗаполнитьРеквизитыТЧЗаполнениеДокУчСистТЧ();
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	// Обратная совместимость с 8.2
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		Элементы.ИмяРесурса.КнопкаСпискаВыбора = Истина;
		Элементы.ОтборТипДанных.КнопкаСпискаВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьПараметрыРеквизитовОтбора();
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.ТриггерСтатусыДО.Очистить();
	Для Каждого ТекущаяСтрока Из ТриггерСтатусДО Цикл
		НоваяСтрока = ТекущийОбъект.ТриггерСтатусыДО.Добавить();
		НоваяСтрока.СтатусДО = ТекущаяСтрока.Значение;
	КонецЦикла;
	
	Если ЭтоОбратныйМаппинг(ТекущийОбъект.НаправлениеКонвертации) Тогда
		
		ТекущийОбъект.ЗаполнениеДокУчСист.Очистить();
		
		ДеревоЗначений = РеквизитФормыВЗначение("ДеревоРеквизитовДокУчСист");
		Для каждого ТекущаяСтрока Из ДеревоЗначений.Строки Цикл
			
			НоваяСтрока = ТекущийОбъект.ЗаполнениеДокУчСист.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			
			Для Каждого ТекущаяПодстрока Из ТекущаяСтрока.Строки Цикл
				НоваяСтрока = ТекущийОбъект.ЗаполнениеДокУчСист.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяПодстрока);
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаправлениеКонвертацииПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипРесурсаПриИзменении(Элемент)
	
	ЗаполнитьСписокВыбораИмяРесурса();
	
	Объект.ИмяРесурса = "";
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРесурсаПриИзменении(Элемент)
	
	Если ЭтоОбратныйМаппинг(Объект.НаправлениеКонвертации) Тогда
		
		Объект.ИмяТабличнойЧастиЗаполнения = "";
		
		ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1C();
		ЗаполнитьСписокВыбораИмяТабличнойЧастиЗаполнения();
		
		Объект.ЗаполнениеДокУчСистТЧ.Очистить();
		Объект.ПеременныеДокУчСист.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяТабличнойЧастиЗаполненияПриИзменении(Элемент)
	
	Объект.ЗаполнениеДокУчСистТЧ.Очистить();
	
	ЗаполнитьРеквизитыТЧЗаполнениеДокУчСистТЧ();
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискУчетногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстРедактирования = СтрЗаменить(Элементы.ПоискУчетногоДокумента.ТекстРедактирования, "¶", Символы.ПС);
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		Элементы.ПоискУчетногоДокумента.ТекстРедактирования, Объект, "ПоискУчетногоДокумента",,, "Объект");
	
КонецПроцедуры

