Процедура ОбновитьВидимостьДоступность()
	
	Элементы.ИмяРесурса.Доступность = ЗначениеЗаполнено(ТипРесурса);
	
	Если Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
		
		Элементы.ГруппаНастройкиПоНаправлениям.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.СтраницаНаправлениеИсходящее.Видимость = Истина;
		Элементы.СтраницаНаправлениеВходящие.Видимость = Ложь;
		
	ИначеЕсли Объект.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
		
		Элементы.ГруппаНастройкиПоНаправлениям.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.СтраницаНаправлениеИсходящее.Видимость = Ложь;
		Элементы.СтраницаНаправлениеВходящие.Видимость = Истина;
		
	Иначе
		
		Элементы.ГруппаНастройкиПоНаправлениям.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.СтраницаНаправлениеИсходящее.Видимость = Истина;
		Элементы.СтраницаНаправлениеВходящие.Видимость = Истина;
		
	КонецЕсли;
	
	Элементы.ПоискУчетногоДокумента.Видимость = Не Объект.СоздаватьДокУчСис;
	Элементы.ПоискСтрокиТабличнойЧасти.Видимость = (ЗначениеЗаполнено(Объект.ИмяТабличнойЧастиЗаполнения));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораИмяРесурса()
	
	Элементы.ИмяРесурса.СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(ТипРесурса) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипРесурса = "Справочник" Тогда
		
		Для Каждого СправочникМета Из Метаданные.Справочники Цикл
			Элементы.ИмяРесурса.СписокВыбора.Добавить(СправочникМета.Имя, СправочникМета.Синоним,, БиблиотекаКартинок.Справочник);
		КонецЦикла;
		
	Иначе
		
		Для Каждого ДокументМета Из Метаданные.Документы Цикл
			Элементы.ИмяРесурса.СписокВыбора.Добавить(ДокументМета.Имя, ДокументМета.Синоним,, БиблиотекаКартинок.Документ);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораСпособМаппинга()
	
	СпособыМаппинга = Новый Массив;
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования);
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула);
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение);
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение);
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначениеОбщейНастройки);
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопСвойство);
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ДопРеквизит);
	
	// Значения свойств объектов
	Если ЕстьЗначенияСвойствОбъектов Тогда
		СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ЗначенияСвойствОбъектов);
	КонецЕсли;
	
	СпособыМаппинга.Добавить(Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять);
	
	Элементы.ПравилаКонвертацииСпособМаппинга.СписокВыбора.ЗагрузитьЗначения(СпособыМаппинга);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокТаблицыСоответствий()
	
	ТекущиеДанные = Элементы.ПравилаКонвертации.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ГруппаТаблицаСоответствий.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	КонвертироватьПоТаблицеСоответствий = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьПоТаблицеСоответствий");
	
	Если ЗначениеЗаполнено(ТекущиеДанные.РеквизитРегистраСведений)
		И ТекущиеДанные.СпособКонвертацииЗначения = КонвертироватьПоТаблицеСоответствий Тогда
		
		ОтборСтрок = Новый ФиксированнаяСтруктура("РеквизитРегистраСведений", ТекущиеДанные.РеквизитРегистраСведений);
		ГруппаТаблицаСоответствийВидимость = Истина;
		
	Иначе
		
		ОтборСтрок = Неопределено;
		ГруппаТаблицаСоответствийВидимость = Ложь;
		
	КонецЕсли;
	
	Элементы.ТаблицаСоответствий.ОтборСтрок = ОтборСтрок;
	Элементы.ГруппаТаблицаСоответствий.Видимость = ГруппаТаблицаСоответствийВидимость;
	
КонецПроцедуры

&НаСервере
Функция ЕстьРегистрСведений(ИмяРегистраСведений)
	
	ОбъектМетаданных = Метаданные.РегистрыСведений.Найти(ИмяРегистраСведений);
	
	Если ОбъектМетаданных <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура НачалоВыбораВыраженияВычисления(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Не Записать() Тогда
			Сообщить("Не удалось записать настройку. Запишите вручную, затем переходите к настройке.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элемент.Родитель.Родитель.ТекущиеДанные;
	КонецЕсли;
	
	ПараметрыФормыНастройки = Новый Структура;
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	Если ТекущиеДанные.Свойство("РеквизитРегистраСведений") Тогда
		ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекущиеДанные.РеквизитРегистраСведений);
	Иначе
		ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекущиеДанные.Имя);
	КонецЕсли;
	
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекущиеДанные.СпособМаппинга);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекущиеДанные.ВыражениеВычисления);
	Если ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула") Тогда
		// Пока только ПЛ Т1
		ПараметрыФормыНастройки.Вставить("ВыражениеВычисления2",
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1"));
	Иначе
		ПараметрыФормыНастройки.Вставить("ВыражениеВычисления2", ТекущиеДанные.ВыражениеВычисления2);
	КонецЕсли;
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр);
	ПараметрыФормыНастройки.Вставить("КлючДопСвойстваРеквизита", ТекущиеДанные.КлючДопСвойстваРеквизита);
	ПараметрыФормыНастройки.Вставить("ЕстьЗначенияСвойствОбъектов", ЕстьЗначенияСвойствОбъектов);
	ПараметрыФормыНастройки.Вставить("СвойствоОбъекта", ТекущиеДанные.СвойствоОбъекта);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник", ПараметрыФормыНастройки,
		ЭтаФорма, ЭтаФорма, "ОбработчикРедактированиеСтрокиВДопФорме", Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьПоНастройкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяТабличнойЧасти = СтрЗаменить(Элемент.Имя, "КонвертироватьПоНастройке", "");
	
	ТекущиеДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	СпособКонвертацииЗначения = ТекущиеДанные.СпособКонвертацииЗначения;
	
	ИмяСправочника = ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее");
	
	ЗначениеОтбора = Новый Структура("ТипСправочникаЛогистика, НаправлениеКонвертации", ИмяСправочника, НаправлениеКонвертации);
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	ПараметрыОбработчика = Новый Структура("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"КонвертироватьПоНастройкеНачалоВыбораЗавершение", ПараметрыОбработчика, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения)
	
	Возврат Перечисления.КонтурЛогистика_СпособыКонвертации.ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения);
	
КонецФункции

&НаКлиенте
Процедура НачалоВыбораВыраженияВычисленияУчСис(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяТаблицы = Элемент.Родитель.Родитель.Имя;
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	ПараметрыФормыНастройки = Новый Структура;
	Если ИмяТаблицы = "ЗаполнениеДокУчСистТЧ" Тогда
		ПараметрыФормыНастройки.Вставить("ИмяТЧ", Объект.ИмяТабличнойЧастиЗаполнения);
	Иначе
		ПараметрыФормыНастройки.Вставить("ИмяТЧ", "");
	КонецЕсли;
	ПараметрыФормыНастройки.Вставить("ИмяТЧИсходногоДокумента", "");
	ПараметрыФормыНастройки.Вставить("Таблица", ИмяТаблицы);
	ПараметрыФормыНастройки.Вставить("ТипАлгоритма", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_АлгоритмыЗаполнения.ПустаяСсылка"));
	
	Если ИмяТаблицы = "ДеревоРеквизитовДокУчСист" Тогда
		ПараметрыФормыНастройки.ТипАлгоритма = ТекущиеДанные.ТипАлгоритма;
	КонецЕсли;
	
	Если ИмяТаблицы = "ПеременныеДокУчСист" Тогда
		ПараметрыФормыНастройки.Вставить("Реквизит", ТекущиеДанные.Имя);
		ПараметрыФормыНастройки.Вставить("ТипЗначения", ТекущиеДанные.ИмяТипЗначения);
	Иначе
		ПараметрыФормыНастройки.Вставить("Реквизит", ТекущиеДанные.Реквизит);
		ПараметрыФормыНастройки.Вставить("ТипЗначения", ТекущиеДанные.РеквизитТипЗначения);
	КонецЕсли;
	
	ПараметрыФормыНастройки.Вставить("ТипДокументаУчСис", Объект.ИмяРесурса);
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекущиеДанные.СпособРасчета);
	ПараметрыФормыНастройки.Вставить("ВыбранныйТипЗначения", ТекущиеДанные.ВыражениеВычисленияТипЗначения);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияУИД", ТекущиеДанные.ВыражениеВычисленияУИД);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекущиеДанные.ВыражениеВычисления);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр);
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации", Объект.Ссылка);
	ПараметрыФормыНастройки.Вставить("ТипДокумента1С", Объект.ИмяРесурса);
	ПараметрыФормыНастройки.Вставить("ТипДокументаЛогистика",
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1"));
	ПараметрыФормыНастройки.Вставить("ТипОснования", "КонтурЛогистика_ПроизвольныеДанные");
	
	Если ИмяТаблицы = "ДеревоРеквизитовДокУчСист"
		Или ИмяТаблицы = "ЗаполнениеДокУчСистТЧ"
		Или ИмяТаблицы = "ПеременныеДокУчСист" Тогда
		
		ТекстПояснения =
		"Доступные переменные:
		|Основание - содержит исходный документ из которого производится заполнение. Для ТЧ содержит строку товаров исходного документа. Для настройки конвертации справочника содержит значение учетной системы, которое устанавливается в соответствие.
		|Объект - текущий заполняемый Документ.
		|ПравилоКонвертации и Переменные.
		|+ <глобальный контекст>";
		
		ПараметрыФормыНастройки.Вставить("ВычислитьВыражениеПояснеине", ТекстПояснения);
		
	КонецЕсли;
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ИмяТаблицы", ИмяТаблицы);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертацииОбратныйМаппинг_Помощник",
		ПараметрыФормыНастройки, ЭтаФорма, ЭтаФорма, "НачалоВыбораВыраженияВычисленияУчСисЗавершение", ПараметрыОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораВыраженияВычисленияУчСисЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблицы = ДополнительныеПараметры.ИмяТаблицы;
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	ТекущиеДанные.СпособРасчета = Результат.СпособРасчета;
	ТекущиеДанные.ВыражениеВычисления = Результат.ВыражениеВычисления;
	ТекущиеДанные.ВыражениеВычисленияТипЗначения = Результат.ВыражениеВычисленияТипЗначения;
	ТекущиеДанные.ВыражениеВычисленияУИД = Результат.ВыражениеВычисленияУИД;
	ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр = Результат.ВыражениеВычисленияСтрокаНеогр;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРеквизитовДокУчСистПоДокументу1C()
	
	ДеревоЗначений = Новый ДеревоЗначений;
	
	РеквизитыТЧЗаполнениеДокУчСист =
		Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ТабличныеЧасти.ЗаполнениеДокУчСист.Реквизиты;
	Для каждого ТекущаяСтрока Из РеквизитыТЧЗаполнениеДокУчСист Цикл
		ДеревоЗначений.Колонки.Добавить(ТекущаяСтрока.Имя);
	КонецЦикла;
	
	МетаданныеДок = Метаданные.Документы.Найти(Объект.ИмяРесурса);
	
	Если МетаданныеДок <> Неопределено Тогда
		
		СтрокаТипАлгоритмаЗаполнить = ДеревоЗначений.Строки.Добавить();
		СтрокаТипАлгоритмаЗаполнить.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
		
		СтрокаТипАлгоритма = ДеревоЗначений.Строки.Добавить();
		СтрокаТипАлгоритма.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик;
		
		Для Каждого ТекущаяСтрока Из МетаданныеДок.Реквизиты Цикл
			СтрокаЗапись = СтрокаТипАлгоритмаЗаполнить.Строки.Добавить();
			СтрокаЗапись.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить;
			СтрокаЗапись.Реквизит = ТекущаяСтрока.Имя;
			СтрокаЗапись.РеквизитТипЗначения = ТекущаяСтрока.Тип;
			СтрокаЗапись.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
		Конеццикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений, "ДеревоРеквизитовДокУчСист");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРеквизитовДокУчСист()
	
	ДеревоЗначений = Новый ДеревоЗначений;
	
	РеквизитыТЧЗаполнениеДокУчСист =
		Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ТабличныеЧасти.ЗаполнениеДокУчСист.Реквизиты;
	Для Каждого ТекущаяСтрока Из РеквизитыТЧЗаполнениеДокУчСист Цикл
		ДеревоЗначений.Колонки.Добавить(ТекущаяСтрока.Имя);
	КонецЦикла;
	
	СтрокаТипАлгоритмаЗаполнить = "";
	
	Для Каждого ТекущаяСтрока Из Объект.ЗаполнениеДокУчСист Цикл
		
		Если ТекущаяСтрока.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.МетодЗаполнить Тогда
			
			Если ЗначениеЗаполнено(ТекущаяСтрока.Реквизит) Тогда
				
				СтрокаЗапись = СтрокаТипАлгоритмаЗаполнить.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаЗапись, ТекущаяСтрока);
				
			Иначе
				
				СтрокаТипАлгоритмаЗаполнить = ДеревоЗначений.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТипАлгоритмаЗаполнить, ТекущаяСтрока);
				
			КонецЕсли;
			
		ИначеЕсли ТекущаяСтрока.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.УказатьРеквизит
			Или ТекущаяСтрока.ТипАлгоритма = Перечисления.КонтурЛогистика_АлгоритмыЗаполнения.ВыполнитьОбработчик Тогда
			
			СтрокаЗапись = ДеревоЗначений.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗапись, ТекущаяСтрока);
			
		КонецЕсли;
		
	Конеццикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений, "ДеревоРеквизитовДокУчСист");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораИмяТабличнойЧастиЗаполнения()
	
	Элементы.ИмяТабличнойЧастиЗаполнения.СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.ИмяРесурса) Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Метаданные.Документы[Объект.ИмяРесурса].ТабличныеЧасти Цикл
		Элементы.ИмяТабличнойЧастиЗаполнения.СписокВыбора.Добавить(ТекущаяСтрока.Имя);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыТЧЗаполнениеДокУчСистТЧ()
	
	Если Не ЗначениеЗаполнено(Объект.ИмяРесурса)
		Или Не ЗначениеЗаполнено(Объект.ИмяТабличнойЧастиЗаполнения) Тогда
		
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = Метаданные.Документы[Объект.ИмяРесурса].ТабличныеЧасти[Объект.ИмяТабличнойЧастиЗаполнения];
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из МетаданныеДокумента.Реквизиты Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Реквизит", ТекущаяСтрока.Имя);
		
		НайденныеСтроки = Объект.ЗаполнениеДокУчСистТЧ.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ЗаполнениеДокУчСистТЧ.Добавить();
		НоваяСтрока.Реквизит = ТекущаяСтрока.Имя;
		НоваяСтрока.РеквизитТипЗначения = ТекущаяСтрока.Тип;
		НоваяСтрока.СпособРасчета = Перечисления.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.НеЗаполнять;
	Конеццикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОбратныйМаппинг(НаправлениеКонвертации)
	
	Если НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее")
		Или НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее") Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПараметрыРеквизитовОтбора()
	
	Если Не ЗначениеЗаполнено(Объект.ОтборТипДанных) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПолейПоТипуДанных = ПараметрыПолейПоТипуДанных(Объект.ОтборТипДанных);
	
	Для Счет = 1 По 3 Цикл
		ТекущийЭлемент = Элементы["ОтборРазрез" + Строка(Счет)];
		ДанныеПоля = ПараметрыПолейПоТипуДанных["Разрез" + Строка(Счет)];
		
		ТекущийЭлемент.Видимость = ДанныеПоля.НКРСВидимость;
		ТекущийЭлемент.Заголовок = ДанныеПоля.Заголовок;
		
		Если ТекущийЭлемент.Видимость Тогда
			ТекущийЭлемент.Подсказка = ДанныеПоля.НКРСПодсказка;
			ТекущийЭлемент.ПодсказкаВвода = ДанныеПоля.НКРСПодсказкаВвода;
			
			Если ЗначениеЗаполнено(ТекущийЭлемент.Подсказка) Тогда
				ТекущийЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыПолейПоТипуДанных(ТипДанных)
	
	Возврат РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ПараметрыПолейПоТипуДанных(ТипДанных);
	
КонецФункции

#КонецОбласти