&НаКлиенте
Процедура ПравилаКонвертацииВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НачалоВыбораВыраженияВычисления(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикРедактированиеСтрокиВДопФорме(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено
		Или ИмяЭлемента = Неопределено
		Или ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Если ТипЗнч(Элементы[ИмяЭлемента]) = Тип("ТаблицаФормы") Тогда
		ТаблицаФормы = Элементы[ИмяЭлемента];
	Иначе
		ТаблицаФормы = Элементы[ИмяЭлемента].Родитель.Родитель;
	КонецЕсли;
	
	ТаблицаФормы.ТекущиеДанные.СпособМаппинга = ВыбранноеЗначение.СпособМаппинга;
	ТаблицаФормы.ТекущиеДанные.ВыражениеВычисления = ВыбранноеЗначение.ВыражениеВычисления;
	ТаблицаФормы.ТекущиеДанные.ВыражениеВычисления2 = ВыбранноеЗначение.ВыражениеВычисления2;
	ТаблицаФормы.ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр = ВыбранноеЗначение.ВыражениеВычисленияСтрокаНеогр;
	ТаблицаФормы.ТекущиеДанные.КлючДопСвойстваРеквизита = ВыбранноеЗначение.КлючДопСвойстваРеквизита;
	ТаблицаФормы.ТекущиеДанные.СвойствоОбъекта = ВыбранноеЗначение.СвойствоОбъекта;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаКонвертацииСпособКонвертацииЗначенияПриИзменении(Элемент)
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаСоответствий

&НаКлиенте
Процедура ТаблицаСоответствийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ПравилаКонвертации.ТекущиеДанные;
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.ТекущиеДанные.РеквизитРегистраСведений = ТекущиеДанные.РеквизитРегистраСведений;
	Элемент.ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанныеПравилаКонвертации = Элементы.ПравилаКонвертации.ТекущиеДанные;
	ТекущиеДанныеТаблицаСоответствий = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	Если ТекущиеДанныеПравилаКонвертации = Неопределено
		Или ТекущиеДанныеТаблицаСоответствий = Неопределено Тогда
		
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("РеквизитРегистраСведений", ТекущиеДанныеПравилаКонвертации.РеквизитРегистраСведений);
	Отбор.Вставить("ИзвлеченноеЗначение", ТекущиеДанныеТаблицаСоответствий.ИзвлеченноеЗначение);
	
	Если ЗначениеЗаполнено(ТекущиеДанныеТаблицаСоответствий.ИзвлеченноеЗначение)
		Или ТекущиеДанныеТаблицаСоответствий.ИзвлеченноеЗначение = Неопределено Тогда
		
		Если Объект.ТаблицаСоответствий.НайтиСтроки(Отбор).Количество() > 1
			И Не ОтменаРедактирования Тогда
			
			Сообщить("Такое извлеченное значение уже есть");
			Отказ = Истина;
		КонецЕсли;
		
	Иначе
		
		Если Объект.ТаблицаСоответствий.НайтиСтроки(Отбор).Количество() > 0
			И Не ОтменаРедактирования Тогда
			
			Сообщить("Такое извлеченное значение уже есть");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПеременные

&НаКлиенте
Процедура ПеременныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СМВычислитьВыражение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение");
	СМРеквизитДокументаОснования = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования");
	СКЗКонвертироватьМассивСтруктур = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыКонвертации.КонвертироватьМассивСтруктур");
	
	Если Найти(Поле.Имя, "ВыражениеВычисления") > 0
		И (Элемент.ТекущиеДанные.СпособМаппинга = СМВычислитьВыражение
			Или Элемент.ТекущиеДанные.СпособМаппинга = СМРеквизитДокументаОснования) Тогда
		
		НачалоВыбораВыраженияВычисления(Элемент, СтандартнаяОбработка);
		
	КонецЕсли;
	
	Если Найти(Поле.Имя, "КонвертироватьПоНастройке") > 0
		И Элемент.ТекущиеДанные.СпособКонвертацииЗначения = СКЗКонвертироватьМассивСтруктур Тогда
		
		КонвертироватьПоНастройкеНачалоВыбора(Элемент, Неопределено, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеременныеПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрокТаблицыСоответствий();
	
КонецПроцедуры

