
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СостояниеФайла = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ПараметрКоманды, "Состояние");
	
	Если СостояниеФайла = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен") Тогда 
		// это входящий
		НашаОрганизация = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ПараметрКоманды, "Получатель");
	Иначе
		// исходящий
		НашаОрганизация = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ПараметрКоманды, "Отправитель");
	КонецЕсли;
	
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_УказатьДокументДДВручную",
																	Новый Структура("НашаОрганизация", НашаОрганизация),
																	ЭтотОбъект,
																	ЭтотОбъект, "ОбработчикВводаИдентификаторов",
																	ПараметрКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВводаИдентификаторов(РезультатВводаДанных, ФайлСсылка) Экспорт 
	
	Если ТипЗнч(РезультатВводаДанных) = Тип("Структура") Тогда 
		
		Если ЗначениеЗаполнено(РезультатВводаДанных.DocumentId) И ЗначениеЗаполнено(РезультатВводаДанных.MessageID) Тогда 
			
			Результат = ОбработкаКомандыСервер(ФайлСсылка, РезультатВводаДанных);
			
			Если Результат.Успешно Тогда 
				Состояние("В пакете!", , "Файлы объединены в пакет", БиблиотекаКартинок.КонтурЛогистика_ОбъединитьВПакет);
			Иначе
				Состояние("Не удалось объединить в пакет",, "Подробности выведены в сообщения", БиблиотекаКартинок.КонтурЛогистика_ИсправитьОшибки);
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьООшибкиВыполненияФункции(Результат);
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбработкаКомандыСервер(ФайлСсылка, РезультатВводаДанных)

	МассивСтруктурDocumentId = Новый Массив;
	МассивСтруктурDocumentId.Добавить(Новый Структура("MessageId, EntityId", РезультатВводаДанных.MessageID, РезультатВводаДанных.DocumentId));
	
	Результат = КонтурЛогистика_API_Диадок.ВыполнитьЗапросПрисоединитьДокументыКПакету(ФайлСсылка, МассивСтруктурDocumentId);
	
	Возврат Результат;

КонецФункции
