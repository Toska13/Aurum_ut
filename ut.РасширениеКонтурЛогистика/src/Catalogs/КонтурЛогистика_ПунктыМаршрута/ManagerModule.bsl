#Область ПрограммныйИнтерфейс

Функция ПолучитьОписаниеКлючейПоиска() Экспорт
	
	// Поиск договора осуществляется по:
	// 1. Адрес строкой
	// 2. Город, Улица, Дом, Корпус, Квартира
	// 3. Населенный пункт, Улица, Дом, Корпус, Квартира
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	КлючиПоиска = Новый Массив;
	
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска,
		"АдресИнфАдрес", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска,
		"АдресГород,АдресУлица,АдресДом,АдресКорпус,АдресКварт", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска,
		"АдресНаселПункт,АдресУлица,АдресДом,АдресКорпус,АдресКварт", ШаблонСтрокиПоиска);
	
	Возврат КлючиПоиска;
	
КонецФункции

Функция ТекстОшибкиНеЗаполненыКлючевыеРеквизиты() Экспорт
	
	ТекстОшибки = "Ошибка при поиске Пункта маршрута. Не заполнен один из ключевых реквизитов в одном из вариантов поиска:
		|1. Строковое представление адреса
		|2. Город + Улица + Дом + Корпус + Квартира
		|3. Населенный пункт, Улица, Дом, Корпус, Квартира";
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция ПредставлениеАдреса_(ПунктМаршрута) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПунктМаршрута", ПунктМаршрута);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПунктыМаршрута.Наименование КАК Наименование,
	|	КонтурЛогистика_ПунктыМаршрута.GLN КАК GLN,
	|	КонтурЛогистика_ПунктыМаршрута.АдресИндекс КАК АдресИндекс,
	|	КонтурЛогистика_ПунктыМаршрута.АдресКодРегион КАК АдресКодРегион,
	|	КонтурЛогистика_ПунктыМаршрута.АдресИнфАдрес КАК АдресИнфАдрес,
	|	КонтурЛогистика_ПунктыМаршрута.АдресИнфКодСтраны КАК АдресИнфКодСтраны,
	|	КонтурЛогистика_ПунктыМаршрута.АдресГород КАК АдресГород,
	|	КонтурЛогистика_ПунктыМаршрута.АдресНаселПункт КАК АдресНаселПункт,
	|	КонтурЛогистика_ПунктыМаршрута.АдресУлица КАК АдресУлица,
	|	КонтурЛогистика_ПунктыМаршрута.АдресРайон КАК АдресРайон,
	|	КонтурЛогистика_ПунктыМаршрута.АдресДом КАК АдресДом,
	|	КонтурЛогистика_ПунктыМаршрута.АдресКорпус КАК АдресКорпус,
	|	КонтурЛогистика_ПунктыМаршрута.АдресКварт КАК АдресКварт,
	|	КонтурЛогистика_ПунктыМаршрута.КодГАР КАК КодГАР
	|ИЗ
	|	Справочник.КонтурЛогистика_ПунктыМаршрута КАК КонтурЛогистика_ПунктыМаршрута
	|ГДЕ
	|	КонтурЛогистика_ПунктыМаршрута.Ссылка = &ПунктМаршрута";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат ПредставлениеАдресаПоДанным(Выборка, "");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеАдресаПоДанным(Данные, Префикс) Экспорт
	
	НаименованиеПоПолям = СокрЛП("" +
		?(ЗначениеЗаполнено(Данные[Префикс + "АдресГород"]), Данные[Префикс + "АдресГород"] + ", ", "")  +
		?(ЗначениеЗаполнено(Данные[Префикс + "АдресНаселПункт"]), Данные[Префикс + "АдресНаселПункт"] + ", ", "") +
		?(ЗначениеЗаполнено(Данные[Префикс + "АдресУлица"]), Данные[Префикс + "АдресУлица"] + ", ", "") +
		Данные[Префикс + "АдресДом"]);
		
	Если ЗначениеЗаполнено(Данные[Префикс + "АдресГород"]) Или ЗначениеЗаполнено(Данные[Префикс + "АдресНаселПункт"]) Тогда
		
		ТекстАдреса = НаименованиеПоПолям;
		
	ИначеЕсли ЗначениеЗаполнено(Данные[Префикс + "АдресИнфАдрес"]) Тогда
		
		ТекстАдреса = Данные[Префикс + "АдресИнфАдрес"];
		
	ИначеЕсли ЗначениеЗаполнено(Данные[Префикс + "КодГАР"]) Тогда
	
		ТекстАдреса = "Код ГАР: " + Данные[Префикс + "КодГАР"];
		
	ИначеЕсли ЗначениеЗаполнено(Данные[Префикс + "АдресКодРегион"]) Или ЗначениеЗаполнено(Данные[Префикс + "АдресИндекс"]) Тогда
		
		ТекстАдреса = Данные[Префикс + "АдресИндекс"] + " регион: " + Данные[Префикс + "АдресКодРегион"] + " " + НаименованиеПоПолям;
		
	Иначе
		
		ТекстАдреса = "";
		
	КонецЕсли;
	
	Возврат ТекстАдреса;
	
КонецФункции

#КонецОбласти

