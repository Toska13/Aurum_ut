#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Ключ") И Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		
		Параметры.Свойство("Полномочие", Запись.Полномочие);
		Параметры.Свойство("ТипТитула", Запись.ТипТитула);
		Параметры.Свойство("ДопПараметр", Запись.ДопПараметр);
		Параметры.Свойство("КодКлассификатора", Запись.КодКлассификатора);
		Параметры.Свойство("НаименованиеПолномочия", Запись.НаименованиеПолномочия);
		
	Иначе
		
		ИзменениеЗаписи = Истина;
		
	КонецЕсли;
	
	ЗаполнитьВыборТитула();
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЗначениеЗаполнено(Запись.Полномочие) Тогда
		Сообщить("Не заполнено полномочие");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.КодКлассификатора) Тогда
		Сообщить("Не заполнен код полномочия");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Закрыть(Запись);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПравоДляПолномочийМЧДПриИзменении(Элемент)
	
	Запись.ТипТитула = "";
	
	ЗаполнитьВыборТитула();
	
КонецПроцедуры

&НаКлиенте
Процедура КодПолномочияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_КлассификаторПолномочийМЧД.ФормаВыбора",
		,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикВыбораЗначения");
	
КонецПроцедуры
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьВыборТитула()
	
	Если Запись.Полномочие = Перечисления.КонтурЛогистика_Полномочия.ПодписаниеЭТРН Тогда
		Элементы.ТипТитула.СписокВыбора.Очистить();
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8);
	ИначеЕсли Запись.Полномочие = Перечисления.КонтурЛогистика_Полномочия.ПодписаниеЭПЛ Тогда
		Элементы.ТипТитула.СписокВыбора.Очистить();
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02);
	ИначеЕсли Запись.Полномочие = Перечисления.КонтурЛогистика_Полномочия.ПодписаниеЗЗ Тогда
		Элементы.ТипТитула.СписокВыбора.Очистить();
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1);
		Элементы.ТипТитула.СписокВыбора.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2);
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработчикВыбораЗначения(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение <> Неопределено Тогда
		ДобавитьПолномочие(ВыбранноеЗначение);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПолномочие(Полномочие)
	
	Запись.КодКлассификатора = Полномочие.КодКлассификатора;
	Запись.НаименованиеПолномочия = Полномочие.Наименование;
		
КонецПроцедуры
	
#КонецОбласти
