
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДеревоПолномочий(); 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоПолномочий()
	
	дз = Новый ДеревоЗначений;
	Для каждого Реквизит Из Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Измерения Цикл
		дз.Колонки.Добавить(Реквизит.Имя);
	КонецЦикла;
	Для каждого Реквизит Из Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Ресурсы Цикл
		дз.Колонки.Добавить(Реквизит.Имя);
	КонецЦикла;
	Для каждого Реквизит Из Метаданные.РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Реквизиты Цикл
		дз.Колонки.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиПолномочийМЧД.Полномочие КАК Полномочие,
		|	КонтурЛогистика_НастройкиПолномочийМЧД.КодКлассификатора КАК КодКлассификатора,
		|	КонтурЛогистика_НастройкиПолномочийМЧД.ТипТитула КАК ТипТитула,
		|	КонтурЛогистика_НастройкиПолномочийМЧД.ДопПараметр КАК ДопПараметр,
		|	КонтурЛогистика_НастройкиПолномочийМЧД.НаименованиеПолномочия КАК НаименованиеПолномочия
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиПолномочийМЧД КАК КонтурЛогистика_НастройкиПолномочийМЧД
		|ИТОГИ ПО
		|	Полномочие,
		|	ТипТитула,
		|	ДопПараметр";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПолномочие = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПолномочие.Следующий() Цикл
		
		ВыборкаТипТитула = ВыборкаПолномочие.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаТипТитула.Следующий() Цикл
			
			ВыборкаДопПараметр = ВыборкаТипТитула.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
			Пока ВыборкаДопПараметр.Следующий() Цикл
								
				СтрокаПолномочие = дз.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПолномочие, ВыборкаДопПараметр);
				
				ВыборкаДетальныеЗаписи = ВыборкаДопПараметр.Выбрать();	
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					Стр = СтрокаПолномочие.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(Стр, ВыборкаДетальныеЗаписи);	
					
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Если дз.Строки.Количество() = 0 Тогда
		
		Для каждого Полномочие Из Метаданные.Перечисления.КонтурЛогистика_Полномочия.ЗначенияПеречисления Цикл
			СтрокаПолномочие = дз.Строки.Добавить();
			СтрокаПолномочие.Полномочие = Перечисления.КонтурЛогистика_Полномочия[Полномочие.Имя];
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(дз, "ДеревоПолномочий");
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПолномочие(Команда)
	
	ТекДанные = Элементы.ДеревоПолномочий.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	
	Если ТекДанные <> Неопределено Тогда
			
		ПараметрыФормы.Вставить("Полномочие", ТекДанные.Полномочие);
		ПараметрыФормы.Вставить("ТипТитула", ТекДанные.ТипТитула);
		ПараметрыФормы.Вставить("ДопПараметр", ТекДанные.ДопПараметр);
				
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Форма.ФормаЗаписи", 
			ПараметрыФормы, 
			, 
			ЭтаФорма, 
			"ОбработчикДобавленияПолномочия");
		
КонецПроцедуры

