&НаКлиенте
Процедура ДеревоПолномочийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекДанные = Элементы.ДеревоПолномочий.ТекущиеДанные;	
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Уровень = УровеньДереваЗначений();
	
	Если Уровень >= 1 Тогда
		Отказ = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция УровеньДереваЗначений()
	
	ТекСтр = Элементы.ДеревоПолномочий.ТекущиеДанные;
	
	Уровень = 0;
	
	Пока Истина Цикл
		
		Если ТекСтр.ПолучитьРодителя() <> Неопределено Тогда
			Уровень = Уровень + 1;
			ТекСтр = ТекСтр.ПолучитьРодителя();
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Уровень;
	
КонецФункции

&НаКлиенте
Процедура ДеревоПолномочийПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ДеревоПолномочий.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	 		
	ДанныеДляУдаления = Новый Структура;
	ДанныеДляУдаления.Вставить("Полномочие", ТекДанные.Полномочие);
	
	Если ТекДанные.ПолучитьРодителя() <> Неопределено Тогда
		ДанныеДляУдаления.Вставить("КодКлассификатора", ТекДанные.КодКлассификатора);
	КонецЕсли;
	
	ДанныеДляУдаления.Вставить("ТипТитула", ТекДанные.ТипТитула);
	ДанныеДляУдаления.Вставить("ДопПараметр", ТекДанные.ДопПараметр);
		
	УдалитьПолномочие(ДанныеДляУдаления);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПолномочие(ДанныеДляУдаления)
	
	НаборЗаписей = РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Полномочие.Установить(ДанныеДляУдаления.Полномочие);
	
	Если ДанныеДляУдаления.Свойство("КодКлассификатора") Тогда
		НаборЗаписей.Отбор.КодКлассификатора.Установить(ДанныеДляУдаления.КодКлассификатора);
	КонецЕсли;
	
	НаборЗаписей.Отбор.ТипТитула.Установить(ДанныеДляУдаления.ТипТитула);
	НаборЗаписей.Отбор.ДопПараметр.Установить(ДанныеДляУдаления.ДопПараметр);
	
	НаборЗаписей.Записать(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПолномочийПолномочиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элементы.ДеревоПолномочий.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПолномочие(Команда)
	
	ТекДанные = Элементы.ДеревоПолномочий.ТекущиеДанные;
	 		
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.КодКлассификатора) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураЗаписи = Новый Структура("Полномочие, КодКлассификатора, ТипТитула, ДопПараметр",
				ТекДанные.Полномочие, ТекДанные.КодКлассификатора, ТекДанные.ТипТитула, ТекДанные.ДопПараметр);
	
	МассивКонструктораКлюча = Новый Массив;
	МассивКонструктораКлюча.Добавить(СтруктураЗаписи);
	
	КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.КонтурЛогистика_НастройкиПолномочийМЧД", МассивКонструктораКлюча);
	ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Форма.ФормаЗаписи", 
			ПараметрыФормы, 
			, 
			ЭтаФорма, 
			"ОбработчикДобавленияПолномочия");	
	
КонецПроцедуры
