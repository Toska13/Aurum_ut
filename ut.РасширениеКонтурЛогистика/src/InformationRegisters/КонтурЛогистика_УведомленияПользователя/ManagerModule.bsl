
#Область ПрограммныйИнтерфейс

Процедура УстановитьПризнакПрочитано(Уведомление, ТекущийПользователь, Прочитано = Истина) Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Уведомление.Установить(Уведомление);
	НаборЗаписей.Отбор.Пользователь1С.Установить(ТекущийПользователь);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ТекущаяЗапись = НаборЗаписей.Добавить();
		ТекущаяЗапись.Уведомление = Уведомление;
		ТекущаяЗапись.Пользователь1С = ТекущийПользователь;
	Иначе
		ТекущаяЗапись = НаборЗаписей[0];
	КонецЕсли;
	
	ТекущаяЗапись.Прочитано = Прочитано;
	ТекущаяЗапись.ДатаПрочтения = ТекущаяДатаСеанса();
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти
