#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидемостьДоступность();
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		Если ЗначениеЗаполнено(Запись.ОповещениеТелефон) Тогда
			ПроверитьРегистрациюТелефона1Телеграм();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеОбщейНастройки"
		И Параметр = "ИспользоватьОтправкуВТелеграм" Тогда
		
		ИспользоватьОтправкуВТелеграм = ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
		ОбновитьВидемостьДоступность();
		
		Если ЗначениеЗаполнено(Запись.ОповещениеТелефон) Тогда
			ПроверитьРегистрациюТелефона1Телеграм();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзменениеНастройкиУчетнойЗаписиЭлектроннойПочты" Тогда
		
		ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
		ОбновитьВидемостьДоступность();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Телефон1ПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Запись.ОповещениеТелефон) Тогда
		ПроверитьРегистрациюТелефона1Телеграм();
	Иначе
		ОбновитьВидимостьГруппыТелеграм();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодключитьТелеграм1Нажатие(Элемент)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_QRКодБотаКаналаТелеграм",,
		ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьОтправкуВТелеграм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ПолучитьНастройкуПоИмениПредопределенного("ИспользоватьОтправкуВТелеграм"));
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_Настройки.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтправкуНаПочту(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастройкаУчетнойЗаписиЭлектроннойПочты",, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидемостьДоступность()
	
	Элементы.ГруппаТелефон1.Видимость = ИспользоватьОтправкуВТелеграм;
	Элементы.ГруппаНастройкиТелеграм.Видимость = Не ИспользоватьОтправкуВТелеграм;
	
	Элементы.АдресПочтыСотрудника1.Видимость = ИспользоватьОтправкуНаПочту;
	Элементы.ГруппаНастройкиПочты.Видимость = Не ИспользоватьОтправкуНаПочту;
	
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьГруппыТелеграм()
	
	Элементы.ДекорацияИдетПроверкаТелеграм1.Видимость = Ложь;
	Элементы.ДекорацияРезультатУспехТелеграм1.Видимость = Ложь;
	Элементы.ДекорацияПодключитьТелеграм1.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Запись.ОповещениеТелефон) Тогда
		Элементы.ГруппаПроверкаТелеграм1.Видимость = Истина;
		
		Если ИдетПроверкаТелефона1ВТелеграм Тогда
			Элементы.ДекорацияИдетПроверкаТелеграм1.Видимость = Истина;
		ИначеЕсли Телефон1ЗарегестрированВТелеграм Тогда
			Элементы.ДекорацияРезультатУспехТелеграм1.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПодключитьТелеграм1.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГруппаПроверкаТелеграм1.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефона1Телеграм()
	
	ИдетПроверкаТелефона1ВТелеграм = Истина;
	ПодключитьОбработчикОжидания("ПроверитьРегистрациюТелефона1ТелеграмВФоне", 0.1, Истина);
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефона1ТелеграмВФоне()
	
	Телефон1ЗарегестрированВТелеграм = ПроверитьРегистрациюТелеграмНаСервере(Запись.ОповещениеТелефон);
	ИдетПроверкаТелефона1ВТелеграм = Ложь;
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьРегистрациюТелеграмНаСервере(Телефон)
	
	Попытка
		ТелефонЗарегестрированВТелеграм = КонтурЛогистика_РаботаСТелеграм.ТелефонЗарегестрирован(Телефон);
	Исключение
		ТелефонЗарегестрированВТелеграм = Ложь;
	КонецПопытки;
	
	Возврат ТелефонЗарегестрированВТелеграм;
	
КонецФункции

&НаСервереБезКонтекста
Функция НастройкиОтправкиПочтыЗаполнены()
	
	Возврат КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкуПоИмениПредопределенного(ИмяПредопределенного)
	
	Возврат Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеНастройки(ИмяПредопределенного)
	
	Возврат Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(ИмяПредопределенного);
	
КонецФункции

#КонецОбласти