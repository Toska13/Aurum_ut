							СтрокаСертификат.СостояниеМЧД = "Истекла";
							МЧДИстекла = Истина;
						ИначеЕсли Не ВыборкаДетальныеЗаписи.МЧД.Пустая() И ВыборкаДетальныеЗаписи.КолвоДнейМЧД = 0 Тогда			
							СтрокаСертификат.ОписаниеПредупрежденияМЧД = "Сегодня истекает";
							СтрокаСертификат.СостояниеМЧД = "Истекает";
							МЧДИстекает = Истина;
						ИначеЕсли Не ВыборкаДетальныеЗаписи.МЧД.Пустая() И ВыборкаДетальныеЗаписи.КолвоДнейМЧД <= 30 Тогда					
							СтрокаСертификат.ОписаниеПредупрежденияМЧД = "Через " + Строка(ВыборкаДетальныеЗаписи.КолвоДнейМЧД) + " дней";					
							СтрокаСертификат.СостояниеМЧД = "Истекает";
							ПоказатьДействияМЧД = Истина;
							МЧДИстекает = Истина;
						ИначеЕсли Не ВыборкаДетальныеЗаписи.МЧД.Пустая() И ВыборкаДетальныеЗаписи.МЧДНеПрошлаПроверку Тогда					
							СтрокаСертификат.ОписаниеПредупрежденияМЧД = "МЧД не прошла проверку";					
							СтрокаСертификат.СостояниеМЧД = "МЧД не прошла проверку";
							СтрокаСертификат.Действия = "Проверить";
						ИначеЕсли ВыборкаДетальныеЗаписи.МЧД.Пустая() И ВыборкаДетальныеЗаписи.СертификатБезМЧД Тогда					
							СтрокаСертификат.ОписаниеПредупрежденияМЧД = "		Не выбрана МЧД";					
							СтрокаСертификат.СостояниеМЧД = "Не выбрана МЧД";
							СтрокаСертификат.Действия = "Проверить";
						КонецЕсли;
																				
						ФИО = ВыборкаДетальныеЗаписи.Сертификат.Фамилия + " " + ВыборкаДетальныеЗаписи.Сертификат.Имя + " " + ВыборкаДетальныеЗаписи.Сертификат.Отчество;
																
						СтрокаСертификат.КартинкаСертификата = 0; 
						СтрокаСертификат.КартинкаМЧД = ?(ВыборкаДетальныеЗаписи.МЧД.Пустая(), 1, 0);
						
						Если СертификатИстек Или СертификатИстекает Тогда
							НовыйСертификат = тзСертификаты.Добавить();
							НовыйСертификат.Сертификат = ВыборкаМЧД.Сертификат;
						КонецЕсли;
						Если МЧДИстекла Или МЧДИстекает Тогда
							НоваяМЧД = тзМЧД.Добавить();
							НоваяМЧД.МЧД = ВыборкаМЧД.МЧД;
						КонецЕсли;
						Если ВыборкаДетальныеЗаписи.МЧДНеПрошлаПроверку Или ВыборкаДетальныеЗаписи.СертификатБезМЧД Тогда
							НоваяМЧД = тзПроверкаМЧД.Добавить();
							НоваяМЧД.МЧД = ВыборкаМЧД.МЧД;
						КонецЕсли;
																		
					КонецЕсли;
					
					Если ВыборкаДопПараметр.КолвоОрг > 1 Тогда
						
						СтрокаСертификат.ОрганизацияСтрока = ПредставлениеОрганизации(ВыборкаДопПараметр.КолвоОрг);
						СтрокаСертификат.Пользователь = "";				
						
						СтрокаОрганизация = СтрокаСертификат.Строки.Добавить();
						СтрокаОрганизация.Пользователь = ВыборкаДетальныеЗаписи.Пользователь;
						СтрокаОрганизация.ОрганизацияСтрока = ВыборкаДетальныеЗаписи.ОрганизацияДиадок;
						СтрокаОрганизация.ОрганизацияДиадок = ВыборкаДетальныеЗаписи.ОрганизацияДиадок;
						СтрокаОрганизация.Период = ВыборкаДетальныеЗаписи.Период;
						СтрокаОрганизация.СертификатНаСервере = ВыборкаДетальныеЗаписи.СертификатНаСервере;
						СтрокаОрганизация.КартинкаСертификата = 1;
						СтрокаОрганизация.КартинкаМЧД = 1;						
												
					КонецЕсли;
																	
					ПервыйВЦикле = Ложь;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	тзСертификаты.Свернуть("Сертификат");
	тзМЧД.Свернуть("МЧД");
	тзПроверкаМЧД.Свернуть("МЧД");
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаполненДопПараметр", ЗаполненДопПараметр);
	Результат.Вставить("СертификатыДЗ", ДЗ);
	Результат.Вставить("КолвоПроблемныхСертификатов", тзСертификаты.Количество());
	Результат.Вставить("КолвоПроблемныхМЧД", тзМЧД.Количество());
	Результат.Вставить("КолвоНеПрошедшихПроверкуМЧД", тзПроверкаМЧД.Количество());
	
	Возврат Результат;	
	
КонецФункции

