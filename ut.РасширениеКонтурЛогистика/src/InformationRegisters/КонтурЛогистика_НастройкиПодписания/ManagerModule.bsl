Функция ПредставлениеОрганизации(Колво)
	
	Представление = "[ " + Строка(Колво);
	
	Если Колво = 2 ИЛИ Колво = 3 ИЛИ Колво = 4 Тогда
		Представление = Представление + " организации ]";
	Иначе
		Представление = Представление + " организаций ]";
	КонецЕсли;		
	
	Возврат Представление;
	
КонецФункции
