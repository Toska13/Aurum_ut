						СертификатИстекает = Ложь;
						МЧДИстекла = Ложь;
						МЧДИстекает = Ложь;
												
						ЗаполнитьЗначенияСвойств(СтрокаСертификат, ВыборкаДетальныеЗаписи);
						
						СтрокаСертификат.ОрганизацияСтрока = ВыборкаДетальныеЗаписи.ОрганизацияДиадок;
																		
						Если ВыборкаДетальныеЗаписи.КолвоДнейСертификат < 0 Тогда			
							СтрокаСертификат.ОписаниеПредупрежденияСертификат = "Истек";
							СтрокаСертификат.СостояниеСертификата = "Истек";
							СертификатИстек = Истина;
						ИначеЕсли ВыборкаДетальныеЗаписи.КолвоДнейСертификат = 0 Тогда			
							СтрокаСертификат.ОписаниеПредупрежденияСертификат = "Сегодня истекает";
							СтрокаСертификат.СостояниеСертификата = "Истекает";
							СертификатИстекает = Истина;
						ИначеЕсли ВыборкаДетальныеЗаписи.КолвоДнейСертификат <= 30 Тогда					
							СтрокаСертификат.ОписаниеПредупрежденияСертификат = "Через " + Строка(ВыборкаДетальныеЗаписи.КолвоДнейСертификат) + " дней";					
							СтрокаСертификат.СостояниеСертификата = "Истекает";
							СертификатИстекает = Истина;
						КонецЕсли;
						
						Если Не ВыборкаДетальныеЗаписи.МЧД.Пустая() И ВыборкаДетальныеЗаписи.КолвоДнейМЧД < 0 Тогда			
