Функция ВыбратьПодписанта(ОрганизацияДиадок, Пользователь1С = Неопределено, 
	ДатаПодписи = Неопределено, ДокументОбъектИлиСсылка = Неопределено, ДопПараметр = Неопределено) Экспорт
	
	Если ДатаПодписи = Неопределено Тогда
		ДатаПодписи = ТекущаяДатаСеанса();
	КонецЕсли;
	
	// Кастомизировать особенности выбора сертификата через ПМ:
	// установить ДопПараметр равный тому что в регистре КонтурЛогистика_НастройкиПодписания
	ДопПараметрПМ = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ВыбратьПодписанта_ДопПараметр",
		Истина,
		ДокументОбъектИлиСсылка);
	
	Если ЗначениеЗаполнено(ДопПараметрПМ) Тогда
		ТекущийДопПараметр = ДопПараметрПМ;
	Иначе
		ТекущийДопПараметр = ДопПараметр;
	КонецЕсли;
		
	// ПМ замена механизма
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ОрганизацияДиадок", ОрганизацияДиадок);
	ПараметрыПМ.Вставить("ДатаПодписи", ДатаПодписи);
	ПараметрыПМ.Вставить("ДокументОбъектИлиСсылка", ДокументОбъектИлиСсылка);
	ПараметрыПМ.Вставить("ДопПараметр", ДопПараметр);
	РезультатПМ = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ВыбратьПодписанта_ЗаменаМеханизма", СтандартнаяОбработка, ПараметрыПМ);
					
	Если СтандартнаяОбработка = Ложь Тогда		
		Возврат РезультатПМ;		
	КонецЕсли;
	
	Результат = МанифестПодписант();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок КАК ОрганизацияДиадок,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С КАК Пользователь1С,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере = ИСТИНА КАК ЭтоСерверныйСертификат,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Период КАК ДатаЗаписи,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДопПараметр КАК ДопПараметр,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат КАК Сертификат,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ОтпечатокСертификата КАК ОтпечатокСертификата,
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПустаяСсылка)
	|			ТОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Фамилия
	|		ИНАЧЕ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.Фамилия
	|	КОНЕЦ КАК Фамилия,
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПустаяСсылка)
	|			ТОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Имя
	|		ИНАЧЕ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.Имя
	|	КОНЕЦ КАК Имя,
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПустаяСсылка)
	|			ТОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Отчество
	|		ИНАЧЕ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.Отчество
	|	КОНЕЦ КАК Отчество,
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.ПустаяСсылка)
	|			ТОГДА КонтурЛогистика_НастройкиПодписанияСрезПоследних.Должность
	|		ИНАЧЕ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.Должность
	|	КОНЕЦ КАК Должность,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.СрокДействия КАК СрокДействия,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ПометкаУдаления КАК ПометкаУдаленияСертификат,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СтатусПодписанта КАК СтатусПодписанта,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СпосПодтПолном КАК СпосПодтПолном,        
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД КАК МЧДСсылка,
	|	ЕСТЬNULL(КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД.ИдентификаторДоверенности, """") КАК МЧД,
	|	ЕСТЬNULL(КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД.СистемаХранения, """") КАК ИдСистХран,	
	|	ЕСТЬNULL(КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД.ДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыпускаМЧД,
	|	ЕСТЬNULL(КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияМЧД,
	|	ЕСТЬNULL(КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД.ПроверятьПолномочия, Ложь) КАК ПроверятьПолномочия,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СтатусПроверки КАК СтатусПроверки,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДатаПроверки КАК ДатаПроверки,
	|	ЕСТЬNULL(КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД.ПометкаУдаления, Ложь) КАК ПометкаУдаленияМЧД,
	|	РАЗНОСТЬДАТ(КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДатаПроверки, &ДатаПодписания, ДЕНЬ) КАК ДнейПослеПроверкиМЧД,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СвДоверБум_ДатаДовер КАК СвДоверБум_ДатаДовер,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СвДоверБум_ВнНомДовер КАК СвДоверБум_ВнНомДовер,
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДопСведенияОПодписанте КАК ДопСведенияОПодписанте
	|
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних(
	|			&ДатаПодписания,
	|			(ОрганизацияДиадок = &ОрганизацияДиадок
	|				ИЛИ ОрганизацияДиадок = &ПустаяОрганизацияДиадок)
	|				И (ДопПараметр = &ДопПараметр
	|					ИЛИ &ДопПараметр = НЕОПРЕДЕЛЕНО)) КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних
	|ГДЕ
	|	(КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок = &ОрганизацияДиадок
	|			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок = &ПустаяОрганизацияДиадок)
	|	И (КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = &Пользователь1С
	|			ИЛИ &ПользовательНеУказан
	|			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = НЕОПРЕДЕЛЕНО
	|			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = &ПустойПользователь1С)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияДиадок УБЫВ,
	|	Пользователь1С УБЫВ";
	
	ЗаполнитьПараметрыЗапроса(ДатаПодписи, Запрос, ОрганизацияДиадок, Пользователь1С, ТекущийДопПараметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Выборка, , "СтатусПодписанта,СпосПодтПолном");
		Результат.СтатусПодписанта =  Перечисления.КонтурЛогистика_СтатусыПодписанта.ЗначениеДляXDTO(Выборка.СтатусПодписанта);
		Результат.СпосПодтПолном =  Перечисления.КонтурЛогистика_СпособыПодтвержденияПолномочий.ЗначениеДляXDTO(Выборка.СпосПодтПолном);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МанифестПодписант() Экспорт
	
	Подписант = Новый Структура;
	Подписант.Вставить("СтатусПодписанта", 			Неопределено);
	Подписант.Вставить("СпосПодтПолном", 			Неопределено);
	Подписант.Вставить("Должность", 				"");
	Подписант.Вставить("Фамилия", 					"");
	Подписант.Вставить("Имя", 						"");
	Подписант.Вставить("Отчество", 					"");
	Подписант.Вставить("ОтпечатокСертификата", 		"");
	Подписант.Вставить("ИдСистХран", 				"");
	Подписант.Вставить("МЧД", 						"");
	Подписант.Вставить("ДатаВыпускаМЧД", 			Дата(1, 1, 1, 0, 0, 0));
	Подписант.Вставить("ДатаОкончанияМЧД", 			Дата(1, 1, 1, 0, 0, 0));
	Подписант.Вставить("ЭтоСерверныйСертификат", 	Ложь);
	Подписант.Вставить("ДатаЗаписи", 				Дата(1, 1, 1, 0, 0, 0));
	Подписант.Вставить("СвДоверБум_ДатаДовер", 		Дата(1, 1, 1, 0, 0, 0));
	Подписант.Вставить("СвДоверБум_ВнНомДовер", 	"");
	Подписант.Вставить("СрокДействия", 				Дата(1, 1, 1, 0, 0, 0));
	Подписант.Вставить("Пользователь1С", 			Неопределено);
	Подписант.Вставить("ДопПараметр", 				"");
	Подписант.Вставить("ПометкаУдаленияСертификат", Неопределено);
	Подписант.Вставить("ПометкаУдаленияМЧД", 		Неопределено);
	Подписант.Вставить("Сертификат", 				Неопределено);
	Подписант.Вставить("МЧДСсылка",					Неопределено);
	Подписант.Вставить("ДнейПослеПроверкиМЧД", 		0);
	Подписант.Вставить("СтатусПроверки", 			"");
	Подписант.Вставить("ПроверятьПолномочия", 		Ложь);
	Подписант.Вставить("ДопСведенияОПодписанте", 	"");	
	
	Возврат  Подписант;
	
КонецФункции

Функция ПодписыватьНаСервере(ОрганизацияДиадок, Пользователь1С, ДатаПодписи = Неопределено) Экспорт
	
	Если ДатаПодписи = Неопределено Тогда
		
		ДатаПодписи = ТекущаяДатаСеанса();
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере КАК СертификатНаСервере
	               |ИЗ
	               |	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних(
	               |			&ДатаПодписания,
	               |			ОрганизацияДиадок = &ОрганизацияДиадок
	               |				ИЛИ ОрганизацияДиадок = &ПустаяОрганизацияДиадок) КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних
	               |ГДЕ
	               |	(КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок = &ОрганизацияДиадок
	               |			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок = &ПустаяОрганизацияДиадок)
	               |	И (КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = &Пользователь1С
	               |			ИЛИ &ПользовательНеУказан
	               |			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = Неопределено
	               |			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = &ПустойПользователь1С)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С УБЫВ";
	
	ЗаполнитьПараметрыЗапроса(ДатаПодписи, Запрос, ОрганизацияДиадок, Пользователь1С);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.СертификатНаСервере;
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;

КонецФункции

Процедура ЗаполнитьПараметрыЗапроса(Знач ДатаПодписи, Знач Запрос, Знач ОрганизацияДиадок, Знач Пользователь1С, Знач ДопПараметр = Неопределено)
	
	ИмяСправочникаПользователи = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяСправочникаПользователи");
	Если Не ЗначениеЗаполнено(ИмяСправочникаПользователи) Тогда
		ВызватьИсключение "Не заполнена основная настройка ""Имя справочника Пользователи"""
			+ " (Служебные настройки - Особенности хранения данных типовой конфигурации - Имя справочника Пользователи)";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДопПараметр", 			ДопПараметр);
	Запрос.УстановитьПараметр("ДатаПодписания", 		ДатаПодписи);
	Запрос.УстановитьПараметр("ОрганизацияДиадок", 		ОрганизацияДиадок);
	Запрос.УстановитьПараметр("ПустаяОрганизацияДиадок",Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПользовательНеУказан",	Пользователь1С = Неопределено);
	Запрос.УстановитьПараметр("ПустойПользователь1С",	Справочники[ИмяСправочникаПользователи].ПустаяСсылка());
	Запрос.УстановитьПараметр("Пользователь1С", 		Пользователь1С);

КонецПроцедуры

Функция ДанныеСертификатаДляПодписания(ОрганизацияДиадок, Пользователь1С = Неопределено, ДатаПодписи = Неопределено,
	ИспользоватьТолькоСерверные = Ложь, ДокументОбъектИлиСсылка = Неопределено, ДопПараметр = Неопределено) Экспорт
	
	Результат = Новый Структура("Отпечаток, СертификатНаСервере, СрокДействия, Представление");
		
	Если ДатаПодписи = Неопределено Тогда
		
		ДатаПодписи = ТекущаяДатаСеанса();
		
	КонецЕсли;
	
	// Кастомизировать особенности выбора сертификата через ПМ:
	// установить ДопПараметр равный тому что в регистре КонтурЛогистика_НастройкиПодписания
	ДопПараметрПМ = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ВыбратьПодписанта_ДопПараметр",
		Истина,
		ДокументОбъектИлиСсылка);
	
	Если ЗначениеЗаполнено(ДопПараметрПМ) Тогда
		ДопПараметр = ДопПараметрПМ;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат КАК СертификатСсылка,
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ОтпечатокСертификата КАК ОтпечатокСертификата,
				   |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ТипМодуляКриптографии КАК ТипМодуляКриптографии,
				   |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ИмяМодуляКриптографии КАК ИмяМодуляКриптографии,
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере КАК СертификатНаСервере,
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.СрокДействия КАК СрокДействия,
				   |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ВводитьПарольВПрограммеЭлектроннойПодписи КАК ВводитьПарольВПрограммеЭлектроннойПодписи,
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.Представление КАК Представление
	               |ИЗ
	               |	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних(
	               |			&ДатаПодписания,
	               |			(ОрганизацияДиадок = &ОрганизацияДиадок
	               |				ИЛИ ОрганизацияДиадок = &ПустаяОрганизацияДиадок)
	               |			И (ДопПараметр = &ДопПараметр
	               |				ИЛИ &ДопПараметр = НЕОПРЕДЕЛЕНО)
				   |			И (&ИспользоватьТолькоСерверные = ЛОЖЬ
	               |				ИЛИ СертификатНаСервере)) КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних
	               |ГДЕ
	               |	(КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок = &ОрганизацияДиадок
	               |			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок = &ПустаяОрганизацияДиадок)
	               |	И (КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = &Пользователь1С
	               |			ИЛИ &ПользовательНеУказан
	               |			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = Неопределено
	               |			ИЛИ КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С = &ПустойПользователь1С)
				   |    И Не КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С УБЫВ";
	
	ЗаполнитьПараметрыЗапроса(ДатаПодписи, Запрос, ОрганизацияДиадок, Пользователь1С, ДопПараметр);
	Запрос.УстановитьПараметр("ИспользоватьТолькоСерверные", ИспользоватьТолькоСерверные);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат.Вставить("СертификатСсылка", Выборка.СертификатСсылка);
		Результат.Вставить("Отпечаток", Выборка.ОтпечатокСертификата);
		Результат.Вставить("ТипМодуляКриптографии", Выборка.ТипМодуляКриптографии);
		Результат.Вставить("ИмяМодуляКриптографии", Выборка.ИмяМодуляКриптографии);
		Результат.Вставить("СертификатНаСервере", Выборка.СертификатНаСервере);
		Результат.Вставить("СрокДействия", Выборка.СрокДействия);
		Результат.Вставить("ВводитьПарольВПрограммеЭлектроннойПодписи", Выборка.ВводитьПарольВПрограммеЭлектроннойПодписи);
		Результат.Вставить("Представление", Выборка.Представление);
		
	Иначе
		Сообщить("Для организации " + ОрганизацияДиадок + " по пользователю: " + Пользователь1С + " не могу найти на дату " + ДатаПодписи + " настройку подписания " + ?(ИспользоватьТолькоСерверные, " НА СЕРВЕРЕ", ""));
	КонецЕсли;
	
	Возврат Результат
	
