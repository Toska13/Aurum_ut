	Запрос.УстановитьПараметр("МассивДокументов", МассивДокСсылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьСостояние(Документ, Состояние, Период = Неопределено, УказатьПользователя = Ложь, ОтвСторона = Неопределено, ДопДанные = Неопределено) Экспорт
	
	Если Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка() Тогда
		Возврат; // исключительная ситуация
	КонецЕсли;
	
	Запись = СоздатьМенеджерЗаписи();
	
	Запись.Документ = Документ;
	Запись.Период 	= ?(Период = Неопределено, КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени(), Период);
	
	Если ТипЗнч(Состояние) = Тип("Строка") Тогда 
		Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду(Состояние, ОтвСторона);
	КонецЕсли;
	
	НовоеСостояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НовоеСостоянийПоУсловиям(Состояние, Документ);
	Если НовоеСостояние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запись.Состояние = НовоеСостояние;
	
	Если УказатьПользователя = Истина Тогда
		Попытка
			Запись.Пользователь1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
		Исключение
			КонтурЛогистика_Метрика.Метрика_Отправить_Ошибку( , "УстановитьСостояние", ОписаниеОшибки(),
				"не смогли определить тек пользователя 1С");
		КонецПопытки;
	КонецЕсли;
	
	// См. ОписаниеДополнительныхДанных()
	Если ДопДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Запись, ДопДанные);
	КонецЕсли;
	
	Запись.Записать(Истина);
	
	// Вызов подключаемого модуля
	ПараметрыПМ = Новый Структура("ДокументЛогистика, Состояние", Документ, Состояние);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ПослеУстановкиСостояния", , ПараметрыПМ);
	
	// Если требуется, то документ добавится в очередь на поиск/создание связанного документа
	РегистрыСведений.КонтурЛогистика_СвязиДокументов.ДобавитьВОчередь(Документ.Ссылка);
	
	// Настройка конвертации регистра сведений
	ЕстьНастройкиКонвертацииРС = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНастройкиКонвертацииРСПоСтатусуДО(Состояние);
	Если ЕстьНастройкиКонвертацииРС Тогда
		КонтурЛогистика_КонвертацияСервер.КонвертироватьПриТриггереПоСтатусуДО(Документ, Состояние);
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеДополнительныхДанных(ФайлОбмена, ИдентификаторСобытия = Неопределено, КаналТранспорта = Неопределено) Экспорт
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("ФайлОбмена", ФайлОбмена);							// Ссылка на файл обмена
	ОписаниеДанных.Вставить("ИдентификаторСобытия", ИдентификаторСобытия);		// Догистика = id, Диадок = EventId
	ОписаниеДанных.Вставить("КаналТранспорта", КаналТранспорта);				// Перечисление.КонтурЛогистика_КаналыТранспорта
	
	Возврат ОписаниеДанных;
	
КонецФункции

Процедура ЗагрузитьСостоянияДО()
	
	КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗагрузитьСостоянияДО();
	
КонецПроцедуры	

Функция БылоСостояние(ДокументЭТРН, Состояние) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументЭТРН", ДокументЭТРН);
	Запрос.УстановитьПараметр("Состояние", Состояние);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ДвижениеДокументооборота.Документ КАК Документ,
	|	КонтурЛогистика_ДвижениеДокументооборота.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота КАК КонтурЛогистика_ДвижениеДокументооборота
	|ГДЕ
	|	КонтурЛогистика_ДвижениеДокументооборота.Документ = &ДокументЭТРН
	|	И КонтурЛогистика_ДвижениеДокументооборота.Состояние = &Состояние";
	
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();
	
КонецФункции