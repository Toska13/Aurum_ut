Функция ЗакладкаВВебеПоТрн(ДокументЭтрн) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК Состояние,
	               |	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.Код КАК СостояниеКод
	               |ИЗ
	               |	РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних(, Документ = &Документ) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних";
	
	Запрос.УстановитьПараметр("Документ", ДокументЭтрн);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Если Статусы1сНЕОтгруженныеВВебеЛогистики().Найти(Выборка.СостояниеКод) <> Неопределено Тогда
			Возврат "sign";
		ИначеЕсли Статусы1сАрхивныеВВебеЛогистики().Найти(Выборка.СостояниеКод) <> Неопределено Тогда
			Возврат "archive";
		Иначе
			Возврат "shipped";
		КонецЕсли;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Функция Статусы1сНЕОтгруженныеВВебеЛогистики()
	
	НЕОтгруженные = Новый Массив;
	НЕОтгруженные.Добавить("new");
	НЕОтгруженные.Добавить("wait-mintrans-api");
	НЕОтгруженные.Добавить("r-wait-storekeeper");
	НЕОтгруженные.Добавить("r-wait-consignor-sign");
	НЕОтгруженные.Добавить("r-consignor-signed");
	НЕОтгруженные.Добавить("r-wait-driver-draftApprove");
	НЕОтгруженные.Добавить("r-wait-driver-approve");
	НЕОтгруженные.Добавить("r-wait-carrier-sign");
	
	Возврат НЕОтгруженные; 
	
КонецФункции

Функция Статусы1сАрхивныеВВебеЛогистики()
	
	Архивные = Новый Массив;
	Архивные.Добавить("r-rejected");
	Архивные.Добавить("d-rejected");
	Архивные.Добавить("revoked");
	Архивные.Добавить("completed");
	
	Возврат Архивные; 
	
КонецФункции

Функция ПолучитьСтатус(Документ, НовыйДляПустого = Ложь) Экспорт
	
	// падают дымовые тесты, если Состояния ДО еще не загружены
	// Загрузим, если не загружены
	ЗагрузитьСостоянияДО(); 
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		
		Если НовыйДляПустого Тогда
			Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("new");
		Иначе
			Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
	
	СрезПоследних = СрезПоследних(, Новый Структура("Документ", Документ));
	Если СрезПоследних.Количество() > 0 Тогда
		Возврат СрезПоследних[0].Состояние;
	КонецЕсли;
		
	Если НовыйДляПустого Тогда
		Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("new");
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка();
	
КонецФункции

Процедура ОтметитьДокументыРаспечатанными(МассивДокументов) Экспорт 
	
	СостояниеРаспечатать 		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1НастройкаСостояниеРаспечатать");
	НастройкаВыводитьЗадачуРаспечатать 	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВыводитьЗадачуРаспечатать");
	
	Если НастройкаВыводитьЗадачуРаспечатать = Истина 
		И ЗначениеЗаполнено(СостояниеРаспечатать) Тогда 
		
		ДокументыРаспечатать = Новый Массив;
		
		ТекСостояния = ПолучитьТаблицуСостонийПоДокументам(МассивДокументов);
		
		Для Каждого ТекСостояние Из ТекСостояния Цикл 
			
			Если Не ТипЗнч(ТекСостояние.ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
				Или Не ЗначениеЗаполнено(ТекСостояние.Состояние) 
				Или Не ЗначениеЗаполнено(ТекСостояние.ТребуемоеДействиеТ1) Тогда 
				Продолжить;
			КонецЕсли;	
			
			Если ТекСостояние.Состояние = СостояниеРаспечатать Тогда 
				ДокументыРаспечатать.Добавить(ТекСостояние.ДокументТитул);
			КонецЕсли;
			
		КонецЦикла;	
						
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатусыДокументам(ДокументыРаспечатать, 
			Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан, Истина, Истина);		
		
	КонецЕсли;

КонецПроцедуры	

Функция ПолучитьТаблицуСостонийПоДокументам(Знач МассивДокСсылка) Экспорт
	
