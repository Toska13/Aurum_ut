// Функция - Подписать файлы обмена. Выберет подходящий сертификат и подпишет файл.
//
// Параметры:
//  МассивФайловОбмена       		- Массив - КонтурЛогистика_ФайлыОбмена.Ссылка - массив файлов которые нужно подписать
//  ИспользоватьТолькоСерверные   	- Булево - Ложь - выбрать сертификат среди всех (и клиентских и серверных)
//                      						Истина - выбрать только серверный сертификат
//  БезПодписанияНаСервере			- Булево - Ложь- если попытка подписать происходит на сервере и параметр без подписи на сервере, то не пытаемся подписывать
// 
// Возвращаемое значение:
//   - 
//
Функция ПодписатьФайлыОбмена(МассивФайловОбмена, ИспользоватьТолькоСерверные = Ложь, БезПодписанияНаСервере = Ложь) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() <> "Файловая" Тогда
		
		#Если Сервер Тогда
			ИспользоватьТолькоСерверные = Истина;
		#КонецЕсли
		
	КонецЕсли;
	
	ВебСервер_СерверныйКонтекст = ЭтоВебСервер_СерверныйКонтекст();
	
	УспешноПодписанныеФайлы = Новый Массив;
	
	// Шаблоны и прототипы ни при каких обстоятельствах не подписываются - для них просто пропускаем этап подписи
	Шаблоны = КонтурЛогистика_ОбщегоНазначенияСервер.ШаблоныВМассивеФайлов(МассивФайловОбмена);
	Прототипы = КонтурЛогистика_ОбщегоНазначенияСервер.ПрототипыВМассивеФайлов(МассивФайловОбмена);
	
	// Если какие-то из переданных файлов:
	//			входящие неподписанные 
	//		или исходящие, отправленные неподписанными
	// то такие файлы надо не подписывать напрямую а патчить
	ФайлыКПодготовке = КонтурЛогистика_ОбработкаДокументовСервер.НайтиФайлыКоторыеТребуетсяПатчить(МассивФайловОбмена);
	КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьКПодписаниюФайлыОбменаПатчем(ФайлыКПодготовке);
	
	ИспользоватьКриптографию1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьКриптографию1С");
	
	Для Каждого ФайлОбмена Из МассивФайловОбмена Цикл
		
		Если Не Шаблоны.Найти(ФайлОбмена) = Неопределено Тогда
			УспешноПодписанныеФайлы.Добавить(ФайлОбмена);
			Продолжить;
		КонецЕсли;
		
		Если Не Прототипы.Найти(ФайлОбмена) = Неопределено Тогда
			УспешноПодписанныеФайлы.Добавить(ФайлОбмена);
			Продолжить;
		КонецЕсли;
		
		РеквизитыФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ФайлОбмена,
			"ТребуетсяПодпись, Состояние, ПодписьВерна, ГлавныйДокумент, СвязанныйДокумент");
		Если РеквизитыФайла.ТребуетсяПодпись = Ложь Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
				"Файл " + ФайлОбмена + " требуется отправить неподписанным. Действие ""Подписать"" не выполнено");
			Продолжить;
		ИначеЕсли РеквизитыФайла.Состояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен") Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
				"Файл " + ФайлОбмена + " невозможно подписать т.к. он уже отправлен");
			Продолжить;
		КонецЕсли;
		
		// Если попытка подписать происходит на сервере и параметр без подписи на сервере, то не пытаемся подписывать
		Если БезПодписанияНаСервере И (ИспользоватьТолькоСерверные Или ВебСервер_СерверныйКонтекст) Тогда
			Если РеквизитыФайла.ПодписьВерна Тогда
				УспешноПодписанныеФайлы.Добавить(ФайлОбмена);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Попытка
			Успех = ПодписатьФайлОбмена(ФайлОбмена, ИспользоватьТолькоСерверные, БезПодписанияНаСервере, ИспользоватьКриптографию1С);
		Исключение
			Успех = Ложь;
			
			ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				ФайлОбмена, "ТипДокумента");
			КонтурЛогистика_Метрика.ОбработатьОшибкуТипаДокумента(
				"ПодписатьФайлыОбмена", ТипДокумента, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), ФайлОбмена);
		КонецПопытки;
		
		Если Не Успех Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьСтатус(РеквизитыФайла.СвязанныйДокумент, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Подписан"), Истина, Истина);
		
		УспешноПодписанныеФайлы.Добавить(ФайлОбмена);
		
		// Сквозной сценарий путевых листов Т1-Т4
		СковознойСценарийПутевогоЛистаТ1234(ФайлОбмена, РеквизитыФайла, МассивФайловОбмена);
		
	КонецЦикла;
	
	Возврат УспешноПодписанныеФайлы;
	
КонецФункции

// Для варианта файловой базы на веб-сервере.
// Если происходит запуск роботов на клиенте, то на этапе изготовления файлов (серверный контекст) нам нужно пропускать подпись.
// В данном случае в серверном контексте база будет определяться как файловая, и будет осуществляться незапланированная попытка подписи с последующими
// возможными ошибками (например, будет найдена настройка подписания на клиенте, но в контексте сервера ХранилищеСертификатов пусто). 
// Чтобы пропустить подпись используем отдельный признак, определяющий, что соединение установлено через веб-сервер, и мы находимся в серверном контексте.
Функция ЭтоВебСервер_СерверныйКонтекст()
	
	ВебСервер_СерверныйКонтекст = Ложь;
	#Если Сервер Тогда
		ВебСервер_СерверныйКонтекст = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоВебСервер();	
	#КонецЕсли
	Возврат ВебСервер_СерверныйКонтекст;
	
КонецФункции

Процедура УстановитьСтатус(Документ, Статус, УказатьПользователя = Ложь, ПроверятьПоследовательностьСтатуса = Ложь, СтруктураОшибки = Неопределено) Экспорт
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьСтатус(Документ, Статус, УказатьПользователя, ПроверятьПоследовательностьСтатуса, СтруктураОшибки);
	
КонецПроцедуры

Функция ПодписатьФайлОбмена(ФайлОбмена, ИспользоватьТолькоСерверные, БезПодписанияНаСервере, ИспользоватьКриптографию1С)
	
	// Заблокировать на сервере
	Попытка
		КонтурЛогистика_ОбработкаДокументовСервер.ЗаблокироватьФайлОбмена(ФайлОбмена);
	Исключение
		Сообщить("Не удалось заблокировать файл обмена для подписания: " + ФайлОбмена);
		Возврат Ложь;
	КонецПопытки;
	
	ДвоичныеДанныеКонтента = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлОбмена);
	
	ДанныеСертификата = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.ДанныеСертификатаДляПодписанияФайла(
		ФайлОбмена, ИспользоватьТолькоСерверные);
	
	// ПМ замена механизма
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ИсходныеДанные", ДвоичныеДанныеКонтента);
	ПараметрыПМ.Вставить("ДанныеСертификата", ДанныеСертификата);
	ПараметрыПМ.Вставить("ФайлОбмена", ФайлОбмена);
	РезультатПМ = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ПодписатьДанные_ЗаменаМеханизма", СтандартнаяОбработка, ПараметрыПМ);
					
	Если СтандартнаяОбработка = Ложь Тогда 
		
		Если Не ЗначениеЗаполнено(РезультатПМ) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если (ПараметрыПМ.ДанныеСертификата.Свойство("Отпечаток") 
				И Не ЗначениеЗаполнено(ПараметрыПМ.ДанныеСертификата.Отпечаток))
			Или (ПараметрыПМ.ДанныеСертификата.Свойство("Представление") 
				И Не ЗначениеЗаполнено(ПараметрыПМ.ДанныеСертификата.Представление)) Тогда
			Сообщить("В процедуре подписания в подключаемом модуле не заполнены отпечаток и представление");
			Возврат Ложь;
		КонецЕсли;
		
		ПараметрыПМ.ДанныеСертификата.Представление = ПараметрыПМ.ДанныеСертификата.Представление + " (подписан внешним сервисом)";
	
		КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьВФайлПодписьИРазблокировать(ФайлОбмена, РезультатПМ, ПараметрыПМ.ДанныеСертификата);
	
		Возврат Истина;
		
	КонецЕсли;
		
	Если ДанныеСертификата.Отпечаток = Неопределено Тогда
		Сообщить("Не могу получить настройки подписания для файла: " + ФайлОбмена
			+ " Проверьте что указан пользователь подписант и сделана настройка подписания!");
		Возврат Ложь;
	КонецЕсли;
	
	ПарольКонтейнера = КонтурЛогистика_ОбщегоНазначенияВызовСервера.ПолучитьПароль(ДанныеСертификата.СертификатСсылка, "ПЗК");
					
	Если ИспользоватьКриптографию1С Тогда
		
		Если ДанныеСертификата.СертификатНаСервере Тогда
			
			ДанныеПодписи = КонтурЛогистика_АдаптацияТолстыйКлиентВызовСервера.КриптографияСервер_ПодписатьДанные(
						ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ДанныеСертификата.ТипМодуляКриптографии, ФайлОбмена);					
						
		ИначеЕсли КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
				
			ДанныеПодписи = КонтурЛогистика_КриптографияСервер.ПодписатьДанные(
				ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ДанныеСертификата.ТипМодуляКриптографии,, ФайлОбмена);		
						
		Иначе
			
			ДанныеПодписи = КонтурЛогистика_КриптографияКлиентСервер.ПодписатьДанные(
				ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ДанныеСертификата.ТипМодуляКриптографии,, ФайлОбмена);
			
		КонецЕсли;
		
	Иначе
		
		Если ДанныеСертификата.СертификатНаСервере Тогда
			
			ДанныеПодписи = КонтурЛогистика_АдаптацияТолстыйКлиентВызовСервера.ИнтеграцияДиадокСервер_ПодписатьФайлОбмена(
				ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ФайлОбмена);	
								
		ИначеЕсли КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
			
			ДанныеПодписи = КонтурЛогистика_ИнтеграцияДиадокСервер.ПодписатьФайлОбмена(
				ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ФайлОбмена);
				
		Иначе
			
			Попытка
				
				МодульКлиента = Вычислить("КонтурЛогистика_ИнтеграцияДиадокКлиент");
				
			Исключение
				
				Сообщить("Не удалось получить данные подписи.");
				Возврат Ложь;
				
			КонецПопытки;
			
			ДанныеПодписи = МодульКлиента.ПодписатьФайлОбмена(ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ФайлОбмена);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеПодписи) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьВФайлПодписьИРазблокировать(ФайлОбмена, ДанныеПодписи, ДанныеСертификата);
	
	Возврат Истина;
	
КонецФункции

Процедура СковознойСценарийПутевогоЛистаТ1234(ФайлОбмена, РеквизитыФайла, ПодписываемыеФайлыОбмена) Экспорт
	
	Если ТипЗнч(РеквизитыФайла.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		Или ТипЗнч(РеквизитыФайла.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		
		// Если подписывается титул 1, то формируем титулы 2, 3 и файлы обмена, который добавляем в подисываемые файлы
		Если ТипЗнч(РеквизитыФайла.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(РеквизитыФайла.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
			
			РеквизитыГлавногоДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
				РеквизитыФайла.ГлавныйДокумент, "ФормироватьТ2Сразу, ФормироватьТ3Сразу");
			
			Если РеквизитыГлавногоДокумента.ФормироватьТ2Сразу Тогда
				ФайлыОбменаТ2 = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьТитул2ИФайлыОбменаСквозногоСценарияПутевогоЛиста(
					РеквизитыФайла.ГлавныйДокумент);
				Если ФайлыОбменаТ2.Количество() <> 0 Тогда
					КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПодписываемыеФайлыОбмена, ФайлыОбменаТ2);
				Иначе
					Сообщить("Не удалось сформировать файл обмена для титула 2 документа " + РеквизитыФайла.ГлавныйДокумент);
				КонецЕсли;
			КонецЕсли;
			
			Если РеквизитыГлавногоДокумента.ФормироватьТ3Сразу Тогда
				ФайлОбменаТ3 = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьТитул3ИФайлОбменаСквозногоСценарияПутевогоЛиста(
					РеквизитыФайла.ГлавныйДокумент);
				Если ЗначениеЗаполнено(ФайлОбменаТ3) Тогда
					ПодписываемыеФайлыОбмена.Добавить(ФайлОбменаТ3);
				Иначе
					Сообщить("Не удалось сформировать файл обмена для титула 3 документа " + РеквизитыФайла.ГлавныйДокумент);
				КонецЕсли;
			КонецЕсли;
			
		// Если подписывается титул 3, то формируем титул 4 и файл обмена, который добавляем в подисываемые файлы
		ИначеЕсли ТипЗнч(РеквизитыФайла.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул3") Тогда
			
			ФормироватьТ4СразуИзТ1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				РеквизитыФайла.ГлавныйДокумент, "ФормироватьТ4Сразу");
			
			Если ФормироватьТ4СразуИзТ1 Тогда
				ФайлОбменаТ4 = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьТитул4ИФайлОбменаСквозногоСценарияПутевогоЛиста(
					РеквизитыФайла.ГлавныйДокумент);
				Если ЗначениеЗаполнено(ФайлОбменаТ4) Тогда
					ПодписываемыеФайлыОбмена.Добавить(ФайлОбменаТ4);
				Иначе
					Сообщить("Не удалось сформировать файл обмена для титула 4 документа " + РеквизитыФайла.ГлавныйДокумент);
				КонецЕсли;
			КонецЕсли;
			
			// Проверяем отказ
			РеквизитыТитула3 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
				РеквизитыФайла.СвязанныйДокумент, "ФормироватьТ4Сразу, ЕстьОтказВПодписи");
			
			Если РеквизитыТитула3.ФормироватьТ4Сразу И Не РеквизитыТитула3.ЕстьОтказВПодписи Тогда
				ФайлОбменаТ4 = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьТитул4ИФайлОбменаСквозногоСценарияПутевогоЛиста(
					РеквизитыФайла.СвязанныйДокумент);
				Если ЗначениеЗаполнено(ФайлОбменаТ4) Тогда
					ПодписываемыеФайлыОбмена.Добавить(ФайлОбменаТ4);
				Иначе
					Сообщить("Не удалось сформировать файл обмена для титула 4 документа " + РеквизитыФайла.СвязанныйДокумент);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СогласоватьФайлыОбмена(МассивФайловОбмена, ИспользоватьТолькоСерверные = Ложь, БезПодписанияНаСервере = Ложь) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() <> "Файловая" Тогда
		
		#Если Сервер Тогда
			ИспользоватьТолькоСерверные = Истина;
		#КонецЕсли
		
	КонецЕсли;
	
	УспешноСогласованныеФайлы = Новый Массив;
	
	ИспользоватьКриптографию1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьКриптографию1С");
	
	Для Каждого ФайлОбмена Из МассивФайловОбмена Цикл
		
		// Проверим заполнение пользователя подписанта
		ПользовательПодписант = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ФайлОбмена, "ГлавныйДокумент.ПользовательПодписант");
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда
			Сообщить("В файле обмена не заполнен пользователь подписант: " + ФайлОбмена);
			Продолжить;
		КонецЕсли;
		
		// Заблокировать на сервере
		Попытка
			КонтурЛогистика_ОбработкаДокументовСервер.ЗаблокироватьФайлОбмена(ФайлОбмена);
		Исключение
			Сообщить("Не удалось заблокировать файл обмена для подписания: " + ФайлОбмена);
			Продолжить;
		КонецПопытки;
		
		ДанныеСертификата = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.ДанныеСертификатаДляСогласованияФайла(
			ФайлОбмена, ИспользоватьТолькоСерверные);
		
		Если ДанныеСертификата.Отпечаток = Неопределено Тогда
			Сообщить("Не могу получить настройки подписания для файла: "
				+ ФайлОбмена + " Проверьте что указан пользователь подписант и сделана настройка подписания!");
			Продолжить;
		КонецЕсли;
		
		ПарольКонтейнера = КонтурЛогистика_ОбщегоНазначенияВызовСервера.ПолучитьПароль(ДанныеСертификата.СертификатСсылка, "ПЗК");
		
		ДвоичныеДанныеКонтента = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлОбмена);
		
		Если ИспользоватьКриптографию1С Тогда
			
			Если ДанныеСертификата.СертификатНаСервере
				Или КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
				
				ДанныеПодписи = КонтурЛогистика_КриптографияСервер.ПодписатьДанные(
					ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ДанныеСертификата.ТипМодуляКриптографии);
			Иначе
				ДанныеПодписи = КонтурЛогистика_КриптографияКлиентСервер.ПодписатьДанные(
					ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера, ДанныеСертификата.ТипМодуляКриптографии);
			КонецЕсли;
			
		Иначе
			
			Если ДанныеСертификата.СертификатНаСервере
				Или КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая" Тогда
				
				ДанныеПодписи = КонтурЛогистика_ИнтеграцияДиадокСервер.ПодписатьФайлОбмена(
					ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера);
			Иначе
			
				Попытка
					МодульКлиента = Вычислить("КонтурЛогистика_ИнтеграцияДиадокКлиент");
				Исключение
					Сообщить("Не удалось получить данные подписи."); 
					Продолжить;
				КонецПопытки;
				
				ДанныеПодписи = МодульКлиента.ПодписатьФайлОбмена(ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера);
				
			КонецЕсли;
			
		КонецЕсли;
		
		КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьВФайлПодписьСогласовавшегоИРазблокировать(
			ФайлОбмена, ДанныеПодписи, ДанныеСертификата);
		
		УспешноСогласованныеФайлы.Добавить(ФайлОбмена);
		
	КонецЦикла;
	
	Возврат УспешноСогласованныеФайлы;
	
КонецФункции
