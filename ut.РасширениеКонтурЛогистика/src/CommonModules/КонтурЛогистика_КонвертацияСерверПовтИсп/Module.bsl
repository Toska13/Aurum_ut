
Функция ДвижокКонвертации_ВыполнитьЗапросКонвертации(Знач ВычисленноеЗначение, Знач СпособКонвертацииЗначения) Экспорт
	
	Перем Запрос, РезультатЗапроса;
	
	СсылкаНаОбъектЛогистика = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." +
	Перечисления.КонтурЛогистика_СпособыКонвертации.ИмяСправочникаЛогистикаПоСпособуКонвертации(СпособКонвертацииЗначения) 
	+ ".СвязанныеОбъекты КАК КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка.ПометкаУдаления
	|	И (КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.СвязанныйОбъект = &СвязанныйОбъект
	|		Или КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.УИД = &УИД)";
	
	Запрос.УстановитьПараметр("СвязанныйОбъект", ВычисленноеЗначение);
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоТипСсылка(ТипЗнч(ВычисленноеЗначение)) Тогда
		Запрос.УстановитьПараметр("УИД", Строка(ВычисленноеЗначение.УникальныйИдентификатор()));
	Иначе
		Запрос.УстановитьПараметр("УИД", Неопределено);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		СсылкаНаОбъектЛогистика = Выборка.Ссылка;
	Иначе
		ВызватьИсключение "Нет соответствия"; // чтобы не запомнить повт исп!
	КонецЕсли;
	
	Возврат СсылкаНаОбъектЛогистика;
	
КонецФункции
