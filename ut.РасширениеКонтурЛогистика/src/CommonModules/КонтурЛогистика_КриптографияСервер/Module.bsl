Функция ПолучитьТипыМодуляКриптографии() Экспорт
	
	КриптоПроГОСТ2011 = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");
	КриптоПроГОСТ2011.Вставить("ТипМодуляКриптографии", 75);
	КриптоПроГОСТ2011.Вставить("ИмяМодуляКриптографии", "Crypto-Pro GOST R 34.10-2001 Cryptographic Service Provider");
	КриптоПроГОСТ2011.Вставить("ИмяДляВыбора", "Crypto-Pro GOST R 34.10-2001 Cryptographic Service Provider");
	
	КриптоПроГОСТ2012 = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");
	КриптоПроГОСТ2012.Вставить("ТипМодуляКриптографии", 80);
	КриптоПроГОСТ2012.Вставить("ИмяМодуляКриптографии", "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider");
	КриптоПроГОСТ2012.Вставить("ИмяДляВыбора", "КриптоПро CSP (ГОСТ 2012/256)");

	КриптоПроГОСТ2012Усиленный = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");
	КриптоПроГОСТ2012Усиленный.Вставить("ТипМодуляКриптографии", 81);
	КриптоПроГОСТ2012Усиленный.Вставить("ИмяМодуляКриптографии", 
		"Crypto-Pro GOST R 34.10-2012 Strong Cryptographic Service Provider");
	КриптоПроГОСТ2012Усиленный.Вставить("ИмяДляВыбора", "КриптоПро CSP (ГОСТ 2012/512)");
	
	КриптоПроФКН = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");
	КриптоПроФКН.Вставить("ТипМодуляКриптографии", 75);
	КриптоПроФКН.Вставить("ИмяМодуляКриптографии", "GOST R 34.10-2001 eToken CSP");
	КриптоПроФКН.Вставить("ИмяДляВыбора", "GOST R 34.10-2001 eToken CSP");
	
	КриптоПроРутокен = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");
	КриптоПроРутокен.Вставить("ТипМодуляКриптографии", 75);
	КриптоПроРутокен.Вставить("ИмяМодуляКриптографии", "GOST R 34.10-2001 Rutoken CSP");
	КриптоПроРутокен.Вставить("ИмяДляВыбора", "GOST R 34.10-2001 Rutoken CSP");
	
	ВИПНетГОСТ2011 = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");		
	ВИПНетГОСТ2011.Вставить("ТипМодуляКриптографии", 2);
	ВИПНетГОСТ2011.Вставить("ИмяМодуляКриптографии", "Infotecs Cryptographic Service Provider");
	ВИПНетГОСТ2011.Вставить("ИмяДляВыбора", "ViPNet CSP (ГОСТ 2001)");
	
	ВИПНетГОСТ2012 = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");		
	ВИПНетГОСТ2012.Вставить("ТипМодуляКриптографии", 77);
	ВИПНетГОСТ2012.Вставить("ИмяМодуляКриптографии", "Infotecs GOST 2012/512 Cryptographic Service Provider");
	ВИПНетГОСТ2012.Вставить("ИмяДляВыбора", "ViPNet CSP (ГОСТ 2012/256)");
	
	ВИПНетГОСТ2012Усиленный = Новый Структура("ИмяМодуляКриптографии, ТипМодуляКриптографии");		
	ВИПНетГОСТ2012Усиленный.Вставить("ТипМодуляКриптографии", 78);
	ВИПНетГОСТ2012Усиленный.Вставить("ИмяМодуляКриптографии", "Infotecs GOST 2012/1024 Cryptographic Service Provider");
	ВИПНетГОСТ2012Усиленный.Вставить("ИмяДляВыбора", "ViPNet CSP (ГОСТ 2012/512)");
	
	ПоддерживаемыеТипы = Новый Массив;
	ПоддерживаемыеТипы.Добавить(КриптоПроГОСТ2012);
	ПоддерживаемыеТипы.Добавить(КриптоПроГОСТ2012Усиленный);
	ПоддерживаемыеТипы.Добавить(КриптоПроГОСТ2011);
	//ПоддерживаемыеТипы.Добавить(КриптоПроФКН);
	//ПоддерживаемыеТипы.Добавить(КриптоПроРутокен);
	ПоддерживаемыеТипы.Добавить(ВИПНетГОСТ2011);
	ПоддерживаемыеТипы.Добавить(ВИПНетГОСТ2012);
	ПоддерживаемыеТипы.Добавить(ВИПНетГОСТ2012Усиленный);
	
	Возврат ПоддерживаемыеТипы;
	
КонецФункции

