Функция ПодписатьФайлОбмена(ДвоичныеДанныеКонтента, Отпечаток, ПарольКонтейнера, ФайлОбмена = Неопределено, ВернутьОшибку = Ложь) Экспорт 
	
	Попытка
		
		Возврат ЯдроНаКлиенте().ПодписатьДанные(ДвоичныеДанныеКонтента, Отпечаток, ПарольКонтейнера, ФайлОбмена, ВернутьОшибку);
		
	Исключение
		
		Если ЗначениеЗаполнено(ФайлОбмена) Тогда
			ТипДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				ФайлОбмена, "ТипДокумента");
		Иначе
			ТипДокумента = Неопределено;
		КонецЕсли;
		
		КонтурЛогистика_Метрика.ОбработатьОшибкуТипаДокумента(
			"ПодписатьФайлОбменаНаКлиенте", ТипДокумента, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), ФайлОбмена);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции

#Если Не ТолстыйКлиентОбычноеПриложение И Не ТолстыйКлиентУправляемоеПриложение Тогда

// Подписать файлы обмена асинхронно. Выберет подходящий сертификат и подпишет файл на вебклиенте.
//
// Параметры:
//  МассивФайловОбмена       		- Массив - КонтурЛогистика_ФайлыОбмена.Ссылка - массив файлов которые нужно подписать
//  Оповещение                      - ОписаниеОповещение - процедура, которая выполнится после формирования массива подписанных файлов
//  ИспользоватьТолькоСерверные   	- Булево - Ложь - выбрать сертификат среди всех (и клиентских и серверных)
//                                             Истина - выбрать только серверный сертификат
//
Процедура ПодписатьФайлыОбменаАсинхронно(МассивФайловОбмена, Оповещение, ИспользоватьТолькоСерверные = Ложь) Экспорт
	
	УспешноПодписанныеФайлы = Новый Массив;
	
	Шаблоны = КонтурЛогистика_ОбщегоНазначенияСервер.ШаблоныВМассивеФайлов(МассивФайловОбмена);
	
	// Если какие-то из переданных файлов:
	//	входящие неподписанные или исходящие, отправленные неподписанными,
	//	то такие файлы надо не подписывать напрямую а патчить
	ФайлыКПодготовке = КонтурЛогистика_ОбработкаДокументовСервер.НайтиФайлыКоторыеТребуетсяПатчить(МассивФайловОбмена);
	КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьКПодписаниюФайлыОбменаПатчем(ФайлыКПодготовке);
	
	Для Каждого ФайлОбмена Из МассивФайловОбмена Цикл 
		
		Если Не Шаблоны.Найти(ФайлОбмена) = Неопределено Тогда
			УспешноПодписанныеФайлы.Добавить(ФайлОбмена);
			Продолжить;
		КонецЕсли;
		
		// Заблокировать на сервере
		Попытка
			КонтурЛогистика_ОбработкаДокументовСервер.ЗаблокироватьФайлОбмена(ФайлОбмена);
		Исключение
			Сообщить("Не удалось заблокировать файл обмена для подписания: " + ФайлОбмена);
			Продолжить;
		КонецПопытки;
		
		ДанныеСертификата = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.ДанныеСертификатаДляПодписанияФайла(ФайлОбмена, ИспользоватьТолькоСерверные);
		
		Если ДанныеСертификата.Отпечаток = Неопределено Тогда
			Сообщить("Не могу получить настройки подписания для файла: " + ФайлОбмена
				+ " Проверьте что указан пользователь подписант и сделана настройка подписания!");
			Продолжить;
		КонецЕсли;
		
		ПарольКонтейнера = КонтурЛогистика_ОбщегоНазначенияВызовСервера.ПолучитьПароль(ДанныеСертификата.СертификатСсылка, "ПЗК");
		
		ДвоичныеДанныеКонтента = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлОбмена);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ФайлОбмена", ФайлОбмена);
		ДополнительныеПараметры.Вставить("ДанныеСертификата", ДанныеСертификата);
		ДополнительныеПараметры.Вставить("УспешноПодписанныеФайлы", УспешноПодписанныеФайлы);
		ДополнительныеПараметры.Вставить("ОповещениеОтправки", Оповещение);
		ДополнительныеПараметры.Вставить("ПоследнийФайл", ?(ФайлОбмена = МассивФайловОбмена[МассивФайловОбмена.Количество() - 1], Истина, Ложь));
		
		Если ДанныеСертификата.СертификатНаСервере Тогда
			
			ДанныеПодписи = КонтурЛогистика_ИнтеграцияДиадокСервер.ПодписатьФайлОбмена(
				ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера);
			
			ПодписатьЗавершение(ДанныеПодписи, ДополнительныеПараметры);
			
		Иначе
			
			ОповещениеЗавершенияПодписания = Новый ОписаниеОповещения("ПодписатьЗавершение", КонтурЛогистика_ИнтеграцияДиадокКлиент,
				ДополнительныеПараметры, "ПодписатьЗавершениеОшибка", КонтурЛогистика_ИнтеграцияДиадокКлиент);
			КонтурЛогистика_КриптографияКлиент.ПодписатьАсинхронно(
				ОповещениеЗавершенияПодписания, ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток,
				ДанныеСертификата.ТипМодуляКриптографии, ДанныеСертификата.ИмяМодуляКриптографии, 
				ПарольКонтейнера, ДанныеСертификата.ВводитьПарольВПрограммеЭлектроннойПодписи);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СогласоватьФайлыОбменаАсинхронно(ФайлыОбмена, Оповещение, ИспользоватьТолькоСерверные = Ложь) Экспорт
	
	УспешноСогласованныеФайлы = Новый Массив;
	
	Для Каждого ФайлОбмена Из ФайлыОбмена Цикл
		
		// Проверим заполнение пользователя подписанта
		ПользовательПодписант = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ФайлОбмена, "ГлавныйДокумент.ПользовательПодписант");
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда
			Сообщить("В файле обмена не заполнен пользователь подписант: " + ФайлОбмена);
			Продолжить;
		КонецЕсли;
		
		// Заблокировать на сервере
		Попытка
			КонтурЛогистика_ОбработкаДокументовСервер.ЗаблокироватьФайлОбмена(ФайлОбмена);
		Исключение
			Сообщить("Не удалось заблокировать файл обмена для подписания: " + ФайлОбмена);
			Продолжить;
		КонецПопытки;
		
		ДанныеСертификата = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.ДанныеСертификатаДляСогласованияФайла(
			ФайлОбмена, ИспользоватьТолькоСерверные);
		
		Если ДанныеСертификата.Отпечаток = Неопределено Тогда
			Сообщить("Не могу получить настройки подписания для файла: "
				+ ФайлОбмена + " Проверьте что указан пользователь подписант и сделана настройка подписания!");
			Продолжить;
		КонецЕсли;
		
		ПарольКонтейнера = КонтурЛогистика_ОбщегоНазначенияВызовСервера.ПолучитьПароль(ДанныеСертификата.СертификатСсылка, "ПЗК");
		
		ДвоичныеДанныеКонтента = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлОбмена);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ФайлОбмена", ФайлОбмена);
		ДополнительныеПараметры.Вставить("ДанныеСертификата", ДанныеСертификата);
		ДополнительныеПараметры.Вставить("УспешноСогласованныеФайлы", УспешноСогласованныеФайлы);
		ДополнительныеПараметры.Вставить("ОповещениеОтправки", Оповещение);
		ДополнительныеПараметры.Вставить("ПоследнийФайл", ?(ФайлОбмена = ФайлыОбмена[ФайлыОбмена.Количество() - 1], Истина, Ложь));
		
		Если ДанныеСертификата.СертификатНаСервере Тогда
			
			ДанныеПодписи = КонтурЛогистика_ИнтеграцияДиадокСервер.ПодписатьФайлОбмена(
				ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток, ПарольКонтейнера);
			
			СогласованиеЗавершение(ДанныеПодписи, ДополнительныеПараметры);
			
		Иначе
			
			ОповещениеЗавершенияПодписания = Новый ОписаниеОповещения("СогласованиеЗавершение", КонтурЛогистика_ИнтеграцияДиадокКлиент, ДополнительныеПараметры);
			КонтурЛогистика_КриптографияКлиент.ПодписатьАсинхронно(
				ОповещениеЗавершенияПодписания, ДвоичныеДанныеКонтента, ДанныеСертификата.Отпечаток,
				ДанныеСертификата.ТипМодуляКриптографии, ДанныеСертификата.ИмяМодуляКриптографии,
				ПарольКонтейнера, ДанныеСертификата.ВводитьПарольВПрограммеЭлектроннойПодписи);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СогласованиеЗавершение(ДанныеПодписи, ДополнительныеПараметры) Экспорт
	
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьВФайлПодписьСогласовавшегоИРазблокировать(
		ДополнительныеПараметры.ФайлОбмена, ДанныеПодписи, ДополнительныеПараметры.ДанныеСертификата);
	
	ДополнительныеПараметры.УспешноСогласованныеФайлы.Добавить(ДополнительныеПараметры.ФайлОбмена);
	
	Если ДополнительныеПараметры.ПоследнийФайл Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОтправки, ДополнительныеПараметры.УспешноСогласованныеФайлы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодписатьЗавершение(ДанныеПодписи, ДополнительныеПараметры) Экспорт
	
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьВФайлПодписьИРазблокировать(
		ДополнительныеПараметры.ФайлОбмена, ДанныеПодписи, ДополнительныеПараметры.ДанныеСертификата);
	
	РеквизитыФайла = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		ДополнительныеПараметры.ФайлОбмена, "ГлавныйДокумент, СвязанныйДокумент");
	
	КонтурЛогистика_ОбработкаДокументовСервер.УстановитьСтатус(
		РеквизитыФайла.СвязанныйДокумент,
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Подписан"),
		Истина,
		Истина);
	
	ДополнительныеПараметры.УспешноПодписанныеФайлы.Добавить(ДополнительныеПараметры.ФайлОбмена);
	
	// Сквозной сценарий путевых листов Т1-Т4
	ПодписываемыеФайлыОбмена = Новый Массив;
	
	КонтурЛогистика_ИнтеграцияДиадокКлиентСервер.СковознойСценарийПутевогоЛистаТ1234(ДополнительныеПараметры.ФайлОбмена, РеквизитыФайла, ПодписываемыеФайлыОбмена);
	
	Если ПодписываемыеФайлыОбмена.Количество() <> 0 Тогда
		// Подписываем сформированные файлы
		ПодписатьФайлыОбменаАсинхронно(ПодписываемыеФайлыОбмена, ДополнительныеПараметры.ОповещениеОтправки);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ПоследнийФайл Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОтправки, ДополнительныеПараметры.УспешноПодписанныеФайлы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодписатьЗавершениеОшибка(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ИнформацияОбОшибке.Причина = Неопределено Тогда
		Описание = ИнформацияОбОшибке.Описание;
	Иначе
		Описание = ИнформацияОбОшибке.Причина.Описание;
	КонецЕсли;
	
	КодОшибки = КонтурЛогистика_КриптографияКлиентСервер.КодОшибкиМенеджераКриптографии(Описание);
	
	ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	
	ТипДокумента = Неопределено;
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ФайлОбмена) Тогда
		КонтурЛогистика_КриптографияСервер.ДобавитьОшибкуКриптографииВСтатусТитула(
			ДополнительныеПараметры.ФайлОбмена, КодОшибки,
			ТекстОшибки, "Ошибка подписания менеджером криптографии 1С");
		ТипДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			ДополнительныеПараметры.ФайлОбмена, "ТипДокумента");
	КонецЕсли;
	
	Сообщить(ТекстОшибки);
	
	КонтурЛогистика_Метрика.ОбработатьОшибкуТипаДокумента(
		"ПодписатьФайлыОбменаАсинхронно", ТипДокумента, ТекстОшибки, ДополнительныеПараметры.ФайлОбмена);
	
	Оповестить("КонтурЛогистика_ОбновитьЗадачи");
	Оповестить("КонтурЛогистика_ОбновитьДокументЛогистики");
	
КонецПроцедуры

