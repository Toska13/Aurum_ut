Функция ПолучитьМассивОбъектовМетаданныхСДополнительнымиРеквизитами() Экспорт
	
	МассивОбъектов = Новый Массив;
	
	Для каждого ОбъектМетаданных Из Метаданные.Справочники Цикл
		
		Если Лев(ОбъектМетаданных.Имя, 16) = "КонтурЛогистика_" Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			
			Если Реквизит.РасширениеКонфигурации() <> Неопределено
				И Реквизит.РасширениеКонфигурации().Имя = "РасширениеКонтурЛогистика_ДополнительныеРеквизиты" Тогда 
				
				МассивОбъектов.Добавить(ОбъектМетаданных);
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого ТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
			
			Для каждого Реквизит Из ТЧ.Реквизиты Цикл
				
				Если Реквизит.РасширениеКонфигурации() <> Неопределено
					И Реквизит.РасширениеКонфигурации().Имя = "РасширениеКонтурЛогистика_ДополнительныеРеквизиты" Тогда 
				
					МассивОбъектов.Добавить(ОбъектМетаданных);
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		
		Для каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			
			Если Реквизит.РасширениеКонфигурации() <> Неопределено
				И Реквизит.РасширениеКонфигурации().Имя = "РасширениеКонтурЛогистика_ДополнительныеРеквизиты" Тогда 
				
				МассивОбъектов.Добавить(ОбъектМетаданных);
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого ТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
			
			Для каждого Реквизит Из ТЧ.Реквизиты Цикл
				
				Если Реквизит.РасширениеКонфигурации() <> Неопределено
					И Реквизит.РасширениеКонфигурации().Имя = "РасширениеКонтурЛогистика_ДополнительныеРеквизиты" Тогда 
				
					МассивОбъектов.Добавить(ОбъектМетаданных);
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат МассивОбъектов;
	
КонецФункции

Функция ПолучитьТипЛогистикиДополнительногоРеквизита(ИмяРеквизита)  Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Имя", КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСервер.ИмяДополнительногоРасширенияДополнительныеРеквизитыПоИмениКонфигурации(ИмяКонфигурации));
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПроверитьВозможностьХраненияРасширений() Тогда
		Если РасширенияКонфигурации.Получить(Отбор).Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		КонтурЛогистика_ДопРеквизиты = Вычислить("КонтурЛогистика_ДопРеквизиты_Манифест");
		СтруктураДополнительныхРеквизитов = КонтурЛогистика_ДопРеквизиты.СтруктураДополнительныхРеквизитов();
	Исключение
		Возврат Неопределено	
	КонецПопытки;
	
	Если СтруктураДополнительныхРеквизитов.Свойство(ИмяРеквизита)
		И СтруктураДополнительныхРеквизитов[ИмяРеквизита].ТипЛогистика = Истина 
		И СтруктураДополнительныхРеквизитов[ИмяРеквизита].Свойство("Тип") Тогда
		
		ТипРеквизита = СтруктураДополнительныхРеквизитов[ИмяРеквизита].Тип;
		
		Если Найти(ТипРеквизита, "КонтурЛогистика_") > 0 Тогда
			Возврат ТипРеквизита;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция РасширениеСДополнительнымиРеквизитамиУстановлено() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоРежимСовместимости_8_2() Тогда
		Возврат Ложь;
	Иначе
		Возврат РасширенияКонфигурации.Получить(Новый Структура("Имя", "РасширениеКонтурЛогистика_ДополнительныеРеквизиты")).Количество() = 1;
	КонецЕсли;
	
КонецФункции