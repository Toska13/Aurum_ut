	ПараметрыЗапроса.ТелоЗапроса = КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(НастройкиОрганизации);
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
