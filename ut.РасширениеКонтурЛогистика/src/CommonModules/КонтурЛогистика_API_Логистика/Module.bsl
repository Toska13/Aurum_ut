// Подготавливает файлы для отправки
//
// Параметры:
//  ДанныеФайлов - Структура - см. функцию МанифестФайловДляПодготовки
// 
// Возвращаемое значение:
//  Массив - массив подготовленных файлов 
//
Функция ПодготовитьФайлы(ДанныеФайлов) Экспорт 
	
	Результат = Новый Массив;
	
	// Пока апи логистики поддерживает draft (неподписанный) только для Т3
	Если ЗначениеЗаполнено(ДанныеФайлов.ТипДокумента)
		И (ДанныеФайлов.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 
			ИЛИ ДанныеФайлов.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1)
		И Не ЗначениеЗаполнено(ДанныеФайлов.Подпись) Тогда
		
		ИмяФайлаТитула = "draft";
	Иначе
		ИмяФайлаТитула = "formFiles";
	КонецЕсли;
	
	ФайлТитула = Новый Структура;
	ФайлТитула.Вставить("Имя", ИмяФайлаТитула);
	ФайлТитула.Вставить("Данные", ДанныеФайлов.Титул);
	ФайлТитула.Вставить("ИмяФайла", ДанныеФайлов.ИмяФайла + ".xml");
	ФайлТитула.Вставить("Тип", "multipart/form-data");
	
	Результат.Добавить(ФайлТитула);
	
	Если ЗначениеЗаполнено(ДанныеФайлов.Подпись) Тогда
		
		ФайлПодписи = Новый Структура;
		ФайлПодписи.Вставить("Имя", "formFiles");
		ФайлПодписи.Вставить("Данные", ДанныеФайлов.Подпись);
		ФайлПодписи.Вставить("ИмяФайла", ДанныеФайлов.ИмяФайла + ".sig");
		ФайлПодписи.Вставить("Тип", "multipart/form-data");
		
		Результат.Добавить(ФайлПодписи);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

