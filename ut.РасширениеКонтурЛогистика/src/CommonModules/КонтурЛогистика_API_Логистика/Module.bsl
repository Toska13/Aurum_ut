//  diadocBoxId		 - Строка	 - Идентификатор ящика в Диадоке
// 
// Возвращаемое значение:
//  Структура - содержит настройки организации
//
Функция ПолучитьНастройкиОрганизации(Знач ПараметрыСервиса, diadocBoxId) Экспорт
	
	// get /v1/epl/organizations/{diadocBoxId}/settings
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	ПараметрыЗапроса.АдресМетода = "/v1/epl/organizations/{diadocBoxId}/settings";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{diadocBoxId}", diadocBoxId);
	
