	Результат = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

// Получает ленту событий ЭТрН
//
// Параметры:
//  ПараметрыСервиса - Структура 	- Структура, содержащая параметры сервиса. Например, ApiKey 
//  FromId			 - Строка 		- Идентификатор события, с которого продолжить чтение
//  FromDt			 - Дата 		- Значение даты и времени, с которого продолжить чтение. 
//									  Будет использовано, если не указано значение поля FromId
//  Count			 - Число 		- Количество запрашиваемых событий, не больше 1000
// 
// Возвращаемое значение:
//  Результат - содержит массив событий ленты 
//
Функция ПолучитьЛентуСобытий(Знач ПараметрыСервиса, Знач FromId = Неопределено, Знач FromDt = Неопределено, Знач Count = Неопределено) Экспорт 
	
	// /v1/events
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/v1/events";
	
	Если ЗначениеЗаполнено(FromId) Тогда
		ПараметрыЗапроса.Параметры.Вставить("FromId", FromId);
	Иначе
		Если ЗначениеЗаполнено(FromDt) Тогда
			ПараметрыЗапроса.Параметры.Вставить("FromDt", УниверсальнаяДата(FromDt));
		КонецЕсли;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Count) Тогда
		Count = 10;
	КонецЕсли;
	
	ПараметрыЗапроса.Параметры.Вставить("Count", Формат(Count,"ЧГ="));
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат.Получить("events");
	
КонецФункции

// Получает ленту событий путевых листов
//
// Параметры:
//  ПараметрыСервиса - Структура 	- Структура, содержащая параметры сервиса. Например, ApiKey 
//  FromId			 - Строка 		- Идентификатор события, с которого продолжить чтение
//  FromDt			 - Дата 		- Значение даты и времени, с которого продолжить чтение. 
//									  Будет использовано, если не указано значение поля FromId
//  Count			 - Число 		- Количество запрашиваемых событий, не больше 1000
// 
// Возвращаемое значение:
//  Результат - содержит массив событий ленты
//
Функция ПолучитьЛентуСобытийПутевыхЛистов(Знач ПараметрыСервиса, diadocBoxId, FromId = Неопределено, FromDt = Неопределено, Count = Неопределено) Экспорт
	
	// /v1/epls/news/by-diadoc-box-id/{diadocBoxId}
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/v1/epls/news/by-diadoc-box-id/" + diadocBoxId;
	
	Если ЗначениеЗаполнено(FromId) Тогда
		ПараметрыЗапроса.Параметры.Вставить("afterEventId", FromId);
	Иначе
		Если ЗначениеЗаполнено(FromDt) Тогда
			Результат = ПолучитьИдентификаторСобытияЛентыПутевогоЛиста(ПараметрыСервиса, diadocBoxId, УниверсальнаяДата(FromDt));
			
			ПараметрыЗапроса.Параметры.Вставить("afterEventId", Результат.Получить("eventId"));
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Count) Тогда
		Count = 10;
	КонецЕсли;
	
	ПараметрыЗапроса.Параметры.Вставить("Count", Формат(Count,"ЧГ="));
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если ПараметрыЗапроса.Параметры.Свойство("DiadocBoxId") Тогда
		ПараметрыЗапроса.Параметры.Удалить("DiadocBoxId");
	КонецЕсли;
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат.Получить("events");
	
КонецФункции

