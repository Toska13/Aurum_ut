// Отправляет готовый титул транспортной накладной с подписью или без нее 
//
// Параметры:
//  ПараметрыСервиса  - Структура - Структура, содержащая параметры сервиса. Например, ApiKey
//  Файлы             - Массив    - Массив, подготовленный файлов
//  ИдентификаторЭТрН - Строка    - Идентификатор ЭТРН в Логистике (transportationId)
// 
// Возвращаемое значение:
//  Результат - содержит kl-id созданной ТрН
//
Функция ОтправитьТитулТрН(Знач ПараметрыСервиса, Знач Файлы, Знач ИдентификаторЭТрН = Неопределено) Экспорт
	
	// /v1/documents/waybill
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/v1/documents/waybill";
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
	
	Если ИдентификаторЭТрН <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("transportationId", ИдентификаторЭТрН);
	КонецЕсли;
	
	ПараметрыЗапроса.ТелоЗапроса = ЗакодироватьФайлы(Файлы, Разделитель);
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	ЧислоПопыток = 5;
	Для й = 1 По ЧислоПопыток Цикл 
	
		Попытка
			
			Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
			Прервать;
			
		Исключение
			
			// плавающий баг на стороне сервиса
			текОписаниеОшибки = ОписаниеОшибки();
			Если Найти(текОписаниеОшибки, "Object reference not set to an instance of an object") = 0
				Или й = ЧислоПопыток Тогда // получили неизвестную ошибку или последняя попытка тоже неудачна
				ВызватьИсключение текОписаниеОшибки;
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ОбработатьРезультатЗапроса(Результат, Ответ, "ТитулТрН");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьРезультатЗапроса(Результат, Ответ, ТипТитула)
	
	Если Ответ.Свойство("КодОтветаДопустимый") Тогда 
	
		РезультатСтруктура = JsonПрочитать(Ответ.ТелоОтвета);
			
		Результат.Вставить("ТелоОтвета", 			Ответ.ТелоОтвета);
		Результат.Вставить("КодСостояния", 			Ответ.КодОтвета);
		Результат.Вставить("Успешно", 				Ответ.КодОтветаДопустимый);
		
		Если Ответ.КодОтветаДопустимый Тогда
		   		
			Результат.Вставить("РезультатОтправки", РезультатСтруктура);		
			
			Если ТипТитула = "ТитулТрН" Тогда
				Результат.Вставить("transportationId", РезультатСтруктура.Получить("transportationId"));
			ИначеЕсли ТипТитула = "ТитулПЛ" Тогда
				Результат.Вставить("eplId", РезультатСтруктура.Получить("eplId"));
			ИначеЕсли ТипТитула = "ЧерновикТитулаТрН" Тогда
				Результат.Вставить("transportationId", РезультатСтруктура.Получить("transportationId"));
				Результат.Вставить("draftId", РезультатСтруктура.Получить("draftId"));
			КонецЕсли;
			
			ДобавитьДатуОтветаСервиса(Ответ, Результат);
			
		Иначе
			
			Результат.Вставить("ОписаниеОшибки", Ответ.ПодробноеОписаниеОшибки);
			Результат.Вставить("РезультатОтправки", Ответ);
			
		КонецЕсли;
		
	Иначе
		
		Результат.Вставить("Успешно", Ложь);
		Результат.Вставить("ОписаниеОшибки", Ответ.ПодробноеОписаниеОшибки);
		Результат.Вставить("РезультатОтправки", Ответ);	
		
	КонецЕсли;	
	
КонецПроцедуры

// Отправляет готовый титул путевого листа с подписью
//
// Параметры:
//  ПараметрыСервиса  - Структура - Структура, содержащая параметры сервиса. Например, ApiKey
//  Файлы             - Массив    - Массив, подготовленный файлов
// 
// Возвращаемое значение:
//  Результат - См. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция ОтправитьТитулПутевогоЛиста(Знач ПараметрыСервиса, Знач Файлы, Знач ИдентификаторЭПЛ = Неопределено) Экспорт
	
	// /v1/documents/epl
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод = "POST";
	ПараметрыЗапроса.АдресМетода = "/v1/documents/epl";
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
	ПараметрыЗапроса.ТелоЗапроса = ЗакодироватьФайлы(Файлы, Разделитель);
	
	Если ИдентификаторЭПЛ <> Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("eplId", ИдентификаторЭПЛ);
	КонецЕсли;
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если ПараметрыЗапроса.Параметры.Свойство("DiadocBoxId") Тогда
		ПараметрыЗапроса.Параметры.Удалить("DiadocBoxId");
	КонецЕсли;
	
	// Для поддержания обработки подряд отправляемых титулов сервис может держать соединение
	// до 60 секунд, пока идет обработка документа
	ПараметрыСервиса.Таймаут = 60;
	
	// Первая попытка
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(504);	// Один тайм-аут допускаем
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 504 Тогда
		// Вторая попытка
		ИндексКода = ПараметрыЗапроса.ДопустимыеКодыОтвета.Найти(504);
		Если ИндексКода <> Неопределено Тогда
			ПараметрыЗапроса.ДопустимыеКодыОтвета.Удалить(ИндексКода);
		КонецЕсли;
		
		Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	КонецЕсли;
	
	ОбработатьРезультатЗапроса(Результат, Ответ, "ТитулПЛ");
	
	Возврат Результат;
	
КонецФункции

// Отправляет черновик транспортной накладной без подписи
//
// Параметры:
//  ПараметрыСервиса  - Структура - Структура, содержащая параметры сервиса. Например, ApiKey 
//  Файлы             - Массив    - Массив, подготовленный файлов
//  ИдентификаторЭТрН - Строка    - Идентификатор ЭТРН в Логистике (transportationId)
// 
// Возвращаемое значение:
// 	Результат - содержит kl-id созданной ТрН 
//
Функция ОтправитьНеподписанныйТитулТрН(Знач ПараметрыСервиса, Знач Файлы, Знач ИдентификаторЭТрН = Неопределено, draftAction = Неопределено) Экспорт
	
	// /v1/documents/waybill/draft
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/v1/documents/waybill/draft";
	
	Если ИдентификаторЭТрН <> Неопределено И ИдентификаторЭТрН <> "" Тогда 
		ПараметрыЗапроса.Параметры.Вставить("transportationId", ИдентификаторЭТрН);
	КонецЕсли;
	
	Если draftAction <> Неопределено И draftAction <> "" Тогда
		ПараметрыЗапроса.Параметры.Вставить("draftAction", draftAction);
	КонецЕсли;
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
	
	ПараметрыЗапроса.ТелоЗапроса = ЗакодироватьФайлы(Файлы, Разделитель);
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	ЧислоПопыток = 5;
	Для й = 1 По ЧислоПопыток Цикл 
	
		Попытка
			
			Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
			Прервать;
			
		Исключение
			
			// плавающий баг на стороне сервиса
			текОписаниеОшибки = ОписаниеОшибки();
			Если Найти(текОписаниеОшибки, "Object reference not set to an instance of an object") = 0
				Или й = ЧислоПопыток Тогда // получили неизвестную ошибку или последняя попытка тоже неудачна
				ВызватьИсключение текОписаниеОшибки;
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ОбработатьРезультатЗапроса(Результат, Ответ, "ЧерновикТитулаТрН");
	
	Возврат Результат
	
КонецФункции

