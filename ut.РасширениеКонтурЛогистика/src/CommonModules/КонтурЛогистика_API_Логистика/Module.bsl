// Получение сведений о перевозках
//
// Параметры:
//  ПараметрыСервиса - Структура	- Структура, содержащая параметры сервиса. Например, ApiKey
//  DateFrom		 - Дата 		- Дата и время начала периода
//  DateTo			 - Дата 		- Дата и время окончания периода. По умолчанию используется текущая дата
//  Status			 - Строка       - Требуемый статус перевозок
//  Skip			 - Число	 	- Количество записей, которые надо пропустить
//  Take			 - Число 		- 
//  TimeKind		 - Строка 		- Тип фильтрации по периоду. По умолчанию - фильтрация по дате изменения.
//								      Принимает значения: "Modified" и "Created" 
//  SortDirection	 - Строка	 	- Способ сортировки. По умолчанию: Descending  
// 									  Принимает значения: "Descending" и "Ascending"
// 
// Возвращаемое значение:
//  Результат - Структура, содержащая сведения о перевозках 
//
Функция ПолучитьСведенияОПеревозках(Знач ПараметрыСервиса, 
									Знач DateFrom = Неопределено, 
									Знач DateTo = Неопределено, 
									Знач Status = Неопределено, 
									Знач Skip = Неопределено, 
									Знач Take = 200, 
									Знач TimeKind = "Modified", 
									Знач SortDirection = "Descending") Экспорт 
	
	// /v1/transportations
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/v1/transportations";
	
	ПараметрыЗапроса.Параметры.Вставить("Take", 			Take);
	ПараметрыЗапроса.Параметры.Вставить("TimeKind", 		TimeKind);
	ПараметрыЗапроса.Параметры.Вставить("SortDirection", 	SortDirection);
	
	Если ЗначениеЗаполнено(DateFrom) Тогда 
		ПараметрыЗапроса.Параметры.Вставить("From", УниверсальнаяДата(DateFrom));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(DateTo) Тогда 
		DateTo = ТекущаяДатаСеанса();
	КонецЕсли;	
	ПараметрыЗапроса.Параметры.Вставить("To", УниверсальнаяДата(DateTo));
		
	Если ЗначениеЗаполнено(Status) Тогда 
		ПараметрыЗапроса.Параметры.Вставить("Status", Status);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Skip) Тогда 
		ПараметрыЗапроса.Параметры.Вставить("Skip", Skip);
	КонецЕсли;
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

