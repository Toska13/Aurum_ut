// Сохранение показаний топлива на выезде
//
// Параметры:
//  ПараметрыСервиса  - Структура - Структура, содержащая параметры сервиса. Например, ApiKey
//  eplId             - Строка    - Идентификатор перевозки
//  Показания         - Структура - Показания топлива, см. КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.НовоеПоказанияТоплива
// 
// Возвращаемое значение:
//  Результат - Структура, содержащая сведения о показаниях топлива
//              См. КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.НовоеПоказанияТоплива
//
Функция СохраненитьПоказанияТопливаНаВыезде(Знач ПараметрыСервиса, Знач eplId, Знач Показания, Знач ДатаДанных) Экспорт
	
	// post /v1/epls/{eplId}/pre-trip/fuel-readings
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод = "POST";
	ПараметрыЗапроса.АдресМетода = "/v1/epls/{eplId}/pre-trip/fuel-readings";
	ПараметрыЗапроса.АдресМетода = СтрЗаменить(ПараметрыЗапроса.АдресМетода, "{eplId}", eplId);
	ПараметрыЗапроса.ТелоЗапроса = КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(Показания);
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	ПятьМинутВСекундах = 60 * 5;
	Если ТекущаяДатаСеанса() - ДатаДанных < ПятьМинутВСекундах Тогда
		// NotFound допускаем в течении 5 мину, так как накладная могла и не создаться еще
		ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(404);
	КонецЕсли;
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 404 Тогда
		// В следующий раз попытаемся еще раз
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

