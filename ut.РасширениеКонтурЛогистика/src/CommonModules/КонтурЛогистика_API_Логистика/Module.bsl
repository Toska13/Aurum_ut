// Получает данные по организации, в том числе идентификатор fnsParticipantId организации, участника ЭДО, и сведения о роуминге
//
// Параметры:
//  ПараметрыСервиса - Структура - Структура, содержащая параметры сервиса. Например, ApiKey
//	ИНН - ИНН организации
//  КПП - КПП организации. Если пкстой, по будут получены данные только по филиалу.
// 
// Возвращаемое значение:
//  Результат - Структура, содержащая данные по организации 
//
Функция ПолучитьРеквизитыОрганизации(Знач ПараметрыСервиса, ИНН, КПП = Неопределено) Экспорт 
	
	// /v1/organizations/requisites
	
	ПараметрыЗапроса = КонтурЛогистика_HTTPКоннекторКлиентСервер.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/v1/organizations/requisites";
	
	ПараметрыЗапроса.Параметры.Вставить("inn", ИНН);
	
	Если ЗначениеЗаполнено(КПП) Тогда
		ПараметрыЗапроса.Параметры.Вставить("kpp", КПП);
	КонецЕсли;
	
	ДобавитьЗаголовокАвторизации(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = КонтурЛогистика_HTTPКоннекторКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = JsonПрочитать(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

// Получает настройки организации
//
// Параметры:
