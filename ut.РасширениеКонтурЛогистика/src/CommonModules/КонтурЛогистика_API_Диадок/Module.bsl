	ПараметрыСервиса = ЛогистикаПараметрыСервиса_Диадок(boxId);
	
	Requests = Новый Массив;
	
	Для каждого Док Из СписокДокументов Цикл
		DocumentId = Новый Структура;
		DocumentId.Вставить("MessageId", Док.MessageId);
		DocumentId.Вставить("EntityId", Док.EntityId);
		
		GetDocflowRequest = Новый Структура;
		GetDocflowRequest.Вставить("DocumentId", DocumentId);
		GetDocflowRequest.Вставить("InjectEntityContent", InjectEntityContent);
		
		Requests.Добавить(GetDocflowRequest);
	КонецЦикла;
	
	GetDocflowBatchRequest = Новый Структура;
	GetDocflowBatchRequest.Вставить("Requests", Requests);
	
	Возврат Ядро().АПИ_GetDocflows(ПараметрыСервиса, boxId, GetDocflowBatchRequest);
		
		
