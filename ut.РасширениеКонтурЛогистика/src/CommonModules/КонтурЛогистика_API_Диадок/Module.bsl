Функция ПодготовитьMessageToPost(файлОбменаСсылка)
	
	Результат = Ядро().АПИ_Новый_MessageToPost(файлОбменаСсылка.Отправитель.ID);
	Результат.Вставить("FromDepartmentId"	, файлОбменаСсылка.ОтправительПодразделение.ID);
	
	Результат.Вставить("ToDepartmentId"		, файлОбменаСсылка.ПолучательПодразделение.ID);
	
	ОтложеннаяОтправка = Не файлОбменаСсылка.ПодписьВерна;
	Результат.Вставить("DelaySend"			, ОтложеннаяОтправка);
	Результат.Вставить("LockPacket"			, Ложь);
	
	Если файлОбменаСсылка.Отправитель = файлОбменаСсылка.Получатель Тогда
		
		Результат.Вставить("IsInternal "	, Истина);
		
		Если Не ЗначениеЗаполнено(файлОбменаСсылка.ОтправительПодразделение)
			ИЛИ Не ЗначениеЗаполнено(файлОбменаСсылка.ПолучательПодразделение)
			ИЛИ файлОбменаСсылка.ОтправительПодразделение = файлОбменаСсылка.ПолучательПодразделение Тогда 
			
			ВызватьИсключение "В файле " + файлОбменаСсылка.Наименование + " отправитель = получателю (внутренний док) должны быть указаны подразделения отправителя и получателя, причем они должны быть разные."; 
			
		КонецЕсли;
		
		
	Иначе
		
		Результат.Вставить("ToBoxId"			, файлОбменаСсылка.Получатель.ID);
		
	КонецЕсли;
	
	// Промежуточных получателей в текущей концепции нет
	//Если Пакет.СлужебнаяИнформация.Свойство("ПараметрыОтправки") Тогда
	//	
	//	ПромежуточныйПолучатель = Пакет.СлужебнаяИнформация.ПараметрыОтправки.ПромежуточныйПолучатель;
	//	
	//	Если ЗначениеЗаполнено(ПромежуточныйПолучатель.BoxId) Тогда
	//		
	//		Результат.Вставить("ProxyBoxId", ПромежуточныйПолучатель.BoxId);
	//		
	//		Если ЗначениеЗаполнено(ПромежуточныйПолучатель.DepartmentId) Тогда
	//			
	//			Результат.Вставить("ProxyDepartmentId", ПромежуточныйПолучатель.DepartmentId);
	//			
	//		КонецЕсли;
	//		
	//	КонецЕсли;
	//	
	//КонецЕсли;
	
	Результат.Вставить("DocumentAttachments", Новый Массив);
	
	// Доп. Аттачи планируются но пока не поддерживаются. Пока что отправляем только сам титул
	//Для Каждого Документ Из Пакет.Документы Цикл
	//	DocumentAttachment = ПодготовитьDocumentAttachment(Документ);
	//	Результат.DocumentAttachments.Добавить(DocumentAttachment);
	//КонецЦикла;
	
	DocumentAttachment = ПодготовитьDocumentAttachment(файлОбменаСсылка);
	Результат.DocumentAttachments.Добавить(DocumentAttachment);
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьMessagePatchToPostПрисоединениеУдалениеКПакету(файлОбменаСсылка, МассивСтруктурПрисоединяемыхDocumentId = Неопределено, МассивСтруктурРазделяемыхDocumentId = Неопределено)
	
	Если файлОбменаСсылка.Состояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен") Тогда 
		// это входящий
		BoxId		= файлОбменаСсылка.Получатель.ID;
	Иначе
		// исходящий
		BoxId		= файлОбменаСсылка.Отправитель.ID;
	КонецЕсли;
	
	MessagePatchToPost = Ядро().АПИ_Новый_MessagePatchToPost(BoxId, файлОбменаСсылка.MessageID);
	
	ИмяКоллекции	= "EditDocumentPacketCommands";
	Attachment	 	= Ядро().АПИ_Новый_EditDocumentPacketCommand(файлОбменаСсылка.DocumentId, МассивСтруктурПрисоединяемыхDocumentId, МассивСтруктурРазделяемыхDocumentId);
		
	MessagePatchToPost.Вставить(ИмяКоллекции, ЗначениеВМассив(Attachment));
	
	Возврат MessagePatchToPost;
	
КонецФункции

Функция ПодготовитьMessagePatchToPost(файлОбменаСсылка)
	
	MessagePatchToPost = Ядро().АПИ_Новый_MessagePatchToPost(файлОбменаСсылка.Отправитель.ID, файлОбменаСсылка.MessageID);
	
	ХранилищеКонтента 						= Контракт_ДанныеХранения();
	ХранилищеКонтента.Данные 				= СформироватьДвоичныеДанныеКонтентаФайла(файлОбменаСсылка);
	ХранилищеКонтента.Подпись.ДанныеПодписи = СформироватьДвоичныеДанныеПодписиФайла(файлОбменаСсылка);
	
	ДокументЗашифрован			= ЗначениеЗаполнено(ХранилищеКонтента.ЗашифрованныеДанные);
	Данные						= ?(ДокументЗашифрован, ХранилищеКонтента.ЗашифрованныеДанные, ХранилищеКонтента.Данные);
	ДанныеПодписи				= ХранилищеКонтента.Подпись.ДанныеПодписи;
	
	PowerOfAttorneyToPost = ПодготовитьPowerOfAttorneyToPost(файлОбменаСсылка);
	
	SignedContent = Ядро().АПИ_Новый_SignedContent(Данные, ДанныеПодписи, , , PowerOfAttorneyToPost);
	
	Если (файлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 
		Или файлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 
		Или файлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2) 
		И файлОбменаСсылка.СвязанныйДокумент.ЕстьОтказВПодписи Тогда 
		
		ИмяКоллекции	= "XmlSignatureRejections";
		Attachment	 	= Ядро().АПИ_Новый_XmlSignatureRejectionAttachment(файлОбменаСсылка.DocumentId, SignedContent);
		
	Иначе	
		
		ИмяКоллекции	= "RecipientTitles";
		Attachment	 	= Ядро().АПИ_Новый_ReceiptAttachment(файлОбменаСсылка.DocumentId, SignedContent);
		
	КонецЕсли;

	Если Данные <> Неопределено Тогда
		
		MessagePatchToPost.Вставить(ИмяКоллекции, ЗначениеВМассив(Attachment));
		
	КонецЕсли;	
	
	Возврат MessagePatchToPost;
	
КонецФункции

