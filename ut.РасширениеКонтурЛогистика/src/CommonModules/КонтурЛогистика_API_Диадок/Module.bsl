Функция Ядро() Экспорт
	
	Возврат КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();
	
КонецФункции

// Дополнительно достает из кэша Логистики токен
Функция ЛогистикаПараметрыСервиса_Диадок(boxID = Неопределено, Токен = Неопределено) Экспорт
	
	ПараметрыСервиса = Ядро().ПараметрыСервиса_Диадок(boxID);
	
	Если Токен <> Неопределено Тогда
		
		ПараметрыСервиса.Вставить("Токен", Токен);
		
	ИначеЕсли ПараметрыСервиса.РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow Тогда
		
		ДанныеАутентификации = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.ПараметрыСервисаДиадок(boxID);
		
		ПараметрыСервиса.Вставить("Токен", ДанныеАутентификации.ТокенДоступа);
		
	Иначе
		
		Если boxID = Неопределено Тогда
			
			ЛюбаяНашаОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЛюбаяНашаОрганизация();
			Если ЗначениеЗаполнено(ЛюбаяНашаОрганизация) Тогда
				boxID = ЛюбаяНашаОрганизация.ID;
			КонецЕсли;
			
		КонецЕсли;
		
		Токен = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Токен(boxID);
		ПараметрыСервиса.Вставить("Токен", Токен);
		
	КонецЕсли;
	
	Возврат ПараметрыСервиса;
	
КонецФункции

Функция ПрочитатьТитулИзДиадока(ФайлСсылка) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("Титул", Неопределено);
	
	ИдентификаторЯщика = ИдентификаторЯщикаОрганизацииДляОбменаДиадок(ФайлСсылка);
	
	ПараметрыСервиса = ЛогистикаПараметрыСервиса_Диадок(ИдентификаторЯщика);
	
	Если Не ЗначениеЗаполнено(ФайлСсылка.Отправитель.ID)
		ИЛИ Не ЗначениеЗаполнено(ФайлСсылка.MessageID)
		ИЛИ Не ЗначениеЗаполнено(ФайлСсылка.DocumentId)
		Тогда 
		
		Результат.ОписаниеОшибки = "В найденном файле обмена с Диадок отсутствуют ключевые параметры: Отправитель.ID / MessageID / DocumentId. Файл точно был отправлен?";
		Возврат Результат;
		
	Иначе
		
		Попытка
			
			РезультатЧтения = Ядро().АПИ_GetDocument(ПараметрыСервиса,
			ИдентификаторЯщика,
			ФайлСсылка.MessageID,
			ФайлСсылка.DocumentId);
			Результат.Успешно = Истина;
			
		Исключение
			
			РезультатОтправки = Неопределено;
			
			Ошибка			= ИнформацияОбОшибке();
			ПодробнаяОшибка	= ПодробноеПредставлениеОшибки(Ошибка);
			
			ВидОперации		= "Чтение Титула из Диадока";
			Представление	= "" + ФайлСсылка.ТипДокумента + " номер " + ФайлСсылка.Код;
			ТекстОшибки		= "ФайлОбмена: %1 Не удалось Прочитать титул из Диадока: %2";
			ТекстОшибки		= Ядро().Общее_ПодставитьПараметрыВСтроку(ТекстОшибки, Представление, ПодробнаяОшибка);
			
			Результат.ОписаниеОшибки = ТекстОшибки;
			Результат.Успешно = Ложь;
			
		КонецПопытки;
		
		Результат.Вставить("Титул", РезультатЧтения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторЯщикаОрганизацииДляОбменаДиадок(ФайлСсылка)
	
	// Проверяем наша организация отправителя файла
	Если ФайлСсылка.Отправитель.Наш Тогда
		Возврат ФайлСсылка.Отправитель.ID;
	КонецЕсли;
	
	// Проверяем наша организация получателя файла
	Если ФайлСсылка.Получатель.Наш Тогда
		Возврат ФайлСсылка.Получатель.ID;
	КонецЕсли;
	
	ГлавныйДокумент = ФайлСсылка.ГлавныйДокумент;
	
	Если Не ЗначениеЗаполнено(ГлавныйДокумент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОрганизацииДиадок = Новый Массив;
	
	// Ищем через гланый документ
	Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"Грузоотправитель, Перевозчик, Грузополучатель, ПогрузкуОсуществляет, ЭкспедицияЗаказчик");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Грузоотправитель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Перевозчик);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Грузополучатель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ПогрузкуОсуществляет);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ЭкспедицияЗаказчик);
		
		ДополнительныеПолучателиФайла = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДопПолучателейФайла(ГлавныйДокумент);		
		Для Каждого ТекущийПолучатель Из ДополнительныеПолучателиФайла Цикл
			ОрганизацииДиадок.Добавить(ТекущийПолучатель.ОрганизацияДиадок);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"ЛицоОформившееПЛ, Грузоотправитель, ОрганизацияМедик, ОрганизацияТехСостояние, ОрганизацияОдометр");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ЛицоОформившееПЛ);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Грузоотправитель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ОрганизацияМедик);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ОрганизацияТехСостояние);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ОрганизацияОдометр);
		
		Для Каждого ТекущийПолучатель Из ГлавныйДокумент.ДополнительныеПолучателиФайла Цикл
			ОрганизацииДиадок.Добавить(ТекущийПолучатель.ОрганизацияДиадок);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"ЛицоОформившееПЛ, ОрганизацияМедик");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ЛицоОформившееПЛ);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.ОрганизацияМедик);
		
		Для Каждого ТекущийПолучатель Из ГлавныйДокумент.ДополнительныеПолучателиФайла Цикл
			ОрганизацииДиадок.Добавить(ТекущийПолучатель.ОрганизацияДиадок);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"Грузоотправитель, Перевозчик, Составитель");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Грузоотправитель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Перевозчик);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Составитель);
		
		Для Каждого ТекущийПолучатель Из ГлавныйДокумент.ДополнительныеПолучателиФайла Цикл
			ОрганизацииДиадок.Добавить(ТекущийПолучатель.ОрганизацияДиадок);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"Составитель, Фрахтователь, Фрахтовщик");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Составитель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Фрахтователь);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Фрахтовщик);
		
		Для Каждого ТекущийПолучатель Из ГлавныйДокумент.ДополнительныеПолучателиФайла Цикл
			ОрганизацииДиадок.Добавить(ТекущийПолучатель.ОрганизацияДиадок);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектронныйЗаказНаряд") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"Фрахтователь, Фрахтовщик");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Составитель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Фрахтователь);
		
	ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость") Тогда
		
		ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ГлавныйДокумент,
			"Грузоотправитель, Перевозчик, Грузополучатель");
		
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Грузоотправитель);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Перевозчик);
		ОрганизацииДиадок.Добавить(ЗначенияРеквизитов.Грузополучатель);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацииДиадок", ОрганизацииДиадок);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_ОрганизацииДиадок.ID КАК ID
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш
	|	И КонтурЛогистика_ОрганизацииДиадок.Ссылка В(&ОрганизацииДиадок)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ID;
	КонецЕсли;
	
	// Попробуем найти в цепочке титулов ЭТрН
	Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		Возврат ИдентификаторЯщикаИзДополнительныхПолучателейТитуловЭТРН(ГлавныйДокумент);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИдентификаторЯщикаИзДополнительныхПолучателейТитуловЭТРН(ДокументЭТРН)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументЭТРН", ДокументЭТРН);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_ОрганизацииДиадок.ID КАК ID
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1.ДополнительныеПолучателиФайла КАК КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул1
	|		ПО КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла.Ссылка = КонтурЛогистика_ТрН_Титул1.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|		ПО КонтурЛогистика_ТрН_Титул1ДополнительныеПолучателиФайла.ОрганизацияДиадок = КонтурЛогистика_ОрганизацииДиадок.Ссылка
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = &ДокументЭТРН
	|	И НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	|	И НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ID;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОбработатьВсеЛентыСобытий() Экспорт
	
	// в 1 потоке последовательно пока нет оснований делать многопоточно
	Результат = Истина;
	
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	АвторизацияПоТокену = (РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("АвторизацияПоТокену", АвторизацияПоТокену);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок КАК Ссылка
	|ПОМЕСТИТЬ НашиОрганизации
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
	|ГДЕ
	|	КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок)
	|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки = ИСТИНА
	|	И НЕ КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок.Наш
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	НашиОрганизации КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ &АвторизацияПоТокену
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка
	|ИЗ
	|	НашиОрганизации КАК КонтурЛогистика_ОрганизацииДиадок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_Аутентификация КАК КонтурЛогистика_Аутентификация
	|		ПО КонтурЛогистика_ОрганизацииДиадок.Ссылка = КонтурЛогистика_Аутентификация.Организация
	|ГДЕ
	|	&АвторизацияПоТокену";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ОбработатьЛентуСобытий(Выборка.Ссылка);
			
		Исключение
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка при обработке Ленты организации " + Выборка.Ссылка + " по причине: " + ОписаниеОшибки();
			Сообщение.Сообщить();
			
			Результат = Ложь;
			
			КонтурЛогистика_Метрика.ОбработатьОшибку("Диадок.ОбработатьВсеЛентыСобытий", ИнформацияОбОшибке(), Выборка.Ссылка);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьЛентуСобытий(ОрганизацияДиадок) Экспорт
	
	Перем Ticks, DepartmentId;
	
	BoxId = ОрганизацияДиадок.ID;
	АктуальностьЛентыСобытийДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		ОрганизацияДиадок, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок);
	Если ЗначениеЗаполнено(ОрганизацияДиадок.ВычитыватьДокументыПодразделения) Тогда
		DepartmentId = ОрганизацияДиадок.ВычитыватьДокументыПодразделения.ID;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийДиадок) Тогда
		
		АктуальностьЛентыСобытийДиадокДата = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
			ОрганизацияДиадок, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата);
		
		Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийДиадокДата) Тогда			
			АктуальностьЛентыСобытийДиадокДата = НачалоДня(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени());
		КонецЕсли;
		
		// Приведем МСК к UTC
		УниверсальноеВремяСобытия = УниверсальноеВремя(АктуальностьЛентыСобытийДиадокДата, "GMT+3");
		
		Ticks = (УниверсальноеВремяСобытия - '00010101') * 1000 * 1000 * 10;
		
	КонецЕсли;
	
	ПараметрыСервиса = ЛогистикаПараметрыСервиса_Диадок(ОрганизацияДиадок.ID);
	
	МаксКоличествоЦиклов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("КоличествоЦикловОбмена");
	КоличествоЦиклов = 0;
	ОсталосьСобытий = 1;
	
	Пока ОсталосьСобытий > 0 И КоличествоЦиклов < МаксКоличествоЦиклов Цикл
		
		МоментОтправкиЗапроса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
		
		ПорцияСобытий = Лента_СобытияЯщикаОрганизации(BoxId, Ticks, , АктуальностьЛентыСобытийДиадок, ПараметрыСервиса, DepartmentId);
		ТаблицаСобытий 	= Лента_ТаблицаСобытийДляОбработки(boxId, ПорцияСобытий.Events);
		
		ОсталосьСобытий		= ПорцияСобытий.TotalCount - ТаблицаСобытий.Количество();
		КоличествоЦиклов	= КоличествоЦиклов + 1;
		
		////////////////////////////////////////////////////////////////////////////////////////////////
		ОбработатьСобытияЛенты(ОрганизацияДиадок, ТаблицаСобытий, ПараметрыСервиса);
		////////////////////////////////////////////////////////////////////////////////////////////////
		
		Если ТаблицаСобытий.Количество() > 0 Тогда
			
			ПоследнееСобытие = ТаблицаСобытий[ТаблицаСобытий.Количество() - 1];
			
			АктуальностьЛентыСобытийДиадок	= ПоследнееСобытие.Event.IndexKey;
			Ticks							= ПоследнееСобытие.Event.Timestamp.Ticks;
			ДатаГраницыСинхронизацииUTC		= КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(Ticks);
		    ДатаГраницыСинхронизацииМСК 	= ДатаГраницыСинхронизацииUTC + 10800;
			
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				ОрганизацияДиадок, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок, АктуальностьЛентыСобытийДиадок);
				
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				ОрганизацияДиадок, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата, ДатаГраницыСинхронизацииМСК);
			
		ИначеЕсли ТаблицаСобытий.Количество() = 0 И КоличествоЦиклов = 1 Тогда
			
			// просто не оказалось эвентов - просто передвинем границу
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				ОрганизацияДиадок, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата, МоментОтправкиЗапроса);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьСобытияЛенты(Знач ОрганизацияДиадок, Знач ТаблицаСобытий, ПараметрыСервиса)
	
	ОбработатьИзмененияСтатусовВходящихИИсходящих(ОрганизацияДиадок, ТаблицаСобытий, ПараметрыСервиса);
	
	ТаблицаСобытийСвернутая = Лента_СвернутьТаблицуСобытий(ТаблицаСобытий); 
	
	ОбработатьОтветыОтправленных(ОрганизацияДиадок, ТаблицаСобытийСвернутая, ПараметрыСервиса);
	
	ОбработатьВходящие(ОрганизацияДиадок, ТаблицаСобытийСвернутая, ПараметрыСервиса);
	
	ОбработатьИсходящие(ОрганизацияДиадок, ТаблицаСобытийСвернутая, ПараметрыСервиса);
	
КонецПроцедуры

Процедура ОбработатьОтветыОтправленных(Знач ОрганизацияДиадок, Знач ТаблицаСобытийСвернутая, ПараметрыСервиса)
	
	BoxId = ОрганизацияДиадок.ID;
	
	// в свернутой только конечные состояния в рамках пачки - отсюда будем брать входящие
	Для Каждого ДанныеСобытия Из ТаблицаСобытийСвернутая Цикл
		
		Если Не ДанныеСобытия.DocumentDirection = "Outbound" Тогда 
			Продолжить;
		КонецЕсли;
		Если Не ДанныеСобытия.BoxId = BoxId Тогда 
			Продолжить;
		КонецЕсли;
		
		MessageId 	= ДанныеСобытия.LetterId;
		DocumentId 	= ДанныеСобытия.DocumentId;
		DocumentInfo		 = ДанныеСобытия.Event.Document.DocumentInfo;
		ЭтоДокумент			 = (DocumentInfo.MessageType = "Letter");
		ЭтоШаблон			 = (DocumentInfo.MessageType = "Template");
		
		// Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageID, DocumentId) - для отладки
		
		ЗагружатьДокументооборотЦеликом = Истина;
		КонтентДокументооборота		= Ядро().Лента_ДанныеДО(ДанныеСобытия, ЗагружатьДокументооборотЦеликом);
		
		// 1. ответ получателя файла - титул, отказ, аннулирование или ответная подпись
		Если КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента")
			Или КонтентДокументооборота.Свойство("ПредложениеОбАннулированииПродавца")
			Или КонтентДокументооборота.Свойство("ТитулПокупателя") Тогда
			
			Ответ = Перечисления.КонтурЛогистика_ОтветыПолучателяФайла.ПустаяСсылка(); 
			Если КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента") Тогда
				
				EntityId = КонтентДокументооборота.ОтказВПодписанииДокумента.Attachment.Entity.EntityId;
				Ответ = Перечисления.КонтурЛогистика_ОтветыПолучателяФайла.ОтказВПодписи; 
				
			ИначеЕсли КонтентДокументооборота.Свойство("ПредложениеОбАннулированииПродавца") Тогда
				
				EntityId = КонтентДокументооборота.ПредложениеОбАннулированииПродавца.Attachment.Entity.EntityId;
				Ответ = Перечисления.КонтурЛогистика_ОтветыПолучателяФайла.Аннулирован; 
				
			ИначеЕсли КонтентДокументооборота.Свойство("ТитулПокупателя") Тогда
				
				EntityId = КонтентДокументооборота.ТитулПокупателя.Attachment.Entity.EntityId;
				Ответ = Перечисления.КонтурЛогистика_ОтветыПолучателяФайла.ТитулПолучателя;
				
			КонецЕсли;
			
			СинхронизироватьФайлОтветомПолучателя(EntityId, ДанныеСобытия, BoxId, ПараметрыСервиса, Ответ, КонтентДокументооборота);
				
			// Document = Ядро().АПИ_GetDocument(ПараметрыСервиса, BoxId, MessageId, DocumentId);
			
		КонецЕсли;
		
		// 2. могла доехать подпись отправленного неподписанного (подписали в вебе документ который был отправлен неподписанным из 1С
		Если КонтентДокументооборота.Свойство("ХранилищеКонтента") 
			И КонтентДокументооборота.ХранилищеКонтента.Свойство("Signature") Тогда
			
			ОтправленныйТитул = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageID, DocumentId);
			
			Если ЗначениеЗаполнено(ОтправленныйТитул)
				И ОтправленныйТитул.ПодписьВерна = Ложь
				И ОтправленныйТитул.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен Тогда 
			
				СинхронизироватьВходящийForwardingДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота, ЭтоШаблон)
				
			КонецЕсли;
			
		КонецЕсли;
		
		// 3. пришла отредактированная версия неподписанного
		// MessageID и DocumentId отличаются от исходных
		Если КонтентДокументооборота.Свойство("ХранилищеКонтента")
			И Не ЗначениеЗаполнено(ОтправленныйТитул) Тогда
			
			ОтправленныйТитул = ФайлОбменаПоCustomData(ДанныеСобытия);
				
			Если ЗначениеЗаполнено(ОтправленныйТитул) Тогда
				СинхронизироватьВходящийForwardingДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота, ЭтоШаблон);
			КонецЕсли;
			
		КонецЕсли;
		
		// 4. Ответная подпись
		Если КонтентДокументооборота.Свойство("ПодписьПокупателя")
			И КонтентДокументооборота.ПодписьПокупателя.Свойство("Signature") Тогда
			
			EntityId = КонтентДокументооборота.ПодписьПокупателя.Attachment.Entity.EntityId;
			
			ФайлОбменаСсылка = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageId, DocumentId);
			
			Если ЗначениеЗаполнено(ФайлОбменаСсылка)
				И Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ФайлОбменаСсылка.ТипДокумента) Тогда
				
				// Получаем данные по подписи
				EntityIdПодписи = ПолучитьEntityIdПодписи(КонтентДокументооборота.ПодписьПокупателя.Signature);
				ДвоичныеДанныеПодписи = Ядро().АПИ_GetEntityContent(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
				
				// Храним вторую подпись в ТЧ СогласующиеПодписи
				ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
				Если ФайлОбменаОбъект.СогласующиеПодписи.Количество() = 0 Тогда
					ТекущаяСтрока = ФайлОбменаОбъект.СогласующиеПодписи.Добавить();
				Иначе
					ТекущаяСтрока = ФайлОбменаОбъект.СогласующиеПодписи.Добавить();
				КонецЕсли;
				
				SignatureInfo = GetSignatureInfo(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
				
				Если SignatureInfo <> Неопределено Тогда
				    		    						
					Если ФайлОбменаОбъект.ВтораяПодписьВерна Тогда
						ТекущаяСтрока.СтатусПроверкиСертификата = СтатусПроверкиСертификата(SignatureInfo);
						Если ЗначениеЗаполнено(ТекущаяСтрока.СтатусПроверкиСертификата)
							И ТекущаяСтрока.СтатусПроверкиСертификата <> 0 Тогда
							
							// Ошибка в проверке сертификата
							УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект,
								Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи, ТекущаяСтрока.СтатусПроверкиСертификата);
							ФайлОбменаОбъект.ВтораяПодписьВерна = Ложь;
						КонецЕсли;
					Иначе
						// Ошибка в проверке подписи
						УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект,
							Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи, 0);
					КонецЕсли;				
											
				КонецЕсли;
				
				Если КонтурЛогистика_КриптографияСерверПовтИсп.МодульКриптографииИнициализирован() Тогда
				
					ДанныеПодписанта = Ядро().ДанныеПодписантаИзПодписи(Base64Строка(ДвоичныеДанныеПодписи));
					СведенияСертификата = Ядро().ПолучитьСертификатИзПодписи(ДвоичныеДанныеПодписи);
						
				
					ТекущаяСтрока.Подпись = Новый ХранилищеЗначения(ДвоичныеДанныеПодписи);
					ТекущаяСтрока.КомуВыданСертификат = ДанныеПодписанта.Подписант
						+ ?(ДанныеПодписанта.Свойство("Тип"), ", " + ДанныеПодписанта.Тип, "");
					ТекущаяСтрока.Отпечаток = СведенияСертификата.Отпечаток;
					ТекущаяСтрока.Сертификат = Новый ХранилищеЗначения(СведенияСертификата.ДвоичныеДанные);
										
				ИначеЕсли SignatureInfo <> Неопределено Тогда
				     											
					ЗаписатьДанныеПодписантаВФайл(ТекущаяСтрока, SignatureInfo, ДвоичныеДанныеПодписи);
									
				КонецЕсли;
											
				ФайлОбменаОбъект.ВтораяПодписьВерна = ДанныеСобытия.Event.Document.Docflow.RecipientResponse.Signature.IsValid;
				ФайлОбменаОбъект.ВтораяПодписьСостояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен;
												
				Если ФайлОбменаОбъект.ВтораяПодписьВерна Тогда
					// Подпись верна, завершаем документооборот
					ДатаСобытияUTC = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(
						ДанныеСобытия.Event.Timestamp.Ticks);
					ДатаСобытияМСК = МестноеВремя(ДатаСобытияUTC, "GMT+3");
					
					ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
						ФайлОбменаОбъект.Ссылка, ДанныеСобытия.Event.EventId, Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок);
					РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
						ФайлОбменаСсылка.ГлавныйДокумент, "fr-completed", ДатаСобытияМСК,,, ДопДанные);
				КонецЕсли;
				
				// Признак тестового документа
				Если ФайлОбменаОбъект.КаналТранспорта <> Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика
					И ДанныеСобытия.Event.Document.DocumentInfo.Свойство("LetterInfo")
					И ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.Свойство("IsTest") Тогда
					ФайлОбменаОбъект.ТестовыйДокумент = ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.IsTest;
				КонецЕсли;
				
				ФайлОбменаОбъект.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьВходящие(Знач ОрганизацияДиадок, Знач ТаблицаСобытийСвернутая, ПараметрыСервиса)
	
	BoxId = ОрганизацияДиадок.ID;
	
	// в свернутой только конечные состояния в рамках пачки - отсюда будем брать входящие
	Для Каждого ДанныеСобытия Из ТаблицаСобытийСвернутая Цикл
		
		Если Не ДанныеСобытия.DocumentDirection = "Inbound"
			И Не ДанныеСобытия.DocumentDirection = "Internal" Тогда
			
			Продолжить;
		КонецЕсли;
		
		ИдентификаторТипа = ДанныеСобытия.Event.Document.DocumentInfo.FullVersion.TypeNamedId;
		
		Если ИдентификаторТипа = "LogisticsWaybillForwarding"
			Или ИдентификаторТипа = "LogisticsWaybill"
			Или ИдентификаторТипа = "LogisticsWorkOrder"
			Или ИдентификаторТипа = "LogisticsContainerCertificate"
			Или ИдентификаторТипа = "LogisticsEpl"
			Или ИдентификаторТипа = "LogisticsCharterAgreement"
			Или ИдентификаторТипа = "LogisticsOrderRequest"
			Или ИдентификаторТипа = "XmlForwardingReceipt" Тогда
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если Не ДанныеСобытия.BoxId = BoxId Тогда 
			Продолжить;
		КонецЕсли;
		
		MessageId = ДанныеСобытия.LetterId;
		DocumentId = ДанныеСобытия.DocumentId;
		DocumentInfo = ДанныеСобытия.Event.Document.DocumentInfo;
		ЭтоДокумент = (DocumentInfo.MessageType = "Letter");
		ЭтоШаблон = (DocumentInfo.MessageType = "Template");
		
		// Обрабатываем только шаблоны экспедиторской расписки
		Если ЭтоШаблон И ИдентификаторТипа <> "XmlForwardingReceipt" Тогда
			Продолжить;
		КонецЕсли;
		
		// Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageID, DocumentId) - для отладки
		
		ЗагружатьДокументооборотЦеликом = Истина;
		КонтентДокументооборота = Ядро().Лента_ДанныеДО(ДанныеСобытия, ЗагружатьДокументооборотЦеликом);
		
		СинхронизироватьВходящийForwardingДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота, ЭтоШаблон);
		
		ОбновитьПодписьТитулаПокупателя(ДанныеСобытия, ПараметрыСервиса, КонтентДокументооборота);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьИсходящие(Знач ОрганизацияДиадок, Знач ТаблицаСобытийСвернутая, ПараметрыСервиса)
	
	BoxId = ОрганизацияДиадок.ID;
	
	Для Каждого ДанныеСобытия Из ТаблицаСобытийСвернутая Цикл
		
		Если Не ДанныеСобытия.DocumentDirection = "Outbound" Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторТипа = ДанныеСобытия.Event.Document.DocumentInfo.FullVersion.TypeNamedId;
		
		Если ИдентификаторТипа = "LogisticsWaybillForwarding"
			Или ИдентификаторТипа = "LogisticsWaybill"
			Или ИдентификаторТипа = "LogisticsWorkOrder"
			Или ИдентификаторТипа = "LogisticsContainerCertificate"
			Или ИдентификаторТипа = "LogisticsEpl"
			Или ИдентификаторТипа = "LogisticsCharterAgreement"
			Или ИдентификаторТипа = "LogisticsOrderRequest"
			Или ИдентификаторТипа = "XmlForwardingReceipt" Тогда
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если Не ДанныеСобытия.BoxId = BoxId Тогда 
			Продолжить;
		КонецЕсли;
		
		MessageId = ДанныеСобытия.LetterId;
		DocumentId = ДанныеСобытия.DocumentId;
		DocumentInfo = ДанныеСобытия.Event.Document.DocumentInfo;
		ЭтоДокумент = (DocumentInfo.MessageType = "Letter");
		ЭтоШаблон = (DocumentInfo.MessageType = "Template");
		
		// Обрабатываем только шаблоны экспедиторской расписки
		Если ЭтоШаблон И ИдентификаторТипа <> "XmlForwardingReceipt" Тогда
			Продолжить;
		КонецЕсли;
		
		ЗагружатьДокументооборотЦеликом = Истина;
		КонтентДокументооборота = Ядро().Лента_ДанныеДО(ДанныеСобытия, ЗагружатьДокументооборотЦеликом);
		
		СинхронизироватьИсходящийДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота, ЭтоШаблон);
		
		ОбновитьПодписьТитулаПокупателя(ДанныеСобытия, ПараметрыСервиса, КонтентДокументооборота);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьПодписьТитулаПокупателя(ДанныеСобытия, ПараметрыСервиса, КонтентДокументооборота)
	
	Попытка
		
		BoxId 	= ДанныеСобытия.BoxId;
		MessageId 	= ДанныеСобытия.LetterId;
		
		Если КонтентДокументооборота.Свойство("ТитулПокупателя") ИЛИ КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента") Тогда
			
			Если КонтентДокументооборота.Свойство("ТитулПокупателя") Тогда
				DocflowTitle = КонтентДокументооборота.ТитулПокупателя;
				FileNameБезxml = СтрЗаменить(КонтентДокументооборота.ТитулПокупателя.Attachment.AttachmentFileName, ".xml", "");
				EntityIdПодписи = КонтентДокументооборота.ТитулПокупателя.Signature.Cms.EntityId;
				ПодписьВерна = КонтентДокументооборота.ТитулПокупателя.Signature.IsValid;				
			ИначеЕсли КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента") Тогда
				DocflowTitle = КонтентДокументооборота.ОтказВПодписанииДокумента;
				FileNameБезxml = СтрЗаменить(КонтентДокументооборота.ОтказВПодписанииДокумента.Attachment.AttachmentFileName, ".xml", "");
				EntityIdПодписи = КонтентДокументооборота.ОтказВПодписанииДокумента.Signature.Cms.EntityId;
				ПодписьВерна = КонтентДокументооборота.ОтказВПодписанииДокумента.Signature.IsValid;				 
			КонецЕсли;
						
			GUID = Прав(СокрЛП(FileNameБезxml), 36);
			
			НайденныйФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUID);
			
			Если ЗначениеЗаполнено(НайденныйФайлОбмена) Тогда
				
				ФайлОбменаОбъект = НайденныйФайлОбмена.ПолучитьОбъект();
				
				ФайлОбменаОбъект.ПодписьВерна = ПодписьВерна;
				
				Если ФайлОбменаОбъект.ПодписьВерна Тогда
					ФайлОбменаОбъект.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи.SenderSignatureCheckedAndValid;
				Иначе
					ФайлОбменаОбъект.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи.SenderSignatureCheckedAndInvalid;
				КонецЕсли;
												
				Если Не ФайлОбменаОбъект.ПодписьВерна Тогда 
					
					СтатусПроверкиСертификата = ПроверитьПодпись(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
					Если ЗначениеЗаполнено(СтатусПроверкиСертификата) Тогда
						ФайлОбменаОбъект.СтатусПроверкиСертификата = СтатусПроверкиСертификата;
					КонецЕсли;
					
					УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи, СтатусПроверкиСертификата);
					
				КонецЕсли;
				
				РеквизитыДоверенностиВФайл(ДанныеСобытия, ФайлОбменаОбъект, DocflowTitle);
				
				ФайлОбменаОбъект.Записать();
				
			Иначе
				
				Если Не КонтентДокументооборота.Свойство("ТитулПокупателя") Или Не КонтентДокументооборота.Свойство("ХранилищеКонтента") Тогда
					Возврат;
				КонецЕсли;
				
				ИмяФайлаТитулаПокупателя = КонтентДокументооборота.ТитулПокупателя.Attachment.AttachmentFilename;
				ТипТитулаПокупателя = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(
					ИмяФайлаТитулаПокупателя);
				
				// Если титул 2 сделали не в этой базе, то надо бы ее загрузить
				Если ТипТитулаПокупателя = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
					
					EntityId = КонтентДокументооборота.ТитулПокупателя.Attachment.Entity.EntityId;
					Ответ = Перечисления.КонтурЛогистика_ОтветыПолучателяФайла.ТитулПолучателя;
					
					ИдФайлаБезXML = СтрЗаменить(КонтентДокументооборота.ХранилищеКонтента.Attachment.AttachmentFilename, ".xml", "");
					GUIDИсхФайл = Прав(СокрЛП(ИдФайлаБезXML), 36);
					ИсхФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUIDИсхФайл);
					
					СинхронизироватьФайлОтветомПолучателя(EntityId, ДанныеСобытия, BoxId,
						ПараметрыСервиса, Ответ, КонтентДокументооборота, ИсхФайл);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ОписаниеОшибки());	
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СинхронизироватьИсходящийДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота, ЭтоШаблон = Ложь)
	
	EntityId = КонтентДокументооборота.ХранилищеКонтента.Attachment.Entity.EntityId;
	MessageId = ДанныеСобытия.LetterId;
	DocumentId = ДанныеСобытия.DocumentId;
	
	Если ЭтоШаблон Тогда
		Message = Ядро().АПИ_GetMessage(ПараметрыСервиса, BoxId, MessageId, DocumentId);
		Если Message.Entities.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Document = Message.Entities[0].DocumentInfo;
		
		BoxIdОтправителяШаблона = АдресЯщикаВИдентификатор(Document.CounteragentBoxId);
		ОтправительШаблона = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОрганиациюДДПоId(BoxIdОтправителяШаблона);
	Иначе
		Document = Ядро().АПИ_GetDocument(ПараметрыСервиса, BoxId, MessageId, DocumentId);
	КонецЕсли;
	
	ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(Document.FileName);
	
	Если Не ЗначениеЗаполнено(ТипДокумента) Тогда 
		Возврат; // неизвестный тип документа
	КонецЕсли;
	
	FileNameБезxml = СтрЗаменить(Document.FileName, ".xml", "");
	GUID = Прав(СокрЛП(FileNameБезxml), 36);
	
	НайденныйФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUID);
	
	// Внимание! Раньше здесь было условие поиска файла по другим признакам, если файл не найден по GUID.
	// Как выяснилось, к нам могут приходить из вебе файлы с новыми GUID по одному и тому же Титулу.
	// Но из-за того что поиск файлов по другим признакам как правило возвращал нам какой-то файл,
	// новый файл не создавался и не обновляляся титул, что приводило к ошибкам при отправке Файлов следующего Титула.
	// В файле есть информация о предыдушем титуле, которую мы брали из не обновленного титула, потому что новый файл не создавался.
	// Получается у нас старая информация о предыдущем титуле, у веба - новая информация, в итоге происходил конфликт.
	
	Если ЗначениеЗаполнено(НайденныйФайлОбмена) Тогда
		ФайлОбменаСсылка = НайденныйФайлОбмена;
	Иначе
		ФайлОбменаСсылка = СоздатьФайлОбменаПоСобытию(
			ДанныеСобытия, КонтентДокументооборота, ПараметрыСервиса, BoxId, Document, ЭтоШаблон, ОтправительШаблона);
	КонецЕсли;
	
	// Сохранить OuterDocflow в файл
	ПараметрыЗапроса = Новый Структура("ПараметрыСервиса, BoxId, MessageId", ПараметрыСервиса, BoxId, MessageId);
	OuterDocflows = ДанныеСобытия.Event.Document.Docflow.OuterDocflows;
	ДатаСобытияМСК = Ticks_2_МСК(ДанныеСобытия.Event.Timestamp.Ticks);
	
	КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьOuterDocflowsВФайл(ФайлОбменаСсылка, ПараметрыЗапроса, OuterDocflows, ДатаСобытияМСК);
	
КонецПроцедуры

Функция ПроверкаПравДляРаботыСервисом(ОрганизацияСсылка = Неопределено, Токен = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПравДостаточно", Истина);
	Результат.Вставить("ЭтоАдминистратор", Ложь);
	Результат.Вставить("ОплатаТарифа", Истина);
	Результат.Вставить("ПереченьНедостающихПрав", Новый Массив);
	Результат.Вставить("ТекстОшибки", "");
	
	Попытка
		
		ДанныеСотрудника = Диадок_АПИ_GetMyEmployee(ОрганизацияСсылка.ID, Токен);
		
		Если ДанныеСотрудника = "Необходима оплата тарифа АПИ" Тогда
			Результат.ПравДостаточно = Ложь;
			Результат.ОплатаТарифа = Ложь;
			Возврат Результат;
		КонецЕсли;
		
		Результат.ЭтоАдминистратор = ДанныеСотрудника.Permissions.IsAdministrator;
		
		ИдентификаторПодразделения = ДанныеСотрудника.Permissions.UserDepartmentId;
		ПустойИдентификаторПодразделения = (ИдентификаторПодразделения = "00000000-0000-0000-0000-000000000000");
		УровеньДоступа = ДанныеСотрудника.Permissions.DocumentAccessLevel;
		
		Если УровеньДоступа = "AllDocuments" Тогда
			
			ДоступКДокументам = Истина;
			
		ИначеЕсли УровеньДоступа = "DepartmentAndSubdepartments" И ПустойИдентификаторПодразделения Тогда
			
			ДоступКДокументам = Истина;
			
		Иначе
			
			ДоступКДокументам = Ложь;
			
		КонецЕсли;
		
		Если Не ДоступКДокументам Тогда
			НеобходимоеПраво = Новый Соответствие;
			НеобходимоеПраво.Вставить("InsufficientAccessToDocuments", "Недостаточный доступ к документам");
			Для Каждого ТекущаяСтрока Из НеобходимоеПраво Цикл
				Результат.ПереченьНедостающихПрав.Добавить(ТекущаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
		НеобходимыеПрава = ПереченьНеобходимыхПравДляРаботыOIDC();
		
		Для Каждого ТекущееПраво Из НеобходимыеПрава Цикл
			
			ЕстьПраво = Ложь;
			Для Каждого ТекущийДоступный Из ДанныеСотрудника.Permissions.Actions Цикл
				Если ТекущийДоступный.Name = ТекущееПраво.Ключ
					И ТекущийДоступный.IsAllowed Тогда
					
					ЕстьПраво = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьПраво Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.ПравДостаточно = Ложь;
			Результат.ПереченьНедостающихПрав.Добавить(ТекущееПраво);
			
		КонецЦикла;
		
	Исключение
		
		Результат.ПравДостаточно = Ложь;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПереченьНеобходимыхПравДляРаботыOIDC()
	
	НеобходимыеПрава = Новый Соответствие;
	//НеобходимыеПрава.Вставить("CreateDocuments", "Создавать и редактировать документы и черновики");
	//НеобходимыеПрава.Вставить("DeleteRestoreDocuments", "Удалять документы и черновики, восстанавливать документы");
	НеобходимыеПрава.Вставить("SignDocuments", "Подписывать документы");
	//НеобходимыеПрава.Вставить("AddResolutions", "Согласовывать документы");
	//НеобходимыеПрава.Вставить("RequestResolutions", "Передавать на подпись и согласование");
	НеобходимыеПрава.Вставить("ManageCounteragents", "Видеть списки контрагентов и работать с ними");
	
	Возврат НеобходимыеПрава;
	
КонецФункции

// Записывает в файлы обмена Документ
Процедура СинхронизироватьВходящийForwardingДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота, ЭтоШаблон = Ложь)
	
	EntityId = КонтентДокументооборота.ХранилищеКонтента.Attachment.Entity.EntityId;
	MessageId = ДанныеСобытия.LetterId;
	DocumentId = ДанныеСобытия.DocumentId;
	
	Если ЭтоШаблон Тогда
		Message = Ядро().АПИ_GetMessage(ПараметрыСервиса, BoxId, MessageId, DocumentId);
		Если Message.Entities.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Document = Message.Entities[0].DocumentInfo;
		
		BoxIdОтправителяШаблона = АдресЯщикаВИдентификатор(Document.CounteragentBoxId);
		ОтправительШаблона = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОрганиациюДДПоId(BoxIdОтправителяШаблона);
	Иначе
		Document = Ядро().АПИ_GetDocument(ПараметрыСервиса, BoxId, MessageId, DocumentId);
	КонецЕсли;
	
	Версия = ПолучитьВерсиюДокумента(ДанныеСобытия.Event);
	ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(Document.FileName,, Версия);
	
	Если Не ЗначениеЗаполнено(ТипДокумента) Тогда 
		Возврат; // неизвестный тип документа
	КонецЕсли;
	
	FileNameБезxml = СтрЗаменить(Document.FileName, ".xml", "");
	GUID = Прав(СокрЛП(FileNameБезxml), 36);
	
	НайденныйФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUID);
	
	// Внимание! Раньше здесь было условие поиска файла по другим признакам, если файл не найден по GUID.
	// Как выяснилось, к нам могут приходить из вебе файлы с новыми GUID по одному и тому же Титулу.
	// Но из-за того что поиск файлов по другим признакам как правило возвращал нам какой-то файл,
	// новый файл не создавался и не обновляляся титул, что приводило к ошибкам при отправке Файлов следующего Титула.
	// В файле есть информация о предыдушем титуле, которую мы брали из не обновленного титула, потому что новый файл не создавался.
	// Получается у нас старая информация о предыдущем титуле, у веба - новая информация, в итоге происходил конфликт.
	
	Если Не ЗначениеЗаполнено(НайденныйФайлОбмена) Тогда
		ФайлОбменаСсылка = СоздатьФайлОбменаПоСобытию(
			ДанныеСобытия, КонтентДокументооборота, ПараметрыСервиса, BoxId, Document, ЭтоШаблон, ОтправительШаблона, Версия);
	Иначе
		
		// синхронизировать customData
		CustomData = ДанныеСобытия.Event.Document.DocumentInfo.CustomData;
		ДатаВремяМСК = Ticks_2_МСК(Document.CreationTimestampTicks);
		КонтурЛогистика_ОбработкаДокументовСервер.СохранитьДанныеCustomDataВФайл(CustomData, ДатаВремяМСК, НайденныйФайлОбмена, ДанныеСобытия.Event.EventId);
		
		ФайлОбменаОбъект = НайденныйФайлОбмена.ПолучитьОбъект();
		
		// идентификатор пакета
		Если Document.Свойство("PacketId") И ФайлОбменаОбъект.PacketId <> Document.PacketId Тогда 
			ФайлОбменаОбъект.PacketId = Document.PacketId;
		КонецЕсли;
		
		// если файл был отправлен через API логистики то в нем можно проставить соответствующие идентификаторы в Диадоке
		Если ФайлОбменаОбъект.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда 
			ФайлОбменаОбъект.DocumentId = DocumentId;
			ФайлОбменаОбъект.MessageID = MessageID;
		КонецЕсли;
		
		// Признак тестового документа
		Если ФайлОбменаОбъект.КаналТранспорта <> Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика
			И ДанныеСобытия.Event.Document.DocumentInfo.Свойство("LetterInfo")
			И ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.Свойство("IsTest") Тогда
			ФайлОбменаОбъект.ТестовыйДокумент = ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.IsTest;
		КонецЕсли;
		
		// Сохранить Пришедшую МЧД
		текИдентификаторМЧД = ФайлОбменаОбъект.ИдентификаторМЧД;
		текСтатусПроверкиМЧДПоТитулу = ФайлОбменаОбъект.СтатусПроверкиМЧДПоТитулу;
		текСтатусПриложенностиМЧД = ФайлОбменаОбъект.СтатусПриложенностиМЧД;
		РеквизитыДоверенностиВФайл(ДанныеСобытия, ФайлОбменаОбъект);
		Если текИдентификаторМЧД <> ФайлОбменаОбъект.ИдентификаторМЧД
			Или текСтатусПроверкиМЧДПоТитулу <> ФайлОбменаОбъект.СтатусПроверкиМЧДПоТитулу 
			Или текСтатусПриложенностиМЧД <> ФайлОбменаОбъект.СтатусПриложенностиМЧД Тогда
			
			ФайлОбменаОбъект.Записать();
			
		КонецЕсли;
		
		// могла прийти подпись - синхронизировать её в файл и если есть следующий по цепочке титул - в него
		Если НайденныйФайлОбмена.ПодписьВерна = Ложь
			И КонтентДокументооборота.ХранилищеКонтента.Свойство("Signature")
			И КонтентДокументооборота.ХранилищеКонтента.Signature <> Неопределено Тогда
			
			ПрисвоитьПодписьВФайлОбъект(BoxId, Document, MessageId, КонтентДокументооборота, ПараметрыСервиса, ФайлОбменаОбъект);
			
			ФайлОбменаОбъект.Записать();
			
		КонецЕсли;
		
		ФайлОбменаСсылка = ФайлОбменаОбъект.Ссылка;
		
	КонецЕсли;
	
	// Сохранить OuterDocflow в файл
	ПараметрыЗапроса = Новый Структура("ПараметрыСервиса, BoxId, MessageId", ПараметрыСервиса, BoxId, MessageId);
	OuterDocflows = ДанныеСобытия.Event.Document.Docflow.OuterDocflows;
	ДатаСобытияМСК = Ticks_2_МСК(ДанныеСобытия.Event.Timestamp.Ticks);
	
	КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьOuterDocflowsВФайл(ФайлОбменаСсылка, ПараметрыЗапроса, OuterDocflows, ДатаСобытияМСК);
	
КонецПроцедуры

Функция СоздатьФайлОбменаПоСобытию(ДанныеСобытия, КонтентДокументооборота, ПараметрыСервиса, BoxId, 
	Document, ЭтоШаблон, ОтправительШаблона, ВерсияДокумента = Неопределено)
	
	FileNameБезxml = СтрЗаменить(Document.FileName, ".xml", "");
	GUID = Прав(СокрЛП(FileNameБезxml), 36);
	EntityId = КонтентДокументооборота.ХранилищеКонтента.Attachment.Entity.EntityId;
	MessageId = ДанныеСобытия.LetterId;
	DocumentId = ДанныеСобытия.DocumentId;
	
	ФайлОбменаОбъект = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьЭлемент();
	
	ДвоичныеДанныеТитула = Ядро().АПИ_GetEntityContent(ПараметрыСервиса, BoxId, MessageId, EntityId);
	
	ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТитула, "windows-1251");
	
	ФайлОбменаОбъект.GUID = GUID;
	ФайлОбменаОбъект.ТекстXML = Новый ХранилищеЗначения(ТекстXML, Новый СжатиеДанных(9));
	
	ФайлОбменаОбъект.DocumentId = DocumentId;
	ФайлОбменаОбъект.MessageID = MessageID;
	
	ФайлОбменаОбъект.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(Document.FileName,, ВерсияДокумента);
	ФайлОбменаОбъект.ИмяФайла = FileNameБезxml;
	
	СтороныОбменаДиадок = Справочники.КонтурЛогистика_ФайлыОбмена.ОтправительИПолучательПоFileName(FileNameБезxml, ВерсияДокумента);
	Если ЭтоШаблон Тогда
		ФайлОбменаОбъект.Отправитель = СтороныОбменаДиадок.Получатель;
		ФайлОбменаОбъект.Получатель = СтороныОбменаДиадок.Отправитель;
	Иначе
		ФайлОбменаОбъект.Отправитель = СтороныОбменаДиадок.Отправитель;
		ФайлОбменаОбъект.Получатель = СтороныОбменаДиадок.Получатель;
	КонецЕсли;
	
	Если ЭтоШаблон Тогда
		ФайлОбменаОбъект.ОтправительШаблона = ОтправительШаблона;
	КонецЕсли;
	
	// Документ создан из шаблона
	Если Document.Свойство("Origin") И Document.Origin.MessageType = "Template" Тогда
		ФайлОбменаОбъект.ШаблонОснование = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(Document.Origin.MessageId, DocumentId);
	КонецЕсли;
	
	// Внимание! в Document в Диадоке отправитель и получатель - будут те стороны, которые физически отправляют(пересылают) и получают документ,
	// а нам нужны тут стороны утверждающие факты хоз. деятельности (главные участники документооборота, а не те, которым форвардят)
	//ОтправительBoxId = КонтурЛогистика_API_Диадок.АдресЯщикаВИдентификатор(ДанныеСобытия.Event.Document.DocumentInfo.Participants.Sender.BoxId);
	//ФайлОбменаОбъект.ОтправительПодразделение = Справочники.КонтурЛогистика_ПодразделенияДиадок.ПолучитьПодразделениеПоId(Document.FromDepartmentId, ОтправительBoxId);
	//ПолучательBoxId = КонтурЛогистика_API_Диадок.АдресЯщикаВИдентификатор(ДанныеСобытия.Event.Document.DocumentInfo.Participants.Recipient.BoxId);
	//ФайлОбменаОбъект.ПолучательПодразделение = Справочники.КонтурЛогистика_ПодразделенияДиадок.ПолучитьПодразделениеПоId(Document.ToDepartmentId, ПолучательBoxId); 
	
	ФайлОбменаОбъект.ДатаВремяФормирования =  Ticks_2_МСК(Document.CreationTimestampTicks);
	ФайлОбменаОбъект.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен;
	
	Попытка
		
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);
		
		ФайлОбменаОбъект.ВерсияФормата = XDTO.ВерсФорм;
		ФайлОбменаОбъект.ВерсияПрограммы = XDTO.ВерсПрог;
		
	Исключение
		// мало ли что-то случится с XDTO
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ОписаниеОшибки());
	КонецПопытки;
	
	Если КонтентДокументооборота.ХранилищеКонтента.Свойство("Signature")
		И КонтентДокументооборота.ХранилищеКонтента.Signature <> Неопределено Тогда 
		
		ПрисвоитьПодписьВФайлОбъект(BoxId, Document, MessageId, КонтентДокументооборота, ПараметрыСервиса, ФайлОбменаОбъект);
		
	КонецЕсли;
	
	ФайлОбменаОбъект.LastEventTimestampTicks = ДанныеСобытия.Event.Timestamp.Ticks;
	
	CustomData = ДанныеСобытия.Event.Document.DocumentInfo.CustomData;
	// TODO объединить с КонтурЛогистика_ОбработкаДокументовСервер.СохранитьДанныеCustomDataВФайл
	СинхронизироватьCustomDataФайла(ФайлОбменаОбъект, CustomData, ФайлОбменаОбъект.LastEventTimestampTicks, ДанныеСобытия.Event.EventId);
	
	// идентификатор пакета
	Если Document.Свойство("PacketId") Тогда 
		ФайлОбменаОбъект.PacketId = Document.PacketId;
	КонецЕсли;
	
	// Сохранить Пришедшую МЧД
	РеквизитыДоверенностиВФайл(ДанныеСобытия, ФайлОбменаОбъект);
	ФайлОбменаОбъект.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок;
	
	// Признак тестового документа
	Если ДанныеСобытия.Event.Document.DocumentInfo.Свойство("LetterInfo")
		И ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.Свойство("IsTest") Тогда
		ФайлОбменаОбъект.ТестовыйДокумент = ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.IsTest;
	КонецЕсли;
	
	ФайлОбменаОбъект.Записать();
	
	Возврат ФайлОбменаОбъект.Ссылка;
	
КонецФункции

Процедура РеквизитыДоверенностиВФайл(Знач ДанныеСобытия, Знач ФайлОбменаОбъект, DocflowTitle = Неопределено)
	
	Если Не ЗначениеЗаполнено(DocflowTitle) Тогда
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоОтветныйТитул(ФайлОбменаОбъект.ТипДокумента)
			И Не ДанныеСобытия.Event.Document.DocumentInfo.FullVersion.Function = "fwd" Тогда // пересланные документы логистики всегда SenderTitle
			Если ДанныеСобытия.Event.Document.Docflow.Свойство("RecipientResponse") Тогда 
				DocflowTitle = ДанныеСобытия.Event.Document.Docflow.RecipientResponse;
			Иначе
				DocflowTitle = Неопределено;
			КонецЕсли;
		Иначе
			DocflowTitle = ДанныеСобытия.Event.Document.Docflow.SenderTitle.Attachment;
		КонецЕсли;
	КонецЕсли;
	
	Если Не DocflowTitle = Неопределено И DocflowTitle.Свойство("Signature") Тогда
				
		Если DocflowTitle.Signature.Свойство("PowerOfAttorney") Тогда
		
			ДанныеДоверенности = DocflowTitle.Signature.PowerOfAttorney;
			
			Если ФайлОбменаОбъект.ИдентификаторМЧД <> ДанныеДоверенности.FullId.RegistrationNumber
				ИЛИ (ДанныеДоверенности.Свойство("Status") 
					И ДанныеДоверенности.Status.Свойство("StatusNamedId")
					И ФайлОбменаОбъект.СтатусПроверкиМЧДПоТитулу <> ДанныеДоверенности.Status.StatusNamedId) Тогда 
				
				ФайлОбменаОбъект.ИдентификаторМЧД 			=  ДанныеДоверенности.FullId.RegistrationNumber;
				Если ДанныеДоверенности.Свойство("Status") И ДанныеДоверенности.Status.Свойство("StatusNamedId") Тогда 
					ФайлОбменаОбъект.СтатусПроверкиМЧДПоТитулу 	=  ДанныеДоверенности.Status.StatusNamedId;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДанныеДоверенности.Свойство("Status")
				И ДанныеДоверенности.Status.StatusNamedId <> "IsValid" 
				И ДанныеДоверенности.Status.Свойство("ValidationProtocol") Тогда
				
				Ошибки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибкиИзПротоколаВалидации(ДанныеДоверенности.Status.ValidationProtocol);
		
				ФайлОбменаОбъект.ОшибкиПроверкиМЧД = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(Ошибки);
				
				Если ДанныеДоверенности.Status.StatusNamedId <> "HasWarnings" Тогда
					УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД, , Ошибки);
				КонецЕсли;
				
			ИначеЕсли ДанныеДоверенности.Свойство("Status")
				И ДанныеДоверенности.Status.Свойство("OperationError") Тогда
		
				OperationError = ДанныеДоверенности.Status.OperationError;
				
				Ошибки = Новый Массив();
				Ошибки.Добавить(Новый Структура("Code, Text", 
					OperationError.Code, 
					?(OperationError.Свойство("Text"), OperationError.Text, "")));
					
				ФайлОбменаОбъект.ОшибкиПроверкиМЧД = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(Ошибки);	
				
				УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД, , Ошибки);
				
			ИначеЕсли ДанныеДоверенности.Свойство("Status") 
				И ДанныеДоверенности.Status.Свойство("Errors")
				И ДанныеДоверенности.Status.Errors <> Неопределено
				И ДанныеДоверенности.Status.Errors.Количество() > 0 Тогда
				
				Ошибки = ДанныеДоверенности.Status.Errors;
				
				ФайлОбменаОбъект.ОшибкиПроверкиМЧД = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(Ошибки);	
				
				УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД, , Ошибки);
				
			КонецЕсли;
			
			ЗагрузитьВходящуюМЧД(ДанныеСобытия.BoxId, ДанныеСобытия.Event.Document.DocumentId.MessageId, ДанныеДоверенности);
			ОбновитьСтатусМЧД(ДанныеДоверенности, Ошибки);
			
		КонецЕсли;
		
		Если DocflowTitle.Signature.Свойство("PowerOfAttorneyAttachmentStatus") Тогда
			
			ЗаписатьPowerOfAttorneyAttachmentStatusВФайл(DocflowTitle.Signature.PowerOfAttorneyAttachmentStatus, ФайлОбменаОбъект);
			
		КонецЕсли;
		
	Иначе
		
		ДанныеДоверенности = Неопределено;
				
	КонецЕсли;	

КонецПроцедуры

Процедура ЗаписатьPowerOfAttorneyAttachmentStatusВФайл(PowerOfAttorneyAttachmentStatus, ФайлОбменаОбъект)
	
	ФайлОбменаОбъект.СтатусПриложенностиМЧД = PowerOfAttorneyAttachmentStatus.StatusName;
						
	Если PowerOfAttorneyAttachmentStatus.Свойство("Comment") Тогда
		ФайлОбменаОбъект.СтатусПриложенностиМЧДОписание = PowerOfAttorneyAttachmentStatus.Comment;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьВходящуюМЧД(BoxId, MessageId, PowerOfAttorney)
	
	EntityId = PowerOfAttorney.Entity.EntityId;

	Если PowerOfAttorney.SendingType = "File" Тогда
		Попытка
			Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetPowerOfAttorneyContent(BoxId, MessageId, EntityId);
		Исключение
			Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetPowerOfAttorneyInfo(BoxId, MessageId, EntityId);
		КонецПопытки;
	Иначе
		Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetPowerOfAttorneyInfo(BoxId, MessageId, EntityId);	
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.Свойство("Content") И Ответ.Свойство("Signature") Тогда
		Если ЗначениеЗаполнено(Ответ.Content) И ЗначениеЗаполнено(Ответ.Signature) Тогда
			КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьМЧДИзФайла(Base64Значение(Ответ.Content), Base64Значение(Ответ.Signature)); 	
		КонецЕсли;
	Иначе
		Если Ответ.Свойство("FullId") Тогда
			КонтурЛогистика_МашиночитаемыеДовернностиСервер.ЗагрузитьPowerOfAttorney(Ответ);
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьСтатусМЧД(ДанныеДоверенности, ОшибкиМЧД)
	
	Если ДанныеДоверенности.Свойство("Status") Тогда
		
		МЧД = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", ДанныеДоверенности.FullId.RegistrationNumber);
		Если Не МЧД.Пустая() Тогда
			
			МЧДОб = МЧД.ПолучитьОбъект();
			
			Если ДанныеДоверенности.Status.Свойство("StatusNamedId") Тогда
				МЧДОб.СтатусПроверки = ДанныеДоверенности.Status.StatusNamedId;	
			КонецЕсли;
			Если ДанныеДоверенности.Status.Свойство("StatusText") Тогда
				МЧДОб.ТекстСтатусаПроверки = ДанныеДоверенности.Status.StatusText;	
			КонецЕсли;
			Если ЗначениеЗаполнено(ОшибкиМЧД) Тогда
				МЧДОб.ОшибкиПроверки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(ОшибкиМЧД);	
			КонецЕсли;
			
			МЧДОб.ДатаПроверки = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();;
			
			МЧДОб.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрисвоитьПодписьВФайлОбъект(BoxId, Document, MessageId, КонтентДокументооборота, ПараметрыСервиса, ФайлОбменаОбъект)
	
	Перем EntityIdПодписи, ДанныеПодписанта, ДвоичныеДанныеПодписи, СведенияСертификата;
	
	ФайлОбменаОбъект.ПодписьВерна =  Document.SenderSignatureStatus = "SenderSignatureCheckedAndValid";
	
	ФайлОбменаОбъект.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи[Document.SenderSignatureStatus];
	
	EntityIdПодписи = КонтентДокументооборота.ХранилищеКонтента.Signature.Cms.EntityId;
	
	ДвоичныеДанныеПодписи = Ядро().АПИ_GetEntityContent(ПараметрыСервиса,
									BoxId,
									MessageId,
									EntityIdПодписи);
	
	ФайлОбменаОбъект.Подпись = Новый ХранилищеЗначения(ДвоичныеДанныеПодписи); 
	
	ПолучитьДанныеПодписата(BoxId, Document, MessageId, EntityIdПодписи, ПараметрыСервиса, ФайлОбменаОбъект, ДвоичныеДанныеПодписи);
				
КонецПроцедуры

Процедура ПолучитьДанныеПодписата(BoxId, Document, MessageId, EntityIdПодписи, ПараметрыСервиса, ФайлОбменаОбъект, ДвоичныеДанныеПодписи)
	
	SignatureInfo = GetSignatureInfo(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
		
	// Попадаем в этот метод из двух разных методов:
	// 1) ПрисвоитьПодписьВФайлОбъект(), в этом случае структура Document получена методом API V3/GetDocument, и SenderSignatureStatus в корне
	// 2) СинхронизироватьФайлОтветомПолучателя(), например при загрузке Т2 ЭЗЗ из ленты Диадока, в этом случае структура Document получена 
	//    методом V3/GetDocflowEvents, и SenderSignatureStatus находится в Document.Docflow.SenderTitle
	SenderSignatureStatus = "";
	Если Document.Свойство("SenderSignatureStatus") Тогда
		SenderSignatureStatus = Document.SenderSignatureStatus;
	ИначеЕсли Document.Свойство("Docflow") Тогда
		SenderSignatureStatus = Document.Docflow.SenderTitle.SenderSignatureStatus;
	КонецЕсли;
	
	Если SignatureInfo <> Неопределено И SenderSignatureStatus = "SenderSignatureCheckedAndInvalid" Тогда 
		
		СтатусПроверкиСертификата = СтатусПроверкиСертификата(SignatureInfo);
		Если ЗначениеЗаполнено(СтатусПроверкиСертификата) Тогда
			ФайлОбменаОбъект.СтатусПроверкиСертификата = СтатусПроверкиСертификата;
		КонецЕсли;
		
		УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи, СтатусПроверкиСертификата);
			
	КонецЕсли;
	
	Если КонтурЛогистика_КриптографияСерверПовтИсп.МодульКриптографииИнициализирован() Тогда
	
		ДанныеПодписанта = Ядро().ДанныеПодписантаИзПодписи(Base64Строка(ДвоичныеДанныеПодписи));
		ФайлОбменаОбъект.КомуВыданСертификат = ДанныеПодписанта.Подписант 
					+ ?(ДанныеПодписанта.Свойство("Тип"), ", " + ДанныеПодписанта.Тип, "");
		
		СведенияСертификата = Ядро().ПолучитьСертификатИзПодписи(ДвоичныеДанныеПодписи);
		ФайлОбменаОбъект.Отпечаток = СведенияСертификата.Отпечаток;
		ФайлОбменаОбъект.Сертификат = Новый ХранилищеЗначения(СведенияСертификата.ДвоичныеДанные);
				
	ИначеЕсли SignatureInfo <> Неопределено Тогда		
			
		ЗаписатьДанныеПодписантаВФайл(ФайлОбменаОбъект, SignatureInfo, ДвоичныеДанныеПодписи);	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьДанныеПодписантаВФайл(ФайлОбменаОбъект, SignatureInfo, ДвоичныеДанныеПодписи)
	
	Подписант = ?(SignatureInfo.Свойство("Surname"), SignatureInfo.Surname + " ", "") +
		?(SignatureInfo.Свойство("FirstName"), SignatureInfo.FirstName, ""); 
		
	Если SignatureInfo.Свойство("CertificateSubjectType") Тогда
		
		Если SignatureInfo.CertificateSubjectType = "UnknownCertificateSubjectType" Тогда
			Тип = "";	
		ИначеЕсли SignatureInfo.CertificateSubjectType = "LegalEntity" И SignatureInfo.Свойство("OrgName") И ЗначениеЗаполнено(SignatureInfo.OrgName) Тогда
			Тип = SignatureInfo.OrgName;	
		ИначеЕсли SignatureInfo.CertificateSubjectType = "IndividualEntity" Тогда
			Тип = "ИП";	
		ИначеЕсли SignatureInfo.CertificateSubjectType = "PhysicalPerson" Тогда
			Тип = "Физ лицо";	
		Иначе
			Тип = "";
		КонецЕсли;
		
	Иначе	
		Тип = "";	
	КонецЕсли;
	
	ФайлОбменаОбъект.КомуВыданСертификат = Подписант + ?(ЗначениеЗаполнено(Тип), ", " + Тип, "");
	
	ФайлОбменаОбъект.Отпечаток = ?(SignatureInfo.Свойство("Thumbprint"), SignatureInfo.Thumbprint, "");
	
	DerCertificate = Неопределено;
	Если SignatureInfo.Свойство("SignatureVerificationResult") 
		И SignatureInfo.SignatureVerificationResult.Свойство("CertificateStatus")
		И SignatureInfo.SignatureVerificationResult.CertificateStatus.Свойство("CertificateChain")
		И SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain.Количество() > 0
		И SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain[0].Свойство("DerCertificate") Тогда
	
		DerCertificate = SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain[0].DerCertificate;
			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(DerCertificate) Тогда
		ФайлОбменаОбъект.Сертификат = Новый ХранилищеЗначения(Base64Значение(DerCertificate));
	КонецЕсли;
	
КонецПроцедуры

// Возваращает EntityIdПодписи: приоритетно кадестированной, а если кадестированной нет то cms  
Функция ПолучитьEntityIdПодписи(Знач Signature)
	
	Если Signature.Свойство("CadesT") Тогда 
		EntityIdПодписи = Signature.CadesT.EntityId;
	Иначе
		EntityIdПодписи = Signature.Cms.EntityId;
	КонецЕсли;
	
	Возврат EntityIdПодписи;

КонецФункции

Функция ПроверитьПодпись(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи)
	
	СтатусПроверкиСертификата = 0;
	
	SignatureInfo = GetSignatureInfo(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
	
	Если SignatureInfo = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтатусПроверкиСертификата = СтатусПроверкиСертификата(SignatureInfo);
	
	Возврат СтатусПроверкиСертификата;
	
КонецФункции

Функция GetSignatureInfo(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи)
	
	Попытка
		Возврат Ядро().АПИ_GetSignatureInfo(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
			
КонецФункции

Функция СтатусПроверкиСертификата(SignatureInfo)
	
	СтатусПроверкиСертификата = 0;
	 			
	Если SignatureInfo.Свойство("SignatureVerificationResult") 
		И SignatureInfo.SignatureVerificationResult.Свойство("CertificateStatus")
		И SignatureInfo.SignatureVerificationResult.CertificateStatus.Свойство("CertificateChain")
		И SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain.Количество() > 0 
	Тогда		
	    СтатусПроверкиСертификата = SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain[0].CertificateChainStatusFlags; 	
	КонецЕсли;
	
	Возврат СтатусПроверкиСертификата;
	
КонецФункции

Процедура СинхронизироватьCustomDataФайла(ФайлОбменаОбъект, CustomData, Ticks, EventId = Неопределено) Экспорт

		Для Каждого ЭлементCustomData Из CustomData Цикл 
			
			Если ЭлементCustomData.Key = "kl-id" И ФайлОбменаОбъект.kl_id = "" Тогда 
				
				ФайлОбменаОбъект.kl_id = ЭлементCustomData.Value;
				
			Иначе
				
				НоваяЗапись = ФайлОбменаОбъект.CustomData.Добавить();
				НоваяЗапись.Key = ЭлементCustomData.Key;
				НоваяЗапись.Value = ЭлементCustomData.Value;
				НоваяЗапись.ДатаВремяМСКПолучения = Ticks_2_МСК(Ticks);
				НоваяЗапись.EventId = EventId;
				
				// Отправка уведомлений водителю о необходимости подписать
				Если НоваяЗапись.Key = "kl-status"
					И (НоваяЗапись.Value = "r-wait-driver-approve"
						Или НоваяЗапись.Value = "d-wait-driver-approve"
						Или НоваяЗапись.Value = "pd-wait-driver-approve")
					И ФайлОбменаОбъект.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
					И ЗначениеЗаполнено(ФайлОбменаОбъект.ГлавныйДокумент) Тогда
					
					Попытка
						КонтурЛогистика_Уведомления.ОтправитьУведомленияОНеобходимостиПодписатьВодителем(
							ФайлОбменаОбъект.ГлавныйДокумент, НоваяЗапись.Value);
					Исключение
						ТекстОшибки = "Ошибка при отправке уведомления водителя. Ошибка: " + ОписаниеОшибки();
						ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
						ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ФайлОбменаОбъект.ГлавныйДокумент, ТекстОшибки);
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;

КонецПроцедуры

Процедура СинхронизироватьФайлОтветомПолучателя(EntityId, ДанныеСобытия, BoxId, ПараметрыСервиса, ОтветПолучателя = Неопределено, КонтентДокументооборота, ИсхФайл = Неопределено)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	MessageId 	= ДанныеСобытия.LetterId;
	DocumentId 	= ДанныеСобытия.DocumentId;
	Document = ДанныеСобытия.Event.Document;
	
	ИдФайлаБезXML = СтрЗаменить(КонтентДокументооборота.ХранилищеКонтента.Attachment.AttachmentFilename, ".xml", "");
	GUIDИсхФайл = Прав(СокрЛП(ИдФайлаБезXML), 36);
	
	Если ИсхФайл = Неопределено Тогда 
		ИсхФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUIDИсхФайл,, Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен);  
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсхФайл) Тогда
				
		ДвоичныеДанныеТитулаОтветаПолучателя = Ядро().АПИ_GetEntityContent(ПараметрыСервиса,
																			BoxId,
																			MessageId,
																			EntityId);
		
		ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТитулаОтветаПолучателя, "windows-1251");
		
		XDTO = КС.ПолучитьXDTOпоXML(ТекстXML);
		
		FileNameБезxml = XDTO.ИдФайл;
		GUID = Прав(FileNameБезxml, 36);
		УжеЗагруженныйЭтотФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUID);
		Если ЗначениеЗаполнено(УжеЗагруженныйЭтотФайл) Тогда
			
			// обновим статусы подписи и МЧД
			
			ФайлОбменаОбъект = УжеЗагруженныйЭтотФайл.ПолучитьОбъект();
			
			Если КонтентДокументооборота.Свойство("ТитулПокупателя") ИЛИ КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента")  Тогда 
			
				Если КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента") И КонтентДокументооборота.ОтказВПодписанииДокумента.Свойство("Signature") Тогда 
					
					ФайлОбменаОбъект.ПодписьВерна =  Document.Docflow.RecipientResponse.Rejection.SignatureRejection.Signature.IsValid;
					
					EntityIdПодписи = ПолучитьEntityIdПодписи(КонтентДокументооборота.ОтказВПодписанииДокумента.Signature); 
					
				ИначеЕсли КонтентДокументооборота.Свойство("ТитулПокупателя") И КонтентДокументооборота.ТитулПокупателя.Свойство("Signature") Тогда
					
					ФайлОбменаОбъект.ПодписьВерна =  Document.Docflow.RecipientResponse.Signature.IsValid;
					
					EntityIdПодписи = ПолучитьEntityIdПодписи(КонтентДокументооборота.ТитулПокупателя.Signature);
					
				КонецЕсли;
				
				Если ФайлОбменаОбъект.ПодписьВерна Тогда 
					СтатусПроверкиСертификата = ПроверитьПодпись(ПараметрыСервиса, BoxId, MessageId, EntityIdПодписи);
					Если ЗначениеЗаполнено(СтатусПроверкиСертификата) Тогда
						
						ФайлОбменаОбъект.СтатусПроверкиСертификата = СтатусПроверкиСертификата;
						Если СтатусПроверкиСертификата <> 0 Тогда
							УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи, СтатусПроверкиСертификата);		
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			РеквизитыДоверенностиВФайл(ДанныеСобытия, ФайлОбменаОбъект);
			
			ФайлОбменаОбъект.Записать();
			
			Возврат;
		Иначе
			ФайлОбменаОбъект = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьЭлемент();
		КонецЕсли;
		
		ФайлОбменаОбъект.ТекстXML = Новый ХранилищеЗначения(ТекстXML, Новый СжатиеДанных(9));
		
		ФайлОбменаОбъект.DocumentId = DocumentId;
		ФайлОбменаОбъект.MessageID 	= MessageID;
		
		ФайлОбменаОбъект.ГлавныйДокумент = ИсхФайл.ГлавныйДокумент;
		
		ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(XDTO.ИдФайл, ИсхФайл.ТипДокумента);
		
		ФайлОбменаОбъект.ТипДокумента = ТипДокумента;
		ФайлОбменаОбъект.ИмяФайла = XDTO.ИдФайл;
		
		ФайлОбменаОбъект.Отправитель 				= ИсхФайл.Получатель;
		ФайлОбменаОбъект.ОтправительПодразделение 	= ИсхФайл.ПолучательПодразделение;
		
		ФайлОбменаОбъект.Получатель 				= ИсхФайл.Отправитель;
		ФайлОбменаОбъект.ПолучательПодразделение 	= ИсхФайл.ОтправительПодразделение; 
		
		ФайлОбменаОбъект.ДатаВремяФормирования =  КС.КонвертироватьДатаВремяФормированияИзXDTOФайл(XDTO, ФайлОбменаОбъект.ТипДокумента);
		
		
		ФайлОбменаОбъект.GUID = Прав(СокрЛП(FileNameБезxml), 36);
		ФайлОбменаОбъект.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен;
		
		CustomData = Document.DocumentInfo.CustomData;
		Для Каждого ЭлементCustomData Из CustomData Цикл 
			Если ЭлементCustomData.Key = "kl-id" Тогда 
				ФайлОбменаОбъект.kl_id = ЭлементCustomData.Value;
			КонецЕсли;
		КонецЦикла;
		
		ФайлОбменаОбъект.ВерсияФормата = КС.XDTO_Вычислить(XDTO, "ВерсФорм");
		ФайлОбменаОбъект.ВерсияПрограммы = КС.XDTO_Вычислить(XDTO, "ВерсПрог");
		
		Если КонтентДокументооборота.Свойство("ТитулПокупателя") ИЛИ КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента")  Тогда 
			
			Если КонтентДокументооборота.Свойство("ОтказВПодписанииДокумента") И КонтентДокументооборота.ОтказВПодписанииДокумента.Свойство("Signature") Тогда 
				
				ФайлОбменаОбъект.ПодписьВерна =  Document.Docflow.RecipientResponse.Rejection.SignatureRejection.Signature.IsValid;
				
				EntityIdПодписи = ПолучитьEntityIdПодписи(КонтентДокументооборота.ОтказВПодписанииДокумента.Signature); 
				
			ИначеЕсли КонтентДокументооборота.Свойство("ТитулПокупателя") И КонтентДокументооборота.ТитулПокупателя.Свойство("Signature") Тогда
				
				ФайлОбменаОбъект.ПодписьВерна =  Document.Docflow.RecipientResponse.Signature.IsValid;
				
				EntityIdПодписи = ПолучитьEntityIdПодписи(КонтентДокументооборота.ТитулПокупателя.Signature);				
				
			КонецЕсли;
			
			ДвоичныеДанныеПодписи = Ядро().АПИ_GetEntityContent(ПараметрыСервиса,
				BoxId,
				MessageId,
				EntityIdПодписи);
			
			ФайлОбменаОбъект.Подпись = Новый ХранилищеЗначения(ДвоичныеДанныеПодписи); 
			
			ПолучитьДанныеПодписата(BoxId, Document, MessageId, EntityIdПодписи, ПараметрыСервиса, ФайлОбменаОбъект, ДвоичныеДанныеПодписи);
											
			РеквизитыДоверенностиВФайл(ДанныеСобытия, ФайлОбменаОбъект);
			
		КонецЕсли;
		
		ФайлОбменаОбъект.LastEventTimestampTicks = ДанныеСобытия.Event.Timestamp.Ticks;
		Если Document.DocumentInfo.PacketInfo.Свойство("PacketId") Тогда 
			ФайлОбменаОбъект.PacketId = Document.DocumentInfo.PacketInfo.PacketId;
		КонецЕсли;
		
		// Признак тестового документа
		Если ФайлОбменаОбъект.КаналТранспорта <> Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика
			И ДанныеСобытия.Event.Document.DocumentInfo.Свойство("LetterInfo")
			И ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.Свойство("IsTest") Тогда
			ФайлОбменаОбъект.ТестовыйДокумент = ДанныеСобытия.Event.Document.DocumentInfo.LetterInfo.IsTest;
		КонецЕсли;
		
		ФайлОбменаОбъект.Записать();
		
	Иначе
		
		// кейс для ГО = ГП
		Если КонтентДокументооборота.Свойство("ТитулПокупателя") И КонтентДокументооборота.Свойство("ХранилищеКонтента") Тогда 
			
			ИмяФайлаХранКонтента 		= КонтентДокументооборота.ХранилищеКонтента.Attachment.AttachmentFilename;
			ИмяФайлаТитулаПокупателя 	= КонтентДокументооборота.ТитулПокупателя.Attachment.AttachmentFilename;
			
			ТипТитулаХранКонтента 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(ИмяФайлаХранКонтента);
			ТипТитулаПокупателя 	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(ИмяФайлаТитулаПокупателя);
			
			Если ТипТитулаХранКонтента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
				И ТипТитулаПокупателя = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда  
				
				ДвоичныеДанныеТ1 = Ядро().АПИ_GetEntityContent(
					ПараметрыСервиса,
					BoxId,
					MessageId,
					КонтентДокументооборота.ХранилищеКонтента.Attachment.Entity.EntityId);
				
				ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТ1, "windows-1251");				
				
				XDTO_Т1 = КС.ПолучитьXDTOпоXML(ТекстXML);
				
				РекИдентГО = КС.XDTO_Вычислить(XDTO_Т1, "Документ.СодИнфГО.СвГО.РекИдентГО");
				РекИдентГП = КС.XDTO_Вычислить(XDTO_Т1, "Документ.СодИнфГО.СвГП.РекИдентГП");
				
				ГО = ПолучитьИННОрганизацииИзXDTO(РекИдентГО);
				ГП = ПолучитьИННОрганизацииИзXDTO(РекИдентГП);
				
				Если Не ГО = Неопределено И Не ГП = Неопределено И ГО = ГП Тогда 						
					
					СинхронизироватьВходящийForwardingДокумент(ДанныеСобытия, BoxId, ПараметрыСервиса, КонтентДокументооборота);
					
					ИсхФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUIDИсхФайл,, Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен);
					Если ЗначениеЗаполнено(ИсхФайл) Тогда 
						СинхронизироватьФайлОтветомПолучателя(EntityId, ДанныеСобытия, BoxId, ПараметрыСервиса, ОтветПолучателя, КонтентДокументооборота, ИсхФайл); 
					КонецЕсли;
					
				КонецЕсли;	
										
			КонецЕсли;	
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьИзмененияСтатусовВходящихИИсходящих(Знач ОрганизацияДиадок, Знач ТаблицаСобытий, ПараметрыСервиса)
	
	Для Каждого СтрокаСобытия Из ТаблицаСобытий Цикл 
		
		//Если СтрокаСобытия.DocumentDirection <> "Outbound" Тогда 
		//	Возврат;
		//КонецЕсли;
		
		КонтентДокументооборота = Ядро().Лента_ДанныеДО(СтрокаСобытия, Истина);
		ИмяФайлаБезXML = СтрЗаменить(КонтентДокументооборота.ХранилищеКонтента.Attachment.AttachmentFilename, ".xml", "");
		GUID = Прав(ИмяФайлаБезXML, 36);
		
		НайденныйФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUID); // можно было бы не искать по GUID и не забирать контент из ДД, но могли отправтиь через апи логистики
		
		Если Не ЗначениеЗаполнено(НайденныйФайл) Тогда  // в каком-то сценарии (предположительно при патчинге) у файла изменяется GUID
			НайденныйФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(СтрокаСобытия.LetterId, СтрокаСобытия.DocumentId);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденныйФайл) Тогда
			
			ГлавныйДокумент = НайденныйФайл.ГлавныйДокумент;
			
			Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда
				
				ДатаСобытияUTC = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(СтрокаСобытия.Event.Timestamp.Ticks);
				ДатаСобытияМСК = МестноеВремя(ДатаСобытияUTC, "GMT+3"); 
				
				МассивCustomData = СтрокаСобытия.Event.Document.DocumentInfo.CustomData;
				
				// Отразим в файле и в документе ЭТрН
				КонтурЛогистика_ОбработкаДокументовСервер.СохранитьДанныеCustomDataВФайл(
					МассивCustomData, ДатаСобытияМСК, НайденныйФайл, СтрокаСобытия.Event.EventId);
				
				Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(НайденныйФайл.ТипДокумента) Тогда
					КаналТранспорта = КонтурЛогистика_ОбработкаДокументовСервер.КаналТранспортаПоИдентификаторуСобытия(СтрокаСобытия.Event.EventId);
					ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
						НайденныйФайл, СтрокаСобытия.Event.EventId, КаналТранспорта);
					КонтурЛогистика_ОбработкаДокументовСервер.СохранитьДанныеCustomDataВДокументЭТРН(
						МассивCustomData, ДатаСобытияМСК, ГлавныйДокумент, ДопДанные);
				КонецЕсли;
				
				// отразим изменения доверенности
				Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоОтветныйТитул(НайденныйФайл.ТипДокумента)
					И Не СтрокаСобытия.Event.Document.DocumentInfo.FullVersion.Function = "fwd" Тогда // пересланные документы логистики всегда SenderTitle 
					Если СтрокаСобытия.Event.Document.Docflow.Свойство("RecipientResponse") Тогда 
						DocflowTitle = СтрокаСобытия.Event.Document.Docflow.RecipientResponse;
					Иначе
						DocflowTitle = Неопределено;
					КонецЕсли;
				Иначе
					DocflowTitle = СтрокаСобытия.Event.Document.Docflow.SenderTitle.Attachment;
				КонецЕсли;
				
				Если Не DocflowTitle = Неопределено 
					И DocflowTitle.Свойство("Signature") Тогда
					
					ФайлОбменаОбъект = НайденныйФайл.ПолучитьОбъект();
					
					ФайлОбменаОбъект.ПодписьВерна =  СтрокаСобытия.Event.Document.Docflow.sendertitle.SenderSignatureStatus = "SenderSignatureCheckedAndValid";	
					ФайлОбменаОбъект.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи[СтрокаСобытия.Event.Document.Docflow.sendertitle.SenderSignatureStatus];
										
					Если СтрокаСобытия.Event.Document.Docflow.sendertitle.SenderSignatureStatus = "SenderSignatureCheckedAndInvalid" Тогда
						
						EntityIdПодписи = КонтентДокументооборота.ХранилищеКонтента.Signature.Cms.EntityId;
													
						СтатусПроверкиСертификата = ПроверитьПодпись(ПараметрыСервиса, СтрокаСобытия.BoxId, СтрокаСобытия.LetterId, EntityIdПодписи);
						Если ЗначениеЗаполнено(СтатусПроверкиСертификата) Тогда
							ФайлОбменаОбъект.СтатусПроверкиСертификата = СтатусПроверкиСертификата;
						КонецЕсли;
						
						УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи, СтатусПроверкиСертификата);
						
					КонецЕсли;
					
					Если DocflowTitle.Signature.Свойство("PowerOfAttorney") Тогда
						
						PowerOfAttorney = DocflowTitle.Signature.PowerOfAttorney;
						Если НайденныйФайл.ИдентификаторМЧД <> PowerOfAttorney.FullId.RegistrationNumber
							Или (PowerOfAttorney.Свойство("Status")
								И НайденныйФайл.СтатусПроверкиМЧДПоТитулу <> PowerOfAttorney.Status.StatusNamedId) Тогда
							
							РеквизитыДоверенностиВФайл(СтрокаСобытия, ФайлОбменаОбъект);
							
						КонецЕсли;
						
					ИначеЕсли DocflowTitle.Signature.Свойство("PowerOfAttorneyAttachmentStatus") Тогда
			
						ЗаписатьPowerOfAttorneyAttachmentStatusВФайл(DocflowTitle.Signature.PowerOfAttorneyAttachmentStatus, ФайлОбменаОбъект);
																
					КонецЕсли;
					
					// Признак тестового документа
					Если ФайлОбменаОбъект.КаналТранспорта <> Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика
						И СтрокаСобытия.Event.Document.DocumentInfo.Свойство("LetterInfo")
						И СтрокаСобытия.Event.Document.DocumentInfo.LetterInfo.Свойство("IsTest") Тогда
						ФайлОбменаОбъект.ТестовыйДокумент = СтрокаСобытия.Event.Document.DocumentInfo.LetterInfo.IsTest;
					КонецЕсли;
					
					ФайлОбменаОбъект.Записать();
					
				КонецЕсли;
				
				// Отказ медика
				Если НайденныйФайл.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
					И СтрокаСобытия.Event.Document.Docflow.Свойство("RecipientResponse") Тогда
					
					DocflowTitle = СтрокаСобытия.Event.Document.Docflow.RecipientResponse;
					
					Если DocflowTitle.Свойство("ResponseStatus")
						И НРег(DocflowTitle.ResponseStatus) = "recipientsignaturerequestrejected" Тогда
						
						СвязанныйДокумент = НайденныйФайл.СвязанныйДокумент;
						Если ЗначениеЗаполнено(СвязанныйДокумент) Тогда
							
							Если DocflowTitle.Свойство("Rejection")
								И DocflowTitle.Rejection.Свойство("PlainText") Тогда
								
								ПричинаОтказа = DocflowTitle.Rejection.PlainText;
								КонтурЛогистика_ОбработкаДокументовСервер.ЗаписатьПричинуОтказаВТитул(ПричинаОтказа, СвязанныйДокумент);
							КонецЕсли;
							
							РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
								СвязанныйДокумент, Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи);
								
							ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
								НайденныйФайл, СтрокаСобытия.Event.EventId, Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок);
							РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
								СвязанныйДокумент, "pl-rejected-cheсkup", ДатаСобытияМСК,,, ДопДанные);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				ПроверитьСтатусПодписиДляОтказа(СтрокаСобытия);
				
				// сохранить OuterDocflow в файл
				ПараметрыЗапроса 	= Новый Структура("ПараметрыСервиса, BoxId, MessageId", ПараметрыСервиса, СтрокаСобытия.BoxId, СтрокаСобытия.LetterId);
				OuterDocflows 		= СтрокаСобытия.Event.Document.Docflow.OuterDocflows;
				
				КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьOuterDocflowsВФайл(НайденныйФайл, ПараметрыЗапроса, OuterDocflows, ДатаСобытияМСК);
				
			КонецЕсли;
			
			Попытка
			
				СинхронизироватьПринадлежностьКПакетам(СтрокаСобытия.Event.Document.DocumentInfo, НайденныйФайл);
				СинхронизироватьMessageIDDocumentID(СтрокаСобытия.Event.Document, НайденныйФайл);
				
			Исключение
			
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьСтатусТитулаОшибкаСОписанием(ФайлОбменаОбъект, ТипОшибки, СтатусПроверкиСертификата = Неопределено, МассивОшибокМЧД = Неопределено)
	
	СвязанныйДокумент = ФайлОбменаОбъект.СвязанныйДокумент;
	Если ЗначениеЗаполнено(СвязанныйДокумент) Тогда
	
		Если ТипОшибки = Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаПодписи И СтатусПроверкиСертификата <> Неопределено Тогда
			
			ФайлОбменаОбъект.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки;
			
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("ТипОшибки", ТипОшибки);
			
			Если СтатусПроверкиСертификата = 0 Тогда			
				СтруктураОшибки.Вставить("КодОшибки", "");
				СтруктураОшибки.Вставить("ОписаниеОшибки", "Подпись не верна");
				СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", "Подпись не верна");
			Иначе
				ОписаниеОшибки = КонтурЛогистика_КриптографияСервер.ПолучитьСтатусПроверкиСертификатаПоКоду(СтатусПроверкиСертификата);
				
				СтруктураОшибки.Вставить("КодОшибки", Строка(СтатусПроверкиСертификата));
				СтруктураОшибки.Вставить("ОписаниеОшибки", "Ошибка сертификата");
				СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", ОписаниеОшибки);
			КонецЕсли;
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
							ФайлОбменаОбъект.СвязанныйДокумент, Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка, , , СтруктураОшибки);
			
		КонецЕсли;
		
		Если ТипОшибки = Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД И ЗначениеЗаполнено(МассивОшибокМЧД) Тогда
			
			ДоверятьМЧД = Ложь;
			МЧДСсылка = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", ФайлОбменаОбъект.ИдентификаторМЧД);		
			Если ЗначениеЗаполнено(МЧДСсылка) Тогда				
				ДоверятьМЧД = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПроверитьДоверие(МЧДСсылка, ФайлОбменаОбъект.Отпечаток, МассивОшибокМЧД);
			КонецЕсли;
			
			Если ДоверятьМЧД Тогда
				Возврат;
			КонецЕсли;
			
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("ТипОшибки", ТипОшибки);
			
			Для каждого Ошибка Из МассивОшибокМЧД Цикл
							
				СтруктураОшибки.Вставить("ОписаниеОшибки", Ошибка.Text);
				СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", Ошибка.Text);
				СтруктураОшибки.Вставить("КодОшибки", Ошибка.Code);
				
				НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка;
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ФайлОбменаОбъект.СвязанныйДокумент, НовыйСтатусТитула, , , СтруктураОшибки);
				
			КонецЦикла;
			
		КонецЕсли;	    	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтатусПодписиДляОтказа(СтрокаСобытия)
	
	Если СтрокаСобытия.Event.Document.Docflow.Свойство("RecipientResponse")
		И СтрокаСобытия.Event.Document.Docflow.RecipientResponse.Свойство("Rejection")
		И СтрокаСобытия.Event.Document.Docflow.RecipientResponse.Rejection.Свойство("SignatureRejection") 
		И СтрокаСобытия.Event.Document.Docflow.RecipientResponse.Rejection.SignatureRejection.Свойство("Signature") Тогда
		
		ИмяФайлаБезXML = СтрЗаменить(СтрокаСобытия.Event.Document.Docflow.RecipientResponse.Rejection.SignatureRejection.Attachment.AttachmentFilename, ".xml", "");
		GUID = Прав(ИмяФайлаБезXML, 36);
		
		НайденныйФайлОтказ = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоGUID(GUID); 
        Если ЗначениеЗаполнено(НайденныйФайлОтказ) Тогда
			
			ФайлОбменаОбъектОтказ = НайденныйФайлОтказ.ПолучитьОбъект();
			
			Signature = СтрокаСобытия.Event.Document.Docflow.RecipientResponse.Rejection.SignatureRejection.Signature;
			EntityId = Signature.Cms.EntityId;
			
			SignatureInfo = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetSignatureInfo(СтрокаСобытия.boxId, СтрокаСобытия.letterId, EntityId);
			
			Если SignatureInfo.Свойство("SignatureVerificationResult") 
				И SignatureInfo.SignatureVerificationResult.Свойство("CertificateStatus") Тогда
			
				ФайлОбменаОбъектОтказ.ПодписьВерна = SignatureInfo.SignatureVerificationResult.CertificateStatus.IsValid;	
				Если ФайлОбменаОбъектОтказ.ПодписьВерна Тогда
					ФайлОбменаОбъектОтказ.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи.SenderSignatureCheckedAndValid;
				Иначе
					ФайлОбменаОбъектОтказ.СтатусПодписи = Перечисления.КонтурЛогистика_СтатусыПодписи.SenderSignatureCheckedAndInvalid;
				КонецЕсли;
				Если SignatureInfo.SignatureVerificationResult.CertificateStatus.Свойство("CertificateChain") 
					И SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain.Количество() > 0 Тогда
					ФайлОбменаОбъектОтказ.СтатусПроверкиСертификата = SignatureInfo.SignatureVerificationResult.CertificateStatus.CertificateChain[0].CertificateChainStatusFlags;
				КонецЕсли;
				
				РеквизитыДоверенностиВФайл(СтрокаСобытия, ФайлОбменаОбъектОтказ, СтрокаСобытия.Event.Document.Docflow.RecipientResponse.Rejection.SignatureRejection);
				
				ФайлОбменаОбъектОтказ.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

// Делается для того чтобы при отправке через апи логистики и вычитывании ленты диадока проставить в файл идентификаторы диадока 
Процедура СинхронизироватьMessageIDDocumentID(Document, ФайлСсылка)
	
	Если Document.Свойство("DocumentId")
		И Document.DocumentId.Свойство("EntityId")
		И Document.DocumentId.Свойство("MessageId")
		И (Не ЗначениеЗаполнено(ФайлСсылка.DocumentId) 
		Или Не ЗначениеЗаполнено(ФайлСсылка.MessageID)) Тогда 
		
		ФайлОбменаОбъект 			= ФайлСсылка.ПолучитьОбъект();
		ФайлОбменаОбъект.MessageId 	= Document.DocumentId.MessageId;
		ФайлОбменаОбъект.DocumentId = Document.DocumentId.EntityId;
		ФайлОбменаОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьПринадлежностьКПакетам(DocumentInfo, ФайлСсылка)
	
	// актуализируем реквизит PacketId у Файла
	Если DocumentInfo.PacketInfo.Свойство("PacketId")
		И (ЗначениеЗаполнено(СокрЛП(ФайлСсылка.PacketId)) 
			ИЛИ ФайлСсылка.PacketId <> DocumentInfo.PacketInfo.PacketId) Тогда 
		
		ФайлОбменаОбъект = ФайлСсылка.ПолучитьОбъект();
		ФайлОбменаОбъект.PacketId = DocumentInfo.PacketInfo.PacketId;
		ФайлОбменаОбъект.Записать();
		
	ИначеЕсли ЗначениеЗаполнено(ФайлСсылка.PacketId) Тогда // был убран из пакета
		
		ФайлОбменаОбъект = ФайлСсылка.ПолучитьОбъект();
		ФайлОбменаОбъект.PacketId = "";
		ФайлОбменаОбъект.Записать();
		
	КонецЕсли;
	
	
	
КонецПроцедуры

// унаследована из Диадока (Ядро, МодульОбъекта) и модифицирована
Функция Лента_СобытияЯщикаОрганизации(boxId, tick_start = "", tick_final = "", AfterIndexKey = "", ПараметрыСервиса, DepartmentId = Неопределено)
	
	DocflowEventsRequest = Ядро().АПИ_Новый_GetDocflowEventsRequest(tick_start, tick_final, AfterIndexKey, Истина, , , DepartmentId);
	
	Попытка
		Результат = Ядро().АПИ_GetDocflowEvents_v3(ПараметрыСервиса, boxId, DocflowEventsRequest);
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// унаследована из Диадока (Ядро, МодульОбъекта) и модифицирована
Функция Лента_ТаблицаСобытийДляОбработки(BoxId, Events)
	
	Результат = Новый ТаблицаЗначений; 
	
	ОписаниеСтроки = Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(100));
	
	Результат.Колонки.Добавить("Event");
	Результат.Колонки.Добавить("ДокументЭДО");
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("ID",				ОписаниеСтроки);
	Результат.Колонки.Добавить("LetterId",			ОписаниеСтроки);
	Результат.Колонки.Добавить("BoxId",				ОписаниеСтроки);
	Результат.Колонки.Добавить("DocumentId",		ОписаниеСтроки);
	Результат.Колонки.Добавить("DocumentDirection",	ОписаниеСтроки);
	
	Для Каждого Event Из Events Цикл
		
		Если Event.Свойство("Document") И Event.Свойство("DocumentID") Тогда
			
			СтрокаСобытия = Результат.Добавить();
			
			СтрокаСобытия.BoxId 			= BoxId;
			СтрокаСобытия.LetterId 			= Event.DocumentId.MessageId;
			СтрокаСобытия.DocumentId 		= Event.DocumentId.EntityId;
			СтрокаСобытия.ID                = Новый_КлючИдентификатораДокумента(СтрокаСобытия.LetterId, СтрокаСобытия.DocumentId);
			СтрокаСобытия.DocumentDirection	= Event.Document.DocumentInfo.DocumentDirection;
			СтрокаСобытия.Event				= Event;			
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// унаследована из Диадока (Ядро, МодульОбъекта) и модифицирована
Функция Лента_СвернутьТаблицуСобытий(ТаблицаСобытий)
	
	Результат = ТаблицаСобытий.СкопироватьКолонки(); // создадим новую ТЗ
	
	ИменаКолонокСвертки = "BoxId,LetterId,DocumentId";
	ТаблицаСобытий.Индексы.Добавить(ИменаКолонокСвертки);
	
	ТаблицаСвернутая = ТаблицаСобытий.Скопировать(, ИменаКолонокСвертки);
	ТаблицаСвернутая.Свернуть(ИменаКолонокСвертки);
	СтруктураПоиска = Новый Структура(ИменаКолонокСвертки);
	
	Для Каждого СтрокаКлючей Из ТаблицаСвернутая Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаКлючей);
		СтрокиИсходнойТаблицы = ТаблицаСобытий.НайтиСтроки(СтруктураПоиска);
		НовСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, СтрокиИсходнойТаблицы[СтрокиИсходнойТаблицы.Количество() - 1]);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_КлючИдентификатораДокумента(LetterId, DocumentId) Экспорт
	
	Результат = "letterId_"+СтрЗаменить(LetterId, "-", "") + "_documentId_" + СтрЗаменить(DocumentId, "-", "");
	
	Возврат Результат;	
	
КонецФункции

