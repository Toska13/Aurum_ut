Функция ФункцияДокументаДиадокПоФайлуОбмена(файлОбменаСсылка)
	
	ТипДокумента = файлОбменаСсылка.ТипДокумента;
	
	Если ТипЗнч(файлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
			_Функция = "reception";
		Иначе
			_Функция = "";
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(файлОбменаСсылка.ТипДокумента) Тогда 
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда 
			_Функция = "default";
		Иначе
			_Функция = "";
		КонецЕсли;	
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоДФ(файлОбменаСсылка.ТипДокумента) Тогда 
		
		_Функция = "";
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(файлОбменаСсылка.ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			_Функция = "shippingTerms";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда	
			_Функция = "checkupBefore";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда	
			_Функция = "techInspection";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда	
			_Функция = "odometerBefore";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда	
			_Функция = "odometerAfter";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда	
			_Функция = "checkupAfter";
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(файлОбменаСсылка.ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
			_Функция = "logisticsfwdreceipt";
		Иначе
			ВызватьИсключение "Неизвестная функция экспедиторской расписки документа: " + файлОбменаСсылка + " по типу";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(файлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектронныйЗаказНаряд") Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2 Тогда 
			_Функция = "order";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3 Тогда
			_Функция = "arrival";
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4 Тогда
			_Функция = "return";
		Иначе
			ВызватьИсключение "Неизвестная функция заказ наряда документа: " + файлОбменаСсылка + " по типу";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(файлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость") Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1 
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул2 Тогда 
			_Функция = "ReceptionEmpty";
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул3 
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул4 Тогда
			_Функция = "ReceptionFull";
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул5 
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул6 Тогда
			_Функция = "DeliveryFull";
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул7 
			ИЛИ ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул8 Тогда
			_Функция = "ReturnEmpty";
			
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул9 Тогда
			_Функция = "ReturnConfirmation";
			
		Иначе
			ВызватьИсключение "Неизвестная функция заказ наряда документа: " + файлОбменаСсылка + " по типу";
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "неизвестная функция документа: " + файлОбменаСсылка + " Не знаю функцию документа ДД для него";
		
	КонецЕсли;
	
	Возврат _Функция;
	
КонецФункции

