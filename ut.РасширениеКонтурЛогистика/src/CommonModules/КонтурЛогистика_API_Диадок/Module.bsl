Функция ПодготовитьDocumentAttachment(файлОбменаСсылка) 
	
	ТипДокумента				= ТипДокументаДиадокПоФайлуОбмена(файлОбменаСсылка);
	//ТипКонтента				= ТипКонтентаДиадокПоФайлуОбмена(файлОбменаСсылка);
	ФункцияДокумента			= ФункцияДокументаДиадокПоФайлуОбмена(файлОбменаСсылка);
	
	ХранилищеКонтента = Контракт_ДанныеХранения();
	
	ХранилищеКонтента.Данные 	= СформироватьДвоичныеДанныеКонтентаФайла(файлОбменаСсылка);
	ХранилищеКонтента.Подпись.ДанныеПодписи = СформироватьДвоичныеДанныеПодписиФайла(файлОбменаСсылка);
	
	ДокументЗашифрован			= ЗначениеЗаполнено(ХранилищеКонтента.ЗашифрованныеДанные);
	Данные						= ?(ДокументЗашифрован, ХранилищеКонтента.ЗашифрованныеДанные, ХранилищеКонтента.Данные);
	ДанныеПодписи				= ХранилищеКонтента.Подпись.ДанныеПодписи;
	
	PowerOfAttorneyToPost = ПодготовитьPowerOfAttorneyToPost(файлОбменаСсылка);
	
	SignedContent = Ядро().АПИ_Новый_SignedContent(Данные, ДанныеПодписи, , , PowerOfAttorneyToPost);
	
	Результат =  Ядро().АПИ_Новый_DocumentAttachment(SignedContent, ТипДокумента);
	Результат.Вставить("CustomDocumentId",	Формат(файлОбменаСсылка.Код, "ЧГ="));
	Результат.Вставить("IsEncrypted",		ДокументЗашифрован);
	Результат.Вставить("Comment",			файлОбменаСсылка.Комментарий);
	
	Если ТипЗнч(файлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
		Если ЗначениеЗаполнено(СокрЛП(файлОбменаСсылка.ГлавныйДокумент.kl_id)) Тогда
			СтруктураCustomData = Новый Структура("Key, Value", "kl-id", файлОбменаСсылка.ГлавныйДокумент.kl_id);
			Результат.CustomData.Добавить(СтруктураCustomData);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыОтправки = Неопределено;
	
	// Результат.Вставить("NeedReceipt",	Ложь); // Не требуется отправлять этот опциональный флаг.
	// Результат.Вставить("NeedRecipientSignature",	Истина); // Не требуется отправлять этот опциональный флаг.
	
	Если ДокументЗашифрован 
		ИЛИ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(файлОбменаСсылка.ТипДокумента) 
		ИЛИ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(файлОбменаСсылка.ТипДокумента) 
		Тогда 
		Результат.Вставить("Function",	ФункцияДокумента);
		//Результат.Вставить("Version",	файлОбменаСсылка.ВерсияФормата);
	КонецЕсли;
	
	// в пакете с другими доками - свяжем в ДД все титулы вместе
	
	Если ЗначениеЗаполнено(файлОбменаСсылка.InitialDocumentDocumentId) Тогда 
		
		InitialDocumentId	= Ядро().АПИ_Новый_DocumentId(файлОбменаСсылка.InitialDocumentMessageID, файлОбменаСсылка.InitialDocumentDocumentId);
		Результат.InitialDocumentIds.Добавить(InitialDocumentId);
		
	Иначе
		
		Результат.InitialDocumentIds		= Ядро().КопияКоллекцииЗначений(Новый Массив);
		ФайлТ1 = Неопределено;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(файлОбменаСсылка.ТипДокумента) Тогда
			
			Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(файлОбменаСсылка.ТипДокумента)
				И файлОбменаСсылка.ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда 
			
				ФайлТ1 = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлТитулаПоГлавномуДокументу(файлОбменаСсылка.ГлавныйДокумент, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
				
			ИначеЕсли файлОбменаСсылка.ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда 
			
				ФайлТ1 = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлТитулаПоГлавномуДокументу(файлОбменаСсылка.ГлавныйДокумент, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
				
			КонецЕсли
			
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(файлОбменаСсылка.ТипДокумента)
			И файлОбменаСсылка.ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			И файлОбменаСсылка.ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда // Т3 - при попытке сослаться на Т1 ГП не сможет это сделать
			
			ФайлТ1 = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлТитулаПоГлавномуДокументу(файлОбменаСсылка.ГлавныйДокумент, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФайлТ1) 
			И (файлОбменаСсылка.Отправитель = ФайлТ1.Отправитель Или файлОбменаСсылка.Отправитель = ФайлТ1.Получатель) Тогда 
			// можно подкладывать в пакет с Т1 только если Т1 есть у отправителя этого титула
			InitialDocumentId	= Ядро().АПИ_Новый_DocumentId(ФайлТ1.MessageID, ФайлТ1.DocumentId);
			Результат.InitialDocumentIds.Добавить(InitialDocumentId);
			
		КонецЕсли;
		
	КонецЕсли;

	Результат.SubordinateDocumentIds	= Ядро().КопияКоллекцииЗначений(Новый Массив); // заглушка
	
	// заглушка
	//Если ДокументЗашифрован ИЛИ НЕ Формализованный Тогда
	//	
	//	МетаданныеДокумента = ПолучитьМетаданныеДокументаДляОтправки(ОписаниеТипаДокументаAPI, Документ, ДокументЗашифрован);
	//	
	//	Если ЗначениеЗаполнено(МетаданныеДокумента) Тогда
	//		Результат.Вставить("Metadata", МетаданныеДокумента);
	//	КонецЕсли;
	//	
	//КонецЕсли;
	
	// заглушка
	//Ядро().ЗаполнитьТегиДокумента(Результат, Документ);
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьPowerOfAttorneyToPost(Знач файлОбменаСсылка)
	
	Перем PowerOfAttorneyToPost, КонтрактМЧД;
	
	PowerOfAttorneyToPost = Неопределено;
	СпособПередачиМЧД = файлОбменаСсылка.СпособПередачиМЧД;
	
	Если СпособПередачиМЧД = Перечисления.КонтурЛогистика_СпособыПередачиМЧД.Мета Тогда
	
		Если ЗначениеЗаполнено(файлОбменаСсылка.ИдентификаторМЧД) Тогда
			
			КонтрактМЧД = ПодготовитьFullIdДляPowerOfAttorneyToPost(файлОбменаСсылка);
			
			PowerOfAttorneyToPost = Ядро().АПИ_Новый_PowerOfAttorneyToPost(КонтрактМЧД);
			
		КонецЕсли;
		
	ИначеЕсли СпособПередачиМЧД = Перечисления.КонтурЛогистика_СпособыПередачиМЧД.Файл Тогда
		
		КонтрактМЧД = ПодготовитьContentДляPowerOfAttorneyToPost(файлОбменаСсылка);
		
		PowerOfAttorneyToPost = Ядро().АПИ_Новый_PowerOfAttorneyToPost(КонтрактМЧД);
		
	ИначеЕсли СпособПередачиМЧД = Перечисления.КонтурЛогистика_СпособыПередачиМЧД.ФайлМета Тогда
		
		КонтрактМЧД = ПодготовитьContentДляPowerOfAttorneyToPost(файлОбменаСсылка);
		Если Не ЗначениеЗаполнено(КонтрактМЧД) Тогда
			КонтрактМЧД = ПодготовитьFullIdДляPowerOfAttorneyToPost(файлОбменаСсылка);
		КонецЕсли;
		
		PowerOfAttorneyToPost = Ядро().АПИ_Новый_PowerOfAttorneyToPost(КонтрактМЧД);
		
	КонецЕсли;
	
	Возврат PowerOfAttorneyToPost;
	
КонецФункции

Функция ПодготовитьFullIdДляPowerOfAttorneyToPost(файлОбменаСсылка)
	
	МЧД = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", файлОбменаСсылка.ИдентификаторМЧД);
	Если Не МЧД.Пустая() Тогда
		ИННДоверителя = МЧД.ОрганизацияДиадок.ИНН;
	Иначе
		ИННДоверителя = файлОбменаСсылка.Отправитель.ИНН;
	КонецЕсли;
	
	КонтрактМЧД = Новый Структура();
	КонтрактМЧД.Вставить("Идентификатор", файлОбменаСсылка.ИдентификаторМЧД);
	КонтрактМЧД.Вставить("ИНН", ИННДоверителя);
	КонтрактМЧД.Вставить("ДоставкаФайлом", файлОбменаСсылка.ДоставкаМЧДФайлом);
	
	Сертификат = Неопределено;
	Если ЗначениеЗаполнено(файлОбменаСсылка.Отпечаток) Тогда
		Сертификат = Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.НайтиПоРеквизиту("ОтпечатокСертификата", файлОбменаСсылка.Отпечаток);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		КонтрактМЧД.Вставить("ИННПредставителя", Сертификат.ИНН);
	ИначеЕсли Не МЧД.Пустая() И МЧД.Представители.Количество() > 0 Тогда
		КонтрактМЧД.Вставить("ИННПредставителя", МЧД.Представители[0].ИНН);	
	КонецЕсли;
	
	Возврат КонтрактМЧД;
	
КонецФункции

Функция ПодготовитьContentДляPowerOfAttorneyToPost(файлОбменаСсылка)
	
	КонтрактМЧД = Неопределено;
	
	МЧД = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", файлОбменаСсылка.ИдентификаторМЧД);
	Если Не МЧД.Пустая() Тогда
		
		XMLфайлМЧД = МЧД.XMLфайлМЧД.Получить();
		ЭлПодпись = МЧД.ЭлектроннаяПодпись.Получить();
						
		Если ЗначениеЗаполнено(XMLфайлМЧД) И ЗначениеЗаполнено(ЭлПодпись) Тогда
		
			Данные			 = ?(ТипЗнч(XMLфайлМЧД) = Тип("ДвоичныеДанные"), Base64Строка(XMLфайлМЧД), XMLфайлМЧД);
			ДанныеПодписи	 = ?(ТипЗнч(ЭлПодпись) = Тип("ДвоичныеДанные"), Base64Строка(ЭлПодпись), ЭлПодпись);
			
			КонтрактМЧД = Новый Структура();
			КонтрактМЧД.Вставить("Контент", Данные);
			КонтрактМЧД.Вставить("Подпись", ДанныеПодписи);
			КонтрактМЧД.Вставить("ДоставкаФайлом", файлОбменаСсылка.ДоставкаМЧДФайлом);
						
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КонтрактМЧД;
	
КонецФункции

Функция ПодготовитьPowerOfAttorneyToRegister(Знач МЧД)
	
	ДанныеДоверенностиДляРегистрации = Новый Структура;
	
	XMLфайлМЧД = МЧД.XMLфайлМЧД.Получить();
	ЭлПодпись = МЧД.ЭлектроннаяПодпись.Получить();
	
	Если ЗначениеЗаполнено(XMLфайлМЧД) И ЗначениеЗаполнено(ЭлПодпись) Тогда	
		
		Данные			 = ?(ТипЗнч(XMLфайлМЧД) = Тип("ДвоичныеДанные"), Base64Строка(XMLфайлМЧД), XMLфайлМЧД);
		ДанныеПодписи	 = ?(ТипЗнч(ЭлПодпись) = Тип("ДвоичныеДанные"), Base64Строка(ЭлПодпись), ЭлПодпись);
		
		ДанныеДоверенностиДляРегистрации.Вставить("Контент", Данные);
		ДанныеДоверенностиДляРегистрации.Вставить("Подпись", ДанныеПодписи);		
		
	Иначе
		
		ДанныеДоверенностиДляРегистрации.Вставить("Идентификатор", МЧД.ИдентификаторДоверенности);
		ДанныеДоверенностиДляРегистрации.Вставить("ИННДоверителя", МЧД.Доверитель_ИНН);
		
		Если МЧД.Представители.Количество() > 0 Тогда
			ДанныеДоверенностиДляРегистрации.Вставить("ИННПредставителя", МЧД.Представители[0].ИНН);		
		Конецесли
		
	КонецЕсли;
		
	PowerOfAttorneyToRegister = Ядро().АПИ_PowerOfAttorneyToRegister(ДанныеДоверенностиДляРегистрации);
	
	Возврат PowerOfAttorneyToRegister;		
	
КонецФункции

Функция ПодготовитьPowerOfAttorneyPrevalidateRequest(Сертификат, МЧД)
	
	ДанныеДляПроверкиДоверенности = Новый Структура;
	ДанныеДляПроверкиДоверенности.Вставить("ОтпечатокСертификата", Сертификат.ОтпечатокСертификата);
	ДанныеДляПроверкиДоверенности.Вставить("ДвоичныеДанныеСертификата", Base64Строка(Сертификат.ДанныеСертификата.Получить()));
	ДанныеДляПроверкиДоверенности.Вставить("ИдентификаторДоверенности", МЧД.ИдентификаторДоверенности);
	ДанныеДляПроверкиДоверенности.Вставить("ИННДоверителя", МЧД.Доверитель_ИНН);
	
	Если ЗначениеЗаполнено(Сертификат.ИНН) Тогда
		ДанныеДляПроверкиДоверенности.Вставить("ИННПредставителя", Сертификат.ИНН);
	ИначеЕсли МЧД.Представители.Количество() > 0 Тогда
		ДанныеДляПроверкиДоверенности.Вставить("ИННПредставителя", МЧД.Представители[0].ИНН);	
	КонецЕсли;
	
	PowerOfAttorneyPrevalidateRequest = Ядро().АПИ_PowerOfAttorneyPrevalidateRequest(ДанныеДляПроверкиДоверенности);
	
	Возврат PowerOfAttorneyPrevalidateRequest;
	
КонецФункции

