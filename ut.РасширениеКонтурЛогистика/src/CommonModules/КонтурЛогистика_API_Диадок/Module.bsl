	Попытка
		
		РезультатОтправки = Ядро().АПИ_PostMessage(ПараметрыСервиса, MessageToPost, OperationId);
		
		Если РезультатОтправки.Свойство("КодОтветаДопустимый") И РезультатОтправки.КодОтветаДопустимый Тогда
			Результат.Успешно = Истина;
		Иначе
