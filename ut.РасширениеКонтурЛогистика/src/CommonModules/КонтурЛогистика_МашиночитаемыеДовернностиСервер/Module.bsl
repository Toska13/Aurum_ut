Функция МЧДВалидна(СтатусПроверки) Экспорт
	
	Возврат ?(СтатусПроверки = "IsValid", Истина, Ложь);	
	
КонецФункции

Функция МассивОшибокВСтроку(МассивОшибок) Экспорт
	
	МассивОшибокИзСтрок = Новый Массив;
	
	Для каждого Ошибка Из МассивОшибок Цикл		
		МассивОшибокИзСтрок.Добавить(СокрЛП(Ошибка.Code) + "$" + ?(Ошибка.Свойство("Text"), СокрЛП(Ошибка.Text), ""));
	КонецЦикла;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МассивОшибокИзСтрок, "#");
	
КонецФункции

Функция ПредставлениеОшибокПроверкиМЧД(СтрокаОшибок) Экспорт
	
	Ошибки = "";
	
	МассивСтрок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(СтрокаОшибок, "#", Ложь);
	Для каждого Стр Из МассивСтрок Цикл
		
		МассивСтрок2 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Стр, "$");
		КодОшибки = МассивСтрок2[0];
		ОписаниеОшибки = МассивСтрок2[1];
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			Ошибки = Ошибки + ОписаниеОшибки + Символы.ПС;
		Иначе
			
			ОшибкиБезОписания = ОшибкиБезОписания();
			Ошибки = Ошибки + ?(ОшибкиБезОписания.Свойство(КодОшибки), ОшибкиБезОписания[КодОшибки] + Символы.ПС, КодОшибки + Символы.ПС);
						
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

Функция ОшибкиБезОписания()
	
	ОшибкиБезОписания = Новый Структура;
	ОшибкиБезОписания.Вставить("СonflictDifferentContent", "Файл доверенности не совпадает с файлом в реестре ФНС");
	ОшибкиБезОписания.Вставить("ConflictDifferentSignature", "Файл подписи под МЧД не совпадает с файлом в реестре ФНС");
	ОшибкиБезОписания.Вставить("ConflictSameContentAndSameSignature", "Lоверенность существует, контент и подпись совпадают");
	
	Возврат ОшибкиБезОписания
	
КонецФункции

Функция тзОшибокПроверкиМЧД(СтрокаОшибок) Экспорт
	
	тзОшибки = Новый ТаблицаЗначений;
	тзОшибки.Колонки.Добавить("Код");
	тзОшибки.Колонки.Добавить("Описание");
	
	Если Не ЗначениеЗаполнено(СтрокаОшибок) Тогда
		Возврат тзОшибки;
	КонецЕсли;
	
	МассивСтрок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(СтрокаОшибок, "#");
	Для каждого Стр Из МассивСтрок Цикл
		МассивСтрок2 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Стр, "$");
		
		НоваяСтрока = тзОшибки.Добавить();
		НоваяСтрока.Код = МассивСтрок2[0];
		НоваяСтрока.Описание = МассивСтрок2[1];
	КонецЦикла;
	
	Возврат тзОшибки;
	
КонецФункции

Процедура ДобавитьДоверенныеСертификаты(МЧДСсылка, ОтпечатокСертификата, КомуВыданСертификат, ОшибкиМЧД, ДоверятьПолномочиям = Ложь, Полномочие = Неопределено) Экспорт
	
	МЧД = МЧДСсылка.ПолучитьОбъект();
	
	Если ДоверятьПолномочиям Тогда
		
		НоваяСтрока = МЧД.ДоверенныеСертификаты.Добавить();
		НоваяСтрока.КодОшибки = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД();
		НоваяСтрока.Отпечаток = ОтпечатокСертификата;
		НоваяСтрока.КомуВыдан = КомуВыданСертификат;
		НоваяСтрока.Полномочие = Полномочие;
		
	Иначе
		
		тз = МЧД.ДоверенныеСертификаты.ВыгрузитьКолонки();
		Для каждого Стр Из МЧД.ДоверенныеСертификаты Цикл
			Если Стр.Отпечаток <> ОтпечатокСертификата Тогда
				НоваяСтрока = тз.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЕсли;
		КонецЦикла;
		МЧД.ДоверенныеСертификаты.Загрузить(тз);
		
		тзОшибок = КонтурЛогистика_МашиночитаемыеДовернностиСервер.тзОшибокПроверкиМЧД(ОшибкиМЧД);
		Для каждого Ошибка Из тзОшибок Цикл
			
			НоваяСтрока = МЧД.ДоверенныеСертификаты.Добавить();
			НоваяСтрока.КодОшибки = Ошибка.Код;
			НоваяСтрока.Отпечаток = ОтпечатокСертификата;
			НоваяСтрока.КомуВыдан = КомуВыданСертификат;
			
			Если Ошибка.Код = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД() Тогда
				НоваяСтрока.Полномочие = Полномочие;	
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	МЧД.Записать();
	 	
КонецПроцедуры

Функция ПроверитьДоверие(МЧДСсылка, ОтпечатокСертификата, тзОшибки, ПроверитьПолномочия = Ложь, Полномочие = Неопределено) Экспорт
	
	Если ПроверитьПолномочия Тогда
		
		КодОшибкиПолномочияМЧД = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД();
		
		Отбор = Новый Структура("КодОшибки, Отпечаток, Полномочие", КодОшибкиПолномочияМЧД, ОтпечатокСертификата, Полномочие);
		Если МЧДСсылка.ДоверенныеСертификаты.НайтиСтроки(Отбор).Количество() = 0 Тогда
			Возврат Ложь	
		КонецЕсли;		
		
	Иначе
	
		Для каждого Стр Из тзОшибки Цикл
			
			Если ТипЗнч(тзОшибки) = Тип("ТаблицаЗначений") Тогда
				Отбор = Новый Структура("КодОшибки, Отпечаток", Стр.Код, ОтпечатокСертификата);
			Иначе
				Отбор = Новый Структура("КодОшибки, Отпечаток", Стр.Code, ОтпечатокСертификата);
			КонецЕсли;
			
			Если МЧДСсылка.ДоверенныеСертификаты.НайтиСтроки(Отбор).Количество() = 0 Тогда
				Возврат Ложь	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьПолномочияМЧД(Титул, МЧД, Полномочие, ТипТитула, ОтпечатокСертификата) Экспорт 
	
	Возврат РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.ПроверитьПолномочияМЧД(Титул, МЧД, Полномочие, ТипТитула, ОтпечатокСертификата);
	
КонецФункции

#Область ПроверкаМЧД

Процедура ВыполнитьПроверкуМЧД() Экспорт
	
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД КАК МЧДСсылка,
		|	РАЗНОСТЬДАТ(КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДатаПроверки, &Период, ДЕНЬ) КАК ДнейПослеПроверкиМЧД,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДатаПроверки КАК ДатаПроверки,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок КАК ОрганизацияДиадок,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат КАК Сертификат,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Период КАК ДатаЗаписи,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С КАК Пользователь1С,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере КАК ЭтоСерверныйСертификат,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДопПараметр КАК ДопПараметр,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СтатусПроверки КАК СтатусПроверки
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних(
		|			&Период,
		|			МЧД.ДатаОкончания >= &Период
		|				И Сертификат.СрокДействия >= &Период) КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних
		|ГДЕ
		|	РАЗНОСТЬДАТ(КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДатаПроверки, &Период, ДЕНЬ) >= 25
		|ИТОГИ ПО
		|	ОрганизацияДиадок";
	
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДатаСеанса()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизацияДиадок = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизацияДиадок.Следующий() Цикл
		
		СообщенияТелеграм = Новый Массив;
		
		ВыборкаДетальныеЗаписи = ВыборкаОрганизацияДиадок.Выбрать();	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
			Попытка
				
				Данные = ВыборкаДетальныеЗаписи;
			
				НаборЗаписей = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Период.Установить(Данные.ДатаЗаписи);
				НаборЗаписей.Отбор.ОрганизацияДиадок.Установить(Данные.ОрганизацияДиадок);
				НаборЗаписей.Отбор.Пользователь1С.Установить(Данные.Пользователь1С);
				НаборЗаписей.Отбор.СертификатНаСервере.Установить(Данные.ЭтоСерверныйСертификат);
				НаборЗаписей.Отбор.ДопПараметр.Установить(Данные.ДопПараметр);
				НаборЗаписей.Прочитать();
				
				Если НаборЗаписей.Количество() Тогда
					Если Данные.ДатаПроверки <> НаборЗаписей[0].ДатаПроверки Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
							
				Результат = ПроверитьМЧД(Данные.ОрганизацияДиадок, Данные);
				
				Если Результат.Свойство("СтатусПроверки") И ЗначениеЗаполнено(Результат.СтатусПроверки) Тогда
				
					ПредставлениеОшибки = "Настройка подписания от " + Формат(Данные.ДатаЗаписи, "ДФ=dd.MM.yyyy") + " не прошла проверку:" + Символы.ПС 
						+ Символы.Таб + "Организация " + Строка(Данные.ОрганизацияДиадок) + Символы.ПС
						+ Символы.Таб + "Сертификат " + Строка(Данные.Сертификат) + Символы.ПС
						+ Символы.Таб + "МЧД " + Строка(Данные.МЧДСсылка);
						
					Если Не МЧДВалидна(Результат.СтатусПроверки) Тогда
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = ПредставлениеОшибки;
						Сообщение.Сообщить();
																							
						ОписаниеОшибки = "";
						Результат.Свойство("ТекстОшибки", ОписаниеОшибки);
						
						Если ИспользоватьОтправкуВТелеграм Тогда						
							НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
							НовоеСообщение.Тип = "text";							
							ТекстСообщения = ТекстСообщенияОшибкиМЧД(Данные, ОписаниеОшибки);																					
							НовоеСообщение.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(ТекстСообщения);
							СообщенияТелеграм.Добавить(НовоеСообщение);
						КонецЕсли;
						
						АдресЭлектроннойПочты = ВыборкаОрганизацияДиадок.ОрганизацияДиадок.АдресЭлектроннойПочтыУведомленияОшибокРоботов;							
						Если ИспользоватьОтправкуНаПочту И ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда							
							ТекстСообщения = ТекстСообщенияОшибкиМЧД(Данные, ОписаниеОшибки, Истина);
							ОтправитьОшибкуМЧДПоЭлектроннойПочте(АдресЭлектроннойПочты, ТекстСообщения, Данные);								
						КонецЕсли;
																		
					КонецЕсли;
					
				КонецЕсли;
						
			Исключение
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ОписаниеОшибки();
				Сообщение.Сообщить();
				
				ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
				ТекстОшибки = "Проверить МЧД
					|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
				
			КонецПопытки;	
			
		КонецЦикла;
		
		Телефон = ВыборкаОрганизацияДиадок.ОрганизацияДиадок.ТелефонУведомленияОшибокРоботов;
		Если СообщенияТелеграм.Количество() > 0 И ЗначениеЗаполнено(ВыборкаОрганизацияДиадок.ОрганизацияДиадок.ТелефонУведомленияОшибокРоботов) Тогда
			РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(Телефон, СообщенияТелеграм);
		КонецЕсли;
						
	КонецЦикла;
	
	КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьВФоне("КонтурЛогистика_ДлительныеОперацииСервер.ОтправитьОчередьВТелеграм");
	 		
КонецПроцедуры

Функция ПроверитьМЧД(ОрганизацияДиадок, Подписант) Экспорт
	
	Результат = Новый Структура;
		
	Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_PrevalidatePowerOfAttorney(ОрганизацияДиадок.ID, 
																			Подписант.МЧДСсылка, 
																			Подписант.Сертификат);		
																				
	Если Ответ.Свойство("PrevalidateStatus") Тогда
		
		ТекстСтатусаПроверки = "";
		СтатусПроверки = "";
		
		Если Ответ.PrevalidateStatus.Свойство("StatusText") Тогда
			ТекстСтатусаПроверки = Ответ.PrevalidateStatus.StatusText;	
		КонецЕсли;
		Если Ответ.PrevalidateStatus.Свойство("StatusNamedId") Тогда
			СтатусПроверки = Ответ.PrevalidateStatus.StatusNamedId;			
		КонецЕсли;
			
		Результат.Вставить("СтатусПроверки", СтатусПроверки);
		
		ОшибкиПроверки = ОшибкиПроверкиМЧД(Ответ);
		ПредставлениеОшибки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПредставлениеОшибокПроверкиМЧД(ОшибкиПроверки);
		Результат.Вставить("ТекстОшибки", ПредставлениеОшибки);
								
		НаборЗаписей = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Подписант.ДатаЗаписи);
		НаборЗаписей.Отбор.ОрганизацияДиадок.Установить(ОрганизацияДиадок);
		НаборЗаписей.Отбор.Пользователь1С.Установить(Подписант.Пользователь1С);
		НаборЗаписей.Отбор.СертификатНаСервере.Установить(Подписант.ЭтоСерверныйСертификат);
		НаборЗаписей.Отбор.ДопПараметр.Установить(Подписант.ДопПараметр);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() Тогда
			
			Запись = НаборЗаписей[0];						
			Запись.ТекстСтатусаПроверки = ТекстСтатусаПроверки;
			Запись.СтатусПроверки = СтатусПроверки;
			Запись.ДатаПроверки = ТекущаяДатаСеанса();
			Запись.ОшибкиПроверки = ОшибкиПроверки;
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОшибкиПроверкиМЧД(PowerOfAttorneyPrevalidateResult) Экспорт
	
	Если PowerOfAttorneyPrevalidateResult.PrevalidateStatus.StatusNamedId <> "IsValid"
		И PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Свойство("ValidationProtocol") Тогда   
		
		Ошибки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибкиИзПротоколаВалидации(PowerOfAttorneyPrevalidateResult.PrevalidateStatus.ValidationProtocol);
		
		Возврат КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(Ошибки);
				
	ИначеЕсли PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Свойство("OperationError") Тогда
		
		OperationError = PowerOfAttorneyPrevalidateResult.PrevalidateStatus.OperationError;
		
		Ошибки = Новый Массив();
		Ошибки.Добавить(Новый Структура("Code, Text", 
			OperationError.Code, 
			?(OperationError.Свойство("Text"), OperationError.Text, "")));
		Возврат КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(Ошибки);	
	
	ИначеЕсли PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Свойство("Errors") Тогда
		Если ЗначениеЗаполнено(PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Errors) И PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Errors.Количество() > 0 Тогда
			Возврат КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Errors);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ТекстСообщенияОшибкиМЧД(Данные, ОписаниеОшибки, ФорматHTML = Ложь)
	
	Строки = Новый Массив;
	Строки.Добавить("<b>" + "Настройка подписания от " + Формат(Данные.ДатаЗаписи, "ДФ=dd.MM.yyyy") + " не прошла проверку:" + "</b>");
	 	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Строки.Добавить(ОписаниеОшибки + ?(ФорматHTML, "<br/>", ""));
	Иначе
		Строки.Добавить(?(ФорматHTML, "<br/>", Символы.ПС));
	КонецЕсли;
	
	Строки.Добавить("<b>" + "Организация: "  + "</b>" + СокрЛП(Данные.ОрганизацияДиадок) 
		+ " ИНН " + Данные.ОрганизацияДиадок.ИНН
	+ ?(ЗначениеЗаполнено(Данные.ОрганизацияДиадок.КПП), " КПП " + Данные.ОрганизацияДиадок.КПП, ""));
	Строки.Добавить("<b>" + "Сертификат: "  + "</b>" + СокрЛП(Данные.Сертификат));
	Строки.Добавить("<b>" + "МЧД: " + "</b>" + СокрЛП(Данные.МЧДССылка));
	
	Если ФорматHTML Тогда
		ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, "<br/>");	
	Иначе
		ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

Процедура ОтправитьОшибкуМЧДПоЭлектроннойПочте(АдресЭлектроннойПочты, ТекстСообщения, Данные)
	
	Письмо = Новый ИнтернетПочтовоеСообщение;
	
	Тема = "Настройка подписания не прошла проверку";
	
	Если ЗначениеЗаполнено(Данные.Сертификат) Тогда
		ФИО = КонтурЛогистика_ОбщегоНазначенияСервер.ФамилияИнициалы(Данные.Сертификат.Фамилия + " " + Данные.Сертификат.Имя + " " + Данные.Сертификат.Отчество);
	ИначеЕсли ЗначениеЗаполнено(Данные.МЧДСсылка) Тогда
		ФИО = Справочники.КонтурЛогистика_МЧД.ПолучитьФИОПредставителей(Данные.МЧДСсылка);
	Иначе
		ФИО = "";		
	КонецЕсли;
	
	Если Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации().Количество() > 1 Тогда
		Организация	= Данные.ОрганизацияДиадок.Наименование ;
	Иначе
		Организация = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФИО) Или ЗначениеЗаполнено(Организация) Тогда
		Тема = Тема + " (" + ФИО + ?(ЗначениеЗаполнено(ФИО), ", " + Организация, Организация) + ")";
	КонецЕсли;
	
	Письмо.Тема = Тема;
	Письмо.Тексты.Добавить(ТекстСообщения, ТипТекстаПочтовогоСообщения.HTML);
	
	Получатели = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(АдресЭлектроннойПочты, ";", Ложь);
	Для Каждого Получатель Из Получатели Цикл
		Письмо.Получатели.Добавить(Получатель);
	КонецЦикла;
	
	КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
	
КонецПроцедуры

Функция ЕстьОшибкаВМассиве(МассивОшибок, КодОшибки)
	
	Для каждого Ошибка Из МассивОшибок Цикл
		
		Если Ошибка.Code = КодОшибки Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область ПротоколВалидации

Функция тзПротоколаВалидацииМЧД(СтрокаПротоколВалидации) Экспорт
	
	тзОшибки = Новый ТаблицаЗначений;
	тзОшибки.Колонки.Добавить("ИдентификаторПроверки");
	тзОшибки.Колонки.Добавить("СтатусПроверки");
	тзОшибки.Колонки.Добавить("КодОшибки");
	тзОшибки.Колонки.Добавить("ТекстОшибки");
	
	Если Не ЗначениеЗаполнено(СтрокаПротоколВалидации) Тогда
		Возврат тзОшибки;
	КонецЕсли;
	
	МассивСтрок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(СтрокаПротоколВалидации, "#");
	Для каждого Стр Из МассивСтрок Цикл
		МассивСтрок2 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(Стр, "$");
		
		НоваяСтрока = тзОшибки.Добавить();
		НоваяСтрока.ИдентификаторПроверки = МассивСтрок2[0];
		НоваяСтрока.СтатусПроверки = МассивСтрок2[1];
		НоваяСтрока.КодОшибки = МассивСтрок2[2];
		НоваяСтрока.ТекстОшибки = МассивСтрок2[3];
	КонецЦикла;
	
	Возврат тзОшибки;
	
КонецФункции

Функция ПротоколВалидацииВСтроку(CheckResults) Экспорт
	
	МассивОшибокИзСтрок = Новый Массив;
		
	Для каждого CheckResult Из CheckResults Цикл		
		
		Стр = СокрЛП(CheckResult.Name) + ?(CheckResult.Свойство("Status"), "$" + СокрЛП(CheckResult.Status), "$");
												
		Если CheckResult.Свойство("Error") Тогда			
			Стр = Стр + ?(CheckResult.Error.Свойство("Code"), "$" + СокрЛП(CheckResult.Error.Code), "$");
			Стр = Стр + ?(CheckResult.Error.Свойство("Text"), "$" + СокрЛП(CheckResult.Error.Text), "$");
		Иначе
			Стр = Стр + "$$";
		КонецЕсли;
									
		МассивОшибокИзСтрок.Добавить(Стр);
									
	КонецЦикла;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(МассивОшибокИзСтрок, "#");
	
КонецФункции

Функция МассивОшибкиИзПротоколаВалидации(ПротоколВалидации) Экспорт

	Ошибки = "";
	
	Если ПротоколВалидации.Свойство("CheckResults") Тогда
	
		Ошибки = Новый Массив();
		Для каждого Стр Из ПротоколВалидации.CheckResults Цикл
			
			Если Стр.Свойство("Status") И Стр.Status = "Ok" Тогда
				Продолжить;
			КонецЕсли;
					
			Если Стр.Свойство("Error") Тогда
				
				Если Не ЕстьОшибкаВМассиве(Ошибки, Стр.Error.Code) Тогда
					Ошибки.Добавить(Стр.Error);
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

Функция НаименованиеПроверкиПоИдентиифкатору(Идентификатор) Экспорт
	
	СписокПроверок = СписокПроверокВалидацииМЧД();
	
	Если СписокПроверок.Свойство(Идентификатор) Тогда
		Возврат СписокПроверок[Идентификатор];
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

