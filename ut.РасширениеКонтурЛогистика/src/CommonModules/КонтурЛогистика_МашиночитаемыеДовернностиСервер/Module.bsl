Процедура ЗаполнитьПредставителей003(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Представители = Новый Массив;
	ТипыПредставителей = Справочники.КонтурЛогистика_МЧД.ТипыПредставителей("003");
	
	МассивСвУпПредXDTO = КС.XDTO_ВычислитьМассивXDTO(XDTO);
	
	Для Каждого ПредставительXDTO Из МассивСвУпПредXDTO Цикл

		Если ПредставительXDTO.ТипПред = ТипыПредставителей.ЮридическоеЛицо Тогда

			СведОргXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "Пред.СведОрг");
			ЗаполнитьПредставителяЮрЛицо003(ПредставительXDTO, СведОргXDTO, Представители);
												
		ИначеЕсли ПредставительXDTO.ТипПред = ТипыПредставителей.ИндивидуальныйПредприниматель Тогда	

			СведФизЛXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "Пред.СведИП");
			ЗаполнитьПредставителяИП003(СведФизЛXDTO, Представители);
												
		ИначеЕсли ПредставительXDTO.ТипПред = ТипыПредставителей.ФизическоеЛицо Тогда	
			
			СведФизЛXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "Пред.СведФизЛ");
			ЗаполнитьПредставителяФизЛицо003(СведФизЛXDTO, Представители);
			
		ИначеЕсли ПредставительXDTO.ТипПред = ТипыПредставителей.ФилиалЮридическогоЛица Тогда	
			
			СведОргXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "Пред.СведФилиал");
			ЗаполнитьПредставителяЮрЛицо003(ПредставительXDTO, СведОргXDTO, Представители, Истина);
			
		ИначеЕсли ПредставительXDTO.ТипПред = ТипыПредставителей.ФилиалИностраннойОрганизации Тогда	
			
			СведОргXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "Пред.СведИО");
			ЗаполнитьПредставителяФилиалИнострЮрЛица003(СведОргXDTO, Представители);
									
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДоверенности.Представители = Представители;
	
КонецПроцедуры

Процедура ЗаполнитьПредставителяЮрЛицо003(ПредставительXDTO, ЮрЛицоXDTO, Представители, ЭтоФилиал = Ложь)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	НовыйПредставитель = Новый Структура;
	
	Если ЭтоФилиал Тогда
		НовыйПредставитель.Вставить("ТипПредставителя", "4");	
	Иначе
		НовыйПредставитель.Вставить("ТипПредставителя", "1");
	КонецЕсли;
	
	НовыйПредставитель.Вставить("ИдентификаторПредставителя", 	Новый УникальныйИдентификатор);
	НовыйПредставитель.Вставить("НаименованиеОрганизации", 		КС.XDTO_Вычислить(ЮрЛицоXDTO, "НаимОрг"));
	НовыйПредставитель.Вставить("ИНН", 							КС.XDTO_Вычислить(ЮрЛицоXDTO, "ИННЮЛ"));
	НовыйПредставитель.Вставить("КПП", 							КС.XDTO_Вычислить(ЮрЛицоXDTO, "КПП"));
	НовыйПредставитель.Вставить("ОГРН", 						КС.XDTO_Вычислить(ЮрЛицоXDTO, "ОГРН"));
	
	// физические лица - представители ЮЛ	
	СведФизЛXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "Пред.СведФизЛ");
	
	Если СведФизЛXDTO <> Неопределено Тогда
			
		ФЛПредставителиЮЛ = Новый Массив;
		
		МассивСведФизЛXDTO = КС.XDTO_ВычислитьМассивXDTO(СведФизЛXDTO);
		Для каждого ФизЛицоXDTO Из МассивСведФизЛXDTO Цикл
		    			
			НовыйФЛПредставительЮЛ = Новый Структура;
			НовыйФЛПредставительЮЛ.Вставить("ИдентификаторПредставителя", 	НовыйПредставитель.ИдентификаторПредставителя);
			НовыйФЛПредставительЮЛ.Вставить("Фамилия", 						КС.XDTO_Вычислить(ФизЛицоXDTO.СведФЛ.ФИО, "Фамилия"));
			НовыйФЛПредставительЮЛ.Вставить("Имя", 							КС.XDTO_Вычислить(ФизЛицоXDTO.СведФЛ.ФИО, "Имя"));
			НовыйФЛПредставительЮЛ.Вставить("Отчество", 					КС.XDTO_Вычислить(ФизЛицоXDTO.СведФЛ.ФИО, "Отчество"));
			НовыйФЛПредставительЮЛ.Вставить("ИНН", 							КС.XDTO_Вычислить(ФизЛицоXDTO, "ИННФЛ"));
			НовыйФЛПредставительЮЛ.Вставить("Представление", 				ПредставлениеФЛПредставительЮЛ(НовыйФЛПредставительЮЛ));
			
			ФЛПредставителиЮЛ.Добавить(НовыйФЛПредставительЮЛ);
						
		КонецЦикла;
		
		НовыйПредставитель.Вставить("ФЛПредставителиЮЛ", ФЛПредставителиЮЛ);
		
	КонецЕсли;
	
	Представители.Добавить(НовыйПредставитель);	
	
КонецПроцедуры

Функция ПредставлениеФЛПредставительЮЛ(ДанныеПредставителя)
	
	Возврат ДанныеПредставителя.Фамилия 
				+ ?(ДанныеПредставителя.Свойство("Имя") И ЗначениеЗаполнено(ДанныеПредставителя.Имя), " " + ДанныеПредставителя.Имя, "") 
				+ ?(ДанныеПредставителя.Свойство("Отчество") И ЗначениеЗаполнено(ДанныеПредставителя.Отчество), " " + ДанныеПредставителя.Отчество, "") 
				+ ?(ДанныеПредставителя.Свойство("ИНН") И ЗначениеЗаполнено(ДанныеПредставителя.ИНН), " ИНН " + ДанныеПредставителя.ИНН, "");
	
КонецФункции

