Процедура ЗаполнитьПолномочия002(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
				
	СвПолнXDTO = КС.XDTO_Вычислить(XDTO, "СвПолн");
	МассивСвПолнXDTO = КС.XDTO_ВычислитьМассивXDTO(СвПолнXDTO);
	
	Полномочия = Новый Массив;
	
	Для каждого ПолномочиеXDTO Из МассивСвПолнXDTO Цикл
		
		Если ЗначениеЗаполнено(КС.XDTO_Вычислить(ПолномочиеXDTO, "КодПолн")) Тогда
			
			НовоеПолномочие = Новый Структура;
			НовоеПолномочие.Вставить("Код", КС.XDTO_Вычислить(ПолномочиеXDTO, "КодПолн"));
			НовоеПолномочие.Вставить("Наименование", КС.XDTO_Вычислить(ПолномочиеXDTO, "СодержПолн"));
			Полномочия.Добавить(НовоеПолномочие);
			
		Иначе     
			
			ДанныеДоверенности.ТекстовоеПолномочие = КС.XDTO_Вычислить(ПолномочиеXDTO, "ТекстПолн");	
			
		КонецЕсли;
				
	КонецЦикла;
	
	ДанныеДоверенности.Полномочия = Полномочия;
	
КонецПроцедуры

Функция ПолучитьДанныеМЧДФормат003(XDTO)
	
	ДанныеДоверенности = СтруктураДанныхДоверенности();
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДоверXDTO = КС.XDTO_Вычислить(XDTO, "Документ.Довер");
	ПередовXDTO = КС.XDTO_Вычислить(XDTO, "Документ.Передов");
	
	Если ДоверXDTO <> Неопределено Тогда
		Возврат ПолучитьДанныеДовер003(ДоверXDTO, ДанныеДоверенности);		            
	Иначе
		Возврат ПолучитьДанныеПередов003(ПередовXDTO, ДанныеДоверенности);
	КонецЕсли;
			
КонецФункции

Функция ПолучитьДанныеДовер003(ДоверXDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвДовXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДов");
	ЗаполнитьОсновнымиДанными003(СвДовXDTO, ДанныеДоверенности);
	
	ДанныеДоверенности.Доверитель_Тип = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.ТипДоверит");
	
	Если ДанныеДоверенности.Доверитель_Тип = "1" Тогда // юр лицо
		
		СвРосОргXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.Доверит.РосОргДовер.СвРосОрг");
		ЗаполнитьДоверителяЮрЛицо003(СвРосОргXDTO, ДанныеДоверенности);
				
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "2" Тогда // ин юр лицо
		
		СвИнОргXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.Доверит.ИнОргДовер.СвИнОрг");
		ЗаполнитьДоверителяИнОрг003(СвИнОргXDTO, ДанныеДоверенности);	
		
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "3" Тогда // ИП
		
		ИПДоверXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.Доверит.ИПДовер");
		ЗаполнитьДоверителяИП003(ИПДоверXDTO, ДанныеДоверенности);
								
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "4" Тогда // ФЛ
		
		ФЛДоверXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.Доверит.ФЛДовер");
		ЗаполнитьДоверителяФизЛицо003(ФЛДоверXDTO, ДанныеДоверенности);
				
	КонецЕсли;
	
	СвУпПредXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвУпПред");
	ЗаполнитьПредставителей003(СвУпПредXDTO, ДанныеДоверенности);
	
	ЗаполнитьПолномочия003(ДоверXDTO, ДанныеДоверенности);
	
	Возврат ДанныеДоверенности;
			
КонецФункции

Функция ПолучитьДанныеПередов003(ПередовXDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДанныеДоверенности.ВыданаВПорядкеПередоверия = Истина;
	
	СвПереДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПереДовер");
	ЗаполнитьОсновнымиДанными003(СвПереДоверXDTO, ДанныеДоверенности);
	
	ДанныеДоверенности.ИдентификаторИсходнойДоверенности = КС.XDTO_Вычислить(ПередовXDTO, "СвПервДовер.НомДоверПерв");
	
	ПрНалПередов = КС.XDTO_Вычислить(ПередовXDTO, "ПрНалПередов");
	
	Если ПрНалПередов = "1" Тогда
		ДанныеДоверенности.ИдентификаторРодительскойДоверенности = КС.XDTO_Вычислить(ПередовXDTO, "СвПередов.НомДоверПерв");
	Иначе
		ДанныеДоверенности.ИдентификаторРодительскойДоверенности = ДанныеДоверенности.ИдентификаторИсходнойДоверенности;
	КонецЕсли;
	
	// исходный доверитель
	ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = КС.XDTO_Вычислить(ПередовXDTO, "СвПервДовер.СвДоверПерв.ТипДоверит");
	
	Если ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "1" Тогда // юр лицо
		
		СвРосОргXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПервДовер.СвДоверПерв.ДоверитПерв.РосОргДовер");
		ЗаполнитьДоверителяЮрЛицо003(СвРосОргXDTO, ДанныеДоверенности.ИсходныйДоверитель);
				
	ИначеЕсли ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "2" Тогда // ин юр лицо
		
		СвИнОргXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПервДовер.СвДоверПерв.ДоверитПерв.ИнОргДовер"); 
		ЗаполнитьДоверителяИнОрг003(СвИнОргXDTO, ДанныеДоверенности.ИсходныйДоверитель);	
		
	ИначеЕсли ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "3" Тогда // ИП
		
		ИПДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПервДовер.СвДоверПерв.ДоверитПерв.ИПДовер");
		ЗаполнитьДоверителяИП003(ИПДоверXDTO, ДанныеДоверенности.ИсходныйДоверитель);
								
	ИначеЕсли ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "4" Тогда
		
		ФЛДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПервДовер.СвДоверПерв.ДоверитПерв.ФЛДовер");
		ЗаполнитьДоверителяФизЛицо003(ФЛДоверXDTO, ДанныеДоверенности.ИсходныйДоверитель);
				
	КонецЕсли;
	
	// передоверитель
	ДанныеДоверенности.Доверитель_Тип = КС.XDTO_Вычислить(ПередовXDTO, "СвПередПолн.ТипПерПолн");
	
	Если ДанныеДоверенности.Доверитель_Тип = "1" Тогда // юр лицо
		
		СвРосОргXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПередПолн.ПередПолн.РосОргПерПолн.СвРосОрг");
		ЗаполнитьДоверителяЮрЛицо003(СвРосОргXDTO, ДанныеДоверенности);
			
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "2" Тогда // ИП
		
		ИПДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПередПолн.ПередПолн.ИППерПолн");
		ЗаполнитьДоверителяИП003(ИПДоверXDTO, ДанныеДоверенности);
								
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "3" Тогда // ФЛ
		
		ФЛДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПередПолн.ПередПолн.ФЛПерПолн");
		ЗаполнитьДоверителяФизЛицо003(ФЛДоверXDTO, ДанныеДоверенности);
		
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "4" Тогда // филиал юр лица
		
		СвРосОргXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПередПолн.ПередПолн.ФилПерПолн.СвФил");
		ЗаполнитьДоверителяЮрЛицо003(СвРосОргXDTO, ДанныеДоверенности);
		
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "5" Тогда // ин юр лицо
		
		СвИнОргXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПередПолн.ПередПолн.ИнПерПолн.СвИнОрг"); 
		ЗаполнитьДоверителяИнОрг003(СвИнОргXDTO, ДанныеДоверенности);
		
	КонецЕсли;
	
	СвПолучПолнXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвПолучПолн");
	ЗаполнитьПредставителей003(СвПолучПолнXDTO, ДанныеДоверенности);
	
	ЗаполнитьПолномочия003(ПередовXDTO, ДанныеДоверенности);
				
	Возврат ДанныеДоверенности;
	
КонецФункции

Процедура ЗаполнитьОсновнымиДанными003(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДанныеДоверенности.НомерДоверенности 				= КС.XDTO_Вычислить(XDTO, "ВнНомДовер");
	ДанныеДоверенности.ИдентификаторДоверенности 		= КС.XDTO_Вычислить(XDTO, "НомДовер");
	ДанныеДоверенности.ДатаВыдачи 						= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "ДатаВыдДовер"));
	ДанныеДоверенности.ДатаОкончания 					= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "СрокДейст"));
	ДанныеДоверенности.СистемаХранения 					= КС.XDTO_Вычислить(XDTO, "СведСист");
	ДанныеДоверенности.Формат 							= Перечисления.КонтурЛогистика_ФорматыМЧД.Формат003;
	
	ПризнакПередоверия = КС.XDTO_Вычислить(XDTO, "ПрПередов");
	Если ПризнакПередоверия = "1" Тогда
		ДанныеДоверенности.ВозможностьОформленияПередоверия	= Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.БезПраваПередоверия;
	ИначеЕсли ПризнакПередоверия = "2" Тогда
		ДанныеДоверенности.ВозможностьОформленияПередоверия	= Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.ОднократноеПередоверие;
	ИначеЕсли ПризнакПередоверия = "3" Тогда
		ДанныеДоверенности.ВозможностьОформленияПередоверия	= Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.СПравомПоследующегоПередоверия;
	КонецЕсли;
			
КонецПроцедуры

