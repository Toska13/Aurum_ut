Процедура ЗаполнитьПолномочия003(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвПолнXDTO = КС.XDTO_Вычислить(XDTO, "СвПолн");
	
	ДанныеДоверенности.УтратаПолномочийПриПередоверии = ?(КС.XDTO_Вычислить(СвПолнXDTO, "ПрУтрПолн") = "2", Истина, Ложь);
	ДанныеДоверенности.СовместноеОсуществлениеПолномочий = ?(КС.XDTO_Вычислить(СвПолнXDTO, "ПрСовмПолн") = "2", Истина, Ложь);
	
	Полномочия = Новый Массив;
	
	Если КС.XDTO_Вычислить(СвПолнXDTO, "ТипПолн") = "1" Тогда
		
		МашПолнXDTO = КС.XDTO_Вычислить(СвПолнXDTO, "МашПолн");
		МассивМашПолнXDTO = КС.XDTO_ВычислитьМассивXDTO(МашПолнXDTO);
		
		Для каждого ПолномочиеXDTO Из МассивМашПолнXDTO Цикл
					
			НовоеПолномочие = Новый Структура;
			НовоеПолномочие.Вставить("Код", КС.XDTO_Вычислить(ПолномочиеXDTO, "КодПолн"));
			НовоеПолномочие.Вставить("Мнемоника", КС.XDTO_Вычислить(ПолномочиеXDTO, "МнПолн"));
			НовоеПолномочие.Вставить("Наименование", КС.XDTO_Вычислить(ПолномочиеXDTO, "НаимПолн"));
						
			ОгрСвПолнXDTO = КС.XDTO_Вычислить(ПолномочиеXDTO, "ОгрСвПолн");
			МассивОгрСвПолнXDTO = КС.XDTO_ВычислитьМассивXDTO(ОгрСвПолнXDTO);
			
			Если МассивОгрСвПолнXDTO.Количество() > 0 Тогда
			
				Ограничения = Новый Массив;
				
				ИдентификаторПолномочия = Новый УникальныйИдентификатор;
				НовоеПолномочие.Вставить("ИдентификаторПолномочия", ИдентификаторПолномочия);
				НовоеПолномочие.Вставить("КоличествоОграничений", МассивОгрСвПолнXDTO.Количество());
				
				Для каждого ОграничениеXDTO Из МассивОгрСвПолнXDTO Цикл
					
					НовоеОграничение = Новый Структура;
					НовоеОграничение.Вставить("Код", КС.XDTO_Вычислить(ОграничениеXDTO, "КодОгр"));
					НовоеОграничение.Вставить("Наименование", КС.XDTO_Вычислить(ОграничениеXDTO, "НаимОгр"));
					НовоеОграничение.Вставить("НаименованиеЗначения", КС.XDTO_Вычислить(ОграничениеXDTO, "НаимЗначОгр"));
					НовоеОграничение.Вставить("ИдентификаторПолномочия", ИдентификаторПолномочия);
					
					КодЗначОгр = КС.XDTO_Вычислить(ОграничениеXDTO, "КодЗначОгр");
					НовоеОграничение.Вставить("КодЗначения", КодЗначОгр);
					
					ТексЗначОгр = КС.XDTO_Вычислить(ОграничениеXDTO, "ТексЗначОгр");
					НовоеОграничение.Вставить("ТекстовоеЗначение", ТексЗначОгр);
					
					Ограничения.Добавить(НовоеОграничение);	
					
				КонецЦикла;
				
				НовоеПолномочие.Вставить("Ограничения", Ограничения);
								
			КонецЕсли;
			
			Полномочия.Добавить(НовоеПолномочие);
			
		КонецЦикла;
		
	Иначе
		
		ДанныеДоверенности.ТекстовоеПолномочие = КС.XDTO_Вычислить(СвПолнXDTO, "ТекстПолн");	
		
	КонецЕсли;
	
	ДанныеДоверенности.Полномочия = Полномочия;
	
КонецПроцедуры

Функция ОпределитьВозможностьОформленияПередоверия(Признак)
	
	Если Признак = "1" Тогда
		Возврат Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.БезПраваПередоверия;
	ИначеЕсли Признак = "2" Тогда
		Возврат Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.БезПраваПередоверия;
	ИначеЕсли Признак = "3" Тогда
		Возврат Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.БезПраваПередоверия;
	Иначе
		Возврат Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.ПустаяСсылка();
	КонецЕсли
	
КонецФункции

