#Область ЗагрузкаМЧДИзФайла

Процедура ЗагрузитьМЧДИзАрхива(ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи, МЧД = Неопределено, ЗагруженнаяМЧД = Неопределено) Экспорт
	
	ЗагрузитьМЧДИзФайла(ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи, МЧД, Истина, ЗагруженнаяМЧД);
		
КонецПроцедуры

Процедура ЗагрузитьМЧДИзФайла(ДвоичныеДанныеДоверенности, ДвоичныеДанныеПодписи, МЧД = Неопределено, Наша = Ложь, ЗагруженнаяМЧД = Неопределено) Экспорт
	
	XDTO = ПолучитьXDTOМЧД(ДвоичныеДанныеДоверенности);
	
	Формат = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "ВерсФорм");
	
	Если Формат = "002" Тогда
		ДанныеДоверенности = ПолучитьДанныеМЧДФормат002(XDTO);
	ИначеЕсли Формат = "EMCHD_1" Тогда
		ДанныеДоверенности = ПолучитьДанныеМЧДФормат003(XDTO);		
	Иначе
		ВызватьИсключение "Неизвестный формат МЧД"; 	
	КонецЕсли;
	
	НайдДоверенность = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", ДанныеДоверенности.ИдентификаторДоверенности);
	
	Если НайдДоверенность.Пустая() Тогда
		
		Доверенность = Справочники.КонтурЛогистика_МЧД.СоздатьЭлемент();
		ОписаниеЗагрузки = "Загружена МЧД";
		
	Иначе
		
		Если НайдДоверенность.Наша И Не Наша Тогда  // если МЧД есть в справочнике, как наша, то входящую не загружаем
			Возврат;
		ИначеЕсли Не НайдДоверенность.Наша И Не Наша Тогда 
			Возврат;
		Иначе
			Доверенность = НайдДоверенность.ПолучитьОбъект();
			ОписаниеЗагрузки = "Обновлена МЧД";
		КонецЕсли;
				
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МЧД) Тогда // для заполнения из карточки МЧД
		Если МЧД.ИдентификаторДоверенности <> ДанныеДоверенности.ИдентификаторДоверенности Тогда
			Сообщить("В выбранном файле МЧД с другим идентификатором");
			Возврат;
		Иначе
			Доверенность = МЧД.ПолучитьОбъект();
		КонецЕсли;
	КонецЕсли;
		
	ЗаполнитьЗначенияСвойств(Доверенность, ДанныеДоверенности);
	Доверенность.XMLфайлМЧД = Новый ХранилищеЗначения(ДвоичныеДанныеДоверенности);
	Доверенность.ЭлектроннаяПодпись = Новый ХранилищеЗначения(ДвоичныеДанныеПодписи);
	Доверенность.Загружена = "2";
	Доверенность.Наша = Наша;
	Доверенность.ПроверятьПолномочия = Истина;
	
	ЗаполнитьОрганизациюДиадок(Доверенность, ДанныеДоверенности);
	
	Если ДанныеДоверенности.ВыданаВПорядкеПередоверия Тогда
		ЗаполнитьОрганизациюДиадок(Доверенность, ДанныеДоверенности.ИсходныйДоверитель, Истина);	
	Иначе
		Доверенность.ИсходныйДоверитель = Доверенность.ОрганизацияДиадок;	
	КонецЕсли;
	
	ВсеПредставители = "";
	
	Доверенность.Представители.Очистить();
	Доверенность.ФизическиеЛицаПредставителиЮЛ.Очистить();
	Для каждого Представитель Из ДанныеДоверенности.Представители Цикл
		
		НовыйПредставитель = Доверенность.Представители.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйПредставитель, Представитель);
		
		Если Представитель.Свойство("ДатаРождения") И ЗначениеЗаполнено(Представитель.ДатаРождения) Тогда
			НовыйПредставитель.ДатаРождения = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ДатаИзСтроки(Представитель.ДатаРождения);
		КонецЕсли;
		
		Если Представитель.Свойство("ФЛПредставителиЮЛ") И ТипЗнч(Представитель.ФЛПредставителиЮЛ) = Тип("Массив") Тогда
			Для каждого ФЛПредставителиЮЛ Из Представитель.ФЛПредставителиЮЛ Цикл
				НовыйФЛПредставителиЮЛ = Доверенность.ФизическиеЛицаПредставителиЮЛ.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйФЛПредставителиЮЛ, ФЛПредставителиЮЛ);	
			КонецЦикла;			
		КонецЕсли;
		
		НовыйПредставитель.Представление = ПредставлениеПредставителяПолное(НовыйПредставитель);
		
		ВсеПредставители = ВсеПредставители + ПредставлениеПредставителя(НовыйПредставитель);
											
	КонецЦикла;
	
	Доверенность.ВсеПредставители = Лев(СокрЛП(ВсеПредставители), СтрДлина(СокрЛП(ВсеПредставители)) - 1);
	
	Доверенность.КоличествоПредставителей = Доверенность.Представители.Количество();
	Если Доверенность.КоличествоПредставителей = 1 Тогда
		
	ИначеЕсли Доверенность.КоличествоПредставителей = 2 Или Доверенность.КоличествоПредставителей = 3 Или Доверенность.КоличествоПредставителей = 4 Тогда
		Доверенность.ВсеПредставители = Строка(Доверенность.КоличествоПредставителей) + " представителя: " + Доверенность.ВсеПредставители;
	Иначе
		Доверенность.ВсеПредставители = Строка(Доверенность.КоличествоПредставителей) + " представителей: " + Доверенность.ВсеПредставители;
	КонецЕсли;
	
	Доверенность.Полномочия.Очистить();
	Доверенность.Ограничения.Очистить();
	Для каждого Полномочие Из ДанныеДоверенности.Полномочия Цикл
		
		НоваяСтрока = Доверенность.Полномочия.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Полномочие);
		
		Если Полномочие.Свойство("Ограничения") Тогда
			
			Для каждого Ограничение Из Полномочие.Ограничения Цикл
				
				НоваяСтрока = Доверенность.Ограничения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Ограничение);
				
			КонецЦикла;
			
		КонецЕсли;
											
	КонецЦикла;
			
	Доверенность.Наименование = Справочники.КонтурЛогистика_МЧД.НаименованиеМЧД(Доверенность);
		
	Доверенность.Записать();
	
	ЗагруженнаяМЧД = Доверенность.Ссылка;
			
КонецПроцедуры

Функция ПолучитьДанныеМЧДИзДвоичныхДанных(ДвоичныеДанныеДоверенности) Экспорт
					
	XDTO = ПолучитьXDTOМЧД(ДвоичныеДанныеДоверенности);
	
	Формат = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "ВерсФорм");
	
	Если Формат = "002" Тогда
		ДанныеДоверенности = ПолучитьДанныеМЧДФормат002(XDTO);
	ИначеЕсли Формат = "EMCHD_1" Тогда
		ДанныеДоверенности = ПолучитьДанныеМЧДФормат003(XDTO);		
	Иначе
		Возврат Неопределено; 	
	КонецЕсли;
	
	Возврат ДанныеДоверенности;
						
КонецФункции

Функция ПолучитьXDTOМЧД(ДвоичныеДанныеДоверенности)
	
	КодировкаXML = ПолучитьКодировкуФайла(ДвоичныеДанныеДоверенности);
	
	ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеДоверенности, КодировкаXML);
			
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);
	
	Если XDTO = Неопределено Тогда
		ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеДоверенности, "windows-1251");			
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);		
	КонецЕсли;
	
	Возврат XDTO;
	
КонецФункции

Функция ПолучитьКодировкуФайла(ДвоичныеДанныеДоверенности) Экспорт
	
	Кодировка = "";
	
	ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеДоверенности);
	
	Поз1 = Найти(ТекстXML, "encoding=""");
	Если Поз1 > 0 Тогда
	
		ТекстXML2 = Прав(ТекстXML, СтрДлина(ТекстXML) - Поз1 - СтрДлина("encoding=""") + 1);
		Поз2 = Найти(ТекстXML2, Символ(34));
		Если Поз2 > 0 Тогда			
			Кодировка = Лев(ТекстXML2, Поз2 - 1);			
		КонецЕСли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Кодировка) Тогда
		Кодировка = "utf-8";	
	КонецЕсли;
	
	Возврат Кодировка;
	
КонецФункции

Процедура ЗаполнитьОрганизациюДиадок(Довереннность, ДанныеДоверенности, ЭтоИсходныйДоверитель = Ложь)

	ОрганизацияДиадок = Неопределено;
	
	ОрганизацияДиадок = НайтиОрганизациюДоверителя(ДанныеДоверенности.Доверитель_ИНН); //Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИНН", ДанныеДоверенности.Доверитель_ИНН);
		
	Если ОрганизацияДиадок.Пустая() Тогда
					
		НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
		НоваяОрганизация.ИНН = ДанныеДоверенности.Доверитель_ИНН;
		
		Если ДанныеДоверенности.Доверитель_Тип = "1" Тогда
			НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
		ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "2" Тогда
			НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо;
		ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "3" Тогда
			
			НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП;
			
			НоваяОрганизация.Фамилия = ДанныеДоверенности.Доверитель_Фамилия;
			НоваяОрганизация.Имя = ДанныеДоверенности.Доверитель_Имя;
			НоваяОрганизация.Отчество = ДанныеДоверенности.Доверитель_Отчество;
			
			НоваяОрганизация.Наименование = "ИП " + ДанныеДоверенности.Доверитель_Фамилия + " " + ДанныеДоверенности.Доверитель_Имя + " " + ДанныеДоверенности.Доверитель_Отчество;
			
			Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_СНИЛС) Тогда			
				НоваяОрганизация.СНИЛС = ДанныеДоверенности.Доверитель_СНИЛС;
			КонецЕсли;
			
		ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "4" Тогда
			
			НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо;
			
			НоваяОрганизация.Фамилия = ДанныеДоверенности.Доверитель_Фамилия;
			НоваяОрганизация.Имя = ДанныеДоверенности.Доверитель_Имя;
			НоваяОрганизация.Отчество = ДанныеДоверенности.Доверитель_Отчество;
			
			НоваяОрганизация.Наименование = ДанныеДоверенности.Доверитель_Фамилия + " " + ДанныеДоверенности.Доверитель_Имя + " " + ДанныеДоверенности.Доверитель_Отчество;
			
			Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_СНИЛС) Тогда			
				НоваяОрганизация.СНИЛС = ДанныеДоверенности.Доверитель_СНИЛС;
			КонецЕсли;
						
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_Наименование) Тогда			
			НоваяОрганизация.Наименование = ДанныеДоверенности.Доверитель_Наименование;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_КПП) Тогда			
			НоваяОрганизация.КПП = ДанныеДоверенности.Доверитель_КПП;
		КонецЕсли;		
		Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_ОГРН) Тогда
			НоваяОрганизация.ОГРН = ДанныеДоверенности.Доверитель_ОГРН;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_Телефон) Тогда
			НоваяОрганизация.ТелефонОсновной = ДанныеДоверенности.Доверитель_Телефон;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_ОГРН) Тогда
			НоваяОрганизация.ОГРН = ДанныеДоверенности.Доверитель_ОГРН;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеДоверенности.Доверитель_Адрес) Тогда
			НоваяОрганизация.АдресПредставление = ДанныеДоверенности.Доверитель_Адрес;
			НоваяОрганизация.АдресСтрока = ДанныеДоверенности.Доверитель_Адрес;
		КонецЕсли;
		
		НоваяОрганизация.Записать();
				
		ОрганизацияДиадок = НоваяОрганизация.Ссылка;
				
		Попытка
			ДанныеДД = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization(ОрганизацияДиадок);
			Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеДД, ОрганизацияДиадок);				
		Исключение
			
		КонецПопытки;
		
		Если ЭтоИсходныйДоверитель Тогда
			Довереннность.ИсходныйДоверитель = ОрганизацияДиадок;	
		Иначе
			Довереннность.ОрганизацияДиадок = ОрганизацияДиадок;
		КонецЕсли;
		
	Иначе
		
		Если ЭтоИсходныйДоверитель Тогда
			Довереннность.ИсходныйДоверитель = ОрганизацияДиадок;
		Иначе
			Довереннность.ОрганизацияДиадок = ОрганизацияДиадок;
		КонецЕсли;
									
	КонецЕсли;	
		
КонецПроцедуры

Функция НайтиОрганизациюДоверителя(ИНН)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|ГДЕ
		|	КонтурЛогистика_ОрганизацииДиадок.ИНН = &ИНН
		|	И КонтурЛогистика_ОрганизацииДиадок.Наш
		|	И Не КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
			
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	Результат = ВыполнитьЗапросНайтиОрганизациюДоверителя(Запрос);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И КонтурЛогистика_ОрганизацииДиадок.Наш", "");
	Запрос.Текст = ТекстЗапроса;
	
	Результат = ВыполнитьЗапросНайтиОрганизациюДоверителя(Запрос);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
КонецФункции

Функция ВыполнитьЗапросНайтиОрганизациюДоверителя(Запрос)
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено
	
КонецФункции

Функция ПредставлениеПредставителя(Представитель)
	
	Если Представитель.ТипПредставителя = "1" Или Представитель.ТипПредставителя = "ЮЛ" Тогда
		
		Возврат Представитель.НаименованиеОрганизации + " "
			+ "ИНН " + Представитель.ИНН + ""
			+ ?(ЗначениеЗаполнено(Представитель.КПП), " КПП " + Представитель.КПП + "; ", "; ")
			
	ИначеЕсли Представитель.ТипПредставителя = "2" Или Представитель.ТипПредставителя = "ИП" Тогда
		
		Если ЗначениеЗаполнено(Представитель.НаименованиеОрганизации) Тогда
			Возврат "ИП " + Представитель.НаименованиеОрганизации + " "
				+ "ИНН " + Представитель.ИНН + "; "	
		Иначе
			Возврат "ИП " + Представитель.Фамилия + " "
				+ Представитель.Имя + " "
				+ Представитель.Отчество + " "
				+ "ИНН " + Представитель.ИНН + "; "
		КонецЕсли;
			
	ИначеЕсли Представитель.ТипПредставителя = "3" Или Представитель.ТипПредставителя = "ФЛ" Тогда
		
		Возврат Представитель.Фамилия + " "
			+ Представитель.Имя + " "
			+ Представитель.Отчество + " "
			+ "ИНН " + Представитель.ИНН + "; "
			
	ИначеЕсли Представитель.ТипПредставителя = "4" Или Представитель.ТипПредставителя = "5" Тогда
		
		Возврат "филиал " + Представитель.НаименованиеОрганизации + " "
			+ "ИНН " + Представитель.ИНН + ""
			+ ?(ЗначениеЗаполнено(Представитель.КПП), " КПП " + Представитель.КПП + "; ", "; ")
			
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьXMLфайлМЧД(Ссылка) Экспорт
	
	Если ТипЗнч(Ссылка.XMLфайлМЧД) = Тип("ХранилищеЗначения") Тогда
		Возврат Ссылка.XMLфайлМЧД.Получить();	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьДанныеМЧДФормат002(XDTO)
	
	ДанныеДоверенности = СтруктураДанныхДоверенности();
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДоверXDTO = КС.XDTO_Вычислить(XDTO, "Документ.Довер");
	ПередовXDTO = КС.XDTO_Вычислить(XDTO, "Документ.Передов");
	
	Если ДоверXDTO <> Неопределено Тогда
		Возврат ПолучитьДанныеДовер002(ДоверXDTO, ДанныеДоверенности);		            
	Иначе
		Возврат ПолучитьДанныеПередов002(ПередовXDTO, ДанныеДоверенности);
	КонецЕсли;
			
	Возврат ДанныеДоверенности;
	
КонецФункции

Функция ПолучитьДанныеДовер002(ДоверXDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвДовXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДов");
	ЗаполнитьОсновнымиДанными002(СвДовXDTO, ДанныеДоверенности);
	
	ДанныеДоверенности.Доверитель_Тип = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.ТипДовер");
	
	Если ДанныеДоверенности.Доверитель_Тип = "ЮЛ" Тогда // юр лицо
		
		СвРосОргXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.РосОргДовер.СвРосОрг");
		ЗаполнитьДоверителяЮрЛицо002(СвРосОргXDTO, ДанныеДоверенности);
				
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "ИО" Тогда // ин юр лицо
		
		СвИнОргXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.ИнОргДовер.СвИнОрг");
		ЗаполнитьДоверителяИнОрг002(СвИнОргXDTO, ДанныеДоверенности);
						
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "ИП" Тогда // ИП
		
		ИПДоверXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.ИПДовер");
		ЗаполнитьДоверителяИП002(ИПДоверXDTO, ДанныеДоверенности);
						
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "ФЛ" Тогда
		
		ФЛДоверXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвДоверит.ФЛДовер");
		ЗаполнитьДоверителяФизЛицо002(ФЛДоверXDTO, ДанныеДоверенности);
										
	КонецЕсли;
	
	СвУпПредXDTO = КС.XDTO_Вычислить(ДоверXDTO, "СвУпПред");
	ЗаполнитьПредставителей002(СвУпПредXDTO, ДанныеДоверенности);
		
	ЗаполнитьПолномочия002(ДоверXDTO, ДанныеДоверенности);
	
	Возврат ДанныеДоверенности;
	
КонецФункции

Функция ПолучитьДанныеПередов002(ПередовXDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДанныеДоверенности.ВыданаВПорядкеПередоверия = Истина;
	
	СвПереДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвПереДовер");
	ЗаполнитьОсновнымиДанными002(СвПереДоверXDTO, ДанныеДоверенности);
	
	ДанныеДоверенности.ИдентификаторИсходнойДоверенности = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвОснДовер.НомДовер0");
	
	ДанныеДоверенности.ИдентификаторРодительскойДоверенности = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.НомДоверN");
		
	// исходный доверитель
	ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвОснДовер.СвДовер0.ТипДовер");
	
	Если ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "ЮЛ" Тогда // юр лицо
		
		РосОргДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвОснДовер.СвДовер0.РосОргДовер");
		ЗаполнитьДоверителяЮрЛицо002(РосОргДоверXDTO, ДанныеДоверенности.ИсходныйДоверитель);
				
	ИначеЕсли ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "ИО" Тогда // ин юр лицо
		
		ИнОргДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвОснДовер.СвДовер0.ИнОргДовер");
		ЗаполнитьДоверителяИнОрг002(ИнОргДоверXDTO, ДанныеДоверенности.ИсходныйДоверитель);
						
	ИначеЕсли ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "ИП" Тогда // ИП
		
		ИПДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвОснДовер.СвДовер0.ИПДовер");
		ЗаполнитьДоверителяИП002(ИПДоверXDTO, ДанныеДоверенности.ИсходныйДоверитель);
						
	ИначеЕсли ДанныеДоверенности.ИсходныйДоверитель.Доверитель_Тип = "ФЛ" Тогда
		
		ФЛДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвДовПер.СвОснДовер.СвДовер0.ФЛДовер");
		ЗаполнитьДоверителяФизЛицо002(ФЛДоверXDTO, ДанныеДоверенности.ИсходныйДоверитель);
										
	КонецЕсли;
	
	// передоверитель
	ДанныеДоверенности.Доверитель_Тип = КС.XDTO_Вычислить(ПередовXDTO, "СвЛицПередПолн.ТипЛицПрдПолн");
	
	Если ДанныеДоверенности.Доверитель_Тип = "ЮЛ" Тогда // юр лицо
		
		СвРосОргXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвЛицПередПолн.РосОргПрдПолн");
		ЗаполнитьДоверителяЮрЛицо002(СвРосОргXDTO, ДанныеДоверенности);
				
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "ИП" Тогда // ИП  
		
		ИПДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвЛицПередПолн.ИППрдПолн");
		ЗаполнитьДоверителяИП002(ИПДоверXDTO, ДанныеДоверенности);
						
	ИначеЕсли ДанныеДоверенности.Доверитель_Тип = "ФЛ" Тогда // физ лицо
		
		ФЛДоверXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвЛицПередПолн.ФЛПрдПолн");
		ЗаполнитьДоверителяФизЛицо002(ФЛДоверXDTO, ДанныеДоверенности);
										
	КонецЕсли;	
			
	СвУпПредXDTO = КС.XDTO_Вычислить(ПередовXDTO, "СвЛицПолучПолн");
	ЗаполнитьПредставителей002(СвУпПредXDTO, ДанныеДоверенности);
	
	ЗаполнитьПолномочия002(ПередовXDTO, ДанныеДоверенности);
				
	Возврат ДанныеДоверенности;
	
КонецФункции

Процедура ЗаполнитьОсновнымиДанными002(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДанныеДоверенности.НомерДоверенности = КС.XDTO_Вычислить(XDTO, "ВнНомДовер");
	ДанныеДоверенности.ИдентификаторДоверенности = КС.XDTO_Вычислить(XDTO, "НомДовер");
	ДанныеДоверенности.ДатаВыдачи = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "ДатаВыдДовер"));
	ДанныеДоверенности.ДатаОкончания = КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "ДатаКонДовер"));
	ДанныеДоверенности.СистемаХранения = КС.XDTO_Вычислить(XDTO, "СведСистОтм");
	ДанныеДоверенности.УтратаПолномочийПриПередоверии = ?(КС.XDTO_Вычислить(XDTO, "СвДов.ПрУтрПолн") = "2", Истина, Ложь);
	ДанныеДоверенности.СовместноеОсуществлениеПолномочий = ?(КС.XDTO_Вычислить(XDTO, "СвДов.ПрСовмПолн") = "2", Истина, Ложь);
	ДанныеДоверенности.Формат = Перечисления.КонтурЛогистика_ФорматыМЧД.Формат002;
	
	ПризнакПередоверия = КС.XDTO_Вычислить(XDTO, "ПрПередов");
	Если ПризнакПередоверия = "1" Тогда
		ДанныеДоверенности.ВозможностьОформленияПередоверия	= Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.ОднократноеПередоверие;
	ИначеЕсли ПризнакПередоверия = "2" Тогда
		ДанныеДоверенности.ВозможностьОформленияПередоверия	= Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.БезПраваПередоверия;
	ИначеЕсли ПризнакПередоверия = "3" Тогда
		ДанныеДоверенности.ВозможностьОформленияПередоверия	= Перечисления.КонтурЛогистика_ВозможностиОформленияПередоверияМЧД.СПравомПоследующегоПередоверия;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДоверителяЮрЛицо002(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ДанныеДоверенности.Доверитель_Тип 			= "1";
	ДанныеДоверенности.Доверитель_ИНН 			= КС.XDTO_Вычислить(XDTO, "ИННЮЛ");
	ДанныеДоверенности.Доверитель_КПП 			= КС.XDTO_Вычислить(XDTO, "КПП");
	ДанныеДоверенности.Доверитель_Наименование 	= КС.XDTO_Вычислить(XDTO, "НаимОрг");
	ДанныеДоверенности.Доверитель_Телефон 		= КС.XDTO_Вычислить(XDTO, "Тлф");
	ДанныеДоверенности.Доверитель_ОГРН 			= КС.XDTO_Вычислить(XDTO, "ОГРН");
