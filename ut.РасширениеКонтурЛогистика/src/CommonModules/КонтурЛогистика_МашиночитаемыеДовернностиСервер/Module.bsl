#Область ЗагрузкаМЧДИзДиадок

Процедура ЗагрузитьМЧДДляТекущегоПользователя() Экспорт
	
	НашиОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	Для Каждого Орг Из НашиОрганизации Цикл
		
		Попытка
			ДанныеСотрудника = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetMyEmployee(Орг.ID);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если ДанныеСотрудника.Permissions.IsAdministrator Тогда
		
			Попытка
				Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganizationUsers(Орг);
			Исключение
				Продолжить;
			КонецПопытки;
			
			Если Ответ.Свойство("Users") Тогда
				
				Для Каждого User Из Ответ.Users Цикл
					
					ДанныеДляЗагрузки = Новый Структура;
					ДанныеДляЗагрузки.Вставить("BoxId", Орг.ID);
					ДанныеДляЗагрузки.Вставить("UserId", User.ID);
					
					ЗагрузитьМЧДИзДиадок(ДанныеДляЗагрузки);	
					
				КонецЦикла;		
				
			КонецЕсли;
			
		Иначе
			
			ДанныеДляЗагрузки = Новый Структура;
			ДанныеДляЗагрузки.Вставить("BoxId", Орг.ID);
			ДанныеДляЗагрузки.Вставить("UserId", Неопределено);
			
			ЗагрузитьМЧДИзДиадок(ДанныеДляЗагрузки);	
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьМЧДДляДругогоПользователя(Токен) Экспорт
	
	Ядро = КонтурЛогистика_API_Диадок.Ядро();
	
	ПараметрыСервиса = КонтурЛогистика_API_Диадок.ЛогистикаПараметрыСервиса_Диадок();
	ПараметрыСервиса.Вставить("Токен", Токен);
	
	Ответ = Ядро.АПИ_GetMyOrganizations(ПараметрыСервиса);	
			
	Для каждого Орг Из Ответ.Organizations Цикл
	
		Если Орг.Boxes.Количество() = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		boxId = Орг.Boxes[0].BoxIdGuid;
		
		ОрганизацияДД = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ID", boxId);
		Если ЗначениеЗаполнено(ОрганизацияДД) И Не ОрганизацияДД.Наш Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСотрудника = Ядро.АПИ_GetMyEmployee(ПараметрыСервиса, boxId);
		
		Если ТипЗнч(ДанныеСотрудника) = Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеСотрудника.Permissions.IsAdministrator Тогда
		
			Ответ = Ядро.АПИ_GetOrganizationUsers(ПараметрыСервиса, Орг.OrgId);
						
			Если Ответ.Свойство("Users") Тогда
				
				Для Каждого User Из Ответ.Users Цикл
					
					ДанныеДляЗагрузки = Новый Структура;
					ДанныеДляЗагрузки.Вставить("BoxId", boxId);
					ДанныеДляЗагрузки.Вставить("UserId", User.ID);
					ДанныеДляЗагрузки.Вставить("Токен", Токен);
					
					ЗагрузитьМЧДИзДиадок(ДанныеДляЗагрузки);	
					
				КонецЦикла;		
				
			КонецЕсли;
			
		Иначе
			
			ДанныеДляЗагрузки = Новый Структура;
			ДанныеДляЗагрузки.Вставить("BoxId", boxId);			
			ДанныеДляЗагрузки.Вставить("UserId", Неопределено);
			ДанныеДляЗагрузки.Вставить("Токен", Токен);
			
			ЗагрузитьМЧДИзДиадок(ДанныеДляЗагрузки);	
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьМЧДИзДиадок(ДанныеДляЗагрузки) Экспорт
	
	Попытка
		ВыполнитьЗагрузкуМЧДИзДиадок(ДанныеДляЗагрузки);
	Исключение
		
		Ошибка			= ИнформацияОбОшибке();
		ПодробнаяОшибка	= ПодробноеПредставлениеОшибки(Ошибка);
		
		Сообщить(ПодробнаяОшибка);
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗагрузитьМЧДИзДиадок", Ошибка,, ДанныеДляЗагрузки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьЗагрузкуМЧДИзДиадок(ДанныеДляЗагрузки)
	
	Если ДанныеДляЗагрузки.Свойство("Токен") Тогда
		
		Ядро = КонтурЛогистика_API_Диадок.Ядро();
	
		ПараметрыСервиса = Ядро.ПараметрыСервиса_Диадок();
		ПараметрыСервиса.Вставить("Токен", ДанныеДляЗагрузки.Токен);
		
		Ответ = Ядро.АПИ_GetEmployeePowersOfAttorney(ПараметрыСервиса, ДанныеДляЗагрузки.BoxId, ДанныеДляЗагрузки.UserId, "true");
		
	Иначе		
		
		Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetEmployeePowersOfAttorney(ДанныеДляЗагрузки.BoxId, ДанныеДляЗагрузки.UserId, "true");
		
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Ответ) И Не Ответ.Свойство("PowersOfAttorney") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из Ответ.PowersOfAttorney Цикл
		
		ЗагрузитьPowerOfAttorney(Стр.PowerOfAttorney, Истина);
				
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьPowerOfAttorney(PowerOfAttorney, Наша = Ложь) Экспорт
	
	ИдентификаторДоверенности = PowerOfAttorney.FullId.RegistrationNumber;
		
	НайдДоверенность = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", ИдентификаторДоверенности);
	
	Если НайдДоверенность.Пустая() Тогда
		
		Доверенность = Справочники.КонтурЛогистика_МЧД.СоздатьЭлемент();
		ОписаниеЗагрузки = "Загружена МЧД";
		
	Иначе
		
		Если НайдДоверенность.Наша И Наша Тогда  
			
			// если МЧД ранее загружена из файла, то такую МЧД не обновляем
			Если НайдДоверенность.Загружена = "1" Тогда
				Доверенность = НайдДоверенность.ПолучитьОбъект();
				ОписаниеЗагрузки = "Обновлена МЧД";
			Иначе
				Возврат;
			КонецЕсли;

		ИначеЕсли НайдДоверенность.Наша И Не Наша Тогда // если МЧД есть в справочнике, как наша, то входящую не загружаем
			Возврат;
		Иначе
			Доверенность = НайдДоверенность.ПолучитьОбъект();
			ОписаниеЗагрузки = "Обновлена МЧД";	
		КонецЕсли;
		
	КонецЕсли;
				
	ИННДоверителя = PowerOfAttorney.FullId.IssuerInn;
				
	Доверенность.ИдентификаторДоверенности = ИдентификаторДоверенности;
	Доверенность.Доверитель_ИНН = ИННДоверителя;
	Доверенность.Загружена = "1";
	Доверенность.Наша = Наша;
	Доверенность.ДатаВыдачи = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(PowerOfAttorney.StartAt.Ticks);
	Доверенность.ДатаОкончания = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().Ticks_2_Date(PowerOfAttorney.ExpireAt.Ticks);
	Доверенность.ПроверятьПолномочия = Истина;	
	
	Если PowerOfAttorney.Свойство("System") Тогда
		СистемаХранения = PowerOfAttorney.System;
		Доверенность.СистемаХранения = СистемаХранения;
	КонецЕсли;
	
	ОрганизацияДиадок = НайтиОрганизациюДоверителя(ИННДоверителя);
	Если ОрганизацияДиадок.Пустая() Тогда		
		Доверенность.ОрганизацияДиадок = СоздатьДоверителяИзPowerOfAttorney(PowerOfAttorney);		
	Иначе
		Доверенность.ОрганизацияДиадок = ОрганизацияДиадок;		
	КонецЕсли;
	
	Если PowerOfAttorney.Свойство("DelegationChain") Тогда
		
		Если PowerOfAttorney.DelegationChain.Количество() > 0 Тогда
			Доверенность.ВыданаВПорядкеПередоверия = Истина;
			
			ИННИсходногоДоверителя = PowerOfAttorney.DelegationChain[0].FullId.IssuerInn;
			
			ОрганизацияДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИНН", ИННИсходногоДоверителя);
			Если ОрганизацияДиадок.Пустая() Тогда		
				Доверенность.ИсходныйДоверитель = СоздатьДоверителяИзPowerOfAttorney(PowerOfAttorney.DelegationChain[0]);		
			Иначе
				Доверенность.ИсходныйДоверитель = ОрганизацияДиадок;		
			КонецЕсли;
				
		КонецЕсли;
				
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Доверенность.ИсходныйДоверитель) Тогда
		
		Доверенность.ИсходныйДоверитель = Доверенность.ОрганизацияДиадок;
		
	КонецЕсли;
	
	Если PowerOfAttorney.Свойство("DelegationInfo") Тогда
		
		Доверенность.ИдентификаторИсходнойДоверенности = PowerOfAttorney.DelegationInfo.RootRegistrationNumber;
		
		Если PowerOfAttorney.DelegationInfo.Свойство("ParentRegistrationNumber") Тогда
			Доверенность.ИдентификаторРодительскойДоверенности = PowerOfAttorney.DelegationInfo.ParentRegistrationNumber;	
		КонецЕсли;
	
	КонецЕсли;
	
	ЗаполнитьПредставителейИзPowerOfAttorney(Доверенность, PowerOfAttorney);
			
	ЗаполнитьПолномочияИзPowerOfAttorney(Доверенность, PowerOfAttorney);
	
	Доверенность.Наименование = Справочники.КонтурЛогистика_МЧД.НаименованиеМЧД(Доверенность);
	
	Если PowerOfAttorney.Свойство("IdFile") Тогда
		Доверенность.Формат = ФорматПоИмениФайла(PowerOfAttorney.IdFile);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Доверенность.ИдентификаторДоверенности) Тогда
		Доверенность.Записать();
	КонецЕсли;
	
	Если Наша Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеЗагрузки + " " + СокрЛП(Доверенность);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПредставителейИзPowerOfAttorney(Доверенность, PowerOfAttorney)
	
	Доверенность.Представители.Очистить();
	Доверенность.ФизическиеЛицаПредставителиЮЛ.Очистить();
	
	Если PowerOfAttorney.Свойство("Representatives") Тогда
		
		Для каждого Representative Из PowerOfAttorney.Representatives Цикл
			
			Если Representative.Свойство("Type") Тогда
				
				Представитель = Доверенность.Представители.Добавить();
				Представитель.ИдентификаторПредставителя = Новый УникальныйИдентификатор;
				
				Если Representative.Type = "UnknownRepresentativeType" Тогда
					Продолжить;
				ИначеЕсли Representative.Type = "RepresentativeLegalEntity" И Representative.Свойство("LegalEntity") Тогда
					
					ЗаполнитьПредставителяЮЛизДД(Представитель, Representative.LegalEntity, Доверенность);
										
				ИначеЕсли Representative.Type = "RepresentativeIndividualEntity" И Representative.Свойство("IndividualEntity") Тогда
					
					Представитель.ТипПредставителя = "2";
					
					Если Representative.IndividualEntity.Свойство("Inn") Тогда
						Представитель.ИНН = Representative.IndividualEntity.Inn;	
					КонецЕсли;
					
					Если Representative.IndividualEntity.Свойство("OrganizationName") Тогда
						Представитель.НаименованиеОрганизации = Representative.IndividualEntity.OrganizationName;
					КонецЕсли;
					
				ИначеЕсли Representative.Type = "RepresentativePhysicalEntity" И Representative.Свойство("PhysicalEntity") Тогда
					
					Представитель.ТипПредставителя = "3";
					
					Если Representative.PhysicalEntity.Свойство("Inn") Тогда
						Представитель.ИНН = Representative.PhysicalEntity.Inn;	
					КонецЕсли;
					
					Если Representative.PhysicalEntity.Свойство("PersonName") Тогда
						ЗаполнитьФИОПредставителя(Представитель, Representative.PhysicalEntity.PersonName);
					КонецЕсли;
					
				ИначеЕсли Representative.Type = "RepresentativeLegalSubsidiaryEntity" И Representative.Свойство("LegalSubsidiaryEntity") Тогда
					
					Представитель.ТипПредставителя = "4";
					
					ЗаполнитьПредставителяЮЛизДД(Представитель, Representative.LegalSubsidiaryEntity, Доверенность);
					
				ИначеЕсли Representative.Type = "RepresentativeForeignLegalSubsidiaryEntity" И Representative.Свойство("ForeignLegalSubsidiaryEntity") Тогда
					
					Представитель.ТипПредставителя = "5";
					
					Если Representative.ForeignLegalSubsidiaryEntity.Свойство("Inn") Тогда
						Представитель.ИНН = Representative.ForeignLegalSubsidiaryEntity.Inn;	
					КонецЕсли;
					
					Если Representative.ForeignLegalSubsidiaryEntity.Свойство("kpp") Тогда
						Представитель.КПП = Representative.ForeignLegalSubsidiaryEntity.kpp;	
					КонецЕсли;
					
					Если Representative.ForeignLegalSubsidiaryEntity.Свойство("OrganizationName") Тогда
						Представитель.НаименованиеОрганизации = Representative.ForeignLegalSubsidiaryEntity.OrganizationName;
					КонецЕсли;
					
				КонецЕсли;
				
				Представитель.Представление = ПредставлениеПредставителяПолное(Представитель);				
				
			КонецЕсли;
			
		КонецЦикла;
	
	ИначеЕсли PowerOfAttorney.Свойство("Confidant") И PowerOfAttorney.Confidant.Свойство("PersonName") Тогда
		
		Представитель = Доверенность.Представители.Добавить();
		
		Если PowerOfAttorney.Confidant.Свойство("Organization") Тогда
			
			Представитель.ТипПредставителя = "1";
			Представитель.НаименованиеОрганизации = PowerOfAttorney.Confidant.Organization.Name;
			Представитель.ИНН = PowerOfAttorney.Confidant.Organization.Inn;
			
		Иначе
			
			Представитель.ТипПредставителя = "3";
			Представитель.Фамилия = PowerOfAttorney.Confidant.PersonName.LastName;
			Представитель.Имя = PowerOfAttorney.Confidant.PersonName.FirstName;
			
			Если PowerOfAttorney.Confidant.PersonName.Свойство("MiddleName") Тогда
				Представитель.Отчество = PowerOfAttorney.Confidant.PersonName.MiddleName;
			КонецЕсли;	
		
			Представитель.ИНН = PowerOfAttorney.Confidant.Inn;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Доверенность.КоличествоПредставителей = Доверенность.Представители.Количество();
	Если Доверенность.КоличествоПредставителей = 1  Тогда
		Доверенность.ВсеПредставители = "";
	ИначеЕсли Доверенность.КоличествоПредставителей = 2 Или Доверенность.КоличествоПредставителей = 3 Или Доверенность.КоличествоПредставителей = 4 Тогда
		Доверенность.ВсеПредставители = Строка(Доверенность.КоличествоПредставителей) + " представителя: ";
	Иначе
		Доверенность.ВсеПредставители = Строка(Доверенность.КоличествоПредставителей) + " представителей: ";
	КонецЕсли;
	
	Для каждого Представитель Из Доверенность.Представители Цикл
		Доверенность.ВсеПредставители = Доверенность.ВсеПредставители + ПредставлениеПредставителя(Представитель);
	КонецЦикла;
	
	Доверенность.ВсеПредставители = Лев(СокрЛП(Доверенность.ВсеПредставители), СтрДлина(СокрЛП(Доверенность.ВсеПредставители)) - 1);
	
КонецПроцедуры

Процедура ЗаполнитьПредставителяЮЛизДД(Представитель, LegalEntity, Доверенность)
					
	Представитель.ТипПредставителя = "1";
			
	Если LegalEntity.Свойство("Inn") Тогда
		Представитель.ИНН = LegalEntity.Inn;	
	КонецЕсли;
	
	Если LegalEntity.Свойство("Kpp") Тогда
		Представитель.КПП = LegalEntity.Kpp;	
	КонецЕсли;
	
	Если LegalEntity.Свойство("OrganizationName") Тогда
		Представитель.НаименованиеОрганизации = LegalEntity.OrganizationName;
	КонецЕсли;
	
	Если LegalEntity.Свойство("PhysicalEntity") Тогда
		
		Для каждого PhysicalEntity Из LegalEntity.PhysicalEntity Цикл
			
			НовыйФЛПредставительЮЛ = Доверенность.ФизическиеЛицаПредставителиЮЛ.Добавить();
			НовыйФЛПредставительЮЛ.ИдентификаторПредставителя = Представитель.ИдентификаторПредставителя;
			
			Если PhysicalEntity.Свойство("Inn") Тогда
				НовыйФЛПредставительЮЛ.ИНН = PhysicalEntity.Inn;	
			КонецЕсли;
			
			Если PhysicalEntity.Свойство("PersonName") Тогда
				ЗаполнитьФИОПредставителя(НовыйФЛПредставительЮЛ, PhysicalEntity.PersonName);
			КонецЕсли;
			
			НовыйФЛПредставительЮЛ.Представление = ПредставлениеФЛПредставительЮЛ(НовыйФЛПредставительЮЛ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьФИОПредставителя(Представитель, FullName)

	Если FullName.Свойство("LastName") Тогда
		Представитель.Фамилия = FullName.LastName;
	КонецЕсли;
	Если FullName.Свойство("FirstName") Тогда
		Представитель.Имя = FullName.FirstName;
	КонецЕсли;
	Если FullName.Свойство("MiddleName ") Тогда
		Представитель.Отчество = FullName.MiddleName ;
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеПредставителяПолное(Представитель)
	
	Представление = "";
	
	Если Представитель.ТипПредставителя = "1" Тогда
		Представление =  Представитель.НаименованиеОрганизации		
						+ ?(ЗначениеЗаполнено(Представитель.ИНН), Символы.ПС + "ИНН: " + Представитель.ИНН, "")
						+ ?(ЗначениеЗаполнено(Представитель.КПП), " КПП: " + Представитель.КПП, " ")						
						+ ?(ЗначениеЗаполнено(Представитель.ОГРН), Символы.ПС + "ОГРН: " + Представитель.ОГРН, "");	
	ИначеЕсли Представитель.ТипПредставителя = "2" Тогда
		Если ЗначениеЗаполнено(Представитель.НаименованиеОрганизации) Тогда
			Представление = Представитель.НаименованиеОрганизации 
							+ ?(ЗначениеЗаполнено(Представитель.ИНН)," ИНН: " + Представитель.ИНН, "");
		Иначе
			Представление = "ИП " + Представитель.Фамилия + " " + Представитель.Имя + " " + Представитель.Отчество
							+ ?(ЗначениеЗаполнено(Представитель.ИНН), " ИНН: " + Представитель.ИНН, " ")
							+ ?(ЗначениеЗаполнено(Представитель.ОГРН), Символы.ПС + "ОГРН: " + Представитель.ОГРН, "")
							+ ?(ЗначениеЗаполнено(Представитель.ДатаРождения), Символы.ПС + "Дата рождения: " + Формат(Представитель.ДатаРождения, "ДФ=dd.MM.yyyy"), "");				
		КонецЕсли;					
	ИначеЕсли Представитель.ТипПредставителя = "3" Тогда
		Представление = ?(ЗначениеЗаполнено(Представитель.Фамилия), Представитель.Фамилия, "") 
						+ ?(ЗначениеЗаполнено(Представитель.Имя), " " + Представитель.Имя, "")
						+ ?(ЗначениеЗаполнено(Представитель.Отчество), " " + Представитель.Отчество, "")
						+ ?(ЗначениеЗаполнено(Представитель.ИНН), " ИНН: " + Представитель.ИНН, " ")
						+ ?(ЗначениеЗаполнено(Представитель.ДатаРождения), Символы.ПС + "Дата рождения: " + Формат(Представитель.ДатаРождения, "ДФ=dd.MM.yyyy"), "");
	ИначеЕсли Представитель.ТипПредставителя = "4" Или Представитель.ТипПредставителя = "5" Тогда
		Представление =  Представитель.НаименованиеОрганизации		
						+ ?(ЗначениеЗаполнено(Представитель.ИНН), Символы.ПС + "ИНН: " + Представитель.ИНН, "")
						+ ?(ЗначениеЗаполнено(Представитель.КПП), " КПП: " + Представитель.КПП, " ")
						+ ?(ЗначениеЗаполнено(Представитель.ОГРН), Символы.ПС + "ОГРН: " + Представитель.ОГРН, "");
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция СоздатьДоверителяИзPowerOfAttorney(PowerOfAttorney)
	
	НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
		
	Если PowerOfAttorney.Issuer.Свойство("Type") И PowerOfAttorney.Issuer.Type = "LegalEntity" Тогда
				
		НоваяОрганизация.ИНН = PowerOfAttorney.Issuer.LegalEntity.Inn;
		НоваяОрганизация.КПП = PowerOfAttorney.Issuer.LegalEntity.Kpp;
		НоваяОрганизация.Наименование = PowerOfAttorney.Issuer.LegalEntity.OrganizationName;
		НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
		
	ИначеЕсли PowerOfAttorney.Issuer.Свойство("Type") И PowerOfAttorney.Issuer.Type = "ForeignEntity" Тогда
		
		НоваяОрганизация.ИНН = PowerOfAttorney.Issuer.ForeignEntity.Inn;
		НоваяОрганизация.Наименование = PowerOfAttorney.Issuer.ForeignEntity.OrganizationName;
		НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо;
		
	ИначеЕсли PowerOfAttorney.Issuer.Свойство("Type") И PowerOfAttorney.Issuer.Type = "IndividualEntity" Тогда
		
		НоваяОрганизация.ИНН = PowerOfAttorney.Issuer.IndividualEntity.Inn;
		НоваяОрганизация.Наименование = PowerOfAttorney.Issuer.IndividualEntity.OrganizationName;
		НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП;
		
	ИначеЕсли PowerOfAttorney.Issuer.Свойство("Type") И PowerOfAttorney.Issuer.Type = "PhysicalEntity" Тогда
		
		НоваяОрганизация.ИНН = PowerOfAttorney.Issuer.PhysicalEntity.Inn;
		НоваяОрганизация.Наименование = PowerOfAttorney.Issuer.PhysicalEntity.PersonName;
		НоваяОрганизация.Фамилия = PowerOfAttorney.Issuer.PhysicalEntity.PersonName.LastName;
		НоваяОрганизация.Имя = PowerOfAttorney.Issuer.PhysicalEntity.PersonName.FirstName;
		
		Если PowerOfAttorney.Issuer.PhysicalEntity.PersonName.Свойство("MiddleName") Тогда
			НоваяОрганизация.Отчество = PowerOfAttorney.Issuer.PhysicalEntity.PersonName.MiddleName;
		КонецЕсли;
		
		НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо;
		
	КонецЕсли;
	
	НоваяОрганизация.Записать();
	
	ОрганизацияДиадок = НоваяОрганизация.Ссылка;
	
	Попытка
		ДанныеДД = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization(ОрганизацияДиадок);
		Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеДД, ОрганизацияДиадок);				
	Исключение
		
	КонецПопытки;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

Процедура ЗаполнитьПолномочияИзPowerOfAttorney(Доверенность, PowerOfAttorney)
	
	Доверенность.Полномочия.Очистить();
	
	Если PowerOfAttorney.Свойство("PermissionsInfo") И PowerOfAttorney.PermissionsInfo.Свойство("Permissions") Тогда
		
		Если PowerOfAttorney.PermissionsInfo.Свойство("TransferPermissionLoss") Тогда
			
			Доверенность.УтратаПолномочийПриПередоверии = ?(PowerOfAttorney.PermissionsInfo.TransferPermissionLoss = "lossOnTransfer", Истина, Ложь);
			
		КонецЕсли;
		
		Если PowerOfAttorney.PermissionsInfo.Свойство("JointPermissions") Тогда
			
			Доверенность.СовместноеОсуществлениеПолномочий = ?(PowerOfAttorney.PermissionsInfo.JointPermissions = "group", Истина, Ложь);
			
		КонецЕсли;
		
		Если PowerOfAttorney.PermissionsInfo.Свойство("Permissions") Тогда
		
			Для каждого Permission Из PowerOfAttorney.PermissionsInfo.Permissions Цикл
			
				Если Permission.Type = "text" Тогда
					
					Доверенность.ТекстовоеПолномочие = Permission.TextPermission;	
					
				ИначеЕсли Permission.Type = "machineReadable" Тогда
				
					Для каждого MachineReadablePermission Из Permission.MachineReadablePermission Цикл
						
						НовоеПолномочие = Доверенность.Полномочия.Добавить();
						НовоеПолномочие.Код = MachineReadablePermission.Code;
						НовоеПолномочие.Мнемоника = MachineReadablePermission.Mnemonic;
						НовоеПолномочие.Наименование = MachineReadablePermission.Name;
						
						Если MachineReadablePermission.Свойство("Restrictions") И MachineReadablePermission.Restrictions.Количество() > 0 Тогда
							
							НовоеПолномочие.ИдентификаторПолномочия = Новый УникальныйИдентификатор;
							НовоеПолномочие.КоличествоОграничений = MachineReadablePermission.Restrictions.Количество();
							
							Для каждого Restriction Из MachineReadablePermission.Restrictions Цикл
								
								НовоеОграничение = Доверенность.Ограничения.Добавить();
								НовоеОграничение.Код = Restriction.Code;
								НовоеОграничение.Наименование = Restriction.Name;
								НовоеОграничение.НаименованиеЗначения = Restriction.ValueName;
								НовоеОграничение.КодЗначения = Restriction.ValueCode;
								НовоеОграничение.ТекстовоеЗначение = Restriction.ValueText;
								НовоеОграничение.ИдентификаторПолномочия = НовоеПолномочие.ИдентификаторПолномочия;
																		
							КонецЦикла;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ФорматПоИмениФайла(ИмяФайла)
	
	Если Лев(ВРег(ИмяФайла), 8) = "ON_EMCHD" Или Лев(ВРег(ИмяФайла), 8) = "ON_DOVEL" Тогда
		Возврат Перечисления.КонтурЛогистика_ФорматыМЧД.Формат003;	
	ИначеЕсли Лев(ВРег(ИмяФайла), 8) = "ON_DOVBB" Тогда
		Возврат Перечисления.КонтурЛогистика_ФорматыМЧД.Формат002;
	Иначе
		Возврат Перечисления.КонтурЛогистика_ФорматыМЧД.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

