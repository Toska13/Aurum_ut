	ДанныеДоверенности.Доверитель_Телефон 	= КС.XDTO_Вычислить(XDTO, "СведФЛ.КонтактТлф");
	ДанныеДоверенности.Доверитель_Адрес 	= КС.XDTO_Вычислить(XDTO, "СведФЛ.АдрМЖ.АдрРФ");
		
КонецПроцедуры

Процедура ЗаполнитьПредставителей002(XDTO, ДанныеДоверенности)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Представители = Новый Массив;
	ТипыПредставителей = Справочники.КонтурЛогистика_МЧД.ТипыПредставителей("002");
	
	МассивСвУпПредXDTO = КС.XDTO_ВычислитьМассивXDTO(XDTO);
	
	Для Каждого ПредставительXDTO Из МассивСвУпПредXDTO Цикл

		Если ПредставительXDTO.ТипПред = ТипыПредставителей.ЮридическоеЛицо Тогда
			
			СведОргXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "СвОрг.СвОрг");
			ЗаполнитьПредставителяЮрЛицо002(СведОргXDTO, Представители);
									
		ИначеЕсли ПредставительXDTO.ТипПред = ТипыПредставителей.ИндивидуальныйПредприниматель Тогда	

			СведФизЛXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "СведИП");
			ЗаполнитьПредставителяИП002(СведФизЛXDTO, Представители);
									
		ИначеЕсли ПредставительXDTO.ТипПред = ТипыПредставителей.ФизическоеЛицо Тогда	
			
			СведФизЛXDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(ПредставительXDTO, "СведФизЛ");
			ЗаполнитьПредставителяФизЛицо002(СведФизЛXDTO, Представители);
									
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДоверенности.Представители = Представители;
	
КонецПроцедуры

Процедура ЗаполнитьПредставителяЮрЛицо002(СведОргXDTO, Представители)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	НовыйПредставитель = Новый Структура;
	НовыйПредставитель.Вставить("ТипПредставителя", 		"1");
	НовыйПредставитель.Вставить("НаименованиеОрганизации", 	КС.XDTO_Вычислить(СведОргXDTO, "НаимОрг"));
	НовыйПредставитель.Вставить("ИНН", 						КС.XDTO_Вычислить(СведОргXDTO, "ИННЮЛ"));
	НовыйПредставитель.Вставить("КПП", 						КС.XDTO_Вычислить(СведОргXDTO, "КПП"));
	НовыйПредставитель.Вставить("ОГРН", 					КС.XDTO_Вычислить(СведОргXDTO, "ОГРН"));
		
	Представители.Добавить(НовыйПредставитель);	
	
КонецПроцедуры

