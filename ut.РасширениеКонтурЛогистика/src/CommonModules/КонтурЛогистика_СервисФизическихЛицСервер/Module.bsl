КонецФункции

Функция ПроверитьДаныеПередОтправкойПриглашения(Организация, Сотрудник, Сценарий, Телефон, ПереотправкаПриглашения = Ложь) Экспорт
	
	Если Не КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступенСервисФизЛиц(Организация) Тогда
		Сообщить("Сервис не доступен в выбранной организации");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Сообщить("Не заполнен телефон");
		Возврат Ложь;
	КонецЕсли;
		
	Если КонтурЛогистика_СервисФизическихЛицСервер.СотрудникЕстьВОрганизации(Сотрудник, Организация) И Не ПереотправкаПриглашения Тогда
		Сообщить("Сотрудник уже добавлен в выбранную организацию или отправлено приглашение");
		Возврат Ложь;
	КонецЕсли;
	
	Если КонтурЛогистика_СервисФизическихЛицСервер.ПриглашениеПринято(Организация, Сотрудник, Сценарий, Телефон) Тогда
		Сообщить("Приглашение уже принято по этому телефону");
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ОбменССервисом

Процедура ЗагрузитьДанныеСотрудниковИзСервиса(Организация, АдресПрогресса = Неопределено) Экспорт

	Запрос = КонтурЛогистика_КонвертацияСервер.БазовыйЗапросДляПоиска(Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника);
	
	СписокФизическихЛицРС = СписокФизическихЛицИзРегистраСведений(Организация);
	
	СписокФизическихЛицАПИ = ПолныйСписокФизическихЛиц(Организация);
    КолвоФизЛицАПИ = СписокФизическихЛицАПИ.Количество();
	
	инд = 0;
	ПрогрессОбновленияСотрудников(инд, КолвоФизЛицАПИ, АдресПрогресса);
		 
	Для каждого ФизЛицо Из СписокФизическихЛицАПИ Цикл
		
		Если Не ЗначениеЗаполнено(ФизЛицо.userId) Или Не ЗначениеЗаполнено(ФизЛицо.ДанныеСотрудника.ВУИд) Тогда
			ПрогрессОбновленияСотрудников(инд, КолвоФизЛицАПИ, АдресПрогресса);
			Продолжить;
		КонецЕсли;
		
		// если в рег сведений сервиса физиков есть запись, то обновим сотрудника и обновим статус приглашения, если нужно	
		Запись = СписокФизическихЛицРС.Найти(ФизЛицо.id, "PersonId");
		Если Запись <> Неопределено И ЗначениеЗаполнено(Запись.Сотрудник) Тогда
			
			Результат = ПолучитьРасхождения(Запись);
			 
			Если Результат.ЕстьРасхождения Тогда
				СотрудникОб = Запись.Сотрудник.ПолучитьОбъект();
				ЗаполнитьСотрудникаДаннымиФизическогоЛица(СотрудникОб, ФизЛицо);
				СотрудникОб.Записать();
			КонецЕсли;
		
			Если Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение Тогда
				ПринятьПриглашение(Организация, Запись.Сотрудник, ФизЛицо.userId);
			КонецЕсли;
			
			Запись.Обработан = Истина;
			
			ПрогрессОбновленияСотрудников(инд, КолвоФизЛицАПИ, АдресПрогресса, Запись.Сотрудник);
			
			Продолжить;
			
		КонецЕсли;
		
		Сотрудник = Неопределено;
		
		// найдем сотрудника по ключам поиска из менеджера модуля спр Сотрудники, если не находим, то создаем нового
		РеквизитыДляПоиска = РеквизитыДляПоиска(ФизЛицо);
		Результат = КонтурЛогистика_КонвертацияСервер.ДобавитьПараметрыВЗапросПоискаСправочникаЛогистики(
			Запрос, РеквизитыДляПоиска, Справочники.КонтурЛогистика_Сотрудники, Истина);
		
		Если ТипЗнч(Результат) = Тип("Строка") И Не ЗначениеЗаполнено(Результат) Тогда
			
			Сотрудник = СоздатьСотрудникаПофизЛицу(ФизЛицо);
			
		ИначеЕсли ТипЗнч(Результат) = Тип("СправочникСсылка.КонтурЛогистика_Сотрудники") И ЗначениеЗаполнено(Результат) Тогда
			
			Сотрудник = Результат;
			
			СотрудникОб = Сотрудник.ПолучитьОбъект();
			ЗаполнитьСотрудникаДаннымиФизическогоЛица(СотрудникОб, ФизЛицо);
			СотрудникОб.Записать();
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			
			Запись = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.СоздатьМенеджерЗаписи();
			Запись.Сотрудник = Сотрудник;
			Запись.Организация = Организация;
			Запись.СценарийПриглашения = Перечисления.КонтурЛогистика_СценарииПриглашенийФизическихЛиц.Водитель;
			Запись.PersonId = ФизЛицо.id;
			Запись.UserId = ФизЛицо.userId;
			Запись.Телефон = Сотрудник.ТелефонОсновной;
			Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение;
			ЗаполнитьЗначенияСвойств(Запись, ФизЛицо.ДанныеСотрудника);
			Запись.ТелефонСовпадает = Истина;
			
			Если ФизЛицо.ДанныеСотрудника.Свойство("ВУИд") Тогда
				Запись.IdentityDocumentId = ФизЛицо.ДанныеСотрудника.ВУИд;	
			КонецЕсли;
			
			Запись.Записать();
			
		КонецЕсли;
		
		ПрогрессОбновленияСотрудников(инд, КолвоФизЛицАПИ, АдресПрогресса, Сотрудник);
		
	КонецЦикла;
	
	Для каждого ФизЛицо Из СписокФизическихЛицРС Цикл
		
		Если ФизЛицо.Обработан Тогда
			Продолжить;
		КонецЕсли;
		
		Если ФизЛицо.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение 
			Или ФизЛицо.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение Тогда
			
			РеквизитыДляЗаписи = Новый Структура("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.Удалено);
			ИзменитьЗапись(Организация, ФизЛицо.Сотрудник, РеквизитыДляЗаписи);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеСотрудникаИзСервиса(Сотрудник) Экспорт
	
	Отбор = Новый Структура("Сотрудник", Сотрудник);
	Выборка = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.Выбрать(Отбор);
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Статус <> Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение Тогда
			Продолжить;
		КонецЕсли;
		
		ЗагрузитьДанныеСотрудникаИзСервисаПоПриглашению(Выборка.Организация, Сотрудник, Выборка.PersonId, Выборка.Статус);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеСотрудникаИзСервисаПоПриглашению(Организация, Сотрудник, PersonId, Статус) Экспорт
	
	Результат = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ПолучитьФизическоеЛицо(Организация, PersonId);
	
	Если Результат.ФизЛицоУдалено Тогда
		РеквизитыДляЗаписи = Новый Структура("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.Удалено);
	Иначе
	
		СотрудникОб = Сотрудник.ПолучитьОбъект();
		ЗаполнитьСотрудникаДаннымиФизическогоЛица(СотрудникОб, Результат.ФизЛицо);
		СотрудникОб.Записать();
		
		РеквизитыДляЗаписи = РеквизитыСотрудникаДляЗаписиРС(Сотрудник);
		
		Если Результат.ФизЛицо.ДанныеСотрудника.Свойство("ВУИд") И ЗначениеЗаполнено(Результат.ФизЛицо.ДанныеСотрудника.ВУИд) Тогда	
			РеквизитыДляЗаписи.Вставить("IdentityDocumentId", Результат.ФизЛицо.ДанныеСотрудника.ВУИд);
		КонецЕсли;
		
	КонецЕсли;
	
	ИзменитьЗапись(Организация, Сотрудник, РеквизитыДляЗаписи);
	
КонецПроцедуры

Процедура ВыгрузитьДанныеСотрудниковВСервис(Организация, АдресПрогресса) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник КАК Сотрудник,
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.PersonId КАК PersonId,
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ВУДатаВыдачи КАК ВУДатаВыдачи,
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ВУНомер КАК ВУНомер,
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ВУСерия КАК ВУСерия,
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.IdentityDocumentId КАК IdentityDocumentId,
		|	ВЫБОР
		|		КОГДА РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение)
		|				И (РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Фамилия <> КонтурЛогистика_Сотрудники.Фамилия
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Имя <> КонтурЛогистика_Сотрудники.Имя
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Отчество <> КонтурЛогистика_Сотрудники.Отчество
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ДатаРождения <> КонтурЛогистика_Сотрудники.ДатаРождения
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ИНН <> КонтурЛогистика_Сотрудники.ИНН
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.СНИЛС <> КонтурЛогистика_Сотрудники.СНИЛС
		|					ИЛИ 
		|						ВЫБОР
		|							КОГДА РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение)
		|								ТОГДА ВЫБОР
		|										КОГДА ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник.ТелефонОсновной, 1, 1) = ""+""
		|												И ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ТелефонОсновной, 3, 20) <> ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник.ТелефонОсновной, 3, 20)
		|											ТОГДА ИСТИНА
		|										КОГДА (ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник.ТелефонОсновной, 1, 1) = ""7""
		|												ИЛИ ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник.ТелефонОсновной, 1, 1) = ""8"")
		|												И ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ТелефонОсновной, 3, 20) <> ПОДСТРОКА(РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник.ТелефонОсновной, 2, 20)
		|											ТОГДА ИСТИНА
		|										ИНАЧЕ ЛОЖЬ
		|									КОНЕЦ
		|							ИНАЧЕ ЛОЖЬ
		|						КОНЕЦ
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.АдресЭлектроннойПочты <> КонтурЛогистика_Сотрудники.АдресЭлектроннойПочты
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ВУСерия <> КонтурЛогистика_Сотрудники.ВУСерия
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ВУНомер <> КонтурЛогистика_Сотрудники.ВУНомер
		|					ИЛИ РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.ВУДатаВыдачи <> КонтурЛогистика_Сотрудники.ВУДатаВыдачи)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьРасхождения
		|ПОМЕСТИТЬ СотрудникиСПроверкойРасхождений
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СервисФизическихЛиц КАК РегистрСведенийКонтурЛогистика_СервисФизическихЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
		|		ПО РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Сотрудник = КонтурЛогистика_Сотрудники.Ссылка
		|ГДЕ
		|	РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Организация = &Организация
		|	И РегистрСведенийКонтурЛогистика_СервисФизическихЛиц.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СотрудникиСПроверкойРасхождений.Сотрудник КАК Сотрудник,
		|	СотрудникиСПроверкойРасхождений.PersonId КАК PersonId,
		|	СотрудникиСПроверкойРасхождений.ВУДатаВыдачи КАК ВУДатаВыдачи,
		|	СотрудникиСПроверкойРасхождений.ВУНомер КАК ВУНомер,
		|	СотрудникиСПроверкойРасхождений.ВУСерия КАК ВУСерия,
		|	СотрудникиСПроверкойРасхождений.IdentityDocumentId КАК IdentityDocumentId,
		|	СотрудникиСПроверкойРасхождений.ЕстьРасхождения КАК ЕстьРасхождения,
		|	СотрудникиСПроверкойРасхождений.Сотрудник.ВУДатаВыдачи КАК СотрудникВУДатаВыдачи,
		|	СотрудникиСПроверкойРасхождений.Сотрудник.ВУНомер КАК СотрудникВУНомер,
		|	СотрудникиСПроверкойРасхождений.Сотрудник.ВУСерия КАК СотрудникВУСерия
		|ИЗ
		|	СотрудникиСПроверкойРасхождений КАК СотрудникиСПроверкойРасхождений
		|ГДЕ
		|	СотрудникиСПроверкойРасхождений.ЕстьРасхождения";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	тзРезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	КолвоФизЛиц = тзРезультатЗапроса.Количество();
	
	инд = 0;
	
	Для каждого Стр Из тзРезультатЗапроса Цикл
		
		ИдДокумента = "";
		Если Стр.ВУДатаВыдачи <= Стр.СотрудникВУДатаВыдачи
			ИЛИ (СокрЛП(Стр.ВУНомер) = СокрЛП(Стр.СотрудникВУНомер) 
				И СокрЛП(Стр.ВУСерия) = СокрЛП(Стр.СотрудникВУСерия)) Тогда
			ИдДокумента = Стр.IdentityDocumentId;
		КонецЕсли;
		
		Попытка
			
			ВыгрузитьДанныеСотрудникаВСервисПоПриглашению(
				Организация, Стр.Сотрудник, Стр.PersonId, ИдДокумента);
				
				ПрогрессОбновленияСотрудников(инд, КолвоФизЛиц, АдресПрогресса, Стр.Сотрудник);
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;
			
	КонецЦикла;
		
	
КонецПроцедуры

Процедура ВыгрузитьДанныеСотрудникаВСервис(Сотрудник) Экспорт
	
	Отбор = Новый Структура("Сотрудник", Сотрудник);
	Выборка = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.Выбрать(Отбор);
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Статус <> Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение Тогда
			Продолжить;
		КонецЕсли;
		
		ИдДокумента = ""; 
		Если СокрЛП(Выборка.ВУНомер) = СокрЛП(Сотрудник.ВУНомер) И СокрЛП(Выборка.ВУСерия) = СокрЛП(Сотрудник.ВУСерия) Тогда
			ИдДокумента = Выборка.IdentityDocumentId;
		КонецЕсли;
		
		ВыгрузитьДанныеСотрудникаВСервисПоПриглашению(Выборка.Организация, Сотрудник, Выборка.PersonId, ИдДокумента);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьДанныеСотрудникаВСервисПоПриглашению(Организация, Сотрудник, PersonId, ИдДокумента = Неопределено) Экспорт
	
	КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ИзменитьФизическоеЛицо(Организация, Сотрудник, PersonId, , ИдДокумента);
	
	РеквизитыДляЗаписи = РеквизитыСотрудникаДляЗаписиРС(Сотрудник);
	ИзменитьЗапись(Организация, Сотрудник, РеквизитыДляЗаписи);
	
	ИзменитьТелефонВПриглашение(Сотрудник, Сотрудник.ТелефонОсновной, Истина);
	
КонецПроцедуры

Процедура ОбновитьФизическиеЛицаВсехСотрудников() Экспорт
	
	ДоступныеОрганизации = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступныеОрганизацииДляСервисаФизЛиц();
	Для каждого Организация Из ДоступныеОрганизации Цикл
		
		СинхронизацияВыполнена = Истина;
		
		ДатаАктуальности = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
			Организация, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийСервисаФизическихЛицДата);
	
		Если ДатаАктуальности = Неопределено Тогда
			ДатаАктуальности = Дата(1, 1, 1);
		КонецЕсли;
		
		Если ДатаАктуальности <> Дата(1, 1, 1) И НачалоДня(ДатаАктуальности) >= НачалоДня(ТекущаяДатаСеанса()) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбновитьФизическиеЛицаСотрудников(Организация);
		Исключение
			
			ТекстОшибки = "Ошибка при обновление сотрудников из сервиса. Ошибка: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
			Сообщить(ТекстОшибки);
			
			СинхронизацияВыполнена = Ложь;
			
			КонтурЛогистика_Метрика.ОбработатьОшибку("ОбновлятьФизическиеЛицаСотрудниковИзСервиса", ТекстОшибки, Организация);
			
		КонецПопытки;
		
		Сообщить("Обновление сотрудников " + Организация.Наименование + " выполнено");
		
		Если СинхронизацияВыполнена Тогда
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(Организация,
				Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийСервисаФизическихЛицДата, ТекущаяДатаСеанса()); 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьФизическиеЛицаСотрудников(Организация) Экспорт
	
	МассивДанных = МассивДанныхДляОбновленияФизЛицСотрудников(Организация);
	
	Для каждого Данные Из МассивДанных Цикл
		
		ПараметрыМетода = Новый Соответствие;
		ПараметрыМетода.Вставить("ids", Данные.МассивPersonId);
		
		СписокФизическихЛиц = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.СписокФизическихЛиц(Организация, ПараметрыМетода);
		Для каждого ФизЛицо Из СписокФизическихЛиц Цикл
			
			Сотрудник = Данные.СоответствиеСотрудникФизЛицо.Получить(ФизЛицо.id);
			
			Если Не ЗначениеЗаполнено(Сотрудник) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеСотрудника = ФизЛицо.ДанныеСотрудника;
			РеквизитыДляЗаписи = РеквизитыСотрудникаДляЗаписиРС(ДанныеСотрудника);
			
			ИзменитьЗапись(Организация, Сотрудник, РеквизитыДляЗаписи, ФизЛицо.UserId);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьФизическиеЛицаСотрудника(Сотрудник) Экспорт
	
	Попытка
	
		Отбор = Новый Структура("Сотрудник", Сотрудник);
		Выборка = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.Выбрать(Отбор);
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение Тогда
				
				Результат = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ПолучитьФизическоеЛицо(Выборка.Организация, Выборка.PersonId);
				
				Если Результат.ФизЛицоУдалено Тогда
					РеквизитыДляЗаписи = Новый Структура("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.Удалено);
				Иначе
					ДанныеСотрудника = Результат.ФизЛицо.ДанныеСотрудника;
					РеквизитыДляЗаписи = РеквизитыСотрудникаДляЗаписиРС(ДанныеСотрудника);
				КонецЕсли;
				
				ИзменитьЗапись(Выборка.Организация, Сотрудник, РеквизитыДляЗаписи);
				
			ИначеЕсли Выборка.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение Тогда
				
				РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.ПроверитьПриглашение(
					Выборка.Организация, Сотрудник, Выборка.СценарийПриглашения, Выборка.PersonId);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		Сообщить(ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьФизическоеЛицоСотрудника(Организация, Сотрудник, PersonId) Экспорт
	
	Попытка
	
		Результат = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.ПолучитьФизическоеЛицо(Организация, PersonId);
		
		Если Результат.ФизЛицоУдалено Тогда
			РеквизитыДляЗаписи = Новый Структура("Статус", Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.Удалено);
		Иначе
			ДанныеСотрудника = Результат.ФизЛицо.ДанныеСотрудника;
			РеквизитыДляЗаписи = РеквизитыСотрудникаДляЗаписиРС(ДанныеСотрудника);
		КонецЕсли;
		
		ИзменитьЗапись(Организация, Сотрудник, РеквизитыДляЗаписи);
	
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		Сообщить(ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Расхождения

Функция ЕстьРасхождения(Сотрудник, Организация = Неопределено) Экспорт
	
	Отбор = Новый Структура("Сотрудник", Сотрудник);
	Выборка = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.Выбрать(Отбор);
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Статус <> Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) И Выборка.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;
	
		Результат = КонтурЛогистика_СервисФизическихЛицСервер.ПолучитьРасхождения(Выборка);
		
		Если Результат.ЕстьРасхождения Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьРасхожденияПоРеквизитам(Сотрудник, ПроверяемыеРеквизиты, Организация = Неопределено) Экспорт
	
	Отбор = Новый Структура("Сотрудник", Сотрудник);
	Выборка = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.Выбрать(Отбор);
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Статус <> Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) И Выборка.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;
	
		Результат = КонтурЛогистика_СервисФизическихЛицСервер.ПолучитьРасхождения(Выборка);
		
		Для каждого Реквизит Из Результат.Реквизиты Цикл
			
			Если ЗначениеЗаполнено(ПроверяемыеРеквизиты) 
				И Найти(ПроверяемыеРеквизиты, Реквизит.Ключ)
				И Реквизит.Значение Тогда
				Возврат Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьРасхождения(Запись, ДанныеСотрудника = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Реквизиты", Новый Структура);
	Результат.Вставить("ЕстьРасхождения", Ложь);
	
	Реквизиты = КонтурЛогистика_СервисФизическихЛицКлиентСервер.ОбщиеРеквизитыСотрудникаИФизЛица();
	Для каждого Реквизит Из Реквизиты Цикл
		
		ИмяРеквизита = Реквизит.Ключ;
		ЗначениеРеквизитаСотрудника = ?(ДанныеСотрудника = Неопределено, Запись.Сотрудник[ИмяРеквизита], ДанныеСотрудника[ИмяРеквизита]);
		
		Если Не ЗначениеЗаполнено(Запись[ИмяРеквизита]) Или Не ЗначениеЗаполнено(ЗначениеРеквизитаСотрудника) Тогда
			Результат.Реквизиты.Вставить(ИмяРеквизита, Ложь);
			Продолжить;
		КонецЕсли;
		
		Если ИмяРеквизита = "ТелефонОсновной" Тогда
			Если Запись.ТелефонСовпадает Тогда
				Результат.Реквизиты.Вставить(ИмяРеквизита, Ложь);
			Иначе
				Результат.Реквизиты.Вставить(ИмяРеквизита, Истина);
				Результат.ЕстьРасхождения = Истина;
			КонецЕсли;
		ИначеЕсли Запись[ИмяРеквизита] <> ЗначениеРеквизитаСотрудника Тогда
			Результат.Реквизиты.Вставить(ИмяРеквизита, Истина);
			Результат.ЕстьРасхождения = Истина;
		Иначе
			Результат.Реквизиты.Вставить(ИмяРеквизита, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

