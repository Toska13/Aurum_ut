Процедура ИзменитьЗапись(Организация, Сотрудник, Реквизиты, UserId = Неопределено) Экспорт
	
	Запись = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Сотрудник = Сотрудник;
	Запись.СценарийПриглашения = Перечисления.КонтурЛогистика_СценарииПриглашенийФизическихЛиц.Водитель;
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		
		Для каждого Реквизит Из Реквизиты Цикл
			 
			ИмяРеквизита = Реквизит.Ключ;
			Запись[ИмяРеквизита] = Реквизит.Значение;
			
			Если ИмяРеквизита = "ТелефонОсновной" Тогда
				Запись.ТелефонСовпадает = ТелефоныСовпадают(Сотрудник[ИмяРеквизита], Реквизит.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		Если Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение И ЗначениеЗаполнено(UserId) Тогда
			Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение;
			Запись.UserId = UserId;
		КонецЕсли;
		
		Запись.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

