Процедура ИзменитьТелефонВПриглашение(Сотрудник, НовыйТелефон, ИзменитьПриСинхронизации = Ложь) Экспорт
	
	Статусы = Новый Массив;
	Если ИзменитьПриСинхронизации Тогда
		Статусы.Добавить(Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение);
	Иначе
		Статусы.Добавить(Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеСоздано);
		Статусы.Добавить(Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.НеОтправленоПриглашение);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СервисФизическихЛиц.Сотрудник КАК Сотрудник,
		|	КонтурЛогистика_СервисФизическихЛиц.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СервисФизическихЛиц КАК КонтурЛогистика_СервисФизическихЛиц
		|ГДЕ
		|   КонтурЛогистика_СервисФизическихЛиц.Сотрудник = &Сотрудник
		|	И КонтурЛогистика_СервисФизическихЛиц.Статус В (&Статусы)";
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 1 Тогда
		ИзменитьЗапись(РезультатЗапроса[0].Организация, Сотрудник, Новый Структура("Телефон", НовыйТелефон));
	КонецЕсли;
	
