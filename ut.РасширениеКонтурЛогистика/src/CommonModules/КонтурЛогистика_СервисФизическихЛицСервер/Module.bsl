Функция ОрганизацииСНеактульнойДатойСинхронизации() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =		
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Организация
		|ПОМЕСТИТЬ ОрганизацияССервисомФЛ
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|		ПО (КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок = КонтурЛогистика_ОрганизацииДиадок.Ссылка)
		|ГДЕ
		|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
		|	И КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey)
		|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки <> НЕОПРЕДЕЛЕНО
		|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки <> """"""""
		|	И КонтурЛогистика_ОрганизацииДиадок.Наш
		|	И КонтурЛогистика_ОрганизацииДиадок.DirectoryId <> """"""""
		|	И (КонтурЛогистика_ОрганизацииДиадок.Перевозчик
		|			ИЛИ КонтурЛогистика_ОрганизацииДиадок.Оформитель)
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОрганизацияССервисомФЛ.Организация КАК Организация,
		|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки КАК ДАТА), ДЕНЬ), &ТекДата, ДЕНЬ) КАК КолвоДней
		|ИЗ
		|	ОрганизацияССервисомФЛ КАК ОрганизацияССервисомФЛ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
		|		ПО (КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок = ОрганизацияССервисомФЛ.Организация)
		|ГДЕ
		|	КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийСервисаФизическихЛицДата)
		|	И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки КАК ДАТА), ДЕНЬ), &ТекДата, ДЕНЬ) > 7
		|
		|УПОРЯДОЧИТЬ ПО
		|	КолвоДней УБЫВ";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДатаСеанса());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
