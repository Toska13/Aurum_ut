Функция ПолныйСписокФизическихЛиц(Организация) Экспорт
	
	ПолныйСписокФизическихЛиц = Новый Массив;
	
	count = 100;
	skip = 0;
	КолвоФЛ = count;
		
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("count", count);
	
	Пока КолвоФЛ = count Цикл
		
		ПараметрыЗапроса.Вставить("skip", skip);
		
		СписокФизическихЛицАПИ = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛиц.СписокФизическихЛиц(Организация, ПараметрыЗапроса);
		КолвоФЛ = СписокФизическихЛицАПИ.Количество();
		
		skip = skip + count;
		
		КонтурЛогистика_СтдКоллекцииКлиентСервер.ДополнитьМассивЛок(ПолныйСписокФизическихЛиц, СписокФизическихЛицАПИ);
	
	КонецЦикла;
	
	Возврат ПолныйСписокФизическихЛиц;
	
