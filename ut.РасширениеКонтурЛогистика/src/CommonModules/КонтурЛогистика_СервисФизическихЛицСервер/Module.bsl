Функция ТелефоныСовпадают(Знач Телефон1, Знач Телефон2) Экспорт
	
	Телефон1Числа = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаИзЧисел(Телефон1);
	Телефон2Числа = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаИзЧисел(Телефон2);
	
	Если Лев(Телефон1Числа, 2) = "79" Тогда
		Телефон1Числа = "8" + Прав(Телефон1Числа, СтрДлина(Телефон1Числа) - 1);	
	КонецЕсли;
	Если Лев(Телефон2Числа, 2) = "79" Тогда
		Телефон2Числа = "8" + Прав(Телефон2Числа, СтрДлина(Телефон1Числа) - 1);	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Телефон1Числа) Или Не ЗначениеЗаполнено(Телефон2Числа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Телефон1Числа = Телефон2Числа;
		
КонецФункции

Функция РеквизитыСотрудникаДляЗаписиРС(Сотрудник)
	
	Реквизиты = КонтурЛогистика_СервисФизическихЛицКлиентСервер.ОбщиеРеквизитыСотрудникаИФизЛица();
	Для каждого Реквизит Из Реквизиты Цикл
		
		ИмяРеквизита = Реквизит.Ключ;
		
		Реквизиты.Вставить(ИмяРеквизита, Сотрудник[ИмяРеквизита]);
		
	КонецЦикла;
	
	Возврат Реквизиты;
	
КонецФункции

Процедура ПринятьПриглашение(Организация, Сотрудник, UserId)
		
	Запись = РегистрыСведений.КонтурЛогистика_СервисФизическихЛиц.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Сотрудник = Сотрудник;
	Запись.СценарийПриглашения = Перечисления.КонтурЛогистика_СценарииПриглашенийФизическихЛиц.Водитель;
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		Запись.UserId = UserId;
		Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция СписокФизическихЛицИзРегистраСведений(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_СервисФизическихЛиц.PersonId КАК PersonId,
		|	КонтурЛогистика_СервисФизическихЛиц.Сотрудник КАК Сотрудник,
		|	КонтурЛогистика_СервисФизическихЛиц.Статус КАК Статус,
		|	КонтурЛогистика_СервисФизическихЛиц.Фамилия КАК Фамилия,
		|	КонтурЛогистика_СервисФизическихЛиц.Имя КАК Имя,
		|	КонтурЛогистика_СервисФизическихЛиц.Отчество КАК Отчество,
		|	КонтурЛогистика_СервисФизическихЛиц.ДатаРождения КАК ДатаРождения,
		|	КонтурЛогистика_СервисФизическихЛиц.ИНН КАК ИНН,
		|	КонтурЛогистика_СервисФизическихЛиц.СНИЛС КАК СНИЛС,
		|	КонтурЛогистика_СервисФизическихЛиц.ТелефонОсновной КАК ТелефонОсновной,
		|	КонтурЛогистика_СервисФизическихЛиц.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты,
		|	КонтурЛогистика_СервисФизическихЛиц.ВУДатаВыдачи КАК ВУДатаВыдачи,
		|	КонтурЛогистика_СервисФизическихЛиц.ВУНомер КАК ВУНомер,
		|	КонтурЛогистика_СервисФизическихЛиц.ВУСерия КАК ВУСерия,
		|	КонтурЛогистика_СервисФизическихЛиц.ТелефонСовпадает КАК ТелефонСовпадает,
		|	ЛОЖЬ КАК Обработан
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СервисФизическихЛиц КАК КонтурЛогистика_СервисФизическихЛиц
		|ГДЕ
		|	КонтурЛогистика_СервисФизическихЛиц.Организация = &Организация
		|	И НЕ КонтурЛогистика_СервисФизическихЛиц.Сотрудник.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РеквизитыДляПоиска(ФизЛицо)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Реквизит");
	Результат.Колонки.Добавить("Значение");
	
	Если ФизЛицо.ДанныеСотрудника.Свойство("ИНН") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "ИНН", ФизЛицо.ДанныеСотрудника.ИНН);
	КонецЕсли;
	Если ФизЛицо.ДанныеСотрудника.Свойство("СНИЛС") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "СНИЛС", ФизЛицо.ДанныеСотрудника.СНИЛС);
	КонецЕсли;
	
	Если ФизЛицо.ДанныеСотрудника.Свойство("Фамилия") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "Фамилия", ФизЛицо.ДанныеСотрудника.Фамилия);
	КонецЕсли;
	Если ФизЛицо.ДанныеСотрудника.Свойство("Имя") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "Имя", ФизЛицо.ДанныеСотрудника.Имя);
	КонецЕсли;
	Если ФизЛицо.ДанныеСотрудника.Свойство("Отчество") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "Отчество", ФизЛицо.ДанныеСотрудника.Отчество);
	КонецЕсли;
		
	Если ФизЛицо.ДанныеСотрудника.Свойство("ДатаРождения") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "ДатаРождения", ФизЛицо.ДанныеСотрудника.ДатаРождения);
	КонецЕсли;
	
	Если ФизЛицо.ДанныеСотрудника.Свойство("ВУНомер") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "ВУНомер", ФизЛицо.ДанныеСотрудника.ВУНомер);
	КонецЕсли;
	Если ФизЛицо.ДанныеСотрудника.Свойство("ВУСерия") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "ВУСерия", ФизЛицо.ДанныеСотрудника.ВУСерия);
	КонецЕсли;
	Если ФизЛицо.ДанныеСотрудника.Свойство("ВУДатаВыдачи") Тогда
		ДобавитьСтрокуВтзРеквизитыДляПоиска(Результат, "ВУДатаВыдачи", ФизЛицо.ДанныеСотрудника.ВУДатаВыдачи);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтрокуВтзРеквизитыДляПоиска(тз, Реквизит, Значение)
	
	НоваяСтрока = тз.Добавить();
	НоваяСтрока.Реквизит = Реквизит;
	НоваяСтрока.Значение = Значение;
	
КонецПроцедуры

Функция СоздатьСотрудникаПофизЛицу(ФизЛицо)
	
	Сотрудник = Справочники.КонтурЛогистика_Сотрудники.СоздатьЭлемент();
	ЗаполнитьСотрудникаДаннымиФизическогоЛица(Сотрудник, ФизЛицо, Истина);
	Сотрудник.Записать();
	
	Возврат Сотрудник.Ссылка;
	
Конецфункции

Процедура ЗаполнитьСотрудникаДаннымиФизическогоЛица(Сотрудник, ФизЛицо, НовыйСотрудник = Ложь)
	
	Реквизиты = КонтурЛогистика_СервисФизическихЛицКлиентСервер.ОбщиеРеквизитыСотрудникаИФизЛица();
	
	Для каждого Реквизит Из Реквизиты Цикл
		
		Если Не ЗначениеЗаполнено(ФизЛицо.ДанныеСотрудника[Реквизит.Ключ]) Тогда
			Продолжить;
		КонецЕсли;
		
		Сотрудник[Реквизит.Ключ] = ФизЛицо.ДанныеСотрудника[Реквизит.Ключ];
		
	КонецЦикла;
	
	Если НовыйСотрудник Тогда
		Сотрудник.ТелефонОсновной = ФизЛицо.ДанныеСотрудника.ТелефонОсновной;
		Сотрудник.АдресЭлектроннойПочты = ФизЛицо.ДанныеСотрудника.АдресЭлектроннойПочты;
	КонецЕсли;
		
	Сотрудник.РольВодитель = Истина;
	
КонецПроцедуры

Процедура ПрогрессОбновленияСотрудников(ПорядковыйНомер, Колво, Адрес, Сотрудник = Неопределено)

	ПорядковыйНомер = ПорядковыйНомер + 1;
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		ПоместитьВоВременноеХранилище(Новый Структура("ПорядковыйНомер, Колво, Сотрудник", ПорядковыйНомер, Колво, Сотрудник), Адрес);
	КонецЕсли;
	
КонецПроцедуры

Функция МассивДанныхДляОбновленияФизЛицСотрудников(Организация)
	
	// соберем массив personId по 100 шт для метода СписокФизическихЛиц с параметром ids
	
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение);
	Статусы.Добавить(Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение);
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ		
		|	КонтурЛогистика_СервисФизическихЛиц.PersonId КАК PersonId,
		|	КонтурЛогистика_СервисФизическихЛиц.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СервисФизическихЛиц КАК КонтурЛогистика_СервисФизическихЛиц
		|ГДЕ
		|	КонтурЛогистика_СервисФизическихЛиц.Статус В (&Статусы)
		|	И КонтурЛогистика_СервисФизическихЛиц.Организация = &Организация		
		|";
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	инд = 0;	
	Данные = Новый Структура;
	Данные.Вставить("МассивPersonId", Новый Массив);
	Данные.Вставить("СоответствиеСотрудникФизЛицо", Новый Соответствие);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если инд = 100 Тогда
			
			Результат.Добавить(Данные);
			
			инд = 0;
			
			Данные = Новый Структура;
			Данные.Вставить("МассивPersonId", Новый Массив);
			Данные.Вставить("СоответствиеСотрудникФизЛицо", Новый Соответствие);
			
			Данные.МассивPersonId.Добавить(ВыборкаДетальныеЗаписи.PersonId);
			Данные.СоответствиеСотрудникФизЛицо.Вставить(ВыборкаДетальныеЗаписи.PersonId, ВыборкаДетальныеЗаписи.Сотрудник);
			
		Иначе	
			
			Данные.МассивPersonId.Добавить(ВыборкаДетальныеЗаписи.PersonId);
			Данные.СоответствиеСотрудникФизЛицо.Вставить(ВыборкаДетальныеЗаписи.PersonId, ВыборкаДетальныеЗаписи.Сотрудник);
			
		КонецЕсли;
		
		инд = инд + 1;
		
	КонецЦикла;
	
	Результат.Добавить(Данные);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти