КонецФункции

#КонецОбласти

Функция ПрочитатьЛентуСобытий(НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий) Экспорт
	
	ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(НашаОрганизацияСсылка);
	КоличествоСобытий = 100;
	
	// Приоритет у идентификатора
	АктуальностьЛентыСобытийИдентификатор = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытий);
	
	Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийИдентификатор) Тогда 
		
		АктуальностьЛентыСобытийДата = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
			НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытийДата);
		
		Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийДата) Тогда
			
			АктуальностьЛентыСобытийДата = НачалоДня(ТекущаяДатаСеанса());
			УниверсальноеВремяСобытия = УниверсальноеВремя(АктуальностьЛентыСобытийДата, Неопределено);
			АктуальностьЛентыСобытийДатаМСК = МестноеВремя(УниверсальноеВремяСобытия, "GMT+3");
			
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытийДата,
				АктуальностьЛентыСобытийДатаМСК);
			
		КонецЕсли;
		
	Иначе
		
		АктуальностьЛентыСобытийДата = Неопределено;
		
	КонецЕсли;
	
	Если ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытий = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий Тогда
		// ЭТрН
		ЛентаСобытийИзСервиса = КонтурЛогистика_API_Логистика.ПолучитьЛентуСобытий(
			ПараметрыСервисаЛогистика, АктуальностьЛентыСобытийИдентификатор, АктуальностьЛентыСобытийДата, КоличествоСобытий);
	Иначе
		// ЭПЛ
		ЛентаСобытийИзСервиса = КонтурЛогистика_API_Логистика.ПолучитьЛентуСобытийПутевыхЛистов(
			ПараметрыСервисаЛогистика, НашаОрганизацияСсылка.ID, АктуальностьЛентыСобытийИдентификатор, АктуальностьЛентыСобытийДата, КоличествоСобытий);
	КонецЕсли;
	
	Возврат ЛентаСобытийИзСервиса;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Приводим полученную ленту из соответствий в таблицу значений
//
// Параметры:
//  НашаОрганизацияСсылка	- СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - наша органиазция.
//  ЛентаСобытийВходящая	- Соответствие, Массив	 - полученная лента преобразованная из JSON в соответствия.
//  ПеречисленияАктуальностиЛентыСобытий - Структура - См. ПеречисленияАктуальностиЛентыСобытий
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяЛентаСобытий.
//
Функция НормализоватьЛентуЛогистики(НашаОрганизацияСсылка, ЛентаСобытийВходящая, ПеречисленияАктуальностиЛентыСобытий) Экспорт
	
	Перем ТипДокументаСервиса;
	
	ЭтоЭТрН = (ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытий = Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий);
	
	ЛентаСобытий = НоваяЛентаСобытий();
	
	Для Каждого ТекущееСобытие Из ЛентаСобытийВходящая Цикл
		
		Если ЭтоЭТрН Тогда
			ИдентификаторАктуальногоСобытия = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "id");
		Иначе
			ИдентификаторАктуальногоСобытия = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventId");
		КонецЕсли;
		
		ТипСобытия = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventType");
		
		Если Не ТребуетсяОбработкаСобытия(ТипСобытия) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоЭТрН Тогда
			ТипДокументаСервиса = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
				"details.detailsExtended.documentSignedBySenderEventDetails.documentType");
			Если ТипДокументаСервиса = Неопределено Тогда
				ТипДокументаСервиса = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
					"details.detailsExtended.documentSignedByRecipientEventDetails.documentType");
			КонецЕсли;
			
			ДатаСтрокой = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "dateTimeUtc");
			СтатусСобытия = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "newStatus");
			ТипДокумента = ТипДокументаСобытияЭТрН(СтатусСобытия, ТипСобытия, ТипДокументаСервиса);
		Иначе
			ДатаСтрокой = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "timestampUtc");
			СтатусСобытия = "";
			ТипДокумента = ТипДокументаСобытияЭПЛ(СтатусСобытия, ТипСобытия, ТекущееСобытие);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТипДокумента)
			И Не ЭтоПоказанияТоплива(ТипСобытия) Тогда
			
			Продолжить;
		КонецЕсли;
		
		// Инфо поля
		Если ЭтоЭТрН Тогда
			ИнфоПоля = ПолучитьИнфоПоля(ТекущееСобытие);
			Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗагружатьДокументПоФильтруИнфоПолей(НашаОрганизацияСсылка, ИнфоПоля) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		// Не будем фиксировать статус RequestingMintransId, иначе ломается порядок статусов ДО, так как ядро не дает нового статуса
		// после получения УИД, тем самым зависает обмен у ПВ
		Если ТипСобытия = "DocumentSignedBySender" И СтатусСобытия = "RequestingMintransId" Тогда
			СтатусСобытия = "";
		КонецЕсли;
		
		ДатаИзСтроки = ДатаИзСтроки(ДатаСтрокой);
		УниверсальноеВремяСобытия = УниверсальноеВремя(ДатаИзСтроки, Неопределено);
		
		НоваяСтрока = ЛентаСобытий.Добавить();
		НоваяСтрока.id = ИдентификаторАктуальногоСобытия;
		НоваяСтрока.newStatus = СтатусСобытия;
		НоваяСтрока.eventType = ТипСобытия;
		НоваяСтрока.ТипДокумента = ТипДокумента;
		НоваяСтрока.Дата = МестноеВремя(УниверсальноеВремяСобытия, "GMT+3");
		НоваяСтрока.ИдентификаторДокумента = ИдентификаторДокументаИзЛентыСобытия(ТекущееСобытие, ТипДокумента, ТипДокументаСервиса);
		
		Если ЭтоЭТрН Тогда
			НоваяСтрока.transportationId = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "transportationId");
			НоваяСтрока.entityId = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "details.titleInfo.entityId");
			НоваяСтрока.draftId = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "details.detailsExtended.draftId");
			
			НоваяСтрока.ЕстьЗамечанияВодителя = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
				"details.detailsExtended.driverApprovement.hasRemarks");
			НоваяСтрока.ЭтоИсправление = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
				"details.detailsExtended.documentSignedBySenderEventDetails.isRevision");
			НоваяСтрока.ВидДействия = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
				"details.detailsExtended.draftActionType");
		Иначе
			НоваяСтрока.transportationId = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails.eplId");
			Если ЭтоПоказанияТоплива(ТипСобытия) Тогда
				НоваяСтрока.ПоказанияТоплива = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails");
			Иначе
				НоваяСтрока.entityId = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails.documents[0].documentId");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЛентаСобытий;
	
КонецФункции

// Читаем инфо поля
//
// Параметры:
//  ТекущееСобытие	 - Структура	 - данные ленты по текущему событию.
// 
// Возвращаемое значение:
//  Соответствие - значения инфо полей
//
Функция ПолучитьИнфоПоля(ТекущееСобытие)
	
	ИнфоПоля = Новый Соответствие;
	
	Попытка
		
		infoFieldsByTitles = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
			"details.detailsExtended.infoFieldsByTitles");
		Если infoFieldsByTitles = Неопределено Тогда
			Возврат ИнфоПоля;
		КонецЕсли;
		
		Для Каждого ТекущиееЗначение Из infoFieldsByTitles Цикл
			
			infoFields = ЗначениеПоПутиИзДанныхСоответствий(ТекущиееЗначение, "infoFields");
			
			Для Каждого ТекущийinfoFields Из infoFields Цикл
				
				ТекущийКлюч = ТекущийinfoFields.Получить("key");
				ТекущееЗначение = ТекущийinfoFields.Получить("infoValue");
				
				ИнфоПоля.Вставить(ТекущийКлюч, ТекущееЗначение);
				
			КонецЦикла;
			
		КонецЦикла;
		
	Исключение
		
		Возврат ИнфоПоля;
		
	КонецПопытки;
	
	Возврат ИнфоПоля;
	
КонецФункции

// Возвращает таблицу для формирования ленты из входных данных
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица.
//
Функция НоваяЛентаСобытий()
	
	ЛентаСобытий = Новый ТаблицаЗначений;
	ЛентаСобытий.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));					// Дата по МСК
	ЛентаСобытий.Колонки.Добавить("transportationId", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("id", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("newStatus", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("eventType", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("entityId", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("draftId", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("ТипДокумента", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов"));
	ЛентаСобытий.Колонки.Добавить("ВидДействия", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("ЕстьЗамечанияВодителя", Новый ОписаниеТипов("Булево"));
	ЛентаСобытий.Колонки.Добавить("ЭтоИсправление", Новый ОписаниеТипов("Булево"));
	ЛентаСобытий.Колонки.Добавить("КодТипаДокумента", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("ПредставлениеТипаДокумента", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("ИдентификаторДокумента", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("КодРегламента", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("КодТранзакции", Новый ОписаниеТипов("Строка"));
	ЛентаСобытий.Колонки.Добавить("ПоказанияТоплива");	// См. НовоеПоказанияТоплива
	
	Возврат ЛентаСобытий;
	
КонецФункции

// В данных соответствия ищем данные по пути
//
// Параметры:
//  ДанныеСоответствий	 - Соответствие	 - данные представленные в виде соответствий и массивов.
//  ПутьКЗначению		 - Строка	 - путь к значению (пример: "documentInfo.circulations.items[0].titles.items[0].id").
// 
// Возвращаемое значение:
//  Строка, Число, Неопределено, Соответствие - данные полученные по маске.
//
Функция ЗначениеПоПутиИзДанныхСоответствий(Знач ДанныеСоответствий, ПутьКЗначению) Экспорт
	
	Если ДанныеСоответствий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		СтэкКлючей = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ПутьКЗначению, ".", Ложь);
		
		Для Каждого ТекущийКлюч Из СтэкКлючей Цикл
			
			Если Найти(ТекущийКлюч, "[") = 0 Тогда // это массив
				
				Если ДанныеСоответствий = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли;
				
				ДанныеСоответствий = ДанныеСоответствий.Получить(ТекущийКлюч);
				
			Иначе  // Это не массив
				
				ИмяМассиваИПорядковыйНомер = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ТекущийКлюч, "[]", Ложь);
				
				ИмяКлюча = ИмяМассиваИПорядковыйНомер[0];
				ИндексМассива = Число(ИмяМассиваИПорядковыйНомер[1]);
				
				Если ДанныеСоответствий = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли;
				
				ДанныеСоответствий = ДанныеСоответствий.Получить(ИмяКлюча)[ИндексМассива];
				
			КонецЕсли;
			
		КонецЦикла;
		
		Результат = ДанныеСоответствий;
		
	Исключение
		
		Результат = Неопределено;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Определяет требуется ли обработка события
//
// Параметры:
//  eventType	 - Строка	 - имя события.
// 
// Возвращаемое значение:
//  Булево - требуется ли обработка события.
//
Функция ТребуетсяОбработкаСобытия(eventType) Экспорт
	
	ИмяСобытияПереадресовки = "ReaddressSigned";
	ИмяСобытияСменыВодителя = "RelaySigned";
	
	Если
		// ЭТрН
		eventType = "DocumentSignedBySender"
		Или eventType = "DocumentSignedByRecipient"
		Или eventType = "DocumentApprovedByDriver"
		Или eventType = "TransportationCreated"
		Или eventType = "DraftAction"
		Или eventType = ИмяСобытияПереадресовки
		Или eventType = ИмяСобытияСменыВодителя
		// ЭПЛ
		Или eventType = "EplOpened"						// Событие создания путевого листа
		Или eventType = "DriverCheckupPassed"			// Событие прохождения медосмотра водителем
		Или eventType = "VehicleTechInspectionPassed"	// Событие прохождения техосмотра транспортного средства
		Или eventType = "VehicleDeparted"				// Событие о выходе транспортного средства на линию
		Или eventType = "VehicleArrived"				// Событие о прибытии транспортного средства
		Или ЭтоПоказанияТоплива(eventType) Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Идентификатор документа из ленты события
//
// Параметры:
//  ТекущееСобытие		 - Структура	 - данные ленты по текущему событию.
//  ТипДокумента		 - Перечисление	 - тип документа.
//  ТипДокументаСервиса	 - Строка		 - тип документа в сервисе.
// 
// Возвращаемое значение:
//  Строка - ИдентификаторДокумента
//
Функция ИдентификаторДокументаИзЛентыСобытия(ТекущееСобытие, ТипДокумента, ТипДокументаСервиса)
	
	ИдентификаторДокумента = "";
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		
		ИдентификаторДокумента = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
			"details.detailsExtended.documentSignedBySenderEventDetails.documentId");
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
		Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6
		Или ТипДокументаСервиса = "RejectTitle" Тогда	// Уведомление об уточнении
		
		ИдентификаторДокумента = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
			"details.detailsExtended.documentSignedByRecipientEventDetails.documentId");
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
		
		ИдентификаторДокумента = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
			"details.titleInfo.entityId");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		
		ИдентификаторДокумента = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие,
			"eventDetails.documents[0].documentId");
		
	КонецЕсли;
	
	Возврат ИдентификаторДокумента;
	
КонецФункции

Функция ТипДокументаСобытияЭТрН(newStatus, eventType, ТипДокументаСервиса)
	
	Если (eventType = "DraftAction" И newStatus = "WaybillReceptionWaitConsignorSignature")
		Или newStatus = "WaybillReceptionWaitDriverConfirmation"
		Или newStatus = "CarrierWaitingForWaybillReceptionSigned" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	
	ИначеЕсли  newStatus = "RequestingMintransId" И eventType = "DocumentSignedBySender" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		
	ИначеЕсли newStatus = "WaybillReceptionWaitConsignorConfirmation"
		И (eventType = "TransportationCreated" ИЛИ eventType = "DraftAction") Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		
	ИначеЕсли newStatus = "WaybillReceptionWaitCarrierSignature"
		И (eventType = "DocumentApprovedByDriver"
			Или eventType = "DocumentSignedBySender") Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		
	ИначеЕсли newStatus = "OnTheWay"
		И eventType = "DocumentSignedBySender" Тогда
		
		// Исправление Т1
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		
	ИначеЕсли newStatus = "OnTheWay"
		И eventType = "DocumentSignedByRecipient" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2;
		
	ИначеЕсли newStatus = "WaybillReceptionSignatureReject"
		И eventType = "DocumentSignedByRecipient" Тогда
		
		// Отказ Т1
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2;
		
	ИначеЕсли (eventType = "DraftAction" И newStatus = "WaybillDeliveryWaitConsigneeSignature")
		Или newStatus = "WaybillDeliveryWaitDriverConfirmation"
		Или newStatus = "WaybillDeliveryWaitConsigneeConfirmation"
		Или newStatus = "CarrierWaitingForWaybillDeliverySigned" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
		
	ИначеЕсли newStatus = "WaybillDeliveryWaitCarrierSignature"
		И eventType = "DocumentApprovedByDriver" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
		
	ИначеЕсли newStatus = "Completed"
		И eventType = "DocumentSignedByRecipient" Тогда
		
		Если ТипДокументаСервиса = "ConsignorPaymentTitle" Тогда
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6;
		ИначеЕсли ТипДокументаСервиса  = "RejectTitle" Тогда
			// Отказ Т5
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6;
		Иначе
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4;
		КонецЕсли;
		
	ИначеЕсли newStatus = "PartialDeliveryWaitCarrierReaddressSign"
		И eventType = "DocumentSignedByRecipient" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4;
		
	ИначеЕсли newStatus = "WaitConsignorCostSignature"
		И eventType = "DocumentSignedBySender" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5;
		
	ИначеЕсли (newStatus = "Completed"
			Или newStatus = "OnTheWay")
		И eventType = "ReaddressSigned" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7;
		
	ИначеЕсли newStatus = "OnTheWay"
		И eventType = "RelaySigned" Тогда
		
		Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8;
		
	КонецЕсли;
	
	Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка();
	
КонецФункции

Функция ТипДокументаСобытияЭПЛ(newStatus, eventType, ТекущееСобытие)
	
	Попытка
		
		ДанныеОДокументе = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails.documents")[0];
		
		ТипДокумента = ЗначениеПоПутиИзДанныхСоответствий(ДанныеОДокументе, "type");
		Формат = ЗначениеПоПутиИзДанныхСоответствий(ДанныеОДокументе, "format");
		
		Если ТипДокумента = "ON_PTLSSOBTS" Тогда
			
			Если Формат = "5.02" Тогда
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;	
			Иначе
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "ON_PTLSPRMO" Тогда
			
			Если Формат = "5.02" Тогда
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02;	
			Иначе
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "ON_PTLSVIPTS" Тогда
			
			Если Формат = "5.02" Тогда
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;	
			Иначе
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "ON_PTLSODVZD" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4;
			
		ИначеЕсли ТипДокумента = "ON_PTLSVOZVR" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02;
			
		ИначеЕсли ТипДокумента = "ON_PTLSODPARK" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5;
			
		ИначеЕсли ТипДокумента = "ON_PTLSPOSMO" Тогда
			
			Если Формат = "5.02" Тогда
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02;	
			Иначе
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6;
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "DP_UVUTOCH" Тогда
			
			ТипМедосмотра = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails.checkupType");
			
			Если ТипМедосмотра = "PreTrip" Тогда
				
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2;
				
			Иначе
				
				Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		Если eventType = "EplOpened" Тогда
		
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
			
		ИначеЕсли eventType = "DriverCheckupPassed" И ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails.checkupType") = "PreTrip" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2;
			
		ИначеЕсли eventType = "VehicleTechInspectionPassed" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3;
			
		ИначеЕсли eventType = "VehicleDeparted" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4;
			
		ИначеЕсли eventType = "VehicleArrived" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5;
			
		ИначеЕсли eventType = "DriverCheckupPassed" И ЗначениеПоПутиИзДанныхСоответствий(ТекущееСобытие, "eventDetails.checkupType") = "PostTrip" Тогда
			
			Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6;
			
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка();
	
КонецФункции

// Преобразует дату из строки к текущему часовому поясу
//
// Параметры:
//  Значение - Строка	 - Дата строкой (пример: "2023-07-19T12:25:39Z").
// 
// Возвращаемое значение:
//  Дата - преобразованная дата из строки.
//
Функция ДатаИзСтроки(Знач Значение) Экспорт
	
	Если ПустаяСтрока(Значение) Тогда 
		Возврат ПустаяДата();
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ?(Значение < Дата(1970, 1, 1, 0, 0, 0), ПустаяДата(), Значение);
	КонецЕсли;
	
	Результат = XMLЗначение(Тип("Дата"), Значение);
	
	Если Результат = Неопределено Тогда
		Возврат ПустаяДата();
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция СведенияОПеревозках(ЛентаСобытий, НашаОрганизацияСсылка)
	
	ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(НашаОрганизацияСсылка);
	
	СведенияОПеревозках = Новый Соответствие;
	
	Для Каждого ТекущееСобытие Из ЛентаСобытий Цикл
		
		transportationId = ТекущееСобытие.transportationId;
		
		Если СведенияОПеревозках.Получить(transportationId) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			СведенияОПеревозкеВходящие = КонтурЛогистика_API_Логистика.ПолучитьСведенияОПеревозке(
				ПараметрыСервисаЛогистика, transportationId);
		Исключение
			ТекстОшибки = "Не удалось получить сведения о перевозке: " + Строка(transportationId) + ".
				|Текст ошибки: " + ОписаниеОшибки();
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
		СведенияОПеревозке = НормализоватьСведенияОПеревозке(СведенияОПеревозкеВходящие);
		
		СведенияОПеревозках.Вставить(transportationId, СведенияОПеревозке);
		
	КонецЦикла;
	
	Возврат СведенияОПеревозках;
	
КонецФункции

Функция НормализоватьСведенияОПеревозке(СведенияОПеревозкеВходящие)
	
	СведенияОПеревозке = НовыеСведенияОПеревозке();
	
	ПризнакТестовыйДокумент = ЗначениеПоПутиИзДанныхСоответствий(СведенияОПеревозкеВходящие, "transportationInfo.isTest");
	Если ПризнакТестовыйДокумент = Неопределено Тогда
		СведенияОПеревозке.ТестовыйДокумент = Ложь;
	Иначе
		СведенияОПеревозке.ТестовыйДокумент = ПризнакТестовыйДокумент;
	КонецЕсли;
	
	Участники = ЗначениеПоПутиИзДанныхСоответствий(СведенияОПеревозкеВходящие, "transportationInfo.participants.organizations.items");
	
	Для Каждого ТекущийУчастник Из Участники Цикл
		
		СведенияОбОрганизации = НоваяОрганизацияСведенийОПеревозке();
		СведенияОбОрганизации.Роль = ЗначениеПоПутиИзДанныхСоответствий(ТекущийУчастник, "role");
		СведенияОбОрганизации.BoxId = ЗначениеПоПутиИзДанныхСоответствий(ТекущийУчастник, "diadocBoxId");
		СведенияОбОрганизации.Наименование = ЗначениеПоПутиИзДанныхСоответствий(ТекущийУчастник, "name");
		СведенияОбОрганизации.ИНН = ЗначениеПоПутиИзДанныхСоответствий(ТекущийУчастник, "inn");
		СведенияОбОрганизации.КПП = ЗначениеПоПутиИзДанныхСоответствий(ТекущийУчастник, "kpp");
		
		Если СведенияОбОрганизации.Роль = "Consignor" Тогда					// Грузоотправитель
			СведенияОПеревозке.Грузоотправитель = СведенияОбОрганизации;
		ИначеЕсли СведенияОбОрганизации.Роль = "Consignee" Тогда			// Грузополучатель
			СведенияОПеревозке.Грузополучатель = СведенияОбОрганизации;
		ИначеЕсли СведенияОбОрганизации.Роль = "Carrier" Тогда				// Грузоперевозчик
			СведенияОПеревозке.Грузоперевозчик = СведенияОбОрганизации;
		КонецЕсли;
		
	КонецЦикла;
	
	ЭлементыЦикла = ЗначениеПоПутиИзДанныхСоответствий(СведенияОПеревозкеВходящие, "documentInfo.circulations.items");
	
	Для Каждого ТекущийЭлемент Из ЭлементыЦикла Цикл
		
		ТипЦикла = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "type");
		
		Если ТипЦикла = "Reception" Тогда
			
			Титулы = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "titles.items");
			
			Если Титулы <> Неопределено Тогда 
				Для Каждого ТекущийТитул Из Титулы Цикл
					
					ТипТитула = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "type");
					
					Если ТипТитула = "ConsignorTitle" Тогда
						СведенияОПеревозке.ИдентификаторТитул1 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					ИначеЕсли ТипТитула = "CarrierReceptionTitle" Тогда
						СведенияОПеревозке.ИдентификаторТитул2 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					ИначеЕсли ТипТитула = "RejectTitle" Тогда	// Отказ
						СведенияОПеревозке.ИдентификаторТитул2 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Согласования = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "resolutions.approvals");
			
			Если Согласования <> Неопределено Тогда 
				Для Каждого ТекущееСогласование Из Согласования Цикл
					
					ТипСогласования = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСогласование, "type");
					
					Если ТипСогласования = "DriverResolution" Тогда
						СведенияОПеревозке.ЗамечанияВодителяПогрузка = НормализоватьЗамечанияВодителя(ТекущееСогласование);
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Черновики = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "drafts.items");
			
			Если Черновики <> Неопределено Тогда
				Для Каждого ТекущийЧерновик Из Черновики Цикл
					
					ТипЧерновика = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЧерновик, "type");
					Если ТипЧерновика = "ConsignorTitleDraft" Тогда
						СведенияОПеревозке.ЧерновикТитул1 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЧерновик, "draftId");
					ИначеЕсли ТипЧерновика = "CarrierReceptionTitleDraft" Тогда
						СведенияОПеревозке.ЧерновикТитул2 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЧерновик, "draftId");
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли ТипЦикла = "Delivery" Тогда
			
			Титулы = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "titles.items");
			
			Если Титулы <> Неопределено Тогда 
				Для Каждого ТекущийТитул Из Титулы Цикл
					
					ТипТитула = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "type");
					
					Если ТипТитула = "ConsigneeTitle" Тогда
						СведенияОПеревозке.ИдентификаторТитул3 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					ИначеЕсли ТипТитула = "CarrierDeliveryTitle" Тогда
						СведенияОПеревозке.ИдентификаторТитул4 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Согласования = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "resolutions.approvals");
			
			Если Согласования <> Неопределено Тогда 
				Для Каждого ТекущееСогласование Из Согласования Цикл
					
					ТипСогласования = ЗначениеПоПутиИзДанныхСоответствий(ТекущееСогласование, "type");
					
					Если ТипСогласования = "DriverResolution" Тогда
						СведенияОПеревозке.ЗамечанияВодителяРазгрузка = НормализоватьЗамечанияВодителя(ТекущееСогласование);
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Черновики = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "drafts.items");
			
			Если Черновики <> Неопределено Тогда
				Для Каждого ТекущийЧерновик Из Черновики Цикл
					
					ТипЧерновика = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЧерновик, "type");
					Если ТипЧерновика = "ConsigneeTitleDraft" Тогда
						СведенияОПеревозке.ЧерновикТитул3 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЧерновик, "draftId");
					ИначеЕсли ТипЧерновика = "CarrierDeliveryTitleDraft" Тогда
						СведенияОПеревозке.ЧерновикТитул4 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЧерновик, "draftId");
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли ТипЦикла = "Readdress" Тогда
			
			Титулы = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "titles.items");
			
			Если Титулы <> Неопределено Тогда 
				Для Каждого ТекущийТитул Из Титулы Цикл
					
					ТипТитула = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "type");
					
					Если ТипТитула = "RedirectTitle" Тогда
						СведенияОПеревозке.ИдентификаторТитул7 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли ТипЦикла = "Relay" Тогда
			
			Титулы = ЗначениеПоПутиИзДанныхСоответствий(ТекущийЭлемент, "titles.items");
			
			Если Титулы <> Неопределено Тогда 
				Для Каждого ТекущийТитул Из Титулы Цикл
					
					ТипТитула = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "type");
					
					Если ТипТитула = "RelayTitle" Тогда
						СведенияОПеревозке.ИдентификаторТитул8 = ЗначениеПоПутиИзДанныхСоответствий(ТекущийТитул, "id");
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СведенияОПеревозке.ИдентификаторМинтранса = ЗначениеПоПутиИзДанныхСоответствий(СведенияОПеревозкеВходящие, "transportationInfo.mintransStatus.id");
	
	Возврат СведенияОПеревозке;
	
КонецФункции

Функция НормализоватьЗамечанияВодителя(Согласование)
	
	ЗамечаниеВодителя = КонтурЛогистика_Уведомления.НовоеЗамечаниеВодителя();
	ЗамечаниеВодителя.ЗамДатВрПриб = ДатаИзСтроки(ЗначениеПоПутиИзДанныхСоответствий(Согласование, "arrivalDateNote"));
	ЗамечаниеВодителя.ЗамДатВрУбыт = ДатаИзСтроки(ЗначениеПоПутиИзДанныхСоответствий(Согласование, "actionFinishedAtNote"));
	ЗамечаниеВодителя.ЗамДатВрПосПрием = ДатаИзСтроки(ЗначениеПоПутиИзДанныхСоответствий(Согласование, "actionStartedAtNote"));
	ЗамечаниеВодителя.ЗамДатВрПосВыгр = ЗамечаниеВодителя.ЗамДатВрПосПрием;
	ЗамечаниеВодителя.ЗамСостГруз = ЗначениеПоПутиИзДанныхСоответствий(Согласование, "comment");
	ЗамечаниеВодителя.ЗамМасс = ЗначениеПоПутиИзДанныхСоответствий(Согласование, "massNote");
	ЗамечаниеВодителя.ЗамКолМест = ЗначениеПоПутиИзДанныхСоответствий(Согласование, "numberOfCargoSpacesNote");
	ЗамечаниеВодителя.ЗамПогрРаб = ЗначениеПоПутиИзДанныхСоответствий(Согласование, "loadingOperationsNote");
	ЗамечаниеВодителя.ЗамРабВыгр = ЗамечаниеВодителя.ЗамПогрРаб;
	ЗамечаниеВодителя.ОтметкиПеревозчика = Новый Массив;
	
	ОтметкиПеревозчика = ЗначениеПоПутиИзДанныхСоответствий(Согласование, "driverRemarks");
	
	Если ОтметкиПеревозчика <> Неопределено Тогда
		Для Каждого ТекущаяОтметкаПеревозчика Из ОтметкиПеревозчика Цикл
			ОтметкаПеревозчика = КонтурЛогистика_Уведомления.НоваяОтметкаПеревозчика();
			ОтметкаПеревозчика.ДатаИВремяОтметки = ДатаИзСтроки(ЗначениеПоПутиИзДанныхСоответствий(ТекущаяОтметкаПеревозчика, "happenedAt"));
			ОтметкаПеревозчика.ОписаниеОбстоятельств = ЗначениеПоПутиИзДанныхСоответствий(ТекущаяОтметкаПеревозчика, "actualNote");
			
			ЗамечаниеВодителя.ОтметкиПеревозчика.Добавить(ОтметкаПеревозчика);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамДатВрПриб)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамДатВрУбыт)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамДатВрПосПрием)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамДатВрПосВыгр)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамСостГруз)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамМасс)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамКолМест)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамПогрРаб)
		Или ЗначениеЗаполнено(ЗамечаниеВодителя.ЗамРабВыгр) Тогда
		
		ЗамечаниеВодителя.ЕстьЗамечания = Истина;
	КонецЕсли;
	
	Если ЗамечаниеВодителя.ЕстьЗамечания Тогда
		ЗамечаниеВодителя.ПредставлениеЗамечанийВодителя = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(ЗамечаниеВодителя);
	КонецЕсли;
	
	Возврат ЗамечаниеВодителя;
	
КонецФункции

Функция СведенияОПутевомЛисте(ЛентаСобытий, НашаОрганизацияСсылка)
	
	ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(НашаОрганизацияСсылка);
	
	СведенияОПеревозках = Новый Соответствие;
	
	Для Каждого ТекущееСобытие Из ЛентаСобытий Цикл
		
		Если ЭтоПоказанияТоплива(ТекущееСобытие.eventType) Тогда
			Продолжить;
		КонецЕсли;
		
		eplId = ТекущееСобытие.transportationId;
		
		Если СведенияОПеревозках.Получить(eplId) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка			
			СведенияОПеревозкеВходящие = КонтурЛогистика_API_Логистика.ПолучитьСведенияОПутевомЛисте(
				ПараметрыСервисаЛогистика, eplId, ТекущееСобытие.ТипДокумента);			
		Исключение
			ТекстОшибки = "Не удалось получить сведения о перевозке: " + Строка(eplId) + ".
				|Текст ошибки: " + ОписаниеОшибки();
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
		СведенияОПеревозке = НормализоватьСведенияОПутевомЛисте(СведенияОПеревозкеВходящие);
		
		СведенияОПеревозках.Вставить(eplId, СведенияОПеревозке);
		
	КонецЦикла;
	
	Возврат СведенияОПеревозках;
	
КонецФункции

Функция НормализоватьСведенияОПутевомЛисте(СведенияОПеревозкеВходящие)
	
	СведенияОПеревозке = НовыеСведенияОПеревозке();
	
	ПризнакТестовыйДокумент = ЗначениеПоПутиИзДанныхСоответствий(СведенияОПеревозкеВходящие, "eplInfo.isTest");
	Если ПризнакТестовыйДокумент = Неопределено Тогда
		СведенияОПеревозке.ТестовыйДокумент = Ложь;
	Иначе
		СведенияОПеревозке.ТестовыйДокумент = ПризнакТестовыйДокумент;
	КонецЕсли;
	
	Возврат СведенияОПеревозке;
	
КонецФункции

Процедура ОбработатьСобытиеЛенты(ТекущееСобытие, СведенияОПеревозках, НашаОрганизацияСсылка)
	
	Если ЭтоПоказанияТоплива(ТекущееСобытие.eventType) Тогда
		ОбработатьПоказанияТоплива(ТекущееСобытие, НашаОрганизацияСсылка);
		Возврат;
	КонецЕсли;
	
	ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(НашаОрганизацияСсылка);
	
	transportationId = ТекущееСобытие.transportationId;
	СведенияОПеревозке = СведенияОПеревозках.Получить(transportationId);
	ДополнитьДанныеЛентыПоСведениямОПеревозке(ТекущееСобытие, СведенияОПеревозке);
	
	titleId = ТекущееСобытие.ИдентификаторДокумента;
	draftId  = ТекущееСобытие.draftId;
	
	Если ЗначениеЗаполнено(titleId) Тогда // титул существует (иначе - черновик, причем титул и черновик могут быть разными файлами в модуле)
		
		// Сейчас из сервиса мы можем получить только подписанный титул,
		// т.е. titleId существует только если титул уже подписан, поэтому titleId можно считать уникальным идентификатором.
		СуществующийФайлТитула = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиПоРеквизиту("kl_titleId", titleId);
		Если Не ЗначениеЗаполнено(СуществующийФайлТитула) Тогда
			СуществующийФайлТитула = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиПоРеквизиту("DocumentId", titleId);
						
			Если Не ЗначениеЗаполнено(СуществующийФайлТитула) И ЗначениеЗаполнено(draftId) Тогда
				СуществующийФайлТитула = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиПоРеквизиту("kl_draftId", draftId);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СуществующийФайлТитула)
				И ЗначениеЗаполнено(СуществующийФайлТитула.kl_draftId)
				И Не ЗначениеЗаполнено(СуществующийФайлТитула.kl_titleId) Тогда
				
				// Значит получили измененный и подписанный черновик
				ПерезаполнятьСуществующий = Истина;
				СохранитьТитулВСправочник(transportationId, ПараметрыСервисаЛогистика,
					ТекущееСобытие, СведенияОПеревозке, ПерезаполнятьСуществующий);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СуществующийФайлТитула) Тогда
			
			СуществующийФайлТитула = СохранитьТитулВСправочник(transportationId, ПараметрыСервисаЛогистика, ТекущееСобытие, СведенияОПеревозке);
			
		Иначе
			
			Если СведенияОПеревозке <> Неопределено И СведенияОПеревозке.ТестовыйДокумент И Не СуществующийФайлТитула.ТестовыйДокумент Тогда
				СуществующийФайлТитулаОбъект = СуществующийФайлТитула.ПолучитьОбъект();
				СуществующийФайлТитулаОбъект.ТестовыйДокумент = СведенияОПеревозке.ТестовыйДокумент;
				СуществующийФайлТитулаОбъект.Записать();
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СуществующийФайлТитула.kl_titleId) И ЗначениеЗаполнено(titleId) Тогда
				СуществующийФайлТитулаОбъект = СуществующийФайлТитула.ПолучитьОбъект();
				СуществующийФайлТитулаОбъект.kl_titleId = titleId;
				СуществующийФайлТитулаОбъект.Записать();
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СуществующийФайлТитула.СвязанныйДокумент) Тогда
				ТекущийСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(СуществующийФайлТитула.СвязанныйДокумент);
				Если ТекущийСтатусТитула <> Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
					И ТекущийСтатусТитула <> Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена Тогда
					
					// Установим, что получили файл. Значит его оформили в веб или другой базе
					РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
						СуществующийФайлТитула.СвязанныйДокумент, Перечисления.КонтурЛогистика_СтатусыТитулов.Получен);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СуществующийФайлТитула.ГлавныйДокумент) Тогда
				
				// Заглушка если приходит статус completed после отказа, то он его закрывает и не видно в списках задач
				// что надо переотправить, просто не фиксируем такой статус
				ЗафиксироватьНовыйСтутус = Истина;
				Если НРег(ТекущееСобытие.newStatus) = "completed" Тогда
					СтатусОтказВПодписи = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НайтиСостояниеДОПоКоду("c-rejected");
					ТекущийСтатусДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(
						СуществующийФайлТитула.ГлавныйДокумент);
					Если СтатусОтказВПодписи = ТекущийСтатусДО Тогда
						ЗафиксироватьНовыйСтутус = Ложь;
					КонецЕсли;
				КонецЕсли;
				
				Если ЗафиксироватьНовыйСтутус И ЗначениеЗаполнено(ТекущееСобытие.newStatus) Тогда
					Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоАнглНаименованиюСостояниюСервиса(
						ТекущееСобытие.newStatus);
					ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
						СуществующийФайлТитула, ТекущееСобытие.id, Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика);
					РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
						СуществующийФайлТитула.ГлавныйДокумент, Состояние, ТекущееСобытие.Дата,,, ДопДанные);
				КонецЕсли;
				
			Иначе
				
				ДобавитьСтатусВФайл(СуществующийФайлТитула, ТекущееСобытие.Дата, ТекущееСобытие.newStatus, ТекущееСобытие.id);
				
			КонецЕсли;
			
			// Замечания водителя
			ОтразитьЗамечанияВодителя(ТекущееСобытие, СуществующийФайлТитула, СведенияОПеревозке);
			
		КонецЕсли;
		
		// УДАЛИТЬ КОГДА ПОЧИНЯТ: https://edo-yt.skbkontur.ru/issue/KL-1347/Ne-menyat-UID-pri-redaktirovanii-chernovika-v-vebe
		// При редактировании черновика меняется УИД, а мы его при этом не меняем, так как у нас он уже есть.
		Если ЗначениеЗаполнено(СуществующийФайлТитула)
			И СуществующийФайлТитула.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			И ЗначениеЗаполнено(СведенияОПеревозке.ЧерновикТитул1) Тогда
			
			ОбновитьУИДЭТрНИзФайла(СуществующийФайлТитула);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(draftId) Тогда 
		// при этом не заполнен titleId ! Т.Е. это черновик по которому в этой порции данных еще нет титула!
		// дискуссионный вопрос - надо ли загружать черновик, если уже есть соответтсвующий титул. сейчас принято решение НЕ загружать такой черновик.
		
		СуществующийФайлЧерновика = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиПоРеквизиту("kl_draftId", draftId);
		
		Если Не ЗначениеЗаполнено(СуществующийФайлЧерновика) Тогда
			
			СуществующийФайлЧерновика = СохранитьТитулВСправочник(transportationId, ПараметрыСервисаЛогистика, ТекущееСобытие, СведенияОПеревозке);
			
		Иначе
			
			Если СведенияОПеревозке.ТестовыйДокумент И Не СуществующийФайлЧерновика.ТестовыйДокумент Тогда
				СуществующийФайлТитулаОбъект = СуществующийФайлЧерновика.ПолучитьОбъект();
				СуществующийФайлТитулаОбъект.ТестовыйДокумент = СведенияОПеревозке.ТестовыйДокумент;
				СуществующийФайлТитулаОбъект.Записать();
			КонецЕсли;
			
			ДобавитьСтатусВФайл(СуществующийФайлЧерновика, ТекущееСобытие.Дата, ТекущееСобытие.newStatus, ТекущееСобытие.id);
			
		КонецЕсли;
		
		// Замечания водителя
		ОтразитьЗамечанияВодителя(ТекущееСобытие, СуществующийФайлЧерновика, СведенияОПеревозке);
		
		ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
			СуществующийФайлЧерновика, ТекущееСобытие.id, Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика);
		
		СинхронизироватьСтатусЧерновика(transportationId, ТекущееСобытие.newStatus, ТекущееСобытие.Дата, ДопДанные)
		
	Иначе // не до конца понятный случай, технически ошибка. возможны либо титулы либо черновики
		
		ВызватьИсключение "При обработке события ленты " + ТекущееСобытие.id + "организации ДД: " + НашаОрганизацияСсылка + " получен не титул и не черновик" ;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтатусВФайл(Знач ФайлСсылка, Знач ДатаМСКСобытия, Знач newStatus, Знач EventId)
	
	Если Не ЗначениеЗаполнено(newStatus) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = ФайлСсылка.ПолучитьОбъект();
	ЗаписьСтатуса = Файл.CustomData.Добавить();
	ЗаписьСтатуса.ДатаВремяМСКПолучения = ДатаМСКСобытия;
	ЗаписьСтатуса.Key = "kl-newStatus";
	ЗаписьСтатуса.Value = newStatus;
	ЗаписьСтатуса.EventId = EventId;
	Файл.Записать();
	
	// здесь также требуется понять, изменился ли в связи получением нового статуса файла статус титула на требует обработки или получен
	Если newStatus = "WaybillReceptionWaitConsignorSignature"
		ИЛИ newStatus = "WaybillReceptionWaitCarrierSignature"
		ИЛИ newStatus = "WaybillDeliveryWaitConsigneeSignature"
		ИЛИ newStatus = "WaybillDeliveryWaitCarrierSignature"
		ИЛИ newStatus = "WaitConsignorCostSignature" Тогда
		
		НастройкаКонвертации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ФайлСсылка.ТипДокумента);
		Если ЗначениеЗаполнено(НастройкаКонвертации) И Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.НужнаОбработка(НастройкаКонвертации) Тогда
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ФайлСсылка.СвязанныйДокумент, Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки);
		Иначе
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ФайлСсылка.СвязанныйДокумент, Перечисления.КонтурЛогистика_СтатусыТитулов.Получен);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Сохраняет титул или черновик (draft) в справочник файлов
Функция СохранитьТитулВСправочник(Знач transportationId, Знач ПараметрыСервисаЛогистика, Знач ТекущееСобытие, Знач СведенияОПеревозке, ПерезаполнятьСуществующий = Ложь)
	
	titleId = ТекущееСобытие.ИдентификаторДокумента;
	draftId  = ТекущееСобытие.draftId;
	
	// https://developer.kontur.ru/doc/logistics.api/method?type=get&path=%2Fv1%2Ftransportations%2F%7Bid%7D - передаем или titleId или draftId 
	Если ЗначениеЗаполнено(titleId) Тогда
		ЭтоЧерновик = Ложь;
		EntityId = titleId;
	ИначеЕсли ЗначениеЗаполнено(draftId) Тогда
		ЭтоЧерновик = Истина;
		EntityId = draftId;
	Иначе
		ВызватьИсключение "Отсутствует и titleId и draftId у перевозки transportationId";
	КонецЕсли;
	
	Попытка
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТекущееСобытие.ТипДокумента) Тогда
			ДвоичныеДанныеКонтейнераЛогистики = КонтурЛогистика_API_Логистика.ПолучитьФайлыТитулаЭТрН(
				ПараметрыСервисаЛогистика, transportationId, EntityId);
		Иначе
			ДвоичныеДанныеКонтейнераЛогистики = КонтурЛогистика_API_Логистика.ПолучитьФайлыТитулаЭПЛ(
				ПараметрыСервисаЛогистика, transportationId, EntityId);
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = "Не удалось получить контейнер перевозки " + transportationId + ", "
			+ ?(ЗначениеЗаполнено(titleId), "титула ", "черновика ") + ТекущееСобытие.ИдентификаторДокумента + ".
			|Текст ошибки: " + ОписаниеОшибки();
		
		Если ЭтоЧерновик = Истина 
			И (Найти(ТекстОшибки, "Object reference not set to an instance of an object") > 0
				Или Найти(ТекстОшибки, "DocumentService.TransportationTitleCannotBeFound") > 0) Тогда
			
			Возврат Неопределено; // черновики могут уже быть удалены на стороне сервиса - такой draft просто пропускаем
		КонецЕсли;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	// Распаковать полученный архив во временный каталог
	КаталогАрхива = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор) + ПолучитьРазделительПути();
	// Возвращает имена файлов и двоичные данные.
	ДанныеКонтейнераЛогистики = ДанныеКонтейнераЛогистики(ДвоичныеДанныеКонтейнераЛогистики, КаталогАрхива);
	
	// Надо проверить что нет такого файла по имени файла
	ТекстФайлаXML = ПолучитьСтрокуИзДвоичныхДанных(ДанныеКонтейнераЛогистики.ТитулДвоичныеДанные, "windows-1251");
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайлаXML);
	FileNameБезxml = СтрЗаменить(XDTO.ИдФайл, ".xml","");
	
	Если ЭтоЧерновик Тогда
		// Нет готового имени файла
		НайденныйФайл = Неопределено;
	Иначе
		НайденныйФайл = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоИмениФайла(FileNameБезxml);
	КонецЕсли;
	НовыйФайл = Неопределено;
	
	Если ЗначениеЗаполнено(НайденныйФайл) И Не ПерезаполнятьСуществующий Тогда
		
		Если СведенияОПеревозке <> Неопределено И СведенияОПеревозке.ТестовыйДокумент И Не НайденныйФайл.ТестовыйДокумент Тогда
			НайденныйФайлОбъект = НайденныйФайл.ПолучитьОбъект();
			НайденныйФайлОбъект.ТестовыйДокумент = СведенияОПеревозке.ТестовыйДокумент;
			НайденныйФайлОбъект.Записать();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НайденныйФайл.kl_titleId) И ЗначениеЗаполнено(titleId) Тогда
			НайденныйФайлОбъект = НайденныйФайл.ПолучитьОбъект();
			НайденныйФайлОбъект.kl_titleId = titleId;
			НайденныйФайлОбъект.Записать();
		КонецЕсли;
		
		ДобавитьСтатусВФайл(НайденныйФайл, ТекущееСобытие.Дата, ТекущееСобытие.newStatus, ТекущееСобытие.id);
		
		Если ЗначениеЗаполнено(НайденныйФайл.ГлавныйДокумент) И ЗначениеЗаполнено(ТекущееСобытие.newStatus) Тогда // сразу отразим в регистр 
			
			// Заглушка если приходит статус completed после отказа, то он его закрывает и не видно в списках задач
			// что надо переотправить, просто не фиксируем такой статус
			ЗафиксироватьНовыйСтутус = Истина;
			Если НРег(ТекущееСобытие.newStatus) = "completed" Тогда
				СтатусОтказВПодписи = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НайтиСостояниеДОПоКоду("c-rejected");
				ТекущийСтатусДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(
					НайденныйФайл.ГлавныйДокумент);
				Если СтатусОтказВПодписи = ТекущийСтатусДО Тогда
					ЗафиксироватьНовыйСтутус = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗафиксироватьНовыйСтутус И ЗначениеЗаполнено(ТекущееСобытие.newStatus) Тогда
				Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоАнглНаименованиюСостояниюСервиса(
					ТекущееСобытие.newStatus);
				ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
					НайденныйФайл, ТекущееСобытие.id, Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика);
				РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
					НайденныйФайл.ГлавныйДокумент, Состояние, ТекущееСобытие.Дата,,, ДопДанные);
			КонецЕсли;
			
		КонецЕсли;
		
		// Замечания водителя
		ОтразитьЗамечанияВодителя(ТекущееСобытие, НайденныйФайл, СведенияОПеревозке);
		
	Иначе
		
		ТипИсходногоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПредыдущийТипДокумента(ТекущееСобытие.ТипДокумента);
		
		Если ЗначениеЗаполнено(НайденныйФайл) Тогда
			НовыйФайл = НайденныйФайл.ПолучитьОбъект();
		Иначе
			НовыйФайл = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьЭлемент();
		КонецЕсли;
		
		НовыйФайл.ТекстXML = Новый ХранилищеЗначения(ТекстФайлаXML, Новый СжатиеДанных(9));
		НовыйФайл.ВерсияФормата   = XDTO.ВерсФорм;
		НовыйФайл.ВерсияПрограммы = XDTO.ВерсПрог;
		НовыйФайл.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
		
		НовыйФайл.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(
			ДанныеКонтейнераЛогистики.ИмяФайлаТитула, ТипИсходногоДокумента, НовыйФайл.ВерсияФормата);
		
		НовыйФайл.ДатаВремяФормирования = КонтурЛогистика_КонструкторыXDTO.КонвертироватьДатаВремяФормированияИзXDTOФайл(
			XDTO, НовыйФайл.ТипДокумента);
		
		НовыйФайл.kl_id = transportationId;
		НовыйФайл.kl_titleId = titleId;
		НовыйФайл.kl_draftId = draftId;
		НовыйФайл.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен;
		
		Если ЭтоЧерновик Тогда
			FileNameБезxml = XDTO.ИдФайл;
		КонецЕсли;
		НовыйФайл.ИмяФайла = FileNameБезxml;
		НовыйФайл.GUID = Прав(СокрЛП(FileNameБезxml), 36);
		
		СтруктураОтправительПолучатель = Справочники.КонтурЛогистика_ФайлыОбмена.ОтправительИПолучательПоFileName(FileNameБезxml, НовыйФайл.ВерсияФормата);
		НовыйФайл.Отправитель = СтруктураОтправительПолучатель.Отправитель;
		НовыйФайл.Получатель = СтруктураОтправительПолучатель.Получатель;
		
		НовыйФайл.Подпись = Новый ХранилищеЗначения(ДанныеКонтейнераЛогистики.ПодписьДвоичныеДанные);
		Если ЭтоЧерновик Тогда
			НовыйФайл.ПодписьВерна = Ложь;
		КонецЕсли;
		
		Если Не ПерезаполнятьСуществующий И ЗначениеЗаполнено(ТекущееСобытие.newStatus) Тогда
			ЗаписьСтатуса = НовыйФайл.CustomData.Добавить();
			ЗаписьСтатуса.ДатаВремяМСКПолучения = ТекущееСобытие.Дата;
			ЗаписьСтатуса.Key = "kl-newStatus";
			ЗаписьСтатуса.Value = ТекущееСобытие.newStatus;
		КонецЕсли;
		
		Если СведенияОПеревозке <> Неопределено Тогда
			НовыйФайл.ТестовыйДокумент = СведенияОПеревозке.ТестовыйДокумент;
		КонецЕсли;
		
		НовыйФайл.Записать();
		
		// Замечания водителя
		ОтразитьЗамечанияВодителя(ТекущееСобытие, НовыйФайл.Ссылка, СведенияОПеревозке);
		
	КонецЕсли;
	
	// Удалить
	УдалитьФайлы(КаталогАрхива);
	
	Если ЗначениеЗаполнено(НайденныйФайл) Тогда
		ТекущийФайл = НайденныйФайл;
	ИначеЕсли НовыйФайл <> Неопределено Тогда
		Попытка
			ТекущийФайл = НовыйФайл.Ссылка;
		Исключение
			ТекущийФайл = Неопределено;
		КонецПопытки;
	Иначе
		ТекущийФайл = Неопределено;
	КонецЕсли;
	
	Возврат ТекущийФайл;
	
КонецФункции

Процедура ОбновитьУИДЭТрНИзФайла(ТекущийФайл)
	
	Попытка
		
		Если ЗначениеЗаполнено(ТекущийФайл.ГлавныйДокумент) Тогда
			ГлавныйДокумент = ТекущийФайл.ГлавныйДокумент;
		Иначе
			ГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлу(ТекущийФайл);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда
			XDTOФайла = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекущийФайл.ТекстXML.Получить());
			УИДИзФайла = КонтурЛогистика_КонструкторыXDTO.XDTO_ПолучитьЗначениеСвойства(XDTOФайла.Документ.СодИнфГО, "УИД_ТрН");
			Если ЗначениеЗаполнено(УИДИзФайла) И ГлавныйДокумент.УИД <> УИДИзФайла Тогда
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.УИД = УИДИзФайла;
				ГлавныйДокументОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		// Ничего не делаем
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтразитьЗамечанияВодителя(ТекущееСобытие, ФайлТитула, СведенияОПеревозке)
	
	Если ТекущееСобытие.ЕстьЗамечанияВодителя Тогда
		
		Если ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			ЗамечанияВодителя = СведенияОПеревозке.ЗамечанияВодителяПогрузка;
		ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			ЗамечанияВодителя = СведенияОПеревозке.ЗамечанияВодителяРазгрузка;
		КонецЕсли;
		
		Если ЗамечанияВодителя = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СледующийТипДокумента(ТекущееСобытие.ТипДокумента);
		
		Если ЗначениеЗаполнено(ФайлТитула.ГлавныйДокумент) Тогда
			
			// Есть куда записать замечания водителя
			КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьЗамечанияВодителяЛогистика(ФайлТитула, ЗамечанияВодителя, ТипТитула);
			
		ИначеЕсли ЗамечанияВодителя.ЕстьЗамечания
			И ЗначениеЗаполнено(ЗамечанияВодителя.ПредставлениеЗамечанийВодителя) Тогда
			
			// Некуда записать замечания, укажем в OuterDocflows
			ФайлТитулаОбъект = ФайлТитула.ПолучитьОбъект();
			
			ЗамечанияВодителяJSON = КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(ЗамечанияВодителя);
			
			НоваяЗапись = ФайлТитулаОбъект.OuterDocflows.Добавить();
			НоваяЗапись.DocflowNamedId = "kl-driverResolution";
			НоваяЗапись.Текст = Новый ХранилищеЗначения(ЗамечанияВодителяJSON);
			НоваяЗапись.ДатаСобытия = ТекущееСобытие.Дата;
			
			ФайлТитулаОбъект.Записать();
			
		КонецЕсли;
		
	ИначеЕсли ТекущееСобытие.ВидДействия = "ApprovedByDriver" Тогда
		
		// Очистим замечания, так как при было повторное согласование водителя и больше нет замечаний
		ЗамечанияВодителя = КонтурЛогистика_Уведомления.НовоеЗамечаниеВодителя();
		
		ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СледующийТипДокумента(ТекущееСобытие.ТипДокумента);
		
		КонтурЛогистика_ОбработкаДокументовСервер.УдалитьЗамечанияВодителяЛогистика(ФайлТитула, ЗамечанияВодителя, ТипТитула);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьСтатусЧерновика(transportationId, newStatus, ДатаМСКСобытия, ДопДанные)
	
	НайденныйДокументЭТРН = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НайтиПоРеквизиту("kl_id", transportationId);
	
	Если Не ЗначениеЗаполнено(НайденныйДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоАнглНаименованиюСостояниюСервиса(newStatus);
	
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
		НайденныйДокументЭТРН, Состояние, ДатаМСКСобытия,,, ДопДанные);
	
КонецПроцедуры

Функция ДанныеКонтейнераЛогистики(ДвоичныеДанныеКонтейнераЛогистики, КаталогАрхива)
	
	Данные = Новый Структура;
	Данные.Вставить("ИмяФайлаТитула");
	Данные.Вставить("ИмяФайлаПодписи");
	Данные.Вставить("ТитулДвоичныеДанные");
	Данные.Вставить("ПодписьДвоичныеДанные");
	
	РазделительПути = ПолучитьРазделительПути();
	
	КаталогНазначения = "" + КаталогАрхива + "1";
	ИмяФайлаАрхива = КаталогАрхива + "1.zip";
	
	ДвоичныеДанныеКонтейнераЛогистики.Записать(ИмяФайлаАрхива);
	ЧтениеZIP = Новый ЧтениеZipФайла(ИмяФайлаАрхива);	
	ЧтениеZIP.ИзвлечьВсе(КаталогНазначения, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	
	Для Каждого ТекущийФайл Из ЧтениеZIP.Элементы Цикл
		
		ПутьРаспакованногоФайла = "" + КаталогНазначения + РазделительПути + ТекущийФайл.Имя;
		
		Файл = Новый Файл(ПутьРаспакованногоФайла);
		Если Файл.Существует() И Файл.ПолучитьТолькоЧтение() Тогда
			Файл.УстановитьТолькоЧтение(Ложь);
		КонецЕсли;
		Файл = Неопределено;
		
		Если ТекущийФайл.Расширение = "xml" Тогда		// Это титул
			
			Данные.ИмяФайлаТитула = ТекущийФайл.Имя;
			ДвоичныеДанныеТитула = Новый ДвоичныеДанные(ПутьРаспакованногоФайла);
			Данные.Вставить("ТитулДвоичныеДанные", ДвоичныеДанныеТитула);
			
		ИначеЕсли ТекущийФайл.Расширение = "p7s"
			Или ТекущийФайл.Расширение = "sgn" Тогда	// Это подпись
			
			Данные.ИмяФайлаПодписи = ТекущийФайл.Имя;
			ДвоичныеДанныеПодписи = Новый ДвоичныеДанные(ПутьРаспакованногоФайла);
			Данные.Вставить("ПодписьДвоичныеДанные", ДвоичныеДанныеПодписи);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеZIP.Закрыть();
	
	Возврат Данные;
	
КонецФункции

// Дополяем данными ленты по сведениям о перевозке
//
// Параметры:
//  ТекущееСобытие		 - Структура	 - см. НоваяЛентаСобытий.
//  СведенияОПеревозке	 - Структура	 - Сведения о перевозке из Логистики.
//
Процедура ДополнитьДанныеЛентыПоСведениямОПеревозке(ТекущееСобытие, СведенияОПеревозке)
	
	Если ЗначениеЗаполнено(ТекущееСобытие.ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Если ТекущееСобытие.ЭтоИсправление Тогда
			ТекущееСобытие.ИдентификаторДокумента = ТекущееСобытие.entityId;
		Иначе
			ТекущееСобытие.ИдентификаторДокумента = СведенияОПеревозке.ИдентификаторТитул1;
		КонецЕсли;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда
		
		ТекущееСобытие.ИдентификаторДокумента = СведенияОПеревозке.ИдентификаторТитул2;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		Если ТекущееСобытие.ЭтоИсправление Тогда
			ТекущееСобытие.ИдентификаторДокумента = ТекущееСобытие.entityId;
		Иначе
			ТекущееСобытие.ИдентификаторДокумента = СведенияОПеревозке.ИдентификаторТитул3;
		КонецЕсли;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		
		ТекущееСобытие.ИдентификаторДокумента = СведенияОПеревозке.ИдентификаторТитул4;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		
		ТекущееСобытие.ИдентификаторДокумента = ТекущееСобытие.entityId;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
		
		ТекущееСобытие.ИдентификаторДокумента = ТекущееСобытие.entityId;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
		
		ТекущееСобытие.ИдентификаторДокумента = СведенияОПеревозке.ИдентификаторТитул7;
		
	ИначеЕсли ТекущееСобытие.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
		
		ТекущееСобытие.ИдентификаторДокумента = СведенияОПеревозке.ИдентификаторТитул8;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ПоказанияТоплива

Процедура ОбработатьПоказанияТоплива(ТекущееСобытие, НашаОрганизацияСсылка)
	
	// См. НовоеПоказанияТоплива
	ПоказанияТоплива = ТекущееСобытие.ПоказанияТоплива;
	
	Показания = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "fuelReadings");
	Если ТипЗнч(Показания) <> Тип("Массив") Тогда
		Показания = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Показания);
	КонецЕсли;
	
	// Базовые значения
	kl_id = ТекущееСобытие.transportationId;
	ТипПоказаний = ТипПоказанийПоТипуСобытия(ТекущееСобытие.eventType);
	ИдентификаторСобытия = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "id");
	
	// Дата события
	ДатаСобытияСтрока = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "recordedAt.dateTime");
	СмещениеДатыСобытияСтрока = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "recordedAt.offset");
	ДатаИзСтроки = ДатаИзСтроки(ДатаСобытияСтрока) - СмещениеВСекундахИзСтроки(СмещениеДатыСобытияСтрока);
	ДатаСобытия = МестноеВремя(ДатаИзСтроки);
	
	// Автор
	АвторСобытия = АвторСобытия(ПоказанияТоплива);
	
	ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ;
	
	// Показания
	Для Каждого ТекущиеПоказания Из Показания Цикл
		
		ГорючеСмазочныйМатериал = ПолучитьГорючеСмазочныйМатериал(ТекущиеПоказания);
		КоличествоТоплива = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuelAmount");
		
		// Зафиксируем в регистре
		НаборЗаписей = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОрганизацияДиадок.Установить(НашаОрганизацияСсылка);
		НаборЗаписей.Отбор.ТипДанных.Установить(ТипДанных);
		НаборЗаписей.Отбор.Разрез1.Установить(kl_id);
		НаборЗаписей.Отбор.Разрез2.Установить(ТипПоказаний);
		НаборЗаписей.Отбор.Разрез3.Установить(ИдентификаторСобытия);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ОрганизацияДиадок = НашаОрганизацияСсылка;
		НоваяЗапись.ТипДанных = ТипДанных;
		НоваяЗапись.Разрез1 = kl_id;
		НоваяЗапись.Разрез2 = ТипПоказаний;
		НоваяЗапись.Разрез3 = ИдентификаторСобытия;
		
		НоваяЗапись.Количество = КоличествоТоплива;
		
		НоваяЗапись.Дата = ДатаСобытия;
		НоваяЗапись.Ответственный = АвторСобытия;
		НоваяЗапись.Реквизит1 = ГорючеСмазочныйМатериал;
		
		НоваяЗапись.СинхронизацияССервисом = Перечисления.КонтурЛогистика_СтатусыСинхронизации.УспешноЗавершена;
		НоваяЗапись.СинхронизацияСОбъектом1С = Перечисления.КонтурЛогистика_СтатусыСинхронизации.НеНачата;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОтправитьПоказанияТопливаВСервис(ПараметрыСервиса, ДанныеОтправки)
	
	eplId = ДанныеОтправки.Разрез1;
	Показания = НовоеПоказанияТоплива();
	Если КонтурЛогистика_СтдСтрКлиентСервер.ЭтоУникальныйИдентификаторЛок(ДанныеОтправки.Разрез3) Тогда
		Показания.id = ДанныеОтправки.Разрез3;
	Иначе
		Показания.id = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	// ПоказанияТоплива
	Если Не ЗначениеЗаполнено(ДанныеОтправки.Реквизит1ТипТоплива) Тогда
		ВызватьИсключение "Тип топлива не заполнен";
	КонецЕсли;
	Показания.fuelReadings.fuel.type = Перечисления.КонтурЛогистика_ТипыТоплива.СтрокаПоЗначению(ДанныеОтправки.Реквизит1ТипТоплива);
	Если ДанныеОтправки.Реквизит1ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas Тогда
		Показания.fuelReadings.fuel.Вставить("compressedNaturalGasName",
			Перечисления.КонтурЛогистика_ВидыТоплива.СтрокаПоЗначению(ДанныеОтправки.Реквизит1ВидТоплива));
	ИначеЕсли ДанныеОтправки.Реквизит1ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Diesel Тогда
		Показания.fuelReadings.fuel.Вставить("dieselName",
			Перечисления.КонтурЛогистика_ВидыТоплива.СтрокаПоЗначению(ДанныеОтправки.Реквизит1ВидТоплива));
	ИначеЕсли ДанныеОтправки.Реквизит1ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline Тогда
		Показания.fuelReadings.fuel.Вставить("gasolineName",
			Перечисления.КонтурЛогистика_ВидыТоплива.СтрокаПоЗначению(ДанныеОтправки.Реквизит1ВидТоплива));
	ИначеЕсли ДанныеОтправки.Реквизит1ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Other Тогда
		Показания.fuelReadings.fuel.Вставить("fuelTypeName", ДанныеОтправки.Реквизит1ВидТопливаПрочее);
		Показания.fuelReadings.fuel.Вставить("unitOfMeasurement", ДанныеОтправки.Реквизит1ЕдиницаИзмерения);
	КонецЕсли;
	Если ДанныеОтправки.Реквизит1ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other Тогда
		Показания.fuelReadings.fuel.Вставить("otherName", ДанныеОтправки.Реквизит1ВидТопливаПрочее);
	КонецЕсли;
	Показания.fuelReadings.fuelAmount = ДанныеОтправки.Количество;
	
	// ДатаИВремяЗаписи
	// "dateTime": "2025-05-01T19:35:00"
	// "offset": "05:00:00"
	Если Не ЗначениеЗаполнено(ДанныеОтправки.Дата) Тогда
		ВызватьИсключение "Дата не заполнена";
	КонецЕсли;
	Показания.recordedAt.dateTime = Формат(ДанныеОтправки.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
	УниверсальнаяДата = УниверсальноеВремя(ДанныеОтправки.Дата);
	Показания.recordedAt.offset = СмещениеСтрокойИзСекунд(ДанныеОтправки.Дата - УниверсальнаяДата);
	
	// Ответственный
	Если Не ЗначениеЗаполнено(ДанныеОтправки.ОтветственныйИмя) Тогда
		ВызватьИсключение "Имя ответственного не заполнено";
	КонецЕсли;
	Показания.recordedBy.fio.firstName = ДанныеОтправки.ОтветственныйФамилия;
	Если Не ЗначениеЗаполнено(ДанныеОтправки.ОтветственныйФамилия) Тогда
		ВызватьИсключение "Фамилия ответственного не заполнено";
	КонецЕсли;
	Показания.recordedBy.fio.lastName = ДанныеОтправки.ОтветственныйФамилия;
	Если ЗначениеЗаполнено(ДанныеОтправки.ОтветственныйОтчество) Тогда
		Показания.recordedBy.fio.middleName = ДанныеОтправки.ОтветственныйОтчество;
	Иначе
		Показания.recordedBy.fio.Удалить("middleName");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОтправки.ОтветственныйДолжность) Тогда
		Показания.recordedBy.jobTitle = ДанныеОтправки.ОтветственныйДолжность;
	Иначе
		Показания.recordedBy.jobTitle = "Не указано";
	КонецЕсли;
	
	// Отправим в сервис
	Если ДанныеОтправки.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде Тогда
		
		Показания.Удалить("id");	// Только для заправки
		
		Результат = КонтурЛогистика_API_Логистика.СохраненитьПоказанияТопливаНаВыезде(ПараметрыСервиса, eplId, Показания, ДанныеОтправки.Дата);
		
	ИначеЕсли ДанныеОтправки.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.Заправка Тогда
		
		Результат = КонтурЛогистика_API_Логистика.СохраненитьИнформациюОЗаправке(ПараметрыСервиса, eplId, Показания);
		
	ИначеЕсли ДанныеОтправки.Разрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаЗаезде Тогда
		
		Показания.Удалить("id");	// Только для заправки
		
		Результат = КонтурЛогистика_API_Логистика.СохраненитьПоказанияТопливаНаЗаезде(ПараметрыСервиса, eplId, Показания);
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Описание сведений показаний топлива
// 
// Возвращаемое значение:
//  Структура - сведений по топливу.
//
Функция НовоеПоказанияТоплива()
	
	ИнформацияОТопливе = Новый Структура;
	
	//Type oneOf:
	//  Biodiesel
	//  CompressedNaturalGas
	//    compressedNaturalGasName: Propane, Methane, Other
	//    otherName - Обязательно, если compressedNaturalGasName имеет значение Other
	//  Diesel
	//    dieselName: MidSeason, Winter, ArcticDiesel, Other
	//    otherName - Обязательно, если dieselName имеет значение Other
	//  Electricity
	//  Gasoline
	//    gasolineName: AI80, AI92, AI95, AI98, Other
	//    otherName - Обязательно, если gasolineName имеет значение Other
	//  LiquefiedPetroleumGas
	//  Other
	//    fuelTypeName - Наименование вида топлива
	//    unitOfMeasurement - Единица измерения
	ИнформацияОТопливе.Вставить("type", "");
	
	ПоказанияТоплива = Новый Структура;
	ПоказанияТоплива.Вставить("fuel", ИнформацияОТопливе);
	ПоказанияТоплива.Вставить("fuelAmount", 0);
	
	ДатаИВремяЗаписи = Новый Структура;
	ДатаИВремяЗаписи.Вставить("dateTime", "");
	ДатаИВремяЗаписи.Вставить("offset", "");	// Не обязательно
	
	ФИО = Новый Структура;
	ФИО.Вставить("firstName", "");
	ФИО.Вставить("lastName", "");
	ФИО.Вставить("middleName", "");	// Не обязательно
	
	Ответственный = Новый Структура;
	Ответственный.Вставить("fio", ФИО);
	Ответственный.Вставить("jobTitle", "");
	
	ПользовательскиеДанные = Новый Массив;
	// Пара key + value, тип строка
	
	Результат = Новый Структура;
	Результат.Вставить("id", "");	// При заправке обязателен, при выезде/заезде приходит в ответе
	Результат.Вставить("fuelReadings", ПоказанияТоплива);
	Результат.Вставить("recordedAt", ДатаИВремяЗаписи);
	Результат.Вставить("recordedBy", Ответственный);
	//Результат.Вставить("customData", ПользовательскиеДанные);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПоказанияТоплива(ТипСобытия)
	
	Если ТипСобытия = "PreTripFuelReadingsRecorded"				// Записаны показания топлива перед выездом
		Или ТипСобытия = "RefuelRecorded"						// Записана информация о заправке
		Или ТипСобытия = "PostTripFuelReadingsRecorded" Тогда	// Записаны показания топлива после возвращения
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьГорючеСмазочныйМатериал(ТекущиеПоказания)
	
	ТипТопливаСтрока = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.type");
	ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.ЗначениеПоСтроке(ТипТопливаСтрока);
	ВидТоплива = "";
	ВидТопливаПрочее = "";
	ЕдиницаИзмерения = "";
	
	Если ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Biodiesel Тогда
		
		ЕдиницаИзмерения = "л";
		
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.CompressedNaturalGas Тогда
		
		ВидТопливаСтрока = НРег(ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.compressedNaturalGasName"));
		Если ВидТопливаСтрока = "propane" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Propane;
		ИначеЕсли ВидТопливаСтрока = "methane" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Methane;
		Иначе
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other;
			ВидТопливаПрочее = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.otherName");
		КонецЕсли;
		
		ЕдиницаИзмерения = "куб. м СПГ";
		
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Diesel Тогда
		
		ВидТопливаСтрока = НРег(ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.dieselName"));
		Если ВидТопливаСтрока = "midseason" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.MidSeason;
		ИначеЕсли ВидТопливаСтрока = "winter" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Winter;
		ИначеЕсли ВидТопливаСтрока = "arcticdiesel" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.ArcticDiesel;
		Иначе
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other;
			ВидТопливаПрочее = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.otherName");
		КонецЕсли;
		
		ЕдиницаИзмерения = "л";
		
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Electricity Тогда
		
		ЕдиницаИзмерения = "кВт*ч";
		
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Gasoline Тогда
		
		ВидТопливаСтрока = НРег(ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.gasolineName"));
		Если ВидТопливаСтрока = "ai80" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.AI80;
		ИначеЕсли ВидТопливаСтрока = "ai92" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.AI92;
		ИначеЕсли ВидТопливаСтрока = "ai95" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.AI95;
		ИначеЕсли ВидТопливаСтрока = "ai98" Тогда
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.AI98;
		Иначе
			ВидТоплива = Перечисления.КонтурЛогистика_ВидыТоплива.Other;
			ВидТопливаПрочее = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.otherName");
		КонецЕсли;
		
		ЕдиницаИзмерения = "л";
		
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.LiquefiedPetroleumGas Тогда
		
		ЕдиницаИзмерения = "л СНГ";
		
	ИначеЕсли ТипТоплива = Перечисления.КонтурЛогистика_ТипыТоплива.Other Тогда
		
		ВидТопливаПрочее = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.fuelTypeName");
		ЕдиницаИзмерения = ЗначениеПоПутиИзДанныхСоответствий(ТекущиеПоказания, "fuel.unitOfMeasurement");
		
	КонецЕсли;
	
	ГСМ = Справочники.КонтурЛогистика_ГорючеСмазочныеМатериалы.ПолучитьГорючеСмазочныйМатериал(
		ТипТоплива, ВидТоплива, ВидТопливаПрочее, ЕдиницаИзмерения);
	
	Возврат ГСМ;
	
КонецФункции

Функция ТипПоказанийПоТипуСобытия(Знач ТипСобытия)
	
	Если НРег(ТипСобытия) = НРег("PreTripFuelReadingsRecorded") Тогда
		
		ТипПоказаний = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаВыезде;
		
	ИначеЕсли НРег(ТипСобытия) = НРег("RefuelRecorded") Тогда
		
		ТипПоказаний = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.Заправка;
		
	ИначеЕсли НРег(ТипСобытия) = НРег("PostTripFuelReadingsRecorded") Тогда
		
		ТипПоказаний = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.НаЗаезде;
		
	Иначе
		
		ТипПоказаний = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат ТипПоказаний;
	
КонецФункции

Функция АвторСобытия(ПоказанияТоплива)
	
	Имя = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "recordedBy.fio.firstName");
	Фамилия = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "recordedBy.fio.lastName");
	Отчество = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "recordedBy.fio.middleName");
	Должность = ЗначениеПоПутиИзДанныхСоответствий(ПоказанияТоплива, "recordedBy.jobTitle");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Фамилия", Фамилия);
	Запрос.УстановитьПараметр("Отчество", Отчество);
	Запрос.УстановитьПараметр("Должность", Должность);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
	|ГДЕ
	|	КонтурЛогистика_Сотрудники.Имя = &Имя
	|	И КонтурЛогистика_Сотрудники.Фамилия = &Фамилия
	|	И КонтурЛогистика_Сотрудники.Отчество = &Отчество
	|	И КонтурЛогистика_Сотрудники.Должность = &Должность
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_Сотрудники.Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
	|ГДЕ
	|	КонтурЛогистика_Сотрудники.Имя = &Имя
	|	И КонтурЛогистика_Сотрудники.Фамилия = &Фамилия
	|	И КонтурЛогистика_Сотрудники.Отчество = &Отчество";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_Сотрудники.ПустаяСсылка();
	
КонецФункции

