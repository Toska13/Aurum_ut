Функция СмещениеВСекундахИзСтроки(Знач СтрокаСмещения)
	
	СмещениеВСекундах = 0;
	ЕстьОтрицание = Ложь;
	
	Попытка
		
		Если Лев(СтрокаСмещения, 1) = "-" Тогда
			ЕстьОтрицание = Истина;
			СтрокаСмещения = СтрЗаменить(СтрокаСмещения, "-", "");
		КонецЕсли;
		
		Разделы = КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(СтрокаСмещения, ":", Ложь);
		
		Часы = Число(Разделы[0]);
		Минуты = Число(Разделы[1]);
		Секунды = Число(Разделы[2]);
		
		СекундВМинуте = 60;
		СекундВЧасе = 3600;
		
		СмещениеВСекундах = Часы * СекундВЧасе + Минуты * СекундВМинуте + Секунды;
		
	Исключение
		
		ТекстОшибки = "Не удалось разложить смещение времени: " + Строка(СтрокаСмещения);
		КонтурЛогистика_Метрика.ОбработатьОшибку("СмещениеВСекундахИзСтроки", ТекстОшибки);
		
	КонецПопытки;
	
	Если ЕстьОтрицание Тогда
		Возврат 0 - СмещениеВСекундах;
	Иначе
		Возврат СмещениеВСекундах;
	КонецЕсли;
	
КонецФункции

Функция СмещениеСтрокойИзСекунд(Знач СмещениеВСекундах)
	
	СмещениеСтрокой = "";
	ЕстьОтрицание = Ложь;
	
	Попытка
		
		ЕстьОтрицание = (СмещениеВСекундах < 0);
		
		Если ЕстьОтрицание Тогда
			ПоложительныеСекунды = -СмещениеВСекундах;
		Иначе
			ПоложительныеСекунды = СмещениеВСекундах;
		КонецЕсли;
		
		СекундВМинуте = 60;
		СекундВЧасе = 3600;
		
		Часы = Цел(ПоложительныеСекунды / СекундВЧасе);
		Минуты = Цел((ПоложительныеСекунды - Часы * СекундВЧасе) / СекундВМинуте);
		Секунды = ПоложительныеСекунды - Часы * СекундВЧасе - Минуты * СекундВМинуте;
		
		СмещениеСтрокой = Формат(Часы, "ЧЦ=2; ЧН=00; ЧВН=")
			+ ":" + Формат(Минуты, "ЧЦ=2; ЧН=00; ЧВН=")
			+ ":" + Формат(Секунды, "ЧЦ=2; ЧН=00; ЧВН=");
		
	Исключение
		
		ТекстОшибки = "Не удалось разложить смещение времени: " + Строка(СмещениеВСекундах);
		КонтурЛогистика_Метрика.ОбработатьОшибку("СмещениеСтрокойИзСекунд", ТекстОшибки);
		
	КонецПопытки;
	
	Если ЕстьОтрицание Тогда
		Возврат "-" + СмещениеСтрокой;
	Иначе
		Возврат СмещениеСтрокой;
	КонецЕсли;
	
КонецФункции

#КонецОбласти