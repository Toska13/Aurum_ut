
#Область ПрограммныйИнтерфейс

#Область Высокоуровневые

// Отправляет готовый титул транспортной накладной с подписью или без нее 
//
// Параметры:
//  ПараметрыСервиса - Структура - Структура, содержащая параметры сервиса. Например, ApiKey 
//  Файлы        	 - Массив    - Массив, подготовленный файлов  
// 
// Возвращаемое значение:
// 	Результат - содержит kl-id созданной ТрН 
//
Функция ОтправитьТитулТрНИзФайла(Знач ФайлСсылка) Экспорт 
	
	ДанныеФайла = КонтурЛогистика_API_Логистика.МанифестФайловДляПодготовки();
	
	ДанныеФайла.ИмяФайла = ФайлСсылка.ИмяФайла;
	ДанныеФайла.ТипДокумента = ФайлСсылка.ТипДокумента;
	ДанныеФайла.Титул = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлСсылка);
	
	Если ФайлСсылка.ПодписьВерна И ФайлСсылка.ТребуетсяПодпись Тогда
		ДанныеФайла.Подпись = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеПодписиФайла(ФайлСсылка);
	КонецЕсли;
	
	// Отправим черновик
	Если ТипЗнч(ФайлСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
		И ЗначениеЗаполнено(ФайлСсылка.Составитель)
		И ФайлСсылка.Составитель <> ФайлСсылка.ГлавныйДокумент.Грузоотправитель Тогда
		
		ДанныеФайла.Подпись = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФайлСсылка.Составитель) Тогда
		ОрганизацияВыполняющаяЗапросВСервис = ФайлСсылка.Составитель;
	Иначе
		ОрганизацияВыполняющаяЗапросВСервис = ФайлСсылка.Отправитель;
	КонецЕсли;
	
	Попытка
		
		ПодготовленныеФайлы = КонтурЛогистика_API_Логистика.ПодготовитьФайлы(ДанныеФайла);
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияВыполняющаяЗапросВСервис);
		
		kl_id = Неопределено; // пустой - не привязывается к конкретной трн
		Если ЗначениеЗаполнено(ФайлСсылка.kl_id) Тогда
			kl_id = ФайлСсылка.kl_id;
		ИначеЕсли ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) И ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент.kl_id) Тогда 
			kl_id = ФайлСсылка.ГлавныйДокумент.kl_id;
		КонецЕсли;
		
		// Пока апи логистики поддерживает отправку неподписанных только для Т1 и Т3
		Если Не ЗначениеЗаполнено(ДанныеФайла.Подпись)
			И (ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
				Или ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3) Тогда
			
			draftAction = Неопределено;
			
			Если ФайлСсылка.ПередатьНаПодписание Тогда
				draftAction = "ApprovedForSignature";
			ИначеЕсли ФайлСсылка.ПередатьНаСогласованиеВодителю Тогда
				draftAction = "PassedForDriverApproval";
			КонецЕсли;
			
			РезультатОтправки = КонтурЛогистика_API_Логистика.ОтправитьНеподписанныйТитулТрН(
				ПараметрыСервиса, ПодготовленныеФайлы, kl_id, draftAction);
			
		Иначе
			
			РезультатОтправки = КонтурЛогистика_API_Логистика.ОтправитьТитулТрН(
				ПараметрыСервиса, ПодготовленныеФайлы, kl_id);
			
		КонецЕсли;
		
	Исключение
		
		РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
		РезультатОтправки.Успешно = Ложь;
		РезультатОтправки.ОписаниеОшибки = ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат РезультатОтправки;
	
КонецФункции	

// Отправляет готовый титул путевого листа с подписью
//
// Параметры:
//  Файлы     - Массив    - Массив, подготовленный файлов
// 
// Возвращаемое значение:
//  Результат - см. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция ОтправитьТитулПутевогоЛистаИзФайла(Знач ФайлСсылка) Экспорт
	
	ДанныеФайла = КонтурЛогистика_API_Логистика.МанифестФайловДляПодготовки();
	
	ДанныеФайла.ИмяФайла = ФайлСсылка.ИмяФайла;
	ДанныеФайла.ТипДокумента = ФайлСсылка.ТипДокумента;
	ДанныеФайла.Титул = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеКонтентаФайла(ФайлСсылка);
	
	Если ФайлСсылка.ПодписьВерна И ФайлСсылка.ТребуетсяПодпись Тогда
		ДанныеФайла.Подпись = КонтурЛогистика_API_Диадок.СформироватьДвоичныеДанныеПодписиФайла(ФайлСсылка);
	КонецЕсли;
	
	Попытка
		
		ПодготовленныеФайлы = КонтурЛогистика_API_Логистика.ПодготовитьФайлы(ДанныеФайла);
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ФайлСсылка.Отправитель);
		
		kl_id = Неопределено;
		Если ЗначениеЗаполнено(ФайлСсылка.kl_id) Тогда
			kl_id = ФайлСсылка.kl_id;
		ИначеЕсли ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) И ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент.kl_id) Тогда
			// Для смены водителя не надо указывать kl_id
			Если Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ФайлСсылка.ТипДокумента) 
				И Не ФайлСсылка.ГлавныйДокумент.ЭтоСменаВодителя Тогда
				kl_id = ФайлСсылка.ГлавныйДокумент.kl_id;
			КонецЕсли;
		КонецЕсли;
		
		РезультатОтправки = КонтурЛогистика_API_Логистика.ОтправитьТитулПутевогоЛиста(ПараметрыСервиса, ПодготовленныеФайлы, kl_id);
		
	Исключение
		
		РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
		РезультатОтправки.Успешно = Ложь;
		РезультатОтправки.ОписаниеОшибки = ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат РезультатОтправки;
	
КонецФункции

// Отправляет произволные данные из РС в сервис
//
// Параметры:
//  ОтборДанных	 - Структура	 - отбор измерений, если необходимо отправить только конкретные записи
//
Процедура ОтправитьПроизволныеДанные(ОтборДанных = Неопределено) Экспорт
	
	ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ;
	
	Запрос = Новый Запрос;
	
	Если ОтборДанных = Неопределено Тогда
		Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
		Запрос.УстановитьПараметр("ОрганизацияДиадок", Неопределено);
		Запрос.УстановитьПараметр("Разрез1", Неопределено);
		Запрос.УстановитьПараметр("Разрез2", Неопределено);
		
		Запрос.УстановитьПараметр("ОтборОрганизацияДиадок", Ложь);
		Запрос.УстановитьПараметр("ОтборРазрез1", Ложь);
		Запрос.УстановитьПараметр("ОтборРазрез2", Ложь);
	Иначе
		Запрос.УстановитьПараметр("ТипДанных", ОтборДанных.ТипДанных);
		Запрос.УстановитьПараметр("ОрганизацияДиадок", ОтборДанных.ОрганизацияДиадок);
		Запрос.УстановитьПараметр("Разрез1", ОтборДанных.Разрез1);
		Запрос.УстановитьПараметр("Разрез2", ОтборДанных.Разрез2);
		
		Запрос.УстановитьПараметр("ОтборОрганизацияДиадок", ЗначениеЗаполнено(ОтборДанных.ОрганизацияДиадок));
		Запрос.УстановитьПараметр("ОтборРазрез1", ЗначениеЗаполнено(ОтборДанных.Разрез1));
		Запрос.УстановитьПараметр("ОтборРазрез2", ЗначениеЗаполнено(ОтборДанных.Разрез2));
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок КАК ОрганизацияДиадок,
	|	КонтурЛогистика_ПроизвольныеДанные.ТипДанных КАК ТипДанных,
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез1 КАК Разрез1,
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез2 КАК Разрез2,
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез3 КАК Разрез3,
	|	КонтурЛогистика_ПроизвольныеДанные.Количество КАК Количество,
	|	КонтурЛогистика_ПроизвольныеДанные.Дата КАК Дата,
	|	КонтурЛогистика_ПроизвольныеДанные.Ответственный КАК Ответственный,
	|	КонтурЛогистика_ПроизвольныеДанные.Ответственный.Имя КАК ОтветственныйИмя,
	|	КонтурЛогистика_ПроизвольныеДанные.Ответственный.Фамилия КАК ОтветственныйФамилия,
	|	КонтурЛогистика_ПроизвольныеДанные.Ответственный.Отчество КАК ОтветственныйОтчество,
	|	КонтурЛогистика_ПроизвольныеДанные.Ответственный.Должность КАК ОтветственныйДолжность,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1 КАК Реквизит1,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1.ТипТоплива КАК Реквизит1ТипТоплива,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1.ВидТоплива КАК Реквизит1ВидТоплива,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1.ВидТопливаПрочее КАК Реквизит1ВидТопливаПрочее,
	|	КонтурЛогистика_ПроизвольныеДанные.Реквизит1.ЕдиницаИзмерения КАК Реквизит1ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.СинхронизацияССервисом = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыСинхронизации.НеНачата)
	|	И КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных
	|	И (&ОтборОрганизацияДиадок
	|				И КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок = &ОрганизацияДиадок
	|			ИЛИ НЕ &ОтборОрганизацияДиадок)
	|	И (&ОтборРазрез1
	|				И КонтурЛогистика_ПроизвольныеДанные.Разрез1 = &Разрез1
	|			ИЛИ НЕ &ОтборРазрез1)
	|	И (&ОтборРазрез2
	|				И КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &Разрез2
	|			ИЛИ НЕ &ОтборРазрез2)
	|ИТОГИ ПО
	|	ОрганизацияДиадок";
	
	ВыборкаОрганизация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ВыборкаОрганизация.ОрганизацияДиадок) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(
			ВыборкаОрганизация.ОрганизацияДиадок);
		
		Если Не ЗначениеЗаполнено(ПараметрыСервисаЛогистика.ApiKey) Тогда
			
			// Проставим признак ошибка и заполним причину
			ТекстОшибки = "Не указан API Key для организации: " + Строка(ВыборкаОрганизация.ОрганизацияДиадок);
			
			Выборка = ВыборкаОрганизация.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Попытка
					РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ОбновитьСтатусыСинхронизации(
						Выборка, Перечисления.КонтурЛогистика_СтатусыСинхронизации.Ошибка,, ТекстОшибки);
				Исключение
					КонтурЛогистика_Метрика.ОбработатьОшибку("ЛогистикаСервер.ОтправитьПроизволныеДанные",
						ИнформацияОбОшибке(), Выборка.Ссылка);
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			БлокировкаДанных = Новый БлокировкаДанных();
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.КонтурЛогистика_ПроизвольныеДанные");
			ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Разделяемый;
			ЭлементБлокировкиДанных.УстановитьЗначение("ОрганизацияДиадок", ВыборкаОрганизация.ОрганизацияДиадок);
			ЭлементБлокировкиДанных.УстановитьЗначение("ТипДанных", ТипДанных);
			БлокировкаДанных.Заблокировать();
			
			Выборка = ВыборкаОрганизация.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Статус = Перечисления.КонтурЛогистика_СтатусыСинхронизации.УспешноЗавершена;
				ТекстОшибки = "";
				
				Попытка
					
					Результат = ОтправитьПоказанияТопливаВСервис(ПараметрыСервисаЛогистика, Выборка);
					
				Исключение
					
					Статус = Перечисления.КонтурЛогистика_СтатусыСинхронизации.Ошибка;
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					
				КонецПопытки;
				
				Если Статус <> Перечисления.КонтурЛогистика_СтатусыСинхронизации.Ошибка
					И Результат = Неопределено Тогда
					
					Продолжить;
				КонецЕсли;
				
				РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ОбновитьСтатусыСинхронизации(
					Выборка, Статус,, ТекстОшибки);
				
				Если Статус <> Перечисления.КонтурЛогистика_СтатусыСинхронизации.Ошибка
					И Результат <> Неопределено
					И ТипЗнч(Результат) = Тип("Структура") Тогда
					
					Если Результат.Свойство("value")
						И Результат.value.Свойство("id") Тогда
						
						// Для выезда и заезда
						Разрез3 = Результат.value.id;
						
					ИначеЕсли Результат.Свойство("values")
						И Результат.values.Количество() <> 0 Тогда
						
						// Для заправок
						Для Каждого ТекущаяСтрокаОтвета Из Результат.values Цикл
							Если ТекущаяСтрокаОтвета.id = Выборка.Разрез3 Тогда
								Разрез3 = ТекущаяСтрокаОтвета.id;
								Прервать;
							КонецЕсли;
							
							Разрез3 = ТекущаяСтрокаОтвета.id;
						КонецЦикла;
						
					Иначе
						
						Продолжить;
						
					КонецЕсли;
					
					// Зафиксируем полученный идентификатор записи
					Если Выборка.Разрез3 <> Разрез3 Тогда
						РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ИзменитьРазрез3Записи(
							Выборка, Выборка.Разрез3, Разрез3);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Отправляет произволные данные из РС: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьВсеЛентыСобытий() Экспорт
	
	// В 1 потоке, последовательно. Пока нет оснований делать многопоточно
	Результат = Истина;
	
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	АвторизацияПоТокену = (РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("АвторизацияПоТокену", АвторизацияПоТокену);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ НашиОрганизацииСКлючемАПИЛогистики
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|		ПО КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок = КонтурЛогистика_ОрганизацииДиадок.Ссылка
	|ГДЕ
	|	НЕ &АвторизацияПоТокену
	|	И НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш
	|	И КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey)
	|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки <> НЕОПРЕДЕЛЕНО
	|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НашиОрганизацииСКлючемАПИЛогистики.Ссылка КАК Ссылка
	|ИЗ
	|	НашиОрганизацииСКлючемАПИЛогистики КАК НашиОрганизацииСКлючемАПИЛогистики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
	|		ПО НашиОрганизацииСКлючемАПИЛогистики.Ссылка = КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок
	|ГДЕ
	|	КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики)
	|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки = ИСТИНА
	|	И НЕ &АвторизацияПоТокену
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_Аутентификация КАК КонтурЛогистика_Аутентификация
	|		ПО КонтурЛогистика_ОрганизацииДиадок.Ссылка = КонтурЛогистика_Аутентификация.Организация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
	|		ПО КонтурЛогистика_ОрганизацииДиадок.Ссылка = КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок
	|ГДЕ
	|	&АвторизацияПоТокену
	|	И НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш
	|	И КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики)
	|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДоступныйФункционал = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьДоступныйФункционал(Выборка.Ссылка);
		
		Попытка
			
			Если ДоступныйФункционал.ТрН Тогда
				ОбработатьЛентуСобытийАпиЛогистика(Выборка.Ссылка, "ЭТрН");
			КонецЕсли;
			
		Исключение
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка при обработке Ленты ЭТрН организации " + Выборка.Ссылка + " по причине: " + ОписаниеОшибки();
			Сообщение.Сообщить();
			
			Результат = Ложь;
			
			КонтурЛогистика_Метрика.ОбработатьОшибку("ЛогистикаСервер.ОбработатьВсеЛентыСобытий", ИнформацияОбОшибке(), Выборка.Ссылка);
			
		КонецПопытки;
		
		Попытка
			
			Если ДоступныйФункционал.ПЛ Тогда
				ОбработатьЛентуСобытийАпиЛогистика(Выборка.Ссылка, "ЭПЛ");
			КонецЕсли;
			
		Исключение
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка при обработке Ленты ЭПЛ организации " + Выборка.Ссылка + " по причине: " + ОписаниеОшибки();
			Сообщение.Сообщить();
			
			Результат = Ложь;
			
			КонтурЛогистика_Метрика.ОбработатьОшибку("ЛогистикаСервер.ОбработатьВсеЛентыСобытий", ИнформацияОбОшибке(), Выборка.Ссылка);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьЛентуСобытийАпиЛогистика(НашаОрганизацияСсылка, ЧитатьЛенту) Экспорт
	
	СобытийВЛенте = 1;
	ПеречисленияАктуальностиЛентыСобытий = ПеречисленияАктуальностиЛентыСобытий(ЧитатьЛенту);
	
	Пока СобытийВЛенте > 0 Цикл 
		
		ЛентаСобытийНормализованная = ПрочитатьНормализованнуюЛентуСобытийОрганизации(НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий);
		СобытийВЛенте = ЛентаСобытийНормализованная.Количество();
		
		Если СобытийВЛенте > 0 Тогда
			
			Если ЧитатьЛенту = "ЭТрН" Тогда
				СведенияОПеревозках = СведенияОПеревозках(ЛентаСобытийНормализованная, НашаОрганизацияСсылка);
			Иначе
				СведенияОПеревозках = СведенияОПутевомЛисте(ЛентаСобытийНормализованная, НашаОрганизацияСсылка);
			КонецЕсли;
			
			Для Каждого ТекущееСобытие Из ЛентаСобытийНормализованная Цикл
				ОбработатьСобытиеЛенты(ТекущееСобытие, СведенияОПеревозках, НашаОрганизацияСсылка);
			КонецЦикла;
			
			// Записать новую границу синхронизации
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				НашаОрганизацияСсылка,
				ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытий,
				ТекущееСобытие.id);
			
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				НашаОрганизацияСсылка,
				ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытийДата,
				ТекущееСобытие.Дата);
			
		Иначе
			
			МоментОтправкиЗапроса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
			
			Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(
				НашаОрганизацияСсылка,
				ПеречисленияАктуальностиЛентыСобытий.АктуальностьЛентыСобытийДата,
				МоментОтправкиЗапроса);
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьНормализованнуюЛентуСобытийОрганизации(НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий) Экспорт
	
	ЛентаСобытийИзСервиса = ПрочитатьЛентуСобытий(НашаОрганизацияСсылка, ПеречисленияАктуальностиЛентыСобытий);
	ЛентаСобытийНормализованная = НормализоватьЛентуЛогистики(
		НашаОрганизацияСсылка, ЛентаСобытийИзСервиса, ПеречисленияАктуальностиЛентыСобытий);
	
	Возврат ЛентаСобытийНормализованная;
	
КонецФункции

Функция ПолучитьСведенияОСобственнойОрганизации(ОрганизацияСсылка) Экспорт
	
	ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияСсылка);
	
	Если ПараметрыСервисаЛогистика.АвторизацияВыполнена Тогда
		СтруктураДанных = КонтурЛогистика_API_Логистика.ПолучитьСведенияОСобственнойОрганизацииV2(ПараметрыСервисаЛогистика);
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

// любой организации
Функция ПолучитьРеквизитыОрганизации(ОрганизацияСсылка) Экспорт
	
	ТочноеСовпадение = Ложь;
	ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
	
	СтруктураДанных = КонтурЛогистика_API_Логистика.ПолучитьРеквизитыОрганизации(
		ПараметрыСервисаЛогистика, ОрганизацияСсылка.ИНН, ОрганизацияСсылка.КПП);
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ПолучитьНастройкиОрганизации(ОрганизацияСсылка) Экспорт
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияСсылка);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = КонтурЛогистика_API_Логистика.ПолучитьНастройкиОрганизации(ПараметрыСервиса, ОрганизацияСсылка.ID);
	
	Возврат Результат;
	
КонецФункции

Функция СохранитьНастройкиОрганизации(ОрганизацияСсылка) Экспорт
	
	ЗначениеРазрешитьВодителямВноситьПоказанияГСМ = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		ОрганизацияСсылка, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.РазрешитьВодителямВноситьПоказанияГСМ);
	
	НастройкиПолномочийВодителя = Новый Структура;
	НастройкиПолномочийВодителя.Вставить("canEditFuelReadings", ЗначениеРазрешитьВодителямВноситьПоказанияГСМ);
	
	НастройкиОрганизации = Новый Структура;
	НастройкиОрганизации.Вставить("driverPermissions", НастройкиПолномочийВодителя);
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияСсылка);
	
	Результат = КонтурЛогистика_API_Логистика.СохранитьНастройкиОрганизации(ПараметрыСервиса, ОрганизацияСсылка.ID, НастройкиОрганизации);
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкаПравДляРаботыСервисом(ОрганизацияСсылка = Неопределено, Токен = Неопределено) Экспорт
	
	Результат = Новый Соответствие;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияСсылка, Токен);
	
	СведенияОСобственнойОрганизации = КонтурЛогистика_API_Логистика.ПолучитьСведенияОСобственнойОрганизацииV2(ПараметрыСервиса);
	
	Для Каждого ТекущаяСтрока Из СведенияОСобственнойОрганизации Цикл
		
		ПереченьНедостающихПрав = Новый Массив;
		
		permittedOperations = ТекущаяСтрока.Получить("permittedOperations");
		Если permittedOperations = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НеобходимыеПрава = ПереченьНеобходимыхПравДляРаботыOIDC();
		
		Для Каждого ТекущееПраво Из НеобходимыеПрава Цикл
			Если permittedOperations.Найти(ТекущееПраво.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПереченьНедостающихПрав.Добавить(ТекущееПраво);
		КонецЦикла;
		
		BoxId = ТекущаяСтрока.Получить("diadocBoxId");
		Результат.Вставить(BoxId, ПереченьНедостающихПрав);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПравДостаточноДляРаботыСервисом(ОрганизацияСсылка, Токен) Экспорт
	
	ПроверкаПравДляРаботыСервисом = ПроверкаПравДляРаботыСервисом(ОрганизацияСсылка, Токен);
	ПереченьНедостающихПрав = ПроверкаПравДляРаботыСервисом.Получить(ОрганизацияСсылка.ID);
	
	Если ПереченьНедостающихПрав = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (ПереченьНедостающихПрав.Количество() = 0);
	
КонецФункции

