Процедура ОбновитьСостояниеПанели(СтатусДокумента, ФормаДокумента, РезультатПроверки, ВсегдаВыводитьРезультатВалидации = Ложь) Экспорт
	
	Элементы = ФормаДокумента.Элементы;
	ПанельИнформации = Элементы.ПанельИнформации;
	ПанельОшибокРазвернута = Элементы.ПанельОшибок.РастягиватьПоВертикали;
	
	Если Не ВсегдаВыводитьРезультатВалидации Тогда 
		МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации = СтатусыПриКоторыхНеВыводимРезультатыВалидации();
		
		Если МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации.Найти(СтатусДокумента) <> Неопределено
				И РезультатПроверки.КоличествоПредупреждений = 0 Тогда
				
			Элементы.КоманднаяПанельИндикаторВалидации.Видимость = Ложь;		
			Элементы.КоманднаяПанельИндикаторВалидацииРазвернутьПанельОшибок.Видимость = Ложь;		
			Элементы.ПанельОшибок.Видимость = Ложь;		
			Возврат;
				
		КонецЕсли;
	КонецЕсли;
	
	Оформление = ПолучитьОформлениеИндикатораВалидации(РезультатПроверки);
	ЗаполнитьЗначенияСвойств(ПанельИнформации, Оформление, "Заголовок, Картинка, ЦветРамки, ЦветФона");
	
	Если Элементы.Найти("ПанельОшибокСвернутьРазвернуть") <> Неопределено Тогда // например титул 2 не имеет режима сворачивания панели ошибок
		Если ПанельОшибокРазвернута Тогда
			Элементы.ПанельОшибокСвернутьРазвернуть.Картинка = БиблиотекаКартинок.КонтурЛогистика_Свернуть;
		Иначе
			Элементы.ПанельОшибокСвернутьРазвернуть.Картинка = БиблиотекаКартинок.КонтурЛогистика_Развернуть;
		КонецЕсли;
	КонецЕсли;
	
	СформироватьИндикаторОшибокКоманднойПанели(РезультатПроверки, ФормаДокумента);
	
КонецПроцедуры

Функция СтатусыПриКоторыхНеВыводимРезультатыВалидации()
	
	Перем МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации;
	
	МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации = Новый Массив;
	МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена"));	
	МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан"));
	МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи"));
	МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации.Добавить(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен"));	
	
	Возврат МассивСтатусовПриКоторыхНеВыводимРезультатыВалидации;

КонецФункции

Процедура СформироватьИндикаторОшибокКоманднойПанели(РезультатПроверки, ФормаДокумента)
	
	Элементы = ФормаДокумента.Элементы;
	СвернутыйРежим = Ложь; // если есть ошибки, то показываем панель всегда
	ПанельОшибокДоступна = Истина; // если нет ошибок то панель недоступна
	
	Оформление = ПолучитьОформлениеИндикатораВалидации(РезультатПроверки);
	ЗаполнитьЗначенияСвойств(Элементы.КоманднаяПанельИндикаторВалидации, Оформление, "Заголовок, Картинка, ЦветРамки, ЦветФона");
	
	Если РезультатПроверки.КоличествоОшибок = 0 
		И РезультатПроверки.КоличествоОшибокДиадок = 0 
		И РезультатПроверки.КоличествоОшибокДругойСтороны = 0
		И РезультатПроверки.КоличествоОшибокКриптографии = 0 Тогда
		
		Если РезультатПроверки.КоличествоПредупреждений > 0 Тогда
			
			СвернутыйРежим = ФормаДокумента.ПанельОшибок_ПредупрежденияПоУмолчаниюСвернуты = Истина;
			
		Иначе
			
			СвернутыйРежим = Истина;
			ПанельОшибокДоступна = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ПанельОшибок.Видимость = НЕ СвернутыйРежим;		
	Элементы.КоманднаяПанельИндикаторВалидацииРазвернутьПанельОшибок.Видимость = СвернутыйРежим И ПанельОшибокДоступна;
	Элементы.КоманднаяПанельИндикаторВалидации.Видимость = СвернутыйРежим И ПанельОшибокДоступна;
	
КонецПроцедуры

Функция ПолучитьОформлениеИндикатораВалидации(РезультатПроверки)
	
	Оформление = Новый Структура;
	Оформление.Вставить("Заголовок", 	"Проверка пройдена");
	Оформление.Вставить("Картинка", 	БиблиотекаКартинок.КонтурЛогистика_Галочка);
	Оформление.Вставить("ЦветРамки", 	Новый Цвет(0,170,144));
	Оформление.Вставить("ЦветФона", 	WebЦвета.Роса);
	
	Если РезультатПроверки.КоличествоОшибок > 0 Тогда 
		
		
		Оформление.Заголовок = "Исправьте ошибки (" + РезультатПроверки.КоличествоОшибок + ")";
		Оформление.Картинка = БиблиотекаКартинок.КонтурЛогистика_ИсправитьОшибки;
		Оформление.ЦветРамки = WebЦвета.Шоколадный;
		Оформление.ЦветФона = WebЦвета.Розовый;
		
	ИначеЕсли РезультатПроверки.КоличествоОшибокДиадок > 0 Тогда 
		
		Оформление.Заголовок = "Ошибки на стороне Диадок (" + РезультатПроверки.КоличествоОшибокДиадок + ")";
		Оформление.Картинка = БиблиотекаКартинок.КонтурЛогистика_ДиадокКрасный;
		Оформление.ЦветРамки = WebЦвета.Шоколадный;
		Оформление.ЦветФона = WebЦвета.Розовый;
		
	ИначеЕсли РезультатПроверки.КоличествоОшибокКриптографии > 0 Тогда 
		
		Оформление.Заголовок = "Ошибки подписания (" + РезультатПроверки.КоличествоОшибокКриптографии + ")";
		Оформление.Картинка = БиблиотекаКартинок.КонтурЛогистика_Сертификат;
		Оформление.ЦветРамки = WebЦвета.РыжеватоКоричневый;
		Оформление.ЦветФона = WebЦвета.Розовый;
		
	ИначеЕсли РезультатПроверки.КоличествоОшибокДругойСтороны > 0 Тогда 
		
		Оформление.Заголовок = "Ошибки на стороне Получателя файла (" + РезультатПроверки.КоличествоОшибокДругойСтороны + ")";
		Оформление.Картинка = БиблиотекаКартинок.КонтурЛогистика_ИсправитьОшибки;
		Оформление.ЦветРамки = WebЦвета.Шоколадный;
		Оформление.ЦветФона = WebЦвета.Розовый;	

	ИначеЕсли РезультатПроверки.КоличествоПредупреждений > 0 Тогда
		
		
		Оформление.Заголовок = "Предупреждения (" + РезультатПроверки.КоличествоПредупреждений + ")";
		Оформление.Картинка = БиблиотекаКартинок.КонтурЛогистика_Предупреждение;
		Оформление.ЦветРамки = WebЦвета.РыжеватоКоричневый;
		Оформление.ЦветФона = WebЦвета.СлоноваяКость;

	КонецЕсли;
	
	Возврат Оформление;
	
КонецФункции

// только включает видимость панели ошибок и прячет кнопку командной панели КоманднаяПанельИндикаторВалидацииРазвернутьПанельОшибок
Процедура ПоказатьПанельОшибок(ФормаДокумента) Экспорт
	
	СвернутыйРежим = Ложь;
	
	ПоказатьСкрытьПанельОшибок(СвернутыйРежим, ФормаДокумента);
	
КонецПроцедуры

// выключает видимость панели ошибок в пользу кнопки командной панели КоманднаяПанельИндикаторВалидации
Процедура МинимизироватьПанельОшибок(ФормаДокумента)Экспорт
	
	СвернутыйРежим = Истина;
	
	ПоказатьСкрытьПанельОшибок(СвернутыйРежим, ФормаДокумента);
	
КонецПроцедуры

Процедура ПоказатьСкрытьПанельОшибок(Знач СвернутыйРежим, Знач ФормаДокумента)
	
	Перем Элементы;
	
	Элементы = ФормаДокумента.Элементы;
	
	Элементы.ПанельОшибок.Видимость = НЕ СвернутыйРежим;
	Элементы.КоманднаяПанельРезультатВалидации.Видимость = СвернутыйРежим;
	Элементы.КоманднаяПанельИндикаторВалидацииРазвернутьПанельОшибок.Видимость = СвернутыйРежим;
	Элементы.КоманднаяПанельИндикаторВалидации.Видимость = СвернутыйРежим;		
	
	ФормаДокумента.ПанельОшибок_ПредупрежденияПоУмолчаниюСвернуты = СвернутыйРежим;

КонецПроцедуры

Процедура СделатьАктивнымПоле(Форма, Объект, ИмяПоля, ИмяТабличнойЧасти, НомераСтрок = Неопределено, ИдентификаторыСтрокДерева = Неопределено) Экспорт
	
	Элементы = Форма.Элементы;
	
	Если ЗначениеЗаполнено(ИмяТабличнойЧасти) И ИмяТабличнойЧасти <> "ДанныеШапкиДокумента" Тогда
		
		ТабличнаяЧасть = Элементы[ИмяТабличнойЧасти];
		
		Форма.ТекущийЭлемент = ТабличнаяЧасть;

		// проверим колонку на наличие и возможность активизации
		ТекущаяКолонкаТЧ = Элементы.Найти("" + ТабличнаяЧасть.Имя + ИмяПоля);
		Если ТекущаяКолонкаТЧ <> Неопределено И ТекущаяКолонкаТЧ.Видимость И ТекущаяКолонкаТЧ.Доступность Тогда
			ТабличнаяЧасть.ТекущийЭлемент = ТекущаяКолонкаТЧ;
		КонецЕсли;
		
		Если НЕ НомераСтрок = Неопределено И НомераСтрок.Количество() > 0 Тогда
			ТабличнаяЧасть.ВыделенныеСтроки.Очистить();
			ТабличнаяЧасть.ТекущаяСтрока = Объект[ИмяТабличнойЧасти][НомераСтрок[0].Значение - 1].ПолучитьИдентификатор();
			Для Каждого НомерСтроки Из НомераСтрок Цикл
				ИдентификаторСтроки = Объект[ИмяТабличнойЧасти][НомерСтроки.Значение - 1].ПолучитьИдентификатор();
				ТабличнаяЧасть.ВыделенныеСтроки.Добавить(ИдентификаторСтроки);
			КонецЦикла;
		КонецЕсли;
		
		Если НЕ ИдентификаторыСтрокДерева = Неопределено И ИдентификаторыСтрокДерева.Количество() > 0 Тогда
			ТабличнаяЧасть.ВыделенныеСтроки.Очистить();
			ТабличнаяЧасть.ТекущаяСтрока = ИдентификаторыСтрокДерева[0].Значение;
			Для Каждого ИдентификаторСтрокиДерева Из ИдентификаторыСтрокДерева Цикл
				ТабличнаяЧасть.ВыделенныеСтроки.Добавить(ИдентификаторСтрокиДерева.Значение);
			КонецЦикла;
		КонецЕсли;
		
	Иначе	
		
		Если ЗначениеЗаполнено(ИмяПоля) Тогда

			ЧастиПути = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ИмяПоля, ".", Ложь);
			
			Если ЧастиПути.Количество() = 1 Тогда 
				
				НайденноеПоле = Элементы.Найти(ИмяПоля);
				Если НЕ НайденноеПоле = Неопределено Тогда
					Форма.ТекущийЭлемент = НайденноеПоле;
				КонецЕсли;
			
			ИначеЕсли ЧастиПути.Количество() > 1 Тогда
				
				ПоказатьТекущийЭлементЗависимогоОбъекта(Объект, ЧастиПути, Форма);
				
			КонецЕсли;	
				
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПоказатьТекущийЭлементЗависимогоОбъекта(Объект, ЧастиПути, ФормаВладелец, КолИсключаемых = 2)
	
	КолЧастейПутиДоСсылки 	= ЧастиПути.Количество() - КолИсключаемых;
	Реквизит 		= "";
	
	Для Сч = 0 По КолЧастейПутиДоСсылки Цикл 
		Реквизит = Реквизит + ЧастиПути[Сч] + ?(Сч = КолЧастейПутиДоСсылки, "", ".");
	КонецЦикла;	
	
	ТекущийЭлемент = ЧастиПути[Сч];
	
	времОбъект = Объект;
	
	Структура = КонтурЛогистика_ПанельОшибокСервер.ПолучитьИмяФормыИЗначение(времОбъект, Реквизит);
	
	Если ЗначениеЗаполнено(Структура.ИмяФормы) Тогда 
					
		ПараметрыФормы = Новый Структура("Ключ, ТекущийЭлемент", Структура.Значение, ТекущийЭлемент);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			Структура.ИмяФормы,
			ПараметрыФормы,
			ФормаВладелец,
			ФормаВладелец,
			"ОбработчикПерепроверить");
		
	КонецЕсли;
		
КонецФункции	

// только заполняет колонку ПризнакОтбораТаблицыОшибок у таблицы, применение ОтбораСтрок табличного поля - расположить в форме документа
Процедура ОтфильтроватьСтрокиТабЧастиДокумента(Форма, Объект, ИмяПоля, ИмяТабличнойЧасти, ТекстОшибки, НомераСтрок = Неопределено, ИдентификаторыСтрокДерева = Неопределено) Экспорт
	
	
	Если НомераСтрок = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	Попытка
		
		ТабЧасть = Объект[ИмяТабличнойЧасти];
		
		Для Каждого СтрокаДокумента Из ТабЧасть Цикл
			
			Если НомераСтрок.НайтиПоЗначению(СтрокаДокумента.НомерСтроки) <> Неопределено Тогда
				
				СтрокаДокумента.ПризнакОтбораТаблицыОшибок = Истина;
				
			Иначе
				
				СтрокаДокумента.ПризнакОтбораТаблицыОшибок = Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЭлементОтключитьФильтрТаблицыОшибок = Форма.Элементы["ОтключитьФильтрТаблицыОшибок" + ИмяТабличнойЧасти];
		ЭлементОтключитьФильтрТаблицыОшибок.Заголовок = "" + Лев(СокрЛП(ТекстОшибки), 35) + "...";
		
		ИмяРеквизитаОтбораТаблицыОшибок = "ОтборТаблицыОшибокЗначение" + ИмяТабличнойЧасти;
		Если Форма[ИмяРеквизитаОтбораТаблицыОшибок] = ТекстОшибки Тогда 
			Форма[ИмяРеквизитаОтбораТаблицыОшибок] = "";
		Иначе
			Форма[ИмяРеквизитаОтбораТаблицыОшибок] = ТекстОшибки;
		КонецЕсли;
		
		// отбор строк таблицы
		// !ВНИМАНИЕ! документ может также использовать отбор строк, поэтому управляем аккуратно
		ТаблицаФормы = Форма.Элементы[ИмяТабличнойЧасти];
		
		Если ЗначениеЗаполнено(Форма[ИмяРеквизитаОтбораТаблицыОшибок]) Тогда
			
			// установить отбор строк
			Если ТаблицаФормы.ОтборСтрок = Неопределено Тогда
				
				ТаблицаФормы.ОтборСтрок = Новый ФиксированнаяСтруктура("ПризнакОтбораТаблицыОшибок", Истина);
				
			Иначе
				
				ВременнаяСтруктура = Новый Структура(ТаблицаФормы.ОтборСтрок);
				ВременнаяСтруктура.Вставить("ПризнакОтбораТаблицыОшибок", Истина);
				ТаблицаФормы.ОтборСтрок = Новый ФиксированнаяСтруктура(ВременнаяСтруктура);
				
			КонецЕсли;
		Иначе
			
			// снять отбор строк
			Если НЕ ТаблицаФормы.ОтборСтрок = Неопределено Тогда
				
				ВременнаяСтруктура = Новый Структура(ТаблицаФормы.ОтборСтрок);
				
				Если ВременнаяСтруктура.Свойство("ПризнакОтбораТаблицыОшибок") Тогда 
					ВременнаяСтруктура.Удалить("ПризнакОтбораТаблицыОшибок");
					ТаблицаФормы.ОтборСтрок = Новый ФиксированнаяСтруктура(ВременнаяСтруктура);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЭлементОтключитьФильтрТаблицыОшибок.Видимость = ЗначениеЗаполнено(Форма[ИмяРеквизитаОтбораТаблицыОшибок]);	
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ОтфильтроватьСтрокиТабЧастиДокумента", ОписаниеОшибки());
		
	КонецПопытки;
		
КонецПроцедуры

Процедура ТаблицаОшибокВыбор(Форма, Объект, ИмяКолонкиТаблицыОшибок = Неопределено, ДействиеФормыПослеВыбора = Неопределено) Экспорт
	
	ТекущаяСтрока = Форма.Элементы.ТаблицаОшибок.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено Тогда
				
		Если ТекущаяСтрока.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.ОшибкаДиадок") Тогда 
			
			// потребуется переписать после рефакторинга раскладывания ошибок
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущаяСтрока.ТекстОшибки);
			
		ИначеЕсли ТекущаяСтрока.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.ОшибкаКриптографии") Тогда 
			
			ДанныеОшибки = КонтурЛогистика_КриптографияСервер.ПолучитьДанныеОшибкиКриптографии(Объект.Ссылка);
			
			ПодписантСтруктура 	= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодписантСтруктура(Объект);
				
			СертификатНаСервере = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ПодписантСтруктура.Сертификат, "СертификатНаСервере");
			ТипОшибки = КонтурЛогистика_КриптографияКлиентСервер.ТипОшибкиКриптографии(ДанныеОшибки.КодОшибки, СертификатНаСервере);
			
			ПараметрыФормы = Новый Структура("ТипОшибки, ОписаниеОшибки, Сертификат, Документ", 
				ТипОшибки, ДанныеОшибки.ПодробноеОписаниеОшибки, ПодписантСтруктура.Сертификат, Объект.Ссылка);
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ОписаниеОшибкиСРешением", ПараметрыФормы,, 
				КонтурЛогистика_ПанельОшибокКлиент, "ОбработчикОписаниеОшибкиСРешением");
				
		// FIXME - действие Утратило актуальность в связи с выполнением задачи KL-3513/Sozdanie-organizacij-v-Logistike-na-letu-iz-titula
		// Требуется отдельно принять решение об исключении текущей формы приглашения в Логистику или замены её на другую, например массовой активации
		ИначеЕсли Найти(ТекущаяСтрока.Действие, "Отправить приглашение") > 0 Тогда
			
			// открыть форму приглашения КА к работе в Логистике
			КогоПригласить = КогоПриглашатьПоДокументу(Объект, ТекущаяСтрока.ИмяПоля);
			
			Параметрыформы = Новый Структура;
			РезультатВыбораОрганизацииПодписанта = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьОрганизациюПодписантаИДатуПодписи(Объект);
			ОрганизацияГлавного = РезультатВыбораОрганизацииПодписанта.ОрганизацияГлавного;
			
			// Не важно под какой организацией получаем данные
			ТочноеСовпадение = Ложь;
			ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
			Если ПараметрыСервиса.АвторизацияВыполнена Тогда
				КонтурЛогистика_ОбщегоНазначенияСервер.СинхронизироватьОрганизациюИзСервисаЛогистика(КогоПригласить);
			КонецЕсли;
			
			ЕстьВСервисеЛогистика = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(КогоПригласить, "ЕстьВСервисеЛогистика");
			Если ЕстьВСервисеЛогистика Тогда
				ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ОбработчикПерепроверить", Форма));
			Иначе
			
				Параметрыформы.Вставить("Инициатор", ОрганизацияГлавного);
				Параметрыформы.Вставить("Контрагент", КогоПригласить);
				Параметрыформы.Вставить("ОбновитьИзЛогистики", Истина);
				
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
					"ОбщаяФорма.КонтурЛогистика_ПриглашениеКОбменуЭПД",
					Параметрыформы,
					Форма,
					Форма,
					"ОбработчикПерепроверить");
					
			КонецЕсли;
			
		ИначеЕсли Найти(ТекущаяСтрока.Действие, "Пригласить в ЭДО") > 0 Тогда
			
			КогоПригласить = КогоПриглашатьПоДокументу(Объект, ТекущаяСтрока.ИмяПоля);
			
			РезультатВыбораОрганизацииПодписанта = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьОрганизациюПодписантаИДатуПодписи(Объект);
			ОрганизацияГлавного = РезультатВыбораОрганизацииПодписанта.ОрганизацияГлавного;
			
			Параметрыформы = Новый Структура;
			Параметрыформы.Вставить("Инициатор", ОрганизацияГлавного);
			Параметрыформы.Вставить("Контрагент", КогоПригласить);
			Параметрыформы.Вставить("ПригласитьВЭДО");
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"ОбщаяФорма.КонтурЛогистика_ПриглашениеКОбменуЭПД", Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
			
		ИначеЕсли Найти(ТекущаяСтрока.Действие, "Проверить предыдущий") > 0 Тогда
			
			ОткрытьОшибкуПредыдущегоТитула(Объект);
			
		ИначеЕсли (ТекущаяСтрока.ИмяПоля = "Подписант"
				Или ТекущаяСтрока.ИмяПоля = "ДанныеТ2Подписант"
				Или ТекущаяСтрока.ИмяПоля = "ДанныеТ3Подписант"
				Или ТекущаяСтрока.ИмяПоля = "ДанныеТ4Подписант")
			И Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
			ТаблицаОшибокВыборПодписанта(Форма, Объект);
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Подписант.Сертификат" И  Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
				ПодписантСтруктура = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодписантСтруктура(Объект);
				
				ПараметрыФормы = Новый Структура("Ключ", ПодписантСтруктура.Сертификат);
			
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
					"Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.Форма.ФормаЭлемента",
					Параметрыформы,
					Форма,
					Форма,
					"ОбработчикПерепроверить");
					
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Подписант.МЧДСсылка" И  Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
				ПодписантСтруктура 	= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодписантСтруктура(Объект);
							
				ПараметрыФормы = Новый Структура("Ключ", ПодписантСтруктура.МЧДСсылка);
			
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
					"Справочник.КонтурЛогистика_МЧД.Форма.ФормаЭлемента",
					Параметрыформы,
					Форма,
					Форма,
					"ОбработчикПерепроверить");
					
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Подписант" И  Лев(ТекущаяСтрока.Действие, 9) = "Проверить" Тогда
			
				ПодписантСтруктура 	= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодписантСтруктура(Объект);
							
				КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПроверитьМЧД(ПодписантСтруктура.ОрганизацияГлавного, ПодписантСтруктура);
				
				ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ОбработчикПерепроверить", Форма));
			
		ИначеЕсли ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокТекстОшибки"
			И ЗначениеЗаполнено(ТекущаяСтрока.ИмяТабличнойЧасти) 
			И ТекущаяСтрока.ИмяТабличнойЧасти <> "ДанныеШапкиДокумента" Тогда
			
			ОтфильтроватьСтрокиТабЧастиДокумента(Форма, Объект, ТекущаяСтрока.ИмяПоля, ТекущаяСтрока.ИмяТабличнойЧасти, ТекущаяСтрока.ТекстОшибки, ТекущаяСтрока.НомераСтрок, ТекущаяСтрока.ИдентификаторыСтрокДерева);
			
		ИначеЕсли ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокДействие" 
			И Лев(ТекущаяСтрока.Действие, 13) = "Получить УИДы" Тогда	
			
			ОткрытьФормуЗагрузкиУИДов(Форма);
			
		ИначеЕсли ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокДействие" 
			И Лев(ТекущаяСтрока.Действие, 13) = "Взять из пула" Тогда	
			
			ВзятьУИДизПула(Форма, Объект);
			
		ИначеЕсли ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокДействие" 
			И Лев(ТекущаяСтрока.Действие, 12) = "Взять сейчас" Тогда	
			
			ВзятьУИДизПула(Форма, Объект);
			
		ИначеЕсли ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокДействие" 
			И Лев(ТекущаяСтрока.Действие, 13) = "Добавить груз" Тогда	
			
			Если Не ДействиеФормыПослеВыбора = Неопределено Тогда 
				Действие = Лев(ТекущаяСтрока.Действие, 13);
				Выполнить(
				    КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
				        "Форма.%1(%2)", 
				        ДействиеФормыПослеВыбора, 
				        "Действие"));
			КонецЕсли;	
			
		ИначеЕсли (ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокДействие" 
			Или	ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокТекстОшибки")	
			И Лев(ТекущаяСтрока.ИмяПоля, 15) = "ГлавныйДокумент" Тогда
			
			ОткрытьОшибкуГлавногоДокумента(ТекущаяСтрока, Форма, Объект, ИмяКолонкиТаблицыОшибок);
			
		ИначеЕсли ИмяКолонкиТаблицыОшибок = "ТаблицаОшибокДействие"
			И Лев(ТекущаяСтрока.Действие, 11) =  "Сопоставить" Тогда	
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Составитель" И Лев(ТекущаяСтрока.Действие, 7) = "Указать" Тогда
			
			Если ЗначениеЗаполнено(Объект.Составитель) Тогда 
				ОрганизацияОтправляющаяВАпиПрототип = Объект.Составитель;
			Иначе
				
				РеквизитыДокументаЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
					Объект.ДокументЭТРН, "ПогрузкуОсуществляет, ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку, Грузоотправитель");
				
				Если ЗначениеЗаполнено(РеквизитыДокументаЭТРН.ПогрузкуОсуществляет)
					И РеквизитыДокументаЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку Тогда
					
					ОрганизацияОтправляющаяВАпиПрототип = РеквизитыДокументаЭТРН.ПогрузкуОсуществляет;
					
				ИначеЕсли ЗначениеЗаполнено(РеквизитыДокументаЭТРН.Грузоотправитель) Тогда
					
					ОрганизацияОтправляющаяВАпиПрототип = РеквизитыДокументаЭТРН.Грузоотправитель;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("Ключ, УказатьКлючАПИ", ОрганизацияОтправляющаяВАпиПрототип, Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",
				Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
				
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "ФормаДружбыКонтрагентов" И Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
			ПараметрыФормы = Новый Структура("Отправитель, Получатель, Валидатор, ПроверитьАпиКлючОтправителя, ПроверитьАвтодружбу", 
				ТекущаяСтрока.ДополнительныеПараметры[0].Значение, 
				ТекущаяСтрока.ДополнительныеПараметры[1].Значение,
				Истина,
				ТекущаяСтрока.ДополнительныеПараметры[2].Значение,
				ТекущаяСтрока.ДополнительныеПараметры[3].Значение);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"ОбщаяФорма.КонтурЛогистика_ФормаДружбыКонтрагентов",
				Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "СоздатьНастройкуКонвертации" И Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
			ТипДокумента = ТекущаяСтрока.ДополнительныеПараметры[0].Значение;
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ТипДокументаЛогистика", ТипДокумента);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаЭлемента",
				ПараметрыОткрытия, Форма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Организация" И Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
			Документ = Объект;
			
			ДанныеДляПроверкиДружбы = КонтурЛогистика_ПанельОшибокСервер.ПолучитьОсновныеДанныеФайла(Документ);
			
			ПараметрыФормы = Новый Структура("Ключ", ДанныеДляПроверкиДружбы.Получатель);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",
				Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
				
		ИначеЕсли (ТекущаяСтрока.ИмяПоля = "НаимГосСист" ИЛИ ТекущаяСтрока.ИмяПоля = "ИдНомУчетЕд") И Лев(ТекущаяСтрока.Действие, 9) = "Заполнить" Тогда
			
			СделатьАктивнымПоле(Форма, Объект, "УчетГрузаВГИС", "Товары", ТекущаяСтрока.ДополнительныеПараметры, ТекущаяСтрока.ИдентификаторыСтрокДерева);
			СделатьАктивнымПоле(Форма, Объект, ТекущаяСтрока.ИмяПоля, ТекущаяСтрока.ИмяТабличнойЧасти, ТекущаяСтрока.НомераСтрок, ТекущаяСтрока.ИдентификаторыСтрокДерева);
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "ПредупрежденияГИС" И Лев(ТекущаяСтрока.Действие, 12) = "Игнорировать" Тогда
			
			Документ = Объект;
			
			КонтурЛогистика_ПанельОшибокСервер.ИгнорироватьПредупреждение(Документ);
			
			ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ОбработчикПерепроверить", Форма));
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Подписант.ПроверятьПолномочия" И  Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
			ПодписантСтруктура 	= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодписантСтруктура(Объект);
									
			ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Объект.Ссылка);
			Полномочие = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьПолномочиеПоТипуЛогистическогоДокумента(ТипТитула, Форма.ТребуемоеДействие);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("МЧД", ПодписантСтруктура.МЧДСсылка);
			ПараметрыФормы.Вставить("Полномочие", Полномочие);
			ПараметрыФормы.Вставить("ОтпечатокСертификата", ПодписантСтруктура.ОтпечатокСертификата);
			ПараметрыФормы.Вставить("КомуВыданСертификат", СокрЛП(ПодписантСтруктура.Сертификат));
			ПараметрыФормы.Вставить("ТипТитула", ТипТитула);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"РегистрСведений.КонтурЛогистика_НастройкиПолномочийМЧД.Форма.ФормаВыбораНастройкиПолномочий",
				Параметрыформы,
				Форма,
				Форма);
			
		ИначеЕсли ТекущаяСтрока.ТекстОшибки = "У орг.оформителя не указано Подразделение-отправитель по умолчанию в настройках" Тогда
			
			ИмяПоляОрганизации = СтрЗаменить(ТекущаяСтрока.ИмяПоля, ".Настройки", "");
			ПараметрыФормы = Новый Структура("Ключ, УказатьПодразделениеОтправитель", Объект[ИмяПоляОрганизации], Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",
				Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
			
		ИначеЕсли ТекущаяСтрока.ТекстОшибки = "У орг.оформителя не указано Подразделение-получатель по умолчанию в настройках" Тогда
			
			ИмяПоляОрганизации = СтрЗаменить(ТекущаяСтрока.ИмяПоля, ".Настройки", "");
			ПараметрыФормы = Новый Структура("Ключ, УказатьПодразделениеПолучатель", Объект[ИмяПоляОрганизации], Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",
				Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
				
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "Отправитель" И  Лев(ТекущаяСтрока.Действие, 7) = "Указать" Тогда
			
			ПараметрыФормы = Новый Структура("Ключ", ТекущаяСтрока.ДополнительныеПараметры[0].Значение);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",
				Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
		
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "ПунктМаршрута" И Лев(ТекущаяСтрока.Действие, 9) = "Настроить" Тогда
			
			ПараметрыФормы = Новый Структура("Ключ", Объект.АдрВыгруз);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаЭлемента",
				ПараметрыФормы, Форма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "ПунктМаршрута.Собственник" И Лев(ТекущаяСтрока.Действие, 7) = "Указать" Тогда
			
			Для Каждого НомерСтроки Из ТекущаяСтрока.НомераСтрок Цикл
				
				СтрокаМаршрута = Объект.АдрПункт[НомерСтроки.Значение-1];
				
				ПараметрыФормы = Новый Структура("Ключ, УказатьСобственника", СтрокаМаршрута.ПунктМаршрута, Истина);
			
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
					"Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаЭлемента",
					ПараметрыФормы, Форма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
			КонецЦикла;
				
		ИначеЕсли Лев(ТекущаяСтрока.ИмяПоля, 16) = "ДобавитьВодитель" И Лев(ТекущаяСтрока.Действие, 8) = "Добавить" Тогда
			
			Организация = Неопределено;
			Водитель = Неопределено;
			Водитель2 = Неопределено;
			Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
				Организация = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.ДокументЭТРН, "Перевозчик");
				Водитель = Объект.Водитель;
				Водитель2 = Объект.Водитель2;
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
				Организация = Объект.ЛицоОформившееПЛ;
				Водитель = Объект.Водитель;
				Водитель2 = Объект.Водитель2;
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
				Организация = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.Титул1, "Перевозчик");
				Если Объект.Водители.Количество() = 1 Тогда
					Водитель = Объект.Водители[0].СвВодит;
				ИначеЕсли Объект.Водители.Количество() > 1 Тогда
					Водитель = Объект.Водители[0].СвВодит;
					Водитель2 = Объект.Водители[1].СвВодит;
				КонецЕсли;
			КонецЕсли;
			
			Если ТекущаяСтрока.ИмяПоля = "ДобавитьВодительВСервис" Тогда
				ПараметрыФормы = Новый Структура("Ключ, ОткрытьПриглашение, ОрганизацияВПриглашение", Водитель, Истина, Организация);
			Иначе
				ПараметрыФормы = Новый Структура("Ключ, ОткрытьПриглашение, ОрганизацияВПриглашение", Водитель2, Истина, Организация);
			КонецЕсли;
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаЭлемента",
				ПараметрыФормы, Форма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		ИначеЕсли (Лев(ТекущаяСтрока.ИмяПоля, 30) = "ПроверитьПриглашениеСотруднику" Или Лев(ТекущаяСтрока.ИмяПоля, 38) = "ПроверитьОтправкуПриглашенияСотруднику")
				И Лев(ТекущаяСтрока.Действие, 9) = "Проверить" Тогда
			
			ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ОбработчикПерепроверить", Форма));		
			
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "ОстатокТоплива" Тогда
			
			Если Лев(ТекущаяСтрока.Действие, 15) = "Выполнить обмен" Тогда
				
				КонтурЛогистика_ДлительныеОперацииСервер.ОтправкаОбработкаПроизвольныхДанных();
				
				ДокументыПодсистемы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
				Оповестить("КонтурЛогистика_Перепроверить", ДокументыПодсистемы);
				
			ИначеЕсли Лев(ТекущаяСтрока.Действие, 9) = "Исправить" Тогда
				
				ДокументОснование = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
					Объект.Титул1, "ДокументОснование");
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ДокументОснование", ДокументОснование);
				
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
					"РегистрСведений.КонтурЛогистика_ПроизвольныеДанные.Форма.ФормаСписка",
					Параметрыформы, Форма, Форма);
				
				КонецЕсли;
				
		ИначеЕсли ТекущаяСтрока.ИмяПоля = "ДокументЭТРН.ЗаказЗаявкаОснование" Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Объект.ДокументЭТРН, "ЗаказЗаявкаОснование"),
				Форма, "ОбработчикПерепроверить");
			
		ИначеЕсли Лев(ТекущаяСтрока.Действие, 14) = "Авторизоваться" Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"РегистрСведений.КонтурЛогистика_Аутентификация.Форма.ФормаАвторизацииОрганизаций",, Форма,,,,
				РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс, Истина);
			
		Иначе
			
			СделатьАктивнымПоле(Форма, Объект, ТекущаяСтрока.ИмяПоля, ТекущаяСтрока.ИмяТабличнойЧасти, ТекущаяСтрока.НомераСтрок, ТекущаяСтрока.ИдентификаторыСтрокДерева);
			
		КонецЕсли;
		
		ТаблицаОшибокПоказатьПодсказку(ТекущаяСтрока.ТекстОшибки);	
		
	КонецЕсли;
	
КонецПроцедуры

Функция КогоПриглашатьПоДокументу(Объект, ИмяПоля)
	
	КогоПригласить = Неопределено;
	
	// ЗЗ
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда 
		
		Если ИмяПоля = "Грузоотправитель" Тогда
			КогоПригласить = Объект.Грузоотправитель;
		ИначеЕсли ИмяПоля = "Перевозчик" Тогда
			КогоПригласить = Объект.Перевозчик;
		КонецЕсли;
		
	// ТРН / ЭПЛ
	Иначе
		
		Если ИмяПоля = "Грузоотправитель" Тогда
			КогоПригласить = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Объект.ДокументЭТРН, "Грузоотправитель");
		ИначеЕсли ИмяПоля = "Грузополучатель" Тогда
			КогоПригласить = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Объект.ДокументЭТРН, "Грузополучатель");
		ИначеЕсли ИмяПоля = "Перевозчик" Тогда
			КогоПригласить = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Объект.ДокументЭТРН, "Перевозчик");
		ИначеЕсли ИмяПоля = "ЛОП" Тогда
			КогоПригласить = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Объект.ДокументЭТРН, "ПогрузкуОсуществляет");
		ИначеЕсли ИмяПоля = "Медик" Тогда
			КогоПригласить = Объект.ОрганизацияМедик;
		ИначеЕсли ИмяПоля = "Техник" Тогда
			КогоПригласить = Объект.ОрганизацияТехСостояние;
		ИначеЕсли ИмяПоля = "Одометр" Тогда
			КогоПригласить = Объект.ОрганизацияОдометр;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КогоПригласить;
	
КонецФункции

Процедура ОбработчикОписаниеОшибкиСРешением(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) И ТипЗнч(Результат) = Тип("Структура") И Результат.Действие = "Переоткрыть" Тогда
		
		ПараметрыФормы = Новый Структура("ТипОшибки, ОписаниеОшибки, Сертификат", Результат.ТипОшибки, Результат.ОписаниеОшибки, Результат.Сертификат);
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ОписаниеОшибкиСРешением", ПараметрыФормы,, 
			КонтурЛогистика_ПанельОшибокКлиент, "ОбработчикОписаниеОшибкиСРешением");
		
	Иначе
		Оповестить("КонтурЛогистика_ПерепроверитьДокумент");
		Оповестить("КонтурЛогистика_ОбновитьФормуТитула");
		Оповестить("КонтурЛогистика_ОбновитьЗадачи");
	КонецЕсли;
		
КонецПроцедуры

Процедура ТаблицаОшибокВыборПодписанта(Форма, Объект, ПараметрыРасчета = Неопределено) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор() 
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьПользователямВыборСертификата") Тогда
		
		Если ПараметрыРасчета = Неопределено Тогда
			РезультатВыбораОрганизацииПодписанта = КонтурЛогистика_ОбработкаДокументовСервер.ОпределитьОрганизациюПодписантаИДатуПодписи(Объект);
			ДатаГлавного = РезультатВыбораОрганизацииПодписанта.ДатаГлавного;
			ОрганизацияГлавного = РезультатВыбораОрганизацииПодписанта.ОрганизацияГлавного;
			
			ПользовательПодписант = Объект.ПользовательПодписант;
			ПараметрНастроекПодписания = Объект.ПараметрНастроекПодписания;
			
			ТекущийОбъект = Неопределено;
		Иначе
			ДатаГлавного = ПараметрыРасчета.ДатаГлавного;
			ОрганизацияГлавного = ПараметрыРасчета.ОрганизацияГлавного;
			
			ПользовательПодписант = ПараметрыРасчета.ПользовательПодписант;
			ПараметрНастроекПодписания = ПараметрыРасчета.ПараметрНастроекПодписания;
			
			ТекущийОбъект = Неопределено;
		КонецЕсли;
		
		ПодписантСтруктура = КонтурЛогистика_ОбработкаДокументовСервер.ВыбратьПодписанта(
			ОрганизацияГлавного, ПользовательПодписант, ДатаГлавного, ТекущийОбъект, ПараметрНастроекПодписания);
		
		Если ЗначениеЗаполнено(ПодписантСтруктура.Фамилия) И ЗначениеЗаполнено(ПодписантСтруктура.Имя) Тогда
			
			СтруктураЗаписи = Новый Структура("ОрганизацияДиадок, Пользователь1С, СертификатНаСервере, ДопПараметр, Период",
				ОрганизацияГлавного, ПодписантСтруктура.Пользователь1С, ПодписантСтруктура.ЭтоСерверныйСертификат,
				ПодписантСтруктура.ДопПараметр, ПодписантСтруктура.ДатаЗаписи);
			
			МассивКонструктораКлюча = Новый Массив;
			МассивКонструктораКлюча.Добавить(СтруктураЗаписи);
			
			КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.КонтурЛогистика_НастройкиПодписания", МассивКонструктораКлюча);
			ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
			
		Иначе
			
			ЗначенияЗаполнения = Новый Структура("Пользователь1С, Период, ОрганизацияДиадок, ДопПараметр",
				КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С(), ДатаГлавного,
				ОрганизацияГлавного, ПараметрНастроекПодписания);
			
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
			
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"РегистрСведений.КонтурЛогистика_НастройкиПодписания.Форма.ФормаЗаписи",
			Параметрыформы, Форма, Форма, "ОбработчикПерепроверить");
		
	Иначе
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Обратитесь к администратору с просьбой настроить подписание в регистре КонтурЛогистика_НастройкиПодписания или разрешить пользователям самим выбирать сертификат в общей настройке ""Разрешить пользователям выбор и сохранение сертификата подписи"" ");
	КонецЕсли;
	
КонецПроцедуры

Процедура ВзятьУИДизПула(Форма, Объект)

	Форма.Записать();
	Оповестить("КонтурЛогистика_ИзменениеДокумента", Объект.Ссылка); 

КонецПроцедуры

Процедура ОткрытьОшибкуГлавногоДокумента(ТекущаяСтрокаОшибки, Форма, Объект, ИмяКолонкиТаблицыОшибок)
	
	текГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(Объект);
	
	ИмяПоля = СтрЗаменить(ТекущаяСтрокаОшибки.ИмяПоля, "ГлавныйДокумент.", "");
				
	ЧастиПути = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ИмяПоля, ".", Ложь);
	
	Если ЧастиПути.Количество() = 1 Тогда 
		
		ОткрытьФормуЭТРН(текГлавныйДокумент, Форма, ИмяПоля);
		
	ИначеЕсли ЧастиПути.Количество() > 1 Тогда
		
		ПоказатьТекущийЭлементЗависимогоОбъекта(текГлавныйДокумент, ЧастиПути, Форма);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОткрытьОшибкуПредыдущегоТитула(Объект)
	
	текГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоТитулу(Объект);
	ТекТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Объект.Ссылка);
	
	Предыдущийтитул = КонтурЛогистика_ОбработкаДокументовСервер.ПредыдущийТитулПоГлавномуИТекущемуТипу(текГлавныйДокумент, ТекТипЛогистика);
	Если ЗначениеЗаполнено(Предыдущийтитул) Тогда 
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(Предыдущийтитул);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуЭТРН(Знач ДокументЭТРН, Форма, ИмяТекущегоЭлемента)
	
	Перем ПараметрыФормы;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ДокументЭТРН);
	ПараметрыФормы.Вставить("ТекущийЭлемент", ИмяТекущегоЭлемента);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ФормаОбъекта",
		ПараметрыФормы,
		Форма,
		Форма,
		"ОбработчикПерепроверить")

КонецПроцедуры

Процедура ТаблицаОшибокПоказатьПодсказку(Знач ТекстОшибки)
	
	//пример
	Если ТекстОшибки = "текст ошибки" Тогда
		
		ТекстПодсказки = "Пояснения случившегося.
							|продолжение:
							|
							|- что предпринять1 .
							|- что предпринять2";
		
	ИначеЕсли ТекстОшибки = "другой текст ошибки" Тогда
		
		ТекстПодсказки = "Пояснения случившегося.
							|продолжение:
							|
							|- что предпринять1 .
							|- что предпринять2";
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстПодсказки) Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПодсказки, "Подсказка:");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОбновитьПиктограммыОшибокТабличнойЧасти(ТабличнаяЧасть, ТаблицаОшибок, ИмяТабличнойЧасти, ИмяПоляКартинки) Экспорт
	
	НомераСтрокСПредупреждениями = Новый Массив;
	НомераСтрокСОшибками = Новый Массив;	
	НомераСтрокСОшибкамиФГИС = Новый Массив;	
	
	СтрокиОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("ИмяТабличнойЧасти", ИмяТабличнойЧасти));
	
	Для Каждого СтрокаОшибок Из СтрокиОшибок Цикл
		
		Для Каждого НомерСтроки Из СтрокаОшибок.НомераСтрок Цикл
			
			Если СтрокаОшибок.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение")
					И НомераСтрокСПредупреждениями.Найти(НомерСтроки.Значение) = Неопределено Тогда
				НомераСтрокСПредупреждениями.Добавить(НомерСтроки.Значение);
			КонецЕсли;

			Если СтрокаОшибок.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка")
					И НомераСтрокСОшибками.Найти(НомерСтроки.Значение) = Неопределено Тогда
				НомераСтрокСОшибками.Добавить(НомерСтроки.Значение);
			КонецЕсли;
			
			Если СтрокаОшибок.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.ОшибкаДиадок")
					И НомераСтрокСОшибкамиФГИС.Найти(НомерСтроки.Значение) = Неопределено Тогда
				НомераСтрокСОшибкамиФГИС.Добавить(НомерСтроки.Значение);
			КонецЕсли;
			
			Если СтрокаОшибок.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.ОшибкаДругойСтороны")
					И НомераСтрокСОшибками.Найти(НомерСтроки.Значение) = Неопределено Тогда
				НомераСтрокСОшибками.Добавить(НомерСтроки.Значение);
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
		
	Для Каждого СтрокаТабличнойЧасти Из ТабличнаяЧасть Цикл
			
		Если НомераСтрокСОшибками.Найти(СтрокаТабличнойЧасти.НомерСтроки) <> Неопределено Тогда
			СтрокаТабличнойЧасти[ИмяПоляКартинки] = 2;
			
		ИначеЕсли НомераСтрокСОшибкамиФГИС.Найти(СтрокаТабличнойЧасти.НомерСтроки) <> Неопределено Тогда
			СтрокаТабличнойЧасти[ИмяПоляКартинки] = 4;
			
		ИначеЕсли НомераСтрокСПредупреждениями.Найти(СтрокаТабличнойЧасти.НомерСтроки) <> Неопределено Тогда
			СтрокаТабличнойЧасти[ИмяПоляКартинки] = 1;
			
		ИначеЕсли СтрокаТабличнойЧасти[ИмяПоляКартинки] <> 3 Тогда
			
			СтрокаТабличнойЧасти[ИмяПоляКартинки] = 0;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат НомераСтрокСОшибками;	
	
КонецФункции

Процедура ОбновитьПиктограммыОшибокДереваЗначенийРекурсивно(ДеревоФормы, ИдентификаторыСтрокСПредупреждениями, ИдентификаторыСтрокСОшибками, ИмяПоляКартинки)
	
	Для Каждого СтрокаДерева Из ДеревоФормы.ПолучитьЭлементы() Цикл
		
		Если ИдентификаторыСтрокСОшибками.Найти(СтрокаДерева.ПолучитьИдентификатор()) <> Неопределено Тогда
			СтрокаДерева[ИмяПоляКартинки] = 2;
		ИначеЕсли ИдентификаторыСтрокСПредупреждениями.Найти(СтрокаДерева.ПолучитьИдентификатор()) <> Неопределено Тогда
			СтрокаДерева[ИмяПоляКартинки] = 1;
		Иначе
			СтрокаДерева[ИмяПоляКартинки] = 0;
		КонецЕсли;
		
		ОбновитьПиктограммыОшибокДереваЗначенийРекурсивно(СтрокаДерева, ИдентификаторыСтрокСПредупреждениями, ИдентификаторыСтрокСОшибками, ИмяПоляКартинки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОткрытьФормуЗагрузкиУИДов(Форма)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_УИДыГИС.Форма.ФормаЗагрузкиПулаУИД");		
	
КонецПроцедуры	

Функция ОбновитьПиктограммыОшибокДереваЗначений(ДеревоФормы, ТаблицаОшибок, ИмяДерева, ИмяПоляКартинки) Экспорт
	
	ИдентификаторыСтрокСПредупреждениями = Новый Массив;
	ИдентификаторыСтрокСОшибками = Новый Массив;
	
	СтрокиОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("ИмяТабличнойЧасти", ИмяДерева));
	
	Для Каждого СтрокаОшибок Из СтрокиОшибок Цикл
		
		Для Каждого ИдентификаторСтрокиДерева Из СтрокаОшибок.ИдентификаторыСтрокДерева Цикл
			
			Если СтрокаОшибок.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение")
					И ИдентификаторыСтрокСПредупреждениями.Найти(ИдентификаторСтрокиДерева.Значение) = Неопределено Тогда
				ИдентификаторыСтрокСПредупреждениями.Добавить(ИдентификаторСтрокиДерева.Значение);
			КонецЕсли;

			Если СтрокаОшибок.КатегорияОшибки = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка")
					И ИдентификаторыСтрокСОшибками.Найти(ИдентификаторСтрокиДерева.Значение) = Неопределено Тогда
				ИдентификаторыСтрокСОшибками.Добавить(ИдентификаторСтрокиДерева.Значение);
			КонецЕсли;
			
			
		КонецЦикла;
	
	КонецЦикла;
	
	ОбновитьПиктограммыОшибокДереваЗначенийРекурсивно(ДеревоФормы, ИдентификаторыСтрокСПредупреждениями, ИдентификаторыСтрокСОшибками, ИмяПоляКартинки);
		
	Возврат ИдентификаторыСтрокСОшибками;	
	
КонецФункции

Процедура УстановитьОтборТаблицыОшибокПоНомеруСтроки(ТаблицаОшибок, ТекущиеДанные) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные) = Тип("ДанныеФормыЭлементДерева") Тогда
		
		ИдентификаторТекущейСтроки = ТекущиеДанные.ПолучитьИдентификатор();
		Для Каждого СтрокаОшибок Из ТаблицаОшибок Цикл
			СтрокаОшибок.Скрыть = (СтрокаОшибок.ИдентификаторыСтрокДерева.НайтиПоЗначению(ИдентификаторТекущейСтроки) = Неопределено); 
		КонецЦикла;
		
	Иначе
		
		НомерТекущейСтроки = ТекущиеДанные.НомерСтроки;
		Для Каждого СтрокаОшибок Из ТаблицаОшибок Цикл
			СтрокаОшибок.Скрыть = (СтрокаОшибок.НомераСтрок.НайтиПоЗначению(НомерТекущейСтроки) = Неопределено); 
		КонецЦикла;
		
	КонецЕсли;			
	
КонецПроцедуры

Процедура ПриИзмененииРежимаПанелиОшибок(ЭлементТаблицаОшибок, ПанельОшибокРежимТекущейСтроки) Экспорт
	
	Если ПанельОшибокРежимТекущейСтроки Тогда
		ЭлементТаблицаОшибок.ОтборСтрок = Новый ФиксированнаяСтруктура("Скрыть", Ложь);
	Иначе
		ЭлементТаблицаОшибок.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

// Выводим требуемое действие из ошибки
Функция ПолучитьТребуемоеДействиеТаблицыОшибок(Знач ТаблицаОшибок, ИмяТЧ, НомерСтрокиДокумента) Экспорт

	ТребуемоеДействие = Неопределено;
	
	ОтборПоТЧ = Новый Структура("ИмяТабличнойЧасти,КатегорияОшибки", ИмяТЧ, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка"));
	СтрокиОшибок = ТаблицаОшибок.НайтиСтроки(ОтборПоТЧ);
	
	Для Каждого СтрокаОшибки Из СтрокиОшибок Цикл
		
		Если СтрокаОшибки.КатегорияОшибки <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка") Тогда 
			Продолжить;
		КонецЕсли;
		
		НайденныйНомерСтроки = СтрокаОшибки.НомераСтрок.НайтиПоЗначению(НомерСтрокиДокумента);
		Если НайденныйНомерСтроки <> Неопределено Тогда 
			Если ЗначениеЗаполнено(СтрокаОшибки.ТребуемоеДействие) Тогда 
				ТребуемоеДействие = СтрокаОшибки.ТребуемоеДействие;
				Прервать;
			Иначе
				ТребуемоеДействие = "Исправить ошибки...";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТребуемоеДействие;

КонецФункции 