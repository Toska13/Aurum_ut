			КонтурЛогистика_ОбщегоНазначенияКлиент.НайтиИОткрытьДругойТитулВместоТекущего(Титул1, ТипОткрываемогоТитула, ФормаТитула, ТекТитулСсылка);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеЗакрытияВопросаВыполнитьОбмен(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = "ВыполнитьОбмен" Тогда
		
		КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеВыполнениеСотслеживаниемВНовойФорме("КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьОбмен",
				"Выполнение обмена колбаса",
				Новый Структура,
				"Выполнение обмена",
				Истина,
				Истина);		
		
	КонецЕсли;

КонецПроцедуры

Процедура НайтиИОткрытьДругойТитулВместоТекущего(ГлавныйДокумент, ТипТитула, ЗакрываемаяФорма, ТекущийТитул) Экспорт
	
	ДопПараметрыДействия = Новый Структура;
	
	Если ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3") Тогда
		
		НайденныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиПриемкуТрнТ3Основную(ГлавныйДокумент);
		ДопПараметрыДействия.Вставить("ЭтоПриемВозврата", Ложь);
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
		
		НайденныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиПриемкуТрнТ4Основную(ГлавныйДокумент);
		ДопПараметрыДействия.Вставить("ЭтоПриемВозврата", Ложь);
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7") Тогда
		
		НайденныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиПереадресовкуТрнТ7Основную(ГлавныйДокумент);
		ДопПараметрыДействия.Вставить("ЭтоВозвратнаяЦепочка", Ложь);
		
	Иначе
		
		НайденныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ТипТитула, ГлавныйДокумент);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
		
		Если ТекущийТитул <> НайденныйДокумент Тогда 
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(НайденныйДокумент);
			Если ЗначениеЗаполнено(ЗакрываемаяФорма.Объект.Ссылка) Тогда 
				ЗакрываемаяФорма.Закрыть();
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ТекущийТитул) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Для ввода нового титула требуется сначала записать текущий открытый");
			Возврат;
		КонецЕсли;
		
		Попытка
			
			// Если отказ, то не открываем
			СостояниеОтказа = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостояниеОтказа();
			ТекущийСтатусДО = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтатусДО(ГлавныйДокумент);
			Если СостояниеОтказа.Найти(ТекущийСтатусДО) <> Неопределено Тогда
				ТекстПредупреждения = "Для ввода титула: " + ТипТитула + " не подходящий статус ДО - " + ТекущийСтатусДО;
				КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПредупреждения);
				Возврат;
			КонецЕсли;
			
			// Требуется получить актуальный предыдущий титул для вводимого.
			ТипНужногоПредыдущегоТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредыдущийПоЦепочкеТипЛогистика(ТипТитула);
			НайденныйПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ТипНужногоПредыдущегоТитула, ГлавныйДокумент);
			
			Если ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4") Тогда  
				
				// для отправки Т4 необходимо, чтобы все предыдущие титулы были отправлены
				
				ТипТ2 = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2");
				ТитулыТ2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(ТипТ2, ГлавныйДокумент, Истина);
				ЕстьТ2 = ТитулыТ2.Количество() > 0;
				
				ТипТ3 = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3");
				ТитулыТ3 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(ТипТ3, ГлавныйДокумент, Истина);
				ЕстьТ3 = ТитулыТ3.Количество() > 0;				
				
				Если ЕстьТ2 И ЕстьТ3 Тогда
					КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаИзПредыдущегоТитула(ТипТитула, ТитулыТ3[0], ЗакрываемаяФорма, ДопПараметрыДействия);
				Иначе
					
					Предупреждение = "Для ввода титула: " + ТипТитула;
					Если Не ЕстьТ2 И Не ЕстьТ3 Тогда
						Предупреждение = Предупреждение +" требуется титул " + ТипТ2 + "(не найден) и титул " + ТипТ3 + "(не найден)";
					Иначе
						Предупреждение = Предупреждение + ?(ЕстьТ2, " требуется титул " + ТипТ3 + "(не найден)", " требуется титул " + ТипТ2 + "(не найден)");	
					КонецЕсли;
					
					КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(Предупреждение);
					
				КонецЕсли;
				
			Иначе	
				Если ЗначениеЗаполнено(НайденныйПредыдущийТитул) Тогда 
					// можем ввести прямо сейчас? требуется ли проверить что есть настройка конвертации?
					// в текущем исполнении просто пробуем через попытку - там или исключение приедет или валидатор запретит, в будущем стоит подстелить соломку пообстоятельней
					КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаИзПредыдущегоТитула(ТипТитула, НайденныйПредыдущийТитул, ЗакрываемаяФорма, ДопПараметрыДействия);				
				Иначе
					КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Для ввода титула: " + ТипТитула + " требуется титул " + ТипНужногоПредыдущегоТитула + "(не найден)");
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Проблема при создании титула: " + Символы.ПС + Символы.ПС + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УбратьПризнакНашПриСменеОкружения() Экспорт
	
	ВсеНашиОрганизации = КонтурЛогистика_ОбщегоНазначенияСервер.ВсеНашиОрганизации();
	КолвоОрг = ВсеНашиОрганизации.Количество();
	
	Если КолвоОрг > 0 Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВсеНашиОрганизации", ВсеНашиОрганизации);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУбратьПризнакНашПриСменеОкруженияЗавершение", КонтурЛогистика_ОбщегоНазначенияКлиент, ДополнительныеПараметры);
		
		Если КолвоОрг % 10 = 1 И КолвоОрг <> 11 Тогда
			ТекстВопроса = "Убрать признак ""Наш"" у " + Строка(КолвоОрг) + " организации?";
		Иначе
			ТекстВопроса = "Убрать признак ""Наш"" у " + Строка(КолвоОрг) + " организаций?";
		КонецЕсли;
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВопросУбратьПризнакНашПриСменеОкруженияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Или Результат = КодВозвратаДиалога.Отмена Тогда
        Возврат;
    КонецЕсли;

    КонтурЛогистика_ОбщегоНазначенияСервер.УбратьПризнакНашУОрганизаций(ДополнительныеПараметры.ВсеНашиОрганизации);
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ОчиститьВсеАвторизации();
	
	Оповестить("ПеречитатьМоиОрганизацииСтартовыйПомошник");

КонецПроцедуры

// Выбор единиц измерения, Характеристик

Функция ЕдинственнаяЕдиницаИзмеренияНоменклатуры(Номенклатура) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСписокЕдиницИзмерения(Номенклатура, СписокВыбора);
	
	Если СписокВыбора.Количество() = 1 Тогда 
		Возврат СписокВыбора[0].Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ЕдиницаИзмеренияНачалоВыбора(Номенклатура, Элемент, Форма, СтандартнаяОбработка, ПараметрыОбработчика = Неопределено) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ОпределитьКонфигурацию();
	
	Если Лев(ИмяКонфигурации, 2) = "КЛ" 
		ИЛИ Лев(ИмяКонфигурации, 2) = "УТ"
		ИЛИ Лев(ИмяКонфигурации, 3) = "УПП"
		ИЛИ Лев(ИмяКонфигурации, 2) = "БП"  
		ИЛИ Лев(ИмяКонфигурации, 2) = "КА"  
		ИЛИ Лев(ИмяКонфигурации, 2) = "УФ" 
		ИЛИ Лев(ИмяКонфигурации, 3) = "ERP" 
		ИЛИ Лев(ИмяКонфигурации, 4) = "УС_3" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ЗначениеЗаполнено(Номенклатура) Тогда 
			
			СписокВыбора = Новый СписокЗначений;
			КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСписокЕдиницИзмерения(Номенклатура, СписокВыбора);
			Если СписокВыбора.Количество() = 0 Тогда 
				КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не удалось найти ни одной единицы измерения для этой номенклатуры.");
			Иначе
				КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьИзСписка_КонтурЛогистика(СписокВыбора, Элемент, Форма, "ЕдиницаИзмеренияНачалоВыбораЗавершение", ПараметрыОбработчика);
			КонецЕсли;
		
		Иначе
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Сначала необходимо выбрать номенклатуру");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ХарактеристикаНачалоВыбора(Номенклатура, текХарактеристика, Элемент, Форма, СтандартнаяОбработка) Экспорт
	
	ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ОпределитьКонфигурацию();
	
	СтандартнаяОбработка = Ложь;
	
	ИмяСправочникаХарКи = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПолучитьИмяСправочникаСущности("Характеристика");
	НастроеныИВключены = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ИспользуютсяХарактеристики() И ИмяСправочникаХарКи <> Неопределено;

	Если Не НастроеныИВключены = Истина Тогда 
		Возврат;		
	КонецЕсли;
	
	//ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	
	ПараметрыВыбора = Новый Структура;
	//ДополнительныеПараметры = Новый Структура("ТекущиеДанные", ТекущиеДанные);
	
	ПараметрыВыбора.Вставить("ТекущийЭлемент"  , текХарактеристика);
	ПараметрыВыбора.Вставить("Номенклатура"    , Номенклатура);
		
	Если ИмяКонфигурации1С = "УФ_УНФ" 
		ИЛИ ИмяКонфигурации1С = "УТ"
		ИЛИ ИмяКонфигурации1С = "УПП" 
		ИЛИ ИмяКонфигурации1С = "КЛ"
		ИЛИ ИмяКонфигурации1С = "КА"
		
		Тогда
		
		ОтборХарактеристик = Новый Структура;
		ОтборХарактеристик.Вставить("Владелец",Номенклатура);
		ПараметрыВыбора.Вставить("Отбор"  , ОтборХарактеристик);
		ПараметрыВыбора.Вставить("ТекущаяСтрока"  , текХарактеристика);
		
	ИначеЕсли ИмяКонфигурации1С = "УФ_УТ" Тогда
		
		ОтборХарактеристик = Новый Структура;
		ОтборХарактеристик.Вставить("Владелец", Номенклатура);
		
		ПараметрыВыбора.Вставить("СтрокаПоиска", "");
		ПараметрыВыбора.Вставить("Отбор", ОтборХарактеристик);
		ПараметрыВыбора.Вставить("ТекущаяСтрока", текХарактеристика);
		
	КонецЕсли;
	
	СписокВыбора = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСписокВыбораСправочника(ИмяСправочникаХарКи, ПараметрыВыбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьИзСписка_КонтурЛогистика(СписокВыбора, Элемент, Форма, "ХарактеристикаНачалоВыбораЗавершение");
	
КонецПроцедуры

