// Вспомогательные

Процедура ПерейтиПоСсылке(СсылкаПерехода) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82()
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		
		ЗапуститьПриложение(СсылкаПерехода);
	Иначе
		ПерейтиПоНавигационнойСсылке(СсылкаПерехода);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуПоПолномуИмени(ПолноеИмяФормы,
										ПараметрыФормы=Неопределено,
										ВладелецФормы=Неопределено,
										КонтекстОбработчика=Неопределено,
										ИмяОбработчика=Неопределено,
										ПараметрыОбработчика=Неопределено,
										РежимОткрытияОкна = Неопределено,
										Уникальность = Ложь)
	
	//@skip-warning
	ОписаниеОбработчика = Неопределено;
	
	// не компилируем этот код на старых платформах - поэтому через Выполнить
	Если Не ИмяОбработчика = Неопределено и Не КонтекстОбработчика = Неопределено Тогда
		ОписаниеОбработчика = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика, ПараметрыОбработчика);
	КонецЕсли;
	
	ОткрытьФорму(ПолноеИмяФормы, ПараметрыФормы, ВладелецФормы, Уникальность, , , ОписаниеОбработчика, РежимОткрытияОкна);
	
КонецПроцедуры

Функция ОткрытьОбычнуюФорму(ПолноеИмяФормы,
							ПараметрыФормы = Неопределено,
							ВладелецФормы  = Неопределено,
							Уникальность = Ложь)
	
	Если ПараметрыФормы <> Неопределено И ПараметрыФормы.Свойство("Отбор") Тогда		
		
		ФормаВыбора = ПолучитьФорму(ПолноеИмяФормы,, ВладелецФормы, Уникальность);		
		
		Для Каждого Элемент Из ПараметрыФормы.Отбор Цикл
			
			ЭлементОтбораФормы = ФормаВыбора.Отбор.Найти(Элемент.Ключ);
			
			Если ЭлементОтбораФормы <> Неопределено Тогда   
				
				Если ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда
					СПЗначений = Новый СписокЗначений;
					СПЗначений.ЗагрузитьЗначения(Элемент.Значение);
				
					ЭлементОтбораФормы.ВидСравнения  = ВидСравнения.ВСписке;
					ЭлементОтбораФормы.Значение		 = СПЗначений;		
					ЭлементОтбораФормы.Использование = Истина;	
				
				Иначе
					
					ЭлементОтбораФормы.Значение		 = Элемент.Значение;		
					ЭлементОтбораФормы.Использование = Истина;
								
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат ФормаВыбора.ОткрытьМодально();
		
	Иначе				
		
		ПараметрыФормы = Новый Структура;
		
		Возврат ПолучитьФорму(ПолноеИмяФормы, ПараметрыФормы, ВладелецФормы, Уникальность, ).ОткрытьМодально();	
		
	КонецЕсли;
		
КонецФункции

#Область Аутентификация

Процедура ПолучениеСессии(Оповещение, ОтборСессий = Неопределено) Экспорт
	
	Аутентификатор = КлиентАутентификации(ОтборСессий);
	Аутентификатор.ОткрытьАутентификатор(Оповещение);
	
КонецПроцедуры

Процедура ОбновитьСессии(Оповещение, ОтборСессий = Неопределено) Экспорт
	
	Аутентификатор = КлиентАутентификации(ОтборСессий);
	Аутентификатор.НачатьОбновлениеСессии(Оповещение);
	
КонецПроцедуры

Процедура ЗавершитьСессию(ОтборСессий) Экспорт
	
	Аутентификатор = КлиентАутентификации(ОтборСессий);
	Аутентификатор.ЗавершитьСессию();
	
КонецПроцедуры

Функция КлиентАутентификации(Знач ОтборСессий = Неопределено)

	ИспользоватьТестовыйСерверДиадок = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользоватьТестовыйСерверДиадок");
	КонфигурацияПриложения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонфигурацияПриложения(ИспользоватьТестовыйСерверДиадок);
	КонфигурацияПровайдера = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонфигурацияПровайдера(ИспользоватьТестовыйСерверДиадок);
	Если ОтборСессий = Неопределено Тогда
		Отбор = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОтборСессий();
	Иначе
		Отбор = ОтборСессий;
	КонецЕсли;
	
	Результат = ПолучитьФорму("Обработка.КонтурЛогистика_Аутентификатор.Форма.Клиент");
	Результат.УстановитьКонфигурациюПриложения(КонфигурацияПриложения);
	Результат.УстановитьКонфигурациюПровайдера(КонфигурацияПровайдера);
	Результат.УстановитьХранилищеСессий("КонтурЛогистика_Аутентификация");
	Результат.УстановитьОтборСессий(Отбор);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти