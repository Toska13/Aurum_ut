Функция ПреобразоватьXMLвHTML(ТекстXML) Экспорт
	
	Если ТекстXML = "" Тогда
		Возврат "";
	КонецЕсли;
		
	ТекстHTML = ТекстXML;
	
	Попытка
		ТаблицаСтилейXSL = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ПолучитьТаблицуСтилейXSL();
		#Если ВебКлиент Тогда
			ОписаниеОшибки = "Не поддерживается в веб-клиенте";
		ТекстHTML = "<!DOCTYPE html><html><head></head><body>Не удалось преобразовать в HTML: " + ОписаниеОшибки + "</body></html>"; 
		#Иначе
		Преобразование = Новый ПреобразованиеXSL;
		Преобразование.ЗагрузитьТаблицуСтилейXSLИзСтроки(ТаблицаСтилейXSL);
		ТекстHTML = Преобразование.ПреобразоватьИзСтроки(ТекстXML);
		#КонецЕсли
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстHTML = "<!DOCTYPE html><html><head></head><body>Не удалось преобразовать в HTML: " + ОписаниеОшибки + "</body></html>"; 
		МетрикаОшибка = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка");
		КонтурЛогистика_Метрика.Метрика_Отправить_Ошибку(МетрикаОшибка, "ПреобразоватьXMLвHTML", ОписаниеОшибки);
	КонецПопытки;
	
	Возврат ТекстHTML;
	
КонецФункции

Процедура УстановитьФорматКолонкиКоличества(ТабличнаяЧасть, ИмяРеквизита, Поле) Экспорт
	
	ЗнаковПослеЗапятой = 0;
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		
		Дробь = Строка[ИмяРеквизита] - Цел(Строка[ИмяРеквизита]);
		Дробь = ?(Дробь < 0, -Дробь, Дробь);// 0.123
		Знаков = СтрДлина(Дробь) - 2;
		Знаков = ?(Знаков > 0, Знаков, 0);
		ЗнаковПослеЗапятой = Макс(Знаков, ЗнаковПослеЗапятой);
		
	КонецЦикла;
	
	Поле.Формат = "ЧДЦ=" + ЗнаковПослеЗапятой;
	
КонецПроцедуры

Процедура УстановитьВидимостьКолонкиПоЗаполненностиЗначения(ТабличнаяЧасть, ИмяРеквизита, ЭлементФормы) Экспорт
	
	ЕстьХоть1Значение = Ложь;
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		
		Значение = Строка[ИмяРеквизита];
		Если ЗначениеЗаполнено(Значение) Тогда 
			ЕстьХоть1Значение = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ЭлементФормы.Видимость = ЕстьХоть1Значение;
	
КонецПроцедуры

Процедура ПриОткрытииНаКлиенте(Форма, Отказ) Экспорт
	
	Если Не Форма.Параметры.Свойство("Ключ") Тогда
		КонтурЛогистика_ОбновлениеКлиент.ПроверитьНаличиеУведомлений(Форма);
		Возврат;
	КонецЕсли;
	
	Если Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Форма.Параметры.Ключ)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Форма.Параметры.Ключ)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Форма.Параметры.Ключ) Тогда
		
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.Параметры.Ключ) Тогда
		ДокументОснование = КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Форма.Параметры.Ключ, "ДокументОснование");
	Иначе
		ДокументОснование = Форма.Объект.ДокументОснование;
	КонецЕсли;
	
	Если ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
		Или ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		
		Если Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен")
			Или Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки")
			Или Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением") Тогда
			
			КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(Форма, ДокументОснование);
		КонецЕсли;
		
	Иначе
		КонтурЛогистика_РаботаСЭлементамиФормыКлиент.УправлениеЭлементамиДокументОснование(Форма, ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры

// ОткрытьФорму
Функция ОткрытьФорму_Подсистемы(ИмяФормы, 
								ПараметрыФормы = Неопределено, 
								ВладелецФормы = Неопределено, 
								КонтекстОбработчика = Неопределено, 
								ИмяОбработчика = Неопределено,
								ПараметрыОбработчика = Неопределено,
								РежимОткрытияОкна = Неопределено,
								Уникальность = Ложь) Экспорт
									
	Если РежимОткрытияОкна = Неопределено Тогда
		РежимОткрытияОкна =	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;
	               
	ПолноеИмяФормы = ИмяФормы;
		
	ОткрытьФормуПоПолномуИмени(ПолноеИмяФормы, ПараметрыФормы, ВладелецФормы, КонтекстОбработчика, ИмяОбработчика, ПараметрыОбработчика, РежимОткрытияОкна, Уникальность);
	
	Возврат Неопределено;	
	
КонецФункции

Функция ОткрытьФорму_УчетнойСистемы(ИмяФормы, 
								ПараметрыФормы = Неопределено, 
								ВладелецФормы = Неопределено, 
								КонтекстОбработчика = Неопределено, 
								ИмяОбработчика = Неопределено,
								ПараметрыОбработчика = Неопределено,
								РежимОткрытияОкна = Неопределено,
								Уникальность = Ложь) Экспорт
									
	Если РежимОткрытияОкна = Неопределено Тогда
		РежимОткрытияОкна =	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;
	               
	ПолноеИмяФормы = ИмяФормы;
	
	Попытка
		ЭтоУправляемаяФорма = ТипЗнч(ПолучитьФорму(ПолноеИмяФормы))= Тип("УправляемаяФорма")
	Исключение
		ЭтоУправляемаяФорма = Истина;
	КонецПопытки;
		
	Если ЭтоУправляемаяФорма Тогда
		
		ОткрытьФормуПоПолномуИмени(ПолноеИмяФормы, ПараметрыФормы, ВладелецФормы, КонтекстОбработчика, ИмяОбработчика, ПараметрыОбработчика, РежимОткрытияОкна, Уникальность);
		
	Иначе // Обычная форма
	
		Результат = ОткрытьОбычнуюФорму(ПолноеИмяФормы, ПараметрыФормы, ВладелецФормы, Уникальность);
		Если Не ИмяОбработчика = Неопределено и Не КонтекстОбработчика = Неопределено Тогда 
			Выполнить("КонтекстОбработчика." + ИмяОбработчика + "(Результат, ПараметрыОбработчика);");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции

Процедура ПоказатьФормуНастройки(ИмяНастройки,
									КонтекстОбработчика = Неопределено,
									ИмяОбработчика = Неопределено,
									ПараметрыОбработчика = Неопределено) Экспорт

	ОбщаяНастройка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройку_(ИмяНастройки);
	
	Если ЗначениеЗаполнено(ОбщаяНастройка) Тогда
		ПоказатьЗначение_КонтурЛогистика(ОбщаяНастройка, КонтекстОбработчика, ИмяОбработчика, ПараметрыОбработчика);
	Иначе
		Предупреждение_КонтурЛогистика("Настройка " + ИмяНастройки + " не найдена",,, КонтекстОбработчика, ИмяОбработчика, ПараметрыОбработчика);
	КонецЕсли;

КонецПроцедуры

Процедура ПерейтиПоКолбасеКТитулу(ФормаТитула, ВыбранныйЭлементФормы) Экспорт

	ТекТитулСсылка = ФормаТитула.Объект.Ссылка;
		
	Если ТипЗнч(ТекТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда 
		ТипОткрытогоСейчасТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПустаяСсылка");
	Иначе
		ТипОткрытогоСейчасТитула =  КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТекТитулСсылка);
	КонецЕсли;
	
	Если КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулПЛ_5_02(ТекТитулСсылка) Тогда
		
		Если Прав(ВыбранныйЭлементФормы.Имя, 3) = "доп" Тогда 
			НомерТитула = Лев(Прав(ВыбранныйЭлементФормы.Имя, 4),1) + "_5_02";
		Иначе
			НомерТитула = Прав(ВыбранныйЭлементФормы.Имя, 1) + "_5_02";
		КонецЕсли;
		
		ТипОткрываемогоТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул" + НомерТитула);
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовКлиент.ЭтоТитулПЛ(ТекТитулСсылка) Тогда
		
		Если Прав(ВыбранныйЭлементФормы.Имя, 3) = "доп" Тогда 
