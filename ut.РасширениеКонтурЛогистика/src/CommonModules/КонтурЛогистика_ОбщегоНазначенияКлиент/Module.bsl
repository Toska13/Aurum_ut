// Представление данных границы синхронизации
//
// Параметры:
//  ДанныеГраницы	 - Структура	 - см. Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьМинимальнуюДатуГраницыСинхронизации().
// 
// Возвращаемое значение:
//  Структура - 
//    * Видимость - Булево - Признак видимости элемента.
//    * Заголовок - Строка - Заголовок элемента.
//    * ЦветТекста - Цвет - Цвет еткста элемента.
//
Функция ПредставлениеДанныхГраницыСинхронизации(ДанныеГраницы) Экспорт
	
	ПредставлениеДанных = Новый Структура;
	ПредставлениеДанных.Вставить("Видимость", Ложь);
	ПредставлениеДанных.Вставить("Заголовок", "Обмен не выполнялся");
	ПредставлениеДанных.Вставить("ЦветТекста", Новый Цвет(255, 0, 0));
	
	Если ДанныеГраницы = Неопределено Тогда
		
		// TODO отправлять метрику
		Возврат ПредставлениеДанных;
		
	КонецЕсли;
	
	ДатаГраницыСинхронизацииМСК = ДанныеГраницы.ДатаГраницыСинхронизации;
	ОрганизацияГраницыСинхронизации = ДанныеГраницы.Организация;
	
	Если Не ЗначениеЗаполнено(ДатаГраницыСинхронизацииМСК) Тогда 
		
		ПредставлениеДанных.Видимость = Истина;
		ПредставлениеДанных.Заголовок = "Обмен не выполнялся";
		
	Иначе
		
		ТекМоментМСК = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
		ДатаГраницыСинхронизацииТек = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ВремяВТекущемПоясеИзМСК(ДатаГраницыСинхронизацииМСК);
		ПрошлоВремени = ТекМоментМСК - ДатаГраницыСинхронизацииМСК;
		
		Если ПрошлоВремени > 1200 Тогда
			
			ПредставлениеДанных.ЦветТекста = Новый Цвет(255, 0, 0);
			
			Дней = Окр(ПрошлоВремени / 86400);
			Часов = Окр(ПрошлоВремени / 3600);
			Минут = Окр(ПрошлоВремени / 60);
			Если Дней > 0 Тогда
				Срок = "" + Дней + " " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьДниВСклонении(Дней);
				ТекстПредупрежденияОбмена = "Обмен давно не выполнялся (" + Срок + ")";
			ИначеЕсли Часов > 0 Тогда
				Срок = "" + Часов + " " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьЧасыВСклонении(Часов);
				ТекстПредупрежденияОбмена = "Обмен давно не выполнялся (" + Срок + ")";
			Иначе
				Срок = "" + Минут + " минут";
				ТекстПредупрежденияОбмена = "Обмен не выполнялся " + Срок + "";
				ПредставлениеДанных.ЦветТекста = Новый Цвет(51, 51, 51);
			КонецЕсли;
			
			ПредставлениеДанных.Видимость = Истина;
			ПредставлениеДанных.Заголовок = ТекстПредупрежденияОбмена;
			
		Иначе
			
			ПредставлениеДанных.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПредставлениеДанных;
	
КонецФункции

