// ПоказатьПредупреждение
Функция Предупреждение_КонтурЛогистика(ТекстПредупреждения, 
									Заголовок = "Контур.Логистика", 
									Таймаут = 0, 
									КонтекстОбработчика = Неопределено, 
									ИмяОбработчика = Неопределено,
									ПараметрыОбработчика = Неопределено) Экспорт
									
	Если СокрЛП(ТекстПредупреждения) = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеОбработчика = Неопределено;
	Если Не ИмяОбработчика = Неопределено и Не КонтекстОбработчика = Неопределено Тогда
		ОписаниеОбработчика = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика, ПараметрыОбработчика);
	КонецЕсли;
	ПоказатьПредупреждение(ОписаниеОбработчика, ТекстПредупреждения, Таймаут, Заголовок);
		
	Возврат Неопределено;
	
КонецФункции

Функция Вопрос_КонтурЛогистика(ТекстВопроса,
									КнопкиИлиРежимДиалогаВопрос = Неопределено,
									Заголовок = "Контур.Логистика", 
									Таймаут = 0, 
									КонтекстОбработчика = Неопределено, 
									ИмяОбработчика = Неопределено,
									ПараметрыОбработчика = Неопределено) Экспорт
									
	Если СокрЛП(ТекстВопроса) = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КнопкиИлиРежимДиалогаВопрос = Неопределено Тогда
		
		КнопкиИлиРежимДиалогаВопрос = РежимДиалогаВопрос.ДаНетОтмена;
	
	КонецЕсли;
	
	ОписаниеОбработчика = Неопределено;
	Если Не ИмяОбработчика = Неопределено и Не КонтекстОбработчика = Неопределено Тогда
		ОписаниеОбработчика = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика, ПараметрыОбработчика);
	КонецЕсли;
	ПоказатьВопрос(ОписаниеОбработчика, ТекстВопроса, КнопкиИлиРежимДиалогаВопрос, Таймаут, , Заголовок);
		
	Возврат Неопределено;
	
КонецФункции

// ПоказатьВыборИзСписка
Функция ВыбратьИзСписка_КонтурЛогистика(СписокЗначений,
									ЭлементФормы = Неопределено,
									КонтекстОбработчика, 
									ИмяОбработчика,
									ПараметрыОбработчика = Неопределено,
									Форма = Неопределено) Экспорт
									
	Если ТипЗНЧ(СписокЗначений) <> Тип("СписокЗначений") ИЛИ СписокЗначений.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Форма = Неопределено Тогда 
		Форма = КонтекстОбработчика;
	КонецЕсли;
	
	ОписаниеОбработчика = Новый ОписаниеОповещения(ИмяОбработчика, КонтекстОбработчика, ПараметрыОбработчика);
	Форма.ПоказатьВыборИзСписка(ОписаниеОбработчика, СписокЗначений, ЭлементФормы);
		
	Возврат Неопределено;
	
КонецФункции

