#Область ПрограммныйИнтерфейс

Функция ТребуетсяОтправкаУведомленияОЗамечаниях(Титул) Экспорт
	
	ТипТитула = ТипЗнч(Титул);
	
	Если ТипТитула = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
		Или ТипТитула = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4") Тогда
		
		РеквизитыТитула = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			Титул, "ЕстьОтметкиПеревозчика, ЕстьЗамечанияПеревозчика");
		
		Если РеквизитыТитула.ЕстьОтметкиПеревозчика Или РеквизитыТитула.ЕстьЗамечанияПеревозчика Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ОтправитьУведомленияОЗамечанияхВодителя(ДокументЭТРН, ЗамечанияВодителя, ЭтоПогрузка, Титул2_4 = Неопределено) Экспорт
	
	// Определяем использованность каналов отправки
	ИспользоватьОтправкуВТелеграм = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
	Если Не ИспользоватьОтправкуВТелеграм И Не ИспользоватьОтправкуНаПочту Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ДокументЭТРН,
		"ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку, ПогрузкуОсуществляет, Грузоотправитель, Перевозчик, Грузополучатель,
		|МестоПогрузки, МестоДоставки");
	
	Если ЗамечанияВодителя = Неопределено Тогда
		ИмяРеквизита = "ТрНЗамечанияОтПеревозчика";
		ЭтоЗамечанияПеревозчика = Истина;
	Иначе
		ИмяРеквизита = "ТрНЗамечанияОтВодителя";
		ЭтоЗамечанияПеревозчика = Ложь;
	КонецЕсли;
	
	// Определяем получателей
	ОбъектыСКонтактами = Новый Массив;
	Если РеквизитыЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку И ЗначениеЗаполнено(РеквизитыЭТРН.ПогрузкуОсуществляет) Тогда	// ГО
		ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.ПогрузкуОсуществляет);
	Иначе
		ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.Грузоотправитель);
	КонецЕсли;
	ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.Перевозчик);
	Если ЭтоПогрузка Тогда
		ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.МестоПогрузки);
	Иначе
		ВсеПереадресации = Документы.КонтурЛогистика_ТрН_Титул7.ВсеПереадресации(ДокументЭТРН);
		Если ВсеПереадресации.Количество() = 0 Тогда
			ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.МестоДоставки);
			ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.Грузополучатель);
		Иначе
			ПоследняяПереадресация = ВсеПереадресации[ВсеПереадресации.Количество() - 1];
			ОбъектыСКонтактами.Добавить(ПоследняяПереадресация.МестоДоставки);
			ОбъектыСКонтактами.Добавить(ПоследняяПереадресация.Грузополучатель);
		КонецЕсли;
	КонецЕсли;
	
	КонтактнаяИнформация = КонтактнаяИнформация(ОбъектыСКонтактами, ИмяРеквизита);
	
	Если КонтактнаяИнформация.НомераТелефонов.Количество() = 0 И КонтактнаяИнформация.АдресаЭлектронныхПочт.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем сообщения
	ДанныеДляСообщений = ДанныеПоДокументу(ДокументЭТРН);
	
	// При отправке Т2 и Т4 у нас нет данных водителя, тогда считаем что мы перевозчик и данные берем из Т2 и Т4
	Если ЭтоЗамечанияПеревозчика Тогда
		Замечания = ЗамечанияИзТитула(Титул2_4);
		ОтветственноеЛицо = "Перевозчик";
	Иначе
		Замечания = ЗамечанияВодителя;
		ОтветственноеЛицо = "Водитель";
	КонецЕсли;
	
	Если ИспользоватьОтправкуВТелеграм И КонтактнаяИнформация.НомераТелефонов.Количество() <> 0 Тогда
		// Заголовок
		ШаблонЗаголовка = "<b>%1</b>
			|ЭТрН №%2 от %3";
		ТекстЗаголовка = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка,
			?(ЭтоПогрузка, "П О Г Р У З К А", "Р А З Г Р У З К А"),
			СокрЛП(ДанныеДляСообщений.НомерДокумента),
			Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
		
		ТекстСообщения = ТекстСообщенияСЗамечаниями(ДанныеДляСообщений, Замечания, ТекстЗаголовка, ЭтоПогрузка, ОтветственноеЛицо, Ложь);
		
		НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
		НовоеСообщение.Тип = "text";
		НовоеСообщение.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(ТекстСообщения);
		
		Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовоеСообщение);
		
		Для Каждого ТекущийНомерТелефона Из КонтактнаяИнформация.НомераТелефонов Цикл
			КонтурЛогистика_РаботаСТелеграм.ОтправитьСообщения(ТекущийНомерТелефона, Сообщения)
		КонецЦикла;
	КонецЕсли;
	
	Если ИспользоватьОтправкуНаПочту И КонтактнаяИнформация.АдресаЭлектронныхПочт.Количество() <> 0 Тогда
		// Заголовок
		ШаблонЗаголовка = "%1: ЭТрН №%2 от %3";
		ТекстЗаголовка = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка,
			?(ЭтоПогрузка, "Погрузка", "Разгрузка"),
			СокрЛП(ДанныеДляСообщений.НомерДокумента),
			Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
		
		ТекстСообщения = ТекстСообщенияСЗамечаниями(ДанныеДляСообщений, Замечания, ТекстЗаголовка, ЭтоПогрузка, ОтветственноеЛицо, Истина);
		
		ШаблонПисьма = ТекстПисьмаСЗамечаниями();
		ШаблонПисьма = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонПисьма, ТекстСообщения);
		
		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Тема = ТекстЗаголовка;
		Письмо.Тексты.Добавить(ШаблонПисьма, ТипТекстаПочтовогоСообщения.HTML);
		
		Для Каждого ТекущийАдресПочты Из КонтактнаяИнформация.АдресаЭлектронныхПочт Цикл
			Письмо.Получатели.Добавить(ТекущийАдресПочты);
		КонецЦикла;
		
		ТекстОшибки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ЗаписьЖурналаРегистрации("КонтурЛогистика_ОтправкаУведомлений",
				УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправитьУведомленияОНеобходимостиПодписатьВодителем(Документ, Состояние) Экспорт
	
	ПовтИсп = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп;
	
	ОтправлятьУведомленияВодителюПоставитьПодпись = ПовтИсп.ЗначениеНастройки(
		"ОтправлятьУведомленияВодителюПоставитьПодпись");
	
	// Определяем использованность каналов отправки
	ИспользоватьОтправкуВТелеграм = ПовтИсп.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
	// особенности отправки в адрес партнера перевозчика
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") 
		И ЗначениеЗаполнено(Документ)
		И ЗначениеЗаполнено(Документ.ПартнерПеревозчик) Тогда
			
		ИспользоватьОтправкуВТелеграм 					= ПовтИсп.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм", Документ.ПартнерПеревозчик);
		ОтправлятьУведомленияВодителюПоставитьПодпись 	= ПовтИсп.ЗначениеНастройки("ОтправлятьУведомленияВодителюПоставитьПодпись", Документ.ПартнерПеревозчик);

	КонецЕсли;
	 
	Если Не ОтправлятьУведомленияВодителюПоставитьПодпись Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИспользоватьОтправкуВТелеграм И Не ИспользоватьОтправкуНаПочту Тогда
		Возврат;
	КонецЕсли;
	
	Если Состояние = "r-wait-driver-approve"
		Или Состояние = "r-wait-driver-draftApprove" Тогда
		
		ЭтоПогрузка = Истина;
	Иначе
		ЭтоПогрузка = Ложь;
	КонецЕсли;
	
	ДанныеДляСообщений = ДанныеПоДокументу(Документ);
	
	Если ИспользоватьОтправкуВТелеграм
		И (ЗначениеЗаполнено(ДанныеДляСообщений.Телефон1) Или ЗначениеЗаполнено(ДанныеДляСообщений.Телефон2)) Тогда
		
		ТелефоныДляОтправки = Новый Массив;
		
		ТекстСообщения = ТекстСообщенияОНеобходимостиПодписатьВодителем(ДанныеДляСообщений, ЭтоПогрузка, Ложь);
		
		НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
		НовоеСообщение.Тип = "text";
		НовоеСообщение.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(ТекстСообщения);
		
		Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовоеСообщение);
		
		Если ЗначениеЗаполнено(ДанныеДляСообщений.Телефон1) Тогда
			РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(ДанныеДляСообщений.Телефон1, Сообщения);
			ТелефоныДляОтправки.Добавить(ДанныеДляСообщений.Телефон1);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеДляСообщений.Телефон2) Тогда
			РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ДобавитьВОчередь(ДанныеДляСообщений.Телефон2, Сообщения);
			ТелефоныДляОтправки.Добавить(ДанныеДляСообщений.Телефон2);
		КонецЕсли;
		
		РегистрыСведений.КонтурЛогистика_ОчередьОтправкиСообщенийВТелеграм.ОтправитьСообщения(ТелефоныДляОтправки);
	КонецЕсли;
	
	Если ИспользоватьОтправкуНаПочту
		И (ЗначениеЗаполнено(ДанныеДляСообщений.АдресПочтыСотрудника1) Или ЗначениеЗаполнено(ДанныеДляСообщений.АдресПочтыСотрудника2)) Тогда
		
		// Заголовок
		ШаблонЗаголовка = "%1: ЭТрН №%2 от %3";
		ТекстЗаголовка = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка,
			?(ЭтоПогрузка, "Погрузка", "Разгрузка"),
			СокрЛП(ДанныеДляСообщений.НомерДокумента),
			Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
		
		ТекстСообщения = ТекстСообщенияОНеобходимостиПодписатьВодителем(ДанныеДляСообщений, ЭтоПогрузка, Истина);
		
		ШаблонПисьма = ТекстПисьмаСЗамечаниями();
		ШаблонПисьма = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонПисьма, ТекстСообщения);
		
		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Тема = ТекстЗаголовка;
		Письмо.Тексты.Добавить(ШаблонПисьма, ТипТекстаПочтовогоСообщения.HTML);
		
		Если ЗначениеЗаполнено(ДанныеДляСообщений.АдресПочтыСотрудника1) Тогда
			Письмо.Получатели.Добавить(ДанныеДляСообщений.АдресПочтыСотрудника1);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеДляСообщений.АдресПочтыСотрудника2) Тогда
			Письмо.Получатели.Добавить(ДанныеДляСообщений.АдресПочтыСотрудника2);
		КонецЕсли;
		
		ТекстОшибки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ЗаписьЖурналаРегистрации("КонтурЛогистика_ОтправкаУведомлений",
				УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОтправитьУведомленияОбОтказеИлиЧастичнойПриемкеТрН(ДокументОбъект) Экспорт
	
	// Определяем использованность каналов отправки
	ИспользоватьОтправкуВТелеграм = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
	Если Не ИспользоватьОтправкуВТелеграм И Не ИспользоватьОтправкуНаПочту Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	ЭтоТ2 = (ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул2"));
	Если ЭтоТ2 Тогда
		ЗаголовокСообщенияТелеграм = "О Т К А З   П Р И   П О Г Р У З К Е";
		ЗаголовокСообщенияПочта = "Отказ при погрузке";
		
		ИмяРеквизитаКонтактнойИнформации = "ТрНОтказПВ";
		ЭтоПогрузка = Истина;
		ПричинаОтказа = ДокументОбъект.ПричинаОтказаВПодписи;
		СостояниеГруза = "";
	Иначе
		Если ДокументОбъект.ПринятьЧастично Тогда
			ЗаголовокСообщенияТелеграм = "Ч А С Т И Ч Н А Я   П Р И Е М К А";
			ЗаголовокСообщенияПочта = "Частичная приемка";
		Иначе
			ЗаголовокСообщенияТелеграм = "О Т К А З   П Р И   Р А З Г Р У З К Е";
			ЗаголовокСообщенияПочта = "Отказ при разгрузке";
		КонецЕсли;
		
		ИмяРеквизитаКонтактнойИнформации = "ТрНОтказГП";
		ЭтоПогрузка = Ложь;
		ПричинаОтказа = ДокументОбъект.ПричОтк;
		СостояниеГруза = ДокументОбъект.ОбщееСостояние;
	КонецЕсли;
	
	РеквизитыЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(ДокументОбъект.ДокументЭТРН,
		"ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку, ПогрузкуОсуществляет, Грузоотправитель, Перевозчик, Грузополучатель,
		|МестоПогрузки, МестоДоставки");
	
	ОбъектыСКонтактами = Новый Массив;
	
	// Место погрузки/разгрузки
	Если ЭтоТ2 Тогда
		ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.МестоПогрузки);
	Иначе
		ВсеПереадресации = Документы.КонтурЛогистика_ТрН_Титул7.ВсеПереадресации(ДокументОбъект.ДокументЭТРН);
		Если ВсеПереадресации.Количество() = 0 Тогда
			ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.МестоДоставки);
		Иначе
			ПоследняяПереадресация = ВсеПереадресации[ВсеПереадресации.Количество() - 1];
			ОбъектыСКонтактами.Добавить(ПоследняяПереадресация.МестоДоставки);
		КонецЕсли;
	КонецЕсли;
	
	// Грузоотправитель
	Если РеквизитыЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку
		И ЗначениеЗаполнено(РеквизитыЭТРН.ПогрузкуОсуществляет) Тогда
		
		ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.ПогрузкуОсуществляет);
	Иначе
		ОбъектыСКонтактами.Добавить(РеквизитыЭТРН.Грузоотправитель);
	КонецЕсли;
	
	КонтактнаяИнформация = КонтактнаяИнформация(ОбъектыСКонтактами, ИмяРеквизитаКонтактнойИнформации, ДокументОбъект.ДокументЭТРН);
	
	Если КонтактнаяИнформация.НомераТелефонов.Количество() = 0 И КонтактнаяИнформация.АдресаЭлектронныхПочт.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеДляСообщений = ДанныеПоДокументу(ДокументОбъект.ДокументЭТРН);
	Если ИспользоватьОтправкуВТелеграм И КонтактнаяИнформация.НомераТелефонов.Количество() <> 0 Тогда
		// Заголовок
		ШаблонЗаголовка = "<b>%1</b>
			|ЭТрН №%2 от %3";
		ТекстЗаголовка = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка,
			ЗаголовокСообщенияТелеграм,
			СокрЛП(ДанныеДляСообщений.НомерДокумента),
			Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
		
		ТекстСообщения = ТекстСообщенияОтказа(ДанныеДляСообщений, ТекстЗаголовка, ЭтоПогрузка, ПричинаОтказа, СостояниеГруза, Ложь);
		
		НовоеСообщение = КонтурЛогистика_РаботаСТелеграм.МанифестСообщения();
		НовоеСообщение.Тип = "text";
		НовоеСообщение.Данные = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьДвоичныеДанныеИзСтроки_КонтурЛогистика(ТекстСообщения);
		
		Сообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовоеСообщение);
		
		Для Каждого ТекущийНомерТелефона Из КонтактнаяИнформация.НомераТелефонов Цикл
			КонтурЛогистика_РаботаСТелеграм.ОтправитьСообщения(ТекущийНомерТелефона, Сообщения)
		КонецЦикла;
		
		Результат = Истина;
	КонецЕсли;
	
	Если ИспользоватьОтправкуНаПочту И КонтактнаяИнформация.АдресаЭлектронныхПочт.Количество() <> 0 Тогда
		// Заголовок
		ШаблонЗаголовка = "%1: ЭТрН №%2 от %3";
		ТекстЗаголовка = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонЗаголовка,
			ЗаголовокСообщенияПочта,
			СокрЛП(ДанныеДляСообщений.НомерДокумента),
			Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
		
		ТекстСообщения = ТекстСообщенияОтказа(ДанныеДляСообщений, ТекстЗаголовка, ЭтоПогрузка, ПричинаОтказа, СостояниеГруза, Истина);
		
		ШаблонПисьма = ТекстПисьмаСЗамечаниями();
		ШаблонПисьма = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонПисьма, ТекстСообщения);
		
		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Тема = ТекстЗаголовка;
		Письмо.Тексты.Добавить(ШаблонПисьма, ТипТекстаПочтовогоСообщения.HTML);
		
		Для Каждого ТекущийАдресПочты Из КонтактнаяИнформация.АдресаЭлектронныхПочт Цикл
			Письмо.Получатели.Добавить(ТекущийАдресПочты);
		КонецЦикла;
		
		КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Данные по документу для формирования сообщений и писем.
//
// Параметры:
//  ДокументСсылка		 - ДокументСсылка	 - отправляемый титул.
// 
// Возвращаемое значение:
//  Структура -  данные для формирования письма.
//
Функция ДанныеПоДокументу(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыОтправки = Новый Структура(
		"kl_id, Титул, Документ, НомерДокумента, ДатаДокумента,
		|ДокументГрузоотправитель, ДокументПеревозчик, ДокументГрузополучатель,
		|ТранспортноеСредство, ГосНомерАвто, МаркаАвто,
		|Прицеп, ГосНомерПрицеп, Прицеп2, ГосНомерПрицеп2,
		|GLNПогрузки, МестоПогрузки, АдресОткуда,
		|GLNДоставки, МестоДоставки, АдресКуда,
		|ПогрузкаДатаВремяПрибытия, ПогрузкаДатаВремяУбытия,
		|ВыгрузкаДатаВремяПрибытия, ВыгрузкаДатаВремяУбытия,
		|Дата1, Дата2,
		|КоличествоМест, ОбщаяМасса,
		|УИДМинтранса,
		|Сотрудник1, АдресПочтыСотрудника1, Телефон1,
		|Сотрудник2, АдресПочтыСотрудника2, Телефон2");
	
	ДокументОснования = ДокументОснования(ДокументСсылка);
	Если ДокументОснования = Неопределено Тогда
		ДокументОснования = ДокументСсылка;
	КонецЕсли;
	
