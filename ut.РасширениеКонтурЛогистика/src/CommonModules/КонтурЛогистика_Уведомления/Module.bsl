	|	<br><div class=""css-line""></div>
	|	<p class=""gray"">Письмо сформировано автоматически, отвечать на него не нужно.</p>
	|</body></html>";
	
КонецФункции

Функция ТекстСообщенияОНеобходимостиПодписатьВодителем(ДанныеДляСообщений, ЭтоПогрузка, ФорматHTML)
	
	// Текст сообщения
	Если ФорматHTML Тогда
		ШаблонСтрокиДанных = "<tr><th>%1</th><td>%2</td></tr>";
	Иначе
		ШаблонСтрокиДанных = "%1: %2";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	// Ссылка для подписания
	ШаблонСтрокиСсылки = "<a href=""%1"">%2</a>";
	Если ЭтоПогрузка Тогда
		ТекстПредставлениеСсылки = "СОГЛАСОВАТЬ ПОГРУЗКУ";
	Иначе
		ТекстПредставлениеСсылки = "СОГЛАСОВАТЬ РАЗГРУЗКУ";
	КонецЕсли;
	ТекстСсылки = "https://driver.kontur.ru/transportations/" + ?(ЭтоПогрузка, "reception", "delivery")
		+ "/view_trn/" + Строка(ДанныеДляСообщений.kl_id);
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиСсылки,
		ТекстСсылки, ТекстПредставлениеСсылки));
	
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("<b>№%1 от %2</b>",
		СокрЛП(ДанныеДляСообщений.НомерДокумента),
		Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;")) + ?(ФорматHTML, "<br><br>", Символы.ПС));
	
	//
	
	// Данные ЭТРН
	Если ФорматHTML Тогда
		Строки.Добавить("<table class=""table table-condensed"">");
		Строки.Добавить("<tbody>");
	КонецЕсли;
	
	// Откуда / куда
	Если ФорматHTML Тогда
		Если ЭтоПогрузка Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДанных,
				"Адрес", ДанныеДляСообщений.АдресОткуда));
		Иначе
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДанных,
				"Адрес", ДанныеДляСообщений.АдресКуда));
		КонецЕсли;
	Иначе
		Если ЭтоПогрузка Тогда
			Строки.Добавить(ДанныеДляСообщений.АдресОткуда);
		Иначе
			Строки.Добавить(ДанныеДляСообщений.АдресКуда);
		КонецЕсли;
	КонецЕсли;
	
	// Прибыл
	Если ЭтоПогрузка Тогда
		ДатаВремяПрибытия = ДанныеДляСообщений.ПогрузкаДатаВремяПрибытия;
	Иначе
		ДатаВремяПрибытия = ДанныеДляСообщений.ВыгрузкаДатаВремяПрибытия;
	КонецЕсли;
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДанных,
		"Прибыл", ДатаВремяПрибытия));
	
	// Госномер
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДанных,
		"Госномер", ДанныеДляСообщений.ГосНомерАвто));
	
	Если ФорматHTML Тогда
		Строки.Добавить("</tbody></table>");
	КонецЕсли;
	
	ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	
	Возврат ТекстСообщения;
	
КонецФункции

Функция ДокументОснования(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ДокументОснования
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул1.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН КАК ДокументОснования
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул2.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул7.ДокументЭТРН
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул7 КАК КонтурЛогистика_ТрН_Титул7
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул7.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул8.ДокументЭТРН
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул8 КАК КонтурЛогистика_ТрН_Титул8
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул8.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул2.Титул1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул2.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул3.Титул1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул3 КАК КонтурЛогистика_ПЛ_Титул3
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул3.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул4.Титул1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул4 КАК КонтурЛогистика_ПЛ_Титул4
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул4.Ссылка = &ДокументСсылка	
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул2.Титул1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул2_5_02 КАК КонтурЛогистика_ПЛ_Титул2
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул2.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул3.Титул1
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул3_5_02 КАК КонтурЛогистика_ПЛ_Титул3
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул3.Ссылка = &ДокументСсылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДокументОснования;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДополнитьПараметрыОтправкиТитул7(ПараметрыОтправки, Титул)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титул", Титул);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул3.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ТрН_Титул3.Дата КАК Дата,
	|	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул3.КоличествоМестПринято, 0) КАК КоличествоМестПринято,
	|	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.КоличествоМест, 0) КАК КоличествоМест,
	|	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул3.МассаБруттоКг, 0) КАК МассаБруттоКгПринято,
	|	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.МассаБруттоКг, 0) КАК МассаБруттоКг
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул7 КАК КонтурЛогистика_ТрН_Титул7
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул3 КАК КонтурЛогистика_ТрН_Титул3
	|		ПО КонтурЛогистика_ТрН_Титул7.ДокументЭТРН = КонтурЛогистика_ТрН_Титул3.ДокументЭТРН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|		ПО КонтурЛогистика_ТрН_Титул7.ДокументЭТРН = КонтурЛогистика_ТрН_Титул1.ДокументЭТРН
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул7.Ссылка = &Титул
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПараметрыОтправки.КоличествоМест = Выборка.КоличествоМест - Выборка.КоличествоМестПринято;
		ПараметрыОтправки.ОбщаяМасса = Выборка.МассаБруттоКг - Выборка.МассаБруттоКгПринято;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьПараметрыОтправкиТитул8(ПараметрыОтправки, Титул)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титул", Титул);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул8НовыеВодители.Водитель КАК Водитель,
	|	КонтурЛогистика_ТрН_Титул8НовыеВодители.Водитель.АдресЭлектроннойПочты КАК ВодительАдресЭлектроннойПочты,
	|	КонтурЛогистика_ТрН_Титул8НовыеВодители.Водитель.ТелефонОсновной КАК ВодительТелефонОсновной
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул8.НовыеВодители КАК КонтурЛогистика_ТрН_Титул8НовыеВодители
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул8НовыеВодители.Ссылка = &Титул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул8НовыеТранспортныеСредства.ТранспортноеСредство КАК ТранспортноеСредство,
	|	КонтурЛогистика_ТрН_Титул8НовыеТранспортныеСредства.ТранспортноеСредство.РегНомер КАК ГосНомерАвто
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул8.НовыеТранспортныеСредства КАК КонтурЛогистика_ТрН_Титул8НовыеТранспортныеСредства
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул8НовыеТранспортныеСредства.Ссылка = &Титул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул8НовыеПрицепы.Прицеп КАК Прицеп
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул8.НовыеПрицепы КАК КонтурЛогистика_ТрН_Титул8НовыеПрицепы
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул8НовыеПрицепы.Ссылка = &Титул";
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаВодители = Результат[0].Выбрать();
	ВыборкаТС = Результат[1].Выбрать();
	ВыборкаПрицеп = Результат[2].Выбрать();
	
	Счет = 0;
	Пока ВыборкаВодители.Следующий() Цикл
		Если Счет = 0 Тогда
			ПараметрыОтправки.Сотрудник1 = ВыборкаВодители.Водитель;
			ПараметрыОтправки.АдресПочтыСотрудника1 = ВыборкаВодители.ВодительАдресЭлектроннойПочты;
			ПараметрыОтправки.Телефон1 = ВыборкаВодители.ВодительТелефонОсновной;
			
			// Очищаем предыдущиего, так происходит замена
			ПараметрыОтправки.Сотрудник2 = Неопределено;
			ПараметрыОтправки.АдресПочтыСотрудника2 = "";
			ПараметрыОтправки.Телефон2 = "";
		ИначеЕсли Счет = 1 Тогда
			ПараметрыОтправки.Сотрудник2 = ВыборкаВодители.Водитель;
			ПараметрыОтправки.АдресПочтыСотрудника2 = ВыборкаВодители.ВодительАдресЭлектроннойПочты;
			ПараметрыОтправки.Телефон2 = ВыборкаВодители.ВодительТелефонОсновной;
		КонецЕсли;
		Счет = Счет + 1;
	КонецЦикла;
	
	Пока ВыборкаТС.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОтправки, ВыборкаТС);
	КонецЦикла;
	
	Пока ВыборкаПрицеп.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОтправки, ВыборкаПрицеп);
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстСообщенияОтказа(ДанныеДляСообщений, ТекстЗаголовка, ЭтоПогрузка, ПричинаОтказа, СостояниеГруза, ФорматHTML)
	
	Если ФорматHTML Тогда
		ШаблонСтроки = "<tr><th>%1</th><td>%2</td></tr>";
		ШаблонСтрокиДопИнформации = "<p>%1</p>";
	Иначе
		ШаблонСтроки = "<b><u>%1:</u></b> %2";
		ШаблонСтрокиДопИнформации = "<i>%1</i>";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	// Заголовок
	Если Не ФорматHTML Тогда
		Строки.Добавить(ТекстЗаголовка + Символы.ПС);
	КонецЕсли;
	
	//
	
	Если ФорматHTML Тогда
		Строки.Добавить("<table class=""table table-condensed"">");
		Строки.Добавить("<tbody>");
	КонецЕсли;
	
	// Причина отказа
	Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			ШаблонСтроки, "Причина отказа", ПричинаОтказа));
	КонецЕсли;
	
	// Состояние груза
	Если ЗначениеЗаполнено(СостояниеГруза) Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			ШаблонСтроки, "Состояние груза", СостояниеГруза));
	КонецЕсли;
	
	Если ФорматHTML Тогда
		Строки.Добавить("</tbody></table>");
	КонецЕсли;
	
	//
	
	// Водитель
	Строки.Добавить(?(ФорматHTML, "<br><br>", Символы.ПС) + "Водитель");
	Строки.Добавить(Строка(ДанныеДляСообщений.Сотрудник1) + " " + СтрЗаменить(ДанныеДляСообщений.Телефон1, " ", ""));
	Если ЗначениеЗаполнено(ДанныеДляСообщений.Сотрудник2) Тогда
		Строки.Добавить(Строка(ДанныеДляСообщений.Сотрудник2) + " " + СтрЗаменить(ДанныеДляСообщений.Телефон2, " ", ""));
	КонецЕсли;
	
	//
	
	// Сведения о накладной
	ТекстЗаголовкаДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("%1: ЭТрН №%2 от %3",
		?(ЭтоПогрузка, "Погрузка", "Разгрузка"),
		СокрЛП(ДанныеДляСообщений.НомерДокумента),
		Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
		?(ФорматHTML, "<br><br>", Символы.ПС) + ТекстЗаголовкаДокумента));
	
	// Место погрузки
	Если ЭтоПогрузка Тогда
		
		ПредставлениеГрузоотправитель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументГрузоотправитель);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Грузоотправитель: " + ПредставлениеГрузоотправитель));
		
		ПредставлениеПеревозчик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументПеревозчик);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Перевозчик: " + ПредставлениеПеревозчик));
		
		Если ЗначениеЗаполнено(ДанныеДляСообщений.GLNПогрузки) Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
				"GLN: " + Строка(ДанныеДляСообщений.GLNПогрузки)));
		КонецЕсли;
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Адрес: " + ДанныеДляСообщений.АдресОткуда));
	Иначе
		ПредставлениеГрузополучатель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументГрузополучатель);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Грузополучатель: " + ПредставлениеГрузополучатель));
		
		ПредставлениеПеревозчик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументПеревозчик);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Перевозчик: " + ПредставлениеПеревозчик));
		
		Если ЗначениеЗаполнено(ДанныеДляСообщений.GLNДоставки) Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
				"GLN: " + Строка(ДанныеДляСообщений.GLNДоставки)));
		КонецЕсли;
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Адрес: " + ДанныеДляСообщений.АдресКуда));
	КонецЕсли;
	
	// Автомобиль
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
		"Автомобиль: " + ВРег(ДанныеДляСообщений.ГосНомерАвто) + ?(ЗначениеЗаполнено(ДанныеДляСообщений.МаркаАвто), " " + ДанныеДляСообщений.МаркаАвто, "")));
	
	// Прицепы
	Если ЗначениеЗаполнено(ДанныеДляСообщений.Прицеп) Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Прицеп: " + ВРег(ДанныеДляСообщений.ГосНомерПрицеп)));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеДляСообщений.Прицеп2) Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Прицеп 2: " + ВРег(ДанныеДляСообщений.ГосНомерПрицеп2)));
	КонецЕсли;
	// Конец - Сведения о накладной
	
	ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	
	Возврат ТекстСообщения;
	
КонецФункции

