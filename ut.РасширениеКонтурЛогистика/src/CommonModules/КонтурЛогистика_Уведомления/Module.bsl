Функция ТекстСообщенияСЗамечаниями(ДанныеДляСообщений, Замечания, ТекстЗаголовка, ЭтоПогрузка, ОтветственноеЛицо, ФорматHTML)
	
	Если ФорматHTML Тогда
		ШаблонСтрокиЗамечания = "<tr><th>%1</th><td>%2</td></tr>";
		ШаблонСтрокиДопИнформации = "<p>%1</p>";
	Иначе
		ШаблонСтрокиЗамечания = "<b><u>%1:</u></b> %2";
		ШаблонСтрокиДопИнформации = "<i>%1</i>";
	КонецЕсли;
	
	Строки = Новый Массив;
	
	// Заголовок
	Если Не ФорматHTML Тогда
		Строки.Добавить(ТекстЗаголовка + Символы.ПС);
	КонецЕсли;
	
	//
	
	// Замечания водитля
	Если ФорматHTML Тогда
		Строки.Добавить("<table class=""table table-condensed"">");
		Строки.Добавить("<tbody>");
	КонецЕсли;
	
	// Строковые замечания водителя
	СтроковыеЗамечания = Новый Массив;
	Если ЗначениеЗаполнено(Замечания.ЗамСостГруз) Тогда
		СтроковыеЗамечания.Добавить("состояние груза - " + Замечания.ЗамСостГруз);
	КонецЕсли;
	Если ЗначениеЗаполнено(Замечания.ЗамМасс) Тогда
		СтроковыеЗамечания.Добавить("масса груза - " + Замечания.ЗамМасс);
	КонецЕсли;
	Если ЗначениеЗаполнено(Замечания.ЗамКолМест) Тогда
		СтроковыеЗамечания.Добавить("количество мест - " + Замечания.ЗамКолМест);
	КонецЕсли;
	Если ЭтоПогрузка И ЗначениеЗаполнено(Замечания.ЗамПогрРаб) Тогда
		СтроковыеЗамечания.Добавить("погрузочные работы - " + Замечания.ЗамПогрРаб);
	КонецЕсли;
	Если Не ЭтоПогрузка И ЗначениеЗаполнено(Замечания.ЗамРабВыгр) Тогда
		СтроковыеЗамечания.Добавить("работы по выгрузке - " + Замечания.ЗамРабВыгр);
	КонецЕсли;
	
	Если СтроковыеЗамечания.Количество() <> 0
		Или Замечания.ОтметкиПеревозчика.Количество() <> 0 Тогда
		
		// Отметки перевозчика
		Если Замечания.ОтметкиПеревозчика.Количество() <> 0 Тогда
			ПерваяСтрока = Истина;
			Для Каждого ТекущаяОтметка Из Замечания.ОтметкиПеревозчика Цикл
				ТекстОтметки = ?(ПерваяСтрока, "отметки: ", "");
				ТекстОтметки = ТекстОтметки + Строка(ТекущаяОтметка.ДатаИВремяОтметки) + " - " + ТекущаяОтметка.ОписаниеОбстоятельств;
				
				// Акты
				Если ТекущаяОтметка.Акты.Количество() <> 0 Тогда
					ПредставлениеАктов = Новый Массив;
					Для Каждого ТекущийАкт Из ТекущаяОтметка.Акты Цикл
						ПредставлениеАктов.Добавить(ПредставлениеАктаПеревозчика(ТекущийАкт));
					КонецЦикла;
					
					ТекстОтметки = ТекстОтметки
						+ " (акты: "
						+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ПредставлениеАктов, "; ")
						+ ")";
				КонецЕсли;
				
				// Штрафы
				Если ТекущаяОтметка.Штрафы.Количество() <> 0 Тогда
					ПредставлениеШтрафов = Новый Массив;
					Для Каждого ТекущийШтраф Из ТекущаяОтметка.Штрафы Цикл
						ПредставлениеШтрафов.Добавить(ПредставлениеШтрафаПеревозчика(ТекущийШтраф));
					КонецЦикла;
					
					ТекстОтметки = ТекстОтметки
						+ " (штрафы: "
						+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ПредставлениеШтрафов, "; ")
						+ ")";
				КонецЕсли;
				
				СтроковыеЗамечания.Добавить(ТекстОтметки);
				ПерваяСтрока = Ложь;
			КонецЦикла;
		КонецЕсли;
		
		ИмяПоля = ОтветственноеЛицо + " оставил замечания";
		ЗначениеПоля = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(СтроковыеЗамечания, ", ");
		
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЗамечания, ИмяПоля, ЗначениеПоля));
	КонецЕсли;
	
	//
	
	// Даты и время
	// Прибытие
	Если ЗначениеЗаполнено(Замечания.ЗамДатВрПриб) Тогда
		Если ЭтоПогрузка Тогда
			ДатаПлан = ДанныеДляСообщений.ПогрузкаДатаВремяПрибытия;
		Иначе
			ДатаПлан = ДанныеДляСообщений.ВыгрузкаДатаВремяПрибытия;
		КонецЕсли;
		ДатаФакт = Замечания.ЗамДатВрПриб;
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДатыОдногоДня(ДатаПлан, ДатаФакт) Тогда
			ФорматДаты = "ДФ=HH:mm";
		Иначе
			ФорматДаты = "ДЛФ=DT";
		КонецЕсли;
		
		ИмяПоля = ОтветственноеЛицо + " не согласен с временем прибытия";
		ЗначениеПоля = "заявляет " + Формат(ДатаФакт, ФорматДаты)
			+ " вместо " + Формат(ДатаПлан, ФорматДаты);
		
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЗамечания, ИмяПоля, ЗначениеПоля));
	КонецЕсли;
	
	// Постановка на погрузку/выгрузку
	Если ЗначениеЗаполнено(Замечания.ЗамДатВрПосПрием)
		Или ЗначениеЗаполнено(Замечания.ЗамДатВрПосВыгр) Тогда
		
		Если ЭтоПогрузка Тогда
			ДатаПлан = ДанныеДляСообщений.ПогрузкаДатаВремяПрибытия;
			ДатаФакт = Замечания.ЗамДатВрПосПрием;
			ПредставлениеСтороны = "грузоотправителя";
		Иначе
			ДатаПлан = ДанныеДляСообщений.ВыгрузкаДатаВремяПрибытия;
			ДатаФакт = Замечания.ЗамДатВрПосВыгр;
			ПредставлениеСтороны = "грузополучателя";
		КонецЕсли;
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДатыОдногоДня(ДатаПлан, ДатаФакт) Тогда
			ФорматДаты = "ДФ=HH:mm";
		Иначе
			ФорматДаты = "ДЛФ=DT";
		КонецЕсли;
		
		ИмяПоля = ОтветственноеЛицо + " указал время постановки на " + ?(ЭтоПогрузка, "погрузку", "выгрузку");
		ЗначениеПоля = "заявляет " + Формат(ДатаФакт, ФорматДаты)
			+ " (по данным " + ПредставлениеСтороны + " " + Формат(ДатаПлан, ФорматДаты) + ")";
		
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЗамечания, ИмяПоля, ЗначениеПоля));
	КонецЕсли;
	
	// Убытие
	Если ЗначениеЗаполнено(Замечания.ЗамДатВрУбыт) Тогда
		Если ЭтоПогрузка Тогда
			ДатаПлан = ДанныеДляСообщений.ПогрузкаДатаВремяУбытия;
		Иначе
			ДатаПлан = ДанныеДляСообщений.ВыгрузкаДатаВремяУбытия;
		КонецЕсли;
		ДатаФакт = Замечания.ЗамДатВрУбыт;
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДатыОдногоДня(ДатаПлан, ДатаФакт) Тогда
			ФорматДаты = "ДФ=HH:mm";
		Иначе
			ФорматДаты = "ДЛФ=DT";
		КонецЕсли;
		
		ИмяПоля = ОтветственноеЛицо + " не согласен с временем убытия";
		ЗначениеПоля = "заявляет " + Формат(ДатаФакт, ФорматДаты)
			+ " вместо " + Формат(ДатаПлан, ФорматДаты);
		
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиЗамечания, ИмяПоля, ЗначениеПоля));
	КонецЕсли;
	
	Если ФорматHTML Тогда
		Строки.Добавить("</tbody></table>");
	КонецЕсли;
	
	//
	
	// Водитель
	Строки.Добавить(?(ФорматHTML, "<br><br>", Символы.ПС) + "Водитель");
	Строки.Добавить(Строка(ДанныеДляСообщений.Сотрудник1) + " " + СтрЗаменить(ДанныеДляСообщений.Телефон1, " ", ""));
	Если ЗначениеЗаполнено(ДанныеДляСообщений.Сотрудник2) Тогда
		Строки.Добавить(Строка(ДанныеДляСообщений.Сотрудник2) + " " + СтрЗаменить(ДанныеДляСообщений.Телефон2, " ", ""));
	КонецЕсли;
	
	//
	
	// Сведения о накладной
	ТекстЗаголовкаДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_("%1: ЭТрН №%2 от %3",
		?(ЭтоПогрузка, "Погрузка", "Разгрузка"),
		СокрЛП(ДанныеДляСообщений.НомерДокумента),
		Формат(ДанныеДляСообщений.ДатаДокумента, "ДЛФ=D;"));
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
		?(ФорматHTML, "<br><br>", Символы.ПС) + ТекстЗаголовкаДокумента));
	
	// Место погрузки
	Если ЭтоПогрузка Тогда
		
		ПредставлениеГрузоотправитель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументГрузоотправитель);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Грузоотправитель: " + ПредставлениеГрузоотправитель));
		
		ПредставлениеПеревозчик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументПеревозчик);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Перевозчик: " + ПредставлениеПеревозчик));
		
		Если ЗначениеЗаполнено(ДанныеДляСообщений.GLNПогрузки) Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
				"GLN: " + Строка(ДанныеДляСообщений.GLNПогрузки)));
		КонецЕсли;
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Адрес: " + ДанныеДляСообщений.АдресОткуда));
	Иначе
		ПредставлениеГрузополучатель = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументГрузополучатель);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Грузополучатель: " + ПредставлениеГрузополучатель));
		
		ПредставлениеПеревозчик = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодробноеПредставлениеОрганизацииДиадок(
			ДанныеДляСообщений.ДокументПеревозчик);
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Перевозчик: " + ПредставлениеПеревозчик));
		
		Если ЗначениеЗаполнено(ДанныеДляСообщений.GLNДоставки) Тогда
			Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
				"GLN: " + Строка(ДанныеДляСообщений.GLNДоставки)));
		КонецЕсли;
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Адрес: " + ДанныеДляСообщений.АдресКуда));
	КонецЕсли;
	
	// Автомобиль
	Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
		"Автомобиль: " + ВРег(ДанныеДляСообщений.ГосНомерАвто) + ?(ЗначениеЗаполнено(ДанныеДляСообщений.МаркаАвто), " " + ДанныеДляСообщений.МаркаАвто, "")));
	
	// Прицепы
	Если ЗначениеЗаполнено(ДанныеДляСообщений.Прицеп) Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Прицеп: " + ВРег(ДанныеДляСообщений.ГосНомерПрицеп)));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеДляСообщений.Прицеп2) Тогда
		Строки.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтрокиДопИнформации,
			"Прицеп 2: " + ВРег(ДанныеДляСообщений.ГосНомерПрицеп2)));
	КонецЕсли;
	// Конец - Сведения о накладной
	
	ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Строки, Символы.ПС);
	
	Возврат ТекстСообщения;
	
КонецФункции

Функция ПредставлениеАктаПеревозчика(АктПеревозчика)
	
	ЧастиАкта = Новый Массив;
	Если ЗначениеЗаполнено(АктПеревозчика.АктНомер) Тогда
		ЧастиАкта.Добавить("номер - " + Строка(АктПеревозчика.АктНомер));
	КонецЕсли;
	Если ЗначениеЗаполнено(АктПеревозчика.АктДата) Тогда
		ЧастиАкта.Добавить("дата - " + Строка(АктПеревозчика.АктДата));
	КонецЕсли;
	Если ЗначениеЗаполнено(АктПеревозчика.АктНаименование) Тогда
		ЧастиАкта.Добавить("наименование - " + Строка(АктПеревозчика.АктНаименование));
	КонецЕсли;
	Если ЗначениеЗаполнено(АктПеревозчика.АктИдДок) Тогда
		ЧастиАкта.Добавить("ид. файла - " + Строка(АктПеревозчика.АктИдДок));
	КонецЕсли;
	Если ЗначениеЗаполнено(АктПеревозчика.АктДопСведДок) Тогда
		ЧастиАкта.Добавить("доп. сведения - " + Строка(АктПеревозчика.АктДопСведДок));
	КонецЕсли;
	Если ЗначениеЗаполнено(АктПеревозчика.СтороныСоставители) Тогда
		ЧастиАкта.Добавить("состовители - " + Строка(АктПеревозчика.СтороныСоставители));
	КонецЕсли;
	Если ЗначениеЗаполнено(АктПеревозчика.ДополнительныйСоставитель) Тогда
		ЧастиАкта.Добавить("доп. составители - " + Строка(АктПеревозчика.ДополнительныйСоставитель));
	КонецЕсли;
	
	ПредставлениеАкта = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ЧастиАкта, ", ");
	
	Возврат ПредставлениеАкта;
	
КонецФункции

Функция ПредставлениеШтрафаПеревозчика(ШтрафПеревозчика)
	
	ЧастиШтрафа = Новый Массив;
	Если ЗначениеЗаполнено(ШтрафПеревозчика.ИтогРазмШтрРФ) Тогда
		ЧастиШтрафа.Добавить("размер - " + Строка(ШтрафПеревозчика.ИтогРазмШтрРФ));
	КонецЕсли;
	Если ЗначениеЗаполнено(ШтрафПеревозчика.ФактКолЕдИзм) Тогда
		ЧастиШтрафа.Добавить("ед.изм. - " + Строка(ШтрафПеревозчика.ФактКолЕдИзм));
	КонецЕсли;
	Если ЗначениеЗаполнено(ШтрафПеревозчика.РасчШтр) Тогда
		ЧастиШтрафа.Добавить("расчет - " + Строка(ШтрафПеревозчика.РасчШтр));
	КонецЕсли;
	
	ПредставлениеШтрафа = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ЧастиШтрафа, ", ");
	
	Возврат ПредставлениеШтрафа;
	
КонецФункции

Функция ТекстПисьмаСЗамечаниями()
	
	Возврат
	"<!DOCTYPE html PUBLIC ""-//W3C//DTD HTML 4.0 Transitional//EN"">
	|<html>
	|<head content=""text/html"" http-equiv=""Content-Type"" charset="""">
	|<meta name=""format-detection""></meta>
	|<style type=""text/css"">
