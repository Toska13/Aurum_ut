	ВыборкаПоДокументам = Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаПоДокументам.Следующий() Тогда
		Замечания.ЕстьЗамечания = Истина;
		ЗаполнитьЗначенияСвойств(Замечания, ВыборкаПоДокументам);
		Замечания.ПредставлениеЗамечанийВодителя = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(Замечания);
		
		// Акты и штрафы
		Акты = Результат[2].Выгрузить();
		Штрафы = Результат[3].Выгрузить();
		
		// Отметки перевозчика
		ВыборкаПоОтметкам = Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоОтметкам.Следующий() Цикл
			НоваяОтметка = НоваяОтметкаПеревозчика();
			ЗаполнитьЗначенияСвойств(НоваяОтметка, ВыборкаПоОтметкам);
			
			// Акты
			ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиОтметки", ВыборкаПоОтметкам.ИдентификаторСтроки);
			НайденныеАкты = Акты.НайтиСтроки(ПараметрыОтбора);
			Для Каждого ТекущийАкт Из НайденныеАкты Цикл
				НовыйАкт = НовыйАктПеревозчика();
				ЗаполнитьЗначенияСвойств(НовыйАкт, ТекущийАкт);
				
				НоваяОтметка.Акты.Добавить(НовыйАкт);
			КонецЦикла;
			
			// Штрафы
			НайденныеШтрафы = Штрафы.НайтиСтроки(ПараметрыОтбора);
			Для Каждого ТекущийШтраф Из НайденныеШтрафы Цикл
				НовыйШтраф = НовыйШтрафПеревозчика();
				ЗаполнитьЗначенияСвойств(НовыйШтраф, ТекущийШтраф);
				
				НоваяОтметка.Штрафы.Добавить(НовыйШтраф);
			КонецЦикла;
			
			Замечания.ОтметкиПеревозчика.Добавить(НоваяОтметка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Замечания;
	
