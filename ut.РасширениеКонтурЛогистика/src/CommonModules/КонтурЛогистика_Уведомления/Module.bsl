Функция ТекстТранспорта(ПараметрыОтправки) Экспорт
	
	Результат = Строка(ПараметрыОтправки.ТранспортноеСредство);
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.Прицеп) Тогда
		ТекстПрицепа1 = "прицеп: " + Строка(ПараметрыОтправки.Прицеп);
	Иначе
		ТекстПрицепа1 = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.Прицеп2) Тогда
		ТекстПрицепа2 = ?(ЗначениеЗаполнено(ТекстПрицепа1), ", ", "")
			+ "прицеп: " + Строка(ПараметрыОтправки.Прицеп2);
	Иначе
		ТекстПрицепа2 = "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстПрицепа1) И Не ЗначениеЗаполнено(ТекстПрицепа2) Тогда
		Результат = Результат + " (прицеп отсутствует)";
	Иначе
		Результат = Результат + " (" + ТекстПрицепа1 + ТекстПрицепа2 + ")";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторДокументаЛогистикиИзФайлов(ДокументСсылка) Экспорт
	
	ДокументОснования = ДокументОснования(ДокументСсылка);
	Если ДокументОснования = Неопределено Тогда
		ДокументОснования = ДокументСсылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГлавныйДокумент", ДокументОснования);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_ФайлыОбмена.kl_id КАК kl_id
	|ИЗ
	|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
	|ГДЕ
	|	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент = &ГлавныйДокумент
	|	И КонтурЛогистика_ФайлыОбмена.kl_id <> """"
	|	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.kl_id;
	КонецЕсли;
	
	Возврат "";
	
