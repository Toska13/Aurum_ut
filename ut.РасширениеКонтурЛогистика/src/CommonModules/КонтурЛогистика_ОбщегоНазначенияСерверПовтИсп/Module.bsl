Функция СписокРеквизитовОбъектаМетаданных(ИмяОбъекта, ТипОбъектаМетаданных) Экспорт
	
	СписокРеквизитов = Новый Массив;
	
	Реквизиты = Неопределено;
	
	Если ТипОбъектаМетаданных = "Справочник" Тогда
		Реквизиты = Метаданные.Справочники[ИмяОбъекта].Реквизиты;
	ИначеЕсли ТипОбъектаМетаданных = "Документ" Тогда
		Реквизиты = Метаданные.Документы[ИмяОбъекта].Реквизиты;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат СписокРеквизитов;
	КонецЕсли;
	
	Для каждого Стр Из Реквизиты Цикл
		СписокРеквизитов.Добавить(Стр.Имя);	
	КонецЦикла;
	
	Возврат СписокРеквизитов;
	
КонецФункции

Функция СписокТиповДокументаОснования(ДокСсылка) Экспорт
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокСсылка);
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика);
	Если ЗначениеЗаполнено(НастройкаКонвертации) И ЗначениеЗаполнено(НастройкаКонвертации.ТипДокумента1С) Тогда
		Тип = Тип("ДокументСсылка." + НастройкаКонвертации.ТипДокумента1С);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Тип) Тогда
		
		МассивТиповДокументаОснования = Новый Массив;
		МассивТиповДокументаОснования.Добавить(Тип);
		
		Возврат МассивТиповДокументаОснования;
		
	Иначе
		
		Возврат ДокСсылка.Метаданные().Реквизиты.ДокументОснование.Тип.Типы();
		
	КонецЕсли;
			
