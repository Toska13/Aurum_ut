// ТОлько для вызова из ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник - анализ метаданных может занимать значительное время, кэшируем
// описания параметров - смотри в реквизиты ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник
Функция СформироватьДеревоРеквизитов(СпособМаппинга,
									НастройкаКонвертации,
									НетТабЧастиТовары,
									ИмяТабЧастьТовары,
									ТипОснования,
									УточнениеТипДокументаСодержащийТЧТовары,
									ТипДокументаОснования,
									ИзПредыдущегоТитула_Титул,
									УровнейВложенностиДереваРеквизитов) Экспорт
	
	Перем ВозможноПостроить, Дерево, КонтейнерКоллекцииРеквизитов, Реквизит, Строка, ТипЛогистика, ТипОснованияИзПредыдущегоТитула, ТипОснованияРеквизитЗаполненногоТитула;
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("ИмяРеквизита",	Новый ОписаниеТипов("Строка", ,
	Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	Дерево.Колонки.Добавить("ПолныйПуть",	Новый ОписаниеТипов("Строка", ,
	Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
	
	ВозможноПостроить = Истина;
	Если СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования")
		Или СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДополнительногоДокумента") Тогда
		
		Если ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда 
			
			Если НетТабЧастиТовары = Ложь И ЗначениеЗаполнено(ИмяТабЧастьТовары) Тогда
				
				Если ЗначениеЗаполнено(УточнениеТипДокументаСодержащийТЧТовары) Тогда 
					КонтейнерКоллекцииРеквизитов = Метаданные.Документы[УточнениеТипДокументаСодержащийТЧТовары].ТабличныеЧасти[ИмяТабЧастьТовары].Реквизиты;
				Иначе
					ВозможноПостроить = Ложь;
				КонецЕсли;
				
			Иначе
				
				Если ЗначениеЗаполнено(ТипОснования) Тогда
					
					КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипОснования].Реквизиты;
					ДобавитьНомерДатаВДерево(Дерево);
					
				Иначе
					
					ВозможноПостроить = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(НастройкаКонвертации) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииРегистровСведений") Тогда
			
			Если ЗначениеЗаполнено(ТипОснования) Тогда
				
				КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипОснования].Реквизиты;
				ДобавитьНомерДатаВДерево(Дерево);
				
			Иначе
				
				ВозможноПостроить = Ложь;
				
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(ТипДокументаОснования) Тогда
				
				КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипДокументаОснования].Реквизиты;
				ДобавитьНомерДатаВДерево(Дерево);
				
			Иначе
				
				Если ЗначениеЗаполнено(ТипОснования) Тогда
					
					Сообщить("В настройке конвертации не указан Документ-основание учетной системы, дерево реквизитов построить невозможно")
					
				Иначе
					
					ВозможноПостроить = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	ИначеЕсли СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитСправочникаДокументаУС") 
		ИЛИ СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ВычислитьВыражение") 
		ИЛИ СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ДоговорыКонтрагентов") Тогда
		
		Если ЗначениеЗаполнено(ТипОснования) Тогда
			
			Если Метаданные.Справочники.Найти(ТипОснования) <> Неопределено Тогда 
				
				КонтейнерКоллекцииРеквизитов = Метаданные.Справочники[ТипОснования].Реквизиты;
				ДобавитьКодНаименованиеВДерево(Дерево);
				
				Если Метаданные.Справочники[ТипОснования].Владельцы.Количество() > 0 Тогда
					ДобавитьВладелецВДерево(Дерево);
				КонецЕсли;
					
			Иначе
				КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипОснования].Реквизиты;
				ДобавитьНомерДатаВДерево(Дерево);
			КонецЕсли;
			
		Иначе
			
			 ВозможноПостроить = Ложь;
			
		КонецЕсли;
		
	ИначеЕсли СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.РеквизитЗаполненногоТитула") Тогда
		
		ДобавитьНомерДатаВДерево(Дерево);
		ТипЛогистика = НастройкаКонвертации.ТипДокументаЛогистика;
		ТипОснованияРеквизитЗаполненногоТитула = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
		
		КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипОснованияРеквизитЗаполненногоТитула].Реквизиты;
		
	ИначеЕсли СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула") Тогда
		
		Если ЗначениеЗаполнено(ИзПредыдущегоТитула_Титул) Тогда
			
			ДобавитьНомерДатаВДерево(Дерево);
			ТипОснованияИзПредыдущегоТитула = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ИзПредыдущегоТитула_Титул);
			КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипОснованияИзПредыдущегоТитула].Реквизиты;
			
		Иначе
			
			КонтейнерКоллекцииРеквизитов = Неопределено;
			
		КонецЕсли;
		
	ИначеЕсли СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПроизвольныйКод")
		ИЛИ СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитЛогистика") 
		ИЛИ СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.ПервоеСоответствие") 
		ИЛИ СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитУчСист") Тогда
		
		Если ЗначениеЗаполнено(ТипОснования) Тогда
			
			Если Метаданные.Справочники.Найти(ТипОснования) <> Неопределено Тогда
				
				КонтейнерКоллекцииРеквизитов = Метаданные.Справочники[ТипОснования].Реквизиты;
				ДобавитьКодНаименованиеВДерево(Дерево);
				
				Если Метаданные.Справочники[ТипОснования].Владельцы.Количество() > 0 Тогда
					ДобавитьВладелецВДерево(Дерево);
				КонецЕсли;
				
			ИначеЕсли Метаданные.РегистрыСведений.Найти(ТипОснования) <> Неопределено Тогда
				
				КонтейнерКоллекции = Метаданные.РегистрыСведений[ТипОснования].Измерения;
				ДобавитьСтрокиДереваИзКонтейнера(Дерево, КонтейнерКоллекции, ТипОснования, УровнейВложенностиДереваРеквизитов);
				
				КонтейнерКоллекции = Метаданные.РегистрыСведений[ТипОснования].Ресурсы;
				ДобавитьСтрокиДереваИзКонтейнера(Дерево, КонтейнерКоллекции, ТипОснования, УровнейВложенностиДереваРеквизитов);
				
				КонтейнерКоллекцииРеквизитов = Метаданные.РегистрыСведений[ТипОснования].Реквизиты;
				
			Иначе
				
				КонтейнерКоллекцииРеквизитов = Метаданные.Документы[ТипОснования].Реквизиты;
				ДобавитьНомерДатаВДерево(Дерево);
				
			КонецЕсли;
			
		Иначе
			
			 ВозможноПостроить = Ложь;
			
		 КонецЕсли;	
		 
	ИначеЕсли СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыРасчетаЗначениейДокУчСист.РеквизитТЧЛогистика") Тогда
		
		Если ЗначениеЗаполнено(ИмяТабЧастьТовары) Тогда
				
			КонтейнерКоллекцииРеквизитов = Метаданные.Документы[УточнениеТипДокументаСодержащийТЧТовары].ТабличныеЧасти[ИмяТабЧастьТовары].Реквизиты;
						 
		КонецЕсли;
		
	ИначеЕсли СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ДокументФизическогоЛица") Тогда
		
		ТипОбъекта = "ДокументыФизическихЛиц"; 
		
		Если Метаданные.РегистрыСведений.Найти(ТипОбъекта) <> Неопределено Тогда 
				
			КонтейнерКоллекцииРеквизитов = Метаданные.РегистрыСведений[ТипОбъекта].Ресурсы;

		КонецЕсли;
		
	КонецЕсли;
	
	Если ВозможноПостроить
		И КонтейнерКоллекцииРеквизитов <> Неопределено Тогда
		
		ДобавитьСтрокиДереваИзКонтейнера(Дерево, КонтейнерКоллекцииРеквизитов, ТипОснования, УровнейВложенностиДереваРеквизитов);
	КонецЕсли;
	
	Возврат Дерево;

КонецФункции

Процедура ДобавитьСтрокиДереваИзКонтейнера(Дерево, КонтейнерКоллекцииРеквизитов, ТипОснования, УровнейВложенностиДереваРеквизитов)
	
	Для Каждого Реквизит Из КонтейнерКоллекцииРеквизитов Цикл
		
		НоваяСтрока = Дерево.Строки.Добавить();
		НоваяСтрока.ИмяРеквизита = Реквизит.Имя;
		НоваяСтрока.ПолныйПуть = Реквизит.Имя;
		
		// Вложенные
		ДобавитьВложенныеРеквизиты(НоваяСтрока, КонтейнерКоллекцииРеквизитов, ТипОснования, УровнейВложенностиДереваРеквизитов);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьНеобходимыеМетаданные(СтрокаМетаданных) Экспорт
	
	ЕстьНеобходимыеМетаданные = Истина;
	ТекПолеМетаданных = Метаданные;
	
	МассивИмен = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СтрокаМетаданных,".");
	
	КоличествоИмен = МассивИмен.Количество();
	
	// КоличествоИмен = 2 для проверки наличия объекта, например 					Справочники.КонтурEDI_Сообщения
	// КоличествоИмен = 4 для проверки наличия реквизита\ресурса и т.д., например	Справочники.КонтурEDI_Сообщения.Реквизиты.Организация
	// КоличествоИмен = 6 для проверки наличия реквизита таб. части, например		Справочники.КонтурEDI_Сообщения.ТабличныеЧасти.ДополнительныеРеквизиты.Реквизиты.ЗначениеСтрока
	
	Если НЕ (КоличествоИмен = 2 ИЛИ КоличествоИмен = 4 ИЛИ КоличествоИмен = 6) Тогда
		ЕстьНеобходимыеМетаданные =  Ложь;
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные Тогда
		КоличествоПоисков = КоличествоИмен/2;
		Для н = 1 По КоличествоПоисков Цикл
			ТекПолеМетаданных = ТекПолеМетаданных[МассивИмен[н*2-2]].Найти(МассивИмен[н*2-1]);
			Если ТекПолеМетаданных = Неопределено Тогда
				ЕстьНеобходимыеМетаданные =  Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьНеобходимыеМетаданные;	
	
КонецФункции

