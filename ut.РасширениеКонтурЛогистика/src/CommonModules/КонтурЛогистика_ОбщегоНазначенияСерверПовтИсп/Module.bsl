Функция ПодробноеПредставлениеОрганизацииДиадок(ОрганизацияДиадок) Экспорт
	
	ПредставлениеОрганизации = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияДиадок", ОрганизацияДиадок);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Наименование КАК Наименование,
	|	КонтурЛогистика_ОрганизацииДиадок.ИНН КАК ИНН,
	|	КонтурЛогистика_ОрганизацииДиадок.ТелефонОсновной КАК ТелефонОсновной
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка = &ОрганизацияДиадок";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПредставлениеОрганизации = СокрЛП(Выборка.Наименование) + ", ИНН: " + СокрЛП(Выборка.ИНН);
		
		Если ЗначениеЗаполнено(Выборка.ТелефонОсновной) Тогда
			ПредставлениеОрганизации = ПредставлениеОрганизации + ", телефон: " + СтрЗаменить(Выборка.ТелефонОсновной, " ", "");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПредставлениеОрганизации;
	
КонецФункции

