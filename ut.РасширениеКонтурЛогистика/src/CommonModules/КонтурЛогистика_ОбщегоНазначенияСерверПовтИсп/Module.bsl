	МассивТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	МассивТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	МассивТипДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика В(&ТипДокументаЛогистика)";
	
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", МассивТипДокументаЛогистика);
	
