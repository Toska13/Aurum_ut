Функция ЕстьДокументСсылкаВОснованииПоТипу(ИмяМетаданныхДокумента) Экспорт
	
	МетаданныеДокумента = Метаданные.Документы[ИмяМетаданныхДокумента];
	
	КоличествоТиповСсылокДокументаОснования = 0;
	
	Для Каждого ТекущийТип Из МетаданныеДокумента.Реквизиты.ДокументОснование.Тип.Типы() Цикл
		Если Метаданные.Документы.Содержит(Метаданные.НайтиПоТипу(ТекущийТип)) Тогда
			КоличествоТиповСсылокДокументаОснования = КоличествоТиповСсылокДокументаОснования + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат (КоличествоТиповСсылокДокументаОснования = Метаданные.Документы.Количество());
	
КонецФункции

