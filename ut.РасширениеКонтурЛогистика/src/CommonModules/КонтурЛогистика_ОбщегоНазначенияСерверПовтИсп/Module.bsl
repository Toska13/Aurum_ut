Функция СостоянияДвиженияДО()
	
	Состояния = Новый Соответствие;
	
	ЗапросСостояний = Новый Запрос;
	ЗапросСостояний.Текст = "ВЫБРАТЬ
    |	КонтурЛогистика_СостоянияДвиженияДокументооборота.Код КАК Код,
    |	КонтурЛогистика_СостоянияДвиженияДокументооборота.Ссылка КАК Ссылка
    |ИЗ
    |	Справочник.КонтурЛогистика_СостоянияДвиженияДокументооборота КАК КонтурЛогистика_СостоянияДвиженияДокументооборота";
	
	Выборка = ЗапросСостояний.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Состояния.Вставить(Выборка.Код, Выборка.Ссылка);	
	КонецЦикла;
		
	Возврат Состояния;
	
КонецФункции

Функция ЗначениеСостоянияДО(КодСостояния) Экспорт
	
	Состояния = СостоянияДвиженияДО();
	
	Возврат Состояния.Получить(КодСостояния);
	
КонецФункции

