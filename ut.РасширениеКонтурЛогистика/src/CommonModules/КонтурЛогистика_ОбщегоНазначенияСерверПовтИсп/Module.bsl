Функция ПодсистемаКакРасширение() Экспорт
	
	ЭтоРасширение = Ложь;
	
	Попытка
		ЭтоРасширение = Метаданные.Подсистемы.КонтурЛогистика.РасширениеКонфигурации() <> Неопределено; // метод появился в 8.3.8
	Исключение
		ЭтоРасширение = Ложь;
	КонецПопытки;
	
	Возврат ЭтоРасширение;
			
КонецФункции

Функция ПодсистемаКакРасширениеСОпределяемымиТипами() Экспорт
	
	Результат = Ложь;
	
	Попытка
		
		Расширение = Метаданные.Подсистемы.КонтурЛогистика.РасширениеКонфигурации();
		
		Если Расширение <> Неопределено Тогда
			
			// на 8.3.10 и ниже нет конструктора - поэтому без компиляции
			МетаданныеРасширения = Вычислить("Новый ОбъектМетаданныхКонфигурация(Расширение.ПолучитьДанные())");
			
			Результат = МетаданныеРасширения.ОпределяемыеТипы.Количество() > 0;
			
		КонецЕсли;
		
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
			
КонецФункции

