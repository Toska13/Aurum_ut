&НаКлиенте
Процедура УстановитьДоступностьКнопкиДалее()
	
	КнопкаДалее = Элементы.Далее;
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ВводЛогинаПароля Тогда 
		
		РежимАвторизацииПоАпиКей = (РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.ApiKey"));
		РежимАвторизацииНаПортале = (РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow"));
		
		КнопкаДалее.Доступность = API_АвторизацияЛогинПарольУспешна = Истина Или РежимАвторизацииПоАпиКей Или РежимАвторизацииНаПортале;
		КнопкаДалее.Заголовок 	= "Далее";
		КнопкаДалее.Картинка 	= БиблиотекаКартинок.КонтурЛогистика_Далее;
		
		Элементы.ВводЛогинаПароля_ПроверитьПодключение.Видимость = НЕ РежимАвторизацииПоАпиКей И НЕ API_АвторизацияЛогинПарольУспешна = Истина;
		Элементы.API_АвторизацияЛогинПарольУспешна.Видимость = Не РежимАвторизацииПоАпиКей;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации
		Или Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность
		Или Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки
		Или Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПрав Тогда
		
		КнопкаДалее.Доступность = Истина;
		КнопкаДалее.Заголовок = "Далее";
		КнопкаДалее.Картинка = БиблиотекаКартинок.КонтурЛогистика_Далее;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбучения Тогда
		
		КнопкаДалее.Доступность = Истина;
		КнопкаДалее.Заголовок = "Завершить";
		КнопкаДалее.Картинка = БиблиотекаКартинок.КонтурЛогистика_Галочка;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ВводЛогинаПароля Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПрав;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПрав Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбучения;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбучения Тогда
		
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.ВводЛогинаПароля;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПрав Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПрав;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбучения Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент = Неопределено, ТекущаяСтраница)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации Тогда
		
		ПеречитатьМоиОрганизацииНаСервере();
		
		РежимOIDCDeviceFlow = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow");
		АвторизацияНаПортале = (РежимАвторизации = РежимOIDCDeviceFlow);
		Если АвторизацияНаПортале Тогда
			Элементы.ГруппаТребуетсяАвторизация.Видимость = (Не КонтурЛогистика_ОбщегоНазначенияСервер.ЕстьПортальныеАвторизации());
		Иначе
			Элементы.ГруппаТребуетсяАвторизация.Видимость = Ложь;
		КонецЕсли;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
		
		ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
		Если Не ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда
			// Попытаемся определить
			ИмяКонфигурации1С = КонтурЛогистика_ОбщегоНазначенияСервер.ОпределитьКонфигурацию();
			Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда
				ПодтвердитьКонфигурацию(Неопределено);
			КонецЕсли;
		КонецЕсли;
		
		ПеречитатьНастройкиНаСервере();
		
		Если ЗначениеЗаполнено(ИдентификаторФЗ_ПроверитьОбновление) Тогда
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Истина);
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 1, Истина);
		Иначе
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь);
		КонецЕсли;
		
		Элементы.ДекорацияНовоеОбновлениеДополнительныеРеквизиты.Видимость = Ложь;
		
		Если Не ОтображатьПанельВУчетныхДокументах И ОтображатьДополнитильныеРекизитыУчСист Тогда
			ПроверитьОбновленияНаКлиенте("ДополнительныеРеквизиты", Истина);
		КонецЕсли;
		
		Если ИмяКонфигурации1С = "УАТ_ПРОФ"
			Или ИмяКонфигурации1С = "ERP_УАТ"
			Или ИмяКонфигурации1С = "ТЛЭ" Тогда
			
			Если ПередаватьQRВМПВодительУАТ И Не Элементы.ГруппаПредупреждениеQR.Видимость Тогда
				ПроверитьОбновленияНаКлиенте("QR_МП_УАТ");
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбучения Тогда
		
		Попытка
			
			// Альтернатива
			Если Не ДанныеОбученияПолучены Тогда
				
				РезультатПолучения = КонтурЛогистика_ОбновлениеСервер.ПолучитьДокументацию(
					"shag_5_oznakomtes_s_funkcionalnostyu_modulya.json");
				
				СтруктураНавигации = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(РезультатПолучения.Содержимое);
				
				СоздатьЭлементыОбучения(СтруктураНавигации);
				
				ДанныеОбученияПолучены = Истина;
				
			КонецЕсли;
			
		Исключение
			
			ДанныеОбученияПолучены = Ложь;
			
		КонецПопытки;
		
		Элементы.ГруппаОбучениеАдминистратор.Видимость = Не ДанныеОбученияПолучены;
		Элементы.ГруппаОбучениеПользователь.Видимость = Не ДанныеОбученияПолучены;
		Элементы.ГруппаОбучениеДинамическая.Видимость = ДанныеОбученияПолучены;
		
	КонецЕсли;
	
	УстановитьДоступностьКнопкиДалее();
	УправлениеВидимостьюДоступностью(ЭтаФорма);
	
	Элементы.Назад.Видимость = (Элементы.Страницы.ТекущаяСтраница <> Элементы.ВводЛогинаПароля);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыОбучения(СтруктураНавигации)
	
	Счет = 1;
	Для Каждого ОписаниеГлавнойГруппы Из СтруктураНавигации Цикл
		
		ИмяПостфиксаГлавнойГруппы = "ГруппаОбучениеДинамическая_" + Формат(Счет, "ЧДЦ=0; ЧГ=");
		
		ТекущаяГлавнаяГруппа = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(
			ЭтаФорма, ИмяПостфиксаГлавнойГруппы, Элементы.ГруппаОбучениеДинамическая, 1);
		ТекущаяГлавнаяГруппа.Заголовок = ОписаниеГлавнойГруппы.title;
		ТекущаяГлавнаяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
		ТекущаяГлавнаяГруппа.ОтображатьЗаголовок = Истина;
		ТекущаяГлавнаяГруппа.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаФормы;
		
		// Подчиненные
		СчетКонтента = 1;
		Для Каждого ОписаниеКонтента Из ОписаниеГлавнойГруппы.contents Цикл
			
			ИмяПостфиксаЭлемента = ИмяПостфиксаГлавнойГруппы + "_" + Формат(СчетКонтента, "ЧДЦ=0; ЧГ=");
			
			// Группа
			ТекущаяГруппаКонтента = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(
				ЭтаФорма, ИмяПостфиксаЭлемента, ТекущаяГлавнаяГруппа, 3);
			
			// Отступ
			СвойстваДекарации = Новый Структура;
			СвойстваДекарации.Вставить("Вид", ВидДекорацииФормы.Картинка);
			СвойстваДекарации.Вставить("Высота", 1);
			СвойстваДекарации.Вставить("Ширина", 1);
			ТекущийОтступ = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
				ЭтаФорма, ИмяПостфиксаЭлемента + "_Отступ", ТекущаяГруппаКонтента, СвойстваДекарации);
			
			// Ссылка
			СвойстваДекарации = Новый Структура;
			СвойстваДекарации.Вставить("Вид", ВидДекорацииФормы.Надпись);
			СвойстваДекарации.Вставить("Заголовок", ОписаниеКонтента.name);
			СвойстваДекарации.Вставить("Подсказка", ОписаниеКонтента.href);
			СвойстваДекарации.Вставить("Гиперссылка", Истина);
			СвойстваДекарации.Вставить("ЦветТекста", ЦветаСтиля.ЦветТекстаФормы);
			ТекущийЗаголовок = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорация(
				ЭтаФорма, ИмяПостфиксаЭлемента + "_Ссылка", ТекущаяГруппаКонтента, СвойстваДекарации);
			ТекущийЗаголовок.УстановитьДействие("Нажатие", "ОбучениеАдминистратор1Нажатие");
			
			СчетКонтента = СчетКонтента + 1;
			
		КонецЦикла;
		
		Счет = Счет + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРольАдминистратора()
	
	Элементы.ГруппаНетНиОдногоПользователя.Видимость = Ложь;
	
	РольАдминаКЛ = Метаданные.Роли.Найти("КонтурЛогистика_ПолныеПраваЛогистика");
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистраторУчетнойСистемы()
		И Не РольДоступна(РольАдминаКЛ) Тогда
		
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТекущийПользовательИБ.Имя = "" Тогда
			Элементы.ГруппаНетНиОдногоПользователя.Видимость = Истина;
		Иначе
			ТекущийПользовательИБ.Роли.Добавить(РольАдминаКЛ);
			ТекущийПользовательИБ.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьТитул(ТипТитула, НомерТитула)
	
	ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов[ТипТитула + НомерТитула];
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипДокумента);
	
	Возврат Не НастройкаКонвертации = Неопределено;
	
КонецФункции	

&НаКлиенте
Процедура ТекстКонвертацияНажатие(Элемент)
	
	НомерТитула = СтрЗаменить(Элемент.Имя, "ТекстКонвертацияТ", "");

	Если Не Найти(Элемент.Имя,"_ПЛ") = 0 Тогда 
		НомерТитула 	= СтрЗаменить(НомерТитула, "_ПЛ", "");
		ТипДокумента 	= ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул" + НомерТитула);
	ИначеЕсли Не Найти(Элемент.Имя,"_ЗЗ") = 0 Тогда
		НомерТитула 	= СтрЗаменить(НомерТитула, "_ЗЗ", "");
		ТипДокумента 	= ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул" + НомерТитула);
	Иначе
		ТипДокумента = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул" + НомерТитула);
	КонецЕсли;	
	
	Настройка = ПолучитьНастройкуКонвертацииДокументов(ТипДокумента);	
	
	Если Настройка = Неопределено Тогда 
		
		ПараметрыФормы = Новый Структура("ТипДокументаЛогистика", ТипДокумента);
		
	Иначе	
		
		ПараметрыФормы = Новый Структура("Ключ", Настройка);	
		
	КонецЕсли;	
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.Форма.ФормаЭлемента",
		ПараметрыФормы, 
		ЭтаФорма,,,, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройку_(ИмяПредопределенного)

	Возврат Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкуКонвертацииДокументов(ТипДокумента)

	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипДокумента);
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкуКонвертацииСправочников(ТипСправочника)

	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкиКонвертацииПоТипуСправочникаЛогистики(ТипСправочника);
		
КонецФункции

&НаКлиенте
Процедура СсылкаКонвертацияНажатие(Элемент)
	
	ТипСправочника = "КонтурЛогистика_" + СтрЗаменить(Элемент.Имя, "СсылкаКонвертация", "");
	
	Если Элемент.Заголовок = "Создать" Тогда
		
		ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаЭлемента";
		ПараметрыФормы = Новый Структура("ТипСправочникаЛогистика", ТипСправочника);
		
	ИначеЕсли Элемент.Заголовок = "1 конвертация" Тогда 
		
		Настройка = ПолучитьНастройкуКонвертацииСправочников(ТипСправочника);
				
		ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаЭлемента";
		ПараметрыФормы = Новый Структура("Ключ", Настройка);
		
	Иначе 
		
		ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаСписка";
		ПараметрыФормы = Неопределено;
		
	КонецЕсли;	
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяФормыСправочника,
		ПараметрыФормы, 
		ЭтаФорма,,,, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьОшибки(ОткрытьСтраницуСОшибкой = Ложь)
	
	Элементы.Растяжитель.Заголовок = "";
	
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.НеобходимыеНастройкиДляРаботыПодсистемыЗаполнены();
	
	Если ЗначениеЗаполнено(Результат.ТекстДействия) Тогда
		
		Элементы.Растяжитель.Заголовок = Результат.ТекстДействия;
		
		Если ОткрытьСтраницуСОшибкой И API_АвторизацияЛогинПарольУспешна = Истина Тогда 
			
			Элементы.Страницы.ТекущаяСтраница = Элементы[Результат.ТекСтраницаПомошника];
			
			Если Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации Тогда
				
				ПеречитатьМоиОрганизацииНаСервере();
				
			ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
				
				ПеречитатьНастройкиНаСервере();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОрганизацииДиадокИРолиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы = Ложь Или ЗавершениеРаботы = Неопределено Тогда
		Оповестить("ОбновитьРабочийСтол");
		Оповестить("ВыполнитьОбменНаРабочемСтоле");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстИмяСправочникаНажатие(Элемент)
	
	ИмяПредпопределнного = СтрЗаменить(Элемент.Имя, "Текст", "");
	
	НастройкаСсылка = ПолучитьНастройку_(ИмяПредпопределнного);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Настройки.Форма.ФормаЭлемента",
		Новый Структура("Ключ", НастройкаСсылка),                                                                                                 
		ЭтаФорма,,,, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЧтоТакоеApiKeyНажатие(Элемент)
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке("https://developer.kontur.ru/doc/logistics.api");
КонецПроцедуры

&НаКлиенте
Процедура РежимАвторизацииПриИзменении(Элемент)
	
	УстановитьНастройку("РежимАвторизации", РежимАвторизации);
	ПеречитатьОшибки();
	УстановитьДоступностьКнопкиДалее();
	УправлениеВидимостьюДоступностью(ЭтаФорма);
	
	Оповестить("КонтурЛогистика_Аутентификация");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьНастройку(ИмяПредопределенного, УстанавливаемоеЗначение)
	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяПредопределенного, УстанавливаемоеЗначение);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьНастройкуОрганизации(ОрганизацияДиадокСсылка, НастройкаОрганизации, УстанавливаемоеЗначение)
	
	Справочники.КонтурЛогистика_ОрганизацииДиадок.УстановитьНастройку(ОрганизацияДиадокСсылка, НастройкаОрганизации, УстанавливаемоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииДиадокИРолиApiKeyПриИзменении(Элемент)
	
	ТекДанные = Элементы.ОрганизацииДиадокИРоли.ТекущиеДанные;
	
	УстановитьНастройкуОрганизации(ТекДанные.ОрганизацияДиадок,
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"),
		ТекДанные.ApiKey);
		
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииДиадокИРолиApiKeyНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ОрганизацииДиадокИРоли.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура("КлючАПИ", ТекДанные.ApiKey);
		
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВводаАпиКлюча", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"ПослеВводаApiKey",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаApiKey(НовоеЗначение, ДополнительныеПараметры) Экспорт
	
	ТекДанные = Элементы.ОрганизацииДиадокИРоли.ТекущиеДанные;
	
	Если НовоеЗначение = Неопределено Тогда
		Возврат;	 		
	КонецЕсли;
	
	ТекДанные.ApiKey = НовоеЗначение;
	
	УстановитьНастройкуОрганизации(ТекДанные.ОрганизацияДиадок,
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"),
		НовоеЗначение);
		
	УстановитьНастройкуОрганизации(ТекДанные.ОрганизацияДиадок,
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики"),
		ЗначениеЗаполнено(НовоеЗначение)); 
		
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуютсяЗаказЗаявкиПриИзменении(Элемент)
	
	УстановитьНастройку("ИспользуетсяЗаказЗаявка", ИспользуютсяЗаказЗаявки);
	Оповестить("ОбновитьРабочийСтол");
	
	Если ИспользуютсяЗаказЗаявки Тогда
		Организации = КонтурЛогистика_ОбщегоНазначенияСервер.НашиСНастройкойЧтениеЛентыДД(Ложь);
		Если Организации.Количество() > 0 Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
				"Есть организации с выключенной настройкой чтения ленты Диадок. Статусы документов обновляться не будут");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуютсяПутевыеЛистыПриИзменении(Элемент)
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502() Тогда 
		УстановитьНастройку("ИспользуетсяПутевойЛист", Ложь);
		УстановитьНастройку("ИспользуетсяПутевойЛист_5_02", ИспользуютсяПутевыеЛисты);
		ИспользуютсяПутевыеЛисты_5_02 = ИспользуютсяПутевыеЛисты;
	Иначе
		УстановитьНастройку("ИспользуетсяПутевойЛист", ИспользуютсяПутевыеЛисты);		
	КонецЕсли;	
	
	Оповестить("ОбновитьРабочийСтол");
	
	ОбновитьВидимостьТестовыхОрганизаций();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуютсяЗаказНарядыПриИзменении(Элемент)
	УстановитьНастройку("ИспользуетсяЗаказНаряд", ИспользуютсяЗаказНаряды);
	Оповестить("ОбновитьРабочийСтол");
КонецПроцедуры

&НаКлиенте
Процедура ИспользуютсяЭкспедиторскиеРаспискиПриИзменении(Элемент)
	
	УстановитьНастройку("ИспользуетсяЭкспедиторскаяРасписка", ИспользуютсяЭкспедиторскиеРасписки);
	
	Оповестить("ОбновитьРабочийСтол");
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуютсяТРНПриИзменении(Элемент)
	
	УстановитьНастройку("ИспользуетсяТРН", ИспользуютсяТРН);
	Оповестить("ОбновитьРабочийСтол");
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНастройкиДополнительногоРасширения()
	
	ИмяДополнительногоРасширения = КонтурЛогистика_ИнтеграцияТиповыеСервер.ИмяДополнительногоРасширенияПоИмениКонфигурации(
		ИмяКонфигурации1С);
	
	Если Не ЗначениеЗаполнено(ИмяДополнительногоРасширения) Тогда
		Элементы.ГруппаДополнительноеРасширение.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаДополнительноеРасширение.Видимость = Истина;
	
	ГруппаНастроек = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "НастройкиОтображенияПанелиВУчетныхДокументах");
	Если ГруппаНастроек.Пустая() Тогда
		НоваяГруппа = Справочники.КонтурЛогистика_Настройки.СоздатьГруппу();
		НоваяГруппа.Наименование = "Настройки отображения панели в учетных документах";
		НоваяГруппа.ИмяПредопределенногоДляРасширения = "НастройкиОтображенияПанелиВУчетныхДокументах";
		НоваяГруппа.Записать();
		
		ГруппаНастроек = НоваяГруппа.Ссылка;
	КонецЕсли;
	
	НастройкаОтображатьПанельВУчетныхДокументах = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "ОтображатьПанельВУчетныхДокументах");
	Если НастройкаОтображатьПанельВУчетныхДокументах.Пустая() Тогда
		НовыйЭлемент = Справочники.КонтурЛогистика_Настройки.СоздатьЭлемент();
		НовыйЭлемент.Родитель = ГруппаНастроек;
		НовыйЭлемент.Наименование = "Отображать панель";
		НовыйЭлемент.ИмяПредопределенногоДляРасширения = "ОтображатьПанельВУчетныхДокументах";
		НовыйЭлемент.ТипЗначения = "Булево";
		НовыйЭлемент.Значение = Истина;
		НовыйЭлемент.Описание = "Включает/выключает отображение панели статусов и действий в документах учетной системы. "
			+ "Видимость панели для каждого документа можно настроить отдельно.";
		НовыйЭлемент.Записать();
		
		НастройкаОтображатьПанельВУчетныхДокументах = НовыйЭлемент.Ссылка;
	КонецЕсли;
	
	ОтображатьПанельВУчетныхДокументах = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки(
		"ОтображатьПанельВУчетныхДокументах");
	
	Если ОтображатьПанельВУчетныхДокументах Тогда
		// Проверяем наличие настроек для каждого типа документов
		ИнтегрируемыеДокументы = КонтурЛогистика_ИнтеграцияТиповыеСервер.ИменаИнтегрируемыхДокументов(ИмяКонфигурации1С);
		
		Если ИнтегрируемыеДокументы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ГруппаНастроекПоДокументам = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
			"ИмяПредопределенногоДляРасширения", "НастройкиОтображенияПанелиПоДокументам");
		Если ГруппаНастроекПоДокументам.Пустая() Тогда
			НоваяГруппа = Справочники.КонтурЛогистика_Настройки.СоздатьГруппу();
			НоваяГруппа.Родитель = ГруппаНастроек;
			НоваяГруппа.Наименование = "Документы учетной системы";
			НоваяГруппа.ИмяПредопределенногоДляРасширения = "НастройкиОтображенияПанелиПоДокументам";
			НоваяГруппа.Записать();
			
			ГруппаНастроекПоДокументам = НоваяГруппа.Ссылка;
		КонецЕсли;
		
		Для Каждого ИнтегрируемыйДокумент Из ИнтегрируемыеДокументы Цикл
			ТекущаяНастройка = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
				"ИмяПредопределенногоДляРасширения", ИнтегрируемыйДокумент.ИмяПредопределенногоДляРасширения);
			
			Если Не ТекущаяНастройка.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			
			// Создаем новую
			НовыйЭлемент = Справочники.КонтурЛогистика_Настройки.СоздатьЭлемент();
			НовыйЭлемент.Родитель = ГруппаНастроекПоДокументам;
			НовыйЭлемент.Наименование = ИнтегрируемыйДокумент.Наименование;
			НовыйЭлемент.ИмяПредопределенногоДляРасширения = ИнтегрируемыйДокумент.ИмяПредопределенногоДляРасширения;
			НовыйЭлемент.ТипЗначения = "Булево";
			НовыйЭлемент.Значение = Истина;
			НовыйЭлемент.Описание = ИнтегрируемыйДокумент.Описание;
			НовыйЭлемент.Записать();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьПанельВУчетныхДокументахПриИзменении(Элемент)
	
	УстановитьНастройку("ОтображатьПанельВУчетныхДокументах", ОтображатьПанельВУчетныхДокументах);
	
	Если ОтображатьПанельВУчетныхДокументах И Не Элементы.ГруппаПредупреждение.Видимость Тогда
		ПроверитьОбновленияНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработкаКоманды_ПроверитьОбновления

&НаКлиенте
Процедура ПроверитьОбновленияНаКлиенте(ВидРасширения = "", ПроверитьНовоеОбновление = Ложь)
	
	Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
		
		РезультатЗапуска = КонтурЛогистика_ОбновлениеСервер.ПроверитьОбновления(
			АдресВХранилище_ПроверитьОбновлениеДополнительныеРеквизиты, ВидРасширения, УникальныйИдентификатор);
		
		Если РезультатЗапуска = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если РезультатЗапуска.Статус = "Выполнено" Тогда
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь, "ДополнительныеРеквизиты");
			Если ПроверитьНовоеОбновление Тогда
				ПроверитьНовоеОбновление_ДополнительныеРеквизиты();
			Иначе
				ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища(
					АдресВХранилище_ПроверитьОбновлениеДополнительныеРеквизиты, ИдентификаторФЗ_ЗагрузитьОбновлениеДополнительныеРеквизиты,
					АдресВХранилище_ЗагрузитьОбновлениеДополнительныеРеквизиты, ИдентификаторФЗ_ЗагрузитьОбновлениеДополнительныеРеквизиты,
					"ДополнительныеРеквизиты");
			КонецЕсли; 
		Иначе
			ИдентификаторФЗ_ПроверитьОбновлениеДополнительныеРеквизиты = РезультатЗапуска.ИдентификаторЗадания;
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Истина, "ДополнительныеРеквизиты");
			Если ПроверитьНовоеОбновление Тогда
				ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьНовоеОбновление_ДополнительныеРеквизиты", 1, Истина);
			Иначе
				ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_ДополнительныеРеквизиты", 1, Истина);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
		
		РезультатЗапуска = КонтурЛогистика_ОбновлениеСервер.ПроверитьОбновления(
			АдресВХранилище_ПроверитьОбновлениеQR, ВидРасширения, УникальныйИдентификатор);
				
		Если РезультатЗапуска = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИдентификаторФЗ_ПроверитьОбновлениеQR = РезультатЗапуска.ИдентификаторЗадания;
		
		Если ЗначениеЗаполнено(ИдентификаторФЗ_ПроверитьОбновлениеQR) Тогда
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Истина, "QR_МП_УАТ");
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_QR", 1, Истина);
		Иначе
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь, "QR_МП_УАТ");
			ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища(
				АдресВХранилище_ПроверитьОбновлениеQR, ИдентификаторФЗ_ПроверитьОбновлениеQR,
				АдресВХранилище_ЗагрузитьОбновлениеQR, ИдентификаторФЗ_ЗагрузитьОбновлениеQR,
				"QR_МП_УАТ");
		КонецЕсли;
		
	Иначе
		
		РезультатЗапуска = КонтурЛогистика_ОбновлениеСервер.ПроверитьОбновления(
			АдресВХранилище_ПроверитьОбновление, , УникальныйИдентификатор);
		
		Если РезультатЗапуска = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИдентификаторФЗ_ПроверитьОбновление = РезультатЗапуска.ИдентификаторЗадания;
		
		Если ЗначениеЗаполнено(ИдентификаторФЗ_ПроверитьОбновление) Тогда
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Истина);
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 1, Истина);
		Иначе
			ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь);
			ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища(
				АдресВХранилище_ПроверитьОбновление, ИдентификаторФЗ_ПроверитьОбновление,
				АдресВХранилище_ЗагрузитьОбновление, ИдентификаторФЗ_ЗагрузитьОбновление);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьОбновления() Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен()
		И КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
			ИдентификаторФЗ_ПроверитьОбновление, Элементы.ЛоадерПроверитьОбновление) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления", 2, Истина);
		
	Иначе
		
		ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища(
			АдресВХранилище_ПроверитьОбновление, ИдентификаторФЗ_ПроверитьОбновление,
			АдресВХранилище_ЗагрузитьОбновление, ИдентификаторФЗ_ЗагрузитьОбновление);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища(АдресВХранилище_Проверить, ИдентификаторФЗ_Проверить, АдресВХранилище_Загрузить, ИдентификаторФЗ_Загрузить, ВидРасширения = "")
	
	СтруктураОбновленияВерсии = ПолучитьИзВременногоХранилища(АдресВХранилище_Проверить);
	
	Если СтруктураОбновленияВерсии = Неопределено Тогда
		
		ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь, ВидРасширения);
		
	Иначе
		
		ИдентификаторФЗ_Проверить = "";
		ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь, ВидРасширения);
		
		Если Не СтруктураОбновленияВерсии.Успешно Тогда
			
			Если ЗначениеЗаполнено(СтруктураОбновленияВерсии.Ошибка) Тогда
				
				СообщениеОбОшибке = Новый СообщениеПользователю();
				СообщениеОбОшибке.Текст = СтруктураОбновленияВерсии.Ошибка;
				СообщениеОбОшибке.Сообщить();
				
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(СтруктураОбновленияВерсии.СсылкаНаЗагрузку) Тогда
				НачатьЗагрузкуОбновления(АдресВХранилище_Загрузить, ИдентификаторФЗ_Загрузить, СтруктураОбновленияВерсии.СсылкаНаЗагрузку, ВидРасширения);
			Иначе
				
				Если Не ЗначениеЗаполнено(ВидРасширения) И ОтображатьДополнитильныеРекизитыУчСист Тогда
					ПроверитьОбновленияНаКлиенте("ДополнительныеРеквизиты", Истина);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму_ЗапущенаПроверкаОбновления(ПроверкаВыполняется, ВидРасширения = "")
	
	Если ВидРасширения = "ДополнительныеРеквизиты" Тогда 
		Элементы.ЛоадерПроверитьОбновлениеДополнительныеРеквизиты.Видимость = ПроверкаВыполняется;
		Элементы.ДекорацияПроверкаОбновленияДополнительныеРеквизиты.Видимость = ПроверкаВыполняется;
		Элементы.НастроитьДополнительныеРеквизиты.Видимость = ОтображатьДополнитильныеРекизитыУчСист;
	ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
		Элементы.ЛоадерПроверитьОбновлениеQR.Видимость = ПроверкаВыполняется;
		Элементы.ДекорацияПроверкаОбновленияQR.Видимость = ПроверкаВыполняется;
	Иначе
		Элементы.ЛоадерПроверитьОбновление.Видимость = ПроверкаВыполняется;
		Элементы.ДекорацияПроверкаОбновления.Видимость = ПроверкаВыполняется;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуОбновления(Адрес, ИдентификаторФЗ, СсылкаНаЗагрузку, ВидРасширения = "")
	
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Истина, ВидРасширения);
	
	Адрес = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("СсылкаНаЗагрузку", СсылкаНаЗагрузку);
	
	РезультатЗапуска = КонтурЛогистика_ОбновлениеКлиент.НачатьЗагрузкуДанных(
		Адрес, ПараметрыФоновогоЗадания);
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
			УстановитьОбновлениеПослеЗагрузки_ДополнительныеРеквизиты();
		ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
			УстановитьОбновлениеПослеЗагрузки_QR();
		Иначе
			УстановитьОбновлениеПослеЗагрузки();
		КонецЕсли;
	Иначе
		ИдентификаторФЗ = РезультатЗапуска.ИдентификаторЗадания;
		Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление_ДополнительныеРеквизиты", 1, Истина);
		ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление_QR", 1, Истина);
		Иначе
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление", 1, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ЗагрузитьОбновление() Экспорт
	
	Если КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ЗагрузитьОбновление, Элементы.ЛоадерПроверитьОбновление) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление", 2, Истина);
	Иначе
		УстановитьОбновлениеПослеЗагрузки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбновлениеПослеЗагрузки()
	
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Ложь);
	
	Успех = КонтурЛогистика_ОбновлениеСервер.УстановитьОбновление(АдресВХранилище_ЗагрузитьОбновление, ИмяКонфигурации1С);

	Если Успех Тогда
		Элементы.ГруппаПредупреждение.Видимость = Истина;
		Сообщить(
			"Дополнительная обработка установлена.
			|Чтобы продолжить работу с учетом сделанных изменений, необходимо перезапустить программу.");
	Иначе
		ОтображатьПанельВУчетныхДокументах = Ложь;
		УстановитьНастройку("ОтображатьПанельВУчетныхДокументах", ОтображатьПанельВУчетныхДокументах);
	КонецЕсли;
	
	Если ОтображатьДополнитильныеРекизитыУчСист Тогда
		ПроверитьОбновленияНаКлиенте("ДополнительныеРеквизиты", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму_ЗапущенаЗагрузкаОбновления(ЗагрузкаВыполняется, ВидРасширения = "")

	Если ВидРасширения = "ДополнительныеРеквизиты" Тогда
		Элементы.ЛоадерПроверитьОбновлениеДополнительныеРеквизиты.Видимость = ЗагрузкаВыполняется;
		Элементы.ДекорацияЗагрузкаОбновленияДополнительныеРеквизиты.Видимость = ЗагрузкаВыполняется;
	ИначеЕсли ВидРасширения = "QR_МП_УАТ" Тогда
		Элементы.ЛоадерПроверитьОбновлениеQR.Видимость = ЗагрузкаВыполняется;
		Элементы.ДекорацияЗагрузкаОбновленияQR.Видимость = ЗагрузкаВыполняется;
	Иначе
		Элементы.ЛоадерПроверитьОбновление.Видимость = ЗагрузкаВыполняется;
		Элементы.ДекорацияЗагрузкаОбновления.Видимость = ЗагрузкаВыполняется;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеОписаниеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗавершитьРаботуСистемы(Ложь, Истина);
КонецПроцедуры

&НаСервере
Процедура УдалитьНастройкиДополнительногоРасширения()
	
	ГруппаНастроек = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "НастройкиОтображенияПанелиВУчетныхДокументах");
	Если ГруппаНастроек.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СправочникОбъект = ГруппаНастроек.ПолучитьОбъект();
	СправочникОбъект.Удалить();
	
КонецПроцедуры

#КонецОбласти

#Область ТестовыеОрганизации

&НаКлиенте
Процедура ОбновитьВидимостьТестовыхОрганизаций()
	
	Элементы.ПоясненияМедикаТестоваяОрганизация.Видимость = ИспользуютсяПутевыеЛисты;
	Элементы.ГруппаМедикТестовыеОрганизации.Видимость = ИспользуютсяПутевыеЛисты;
	
	ИдентификаторыТестовыхОрганизаций = КонтурЛогистика_ОбщегоНазначенияСервер.ИдентификаторыТестовыхОрганизаций();
	
	Для Каждого ТекущаяСтрока Из ИдентификаторыТестовыхОрганизаций Цикл
		ИмяЭлемента = "ТестоваяОрганизация" + ТекущаяСтрока.Ключ;
		ТекущаяОрганизация = ЭтаФорма[ИмяЭлемента];
		ОрганизацияЗаполнена = ЗначениеЗаполнено(ТекущаяОрганизация);
		
		Элементы[ТекущаяСтрока.Ключ + "ВыклТестовыеОрганизации"].Видимость = Не ОрганизацияЗаполнена;
		Элементы[ТекущаяСтрока.Ключ + "ВклТестовыеОрганизации"].Видимость = ОрганизацияЗаполнена;
		Элементы[ИмяЭлемента].Видимость = ОрганизацияЗаполнена;
		
		Если ОрганизацияЗаполнена Тогда
			СвязанныеОбъекты = СвязанныеОбъектыОрганизации(ТекущаяОрганизация);
			Элементы[ТекущаяСтрока.Ключ + "СопоставитьТестовуюОрганизацию"].Видимость = (СвязанныеОбъекты.Количество() = 0);
		Иначе
			Элементы[ТекущаяСтрока.Ключ + "СопоставитьТестовуюОрганизацию"].Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыклТестовыеОрганизацииНажатие(Элемент)
	
	РольОрганизации = СтрЗаменить(Элемент.Имя, "ВыклТестовыеОрганизации", "");
	
	СоздатьНайтиТекстовыеОрганизации(РольОрганизации);
	
	ОбновитьВидимостьТестовыхОрганизаций();
	
	ОрганизацияСсылка = ЭтаФорма["ТестоваяОрганизация" + РольОрганизации];
	Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		СвязанныеОбъекты = СвязанныеОбъектыОрганизации(ОрганизацияСсылка);
		
		Если СвязанныеОбъекты.Количество() = 0 Тогда
			// Необходимо сопоставить организацию
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Организация", ОрганизацияСсылка);
			
			ИмяФормыСправочника = "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаПодбораСвязанныхОбъектов";
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
				"СопоставлениеТестовойОрганизацииЗавершение", РольОрганизации, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
		// Проверяем наличие приглашения и отправляем если требуется
		ПроверкаОтправкаПриглашенийСТестовымиОрганизациями(, ОрганизацияСсылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВклТестовыеОрганизацииНажатие(Элемент)
	
	РольОрганизации = СтрЗаменить(Элемент.Имя, "ВклТестовыеОрганизации", "");
	
	ОрганизацияСсылка = ЭтаФорма["ТестоваяОрганизация" + РольОрганизации];
	
	Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПометитьНаУдалениеОрганизацтю(ОрганизацияСсылка);
	
	ЭтаФорма["ТестоваяОрганизация" + РольОрганизации] = Неопределено;
	
	ОбновитьВидимостьТестовыхОрганизаций();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеТестовыхОрганизаций()
	
	ИдентификаторыТестовыхОрганизаций = КонтурЛогистика_ОбщегоНазначенияСервер.ИдентификаторыТестовыхОрганизаций();
	
	Для Каждого ТекущаяСтрока Из ИдентификаторыТестовыхОрганизаций Цикл
		ОрганизацияСсылка = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ИдентификаторУчастникаЭДО", ТекущаяСтрока.Значение);
		
		Если ОрганизацияСсылка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяЭлемента = "ТестоваяОрганизация" + ТекущаяСтрока.Ключ;
		ЭтаФорма[ИмяЭлемента] = ОрганизацияСсылка;
		Элементы[ИмяЭлемента].Видимость = ЗначениеЗаполнено(ОрганизацияСсылка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьНайтиТекстовыеОрганизации(РольОрганизации = "")
	
	ИдентификаторыТестовыхОрганизаций = КонтурЛогистика_ОбщегоНазначенияСервер.ИдентификаторыТестовыхОрганизаций();
	
	ТестовыеОрганизации = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из ИдентификаторыТестовыхОрганизаций Цикл
		Если РольОрганизации <> "" И ТекущаяСтрока.Ключ <> РольОрганизации Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиСоздатьПоИдентификаторуЭДО(ТекущаяСтрока.Значение);
		
		ТестовыеОрганизации.Добавить(НоваяОрганизация);
		ЭтаФорма["ТестоваяОрганизация" + ТекущаяСтрока.Ключ] = НоваяОрганизация;
		
		// Дополним телефоном и снимаем пометку удаления (если была)
		ОрганизацияОбъект = НоваяОрганизация.ПолучитьОбъект();
		ОрганизацияОбъект.ПометкаУдаления = Ложь;
		ОрганизацияОбъект.ТелефонОсновной = "хххххххххх";
		ОрганизацияОбъект[РольОрганизации] = Истина;
		ОрганизацияОбъект.Записать();
	КонецЦикла;
	
	Если ТестовыеОрганизации.Количество() <> 0 Тогда
		Справочники.КонтурЛогистика_ОрганизацииДиадок.АктуализироватьИзДиадока(ТестовыеОрганизации);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвязанныеОбъектыОрганизации(Организация)
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.СвязанныеОбъекты(Организация);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПометитьНаУдалениеОрганизацтю(Организация)
	
	ОрганизацияОбъект = Организация.ПолучитьОбъект();
	ОрганизацияОбъект.ПометкаУдаления = Истина;
	ОрганизацияОбъект.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьТестовуюОрганизацию(Команда)
	
	РольОрганизации = СтрЗаменить(ТекущийЭлемент.Имя, "СопоставитьТестовуюОрганизацию", "");
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Организация", ЭтаФорма["ТестоваяОрганизация" + РольОрганизации]);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаПодбораСвязанныхОбъектов";
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"СопоставлениеТестовойОрганизацииЗавершение", РольОрганизации, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеТестовойОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	РольОрганизации = ДополнительныеПараметры;
	
	СвязанныеОбъекты = СвязанныеОбъектыОрганизации(ЭтаФорма["ТестоваяОрганизация" + РольОрганизации]);
	Элементы[РольОрганизации + "СопоставитьТестовуюОрганизацию"].Видимость = (СвязанныеОбъекты.Количество() = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаказТестовыхДокументов(Команда)
	
	// Проверяем наличие тестового грузоотправителя, иначе не даем заказать
	Если Не ЗначениеЗаполнено(ТестоваяОрганизацияГрузоотправитель) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо включить тестового грузоотправителя";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		
		Возврат;
	КонецЕсли;
	
	// Ищем, есть ли наш ПВ
	ПодставитьЮрЛицо = НашПеревозчикИлиГрузополучатель();
	
	Адрес = "https://forms.kontur.ru/form/df9b0b5e-ed08-4b9f-ba1b-6cbdf3360309?docs_number=3";
	
	Если ПодставитьЮрЛицо <> Неопределено Тогда 
		Постфикс = ПостфиксЗаказаТРН(ПодставитьЮрЛицо);
	Иначе
		Постфикс = "";
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82()
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2_13() Тогда
		
		ЗапуститьПриложение(Адрес + Постфикс);
	Иначе
		ПерейтиПоНавигационнойСсылке(Адрес + Постфикс);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПостфиксЗаказаТРН(ПодставитьЮрЛицо)
	
	Постфикс = "&my_company.name=" + ПодставитьЮрЛицо.НаименованиеОрганизацииПолное + "&my_company.inn=" + ПодставитьЮрЛицо.ИНН + "&my_company.kpp=" + ПодставитьЮрЛицо.КПП;
	Возврат Постфикс;
	
КонецФункции

&НаСервере
Функция НашПеревозчикИлиГрузополучатель()
	
	НайденныйГП = Неопределено;
	МассивНашихОрганизаций = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	
	// Вернем сразу перевозчика, а если перевозчиков нет, то ГП
	Для Каждого НашаОрганизация Из МассивНашихОрганизаций Цикл 
		
		Если НашаОрганизация.Перевозчик Тогда 
			Возврат НашаОрганизация;
		КонецЕсли;
		
		Если НашаОрганизация.Грузополучатель и НайденныйГП = Неопределено Тогда 
			НайденныйГП = НашаОрганизация;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НайденныйГП;
	
КонецФункции

&НаСервере
Процедура ПроверкаОтправкаПриглашенийСТестовымиОрганизациями(Организация = Неопределено, Контрагент = Неопределено)
	
	Для Каждого ТекущаяНашаОрганизация Из ОрганизацииДиадокИРоли Цикл
		
		РеквизитыОрганизации = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ТекущаяНашаОрганизация.ОрганизацияДиадок, "Наш, Грузоотправитель, Перевозчик, Грузополучатель, Медик");
		
		// Не наша
		Если Не РеквизитыОрганизации.Наш Тогда
			Продолжить;
		КонецЕсли;
		
		// Нет ни одной роли
		Если Не РеквизитыОрганизации.Грузоотправитель
			И Не РеквизитыОрганизации.Перевозчик
			И Не РеквизитыОрганизации.Грузополучатель
			И Не РеквизитыОрганизации.Медик Тогда
			
			Продолжить;
		КонецЕсли;
		
		// Только по одной организации
		Если ЗначениеЗаполнено(Организация) И ТекущаяНашаОрганизация.ОрганизацияДиадок <> Организация Тогда
			Продолжить;
		КонецЕсли;
		
		// Если мы принимаем от всех организаций, то приглашения отправлять не требуется
		Если СокрЛП(ТекущаяНашаОрганизация.Sociability) = "AllOrganizations" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Контрагент) Тогда
			
			// Проверяем наличие приглашения и отправляем если требуется
			Если Не ЕстьПриглашение(ТекущаяНашаОрганизация.ОрганизацияДиадок, Контрагент) Тогда
				КонтурЛогистика_API_Диадок.Диадок_АПИ_AcquireCounteragent(ТекущаяНашаОрганизация.ОрганизацияДиадок, Контрагент);
			КонецЕсли;
			
		Иначе
			
			ИдентификаторыТестовыхОрганизаций = КонтурЛогистика_ОбщегоНазначенияСервер.ИдентификаторыТестовыхОрганизаций();
			Для Каждого ТекущийИдентификатор Из ИдентификаторыТестовыхОрганизаций Цикл
				ИмяЭлемента = "ТестоваяОрганизация" + ТекущийИдентификатор.Ключ;
				ТекущийКонтрагент = ЭтаФорма[ИмяЭлемента];
				
				Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
					Продолжить;
				КонецЕсли;
				
				// Проверяем наличие приглашения и отправляем если требуется
				Если Не ЕстьПриглашение(ТекущаяНашаОрганизация.ОрганизацияДиадок, ТекущийКонтрагент) Тогда
					КонтурЛогистика_API_Диадок.Диадок_АПИ_AcquireCounteragent(ТекущаяНашаОрганизация.ОрганизацияДиадок, ТекущийКонтрагент);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьПриглашение(Организация, Контрагент)
	
	ЕстьПриглашение = Ложь;
	
	Counteragent = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetCounteragent(Организация, Контрагент);
	
	Если Counteragent.Свойство("ПартнерскиеОтношенияНеУстановлены") Тогда
		ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.NotInCounteragentList;
	КонецЕсли;
	
	Если Counteragent.Свойство("CurrentStatus") Тогда
		ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов[Counteragent.CurrentStatus];
	Иначе
		ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.IsMyCounteragent
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.InvitesMe
		Или ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыКонтрагентов.IsInvitedByMe Тогда
		
		ЕстьПриглашение = Истина;
	КонецЕсли;
	
	Возврат ЕстьПриглашение;
	
КонецФункции

&НаКлиенте
Процедура Заявка(Команда)
	
