#Область РасширениеQR_МП_УАТ

&НаКлиенте
Процедура ПередаватьQRВМПВодительУАТПриИзменении(Элемент)
	
	УстановитьНастройку("ПередаватьQRВМПВодительУАТ", ПередаватьQRВМПВодительУАТ);
	
	Если ПередаватьQRВМПВодительУАТ И Не Элементы.ГруппаПредупреждениеQR.Видимость Тогда
		ПроверитьОбновленияНаКлиенте("QR_МП_УАТ");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтображениеРасширенияQR()
		
	Если НЕ (ИмяКонфигурации1С = "УАТ_ПРОФ"
		Или ИмяКонфигурации1С = "ERP_УАТ"
		Или ИмяКонфигурации1С = "ТЛЭ") Тогда
			
		Элементы.ГруппаQRРасширение.Видимость = Ложь;
		Возврат;
		
	КонецЕсли;
	
	Элементы.ГруппаQRРасширение.Видимость = Истина;
	
	Если КонтурЛогистика_ОбновлениеСерверПовтИсп.СтараяВерсияУАТ_QR_МП_УАТ(ИмяКонфигурации1С) Тогда
		
		Элементы.ПередаватьQRВМПВодительУАТ.Доступность = Ложь;
		
		Если ИмяКонфигурации1С = "ТЛЭ" Тогда
			ВерсияДляПодсказки = "ТЛЭ 1.1.33.1";
		ИначеЕсли ИмяКонфигурации1С = "ERP_УАТ" Тогда
			ВерсияДляПодсказки = "УАТ для ERP 2.5.18.1";
		Иначе
			ВерсияДляПодсказки = "УАТ ПРОФ 2.2.33.1";
		КонецЕсли;
			
		Элементы.ПередаватьQRВМПВодительУАТ.Подсказка = 
			"Функционал доступен в версиях " + ВерсияДляПодсказки + " и более." + Символы.ПС
			+ Элементы.ПередаватьQRВМПВодительУАТ.Подсказка;
			
	КонецЕсли;
	
	ГруппаНастроек = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "ОбщиеНастройки");
	
	НастройкаПередаватьQRВМПВодительУАТ = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "ПередаватьQRВМПВодительУАТ");
	Если НастройкаПередаватьQRВМПВодительУАТ.Пустая() Тогда
		НовыйЭлемент = Справочники.КонтурЛогистика_Настройки.СоздатьЭлемент();
		НовыйЭлемент.Родитель = ГруппаНастроек;
		НовыйЭлемент.Наименование = "Передавать QR-код в МП ""Водитель УАТ""";
		НовыйЭлемент.ИмяПредопределенногоДляРасширения = "ПередаватьQRВМПВодительУАТ";
		НовыйЭлемент.ТипЗначения = "Булево";
		НовыйЭлемент.Значение = Истина;
		НовыйЭлемент.Описание = "Включает/выключает передачу QR-кода в мобильное приложение ""Водитель УАТ""";
		НовыйЭлемент.Записать();
		
		НастройкаПередаватьQRВМПВодительУАТ = НовыйЭлемент.Ссылка;
	КонецЕсли;
	
	ПередаватьQRВМПВодительУАТ = НастройкаПередаватьQRВМПВодительУАТ.Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ЗагрузитьОбновление_QR() Экспорт
	
	Если КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ЗагрузитьОбновлениеQR, Элементы.ЛоадерПроверитьОбновлениеQR) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ЗагрузитьОбновление_QR", 2, Истина);
	Иначе
		УстановитьОбновлениеПослеЗагрузки_QR();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗадание_ПроверитьОбновления_QR() Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен()
		И КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
			ИдентификаторФЗ_ПроверитьОбновлениеQR, Элементы.ЛоадерПроверитьОбновлениеQR) Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗадание_ПроверитьОбновления_QR", 2, Истина);
		
	Иначе
		
		ЗаполнитьДанныеОбОбновленииНаФормеИзХранилища(
			АдресВХранилище_ПроверитьОбновлениеQR, ИдентификаторФЗ_ПроверитьОбновлениеQR,
			АдресВХранилище_ЗагрузитьОбновлениеQR, ИдентификаторФЗ_ЗагрузитьОбновлениеQR,
			"QR_МП_УАТ");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбновлениеПослеЗагрузки_QR()
	
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Ложь);
	
	Успех = КонтурЛогистика_ОбновлениеСервер.УстановитьОбновление(АдресВХранилище_ЗагрузитьОбновлениеQR, ИмяКонфигурации1С, "QR_МП_УАТ");
	
	Если Успех Тогда
		Элементы.ГруппаПредупреждениеQR.Видимость = Истина;
		Сообщить(
			"Функционал передачи QR-кода в мобильное приложение ""Водитель УАТ"" установлен.
			|Чтобы продолжить работу с учетом сделанных изменений, необходимо перезапустить программу.");
	Иначе
		ПередаватьQRВМПВодительУАТ = Ложь;
		УстановитьНастройку("ПередаватьQRВМПВодительУАТ", ПередаватьQRВМПВодительУАТ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ГруппыДоступа

&НаСервере
Процедура ОбновитьВидимостьДоступностьГруппДоступа()
	
	ИмяСправочникаГруппыДоступа = "Справочники.ГруппыДоступа";
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные(ИмяСправочникаГруппыДоступа) Тогда
		ДанныеПоГруппамДоступа = ДанныеПоГруппамДоступа();
		
		Элементы.ДекорацияГруппаДоступаАдминистратор.Видимость = ДанныеПоГруппамДоступа.Администратор.ЕстьГруппа;
		Если ДанныеПоГруппамДоступа.Администратор.КоличествоПользователей = Неопределено Тогда
			Элементы.ДекорацияГруппаДоступаАдминистратор.Заголовок = "Администраторы";
		Иначе
			Элементы.ДекорацияГруппаДоступаАдминистратор.Заголовок = "Администраторы ("
				+ Формат(ДанныеПоГруппамДоступа.Администратор.КоличествоПользователей, "ЧН=0; ЧГ=0") + ")";
		КонецЕсли;
		
		Элементы.ДекорацияГруппаДоступаПродвинутыйПользователь.Видимость = ДанныеПоГруппамДоступа.ПродвинутыйПользователь.ЕстьГруппа;
		Если ДанныеПоГруппамДоступа.ПродвинутыйПользователь.КоличествоПользователей = Неопределено Тогда
			Элементы.ДекорацияГруппаДоступаПродвинутыйПользователь.Заголовок = "Продвинутые пользователи";
		Иначе
			Элементы.ДекорацияГруппаДоступаПродвинутыйПользователь.Заголовок = "Продвинутые пользователи ("
				+ Формат(ДанныеПоГруппамДоступа.ПродвинутыйПользователь.КоличествоПользователей, "ЧН=0; ЧГ=0") + ")";
		КонецЕсли;
		
		Элементы.ДекорацияГруппаДоступаПользователь.Видимость = ДанныеПоГруппамДоступа.Пользователь.ЕстьГруппа;
		Если ДанныеПоГруппамДоступа.Пользователь.КоличествоПользователей = Неопределено Тогда
			Элементы.ДекорацияГруппаДоступаПользователь.Заголовок = "Пользователи";
		Иначе
			Элементы.ДекорацияГруппаДоступаПользователь.Заголовок = "Пользователи ("
				+ Формат(ДанныеПоГруппамДоступа.Пользователь.КоличествоПользователей, "ЧН=0; ЧГ=0") + ")";
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ГруппаГруппыДоступа.Видимость =
		(Элементы.ДекорацияГруппаДоступаАдминистратор.Видимость
			Или Элементы.ДекорацияГруппаДоступаПродвинутыйПользователь.Видимость
			Или Элементы.ДекорацияГруппаДоступаПользователь.Видимость);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГруппаДоступаАдминистраторНажатие(Элемент)
	
	ИмяГруппыДоступа = "Администраторы (Контур.Логистика)";
	ОткрытьГруппуДоступа(ИмяГруппыДоступа);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГруппаДоступаПродвинутыйПользовательНажатие(Элемент)
	
	ИмяГруппыДоступа = "Продвинутые пользователи (Контур.Логистика)";
	ОткрытьГруппуДоступа(ИмяГруппыДоступа);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГруппаДоступаПользовательНажатие(Элемент)
	
	ИмяГруппыДоступа = "Пользователи (Контур.Логистика)";
	ОткрытьГруппуДоступа(ИмяГруппыДоступа);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьГруппуДоступа(ИмяГруппыДоступа)
	
	СсылкаНаГруппу = ГруппаДоступаПоИмени(ИмяГруппыДоступа);
	Если ЗначениеЗаполнено(СсылкаНаГруппу) Тогда
		ПоказатьЗначение(, СсылкаНаГруппу);
	Иначе
		Сообщить("Не удалось найти группу доступа: " + ИмяГруппыДоступа);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ГруппаДоступаПоИмени(ИмяГруппыДоступа)
	
	Возврат Справочники["ГруппыДоступа"].НайтиПоНаименованию(ИмяГруппыДоступа, Истина);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеПоГруппамДоступа()
	
	ДанныеПоГруппамДоступа = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГруппыДоступа.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГруппыДоступаПользователи.Пользователь) КАК Пользователь
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГруппыДоступа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
	|ГДЕ
	|	ГруппыДоступа.Наименование = ""Администраторы (Контур.Логистика)""
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыДоступа.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыДоступа.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГруппыДоступаПользователи.Пользователь) КАК Пользователь
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГруппыДоступа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
	|ГДЕ
	|	ГруппыДоступа.Наименование = ""Продвинутые пользователи (Контур.Логистика)""
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыДоступа.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыДоступа.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГруппыДоступаПользователи.Пользователь) КАК Пользователь
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГруппыДоступа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
	|ГДЕ
	|	ГруппыДоступа.Наименование = ""Пользователи (Контур.Логистика)""
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыДоступа.Ссылка";
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// Администратор
	Выборка = Результат[0].Выбрать();
	Выборка.Следующий();
	
	ТекущиеДанные = Новый Структура;
	ТекущиеДанные.Вставить("ЕстьГруппа", ЗначениеЗаполнено(Выборка.Ссылка));
	ТекущиеДанные.Вставить("КоличествоПользователей", Выборка.Пользователь);
	
	ДанныеПоГруппамДоступа.Вставить("Администратор", ТекущиеДанные);
	
	// Продвинутый пользователь
	Выборка = Результат[1].Выбрать();
	Выборка.Следующий();
	
	ТекущиеДанные = Новый Структура;
	ТекущиеДанные.Вставить("ЕстьГруппа", ЗначениеЗаполнено(Выборка.Ссылка));
	ТекущиеДанные.Вставить("КоличествоПользователей", Выборка.Пользователь);
	
	ДанныеПоГруппамДоступа.Вставить("ПродвинутыйПользователь", ТекущиеДанные);
	
	// Пользователь
	Выборка = Результат[2].Выбрать();
	Выборка.Следующий();
	
	ТекущиеДанные = Новый Структура;
	ТекущиеДанные.Вставить("ЕстьГруппа", ЗначениеЗаполнено(Выборка.Ссылка));
	ТекущиеДанные.Вставить("КоличествоПользователей", Выборка.Пользователь);
	
	ДанныеПоГруппамДоступа.Вставить("Пользователь", ТекущиеДанные);
	
	Возврат ДанныеПоГруппамДоступа;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСправочникПользователи(Команда)
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию() = "КЛ" Тогда
		ОткрытьФорму("Справочник.УчетнаяСистема_Пользователи.Форма.ФормаСписка");
	Иначе
		ОткрытьФорму("Справочник.Пользователи.Форма.ФормаСписка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкиПравПодробнееНажатие(Элемент)
	
	ПерейтиПоСсылке("https://support.kontur.ru/logistika-1s/41559-roli_polzovatelej_podsistemy");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьНастроекГруппДоступа()
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение() Тогда
		
		// Современная конфигурация, где есть профили и группы доступа
		Элементы.ГруппаНастройкаПравНетГруппДоступа.Видимость = Ложь;
		
		ИмяСправочникаГруппыДоступа = "Справочники.ГруппыДоступа";
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные(ИмяСправочникаГруппыДоступа) Тогда
			// Проверим / Создадим группы и профили доступа
			КонтурЛогистика_ОбщегоНазначенияСервер.СоздатьГруппыДоступа();
		КонецЕсли;
		
		ОбновитьВидимостьДоступностьГруппДоступа();
		
	Иначе
		
		// Старая конфигурация, где надо администрировать через справочник пользователи
		Элементы.ГруппаГруппыДоступа.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПереносНастроекДиадокEDI

&НаСервере
Процедура ПереносПараметровАвторизацииИПроксиИзМодулейКонтура()
	
	ПараметрыУстановкиМодулейКонтура = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПараметрыУстановкиМодулей();
	
	ПеренесеныНастройкиАвторизации = ПеренестиНастройкиАвторизации();
	ПеренесеныНастройкиПрокси = ПеренестиНастройкиПрокси();
	
КонецПроцедуры

&НаСервере
Функция ПеренестиНастройкиАвторизации()
	
	Результат = Ложь;
	
	Если ПараметрыУстановкиМодулейКонтура.Диадок.МодульУстановлен Тогда
		
		СлужебнаяУчетнаяЗаписьЛогин = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(
			ПараметрыУстановкиМодулейКонтура.Диадок, "СлужебнаяУчетнаяЗаписьЛогин");
		Если ЗначениеЗаполнено(СлужебнаяУчетнаяЗаписьЛогин) Тогда
			
			Результат = Истина;
			
			API_Логин = СлужебнаяУчетнаяЗаписьЛогин;
			API_Пароль = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(
				ПараметрыУстановкиМодулейКонтура.Диадок, "СлужебнаяУчетнаяЗаписьПароль");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Результат И ПараметрыУстановкиМодулейКонтура.EDI.МодульУстановлен Тогда
		
		ЛогинСлужебныйДиадок = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("ЛогинСлужебныйДиадок");
		Если ЗначениеЗаполнено(ЛогинСлужебныйДиадок) Тогда
			
			Результат = Истина;
			
			API_Логин = ЛогинСлужебныйДиадок;
			API_Пароль = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("ПарольСлужебныйДиадок");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат Тогда
		// Сохраним настройки
		УстановитьНастройку("ЛогинАвторизацииДиадокАПИ", API_Логин);
		УстановитьНастройку("ПарольАвторизацииДиадокАПИ", API_Пароль);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПеренестиНастройкиПрокси()
	
	Результат = Ложь;
	
	Если ПараметрыУстановкиМодулейКонтура.Диадок.МодульУстановлен Тогда
		
		РежимПрокси = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(
			ПараметрыУстановкиМодулейКонтура.Диадок, "РежимПрокси");
		Если РежимПрокси <> Неопределено Тогда
			
			Результат = Истина;
			
			Попытка
				Прокси_РежимПрокси = Перечисления.КонтурЛогистика_ТипыПрокси[СокрЛП(РежимПрокси)];
			Исключение
				Результат = Ложь;
			КонецПопытки;
			
			Если Результат Тогда
				Прокси_АдресПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(
					ПараметрыУстановкиМодулейКонтура.Диадок, "АдресПроксиСервера");
				Прокси_ПортПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(
					ПараметрыУстановкиМодулейКонтура.Диадок, "ПортПроксиСервера");
				Прокси_ЛогинПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(
					ПараметрыУстановкиМодулейКонтура.Диадок, "ЛогинПроксиСервера");
				Прокси_ПарольПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(	
					ПараметрыУстановкиМодулейКонтура.Диадок, "ПарольПроксиСервера");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Результат И ПараметрыУстановкиМодулейКонтура.EDI.МодульУстановлен Тогда
		
		РежимПрокси = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("ТипПрокси");
		Если РежимПрокси <> Неопределено Тогда
			
			Результат = Истина;
			
			Если РежимПрокси = 0 Тогда
				Прокси_РежимПрокси = Перечисления.КонтурЛогистика_ТипыПрокси.NoProxy;
			ИначеЕсли РежимПрокси = 1
				Или РежимПрокси = 2
				Или РежимПрокси = 3 Тогда
				
				Прокси_РежимПрокси = Перечисления.КонтурЛогистика_ТипыПрокси.UseProxy;
			Иначе
				Результат = Ложь;
			КонецЕсли;
			
			Если Результат Тогда
				Прокси_АдресПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("СерверПрокси");
				Прокси_ПортПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("ПортПрокси");
				Прокси_ЛогинПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("ЛогинПрокси");
				Прокси_ПарольПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("ПарольПрокси");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат Тогда
		Прокси_ПроксиИспользовать = (Прокси_РежимПрокси <> Перечисления.КонтурЛогистика_ТипыПрокси.NoProxy);
		
		// Сохраним настройки
		УстановитьНастройку("РежимПрокси", Прокси_РежимПрокси);
		УстановитьНастройку("ПроксиИспользовать", Прокси_ПроксиИспользовать);
		УстановитьНастройку("АдресПроксиСервера", Прокси_АдресПроксиСервера);
		УстановитьНастройку("ПортПроксиСервера", Прокси_ПортПроксиСервера);
		УстановитьНастройку("ЛогинПроксиСервера", Прокси_ЛогинПроксиСервера);
		УстановитьНастройку("ПарольПроксиСервера", Прокси_ПарольПроксиСервера);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПереносСопоставленийКонтрагентовМодулейКонтура

&НаСервере
Функция ПереносСопоставленийКонтрагентовМодулейКонтура()
	
	Результат = Ложь;
	
	Если ПараметрыУстановкиМодулейКонтура.Диадок.МодульУстановлен Тогда
		
		Результат = ПереносСопоставленийКонтрагентовДиадок(ПараметрыУстановкиМодулейКонтура.Диадок);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПереносСопоставленийКонтрагентовДиадок(НастройкиДиадок)
	
	Результат = Ложь;
	
	ОбъектыКДобавлению = Новый Соответствие;
	
	Если НастройкиДиадок.ИспользоватьТиповуюПодсистему1С Тогда
		
		// Получи свойство по имени настройки
		ИмяСвойства = "ДДКонтр_";
		Если НастройкиДиадок.ЭтоУФ Тогда
			СвойствоНастройки = ПланыВидовХарактеристик["ДополнительныеРеквизитыИСведения"].НайтиПоНаименованию(ИмяСвойства, Истина);
		Иначе
			СвойствоНастройки = ПланыВидовХарактеристик["СвойстваОбъектов"].НайтиПоНаименованию(ИмяСвойства, Истина);
		КонецЕсли;
		
		Если СвойствоНастройки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Получим значение по свойству
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство", СвойствоНастройки);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Объект КАК Объект,
		|	ЗначенияСвойствОбъектов.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Свойство = &Свойство";
		
		Если НастройкиДиадок.ЭтоУФ Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗначенияСвойствОбъектов", "ДополнительныеСведения");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Объект)
				Или Не ЗначениеЗаполнено(Выборка.Значение) Тогда
				
				Продолжить;
			КонецЕсли;
			
			Идентификатор = КонтурЛогистика_API_Диадок.АдресЯщикаВИдентификатор(Выборка.Значение);
			СвязанныеОбъекты = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Объект);
			
			ТекущееЗначение = ОбъектыКДобавлению.Получить(Идентификатор);
			Если ТекущееЗначение = Неопределено Тогда
				ОбъектыКДобавлению.Вставить(Идентификатор, СвязанныеОбъекты);
			Иначе
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТекущееЗначение, СвязанныеОбъекты);
				ОбъектыКДобавлению.Вставить(Идентификатор, ТекущееЗначение);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИмяСправочника", "Контрагенты");
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Диадок_ЮрФизЛица.ID КАК ID,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник1 КАК СвязанныйСправочник1,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник2 КАК СвязанныйСправочник2,
		|	Диадок_ЮрФизЛица.СвязанныйСправочник3 КАК СвязанныйСправочник3
		|ИЗ
		|	Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
		|ГДЕ
		|	Диадок_ЮрФизЛица.ИмяСправочника = &ИмяСправочника";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СвязанныеОбъекты = Новый Массив;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник1) Тогда
				СвязанныеОбъекты.Добавить(Выборка.СвязанныйСправочник1);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник2) Тогда
				СвязанныеОбъекты.Добавить(Выборка.СвязанныйСправочник2);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.СвязанныйСправочник3) Тогда
				СвязанныеОбъекты.Добавить(Выборка.СвязанныйСправочник3);
			КонецЕсли;
			
			Если СвязанныеОбъекты.Количество() <> 0 Тогда
				Идентификатор = КонтурЛогистика_API_Диадок.АдресЯщикаВИдентификатор(Выборка.ID);
				
				ТекущееЗначение = ОбъектыКДобавлению.Получить(Идентификатор);
				Если ТекущееЗначение = Неопределено Тогда
					ОбъектыКДобавлению.Вставить(Идентификатор, СвязанныеОбъекты);
				Иначе
					КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТекущееЗначение, СвязанныеОбъекты);
					ОбъектыКДобавлению.Вставить(Идентификатор, ТекущееЗначение);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ОбъектКДобавлению Из ОбъектыКДобавлению Цикл
		
		boxID = ОбъектКДобавлению.Ключ;
		Контрагенты = ОбъектКДобавлению.Значение;
		
		ОрганизацияСсылка = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОрганиациюДДПоId(boxID);
		
		Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
		
		Для Каждого ТекущийКонтрагент Из Контрагенты Цикл
			ПараметрыОтбора = Новый Структура("Контрагент", ТекущийКонтрагент);
			НайденныеСтроки = ОрганизацияОбъект.Контрагенты.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ОрганизацияОбъект.Записать();
			Результат = Истина;
		Исключение
			НичегоНеДелаем = Истина;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Прокси

&НаКлиенте
Процедура ОбновитьВидимостьДоступностьПрокси(ПриОткрытии = Ложь)
	
	ИспользоватьНастройкиМодуля = (Прокси_РежимПрокси = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыПрокси.UseProxy"));
	
	ВидимостьНастроекПрокси = (ИспользоватьНастройкиМодуля И Прокси_ПроксиИспользовать);
	
	Элементы.Прокси_АдресПроксиСервера.Видимость = ВидимостьНастроекПрокси;
	Элементы.Прокси_ПортПроксиСервера.Видимость = ВидимостьНастроекПрокси;
	Элементы.Прокси_ЛогинПроксиСервера.Видимость = ВидимостьНастроекПрокси;
	Элементы.Прокси_ПарольПроксиСервера.Видимость = ВидимостьНастроекПрокси;
	
	Если ПриОткрытии И Не Прокси_ПроксиИспользовать Тогда
		
		Попытка
			Элементы.ГруппаПараметрыПрокси.Скрыть();
		Исключение
		    // перед нами что-то очень старое где у группы нет метода скрыть. ну пусть мешается
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучимНастройкиПрокси()
	
	Прокси_РежимПрокси = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимПрокси");
	Прокси_ПроксиИспользовать = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПроксиИспользовать");
	Прокси_ЛогинПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЛогинПроксиСервера");
	Прокси_ПарольПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПарольПроксиСервера");
	Прокси_ПортПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПортПроксиСервера");
	Прокси_АдресПроксиСервера = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("АдресПроксиСервера");
	
	// Если прокси выключено, то и режим сбросим
	Если Не Прокси_ПроксиИспользовать И Прокси_РежимПрокси <> Перечисления.КонтурЛогистика_ТипыПрокси.NoProxy Тогда
		Прокси_РежимПрокси = Перечисления.КонтурЛогистика_ТипыПрокси.NoProxy;
		УстановитьНастройку("РежимПрокси", Прокси_РежимПрокси);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Прокси_РежимПроксиПриИзменении(Элемент)
	
	УстановитьНастройку("РежимПрокси", Прокси_РежимПрокси);
	
	// Включим использование прокси
	Прокси_ПроксиИспользовать = (Прокси_РежимПрокси <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыПрокси.NoProxy"));
	УстановитьНастройку("ПроксиИспользовать", Прокси_ПроксиИспользовать);
	
	ОбновитьВидимостьДоступностьПрокси();
	
КонецПроцедуры

&НаКлиенте
Процедура Прокси_АдресПроксиСервераПриИзменении(Элемент)
	
	УстановитьНастройку("АдресПроксиСервера", Прокси_АдресПроксиСервера);
	
	ОбновитьВидимостьДоступностьПрокси();
	
КонецПроцедуры

&НаКлиенте
Процедура Прокси_ПортПроксиСервераПриИзменении(Элемент)
	
	УстановитьНастройку("ПортПроксиСервера", Прокси_ПортПроксиСервера);
	
	ОбновитьВидимостьДоступностьПрокси();
	
КонецПроцедуры

&НаКлиенте
Процедура Прокси_ЛогинПроксиСервераПриИзменении(Элемент)
	
	УстановитьНастройку("ЛогинПроксиСервера", Прокси_ЛогинПроксиСервера);
	
	ОбновитьВидимостьДоступностьПрокси();
	
КонецПроцедуры

&НаКлиенте
Процедура Прокси_ПарольПроксиСервераПриИзменении(Элемент)
	
	УстановитьНастройку("ПарольПроксиСервера", Прокси_ПарольПроксиСервера);
	
	ОбновитьВидимостьДоступностьПрокси();
	
КонецПроцедуры

#КонецОбласти

#Область Авторизация

&НаКлиенте
Процедура АвторизоватьсяНаПортале(Команда)
	
	ПараметрыФормы = Новый Структура;
	Если КоличествоНашихОрганизаций() = 0 Тогда
		ПараметрыФормы.Вставить("АвторизацияПриОткрытии");
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_Аутентификация.Форма.ФормаАвторизацииОрганизаций", ПараметрыФормы,
		ЭтаФорма, ЭтаФорма, "АвторизоватьсяНаПорталеЗавершение",, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизоватьсяНаПорталеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ЕстьПортальныеАвторизации() Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоНашихОрганизаций()
	
	ВсеНашиОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	
	Возврат ВсеНашиОрганизации.Количество();
	
КонецФункции

&НаКлиенте
Процедура Шаг4ИнструкцияНажатие(Элемент)
	
	СсылкаНаИнструкцию = "https://support.kontur.ru/logistika-1s/nastrojki-modulya";
	
	ПерейтиПоСсылке(СсылкаНаИнструкцию);
	
КонецПроцедуры

#КонецОбласти

#Область Обучение

&НаКлиенте
Процедура ОбучениеАдминистратор1Нажатие(Элемент)
	
	ПерейтиПоСсылке(Элемент.Подсказка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоСсылке(СсылкаПерехода)
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		ЗапуститьПриложение(СсылкаПерехода);
	Иначе
		ПерейтиПоНавигационнойСсылке(СсылкаПерехода);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти