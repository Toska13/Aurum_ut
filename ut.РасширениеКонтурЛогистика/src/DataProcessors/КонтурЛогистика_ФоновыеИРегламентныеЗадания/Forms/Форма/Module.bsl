	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПерезаполнитьРегламентныеЗадания();	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРегламентные(Команда)
	
	Объект.РегламентныеЗаданияПодсистемы.Очистить();
	ОбновитьРегламентныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФоновыеНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПерезаполнитьФоновыеЗадания();	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФоновые(Команда = Неопределено)
	Объект.ФоновыеЗаданияПодсистемы.Очистить();
	ОбновитьФоновыеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПерезаполнитьРегламентныеЗадания();	
	ОбработкаОбъект.ПерезаполнитьФоновыеЗадания();	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсе(Команда)
	Объект.ФоновыеЗаданияПодсистемы.Очистить();
	Объект.РегламентныеЗаданияПодсистемы.Очистить();
	ОбновитьВсеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗаданияПодсистемыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
		Или ЕстьРольНастройкаПодсистемы() Тогда
		
		Если Поле.Имя <> "РегламентныеЗаданияПодсистемыПользователь" Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
		
		Если Элемент.ТекущиеДанные <> Неопределено Тогда
			
			Если Поле.Имя = "РегламентныеЗаданияПодсистемыИспользование" Тогда
				
				НовоеПоложение = ВключитьВыключитьРегламентноеЗадание(Элемент.ТекущиеДанные.Идентификатор);
				Элемент.ТекущиеДанные.Использование = НовоеПоложение;
				
				ОбновитьВсеНаСервере();
				
				Если Элемент.ТекущиеДанные.Ключ = "КонтурЛогистика_АвтоматическоеПолучениеИОтправкаQRКодов" Тогда
					УстановитьЗначениеНастройки("АвтоматическоеПолучениеИОтправкаQRКодов", НовоеПоложение);			
				КонецЕсли;
				
			ИначеЕсли Поле.Имя = "РегламентныеЗаданияПодсистемыРасписание" Тогда
				
				текРасписание = ПолучитьРасписаниеЗадания(Элемент.ТекущиеДанные.Идентификатор);
				
				Диалог = Новый ДиалогРасписанияРегламентногоЗадания(текРасписание);
				ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ЗавершениеРедактированияРасписания", ЭтаФорма, Элемент.ТекущиеДанные.Идентификатор);
				Диалог.Показать(ОписаниеОповещенияОЗакрытии);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Доступно только с ролью ""Настройка подсистемы"" или полными правами");
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗначениеНастройки(ИмяНастройки, Значение)	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяНастройки, Значение);	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьРольНастройкаПодсистемы()
	
	Возврат РольДоступна("КонтурЛогистика_НастройкаПодсистемы");
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеРедактированияРасписания(РасписаниеРезультат, ИентификаторРегЗадания) Экспорт 
	
	Если РасписаниеРезультат <> Неопределено Тогда
		
		УстановитьРасписание(ИентификаторРегЗадания, РасписаниеРезультат);
		Элементы.РегламентныеЗаданияПодсистемы.ТекущиеДанные.Расписание = Строка(РасписаниеРезультат);;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРасписание(ИдентификаторРегЗадания, Расписание)

	текРЗ = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторРегЗадания); 	
	текРЗ.Расписание = Расписание;
	текРЗ.Записать();

КонецПроцедуры

&НаСервере
Функция ПолучитьРасписаниеЗадания(ИдентификаторРегЗадания)
	
	текРЗ = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторРегЗадания); 	
	Возврат текРЗ.Расписание; 	
	
КонецФункции 

&НаСервере
Функция ВключитьВыключитьРегламентноеЗадание(ИдентификаторРегЗадания, НовоеПоложениеИспользования = Неопределено)
	
	текРЗ = КонтурЛогистика_Привилегированный.РегламентныеЗаданияНайтиПоУникальномуИдентификатору(ИдентификаторРегЗадания); 	
	
	Если текРЗ = Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Регламентное задание с таким идентификатором уже недоступно";
		Сообщение.Сообщить();
		Возврат Ложь;
		
	Иначе
		
		Если Не КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
			И Не ЕстьРольНастройкаПодсистемы() Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Управление заданиями доступно только для администратора";
			Сообщение.Сообщить();
			Возврат текРЗ.Использование;
			
		Иначе
			
			Если НовоеПоложениеИспользования = Неопределено Тогда 
				НовоеПоложениеИспользования = не текРЗ.Использование;
			КонецЕсли;
			
			текРЗ.Использование = НовоеПоложениеИспользования;
			Если КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор() Тогда
				
				УстановитьПривилегированныйРежим(Истина);
				текРЗ.Записать();
				УстановитьПривилегированныйРежим(Ложь);
				
				Возврат текРЗ.Использование; 
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю;
				Если НовоеПоложениеИспользования Тогда 
					Сообщение.Текст = "Включить регламентное задание может только пользователь с полными правами Логистики или правами администратора учетной ситемы";
				Иначе
					Сообщение.Текст = "Выключить регламентное задание может только пользователь с полными правами Логистики или правами администратора учетной ситемы";
				КонецЕсли;
				Сообщение.Сообщить();
				
				Возврат Не НовоеПоложениеИспользования;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

