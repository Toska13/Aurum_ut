&НаКлиенте
Процедура ВыполнитьРЗ_ВФоне(Команда)
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
		Или ЕстьРольНастройкаПодсистемы() Тогда
		
		Для каждого ИдСтрокиРЗ Из Элементы.РегламентныеЗаданияПодсистемы.ВыделенныеСтроки Цикл
			
			ТекущаяСтрока = Объект.РегламентныеЗаданияПодсистемы.НайтиПоИдентификатору(ИдСтрокиРЗ);
			Если ТекущаяСтрока <> Неопределено Тогда
				ВыполнитьРегламентноеЗаданиеНаСервере(ТекущаяСтрока.Идентификатор);
			КонецЕсли;
			
		КонецЦикла;	
		
	Иначе
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Доступно только с ролью ""Настройка подсистемы"" или полными правами");
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРЗ_ВСеансе(Команда)
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
		Или ЕстьРольНастройкаПодсистемы() Тогда
		
		ТекущаяСтрока = Элементы.РегламентныеЗаданияПодсистемы.ТекущиеДанные;
		Если ТекущаяСтрока <> Неопределено Тогда
			ВыполнитьРегламентноеЗаданиеВручнуюНаСервере(ТекущаяСтрока.Идентификатор);
			Состояние("Завершено выполнение в этом сеансе.", , ТекущаяСтрока.Наименование);
		КонецЕсли;
		
	Иначе
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Доступно только с ролью ""Настройка подсистемы"" или полными правами");
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРегламентноеЗаданиеНаСервере(УникальныйИдентификатор)
	
	Идентификатор = Новый УникальныйИдентификатор(УникальныйИдентификатор);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
		
		//проверка на выполнение в текущий момент
		Отбор = Новый Структура;
		Отбор.Вставить("Ключ",Строка(Задание.УникальныйИдентификатор));
		Отбор.Вставить("Состояние ",СостояниеФоновогоЗадания.Активно);		
		МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		
		ИдентификаторНовогоЗадания = Неопределено;
		
		Если МассивЗаданий.Количество() = 0 Тогда 
			НаименованиеФоновогоЗадания = "Запуск вручную: " + Задание.Метаданные.Синоним;
			ФоновоеЗадание = ФоновыеЗадания.Выполнить(Задание.Метаданные.ИмяМетода, Задание.Параметры, Строка(Задание.УникальныйИдентификатор), НаименованиеФоновогоЗадания);
			ИдентификаторНовогоЗадания = ФоновоеЗадание.УникальныйИдентификатор;
		Иначе
			Сообщить("Задание уже запущено");
		КонецЕсли;
		
	ОбновитьРегламентныеНаСервере();
	ОбновитьФоновыеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРегламентноеЗаданиеВручнуюНаСервере(УникальныйИдентификатор)
	
	Идентификатор = Новый УникальныйИдентификатор(УникальныйИдентификатор);
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
	
	ИмяМетода = Задание.Метаданные.ИмяМетода;
	Если ИмяМетода = "ДополнительныеОтчетыИОбработки.ВыполнитьОбработкуПоРегламентномуЗаданию" Тогда
		Если Задание.Параметры.Количество() > 1 Тогда
			ВнешняяОбработка = Задание.Параметры.Получить(0);
			ИдентификаторКоманды = Задание.Параметры.Получить(1);
			Выполнить("ДополнительныеОтчетыИОбработки.ВыполнитьОбработкуПоРегламентномуЗаданию(ВнешняяОбработка, ИдентификаторКоманды)");
		КонецЕсли;
		Возврат;
	КонецЕсли;
		
	// Подготовка команды для выполнения метода вместо фонового задания.
	СтрокаПараметров = "";
	Индекс = 0;
	Пока Индекс < Задание.Параметры.Количество() Цикл
		СтрокаПараметров = СтрокаПараметров + "Задание.Параметры[" + Индекс + "]";
		Если Индекс < (Задание.Параметры.Количество()-1) Тогда
			СтрокаПараметров = СтрокаПараметров + ",";
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Выполнить("" + ИмяМетода + "(" + СтрокаПараметров + ");");

КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗаданияПодсистемыПользовательПриИзменении(Элемент)
	
	ТекДанные = Элементы.РегламентныеЗаданияПодсистемы.ТекущиеДанные;
	УстановитьПользователяРегламентногоЗадания(ТекДанные.Идентификатор, СокрЛП(ТекДанные.Пользователь));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПользователяРегламентногоЗадания(ИдентификаторРегЗадания, НовыйПользователь)
	
	ВведенныйПользователь = ПользователиИнформационнойБазы.НайтиПоИмени(НовыйПользователь);
	Если ВведенныйПользователь <> Неопределено Тогда 
		
		текРЗ = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторРегЗадания); 	
		Если текРЗ = Неопределено Тогда 
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Регламентное задание с таким идентификатором уже недоступно";
			Сообщение.Сообщить();
			
		Иначе
			
			текРЗ.ИмяПользователя = ВведенныйПользователь;
			текРЗ.Записать();
			
		КонецЕсли;
		
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Такой пользователь не найден: " + НовыйПользователь + " Пользователь в задание не установлено!";
		Сообщение.Поле = "РегламентныеЗаданияПодсистемыПользователь";
		Сообщение.Сообщить();                 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьФоновыеЗадания(Команда)
	
	Отказ = Истина;
	Попытка
		ОтменитьФоновыеЗаданияСервер();
	Исключение	
		ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьФоновыеЗаданияСервер()
	
	ВыделенныеСтроки = Элементы.ФоновыеЗаданияПодсистемы.ВыделенныеСтроки;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		СтрокаФЗ = Объект.ФоновыеЗаданияПодсистемы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		ТекИдентификатор = Новый УникальныйИдентификатор(СтрокаФЗ.Идентификатор);
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ТекИдентификатор);
		ФоновоеЗадание.Отменить();
		
	КонецЦикла;
	
	ОбновитьФоновыеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтфильтроватьФоновыеПоВыделенномуРегламентному(Команда)
	
	ТекущаяСтрока = Элементы.РегламентныеЗаданияПодсистемы.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Элементы.ФоновыеЗаданияПодсистемы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("РегламентноеЗадание", ТекущаяСтрока.ИмяМетаданных));
	Иначе
		Элементы.ФоновыеЗаданияПодсистемы.ОтборСтрок = Неопределено;
	КонецЕсли;
	
	Элементы.ФоновыеЗаданияПодсистемы.Обновить();
	ПрименитьОформлениеФильтраФЗ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОтборФоновых(Команда)
	
	Элементы.ФоновыеЗаданияПодсистемы.ОтборСтрок = Неопределено;
	Элементы.ФоновыеЗаданияПодсистемы.Обновить();
	ПрименитьОформлениеФильтраФЗ();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОформлениеФильтраФЗ()

	КнопкаОтмены = Элементы.ФоновыеЗаданияПодсистемыОтменитьОтборФоновых;
	
	КнопкаОтмены.Видимость = Элементы.ФоновыеЗаданияПодсистемы.ОтборСтрок <> Неопределено;
	Если КнопкаОтмены.Видимость Тогда 
		
		КнопкаОтмены.Заголовок = "Отменить отбор: " + Элементы.ФоновыеЗаданияПодсистемы.ОтборСтрок.РегламентноеЗадание;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФоновыеЗаданияПодсистемыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		
		Если Поле.Имя = "ФоновыеЗаданияПодсистемыСообщения" Тогда
			
			Текст = ФоновыеЗаданияПодсистемыСообщенияВыборНаСервере(Элемент.ТекущиеДанные.Идентификатор);
			Если Текст <> "" Тогда 
				КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(Текст);
			КонецЕсли;
			
		Иначе
			
			ОткрытьФормуФЗ();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФоновыеЗаданияПодсистемыСообщенияВыборНаСервере(ИдентификаторФЗ)
	
	Текст = "";
	
	Фоновое = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФЗ);
	
	Если Фоновое <> Неопределено Тогда
		
		СообщенияПользователю = Фоновое.ПолучитьСообщенияПользователю();
		Для Каждого Сообщение Из СообщенияПользователю Цикл;
			Текст = Текст + Символы.ПС + Сообщение.Текст;
		КонецЦикла;
		
		Текст = СокрЛП(Текст);
		
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции 

&НаКлиенте
Процедура ВыключитьВсеРегламентные(Команда)
	ВключитьВыключитьВсеРЗ(Ложь);	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьВсеРегламентные(Команда)
	ВключитьВыключитьВсеРЗ(Истина);	
КонецПроцедуры

&НаСервере
Процедура ВключитьВыключитьВсеРЗ(НовоеИспользование)

	Для каждого СтрокаРЗ Из Объект.РегламентныеЗаданияПодсистемы Цикл
	
	     ВключитьВыключитьРегламентноеЗадание(СтрокаРЗ.Идентификатор, НовоеИспользование);
		 
	КонецЦикла;

	ОбновитьРегламентныеНаСервере();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтображатьТолькоФоновыеКонтурЛогистикаПриИзменении(Элемент)
	ОбновитьФоновые();
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьТолькоАварииПриИзменении(Элемент)
	ОбновитьФоновые();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуФЗ(Команда = Неопределено)
	
	Если Элементы.ФоновыеЗаданияПодсистемы.ТекущиеДанные <> Неопределено Тогда 
		КонтурЛогистика_ДлительныеОперацииКлиент.СледитьЗаФоновымЗаданиемВФорме(Элементы.ФоновыеЗаданияПодсистемы.ТекущиеДанные.Идентификатор);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюДопИнфоРасширениеСервер()

	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение() Тогда
		
		Элементы.ДопИнфоРасширениеПодключитьОбработку.Видимость = Ложь;
		
		ТекстИнфо = "";
		Если НЕ КонтурЛогистика_РежимРасширенияСервер.ОбработкаЗапускаРегламентныхЗаданий_ЕстьМетаданные() Тогда
			ТекстИнфо = "Для работы регламентных заданий требуется механизм Дополнительных отчетов и обработок (из БСП)!"; 
			
		ИначеЕсли ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки") <> Истина Тогда
			ТекстИнфо = "Для работы регламентных заданий необходимо включить механизм дополнительных отчетов и обработок!";
			
		ИначеЕсли НЕ ЗначениеЗаполнено(КонтурЛогистика_РежимРасширенияСервер.ОбработкаЗапускаРегламентныхЗаданий_Ссылка()) Тогда
			ТекстИнфо = "Не подключена дополнительная обработка для регламентных заданий!";
			Элементы.ДопИнфоРасширениеПодключитьОбработку.Видимость = Истина;
			
		Иначе
			ТекстИнфо = "";
			
		КонецЕсли;
		
		Элементы.ДопИнфоРасширениеТекст.Заголовок = ТекстИнфо;
		Элементы.ДопИнфоРасширение.Видимость = ЗначениеЗаполнено(ТекстИнфо);
		
	Иначе
		
		Элементы.ДопИнфоРасширение.Видимость = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДопИнфоРасширениеПодключитьОбработкуНажатиеНаСервере()
	
	КонтурЛогистика_РежимРасширенияСервер.ОбработкаЗапускаРегламентныхЗаданий_Подключить();
	Объект.РегламентныеЗаданияПодсистемы.Очистить();
	ОбновитьРегламентныеНаСервере();
	УправлениеВидимостьюДопИнфоРасширениеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДопИнфоРасширениеПодключитьОбработкуНажатие(Элемент)
	
	ДопИнфоРасширениеПодключитьОбработкуНажатиеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПояснениеБлокировкаРаботыСВнешнимиРесурсамиОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Элементы.ГруппаБлокировкаРаботыСВнешнимиРесурсами.Видимость = Ложь;
	ПояснениеБлокировкаРаботыСВнешнимиРесурсамиОбработкаНавигационнойСсылкиНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПояснениеБлокировкаРаботыСВнешнимиРесурсамиОбработкаНавигационнойСсылкиНаСервере()
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные("Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами") Тогда
		Выполнить("РегламентныеЗаданияСервер.РазблокироватьРаботуСВнешнимиРесурсами()");
	Иначе
		Выполнить("КонтурЛогистика_БлокировкаРаботыСВнешнимиРесурсами.РазрешитьРаботуСВнешнимиРесурсами()");
	КонецЕсли;
КонецПроцедуры

