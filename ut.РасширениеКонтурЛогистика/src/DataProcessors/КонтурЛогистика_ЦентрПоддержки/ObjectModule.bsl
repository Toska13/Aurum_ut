/////////////////////////////////////////////////////////////////////////////// Сессия  


Функция СоздатьСессию() Экспорт
	
	Результат = Неопределено;	
	Запрос = _HttpЗапросСессия();
	
	Ответ = _Транспорт.ЦП_ОтправитьЗапрос(Запрос);
	
	Если _НегативноеСостояние(Ответ) Тогда
		ВызватьИсключение "Не удалось создать сессию: " + Ответ.КодСостояния + " "
			+ _ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело);
	КонецЕсли;
	
	Результат = ПолучитьЗначениеПоКлючу(_Json.ЦП_ПрочитатьJson(_ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело)), "id");
	Возврат Результат
	
КонецФункции


Функция _СформироватьПараметрыСессииДляЗапроса(ПараметрыСессии)
	
	Результат = Новый Соответствие;
	
	Для Каждого Элемент Из ПараметрыСессии Цикл
		
		Если НЕ ЗначениеЗаполнено(Элемент.Значение) Тогда
			
			Продолжить;
			
		ИначеЕсли Элемент.Ключ = "ДополнительныеПараметры" Тогда
			
			ПараметрыПродукта = _СформироватьДополнительныеПараметры(Элемент.Значение, _ТопикПродукта);
			_ОбъединитьСтруктуры(Результат, ПараметрыПродукта);
			
		ИначеЕсли Элемент.Ключ = "Файлы" Тогда
			
			Попытка
				Ссылка = _ЗагрузитьФайлыПолучитьСсылку(Элемент.Значение, _ТопикПродукта);
				Результат.Вставить("scope/csi/attachment", Ссылка);
			Исключение
				ЗаписьЖурналаРегистрацииНаСервере(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
			КонецПопытки;
						
		Иначе
			
			Значение = Элемент.Значение;
			Если ТипЗнч(Элемент.Значение) = Тип("Число") Тогда
				
				Значение = СтрЗаменить(Элемент.Значение, Символы.НПП, "");
				
			КонецЕсли;
			
			Результат.Вставить(_ИмяПараметраСервиса(Элемент.Ключ), Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


Функция _ИмяПараметраСервиса(Ключ)
	
	Если Ключ = "ИНН" Тогда
		Результат = "base/inn";
	ИначеЕсли Ключ = "КПП" Тогда
		Результат = "base/kpp";
	ИначеЕсли Ключ = "Организация" Тогда
		Результат = "base/orgname";
	ИначеЕсли Ключ = "Логин" Тогда
		Результат = "base/login";
	ИначеЕсли Ключ = "Телефон" Тогда
		Результат = "base/contactPhone";    
	ИначеЕсли Ключ = "ИмяПользователя" Тогда
		Результат = "base/realname";
	Иначе
		Результат = Ключ; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////////////////////// СистемнаяИнформация


Функция _ИнитСистемнаяИнформация() 
	
	Результат = Новый Структура;
	СисИнфо = "";
	КонфИнфо = "";
	СистемнаяИнформация = _СистемнаяИнформация();
	
	СвойстваСистемы = Новый Массив;
	СвойстваСистемы.Добавить("client_platform");
	СвойстваСистемы.Добавить("client_type");
	СвойстваСистемы.Добавить("client_version");
	
	СвойстваКонфигурации = Новый Массив;
	СвойстваКонфигурации.Добавить("configuration_version");
	СвойстваКонфигурации.Добавить("configuration_compmode");
	
	Для Каждого Свойство Из СвойстваСистемы Цикл
		Если _СвойствоОпределено(СистемнаяИнформация, Свойство) Тогда
			СисИнфо = СисИнфо + " " + Свойство + ": " + СистемнаяИнформация[Свойство] + ", ";	
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого Свойство Из СвойстваКонфигурации Цикл
		Если _СвойствоОпределено(СистемнаяИнформация, Свойство) Тогда
			КонфИнфо = КонфИнфо + " " + Свойство + ": " + СистемнаяИнформация[Свойство] + ", ";	
		КонецЕсли;	
	КонецЦикла;
	
	Результат.Вставить("system_info", СисИнфо);
	Результат.Вставить("conf_info", КонфИнфо);
	Результат.Вставить("configuration_name", СистемнаяИнформация["configuration_name"]);
	
	Возврат Результат;
	
КонецФункции


Функция _СистемнаяИнформация() 
	
	Возврат _ОбъединитьСтруктуры(_СистемнаяИнформацияНаКлиенте(), _СистемнаяИнформацияНаСервере());
	
КонецФункции


Функция _СистемнаяИнформацияНаКлиенте() 
	
	КонтекстДанные = Новый Структура;
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	// Клиент
	
	Информация = Новый Структура;
	Информация.Вставить("client_id"		 , Строка(СистемнаяИнформация.ИдентификаторКлиента));
	Информация.Вставить("client_name"	 , ИмяКомпьютера());
	Информация.Вставить("client_type"	 , _ТипКлиента());
	Информация.Вставить("client_platform", Строка(СистемнаяИнформация.ТипПлатформы));
	Информация.Вставить("client_version" , Строка(СистемнаяИнформация.ВерсияПриложения));
	Информация.Вставить("client_cntmode" , _РежимСоединения());
		
	Возврат Информация; 
	
КонецФункции


Функция _ТипКлиента()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Результат = "ordinary";		
	#ИначеЕсли ТолстыйКлиентУправляемоеПриложение Тогда
		Результат = "thick";	
	#ИначеЕсли ТонкийКлиент Тогда
		Результат = "thin";
	#ИначеЕсли ВебКлиент Тогда
		Результат = "web";
	#ИначеЕсли МобильныйКлиент ИЛИ МобильноеПриложениеКлиент Тогда
		Результат = "mobClient";	
	#Иначе
		Возврат Неопределено;	
	#КонецЕсли
	
	Если Найти(Строка(СистемнаяИнформация.ТипПлатформы), "64") Тогда
		Результат = Результат + "64";	
	Иначе
		Результат = Результат + "32";	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция _РежимСоединения()
	
	СтрокаСоединения = НРег(СтрокаСоединенияИнформационнойБазы());
	
	Разделитель = Найти(СтрокаСоединения, "=");
	Если Разделитель <> 0 Тогда
		Режим = Лев(СтрокаСоединения, Разделитель - 1);
	Иначе
		Режим = Неопределено;
	КонецЕсли;
	
	Возврат Режим;
	
КонецФункции


Функция _СистемнаяИнформацияНаСервере() 

	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Информация = Новый Структура;
	Информация.Вставить("configuration_version" , Строка(Метаданные.Версия));
	Информация.Вставить("configuration_compmode", Строка(Метаданные.РежимСовместимости));
	Информация.Вставить("configuration_name"	, Строка(Метаданные.Имя));
	Информация.Вставить("configuration_version" , Строка(Метаданные.Версия));	
	Информация.Вставить("configuration_changed" , КонфигурацияИзменена());
	
	Информация.Вставить("server_platform", Строка(СистемнаяИнформация.ТипПлатформы));
	Информация.Вставить("server_name"	 , ИмяКомпьютера());
	
	Информация.Вставить("session_locale", _ТекущийКодЛокализации());
	Информация.Вставить("session_tz"	, ЧасовойПоясСеанса());
	Информация.Вставить("session_id"	, _ИдентификаторСеанса());
	
	Возврат Информация; 
	
КонецФункции


Функция _ТекущийКодЛокализации() 

	КодЛокализации = ТекущийКодЛокализации();
	Если Найти(КодЛокализации, "_") = 0 Тогда
		КодЛокализации = НРег(КодЛокализации) + "_" + ВРег(КодЛокализации);	
	КонецЕсли;
	
	Возврат КодЛокализации; 
	
КонецФункции


Функция _ИдентификаторСеанса() 

	Адрес = НРег(ПоместитьВоВременноеХранилище(Неопределено));	
	Разделитель = НРег("seanceId=");
	Позиция = Найти(Адрес, Разделитель);
	Длина = 36;
	
	Если Разделитель <> 0 Тогда
		Идентификатор = Сред(Адрес, Позиция + СтрДлина(Разделитель), Длина);
	Иначе
		Идентификатор = Неопределено;
	КонецЕсли;
	
	Возврат Идентификатор; 
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////////////////////// HTTP


Функция _ОтправитьЗапрос(Запрос) Экспорт
	
	Результат = _РезультатЗапросаКлиентСервер();
	Соединение = _НовыйЗащищенноеСоединение(Запрос.Хост);	
	HttpЗапрос = _НовыйHTTPЗапрос(Запрос);
	
	Ответ = Соединение.ВызватьHTTPМетод(Запрос.Метод, HttpЗапрос);	
	
	Результат.КодСостояния = Ответ.КодСостояния;
	Результат.Тело = Ответ.ПолучитьТелоКакДвоичныеДанные();
	
	Возврат Результат;
	
КонецФункции


Функция _НовыйЗащищенноеСоединение(Сервер)
	
	ЗащищенноеСоединение = Новый("ЗащищенноеСоединениеOpenSSL");
	Таймаут = 30;
	Соединение = Новый HTTPСоединение(Сервер,,,,, Таймаут, ЗащищенноеСоединение);
	
	Возврат Соединение;
	
КонецФункции


Функция _НовыйHTTPЗапрос(Запрос)
	
	Результат = Новый HTTPЗапрос(Запрос.Ресурс, Запрос.Заголовки);
	
	Если ТипЗнч(Запрос.Тело) = Тип("ДвоичныеДанные") Тогда
		Результат.УстановитьТелоИзДвоичныхДанных(Запрос.Тело);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция _Запрос()
	
	Результат = Новый Структура;
	Результат.Вставить("Хост");
	Результат.Вставить("Ресурс");
	Результат.Вставить("Тело");
	Результат.Вставить("Метод");
	Результат.Вставить("Заголовки");
	
	Возврат Результат;
	
КонецФункции


Функция _НегативноеСостояние(HTTPОтвет) Экспорт

	КодПеренаправление = 300;	
	Возврат HTTPОтвет.КодСостояния >= КодПеренаправление;

КонецФункции


Функция _РезультатЗапросаКлиентСервер() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния");
	Результат.Вставить("Тело");
	
	Возврат Результат;
	
КонецФункции

