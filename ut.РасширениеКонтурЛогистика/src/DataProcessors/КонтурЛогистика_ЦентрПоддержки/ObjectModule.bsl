/////////////////////////////////////////////////////////////////////////////// Интерфейс
  

Процедура Инит(ТопикПродукта = "", 
		Транспорт = Неопределено, 
		Json = Неопределено,
		ТестовоеОкружение = Ложь) Экспорт
	
	Если Транспорт = Неопределено Тогда 
		_Транспорт = ЭтотОбъект;
	Иначе
		_Транспорт = Транспорт;
	КонецЕсли;
	
	Если Json = Неопределено Тогда 
		_Json = ЭтотОбъект;
	Иначе
		_Json = Json;
	КонецЕсли;
	
	_ТестовоеОкружение = ТестовоеОкружение;
	_ТопикПродукта = ТопикПродукта;
	
КонецПроцедуры

// Метод открывает Центр поддержки в браузере
//
// Параметры:
//	ПараметрыСессии - Структура - Контракт из метода "МодельПараметрыСессии"
//
// Возвращаемое значение:
//	- СессияId - Строка
//

Функция ОткрытьЦентрПоддержки(ПараметрыСессии = Неопределено) Экспорт
	
	Ресурс = "";
	
	Попытка
		СессияId = СоздатьСессию(); 
	Исключение
		_ОповеститьПользователя("Ошибка создания сессии", ОписаниеОшибки());
	КонецПопытки; 
	
	Если СессияId <> Неопределено Тогда 
		Попытка
			УстановитьСостояние(СессияId, ПараметрыСессии);
		Исключение
			_ОповеститьПользователя("Ошибка установки параметров Центра поддержки", ОписаниеОшибки());
		КонецПопытки;
		Ресурс = Ресурс + "#" + _ТопикПродукта + "?mpass_session_id=" + СессияId; 
	КонецЕсли;
	
	ЗапуститьПриложение("https://" + _Настройки().Транспорт.ЦП + Ресурс);
	
	Возврат СессияId;
	
КонецФункции

// Передача параметров в Центр поддержки
//
// Параметры:
//	СессияId 		- Строка - id сессия для установки параметров
//	ПараметрыСессии - Структура - Описан в методе "ОткрытьЦентрПоддержки"
//

Процедура УстановитьСостояние(СессияId, ПараметрыСессии) Экспорт
	
	Если ТипЗнч(ПараметрыСессии) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = _HttpЗапросУстановкаСостояния(СессияId, ПараметрыСессии);
	Ответ = _Транспорт.ЦП_ОтправитьЗапрос(Запрос);
	
	Если _НегативноеСостояние(Ответ) Тогда
		ВызватьИсключение "Не удалось установить параметры Центра поддержки, код: " + Ответ.КодСостояния + " " 
			+ _ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело);
	КонецЕсли;
	
КонецПроцедуры

// Описывает модель параметров для передачи в Центр поддержки
//
// Возвращаемое значение:
// - Результат - Структура - Контракт модели

Функция МодельПараметрыСессии() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДополнительныеПараметры", Новый Соответствие);
	Результат.Вставить("ИНН");
	Результат.Вставить("КПП");
	Результат.Вставить("Организация");
	Результат.Вставить("Логин");
	Результат.Вставить("Телефон");    
	Результат.Вставить("ИмяПользователя");
	Результат.Вставить("Файлы", Новый Массив);
	
	Возврат Результат;
	
КонецФункции


Функция МодельФайла() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла");
	Результат.Вставить("Данные");
	
	Возврат Результат;
	
КонецФункции


Функция РезультатЗапроса() Экспорт
	
	Возврат _РезультатЗапросаКлиентСервер();
	
КонецФункции

