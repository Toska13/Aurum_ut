
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПеречитатьНастройки();
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНастройки()
	
	НастройкаПутьДоФайла = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного("ПодключаемыйМодульПуть");
	НастройкаПутьДоФайлаЗначение = НастройкаПутьДоФайла.Значение;
	
	НастройкаТипПМ = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного("ПодключаемыйМодульТип");
	НастройкаТипПМЗначение = НастройкаТипПМ.Значение;

	СведенияОбОбработке = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("СведенияОВнешнейОбработке");	
	ЗаголовокВерсии  = " не подключен";
	Если СведенияОбОбработке <> Неопределено Тогда
		Попытка
			ЗаголовокВерсии = " подключен v " + СведенияОбОбработке.Версия;
		Исключение
			ЗаголовокВерсии = " не удалось подключить";
		КонецПопытки;
	КонецЕсли;
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Этаформа.Заголовок = ОбъектОбработки.Метаданные().Синоним + ":" + ЗаголовокВерсии;
КонецПроцедуры

&НаКлиенте
Процедура СброситьКэш(Команда)
	ОбновитьПовторноИспользуемыеЗначения();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	ОбновитьОтображениеДанных();
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеПараметровПМ" Тогда 
		
		ПеречитатьНастройки();
		ОбновитьОтображениеДанных();
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СохранитьПМВФайл(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"СохранитьПМВФайлОбработатьВыборКаталога", 
		ЭтаФорма, 
		РежимДиалогаВыбораФайла.ВыборКаталога, 
		"Выберите каталог куда сохранить Подключаемый модуль");
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПМВФайлОбработатьВыборКаталога(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		ИмяКаталога = Результат[0];
		ИмяФайла = ИмяКаталога + ПолучитьРазделительПути() + "КонтурЛогистика_ПодключаемыйМодуль.epf";
		
		Попытка
		
			ЗаписатьПМНаДиск(ИмяФайла);
			ЗапуститьПриложение(ИмяКаталога);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
				"Подключить сохраненный ПМ как файл?",
				РежимДиалогаВопрос.ДаНет,
				"Сразу подключим?",
				, 
				ЭтаФорма,
				"ПодключитьКакФайлОбработатьОтвет",
				ИмяФайла);
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКакФайлОбработатьОтвет(ПодключитьКакФайл, ИмяФайла) Экспорт
	
	Если ПодключитьКакФайл = КодВозвратаДиалога.Да Тогда 
		
		ПодключитьКакФайлСервер(ИмяФайла);
		ПеречитатьНастройки();
		ОбновитьОтображениеДанных();

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодключитьКакФайлСервер(ИмяФайла)

	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ПодключаемыйМодульТип", Перечисления.КонтурЛогистика_ТипыПМ.ФайлНаДиске);		
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ПодключаемыйМодульПуть",	ИмяФайла);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПМНаДиск(ПутьКФайлу)
	
	Обработки.КонтурЛогистика_ПодключаемыйМодуль.ПолучитьМакет("ШаблонПодключаемогоМодуля").Записать(ПутьКФайлу);

КонецПроцедуры


