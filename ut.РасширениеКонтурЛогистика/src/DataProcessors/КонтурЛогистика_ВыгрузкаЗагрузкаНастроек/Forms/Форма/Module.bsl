
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Инициализация();
	УправлениеВидимостьюДоступностью(ЭтаФорма);	
	ПриИзмененииРежимаРаботы(ЭтаФорма);
	
	ПодсказкиСкрыты = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	УправлениеВидимостьюДоступностью(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьТекущуюСтроку("НастройкиВыгрузки");
	УстановитьТекущуюСтроку("ОбъектыДляВыгрузки");
	
	УстановитьОтборСтрок();	
	ИзменитьЗаголовкиКолонок();
	УстановитьТекстВыбраноОбъектов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбработатьНачалоВыбораФайла(СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	РежимВыгрузки = ТекущаяСтраница = Элементы.Страницы.ПодчиненныеЭлементы.СтраницаВыгрузка;
	
	УстановитьКнопкиПоУмолчанию();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиВыгрузки

&НаКлиенте
Процедура НастройкиВыгрузкиПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрок();	
	ИзменитьЗаголовкиКолонок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектыДляВыгрузки

&НаКлиенте
Процедура ОбъектыДляВыгрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбСтрока = ОбъектыДляВыгрузки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ОбъектыДляВыгрузкиНаименование" И ЗначениеЗаполнено(ВыбСтрока.Ссылка) Тогда 
		
		ИмяФормыНастроек = "Справочник." + ВыбСтрока.ИмяОбъектаМетаданных + ".ФормаОбъекта";
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяФормыНастроек, 
			Новый Структура("Ключ", ВыбСтрока.Ссылка),
			ЭтаФорма,,,, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Поле.Имя = "ОбъектыДляВыгрузкиТребуемоеДействие" Тогда
		
		СтандартнаяОбработка = Истина;
						
		Если Не ВыбСтрока.Выгружать Или ВыбСтрока.ТребуемоеДействие = "Настроено" Тогда 
			Возврат
		КонецЕсли;
		
		Отбор = Новый Структура("ИмяОбъектаМетаданных, Наименование", ВыбСтрока.ИмяОбъектаМетаданных, ВыбСтрока.Наименование);
		нСтроки = НайденныеЗначенияВыгрузки.НайтиСтроки(Отбор);
		
		Если нСтроки.Количество() Тогда 
			
			ОбъектыВыбора = Новый СписокЗначений;
			
			Для Каждого нСтрока Из нСтроки Цикл 
				ОбъектыВыбора.Добавить(нСтрока.Ссылка);	
			КонецЦикла;	
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Обработка.КонтурЛогистика_ВыгрузкаЗагрузкаНастроек.Форма.ФормаВыборОбъекта", 
				Новый Структура("ОбъектыВыбора", ОбъектыВыбора), 
				ЭтаФорма,
				ЭтаФорма,
				"ОбработчикВыбораОбъекта",
				Новый Структура("ВыбСтрока", ВыбСтрока),,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыгрузитьДанные(Команда)
	
	ОчиститьСообщения();
	
	Если Не РежимРаботыНаКлиенте Тогда
		
		Если ПустаяСтрока(ИмяФайлаВыгрузки) Тогда
			
			ТекстСообщения = Нстр("Поле ""Имя файла"" не заполнено");
			СообщитьПользователю(ТекстСообщения, "ИмяФайлаВыгрузки");			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Состояние("Выполняется выгрузка данных. Пожалуйста, подождите...");
	
	АдресФайлаВоВременномХранилище = "";
	ВыгрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище);
	
	Если РежимРаботыНаКлиенте И Не ПустаяСтрока(АдресФайлаВоВременномХранилище) Тогда
		
		ИмяФайла = "Файл выгрузки.xml";
		ПолучитьФайл(АдресФайлаВоВременномХранилище, ИмяФайла);
		
	КонецЕсли;
	
	УстановитьТекстВыбраноОбъектов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	РежимЧтения = Ложь;
	ЗагрузитьДанныеНаКлиенте();
	
	УстановитьКнопкиПоУмолчанию();

	НастройкиЗагрузки.Очистить();
	ОбъектыДляЗагрузки.Очистить();
	НайденныеЗначения.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьДанные(Команда)
	
	ИмяФайлаЗагрузки = "";
	
	РежимЧтения = Истина;
	ЗагрузитьДанныеНаКлиенте();
	
	УстановитьТекстВыбраноОбъектовЗагрузки();
	
	УстановитьКнопкиПоУмолчанию();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура Инициализация()
		
	// Заполняем данные для выгрузки из предопределенного массива
	ЗаполнитьДанныеДляВыгрузкиЗагрузки();
	
	// Заполняем объекты для выгрузки
	ЗаполнитьОбъектыДляВыгрузки();
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюДоступностью(Форма)

	Элементы = Форма.Элементы;
	
	Форма.РежимВыгрузки = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаВыгрузка);

	ПоказатьСкрытьПодсказки(Форма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДляВыгрузкиЗагрузки()

	НастройкиВыгрузки.Очистить();
	НастройкиЗагрузки.Очистить();
	
	Для Каждого Строка Из МассивВыгружаемыхСправочников() Цикл 
		
		НоваяСтрока = НастройкиВыгрузки.Добавить();
		НоваяСтрока.ИмяОбъектаМетаданных = Строка;
		НоваяСтрока.ПредставлениеОбъектаМетаданных = Метаданные.Справочники[Строка].Синоним;
		
		//НоваяСтрока = НастройкиЗагрузки.Добавить();
		//НоваяСтрока.ИмяОбъектаМетаданных = Строка;
		//НоваяСтрока.ПредставлениеОбъектаМетаданных = Метаданные.Справочники[Строка].Синоним;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыДляВыгрузки()
	
	МассивСправочниковКВыгрузке = МассивВыгружаемыхСправочников();
	
	ТекстЗапроса = "";
	
	Для Сч = 0 По МассивСправочниковКВыгрузке.Количество() - 1 Цикл
		
		ИмяМетаданных = МассивСправочниковКВыгрузке[Сч];
		
		ТекстПодзапроса =  
		"ВЫБРАТЬ
		|	ЛОЖЬ КАК Выгружать,
		|	КонтурЛогистика_Настройки.Ссылка КАК Ссылка,
		|	КонтурЛогистика_Настройки.Наименование КАК Наименование,
		|	""" + ИмяМетаданных + """ КАК ИмяОбъектаМетаданных,
		|	""" + Метаданные.Справочники[ИмяМетаданных].Синоним + """ КАК ПредставлениеОбъектаМетаданных,
		|	КонтурЛогистика_Настройки.Описание КАК ОписаниеНастроек
		|ИЗ
		|	Справочник." + ИмяМетаданных + " КАК КонтурЛогистика_Настройки
		|ГДЕ
		|	НЕ КонтурЛогистика_Настройки.ПометкаУдаления
		|	И НЕ КонтурЛогистика_Настройки.ЭтоГруппа";	
		
		МетаданныеОбъекта = Метаданные.Справочники[ИмяМетаданных];
		
		Если Не КонтурЛогистика_ОбщегоНазначенияСервер.ЕстьРеквизитОбъекта_("Описание", МетаданныеОбъекта) Тогда 
			
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, "КонтурЛогистика_Настройки.Описание", """""");
			
		КонецЕсли;
		
		Если Не КонтурЛогистика_ОбщегоНазначенияСервер.ЕстьРеквизитОбъекта_("ЭтоГруппа", МетаданныеОбъекта, Истина) Тогда 
			
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, "И НЕ КонтурЛогистика_Настройки.ЭтоГруппа", "");
			
		КонецЕсли;	
		
		Если Не Сч = 0 Тогда 
			
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, " КАК Выгружать", "");
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, " КАК Наименование", "");
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, " КАК Ссылка", "");
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, " КАК ИмяОбъектаМетаданных", "");
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, " КАК ПредставлениеОбъектаМетаданных", "");
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, " КАК ОписаниеНастроек", "");	
			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ТекстПодзапроса;
		
		Если Не Сч = МассивСправочниковКВыгрузке.Количество() - 1 Тогда 
			
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
		Таблица = Запрос.Выполнить().Выгрузить();
		
		ТаблицаНаименований = Таблица.Скопировать(, "Наименование, ИмяОбъектаМетаданных");
		ТаблицаНаименований.Свернуть("Наименование, ИмяОбъектаМетаданных");
		
		Для Каждого Строка Из ТаблицаНаименований Цикл 
			
			нСтроки = Таблица.НайтиСтроки(Новый Структура("Наименование, ИмяОбъектаМетаданных", Строка.Наименование, Строка.ИмяОбъектаМетаданных));
			
			ОбъектВыгрузки = ОбъектыДляВыгрузки.Добавить();
			ЗаполнитьЗначенияСвойств(ОбъектВыгрузки, нСтроки[0]);
			ОбъектВыгрузки.ТребуемоеДействие = "Настроено";
			
			Если нСтроки.Количество() > 1 Тогда 
				
				Для Каждого НайденнаяСтрока Из нСтроки Цикл 				
					ЗаполнитьЗначенияСвойств(НайденныеЗначенияВыгрузки.Добавить(), НайденнаяСтрока);			
				КонецЦикла;
				
				ОбъектВыгрузки.Ссылка = Неопределено;
				ОбъектВыгрузки.НесколькоОбъктовВыгрузки = Истина;
				ОбъектВыгрузки.ТребуемоеДействие = "Выбрать объект (найдено - " + нСтроки.Количество() + ")";
				
			КонецЕсли;
			
		КонецЦикла;
				
		ОбъектыДляВыгрузки.Сортировать("Наименование");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МассивВыгружаемыхСправочников()
	
	Массив = Новый Массив;
	
	Массив.Добавить("КонтурЛогистика_Настройки");
	Массив.Добавить("КонтурЛогистика_НастройкиКонвертацииДокументов");
	Массив.Добавить("КонтурЛогистика_НастройкиКонвертацииСправочников");
	
	Возврат Массив;

КонецФункции

&НаКлиенте
Процедура УстановитьТекущуюСтроку(ИмяТаблицы)
	
	Если ЭтаФорма[ИмяТаблицы].Количество() Тогда 
	
		ТекСтрока = ЭтаФорма[ИмяТаблицы][0];
		
		Элементы[ИмяТаблицы].ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрок()

	ТекДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
			
	Элементы.ОбъектыДляВыгрузки.ОтборСтрок = ?(ТекДанные = Неопределено, 
		Неопределено, 
		Новый ФиксированнаяСтруктура("ПредставлениеОбъектаМетаданных", ТекДанные.ПредставлениеОбъектаМетаданных));
		
	ТекДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;	
	
	Элементы.ОбъектыДляЗагрузки.ОтборСтрок = ?(ТекДанные = Неопределено, 
		Неопределено, 
		Новый ФиксированнаяСтруктура("ПредставлениеОбъектаМетаданных, ЭтоГруппа", ТекДанные.ПредставлениеОбъектаМетаданных, Ложь));
			
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище)
		
	Массив = Новый Массив;
	
	Для Каждого Строка Из НастройкиВыгрузки Цикл 
		
		Если Строка.ТребуютДействия > 0 Тогда 
			
			ВызватьИсключение "Перед выгрузкой файла требуется выполнить все требуемые действия";
			
		КонецЕсли;	
		
		Если Строка.Выгружать Тогда 
			
			Массив.Добавить(Строка.ИмяОбъектаМетаданных);
			
		КонецЕсли;
	
	КонецЦикла;	
	
	Если РежимРаботыНаКлиенте Тогда
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xml");
		
	Иначе
		
		ИмяВременногоФайла = ИмяФайлаВыгрузки;
		
	КонецЕсли;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");	
	ОбъектНаСервере.ВыполнитьВыгрузку(ИмяВременногоФайла, Массив, ОбъектыДляВыгрузки);
	
	Если РежимРаботыНаКлиенте Тогда
		
		Файл = Новый Файл(ИмяВременногоФайла);
		
		Если Файл.Существует() Тогда
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
			УдалитьФайлы(ИмяВременногоФайла);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНачалоВыбораФайла(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	РежимДиалога = ?(РежимВыгрузки, РежимДиалогаВыбораФайла.Сохранение, РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалога);
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Не РежимВыгрузки;
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Заголовок = Нстр("ru = 'Задайте имя файла выгрузки'");
	ДиалогВыбораФайла.ПолноеИмяФайла = ?(РежимВыгрузки, ИмяФайлаВыгрузки, ИмяФайлаЗагрузки);
	
	ДиалогВыбораФайла.Фильтр = "Формат выгрузки(*.xml)|*.xml|FastInfoSet (*.fi)|*.fi|Все файлы (*.*)|*.*";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		Если РежимВыгрузки Тогда
			ИмяФайлаВыгрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		Иначе
			ИмяФайлаЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище, Расширение)
			
	Если РежимРаботыНаКлиенте Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		
	Иначе
		
		ИмяВременногоФайла = ИмяФайлаЗагрузки;
		
	КонецЕсли;
			
	ОбъектыДляЗагрузкиНаСервере = РеквизитФормыВЗначение("ОбъектыДляЗагрузки", Тип("ТаблицаЗначений"));	
	НайденныеЗначенияНаСервере = РеквизитФормыВЗначение("НайденныеЗначения", Тип("ТаблицаЗначений"));
	ДеревоИерархииНастроекНаСервере = РеквизитФормыВЗначение("ДеревоИерархииНастроек", Тип("ДеревоЗначений"));
	
	Для Каждого Строка Из ОбъектыДляЗагрузкиНаСервере Цикл 
		
		Если Строка.Загружать И Не Строка.ТребуемоеДействие = "Настроено" Тогда 
			
			ВызватьИсключение "Перед загрузкой данных требуется выполнить все требуемые действия";
			
		КонецЕсли;	
			
	КонецЦикла;
	
	РеквизитФормыВЗначение("Объект").ВыполнитьЗагрузку(ИмяВременногоФайла, ОбъектыДляЗагрузкиНаСервере, НайденныеЗначенияНаСервере, ДеревоИерархииНастроекНаСервере, РежимЧтения);
	
	Если РежимРаботыНаКлиенте Тогда
		
		Файл = Новый Файл(ИмяВременногоФайла);
		
		Если Файл.Существует() Тогда
			
			УдалитьФайлы(ИмяВременногоФайла);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РежимЧтения Тогда 
		
		ЗначениеВРеквизитФормы(ОбъектыДляЗагрузкиНаСервере, "ОбъектыДляЗагрузки");
		ЗначениеВРеквизитФормы(НайденныеЗначенияНаСервере, "НайденныеЗначения");
		ЗначениеВРеквизитФормы(ДеревоИерархииНастроекНаСервере, "ДеревоИерархииНастроек");
		
		МассивИменОбъектов = Новый Массив;
		МассивВыгружаемыхСправочников = МассивВыгружаемыхСправочников();
		
		НастройкиЗагрузки.Очистить();
		
		Для Каждого ОбъектЗагрузки Из ОбъектыДляЗагрузки Цикл 
									
			ОбъектЗагрузки.ТребуемоеДействие = "Настроено";
			
			ИмяОбъектаМетаданных 			= ОбъектЗагрузки.ИмяОбъектаМетаданных;
			ПредставлениеОбъектаМетаданных 	= ОбъектЗагрузки.ПредставлениеОбъектаМетаданных;
			
			Отбор = Новый Структура("ИмяОбъектаМетаданных, Наименование", ИмяОбъектаМетаданных, ОбъектЗагрузки.Наименование);
			НайденныеСтроки = НайденныеЗначения.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() = 1 Или (НайденныеСтроки.Количество() > 1 И ОбъектЗагрузки.ЭтоГруппа) Тогда 
				
				ОбъектЗагрузки.ЗначениеОбъекта = НайденныеСтроки[0].Значение;
				
				ОбъектМедатанных = ОбъектЗагрузки.ЗначениеОбъекта.Метаданные();
				
				ИмяОбъектаМетаданных 			= ОбъектМедатанных.Имя;
				ПредставлениеОбъектаМетаданных 	= ОбъектМедатанных.Синоним;
				
			ИначеЕсли НайденныеСтроки.Количество() > 1 Тогда	
				
				ОбъектЗагрузки.НайденоНесколькоЗначений = Истина;
				ОбъектЗагрузки.ТребуемоеДействие = "Выбрать объект (найдено - " + НайденныеСтроки.Количество() + ")";
				
				ОбъектМедатанных = НайденныеСтроки[0].Значение.Метаданные();
				
				ИмяОбъектаМетаданных 			= ОбъектМедатанных.Имя;
				ПредставлениеОбъектаМетаданных 	= ОбъектМедатанных.Синоним;
				
			КонецЕсли;	
			
			Если МассивИменОбъектов.Найти(ИмяОбъектаМетаданных) = Неопределено Тогда 
				
				НоваяСтрока = НастройкиЗагрузки.Добавить();
				
				НоваяСтрока.ИмяОбъектаМетаданных 			= ИмяОбъектаМетаданных;
				НоваяСтрока.ПредставлениеОбъектаМетаданных 	= ПредставлениеОбъектаМетаданных;
				
				НоваяСтрока.ЭтоДопОбъект = Число(ОбъектЗагрузки.ЭтоДопОбъект);
				
				МассивИменОбъектов.Добавить(ИмяОбъектаМетаданных);
				
			КонецЕсли;
			
		КонецЦикла;	
		
		НастройкиЗагрузки.Сортировать("ЭтоДопОбъект, ИмяОбъектаМетаданных");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеНаКлиенте()
	
	ОчиститьСообщения();
	АдресФайлаВоВременномХранилище = "";
	
	Если РежимРаботыНаКлиенте Тогда
		
		Если Не ЗначениеЗаполнено(ИмяФайлаЗагрузки) Тогда 
			
			Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
			Диалог.Фильтр = "Файл XML (*.xml)|*.xml"; 
			Диалог.Заголовок = "Выберите файл";
			Диалог.ПредварительныйПросмотр = Истина;
			Диалог.ИндексФильтра = 0;
			Диалог.МножественныйВыбор = Ложь;
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьФайлЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог));
			
			Диалог.Показать(ОписаниеОповещения);
			
		Иначе
			
			АдресВХ = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаЗагрузки));
			ЗагрузитьДанныеЗавершение(Истина, АдресВХ, ИмяФайлаЗагрузки, Неопределено);
			
		КонецЕсли;
		
	Иначе 	
		
		Если ПустаяСтрока(ИмяФайлаЗагрузки) Тогда
			
			ТекстСообщения = "Поле ""Имя файла"" не заполнено";
			СообщитьПользователю(ТекстСообщения, "ИмяФайлаЗагрузки");
			Возврат;
			
		КонецЕсли;
		
		Файл = Новый Файл(ИмяФайлаЗагрузки);
		Если Не Файл.Существует() Тогда
			
			ТекстСообщения = "Файл не существует";
			СообщитьПользователю(ТекстСообщения, "ИмяФайлаЗагрузки");
			Возврат;
			
		КонецЕсли;
		
		ЗагрузитьДанныеЗавершение(Истина, АдресФайлаВоВременномХранилище, ИмяФайлаЗагрузки, Неопределено);
				
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗагрузитьФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог; 
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда				
		
		ИмяФайлаЗагрузки = Диалог.ПолноеИмяФайла;
		АдресВХ = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаЗагрузки));
		
		ЗагрузитьДанныеЗавершение(Истина, АдресВХ, ИмяФайлаЗагрузки, Неопределено);   
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		
		Состояние("Выполняется загрузка данных. Пожалуйста, подождите...");
		
		Файл = Новый Файл(ВыбранноеИмяФайла);
		Если Не Файл.Существует() Тогда
			
			ТекстСообщения = "Указанный файл не существует";
			ПутьКДанным = ?(РежимРаботыНаКлиенте, "", "ИмяФайлаЗагрузки");
			СообщитьПользователю(ТекстСообщения, ПутьКДанным);
			Возврат;
			
		КонецЕсли;
		
		ЗагрузитьДанныеНаСервере(Адрес, Файл.Расширение);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиВыгрузкиВыгружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;	
	
	УстановитьОтметки(ТекДанные.Выгружать, ТекДанные.ИмяОбъектаМетаданных);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметки(Отметка, ИмяОбъектаМетаданных)

	Для Каждого Строка Из ОбъектыДляВыгрузки Цикл 
		
		Если Строка.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных Тогда  
			
			Строка.Выгружать = Отметка;
			
		КонецЕсли;
	
	КонецЦикла;	

	УстановитьТекстВыбраноОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстВыбраноОбъектов()

	Для Каждого Строка Из НастройкиВыгрузки Цикл 
		
		Строка.ТекстВыбраноОбъектов = "";
		
		нСтроки = ОбъектыДляВыгрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", Строка.ИмяОбъектаМетаданных));
		
		Если нСтроки.Количество() Тогда
			
			ВсегоОбъектов 	= нСтроки.Количество();
			ВыбраноОбъектов = 0;
			ТребуютДействия = 0;
		
			Для Каждого нСтрока Из нСтроки Цикл 
				
				Если нСтрока.Выгружать Тогда
					
					ВыбраноОбъектов = ВыбраноОбъектов + 1;
					
					Если нСтрока.НесколькоОбъктовВыгрузки Тогда 
						
						ТребуютДействия = ТребуютДействия + 1;
						
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЦикла;	
			
			СтрокаВыбораОбъектов = ?(ТребуютДействия > 0, "; требуют действия - " + ТребуютДействия, "");
			
			Строка.ТекстВыбраноОбъектов = "" + ВыбраноОбъектов + " из " + ВсегоОбъектов + СтрокаВыбораОбъектов;
			
			Строка.ВыбраноОбъектов 	= ВыбраноОбъектов;
			Строка.ТребуютДействия 	= ТребуютДействия;
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляВыгрузкиВыгружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ОбъектыДляВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	нСтроки 	= ОбъектыДляВыгрузки.НайтиСтроки(Новый Структура("Выгружать, ИмяОбъектаМетаданных", Истина, ТекДанные.ИмяОбъектаМетаданных));
	Настройка	= НастройкиВыгрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", ТекДанные.ИмяОбъектаМетаданных))[0];
	
	Настройка.Выгружать = Не нСтроки.Количество() = 0;
	
	УстановитьТекстВыбраноОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораОбъекта(Результат, ДопПараметры) Экспорт 

	Если Результат = Неопределено Тогда 
		Возврат
	КонецЕсли;	

	ВыбСтрока = ДопПараметры.ВыбСтрока;
	
	ВыбСтрока.ТребуемоеДействие 		= "Настроено";
	
	Если ДопПараметры.Свойство("РежимЗагрузки") Тогда
		ВыбСтрока.ЗначениеОбъекта = Результат;
		ВыбСтрока.НайденоНесколькоЗначений 	= Ложь;
		УстановитьТекстВыбраноОбъектовЗагрузки();
	Иначе
		ВыбСтрока.Ссылка = Результат;
		ВыбСтрока.НесколькоОбъктовВыгрузки 	= Ложь;
		УстановитьТекстВыбраноОбъектов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗагрузкиЗагружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;	
	
	УстановитьОтметкиЗагрузки(ТекДанные.Загружать, ТекДанные.ИмяОбъектаМетаданных);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиЗагрузки(Отметка, ИмяОбъектаМетаданных)

	Для Каждого Строка Из ОбъектыДляЗагрузки Цикл 
		
		Если Строка.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных Тогда  
			
			Строка.Загружать = Отметка;
			
		КонецЕсли;
	
	КонецЦикла;	

	УстановитьТекстВыбраноОбъектовЗагрузки();
	
	УстановитьОтметкиПотомков(Отметка, ИмяОбъектаМетаданных);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтметкиПотомков(Отметка, ИмяОбъектаМетаданных)
	
	Дерево = РеквизитФормыВЗначение("ДеревоИерархииНастроек");
	
	УстановитьОтметкуПотомков(Отметка, Дерево.Строки, ИмяОбъектаМетаданных);	
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоИерархииНастроек");
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьОтметкуПотомков(Отметка, Строки, ИмяОбъектаМетаданных)
		
	Для Каждого Строка Из Строки Цикл 
		
		Если Строка.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных Тогда
			
			Строка.Загружать = Отметка;
			
			УстановитьОтметкуПотомков(Отметка, Строка.Строки, ИмяОбъектаМетаданных);
			
		КонецЕсли;
		
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстВыбраноОбъектовЗагрузки()

	Для Каждого Строка Из НастройкиЗагрузки Цикл 
		
		Строка.ТекстВыбраноОбъектов = "";
		
		нСтроки = ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("ЭтоГруппа, ИмяОбъектаМетаданных", Ложь, Строка.ИмяОбъектаМетаданных));
		
		Если нСтроки.Количество() Тогда
			
			ВсегоОбъектов 	= нСтроки.Количество();
			ВыбраноОбъектов = 0;
			ТребуютДействия = 0;
		
			Для Каждого нСтрока Из нСтроки Цикл 
				
				Если нСтрока.Загружать Тогда
					
					ВыбраноОбъектов = ВыбраноОбъектов + 1;
					
					Если нСтрока.НайденоНесколькоЗначений Тогда 
						
						ТребуютДействия = ТребуютДействия + 1;
						
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЦикла;	
			
			СтрокаВыбораОбъектов = ?(ТребуютДействия > 0, "; требуют действия - " + ТребуютДействия, "");
			
			Строка.ТекстВыбраноОбъектов = "" + ВыбраноОбъектов + " из " + ВсегоОбъектов + СтрокаВыбораОбъектов;
			
			Строка.ВыбраноОбъектов 	= ВыбраноОбъектов;
			Строка.ТребуютДействия 	= ТребуютДействия;
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляЗагрузкиЗагружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ОбъектыДляЗагрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	нСтроки 	= ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("Загружать, ИмяОбъектаМетаданных, ЭтоДопОбъект, ЭтоГруппа", Истина, ТекДанные.ИмяОбъектаМетаданных, Ложь, Ложь));
	Настройка	= НастройкиЗагрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", ТекДанные.ИмяОбъектаМетаданных))[0];
	
	Настройка.Загружать = Не нСтроки.Количество() = 0;
	
	УстановитьТекстВыбраноОбъектовЗагрузки();
	
	УстановитьОтметкиРодителей(ТекДанные.Загружать, ТекДанные.ИмяОбъектаМетаданных, ТекДанные.Наименование);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтметкиРодителей(Отметка, ИмяОбъектаМетаданных, Наименование)
	
	Дерево = РеквизитФормыВЗначение("ДеревоИерархииНастроек");
	
	СтрокиДерева = Дерево.Строки.НайтиСтроки(Новый Структура("Наименование, ИмяОбъектаМетаданных", Наименование, ИмяОбъектаМетаданных), Истина);
	
	Если СтрокиДерева.Количество() Тогда 
		
		СтрокаДерева = СтрокиДерева[0];
		
		Если Отметка Тогда 
			
			УстановитьОтметкуРодителей(СтрокаДерева);		
			
		Иначе
			
			СнятьОтметкуРодителей(СтрокаДерева);
			
		КонецЕсли;
				
	КонецЕсли;		
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоИерархииНастроек");
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьОтметкуРодителей(СтрокаДерева)
	
	СтрокаДерева.Загружать = Истина;
	
	нСтроки = ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("ЭтоГруппа, Наименование", Истина, СтрокаДерева.Наименование));
	
	Для Каждого нСтрока Из нСтроки Цикл 
		нСтрока.Загружать = Истина;
	КонецЦикла;	
	
	СтрокаРодителя = СтрокаДерева.Родитель;
	
	Если Не СтрокаРодителя = Неопределено И Не СтрокаРодителя.Загружать Тогда 
		
		УстановитьОтметкуРодителей(СтрокаРодителя);
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура СнятьОтметкуРодителей(СтрокаДерева)
		
	СтрокаДерева.Загружать = Ложь;
	
	нСтроки = ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("ЭтоГруппа, Наименование", Истина, СтрокаДерева.Наименование));
	
	Для Каждого нСтрока Из нСтроки Цикл 
		нСтрока.Загружать = Ложь;
	КонецЦикла;
	
	СтрокаРодителя = СтрокаДерева.Родитель;
	
	Если Не СтрокаРодителя = Неопределено Тогда 
		
		СтрокиРодителя = СтрокаРодителя.Строки; 
		
		СтрокиБезОтметок = СтрокиРодителя.НайтиСтроки(Новый Структура("Загружать", Истина), Истина);
		
		Если СтрокиБезОтметок.Количество() = 0 Тогда 
			
			СнятьОтметкуРодителей(СтрокаРодителя); 	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляЗагрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбСтрока = ОбъектыДляЗагрузки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ОбъектыДляЗагрузкиЗначениеОбъекта" И ЗначениеЗаполнено(ВыбСтрока.ЗначениеОбъекта) Тогда 
		
		ИмяФормыНастроек = "Справочник." + ВыбСтрока.ИмяОбъектаМетаданных + ".ФормаОбъекта";
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяФормыНастроек, 
			Новый Структура("Ключ", ВыбСтрока.ЗначениеОбъекта),
			ЭтаФорма,,,, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Поле.Имя = "ОбъектыДляЗагрузкиТребуемоеДействие" Тогда
		
		СтандартнаяОбработка = Истина;
						
		Если Не ВыбСтрока.Загружать Или ВыбСтрока.ТребуемоеДействие = "Настроено" Тогда 
			Возврат
		КонецЕсли;
		
		Отбор = Новый Структура("ИмяОбъектаМетаданных, Наименование", ВыбСтрока.ИмяОбъектаМетаданных, ВыбСтрока.Наименование);
		нСтроки = НайденныеЗначения.НайтиСтроки(Отбор);
		
		Если нСтроки.Количество() Тогда 
			
			ОбъектыВыбора = Новый СписокЗначений;
			
			Для Каждого нСтрока Из нСтроки Цикл 
				ОбъектыВыбора.Добавить(нСтрока.Значение);	
			КонецЦикла;	
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Обработка.КонтурЛогистика_ВыгрузкаЗагрузкаНастроек.Форма.ФормаВыборОбъекта", 
				Новый Структура("ОбъектыВыбора", ОбъектыВыбора), 
				ЭтаФорма,
				ЭтаФорма,
				"ОбработчикВыбораОбъекта",
				Новый Структура("ВыбСтрока, РежимЗагрузки", ВыбСтрока, Истина),,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		КонецЕсли;		
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьСкрытьПодсказки(Форма)
	
	Элементы = Форма.Элементы;

	Элементы.ДекорацияИмяФайлаВыгрузкиОписание.Видимость 	= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаВыгрузитьНастройкиОписание.Видимость 	= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаНастройкиВыгрузкиОписание.Видимость 		= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаОбъектыДляВыгрузкиОписание.Видимость 	= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаИмяФайлаЗагрузкиОписание.Видимость 		= Не Форма.ПодсказкиСкрыты И Форма.РежимРаботыНаКлиентеИлиНаСервере;
	Элементы.ГруппаПрочитатьДанныеОписание.Видимость 		= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаЗагрузитьДанныеОписание.Видимость 		= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаНастройкиЗагрузкиОписание.Видимость 		= Не Форма.ПодсказкиСкрыты;
	Элементы.ГруппаОбъектыДляЗагрузкиОписание.Видимость 	= Не Форма.ПодсказкиСкрыты;
	
	КартинкаПоказать = БиблиотекаКартинок.КонтурЛогистика_Показать;
	КартинкаСкрыть	 = БиблиотекаКартинок.КонтурЛогистика_Скрыть;
	
	Элементы.СкрытьПоказатьПодсказкиЗагрузка.Картинка = ?(Форма.ПодсказкиСкрыты, КартинкаПоказать, КартинкаСкрыть);
	Элементы.СкрытьПоказатьПодсказкиВыгрузка.Картинка = ?(Форма.ПодсказкиСкрыты, КартинкаПоказать, КартинкаСкрыть);
		
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьПодсказки(Команда)
	
	ПодсказкиСкрыты = Не ПодсказкиСкрыты;
	
	ПоказатьСкрытьПодсказки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКнопкиПоУмолчанию()

	Если РежимВыгрузки Тогда 
		Элементы.ВыгрузитьДанные.КнопкаПоУмолчанию = РежимВыгрузки;
	Иначе
		Элементы.ПрочитатьДанные.КнопкаПоУмолчанию = Не РежимЧтения;
		Элементы.ЗагрузитьДанные.КнопкаПоУмолчанию = РежимЧтения;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗаголовкиКолонок()

	ТекДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;
	
	Элементы.ОбъектыДляЗагрузкиНаименование.Заголовок 		= "прочитано из файла";
	Элементы.ОбъектыДляЗагрузкиЗначениеОбъекта.Заголовок 	= "найдено в базе";
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;	

	Если ТекДанные.ЭтоДопОбъект Или ТекДанные.ИмяОбъектаМетаданных = "КонтурЛогистика_Настройки" Тогда 
		
		Элементы.ОбъектыДляЗагрузкиНаименование.Заголовок 		= "прочитано из файла (обновит значение в базе)";
		Элементы.ОбъектыДляЗагрузкиЗначениеОбъекта.Заголовок 	= "найдено в базе (будет обновлено)";
		
	Иначе 
		
		Элементы.ОбъектыДляЗагрузкиНаименование.Заголовок 		= "прочитано из файла (будет создано)";
		Элементы.ОбъектыДляЗагрузкиЗначениеОбъекта.Заголовок 	= "найдено в базе (будет удалено)";
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбработатьНачалоВыбораФайла(СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаНаКлиентеИлиНаСервереПриИзменении(Элемент)
	
	ПриИзмененииРежимаРаботы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаНаКлиентеИлиНаСервереПриИзменении(Элемент)
	
	ПриИзмененииРежимаРаботы(ЭтаФорма);
	
	ИмяФайлаЗагрузки = "";
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииРежимаРаботы(Форма)
	
	Форма.РежимРаботыНаКлиенте = (Форма.РежимРаботыНаКлиентеИлиНаСервере = 0);
	
	Форма.Элементы.ИмяФайлаВыгрузки.Видимость 				= Не Форма.РежимРаботыНаКлиенте;
	Форма.Элементы.ГруппаИмяФайлаВыгрузкиОписание.Видимость = Не Форма.РежимРаботыНаКлиенте;
	
	Форма.Элементы.ИмяФайлаЗагрузки.Видимость 				= Не Форма.РежимРаботыНаКлиенте;
	Форма.Элементы.ГруппаИмяФайлаЗагрузкиОписание.Видимость = Не Форма.ПодсказкиСкрыты И Форма.РежимРаботыНаКлиентеИлиНаСервере;
	
	Если Форма.РежимРаботыНаКлиенте Тогда 
		
		Форма.Элементы.ПрочитатьДанные.Заголовок 	= "Выбрать файл и прочитать настройки";
		Форма.Элементы.ДекорацияПрочитатьДанныеОписание.Заголовок = "Выбирете файл настроек и Прочитайте настройки из указанного файла";
		
	Иначе
		
		Форма.Элементы.ПрочитатьДанные.Заголовок 	= "Прочитать настройки";		
		Форма.Элементы.ДекорацияПрочитатьДанныеОписание.Заголовок = "Прочитайте настройки из указанного файла";
		
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Текст, ПутьКДанным = "")
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.ПутьКДанным = ПутьКДанным;
	Сообщение.Сообщить();
	
КонецПроцедуры

