#Область ОписаниеПеременных

Перем МетаданныеОписание;
Перем СсылочныеТипы;
Перем СоответствиеОбъектовМетаданныхИСсылочныхТипов;
Перем ОбработанныхКонстант;
Перем ОбработанныхНаборовЗаписей;
Перем мСоответствиеКолонокДвижений;

Перем СоставПолнойВыгрузки;
Перем СоставВспомогательнойВыгрузки;

Перем мТипРезультатЗапроса; 
Перем мТипДанныхУдаления;

Перем мВыгруженныеОбъекты;
Перем мКоличествоСохраненныхПоследнихВыгрузок;

Перем мНаличиеВыгрузкиПодчиненныхОбъектов;
Перем ТаблицаПредопределенных;
Перем СоответствиеЗаменыСсылок;
Перем Сериализатор;

Перем ДополнительныеОбъектыДляВыгрузки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура ВыполнитьВыгрузку(Знач ИмяФайла, НастройкиВыгрузки, ОбъектыДляВыгрузки) Экспорт
	
	нСтроки = ОбъектыДляВыгрузки.НайтиСтроки(Новый Структура("Выгружать", Истина));
	                                                          
	Если Не НастройкиВыгрузки.Количество() И Не нСтроки.Количество() Тогда 
		
		Сообщить("Нет отмеченных объектов для выгрузки.");
		Возврат
		
	КонецЕсли;	
	
	Инициализация();
	
	ОбъектыВыгруженныеСОшибками = Новый Соответствие;
		
	СоставВыгрузки();
	
	ДополнительныеОбъектыДляВыгрузки = Новый ТаблицаЗначений;
	ДополнительныеОбъектыДляВыгрузки.Колонки.Добавить("Объект");
	ДополнительныеОбъектыДляВыгрузки.Колонки.Добавить("ИмяОбъектаДляЗапроса");
	
	Для Каждого ОбъектВыгрузки Из ОбъектыДляВыгрузки Цикл 
		
		Если Не ОбъектВыгрузки.Выгружать Тогда 
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДополнительныеОбъектыДляВыгрузки.Добавить();
		НоваяСтрока.Объект = ОбъектВыгрузки.Ссылка;
		НоваяСтрока.ИмяОбъектаДляЗапроса = ОбъектВыгрузки.Ссылка.Метаданные().ПолноеИмя();
		
		// выгрузить фиксированные значения для обратного маппинга
		Если ТипЗнч(ОбъектВыгрузки.Ссылка) = Тип("СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов") Тогда
			ВыгрузитьФиксированныеЗначенияДляОбратногоМаппинга(ДополнительныеОбъектыДляВыгрузки, ОбъектВыгрузки.Ссылка);
		КонецЕсли;
		
	КонецЦикла;	
	
	Если СоставПолнойВыгрузки.Количество() = 0 
		И ДополнительныеОбъектыДляВыгрузки.Количество() = 0 Тогда
		
		Сообщить("Не задан состав выгрузки");
		Возврат;
		
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
					
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("_1CV8DtUD", "http://www.1c.ru/V8/1CV8DtUD/");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("V8Exch", "http://www.1c.ru/V8/1CV8DtUD/");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("core", "http://v8.1c.ru/data");
	
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8", "http://v8.1c.ru/8.1/data/enterprise/current-config");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("V8Exch:Data");
		
	ШаблонНачалоВыгрузки = "Начало выгрузки: %Дата";
	СообщениеНачалоВыгрузки = СтрЗаменить(ШаблонНачалоВыгрузки, "%Дата", ТекущаяДатаСеанса());
	Сообщить(СообщениеНачалоВыгрузки);
			
	ИнициализироватьСериализаторXDTOСАннотациейТипов();
		
	ВыгрузкаДанных(ЗаписьXML, ОбъектыДляВыгрузки);
		
	ЗаписьXML.ЗаписатьКонецЭлемента(); //V8Exc:Data
	ВыгрузитьТаблицуПредопределенных(ЗаписьXML);
	ЗаписьXML.ЗаписатьКонецЭлемента(); //V8Exc:_1CV8DtUD
	
	ШаблонВыгружено = "Выгружено объектов: %Выгружено";
	СообщениеВыгружено = СтрЗаменить(ШаблонВыгружено, "%Выгружено", ВсегоОбработанныхЗаписей());
	Сообщить(СообщениеВыгружено);
	
	ШаблонОкончание = "Окончание выгрузки: %Дата";
	СообщениеОкончание = СтрЗаменить(ШаблонОкончание, "%Дата", ТекущаяДатаСеанса());
	Сообщить(СообщениеОкончание);
		
	Сообщить("Выгрузка данных успешно завершена");
		
КонецПроцедуры

// Процедура разбирает файл выгрузки и осуществляет запись в ИБ сохраненных
// там объектов
//
// Параметры
//   ИмяФайла - имя файла выгрузки
//
Процедура ВыполнитьЗагрузку(Знач ИмяФайла, ОбъектыДляЗагрузки, НайденныеЗначения, ДеревоИерархииНастроек, РежимЧтения = Ложь) Экспорт
	
	Если РежимЧтения Тогда 
		
		ДеревоИерархииНастроек.Строки.Очистить();
		
	КонецЕсли;	
	
	ОбъектыДляЗагрузкиВрем = Новый ТаблицаЗначений;
	
	ОбъектыДляЗагрузкиВрем.Колонки.Добавить("ИмяОбъектаМетаданных", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
	ОбъектыДляЗагрузкиВрем.Колонки.Добавить("ПредставлениеОбъектаМетаданных", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200)); 
	ОбъектыДляЗагрузкиВрем.Колонки.Добавить("ЭтоГруппа", 	Новый ОписаниеТипов("Булево"));
	ОбъектыДляЗагрузкиВрем.Колонки.Добавить("ЭтоНовый", 	Новый ОписаниеТипов("Булево"));
	ОбъектыДляЗагрузкиВрем.Колонки.Добавить("ЭтоДопОбъект", Новый ОписаниеТипов("Булево"));
	ОбъектыДляЗагрузкиВрем.Колонки.Добавить("Наименование", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
	
	ПоляПоиска = Новый ТаблицаЗначений;
	
	ПоляПоиска.Колонки.Добавить("ИмяОбъектаМетаданных", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
	ПоляПоиска.Колонки.Добавить("Параметр", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
	ПоляПоиска.Колонки.Добавить("ЗначениеПараметра", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(200));
	ПоляПоиска.Колонки.Добавить("ПолноеИмяМД", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(300));
	
	Файл = Новый Файл(ИмяФайла);
		
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	// проверка формата файла обмена
	Если Не ЧтениеXML.Прочитать()
		Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "_1CV8DtUD"
		Или ЧтениеXML.URIПространстваИмен <> "http://www.1c.ru/V8/1CV8DtUD/" Тогда
		
		Сообщить("Неверный формат файла выгрузки");
		Возврат;
		
	КонецЕсли;
	
	Если Не ЧтениеXML.Прочитать()
		Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "Data" Тогда
		
		Сообщить("Неверный формат файла выгрузки");
		Возврат;
		
	КонецЕсли;
	
	ЗагрузитьТаблицуПредопределенных(ЧтениеXML);
	ЗаменитьСсылкиНаПредопределенные(ИмяФайла);
	
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	ЧтениеXML.Прочитать();
	ЧтениеXML.Прочитать();
	
	// чтение и запись в ИБ записанных в выгрузке объектов
	Если Не ЧтениеXML.Прочитать() Тогда 
		
		Сообщить("Неверный формат файла выгрузки");
		Возврат;
		
	КонецЕсли;
	
	Загружено = 0;
	
	ШаблонСообщения = "Начало " + ?(РежимЧтения, "чтения", "загрузки") + ": %Дата";
	ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%Дата", ТекущаяДатаСеанса());
	
	Сообщить(ТекстСообщения);
	
	ИнициализироватьСериализаторXDTOСАннотациейТипов();
	
	ПустойУИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
	Пока Сериализатор.ВозможностьЧтенияXML(ЧтениеXML) Цикл
		
		Попытка
			
			СтруктураЗагрузки = Сериализатор.ПрочитатьXML(ЧтениеXML);
			
			ЗаписанноеЗначение = СтруктураЗагрузки.Объект;
			
			Если РежимЧтения Тогда 
								
				НоваяСтрока = ОбъектыДляЗагрузкиВрем.Добавить();
				
				НоваяСтрока.ИмяОбъектаМетаданных 			= ЗаписанноеЗначение.Метаданные().Имя;
				НоваяСтрока.ПредставлениеОбъектаМетаданных 	= ЗаписанноеЗначение.Метаданные().Синоним;
				
				НоваяСтрока.ЭтоНовый 		= ЗаписанноеЗначение.Ссылка.Пустая();
				НоваяСтрока.ЭтоДопОбъект 	= МассивВыгружаемыхСправочников().Найти(НоваяСтрока.ИмяОбъектаМетаданных) = Неопределено;
				НоваяСтрока.Наименование 	= ЗаписанноеЗначение.Наименование;
				НоваяСтрока.ЭтоГруппа	 	= ЗаписанноеЗначение.ЭтоГруппа;
								
				//ПоляПоискаНастроек = ПоляПоискаНастроек();
				//СоответствиеПолейПоиска = ПоляПоискаНастроек.Получить(НоваяСтрока.ИмяОбъектаМетаданных);
				//
				//Если СоответствиеПолейПоиска = Неопределено Тогда 
					СоответствиеПолейПоиска = "Наименование";
				//КонецЕсли;	
				
				ПараметрыПоиска = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СоответствиеПолейПоиска, ",");
				
				Для Каждого Параметр Из ПараметрыПоиска Цикл
				
					ПолеПоиска = ПоляПоиска.Добавить();
					
					ПолеПоиска.ИмяОбъектаМетаданных = ЗаписанноеЗначение.Метаданные().Имя;
					ПолеПоиска.Параметр 			= Параметр;
					ПолеПоиска.ЗначениеПараметра 	= ЗаписанноеЗначение[Параметр];
					ПолеПоиска.ПолноеИмяМД		 	= ЗаписанноеЗначение.Метаданные().ПолноеИмя();
				
				КонецЦикла;
				
				Если ДеревоИерархииНастроек.Строки.Найти(СтруктураЗагрузки.УИД, "УИД", Истина) = Неопределено Тогда 
					
					СтрокаРодителя = ДеревоИерархииНастроек.Строки.Найти(СтруктураЗагрузки.УИДРодителя, "УИД", Истина);
					Если СтрокаРодителя = Неопределено Тогда 
						СтрокиРодителя = ДеревоИерархииНастроек.Строки;
					Иначе
						СтрокиРодителя = СтрокаРодителя.Строки;
					КонецЕсли;	
					
					ЗаполнитьЗначенияСвойств(СтрокиРодителя.Добавить(), СтруктураЗагрузки);
					
				КонецЕсли;	
				                                                               								
			КонецЕсли;	
			
		Исключение
			ВызватьИсключение;
		КонецПопытки;
		
		Если Не РежимЧтения Тогда 
			
			Отбор = Новый Структура("Загружать, ИмяОбъектаМетаданных, Наименование", Истина, ЗаписанноеЗначение.Метаданные().Имя, ЗаписанноеЗначение.Наименование);
			нСтроки = ОбъектыДляЗагрузки.НайтиСтроки(Отбор);
			
			Если Не нСтроки.Количество() Тогда 
				Продолжить;
			КонецЕсли;	
			
			НайденнаяСтрока = нСтроки[0];
			
			НовыйОбъект = Неопределено;
			
			Если Не НайденнаяСтрока.ЭтоДопОбъект 
				И Не НайденнаяСтрока.ИмяОбъектаМетаданных = "КонтурЛогистика_Настройки" 
				И ЗначениеЗаполнено(НайденнаяСтрока.ЗначениеОбъекта) Тогда 
				
				НовыйОбъект = ЗаписанноеЗначение.Скопировать();
				
				СтарыйОбъект = НайденнаяСтрока.ЗначениеОбъекта.ПолучитьОбъект();
				СтарыйОбъект.УстановитьПометкуУдаления(Истина);
				
			ИначеЕсли НайденнаяСтрока.ИмяОбъектаМетаданных = "КонтурЛогистика_Настройки" 
				И НайденнаяСтрока.ЭтоГруппа 
				И ЗначениеЗаполнено(НайденнаяСтрока.ЗначениеОбъекта) Тогда 
				
				Продолжить;
				
			ИначеЕсли НайденнаяСтрока.ИмяОбъектаМетаданных = "КонтурЛогистика_Настройки" Тогда 
				
				Если ЗначениеЗаполнено(НайденнаяСтрока.ЗначениеОбъекта) Тогда
					
					НовыйОбъект = НайденнаяСтрока.ЗначениеОбъекта.ПолучитьОбъект();
					
					ЗаполнитьЗначенияСвойств(НовыйОбъект, ЗаписанноеЗначение,, "Владелец,СписокЗначений"); 
					
					УИДГруппы = ЗаписанноеЗначение.Родитель.УникальныйИдентификатор();
					СтрокаДерева = ДеревоИерархииНастроек.Строки.Найти(УИДГруппы, "УИД", Истина);  
					
					Если Не СтрокаДерева = Неопределено Тогда 
						нСтрока = ОбъектыДляЗагрузки.Найти(СтрокаДерева.Наименование, "Наименование");
						Если Не нСтрока = Неопределено Тогда 
							НовыйОбъект.Родитель = нСтрока.ЗначениеОбъекта;
						КонецЕсли;	
					КонецЕсли;
					
				КонецЕсли;
				
			//ИначеЕсли НайденнаяСтрока.ЭтоДопОбъект И ЗначениеЗаполнено(НайденнаяСтрока.ЗначениеОбъекта) И ЗаписанноеЗначение.Ссылка.Пустая() Тогда 
			//	
			//	НовыйОбъект = НайденнаяСтрока.ЗначениеОбъекта.ПолучитьОбъект();
			//	
			//	ЗаполнитьЗначенияСвойств(НовыйОбъект, ЗаписанноеЗначение);
				
			КонецЕсли;	
				
			Попытка
								
				Если Не НовыйОбъект = Неопределено Тогда  
					НовыйОбъект.УстановитьНовыйКод();
					НовыйОбъект.Записать();
				Иначе
					ЗаписанноеЗначение.УстановитьНовыйКод();
					ЗаписанноеЗначение.Записать();	
				КонецЕсли;	
				
			Исключение
				
				ТекстОшибки = ОписаниеОшибки();
				
				Если НЕ ПродолжитьЗагрузкуВСлучаеВозникновенияОшибки Тогда
					
					ВызватьИсключение;
					
				Иначе
					
					Попытка
						
						ТекстСообщения = "При загрузке объекта %1(%2) возникла ошибка:
							|%3";
						
						ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ТекстСообщения, 
							ЗаписанноеЗначение, 
							ТипЗнч(ЗаписанноеЗначение), 
							ТекстОшибки);
							
					Исключение
							
						ТекстСообщения = "При загрузке данных возникла ошибка:
							|%1";
						
						ТекстСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ТекстСообщения, ТекстОшибки);
						
					КонецПопытки;
					
					Сообщить(ТекстСообщения);
					
				КонецЕсли;
				
				Загружено = Загружено - 1;
				
			КонецПопытки;	
		
		КонецЕсли;
		
		Загружено = Загружено + 1;
		
	КонецЦикла;
		
	// проверка формата файла обмена
	Если ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "Data" Тогда
		
		Сообщить("Неверный формат файла выгрузки");
		Возврат;
		
	КонецЕсли;
	
	Если Не ЧтениеXML.Прочитать()
		Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "PredefinedData" Тогда
		
		Сообщить("Неверный формат файла выгрузки");
		Возврат;
		
	КонецЕсли;
	
	ЧтениеXML.Пропустить();
	
	Если Не ЧтениеXML.Прочитать()
		Или ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "_1CV8DtUD"
		Или ЧтениеXML.URIПространстваИмен <> "http://www.1c.ru/V8/1CV8DtUD/" Тогда
		
		Сообщить("Неверный формат файла выгрузки");
		Возврат;
		
	КонецЕсли;
	
	ЧтениеXML.Закрыть();
	
	Если РежимЧтения Тогда
		
		ЗаполнитьЗначенияОбъектовИзФайла(ОбъектыДляЗагрузки, ОбъектыДляЗагрузкиВрем);
		ЗаполнитьЗначенияОбъектовИзБазы(ПоляПоиска, НайденныеЗначения);
		
	КонецЕсли;	
	
	ШаблонЗагружено = ?(РежимЧтения, "Прочитано", "Загружено") + " объектов: %Количество";
	СообщениеЗагружено = СтрЗаменить(ШаблонЗагружено, "%Количество", Загружено);
	
	ШаблонОкончание = "Окончание " + ?(РежимЧтения, "чтения",  "загрузки") + ": %Дата";
