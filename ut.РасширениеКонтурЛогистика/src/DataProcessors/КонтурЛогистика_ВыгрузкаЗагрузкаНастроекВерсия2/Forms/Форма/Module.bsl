#Область Константы

&НаКлиенте
Процедура ПодборКонстант(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе", Ложь);
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Обработка.КонтурЛогистика_ВыгрузкаЗагрузкаНастроекВерсия2.Форма.ФормаПодбораКонстант",
		ПараметрыФормы, Элементы.ОбъектыДляВыгрузки);
 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляВыгрузкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат	
	КонецЕсли;

	Отбор = Новый Структура("ИмяОбъектаМетаданных,Ссылка", "Константы", ВыбранноеЗначение.Имя);
	Если ОбъектыДляВыгрузки.НайтиСтроки(Отбор).Количество() = 0 Тогда
	
		НоваяСтрока = ОбъектыДляВыгрузки.Добавить();
		НоваяСтрока.Выгружать = Истина;
		НоваяСтрока.Наименование = ВыбранноеЗначение.Синоним;
		НоваяСтрока.Ссылка = ВыбранноеЗначение.Имя;
		НоваяСтрока.ИмяОбъектаМетаданных = "Константы";
		НоваяСтрока.ПредставлениеОбъектаМетаданных = "Константы";
				
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УправлениеЭлементамиФормы()
	
	ТекущиеДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ОбъектыДляВыгрузкиПодборКонстант.Видимость = ТекущиеДанные.ИмяОбъектаМетаданных = "Константы";
	
КонецПроцедуры

#КонецОбласти