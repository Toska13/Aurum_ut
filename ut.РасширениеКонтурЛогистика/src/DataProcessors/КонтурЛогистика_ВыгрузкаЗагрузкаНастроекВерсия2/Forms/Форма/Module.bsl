#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантВыгрузки = "ТолькоНастройки";
	
	ДобавитьНастройкуВыгрузки("КонтурЛогистика_Настройки", Истина);
	ДобавитьНастройкуВыгрузки("КонтурЛогистика_НастройкиКонвертацииСправочников", Истина);
	ДобавитьНастройкуВыгрузки("КонтурЛогистика_НастройкиКонвертацииДокументов", Истина);
	Если Метаданные.Справочники.Найти("КонтурЛогистика_НастройкиКонвертацииРегистровСведений") <> Неопределено Тогда
		ДобавитьНастройкуВыгрузки("КонтурЛогистика_НастройкиКонвертацииРегистровСведений", Истина);
	КонецЕсли;
	ДобавитьНастройкуВыгрузки("КонтурЛогистика_СценарииАвтоматическойРаботы", Истина);
	ДобавитьНастройкуВыгрузки("КонтурЛогистика_НастройкиДополнительныхРеквизитов", Истина);
	
	Если ЕстьКонстанты() Тогда
		ДобавитьНастройкуВыгрузки("Константы");
	КонецЕсли;
	
	Попытка
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2_13() Тогда
			Элементы.ВариантВыгрузки.ВысотаЭлемента = 2;
			Элементы.ВариантВыгрузкиВсеОбъекты.ВысотаЭлемента = 2;
		КонецЕсли;
	Исключение
		// Модуль стрый
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборСтрок();
	УправлениеЭлементамиФормы();
	УправлениеОтображениемЖурналаВыгрузкиЗагрузки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовВыгрузкиФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяФайлаВыгрузки) Тогда
		Сообщить("Не задан файл выгрузки");
		Возврат;
	КонецЕсли;
	
	нСтроки = ОбъектыДляВыгрузки.НайтиСтроки(Новый Структура("Выгружать", Истина));
	
	Если нСтроки.Количество() = 0 Тогда 
		
		Сообщить("Нет отмеченных объектов для выгрузки.");
		Возврат
		
	КонецЕсли;
	
	Адрес = "";
	СтруктураАдресаПМ = Новый Структура;
	
	ВыгрузитьНаСервере(Адрес, СтруктураАдресаПМ, КаталогВыгрузки);
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	
	ДвоичныеДанные.Записать(ИмяФайлаВыгрузки);
	
	Если СтруктураАдресаПМ.Количество() > 0 Тогда
		ДвоичныеДанныеПМ = ПолучитьИзВременногоХранилища(СтруктураАдресаПМ.АдресПМ);
		ДвоичныеДанныеПМ.Записать(КаталогВыгрузки + СтруктураАдресаПМ.ИмяФайлаВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьНаСервере(Адрес, АдресПМ, КаталогВыгрузки, ВыводитьСообщение = Истина)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ВыполнитьВыгрузку(Адрес, АдресПМ, ОбъектыДляВыгрузки, ВариантВыгрузки, КаталогВыгрузки, ВыводитьСообщение);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиВыгрузкиПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрок();
	УправлениеЭлементамиФормы();
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкиВыгрузкиВыгружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	УстановитьОтметкиВыгрузки(ТекДанные.Выгружать, ТекДанные.ИмяОбъектаМетаданных);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиВыгрузки(Отметка, ИмяОбъектаМетаданных)
	
	Для Каждого Строка Из ОбъектыДляВыгрузки Цикл 
		
		Если Строка.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных Тогда  
			
			Строка.Выгружать = Отметка;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляВыгрузкиВыгружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ОбъектыДляВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	нСтроки = ОбъектыДляВыгрузки.НайтиСтроки(Новый Структура("Выгружать, ИмяОбъектаМетаданных", Истина, ТекДанные.ИмяОбъектаМетаданных));
	Настройка = НастройкиВыгрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", ТекДанные.ИмяОбъектаМетаданных))[0];
	
	Настройка.Выгружать = (Не нСтроки.Количество() = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеНастройкиВыгрузки(Команда)
	
	УстановитьСнятьОтметку(НастройкиВыгрузки, "Выгружать", Истина);
	УстановитьСнятьОтметку(ОбъектыДляВыгрузки, "Выгружать", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеНастройкиВыгрузки(Команда)
	
	УстановитьСнятьОтметку(НастройкиВыгрузки, "Выгружать", Ложь);
	УстановитьСнятьОтметку(ОбъектыДляВыгрузки, "Выгружать", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеОбъектыДляВыгрузки(Команда)
	
	ТекДанные = Элементы.ОбъектыДляВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСнятьОтметку(ОбъектыДляВыгрузки, "Выгружать", Истина, ТекДанные.ПредставлениеОбъектаМетаданных);
	
	ТекДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Выгружать = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОбъектыДляВыгрузки(Команда)
	
	ТекДанные = Элементы.ОбъектыДляВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСнятьОтметку(ОбъектыДляВыгрузки, "Выгружать", Ложь, ТекДанные.ПредставлениеОбъектаМетаданных);
	
	ТекДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Выгружать = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Заголовок = "Задайте имя файла выгрузки";
	ДиалогВыбораФайла.ПолноеИмяФайла = ИмяФайлаВыгрузки;
	ДиалогВыбораФайла.Фильтр = "Формат выгрузки(*.json)|*.json|Все файлы (*.*)|*.*";
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ИмяФайлаВыгрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		КаталогВыгрузки  = ДиалогВыбораФайла.Каталог;
		ИмяФайлаТекстовогоПредставленияНастроек = СтрЗаменить(ИмяФайлаВыгрузки, КаталогВыгрузки, "") + " Markdown.txt";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантВыгрузкиПриИзменении(Элемент)
	
	Если ВариантВыгрузки = "ВсеОбъектыЛогистики" Тогда
		ДобавитьВсеОбъектыЛогистики();
	Иначе
		УбратьВсеОбъектыЛогистики();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовЗагрузкиФормы

&НаКлиенте
Процедура НастройкиЗагрузкиЗагружатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	УстановитьОтметкиЗагрузки(ТекущиеДанные.Загружать, ТекущиеДанные.ИмяОбъектаМетаданных);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиЗагрузки(Отметка, ИмяОбъектаМетаданных)
	
	Для Каждого Строка Из ОбъектыДляЗагрузки Цикл 
		
		Если Строка.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных Тогда  
			Строка.Загружать = Отметка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗагрузкиПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрок(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляЗагрузкиЗагружатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбъектыДляЗагрузки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Загружать", Истина);
	ПараметрыОтбора.Вставить("ИмяОбъектаМетаданных", ТекущиеДанные.ИмяОбъектаМетаданных);
	ПараметрыОтбора.Вставить("ЭтоГруппа", Ложь);
	
	НайденныеСтроки = ОбъектыДляЗагрузки.НайтиСтроки(ПараметрыОтбора);
	
	Настройка = НастройкиЗагрузки.НайтиСтроки(Новый Структура("ИмяОбъектаМетаданных", ТекущиеДанные.ИмяОбъектаМетаданных))[0];
	Настройка.Загружать = (Не НайденныеСтроки.Количество() = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыДляВыгрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбСтрока = ОбъектыДляВыгрузки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ОбъектыДляВыгрузкиНаименование" И ЗначениеЗаполнено(ВыбСтрока.Ссылка) Тогда 
		
		ИмяФормыНастроек = "Справочник." + ВыбСтрока.ИмяОбъектаМетаданных + ".ФормаОбъекта";
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			ИмяФормыНастроек, Новый Структура("Ключ", ВыбСтрока.Ссылка), ЭтаФорма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеНастройкиЗагрузки(Команда)
	
	УстановитьСнятьОтметку(НастройкиЗагрузки, "Загружать", Истина);
	УстановитьСнятьОтметку(ОбъектыДляЗагрузки, "Загружать", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеНастройкиЗагрузки(Команда)
	
	УстановитьСнятьОтметку(НастройкиЗагрузки, "Загружать", Ложь);
	УстановитьСнятьОтметку(ОбъектыДляЗагрузки, "Загружать", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеОбъектыДляЗагрузки(Команда)

	ТекДанные = Элементы.ОбъектыДляЗагрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСнятьОтметку(ОбъектыДляЗагрузки, "Загружать", Истина, ТекДанные.ПредставлениеОбъектаМетаданных);
	
	ТекДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Или ТекДанные.ПредставлениеОбъектаМетаданных = "Список констант" Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Загружать = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОбъектыДляЗагрузки(Команда)

	ТекДанные = Элементы.ОбъектыДляЗагрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСнятьОтметку(ОбъектыДляЗагрузки, "Загружать", Ложь, ТекДанные.ПредставлениеОбъектаМетаданных);
	
	ТекДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Загружать = Ложь;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура УстановитьОтборСтрок()
	
	ТекДанные = Элементы.НастройкиВыгрузки.ТекущиеДанные;
			
	Элементы.ОбъектыДляВыгрузки.ОтборСтрок = ?(ТекДанные = Неопределено, 
		Неопределено, 
		Новый ФиксированнаяСтруктура("ПредставлениеОбъектаМетаданных", ТекДанные.ПредставлениеОбъектаМетаданных));
		
	ТекДанные = Элементы.НастройкиЗагрузки.ТекущиеДанные;	
	
	Элементы.ОбъектыДляЗагрузки.ОтборСтрок = ?(ТекДанные = Неопределено, 
		Неопределено, 
		Новый ФиксированнаяСтруктура("ПредставлениеОбъектаМетаданных, ЭтоГруппа", ТекДанные.ПредставлениеОбъектаМетаданных, Ложь));
		
	Если ТекДанные <> Неопределено И ТекДанные.ИмяОбъектаМетаданных = "Константы" Тогда		
		Элементы.ОбъектыДляЗагрузкиСсылка.Заголовок = "Значение";
		Элементы.ОбъектыДляЗагрузкиОтметитьВсеОбъектыДляЗагрузки.Доступность = Ложь;
		Элементы.ОбъектыДляЗагрузкиСнятьВсеОбъектыДляЗагрузки.Доступность = Ложь;
	Иначе
		Элементы.ОбъектыДляЗагрузкиСсылка.Заголовок = "Найдено в базе";
		Элементы.ОбъектыДляЗагрузкиОтметитьВсеОбъектыДляЗагрузки.Доступность = Истина;
		Элементы.ОбъектыДляЗагрузкиСнятьВсеОбъектыДляЗагрузки.Доступность = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ОтображениеКнопкиПоУмолчанию();
	
	УправлениеОтображениемЖурналаВыгрузкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеКнопкиПоУмолчанию()
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Страницы.ПодчиненныеЭлементы.СтраницаВыгрузка Тогда 
		Элементы.Выгрузить.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.Прочитать.КнопкаПоУмолчанию = ОбъектыДляЗагрузки.Количество() = 0;
		Элементы.Загрузить.КнопкаПоУмолчанию = ОбъектыДляЗагрузки.Количество() > 0 И НастройкиЗагрузки.Количество() > 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСнятьОтметку(ТЧ, Колонка, Установить, ПредставлениеОбъектаМетаданных = "")
	
	Для каждого Стр Из ТЧ Цикл
		
		Если (ЗначениеЗаполнено(ПредставлениеОбъектаМетаданных) И Стр.ПредставлениеОбъектаМетаданных <> ПредставлениеОбъектаМетаданных)
			Или Стр.ПредставлениеОбъектаМетаданных = "Список констант" Тогда
			Продолжить;	
		КонецЕсли;
		
		Стр[Колонка] = Установить;
		
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВТелеграм(Команда)
	
	нСтроки = ОбъектыДляВыгрузки.НайтиСтроки(Новый Структура("Выгружать", Истина));
	
	Если нСтроки.Количество() = 0 Тогда		
		Сообщить("Нет отмеченных объектов для выгрузки.");
		Возврат;		
	КонецЕсли;
	
	Адрес = "";
	СтруктураАдресаПМ = Новый Структура;
		
	ВыгрузитьНаСервере(Адрес, СтруктураАдресаПМ, КаталогВыгрузки, Ложь);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресНастроек", Адрес);
	ПараметрыФормы.Вставить("ТекстовоеПредставлениеНастроек", ТекстовоеПредставлениеНастроек());
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Обработка.КонтурЛогистика_ВыгрузкаЗагрузкаНастроекВерсия2.Форма.ФормаОтправкиВТелеграм", 
		ПараметрыФормы,
		ЭтаФорма,
		ЭтаФорма,
		"ОбработчикОтправкаВТелеграм");
				
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОтправкаВТелеграм(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = "Ок" Тогда
		Сообщить("Файлы с настройками выгрузки отправлены в Телеграм");	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаНастроек

&НаКлиенте
Процедура Загрузить(Команда)
	
	НайденныеСтроки = ОбъектыДляЗагрузки.НайтиСтроки(Новый Структура("Загружать", Истина));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Сообщить("Нет отмеченных объектов для загрузки.");
		Возврат;
	КонецЕсли;
	
	РежимЧтения = Ложь;
	
	ЖурналВыгрузкиЗагрузки.Очистить();
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		
		ПрочитатьНаСервере(Адрес);
		
		УправлениеОтображениемЖурналаВыгрузкиЗагрузки();
		
		РазвернутьДеревоЖурналВыгрузкиЗагрузки();
		
		Если ЖурналВыгрузкиЗагрузки.Количество() > 0 Тогда
			ШаблонПредупреждения = "Есть предупреждения при загрузке настроек - %Количество шт (см. вкладку)";
			СообщениеПредупреждения = СтрЗаменить(ШаблонПредупреждения, "%Количество", ЖурналВыгрузкиЗагрузки.Количество());
			КонтурЛогистика_СтдДиалогиКлиент.ПоказатьПредупреждениеЛок(Новый ОписаниеОповещения("ОбработчикПослеПредупрежденияЧтенияНастроек", ЭтаФорма), СообщениеПредупреждения);		
		КонецЕсли;
		
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", ЭтаФорма);
		НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоЖурналВыгрузкиЗагрузки()
	
	Строки = ДеревоЖурналВыгрузкиЗагрузки.ПолучитьЭлементы();
	
	Для Каждого Строка Из Строки Цикл
		
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Элементы.ДеревоЖурналВыгрузкиЗагрузки.Развернуть(ИдентификаторСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСФайламиПодключено(Подключено, ДополнительныеПараметры) Экспорт
	
	Если Не Подключено Тогда
		НачатьУстановкуРасширенияРаботыСФайлами(Неопределено);
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыбратьФайл(
		"ЗагрузитьИзФайлаЗавершение", ЭтаФорма, РежимДиалогаВыбораФайла.Открытие,
		"Выберите файл с настройками",, "Файл json (*.json)|*.json");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(МассивВыбранныхФайлов, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(МассивВыбранныхФайлов) Тогда 
		
		ВыбранныйФайл = МассивВыбранныхФайлов[0];
		
		Оповещение = Новый ОписаниеОповещения("НачатьСозданиеДвоичныхДанныхИзФайлаЗавершение", ЭтаФорма);
		НачатьСозданиеДвоичныхДанныхИзФайла(Оповещение, ВыбранныйФайл);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСозданиеДвоичныхДанныхИзФайлаЗавершение(ВыбранныйФайлДвоичныеДанные, ДополнительныеПараметры) Экспорт
	
	Адрес = ПоместитьВоВременноеХранилище(ВыбранныйФайлДвоичныеДанные, УникальныйИдентификатор);
	
	ПрочитатьНаСервере(Адрес);
	
	Если НастройкиЗагрузки.Количество() > 0 Тогда
		Элементы.НастройкиЗагрузки.ТекущаяСтрока = 0;
	КонецЕсли;
	
	Если РежимЧтения Тогда
		ОтображениеКнопкиПоУмолчанию();
	КонецЕсли;
	
	УстановитьОтборСтрок();
	
	УправлениеОтображениемЖурналаВыгрузкиЗагрузки();
	
	Если ЖурналВыгрузкиЗагрузки.Количество() > 0 Тогда
		ШаблонПредупреждения = "Есть предупреждения при чтение настроек - %Количество шт (см. вкладку)";
		СообщениеПредупреждения = СтрЗаменить(ШаблонПредупреждения, "%Количество", ЖурналВыгрузкиЗагрузки.Количество());
		КонтурЛогистика_СтдДиалогиКлиент.ПоказатьПредупреждениеЛок(Новый ОписаниеОповещения("ОбработчикПослеПредупрежденияЧтенияНастроек", ЭтаФорма), СообщениеПредупреждения);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПослеПредупрежденияЧтенияНастроек(ДополнительныеПараметры) Экспорт
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЖурналВыгрузкиЗагрузки;		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНаСервере(Адрес)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	
	ИмяФайлаЗагрузки = ПолучитьИмяВременногоФайла();
	
	ДвоичныеДанные.Записать(ИмяФайлаЗагрузки);
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяФайлаЗагрузки);
	
	СодержимоеФайла = ТекстовыйФайл.ПолучитьТекст();
	
	Результат = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(СодержимоеФайла);
	
	ЗагрузитьНастройки(Результат);
	
	ЗаполнитьДеревоЖурналВыгрузкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура Прочитать(Команда)
	
	ОбъектыДляЗагрузки.Очистить();
	НастройкиЗагрузки.Очистить();
	
	РежимЧтения = Истина;
	
	ЖурналВыгрузкиЗагрузки.Очистить();
	УправлениеОтображениемЖурналаВыгрузкиЗагрузки();
	
	Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", ЭтаФорма);
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки(Результат)
	
	Загружено = 0;
	
	ШаблонСообщения = "Начало " + ?(РежимЧтения, "чтения", "загрузки") + ": %Дата";
	ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%Дата", ТекущаяДатаСеанса());
	
	Сообщить(ТекстСообщения);
	
	Если РежимЧтения Тогда
		ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		ОбъектНаСервере.ПрочитатьПередЗагрузкой(Результат, НастройкиЗагрузки, ОбъектыДляЗагрузки, Загружено, ЖурналВыгрузкиЗагрузки);		
	Иначе		
		ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		ОбъектНаСервере.ВыполнитьЗагрузку(Результат, ОбъектыДляЗагрузки, Ложь, Загружено, ЖурналВыгрузкиЗагрузки);		
	КонецЕсли;
	
	ШаблонЗагружено = ?(РежимЧтения, "Прочитано", "Загружено") + " объектов: %Количество";
	СообщениеЗагружено = СтрЗаменить(ШаблонЗагружено, "%Количество", Загружено);
	
	СообщениеПредупреждения = "";
	Если ЖурналВыгрузкиЗагрузки.Количество() > 0 Тогда		
		ШаблонПредупреждения = "Предупреждения - %Количество шт (см. вкладку)";
		СообщениеПредупреждения = СтрЗаменить(ШаблонПредупреждения, "%Количество", ЖурналВыгрузкиЗагрузки.Количество());		
	КонецЕсли;
	
	ШаблонОкончание = "Окончание " + ?(РежимЧтения, "чтения",  "загрузки") + ": %Дата";
	СообщениеОкончание = СтрЗаменить(ШаблонОкончание, "%Дата", ТекущаяДатаСеанса());
	
	Сообщить(СообщениеЗагружено);
	Если ЗначениеЗаполнено(СообщениеПредупреждения) Тогда
		Сообщить(СообщениеПредупреждения);	
	КонецЕсли;
	Сообщить(СообщениеОкончание);
	Сообщить(?(РежимЧтения, "Чтение данных успешно завершено", "Загрузка данных успешно завершена"));
	 	
КонецПроцедуры

#КонецОбласти

#Область ЖурналВыгрузкиЗагрузки

&НаКлиенте
Процедура УправлениеОтображениемЖурналаВыгрузкиЗагрузки()
	
	Если ЖурналВыгрузкиЗагрузки.Количество() > 0 
		И (Элементы.Страницы.ТекущаяСтраница = Элементы.Страницы.ПодчиненныеЭлементы.СтраницаЗагрузка 
			Или Элементы.Страницы.ТекущаяСтраница = Элементы.Страницы.ПодчиненныеЭлементы.СтраницаЖурналВыгрузкиЗагрузки) Тогда
			
		Элементы.СтраницаЖурналВыгрузкиЗагрузки.Видимость = Истина;
		Элементы.СтраницаЖурналВыгрузкиЗагрузки.Заголовок = "Предупреждения загрузки";
		Элементы.СтраницаЖурналВыгрузкиЗагрузки.Картинка = БиблиотекаКартинок.КонтурЛогистика_Предупреждение;
		
	Иначе
		
		Элементы.СтраницаЖурналВыгрузкиЗагрузки.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЖурналВыгрузкиЗагрузки()
	
	ДеревоЖурнал = РеквизитФормыВЗначение("ДеревоЖурналВыгрузкиЗагрузки");
	
	ДеревоЖурнал.Строки.Очистить();
	
	Для каждого Стр Из ЖурналВыгрузкиЗагрузки Цикл
		
		Найд = ДеревоЖурнал.Строки.Найти(Стр.Ссылка, "Ссылка");
		Если Найд = Неопределено Тогда
			
			НоваяСтрока = ДеревоЖурнал.Строки.Добавить();
			НоваяСтрока.Ссылка = Стр.Ссылка;
			НоваяСтрока.ПредставлениеОбъектаМетаданных = Стр.ПредставлениеОбъектаМетаданных;
						
			НоваяСтрокаПодч = НоваяСтрока.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПодч, Стр);
			
		Иначе
			
			НоваяСтрока = Найд.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЖурнал, "ДеревоЖурналВыгрузкиЗагрузки");
	
КонецПроцедуры

&НаКлиенте
Процедура ЖурналВыгрузкиЗагрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбСтрока = ЖурналВыгрузкиЗагрузки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ЖурналВыгрузкиЗагрузкиСообщение" И ЗначениеЗаполнено(ВыбСтрока.Ссылка) Тогда		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ВыбСтрока.Ссылка);					
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЖурналВыгрузкиЗагрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбСтрока = ДеревоЖурналВыгрузкиЗагрузки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ДеревоЖурналВыгрузкиЗагрузкиСсылка" И ЗначениеЗаполнено(ВыбСтрока.Ссылка) Тогда		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ВыбСтрока.Ссылка);					
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СправочникНеВыгружать(ИмяСправочника)
	
	Если ИмяСправочника = "КонтурЛогистика_Настройки"
		Или ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииСправочников"
		Или ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииДокументов"
		Или ИмяСправочника = "КонтурЛогистика_НастройкиКонвертацииРегистровСведений"
		Или ИмяСправочника = "КонтурЛогистика_ФайлыОбмена"
		Или ИмяСправочника = "КонтурЛогистика_СценарииАвтоматическойРаботы"
		Или ИмяСправочника = "КонтурЛогистика_СтраныМира"
		Или ИмяСправочника = "КонтурЛогистика_СостоянияДвиженияДокументооборота"
		Или ИмяСправочника = "КонтурЛогистика_СертификатыЭлектроннойПодписи"
		Или ИмяСправочника = "КонтурЛогистика_ОписанияОпасныхГрузов"
		Или ИмяСправочника = "КонтурЛогистика_МЧД"
		Или ИмяСправочника = "КонтурЛогистика_КлассификаторПолномочийМЧД"
		Или ИмяСправочника = "КонтурЛогистика_КлассификаторУпаковок" Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УбратьВсеОбъектыЛогистики()
	
	ЕстьВсеОбъекты = Ложь;
	Для каждого Стр Из НастройкиВыгрузки Цикл
		
		Если Не Стр.ЭтоНастройка Тогда
			ЕстьВсеОбъекты = Истина;	
		КонецЕсли;
			
	КонецЦикла;                     
	
	Если Не ЕстьВсеОбъекты Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ЭтоНастройка", Истина);
	НастройкиВыгрузкиОтбор = НастройкиВыгрузки.Выгрузить(Отбор);
	ОбъектыДляВыгрузкиОтбор = ОбъектыДляВыгрузки.Выгрузить(Отбор);
	
	НастройкиВыгрузки.Очистить();
	ОбъектыДляВыгрузки.Очистить();
	
	НастройкиВыгрузки.Загрузить(НастройкиВыгрузкиОтбор);
	ОбъектыДляВыгрузки.Загрузить(ОбъектыДляВыгрузкиОтбор);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВсеОбъектыЛогистики()
	
	Для каждого Спр Из Метаданные.Справочники Цикл
			
		Если Лев(Спр.Имя, 15) = "УчетнаяСистема_" Или СправочникНеВыгружать(Спр.Имя) Тогда
			Продолжить;			
		КонецЕсли;
		
		ДобавитьНастройкуВыгрузки(Спр.Имя);
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкуВыгрузки(ИмяОбъектаКонфигурации, ЭтоНастройка = Ложь)
	
	Если ИмяОбъектаКонфигурации = "Константы" Тогда
		
		НоваяСтрока = НастройкиВыгрузки.Добавить();
		НоваяСтрока.Выгружать = Ложь;
		НоваяСтрока.Наименование = ИмяОбъектаКонфигурации;
		НоваяСтрока.ИмяОбъектаМетаданных = ИмяОбъектаКонфигурации;
		НоваяСтрока.ПредставлениеОбъектаМетаданных = ИмяОбъектаКонфигурации;
		НоваяСтрока.ЭтоНастройка = ЭтоНастройка;
		
		Для каждого Константа Из Константы Цикл
			
			Значение = Константа.Получить();
			Если ТипЗнч(Значение) <> Тип("Булево") Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектМетаданных = Константа.СоздатьМенеджерЗначения().Метаданные();
			
			НоваяСтрока = ОбъектыДляВыгрузки.Добавить();
			НоваяСтрока.Выгружать = Ложь;
			НоваяСтрока.Наименование = ОбъектМетаданных.Синоним;
			НоваяСтрока.Ссылка = ОбъектМетаданных.Имя;
			НоваяСтрока.ИмяОбъектаМетаданных = ИмяОбъектаКонфигурации;
			НоваяСтрока.ПредставлениеОбъектаМетаданных = ИмяОбъектаКонфигурации;
			НоваяСтрока.ЭтоНастройка = ЭтоНастройка;
					
		КонецЦикла;
		
	Иначе
	
		ОбъектМетаданных = Метаданные.Справочники.Найти(ИмяОбъектаКонфигурации);
	
		Если ОбъектМетаданных = Неопределено Тогда
			Возврат;	
		КонецЕсли;
		
		НоваяСтрока = НастройкиВыгрузки.Добавить();
		НоваяСтрока.Выгружать = Ложь;
		НоваяСтрока.Наименование = ОбъектМетаданных.Синоним;
		НоваяСтрока.ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
		НоваяСтрока.ПредставлениеОбъектаМетаданных = ОбъектМетаданных.Синоним;
		НоваяСтрока.ЭтоНастройка = ЭтоНастройка;
		
		Выборка = Справочники[ИмяОбъектаКонфигурации].Выбрать();	
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.КонтурЛогистика_Настройки") 
				И Выборка.ИмяПредопределенногоДляРасширения = "ПараметрыБлокировки_СтрокаСоединения" Тогда
				Продолжить;
			КонецЕсли;
			
			Путь = "";
			Если ИмяОбъектаКонфигурации = "КонтурЛогистика_НастройкиДополнительныхРеквизитов" Тогда
				Если Выборка.Ссылка.ЭтоГруппа Тогда
					Продолжить;
				Иначе
					Путь = " " + "(" + КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьПутьОтРодителяКЭлементу(Выборка.Ссылка) + ")";
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока = ОбъектыДляВыгрузки.Добавить();
			НоваяСтрока.Выгружать = Ложь;
			НоваяСтрока.Наименование = Выборка.Ссылка.Наименование + Путь;
			НоваяСтрока.Ссылка = Выборка.Ссылка;
			НоваяСтрока.ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
			НоваяСтрока.ПредставлениеОбъектаМетаданных = ОбъектМетаданных.Синоним;
			НоваяСтрока.ЭтоНастройка = ЭтоНастройка;
					
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьКонстанты()
	
	Для каждого Константа Из Константы Цикл
		Возврат Истина;	
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область ПредставлениеMarkdown

&НаКлиенте
Процедура ПоказатьВТекстовомФормате(Команда)
	
	ТекстовоеПредставление = ТекстовоеПредставлениеНастроек();
	ПараметрыФормы = Новый Структура("ТекстовоеПредставление", ТекстовоеПредставление);
	
	Попытка
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Обработка.КонтурЛогистика_ВыгрузкаЗагрузкаНастроекВерсия2.Форма.ФормаПредпросмотр",
			ПараметрыФормы, ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"ВнешняяОбработка.КонтурЛогистика_ВыгрузкаЗагрузкаНастроекВерсия2.Форма.ФормаПредпросмотр",
			ПараметрыФормы, ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ТекстовоеПредставлениеНастроек()
	
	ИтоговыйРезультат = "";
	
	ДобавитьПредставлениеНастроек(ИтоговыйРезультат);
	
	ДобавитьПредставлениеНастроекКонвертацииСправочников(ИтоговыйРезультат);
	
	ДобавитьПредставлениеНастроекКонвертацииДокументов(ИтоговыйРезультат);
	
	ДобавитьПредставлениеНастроекКонвертацииРегистровСведений(ИтоговыйРезультат);
	
	ДобавитьПредставлениеСценариевАвтоматическойРаботы(ИтоговыйРезультат);
	
	Возврат СокрЛП(ИтоговыйРезультат);
	
КонецФункции

&НаСервере
Процедура ДобавитьПредставлениеНастроек(ИтоговыйРезультат)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Выгружать", Истина);
	ПараметрыОтбора.Вставить("ИмяОбъектаМетаданных", "КонтурЛогистика_Настройки");
	
	НайденныеНастройки = ОбъектыДляВыгрузки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеНастройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Группировка - начало
	ИтоговыйРезультат = ИтоговыйРезультат + "<details><summary><b>Общие настройки</b></summary>";
	
	Для Каждого ТекущаяНастройка Из НайденныеНастройки Цикл
		
		Если ТекущаяНастройка.Ссылка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(),
			ТекущаяНастройка.Ссылка.Наименование, ПодготовитьТекст(Строка(ТекущаяНастройка.Ссылка.Значение)));
		
	КонецЦикла;
	
	// Группировка - окончание
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "</details>" + Символы.ПС + Символы.ПС;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПредставлениеНастроекКонвертацииСправочников(ИтоговыйРезультат)
	
	ЕстьКонвертироватьПоНастройке =
		(Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ТабличныеЧасти.ПравилаКонвертации.Реквизиты.Найти("КонвертироватьПоНастройке") <> Неопределено);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Выгружать", Истина);
	ПараметрыОтбора.Вставить("ИмяОбъектаМетаданных", "КонтурЛогистика_НастройкиКонвертацииСправочников");
	
	НайденныеНастройки = ОбъектыДляВыгрузки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеНастройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяНастройка Из НайденныеНастройки Цикл
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НастройкаКонвертацииСправочника", ТекущаяНастройка.Ссылка);
		Запрос.Текст = ТекстЗапросаДанныхНКС();
		
		Результат = Запрос.ВыполнитьПакет();
		
		ВыборкаОсновное = Результат[0].Выбрать();
		ВыборкаПравилаКонвертации = Результат[1].Выбрать();
		ВыборкаТаблицаСоответствий = Результат[2].Выбрать();
		
		// Группировка - начало
		ВыборкаОсновное.Следующий();
		ИтоговыйРезультат = ИтоговыйРезультат + "<details><summary><b>" + ВыборкаОсновное.Наименование + "</b></summary>";
		
		// Основное
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(),
			"Тип справочника или документа УС", ВыборкаОсновное.ТипСправочникаИлиДокументаУС);
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(),
			"Документ Логистика (Тип)", ВыборкаОсновное.ТипСправочникаЛогистика);
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(),
			"Документ Логистика (Тип)", ВыборкаОсновное.ТипДокументаОснования);
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(),
			"Реквизит титула", ВыборкаОсновное.РеквизитТитула);
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(),
			"Обновлять реквизиты из учетной системы", ВыборкаОсновное.ОбновлятьРеквизитыИзУчетнойСистемы);
		
		// ПравилаКонвертации
		Если Не Результат[1].Пустой() Тогда
			// Шапка таблицы
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС
				+ "| Реквизит | Способ маппинга | Выражение вычисления | Способ конвертации значения | Конвертировать по настройке |"
				+ ?(ВыборкаОсновное.ОбновлятьРеквизитыИзУчетнойСистемы, " Обновлять |", "");
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
				+ "| --- | --- | --- | --- | --- |" + ?(ВыборкаОсновное.ОбновлятьРеквизитыИзУчетнойСистемы, " --- |", "");
		КонецЕсли;
		Пока ВыборкаПравилаКонвертации.Следующий() Цикл
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
				+ ВыборкаПравилаКонвертации.РеквизитСправочникаЛогистикаПредставление + " | "
				+ ВыборкаПравилаКонвертации.СпособМаппинга + " | "
				+ ПодготовитьТекст(ВыборкаПравилаКонвертации.ВыражениеВычисления)
					+ ВыборкаПравилаКонвертации.КлючДопСвойстваРеквизита
					+ ПодготовитьТекст(ВыборкаПравилаКонвертации.ВыражениеВычисленияСтрокаНеогр) + " | "
				+ ВыборкаПравилаКонвертации.СпособКонвертацииЗначения + " | "
				+ ?(ЕстьКонвертироватьПоНастройке, ВыборкаПравилаКонвертации.КонвертироватьПоНастройке, "") + " | "
				+ ?(ВыборкаОсновное.ОбновлятьРеквизитыИзУчетнойСистемы, Строка(ВыборкаПравилаКонвертации.ОбновитьИзУчетнойСистемы) + " | ", "");
		КонецЦикла;
		
		// ТаблицаСоответствий
		Если Не Результат[2].Пустой() Тогда
			// Шапка таблицы
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС
				+ "| Реквизит | Извлеченное значение | Значение соответствия |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
				+ "| --- | --- | --- |";
		КонецЕсли;
		Пока ВыборкаТаблицаСоответствий.Следующий() Цикл
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
				+ ВыборкаТаблицаСоответствий.РеквизитСправочникаЛогистика + " | "
				+ ВыборкаТаблицаСоответствий.ИзвлеченноеЗначение + " | "
				+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ВыражениеВычисления) + " | ";
		КонецЦикла;
		
		// Группировка - окончание
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "</details>" + Символы.ПС + Символы.ПС;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПредставлениеНастроекКонвертацииДокументов(ИтоговыйРезультат)
	
	ЕстьОбратныйМаппинг =
		(Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.Найти("ЗаполнениеДокУчСист") <> Неопределено);
	ЕстьТаблицаСоответствий =
		(Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.Найти("ТаблицаСоответствий") <> Неопределено);
	ЕстьДополнительныеКолонки =
		(Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ТабличныеЧасти.Найти("ДополнительныеКолонки") <> Неопределено);
	ЕстьКонвертироватьПоНастройке =
		(Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ТабличныеЧасти.ПравилаКонвертации.Реквизиты.Найти("КонвертироватьПоНастройке") <> Неопределено);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Выгружать", Истина);
	ПараметрыОтбора.Вставить("ИмяОбъектаМетаданных", "КонтурЛогистика_НастройкиКонвертацииДокументов");
	
	НайденныеНастройки = ОбъектыДляВыгрузки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеНастройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяНастройка Из НайденныеНастройки Цикл
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НастройкиКонвертацииДокументов", ТекущаяНастройка.Ссылка);
		Запрос.Текст = ТекстЗапросаДанныхНКД(ЕстьОбратныйМаппинг, ЕстьТаблицаСоответствий, ЕстьДополнительныеКолонки);
		
		Результат = Запрос.ВыполнитьПакет();
		
		ВыборкаОсновное = Результат[0].Выбрать();
		ВыборкаПравилаКонвертацииГлавногоДокумента = Результат[1].Выбрать();
		ВыборкаПравилаКонвертацииТитулаРеквизиты = Результат[2].Выбрать();
		ВыборкаПравилаКонвертацииТитулаТабЧастьТовары = Результат[3].Выбрать();
		ВыборкаПравилаКонвертацииТитулаТабЧастьПроизвольная = Результат[4].Выбрать();
		ВыборкаПеременные = Результат[5].Выбрать();
		ВыборкаПроизвольныеВалидации = Результат[6].Выбрать();
		Если ЕстьОбратныйМаппинг Тогда
			ВыборкаЗаполнениеДокУчСист = Результат[7].Выбрать();
			ВыборкаЗаполнениеДокУчСистТЧТовары = Результат[8].Выбрать();
			ВыборкаЗаполнениеДокУчСистТЧПроизвольная = Результат[9].Выбрать();
			ВыборкаПеременныеДокУчСист = Результат[10].Выбрать();
		КонецЕсли;
		Если ЕстьТаблицаСоответствий Тогда
			ВыборкаТаблицаСоответствий = Результат[11].Выбрать();
		КонецЕсли;
		Если ЕстьДополнительныеКолонки Тогда
			ВыборкаДополнительныеКолонки = Результат[12].Выбрать();
		КонецЕсли;
		
		// Группировка - начало
		ВыборкаОсновное.Следующий();
		ИтоговыйРезультат = ИтоговыйРезультат + "<details><summary><b>" + ВыборкаОсновное.Наименование + "</b></summary>";
		
		// Основное
		ДобавитьОсновныеНастройкиНКД(ВыборкаОсновное, ИтоговыйРезультат);
		
		Если Не Результат[1].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Главный документ";
			ДобавитьПравилаКонвертацииРеквизитов(ВыборкаПравилаКонвертацииГлавногоДокумента, ИтоговыйРезультат, ЕстьКонвертироватьПоНастройке);
		КонецЕсли;
		
		Если Не Результат[2].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Титул (документ)";
			ДобавитьПравилаКонвертацииРеквизитов(ВыборкаПравилаКонвертацииТитулаРеквизиты, ИтоговыйРезультат, ЕстьКонвертироватьПоНастройке);
		КонецЕсли;
		
		Если Не Результат[3].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Таб. часть Товары";
			ДобавитьПравилаКонвертацииРеквизитов(ВыборкаПравилаКонвертацииТитулаТабЧастьТовары, ИтоговыйРезультат, ЕстьКонвертироватьПоНастройке);
		КонецЕсли;
		
		Если Не Результат[4].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Прочие таб. части";
			ЭтоПроизвольныеТабЧасти = Истина;
			ДобавитьПравилаКонвертацииРеквизитов(ВыборкаПравилаКонвертацииТитулаТабЧастьПроизвольная, ИтоговыйРезультат, ЕстьКонвертироватьПоНастройке, ЭтоПроизвольныеТабЧасти);
		КонецЕсли;
		
		Если Не Результат[5].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Переменные";
			ДобавитьПравилаКонвертацииПеременных(ВыборкаПеременные, ИтоговыйРезультат);
		КонецЕсли;
		
		// ПроизвольныеВалидации
		Если Не Результат[6].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Произвольные валидации";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| Текст валидации | Текст ошибки |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- | --- |";
			
			Пока ВыборкаПроизвольныеВалидации.Следующий() Цикл
				ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
					+ ПодготовитьТекст(ВыборкаПроизвольныеВалидации.ТекстВалидации) + " | "
					+ ПодготовитьТекст(ВыборкаПроизвольныеВалидации.ТекстОшибки) + " | "
			КонецЦикла;
		КонецЕсли;
		
		Если ЕстьОбратныйМаппинг И Не Результат[7].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ЗаполнениеДокУчСист", ВыборкаЗаполнениеДокУчСист, ИтоговыйРезультат);
		КонецЕсли;
		
		Если ЕстьОбратныйМаппинг И Не Результат[8].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист ТЧТовары";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ЗаполнениеДокУчСистТЧТовары", ВыборкаЗаполнениеДокУчСистТЧТовары, ИтоговыйРезультат);
		КонецЕсли;
		
		Если ЕстьОбратныйМаппинг И Не Результат[9].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист ТЧПроизвольная";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ЗаполнениеДокУчСистТЧПроизвольная", ВыборкаЗаполнениеДокУчСистТЧПроизвольная, ИтоговыйРезультат);
		КонецЕсли;
		
		Если ЕстьОбратныйМаппинг И Не Результат[10].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист Переменные";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ПеременныеДокУчСист", ВыборкаПеременныеДокУчСист, ИтоговыйРезультат);
		КонецЕсли;
		
		// ТаблицаСоответствий
		Если ЕстьТаблицаСоответствий И Не Результат[11].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Таблица соответствий";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| Имя таб. части | Реквизит | Извлеченное значение | Значение соответствия |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- | --- | --- | --- |";
			
			Пока ВыборкаТаблицаСоответствий.Следующий() Цикл
				ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ИмяТабличнойЧасти) + " | "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ИмяРеквизитаЗначения) + " | "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ИзвлеченноеЗначение) + " | "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ВыражениеВычисления) + " | "
			КонецЦикла;
		КонецЕсли;
		
		// ДополнительныеКолонки
		Если ЕстьДополнительныеКолонки И Не Результат[12].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Дополнительные колонки";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| Заголовок | Путь к данным |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- | --- |";
			
			Пока ВыборкаДополнительныеКолонки.Следующий() Цикл
				ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
					+ ПодготовитьТекст(ВыборкаДополнительныеКолонки.Заголовок) + " | "
					+ ПодготовитьТекст(ВыборкаДополнительныеКолонки.ПутьКДанным) + " | "
			КонецЦикла;
		КонецЕсли;
		
		// Группировка - окончание
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "</details>" + Символы.ПС + Символы.ПС;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПредставлениеНастроекКонвертацииРегистровСведений(ИтоговыйРезультат)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Выгружать", Истина);
	ПараметрыОтбора.Вставить("ИмяОбъектаМетаданных", "КонтурЛогистика_НастройкиКонвертацииРегистровСведений");
	
	НайденныеНастройки = ОбъектыДляВыгрузки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеНастройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяНастройка Из НайденныеНастройки Цикл
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НастройкиКонвертацииРегистровСведений", ТекущаяНастройка.Ссылка);
		Запрос.Текст = ТекстЗапросаДанныхНКРС();
		
		Результат = Запрос.ВыполнитьПакет();
		
		ВыборкаОсновное = Результат[0].Выбрать();
		ВыборкаТриггерСтатусыДО = Результат[1].Выбрать();
		ВыборкаПравилаКонвертации = Результат[2].Выбрать();
		ВыборкаТаблицаСоответствий = Результат[3].Выбрать();
		ВыборкаПеременные = Результат[4].Выбрать();
		ВыборкаЗаполнениеДокУчСист = Результат[5].Выбрать();
		ВыборкаЗаполнениеДокУчСистТЧ = Результат[6].Выбрать();
		ВыборкаПеременныеДокУчСист = Результат[7].Выбрать();
		
		// Группировка - начало
		ВыборкаОсновное.Следующий();
		ИтоговыйРезультат = ИтоговыйРезультат + "<details><summary><b>" + ВыборкаОсновное.Наименование + "</b></summary>";
		
		// Основное
		ДобавитьОсновныеНастройкиНКРС(ВыборкаОсновное, ИтоговыйРезультат);
		
		Если Не Результат[1].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Триггер статусы ДО";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| Статус ДО |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- |";
			
			Пока ВыборкаТриггерСтатусыДО.Следующий() Цикл
				ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
					+ ПодготовитьТекст(ВыборкаТриггерСтатусыДО.СтатусДО) + " | "
			КонецЦикла;
		КонецЕсли;
		
		Если Не Результат[2].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Правила конвертации";
			ДобавитьПравилаКонвертации(ВыборкаПравилаКонвертации, ИтоговыйРезультат);
		КонецЕсли;
		
		// ТаблицаСоответствий
		Если Не Результат[3].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Таблица соответствий";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| Реквизит | Извлеченное значение | Значение соответствия |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- | --- | --- |";
			
			Пока ВыборкаТаблицаСоответствий.Следующий() Цикл
				ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.РеквизитРегистраСведений) + " | "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ИзвлеченноеЗначение) + " | "
					+ ПодготовитьТекст(ВыборкаТаблицаСоответствий.ВыражениеВычисления) + " | "
			КонецЦикла;
		КонецЕсли;
		
		Если Не Результат[4].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Переменные";
			ДобавитьПравилаКонвертацииПеременных(ВыборкаПеременные, ИтоговыйРезультат);
		КонецЕсли;
		
		Если Не Результат[5].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ЗаполнениеДокУчСист", ВыборкаЗаполнениеДокУчСист, ИтоговыйРезультат);
		КонецЕсли;
		
		Если Не Результат[6].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист ТЧ";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ЗаполнениеДокУчСистТЧ", ВыборкаЗаполнениеДокУчСистТЧ, ИтоговыйРезультат);
		КонецЕсли;
		
		Если Не Результат[7].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Заполнение док уч сист Переменные";
			ДобавитьПравилаКонвертацииРеквизитовДокУчСист(
				"ПеременныеДокУчСист", ВыборкаПеременныеДокУчСист, ИтоговыйРезультат);
		КонецЕсли;
		
		// Группировка - окончание
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "</details>" + Символы.ПС + Символы.ПС;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОсновныеНастройкиНКД(ВыборкаОсновное, ИтоговыйРезультат)
	
	Для Каждого ТекущийРеквизит Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.Реквизиты Цикл
		
		Попытка
			ЗначениеРеквизита = ВыборкаОсновное[ТекущийРеквизит.Имя];
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(), ТекущийРеквизит.Синоним, ПодготовитьТекст(ЗначениеРеквизита));
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОсновныеНастройкиНКРС(ВыборкаОсновное, ИтоговыйРезультат)
	
	Для Каждого ТекущийРеквизит Из Метаданные.Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.Реквизиты Цикл
		
		Попытка
			ЗначениеРеквизита = ВыборкаОсновное[ТекущийРеквизит.Имя];
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(), ТекущийРеквизит.Синоним, ПодготовитьТекст(ЗначениеРеквизита));
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилаКонвертацииРеквизитов(Выборка, ИтоговыйРезультат, ЕстьКонвертироватьПоНастройке, ЭтоПроизвольныеТабЧасти = Ложь)
	
	// Шапка таблицы
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
		+ ?(ЭтоПроизвольныеТабЧасти, "| Имя ТЧТитула ", "")
		+ "| Реквизит | Способ маппинга | Выражение вычисления | Способ конвертации значения | Конвертировать по настройке |";
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
		+ ?(ЭтоПроизвольныеТабЧасти, "| --- ", "")
		+ "| --- | --- | --- | --- | --- |";
	
	Пока Выборка.Следующий() Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
			+ ?(ЭтоПроизвольныеТабЧасти, ПодготовитьТекст(Выборка.ИмяТЧТитула) + " | ", "")
			+ Выборка.РеквизитТитула + " | "
			+ Выборка.СпособМаппинга + " | "
			+ ПодготовитьТекст(Выборка.ВыражениеВычисления)
				+ ПодготовитьТекст(Выборка.КлючДопСвойстваРеквизита)
				+ ПодготовитьТекст(Выборка.ВыражениеВычисления2)
				+ ПодготовитьТекст(Выборка.ВыражениеВычисленияСтрокаНеогр) + " | "
			+ Выборка.СпособКонвертацииЗначения + " | "
			+ ?(ЕстьКонвертироватьПоНастройке, Выборка.КонвертироватьПоНастройке, "") + " | ";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилаКонвертации(Выборка, ИтоговыйРезультат)
	
	// Шапка таблицы
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
		+ "| Реквизит | Способ маппинга | Выражение вычисления | Способ конвертации значения | Конвертировать по настройке |";
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
		+ "| --- | --- | --- | --- | --- |";
	
	Пока Выборка.Следующий() Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
			+ Выборка.РеквизитРегистраСведений + " | "
			+ Выборка.СпособМаппинга + " | "
			+ ПодготовитьТекст(Выборка.ВыражениеВычисления)
				+ ПодготовитьТекст(Выборка.КлючДопСвойстваРеквизита)
				+ ПодготовитьТекст(Выборка.ВыражениеВычисления2)
				+ ПодготовитьТекст(Выборка.ВыражениеВычисленияСтрокаНеогр) + " | "
			+ Выборка.СпособКонвертацииЗначения + " | "
			+ Выборка.КонвертироватьПоНастройке + " | ";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилаКонвертацииПеременных(Выборка, ИтоговыйРезультат)
	
	// Шапка таблицы
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
		+ "| Имя | Для Таб. части | Способ маппинга | Выражение вычисления | Способ конвертации значения | Конвертировать по настройке |";
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС
		+ "| --- | --- | --- | --- | --- | --- |";
	
	Пока Выборка.Следующий() Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
			+ ПодготовитьТекст(Выборка.Имя) + " | "
			+ ПодготовитьТекст(Выборка.ИмяТабЧасти) + " | "
			+ Выборка.СпособМаппинга + " | "
			+ ПодготовитьТекст(Выборка.ВыражениеВычисления)
				+ ПодготовитьТекст(Выборка.ВыражениеВычисления2)
				+ ПодготовитьТекст(Выборка.КлючДопСвойстваРеквизита)
				+ ПодготовитьТекст(Выборка.ВыражениеВычисленияСтрокаНеогр) + " | "
			+ Выборка.СпособКонвертацииЗначения + " | "
			+ Выборка.КонвертироватьПоНастройке + " | ";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилаКонвертацииРеквизитовДокУчСист(ИмяТЧ, Выборка, ИтоговыйРезультат)
	
	РеквизитыТЧ = Новый Соответствие;
	
	Если ИмяТЧ = "ЗаполнениеДокУчСист" Тогда
		РеквизитыТЧ.Вставить("ТипАлгоритма", "Тип алгоритма");
	КонецЕсли;
	
	Если ИмяТЧ = "ЗаполнениеДокУчСистТЧТовары" Или ИмяТЧ = "ЗаполнениеДокУчСистТЧПроизвольная" Тогда
		РеквизитыТЧ.Вставить("ИмяТЧ", "Имя таб. чати");
	ИначеЕсли ИмяТЧ = "ПеременныеДокУчСист" Тогда
		РеквизитыТЧ.Вставить("ИмяТабЧасти", "Имя таб. чати");
	КонецЕсли;
	
	Если ИмяТЧ = "ПеременныеДокУчСист" Тогда
		РеквизитыТЧ.Вставить("Имя", "Имя");
	Иначе
		РеквизитыТЧ.Вставить("Реквизит", "Реквизит");
	КонецЕсли;
	
	РеквизитыТЧ.Вставить("СпособРасчета", "Способ расчета");
	
	Если ИмяТЧ = "ЗаполнениеДокУчСистТЧПроизвольная" Тогда
		РеквизитыТЧ.Вставить("ПутьТЧИсходногоДокумента", "ТЧ исходного док");
	КонецЕсли;
	
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| ";
	Для Каждого ТекущийРеквизит Из РеквизитыТЧ Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + ПодготовитьТекст(ТекущийРеквизит.Значение) + " | ";
	КонецЦикла;
	ИтоговыйРезультат = ИтоговыйРезультат + "Выражение вычисления |";
	
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| ";
	Для Каждого ТекущийРеквизит Из РеквизитыТЧ Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + "--- | ";
	КонецЦикла;
	ИтоговыйРезультат = ИтоговыйРезультат + "--- |";
	
	Пока Выборка.Следующий() Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| ";
		
		Для Каждого ТекущийРеквизит Из РеквизитыТЧ Цикл
			ИтоговыйРезультат = ИтоговыйРезультат + Выборка[ТекущийРеквизит.Ключ] + " | ";
		КонецЦикла;
		
		ИтоговыйРезультат = ИтоговыйРезультат
			+ ПодготовитьТекст(Выборка.ВыражениеВычисления)
			+ ПодготовитьТекст(Выборка.ВыражениеВычисленияСтрокаНеогр) + " |";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПредставлениеСценариевАвтоматическойРаботы(ИтоговыйРезультат)
	
	ЕстьИнтервалыАктивности =
		(Метаданные.Справочники.КонтурЛогистика_СценарииАвтоматическойРаботы.ТабличныеЧасти.Найти("ИнтервалыАктивности") <> Неопределено);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Выгружать", Истина);
	ПараметрыОтбора.Вставить("ИмяОбъектаМетаданных", "КонтурЛогистика_СценарииАвтоматическойРаботы");
	
	НайденныеНастройки = ОбъектыДляВыгрузки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеНастройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяНастройка Из НайденныеНастройки Цикл
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СценарийАвтоматическойРаботы", ТекущаяНастройка.Ссылка);
		Запрос.Текст = ТекстЗапросаДанныхСценарииАвтоматическойРаботы(ЕстьИнтервалыАктивности);
		
		Результат = Запрос.ВыполнитьПакет();
		
		ВыборкаОсновное = Результат[0].Выбрать();
		ВыборкаСписокГрузоотправителейДиадок = Результат[1].Выбрать();
		ВыборкаСписокПеревозчиковДиадок = Результат[2].Выбрать();
		ВыборкаСписокГрузополучателейДиадок = Результат[3].Выбрать();
		ВыборкаСписокПунктовМаршрутаОтправки = Результат[4].Выбрать();
		ВыборкаСписокПунктовМаршрутаПрибытия = Результат[5].Выбрать();
		ВыборкаСписокСостоянийДокументооборота = Результат[6].Выбрать();
		Если ЕстьИнтервалыАктивности Тогда
			ВыборкаИнтервалыАктивности = Результат[7].Выбрать();
		КонецЕсли;
		
		// Группировка - начало
		ВыборкаОсновное.Следующий();
		ИтоговыйРезультат = ИтоговыйРезультат + "<details><summary><b>Сценарий автоматической обработки - " + ВыборкаОсновное.Наименование + "</b></summary>";
		
		// Основное
		ДобавитьОсновныеНастройкиСценарииАвтоматическойРаботы(ВыборкаОсновное, ИтоговыйРезультат);
		
		Если Не Результат[1].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Список грузоотправителей диадок";
			ДобавитьОдномернуюТаблицу(ВыборкаСписокГрузоотправителейДиадок, ИтоговыйРезультат, "ОрганизацияДиадок");
		КонецЕсли;
		
		Если Не Результат[2].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Список перевозчиков диадок";
			ДобавитьОдномернуюТаблицу(ВыборкаСписокПеревозчиковДиадок, ИтоговыйРезультат, "ОрганизацияДиадок");
		КонецЕсли;
		
		Если Не Результат[3].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Список грузополучателей диадок";
			ДобавитьОдномернуюТаблицу(ВыборкаСписокГрузополучателейДиадок, ИтоговыйРезультат, "ОрганизацияДиадок");
		КонецЕсли;
		
		Если Не Результат[4].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Список пунктов маршрута отправки";
			ДобавитьОдномернуюТаблицу(ВыборкаСписокПунктовМаршрутаОтправки, ИтоговыйРезультат, "ПунктМаршрута");
		КонецЕсли;
		
		Если Не Результат[5].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Список пунктов маршрута прибытия";
			ДобавитьОдномернуюТаблицу(ВыборкаСписокПунктовМаршрутаПрибытия, ИтоговыйРезультат, "ПунктМаршрута");
		КонецЕсли;
		
		Если Не Результат[6].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Список состояний документооборота";
			ДобавитьОдномернуюТаблицу(ВыборкаСписокСостоянийДокументооборота, ИтоговыйРезультат, "Состояние");
		КонецЕсли;
		
		// ИнтервалыАктивности
		Если ЕстьИнтервалыАктивности И Не Результат[7].Пустой() Тогда
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "Интервалы активности";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| Время С | Время по | ПН | ВТ | СР | ЧТ | ПТ | СБ | ВС |";
			ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- | --- | --- | --- | --- | --- | --- | --- | --- |";
			
			Пока ВыборкаИнтервалыАктивности.Следующий() Цикл
				ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| "
					+ Строка(ВыборкаИнтервалыАктивности.ВремяС) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.ВремяПо) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.ПН) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.ВТ) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.СР) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.ЧТ) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.ПТ) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.СБ) + " | "
					+ Строка(ВыборкаИнтервалыАктивности.ВС) + " | "
			КонецЦикла;
		КонецЕсли;
		
		// Группировка - окончание
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + Символы.ПС + "</details>" + Символы.ПС + Символы.ПС;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОдномернуюТаблицу(Выборка, ИтоговыйРезультат, ИмяРеквизитаТаблицы)
	
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| " + ИмяРеквизитаТаблицы + " |";
	ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| --- |";
	
	Пока Выборка.Следующий() Цикл
		ИтоговыйРезультат = ИтоговыйРезультат + Символы.ПС + "| " + Строка(Выборка[ИмяРеквизитаТаблицы]) + " |";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОсновныеНастройкиСценарииАвтоматическойРаботы(ВыборкаОсновное, ИтоговыйРезультат)
	
	Для Каждого ТекущийРеквизит Из Метаданные.Справочники.КонтурЛогистика_СценарииАвтоматическойРаботы.Реквизиты Цикл
		
		Попытка
			ЗначениеРеквизита = ВыборкаОсновное[ТекущийРеквизит.Имя];
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуПоШаблону(ИтоговыйРезультат, ШаблонОписанияРеквизита(), ТекущийРеквизит.Синоним, ПодготовитьТекст(ЗначениеРеквизита));
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
