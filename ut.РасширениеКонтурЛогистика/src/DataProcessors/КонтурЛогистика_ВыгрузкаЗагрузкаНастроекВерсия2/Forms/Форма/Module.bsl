&НаСервере
Функция ПодготовитьТекст(Текст)
	
	Результат = ЭкранироватьСимволы(Текст);
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br/>");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭкранироватьСимволы(Текст)
	
	Результат = СтрЗаменить(Текст, "\", "\\");
	Результат = СтрЗаменить(Результат, "`", "\`");
	Результат = СтрЗаменить(Результат, "*", "\*");
	Результат = СтрЗаменить(Результат, "<", "\<");
	Результат = СтрЗаменить(Результат, ">", "\>");
	Результат = СтрЗаменить(Результат, "|", "\|");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуПоШаблону(Результат, ШаблонСтроки, Значение1, Значение2)
	
	Если Не ЗначениеЗаполнено(Значение2) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Результат + Символы.ПС + Символы.ПС
		+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(ШаблонСтроки, Значение1, Значение2);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ШаблонОписанияРеквизита()
	
	Возврат "*%1:* %2";
	
КонецФункции

