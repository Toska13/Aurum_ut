&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КлючОшибки = Параметры.КлючОшибки;
	
	Заголовок = "Сопроводительная ведомость " + Объект.НомерСВ + " от " + Объект.ДатаСВ;
	
	СтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Объект.Ссылка);
	СвязанныеДокументыТитулы.Параметры.УстановитьЗначениеПараметра("ДокументСВ", Объект.Ссылка);
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РассчитатьОформлениеЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОформлениеЭлементов()

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	СвязанныеДокументыТитулы.Параметры.УстановитьЗначениеПараметра("ДокументСВ", Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДокументыТитулыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекКолонка = Поле;
		ИмяКолонки = ТекКолонка.Имя;
		
		Если ИмяКолонки = "СвязанныеДокументыТитулыСсылка" ИЛИ ИмяКолонки = "СвязанныеДокументыТитулыТипТитула" Тогда 
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			ТекущиеДанные.Ссылка);
			
		ИначеЕсли ИмяКолонки = "СвязанныеДокументыТитулыДокументОснование" Тогда 
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			ТекущиеДанные.ДокументОснование);
			
		ИначеЕсли ИмяКолонки = "СвязанныеДокументыТитулыФайлОбмена" Тогда 
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			ТекущиеДанные.ФайлОбмена);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры