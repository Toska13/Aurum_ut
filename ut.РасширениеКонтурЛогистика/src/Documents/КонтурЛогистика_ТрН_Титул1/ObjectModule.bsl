	ОтметкиГрузоотправителя.Очистить();
	Акты.Очистить();
	Штрафы.Очистить();
	СпецУслДвиж.Очистить();
	ДополнительныеПолучателиФайла.Очистить();
	СопроводительныеДокументы.Очистить();
