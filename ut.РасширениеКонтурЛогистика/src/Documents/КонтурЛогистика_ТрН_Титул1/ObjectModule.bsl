#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ДокументЭТРН.kl_id)) Тогда // еще не зарегистрированный в сервисе
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЭТРН.ЗаказЗаявкаОснование) Тогда
		СтатусЗЗ = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ДокументЭТРН.ЗаказЗаявкаОснование);
		
		Если СтатусЗЗ = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("zz-wait-enterBasedOnConsignor") 
			ИЛИ СтатусЗЗ = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("zz-completed")  Тогда
			
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ДокументЭТРН.ЗаказЗаявкаОснование, "zz-enterBasedOnConsignorAfter",,, Перечисления.КонтурЛогистика_СтороныСоставители.ГО);
				
		КонецЕсли;
			
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ = Ложь
		И Не ЗначениеЗаполнено(СокрЛП(ДокументЭТРН.kl_id)) // еще не зарегистрированный в сервисе
		И Не ЗначениеЗаполнено(ДокументЭТРН.УИД)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоВходящийДокумент(ДополнительныеСвойства) 
		И ЗначениеЗаполнено(ДокументЭТРН.Грузоотправитель) 
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
		И ЗначениеЗаполнено(ДокументЭТРН.Грузополучатель) Тогда
		
		Организация = КонтурЛогистика_ОбщегоНазначенияСервер.ОрганизацияДляЗапросаУИДов(ЭтотОбъект);
		
		БратьУИДИзПула = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляТРН");
		
		Если БратьУИДИзПула Тогда
			
			ПолученныйУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ПолучитьОчередной(Организация);
			Если ПолученныйУИД <> Неопределено Тогда
				ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация);
			Иначе
				Сообщить("Не получен УИД из пула. Закончились?");
			КонецЕсли;
						
		Иначе
			
			// Ничего не делаем.
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ТрН_Титул1_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// При вызове обработчика заполнения в обычных формах
	// в данных заполнения содержится ссылка на документ основание
	// если ДанныеЗаполнения - ссылка одного из типов ДокументаОснование
	// преобразуем ДанныеЗаполнения к структуре
	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1");
	КонтурЛогистика_ОбработкаДокументовСервер.ПреобразоватьДанныеЗаполненияДляУчетныхДокументов(ДанныеЗаполнения,
		ТипЛогистика);
	
	// а) Из документа учетной системы
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// б) загружен и з сервиса, создаем из файла обмена
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);	
		
	// в) ввод на основании Заказа (заявки)
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		
		// TODO реализовать
		ЗаполнитьПоДокЗаказЗаявка(ДанныеЗаполнения);		
		ЗаполнитьРеквизитыПоПользователю();	
		
	// г) копирование Т1 с ЭТРН
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Титул")
		И ДанныеЗаполнения.Свойство("Скопировать")
		И ДанныеЗаполнения.Скопировать Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Титул);
		Для каждого ТЧ Из ЭтотОбъект.Метаданные().ТабличныеЧасти Цикл
			Для каждого Стр Из ДанныеЗаполнения.Титул[ТЧ.Имя] Цикл
				НоваяСтрока = ЭтотОбъект[ТЧ.Имя].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		КонецЦикла;
		
		ЭтотОбъект.Номер = "";
		ЭтотОбъект.Дата = ТекущаяДатаСеанса();
		
		НовыйДокументЭТРН = ДанныеЗаполнения.Титул.ДокументЭТРН.Скопировать();
		
		НовыйДокументЭТРН.Дата = ТекущаяДатаСеанса();
		НовыйДокументЭТРН.ДатаТрН = ТекущаяДатаСеанса();
		НовыйДокументЭТРН.УИД = "";
		НовыйДокументЭТРН.kl_id = "";
		НовыйДокументЭТРН.ХешСуммаQRКода = 0;
		КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьНомерКопииКНомеруДокумента(НовыйДокументЭТРН.НомерТрН, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		
		НовыйДокументЭТРН.Записать();
		
		ЭтотОбъект.ДокументЭТРН = НовыйДокументЭТРН.Ссылка;		
		
	// д) ручной ввод Т1 с нуля
	Иначе
		
		Если ДанныеЗаполнения <> Неопределено 
			И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
			И ДанныеЗаполнения.Свойство("ДокументЭТРН") 
			И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументЭТРН) Тогда
			
			ДокументЭТРН = ДанныеЗаполнения.ДокументЭТРН;
			
		КонецЕсли;
		
		НастройкаКонвертацииСНуля = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		Если ЗначениеЗаполнено(НастройкаКонвертацииСНуля) Тогда 
			ЗаполнитьДефолтыРучногоЗаполненияПоНастройкеКонвертации(НастройкаКонвертацииСНуля);
		КонецЕсли;
		
		МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");		
		ЗаполнитьРеквизитыПоПользователю();
		
	КонецЕсли;
	
	ЗаполнитьПустыеЗначенияПоУмолчанию();
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ТрН_Титул1_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
	
	// Расчет особенности
	РасчетОсобенностейДокументооборота();
	
КонецПроцедуры

Процедура ЗаполнитьПустыеЗначенияПоУмолчанию()

	ЗаполнитьТелефонПереадресацииПоУмолчанию();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДата();
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из док Основания

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	Перем ДокументЭТрНОбъект, НайденныйЭТрН, НастройкаКонвертации, ТЗ_ТоварыВременная;
	
	Разделитель = Неопределено;
	ЭлектроннаяЗаказЗаявкаОснование = Неопределено;
	
	ДанныеЗаполнения.Свойство("Разделитель", Разделитель);
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	// могли быть переданы конкретные N документов оснований а не 1
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") Тогда 
		Если ДанныеЗаполнения.Свойство("ДокументыОснования") 
			И ТипЗнч(ДанныеЗаполнения.ДокументыОснования) = Тип("Массив") Тогда
			Для Каждого ДопДокОснование Из ДанныеЗаполнения.ДокументыОснования Цикл 
				НовСтр = ДокументыОснования.Добавить();
				НовСтр.ДокументОснование = ДопДокОснование;
			КонецЦикла;
		Иначе
			НовСтр = ДокументыОснования.Добавить();
			НовСтр.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
		КонецЕсли;
	Иначе
		НовСтр = ДокументыОснования.Добавить();
		НовСтр.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	КонецЕсли;
	ДокументыОснования.Свернуть("ДокументОснование");
	
	ОчиститьТабЧасти();
	
	// определим настройку конвертации
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
								ДанныеЗаполнения.ТипЛогистика, 
								ДанныеЗаполнения.ДокументОснование);
								
	// особенности при вводе из заказа-заявки							
	// настройка конвертации на том же документе основании что и для ЗЗт1?							
	Если НастройкаКонвертации = Неопределено Тогда
									
		Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
		 И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование.ДокументОснование) Тогда
		 
		    ЭлектроннаяЗаказЗаявкаОснование = ДанныеЗаполнения.ДокументОснование;
			НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
									ДанныеЗаполнения.ТипЛогистика, 
									ДанныеЗаполнения.ДокументОснование.ДокументОснование);
									
		ИначеЕсли ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2")
		 И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование.ДокументОснование) Тогда
										
		    ЭлектроннаяЗаказЗаявкаОснование = ДанныеЗаполнения.ДокументОснование.Титул1;
			НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
									ДанныеЗаполнения.ТипЛогистика, 
									ДанныеЗаполнения.ДокументОснование.Титул1.ДокументОснование);
		КонецЕсли;
								
		Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
										
			ДокументОснование = ДанныеЗаполнения.ДокументОснование.ДокументОснование;
			Для Каждого СтрДокОсн Из ДокументыОснования Цикл 
				 СтрДокОсн.ДокументОснование = СтрДокОсн.ДокументОснование.ДокументОснование;
			 КонецЦикла;
			 
		 Иначе
			 
			Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				 Или ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда 
 
				ЗаполнитьПоДокЗаказЗаявка(ДанныеЗаполнения.ДокументОснование);
			Иначе
				Сообщить("Не найдена настройка конвертации по " + ДанныеЗаполнения.ДокументОснование + ". Проверьте настройки конвертации документов");
			КонецЕсли;
			
			ЗаполнитьРеквизитыПоПользователю();
			
		КонецЕсли;
		
	Иначе
		
		// поискать Эл Заказ Заявку с тем же основанием
		НайденныеЗаказЗаявки = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитулыПоДокументуОснованию(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, ДанныеЗаполнения.ДокументОснование); 
		Если НайденныеЗаказЗаявки.Количество() > 0 Тогда 
		    ЭлектроннаяЗаказЗаявкаОснование = НайденныеЗаказЗаявки[0];
		КонецЕсли;
		
	КонецЕсли;
								
	Если НастройкаКонвертации = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
								
	Если ЗначениеЗаполнено(НастройкаКонвертации)
		И ЗначениеЗаполнено(НастройкаКонвертации.ПоискОснованийКодНа1С)
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") Тогда 
		
		//вычислить массив оснований
		Попытка
			МассивДокументыОснования = Новый Массив;
			Выполнить(НастройкаКонвертации.ПоискОснованийКодНа1С);
			Для Каждого ДопДокОснование Из МассивДокументыОснования Цикл 
				НовСтр = ДокументыОснования.Добавить();
				НовСтр.ДокументОснование = ДопДокОснование;
			КонецЦикла;
			
			ДокументыОснования.Свернуть("ДокументОснование");
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(ЭтотОбъект, ДокументОснование, НастройкаКонвертации, "");
	
	// ДокументЭТрН потребуется создать(найти) и записать в базу если он еще не указан в титуле.
	Если ЗначениеЗаполнено(ДокументЭТРН) Тогда 
		НайденныйЭТрН = ДокументЭТРН;
	Иначе
		НайденныйЭТрН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрН(ДокументОснование, НастройкаКонвертации, Разделитель, ЭтотОбъект, Переменные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйЭТрН) Тогда 
		
		ДокументЭТрНОбъект = НайденныйЭТрН.ПолучитьОбъект();
		
		// перезаполним ЭТРН если взведен флаг
		Если ДанныеЗаполнения.Свойство("ПерезаполнитьГлавныйДокументЕслиСуществует") И ДанныеЗаполнения.ПерезаполнитьГлавныйДокументЕслиСуществует Тогда 
			
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументЭТрНОбъект, ДокументОснование, НастройкаКонвертации, Переменные);
			ЗаполнитьРеквизитыЭТРНПоУмолчанию(ДокументЭТрНОбъект);
			
		КонецЕсли;
	Иначе
		
		ДокументЭТрНОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
		Если Разделитель <> Неопределено Тогда 
			ДокументЭТрНОбъект.Разделитель = Разделитель;	
		КонецЕсли;
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументЭТрНОбъект, ДокументОснование, НастройкаКонвертации, Переменные);
		ТранспортноеСредствоПоУмолчанию = ДокументЭТрНОбъект.Перевозчик.ТранспортноеСредствоПоУмолчанию;
		ЗаполнитьРеквизитыЭТРНПоУмолчанию(ДокументЭТрНОбъект);
		
	КонецЕсли;
	
	// проставить ЭЗЗ елси он не заполнен и его удалось вычислить, взять часть реквизитов
	УнаследоватьЧастьДанныхИзЗЗ(ДокументЭТрНОбъект, ЭлектроннаяЗаказЗаявкаОснование);
	
	ДокументЭТрНОбъект.Записать();
	ДокументЭТРН = ДокументЭТрНОбъект.Ссылка;
	
	//Заполнить ЭтотТитул
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ЭтотОбъект, НастройкаКонвертации, ,Переменные);
	
	Если ЗначениеЗаполнено(ДокументЭТРН.Перевозчик) И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.ВодительПоУмолчанию) Тогда
		Водитель = ДокументЭТРН.Перевозчик.ВодительПоУмолчанию;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументЭТРН.Перевозчик) И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.Водитель2ПоУмолчанию) Тогда
		Водитель2 = ДокументЭТРН.Перевозчик.Водитель2ПоУмолчанию;
	КонецЕсли;
	
	// заполнить метод определения массы из настроек
	Если Не ЗначениеЗаполнено(МетодОпределенияМассы) Тогда 	
		МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");		
	КонецЕсли;	
	
	ЗаполнитьИСконвертироватьТовары(НастройкаКонвертации, Переменные);
	
	Если ЗначениеЗаполнено(ОтправительШаблона) Тогда
		НовыйПолучатель = ДополнительныеПолучателиФайла.Добавить();
		НовыйПолучатель.ОрганизацияДиадок = ОтправительШаблона;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Составитель) И Не Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ЯвляетсяУчастникомПеревозки(Составитель, ДокументЭТРН) Тогда
		НовыйПолучатель = ДополнительныеПолучателиФайла.Добавить();
		НовыйПолучатель.ОрганизацияДиадок = Составитель;
		ЭтоПрототип = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура УнаследоватьЧастьДанныхИзЗЗ(ДокументЭТрНОбъект, Знач ЭлектроннаяЗаказЗаявкаОснование)
	
	Перем ЗЗТитул2, ПунктМаршрута;
	
	Если ЗначениеЗаполнено(ЭлектроннаяЗаказЗаявкаОснование)
		И Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ЗаказЗаявкаОснование) Тогда
		
		ДокументЭТрНОбъект.ЗаказЗаявкаОснование = ЭлектроннаяЗаказЗаявкаОснование;
		ДокументЭТрНОбъект.НомЗак     = ЭлектроннаяЗаказЗаявкаОснование.НомЗак;
		ДокументЭТрНОбъект.ДатаЗак    = ЭлектроннаяЗаказЗаявкаОснование.ДатаЗак;
		
		Если Не ЗначениеЗаполнено(ДатаВремяПодачиПлановая) Тогда 
			ДатаВремяПодачиПлановая = ЭлектроннаяЗаказЗаявкаОснование.ДатВрПод;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДатаВремяПрибытия) Тогда 
			ДатаВремяПрибытия = ЭлектроннаяЗаказЗаявкаОснование.ДатВрПод;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.МестоПогрузки) Тогда 
			ДокументЭТрНОбъект.МестоПогрузки = ЭлектроннаяЗаказЗаявкаОснование.ПунктПод;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.МестоДоставки) Тогда 
			Для Каждого ПунктМаршрута Из ЭлектроннаяЗаказЗаявкаОснование.АдрПункт Цикл  //последний пункт выгрузки - место доставки
				Если ПунктМаршрута.Выгрузка Тогда 
					ДокументЭТрНОбъект.МестоДоставки = ПунктМаршрута.ПунктМаршрута;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// найти Титул2 ЗЗ, оттуда берем ТС и водителей если они не указаны
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ТранспортноеСредство)
			ИЛИ Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Прицеп)
			ИЛИ Не ЗначениеЗаполнено(Водитель) Тогда
			
			ЗЗТитул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЗЗтитул2(ЭлектроннаяЗаказЗаявкаОснование);
			Если ЗначениеЗаполнено(ЗЗТитул2) Тогда
				Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ТранспортноеСредство) Тогда
					ДокументЭТрНОбъект.ТранспортноеСредство = ЗЗТитул2.ТранспортноеСредство;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Прицеп) Тогда
					Если ЗЗТитул2.Прицепы.Количество() > 0 Тогда
						ДокументЭТрНОбъект.Прицеп = ЗЗТитул2.Прицепы[0].Прицеп;
					КонецЕсли;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Водитель) Тогда
					Если ЗЗТитул2.Водители.Количество() > 0 Тогда 
						Водитель = ЗЗТитул2.Водители[0].СвВодит;
						Если ЗЗТитул2.Водители.Количество() > 1 Тогда 
							Водитель2 = ЗЗТитул2.Водители[1].СвВодит;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура РассчитатьАвтоитогиМестИМассы()
	
	Перем НайденныеСтроки, ТекущаяСтрока;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест") Тогда
		КоличествоМест = 0;
		НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			КоличествоМест = КоличествоМест + ТекущаяСтрока.КоличествоМест;
		КонецЦикла;
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто") Тогда
		МассаБруттоКг = 0;
		НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			МассаБруттоКг = МассаБруттоКг + ТекущаяСтрока.МассаПлановаяБруттоКг;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

