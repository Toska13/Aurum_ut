&НаКлиенте
Процедура УстановитьДатуВремяТекущим(Команда)
	
	Если ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТекущегоЭлемента = ТекущийЭлемент.Имя;
	
	Если ИмяТекущегоЭлемента = "ВремяКонтроляСейчас" Тогда
		Объект.ДатВрКонтТехСост = ТекущаяДатаСервера();
	ИначеЕсли ИмяТекущегоЭлемента = "ВремяВыпускаСейчас" Тогда
		Объект.ДатВрВыпНаЛин = ТекущаяДатаСервера();
	ИначеЕсли ИмяТекущегоЭлемента = "НачРаботыГрфСейчас" Тогда
		Объект.ДтВрНачРабГрф = ТекущаяДатаСервера();
		УстановитьЗаголовкиГруппамДопПолей();
	ИначеЕсли ИмяТекущегоЭлемента = "КонРабГрфСейчас" Тогда
		Объект.ДтВрКонРабГрф = ТекущаяДатаСервера();
		УстановитьЗаголовкиГруппамДопПолей();
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

