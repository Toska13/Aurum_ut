	ДокументКонтурЛогистика_ЗЗ_Титул1.Функция,
	ДокументКонтурЛогистика_ЗЗ_Титул1.ДатИнфГО,
	ДокументКонтурЛогистика_ЗЗ_Титул1.ВрИнфГО,
	ДокументКонтурЛогистика_ЗЗ_Титул1.Грузоотправитель,
