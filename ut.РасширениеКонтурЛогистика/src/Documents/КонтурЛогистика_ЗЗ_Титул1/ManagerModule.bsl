Функция ПолучитьДанныеДляПечатиЭЗЗ(МассивДокументовЭЗЗ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1.Ссылка КАК Титул1,
	|	МАКСИМУМ(ЕСТЬNULL(КонтурЛогистика_ЗЗ_Титул2.Ссылка, ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЗЗ_Титул2.ПустаяСсылка))) КАК
	|		Титул2
	|ПОМЕСТИТЬ ВТ_ЭЗЗ
	|ИЗ
	|	Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ЗЗ_Титул2 КАК КонтурЛогистика_ЗЗ_Титул2
	|		ПО КонтурЛогистика_ЗЗ_Титул2.Титул1 = КонтурЛогистика_ЗЗ_Титул1.Ссылка
	|		И НЕ КонтурЛогистика_ЗЗ_Титул2.ПометкаУдаления
	|ГДЕ
	|	КонтурЛогистика_ЗЗ_Титул1.Ссылка В (&МассивДокументовЭЗЗ)
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ЗЗ_Титул1.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЭЗЗ.Титул1,
	|	ВТ_ЭЗЗ.Титул1.Функция,
	|	ВТ_ЭЗЗ.Титул1.Грузоотправитель,
	|	ВТ_ЭЗЗ.Титул1.Перевозчик,
	|	ВТ_ЭЗЗ.Титул1.Составитель,
	|	ВТ_ЭЗЗ.Титул1.ОснДовОргСост,
	|	ВТ_ЭЗЗ.Титул1.ДогОргПрвз,
	|	ВТ_ЭЗЗ.Титул1.НомЗак,
	|	ВТ_ЭЗЗ.Титул1.ДатаЗак,
	|	ВТ_ЭЗЗ.Титул1.УказанияВОтношенииНормПеревозки,
	|	ВТ_ЭЗЗ.Титул1.ПредСрПрвз,
	|	ВТ_ЭЗЗ.Титул1.ПрвзПищПрод,
	|	ВТ_ЭЗЗ.Титул1.ИныеУслв,
	|	ВТ_ЭЗЗ.Титул1.КонПунктМрш,
	|	ВТ_ЭЗЗ.Титул1.ПунктПод,
	|	ВТ_ЭЗЗ.Титул1.ДатВрПод,
	|	ВТ_ЭЗЗ.Титул1.ПредВрПод,
	|	ВТ_ЭЗЗ.Титул1.ТСТип,
	|	ВТ_ЭЗЗ.Титул1.ТСГрузопод,
	|	ВТ_ЭЗЗ.Титул1.ТСВместим,
	|	ВТ_ЭЗЗ.Титул1.ТСТипПогр,
	|	ВТ_ЭЗЗ.Титул1.ТСТипКуз,
	|	ВТ_ЭЗЗ.Титул1.ТСДрПарам,
	|	ВТ_ЭЗЗ.Титул1.ТемператураНеНиже,
	|	ВТ_ЭЗЗ.Титул1.ТемператураНеВыше,
	|	ВТ_ЭЗЗ.Титул1.ВлажностьНеНиже,
	|	ВТ_ЭЗЗ.Титул1.ВлажностьНеВыше,
	|	ВТ_ЭЗЗ.Титул2,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.Составитель, ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)) КАК
	|		Титул2Составитель,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.ОснДовОргСост, ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Договоры.ПустаяСсылка)) КАК
	|		Титул2ОснДовОргСост,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.ЕстьОтказВПодписи, ЛОЖЬ) КАК Титул2ЕстьОтказВПодписи,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.ПричинаОтказаВПодписи, """") КАК Титул2ПричинаОтказаВПодписи,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.СвЛицОргПрвз, ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка)) КАК
	|		Титул2СвЛицОргПрвз,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.СвЛицПрв, ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)) КАК
	|		Титул2СвЛицПрв,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.ТранспортноеСредство,
	|		ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка)) КАК Титул2ТранспортноеСредство,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.СтТовБезНДС, 0) КАК Титул2СтоимостьБезНДС,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.НалСт, ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.КонтурЛогистика_СтавкиНДС.ПустаяСсылка)) КАК Титул2НалСт,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.СтТовУчНал, 0) КАК Титул2СтоимостьСНДС,
	|	ЕСТЬNULL(ВТ_ЭЗЗ.Титул2.Расчет, """") КАК Титул2Расчет,
	|	ВТ_ЭЗЗ.Титул1.УИД_Зак
	|ИЗ
	|	ВТ_ЭЗЗ КАК ВТ_ЭЗЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1СвЛицГО.Ссылка КАК Титул1,
	|	КонтурЛогистика_ЗЗ_Титул1СвЛицГО.Полномочие,
	|	КонтурЛогистика_ЗЗ_Титул1СвЛицГО.Участник,
	|	КонтурЛогистика_ЗЗ_Титул1СвЛицГО.ДокументНаименование,
	|	КонтурЛогистика_ЗЗ_Титул1СвЛицГО.ДокументНомер,
	|	КонтурЛогистика_ЗЗ_Титул1СвЛицГО.ДокументДата
	|ИЗ
	|	ВТ_ЭЗЗ КАК ВТ_ЭЗЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ЗЗ_Титул1.СвЛицГО КАК КонтурЛогистика_ЗЗ_Титул1СвЛицГО
	|		ПО ВТ_ЭЗЗ.Титул1 = КонтурЛогистика_ЗЗ_Титул1СвЛицГО.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1АдрПункт.Ссылка КАК Титул1,
	|	КонтурЛогистика_ЗЗ_Титул1АдрПункт.НомерСтроки,
