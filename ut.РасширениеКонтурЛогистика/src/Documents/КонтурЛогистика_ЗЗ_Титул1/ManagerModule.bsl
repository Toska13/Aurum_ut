
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	КонтурЛогистика_ОбработкаДокументовСервер.ОбработкаПолученияПредставленияДокументаТитулаЗЗ(Данные, Представление, СтандартнаяОбработка, "1");
	
КонецПроцедуры

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, ПараметрыФормированияФайлов = Неопределено) Экспорт
	
	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка, Истина);
	
	ТаблицаОшибок.Очистить();
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		КонтурЛогистика_ПанельОшибокСервер.ВывестиОшибкуТекущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок)
	КонецЕсли;
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		
		// TODO понять какие сценарии проверки входящего документа
		
	ИначеЕсли Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
		И Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда  
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, ТаблицаОшибок);
		
		ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		ПроверитьТабЧастьТовары(ДокументОбъектИлиСсылка, ТаблицаОшибок, ТекСтатусТитула);
		
		ПроверитьМаршрут(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		// TODO - доделать валидатор
		//
		//ПроверитьОтметки(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		//ПроверитьИнфПол(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьДружбуКонтрагентов(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьОтправителя(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
	ИначеЕсли ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена Тогда 
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиДругихСторон(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьРоуминг(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Объект.Грузоотправитель);
	
	Если Не ПараметрыСервиса.АвторизацияВыполнена И ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда
		
		ОстатокУИДов = РегистрыСведений.КонтурЛогистика_УИДыГИС.ОсталосьСвободныхУИДов(Объект.Грузоотправитель);
		Если ОстатокУИДов = 0 Тогда
			
			ТекстОшибки = "Не осталось свободных УИД в пуле. Получите новые.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"УИД_Зак", КатегорияОшибка, ТекстОшибки, "Получить УИДы");
			
		КонецЕсли;
		
		Если ОстатокУИДов > 0 И Не ЗначениеЗаполнено(Объект.УИД_Зак) Тогда 
			ТекстОшибки = "УИД будет взят из пула (при записи)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"УИД_Зак", КатегорияПредупреждение, ТекстОшибки, "Взять сейчас");
		КонецЕсли;
		
	КонецЕсли;
	
	ОбязательныеРеквизитыЗЗ = Документы.КонтурЛогистика_ЗЗ_Титул1.МассивОбязательныхРеквизитов();
		
	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" ИЛИ Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			ОбязательныйРевизитСиноним = Документы.КонтурЛогистика_ЗЗ_Титул1.СинонимРеквизита(ОбязательныйРевизит);
			ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ОбязательныйРевизит, КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Телефоны ГО и ПВ
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(Объект.Грузоотправитель) Тогда 
		
		ТекстОшибки = "Укажите Телефон Грузоотправителя";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Грузоотправитель.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
			
	КонецЕсли;
	
	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ТелефонЗаполнен(Объект.Перевозчик) Тогда 
		
		ТекстОшибки = "Укажите Телефон Перевозчика";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Перевозчик.Телефон", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// ОрганизацияСоставитель 
	Если ЗначениеЗаполнено(Объект.Составитель) И Объект.Составитель <> Объект.Грузоотправитель Тогда 
		
		Если НЕ Объект.Составитель = Объект.Грузоотправитель Тогда
			
			Если Не ЗначениеЗаполнено(Объект.ОснДовОргСост) Тогда
			
				ТекстОшибки = "Укажите договор-основание полномочий составителя файла обмена";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ОснДовОргСост", КатегорияОшибка, ТекстОшибки, "Указать");
				
			Иначе 
				
				Если Не ЗначениеЗаполнено(Объект.ОснДовОргСост.Организация) Тогда
					
					ТекстОшибки = "Укажите организацию, к которой относится договор составителя Заказа (заявки)";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"ОснДовОргСост.Организация", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;	
				
				Если Не ЗначениеЗаполнено(Объект.ОснДовОргСост.Контрагент) Тогда
					
					ТекстОшибки = "Укажите контрагента, с которым у организации заключен договор составителя Заказа (заявки)";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"ОснДовОргСост.Контрагент", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Объект.ПрвзПищПрод) И Не ЗначениеЗаполнено(Объект.ПредСрПрвз) Тогда
		
		ТекстОшибки = "Укажите предельные сроки перевозки";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ПредСрПрвз", КатегорияПредупреждение, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Объект.Функция = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ФункцииЗаказаЗаявки.Заявка")
		И НЕ ЗначениеЗаполнено(Объект.ДогОргПрвз) Тогда
		
		ТекстОшибки = "Укажите договор об организации перевозки груза";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ДогОргПрвз", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	// TODO
	// ГЛУБОКИЕ ВАЛИДАЦИИ, ВЗАИМНЫЕ ВАЛИДАЦИИ
	
КонецПроцедуры

Процедура ПроверитьМаршрут(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ИмяТЧ = "АдрПункт";
	
	// Пункт(ы) погрузки
	Если Объект.АдрПункт.Количество() = 0 Тогда 
			
			ТекстОшибки = "Укажите маршрут";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"АдрПункт", КатегорияОшибка, ТекстОшибки, "Указать");
	Иначе
		
		Для Каждого СтрокаМаршрута Из Объект.АдрПункт Цикл 
			
			ТекущийНомерСтроки = СтрокаМаршрута.НомерСтроки;
			
			Если Не ЗначениеЗаполнено(СтрокаМаршрута.ПунктМаршрута) Тогда 
				ТекстОшибки = "Укажите пункт маршрута";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
					"ПунктМаршрута", КатегорияОшибка, ТекстОшибки, "Указать");
				
			ИначеЕсли Не СтрокаМаршрута.Погрузка И Не СтрокаМаршрута.Выгрузка Тогда
					ТекстОшибки = "Укажите у пункта маршрута признак погрузка или выгрузка";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
						"Выгрузка", КатегорияОшибка, ТекстОшибки, "Указать");
			Иначе	
				Если СтрокаМаршрута.Погрузка
					И Не ЗначениеЗаполнено(СтрокаМаршрута.ПунктМаршрута.Собственник) Тогда
					ТекстОшибки = "Укажите собственника пункта маршрута в его карточке";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
						"ПунктМаршрута.Собственник", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаМаршрута.ПредВрОпер) 
				И Не ЗначениеЗаполнено(СтрокаМаршрута.ДатВрОпер) Тогда 
				ТекстОшибки = "Укажите время начала операции (т.к. указана предельная длительность)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
					"ДатВрОпер", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	// TODO
	// ГЛУБОКИЕ ВАЛИДАЦИИ, ВЗАИМНЫЕ ВАЛИДАЦИИ
	
КонецПроцедуры

Процедура ПроверитьТабЧастьТовары(Знач Объект, ТаблицаОшибок, ТекСтатусДокумента = Неопределено)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ИмяТЧ = "Товары";
	
	Если Не ЗначениеЗаполнено(Объект.Товары) Тогда 
		
		ТекстОшибки = "Добавьте груз в табличную часть ""Грузы (Товары)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"", КатегорияОшибка, ТекстОшибки, "Добавить груз");
		
	ИначеЕсли Объект.Товары.НайтиСтроки(Новый Структура("Учитывать", Истина)).Количество() = 0 Тогда
		
		ТекстОшибки = "Нет ни одного учитываемого груза в табличной части ""Грузы (Товары)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"", КатегорияОшибка, ТекстОшибки, "Добавить груз");
		
	Иначе	
		
		ИтогоОбъем 			= 0;
		ИтогоМассаБрутто 	= 0;
		
		Для Каждого СтрокаТовара Из Объект.Товары Цикл
			                                                                      
			Если Не СтрокаТовара.Учитывать Тогда 
				Продолжить;
			КонецЕсли;
			
			ТекущийНомерСтроки = СтрокаТовара.НомерСтроки;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.КоличествоМест) Тогда
				ТекстОшибки = "Укажите Количество мест по грузу";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"КоличествоМест", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать кол-во мест");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.ОтгрузочноеНаименование) Тогда
				ТекстОшибки = "Укажите Отгрузочное наименование";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать отгрузочное наименование");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.СостояниеГруза) Тогда
				ТекстОшибки = "Укажите Состояние груза";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"СостояниеГруза", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать состояние груза");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.ВидТары) Тогда
				ТекстОшибки = "Укажите Вид тары";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"ВидТары", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать вид тары");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.МассаПлановаяБруттоКг) Тогда
				ТекстОшибки = "Укажите Массу (брутто) груза";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"МассаПлановаяБруттоКг", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать массу брутто");
			Иначе
				ИтогоМассаБрутто = ИтогоМассаБрутто + СтрокаТовара.МассаПлановаяБруттоКг;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.ОбъемКубМ) Тогда
				ТекстОшибки = "Укажите объем груза";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"ОбъемКубМ", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать объем");
			Иначе
				ИтогоОбъем = ИтогоОбъем + СтрокаТовара.ОбъемКубМ;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.Высота)
				ИЛИ НЕ ЗначениеЗаполнено(СтрокаТовара.Длина)
				ИЛИ НЕ ЗначениеЗаполнено(СтрокаТовара.Ширина)
				Тогда
				ТекстОшибки = "Укажите габариты груза (Д, Ш, В)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"Высота", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать");
			КонецЕсли;
			
			// ПроверитьСвязанныеОпасныеГрузы(Объект, СтрокаТовара, ТаблицаОшибок);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Объект.ТСВместим) 
			И ИтогоОбъем > 0
			И ИтогоОбъем > Объект.ТСВместим Тогда
			
			ТекстОшибки = "Общий объем по таб. части Грузы (" + ИтогоОбъем + " куб.м.) превышает запрошенную вместимость ТС (" + Объект.ТСВместим + " куб.м.)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ТСВместим", КатегорияПредупреждение, ТекстОшибки, "Исправить");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ТСГрузопод) 
			И ИтогоМассаБрутто > 0
			И ИтогоМассаБрутто/1000 > Объект.ТСГрузопод Тогда  // кг-тонны
			
			ТекстОшибки = "Общая масса Брутто по таб. части Грузы (" + ИтогоМассаБрутто + " кг.) превышает запрошенную грузоподъемность ТС (" + Объект.ТСГрузопод + " т.)";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ТСГрузопод", КатегорияПредупреждение, ТекстОшибки, "Исправить");
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

