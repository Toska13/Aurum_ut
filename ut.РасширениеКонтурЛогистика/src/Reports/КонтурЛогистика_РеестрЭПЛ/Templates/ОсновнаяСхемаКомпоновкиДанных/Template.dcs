			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 1</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПЛ_Титул2_Водитель1</dataPath>
			<field>ПЛ_Титул2_Водитель1</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 2 водитель 1</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПЛ_Титул2_Водитель2</dataPath>
			<field>ПЛ_Титул2_Водитель2</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 2 водитель 2</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПЛ_Титул3</dataPath>
			<field>ПЛ_Титул3</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 3</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПЛ_Титул4</dataPath>
			<field>ПЛ_Титул4</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 4</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПЛ_Титул6_Водитель1</dataPath>
			<field>ПЛ_Титул6_Водитель1</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 6 водитель 1</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПЛ_Титул6_Водитель2</dataPath>
			<field>ПЛ_Титул6_Водитель2</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Титул 6 водитель 2</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбязМедосмотрПосле</dataPath>
			<field>ОбязМедосмотрПосле</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Мед. осмотр после</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    КонтурЛогистика_ПЛ_Титул1.Ссылка КАК ПутевойЛист,
    КонтурЛогистика_ПЛ_Титул1.НомерПЛ КАК НомерПЛ,
    КонтурЛогистика_ПЛ_Титул1.ДатаПЛ КАК ДатаПЛ,
    КонтурЛогистика_ПЛ_Титул1.Водитель КАК Водитель,
    КонтурЛогистика_ПЛ_Титул2_Водитель1.МедРаботник КАК МедРаботник_Водитель1,
    КонтурЛогистика_ПЛ_Титул1.Водитель2 КАК Водитель2,
    КонтурЛогистика_ПЛ_Титул2_Водитель2.МедРаботник КАК МедРаботник_Водитель2,
    КонтурЛогистика_ПЛ_Титул1.ТранспортноеСредство КАК ТранспортноеСредство,
    КонтурЛогистика_ПЛ_Титул1.ТранспортноеСредство.РегНомер КАК ТранспортноеСредствоРегНомер,
    КонтурЛогистика_ПЛ_Титул1.ТранспортноеСредство.МаркаТС КАК ТранспортноеСредствоМаркаТС,
    КонтурЛогистика_ПЛ_Титул3.ТехРаботник КАК ТехРаботник,
    КонтурЛогистика_ПЛ_Титул4.ОдометрРаботник КАК ОдометрРаботник,
    КонтурЛогистика_ПЛ_Титул1.ОбязМедосмотрПосле КАК ОбязМедосмотрПосле,
    ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(КонтурЛогистика_ПЛ_Титул4.ДатИнфВыезд, СЕКУНДА, СЕКУНДА(КонтурЛогистика_ПЛ_Титул4.ВрИнфВыезд)), МИНУТА, МИНУТА(КонтурЛогистика_ПЛ_Титул4.ВрИнфВыезд)), ЧАС, ЧАС(КонтурЛогистика_ПЛ_Титул4.ВрИнфВыезд)) КАК ДатаВыезда,
    ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(КонтурЛогистика_ПЛ_Титул5.ДатИнфЗаезд, СЕКУНДА, СЕКУНДА(КонтурЛогистика_ПЛ_Титул5.ВрИнфЗаезд)), МИНУТА, МИНУТА(КонтурЛогистика_ПЛ_Титул5.ВрИнфЗаезд)), ЧАС, ЧАС(КонтурЛогистика_ПЛ_Титул5.ВрИнфЗаезд)) КАК ДатаЗаезда,
    КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК Состояние,
    ВЫБОР
        КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&amp;СостояниеДОЗавершен)
            ТОГДА ИСТИНА
        ИНАЧЕ ЛОЖЬ
    КОНЕЦ КАК ДокументооборотЗавершен,
    КонтурЛогистика_ПЛ_Титул1.Ссылка КАК ПЛ_Титул1,
    КонтурЛогистика_ПЛ_Титул2_Водитель1.Ссылка КАК ПЛ_Титул2_Водитель1,
    КонтурЛогистика_ПЛ_Титул2_Водитель2.Ссылка КАК ПЛ_Титул2_Водитель2,
    КонтурЛогистика_ПЛ_Титул3.Ссылка КАК ПЛ_Титул3,
    КонтурЛогистика_ПЛ_Титул4.Ссылка КАК ПЛ_Титул4,
    КонтурЛогистика_ПЛ_Титул5.Ссылка КАК ПЛ_Титул5,
    КонтурЛогистика_ПЛ_Титул6_Водитель1.Ссылка КАК ПЛ_Титул6_Водитель1,
    КонтурЛогистика_ПЛ_Титул6_Водитель2.Ссылка КАК ПЛ_Титул6_Водитель2
ИЗ
    Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2_Водитель1
        ПО (КонтурЛогистика_ПЛ_Титул2_Водитель1.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка
            И КонтурЛогистика_ПЛ_Титул2_Водитель1.Водитель = КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель)
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2_Водитель2
        ПО (КонтурЛогистика_ПЛ_Титул2_Водитель2.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка
            И КонтурЛогистика_ПЛ_Титул2_Водитель2.Водитель = КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель2)
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул3 КАК КонтурЛогистика_ПЛ_Титул3
        ПО (КонтурЛогистика_ПЛ_Титул3.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул4 КАК КонтурЛогистика_ПЛ_Титул4
        ПО (КонтурЛогистика_ПЛ_Титул4.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул5 КАК КонтурЛогистика_ПЛ_Титул5
        ПО (КонтурЛогистика_ПЛ_Титул5.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул6 КАК КонтурЛогистика_ПЛ_Титул6_Водитель1
        ПО (КонтурЛогистика_ПЛ_Титул6_Водитель1.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка
            И КонтурЛогистика_ПЛ_Титул6_Водитель1.Водитель = КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель)
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул6 КАК КонтурЛогистика_ПЛ_Титул6_Водитель2
        ПО (КонтурЛогистика_ПЛ_Титул6_Водитель2.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка
            И КонтурЛогистика_ПЛ_Титул6_Водитель2.Водитель = КонтурЛогистика_ПЛ_Титул1.Ссылка.Водитель2)
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних({(&amp;КонецПериода)}, ) КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
        ПО (КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ = КонтурЛогистика_ПЛ_Титул1.Ссылка)
ГДЕ
    КонтурЛогистика_ПЛ_Титул1.ДатаПЛ МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
{ГДЕ
    (КонтурЛогистика_ПЛ_Титул1.Водитель = &amp;Водитель
            ИЛИ КонтурЛогистика_ПЛ_Титул1.Водитель2 = &amp;Водитель)}

УПОРЯДОЧИТЬ ПО
    ДатаПЛ</query>
	</dataSet>
	<calculatedField>
		<dataPath>ФИОВодителя</dataPath>
		<expression>Водитель.Фамилия + " " + Водитель.Имя + " " + Водитель.Отчество</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ФИО водителя</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">20</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>ВУ</dataPath>
		<expression>Водитель.ВУСерия + " " + Водитель.ВУНомер</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ВУ</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>ФИОВодителя2</dataPath>
		<expression>Водитель2.Фамилия + " " + Водитель2.Имя + " " + Водитель2.Отчество</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ФИО 2-го водителя</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">20</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>ВУ2</dataPath>
		<expression>Водитель2.ВУСерия + " " + Водитель2.ВУНомер</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ВУ 2-го водителя</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
