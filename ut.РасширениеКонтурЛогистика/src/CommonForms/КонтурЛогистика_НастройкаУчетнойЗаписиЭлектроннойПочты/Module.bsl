#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресЭлектроннойПочты = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("АдресЭлектроннойПочты");
	АдресСервераSMTP = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("АдресСервераSMTP");
	ПользовательSMTP = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПользовательSMTP");
	ПортSMTP = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПортSMTP");
	ИспользоватьСистемнуюУчетнуюЗапись = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьСистемнуюУчетнуюЗапись");
	
	Пароль = КонтурЛогистика_ОбщегоНазначенияВызовСервера.ПолучитьПароль("ПарольЭлектроннойПочты", "Пароль");
	Пароль = ?(ЗначениеЗаполнено(Пароль), Строка(УникальныйИдентификатор), "");
	
	ОбновитьДанныеРегламентногоЗадания();
	
	Если СистемнаяУчетнаяЗапись() = Неопределено Тогда
		Элементы.ГруппаСистемнаяУчетнаяЗапись.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ИспользоватьСистемнуюУчетнуюЗапись Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	Если Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КорректноЗаполненПочтовыйАдрес(АдресЭлектроннойПочты) Тогда
		
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Некорректный адрес электронной почты """ + АдресЭлектроннойПочты + """";
		ПараметрыСообщения.ПутьКДанным = "АдресЭлектроннойПочты";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.КонтурЛогистика_Настройки"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)
	
	ПарольИзменен = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеСтрокаАвтоОтправкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Обработка.КонтурЛогистика_ФоновыеИРегламентныеЗадания.Форма.Форма",, ЭтаФорма, ЭтаФорма, "ИзменениеРасписанияЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеРасписанияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьДанныеРегламентногоЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьСистемнуюУчетнуюЗаписьПриИзменении(Элемент)
	
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОткрытьСистемнуюУчетнуюЗаписьНажатие(Элемент)
	
	СистемнаяУчетнаяЗапись = СистемнаяУчетнаяЗапись();
	
	Если СистемнаяУчетнаяЗапись = Неопределено Тогда
		Сообщить("Не удалось получить системную учетную запись");
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, СистемнаяУчетнаяЗапись);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьНастройкиСервер();
	
	Оповестить("ИзменениеНастройкиУчетнойЗаписиЭлектроннойПочты");
	
	Если Не Модифицированность Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	
	ЗаписатьНастройкиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТестовоеПисьмо(Команда)
	
	Если Модифицированность Тогда
		Сообщить("Настройки не сохранены");
		Возврат;
	КонецЕсли;
	
	ОтправитьТестовоеПисьмоСервер();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	
	Элементы.ГруппаНастройкиУчетнойЗаписи.Доступность = Не ИспользоватьСистемнуюУчетнуюЗапись;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиСервер()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("АдресСервераSMTP", АдресСервераSMTP);
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ПользовательSMTP", ПользовательSMTP);
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ПортSMTP", ПортSMTP);
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ИспользоватьСистемнуюУчетнуюЗапись", ИспользоватьСистемнуюУчетнуюЗапись);
	
	Если ПарольИзменен Тогда
		КонтурЛогистика_ОбщегоНазначенияВызовСервера.ЗаписатьПароль("ПарольЭлектроннойПочты", Пароль);
		ПарольИзменен = Ложь;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьТестовоеПисьмоСервер()
	
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = "Тестовое письмо";
	Письмо.Тексты.Добавить("Тестовое письмо отправленное из 1С");
	
	Если ИспользоватьСистемнуюУчетнуюЗапись Тогда
		МодульРаботаСПочтовымиСообщениями = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("РаботаСПочтовымиСообщениями");
		Если МодульРаботаСПочтовымиСообщениями = Неопределено Тогда
			ВызватьИсключение "Не удалось найти модуль: РаботаСПочтовымиСообщениями";
		КонецЕсли;
		
		СистемнаяУчетнаяЗапись = МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		Письмо.Получатели.Добавить(СистемнаяУчетнаяЗапись.АдресЭлектроннойПочты);
	Иначе
		Письмо.Получатели.Добавить(АдресЭлектроннойПочты);
	КонецЕсли;
	
	ТекстОшибки = КонтурЛогистика_РаботаСПочтовымиСообщениями.ОтправитьПисьмо(Письмо);
	
	Если ТекстОшибки = Неопределено Тогда
		Сообщить("Тестовое письмо отправлено");
	Иначе
		Сообщить("При отправки тестового письма возникла ошибка: " + ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеРегламентногоЗадания()
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегламентноеЗадание = Неопределено;
	
	РегЗадания = КонтурЛогистика_Привилегированный.ПолучитьРегламентныеЗадания();
	Для каждого РегЗадание Из РегЗадания Цикл
		Если РегЗадание.Ключ = "КонтурЛогистика_АвтоматическоеПолучениеИОтправкаQRКодов" Тогда
			РегламентноеЗадание = РегЗадание;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если РегламентноеЗадание = Неопределено Тогда
		
		Если Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда
			ВызватьИсключение "Для работы регламентных заданий требуется механизм Дополнительных отчетов и обработок (из БСП)!";
		КонецЕсли;
		
		ДопОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту(
			"ИмяОбъекта", КонтурЛогистика_РежимРасширенияСервер.ИмяОбработкиРегламентныхЗаданийДляРасширенияКонтурЛогистика());
		
		Если Не ЗначениеЗаполнено(ДопОбработка) Тогда
			ВызватьИсключение "Не подключена дополнительная обработка для регламентных заданий!";
		КонецЕсли;
		
		ДопОбработкаОб = ДопОбработка.ПолучитьОбъект();
		
		Для каждого Команда Из ДопОбработкаОб.Команды Цикл
			
			Если Команда.Идентификатор = "КонтурЛогистика_АвтоматическоеПолучениеИОтправкаQRКодов"
				И Команда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода Тогда
				
				Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Команда.РегламентноеЗаданиеGUID);
				Если Задание <> Неопределено Тогда
					РегламентноеЗадание = Задание;
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если РегламентноеЗадание = Неопределено Тогда
		ВызватьИсключение "Не найдено предопределенное регламентное задание ""КонтурЛогистика_АвтоматическоеПолучениеИОтправкаQRКодов""!";
	КонецЕсли;
	
	Если РегламентноеЗадание.Использование Тогда
		ИндексИспользованияРЗ = 0;
	Иначе
		ИндексИспользованияРЗ = 1;
	КонецЕсли;
	
	РасписаниеСтрокаАвтоОтправки = Строка(РегламентноеЗадание.Расписание);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СистемнаяУчетнаяЗапись()
	
	МодульРаботаСПочтовымиСообщениями = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	Если МодульРаботаСПочтовымиСообщениями = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
КонецФункции

#КонецОбласти