
&НаКлиенте
Процедура Выбрать(Команда)
	
	ЭтаФорма.Закрыть(Новый Структура("DocumentId, MessageID", DocumentId, MessageID));
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.НашаОрганизация) Тогда 
		НашаОрганизация = Параметры.НашаОрганизация; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	
	Попытка
	
		РезультатЧтения = ПрочитатьДокументИзДиадока(НашаОрганизация, MessageID, DocumentId);
		Состояние("Найден в Диадоке", , "ТипДокумента: " + РезультатЧтения.DocumentType + " №" + РезультатЧтения.DocumentNumber + " от " + РезультатЧтения.DocumentDate , БиблиотекаКартинок.КонтурЛогистика_Галочка);
		
	
	Исключение
		
		Сообщить(ОписаниеОшибки());
		Состояние("Проблема", , "Не удалось прочитать документ в Диадоке" , БиблиотекаКартинок.КонтурЛогистика_Восклицание);
		
	КонецПопытки;
	
КонецПроцедуры


&НаСервере
Функция ПрочитатьДокументИзДиадока(НашаОрганизация, MessageID, DocumentId)
	
	boxId = НашаОрганизация.ID;
	
	ПараметрыСервиса = КонтурЛогистика_API_Диадок.ЛогистикаПараметрыСервиса_Диадок(boxId);

	РезультатЧтения = КонтурЛогистика_API_Диадок.Ядро().АПИ_GetDocument(ПараметрыСервиса,
																		boxId,
																		MessageID,
																		DocumentId);
		
	Возврат РезультатЧтения;

КонецФункции
