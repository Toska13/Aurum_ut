
&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшМодуляКлиента;

&НаКлиенте
Перем РезультатЗапроса;

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта = Неопределено Тогда
		КэшМодуляОбъекта = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

&НаКлиенте
Функция ВидКлиента()
	
	Результат = "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Результат = "Толстый клиент (обычное приложение)";
	#КонецЕсли
	
	#Если ТолстыйКлиентУправляемоеПриложение Тогда
		Результат = "Толстый клиент (управляемое приложение)";
	#КонецЕсли
	
	#Если ТонкийКлиент  Тогда
		Результат = "Тонкий клиент";
	#КонецЕсли
	
	#Если ВебКлиент   Тогда
		Результат = "Веб-клиент";
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТехИнформация = ТекстИнформацииДляТехПоддержки();
	
КонецПроцедуры

&НаКлиенте
Функция ТекстИнформацииДляТехПоддержки()
	
	ДанныеДляТехподдержки = ИнформацияДляПоддержкиНаСервере();
	
	ИнформацияОМодуле = ДанныеДляТехподдержки.ИнформацияОМодуле;
	ИнформацияОКонфигурации = ДанныеДляТехподдержки.ИнформацияОКонфигурации;
	ИнформацияОНастройках = ДанныеДляТехподдержки.ИнформацияОНастройкахМодуля;
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	ИнформацияОРасширениях = ДанныеДляТехподдержки.ИнформацияОРасширениях;
	ИнформацияОСервере = ДанныеДляТехподдержки.ИнформацияОСервере;
	
	ТекстИнформации =
	"Техническая информация:
	|
	|Версия модуля: %ВерсияМодуля%
	|Версия плагина криптографии: %ВерсияПлагина%
	|Расположение модуля: %РасположениеМодуля%
	|Имя модуля: %ИмяМодуля%
	|Подключаемый модуль: %ПодключаемыйМодуль%
	|
	|Конфигурация: %Конфигурация%
	|Версия конфигурации: %ВерсияКонфигурации%
	|Тип платформы: %ТипПлатформы%
	|Версия платформы: %ВерсияПриложения%
	|Версия ОС клиента: %ВерсияОС%
	|Версия ОС сервера: %ВерсияОСНаСервере%
	|Вид клиента: %ВидКлиента%
	|Основной режим запуска: %ОсновнойРежимЗапуска%
	|Строка соединения: %СтрокаСоединения%
	|Режим совместимости: %ВерсияРежимаСовместимости%
	|
	|Настройки модуля:
	|Идентификатор базы: %ИдентификаторБазы%
	|Идентификатор базы (общепродуктовый): %ОбщепродуктовыйИдентификаторБазы%
	|Логин авторизации Диадок API: %ЛогинАвторизацииДиадокАПИ%
	|Используется подпись на сервере: %РазрешитьПодписьНаСервере%
	|Расположение сертификатов: %РасположениеСертификатов%
	|Используется прокси: %Прокси_Использовать%
	|
	|Дополнительные расширения:
	|%ИнформацияОРасширениях%";
	
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияМодуля%", ИнформацияОМодуле.ВерсияМодуля);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияПлагина%", ИнформацияОМодуле.ВерсияПлагина);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%РасположениеМодуля%", ИнформацияОМодуле.РасположениеМодуля);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ИмяМодуля%", ИнформацияОМодуле.ИмяМодуля);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ПодключаемыйМодуль%", ИнформацияОНастройках.ПодключаемыйМодуль);
	
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%Конфигурация%", ИнформацияОКонфигурации.Конфигурация);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияКонфигурации%", ИнформацияОКонфигурации.ВерсияКонфигурации);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ТипПлатформы%", ИнформацияОСистеме.ТипПлатформы);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияПриложения%", ИнформацияОСистеме.ВерсияПриложения);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияОС%", ИнформацияОСистеме.ВерсияОС);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияОСНаСервере%", ИнформацияОСервере.ВерсияОС);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВидКлиента%", ВидКлиента());
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ОсновнойРежимЗапуска%", ИнформацияОКонфигурации.ОсновнойРежимЗапуска);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%СтрокаСоединения%", ИнформацияОКонфигурации.СтрокаСоединения);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ВерсияРежимаСовместимости%", ИнформацияОКонфигурации.ВерсияРежимаСовместимости);
	
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ИдентификаторБазы%", ИнформацияОНастройках.ИдентификаторБазы);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ОбщепродуктовыйИдентификаторБазы%", ИнформацияОНастройках.ОбщепродуктовыйИдентификаторБазы);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ЛогинАвторизацииДиадокАПИ%", ИнформацияОНастройках.ЛогинАвторизацииДиадокАПИ);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%РазрешитьПодписьНаСервере%", ИнформацияОНастройках.РазрешитьПодписьНаСервере);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%РасположениеСертификатов%", ИнформацияОНастройках.РасположениеСертификатов);
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%Прокси_Использовать%", ИнформацияОНастройках.Прокси_Использовать);
	
	ТекстИнформации = СтрЗаменить(ТекстИнформации, "%ИнформацияОРасширениях%", ИнформацияОРасширениях.СписокРасширений);
	
	Возврат ТекстИнформации;
	
КонецФункции

&НаСервере
Функция ИнформацияДляПоддержкиНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ИнформацияОМодуле", ИнформацияОМодуле());
	Результат.Вставить("ИнформацияОКонфигурации", ИнформацияОКонфигурации());
	Результат.Вставить("ИнформацияОНастройкахМодуля", ИнформацияОНастройкахМодуля());
	Результат.Вставить("ИнформацияОРасширениях", ИнформацияОРасширениях());
	Результат.Вставить("ИнформацияОСервере", ИнформацияОСервере());
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИнформацияОМодуле()
	
	ИнформацияОМодуле = Новый Структура;
	ИнформацияОМодуле.Вставить("ВерсияМодуля",       ВерсияОбработки());
	ИнформацияОМодуле.Вставить("ВерсияПлагина",      ВерсияПлагина());
	ИнформацияОМодуле.Вставить("РасположениеМодуля", ?(КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение(), "Расширение", "В составе конфигурации"));
	ИнформацияОМодуле.Вставить("ИмяМодуля",          "КонтурЛогистика");
	
	Возврат ИнформацияОМодуле;
	
КонецФункции

&НаСервере
Функция ВерсияОбработки() Экспорт
	
	Возврат КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	
КонецФункции

&НаСервере
Функция ВерсияПлагина() Экспорт
	
	ОбработкаПлагин = Обработки.КонтурЛогистика_КонтурПлагин.Создать();
	Возврат ОбработкаПлагин.ВерсияОбработки();
	
КонецФункции

&НаСервере
Функция ИнформацияОКонфигурации()
	
	ВерсияРежимаСовместимости = Строка(Метаданные.РежимСовместимости);
	Если ВерсияРежимаСовместимости = ВерсияОбработки() Тогда
		ВерсияРежимаСовместимости = "";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Конфигурация",              СинонимКонфигурации()); 
	Результат.Вставить("ВерсияКонфигурации",        Метаданные.Версия); 
	Результат.Вставить("ОсновнойРежимЗапуска",      Метаданные.ОсновнойРежимЗапуска);
	Результат.Вставить("ВерсияРежимаСовместимости", ВерсияРежимаСовместимости); 
	Результат.Вставить("СтрокаСоединения",          СтрокаСоединенияИнформационнойБазы());
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИнформацияОНастройкахМодуля()
	
	Результат = Новый Структура;
	Результат.Вставить("ПодключаемыйМодуль", Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПодключаемыйМодульТип"));
	Результат.Вставить("ИдентификаторБазы", Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("СлужебныйИдентификаторБазыДанных"));
	Результат.Вставить("ОбщепродуктовыйИдентификаторБазы", КонтурЛогистика_Метрика.ИдентификаторИБ());
	Результат.Вставить("РазрешитьПодписьНаСервере", Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("РазрешитьПодписьНаСервере"));
	Результат.Вставить("Прокси_Использовать", Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ПроксиИспользовать"));
	Результат.Вставить("ЛогинАвторизацииДиадокАПИ", Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ЛогинАвторизацииДиадокАПИ"));
	
	РасположениеСертификатов = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере КАК СертификатНаСервере
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних(&Дата, ) КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере";
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтроковоеРасположение = ?(ВыборкаДетальныеЗаписи.СертификатНаСервере, "на сервере", "на клиенте");
		РасположениеСертификатов = ?(ЗначениеЗаполнено(РасположениеСертификатов), 
			РасположениеСертификатов + " и " + СтроковоеРасположение, СтроковоеРасположение);
	КонецЦикла;
	
	Результат.Вставить("РасположениеСертификатов", РасположениеСертификатов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СинонимКонфигурации()
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.Контур_ОпределитьКонфигурацию();
	
КонецФункции

&НаСервере
Функция ИнформацияОРасширениях()
	
	Попытка
		НайденныеРасширения = РасширенияКонфигурации.Получить();
	Исключение
		НайденныеРасширения = Новый Массив;
	КонецПопытки;
	
	Если НайденныеРасширения.Количество() > 0 Тогда
		
		СписокРасширений = Новый Массив;
		
		Для Каждого Расширение Из НайденныеРасширения Цикл
			Если Найти(Расширение.Имя, "КонтурЛогистика") > 0 Тогда
				СписокРасширений.Добавить(Расширение.Имя);
			КонецЕсли;
		КонецЦикла;
		
		Если СписокРасширений.Количество() = 0 Тогда
			СписокРасширений = "Нет";
		Иначе
			СписокРасширений = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(СписокРасширений, ", ");
		КонецЕсли;
		
	Иначе
		
		СписокРасширений = "Нет";
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("СписокРасширений", СписокРасширений);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИнформацияОСервере()
	
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	
	ИнформацияОСНаСервере = Новый Структура;
	ИнформацияОСНаСервере.Вставить("ВерсияОС", ИнформацияОСистеме.ВерсияОС);
		
	Возврат ИнформацияОСНаСервере;
	
КонецФункции