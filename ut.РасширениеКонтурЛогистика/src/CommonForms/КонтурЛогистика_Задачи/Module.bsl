&НаКлиенте
Процедура УстановитьОтборСостояние(Команда)
	
	Если Команда.Имя = "УстановитьОтборСостояниеАктивные" Тогда 
		ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Активные"); 
	ИначеЕсли Команда.Имя = "УстановитьОтборСостояниеСделать" Тогда 
		ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.МоиЗадачи"); 
	ИначеЕсли Команда.Имя = "УстановитьОтборСостояниеНаКонтроле" Тогда 
		ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.НаКонтроле"); 
	ИначеЕсли Команда.Имя = "УстановитьОтборСостояниеВсе" Тогда 
		ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Все"); 
	ИначеЕсли Команда.Имя = "УстановитьОтборСостояниеЗавершенные" Тогда 
		ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Завершенные"); 
	ИначеЕсли Команда.Имя = "УстановитьОтборСостояниеОшибки" Тогда 
		ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Ошибки"); 
	КонецЕсли;
	
	Элементы.УстановитьОтборСостояниеАктивные.Картинка = Новый Картинка;
	Элементы.УстановитьОтборСостояниеСделать.Картинка = Новый Картинка;
	Элементы.УстановитьОтборСостояниеНаКонтроле.Картинка = Новый Картинка;
	Элементы.УстановитьОтборСостояниеВсе.Картинка = Новый Картинка;
	Элементы.УстановитьОтборСостояниеЗавершенные.Картинка = Новый Картинка;
	Элементы.УстановитьОтборСостояниеОшибки.Картинка = Новый Картинка;
	
	ОбычныйШрифт = Элементы.УстановитьОтборСостояниеЭталонШрифта.Шрифт;
	Элементы.УстановитьОтборСостояниеАктивные.Шрифт = ОбычныйШрифт;
	Элементы.УстановитьОтборСостояниеСделать.Шрифт = ОбычныйШрифт;
	Элементы.УстановитьОтборСостояниеНаКонтроле.Шрифт = ОбычныйШрифт;
	Элементы.УстановитьОтборСостояниеВсе.Шрифт = ОбычныйШрифт;
	Элементы.УстановитьОтборСостояниеЗавершенные.Шрифт = ОбычныйШрифт;
	Элементы.УстановитьОтборСостояниеОшибки.Шрифт = ОбычныйШрифт;
	
	ЖирныйШрифт = Элементы.УстановитьОтборСостояниеЭталонШрифтаЖирный.Шрифт;
	
	НажатаяКнопка = Элементы[Команда.Имя];
	НажатаяКнопка.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПунктТекущийНевыполнен;
	НажатаяКнопка.Шрифт = ЖирныйШрифт;
	
	УстановитьОтборДинСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ИконкаСтрелкиНажатие(Элемент)
	
	Элементы.Управление.Видимость = Не Элементы.Управление.Видимость;
	Элементы.ДекорацияНадписьОтборы.Видимость = Не Элементы.Управление.Видимость;
	Если Элементы.Управление.Видимость Тогда 
		Элементы.ИконкаСтрелки.Картинка = БиблиотекаКартинок.КонтурЛогистика_Сворачивалка;
	Иначе
		Элементы.ИконкаСтрелки.Картинка = БиблиотекаКартинок.КонтурЛогистика_Раскрывашка
	КонецЕсли;
	
КонецПроцедуры

