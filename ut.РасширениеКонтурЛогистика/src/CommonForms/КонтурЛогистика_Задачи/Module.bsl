	КонецЕсли;
	
	// Контекстное меню
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ВнестиИсправлениеТитула", ЭтоТРН);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СоздатьПереадресацию", ЭтоТРН);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СоздатьЭстафету", ЭтоТРН);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ПечатьТранспортнойНакладной", ЭтоТРН Или ЭтоПЛ);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ПоказатьПечатнуюФормуТранспортнойНакладной", ЭтоТРН Или ЭтоПЛ);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_Создать1ТрнПоВыделенным",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_Создать1ПлПоВыделенным",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы",
		СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы",
		СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы);
	
	// Отборы ПЛ по реквизитам учетного докуме
	УстановитьВидимостьЭлемента("ОтборВодитель", Ложь);
	УстановитьВидимостьЭлемента("ОтборТранспортноеСредство", Ложь);
	УстановитьВидимостьЭлемента("ОтборМедРаботник", Ложь);
	УстановитьВидимостьЭлемента("ОтборОтветственныйЗаОформление", Ложь);
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		СоздатьРеквизитыОтбораСписка("Водитель");
		СоздатьРеквизитыОтбораСписка("ТранспортноеСредство");
		
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборВодитель", "Водитель");
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборТранспортноеСредство", "Транспортное средство");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
		
		СоздатьРеквизитыОтбораСписка("Водитель");
		СоздатьРеквизитыОтбораСписка("МедРаботник");
		
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборВодитель", "Водитель");
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборМедРаботник", "Мед. работник");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		СоздатьРеквизитыОтбораСписка("ОтветственныйЗаОформление");
		СоздатьРеквизитыОтбораСписка("ТранспортноеСредство");
		
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборОтветственныйЗаОформление", "Тех. работник");
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборТранспортноеСредство", "Транспортное средство");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыОтбораСписка(ИмяРеквизита)
	
	ИмяРеквизитаФормы = "Отбор" + ИмяРеквизита;
	Для Каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если Реквизит.Имя = ИмяРеквизитаФормы Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	РезультатПоиска = ЗадачиДинамическийСписок.Отбор.ДоступныеПоляОтбора.Элементы.Найти(ИмяРеквизита);
	Если РезультатПоиска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизит(ЭтаФорма, ИмяРеквизитаФормы, РезультатПоиска.Тип);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементФормыРеквизитаОтбораСписка(ИмяЭлемента, Заголовок)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент <> Неопределено Тогда
		НайденныйЭлемент.Видимость = Истина;
		Возврат;
	КонецЕсли;
	
	СобытияЭФ = Новый Структура;
	СобытияЭФ.Вставить("ПриИзменении", "УстановитьОтборДинСписка");
	
	СвойстваЭФ = Новый Структура;
	СвойстваЭФ.Вставить("КнопкаОчистки", Истина);
	СвойстваЭФ.Вставить("ПодсказкаВвода", "<все>");
	СвойстваЭФ.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Верх);
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздПоле(ЭтаФорма, ИмяЭлемента, Элементы.Группа2,
		Заголовок, 1, ИмяЭлемента, СвойстваЭФ, СобытияЭФ);
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементСписка(ИмяЭлемента, Родитель, Назначение = Неопределено)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Переместить(НайденныйЭлемент, Родитель, Назначение);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлемента(ИмяЭлемента, ЗначениеВидимости)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	
	Если НайденныйЭлемент = Неопределено Тогда
		Если Не ЗначениеВидимости Тогда
			Возврат;
		КонецЕсли;
		
		// ЭТрН
		Если ИмяЭлемента = "ЗадачиДинамическийСписокСтоимостьБезНДС" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Стоимость перевозки");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокВодительЛогистика" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Водитель");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокВодитель" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Водитель");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокМестоПогрузки" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Место погрузки");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокМестоДоставки" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Место доставки");
		// ЭПЛ
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокВидПеревозки" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Вид перевозки");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокТранспортноеСредство" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Транспортное средство");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокДатаИВремяОформления" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Дата и время техосмотра");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокОтветственныйЗаОформление" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Тех. работник");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокОдометрРаботник" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Ответственный");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокПоказанияОдометра" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Показания одометра");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокМедРаботник" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Мед. работник");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокДатВрПрМО" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Дата и время медосмотра");
		КонецЕсли;
	Иначе
		НайденныйЭлемент.Видимость = ЗначениеВидимости;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, ЗаголовокЭлемента)
	
	НовыйЭлемент = Неопределено;
	Префикс = "ЗадачиДинамическийСписок";
	ТипКолонки = 0;
	
	Попытка
		НовыйЭлемент = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(ЭтаФорма, ИмяЭлемента,
			Элементы.ЗадачиДинамическийСписок, ТипКолонки, ЗаголовокЭлемента, СтрЗаменить(ИмяЭлемента, Префикс, Префикс + "."));
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьДоступностьДополнительныхКолонок(НастройкаКонвертацииДокумента)
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертацииДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если СпецСценарий <> Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя И ТипДокументаКонфигурации <> "Все типы" Тогда
		
		Для Каждого ТекущаяКолонка Из НастройкаКонвертацииДокумента.ДополнительныеКолонки Цикл
			
			НомерКолонки = Формат(ТекущаяКолонка.НомерСтроки, "ЧГ=0");
			ИмяДопКолонки = "ЗадачиДинамическийСписокДоп" + НомерКолонки;
			
			НайденныйЭлемент = Элементы.Найти(ИмяДопКолонки);
			Если НайденныйЭлемент <> Неопределено Тогда
				НайденныйЭлемент.Видимость = Истина;
				НайденныйЭлемент.Заголовок = ТекущаяКолонка.Заголовок;
				Продолжить;
			КонецЕсли;
			
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(ЭтаФорма, ИмяДопКолонки, Элементы.ЗадачиДинамическийСписок,
				0, ТекущаяКолонка.Заголовок, "ЗадачиДинамическийСписок.Доп" + НомерКолонки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Удалим лишние
	Для Счет = (НастройкаКонвертацииДокумента.ДополнительныеКолонки.Количество() + 1) По 99 Цикл
		НомерКолонки = Формат(Счет, "ЧГ=0");
		ИмяДопКолонки = "ЗадачиДинамическийСписокДоп" + НомерКолонки;
		
		НайденныйЭлемент = Элементы.Найти(ИмяДопКолонки);
		Если НайденныйЭлемент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НайденныйЭлемент.Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УпорядочитьПоТребуемомуДействию()
	
	Перем УсловиеСортировки, Элемент, ЭлементыПользовательскихНастроек;
	
	Если ОшибкаНастройкиТекущегоТипа Тогда 
		Возврат;
	КонецЕсли;
	
	ЭлементыПользовательскихНастроек = ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Для Каждого Элемент Из ЭлементыПользовательскихНастроек Цикл
		Если ТипЗнч(Элемент) = ТипЗнч(ЗадачиДинамическийСписок.КомпоновщикНастроек.Настройки.Порядок) Тогда
			Элемент.Элементы.Очистить();
			УсловиеСортировки = Элемент.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			УсловиеСортировки.Поле = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
			УсловиеСортировки.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
			УсловиеСортировки.Использование = Истина;
		КонецЕсли;    
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДинамическогоСписка()
	
	ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
	// Введенные титулы могут по дате отличаться от предыдущих - расширим диапазон анализа текущего документа
	Если ЗадачиДинамическийСписок.Параметры.Элементы.Найти("НачалоПериодаПоследующийТитул") <> Неопределено Тогда 	
		Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
			ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПоследующийТитул", Период.ДатаНачала);
		Иначе
			ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПоследующийТитул", Период.ДатаНачала - 5 * 86400);
		КонецЕсли;
	КонецЕсли;
	
	// Определяем дополнительные параметры запроса в зависимости от типа титула и специального сценария
	ПараметрыСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПараметрыСпискаПоТипуЛогистики(ТипЛогистика, СпецСценарий);
	Для Каждого ТекущийПараметр Из ПараметрыСписка Цикл
		ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
	КонецЦикла;
	
	// Введенные титулы могут по дате отличаться от предыдущих - расширим диапазон анализа текущего документа
	СекундВЧасе = 60 * 60;
	СмещениеОкончанияПериода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СмещениеОкончанияПериодаСпискаЗадач") * СекундВЧасе;
	ОкончаниеПериода = Период.ДатаОкончания + СмещениеОкончанияПериода;
	ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ОкончаниеПериода", ОкончаниеПериода);
	Если ЗадачиДинамическийСписок.Параметры.Элементы.Найти("ОкончаниеПериодаПоследующийТитул") <> Неопределено Тогда
		ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ОкончаниеПериодаПоследующийТитул", ОкончаниеПериода + 5 * 86400);
	КонецЕсли;
	
	Если ЗадачиДинамическийСписок.Параметры.Элементы.Найти("ТекущийПользователь") <> Неопределено Тогда
		ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
 	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКонтент()
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда
		
		УстановитьПараметрыДинамическогоСписка();
		текСинонимДокумента = "";
		Если ТипДокументаКонфигурации <> "Все типы"
			И ТипДокументаКонфигурации <> "Ручной ввод" Тогда
			
			текСинонимДокумента = СинонимДокумента1СПоИмени(ТипДокументаКонфигурации);
		Иначе
			текСинонимДокумента = ТипДокументаКонфигурации;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпецСценарий) Тогда 
			
			Заголовок = "Задачи: " 
					+ ТипЛогистика
					+ " "
					+ СпецСценарий;
		Иначе	
			
			Заголовок = "Задачи: " 
					+ ТипЛогистика 
					+ " по " 
					+ текСинонимДокумента;
					
				КонецЕсли;
				
		Элементы.ЗадачиДинамическийСписок.Обновить();
		
		УстановитьЗаголовокОтбора();
		УстановитьВидимостьДоступностьЭлементов();
		ВыполнитьПроверкуАктуальностиГраницы();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокОтбора()
	
	Элементы.ДекорацияНадписьОтборы.Заголовок = "";
	
	НовыйЗаголовок = "";
	Если ЗначениеЗаполнено(ОтборГрузоотправитель) Тогда 
		НовыйЗаголовок = НовыйЗаголовок + " ГО: " + ОтборГрузоотправитель;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПеревозчик) Тогда 
		НовыйЗаголовок = НовыйЗаголовок + " ПВ: " + ОтборПеревозчик;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборГрузополучатель) Тогда 
		НовыйЗаголовок = НовыйЗаголовок + " ГП: " + ОтборГрузополучатель;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПогрузка) Тогда 
		НовыйЗаголовок = НовыйЗаголовок + " Погр.: " + ОтборПогрузка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборВыгрузка) Тогда 
		НовыйЗаголовок = НовыйЗаголовок + " Выгр.: " + ОтборВыгрузка;
	КонецЕсли;
	
	Если Элементы.Найти("ОтборВодитель") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборВодитель"]) Тогда
		НовыйЗаголовок = НовыйЗаголовок + " Водитель: " + ЭтаФорма["ОтборВодитель"];
	КонецЕсли;
	
	Если Элементы.Найти("ОтборТранспортноеСредство") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборТранспортноеСредство"]) Тогда
		НовыйЗаголовок = НовыйЗаголовок + " ТС: " + ЭтаФорма["ОтборТранспортноеСредство"];
	КонецЕсли;
	
	Если Элементы.Найти("ОтборМедРаботник") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборМедРаботник"]) Тогда
		НовыйЗаголовок = НовыйЗаголовок + " Мед. работник: " + ЭтаФорма["ОтборМедРаботник"];
	КонецЕсли;
	
	Если Элементы.Найти("ОтборОтветственныйЗаОформление") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборОтветственныйЗаОформление"]) Тогда
		НовыйЗаголовок = НовыйЗаголовок + " Тех. работник: " + ЭтаФорма["ОтборОтветственныйЗаОформление"];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовыйЗаголовок) Тогда
		Элементы.ДекорацияНадписьОтборы.Заголовок = "(" + НовыйЗаголовок + ")";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокИсходныхДокументов(Команда)
	
	Если ТипДокументаКонфигурации = "Все типы"
		Или ТипДокументаКонфигурации = "Ручной ввод" Тогда
		
		ТипыДокументов1СМассив = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(ТипЛогистика);
		
		Для Каждого ВозможныйТипДокументаКонфигурации Из ТипыДокументов1СМассив Цикл
			Если ЗначениеЗаполнено(ВозможныйТипДокументаКонфигурации) Тогда 
				ОткрытьФорму("Документ." + ВозможныйТипДокументаКонфигурации + ".ФормаСписка");
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ОткрытьФорму("Документ." + ТипДокументаКонфигурации + ".ФормаСписка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНастройкамКонвертации(Команда)
	
	НастройкиКонфигураций = Новый Массив;
	
	Если ТипДокументаКонфигурации = "Все типы" Тогда
		
		НастройкиКонфигураций =
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МассивНастроекКонвертацииПоТипуЛогистики(ТипЛогистика);
		
	ИначеЕсли ТипДокументаКонфигурации = "Ручной ввод" Тогда
		
		НастройкиКонфигураций.Добавить(
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииПустойТипДокумента1С(ТипЛогистика));
		
	ИначеЕсли ЗначениеЗаполнено(ТипДокументаКонфигурации) Тогда
		
		НастройкиКонфигураций.Добавить(
			КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертации(ТипЛогистика, ТипДокументаКонфигурации));
		
	ИначеЕсли ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		
		НастройкиКонфигураций.Добавить(НастройкаКонвертации);
		
	Иначе
		
		Сообщить("Не могу определить конкретную настройку конвертации, открыт список");
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ФормаСписка",,
			ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьПереинициализироватьФорму");
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого ТекущаяНастройкаКонфигурации Из НастройкиКонфигураций Цикл
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			ТекущаяНастройкаКонфигурации, ЭтаФорма, "ОбработчикОбновитьПереинициализироватьФорму");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЛогистикаПриИзменении(Элемент = Неопределено)
	
	Если Элемент <> Неопределено И Не ТитулДоступенПользователю(ТипЛогистика) Тогда
		ТекстСообщения = "Вам не доступны документы: " + Строка(ТипЛогистика) + ". Обратитесь к администратору.";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстСообщения);
		
		ТипЛогистика = ТипЛогистикаДоИзменения;
		
		Возврат;
	КонецЕсли;
	
	Если Элемент <> Неопределено Тогда
		// Отключим спец сценарий
		СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
	КонецЕсли;
	
	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()
	
	ОбработатьНовыйТипДокументаЛогистикаСервер();
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда 
		ОбновитьКонтент();
		УстановитьОтборДинСписка();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоДопКолонок(ТипЛогистика, ТипДокументаКонфигурации, НастройкаКонвертации) 
	
	Если ТипДокументаКонфигурации = "Ручной ввод" Тогда
		НастройкаКонвертацииДокументов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(
			ТипЛогистика)	
	Иначе
		НастройкаКонвертацииДокументов = НастройкаКонвертации;
	КонецЕсли;
		
	Возврат НастройкаКонвертацииДокументов.ДополнительныеКолонки.Количество();

КонецФункции

&НаКлиенте
Процедура УстановитьОтборДинСписка()
	
	ЗадачиДинамическийСписок.Отбор.Элементы.Очистить();
	
	Если Не ЗначениеЗаполнено(СпецСценарий) Тогда
		
		Для инд = 1 По КоличествоДопКолонок(ТипЛогистика, ТипДокументаКонфигурации, НастройкаКонвертации) Цикл
				
			ДопКолонкаИмя = "Доп" + Строка(инд);
		
			Если ЕстьРеквизитФормы("ОтборДопКолонка" + ДопКолонкаИмя) И ЗначениеЗаполнено(ЭтаФорма["ОтборДопКолонка" + ДопКолонкаИмя]) Тогда
				
				ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ДопКолонкаИмя);
				ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборДопКолонка" + ДопКолонкаИмя];
				
				Если ТипЗнч(ЭтаФорма["ОтборДопКолонка" + ДопКолонкаИмя]) = Тип("Строка") Тогда
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
				Иначе
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				КонецЕсли;
				
				ЭлементОтбора.Использование = Истина;
				
			КонецЕсли;
			
		КонецЦикла; 
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборГрузоотправитель) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Отправитель");
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда 
			ЭлементОтбора.ПравоеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьСвязанныеОбъекты(ОтборГрузоотправитель);
			ЭлементОтбора.ПравоеЗначение.Добавить(ОтборГрузоотправитель);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ПравоеЗначение = ОтборГрузоотправитель;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПеревозчик) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Перевозчик");
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда 
			ЭлементОтбора.ПравоеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьСвязанныеОбъекты(ОтборПеревозчик);
			ЭлементОтбора.ПравоеЗначение.Добавить(ОтборПеревозчик);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ПравоеЗначение = ОтборПеревозчик;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборГрузополучатель) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Получатель");
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда 
			ЭлементОтбора.ПравоеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьСвязанныеОбъекты(ОтборГрузополучатель);
			ЭлементОтбора.ПравоеЗначение.Добавить(ОтборГрузополучатель);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ПравоеЗначение = ОтборГрузополучатель;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПогрузка) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МестоПогрузки");
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда 
			ЭлементОтбора.ПравоеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьСвязанныеОбъекты(ОтборПогрузка);
			ЭлементОтбора.ПравоеЗначение.Добавить(ОтборПогрузка);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ПравоеЗначение = ОтборПогрузка;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборВыгрузка) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МестоДоставки");
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда
			ЭлементОтбора.ПравоеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьСвязанныеОбъекты(ОтборВыгрузка);
			ЭлементОтбора.ПравоеЗначение.Добавить(ОтборВыгрузка);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ПравоеЗначение = ОтборВыгрузка;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборВодитель") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборВодитель"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Водитель");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборВодитель"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборТранспортноеСредство") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборТранспортноеСредство"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТранспортноеСредство");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборТранспортноеСредство"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборМедРаботник") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборМедРаботник"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МедРаботник");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборМедРаботник"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборОтветственныйЗаОформление") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборОтветственныйЗаОформление"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтветственныйЗаОформление");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборОтветственныйЗаОформление"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборТребуемоеДействие) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
		ЭлементОтбора.ПравоеЗначение = ОтборТребуемоеДействие;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	Иначе
		
		Если ОтборСостояние <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Все") Тогда
			
			Если ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.МоиЗадачи") Тогда
				
				Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2")
					Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
					
					ГруппаОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
					ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
					
					ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОсобенностиДокументооборота");
					ЭлементОтбора.Использование = Истина;
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
				Иначе
					ГруппаОтбора = ЗадачиДинамическийСписок.Отбор;
				КонецЕсли;
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				ЭлементОтбора.ПравоеЗначение = МассивТребуемыхДействийМои();
				
			Иначе
				
				ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена");
				
				Если ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Активные") Тогда
					
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
					ЭлементОтбора.ПравоеЗначение = МассивТребуемыхДействийАктивные();
					
				ИначеЕсли ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.НаКонтроле") Тогда
					
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
					ЭлементОтбора.ПравоеЗначение = МассивТребуемыхДействийНаКонтроле();
					
				ИначеЕсли ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Ошибки") Тогда
					
					ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки");
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					
				Иначе
					
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе			
		
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ЗадачиДинамическийСписок.Обновить();
	УстановитьЗаголовокОтбора();
	
