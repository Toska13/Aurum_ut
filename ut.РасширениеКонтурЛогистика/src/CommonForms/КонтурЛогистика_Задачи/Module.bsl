КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПоУмолчанию(Команда)
	
	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул3")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул5")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул7")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул9")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")
		
		Тогда
		
		// доступны команды ввода из док 1С учетной системы
		ВозможенВводИз1С = Истина;
		
	Иначе // титулы вводятся из предыдущего титула
		
		// не доступны команды ввода из док 1С учетной системы
		ВозможенВводИз1С = Ложь;
		
	КонецЕсли;
	
	// раскидаем на 3 разных потока УчДок / Титул / ПредыдущийТитул
	МассивОписанийДокументовПодсистемыЛогистика = Новый Массив;
	МассивОписанийДокументовУчетнойСистемы = Новый Массив;
	МассивПредыдущихДокументовПодсистемыЛогистика = Новый Массив;
		
	ВыделенныеСтрокиЗадач = ЭтаФорма.Элементы.ЗадачиДинамическийСписок.ВыделенныеСтроки;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтрокиЗадач Цикл 
		
		ДанныеСтроки = ЭтаФорма.Элементы.ЗадачиДинамическийСписок.ДанныеСтроки(ВыделеннаяСтрока);
		
		ОписаниеДокумента = Новый Структура;
		ОписаниеДокумента.Вставить("ТребуемоеДействие", ДанныеСтроки.ТребуемоеДействие);
		ОписаниеДокумента.Вставить("Документ", ДанныеСтроки.ДокументЛогистика);
		ОписаниеДокумента.Вставить("Документ1С", ДанныеСтроки.Документ1С);
		ОписаниеДокумента.Вставить("ПредыдущийТитул", ДанныеСтроки.ПредыдущийТитул);
		ДанныеЗаполненияСтруктура = Новый Структура;
		Если ДанныеСтроки.Свойство("Водитель") Тогда 
			ДанныеЗаполненияСтруктура.Вставить("Водитель", ДанныеСтроки.Водитель);
		КонецЕсли;
		ОписаниеДокумента.Вставить("ДанныеЗаполнения", ДанныеЗаполненияСтруктура);
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ДокументЛогистика) Тогда	
			МассивОписанийДокументовПодсистемыЛогистика.Добавить(ОписаниеДокумента);
			
		ИначеЕсли ВозможенВводИз1С Тогда 
			МассивОписанийДокументовУчетнойСистемы.Добавить(ОписаниеДокумента);
			
		ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ПредыдущийТитул) Тогда 
			МассивПредыдущихДокументовПодсистемыЛогистика.Добавить(ОписаниеДокумента);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	// действия с самим титулом
	Если МассивОписанийДокументовПодсистемыЛогистика.Количество() > 0 Тогда
		
		МассивТитулов = Новый Массив;
		Для Каждого ОписаниеДокумента Из МассивОписанийДокументовПодсистемыЛогистика Цикл 
			МассивТитулов.Добавить(ОписаниеДокумента.Документ);
		КонецЦикла;
		
		КонтурЛогистика_ОбработкаДокументовКлиент.ВыполнитьТекущиеТребуемыеДействия(МассивТитулов, ПараметрыВыполненияКоманды);
		
	КонецЕсли;
	
	// действия по вводу документа титула из документа 1С
	Если МассивОписанийДокументовУчетнойСистемы.Количество() > 0 Тогда
		
		МассивДокументовУчСист = Новый Массив;
		Для Каждого ОписаниеДокумента Из МассивОписанийДокументовУчетнойСистемы Цикл 
			МассивДокументовУчСист.Добавить(ОписаниеДокумента.Документ1С); // документ1С - это докумнет учетной системы
		КонецЦикла;
		
		Для Каждого ДокументУчСист Из МассивДокументовУчСист Цикл 
			
			// требуется понять какое действие делать: отправлять подписанный или неподписанный
			ТипыЛогистика = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьТипыЛогистики(ДокументУчСист, ТипЛогистика);
			ДействиеПоУмолч = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьДействиеПоУмолчаниюДокУчСист(ДокументУчСист, ТипыЛогистика);
			
			МассивДокументовУчетнойСистемы = Новый Массив;
			МассивДокументовУчетнойСистемы.Добавить(ДокументУчСист);
			
			ВведенныеДокументыПодсистемы = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиДокументы(МассивДокументовУчетнойСистемы, ТипЛогистика);
			
			КонтурЛогистика_ОбработкаДокументовКлиент.ВыполнитьТекущиеТребуемыеДействия(ВведенныеДокументыПодсистемы, ПараметрыВыполненияКоманды);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// действия по вводу документа титула из предыдущего документа титула
	Если МассивПредыдущихДокументовПодсистемыЛогистика.Количество() > 0 Тогда
		
		МассивПредыдущихТитулов = Новый Массив;
		Для Каждого ОписаниеДокумента Из МассивПредыдущихДокументовПодсистемыЛогистика Цикл 
			МассивПредыдущихТитулов.Добавить(ОписаниеДокумента.ПредыдущийТитул);
		КонецЦикла;
		ДанныеЗаполненияМассивСтруктур = Новый Массив;
		Для Каждого ОписаниеДокумента Из МассивПредыдущихДокументовПодсистемыЛогистика Цикл 
			ДанныеЗаполненияМассивСтруктур.Добавить(ОписаниеДокумента.ДанныеЗаполнения);
		КонецЦикла;
		
		МассивВведенныхТитулов = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеДокументыТитулыПакетно(ТипЛогистика, МассивПредыдущихТитулов, ДанныеЗаполненияМассивСтруктур);
		Если МассивВведенныхТитулов.Количество() > 0 Тогда 
			КонтурЛогистика_ОбработкаДокументовКлиент.ВыполнитьТекущиеТребуемыеДействия(МассивВведенныхТитулов, ПараметрыВыполненияКоманды);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМинимальнуюДатуГраницыСинхронизации()
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОбщуюМинимальнуюДатуГраницыСинхронизации();
	
КонецФункции

&НаСервереБезКонтекста
Функция ТитулДоступенПользователю(ТипДокумента)
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	ПолныйДоступ = ДоступыПользователя.ПолныйДоступ;
	
	Если ПолныйДоступ Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДоступКТитулам = ДоступыПользователя.ДоступКТитулам;
	
	ТолькоПросмотрЭлементов = ДоступКТитулам.ТолькоПросмотр.Получить(ТипДокумента);
	СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТипДокумента);
	
	Возврат (ТолькоПросмотрЭлементов Или СозданиеРедактированиеЭлементов);
	
КонецФункции

&НаСервере
Процедура ОбновитьОтображениеПоГруппамДоступа()
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ДоступыПользователя = КонтурЛогистика_ОбщегоНазначенияСервер.ДоступыПользователя(ТекущийПользователь);
	
	Если ДоступыПользователя.ПолныйДоступ Тогда
		Возврат;
	КонецЕсли;
	
	ДоступКТитулам = ДоступыПользователя.ДоступКТитулам;
	
	СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(ТипЛогистика);
	Для Каждого ТекущийЭлемент Из ГруппаЭлементовРаботыСДокументом() Цикл
		ТекущийЭлемент.Доступность = СозданиеРедактированиеЭлементов;
	КонецЦикла;
	
	// Титул 7
	Титул7 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7;
	СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(Титул7);
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_СоздатьПереадресацию.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_СоздатьПереадресацию1.Доступность = СозданиеРедактированиеЭлементов;
	
	// Титул 8
	Титул8 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8;
	СозданиеРедактированиеЭлементов = ДоступКТитулам.СозданиеРедактирование.Получить(Титул8);
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_СоздатьЭстафету.Доступность = СозданиеРедактированиеЭлементов;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_СоздатьЭстафету1.Доступность = СозданиеРедактированиеЭлементов;
	
КонецПроцедуры

&НаСервере
Функция ГруппаЭлементовРаботыСДокументом()
	
	ГруппаЭлементов = Новый Массив;
	
	ГруппаЭлементов.Добавить(Элементы.ФормаВыполнитьДействиеПоУмолчанию);
	
	// Группа Управление (Т1)
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_Создать1ТрнПоВыделенным");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_Создать1ПлПоВыделенным");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_СоздатьЧерновик");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ВнестиИсправлениеТитула");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыДиадок");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПропуститьОбработкуВходящегоДокумента");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание");
	
	// Группа Управление (Другие)
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ВвестиСледующийТитул");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный1");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке1");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИОтправить1");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПодписатьИПодготовитьКОтправке1");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыДиадок1");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПропуститьОбработкуВходящегоДокумента1");
	
	// Группа Еще
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПоказатьФайлыОбмена");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_СформироватьФайлыОбмена");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаНовыйТитул");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ПропуститьДокумент");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ИзменитьСтатусДокумента");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ИзменитьСостояниеДокумента");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыЛогистика");
	ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, "ФормаОбщаяКомандаКонтурЛогистика_ЗаполнитьДокументУчетнойСистемыПоТитулу");
	
	Возврат ГруппаЭлементов;
	
КонецФункции

&НаСервере
Процедура ДобавитьЭлементФормыВГруппуПоИмени(ГруппаЭлементов, ИмяЭлементаФормы)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлементаФормы);
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаЭлементов.Добавить(НайденныйЭлемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиСценариеАвтоматическойРаботыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТипЛогистика", ТипЛогистика);
	
	ПараметрыФормы = Новый Структура("Отбор", ПараметрыОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиГСМНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипЛогистика", ТипЛогистика);
	ПараметрыФормы.Вставить("ОтборСтатус", "Ошибка");
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_ПроизвольныеДанные.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеУведомлений()
	
	КонтурЛогистика_ОбновлениеКлиент.ПроверитьНаличиеУведомлений(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборыДополнительныхКолонокНаФорму()
	
	Для каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если Лев(Реквизит.Имя, 15) = "ОтборДопКолонка" Тогда	
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.УдлРеквизитИЭлемент(ЭтаФорма, Реквизит.Имя);				
		КонецЕсли;		
	КонецЦикла;
	
	Если ТипДокументаКонфигурации = "Ручной ввод" Тогда
		НастройкаКонвертацииДокументов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьНастройкуКонвертацииТ1РучногоВвода(
			ТипЛогистика)	
	Иначе
		НастройкаКонвертацииДокументов = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
			ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СпецСценарий) Или Не ЗначениеЗаполнено(НастройкаКонвертацииДокументов) Тогда
		Возврат;
	КонецЕсли;
			
	н = 1;
	Для каждого ДопКолонка Из НастройкаКонвертацииДокументов.ДополнительныеКолонки Цикл
		
		ИмяДопРеквизита = "ОтборДопКолонкаДоп" + Формат(ДопКолонка.НомерСтроки, "ЧГ=0");
		
		Если Элементы.Найти(ИмяДопРеквизита) <> Неопределено Тогда
			Элементы[ИмяДопРеквизита].Видимость = ДопКолонка.Отбор;	
		ИначеЕсли Не ДопКолонка.Отбор Тогда
			Продолжить;
		КонецЕсли;
								
		Если Не ЕстьРеквизитФормы(ИмяДопРеквизита) Тогда
						
			Типы = Новый Массив;                                                                      
			стрТипы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ДопКолонка.Тип, ";");
			Для каждого стрТип Из стрТипы Цикл
				Типы.Добавить(Тип(стрТип));	
			КонецЦикла;
			ОписаниеТипов = Новый ОписаниеТипов(Типы);
			
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизит(ЭтаФорма, ИмяДопРеквизита, ОписаниеТипов);
			
		КонецЕсли;
								
		Если Элементы.Найти(ИмяДопРеквизита) = Неопределено Тогда
		
			СобытияЭФ = Новый Структура;  
			СобытияЭФ.Вставить("ПриИзменении", "УстановитьОтборДинСписка");
			
			СвойстваЭФ = Новый Структура;  
			СвойстваЭФ.Вставить("КнопкаОчистки", Истина);
			СвойстваЭФ.Вставить("РастягиватьПоГоризонтали", Истина);
			СвойстваЭФ.Вставить("Подсказка", "Доп" + Формат(ДопКолонка.НомерСтроки, "ЧГ=0"));
			
			Если н % 3 = 1 Или н = 1 Тогда
				Родитель = Элементы.ОтборДопКолонки1;
			ИначеЕсли н % 3 = 2 Или н = 2 Тогда
				Родитель = Элементы.ОтборДопКолонки2;
			Иначе
				Родитель = Элементы.ОтборДопКолонки3;
			КонецЕсли;
			
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздПоле(ЭтаФорма, ИмяДопРеквизита, Родитель, ДопКолонка.Заголовок, 1, ИмяДопРеквизита, СвойстваЭФ, СобытияЭФ);
			
			н = н + 1;
			
		Иначе
			
			Элементы[ИмяДопРеквизита].Заголовок = ДопКолонка.Заголовок;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьРеквизитФормы(Имя)
	
	Для каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#Область ПоказатьТекстЗапроса

&НаСервере
Функция ДанныеЗапроса()	
	
	СписокПараметров = Новый СписокЗначений;
	Для каждого Параметр Из ЗадачиДинамическийСписок.Параметры.Элементы Цикл
		
		Если Не Параметр.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		СписокПараметров.Добавить(Параметр.Значение, Строка(Параметр.Параметр));
		
	КонецЦикла;
	
	Отборы = Новый СписокЗначений;
	ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, ЗадачиДинамическийСписок.Отбор.Элементы);
	Для каждого ПользовательскаяНастройка Из  ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ПользовательскаяНастройка) = Тип("ОтборКомпоновкиДанных") Тогда
			ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, ПользовательскаяНастройка.Элементы);	
		КонецЕсли;
	КонецЦикла;
	 		
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ТекстЗапроса", ЗадачиДинамическийСписок.ТекстЗапроса);
	ДанныеЗапроса.Вставить("ПараметрыЗапроса", СписокПараметров);
	ДанныеЗапроса.Вставить("Отборы", Отборы);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Процедура ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, Элементы)
	
	Для каждого Отбор Из Элементы Цикл
		
		Если Не Отбор.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДанныеОтбора = Новый Структура;
			ДанныеОтбора.Вставить("Имя", Строка(Отбор.ТипГруппы));
			ДанныеОтбора.Вставить("ЭтоГруппа", Истина);
			ДанныеОтбора.Вставить("Элементы", Новый СписокЗначений);
						
			Отборы.Добавить(ДанныеОтбора, Строка(Отбор.ТипГруппы));
			
			ДобавитьЭлементыОтбораКомпоновкиДанных(ДанныеОтбора.Элементы, Отбор.Элементы);
		Иначе
			ДанныеОтбора = Новый Структура;
			ДанныеОтбора.Вставить("Имя", Строка(Отбор.ЛевоеЗначение));
			ДанныеОтбора.Вставить("ВидСравнения", Отбор.ВидСравнения);
			ДанныеОтбора.Вставить("Значение", Отбор.ПравоеЗначение);
			ДанныеОтбора.Вставить("ЭтоГруппа", Ложь);
			
			Отборы.Добавить(ДанныеОтбора, Строка(Отбор.ЛевоеЗначение));	
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекстЗапроса(Команда)
			
	ПараметрыФормы = ДанныеЗапроса();	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФормаТекстаЗапроса", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиТРНизЗЗ(Команда)
	
	МассивЗЗ = Новый Массив;
	
	ВыделенныеСтрокиЗадач = ЭтаФорма.Элементы.ЗадачиДинамическийСписок.ВыделенныеСтроки;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтрокиЗадач Цикл 
		
		ДанныеСтроки = ЭтаФорма.Элементы.ЗадачиДинамическийСписок.ДанныеСтроки(ВыделеннаяСтрока);
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ДокументЛогистика) Тогда 
			Если (ТипЗнч(ДанныеСтроки.ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				Или ТипЗнч(ДанныеСтроки.ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2"))
			Тогда 
				МассивЗЗ.Добавить(ДанныеСтроки.ДокументЛогистика);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ПредыдущийТитул) Тогда	
			
			Если (ТипЗнч(ДанныеСтроки.ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				Или ТипЗнч(ДанныеСтроки.ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2"))
			Тогда 
				МассивЗЗ.Добавить(ДанныеСтроки.ПредыдущийТитул);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивЗЗ.Количество() > 0 Тогда 
		
		ПараметрыВыполненияКоманды = Новый Структура("Источник", ЭтаФорма);
		КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиТРНизЗЗ(МассивЗЗ, ПараметрыВыполненияКоманды);
	
	КонецЕсли;
		
КонецПроцедуры


#КонецОбласти