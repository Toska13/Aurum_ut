#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекПользовательЯвляетсяАдминистратором = КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор();
	
	Параметры.Свойство("СостояниеСертификата", СостояниеСертификата);
	Параметры.Свойство("СостояниеМЧД", СостояниеМЧД);
	Параметры.Свойство("Сертификат", Сертификат);
	Параметры.Свойство("МЧД", МЧД);
	Параметры.Свойство("ДопПараметр", ДопПараметр);
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиФормы()
	
	Если СостояниеСертификата = "Истек" И СостояниеМЧД = "Истекла" Тогда
		
		ЭтаФорма.Заголовок = "Заменить сертификат и МЧД";
		
		Элементы.ГруппаСертификат.Видимость = Истина;
		Элементы.ГруппаМЧД.Видимость = Истина;
		Элементы.НовыйСертификат.АвтоОтметкаНезаполненного = Истина;
		Элементы.НоваяМЧД.АвтоОтметкаНезаполненного = Истина;
		
	ИначеЕсли СостояниеСертификата = "Истек" И ПустаяСтрока(СостояниеМЧД) Тогда
		
		ЭтаФорма.Заголовок = "Заменить сертификат";
		
		Элементы.ГруппаСертификат.Видимость = Истина;
		Элементы.НовыйСертификат.АвтоОтметкаНезаполненного = Истина;
		Элементы.ГруппаМЧД.Видимость = Ложь;
						
	ИначеЕсли ПустаяСтрока(СостояниеСертификата) И СостояниеМЧД = "Истекла" Тогда
		
		ЭтаФорма.Заголовок = "Заменить МЧД";
		
		Элементы.ГруппаСертификат.Видимость = Ложь;
		Элементы.НоваяМЧД.АвтоОтметкаНезаполненного = Истина;
		Элементы.ГруппаМЧД.Видимость = Истина;
						
	ИначеЕсли СостояниеСертификата = "Истекает" И СостояниеМЧД = "Истекает" Тогда
		
		ЭтаФорма.Заголовок = "Заменить сертификат и/или МЧД";
		
		Элементы.ГруппаСертификат.Видимость = Истина;
		Элементы.НовыйСертификат.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		Элементы.НовыйСертификат.Подсказка = "Сертификат истекает. Можно выбрать новый для замены";
		Элементы.ГруппаМЧД.Видимость = Истина;
		Элементы.НоваяМЧД.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		Элементы.НоваяМЧД.Подсказка = "МЧД истекает. Можно выбрать новую для замены";
		
	ИначеЕсли СостояниеСертификата = "Истекает" И ПустаяСтрока(СостояниеМЧД) Тогда
		
		ЭтаФорма.Заголовок = "Заменить сертификат";
		
		Элементы.ГруппаСертификат.Видимость = Истина;
		Элементы.НовыйСертификат.АвтоОтметкаНезаполненного = Истина;
		Элементы.ГруппаМЧД.Видимость = Ложь;
						
	ИначеЕсли ПустаяСтрока(СостояниеСертификата) И СостояниеМЧД = "Истекает" Тогда
		
		ЭтаФорма.Заголовок = "Заменить МЧД";
		
		Элементы.ГруппаСертификат.Видимость = Ложь;
		Элементы.ГруппаМЧД.Видимость = Истина;
		Элементы.НоваяМЧД.АвтоОтметкаНезаполненного = Истина;
				
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&Насервере
Процедура ВыполнитьЗаменуСертификатМЧД(ВыбДата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Период КАК Период,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ОрганизацияДиадок КАК ОрганизацияДиадок,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С КАК Пользователь1С,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СертификатНаСервере КАК СертификатНаСервере,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДопПараметр КАК ДопПараметр,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат КАК Сертификат,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД КАК МЧД,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СвДоверБум_ДатаДовер КАК СвДоверБум_ДатаДовер,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СвДоверБум_ВнНомДовер КАК СвДоверБум_ВнНомДовер,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СтатусПодписанта КАК СтатусПодписанта,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.СпосПодтПолном КАК СпосПодтПолном
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних
		|ГДЕ
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат = &Сертификат
		|	И КонтурЛогистика_НастройкиПодписанияСрезПоследних.МЧД = &МЧД";
	
	Если ЗначениеЗаполнено(ДопПараметр) Тогда
		Запрос.Текст = Запрос.Текст + " И КонтурЛогистика_НастройкиПодписанияСрезПоследних.ДопПараметр = &ДопПараметр";
		Запрос.УстановитьПараметр("ДопПараметр", ДопПараметр);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	
	Если СостояниеСертификата = "Истек" И ПустаяСтрока(СостояниеМЧД) Тогда
		Запрос.УстановитьПараметр("Сертификат", Сертификат);
		Запрос.УстановитьПараметр("МЧД", Справочники.КонтурЛогистика_МЧД.ПустаяСсылка());
	ИначеЕсли СостояниеСертификата = "Истекает" И ПустаяСтрока(СостояниеМЧД) Тогда		
		Запрос.УстановитьПараметр("Сертификат", Сертификат);
		Запрос.УстановитьПараметр("МЧД", Справочники.КонтурЛогистика_МЧД.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("Сертификат", Сертификат);
		Запрос.УстановитьПараметр("МЧД", МЧД);	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Запись = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.СоздатьМенеджерЗаписи();		
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаДетальныеЗаписи);			
		Запись.Период = ВыбДата;
		
		Если ЗначениеЗаполнено(НовыйСертификат) Тогда
			Запись.Сертификат = НовыйСертификат;
		КонецЕсли;
		Если ЗначениеЗаполнено(НоваяМЧД) Тогда
			Запись.МЧД = НоваяМЧД;
		КонецЕсли;
			
		Запись.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заменить(Команда)
	
	Если СостояниеСертификата = "Истек" И СостояниеМЧД = "Истекла"  Тогда
		
		Если Не ЗначениеЗаполнено(НовыйСертификат) Тогда
			Сообщить("Не выбран сертификат");
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяМЧД) Тогда
			Сообщить("Не выбрана МЧД");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли СостояниеСертификата = "Истек" И ПустаяСтрока(СостояниеМЧД) И Не ЗначениеЗаполнено(НовыйСертификат) Тогда
		
		Сообщить("Не выбран сертификат");
		Возврат;
		
	ИначеЕсли ПустаяСтрока(СостояниеСертификата) И СостояниеМЧД = "Истекла" И Не ЗначениеЗаполнено(НоваяМЧД) Тогда
		
		Сообщить("Не выбрана МЧД");
		Возврат;
		
	ИначеЕсли СостояниеСертификата = "Истекает" И СостояниеМЧД = "Истекает" Тогда
		
		Если Не ЗначениеЗаполнено(НовыйСертификат) И Не ЗначениеЗаполнено(НоваяМЧД) Тогда
			Сообщить("Не выбран сертификат и/или МЧД");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли СостояниеСертификата = "Истекает" И ПустаяСтрока(СостояниеМЧД) И Не ЗначениеЗаполнено(НовыйСертификат) Тогда
		
		Сообщить("Не выбран сертификат");
		Возврат;
		
	ИначеЕсли ПустаяСтрока(СостояниеСертификата) И СостояниеМЧД = "Истекает" И Не ЗначениеЗаполнено(НоваяМЧД) Тогда
		
		Сообщить("Не выбрана МЧД");
		Возврат;
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыборДатыЗавершение", ЭтаФорма);
	ПоказатьВводДаты(Оповещение, ТекущаяДата(), "Начинает действовать с:", ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДатыЗавершение(ВыбДата, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбДата) Тогда
		Возврат;	
	КонецЕсли;
	
	ВыполнитьЗаменуСертификатМЧД(ВыбДата);
		
	Закрыть();
		
	Оповестить("КонтурЛогистика_ОбновитьФормуПроверкиСертификатов");
		
КонецПроцедуры

&НаКлиенте
Процедура НовыйСертификатНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтпечатокСертификата = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(Сертификат, "ОтпечатокСертификата"); 
		
	НастройкиКД = Новый НастройкиКомпоновкиДанных;

    ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СрокДействия");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
    ОтборСписка.ПравоеЗначение = ТекущаяДата();
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ОтборСписка.ПравоеЗначение = Ложь;
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтпечатокСертификата");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
    ОтборСписка.ПравоеЗначение = ОтпечатокСертификата;
    ОтборСписка.Использование = Истина;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ФиксированныеНастройки", НастройкиКД);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		 "Справочник.КонтурЛогистика_СертификатыЭлектроннойПодписи.ФормаВыбора",
		 ПараметрыВыбора,
		 ЭтаФорма,
		 ЭтаФорма,
		 "ОбработчикВыборСертификата");
	
КонецПроцедуры
	 
&НаКлиенте
Процедура ОбработчикВыборСертификата(ВыбСертификат, ДопПараметры = Неопределено) Экспорт

	Если ВыбСертификат <> Неопределено Тогда		
		НовыйСертификат = ВыбСертификат;    				
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НоваяМЧДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОрганизацияДиадок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(МЧД, "ОрганизацияДиадок");
		
	НастройкиКД = Новый НастройкиКомпоновкиДанных;

    ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаОкончания");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
    ОтборСписка.ПравоеЗначение = ТекущаяДата();
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ОтборСписка.ПравоеЗначение = Ложь;
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОрганизацияДиадок");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ОтборСписка.ПравоеЗначение = ОрганизацияДиадок;
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборСписка.ПравоеЗначение = МЧД;
	ОтборСписка.Использование = Истина;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ФиксированныеНастройки", НастройкиКД);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		 "Справочник.КонтурЛогистика_МЧД.ФормаВыбора",
		 ПараметрыВыбора,
		 ЭтаФорма,
		 ЭтаФорма,
		 "ОбработчикВыборМЧД");
			 
КонецПроцедуры
		 
&НаКлиенте
Процедура ОбработчикВыборМЧД(ВыбМЧД, ДопПараметры = Неопределено) Экспорт

	Если ВыбМЧД <> Неопределено Тогда		
		НоваяМЧД = ВыбМЧД;    				
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревыпуститьСертификатСсылкаНажатие(Элемент)
	
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке("https://www.kontur-extern.ru/sc");
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревыпуститьМЧДСсылкаНажатие(Элемент)
	
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке("https://m4d.kontur.ru/");
	
КонецПроцедуры

#КонецОбласти