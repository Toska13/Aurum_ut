#Область ОбработчикиСобытий

&После("ПриНачалеРаботыСистемы")
Процедура АУ_ПриНачалеРаботыСистемы()
	
	АУ_ОбщиеПроцедурыИФункцииКлиент.ПоказатьНовыеЗадачиИсполнителяПриНачалеРаботы();
	
	ПериодОпроса = АУ_Привелигированный.ПериодОпросаНовыхЗадачДляОповещения();
	ПодключитьОбработчикОжидания("АУ_ПоказатьНовыеЗадачиИсполнителяОбработчикОжидания", ПериодОпроса);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик ожидания: периодическая проверка новых задач исполнителя.
//
Процедура АУ_ПоказатьНовыеЗадачиИсполнителяОбработчикОжидания() Экспорт
	
	АУ_ОбщиеПроцедурыИФункцииКлиент.ПоказатьНовыеЗадачиИсполнителя();
	
КонецПроцедуры

#КонецОбласти
