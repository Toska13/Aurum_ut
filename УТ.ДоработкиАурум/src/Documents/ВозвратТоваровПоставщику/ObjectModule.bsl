#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

&После("ОбработкаУдаленияПроведения")
Процедура АУ_ОбработкаУдаленияПроведения(Отказ)

	// Отказ после типового обработчика: если отмена проведения не прошла — строки заказа не трогаем.
	Если Отказ Тогда

		Возврат;

	КонецЕсли;

	АУ_УдалитьСтрокиЗаменыПоВозврату(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура АУ_УдалитьСтрокиЗаменыПоВозврату(ВозвратСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.АУ_ВозвратТоваровПоставщику = &ВозвратСсылка";
	Запрос.УстановитьПараметр("ВозвратСсылка", ВозвратСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ЗаказОбъект = Выборка.ЗаказПоставщику.ПолучитьОбъект();
		НайденныеСтроки = ЗаказОбъект.Товары.НайтиСтроки(
			Новый Структура("АУ_ВозвратТоваровПоставщику", ВозвратСсылка));

		Если НайденныеСтроки.Количество() = 0 Тогда

			Продолжить;

		КонецЕсли;

		Для Каждого СтрокаУдаления Из НайденныеСтроки Цикл

			ЗаказОбъект.Товары.Удалить(СтрокаУдаления);

		КонецЦикла;

		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
