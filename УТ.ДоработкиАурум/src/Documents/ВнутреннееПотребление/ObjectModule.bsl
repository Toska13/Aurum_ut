#Область ОбработчикиСобытий

&Перед("ОбработкаПроверкиЗаполнения")
Процедура АУ_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЭтотОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5 Тогда

		ПроверяемыеРеквизиты.Добавить("АУ_Партнер");
		ПроверяемыеРеквизиты.Добавить("АУ_Контрагент");
		ПроверяемыеРеквизиты.Добавить("АУ_Договор");

	КонецЕсли;

КонецПроцедуры

&Вместо("ОбработкаЗаполнения")
Процедура АУ_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Статья = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("Прочие расходы");

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда

		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, , "Номер,Дата");
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5;

		Для каждого стрТовары Из ДанныеЗаполнения.Товары Цикл

			НоваяСтрока = ЭтотОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);
			НоваяСтрока.СтатьяРасходов = Статья;
			НоваяСтрока.АналитикаРасходов = ЭтотОбъект.Организация;

		КонецЦикла;

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда

		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, , "Номер,Дата");
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5;
		Склад = ДанныеЗаполнения.СкладПолучатель;

		Для каждого стрТовары Из ДанныеЗаполнения.Товары Цикл

			НоваяСтрока = ЭтотОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);
			НоваяСтрока.СтатьяРасходов = Статья;
			НоваяСтрока.АналитикаРасходов = ЭтотОбъект.Организация;

		КонецЦикла;

	Иначе

		ПродолжитьВызов(ДанныеЗаполнения, СтандартнаяОбработка);

	КонецЕсли;

КонецПроцедуры

