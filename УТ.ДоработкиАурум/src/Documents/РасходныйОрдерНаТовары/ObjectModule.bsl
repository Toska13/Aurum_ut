#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

&Перед("ПередЗаписью")
Процедура АУ_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Возврат;

	Если НЕ ЭтоНовый() И Дата < Дата(2024, 11, 15) Тогда

		Возврат;

	КонецЕсли;

	НовыйОрдер = Документы.РасходныйОрдерНаТовары.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйОрдер, ЭтотОбъект, , "Номер");

	КоличествоСтрок = ЭтотОбъект.ТоварыПоРаспоряжениям.Количество();
	Для н = 1 По КоличествоСтрок Цикл

		ТекСтрока = ЭтотОбъект.ТоварыПоРаспоряжениям[КоличествоСтрок - н];

		Если ТекСтрока.Номенклатура.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.МедицинскиеИзделия Тогда

			НоваяСтрока = НовыйОрдер.ТоварыПоРаспоряжениям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);

			ЭтотОбъект.ТоварыПоРаспоряжениям.Удалить(ТекСтрока);

		КонецЕсли;

	КонецЦикла;

	Если НовыйОрдер.ТоварыПоРаспоряжениям.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Если ЭтотОбъект.ТоварыПоРаспоряжениям.Количество() = 0 Тогда

		Для каждого стрТовары Из НовыйОрдер.ТоварыПоРаспоряжениям Цикл

			НоваяСтрока = ЭтотОбъект.ТоварыПоРаспоряжениям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);

		КонецЦикла;

		Возврат;

	КонецЕсли;

	КоличествоСтрок = ЭтотОбъект.ОтгружаемыеТовары.Количество();
	Для н = 1 По КоличествоСтрок Цикл

		ТекСтрока = ЭтотОбъект.ОтгружаемыеТовары[КоличествоСтрок - н];

		Если ТекСтрока.Номенклатура.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.МедицинскиеИзделия Тогда

			НоваяСтрока = НовыйОрдер.ОтгружаемыеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);

			ЭтотОбъект.ОтгружаемыеТовары.Удалить(ТекСтрока);

		КонецЕсли;

	КонецЦикла;

	НовыйОрдер.Записать(РежимЗаписиДокумента.Запись);
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда

		НовыйОрдер.Записать(РежимЗаписиДокумента.Проведение);

	КонецЕсли;

КонецПроцедуры

&После("ПередЗаписью")
Процедура АУ_ПередЗаписьюЗаполнитьРеализацию(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда

		Возврат;

	КонецЕсли;

	АУ_КонтрольЗаказаКлиентаСервер.ЗаполнитьРеализациюВРасходномОрдере(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

