#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ЗаполнитьОтветственных();
		
		Для каждого стрТовары Из Объект.Товары Цикл
			
			Если ЗначениеЗаполнено(стрТовары.ЗаказКлиента) Тогда
				
				НайденныеСтроки=стрТовары.ЗаказКлиента.Товары.НайтиСтроки(Новый Структура("КодСтроки,Номенклатура,Характеристика",стрТовары.КодСтроки,стрТовары.Номенклатура,стрТовары.Характеристика));
				Если НайденныеСтроки.Количество()>0 Тогда
					стрТовары.АУ_НаименованиеДляПечати=НайденныеСтроки[0].АУ_НаименованиеДляПечати;
					стрТовары.АУ_НаименованиеЕдиницыИзмерения=НайденныеСтроки[0].АУ_НаименованиеЕдиницыИзмерения;
					стрТовары.АУ_Шифр=НайденныеСтроки[0].АУ_Шифр;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаКолонокТаблицыФормы(ЭтаФорма,"АУ_Печать","Товары",2,,,,,Элементы.ТоварыХарактеристика);
	Элемент = АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_НаименованиеДляПечати","АУ_Печать","Наименование для печати",1,"Объект.Товары.АУ_НаименованиеДляПечати",Новый Структура("Ширина",30));
	Элемент.КнопкаВыпадающегоСписка = Истина;
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_НаименованиеЕдиницыИзмерения","АУ_Печать","Наименование единицы измерения",1,"Объект.Товары.АУ_НаименованиеЕдиницыИзмерения",Новый Структура("Ширина",30));
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_Шифр","Товары","Шифр",1,"Объект.Товары.АУ_Шифр",Новый Структура("Ширина",7),,"ТоварыНоменклатура");
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма,"АУ_ЗаполнитьНаименованияДляПечатиПоЗаказу","Заполнить наименования для печати по заказу","АУ_ЗаполнитьНаименованияДляПечатиПоЗаказу");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма,"АУ_ЗаполнитьНаименованияДляПечатиПоЗаказу","ТоварыГруппаЗаполнить","Заполнить наименования для печати по заказу","АУ_ЗаполнитьНаименованияДляПечатиПоЗаказу",1);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма,"АУ_ЗаполнитьШифрПоЗаказу","Заполнить шифр по заказу","АУ_ЗаполнитьШифрПоЗаказу");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма,"АУ_ЗаполнитьШифрПоЗаказу","ТоварыГруппаЗаполнить","Заполнить шифр по заказу","АУ_ЗаполнитьШифрПоЗаказу",1);
	
	АУ_СозданиеЭлементовФормы.СоздатьПолеФлажок(ЭтаФорма,"ЭтоУниверсальныйДокумент","ГруппаПодвал","УПД",3,"Объект.ЭтоУниверсальныйДокумент",,,"ГруппаСостояниеЭДО");
	
	АУ_СозданиеЭлементовФормы.СоздатьРеквизитыТаблицы(ЭтаФорма,"Объект.Товары",Новый Структура("АУ_ЦенаЗаказа,АУ_СтавкаНДСЗаказа",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)),Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС")));
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаКолонокТаблицыФормы(ЭтаФорма,"АУ_ГруппаЦена","Товары",1,,,,,Элементы.ТоварыЦена);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_ЦенаЗаказа","АУ_ГруппаЦена","Цена в заказе",1,"Объект.Товары.АУ_ЦенаЗаказа",Новый Структура("ТолькоПросмотр",Истина));
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаКолонокТаблицыФормы(ЭтаФорма,"АУ_ГруппаСтавкаНДС","Товары",1,,,,,Элементы.ТоварыСтавкаНДС);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_СтавкаНДСЗаказа","АУ_ГруппаСтавкаНДС","Ставка НДС в заказе",1,"Объект.Товары.АУ_СтавкаНДСЗаказа",Новый Структура("ТолькоПросмотр",Истина));
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаКолонокТаблицыФормы(ЭтаФорма,"АУ_ГруппаСчет","Товары",2,,,,,);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_СуммаСчета","АУ_ГруппаСчет",,1,"Объект.Товары.АУ_СуммаСчета");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_СуммаНДССчета","АУ_ГруппаСчет",,1,"Объект.Товары.АУ_СуммаНДССчета");
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаКолонокТаблицыФормы(ЭтаФорма,"АУ_ГруппаРНПТ","Товары",2,,,,,);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_НомерРНПТ","АУ_ГруппаРНПТ",,1,"Объект.Товары.АУ_НомерРНПТ");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_СтоимостьРНПТ","АУ_ГруппаРНПТ",,1,"Объект.Товары.АУ_СтоимостьРНПТ");
	
	АУ_СозданиеЭлементовФормы.СоздатьПолеФлажок(ЭтаФорма,"АУ_УслугиСМРПИР","СтраницаЗаказ",,1,"Объект.АУ_УслугиСМРПИР",,Новый Структура("ПриИзменении","АУ_ПриИзмененииУслугиСМРПИР"),"ЗакрытьЗаказ");
	
	АУ_СозданиеЭлементовФормы.СоздатьРеквизит(ЭтаФорма, "АУ_ТекущаяНоменклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Оформление=ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора=Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.АУ_ЦенаЗаказа");
	ЭлементОтбора.ПравоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.Цена");
	ЭлементОтбора.ВидСравнения=ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.Использование=Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.СветлоРозовый);
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыАУ_ЦенаЗаказа");
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыЦена");
	
	Оформление=ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора=Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.АУ_ЦенаЗаказа");
	ЭлементОтбора.ПравоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.Цена");
	ЭлементОтбора.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование=Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.СветлоЗеленый);
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыАУ_ЦенаЗаказа");
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыЦена");
	
	
	Оформление=ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора=Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.АУ_СтавкаНДСЗаказа");
	ЭлементОтбора.ПравоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.СтавкаНДС");
	ЭлементОтбора.ВидСравнения=ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.Использование=Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.СветлоРозовый);
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыАУ_СтавкаНДСЗаказа");
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыСтавкаНДС");
	
	Оформление=ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора=Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.АУ_СтавкаНДСЗаказа");
	ЭлементОтбора.ПравоеЗначение=Новый ПолеКомпоновкиДанных("Объект.Товары.СтавкаНДС");
	ЭлементОтбора.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование=Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.СветлоЗеленый);
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыАУ_СтавкаНДСЗаказа");
	Поле=Оформление.Поля.Элементы.Добавить();
	Поле.Поле=Новый ПолеКомпоновкиДанных("ТоварыСтавкаНДС");
	
	АУ_ЗаполнитьДанныеИзЗаказа();
	
	Если ПравоДоступа("Редактирование", Метаданные.Документы.АУ_ГарантийныйТалон) Тогда
		
		АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_СоздатьГарантийныйТалон", "Создать гарантийный талон", "АУ_СоздатьГарантийныйТалон");
		АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_СоздатьГарантийныйТалон", "ТоварыКоманднаяПанель",, "АУ_СоздатьГарантийныйТалон", 1);
		
	КонецЕсли;
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ОтключитьВидимостьНоменклатурыИзАрхиваВФормеДокумента(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область КомандыИСобытияЭлементов

&НаСервере
&После("СкладПриИзмененииСервер")
Процедура АУ_СкладПриИзмененииСервер(ОчищатьСтроки, ОтвязатьВсеСтрокиОтЗаказа)
	
	ЗаполнитьОтветственных();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыПриОкончанииРедактированияПосле(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	АУ_ЗаполнитьДанныеИзЗаказа();
	
КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ДатаПриИзмененииСервер")
Процедура АУ_ДатаПриИзмененииСервер(ПересчитатьЦены, ЦеныРассчитаны, ПрименитьОплатуБонуснымиБаллами)
	
	Если ПрименитьОплатуБонуснымиБаллами = Истина Тогда
		ПрименитьОплатуБонуснымиБаллами(, Истина);
	КонецЕсли;
	
	Если ПересчитатьЦены Тогда
		ЦеныРассчитаны = ЗаполнитьЦеныПоСоглашениюСервер(Истина);
	КонецЕсли;
	
	ЗаполнитьНалогообложениеНДСПродажи();
	НалогообложениеНДСПриИзмененииСервер();
	
	ВзаиморасчетыРаботаСФормами.ФормаПриИзмененииРеквизитов(ЭтотОбъект,"Дата");
	
	#Удаление
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	#КонецУдаления

	УстановитьОрдернуюСхемуПриОтгрузке();
	
	ЗаполнитьУстановитьВидимостьСерийДоступностьПерезаполнитьПоОтгрузке();
	
	УстановитьДоступностьВидимостьЭлементовСборкиИДоставки();
	
	РозничныеПродажиКлиентСервер.УстановитьДоступностьКомандОплатыБонуснымиБаллами(Элементы, Объект.Дата);
	
	СобытияФорм.ПриИзмененииЭлемента(ЭтотОбъект, "Товары");
	ПриИзмененииЭлементаЛокализация(ЭтотОбъект, "Дата");
	
	Если ПересчитатьЦены Тогда
		ПроверитьИсправитьНаличиеСкидокОплатБонуснымиБалламиЛокализация();
	КонецЕсли;
	
	РассчитатьДатуПереходаПраваСобственности();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПриИзмененииУслугиСМРПИР(Элемент)
	
	ЗаполнитьОтветственных();
	
КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьШифрПоЗаказуСервер()
	
	Для каждого стрТовары Из Объект.Товары Цикл
			
		Если ЗначениеЗаполнено(стрТовары.ЗаказКлиента) Тогда
			
			НайденныеСтроки=стрТовары.ЗаказКлиента.Товары.НайтиСтроки(Новый Структура("КодСтроки,Номенклатура,Характеристика",стрТовары.КодСтроки,стрТовары.Номенклатура,стрТовары.Характеристика));
			Если НайденныеСтроки.Количество()>0 Тогда
				стрТовары.АУ_Шифр=НайденныеСтроки[0].АУ_Шифр;
				Модифицированность=Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьШифрПоЗаказу(Команда)
	
	АУ_ЗаполнитьШифрПоЗаказуСервер();
	
КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьНаименованияДляПечатиПоЗаказуСервер()
	
	Для каждого стрТовары Из Объект.Товары Цикл
			
		Если ЗначениеЗаполнено(стрТовары.ЗаказКлиента) Тогда
			
			НайденныеСтроки=стрТовары.ЗаказКлиента.Товары.НайтиСтроки(Новый Структура("КодСтроки,Номенклатура,Характеристика",стрТовары.КодСтроки,стрТовары.Номенклатура,стрТовары.Характеристика));
			Если НайденныеСтроки.Количество()>0 Тогда
				стрТовары.АУ_НаименованиеДляПечати=НайденныеСтроки[0].АУ_НаименованиеДляПечати;
				стрТовары.АУ_НаименованиеЕдиницыИзмерения=НайденныеСтроки[0].АУ_НаименованиеЕдиницыИзмерения;
				Модифицированность=Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьНаименованияДляПечатиПоЗаказу(Команда)
	
	АУ_ЗаполнитьНаименованияДляПечатиПоЗаказуСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыПриАктивизацииСтрокиПосле(Элемент)
	
	ЗаполнитьСписокВыбораАльтернативныхНаименований();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыНоменклатураПриИзмененииПосле(Элемент)
	
	ЗаполнитьСписокВыбораАльтернативныхНаименований();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_СоздатьГарантийныйТалон(Команда)
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", Объект.Организация);
	ДанныеЗаполнения.Вставить("Партнер", Объект.Партнер);
	ДанныеЗаполнения.Вставить("Контрагент", Объект.Контрагент);
	ДанныеЗаполнения.Вставить("Договор", Объект.Договор);
	ДанныеЗаполнения.Вставить("ЗаказКлиента", Объект.ЗаказКлиента);
	ДанныеЗаполнения.Вставить("Реализация", Объект.Ссылка);
	ДанныеЗаполнения.Вставить("Номенклатура", Элементы.Товары.ТекущиеДанные.Номенклатура);
	ДанныеЗаполнения.Вставить("Характеристика", Элементы.Товары.ТекущиеДанные.Характеристика);
	ДанныеЗаполнения.Вставить("Серия", Элементы.Товары.ТекущиеДанные.Серия);
	
	ОткрытьФорму("Документ.АУ_ГарантийныйТалон.ФормаОбъекта", ДанныеЗаполнения);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Процедура ЗаполнитьОтветственных()
	
	Если Объект.АУ_УслугиСМРПИР Тогда
		ТекРуководитель = Справочники.ОтветственныеЛицаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор("5edfe69c-c569-11e8-80bc-00155d046507"));
		ТекГлавбух = Справочники.ОтветственныеЛицаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор("67c24da7-3478-11eb-80f9-00155d046507"));
		
		Объект.Отпустил = ТекРуководитель.ФизическоеЛицо;
		Объект.ОтпустилДолжность = СокрЛП(ТекРуководитель.Должность);
		Объект.Руководитель = ТекРуководитель;
		Объект.ГлавныйБухгалтер = ТекГлавбух;
	Иначе
		ТекРуководитель = Справочники.ОтветственныеЛицаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор("0d6cddfb-f314-11ed-a78b-9418826e6967"));
		ТекГлавбух = Справочники.ОтветственныеЛицаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор("29a73c26-f314-11ed-a78b-9418826e6967"));
		
		Объект.Отпустил = ТекРуководитель.ФизическоеЛицо;
		Объект.ОтпустилДолжность = СокрЛП(ТекРуководитель.Должность);
		Объект.Руководитель = ТекРуководитель;
		Объект.ГлавныйБухгалтер = ТекГлавбух;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьДанныеИзЗаказа()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗаказКлиентаТовары.Цена КАК Цена,
				|	ЗаказКлиентаТовары.КодСтроки КАК КодСтроки,
				|	ЗаказКлиентаТовары.СтавкаНДС КАК СтавкаНДС
				|ИЗ
				|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
				|ГДЕ
				|	ЗаказКлиентаТовары.Ссылка=&Ссылка
				|	И ЗаказКлиентаТовары.КодСтроки В(&КодСтроки)";
	Запрос.УстановитьПараметр("Ссылка",Объект.ЗаказКлиента);
	Запрос.УстановитьПараметр("КодСтроки",Объект.Товары.Выгрузить(,"КодСтроки").ВыгрузитьКолонку("КодСтроки"));
	
	Выборка=Запрос.Выполнить().Выбрать();
	Соотв=Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Соотв.Вставить(Выборка.КодСтроки,Новый Структура("Цена,СтавкаНДС",Выборка.Цена,Выборка.СтавкаНДС));
	КонецЦикла;
	
	Для каждого стрТовары Из Объект.Товары Цикл
		ДанныеЗаказа=Соотв[стрТовары.КодСтроки];
		Если ДанныеЗаказа<>Неопределено Тогда
			стрТовары.АУ_ЦенаЗаказа=ДанныеЗаказа.Цена;
			стрТовары.АУ_СтавкаНДСЗаказа=ДанныеЗаказа.СтавкаНДС;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораАльтернативныхНаименований()
	
	Если Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	Если ЭтаФорма.АУ_ТекущаяНоменклатура <> ТекущаяСтрока.Номенклатура Тогда
	
		Элементы.ТоварыАУ_НаименованиеДляПечати.СписокВыбора.Очистить();
		Для каждого стрНаименование Из ТекущаяСтрока.Номенклатура.АУ_АльтернативныеНаименования Цикл
			Элементы.ТоварыАУ_НаименованиеДляПечати.СписокВыбора.Добавить(стрНаименование.НаименованиеПолное);
		КонецЦикла;
		
	КонецЕсли;
	
	ЭтаФорма.АУ_ТекущаяНоменклатура = ТекущаяСтрока.Номенклатура;
	
КонецПроцедуры

#КонецОбласти