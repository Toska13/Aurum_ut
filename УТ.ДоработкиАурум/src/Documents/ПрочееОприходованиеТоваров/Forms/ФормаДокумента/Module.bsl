#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычная(ЭтаФорма, "АУ_ГруппаКонтрагент", "ГруппаШапкаПраво", "", 1, , , , );
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Партнер", "АУ_ГруппаКонтрагент", , 1, "Объект.АУ_Партнер", Новый Структура("АвтоотметкаНезаполненного", Истина));
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Контрагент", "АУ_ГруппаКонтрагент", , 1, "Объект.АУ_Контрагент", Новый Структура("АвтоотметкаНезаполненного", Истина));
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Договор", "АУ_ГруппаКонтрагент", , 1, "Объект.АУ_Договор", Новый Структура("АвтоотметкаНезаполненного", Истина));

	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтПереработчика2_5 Тогда

		Элементы.АУ_ГруппаКонтрагент.Видимость = Истина;
		Элементы.ТоварыСтатьяРасходовДоходов.Видимость = Ложь;
		Элементы.ГруппаТовары.Заголовок = "Возвращенные материалы";
	Иначе

		Элементы.АУ_ГруппаКонтрагент.Видимость = Ложь;

	КонецЕсли;

	АУ_СозданиеЭлементовФормы.СоздатьСтраница(ЭтаФорма, "СтраницаАУ_ИспользованныеМатериалы", "ГруппаСтраницы", "Использованные материалы", 1, 1, 1);
	АУ_СозданиеЭлементовФормы.СоздатьТаблицаФормы(ЭтаФорма, "АУ_ИспользованныеМатериалы", "СтраницаАУ_ИспользованныеМатериалы", "Объект.АУ_ИспользованныеМатериалы", Новый Структура("Номенклатура,Упаковка,КоличествоУпаковок", "Номенклатура", "Упаковка", "Количество"));

	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьПоПередачеТоваров", "Заполнить по передаче товаров", "АУ_ЗаполнитьПоПередачеТоваров");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоПередачеТоваров", "ТоварыКоманднаяПанель", , "АУ_ЗаполнитьПоПередачеТоваров", 1);

	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьПоОстаткам", "Заполнить по остаткам", "АУ_ЗаполнитьПоОстаткам");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоОстаткам", "ТоварыКоманднаяПанель", , "АУ_ЗаполнитьПоОстаткам", 1);

	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалы", "Заполнить по передаче товаров", "АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалы");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалы", "АУ_ИспользованныеМатериалыКоманднаяПанель", , "АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалы", 1);

	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьПоОстаткамИспользованныеМатериалы", "Заполнить по остаткам", "АУ_ЗаполнитьПоОстаткамИспользованныеМатериалы");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоОстаткамИспользованныеМатериалы", "АУ_ИспользованныеМатериалыКоманднаяПанель", , "АУ_ЗаполнитьПоОстаткамИспользованныеМатериалы", 1);

КонецПроцедуры

&НаКлиенте
Процедура АУ_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)

	Статья = ПолучитьСтатьюДоходовРасходовПреработчика();
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратОтПереработчика2_5") Тогда

		Для каждого стрТовары Из Объект.Товары Цикл

			Если НЕ ЗначениеЗаполнено(стрТовары.СтатьяРасходовДоходов) Тогда

				стрТовары.СтатьяРасходовДоходов = Статья;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ТекущийОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АУ_ХозяйственнаяОперацияПриИзмененииПосле(Элемент)

	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратОтПереработчика2_5") Тогда

		Элементы.АУ_ГруппаКонтрагент.Видимость = Истина;
		Элементы.ТоварыСтатьяРасходовДоходов.Видимость = Ложь;
		Элементы.ГруппаТовары.Заголовок = "Возвращенные материалы";
	Иначе

		Элементы.АУ_ГруппаКонтрагент.Видимость = Ложь;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АУ_ЗаполнитьПоПередачеТоваров(Команда)

	ОткрытьФорму("Документ.ВнутреннееПотребление.ФормаВыбора", Новый Структура("Отбор", Новый Структура("ХозяйственнаяОперация", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаПереработчику2_5"))), ЭтаФорма, , , , Новый ОписаниеОповещения("АУ_ЗаполнитьПоПередачеТоваровЗавершение", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалы(Команда)

	ОткрытьФорму("Документ.ВнутреннееПотребление.ФормаВыбора", Новый Структура("Отбор", Новый Структура("ХозяйственнаяОперация", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаПереработчику2_5"))), ЭтаФорма, , , , Новый ОписаниеОповещения("АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалыЗавершение", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьПоОстаткам(Кнопка)

	АУ_ЗаполнитьПоОстаткамСервер("Товары");

КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьПоОстаткамИспользованныеМатериалы(Кнопка)

	АУ_ЗаполнитьПоОстаткамСервер("АУ_ИспользованныеМатериалы");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьСтатьюДоходовРасходовПреработчика()
	
	Возврат ПланыВидовХарактеристик.СтатьиДоходов.НайтиПоКоду("Б1-Р00046");
	
КонецФункции

&НаКлиенте
Процедура АУ_ЗаполнитьПоПередачеТоваровЗавершение(Значение, ДопПараметры) Экспорт

	Если ЗначениеЗаполнено(Значение) Тогда

		АУ_ЗаполнитьПоПередачеТоваровСервер(Значение);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьПоПередачеТоваровСервер(ПередачаТоваров)

	Для каждого стрТовары Из ПередачаТоваров.Товары Цикл

		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалыЗавершение(Значение, ДопПараметры) Экспорт

	Если ЗначениеЗаполнено(Значение) Тогда

		АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалыСервер(Значение);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьПоПередачеТоваровИспользованныеМатериалыСервер(ПередачаТоваров)

	Для каждого стрТовары Из ПередачаТоваров.Товары Цикл

		НоваяСтрока = Объект.АУ_ИспользованныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьПоОстаткамСервер(ИмяТЧ)

	Объект[ИмяТЧ].Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
             |	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
             |	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
             |	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Назначение КАК Назначение,
             |	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Серия КАК Серия,
             |	ТоварыОрганизаций.КоличествоОстаток КАК Остаток,
             |	ТоварыОрганизаций.НомерГТД КАК НомерГТД
             |ИЗ
             |	РегистрНакопления.ТоварыОрганизаций.Остатки(&ДатаОстатков, АналитикаУчетаНоменклатуры.МестоХранения = &Склад) КАК ТоварыОрганизаций
             |;
             |
             |////////////////////////////////////////////////////////////////////////////////
             |ВЫБРАТЬ
             |	Данные.Номенклатура КАК Номенклатура,
             |	Данные.Характеристика КАК Характеристика,
             |	Данные.Назначение КАК Назначение,
             |	Данные.Серия КАК Серия,
             |	СУММА(Данные.Остаток) КАК КоличествоУпаковок,
             |	СУММА(Данные.Остаток) КАК Количество
             |ИЗ
             |	(ВЫБРАТЬ
             |		ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
             |		ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
             |		ТоварыНаСкладахОстатки.Назначение КАК Назначение,
             |		ТоварыНаСкладахОстатки.Серия КАК Серия,
             |		ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток
             |	ИЗ
             |		РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, Склад = &Склад) КАК ТоварыНаСкладахОстатки
             |	
             |	ОБЪЕДИНИТЬ ВСЕ
             |	
             |	ВЫБРАТЬ
             |		ТоварыКОтгрузкеОстатки.Номенклатура,
             |		ТоварыКОтгрузкеОстатки.Характеристика,
             |		ТоварыКОтгрузкеОстатки.Назначение,
             |		ТоварыКОтгрузкеОстатки.Серия,
             |		-ТоварыКОтгрузкеОстатки.ВРезервеОстаток - ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток
             |	ИЗ
             |		РегистрНакопления.ТоварыКОтгрузке.Остатки(&ДатаОстатков, Склад = &Склад) КАК ТоварыКОтгрузкеОстатки) КАК Данные
             |
             |СГРУППИРОВАТЬ ПО
             |	Данные.Назначение,
             |	Данные.Номенклатура,
             |	Данные.Серия,
             |	Данные.Характеристика
             |
             |ИМЕЮЩИЕ
             |	СУММА(Данные.Остаток) > 0";

	Если Объект.Ссылка.Пустая() Тогда

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаОстатков", "");

	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОстатков", Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);

	КэшированныеЗначения = Новый Соответствие;
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[1].Выбрать();
	ТоварыОрганизаций = Пакет[0].Выгрузить();
	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Объект[ИмяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);

		Если ИмяТч = "Товары" Тогда

			СтруктураДействий = Новый Структура;
			ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(СтруктураДействий, ЭтотОбъект, Объект, НоваяСтрока);
			ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, Объект);

			ДобавитьДействиеЗаполнитьПартиюТМЦВЭксплуатации(СтруктураДействий, Объект);

			ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);

			Если Не НоваяСтрока.ВедетсяУчетПоРНПТ Тогда

				НоваяСтрока.НомерГТД = Неопределено;
				НоваяСтрока.ТипНомераГТД = Неопределено;
				НоваяСтрока.СтранаПроисхождения = Неопределено;

			КонецЕсли;

			Если НоваяСтрока.ВедетсяУчетПоГТД Тогда

				НайденныеСтроки = ТоварыОрганизаций.НайтиСтроки(Новый Структура("Номенклатура,Характеристика,Назначение,Серия", НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, НоваяСтрока.Назначение, НоваяСтрока.Серия));
				Осталось = НоваяСтрока.КоличествоУпаковок;
				Для каждого стрНайденнаяСтрока Из НайденныеСтроки Цикл

					ТекКоличество = Мин(стрНайденнаяСтрока.Остаток, Осталось);
					стрНайденнаяСтрока.Остаток = стрНайденнаяСтрока.Остаток-ТекКоличество;
					Если ТекКоличество = 0 Тогда

						Продолжить;

					КонецЕсли;
					Осталось = Осталось-ТекКоличество;

					НоваяСтрока.Количество = ТекКоличество;
					НоваяСтрока.КоличествоУпаковок = ТекКоличество;
					НоваяСтрока.НомерГТД = стрНайденнаяСтрока.НомерГТД;
					Если Осталось = 0 Тогда

						Прервать;

					КонецЕсли;

					ДопСтрока = Объект[ИмяТЧ].Добавить();
					ЗаполнитьЗначенияСвойств(ДопСтрока, Выборка);
					ДопСтрока.Количество = Осталось;
					ДопСтрока.КоличествоУпаковок = Осталось;
					НоваяСтрока = ДопСтрока;

				КонецЦикла;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
