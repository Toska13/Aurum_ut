КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОбъекта(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Объект.АУ_СтатьиБюджета.НайтиПоИдентификатору(Элементы.АУ_СтатьиБюджета.ТекущаяСтрока);
	Если ЗначениеЗаполнено(ТекущаяСтрока.ОбъектСтрока) И СтрНайти(ТекущаяСтрока.ОбъектСтрока, ВыбранноеЗначение) = 0 Тогда

		ТекущаяСтрока.ОбъектСтрока = СтрШаблон("%1,%2", ТекущаяСтрока.ОбъектСтрока, ВыбранноеЗначение);
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.ОбъектСтрока) Тогда

		ТекущаяСтрока.ОбъектСтрока = ВыбранноеЗначение;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораШифра(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Объект.АУ_СтатьиБюджета.НайтиПоИдентификатору(Элементы.АУ_СтатьиБюджета.ТекущаяСтрока);
	Если ЗначениеЗаполнено(ТекущаяСтрока.Шифр) И СтрНайти(ТекущаяСтрока.Шифр, ВыбранноеЗначение) = 0 Тогда

		ТекущаяСтрока.Шифр = СтрШаблон("%1,%2", ТекущаяСтрока.Шифр, ВыбранноеЗначение);
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.Шифр) Тогда

		ТекущаяСтрока.Шифр = ВыбранноеЗначение;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияВСтрокеСтатейБюджетаПоУмолчанию(ИДСтроки)

	ТекущаяСтрока = Объект.АУ_СтатьиБюджета.НайтиПоИдентификатору(ИДСтроки);

	Если Элементы.АУ_СтатьиБюджетаПрограмма.СписокВыбора.Количество() = 1 Тогда

		ТекущаяСтрока.Программа = Элементы.АУ_СтатьиБюджетаПрограмма.СписокВыбора[0].Значение;

	КонецЕсли;

	Если Элементы.АУ_СтатьиБюджетаНомерКонтракта.СписокВыбора.Количество() = 1 Тогда

		ТекущаяСтрока.НомерКонтракта = Элементы.АУ_СтатьиБюджетаНомерКонтракта.СписокВыбора[0].Значение;

	КонецЕсли;

	МассивЗаказовКлиентов = ПолучитьЗаказыКлиентаИзЗаказаПоставщику();
	Если МассивЗаказовКлиентов.Количество() = 1 Тогда

		ТекущаяСтрока.ЗаказКлиента = МассивЗаказовКлиентов[0];

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьСтатьюДДСПоУмолчанию()

	Если НЕ Объект.Автор.АУ_СтатьяДДС.Пустая() Тогда

		Объект.СтатьяДвиженияДенежныхСредств = Объект.Автор.АУ_СтатьяДДС;
		Для каждого стр Из Объект.РасшифровкаПлатежа Цикл

			стр.СтатьяДвиженияДенежныхСредств = Объект.Автор.АУ_СтатьяДДС;

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьЗаказыКлиентаИзЗаказаПоставщику()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПоставщику.ДокументОснование КАК ЗаказКлиента
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	|ГДЕ
	|	ЗаказПоставщику.Ссылка В(&Ссылка)
	|	И ЗаказПоставщику.ДокументОснование ССЫЛКА Документ.ЗаказКлиента
	|	И НЕ ЗаказПоставщику.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПоставщикуТовары.АУ_ЗаказКлиента
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка В(&Ссылка)
	|	И НЕ ЗаказПоставщикуТовары.АУ_ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКЛиента.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПоставщику.ДокументОснование.ДокументОснование КАК ЗаказКлиента
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	|ГДЕ
	|	ЗаказПоставщику.Ссылка В(&Ссылка)
	|	И ЗаказПоставщику.ДокументОснование ССЫЛКА Документ.ЗаказНаСборку
	|	И НЕ ЗаказПоставщику.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЗаказНаСборку.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПоставщикуТовары.АУ_ЗаказНаСборку.ДокументОснование
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка В(&Ссылка)
	|	И НЕ ЗаказПоставщикуТовары.АУ_ЗаказНаСборку = ЗНАЧЕНИЕ(Документ.ЗаказНаСборку.ПустаяСсылка)";
	
	МассивЗП = Новый Массив;
	МассивЗП.Добавить(Объект.ДокументОснование);
	Для каждого стрРасшифровкаПлатежа Из Объект.РасшифровкаПлатежа Цикл
		
		Если ТипЗнч(стрРасшифровкаПлатежа.ОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказПоставщику") И ЗначениеЗаполнено(стрРасшифровкаПлатежа.ОбъектРасчетов.Объект) Тогда
			МассивЗП.Добавить(стрРасшифровкаПлатежа.ОбъектРасчетов.Объект);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Ссылка", МассивЗП);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказКлиента");
	
КонецФункции

&НаСервере
Функция ПолучитьМассивПартнеров()
	
	МассивПартнеров = Новый Массив;
	МассивЗаказаовКлиентов = ПолучитьЗаказыКлиентаИзЗаказаПоставщику();
	
	Для каждого стрЗаказ Из МассивЗаказаовКлиентов Цикл
		МассивПартнеров.Добавить(стрЗаказ.Партнер);
	КонецЦикла;
	
	МассивПартнеров = ОбщегоНазначенияУТ.УдалитьПовторяющиесяЭлементыМассива(МассивПартнеров);
	
	Возврат МассивПартнеров;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиВыбораЭлементов()

	МассивЗаказовКлиентов = ПолучитьЗаказыКлиентаИзЗаказаПоставщику();

	Элементы.АУ_СтатьиБюджетаПрограмма.СписокВыбора.Очистить();
	Элементы.АУ_СтатьиБюджетаНомерКонтракта.СписокВыбора.Очистить();
	Элементы.АУ_СтатьиБюджетаЗаказКлиента.СписокВыбора.Очистить();
	Элементы.АУ_СтатьиБюджетаШифр.СписокВыбора.Очистить();

	Для каждого стрЗаказ Из МассивЗаказовКлиентов Цикл

		Если Элементы.АУ_СтатьиБюджетаПрограмма.СписокВыбора.НайтиПоЗначению(стрЗаказ.АУ_Программа) = Неопределено Тогда

			Элементы.АУ_СтатьиБюджетаПрограмма.СписокВыбора.Добавить(стрЗаказ.АУ_Программа);

		КонецЕсли;

		Если Элементы.АУ_СтатьиБюджетаНомерКонтракта.СписокВыбора.НайтиПоЗначению(стрЗаказ.Договор.АУ_КраткийНомер) = Неопределено Тогда

			Элементы.АУ_СтатьиБюджетаНомерКонтракта.СписокВыбора.Добавить(стрЗаказ.Договор.АУ_КраткийНомер);

		КонецЕсли;

		Для каждого стрТовары Из стрЗаказ.Товары Цикл

			Если ЗначениеЗаполнено(стрТовары.АУ_Шифр) Тогда

				Если Элементы.АУ_СтатьиБюджетаШифр.СписокВыбора.НайтиПоЗначению(стрТовары.АУ_Шифр) = Неопределено Тогда

					Элементы.АУ_СтатьиБюджетаШифр.СписокВыбора.Добавить(стрТовары.АУ_Шифр);

				КонецЕсли;

			КонецЕсли;

			Если ЗначениеЗаполнено(стрТовары.Характеристика) Тогда

				Шифр = СокрЛП(стрТовары.Характеристика);
				Если Элементы.АУ_СтатьиБюджетаШифр.СписокВыбора.НайтиПоЗначению(Шифр) = Неопределено Тогда

					Элементы.АУ_СтатьиБюджетаШифр.СписокВыбора.Добавить(Шифр);

				КонецЕсли;

			КонецЕсли;

		КонецЦикла;

		Элементы.АУ_СтатьиБюджетаЗаказКлиента.СписокВыбора.Добавить(стрЗаказ);

	КонецЦикла;

КонецПроцедуры

