#Область ОбработчикиСобытийФормы

&НаСервере
&Перед("ПередЗаписьюНаСервере")
Процедура АУ_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ТекущийОбъект.РасшифровкаПлатежа.Количество() > 0 Тогда

		ПараметрыРасшифровки = Новый Структура;
		ПараметрыРасшифровки.Вставить("ВалютаРеглУчета",
			ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ТекущийОбъект.Организация));
		ПараметрыРасшифровки.Вставить("СинхронизироватьСуммыСтрок", Истина);
		ПараметрыРасшифровки.Вставить("СинхронизироватьСтатьиБюджета", Истина);
		ПараметрыРасшифровки.Вставить("ПересчитатьСуммыВВалютеОтправителя", ТекущийОбъект.ПлатежСКонвертацией);

		Если ТекущийОбъект.ПлатежСКонвертацией
			И ЗначениеЗаполнено(ТекущийОбъект.БанковскийСчет) Тогда

			ПараметрыРасшифровки.Вставить("ВалютаБанковскогоСчета",
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.БанковскийСчет, "ВалютаДенежныхСредств"));

		КонецЕсли;

		ДенежныеСредстваКлиентСервер.АУ_СинхронизироватьРасшифровкуПоСуммеДокумента(ТекущийОбъект, ПараметрыРасшифровки);
		ДенежныеСредстваКлиентСервер.АУ_ПроверитьСогласованностьСуммыДокументаИРасшифровки(ТекущийОбъект, Отказ);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ТекущийОбъект.АУ_СтатьиБюджета.Количество() = 0 Тогда

		Если ЗначениеЗаполнено(ТекущийОбъект.Контрагент.Партнер.АУ_СтатьяБюджета) Тогда

			НоваяСтрока = ТекущийОбъект.АУ_СтатьиБюджета.Добавить();
			НоваяСтрока.СтатьяБюджета = ТекущийОбъект.Контрагент.Партнер.АУ_СтатьяБюджета;
			НоваяСтрока.Сумма = ТекущийОбъект.СуммаДокумента;
			НоваяСтрока.ПризнакРасходов = НоваяСтрока.СтатьяБюджета.ПризнакРасходов;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	СтраницаСтатьиБюджета = АУ_СозданиеЭлементовФормы.СоздатьСтраница(ЭтаФорма, "АУ_СтраницаСтатьиБюджета", ЭтаФорма.Элементы.ГруппаСтраницы, "Статьи бюджета", 1);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_ДатаБюджета", СтраницаСтатьиБюджета, "Дата бюджета", 1, "Объект.АУ_ДатаБюджета");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_ФактическийКурсВалюты", СтраницаСтатьиБюджета, "Фактический курс валюты", 1, "Объект.АУ_ФактическийКурсВалюты");

	Колонки = Новый Структура("ДатаБюджета, СтатьяБюджета,  Сумма, НомерКонтракта, Программа, Шифр, ОбъектСтрока, ПризнакРасходов, Комментарий, ЗаказКлиента",
								"Дата бюджета", "Статья бюджета", "Сумма", "Контракт", "Программа", "Шифр", "Объект", "Признак расходов", "Комментарий", "ЗаказКлиента");
	ТаблицаСтатьиБюджета = АУ_СозданиеЭлементовФормы.СоздатьТаблицаФормы(ЭтаФорма, "АУ_СтатьиБюджета", СтраницаСтатьиБюджета, "Объект.АУ_СтатьиБюджета", Колонки);
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;

	Элементы.АУ_СтатьиБюджетаСтатьяБюджета.УстановитьДействие("ПриИзменении", "ПриИзмененииСтатьиБюджета");
	Элементы.АУ_СтатьиБюджетаНомерКонтракта.УстановитьДействие("ПриИзменении", "ПриИзмененииНомераКонтракта");
	Элементы.АУ_СтатьиБюджета.УстановитьДействие("ПриНачалеРедактирования", "ПриНачалеРедактированияСтатейБюджета");
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.УстановитьДействие("ОбработкаВыбора", "ОбработкаВыбораОбъекта");
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.УстановитьДействие("НачалоВыбора", "НачалоВыбораОбъекта");
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.УстановитьДействие("АвтоПодбор", "ОбъектСтрокаАвтоПодбор");
	Элементы.АУ_СтатьиБюджетаШифр.УстановитьДействие("ОбработкаВыбора", "ОбработкаВыбораШифра");
	Элементы.АУ_СтатьиБюджета.УстановитьДействие("ПриОкончанииРедактирования", "ПриОкончанииРедактированияАУ_СтатьиБюджета");

	Элементы.АУ_СтатьиБюджетаШифр.КнопкаВыпадающегоСписка = Истина;
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.КнопкаВыбора = Истина;

	ЗаполнитьСпискиВыбораЭлементов();

	ОбновитьЗаголовокСтраницыАналитика();

КонецПроцедуры

#КонецОбласти

