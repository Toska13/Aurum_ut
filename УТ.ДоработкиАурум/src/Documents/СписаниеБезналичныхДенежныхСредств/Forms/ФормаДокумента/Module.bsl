&НаСервере
Процедура АУ_ПослеИзмененияВалютыНаСервере()

	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("ВалютаРеглУчета", ВалютаРеглУчета);
	ПараметрыРасшифровки.Вставить("ВалютаБанковскогоСчета", ВалютаБанковскогоСчета);
	ПараметрыРасшифровки.Вставить("СинхронизироватьСуммыСтрок", Ложь);
	ПараметрыРасшифровки.Вставить("СинхронизироватьСтатьиБюджета", Истина);
	ПараметрыРасшифровки.Вставить("ПересчитатьСуммыВВалютеОтправителя", Объект.ПлатежСКонвертацией);

	ДенежныеСредстваКлиентСервер.АУ_СинхронизироватьРасшифровкуПоСуммеДокумента(Объект, ПараметрыРасшифровки);
	АУ_ОбновитьНазначениеПлатежаНаСервере();

