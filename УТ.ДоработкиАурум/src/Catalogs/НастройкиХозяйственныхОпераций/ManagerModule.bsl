#Область ОбработчикиСобытий

&После("ПриНачальномЗаполненииЭлементов")
Процедура АУ_ПриНачальномЗаполненииЭлементов(КодыЯзыков, Элементы, ТабличныеЧасти)
	
	АУ_ДополнитьОперации();
	
КонецПроцедуры

&После("ЗаполнитьПредопределенныеЭлементыПоДанымИзКода")
Процедура АУ_ЗаполнитьПредопределенныеЭлементыПоДанымИзКода()
	
	АУ_ДополнитьОперации();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура АУ_ДополнитьОперации()
	
	ТекущийОбъект = Справочники.НастройкиХозяйственныхОпераций.ПередачаПереработчику2_5.ПолучитьОбъект();
	
	Если ТекущийОбъект.Документы.Найти("ВнутреннееПотребление") = Неопределено Тогда
		
		НоваяСтрока = ТекущийОбъект.Документы.Добавить();
		НоваяСтрока.ИмяДокумента = "ВнутреннееПотребление";
		НоваяСтрока.ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.ВнутреннееПотребление");
		
	КонецЕсли;
	
	Если ТекущийОбъект.Модифицированность() Тогда
		
		ТекущийОбъект.Записать();
		
	КонецЕсли;
	
	ТекущийОбъект = Справочники.НастройкиХозяйственныхОпераций.ВозвратОтПереработчика2_5.ПолучитьОбъект();
	
	Если ТекущийОбъект.Документы.Найти("ПрочееОприходованиеТоваров") = Неопределено Тогда
		
		НоваяСтрока = ТекущийОбъект.Документы.Добавить();
		НоваяСтрока.ИмяДокумента = "ПрочееОприходованиеТоваров";
		НоваяСтрока.ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.ПрочееОприходованиеТоваров");
		
	КонецЕсли;
	
	Если ТекущийОбъект.Модифицированность() Тогда
		
		ТекущийОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
