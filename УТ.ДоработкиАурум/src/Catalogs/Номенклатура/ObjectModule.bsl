#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

&Перед("ПередЗаписью")
Процедура АУ_ПередЗаписью(Отказ)
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава") И Ссылка.Пустая() И НЕ ЭтоГруппа Тогда
		
		Если ЭтотОбъект.ВидНоменклатуры.АУ_НеИспользуется Тогда
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Создавать нмоенклатуру с видом %1 запрещено!", ЭтотОбъект.ВидНоменклатуры),,"Объект.ВидНоменклатуры",, Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		
		Если НЕ Ссылка.Пустая() И ((НЕ ЭтотОбъект.ПрослеживаемыйТовар И ЭтотОбъект.ПрослеживаемыйТовар <> Ссылка.ПрослеживаемыйТовар) ИЛИ (НЕ ЭтотОбъект.ВестиУчетПоГТД И ЭтотОбъект.ВестиУчетПоГТД <> Ссылка.ВестиУчетПоГТД)) Тогда
			
			Если ЕстьСсылкиВДокументах() Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Номенклатура уже используется в документах ! Изменять признак прослеживаемости товара и учет по ГТД нельзя!",,,, Отказ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция ЕстьСсылкиВДокументах()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПеремещениеТоваровТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|ГДЕ
	|	ПеремещениеТоваровТовары.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОприходованиеИзлишковТоваров.Ссылка
	|ИЗ
	|	Документ.ОприходованиеИзлишковТоваров.Товары КАК ОприходованиеИзлишковТоваров
	|ГДЕ
	|	ОприходованиеИзлишковТоваров.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СборкаТоваровТовары.Ссылка
	|ИЗ
	|	Документ.СборкаТоваров.Товары КАК СборкаТоваровТовары
	|ГДЕ
	|	СборкаТоваровТовары.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриобретениеТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслуг
	|ГДЕ
	|	ПриобретениеТоваровУслуг.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Количество() > 0;
	
КонецФункции

#КонецОбласти

#КонецЕсли
