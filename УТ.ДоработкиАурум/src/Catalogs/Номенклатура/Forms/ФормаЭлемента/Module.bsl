#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АУ_НаименованиеПриИзмененииПосле(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.НаименованиеПолное) Тогда
		
		Объект.НаименованиеПолное = Объект.Наименование;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
&После("УстановитьДоступностьРедактированияНаименований")
Процедура АУ_УстановитьДоступностьРедактированияНаименований(СкрыватьДоступность)
	
	Элементы.ЗаполнитьНаименованиеДляПечатиПоШаблону.Видимость = Истина;
	Элементы.ЗаполнитьНаименованиеДляПечатиПоШаблону.Доступность = Истина;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура АУ_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(ТекущийОбъект.АУ_НоменклатураСмаркировкой) Тогда
		Возврат;
	КонецЕсли;

	ПарныйОбъект = ТекущийОбъект.АУ_НоменклатураСмаркировкой.ПолучитьОбъект();
	Если ПарныйОбъект.АУ_НоменклатураСмаркировкой = ТекущийОбъект.Ссылка Тогда
		Возврат;
	КонецЕсли;

	ПарныйОбъект.АУ_НоменклатураСмаркировкой = ТекущийОбъект.Ссылка;
	ПарныйОбъект.Записать();

КонецПроцедуры

&НаКлиенте
Процедура АУ_ВидНоменклатурыПриИзмененииПосле(Элемент)

	АУ_ОбновитьЗаголовкиПарнойНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура АУ_СоздатьПарнуюНоменклатуру(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите карточку номенклатуры.'"));
		Возврат;
	КонецЕсли;

	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите карточку номенклатуры.'"));
		Возврат;
	КонецЕсли;

	Результат = АУ_СоздатьПарнуюНоменклатуруНаСервере();
	Если Результат.Успех Тогда
		Прочитать();
	Иначе
		ПоказатьПредупреждение(, Результат.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АУ_СоздатьЭлементыПарнойНоменклатуры()

	РодительГруппы = "ГруппаВидНоменклатурыИАналогичныеСвойства";
	Если Элементы.Найти("ГруппаПраво") <> Неопределено Тогда
		РодительГруппы = "ГруппаПраво";
	КонецЕсли;

	ГруппаПарной = АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычная(
		ЭтаФорма,
		"АУ_ГруппаПарнаяНоменклатура",
		РодительГруппы,
		НСтр("ru = 'Парная номенклатура'"),
		1);

	ГруппаАкцизы = Элементы.Найти("СворачиваемаяГруппаПодакцизныхКатегорий");
	Если ГруппаАкцизы <> Неопределено Тогда
		ГруппаПарной.Поведение = ГруппаАкцизы.Поведение;
		ГруппаПарной.ОтображениеУправления = ГруппаАкцизы.ОтображениеУправления;
		ГруппаПарной.Отображение = ГруппаАкцизы.Отображение;
		ГруппаПарной.ШрифтЗаголовка = ГруппаАкцизы.ШрифтЗаголовка;
		ГруппаПарной.ЦветТекстаЗаголовка = ГруппаАкцизы.ЦветТекстаЗаголовка;
		Элементы.Переместить(ГруппаПарной, ГруппаАкцизы.Родитель);
	Иначе
		ГруппаПарной.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
		ГруппаПарной.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	КонецЕсли;

	АУ_СозданиеЭлементовФормы.СоздатьПоле(
		ЭтаФорма,
		"АУ_НоменклатураСмаркировкой",
		"АУ_ГруппаПарнаяНоменклатура",
		"",
		1,
		"Объект.АУ_НоменклатураСмаркировкой");

	АУ_СозданиеЭлементовФормы.СоздатьКоманду(
		ЭтаФорма,
		"АУ_СоздатьПарнуюНоменклатуру",
		"",
		"АУ_СоздатьПарнуюНоменклатуру");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(
		ЭтаФорма,
		"АУ_СоздатьПарнуюНоменклатуру",
		"АУ_ГруппаПарнаяНоменклатура",
		"",
		"АУ_СоздатьПарнуюНоменклатуру",
		2);

	АУ_ОбновитьЗаголовкиПарнойНоменклатуры();
	ГруппаПарной.Скрыть();

КонецПроцедуры

&НаСервере
Процедура АУ_ОбновитьЗаголовкиПарнойНоменклатуры()

	Маркируемая = АУ_ОбщиеПроцедурыИФункцииСервер.АУ_ЭтоМаркируемыйВидНоменклатуры(Объект.ВидНоменклатуры);

	Если Маркируемая Тогда
		ЗаголовокПоля = НСтр("ru = 'Номенклатура без маркировки'");
		ЗаголовокКоманды = НСтр("ru = 'Создать карточку номенклатуры без маркировки'");
	Иначе
		ЗаголовокПоля = НСтр("ru = 'Номенклатура с маркировкой'");
		ЗаголовокКоманды = НСтр("ru = 'Создать карточку номенклатуры с маркировкой'");
	КонецЕсли;

	ПолеПары = Элементы.Найти("АУ_НоменклатураСмаркировкой");
	Если ПолеПары <> Неопределено Тогда
		ПолеПары.Заголовок = ЗаголовокПоля;
	КонецЕсли;

	КомандаПары = Команды.Найти("АУ_СоздатьПарнуюНоменклатуру");
	Если КомандаПары <> Неопределено Тогда
		КомандаПары.Заголовок = ЗаголовокКоманды;
	КонецЕсли;

	КнопкаПары = Элементы.Найти("АУ_СоздатьПарнуюНоменклатуру");
	Если КнопкаПары <> Неопределено Тогда
		КнопкаПары.Заголовок = ЗаголовокКоманды;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АУ_СоздатьПарнуюНоменклатуруНаСервере()

	Возврат АУ_ОбщиеПроцедурыИФункцииСервер.АУ_СоздатьИлиНайтиПарнуюНоменклатуру(Объект.Ссылка);

КонецФункции
