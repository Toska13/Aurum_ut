#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_СозданиеЭлементовФормы.СоздатьСтраница(ЭтаФорма, "АУ_СтраницаАльтернативныеНаименования", Элементы.СтраницыКарточкаНоменклатуры, "Альтернативные наименования", 1);
	
	СтруктураКолонок = Новый Структура("НаименованиеПолное");
	АУ_СозданиеЭлементовФормы.СоздатьТаблицаФормы(ЭтаФорма, "АУ_АльтернативныеНаименования", "АУ_СтраницаАльтернативныеНаименования", "Объект.АУ_АльтернативныеНаименования", СтруктураКолонок);
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_КодРаздел7ДекларацииНДС", "СворачиваемаяГруппаКлассификаторы",, 1, "Объект.АУ_КодРаздел7ДекларацииНДС",,, "КодВидаНоменклатурнойКлассификации");
	
	Элементы.Переместить(Элементы.Родитель, Элементы.ГруппаШапка, Элементы.Штрихкод);
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_ВАрхиве", "ГруппаВидНоменклатурыИАналогичныеСвойства",, 2, "Объект.АУ_ВАрхиве");

	АУ_СоздатьЭлементыПарнойНоменклатуры();
	
	Элементы.ЗаполнитьНаименованиеДляПечатиПоШаблону.Видимость = Истина;
	Элементы.ЗаполнитьНаименованиеДляПечатиПоШаблону.Доступность = Истина;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.ВидНоменклатуры = АУ_ОбщиеПроцедурыИФункцииСерверПовтИсп.ПолучитьЗначениеНастройки("ВидНоменклатурыПоУмолчанию");
		ВидНоменклатурыПриИзмененииНастройкаФормы();
		Объект.ЕдиницаИзмерения = АУ_ОбщиеПроцедурыИФункцииСерверПовтИсп.ПолучитьЗначениеНастройки("ЕдиницаИзмеренияПоУмолчанию");
		Объект.ЕдиницаДляОтчетов = Объект.ЕдиницаИзмерения;
		АУ_ОбновитьЗаголовкиПарнойНоменклатуры();
		
	КонецЕсли;
	
КонецПроцедуры

