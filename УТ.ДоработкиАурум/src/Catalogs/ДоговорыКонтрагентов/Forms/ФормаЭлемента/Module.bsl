#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ГруппаСтатус = АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_ГруппаСтатус", "ГруппаШапкаПраво", 3);
	Элементы.Переместить(Элементы.Статус, ГруппаСтатус);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_КраткийНомер", "АУ_ГруппаСтатус", "Краткий номер контракта", 1, "Объект.АУ_КраткийНомер");
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "СпособВыставленияДокументов", "ГруппаПорядокРасчетовПоДоговору", "Способ выставления документов", 1, "Объект.СпособВыставленияДокументов");
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ОткрытьФайлы", "Файлы", "АУ_ОткрытьФайлы");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ОткрытьФайлы", ЭтаФорма.КоманднаяПанель, "Файлы", "АУ_ОткрытьФайлы", 1);
	
	ГруппаПоставка = АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычная(ЭтаФорма, "АУ_ГруппаПоставка", "ГруппаРасчетыПравая", "Поставка", 1);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_ВариантУказанияСроковПоставки", ГруппаПоставка,, 1, "Объект.АУ_ВариантУказанияСроковПоставки");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_КоличествоДнейНаПоставку", ГруппаПоставка,, 1, "Объект.АУ_КоличествоДнейНаПоставку");
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_ГруппаКомиссия", "ГруппаПорядокРасчетовПоДоговору", 3, 1, 2,, "ГруппаГрафикИсполненияВДоговоре");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_СуммаКомиссии", "АУ_ГруппаКомиссия",, 1, "Объект.АУ_СуммаКомиссии");
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.АУ_ВариантУказанияСроковПоставки = Перечисления.АУ_ВариантыУказанияСроковПоставки.ВДоговоре;
		Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		Объект.Менеджер = Пользователи.АвторизованныйПользователь();
		Объект.Подразделение = Объект.Менеджер.Подразделение;
		Объект.СпособВыставленияДокументов = Перечисления.СпособыВыставленияДокументов.Автоматически;
		Объект.СтатьяДвиженияДенежныхСредств = Объект.Менеджер.АУ_СтатьяДДС;
		Объект.Организация = АУ_ОбщиеПроцедурыИФункцииСерверПовтИсп.ПолучитьЗначениеНастройки("ОрганизацияАурум");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АУ_НомерПриИзмененииПосле(Элемент)
	
	Объект.АУ_КраткийНомер = Прав(Объект.Номер, 4);
	
КонецПроцедуры

&НаСервере
&После("ТипДоговораПриИзмененииСервер")
Процедура АУ_ТипДоговораПриИзмененииСервер()
	
	Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АУ_ОткрытьФайлы(Команда)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		
		РаботаСФайламиКлиент.ОткрытьФормуСпискаФайлов(Объект.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
