#Область ПрограммныйИнтерфейс

// Отключает подписку на события изменения элементов формы, затем вызывает исходную процедуру.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, для которой настраивается подписка
//  ИменаЭлементов - Массив из Строка - имена элементов формы
//
&Вместо("УстановитьПодпискуНаСобытияИзмененияЭлементовФормы")
Процедура АУ_УстановитьПодпискуНаСобытияИзмененияЭлементовФормы(Форма, ИменаЭлементов) Экспорт
	
	Попытка
		ИменаЭлементов.Очистить();
	Исключение
		// Элементы могут не поддерживать очистку - продолжаем вызов типовой процедуры
	КонецПопытки;
	
	ПродолжитьВызов(Форма, ИменаЭлементов);
	
КонецПроцедуры

#КонецОбласти

