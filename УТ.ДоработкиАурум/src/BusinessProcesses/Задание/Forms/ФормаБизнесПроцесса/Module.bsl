#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_ГруппаПроверка", "Документ", 3,,,, "ГруппаОбщиеСведения");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_НаПроверке", "АУ_ГруппаПроверка", "Доп.проверка выполнения", 2, "Объект.АУ_НаПроверке", Новый Структура("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Право), Новый Структура("ПриИзменении", "АУ_НаПроверкеПриИзменении"));
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_ГруппаПроверяющий", "АУ_ГруппаПроверка", 2);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Проверяющий", "АУ_ГруппаПроверяющий", "", 1, "Объект.АУ_Проверяющий", Новый Структура("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет));
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_ГруппаСрокПроверки", "АУ_ГруппаПроверяющий", 2);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_СрокПроверки", "АУ_ГруппаСрокПроверки", "Срок", 1, "Объект.АУ_СрокПроверки", Новый Структура("ФорматРедактирования", "ДЛФ=D"));
	
	АУ_УстановитьДоступностьПроверяющего(ЭтаФорма);
	
	Таблица = АУ_СозданиеЭлементовФормы.СоздатьТаблицаФормы(ЭтаФорма, "АУ_Предметы", ЭтаФорма, "Объект.АУ_Предметы", Новый Структура("Предмет"));
	Таблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	Таблица.Заголовок = "Дополнительные предметы";
	
	Если Объект.АУ_ВидЗадания = Перечисления.АУ_ВидыЗаданий.УточнениеДатыИсполненияКонтракта Тогда
		
		Если Объект.АУ_ВариантИсполненияКонтракта = 1 Тогда
			
			СтруктураСвойств = Новый Структура("Заголовок", "Контракт будет исполнен в срок !");
			СтруктураСвойств.Вставить("ЦветТекста", WebЦвета.Зеленый);
			СтруктураСвойств.Вставить("Шрифт", Новый Шрифт(, 12, Истина));
			СтруктураСвойств.Вставить("АвтоМаксимальнаяШирина", Ложь);
			АУ_СозданиеЭлементовФормы.СоздатьДекорация(ЭтаФорма, "АУ_РезультатВыполненияСрокаПереноса", "Шапка", СтруктураСвойств);
			
		ИначеЕсли Объект.АУ_ВариантИсполненияКонтракта = 2 Тогда
			
			СтруктураСвойств = Новый Структура("Заголовок", СтрШаблон("Контракт не будет исполнен в срок ! Дата переноса %1", Формат(Объект.АУ_ПеренесенныйСрокИсполненияКонтракта, "ДФ=dd.MM.yyyy")));
			СтруктураСвойств.Вставить("ЦветТекста", WebЦвета.Красный);
			СтруктураСвойств.Вставить("Шрифт", Новый Шрифт(, 12, Истина));
			СтруктураСвойств.Вставить("АвтоМаксимальнаяШирина", Ложь);
			АУ_СозданиеЭлементовФормы.СоздатьДекорация(ЭтаФорма, "АУ_РезультатВыполненияСрокаПереноса", "Шапка", СтруктураСвойств);
			
		КонецЕсли;
		
	КонецЕсли;
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Цвет", "ГруппаСостояние",, 1, "Объект.АУ_Цвет");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АУ_НаПроверкеПриИзменении(Элемент)
	
	АУ_УстановитьДоступностьПроверяющего(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АУ_ДобавитьПредмет(Команда)
	
	//АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"АУ_ПредметыПредмет","АУ_ГруппаПроверка","Доп.проверка выполнения",2,"Объект.АУ_НаПроверке",Новый Структура("ПоложениеЗаголовка",ПоложениеЗаголовкаЭлементаФормы.Право),Новый Структура("ПриИзменении","АУ_НаПроверкеПриИзменении"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура АУ_УстановитьДоступностьПроверяющего(Форма)
	
	ДоступностьПоля = Форма.Объект.АУ_НаПроверке;
	Форма.Элементы.АУ_ГруппаПроверяющий.Доступность = ДоступностьПоля;
	
КонецПроцедуры

