#Область ВебСервис

Функция ПолучитьСтруктуруПараметровДляОбработкиЗапроса() Экспорт
	
	Результат=Новый Структура;
	Результат.Вставить("ИмяМетода", "");
	Результат.Вставить("ТипМетода", "");
	Результат.Вставить("ЗапросХТТП", "");
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьЗапрос(Параметры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ТелоЗапроса = РаскодироватьСтроку(Параметры.ЗапросХТТП.ПолучитьТелоКакСтроку(), СпособКодированияСтроки.КодировкаURL);
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ПараметрыЗапроса = ПолучитьОбъектИзJSON(ТелоЗапроса);
		Иначе
			ПараметрыЗапроса = Новый Структура;
		КонецЕсли;
		
		Если Параметры.ИмяМетода = "/GetEmployees" Тогда
			Возврат ПолучитьСписокСотрудников(ПараметрыЗапроса);
		ИначеЕсли Параметры.ИмяМетода = "/GetProfiles" Тогда
			Возврат ПолучитьПрофилиГруппДоступа(ПараметрыЗапроса);
		ИначеЕсли Параметры.ИмяМетода = "/GetGroups" Тогда
			Возврат ПолучитьГруппыДоступа(ПараметрыЗапроса);
		ИначеЕсли Параметры.ИмяМетода = "/GetUsers" Тогда
			Возврат ПолучитьПользователей(ПараметрыЗапроса);
		ИначеЕсли Параметры.ИмяМетода = "/CreateUpdateUser" Тогда
			Возврат СоздатьОбновитьПользователя(ПараметрыЗапроса);
		ИначеЕсли Параметры.ИмяМетода = "/GetDivisions" Тогда
			Возврат ПолучитьПодразделения(ПараметрыЗапроса);
		ИначеЕсли Параметры.ИмяМетода = "/GetUprDivisions" Тогда
			Возврат ПолучитьСтруктуруПредприятия(ПараметрыЗапроса);
		Иначе
			Возврат СоздатьОшибкуВозвратаВебСервиса(404, "UNKNOWN", 404, "UNKNOWN", "Неизвестный метод работы с сервисом");
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		Возврат СоздатьОшибкуВозвратаВебСервиса(401, "Error", 401, "Error", Ошибка);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

#КонецОбласти

#Область Интерфейс

Функция ПолучитьСписокСотрудников(ПараметрыЗапроса)
	
	Результат = ДГ_РаботаССервисомСервер.ПолучитьСписокСотрудников(ПараметрыЗапроса);
	
	Если Результат.Результат Тогда
		Ответ = Новый HTTPСервисОтвет(200,"OK");
		Ответ.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ЗаписатьОбъектВJSON(Результат.Данные));
		Возврат Ответ;
	Иначе
		Возврат СоздатьОшибкуВозвратаВебСервиса(401, "Error", Результат.КодОшибки, Результат.ТекстОшибки);
	КонецЕсли;
	
КонецФункции

