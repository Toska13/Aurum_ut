#Область Интерфейс

Функция ПолучитьСтруктуруОтвета() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Результат", Ложь);
	Результат.Вставить("Данные");
	Результат.Вставить("КодОшибки");
	Результат.Вставить("ТекстОшибки");
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьОшибкуДляВозврата(Ответ, КодОшибки, ТекстОшибки) Экспорт
	
	Ответ.Результат = Ложь;
	Ответ.КодОшибки = КодОшибки;
	Ответ.ТекстОшибки = ТекстОшибки;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьСписокСотрудников(ПараметрыЗапроса) Экспорт
	
	Ответ = ПолучитьСтруктуруОтвета();
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	
	Если Найти(Метаданные.Имя, "ЗарплатаИУправлениеПерсоналом") > 0 Тогда
	
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КадроваяИсторияСотрудниковИнтервальный.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПРЕДСТАВЛЕНИЕ(КадроваяИсторияСотрудниковИнтервальный.ФизическоеЛицо.Пол) КАК Пол,
		|	КадроваяИсторияСотрудниковИнтервальный.ФизическоеЛицо.ДатаРождения КАК ДатаРождения,
		|	КадроваяИсторияСотрудниковИнтервальный.Должность КАК Должность,
		|	КадроваяИсторияСотрудниковИнтервальный.Подразделение КАК Подразделение,
		|	КадроваяИсторияСотрудниковИнтервальный.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА КадроваяИсторияСотрудниковИнтервальный.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Уволен,
		|	ВЫБОР
		|		КОГДА КадроваяИсторияСотрудниковИнтервальный.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|			ТОГДА 4
		|		КОГДА ВидыЗанятостиСотрудниковИнтервальный.ВидЗанятости = ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ОсновноеМестоРаботы)
		|			ТОГДА 1
		|		КОГДА ВидыЗанятостиСотрудниковИнтервальный.ВидЗанятости = ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ВнутреннееСовместительство)
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудниковИнтервальный КАК КадроваяИсторияСотрудниковИнтервальный
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыЗанятостиСотрудниковИнтервальный КАК ВидыЗанятостиСотрудниковИнтервальный
		|		ПО КадроваяИсторияСотрудниковИнтервальный.Сотрудник = ВидыЗанятостиСотрудниковИнтервальный.Сотрудник
		|			И (КОНЕЦПЕРИОДА(КадроваяИсторияСотрудниковИнтервальный.ДатаНачала, ДЕНЬ) МЕЖДУ ВидыЗанятостиСотрудниковИнтервальный.ДатаНачала И ВидыЗанятостиСотрудниковИнтервальный.ДатаОкончания)
		|ГДЕ
		|	&Дата МЕЖДУ КадроваяИсторияСотрудниковИнтервальный.ДатаНачала И КадроваяИсторияСотрудниковИнтервальный.ДатаОкончания
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет
		|ИТОГИ ПО
		|	ФизическоеЛицо";
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
		|	ПРЕДСТАВЛЕНИЕ(ФизическиеЛица.Пол) КАК Пол,
		|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
		|	"""" КАК Должность,
		|	"""" КАК Подразделение,
		|	"""" КАК Организация,
		|	ЛОЖЬ КАК Уволен
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДата()));
	
	ВыборкаФизическоеЛицо = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Пока ВыборкаФизическоеЛицо.Следующий() Цикл
		
		Выборка = ВыборкаФизическоеЛицо.Выбрать();
		Выборка.Следующий();
		
		Результат.Добавить(ПолучитьДанныеФизическогоЛица(Выборка));
		
	КонецЦикла;
	
	Ответ.Результат = Истина;
	Ответ.Данные = Результат;
	
	Возврат Ответ;
	
КонецФункции

