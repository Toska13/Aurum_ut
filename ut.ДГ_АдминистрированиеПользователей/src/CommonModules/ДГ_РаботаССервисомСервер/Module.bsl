Функция ПолучитьДанныеПользователя(Пользователь)
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("Наименование", Пользователь.Наименование);
	Результат.Вставить("ИдентификаторПользователяИБ", Строка(Пользователь.ИдентификаторПользователяИБ));
	Результат.Вставить("Подразделение", ПолучитьДанныеСтруктураПредприятия(Пользователь.Подразделение));
	Результат.Вставить("ФизическоеЛицо", ПолучитьДанныеСправочникаФизическогоЛица(Пользователь.ФизическоеЛицо));
	Результат.Вставить("Недействителен", Пользователь.Недействителен);
	Результат.Вставить("Идентификатор", Строка(Пользователь.УникальныйИдентификатор()));
	Результат.Вставить("ГруппыДоступа", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|ГДЕ
	|	ГруппыДоступаПользователи.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.ГруппыДоступа.Добавить(ПолучитьДанныеГруппыДоступа(Выборка.Ссылка));
	КонецЦикла;
	
	СвойстваПользователяИБ = Пользователи.СвойстваПользователяИБ(Пользователь.ИдентификаторПользователяИБ);
	Если НЕ СвойстваПользователяИБ = Неопределено Тогда
		
		Результат.Вставить("Логин", СвойстваПользователяИБ.Имя);
		Результат.Вставить("АутентификацияОС", СвойстваПользователяИБ.АутентификацияОС);
		Результат.Вставить("ПользовательОС", СвойстваПользователяИБ.ПользовательОС);
		Результат.Вставить("Пароль", СвойстваПользователяИБ.Пароль);
		Результат.Вставить("АдресЭлектроннойПочты", СвойстваПользователяИБ.АдресЭлектроннойПочты);
		Результат.Вставить("ПоказыватьВСпискеВыбора", СвойстваПользователяИБ.ПоказыватьВСпискеВыбора);
		Результат.Вставить("ЗапрещеноИзменятьПароль", СвойстваПользователяИБ.ЗапрещеноИзменятьПароль);
		Результат.Вставить("ЗапрещеноВосстанавливатьПароль", СвойстваПользователяИБ.ЗапрещеноВосстанавливатьПароль);
		
	Иначе
		
		Результат.Вставить("Логин", "");
		Результат.Вставить("АутентификацияОС", "");
		Результат.Вставить("ПользовательОС", "");
		Результат.Вставить("Пароль", "");
		Результат.Вставить("АдресЭлектроннойПочты", "");
		Результат.Вставить("ПоказыватьВСпискеВыбора", Ложь);
		Результат.Вставить("ЗапрещеноИзменятьПароль", Ложь);
		Результат.Вставить("ЗапрещеноВосстанавливатьПароль", Ложь);
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СведенияОПользователях КАК СведенияОПользователях
	|ГДЕ
	|	СведенияОПользователях.Пользователь = &Пользователь";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("ПотребоватьСменуПароляПриВходе", Выборка.ПотребоватьСменуПароляПриВходе);
	Иначе
		Результат.Вставить("ПотребоватьСменуПароляПриВходе", Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

