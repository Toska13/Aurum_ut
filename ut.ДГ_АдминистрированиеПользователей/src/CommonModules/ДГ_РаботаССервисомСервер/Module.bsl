Функция ПолучитьДанныеФизическогоЛица(Данные)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Код", Данные.ФизическоеЛицо.Код);
	Результат.Вставить("Наименование", Данные.ФизическоеЛицо.Наименование);
	Результат.Вставить("ДатаРождения", Данные.ДатаРождения);
	Результат.Вставить("Пол", Данные.Пол);
	Результат.Вставить("Уволен", Данные.Уволен);
	Результат.Вставить("Подразделение", ПолучитьДанныеПодразделения(Данные.Подразделение));
	Результат.Вставить("Должность", ПолучитьДанныеДолжности(Данные.Должность));
	Результат.Вставить("Организация", ПолучитьДанныеОрганизации(Данные.Организация));
	Результат.Вставить("Телефон", ПолучитьКонтактнуюИнформациюФизЛица(Данные.ФизическоеЛицо, Перечисления.ТипыКонтактнойИнформации.Телефон));
	Результат.Вставить("ЭлектроннаяПочта", ПолучитьКонтактнуюИнформациюФизЛица(Данные.ФизическоеЛицо, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
	Результат.Вставить("Идентификатор", Строка(Данные.ФизическоеЛицо.УникальныйИдентификатор()));
	
	Возврат Результат;
	
