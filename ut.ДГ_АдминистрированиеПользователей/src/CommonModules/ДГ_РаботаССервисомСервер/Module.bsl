Функция СоздатьОбновитьПользователя(ПараметрыЗапроса) Экспорт

	Ответ = ПолучитьСтруктуруОтвета();
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса.Идентификатор) Тогда
		Пользователь = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыЗапроса.Идентификатор));
		ПользовательОбъект = Пользователь.ПолучитьОбъект();
	Иначе
		ПользовательОбъект = Справочники.Пользователи.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПользовательОбъект.ИдентификаторПользователяИБ) Тогда
		ОписаниеПользователяИБ = Пользователи.СвойстваПользователяИБ(Новый УникальныйИдентификатор(ПараметрыЗапроса.ИдентификаторПользователяИБ));
		Если ОписаниеПользователяИБ = Неопределено Тогда
			ОписаниеПользователяИБ = Пользователи.НовоеОписаниеПользователяИБ(Ложь);
		КонецЕсли;
	Иначе
		ОписаниеПользователяИБ = Пользователи.НовоеОписаниеПользователяИБ(Ложь);
	КонецЕсли;
	
	ПользовательОбъект.Наименование = ПараметрыЗапроса.Наименование;
	ПользовательОбъект.Недействителен = ПараметрыЗапроса.Недействителен;
	
	Контакт = Новый Структура("Значение, Представление");
	Контакт.Значение = ПараметрыЗапроса.ЭлектроннаяПочта;
	Контакт.Представление = ПараметрыЗапроса.ЭлектроннаяПочта;
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВJSON(Контакт);
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ПользовательОбъект, КонтактнаяИнформация, Справочники.ВидыКонтактнойИнформации.EmailПользователя, , Истина);
	
	Контакт = УправлениеКонтактнойИнформациейКлиентСервер.СтруктураПолейТелефона();
	Контакт.НомерТелефона = ПараметрыЗапроса.Телефон;
	Контакт.Представление = ПараметрыЗапроса.Телефон;
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВJSON(Контакт);
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ПользовательОбъект, КонтактнаяИнформация, Справочники.ВидыКонтактнойИнформации.ТелефонПользователя, , Истина);
	
	Для каждого стрКонтакт Из ПользовательОбъект.КонтактнаяИнформация Цикл
		стрКонтакт.ВидДляСписка = стрКонтакт.Вид;
	КонецЦикла;
	
	ОписаниеПользователяИБ.Имя = ПараметрыЗапроса.Логин;
	ОписаниеПользователяИБ.ПолноеИмя = ПараметрыЗапроса.Наименование;
	ОписаниеПользователяИБ.АдресЭлектроннойПочты = ПараметрыЗапроса.ЭлектроннаяПочта;
	ОписаниеПользователяИБ.АутентификацияСтандартная = НЕ ПараметрыЗапроса.Недействителен;
	ОписаниеПользователяИБ.ПоказыватьВСпискеВыбора = ПараметрыЗапроса.ПоказыватьВСпискеВыбора;
	Если ПараметрыЗапроса.ОбновитьПароль Тогда
		ОписаниеПользователяИБ.Пароль = ПараметрыЗапроса.Пароль;
		ОписаниеПользователяИБ.ПарольУстановлен = Истина;
	КонецЕсли;
	
	ОписаниеПользователяИБ.ЗапрещеноИзменятьПароль = ПараметрыЗапроса.ЗапрещеноИзменятьПароль;
	ОписаниеПользователяИБ.ЗапрещеноВосстанавливатьПароль = ПараметрыЗапроса.ЗапрещеноВосстанавливатьПароль;
	ОписаниеПользователяИБ.АутентификацияОС = ПараметрыЗапроса.АутентификацияОС;
	ОписаниеПользователяИБ.ПользовательОС = ПараметрыЗапроса.ПользовательОС;
	
	ПользовательОбъект.ОбменДанными.Загрузка = Истина;
	ПользовательОбъект.Записать();
	
	Пользователи.УстановитьСвойстваПользователяИБ(ПользовательОбъект.ИдентификаторПользователяИБ, ОписаниеПользователяИБ, НЕ ЗначениеЗаполнено(ПользовательОбъект.ИдентификаторПользователяИБ), Ложь);
	ПользовательОбъект.ИдентификаторПользователяИБ = ОписаниеПользователяИБ.УникальныйИдентификатор;
	ПользовательОбъект.Записать();
	
	Если ПараметрыЗапроса.ОбновитьПароль Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ПользовательОбъект.ИдентификаторПользователяИБ);
		ПользовательИБ.Пароль = ПараметрыЗапроса.Пароль;
		ПользовательИБ.Записать();
	КонецЕсли;
	
	//группы пользователей
	рег = РегистрыСведений.СоставыГруппПользователей.СоздатьМенеджерЗаписи();
	рег.ГруппаПользователей = Справочники.ГруппыПользователей.ВсеПользователи;
	рег.Пользователь = ПользовательОбъект.Ссылка;
	рег.Используется = НЕ ПараметрыЗапроса.Недействителен;
	рег.Записать(Истина);
	
	рег = РегистрыСведений.СоставыГруппПользователей.СоздатьМенеджерЗаписи();
	рег.ГруппаПользователей = ПользовательОбъект.Ссылка;
	рег.Пользователь = ПользовательОбъект.Ссылка;
	рег.Используется = НЕ ПараметрыЗапроса.Недействителен;
	рег.Записать(Истина);
	
	//дополнительные данные
	НаборЗаписей = РегистрыСведений.СведенияОПользователях.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(ПользовательОбъект.Ссылка);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		СведенияОПользователе = НаборЗаписей.Добавить();
		СведенияОПользователе.Пользователь = ПользовательОбъект.Ссылка;
	Иначе
		СведенияОПользователе = НаборЗаписей[0];
	КонецЕсли;
	СведенияОПользователе.ПотребоватьСменуПароляПриВходе = ПараметрыЗапроса.ПотребоватьСменуПароляПриВходе;
	СведенияОПользователе.НедостаточноПравДляВхода = ПараметрыЗапроса.ГруппыДоступа.Количество() = 0;
	СведенияОПользователе.НетПрав = ПараметрыЗапроса.ГруппыДоступа.Количество() = 0;
	НаборЗаписей.Записать();
	
	//группы доступа
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|ГДЕ
	|	ГруппыДоступаПользователи.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", ПользовательОбъект.Ссылка);
	ТЗГруппДоступов = Запрос.Выполнить().Выгрузить();
	
	Для каждого стрГруппаДоступа Из ПараметрыЗапроса.ГруппыДоступа Цикл
		
		ГруппаДоступа = Справочники.ГруппыДоступа.ПолучитьСсылку(Новый УникальныйИдентификатор(стрГруппаДоступа.Идентификатор));
		
		СуществующиеГруппы = ТЗГруппДоступов.НайтиСтроки(Новый Структура("Ссылка", ГруппаДоступа));
		Если СуществующиеГруппы.Количество() > 0 Тогда
			ТЗГруппДоступов.Удалить(СуществующиеГруппы[0]);
		Иначе
			ГруппаДоступаОбъект = ГруппаДоступа.ПолучитьОбъект();
			НоваяСтрока = ГруппаДоступаОбъект.Пользователи.Добавить();
			НоваяСтрока.Пользователь = ПользовательОбъект.Ссылка;
			ГруппаДоступаОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого стрГруппаДоступа Из ТЗГруппДоступов Цикл
		
		ГруппаДоступаОбъект = стрГруппаДоступа.Ссылка.ПолучитьОбъект();
		
		НайденныеСтроки = ГруппаДоступаОбъект.Пользователи.НайтиСтроки(Новый Структура("Пользователь", ПользовательОбъект.Ссылка));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			ГруппаДоступаОбъект.Пользователи.Удалить(стрНайденныеСтроки);
		КонецЦикла;
		
		ГруппаДоступаОбъект.Записать();
		
	КонецЦикла;
	
	УправлениеДоступомСлужебный.ЗапуститьОбновлениеДоступа();
	
	Ответ.Результат=Истина;
	Ответ.Данные = ПолучитьДанныеПользователя(ПользовательОбъект.Ссылка);
		
	Возврат Ответ;
	
КонецФункции

