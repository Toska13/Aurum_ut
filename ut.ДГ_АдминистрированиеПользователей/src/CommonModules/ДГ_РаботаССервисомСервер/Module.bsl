Функция ПолучитьСтруктуруПредприятия(ПараметрыЗапроса) Экспорт

	Ответ = ПолучитьСтруктуруОтвета();
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтруктураПредприятия.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Результат.Добавить(ПолучитьДанныеСтруктураПредприятия(Выборка.Ссылка));
		
	КонецЦикла;
	
	Ответ.Результат = Истина;
	Ответ.Данные = Результат;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

