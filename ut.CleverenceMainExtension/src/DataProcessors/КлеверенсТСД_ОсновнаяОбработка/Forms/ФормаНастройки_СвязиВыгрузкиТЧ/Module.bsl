&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем СтруктураДокумента1С Экспорт,
	СтруктураДокументаMS Экспорт,
	ТаблицаРеквизитовДополнительная Экспорт,
	пТабличныеЧасти Экспорт,
	пСвязиТабличныхЧастей Экспорт;	


&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Результат = Новый Структура;
	Результат.Вставить("ТабличныеЧасти", 										_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПоместитьТЧВоВременноеХранилище("ТабличныеЧасти")));
	Результат.Вставить("СвязиТабличныхЧастей", 									_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПоместитьТЧВоВременноеХранилище("СвязиТабличныхЧастей")));
	Результат.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти",  		Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти);
	Результат.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти",        		Обработчик_ПослеОбъединенияТабличнойЧасти);
	Результат.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",  	ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти);
	Результат.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти",        	ВидОбработчика_ПослеОбъединенияТабличнойЧасти);

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если пТабличныеЧасти <> Неопределено Тогда
		
		Для Каждого ЭлементМассива Из пТабличныеЧасти Цикл
			Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТабличныеЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементМассива);
			НоваяСтрока.ТабличнаяЧастьДокумента1ССтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(ЭлементМассива.ТабличнаяЧастьДокумента1С);
			
			НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(НоваяСтрока.НастройкаТЧСтрокой, 1) = "(", Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(НоваяСтрока.НастройкаТЧСтрокой));
			Если ЭлементМассива.Свойство("ВыгружатьСтрокиПоУсловиюФлаг") И ЭлементМассива.ВыгружатьСтрокиПоУсловиюФлаг = Истина Тогда
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = "Включено";
			Иначе
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = "Выключено";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если пСвязиТабличныхЧастей <> Неопределено Тогда
		
		Для Каждого ЭлементМассива Из пСвязиТабличныхЧастей Цикл
			Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = СвязиТабличныхЧастей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементМассива);
			НоваяСтрока.УсловиеСравнения = "=";
		КонецЦикла;
		
	КонецЕсли;
	
	// Список вариантов обработчиков загрузки
	СписокВариантовОбработчиков.Добавить(0, "Без обработчика");
	СписокВариантовОбработчиков.Добавить(1, "Обработчик по умолчанию");
	СписокВариантовОбработчиков.Добавить(2, "Свой обработчик");
	СписокВариантовОбработчиков.Добавить(3, "Произвольный код");

	
	СписокТабличныхЧастей1С = ПолучитьСписокТабличныхЧастей1С();
	СписокТабличныхЧастейMS = ПолучитьСписокТабличныхЧастейMS();
	
	ЗаполнитьСписокВыбора(Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS,СписокТабличныхЧастейMS); 		
	ЗаполнитьСписокВыбора(Элементы.ТабличныеЧастиНастройкаТЧСтрокой,СписокТабличныхЧастей1С);
	
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейГлавнаяТаблица,СписокТабличныхЧастей1С); 	
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейПодчиненнаяТаблица,СписокТабличныхЧастей1С); 		
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейТабличнаяЧастьДокументаMS,СписокТабличныхЧастейMS);
	
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОбъединенияТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	
	МассивИменРеквизитов = Новый Массив;
	МассивИменРеквизитов.Добавить("Обработчик_ПослеОбъединенияТабличнойЧасти");
	МассивИменРеквизитов.Добавить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти");
	
	ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов);

	ЗаполнениеСоответствияВидовОбработчиковВыгрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки = Элемент.Имя;
	Обработчик_ИзменитьЗначение = ЭтаФорма[ИмяЭлементаОбработки] <> ВыбранноеЗначение;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаПриИзменении(Элемент)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	СтруктураОбработчика	= СтруктураВидовОбработчиков[ИмяЭлементаОбработки];
	ИмяОбработчика			= СтруктураОбработчика.Тип; 
	СтрокаОбработчика		= СтруктураОбработчика.Обработчик;
	
	Элементы[СтрокаОбработчика].СписокВыбора.Очистить();
	
	БезЗаполнения	= ЭтаФорма[ИмяЭлементаОбработки] = 0;
	ПоУмолчанию		= ЭтаФорма[ИмяЭлементаОбработки] = 1;
	СвойОбработчик	= ЭтаФорма[ИмяЭлементаОбработки] = 2;	
	ПроизвольныйКод	= ЭтаФорма[ИмяЭлементаОбработки] = 3;
	
	Если ПоУмолчанию Тогда 		
		
		// Формируем стандартное имя процедуры
		ТипОбработчика = СтрЗаменить(ИмяОбработчика, "ТабличнойЧасти", "ТЧ");
		ЭтаФорма[СтрокаОбработчика] = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика(ТипОбработчика, ТипДокумента1С);
		
	ИначеЕсли СвойОбработчик Тогда
		
		// Оставляем пустое строковое поле для ручного ввода имени процедуры, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
		КонецЕсли;
		
	ИначеЕсли ПроизвольныйКод Тогда
		
		// Очищаем строку обработчика и предоставляем возможность выбора из списка подходящих кодов, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
			
			// В обычных формах подменяем поле ввода обработчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[СтрокаОбработчика].Видимость = Ложь;
				Элементы[СтрокаОбработчика + "Выбор"].Видимость = Истина;
				Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Очистить();
				Элементы[СтрокаОбработчика + "Выбор"].ВыделенныйТекст = "";
			#КонецЕсли
			
			Элементы[СтрокаОбработчика].ВыделенныйТекст = "";					
		Иначе
			ТекЗначение = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ЭтаФорма[СтрокаОбработчика]);
			Если ТекЗначение <> Неопределено Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#Иначе
					Элементы[СтрокаОбработчика].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#КонецЕсли
			КонецЕсли;                                                                                             			
		КонецЕсли;					
		
	ИначеЕсли БезЗаполнения Тогда
		
		ЭтаФорма[СтрокаОбработчика] = "";	
		
	КонецЕсли;
	
	ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Возвращаем видимость поля ввода обработчика, если выбран не произвольный код
		Если Не ПроизвольныйКод Тогда
			Элементы[СтрокаОбработчика].Видимость = Истина;
			Элементы[СтрокаОбработчика + "Выбор"].Видимость = Ложь;							
		Иначе
			ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика + "Выбор"];		
		КонецЕсли;                                                                                                                             		    		
	#КонецЕсли
	
	УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокиОбработчика, ЭтаФорма[СтрокаОбработчика], ЭтаФорма[ИмяЭлементаОбработки]);
	
	Если Обработчик_ИзменитьЗначение Тогда
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаНачалоВыбораОбработчикаВыгрузки(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
		
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
	
		ПредыдущееЗначение 		= ЭтаФорма[ИмяЭлементаОбработки];		
		СтандартнаяОбработка 	= Ложь;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаСписка_ПроизвольныеКоды", ПредыдущееЗначение); 
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаОткрытиеОбработчикаВыгрузки(Элемент, СтандартнаяОбработка)
		
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
	
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
				
		СтандартнаяОбработка 	= Ложь;
		Если ПустаяСтрока(ЭтаФорма[ИмяЭлементаОбработки]) Тогда
			Возврат;
		КонецЕсли;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаНастройки_ПроизвольныйКод", ЭтаФорма[ИмяЭлементаОбработки], Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, ИмяФормыПК, ТекущееЗначение, ЭтоФормаЭлемента = Ложь) 
	
	ЭтоОбработчикЗаполнения = Ложь;
	ДопКлючНастройки 		= "";
	ДопТипОбработки			= "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды = ПолучитьФорму("ОФ_" + ИмяФормыПК, ЭтаФорма);
	#Иначе
		Форма_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма." + ИмяФормыПК, , ЭтаФорма, ЭтаФорма);
		Форма_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	Форма_ПроизвольныеКоды._ЛокКонтекст 			= _ЛокКонтекст;
	ДопКлючНастройки								= ПолучитьКлючНастройкиОбработчикаВыгрузки(ИмяЭлементаОбработки);
	ДопТипОбработки									= СтрЗаменить(ДопКлючНастройки, "Выгрузка_", "");
	
	Форма_ПроизвольныеКоды.КлючНастройки 			= ДопКлючНастройки;			
	
	Форма_ПроизвольныеКоды.ТипИсходногоДокумента1С 	= ТипДокумента1С;
	Форма_ПроизвольныеКоды.ИмяТабличнойЧасти1С 		= ИмяТабличнойЧасти1С;
	
	//АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	//Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
	//	Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
	//	Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= ТаблицаРеквизитовДополнительная;
	//ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
	//	Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= ТаблицаРеквизитовДополнительная;
	//	Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
	//КонецЕслИ;
	
	Если ЭтоФормаЭлемента Тогда
		Форма_ПроизвольныеКоды.ЭтоНоваяНастройка	= Ложь;				
		
		ТаблицаПроизвольныхКодов	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды", Истина);
		ДанныеПроизвольногоКода 	= _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ТаблицаПроизвольныхКодов, "ID_ПроизвольногоКода", ТекущееЗначение);
		
		ЗаполнитьЗначенияСвойств(Форма_ПроизвольныеКоды, ДанныеПроизвольногоКода);
	КонецЕсли; 
	
	ДопПараметрыОповещения = Новый Структура("ПредыдущееЗначение, СтрокаОбработчика, ДопТипОбработки", 
		ТекущееЗначение, 
		ИмяЭлементаОбработки, 
		ДопТипОбработки);
	
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие", ЭтаФорма, ДопПараметрыОповещения);
	Форма_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		Форма_ПроизвольныеКоды.Открыть();		
	#КонецЕсли 	

КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ОбновитьСписокПроизвольныхКодов(ДопПараметры.ДопТипОбработки);
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика + "Выбор";
	#Иначе
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	#КонецЕсли      	
	ИмяОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	
	Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.Очистить();
	
	ЗаполнитьСписокВыбора(Элементы[ИмяПоляОбработчикаСобытия], СписокПроизвольныхКодовОбработчиков);	
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);		
	Иначе 
		НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ВыбранноеЗначение);		
	КонецЕсли;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;		
	ИначеЕсли Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.НайтиПоЗначению(НайденныйЭлементСписка.Значение) = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;
	Иначе
		ЭтаФорма[ИмяОбработчикаСобытия] = НайденныйЭлементСписка.Значение;
	КонецЕсли;	
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастей1С()
	
	СписокТЧ = Новый СписокЗначений;
	Для Каждого ЭлементТЧ Из СтруктураДокумента1С.ТабличныеЧасти Цикл
		СписокТЧ.Добавить(ЭлементТЧ.Значение.Имя, ЭлементТЧ.Значение.Синоним);
	КонецЦикла;
	Если СписокТЧ.НайтиПоЗначению("(Запрос)") = Неопределено Тогда
		СписокТЧ.Добавить("(Запрос)", "(Запрос)");
	КонецЕсли;
	
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено Тогда
		Для Каждого КлючЗначение Из СписокДополнительныхОбработчиков Цикл
			Синоним = ?(КлючЗначение.Значение.Свойство("Синоним"),КлючЗначение.Значение.Синоним,КлючЗначение.Ключ);
			СписокТЧ.Добавить(КлючЗначение.Ключ,Синоним);	
		КонецЦикла;
	КонецЕсли;

	
	СписокТЧ.СортироватьПоПредставлению();
	
	Возврат СписокТЧ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастейMS()
	
	СписокТЧ = Новый СписокЗначений;
	
	СписокТЧ.Добавить("СтрокиФакт");
	СписокТЧ.Добавить("СтрокиПлан");
	СписокТЧ.Добавить("СерииПлан");
	СписокТЧ.Добавить("СерииФакт");
	СписокТЧ.Добавить("СерийныеНомераПлан");
	СписокТЧ.Добавить("СерийныеНомераФакт");
		
	СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
	
	Для Каждого ДопТаблица Из СписокДопТаблиц Цикл		
		СписокТЧ.Добавить(ДопТаблица.Представление);		
	КонецЦикла;	
	
	Возврат СписокТЧ;
	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Элемент, Список)
	
	Приемник = Элемент.СписокВыбора;
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение, Элем.Представление);	
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ТипЗнч(Элемент) = Тип("ПолеВыбора") Тогда
			Элемент.РежимВыбораИзСписка = Истина;
			Элемент.КнопкаСпискаВыбора 	= Истина;
		КонецЕсли;		
	#Иначе
		Элемент.РежимВыбораИзСписка 	= Истина;
		Элемент.КнопкаВыпадающегоСписка = Истина;		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
		
	НоваяСтрока = ТабличныеЧасти.Добавить();	
	НоваяСтрока.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;	
	
	НоваяСтрока.Настроить 					  = "Настроить";
	НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = Ложь;
	НоваяСтрока.ВыгружатьСтрокиПоУсловию 	  = "Выключено";
	
	Если Копирование Тогда
		ТекущаяСтрока = Элементы.ТабличныеЧасти.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , "ТабличнаяЧастьДокументаMS, ТабличнаяЧастьДокумента1ССтрокой");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.ТабличнаяЧастьДокумента1ССтрокой) Тогда
		ТабличнаяЧастьДокумента1С = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НоваяСтрока.ТабличнаяЧастьДокумента1ССтрокой);
		НоваяСтрока.Настроить = ?(НоваяСтрока.ТабличнаяЧастьДокумента1С.Количество(), "Настроено", "Настроить");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиНастройкаТЧСтрокойПриИзменении(Элемент)
		
	ТекущаяСтрока = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(ТекущаяСтрока.НастройкаТЧСтрокой, 1) = "(", Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(ТекущаяСтрока.НастройкаТЧСтрокой));
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловию		  = "Выключено";
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = Ложь;
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = "";	
		
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие(РезультатРедактирования,ТекущаяСтрока) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, РезультатРедактирования);
		ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой 	= _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(РезультатРедактирования.ТаблицаНастроек);		
		ТекущаяСтрока.Настроить							= "Настроено";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_УсловияВыгрузкиСтрокТЧЗакрытие(РезультатРедактирования, СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ТекущаяСтрока 								  = СтруктураПараметров.ТекущаяСтрока;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = РезультатРедактирования.УдалятьСтрокиПоУсловиюСтрокой;
		
		Если РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = "Включено";
		Иначе
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = "Выключено";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		КолонкаИмя = Элемент.ТекущаяКолонка.Имя;
	#Иначе
		КолонкаИмя = Элемент.ТекущийЭлемент.Имя;	
	#КонецЕсли
	
	ИмяКолонкиНастройкаПолей  = ВРег(СокрЛП("ТабличныеЧастиНастроить"));
	ИмяКолонкиУсловияВыгрузки = ВРег(СокрЛП("ТабличныеЧастиВыгружатьСтрокиПоУсловию"));
	
	Если ВРег(СокрЛП(КолонкаИмя)) <> ИмяКолонкиНастройкаПолей
		И ВРег(СокрЛП(КолонкаИмя)) <> ИмяКолонкиУсловияВыгрузки Тогда		
		Возврат;			
	КонецЕсли; 
	
	ТекущаяСтрока = Элементы.ТабличныеЧасти.ТекущиеДанные;
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиУсловияВыгрузки Тогда
		Если НЕ ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных Тогда
			ТекстПредупреждения = НСтр("be = 'Наладка даступна толькі для таблічных частак з метададзеных канфігурацыі 1С'; en = 'Configuration is only available for table parts from the metadata of 1C configuration'; es = 'La configuración solo está disponible para partes tabulares de los metadatos de la configuración de 1C'; ka = 'დაყენება ხდება მხოლოდ 1C-ის კონფიგურაციის ცხრილის ნაწილებისთვის'; kk = 'Табелді бөліктердің метадеректерінен 1С конфигурациясына тек қосылу мүмкін'; ro = 'Configurarea este disponibilă doar pentru părțile tabelei din metadatele configurației 1C'; ru = 'Настройка доступна только для табличных частей из метаданных конфигурации 1С'; tr = 'Yapılandırma, 1C yapılandırma verilerinden sadece tablo bölümleri için kullanılabilir'; uk = 'Налаштування доступна лише для табличних частин з метаданих конфігурації 1С'; uz = 'Sozlash faqat 1С konfiguratsiyasining metadatalaridan jadval qismlari uchun mavjud'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.НастройкаТЧСтрокой) Тогда
		ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента 1С'; en = 'No table part of 1C document selected'; es = 'No se ha seleccionado la parte de tabla del documento 1C'; ka = 'არ არის არჩეული 1C-ის ცხრილის ნაწილი'; kk = '1С документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului 1C'; ru = 'Не выбрана табличная часть документа 1С'; tr = '1C belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа 1С'; uz = '1C hujjati jadvallar qismi tanlanmagan'");
		ПоказатьПредупреждение(, ТекстПредупреждения); 
		Возврат;
	КонецЕсли; 
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиУсловияВыгрузки Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ = ПолучитьФорму("ОФ_ФормаНастройки_УсловияУдаленияСтрокТЧ", ЭтаФорма);
		#Иначе
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_УсловияУдаленияСтрокТЧ",, ЭтаФорма, ЭтаФорма);
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ._ЛокКонтекст 		  = _ЛокКонтекст;
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ТипДокумента1С 	  = ТипДокумента1С;
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ИмяТабличнойЧасти1С = ТекущаяСтрока.НастройкаТЧСтрокой;
				
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.КомпоновщикНастроекСтрокой = ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой;
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.УдалятьСтрокиПоУсловиюФлаг = ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_УсловияВыгрузкиСтрокТЧЗакрытие", ЭтаФорма, Новый Структура("ТекущаяСтрока", ТекущаяСтрока));
