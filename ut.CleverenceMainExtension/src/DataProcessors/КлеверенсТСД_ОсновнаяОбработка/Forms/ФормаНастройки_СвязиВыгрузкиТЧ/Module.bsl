&НаКлиенте
Процедура СвязиТабличныхЧастейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
		
	НоваяСтрока = СвязиТабличныхЧастей.Добавить();	
	НоваяСтрока.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;	
	НоваяСтрока.УсловиеСравнения = "=";
	Если Копирование Тогда
		
		ТекущаяСтрока = Элементы.СвязиТабличныхЧастей.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПолеПодчиненнойТаблицы()
	ТекущаяСтрока = Элементы.СвязиТабличныхЧастей.ТекущиеДанные;	
	СписокРеквизитов1С = Новый СписокЗначений;
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено
		И ЗначениеЗаполнено(ТекущаяСтрока.ПодчиненнаяТаблица)
		И СписокДополнительныхОбработчиков.Получить(ТекущаяСтрока.ПодчиненнаяТаблица) <> Неопределено Тогда
		СписокРеквизитов1С = СписокДополнительныхОбработчиков[ТекущаяСтрока.ПодчиненнаяТаблица].СписокКолонок;
	КонецЕсли;
	
	Если СписокРеквизитов1С.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.ПодчиненнаяТаблица) Тогда
			Если ТекущаяСтрока.ПодчиненнаяТаблица = "(Запрос)" Тогда
				ТЧЗапрос = ТабличныеЧасти.НайтиСтроки(Новый Структура("НастройкаТЧСтрокой","(Запрос)"));
				Если ТЧЗапрос.Количество() = 0 Тогда
					Сообщение = НСтр("be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; en = 'Failed to retrieve a list of fields due to query execution error.'; es = 'No se pudieron obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სიას ვერ მიიღებს შეცდომის შესრულების მიზეზის გამო'; kk = 'Сұрау орындалу қатесіне қарағанда кестедегі кестелер тізімін алу мүмкін болмады.'; ro = 'Nu s-au putut obține lista de câmpuri din cauza unei erori în executarea interogării.'; ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.'; tr = 'Sorgu çalıştırma hatası nedeniyle alan listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = ""So'rovni bajarishda xato sababli maydonlar ro'yxatini olish muvaffaqiyatsiz tugadi.""");
					Сообщить(Сообщение); 
					СписокРеквизитов1С = Новый СписокЗначений;
				Иначе
					ТекстЗапросаВыгрузкиНаТСД = ТЧЗапрос[0].ТекстЗапросаВыгрузкиНаТСД;
					СписокРеквизитов1С = ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);
				КонецЕсли;
			Иначе
				СписокРеквизитов1С = СтруктураДокумента1С.ТабличныеЧасти[ТекущаяСтрока.ПодчиненнаяТаблица].Реквизиты;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейПолеПодчиненнойТаблицыСиноним,СписокРеквизитов1С);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапроса);
	
	СписокПолей = Новый СписокЗначений;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документы[ТипДокумента1С].ПустаяСсылка());
	
	ПараметрыЗапроса = Запрос.НайтиПараметры();
	Для каждого ПараметрЗапроса ИЗ ПараметрыЗапроса Цикл
		Если ПараметрЗапроса.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		Запрос.УстановитьПараметр(ПараметрЗапроса.Имя, Ложь);
	КонецЦикла;
	
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
		Для Каждого Колонка из Результат.Колонки Цикл
			СписокПолей.Добавить(Колонка.Имя, Колонка.Имя);
		КонецЦикла;
	Исключение
		Сообщение = НСтр("be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; en = 'Failed to retrieve a list of fields due to query execution error.'; es = 'No se pudieron obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სიას ვერ მიიღებს შეცდომის შესრულების მიზეზის გამო'; kk = 'Сұрау орындалу қатесіне қарағанда кестедегі кестелер тізімін алу мүмкін болмады.'; ro = 'Nu s-au putut obține lista de câmpuri din cauza unei erori în executarea interogării.'; ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.'; tr = 'Sorgu çalıştırma hatası nedeniyle alan listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = ""So'rovni bajarishda xato sababli maydonlar ro'yxatini olish muvaffaqiyatsiz tugadi.""");
		Сообщить(Сообщение); 
	КонецПопытки;
	
	Возврат СписокПолей;

КонецФункции

&НаКлиенте
Процедура ОбновитьСписокПолеГлавнойТаблицы()
	ТекущаяСтрока = Элементы.СвязиТабличныхЧастей.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ГлавнаяТаблица) Тогда
		
		СписокРеквизитов1С = Новый СписокЗначений;
		СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
		Если СписокДополнительныхОбработчиков <> Неопределено
			И ЗначениеЗаполнено(ТекущаяСтрока.ГлавнаяТаблица)
			И СписокДополнительныхОбработчиков.Получить(ТекущаяСтрока.ГлавнаяТаблица) <> Неопределено Тогда
			СписокРеквизитов1С = СписокДополнительныхОбработчиков[ТекущаяСтрока.ГлавнаяТаблица].СписокКолонок;
		КонецЕсли;
		
		Если СписокРеквизитов1С.Количество() = 0 Тогда
			Если ТекущаяСтрока.ГлавнаяТаблица = "(Запрос)" Тогда
				ТЧЗапрос = ТабличныеЧасти.НайтиСтроки(Новый Структура("НастройкаТЧСтрокой","(Запрос)"));
				Если ТЧЗапрос.Количество() = 0 Тогда
					Сообщение = НСтр("be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; en = 'Failed to retrieve a list of fields due to query execution error.'; es = 'No se pudieron obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სიას ვერ მიიღებს შეცდომის შესრულების მიზეზის გამო'; kk = 'Сұрау орындалу қатесіне қарағанда кестедегі кестелер тізімін алу мүмкін болмады.'; ro = 'Nu s-au putut obține lista de câmpuri din cauza unei erori în executarea interogării.'; ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.'; tr = 'Sorgu çalıştırma hatası nedeniyle alan listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = ""So'rovni bajarishda xato sababli maydonlar ro'yxatini olish muvaffaqiyatsiz tugadi.""");
					Сообщить(Сообщение); 
					СписокРеквизитов1С = Новый СписокЗначений;
				Иначе
					ТекстЗапросаВыгрузкиНаТСД = ТЧЗапрос[0].ТекстЗапросаВыгрузкиНаТСД;
					СписокРеквизитов1С = ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);
				КонецЕсли;
			Иначе
				СписокРеквизитов1С = СтруктураДокумента1С.ТабличныеЧасти[ТекущаяСтрока.ГлавнаяТаблица].Реквизиты;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейПолеГлавнойТаблицыСиноним,СписокРеквизитов1С);	
	КонецЕсли;
