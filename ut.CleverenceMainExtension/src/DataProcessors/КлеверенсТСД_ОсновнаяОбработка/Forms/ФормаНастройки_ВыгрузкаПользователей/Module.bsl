&НаКлиенте
Процедура ТаблицаПользователейMSНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.Действие 			= ДействиеПеретаскивания.Перемещение;
	ПараметрыПеретаскивания.ДопустимыеДействия 	= ДопустимыеДействияПеретаскивания.Перемещение;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаГруппMSПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаГруппMSПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;

	// Если нет строки назначения переноса - не продолжаем
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заносим переносимые данные (ИД и имя пользователей) в структуру
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") И ПараметрыПеретаскивания.Значение.Количество() Тогда                                    		
		СтруктураИсточник = Новый Массив;
		Для Каждого СтрокаПользователя Из ПараметрыПеретаскивания.Значение Цикл
			СтруктураИсточник.Добавить(Новый Структура("Ид,Имя", СтрокаПользователя.Ид, СтрокаПользователя.Имя));
		КонецЦикла;
	Иначе
		Возврат;
	КонецЕсли;		
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СтрокаГруппы	= Строка;
	#Иначе 
		СтрокаГруппы 	= ТаблицаГруппMS.НайтиПоИдентификатору(Строка); // Группа назначения		
	#КонецЕсли
	ТекСтрокаГруппы		= Элемент.ТекущиеДанные;  // Группа источник                                                       
	
	СтруктураПриемник 	= Новый Структура("Ид,Имя", СтрокаГруппы.Ид, СтрокаГруппы.Имя);
	СтруктураТекГруппа 	= Новый Структура("Ид,Имя", ТекСтрокаГруппы.Ид, ТекСтрокаГруппы.Имя);
	
	ОкончаниеПеретаскиванияПользователя(СтруктураИсточник, СтруктураПриемник, СтруктураТекГруппа);
	
КонецПроцедуры  

&НаКлиенте
Процедура ОкончаниеПеретаскиванияПользователя(СтруктураИсточник, СтруктураПриемник, СтруктураТекГруппа)
	
	Успешно = Ложь;
	
	// Меняем у переносимых пользователей данные группы
	Если ТипЗнч(СтруктураИсточник) = Тип("Массив") Тогда
		Для Каждого ЭлементСтруктуры Из СтруктураИсточник Цикл
			МассивСтрокТаблицы = ТаблицаПользователейПолная.НайтиСтроки(Новый Структура("Ид, Имя", ЭлементСтруктуры.Ид, ЭлементСтруктуры.Имя));
			Если МассивСтрокТаблицы.Количество() Тогда
				ТекПользователь = МассивСтрокТаблицы[0];
				ТекПользователь.ИмяГруппы 	= СтруктураПриемник.Имя;
				ТекПользователь.ИдГруппы 	= СтруктураПриемник.Ид;
				
				ПараметрыПользователя = Новый Соответствие;
				ПараметрыПользователя.Вставить("id", 			ТекПользователь.Ид);
				ПараметрыПользователя.Вставить("name", 			ТекПользователь.Имя);		
				ПараметрыПользователя.Вставить("description", 	ТекПользователь.Описание);		
				ПараметрыПользователя.Вставить("groupId", 		ТекПользователь.ИдГруппы);		
				ПараметрыПользователя.Вставить("groupName", 	ТекПользователь.ИмяГруппы);		
				ПараметрыПользователя.Вставить("warehouseIds", 	ТекПользователь.ИдСкладов.ВыгрузитьЗначения());		
				
				// Склады для кома-режима
				ПараметрыПользователя.Вставить("allWarehouses", Новый СписокЗначений);		
				
				Перенос = _ЛокКонтекст.ЛокЯдро_ЗагрузитьПользователейВSMARTS(ПараметрыПользователя);
				Если Перенос.Результат Тогда
					Успешно = Истина;
				Иначе
					Сообщение = НСтр("be = 'Не ўдалося перамясціць карыстальніка. Прычына: %1. Падрабязнасці ў журнале рэгістрацыі'; en = 'Failed to move user. Reason: %1. Details in the registration log'; es = 'No se pudo mover al usuario. Razón: %1. Detalles en el registro de eventos'; ka = 'მომხმარებელი ვერ გადაადგილდება. მიზეზი: %1. დეტალები რეგისტრაციის ჟურნალში'; kk = 'Пайдаланушыны көшіру мүмкін емес. Себеп: %1. Жазу жүрісінде толығырақтар'; ro = 'Nu s-a putut muta utilizatorul. Motivul: %1. Detalii în jurnalul de înregistrare'; ru = 'Не удалось переместить пользователя. Причина: %1. Подробности в журнале регистрации'; tr = 'Kullanıcı taşınamadı. Sebep: %1. Detaylar günlük kaydında'; uk = 'Не вдалося перемістити користувача. Причина: %1. Деталі в журналі реєстрації'; uz = 'Фойдаланувчини ўтказиш мумкин эмас. Сабаб: %1. Тафсилотлар рўйхатдан ўтишда'");
					Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, Перенос.ТекстОшибки);
					Сообщить(Сообщение); 
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;	
	
	Если Успешно Тогда
		// Обновляем фильтры таблицы пользователей
		ФильтрПользователейПоВыбраннойГруппе(СтруктураТекГруппа.Ид);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

