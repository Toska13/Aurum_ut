&НаКлиенте
Процедура ТаблицаГруппMSПриАктивизацииСтроки(Элемент)

	// При выделении группы фильтруем список пользователей в соседней таблице
	ТекДанные = Элементы.ТаблицаГруппMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда	
		ФильтрПользователейПоВыбраннойГруппе(ТекДанные.Ид);
	КонецЕсли;
	
	// Устанавливаем текущую строку
	Если ИндексВыделеннойСтроки > 0 Тогда
		Если ТаблицаПользователейMS.Количество() > (ИндексВыделеннойСтроки) Тогда
			ИндексВыделеннойСтроки = ИндексВыделеннойСтроки;
		Иначе
			ИндексВыделеннойСтроки = ИндексВыделеннойСтроки - 1;			
		КонецЕсли;		                                                                           
		#Если ТолстыйКлиентОбычноеПриложение Тогда                                                                  
			ТекСтрока = ТаблицаПользователейMS.Получить(ИндексВыделеннойСтроки);			
		#Иначе
			ТекСтрока = ТаблицаПользователейMS.Получить(ИндексВыделеннойСтроки).ПолучитьИдентификатор();			
		#КонецЕсли
		Элементы.ТаблицаПользователейMS.ТекущаяСтрока = ТекСтрока;					
		// Обнуляем реквизит, т.к. до след. удаления он не нужен
		ИндексВыделеннойСтроки = 0;
	КонецЕсли; 		  	       	
	
КонецПроцедуры

&НаСервере
Процедура ФильтрПользователейПоВыбраннойГруппе(ИдГруппы)
	
	МассивСтрокПоВыбраннойГруппе = ТаблицаПользователейПолная.НайтиСтроки(Новый Структура("ИдГруппы", ИдГруппы));	
	#Если ТолстыйКлиентОбычноеПриложение Тогда                                                            
		ТаблицаПользователейMS = ТаблицаПользователейПолная.Скопировать(МассивСтрокПоВыбраннойГруппе);
	#Иначе                                                                                               
		ТаблицаПользователейMS.Загрузить(ТаблицаПользователейПолная.Выгрузить(МассивСтрокПоВыбраннойГруппе));
	#КонецЕсли 	
	
КонецПроцедуры

