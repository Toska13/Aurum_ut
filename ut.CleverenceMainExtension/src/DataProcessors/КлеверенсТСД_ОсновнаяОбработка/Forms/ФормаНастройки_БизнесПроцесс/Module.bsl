	ФормаСписка_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		ФормаСписка_ПроизвольныеКоды.Открыть();
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныйКодЗагрузкиДокументаОчистка(Элемент, СтандартнаяОбработка)
	
	ID_ПроизвольногоКода_Загрузка_Документ = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныйКодЗагрузкиДокументаПриИзменении(Элемент)
	
	ЕстьИзмененияНаФорме = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗагрузкиДокументаПриИзменении(Элемент)
	
	ЕстьИзмененияНаФорме = Истина;	
	
КонецПроцедуры

