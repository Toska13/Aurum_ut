		СтруктураНастройки.Вставить("ID_ПроизвольногоКода_Загрузка_Документ", 		ID_ПроизвольногоКода_Загрузка_Документ);
		
		СтруктураНастройки.Вставить("ТипОбработчикаВыгрузки", 						ТипОбработчикаВыгрузки);
		СтруктураНастройки.Вставить("ТипОбработчикаЗагрузки", 						ТипОбработчикаЗагрузки);
		
		СтруктураНастройки.Вставить("НастройкаПоследовательностиБПМассивСтруктур", 		НастройкаПоследовательностиБПМассивСтруктур);
		СтруктураНастройки.Вставить("ПрерыватьПоследовательностьПриКритическойОшибке",	ПрерыватьПоследовательностьПриКритическойОшибке);
		
		Отбор = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
		Если ЭтоБылТиповойБизнесПроцесс Тогда
			_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиБизнесПроцессов_ПоУмолчанию", Отбор, СтруктураНастройки,, Истина);
		Иначе
			_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиБизнесПроцессов_Пользовательские", Отбор, СтруктураНастройки,, Истина);
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");	
		КонецЕсли;
	
	КонецЕсли;
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
	ВыгрузитьБизнесПроцессы();
	
	Если ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		// Сохраняем настройки отборов:
		//	- для новых бизнес-процессов
		//	- при изменении названия/типа исходного документа
		//
		//	1. Если это новый бизнес-процесс или исходного документа не было, сохраняем отборы для главного узла.
		//  2. Если изменился тип исходного документа, удаляем существующие отборы для всех узлов и сохраняем новые отборы для главного узла.
		//  3. Если изменилось только название бизнес-процесса, пересохраняем существующие отборы для всех узлов с новым названием.
		//
		ИзменилсяТипИсходногоДокумента 	 = НЕ СокрЛП(ТипИсходногоДокумента1С) = СокрЛП(Пред_ТипИсходногоДокумента1С);
		ИзменилосьНазваниеБизнесПроцесса = НЕ СокрЛП(Название) = СокрЛП(Пред_Название);
		
		Если ЭтоНовыйБизнесПроцесс
			ИЛИ НЕ ЗначениеЗаполнено(Пред_ТипИсходногоДокумента1С) Тогда
			СохранитьНастройкиОтборов();
		ИначеЕсли ИзменилсяТипИсходногоДокумента  Тогда
			_ЛокКонтекст.ЛокЯдро_УдалитьОтборыБизнесПроцессов(ID_БизнесПроцесса);
			
			СохранитьНастройкиОтборов();
		ИначеЕсли ИзменилосьНазваниеБизнесПроцесса Тогда
			_ЛокКонтекст.ЛокЯдро_ИзменитьОтборыБизнесПроцессов(ID_БизнесПроцесса, Новый Структура("Название", Название));
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Пред_ТипИсходногоДокумента1С) Тогда
			// Если убрали исходный документ, удаляем настройки отборов для всех узлов
			_ЛокКонтекст.ЛокЯдро_УдалитьОтборыБизнесПроцессов(ID_БизнесПроцесса);
		КонецЕсли;
	КонецЕсли;
		
	Пред_Название				 = Название;
	Пред_ТипИсходногоДокумента1С = ТипИсходногоДокумента1С;	
		
	РезультатРедактирования = ID_БизнесПроцесса;
	ЭтоНовыйБизнесПроцесс = Ложь;
	ЕстьИзмененияНаФорме  = Ложь;
	
	ОбновитьВсеДанныеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьБизнесПроцессы()
		
	ВладелецФормы.ВыгрузитьБизнесПроцессыВБазуSMARTS("");	

