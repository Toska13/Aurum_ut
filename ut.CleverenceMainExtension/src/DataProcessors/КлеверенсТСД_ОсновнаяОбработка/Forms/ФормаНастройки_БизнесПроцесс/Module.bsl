&НаКлиенте
Процедура УдалитьПользовательскиеНастройки(Команда)

	СтруктураНастроекБизнесПроцессов_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	НастройкиБизнесПроцессов_ПоУмолчанию = СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
	
	ТиповойБизнесПроцессВключен = Ложь;
	Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Массив") Тогда
		НастройкаБизнесПроцесса = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессов_ПоУмолчанию, "ID_БизнесПроцесса", ID_БизнесПроцесса);
		Если НЕ НастройкаБизнесПроцесса = Неопределено Тогда
			ТиповойБизнесПроцессВключен = НастройкаБизнесПроцесса.Свойство("Используется") И НастройкаБизнесПроцесса.Используется;
		КонецЕсли;
	КонецЕсли;
	
	Если ТиповойБизнесПроцессВключен Тогда
		СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
		
		ЕстьДокументMS = ЗначениеЗаполнено(ТипДокументаMS)
			И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
			И СтруктураМетаданных.Свойство("ДокументыMS")
			И СтруктураМетаданных.ДокументыMS.Свойство(ТипДокументаMS);
			
		Если ЕстьДокументMS Тогда
			УдалитьПользовательскиеНастройкиЗавершение();
		Иначе
			ТекстВопроса = НСтр("ru = 'Документ Клеверенс не указан или отсутствует в метаданных. Продолжить?'; en = 'Cleverence Document is not specified or missing in the metadata. Continue?'; kk = 'Cleverence құжаты бизнес процесілердің метадеректерінде көрсетілмеген немесе жоқ. Жалғастыру керек пе?'; uz = 'Cleverence ҳужжати метаданныаларда кўрсатилмаган ёки йўқ. Давом этамоқми?'; be = 'Дакумент Cleverence не ўказаны або адсутнічае ў метададзе. Працягнуць?'; uk = 'Документ Cleverence не вказаний або відсутній в метаданих. Продовжити?'; ka = 'Cleverence დოკუმენტი არ არის მოცემული ან არ არის მეტადანებში. გსურთ გაგრძელება?'; tr = 'Cleverence belgesi, meta verilerde belirtilmemiş veya bulunmamaktadır. Devam etmek istiyor musunuz?'; es = 'El documento Cleverence no está especificado o no está presente en los metadatos. ¿Continuar?'; ro = 'Documentul Cleverence nu este specificat sau lipsește din metadate. Continuați?'");
			
			ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьПользовательскиеНастройкиПослеОтветаНаВопрос", ЭтаФорма);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		КонецЕсли;
	Иначе
		УдалитьПользовательскиеНастройкиЗавершение();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользовательскиеНастройкиЗавершение()
	
	СтруктураНастроекБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;

	ПользовательскаяНастройка = Ложь;
	Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Массив") Тогда
		Индекс = 0;
		Для каждого Настройка из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
			Если Настройка.Свойство("ID_БизнесПроцесса") и Настройка.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Удалить(Индекс);		
			КонецЕсли;
			Индекс=Индекс+1;
		КонецЦикла;
		
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
			_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 						

		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 	 СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);	
	КонецЕсли;
	
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Для каждого НастройкаБП из НастройкиБизнесПроцессов Цикл
		Если НастройкаБП.Свойство("ID_БизнесПроцесса") И НастройкаБП.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкаБП);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	
	ЕстьИзмененияНаФорме = Ложь;
	Элементы.Используется.Заголовок = ?(Используется, 
		НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'"), 
		НСтр("be = 'Адключана'; en = 'Disabled'; es = 'Desactivado'; ka = 'გამორიცხა'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Отключено'; tr = 'Devre dışı'; uk = 'Відключено'; uz = ""O'chirildi  """)
	);
	ВыгрузитьБизнесПроцессы();
	ОбновитьВсеДанныеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)
	
	Если ЕстьИзмененияНаФорме Тогда
		ТекстВопроса = НСтр("be = 'Захаваць унесеныя змены?'; en = 'Save changes made?'; es = '¿Guardar los cambios realizados?'; ka = 'შენახვა შეყვანილი ცვლილებები?'; kk = 'Кірістірілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările aduse?'; ru = 'Сохранить внесенные изменения?'; tr = 'Yapılan değişiklikleri kaydetmek istiyor musunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Киритилган ўзгаришларни сақлаш керакми?  '");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("СкопироватьЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		РезультатРедактирования = Новый Структура("ID_РедактируемогоБП,Копирование",ID_БизнесПроцесса,Истина);
		Закрыть(РезультатРедактирования);
	КонецЕсли;
	
КонецПроцедуры

