&НаКлиенте 
Процедура ОбновитьСпискиПроизвольныхКодов()
	
	СписокПроизвольныхКодов_Выгрузка_Документ.Очистить();
	Отбор = Новый Структура("Направление,ТипОбъекта","Выгрузка","Документ");
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды",Отбор);		
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;			
			СписокПроизвольныхКодов_Выгрузка_Документ.Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	СписокПроизвольныхКодов_Загрузка_Документ.Очистить();
	Отбор = Новый Структура("Направление,ТипОбъекта","Загрузка","Документ");
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды",Отбор);		
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;			
			СписокПроизвольныхКодов_Загрузка_Документ.Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаименованияПроизвольныхКодов()
	
	Если ЗначениеЗаполнено(ID_ПроизвольногоКода_Выгрузка_Документ) Тогда
		ЭлементСписка = СписокПроизвольныхКодов_Выгрузка_Документ.НайтиПоЗначению(ID_ПроизвольногоКода_Выгрузка_Документ);
		Если ЭлементСписка <> Неопределено Тогда
			ПроизвольныйКодВыгрузкиДокумента = ЭлементСписка.Представление;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ID_ПроизвольногоКода_Загрузка_Документ) Тогда
		ЭлементСписка = СписокПроизвольныхКодов_Загрузка_Документ.НайтиПоЗначению(ID_ПроизвольногоКода_Загрузка_Документ);
		Если ЭлементСписка <> Неопределено Тогда
			ПроизвольныйКодЗагрузкиДокумента = ЭлементСписка.Представление;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьНастройкиОтборов()
	
	ЕстьНастройкаОтбора_Интерактивный = Ложь;
	ЕстьНастройкаОтбора_Онлайн = Ложь;
		
	Если ЭтоНовыйБизнесПроцесс
		ИЛИ НЕ ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоТекущийУзел = ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		Если ЭтоТекущийУзел Тогда
			НастройкиОтборовДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена);
		Иначе
			НастройкиОтборовДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, ID_Узла);
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
		
		НайденныеОтборы = Неопределено;
		Если ЗначениеЗаполнено(НастройкиОтборовДокументов) И НЕ НастройкиОтборовДокументов = Ложь Тогда
			НайденныеОтборы = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборовДокументов, СтруктураОтбора);
		КонецЕсли;
		
		Если НайденныеОтборы = Неопределено Тогда
			// Для торгового объекта пробуем найти настройку главного узла (при отсутствии своей)
			Если НЕ ЭтоТекущийУзел И ЗначениеЗаполнено(ID_Узла) Тогда
				НастройкиГлавногоУзла = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, "");
					
				НайденныеОтборы = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиГлавногоУзла, СтруктураОтбора);
			КонецЕсли;
		КонецЕсли;
				
		Если НЕ НайденныеОтборы = Неопределено Тогда
			НастройкаОтбора = НайденныеОтборы[0];
				
			НоваяСтрока = НастройкиОтборов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НастройкаОтбора);
			НоваяСтрока.РежимОбмена = РежимОбмена;
				
			ЭтаФорма["ЕстьНастройкаОтбора_" + РежимОбмена] = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтбора(РежимОбмена)

	НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
	Если НайденныеСтроки.Количество() Тогда
		СтрокаНастройки = НайденныеСтроки[0];
	Иначе
		НастройкаБП = Новый Структура();
		НастройкаБП.Вставить("ТипИсходногоДокумента1С", ТипИсходногоДокумента1С);
		НастройкаБП.Вставить("ID_БизнесПроцесса",		ID_БизнесПроцесса);
		НастройкаБП.Вставить("Название",				Название);		
		СтрокаНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла);
		
		Если СтрокаНастройки = Неопределено Тогда
			ТекстПредупреждения = НСтр("be = 'Тып выхаднага дакумента ""%1"" адсутнічае ў канфігурацыі 1С'; en = 'Source document type ""%1"" is missing in 1C configuration'; es = 'El tipo de documento fuente ""%1"" no está presente en la configuración de 1C'; ka = 'წყაროს დოკუმენტი ""%1"" 1C-ის კონფიგურაციაში არ არის'; kk = '""%1"" анықтамалық документтің түрі 1С конфигурациясында жоқ'; ro = 'Tipul documentului sursă ""%1"" lipsește din configurația 1C'; ru = 'Тип исходного документа ""%1"" отсутствует в конфигурации 1С'; tr = '""%1"" kaynak belge türü 1C yapılandırmasında bulunamadı'; uk = 'Тип вихідного документа ""%1"" відсутній в конфігурації 1С'; uz = 'Bosh hujjat ""%1"" 1C konfiguratsiyasida mavjud emas'");
			ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(ТипИсходногоДокумента1С));
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#Иначе
				Сообщить(ТекстПредупреждения); 
			#КонецЕсли
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ОтборДокументов = ПолучитьФорму("ОФ_ФормаНастройки_ОтборДокументов", ЭтаФорма);
	#Иначе
		ФормаНастройки_ОтборДокументов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ОтборДокументов",, ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ОтборДокументов.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_ОтборДокументов.ID_Узла						= ID_Узла;
	ФормаНастройки_ОтборДокументов.НаименованиеУзла 			= НаименованиеУзла;
	ФормаНастройки_ОтборДокументов.ID_БизнесПроцесса 			= СтрокаНастройки.ID_БизнесПроцесса;
	ФормаНастройки_ОтборДокументов.НаименованиеБП 				= СтрокаНастройки.Название;
	ФормаНастройки_ОтборДокументов.ТипДокумента1С 				= СтрокаНастройки.ТипИсходногоДокумента1С;
	ФормаНастройки_ОтборДокументов.Используется 				= СтрокаНастройки.Используется;
	ФормаНастройки_ОтборДокументов.ТипОбмена					= РежимОбмена;
	ФормаНастройки_ОтборДокументов.НастройкаКомпоновщикаСтрокой = СтрокаНастройки.НастройкаКомпоновщикаСтрокой;		
	ФормаНастройки_ОтборДокументов.ВариантОтбора 				= ?(СтрокаНастройки.ВариантОтбора = "", "Только конструктор", СтрокаНастройки.ВариантОтбора);
	ФормаНастройки_ОтборДокументов.ID_ПроизвольногоОтбора		= СтрокаНастройки.ID_ПроизвольногоОтбора;
	ФормаНастройки_ОтборДокументов._ЛокКонтекст 				= _ЛокКонтекст;
	
	ДопПараметры = Новый Структура("РежимОбмена", РежимОбмена);
	ОП = Новый ОписаниеОповещения("ФормаНастройки_ОтборДокументовЗакрытие", ЭтаФорма, ДопПараметры);
	ФормаНастройки_ОтборДокументов.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ОтборДокументов.ОткрытьМодально();
	#Иначе
		ФормаНастройки_ОтборДокументов.Открыть();
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиОтборов()

	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
		Если НайденныеСтроки.Количество() Тогда
			СтрокаНастройки = НайденныеСтроки[0];
			
			ШаблонНастройки = _ЛокКонтекст.СтруктураМетаданных.НастройкиMS["НастройкиОтборовУзлов_" + РежимОбмена];
	
			СтруктураНастройки = Новый Структура;
			Для каждого КИЗ ИЗ ШаблонНастройки Цикл
				СтруктураНастройки.Вставить(КИЗ.Ключ);
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(СтруктураНастройки, СтрокаНастройки);
		Иначе
			НастройкаБП = Новый Структура();
			НастройкаБП.Вставить("ТипИсходногоДокумента1С", ТипИсходногоДокумента1С);
			НастройкаБП.Вставить("ID_БизнесПроцесса",		ID_БизнесПроцесса);
			НастройкаБП.Вставить("Название",				Название);		
			СтруктураНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла);
			
			Если СтруктураНастройки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СохранитьНастройкуОтбора(СтруктураНастройки, РежимОбмена);
	КонецЦикла;	
	
КонецПроцедуры
	
&НаКлиенте
Процедура СохранитьНастройкуОтбора(СтруктураНастройки, РежимОбмена)
	
    // Сохраняем настройку отбора в базу SMARTS и для текущего узла - в кэш (сохранение в кэш происходит в методе ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS)
	Отбор = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
	_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиОтборовУзлов_" + РежимОбмена, Отбор, СтруктураНастройки, ID_Узла);	
	
КонецПроцедуры

&НаКлиенте
Процедура УбратьПредставлениеНазначитьПользователю()
	Если НЕ ЗначениеЗаполнено(НазначитьПользователю) Тогда
		Возврат
	КонецЕсли;
	
	СтрокаДляПреобразования = НазначитьПользователю;
	Массив = _ЛокКонтекст.ЛокЯдро_СтрРазделить(СтрокаДляПреобразования, "|", Ложь);
	НазначитьПользователюВосстановленный = "";
	
	Для Каждого СтрМассива из Массив Цикл
		РазделеннаяСтрока =  _ЛокКонтекст.ЛокЯдро_СтрРазделить(СтрМассива, "(", Ложь);
		ИД = РазделеннаяСтрока[РазделеннаяСтрока.Количество()-1];
		ИД = СтрЗаменить(ИД, ")","");
		НазначитьПользователюВосстановленный = НазначитьПользователюВосстановленный + ИД + "|";	
	КонецЦикла;
	ПоследнийСимвол = Прав(НазначитьПользователюВосстановленный,1);
	Если ПоследнийСимвол = "|" Тогда
	НазначитьПользователюВосстановленный = Лев(НазначитьПользователюВосстановленный,СтрДлина(НазначитьПользователюВосстановленный)-1);
	КонецЕсли;
	НазначитьПользователю = НазначитьПользователюВосстановленный;
КонецПроцедуры

&НаСервере
Функция ПолучитьПользователейМС(ХранилищеПользователей)
	
	ПользователиМС = ПолучитьИзВременногоХранилища(ХранилищеПользователей);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МодульОбработки = ОбработкаОбъект;
	#Иначе
		МодульОбработки = РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
	МассивПользователей = МодульОбработки.ГлЯдро_СтрРазделить(НазначитьПользователю,"|", Ложь); 
	КолВоВМассиве = МассивПользователей.Количество();
	СтрокаНазначения = "";
	СЧ = 0;
	Для Каждого СтрМассив из МассивПользователей Цикл
		НайденнаяСтрокаДЗ = ПользователиМС.Строки.Найти(СтрМассив,,Истина);
		Если НайденнаяСтрокаДЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаНазначения = СтрокаНазначения + НайденнаяСтрокаДЗ.ГруппаПользователь + "(" + СтрМассив + ")"; 
		СЧ = СЧ+1;
		Если СЧ <> КолВоВМассиве Тогда
			СтрокаНазначения = СтрокаНазначения + "|";
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокаНазначения;
КонецФункции

&НаКлиенте
Процедура ОтразитьПредставлениеНазначитьПользователю()
	Если _ЛокКонтекст.ЛокЯдро_СтрНайти(НазначитьПользователю, "Конкретному устройству") <> 0
		ИЛИ НазначитьПользователю = "Спрашивать при выгрузке" Тогда
		Возврат;
	КонецЕсли; 
	СтрокаНазначитьПользователю = ПолучитьПользователейМС(_ЛокКонтекст.СтруктураМетаданных.ПользователиMS); 
	НазначитьПользователю = СтрокаНазначитьПользователю;
КонецПроцедуры

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура СкопироватьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		РезультатРедактированияПослеСохранения = Новый Структура("ID_РедактируемогоБП,Копирование",ID_БизнесПроцесса,Истина);
		СохранитьНастройку(Истина, РезультатРедактированияПослеСохранения);
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ЕстьИзмененияНаФорме = Ложь;
		РезультатРедактирования = Новый Структура("ID_РедактируемогоБП,Копирование",ID_БизнесПроцесса,Истина);
		Закрыть(РезультатРедактирования);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПредставленияРеквизитовДокументаЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаПредставленийРеквизитовДокумента   = РезультатРедактирования.ТаблицаНастроек;
		ЗаменитьПредставлениеДокументаПриВыгрузке = РезультатРедактирования.ЗаменитьПредставлениеДокументаПриВыгрузке;
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Выгрузка1С", ТипИсходногоДокумента1С);
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS);
		ЕстьИзмененияНаФорме = Истина;
		УстановитьЦветаЭлементов();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаЗагрузкиТЧЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаЗагрузкиТЧ = РезультатРедактирования;
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Загрузка1С", ТипРезультирующегоДокумента1С);
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS);
		ЕстьИзмененияНаФорме = Истина;
		УстановитьЦветаЭлементов();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаЗагрузкиПолейЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаЗагрузкиПолей 						= РезультатРедактирования.ТаблицаНастроек;
		ВидОбработчика_ПередЗаполнениемДокумента 	= РезультатРедактирования.ВидОбработчика_ПередЗаполнениемДокумента;
		ВидОбработчика_ПослеЗаполненияДокумента 	= РезультатРедактирования.ВидОбработчика_ПослеЗаполненияДокумента;
		ВидОбработчика_ПослеОткрытияФормыДокумента 	= РезультатРедактирования.ВидОбработчика_ПослеОткрытияФормыДокумента;		
		Обработчик_ПередЗаполнениемДокумента 		= РезультатРедактирования.Обработчик_ПередЗаполнениемДокумента;
		Обработчик_ПослеЗаполненияДокумента 		= РезультатРедактирования.Обработчик_ПослеЗаполненияДокумента;
		Обработчик_ПослеОткрытияФормыДокумента 		= РезультатРедактирования.Обработчик_ПослеОткрытияФормыДокумента;
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Загрузка1С", ТипРезультирующегоДокумента1С);
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS);
		ЕстьИзмененияНаФорме 						= Истина;
		УстановитьЦветаЭлементов();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	
	Если ЗначениеЗаполнено(РезультатРедактирования) И РезультатРедактирования.Свойство("ТаблицаНастроек") Тогда
		
		НастройкаВыгрузкиПолей 					= РезультатРедактирования.ТаблицаНастроек;
		
		ВидОбработчика_ПередВыгрузкойДокумента 	= РезультатРедактирования.ВидОбработчика_ПередВыгрузкойДокумента;
		ВидОбработчика_ПослеВыгрузкиДокумента 	= РезультатРедактирования.ВидОбработчика_ПослеВыгрузкиДокумента;
		ВидОбработчика_ПослеОтправкиДокумента 	= РезультатРедактирования.ВидОбработчика_ПослеОтправкиДокумента;
		
		Обработчик_ПередВыгрузкойДокумента 		= РезультатРедактирования.Обработчик_ПередВыгрузкойДокумента;
		Обработчик_ПослеВыгрузкиДокумента 		= РезультатРедактирования.Обработчик_ПослеВыгрузкиДокумента;
		Обработчик_ПослеОтправкиДокумента 		= РезультатРедактирования.Обработчик_ПослеОтправкиДокумента;
		
		ТекстЗапросаВыгрузкиНаТСД 				= РезультатРедактирования.ТекстЗапросаВыгрузкиНаТСД;
		ТекстКодаПолучениеПараметров 			= РезультатРедактирования.ТекстКодаПолучениеПараметров;
		
		ЗаменитьПредставлениеДокументаПриВыгрузке = РезультатРедактирования.ЗаменитьПредставлениеДокументаПриВыгрузке;
		
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Выгрузка1С", ТипИсходногоДокумента1С);
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS);
		ЕстьИзмененияНаФорме = Истина;
		УстановитьЦветаЭлементов();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ВыборПользователяИлиГруппыЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено И ТипЗнч(РезультатРедактирования) = Тип("Массив") Тогда
		
		НазначитьПользователю = "";			
		Для каждого Элемент Из РезультатРедактирования Цикл		
			Если Элемент.Имя = "Спрашивать при выгрузке" Тогда
				НазначитьПользователю = Элемент.Имя + "|";
				Прервать;
			КонецЕсли;
			НазначитьПользователю = НазначитьПользователю +Элемент.Имя +"(" + Элемент.Ид +")" + "|";		
		КонецЦикла; 			
		НазначитьПользователю = Лев(НазначитьПользователю, СтрДлина(НазначитьПользователю) - 1);					
		
	КонецЕсли;	
	
	НесколькоЭлементов = СтрЧислоВхождений(НазначитьПользователю,"|")> 0;
	Элементы.КопияДокументаДляКаждогоПользователя.Доступность = ?(НазначитьПользователю = "Спрашивать при выгрузке" ИЛИ НесколькоЭлементов,Истина,Ложь);
	Если КопияДокументаДляКаждогоПользователя И НЕ Элементы.КопияДокументаДляКаждогоПользователя.Доступность Тогда
		 КопияДокументаДляКаждогоПользователя = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВнесенныеИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьНастройку(Истина);
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ЕстьИзмененияНаФорме = Ложь;
		Закрыть(РезультатРедактирования);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаВыгрузкиТЧЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаВыгрузкиТЧ 	= РезультатРедактирования.ТабличныеЧасти;
		СвязиТабличныхЧастей 	= РезультатРедактирования.СвязиТабличныхЧастей;
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Выгрузка1С", ТипИсходногоДокумента1С);
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS);
		ЕстьИзмененияНаФорме = Истина;
		УстановитьЦветаЭлементов();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКоды_Выгрузка_Документ_Закрытие(ВыбранноеЗначение,ПредыдущееЗначение) Экспорт
	
	ID_ПроизвольногоКода_Выгрузка_Документ = ?(ВыбранноеЗначение <> Неопределено, ВыбранноеЗначение, ПредыдущееЗначение);	
	
	ЕстьИзмененияНаФорме = Истина;
	
	ОбновитьСпискиПроизвольныхКодов();
	ЗаполнитьНаименованияПроизвольныхКодов(); 
	УстановитьДоступностьКонтроляКоличества();
		
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКоды_Загрузка_Документ_Закрытие(ВыбранноеЗначение,ПредыдущееЗначение) Экспорт
	
	ID_ПроизвольногоКода_Загрузка_Документ = ?(ВыбранноеЗначение <> Неопределено, ВыбранноеЗначение, ПредыдущееЗначение);
	
	ЕстьИзмененияНаФорме = Истина;
	
	ОбновитьСпискиПроизвольныхКодов();
	ЗаполнитьНаименованияПроизвольныхКодов();	
			
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПоследовательностиБизнесПроцессовНажатие(Элемент)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СледующиеБизнесПроцессы = ПолучитьФорму("ОФ_ФормаНастройки_ПоследовательностьБизнесПроцессов", ЭтаФорма);
	#Иначе	
		ФормаНастройки_СледующиеБизнесПроцессы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПоследовательностьБизнесПроцессов", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_СледующиеБизнесПроцессы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_СледующиеБизнесПроцессы._ЛокКонтекст = _ЛокКонтекст;
	
	ФормаНастройки_СледующиеБизнесПроцессы.НазваниеБизнесПроцесса = Название;
	ФормаНастройки_СледующиеБизнесПроцессы.ID_БизнесПроцесса = ID_БизнесПроцесса;
	ФормаНастройки_СледующиеБизнесПроцессы.ДокументОснование = ТипИсходногоДокумента1С;
	Если ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.ДокументОснование_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С].Синоним;
	КонецЕсли;
	
	ФормаНастройки_СледующиеБизнесПроцессы.РезультирующийДокумент = ТипРезультирующегоДокумента1С;
	Если ЗначениеЗаполнено(ТипРезультирующегоДокумента1С) Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.РезультирующийДокумент_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипРезультирующегоДокумента1С].Синоним;
	КонецЕсли;
	
	ФормаНастройки_СледующиеБизнесПроцессы.ТипДокументаMS = ТипДокументаMS;
	Если ЗначениеЗаполнено(ТипДокументаMS) Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.ТипДокументаMS_Синоним = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Синоним;
	КонецЕсли;
	ФормаНастройки_СледующиеБизнесПроцессы.ЗагружатьВТотЖе = ЗагружатьВТотЖе;
	ФормаНастройки_СледующиеБизнесПроцессы.ПрерыватьПриКритическойОшибке = ПрерыватьПоследовательностьПриКритическойОшибке;
	ФормаНастройки_СледующиеБизнесПроцессы.НастройкаПоследовательностиБПМассивСтруктур = НастройкаПоследовательностиБПМассивСтруктур;
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СледующиеБизнесПроцессыЗакрытие",ЭтаФорма);
	ФормаНастройки_СледующиеБизнесПроцессы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.ОткрытьМодально();
	#Иначе
		ФормаНастройки_СледующиеБизнесПроцессы.Открыть();
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_СледующиеБизнесПроцессыЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаПоследовательностиБПМассивСтруктур 	= РезультатРедактирования.НастройкаПоследовательностиБПМассивСтруктур;
		ПрерыватьПоследовательностьПриКритическойОшибке = РезультатРедактирования.ПрерыватьПоследовательностьПриКритическойОшибке;
		ЕстьИзмененияНаФорме = Истина;
		УстановитьЦветаЭлементов();
		
		Если ЗаписыватьДокументПослеЗагрузки <> "Всегда" 
			И ЕстьВключеннаяПоследовательностьБП(НастройкаПоследовательностиБПМассивСтруктур) Тогда
			ЗаписыватьДокументПослеЗагрузки = "Всегда";
			Сообщение = НСтр("be = 'Пры наладжанай паслядоўнасці вынікавы дакумент павінен быць заўсёды запісаны. Налада зменена'; en = 'With the configured sequence, the resulting document must always be saved. Configuration changed'; es = 'Con la secuencia configurada, el documento resultante siempre debe ser guardado. Configuración modificada'; ka = 'რეზულტატის დოკუმენტი უნდა იყოს ჩაწერილი განსაკუთრებული სიმრავლეში. პარამეტრები შეცვლილია'; kk = 'Теңізген документтің жолдамасы бар дүрстік документ әрдайым жазылуы керек. Теңшеу өзгертілді'; ro = 'În secvența configurată, documentul rezultat trebuie să fie întotdeauna înregistrat. Configurația a fost modificată'; ru = 'При настроенной последовательности результирующий документ должен быть всегда записан. Настройка изменена'; tr = 'Ayarlanmış sıralamada sonuç belgesi her zaman kaydedilmelidir. Ayar değiştirildi'; uk = 'При налаштованій послідовності результатний документ повинен бути завжди записаний. Налаштування змінено'; uz = ""Sozlangan ketma-ketlikda natijaviy hujjat doim yozilishi kerak. Sozlash o'zgardi""");
			Сообщить(Сообщение); 
		КонецЕсли;
		
		УстановитьДоступностьЭлементов();
		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ЕстьВключеннаяПоследовательностьБП(МассивСтруктур)
	Результат = Ложь;
	Для Каждого СтруктураНастройки Из МассивСтруктур Цикл
		Если СтруктураНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;     
		КонецЕсли;
		Если СтруктураНастройки.Использование Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ФормаНастройки_ОтборДокументовЗакрытие(РезультатНастройки, ДопПараметры) Экспорт

	Если ЗначениеЗаполнено(РезультатНастройки) Тогда
		РежимОбмена = ДопПараметры.РежимОбмена;
		
		НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
		Если НайденныеСтроки.Количество() Тогда
			СтрокаНастройки = НайденныеСтроки[0];
		Иначе
			СтрокаНастройки = НастройкиОтборов.Добавить();
			
			СтрокаНастройки.ID_БизнесПроцесса				= ID_БизнесПроцесса;
			СтрокаНастройки.Название						= Название;
			СтрокаНастройки.ТипИсходногоДокумента1С 		= ТипИсходногоДокумента1С;
			СтрокаНастройки.ТипИсходногоДокумента1С_Синоним	= _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С].Синоним;
			СтрокаНастройки.РежимОбмена						= РежимОбмена;
		КонецЕсли;
		
		СтрокаНастройки.НастройкаКомпоновщикаСтрокой	= РезультатНастройки.НастройкаКомпоновщикаСтрокой;
		СтрокаНастройки.Используется 					= РезультатНастройки.Используется;
		СтрокаНастройки.ВариантОтбора 					= РезультатНастройки.ВариантОтбора;
		СтрокаНастройки.ID_ПроизвольногоОтбора 			= РезультатНастройки.ID_ПроизвольногоОтбора;
		
		// Если бизнес-процесс не новый, отборы нужно сохранять сразу, а не при сохранении бизнес-процесса (сохранения бизнес-процесса может и не быть)
		Если НЕ ЭтоНовыйБизнесПроцесс Тогда
			ШаблонНастройки = _ЛокКонтекст.СтруктураМетаданных.НастройкиMS["НастройкиОтборовУзлов_" + РежимОбмена];
	
			СтруктураНастройки = Новый Структура;
			Для каждого КИЗ ИЗ ШаблонНастройки Цикл
				СтруктураНастройки.Вставить(КИЗ.Ключ);
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(СтруктураНастройки, СтрокаНастройки);
			
			СохранитьНастройкуОтбора(СтруктураНастройки, РежимОбмена);
		КонецЕсли;
		
		ЭтаФорма["ЕстьНастройкаОтбора_" + РежимОбмена] = Истина;
		
		УстановитьЦветаЭлементов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьНастройкуЗавершение();
		
		Если ДополнительныеПараметры.ЗакрытьПослеСохранения Тогда
			Если НЕ ДополнительныеПараметры.РезультатРедактирования = Неопределено Тогда
				РезультатРедактирования = ДополнительныеПараметры.РезультатРедактирования;
			КонецЕсли;
			Закрыть(РезультатРедактирования);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользовательскиеНастройкиПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УдалитьПользовательскиеНастройкиЗавершение();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли