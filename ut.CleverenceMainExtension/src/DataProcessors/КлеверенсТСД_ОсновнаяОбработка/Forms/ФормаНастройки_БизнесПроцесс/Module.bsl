&НаКлиенте
Процедура НазначитьПользователюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	InternetGateOption 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("InternetGateOption");
	флЛегкоеОблако 		= InternetGateOption <> Ложь И ВРег(InternetGateOption) = "AVAILABLE";

	ПредоставлятьВыборСпособаНазначения = Ложь;
	ПараметрыПодключения = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");;
	Если ПараметрыПодключения <> Неопределено Тогда
		Если ТипЗнч(ПараметрыПодключения) = Тип("Структура") И ПараметрыПодключения.Свойство("ИдПриложения") И ПараметрыПодключения.Свойство("ИдОсновногоПриложения") Тогда
			ТипУстановленногоПродукта = _ЛокКонтекст.ЛокЯдро_ПолучитьТипУстановленногоПродукта(ПараметрыПодключения.ИдПриложения, ПараметрыПодключения.ИдОсновногоПриложения);
			ПредоставлятьВыборСпособаНазначения = (ТипУстановленногоПродукта = "МДЛП" Или флЛегкоеОблако = Истина);
		КонецЕсли;
	КонецЕсли;
	
	СпособНазначения = "Пользователям";
	
	Если ПредоставлятьВыборСпособаНазначения Тогда
		СписокВыбора = Новый СписокЗначений();
		СписокВыбора.Добавить("Пользователям", "Пользователям, группе пользователей");
		СписокВыбора.Добавить("Устройству", "Конкретному устройству");
		
		ВыбранноеЗначение = СписокВыбора.ВыбратьЭлемент("Укажите способ назначения", СписокВыбора[0]);
		Если ВыбранноеЗначение <> Неопределено Тогда
			СпособНазначения = ВыбранноеЗначение.Значение;	
		Иначе
			СпособНазначения = "";
		КонецЕсли;
	КонецЕсли;
	
	Если СпособНазначения = "Пользователям" Тогда 
		ПользователиMS = _ЛокКонтекст.СтруктураМетаданных.ПользователиMS;		
	Иначе
		Если СпособНазначения = "Устройству" Тогда
			НазначитьПользователю = "Конкретному устройству";		         
		КонецЕсли;
		Возврат;
	КонецЕсли;    	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборПользователяИлиГруппы",ЭтаФорма);
	#Иначе	
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборПользователяИлиГруппы", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	УбратьПредставлениеНазначитьПользователю();
	ФормаСлужебная_ВыборПользователяИлиГруппы.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВыборПользователяИлиГруппы._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ТекущиеПользователи = НазначитьПользователю;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ПользователиMSАдрес = ПользователиMS;
	ФормаСлужебная_ВыборПользователяИлиГруппы.СпособНазначения = СпособНазначения;
	
	Если флЛегкоеОблако <> Истина И СпособНазначения = "Устройству" Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = НСтр("be = 'Cleverence: Выбар прылады'; en = 'Cleverence: Selecting a device'; es = 'Cleverence: Selección de dispositivo'; ka = 'Cleverence: მოწყობილობის არჩევა'; kk = 'Cleverence: Құрылғыны таңдау'; ro = 'Cleverence: Selectarea dispozitivului'; ru = 'Клеверенс: Выбор устройства'; tr = 'Cleverence: Cihaz seçimi'; uk = 'Cleverence: Вибір пристрою'; uz = 'Cleverence: Qurilmayni tanlash'");
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMS"].Колонки["ПользователиMSГруппаПользователь"].ТекстШапки = НСтр("be = 'Прылада'; en = 'Device'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; ru = 'Устройство'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");	
		#Иначе
			ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMSГруппаПользователь"].Заголовок = НСтр("be = 'Прылада'; en = 'Device'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; ru = 'Устройство'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
		#КонецЕсли
	КонецЕсли;     
	
	ОП = Новый ОписаниеОповещения("Служебная_ВыборПользователяИлиГруппыЗакрытие",ЭтаФорма);
	ФормаСлужебная_ВыборПользователяИлиГруппы.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();	
	
КонецПроцедуры

