&НаКлиенте 
Перем РезультатРедактирования;

&НаКлиенте 
Перем ТекущееСоответствиеТаблицПравилОбмена;

&НаКлиенте
Перем ПредыдущееЗначение;

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем НастройкаВыгрузкиПолей Экспорт,
	НастройкаВыгрузкиТЧ Экспорт,
	НастройкаЗагрузкиПолей Экспорт,
	НастройкаЗагрузкиТЧ Экспорт,
	ПолноеЗначениеНастройки Экспорт,
	СвязиТабличныхЧастей Экспорт,
	НастройкаПредставленийРеквизитовДокумента Экспорт,
	НастройкаПоследовательностиБПМассивСтруктур Экспорт;

#Область ОбработчикиСобытийФормы 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ПриСозданииНаСервере(Отказ,Истина);	
	#КонецЕсли
	
	ЭтоБылТиповойБизнесПроцесс = ЭтоТиповойБизнесПроцесс;	
	
	СписокНередактируемыхУзловихНастроек.Добавить("Название");
	СписокНередактируемыхУзловихНастроек.Добавить("ТипИсходногоДокумента1С");
	СписокНередактируемыхУзловихНастроек.Добавить("ТипДокументаMS");
	СписокНередактируемыхУзловихНастроек.Добавить("ЗагружатьВТотЖе");
	СписокНередактируемыхУзловихНастроек.Добавить("ТипРезультирующегоДокумента1С");
	СписокНередактируемыхУзловихНастроек.Добавить("ВыполнитьТолькоПроизвольныйКод");
	СписокНередактируемыхУзловихНастроек.Добавить("ВыполнитьТолькоПроизвольныйКодВыгрузка");
	СписокНередактируемыхУзловихНастроек.Добавить("ОбработчикВыгрузкиДокумента");
	
	Если ЭтоНовыйБизнесПроцесс Тогда
		ID_БизнесПроцесса = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("BP");
		ЕстьИзмененияНаФорме = Истина;
	КонецЕсли;
	
	Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.Документы1С Цикл
		Элементы.ТипИсходногоДокумента1С.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
		Элементы.ТипРезультирующегоДокумента1С.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
	КонецЦикла;
	Элементы.ТипИсходногоДокумента1С.СписокВыбора.СортироватьПоПредставлению();
	Элементы.ТипРезультирующегоДокумента1С.СписокВыбора.СортироватьПоПредставлению();
	
	Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.ДокументыMS Цикл
		Элементы.ТипДокументаMS.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
	КонецЦикла;
	Элементы.ТипДокументаMS.СписокВыбора.СортироватьПоПредставлению();	;	
	
	Элементы.Используется.Заголовок = ?(Используется, 
			НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'"), 
			НСтр("be = 'Адключана'; en = 'Disabled'; es = 'Desactivado'; ka = 'გამორიცხა'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Отключено'; tr = 'Devre dışı'; uk = 'Відключено'; uz = ""O'chirildi  """)
	);
	ЭтоТиповойБизнесПроцессПриИзменении("");
	
	Если ЭтоТиповойБизнесПроцесс Тогда
		Элементы.ДекорацияПредупреждение.Заголовок = НСтр("be = 'УВАГА! Гэта тыпавы бізнес-працэс, і яго рэдагаванне абмежавана. Вы можаце стварыць поўную копію гэтага бізнес-працэсу.'; en = 'ATTENTION! This is a standard business process, and its editing is limited. You can create a full copy of this business process.'; es = '¡ATENCIÓN! Este es un proceso de negocio estándar y su edición está restringida. Puede crear una copia completa de este proceso de negocio.'; ka = 'ყურადღება! ეს არის სტანდარტული ბიზნეს პროცესი და მისი რედაქტირება შეზღუდულია. შეგიძლიათ შექმნათ სრული კოპია ამ ბიზნეს პროცესის.'; kk = 'ЕСКЕРТУ! Бұл типтік бизнес процестің өңдеуі шектелген. Сіз бұл бизнес процесті толық көшірме жасауыңыз болады.'; ro = 'ATENTIE! Acesta este un proces de afaceri tipic, iar editarea sa este limitata. Puteti crea o copie completa a acestui proces de afaceri.'; ru = 'ВНИМАНИЕ! Это типовой бизнес процесс, и его редактирование ограничено. Вы можете создать полную копию этого бизнес процесса.'; tr = 'DİKKAT! Bu standart iş sürecidir ve düzenlemesi sınırlıdır. Bu iş sürecinin tam bir kopyasını oluşturabilirsiniz.'; uk = 'УВАГА! Це типовий бізнес-процес, і його редагування обмежено. Ви можете створити повну копію цього бізнес процесу.'; uz = ""DIQQAT! Bu standart biznes jarayoni, va uning tahrirlashiga cheklanadi. Siz bu biznes jarayonining to'liq nusxasini yarata olasiz.""");
	ИначеЕсли ЗначениеЗаполнено(ID_Узла) Тогда
		ТекстЗаголовка = НСтр("be = ""УВАГА! Рэдагаванне налад для торговага аб'екта %1, і яго рэдагаванне абмежавана.""; en = 'ATTENTION! Editing settings for the trading object %1 is limited.'; es = '¡ATENCIÓN! La edición de la configuración para el objeto comercial %1 está restringida.'; ka = 'ყურადღება! ტრანზაქციის ობიექტის %1 რედაქტირება და მისი რედაქტირება შეზღუდულია.'; kk = 'ЕСКЕРТУ! %1 сауда объекті үшін параметрлерді өңдеу, оларды өңдеу шектелген.'; ro = 'ATENTIE! Editarea setarilor pentru obiectul comercial %1 este limitata.'; ru = 'ВНИМАНИЕ! Редактирование настроек для торгового объекта %1, и его редактирование ограничено.'; tr = 'DİKKAT! Ticari nesne %1 için ayarları düzenleme ve düzenleme sınırlıdır.'; uk = ""УВАГА! Редагування налаштувань для торгового об'єкту %1, і його редагування обмежено.""; uz = 'DIQQAT! Savdo obyektining sozlamalarini tahrirlash %1, va uning tahrirlashiga cheklanadi.'");
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, НаименованиеУзла);
		Элементы.ДекорацияПредупреждение.Заголовок = ТекстЗаголовка;
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ДекорацияПредупреждение.ЦветТекста = Новый Цвет(0,150,70);
		#Иначе
			Элементы.ДекорацияПредупреждение.Видимость = Ложь;
		#КонецЕсли
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		НастройкаОтбора_Интерактивный = НСтр("be = 'Ручны абмен'; en = 'Manual exchange'; es = 'Intercambio manual'; ka = 'ხელით შეცვლა'; kk = 'Қолмен ауыстыру  '; ro = 'Schimb manual'; ru = 'Ручной обмен'; tr = 'El İle Değişim'; uk = 'Ручний обмін'; uz = ""Qo'llab-quvvatlash  """);
		НастройкаОтбора_Онлайн		  = НСтр("be = 'Інтэрнэт-абмен'; en = 'Online exchange'; es = 'Intercambio en línea'; ka = 'ონლაინ-გაცვლა'; kk = 'Онлайн-алмасу'; ro = 'Schimb online'; ru = 'Онлайн-обмен'; tr = 'Çevrimiçi veri alışverişi'; uk = 'Онлайн-обмін'; uz = 'Onlayn almashish  '");
	#КонецЕсли
	
	Пред_Название				 = Название;
	Пред_ТипИсходногоДокумента1С = ТипИсходногоДокумента1С;
	
	РезультатРедактирования = "";
	
	ТекущееСоответствиеТаблицПравилОбмена = Новый Структура;
	ТекущееСоответствиеТаблицПравилОбмена.Вставить("Выгрузка1С", ТипИсходногоДокумента1С); 
	ТекущееСоответствиеТаблицПравилОбмена.Вставить("Загрузка1С", ТипРезультирующегоДокумента1С); 
	ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS); 
	
	ТипРезультирующегоДокумента1С_Шаблон = "Не используется";
	
	ОбновитьСпискиПроизвольныхКодов();
	ЗаполнитьНаименованияПроизвольныхКодов();
	
	ЗаполнитьНастройкиОтборов();
	
	ОбновитьВсеДанныеЭлементовФормы();
	
	ОтразитьПредставлениеНазначитьПользователю();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоТиповойБизнесПроцесс = Параметры.Свойство("ЭтоТиповойБизнесПроцесс") И Параметры.ЭтоТиповойБизнесПроцесс;
	ЭтоУзловыеНастройки 	= Параметры.Свойство("ID_Узла") И ЗначениеЗаполнено(Параметры.ID_Узла);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаДвижениеДокументовВерх.Доступность = НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаДвижениеДокументовНиз.Доступность = НЕ ЭтоУзловыеНастройки;
		
		Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Доступность =	НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Доступность =	НЕ ЭтоУзловыеНастройки;
		Элементы.НастроитьРеквизитыПредставленияШапки.Доступность = НЕ ЭтоУзловыеНастройки;
		Элементы.ОсновныеДействия.Кнопки.ФормаСкопировать.Доступность = НЕ ЭтоУзловыеНастройки;
		Если ЭтоУзловыеНастройки ИЛИ ЭтоТиповойБизнесПроцесс Тогда
			Элементы.ДекорацияПредупреждение.ЦветТекста = Новый Цвет(255,0,0);
		Иначе
			Элементы.ДекорацияПредупреждение.ЦветТекста = Новый Цвет(0,150,70);
			Элементы.ДекорацияПредупреждение.Заголовок = НСтр("be = ""Выкарыстоўвайце бізнес-працэсы для налады абмену дакументамі, у якіх апісаны правілы выгрузкі і загрузкі дакументаў. Спіс бізнес-працэсаў агульны для ўсіх торгавых аб'ектаў.""; en = 'Use business processes to configure document exchange describing rules for unloading and loading documents. The list of business processes is common for all trading objects.'; es = 'Utilice los procesos comerciales para configurar el intercambio de documentos que describen las reglas de carga y descarga de documentos. La lista de procesos comerciales es común para todos los objetos comerciales.'; ka = 'გამოიყენეთ ბიზნეს პროცესები დოკუმენტების შემქმნელებისა და ჩამონათვალის წესების აღმოჩენაში. ბიზნეს პროცესების სია საერთოა ყველა ველისთვის.'; kk = 'Документтер айырмашылығын теңшеу үшін бизнес процестерді қолданыңыз, жүйедеңізгі жүктеу және жүктеу ережелерін сипаттаған документтермен алмасуға арналған. Барлық торговый объекттер үшін бизнес процестер тізімі қауіпсіз.'; ro = 'Utilizați procesele de afaceri pentru configurarea schimbului de documente în care sunt descrise regulile de descărcare și încărcare a documentelor. Lista proceselor de afaceri este comună pentru toate obiectele comerciale.'; ru = 'Используйте бизнес процессы для настройки обмена документами в которых описаны правила выгрузки и загрузки документов. Список бизнес процессов общий для всех торговых объектов.'; tr = 'Belgelerin alım ve satım kurallarını açıklayan belgelerin değişimini yapılandırmak için iş süreçlerini kullanın. İş süreçleri listesi tüm ticari nesneler için ortaktır.'; uk = ""Використовуйте бізнес-процеси для налаштування обміну документами, в яких описані правила вивантаження та завантаження документів. Список бізнес-процесів загальний для всіх торгових об'єктів.""; uz = ""Hujjat almashuvi uchun biznes protsesslardan foydalaning, ayni paytda hujjatlarni yuklash va yuklash qoidalari haqida ma'lumotlar beruvchi hujjatlarni o'zgartirish uchun. Biznes protsesslar ro'yxati barcha savdo ob'ektlari uchun umumiy.""");
		КонецЕсли;
	#Иначе
		КлючСохраненияПоложенияОкна = Новый УникальныйИдентификатор; // восстанавливает положение формы:

		Элементы.ГруппаДвижениеДокументов.Видимость 			= НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Видимость = НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Видимость = НЕ ЭтоУзловыеНастройки;
		Элементы.Группа3.Видимость 								= Ложь; // Устаревшая настройка, скроем навсегда
		Элементы.ФормаСкопировать.Видимость 					= НЕ ЭтоУзловыеНастройки;
		Элементы.ДекорацияПредупреждение.Видимость 				= ЭтоУзловыеНастройки ИЛИ ЭтоТиповойБизнесПроцесс;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ЕстьИзмененияНаФорме Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("be = 'Захаваць унесеныя змены?'; en = 'Save changes made?'; es = '¿Guardar los cambios realizados?'; ka = 'შენახვა შეყვანილი ცვლილებები?'; kk = 'Кірістірілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările aduse?'; ru = 'Сохранить внесенные изменения?'; tr = 'Yapılan değişiklikleri kaydetmek istiyor musunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Киритилган ўзгаришларни сақлаш керакми?  '");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("СохранитьВнесенныеИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		Закрыть(РезультатРедактирования);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СохраненаНастройкаВыгрузкиПолей" Тогда
	
		ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр, Источник);
	
	КонецЕсли; 

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НастроитьРеквизитыТабличнойЧастиВыгрузкаНажатие(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПравилаВыгрузкиТЧ = ПолучитьФорму("ОФ_ФормаНастройки_ПравилаВыгрузкиТЧ",ЭтаФорма);
	#Иначе
		ФормаНастройки_ПравилаВыгрузкиТЧ = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПравилаВыгрузкиТЧ", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ПравилаВыгрузкиТЧ.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_ПравилаВыгрузкиТЧ._ЛокКонтекст = _ЛокКонтекст;
	ФормаНастройки_ПравилаВыгрузкиТЧ.СтруктураДокумента1С = ?(ТипИсходногоДокумента1С = "",Новый Структура(),_ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С]);
	ФормаНастройки_ПравилаВыгрузкиТЧ.СтруктураДокументаMS = ?(ТипДокументаMS = "",Новый Структура(),_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS]);
	ФормаНастройки_ПравилаВыгрузкиТЧ.ТипДокумента1С = ТипИсходногоДокумента1С;
