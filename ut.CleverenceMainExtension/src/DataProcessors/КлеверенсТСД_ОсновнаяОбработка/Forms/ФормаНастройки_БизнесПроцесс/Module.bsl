#КонецОбласти

#Область ВспомогательныеМеханизмы

&НаКлиенте 
Процедура ОбновитьВсеДанныеЭлементовФормы()
	
	УстановитьЦветаЭлементов();
	УстановитьЗначенияРеквизитов();
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте 
Процедура УстановитьЦветаЭлементов()
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.Используется.ЦветТекста = ?(Используется, WebЦвета.Зеленый, WebЦвета.Красный);
	#Иначе	
		Элементы.Используется.ЦветТекстаЗаголовка = ?(Используется, WebЦвета.Зеленый, WebЦвета.Красный);
	#КонецЕсли
	
	ЗаполненИсходныйДокумент1С = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	Элементы.НастройкаОтбора_Интерактивный.ЦветТекста = ?(ЗаполненИсходныйДокумент1С,
		?(ЕстьНастройкаОтбора_Интерактивный, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
	Элементы.НастройкаОтбора_Онлайн.ЦветТекста = ?(ЗаполненИсходныйДокумент1С,
		?(ЕстьНастройкаОтбора_Онлайн, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		Элементы.НастройкаОтбораУзел_Интерактивный.ЦветТекста = Элементы.НастройкаОтбора_Интерактивный.ЦветТекста;
		Элементы.НастройкаОтбораУзел_Онлайн.ЦветТекста = Элементы.НастройкаОтбора_Онлайн.ЦветТекста;
	#КонецЕсли
		
	Элементы.НастроитьРеквизитыШапкиВыгрузка.ЦветТекста = ?(ЗаполненИсходныйДокумент1С
		И НЕ ЭтоТиповойБизнесПроцесс, ?(ЗначениеЗаполнено(НастройкаВыгрузкиПолей)
		И НастройкаВыгрузкиПолей.Количество() > 1, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыШапкиЗагрузка.ЦветТекста = ?(ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		И НЕ ЭтоТиповойБизнесПроцесс, ?(ЗначениеЗаполнено(НастройкаЗагрузкиПолей)
		И НастройкаЗагрузкиПолей.Количество() > 1, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыТабличнойЧастиВыгрузка.ЦветТекста = ?(ЗаполненИсходныйДокумент1С
		И НЕ ЭтоТиповойБизнесПроцесс, ?(ЗначениеЗаполнено(НастройкаВыгрузкиТЧ)
		И НастройкаВыгрузкиТЧ.Количество() > 0, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыТабличнойЧастиЗагрузка.ЦветТекста = ?(ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		И НЕ ЭтоТиповойБизнесПроцесс, ?(ЗначениеЗаполнено(НастройкаЗагрузкиТЧ)
		И НастройкаЗагрузкиТЧ.Количество() > 0, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыПредставленияШапки.ЦветТекста = ?(ЗаполненИсходныйДокумент1С, 
		?(ЗначениеЗаполнено(НастройкаПредставленийРеквизитовДокумента)
		И НастройкаПредставленийРеквизитовДокумента.Количество() > 0, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастройкаПоследовательностиБизнесПроцессовГиперссылка.ЦветТекста = ?(ЗначениеЗаполнено(НастройкаПоследовательностиБПМассивСтруктур)
		И ЕстьВключеннаяПоследовательностьБП(НастройкаПоследовательностиБПМассивСтруктур), WebЦвета.Зеленый, WebЦвета.Красный);
		
	Элементы.ТипРезультирующегоДокумента1С_Шаблон.ЦветТекста = WebЦвета.СветлоСерый;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияРеквизитов()
	
	Если НЕ ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		ЗагружатьВТотЖе = Ложь;		
		КонтрольКоличества = Ложь;
	КонецЕсли;
	
	Если ЗагружатьВТотЖе Тогда
		ТипРезультирующегоДокумента1С = ТипИсходногоДокумента1С;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ОсновныеДействия.Кнопки.ФормаУдалитьПользовательскиеНастройки.Доступность = ПользовательскаяНастройка = Истина;
	#Иначе
		Элементы.ФормаУдалитьПользовательскиеНастройки.Видимость = ПользовательскаяНастройка = Истина;
	#КонецЕсли
	
	ЭтоПользовательскаяНастройка = ЭтоТиповойБизнесПроцесс
		ИЛИ ЗначениеЗаполнено(ID_Узла);

	Элементы.ЗагружатьВТотЖе.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		и не ЭтоТиповойБизнесПроцесс;
	Элементы.ТипРезультирующегоДокумента1С.Доступность = НЕ ЗагружатьВТотЖе;

	Элементы.НастройкаОтбора_Интерактивный.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	Элементы.НастройкаОтбора_Онлайн.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	Элементы.НастроитьРеквизитыШапкиВыгрузка.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НадписьРеквизитыШапкиИз1С.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НастроитьРеквизитыТабличнойЧастиВыгрузка.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НадписьРеквизитыТЧИз1С.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НастроитьРеквизитыПредставленияШапки.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	Элементы.НадписьРеквизитыПредставленияШапки.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
		
	Элементы.НастроитьРеквизитыШапкиЗагрузка.Доступность = ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НадписьРеквизитыШапкиИзMS.Доступность = ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НастроитьРеквизитыТабличнойЧастиЗагрузка.Доступность = ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	Элементы.НадписьРеквизитыТЧИзMS.Доступность = ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		и ЗначениеЗаполнено(ТипДокументаMS) и НЕ ЭтоПользовательскаяНастройка;
	УстановитьДоступностьКонтроляКоличества();
	
	Элементы.НазначитьПользователю.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	Элементы.СоздаватьНовыйДокументПриЗагрузке.Доступность = НЕ ЗагружатьВТотЖе;
	Если ЗагружатьВТотЖе Тогда
		СоздаватьНовыйДокументПриЗагрузке = Ложь;	
	КонецЕсли;
	
	НесколькоЭлементов = СтрЧислоВхождений(НазначитьПользователю,"|")> 0;
	Элементы.КопияДокументаДляКаждогоПользователя.Доступность = ?(НазначитьПользователю = "Спрашивать при выгрузке" ИЛИ НесколькоЭлементов, Истина, Ложь);
	Если ЭтоПользовательскаяНастройка Тогда
		Для Каждого Настройка Из СписокНередактируемыхУзловихНастроек Цикл
			Попытка
				Элементы[Настройка.Значение].Доступность = Ложь;	
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.ГруппаДвижениеДокументовВерх.Доступность = Ложь;
			Элементы.ГруппаДвижениеДокументовНиз.Доступность = Ложь;
			
			Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Доступность = Ложь;
			Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Доступность = Ложь;
			Элементы.НастроитьРеквизитыПредставленияШапки.Доступность = Ложь;
			Элементы.ОсновныеДействия.Кнопки.ФормаСкопировать.Доступность = Ложь;
		КонецЕсли;
		
		Элементы.ПанельНастройкиВыгрузкиДокументаИз1С.ТекущаяСтраница = ?(ВыполнитьТолькоПроизвольныйКодВыгрузка,
																	Элементы.ПанельНастройкиВыгрузкиДокументаИз1С.Страницы.ОбработчикВыгрузкиДокумента,
																	Элементы.ПанельНастройкиВыгрузкиДокументаИз1С.Страницы.СтраницаНастройкиПолей);
																	
		Элементы.ПанельНастройкиЗагрузкиДокументаИзMS.ТекущаяСтраница = ?(ВыполнитьТолькоПроизвольныйКод,
																	Элементы.ПанельНастройкиЗагрузкиДокументаИзMS.Страницы.СтраницаОбработчикЗагрузкиДокумента,
																	Элементы.ПанельНастройкиЗагрузкиДокументаИзMS.Страницы.СтраницаНастройкиПолей);
	#Иначе
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.ГруппаДвижениеДокументов.Видимость = Ложь;
			Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Видимость = Ложь;
			Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Видимость = Ложь;
			Элементы.Группа3.Видимость = Ложь;
			Элементы.ФормаСкопировать.Видимость = Ложь;
			
			Элементы.ГруппаНастройкиОтборовУзел.Видимость = Истина;
		Иначе
			Элементы.ГруппаНастройкиОтборовУзел.Видимость = Ложь;	
		КонецЕсли;	
		
		Элементы.ГруппаНастройкиПолейВыгрузки.Видимость = НЕ ВыполнитьТолькоПроизвольныйКодВыгрузка;
		Элементы.ГруппаОбработчикаВыгрузки.Видимость = ВыполнитьТолькоПроизвольныйКодВыгрузка;
		Элементы.ГруппаНастройкиПолейЗагрузки.Видимость = НЕ ВыполнитьТолькоПроизвольныйКод;
		Элементы.ГруппаОбработчикаЗагрузки.Видимость = ВыполнитьТолькоПроизвольныйКод;
	#КонецЕсли
	
	Элементы.ПроизвольныйКодВыгрузкиДокумента.Доступность 	= ТипОбработчикаВыгрузки = 0;
	Элементы.ОбработчикВыгрузкиДокумента.Доступность 		= ТипОбработчикаВыгрузки = 1;	
	
	Элементы.ПроизвольныйКодЗагрузкиДокумента.Доступность 	= ТипОбработчикаЗагрузки = 0;
	Элементы.ОбработчикЗагрузкиДокумента.Доступность 		= ТипОбработчикаЗагрузки = 1;	
	
	Элементы.ЗаписыватьДокументПослеЗагрузки.Доступность 	= ?(ЗначениеЗаполнено(НастройкаПоследовательностиБПМассивСтруктур)
		И ЕстьВключеннаяПоследовательностьБП(НастройкаПоследовательностиБПМассивСтруктур), Ложь, Истина);
		
	Элементы.ТипРезультирующегоДокумента1С.Видимость 		= НЕ ВыполнитьТолькоПроизвольныйКод;
	Элементы.ТипРезультирующегоДокумента1С_Шаблон.Видимость = ВыполнитьТолькоПроизвольныйКод;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКонтроляКоличества()
	
	ЗаполненаПроизвольнаяВыгрузка = ЗначениеЗаполнено(ПроизвольныйКодВыгрузкиДокумента) 
		Или ЗначениеЗаполнено(ОбработчикВыгрузкиДокумента);	                               
	ИспользуетсяПроизвольнаяВыгрузка = ВыполнитьТолькоПроизвольныйКодВыгрузка И ЗаполненаПроизвольнаяВыгрузка;
	Элементы.КонтрольКоличества.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С) Или ИспользуетсяПроизвольнаяВыгрузка;	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "СохраненаНастройкаВыгрузкиПолей" Тогда
	
		ТЗ = ПолучитьИзВременногоХранилища(Параметр.АдресНастройки);
		
		НастройкаВыгрузкиПолейАдрес = ПоместитьВоВременноеХранилище(ТЗ);
	
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура СохранитьНастройку(ЗакрытьПослеСохранения = Ложь, РезультатРедактированияПослеСохранения = Неопределено)

    Если Используется Тогда
		СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
		
		ЕстьДокументMS = ЗначениеЗаполнено(ТипДокументаMS)
			И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
			И СтруктураМетаданных.Свойство("ДокументыMS")
			И СтруктураМетаданных.ДокументыMS.Свойство(ТипДокументаMS);
			
		Если ЕстьДокументMS Тогда
			СохранитьНастройкуЗавершение();
			Если ЗакрытьПослеСохранения Тогда
				Если НЕ РезультатРедактированияПослеСохранения = Неопределено Тогда
					РезультатРедактирования = РезультатРедактированияПослеСохранения;
				КонецЕсли;
				Закрыть(РезультатРедактирования);
			КонецЕсли;
		Иначе	
			ТекстВопроса = НСтр("ru = 'Документ Клеверенс не указан или отсутствует в метаданных. Продолжить?'; en = 'Cleverence Document is not specified or missing in the metadata. Continue?'; kk = 'Cleverence құжаты бизнес процесілердің метадеректерінде көрсетілмеген немесе жоқ. Жалғастыру керек пе?'; uz = 'Cleverence ҳужжати метаданныаларда кўрсатилмаган ёки йўқ. Давом этамоқми?'; be = 'Дакумент Cleverence не ўказаны або адсутнічае ў метададзе. Працягнуць?'; uk = 'Документ Cleverence не вказаний або відсутній в метаданих. Продовжити?'; ka = 'Cleverence დოკუმენტი არ არის მოცემული ან არ არის მეტადანებში. გსურთ გაგრძელება?'; tr = 'Cleverence belgesi, meta verilerde belirtilmemiş veya bulunmamaktadır. Devam etmek istiyor musunuz?'; es = 'El documento Cleverence no está especificado o no está presente en los metadatos. ¿Continuar?'; ro = 'Documentul Cleverence nu este specificat sau lipsește din metadate. Continuați?'");
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ЗакрытьПослеСохранения",  ЗакрытьПослеСохранения);
			ДопПараметры.Вставить("РезультатРедактирования", РезультатРедактированияПослеСохранения);
			ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьНастройкуПослеОтветаНаВопрос", ЭтаФорма, ДопПараметры);
						
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		КонецЕсли;
		
	Иначе
		СохранитьНастройкуЗавершение();
		Если ЗакрытьПослеСохранения Тогда
			Если НЕ РезультатРедактированияПослеСохранения = Неопределено Тогда
				РезультатРедактирования = РезультатРедактированияПослеСохранения;
			КонецЕсли;
			Закрыть(РезультатРедактирования);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

