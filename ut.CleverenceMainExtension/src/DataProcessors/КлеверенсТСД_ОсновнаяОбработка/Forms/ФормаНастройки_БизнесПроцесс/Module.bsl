		ПользовательскаяНастройка = Истина;
		
		Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда // Существуют пользовательские настройки, которые настраиваются только в главном узле и действуют для всех остальных
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");
		КонецЕсли;
	Иначе
		Если ВыполнитьТолькоПроизвольныйКод Тогда
			ТипРезультирующегоДокумента1С = "";
			ТипРезультирующегоДокумента1С_Синоним = "";
		КонецЕсли;
		
		СтруктураНастройки = Новый Структура;
