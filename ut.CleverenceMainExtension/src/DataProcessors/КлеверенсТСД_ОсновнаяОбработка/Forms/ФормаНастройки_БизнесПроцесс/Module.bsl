&НаКлиенте
Процедура НазваниеПриИзменении(Элемент)
	
	// Если изменилось название бизнес-процесса, нужно изменить название сохраненных отборов
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
		Если НайденныеСтроки.Количество() Тогда
			НайденныеСтроки[0].Название = Название;
		КонецЕсли;
