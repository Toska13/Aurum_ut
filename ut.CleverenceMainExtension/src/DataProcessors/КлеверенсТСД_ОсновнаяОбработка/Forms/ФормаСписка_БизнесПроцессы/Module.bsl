&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем НастройкиБизнесПроцессов Экспорт;

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ?(ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла), " """+ ЭтаФорма.НаименованиеУзла +"""","");
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.ФормаСохранитьВФайл.Видимость = Ложь;	
			Элементы.ФормаЗагрузитьИзФайла.Видимость = Ложь;
			
			Элементы.ОтображаемыеНастройкиБизнесПроцессовДобавить.Видимость = Ложь;
			Элементы.ОтображаемыеНастройкиБизнесПроцессовСкопировать.Видимость = Ложь;
		КонецЕсли;
	#Иначе
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.ОсновнаяКоманднаяПанель.Кнопки.ФормаСохранитьВФайл.Доступность = Ложь;	
			Элементы.ОсновнаяКоманднаяПанель.Кнопки.ФормаЗагрузитьИзФайла.Доступность = Ложь;
			
			Элементы.КоманднаяПанельОтображаемыеНастройкиБизнесПроцессов.Кнопки.ОтображаемыеНастройкиБизнесПроцессовДобавить.Доступность = Ложь;
			Элементы.КоманднаяПанельОтображаемыеНастройкиБизнесПроцессов.Кнопки.ОтображаемыеНастройкиБизнесПроцессовСкопировать.Доступность = Ложь;
		КонецЕсли;
	#КонецЕсли
	
	ОбновитьТаблицуНастроекБизнесПроцессов();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		УстановитьУсловноеОформление();
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)	
	Отказ = Истина;     
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		Сообщение = НСтр("be = ""Даданне бізнес-працэсаў даступна толькі для галоўнага торговага аб'екта""; en = 'Adding business processes is only available for the main trading entity'; es = 'La adición de procesos comerciales solo está disponible para el principal objeto comercial'; ka = 'ბიზნეს პროცესების დამატება შესაძლებელია მხოლოდ მთავარ ვაჭრობის ობიექტისთვის'; kk = 'Бизнес процестерді қосу тек бас мақсатты торговый объекті үшін мүмкін'; ro = 'Adăugarea proceselor de afaceri este disponibilă doar pentru obiectul principal de vânzare'; ru = 'Добавление бизнес процессов доступно только для главного торгового объекта'; tr = 'İş süreçleri sadece ana ticari nesne için eklenir'; uk = ""Додавання бізнес-процесів доступно тільки для головного торгового об'єкта""; uz = 'Бизнес процессларни қўшиш фақат асосий савдо ёритувчиси учун мавжуд'");
		Сообщить(Сообщение); 	
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуРедактированияНастройки(Истина, Копирование);
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовПередНачаломИзменения(Элемент, Отказ)	
	
	ИмяНастройки = ИмяТекущейКолонкиТаблицы();	
	
	Если ИмяНастройки <> "Используется"
		И ИмяНастройки <> "ЗагружатьВТотЖе" Тогда
		
		Отказ = Истина;
		ОткрытьФормуРедактированияНастройки(Ложь);
	
	Иначе
		
		ТекущаяСтрока = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;	
		ЗначениеНастройки = НЕ ТекущаяСтрока[ИмяНастройки]; // Берем противоположное значение, т.к. в этом обработчике значение еще не изменилось
		
		Если ИмяНастройки = "Используется"
			И ЗначениеНастройки = Истина Тогда
			
			СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
			ЕстьДокументMS = ЗначениеЗаполнено(ТекущаяСтрока.ТипДокументаMS)
				И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
				И СтруктураМетаданных.Свойство("ДокументыMS")
				И СтруктураМетаданных.ДокументыMS.Свойство(ТекущаяСтрока.ТипДокументаMS);
				
			Если ЕстьДокументMS Тогда
				УстановитьЗначениеНастройкиВТекущейСтроке(ИмяНастройки, ЗначениеНастройки);
			Иначе	
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("ИмяНастройки",	   ИмяНастройки);
				ДопПараметры.Вставить("ЗначениеНастройки", ЗначениеНастройки);
				ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьЗначениеНастройкиВТекущейСтрокеПослеОтветаНаВопрос", ЭтаФорма, ДопПараметры);
				
				ПоказатьВопросПослеПроверкиБизнесПроцессов(ОписаниеОповещения, ТекущаяСтрока.ТипДокументаMS);
			КонецЕсли;
			
		Иначе
			УстановитьЗначениеНастройкиВТекущейСтроке(ИмяНастройки, ЗначениеНастройки);
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда		
		Возврат;
	КонецЕсли;                     
	Отказ = Истина;
	
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		Если НЕ ТекущиеДанные.ПользовательскаяНастройка Тогда
			Сообщение = НСтр("be = ""Выдаленне бізнес працэсаў даступна толькі для галоўнага торговага аб'екта""; en = 'Deleting business processes is only available for the main trading object'; es = 'La eliminación de procesos comerciales solo está disponible para el principal objeto comercial'; ka = 'ბიზნეს პროცესების წაშლა ხდება მხოლოდ თავისი სასახლისთვის'; kk = 'Бизнес процестерді тек үлкен сауда құрылымы үшін жою мүмкін'; ro = 'Ștergerea proceselor de afaceri este disponibilă doar pentru obiectul principal de vânzare'; ru = 'Удаление бизнес процессов доступно только для главного торгового объекта'; tr = 'İşletme süreçlerini yalnızca ana ticari birim için silme'; uk = ""Видалення бізнес-процесів доступне лише для головного торгового об'єкта""; uz = ""Biznes jarayonlarni faqat asosiy savdo ob'ektiga o'chirish mumkin""");
			Сообщить(Сообщение); 
		Иначе
			ТекстВопроса = НСтр("be = 'Вы сапраўды жадаеце выдаліць карыстацкую наладу і вярнуць пачатковае значэнне бізнес-працэсу ""%1""?'; en = 'Do you really want to delete the custom setting and revert the original value of the business process ""%1""?'; es = '¿Realmente desea eliminar la configuración personalizada y restaurar el valor original del proceso empresarial ""%1""?'; ka = 'ნამდვილად გსურთ მომხმარებელი პარამეტრების წაშლა და ბიზნეს პროცესის საწყისი მნიშვნელობის დაბრუნება ""%1""?'; kk = 'Сіз пайдаланушы параметрлерін жоюға және бизнес процесс параметрлерін бастапқа қайтаруға сенімдісіз бе ""%1""?'; ro = 'Sunteți sigur că doriți să ștergeți setarea personalizată și să reveniți la valoarea inițială a procesului de afaceri ""%1""?'; ru = 'Вы действительно хотите удалить пользовательскую настройку и вернуть исходное значение бизнес-процесса ""%1""?'; tr = 'Kullanıcı ayarını geri yüklemek ve ""%1"" iş sürecinin orijinal değerini geri getirmek istediğinizden emin misiniz?'; uk = 'Ви дійсно хочете видалити користувацьке налаштування і повернути початкове значення бізнес-процесу ""%1""?'; uz = 'Siz rostdan foydalanuvchi sozlamasini o''chirib, ""%1"" biznes jarayonining asal qiymatiga qaytmoqchimisiz?'");
			ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТекущиеДанные.Название);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалитьПользовательскуюНастройкуЗавершение", ЭтаФорма, ТекущиеДанные);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоТиповойБизнесПроцесс = Истина Тогда
		Если НЕ ТекущиеДанные.ПользовательскаяНастройка Тогда
			Сообщение = НСтр("be = 'Выдаленне тыповых бізнес працэсаў забаронена'; en = 'Deleting standard business processes is prohibited'; es = 'No está permitida la eliminación de procesos comerciales estándar'; ka = 'ტიპური ბიზნეს პროცესების წაშლა აკრძალულია'; kk = 'Стандартты бизнес процестерді жоюға болмайды'; ro = 'Ștergerea proceselor de afaceri standard este interzisă'; ru = 'Удаление типовых бизнес процессов запрещено'; tr = 'Standart işletme süreçlerini silmek yasaktır'; uk = 'Видалення типових бізнес-процесів заборонено'; uz = ""Standart biznes jarayonlarini o'chirish taqiqlanadi""");
			Сообщить(Сообщение); 
		Иначе
			ТекстВопроса = НСтр("be = 'Вы сапраўды жадаеце выдаліць карыстацкую наладу і вярнуць пачатковае значэнне бізнес-працэсу ""%1""?'; en = 'Do you really want to delete the custom setting and revert the original value of the business process ""%1""?'; es = '¿Realmente desea eliminar la configuración personalizada y restaurar el valor original del proceso empresarial ""%1""?'; ka = 'ნამდვილად გსურთ მომხმარებელი პარამეტრების წაშლა და ბიზნეს პროცესის საწყისი მნიშვნელობის დაბრუნება ""%1""?'; kk = 'Сіз пайдаланушы параметрлерін жоюға және бизнес процесс параметрлерін бастапқа қайтаруға сенімдісіз бе ""%1""?'; ro = 'Sunteți sigur că doriți să ștergeți setarea personalizată și să reveniți la valoarea inițială a procesului de afaceri ""%1""?'; ru = 'Вы действительно хотите удалить пользовательскую настройку и вернуть исходное значение бизнес-процесса ""%1""?'; tr = 'Kullanıcı ayarını geri yüklemek ve ""%1"" iş sürecinin orijinal değerini geri getirmek istediğinizden emin misiniz?'; uk = 'Ви дійсно хочете видалити користувацьке налаштування і повернути початкове значення бізнес-процесу ""%1""?'; uz = 'Siz rostdan foydalanuvchi sozlamasini o''chirib, ""%1"" biznes jarayonining asal qiymatiga qaytmoqchimisiz?'");
			ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТекущиеДанные.Название);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалитьПользовательскуюНастройкуЗавершение", ЭтаФорма, ТекущиеДанные);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		КонецЕсли;
		Возврат;
	КонецЕсли;
		
	ТекстВопроса = НСтр("be = 'Вы сапраўды жадаеце выдаліць наладу бізнес-працэсу ""%1""?'; en = 'Do you really want to delete the business process setting ""%1""?'; es = '¿Realmente desea eliminar la configuración del proceso empresarial ""%1""?'; ka = 'ნამდვილად გსურთ ბიზნეს პროცესის პარამეტრების წაშლა ""%1""?'; kk = 'Сіз сауатты бизнес процесс параметрлерін жою керек пе ""%1""?'; ro = 'Sunteți sigur că doriți să ștergeți setarea procesului de afaceri ""%1""?'; ru = 'Вы действительно хотите удалить настройку бизнес-процесса ""%1""?'; tr = '""%1"" iş süreci ayarını gerçekten silmek istiyor musunuz?'; uk = 'Ви дійсно хочете видалити налаштування бізнес-процесу ""%1""?'; uz = 'Siz rostdan ""%1"" biznes jarayoni sozlamasini o''chirmoqchimisiz?'");
	ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТекущиеДанные.Название);
			
	ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалитьНастройкуЗавершение", ЭтаФорма, ТекущиеДанные);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуРедактированияНастройки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	СтруктураНастройки = Новый Структура;	
	ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			Конецесли;
			СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки_"+СтрокаУзла.ID_Узла);
		КонецЦикла;
	КонецЕсли;
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастройки);
	
	СтруктураНастроекБизнесПроцессов_Пользовательские 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов();	                           
	СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();	                           
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию 				= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();	                           
	
	СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию",					СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов);	
	СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_Пользовательские", 			СтруктураНастроекБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов);	
	СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки",	СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов);
	СтруктураНастройки.Вставить("ПроизвольныеКоды_ПоУмолчанию",							_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию"));
	СтруктураНастройки.Вставить("ПроизвольныеКоды_Пользовательские",					_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские"));
	СтруктураНастройки.Вставить("ВерсияОбработкиНастроек",								_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиКлеверенсТСД"));
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастройки, "НастройкиБизнесПроцессов");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("НастройкиБизнесПроцессов", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт
		
	НастройкиБизнесПроцессов_Пользовательские = Ложь;
	НастройкиБизнесПроцессов_ПользовательскиеНастройки = Ложь;
	ПроизвольныеКоды_Пользовательские = Ложь;
	
	Если СтруктураНастроек <> Неопределено Тогда
		
		//Выполним обновление - Начало
		ВерсияОбработки =_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");		
		Если СтруктураНастроек.Свойство("ВерсияОбработкиНастроек") Тогда
			ВерсияОбработкиНастроек = СтруктураНастроек.ВерсияОбработкиНастроек;
		Иначе
			ВерсияОбработкиНастроек = 0;		
		КонецЕсли;  
		Если ВерсияОбработки>ВерсияОбработкиНастроек Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ВерсияНастроек,СтруктураНастроек",ВерсияОбработкиНастроек,СтруктураНастроек));
			
			СтруктураНастроек = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,_ЛокКонтекст.АдресаПеременных);
		КонецЕсли;
		//Выполним обновление - Конец
		
		Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_Пользовательские") Тогда			
			СтруктураНастроекБизнесПроцессов = ПолучитьТаблицуНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек, "НастройкиБизнесПроцессов_Пользовательские"); 
			Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
				НастройкиБизнесПроцессов_Пользовательские = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;	
			Иначе
				НастройкиБизнесПроцессов_Пользовательские = СтруктураНастроекБизнесПроцессов;	
			КонецЕсли;
		КонецЕсли;	
		
		Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки") Тогда
			СтруктураНастроекБизнесПроцессов = ПолучитьТаблицуНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек, "НастройкиБизнесПроцессов_ПользовательскиеНастройки"); 
			Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;	
			Иначе
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроекБизнесПроцессов;	
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
			СтруктураНастроекБизнесПроцессов = ПолучитьТаблицуНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек, "НастройкиБизнесПроцессов_ПоУмолчанию"); 
			Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
				НастройкиБизнесПроцессов_ПоУмолчанию = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;	
			Иначе
				НастройкиБизнесПроцессов_ПоУмолчанию = СтруктураНастроекБизнесПроцессов;	
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
			
			Если НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь и ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) Тогда
				
				Если НастройкиБизнесПроцессов_Пользовательские = Ложь Или Не ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) Тогда
					НастройкиБизнесПроцессов_Пользовательские = Новый Массив();
					НастройкиБизнесПроцессов_Пользовательские.Добавить(НастройкиБизнесПроцессов_ПоУмолчанию[0]);
				КонецЕсли;
				
				//Если в базе больше нет такого типового БП то создадим ка пользовательский
				СтруктураНастроекБизнесПроцессов_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
				
				ТекущиеНастройкиБизнесПроцессов_ПоУмолчанию = СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
				Для Каждого НовыйБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
					Если НовыйБП.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					Отбор = Новый Структура("ID_БизнесПроцесса",НовыйБП.ID_БизнесПроцесса);
					Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ТекущиеНастройкиБизнесПроцессов_ПоУмолчанию,Отбор);
					Если Результат = Неопределено Тогда	
						НастройкиБизнесПроцессов_Пользовательские.Добавить(НовыйБП);	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
			
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("ПроизвольныеКоды_Пользовательские") Тогда
			ПроизвольныеКоды_Пользовательские = СтруктураНастроек.ПроизвольныеКоды_Пользовательские;
			Если ТипЗнч(ПроизвольныеКоды_Пользовательские) = Тип("Строка") Тогда
				ПроизвольныеКоды_Пользовательские = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_Пользовательские,Истина);	
			КонецЕсли;	
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("ПроизвольныеКоды_ПоУмолчанию") Тогда
			ПроизвольныеКоды_ПоУмолчанию = СтруктураНастроек.ПроизвольныеКоды_ПоУмолчанию;
			Если ТипЗнч(ПроизвольныеКоды_ПоУмолчанию) = Тип("Строка") Тогда
				ПроизвольныеКоды_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_ПоУмолчанию,Истина);	
			КонецЕсли;
			Если НЕ ПроизвольныеКоды_ПоУмолчанию = Ложь и ЗначениеЗаполнено(ПроизвольныеКоды_ПоУмолчанию) Тогда
				
				Если ПроизвольныеКоды_Пользовательские = Ложь Или Не ЗначениеЗаполнено(ПроизвольныеКоды_Пользовательские) Тогда
					ПроизвольныеКоды_Пользовательские = Новый Массив();
					ПроизвольныеКоды_Пользовательские.Добавить(ПроизвольныеКоды_ПоУмолчанию[0]);
				КонецЕсли;
				
				//Если в базе больше нет такого типового БП то создадим ка пользовательский
				ТекущиеПроизвольныеКоды_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию");
				Для Каждого НовыйПК Из ПроизвольныеКоды_ПоУмолчанию Цикл
					Если НовыйПК.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					Отбор = Новый Структура("ID_ПроизвольногоКода",НовыйПК.ID_ПроизвольногоКода);
					Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ТекущиеПроизвольныеКоды_ПоУмолчанию,Отбор);
					Если Результат = Неопределено Тогда	
						ПроизвольныеКоды_Пользовательские.Добавить(НовыйПК);	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтруктураНастроек = Новый Структура();
		
		СтруктураНастроекБизнесПроцессов_Пользовательские = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
		НастройкиБизнесПроцессов_Пользовательские, 
		_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
		НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
		_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
		
		НоваяСтруктураНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские",			СтруктураНастроекБизнесПроцессов_Пользовательские);
		НоваяСтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки",	СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		НоваяСтруктураНастроек.Вставить("ПроизвольныеКоды_Пользовательские",					ПроизвольныеКоды_Пользовательские);
		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(НоваяСтруктураНастроек);
		_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");
		
		ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
		Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
			Для Каждого СтрокаУзла Из ВсеУзлы Цикл
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				Конецесли;
				Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки_"+СтрокаУзла.ID_Узла) Тогда
					НоваяНастройка = СтруктураНастроек["НастройкиБизнесПроцессов_ПользовательскиеНастройки_"+СтрокаУзла.ID_Узла];	
					НоваяСтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки_"+СтрокаУзла.ID_Узла,НоваяНастройка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НоваяСтруктураНастроек);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(Ложь);
		
		УдалитьОтборыДляУдаленныхБизнесПроцессов();
		ДобавитьОтборыДляДобавленныхБизнесПроцессов();
		
		ЕстьОтключенныеБизнесПроцессы = _ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
		Если ЕстьОтключенныеБизнесПроцессы Тогда
			ОбновитьТаблицуНастроекБизнесПроцессов();
		Иначе
			ВыгрузитьБизнесПроцессыВБазуSMARTS(); // Отключенные бизнес-процессы были выгружены в базу в момент отключения
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте 
Функция ПолучитьТаблицуНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек, ИмяНастройки)
	
	НастройкиБизнесПроцессов = СтруктураНастроек[ИмяНастройки];			
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Строка") Тогда
		НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов, Истина);	
	КонецЕсли;	                                         				
	
	Возврат НастройкиБизнесПроцессов;
	
КонецФункции

&НаКлиенте
Процедура ВосстановитьНастройки(Команда)
	ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ВосстановитьНастройкиЗавершение", ЭтаФорма);
	
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		ТекстВопроса = НСтр("be = ""Бягучыя налады торговага аб'екта будуць страчаныя! Тыпавыя і карыстальніцкія бізнес-працэсы застануцца без зменаў. Працягнуць?""; en = 'Current trading object settings will be lost! Standard and custom business processes will remain unchanged. Continue?'; es = '¡Se perderán las configuraciones actuales del objeto comercial! Los procesos comerciales estándar y personalizados permanecerán sin cambios. ¿Continuar?'; ka = 'მიმდინარე სავაჭრო ობიექტის პარამეტრები დაკარგული იქნება! სტანდარტული და მომხმარებელი ბიზნეს პროცესები იქნება უცვლელებელი. გაგრძელება?'; kk = 'Торговый объекттің ағымдағы параметрлері жоқ болады! Стандартты және пайдаланушылардың бизнес процестері өзгермейді. Жалғастыру керек пе?'; ro = 'Setările actuale ale obiectului comercial vor fi pierdute! Procesele de afaceri standard și personalizate nu vor fi afectate. Continuați?'; ru = 'Текущие настройки торгового объекта будут утеряны! Типовые и пользовательские бизнес процессы останутся без изменения. Продолжить?'; tr = 'Geçerli ticari nesne ayarları kaybolacak! Standart ve kullanıcı iş süreçleri değişmeden kalacak. Devam etmek istiyor musunuz?'; uk = ""Поточні налаштування торгового об'єкта будуть втрачені! Типові та користувацькі бізнес-процеси залишаться без змін. Продовжити?""; uz = ""Joriy savdo ob'ektining sozlamalari yo'q bo'ladi! Standart va foydalanuvchi biznes jarayonlari o'zgarmaydi. Davom etamizmi?""");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		ТекстВопроса = НСтр("be = 'Бягучыя налады будуць страчаныя! Перазапісаць іх?'; en = 'Current settings will be lost! Overwrite them?'; es = '¡Se perderán los ajustes actuales! ¿Desea sobrescribirlos?'; ka = 'მიმდინარი პარამეტრები დაკარგულია! გსურთ მათი გადაყვანა?'; kk = 'Ағымдағы орнатулар жоқ болады! Оларды қайта жазу керек пе?'; ro = 'Setările curente vor fi pierdute! Doriți să le suprascrieți?'; ru = 'Текущие настройки будут утеряны! Перезаписать их?'; tr = 'Geçerli ayarlar kaybolacak! Üzerine yazmak istiyor musunuz?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Жорий созламалар йўқ бўлади! Уларни ўчиришга рози бўласизми?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВОдинКлюч(Команда)
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов", _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(НастройкиБизнесПроцессов), ID_Узла);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьБизнесПроцессы(Команда)
	
	ВыгрузитьБизнесПроцессыВБазуSMARTS();	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	НекорректныеБизнесПроцессы = ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS(Ложь);
	
	Если НекорректныеБизнесПроцессы.Количество() Тогда
		ТекстСообщенияНачало = НСтр("ru = 'Документ Клеверенс не указан или отсутствует в метаданных для бизнес-процессов:'; en = 'Cleverence Document is not specified or missing in the metadata for business processes:'; kk = 'Cleverence құжаты бизнес процесілердің метадеректерінде көрсетілмеген немесе жоқ:'; uz = 'Cleverence ҳужжати бизнес процесслар учун метаданныаларда кўрсатилмаган ёки йўқ:'; be = 'Дакумент Cleverence не ўказаны або адсутнічае ў метададзе для бізнес-працэсаў:'; uk = 'Документ Cleverence не вказаний або відсутній в метаданих для бізнес-процесів:'; ka = 'Cleverence დოკუმენტი არ არის მოცემული ან არ არის მეტადანებში საბიზნეს პროცესებისთვის:'; tr = 'Cleverence belgesi, iş süreçleri için meta verilerde belirtilmemiş veya bulunmamaktadır:'; es = 'El documento Cleverence no está especificado o no está presente en los metadatos para procesos comerciales:'; ro = 'Documentul Cleverence nu este specificat sau lipsește din metadatele pentru procesele de afaceri:'");
		ТекстСообщенияКонец	 = НСтр("ru = 'Продолжить?'; en = 'Continue?'; kk = 'Жалғастыру?'; uz = 'Davom ettirsak?'; be = 'Працягнуць?'; uk = 'Продовжити?'; ka = 'გაგრძელება?'; tr = 'Devam etmek istiyor musunuz?'; es = '¿Continuar?'; ro = 'Continuați?'");
		
		ТекстСообщенияБизнесПроцессы = "";
		Для каждого СтрокаНастройки ИЗ НекорректныеБизнесПроцессы Цикл 
			ТекстСообщенияБизнесПроцессы = ТекстСообщенияБизнесПроцессы + Символы.ПС + "- " + СтрокаНастройки;
		КонецЦикла;
		
		ТекстСообщения = ТекстСообщенияНачало
			+ Символы.ПС
			+ ТекстСообщенияБизнесПроцессы
			+ Символы.ПС
			+ Символы.ПС
			+ ТекстСообщенияКонец;
		ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьЗначениеФлагаИспользуетсяПослеОтветаНаВопрос", ЭтаФорма);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
	Иначе	
		УстановитьЗначениеФлагаИспользуется(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьЗначениеФлагаИспользуется(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСлужебныеКолонки(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ОтображаемыеНастройкиБизнесПроцессов.Колонки.ID_БизнесПроцесса.Видимость = Истина;
		Элементы.ОтображаемыеНастройкиБизнесПроцессов.Колонки.ТипИсходногоДокумента1С.Видимость = Истина;
		Элементы.ОтображаемыеНастройкиБизнесПроцессов.Колонки.ТипДокументаMS.Видимость = Истина;
		Элементы.ОтображаемыеНастройкиБизнесПроцессов.Колонки.ТипРезультирующегоДокумента1С.Видимость = Истина;
	#Иначе
		Элементы.ОтображаемыеНастройкиБизнесПроцессовID_БизнесПроцесса.Видимость = Истина;
		Элементы.ОтображаемыеНастройкиБизнесПроцессовТипИсходногоДокумента1С.Видимость = Истина;
		Элементы.ОтображаемыеНастройкиБизнесПроцессовТипДокументаMS.Видимость = Истина;
		Элементы.ОтображаемыеНастройкиБизнесПроцессовТипРезультирующегоДокумента1С.Видимость = Истина;
	#КонецЕсли
	
КонецПроцедуры

