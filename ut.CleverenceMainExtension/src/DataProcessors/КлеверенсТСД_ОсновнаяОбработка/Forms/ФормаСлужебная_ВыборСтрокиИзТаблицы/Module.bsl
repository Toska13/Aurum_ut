&НаКлиенте
Процедура ТаблицаВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработатьВыбор();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыбор()
	
	ОбработатьВыборБизнесПроцесса();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	ОбработатьВыборБизнесПроцесса(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборБизнесПроцесса(ДляВсех = Ложь)
	
	ВыбраннаяСтрока = Элементы.ТаблицаВыбора.ТекущиеДанные;

	Если ИмяТаблицы = "БизнесПроцессыДляЗагрузки" Тогда
		УИД = Новый УникальныйИдентификатор();
		СтруктураДляПроверки = Новый Структура("ВыполнитьТолькоПроизвольныйКод", УИД);
		ЗаполнитьЗначенияСвойств(СтруктураДляПроверки, ВыбраннаяСтрока);
		
		ВыполнитьТолькоПроизвольныйКод = СтруктураДляПроверки["ВыполнитьТолькоПроизвольныйКод"] <> УИД
			И ВыбраннаяСтрока.ВыполнитьТолькоПроизвольныйКод = Истина;
		Если НЕ ЗначениеЗаполнено(СокрЛП(ВыбраннаяСтрока.ТипРезультирующегоДокумента1С)) И НЕ ВыполнитьТолькоПроизвольныйКод
			ИЛИ ВыбраннаяСтрока.ЗагружатьВТотЖе И НЕ ЗначениеЗаполнено(СокрЛП(ВыбраннаяСтрока.ТипИсходногоДокумента1С)) Тогда
			Сообщение = НСтр("be = 'Дадзены бізнес-працэс не мае на ўвазе загрузку дакумента ў 1С, бо у яго не запоўнены выніковы дакумент 1С'; en = 'This business process does not involve uploading a document to 1C, because it does not have a completed 1C result document'; es = 'Este proceso de negocio no implica cargar el documento en 1C, ya que no tiene el documento 1C resultante lleno'; ka = 'ეს ბიზნეს პროცესი არ გულისხმობს დოკუმენტის ატვირთვას 1C-ზე, რადგან მას არ აქვს დასრულებული 1c შედეგის დოკუმენტი'; kk = 'Бұл бизнес-процесс құжатты 1С-қа жүктеуді білдірмейді, өйткені оның 1С құжаты толтырылмаған'; ro = 'Acest proces de afaceri nu implică încărcarea unui document în 1C, deoarece documentul 1C rezultat nu este completat'; ru = 'Данный бизнес-процесс не подразумевает загрузку документа в 1С, т.к. у него не заполнен результирующий документ 1С'; tr = ""Bu iş süreci, belgenin 1c'ye yüklenmesi anlamına gelmez, çünkü sonuçta ortaya çıkan 1C belgesine sahip değildir""; uk = 'Даний бізнес-процес не має на увазі завантаження документа в 1С, тому що у нього не заповнений результуючий документ 1С'; uz = ""Ushbu biznes jarayoni hujjatni 1C ga yuklashni anglatmaydi, chunki natijada olingan 1C hujjati to'ldirilmagan""");
			Сообщить(Сообщение); 
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	
	РезультатВыбора = Новый Структура;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СписокЭлементов = Элементы.ТаблицаВыбора.Колонки;
		ДлинаПрефикса = 0;
	#Иначе
		СписокЭлементов = Элементы.ТаблицаВыбора.ПодчиненныеЭлементы;
		ДлинаПрефикса = 13;
	#КонецЕсли
	
	Для Каждого КолонкаТЗ Из СписокЭлементов Цикл
		Колонка = Прав(КолонкаТЗ.Имя,СтрДлина(КолонкаТЗ.Имя)-ДлинаПрефикса);
		Если Колонка = "Выгружать" Тогда
			Продолжить;
		КонецЕсли;
		РезультатВыбора.Вставить(Колонка, ВыбраннаяСтрока[Колонка]);
	КонецЦикла;
	СтруктураВыбора = Новый Структура;
	СтруктураВыбора.Вставить("Данные", 	РезультатВыбора);
	СтруктураВыбора.Вставить("ДляВсех", ДляВсех);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РезультатЗакрытия = СтруктураВыбора;
	#КонецЕсли
	
	Закрыть(СтруктураВыбора);
	
КонецПроцедуры


#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Процедура ПриЗакрытии()
		
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезультатЗакрытия);
		КонецЕсли;
	
	КонецПроцедуры	

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли