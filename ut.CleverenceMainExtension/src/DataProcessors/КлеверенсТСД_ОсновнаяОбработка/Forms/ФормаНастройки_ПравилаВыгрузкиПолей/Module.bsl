&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте 
Перем ПредыдущееЗначение,
	  ТаблицаРеквизитовИсходная Экспорт,
	  ТаблицаРеквизитовДополнительная Экспорт; 


#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		Заголовок = НСтр("be = 'Cleverence: Налада выгрузкі палёў шапкі дакумента'; en = 'Cleverence: Setting up unloading fields of the document header'; es = 'Cleverence: Configuración de campos de descarga de encabezado de documentos'; ka = 'Cleverence: დოკუმენტის თავისი ნაწილის ველების გამოტანის პარამეტრები'; kk = 'Cleverence: Құжаттың шапка өрістерін шығару орнату'; ro = 'Cleverence: Configurarea descărcării câmpurilor antetului documentului'; ru = 'Клеверенс: Настройка выгрузки полей шапки документа'; tr = 'Cleverence: Belge başlığı alanlarının dışa aktarımı ayarları'; uk = 'Cleverence: Налаштування вивантаження полів шапки документа'; uz = 'Cleverence: Hujjat sarlavhasi maydonlarini yuklash sozlash'");
		СписокРеквизитов1С = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].Реквизиты;
		СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Реквизиты);
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковТабличнойЧасти.Свертка = РежимСверткиЭлементаУправления.Верх;			
		#Иначе	
			Элементы.РамкаОбработчикиТЧ.Видимость = Ложь;			
		#КонецЕсли
	ИначеЕсли КлючНастройки = "Выгрузка_Справочник" Тогда
		Заголовок = НСтр("be = 'Cleverence: Налада выгрузкі палёў даведніка'; en = 'Cleverence: Setting up unloading fields of the directory'; es = 'Cleverence: Configuración de campos de descarga de directorio'; ka = 'Cleverence: სამრავლოს ველების გამოტანის პარამეტრები'; kk = 'Cleverence: Тізімдік өрістерді шығару орнату'; ro = 'Cleverence: Configurarea descărcării câmpurilor din dicționar'; ru = 'Клеверенс: Настройка выгрузки полей справочника'; tr = 'Cleverence: Rehber alanlarının dışa aktarımı ayarları'; uk = 'Cleverence: Налаштування вивантаження полів довідника'; uz = ""Cleverence: Ma'lumotnoma maydonlarini yuklash sozlash""");
		Если Найти(ТипДокумента1С, "Запрос") Тогда
			Если ЗначениеЗаполнено(ТекстЗапросаВыгрузкиНаТСД) Тогда
				СписокРеквизитов1С = фЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);			
			КонецЕсли;
		КонецЕсли;
		Если ТипДокументаMS = "Номенклатура" Тогда
			СписокРеквизитовMS = Новый СписокЗначений;
			СписокРеквизитовMS.ЗагрузитьЗначения(_ЛокКонтекст.СтруктураМетаданных.ВыгружаемыеПоляНоменклатурыMS);
		ИначеЕсли ТипДокументаMS = "Ячейки" Тогда
			СписокРеквизитовMS = Новый СписокЗначений;
			СписокРеквизитовMS.ЗагрузитьЗначения(_ЛокКонтекст.СтруктураМетаданных.ВыгружаемыеПоляЯчеекMS);
		Иначе
			Для каждого Таблица Из _ЛокКонтекст.СтруктураМетаданных.Tables Цикл
				Если Таблица.Представление = ТипДокументаMS Тогда
					МассивРеквизитовMS = Таблица.Значение;
					СписокРеквизитовMS = Новый ФиксированныйМассив(МассивРеквизитовMS);
					Прервать;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковТабличнойЧасти.Свертка = РежимСверткиЭлементаУправления.Верх;
			Элементы.ПанельОбработчиковДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;
		#Иначе	
			Элементы.РамкаОбработчикиТЧ.Видимость = Ложь;
			Элементы.РамкаОбработчикиДокументов.Видимость = Ложь;			
		#КонецЕсли
	Иначе
	    Заголовок = НСтр("be = 'Cleverence: Налада выгрузкі палёў таблічнай часткі дакумента'; en = 'Cleverence: Setting up unloading fields of the document table part'; es = 'Cleverence: Configuración de campos de descarga de partes de tablas de documentos'; ka = 'Cleverence: დოკუმენტის ცხადი ნაწილების ველების გამოტანის პარამეტრები'; kk = 'Cleverence: Құжаттың тізімді бөлігінің өрістерін шығару орнату'; ro = 'Cleverence: Configurarea descărcării câmpurilor părții tabelei a documentului'; ru = 'Клеверенс: Настройка выгрузки полей табличной части документа'; tr = 'Cleverence: Belge tablo bölümü alanlarının dışa aktarımı ayarları'; uk = 'Cleverence: Налаштування вивантаження полів табличної частини документа'; uz = 'Cleverence: Hujjat jadval qismi maydonlarini yuklash sozlash'");
		Если Найти(ИмяТабличнойЧасти1С, "Запрос") Тогда
			Если ЗначениеЗаполнено(ТекстЗапросаВыгрузкиНаТСД) Тогда
				СписокРеквизитов1С = фЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);			
			КонецЕсли;
		Иначе
			СписокРеквизитов1С = Новый СписокЗначений;
			СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
			Если СписокДополнительныхОбработчиков <> Неопределено
				И СписокДополнительныхОбработчиков.Получить(ИмяТабличнойЧасти1С) <> Неопределено Тогда
				СписокРеквизитов1С = СписокДополнительныхОбработчиков[ИмяТабличнойЧасти1С].СписокКолонок;
				Синоним = ?(СписокДополнительныхОбработчиков[ИмяТабличнойЧасти1С].Свойство("Синоним"),СписокДополнительныхОбработчиков[ИмяТабличнойЧасти1С].Синоним,ИмяТабличнойЧасти1С);
				Элементы.ИмяТабличнойЧасти1С.Заголовок = Синоним;
			КонецЕсли;
			ТабличныеЧасти = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].ТабличныеЧасти;
			Если СписокРеквизитов1С.Количество() = 0 
				И ТабличныеЧасти.Свойство(ИмяТабличнойЧасти1С) <> Неопределено Тогда
				СписокРеквизитов1С = ТабличныеЧасти[ИмяТабличнойЧасти1С].Реквизиты;
				Элементы.ИмяТабличнойЧасти1С.Заголовок = ТабличныеЧасти[ИмяТабличнойЧасти1С].Синоним;
			КонецЕсли;
		КонецЕсли;
		
		Если 	ИмяТабличнойЧастиMS = "СтрокиПлан" 
			ИЛИ ИмяТабличнойЧастиMS = "СтрокиФакт" 
			ИЛИ ИмяТабличнойЧастиMS = "СовмещенныеСтроки" Тогда
			СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыТЧ);							
			
		ИначеЕсли ИмяТабличнойЧастиMS = "СерииПлан" 
			ИЛИ   ИмяТабличнойЧастиMS = "СерииФакт" Тогда
			СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыСерии);							
			
		ИначеЕсли ИмяТабличнойЧастиMS = "СерийныеНомераПлан" 
			ИЛИ   ИмяТабличнойЧастиMS = "СерийныеНомераФакт" Тогда
			СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыСерийныеНомера);							
			
		Иначе
			СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
			Для Каждого ДопТаблица Из СписокДопТаблиц Цикл
				Если ДопТаблица.Представление = ИмяТабличнойЧастиMS Тогда
					СписокРеквизитовMS = Новый ФиксированныйМассив(ДопТаблица.Значение);
					Прервать;
				КонецЕсли;
			КонецЦикла;			
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;			
		#Иначе	
			Элементы.РамкаОбработчикиДокументов.Видимость = Ложь;			
		#КонецЕсли		
	КонецЕсли;
	
	ОбновитьПредставленияСпискаДокументов1С();
	
	ОбновитьСписокПроизвольныхКодов();
	
	// Список Глобальных параметров
	ТаблицаГлобальныхПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ГлобальныеПараметры", Новый Структура());
	
	Если ТипЗнч(ТаблицаГлобальныхПараметров) = Тип("Массив") Тогда 
		Для Каждого СтрокаПараметра Из ТаблицаГлобальныхПараметров Цикл
		    Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			СписокГлобальныхПараметров.Добавить(СтрокаПараметра.ID_Параметра, СтрокаПараметра.Наименование);
		КонецЦикла;
	КонецЕсли;	
	
	// Список вариантов обработчиков загрузки
	СписокВариантовОбработчиков.Добавить(0, НСтр("be = 'Без апрацоўніка'; en = 'Without handler'; es = 'Sin controlador'; ka = 'დამუშავების გარეშე'; kk = 'Өңдеушісіз  '; ro = 'Fără manipulator'; ru = 'Без обработчика'; tr = 'İşleyici olmadan'; uk = 'Без обробника'; uz = ""Ilova yo'q  """));
	СписокВариантовОбработчиков.Добавить(1, НСтр("be = 'Апрацоўчык па змаўчанні'; en = 'Default handler'; es = 'Controlador predeterminado'; ka = 'ნაგუშავების გამომტაცება'; kk = 'Өңдеуші әдепкі'; ro = 'Procesorul implicit'; ru = 'Обработчик по умолчанию'; tr = 'Varsayılan işlemci'; uk = 'Обробник за замовчуванням'; uz = 'Sukutiy muhandis'"));
	СписокВариантовОбработчиков.Добавить(2, НСтр("be = 'Свой апрацоўчык'; en = 'Your handler'; es = 'Tu procesador'; ka = 'თქვენი დამუშაველი'; kk = 'Өз өңдеуші'; ro = 'Propriul procesor'; ru = 'Свой обработчик'; tr = 'Kendi işleyici'; uk = 'Ваш обробник'; uz = ""O'zingizning qayta ishlovchi"""));
	СписокВариантовОбработчиков.Добавить(3, НСтр("be = 'Давольны код'; en = 'Arbitrary code'; es = 'Código arbitrario'; ka = 'შემუშავების კოდი'; kk = 'Өзге код'; ro = 'Cod arbitrar'; ru = 'Произвольный код'; tr = 'Rastgele Kod'; uk = 'Довільний код'; uz = 'Tasodifiy kodi'"));
	
	// Список категорий приемника
	СписокТиповПриемника.Добавить("РеквизитMS", 		НСтр("be = 'Фіксаваны рэквізіт Cleverence'; en = 'Fixed attribute Cleverence'; es = 'Atributo fijo de Cleverence'; ka = 'Cleverence-ის მკაცრი ატრიბუტი'; kk = 'Cleverence фиксировандағы реквизит'; ro = 'Atribut fix Cleverence'; ru = 'Фиксированный реквизит Mobile SMARTS'; tr = 'Cleverence sabit nitelik'; uk = 'Фіксований реквізит Cleverence'; uz = ""Cleverence o'zlashtirilgan atributi"""));
	Если КлючНастройки <> "Выгрузка_Справочник" Тогда
		СписокТиповПриемника.Добавить("НовыйРеквизит", 	НСтр("be = 'Новы рэквізіт Cleverence'; en = 'New Cleverence attribute'; es = 'Nuevo atributo Cleverence'; ka = 'Cleverence-ის ახალი ატრიბუტი'; kk = 'Cleverence жаңа анықтамасы'; ro = 'Atribut nou Cleverence'; ru = 'Новый реквизит Mobile SMARTS'; tr = 'Yeni Cleverence özellik'; uk = 'Новий реквізит Cleverence'; uz = 'Yangi Cleverence atribut'"));
	КонецЕсли;
	
	// Список категорий источника
	СписокТиповИсточника.Добавить("Реквизит1С", 			 НСтр("be = 'Рэквізіт 1С'; en = '1C Attribute'; es = 'Atributo de 1C'; ka = '1C რეკვიზიტი'; kk = '1С реквизиті  '; ro = 'Atribut 1C'; ru = 'Реквизит 1С'; tr = '1C Özelliği'; uk = 'Атрибут 1С'; uz = '1C attributi  '"));
	Если КлючНастройки <> "Выгрузка_Справочник" Тогда
		СписокТиповИсточника.Добавить("ГлобальныйПараметр",  НСтр("be = 'Глабальны параметр'; en = 'Global parameter'; es = 'Parámetro global'; ka = 'გლობალური პარამეტრი'; kk = 'Құрылымдық параметр'; ro = 'Parametru global'; ru = 'Глобальный параметр'; tr = 'Genel parametre'; uk = 'Глобальний параметр'; uz = 'Global parametr'"));	
		СписокТиповИсточника.Добавить("ПроизвольноеЗначение",НСтр("be = 'Давольная велічыня'; en = 'Arbitrary value'; es = 'Valor arbitrario'; ka = 'შემუშავების მნიშვნელობა'; kk = 'Өзге мән'; ro = 'Valoare arbitrară'; ru = 'Произвольное значение'; tr = 'Rastgele Değer'; uk = 'Довільне значення'; uz = 'Tasodifiy qiymat'"));	
		СписокТиповИсточника.Добавить("ПроизвольныйКод", 	 НСтр("be = 'Давольны код'; en = 'Arbitrary code'; es = 'Código arbitrario'; ka = 'შემუშავების კოდი'; kk = 'Өзге код'; ro = 'Cod arbitrar'; ru = 'Произвольный код'; tr = 'Rastgele Kod'; uk = 'Довільний код'; uz = 'Tasodifiy kodi'"));	
	КонецЕсли;
	
	// Список правил сопоставления для ссылочных типов
	СписокСпособовСопоставления.Добавить("СтрокаGUID",   	 НСтр("be = 'Спасылка (радок GUID)'; en = 'Link (GUID string)'; es = 'Enlace (cadena GUID)'; ka = 'ბმული (GUID სტრიქონი)'; kk = 'Сілтеме (GUID жолы)'; ro = 'Legătură (șir GUID)'; ru = 'Ссылка (строка GUID)'; tr = 'Bağlantı (GUID dizesi)'; uk = 'Посилання (рядок GUID)  '; uz = 'Havola (GUID qator)'"));
	Если КлючНастройки <> "Выгрузка_Справочник" Тогда
		СписокСпособовСопоставления.Добавить("Наименование", НСтр("be = 'Найменне (для даведнікаў)'; en = 'Name (for directories)'; es = 'Denominación (para directorios)'; ka = 'დასახელება (რეფერენციებისთვის)'; kk = 'Атауы (тізімдер үшін)'; ro = 'Denumire (pentru dicționare)'; ru = 'Наименование (для справочников)'; tr = 'Ad (rehberler için)'; uk = 'Найменування (для довідників)'; uz = ""Nomi (ma'lumotlar bazasi uchun)"""));
		СписокСпособовСопоставления.Добавить("Код",          НСтр("be = 'Код (для даведнікаў)'; en = 'Code (for directories)'; es = 'Código (para directorios)'; ka = 'კოდი (რეფერენციებისთვის)'; kk = 'Код (тақырыптар үшін)'; ro = 'Cod (pentru dicționare)'; ru = 'Код (для справочников)'; tr = 'Kod (rehberler için)'; uk = 'Код (для довідників)'; uz = 'Kod (referenslar uchun)'"));
	КонецЕсли;
	СписокСпособовСопоставления.Добавить("КакЕсть", 		 НСтр("be = 'Як ёсць (просты тып)'; en = 'As is (simple type)'; es = 'Como está (tipo simple)'; ka = 'როგორც არის (მარტივი ტიპი)'; kk = 'Көрсетілгендей (қарапайым түрі)'; ro = 'Așa cum este (tip simplu)'; ru = 'Как есть (простой тип)'; tr = 'Mevcut durum (basit tür)'; uk = 'Як є (простий тип)'; uz = 'Joriy hol (oddiy turi)'"));
	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипПриемникаСиноним,СписокТиповПриемника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипИсточникаСиноним,СписокТиповИсточника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПрЗначение,СписокРеквизитовMS, "Ключ", "Ключ");	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним,СписокСпособовСопоставления);

	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередВыгрузкойДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеВыгрузкиДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОтправкиДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередВыгрузкойТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеВыгрузкиТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	
	// Видимость и значения элементов
	Элементы.ИмяТабличнойЧасти1С.Видимость     	= КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента";
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.НадписьТабличнаяЧасть1С.Видимость     	= КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента";	
	#КонецЕсли
	Элементы.НадписьТекстЗапроса.Видимость     	= (Найти(ИмяТабличнойЧасти1С, "Запрос") > 0);
	Элементы.РедактироватьТекстЗапроса.Видимость 	= (Найти(ИмяТабличнойЧасти1С, "Запрос") > 0);
	Элементы.ПараметрыЗапроса.Видимость 	= (Найти(ИмяТабличнойЧасти1С, "Запрос") > 0);
		
	// В дальнейшем таблица должна передаваться напрямую
	Если ЗначениеЗаполнено(ТаблицаРеквизитовИсходная) Тогда
		Для Каждого СтрокаИсходнойТаблицы Из ТаблицаРеквизитовИсходная Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
			
			РеквизитMS = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(СписокРеквизитовMS, Новый Структура("Значение", НоваяСтрока.ИмяПриемника), Истина);
			Если РеквизитMS <> Неопределено Тогда
				НоваяСтрока.СинонимПриемника = НоваяСтрока.Ключ;
				НоваяСтрока.ПрЗначение = НоваяСтрока.Ключ;
			КонецЕсли;
			
			// Загрузка старых настроек
			Если СтрокаИсходнойТаблицы.Свойство("ИмяMS") Тогда
				НоваяСтрока.ИмяПриемника = СтрокаИсходнойТаблицы.ИмяMS;
				НайденныйЭлементИмениПриемника = Неопределено;
				Для каждого РеквизитMS из СписокРеквизитовMS Цикл
					Если РеквизитMS.Значение = НоваяСтрока.ИмяПриемника Тогда
						НайденныйЭлементИмениПриемника = Новый Структура("Значение,Представление",РеквизитMS.Значение,РеквизитMS.Ключ);	
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НайденныйЭлементИмениПриемника <> Неопределено Тогда
					НоваяСтрока.СинонимПриемника = НайденныйЭлементИмениПриемника.Представление;
				Иначе
					НоваяСтрока.СинонимПриемника = СтрокаИсходнойТаблицы.ИмяMS;
				КонецЕсли;
				НоваяСтрока.ТипПриемника = "РеквизитMS";
				НоваяСтрока.ТипПриемникаСиноним = "Фиксированный реквизит Mobile SMARTS";
			КонецЕсли;
			
			Если СтрокаИсходнойТаблицы.Свойство("Имя1С") <> Неопределено Тогда
				
				Если СтрокаИсходнойТаблицы.Свойство("Тип") И СтрокаИсходнойТаблицы.Тип = "Реквизит 1С" Тогда
					// ищем в реквизитах
					НайденныйЭлементИмениИсточника = СписокРеквизитов1С.НайтиПоЗначению(СтрокаИсходнойТаблицы.Имя1С);
					Если НайденныйЭлементИмениИсточника <> Неопределено Тогда
						НоваяСтрока.ИмяИсточника = НайденныйЭлементИмениИсточника.Значение;
						НоваяСтрока.СинонимИсточника = НайденныйЭлементИмениИсточника.Представление;
						НоваяСтрока.ТипИсточника = "Реквизит1С";
						НоваяСтрока.ТипИсточникаСиноним = "Реквизит 1С";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(НоваяСтрока.ИмяИсточника) Тогда
						Если СтрокаИсходнойТаблицы.Свойство("ВыгружатьКакUID") Тогда
							Если СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка (GUID)" ИЛИ СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка(GUID)" Тогда
								НоваяСтрока.СпособСопоставления = "СтрокаGUID";
								НоваяСтрока.СпособСопоставленияСиноним = "Ссылка (строка GUID)";
							ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "По наименованию" Тогда
								НоваяСтрока.СпособСопоставления = "Наименование";
								НоваяСтрока.СпособСопоставленияСиноним = "Наименование (для справочников)";
							ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Код" Тогда
								НоваяСтрока.СпособСопоставления = "Код";
								НоваяСтрока.СпособСопоставленияСиноним = "Код (для справочников)";
							Иначе
								НоваяСтрока.СпособСопоставления = "КакЕсть";
								НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли СтрокаИсходнойТаблицы.Свойство("Тип") И (СтрокаИсходнойТаблицы.Тип = "Дата" ИЛИ СтрокаИсходнойТаблицы.Тип = "Число" ИЛИ СтрокаИсходнойТаблицы.Тип = "Строка" ИЛИ СтрокаИсходнойТаблицы.Тип = "Булево") Тогда
					НоваяСтрока.ТипИсточника = "ПроизвольноеЗначение";
					НоваяСтрока.ТипИсточникаСиноним = "Произвольное значение";
					НоваяСтрока.СпособСопоставления = "КакЕсть";
					НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
					НоваяСтрока.ЗначениеИсточника = СтрокаИсходнойТаблицы.Имя1С;
				КонецЕсли;
			КонецЕсли;			
			
		КонецЦикла;
	ИначеЕсли КлючНастройки = "Выгрузка_Справочник" Тогда
		ЗаполнитьТаблицуРеквизитовПоУмолчанию();		
	КонецЕсли;
	Если ТаблицаРеквизитовДополнительная <> Неопределено Тогда
		ТаблицаРеквизитовДополнительнаяНовая = Новый Массив();
		ТаблицаРеквизитовДополнительнаяНовая.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,Выгружать,ПрЗначение,ИсЗначение"));
		Для Каждого СтрокаИсходнойТаблицы Из ТаблицаРеквизитовДополнительная Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Новый Структура("ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,Выгружать,ПрЗначение,ИсЗначение");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
			
			// Загрузка старых настроек
			Если СтрокаИсходнойТаблицы.Свойство("ИмяMS") Тогда
				НоваяСтрока.ИмяПриемника = СтрокаИсходнойТаблицы.ИмяMS;
				НайденныйЭлементИмениПриемника = Неопределено;
				Для каждого РеквизитMS из СписокРеквизитовMS Цикл
					Если РеквизитMS.Значение = НоваяСтрока.ИмяПриемника Тогда
						НайденныйЭлементИмениПриемника = Новый Структура("Значение,Представление",РеквизитMS.Значение,РеквизитMS.Ключ);	
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НайденныйЭлементИмениПриемника <> Неопределено Тогда
					НоваяСтрока.СинонимПриемника = НайденныйЭлементИмениПриемника.Представление;
				Иначе
					НоваяСтрока.СинонимПриемника = СтрокаИсходнойТаблицы.ИмяMS;
				КонецЕсли;
				НоваяСтрока.ТипПриемника = "РеквизитMS";
				НоваяСтрока.ТипПриемникаСиноним = "Фиксированный реквизит Mobile SMARTS";
			КонецЕсли;
			
			Если СтрокаИсходнойТаблицы.Свойство("Имя1С") <> Неопределено Тогда
				
				Если СтрокаИсходнойТаблицы.Свойство("Тип") И СтрокаИсходнойТаблицы.Тип = "Реквизит 1С" Тогда
					// ищем в реквизитах
					НайденныйЭлементИмениИсточника = СписокРеквизитов1С.НайтиПоЗначению(СтрокаИсходнойТаблицы.Имя1С);
					Если НайденныйЭлементИмениИсточника <> Неопределено Тогда
						НоваяСтрока.ИмяИсточника = НайденныйЭлементИмениИсточника.Значение;
						НоваяСтрока.СинонимИсточника = НайденныйЭлементИмениИсточника.Представление;
						НоваяСтрока.ТипИсточника = "Реквизит1С";
						НоваяСтрока.ТипИсточникаСиноним = "Реквизит 1С";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(НоваяСтрока.ИмяИсточника) Тогда
						Если СтрокаИсходнойТаблицы.Свойство("ВыгружатьКакUID") Тогда
							Если СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка (GUID)" ИЛИ СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка(GUID)" Тогда
								НоваяСтрока.СпособСопоставления = "СтрокаGUID";
								НоваяСтрока.СпособСопоставленияСиноним = "Ссылка (строка GUID)";
							ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "По наименованию" Тогда
								НоваяСтрока.СпособСопоставления = "Наименование";
								НоваяСтрока.СпособСопоставленияСиноним = "Наименование (для справочников)";
							ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Код" Тогда
								НоваяСтрока.СпособСопоставления = "Код";
								НоваяСтрока.СпособСопоставленияСиноним = "Код (для справочников)";
							Иначе
								НоваяСтрока.СпособСопоставления = "КакЕсть";
								НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли СтрокаИсходнойТаблицы.Свойство("Тип") И (СтрокаИсходнойТаблицы.Тип = "Дата" ИЛИ СтрокаИсходнойТаблицы.Тип = "Число" ИЛИ СтрокаИсходнойТаблицы.Тип = "Строка" ИЛИ СтрокаИсходнойТаблицы.Тип = "Булево") Тогда
					НоваяСтрока.ТипИсточника = "ПроизвольноеЗначение";
					НоваяСтрока.ТипИсточникаСиноним = "Произвольное значение";
					НоваяСтрока.СпособСопоставления = "КакЕсть";
					НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
					НоваяСтрока.ЗначениеИсточника = СтрокаИсходнойТаблицы.Имя1С;
				КонецЕсли;
				
			КонецЕсли;			
			ТаблицаРеквизитовДополнительнаяНовая.Добавить(НоваяСтрока);
		КонецЦикла;
		ТаблицаРеквизитовДополнительная = ТаблицаРеквизитовДополнительнаяНовая;
	КонецЕсли;
	
	Для Каждого Элем Из ТаблицаРеквизитов Цикл
		Элем.ПрЗначение = ?(Элем.ТипПриемника = "НовыйРеквизит",Элем.ИмяПриемника,Элем.СинонимПриемника);
		Элем.ИсЗначение = ?(Элем.ТипИсточника = "ПроизвольноеЗначение",Элем.ЗначениеИсточника,Элем.СинонимИсточника);
	КонецЦикла;
	
	УстановитьЦветаЭлементов();	
	
	ВидОбработчика_ЗаполнениеПоУмолчанию();
	ЗаполнениеСоответствияВидовОбработчиковВыгрузки();
	
	ОбновитьШаблон();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийОсновныеДействияФормы

&НаКлиенте
Процедура ПараметрыЗапросаНажатие(Элемент)
	ОповещениеВводаТекстаЗапроса = Новый ОписаниеОповещения("ВведитеТекстКодаПолучениеПараметров", ЭтаФорма, );
	Если Не ЗначениеЗаполнено(ТекстКодаПолучениеПараметров) Тогда
		ТекстКодаПолучениеПараметров = НСтр("be = '//Усе параметры запыту, акрамя спасылкі на выгружаемы дакумент,%//павінны быць уключаныя ў структуру ПараметрыЗапыту.%//Ключ элемента структуры павінен супадаць з імем параметра запыту.%//Даступна спасылка на выгружаемы дакумент: ДакументДляВыгрузкі.'; en = '//All request parameters, except for the link to the unloaded document,%//must be included in the ParametersRequest structure.%//The key of the structure element must correspond to the name of the request parameter.%//A link to the unloaded document is available: DocumentForUnloading.'; es = '//Todos los parámetros de la solicitud, excepto el enlace al documento descargado,%//deben estar incluidos en la estructura Parámetros de la solicitud.%//La clave de la estructura debe corresponder al nombre del parámetro de la solicitud.%//El documento para descargar está disponible en el enlace: DocumentoParaDescargar.'; ka = '//ყველა მოთხოვნილი პარამეტრი, გარდა დოკუმენტის გამოტანის ბმულიდან,%//უნდა იყოს ჩარეული მოთხოვნის სტრუქტურაში.%//სტრუქტურის ელემენტის გასამართლებლად უნდა შეესაბამებდეს მოთხოვნის პარამეტრის სახელს.%//გამოტანის დოკუმენტზე ბმული: გამოტანის დოკუმენტი.'; kk = '//Сізге шығарылатын құжатқа сілтеме барлық сұрау параметрлері,%//Сұрау параметрлерінің элементінің аты сұрау параметрлерінің атымен сәйкес келуі керек.%//Шығарылатын құжатқа сілтеме: Шығарылатын құжат.'; ro = '//Toți parametrii cererii, cu excepția linkului către documentul exportat,%//trebuie să fie incluși în structura ParametriiCererei.%//Cheia elementului structurii trebuie să corespundă numelui parametrului cererii.%//Disponibil link către documentul exportat: DocumentPentruExport.'; ru = '//Все параметры запроса, кроме ссылки на выгружаемый документ,%//должны быть включены в структуру ПараметрыЗапроса.%//Ключ элемента структуры должен соответствовать имени параметра запроса.%//Структуру ПараметрыЗапроса отдельно объявлять не нужно.%//Пример добавления параметра:%//ПараметрыЗапроса.Вставить(""ИмяПараметраЗапроса"", ЗначениеПараметра); %//Доступна ссылка на выгружаемый документ: ДокументДляВыгрузки.'; tr = '//Yüklenecek belgeye bağlantı dışındaki tüm sorgu parametreleri,%//Sorgu Parametreleri yapısına dahil edilmelidir.%//Yapı eleman anahtarı, sorgu parametresinin adıyla eşleşmelidir.%//Yüklenecek belgeye bağlantı mevcut: Yüklenecek Belge.'; uk = '//Усі параметри запиту, крім посилання на вивантажуваний документ,%//повинні бути включені в структуру ПараметриЗапиту.%//Ключ елемента структури повинен відповідати імені параметра запиту.%//Доступне посилання на вивантажуваний документ: ДокументДляВивантажки.'; uz = '//Ўтказиш ҳужжатига қўйилган параметрлар, унча ҳолда, Қўйиш Сўровлари структурасига киритилиши керак.%//Структура элементи калити сўров параметри номига тенг бўлиши керак.%//Юкланган ҳужжатга қўйиш мавжуд: Юкланадиган ҳужжат.'");
		ТекстКодаПолучениеПараметров = СтрЗаменить(ТекстКодаПолучениеПараметров, "%", Символы.ПС);
	Конецесли;
	Подсказка = НСтр("be = 'Калі ласка, увядзіце код для атрымання параметраў запыту'; en = 'Enter a code to receive query parameters'; es = 'Ingrese el código para obtener los parámetros de la consulta'; ka = 'შეიყვანეთ კოდი პარამეტრების მისაღებად'; kk = 'Сұрау параметрлерін алу үшін код енгізіңіз'; ro = 'Introduceți codul pentru a obține parametrii interogării'; ru = 'Введите код для получения параметров запроса'; tr = 'Sorgu parametrelerini almak için kodu girin'; uk = 'Введіть код для отримання параметрів запиту'; uz = ""So'rov parametrlarini olish uchun kodni kiriting""");
	ПоказатьВводСтроки(ОповещениеВводаТекстаЗапроса, ТекстКодаПолучениеПараметров, Подсказка, , Истина); 
КонецПроцедуры

