				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	//Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли