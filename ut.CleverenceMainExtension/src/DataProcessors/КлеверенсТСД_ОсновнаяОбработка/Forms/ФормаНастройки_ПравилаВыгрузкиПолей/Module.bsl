&НаСервере
Функция ПроверитьКорректностьЗаполненияПолей()

	КонтрольПройден = Истина;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаРеквизитов;
	#Иначе
		ТЗ = РеквизитФормыВЗначение("ТаблицаРеквизитов");
	#КонецЕсли
	
	МассивПроверяемыхКолонок = Новый Массив;
	МассивПроверяемыхКолонок.Добавить("ТипПриемникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ПрЗначение");
	МассивПроверяемыхКолонок.Добавить("ТипИсточникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ИсЗначение");
	
	ОтмеченныеСтроки = ТЗ.НайтиСтроки(Новый Структура("Выгружать", Истина));
	Для каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
	
		Для Каждого ПроверяемаяКолонка Из МассивПроверяемыхКолонок Цикл
			ПроверяемоеЗначение = ОтмеченнаяСтрока[ПроверяемаяКолонка];
			Если Не ЗначениеЗаполнено(ПроверяемоеЗначение) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					ЭлементФормы = ЭтаФорма.Элементы.Найти("ТаблицаРеквизитов" + ПроверяемаяКолонка);
					Если ЭлементФормы <> Неопределено Тогда
						Заголовок = ЭлементФормы.Заголовок;
					Иначе
						Заголовок = ПроверяемаяКолонка;
					КонецЕсли;
					
					Сообщение = Новый СообщениеПользователю;
					Текст = НСтр("be = 'Не запоўнена значэнне ў калонцы %1'; en = 'Value is not filled in column %1'; es = 'No se ha completado el valor en la columna %1'; ka = 'შესავსები არ არის კოლონკა %1-ში'; kk = '%1 бағанды толтыруға болмайды'; ro = 'Valoarea nu este completată în coloana %1'; ru = 'Не заполнено значение в колонке %1'; tr = '%1 sütununda değer doldurulmadı'; uk = 'Не заповнено значення в колонці %1'; uz = '%1 ustunida qiymat kiritilmagan'");
					ОО = РеквизитФормыВЗначение("Объект");
					Текст = ОО.ГлЯдро_СтрШаблон(Текст, Заголовок);
					Сообщение.Текст = Текст;
					Сообщение.Поле = "ТаблицаРеквизитов[" + ТЗ.Индекс(ОтмеченнаяСтрока) + "]." + ПроверяемаяКолонка;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					НомерСтроки = ТЗ.Индекс(ОтмеченнаяСтрока) + 1;
					ТекстПредупреждения = НСтр("be = 'Не запоўнена значэнне ў калонцы %1 у радку %2'; en = 'Value is not filled in column %1 in row %2'; es = 'No se ha completado el valor en la columna %1 en la fila %2'; ka = 'შესავსები არ არის კოლონკა %1-ში, სტრიქონში %2-ში'; kk = '%1 бағанды толтыруға болмайды, %2 жолда'; ro = 'Valoarea nu este completată în coloana %1, în rândul %2'; ru = 'Не заполнено значение в колонке %1 в строке %2'; tr = '%2 satırındaki %1 sütununda değer doldurulmadı'; uk = 'Не заповнено значення в колонці %1 в рядку %2'; uz = '%2 qatorida %1 ustunida qiymat kiritilmagan'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТЗ.Колонки[ПроверяемаяКолонка].Заголовок, Строка(НомерСтроки));
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков()
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередВыгрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиДокумента");
	МассивТиповОбъектов.Добавить("ПослеОтправкиДокумента");
	МассивТиповОбъектов.Добавить("ПередВыгрузкойТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиТЧ");	
	МассивТиповОбъектов.Добавить("ПередВыгрузкойСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиСтрокиТЧ");	

	Возврат МассивТиповОбъектов;
	
КонецФункции

&НаКлиенте
Процедура ВидОбработчика_ЗаполнениеПоУмолчанию()
	
	// Для корректной интеграции в существующие настройки в случае заполненности обработчика устанавливаем его вид как "Свой обработчик"
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередВыгрузкойДокумента");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеВыгрузкиДокумента");		
		МассивИменРеквизитов.Добавить("Обработчик_ПослеОтправкиДокумента");		
		
		ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов);
		
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередВыгрузкойТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеВыгрузкиТабличнойЧасти");
		
		ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов)
	
	Для Каждого РеквизитОбработчика Из МассивИменРеквизитов Цикл
		
		РеквизитВидаОбработчика = СтрЗаменить(РеквизитОбработчика, "Обработчик", "ВидОбработчика");
		Если Не ПустаяСтрока(ЭтаФорма[РеквизитОбработчика]) Тогда
			Если Не ЗначениеЗаполнено(ЭтаФорма[РеквизитВидаОбработчика]) Тогда
				ЭтаФорма[РеквизитВидаОбработчика] = 2; // "Свой обработчик"
			КонецЕсли;
		Иначе
			ЭтаФорма[РеквизитВидаОбработчика] = 0; // "Без обработчика"
		КонецЕсли;
		
		Если ЭтаФорма[РеквизитВидаОбработчика] = 3 Тогда // "Произвольный код"
			
			// В обычных формах подменяем поле ввода обарботчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[РеквизитОбработчика].Видимость 			= Ложь;				
				Элементы[РеквизитОбработчика + "Выбор"].Видимость 	= Истина;					
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика + "Выбор"], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика + "Выбор"], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#Иначе
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#КонецЕсли
		Иначе 
			УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
		КонецЕсли;		

		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы[РеквизитВидаОбработчика].Значение = ЭтаФорма[РеквизитВидаОбработчика];
		#КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокаОбработчика, ЗначениеСтрокаОбработчика, КодВидаОбработчика)
	
	БезЗаполнения	= КодВидаОбработчика = 0;
	ПоУмолчанию		= КодВидаОбработчика = 1;
	СвойОбработчик	= КодВидаОбработчика = 2;	
	ПроизвольныйКод	= КодВидаОбработчика = 3;

	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементСтрокаОбработчика.РежимВыбораИзСписка	= ПроизвольныйКод;				
		ЭлементСтрокаОбработчика.КнопкаВыбора 			= ПроизвольныйКод;		    		
		ЭлементСтрокаОбработчика.КнопкаВыпадающегоСписка= Ложь;
	#Иначе
		ЭлементСтрокаОбработчика.Значение				= ЗначениеСтрокаОбработчика;
	#КонецЕсли                                          
	ЭлементСтрокаОбработчика.ТолькоПросмотр 			= ПоУмолчанию Или БезЗаполнения;     				
	ЭлементСтрокаОбработчика.ЦветТекста 				= ?(ПоУмолчанию, WebЦвета.Серый, Новый Цвет(51, 51, 51));
	ЭлементСтрокаОбработчика.Шрифт 						= Новый Шрифт(ЭлементСтрокаОбработчика.Шрифт,,,, ПоУмолчанию);
	
КонецПроцедуры

