&НаКлиенте
Процедура ВидОбработчика_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки = Элемент.Имя;
	Обработчик_ИзменитьЗначение = ЭтаФорма[ИмяЭлементаОбработки] <> ВыбранноеЗначение;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаПриИзменении(Элемент)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	СтруктураОбработчика	= СтруктураВидовОбработчиков[ИмяЭлементаОбработки];
	ИмяОбработчика			= СтруктураОбработчика.Тип; 
	СтрокаОбработчика		= СтруктураОбработчика.Обработчик;
	
	Элементы[СтрокаОбработчика].СписокВыбора.Очистить();
	
	БезЗаполнения	= ЭтаФорма[ИмяЭлементаОбработки] = 0;
	ПоУмолчанию		= ЭтаФорма[ИмяЭлементаОбработки] = 1;
	СвойОбработчик	= ЭтаФорма[ИмяЭлементаОбработки] = 2;	
	ПроизвольныйКод	= ЭтаФорма[ИмяЭлементаОбработки] = 3;
	
	Если ПоУмолчанию Тогда 		
		
		// Формируем стандартное имя процедуры
		ТипОбработчика = СтрЗаменить(ИмяОбработчика, "ТабличнойЧасти", "ТЧ") + ?(Не ПустаяСтрока(ИмяТабличнойЧасти1С), "_" + ?(ИмяТабличнойЧасти1С = "(Запрос)", "Запрос", ИмяТабличнойЧасти1С), "");
		ЭтаФорма[СтрокаОбработчика] = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика(ТипОбработчика, ТипДокумента1С);
		
	ИначеЕсли СвойОбработчик Тогда
		
		// Оставляем пустое строковое поле для ручного ввода имени процедуры, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
		КонецЕсли;
		
	ИначеЕсли ПроизвольныйКод Тогда
		
		// Очищаем строку обработчика и предоставляем возможность выбора из списка подходящих кодов, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
			
			// В обычных формах подменяем поле ввода обработчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[СтрокаОбработчика].Видимость = Ложь;
				Элементы[СтрокаОбработчика + "Выбор"].Видимость = Истина;
				Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Очистить();
				Элементы[СтрокаОбработчика + "Выбор"].ВыделенныйТекст = "";
			#КонецЕсли
			
			Элементы[СтрокаОбработчика].ВыделенныйТекст = "";					
		Иначе
			ТекЗначение = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ЭтаФорма[СтрокаОбработчика]);
			Если ТекЗначение <> Неопределено Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#Иначе
					Элементы[СтрокаОбработчика].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#КонецЕсли
			КонецЕсли;                                                                                             			
		КонецЕсли;					
		
	ИначеЕсли БезЗаполнения Тогда
		
		ЭтаФорма[СтрокаОбработчика] = "";	
		
	КонецЕсли;
	
	ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Возвращаем видимость поля ввода обработчика, если выбран не произвольный код
		Если Не ПроизвольныйКод Тогда
			Элементы[СтрокаОбработчика].Видимость = Истина;
			Элементы[СтрокаОбработчика + "Выбор"].Видимость = Ложь;							
		Иначе
			ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика + "Выбор"];		
		КонецЕсли;                                                                                                                             		    		
	#КонецЕсли
	
	УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокиОбработчика, ЭтаФорма[СтрокаОбработчика], ЭтаФорма[ИмяЭлементаОбработки]);
	
	Если Обработчик_ИзменитьЗначение Тогда
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаНачалоВыбораОбработчикаВыгрузки(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
		
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
	
		ПредыдущееЗначение 		= ЭтаФорма[ИмяЭлементаОбработки];		
		СтандартнаяОбработка 	= Ложь;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаСписка_ПроизвольныеКоды", ПредыдущееЗначение); 
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаОткрытиеОбработчикаВыгрузки(Элемент, СтандартнаяОбработка)
		
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
	
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
				
		СтандартнаяОбработка 	= Ложь;
		Если ПустаяСтрока(ЭтаФорма[ИмяЭлементаОбработки]) Тогда
			Возврат;
		КонецЕсли;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаНастройки_ПроизвольныйКод", ЭтаФорма[ИмяЭлементаОбработки], Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, ИмяФормыПК, ТекущееЗначение, ЭтоФормаЭлемента = Ложь) 
	
	ЭтоОбработчикЗаполнения = Ложь;
	ДопКлючНастройки 		= "";
	ДопТипОбработки			= "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды = ПолучитьФорму("ОФ_" + ИмяФормыПК, ЭтаФорма);
	#Иначе
		Форма_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма." + ИмяФормыПК, , ЭтаФорма, ЭтаФорма);
		Форма_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	Форма_ПроизвольныеКоды._ЛокКонтекст 			= _ЛокКонтекст;
	Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ВРЕГ(ИмяЭлементаОбработки), "ОБРАБОТЧИК_") <> 0 Тогда			
		ДопКлючНастройки							= ПолучитьКлючНастройкиОбработчикаВыгрузки(ИмяЭлементаОбработки);
		ДопТипОбработки								= СтрЗаменить(ДопКлючНастройки, "Выгрузка_", "");
		Форма_ПроизвольныеКоды.КлючНастройки 		= ДопКлючНастройки;			
		ЭтоОбработчикЗаполнения						= Истина;			
	Иначе
		Форма_ПроизвольныеКоды.КлючНастройки 		= КлючНастройки;
	КонецЕсли;
	Форма_ПроизвольныеКоды.ТипИсходногоДокумента1С 	= ТипДокумента1С;
	Форма_ПроизвольныеКоды.ИмяТабличнойЧасти1С 		= ИмяТабличнойЧасти1С;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= ТаблицаРеквизитовДополнительная;
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= ТаблицаРеквизитовДополнительная;
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
	КонецЕслИ;
	
	Если ЭтоФормаЭлемента Тогда
		Форма_ПроизвольныеКоды.ЭтоНоваяНастройка	= Ложь;				
		
		ТаблицаПроизвольныхКодов	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды", Истина);
		ДанныеПроизвольногоКода 	= _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ТаблицаПроизвольныхКодов, "ID_ПроизвольногоКода", ТекущееЗначение);
		
		ЗаполнитьЗначенияСвойств(Форма_ПроизвольныеКоды, ДанныеПроизвольногоКода);
	КонецЕсли; 
	
	ДопПараметрыОповещения = Новый Структура("ПредыдущееЗначение, СтрокаОбработчика, ДопТипОбработки, ЭтоОбработчикЗаполнения", 
		ТекущееЗначение, 
		ИмяЭлементаОбработки, 
		ДопТипОбработки,
		ЭтоОбработчикЗаполнения);
	
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие", ЭтаФорма, ДопПараметрыОповещения);
	Форма_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		Форма_ПроизвольныеКоды.Открыть();		
	#КонецЕсли 	

КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ОбновитьСписокПроизвольныхКодов(ДопПараметры.ДопТипОбработки);
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика + "Выбор";
	#Иначе
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	#КонецЕсли      	
	ИмяОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	
	Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.Очистить();
	
	ЗаполнитьСписокВыбора(Элементы[ИмяПоляОбработчикаСобытия], ?(ДопПараметры.ЭтоОбработчикЗаполнения, СписокПроизвольныхКодовОбработчиков, СписокПроизвольныхКодов));	
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Если ДопПараметры.ЭтоОбработчикЗаполнения Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		Иначе
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		КонецЕсли;
	Иначе 
		Если ДопПараметры.ЭтоОбработчикЗаполнения Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ВыбранноеЗначение);
		Иначе
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;		
	ИначеЕсли Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.НайтиПоЗначению(НайденныйЭлементСписка.Значение) = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;
	Иначе
		ЭтаФорма[ИмяОбработчикаСобытия] = НайденныйЭлементСписка.Значение;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИспользоватьВПредставленииПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущаяСтрока.ИспользоватьВПредставлении = Истина Тогда
			
			UniРеквизита = "";
			Для Каждого РеквизитМС Из СписокРеквизитовMS Цикл
				Если РеквизитМС.Значение = ТекущаяСтрока.ИмяПриемника Тогда
					UniРеквизита = РеквизитМС.Uni;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если UniРеквизита = "" Тогда 
				UniРеквизита = _ЛокКонтекст.ЛокЯдро_СтрокуВТранслитENG(ТекущаяСтрока.ИмяПриемника);
			КонецЕсли;
			
			ШаблонРеквизита = "{item."+UniРеквизита+"}";
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ШаблонВПредставлении) 
				Или _ЛокКонтекст.ЛокЯдро_СтрНайти(ТекущаяСтрока.ШаблонВПредставлении,ШаблонРеквизита) = 0 Тогда
				ТекущаяСтрока.ШаблонВПредставлении = ШаблонРеквизита;
			КонецЕсли;
		КонецЕсли;
	ОбновитьШаблон();
КонецПроцедуры

