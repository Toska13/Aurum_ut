&НаКлиенте
Функция ПроверитьКорректностьДобавленныхОбработчиков()
	
	КонтрольПройден = Истина;
	
	МассивВидовОбработчиков = Новый Массив;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередВыгрузкойДокумента, "ВидОбработчика_ПередВыгрузкойДокумента"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеВыгрузкиДокумента, "ВидОбработчика_ПослеВыгрузкиДокумента"));		
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеОтправкиДокумента, "ВидОбработчика_ПослеОтправкиДокумента"));		
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередВыгрузкойТабличнойЧасти, "ВидОбработчика_ПередВыгрузкойТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти, "ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти, "ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеВыгрузкиТабличнойЧасти, "ВидОбработчика_ПослеВыгрузкиТабличнойЧасти"));
	КонецЕсли;

	Для Каждого ВидОбработчика Из МассивВидовОбработчиков Цикл
		
		ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Обработчик;
		ТипОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Тип;
		
		// Проверка своего обработчика и произвольного кода на пустоту
		Если ВидОбработчика.Значение = 2 Или ВидОбработчика.Значение = 3 Тогда 						
			Если ПустаяСтрока(ЭтаФорма[ИмяОбработчика]) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("be = 'Апрацоўчык не запоўнены!'; en = 'Handler is not filled in!'; es = '¡Controlador no completado!'; ka = 'გამუშავების გამომტაცება არ არის შევსებული!'; kk = 'Өңдеуші толтырылмаған!'; ro = 'Procesorul nu este completat!'; ru = 'Обработчик не заполнен!'; tr = 'İşlemci boş bırakılamaz!'; uk = 'Обробник не заповнений!'; uz = ""Muhandis to'ldirilmagan!""");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("be = 'Не запоўнены свой апрацоўнік <%1>!'; en = 'Your handler <%1> is not filled in!'; es = '¡No se ha completado el controlador personalizado <%1>!'; ka = 'თქვენი დამატების მეთოდი <%1> არ არის შევსებული!'; kk = 'Сіздің өңдеушіңіз <%1> толтырылмаған!'; ro = 'Handlerul propriu nu este completat <%1>!'; ru = 'Не заполнен свой обработчик <%1>!'; tr = 'Kendi işleyiciniz <%1> doldurulmadı!'; uk = 'Не заповнений власний обробник <%1>!'; uz = ""O'z xizmat ko'rsatuvchisi to'ldirilmagan <%1>!""");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 					
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		// Проверка своего обработчика на наличие в интеграционной обработке
		Если ВидОбработчика.Значение = 2 Тогда
			СтруктураПараметров = Новый Структура("АдресаПеременных, ДанныеДляЗагрузки_Строка, ДанныеДокументаMS, Док1СОснование, Док1СРезультат, ДокументТСД, СтрокаДокумента, СтрокаНастройки, СтруктураПоискаКлючаСвязи, ТЧ, ТекущиеНастройкиMS");
			РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ЭтаФорма[ИмяОбработчика], СтруктураПараметров);
			
			Если Не РезультатПроверки.Статус Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("be = 'Апрацоўчык не знойдзены ў падключанай інтэграцыйнай апрацоўцы!'; en = 'Handler not found in connected integration processing!'; es = '¡Controlador no encontrado en el procesamiento de integración conectado!'; ka = 'გამუშავების გამომტაცება არ მოიძებნა დაკავშირებულ ინტეგრაციულ დამუშავებაში!'; kk = 'Өңдеуші қосылған интеграциялық өңдеуде табылмады!'; ro = 'Procesorul nu a fost găsit în procesarea integrată conectată!'; ru = 'Обработчик не найден в подключенной интеграционной обработке!'; tr = 'Bağlı entegrasyon işlemcilerinde işlemci bulunamadı!'; uk = 'Обробник не знайдений у підключеній інтеграційній обробці!'; uz = ""Qo'shilgan integratsiya ishlovda muhandis topilmadi!""");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("be = 'Не знойдзены свой апрацоўнік <%1> у падключанай інтэграцыйнай апрацоўцы!'; en = 'Own handler <%1> not found in the connected integration process!'; es = 'No se encontró su controlador <%1> en el procesamiento de integración conectado!'; ka = 'თქვენი დამატების მემკვიდრე <%1> ვერ მოიძებნა დაკავშირებულ ინტეგრაციულ დამუშავებაში!'; kk = 'Тіркелген интеграциялық өңдеуші <%1> табылмады!'; ro = 'Nu a fost găsit propriul handler <%1> în procesul de integrare conectat!'; ru = 'Не найден свой обработчик <%1> в подключенной интеграционной обработке!'; tr = 'Bağlı entegrasyon işleminde <%1> işleyici bulunamadı!'; uk = 'Не знайдений власний обробник <%1> в підключеній інтеграційній обробці!'; uz = '<%1> илова ишловчиси топилмади интеграция ишловчисида!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли; 			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКлючНастройкиОбработчикаВыгрузки(ИмяЭлемента)
	
	ИмяКлючаНастройки = "";
	
	Если ИмяЭлемента = "Обработчик_ПередВыгрузкойДокумента" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПередВыгрузкойДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеВыгрузкиДокумента" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеВыгрузкиДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеОтправкиДокумента" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеОтправкиДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередВыгрузкойТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПередВыгрузкойТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеВыгрузкиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеВыгрузкиТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПередВыгрузкойСтрокиТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеВыгрузкиСтрокиТЧ";
	КонецЕсли;		
	
	Возврат ИмяКлючаНастройки;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставленияСпискаДокументов1С()
	
	Для каждого Реквизит1С ИЗ СписокРеквизитов1С Цикл
		Если ЗначениеЗаполнено(Реквизит1С.Значение) И НЕ ЗначениеЗаполнено(Реквизит1С.Представление) Тогда
			Реквизит1С.Представление = Реквизит1С.Значение;					
		КонецЕсли;					
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьШаблон()
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		ШаблонИмени = "";
		
		Если ЗаменитьПредставлениеДокументаПриВыгрузке Тогда
			СтрокаШаблона = "";
			ВключенныеРеквизиты = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Выгружать,ИспользоватьВПредставлении", Истина,Истина));
			Для Каждого ВключенныйРеквизит Из ВключенныеРеквизиты Цикл
				СтрокаШаблона = СтрокаШаблона+?(СтрокаШаблона = "",""," ")+ВключенныйРеквизит.ШаблонВПредставлении;
			КонецЦикла;
			ШаблонИмени  = СтрокаШаблона;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ВведитеТекстКодаПолучениеПараметров(Текст, Контекст) Экспорт
	
	Если ЗначениеЗаполнено(Текст) Тогда
		ТекстКодаПолучениеПараметров = Текст;
	КонецЕсли; 	
	УстановитьЦветаЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыЗакрытие(ВыбранноеЗначение,ПредыдущееЗначение) Экспорт
	ОбновитьСписокПроизвольныхКодов();
	
	Если ВыбранноеЗначение = Неопределено Тогда
		НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ПредыдущееЗначение);
	Иначе 
		НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ВыбранноеЗначение);
	КонецЕсли;
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИсЗначение = Неопределено;
	Иначе
		ТекущаяСтрока.ИмяИсточника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ИсЗначение = НайденныйЭлементСписка.Представление;
		текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		#Иначе
			Элемент = Элементы.ТаблицаРеквизитов.ТекущийЭлемент;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
			Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
		#КонецЕсли
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСлужебная_РедактированиеТекстаЗапросаЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ТекстЗапросаВыгрузкиНаТСД = СокрЛП(РезультатРедактирования.ТекстЗапроса);
	КонецЕсли;		
	
	СписокРеквизитов1С = фЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);	
	
	УстановитьЦветаЭлементов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуРеквизитовПоУмолчанию();

КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
