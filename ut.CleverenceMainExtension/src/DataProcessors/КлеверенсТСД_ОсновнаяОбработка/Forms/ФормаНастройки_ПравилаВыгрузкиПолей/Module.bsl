&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Если Не ПроверитьКорректностьДобавленныхОбработчиков() Тогда
		Возврат;
	КонецЕсли;	

	Если Не ПроверитьКорректностьЗаполненияПолей() Тогда
		Возврат;
	КонецЕсли;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаНастроек", 			_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов));
	Результат.Вставить("ТекстЗапросаВыгрузкиНаТСД", ТекстЗапросаВыгрузкиНаТСД);
	Результат.Вставить("ТекстКодаПолучениеПараметров", ТекстКодаПолучениеПараметров);
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		
		Результат.Вставить("ВидОбработчика_ПередВыгрузкойДокумента", 		ВидОбработчика_ПередВыгрузкойДокумента);
		Результат.Вставить("ВидОбработчика_ПослеВыгрузкиДокумента",  		ВидОбработчика_ПослеВыгрузкиДокумента);
		Результат.Вставить("ВидОбработчика_ПослеОтправкиДокумента",  		ВидОбработчика_ПослеОтправкиДокумента);
		
		Результат.Вставить("Обработчик_ПередВыгрузкойДокумента", 			Обработчик_ПередВыгрузкойДокумента);
		Результат.Вставить("Обработчик_ПослеВыгрузкиДокумента",  			Обработчик_ПослеВыгрузкиДокумента);		
		Результат.Вставить("Обработчик_ПослеОтправкиДокумента",  			Обработчик_ПослеОтправкиДокумента);		
		
		Результат.Вставить("ЗаменитьПредставлениеДокументаПриВыгрузке",		ЗаменитьПредставлениеДокументаПриВыгрузке);
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		
		Результат.Вставить("ВидОбработчика_ПередВыгрузкойТабличнойЧасти",       	ВидОбработчика_ПередВыгрузкойТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти", 	ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти",  	ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеВыгрузкиТабличнойЧасти",        	ВидОбработчика_ПослеВыгрузкиТабличнойЧасти);
		
		Результат.Вставить("Обработчик_ПередВыгрузкойТабличнойЧасти",       		Обработчик_ПередВыгрузкойТабличнойЧасти);
		Результат.Вставить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти", 		Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти",  		Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеВыгрузкиТабличнойЧасти",        		Обработчик_ПослеВыгрузкиТабличнойЧасти);
		
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
		Закрыть();
	#Иначе
		Закрыть(Результат);
	#КонецЕсли
КонецПроцедуры

