&НаКлиенте 
Процедура ОбновитьСтруктуруТабличныхЧастей()
	
	КолонкиТабличныхЧастей = ПолучитьСтруктуруТабличнойЧасти();
	
	Для Каждого Элемент Из ТабличныеЧасти Цикл
		
		Если Элемент.Свойство("ЭтоТаблицаЗначений") И Элемент.ЭтоТаблицаЗначений Тогда			
			Для Каждого Колонка Из КолонкиТабличныхЧастей Цикл
				Если _ЛокКонтекст.ЛокЯдро_СтрНайти(Элемент.КолонкиТаблицыЗначений, Колонка.Ключ) = 0 Тогда
					Элемент.КолонкиТаблицыЗначений = Элемент.КолонкиТаблицыЗначений + "," + Колонка.Ключ;
				КонецЕсли;				
			КонецЦикла;                      						
			Продолжить;	
		КонецЕсли;
		
		Для Каждого Колонка Из КолонкиТабличныхЧастей Цикл
			Если Не Элемент.Свойство(Колонка.Ключ) Тогда
				Элемент.Вставить(Колонка.Ключ);
			КонецЕсли;				
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	
	Для каждого Строка Из ОтображаемыеТабличныеЧасти Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ТабличнаяЧастьДокументаMS) Тогда							
			ТекстПредупреждения = НСтр("be = 'Перад даданнем новай радкі трэба запоўніць таблічныя часткі Cleverence ў існуючых радках'; en = 'Before adding a new row, fill in Cleverence table parts for existing rows'; es = 'Antes de agregar una nueva fila, es necesario completar las partes de tabla de Cleverence en las filas existentes'; ka = 'ახალი სტრიქონის დამატებამდე უნდა შევავსოთ Cleverence-ის ცხრილები არსებული სტრიქონებისთვის'; kk = 'Жаңа жолды қосу алдында Cleverence тізімдік бөлімдерін толтыру керек'; ro = 'Înainte de adăugarea unui nou rând, trebuie să completați părțile tabelei Cleverence la rândurile existente'; ru = 'Перед добавлением новой строки нужно заполнить табличные части Клеверенс у существующих строк'; tr = 'Yeni satır eklemeden önce mevcut satırlarda Cleverence tablo kısımlarını doldurun'; uk = 'Перед додаванням нового рядка потрібно заповнити табличні частини Cleverence у існуючих рядках'; uz = 'Янги қатор қўшишдан олдин, мавжуд Cleverence қаторларини тўлиқ тўлдириш керак'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		КонецЕсли; 			
	КонецЦикла; 
	
	НоваяСтрока = ОтображаемыеТабличныеЧасти.Добавить();
	НоваяСтрока.Настроить 					  = НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
	НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = Ложь;
	НоваяСтрока.ВыгружатьСтрокиПоУсловию 	  = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
	
	Если Копирование Тогда
		
		ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , "ТабличнаяЧастьДокументаMS,ТабличнаяЧастьДокументаMSПредставление");		
		
		//НайдСтроки = ТабличныеЧасти.НайтиСтроки(Новый Структура("ТабличнаяЧастьДокументаMS", ТекущаяСтрока.ТабличнаяЧастьДокументаMS));	
		Икс = 1;ВсегоКоличество = ТабличныеЧасти.Количество();
		Пока Икс < ВсегоКоличество Цикл
			СтрокаПоиска = ТабличныеЧасти[Икс];
			Если СтрокаПоиска.ТабличнаяЧастьДокументаMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда									
				СтрокаТЧ = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаПоиска);
				СтрокаТЧ.НастройкаТЧСтрокой = "";
				ТабличныеЧасти.Добавить(СтрокаТЧ);
			КонецЕсли;
			Икс = Икс + 1;
		КонецЦикла;
		
		Если СвязиТабличныхЧастей <> Неопределено Тогда
			Икс = 1;ВсегоКоличество = СвязиТабличныхЧастей.Количество();
			Пока Икс < ВсегоКоличество Цикл
				СтрокаПоиска = СвязиТабличныхЧастей[Икс];
				Если СтрокаПоиска.ТабличнаяЧастьДокументаMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда									
					СтрокаТЧ = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаПоиска);
					СтрокаТЧ.ТабличнаяЧастьДокументаMS = "";
					СвязиТабличныхЧастей.Добавить(СтрокаТЧ);
				КонецЕсли;
				Икс = Икс + 1;
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиПередНачаломИзменения(Элемент, Отказ)

	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Очистить();
	ТабличнаяЧастьДокументаMSПредыдущееЗначение = ТекущаяСтрока.ТабличнаяЧастьДокументаMS;
	
	Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить(ПредставлениеТабличнойЧастиДокументаMS(ТабличнаяЧастьДокументаMSПредыдущееЗначение));
	ЗаполнитьСписокВыбора(Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора, ПолучитьСписокВыбораТабличныхЧастейMS());
	
	НастройкаТЧСтрокойПредыдущееЗначение		= ТекущаяСтрока.НастройкаТЧСтрокой;
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	
	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	УдалитьСтрокиПодчиненныхТабличныхЧастей(ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
	
	ОтображаемыеТабличныеЧасти.Удалить(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMSПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMSПоПредставлению(ТекущаяСтрока.ТабличнаяЧастьДокументаMSПредставление);
	
	Если ТабличнаяЧастьДокументаMSПредыдущееЗначение = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда
		Возврат;			
	КонецЕсли;	
	
	ИзменитьВладельцаПодчиненныхТабличныхЧастей(ТабличнаяЧастьДокументаMSПредыдущееЗначение, ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
	
	ТабличнаяЧастьДокументаMSПредыдущееЗначение = ТекущаяСтрока.ТабличнаяЧастьДокументаMS;
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиНастройкаТЧСтрокойПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НастройкаТЧСтрокойПредыдущееЗначение = ТекущаяСтрока.НастройкаТЧСтрокой Тогда
		Возврат;			
	КонецЕсли;	
	
	УдалитьСтрокиПодчиненныхТабличныхЧастей(ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
	
	ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(ТекущаяСтрока.НастройкаТЧСтрокой, 1) = "(" ИЛИ ПустаяСтрока(ТекущаяСтрока.НастройкаТЧСтрокой),
		Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(ТекущаяСтрока.НастройкаТЧСтрокой));
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловию		  = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = Ложь;
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = "";
	
	Если НЕ Найти(ВРег(СокрЛП(ТекущаяСтрока.НастройкаТЧСтрокой)), ВРег(СокрЛП(НесколькоТабличныхЧастей))) Тогда
		НоваяСтруктура = ПолучитьСтруктуруТабличнойЧасти();
		ЗаполнитьЗначенияСвойств(НоваяСтруктура, ТекущаяСтрока);
		НоваяСтруктура.Настроить 					 = НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
		НоваяСтруктура.ТабличнаяЧастьДокумента1С 	 = Неопределено;
		НоваяСтруктура.ТекстЗапросаВыгрузкиНаТСД 	 = Неопределено;
		НоваяСтруктура.ТекстКодаПолучениеПараметров  = Неопределено;
		
		ТабличныеЧасти.Добавить(НоваяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		КолонкаИмя = Элемент.ТекущаяКолонка.Имя;
	#Иначе
		КолонкаИмя = Элемент.ТекущийЭлемент.Имя;	
	#КонецЕсли
	
	ИмяКолонкиНастройкаПолей  = ВРег(СокрЛП("ОтображаемыеТабличныеЧастиНастроить"));
	ИмяКолонкиУсловияВыгрузки = ВРег(СокрЛП("ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию"));
	
	Если ВРег(СокрЛП(КолонкаИмя)) <> ИмяКолонкиНастройкаПолей
		И ВРег(СокрЛП(КолонкаИмя)) <> ИмяКолонкиУсловияВыгрузки Тогда
		Возврат;			
	КонецЕсли; 
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиУсловияВыгрузки Тогда
		Если НЕ ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных Тогда
			ТекстПредупреждения = НСтр("be = 'Наладка даступна толькі для таблічных частак з метададзеных канфігурацыі 1С'; en = 'Configuration is only available for table parts from the metadata of 1C configuration'; es = 'La configuración solo está disponible para partes tabulares de los metadatos de la configuración de 1C'; ka = 'დაყენება ხდება მხოლოდ 1C-ის კონფიგურაციის ცხრილის ნაწილებისთვის'; kk = 'Табелді бөліктердің метадеректерінен 1С конфигурациясына тек қосылу мүмкін'; ro = 'Configurarea este disponibilă doar pentru părțile tabelei din metadatele configurației 1C'; ru = 'Настройка доступна только для табличных частей из метаданных конфигурации 1С'; tr = 'Yapılandırma, 1C yapılandırma verilerinden sadece tablo bölümleri için kullanılabilir'; uk = 'Налаштування доступна лише для табличних частин з метаданих конфігурації 1С'; uz = 'Sozlash faqat 1С konfiguratsiyasining metadatalaridan jadval qismlari uchun mavjud'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокументаMS) Тогда
		ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента Cleverence'; en = 'No table part of Cleverence document selected'; es = 'No se ha seleccionado la parte de tabla del documento Cleverence'; ka = 'არ არის არჩეული Cleverence-ის ცხრილის ნაწილი'; kk = 'Cleverence документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului Cleverence'; ru = 'Не выбрана табличная часть документа Клеверенс'; tr = 'Cleverence belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа Cleverence'; uz = 'Cleverence hujjati jadvallar qismi tanlanmagan'");
		ПоказатьПредупреждение(, ТекстПредупреждения); 
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.НастройкаТЧСтрокой) Тогда
		ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента 1С'; en = 'No table part of 1C document selected'; es = 'No se ha seleccionado la parte de tabla del documento 1C'; ka = 'არ არის არჩეული 1C-ის ცხრილის ნაწილი'; kk = '1С документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului 1C'; ru = 'Не выбрана табличная часть документа 1С'; tr = '1C belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа 1С'; uz = '1C hujjati jadvallar qismi tanlanmagan'");
		ПоказатьПредупреждение(, ТекстПредупреждения); 
		Возврат;	
	КонецЕсли; 
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиУсловияВыгрузки Тогда
		
		НайдСтрока = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ТабличныеЧасти, "ТабличнаяЧастьДокументаMS", ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ = ПолучитьФорму("ОФ_ФормаНастройки_УсловияУдаленияСтрокТЧ", ЭтаФорма);
		#Иначе
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_УсловияУдаленияСтрокТЧ",, ЭтаФорма, ЭтаФорма);
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
