&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ТаблицаРеквизитовДополнительная Экспорт,
	ТабличныеЧасти Экспорт,
	СвязиТабличныхЧастей Экспорт,
	НесколькоТабличныхЧастей,
	ТабличнаяЧастьДокументаMSПредыдущееЗначение,
	НастройкаТЧСтрокойПредыдущееЗначение,
	ПредставленияТабЧастейMS;

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	Результат = Новый Структура;
	Результат.Вставить("ТабличныеЧасти", 		ТабличныеЧасти);	
	Результат.Вставить("СвязиТабличныхЧастей", 	СвязиТабличныхЧастей);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли

	Закрыть(Результат);	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекущийЯзык = ТекущийЯзык();
	КодЯзыка = ?(ТипЗнч(ТекущийЯзык) = Тип("Строка"), ТекущийЯзык, ТекущийЯзык.КодЯзыка);
	ПредставленияТабЧастейMS = Новый СписокЗначений;
	ПредставленияТабЧастейMS.Добавить("СтрокиПлан", ?(КодЯзыка = "ru", "Строки план", "Declared items"));
	ПредставленияТабЧастейMS.Добавить("СтрокиФакт", ?(КодЯзыка = "ru", "Строки факт", "Current items"));
	ПредставленияТабЧастейMS.Добавить("СерииПлан", ?(КодЯзыка = "ru", "Серии план", "Declared series"));
	ПредставленияТабЧастейMS.Добавить("СерииФакт", ?(КодЯзыка = "ru", "Серии факт", "Current series"));
	ПредставленияТабЧастейMS.Добавить("СерийныеНомераПлан", ?(КодЯзыка = "ru", "Серийные номера план", "Declared serial numbers"));
	ПредставленияТабЧастейMS.Добавить("СерийныеНомераФакт", ?(КодЯзыка = "ru", "Серийные номера факт", "Current serial numbers"));
	
	НесколькоТабличныхЧастей = НСтр("be = 'Некалькі таблічных частак'; en = 'Several table parts'; es = 'Varios partes de tablas'; ka = 'რამდენიმე ცხრილის ნაწილი'; kk = 'Бірнеше кестелік бөліктер'; ro = 'Mai multe părți de tabel'; ru = 'Несколько табличных частей'; tr = 'Birden fazla tablo bölümü'; uk = 'Декілька табличних частин'; uz = 'Bir nechta jadval qismi'");
		
	ЗаполнитьСписокВыбора(Элементы.ОтображаемыеТабличныеЧастиНастройкаТЧСтрокой.СписокВыбора,ПолучитьСписокТабличныхЧастей1С());		
	ЗаполнитьСписокВыбора(Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора,ПолучитьСписокВыбораТабличныхЧастейMS());
	
	ЗаполнитьОтображаемыеТабличныеЧасти();
	ОбновитьСтруктуруТабличныхЧастей();
	ОбновитьПредставленияВТабличнойЧасти();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Приемник,Список)
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение,Элем.Представление);	
	КонецЦикла;
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПредставлениеТабличнойЧастиДокументаMS(ТабличнаяЧастьДокументаMS)
	
	ЭлементПредставления = ПредставленияТабЧастейMS.НайтиПоЗначению(ТабличнаяЧастьДокументаMS);
	Возврат ?(ЭлементПредставления = Неопределено, ТабличнаяЧастьДокументаMS, ЭлементПредставления.Представление);
	
КонецФункции

&НаКлиенте
Функция ТабличнаяЧастьДокументаMSПоПредставлению(ПредставлениеТабличнойЧастиДокументаMS)
	
	Для каждого ЭлементСЗ Из ПредставленияТабЧастейMS Цикл
		Если ЭлементСЗ.Представление = ПредставлениеТабличнойЧастиДокументаMS Тогда
			Возврат ЭлементСЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПредставлениеТабличнойЧастиДокументаMS;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставленияВТабличнойЧасти()
	
	Для каждого Строка Из ОтображаемыеТабличныеЧасти Цикл
		ЭлементПредставления = ПредставленияТабЧастейMS.НайтиПоЗначению(Строка.ТабличнаяЧастьДокументаMS);
		Строка.ТабличнаяЧастьДокументаMSПредставление = ПредставлениеТабличнойЧастиДокументаMS(Строка.ТабличнаяЧастьДокументаMS);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастей1С()
	
	СписокТЧ = Новый СписокЗначений;
	Для Каждого ЭлементТЧ Из СтруктураДокумента1С.ТабличныеЧасти Цикл
		СписокТЧ.Добавить(ЭлементТЧ.Значение.Имя, ЭлементТЧ.Значение.Синоним);
	КонецЦикла;
	Если СписокТЧ.НайтиПоЗначению("(Запрос)") = Неопределено Тогда
		СписокТЧ.Добавить("(Запрос)", "(Запрос)");
	КонецЕсли;
	Если СписокТЧ.НайтиПоЗначению("(" + НесколькоТабличныхЧастей + ")") = Неопределено Тогда
		СписокТЧ.Добавить("(" + НесколькоТабличныхЧастей + ")", "(" + НесколькоТабличныхЧастей + ")");
	КонецЕсли;
	
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено Тогда
		Для Каждого КлючЗначение Из СписокДополнительныхОбработчиков Цикл
			Синоним = ?(КлючЗначение.Значение.Свойство("Синоним"),КлючЗначение.Значение.Синоним,КлючЗначение.Ключ);
			СписокТЧ.Добавить(КлючЗначение.Ключ,Синоним);	
		КонецЦикла;
	КонецЕсли;
	
	СписокТЧ.СортироватьПоПредставлению();
	
	Возврат СписокТЧ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастейMS()
	
	СписокТЧ = Новый СписокЗначений;
	
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СтрокиПлан"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СтрокиФакт"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерииПлан"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерииФакт"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерийныеНомераПлан"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерийныеНомераФакт"));
		
	СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
	
	Для Каждого ДопТаблица Из СписокДопТаблиц Цикл		
		СписокТЧ.Добавить(ДопТаблица.Представление);		
	КонецЦикла;	
	
	Возврат СписокТЧ;
	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьОтображаемыеТабличныеЧасти()
	
	СписокТабличныхЧастей1С = Элементы.ОтображаемыеТабличныеЧастиНастройкаТЧСтрокой.СписокВыбора;
	ТЧДокументаMS = Новый Массив;
	Если ТабличныеЧасти = Неопределено Тогда
		ТабличныеЧасти = Новый Массив;
	КонецЕсли;
	Для каждого Строка Из ТабличныеЧасти Цикл
		Если Строка.Свойство("ЭтоТаблицаЗначений")
			ИЛИ ТЧДокументаMS.Найти(Строка.ТабличнаяЧастьДокументаMS) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТЧДокументаMS.Добавить(Строка.ТабличнаяЧастьДокументаMS);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧастьДокументаMS Из ТЧДокументаMS Цикл
		НайдСтроки = Новый Массив;
		Для Каждого СтрокаПоиска Из ТабличныеЧасти Цикл
			Если НЕ СтрокаПоиска.Свойство("ЭтоТаблицаЗначений")
				И СтрокаПоиска.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS Тогда
				НайдСтроки.Добавить(СтрокаПоиска);
			КонецЕсли	
		КонецЦикла;
		Если НайдСтроки.Количество() = 1 Тогда
			НайдСтрока = НайдСтроки[0];
			НоваяСтрока = ОтображаемыеТабличныеЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
			Если НайдСтрока.ТабличнаяЧастьДокумента1С<>Неопределено
				И НайдСтрока.ТабличнаяЧастьДокумента1С.Количество() Тогда
				НоваяСтрока.Настроить = НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");
			Иначе
				НоваяСтрока.Настроить = НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
			КонецЕсли;
			
			НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(НоваяСтрока.НастройкаТЧСтрокой, 1) = "(" ИЛИ ПустаяСтрока(НоваяСтрока.НастройкаТЧСтрокой),
				Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(НоваяСтрока.НастройкаТЧСтрокой));
			Если НайдСтрока.Свойство("ВыгружатьСтрокиПоУсловиюФлаг") И НайдСтрока.ВыгружатьСтрокиПоУсловиюФлаг = Истина Тогда
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'");
			Иначе
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
			КонецЕсли;
		Иначе
			НастройкаТЧСтрокой = "(" + НесколькоТабличныхЧастей + ": ";
			Для каждого НайдСтрока Из НайдСтроки Цикл
				НастройкаТЧСтрокой = НастройкаТЧСтрокой + НайдСтрока.НастройкаТЧСтрокой + ", ";														
			КонецЦикла; 
			НастройкаТЧСтрокой = Лев(НастройкаТЧСтрокой, СтрДлина(НастройкаТЧСтрокой) - 2) + ")";			
			НоваяСтрока = ОтображаемыеТабличныеЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
			НоваяСтрока.НастройкаТЧСтрокой = НастройкаТЧСтрокой;
			Если СписокТабличныхЧастей1С.НайтиПоЗначению(НастройкаТЧСтрокой) = Неопределено Тогда
				СписокТабличныхЧастей1С.Добавить(НастройкаТЧСтрокой, НастройкаТЧСтрокой);
			КонецЕсли;
			флНастроено = Ложь;
			Для каждого НайдСтрока Из НайдСтроки Цикл
				Если НайдСтрока.Свойство("ТабличнаяЧастьДокумента1С")
				 	И ТипЗнч(НайдСтрока.ТабличнаяЧастьДокумента1С) = Тип("Массив")
				 	И НайдСтрока.ТабличнаяЧастьДокумента1С.Количество() Тогда
					флНастроено = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			Если флНастроено Тогда
				НоваяСтрока.Настроить = НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");
			Иначе
				НоваяСтрока.Настроить = НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
			КонецЕсли;
			
			НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = Ложь;
			НоваяСтрока.ВыгружатьСтрокиПоУсловию 	  = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
		КонецЕсли;
	КонецЦикла; 		
	
	СписокТабличныхЧастей1С.СортироватьПоПредставлению();
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьСписокВыбораТабличныхЧастейMS()
	
	СписокТабличныхЧастейMS = ПолучитьСписокТабличныхЧастейMS();
	
	Для Каждого Строка Из ОтображаемыеТабличныеЧасти Цикл
		НайденныйЭлемент = СписокТабличныхЧастейMS.НайтиПоЗначению(Строка.ТабличнаяЧастьДокументаMSПредставление);
		Если НайденныйЭлемент <> Неопределено Тогда
			СписокТабличныхЧастейMS.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокТабличныхЧастейMS;
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиПодчиненныхТабличныхЧастей(ТабличнаяЧастьДокументаMS)
	
	Икс = ТабличныеЧасти.Количество();
	Пока Икс > 0 Цикл
		Икс = Икс - 1;
		Если ТабличныеЧасти[икс].Свойство("ТабличнаяЧастьДокументаMS") и ТабличныеЧасти[икс].ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS Тогда
			ТабличныеЧасти.Удалить(Икс);	
		КонецЕсли;
	КонецЦикла;

	Если СвязиТабличныхЧастей <> Неопределено Тогда
		Икс = СвязиТабличныхЧастей.Количество();
		Пока Икс > 1 Цикл
			Икс = Икс - 1;
			Если СвязиТабличныхЧастей[икс].ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS Тогда
				СвязиТабличныхЧастей.Удалить(Икс);	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВладельцаПодчиненныхТабличныхЧастей(ТабличнаяЧастьДокументаMSПредыдущееЗначение, ТабличнаяЧастьДокументаMS);

	Для Каждого ЭлементМассива Из ТабличныеЧасти Цикл
		Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") 
			ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMSПредыдущееЗначение Тогда
			Продолжить;
		КонецЕсли;
		ЭлементМассива.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;
	КонецЦикла;
 
	Если СвязиТабличныхЧастей <> Неопределено Тогда
		Для Каждого ЭлементМассива Из СвязиТабличныхЧастей Цикл
			Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") 
				ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMSПредыдущееЗначение Тогда
				Продолжить;
			КонецЕсли;
			ЭлементМассива.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруТабличнойЧасти()
	
	НоваяСтруктура = Новый Структура;
	НоваяСтруктура.Вставить("ТабличнаяЧастьДокументаMS");
	НоваяСтруктура.Вставить("НастройкаТЧСтрокой");
	НоваяСтруктура.Вставить("Настроить");
	НоваяСтруктура.Вставить("ТабличнаяЧастьДокумента1С");
