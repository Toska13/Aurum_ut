					ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMS Тогда
					Продолжить;
				КонецЕсли;
				НайдСтрока = ЭлементМассива;
				Прервать;
			КонецЦикла;
		КонецЕсли;	
				
		НайдСтрока.Вставить("ТабличнаяЧастьДокумента1С",							РезультатРедактирования.ТаблицаНастроек);		
		НайдСтрока.Вставить("ТекстЗапросаВыгрузкиНаТСД",							РезультатРедактирования.ТекстЗапросаВыгрузкиНаТСД);		
		НайдСтрока.Вставить("ТекстКодаПолучениеПараметров",							РезультатРедактирования.ТекстКодаПолучениеПараметров);				
		НайдСтрока.Вставить("ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти",	РезультатРедактирования.ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПередВыгрузкойТабличнойЧасти",			РезультатРедактирования.ВидОбработчика_ПередВыгрузкойТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти",		РезультатРедактирования.ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПослеВыгрузкиТабличнойЧасти",			РезультатРедактирования.ВидОбработчика_ПослеВыгрузкиТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",	Неопределено);
		НайдСтрока.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти",		Неопределено);
		НайдСтрока.Вставить("Обработчик_ПередВыгрузкойТабличнойЧасти",				РезультатРедактирования.Обработчик_ПередВыгрузкойТабличнойЧасти);
		НайдСтрока.Вставить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти",		РезультатРедактирования.Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти",			РезультатРедактирования.Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("Обработчик_ПослеВыгрузкиТабличнойЧасти",				РезультатРедактирования.Обработчик_ПослеВыгрузкиТабличнойЧасти);		
		НайдСтрока.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти",		Неопределено);
		НайдСтрока.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти",			Неопределено);		
		НайдСтрока.Вставить("Настроить",											"Настроено");
		
		ТекущаяСтрока.Настроить	= НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");   		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_СвязиВыгрузкиТЧЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		УдалитьСтрокиПодчиненныхТабличныхЧастей(ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
		
		НастройкаТЧСтрокой = "(" + НесколькоТабличныхЧастей + ": ";			
		
		КоличествоТабличныхЧастей = 0;
		
		Для каждого Строка Из РезультатРедактирования.ТабличныеЧасти Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ПолучитьСтруктуруТабличнойЧасти();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ТабличнаяЧастьДокумента1С = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(Строка.ТабличнаяЧастьДокумента1ССтрокой);
										
			ТабличныеЧасти.Добавить(НоваяСтрока);					
			НастройкаТЧСтрокой = НастройкаТЧСтрокой + Строка.НастройкаТЧСтрокой + ", ";
			
			КоличествоТабличныхЧастей = КоличествоТабличныхЧастей + 1;
		КонецЦикла; 
		
		НастройкаТЧСтрокой = Лев(НастройкаТЧСтрокой, СтрДлина(НастройкаТЧСтрокой) - 2) + ")";						
		
		Если КоличествоТабличныхЧастей = 1 Тогда 
			Для каждого Строка Из РезультатРедактирования.ТабличныеЧасти Цикл
				Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				НастройкаТЧСтрокой = Строка.НастройкаТЧСтрокой;
			КонецЦикла;
		КонецЕсли; 	
		
		ТекущаяСтрока.НастройкаТЧСтрокой 	= НастройкаТЧСтрокой; 					
		ТекущаяСтрока.Настроить				= НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");
		
		Для Каждого ТекущаяТабличнаяЧасть Из ТабличныеЧасти Цикл
			Если ТекущаяТабличнаяЧасть.Свойство("ЭтоТаблицаЗначений")
				ИЛИ НЕ ТекущаяТабличнаяЧасть.Свойство("ТабличнаяЧастьДокументаMS")
				ИЛИ ТекущаяТабличнаяЧасть.ТабличнаяЧастьДокументаMS <> "СтрокиПлан" Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяТабличнаяЧасть.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",	РезультатРедактирования.ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти);
			ТекущаяТабличнаяЧасть.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти",			РезультатРедактирования.ВидОбработчика_ПослеОбъединенияТабличнойЧасти);
			ТекущаяТабличнаяЧасть.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти",		РезультатРедактирования.Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти);
			ТекущаяТабличнаяЧасть.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти",				РезультатРедактирования.Обработчик_ПослеОбъединенияТабличнойЧасти);	
			
		КонецЦикла; 		
		
		Если СвязиТабличныхЧастей = Неопределено Тогда
			СвязиТабличныхЧастей = РезультатРедактирования.СвязиТабличныхЧастей;
		Иначе
			Для каждого Строка Из РезультатРедактирования.СвязиТабличныхЧастей Цикл
				Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				СвязиТабличныхЧастей.Добавить(Строка);
			КонецЦикла; 			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_УсловияВыгрузкиСтрокТЧЗакрытие(РезультатРедактирования, СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ТекущаяСтрока 								  = СтруктураПараметров.ТекущаяСтрока;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = РезультатРедактирования.УдалятьСтрокиПоУсловиюСтрокой;
		
		Если РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'");
		Иначе
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
		КонецЕсли;
		
		Если СтруктураПараметров.НайдСтрока = Неопределено Тогда
			НоваяСтруктура = ПолучитьСтруктуруТабличнойЧасти();
			ЗаполнитьЗначенияСвойств(НоваяСтруктура, ТекущаяСтрока);
			НоваяСтруктура.Настроить					= "Настроить";
			НоваяСтруктура.ТабличнаяЧастьДокумента1С 	= Неопределено;
			НоваяСтруктура.ТекстЗапросаВыгрузкиНаТСД 	= Неопределено;
			НоваяСтруктура.ТекстКодаПолучениеПараметров = Неопределено;
			
			ТабличныеЧасти.Добавить(НоваяСтруктура);
			НайдСтрока = Новый Структура;
		Иначе
			ТабличнаяЧастьДокументаMS = СтруктураПараметров.НайдСтрока.ТабличнаяЧастьДокументаMS;
			Для Каждого ЭлементМассива Из ТабличныеЧасти Цикл
				Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений")
					ИЛИ НЕ ЭлементМассива.Свойство("ТабличнаяЧастьДокументаMS")
					ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMS Тогда
					Продолжить;
				КонецЕсли;
				НайдСтрока = ЭлементМассива;
				Прервать;
			КонецЦикла;
		КонецЕсли;
		
		НайдСтрока.Вставить("ВыгружатьСтрокиПоУсловиюФлаг",	   ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг);
		НайдСтрока.Вставить("ВыгружатьСтрокиПоУсловиюСтрокой", ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой);
	КонецЕсли;
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Процедура ОтображаемыеТабличныеЧастиПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		Если ДанныеСтроки.Настроить = НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'") 
		Тогда
			ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Зеленый;	
		Иначе	
			ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		Если ДанныеСтроки.ТабличнаяЧастьЕстьВМетаданных Тогда
			Если ДанныеСтроки.ВыгружатьСтрокиПоУсловию = НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'") 
			Тогда
				ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию.ЦветТекста = WebЦвета.Зеленый;
			Иначе	
				ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию.ЦветТекста = WebЦвета.Красный;
			КонецЕсли;
		Иначе
			ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию.ЦветТекста = WebЦвета.СветлоСерый;
		КонецЕсли;
	КонецПроцедуры

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
	
#КонецЕсли