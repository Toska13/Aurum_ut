&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ОсновнаяТЧ Экспорт,
	СтруктураДокумента1С Экспорт,	
	СтруктураДокументаMS Экспорт,
	ТаблицаРеквизитовДополнительная Экспорт,
	НастройкаЗагрузкиТЧ Экспорт;
	
&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ПроверитьСопоставленияТЧ();
	
	Результат = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицыРеквизитов());
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ПоместитьВоВременноеХранилище(ТабличныеЧасти,Новый УникальныйИдентификатор());
	#Иначе
		ТЗ = РеквизитФормыВЗначение("ТабличныеЧасти");
		Возврат ПоместитьВоВременноеХранилище(ТЗ,ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СтрокиПлан");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СтрокиФакт");	
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СовмещенныеСтроки");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерииПлан");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерииФакт");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерийныеНомераПлан");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерийныеНомераФакт");
	
	СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
	
	Для Каждого ДопТаблица Из СписокДопТаблиц Цикл		
		Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить(ДопТаблица.Представление);		
	КонецЦикла;	
	
	СписокТЧ = Новый СписокЗначений;
	Для Каждого ЭлементТЧ Из СтруктураДокумента1С.ТабличныеЧасти Цикл
		СписокТЧ.Добавить(ЭлементТЧ.Значение.Имя, ЭлементТЧ.Значение.Синоним);
	КонецЦикла;
	СписокТЧ.СортироватьПоПредставлению();
	ЗаполнитьСписокВыбора(Элементы.ТабличныеЧастиНастройкаТЧСтрокой.СписокВыбора,СписокТЧ);	
	
	ОбновитьТабличныеЧасти();
	
	Для Каждого СтрокаТЧ Из ТабличныеЧасти Цикл
		Если СтрокаТЧ.ОсновнаяТабличнаяЧасть Тогда
			ОсновнаяТЧ = СтрокаТЧ;
			Прервать;	
		КонецЕсли;
	КонецЦикла;

	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Приемник,Список)
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение,Элем.Представление);	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		КолонкаИмя = Элемент.ТекущаяКолонка.Имя;
	#Иначе
		КолонкаИмя = Элемент.ТекущийЭлемент.Имя;
	#КонецЕсли
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ВРег(СокрЛП("ТабличныеЧастиНастроить")) Тогда		
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокументаMS) Тогда			
			ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента Cleverence'; en = 'No table part of Cleverence document selected'; es = 'No se ha seleccionado la parte de tabla del documento Cleverence'; ka = 'არ არის არჩეული Cleverence-ის ცხრილის ნაწილი'; kk = 'Cleverence документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului Cleverence'; ru = 'Не выбрана табличная часть документа Клеверенс'; tr = 'Cleverence belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа Cleverence'; uz = 'Cleverence hujjati jadvallar qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.НастройкаТЧСтрокой) Тогда
			ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента 1С'; en = 'No table part of 1C document selected'; es = 'No se ha seleccionado la parte de tabla del documento 1C'; ka = 'არ არის არჩეული 1C-ის ცხრილის ნაწილი'; kk = '1С документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului 1C'; ru = 'Не выбрана табличная часть документа 1С'; tr = '1C belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа 1С'; uz = '1C hujjati jadvallar qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;	
		КонецЕсли; 	
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ПравилаЗагрузкиПолей = ПолучитьФорму("ОФ_ФормаНастройки_ПравилаЗагрузкиПолей", ЭтаФорма);
		#Иначе
			ФормаНастройки_ПравилаЗагрузкиПолей = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПравилаЗагрузкиПолей", , ЭтаФорма, ЭтаФорма);
			ФормаНастройки_ПравилаЗагрузкиПолей.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		ФормаНастройки_ПравилаЗагрузкиПолей._ЛокКонтекст = _ЛокКонтекст;
		ФормаНастройки_ПравилаЗагрузкиПолей.КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
		ФормаНастройки_ПравилаЗагрузкиПолей.КонтрольКоличества = КонтрольКоличества;
		ФормаНастройки_ПравилаЗагрузкиПолей.ТипДокумента1С = ТипДокумента1С;
		ФормаНастройки_ПравилаЗагрузкиПолей.ТипДокументаMS = ТипДокументаMS;
		ФормаНастройки_ПравилаЗагрузкиПолей.ИмяТабличнойЧастиMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS;
		ФормаНастройки_ПравилаЗагрузкиПолей.ИмяТабличнойЧасти1С = ТекущаяСтрока.НастройкаТЧСтрокой;
		
		СписокТаблицДляСвязиПоКлючу = Новый СписокЗначений;  
		
		Если ТекущаяСтрока.ОсновнаяТабличнаяЧасть И ТабличныеЧасти.Количество() > 1 Тогда     
			Для Каждого СтрокаТЧ Из ТабличныеЧасти Цикл
				Если СтрокаТЧ.СопоставлятьСОсновнойТЧ Тогда
					СписокТаблицДляСвязиПоКлючу.Добавить(_ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтрокаТЧ.ТабличнаяЧастьДокумента1ССтрокой), СтрокаТЧ.НастройкаТЧСтрокой);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ФормаНастройки_ПравилаЗагрузкиПолей.СписокТаблицДляСвязиПоКлючу = СписокТаблицДляСвязиПоКлючу;
		Если ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой) Тогда
			ТабличнаяЧастьДокумента1С = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой);
		Иначе 
			ТабличнаяЧастьДокумента1С = Новый Массив; 
		КонецЕсли;
		Если ТипЗнч(ТабличнаяЧастьДокумента1С) = Тип("Массив") Тогда
			ФормаНастройки_ПравилаЗагрузкиПолей.ТаблицаРеквизитовИсходная   = ТабличнаяЧастьДокумента1С;
		КонецЕсли;
		ФормаНастройки_ПравилаЗагрузкиПолей.ТаблицаРеквизитовДополнительная  					= ТаблицаРеквизитовДополнительная; 		
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти = ТекущаяСтрока.ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПередЗаполнениемТабличнойЧасти 		= ТекущаяСтрока.ВидОбработчика_ПередЗаполнениемТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти 	= ТекущаяСтрока.ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПослеЗаполненияТабличнойЧасти 		= ТекущаяСтрока.ВидОбработчика_ПослеЗаполненияТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПередЗаполнениемТабличнойЧасти 			= ТекущаяСтрока.Обработчик_ПередЗаполнениемТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти 	= ТекущаяСтрока.Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти		= ТекущаяСтрока.Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПослеЗаполненияТабличнойЧасти 			= ТекущаяСтрока.Обработчик_ПослеЗаполненияТабличнойЧасти;
		ОП = Новый ОписаниеОповещения("ФормаНастройки_ПравилаЗагрузкиПолейЗакрытие",ЭтаФорма,Новый Структура("ТекущаяСтрока",ТекущаяСтрока));
		ФормаНастройки_ПравилаЗагрузкиПолей.ОписаниеОповещенияОЗакрытии 						= ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ПравилаЗагрузкиПолей.ОткрытьМодально();
		#Иначе
			ФормаНастройки_ПравилаЗагрузкиПолей.Открыть();
		#КонецЕсли
		
	ИначеЕсли ВРег(СокрЛП(КолонкаИмя)) = ВРег(СокрЛП("ТабличныеЧастиУдалятьСтрокиПоУсловию")) Тогда
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокументаMS) Тогда			
			ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента Cleverence'; en = 'No table part of Cleverence document selected'; es = 'No se ha seleccionado la parte de tabla del documento Cleverence'; ka = 'არ არის არჩეული Cleverence-ის ცხრილის ნაწილი'; kk = 'Cleverence документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului Cleverence'; ru = 'Не выбрана табличная часть документа Клеверенс'; tr = 'Cleverence belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа Cleverence'; uz = 'Cleverence hujjati jadvallar qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.НастройкаТЧСтрокой) Тогда			
			ТекстПредупреждения = НСтр("be = 'Не абрана таблічная частка дакумента 1С'; en = 'No table part of 1C document selected'; es = 'No se ha seleccionado la parte de tabla del documento 1C'; ka = 'არ არის არჩეული 1C-ის ცხრილის ნაწილი'; kk = '1С документінің кестелі бөлімі таңдалмады'; ro = 'Nu a fost selectată partea tabulară a documentului 1C'; ru = 'Не выбрана табличная часть документа 1С'; tr = '1C belgesinin tablo kısmı seçilmedi'; uk = 'Не обрана таблична частина документа 1С'; uz = '1C hujjati jadvallar qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;	
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_УсловияУдаленияСтрокТЧ = ПолучитьФорму("ОФ_ФормаНастройки_УсловияУдаленияСтрокТЧ", ЭтаФорма);
		#Иначе
			ФормаНастройки_УсловияУдаленияСтрокТЧ = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_УсловияУдаленияСтрокТЧ", , ЭтаФорма, ЭтаФорма);
			ФормаНастройки_УсловияУдаленияСтрокТЧ.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаНастройки_УсловияУдаленияСтрокТЧ._ЛокКонтекст = _ЛокКонтекст;
		ФормаНастройки_УсловияУдаленияСтрокТЧ.ТипДокумента1С = ТипДокумента1С;
		ФормаНастройки_УсловияУдаленияСтрокТЧ.ИмяТабличнойЧасти1С = ТекущаяСтрока.НастройкаТЧСтрокой;
				
		ФормаНастройки_УсловияУдаленияСтрокТЧ.КомпоновщикНастроекСтрокой = ТекущаяСтрока.УдалятьСтрокиПоУсловиюСтрокой;
		ФормаНастройки_УсловияУдаленияСтрокТЧ.УдалятьСтрокиПоУсловиюФлаг = ТекущаяСтрока.УдалятьСтрокиПоУсловиюФлаг;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_УсловияУдаленияСтрокТЧЗакрытие",ЭтаФорма,Новый Структура("ТекущаяСтрока",ТекущаяСтрока));
		ФормаНастройки_УсловияУдаленияСтрокТЧ.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_УсловияУдаленияСтрокТЧ.Заголовок = 
				НСтр("be = 'Cleverence: Налада ўмовы выдалення радкоў'; en = 'Cleverence: Setting up conditions for deleting rows'; es = 'Cleverence: Configuración de condiciones de eliminación de filas'; ka = 'Cleverence: სტრიქონების წაშლის პარამეტრები'; kk = 'Cleverence: Строкаларды жою мәртебесін орнату'; ro = 'Cleverence: Configurarea condițiilor de ștergere a rândurilor'; ru = 'Клеверенс: Настройка условия удаления строк'; tr = 'Cleverence: Satır silme koşulları ayarları'; uk = 'Cleverence: Налаштування умов видалення рядків'; uz = ""Cleverence: Qatorlarni o'chirish shartlarini sozlash""");
			ФормаНастройки_УсловияУдаленияСтрокТЧ.ЭлементыФормы.ТекстПодсказки.Заголовок = 
