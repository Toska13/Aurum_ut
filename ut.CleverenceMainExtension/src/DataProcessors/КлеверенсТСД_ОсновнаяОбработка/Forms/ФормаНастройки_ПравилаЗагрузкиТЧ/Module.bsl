&НаКлиенте
Процедура ФормаНастройки_УсловияУдаленияСтрокТЧЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		Если РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.УдалятьСтрокиПоУсловию = НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'");
		Иначе
			ТекущаяСтрока.УдалятьСтрокиПоУсловию = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
		КонецЕсли; 
		ТекущаяСтрока.УдалятьСтрокиПоУсловиюФлаг = РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг;
		ТекущаяСтрока.УдалятьСтрокиПоУсловиюСтрокой = РезультатРедактирования.УдалятьСтрокиПоУсловиюСтрокой;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТабличныеЧасти()
	Если НастройкаЗагрузкиТЧ = Неопределено Тогда
		НастройкаЗагрузкиТЧ = Новый Массив;
	КонецЕсли;
	
	Для Каждого СтрокаНастройки Из НастройкаЗагрузкиТЧ Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПриемник = ТабличныеЧасти.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаНастройки);
		Если НЕ СтрокаНастройки.Свойство("ТабличнаяЧастьДокумента1С")
			И СтрокаНастройки.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
			СтрокаНастройки.Вставить("ТабличнаяЧастьДокумента1С",_ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтрокаНастройки.ТабличнаяЧастьДокумента1ССтрокой,Истина));
		КонецЕсли;
		СтрокаПриемник.ТабличнаяЧастьДокумента1ССтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(СтрокаНастройки.ТабличнаяЧастьДокумента1С);
		Если ТипЗнч(СтрокаНастройки.ТабличнаяЧастьДокумента1С) = Тип("Массив")
			И СтрокаНастройки.ТабличнаяЧастьДокумента1С.Количество() > 1 Тогда
			СтрокаПриемник.Настроить = НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");
		Иначе
			СтрокаПриемник.Настроить = НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
		КонецЕсли;
		
		Если СтрокаНастройки.Свойство("УдалятьСтрокиПоУсловиюФлаг") 
			И СтрокаНастройки.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			СтрокаПриемник.УдалятьСтрокиПоУсловию = НСтр("be = 'Уключана'; en = 'Enabled'; es = 'Activado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; ru = 'Включено'; tr = 'Açık'; uk = 'Увімкнено'; uz = 'Йўқ'");
		Иначе
			СтрокаПриемник.УдалятьСтрокиПоУсловию = НСтр("be = 'Выключана'; en = 'Turned off'; es = 'Apagado'; ka = 'გამორთული'; kk = 'Өшірілді'; ro = 'Dezactivat'; ru = 'Выключено'; tr = 'Kapatıldı'; uk = 'Вимкнено'; uz = ""O'chirilgan""");
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры


&НаКлиенте
Процедура ТабличныеЧастиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	НоваяСтрока = ТабличныеЧасти.Добавить();
	НоваяСтрока.Настроить = "Настроить";
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элемент.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	#КонецЕсли
КонецПроцедуры


&НаКлиенте
Процедура ТабличныеЧастиОсновнаяТабличнаяЧастьПриИзменении(Элемент)
	ТекДанные = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекДанные.ОсновнаяТабличнаяЧасть Тогда
		Если НЕ ОсновнаяТЧ = Неопределено Тогда
			ОсновнаяТЧ.ОсновнаяТабличнаяЧасть = Ложь;	
		КонецЕсли;
		ТекДанные.СопоставлятьСОсновнойТЧ = Ложь;
		ОсновнаяТЧ = ТекДанные;
	Иначе
		ОсновнаяТЧ = Неопределено;
		Для Каждого СтрокаТЧ Из ТабличныеЧасти Цикл
			СтрокаТЧ.СопоставлятьСОсновнойТЧ = Ложь;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТабличныеЧастиСопоставлятьСОсновнойТЧПриИзменении(Элемент)
	ТекДанные = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекДанные.ОсновнаяТабличнаяЧасть Или ОсновнаяТЧ = Неопределено Тогда	
		ТекДанные.СопоставлятьСОсновнойТЧ = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСопоставленияТЧ()
	
	ИндОсновнойТЧ = Неопределено;
	ИндПодчиненнойТЧ = Неопределено;
	Инд = 0;
	Для Каждого Строка Из ТабличныеЧасти Цикл
		Если Строка.ОсновнаяТабличнаяЧасть = Истина Тогда
			ИндОсновнойТЧ = Инд;
		ИначеЕсли Строка.СопоставлятьСОсновнойТЧ = Истина Тогда
			ИндПодчиненнойТЧ = Инд;
		КонецЕсли;
		Инд = Инд +1;
	КонецЦикла;
	
	// Если установлена галочка основной табличной части, но не задана сопоставляемая ТЧ, то надо сбросить эту галочку
	Если ИндОсновнойТЧ <> Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		#Если Не ТолстыйКлиентОбычноеПриложение Тогда
			Сообщение.ИдентификаторНазначения = ВладелецФормы.УникальныйИдентификатор;			
		#КонецЕсли
		
		Строка = ТабличныеЧасти.Получить(ИндОсновнойТЧ);
		Если  ИндПодчиненнойТЧ = Неопределено Тогда			
			Строка.ОсновнаяТабличнаяЧасть = Ложь;
			Текст = НСтр("be = 'З таблічнай часткай %1 не было наладжана супастаўленне з іншай таблічнай часткаю. Сцяг ""Асноўная таблічная частка"" быў зняты.'; en = 'No mapping was configured for Table Part %1 with another Table Part. The ""Main Table Part"" flag was removed.'; es = 'No se ha configurado la correspondencia con otra parte de la tabla para la parte de la tabla %1. La marca ""Parte de la tabla principal"" ha sido eliminada.'; ka = '%1 ცხრილის ნაწილის შედარება სხვა ცხრილისთვის არ იქნა დაყენებული. ""ძირითა ცხრილის"" დრო მოხსნილი იყო.'; kk = '%1 кестелік бөлімінен басқа кестелік бөлімімен сәйкес көрсетілмеген. ""Негізгі кестелік бөлім"" байланыс жою белгісі алынды.  '; ro = 'Cu partea tabelei %1 nu s-a configurat asocierea cu o altă parte a tabelei. Steagul ""Partea principală a tabelei"" a fost eliminat.'; ru = 'С табличной частью %1 не было настроено сопоставление с другой табличной частью. Флаг ""Основная табличная часть"" был снят.'; tr = '%1 Tablo Kısmı, başka bir Tablo Kısmı ile eşleştirme yapılmadı. ""Ana Tablo Kısmı"" işareti kaldırıldı.'; uk = 'З Табличною частиною %1 не було налаштовано відповідність з іншою Табличною частиною. Прапор ""Основна Таблична частина"" був знятий.'; uz = '%1 jadvallar qismi boshqa jadvallar qismiga moslashuv sozlamasi yo''q edi. ""Asosiy jadvallar qismi"" belgisi olib tashlandi.  '");
			Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, Строка.НастройкаТЧСтрокой);
			Сообщение.Текст = Текст;			
			Сообщение.Сообщить(); 
		Иначе
			КлючСвязиНайден = Ложь;
			НастройкаТЧ = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(Строка.ТабличнаяЧастьДокумента1ССтрокой);
			Для Каждого СтрокаРеквизита Из НастройкаТЧ Цикл
				Если СтрокаРеквизита.Свойство("ЭтоТаблицаЗначений") 
					Или СтрокаРеквизита.Загружать = Ложь Тогда
					Продолжить;				
				ИначеЕсли Лев(СтрокаРеквизита.СинонимИсточника,15) = "Ключ связи для " Тогда
					КлючСвязиНайден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не КлючСвязиНайден Тогда
				Текст = НСтр("be = 'У наладцы таблічнай частцы %1 не ўказаны ключ звязку з іншай таблічнай часткаю. Магчымыя памылкі пры загрузцы дакумента'; en = 'The link key to another table part is not specified in the settings for table part %1. Errors may occur when loading the document.'; es = 'En la configuración de la parte de tabla %1 no se ha especificado la clave de relación con otra parte de tabla. Pueden producirse errores al cargar el documento'; ka = '%1 ცხრილის პარამეტრებში არ არის დაკავშირების გასაღები კლავიში. დოკუმენტის ჩატვირთვისას შეცდომები შეიძლება.'; kk = 'В настройке табличной части %1 не указан ключ связи с другой табличной частью. Возможны ошибки при загрузке документа - %1 кестесі параметрлерінде басқа кестесімен байланыс кілті көрсетілмеген. Құжатты жүктеу кезінде қателіктер болуы мүмкін'; ro = 'În setarea părții tabulare %1 nu este specificată cheia de legătură cu o altă parte tabulară. Pot apărea erori la încărcarea documentului.'; ru = 'В настройке табличной части %1 не указан ключ связи с другой табличной частью. Возможны ошибки при загрузке документа.'; tr = '%1 tablo bölümü ayarlarında başka bir tablo bölümüyle ilişki anahtarı belirtilmedi. Belge yüklenirken hatalar oluşabilir.'; uk = ""У налаштуванні табличної частини %1 не вказаний ключ зв'язку з іншою табличною частиною. Можливі помилки при завантаженні документа.""; uz = ""%1 jadval qismi sozlash kaliti boshqa jadval qismi bilan bog'liq emas. Hujjatni yuklashda xatolar mumkin.""");
				Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, Строка.НастройкаТЧСтрокой);
				Сообщение.Текст = Текст;
				Сообщение.Сообщить(); 
			КонецЕсли;
		КонецЕсли;
		
	Конецесли;
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	Процедура ТабличныеЧастиПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		Если ДанныеСтроки.Настроить = НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'") 
		Тогда
			ОформлениеСтроки.Ячейки.ТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Зеленый;	
		Иначе	
			ОформлениеСтроки.Ячейки.ТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		Если ДанныеСтроки.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ОформлениеСтроки.Ячейки.ТабличныеЧастиУдалятьСтрокиПоУсловию.ЦветТекста = WebЦвета.Зеленый;	
		Иначе	
			ОформлениеСтроки.Ячейки.ТабличныеЧастиУдалятьСтрокиПоУсловию.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
	КонецПроцедуры
	
	Процедура ТабличныеЧастиПриИзмененииФлажка(Элемент, Колонка)
		
		Если Колонка.Имя = "ТабличныеЧастиОсновнаяТабличнаяЧасть" Тогда
			ТабличныеЧастиОсновнаяТабличнаяЧастьПриИзменении(Элемент);
		КонецЕсли;
		
		Если Колонка.Имя = "ТабличныеЧастиСопоставлятьСОсновнойТЧ" Тогда
			ТабличныеЧастиСопоставлятьСОсновнойТЧПриИзменении(Элемент);
		КонецЕсли;		
		
	КонецПроцедуры
	
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
#КонецЕсли
