КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()
	
	Результат = Истина;
	ОчиститьСообщения();
	
	Если НомерТелефона <> "" И _ЛокКонтекст.ЛокЯдро_СтрРазделить(НомерТелефона, " ").Количество() > 3 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Некорректный номер телефона";
		Сообщение.Поле = "НомерТелефона";
		Сообщение.УстановитьДанные(НомерТелефона);
		Сообщение.Сообщить();
		
		Результат = Ложь;
	КонецЕсли;
	
	Почта = СтрЗаменить(СокрЛП(Почта), " ", "");
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Если Почта <> "" И НЕ _ЛокКонтекст.ЛокЯдро_ПроверитьКорректностьEmail(Почта) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Некорректный адрес электронный почты";
		Сообщение.Поле = "Почта";
		Сообщение.УстановитьДанные(Почта);
		Сообщение.Сообщить();
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


