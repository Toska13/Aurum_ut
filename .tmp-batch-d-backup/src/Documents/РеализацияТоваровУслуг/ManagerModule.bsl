Функция ДанныеДляПечатиДокументов(Документы)
	
	ДанныеДляПечати = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
	|	РеализацияТоваровУслуг.Партнер КАК Партнер
	|ПОМЕСТИТЬ ВТРеализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка В(&Документы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРеализации.Ссылка КАК Ссылка,
	|	МАКСИМУМ(КонтактныеЛицаПартнеров.Ссылка) КАК КонтактноеЛицо
	|ПОМЕСТИТЬ ВТРеализацияСКонтактами
	|ИЗ
	|	ВТРеализации КАК ВТРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
	|		ПО ВТРеализации.Партнер = КонтактныеЛицаПартнеров.Владелец
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТРеализации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
	|	РеализацияТоваровУслуг.Грузополучатель.НаименованиеПолное КАК ГрузополучательНаименованиеПолное,
	|	РеализацияТоваровУслуг.Номер КАК Номер,
	|	РеализацияТоваровУслуг.Дата КАК Дата,
	|	РеализацияТоваровУслуг.Договор КАК Договор,
	|	РеализацияТоваровУслуг.Договор.Наименование КАК ДоговорНаименование,
	|	РеализацияТоваровУслуг.Договор.Номер КАК ДоговорНомер,
	|	РеализацияТоваровУслуг.Договор.Дата КАК ДоговорДата,
	|	РеализацияТоваровУслуг.Договор.Сумма КАК ДоговорСумма,
	|	РеализацияТоваровУслуг.Договор.ВалютаВзаиморасчетов КАК ДоговорВалюта,
	|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
	|	РеализацияТоваровУслуг.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
	|	РеализацияТоваровУслуг.Контрагент.ИНН КАК КонтрагентИНН,
	|	РеализацияТоваровУслуг.Контрагент.КПП КАК КонтрагентКПП,
	|	РеализацияТоваровУслуг.Контрагент.Наименование КАК КонтрагентНаименование,
	|	ВТРеализацияСКонтактами.КонтактноеЛицо КАК КонтактноеЛицо,
	|	ВТРеализацияСКонтактами.КонтактноеЛицо.Наименование КАК КонтактноеЛицоНаименование,
	|	ВТРеализацияСКонтактами.КонтактноеЛицо.ДолжностьПоВизитке КАК КонтактноеЛицоДолжность,
	|	РеализацияТоваровУслуг.Товары.(
	|		Номенклатура КАК Номенклатура,
	|		АУ_Шифр КАК АУ_Шифр,
	|		Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|		Номенклатура.ЕдиницаИзмерения.Наименование КАК НоменклатураЕдиницаИзмеренияНаименование,
	|		Количество КАК Количество,
	|		Цена КАК Цена,
	|		СтавкаНДС КАК СтавкаНДС,
	|		СуммаСНДС КАК СуммаСНДС,
	|		СуммаНДС КАК СуммаНДС,
	|		НомерСтроки КАК НомерСтроки
	|	) КАК Товары,
	|	ТранспортнаяНакладнаяДокументыОснования.Ссылка.АдресДоставки КАК АдресДоставки
	|ИЗ
	|	ВТРеализацияСКонтактами КАК ВТРеализацияСКонтактами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
	|			ПО ТранспортнаяНакладнаяДокументыОснования.ДокументОснование = РеализацияТоваровУслуг.Ссылка
	|		ПО ВТРеализацияСКонтактами.Ссылка = РеализацияТоваровУслуг.Ссылка";
		
	Запрос.УстановитьПараметр("Документы", Документы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Описание=Новый Структура("Ссылка",Выборка.Ссылка);
		Описание.Вставить("Номер",ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер));
		Описание.Вставить("Дата",Формат(Выборка.Дата,"ДЛФ=Д"));
		Описание.Вставить("ДатаПрописью",Формат(Выборка.Дата,"ДФ='дд ММММ гггг ""г.""'"));
		Описание.Вставить("Договор",Выборка.ДоговорНаименование);
		Описание.Вставить("ДатаДоговора",Формат(Выборка.ДоговорДата,"ДЛФ=Д"));
		Описание.Вставить("ДатаДоговораПрописью",Формат(Выборка.ДоговорДата,"ДФ='дд ММММ гггг ""г.""'"));
		Описание.Вставить("НомерДоговора",Выборка.ДоговорНомер);
		Описание.Вставить("СуммаДоговора",Выборка.ДоговорСумма);
		Описание.Вставить("СуммаДоговораПрописью",ЧислоПрописью(Выборка.ДоговорСумма,,Выборка.ДоговорВалюта.ПараметрыПрописи));
		Описание.Вставить("КонтрагентНаименованиеПолное",Выборка.КонтрагентНаименованиеПолное);
		Описание.Вставить("КонтрагентНаименование",Выборка.КонтрагентНаименование);
		Описание.Вставить("ДолжностьПодписантКонтрагентРП",СклонениеПредставленийОбъектов.ПросклонятьПредставление(Выборка.КонтактноеЛицоДолжность,2));
		Описание.Вставить("ФИОПодписантКонтрагентРП",СклонениеПредставленийОбъектов.ПросклонятьПредставление(Выборка.КонтактноеЛицоНаименование,2));
		Описание.Вставить("ДолжностьПодписантКонтрагент",Выборка.КонтактноеЛицоДолжность);
		Описание.Вставить("Помещения","");
		Описание.Вставить("Объект","");
		Описание.Вставить("ОснованиеКонтрагентРП","Доверенности от 31.05.2024 №96/2024");
		Описание.Вставить("Грузополучатель", Выборка.ГрузополучательНаименованиеПолное);
		Описание.Вставить("АдресДоставки", Выборка.АдресДоставки);
		
		ФИОФизическогоЛица = ФизическиеЛицаКлиентСервер.ЧастиИмени(Выборка.КонтактноеЛицоНаименование);
		ФамилияИнициалы = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИОФизическогоЛица);
		Описание.Вставить("ФиоИнициалыПодписантКонтрагент",ФамилияИнициалы);
		Описание.Вставить("ИнициалыФиоПодписантКонтрагент",ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИОФизическогоЛица,,Истина));
		
		Товары=Новый Массив;
		ИтогоСуммаНДС=0;
		ИтогоСумма=0;
		стрТовары=Выборка.Товары.Выбрать();
		Пока стрТовары.Следующий() Цикл
			
			НоваяСтрока=Новый Структура();
			НоваяСтрока.Вставить("НомерСтроки",стрТовары.НомерСтроки);
			НоваяСтрока.Вставить("Шифр",стрТовары.АУ_Шифр);
			НоваяСтрока.Вставить("Номенклатура",стрТовары.НоменклатураНаименованиеПолное);
			НоваяСтрока.Вставить("Единица",стрТовары.НоменклатураЕдиницаИзмеренияНаименование);
			НоваяСтрока.Вставить("Количество",стрТовары.Количество);
			НоваяСтрока.Вставить("Цена",СокрЛП(стрТовары.Цена));
			НоваяСтрока.Вставить("СтавкаНДС",СокрЛП(стрТовары.СтавкаНДС));
			НоваяСтрока.Вставить("СуммаНДС",СокрЛП(стрТовары.СуммаНДС));
			НоваяСтрока.Вставить("Сумма",СокрЛП(стрТовары.СуммаСНДС));
			НоваяСтрока.Вставить("СуммаБезНДС",СокрЛП(стрТовары.СуммаСНДС-стрТовары.СуммаНДС));
			
			Товары.Добавить(НоваяСтрока);
			
			ИтогоСуммаНДС=ИтогоСуммаНДС+стрТовары.СуммаНДС;
			ИтогоСумма=ИтогоСумма+стрТовары.СуммаСНДС;
		
		КонецЦикла;
		
		Описание.Вставить("ИтогоСумма",ИтогоСумма);
		Описание.Вставить("ИтогоСуммаНДС",ИтогоСуммаНДС);
		
		НоваяСтрока=Новый Структура();
		НоваяСтрока.Вставить("НомерСтроки","");
		НоваяСтрока.Вставить("Номенклатура","Итого:");
		НоваяСтрока.Вставить("Единица","");
		НоваяСтрока.Вставить("Количество","");
		НоваяСтрока.Вставить("Цена","");
		НоваяСтрока.Вставить("СтавкаНДС","");
		НоваяСтрока.Вставить("СуммаНДС",ИтогоСуммаНДС);
		НоваяСтрока.Вставить("Сумма",ИтогоСумма);
		НоваяСтрока.Вставить("СуммаБезНДС","");
		
		Товары.Добавить(НоваяСтрока);
		
		Описание.Вставить("Товары",Товары);
		Описание.Вставить("СуммаВсегоСНДСПрописью", РаботаСКурсамиВалют.СформироватьСуммуПрописью(ИтогоСумма, Константы.ВалютаРегламентированногоУчета.Получить()));
		Описание.Вставить("СуммаНДСПрописью", РаботаСКурсамиВалют.СформироватьСуммуПрописью(ИтогоСуммаНДС, Константы.ВалютаРегламентированногоУчета.Получить()));
		Описание.Вставить("КоличествоСтрок",Товары.Количество()-1);
		
		ДанныеДляПечати.Добавить(Описание);
		
	КонецЦикла;
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция СоответствиеДанныхДляПечатиДокументов(Документы)
	
	Соответствие = Новый Соответствие;
	
	ДанныеДляПечати = ДанныеДляПечатиДокументов(Документы);
	
	Для Каждого ОписаниеДокумента Из ДанныеДляПечати Цикл
		Соответствие.Вставить(ОписаниеДокумента.Ссылка, ОписаниеДокумента);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

