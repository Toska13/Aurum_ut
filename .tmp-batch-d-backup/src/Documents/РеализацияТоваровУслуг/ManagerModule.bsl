Функция ПолучитьДанныеПечати(Знач Документы, Знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	СоответствиеПоДокументам = СоответствиеДанныхДляПечатиДокументов(Документы);
	
	Для Каждого ОбъектСсылка Из Документы Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, СоответствиеПоДокументам[ОбъектСсылка]);
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ДвоичныеДанныеМакетов = Новый Соответствие;
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		
		Если ИмяМакета = "АУ_АктПередачи(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_АУ_АктПередачи"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_АктПередачи());
		КонецЕсли;
		
		Если ИмяМакета = "АУ_АктНаПеремещение(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_АУ_АктНаПеремещение"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_АктНаПеремещение());
		КонецЕсли;
		
		Если ИмяМакета = "АУ_АктПриемаПередачиДЗКС(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_АУ_АктПриемаПередачиДЗКС"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_АктПриемаПередачиДЗКС());
		КонецЕсли;
		
		Если ИмяМакета = "АУ_АктВводаДЗКС(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_АУ_АктВводаДЗКС"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_АктВводаДЗКС());
		КонецЕсли;
		
		Если ИмяМакета = "АУ_АктВводаПоМСУ(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_АУ_АктВводаПоМСУ"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_АктВводаДЗКС());
		КонецЕсли;
		
		Если ИмяМакета = "АУ_УведомлениеОбОтгрузке(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_УведомлениеОбОтгрузке"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_УведомлениеОбОтгрузке());
		КонецЕсли;
		
		Если ИмяМакета = "АУ_УпаковочныйЛист(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Документ.РеализацияТоваровУслуг.ПФ_DOC_УпаковочныйЛист"));
			ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакета_АУ_УпаковочныйЛист());
		КонецЕсли;
		
	КонецЦикла;

	Макеты = Новый Структура("ОписаниеОбластей, ДвоичныеДанныеМакетов");
	Макеты.ОписаниеОбластей = ОписаниеОбластей;
	Макеты.ДвоичныеДанныеМакетов = ДвоичныеДанныеМакетов;
	
	ДанныеПечати = Новый Структура("Данные, Макеты");
	ДанныеПечати.Данные = ДанныеПоВсемОбъектам;
	ДанныеПечати.Макеты = Макеты;
	
	Возврат ДанныеПечати;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

