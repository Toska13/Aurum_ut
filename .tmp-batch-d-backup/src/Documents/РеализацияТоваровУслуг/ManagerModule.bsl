&После("ДобавитьКомандыПечати")
Процедура АУ_ДобавитьКомандыПечати(КомандыПечати)

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "АУ_АктПередачи(OfficeOpenXML)";
	КомандаПечати.Представление = НСтр("ru = 'Акт приема-передачи (Аурум)'");
