#Область ПрограммныйИнтерфейс

&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура АУ_ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации)

	Если НаправлениеОбмена = "Отправка" Тогда
		ДобавитьПКО_АУ_Документ_ВнутреннееПотребление_ПередачаПереработчику(ПравилаКонвертации);
		ДобавитьПКО_АУ_Документ_ПрочееОприходование_ВозвратОтПереработчика(ПравилаКонвертации);
	КонецЕсли;

КонецПроцедуры

&После("ЗаполнитьПравилаКонвертацииПредопределенныхДанных")
Процедура АУ_ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации)

	// Перечисление_ТипыДоговоров_Отправка.
	ПравилоКонвертации = ПравилаКонвертации.Добавить();
	ПравилоКонвертации.ИмяПКПД = "СпособыВыставленияДокументов";
	ПравилоКонвертации.ТипДанных = Метаданные.Перечисления.СпособыВыставленияДокументов;
	ПравилоКонвертации.ТипXDTO = "СпособыВыставленияДокументов";

КонецПроцедуры

&После("ВыполнитьПроцедуруМодуляМенеджера")
Процедура АУ_ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры)

	Если ИмяПроцедуры = "ПКО_АУ_Документ_ВнутреннееПотребление_ПередачаПереработчику_ПриОтправкеДанных" Тогда 
		ПКО_АУ_Документ_ВнутреннееПотребление_ПередачаПереработчику_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "ПКО_АУ_Документ_ПрочееОприходование_ВозвратОтПереработчика_ПриОтправкеДанных" Тогда 
		ПКО_АУ_Документ_ПрочееОприходование_ВозвратОтПереработчика_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	КонецЕсли;

КонецПроцедуры

&ИзменениеИКонтроль("ПолучитьСведенияОПрослеживаемости")
Процедура АУ_ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов, ОбъединитьСУсловием = Ложь)
	ИмяМетаданных = ДанныеИБ.Метаданные().Имя;
	ПроверкаОтсутствияУпаковок = Новый Массив;
	
	ПозицияТочки = СтрНайти(ИмяТаблицы, ".", НаправлениеПоиска.СКонца);
	ИмяТаблицыСтрокой = Прав(ИмяТаблицы, СтрДлина(ИмяТаблицы) - ПозицияТочки);
	
	ПроверкаОтсутствияУпаковок.Добавить("ВнутреннееПотребление"); 
	ПроверкаОтсутствияУпаковок.Добавить("ДвижениеПродукцииИМатериалов"); 
	ПроверкаОтсутствияУпаковок.Добавить("ОприходованиеИзлишковТоваров");
	ПроверкаОтсутствияУпаковок.Добавить("ОтчетОРозничныхПродажах"); 
	ПроверкаОтсутствияУпаковок.Добавить("ОтчетКомитентуОСписании");
	ПроверкаОтсутствияУпаковок.Добавить("ПередачаМатериаловВПроизводство");
	ПроверкаОтсутствияУпаковок.Добавить("ПересортицаТоваров");
	ПроверкаОтсутствияУпаковок.Добавить("ПеремещениеТоваров"); 
	ПроверкаОтсутствияУпаковок.Добавить("ПроизводствоБезЗаказа");
	ПроверкаОтсутствияУпаковок.Добавить("СборкаТоваров"); 
	ПроверкаОтсутствияУпаковок.Добавить("СписаниеИзЭксплуатации");
	ПроверкаОтсутствияУпаковок.Добавить("СписаниеНедостачТоваров");
	ПроверкаОтсутствияУпаковок.Добавить("УведомлениеОПеремещенииПрослеживаемыхТоваров");
	ПроверкаОтсутствияУпаковок.Добавить("УведомлениеОбОстаткахПрослеживаемыхТоваров");
	
	Ссылки = Новый СписокЗначений;
	Если ТипЗнч(ДанныеИБ) = Тип("ТаблицаЗначений") Тогда
		ДанныеИБСсылка = Неопределено;
		Для каждого Стр Из ДанныеИБ Цикл
			Ссылки.Добавить(Стр.Ссылка);		
		КонецЦикла;
	Иначе	
		Ссылки.Добавить(ДанныеИБ.Ссылка); 
		ДанныеИБСсылка = ДанныеИБ.Ссылка;
	КонецЕсли; 
	МетаданныеТабличныхЧастей = ДанныеИБСсылка.Метаданные().ТабличныеЧасти;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаВидыЗапасов.НомерГТД КАК НомерГТД,
	|	ТаблицаВидыЗапасов.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ТаблицаВидыЗапасов.НомерГТД.ТипНомераГТД КАК ТипНомераГТД,
	|	ТаблицаВидыЗапасов.НомерГТД.СуммаПоРНПТ КАК СуммаПоРНПТ,
	|	&ИдентификаторСтроки1 КАК ИдентификаторСтроки,
	|	РСАналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаВидыЗапасов.АналитикаУчетаНоменклатуры.Наименование КАК Наименование,
	|	РСАналитикаУчетаНоменклатуры.Номенклатура.КодТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмеренияТНВЭД,
	|	ТаблицаВидыЗапасов.Количество КАК Количество,
	|	&Упаковка КАК Упаковка,
	|	"""" КАК НомерРНПТ,
	|	ТаблицаВидыЗапасов.НомерГТД.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаВидыЗапасов.НомерГТД.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТ) КАК ЯвляетсяРНПТ,
	|	ТаблицаВидыЗапасов.Ссылка КАК Ссылка,
	|	РСАналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	РСАналитикаУчетаНоменклатуры.Серия КАК Серия,
	|	РСАналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ РНПТ
	|ИЗ
	|	ТабличнаяЧастьВидовЗапасов КАК ТаблицаВидыЗапасов"
	+ ?(Найти(ИмяТаблицы, "ВидыЗапасов") > 0,"
	|	  	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК РСАналитикаУчетаНоменклатуры
	|	  	ПО (РСАналитикаУчетаНоменклатуры.Номенклатура = ТаблицаВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура) 
	|	  	И ТаблицаВидыЗапасов.АналитикаУчетаНоменклатуры.Ссылка = РСАналитикаУчетаНоменклатуры.КлючАналитики.Ссылка", "") 
	+ "
	|ГДЕ
	|	ТаблицаВидыЗапасов.Ссылка В(&Ссылки)
	|	И НЕ ТаблицаВидыЗапасов.НомерГТД = ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)
	|	И НЕ ТаблицаВидыЗапасов.НомерГТД.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераГТДПрослеживаемыеКомплектующие.НомерРНПТ КАК НомерГТД,
	|	&ИдентификаторСтроки2 КАК ИдентификаторСтроки,
	|	НомераГТДПрослеживаемыеКомплектующие.НомерРНПТ КАК НомерРНПТ,
	|	(НомераГТДПрослеживаемыеКомплектующие.КоличествоПоРНПТ * ВидыЗапасовРНПТКомплекты.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
	|	НомераГТДПрослеживаемыеКомплектующие.ЕдиницаИзмеренияТНВЭД КАК ЕдиницаИзмеренияТНВЭД,
	|	ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА НомераГТДПрослеживаемыеКомплектующие.Ссылка.НаименованиеТовара = """"
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Номенклатура)
	|		ИНАЧЕ НомераГТДПрослеживаемыеКомплектующие.Ссылка.НаименованиеТовара
	|	КОНЕЦ КАК Наименование,
	|	НомераГТДПрослеживаемыеКомплектующие.СуммаПоРНПТ КАК СуммаПоРНПТ,
	|	ВидыЗапасовРНПТКомплекты.Количество КАК Количество,
	|	&УпаковкиКомплекты КАК Упаковка,
	|	ВидыЗапасовРНПТКомплекты.НомерГТД.ТипНомераГТД КАК ТипНомераГТД,
	|	НомераГТДПрослеживаемыеКомплектующие.НомерРНПТ.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ВидыЗапасовРНПТКомплекты.НомерГТД.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТ) КАК ЯвляетсяРНПТ,
	|	ВидыЗапасовРНПТКомплекты.Ссылка КАК Ссылка,
	|	ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Серия КАК Серия,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ РНПТКомплектов
	|ИЗ
	|	ТабличнаяЧастьВидовЗапасов КАК ВидыЗапасовРНПТКомплекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД.ПрослеживаемыеКомплектующие КАК НомераГТДПрослеживаемыеКомплектующие
	|		ПО ВидыЗапасовРНПТКомплекты.НомерГТД = НомераГТДПрослеживаемыеКомплектующие.Ссылка 
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО (СправочникНоменклатура.Ссылка = ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Номенклатура)
	|ГДЕ
	|	ВидыЗапасовРНПТКомплекты.Ссылка В(&Ссылки)
	|	И НЕ ВидыЗапасовРНПТКомплекты.НомерГТД = ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)
	|	И ВидыЗапасовРНПТКомплекты.НомерГТД.ТипНомераГТД = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РНПТ.НомерГТД КАК РНПТ,
	|	РНПТ.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	РНПТ.НомерРНПТ КАК НомерРНПТ,
	|	РНПТ.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	РНПТ.ЕдиницаИзмеренияТНВЭД КАК ЕдиницаИзмеренияТНВЭД,
	|	РНПТ.Номенклатура КАК Номенклатура,
	|	РНПТ.Наименование КАК НаименованиеТовара,
	|	РНПТ.СуммаПоРНПТ КАК СуммаРНПТ,
	|	РНПТ.Количество КАК Количество,
	|	РНПТ.Упаковка КАК ЕдиницаИзмеренияРНПТ,
	|	РНПТ.ТипНомераГТД КАК ТипНомераГТД,
	|	РНПТ.СтранаПроисхождения КАК СтранаПроисхождения,
	|	РНПТ.ЯвляетсяРНПТ КАК ЯвляетсяРНПТ,
	|	РНПТ.НомерГТД КАК НомерГТД,
	|	РНПТ.Ссылка КАК Ссылка,
	|	РНПТ.Характеристика КАК Характеристика,
	|	РНПТ.Серия КАК Серия,
	|	РНПТ.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТ_Итоговая
	|ИЗ
	|	РНПТ КАК РНПТ
	|
	|&ОБЪЕДИНИТЬСУСЛОВИЕМ 
	|
	|ВЫБРАТЬ
	|	РНПТКомплектов.НомерГТД,
	|	РНПТКомплектов.ИдентификаторСтроки,
	|	РНПТКомплектов.НомерРНПТ,
	|	РНПТКомплектов.КоличествоПоРНПТ,
	|	РНПТКомплектов.ЕдиницаИзмеренияТНВЭД,
	|	РНПТКомплектов.Номенклатура,
	|	РНПТКомплектов.Наименование,
	|	РНПТКомплектов.СуммаПоРНПТ,
	|	РНПТКомплектов.Количество,
	|	РНПТКомплектов.Упаковка,
	|	РНПТКомплектов.ТипНомераГТД,
	|	РНПТКомплектов.СтранаПроисхождения,
	|	РНПТКомплектов.ЯвляетсяРНПТ,
	|	РНПТКомплектов.НомерГТД,
	|	РНПТКомплектов.Ссылка,
	|	РНПТКомплектов.Характеристика,
	|	РНПТКомплектов.Серия,
	|	РНПТКомплектов.ЕдиницаИзмерения
	|ИЗ
	|	РНПТКомплектов КАК РНПТКомплектов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итоговая.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВТ_Итоговая.РНПТ КАК РНПТ,
	|	ВТ_Итоговая.НомерРНПТ КАК НомерРНПТ,
	|	ВТ_Итоговая.КоличествоПоРНПТ КАК КоличествоРНПТ,
	|	ВТ_Итоговая.ЕдиницаИзмеренияТНВЭД КАК ЕдиницаИзмеренияТНВЭД,
	|	ВТ_Итоговая.Номенклатура КАК Номенклатура,
	|	ВТ_Итоговая.НаименованиеТовара КАК НаименованиеТовара,
	|	ВТ_Итоговая.СуммаРНПТ КАК СуммаРНПТ,
	|	ВТ_Итоговая.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ВТ_Итоговая.ЕдиницаИзмеренияРНПТ = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ВТ_Итоговая.ЕдиницаИзмерения
	|		ИНАЧЕ ВТ_Итоговая.ЕдиницаИзмеренияРНПТ
	|	КОНЕЦ КАК ЕдиницаИзмеренияРНПТ,
	|	ВТ_Итоговая.ТипНомераГТД КАК ТипНомераГТД,
	|	"""" КАК ТипКорректировочнойСтроки,
	|	ВТ_Итоговая.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ВТ_Итоговая.ЯвляетсяРНПТ КАК ЯвляетсяРНПТ,
	|	ВТ_Итоговая.НомерГТД КАК НомерГТД
	|ИЗ
	|	ВТ_Итоговая КАК ВТ_Итоговая";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТабличнаяЧастьВидовЗапасов", ИмяТаблицы);  
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ОБЪЕДИНИТЬСУСЛОВИЕМ", ?(ОбъединитьСУсловием = Истина, "ОБЪЕДИНИТЬ ВСЕ", "ОБЪЕДИНИТЬ"));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Если ПроверкаОтсутствияУпаковок.Найти(ИмяМетаданных)<> Неопределено  Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Упаковка", "Значение(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УпаковкиКомплекты", "Значение(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Упаковка", "ТаблицаВидыЗапасов.Упаковка");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УпаковкиКомплекты", "ВидыЗапасовРНПТКомплекты.Упаковка");
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеИБСсылка, ИмяТаблицыСтрокой) 
		И МетаданныеТабличныхЧастей[ИмяТаблицыСтрокой].Реквизиты.Найти("ИдентификаторСтроки") = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИдентификаторСтроки1", """" + Строка(Новый УникальныйИдентификатор()) + """");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИдентификаторСтроки2", """" + Строка(Новый УникальныйИдентификатор())+ """");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИдентификаторСтроки1", "ТаблицаВидыЗапасов.ИдентификаторСтроки");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИдентификаторСтроки2", "ВидыЗапасовРНПТКомплекты.ИдентификаторСтроки");
	КонецЕсли; 
	Если Найти(ИмяТаблицы, "Товары") > 0 ИЛИ Найти(ИмяТаблицы, "Расхождения") > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РСАналитикаУчетаНоменклатуры", "ТаблицаВидыЗапасов"); 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "АналитикаУчетаНоменклатуры.Наименование", "Номенклатура.Наименование");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "АналитикаУчетаНоменклатуры.", "");
	КонецЕсли;
	Если ИмяМетаданных = "СписаниеИзЭксплуатации" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НомераГТДПрослеживаемыеКомплектующие.Ссылка.НаименованиеТовара", "ВидыЗапасовРНПТКомплекты.Номенклатура.Наименование");
	КонецЕсли;
	Если ИмяМетаданных = "УведомлениеОВвозеПрослеживаемыхТоваров" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВидыЗапасов.Характеристика", "ТаблицаВидыЗапасов.АналитикаУчетаНоменклатуры.Характеристика");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВидыЗапасов.Серия", "ТаблицаВидыЗапасов.АналитикаУчетаНоменклатуры.Серия");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВидыЗапасовРНПТКомплекты.Характеристика", "ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Характеристика");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВидыЗапасовРНПТКомплекты.Серия", "ВидыЗапасовРНПТКомплекты.АналитикаУчетаНоменклатуры.Серия"); 
	КонецЕсли;
	Если НЕ ИдентификаторыИзВидовЗапасов И Найти(ИмяТаблицы, "ВидыЗапасов") > 0 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеИБСсылка, "Товары") 
		И МетаданныеТабличныхЧастей.Товары.Реквизиты.Найти("ИдентификаторСтроки") <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МАКСИМУМ(ТаблицаТовары.ИдентификаторСтроки) КАК ИдентификаторСтроки,
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.Характеристика КАК Характеристика,
		|	ТаблицаТовары.Серия КАК Серия,
		|	ТаблицаТовары.Ссылка КАК Ссылка
		|	ПОМЕСТИТЬ ВТ_ИдентификаторыСтрок
		|ИЗ
		|		ТабличнаяЧастьТовары КАК ТаблицаТовары
		|ГДЕ
		|		ТаблицаТовары.Ссылка В (&Ссылки)
		|	
		|СГРУППИРОВАТЬ ПО
		|		ТаблицаТовары.Номенклатура,
		|		ТаблицаТовары.Характеристика,
		|		ТаблицаТовары.Серия,
		|		ТаблицаТовары.Ссылка
		|	;
		|	
		|	////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итоговая.РНПТ КАК РНПТ,
		|	МАКСИМУМ(ВЫБОР
		|	КОГДА ВТ_ИдентификаторыСтрок.ИдентификаторСтроки = """"
		|	ТОГДА ВТ_Итоговая.ИдентификаторСтроки
		|	ИНАЧЕ ЕСТЬNULL(ВТ_ИдентификаторыСтрок.ИдентификаторСтроки, ВТ_Итоговая.ИдентификаторСтроки)
		|	КОНЕЦ) КАК ИдентификаторСтроки,
		|	ВТ_Итоговая.НомерРНПТ КАК НомерРНПТ,
		|	ВТ_Итоговая.КоличествоПоРНПТ КАК КоличествоРНПТ,
		|	ВТ_Итоговая.ЕдиницаИзмеренияТНВЭД КАК ЕдиницаИзмеренияТНВЭД,
		|	ВТ_Итоговая.Номенклатура КАК Номенклатура,
		|	ВТ_Итоговая.НаименованиеТовара КАК НаименованиеТовара,
		|	ВТ_Итоговая.СуммаРНПТ КАК СуммаРНПТ,
		|	ВТ_Итоговая.Количество КАК Количество,
		|	ВТ_Итоговая.ЕдиницаИзмеренияРНПТ КАК ЕдиницаИзмеренияРНПТ,
		|	ВТ_Итоговая.ТипНомераГТД КАК ТипНомераГТД,
		|	ВТ_Итоговая.СтранаПроисхождения КАК СтранаПроисхождения,
		|	ВТ_Итоговая.ЯвляетсяРНПТ КАК ЯвляетсяРНПТ,
		|	ВТ_Итоговая.НомерГТД КАК НомерГТД,
		|	ВТ_Итоговая.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Итоговая КАК ВТ_Итоговая
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыСтрок КАК ВТ_ИдентификаторыСтрок
		|	ПО (ВТ_Итоговая.Ссылка = ВТ_ИдентификаторыСтрок.Ссылка)
		|	И (ВТ_ИдентификаторыСтрок.Номенклатура = ВТ_Итоговая.Номенклатура)
		|	И (ВТ_ИдентификаторыСтрок.Характеристика = ВТ_Итоговая.Характеристика)
		|	И (ВТ_ИдентификаторыСтрок.Серия = ВТ_Итоговая.Серия)
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Итоговая.РНПТ,
		|	ВТ_Итоговая.НомерРНПТ,
		|	ВТ_Итоговая.КоличествоПоРНПТ,
		|	ВТ_Итоговая.ЕдиницаИзмеренияТНВЭД,
		|	ВТ_Итоговая.Номенклатура,
		|	ВТ_Итоговая.НаименованиеТовара,
		|	ВТ_Итоговая.СуммаРНПТ,
		|	ВТ_Итоговая.Количество,
		|	ВТ_Итоговая.ЕдиницаИзмеренияРНПТ,
		|	ВТ_Итоговая.ТипНомераГТД,
		|	ВТ_Итоговая.СтранаПроисхождения,
		|	ВТ_Итоговая.ЯвляетсяРНПТ,
		|	ВТ_Итоговая.НомерГТД,
		|	ВТ_Итоговая.Ссылка,
		|	ВТ_ИдентификаторыСтрок.ИдентификаторСтроки,
		|	ВТ_Итоговая.ИдентификаторСтроки";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТабличнаяЧастьТовары", СтрЗаменить(ИмяТаблицы, ИмяТаблицыСтрокой, "Товары")); 
		Если МетаданныеТабличныхЧастей.Товары.Реквизиты.Найти("Серия") = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТовары.Серия", "Значение(Справочник.СерииНоменклатуры.ПустаяСсылка)");
		КонецЕсли;
	КонецЕсли; 
	Попытка
		СведенияПрослеживаемости = Запрос.Выполнить().Выгрузить();
	Исключение
		СведенияПрослеживаемости = Неопределено;
	КонецПопытки;
	#Удаление
	Если НЕ СведенияПрослеживаемости = Неопределено И НЕ СведенияПрослеживаемости.Количество() = 0 Тогда
	#КонецУдаления
	#Вставка
	Если НЕ СведенияПрослеживаемости = Неопределено Тогда
	#КонецВставки
		ДанныеXDTO.Вставить("СведенияРНПТ", СведенияПрослеживаемости);
	КонецЕсли;
КонецПроцедуры

&ИзменениеИКонтроль("ДобавитьПОД_Документ_ВнутреннееПотребление_Отправка")
Процедура АУ_ДобавитьПОД_Документ_ВнутреннееПотребление_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Документ_ВнутреннееПотребление_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.ВнутреннееПотребление;
	ПравилоОбработки.ПриОбработке            = "ПОД_Документ_ВнутреннееПотребление_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВнутреннееПотребление_ВПроизводство_Отпр");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВнутреннееПотребление_ВСписаниеЗапас_Отпр");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ВнутреннееПотребление_ВЭксплуатацию_Отпра");
	#Вставка
	ПравилоОбработки.ИспользуемыеПКО.Добавить("АУ_Документ_ВнутреннееПотребление_ПередачаПереработчику");
	#КонецВставки
КонецПроцедуры

&ИзменениеИКонтроль("ПОД_Документ_ВнутреннееПотребление_Отправка_ПриОбработке")
Процедура АУ_ПОД_Документ_ВнутреннееПотребление_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию Тогда
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Аналитика.Номенклатура КАК Номенклатура,
			|	ВПТ_Товары.Характеристика КАК Характеристика,
			|	ВПТ_Товары.Серия КАК Серия,
			|	ВПТ_Товары.Упаковка КАК Упаковка,
			|	СУММА(ВПТ_Товары.КоличествоУпаковок) КАК КоличествоУпаковок,
			|	Аналитика.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	СУММА(ВПТ_ВидыЗапасов.Количество) КАК Количество,
			|	СУММА(ВПТ_ВидыЗапасов.КоличествоПоРНПТ) КАК КоличествоПоРНПТ,
			|	ВПТ_ВидыЗапасов.НомерГТД КАК НомерГТД,
			|	ВПТ_ВидыЗапасов.СтатьяРасходов КАК СтатьяРасходов,
			|	ВПТ_Шапка.Подразделение КАК Подразделение,
			|	ВЫБОР
			|		КОГДА ВПТ_ВидыЗапасов.ГруппаПродукции = ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(Аналитика.Номенклатура.ГруппаАналитическогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка))
			|		ИНАЧЕ ВПТ_ВидыЗапасов.ГруппаПродукции
			|	КОНЕЦ КАК ГруппаАналитическогоУчетаНоменклатуры,
			|	ВЫБОР
			|		КОГДА ВПТ_ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
			|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
			|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
			|	КОНЕЦ КАК ТипЗапасов
			|ПОМЕСТИТЬ ТоварыВсе
			|ИЗ
			|	Документ.ВнутреннееПотребление КАК ВПТ_Шапка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотребление.ВидыЗапасов КАК ВПТ_ВидыЗапасов
			|		ПО (ВПТ_ВидыЗапасов.Ссылка = ВПТ_Шапка.Ссылка)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
			|		ПО (ВПТ_ВидыЗапасов.АналитикаУчетаНоменклатуры = Аналитика.КлючАналитики)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотребление.Товары КАК ВПТ_Товары
			|		ПО (ВПТ_Товары.Ссылка = ВПТ_Шапка.Ссылка)
			|			И (ВПТ_Товары.ИдентификаторСтроки = ВПТ_ВидыЗапасов.ИдентификаторСтроки)
			|ГДЕ
			|	ВПТ_Шапка.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	Аналитика.Номенклатура,
			|	Аналитика.Номенклатура.ЕдиницаИзмерения,
			|	ВПТ_ВидыЗапасов.НомерГТД,
			|	ВПТ_ВидыЗапасов.СтатьяРасходов,
			|	ВПТ_Шапка.Подразделение,
			|	ВЫБОР
			|		КОГДА ВПТ_ВидыЗапасов.ГруппаПродукции = ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(Аналитика.Номенклатура.ГруппаАналитическогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка))
			|		ИНАЧЕ ВПТ_ВидыЗапасов.ГруппаПродукции
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА ВПТ_ВидыЗапасов.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
			|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(20))
			|		ИНАЧЕ ВЫРАЗИТЬ(&СобственныеТовары КАК СТРОКА(20))
			|	КОНЕЦ,
			|	ВПТ_Товары.Характеристика,
			|	ВПТ_Товары.Упаковка,
			|	ВПТ_Товары.Серия
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ТипЗапасов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаУпаковка,
			|	&ТекстЗапросаРНПТ,
			|	&ТекстЗапросаГТД,
			|	Товары.Количество КАК Количество,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(7)) КАК СчетЗатрат,
			|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка) КАК СтатьяЗатрат,
			|	Товары.СтатьяРасходов КАК СтатьяРасходов,
			|	Товары.Подразделение КАК Подразделение,
			|	Товары.ГруппаАналитическогоУчетаНоменклатуры КАК ГруппаАналитическогоУчетаНоменклатуры,
			|	Товары.ТипЗапасов КАК ТипЗапасов
			|ИЗ
			|	ТоварыВсе КАК Товары
			|ГДЕ
			|	Товары.ТипЗапасов = &СобственныеТовары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаУпаковка,
			|	&ТекстЗапросаРНПТ,
			|	&ТекстЗапросаГТД,
			|	Товары.Количество КАК Количество,
			|	Товары.ТипЗапасов КАК ТипЗапасов
			|ИЗ
			|	ТоварыВсе КАК Товары
			|ГДЕ
			|	Товары.ТипЗапасов = ""КомиссионныеТовары""";
			
		ЗаполнитьСобственныеТоварыВТексте(ТекстЗапроса);
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
			ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаУпаковка",
			ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "Товары"));
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
			ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаРНПТ",
			ПолучитьТекстЗапросаРНПТ(КомпонентыОбмена, "Товары"));
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаГТД",
			ПолучитьТекстЗапросаГТД(КомпонентыОбмена, "Товары"));
			
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
		Запрос.УстановитьПараметр("ЭтоУТ", ЭтоУТ());
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		СобственныеТовары = РезультатЗапроса[1].Выгрузить();
		СобственныеТовары.Колонки.Добавить("ПодразделениеЗатрат");
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, СобственныеТовары);
		
		КомиссионныеТовары = РезультатЗапроса[2].Выгрузить();
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, КомиссионныеТовары);
		
		Для Каждого СтрокаСобственныеТовары Из СобственныеТовары Цикл
			Если ЗначениеЗаполнено(СтрокаСобственныеТовары.Подразделение) Тогда
				СтруктураПодразделение = Новый Структура;
				ВыгрузитьПодразделение(ДанныеИБ, СтруктураПодразделение, СтрокаСобственныеТовары.Подразделение);
				СтрокаСобственныеТовары.ПодразделениеЗатрат = СтруктураПодразделение.Подразделение;
			КонецЕсли;
		
			Если ЗначениеЗаполнено(СтрокаСобственныеТовары.ГруппаАналитическогоУчетаНоменклатуры)
				И СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.ГруппыАналитическогоУчетаНоменклатуры") Тогда //@NON-NLS-1
				СтруктураАналитики = Новый Структура;
				СтруктураАналитики.Вставить("Значение", СтрокаСобственныеТовары.ГруппаАналитическогоУчетаНоменклатуры);
				СтруктураАналитики.Вставить("ИмяПКО", ?(СтрокаСобственныеТовары.ГруппаАналитическогоУчетаНоменклатуры.ЭтоГруппа,
					"Спр_ГруппыАналитическогоУчетаНоменклатурыГруппа", "Спр_ГруппыАналитическогоУчетаНоменклатуры"));
				СтрокаСобственныеТовары.ГруппаАналитическогоУчетаНоменклатуры = СтруктураАналитики;
			КонецЕсли;
			
			СобственныеТоварыСчетУчета = Неопределено;
			СтрокаСобственныеТовары.СчетЗатрат = СчетУчетаПоСтатье(СтрокаСобственныеТовары.СтатьяРасходов,
				ДанныеИБ.Организация, ДанныеИБ.Подразделение, ДанныеИБ.Дата);
			//++ Локализация
			
				
			Если ТипЗнч(СтрокаСобственныеТовары.СтатьяРасходов) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
				СтрокаСобственныеТовары.СтатьяЗатрат = СтрокаСобственныеТовары.СтатьяРасходов;
			КонецЕсли;
			//-- Локализация
		КонецЦикла;
		
		Если СобственныеТовары.Количество() > 0 Тогда
			ДанныеИБ.ДополнительныеСвойства.Вставить("СобственныеТовары", СобственныеТовары);
			ИспользованиеПКО.Документ_ВнутреннееПотребление_ВПроизводство_Отпр = Истина;
		КонецЕсли;
		
		Если КомиссионныеТовары.Количество() > 0 Тогда    
			ДанныеИБ.ДополнительныеСвойства.Вставить("КомиссионныеТовары", КомиссионныеТовары);
			ИспользованиеПКО.Документ_ВнутреннееПотребление_ВСписаниеЗапас_Отпр = Истина;
		КонецЕсли;
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаВЭксплуатацию Тогда
		ИспользованиеПКО.Документ_ВнутреннееПотребление_ВЭксплуатацию_Отпра = Истина;
	#Вставка
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5 Тогда
		ИспользованиеПКО.АУ_Документ_ВнутреннееПотребление_ПередачаПереработчику = Истина;
	#КонецВставки
	КонецЕсли;
КонецПроцедуры

&ИзменениеИКонтроль("ДобавитьПОД_Документ_ПрочееОприходованиеТоваров_Отправка")
Процедура АУ_ДобавитьПОД_Документ_ПрочееОприходованиеТоваров_Отправка(ПравилаОбработкиДанных)

	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
