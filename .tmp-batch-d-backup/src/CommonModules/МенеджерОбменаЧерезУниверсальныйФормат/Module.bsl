	#Вставка
	ДобавитьПКС(СвойстваТЧ, "", "Контракт", 1, "Справочник_ДоговорыКонтрагентов");
	#КонецВставки

КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Документ_ПоступлениеТоваровУслуг_Отправка_ПриОтправкеДанных")
Процедура АУ_ПКО_Документ_ПоступлениеТоваровУслуг_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_ПоступлениеТоваровУслуг_Отправка", 
										"Товары", 
										"НомерГТД", 
										Истина,
										"Справочник_НомераГТД_Отправка");
	КонецЕсли; 
	Если ВерсияФормата17ИВыше Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_ПоступлениеТоваровУслуг_Отправка", 
										"Товары", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка"); 
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
										"Документ_ПоступлениеТоваровУслуг_Отправка", 
										"Услуги", 
										"СтавкаНДС",
										Истина,
										"СправочникСсылка_СтавкиНДС_Отправка");
										
	КонецЕсли;
	
	РасширенныеДанныеИБ = ПТиУ_РасширенныеДанныеИБ(КомпонентыОбмена, ДанныеИБ);
	
	ДанныеXDTO.Вставить("КурсВзаиморасчетов",      РасширенныеДанныеИБ.КурсВзаиморасчетов);
	ДанныеXDTO.Вставить("КратностьВзаиморасчетов", РасширенныеДанныеИБ.КратностьВзаиморасчетов);
	
	// Склад
	СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации, Истина);
	ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	
	//Заказ
	Если ЗначениеЗаполнено(ДанныеИБ.ЗаказПоставщику)
		И ОбщегоНазначения.СсылкаСуществует(ДанныеИБ.ЗаказПоставщику)
		И ОбъектПроходитПоФильтрамВидовДокументовУзла(ДанныеИБ.ЗаказПоставщику, КомпонентыОбмена) Тогда
		
		Инструкция = Новый Структура("Значение, ИмяПКО",
					ДанныеИБ.ЗаказПоставщику,
					"Документ_ЗаказПоставщику_Отправка");
		ДанныеXDTO.Вставить("Заказ", Инструкция);
	КонецЕсли;
	
	ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "Склад");
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	ВыгрузитьПризнакКомплектПечатныхДокументовПодписан(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	// ВидОперации
	// При выключенной ФО "Использовать комиссию при продаже" реквизит "Хозяйственная операция"
	// может быть не заполнен, что означает обычную реализацию.
	ДанныеXDTO.Вставить("ВидОперации");
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию Тогда
		ДанныеXDTO.ВидОперации = "ПриемНаКомиссию";
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭСНеотфактурованнаяПоставка
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭСПоступлениеИзТоваровВПути
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭСТоварыВПути
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭСФактуровкаПоставки
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпортуПоступлениеИзТоваровВПути 
		Или ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпортуТоварыВПути 
		ИЛИ ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчикаВСтранахЕАЭС2_5 Тогда
		ДанныеXDTO.ВидОперации = "ЗакупкаПоИмпорту";
	Иначе
		ДанныеXDTO.ВидОперации = "ПокупкаУПоставщика";
	КонецЕсли;
	
	// Дополнительные свойства для договора
	Если ЗначениеЗаполнено(ДанныеИБ.Договор) Тогда
		ДанныеXDTO.Вставить("Договор", ДанныеИБ.Договор);
	Иначе
		ПараметрыПоУмолчанию = Новый Структура(ДоговорФиксированнаяСтруктураКлючей());
		ПараметрыПоУмолчанию.Контрагент = ДанныеИБ.Контрагент;
		ПараметрыПоУмолчанию.Организация = ДанныеИБ.Организация;
		ПараметрыПоУмолчанию.ВалютаВзаиморасчетов = ДанныеИБ.ВалютаВзаиморасчетов;
		ПараметрыПоУмолчанию.ВидДоговора = ?(ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию,
			"СКомитентом", "СПоставщиком");
		ПараметрыПоУмолчанию.Дата = ДанныеИБ.Дата;
		ПараметрыПоУмолчанию.Номер = ДанныеИБ.Номер;
		Если ЗначениеЗаполнено(ДанныеИБ.Соглашение) Тогда
			ДанныеРасчетаУЕ          = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.Соглашение, "ВалютаВзаиморасчетов, ОплатаВВалюте, Организация");
			РасчетыВУсловныхЕдиницах = ВедетсяРасчетВУЕ(ДанныеРасчетаУЕ.ВалютаВзаиморасчетов, ДанныеРасчетаУЕ.ОплатаВВалюте, ДанныеРасчетаУЕ.Организация, КомпонентыОбмена);
		Иначе
			РасчетыВУсловныхЕдиницах = ДанныеИБ.Валюта = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ДанныеИБ.Организация) И ДанныеИБ.Валюта <> ДанныеИБ.ВалютаВзаиморасчетов;
		КонецЕсли;
		ПараметрыПоУмолчанию.РасчетыВУсловныхЕдиницах = РасчетыВУсловныхЕдиницах;
		
		Заказ = Новый Структура("Заказ, Соглашение, Сделка",  ДанныеИБ.ЗаказПоставщику, ДанныеИБ.Соглашение, Неопределено);
		Договор = ДоговорИнструкцияКонвертацииПоДаннымВзаиморасчетов(ПараметрыПоУмолчанию, КомпонентыОбмена, Заказ, ДанныеИБ);
		ДанныеXDTO.Вставить("Договор", Договор);
	КонецЕсли;
	
	// Товары
	Товары = РасширенныеДанныеИБ.Товары;
	#Вставка
	Товары.Колонки.Добавить("Контракт");
	Для каждого стрТовары Из Товары Цикл

		СтрокаДокумента=ДанныеИБ.Ссылка.Товары[стрТовары.НомерСтрокиДокумента-1];
		Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказПоставщику) Тогда

			Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказПоставщику.ДокументОснование) И ТипЗнч(СтрокаДокумента.ЗаказПоставщику.ДокументОснование)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
				стрТовары.Контракт=СтрокаДокумента.ЗаказПоставщику.ДокументОснование.Договор;
			КонецЕсли;

			НайденныеСтроки=СтрокаДокумента.ЗаказПоставщику.Товары.НайтиСтроки(Новый Структура("КодСтроки",СтрокаДокумента.КодСтроки));
			Если НайденныеСтроки.Количество()>0 Тогда

				Если ЗначениеЗаполнено(НайденныеСтроки[0].АУ_ЗаказКлиента) Тогда
					стрТовары.Контракт=НайденныеСтроки[0].АУ_ЗаказКлиента.Договор;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;
	#КонецВставки
	Если Товары.Количество() > 0 Тогда
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары);
		ЗаполнитьВидДеятельностиНДСВТЧ(КомпонентыОбмена, ДанныеИБ, Товары, "ЗакупкаПодДеятельность", "ЗакупкаПодДеятельность");
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	// Услуги, РасшифровкаДопРасходов
	Услуги = РасширенныеДанныеИБ.Услуги;
	#Вставка
	Услуги.Колонки.Добавить("Контракт");
	Для каждого стрУслуги Из Услуги Цикл

		СтрокаДокумента=ДанныеИБ.Ссылка.Товары.Найти(стрУслуги.ИдентификаторСтроки);
		Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказПоставщику) Тогда

			Если ЗначениеЗаполнено(СтрокаДокумента.ЗаказПоставщику.ДокументОснование) И ТипЗнч(СтрокаДокумента.ЗаказПоставщику.ДокументОснование)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
				стрУслуги.Контракт=СтрокаДокумента.ЗаказПоставщику.ДокументОснование.Договор;
			КонецЕсли;

			НайденныеСтроки=СтрокаДокумента.ЗаказПоставщику.Товары.НайтиСтроки(Новый Структура("КодСтроки",СтрокаДокумента.КодСтроки));
			Если НайденныеСтроки.Количество()>0 Тогда

				Если ЗначениеЗаполнено(НайденныеСтроки[0].АУ_ЗаказКлиента) Тогда
					стрУслуги.Контракт=НайденныеСтроки[0].АУ_ЗаказКлиента.Договор;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;
	#КонецВставки
	РасшифровкаДопРасходов = РасширенныеДанныеИБ.РасшифровкаДопРасходов.Скопировать();
	РасшифровкаДопРасходов.Колонки.ДокументПоступления.Имя = "ДокументПоступленияСсылка";
	// Необходима новая колонка с произвольным типом, чтобы можно было записать туда значение типа Структура.
	РасшифровкаДопРасходов.Колонки.Добавить("ДокументПоступления");
	
	////Сведения РНПТ   
	
	//++ Локализация
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ИмяТаблицы = "Документ.ПриобретениеТоваровУслуг.Товары"; 
		ИдентификаторыИзВидовЗапасов = Ложь;
		ПолучитьСведенияОПрослеживаемости(ИмяТаблицы, ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ИдентификаторыИзВидовЗапасов);  
	КонецЕсли;
	//-- Локализация
		
	// Не переносим как допрасходы, если есть незаполненные документы поступления.
	НетБазыДляРаспределения = (РасшифровкаДопРасходов.Количество()=0);
	ТипСоставногоСвойства = Неопределено; 
	ВсегоСтрок = РасшифровкаДопРасходов.Количество();
	Если ВсегоСтрок > 0 И НЕ ВерсияФормата17ИВыше Тогда
		Для Счетчик = 0 По ВсегоСтрок - 1 Цикл 
			ТекущаяСтрока = РасшифровкаДопРасходов[ВсегоСтрок - Счетчик - 1];
			Если ТИПЗНЧ(ТекущаяСтрока.ДокументПоступленияСсылка) = ТИП("ДокументСсылка.СборкаТоваров") Тогда
				РасшифровкаДопРасходов.Удалить(ТекущаяСтрока);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровкаДопРасходов Из РасшифровкаДопРасходов Цикл
		Если Не ЗначениеЗаполнено(СтрокаРасшифровкаДопРасходов.ДокументПоступленияСсылка) Тогда
			НетБазыДляРаспределения = Истина;
			Прервать;
		ИначеЕсли СтрокаРасшифровкаДопРасходов.ДокументПоступленияСсылка = ДанныеИБ.Ссылка Тогда
			// Обходим защиту от зацикливания - записываем в качестве документа поступления уже преобразованное значение ссылки.
			СтрокаРасшифровкаДопРасходов.ДокументПоступления = ДанныеXDTO.КлючевыеСвойства;
			Если ТипСоставногоСвойства = Неопределено Тогда
				ТекПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Документ_ПоступлениеТоваровУслуг_Отправка");
				ТипСоставногоСвойства = ТекПКО.ТипКлючевыхСвойствОбъектаXDTO;
			КонецЕсли;
			СтрокаРасшифровкаДопРасходов.ДокументПоступления.Вставить("ТипСоставногоСвойства", ТипСоставногоСвойства); 
		ИначеЕсли ТипЗНЧ(СтрокаРасшифровкаДопРасходов.ДокументПоступленияСсылка) = ТИП("ДокументСсылка.СборкаТоваров") И ВерсияФормата17ИВыше Тогда 
			Инструкция = Новый Структура("Значение, ИмяПКО", СтрокаРасшифровкаДопРасходов.ДокументПоступленияСсылка, "Документ_СборкаТоваров");
			СтрокаРасшифровкаДопРасходов.ДокументПоступления = Инструкция;
	        Иначе
			
			ЭтоВнутреннееПеремещение = (ТипЗнч(СтрокаРасшифровкаДопРасходов.ДокументПоступленияСсылка) = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями"));
			ПоступлениеИмяПКО = ?(ЭтоВнутреннееПеремещение, "ПередачаМеждуОрганизациями_ПТУ_Отправка", "Документ_ПоступлениеТоваровУслуг_Отправка");
			ОписаниеКонвертации = Новый Структура("Значение, ИмяПКО", СтрокаРасшифровкаДопРасходов.ДокументПоступленияСсылка, ПоступлениеИмяПКО);
			СтрокаРасшифровкаДопРасходов.ДокументПоступления = ОписаниеКонвертации;
			
		КонецЕсли;
	КонецЦикла;
		
	Если НетБазыДляРаспределения Тогда
		Услуги.ЗаполнитьЗначения(Ложь, "ЭтоДопРасходы");
		РасшифровкаДопРасходов.Очистить();
	КонецЕсли;
	
	Если Услуги.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	Если РасшифровкаДопРасходов.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("РасшифровкаДопРасходов", РасшифровкаДопРасходов);
		#Удаление
		Услуги.ЗаполнитьЗначения(Истина, "ЭтоДопРасходы");
		#КонецУдаления
	КонецЕсли;
	
	//++ Локализация
	#Область АкцизныеМарки
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7") Тогда
		АкцизныеМарки = РасширенныеДанныеИБ.АкцизныеМарки;	
		ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, АкцизныеМарки); 
		ЗаполнитьТипАкцизнойМаркиВТЧ(КомпонентыОбмена, АкцизныеМарки);
		ДанныеXDTO.Вставить("АкцизныеМарки", АкцизныеМарки);
	КонецЕсли;
	
	#КонецОбласти
	
	#Область МаркировкиУпаковок
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7") Тогда
		МаркировкиУпаковок = РасширенныеДанныеИБ.МаркировкиУпаковок;	
		ДанныеXDTO.Вставить("МаркировкиУпаковок", МаркировкиУпаковок);
	КонецЕсли;
	
	#КонецОбласти
	//-- Локализация
	
	#Область ПогашениеЗадолженности
	
	Если ДанныеИБ.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
	
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	ПриобретениеТоваровУслугРасшифровкаПлатежа.ОбъектРасчетов.Объект КАК Заказ,
			|	СУММА(ПриобретениеТоваровУслугРасшифровкаПлатежа.Сумма) КАК Сумма
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг.РасшифровкаПлатежа КАК ПриобретениеТоваровУслугРасшифровкаПлатежа
			|ГДЕ
			|	ПриобретениеТоваровУслугРасшифровкаПлатежа.Ссылка = &Ссылка
			|	И ТИПЗНАЧЕНИЯ(ПриобретениеТоваровУслугРасшифровкаПлатежа.ОбъектРасчетов.Объект) В (&ТипыПлатежныхДокументов)
			|	И ПриобретениеТоваровУслугРасшифровкаПлатежа.ОбъектРасчетов.Объект.Дата < ПриобретениеТоваровУслугРасшифровкаПлатежа.Ссылка.Дата
			|
			|СГРУППИРОВАТЬ ПО
			|	ПриобретениеТоваровУслугРасшифровкаПлатежа.ОбъектРасчетов.Объект");
		
		ТипыПлатежныхДокументов = Новый Массив;
		ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"));
		ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.РасходныйКассовыйОрдер"));
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
		Запрос.УстановитьПараметр("ТипыПлатежныхДокументов", ТипыПлатежныхДокументов);
		
		ТаблицаЗачтено = Запрос.Выполнить().Выгрузить();
		ТаблицаЗачтено.Колонки.Добавить("ДокументРасчетов", Новый ОписаниеТипов("Структура"));
		МассивУдаляемыхСтрок = Новый Массив;
		
		Для Каждого СтрЗачтено Из ТаблицаЗачтено Цикл
			ИмяПКО = ИмяПКОДляОбъектаДанных(КомпонентыОбмена, СтрЗачтено.Заказ, ДанныеИБ.Организация);
			Если ЗначениеЗаполнено(ИмяПКО) Тогда
				СтрДокументРасчетов = Новый Структура("Значение, ИмяПКО", СтрЗачтено.Заказ, ИмяПКО);
				СтрЗачтено.ДокументРасчетов = СтрДокументРасчетов;
			Иначе
				МассивУдаляемыхСтрок.Добавить(СтрЗачтено);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(МассивУдаляемыхСтрок) Тогда
			Для Каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
				ТаблицаЗачтено.Удалить(УдаляемаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
		ДанныеXDTO.Вставить("ПогашениеЗадолженности", ТаблицаЗачтено);
		
		//++ Локализация
		Если ТаблицаЗачтено.Количество() > 0 Тогда
			ДанныеXDTO.Вставить("СпособПогашенияЗадолженности", СпособПогашенияЗадолженностиДокумента(КомпонентыОбмена, ДанныеИБ));
		КонецЕсли;
		//-- Локализация 
			
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		ЗаполнитьСерииПоДокументу(ДанныеИБ.Ссылка, "Документ.ПриобретениеТоваровУслуг.Серии", ДанныеXDTO);
	КонецЕсли;
	#КонецОбласти
КонецПроцедуры

&После("ПКО_Документ_РеализацияТоваровУслуг_Отправка_ПриОтправкеДанных")
Процедура АУ_ПКО_Документ_РеализацияТоваровУслуг_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)

	Попытка
		ДанныеXDTO.Вставить("ЭтоУниверсальныйДокумент", ДанныеИБ.ЭтоУниверсальныйДокумент);
	Исключение
		ДанныеXDTO.Вставить("ЭтоУниверсальныйДокумент", Ложь);
	КонецПопытки;

КонецПроцедуры

&ИзменениеИКонтроль("ДобавитьПКО_Документ_РеализацияТоваровУслуг_Отправка")
Процедура АУ_ДобавитьПКО_Документ_РеализацияТоваровУслуг_Отправка(ПравилаКонвертации)
