Процедура ПКО_АУ_Документ_ПрочееОприходование_ВозвратОтПереработчика_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)

	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);

	СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	ДанныеXDTO.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	ДанныеXDTO.Вставить("Контрагент", ДанныеИБ.АУ_Контрагент);
	ДанныеXDTO.Вставить("Договор", ДанныеИБ.АУ_Договор);
	ДанныеXDTO.Вставить("Сумма", 0);

	ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "Склад");

	ТекстЗапроса =
		"ВЫБРАТЬ
			|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаУпаковка,
			|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Товары.Количество КАК Количество,
			|	&ТипЗапасов КАК ТипЗапасов,
			|	Товары.ФизическоеЛицо КАК ФизическоеЛицо,
			|	Товары.Ссылка.Подразделение КАК Подразделение,
			|	Товары.СтатьяРасходовДоходов.КорреспондирующийСчет КАК СтатьяРасходовКорСчет,
			|	Товары.СтатьяРасходовДоходов.Наименование КАК СтатьяРасходовНаименование,
			|	Товары.СтатьяРасходовДоходов КАК СтатьяЗатрат,
			|	Товары.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	""ВозвращенныеМатериалы"" КАК СчетПередачи,
			|	""10.07"" КАК СчетУчета
			|ИЗ
			|	Документ.ПрочееОприходованиеТоваров.Товары КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаУпаковка,
			|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Товары.Количество КАК Количество,
			|	&ТипЗапасов КАК ТипЗапасов,
			|	"""" КАК ФизическоеЛицо,
			|	Товары.Ссылка.Подразделение КАК Подразделение,
			|	"""" КАК СтатьяРасходовКорСчет,
			|	"""" КАК СтатьяРасходовНаименование,
			|	"""" КАК СтатьяЗатрат,
			|	"""" КАК ИнвентарныйНомер,
			|	""ИспользованныеМатериалы"" КАК СчетПередачи,
			|	""10.07"" КАК СчетУчета
			|ИЗ
			|	Документ.ПрочееОприходованиеТоваров.АУ_ИспользованныеМатериалы КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "Товары"));

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));

	ТипЗапасовВЗапросе = "&СобственныеТовары";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипЗапасов", ТипЗапасовВЗапросе);

	ЗаполнитьСобственныеТоварыВТексте(ТекстЗапроса);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	ТаблицаТовары = Запрос.Выполнить().Выгрузить();

	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, ТаблицаТовары);

	ДанныеXDTO.Вставить("Товары", ТаблицаТовары);

КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных")
Процедура АУ_ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ИсходныеИсторическиеДанные = Неопределено;
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ИсходныеИсторическиеДанные", ИсходныеИсторическиеДанные) Тогда
		
		Если ДанныеИБ = Неопределено Тогда
			// Принимаем данные из обмена.
			Для Каждого ЭлементДанных Из ИсходныеИсторическиеДанные Цикл
				ПолученныеДанные[ЭлементДанных.Ключ] = ЭлементДанных.Значение;
			КонецЦикла;
		Иначе
			// Восстанавливаем актуальные исторические значения реквизитов шапки из объекта ИБ.
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, ИсходныеИсторическиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	
	// Актуализация "среза последних" для исторических данных (при наличии).
	Если ДанныеИБ <> Неопределено Тогда
		
		ИсторическиеДанные = Новый Структура; // Ключ - имя ТЧ, значения - имена реквизитов в шапке и ТЧ
		ДанныеИсторическогоЗначения = Новый Структура;
		ДанныеИсторическогоЗначения.Вставить("ИмяШапка", "КПП");
		ДанныеИсторическогоЗначения.Вставить("ИмяТЧ",    "КПП");
		ИсторическиеДанные.Вставить("ИсторияКПП", ДанныеИсторическогоЗначения);
		
		ДанныеИсторическогоЗначения = Новый Структура;
		ДанныеИсторическогоЗначения.Вставить("ИмяШапка", "НаименованиеПолное");
		ДанныеИсторическогоЗначения.Вставить("ИмяТЧ",    "СокращенноеНаименование");
		ИсторическиеДанные.Вставить("ИсторияНаименований", ДанныеИсторическогоЗначения);
		
		Для Каждого ЭлементДанных Из ИсторическиеДанные Цикл
			ПолученныеДанные[ЭлементДанных.Ключ].Загрузить(ДанныеИБ[ЭлементДанных.Ключ].Выгрузить());
			
			АктуальнаяЗапись     = Неопределено;
			ЗначениеЕстьВИстории = Ложь;
			
			#Удаление
			Для Каждого ИсторияЗначения Из ПолученныеДанные[ЭлементДанных.Ключ] Цикл
				Если Не ЗначениеЕстьВИстории
					И ИсторияЗначения[ЭлементДанных.Значение.ИмяТЧ] = ПолученныеДанные[ЭлементДанных.Значение.ИмяШапка] Тогда
					ЗначениеЕстьВИстории = Истина;
				КонецЕсли;
				
				Если АктуальнаяЗапись = Неопределено Тогда
					АктуальнаяЗапись = ИсторияЗначения;
				ИначеЕсли АктуальнаяЗапись.Период < ИсторияЗначения.Период Тогда
					АктуальнаяЗапись = ИсторияЗначения;
				КонецЕсли;
			КонецЦикла;
			#КонецУдаления
			
			Если Не АктуальнаяЗапись = Неопределено
				И Не ЗначениеЕстьВИстории Тогда
				АктуальнаяЗапись[ЭлементДанных.Значение.ИмяТЧ] = ПолученныеДанные[ЭлементДанных.Значение.ИмяШапка];
			КонецЕсли;
			
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.ГоловнойКонтрагент) Тогда
			ПолученныеДанные.ГоловнойКонтрагент = ДанныеИБ.ГоловнойКонтрагент;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.СтранаРегистрации) Тогда
			ПолученныеДанные.СтранаРегистрации = ДанныеИБ.СтранаРегистрации;
		КонецЕсли;
		Если ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо
			и ДанныеИБ.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель 
			или ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо
			и ДанныеИБ.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
			
			ПолученныеДанные.ЮрФизЛицо = ДанныеИБ.ЮрФизЛицо; 
		КонецЕсли; 
	    КонецЕсли;	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);

КонецПроцедуры

&ИзменениеИКонтроль("ДобавитьПКО_Документ_ПоступлениеТоваровУслуг_Отправка")
Процедура АУ_ДобавитьПКО_Документ_ПоступлениеТоваровУслуг_Отправка(ПравилаКонвертации)
