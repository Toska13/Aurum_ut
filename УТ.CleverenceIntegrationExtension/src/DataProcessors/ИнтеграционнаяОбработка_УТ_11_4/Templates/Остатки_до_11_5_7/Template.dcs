<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Остатки</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Назначение</dataPath>
			<field>Назначение</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Упаковка</dataPath>
			<field>Упаковка</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдСклада_GUID</dataPath>
			<field>ИдСклада_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Склад</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Помещение</dataPath>
			<field>Помещение</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ячейка</dataPath>
			<field>Ячейка</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдЯчейки_GUID</dataPath>
			<field>ИдЯчейки_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ячейка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдТранспортнойУпаковки_GUID</dataPath>
			<field>ИдТранспортнойУпаковки_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Транспортная упаковка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдСерии_GUID</dataPath>
			<field>ИдСерии_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Серия</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдТовара_GUID</dataPath>
			<field>ИдТовара_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номенклатура</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдЕдиницыИзмерения_GUID</dataPath>
			<field>ИдЕдиницыИзмерения_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Единица измерения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдХарактеристики_GUID</dataPath>
			<field>ИдХарактеристики_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Характеристика</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Марка</dataPath>
			<field>Марка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Марка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоВНаличии</dataPath>
			<field>КоличествоВНаличии</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество в наличии</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоКРазмещению</dataPath>
			<field>КоличествоКРазмещению</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество к размещению</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоКОтбору</dataPath>
			<field>КоличествоКОтбору</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество к отбору</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СерийныйНомер</dataPath>
			<field>СерийныйНомер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Серийный номер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КодТовара</dataPath>
			<field>КодТовара</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Код товара</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МаркаИСМП</dataPath>
			<field>МаркаИСМП</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Марка ИСМП</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ШтрихкодУпаковочногоЛиста</dataPath>
			<field>ШтрихкодУпаковочногоЛиста</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Штрихкод упаковочного листа</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МаркаПодстрока</dataPath>
			<field>МаркаПодстрока</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Марка подстрока</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдНоменклатурыНабора_GUID</dataPath>
			<field>ИдНоменклатурыНабора_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номенклатура набора</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдХарактеристикиНабора_GUID</dataPath>
			<field>ИдХарактеристикиНабора_GUID</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Характеристика набора</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЛОЖЬ КАК Номенклатура,
	ЛОЖЬ КАК ПотребительскаяУпаковка
ПОМЕСТИТЬ ВТ_ОписаниеНоменклатурыИС

//&lt;*ТекстЗаменыОписаниеНоменклатурыИС*&gt;
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ВложенныеШК.Штрихкод КАК Штрихкод,
	ВложенныеШК.Ссылка КАК Ссылка
ПОМЕСТИТЬ ВложенныеШК
ИЗ
	Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ВложенныеШК
ГДЕ
	&amp;ВыгружатьКодыМаркировки
	И ВложенныеШК.Штрихкод.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МаркированныйТовар)
{ГДЕ
	ВложенныеШК.Штрихкод.Номенклатура.* КАК ИдТовара_GUID,
	ВложенныеШК.Штрихкод.Характеристика.* КАК ИдХарактеристики_GUID,
	ВложенныеШК.Штрихкод.Серия.* КАК ИдСерии_GUID,
	ВложенныеШК.Ссылка.* КАК ИдТранспортнойУпаковки_GUID,
	ВложенныеШК.Штрихкод.ЗначениеШтрихкода КАК Марка,
	ВложенныеШК.Штрихкод.ЗначениеШтрихкода КАК МаркаИСМП,
	ПОДСТРОКА(ВложенныеШК.Штрихкод.ЗначениеШтрихкода, 1, &amp;ДлинаМарки) КАК МаркаПодстрока}

ИНДЕКСИРОВАТЬ ПО
	Штрихкод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА ВТ_ОписаниеНоменклатурыИС.Номенклатура ЕСТЬ NULL
			ТОГДА ШтрихкодыУпаковокТоваров.Упаковка
		ИНАЧЕ ВТ_ОписаниеНоменклатурыИС.ПотребительскаяУпаковка
	КОНЕЦ КАК Упаковка,
	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика,
	ШтрихкодыУпаковокТоваров.Серия КАК Серия,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	ВЫБОР
		КОГДА ВТ_ОписаниеНоменклатурыИС.Номенклатура ЕСТЬ NULL
			И ШтрихкодыУпаковокТоваров.Количество &gt; 0
			ТОГДА ШтрихкодыУпаковокТоваров.Количество
		ИНАЧЕ 1
	КОНЕЦ КАК Количество
ПОМЕСТИТЬ ВТ_ШУИТ
ИЗ
	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОписаниеНоменклатурыИС КАК ВТ_ОписаниеНоменклатурыИС
		ПО ВТ_ОписаниеНоменклатурыИС.Номенклатура = ШтрихкодыУпаковокТоваров.Номенклатура
ГДЕ
	&amp;ВыгружатьКодыМаркировки
	И НЕ &amp;ОтборПоРодителю
	И ШтрихкодыУпаковокТоваров.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МаркированныйТовар)
{ГДЕ
	ШтрихкодыУпаковокТоваров.Номенклатура.* КАК ИдТовара_GUID,
	ШтрихкодыУпаковокТоваров.Характеристика.* КАК ИдХарактеристики_GUID,
	ШтрихкодыУпаковокТоваров.Серия.* КАК ИдСерии_GUID,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК Марка,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК МаркаИСМП,
	ПОДСТРОКА(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, 1, &amp;ДлинаМарки) КАК МаркаПодстрока}
	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА ВТ_ОписаниеНоменклатурыИС.Номенклатура ЕСТЬ NULL
			ТОГДА ШтрихкодыУпаковокТоваров.Упаковка
		ИНАЧЕ ВТ_ОписаниеНоменклатурыИС.ПотребительскаяУпаковка
	КОНЕЦ КАК Упаковка,
	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика,
	ШтрихкодыУпаковокТоваров.Серия КАК Серия,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	ВЫБОР
		КОГДА ВТ_ОписаниеНоменклатурыИС.Номенклатура ЕСТЬ NULL
			И ШтрихкодыУпаковокТоваров.Количество &gt; 0
			ТОГДА ШтрихкодыУпаковокТоваров.Количество
		ИНАЧЕ 1
	КОНЕЦ КАК Количество
ИЗ
	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОписаниеНоменклатурыИС КАК ВТ_ОписаниеНоменклатурыИС
		ПО ВТ_ОписаниеНоменклатурыИС.Номенклатура = ШтрихкодыУпаковокТоваров.Номенклатура
ГДЕ
	&amp;ВыгружатьКодыМаркировки
	И &amp;ОтборПоРодителю
	И ШтрихкодыУпаковокТоваров.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковок.МаркированныйТовар)
	И ШтрихкодыУпаковокТоваров.Ссылка В
		(ВЫБРАТЬ ВложенныеШК.Штрихкод КАК Штрихкод
			ИЗ ВложенныеШК КАК ВложенныеШК)
{ГДЕ
	ШтрихкодыУпаковокТоваров.Номенклатура.* КАК ИдТовара_GUID,
	ШтрихкодыУпаковокТоваров.Характеристика.* КАК ИдХарактеристики_GUID,
	ШтрихкодыУпаковокТоваров.Серия.* КАК ИдСерии_GUID,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК Марка,
	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК МаркаИСМП,
	ПОДСТРОКА(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, 1, &amp;ДлинаМарки) КАК МаркаПодстрока}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОстатки.Склад КАК Склад,
	ТоварыНаСкладахОстатки.Помещение КАК Помещение,
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	ТоварыНаСкладахОстатки.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ТоварыНаСкладахОстатки.Серия КАК Серия,
	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК КоличествоВНаличии,
	"" КАК Марка,
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка) КАК ТранспортнаяУпаковка
ПОМЕСТИТЬ ВТ_ТоварыВНаличии
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(, &amp;ВыгружатьОстаткиПоСкладам = ИСТИНА {(Номенклатура).* КАК ИдТовара_GUID}) КАК ТоварыНаСкладахОстатки

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладахОстатки.Склад,
	ТоварыНаСкладахОстатки.Помещение,
	ТоварыНаСкладахОстатки.Номенклатура,
	ТоварыНаСкладахОстатки.Характеристика,
	ТоварыНаСкладахОстатки.Серия,
	ТоварыНаСкладахОстатки.Номенклатура.ЕдиницаИзмерения

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика,
	Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
	СвободныеОстаткиОстатки.Склад КАК Склад,
	ЗНАЧЕНИЕ(Справочник.СкладскиеПомещения.ПустаяСсылка) КАК Помещение,
	СУММА(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток + СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток) КАК КоличествоВРезерве,
	"" КАК Марка
ПОМЕСТИТЬ ВТ_ТоварыВРезерве
ИЗ
	РегистрНакопления.СвободныеОстатки.Остатки(, &amp;ВыгружатьОстаткиПоСкладам = ИСТИНА {(Номенклатура).* КАК ИдТовара_GUID}) КАК СвободныеОстаткиОстатки

СГРУППИРОВАТЬ ПО
	СвободныеОстаткиОстатки.Характеристика,
	СвободныеОстаткиОстатки.Номенклатура,
	СвободныеОстаткиОстатки.Склад

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика,
	Склад
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	ТоварыВЯчейкахОстатки.Упаковка КАК ЕдиницаИзмерения,
	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	ТоварыВЯчейкахОстатки.Ячейка.Помещение КАК Помещение,
	ТоварыВЯчейкахОстатки.Ячейка.Владелец КАК Склад,
	СУММА(ТоварыВЯчейкахОстатки.ВНаличииОстаток * ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1) = 0
				ТОГДА 1
			ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
		КОНЕЦ / ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1) = 0
				ТОГДА 1
			ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
		КОНЕЦ) КАК КоличествоВНаличии,
	СУММА(ТоварыВЯчейкахОстатки.КОтборуОстаток * ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1) = 0
				ТОГДА 1
			ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
		КОНЕЦ / ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1) = 0
				ТОГДА 1
			ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
		КОНЕЦ) КАК КоличествоКОтбору,
	СУММА(ТоварыВЯчейкахОстатки.КРазмещениюОстаток * ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1) = 0
				ТОГДА 1
			ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
		КОНЕЦ / ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1) = 0
				ТОГДА 1
			ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
		КОНЕЦ) КАК КоличествоКРазмещению,
	"" КАК Марка,
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка) КАК ТранспортнаяУпаковка
ПОМЕСТИТЬ ВТ_ТоварыВЯчейках
ИЗ
	РегистрНакопления.ТоварыВЯчейках.Остатки(, &amp;ВыгружатьОстаткиВЯчейках = ИСТИНА {(Номенклатура).* КАК ИдТовара_GUID}) КАК ТоварыВЯчейкахОстатки

СГРУППИРОВАТЬ ПО
	ТоварыВЯчейкахОстатки.Номенклатура,
	ТоварыВЯчейкахОстатки.Характеристика,
	ТоварыВЯчейкахОстатки.Серия,
	ТоварыВЯчейкахОстатки.Ячейка,
	ТоварыВЯчейкахОстатки.Ячейка.Помещение,
	ТоварыВЯчейкахОстатки.Ячейка.Владелец,
	ТоварыВЯчейкахОстатки.Упаковка

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика,
	Склад,
	Серия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	УпаковочныйЛистТовары.Ссылка.Код КАК ШтрихкодУпаковочногоЛиста,
	УпаковочныйЛистТовары.Номенклатура КАК Номенклатура,
	УпаковочныйЛистТовары.Характеристика КАК Характеристика,
	УпаковочныйЛистТовары.Серия КАК Серия,
	УпаковочныйЛистТовары.Упаковка КАК Упаковка,
	УпаковочныйЛистТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	"" КАК Марка,
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка) КАК ТранспортнаяУпаковка
ПОМЕСТИТЬ ВТ_УпаковочныеЛисты
ИЗ
	Документ.УпаковочныйЛист.Товары КАК УпаковочныйЛистТовары
ГДЕ
	&amp;ВыгружатьУпаковочныеЛисты
	И УпаковочныйЛистТовары.Ссылка.Проведен = Истина
	И УпаковочныйЛистТовары.ЭтоУпаковочныйЛист = Ложь
	И УпаковочныйЛистТовары.УпаковочныйЛистРодитель = ЗНАЧЕНИЕ(Документ.УпаковочныйЛист.ПустаяСсылка)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНабора.Ссылка.Владелец КАК НоменклатураНабора,
	ТоварыНабора.Ссылка.Характеристика КАК ХарактеристикаНабора,
	ТоварыНабора.Номенклатура КАК Номенклатура,
	ТоварыНабора.Характеристика КАК Характеристика,
	ТоварыНабора.Упаковка КАК Упаковка,
	ТоварыНабора.КоличествоУпаковок КАК КоличествоУпаковок,
	"" КАК Марка,
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка) КАК ТранспортнаяУпаковка
ПОМЕСТИТЬ ВТ_СоставыНаборов
ИЗ
	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ТоварыНабора
ГДЕ
	&amp;ВыгружатьСоставыНаборов
	И НЕ ТоварыНабора.Ссылка.ПометкаУдаления
	И ТоварыНабора.Ссылка.Владелец В
			(ВЫБРАТЬ
				Номенклатура.Ссылка КАК Ссылка
			ИЗ
				Справочник.Номенклатура КАК Номенклатура
			ГДЕ
				НЕ Номенклатура.ПометкаУдаления
				И Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА ВТ_ТоварыВНаличии.Помещение &lt;&gt; ЗНАЧЕНИЕ(Справочник.СкладскиеПомещения.ПустаяСсылка)
			ТОГДА ВТ_ТоварыВНаличии.Помещение
		ИНАЧЕ ВТ_ТоварыВНаличии.Склад
	КОНЕЦ КАК ИдСклада_GUID,
	ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка) КАК ИдЯчейки_GUID,
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка) КАК ИдТранспортнойУпаковки_GUID,
	ВТ_ТоварыВНаличии.Номенклатура КАК ИдТовара_GUID,
	ВТ_ТоварыВНаличии.ЕдиницаИзмерения КАК ИдЕдиницыИзмерения_GUID,
	ВТ_ТоварыВНаличии.Характеристика КАК ИдХарактеристики_GUID,
	ВТ_ТоварыВНаличии.Серия КАК ИдСерии_GUID,
	"" КАК СерийныйНомер,
	ВТ_ТоварыВНаличии.Марка КАК Марка,
	ВТ_ТоварыВНаличии.КоличествоВНаличии КАК КоличествоВНаличии,
	ЕСТЬNULL(ВТ_ТоварыВРезерве.КоличествоВРезерве, 0) КАК КоличествоКОтбору,
	0 КАК КоличествоКРазмещению,
	"" КАК КодТовара,
	"" КАК ШтрихкодУпаковочногоЛиста,
	"" КАК ИдНоменклатурыНабора_GUID,
	"" КАК ИдХарактеристикиНабора_GUID
ИЗ
	ВТ_ТоварыВНаличии КАК ВТ_ТоварыВНаличии
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыВРезерве КАК ВТ_ТоварыВРезерве
		ПО ВТ_ТоварыВНаличии.Склад = ВТ_ТоварыВРезерве.Склад
			И ВТ_ТоварыВНаличии.Номенклатура = ВТ_ТоварыВРезерве.Номенклатура
			И ВТ_ТоварыВНаличии.Характеристика = ВТ_ТоварыВРезерве.Характеристика
{ГДЕ
	ВТ_ТоварыВНаличии.Номенклатура.* КАК ИдТовара_GUID,
	ВТ_ТоварыВНаличии.ТранспортнаяУпаковка КАК ИдТранспортнойУпаковки_GUID,
	ВТ_ТоварыВНаличии.Марка КАК Марка,
	ВТ_ТоварыВНаличии.Марка КАК МаркаИСМП,
	ВТ_ТоварыВНаличии.Марка КАК МаркаПодстрока}

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА ВТ_ТоварыВЯчейках.Помещение &lt;&gt; ЗНАЧЕНИЕ(Справочник.СкладскиеПомещения.ПустаяСсылка)
			ТОГДА ВТ_ТоварыВЯчейках.Помещение
		ИНАЧЕ ВТ_ТоварыВЯчейках.Склад
	КОНЕЦ,
	ВТ_ТоварыВЯчейках.Ячейка,
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка),
	ВТ_ТоварыВЯчейках.Номенклатура,
	ВТ_ТоварыВЯчейках.ЕдиницаИзмерения,
	ВТ_ТоварыВЯчейках.Характеристика,
	ВТ_ТоварыВЯчейках.Серия,
	"",
	ВТ_ТоварыВЯчейках.Марка,
	ВТ_ТоварыВЯчейках.КоличествоВНаличии,
	ВТ_ТоварыВЯчейках.КоличествоКОтбору,
	ВТ_ТоварыВЯчейках.КоличествоКРазмещению,
	"",
	"",
	"",
	""
ИЗ
	ВТ_ТоварыВЯчейках КАК ВТ_ТоварыВЯчейках
{ГДЕ
	ВТ_ТоварыВЯчейках.Номенклатура.* КАК ИдТовара_GUID,
	ВТ_ТоварыВЯчейках.ТранспортнаяУпаковка КАК ИдТранспортнойУпаковки_GUID,
	ВТ_ТоварыВЯчейках.Марка КАК Марка,
	ВТ_ТоварыВЯчейках.Марка КАК МаркаИСМП,
	ВТ_ТоварыВЯчейках.Марка КАК МаркаПодстрока}

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"",
	ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка),
	ВложенныеШК.Ссылка,
	ВТ_ШУИТ.Номенклатура,
	ВЫБОР
		КОГДА ВТ_ШУИТ.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА ВТ_ШУИТ.Номенклатура.ЕдиницаИзмерения
		ИНАЧЕ ВТ_ШУИТ.Упаковка
	КОНЕЦ,
	ВТ_ШУИТ.Характеристика,
	ВТ_ШУИТ.Серия,
	"",
	ВТ_ШУИТ.ЗначениеШтрихкода,
	ВТ_ШУИТ.Количество,
	0,
	0,
	"",
	"",
	"",
	""
ИЗ
	ВТ_ШУИТ КАК ВТ_ШУИТ
		ЛЕВОЕ СОЕДИНЕНИЕ ВложенныеШК КАК ВложенныеШК
		ПО (ВложенныеШК.Штрихкод = ВТ_ШУИТ.Ссылка)
{ГДЕ
	ВТ_ШУИТ.Номенклатура.* КАК ИдТовара_GUID,
	ВложенныеШК.Ссылка КАК ИдТранспортнойУпаковки_GUID}
	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"",
	ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка),
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка),
	УпакЛисты.Номенклатура,
	ВЫБОР
		КОГДА УпакЛисты.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА УпакЛисты.Номенклатура.ЕдиницаИзмерения
		ИНАЧЕ УпакЛисты.Упаковка
	КОНЕЦ,
	УпакЛисты.Характеристика,
	УпакЛисты.Серия,
	"",
	"",
	УпакЛисты.КоличествоУпаковок,
	0,
	0,
	"",
	УпакЛисты.ШтрихкодУпаковочногоЛиста,
	"",
	""
ИЗ
	ВТ_УпаковочныеЛисты КАК УпакЛисты
{ГДЕ
	УпакЛисты.Номенклатура.* КАК ИдТовара_GUID,
	УпакЛисты.ТранспортнаяУпаковка КАК ИдТранспортнойУпаковки_GUID,
	УпакЛисты.Марка КАК Марка,
	УпакЛисты.Марка КАК МаркаИСМП,
	УпакЛисты.Марка КАК МаркаПодстрока}
	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"",
	ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка),
	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка),
	СоставыНаборов.Номенклатура,
	ВЫБОР
		КОГДА СоставыНаборов.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			ТОГДА СоставыНаборов.Номенклатура.ЕдиницаИзмерения
		ИНАЧЕ СоставыНаборов.Упаковка
	КОНЕЦ,
	СоставыНаборов.Характеристика,
	"",
	"",
	"",
	СоставыНаборов.КоличествоУпаковок,
	0,
	0,
	"",
	"",
	СоставыНаборов.НоменклатураНабора,
	СоставыНаборов.ХарактеристикаНабора
ИЗ
	ВТ_СоставыНаборов КАК СоставыНаборов
{ГДЕ
	СоставыНаборов.Номенклатура.* КАК ИдТовара_GUID,
	СоставыНаборов.ТранспортнаяУпаковка КАК ИдТранспортнойУпаковки_GUID,
	СоставыНаборов.Марка КАК Марка,
	СоставыНаборов.Марка КАК МаркаИСМП,
	СоставыНаборов.Марка КАК МаркаПодстрока}</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ВыгружатьКодыМаркировки</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выгружать коды маркировки</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">true</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ВыгружатьОстаткиВЯчейках</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выгружать остатки в ячейках</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">true</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ВыгружатьОстаткиПоСкладам</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выгружать остатки по складам</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">true</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ДлинаМарки</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Длина марки</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
		<value xsi:type="xs:decimal">0</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>ОтборПоРодителю</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отбор по родителю</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>ВыгружатьУпаковочныеЛисты</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выгружать упаковочные листы</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">true</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ВыгружатьСоставыНаборов</name>
