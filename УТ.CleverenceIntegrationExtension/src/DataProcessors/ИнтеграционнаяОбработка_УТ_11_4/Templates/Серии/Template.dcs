			<dataPath>Документ</dataPath>
			<field>Документ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Отправитель</dataPath>
			<field>Отправитель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СкладскаяОперация</dataPath>
			<field>СкладскаяОперация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПомещениеОтправителя</dataPath>
			<field>ПомещениеОтправителя</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Получатель</dataPath>
			<field>Получатель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХарактеристикаПолучателя</dataPath>
			<field>ХарактеристикаПолучателя</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЭтоСкладскоеДвижение</dataPath>
			<field>ЭтоСкладскоеДвижение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Штрихкод</dataPath>
			<field>Штрихкод</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Штрихкод</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаСрокаГодности</dataPath>
			<field>ДатаСрокаГодности</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата срока годности</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПроизводства</dataPath>
			<field>ДатаПроизводства</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТаблицаСерий.Ссылка КАК Ид_GUID,
	ВЫБОР
		КОГДА ЕСТЬNULL(ТаблицаСерий.ВидНоменклатуры.НастройкиСерийБерутсяИзДругогоВидаНоменклатуры, ЛОЖЬ) = ИСТИНА
			ТОГДА ТаблицаСерий.ВидНоменклатуры.ВладелецСерий
		ИНАЧЕ ТаблицаСерий.ВидНоменклатуры
	КОНЕЦ КАК КлючСерий_GUID,
	ТаблицаСерий.Номер КАК Номер,
	ТаблицаСерий.Наименование КАК ИмяСерии,
	ТаблицаСерий.Наименование КАК НаименованиеДляПоиска,
	ТаблицаСерий.ГоденДо КАК ДатаСерии,
	ТаблицаСерий.ГоденДо КАК ДатаСрокаГодности
ПОМЕСТИТЬ ВТ_СерииНоменклатуры
ИЗ
	Справочник.СерииНоменклатуры КАК ТаблицаСерий
ГДЕ
	НЕ ТаблицаСерий.ПометкаУдаления
	И НЕ ТаблицаСерий.ВидНоменклатуры.НастройкаИспользованияСерий = ЗНАЧЕНИЕ(Перечисление.НастройкиИспользованияСерийНоменклатуры.ПартияТоваров)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТаблицаСерий.Серия.Ссылка,
	ТаблицаСерий.Номенклатура,
	ТаблицаСерий.Серия.Номер,
	ТаблицаСерий.Серия.Наименование,
	ТаблицаСерий.Серия.Наименование,
	ТаблицаСерий.Серия.ГоденДо,
	ТаблицаСерий.Серия.ГоденДо
ИЗ
	РегистрНакопления.ДвиженияСерийТоваров.Обороты КАК ТаблицаСерий
ГДЕ
	НЕ ТаблицаСерий.Серия.ПометкаУдаления
	И ТаблицаСерий.Серия.ВидНоменклатуры.НастройкаИспользованияСерий = ЗНАЧЕНИЕ(Перечисление.НастройкиИспользованияСерийНоменклатуры.ПартияТоваров)

//&lt;*ТекстЗаменыШтрихкодыУпаковок*&gt;
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры.НастройкиСерийБерутсяИзДругогоВидаНоменклатуры, ЛОЖЬ) = ИСТИНА
			ТОГДА ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры.ВладелецСерий
		ИНАЧЕ ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры
	КОНЕЦ КАК ВидНоменклатуры,
	ТоварыНаСкладахОстатки.Серия КАК Серия
ПОМЕСТИТЬ втОстатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(
			,
			Серия В
					(ВЫБРАТЬ
						ВТ_СерииНоменклатуры.Ид_GUID
					ИЗ
						ВТ_СерииНоменклатуры)
				И &amp;СерииСОстатками) КАК ТоварыНаСкладахОстатки

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	ВидНоменклатуры,
	Серия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	СерииНоменклатуры.Номер КАК Номер,
	СерииНоменклатуры.ИмяСерии КАК ИмяСерии,
	СерииНоменклатуры.НаименованиеДляПоиска КАК НаименованиеДляПоиска,
	СерииНоменклатуры.Ид_GUID КАК Ид_GUID,
	СерииНоменклатуры.КлючСерий_GUID КАК КлючСерий_GUID,
	СерииНоменклатуры.ДатаСрокаГодности КАК ДатаСрокаГодности,
	ВЫБОР
		//&lt;*ТекстЗаменыДатаПроизводства*&gt;
		КОГДА 1 = 1 ТОГДА ДАТАВРЕМЯ(1,1,1,0,0,0)
	КОНЕЦ КАК ДатаПроизводства,
	"                              " КАК Штрихкод
ИЗ
	ВТ_СерииНоменклатуры КАК СерииНоменклатуры
		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
		ПО (СерииНоменклатуры.КлючСерий_GUID = втОстатки.Номенклатура
				ИЛИ СерииНоменклатуры.КлючСерий_GUID = втОстатки.ВидНоменклатуры)
			И СерииНоменклатуры.Ид_GUID = втОстатки.Серия
ГДЕ
	ВЫБОР
			КОГДА &amp;СерииСОстатками
				ТОГДА НЕ втОстатки.Серия ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>СерииСОстатками</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Серии с остатками</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Ид_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИмяСерии</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КлючСерий_GUID</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>НаименованиеДляПоиска</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Номер</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Штрихкод</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаПроизводства</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаСрокаГодности</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">ИмяСерии</dcsset:left>
					<dcsset:comparisonType>Contains</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:string"/>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">КлючСерий_GUID</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Номер</dcsset:left>
					<dcsset:comparisonType>Contains</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:string"/>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>