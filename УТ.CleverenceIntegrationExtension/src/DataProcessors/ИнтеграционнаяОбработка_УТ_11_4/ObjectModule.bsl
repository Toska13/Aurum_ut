// Вызывается при загрузке документа РасходныйОрдерНаТовары из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_РасходныйОрдерНаТовары_ПередЗаполнениемДокумента(СтруктураПараметров) Экспорт
	
	ИмяСобытия = "УТ_11_2_РасходныйОрдерНаТовары_ПередЗаполнениемДокумента";
	
	// УТ_11_2_Общий_ПередЗаполнениемДокумента(...) в том числе вызывает методы:
	// 	- УТ_11_2_ЗаполнениеРеквизитовШапкиИзДокументаОснования
	//	- ИнициализироватьДокумент.
	// В данном обработчике это не требуется, заполнение реквизитов шапки выполняется далее.
    СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ВыполянемОбщийОбработчикДляВсехКонф", 		"Общий_ПередЗаполнениемДокумента(СтруктураПараметров)");
	СтруктураДействий.Вставить("СоздаемНовыеШтрихкодыИСоздаемНовыйТовар",	"СоздатьНовыеШтрихкоды(СтруктураПараметров)");
	ВыполнитьКаждыйОбработчикИзСтруктурыДействий(СтруктураПараметров, СтруктураДействий, ИмяСобытия);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;
	
	Склад = Неопределено;
	Если Док1СОснование <> Неопределено Тогда
		Если Док1СОснование.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
			Склад = Док1СОснование.Склад;
		ИначеЕсли Док1СОснование.Метаданные().Реквизиты.Найти("СкладОтправитель") <> Неопределено Тогда
			Склад = Док1СОснование.СкладОтправитель;
		КонецЕсли;
		
		Если Склад.ЭтоГруппа И СтруктураПараметров.ДанныеДляЗагрузки_Шапка.Склад <> Склад Тогда
			Склад = СтруктураПараметров.ДанныеДляЗагрузки_Шапка.Склад;
			Док1СРезультат.Склад = Склад;		
		КонецЕсли;
	КонецЕсли;
	
	Если Док1СРезультат.Склад.ЭтоГруппа Тогда
		Док1СРезультат.Склад = Неопределено;
		Склад = Неопределено;
	КонецЕсли;
	
	////
	Если Док1СОснование <> Неопределено Тогда
		
		ПараметрыПереоформленияРасходныхОрдеров = ИО_ОбщийМодуль("СкладыСервер").ПараметрыПереоформленияРасходныхОрдеров();
		
		ПараметрыПереоформленияРасходныхОрдеров.ЗаданиеНаПеревозку = Документы.ЗаданиеНаПеревозку.ПустаяСсылка();
		Если ТипЗнч(Док1СОснование) = Тип("ДокументОбъект.ЗаказНаПеремещение")
			Или ТипЗнч(Док1СОснование) = Тип("ДокументСсылка.ЗаказНаПеремещение")
			Тогда
			// ЗаказНаПеремещение - нет Партнера
			ПараметрыПереоформленияРасходныхОрдеров.Получатель = Док1СОснование.СкладПолучатель;
			ПараметрыПереоформленияРасходныхОрдеров.Склад = Док1СОснование.СкладОтправитель;
		Иначе
			ПараметрыПереоформленияРасходныхОрдеров.Получатель = Док1СОснование.Партнер; 
			ПараметрыПереоформленияРасходныхОрдеров.Склад = Склад; //Док1СОснование.Склад;
		КонецЕсли;
		
		РаспоряжениеСсылка = Док1СОснование.Ссылка;
		Если ТипЗнч(Док1СОснование) = Тип("ДокументОбъект.РеализацияТоваровУслуг") 
			ИЛИ ТипЗнч(Док1СОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Если Док1СОснование.РеализацияПоЗаказам 
				И ЗначениеЗаполнено(Док1СОснование.ЗаказКлиента) Тогда
				РаспоряжениеСсылка = Док1СОснование.ЗаказКлиента;
			КонецЕсли;
		КонецЕсли;
		Распоряжения = Новый Массив;	
		Распоряжения.Добавить(РаспоряжениеСсылка);		
		ПараметрыПереоформленияРасходныхОрдеров.РаспоряженияНаОтгрузку = Распоряжения;		
		
		СтруктураЗадания = ИО_ОбщийМодуль("СкладыСервер").ПереоформитьРасходныеОрдера(ПараметрыПереоформленияРасходныхОрдеров);
		
		Если СтруктураЗадания.ЕстьОшибка Тогда
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Ошибка переоформления расходный ордеров", "Ошибка", "Создание/переоформление расходных ордеров на основании " + РаспоряжениеСсылка + " произошло с ошибкой");
		КонецЕсли;
		
		НужныйОрдер = "НужныйОрдер"; //имя дополнительной колонки
		
		Если СтруктураЗадания.ОформленныеОрдера.Количество() > 0 Тогда
			СтруктураЗадания.ОформленныеОрдера.Колонки.Добавить(НужныйОрдер, Новый ОписаниеТипов("Булево"));		
			
			Для Каждого ОформленныйОрдер из СтруктураЗадания.ОформленныеОрдера Цикл
				ОформленныйОрдер[НужныйОрдер] = Ложь;
				Если ИО_ЭтоНужныйОрдер(ОформленныйОрдер.РасходныйОрдер, СтруктураПараметров) Тогда				
					СтруктураПараметров.Вставить("Док1СРезультат", ОформленныйОрдер.РасходныйОрдер.ПолучитьОбъект());
					ОформленныйОрдер[НужныйОрдер] = Истина;
					Прервать;
				КонецЕсли;	        
			КонецЦикла;			
			
		КонецЕсли;
		
		// удаляем лишние созданные ордера
		Если  СтруктураЗадания.ОформленныеОрдера.Количество() > 0 Тогда
			Для Каждого ОформленныйОрдер Из СтруктураЗадания.ОформленныеОрдера Цикл
				
				Если Не ОформленныйОрдер[НужныйОрдер] = Неопределено И ОформленныйОрдер[НужныйОрдер] Тогда Продолжить; КонецЕсли;
				
				Если НРег(СокрЛП(ОформленныйОрдер.Действие)) = "создан новый" Тогда
					РасходныйОрдер = ОформленныйОрдер.РасходныйОрдер.ПолучитьОбъект();
					
					#Если Сервер И Не Сервер Тогда
						РасходныйОрдер = Документы.РасходныйОрдерНаТовары.СоздатьДокумент();
					#КонецЕсли
					
					РасходныйОрдер.УстановитьПометкуУдаления(Истина); // для отмены проведения
					//РасходныйОрдер.Удалить(); // Ограничение фреш
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры 

// Вызывается при загрузке документа РасходныйОрдерНаТовары из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
