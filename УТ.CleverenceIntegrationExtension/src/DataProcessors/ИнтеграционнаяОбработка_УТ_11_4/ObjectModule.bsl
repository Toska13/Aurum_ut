//		* СтрокаДокумента - Неопределено                - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ЧекККМ_ПослеЗаполненияТЧ_Товары			(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ТабличнаяЧасть = СтруктураПараметров.ТЧ;
	
	СтруктураПересчетаСуммы		 = УТ_11_4_СтруктураПересчетаСуммыНДСВСтрокеТЧ(Док1СРезультат);
	СтруктураЗаполненияСтавкиНДС = УТ_11_4_СтруктураЗаполненияСтавкиНДС(СтруктураПараметров);
	ТекущийПользователь 		 = ИО_ОбщийМодуль("ПользователиКлиентСервер").ТекущийПользователь();
	
	Для каждого ТекущаяСтрока ИЗ ТабличнаяЧасть Цикл
		СтруктураДействий = Новый Структура;
		
		Если ТекущаяСтрока.СтавкаНДС.Пустая() Тогда 
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", СтруктураЗаполненияСтавкиНДС);
		КонецЕсли;
		
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
		
		УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Новый Структура("ДатаОтгрузки", Док1СРезультат.Дата));
		
		ТекущаяСтрока.Продавец = ТекущийПользователь;
	КонецЦикла;

КонецПроцедуры

