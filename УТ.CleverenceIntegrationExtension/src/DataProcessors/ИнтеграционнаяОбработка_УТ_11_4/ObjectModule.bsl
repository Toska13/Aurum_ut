// Возвращает соответствие имён таблиц MS и структуру с именами метаданных справочников
//	для наложения отбора при выгрузке справочников порциями.
// Если таблицы MS нет в списке или "Использование = Ложь", то таблица будет выгружена в обычном режиме.
//
// Параметры порционной выгрузки: 
//	ИменаСправочников - Массив - Имена справочников, которые выгружаются в таблицу MS
//	ПолеНаложенияОтбора - Строка - Имя поля из макета СКД, на который будет наложен отбор
//	Использование - Булево - Использовать порционную выгрузку для таблицы
//
// Возвращаемое значение:
//	Соответствие - содержит имена таблиц MS и параметры порционной выгрузки
Функция Конф_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки() Экспорт
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	СоответствиеПараметров = Новый Соответствие;
	
	// Номенклатура
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Номенклатура.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "Product_Id_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Номенклатура", Параметры);
	
	// Остатки
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Номенклатура.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "ИдТовара_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Остатки", Параметры);
	
	// Цены
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Номенклатура.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "ИдТовара_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Цены", Параметры);
	
	// Дополнительные реквизиты
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Номенклатура.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "ИдТовара_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("ДопРеквизиты", Параметры);
	
	// Характеристики
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Характеристики.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "Ид_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Характеристики", Параметры);
	
	// Склады
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Склады.ИмяСправочника);
	ИменаСправочников.Добавить(МетаданныеНСИ.Помещения.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "Ид_GUID_ДляОтбора");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Склады", Параметры);
	
	// Серии
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Серии.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "Ид_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Серии", Параметры);
	
	// Ячейки
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Ячейки.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "Id_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Ячейки", Параметры);
	
	// Транспортные упаковки
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.ТранспортныеУпаковки.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "ИдТранспортнойУпаковки_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("ТранспортныеУпаковки", Параметры);
	
	// Контрагенты
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Контрагенты.ИмяСправочника);
	ИменаСправочников.Добавить("Партнеры");
	ИменаСправочников.Добавить("ФизическиеЛица");
	ИменаСправочников.Добавить("СтруктураПредприятия");
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "Ид_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("Контрагенты", Параметры);
	
	// СпрЯчейки
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(МетаданныеНСИ.Номенклатура.ИмяСправочника);
	Параметры = Новый Структура;
	Параметры.Вставить("ИменаСправочников", ИменаСправочников);
	Параметры.Вставить("ПолеНаложенияОтбора", "ИдТовара_GUID");
	Параметры.Вставить("Использование", Истина);
	СоответствиеПараметров.Вставить("СпрЯчейки", Параметры);
	
	Возврат СоответствиеПараметров;
	
КонецФункции

