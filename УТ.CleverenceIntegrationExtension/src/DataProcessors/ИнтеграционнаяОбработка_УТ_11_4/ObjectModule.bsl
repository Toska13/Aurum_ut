	ИмяСобытия = "УТ_11_4_МаркировкаТоваровИСМП_ПослеЗаполненияТЧ_Товары";
	
	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ТабличнаяЧасть = СтруктураПараметров.ТЧ;
	
	Попытка
		ИО_ОбщийМодуль("ЗаполнениеОбъектовПоСтатистикеИСМП").ЗаполнитьДанныеПоТоварамМаркировкиТоваровИСМП(
			ТабличнаяЧасть, Док1СРезультат);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	НомерСертификатаГП = ИО_ЗначениеГлобальногоПараметраПоID("NDScd915262140543b889120549d2526a77", СтруктураПараметров);
	Если ЗначениеЗаполнено(НомерСертификатаГП) Тогда
		ВидДокументаСертификации = Неопределено;
		Если НЕ Метаданные.Перечисления.Найти("ВидыДокументовОбязательнойСертификацииИС") = Неопределено Тогда
			ВидДокументаСертификации = ПредопределенноеЗначение("Перечисление.ВидыДокументовОбязательнойСертификацииИС.СертификатСоответствия");
		ИначеЕсли НЕ Метаданные.Перечисления.Найти("ВидыДокументовОбязательнойСертификацииИСМП") = Неопределено Тогда
			ВидДокументаСертификации = ПредопределенноеЗначение("Перечисление.ВидыДокументовОбязательнойСертификацииИСМП.СертификатСоответствия");
		КонецЕсли;
		
		Для каждого ТекущаяСтрока ИЗ ТабличнаяЧасть Цикл
			ТекущаяСтрока.ВидДокументаСертификации 	 = ВидДокументаСертификации;
			ТекущаяСтрока.НомерДокументаСертификации = НомерСертификатаГП;
			ТекущаяСтрока.ДатаДокументаСертификации  = ТекущаяДатаСеанса();
		КонецЦикла;
	КонецЕсли;
	
	УТ_11_4_ИСМП_Товары_ПослеЗаполненияТЧ(СтруктураПараметров);
	
