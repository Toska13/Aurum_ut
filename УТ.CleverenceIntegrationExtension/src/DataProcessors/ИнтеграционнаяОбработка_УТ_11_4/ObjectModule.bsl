// Вызывается при загрузке документа РеализацияТоваровУслуг из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_РеализацияТоваровУслуг_ПослеЗаполненияДокумента		(СтруктураПараметров) Экспорт

	ИмяСобытия = "УТ_11_2_РеализацияТоваровУслуг_ПослеЗаполненияДокумента";
	
	УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);	
	
	Док1СРезультат  = СтруктураПараметров.Док1СРезультат;
	Док1СОснование  = СтруктураПараметров.Док1СОснование;
	РеквизитыШапки  = Док1СРезультат.Метаданные().Реквизиты;
	
	ЕстьДокументОснование = Док1СОснование <> Неопределено И Док1СОснование <> Док1СРезультат;
	
	Если ЕстьДокументОснование И Док1СРезультат.ЭтоНовый() Тогда
		УТ_11_4_ЗаполнитьРеквизитыДоставки(Док1СРезультат, Док1СОснование);
	КонецЕсли;
		
	// Перенесено в обработчик ПередЗаполнениемТЧ_Товары
	//Если НЕ ЕстьДокументОснование Тогда // Если есть документ-основание, условия продаж заполняются из него
	//	// Если какие-то поля были явно указаны в настройке загрузки шапки, перезаполнять их не нужно
	//	ЗаполненныеРеквизитыШапки = УТ_11_4_ПолучитьЗаполненныеРеквизитыШапки(СтруктураПараметров);
	//	
	//	Попытка // В ЕРП 2.5 нет этих функций
	//		Если Док1СРезультат.ЭтоНовый() Тогда
	//			Док1СРезультат.ЗаполнитьУсловияПродажПоУмолчанию();
	//		Иначе
	//			Док1СРезультат.ЗаполнитьЭтапыГрафикаОплаты();
	//		КонецЕсли;
	//	Исключение
	//	КонецПопытки;
	//	
	//	ЗаполнитьЗначенияСвойств(Док1СРезультат, ЗаполненныеРеквизитыШапки);
	//КонецЕсли;
	
	Если ЕстьРеквизитВКоллекции(РеквизитыШапки, "ХозяйственнаяОперация") И НЕ ЗначениеЗаполнено(Док1СРезультат.ХозяйственнаяОперация) Тогда
		Док1СРезультат.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");				
	КонецЕсли;	
	
	Если Не Константы.ИспользоватьСерииНоменклатуры.Получить()  Тогда
		СтруктураПараметров.Док1СРезультат.Серии.Очистить();
	КонецЕсли;
	
	Если Док1СРезультат.ЭтоНовый() И НЕ Док1СРезультат.СкидкиРассчитаны Тогда
        Попытка
			РеализацияСверхЗаказа = ИО_ОбщийМодуль("Пользователи").РолиДоступны("РеализацияСверхЗаказа",, Ложь);
			
			ПараметрыРасчетаСкидок = Новый Структура;
	        ПараметрыРасчетаСкидок.Вставить("ПрименятьКОбъекту",                Истина);
	        ПараметрыРасчетаСкидок.Вставить("ТолькоПредварительныйРасчет",      Ложь);
	        ПараметрыРасчетаСкидок.Вставить("ВосстанавливатьУправляемыеСкидки", Ложь);
	        ПараметрыРасчетаСкидок.Вставить("УправляемыеСкидки", 				Новый СписокЗначений());
	        ПараметрыРасчетаСкидок.Вставить("РеализацияСверхЗаказа", 			РеализацияСверхЗаказа И Док1СРезультат.РеализацияПоЗаказам);
			
			ПримененныеСкидки = ИО_ОбщийМодуль("СкидкиНаценкиСервер").Рассчитать(Док1СРезультат, ПараметрыРасчетаСкидок);
			
			Док1СРезультат.СкидкиРассчитаны = Истина;
		Исключение
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
	ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
	ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("Отказ", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ""); 
	
	Если СтруктураПараметров.ДокументТСД.ШапкаДокумента.НастройкаБизнесПроцесса = "BPf7925bafd5794556b28eeb280563f91a" Тогда
						
		Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
			Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Документ обработан на ТСД! от " + ТекущаяДата();
		Иначе   
			Док1СРезультат.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
		КонецЕсли; 
		
		Док1СРезультат.Записать(); 
		
		Если Док1СРезультат.Склад.ИспользоватьАдресноеХранение Тогда 	
			СоздатьРасходныйОрдер(СтруктураПараметров, Док1СРезультат.Склад);
			//Док1СОснование.Записать(РежимЗаписиДокумента.Запись);
