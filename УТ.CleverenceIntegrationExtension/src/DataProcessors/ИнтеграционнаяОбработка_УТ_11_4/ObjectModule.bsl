Процедура УТ_11_4_ПеремещениеТоваров_ПослеВыгрузкиСтрокиТЧ_Товары_ДвДенвик(ДанныеДокумента, СтруктураПараметров) Экспорт 
	
	Если СтруктураПараметров.Документ1С.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
		Склад = "Склад";
	ИначеЕсли СтруктураПараметров.Документ1С.Метаданные().Реквизиты.Найти("СкладОтправитель") <> Неопределено Тогда
		Склад = "СкладОтправитель";
	КонецЕсли;
		
	Если СтруктураПараметров.Документ1С[Склад].ИспользоватьАдресноеХранение Тогда 
		
		Стр = СтруктураПараметров.СтрокаДокумента;
		
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ИдТовара)); 
		
		Если ЗначениеЗаполнено(Стр.ИдХарактеристики) Тогда
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ИдХарактеристики));
		Иначе
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли;   
		
		Если ЗначениеЗаполнено(Стр.ИдСерии) Тогда
			Серия = Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ИдСерии));
		Иначе
			Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
		КонецЕсли;
		
		Если Стр.Свойство("Назначение") Тогда
			Если ЗначениеЗаполнено(Стр.Назначение) Тогда
				Назначение = Справочники.Назначения.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.Назначение));
			Иначе
				Назначение = Справочники.Назначения.ПустаяСсылка(); 
			КонецЕсли;
		Иначе 
			Назначение = Справочники.Назначения.ПустаяСсылка(); 
		КонецЕсли;	
			
		СтруктураЯчеекССерией = ВыполнитьПоискСерийВЯчейкахПоFEFO(Номенклатура, Характеристика, Серия, Назначение, Стр.КоличествоПлан);
				
		СтруктураПараметров.СтрокаДокумента.Вставить("Дв_СписокСерии", СтруктураЯчеекССерией.СписокСерий);
		СтруктураПараметров.СтрокаДокумента.Вставить("Дв_СписокЯчеек", СтруктураЯчеекССерией.СписокЯчеек);
		//СтруктураПараметров.СтрокаДокумента.Вставить("Дв_ИдНазначения", СтруктураЯчеекССерией.ИдНазначения);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура УТ_11_4_ПеремещениеТоваров_ОбработкаЗагрузки(СтруктураПараметров) Экспорт 
	
	Попытка
		УТ_11_2_Общий_ПередЗаполнениемДокумента	(СтруктураПараметров);
	Исключение
	КонецПопытки;
	
	Док1СРезультат 			= СтруктураПараметров.Док1СРезультат;
	Док1СОснование          = СтруктураПараметров.Док1СОснование;
	ДокументMS              = СтруктураПараметров.ДанныеДокументаMS;
	
	Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументMS.ШапкаДокумента.ИдСклада1СОткуда));
	
	Док1СОснование = Док1СОснование.ПолучитьОбъект();
	
	Если ЗначениеЗаполнено(Док1СОснование.Комментарий) Тогда
		Док1СОснование.Комментарий = Док1СОснование.Комментарий + Символы.ПС + "Документ обработан на ТСД! от " + ТекущаяДата();
	Иначе   
		Док1СОснование.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
	КонецЕсли; 
	
	Док1СОснование.Записать();
		
	СтруктураПараметров.Вставить("Отказ", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "");

	Если Склад.ИспользоватьАдресноеХранение Тогда 	
		СоздатьРасходныйОрдер(СтруктураПараметров, Склад);
		//Док1СОснование.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли; 
	
	Если НЕ СтруктураПараметров.Отказ Тогда
		СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	КонецЕсли;
	
	
КонецПроцедуры

Функция ВыполнитьПоискСерийВЯчейкахПоFEFO(Номенклатура, Характеристика, Серия, Назначение, Количество) Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
    |	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТоварыВЯчейкахОстатки.Назначение)) КАК ИдНазначения,
	|	ТоварыВЯчейкахОстатки.Назначение КАК Назначение,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличииОстаток,
	|	ТоварыВЯчейкахОстатки.Серия.ДатаПроизводства КАК СерияДатаПроизводства,
	|	ТоварыВЯчейкахОстатки.Серия.ГоденДо КАК СерияГоденДо
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|			И Характеристика = &Характеристика
	|			И Назначение = &Назначение
	|			И Серия = &Серия) КАК ТоварыВЯчейкахОстатки
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	СерияГоденДо,
	|	СерияДатаПроизводства";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Характеристика = &Характеристика", "");
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Назначение) Тогда
		Запрос.УстановитьПараметр("Назначение", Назначение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Назначение = &Назначение", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Серия) Тогда
		Запрос.УстановитьПараметр("Серия", Серия);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Серия = &Серия", "");
	КонецЕсли;  
	
	Результат 	 = Запрос.Выполнить().Выбрать();
	Счетчик 	 = 0;
	СписокСерий  = "";
	СписокЯчеек  = "";
	ИдНазначения = "";
	
	Пока Результат.Следующий() Цикл 
		
		Если Счетчик >= Количество Тогда
			Прервать;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Результат.Серия) Тогда
			СписокСерий  = СписокСерий + Строка(Результат.Серия) + "; ";
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(Результат.Ячейка) Тогда
			СписокЯчеек  = СписокЯчеек + Строка(Результат.Ячейка) + "; ";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат.ИдНазначения) И ЗначениеЗаполнено(Назначение) Тогда
			ИдНазначения = Строка(Результат.ИдНазначения);
		КонецЕсли;
		
		Счетчик 		 = Счетчик + Результат.ВНаличииОстаток;
		
	КонецЦикла;
	
	Структура = Новый Структура("СписокСерий, СписокЯчеек, ИдНазначения", СписокСерий, СписокЯчеек, ИдНазначения);
	Возврат Структура;
	
КонецФункции	

Функция ПоискОстатковСерий(ИдТовара, ИдСклада, ИдНазначения = "") Экспорт 
	
	Если ЗначениеЗаполнено(ИдТовара) Тогда
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдТовара));
	Иначе
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдСклада) Тогда
		Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСклада));
	Иначе
		Склад = Справочники.Склады.ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдНазначения) Тогда
		Назначение = Справочники.Назначения.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдНазначения));
	Иначе
		Назначение = Справочники.Назначения.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	|	ТоварыНаСкладахОстатки.Назначение КАК Назначение,
	|	ТоварыНаСкладахОстатки.Склад КАК Склад,
	|	ТоварыНаСкладахОстатки.Серия КАК Серия,
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ВНаличииОстаток,
	|	ТоварыНаСкладахОстатки.Серия.ГоденДо КАК СерияГоденДо,
	|	ТоварыНаСкладахОстатки.Серия.ДатаПроизводства КАК СерияДатаПроизводства
	|ПОМЕСТИТЬ ВТ_ТоварыНаСкладе
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Склад = &Склад
	|				И Назначение = &Назначение) КАК ТоварыНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_ТоварыНаСкладе.Номенклатура)) КАК ИдТовара,
	|	ВТ_ТоварыНаСкладе.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_ТоварыНаСкладе.Характеристика)) КАК ИдХарактеристики,
	|	ВТ_ТоварыНаСкладе.Характеристика КАК ИмяХарактеристики,  
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ТоварыНаСкладе.Назначение) КАК ИмяНазначение,
	|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_ТоварыНаСкладе.Назначение)) КАК ИдНазначение,
	|	ВТ_ТоварыНаСкладе.Склад КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_ТоварыНаСкладе.Серия)) КАК ИдСерии,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ТоварыНаСкладе.Серия) КАК ИмяСерии,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличииОстаток,
	|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТоварыВЯчейкахОстатки.Ячейка)) КАК ИдЯчейки,
	|	ПРЕДСТАВЛЕНИЕ(ТоварыВЯчейкахОстатки.Ячейка) КАК ИмяЯчейки,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ВТ_ТоварыНаСкладе.СерияГоденДо КАК СерияГоденДо,
	|	ВТ_ТоварыНаСкладе.СерияДатаПроизводства КАК СерияДатаПроизводства,
	|	ВТ_ТоварыНаСкладе.Серия.Номер КАК СерияНомер
	|ИЗ
	|	ВТ_ТоварыНаСкладе КАК ВТ_ТоварыНаСкладе
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, Номенклатура = &Номенклатура) КАК ТоварыВЯчейкахОстатки
	|		ПО ВТ_ТоварыНаСкладе.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|			И ВТ_ТоварыНаСкладе.Характеристика = ТоварыВЯчейкахОстатки.Характеристика
	|			И ВТ_ТоварыНаСкладе.Назначение = ТоварыВЯчейкахОстатки.Назначение
	|			И ВТ_ТоварыНаСкладе.Серия = ТоварыВЯчейкахОстатки.Серия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ТоварыНаСкладе.СерияГоденДо,
	|	ВТ_ТоварыНаСкладе.СерияДатаПроизводства";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Если ЗначениеЗаполнено(Назначение) Тогда
		Запрос.УстановитьПараметр("Назначение", Назначение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Назначение = &Назначение", "");
	КонецЕсли;

	
	Результат = Запрос.Выполнить().Выбрать(); 
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Ид", 				Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ИмяСерии", 		Новый ОписаниеТипов("Строка")); 
	ТЗ.Колонки.Добавить("Номер", 			Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ИдЯчейки", 		Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ИмяЯчейки", 		Новый ОписаниеТипов("Строка")); 
	ТЗ.Колонки.Добавить("ИдХарактеристики", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ИмяХарактеристики",Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Количество", 		Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("ИдНазначения",		Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ИмяНазначения",	Новый ОписаниеТипов("Строка"));
	
	Пока Результат.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Результат.ИдЯчейки) Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтрока 					= ТЗ.Добавить();
		НоваяСтрока.Ид 					= Результат.ИдСерии;
		НоваяСтрока.ИмяСерии 			= Результат.ИмяСерии;
		НоваяСтрока.Номер 				= Результат.СерияНомер;
		НоваяСтрока.ИдЯчейки 			= Результат.ИдЯчейки;
		НоваяСтрока.ИмяЯчейки 			= Результат.ИмяЯчейки;
		НоваяСтрока.ИдХарактеристики 	= Результат.ИдХарактеристики ;
		НоваяСтрока.ИмяХарактеристики 	= Результат.ИмяХарактеристики;
		НоваяСтрока.Количество 			= Результат.ВНаличииОстаток;
		НоваяСтрока.ИдНазначения		= Результат.ИдНазначение; 
		НоваяСтрока.ИмяНазначения		= Результат.ИмяНазначение;
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции	

#КонецОбласти


#Область ТехОбработки

Функция REST_API_ТаблицаЗначенийВМассивСтруктур(ТаблицаЗначений)
	Результат = Новый Массив;
	
	Для каждого Строка Из ТаблицаЗначений Цикл	
		СтрокаРезультата = Новый Структура;
		
		Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			
			ЗначениеРеквизита = Строка[Колонка.Имя];
			Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
				Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
					ЗначениеРеквизита = REST_API_ФорматДаты(ЗначениеРеквизита);	
				Иначе
					ЗначениеРеквизита = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаРезультата.Вставить(Колонка.Имя, ?(ЗначениеЗаполнено(ЗначениеРеквизита), ЗначениеРеквизита, "")); 
		КонецЦикла;
		
		Результат.Добавить(СтрокаРезультата);
	 КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ГлЯдро_МассивСтруктурВТаблицуЗначений(МассивСтруктур) Экспорт
	
	ТекстОшибки = "";
	
	Если ТипЗнч(МассивСтруктур) <> Тип("Массив") Тогда
	    ТекстОшибки = НСтр("be = 'Памылка пры ачысцці табліцы [%1]'; en = 'Error converting array of structures to table of values: Parameter is not an array!'; es = 'Error al convertir una matriz de estructuras en una tabla de valores: ¡El parámetro no es una matriz!'; ka = 'სტრუქტურის მასივის გადაყვანის შეცდომა: პარამეტრი არ არის მასივი!'; kk = 'Массивтің массивын кесте мәліметтеріне айналдыру қатесі: Параметр массив емес!'; ro = 'Eroare la transformarea matricei de structuri în tabel de valori: Parametrul nu este o matrice!'; ru = 'Ошибка преобразования массива структур в таблицу значений: Параметр не является массивом!'; tr = 'Yapılandırma tablosuna dizi yapılarını değer tablosuna dönüştürme hatası: Parametre bir dizi değil!'; uk = 'Помилка перетворення масиву структур в таблицю значень: Параметр не є масивом!'; uz = 'Massiv strukturani qiymatlar jadvaliga aylantirishda xatolik: Parametr massiv emas!'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить(); // tr
		Возврат Неопределено;
	КонецЕсли; 
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеТЗ = МассивСтруктур[0];
	Если ТипЗнч(ОписаниеТЗ) <> Тип("Структура") Тогда
		ТекстОшибки = НСтр("be = ""Памылка пераўтварэння масіва структур у табліцу значэнняў: Параметр не з'яўляецца масівам!""; en = 'Error converting array of structures to table of values: Table of values description not found!'; es = 'Error al convertir una matriz de estructuras en una tabla de valores: ¡No se encontró la descripción de la tabla de valores!'; ka = 'სტრუქტურის მასივის გადაყვანის შეცდომა: მნიშვნელობების ცხრილის აღწერა ვერ მოიძებნა!'; kk = 'Кесте мәліметтерінің массивінің кесте мәліметтеріне айналдыру қатесі: Мәліметтер кестесі сипаттамасы табылмады!'; ro = 'Eroare la transformarea matricei de structuri în tabel de valori: Nu s-a găsit descrierea tabelului de valori!'; ru = 'Ошибка преобразования массива структур в таблицу значений: Не обнаружено описание таблицы значений!'; tr = 'Yapılandırma tablosuna dizi yapılarını değer tablosuna dönüştürme hatası: Değer tablosu tanımı bulunamadı!'; uk = 'Помилка перетворення масиву структур в таблицю значень: Не виявлено опис таблиці значень!'; uz = 'Massiv strukturani qiymatlar jadvaliga aylantirishda xatolik: Qiymatlar jadvali tavsifi topilmadi!'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить(); 
		Возврат Неопределено;
	КонецЕсли;
	
	КолонкиТЗ = "";
	Если НЕ ОписаниеТЗ.Свойство("ЭтоТаблицаЗначений") ИЛИ НЕ ОписаниеТЗ.Свойство("КолонкиТаблицыЗначений") Тогда
		МассивКолонок = Новый Массив;
		Для Каждого Колонка Из ОписаниеТЗ Цикл
			МассивКолонок.Добавить(Колонка.Ключ);	
		КонецЦикла;
		ИндексНачала = 0;
	Иначе 
		КолонкиТЗ = ОписаниеТЗ.КолонкиТаблицыЗначений;
		МассивКолонок = ГлЯдро_РазложитьСтрокуВМассивПодстрок(КолонкиТЗ, ",");
		ИндексНачала = 1;
	КонецЕсли;
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Для каждого НаименованиеКолонки Из МассивКолонок Цикл
		ТаблицаЗначений.Колонки.Добавить(НаименованиеКолонки);
	КонецЦикла; 
	
	Для Сч = ИндексНачала По МассивСтруктур.Количество() - 1 Цикл
		
		Если ТипЗнч(МассивСтруктур[Сч]) = Тип("Структура") Тогда
			НоваяСтрока = ТаблицаЗначений.Добавить();
			Результат = Новый Структура();
			Для каждого Элемент Из МассивСтруктур[Сч] Цикл
			
				Если ТипЗнч(Элемент.Значение) = Тип("Массив")Тогда
				
					Результат.Вставить(Элемент.Ключ, ГлЯдро_МассивСтруктурВТаблицуЗначений(Элемент.Значение));
					
				Иначе
					
					Результат.Вставить(Элемент.Ключ, Элемент.Значение);
					
				КонецЕсли; 
			
			КонецЦикла; 
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат);
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ТаблицаЗначений;

КонецФункции            

Функция ГлЯдро_СкопироватьСтруктуру(СтруктураИсточник,СписокКолонок = Неопределено) Экспорт
	СтруктураПриемник = Новый Структура;
	
	Если СписокКолонок <> Неопределено Тогда
		Колонки = ГлЯдро_РазложитьСтрокуВМассивПодстрок(СписокКолонок, ",");
	КонецЕсли;
	
	Для Каждого ЭлементСтруктуры Из СтруктураИсточник Цикл
		
		Если СписокКолонок <> Неопределено 
			И Колонки.Найти(ЭлементСтруктуры.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Структура") Тогда
			СтруктураПриемник.Вставить(ЭлементСтруктуры.Ключ, ГлЯдро_СкопироватьСтруктуру(ЭлементСтруктуры.Значение));
		ИначеЕсли ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Массив") Тогда
			СтруктураПриемник.Вставить(ЭлементСтруктуры.Ключ, ГлЯдро_СкопироватьМассив(ЭлементСтруктуры.Значение));
		Иначе
			СтруктураПриемник.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтруктураПриемник;
КонецФункции 

// Разбивает строку на несколько строк по указанному разделителю. Разделитель может иметь любую длину.
//
// Параметры:
//  Значение    - Строка - текст с разделителями
//  Разделитель - Строка - разделитель строк текста, минимум 1 символ
//
// Возвращаемое значение:
//  Массив из Строка
Функция ГлЯдро_РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = СокрЛ(Сред(Стр, Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				Если (СокрЛП(Стр) <> "") Тогда
					МассивСтрок.Добавить(Стр);
				КонецЕсли;
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз - 1));
			Стр = Сред(Стр, Поз + ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция REST_API_ФорматДаты(пДата)
	
	Смещение = СмещениеСтандартногоВремени();
	Если Смещение < 0 Тогда
		Смещение = Смещение *-1;
		Знак="-";
	Иначе		
		Знак="+";
	КонецЕсли;
	GTM = Прав("0"+Строка(Цел(Смещение/3600)),2)+":"+Прав("0"+Строка(Цел(Смещение%3600/60)),2);
	Возврат Формат(пДата,"ДФ=yyyy-MM-ddTHH:mm:ss")+".0000000"+Знак+GTM;
	
КонецФункции

Функция ГлЯдро_СкопироватьМассив(МассивИсточник,Отбор = Неопределено) Экспорт
	Если ТипЗнч(МассивИсточник)<>Тип("Массив") Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	МассивПриемник = Новый Массив;
	Для Каждого ЭлементМассива Из МассивИсточник Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
			Если Отбор <> Неопределено 
				И НЕ ГлЯдро_СтруктураПодходитПодОтбор(ЭлементМассива,Отбор) Тогда
				Продолжить;
			КонецЕсли;
			МассивПриемник.Добавить(ГлЯдро_СкопироватьСтруктуру(ЭлементМассива));
		ИначеЕсли ТипЗнч(ЭлементМассива) = Тип("Массив") Тогда
			МассивПриемник.Добавить(ГлЯдро_СкопироватьМассив(ЭлементМассива));
		Иначе
			МассивПриемник.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;	
	Возврат МассивПриемник;
КонецФункции

// Проверяет соответствие произвольной структуры переданному отбору
// Соответствие подразумевает, что в структуре есть все ключи, содержащиеся в отборе,
// и значения структуры и отбора по одинаковым ключам совпадают.
//
// Параметры:
//	Структура - Структура - структура, которую требуется проверить на соответствие отбору.
//	Отбор - Структура - отбор, по которому требуется проверить соответствие.
//
// Возвращаемое значение:
//	Булево - признак соответствия структуры переданному отбору.
Функция ГлЯдро_СтруктураПодходитПодОтбор(Структура,Отбор) Экспорт
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если НЕ Структура.Свойство(ЭлементОтбора.Ключ)
			ИЛИ Структура[ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

