	ОсобенностиУчетаИС = УТ_11_4_ПолучитьРеквизитыОсобенностейУчетаИС();
	
	ЗначенияПеречисления = Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления;
	
	ИспользованиеПолныхКодовМаркировки = Истина;
	Если ИспользованиеПолныхКодовМаркировки Тогда
		ТаблицаДляСохраненияВПул = Новый ТаблицаЗначений;		
		ТаблицаДляСохраненияВПул.Колонки.Добавить("КодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ПолныйКодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("GTIN");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ТипШтрихкода");
	КонецЕсли;
	
	ИдентификаторСтроки = Новый УникальныйИдентификатор;
	
	СоответствиеКлючейСтрок = Новый Соответствие;
	
	Для Каждого СтрокаФакт Из СтруктураПараметров.ДанныеДокументаMS.СтрокиФакт Цикл
		
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		СканированнаяМарка = "";
		Если СтрокаФакт.Свойство("Марка") И ЗначениеЗаполнено(СтрокаФакт.Марка) Тогда
			СканированнаяМарка = СтрокаФакт.Марка;
		ИначеЕсли СтрокаФакт.Свойство("GS1Марка") И ЗначениеЗаполнено(СтрокаФакт.GS1Марка) Тогда
			СканированнаяМарка = СтрокаФакт.GS1Марка;
		ИначеЕсли СтрокаФакт.Свойство("МаркаСтандарт") И ЗначениеЗаполнено(СтрокаФакт.МаркаСтандарт) Тогда
			СканированнаяМарка = СтрокаФакт.МаркаСтандарт;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СканированнаяМарка) Тогда
			Продолжить;			
		КонецЕсли;
		
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара));
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;			
		КонецЕсли;

		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Номенклатура", 		Номенклатура);
		СтруктураОтбора.Вставить("ИдентификаторСтроки",	"");
		
		СтрокиТовара = Док1СРезультат.Товары.НайтиСтроки(СтруктураОтбора);
		Если СтрокиТовара.Количество() <> 0 Тогда
			Для Каждого СтрокаТовара Из СтрокиТовара Цикл
				СтрокаТовара.ИдентификаторСтроки = Строка(ИдентификаторСтроки);
			КонецЦикла;
			СоответствиеКлючейСтрок.Вставить(Номенклатура, ИдентификаторСтроки);
			ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		ВидПродукцииИС = Неопределено;
		
		ОсобенностьУчета = ОсобенностиУчетаИС.Получить(Номенклатура.ОсобенностьУчета);
		Если ОсобенностьУчета <> Неопределено Тогда
			Если ЗначенияПеречисления.Найти(ОсобенностьУчета.Имя) <> Неопределено Тогда
				ВидПродукцииИС = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС." + ОсобенностьУчета.Имя);
			ИначеЕсли ЗначенияПеречисления.Найти(ОсобенностьУчета.ЗначениеМаркировки) <> Неопределено Тогда
				ВидПродукцииИС = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС." + ОсобенностьУчета.ЗначениеМаркировки);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеРазбора = ИО_РазобратьКодМаркировки(СканированнаяМарка, ВидПродукцииИС);
			
		НормализованныйКодМаркировки = "";
		Если ТипЗнч(ДанныеРазбора) = Тип("Структура")
			И ДанныеРазбора.Свойство("НормализованныйКодМаркировки", НормализованныйКодМаркировки)
			И ЗначениеЗаполнено(НормализованныйКодМаркировки) Тогда
			СканированнаяМарка = НормализованныйКодМаркировки;
		ИначеЕсли Сред(СканированнаяМарка, 36, 5) = "(240)" Тогда
			СканированнаяМарка = Лев(СканированнаяМарка, 4+14+4+13+5+4); // 10.04.20 Для Старых марок с ТНВЭД	
		Иначе			
			СканированнаяМарка = Лев(СканированнаяМарка, 4+14+4+13); // Полную марку ИСМП не принимает, нужна только GTIN+Серийный номер
		КонецЕсли;
			
		ПолныйКодМаркировки = ?(СтрокаФакт.Свойство("ПолнаяМаркаBase64"), СтрокаФакт.ПолнаяМаркаBase64, "");
		Если ИспользованиеПолныхКодовМаркировки 
			И ЗначениеЗаполнено(ПолныйКодМаркировки) Тогда
			НоваяСтрокаДляПула = ТаблицаДляСохраненияВПул.Добавить();
			НоваяСтрокаДляПула.ПолныйКодМаркировки = ПолныйКодМаркировки;
				
			Если ТипЗнч(ДанныеРазбора) = Тип("Структура") Тогда
				Если ДанныеРазбора.Свойство("СоставКодаМаркировки")
					И ТипЗнч(ДанныеРазбора.СоставКодаМаркировки) = Тип("Структура")
					И ДанныеРазбора.СоставКодаМаркировки.Свойство("GTIN") Тогда
					GTIN = ДанныеРазбора.СоставКодаМаркировки.GTIN;
				Иначе
					GTIN = ?(Лев(СканированнаяМарка, 4) = "(01)", Сред(СканированнаяМарка, 5, 14), "");
				КонецЕсли;
					
				НоваяСтрокаДляПула.КодМаркировки = СканированнаяМарка;
				НоваяСтрокаДляПула.ТипШтрихкода  = ?(ДанныеРазбора.Свойство("ТипШтрихкода"), ДанныеРазбора.ТипШтрихкода, Неопределено);
				НоваяСтрокаДляПула.GTIN 		 = GTIN;
			Иначе
				НоваяСтрокаДляПула.КодМаркировки = СканированнаяМарка;
				НоваяСтрокаДляПула.GTIN 		 = ?(Лев(СканированнаяМарка, 4) = "(01)", Сред(СканированнаяМарка, 5, 14), "");
			КонецЕсли;
		КонецЕсли;
		
		АкцизнаяМарка = НайтиУпаковкуТоваровПоШтрихкоду(СканированнаяМарка);
		
		Если СтрокаФакт.Свойство("ИдЕдиницыИзмерения") И ЗначениеЗаполнено(СтрокаФакт.ИдЕдиницыИзмерения) Тогда
			УпаковкаТовара =  Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдЕдиницыИзмерения));
			ЭтоБазоваяУпаковка = ?(УпаковкаТовара.Владелец = ПредопределенноеЗначение("Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения"), Истина, Ложь); 
		Иначе
			УпаковкаТовара = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
			ЭтоБазоваяУпаковка = Истина;
		КонецЕсли;
		
		Если АкцизнаяМарка = Неопределено Тогда
			Если ЗначениеЗаполнено(УпаковкаТовара) И НЕ ЭтоБазоваяУпаковка Тогда  
				Если УпаковкаТовара.Числитель = 1 и УпаковкаТовара.Знаменатель = 1 Тогда
					ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
				Иначе
					ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
				КонецЕсли;
			Иначе
				ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
			КонецЕсли;  
			Если СтрокаФакт.Свойство("ИдХарактеристики")
				И ЗначениеЗаполнено(СтрокаФакт.ИдХарактеристики) Тогда 
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдХарактеристики)); 
			Иначе
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			КонецЕсли;
			Если СтрокаФакт.Свойство("ИдСерии")
				И ЗначениеЗаполнено(СтрокаФакт.ИдСерии) Тогда
				Серия = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдСерии));
			Иначе
				Серия = Справочники["СерииНоменклатуры"].ПустаяСсылка();
			КонецЕсли;
			
			СтруктураСозданияУпаковки = Новый Структура;
			СтруктураСозданияУпаковки.Вставить("ШтрихКод", 			СканированнаяМарка);
			СтруктураСозданияУпаковки.Вставить("ТипУпаковки", 		ТипУпаковки);
			СтруктураСозданияУпаковки.Вставить("Номенклатура", 		Номенклатура);
			СтруктураСозданияУпаковки.Вставить("Характеристика", 	Характеристика);
			СтруктураСозданияУпаковки.Вставить("Серия", 			Серия);
			СтруктураСозданияУпаковки.Вставить("Упаковка",			УпаковкаТовара);
			СтруктураСозданияУпаковки.Вставить("БазоваяУпаковка",	ЭтоБазоваяУпаковка);

			
			АкцизнаяМарка = СоздатьУпаковкуМаркированнойОбуви(СтруктураСозданияУпаковки);
		Иначе
			// Если не заполнена номенклатура, то укажем ее
			Если Не ЗначениеЗаполнено(АкцизнаяМарка.Номенклатура) Тогда
				АкцизнаяМаркаОбъект = АкцизнаяМарка.ПолучитьОбъект();
				АкцизнаяМаркаОбъект.Номенклатура = Номенклатура;
				АкцизнаяМаркаОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АкцизнаяМарка) Тогда
			СтрокаМарок = Док1СРезультат.АкцизныеМарки.Добавить();
			СтрокаМарок.КодАкцизнойМарки 		= СканированнаяМарка;
			СтрокаМарок.АкцизнаяМарка 			= АкцизнаяМарка;
			СтрокаМарок.ШтрихкодУпаковки 		= АкцизнаяМарка;
			СтрокаМарок.ИдентификаторСтроки		= СоответствиеКлючейСтрок.Получить(Номенклатура);
		КонецЕсли;
				
	КонецЦикла;
	
	Если ИспользованиеПолныхКодовМаркировки Тогда	
		ИСМП_СохранитьКодыМаркировкиВПул(ТаблицаДляСохраненияВПул, СтруктураПараметров);
	КонецЕсли;

КонецПроцедуры

Функция ИО_ТекстКритическойОшибкиИСМП(ВидПродукцииИС = Неопределено)

	Если НЕ ЗначениеЗаполнено(ВидПродукцииИС) Тогда
		ТекстВидПродукции = "<вид продукции не определен>";
	Иначе
		ТекстВидПродукции = НРег(СокрЛП(ВидПродукцииИС));
	КонецЕсли;
	
	ТекстОшибки = "Ошибка заполнения данных проверки и подбора маркированной продукции (" + ТекстВидПродукции + "). Подробности об ошибке смотрите в последних записях журнала регистрации 1С.";
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция УТ_11_4_ЗаполнитьФискальныйРегистраторМагазина(СтруктураПараметров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КассыККМ.Ссылка КАК Касса
		|ИЗ
		|	Справочник.КассыККМ КАК КассыККМ
		|ГДЕ
		|	КассыККМ.Склад = &Магазин
		|	И КассыККМ.ТипКассы = ЗНАЧЕНИЕ(Перечисление.ТипыКассККМ.ФискальныйРегистратор)
		|	И НЕ КассыККМ.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Магазин", СтруктураПараметров.Док1СРезультат.Склад);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураПараметров.Док1СРезультат.КассаККМ = Выборка.Касса;
	КонецЕсли;
	
КонецФункции

// Возвращает значения реквизитов шапки, заполненные в соответствии с настройкой бизнес-процесса
Функция УТ_11_4_ПолучитьЗаполненныеРеквизитыШапки(СтруктураПараметров)
	
	Док1СРезультат  = СтруктураПараметров.Док1СРезультат;
	СтрокаНастройки = СтруктураПараметров.СтрокаНастройки;
	
	ЗаполненныеРеквизитыШапки = Новый Структура;
	
	НастройкаЗагрузкиПолей = Неопределено;
	Если ТипЗнч(СтрокаНастройки) = Тип("Структура")
		И СтрокаНастройки.Свойство("НастройкаЗагрузкиПолей", НастройкаЗагрузкиПолей)
		И ТипЗнч(НастройкаЗагрузкиПолей) = Тип("Массив") Тогда
		Для каждого НастройкаЗагрузки ИЗ НастройкаЗагрузкиПолей Цикл
			Если НастройкаЗагрузки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяПриемника = "";
			Если НастройкаЗагрузки.Свойство("ИмяПриемника", ИмяПриемника)
				И НЕ ПустаяСтрока(ИмяПриемника) Тогда
				ЗаполненныеРеквизитыШапки.Вставить(ИмяПриемника, Док1СРезультат[ИмяПриемника]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЗаполненныеРеквизитыШапки;
	
КонецФункции

Процедура УТ_11_4_ЗаполнитьРеквизитыДоставки(Док1СРезультат, Док1СОснование)
	
	Попытка
		РеквизитыДоставки = ИО_ОбщийМодуль("ДоставкаТоваровКлиентСервер").ПолучитьПустуюСтруктуруРеквизитовДоставки(Док1СОснование);
	Исключение
		Возврат;
	КонецПопытки;
	
	РеквизитыШапкиРезультат = Док1СРезультат.Метаданные().Реквизиты;
	РеквизитыШапкиОснование = Док1СОснование.Метаданные().Реквизиты;
	
	МассивРеквизитов = Новый Массив;
	
	Для каждого РеквизитДоставки ИЗ РеквизитыДоставки Цикл
		Если ЕстьРеквизитВКоллекции(РеквизитыШапкиРезультат, РеквизитДоставки.Ключ)
			И ЕстьРеквизитВКоллекции(РеквизитыШапкиОснование, РеквизитДоставки.Ключ) Тогда
			МассивРеквизитов.Добавить(РеквизитДоставки.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ МассивРеквизитов.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Док1СРезультат, Док1СОснование, ГлЯдро_СтрСоединить(МассивРеквизитов, ","));
	
КонецПроцедуры

Процедура УТ_11_4_РеализацияТоваровУслуг_ПараметрыОснования(СтруктураПараметров)

	ИмяСобытия = "УТ_11_4_РеализацияТоваровУслуг_ПараметрыОснования";
	
	ИспользоватьРеализациюПоНесколькимЗаказам = ПолучитьФункциональнуюОпциюНаСервере("ИспользоватьРеализациюПоНесколькимЗаказам");
	Если НЕ ИспользоватьРеализациюПоНесколькимЗаказам = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;
	
	ЕстьДокументОснование = Док1СОснование <> Неопределено И Док1СОснование <> Док1СРезультат;
	
	ПроверитьВводРеализацииНаОснованииНесколькихЗаказов = Док1СРезультат.ЭтоНовый()
		И ЕстьДокументОснование И ТипЗнч(Док1СОснование) = Тип("ДокументСсылка.ЗаказКлиента");
	Если НЕ ПроверитьВводРеализацииНаОснованииНесколькихЗаказов Тогда
		Возврат;
	КонецЕсли;
	
	ШапкаДокумента = СтруктураПараметров.ДокументТСД.ШапкаДокумента;
	
	ВводОднойРеализацииНаОснованииНесколькихЗаказов = Ложь;
	Если ШапкаДокумента.Свойство("ИдИсходныхДокументов") И ЗначениеЗаполнено(ШапкаДокумента.ИдИсходныхДокументов) Тогда
		НастройкаБП = СтруктураПараметров.СтрокаНастройки;
		
		ВводОднойРеализацииНаОснованииНесколькихЗаказов = НастройкаБП.Свойство("НеРазбиватьОбъединенныйДокументПриЗагрузке")
			И НастройкаБП.НеРазбиватьОбъединенныйДокументПриЗагрузке = Истина;
	КонецЕсли;
		
	Если НЕ ВводОднойРеализацииНаОснованииНесколькихЗаказов Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗаказов = Новый Массив;
			
	ИдИсходныхДокументов = РазложитьСтрокуВМассивПодстрок(ШапкаДокумента.ИдИсходныхДокументов, ";");
	Для каждого ИдИсходногоДокумента ИЗ ИдИсходныхДокументов Цикл
		ЗаказКлиента = ГлЯдро_ПолучитьСсылкуНаДокументПоИд("ЗаказКлиента", ИдИсходногоДокумента);
		Если НЕ ЗаказКлиента = Неопределено Тогда
			МассивЗаказов.Добавить(ЗаказКлиента);
		КонецЕсли;
	КонецЦикла;	
			
	Если НЕ МассивЗаказов.Количество()
		ИЛИ МассивЗаказов.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
		
	РеквизитыШапки = Новый Структура;
		
	Попытка
		ВводНаОснованииВозможен = ИО_ОбщийМодуль("ПродажиВызовСервера").СформироватьДанныеЗаполненияРеализации(
			МассивЗаказов, "РеализацияТоваровУслуг", РеквизитыШапки);
			
		Если НЕ ВводНаОснованииВозможен Тогда
			Для Индекс = 0 ПО МассивЗаказов.Количество() - 1 Цикл
				МассивЗаказов[Индекс] = Строка(МассивЗаказов[Индекс]);
			КонецЦикла;
				
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
				ГлЯдро_СтрШаблон("Не удалось сформировать данные заполнения реализации на основании нескольких заказов %1", ГлЯдро_СтрСоединить(МассивЗаказов, ", ")));
			Возврат;
		КонецЕсли;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ПараметрыОснования = Новый Структура;
	ПараметрыОснования.Вставить("СкладОтгрузки", 			Неопределено);
	ПараметрыОснования.Вставить("ВариантОформленияПродажи", ПредопределенноеЗначение("Перечисление.ВариантыОформленияПродажи.РеализацияТоваровУслуг"));
	ПараметрыОснования.Вставить("РеквизитыШапки",      		РеквизитыШапки);
	ПараметрыОснования.Вставить("ДокументОснование",   		МассивЗаказов);

	СтруктураПараметров.Вставить("ПараметрыОснования", ПараметрыОснования);
	
КонецПроцедуры

#КонецОбласти

// Выполняет поиск в массиве структур по заданным ключу и значению ключа
//
// Параметры:
//	МассивСтруктур - Массив из Структура - массив структур, в котором выполняетчся поиск
//	КлючПоиска - Строка - ключ структуры, по которому выполняется поиск
//	ЗначениеПоиска - Произвольный - значение ключа структуры, по которому выполняется поиск
//	ВернутьИндекс - Булево - флаг необходимости вернуть индекс элемента массива, а не сам элемент
//
// Возвращаемое значение:
//	- Число - индекс найденного элемента массива, если ВернутьИндекс = Истина
//	- Структура - значение найденного элемента массива, если ВернутьИндекс = Ложь
//	- Неопределено - если элемент массива найти не удалось
Функция НайтиСтруктуруВМассивеПоЭлементу(МассивСтруктур, КлючПоиска, ЗначениеПоиска,ВернутьИндекс=Ложь)
	
	Если ТипЗнч(МассивСтруктур) <> Тип("Массив") 
		ИЛИ КлючПоиска = "" Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	НайденноеЗначениеЭлемента = Неопределено;
	Индекс = -1;
	Для каждого ЭлементМассива Из МассивСтруктур Цикл
		Индекс = Индекс + 1;
		Если ТипЗнч(ЭлементМассива) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;  
		
		Если ЭлементМассива.Свойство(КлючПоиска, НайденноеЗначениеЭлемента) Тогда
			Если НайденноеЗначениеЭлемента = ЗначениеПоиска Тогда
				Возврат ?(ВернутьИндекс,Индекс,ЭлементМассива);
			КонецЕсли; 
		КонецЕсли; 
	
	КонецЦикла; 
	
	Возврат Неопределено;

КонецФункции // НайтиСтруктуруВМассивеПоЭлементу()

// Выполняет поиск общего модуля БСП для выполнения кода в безопасном режиме
//
Функция ПолучитьОбщийМодульВыполненияВБезопасномРежиме() Экспорт
	
	Алгоритм = "Успешно = Истина";
	
	НачатьТранзакцию();
	Попытка
		ОбщегоНазначения.ВыполнитьВБезопасномРежиме(Алгоритм, Неопределено);
		ИмяМодуля = "ОбщегоНазначения";
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Найти(ТекстОшибки, "Метод объекта не обнаружен") > 0 Тогда
			Попытка
				// Начиная с УТ 11.0 по УТ 11.3 метод располагается в модуле "РаботаВБезопасномРежиме"
				ИО_ОбщийМодуль("РаботаВБезопасномРежиме").ВыполнитьВБезопасномРежиме(Алгоритм, Неопределено);
				ИмяМодуля = "РаботаВБезопасномРежиме";
			Исключение
				ИмяМодуля = "";
			КонецПопытки;
		КонецЕсли;
	КонецПопытки;
	
	Возврат ИмяМодуля;
	
КонецФункции

Функция ДобавитьНоменклатуруВЯчейкуСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, ОбновитьВыгруженныйСправочник) Экспорт
	
	ИмяСобытия = "ДобавитьНоменклатуруВЯчейкуСправочно";
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	ДанныеРазмещения = ПолучитьЗначенияИзмеренийСпрЯчейки(ИмяЯчейки, ИдТовара, ИдСклада1С, МетаданныеНСИ);
	
	Если ДанныеРазмещения = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураПриоритетов = ПриоритетыСпрЯчейки(ДанныеРазмещения.Склад, ДанныеРазмещения.Помещение, ДанныеРазмещения.Номенклатура, ДанныеРазмещения.Ячейка);
	
	Попытка
		НоваяЗапись = РегистрыСведений[МетаданныеНСИ.СпрЯчейки.ИмяСправочника].СоздатьМенеджерЗаписи();
		НоваяЗапись.Номенклатура 	= ДанныеРазмещения.Номенклатура;
		НоваяЗапись.Склад 			= ДанныеРазмещения.Склад;
		НоваяЗапись.Ячейка 			= ДанныеРазмещения.Ячейка;
		Если ДанныеРазмещения.Помещение <> Неопределено Тогда
			НоваяЗапись.Помещение 		= ДанныеРазмещения.Помещение;
		КонецЕсли;
		
		НоваяЗапись.ОсновнаяЯчейка = СтруктураПриоритетов.НовыйПриоритет = 1;
		НоваяЗапись.Записать();
	Исключение
		Комментарий = "Не удалось добавить запись о справочном размещении номенклатуры в ячейке. Ошибка: ";
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", Комментарий + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Если ОбновитьВыгруженныйСправочник Тогда
		
		ПользовательскаяНастройка = ХранилищеОбщихНастроек.Загрузить("Cleverence_ПараметрыПодключенияMS");
		СтрокаURI = ПользовательскаяНастройка.СтрокаПодключенияСМАРТС;
		СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаURI);
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", "POST");
		СтруктураЗапроса.Вставить("ВернутьСтруктуру", Истина);
		СтруктураЗапроса.Вставить("ВерсияAPI", "/api/v1");
		СтруктураЗапроса.Вставить("Метод", "Tables/SprYachejki");
		
		ОтправляемыеДанные = Новый Структура;
		ОтправляемыеДанные.Вставить("idSklada", ИдСклада1С);
		ОтправляемыеДанные.Вставить("idTovara", ИдТовара);
		ОтправляемыеДанные.Вставить("idYachejki", XMLСтрока(ДанныеРазмещения.Ячейка));
		ОтправляемыеДанные.Вставить("imyaYachejki", ДанныеРазмещения.Ячейка.Код);
		ОтправляемыеДанные.Вставить("shtrihkodYachejki", УТ_11_2_ЧисловойКодПоСсылке(ДанныеРазмещения.Ячейка));
		
		СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ОтправляемыеДанные);
		Возврат СтруктураОтвета.КодСостояния = 201;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

Функция УдалитьНоменклатуруИзЯчейкиСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, ОбновитьВыгруженныйСправочник) Экспорт
	
	ИмяСобытия = "УдалитьНоменклатуруИзЯчейкиСправочно";
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	ДанныеРазмещения = ПолучитьЗначенияИзмеренийСпрЯчейки(ИмяЯчейки, ИдТовара, ИдСклада1С, МетаданныеНСИ);
	
	Если ДанныеРазмещения = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		НоваяЗапись = РегистрыСведений[МетаданныеНСИ.СпрЯчейки.ИмяСправочника].СоздатьМенеджерЗаписи();
		НоваяЗапись.Номенклатура 	= ДанныеРазмещения.Номенклатура;
		НоваяЗапись.Склад 			= ДанныеРазмещения.Склад;
		НоваяЗапись.Ячейка 			= ДанныеРазмещения.Ячейка;
		Если ДанныеРазмещения.Помещение <> Неопределено Тогда
			НоваяЗапись.Помещение 		= ДанныеРазмещения.Помещение;
		КонецЕсли;
		
		НоваяЗапись.Удалить();
	Исключение
		Комментарий = "Не удалось удалить запись о справочном размещении номенклатуры в ячейке. Ошибка: ";
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", Комментарий + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Если ОбновитьВыгруженныйСправочник Тогда
		
		ПользовательскаяНастройка = ХранилищеОбщихНастроек.Загрузить("Cleverence_ПараметрыПодключенияMS");
		СтрокаURI = ПользовательскаяНастройка.СтрокаПодключенияСМАРТС;
		СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаURI);
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", "GET");
		СтруктураЗапроса.Вставить("ВернутьСтруктуру", Истина);
		СтруктураЗапроса.Вставить("ВерсияAPI", "/api/v1");
		СтруктураЗапроса.Вставить("Метод", "Tables/SprYachejki");
		
		Фильтр = "idSklada eq '"+ИдСклада1С+"' and idTovara eq '"+ИдТовара+"' and idYachejki eq '"+XMLСтрока(ДанныеРазмещения.Ячейка)+"'";
		СтруктураЗапроса.Вставить("Параметры", Новый Структура("filter", Фильтр));
		
		СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса);
		
		Если СтруктураОтвета.КодСостояния < 200 ИЛИ СтруктураОтвета.КодСостояния >= 300 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если СтруктураОтвета.ОтветСервера.Свойство("value") 
			И ТипЗнч(СтруктураОтвета.ОтветСервера.value) = Тип("Массив") 
			И СтруктураОтвета.ОтветСервера.value.Количество() > 0 Тогда
			
			СтрокаУдаления = СтруктураОтвета.ОтветСервера.value[0];
			
			СтруктураЗапроса.Удалить("Параметры");
			СтруктураЗапроса.HTTPМетод = "DELETE";
			СтруктураЗапроса.Метод = СтруктураЗапроса.Метод + "('" + СтрокаУдаления.uid + "')";
			
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("If-Match", Фильтр);
			СтруктураЗапроса.Вставить("Заголовки", Заголовки);
			
			СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

Функция ПриоритетыСпрЯчейки(Склад, Помещение = Неопределено, Номенклатура, Ячейка)
	
	СхемаКомпоновкиДанных = ЭтотОбъект.ПолучитьМакет("СпрЯчейки");
	
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Настройки.Выбор.Элементы.Очистить();
	ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Приоритет");
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= Новый ПолеКомпоновкиДанных("ИдСклада_GUID");
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= ?(Помещение = Неопределено, Склад, Помещение);  
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= Новый ПолеКомпоновкиДанных("ИдТовара_GUID");
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= Номенклатура;
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= Новый ПолеКомпоновкиДанных("ИдЯчейки_GUID");
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.НеРавно;
	НовыйЭлементОтбора.ПравоеЗначение 	= Ячейка;  
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаЗначений = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	МассивПриоритетов = Новый Массив;
	
	МаксПриоритет = 0;
	НовыйПриоритет = 1;
	Если ТаблицаЗначений.Количество() > 0 Тогда
		НовыйПриоритет = 0;
		//ТаблицаЗначений.Свернуть("Приоритет");
		//ТаблицаЗначений.Сортировать("Приоритет");
		//МассивПриоритетов = ТаблицаЗначений.ВыгрузитьКолонку("Приоритет");
		//
		//ТаблицаЗначений.Сортировать("Приоритет Убыв");
		//МаксПриоритет = ТаблицаЗначений[0].Приоритет;
		//НовыйПриоритет = МаксПриоритет + 1;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("МассивПриоритетов", МассивПриоритетов);
	СтруктураРезультата.Вставить("МаксПриоритет", МаксПриоритет);
	СтруктураРезультата.Вставить("НовыйПриоритет", НовыйПриоритет);
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция ПолучитьЗначенияИзмеренийСпрЯчейки(ИмяЯчейки, ИдТовара, ИдСклада1С, МетаданныеНСИ)
	
	Номенклатура = ПолучитьСсылку(МетаданныеНСИ.Номенклатура.ИмяСправочника, ИдТовара);
	Склад = ПолучитьСсылку(МетаданныеНСИ.Склады.ИмяСправочника, ИдСклада1С);
	Помещение = Неопределено;
	
	Если ГлЯдро_СтрНайти(Строка(Склад), "<Объект не найден>") > 0
		И МетаданныеНСИ.Свойство("Помещения") Тогда
		
		Помещение = ПолучитьСсылку(МетаданныеНСИ.Помещения.ИмяСправочника, ИдСклада1С);
		Склад = Помещение.Владелец;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ЭтотОбъект.ПолучитьМакет("Ячейки");
	
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	Настройки.Выбор.Элементы.Очистить();
	
	ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Id_GUID");
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= Новый ПолеКомпоновкиДанных("Id_GUID.Владелец");
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= Склад;  
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= Новый ПолеКомпоновкиДанных("Id_GUID.Код");
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= ИмяЯчейки;  
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаЗначений = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если ТаблицаЗначений.Количество() > 0 Тогда
		Ячейка = ТаблицаЗначений[0].Id_GUID;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Номенклатура);
	Результат.Вставить("Склад", Склад);
	Результат.Вставить("Помещение", Помещение);
	Результат.Вставить("Ячейка", Ячейка);
	
	Возврат Результат;
	
КонецФункции 

// Разбирает строку URI на составные части и возвращает в виде структуры.
// На основе RFC 3986.
//
// Параметры:
//     СтрокаURI - Строка - ссылка на ресурс в формате:
//                          <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>.
//
// Возвращаемое значение:
//     Структура - составные части URI согласно формату:
//         * Схема         - Строка.
//         * Логин         - Строка.
//         * Пароль        - Строка.
//         * ИмяСервера    - Строка - часть <хост>:<порт> входного параметра.
//         * Хост          - Строка.
//         * Порт          - Строка.
//         * ПутьНаСервере - Строка - часть <путь>?<параметры>#<якорь> входного параметра.
Функция REST_API_ПолучитьСтруктуруURIИзСтроки(Знач СтрокаURI) 
   
    СтрокаURI = СокрЛП(СтрокаURI);
   
    // Схема
    Схема = "";
    Позиция = ГлЯдро_СтрНайти(СтрокаURI, "://");
    Если Позиция > 0 Тогда
        Схема = НРег(Лев(СтрокаURI, Позиция - 1));
        СтрокаURI = Сред(СтрокаURI, Позиция + 3);
    КонецЕсли;

	// Строка соединения и путь на сервере.
	СтрокаСоединения = СтрокаURI;
    ПутьНаСервере = "";
    ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(СтрокаСоединения, "/");
	Если ПозицияСтрокиПоиска > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, ПозицияСтрокиПоиска + 1);
		Если Прав(ПутьНаСервере, 1) = "/" Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, СтрДлина(ПутьНаСервере) - 1);
		КонецЕсли;
		СтрокаСоединения = Лев(СтрокаСоединения, ПозицияСтрокиПоиска - 1);
		
		ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(ПутьНаСервере, "?");
		Если ПозицияСтрокиПоиска > 0 Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, ПозицияСтрокиПоиска - 1);
		КонецЕсли;
	КонецЕсли;
       
    // Информация пользователя и имя сервера
    СтрокаАвторизации = "";
    ИмяСервера = СтрокаСоединения;
    Позиция = ГлЯдро_СтрНайти(СтрокаСоединения, "@");
    Если Позиция > 0 Тогда
        СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
        ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
    КонецЕсли;
   
    // Логин и пароль
    Логин = СтрокаАвторизации;
    Пароль = "";
    Позиция = ГлЯдро_СтрНайти(СтрокаАвторизации, ":");
    Если Позиция > 0 Тогда
        Логин = Лев(СтрокаАвторизации, Позиция - 1);
        Пароль = Сред(СтрокаАвторизации, Позиция + 1);
    КонецЕсли;
   
    // Хост и порт
    Хост = ИмяСервера;
    Порт = "";
    Позиция = ГлЯдро_СтрНайти(ИмяСервера, ":");
    Если Позиция > 0 Тогда
        Хост = Лев(ИмяСервера, Позиция - 1);
        Порт = Сред(ИмяСервера, Позиция + 1);
        Если Не ГлЯдро_ТолькоЦифрыВСтроке(Порт) Тогда
            Порт = "";
        КонецЕсли;
	КонецЕсли;
	
	// Данные упрощенной авторизации
	TempUid = "";
	ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(СтрокаURI, "tempuid=");
	Если ПозицияСтрокиПоиска > 0 Тогда
		TempUid	= Сред(СтрокаURI, ПозицияСтрокиПоиска + 8);
	КонецЕсли;
   
    Результат = Новый Структура;
    Результат.Вставить("Схема",			Схема);
    Результат.Вставить("Логин",			Логин);
    Результат.Вставить("Пароль",		Пароль);
    Результат.Вставить("ИмяСервера",	ИмяСервера);
    Результат.Вставить("Хост",			Хост);
    Результат.Вставить("Порт", 			?(ПустаяСтрока(Порт), Неопределено, Число(Порт)));
    Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
    Результат.Вставить("Протокол", 		?(ПустаяСтрока(Схема), "http", Схема));
	Результат.Вставить("TempUid",		TempUid);
	
    Возврат Результат;

КонецФункции

Функция REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ОтправляемыеДанные = Неопределено) Экспорт
	
	ВернутьСтруктуру 	  			= ?(СтруктураЗапроса.Свойство("ВернутьСтруктуру"), СтруктураЗапроса.ВернутьСтруктуру, Ложь);
	ВернутьДвоичныеДанные 	= ?(СтруктураЗапроса.Свойство("ВернутьДвоичныеДанные"), СтруктураЗапроса.ВернутьДвоичныеДанные, Ложь);
	ВернутьСтроку 	  			= ?(СтруктураЗапроса.Свойство("ВернутьСтроку"), СтруктураЗапроса.ВернутьСтроку, Ложь);
	
	Соединение = Новый HTTPСоединение(
	          СтруктураURI.Хост // сервер (хост)
	        , СтруктураURI.Порт // порт, по умолчанию
	        , // СтруктураURI.Логин, // пользователь для доступа к серверу (если он есть)
	        , // СтруктураURI.Пароль, // пароль для доступа к серверу (если он есть)
	        , // здесь указывается прокси, если он есть
	        , // таймаут в секундах, 0 или пусто - не устанавливать
	        , ?(СтруктураURI.Протокол = "https", Новый ЗащищенноеСоединениеOpenSSL(), Неопределено) // защищенное соединение, если используется https
	    );
	
	// Формируем параметры запроса
	Если СтруктураЗапроса.Свойство("Параметры") Тогда
		СтрокаПараметров = "?";
		Для Каждого КлючЗначение Из СтруктураЗапроса.Параметры Цикл
			СтрокаПараметров = СтрокаПараметров + ?(СтрокаПараметров = "?", "", "&") + "$" + КлючЗначение.Ключ + "=" + КлючЗначение.Значение;
		КонецЦикла;
	Иначе
		СтрокаПараметров = "";
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Если СтруктураЗапроса.Свойство("Заголовки") Тогда
		Заголовки = СтруктураЗапроса.Заголовки;
	КонецЕсли;
	
	URIМетод = ?(СтруктураЗапроса.Свойство("Метод") И ЗначениеЗаполнено(СтруктураЗапроса.Метод), "/" + СтруктураЗапроса.Метод, "");
	СтрокаЗапроса = ?(ЗначениеЗаполнено(СтруктураURI.ПутьНаСервере),"/"+СтруктураURI.ПутьНаСервере,"");
	СтрокаЗапроса = СтрокаЗапроса + СтруктураЗапроса.ВерсияAPI + URIМетод + СтрокаПараметров;
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, Заголовки);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	
	Если СтруктураЗапроса.HTTPМетод = "POST"  
		ИЛИ СтруктураЗапроса.HTTPМетод = "PATCH" 
		ИЛИ СтруктураЗапроса.HTTPМетод = "PUT" Тогда
		Если ТипЗнч(ОтправляемыеДанные) = Тип("Строка") Тогда
			Запрос.УстановитьТелоИзСтроки(ОтправляемыеДанные);
		ИначеЕсли ТипЗнч(ОтправляемыеДанные) = Тип("ДвоичныеДанные") Тогда
			Запрос.УстановитьТелоИзДвоичныхДанных(ОтправляемыеДанные);
		Иначе
			ЗаписьJSON = Новый ЗаписьJSON; 
			ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто,"",Истина,,Ложь,Ложь,Ложь,Истина,Ложь);
			ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
			ЗаписатьJSON(ЗаписьJSON, ОтправляемыеДанные); // ОтправляемыеДанные обязательны в этом случае
			СтрокаДляТела = ЗаписьJSON.Закрыть();
			Запрос.УстановитьТелоИзСтроки(СтрокаДляТела, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
	КонецЕсли;
	
	ОтветHTTP = Соединение.ВызватьHTTPМетод(СтруктураЗапроса.HTTPМетод, Запрос);
	СтруктураОтвета = Новый Структура();
	
	ЗаголовкиОтвета = "Заголовки ответа: ";
	Для каждого ТекущийЗаголовок ИЗ ОтветHTTP.Заголовки Цикл
		ЗаголовкиОтвета = ЗаголовкиОтвета + Символы.ПС + "   " + ТекущийЗаголовок.Ключ + ": " + Строка(ТекущийЗаголовок.Значение);
	КонецЦикла;
	СтруктураОтвета.Вставить("ЗаголовкиОтвета", ЗаголовкиОтвета);	
	СтруктураОтвета.Вставить("КодСостояния", ОтветHTTP.КодСостояния);	
	
	ОтветСервера = "";
	ОтветСервера = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
	ТекстОшибки = "";
	Если ОтветHTTP.КодСостояния = Неопределено ИЛИ ОтветHTTP.КодСостояния < 200 ИЛИ ОтветHTTP.КодСостояния >= 300 Тогда
		ТекстОшибки = " Ошибка " + ОтветHTTP.КодСостояния + Символы.ПС + ОтветСервера;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Если ЗначениеЗаполнено(ОтветСервера) Тогда
		Если ВернутьДвоичныеДанные Тогда
			СтруктураОтвета.Вставить("ОтветСервера", ПоместитьВоВременноеХранилище(ОтветСервера, Новый УникальныйИдентификатор()));
		ИначеЕсли ВернутьСтроку Тогда
			СтруктураОтвета.Вставить("ОтветСервера", ОтветСервера);	
		Иначе
			Если ВернутьСтруктуру Тогда 
				НачСреза = ГлЯдро_СтрНайти(ОтветСервера,"""@odata.context""");
				Если НачСреза > 0 Тогда
					КонецСреза = ГлЯдро_СтрНайти(ОтветСервера,""",",,НачСреза);
					ОтветСервера = Лев(ОтветСервера,НачСреза) + Прав(ОтветСервера,СтрДлина(ОтветСервера)-КонецСреза-2);
				КонецЕсли;
			КонецЕсли;
			ЧтениеJSON.УстановитьСтроку(ОтветСервера);
			Соответствие = ПрочитатьJSON(ЧтениеJSON,НЕ ВернутьСтруктуру);
			СтруктураОтвета.Вставить("ОтветСервера", Соответствие);
			СтруктураОтвета.Вставить("ОтветСервераНеРасшифрованный", ОтветСервера);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета.Вставить("ТекстОшибки",ТекстОшибки);
	СтруктураОтвета.Вставить("СтрокаЗапроса", СтрокаЗапроса);
	
	Возврат СтруктураОтвета;
	
КонецФункции

