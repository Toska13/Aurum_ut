	//СохранитьДанныеПроверкиИПодбора(Док1СРезультат.Ссылка, ДанныеПроверкиИПодбора);
	
	СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике",Истина);
	
КонецПроцедуры

Процедура УТ_11_4_ПроверитьТабачнуюПродукциюИСМПБезЗапросаДанных(СтруктураПараметров, ВидПродукцииИС = Неопределено)
	
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;	
	СтрокиФакт 	   = ДокументТСД.СтрокиФакт;	        	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	НастройкаБП    = СтруктураПараметров.СтрокаНастройки;
	
	ИменаДокументов = УТ_11_4_ПолучитьИспользуемыеИменаДокументов();
	
	ЕстьРаботаСТабаком  = Ложь;
	ЕстьИСМП = Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИС") <> Неопределено
		ИЛИ Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИСМП") <> Неопределено;
	ЕстьПТУ  = Метаданные.Документы.Найти(ИменаДокументов.Получить("ПоступлениеТУ")) <> Неопределено;
		
	// Если в конфигурации нет необходимых метаданных, тогда ничего делать не нужно
	Если НЕ ЕстьПТУ ИЛИ НЕ ЕстьИСМП Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	ИспользованиеХарактеристик = МетаданныеНСИ.Свойство("Характеристики")
		И МетаданныеНСИ.Характеристики.Свойство("Использование")
		И МетаданныеНСИ.Характеристики.Использование = Истина;
	
	Если Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления.Найти("Табак") <> Неопределено Тогда 
		ВидПродукцииТабак = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табак");
	Иначе	
		ВидПродукцииТабак = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табачная");
	КонецЕсли;
	
	Если ВидПродукцииИС = Неопределено Тогда // По умолчанию табак
		ВидПродукцииИС = ВидПродукцииТабак;	
	КонецЕсли;
	
	Если ВидПродукцииИС = ВидПродукцииТабак Тогда 
		ОсобенностьУчетаИС 		   = ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция");
	Иначе
		ИндексЗначенияПеречисления = Перечисления["ВидыПродукцииИС"].Индекс(ВидПродукцииИС);
		ИмяЗначенияПеречисления    = Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
		ОсобенностьУчетаИС 		   = ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры." + ИмяЗначенияПеречисления);
	КонецЕсли;
	
	Если Док1СРезультат.Метаданные().Реквизиты.Найти("ВидПродукции") <> Неопределено Тогда
		Док1СРезультат.ВидПродукции = ВидПродукцииИС;	
	КонецЕсли;
	
	СтатусПроверкиВНаличии 	  	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");

	Если НЕ СтруктураПараметров.Свойство("ФлагиТипаДокумента") Тогда
		
		ПараметрыАлгоритма = Новый Структура; 
		ПараметрыАлгоритма.Вставить("Док1СРезультат", Док1СРезультат);
		Если СтруктураПараметров.Свойство("ИмяМодуляБезопасногоРежима") Тогда
			ПараметрыАлгоритма.Вставить("ИмяОбщегоМодуля", 	СтруктураПараметров.ИмяМодуляБезопасногоРежима);
		КонецЕсли;
		
		ФлагиТипаДокумента = Новый Структура;
		Для каждого ИмяДокумента ИЗ ИменаДокументов Цикл			
			ФлагиТипаДокумента.Вставить(ИмяДокумента.Ключ, ?(ЗначениеЗаполнено(ИмяДокумента.Значение), ГлЯдро_ВычислитьВБезопасномРежиме("ТипЗнч(Параметры.Док1СРезультат) = Тип(""ДокументОбъект." + ИмяДокумента.Значение + """)", ПараметрыАлгоритма).Результат, Ложь));
		КонецЦикла;
	    СтруктураПараметров.Вставить("ФлагиТипаДокумента", ФлагиТипаДокумента);
	Иначе
		ФлагиТипаДокумента = СтруктураПараметров.ФлагиТипаДокумента;
	КонецЕсли;
	
	ЭтоПриемка 	= ФлагиТипаДокумента.ПоступлениеТУ ИЛИ ФлагиТипаДокумента.ПриемкаИСМП
		ИЛИ ФлагиТипаДокумента.ПриходныйОрдерНаТовары;
	ЭтоОтгрузка = ФлагиТипаДокумента.РеализацияТУ ИЛИ ФлагиТипаДокумента.ОтгрузкаИСМП
		ИЛИ ФлагиТипаДокумента.РасходныйОрдерНаТовары ИЛИ ФлагиТипаДокумента.ПеремещениеПоЯчейкам;
	ЭтоВозвратСписание = ФлагиТипаДокумента.ВозвратПоставщику ИЛИ ФлагиТипаДокумента.ВыводИзОборотаИСМП 
		ИЛИ ФлагиТипаДокумента.СписаниеИСМП ИЛИ ФлагиТипаДокумента.ВозвратОтКлиента;
	ЭтоМаркировка = ФлагиТипаДокумента.МаркировкаИСМП;
	
	ЭтоАгрегация = Ложь;
	Если ФлагиТипаДокумента.МаркировкаИСМП И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("Агрегация") <> Неопределено Тогда
		ЭтоАгрегация = Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.Агрегация");			
	КонецЕсли;
	
	Попытка
		РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Док1СРезультат.Ссылка, ВидПродукцииИС, 0));
	Исключение
		РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Док1СРезультат.Ссылка, ВидПродукцииИС));
	КонецПопытки;
	
	ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		ДанныеПроверкиИПодбора = МОТП_СоздатьСтруктуруДанныеПроверкиИПодбора(Док1СРезультат, ФлагиТипаДокумента.РеализацияТУ, ВидПродукцииИС);
	КонецЕсли;
	
	СоответствиеПараметров = Новый Соответствие;
	
	Если ДанныеПроверкиИПодбора.Свойство("ДеревоМаркированнойПродукции") Тогда
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
	Иначе
		ДеревоМаркированнойПродукции = ПустоеДеревоТабачнойПродукцииИСМП();
	КонецЕсли;
	МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукции, ВидПродукцииИС, СоответствиеПараметров);
	
	Если ДанныеПроверкиИПодбора.Свойство("ПодобраннаяМаркируемаяПродукция") Тогда
		ПодобраннаяМаркируемаяПродукция = ДанныеПроверкиИПодбора.ПодобраннаяМаркируемаяПродукция;
	Иначе
		ПодобраннаяМаркируемаяПродукция = Неопределено;
	КонецЕсли;
	Если ПодобраннаяМаркируемаяПродукция <> Неопределено Тогда
		МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукция, ВидПродукцииИС, СоответствиеПараметров);
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора.Свойство("ДетализацияСтруктурыХранения") Тогда
		ДетализацияСтруктурыХранения = ДанныеПроверкиИПодбора.ДетализацияСтруктурыХранения;
	Иначе
		Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
			ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
		Иначе
			ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
		КонецЕсли;
	КонецЕсли;
	
	ВидУпаковкиЛогистическая = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая");
	
	// Получение сохраненного дерева значений
	МассивШКВСохраненномДереве = Новый Массив;
	МассивТУВСохраненномДереве = Новый Массив;
	
	Листья = Новый Массив;
	
	ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья);
	
	ПолеШтрихкода = "Штрихкод";
	Для каждого Лист Из Листья Цикл		
		Штрихкод = Лист[ПолеШтрихкода];
		Если МассивШКВСохраненномДереве.Найти(Штрихкод) = Неопределено Тогда
			МассивШКВСохраненномДереве.Добавить(Штрихкод);
		КонецЕсли;
		Если Лист.ВидУпаковки = ВидУпаковкиЛогистическая
			И МассивТУВСохраненномДереве.Найти(Штрихкод) = Неопределено Тогда
			МассивТУВСохраненномДереве.Добавить(Штрихкод);
		КонецЕсли;
		
		Родитель = Лист.Родитель;
		Пока Родитель <> Неопределено Цикл
			Штрихкод = Родитель[ПолеШтрихкода];
			Если МассивШКВСохраненномДереве.Найти(Штрихкод) = Неопределено Тогда
				МассивШКВСохраненномДереве.Добавить(Штрихкод);
			КонецЕсли;
			Если Родитель.ВидУпаковки = ВидУпаковкиЛогистическая
				И МассивТУВСохраненномДереве.Найти(Штрихкод) = Неопределено Тогда
				МассивТУВСохраненномДереве.Добавить(Штрихкод);
			КонецЕсли;
			
			Родитель = Родитель.Родитель;			
		КонецЦикла; 
	КонецЦикла;
	//
	
	ИспользованиеПолныхКодовМаркировки = Ложь;
	Если Метаданные.ОпределяемыеТипы.Найти("ОснованиеФискальнойОперацииИСМП") <> Неопределено // Основание фиксальной операции
		И Метаданные.ОпределяемыеТипы["ОснованиеФискальнойОперацииИСМП"].Тип.СодержитТип(ТипЗнч(Док1СРезультат.Ссылка)) Тогда
		ИспользованиеПолныхКодовМаркировки = Истина;
	ИначеЕсли ФлагиТипаДокумента.МаркировкаИСМП // Отчет о верификации нанесенных КМ
		И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("ОтчетОВерификацииНанесенныхКМ") <> Неопределено
		И (Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ОтчетОВерификацииНанесенныхКМ")
			ИЛИ Док1СРезультат.ОперацияНанесения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ОтчетОВерификацииНанесенныхКМ")) Тогда
		ИспользованиеПолныхКодовМаркировки = Истина;
	КонецЕсли;
	
	Если ИспользованиеПолныхКодовМаркировки Тогда
		ТаблицаДляСохраненияВПул = Новый ТаблицаЗначений;		
		ТаблицаДляСохраненияВПул.Колонки.Добавить("КодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ПолныйКодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("GTIN");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ТипШтрихкода");
	КонецЕсли;
	
	ТаблицаМаркированнойПродукции = Новый ТаблицаЗначений;
	
	КолонкиТаблицыЗначений = ТаблицаМаркированнойПродукции.Колонки;
	КолонкиТаблицыЗначений.Добавить("Номенклатура");
	КолонкиТаблицыЗначений.Добавить("Характеристика");
	КолонкиТаблицыЗначений.Добавить("GTIN");
	КолонкиТаблицыЗначений.Добавить("СтатусПроверки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПачки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодБлока");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодКоробки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПалеты");
	КолонкиТаблицыЗначений.Добавить("КоличествоУпаковок");
	КолонкиТаблицыЗначений.Добавить("КоличествоПотребительскихУпаковок");
	
	ТаблицаМаркированнойПродукцииПлана = ТаблицаМаркированнойПродукции.Скопировать();
	
	// Дополнительная табличная часть КоробкиПалеты
	КоробкиПалеты = Неопределено;
	Если ДокументТСД.Свойство("КоробкиПалеты") Тогда
		КоробкиПалеты = ДокументТСД.КоробкиПалеты;
	КонецЕсли;
	
	Кэш_ОсобенностиНоменклатуры	= Новый Соответствие;
	
	// Обработка сканированных штрихкодов
	
	МассивИзвестныхШК = Новый Массив;
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений")
			ИЛИ НЕ СтрокаФакт.Свойство("Маркировка")
			ИЛИ СтрокаФакт.Маркировка <> "Табак" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаФакт.Вставить("Номенклатура", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара))); 
		
		// Признак маркировки для табака, альтернативного табака и никотиносодержащей в документе MS совпадает.
		// Разделяем данные здесь по особенностям учета номенклатуры
		ОсобенностьУчета = Кэш_ОсобенностиНоменклатуры.Получить(СтрокаФакт.ИдТовара);
		Если ОсобенностьУчета = Неопределено Тогда
			ОсобенностьУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаФакт.Номенклатура, "ОсобенностьУчета");
					
			Кэш_ОсобенностиНоменклатуры.Вставить(СтрокаФакт.ИдТовара, ОсобенностьУчета);
		КонецЕсли;
		
		Если ОсобенностьУчета <> ОсобенностьУчетаИС Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьРаботаСТабаком = Истина;
		
		Если ИспользованиеХарактеристик Тогда
			Если СтрокаФакт.Свойство("ИдХарактеристики")
				И ЗначениеЗаполнено(СтрокаФакт.ИдХарактеристики) Тогда 
				СтрокаФакт.Вставить("Характеристика", Справочники["ХарактеристикиНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдХарактеристики)));
			Иначе
				СтрокаФакт.Вставить("Характеристика", Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());
			КонецЕсли;
		Иначе
			СтрокаФакт.Вставить("Характеристика", ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры"));
		КонецЕсли;
		
		ШтрихкодПалеты 	= "";
		ШтрихкодКоробки = "";
		ШтрихкодБлока 	= "";
		ШтрихкодМарки 	= "";
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда // Если нет свойства ИдКоробки, то в свойстве SSCC находится ШтрихкодКоробки
			Если СтрокаФакт.Свойство("SSCC") И ЗначениеЗаполнено(СтрокаФакт.SSCC) Тогда 
				ШтрихкодПалеты = СтрокаФакт.SSCC;		
			Иначе                            
				ШтрихкодПалеты = "";
			КонецЕсли;
			
			ШтрихкодКоробки = СтрокаФакт.ИдКоробки;
		ИначеЕсли СтрокаФакт.Свойство("SSCC") И ЗначениеЗаполнено(СтрокаФакт.SSCC) Тогда
			ШтрихкодКоробки = СтрокаФакт.SSCC;
		КонецЕсли;
						
		Если СтрокаФакт.Свойство("ИдРодителя")
			И ЗначениеЗаполнено(СтрокаФакт.ИдРодителя) Тогда 
			Попытка
				БлокСсылка = Справочники["ШтрихкодыУпаковокТоваров"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдРодителя));
				
				ШтрихкодБлока = БлокСсылка.ЗначениеШтрихкода;
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьТабачнуюПродукциюИСМПБезЗапросаДанных", "Ошибка",
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
				
			// В ИдРодителя может быть записан GUID коробки или палеты
			Если ЗначениеЗаполнено(ШтрихкодБлока) Тогда
				Если ШтрихкодБлока = ШтрихкодКоробки Тогда	
					ШтрихкодБлока = "";
				КонецЕсли;
				Если ШтрихкодБлока = ШтрихкодПалеты Тогда
					ШтрихкодБлока = "";
				КонецЕсли;
				
				// В 1С может храниться упаковка в формате без скобок, в документе MS - со скобками
				Если ЗначениеЗаполнено(ШтрихкодБлока) И НЕ ПустаяСтрока(ШтрихкодКоробки) Тогда
					ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодКоробки, "(", ""), ")", "");
					
					Если ШтрихкодБлока = ШтрихкодБезСкобок Тогда	
						ШтрихкодКоробки = ШтрихкодБезСкобок;
						ШтрихкодБлока = "";
					КонецЕсли;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ШтрихкодБлока) И НЕ ПустаяСтрока(ШтрихкодПалеты) Тогда
					ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодПалеты, "(", ""), ")", "");
					
					Если ШтрихкодБлока = ШтрихкодБезСкобок Тогда	
						ШтрихкодПалеты = ШтрихкодБезСкобок;
						ШтрихкодБлока = "";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Проверяем формат коробов и палет в сохраненном дереве значений
		Если НЕ ПустаяСтрока(ШтрихкодКоробки)
			И Найти(ШтрихкодКоробки, "(") Тогда
			ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодКоробки) <> Неопределено;
			
			Если НЕ ТУНайденаВСохраненномДереве Тогда
				ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодКоробки, "(", ""), ")", "");
					
				ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодБезСкобок) <> Неопределено;
				Если ТУНайденаВСохраненномДереве Тогда
					ШтрихкодКоробки = ШтрихкодБезСкобок;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ШтрихкодПалеты)
			И Найти(ШтрихкодПалеты, "(") Тогда
		    ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодПалеты) <> Неопределено;
			
			Если НЕ ТУНайденаВСохраненномДереве Тогда
				ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодПалеты, "(", ""), ")", "");
					
				ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодБезСкобок) <> Неопределено;
				Если ТУНайденаВСохраненномДереве Тогда
					ШтрихкодПалеты = ШтрихкодБезСкобок;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		//
			
		Если НЕ ЗначениеЗаполнено(ШтрихкодБлока) Тогда
			Если СтрокаФакт.Свойство("ШтрихкодБлока") И ЗначениеЗаполнено(СтрокаФакт.ШтрихкодБлока) Тогда
				ШтрихкодБлока = СтрокаФакт.ШтрихкодБлока;	
			ИначеЕсли СтрокаФакт.Свойство("ШтрихкодРодителя")
				И (ЗначениеЗаполнено(СтрокаФакт.ШтрихкодРодителя)) Тогда // Или СтрокаФакт.Свойство("ИдРодителя") = Ложь) Тогда		
				ШтрихкодБлока = СтрокаФакт.ШтрихкодРодителя;	
			КонецЕсли;
		КонецЕсли;
		
		ШтрихкодПачки = СтрокаФакт.Марка;
							
		// На случай если в поле Марка записан штрихкод блока (т.е. блок вкладывается во что-то)
		Если ШтрихкодПачки = ШтрихкодБлока Тогда
			ШтрихкодПачки = "";
		КонецЕсли;
		
		ДанныеКодаМаркировки = Неопределено;
		
		Если ЗначениеЗаполнено(ШтрихкодПачки) Тогда
			ДанныеКодаМаркировки = ИО_НормализоватьКодМаркировки(ШтрихкодПачки, ВидПродукцииИС, Истина);
			
			Если ДанныеКодаМаркировки <> Неопределено Тогда
				Если ДанныеКодаМаркировки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда // ЭтоПачка
					ШтрихкодПачки = ДанныеКодаМаркировки.Штрихкод;
				ИначеЕсли ДанныеКодаМаркировки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") Тогда // ЭтоБлок
					ШтрихкодПачки = "";
					ШтрихкодБлока = ДанныеКодаМаркировки.Штрихкод;
				ИначеЕсли ДанныеКодаМаркировки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая") Тогда // ЭтоКоробка
					ШтрихкодПачки = "";
					ШтрихкодКоробки = ДанныеКодаМаркировки.Штрихкод; 
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		    
		ШтрихкодКоробки = ИО_НормализоватьКодМаркировки(ШтрихкодКоробки, ВидПродукцииИС);
		ШтрихкодБлока 	= ИО_НормализоватьКодМаркировки(ШтрихкодБлока, ВидПродукцииИС);
		ШтрихкодПачки 	= ИО_НормализоватьКодМаркировки(ШтрихкодПачки, ВидПродукцииИС);		
		
		СканированныйШтрихкод = "";
		
		Если ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
			СканированныйШтрихкод = ШтрихкодПалеты;
		ИначеЕсли ЗначениеЗаполнено(ШтрихкодКоробки) Тогда
			СканированныйШтрихкод = ШтрихкодКоробки;
		ИначеЕсли ЗначениеЗаполнено(ШтрихкодБлока) Тогда
			СканированныйШтрихкод = ШтрихкодБлока;
		ИначеЕсли ЗначениеЗаполнено(ШтрихкодПачки) Тогда
			СканированныйШтрихкод = ШтрихкодПачки;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СканированныйШтрихкод) Тогда
			ШКНайденВСохраненномДереве = Истина;
		Иначе
			ШКНайденВСохраненномДереве = МассивШКВСохраненномДереве.Найти(СканированныйШтрихкод) <> Неопределено;
			
			Если НЕ ШКНайденВСохраненномДереве Тогда
				// Пробуем найти без МРЦ
				ПачкаСМРЦ = Ложь;
				Если Лев(СканированныйШтрихкод, 1) <> "("
					И СтрДлина(СканированныйШтрихкод) = 25 Тогда
					ПачкаСМРЦ = Истина;
				КонецЕсли;
				
				ПозицияМРЦ = Найти(СканированныйШтрихкод, "(8005)");
				
				ЗначениеБезМРЦ = "";
				Если ПачкаСМРЦ Тогда
					ЗначениеБезМРЦ = Лев(СканированныйШтрихкод, 21);
				ИначеЕсли ПозицияМРЦ > 0 Тогда
					ЗначениеБезМРЦ = Лев(СканированныйШтрихкод, ПозицияМРЦ - 1);	
				КонецЕсли;				
					
				Если ЗначениеБезМРЦ <> "" Тогда
					ШКНайденВСохраненномДереве = МассивШКВСохраненномДереве.Найти(ЗначениеБезМРЦ) <> Неопределено;
					Если ШКНайденВСохраненномДереве Тогда
						СканированныйШтрихкод = ЗначениеБезМРЦ;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
		
		Если НЕ ШКНайденВСохраненномДереве Тогда
			
			СтруктураПоиска = Новый Структура();
			Если ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
				СтруктураПоиска.Вставить("ШтрихкодПалеты", ШтрихкодПалеты);
			КонецЕсли;
			Если ЗначениеЗаполнено(ШтрихкодКоробки) Тогда
				СтруктураПоиска.Вставить("ШтрихкодКоробки", ШтрихкодКоробки);
			КонецЕсли;
			Если ЗначениеЗаполнено(ШтрихкодБлока) Тогда
				СтруктураПоиска.Вставить("ШтрихкодБлока", ШтрихкодБлока);
			КонецЕсли;
			Если ЗначениеЗаполнено(ШтрихкодПачки) Тогда
				СтруктураПоиска.Вставить("ШтрихкодПачки", ШтрихкодПачки);
			КонецЕсли;
			
			МОТП_ДобавитьСтрокиВТаблицуМаркированнойПродукции(ТаблицаМаркированнойПродукции, СтруктураПоиска, СтрокаФакт, ВидПродукцииИС);
			
		//ИначеЕсли МассивИзвестныхШК.Найти(СканированныйШтрихкод) = Неопределено Тогда
		//	МассивИзвестныхШК.Добавить(СканированныйШтрихкод);
		Иначе
			Если ЗначениеЗаполнено(ШтрихкодПалеты)
				И МассивИзвестныхШК.Найти(ШтрихкодПалеты) = Неопределено Тогда
				МассивИзвестныхШК.Добавить(ШтрихкодПалеты);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ШтрихкодКоробки)
				И МассивИзвестныхШК.Найти(ШтрихкодКоробки) = Неопределено Тогда
				МассивИзвестныхШК.Добавить(ШтрихкодКоробки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ШтрихкодБлока)
				И МассивИзвестныхШК.Найти(ШтрихкодБлока) = Неопределено Тогда
				МассивИзвестныхШК.Добавить(ШтрихкодБлока);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ШтрихкодПачки)
				И МассивИзвестныхШК.Найти(ШтрихкодПачки) = Неопределено Тогда
				МассивИзвестныхШК.Добавить(ШтрихкодПачки);
			КонецЕсли;
		КонецЕсли;
		
		ПолныйКодМаркировки = ?(СтрокаФакт.Свойство("ПолнаяМаркаBase64"), СтрокаФакт.ПолнаяМаркаBase64, "");
		Если ИспользованиеПолныхКодовМаркировки 
			И ЗначениеЗаполнено(ПолныйКодМаркировки) Тогда
			Если ДанныеКодаМаркировки = Неопределено Тогда
				ДанныеКодаМаркировки = ИО_НормализоватьКодМаркировки(СтрокаФакт.Марка, ВидПродукцииИС, Истина);
			КонецЕсли;
			
			Если НЕ ДанныеКодаМаркировки = Неопределено Тогда
				НоваяСтрокаДляПула = ТаблицаДляСохраненияВПул.Добавить();
				НоваяСтрокаДляПула.ПолныйКодМаркировки 	= ПолныйКодМаркировки;	
				НоваяСтрокаДляПула.КодМаркировки 		= ДанныеКодаМаркировки.НормализованныйШтрихкод;
				НоваяСтрокаДляПула.ТипШтрихкода  		= ДанныеКодаМаркировки.ТипШтрихкода;
				НоваяСтрокаДляПула.GTIN 		 		= ДанныеКодаМаркировки.GTIN;
			КонецЕсли;	
		КонецЕсли;

	КонецЦикла;
	
	ИмяПоляТип = Неопределено;
	
	// Собираем данные из доп. табличной части КоробкиПалеты
	Если НЕ КоробкиПалеты = Неопределено Тогда
		Для каждого СтрокаКоробки Из КоробкиПалеты Цикл
			Если СтрокаКоробки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьРаботаСТабаком = Истина;
			
			Если ИмяПоляТип = Неопределено Тогда
				ИмяПоляТип = "";
				
				Если СтрокаКоробки.Свойство("Тип") Тогда
					ИмяПоляТип = "Тип";
				ИначеЕсли СтрокаКоробки.Свойство("Type") Тогда
					ИмяПоляТип = "Type"
				КонецЕсли;
			КонецЕсли;
			
			ШтрихкодПалеты 	= "";
			ШтрихкодКоробки = "";
			
			// Собираем в таблицу только строки с коробками
			Если НЕ ПустаяСтрока(ИмяПоляТип) Тогда
				ЭтоКоробка = СтрокаКоробки[ИмяПоляТип] = "Коробка"
					ИЛИ СтрокаКоробки[ИмяПоляТип] = "Box";
				Если НЕ ЭтоКоробка Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				ЭтоРодитель = ?(СтрокаКоробки.Свойство("ЭтоРодитель"), СтрокаКоробки.ЭтоРодитель,
					?(СтрокаКоробки.Свойство("EtoRoditel"), СтрокаКоробки["EtoRoditel"], Ложь));
				Если ЭтоРодитель = Истина Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ШтрихкодКоробки = ?(СтрокаКоробки.Свойство("Ид"), СтрокаКоробки.Ид, ?(СтрокаКоробки.Свойство("Id"), СтрокаКоробки["Id"], ""));
			Если НЕ ЗначениеЗаполнено(ШтрихкодКоробки) Тогда
				Продолжить;
			КонецЕсли;
			
			// Пропускаем коробки, которые не вложены в палету
			ШтрихкодПалеты = ?(СтрокаКоробки.Свойство("Родитель"), СокрЛП(СтрокаКоробки.Родитель), ?(СтрокаКоробки.Свойство("roditel"), СокрЛП(СтрокаКоробки["roditel"]), ""));
			Если НЕ ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
				Продолжить;	
			КонецЕсли;
			
			// Пропускаем коробки, по которым в таблице КоробкиПалеты нет родителя или у родителя нет флага ЭтоРодитель
			СтрокаПалеты = НайтиЭлементМассива(КоробкиПалеты, "Ид", ШтрихкодПалеты);
			Если СтрокаПалеты = Неопределено Тогда
				СтрокаПалеты = НайтиЭлементМассива(КоробкиПалеты, "id", ШтрихкодПалеты);
			КонецЕсли;
			Если СтрокаПалеты = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПустаяСтрока(ИмяПоляТип) Тогда
				ЭтоПалета = СтрокаПалеты[ИмяПоляТип] = "Палета"
					ИЛИ СтрокаПалеты[ИмяПоляТип] = "Pallet";
				Если НЕ ЭтоПалета Тогда
					Продолжить;
				КонецЕсли;
			Иначе	
				СтрокаПалетыЭтоРодитель = ?(СтрокаПалеты.Свойство("ЭтоРодитель"), СтрокаПалеты.ЭтоРодитель,
					?(СтрокаПалеты.Свойство("EtoRoditel"), СтрокаПалеты["EtoRoditel"], Ложь));
				Если СтрокаПалетыЭтоРодитель <> Истина Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				ШтрихкодПалеты	= ИО_НормализоватьКодМаркировки(ШтрихкодПалеты,	ВидПродукцииИС);
			Исключение
			КонецПопытки;
			Попытка
				ШтрихкодКоробки = ИО_НормализоватьКодМаркировки(ШтрихкодКоробки, ВидПродукцииИС);
			Исключение
			КонецПопытки;
			
			СканированныйШтрихкод = ШтрихкодПалеты;
			
			Если ЗначениеЗаполнено(СканированныйШтрихкод) И МассивШКВСохраненномДереве.Найти(СканированныйШтрихкод) = Неопределено Тогда
				
				СтруктураПоиска = Новый Структура();
				СтруктураПоиска.Вставить("ШтрихкодПалеты", 	ШтрихкодПалеты);
				СтруктураПоиска.Вставить("ШтрихкодКоробки", ШтрихкодКоробки);
				
				МОТП_ДобавитьСтрокиВТаблицуМаркированнойПродукции(ТаблицаМаркированнойПродукции, СтруктураПоиска, , ВидПродукцииИС);
				
			//ИначеЕсли МассивИзвестныхШК.Найти(СканированныйШтрихкод) = Неопределено Тогда
			//	МассивИзвестныхШК.Добавить(СканированныйШтрихкод);
			Иначе
				Если ЗначениеЗаполнено(ШтрихкодПалеты)
					И МассивИзвестныхШК.Найти(ШтрихкодПалеты) = Неопределено Тогда
					МассивИзвестныхШК.Добавить(ШтрихкодПалеты);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ШтрихкодКоробки)
					И МассивИзвестныхШК.Найти(ШтрихкодКоробки) = Неопределено Тогда
					МассивИзвестныхШК.Добавить(ШтрихкодКоробки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//Возврат если нет данных
	Если ЕстьРаботаСТабаком = Ложь И МассивИзвестныхШК.Количество() = 0 И ТаблицаМаркированнойПродукции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершатьПроверку = Ложь;
	
	ДокументПроведенПриПроверкеИСМП = Неопределено;
	Если СтруктураПараметров.Свойство("ДокументПроведенПриПроверкеИСМП", ДокументПроведенПриПроверкеИСМП) Тогда
		ЗавершатьПроверку = ДокументПроведенПриПроверкеИСМП;
	Иначе
		ПроводитьДокументПослеЗагрузки = Док1СРезультат.Проведен ИЛИ НастройкаБП.Свойство("ПроводитьДокументПослеЗагрузки") И НастройкаБП.ПроводитьДокументПослеЗагрузки = Истина;
		Если ПроводитьДокументПослеЗагрузки Тогда
			ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
			Если ЭтоПриемка И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборПриемка"), СтруктураПараметров) = Истина
				ИЛИ ЭтоОтгрузка И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборОтгрузка"), СтруктураПараметров) = Истина
				ИЛИ ЭтоВозвратСписание И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборВозвратСписание"), СтруктураПараметров) = Истина
				ИЛИ ЭтоМаркировка И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборМаркировка"), СтруктураПараметров) = Истина Тогда
				ЗавершатьПроверку = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// Завершаем проверку только при условии успешного проведения документа
		Если ЗавершатьПроверку Тогда
			//НачатьТранзакцию();
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);
					
				СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
				СтруктураПараметров.Вставить("ДокументПроведенПриПроверкеИСМП", Истина);
				
				//ЗафиксироватьТранзакцию();
			Исключение
				//ОтменитьТранзакцию();
				ЗавершатьПроверку = Ложь;
				
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьТабачнуюПродукциюИСМПБезЗапросаДанных", "Ошибка", "Ошибка при проведении " + Док1СРезультат + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
				СтруктураПараметров.Вставить("ДокументПроведенПриПроверкеИСМП", Ложь);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользованиеПолныхКодовМаркировки Тогда	
		ИСМП_СохранитьКодыМаркировкиВПул(ТаблицаДляСохраненияВПул, СтруктураПараметров);
	КонецЕсли;
	
	ТаблицаИзмененийТабачнойПродукции = МОТП_ПустаяТаблицаИзмененийТабачнойПродукции();
	
	ДобавитьСтрокиВДеревоТабачнойПродукцииМП(ДеревоМаркированнойПродукции, ТаблицаМаркированнойПродукции, ТаблицаМаркированнойПродукцииПлана, ТаблицаИзмененийТабачнойПродукции, ВидПродукцииИС, ДетализацияСтруктурыХранения);
	
	МОТП_ОтметитьСтатусыВДереве(ДеревоМаркированнойПродукции, МассивИзвестныхШК, СтатусПроверкиВНаличии, , ТаблицаИзмененийТабачнойПродукции);
	
	// Все, что не в наличии - отсутствует
	Если ЗавершатьПроверку Тогда
		СтруктураСтатусыПроверки = Новый Структура;
		СтруктураСтатусыПроверки.Вставить("СтатусПроверкиВНаличии", 	СтатусПроверкиВНаличии);
		СтруктураСтатусыПроверки.Вставить("СтатусПроверкиНеЧислилась", 	СтатусПроверкиНеЧислилась);
		СтруктураСтатусыПроверки.Вставить("СтатусПроверкиОтсутствует", 	СтатусПроверкиОтсутствует);
		
		МОТП_ОтметитьОтсутствующиеВДереве(ДеревоМаркированнойПродукции, СтруктураСтатусыПроверки);
	КонецЕсли;
	
	// Заполнение таблицы подобранной маркируемой продукции
	Если ПодобраннаяМаркируемаяПродукция = Неопределено Тогда
		ПодобраннаяМаркируемаяПродукция = ПустаяТаблицаПодобраннаяТабачнаяПродукцияИСМП();
		МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукция, ВидПродукцииИС, СоответствиеПараметров);
		
		Если Док1СРезультат.Проведен Тогда
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Док1СРезультат.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
		Иначе
			Док1СРезультат.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		//МаркируемаяПродукцияДокумента = Вычислить("ПроверкаИПодборПродукцииИСМП.ТаблицаМаркируемойПродукцииДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС)");
		МаркируемаяПродукцияДокумента = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ТаблицаМаркируемойПродукцииДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС);
		Для каждого СтрокаМаркируемойПродукции ИЗ МаркируемаяПродукцияДокумента Цикл
			НоваяСтрока = ПодобраннаяМаркируемаяПродукция.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМаркируемойПродукции);
			
			Если ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
				НоваяСтрока.ХарактеристикиИспользуются = Истина;
			КонецЕсли;
			Если НоваяСтрока.КодыGTIN.Количество() = 1 Тогда
				НоваяСтрока.GTIN = НоваяСтрока.КодыGTIN[0].Значение; 
			КонецЕсли;
			
			Попытка
				НоваяСтрока.ПредставлениеGTIN = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ПредставлениеМассиваGTIN(НоваяСтрока.КодыGTIN);
			Исключение
				НоваяСтрока.ПредставлениеGTIN = ИО_ПредставлениеМассиваGTIN(НоваяСтрока.КодыGTIN);
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(
		ИО_ОбщийМодуль("НоменклатураСервер").ПараметрыУказанияСерий(Док1СРезультат, Документы[Док1СРезультат.Метаданные().Имя]));
	Если ПараметрыУказанияСерий.Свойство("Отбор") И ПараметрыУказанияСерий.Свойство("Размещение") Тогда // ОтборРазмещениеТоваров
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Отбор);
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Размещение);
	ИначеЕсли ПараметрыУказанияСерий.Свойство("ТоварыПоРаспоряжениям") И ПараметрыУказанияСерий.Свойство("ОтгружаемыеТовары") Тогда // РасходныйОрдерНаТовары
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.ТоварыПоРаспоряжениям);
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.ОтгружаемыеТовары);
	Иначе	
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий);
	КонецЕсли;
	
	Попытка
		ДопустимаПроизвольнаяЕдиницаУчета = ИО_ОбщийМодуль("ИнтеграцияИС").ЕстьПроизвольныеЕдиницыУчета(ВидПродукцииИС);
	Исключение
		ДопустимаПроизвольнаяЕдиницаУчета = Ложь;
	КонецПопытки;
	
	ПоддерживаетсяОбъемноСортовойУчет = ИнтеграцияИСМПКлиентСерверПовтИсп_ВидПродукцииПоддерживаетОбъемноСортовойУчет(ВидПродукцииИС);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ТаблицаИзмененийТабачнойПродукции", ТаблицаИзмененийТабачнойПродукции);
	ПараметрыПроцедуры.Вставить("ПодобраннаяМаркируемаяПродукция", 	 ПодобраннаяМаркируемаяПродукция);
	ПараметрыПроцедуры.Вставить("ДетализацияСтруктурыХранения", 	 ДетализацияСтруктурыХранения);
	ПараметрыПроцедуры.Вставить("ВидМаркируемойПродукции", 			 ВидПродукцииИС);
	ПараметрыПроцедуры.Вставить("ПараметрыУказанияСерий", 			 ПараметрыУказанияСерий);
	ПараметрыПроцедуры.Вставить("Объект", 							 Док1СРезультат);
	ПараметрыПроцедуры.Вставить("ИмяФормы", 						 "Документ." + Док1СРезультат.Метаданные().Имя + ".Форма.ФормаДокумента");
	ПараметрыПроцедуры.Вставить("ДопустимаПроизвольнаяЕдиницаУчета", ДопустимаПроизвольнаяЕдиницаУчета);
	ПараметрыПроцедуры.Вставить("РежимПодбораСуществующихУпаковок",	 ?(ЭтоПриемка, Истина, Ложь));
	ПараметрыПроцедуры.Вставить("ПоддерживаетсяОбъемноСортовойУчет", ПоддерживаетсяОбъемноСортовойУчет);
	
	МОТП_ОбработатьТаблицуИзмененийТабачнойПродукции(ПараметрыПроцедуры);
	
	// Если не обнулить, происходит ошибка при помещении в ХЗ
	Если ДанныеПроверкиИПодбора.Свойство("СтрокаБлокиБезКоробки") Тогда
		ДанныеПроверкиИПодбора.СтрокаБлокиБезКоробки = Неопределено;
	КонецЕсли;
	Если ДанныеПроверкиИПодбора.Свойство("СтрокаПачкиБезБлока") Тогда
		ДанныеПроверкиИПодбора.СтрокаПачкиБезБлока = Неопределено;
	КонецЕсли;
	
	ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции",    ДеревоМаркированнойПродукции);	
	ДанныеПроверкиИПодбора.Вставить("ПодобраннаяМаркируемаяПродукция", ПодобраннаяМаркируемаяПродукция);
	
	хзДанныеПроверкиИПодбора = Новый ХранилищеЗначения(ДанныеПроверкиИПодбора);
	
	Если ЗавершатьПроверку Тогда
		МОТП_ЗафиксироватьРезультатПроверкиИПодбора(Док1СРезультат, ДеревоМаркированнойПродукции, ПодобраннаяМаркируемаяПродукция, ВидПродукцииИС);
		Док1СРезультат.Прочитать();
		Попытка
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора, ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить"));
		Исключение
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора, ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить"));
		КонецПопытки;
	Иначе
		Попытка
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
		Исключение
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
		КонецПопытки;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
	
КонецПроцедуры

Процедура УТ_11_4_ПроверитьТабачнуюПродукциюИСМПСЗапросомДанных(СтруктураПараметров, ВидПродукцииИС = Неопределено)
	
	ДокументТСД			= СтруктураПараметров.ДокументТСД;	
	СтрокиФакт 			= ДокументТСД.СтрокиФакт;	        	
	Док1СРезультат 		= СтруктураПараметров.Док1СРезультат;
	НастройкаБП 	    = СтруктураПараметров.СтрокаНастройки;
	
	ИменаДокументов = УТ_11_4_ПолучитьИспользуемыеИменаДокументов();
	
	ЕстьРаботаСТабаком  = Ложь;
	ЕстьИСМП = Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИС") <> Неопределено
		ИЛИ Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИСМП") <> Неопределено;
	ЕстьПТУ  = Метаданные.Документы.Найти(ИменаДокументов.Получить("ПоступлениеТУ")) <> Неопределено;
		
	// Если в конфигурации нет необходимых метаданных, тогда ничего делать не нужно
	Если НЕ ЕстьПТУ ИЛИ НЕ ЕстьИСМП Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	ИспользованиеХарактеристик = МетаданныеНСИ.Свойство("Характеристики")
		И МетаданныеНСИ.Характеристики.Свойство("Использование")
		И МетаданныеНСИ.Характеристики.Использование = Истина;
	
	Если Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления.Найти("Табак") <> Неопределено Тогда 
		ВидПродукцииТабак = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табак");
	Иначе	
		ВидПродукцииТабак = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табачная");
	КонецЕсли;
	
	Если ВидПродукцииИС = Неопределено Тогда // По умолчанию табак
		ВидПродукцииИС = ВидПродукцииТабак;	
	КонецЕсли;
	
	Если ВидПродукцииИС = ВидПродукцииТабак Тогда 
		ОсобенностьУчетаИС 		   = ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция");
	Иначе
		ИндексЗначенияПеречисления = Перечисления["ВидыПродукцииИС"].Индекс(ВидПродукцииИС);
		ИмяЗначенияПеречисления    = Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
		ОсобенностьУчетаИС 		   = ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры." + ИмяЗначенияПеречисления);
	КонецЕсли;

	Если НЕ СтруктураПараметров.Свойство("ФлагиТипаДокумента") Тогда
		
		ПараметрыАлгоритма = Новый Структура; 
		ПараметрыАлгоритма.Вставить("Док1СРезультат", Док1СРезультат);
		Если СтруктураПараметров.Свойство("ИмяМодуляБезопасногоРежима") Тогда
			ПараметрыАлгоритма.Вставить("ИмяОбщегоМодуля", 	СтруктураПараметров.ИмяМодуляБезопасногоРежима);
		КонецЕсли;
		
		ФлагиТипаДокумента = Новый Структура;
		Для каждого ИмяДокумента ИЗ ИменаДокументов Цикл
			ФлагиТипаДокумента.Вставить(ИмяДокумента.Ключ, ?(ЗначениеЗаполнено(ИмяДокумента.Значение), ГлЯдро_ВычислитьВБезопасномРежиме("ТипЗнч(Параметры.Док1СРезультат) = Тип(""ДокументОбъект." + ИмяДокумента.Значение + """)", ПараметрыАлгоритма).Результат, Ложь));
		КонецЦикла;
	    СтруктураПараметров.Вставить("ФлагиТипаДокумента", ФлагиТипаДокумента);
	Иначе
		ФлагиТипаДокумента = СтруктураПараметров.ФлагиТипаДокумента;
	КонецЕсли;
	
	ЭтоПриемка 	= ФлагиТипаДокумента.ПоступлениеТУ ИЛИ ФлагиТипаДокумента.ПриемкаИСМП
		ИЛИ ФлагиТипаДокумента.ПриходныйОрдерНаТовары;
	ЭтоОтгрузка = ФлагиТипаДокумента.РеализацияТУ ИЛИ ФлагиТипаДокумента.ОтгрузкаИСМП
		ИЛИ ФлагиТипаДокумента.РасходныйОрдерНаТовары ИЛИ ФлагиТипаДокумента.ПеремещениеПоЯчейкам;
	ЭтоВозвратСписание = ФлагиТипаДокумента.ВозвратПоставщику ИЛИ ФлагиТипаДокумента.ВыводИзОборотаИСМП 
		ИЛИ ФлагиТипаДокумента.СписаниеИСМП ИЛИ ФлагиТипаДокумента.ВозвратОтКлиента;
	ЭтоМаркировка = ФлагиТипаДокумента.МаркировкаИСМП;
	
	ЭтоАгрегация = Ложь;
	Если ФлагиТипаДокумента.МаркировкаИСМП И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("Агрегация") <> Неопределено Тогда
		ЭтоАгрегация = Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.Агрегация");			
	КонецЕсли;
	
	Попытка
		РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Док1СРезультат.Ссылка, ВидПродукцииИС, 0));
	Исключение
		РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Док1СРезультат.Ссылка, ВидПродукцииИС));
	КонецПопытки;
	
	ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
	
	ДеревоМаркированнойПродукции = Неопределено;
	ПодобраннаяМаркируемаяПродукция = Неопределено;
	
	СоответствиеПараметров = Новый Соответствие;
	Если НЕ ДанныеПроверкиИПодбора = Неопределено И ДанныеПроверкиИПодбора.Свойство("ДеревоМаркированнойПродукции") Тогда
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
		
		МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукции, ВидПродукцииИС, СоответствиеПараметров);
	КонецЕсли;
	
	Если НЕ ДанныеПроверкиИПодбора = Неопределено И ДанныеПроверкиИПодбора.Свойство("ПодобраннаяМаркируемаяПродукция") Тогда
		ПодобраннаяМаркируемаяПродукция = ДанныеПроверкиИПодбора.ПодобраннаяМаркируемаяПродукция;
		
		МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукция, ВидПродукцииИС, СоответствиеПараметров);
	КонецЕсли;
	
	ВидУпаковкиЛогистическая = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая");
	
	// Получение сохраненного дерева значений
	МассивТУВСохраненномДереве = Новый Массив;
	
	Листья = Новый Массив;
	Если НЕ ДеревоМаркированнойПродукции = Неопределено Тогда
		ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья);
	КонецЕсли;
	
	ПолеШтрихкода = "Штрихкод";
	Для каждого Лист Из Листья Цикл
		Штрихкод = Лист[ПолеШтрихкода];
		Если Лист.ВидУпаковки = ВидУпаковкиЛогистическая
			И МассивТУВСохраненномДереве.Найти(Штрихкод) = Неопределено Тогда
			МассивТУВСохраненномДереве.Добавить(Штрихкод);
		КонецЕсли;
		
		Родитель = Лист.Родитель;
		Пока Родитель <> Неопределено Цикл
			Штрихкод = Родитель[ПолеШтрихкода];
			Если Родитель.ВидУпаковки = ВидУпаковкиЛогистическая
				И МассивТУВСохраненномДереве.Найти(Штрихкод) = Неопределено Тогда
				МассивТУВСохраненномДереве.Добавить(Штрихкод);
			КонецЕсли;
			
			Родитель = Родитель.Родитель;			
		КонецЦикла; 
	КонецЦикла;
	//
	
	ИспользованиеПолныхКодовМаркировки = Ложь;
	Если Метаданные.ОпределяемыеТипы.Найти("ОснованиеФискальнойОперацииИСМП") <> Неопределено // Основание фиксальной операции
		И Метаданные.ОпределяемыеТипы["ОснованиеФискальнойОперацииИСМП"].Тип.СодержитТип(ТипЗнч(Док1СРезультат.Ссылка)) Тогда
		ИспользованиеПолныхКодовМаркировки = Истина;
	ИначеЕсли ФлагиТипаДокумента.МаркировкаИСМП // Отчет о верификации нанесенных КМ
		И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("ОтчетОВерификацииНанесенныхКМ") <> Неопределено
		И (Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ОтчетОВерификацииНанесенныхКМ")
			ИЛИ Док1СРезультат.ОперацияНанесения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ОтчетОВерификацииНанесенныхКМ")) Тогда
		ИспользованиеПолныхКодовМаркировки = Истина;
	КонецЕсли;
	
	Если ИспользованиеПолныхКодовМаркировки Тогда
		ТаблицаДляСохраненияВПул = Новый ТаблицаЗначений;		
		ТаблицаДляСохраненияВПул.Колонки.Добавить("КодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ПолныйКодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("GTIN");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ТипШтрихкода");
	КонецЕсли;
	
	Кэш_ОсобенностиНоменклатуры	= Новый Соответствие;
	
	МассивШКВсехУпаковокСТСД = Новый Массив;
	МассивНеизвестныхУпаковокСТСД = Новый Массив;
	СоответствияШКСтруктуреДанных = Новый Соответствие;
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений")
			ИЛИ НЕ СтрокаФакт.Свойство("Маркировка")
			ИЛИ СтрокаФакт.Маркировка <> "Табак" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаФакт.Вставить("Номенклатура", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара))); 
		
		Если ИспользованиеХарактеристик Тогда
			Если СтрокаФакт.Свойство("ИдХарактеристики")
				И ЗначениеЗаполнено(СтрокаФакт.ИдХарактеристики) Тогда 
				СтрокаФакт.Вставить("Характеристика", Справочники["ХарактеристикиНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдХарактеристики)));
			Иначе
				СтрокаФакт.Вставить("Характеристика", Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());
			КонецЕсли;
		Иначе
			СтрокаФакт.Вставить("Характеристика", ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры"));
		КонецЕсли;
		
		// Признак маркировки для табака, альтернативного табака и никотиносодержащей продукции в документе MS совпадает.
		// Разделяем данные здесь по особенностям учета номенклатуры
		//ОсобенностьУчета = Вычислить("ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаФакт.Номенклатура, ""ОсобенностьУчета"")");
		ОсобенностьУчета = Кэш_ОсобенностиНоменклатуры.Получить(СтрокаФакт.ИдТовара);
		Если ОсобенностьУчета = Неопределено Тогда
			ОсобенностьУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаФакт.Номенклатура, "ОсобенностьУчета");
					
			Кэш_ОсобенностиНоменклатуры.Вставить(СтрокаФакт.ИдТовара, ОсобенностьУчета);
		КонецЕсли;		
		
		Если ОсобенностьУчета <> ОсобенностьУчетаИС Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьРаботаСТабаком = Истина;
		
		ШтрихкодПалеты 	= "";
		ШтрихкодКоробки = "";
		ШтрихкодБлока 	= "";
		ШтрихкодМарки 	= "";
		ТребуетсяУточнитьШКвИСМП = Ложь; // Переменная переводится в Истина, если в поле Марка окажется Штрихкод блока или коробки
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда // Если нет свойства ИдКоробки, то в свойстве SSCC находится ШтрихкодКоробки
			Если СтрокаФакт.Свойство("SSCC") И ЗначениеЗаполнено(СтрокаФакт.SSCC) Тогда 
				ШтрихкодПалеты = СтрокаФакт.SSCC;		
			Иначе                            
				ШтрихкодПалеты = "";
			КонецЕсли;
			
			ШтрихкодКоробки = СтрокаФакт.ИдКоробки;
		ИначеЕсли СтрокаФакт.Свойство("SSCC") И ЗначениеЗаполнено(СтрокаФакт.SSCC) Тогда
			ШтрихкодКоробки = СтрокаФакт.SSCC;
		КонецЕсли;
						
		Если СтрокаФакт.Свойство("ИдРодителя")
			И ЗначениеЗаполнено(СтрокаФакт.ИдРодителя) Тогда 
			Попытка
				БлокСсылка = Справочники["ШтрихкодыУпаковокТоваров"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдРодителя));
				
				ШтрихкодБлока = БлокСсылка.ЗначениеШтрихкода;
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьТабачнуюПродукциюИСМПСЗапросомДанных", "Ошибка",
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
				
			// В ИдРодителя может быть записан GUID коробки или палеты
			Если ЗначениеЗаполнено(ШтрихкодБлока) Тогда
				Если ШтрихкодБлока = ШтрихкодКоробки Тогда	
					ШтрихкодБлока = "";
				КонецЕсли;
				Если ШтрихкодБлока = ШтрихкодПалеты Тогда
					ШтрихкодБлока = "";
				КонецЕсли;
				
				// В 1С может храниться упаковка в формате без скобок, в документе MS - со скобками
				Если ЗначениеЗаполнено(ШтрихкодБлока) И НЕ ПустаяСтрока(ШтрихкодКоробки) Тогда
					ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодКоробки, "(", ""), ")", "");
					
					Если ШтрихкодБлока = ШтрихкодБезСкобок Тогда	
						ШтрихкодКоробки = ШтрихкодБезСкобок;
						ШтрихкодБлока = "";
					КонецЕсли;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ШтрихкодБлока) И НЕ ПустаяСтрока(ШтрихкодПалеты) Тогда
					ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодПалеты, "(", ""), ")", "");
					
					Если ШтрихкодБлока = ШтрихкодБезСкобок Тогда	
						ШтрихкодПалеты = ШтрихкодБезСкобок;
						ШтрихкодБлока = "";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
			
		// Проверяем формат коробов и палет в сохраненном дереве значений
		Если НЕ ПустаяСтрока(ШтрихкодКоробки)
			И Найти(ШтрихкодКоробки, "(") Тогда
			ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодКоробки) <> Неопределено;
			
			Если НЕ ТУНайденаВСохраненномДереве Тогда
				ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодКоробки, "(", ""), ")", "");
					
				ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодБезСкобок) <> Неопределено;
				Если ТУНайденаВСохраненномДереве Тогда
					ШтрихкодКоробки = ШтрихкодБезСкобок;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ШтрихкодПалеты)
			И Найти(ШтрихкодПалеты, "(") Тогда
		    ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодПалеты) <> Неопределено;
			
			Если НЕ ТУНайденаВСохраненномДереве Тогда
				ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодПалеты, "(", ""), ")", "");
					
				ТУНайденаВСохраненномДереве = МассивТУВСохраненномДереве.Найти(ШтрихкодБезСкобок) <> Неопределено;
				Если ТУНайденаВСохраненномДереве Тогда
					ШтрихкодПалеты = ШтрихкодБезСкобок;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		//
		
		Если НЕ ЗначениеЗаполнено(ШтрихкодБлока) Тогда
			Если СтрокаФакт.Свойство("ШтрихкодБлока") И ЗначениеЗаполнено(СтрокаФакт.ШтрихкодБлока) Тогда
				ШтрихкодБлока = СтрокаФакт.ШтрихкодБлока;	
			ИначеЕсли СтрокаФакт.Свойство("ШтрихкодРодителя")
				И (ЗначениеЗаполнено(СтрокаФакт.ШтрихкодРодителя)) Тогда // Или СтрокаФакт.Свойство("ИдРодителя") = Ложь) Тогда		
				ШтрихкодБлока = СтрокаФакт.ШтрихкодРодителя;	
			КонецЕсли;
		КонецЕсли;
		
		ШтрихкодПачки = СтрокаФакт.Марка;
							
		// На случай если в поле Марка записан штрихкод блока (т.е. блок вкладывается во что-то)
		Если ШтрихкодПачки = ШтрихкодБлока Тогда
			ШтрихкодПачки = "";
		КонецЕсли;
		
		ДанныеКодаМаркировки = Неопределено;
		
		Если ЗначениеЗаполнено(ШтрихкодПачки) Тогда
			ДанныеКодаМаркировки = ИО_НормализоватьКодМаркировки(ШтрихкодПачки, ВидПродукцииИС, Истина);
			
			Если ДанныеКодаМаркировки <> Неопределено Тогда
				Если ДанныеКодаМаркировки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда // ЭтоПачка
					ШтрихкодПачки = ДанныеКодаМаркировки.Штрихкод;
				ИначеЕсли ДанныеКодаМаркировки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") Тогда // ЭтоБлок
					ШтрихкодПачки = "";
					ШтрихкодБлока = ДанныеКодаМаркировки.Штрихкод;
				ИначеЕсли ДанныеКодаМаркировки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая") Тогда // ЭтоКоробка
					ШтрихкодПачки = "";
					ШтрихкодКоробки = ДанныеКодаМаркировки.Штрихкод; 
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		    
		ШтрихкодКоробки = ИО_НормализоватьКодМаркировки(ШтрихкодКоробки, ВидПродукцииИС);
		ШтрихкодБлока 	= ИО_НормализоватьКодМаркировки(ШтрихкодБлока, ВидПродукцииИС);
		ШтрихкодПачки 	= ИО_НормализоватьКодМаркировки(ШтрихкодПачки, ВидПродукцииИС);
		
		// +++ Если при сканировании блока подтягивается коробка из плана и это считается багом, то раскомментировать строчки ниже
		//Если ЗначениеЗаполнено(ШтрихкодБлока) Тогда
		//	ШтрихкодКоробки = "";
		//КонецЕсли;
		// ---
		ВставитьВСтрокуИДобавитьВМассивБезДублей(СтрокаФакт, "ШтрихкодПаллетыНормализованный", ШтрихкодПалеты,	МассивШКВсехУпаковокСТСД, МассивНеизвестныхУпаковокСТСД, СоответствияШКСтруктуреДанных, ТребуетсяУточнитьШКвИСМП, ДанныеКодаМаркировки);
		ВставитьВСтрокуИДобавитьВМассивБезДублей(СтрокаФакт, "ШтрихкодКоробкиНормализованный", ШтрихкодКоробки,	МассивШКВсехУпаковокСТСД, МассивНеизвестныхУпаковокСТСД, СоответствияШКСтруктуреДанных, ТребуетсяУточнитьШКвИСМП, ДанныеКодаМаркировки);
		ВставитьВСтрокуИДобавитьВМассивБезДублей(СтрокаФакт, "ШтрихкодБлокаНормализованный",   ШтрихкодБлока,	МассивШКВсехУпаковокСТСД, МассивНеизвестныхУпаковокСТСД, СоответствияШКСтруктуреДанных, ТребуетсяУточнитьШКвИСМП, ДанныеКодаМаркировки);
		ВставитьВСтрокуИДобавитьВМассивБезДублей(СтрокаФакт, "ШтрихкодПачкиНормализованный",   ШтрихкодПачки,	МассивШКВсехУпаковокСТСД, МассивНеизвестныхУпаковокСТСД, СоответствияШКСтруктуреДанных, ТребуетсяУточнитьШКвИСМП, ДанныеКодаМаркировки);
			
		ПолныйКодМаркировки = ?(СтрокаФакт.Свойство("ПолнаяМаркаBase64"), СтрокаФакт.ПолнаяМаркаBase64, "");
		Если ИспользованиеПолныхКодовМаркировки 
			И ЗначениеЗаполнено(ПолныйКодМаркировки) Тогда
			Если ДанныеКодаМаркировки = Неопределено Тогда
				ДанныеКодаМаркировки = ИО_НормализоватьКодМаркировки(СтрокаФакт.Марка, ВидПродукцииИС, Истина);
			КонецЕсли;
			
			Если НЕ ДанныеКодаМаркировки = Неопределено Тогда
				НоваяСтрокаДляПула = ТаблицаДляСохраненияВПул.Добавить();
				НоваяСтрокаДляПула.ПолныйКодМаркировки 	= ПолныйКодМаркировки;	
				НоваяСтрокаДляПула.КодМаркировки 		= ДанныеКодаМаркировки.НормализованныйШтрихкод;
				НоваяСтрокаДляПула.ТипШтрихкода  		= ДанныеКодаМаркировки.ТипШтрихкода;
				НоваяСтрокаДляПула.GTIN 		 		= ДанныеКодаМаркировки.GTIN;
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;
	
	//Возврат если нет данных
	Если ЕстьРаботаСТабаком = Ложь
		И МассивШКВсехУпаковокСТСД.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользованиеПолныхКодовМаркировки Тогда	
		ИСМП_СохранитьКодыМаркировкиВПул(ТаблицаДляСохраненияВПул, СтруктураПараметров);
	КонецЕсли;
	
	Если Док1СРезультат.Метаданные().Реквизиты.Найти("ВидПродукции") <> Неопределено Тогда
		Док1СРезультат.ВидПродукции = ВидПродукцииИС;	
	КонецЕсли;
	
	// 13.07.20 Старая процедура стала ломать документ. Пока закрыли
	// Если неизвестных упаковок нет, то запустим старый обработчик, чтоб не обращаться в ИС МП
	//Если МассивНеизвестныхУпаковокСТСД.Количество() = 0 Тогда
	//	УТ_11_4_ПроверитьТабачнуюПродукциюИСМП(СтруктураПараметров);
	//	Возврат;
	//КонецЕсли;
	
	// +++ Было
	// Данные по штрихкодам будем сохранять во временном хранилище и загружать по кнопке на форме проверки и подбора
	//Если ДанныеПроверкиИПодбора <> Неопределено 
	//	И ДанныеПроверкиИПодбора.Свойство("Cleverence_МОТП_ШтрихкодыТСД") Тогда
	//	Cleverence_МОТП_ШтрихкодыТСД = ДанныеПроверкиИПодбора.Cleverence_МОТП_ШтрихкодыТСД;
	//Иначе
	//	ДанныеПроверкиИПодбора = МОТП_СоздатьСтруктуруДанныеПроверкиИПодбора(Док1СРезультат, ФлагиТипаДокумента.РеализацияТУ, ВидПродукцииИС);
	//	Cleverence_МОТП_ШтрихкодыТСД = ИО_ПодготовитьТаблицуШтрихкодовТСДДляСохраненияВРегистр(); 
	//КонецЕсли;
	
	// --- Стало
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
	    ДанныеПроверкиИПодбора = МОТП_СоздатьСтруктуруДанныеПроверкиИПодбора(Док1СРезультат, ФлагиТипаДокумента.РеализацияТУ, ВидПродукцииИС);
			
		// Заполним позже с учетом параметров сканирования
		ДанныеПроверкиИПодбора.Вставить("ПараметрыПроверкиКодовМаркировки", Новый Структура);	
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора.Свойство("Cleverence_МОТП_ШтрихкодыТСД") Тогда
		Cleverence_МОТП_ШтрихкодыТСД = ДанныеПроверкиИПодбора.Cleverence_МОТП_ШтрихкодыТСД;
	Иначе		
		Cleverence_МОТП_ШтрихкодыТСД = ИО_ПодготовитьТаблицуШтрихкодовТСДДляСохраненияВРегистр(); 
	КонецЕсли;	
	// --- Конец
	
	Для Каждого Элемент Из СоответствияШКСтруктуреДанных Цикл
		ОбрабатываемыйШтрихкод = Элемент.Ключ;
		ДанныеШК = Элемент.Значение;
		//Если ДанныеШК.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
		//	Продолжить;	
		//КонецЕсли;
				
		НайденнаяСтрока = Cleverence_МОТП_ШтрихкодыТСД.Найти(ОбрабатываемыйШтрихкод, "Штрихкод");
		Если НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока = Cleverence_МОТП_ШтрихкодыТСД.Добавить();
			НоваяСтрока.Штрихкод   = ОбрабатываемыйШтрихкод;
			НоваяСтрока.Количество = 1;	
		КонецЕсли;		
	КонецЦикла;
			
	// Попытаемся сразу записать документ. Если запись будет неудачна, то мы не сможем заполнить данные подбора или выполнить запрос в ИС МП
	Попытка
		Док1СРезультат.Записать(РежимЗаписиДокумента.Запись); 
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Не удалось записать документ " + Строка(Док1СРезультат)+ " перед запросом в ИС МОТП для получения неизвестных упаковок. Ошибка: ";
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьТабачнуюПродукциюИСМП", "Ошибка", ТекстОшибки + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
		Сообщить(ТекстОшибки + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
		//Возврат Неопределено;
	КонецПопытки;
	
	ДанныеПроверкиИПодбора.Вставить("Cleverence_МОТП_ШтрихкодыТСД", Cleverence_МОТП_ШтрихкодыТСД);
	
	// Сразу запишем в регистр таблицу штрихкодов с тсд. Если ниже свалится с ошибкой, то можно будет загрузить данные из расширения
	хзДанныеПроверкиИПодбора = Новый ХранилищеЗначения(ДанныеПроверкиИПодбора);
	
	Попытка
		РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
	Исключение
		РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
	КонецПопытки;	
	
	Если Док1СРезультат.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
		ОрганизацияДокумента = Док1СРезультат.Организация;	
	Иначе
		ОрганизацияДокумента = ИО_ЗначениеГлобальногоПараметра("Организация",СтруктураПараметров);
	КонецЕсли;
	
	ТребуетсяОбновлениеКлючаСессии = ИО_ОбщийМодуль("ИнтерфейсАвторизацииИСМПВызовСервера").ТребуетсяОбновлениеКлючаСессии(ИнтерфейсМОТПКлиентСервер_ПараметрыЗапросаКлючаСессии(ОрганизацияДокумента));
	Если ТребуетсяОбновлениеКлючаСессии Тогда
		ТекстОшибки = "Неудачная авторизация в ИС МОТП. Необходимо обновить ключ сессии";	
