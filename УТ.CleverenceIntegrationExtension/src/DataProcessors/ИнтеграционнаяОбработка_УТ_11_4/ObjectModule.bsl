	Если ДеревоМаркированнойПродукции.Колонки.Найти("Штрихкод") = Неопределено Тогда
		ДеревоМаркированнойПродукции.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	КонецЕсли;
	
	Попытка
		//ШтрихКодыУпаковок = Вычислить("ШтрихкодированиеИС.ШтрихкодыУпаковок(ШтрихкодированиеИС.ЗначенияШтрихкодовВНаличииИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено))");
		ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовВНаличииИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено));
	Исключение
		//ШтрихКодыУпаковок = Вычислить("ШтрихкодированиеИС.ШтрихкодыУпаковок(ШтрихкодированиеИС.ЗначенияШтрихкодовИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено))");
		ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено));
	КонецПопытки;
	 
	//ТаблицаШтрихкодовВерхнегоУровня = Вычислить("ПроверкаИПодборПродукцииИСМП.ПустаяТаблицаШтрихкодовВерхнегоУровня()");
	ТаблицаШтрихкодовВерхнегоУровня = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаШтрихкодовВерхнегоУровня();
	
	//Если ЭтоПТУ = Истина Тогда				

		//Выполнить("Справочники.ШтрихкодыУпаковокТоваров.РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(ДеревоМаркированнойПродукции,
		//|	                                                                                                     ТаблицаШтрихкодовВерхнегоУровня,
		//|																										 ШтрихКодыУпаковок)");
		Справочники["ШтрихкодыУпаковокТоваров"].РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(ДеревоМаркированнойПродукции,
			ТаблицаШтрихкодовВерхнегоУровня,
			ШтрихКодыУпаковок);
	//КонецЕсли;
	
	Если Док1СРезультат.Метаданные().ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено Тогда																										 
		Док1СРезультат.ШтрихкодыУпаковок.Очистить();
		Для каждого ШКУпаковки Из ШтрихКодыУпаковок Цикл
			НоваяСтрока = Док1СРезультат.ШтрихкодыУпаковок.Добавить();
			НоваяСтрока.ШтрихкодУпаковки = ШКУпаковки.Ссылка;
		КонецЦикла;																										 
	КонецЕсли;
	
	ПараметрыОкончанияПроверки.ТаблицаШтрихкодовВерхнегоУровня = ТаблицаШтрихкодовВерхнегоУровня;
		
	//ТаблицаПодобраннойПровереннойПродукции = Вычислить("ПроверкаИПодборПродукцииИСМП.ПустаяТаблицаПодобраннойПровереннойПродукции()");
	ТаблицаПодобраннойПровереннойПродукции = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаПодобраннойПровереннойПродукции();
	
	ЕстьРасхождения = Ложь;
	
	Для Каждого СтрокаДерева Из ПодобраннаяТабачнаяПродукция Цикл
		
		НоваяСтрока = ТаблицаПодобраннойПровереннойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		Если Не ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
			НоваяСтрока.Характеристика = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Серия) Тогда
			НоваяСтрока.Серия = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры");
		КонецЕсли;
		
		Если НоваяСтрока.Количество <> НоваяСтрока.КоличествоПодобрано Тогда
			
			ЕстьРасхождения = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОкончанияПроверки.ТаблицаПодобраннойПровереннойПродукции = ТаблицаПодобраннойПровереннойПродукции;
	
	//Выполнить("ПроверкаИПодборПродукцииИСМП.ЗафиксироватьРезультатПроверкиИПодбора(ПараметрыОкончанияПроверки)");
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ЗафиксироватьРезультатПроверкиИПодбора(ПараметрыОкончанияПроверки);
	
	//Если ЕстьРасхождения Тогда
	//	ТребуемоеДействие = Перечисления.ТребуемоеДействиеДокументЭДО.Отклонить;
	//Иначе
