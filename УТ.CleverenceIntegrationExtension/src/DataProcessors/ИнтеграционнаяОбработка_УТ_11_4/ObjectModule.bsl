			Продолжить;
		КонецЕсли;	
			
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Коробка.ШтрихкодКоробки, "Штрихкод", Истина);	
		Если РезультатПоиска = Неопределено Тогда
			Если ЗначениеЗаполнено(Коробка.ШтрихкодПалеты) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Коробка.ШтрихкодПалеты, "Штрихкод", Истина);
			Иначе
				СтрокаРодитель = ДеревоМаркированнойПродукции;
			КонецЕсли;
			
			НоваяСтрока = СтрокаРодитель.Строки.Добавить();
			// заполняем реквизиты палеты
			
			НоваяСтрока.СтатусПроверки 					 		= СтатусПроверкиОтсутствует;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных 		= "Коробка";
			НоваяСтрока.ТипУпаковки 					 		= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 		= 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось 		= 0;
			НоваяСтрока.Штрихкод 				 		 		= Коробка.ШтрихкодКоробки;
			НоваяСтрока.Представление 					 		= Коробка.ШтрихкодКоробки;
			НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхПачек]	= 0;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 		= 0;
			НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхБлоков]	= 0;
			
			Если ЕстьМетаданныеВидыУпаковокИС Тогда
				НоваяСтрока.ВидУпаковки					 		= ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая");
			КонецЕсли;
			
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
			
			Если ТаблицаИзмененийТабачнойПродукции <> Неопределено Тогда
				МОТП_ДобавитьСтрокуВТаблицуИзмененийТабачнойПродукции(ТаблицаИзмененийТабачнойПродукции, НоваяСтрока, -1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СписокБлоковПлана = ТаблицаМаркированнойПродукцииПлана.Скопировать(,"ШтрихкодПалеты,ШтрихкодКоробки,ШтрихкодБлока");
	СписокБлоковПлана.Свернуть("ШтрихкодПалеты,ШтрихкодКоробки,ШтрихкодБлока");
	
	Для каждого Блок Из СписокБлоковПлана Цикл
		
		Если НЕ ЗначениеЗаполнено(Блок.ШтрихкодБлока) Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Блок.ШтрихкодБлока, "Штрихкод", Истина);
		Если РезультатПоиска = Неопределено Тогда
			Если ЗначениеЗаполнено(Блок.ШтрихкодКоробки) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Блок.ШтрихкодКоробки, "Штрихкод", Истина);
			ИначеЕсли ЗначениеЗаполнено(Блок.ШтрихкодПалеты) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Блок.ШтрихкодПалеты, "Штрихкод", Истина);
			Иначе
				СтрокаРодитель = ДеревоМаркированнойПродукции;
			КонецЕсли;
			
			НоваяСтрока = СтрокаРодитель.Строки.Добавить();
			// заполняем реквизиты палеты
			
			НоваяСтрока.СтатусПроверки 					 		= СтатусПроверкиОтсутствует;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных 		= "Блок";
			НоваяСтрока.ТипУпаковки 					 		= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 		= 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось 		= 0;
			НоваяСтрока.Штрихкод 				 		 		= Блок.ШтрихкодБлока;
			НоваяСтрока.Представление 					 		= Блок.ШтрихкодБлока;
			НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхПачек]	= 0;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 		= 0;
			НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхБлоков]	= 0;
			
			Если ЕстьМетаданныеВидыУпаковокИС Тогда
				НоваяСтрока.ВидУпаковки					 		= ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая");
			КонецЕсли;
			
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
			
			Если ТаблицаИзмененийТабачнойПродукции <> Неопределено Тогда
				МОТП_ДобавитьСтрокуВТаблицуИзмененийТабачнойПродукции(ТаблицаИзмененийТабачнойПродукции, НоваяСтрока, -1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Метаданные.Перечисления.Найти("ПрочиеЗоныПересчетаПродукцииИСМП") <> Неопределено Тогда
		ПеречислениеБлокиБезКоробки =  ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки")
	Иначе
		ПеречислениеБлокиБезКоробки =  ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаТабачнойПродукцииМОТП.БлокиБезКоробки");
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки)
			ИЛИ СтрокаДерева.ТипУпаковки = ПеречислениеБлокиБезКоробки Тогда
			РассчитатьХешСуммыУпаковки(СтрокаДерева, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция МОТП_ПроверитьШКЭтоПачкаБлокИлиКоробка(Штрихкод)
	Результат = Новый Структура("ЭтоПачка, ЭтоБлок, ЭтоКоробка", Ложь,Ложь,Ложь);
	//Результат.ЭтоПачка = Вычислить("ШтрихкодированиеМОТПКлиентСервер.ЭтоКодМаркировкиТабачнойПачки(Штрихкод)");
	Результат.ЭтоПачка = ИО_ОбщийМодуль("ШтрихкодированиеМОТПКлиентСервер").ЭтоКодМаркировкиТабачнойПачки(Штрихкод);
	Если Не Результат.ЭтоПачка Тогда
		//Результат.ЭтоБлок = Вычислить("ШтрихкодированиеМОТПКлиентСервер.ЭтоКодМаркировкиБлока(Штрихкод)");
		Результат.ЭтоБлок = ИО_ОбщийМодуль("ШтрихкодированиеМОТПКлиентСервер").ЭтоКодМаркировкиБлока(Штрихкод);
		Если Не Результат.ЭтоБлок Тогда
			//Результат.ЭтоКоробка = Вычислить("ШтрихкодированиеМОТПКлиентСервер.ЭтоКодЛогистическойУпаковки(Штрихкод)");
			Результат.ЭтоКоробка = ИО_ОбщийМодуль("ШтрихкодированиеМОТПКлиентСервер").ЭтоКодЛогистическойУпаковки(Штрихкод);
		КонецЕсли;
	КонецЕсли;
		
	Возврат Результат;
КонецФункции

Функция ИО_ПодготовитьТаблицуШтрихкодовТСДДляСохраненияВРегистр()
	Cleverence_МОТП_ШтрихкодыТСД = Новый ТаблицаЗначений;
	Cleverence_МОТП_ШтрихкодыТСД.Колонки.Добавить("Штрихкод", 		  Новый ОписаниеТипов("Строка"));
	Cleverence_МОТП_ШтрихкодыТСД.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("Строка"));
	Cleverence_МОТП_ШтрихкодыТСД.Колонки.Добавить("Количество",		  Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	
	Возврат Cleverence_МОТП_ШтрихкодыТСД; 
КонецФункции
		
Функция ИО_НормализоватьКодМаркировки(Штрихкод, ВидПродукцииИС, ВернутьСтруктуру = Ложь)
	
	Результат = Неопределено;
	
	Попытка
		СтруктураЗначения = ШтрихкодированиеИС_НоваяСтруктураОбработкиШтрихкода(Штрихкод, ВидПродукцииИС);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИО_НормализоватьКодМаркировки", "Предупреждение", ТекстОшибки);
		
		СтруктураЗначения = ИО_НоваяСтруктураОбработкиШтрихкода(Штрихкод, ВидПродукцииИС, Ложь);
	КонецПопытки;
	
	Если СтруктураЗначения <> Неопределено Тогда
		Результат = ?(ВернутьСтруктуру, СтруктураЗначения, СтруктураЗначения.Штрихкод);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// см. Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор.СформироватьПараметрыПроверкиКодовМаркировки()
// 	   Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор.СформироватьПараметрыПроверкиКодовМаркировки()
//  
Функция ИО_ПараметрыПроверкиКодовМаркировки(ТипМаркировки = "ИСМП", Документ = Неопределено, ЭтоРТУ, ВидМаркируемойПродукции, ПараметрыСканирования = Неопределено)
	
	ИмяСобытия = "ИО_ПараметрыПроверкиКодовМаркировки";
	
	ПараметрыПроверкиКодовМаркировки = Новый Структура();
	
	ПараметрыПроверкиКодовМаркировки.Вставить("ОтсутствуетПодключение" + ТипМаркировки, Ложь);	
	
	Попытка
		ЗапрашиватьДанныеСервиса = Не ИО_ОбщийМодуль("ЭлектронноеВзаимодействиеИСМП").ЗавершенОбменПоЭДО(Документ);
	Исключение
		ЗапрашиватьДанныеСервиса = Ложь;
	КонецПопытки;
	
	Попытка
		ПараметрыСканирования_ВидОперацииИСМП = 
			ПараметрыСканирования.ВидОперацииИСМП;
		ПараметрыСканирования_ТребуетсяПроверкаСредствамиККТ =
			ПараметрыСканирования.ТребуетсяПроверкаСредствамиККТ;
	Исключение
		ПараметрыСканирования_ВидОперацииИСМП = Неопределено;
		ПараметрыСканирования_ТребуетсяПроверкаСредствамиККТ = Истина;
	КонецПопытки;
	
	Попытка
		ЭтоПриемкаИзСтранЕАЭС = ИО_ОбщийМодуль("ИнтеграцияИСМПСлужебныйКлиентСервер").ЭтоПриемкаИзСтранЕАЭС(
			ПараметрыСканирования_ВидОперацииИСМП);
	Исключение
		ЭтоПриемкаИзСтранЕАЭС = Ложь;
	КонецПопытки;
	
	Попытка
		КонтролироватьСтатусыКодовМаркировки = ИО_ОбщийМодуль("НастройкаПараметровСканированияСлужебныйКлиентСерверПовтИсп").КонтролироватьСтатусыКодовМаркировки(
			ВидМаркируемойПродукции,
			ПараметрыСканирования_ВидОперацииИСМП,
			ПараметрыСканирования_ТребуетсяПроверкаСредствамиККТ);
			
		Если ЭтоПриемкаИзСтранЕАЭС Тогда
			КонтролироватьВладельцевКодовМаркировки = Ложь;
		Иначе
			КонтролироватьВладельцевКодовМаркировки = ИО_ОбщийМодуль("НастройкаПараметровСканированияСлужебныйКлиентСерверПовтИсп").КонтролироватьВладельцевКодовМаркировки(
				ВидМаркируемойПродукции,
				ПараметрыСканирования_ВидОперацииИСМП);
		КонецЕсли;
		ПараметрыКонтроляЗаполнены = Истина;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПараметрыКонтроляЗаполнены = Ложь;
	КонецПопытки;
	
	Если НЕ ПараметрыКонтроляЗаполнены Тогда
		Попытка
			КонтролироватьСтатусыКодовМаркировки = ИО_ОбщийМодуль("НастройкаПараметровСканированияСлужебныйКлиентСерверПовтИсп").КонтролироватьСтатусыКодовМаркировки(
				ВидМаркируемойПродукции,
				Неопределено);
			КонтролироватьВладельцевКодовМаркировки = ИО_ОбщийМодуль("НастройкаПараметровСканированияСлужебныйКлиентСерверПовтИсп").КонтролироватьВладельцевКодовМаркировки(
				ВидМаркируемойПродукции,
				Неопределено);
		Исключение
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение",
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонтролироватьСтатусыКодовМаркировки 	= Истина;
			КонтролироватьВладельцевКодовМаркировки = Истина;
		КонецПопытки;
	КонецЕсли;
	
	Если КонтролироватьСтатусыКодовМаркировки
		Или КонтролироватьВладельцевКодовМаркировки Тогда
		ЗапрашиватьДанныеСервиса = Истина;
	КонецЕсли;
	
	ПараметрыПроверкиКодовМаркировки.Вставить("ЗапрашиватьДанныеСервиса", 					ЗапрашиватьДанныеСервиса);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСтатусыКодовМаркировки", 		КонтролироватьСтатусыКодовМаркировки);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьВладельцевКодовМаркировки", 	КонтролироватьВладельцевКодовМаркировки);		
	
	Если НЕ ПараметрыСканирования = Неопределено Тогда
		ДопустимыеСтатусыКодовМаркировки = Неопределено;
		Если НЕ ПараметрыСканирования.Свойство("ДопустимыеСтатусыМОТП", ДопустимыеСтатусыКодовМаркировки)
			ИЛИ НЕ ЗначениеЗаполнено(ДопустимыеСтатусыКодовМаркировки) Тогда
			ДопустимыеСтатусыКодовМаркировки = ИО_ДопустимыеСтатусыКодовМаркировки(ТипМаркировки);
		КонецЕсли;
		
		ДопустимыеСтатусыУпаковок = Неопределено;
		Если НЕ ПараметрыСканирования.Свойство("ДопустимыеСтатусыУпаковокМОТП", ДопустимыеСтатусыУпаковок)
			ИЛИ НЕ ЗначениеЗаполнено(ДопустимыеСтатусыУпаковок) Тогда
			ДопустимыеСтатусыУпаковок = ИО_ДопустимыеСтатусыУпаковок(ТипМаркировки);
		КонецЕсли;
		
		ДопустимыеСтатусыНаборов = Неопределено;
		Если НЕ ПараметрыСканирования.Свойство("ДопустимыеСтатусыНаборовМОТП", ДопустимыеСтатусыНаборов)
			ИЛИ НЕ ЗначениеЗаполнено(ДопустимыеСтатусыНаборов) Тогда
			ДопустимыеСтатусыНаборов = ИО_ДопустимыеСтатусыНаборов(ТипМаркировки, Документ);
		КонецЕсли;
	Иначе
		ДопустимыеСтатусыКодовМаркировки = ИО_ДопустимыеСтатусыКодовМаркировки(ТипМаркировки);
		ДопустимыеСтатусыУпаковок 		 = ИО_ДопустимыеСтатусыУпаковок(ТипМаркировки);
		ДопустимыеСтатусыНаборов 		 = ИО_ДопустимыеСтатусыНаборов(ТипМаркировки, Документ);
	КонецЕсли;
	
	Если ТипМаркировки = "МОТП" Тогда
		ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеСтатусыМОТП", 	  			ДопустимыеСтатусыКодовМаркировки);
		ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеСтатусыУпаковокМОТП", 		ДопустимыеСтатусыУпаковок);
		ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеСтатусыНаборовМОТП",  		ДопустимыеСтатусыНаборов);
	КонецЕсли;
	ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеСтатусыКодовМаркировки", 	  	ДопустимыеСтатусыКодовМаркировки);
	ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеСтатусыУпаковок", 			  	ДопустимыеСтатусыУпаковок);
	ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеСтатусыНаборов",         		ДопустимыеСтатусыНаборов);
	ПараметрыПроверкиКодовМаркировки.Вставить("ОрганизацииИнтеркампани",       			Новый Соответствие());
	
	Попытка
		ЭтоДокументПриобретения = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЭтоДокументПриобретения(Документ.Ссылка);
	Исключение
		ЭтоДокументПриобретения = Ложь;
	КонецПопытки;
	
	Если ЭтоДокументПриобретения Тогда
		РежимПодбораСуществующихУпаковок = Ложь;
	Иначе
		РежимПодбораСуществующихУпаковок = Истина;
	КонецЕсли;
	
	Если НЕ Документ = Неопределено Тогда
		Попытка
			Организация = ?(НЕ ПараметрыСканирования = Неопределено,
				ПараметрыСканирования.Организация, Документ.Организация);
		Исключение
			Организация = Неопределено;
		КонецПопытки;
		Попытка
			Контрагент = Документ.Контрагент;
		Исключение
			Контрагент = Неопределено;
		КонецПопытки;
			
		Попытка
			Если РежимПодбораСуществующихУпаковок
				Или ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").КонтрагентНеРезидент(Контрагент) Тогда
				ИННВладельца = ИнтеграцияИСВызовСервера_ИННКПППоОрганизацииКонтрагенту(Организация).ИНН;
				Владелец     = Организация;
				
				Если НЕ ПараметрыСканирования = Неопределено Тогда
					Попытка		
						ОперацияПоддерживаетВладельцевКодовМаркировкиИнтеркампани = ИО_ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИСМП").ОперацияПоддерживаетВладельцевКодовМаркировкиИнтеркампани(ПараметрыСканирования);
					Исключение
						ОперацияПоддерживаетВладельцевКодовМаркировкиИнтеркампани = Ложь;
						
						ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
					
					Если ОперацияПоддерживаетВладельцевКодовМаркировкиИнтеркампани Тогда
						Попытка
							РеквизитыОрганизаций = ИО_ОбщийМодуль("ИнтеграцияИС").ОрганизацииИнтеркампани();
							Для Каждого СтрокаТаблицы Из РеквизитыОрганизаций Цикл
								ПараметрыПроверкиКодовМаркировки.ОрганизацииИнтеркампани.Вставить(СтрокаТаблицы.ИНН, СтрокаТаблицы.Организация);
							КонецЦикла;
						Исключение
							ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
			Иначе
				ИННВладельца = ИнтеграцияИСВызовСервера_ИННКПППоОрганизацииКонтрагенту(Контрагент).ИНН;
				Владелец     = Контрагент;
			КонецЕсли;
		Исключение
			Владелец 	 = Неопределено;
			ИННВладельца = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	КонтролироватьВладельца = ?(ЭтоРТУ, Ложь, Истина);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьВладельца", 				КонтролироватьВладельца); 
	ПараметрыПроверкиКодовМаркировки.Вставить("ИННВладельца",            				ИННВладельца);
	ПараметрыПроверкиКодовМаркировки.Вставить("Владелец",                				Владелец);
	ПараметрыПроверкиКодовМаркировки.Вставить("ОбратноеСканирование",    				Ложь);	
	
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСтандартнуюВложенность", 	Истина);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьВложенностьУпаковок", 		Ложь);
	ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыеВложенияАгрегатов",      		Неопределено);	
	
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСоставАгрегата",                         Ложь);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСоставАгрегатаПриИзмененииСтрокиДерева", Ложь);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСоставГрупповойУпаковки",                         Ложь);
	ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСоставГрупповойУпаковкиПриИзмененииСтрокиДерева", Ложь);
	
	Если ТипМаркировки = "МОТП" Тогда
		ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Неопределено;
		
		Если ЭтоДокументПриобретения Тогда
			Если ИнтеграцияИСМПКлиентСерверПовтИсп_УчитыватьМРЦ()
				Или ИнтеграцияИСМПКлиентСерверПовтИсп_ЗапрашиватьДанныеСервиса() Тогда
				ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Ложь;
			Иначе
				ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыПроверкиКодовМаркировки.Вставить("ВозможностьЗагрузкиДанныхБезПодключенияМОТП",				ВозможностьЗагрузкиДанныхБезПодключенияМОТП);
		ПараметрыПроверкиКодовМаркировки.Вставить("ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП",	Истина);
		ПараметрыПроверкиКодовМаркировки.Вставить("ДатаПроизводстваНачалаКонтроляСтатусовКодовМаркировкиМОТП",	ПроверкаИПодборПродукцииМОТПКлиентСервер_ДатаНачалаКонтроляКодовМаркировки());
		ПараметрыПроверкиКодовМаркировки.Вставить("ОтключитьКонтрольСтатусовКодовМаркировки",					Истина);
		
		ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьСоставБлока",									Ложь);
		
		ПараметрыПроверкиКодовМаркировки.Вставить("КонтролироватьМинимальныеРозничныеЦены", Ложь);
		Если ЭтоДокументПриобретения И ИнтеграцияИСМПКлиентСерверПовтИсп_УчитыватьМРЦ() Тогда
			Попытка
				МинимальныеЦеныТабачнойПродукции = ИО_ОбщийМодуль("ОбщегоНазначенияИСМП").МинимальнаяЦенаРозничнойПродажиТабачнойПродукции();
				Если МинимальныеЦеныТабачнойПродукции.ЗагруженыАктуальныеЦены Тогда
					ПараметрыПроверкиКодовМаркировки.КонтролироватьМинимальныеРозничныеЦены = Истина;
					ПараметрыПроверкиКодовМаркировки.Вставить("МинимальнаяРозничнаяЦена", МинимальныеЦеныТабачнойПродукции.МинРЦ)
				КонецЕсли;
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ТипМаркировки = "ИСМП" Тогда
		ПараметрыПроверкиКодовМаркировки.Вставить("ВозможностьЗагрузкиДанныхБезПодключенияМОТП", Неопределено);
		
		Если ЭтоДокументПриобретения Тогда
            Если ИнтеграцияИСМПКлиентСерверПовтИсп_ЗапрашиватьДанныеСервиса() Тогда
				ПараметрыПроверкиКодовМаркировки.ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Ложь;
			Иначе
				ПараметрыПроверкиКодовМаркировки.ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыПроверкиКодовМаркировки.Вставить("ДопустимыйСпособВводаВОборот",		ИО_ДопустимыеСпособыВводаВОборот(Документ, ВидМаркируемойПродукции));
		ПараметрыПроверкиКодовМаркировки.Вставить("ЗапрашиватьКоличествоМерногоТовара", Истина);
	КонецЕсли;
	
	Попытка
		Если НЕ ПараметрыСканирования = Неопределено Тогда
			ПродукцияОнлайнПроверкиПриРозничнойПродаже = ИО_ОбщийМодуль("ОбщегоНазначенияИСМПКлиентСерверПовтИсп").ПродукцияПодлежитОбязательнойОнлайнПроверкеПередРозничнойПродажей(
				ВидМаркируемойПродукции,
				ПараметрыСканирования.ВидОперацииИСМП,
				ПараметрыСканирования.ТребуетсяПроверкаСредствамиККТ);
		Иначе
			ПродукцияОнлайнПроверкиПриРозничнойПродаже = Ложь;
		КонецЕсли;	
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ПродукцияОнлайнПроверкиПриРозничнойПродаже = Ложь;
	КонецПопытки;
	
	ПараметрыПроверкиКодовМаркировки.Вставить("ПроверятьЗаполнениеИдентификатораГИСМТ", ПродукцияОнлайнПроверкиПриРозничнойПродаже);
	
	Возврат ПараметрыПроверкиКодовМаркировки;
	
КонецФункции

Функция ИО_ДопустимыеСпособыВводаВОборот(Документ, ВидМаркируемойПродукции)

	ДопустимыеСпособыВводаВОборот = Новый Массив;
	
	Попытка
		ВидОперации = Неопределено;
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.МаркировкаТоваровИСМП") Тогда
			ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Операция");	
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.МаркировкаТоваровИСМП") Тогда
			ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Ссылка, "Операция");
		КонецЕсли;
		
		Если ВидОперации <> Неопределено Тогда
			СпособВводаВОборот = ИО_ОбщийМодуль("ШтрихкодированиеИСМПКлиентСервер").СпособВводаВОборотСУЗПоВидуОперации(ВидОперации, ВидМаркируемойПродукции);
			
			Если ТипЗнч(СпособВводаВОборот) = Тип("Массив") Тогда
				ДопустимыеСпособыВводаВОборот = СпособВводаВОборот;
			ИначеЕсли ЗначениеЗаполнено(СпособВводаВОборот) Тогда
				ДопустимыеСпособыВводаВОборот.Добавить(СпособВводаВОборот);
			КонецЕсли;			
		КонецЕсли;
	Исключение
		ТекстОшибки = "Не удалось получить допустимые способы ввода в оборот, документ: " + СокрЛП(Документ);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИО_ДопустимыеСпособыВводаВОборот", "Ошибка", ТекстОшибки);
	КонецПопытки;	

	Возврат ДопустимыеСпособыВводаВОборот;
	
КонецФункции

// ШтрихкодированиеИСМПКлиентСервер
// ШтрихкодированиеМОТПКлиентСервер
Функция ИО_ДопустимыеСтатусыКодовМаркировки(ТипМаркировки)
	
	ДопустимыеСтатусыКодовМаркировки = Новый Массив();
	
	Если ТипМаркировки = "ИСМП" Тогда
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Эмитирован"));
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотПриВозврате"));
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Неопределен"));
	ИначеЕсли ТипМаркировки = "МОТП" Тогда 
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Нанесен"));
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.НанесенОплачен"));
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.НанесенНеОплачен"));
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Эмитирован"));
		// Для поддержки новых упаковок
		ДопустимыеСтатусыКодовМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Неопределен"));
	КонецЕсли;
	
	Возврат ДопустимыеСтатусыКодовМаркировки;
	
КонецФункции

// ШтрихкодированиеИСМПКлиентСервер
// ШтрихкодированиеМОТПКлиентСервер
Функция ИО_ДопустимыеСтатусыУпаковок(ТипМаркировки)
	
	ДопустимыеСтатусыУпаковок = Новый Массив();
	
	Если ТипМаркировки = "ИСМП" Тогда
	
	ИначеЕсли ТипМаркировки = "МОТП" Тогда 
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.ВведенВОборот"));
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.ВведенВОборотВозвращен"));
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Эмитирован"));
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Нанесен"));
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.НанесенОплачен"));
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.НанесенНеОплачен"));
		// Для поддержки новых упаковок
		ДопустимыеСтатусыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Неопределен"));
	КонецЕсли;
	
	Возврат ДопустимыеСтатусыУпаковок;
	
КонецФункции

// ШтрихкодированиеИСМПКлиентСервер
// ШтрихкодированиеМОТПКлиентСервер
Функция ИО_ДопустимыеСтатусыНаборов(ТипМаркировки, Документ)
	
	ДопустимыеСтатусыНаборов = Неопределено;
	
	Если ТипМаркировки = "ИСМП" Тогда
	
	ИначеЕсли ТипМаркировки = "МОТП" Тогда 
		Операция = Неопределено;
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.МаркировкаТоваровИСМП") Тогда
			Операция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Операция");
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.МаркировкаТоваровИСМП") Тогда
			Операция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Ссылка, "Операция");
		КонецЕсли;
		
		Попытка
			ОперацияНанесенияТолькоДляНаборов = Ложь;
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.МаркировкаТоваровИСМП") Тогда
				ОперацияНанесенияТолькоДляНаборов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ОперацияНанесенияТолькоДляНаборов");
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.МаркировкаТоваровИСМП") Тогда
				ОперацияНанесенияТолькоДляНаборов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Ссылка, "ОперацияНанесенияТолькоДляНаборов");
			КонецЕсли;
		Исключение
			ОперацияНанесенияТолькоДляНаборов = Ложь;
		КонецПопытки;
		
		Если ОперацияНанесенияТолькоДляНаборов = Истина ИЛИ Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.Агрегация") Тогда
			ДопустимыеСтатусыНаборов = Новый Массив;
			ДопустимыеСтатусыНаборов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Эмитирован"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДопустимыеСтатусыНаборов;
	
КонецФункции

Функция ИО_НастройкиРазбораКодаМаркировки(ВидыПродукции)

	ИмяСобытия = "ИО_НастройкиРазбораКодаМаркировки";
	
	Попытка
		Возврат ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебный").НастройкиРазбораКодаМаркировки(ВидыПродукции);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Возврат ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебный").НастройкиРазбораКодаМаркировки(Истина, ВидыПродукции);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Неопределено;

КонецФункции

Функция ИО_РазобратьКодМаркировки(Знач ДанныеДляРазбора, ВидыПродукции = Неопределено, ПримечаниеКРезультатуРазбора = Неопределено, НастройкиРазбораКМ = Неопределено)
	
	ИмяСобытия = "ИО_РазобратьКодМаркировки";
	
	Если НастройкиРазбораКМ = Неопределено Тогда
		НастройкиРазбораКМ = ИО_НастройкиРазбораКодаМаркировки(ВидыПродукции);
	КонецЕсли;
	
	Попытка
		Возврат ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебный").РазобратьКодМаркировки(ДанныеДляРазбора, ВидыПродукции, ПримечаниеКРезультатуРазбора, НастройкиРазбораКМ);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Возврат ИО_ОбщийМодуль("ШтрихкодированиеИССлужебный").РазобратьКодМаркировки(ДанныеДляРазбора, ВидыПродукции);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Неопределено;

КонецФункции

Функция ИО_НоваяСтруктураОбработкиШтрихкода(КодМаркировки = Неопределено, ВидПродукции = Неопределено, ПроверятьАлфавитЭлементов = Истина) Экспорт
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("Штрихкод");
	СтруктураЗначения.Вставить("ТипШтрихкода");
	СтруктураЗначения.Вставить("ВидПродукции");
	СтруктураЗначения.Вставить("ВидУпаковки");
	СтруктураЗначения.Вставить("GTIN");
	
	СтруктураЗначения.Вставить("НаименованиеВладельца");
	СтруктураЗначения.Вставить("НаименованиеПродукции");
	СтруктураЗначения.Вставить("СоставКодаМаркировки");
	СтруктураЗначения.Вставить("ДанныеРазбора");

	// Для поиска КМ без учета МРЦ
	СтруктураЗначения.Вставить("НормализованныйШтрихкод", "");
	СтруктураЗначения.Вставить("ХэшСуммаНормализации", "");
	
	Если ЗначениеЗаполнено(ВидПродукции) Тогда
		СтруктураЗначения.ВидПродукции = ВидПродукции;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодМаркировки) Тогда
		ПримечаниеКРезультатуРазбора = Неопределено;
		//ДанныеРазбора = РазборКодаМаркировкиИССлужебный.РазобратьКодМаркировки(
		//	КодМаркировки, ВидПродукции, ПримечаниеКРезультатуРазбора, Неопределено, ПроверятьАлфавитЭлементов);
		ДанныеРазбора = ИО_РазобратьКодМаркировки(КодМаркировки, ВидПродукции, ПримечаниеКРезультатуРазбора);
		Если ДанныеРазбора = Неопределено Тогда
			ТекстОшибки = ?(ПримечаниеКРезультатуРазбора = Неопределено, "", ПримечаниеКРезультатуРазбора.ТекстОшибки);
			ТекстИсключения = "Не удалось разобрать код маркировки: " +
				СтрЗаменить(КодМаркировки, Символ(29), "<GS>") + Символы.ПС + "|" +
				ТекстОшибки;
				
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		
		СтруктураЗначения.Штрихкод                = ДанныеРазбора.НормализованныйКодМаркировки;
		СтруктураЗначения.НормализованныйШтрихкод = ДанныеРазбора.НормализованныйКодМаркировки;
		СтруктураЗначения.ТипШтрихкода            = ДанныеРазбора.ТипШтрихкода;
		СтруктураЗначения.ВидУпаковки             = ДанныеРазбора.ВидУпаковки;
		СтруктураЗначения.СоставКодаМаркировки    = ДанныеРазбора.СоставКодаМаркировки;
		
		Если ДанныеРазбора.СоставКодаМаркировки.Свойство("GTIN") Тогда
			СтруктураЗначения.GTIN = ДанныеРазбора.СоставКодаМаркировки.GTIN;
		КонецЕсли;
		
		СтруктураЗначения.ДанныеРазбора = ДанныеРазбора;
		
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции

Функция ИО_ЭтоДокументПриобретения(ДокументОбъект, ФлагиТипаДокумента)
	
	// см. ПроверкаИПодборПродукцииИСМПКлиентСервер.ЭтоДокументПриобретения(...)
	
	ЭтоВозвратОтРозничногоКлиента = Ложь;
	Если ФлагиТипаДокумента.ВозвратОтКлиента
		И ЗначениеЗаполнено(ДокументОбъект.Партнер) Тогда
		Попытка
			ЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Партнер, "ЮрФизЛицо");
			Если ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.КомпанияЧастноеЛицо.ЧастноеЛицо") Тогда
				ЭтоВозвратОтРозничногоКлиента = Истина;
			КонецЕсли;
		Исключение
			ЭтоВозвратОтРозничногоКлиента = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	ЭтоДокументПриобретения = ФлагиТипаДокумента.ПоступлениеТУ
		ИЛИ ФлагиТипаДокумента.ПриемкаИСМП
		ИЛИ ФлагиТипаДокумента.ВозвратОтКлиента И НЕ ЭтоВозвратОтРозничногоКлиента;
	
	Возврат ЭтоДокументПриобретения;
	
КонецФункции

Функция ТипШтрихкода(ПараметрыШтрихкода)
	
	ТипШтрихкода = Неопределено;
	
	ЗначениеШтрихкода = ПараметрыШтрихкода.ЗначениеШтрихкода;
	
	Если ПараметрыШтрихкода.Свойство("ВидПродукции") И ЗначениеЗаполнено(ПараметрыШтрихкода.ВидПродукции) Тогда
		ВидПродукции = ПараметрыШтрихкода.ВидПродукции;
	Иначе
		Если Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления.Найти("Обувь") <> Неопределено Тогда 
			ВидПродукцииОбувь = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Обувь");
		Иначе
			ВидПродукцииОбувь = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Обувная");
		КонецЕсли;		
		
		ВидПродукции = ВидПродукцииОбувь;
	КонецЕсли;
	
	ДанныеРазбора = ИО_РазобратьКодМаркировки(ЗначениеШтрихкода, ВидПродукции);
	Если ТипЗнч(ДанныеРазбора) = Тип("Структура") И ДанныеРазбора.Свойство("ТипШтрихкода") Тогда
		ТипШтрихкода = ДанныеРазбора.ТипШтрихкода;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипШтрихкода) Тогда	
		Попытка      	
			//ТипШтрихкода = Вычислить("ШтрихкодированиеИС.ОпределитьТипШтрихкода(ЗначениеШтрихкода, Перечисления.ТипыУпаковок.МультитоварнаяУпаковка)");
			ТипШтрихкода = ИО_ОбщийМодуль("ШтрихкодированиеИС").ОпределитьТипШтрихкода(ЗначениеШтрихкода, Перечисления.ТипыУпаковок.МультитоварнаяУпаковка);
		Исключение
			ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.SSCC");
		КонецПопытки;
	КонецЕсли;
	
	Возврат ТипШтрихкода;
	
КонецФункции

Процедура ИСМП_ЗаполнитьСлужебныеРеквизитыСтроки(СтрокаДерева, ВидМаркированнойПродукции, ПараметрыНормализацииКМ, НастройкиРазбораКМ, ТипМаркировки = "ИСМП")
	
	ИмяСобытия = "ИСМП_ЗаполнитьСлужебныеРеквизитыСтроки";
	
	ЗначениеШтрихкода = СтрокаДерева.Штрихкод;
	Если НЕ ЗначениеЗаполнено(ЗначениеШтрихкода) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьКолонка_ТипШтрихкода			= ИО_ОбщийМодуль("ОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДерева, "ТипШтрихкода");
	ЕстьКолонка_НормализованныйШтрихкод = ИО_ОбщийМодуль("ОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДерева, "НормализованныйШтрихкод");
	ЕстьКолонка_ХешСуммаНормализации	= ИО_ОбщийМодуль("ОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДерева, "ХешСуммаНормализации");
	
	ДанныеРазбора = ИО_РазобратьКодМаркировки(ЗначениеШтрихкода, ВидМаркированнойПродукции,, НастройкиРазбораКМ);
	Если НЕ ТипЗнч(ДанныеРазбора) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьКолонка_ТипШтрихкода Тогда
		
		ТипШтрихкода = Неопределено;
		
		Если ДанныеРазбора.Свойство("ТипШтрихкода") Тогда
			ТипШтрихкода = ДанныеРазбора.ТипШтрихкода;
		КонецЕсли;
			
		Если НЕ ЗначениеЗаполнено(ТипШтрихкода) Тогда	
			Попытка      	
				ТипШтрихкода = ИО_ОбщийМодуль("ШтрихкодированиеИС").ОпределитьТипШтрихкода(ЗначениеШтрихкода, ПредопределенноеЗначение("Перечисления.ТипыУпаковок.МультитоварнаяУпаковка"));
			Исключение		
				ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.SSCC");
			КонецПопытки;
		КонецЕсли;	
		
		СтрокаДерева.ТипШтрихкода = ТипШтрихкода;
		
	КонецЕсли;
	
	Если ЕстьКолонка_НормализованныйШтрихкод
		И ЕстьКолонка_ХешСуммаНормализации Тогда
		
		Попытка
			ПрисутствуетПродукцияИСМП = ШтрихкодированиеИС_ПрисутствуетПродукцияИСМП(ДанныеРазбора.ВидыПродукции, Истина);
		Исключение
			ПрисутствуетПродукцияИСМП = Неопределено;
		КонецПопытки;
		
		Попытка	
			Если ПрисутствуетПродукцияИСМП = Неопределено И ТипМаркировки = "МОТП" Тогда
				ПрисутствуетПродукцияИСМП = ШтрихкодированиеИС_ПрисутствуетТабачнаяПродукция(ДанныеРазбора.ВидыПродукции);
			КонецЕсли;
			
			// см. ШтрихкодированиеМОТП.РассчитатьХэшСуммуНормализации
			Если ПрисутствуетПродукцияИСМП = Истина Тогда
				Если ДанныеРазбора.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская")
					Или ШтрихкодированиеИСКлиентСервер_ВозможнаГрупповаяУпаковкаИлиНабор(
						ДанныеРазбора.ВидУпаковки, ДанныеРазбора) Тогда
					
					НормализованныйШтрихкод = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер").НормализоватьКодМаркировки(
						ДанныеРазбора, ВидМаркированнойПродукции, ПараметрыНормализацииКМ);
					
					СтрокаДерева.НормализованныйШтрихкод = НормализованныйШтрихкод;
					СтрокаДерева.ХешСуммаНормализации = ИнтеграцияИС_ХэшСуммаСтроки(СтрокаДерева.НормализованныйШтрихкод);
					
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеРазбора.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая")
				И ДанныеРазбора.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.GS1_128") Тогда
				
				ПараметрыНормализацииКМ.ИмяСвойстваКодМаркировки = "КодМаркировки";
				
				СтрокаДерева.НормализованныйШтрихкод = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер").НормализоватьКодМаркировки(
					ДанныеРазбора, ВидМаркированнойПродукции, ПараметрыНормализацииКМ);
				СтрокаДерева.ХешСуммаНормализации = ИнтеграцияИС_ХэшСуммаСтроки(СтрокаДерева.НормализованныйШтрихкод);
				
			КонецЕсли;
		Исключение			
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукцииОбъект, СоответствиеПараметров, ВидМаркируемойПродукции)
	
	ТребуетсяПереименованиеКолонок = Ложь;
	Попытка
		КолонкиДерева = Обработки["РезультатыСверкиКодовМаркировкиТОРГ2"].ДеревоМаркированнойПродукции().Колонки; // Временное решение для проверки новых колонок
		Если КолонкиДерева.Найти("КоличествоПодчиненныхПотребительскихУпаковок") <> Неопределено Тогда
			ТребуетсяПереименованиеКолонок = Истина;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	Если ТребуетсяПереименованиеКолонок Тогда
		ИСМП_ПереименоватьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект);
    КонецЕсли;
	
	ИСМП_ИзменитьТипУпаковкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект);
	ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект, СоответствиеПараметров, ВидМаркируемойПродукции, ТребуетсяПереименованиеКолонок);

КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ПереименоватьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект)
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"КоличествоПодчиненнойПродукции", "КоличествоПодчиненныхПотребительскихУпаковок"));
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"Скоропортящаяся", "СкоропортящаясяПродукция"));
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"ХэшСуммаНормализации", "ХешСуммаНормализации"));

	Для Каждого ДанныеКолонки Из ИменаКолонок Цикл
		Колонка = ДеревоМаркированнойПродукцииОбъект.Колонки.Найти(ДанныеКолонки.ИмяКолонкиСтарое);
		Если Колонка <> Неопределено Тогда
			Колонка.Имя = ДанныеКолонки.ИмяКолонкиНовое;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ИзменитьТипУпаковкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект)

	Если ДеревоМаркированнойПродукцииОбъект.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТипУпаковкиПотребительскиеУпаковкиБезУпаковки = ИСМП_ТипУпаковкиПотребительскиеУпаковкиБезУпаковки();
	
	Если ДеревоМаркированнойПродукцииОбъект.Строки[0].ТипУпаковки = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].ПродукцияБезУпаковки Тогда
		Если ЗначениеЗаполнено(ТипУпаковкиПотребительскиеУпаковкиБезУпаковки) Тогда
			ДеревоМаркированнойПродукцииОбъект.Строки[0].ТипУпаковки = ТипУпаковкиПотребительскиеУпаковкиБезУпаковки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Функция ИСМП_ТипУпаковкиПотребительскиеУпаковкиБезУпаковки()

	ТипУпаковки = Неопределено;
	
	Попытка
		ТипУпаковки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ТипУпаковкиПотребительскиеУпаковкиБезУпаковки();
	Исключение
	КонецПопытки;
	       
	Возврат ТипУпаковки;		
	
КонецФункции

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект, СоответствиеПараметров, ВидМаркируемойПродукции, ТребуетсяПереименованиеКолонок)
	
	// Адаптация старого формата дерева упаковок
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата   = Новый ОписаниеТипов("Дата");
	ТипЧисло  = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	МетаданныеОпределяемыеТипы  = Метаданные.ОпределяемыеТипы;
	МетаданныеПеречисления		= Метаданные.Перечисления;
	
	ИмяКолонкиХешСуммаНормализации 		= ?(ТребуетсяПереименованиеКолонок, "ХешСуммаНормализации", 	"ХэшСуммаНормализации");
	ИмяКолонкиСкоропортящаясяПродукция  = ?(ТребуетсяПереименованиеКолонок, "СкоропортящаясяПродукция", "Скоропортящаяся");
    
	Коллекция = Новый Массив;
	Если МетаданныеОпределяемыеТипы.Найти("ИдентификаторПроисхожденияВЕТИС") <> Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ИдентификаторПроисхожденияВЕТИС",              Метаданные.ОпределяемыеТипы.ИдентификаторПроисхожденияВЕТИС.Тип);
	КонецЕсли;
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ГоденДо",                                          ТипДата);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, ИмяКолонкиСкоропортящаясяПродукция,                 ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ПредставлениеСодержимогоДоСопоставления",          ТипСтрока);
	Если МетаданныеПеречисления.Найти("ТипыШтрихкодов") <> Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ТипШтрихкода",                                 Новый ОписаниеТипов("ПеречислениеСсылка.ТипыШтрихкодов"));
	КонецЕсли;
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, ИмяКолонкиХешСуммаНормализации,                     ТипСтрока);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "НормализованныйШтрихкод",                          ТипСтрока,                                                "ЗаполнениеКолонкиНормализованныйШтрихкод");
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "Коэффициент",                                      ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ТекстОшибкиПроверкиСредствамиККТ",                 ТипСтрока);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "СостояниеТребованияПолногоКодаККТ",                ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПодчиненныхГрупповыхУпаковок",           ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "НеПересчитыватьКоличествоПотребительскихУпаковок", ТипБулево);
	Если МетаданныеПеречисления.Найти("ВидыУпаковокИС") <> Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ВидУпаковки",                                  Новый ОписаниеТипов("ПеречислениеСсылка.ВидыУпаковокИС"), "ЗаполнениеКолонкиВидУпаковки");
	КонецЕсли;
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "Количество",                                       ТипЧисло,                                                 "ЗаполнениеКолонкиКоличество");
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ПроизвольнаяЕдиницаУчета",                         ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ТребуетВзвешивания",                               ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ИННАгента",                                        ТипСтрока);
	Если МетаданныеПеречисления.Найти("СпособыВводаВОборотСУЗ") <> Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "СпособВводаВОборот",                           Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВводаВОборотСУЗ"));
	КонецЕсли;
	
	ТипЧастичноеВыбытиеВариантУчета = Неопределено;	
	Если Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИСМП") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИСМП");
	ИначеЕсли Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИС") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИС");
	КонецЕсли;
	
	Если НЕ ТипЧастичноеВыбытиеВариантУчета = Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытие",                             ТипБулево);
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытиеВариантУчета",                 ТипЧастичноеВыбытиеВариантУчета);
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытиеНоменклатура",                 Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытиеХарактеристика",               Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	КонецЕсли;
	
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ПлановоеКоличествоПотребительскихУпаковок",        ТипЧисло,                                                 "ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковок");
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ТекстОбработанСОшибкойВГИСМТ",                     ТипСтрока);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ОбработанСОшибкойВГИСМТ",                          ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ОбъемноСортовойУчет",                              ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "СтатусRFID",                              		 ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ДатаПроизводства",                                 ТипДата);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ДатаВводаВОборот",                                 ТипДата);
	
	Если Метаданные.ОпределяемыеТипы.Найти("УникальныйИдентификаторИС") <> Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "РазрешительныйРежимИдентификаторЗапросаГИСМТ", Метаданные.ОпределяемыеТипы.УникальныйИдентификаторИС.Тип);
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "РазрешительныйРежимДатаЗапросаГИСМТ",          ТипСтрока);
	Иначе
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ИдентификаторЗапросаГИСМТ",					 ТипСтрока);
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ДатаВремяПолученияИдентификатора",			 Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КонецЕсли;
	
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ОрганыБлокировкиКМ",                               ТипСтрока);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ПродажаПоДаннымОффлайнРежима",		 			 ТипБулево);
	
	Для Каждого Элемент Из Коллекция Цикл
		
		Если ДеревоМаркированнойПродукцииОбъект.Колонки.Найти(Элемент.ИмяКолонки) = Неопределено Тогда
			ДеревоМаркированнойПродукцииОбъект.Колонки.Добавить(Элемент.ИмяКолонки, Элемент.Тип);
			ИСМП_ВыполнитьДействиеПриВосстановленииКоллекции(ДеревоМаркированнойПродукцииОбъект, Элемент.Действие, СоответствиеПараметров, ВидМаркируемойПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ДополнитьОписаниеКолонок(Коллекция, Имя, Тип, Действие = Неопределено)
	Коллекция.Добавить(
		Новый Структура("ИмяКолонки, Тип, Действие", Имя, Тип, Действие));
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ВыполнитьДействиеПриВосстановленииКоллекции(КоллекцияОбъект, Действие, СоответствиеПараметров, ВидМаркируемойПродукции)
	
	Если Действие = Неопределено Тогда
		Возврат;
    КонецЕсли;
	
	Если Действие = "ЗаполнениеКолонкиВидУпаковки" Тогда
		
		ИСМП_ЗаполнениеКолонкиВидУпаковкиПриВосстановленииДерева(КоллекцияОбъект.Строки);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиНормализованныйШтрихкод" Тогда
		
		ИСМП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(КоллекцияОбъект.Строки, ВидМаркируемойПродукции);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиКоличество" Тогда
		
		ИСМП_ЗаполнениеКолонкиКоличествоПриВосстановленииДерева(КоллекцияОбъект.Строки);
	
	ИначеЕсли Действие = "ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковок" Тогда
		
		ИСМП_ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковокПриВосстановленииДерева(КоллекцияОбъект.Строки);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиКоличествоПотребительскихУпаковок" Тогда
		
		ИСМП_ЗаполнениеКолонкиКоличествоПотребительскихУпаковок(КоллекцияОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ЗаполнениеКолонкиВидУпаковкиПриВосстановленииДерева(КоллекцияСтрок)

	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл

		Если СтрокаДерева.ТипУпаковки = ИСМП_ТипУпаковкиПотребительскиеУпаковкиБезУпаковки() Тогда
			Если СтрокаДерева.Строки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

        Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
			СтрокаДерева.ВидУпаковки = Перечисления["ВидыУпаковокИС"].Логистическая;
		Иначе
			СтрокаДерева.ВидУпаковки = Перечисления["ВидыУпаковокИС"].Потребительская;
		КонецЕсли;

		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			ИСМП_ЗаполнениеКолонкиВидУпаковкиПриВосстановленииДерева(СтрокаДерева.Строки);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(КоллекцияСтрок, ВидМаркируемойПродукции)
	
	ИмяСобытия = "ИСМП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева";
	
	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл
		
		ШтрихкодНормализован = Истина;
		Попытка
			СтрокаДерева.НормализованныйШтрихкод = ИО_ОбщийМодуль("ШтрихкодированиеМОТП").НормализованныйШтрихкод(СтрокаДерева.Штрихкод, ВидМаркируемойПродукции);
		Исключение
			ШтрихкодНормализован = Ложь;	
		КонецПопытки;
		
		Если НЕ ШтрихкодНормализован Тогда
			Попытка
				СтрокаДерева.НормализованныйШтрихкод = ИО_ОбщийМодуль("ШтрихкодированиеМОТП").НормализованныйШтрихкод(СтрокаДерева.Штрихкод);
			Исключение
				СтрокаДерева.НормализованныйШтрихкод = СтрокаДерева.Штрихкод;
				
				Если ЗначениеЗаполнено(СтрокаДерева.Штрихкод) Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Не удалось нормализовать штрихкод: " + СтрокаДерева.Штрихкод);
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			ИСМП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(СтрокаДерева.Строки, ВидМаркируемойПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ЗаполнениеКолонкиКоличествоПриВосстановленииДерева(КоллекцияСтрок)
	
	Для Каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
		Если ЗначениеЗаполнено(СтрокаКоллекции.ВидУпаковки) Тогда
			Если СтрокаКоллекции.ВидУпаковки = Перечисления["ВидыУпаковокИС"].Потребительская Тогда
				СтрокаКоллекции.Количество = 1;
			Иначе
				СтрокаКоллекции.Количество = СтрокаКоллекции.КоличествоПодчиненныхПотребительскихУпаковок;
			КонецЕсли;
		КонецЕсли;
		ИСМП_ЗаполнениеКолонкиКоличествоПриВосстановленииДерева(СтрокаКоллекции.Строки);
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ЗаполнениеКолонкиКоличествоПотребительскихУпаковок(КоллекцияСтрок)
	
	Для Каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
		СтрокаКоллекции.КоличествоПотребительскихУпаковок = СтрокаКоллекции.КоличествоПодобрано;
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковокПриВосстановленииДерева(КоллекцияСтрок)
	
	Для Каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
		СтрокаКоллекции.ПлановоеКоличествоПотребительскихУпаковок = СтрокаКоллекции.Коэффициент;
		ИСМП_ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковокПриВосстановленииДерева(СтрокаКоллекции.Строки);
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукцияОбъект, СоответствиеПараметров, ВидМаркируемойПродукции)
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата   = Новый ОписаниеТипов("Дата");
	ТипЧисло  = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТребуетсяПереименованиеКолонок = Ложь;
	Попытка
		КолонкиДерева = Обработки["РезультатыСверкиКодовМаркировкиТОРГ2"].ДеревоМаркированнойПродукции().Колонки; // Временное решение для проверки новых колонок
		Если КолонкиДерева.Найти("КоличествоПодчиненныхПотребительскихУпаковок") <> Неопределено Тогда
			ТребуетсяПереименованиеКолонок = Истина;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	ИмяКолонкиСкоропортящаясяПродукция = ?(ТребуетсяПереименованиеКолонок, "СкоропортящаясяПродукция", "Скоропортящаяся");
	
	Коллекция = Новый Массив;
	Если Метаданные.ОпределяемыеТипы.Найти("ИдентификаторПроисхожденияВЕТИС") <> Неопределено Тогда
		ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ИдентификаторПроисхожденияВЕТИС",                   Метаданные.ОпределяемыеТипы.ИдентификаторПроисхожденияВЕТИС.Тип);
	КонецЕсли;
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ГоденДо",                                               ТипДата);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, ИмяКолонкиСкоропортящаясяПродукция,                      ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ПредставлениеGTIN",                                     ТипСтрока);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КодыGTIN",                                              Новый ОписаниеТипов("СписокЗначений"));
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "НоменклатураСопоставленаПоУПД",                         ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковок",                     ТипЧисло, "ЗаполнениеКолонкиКоличествоПотребительскихУпаковок");
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковокВСтруктуреУпаковок",   ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ПроизвольнаяЕдиницаУчета",                              ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "ТребуетВзвешивания",                                    ТипБулево);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковокТребующихВзвешивания", ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПодобраноВзвешено",                           ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПодобраноВзвешеноОСУ",                        ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковокОСУ",                  ТипЧисло);
	ИСМП_ДополнитьОписаниеКолонок(Коллекция, "СтрокиМаркируемаяПродукция",      					  Новый ОписаниеТипов("Массив"));
	
	Для Каждого Элемент Из Коллекция Цикл
		
		Если ПодобраннаяМаркируемаяПродукцияОбъект.Колонки.Найти(Элемент.ИмяКолонки) = Неопределено Тогда
			ПодобраннаяМаркируемаяПродукцияОбъект.Колонки.Добавить(Элемент.ИмяКолонки, Элемент.Тип);
			ИСМП_ВыполнитьДействиеПриВосстановленииКоллекции(ПодобраннаяМаркируемаяПродукцияОбъект, Элемент.Действие, СоответствиеПараметров, ВидМаркируемойПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
	// Удаление колонок, добавленных по ошибке в релизах до 1.1.13
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить("ИННАгента");
	ИменаКолонок.Добавить("СпособВводаВОборот");
	
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		Колонка = ПодобраннаяМаркируемаяПродукцияОбъект.Колонки.Найти(ИмяКолонки);
		Если Колонка <> Неопределено Тогда
			ПодобраннаяМаркируемаяПродукцияОбъект.Колонки.Удалить(Колонка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукцииОбъект, ВидМаркируемойПродукции, СоответствиеПараметров)
	
	// Выполняем адаптацию старого формата
	
	ТребуетсяПереименованиеКолонок = Ложь;
	Попытка
		КолонкиДерева = Обработки["РезультатыСверкиКодовМаркировкиТОРГ2"].ДеревоМаркированнойПродукции().Колонки; // Временное решение для проверки новых колонок
		Если КолонкиДерева.Найти("КоличествоПодчиненныхПотребительскихУпаковок") <> Неопределено Тогда
			ТребуетсяПереименованиеКолонок = Истина;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	Если ТребуетсяПереименованиеКолонок Тогда 
		МОТП_ПереименоватьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект);
	КонецЕсли;
	
	МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект, ВидМаркируемойПродукции, СоответствиеПараметров, ТребуетсяПереименованиеКолонок);
	
КонецПроцедуры

Процедура МОТП_ПереименоватьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект)
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"КоличествоПодчиненныхПачек", "КоличествоПодчиненныхПотребительскихУпаковок"));
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"КоличествоПодчиненныхБлоков", "КоличествоПодчиненныхГрупповыхУпаковок"));
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"НеПересчитыватьКоличествоПачек", "НеПересчитыватьКоличествоПотребительскихУпаковок"));
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"Скоропортящаяся", "СкоропортящаясяПродукция"));
	ИменаКолонок.Добавить(
		Новый Структура("ИмяКолонкиСтарое, ИмяКолонкиНовое",
			"ХэшСуммаНормализации", "ХешСуммаНормализации"));

	Для Каждого ДанныеКолонки Из ИменаКолонок Цикл
		Колонка = ДеревоМаркированнойПродукцииОбъект.Колонки.Найти(ДанныеКолонки.ИмяКолонкиСтарое);
		Если Колонка <> Неопределено Тогда
			Колонка.Имя = ДанныеКолонки.ИмяКолонкиНовое;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДерева(ДеревоМаркированнойПродукцииОбъект, ВидМаркируемойПродукции, СоответствиеПараметров, ТребуетсяПереименованиеКолонок)
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло  = Новый ОписаниеТипов("Число");
	ТипДата   = Новый ОписаниеТипов("Дата");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ИмяКолонкиХешСуммаНормализации = ?(ТребуетсяПереименованиеКолонок, "ХешСуммаНормализации", "ХэшСуммаНормализации");

    Коллекция = Новый Массив;
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ПредставлениеСодержимогоДоСопоставления",   ТипСтрока);
	Если Метаданные.Перечисления.Найти("ВидыУпаковокИС") <> Неопределено Тогда
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ВидУпаковки",							  Новый ОписаниеТипов("ПеречислениеСсылка.ВидыУпаковокИС"), "ЗаполнениеКолонкиВидУпаковки");
	КонецЕсли;
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ТипШтрихкода",                              Новый ОписаниеТипов("ПеречислениеСсылка.ТипыШтрихкодов"));
	МОТП_ДополнитьОписаниеКолонок(Коллекция, ИмяКолонкиХешСуммаНормализации,              ТипСтрока);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ДатаПроизводства",                          ТипДата);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ВСеройЗоне",                                ТипБулево);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "НормализованныйШтрихкод",                   ТипСтрока,                                                "ЗаполнениеКолонкиНормализованныйШтрихкод");
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "Коэффициент",                               ТипЧисло);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ВключаетМРЦ",                               ТипБулево,                                                "ЗаполнениеКолонкиВключаетМРЦ");
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ТекстОшибкиПроверкиСредствамиККТ",          ТипСтрока);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "СостояниеТребованияПолногоКодаККТ",         ТипЧисло);
	
	ТипЧастичноеВыбытиеВариантУчета = Неопределено;	
	Если Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИСМП") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИСМП");
	ИначеЕсли Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИС") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИС");
	КонецЕсли;
	
	Если НЕ ТипЧастичноеВыбытиеВариантУчета = Неопределено Тогда
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытие",                      ТипБулево);
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытиеВариантУчета",          ТипЧастичноеВыбытиеВариантУчета);
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытиеНоменклатура",          Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ЧастичноеВыбытиеХарактеристика",        Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	КонецЕсли;
		
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "Количество",                                ТипЧисло,                                                 "ЗаполнениеКолонкиКоличество");
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ПроизвольнаяЕдиницаУчета",                  ТипБулево);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ПлановоеКоличествоПотребительскихУпаковок", ТипЧисло,                                                 "ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковок");
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ТекстОбработанСОшибкойВГИСМТ",              ТипСтрока);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ОбработанСОшибкойВГИСМТ",                   ТипБулево);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ИННПроизводителя",						  ТипСтрока);
	
	Если Метаданные.ОпределяемыеТипы.Найти("УникальныйИдентификаторИС") <> Неопределено Тогда
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "РазрешительныйРежимИдентификаторЗапросаГИСМТ", Метаданные.ОпределяемыеТипы.УникальныйИдентификаторИС.Тип);
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "РазрешительныйРежимДатаЗапросаГИСМТ",          ТипСтрока);
	Иначе
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ИдентификаторЗапросаГИСМТ",					 ТипСтрока);
		МОТП_ДополнитьОписаниеКолонок(Коллекция, "ДатаВремяПолученияИдентификатора",			 Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КонецЕсли;
	
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ОрганыБлокировкиКМ",						  ТипСтрока);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ПродажаПоДаннымОффлайнРежима",		 	  ТипБулево);
	
	Для Каждого Элемент Из Коллекция Цикл
		
		Если ДеревоМаркированнойПродукцииОбъект.Колонки.Найти(Элемент.ИмяКолонки) = Неопределено Тогда
			ДеревоМаркированнойПродукцииОбъект.Колонки.Добавить(Элемент.ИмяКолонки, Элемент.Тип);
			МОТП_ВыполнитьДействиеПриВосстановленииКоллекции(ДеревоМаркированнойПродукцииОбъект, Элемент.Действие, ВидМаркируемойПродукции, СоответствиеПараметров);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ДополнитьОписаниеКолонок(Коллекция, Имя, Тип, Действие = Неопределено)
	Коллекция.Добавить(
		Новый Структура("ИмяКолонки, Тип, Действие", Имя, Тип, Действие));
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ВыполнитьДействиеПриВосстановленииКоллекции(КоллекцияОбъект, Действие, ВидМаркируемойПродукции, СоответствиеПараметров)
	
	Если Действие = Неопределено Тогда
		Возврат;
    КонецЕсли;
	
	Если Действие = "ЗаполнениеКолонкиВидУпаковки" Тогда
		
		МОТП_ЗаполнениеКолонкиВидУпаковкиПриВосстановленииДерева(КоллекцияОбъект.Строки);
		КоллекцияОбъект.Колонки.Удалить(КоллекцияОбъект.Колонки.ГрупповаяТоварнаяУпаковка);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиНормализованныйШтрихкод" Тогда
		
		МОТП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(КоллекцияОбъект.Строки, ВидМаркируемойПродукции);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиВключаетМРЦ" Тогда
		
		Попытка
			ЭтоТабак = ВидМаркируемойПродукции = Перечисления["ВидыПродукцииИС"].Табак;
		Исключение
			ЭтоТабак = ВидМаркируемойПродукции = Перечисления["ВидыПродукцииИС"].Табачная;
		КонецПопытки;
		
		Если ЭтоТабак Тогда
			
			Если ТипЗнч(КоллекцияОбъект) = Тип("ДеревоЗначений") Тогда
				
				СтрокиДереваСНулевымМРЦ = Новый Массив;
				МОТП_ЗаполнениеКолонкиВключаетМРЦПриВосстановленииДерева(КоллекцияОбъект.Строки, СтрокиДереваСНулевымМРЦ, ВидМаркируемойПродукции);
				
				Если СтрокиДереваСНулевымМРЦ.Количество() > 0 Тогда
					СоответствиеПараметров["СтрокиДереваСНулевымМРЦ"] = СтрокиДереваСНулевымМРЦ;
				КонецЕсли;
				
			Иначе
				МОТП_ЗаполнениеКолонкиВключаетМРЦПриВосстановленииПодобраннойМаркируемойПродукции(КоллекцияОбъект);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиКоличество" Тогда
		
		МОТП_ЗаполнениеКолонкиКоличествоПриВосстановленииДерева(КоллекцияОбъект.Строки);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковок" Тогда
		
		МОТП_ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковокПриВосстановленииДерева(КоллекцияОбъект.Строки);
		
	ИначеЕсли Действие = "ЗаполнениеКолонкиКоличествоПотребительскихУпаковок" Тогда
		
		МОТП_ЗаполнениеКолонкиКоличествоПотребительскихУпаковок(КоллекцияОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиКоличествоПриВосстановленииДерева(КоллекцияСтрок)
	
	Для Каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
		Если ЗначениеЗаполнено(СтрокаКоллекции.ВидУпаковки) Тогда
			Если СтрокаКоллекции.ВидУпаковки = Перечисления["ВидыУпаковокИС"].Потребительская Тогда
				СтрокаКоллекции.Количество = 1;
			Иначе
				Попытка
					СтрокаКоллекции.Количество = СтрокаКоллекции.КоличествоПодчиненныхПотребительскихУпаковок;
				Исключение
					СтрокаКоллекции.Количество = СтрокаКоллекции.КоличествоПодчиненныхПачек;					
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		МОТП_ЗаполнениеКолонкиКоличествоПриВосстановленииДерева(СтрокаКоллекции.Строки);
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиКоличествоПотребительскихУпаковок(КоллекцияСтрок)
	
	Для Каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
		СтрокаКоллекции.КоличествоПотребительскихУпаковок = СтрокаКоллекции.КоличествоПодобрано;
	КонецЦикла;

КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиПлановоеКоличествоПотребительскихУпаковокПриВосстановленииДерева(КоллекцияСтрок)
	
	Для Каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
