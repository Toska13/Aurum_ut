Процедура УТ_11_2_ЗаполнениеРеквизитовШапкиИзДокументаОснования(СтруктураПараметров) Экспорт

	Перем ПараметрыОснования;
	
	// ТОЛЬКО для нового документа заполняем шапку или из основания, или значениями по умолчанию
	// + табличные части переносим из основания 	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;
	
	Если Док1СРезультат.ЭтоНовый() Тогда
		Попытка
			Если Док1СОснование <> Неопределено И Док1СРезультат <> Док1СОснование Тогда
				Если СтруктураПараметров.Свойство("ПараметрыОснования", ПараметрыОснования) Тогда
					Док1СРезультат.Заполнить(ПараметрыОснования);
				Иначе
					Док1СРезультат.Заполнить(Док1СОснование.Ссылка);
				КонецЕсли;
			Иначе
				Док1СРезультат.Заполнить(Неопределено);
			КонецЕсли;
		Исключение		
			ИнфоОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = "Не удалось выполнить первоначальное заполнение документа: ";
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_2_ЗаполнениеРеквизитовШапкиИзДокументаОснования", "Ошибка", ТекстОшибки + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
			Сообщить(ТекстОшибки + КраткоеПредставлениеОшибки(ИнфоОбОшибке) + ". Подробности об ошибке смотрите в журнале регистрации.");
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Процедура ПроставитьПараметрыУказанияСерийВДокументе(СтруктураПараметров) Экспорт
	Перем ПараметрыУказанияСерий;
	
	Объект 			= СтруктураПараметров.Док1СРезультат;	
	ТипДокумента	= Объект.Метаданные().Имя;
	
	Попытка
		//Выполнить("ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы[ТипДокумента]))");
		ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(ИО_ОбщийМодуль("НоменклатураСервер").ПараметрыУказанияСерий(Объект, Документы[ТипДокумента]));
	Исключение
		ПараметрыУказанияСерий = Неопределено;
	КонецПопытки;
	
	Если Не ТипЗнч(ПараметрыУказанияСерий) = Тип("ФиксированнаяСтруктура") Тогда Возврат; КонецЕсли;
	
	ТипыДокументовИСМП = Новый СписокЗначений;
	ТипыДокументовИСМП.Добавить("ОтгрузкаТоваровИСМП");
	ТипыДокументовИСМП.Добавить("ПриемкаТоваровИСМП");
	ТипыДокументовИСМП.Добавить("ВыводИзОборотаИСМП");
	ТипыДокументовИСМП.Добавить("СписаниеКодовМаркировкиИСМП");
	
	Если ТипыДокументовИСМП.НайтиПоЗначению(ТипДокумента) <> Неопределено Тогда
		ПараметрыУказанияСерий = Новый Структура(ПараметрыУказанияСерий);
	КонецЕсли;
	
	// для некоторых типов документов ПараметрыУказанияСерий состоят из более чем одной части		
	Если ПараметрыУказанияСерий.Свойство("Отбор") И ПараметрыУказанияСерий.Свойство("Размещение") Тогда //ОтборРазмещениеТоваров
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.Отбор)");
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.Размещение)");
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.Отбор);
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.Размещение);
	ИначеЕсли ПараметрыУказанияСерий.Свойство("ТоварыПоРаспоряжениям") И ПараметрыУказанияСерий.Свойство("ОтгружаемыеТовары") Тогда //РасходныйОрдерНаТовары
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.ТоварыПоРаспоряжениям)");
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.ОтгружаемыеТовары)");			
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.ТоварыПоРаспоряжениям);
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.ОтгружаемыеТовары);
	ИначеЕсли ПараметрыУказанияСерий.Свойство("Шапка") Или
		ПараметрыУказанияСерий.Свойство("ТЧ") Тогда
		Если ПараметрыУказанияСерий.Свойство("Шапка") Тогда
			ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий.Шапка);
		КонецЕсли;
		Если ПараметрыУказанияСерий.Свойство("ТЧ") Тогда
			ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий.ТЧ);
		КонецЕсли;
	Иначе
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверкаНаСкладИлиПомещениеИзТСД(СтруктураПараметров) Экспорт

	Док1СРезультат 		= СтруктураПараметров.Док1СРезультат;
	ДокументТСД 		= СтруктураПараметров.ДокументТСД;
	РеквизитыШапки 		= Док1СРезультат.Метаданные().Реквизиты;
	
	//Ключ - 1С, Значение - ТСД
	СоответствиеСкладов1С_ТСД = Новый Соответствие;
	СоответствиеСкладов1С_ТСД.Вставить("Склад", 			"ИдСклада1С");
	СоответствиеСкладов1С_ТСД.Вставить("СкладУпаковки", 	"ИдСклада1С");
	СоответствиеСкладов1С_ТСД.Вставить("СкладПолучатель", 	"ИдСклада1СКуда");
	СоответствиеСкладов1С_ТСД.Вставить("СкладОтправитель", 	"ИдСклада1СОткуда");
	
	Для Каждого КлючИЗначение Из СоответствиеСкладов1С_ТСД Цикл
		Ключ 		= КлючИЗначение.Ключ;
		Значение 	= КлючИЗначение.Значение;
		Если ЕстьРеквизитВКоллекции(РеквизитыШапки, Ключ) И НЕ СсылкаСуществует(Док1СРезультат[Ключ]) Тогда
			Если ДокументТСД.ШапкаДокумента.Свойство(Значение) И Не ПустаяСтрока(ДокументТСД.ШапкаДокумента[Значение]) Тогда				
				Помещение = Справочники["СкладскиеПомещения"].ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументТСД.ШапкаДокумента[Значение]));
				Если СсылкаСуществует(Помещение) Тогда
					Док1СРезультат[Ключ] = Помещение.Владелец;			
					Если ЕстьРеквизитВКоллекции(РеквизитыШапки, "Помещение") Тогда
						Док1СРезультат.Помещение = Помещение;
					КонецЕсли;			
				КонецЕсли;
			КонецЕсли;                                   
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполенениеРеквизитаПартнерПоДаннымКонтрагента(СтруктураПараметров) Экспорт

	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;
	Док1СОснование	= СтруктураПараметров.Док1СОснование;
	РеквизитыШапки 	= Док1СРезультат.Метаданные().Реквизиты;
	
	ТребуетсяПерезаполнитьПартнера = ЕстьРеквизитВКоллекции(РеквизитыШапки, "Контрагент") И ЕстьРеквизитВКоллекции(РеквизитыШапки, "Партнер") 
		И ЗначениеЗаполнено(Док1СРезультат.Контрагент) И (Док1СРезультат.Партнер <> Док1СРезультат.Контрагент.Партнер И Док1СРезультат.Контрагент.Партнер <> Док1СРезультат.Партнер.Родитель);
	
	Если ТребуетсяПерезаполнитьПартнера Тогда	
		// Если в документе-основании заполнено аналогично, перезаполнять не нужно
		Если Док1СОснование <> Неопределено И Док1СРезультат <> Док1СОснование Тогда
			РеквизитыШапкиОснования	= Док1СОснование.Метаданные().Реквизиты;	
			Если ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "Контрагент") И ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "Партнер")
				И Док1СОснование.Контрагент = Док1СРезультат.Контрагент И Док1СОснование.Партнер = Док1СРезультат.Партнер Тогда
				ТребуетсяПерезаполнитьПартнера = Ложь;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
		
	Если ТребуетсяПерезаполнитьПартнера Тогда
		Док1СРезультат.Партнер = Док1СРезультат.Контрагент.Партнер;					
	КонецЕсли;

КонецПроцедуры

Функция УТ_11_4_СтруктураПересчетаСуммыНДСВСтрокеТЧ(Объект)
			
	ИмяСобытия = "УТ_11_4_СтруктураПересчетаСуммыНДСВСтрокеТЧ";
	
	Попытка
		Возврат ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Возврат ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(Объект);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	СтруктураПересчетаСуммы = Новый Структура;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект,"ЦенаВключаетНДС") Тогда
		СтруктураПересчетаСуммы.Вставить("ЦенаВключаетНДС", Объект.ЦенаВключаетНДС);
	Иначе
		СтруктураПересчетаСуммы.Вставить("ЦенаВключаетНДС", Истина);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект,"НалогообложениеНДС") Тогда
		СтруктураПересчетаСуммы.Вставить("НалогообложениеНДС", Объект.НалогообложениеНДС);
	КонецЕсли;	
	
	Возврат СтруктураПересчетаСуммы;
	
КонецФункции

Функция УТ_11_2_ПолучитьТекущуюСтрокуСтруктурой(ТекущаяСтрока, СтруктураДействий)
	
	Перем СтруктураПараметровДействия;

	СтруктураПолейТЧ = Новый Структура;

	Если СтруктураДействий.Свойство("ПроверитьХарактеристикуПоВладельцу") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("ХарактеристикиИспользуются");
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПроверитьХарактеристикуКиЗПоВладельцу") Тогда
		СтруктураПолейТЧ.Вставить("НоменклатураКиЗ");
		СтруктураПолейТЧ.Вставить("ХарактеристикаКиЗ");
		СтруктураПолейТЧ.Вставить("ХарактеристикиКиЗИспользуются");
	КонецЕсли;	
	
	Если СтруктураДействий.Свойство("ПроверитьЗаполнитьУпаковкуПоВладельцу") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Упаковка");
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПроверитьСтатьюАналитикуРасходов") Тогда
		СтруктураПолейТЧ.Вставить("ТипНоменклатуры");
		СтруктураПолейТЧ.Вставить("СтатьяРасходов");
		СтруктураПолейТЧ.Вставить("АналитикаРасходов");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПересчитатьКоличествоЕдиниц")
		Или СтруктураДействий.Свойство("ПересчитатьКоличествоУпаковок") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");		
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок", 0);
		СтруктураПолейТЧ.Вставить("Количество", 0);
	КонецЕсли;

	Если СтруктураДействий.Свойство("ЗаполнитьGTINВСтроке", СтруктураПараметровДействия)  Тогда
		
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("GTIN");
		
	КонецЕсли;	
	
	Суффикс = Неопределено;
	
	Если СтруктураДействий.Свойство("ПересчитатьКоличествоЕдиницСуффикс",Суффикс)
		Или СтруктураДействий.Свойство("ПересчитатьКоличествоУпаковокСуффикс",Суффикс) Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");		
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок"+Суффикс, 0);
		СтруктураПолейТЧ.Вставить("Количество"+Суффикс    , 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПересчитатьКоличествоОтклонение") Тогда
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("КоличествоОтклонение", 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковокОтклонение", 0);
		СтруктураПолейТЧ.Вставить("КоличествоФакт", 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковокФакт", 0);
		СтруктураПолейТЧ.Вставить("Количество", 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок", 0);
	КонецЕсли; 
	
	Если СтруктураДействий.Свойство("ПересчитатьКоличествоУпаковокСуффиксИзОтклонения",Суффикс) Тогда
		СтруктураПолейТЧ.Вставить("КоличествоУпаковокОтклонение", 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок"+Суффикс, 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок"		  , 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПересчитатьВесОбъем",Суффикс) Тогда
		СтруктураПолейТЧ.Вставить("ВесУпаковки", 0);
		СтруктураПолейТЧ.Вставить("ОбъемУпаковки", 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок"+Суффикс, 0);
		СтруктураПолейТЧ.Вставить("Вес", 0);
		СтруктураПолейТЧ.Вставить("Объем", 0);
		СтруктураПолейТЧ.Вставить("ЕдиницаИзмеренияВеса");
		СтруктураПолейТЧ.Вставить("ЕдиницаИзмеренияОбъема");
	КонецЕсли;
	
	Суффикс = Неопределено;
	
	Если СтруктураДействий.Свойство("ПересчитатьКоличествоУпаковокПоВесу",Суффикс)
		Или СтруктураДействий.Свойство("ПересчитатьКоличествоУпаковокПоОбъему",Суффикс) Тогда
		СтруктураПолейТЧ.Вставить("ВесУпаковки", 0);
		СтруктураПолейТЧ.Вставить("ОбъемУпаковки", 0);
		СтруктураПолейТЧ.Вставить("КоличествоУпаковок"+Суффикс, 0);
		СтруктураПолейТЧ.Вставить("Количество"+Суффикс, 0);
		СтруктураПолейТЧ.Вставить("Вес", 0);
		СтруктураПолейТЧ.Вставить("Объем", 0);
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("ЕдиницаИзмеренияВеса");
		СтруктураПолейТЧ.Вставить("ЕдиницаИзмеренияОбъема");
	КонецЕсли;	
	
	Если СтруктураДействий.Свойство("ЗаполнитьЦенуПродажи") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("ВидЦены");
		СтруктураПолейТЧ.Вставить("Цена", 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьЦенуПродажиПоАссортименту") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("ВидЦены");
		СтруктураПолейТЧ.Вставить("Цена", 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьЦенуЗакупки") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("ВидЦеныПоставщика");
		СтруктураПолейТЧ.Вставить("Цена", 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьУсловияЗакупок") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("ВидЦеныПоставщика");
		СтруктураПолейТЧ.Вставить("Цена", 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьНоменклатуруПоНоменклатуреПартнера") Тогда
		СтруктураПолейТЧ.Вставить("НоменклатураПартнера");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("ХарактеристикиИспользуются");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьНоменклатуруПоНоменклатуреПоставщика") Тогда
		СтруктураПолейТЧ.Вставить("НоменклатураПоставщика");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
		СтруктураПолейТЧ.Вставить("ХарактеристикиИспользуются");
	КонецЕсли;

	Если СтруктураДействий.Свойство("ЗаполнитьНоменклатуруПартнераПоНоменклатуре") Тогда
		СтруктураПолейТЧ.Вставить("НоменклатураПартнера");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьНоменклатуруПоставщикаПоНоменклатуре") Тогда
		СтруктураПолейТЧ.Вставить("НоменклатураПоставщика");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПроверитьСопоставленнуюНоменклатуруПартнера") Тогда
		СтруктураПолейТЧ.Вставить("НомерСтроки");
		СтруктураПолейТЧ.Вставить("НоменклатураПартнера");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПроверитьСопоставленнуюНоменклатуруПоставщика") Тогда
		СтруктураПолейТЧ.Вставить("НомерСтроки");
		СтруктураПолейТЧ.Вставить("НоменклатураПоставщика");
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("Упаковка");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьСтавкуНДС")
		 ИЛИ СтруктураДействий.Свойство("ЗаполнитьСтавкуНДСПоНоменклатуре") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("СтавкаНДС");
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ЗаполнитьСтавкуНДСВозвратнойТары") Тогда
		СтруктураПолейТЧ.Вставить("ТипНоменклатуры");
		СтруктураПолейТЧ.Вставить("СтавкаНДС");
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПересчитатьСуммуНДС") Тогда
		СтруктураПолейТЧ.Вставить("Сумма"    , 0);
		СтруктураПолейТЧ.Вставить("СтавкаНДС", 0);
		СтруктураПолейТЧ.Вставить("СуммаНДС" , 0);
	КонецЕсли;
	
	Если СтруктураДействий.Свойство("ПересчитатьСуммуСНДС") Тогда
		СтруктураПолейТЧ.Вставить("Сумма"    , 0);
		СтруктураПолейТЧ.Вставить("СуммаНДС" , 0);
		СтруктураПолейТЧ.Вставить("СуммаСНДС", 0);
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПересчитатьСуммуБезНДС") Тогда
		СтруктураПолейТЧ.Вставить("Сумма"    , 0);
		СтруктураПолейТЧ.Вставить("СуммаНДС" , 0);
		СтруктураПолейТЧ.Вставить("СуммаБезНДС", 0);
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПересчитатьСуммуРегл") Тогда
		СтруктураПолейТЧ.Вставить("СуммаРегл"    , 0);
		СтруктураПолейТЧ.Вставить("СуммаБезНДС", 0);
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПересчитатьНДСРегл") Тогда
		СтруктураПолейТЧ.Вставить("СуммаНДС" , 0);
		СтруктураПолейТЧ.Вставить("НДСРегл", 0);
	КонецЕсли;

	Если СтруктураДействий.Свойство("ПересчитатьСумму") Тогда
		СтруктураПолейТЧ.Вставить("Сумма"             , 0);
		СтруктураПолейТЧ.Вставить("Цена"              , 0);
