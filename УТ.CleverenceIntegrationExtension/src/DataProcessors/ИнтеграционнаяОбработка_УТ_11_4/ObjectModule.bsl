Процедура ДобавитьСтрокиВДеревоИСМП(ДеревоМаркированнойПродукции, ТаблицаМаркированнойПродукции, ТаблицаМаркированнойПродукцииПлана, СтруктураПараметров = Неопределено)

	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;		
	КонецЕсли;
	
	СУчетомВложенныхШК 	= СтруктураПараметров.СУчетомВложенныхШК;
	Детализация 		= СтруктураПараметров.Детализация;
	ЗавершатьПроверку 	= СтруктураПараметров.ЗавершатьПроверку;
	ВидПродукцииИС 		= СтруктураПараметров.ВидПродукцииИС;
	ОбъемноСортовойУчет	= СтруктураПараметров.ОбъемноСортовойУчет;
	ДанныеНаборов		= СтруктураПараметров.ДанныеНаборов;
	
	КолонкиДерева = ДеревоМаркированнойПродукции.Колонки;
	ИмяКолонкиСкоропортящаясяПродукция = ?(КолонкиДерева.Найти("СкоропортящаясяПродукция") <> Неопределено,
		"СкоропортящаясяПродукция", "Скоропортящаяся");
	
	МассивДетализаций = Новый Массив;
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияПродукцииИСМП") <> Неопределено Тогда
		МассивДетализаций.Добавить(ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияПродукцииИСМП.ПотребительскиеУпаковки"));
	КонецЕсли;
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		МассивДетализаций.Добавить(ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки"));
	КонецЕсли;
	
	// Добавим строку продукции без упаковки, если её нет
	СтрокаПродукцияБезУпаковки = Неопределено;
	Если Детализация = Неопределено ИЛИ МассивДетализаций.Найти(Детализация) = Неопределено Тогда
		ЕстьСтрокаПродукцииБезУпаковки = Ложь;
		Для Каждого СтрокаДереваМаркированнойПродукции Из ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].ПродукцияБезУпаковки Тогда
				СтрокаПродукцияБезУпаковки = СтрокаДереваМаркированнойПродукции;
				ЕстьСтрокаПродукцииБезУпаковки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьСтрокаПродукцииБезУпаковки Тогда
			СтрокаПродукцияБезУпаковки = ИСМП_ДобавленнаяСтрокаПродукцияБезУпаковки(ДеревоМаркированнойПродукции, ВидПродукцииИС);	
		КонецЕсли;
	КонецЕсли;
	
	// Групповые упаковки и наборы
	Попытка
		ПоддерживаютсяНаборыИлиГрупповыеУпаковки = ИнтеграцияИСКлиентСерверПовтИсп_ВидПродукцииИспользуетНаборыИлиГрупповыеУпаковки(ВидПродукцииИС);
		ТипУпаковкиГрупповыеУпаковкиБезКоробки	 = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ТипУпаковкиГрупповыеУпаковкиБезКоробки();
	Исключение
		ПоддерживаютсяНаборыИлиГрупповыеУпаковки = Ложь;
		ТипУпаковкиГрупповыеУпаковкиБезКоробки	 = Ложь;
	КонецПопытки;
	
	// Добавим строку групповых упаковок и наборов, если её нет
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		МассивДетализаций.Добавить(ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковкиСПотребительскими"));
	КонецЕсли;
	
	СтрокаГрупповыеУпаковкиБезКоробки = Неопределено;
	Если (Детализация = Неопределено ИЛИ МассивДетализаций.Найти(Детализация) = Неопределено) И НЕ ТипУпаковкиГрупповыеУпаковкиБезКоробки = Ложь Тогда
		ЕстьСтрокаГрупповыеУпаковкиБезКоробки = Ложь;
		Для Каждого СтрокаДереваМаркированнойПродукции Из ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = ТипУпаковкиГрупповыеУпаковкиБезКоробки Тогда
				СтрокаГрупповыеУпаковкиБезКоробки = СтрокаДереваМаркированнойПродукции;
				ЕстьСтрокаГрупповыеУпаковкиБезКоробки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьСтрокаГрупповыеУпаковкиБезКоробки Тогда
			СтрокаГрупповыеУпаковкиБезКоробки = ИСМП_ДобавленнаяСтрокаГрупповыеУпаковкиБезКоробки(ДеревоМаркированнойПродукции, ВидПродукцииИС);
		КонецЕсли;
	КонецЕсли;
	
	// Добавим строку объемно-сортового учета, если ее нет
	СтрокаОбъемноСортовогоУчета = Неопределено;
	Если ОбъемноСортовойУчет Тогда
		ЕстьСтрокаОбъемноСортовогоУчета = Ложь;
		Для Каждого СтрокаДереваМаркированнойПродукции Из ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].ПродукцияБезУпаковки Тогда
				СтрокаОбъемноСортовогоУчета = СтрокаДереваМаркированнойПродукции;
				ЕстьСтрокаОбъемноСортовогоУчета = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьСтрокаОбъемноСортовогоУчета Тогда
			СтрокаОбъемноСортовогоУчета = ИСМП_ДобавленнаяСтрокаПродукцияОбъемноСортовогоУчета(ДеревоМаркированнойПродукции, ВидПродукцииИС);	
		КонецЕсли;
		
		// Разделим строки для загрузки по объемно-сортовому и поэкземплярному учету
		ТаблицаМаркированнойПродукцииОСУ = ТаблицаМаркированнойПродукции.Скопировать(Новый Структура("ОбъемноСортовойУчет", Истина));
	КонецЕсли;
	
	СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");									
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
	
	СтатусПроверкиПоУмолчанию = ?(ЗавершатьПроверку,
		СтатусПроверкиОтсутствует,
		СтатусПроверкиНеПроверялась);
	
	ЕстьМетаданныеВидыУпаковокИС = Метаданные.Перечисления.Найти("ВидыУпаковокИС") <> Неопределено;
	Если ЕстьМетаданныеВидыУпаковокИС Тогда
		ВидУпаковкиГрупповая = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая");
		ВидУпаковкиНабор	 = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор");
	Иначе
		ВидУпаковкиГрупповая = Неопределено;
		ВидУпаковкиНабор 	 = Неопределено;
	КонецЕсли;
	
	КоллекцияКолонок = ДеревоМаркированнойПродукции.Колонки;
	ИмяКолонкиКоличествоПодчиненныхПотребительскихУпаковок = ?(НЕ КоллекцияКолонок.Найти("КоличествоПодчиненныхПотребительскихУпаковок") = Неопределено,
		"КоличествоПодчиненныхПотребительскихУпаковок", Неопределено);
	ИмяКолонкиНеПересчитыватьКоличествоПотребительскихУпаковок = ?(НЕ КоллекцияКолонок.Найти("НеПересчитыватьКоличествоПотребительскихУпаковок") = Неопределено,
		"НеПересчитыватьКоличествоПотребительскихУпаковок", Неопределено);
	
	ЕстьКолонкаКоличествоПотребительскихУпаковок = ТаблицаМаркированнойПродукции.Колонки.Найти("КоличествоПотребительскихУпаковок") <> Неопределено;
	
	Попытка
		ПараметрыНормализацииКМ = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер").НастройкиРазбораКодаМаркировкиДляХэшаНормализации();
	Исключение
		ПараметрыНормализацииКМ = Неопределено;
	КонецПопытки;
	
	НастройкиРазбораКМ = ИО_НастройкиРазбораКодаМаркировки(ВидПродукцииИС);
	
	Если ОбъемноСортовойУчет Тогда
		ШтрихкодыПалет = ТаблицаМаркированнойПродукции.Скопировать(Новый Структура("ОбъемноСортовойУчет", Ложь), "ШтрихкодПалеты");
	Иначе
		ШтрихкодыПалет = ТаблицаМаркированнойПродукции.Скопировать(, "ШтрихкодПалеты");
	КонецЕсли;
	ШтрихкодыПалет.Свернуть("ШтрихкодПалеты");
	
	Для каждого Штрихкод Из ШтрихкодыПалет Цикл
		
		Если ОбъемноСортовойУчет Тогда
			ПачкиПалеты = ТаблицаМаркированнойПродукции.Скопировать(Новый Структура("ШтрихкодПалеты, ОбъемноСортовойУчет", Штрихкод.ШтрихкодПалеты, Ложь));
		Иначе
			ПачкиПалеты = ТаблицаМаркированнойПродукции.Скопировать(Новый Структура("ШтрихкодПалеты", Штрихкод.ШтрихкодПалеты));
		КонецЕсли;
		
		КоробкиПалеты = ПачкиПалеты.Скопировать();
		КоробкиПалеты.Свернуть("ШтрихкодКоробки", "КоличествоУпаковок");
		
		// Палета
		Если ЗначениеЗаполнено(Штрихкод.ШтрихкодПалеты) Тогда
			РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.ШтрихкодПалеты,"Штрихкод");
			Если РезультатПоиска = Неопределено Тогда
				НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
				
				// заполняем реквизиты палеты
				НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Палета";
				НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
				НоваяСтрока.ВидУпаковки					 	 = ?(ЕстьМетаданныеВидыУпаковокИС,
					ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"),
					Неопределено);
				НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = КоробкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхНеЧислилось = КоробкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхВсего 		 = КоробкиПалеты.Количество() + ПачкиПалеты.Количество();
				НоваяСтрока.Представление 					 = Штрихкод.ШтрихкодПалеты;
				НоваяСтрока.Штрихкод						 = Штрихкод.ШтрихкодПалеты;
				
				ИСМП_ЗаполнитьСлужебныеРеквизитыСтроки(НоваяСтрока, ВидПродукцииИС, ПараметрыНормализацииКМ, НастройкиРазбораКМ, "ИСМП");
				
				ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
				ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
				
				СтрокаРодителяПаллета = НоваяСтрока;   
			Иначе
				СтрокаРодителяПаллета = РезультатПоиска;
			КонецЕсли;
			
			Если ПачкиПалеты.Найти(СтатусПроверкиВНаличии,"СтатусПроверки") <> Неопределено 
				ИЛИ ПачкиПалеты.Найти(СтатусПроверкиНеЧислилась,"СтатусПроверки") <> Неопределено Тогда
				СтрокаРодителяПаллета.СтатусПроверки = СтатусПроверкиВНаличии;
			Иначе
				СтрокаРодителяПаллета.СтатусПроверки = СтатусПроверкиПоУмолчанию;
			КонецЕсли;
			
		Иначе
			СтрокаРодителяПаллета = ДеревоМаркированнойПродукции;
		КонецЕсли;
			
		Для каждого СтрокаКоробки Из КоробкиПалеты Цикл
			
			ПачкиКоробки = ПачкиПалеты.Скопировать(Новый Структура("ШтрихкодКоробки", СтрокаКоробки.ШтрихкодКоробки)); 

			ГруппыКоробки = ПачкиКоробки.Скопировать();
			ГруппыКоробки.Свернуть("Номенклатура, Характеристика, Серия, GTINГруппы, ВидУпаковки, ШтрихкодГруппы", "КоличествоУпаковок");
			
			// Коробка			
			Если ЗначениеЗаполнено(СтрокаКоробки.ШтрихкодКоробки) Тогда
				РезультатПоиска = СтрокаРодителяПаллета.Строки.Найти(СтрокаКоробки.ШтрихкодКоробки, "Штрихкод");
				Если РезультатПоиска = Неопределено Тогда
					НоваяСтрока = СтрокаРодителяПаллета.Строки.Добавить();
					
					// Проверка на монотоварность коробки
					ТоварыХарактеристикиКоробки = ПачкиКоробки.Скопировать();
					ТоварыХарактеристикиКоробки.Свернуть("Номенклатура, Характеристика");
					ЭтоМонотоварнаяКоробка = Ложь;
					Если ТоварыХарактеристикиКоробки.Количество() = 1 Тогда
						ЭтоМонотоварнаяКоробка = Истина;
						НоменклатураКоробки = ТоварыХарактеристикиКоробки[0].Номенклатура;
						ХарактеристикаКоробки = ТоварыХарактеристикиКоробки[0].Характеристика;
					КонецЕсли;
					
					// заполняем реквизиты коробки
					Если ЭтоМонотоварнаяКоробка Тогда
						НоваяСтрока.ТипУпаковки 	= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
						НоваяСтрока.Номенклатура 	= НоменклатураКоробки;
						НоваяСтрока.Характеристика	= ХарактеристикаКоробки;
					Иначе
						НоваяСтрока.ТипУпаковки		= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка");
					КонецЕсли;
					
					НоваяСтрока.ПредставлениеПроверкиПодчиненных 	= "Коробка";
					НоваяСтрока.ВидУпаковки							= ?(ЕстьМетаданныеВидыУпаковокИС,
						ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"),
						Неопределено);
					НоваяСтрока.КоличествоПодчиненныхУпаковок 		= ГруппыКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхНеЧислилось	= ГруппыКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхВсего 			= ГруппыКоробки.Количество() + ПачкиКоробки.Количество();
					НоваяСтрока.Представление 						= СтрокаКоробки.ШтрихкодКоробки;
					НоваяСтрока.Штрихкод						    = СтрокаКоробки.ШтрихкодКоробки;
					
					ИСМП_ЗаполнитьСлужебныеРеквизитыСтроки(НоваяСтрока, ВидПродукцииИС, ПараметрыНормализацииКМ, НастройкиРазбораКМ, "ИСМП");
					
					ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
					ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
					
					СтрокаРодителяКоробка = НоваяСтрока;
				Иначе
					СтрокаРодителяКоробка = РезультатПоиска;
				КонецЕсли;
				
				Если ПачкиКоробки.Найти(СтатусПроверкиВНаличии,"СтатусПроверки") <> Неопределено 
					ИЛИ ПачкиКоробки.Найти(СтатусПроверкиНеЧислилась,"СтатусПроверки") <> Неопределено Тогда
					СтрокаРодителяКоробка.СтатусПроверки = СтатусПроверкиВНаличии;
				Иначе
					СтрокаРодителяКоробка.СтатусПроверки = СтатусПроверкиПоУмолчанию;
				КонецЕсли;
			Иначе
				СтрокаРодителяКоробка = СтрокаРодителяПаллета;
			КонецЕсли;
			
			СтрокаРодителяГрупповыеУпаковки = СтрокаРодителяКоробка;
			
			Если СтрокаРодителяКоробка = ДеревоМаркированнойПродукции Тогда
				// Группы без упаковки добавляем в строку групповых упаковок без коробки
				Если НЕ СтрокаГрупповыеУпаковкиБезКоробки = Неопределено Тогда
					СтрокаРодителяГрупповыеУпаковки = СтрокаГрупповыеУпаковкиБезКоробки;
				КонецЕсли;
				
				// Пачки без упаковки добавляем в строку продукции без упаковки
				Если НЕ СтрокаПродукцияБезУпаковки = Неопределено Тогда
					СтрокаРодителяКоробка = СтрокаПродукцияБезУпаковки;
				КонецЕсли;
			КонецЕсли;
				
			Для каждого СтрокаГруппы Из ГруппыКоробки Цикл
			
				ПачкиГруппы = ПачкиКоробки.Скопировать(Новый Структура("ШтрихкодГруппы", СтрокаГруппы.ШтрихкодГруппы));
				ПачкиГруппы.Свернуть("Номенклатура, Характеристика, Серия, GTIN, ШтрихкодПачки, СтатусПроверки, 
					|ИдентификаторПроисхожденияВЕТИС, ГоденДо, " + ИмяКолонкиСкоропортящаясяПродукция + ",
					|ПроизвольнаяЕдиницаУчета, ТребуетВзвешивания", "КоличествоУпаковок, КоличествоПотребительскихУпаковок");
				
				// Группа			
				Если ЗначениеЗаполнено(СтрокаГруппы.ШтрихкодГруппы) Тогда
					РезультатПоиска = СтрокаРодителяГрупповыеУпаковки.Строки.Найти(СтрокаГруппы.ШтрихкодГруппы, "Штрихкод");
					Если РезультатПоиска = Неопределено Тогда
						НоваяСтрока = СтрокаРодителяГрупповыеУпаковки.Строки.Добавить();
						
						КоличествоПотребительскихУпаковок = ПачкиГруппы.Количество();
						Если КоличествоПотребительскихУпаковок = 1 И НЕ ЗначениеЗаполнено(ПачкиГруппы[0].ШтрихкодПачки) Тогда
							Если ЕстьКолонкаКоличествоПотребительскихУпаковок 
								И ЗначениеЗаполнено(ПачкиГруппы[0].КоличествоПотребительскихУпаковок) Тогда
								КоличествоПотребительскихУпаковок = ПачкиГруппы[0].КоличествоПотребительскихУпаковок;
								
								Если НЕ ИмяКолонкиНеПересчитыватьКоличествоПотребительскихУпаковок = Неопределено Тогда
									НоваяСтрока[ИмяКолонкиНеПересчитыватьКоличествоПотребительскихУпаковок] = Истина;
									НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхПотребительскихУпаковок] = КоличествоПотребительскихУпаковок;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						НоменклатураГруппы 	 = СтрокаГруппы.Номенклатура;
						ХарактеристикаГруппы = СтрокаГруппы.Характеристика;
						СерияГруппы 		 = СтрокаГруппы.Серия;
						
						Если СтрокаГруппы.ВидУпаковки = ВидУпаковкиГрупповая Тогда
							// Групповая упаковка
							ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
							ВидУпаковки	= ВидУпаковкиГрупповая;		
						Иначе
							// Набор	
							ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка");	
							ВидУпаковки	= ВидУпаковкиНабор;
							
							Если НЕ ДанныеНаборов = Неопределено Тогда
								ДанныеНабора = ДанныеНаборов.Получить(СтрокаГруппы.ШтрихкодГруппы); // Номенклатура набора отличается от номенклатуры вложенных строк
								Если НЕ ДанныеНабора = Неопределено Тогда
									НоменклатураГруппы 	 = ДанныеНабора.Номенклатура;
									ХарактеристикаГруппы = ДанныеНабора.Характеристика;
									СерияГруппы 		 = ДанныеНабора.Серия;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						// заполняем реквизиты группы
						НоваяСтрока.ПредставлениеПроверкиПодчиненных 	= "Групповая упаковка";
						НоваяСтрока.ТипУпаковки 						= ТипУпаковки;
						НоваяСтрока.ВидУпаковки							= ВидУпаковки;
						НоваяСтрока.КоличествоПодчиненныхУпаковок 		= КоличествоПотребительскихУпаковок;
						НоваяСтрока.КоличествоПодчиненныхНеЧислилось	= КоличествоПотребительскихУпаковок;
						НоваяСтрока.КоличествоПодчиненныхВсего 			= КоличествоПотребительскихУпаковок;
						НоваяСтрока.Номенклатура 					 	= НоменклатураГруппы;
						НоваяСтрока.Характеристика					 	= ХарактеристикаГруппы;
						НоваяСтрока.Серия 							 	= СерияГруппы;
						НоваяСтрока.GTIN 							 	= СтрокаГруппы.GTINГруппы;
						НоваяСтрока.Представление 						= СтрокаГруппы.ШтрихкодГруппы;
						НоваяСтрока.Штрихкод						 	= СтрокаГруппы.ШтрихкодГруппы;
						
						ИСМП_ЗаполнитьСлужебныеРеквизитыСтроки(НоваяСтрока, ВидПродукцииИС, ПараметрыНормализацииКМ, НастройкиРазбораКМ, "ИСМП");
						
						ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
						ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
						
						СтрокаРодителяГруппа = НоваяСтрока;
					Иначе
						СтрокаРодителяГруппа = РезультатПоиска;
					КонецЕсли;
					
					Если ПачкиГруппы.Найти(СтатусПроверкиВНаличии,"СтатусПроверки") <> Неопределено 
						ИЛИ ПачкиГруппы.Найти(СтатусПроверкиНеЧислилась,"СтатусПроверки") <> Неопределено Тогда
						СтрокаРодителяГруппа.СтатусПроверки = СтатусПроверкиВНаличии;
					Иначе
						СтрокаРодителяГруппа.СтатусПроверки = СтатусПроверкиПоУмолчанию;
					КонецЕсли;
				Иначе
					СтрокаРодителяГруппа = СтрокаРодителяКоробка;
				КонецЕсли;
				
				Для каждого СтрокаПачки Из ПачкиГруппы Цикл
					//Пачка
					Если ЗначениеЗаполнено(СтрокаПачки.ШтрихкодПачки) Тогда
						РезультатПоиска = СтрокаРодителяГруппа.Строки.Найти(СтрокаПачки.ШтрихкодПачки, "Штрихкод");
						Если РезультатПоиска = Неопределено Тогда
							НоваяСтрока = СтрокаРодителяГруппа.Строки.Добавить();
						
							// Заполняем реквизиты пачки
							НоваяСтрока.СтатусПроверки 					 = СтрокаПачки.СтатусПроверки;
							НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Пачка";
							НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
							НоваяСтрока.ВидУпаковки					 	 = ?(ЕстьМетаданныеВидыУпаковокИС,
								ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская"),
								Неопределено);
							НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = 1;
							НоваяСтрока.КоличествоПодчиненныхНеЧислилось = 1;
							НоваяСтрока.КоличествоПодчиненныхВсего 		 = 1;
							НоваяСтрока.Номенклатура 					 = СтрокаПачки.Номенклатура;
							НоваяСтрока.Характеристика					 = СтрокаПачки.Характеристика;
							НоваяСтрока.Серия 							 = СтрокаПачки.Серия;
							НоваяСтрока.GTIN 							 = СтрокаПачки.GTIN;
							НоваяСтрока.Штрихкод						 = СтрокаПачки.ШтрихкодПачки;
							НоваяСтрока.Представление 					 = СтрокаПачки.ШтрихкодПачки;
						
							// Заполнение реквизитов ВЕТИС
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПачки, "ИдентификаторПроисхожденияВЕТИС, ГоденДо, " + ИмяКолонкиСкоропортящаясяПродукция);
							
							// Весовая продукция
							НоваяСтрока.ПроизвольнаяЕдиницаУчета		= СтрокаПачки.ПроизвольнаяЕдиницаУчета;
							НоваяСтрока.ТребуетВзвешивания				= СтрокаПачки.ТребуетВзвешивания;
							НоваяСтрока.Количество						= ?(СтрокаПачки.ПроизвольнаяЕдиницаУчета, СтрокаПачки.КоличествоУпаковок, 0);
							
							ИСМП_ЗаполнитьСлужебныеРеквизитыСтроки(НоваяСтрока, ВидПродукцииИС, ПараметрыНормализацииКМ, НастройкиРазбораКМ, "ИСМП");
							
							ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
							ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
						Иначе
							РезультатПоиска.СтатусПроверки = СтрокаПачки.СтатусПроверки;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла; // цикл по пачкам
			КонецЦикла; // цикл по группам
		КонецЦикла; // цикл по коробам
	КонецЦикла; // цикл по палетам
	
	// Добавим данные объемно-сортового учета
	Если ОбъемноСортовойУчет
		И СтрокаОбъемноСортовогоУчета <> Неопределено Тогда
		СтруктураПараметровДобавленияДанныхОСУ = Новый Структура;
		СтруктураПараметровДобавленияДанныхОСУ.Вставить("ВидМаркируемойПродукции",	  		ВидПродукцииИС);
		СтруктураПараметровДобавленияДанныхОСУ.Вставить("СтрокаОбъемноСортовогоУчета", 		СтрокаОбъемноСортовогоУчета);
		ИСМП_ДобавитьВДеревоМаркированнойПродукцииДанныеОСУ(ТаблицаМаркированнойПродукцииОСУ, СтруктураПараметровДобавленияДанныхОСУ);
	КонецЕсли;	
	
	// Добавим пустые упаковки в дерево
	СписокПаллетПлана = ТаблицаМаркированнойПродукцииПлана.Скопировать(,"ШтрихкодПалеты");
	СписокПаллетПлана.Свернуть("ШтрихкодПалеты");
	
	Для каждого Паллета Из СписокПаллетПлана Цикл
		Если Не ЗначениеЗаполнено(Паллета.ШтрихкодПалеты) Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Паллета.ШтрихкодПалеты, "Штрихкод", Истина);
		Если РезультатПоиска = Неопределено Тогда
			НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
			
			// заполняем реквизиты палеты
			НоваяСтрока.СтатусПроверки 					 = СтатусПроверкиПоУмолчанию;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Палета";
			НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось = 0;
			НоваяСтрока.Представление 					 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 = 0;
			НоваяСтрока.Штрихкод						 = Паллета.ШтрихкодПалеты;
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	СписокКоробокПлана = ТаблицаМаркированнойПродукцииПлана.Скопировать(,"ШтрихкодПалеты,ШтрихкодКоробки");
	СписокКоробокПлана.Свернуть("ШтрихкодПалеты,ШтрихкодКоробки");
	
	Для каждого Коробка Из СписокКоробокПлана Цикл
		Если Не ЗначениеЗаполнено(Коробка.ШтрихкодКоробки) Тогда
			Продолжить;
		КонецЕсли;
				
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Коробка.ШтрихкодКоробки, "Штрихкод", Истина);
		Если РезультатПоиска = Неопределено Тогда
			
			Если ЗначениеЗаполнено(Коробка.ШтрихкодПалеты) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Коробка.ШтрихкодПалеты, "Штрихкод", Истина);	
			Иначе
				СтрокаРодитель = ДеревоМаркированнойПродукции;
			КонецЕсли;
			
			НоваяСтрока = СтрокаРодитель.Строки.Добавить();
			
			// заполняем реквизиты палеты
			НоваяСтрока.СтатусПроверки 					 = СтатусПроверкиПоУмолчанию;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Коробка";
			НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось = 0;
			НоваяСтрока.Представление 					 = Коробка.ШтрихкодКоробки;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 = 0;
			НоваяСтрока.Штрихкод						 = Коробка.ШтрихкодКоробки;
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);

		КонецЕсли;
		
	КонецЦикла;
	
	ИСМП_РассчитатьХешСуммыУпаковок(ДеревоМаркированнойПродукции, ЗавершатьПроверку);
	
КонецПроцедуры

Процедура ИСМП_РассчитатьХешСуммыУпаковок(ДеревоМаркированнойПродукции, ПроверятьНеобходимостьПеремаркировки = Истина)

	Попытка
		ТипУпаковкиГрупповыеУпаковкиБезКоробки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ТипУпаковкиГрупповыеУпаковкиБезКоробки();
	Исключение
		ТипУпаковкиГрупповыеУпаковкиБезКоробки = Ложь;
	КонецПопытки;
		
	Попытка
		ОбъемноСортовойУчет 				   = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].ОбъемноСортовойУчет;
		ГруппировкаОбъемноСортовогоУчетаПоGTIN = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].ГруппировкаОбъемноСортовогоУчетаПоGTIN;
	Исключение
		ОбъемноСортовойУчет 				   = Ложь;
		ГруппировкаОбъемноСортовогоУчетаПоGTIN = Ложь;
	КонецПопытки;
	
	ТаблицаХешСумм = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ПустаяТаблицаХешСумм();
	
	Для Каждого СтрокаДерева ИЗ ДеревоМаркированнойПродукции.Строки Цикл
		
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки)
			Или СтрокаДерева.ТипУпаковки = ТипУпаковкиГрупповыеУпаковкиБезКоробки Тогда
			
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").РассчитатьХешСуммыУпаковки(СтрокаДерева, ТаблицаХешСумм, Истина);
			
		ИначеЕсли СтрокаДерева.ТипУпаковки = ОбъемноСортовойУчет Тогда
			
			Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
				Если ПодчиненнаяСтрока.ТипУпаковки = ГруппировкаОбъемноСортовогоУчетаПоGTIN Тогда
					ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").РассчитатьХешСуммыУпаковки(ПодчиненнаяСтрока, ТаблицаХешСумм, Истина);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

	Если НЕ ПроверятьНеобходимостьПеремаркировки Тогда
		Возврат;
	КонецЕсли;	

	// см. ПроверкаИПодборПродукцииИСМП.ПересчитатьХешСуммыВсехУпаковок
	ШтрихкодИДанныеУпаковки = Неопределено;
	
	Попытка
		ТаблицаПеремаркировки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ТаблицаПеремаркировки(ТаблицаХешСумм, ШтрихкодИДанныеУпаковки);
	Исключение
		ТаблицаПеремаркировки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ТаблицаПеремаркировки(ТаблицаХешСумм);
	КонецПопытки;
	
	// Обход ошибки расчета хеш суммы без учета поля ХешСуммыНормализации
	Для Каждого СтрокаПеремаркировки Из ТаблицаПеремаркировки Цикл
		
		Если СтрокаПеремаркировки.ТребуетсяПеремаркировка Тогда
			
			ТаблицаХешСуммБезУчетаХешСуммыНормализации = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ПустаяТаблицаХешСумм();
			
			// Поиск по идентификатору строки возможен только из формы проверки и подбора, поэтому выполняем поиск по значению штрихкода
			// СтрокаДерева = ДеревоМаркированнойПродукции.Строки.Найти(СтрокаПеремаркировки.ИдентификаторВДереве, "ИдентификаторСтроки", Истина);
			// Если СтрокаДерева = Неопределено Тогда
			//	Продолжить;
			// КонецЕсли;
			Попытка
				Если ЗначениеЗаполнено(СтрокаПеремаркировки.ШтрихкодУпаковки) Тогда
					СтрокаДерева = ДеревоМаркированнойПродукции.Строки.Найти(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПеремаркировки.ШтрихкодУпаковки, "ЗначениеШтрихкода"), "Штрихкод", Истина);
				КонецЕсли;					
			Исключение
				СтрокаДерева = Неопределено;
			КонецПопытки;
			
			Если СтрокаДерева = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ХешСуммаСУчетомХешСуммыНормализации = СтрокаДерева.ХешСумма;
			
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").РассчитатьХешСуммыУпаковки(СтрокаДерева, ТаблицаХешСуммБезУчетаХешСуммыНормализации, Истина,, Ложь);
			
			Для Каждого СтрокаХешСуммы Из ТаблицаХешСуммБезУчетаХешСуммыНормализации Цикл
				
				ДанныеУпаковки = ШтрихкодИДанныеУпаковки[СтрокаХешСуммы.Штрихкод];
				Если ДанныеУпаковки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаХешСуммы.ХешСумма = ДанныеУпаковки.ХешСумма
					И ПустаяСтрока(СтрокаХешСуммы.ХешСумма) Тогда
					СтрокаПеремаркировки.ТребуетсяПеремаркировка = (СтрокаХешСуммы.СодержимоеОтсутствует
						И (ДанныеУпаковки.Количество <> 0 Или ДанныеУпаковки.КоличествоПотребительскихУпаковок <> 0));
				Иначе
					СтрокаПеремаркировки.ТребуетсяПеремаркировка = (СтрокаХешСуммы.ХешСумма <> ДанныеУпаковки.ХешСумма);
				КонецЕсли;
				
				// Если значение без учета хеш-суммы нормализации все равно не совпадает с хеш-суммой элемента ШУИТ,
				//	вернем значение с учетом хеш-суммы нормализации
				Если СтрокаПеремаркировки.ТребуетсяПеремаркировка Тогда
					СтрокаДерева.ХешСумма = ХешСуммаСУчетомХешСуммыНормализации;
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИСМП_ДобавленнаяСтрокаПродукцияБезУпаковки(ДеревоМаркированнойПродукции, ВидПродукцииИС)

	НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Вставить(0);
	
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЗаполнитьСтрокуПродукцияБезУпаковки(НоваяСтрока, ВидПродукцииИС);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЗаполнитьСтрокуПродукцияБезУпаковки", "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЗаполнитьСтрокуПродукцияБезУпаковки(НоваяСтрока);
	КонецПопытки;
	
	Возврат НоваяСтрока;	
	
КонецФункции

Функция ИСМП_ДобавленнаяСтрокаГрупповыеУпаковкиБезКоробки(ДеревоМаркированнойПродукции, ВидПродукцииИС)
	
	СтрокиДерева = ДеревоМаркированнойПродукции.Строки;
	
	Если СтрокиДерева.Количество() = 0 Тогда
		НоваяСтрока = СтрокиДерева.Вставить(0);
	ИначеЕсли СтрокиДерева[0].ТипУпаковки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ТипУпаковкиПотребительскиеУпаковкиБезУпаковки() Тогда
		НоваяСтрока = СтрокиДерева.Вставить(1);
	Иначе
		НоваяСтрока = СтрокиДерева.Вставить(0);
	КонецЕсли;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЗаполнитьСтрокуГрупповыеУпаковкиБезКоробки(НоваяСтрока, ВидПродукцииИС);
	
	Возврат НоваяСтрока;
	
КонецФункции

Функция ИСМП_ДобавленнаяСтрокаПродукцияОбъемноСортовогоУчета(ДеревоМаркированнойПродукции, ВидПродукцииИС)
	
	СтрокиДерева = ДеревоМаркированнойПродукции.Строки;
	
	Если СтрокиДерева.Количество() = 0 Тогда
		НоваяСтрока = СтрокиДерева.Добавить();
	Иначе
		ТекущийИндекс            = 0;
		МаксимальныйИндексСтроки = 2;
		Для ТекущийИндекс = 0 По Мин(СтрокиДерева.Количество() - 1, МаксимальныйИндексСтроки) Цикл
			Если СтрокиДерева[ТекущийИндекс].ТипУпаковки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ТипУпаковкиПотребительскиеУпаковкиБезУпаковки()
				Или СтрокиДерева[ТекущийИндекс].ТипУпаковки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ТипУпаковкиГрупповыеУпаковкиБезКоробки() Тогда
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		НоваяСтрока = СтрокиДерева.Вставить(ТекущийИндекс);
	КонецЕсли;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЗаполнитьСтрокуПродукцияОбъемноСортовойУчет(НоваяСтрока, ВидПродукцииИС);
	
	Возврат НоваяСтрока;
	
КонецФункции

Процедура ИСМП_ДобавитьВДеревоМаркированнойПродукцииДанныеОСУ(ТаблицаМаркированнойПродукцииОСУ, СтруктураПараметровДобавленияДанныхОСУ)
	
	ВидМаркируемойПродукции		= СтруктураПараметровДобавленияДанныхОСУ.ВидМаркируемойПродукции;
	СтрокаОбъемноСортовогоУчета	= СтруктураПараметровДобавленияДанныхОСУ.СтрокаОбъемноСортовогоУчета;
	
	Для каждого СтрокаМаркированнойПродукции ИЗ ТаблицаМаркированнойПродукцииОСУ Цикл
		КоличествоУпаковок 				  = СтрокаМаркированнойПродукции.КоличествоУпаковок;
		КоличествоПотребительскихУпаковок = ?(СтрокаМаркированнойПродукции.ПроизвольнаяЕдиницаУчета,
			СтрокаМаркированнойПродукции.КоличествоПотребительскихУпаковок,
			СтрокаМаркированнойПродукции.КоличествоУпаковок);
		
		// см. Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор.ДобавитьОСУЗавершение	
		ДанныеШтрихкода = Новый Структура;
		ДанныеШтрихкода.Вставить("GTIN",                              СтрокаМаркированнойПродукции.GTIN);
		ДанныеШтрихкода.Вставить("Номенклатура",                      СтрокаМаркированнойПродукции.Номенклатура);
		ДанныеШтрихкода.Вставить("Характеристика",                    СтрокаМаркированнойПродукции.Характеристика);
		ДанныеШтрихкода.Вставить("Серия",                             СтрокаМаркированнойПродукции.Серия);
		ДанныеШтрихкода.Вставить("КоличествоПотребительскихУпаковок", КоличествоПотребительскихУпаковок);
		ДанныеШтрихкода.Вставить("Количество",                        КоличествоУпаковок);
		ДанныеШтрихкода.Вставить("ВидУпаковки",                       ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ОбъемноСортовойУчет"));
		ДанныеШтрихкода.Вставить("ТипУпаковки",                       ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"));
		ДанныеШтрихкода.Вставить("ТипШтрихкода",                      ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128"));
		ДанныеШтрихкода.Вставить("ТребуетВзвешивания",                СтрокаМаркированнойПродукции.ТребуетВзвешивания);
		ДанныеШтрихкода.Вставить("ПроизвольнаяЕдиницаУчета",          СтрокаМаркированнойПродукции.ПроизвольнаяЕдиницаУчета);
		//
		ДанныеШтрихкода.Вставить("СтатусПроверки",					  СтрокаМаркированнойПродукции.СтатусПроверки);
		ДанныеШтрихкода.Вставить("КоличествоНеПроверялось",			  СтрокаМаркированнойПродукции.КоличествоНеПроверялось);
		
		ИСМП_ДобавитьОбъемноСортовойКодНаСервере(ДанныеШтрихкода, СтруктураПараметровДобавленияДанныхОСУ);
	КонецЦикла;	
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Процедура ИСМП_ДобавитьОбъемноСортовойКодНаСервере(ДанныеШтрихкода, СтруктураПараметровДобавленияДанныхОСУ)
	
	ВидМаркируемойПродукции		= СтруктураПараметровДобавленияДанныхОСУ.ВидМаркируемойПродукции;
	СтрокаОбъемноСортовогоУчета	= СтруктураПараметровДобавленияДанныхОСУ.СтрокаОбъемноСортовогоУчета;
	
	ЭлементыИзГруппировкиПоGTIN = ИСМП_СтрокаОбъемноСортовогоУчетаПоGTIN(СтрокаОбъемноСортовогоУчета, ВидМаркируемойПродукции, ДанныеШтрихкода).Строки;
	
	СтрокаОбъемноСортовогоКода = Неопределено;
	Для Каждого СтрокаДерева Из ЭлементыИзГруппировкиПоGTIN Цикл
		Если СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ОбъемноСортовойУчет")
			И ИСМП_НоменклатурыСтрокСовпадают(СтрокаДерева, ДанныеШтрихкода) Тогда
			СтрокаОбъемноСортовогоКода = СтрокаДерева;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЭтоДобавлениеНовойСтроки = (СтрокаОбъемноСортовогоКода = Неопределено);
	
	Если ЭтоДобавлениеНовойСтроки Тогда
		
		СтрокаОбъемноСортовогоКода = ЭлементыИзГруппировкиПоGTIN.Вставить(0);
		ЗаполнитьЗначенияСвойств(СтрокаОбъемноСортовогоКода, ДанныеШтрихкода);
		
		СтрокаОбъемноСортовогоКода.ВидУпаковки                                      = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ОбъемноСортовойУчет");
		СтрокаОбъемноСортовогоКода.ТипУпаковки                                      = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
		СтрокаОбъемноСортовогоКода.ТипШтрихкода                                     = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128");
		СтрокаОбъемноСортовогоКода.НеСодержитсяВДанныхДокумента                     = Истина;
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхПотребительскихУпаковок     = 0;
		СтрокаОбъемноСортовогоКода.Количество                                       = 0;
		СтрокаОбъемноСортовогоКода.НеПересчитыватьКоличествоПотребительскихУпаковок = Истина;
		
	КонецЕсли;
	
	СтрокаОбъемноСортовогоКода.СтатусПроверки = ДанныеШтрихкода.СтатусПроверки;
	
	Если ЭтоДобавлениеНовойСтроки
		Или СтрокаОбъемноСортовогоКода.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась") Тогда
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеПроверялось	= ДанныеШтрихкода.КоличествоНеПроверялось;
		СтрокаОбъемноСортовогоКода.Количество               			= ДанныеШтрихкода.Количество;
	Иначе
		СтрокаОбъемноСортовогоКода.Количество 							= СтрокаОбъемноСортовогоКода.Количество + ДанныеШтрихкода.Количество;
	КонецЕсли;
	
    Если ДанныеШтрихкода.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии") Тогда
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии = СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии 
			+ ДанныеШтрихкода.КоличествоПотребительскихУпаковок;
	ИначеЕсли ДанныеШтрихкода.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась") Тогда
		Если ЭтоДобавлениеНовойСтроки Тогда
			СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеЧислилось	= СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеЧислилось
				+ ДанныеШтрихкода.КоличествоПотребительскихУпаковок;
		Иначе	
			КоличествоВНаличии 	  = Мин(СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеПроверялось,
				ДанныеШтрихкода.КоличествоПотребительскихУпаковок);
			КоличествоНеЧислилось = ДанныеШтрихкода.КоличествоПотребительскихУпаковок - КоличествоВНаличии;
			
			СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии 	= СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии 
				+ КоличествоВНаличии;
			СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеЧислилось = СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеЧислилось 
				+ КоличествоНеЧислилось;
		КонецЕсли;
	КонецЕсли;
	СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеПроверялось = Макс(СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеПроверялось
		- СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии
		- СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеЧислилось
		- СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхОтсутствует,
		0);
		
	Если СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии > 0 Тогда
		СтрокаОбъемноСортовогоКода.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
	КонецЕсли;
	
	КоличествоОтсканированныхУпаковок = СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВНаличии
		+ СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеЧислилось;
	КоличествоУпаковокВсего = КоличествоОтсканированныхУпаковок
		+ СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхНеПроверялось;
		
	СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхВсего = КоличествоУпаковокВсего;
	СтрокаОбъемноСортовогоКода.Штрихкод = "(02)" + СтрокаОбъемноСортовогоКода.GTIN + "(37)" + Формат(КоличествоУпаковокВсего, "ЧН=0; ЧГ=0");
	
	Если СтрокаОбъемноСортовогоКода.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась") Тогда
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхУпаковок 				= КоличествоУпаковокВсего;
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхПотребительскихУпаковок = КоличествоУпаковокВсего;
	Иначе
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхУпаковок 				= КоличествоОтсканированныхУпаковок;
		СтрокаОбъемноСортовогоКода.КоличествоПодчиненныхПотребительскихУпаковок = КоличествоОтсканированныхУпаковок;
	КонецЕсли;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеДляСтрокиДереваМаркированнойПродукции(СтрокаОбъемноСортовогоКода, ВидМаркируемойПродукции);
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(СтрокаОбъемноСортовогоКода);
	
КонецПроцедуры

// см. ОбрабПроверкаИПодборПродукцииИСМПКлиентСерверотка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Функция ИСМП_СтрокаОбъемноСортовогоУчетаПоGTIN(СтрокаОбъемноСортовогоУчета, ВидМаркируемойПродукции, ДанныеШтрихкода, СоздаватьСтроки = Истина)
	
	Если СтрокаОбъемноСортовогоУчета = Неопределено Тогда
		Если Не СоздаватьСтроки Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ИО_ОбщийМодуль("ОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШтрихкода, "GTINПотребительскойУпаковки")
		И ЗначениеЗаполнено(ДанныеШтрихкода.GTINПотребительскойУпаковки) Тогда
		GTIN = ДанныеШтрихкода.GTINПотребительскойУпаковки;
	Иначе
		GTIN = ДанныеШтрихкода.GTIN;
	КонецЕсли;
	
	ЭлементыОбъемноСортовогоУчета = СтрокаОбъемноСортовогоУчета.Строки;
	
	ЭлементГруппировкиПоGTIN = Неопределено;
	Для Каждого СтрокаДерева Из ЭлементыОбъемноСортовогоУчета Цикл
		
		Если СтрокаДерева.GTIN = GTIN Тогда
			ЭлементГруппировкиПоGTIN = СтрокаДерева;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭлементГруппировкиПоGTIN = Неопределено Тогда
		
		Если Не СоздаватьСтроки Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ЭлементГруппировкиПоGTIN = ЭлементыОбъемноСортовогоУчета.Добавить();
		ЭлементГруппировкиПоGTIN.GTIN = GTIN;
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЗаполнитьСтрокуГруппировкаОбъемноСортовогоУчетаПоGTIN(
			ЭлементГруппировкиПоGTIN, ВидМаркируемойПродукции);
		
	КонецЕсли;
	
	Возврат ЭлементГруппировкиПоGTIN;
	
КонецФункции

// см. Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор
Функция ИСМП_НоменклатурыСтрокСовпадают(ИсходнаяСтрока, СтрокаИзменений, ПроверятьGTIN = Ложь)
	
	Если Не ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").НоменклатурыСтрокСовпадают(ИсходнаяСтрока, СтрокаИзменений) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверятьGTIN Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").GTINРавны(ИсходнаяСтрока.GTIN, СтрокаИзменений.GTIN);
	
КонецФункции

Функция СоздатьПроверитьКоробкуОбувиСПересчетомХешСумм(СтрокаДерева)
	ШтрихкодУпаковки = СтрокаДерева.Штрихкод;
	
	УпаковкаСсылка = НайтиУпаковкуТоваровПоШтрихкоду(ШтрихкодУпаковки);
	Если УпаковкаСсылка = Неопределено Тогда
		УпаковкаОбъект = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();		
		УпаковкаОбъект.ЗначениеШтрихкода 	= ШтрихкодУпаковки;
		УпаковкаОбъект.ДатаУпаковки 		= ТекущаяДатаСеанса();		
		УпаковкаОбъект.ТипШтрихкода 		= ТипШтрихкода(Новый Структура("ЗначениеШтрихкода", ШтрихкодУпаковки));
	Иначе
		УпаковкаОбъект = УпаковкаСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	ВложенныеШК = УпаковкаОбъект.ВложенныеШтрихкоды;
	ВложенныеШК.Очистить();
	
	ТоварыВКоробке 	= Новый Соответствие;
	ХаркиВКоробке 	= Новый Соответствие;
	ДанныеДляРасчетаХешСуммы = Новый СписокЗначений();
	
	СтрокиДерева = СтрокаДерева.Строки;
	Если СтрокиДерева.Количество() > 0 Тогда		
		Для Каждого Строка Из СтрокиДерева Цикл			
			Если Строка.СтатусПроверки <> ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии") Тогда
				Продолжить;
			КонецЕсли;
			
			//Если Строка.ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") 
			//	ИЛИ Строка.СтатусПроверки <> ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии") Тогда
			//	Продолжить;
			//КонецЕсли;
			
			Если Строка.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка")
				ИЛИ Строка.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка") Тогда
				
				КоробкаОбувиСсылка = НайтиУпаковкуТоваровПоШтрихкоду(Строка.Штрихкод);
				Если КоробкаОбувиСсылка = Неопределено Тогда
					КоробкаОбувиСсылка = СоздатьПроверитьКоробкуОбувиСПересчетомХешСумм(Строка);							
				КонецЕсли;
				ТоварыВКоробке.Вставить(Строка.Номенклатура);
				ХаркиВКоробке.Вставить(Строка.Характеристика);
				
				Если КоробкаОбувиСсылка <> Неопределено Тогда
					
					Строка.ХешСумма = КоробкаОбувиСсылка.ХешСумма;
					ДанныеДляРасчетаХешСуммы.Добавить(Строка.Штрихкод);
					
					НС = ВложенныеШК.Добавить();
					НС.Штрихкод = КоробкаОбувиСсылка;
					
				КонецЕсли;
			
			ИначеЕсли Строка.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
				
				ПараОбувиСсылка = НайтиУпаковкуТоваровПоШтрихкоду(Строка.Штрихкод);
				Если ПараОбувиСсылка = Неопределено Тогда
					ПараОбувиСсылка = СоздатьУпаковкуМаркированнойОбуви(Строка);							
				КонецЕсли;
				ТоварыВКоробке.Вставить(Строка.Номенклатура);
				ХаркиВКоробке.Вставить(Строка.Характеристика);
				
				ДанныеДляРасчетаХешСуммы.Добавить(Строка.Штрихкод);
				
				НС = ВложенныеШК.Добавить();
				НС.Штрихкод = ПараОбувиСсылка;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	УпаковкаОбъект.Количество = СтрокиДерева.Количество();
	//УпаковкаОбъект.ХешСумма = Вычислить("Справочники.ШтрихкодыУпаковокТоваров.ХешСуммаСодержимогоУпаковки(ДанныеДляРасчетаХешСуммы)");
	//УпаковкаОбъект.ХешСуммаЗначенияШтрихкода = Вычислить("ИнтеграцияИС.ХешированиеДанныхSHA256(ШтрихкодУпаковки)");	
	УпаковкаОбъект.ХешСумма = Справочники["ШтрихкодыУпаковокТоваров"].ХешСуммаСодержимогоУпаковки(ДанныеДляРасчетаХешСуммы);
	УпаковкаОбъект.ХешСуммаЗначенияШтрихкода = ИО_ОбщийМодуль("ИнтеграцияИС").ХешированиеДанныхSHA256(ШтрихкодУпаковки);
	
	Если ТоварыВКоробке.Количество() < 2
		И ХаркиВКоробке.Количество() < 2 Тогда
		УпаковкаОбъект.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
		Если ТоварыВКоробке.Количество() = 1 Тогда
			УпаковкаОбъект.Номенклатура = Строка.Номенклатура;
		КонецЕсли;
		Если ХаркиВКоробке.Количество() = 1 Тогда
			УпаковкаОбъект.Характеристика = Строка.Характеристика;
		КонецЕсли;
	Иначе
		УпаковкаОбъект.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка");
	КонецЕсли;
	Результат = Неопределено;
	Попытка
		УпаковкаОбъект.ДополнительныеСвойства.Вставить("НеРассчитыватьКоличествоВложенныхШтрихкодов", Истина);
		УпаковкаОбъект.Записать();
		Результат = УпаковкаОбъект.Ссылка;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("СоздатьПроверитьКоробкуОбувиСПересчетомХешСумм", "Ошибка", "При выполнении: СоздатьПроверитьКоробкуОбувиСПересчетомХешСумм(), возникла ошибка: " + ТекстОшибки);
	КонецПопытки;
		
	Возврат Результат;
КонецФункции

Функция НайтиУпаковкуТоваровПоШтрихкоду(Штрихкод, ПроверятьБезСкобок = Ложь)
	
	МассивШК = Новый Массив;
	МассивШК.Добавить(Штрихкод);
	
	Если ПроверятьБезСкобок
		И ГлЯдро_СтрНайти(Штрихкод, "(") Тогда
		МассивШК.Добавить(СтрЗаменить(СтрЗаменить(Штрихкод, "(", ""), ")", ""));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	               |	ВЫБОР
	               |		КОГДА ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &Штрихкод
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ИсходныйФормат
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |ГДЕ
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода В(&МассивШК)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИсходныйФормат,
	               |	ШтрихкодыУпаковокТоваров.ПометкаУдаления,
	               |	ШтрихкодыУпаковокТоваров.ДатаУпаковки УБЫВ";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("МассивШК", МассивШК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если МассивШК.Найти(Выборка.ЗначениеШтрихкода) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Возврат Выборка.Ссылка;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СоздатьУпаковкуМаркированнойОбуви(СтрокаДерева)
	
	ДанныеНовойУпаковки = Справочники.ШтрихкодыУпаковокТоваров.СтруктураСозданияШтрихкодаУпаковки();
	ДанныеНовойУпаковки.Штрихкод     = СтрокаДерева.Штрихкод;
	ДанныеНовойУпаковки.ДатаУпаковки = ТекущаяДатаСеанса();
	ДанныеНовойУпаковки.ТипУпаковки  = СтрокаДерева.ТипУпаковки;
	Если НЕ СтрокаДерева.БазоваяУпаковка Тогда                   
	ДанныеНовойУпаковки.Упаковка	 = СтрокаДерева.Упаковка;     
	КонецЕсли;                                                              
	//найдем упаковку и коэффициенты по gtin
	Параметры = Новый Массив;
	Номенклатура = Новый Структура;
	Номенклатура.Вставить("Номенклатура",СтрокаДерева.Номенклатура);
	Параметры.Добавить(Номенклатура);
	
	ПараметрыДанныхУточнения = Новый Структура;
	ПараметрыДанныхУточнения.Вставить("ЭтоНастройкаКарточкиНоменклатуры",Истина);
	ВходящаяТаблицаОписаниеGTIN = ИО_ОбщийМодуль("ИнтеграцияИСМП").ДанныеДляУточненияКоэффициентовУпаковок(Параметры,Ложь,ПараметрыДанныхУточнения);	
	СтрУпаковки = ВходящаяТаблицаОписаниеGTIN.Найти(СтрокаДерева.Упаковка, "Упаковка");	
	
	Если ДанныеНовойУпаковки.Свойство("ТипШтрихкода") Тогда
		ДанныеНовойУпаковки.ТипШтрихкода = ТипШтрихкода(Новый Структура("ЗначениеШтрихкода", СтрокаДерева.Штрихкод));
	КонецЕсли;
	
	ДанныеНовойУпаковки.Номенклатура   = СтрокаДерева.Номенклатура;
	ДанныеНовойУпаковки.Характеристика = СтрокаДерева.Характеристика;
	ДанныеНовойУпаковки.Серия          = СтрокаДерева.Серия;	
	
	Если СтрокаДерева.Свойство("Упаковка") И ЗначениеЗаполнено(СтрокаДерева.Упаковка) И СтрокаДерева.Упаковка.Знаменатель > 0 И НЕ СтрокаДерева.БазоваяУпаковка Тогда      
	ДанныеНовойУпаковки.Количество = СтрУпаковки.Коэффициент;                           
	ДанныеНовойУпаковки.КоличествоПотребительскихУпаковок = СтрУпаковки.КоличествоПотребительскихУпаковок;   
	Иначе																								
	ДанныеНовойУпаковки.Количество = 1;
	КонецЕсли;
	ДанныеНовойУпаковки.ХешСумма   = "";
		
	ПараметрыЗаписи = Новый Структура();
	ПараметрыЗаписи.Вставить("НеРассчитыватьКоличествоВложенныхШтрихкодов", Истина);
	ПараметрыЗаписи.Вставить("НеРассчитыватьХешСумму", Истина);
	
	ШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров.СоздатьШтрихкодУпаковки(ДанныеНовойУпаковки,, ПараметрыЗаписи,);
	Возврат ШтрихкодУпаковки;
	
КонецФункции

Функция ИО_МаркировкаПоНоменклатуре(Номенклатура)
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	Маркировка = "";
	
	Попытка
		РеквизитыОсобенностейУчетаИС = УТ_11_4_ПолучитьРеквизитыОсобенностейУчетаИС();
		
		ЗначенияРеквизитов = РеквизитыОсобенностейУчетаИС.Получить(Номенклатура.ОсобенностьУчета);
		Если ЗначенияРеквизитов <> Неопределено Тогда
			Маркировка = ЗначенияРеквизитов.ЗначениеМаркировки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Маркировка) Тогда
			Маркировка = "";
		КонецЕсли;
	Исключение КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Маркировка) Тогда
		Попытка
			Если Номенклатура.ОбувнаяПродукция Тогда
				Маркировка = "Обувь";
			ИначеЕсли Номенклатура.ТабачнаяПродукция Тогда
				Маркировка = "Табак";
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;
	
	Возврат Маркировка;
	
КонецФункции

//Табак ИСМП
