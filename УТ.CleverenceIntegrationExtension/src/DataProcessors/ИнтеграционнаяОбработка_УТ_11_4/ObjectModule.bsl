// Вызывается при загрузке документа ПеремещениеТоваров из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ПеремещениеТоваров_ПередЗаполнениемДокумента		(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПередЗаполнениемДокумента(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;	
	
	Если Док1СРезультат.ЭтоНовый() Тогда 
		Док1СРезультат.Заполнить(Неопределено);					
	КонецЕсли;	

КонецПроцедуры 

// Вызывается при загрузке документа ПеремещениеТоваров из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ПеремещениеТоваров_ПослеЗаполненияДокумента		(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);	
	
	Если Не Константы.ИспользоватьСерииНоменклатуры.Получить()  Тогда
		СтруктураПараметров.Док1СРезультат.Серии.Очистить();
	КонецЕсли;
	
	// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
	ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
	ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ""); 
	
	Док1СРезультат 			= СтруктураПараметров.Док1СРезультат;
	ДокументMS              = СтруктураПараметров.ДанныеДокументаMS; 
	
	Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументMS.ШапкаДокумента.ИдСклада1СОткуда));
	
	Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
		Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Документ обработан на ТСД! от " + ТекущаяДата();
	Иначе   
		Док1СРезультат.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
	КонецЕсли;
		
	Если Склад.ИспользоватьАдресноеХранение Тогда 
		
		//Если СтруктураПараметров.ДокументТСД.ШапкаДокумента.НастройкаБизнесПроцесса = "BP017f2c1475954f9fa689a09398708390" Тогда
			
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);		
			Исключение
				ИнфоОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки  = "Ошибка при проведении " + Строка(Док1СРезультат) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Приобретение товаров и услуг", "Ошибка" , ТекстОшибки);
				СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
				СтруктураПараметров.Вставить("Отказ", Истина);
				Возврат
			КонецПопытки;
			
			Если Док1СРезультат.Проведен Тогда
				СоздатьРасходныйОрдер(СтруктураПараметров, Склад);
			КонецЕсли; 
			
		//КонецЕсли;
		
		//Если НЕ СтруктураПараметров.Отказ Тогда
		//	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
		//КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры 

//Миронов А.А
Процедура СоздатьРасходныйОрдер(СтруктураПараметров, Склад) 
	
	Док1СРезультат 			= СтруктураПараметров.Док1СРезультат;
	Док1СОснование 			= СтруктураПараметров.Док1СОснование;  
	ДокументMS              = СтруктураПараметров.ДанныеДокументаMS; 
	СтруктураТЗФакт         = ПолучитьСтруктуруТЗФакт(ДокументMS, Склад, СтруктураПараметров);
	
	Если Док1СРезультат = Неопределено Тогда
		Док1СРезультат 	= Док1СОснование.ПолучитьОбъект();
	КонецЕсли;	
	
	РасходныйОрдер 						= Документы.РасходныйОрдерНаТовары.СоздатьДокумент();
	РасходныйОрдер.Дата 				= ТекущаяДата();
	РасходныйОрдер.ДатаОтгрузки 		= ТекущаяДата();
	РасходныйОрдер.Приоритет            = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	РасходныйОрдер.Склад 				= Склад;
	РасходныйОрдер.Статус 				= ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.КОтбору");
	РасходныйОрдер.Комментарий 			= "Документ создан на основании: " + Строка(Док1СРезультат);  
	
	//Может быть Реализация или Перемещение - меняется складская операция и получатель
	Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда 
		РасходныйОрдер.СкладскаяОперация 	= ПредопределенноеЗначение("Перечисление.СкладскиеОперации.ОтгрузкаКлиенту");
	Иначе		
		РасходныйОрдер.СкладскаяОперация 	= ПредопределенноеЗначение("Перечисление.СкладскиеОперации.ОтгрузкаПоПеремещению"); 
	КонецЕсли;
	
	Если ДокументMS.ШапкаДокумента.Свойство("ИдСклада1СКуда") Тогда
		РасходныйОрдер.Получатель 		= Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументMS.ШапкаДокумента.ИдСклада1СКуда));
	Иначе
		РасходныйОрдер.Получатель 		= Док1СРезультат.Партнер;
	КонецЕсли;

	//Заполнение Ответственный
	Ответственный = ПолучитьСсылку("Пользователи", ДокументMS.ШапкаДокумента.ИдПользователя);
	
	Если ЗначениеЗаполнено(Ответственный) Тогда
		РасходныйОрдер.Ответственный 	= Ответственный;
	Иначе  
		РасходныйОрдер.Ответственный 	= Пользователи.ТекущийПользователь();
	КонецЕсли; 
	
	РасходныйОрдер.Ответственный 		= Ответственный; 
	
	// Заполнение помещения
	Попытка
		Помещение 	  = Справочники.СкладскиеПомещения.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументMS.ШапкаДокумента.ИдСклада1СОткуда));
		Если Помещение.ПолучитьОбъект() = Неопределено Тогда
			Результат = Справочники.СкладскиеПомещения.ПустаяСсылка();
		Иначе 
			Результат = Помещение;
		КонецЕсли;
	Исключение
		Результат 	  = Справочники.СкладскиеПомещения.ПустаяСсылка();
	КонецПопытки; 
	
	РасходныйОрдер.Помещение 			= Результат;
	РасходныйОрдер.ЗонаОтгрузки 		= Справочники.СкладскиеЯчейки.ЗонаОтгрузкиПоУмолчанию(РасходныйОрдер.Склад, РасходныйОрдер.Помещение);
	
	////Заполнение комментария(Док Перемещение)
	//Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
	//	Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Создан документ: " + Строка(РасходныйОрдер);
	//Иначе   
	//	Док1СРезультат.Комментарий = "Создан документ: " + Строка(РасходныйОрдер);
	//КонецЕсли;  
	
	// Заполнение табличных частей документа
	ДействиеСтрокиТовара = ПредопределенноеЗначение("Перечисление.ДействияСоСтрокамиОрдеровНаОтгрузку.Отобрать");
	
	Для Каждого СтрокаФакт Из СтруктураТЗФакт Цикл 
		
		//ТЧ Распоряжение
		НоваяСтрокаРаспоряжениям 			  = РасходныйОрдер.ТоварыПоРаспоряжениям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспоряжениям, СтрокаФакт); 
		
		Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.РеализацияТоваровУслуг") И Значениезаполнено(Док1СРезультат.ЗаказКлиента) Тогда
			НоваяСтрокаРаспоряжениям.Распоряжение = Док1СРезультат.ЗаказКлиента;
		Иначе	
			НоваяСтрокаРаспоряжениям.Распоряжение = Док1СРезультат.Ссылка;
		КонецЕсли;
		//ПолучитьСтатусСерий(НоваяСтрокаРаспоряжениям, РасходныйОрдер, Склад)
		
		//ТЧ ОтгружаемыеТовары
		НоваяСтрокаОтгружаемыеТовары 		  = РасходныйОрдер.ОтгружаемыеТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОтгружаемыеТовары, СтрокаФакт); 
		НоваяСтрокаОтгружаемыеТовары.Действие = ДействиеСтрокиТовара;
		//ПолучитьСтатусСерий(НоваяСтрокаОтгружаемыеТовары, РасходныйОрдер, Склад); 
		
	КонецЦикла;
	
	ТЧО = РасходныйОрдер.ОтгружаемыеТовары.Выгрузить();
	
	Попытка
		//Меняем результирующий документ на расходный ордер и обрабатываем загрузку марок - не используем загрузку марок в расходник
		//Док1СРезультат.Записать();
		
		// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
		//РасходныйОрдер.Записать(РежимЗаписиДокумента.Запись);
		//СтруктураПараметров.Док1СРезультат = РасходныйОрдер;
		//ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
		//ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
		РасходныйОрдер.Записать(РежимЗаписиДокумента.Проведение);
		
		//Заполнение комментария(Док Перемещение)
		Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
			Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Создан документ: " + Строка(РасходныйОрдер);
		Иначе   
			Док1СРезультат.Комментарий = "Создан документ: " + Строка(РасходныйОрдер);
		КонецЕсли; 
		
		Док1СРезультат.Записать();
		
		Если РасходныйОрдер.Статус  = ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.КОтбору") И ДействиеСтрокиТовара = ПредопределенноеЗначение("Перечисление.ДействияСоСтрокамиОрдеровНаОтгрузку.Отобрать") Тогда
			СоздатьОтборРазмещениеТовара(Док1СРезультат, РасходныйОрдер, ДокументMS, СтруктураТЗФакт, Склад, СтруктураПараметров);
		КонецЕсли; 
		
		РасходныйОрдер.Статус  = ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.Отгружен");
		
		//Загружаем ТЧ Отгружаемых товаров т.е после проведения в статусе в отборе серии слетают 
		ДействиеСтрокиТовара = ПредопределенноеЗначение("Перечисление.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить");
		РасходныйОрдер.ОтгружаемыеТовары.Загрузить(ТЧО);
		
		Для Каждого СтрокаТовара Из РасходныйОрдер.ОтгружаемыеТовары Цикл
			СтрокаТовара.Действие = ДействиеСтрокиТовара;
			ОбработатьТЧ(РасходныйОрдер, СтрокаТовара);
			
			Если СтрокаТовара.Номенклатура.ВидНоменклатуры.ИспользоватьСерии И Склад.ИспользоватьСерииНоменклатуры И РасходныйОрдер.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.КПроверке") Тогда
				Если Не ЗначениеЗаполнено(СтрокаТовара.Серия) Тогда 
					РасходныйОрдер.Статус  = ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.КПроверке"); 
				КонецЕсли;
			КонецЕсли;	
							
		КонецЦикла;	
		
		//Меняем конечный статус документа в зависимости от недобора и проверки заполненных полей
		Если ЗначениеЗаполнено(ДокументMS.ШапкаДокумента.ЕстьНедобор) Тогда
			
			Если ДокументMS.ШапкаДокумента.ЕстьНедобор Или Не РасходныйОрдер.ПроверитьЗаполнение() Тогда
				РасходныйОрдер.Статус  = ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.КПроверке");
			КонецЕсли;
						
		КонецЕсли;			
		
		Попытка
			Если РасходныйОрдер.Движения.ТоварыНаСкладах.ДополнительныеСвойства.Свойство("РассчитыватьИзменения") Тогда
				Если РасходныйОрдер.Движения.ТоварыНаСкладах.ДополнительныеСвойства.РассчитыватьИзменения Тогда
					РасходныйОрдер.Движения.ТоварыНаСкладах.ДополнительныеСвойства.РассчитыватьИзменения = Ложь;
				КонецЕсли;
			КонецЕсли;	
		Исключение
		КонецПопытки;
		
		РасходныйОрдер.Записать(РежимЗаписиДокумента.Проведение);
						
	Исключение 
		
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки  = "Ошибка при проведении " + Строка(РасходныйОрдер) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Расходный ордер", "Ошибка" , ТекстОшибки);
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("Отказ", Истина);
		Возврат 
		
	КонецПопытки; 	
						
КонецПроцедуры

Процедура ОбработатьТЧ(Объект, ТекущаяСтрока)
	КэшированныеЗначения = Неопределено;
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.РасходныйОрдерНаТовары));
	
	Действия = Новый Структура;
	Действия.Вставить("ПроверитьСериюРассчитатьСтатус",
	Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий.ОтгружаемыеТовары));
	
