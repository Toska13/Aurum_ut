//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ТТНВходящаяЕГАИС_ПослеЗаполненияДокумента			(СтруктураПараметров) Экспорт

	СтруктураПараметров.Вставить("КритическаяОшибка", Истина); 
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "ТТНВходящаяЕГАИС. Версии объектов метаданных");
	
	ВерсииОбъектовКонфигурации = ВерсииОбъектовКонфигурации();
	СтруктураПараметров.Вставить("ВерсииОбъектовКонфигурации", ВерсииОбъектовКонфигурации);
	
	УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);	

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "ТТНВходящаяЕГАИС. Ошибка установки статуса документа ТТН Входящая ЕГАИС");
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиИПодбораИС") <> Неопределено Тогда
    	СтатусВыполняется = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Выполняется");
		СтатусЗавершено   = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Завершено");
    Иначе
		СтатусВыполняется = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораЕГАИС.Выполняется");
		СтатусЗавершено   = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораЕГАИС.Завершено");
	КонецЕсли;
	
	Если Док1СРезультат.СтатусПроверкиИПодбора <> СтатусЗавершено Тогда
		УстанавливаемыйСтатус = СтатусВыполняется;		
	КонецЕсли;
	
	ТТНВходящаяЕГАИС_УстановитьСтатусПринято(Док1СРезультат, УстанавливаемыйСтатус);
	ТТНВходящаяЕГАИС_ТЧ_АкцизныеМарки_ЗаполнитьСправки2(Док1СРезультат);	
	ТТНВходящаяЕГАИС_ТЧ_Товары_ЗаполнитьКоличествоФакт(СтруктураПараметров);					
	
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание","ТТНВходящаяЕГАИС. Проверка акцизных марок");
	
	ТТНВходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров);
	
	Док1СРезультат.Записать(РежимЗаписиДокумента.Запись);
	
	СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
	СтруктураПараметров.Вставить("КритическаяОшибка", 			Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", 	"");
	
КонецПроцедуры 

