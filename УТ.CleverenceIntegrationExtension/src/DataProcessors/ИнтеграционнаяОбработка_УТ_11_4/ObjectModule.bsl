Функция УТ_11_4_ПолучитьИспользуемыеИменаДокументов()
	
	СоответствиеИменДокументов = Новый Соответствие;
	
	СоответствиеИменДокументов.Вставить("ПоступлениеТУ", 		"ПриобретениеТоваровУслуг");
	СоответствиеИменДокументов.Вставить("РеализацияТУ", 		"РеализацияТоваровУслуг");
	СоответствиеИменДокументов.Вставить("ВозвратПоставщику", 	"ВозвратТоваровПоставщику");
	СоответствиеИменДокументов.Вставить("ВозвратОтКлиента", 	"ВозвратТоваровОтКлиента");
	
	МетаданныеДокументы = Метаданные.Документы;
	
	Если МетаданныеДокументы.Найти("ПриемкаТоваровИСМП") <> Неопределено Тогда
		СоответствиеИменДокументов.Вставить("ПриемкаИСМП",			"ПриемкаТоваровИСМП");
	Иначе
		СоответствиеИменДокументов.Вставить("ПриемкаИСМП",			Неопределено);
	КонецЕсли;
	
	Если МетаданныеДокументы.Найти("ОтгрузкаТоваровИСМП") <> Неопределено Тогда
		СоответствиеИменДокументов.Вставить("ОтгрузкаИСМП", 		"ОтгрузкаТоваровИСМП");
	Иначе
		СоответствиеИменДокументов.Вставить("ОтгрузкаИСМП", 		Неопределено);
	КонецЕсли;
	
	Если МетаданныеДокументы.Найти("ВыводИзОборотаИСМП") <> Неопределено Тогда
		СоответствиеИменДокументов.Вставить("ВыводИзОборотаИСМП",	"ВыводИзОборотаИСМП");
	Иначе
		СоответствиеИменДокументов.Вставить("ВыводИзОборотаИСМП",	Неопределено);
	КонецЕсли;
	
	Если МетаданныеДокументы.Найти("СписаниеКодовМаркировкиИСМП") <> Неопределено Тогда
		СоответствиеИменДокументов.Вставить("СписаниеИСМП",			"СписаниеКодовМаркировкиИСМП");
	Иначе
		СоответствиеИменДокументов.Вставить("СписаниеИСМП",			Неопределено);
	КонецЕсли;
	
	Если МетаданныеДокументы.Найти("МаркировкаТоваровИСМП") <> Неопределено Тогда
		СоответствиеИменДокументов.Вставить("МаркировкаИСМП",		"МаркировкаТоваровИСМП");
	Иначе
		СоответствиеИменДокументов.Вставить("МаркировкаИСМП",		Неопределено);
	КонецЕсли;
	
	Если МетаданныеДокументы.Найти("ПеремаркировкаТоваровИСМП") <> Неопределено Тогда
