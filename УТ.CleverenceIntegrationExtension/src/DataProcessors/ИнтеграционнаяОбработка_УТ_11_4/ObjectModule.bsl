Функция ПроверитьНаличиеПроизвольнойЦеныВДокументеОсновании(СтруктураПараметров)
	
	СтруктураЦеныОснования = Новый Структура("ПроизвольнаяЦена,СтрокаЗаказа", Ложь, Неопределено);
	
	СтруктураПоискаКлючаСвязи 	= СтруктураПараметров.СтруктураПоискаКлючаСвязи;		
	ДокОснование				= СтруктураПараметров.Док1СОснование;
	
	Если СтруктураПоискаКлючаСвязи <> Неопределено И СтруктураПоискаКлючаСвязи.Свойство("ИндексСтроки1С") Тогда			
		// Необходимо пока только для заказов клиента
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ЗаказКлиента") Тогда				
			СтрокаЗаказа = Неопределено;
			Если СтруктураПоискаКлючаСвязи.ДанныеДляЗагрузки_Строка <> Неопределено И
				СтруктураПоискаКлючаСвязи.ДанныеДляЗагрузки_Строка.Свойство("КодСтроки") Тогда
				НайденныеСтроки = ДокОснование.Товары.НайтиСтроки(Новый Структура("КодСтроки", СтруктураПоискаКлючаСвязи.ДанныеДляЗагрузки_Строка.КодСтроки));
				Если НайденныеСтроки.Количество() Тогда
					СтрокаЗаказа = НайденныеСтроки[0];
				КонецЕсли;                            
			Иначе                                     
				СтрокаЗаказа = ДокОснование.Товары[СтруктураПоискаКлючаСвязи.ИндексСтроки1С];	
			КонецЕсли;   			
			Если СтрокаЗаказа <> Неопределено Тогда
				СтруктураЦеныОснования.СтрокаЗаказа = СтрокаЗаказа;							
				Если Не ЗначениеЗаполнено(СтрокаЗаказа.ВидЦены) Тогда
					СтруктураЦеныОснования.ПроизвольнаяЦена = Истина;
				КонецЕсли;
			КонецЕсли;			
		КонецЕсли;                                                                                   		
	КонецЕсли;
	
	Возврат СтруктураЦеныОснования;
	
КонецФункции

Функция ИО_ОбщийМодуль(Имя)

	Если КэшОбщиеМодули = Неопределено Тогда
		КэшОбщиеМодули = Новый Соответствие;
	КонецЕсли;
	
	Модуль = КэшОбщиеМодули.Получить(Имя);
	
	Если Модуль = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Модуль = Неопределено Тогда
		Модуль = ОбщегоНазначения.ОбщийМодуль(Имя);
		
		КэшОбщиеМодули.Вставить(Имя, ?(Модуль = Неопределено,
			Ложь,
			Модуль));
	КонецЕсли;
	
	Возврат Модуль;
	
КонецФункции

