	//если не выбрана загрузка в существующий документ
	Если СтруктураПараметров.Док1СРезультат.ЭтоНовый() Тогда
		
		Штрихкод = Неопределено;
		Если СтруктураПараметров.ДанныеДляЗагрузки_Шапка.Свойство("Код", Штрихкод) и ЗначениеЗаполнено(Штрихкод) Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Документ.УпаковочныйЛист ГДЕ Код = &Штрихкод и Не ПометкаУдаления УПОРЯДОЧИТЬ ПО Дата Убыв");
			Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтруктураПараметров.Вставить("Док1СРезультат", Выборка.Ссылка.ПолучитьОбъект());
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	УТ_11_2_Общий_ПередЗаполнениемДокумента(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;	
	Если Док1СРезультат.ЭтоНовый() Тогда 
		Док1СРезультат.Заполнить(Неопределено);					
	КонецЕсли;	

