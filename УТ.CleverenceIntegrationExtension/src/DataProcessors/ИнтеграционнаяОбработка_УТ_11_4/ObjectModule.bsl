	// В Дереве могут быть марки остатков без указанной номенклатуры. В случае единственной строки в тч Товары будем сразу проставлять её
	ВДокументеОднаНоменклатура = Ложь;
	ЕдинственнаяНоменклатура 	= Справочники.Номенклатура.ПустаяСсылка();
	ЕдинственнаяХарактеристика 	= Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Если Документ1С.Товары.Количество() = 1 
		И ЗначениеЗаполнено(Документ1С.Товары[0].Номенклатура) Тогда
		ВДокументеОднаНоменклатура = Истина;
		ЕдинственнаяНоменклатура   = Документ1С.Товары[0].Номенклатура;
		ЕдинственнаяХарактеристика = Документ1С.Товары[0].Характеристика;
	КонецЕсли;

	СтатусыПроверкиВНаличии = Новый Массив;
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияПродукцииИС") <> Неопределено Тогда
		СтатусыПроверкиВНаличии.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии"));
		СтатусыПроверкиВНаличии.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась"));
	КонецЕсли;
	
	ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
	ВыгружаемыйУровеньДетализацииИСМП = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("УровеньДетализацииПриВыгрузкеИСМП"), СтруктураПараметров);
	
	Если ВыгружаемыйУровеньДетализацииИСМП = "Палеты" Тогда
		УровеньДетализацииИСМП = 1;
	ИначеЕсли ВыгружаемыйУровеньДетализацииИСМП = "Коробки" Тогда
		УровеньДетализацииИСМП = 2;
	ИначеЕсли ВыгружаемыйУровеньДетализацииИСМП = "ГрупповыеУпаковки" Тогда
		УровеньДетализацииИСМП = 3;
	Иначе
		УровеньДетализацииИСМП = 4;
	КонецЕсли;
	
	РеквизитыВидовПродукцииИС = УТ_11_4_ПолучитьРеквизитыВидовПродукцииИС(Истина);
	Для каждого РеквизитыВидаПродукцииИС ИЗ РеквизитыВидовПродукцииИС Цикл
		
		ВидПродукцииИС = РеквизитыВидаПродукцииИС.Ключ;		
		Маркировка 	   = РеквизитыВидаПродукцииИС.Значение.ЗначениеМаркировки;
		
		Попытка
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Документ1С, ВидПродукцииИС, 0));
		Исключение
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Документ1С, ВидПродукцииИС));
		КонецПопытки;
	
		ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
	    Если ДанныеПроверкиИПодбора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
		
		// Весовая продукция
		ЕстьКолонкаПроизвольнаяЕдиницаУчета = ЕстьРеквизитВКоллекции(ДеревоМаркированнойПродукции.Колонки, "ПроизвольнаяЕдиницаУчета");
		ЕстьКолонкаТребуетВзвешивания 		= ЕстьРеквизитВКоллекции(ДеревоМаркированнойПродукции.Колонки, "ТребуетВзвешивания");
		СоответствиеОписанийНоменклатуры	= Новый Соответствие;
		
		Листья = Новый Массив;
		
		ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья, УровеньДетализацииИСМП);	
		ПолеШтрихкода = "Штрихкод";
		Для каждого Лист Из Листья Цикл		
			
			СтруктураШтрихкодов = ПолучитьПустуюСтруктуруШтрихкодов();		
			ЗаполнитьСтруктуруШтрихкодовИСМП(Лист, СтруктураШтрихкодов, ПолеШтрихкода, Истина);
			
			Родитель = Лист.Родитель;
			Пока Родитель <> Неопределено Цикл		
				ЗаполнитьСтруктуруШтрихкодовИСМП(Родитель, СтруктураШтрихкодов, ПолеШтрихкода);									
				Родитель = Родитель.Родитель;			
			КонецЦикла; 
			
			Если ТипЗнч(Лист.ТипУпаковки) <> Тип("ПеречислениеСсылка.ТипыУпаковок") Тогда
				Продолжить;
			КонецЕсли;
			
			// Весовая продукция
			ОбрабатываемаяНоменклатура = Лист.Номенклатура;
			ПроизвольнаяЕдиницаУчета   = ЕстьКолонкаПроизвольнаяЕдиницаУчета И Лист.ПроизвольнаяЕдиницаУчета;
			ТребуетВзвешивания		   = ЕстьКолонкаТребуетВзвешивания И Лист.ТребуетВзвешивания;
			
			ОбъемноСортовойУчет = СтруктураШтрихкодов.ОбъемноСортовойУчет;
			Если ОбъемноСортовойУчет Тогда
				Продолжить;	
			КонецЕсли;
			Если ТребуетВзвешивания Тогда
				Количество = Лист.Количество;
				Упаковка   = ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(ОбрабатываемаяНоменклатура);
			ИначеЕсли ПроизвольнаяЕдиницаУчета Тогда
				ОписаниеНоменклатуры = СоответствиеОписанийНоменклатуры.Получить(ОбрабатываемаяНоменклатура);
				Если ОписаниеНоменклатуры = Неопределено Тогда
					Попытка
						ОписанияНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(ОбрабатываемаяНоменклатура);
						ОписаниеНоменклатуры = ОписанияНоменклатуры.Получить(ОбрабатываемаяНоменклатура);	
						СоответствиеОписанийНоменклатуры.Вставить(ОбрабатываемаяНоменклатура, ОписаниеНоменклатуры);
					Исключение КонецПопытки;
				КонецЕсли;
				Количество = ?(ОбъемноСортовойУчет, Лист.КоличествоПодчиненныхПотребительскихУпаковок, 1);
				Упаковка   = ?(ОписаниеНоменклатуры <> Неопределено, ОписаниеНоменклатуры.ПотребительскаяУпаковка, ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(ОбрабатываемаяНоменклатура));
			Иначе
				Количество = ?(ОбъемноСортовойУчет ИЛИ ПустаяСтрока(СтруктураШтрихкодов.ШтрихкодПачки),
					Лист.КоличествоПодчиненныхПотребительскихУпаковок, 1);
				Упаковка = ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(ОбрабатываемаяНоменклатура);
			КонецЕсли;
			
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураШтрихкодов);		
			НоваяСтрока.Номенклатура 		= Лист.Номенклатура;
			НоваяСтрока.Характеристика		= Лист.Характеристика;
			Если Не ЗначениеЗаполнено(НоваяСтрока.Номенклатура) 
				И ВДокументеОднаНоменклатура Тогда
				НоваяСтрока.Номенклатура 		= ЕдинственнаяНоменклатура;
				НоваяСтрока.Характеристика		= ЕдинственнаяХарактеристика;	
			Конецесли;
			НоваяСтрока.Упаковка			= Упаковка;
			НоваяСтрока.КоличествоУпаковок 	= Количество;
			НоваяСтрока.КоличествоФакт 		= ?(СтатусыПроверкиВНаличии.Найти(Лист.СтатусПроверки) <> Неопределено, Количество, 0);
			НоваяСтрока.ШтрихкодПары		= ?(ОбъемноСортовойУчет, "", СтруктураШтрихкодов.ШтрихкодПачки);
			НоваяСтрока.Маркировка			= Маркировка;
		КонецЦикла;
		
	КонецЦикла;
	
	//ТаблицаУпаковок = УТ_11_4_ЗаполнитьТаблицуУпаковок_МОТП_ИСМП(ТаблицаДанныхТЧ);
	//
	//Для Каждого СтрокаТЧ Из ТаблицаДанныхТЧ Цикл
	//	Номенклатура 	   = СтрокаТЧ.Номенклатура;
	//	ВидУпаковкиСтрокой = СтрокаТЧ.ВидУпаковкиСтрокой;
	//	
	//	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
	//		Если ЗначениеЗаполнено(ВидУпаковкиСтрокой) И НЕ ВидУпаковкиСтрокой = "Пачка" Тогда
	//			НайденныеСтроки = ТаблицаУпаковок.НайтиСтроки(Новый Структура("Номенклатура, ВидУпаковкиСтрокой", Номенклатура, ВидУпаковкиСтрокой));
	//			Если НайденныеСтроки.Количество() Тогда
	//				СтрокаТЧ.Упаковка = НайденныеСтроки[0].Упаковка;
	//				Продолжить;
	//			КонецЕсли;
	//		КонецЕсли;
	//	
	//		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Упаковка) Тогда
	//			ЕдиницаИзмерения = ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(СтрокаТЧ.Номенклатура);
	//			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
	//				ЕдиницаИзмерения = "шт";
	//        	КонецЕсли;
	//			СтрокаТЧ.Упаковка = ЕдиницаИзмерения;
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;
	
	Возврат ТаблицаДанныхТЧ;
	
КонецФункции

// Формирует данные дополнительной табличной части ТоварыИМарки документа ПриобретениеТоваровУслуг для выгрузки на сервер Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* Документ1С - ДокументСсылка - ссылка на выгружаемый документ
//      * ТекущиеНастройкиMS - Структура - содержит текущие настройки подключения Mobile Smarts
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит данные табличной части документв для выгрузки на сервер Mobile Smarts
Функция УТ_11_4_ПриобретениеТоваровУслуг_ПолучитьТоварыИМарки(СтруктураПараметров) Экспорт
	
	СтруктураПараметров.Вставить("ИмяТабличнойЧасти", 	"ТоварыИМарки");
	СтруктураПараметров.Вставить("ТолькоМаркированные", Истина);
	
	Возврат УТ_11_4_СформироватьТабличнуюЧастьТоварыМарки(СтруктураПараметров);
	
КонецФункции

// Формирует данные дополнительной табличной части ТоварыИМаркиБезОтбора документа ПриобретениеТоваровУслуг для выгрузки на сервер Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* Документ1С - ДокументСсылка - ссылка на выгружаемый документ
//      * ТекущиеНастройкиMS - Структура - содержит текущие настройки подключения Mobile Smarts
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит данные табличной части документв для выгрузки на сервер Mobile Smarts
Функция УТ_11_4_ПриобретениеТоваровУслуг_ПолучитьТоварыИМаркиБезОтбора(СтруктураПараметров) Экспорт
	
	СтруктураПараметров.Вставить("ИмяТабличнойЧасти", 	"ТоварыИМаркиБезОтбора");
	СтруктураПараметров.Вставить("ТолькоМаркированные", Ложь);
	
	Возврат УТ_11_4_СформироватьТабличнуюЧастьТоварыМарки(СтруктураПараметров);
	
КонецФункции

// Формирует данные дополнительной табличной части ТоварыИМарки документа ПриобретениеТоваровУслуг для выгрузки на сервер Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* Документ1С - ДокументСсылка - ссылка на выгружаемый документ
//      * ТекущиеНастройкиMS - Структура - содержит текущие настройки подключения Mobile Smarts
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит данные табличной части документв для выгрузки на сервер Mobile Smarts
Функция УТ_11_4_ПриходныйОрдерНаТовары_ТоварыОрдера(СтруктураПараметров) Экспорт
	
	СтруктураПараметров.Вставить("ИмяТабличнойЧасти", 	"ТоварыОрдера");
	СтруктураПараметров.Вставить("ТолькоМаркированные", Ложь);
	
	Возврат УТ_11_4_СформироватьТабличнуюЧастьТоварыМарки(СтруктураПараметров);
	
КонецФункции

Функция УТ_11_4_СформироватьТабличнуюЧастьТоварыМарки(СтруктураПараметров) Экспорт
	
	Документ1С = СтруктураПараметров.Документ1С;
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	
	ТаблицаДанныхТЧ = Новый ТаблицаЗначений;
	
	КолонкиТаблицыЗначений 	= ТаблицаДанныхТЧ.Колонки;
	КолонкиТаблицыЗначений.Добавить("Номенклатура",    Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Номенклатура.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Упаковка",		   Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("БазоваяЕдиница",  Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Характеристика",  Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Характеристики.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Серия",		   Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Серии.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Назначение",	   Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	КолонкиТаблицыЗначений.Добавить("КодСтроки",	   Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	КолонкиТаблицыЗначений.Добавить("Цена",			   Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)));
	КолонкиТаблицыЗначений.Добавить("Количество",	   Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	КолонкиТаблицыЗначений.Добавить("КоличествоФакт",  Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	КолонкиТаблицыЗначений.Добавить("Маркировка",	   Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ШтрихкодТовара",  Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ШтрихкодБлока",   Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ШтрихкодГруппы",  Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ШтрихкодКоробки", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПалеты",  Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ВидУпаковкиСтрокой", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("ШтрихкодУпаковочногоЛиста", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	//Миронов А.А
	КолонкиТаблицыЗначений.Добавить("АУ_Шифр", 		   Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	КолонкиТаблицыЗначений.Добавить("Дв_НоменклатураПартнера", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
    //Миронов А.А

	ИмяТабличнойЧасти = СтруктураПараметров.ИмяТабличнойЧасти;
	
	// I. Получаем таблицу марок
	
	СтатусыПроверкиВНаличии = Новый Массив;
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияПродукцииИС") <> Неопределено Тогда
		СтатусыПроверкиВНаличии.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии"));
		СтатусыПроверкиВНаличии.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась"));
	КонецЕсли;
	
	ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
	ВыгружаемыйУровеньДетализацииМОТП = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("УровеньДетализацииПриВыгрузкеМОТП"), СтруктураПараметров);
	ВыгружаемыйУровеньДетализацииИСМП = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("УровеньДетализацииПриВыгрузкеИСМП"), СтруктураПараметров);
	
	Если ВыгружаемыйУровеньДетализацииМОТП = "Палеты" Тогда
		УровеньДетализацииМОТП = 1;
	ИначеЕсли ВыгружаемыйУровеньДетализацииМОТП = "Коробки" Тогда
		УровеньДетализацииМОТП = 2;
	ИначеЕсли ВыгружаемыйУровеньДетализацииМОТП = "Блоки" Тогда
		УровеньДетализацииМОТП = 3;
	Иначе
		УровеньДетализацииМОТП = 4;
	КонецЕсли;
	
	Если ВыгружаемыйУровеньДетализацииИСМП = "Палеты" Тогда
		УровеньДетализацииИСМП = 1;
	ИначеЕсли ВыгружаемыйУровеньДетализацииИСМП = "Коробки" Тогда
		УровеньДетализацииИСМП = 2;
	ИначеЕсли ВыгружаемыйУровеньДетализацииИСМП = "ГрупповыеУпаковки" Тогда
		УровеньДетализацииИСМП = 3;
	Иначе
		УровеньДетализацииИСМП = 4;
	КонецЕсли;
	
	ЕстьПродукцияМОТП = Ложь;
	
	ВидыПродукцииМОТП = УТ_11_4_ПолучитьВидыПродукцииМОТП();
	
	РеквизитыВидовПродукцииИС = УТ_11_4_ПолучитьРеквизитыВидовПродукцииИС();
	Для каждого РеквизитыВидаПродукцииИС ИЗ РеквизитыВидовПродукцииИС Цикл
		
		ВидПродукцииИС = РеквизитыВидаПродукцииИС.Ключ;		
		Маркировка 	   = РеквизитыВидаПродукцииИС.Значение.ЗначениеМаркировки;
		
		Попытка
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Документ1С, ВидПродукцииИС, 0));
		Исключение
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Документ1С, ВидПродукцииИС));
		КонецПопытки;
		
		ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
		
		Если ИмяТабличнойЧасти = "ТоварыОрдера"	И ТипЗнч(Документ1С) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			ЗаполнятьКоличествоФакт = Ложь;
		Иначе
			ЗаполнятьКоличествоФакт = Истина;
		КонецЕсли;
			
		Если ДанныеПроверкиИПодбора = Неопределено
			И ТипЗнч(Документ1С) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары")
			И ЗначениеЗаполнено(Документ1С.Распоряжение) Тогда
			Попытка
				РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Документ1С.Распоряжение, ВидПродукцииИС, 0));
			Исключение
				РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Документ1С.Распоряжение, ВидПродукцииИС));
			КонецПопытки;
				
			ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
				
			// Если марки проверены только в документе-основании, не нужно выгружать их проверенными в текущем документе
			ЗаполнятьКоличествоФакт = Ложь;
		КонецЕсли;
		
		Если ДанныеПроверкиИПодбора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
	
		ЭтоПродукцияМОТП = ВидыПродукцииМОТП.Найти(ВидПродукцииИС) <> Неопределено;
		
		Если ЭтоПродукцияМОТП Тогда
			ЕстьПродукцияМОТП = Истина;
		КонецЕсли;
		
		// Весовая продукция
		ЕстьКолонкаПроизвольнаяЕдиницаУчета = ЕстьРеквизитВКоллекции(ДеревоМаркированнойПродукции.Колонки, "ПроизвольнаяЕдиницаУчета");
		ЕстьКолонкаТребуетВзвешивания 		= ЕстьРеквизитВКоллекции(ДеревоМаркированнойПродукции.Колонки, "ТребуетВзвешивания");
		СоответствиеОписанийНоменклатуры	= Новый Соответствие;
		
		Листья = Новый Массив;
		
		ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья, ?(ЭтоПродукцияМОТП, УровеньДетализацииМОТП, УровеньДетализацииИСМП));
		ПолеШтрихкода = "Штрихкод";
		Для каждого Лист Из Листья Цикл		
			
			СтруктураШтрихкодов = ПолучитьПустуюСтруктуруШтрихкодов();		
			Если ЭтоПродукцияМОТП Тогда
				ЗаполнитьСтруктуруШтрихкодовМОТП(Лист, СтруктураШтрихкодов, ПолеШтрихкода, Истина);	
			Иначе	
				ЗаполнитьСтруктуруШтрихкодовИСМП(Лист, СтруктураШтрихкодов, ПолеШтрихкода, Истина);
			КонецЕсли;
			
			Родитель = Лист.Родитель;
			Пока Родитель <> Неопределено Цикл		
				Если ЭтоПродукцияМОТП Тогда
					ЗаполнитьСтруктуруШтрихкодовМОТП(Родитель, СтруктураШтрихкодов, ПолеШтрихкода);
				Иначе
					ЗаполнитьСтруктуруШтрихкодовИСМП(Родитель, СтруктураШтрихкодов, ПолеШтрихкода);
				КонецЕсли;
				Родитель = Родитель.Родитель;
			КонецЦикла; 
			
			Если ТипЗнч(Лист.ТипУпаковки) <> Тип("ПеречислениеСсылка.ТипыУпаковок") Тогда
				Продолжить;
			КонецЕсли;
			
			// Весовая продукция
			ОбрабатываемаяНоменклатура = Лист.Номенклатура;
			ПроизвольнаяЕдиницаУчета   = ЕстьКолонкаПроизвольнаяЕдиницаУчета И Лист.ПроизвольнаяЕдиницаУчета;
			ТребуетВзвешивания		   = ЕстьКолонкаТребуетВзвешивания И Лист.ТребуетВзвешивания;
			БазоваяЕдиница			   = ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(ОбрабатываемаяНоменклатура);
			
			ОбъемноСортовойУчет = СтруктураШтрихкодов.ОбъемноСортовойУчет;
			Если ТребуетВзвешивания Тогда
				Количество = Лист.Количество;
				Упаковка   = БазоваяЕдиница;
			ИначеЕсли ПроизвольнаяЕдиницаУчета Тогда
				ОписаниеНоменклатуры = СоответствиеОписанийНоменклатуры.Получить(ОбрабатываемаяНоменклатура);
				Если ОписаниеНоменклатуры = Неопределено Тогда
					Попытка
						ОписанияНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(ОбрабатываемаяНоменклатура);
						ОписаниеНоменклатуры = ОписанияНоменклатуры.Получить(ОбрабатываемаяНоменклатура);
						СоответствиеОписанийНоменклатуры.Вставить(ОбрабатываемаяНоменклатура, ОписаниеНоменклатуры);
					Исключение КонецПопытки;
				КонецЕсли;
				Количество = ?(ОбъемноСортовойУчет, Лист.КоличествоПодчиненныхПотребительскихУпаковок, 1);
				Упаковка   = ?(ОписаниеНоменклатуры <> Неопределено, ОписаниеНоменклатуры.ПотребительскаяУпаковка, БазоваяЕдиница);
			Иначе
				Количество = ?(ОбъемноСортовойУчет ИЛИ ПустаяСтрока(СтруктураШтрихкодов.ШтрихкодПачки),
					Лист.КоличествоПодчиненныхПотребительскихУпаковок, 1);
				Упаковка = БазоваяЕдиница;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураШтрихкодов);		
			НоваяСтрока.Номенклатура   = Лист.Номенклатура;
			НоваяСтрока.Характеристика = Лист.Характеристика;
			НоваяСтрока.Упаковка	   = Упаковка;
			НоваяСтрока.БазоваяЕдиница = БазоваяЕдиница;
			НоваяСтрока.Количество 	   = Количество;
			НоваяСтрока.КоличествоФакт = ?(ЗаполнятьКоличествоФакт И СтатусыПроверкиВНаличии.Найти(Лист.СтатусПроверки) <> Неопределено, Количество, 0);
			НоваяСтрока.ШтрихкодТовара = ?(ОбъемноСортовойУчет, "", СтруктураШтрихкодов.ШтрихкодПачки);
			НоваяСтрока.Маркировка	   = Маркировка;
		КонецЦикла;
		
	КонецЦикла;
	
	//ТаблицаУпаковок = УТ_11_4_ЗаполнитьТаблицуУпаковок_МОТП_ИСМП(ТаблицаДанныхТЧ);
	//
	//Для Каждого СтрокаТЧ Из ТаблицаДанныхТЧ Цикл
	//	Номенклатура 	   = СтрокаТЧ.Номенклатура;
	//	ВидУпаковкиСтрокой = СтрокаТЧ.ВидУпаковкиСтрокой;
	//	
	//	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
	//		Если ЗначениеЗаполнено(ВидУпаковкиСтрокой) И НЕ ВидУпаковкиСтрокой = "Пачка" Тогда
	//			НайденныеСтроки = ТаблицаУпаковок.НайтиСтроки(Новый Структура("Номенклатура, ВидУпаковкиСтрокой", Номенклатура, ВидУпаковкиСтрокой));
	//			Если НайденныеСтроки.Количество() Тогда
	//				СтрокаТЧ.Упаковка = НайденныеСтроки[0].Упаковка;
	//				Продолжить;
	//			КонецЕсли;
	//		КонецЕсли;
	//	
	//		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Упаковка) Тогда
	//			ЕдиницаИзмерения = ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(СтрокаТЧ.Номенклатура);
	//			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
	//				ЕдиницаИзмерения = "шт";
	//        	КонецЕсли;
	//			СтрокаТЧ.Упаковка = ЕдиницаИзмерения;
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;
		
	// II. Получаем ТЧ Товары
	
	МетаданныеДокумента1С = Документ1С.Метаданные();
	ИмяДокумента = МетаданныеДокумента1С.Имя;
	РеквизитыТЧ  = МетаданныеДокумента1С.ТабличныеЧасти.Товары.Реквизиты;
	
	ЕстьРеквизитНазначение = РеквизитыТЧ.Найти("Назначение") <> Неопределено;
	ЕстьРеквизитКодСтроки  = РеквизитыТЧ.Найти("КодСтроки") <> Неопределено;
	ЕстьРеквизитЦена	   = РеквизитыТЧ.Найти("Цена") <> Неопределено;
	ЕстьТЧСерии			   = МетаданныеДокумента1С.ТабличныеЧасти.Найти("Серии") <> Неопределено;
	ЕстьРеквизитУпаковочныйЛистРодитель = РеквизитыТЧ.Найти("УпаковочныйЛистРодитель") <> Неопределено;
	
	//Миронов А.А
	ЕстьРеквизитАУ_Шифр	   					= РеквизитыТЧ.Найти("АУ_Шифр") 					<> Неопределено; 
	ЕстьРеквизитНоменклатураПартнера	   	= РеквизитыТЧ.Найти("НоменклатураПартнера") 	<> Неопределено;
    //Миронов А.А

	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыДокумента.Номенклатура КАК Номенклатура,
	               |	ТоварыДокумента.Упаковка КАК Упаковка,
	               |	ТоварыДокумента.Характеристика КАК Характеристика,
				   |    //<*ТекстЗаменыНоменклатураПартнера*>
				   |    //<*ТекстЗаменыАУ_Шифр*>
	               |	//<*ТекстЗаменыСерияКоличество*>
				   |	//<*ТекстЗаменыНазначение*>
				   |	//<*ТекстЗаменыКодСтроки*>
				   |	//<*ТекстЗаменыЦена*>
				   |	//<*ТекстЗаменыШтрихкодУпаковочногоЛиста*>
				   |	ВЫБОР //<*ТекстЗаменыИСМП*>
	               |		КОГДА 1 = 1 ТОГДА """"
	               |	КОНЕЦ КАК Маркировка
	               |ИЗ
	               |	Документ." + ИмяДокумента + ".Товары КАК ТоварыДокумента
				   |	//<*ТекстЗаменыЛевоеСоединениеСерии*>
				   |
				   |ГДЕ
	               |	ТоварыДокумента.Ссылка = &Ссылка
				   |	И ТоварыДокумента.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) 
				   |	И ВЫБОР
				   |		КОГДА &ТолькоМаркированныеТовары
				   |			ТОГДА ЕСТЬNULL(ТоварыДокумента.Номенклатура.ОсобенностьУчета, &ПустаяОсобенностьУчета) В (&ОсобенностиУчетаИС)
				   |		ИНАЧЕ ИСТИНА
				   |	КОНЕЦ
				   |";
	
	ТекстЗаменыИСМП 				= "";
	ТекстЗаменыЛевоеСоединениеСерии = "";
	ТекстЗаменыСерияКоличество		= "ТоварыДокумента.Серия КАК Серия,
									  |ТоварыДокумента.КоличествоУпаковок КАК Количество,
									  |ТоварыДокумента.Количество КАК КоличествоВБазовойЕдинице,";
	ТекстЗаменыНазначение			= "НЕОПРЕДЕЛЕНО КАК Назначение,";
	ТекстЗаменыКодСтроки			= "0 КАК КодСтроки,";
	ТекстЗаменыЦена					= "0 КАК Цена,";
	ТекстЗаменыШтрихкодУпаковочногоЛиста = """"" КАК ШтрихкодУпаковочногоЛиста,";
	
	//Миронов А.А
	ТекстЗаменыАУ_Шифр 				= "ТоварыДокумента.АУ_Шифр КАК АУ_Шифр,";
	ТекстЗаменыНоменклатураПартнера = "ТоварыДокумента.НоменклатураПартнера КАК Дв_НоменклатураПартнера,";
	//Миронов А.А

	РеквизитыОсобенностейУчетаИС = УТ_11_4_ПолучитьРеквизитыОсобенностейУчетаИС();
	Для каждого РеквизитыОсобенностиУчета ИЗ РеквизитыОсобенностейУчетаИС Цикл
		ТекстЗаменыИСМП = ТекстЗаменыИСМП 
			+ Символы.ПС
			+ "КОГДА ТоварыДокумента.Номенклатура.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры." + РеквизитыОсобенностиУчета.Значение.Имя + ") "
			+ "ТОГДА """ + РеквизитыОсобенностиУчета.Значение.ЗначениеМаркировки + """";
	КонецЦикла;
	
	Если ЕстьТЧСерии Тогда
		ТекстЗаменыЛевоеСоединениеСерии = 
		"ЛЕВОЕ СОЕДИНЕНИЕ Документ." + ИмяДокумента + ".Серии КАК СерииДокумента
		|	ПО СерииДокумента.Номенклатура = ТоварыДокумента.Номенклатура
		|		И СерииДокумента.Характеристика = ТоварыДокумента.Характеристика
		|		И СерииДокумента.Назначение	= ТоварыДокумента.Назначение
		|		И СерииДокумента.Ссылка	= ТоварыДокумента.Ссылка";
		ТекстЗаменыСерияКоличество = "ЕСТЬNULL(СерииДокумента.Серия, ТоварыДокумента.Серия) КАК Серия,
									 |ВЫБОР
								     |	КОГДА ЕСТЬNULL(ТоварыДокумента.Упаковка.Знаменатель, 0) = 0
								     |		ТОГДА 1
								     |	ИНАЧЕ ТоварыДокумента.Упаковка.Знаменатель
								     |КОНЕЦ /
								     |ВЫБОР
								     |	КОГДА ЕСТЬNULL(ТоварыДокумента.Упаковка.Числитель, 0) = 0
								     |		ТОГДА 1
								     |	ИНАЧЕ ТоварыДокумента.Упаковка.Числитель
								     |КОНЕЦ * 
								     |	ЕСТЬNULL(СерииДокумента.Количество, ТоварыДокумента.Количество) КАК Количество,
									 |ЕСТЬNULL(СерииДокумента.Количество, ТоварыДокумента.Количество) КАК КоличествоВБазовойЕдинице,";
	КонецЕсли;
	
	Если ЕстьРеквизитНазначение Тогда
		ТекстЗаменыНазначение = "ТоварыДокумента.Назначение КАК Назначение,";
	КонецЕсли;
	Если ЕстьРеквизитКодСтроки Тогда
		ТекстЗаменыКодСтроки = "ТоварыДокумента.КодСтроки КАК КодСтроки,";
	КонецЕсли;
	Если ЕстьРеквизитЦена Тогда
		ТекстЗаменыЦена = "ТоварыДокумента.Цена КАК Цена,";
	КонецЕсли;  
	
	//Миронов А.А
	Если ЕстьРеквизитАУ_Шифр Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыАУ_Шифр*>", ТекстЗаменыАУ_Шифр);
	КонецЕсли; 
	
	Если ЕстьРеквизитНоменклатураПартнера Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыНоменклатураПартнера*>", ТекстЗаменыНоменклатураПартнера);
	КонецЕсли; 
	//Миронов А.А 
	
	Если ЕстьРеквизитУпаковочныйЛистРодитель Тогда
		ТекстЗаменыШтрихкодУпаковочногоЛиста = "ЕСТЬNULL(ТоварыДокумента.УпаковочныйЛистРодитель.Код, """") КАК ШтрихкодУпаковочногоЛиста,";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыИСМП*>", 					ТекстЗаменыИСМП);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыЛевоеСоединениеСерии*>",	ТекстЗаменыЛевоеСоединениеСерии);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыСерияКоличество*>",		ТекстЗаменыСерияКоличество);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыНазначение*>",				ТекстЗаменыНазначение);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыКодСтроки*>",				ТекстЗаменыКодСтроки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыЦена*>",					ТекстЗаменыЦена);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//<*ТекстЗаменыШтрихкодУпаковочногоЛиста*>",					ТекстЗаменыШтрихкодУпаковочногоЛиста);
	
	
	Запрос.УстановитьПараметр("Ссылка",						Документ1С.Ссылка);
	Запрос.УстановитьПараметр("ОсобенностиУчетаИС", 		УТ_11_4_ПолучитьОсобенностиУчетаИС());
	Запрос.УстановитьПараметр("ПустаяОсобенностьУчета", 	ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ПустаяСсылка"));
	Запрос.УстановитьПараметр("ТолькоМаркированныеТовары",	СтруктураПараметров.ТолькоМаркированные);
	
	// III. Формируем таблицу для выгрузки	
	
	Товары = Запрос.Выполнить().Выгрузить();
	
	Товары.Колонки.Добавить("КоличествоРаспределено", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	Товары.Колонки.Добавить("Распределено",			  Новый ОписаниеТипов("Булево"));
	
	Товары.ЗаполнитьЗначения(0,    "КоличествоРаспределено");
	Товары.ЗаполнитьЗначения(Ложь, "Распределено");
	
	СворачиватьСтрокиПослеФормированияТЧ = Ложь;
	
	Для каждого ТекСтрока ИЗ ТаблицаДанныхТЧ Цикл
		
		СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Распределено", ТекСтрока.Номенклатура, ТекСтрока.Характеристика, Ложь);
		
		// Весовая продукция
		КоличествоВПотребительскойУпаковке = 1;
		Если ТекСтрока.Упаковка = ТекСтрока.БазоваяЕдиница Тогда
			РаспределяемоеКоличество = ТекСтрока.Количество;
		Иначе
			ОписаниеНоменклатуры = СоответствиеОписанийНоменклатуры.Получить(ТекСтрока.Номенклатура);
			Если ОписаниеНоменклатуры <> Неопределено
				И ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке > 0 Тогда
				КоличествоВПотребительскойУпаковке = ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке;
			ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Упаковка) Тогда
				Числитель 	= ТекСтрока.Упаковка.Числитель;
				Знаменатель = ТекСтрока.Упаковка.Знаменатель;
				КоличествоВПотребительскойУпаковке = Числитель / ?(Знаменатель = 0, 1, Знаменатель);
			КонецЕсли;
			
			РаспределяемоеКоличество = ТекСтрока.Количество * КоличествоВПотребительскойУпаковке;
		КонецЕсли;
		
		НайденныеСтроки = Товары.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			
			КоличествоПоСтроке = Мин(РаспределяемоеКоличество, НайденнаяСтрока.КоличествоВБазовойЕдинице - НайденнаяСтрока.КоличествоРаспределено);
			
			ЗаполнитьЗначенияСвойств(ТекСтрока, НайденнаяСтрока, "Серия, Цена, Назначение, КодСтроки");
			
			НайденнаяСтрока.КоличествоРаспределено = НайденнаяСтрока.КоличествоРаспределено + КоличествоПоСтроке;
			Если НайденнаяСтрока.КоличествоРаспределено >= НайденнаяСтрока.КоличествоВБазовойЕдинице Тогда
				НайденнаяСтрока.Распределено = Истина;
			КонецЕсли;
			
			ОсталосьРаспределить = РаспределяемоеКоличество - КоличествоПоСтроке;
			Если ОсталосьРаспределить > 0 Тогда
				// Количество, которое не удалось распределить по текущей строке, помещаем в новую строку в конец таблицы для дальнейшего распределения
				НовСтрока = ТаблицаДанныхТЧ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока,, "Серия, Цена, Назначение, КодСтроки");
				
				ТекСтрока.Количество = КоличествоПоСтроке / КоличествоВПотребительскойУпаковке;
				НовСтрока.Количество = ОсталосьРаспределить / КоличествоВПотребительскойУпаковке;
				ТекСтрока.КоличествоФакт = ?(ТекСтрока.КоличествоФакт, ТекСтрока.Количество, 0);
				НовСтрока.КоличествоФакт = ?(НовСтрока.КоличествоФакт, НовСтрока.Количество, 0);
				
				СворачиватьСтрокиПослеФормированияТЧ = Истина;
			КонецЕсли;
		Иначе
			СтруктураПоиска = Новый Структура("Номенклатура, Характеристика", ТекСтрока.Номенклатура, ТекСтрока.Характеристика);	
			
			// Если все строки уже заполнены марками, то "лишние" марки привязываем к последней подходящей строке
			НайденныеСтроки = Товары.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() Тогда
			    НайденнаяСтрока = НайденныеСтроки[НайденныеСтроки.Количество() - 1];
				НайденнаяСтрока.КоличествоРаспределено = НайденнаяСтрока.КоличествоРаспределено + РаспределяемоеКоличество;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
		
	// IV. Добавляем в таблицу для выгрузки строки, по которым нет марок
	
	Для каждого ТекСтрока ИЗ Товары Цикл
	
		Если ТекСтрока.КоличествоВБазовойЕдинице > ТекСтрока.КоличествоРаспределено
			ИЛИ НЕ ТекСтрока.Распределено Тогда
			
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			// Если часть строки распределена, выгружаем оставшееся количество в базовой единице измерения
			Если ТекСтрока.КоличествоРаспределено > 0 Тогда
				ЕдиницаИзмерения = ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(ТекСтрока.Номенклатура);
				Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					ЕдиницаИзмерения = "шт";
				КонецЕсли;
				НоваяСтрока.Упаковка	   = ЕдиницаИзмерения;
				НоваяСтрока.БазоваяЕдиница = ЕдиницаИзмерения;
				
				НоваяСтрока.Количество = ТекСтрока.КоличествоВБазовойЕдинице - ТекСтрока.КоличествоРаспределено;
			КонецЕсли;
	
		КонецЕсли;
		
	КонецЦикла;
	
	// Если при распределении количества строки таблицы марок разделились по нескольким строкам ТЧ Товары, имеет смысл свернуть получившуюся таблицу
	Если СворачиватьСтрокиПослеФормированияТЧ Тогда
		КолонкиДляСворачивания = "";
		Для каждого Колонка ИЗ КолонкиТаблицыЗначений Цикл
			ИмяКолонки = Колонка.Имя;
			Если ИмяКолонки = "Количество" ИЛИ ИмяКолонки = "КоличествоФакт" Тогда
				Продолжить;
			КонецЕсли;
			
			КолонкиДляСворачивания = КолонкиДляСворачивания + ?(ПустаяСтрока(КолонкиДляСворачивания), "", ", ") + ИмяКолонки;
		КонецЦикла;
		ТаблицаДанныхТЧ.Свернуть(КолонкиДляСворачивания, "Количество, КоличествоФакт");
	КонецЕсли;
	
	Возврат ТаблицаДанныхТЧ;
	
КонецФункции

Функция УТ_11_4_ЗаполнитьТаблицуУпаковок_МОТП_ИСМП(ТаблицаДанныхТЧ)

	ТребуетсяПолучениеУпаковок = Ложь;
	Если ТаблицаДанныхТЧ.Найти("Блок", "ВидУпаковкиСтрокой") <> Неопределено Тогда
		ТребуетсяПолучениеУпаковок = Истина;
	ИначеЕсли ТаблицаДанныхТЧ.Найти("Коробка", "ВидУпаковкиСтрокой") <> Неопределено Тогда
		ТребуетсяПолучениеУпаковок = Истина;
	ИначеЕсли ТаблицаДанныхТЧ.Найти("Палета", "ВидУпаковкиСтрокой") <> Неопределено Тогда
		ТребуетсяПолучениеУпаковок = Истина;
	ИначеЕсли ТаблицаДанныхТЧ.Найти("Группа", "ВидУпаковкиСтрокой") <> Неопределено Тогда
		ТребуетсяПолучениеУпаковок = Истина;
	КонецЕсли;
	
	ТаблицаУпаковок = Новый ТаблицаЗначений;
	
	Если НЕ ТребуетсяПолучениеУпаковок Тогда
		Возврат ТаблицаУпаковок;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТаблицаДанныхТЧ.Номенклатура КАК Номенклатура,
	               |	ТаблицаДанныхТЧ.Маркировка КАК Маркировка
	               |ПОМЕСТИТЬ ТаблицаДанныхТЧ
	               |ИЗ
	               |	&ТаблицаДанныхТЧ КАК ТаблицаДанныхТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДанныхТЧ.Номенклатура КАК Номенклатура,
	               |	ТаблицаДанныхТЧ.Маркировка КАК Маркировка,
	               |	ВЫРАЗИТЬ(ТаблицаДанныхТЧ.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВЫРАЗИТЬ(ТаблицаДанныхТЧ.Номенклатура КАК Справочник.Номенклатура).НаборУпаковок КАК НаборУпаковок
	               |ПОМЕСТИТЬ ВТ_Номенклатура
	               |ИЗ
	               |	ТаблицаДанныхТЧ КАК ТаблицаДанныхТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	               |	ВТ_Номенклатура.Маркировка КАК Маркировка,
	               |	УпаковкиЕдиницыИзмерения.Ссылка КАК Упаковка,
	               |	УпаковкиЕдиницыИзмерения.Наименование КАК НаименованиеУпаковки,
	               |	УпаковкиЕдиницыИзмерения.Числитель / ВЫБОР
	               |		КОГДА УпаковкиЕдиницыИзмерения.Знаменатель = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ УпаковкиЕдиницыИзмерения.Знаменатель
	               |	КОНЕЦ КАК КоэффициентУпаковки
	               |ПОМЕСТИТЬ ВТ_НоменклатураУпаковки
	               |ИЗ
	               |	ВТ_Номенклатура КАК ВТ_Номенклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	               |		ПО (ВЫБОР
	               |				КОГДА ВТ_Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ПустаяСсылка)
	               |					ТОГДА УпаковкиЕдиницыИзмерения.Ссылка = ВТ_Номенклатура.ЕдиницаИзмерения
	               |				КОГДА ВТ_Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
	               |					ТОГДА УпаковкиЕдиницыИзмерения.Владелец = ВТ_Номенклатура.Номенклатура
	               |				ИНАЧЕ УпаковкиЕдиницыИзмерения.Владелец = ВТ_Номенклатура.НаборУпаковок
	               |			КОНЕЦ)
	               |			И (НЕ УпаковкиЕдиницыИзмерения.ПометкаУдаления)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НоменклатураУпаковки.Номенклатура КАК Номенклатура,
	               |	ВТ_НоменклатураУпаковки.Упаковка КАК Упаковка,
	               |	ВЫБОР
	               |		КОГДА ВТ_НоменклатураУпаковки.КоэффициентУпаковки = 1
	               |			ТОГДА ""Пачка""
	               |		КОГДА ВТ_НоменклатураУпаковки.КоэффициентУпаковки > 1
	               |				И ВТ_НоменклатураУпаковки.НаименованиеУпаковки ПОДОБНО ""Кор%""
	               |			ТОГДА ""Коробка""
	               |		КОГДА ВТ_НоменклатураУпаковки.КоэффициентУпаковки МЕЖДУ 2 И 20
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВТ_НоменклатураУпаковки.Маркировка = ""Табак""
	               |						ТОГДА ""Блок""
	               |					ИНАЧЕ ""Группа""
	               |				КОНЕЦ
	               |		КОГДА ВТ_НоменклатураУпаковки.КоэффициентУпаковки МЕЖДУ 21 И 500
	               |			ТОГДА ""Коробка""
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК ВидУпаковкиСтрокой
	               |ИЗ
	               |	ВТ_НоменклатураУпаковки КАК ВТ_НоменклатураУпаковки";
	Запрос.УстановитьПараметр("ТаблицаДанныхТЧ", ТаблицаДанныхТЧ);
		
	ТаблицаУпаковок = Запрос.Выполнить().Выгрузить();
		
	Возврат ТаблицаУпаковок;
	
КонецФункции

// Формирует данные дополнительной табличной части ТоварыОтборРазмещение документа ОтборРазмещениеТоваров для выгрузки на сервер Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* Документ1С - ДокументСсылка - ссылка на выгружаемый документ
//      * ТекущиеНастройкиMS - Структура - содержит текущие настройки подключения Mobile Smarts
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит данные табличной части документв для выгрузки на сервер Mobile Smarts
Функция УТ_11_4_ОтборРазмещениеТоваров_ПолучитьТоварыОтборРазмещение(СтруктураПараметров) Экспорт
	
	Документ1С = СтруктураПараметров.Документ1С;
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	
	ТаблицаДанныхТЧ = Новый ТаблицаЗначений;
	
	КолонкиТаблицыЗначений 	= ТаблицаДанныхТЧ.Колонки;
	КолонкиТаблицыЗначений.Добавить("Номенклатура",			Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Номенклатура.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Упаковка",				Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Характеристика",		Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Характеристики.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Серия",				Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Серии.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("Назначение",			Новый ОписаниеТипов("СправочникСсылка.Назначения")); // При необходимости проверить наличие в метаданных
	КолонкиТаблицыЗначений.Добавить("ЯчейкаОтбор",			Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Ячейки.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("ЯчейкаРазмещение",		Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.Ячейки.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("УпаковкаРазмещение",	Новый ОписаниеТипов("СправочникСсылка." + МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника));
	КолонкиТаблицыЗначений.Добавить("КоличествоПлан",		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыОтбор.Номенклатура КАК Номенклатура,
	               |	ТоварыОтбор.Упаковка КАК Упаковка,
	               |	ТоварыОтбор.Характеристика КАК Характеристика,
	               |	ТоварыОтбор.Серия КАК Серия,
	               |	ТоварыОтбор.Назначение КАК Назначение,
	               |	ТоварыОтбор.Ячейка КАК Ячейка,
	               |	ТоварыОтбор.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ТоварыОтбор.Количество КАК КоличествоБазовое,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТоварыОтбор.Упаковка.Числитель, 0) = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ТоварыОтбор.Упаковка.Числитель
	               |	КОНЕЦ / ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТоварыОтбор.Упаковка.Знаменатель, 0) = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ТоварыОтбор.Упаковка.Знаменатель
	               |	КОНЕЦ КАК КоэффициентУпаковки
	               |ИЗ
	               |	Документ.ОтборРазмещениеТоваров.ТоварыОтбор КАК ТоварыОтбор
	               |ГДЕ
	               |	ТоварыОтбор.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТоварыРазмещение.Номенклатура КАК Номенклатура,
	               |	ТоварыРазмещение.Упаковка КАК Упаковка,
	               |	ТоварыРазмещение.Характеристика КАК Характеристика,
	               |	ТоварыРазмещение.Серия КАК Серия,
	               |	ТоварыРазмещение.Назначение КАК Назначение,
	               |	ТоварыРазмещение.Ячейка КАК Ячейка,
	               |	ТоварыРазмещение.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ТоварыРазмещение.Количество КАК КоличествоБазовое,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТоварыРазмещение.Упаковка.Числитель, 0) = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ТоварыРазмещение.Упаковка.Числитель
	               |	КОНЕЦ / ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТоварыРазмещение.Упаковка.Знаменатель, 0) = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ТоварыРазмещение.Упаковка.Знаменатель
	               |	КОНЕЦ КАК КоэффициентУпаковки,
	               |	ВЫБОР
	               |		КОГДА ТоварыРазмещение.Количество = 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Размещено
	               |ИЗ
	               |	Документ.ОтборРазмещениеТоваров.ТоварыРазмещение КАК ТоварыРазмещение
	               |ГДЕ
	               |	ТоварыРазмещение.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СтруктураПараметров.Документ1С);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// 1. Получить данные ТЧ Отбор и ТЧ Размещение (количество в базовой единице)
	ТаблицаОтбор 		= Результат[0].Выгрузить();
	ТаблицаРазмещение 	= Результат[1].Выгрузить();
	
	// 2. Дополнить данные ТЧ Отбор данными ТЧ Размещение путем построчного перебора
	Для каждого СтрокаОтбор ИЗ ТаблицаОтбор Цикл
		
		// 2.1. Если в строке отбора не заполнено количество, добавляем ее без попытки подобрать ячейку размещения
		Если СтрокаОтбор.КоличествоБазовое = 0 Тогда
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбор);
			
			НоваяСтрока.ЯчейкаОтбор			= СтрокаОтбор.Ячейка;
			НоваяСтрока.ЯчейкаРазмещение	= Неопределено;
			НоваяСтрока.УпаковкаРазмещение	= Неопределено;
			НоваяСтрока.КоличествоПлан		= 0;
			
			Продолжить;
		КонецЕсли;
		
		// 2.2. Пробуем найти полное соответствие с учетом упаковки и количества (размещение того же количества в той же упаковке)
		СтруктураОтбора = Новый Структура("Номенклатура, Упаковка, Характеристика, Серия, Назначение, КоличествоБазовое");
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаОтбор);
		СтруктураОтбора.Вставить("Размещено", Ложь);
		
		НайденныеСтроки = ТаблицаРазмещение.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество() Тогда
			СтрокаРазмещение = НайденныеСтроки[0];
			
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбор);
			
			НоваяСтрока.ЯчейкаОтбор			= СтрокаОтбор.Ячейка;
			НоваяСтрока.ЯчейкаРазмещение	= СтрокаРазмещение.Ячейка;
			НоваяСтрока.УпаковкаРазмещение	= СтрокаРазмещение.Упаковка;
			НоваяСтрока.КоличествоПлан		= СтрокаОтбор.КоличествоУпаковок;
			
			СтрокаОтбор.КоличествоУпаковок = 0;
			СтрокаОтбор.КоличествоБазовое  = 0;
			
			СтрокаРазмещение.КоличествоУпаковок = 0;
			СтрокаРазмещение.КоличествоБазовое	= 0;
			СтрокаРазмещение.Размещено		   	= Истина;
			
			Продолжить;
		КонецЕсли;
		
		// 2.3. Пробуем найти соответствие с учетом упаковки и без учета количества (размещение в той же упаковке, но с разбиением по количеству)
		СтруктураОтбора.Удалить("КоличествоБазовое");
		
		НайденныеСтроки = ТаблицаРазмещение.НайтиСтроки(СтруктураОтбора);
		Для каждого СтрокаРазмещение ИЗ НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбор);
			
			РаспределяемоеКоличество = Мин(СтрокаОтбор.КоличествоУпаковок, СтрокаРазмещение.КоличествоУпаковок);
			КоличествоУпаковок = РаспределяемоеКоличество;
			КоличествоБазовое  = РаспределяемоеКоличество * СтрокаОтбор.КоэффициентУпаковки;
			
			НоваяСтрока.ЯчейкаОтбор			= СтрокаОтбор.Ячейка;
			НоваяСтрока.ЯчейкаРазмещение	= СтрокаРазмещение.Ячейка;
			НоваяСтрока.УпаковкаРазмещение	= СтрокаРазмещение.Упаковка;
			НоваяСтрока.КоличествоПлан		= КоличествоУпаковок;
			
			СтрокаОтбор.КоличествоУпаковок = СтрокаОтбор.КоличествоУпаковок - КоличествоУпаковок;
			СтрокаОтбор.КоличествоБазовое  = СтрокаОтбор.КоличествоБазовое - КоличествоБазовое;
			
			СтрокаРазмещение.КоличествоУпаковок = СтрокаРазмещение.КоличествоУпаковок - КоличествоУпаковок;
			СтрокаРазмещение.КоличествоБазовое	= СтрокаРазмещение.КоличествоБазовое - КоличествоБазовое;
			СтрокаРазмещение.Размещено			= СтрокаРазмещение.КоличествоБазовое = 0;
			
			Если СтрокаОтбор.КоличествоБазовое = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаОтбор.КоличествоБазовое = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// 2.4. Пробуем найти соответствие без учета упаковки и количества (размещение в другой упаковке)
		СтруктураОтбора.Удалить("Упаковка");
		
		НайденныеСтроки = ТаблицаРазмещение.НайтиСтроки(СтруктураОтбора);
		Для каждого СтрокаРазмещение ИЗ НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбор);
			
			РаспределяемоеКоличество = Мин(СтрокаОтбор.КоличествоБазовое, СтрокаРазмещение.КоличествоБазовое);
			КоличествоУпаковок = РаспределяемоеКоличество / СтрокаОтбор.КоэффициентУпаковки;
			КоличествоБазовое  = РаспределяемоеКоличество;
			
			НоваяСтрока.ЯчейкаОтбор			= СтрокаОтбор.Ячейка;
			НоваяСтрока.ЯчейкаРазмещение	= СтрокаРазмещение.Ячейка;
			НоваяСтрока.УпаковкаРазмещение	= СтрокаРазмещение.Упаковка;
			НоваяСтрока.КоличествоПлан		= КоличествоУпаковок;
			
			СтрокаОтбор.КоличествоУпаковок = СтрокаОтбор.КоличествоУпаковок - КоличествоУпаковок;
			СтрокаОтбор.КоличествоБазовое  = СтрокаОтбор.КоличествоБазовое - КоличествоБазовое;
			
			СтрокаРазмещение.КоличествоУпаковок = СтрокаРазмещение.КоличествоУпаковок - РаспределяемоеКоличество / СтрокаРазмещение.КоэффициентУпаковки;
			СтрокаРазмещение.КоличествоБазовое	= СтрокаРазмещение.КоличествоБазовое - КоличествоБазовое;
			СтрокаРазмещение.Размещено			= СтрокаРазмещение.КоличествоБазовое = 0;
			
			Если СтрокаОтбор.КоличествоБазовое = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// 2.5. Дополнить итоговую таблицу нераспределенными строками ТЧ Отбор
		Если СтрокаОтбор.КоличествоБазовое > 0 Тогда
			НоваяСтрока = ТаблицаДанныхТЧ.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбор);
			
			НоваяСтрока.ЯчейкаОтбор			= СтрокаОтбор.Ячейка;
			НоваяСтрока.ЯчейкаРазмещение	= Неопределено;
			НоваяСтрока.УпаковкаРазмещение	= Неопределено;
			НоваяСтрока.КоличествоПлан		= РаспределяемоеКоличество / СтрокаОтбор.КоэффициентУпаковки;
			
			СтрокаОтбор.КоличествоУпаковок = 0;
			СтрокаОтбор.КоличествоБазовое  = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	// 3. Нераспределенные строки ТЧ Размещение не выгружаем
	
	Возврат ТаблицаДанныхТЧ;
	
КонецФункции

