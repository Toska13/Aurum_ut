//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_АктПереоценки_ПослеЗаполненияТЧ_Товары		(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);	

	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;		
	Товары			= Док1СРезультат.Товары;
	ВидыЦен			= Док1СРезультат.ВидыЦен;	
	
	ВидЦеныПоУмолчанию = ИО_ВидЦены(СтруктураПараметров);
	
	Если НЕ ВидЦеныПоУмолчанию.Пустая() Тогда
		
		Для каждого СтрокаТовары Из СтруктураПараметров.ТЧ Цикл			
			Если СтрокаТовары.ВидЦены.Пустая() Тогда
				СтрокаТовары.ВидЦены = ВидЦеныПоУмолчанию;				
			КонецЕсли;
			
			Если ВидыЦен.Найти(СтрокаТовары.ВидЦены, "ВидЦены") = Неопределено Тогда
				СтрокаВидыЦен = ВидыЦен.Добавить();	
				СтрокаВидыЦен.ВидЦены = СтрокаТовары.ВидЦены;
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли;
	
