		СтруктураПолейТЧ.Вставить("СтранаПроисхождения");
	КонецЕсли;
		
	Если СтруктураДействий.Свойство("ЗаполнитьТипСклада", СтруктураПараметровДействия) Тогда
		СтруктураПолейТЧ.Вставить(СтруктураПараметровДействия.Склад);
	КонецЕсли;
		
	// {{ Локализация_УправлениеТорговлейДляБеларуси
	Если Найти(ВРег(СокрЛП(Метаданные.Имя)), ВРег(СокрЛП("УправлениеТорговлейДляБеларуси"))) Тогда
		УТ_11_2_ЗаполнитьСтруктуруПолей(СтруктураПолейТЧ, СтруктураДействий);
	КонецЕсли;	
	// Локализация_УправлениеТорговлейДляБеларуси }}	
	
	ЗаполнитьЗначенияСвойств(СтруктураПолейТЧ,ТекущаяСтрока);
	
	// необходимо для заполнения склада в ТЧ Товары
	СтруктураПолейТЧ.Вставить("ТипНоменклатуры", ТекущаяСтрока.Номенклатура.ТипНоменклатуры);	
	
	Возврат СтруктураПолейТЧ;
	
КонецФункции

Процедура УТ_11_2_ЗаполнитьСтруктуруПолей(СтруктураПолейТЧ, СтруктураДействий)

	СтруктураПолейТЧ.Вставить("ЦенаСоСкидкой");
	СтруктураПолейТЧ.Вставить("Скидка");
	Если СтруктураДействий.Свойство("ЗаполнитьСтавкуТорговойНадбавки") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");    
		СтруктураПолейТЧ.Вставить("Характеристика");
		СтруктураПолейТЧ.Вставить("СтавкаТН");
		СтруктураПолейТЧ.Вставить("СуммаТН");
	КонецЕсли; 
	Если СтруктураДействий.Свойство("ЗаполнитьРозничнуюСтавкуНДС") Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("РозничнаяСтавкаНДС");
	КонецЕсли;
	Если СтруктураДействий.Свойство("РассчитатьРозничнуюЦену") 
		ИЛИ СтруктураДействий.Свойство("РассчитатьСтавкуСуммуТорговойНадбавки")Тогда
		СтруктураПолейТЧ.Вставить("Номенклатура");
		СтруктураПолейТЧ.Вставить("РозничнаяСтавкаНДС");
		СтруктураПолейТЧ.Вставить("СуммаТН");
		СтруктураПолейТЧ.Вставить("СтавкаТН");
		СтруктураПолейТЧ.Вставить("РозничнаяСуммаНДС");
		СтруктураПолейТЧ.Вставить("РозничнаяЦенаБезНДС");
		СтруктураПолейТЧ.Вставить("РозничнаяЦена");
		СтруктураПолейТЧ.Вставить("Цена");
		СтруктураПолейТЧ.Вставить("Сумма");
		СтруктураПолейТЧ.Вставить("СуммаНДС");
		СтруктураПолейТЧ.Вставить("РозничнаяЦенаСУчетомОкругления");
		СтруктураПолейТЧ.Вставить("Округление");		
	КонецЕсли;	

КонецПроцедуры

// Устарела. Оставлена для обратной совместимости, т.к. вызывается из произвольных кодов в бизнес-процессах
// Выполняет поиск упаковки номенклатуры по штрихкоду, наименованию и владельцу
//
// Параметры:
//	НаименованиеУпаковки - Строка - наименование упаковки	
//  Номенклатура - СправочникСсылка.Номенклатура - владелец упаковки
//  Штрихкод - Строка - штрихкод упаковки
//
// Возвращаемое значение:
//	- СправочникСсылка.УпаковкиЕдиницыИзмерения - найденная упаковка
//	- Неопределено - если упаковку найти не удалось
Функция УТ_11_2_НайтиУпаковкуПоНаименованиюИВладельцу(Знач НаименованиеУпаковки, Номенклатура, Штрихкод = "") Экспорт
	
	Возврат УТ_11_2_НайтиУпаковкуНоменклатуры(НаименованиеУпаковки, Номенклатура, Штрихкод);
	
КонецФункции	

// Выполняет поиск упаковки номенклатуры по штрихкоду, наименованию и владельцу
//
// Параметры:
//	НаименованиеУпаковки - Строка - наименование упаковки	
//  Номенклатура - СправочникСсылка.Номенклатура - владелец упаковки
//  Штрихкод - Строка - штрихкод упаковки
//
// Возвращаемое значение:
//	- СправочникСсылка.УпаковкиЕдиницыИзмерения - найденная упаковка
//	- Неопределено - если упаковку найти не удалось
Функция УТ_11_2_НайтиУпаковкуНоменклатуры(Знач НаименованиеУпаковки, Номенклатура, Штрихкод = "") Экспорт
	
	Упаковка = Неопределено;
	
	// Если штрихкод заполнен, то сначала ищем по штрихкоду
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		
		Упаковка = УТ_11_2_НайтиУпаковкуПоШтрихкоду(Штрихкод);	
		
		Если Упаковка <> Неопределено Тогда
			Возврат Упаковка;					
		КонецЕсли; 
			
	КонецЕсли;					
	
	// Если по штрихкоду не нашли, то начинаем искать по наименованию	
	Если НЕ ЗначениеЗаполнено(НаименованиеУпаковки) Тогда
		Возврат Упаковка;
	КонецЕсли;
	
	ПозицияСтроки = Найти(НаименованиеУпаковки, "_") - 1;
	
	// Убираем у наименования упаковки все символы, начиная с "_"
	// Например "шт_1" => "шт", иначе не найдем упаковку по наименованию
	Если ПозицияСтроки > 0 Тогда
		НаименованиеУпаковки = Лев(НаименованиеУпаковки, ПозицияСтроки);
	КонецЕсли;			
	
	// Если у номенклатуры заполнена базовая ЕИ и наименование упаковки совпадает с наименованием базовой ЕИ, то возвращаем базовую ЕИ
	Если ЗначениеЗаполнено(Номенклатура.ЕдиницаИзмерения) И ВРег(СокрЛП(НаименованиеУпаковки)) = ВРег(СокрЛП(Номенклатура.ЕдиницаИзмерения)) Тогда	
		
		Упаковка = УТ_11_2_ПолучитьБазовуюУпаковкуНоменклатуры(Номенклатура);			
		
	// Иначе - ищем упаковку по наименованию и владельцу ("Набор упаковок" либо "Номенклатура")			
	Иначе			
				
		Упаковка = УТ_11_2_ПолучитьУпаковкуПоНаименованиюИВладельцу(НаименованиеУпаковки, Номенклатура);								
		
	КонецЕсли;			

	Возврат Упаковка;
	
КонецФункции

// Выполняет поиск упаковки номенклатуры по наименованию и владельцу
//
// Параметры:
//	НаименованиеУпаковки - Строка - наименование упаковки	
//  Номенклатура - СправочникСсылка.Номенклатура - владелец упаковки
//
// Возвращаемое значение:
//	- СправочникСсылка.УпаковкиЕдиницыИзмерения - найденная упаковка
//	- Неопределено - если упаковку найти не удалось
Функция УТ_11_2_ПолучитьУпаковкуПоНаименованиюИВладельцу(Знач НаименованиеУпаковки, Номенклатура) Экспорт
	
	Упаковка = Неопределено;		
	
	Если НЕ ЗначениеЗаполнено(НаименованиеУпаковки) Тогда
			
		Упаковка = Неопределено;			
	
	ИначеЕсли УТ_11_2_ИспользуютсяУпаковки(Номенклатура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	%ИмяСправочникаУпаковки%.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%ИмяСправочникаУпаковки% КАК %ИмяСправочникаУпаковки%
		|ГДЕ
		|	(%ИмяСправочникаУпаковки%.Владелец = &Номенклатура
		|			ИЛИ %ИмяСправочникаУпаковки%.Владелец = &НаборУпаковок)
		|	И %ИмяСправочникаУпаковки%.Наименование = &Наименование";
		
		Запрос.УстановитьПараметр("Номенклатура", 	Номенклатура);
		Запрос.УстановитьПараметр("НаборУпаковок", 	Номенклатура.НаборУпаковок);
		Запрос.УстановитьПараметр("Наименование", 	СокрЛП(НаименованиеУпаковки));
		
		МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ИмяСправочникаУпаковки%", МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда						
			Упаковка = Выборка.Ссылка;						
		Иначе						
			Упаковка = Неопределено;						
		КонецЕсли;	
		
	Иначе
		
		Упаковка = Неопределено;
		
	КонецЕсли;							
	
	Возврат Упаковка;	
	
КонецФункции	

// Выполняет поиск упаковки номенклатуры по коэффициенту и владельцу
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - владелец упаковки
//  Коэффициент - Число - коэффициент упаковки
//
// Возвращаемое значение:
//	- СправочникСсылка.УпаковкиЕдиницыИзмерения - найденная упаковка
//	- Неопределено - если упаковку найти не удалось
Функция УТ_11_2_ПолучитьУпаковкуПоКоэффициентуИВладельцу(Номенклатура, Коэффициент = 1) Экспорт
	
	Упаковка = Неопределено;
	
	Если УТ_11_2_ИспользуютсяУпаковки(Номенклатура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	%ИмяСправочникаУпаковки%.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%ИмяСправочникаУпаковки% КАК %ИмяСправочникаУпаковки%
		|ГДЕ
		|	(%ИмяСправочникаУпаковки%.Владелец = &Номенклатура
		|			ИЛИ %ИмяСправочникаУпаковки%.Владелец = &НаборУпаковок)
		|	И ВЫБОР
		|			КОГДА %ИмяСправочникаУпаковки%.Числитель = 0
		|				ТОГДА 1
		|			ИНАЧЕ %ИмяСправочникаУпаковки%.Числитель
		|		КОНЕЦ / ВЫБОР
		|			КОГДА %ИмяСправочникаУпаковки%.Знаменатель = 0
		|				ТОГДА 1
		|			ИНАЧЕ %ИмяСправочникаУпаковки%.Знаменатель
		|		КОНЕЦ = &Коэффициент";
			
		
		Запрос.УстановитьПараметр("Номенклатура", 	Номенклатура);
		Запрос.УстановитьПараметр("НаборУпаковок", 	Номенклатура.НаборУпаковок);
		Запрос.УстановитьПараметр("Коэффициент", 	Коэффициент);
		
		МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ИмяСправочникаУпаковки%", МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда						
			Упаковка = Выборка.Ссылка;						
		Иначе						
			Упаковка = Неопределено;						
		КонецЕсли;	
		
	Иначе
		
		Упаковка = Неопределено;
		
	КонецЕсли;							
	
	Возврат Упаковка;
	
КонецФункции	

// Возвращает флаг использования упаковок для переданной номенклатуры
//
// Параметры:
//	Номенклатура - СправочникСсылка.Номенклатура	
//
// Возвращаемое значение: 
//	Булево
Функция УТ_11_2_ИспользуютсяУпаковки(Номенклатура) Экспорт

	Результат = Ложь;
	
	ИспользоватьУпаковкиНоменклатуры = ПолучитьФункциональнуюОпциюНаСервере("ИспользоватьУпаковкиНоменклатуры");
	
	Если ИспользоватьУпаковкиНоменклатуры <> Неопределено И ИспользоватьУпаковкиНоменклатуры Тогда				
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			
			Результат = Ложь;
			Сообщить("Ошибка при заполнении упаковки. Причина: не заполнена номенклатура");									
			
		Иначе	
			
			Если НЕ Номенклатура.ИспользоватьУпаковки И НЕ Номенклатура.ВидНоменклатуры.ИспользоватьУпаковки Тогда
				
				Результат = Ложь;
				
			Иначе	
									
				Результат = Истина;
					
			КонецЕсли;	
			
		КонецЕсли;
		
	Иначе
		
		Результат = Ложь;
		
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции
 
// Заполняет упаковку либо единицу измерения в зависимости от учета в разрезе Склада/Товаров/Документа
// Сделать - дописать функцию согласно задаче "PRODUCTS-930 - УТ11.х Заполнение упаковки либо единицы измерения в зависимости от учета в разрезе Склада/Товаров/документа"
//
// Параметры:
//	НаименованиеУпаковки - Строка - наименование упаковки	
//  Номенклатура - СправочникСсылка.Номенклатура - владелец упаковки
//
// Возвращаемое значение:
//	Неопределено
Функция УТ_11_2_ОпределитьЗаполнениеУпаковки(Знач НаименованиеУпаковки, Номенклатура) Экспорт
	
	Упаковка 				= УТ_11_2_ПолучитьУпаковкуПоНаименованиюИВладельцу(НаименованиеУпаковки, Номенклатура);
	
	Коэффициент 			= ?(Упаковка.Числитель <> 0, Упаковка.Числитель, 1) / ?(Упаковка.Знаменатель <> 0, Упаковка.Знаменатель, 1);
	
	БазоваяУпаковка 		= УТ_11_2_ПолучитьБазовуюУпаковкуНоменклатуры(Номенклатура);
	
	УпаковкаСКоэффициентом1 = УТ_11_2_ПолучитьУпаковкуПоКоэффициентуИВладельцу(Номенклатура, 1);	

КонецФункции

// Возвращает базовую единицу измерения для переданной номенклатуры
//
// Параметры:
//	Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//
// Возвращаемое значение:
//	СправочникСсылка.УпаковкиЕдиницыИзмерения
Функция УТ_11_2_ПолучитьБазовуюУпаковкуНоменклатуры(Номенклатура) Экспорт

	Возврат Номенклатура.ЕдиницаИзмерения;

КонецФункции

// Выполняет поиск упаковки номенклатуры по штрихкоду
//
// Параметры:
//	Штрихкод - Строка - штрихкод номенклатуры
//
// Возвращаемое значение:
//	- СправочникСсылка.УпаковкиЕдиницыИзмерения	- найденная упаковка
//	- Неопределено - если не удалось найти упаковку
Функция УТ_11_2_НайтиУпаковкуПоШтрихкоду(Штрихкод) Экспорт
	
	Упаковка = Неопределено;
	
	СтруктураШтрихкода = ШтрихКодЕстьВБазе(Штрихкод, Истина); 
	
	Если ТипЗнч(СтруктураШтрихкода) = Тип("Структура") И ЗначениеЗаполнено(СтруктураШтрихкода.Упаковка) Тогда
		
		Упаковка = СтруктураШтрихкода.Упаковка;						
		
	Иначе
		
		Упаковка = Неопределено;
		
	КонецЕсли;	
	
	Возврат Упаковка;
	
КонецФункции	

// Возвращает числовой код для печати штрихкода
//
// Параметры:
//	Ссылка - ЛюбаяСсылка - ссылка на объект, по которому нужно получить код
//	
// Возвращаемое значение:
//	Строка - строка из чисел, соотвествующая переданной ссылке
Функция УТ_11_2_ЧисловойКодПоСсылке(Ссылка) Экспорт
	ШестнадчатиричноеЧисло = СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()),"-","");
	Возврат УТ_11_2_ПреобразоватьИзШестнадцатиричнойСистемыСчисленияВДесятичноеЧисло(ШестнадчатиричноеЧисло);
КонецФункции

// Получает ссылку по штрихкоду табличного документа
//
// Параметры:
//	Штрихкод - Строка - штрихкод
//	Менеджеры - Массив из ДокументМенеджер - менеджеры документов
// 
// Возвращаемое значение:
//  Массив из ДокументСсылка - ссылки на документы
Функция УТ_11_2_ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Штрихкод, Менеджеры = Неопределено) Экспорт
		
	Если СокрЛП(Штрихкод) = "" Тогда
		Возврат Новый Массив;
	КонецЕсли;	
	
	// в УНФ в качестве штрихкода сразу приходит уникальный идентификатор
	Попытка			
		
		Идентификатор = Новый УникальныйИдентификатор(Штрихкод);	
		Идентификатор = Штрихкод;
		
	// в УТ 11 и её потомках приходит десятичное число	
	Исключение
		
		ШтрихкодВШестнаднадцатиричномВиде = УТ_11_2_ПреобразоватьДесятичноеЧислоВШестнадцатиричнуюСистемуСчисления(Число(Штрихкод));
		
		Пока СтрДлина(ШтрихкодВШестнаднадцатиричномВиде) < 32 Цикл
			ШтрихкодВШестнаднадцатиричномВиде = "0" + ШтрихкодВШестнаднадцатиричномВиде;
		КонецЦикла;
		
		Идентификатор =
		Сред(ШтрихкодВШестнаднадцатиричномВиде, 1,  8)
		+ "-" + Сред(ШтрихкодВШестнаднадцатиричномВиде, 9,  4)
		+ "-" + Сред(ШтрихкодВШестнаднадцатиричномВиде, 13, 4)
		+ "-" + Сред(ШтрихкодВШестнаднадцатиричномВиде, 17, 4)
		+ "-" + Сред(ШтрихкодВШестнаднадцатиричномВиде, 21, 12);
		
	КонецПопытки; 
		
	Если СтрДлина(Идентификатор) <> 36 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если Менеджеры = Неопределено Тогда
		
		МенеджерыОбъектов = Новый Массив;
		
		Для Каждого ЭлементМетаданных Из Метаданные.Документы Цикл
			МенеджерыОбъектов.Добавить(Документы[ЭлементМетаданных.Имя]);
		КонецЦикла;
		
	Иначе
		
		МенеджерыОбъектов = Новый Массив;
		
		Для Каждого ПустаяСсылка Из Менеджеры Цикл
			
			ТипСсылки = ТипЗнч(ПустаяСсылка);
			
			Если Документы.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
				
				МенеджерыОбъектов.Добавить(Документы[ПустаяСсылка.Метаданные().Имя]);
				
			ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
				
				МенеджерыОбъектов.Добавить(Справочники[ПустаяСсылка.Метаданные().Имя]);
				
			ИначеЕсли Задачи.ТипВсеСсылки(ТипСсылки) Тогда	
				
				МенеджерыОбъектов.Добавить(Задачи[ПустаяСсылка.Метаданные().Имя]);
				
			ИначеЕсли БизнесПроцессы.ТипВсеСсылки(ТипСсылки) Тогда	
				
				МенеджерыОбъектов.Добавить(БизнесПроцессы[ПустаяСсылка.Метаданные().Имя]);
				
			ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки(ТипСсылки) Тогда
				
				МенеджерыОбъектов.Добавить(ПланыВидовХарактеристик[ПустаяСсылка.Метаданные().Имя]);
				
			Иначе
				
				ТекстИсключения = НСтр("ru = 'Ошибка распознавания штрихкода: тип ""%Тип%"" не поддерживается.'");
				ТекстИсключения = СтрЗаменить(ТекстИсключения,"%Тип%",ТипСсылки);
				
				ВызватьИсключение ТекстИсключения;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МассивСсылок = Новый Массив;
	ПервыйЗапрос = Истина;
	
	Для Каждого Менеджер Из МенеджерыОбъектов Цикл
		
		Попытка
			Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Исключение
			Продолжить;
		КонецПопытки;
		
		МетаданныеСсылки = Ссылка.Метаданные();
		
		Если Не ПравоДоступа("Чтение", МетаданныеСсылки) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСсылок.Добавить(Ссылка);
		
		Если НЕ ПервыйЗапрос Тогда
			Запрос.Текст = Запрос.Текст + 
			"ОБЪЕДИНИТЬ ВСЕ
			|";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ" + ?(ПервыйЗапрос," " + "РАЗРЕШЕННЫЕ" + " "," ") + "Таблица.Ссылка КАК Ссылка
		|ИЗ " + МетаданныеСсылки.ПолноеИмя() + " КАК Таблица
		|ГДЕ Ссылка В (&МассивСсылок)
		|";
		
		ПервыйЗапрос = Ложь;
		
	КонецЦикла;
	
	Если Не ПервыйЗапрос Тогда
		Запрос.Параметры.Вставить("МассивСсылок", МассивСсылок);
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	
КонецФункции

Функция УТ_11_2_ПреобразоватьДесятичноеЧислоВШестнадцатиричнуюСистемуСчисления(Знач ДесятичноеЧисло)
	
	Результат = "";
	
	Пока ДесятичноеЧисло > 0 цикл
		ОстатокОтДеления = ДесятичноеЧисло % 16;
		ДесятичноеЧисло  = (ДесятичноеЧисло - ОстатокОтДеления) / 16;
		Результат        = Сред("0123456789abcdef", ОстатокОтДеления + 1, 1) + Результат;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
                                                                                                     
Функция УТ_11_2_ПреобразоватьИзШестнадцатиричнойСистемыСчисленияВДесятичноеЧисло(Знач Значение)
	
	Значение = НРег(Значение);
	ДлинаСтроки = СтрДлина(Значение);
	
	Результат = 0;
	Для НомерСимвола = 1 По ДлинаСтроки Цикл
		Результат = Результат * 16 + Найти("0123456789abcdef", Сред(Значение, НомерСимвола, 1)) - 1;
	КонецЦикла;
	
	Возврат Формат(Результат, "ЧГ=0");
	
КонецФункции

// Выполняет поиск/создание серии номенклатуры при загрузке документа из базы Mobile Smarts 
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура                  - содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Структура          - содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - СтрокаТаблицыЗначений       - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтрокаТабличнойЧастиДокументаТСД - Структура  - содержит данные загружаемой строки документа Mobile Smarts
//		* СтруктураПоискаКлючаСвязи - Структура         - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
//
// Возвращаемое значение:
//	СправочникСсылка.СерииНоменклатуры
Функция УТ_11_2_НайтиСоздатьСериюНоменклатуры(СтруктураПараметров) Экспорт
	
	ИмяСобытия = "УТ_11_2_НайтиСоздатьСериюНоменклатуры";
	
	СтрокаТЧ 						 = СтруктураПараметров.СтрокаДокумента;
	СтрокаТабличнойЧастиДокументаТСД = СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;	
	ИмяТабличнойЧасти				 = СтруктураПараметров.ИмяТабличнойЧасти;
	
	СерийныйНомер	= ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("СН"), СокрЛП(СтрокаТабличнойЧастиДокументаТСД.СН), "");	
	ПолеИдСерии 	= ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("ИдСерии"), "ИдСерии", ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("id"), "id", ""));	
	ИдСерии 		= ?(Не ПустаяСтрока(ПолеИдСерии), СокрЛП(СтрокаТабличнойЧастиДокументаТСД[ПолеИдСерии]), "");
	
    // Для маркируемой продуцкии в поле СН содержится идентификатор экземпляра (21)XXXX...
	// Серию не создаем
	ЭтоМаркируемаяПродукцияБезСерии = ИО_ЭтоМаркируемаяПродукцияБезСерии(СтрокаТабличнойЧастиДокументаТСД, СтруктураПараметров); 
	Если ЭтоМаркируемаяПродукцияБезСерии И НЕ ЗначениеЗаполнено(ИдСерии) Тогда
		Возврат Неопределено;
	КонецЕсли;                                                                                                                                  
	
	ВидНоменклатуры = ?(СтрокаТЧ.Номенклатура.ВидНоменклатуры.НастройкиСерийБерутсяИзДругогоВидаНоменклатуры,
		СтрокаТЧ.Номенклатура.ВидНоменклатуры.ВладелецСерий,
		СтрокаТЧ.Номенклатура.ВидНоменклатуры);
		
	ПустаяСерия = ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");
	
	Если ИмяТабличнойЧасти = "Товары" И ЗначениеЗаполнено(СерийныйНомер) И НЕ ЗначениеЗаполнено(ИдСерии) 
		И Не ВидНоменклатуры.НастройкаИспользованияСерий = ПредопределенноеЗначение("Перечисление.НастройкиИспользованияСерийНоменклатуры.ЭкземплярТовара") Тогда		
		Возврат ПустаяСерия;
	КонецЕсли;	
		
	Номер 	 		 = "";
	ИмяСерии 		 = "";
	ДатаСерии		 = Дата(1,1,1);
	СрокГодности	 = Дата(1,1,1);
	ДатаПроизводства = Дата(1,1,1);
	
	Если СтруктураПараметров.ДокументТСД.Свойство("Серии") Тогда
		
		СтрокаТабличнойЧастиСерии = НайтиЭлементМассива(СтруктураПараметров.ДокументТСД.Серии, "Ид", ИдСерии);
		Если СтрокаТабличнойЧастиСерии = Неопределено Тогда
			СтрокаТабличнойЧастиСерии = НайтиЭлементМассива(СтруктураПараметров.ДокументТСД.Серии, "id", ИдСерии);
		КонецЕсли;		
		
        Если СтрокаТабличнойЧастиСерии <> Неопределено Тогда
			
            Номер = ?(СтрокаТабличнойЧастиСерии.Свойство("Номер"), СокрЛП(СтрокаТабличнойЧастиСерии.Номер), "");
			Если ПустаяСтрока(Номер) Тогда
				Номер = ?(СтрокаТабличнойЧастиСерии.Свойство("nomer"), СокрЛП(СтрокаТабличнойЧастиСерии["nomer"]), "");
			КонецЕсли;                                                                                                          			
			
            ИмяСерии = ?(СтрокаТабличнойЧастиСерии.Свойство("ИмяСерии"), СокрЛП(СтрокаТабличнойЧастиСерии.ИмяСерии), "");
			Если ПустаяСтрока(ИмяСерии) Тогда
				ИмяСерии = ?(СтрокаТабличнойЧастиСерии.Свойство("imyaSerii"), СокрЛП(СтрокаТабличнойЧастиСерии["imyaSerii"]), "");
			КонецЕсли;
			
            Если СтрокаТабличнойЧастиСерии.Свойство("ДатаСерии") Тогда 
				Если ТипЗнч(СтрокаТабличнойЧастиСерии.ДатаСерии) = Тип("Строка") И НЕ ПустаяСтрока(СтрокаТабличнойЧастиСерии.ДатаСерии) Тогда
					ДатаСерии = НачалоДня(ПрочитатьДатуJSON(СтрокаТабличнойЧастиСерии.ДатаСерии, ФорматДатыJSON.ISO));
				ИначеЕсли ТипЗнч(СтрокаТабличнойЧастиСерии.ДатаСерии) = Тип("Дата") Тогда
					ДатаСерии = СтрокаТабличнойЧастиСерии.ДатаСерии;
				КонецЕсли;	            	 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДатаСерии) Тогда
				ДатаСерии = ?(СтрокаТабличнойЧастиСерии.Свойство("dataSerii"), СтрокаТабличнойЧастиСерии["dataSerii"], Дата(1,1,1));
				Если НЕ ТипЗнч(ДатаСерии) = Тип("Дата") Тогда
					ДатаСерии = НачалоДня(ПрочитатьДатуJSON(ДатаСерии, ФорматДатыJSON.ISO));
				КонецЕсли;
			КонецЕсли;
			
        КонецЕсли;            
        
    Иначе
        
        СтрокаТабличнойЧастиСерии = Неопределено;
        
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СерийныйНомер) И НЕ ЭтоМаркируемаяПродукцияБезСерии Тогда
		
		Попытка
			Серия = Справочники["СерииНоменклатуры"].НайтиПоРеквизиту("Номер", СерийныйНомер);
		Исключение
			Серия = ПустаяСерия;
		КонецПопытки;		
		
		Если Серия.Пустая() ИЛИ Серия.ПолучитьОбъект() = Неопределено Тогда
			
			СерияОбъект					= Справочники["СерииНоменклатуры"].СоздатьЭлемент();
			СерияОбъект.Номер   		= СерийныйНомер;			
			СерияОбъект.ВидНоменклатуры = ВидНоменклатуры;		
			
			Если НЕ ЗначениеЗаполнено(СерияОбъект.ВидНоменклатуры) Тогда 
				СерияОбъект.ВидНоменклатуры = Справочники["ВидыНоменклатуры"].ВидНоменклатурыПоУмолчанию();
			КонецЕсли;
			
			СерияОбъект.Записать();
			
			Серия = СерияОбъект.Ссылка;
						
		КонецЕсли;	
		
	ИначеЕсли ЗначениеЗаполнено(ИдСерии) Тогда
		
		Попытка
			Серия = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСерии));
		Исключение
			Серия = ПустаяСерия;
		КонецПопытки; 		
		
		Если Серия.Пустая() ИЛИ Серия.ПолучитьОбъект() = Неопределено Тогда
			
			Попытка
				ИспользуетсяНомерСерии 	 	 = ВидНоменклатуры.ИспользоватьНомерСерии;
				ИспользуетсяСрокГодности 	 = ВидНоменклатуры.ИспользоватьСрокГодностиСерии;
				ИспользуетсяДатаПроизводства = ВидНоменклатуры.ИспользоватьДатуПроизводстваСерии;
			Исключение
				ИспользуетсяНомерСерии 	 	 = Истина;
				ИспользуетсяСрокГодности 	 = Истина;
				ИспользуетсяДатаПроизводства = Истина;
			КонецПопытки;
			
			// Дата производства
			ДатаРегистрацииСтрокаТСД = Неопределено;
			Если ИспользуетсяДатаПроизводства
				И СтрокаТабличнойЧастиДокументаТСД.Свойство("ДатаРегистрации", ДатаРегистрацииСтрокаТСД) Тогда
				Если ТипЗнч(ДатаРегистрацииСтрокаТСД) = Тип("Строка") И НЕ ПустаяСтрока(ДатаРегистрацииСтрокаТСД) Тогда
					ДатаПроизводства = НачалоДня(ПрочитатьДатуJSON(ДатаРегистрацииСтрокаТСД, ФорматДатыJSON.ISO));
				ИначеЕсли ТипЗнч(ДатаРегистрацииСтрокаТСД) = Тип("Дата") Тогда
					ДатаПроизводства = ДатаРегистрацииСтрокаТСД;
				КонецЕсли;
			КонецЕсли;
			
			// Срок годности
			Если ИспользуетсяСрокГодности Тогда
				СрокГодностиСтрокаТСД = Неопределено;
				Если СтрокаТабличнойЧастиДокументаТСД.Свойство("СрокГодности", СрокГодностиСтрокаТСД) Тогда
					Если ТипЗнч(СрокГодностиСтрокаТСД) = Тип("Строка") И НЕ ПустаяСтрока(СрокГодностиСтрокаТСД) Тогда
						СрокГодности = НачалоДня(ПрочитатьДатуJSON(СрокГодностиСтрокаТСД, ФорматДатыJSON.ISO));
					ИначеЕсли ТипЗнч(СрокГодностиСтрокаТСД) = Тип("Дата") Тогда
						СрокГодности = СрокГодностиСтрокаТСД;
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СрокГодности) И ЗначениеЗаполнено(ДатаСерии) Тогда
					СрокГодности = ДатаСерии;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СрокГодности)	И ЗначениеЗаполнено(ДатаПроизводства) Тогда
					Попытка
						РеквизитыСрокаГодности = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.Номенклатура, "СрокГодности, ЕдиницаИзмеренияСрокаГодности");
						
						Если ЗначениеЗаполнено(РеквизитыСрокаГодности.СрокГодности) Тогда
							Если РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Сутки") Тогда
								СрокГодности = ДатаПроизводства + РеквизитыСрокаГодности.СрокГодности * 86400;
							ИначеЕсли РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Час") Тогда
								СрокГодности = ДатаПроизводства + РеквизитыСрокаГодности.СрокГодности * 3600;
							ИначеЕсли РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Месяц") Тогда
								СрокГодности = ДобавитьМесяц(ДатаПроизводства, РеквизитыСрокаГодности.СрокГодности);
							ИначеЕсли РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Год") Тогда
								СрокГодности = ДобавитьМесяц(ДатаПроизводства, РеквизитыСрокаГодности.СрокГодности * 12);
							КонецЕсли;
						КонецЕсли;
					Исключение
						ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
					
				Если НЕ ЗначениеЗаполнено(СрокГодности) Тогда	
					СрокГодностиМожетБытьВключенВКМ = ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("Маркировка"), СтрокаТабличнойЧастиДокументаТСД.Маркировка, "") = "Молоко";
					Если СрокГодностиМожетБытьВключенВКМ Тогда
						СрокГодности = УТ_11_2_ПолучитьСрокГодностиИзGS1Марка(СтруктураПараметров);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ИспользуетсяНомерСерии И ЗначениеЗаполнено(Номер) 
				ИЛИ ИспользуетсяСрокГодности И ЗначениеЗаполнено(СрокГодности)
				ИЛИ ИспользуетсяДатаПроизводства И ЗначениеЗаполнено(ДатаПроизводства) Тогда
			
				Запрос = Новый Запрос("ВЫБРАТЬ
				                      |	СерииНоменклатуры.Ссылка КАК Ссылка
				                      |ИЗ
				                      |	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
				                      |ГДЕ
				                      |	НЕ СерииНоменклатуры.ПометкаУдаления
				                      |	И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
				                      |	И &УсловиеСрокГодности
				                      |	И &УсловиеНомерСерии
									  |	И &УсловиеДатаПроизводства");
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНомерСерии",
					?(ИспользуетсяНомерСерии И ЗначениеЗаполнено(Номер), "СерииНоменклатуры.Номер = &Номер", "ИСТИНА"));
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСрокГодности",
					?(ИспользуетсяСрокГодности И ЗначениеЗаполнено(СрокГодности), "СерииНоменклатуры.ГоденДо = &СрокГодности", "ИСТИНА"));
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДатаПроизводства",
					?(ИспользуетсяДатаПроизводства И ЗначениеЗаполнено(ДатаПроизводства), "СерииНоменклатуры.ДатаПроизводства = &ДатаПроизводства", "ИСТИНА"));
					
				Запрос.УстановитьПараметр("Номер", 				Номер);
				Запрос.УстановитьПараметр("ВидНоменклатуры", 	ВидНоменклатуры);
				Запрос.УстановитьПараметр("СрокГодности", 		СрокГодности);
				Запрос.УстановитьПараметр("ДатаПроизводства",	ДатаПроизводства);
				
				Выборка = Запрос.Выполнить().Выбрать();		
				
				Если Выборка.Следующий() Тогда
					
					Серия = Выборка.Ссылка;
					
				Иначе
					
					Если НЕ ЗначениеЗаполнено(ИмяСерии)	Тогда
						ИмяСерии = ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("ИмяСерии"), СтрокаТабличнойЧастиДокументаТСД.ИмяСерии, "");
						Если ИспользуетсяДатаПроизводства И ЗначениеЗаполнено(ДатаПроизводства) Тогда
							ИмяСерии = ИмяСерии + ?(ПустаяСтрока(ИмяСерии), "", " ") + "от " + Формат(ДатаПроизводства, "ДФ=dd.MM.yy");
						КонецЕсли;
						Если ИспользуетсяСрокГодности И ЗначениеЗаполнено(СрокГодности) Тогда
							ИмяСерии = ИмяСерии + ?(ПустаяСтрока(ИмяСерии), "", " ") + "до " + Формат(СрокГодности, "ДФ=dd.MM.yy");
						КонецЕсли;
					КонецЕсли;
					
					СерияОбъект					 = Справочники["СерииНоменклатуры"].СоздатьЭлемент();
					СерияОбъект.Наименование	 = ИмяСерии;
					СерияОбъект.Номер   		 = Номер;
					СерияОбъект.ГоденДо   		 = СрокГодности;
					СерияОбъект.ДатаПроизводства = ДатаПроизводства;
					СерияОбъект.ВидНоменклатуры  = ВидНоменклатуры;
					
					Если НЕ ЗначениеЗаполнено(СерияОбъект.ВидНоменклатуры) Тогда
						СерияОбъект.ВидНоменклатуры = Справочники["ВидыНоменклатуры"].ВидНоменклатурыПоУмолчанию();
					КонецЕсли;
					
					СерияОбъект.Записать();
					
					Серия = СерияОбъект.Ссылка;
					
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;	
	
	Иначе
		
		Серия = ПустаяСерия;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Серия) И Серия.ПолучитьОбъект() <> Неопределено Тогда
		СтрокаТабличнойЧастиДокументаТСД.Вставить("ИдНайденнойСерии", СокрЛП(Серия.УникальныйИдентификатор()));
	КонецЕсли;
	
	Возврат Серия;
	
КонецФункции

Функция ИО_ЭтоМаркируемаяПродукцияБезСерии(СтрокаДокумента, СтруктураПараметров)
	
	Перем Кэш_МаркировкаНоменклатуры;
	
	ИмяСобытия = "ИО_ЭтоМаркируемаяПродукцияБезСерии";
	
	ДокументТСД = СтруктураПараметров.ДокументТСД;
	Если НЕ ДокументТСД.Свойство("Кэш_МаркировкаНоменклатуры", Кэш_МаркировкаНоменклатуры) Тогда
		Кэш_МаркировкаНоменклатуры =
			Новый Соответствие;
		ДокументТСД.Вставить("Кэш_МаркировкаНоменклатуры", Кэш_МаркировкаНоменклатуры);
	КонецЕсли;
	
	ИмяПоляМаркировка = "";	
	ИмяПоляМаркировка = ?(СтрокаДокумента.Свойство("Маркировка"), "Маркировка", ИмяПоляМаркировка);
	ИмяПоляМаркировка = ?(СтрокаДокумента.Свойство("Markirovka"), "Markirovka", ИмяПоляМаркировка);
	
	МаркировкаСтроки = "";
	Если НЕ ПустаяСтрока(ИмяПоляМаркировка) Тогда
		МаркировкаСтроки = СтрокаДокумента[ИмяПоляМаркировка];
	КонецЕсли;
		
	Если ПустаяСтрока(МаркировкаСтроки)
		ИЛИ МаркировкаСтроки = "ИСМП" Тогда
		// Необходимо учитывать вариант, когда при записи сканированных коробок или КМ остатков маркировка строки не заполняется в факте
		Попытка
			МаркировкаСтроки = Кэш_МаркировкаНоменклатуры.Получить(СтрокаДокумента.ИдТовара);
			Если МаркировкаСтроки = Неопределено Тогда
				МаркировкаСтроки = ИО_МаркировкаПоНоменклатуре(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаДокумента.ИдТовара)));	
					
				Кэш_МаркировкаНоменклатуры.Вставить(СтрокаДокумента.ИдТовара, МаркировкаСтроки);
			КонецЕсли;
		Исключение	
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(МаркировкаСтроки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
		
КонецФункции

Функция УТ_11_2_ПолучитьВидЦеныПоУмолчанию()

	//ВидЦеныПоУмолчанию = Вычислить("Справочники.ВидыЦен.ВидЦеныПоУмолчанию(Неопределено)");
	ВидЦеныПоУмолчанию = Справочники["ВидыЦен"].ВидЦеныПоУмолчанию(Неопределено);
	
	Если ВидЦеныПоУмолчанию.Пустая() Тогда		
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВидыЦен.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ВидыЦен КАК ВидыЦен
			|ГДЕ
			|	НЕ ВидыЦен.ПометкаУдаления";
		
		Выборка = Запрос.Выполнить().Выбрать();				
		
		Если Выборка.Следующий() Тогда
			ВидЦеныПоУмолчанию = Выборка.Ссылка;	
		КонецЕсли;	
		
	КонецЕсли;	

	Возврат ВидЦеныПоУмолчанию;
	
КонецФункции

Процедура УТ_11_2_ЗаполнитьСериюНоменклатурыВСтрокеТабличнойЧасти(СтруктураПараметров, ИмяТЧСерии = "Серии", ИмяПоляСклад = "Склад") Экспорт
	
	СтрокаТЧ 		= СтруктураПараметров.СтрокаДокумента;
	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;	
	ИмяТЧ			= СтруктураПараметров.ИмяТабличнойЧасти;	
	ТабличнаяЧасть  = Док1СРезультат[ИмяТЧ];	
	КолонкиТЧ 		= ТабличнаяЧасть.ВыгрузитьКолонки().Колонки;		
	РеквизитыШапки 	= Док1СРезультат.Метаданные().Реквизиты;		
	
	Если ЕстьРеквизитВКоллекции(КолонкиТЧ, "Серия")
		И (НЕ ЗначениеЗаполнено(СтрокаТЧ.Серия)
			ИЛИ ГлЯдро_СтрНайти(СокрЛП(СтрокаТЧ.Серия), "бъект не найден")
			ИЛИ ГлЯдро_СтрНайти(СокрЛП(СтрокаТЧ.Серия), "bject not found")) Тогда
		СтрокаТЧ.Серия = УТ_11_2_НайтиСоздатьСериюНоменклатуры(СтруктураПараметров);
	КонецЕсли;	
	
	Если ЕстьРеквизитВКоллекции(КолонкиТЧ, ИмяПоляСклад)
		И НЕ ЗначениеЗаполнено(СтрокаТЧ[ИмяПоляСклад])
		И ЕстьРеквизитВКоллекции(РеквизитыШапки, ИмяПоляСклад) Тогда
		СтрокаТЧ[ИмяПоляСклад] = Док1СРезультат[ИмяПоляСклад];
	КонецЕсли;		
	
	ЭтоТабличнаяЧастьСерии = ВРег(СокрЛП(ИмяТЧ)) = ВРег(ИмяТЧСерии);
	
	Если ЭтоТабличнаяЧастьСерии
		И ЕстьРеквизитВКоллекции(КолонкиТЧ, "Серия")
		И (НЕ ЗначениеЗаполнено(СтрокаТЧ.Серия)
			ИЛИ ГлЯдро_СтрНайти(СокрЛП(СтрокаТЧ.Серия), "бъект не найден")
			ИЛИ ГлЯдро_СтрНайти(СокрЛП(СтрокаТЧ.Серия), "bject not found")) Тогда
		СтруктураПараметров.ТЧ.Удалить(СтрокаТЧ);
	КонецЕсли;
	
	Если НЕ ЭтоТабличнаяЧастьСерии
		И ЕстьРеквизитВКоллекции(КолонкиТЧ, "Серия")
		И ЗначениеЗаполнено(СтрокаТЧ.Серия)
		И УТ_11_2_ВЭтомСтатусеСерииУказываютсяВТЧСерии(СтруктураПараметров) Тогда
		// Если серии указываются в отдельной табличной части, то заполнять их в других табличных частях не нужно
		СтрокаТЧ.Серия = Справочники["СерииНоменклатуры"].ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

Функция УТ_11_2_ВЭтомСтатусеСерииУказываютсяВТЧСерии(СтруктураПараметров)

	ИмяСобытия = "УТ_11_2_ВЭтомСтатусеСерииУказываютсяВТЧСерии";
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	СтрокаТЧ	   = СтруктураПараметров.СтрокаДокумента;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
	
	КэшированныеЗначения = ?(ДокументТСД.Свойство("КэшСтатусовУказанияСерий"), ДокументТСД.КэшСтатусовУказанияСерий, Неопределено);
	Если КэшированныеЗначения = Неопределено Тогда
		КэшированныеЗначения = Новый Соответствие;
		
		ДокументТСД.Вставить("КэшСтатусовУказанияСерий", КэшированныеЗначения);
	Иначе
		ВЭтомСтатусеСерииУказываютсяВТЧСерии = КэшированныеЗначения.Получить(СтрокаТЧ.Номенклатура);
		Если ВЭтомСтатусеСерииУказываютсяВТЧСерии <> Неопределено Тогда
			Возврат ВЭтомСтатусеСерииУказываютсяВТЧСерии;	
		КонецЕсли;
	КонецЕсли;
	
	ВЭтомСтатусеСерииУказываютсяВТЧСерии = Ложь;
	Попытка
		ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(ИО_ОбщийМодуль("НоменклатураСервер").ПараметрыУказанияСерий(Док1СРезультат, Документы[Док1СРезультат.Метаданные().Имя]));
		
		Если НЕ ПараметрыУказанияСерий.Свойство("ПолноеИмяОбъекта") Тогда
			КэшированныеЗначения.Вставить(СтрокаТЧ.Номенклатура, Ложь);
			
			Возврат Ложь;
		КонецЕсли;
		
		// Создание вспомогательных таблиц товаров и серий скопировано из типового метода НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий
		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Номенклатура",		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаТоваров.Колонки.Добавить("Характеристика",	Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ТаблицаТоваров.Колонки.Добавить("Серия",			Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
		ТаблицаТоваров.Колонки.Добавить("Количество",		Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный)));
		ТаблицаТоваров.Колонки.Добавить("НомерСтроки",		Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,0,ДопустимыйЗнак.Неотрицательный)));
		ИО_ОбщийМодуль("НоменклатураСервер").ДополнитьТаблицуКолонкамиПоПолямПараметровУказанияСерий(ПараметрыУказанияСерий, ТаблицаТоваров);
			
		СтрокаТовара = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовара, СтрокаТЧ);
		СтрокаТовара.НомерСтроки = 1;
			
		ТаблицаСерий = Новый ТаблицаЗначений;
		ТаблицаСерий.Колонки.Добавить("Номенклатура",		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаСерий.Колонки.Добавить("Характеристика",		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ТаблицаСерий.Колонки.Добавить("Серия",				Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
		ТаблицаСерий.Колонки.Добавить("Назначение",			Новый ОписаниеТипов("СправочникСсылка.Назначения"));
		ТаблицаСерий.Колонки.Добавить("Количество",			Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный)));
		ИО_ОбщийМодуль("НоменклатураСервер").ДополнитьТаблицуКолонкамиПоПолямПараметровУказанияСерий(ПараметрыУказанияСерий, ТаблицаСерий);
			
		// Передавать документ полностью не имеет смысла, т.к. в нем еще нет обрабатываемой строки, поэтому передаем аналогичную структуру с одной строкой
		СтруктураСтатусовУказанияСерий = Новый Структура;
		СтруктураСтатусовУказанияСерий.Вставить(ПараметрыУказанияСерий.ИмяТЧТовары, ТаблицаТоваров);
		СтруктураСтатусовУказанияСерий.Вставить(ПараметрыУказанияСерий.ИмяТЧСерии, 	ТаблицаСерий);
			
		Если ПараметрыУказанияСерий.ИмяПоляСкладОтправитель <> Неопределено
			И ПараметрыУказанияСерий.ИмяПоляСкладПолучатель <> Неопределено Тогда
			СтруктураСтатусовУказанияСерий.Вставить(ПараметрыУказанияСерий.ИмяПоляСкладОтправитель, Док1СРезультат[ПараметрыУказанияСерий.ИмяПоляСкладОтправитель]);
			СтруктураСтатусовУказанияСерий.Вставить(ПараметрыУказанияСерий.ИмяПоляСкладПолучатель,  Док1СРезультат[ПараметрыУказанияСерий.ИмяПоляСкладПолучатель]);
		КонецЕсли;
		Если ПараметрыУказанияСерий.ИмяПоляСклад <> Неопределено Тогда
			СтруктураСтатусовУказанияСерий.Вставить(ПараметрыУказанияСерий.ИмяПоляСклад,			Док1СРезультат[ПараметрыУказанияСерий.ИмяПоляСклад]);
		КонецЕсли;
			
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(СтруктураСтатусовУказанияСерий, ПараметрыУказанияСерий);
			
		ВЭтомСтатусеСерииУказываютсяВТЧСерии = ИО_ОбщийМодуль("НоменклатураКлиентСервер").ВЭтомСтатусеСерииУказываютсяВТЧСерии(ТаблицаТоваров[0].СтатусУказанияСерий, ПараметрыУказанияСерий);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	КэшированныеЗначения.Вставить(СтрокаТЧ.Номенклатура, ВЭтомСтатусеСерииУказываютсяВТЧСерии);
	СтруктураПараметров.ДокументТСД.Вставить("КэшСтатусовУказанияСерий", КэшированныеЗначения);
	
	Возврат ВЭтомСтатусеСерииУказываютсяВТЧСерии;
	
КонецФункции

Процедура УТ_11_2_ПроверитьТабачнуюПродукцию(СтруктураПараметров)
	
	ДокументТСД			= СтруктураПараметров.ДокументТСД;	
	СтрокиФакт 			= ДокументТСД.СтрокиФакт;	        	
	Док1СРезультат 		= СтруктураПараметров.Док1СРезультат;					
	ЕстьРаботаСТабаком  = Ложь;
	ЕстьМОТП = Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовМОТП") <> Неопределено;
	ЕстьПТУ = Метаданные.Документы.Найти("ПриобретениеТоваровУслуг") <> Неопределено;
	
	//Если в конфигурации нет документ ПриобретениеТоваровУслуг тогда ничего делать не нужно
	Если НЕ ЕстьПТУ
		ИЛИ НЕ ЕстьМОТП Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыАлгоритма = Новый Структура; 
	ПараметрыАлгоритма.Вставить("Док1СРезультат", Док1СРезультат);
	Если СтруктураПараметров.Свойство("ИмяМодуляБезопасногоРежима") Тогда
		ПараметрыАлгоритма.Вставить("ИмяОбщегоМодуля", 	СтруктураПараметров.ИмяМодуляБезопасногоРежима);
	КонецЕсли;

	ЭтоПТУ = ГлЯдро_ВычислитьВБезопасномРежиме("ТипЗнч(Параметры.Док1СРезультат) = Тип(""ДокументОбъект.ПриобретениеТоваровУслуг"")", ПараметрыАлгоритма).Результат;
	
	Если ЭтоПТУ Тогда
		РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовМОТП.Получить(Новый Структура("Документ", Док1СРезультат.Ссылка)); 
		
		ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
	Иначе
		ДанныеПроверкиИПодбора = Неопределено;
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора <> Неопределено Тогда
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;	
		ПодобраннаяТабачнаяПродукция = ДанныеПроверкиИПодбора.ПодобраннаяТабачнаяПродукция;		
	КонецЕсли;		
	    
	Если ДанныеПроверкиИПодбора = Неопределено
		ИЛИ ДеревоМаркированнойПродукции = Неопределено Тогда
		ДеревоМаркированнойПродукции = ПустоеДеревоМаркированнойПродукции();
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора = Неопределено
		ИЛИ ПодобраннаяТабачнаяПродукция = Неопределено Тогда
		ПодобраннаяТабачнаяПродукция = ПустаяПодобраннаяТабачнаяПродукция();
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		ДанныеПроверкиИПодбора = Новый Структура();
	КонецЕсли;
	
	СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");									
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");									
	СтатусДляНовыйхСтрок = ?(ЭтоПТУ,СтатусПроверкиНеЧислилась,СтатусПроверкиВНаличии);
	
	ТаблицаМаркированнойПродукции 	= Новый ТаблицаЗначений;
	КолонкиТаблицыЗначений 			= ТаблицаМаркированнойПродукции.Колонки;
	
	КолонкиТаблицыЗначений.Добавить("Номенклатура");		
	КолонкиТаблицыЗначений.Добавить("СтатусПроверки");		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПачки");		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодБлока");		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодКоробки");		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПалеты");
	КолонкиТаблицыЗначений.Добавить("КоличествоУпаковок");
		
	Листья = Новый Массив;
	
	ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья);	
	
	Для каждого Лист Из Листья Цикл		
		
		СтруктураШтрихкодов = ПолучитьПустуюСтруктуруШтрихкодов();		
		ЗаполнитьСтруктуруШтрихкодовМОТП(Лист, СтруктураШтрихкодов);
		
		Родитель = Лист.Родитель;
		Пока Родитель <> Неопределено Цикл		
			ЗаполнитьСтруктуруШтрихкодовМОТП(Родитель, СтруктураШтрихкодов);									
			Родитель = Родитель.Родитель;			
		КонецЦикла; 
		
		НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураШтрихкодов);		
		НоваяСтрока.Номенклатура = Лист.Номенклатура;		
		
	КонецЦикла;	
	
	ТаблицаМаркированнойПродукции.ЗаполнитьЗначения(0, 								"КоличествоУпаковок");
	ТаблицаМаркированнойПродукции.ЗаполнитьЗначения(СтатусПроверкиНеПроверялась, 	"СтатусПроверки");
	
	ТаблицаМаркированнойПродукцииПлана = ТаблицаМаркированнойПродукции.Скопировать();						
	
	// 1. палеты и коробки не нужно отдельно проставлять, только блоки и пачки					
	
	//*******************************************************************************************************************************
	
	// 2. Перестроим иерархию по данным факта
	
	ФактПаллетаКоробка = Новый Соответствие;
	ФактКоробкаБлок = Новый Соответствие;
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений")
			ИЛИ НЕ СтрокаФакт.Свойство("Маркировка")
			ИЛИ СтрокаФакт.Маркировка <> "Табак" Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьРаботаСТабаком = Истина;
		
		Если СтрокаФакт.Свойство("SSCC") Тогда 
			ШтрихкодПалеты = СтрокаФакт.SSCC;		
		Иначе
			ШтрихкодПалеты = "";
		КонецЕсли;
		
		ФактПаллетаКоробка.Вставить(СтрокаФакт.ИдКоробки,ШтрихкодПалеты);
		ФактКоробкаБлок.Вставить(СтрокаФакт.ШтрихкодРодителя,СтрокаФакт.ИдКоробки);
		
	КонецЦикла;	
	
	//Возврат если нет данных
	Если ЕстьРаботаСТабаком = Ложь
		И ТаблицаМаркированнойПродукции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаСоответствия ИЗ ФактПаллетаКоробка Цикл
		Если ЗначениеЗаполнено(СтрокаСоответствия.Значение) Тогда
			РезультатПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодКоробки",СтрокаСоответствия.Ключ));	
			Для Каждого СтрокаМП ИЗ РезультатПоиска Цикл
				СтрокаМП.ШтрихкодПалеты = СтрокаСоответствия.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаСоответствия ИЗ ФактКоробкаБлок Цикл
		
		Если ЗначениеЗаполнено(СтрокаСоответствия.Значение) Тогда
			СтрокаПаллеты = ТаблицаМаркированнойПродукции.Найти(СтрокаСоответствия.Значение,"ШтрихкодКоробки");
			РезультатПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодБлока",СтрокаСоответствия.Ключ));	
			Для Каждого СтрокаМП ИЗ РезультатПоиска Цикл
				СтрокаМП.ШтрихкодКоробки = СтрокаСоответствия.Значение;
				Если СтрокаПаллеты <> Неопределено Тогда
					СтрокаМП.ШтрихкодПалеты = СтрокаПаллеты.ШтрихкодПалеты;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
			
	//*******************************************************************************************************************************

	// 3. нужно проверять палету и коробку из загружаемой строки факт (пачки или блока), что она в плане лежит там же 
	// т.е. (ид коробки и ид палеты одинаковые для СтрокиПлан и СтрокиФакт)
	// если она лежит не там, то нужно будет создать новые строки в той коробке и палете, в которой они лежат по факту
	// коробка и палета могут и не существовать, тогда их придется создать в коде
	// а текущей пачке/блоку установить статус - не числилась
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений")
			ИЛИ НЕ СтрокаФакт.Свойство("Маркировка")
			ИЛИ СтрокаФакт.Маркировка <> "Табак" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаФакт.Вставить("Номенклатура",Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара))); 
		СтрокаФакт.Вставить("КоличествоУпаковок",СтрокаФакт.КоличествоФакт);
		
		Если СтрокаФакт.Свойство("SSCC") Тогда 
			ШтрихкодПалеты = СтрокаФакт.SSCC;		
		Иначе
			ШтрихкодПалеты = "";
		КонецЕсли;
		
		РезПоиска = ТаблицаМаркированнойПродукции.Найти(СтрокаФакт.Марка,"ШтрихкодПачки");
		Если РезПоиска = Неопределено Тогда
			НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
			НоваяСтрока.СтатусПроверки = СтатусДляНовыйхСтрок;
		Иначе
			НоваяСтрока = РезПоиска;
			НоваяСтрока.СтатусПроверки = СтатусПроверкиВНаличии;
		КонецЕсли;
		
		//Найдем подходящую ветку для добавления элемента
		СтруктураПоиска = Новый Структура();
		Если ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
			НоваяСтрока.ШтрихкодПалеты = ШтрихкодПалеты;
			СтруктураПоиска.Вставить("ШтрихкодПалеты", ШтрихкодПалеты);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаФакт.ИдКоробки) Тогда
			НоваяСтрока.ШтрихкодКоробки = СтрокаФакт.ИдКоробки;
			СтруктураПоиска.Вставить("ШтрихкодКоробки", СтрокаФакт.ИдКоробки);
			РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(СтруктураПоиска);
			Если РезПоиска.Количество() > 0 Тогда
				НоваяСтрока.ШтрихкодПалеты = РезПоиска[0].ШтрихкодПалеты;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаФакт.ШтрихкодРодителя) Тогда
			НоваяСтрока.ШтрихкодБлока = СтрокаФакт.ШтрихкодРодителя;
			СтруктураПоиска.Вставить("ШтрихкодБлока", СтрокаФакт.ШтрихкодРодителя);
			РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(СтруктураПоиска);
			Если РезПоиска.Количество() > 0 Тогда
				НоваяСтрока.ШтрихкодКоробки = РезПоиска[0].ШтрихкодКоробки;
				НоваяСтрока.ШтрихкодПалеты = РезПоиска[0].ШтрихкодПалеты;
			КонецЕсли;
		КонецЕсли;		
		
		НоваяСтрока.Номенклатура 		= СтрокаФакт.Номенклатура;					
		НоваяСтрока.КоличествоУпаковок 	= СтрокаФакт.КоличествоУпаковок;		
		НоваяСтрока.ШтрихкодПачки 		= СтрокаФакт.Марка;		
		
	КонецЦикла;
	
	//*******************************************************************************************************************************
	
	// 4. все, что не в наличии - отсутствует
	Для каждого Строка Из ТаблицаМаркированнойПродукции Цикл
		Если Строка.СтатусПроверки <> СтатусПроверкиВНаличии И Строка.СтатусПроверки <> СтатусПроверкиНеЧислилась Тогда		
			Строка.СтатусПроверки 	= СтатусПроверкиОтсутствует;
		КонецЕсли;
	КонецЦикла;		
	
	//*******************************************************************************************************************************
		
	// 5. Если внутри коробки или палеты хотя бы 1 отсканирован блок или марка, то вся коробка или палета = В наличии
	
	// 6. Сделать подсчет количества подчиненных упаковок - всего, в наличии, отсутствует, не проверялось, отложена, не числилась
	
	// 7. Если добавлялись новые палеты или коробки, то добавить их в дерево МП в методе "ЗаполнитьДеревоМаркированнойПродукции"
	ДеревоМаркированнойПродукции = ПустоеДеревоМаркированнойПродукции();	
	ДобавитьСтрокиВДеревоМП(ДеревоМаркированнойПродукции,ТаблицаМаркированнойПродукции,ТаблицаМаркированнойПродукцииПлана);
	
	ТаблицаКоличествоМарок = ТаблицаМаркированнойПродукции.Скопировать(,"Номенклатура,ШтрихкодПачки");
	ТаблицаКоличествоМарок.Свернуть("Номенклатура,ШтрихкодПачки");
	
	ТаблицаМаркированнойПродукции.Свернуть("Номенклатура,СтатусПроверки","КоличествоУпаковок");	
	ПодобраннаяТабачнаяПродукция.ЗаполнитьЗначения(0,"Количество");
	ПодобраннаяТабачнаяПродукция.ЗаполнитьЗначения(0,"КоличествоПодобрано");
	
	Для каждого СтрокаТаблицы Из ТаблицаМаркированнойПродукции Цикл
		ВыбКоличествоМарок = ТаблицаКоличествоМарок.НайтиСтроки(Новый Структура("Номенклатура",СтрокаТаблицы.Номенклатура));
		КоличествоМарок = ВыбКоличествоМарок.Количество();
		НайденнаяСтрока = ПодобраннаяТабачнаяПродукция.Найти(СтрокаТаблицы.Номенклатура,"Номенклатура"); 
		Если НайденнаяСтрока <> Неопределено Тогда
			НайденнаяСтрока.Количество = КоличествоМарок;
			Если СтрокаТаблицы.СтатусПроверки = СтатусПроверкиВНаличии
				ИЛИ СтрокаТаблицы.СтатусПроверки = СтатусПроверкиНеЧислилась Тогда
				НайденнаяСтрока.КоличествоПодобрано = НайденнаяСтрока.КоличествоПодобрано+СтрокаТаблицы.КоличествоУпаковок;
			КонецЕсли;
		Иначе
			НоваяСтрока = ПодобраннаяТабачнаяПродукция.Добавить();
			
			НоваяСтрока.Номенклатура 				= СтрокаТаблицы.Номенклатура;
			НоваяСтрока.Количество 					= КоличествоМарок;
			Если СтрокаТаблицы.СтатусПроверки = СтатусПроверкиВНаличии
				ИЛИ СтрокаТаблицы.СтатусПроверки = СтатусПроверкиНеЧислилась Тогда
				НоваяСтрока.КоличествоПодобрано 		= СтрокаТаблицы.КоличествоУпаковок;
			КонецЕсли;
			НоваяСтрока.ПредставлениеНоменклатуры 	= Строка(СтрокаТаблицы.Номенклатура);
			НоваяСтрока.ТипНоменклатуры 			= СтрокаТаблицы.Номенклатура.ТипНоменклатуры;
			НоваяСтрока.НомерСтроки 				= ПодобраннаяТабачнаяПродукция.Количество();
			НоваяСтрока.КоличествоМОТП 				= СтрокаТаблицы.КоличествоУпаковок;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		ДанныеПроверкиИПодбора = Новый Структура;
		
		ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции");
		ДанныеПроверкиИПодбора.Вставить("ПодобраннаяТабачнаяПродукция");
		ДанныеПроверкиИПодбора.Вставить("КоличествоНедопустимыхКодовМаркировки");
		ДанныеПроверкиИПодбора.Вставить("УпаковкиДокумента");
		ДанныеПроверкиИПодбора.Вставить("ДетализацияСтруктурыХранения", ); //ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная"));
		ДанныеПроверкиИПодбора.Вставить("РежимПроверки");
		ДанныеПроверкиИПодбора.Вставить("ДобавленныеУпаковки");
		ДанныеПроверкиИПодбора.Вставить("ДоступныеДляПроверкиУпаковки");
		ДанныеПроверкиИПодбора.Вставить("СледующийСтикерОтложено");
		ДанныеПроверкиИПодбора.Вставить("СохраненВыборПоМаркируемойПродукции");
		ДанныеПроверкиИПодбора.Вставить("ДанныеВыбораПоМаркируемойПродукции");
		ДанныеПроверкиИПодбора.Вставить("ШтрихкодТекущейПроверяемойУпаковки");	
		ДанныеПроверкиИПодбора.Вставить("ДанныеРанееСгенерированныхШтрихкодов");
		
	КонецЕсли;
	ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции", ДеревоМаркированнойПродукции);	
	ДанныеПроверкиИПодбора.Вставить("ПодобраннаяТабачнаяПродукция", ПодобраннаяТабачнаяПродукция);
	
	ДанныеПроверкиИПодбора = Новый ХранилищеЗначения(ДанныеПроверкиИПодбора);
	
	//Запишем документ если он новый 
	Если Док1СРезультат.ЭтоНовый() Тогда
		Док1СРезультат.Записать();
	КонецЕсли;
	
	ПараметрыОкончанияПроверки = Новый Структура;
	ПараметрыОкончанияПроверки.Вставить("СоздаватьАктОРасхождениях",        Ложь);
	ПараметрыОкончанияПроверки.Вставить("СозданныйАктОРасхождениях",        Неопределено);
	ПараметрыОкончанияПроверки.Вставить("ПроверяемыйДокумент",              Док1СРезультат.Ссылка);
	ПараметрыОкончанияПроверки.Вставить("ТаблицаШтрихкодовВерхнегоУровня");
	ПараметрыОкончанияПроверки.Вставить("ТаблицаПодобраннойПровереннойПродукции");
	ПараметрыОкончанияПроверки.Вставить("ТаблицаРасхожденийШтриховыхКодов", Неопределено);
	
	ДеревоМаркированнойПродукции.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	
	Если ДеревоМаркированнойПродукции.Колонки.Найти("Штрихкод") = Неопределено Тогда
		ДеревоМаркированнойПродукции.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	КонецЕсли;
		
	Попытка
		// УТ 10.3.64 
		//ШтрихКодыУпаковок = Вычислить("ШтрихкодированиеИС.ШтрихкодыУпаковок(ШтрихкодированиеИС.ЗначенияШтрихкодовИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено))");
		ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено));
	Исключение
		//ШтрихКодыУпаковок = Вычислить("ШтрихкодированиеИС.ШтрихкодыУпаковок(ШтрихкодированиеИС.ЗначенияШтрихкодовВНаличииИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено))");
		ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовВНаличииИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено));
	КонецПопытки;			
	
	//ТаблицаШтрихкодовВерхнегоУровня = Вычислить("ПроверкаИПодборПродукцииМОТП.ПустаяТаблицаШтрихкодовВерхнегоУровня()");
	ТаблицаШтрихкодовВерхнегоУровня = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТП").ПустаяТаблицаШтрихкодовВерхнегоУровня();
	
	Если ЭтоПТУ = Истина Тогда
		//Выполнить("Справочники.ШтрихкодыУпаковокТоваров.РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(ДеревоМаркированнойПродукции,
		//|	                                                                                                     ТаблицаШтрихкодовВерхнегоУровня,
		//|																										 ШтрихКодыУпаковок)");
		Справочники["ШтрихкодыУпаковокТоваров"].РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(ДеревоМаркированнойПродукции,
			ТаблицаШтрихкодовВерхнегоУровня,
			ШтрихКодыУпаковок);
	КонецЕсли;
	
	Если Док1СРезультат.Метаданные().ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено Тогда																										 
		Док1СРезультат.ШтрихкодыУпаковок.Очистить();
		Для каждого ШКУпаковки Из ШтрихКодыУпаковок Цикл
			НоваяСтрока = Док1СРезультат.ШтрихкодыУпаковок.Добавить();
			НоваяСтрока.ШтрихкодУпаковки = ШКУпаковки.Ссылка;
		КонецЦикла;																										 
	КонецЕсли;
	
	ПараметрыОкончанияПроверки.ТаблицаШтрихкодовВерхнегоУровня = ТаблицаШтрихкодовВерхнегоУровня;
		
	//ТаблицаПодобраннойПровереннойПродукции = Вычислить("ПроверкаИПодборПродукцииМОТП.ПустаяТаблицаПодобраннойПровереннойПродукции()");
	ТаблицаПодобраннойПровереннойПродукции = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТП").ПустаяТаблицаПодобраннойПровереннойПродукции();
	
	ЕстьРасхождения = Ложь;
	
	Для Каждого СтрокаДерева Из ПодобраннаяТабачнаяПродукция Цикл
		
		НоваяСтрока = ТаблицаПодобраннойПровереннойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		Если Не ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
			НоваяСтрока.Характеристика = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Серия) Тогда
			НоваяСтрока.Серия = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры");
		КонецЕсли;
		
		Если НоваяСтрока.Количество <> НоваяСтрока.КоличествоПодобрано Тогда
			
			ЕстьРасхождения = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОкончанияПроверки.ТаблицаПодобраннойПровереннойПродукции = ТаблицаПодобраннойПровереннойПродукции;
	
	//Выполнить("ПроверкаИПодборПродукцииМОТП.ЗафиксироватьРезультатПроверкиИПодбора(ПараметрыОкончанияПроверки)");
	
	Если ЕстьРасхождения Тогда
		ТребуемоеДействие = Перечисления.ТребуемоеДействиеДокументЭДО.Отклонить;
	Иначе
		ТребуемоеДействие = Перечисления.ТребуемоеДействиеДокументЭДО.Подтвердить;
	КонецЕсли;
	
	//Выполнить("РегистрыСведений.СтатусыПроверкиИПодбораДокументовМОТП.ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ДанныеПроверкиИПодбора, ТребуемоеДействие)");
	РегистрыСведений["СтатусыПроверкиИПодбораДокументовМОТП"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ДанныеПроверкиИПодбора, ТребуемоеДействие);
	
	//СохранитьДанныеПроверкиИПодбора(Док1СРезультат.Ссылка, ДанныеПроверкиИПодбора);
		
КонецПроцедуры	

Функция УТ_11_4_СтруктураЗаполненияСтавкиНДС(СтруктураПараметров)
	
	ИмяСобытия = "УТ_11_4_СтруктураЗаполненияСтавкиНДС";
	
	Объект = СтруктураПараметров.Док1СРезультат;
	
	Попытка
		Возврат ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПараметрыЗаполненияСтавкиНДС(Объект);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	НалогообложениеНДС = ?(ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "НалогообложениеНДС"),
		Объект.НалогообложениеНДС,
		ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС"));
			
	ИмяТекущейКонфигурации = НРег(СокрЛП(Метаданные.Имя));	
	Если Найти(ИмяТекущейКонфигурации, "управлениеторговлейдляказахстана") Тогда
		СтруктураЗаполненияСтавкиНДС = НалогообложениеНДС;
	Иначе 
		СтруктураЗаполненияСтавкиНДС = Новый Структура;
		СтруктураЗаполненияСтавкиНДС.Вставить("НалогообложениеНДС", НалогообложениеНДС);
		СтруктураЗаполненияСтавкиНДС.Вставить("Дата",				Объект.Дата);
		СтруктураЗаполненияСтавкиНДС.Вставить("Организация",		Объект.Организация);
		СтруктураЗаполненияСтавкиНДС.Вставить("ПоДатеОтгрузки",		Истина);
	КонецЕсли;	
		
	Возврат СтруктураЗаполненияСтавкиНДС;
	
КонецФункции

Процедура УТ_11_2_ДополнитьСтруктуруДействийНДСНовый(СтруктураДействий, СтруктураПараметров, ТекущаяСтрокаСтруктура)

	НДС = Новый Структура;
	НДС.Вставить("ПоДатеОтгрузки"                  , Истина);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтруктураПараметров.Док1СРезультат, "НалогообложениеНДС") Тогда
		НДС.Вставить("НалогоОбложениеНДС"          , СтруктураПараметров.Док1СРезультат.НалогообложениеНДС);
	Иначе
		НДС.Вставить("НалогоОбложениеНДС"          , ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС"));
	КонецЕсли;
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", НДС); 
	
	ТекущаяСтрокаСтруктура.Вставить("ДатаОтгрузки" , СтруктураПараметров.Док1СРезультат.Дата);

КонецПроцедуры

Процедура УТ_11_2_ОбработатьСтрокуТЧ(СтрокаТЧ, СтруктураДействий, ДополнительныеПараметры = Неопределено, КэшированныеЗначения = Неопределено)

	Если НЕ СтруктураДействий.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЧСтруктура = УТ_11_2_ПолучитьТекущуюСтрокуСтруктурой(СтрокаТЧ, СтруктураДействий);
	
	// Дополнительные параметры для обработки строки ТЧ
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		Для каждого ДополнительныйПараметр ИЗ ДополнительныеПараметры Цикл
			СтрокаТЧСтруктура.Вставить(ДополнительныйПараметр.Ключ, ДополнительныйПараметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ИО_ОбщийМодуль("ОбработкаТабличнойЧастиСервер").ОбработатьСтрокуТЧ(СтрокаТЧСтруктура, СтруктураДействий, КэшированныеЗначения);
			
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЧСтруктура);
	
КонецПроцедуры

Процедура УТ_11_2_ЗаполнитьЦенуВСтрокеТабличнойЧасти(СтруктураПараметров, ДобавленаНоваяСтрока = Ложь, СтруктураДействий = Неопределено, ТипОперации = "Приемка")
	
	Перем КэшНоменклатуры;
	
	ИмяСобытия = "УТ_11_2_ЗаполнитьЦенуВСтрокеТабличнойЧасти";
	
	Док1СРезультат	  = СтруктураПараметров.Док1СРезультат;
	ДокументТСД		  = СтруктураПараметров.ДокументТСД;
	ТекущаяСтрока	  = СтруктураПараметров.СтрокаДокумента;
	ИмяТабличнойЧасти = СтруктураПараметров.ИмяТабличнойЧасти;
	СтрокаТабличнойЧастиДокументаТСД = СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	
	Если ТипОперации = "Приемка" Тогда
		
		ЗаполненаЦенаПриемки = СтрокаТабличнойЧастиДокументаТСД.Свойство("ЦенаПриемки") 
			И ЗначениеЗаполнено(СтрокаТабличнойЧастиДокументаТСД.ЦенаПриемки);
		Если ЗаполненаЦенаПриемки И СтрокаТабличнойЧастиДокументаТСД.ЦенаПриемки <> ТекущаяСтрока.Цена Тогда
			ТекущаяСтрока.Цена = СтрокаТабличнойЧастиДокументаТСД.ЦенаПриемки;
		КонецЕсли;
		
		ЗаполнятьЦенуПоУсловиямЗакупок = ДобавленаНоваяСтрока И НЕ ЗаполненаЦенаПриемки ИЛИ ТекущаяСтрока.Цена = 0;
		
		Если ЗаполнятьЦенуПоУсловиямЗакупок Тогда
			Если НЕ ДокументТСД.Свойство("КэшНоменклатурыДляЗаполненияЦен", КэшНоменклатуры) Тогда
				КэшНоменклатуры = Новый Соответствие;
				
				ДокументТСД.Вставить("КэшНоменклатурыДляЗаполненияЦен", КэшНоменклатуры);
			КонецЕсли;
			
			КлючНоменклатуры = СтрокаТабличнойЧастиДокументаТСД.ИдТовара
				+ "_" + ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("ИдХарактеристики"), СтрокаТабличнойЧастиДокументаТСД.ИдХарактеристики, "");
				
			Если НЕ КэшНоменклатуры.Получить(КлючНоменклатуры) = Неопределено Тогда
				ЗаполнятьЦенуПоУсловиямЗакупок = Ложь; // Если уже была неудачная попытка заполнить цену по данным документа 1С, повторять ее не нужно
			КонецЕсли;
		КонецЕсли;
			
		Если ЗаполнятьЦенуПоУсловиямЗакупок Тогда	
			ИспользоватьСоглашенияСПоставщиками = ПолучитьФункциональнуюОпциюНаСервере("ИспользоватьСоглашенияСПоставщиками");
			
			Попытка
				Соглашение = Док1СРезультат.Соглашение;
			Исключение
				Соглашение = Неопределено;
			КонецПопытки;
			
			Если СтруктураДействий = Неопределено Тогда
				СтруктураДействий = Новый Структура;
			КонецЕсли;
			
			ТекстОшибки = "";
			Если ИспользоватьСоглашенияСПоставщиками = Истина И ЗначениеЗаполнено(Соглашение) Тогда
				СтруктураДействий.Вставить("ЗаполнитьУсловияЗакупок", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияЦеныЗакупкиВСтрокеТЧ(Док1СРезультат));
				
				ТекстОшибки = "%1: не удалось заполнить цену номенклатуры %2 в строке табличной части %3 по данным соглашения с поставщиком (%4)";
			ИначеЕсли ТекущаяСтрока.Цена = 0 Тогда
				СтруктураДействий.Вставить("ЗаполнитьЦенуЗакупки", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияЦеныЗакупкиВСтрокеТЧ(Док1СРезультат));
				
				ТекстОшибки = "%1: не удалось заполнить цену номенклатуры %2 в строке табличной части %3 по данным документа 1С";
			КонецЕсли;
			
			УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий);
			
			Если ТекущаяСтрока.Цена = 0 Тогда
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(ТекстОшибки, Док1СРезультат, ТекущаяСтрока.Номенклатура, ИмяТабличнойЧасти, Соглашение));
				
				КэшНоменклатуры.Вставить(КлючНоменклатуры, Ложь);
			КонецЕсли;
		КонецЕсли;
		
		Если ТекущаяСтрока.Цена = 0 Тогда
			Если СтрокаТабличнойЧастиДокументаТСД.Свойство("Цена")
				И ЗначениеЗаполнено(СтрокаТабличнойЧастиДокументаТСД.Цена) Тогда
				ТекущаяСтрока.Цена = СтрокаТабличнойЧастиДокументаТСД.Цена;
			ИначеЕсли ЗаполнятьЦенуПоУсловиямЗакупок Тогда // Запись об отсутствии цены в документе MS достаточно сделать один раз
				ТекстОшибки = "%1: не удалось заполнить цену номенклатуры %2 в строке табличной части %3 по данным документа Mobile SMARTS";
					
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(ТекстОшибки, Док1СРезультат, ТекущаяСтрока.Номенклатура, ИмяТабличнойЧасти, Соглашение));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипОперации = "Отгрузка" Тогда

		ЗаполнятьЦенуПоУсловиямПродаж = ТекущаяСтрока.Цена = 0;
		
		Если ЗаполнятьЦенуПоУсловиямПродаж Тогда
			Если НЕ ДокументТСД.Свойство("КэшНоменклатурыДляЗаполненияЦен", КэшНоменклатуры) Тогда
				КэшНоменклатуры = Новый Соответствие;
				
				ДокументТСД.Вставить("КэшНоменклатурыДляЗаполненияЦен", КэшНоменклатуры);
			КонецЕсли;
			
			КлючНоменклатуры = СтрокаТабличнойЧастиДокументаТСД.ИдТовара
				+ "_" + ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("ИдХарактеристики"), СтрокаТабличнойЧастиДокументаТСД.ИдХарактеристики, "");
				
			Если НЕ КэшНоменклатуры.Получить(КлючНоменклатуры) = Неопределено Тогда
				ЗаполнятьЦенуПоУсловиямПродаж = Ложь; // Если уже была неудачная попытка заполнить цену по данным документа 1С, повторять ее не нужно
			КонецЕсли;
		КонецЕсли;
		
		Если ЗаполнятьЦенуПоУсловиямПродаж Тогда
			ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпциюНаСервере("ИспользоватьСоглашенияСКлиентами");
			
			Попытка
				Соглашение = Док1СРезультат.Соглашение;
			Исключение
				Соглашение = Неопределено;
			КонецПопытки;
			
			Если СтруктураДействий = Неопределено Тогда
				СтруктураДействий = Новый Структура;
			КонецЕсли;
			
			ТекстОшибки = "";
			Если ИспользоватьСоглашенияСКлиентами = Истина И ЗначениеЗаполнено(Соглашение) Тогда
				СтруктураДействий.Вставить("ЗаполнитьУсловияПродаж", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияУсловийПродажВСтрокеТЧ(Док1СРезультат));
				
				ТекстОшибки = "%1: не удалось заполнить цену номенклатуры %2 в строке табличной части %3 по данным соглашения с клиентом (%4)";
			Иначе
				Попытка
					СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПараметрыЗаполненияЦеныВСтрокеТЧ(Док1СРезультат));
				Исключение
					СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияЦеныВСтрокеТЧ(Док1СРезультат));
				КонецПопытки;
				
				ТекстОшибки = "%1: не удалось заполнить цену номенклатуры %2 в строке табличной части %3 по данным документа 1С";
			КонецЕсли;
			
			УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий);
			
			Если ТекущаяСтрока.Цена = 0 Тогда
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(ТекстОшибки, Док1СРезультат, ТекущаяСтрока.Номенклатура, ИмяТабличнойЧасти, Соглашение));
				
				КэшНоменклатуры.Вставить(КлючНоменклатуры, Ложь);
			КонецЕсли;
		КонецЕсли;
		
		Если ТекущаяСтрока.Цена = 0 Тогда
			Если СтрокаТабличнойЧастиДокументаТСД.Свойство("Цена")
				И ЗначениеЗаполнено(СтрокаТабличнойЧастиДокументаТСД.Цена) Тогда
				ТекущаяСтрока.Цена = СтрокаТабличнойЧастиДокументаТСД.Цена;
			ИначеЕсли ЗаполнятьЦенуПоУсловиямПродаж Тогда // Запись об отсутствии цены в документе MS достаточно сделать один раз
				ТекстОшибки = "%1: не удалось заполнить цену номенклатуры %2 в строке табличной части %3 по данным документа Mobile SMARTS";
					
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(ТекстОшибки, Док1СРезультат, ТекущаяСтрока.Номенклатура, ИмяТабличнойЧасти, Соглашение));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УТ_11_2_ЗаполнитьДанныеСтроки(СтруктураПараметров, ДобавленаНоваяСтрока, ТипОперации = "Приемка")
	
	ИмяСобытия = "УТ_11_2_ЗаполнитьДанныеСтроки";
	
	ТекущаяСтрока  = СтруктураПараметров.СтрокаДокумента;
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	УТ_11_2_ЗаполнитьЦенуВСтрокеТабличнойЧасти(СтруктураПараметров, ДобавленаНоваяСтрока,, ТипОперации);
	
	СтруктураДействий = Новый Структура;
	
	Если ДобавленаНоваяСтрока Тогда
		
		СтруктураПроверкиСопоставленнойНоменклатурыПоставщика = ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруПроверкиСопоставленнойНоменклатурыПоставщикаВСтрокеТЧ(Док1СРезультат, Истина);
		
		СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", 						ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Док1СРезультат, Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовЗакупки(Док1СРезультат.Склад)));
		СтруктураДействий.Вставить("ЗаполнитьНоменклатуруПартнераПоНоменклатуре", 	Док1СРезультат.Партнер);
		СтруктураДействий.Вставить("ПроверитьСопоставленнуюНоменклатуруПартнера", 	СтруктураПроверкиСопоставленнойНоменклатурыПоставщика);
		СтруктураДействий.Вставить("ПроверитьСтатьюАналитикуРасходов", 				ТекущаяСтрока.Номенклатура);		
		
		// для совместимости с предыдущими релизами
		СтруктураДействий.Вставить("ЗаполнитьНоменклатуруПоставщикаПоНоменклатуре", Док1СРезультат.Партнер);
		СтруктураДействий.Вставить("ПроверитьСопоставленнуюНоменклатуруПоставщика", СтруктураПроверкиСопоставленнойНоменклатурыПоставщика);
		
	КонецЕсли;
	
	УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий);
	
КонецПроцедуры

Процедура УТ_11_2_ЗаполнитьДанныеСтроки_ПослеЗаполненияТЧ(СтруктураПараметров)
	
	ИмяСобытия = "УТ_11_2_ЗаполнитьДанныеСтроки_ПослеЗаполненияТЧ";
	
	ТабличнаяЧасть = СтруктураПараметров.ТЧ;
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	СтруктураПересчетаСуммы 	 = УТ_11_4_СтруктураПересчетаСуммыНДСВСтрокеТЧ(Док1СРезультат);
	СтруктураЗаполненияСтавкиНДС = УТ_11_4_СтруктураЗаполненияСтавкиНДС(СтруктураПараметров);
	
	Для каждого ТекущаяСтрока ИЗ ТабличнаяЧасть Цикл
		СтруктураДействий = Новый Структура;
	
		Если ТекущаяСтрока.СтавкаНДС.Пустая() Тогда
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", СтруктураЗаполненияСтавкиНДС);
		КонецЕсли;
	
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", 		Док1СРезультат.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", 					СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", 					СтруктураПересчетаСуммы);	
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", 	Новый Структура("Очищать", Истина));
		СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");		
	
		УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Новый Структура("ДатаОтгрузки", Док1СРезультат.Дата));	
	КонецЦикла;
	
КонецПроцедуры

// Для версий 11.4.10+
Процедура УТ_11_4_ПроверитьТабачнуюПродукциюИСМП(СтруктураПараметров)
	
	ДокументТСД			= СтруктураПараметров.ДокументТСД;	
	СтрокиФакт 			= ДокументТСД.СтрокиФакт;	        	
	Док1СРезультат 		= СтруктураПараметров.Док1СРезультат;					
	ЕстьРаботаСТабаком  = Ложь;
	ЕстьИСМП = Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИС") <> Неопределено
		ИЛИ Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИСМП") <> Неопределено;
	ЕстьПТУ = Метаданные.Документы.Найти("ПриобретениеТоваровУслуг") <> Неопределено;
		
	//Если в конфигурации нет документ ПриобретениеТоваровУслуг тогда ничего делать не нужно
	Если НЕ ЕстьПТУ ИЛИ НЕ ЕстьИСМП Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления.Найти("Табак") <> Неопределено Тогда 
		ВидПродукцииИС = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табак");
	Иначе	
		ВидПродукцииИС = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табачная");
	КонецЕсли;

	ПараметрыАлгоритма = Новый Структура; 
	ПараметрыАлгоритма.Вставить("Док1СРезультат", Док1СРезультат);
	Если СтруктураПараметров.Свойство("ИмяМодуляБезопасногоРежима") Тогда
		ПараметрыАлгоритма.Вставить("ИмяОбщегоМодуля", 	СтруктураПараметров.ИмяМодуляБезопасногоРежима);
	КонецЕсли;
	
	ЭтоПТУ = ГлЯдро_ВычислитьВБезопасномРежиме("ТипЗнч(Параметры.Док1СРезультат) = Тип(""ДокументОбъект.ПриобретениеТоваровУслуг"")", ПараметрыАлгоритма).Результат;
	ЭтоРТУ = ГлЯдро_ВычислитьВБезопасномРежиме("ТипЗнч(Параметры.Док1СРезультат) = Тип(""ДокументОбъект.РеализацияТоваровУслуг"")", ПараметрыАлгоритма).Результат;
	
	Если ЭтоПТУ Тогда
		Попытка
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Док1СРезультат.Ссылка, ВидПродукцииИС, 0));
		Исключение
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Док1СРезультат.Ссылка, ВидПродукцииИС)); 
		КонецПопытки;
		
		ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
	Иначе
		ДанныеПроверкиИПодбора = Неопределено;
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора <> Неопределено Тогда
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;	
		ПодобраннаяТабачнаяПродукция = ДанныеПроверкиИПодбора.ПодобраннаяТабачнаяПродукция;		
	КонецЕсли;		
	    
	Если ДанныеПроверкиИПодбора = Неопределено
		ИЛИ ДеревоМаркированнойПродукции = Неопределено Тогда
		ДеревоМаркированнойПродукции = ПустоеДеревоТабачнойПродукцииИСМП();
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора = Неопределено
		ИЛИ ПодобраннаяТабачнаяПродукция = Неопределено Тогда
		ПодобраннаяТабачнаяПродукция = ПустаяТаблицаПодобраннаяТабачнаяПродукцияИСМП();
	КонецЕсли;
	
	// Данные по штрихкодам будем сохранять во временном хранилище и загружать по кнопке на форме проверки и подбора
	Если ЭтоРТУ И ДанныеПроверкиИПодбора <> Неопределено И ДанныеПроверкиИПодбора.Свойство("Cleverence_МОТП_ШтрихкодыТСД") Тогда
		Cleverence_МОТП_ШтрихкодыТСД = ДанныеПроверкиИПодбора.Cleverence_МОТП_ШтрихкодыТСД;
	Иначе
		Cleverence_МОТП_ШтрихкодыТСД = Новый ТаблицаЗначений;
		Cleverence_МОТП_ШтрихкодыТСД.Колонки.Добавить("Штрихкод", 		  Новый ОписаниеТипов("Строка"));
		Cleverence_МОТП_ШтрихкодыТСД.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("Строка"));
		Cleverence_МОТП_ШтрихкодыТСД.Колонки.Добавить("Количество",		  Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		ДанныеПроверкиИПодбора = Новый Структура();
	КонецЕсли;
	
	СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");									
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");									
	СтатусДляНовыйхСтрок 		= СтатусПроверкиВНаличии; //?(ЭтоПТУ,СтатусПроверкиНеЧислилась,СтатусПроверкиВНаличии);
	
	ТаблицаМаркированнойПродукции 	= Новый ТаблицаЗначений;
	КолонкиТаблицыЗначений 			= ТаблицаМаркированнойПродукции.Колонки;
	
	КолонкиТаблицыЗначений.Добавить("Номенклатура");
	КолонкиТаблицыЗначений.Добавить("Характеристика");
	КолонкиТаблицыЗначений.Добавить("GTIN");
	КолонкиТаблицыЗначений.Добавить("СтатусПроверки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПачки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодБлока");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодКоробки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПалеты");
	КолонкиТаблицыЗначений.Добавить("КоличествоУпаковок");
		
	Листья = Новый Массив;
	
	ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья);	
	
	Для каждого Лист Из Листья Цикл		
		
		СтруктураШтрихкодов = ПолучитьПустуюСтруктуруШтрихкодов();
		Попытка
			ЗаполнитьСтруктуруШтрихкодовМОТП(Лист, СтруктураШтрихкодов);
		Исключение
			ЗаполнитьСтруктуруШтрихкодовМОТП(Лист, СтруктураШтрихкодов, "Штрихкод");
		КонецПопытки;
		
		Родитель = Лист.Родитель;
		Пока Родитель <> Неопределено Цикл
			Попытка
				ЗаполнитьСтруктуруШтрихкодовМОТП(Родитель, СтруктураШтрихкодов);
			Исключение
				ЗаполнитьСтруктуруШтрихкодовМОТП(Родитель, СтруктураШтрихкодов, "Штрихкод");
			КонецПопытки;
			Родитель = Родитель.Родитель;			
		КонецЦикла; 
		
		НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураШтрихкодов);		
		НоваяСтрока.Номенклатура = Лист.Номенклатура;		
		
	КонецЦикла;	
	
	ТаблицаМаркированнойПродукции.ЗаполнитьЗначения(0, 								"КоличествоУпаковок");
	ТаблицаМаркированнойПродукции.ЗаполнитьЗначения(СтатусПроверкиНеПроверялась, 	"СтатусПроверки");
	
	ТаблицаМаркированнойПродукцииПлана = ТаблицаМаркированнойПродукции.Скопировать();						
	
	// 1. палеты и коробки не нужно отдельно проставлять, только блоки и пачки					
	
	//*******************************************************************************************************************************
	
	// 2. Перестроим иерархию по данным факта
	
	ФактПаллетаКоробка = Новый Соответствие;
	ФактКоробкаБлок = Новый Соответствие;
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений")
			ИЛИ НЕ СтрокаФакт.Свойство("Маркировка")
			ИЛИ СтрокаФакт.Маркировка <> "Табак" Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьРаботаСТабаком = Истина;
		
		ШтрихкодПалеты 	= "";
		ШтрихкодКоробки = "";
		ШтрихкодБлока 	= "";
		ШтрихкодМарки 	= "";
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда // Если нет свойства ИдКоробки, то в свойстве SSCC содержится ШтрихкодКоробки
			Если СтрокаФакт.Свойство("SSCC") 
				И ЗначениеЗаполнено(СтрокаФакт.SSCC) Тогда 
