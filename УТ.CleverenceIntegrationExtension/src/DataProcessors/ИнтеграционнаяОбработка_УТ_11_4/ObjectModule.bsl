Функция ИСМП_ПерезаписатьШтрихкодСПересчетомХеша(Штрихкод)
	ШтрихкодУпаковкиСсылка = НайтиУпаковкуТоваровПоШтрихкоду(Штрихкод);
	Если ШтрихкодУпаковкиСсылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ШтрихкодУпаковкиОбъект = ШтрихкодУпаковкиСсылка.ПолучитьОбъект();
	Попытка
		ШтрихкодУпаковкиОбъект.Записать();
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИСМП_ПерезаписатьШтрихкодСПересчетомХеша", "Ошибка", "Не удалось перезаписать Штрихкод Упаковки товара. Ошибка: " + ТекстОшибки);
		Возврат "";
	КонецПопытки;
	Возврат ШтрихкодУпаковкиСсылка.ХешСумма;
КонецФункции

Процедура РассчитатьХешСуммыУпаковки(СтрокаДерева, ВключаяПодчиненные)
	
	ДанныеДляРасчетаХешСуммы = Новый СписокЗначений();
	          
	ПодчиненныеСтрокиДерева = СтрокаДерева.Строки;
	ИдентификаторВДереве    = СтрокаДерева;
	
	ЕстьКолонкаХешСуммаНормализации = Неопределено;
	
	Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтрокиДерева Цикл
		Если ПодчиненнаяСтрока.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьКолонкаХешСуммаНормализации = Неопределено Тогда
			ЕстьКолонкаХешСуммаНормализации = ИО_ОбщийМодуль("ОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойствоОбъекта(ПодчиненнаяСтрока, "ХешСуммаНормализации");
		КонецЕсли;
		
		ЭтоУпаковка = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(ПодчиненнаяСтрока.ТипУпаковки);
		Если ЭтоУпаковка Тогда
			Если ВключаяПодчиненные Тогда
				РассчитатьХешСуммыУпаковки(ПодчиненнаяСтрока, ВключаяПодчиненные);
			КонецЕсли;
			
			ДанныеДляРасчетаХешСуммы.Добавить(ПодчиненнаяСтрока.ХешСумма);
		Иначе
			Если ЕстьКолонкаХешСуммаНормализации И ЗначениеЗаполнено(ПодчиненнаяСтрока.ХешСуммаНормализации) Тогда
				ЗначениеДляРасчета = ПодчиненнаяСтрока.ХешСуммаНормализации;
			Иначе
				ЗначениеДляРасчета = ПодчиненнаяСтрока.Штрихкод;
			КонецЕсли;
			
			ДанныеДляРасчетаХешСуммы.Добавить(ЗначениеДляРасчета);
		КонецЕсли;
	КонецЦикла;
	
	ЭтоУпаковка = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки);
	Если ЭтоУпаковка Тогда
		СтрокаДерева.ХешСумма = Справочники["ШтрихкодыУпаковокТоваров"].ХешСуммаСодержимогоУпаковки(ДанныеДляРасчетаХешСуммы);
	КонецЕсли;
	
КонецПроцедуры

Функция ПустаяТаблицаХешСумм()

	ТаблицаХешСумм = Новый ТаблицаЗначений;
	ТаблицаХешСумм.Колонки.Добавить("ХешСумма", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаХешСумм.Колонки.Добавить("Штрихкод", ОбщегоНазначения.ОписаниеТипаСтрока(200));
	ТаблицаХешСумм.Колонки.Добавить("ИдентификаторВДереве");
	
	Возврат ТаблицаХешСумм;

КонецФункции

Процедура ДобавитьСтрокиВДеревоМП(ДеревоМаркированнойПродукции,ТаблицаМаркированнойПродукции,ТаблицаМаркированнойПродукцииПлана)
	
	СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");									
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
	
	ШтрихкодыПалет = ТаблицаМаркированнойПродукции.Скопировать(,"ШтрихкодПалеты");
	ШтрихкодыПалет.Свернуть("ШтрихкодПалеты");
	
	Для каждого Штрихкод Из ШтрихкодыПалет Цикл
		
		ПачкиПалеты = ТаблицаМаркированнойПродукции.Скопировать(Новый Структура("ШтрихкодПалеты", Штрихкод.ШтрихкодПалеты));
		
		КоробкиПалеты = ПачкиПалеты.Скопировать();
		КоробкиПалеты.Свернуть("ШтрихкодКоробки", "КоличествоУпаковок");
		
		БлокиПалеты = ПачкиПалеты.Скопировать();
		БлокиПалеты.Свернуть("ШтрихкодБлока", "КоличествоУпаковок");
		
		//Палета
		
		Если ЗначениеЗаполнено(Штрихкод.ШтрихкодПалеты) Тогда
			РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.ШтрихкодПалеты,"ЗначениеШтрихкода");
			Если РезультатПоиска = Неопределено Тогда
				НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
				// заполняем реквизиты палеты
				
				НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Палета";
				НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
				НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = КоробкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхНеЧислилось = КоробкиПалеты.Количество();
				НоваяСтрока.ЗначениеШтрихкода 				 = Штрихкод.ШтрихкодПалеты;
				НоваяСтрока.Представление 					 = Штрихкод.ШтрихкодПалеты;
				НоваяСтрока.КоличествоПодчиненныхПачек 		 = ПачкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхВсего 		 = КоробкиПалеты.Количество() + БлокиПалеты.Количество() + ПачкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхБлоков 	 = БлокиПалеты.Количество();
				НоваяСтрока.Штрихкод						 = НоваяСтрока.ЗначениеШтрихкода;
				
				СтрокаРодителяПаллета = НоваяСтрока;   
			Иначе
				СтрокаРодителяПаллета = РезультатПоиска;
			КонецЕсли;
			
			Если ПачкиПалеты.Найти(СтатусПроверкиВНаличии,"СтатусПроверки") <> Неопределено 
				ИЛИ ПачкиПалеты.Найти(СтатусПроверкиНеЧислилась,"СтатусПроверки") <> Неопределено Тогда
				СтрокаРодителяПаллета.СтатусПроверки = СтатусПроверкиВНаличии;
			Иначе
				СтрокаРодителяПаллета.СтатусПроверки = СтатусПроверкиОтсутствует;
			КонецЕсли;
			
		Иначе
			СтрокаРодителяПаллета = ДеревоМаркированнойПродукции;
		КонецЕсли;
			
		Для каждого СтрокаКоробки Из КоробкиПалеты Цикл
			
			// заполняем реквизиты коробки
			
			ПачкиКоробки = ПачкиПалеты.Скопировать(Новый Структура("ШтрихкодКоробки,ШтрихкодПалеты", СтрокаКоробки.ШтрихкодКоробки,Штрихкод.ШтрихкодПалеты)); 
			БлокиКоробки = ПачкиКоробки.Скопировать();
			БлокиКоробки.Свернуть("Номенклатура, ШтрихкодБлока", "КоличествоУпаковок");						
			
			//Коробка			
			Если ЗначениеЗаполнено(СтрокаКоробки.ШтрихкодКоробки) Тогда
				РезультатПоиска = СтрокаРодителяПаллета.Строки.Найти(СтрокаКоробки.ШтрихкодКоробки,"ЗначениеШтрихкода");
				Если РезультатПоиска = Неопределено Тогда
					НоваяСтрока = СтрокаРодителяПаллета.Строки.Добавить();
					
					НоваяСтрока.ПредставлениеПроверкиПодчиненных 	= "Коробка";
					НоваяСтрока.ТипУпаковки 						= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
					НоваяСтрока.КоличествоПодчиненныхУпаковок 		= БлокиКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхНеЧислилось	= БлокиКоробки.Количество();
					НоваяСтрока.ЗначениеШтрихкода 					= СтрокаКоробки.ШтрихкодКоробки;
					НоваяСтрока.Представление 						= СтрокаКоробки.ШтрихкодКоробки;
					НоваяСтрока.КоличествоПодчиненныхПачек 			= ПачкиКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхВсего 			= БлокиКоробки.Количество() + ПачкиКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхБлоков 		= БлокиКоробки.Количество();
					НоваяСтрока.Штрихкод						    = НоваяСтрока.ЗначениеШтрихкода;
					
					СтрокаРодителяКоробка = НоваяСтрока;
				Иначе
					СтрокаРодителяКоробка = РезультатПоиска;
				КонецЕсли;
				
				Если ПачкиКоробки.Найти(СтатусПроверкиВНаличии,"СтатусПроверки") <> Неопределено 
					ИЛИ ПачкиКоробки.Найти(СтатусПроверкиНеЧислилась,"СтатусПроверки") <> Неопределено Тогда
					СтрокаРодителяКоробка.СтатусПроверки = СтатусПроверкиВНаличии;
				Иначе
					СтрокаРодителяКоробка.СтатусПроверки = СтатусПроверкиОтсутствует;
				КонецЕсли;
			Иначе
				СтрокаРодителяКоробка = СтрокаРодителяПаллета;
			КонецЕсли;
			
			Для каждого СтрокаБлока Из БлокиКоробки Цикл
				
				// заполняем реквизиты блока
				
				ПачкиБлока = ПачкиПалеты.Скопировать(Новый Структура("ШтрихкодБлока,ШтрихкодКоробки,ШтрихкодПалеты", СтрокаБлока.ШтрихкодБлока, СтрокаКоробки.ШтрихкодКоробки, Штрихкод.ШтрихкодПалеты)); 
				
				//Блок
				Если ЗначениеЗаполнено(СтрокаБлока.ШтрихкодБлока) Тогда
					РезультатПоиска = СтрокаРодителяКоробка.Строки.Найти(СтрокаБлока.ШтрихкодБлока,"ЗначениеШтрихкода");
					Если РезультатПоиска = Неопределено Тогда
						НоваяСтрока = СтрокаРодителяКоробка.Строки.Добавить();
						
						НоваяСтрока.ПредставлениеПроверкиПодчиненных 	= "Блок";
						НоваяСтрока.ТипУпаковки 						= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
						НоваяСтрока.КоличествоПодчиненныхУпаковок 		= ПачкиБлока.Количество();
						НоваяСтрока.КоличествоПодчиненныхНеЧислилось	= ПачкиБлока.Количество();
						НоваяСтрока.ЗначениеШтрихкода 					= СтрокаБлока.ШтрихкодБлока;
						НоваяСтрока.Представление 						= СтрокаБлока.ШтрихкодБлока;
						НоваяСтрока.КоличествоПодчиненныхПачек 			= ПачкиБлока.Количество();
						НоваяСтрока.КоличествоПодчиненныхВсего 			= ПачкиБлока.Количество();
						НоваяСтрока.Номенклатура 						= СтрокаБлока.Номенклатура;
						НоваяСтрока.КоличествоПодчиненныхБлоков 		= 1;
						НоваяСтрока.GTIN 								= ПолучитьШтрихкодНоменклатуры(СтрокаБлока.Номенклатура);
						НоваяСтрока.Штрихкод						 	= НоваяСтрока.ЗначениеШтрихкода;
						
						СтрокаРодителяБлок = НоваяСтрока;
					Иначе
						СтрокаРодителяБлок = РезультатПоиска;
					КонецЕсли;
					
					Если ПачкиБлока.Найти(СтатусПроверкиВНаличии,"СтатусПроверки") <> Неопределено 
						ИЛИ ПачкиБлока.Найти(СтатусПроверкиНеЧислилась,"СтатусПроверки") <> Неопределено Тогда
						СтрокаРодителяБлок.СтатусПроверки = СтатусПроверкиВНаличии;
					Иначе
						СтрокаРодителяБлок.СтатусПроверки = СтатусПроверкиОтсутствует;
					КонецЕсли;
				Иначе
					СтрокаРодителяБлок = СтрокаРодителяКоробка;
				КонецЕсли;
				
				Для каждого СтрокаПачки Из ПачкиБлока Цикл
					//Пачка
					Если ЗначениеЗаполнено(СтрокаПачки.ШтрихкодПачки) Тогда
						РезультатПоиска = СтрокаРодителяБлок.Строки.Найти(СтрокаПачки.ШтрихкодПачки,"ЗначениеШтрихкода");
						Если РезультатПоиска = Неопределено Тогда
							НоваяСтрока = СтрокаРодителяБлок.Строки.Добавить();
							
							// заполняем реквизиты пачки
							
							НоваяСтрока.СтатусПроверки 					= СтрокаПачки.СтатусПроверки;
							НоваяСтрока.ПредставлениеПроверкиПодчиненных 	= "Пачка";
							НоваяСтрока.ТипУпаковки 						= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
							НоваяСтрока.КоличествоПодчиненныхУпаковок 	= 1;
							НоваяСтрока.КоличествоПодчиненныхНеЧислилось	= 1;
							НоваяСтрока.ЗначениеШтрихкода 				= СтрокаПачки.ШтрихкодПачки;
							НоваяСтрока.Представление 					= СтрокаПачки.ШтрихкодПачки;
							НоваяСтрока.КоличествоПодчиненныхПачек 		= 1;
							НоваяСтрока.КоличествоПодчиненныхВсего 		= 1;
							НоваяСтрока.Номенклатура 						= СтрокаПачки.Номенклатура;
							НоваяСтрока.GTIN 								= ПолучитьШтрихкодНоменклатуры(СтрокаПачки.Номенклатура);
							НоваяСтрока.Штрихкод						 = НоваяСтрока.ЗначениеШтрихкода;
						Иначе
							РезультатПоиска.СтатусПроверки = СтрокаПачки.СтатусПроверки;
						КонецЕсли;	
					КонецЕсли;
				КонецЦикла; 
				
			КонецЦикла; 
			
		КонецЦикла; 
	
	КонецЦикла;
	
	//Добавим пустые упаковки в дерево
	СписокПаллетПлана = ТаблицаМаркированнойПродукцииПлана.Скопировать(,"ШтрихкодПалеты");
	СписокПаллетПлана.Свернуть("ШтрихкодПалеты");
	
	Для каждого Паллета Из СписокПаллетПлана Цикл
		
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Паллета.ШтрихкодПалеты, "ЗначениеШтрихкода", Истина);
		Если РезультатПоиска = Неопределено Тогда
			НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
			// заполняем реквизиты палеты
			
			НоваяСтрока.СтатусПроверки 					 = СтатусПроверкиОтсутствует;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Палета";
			НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось = 0;
			НоваяСтрока.ЗначениеШтрихкода 				 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.Представление 					 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.КоличествоПодчиненныхПачек 		 = 0;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 = 0;
			НоваяСтрока.КоличествоПодчиненныхБлоков 	 = 0;
			НоваяСтрока.Штрихкод						 = НоваяСтрока.ЗначениеШтрихкода;
		КонецЕсли;
		
	КонецЦикла;
	
	СписокКоробокПлана = ТаблицаМаркированнойПродукцииПлана.Скопировать(,"ШтрихкодПалеты,ШтрихкодКоробки");
	СписокКоробокПлана.Свернуть("ШтрихкодПалеты,ШтрихкодКоробки");
	
	Для каждого Коробка Из СписокКоробокПлана Цикл
		
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Коробка.ШтрихкодКоробки, "ЗначениеШтрихкода", Истина);
		Если РезультатПоиска = Неопределено Тогда
			Если ЗначениеЗаполнено(Коробка.ШтрихкодПалеты) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Коробка.ШтрихкодПалеты, "ЗначениеШтрихкода", Истина);	
			Иначе
				СтрокаРодитель = ДеревоМаркированнойПродукции;
			КонецЕсли;
			
			НоваяСтрока = СтрокаРодитель.Строки.Добавить();
			// заполняем реквизиты палеты
			
			НоваяСтрока.СтатусПроверки 					 = СтатусПроверкиОтсутствует;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Коробка";
			НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось = 0;
			НоваяСтрока.ЗначениеШтрихкода 				 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.Представление 					 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.КоличествоПодчиненныхПачек 		 = 0;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 = 0;
			НоваяСтрока.КоличествоПодчиненныхБлоков 	 = 0;
			НоваяСтрока.Штрихкод						 = НоваяСтрока.ЗначениеШтрихкода;
		КонецЕсли;
		
	КонецЦикла;
	
	СписокБлоковПлана = ТаблицаМаркированнойПродукцииПлана.Скопировать(,"ШтрихкодПалеты,ШтрихкодКоробки,ШтрихкодБлока");
	СписокБлоковПлана.Свернуть("ШтрихкодПалеты,ШтрихкодКоробки,ШтрихкодБлока");
	
	Для каждого Блок Из СписокБлоковПлана Цикл
		
		РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Блок.ШтрихкодБлока, "ЗначениеШтрихкода", Истина);
		Если РезультатПоиска = Неопределено Тогда
			Если ЗначениеЗаполнено(Блок.ШтрихкодКоробки) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Блок.ШтрихкодПалеты, "ЗначениеШтрихкода", Истина);	
			ИначеЕсли ЗначениеЗаполнено(Блок.ШтрихкодПалеты) Тогда
				СтрокаРодитель = ДеревоМаркированнойПродукции.Строки.Найти(Блок.ШтрихкодПалеты, "ЗначениеШтрихкода", Истина);
			Иначе
				СтрокаРодитель = ДеревоМаркированнойПродукции;
			КонецЕсли;
			
			НоваяСтрока = СтрокаРодитель.Строки.Добавить();
			// заполняем реквизиты палеты
			
			НоваяСтрока.СтатусПроверки 					 = СтатусПроверкиОтсутствует;
			НоваяСтрока.ПредставлениеПроверкиПодчиненных = "Блок";
			НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
			НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = 0;
			НоваяСтрока.КоличествоПодчиненныхНеЧислилось = 0;
			НоваяСтрока.ЗначениеШтрихкода 				 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.Представление 					 = Паллета.ШтрихкодПалеты;
			НоваяСтрока.КоличествоПодчиненныхПачек 		 = 0;
			НоваяСтрока.КоличествоПодчиненныхВсего 		 = 0;
			НоваяСтрока.КоличествоПодчиненныхБлоков 	 = 0;
			НоваяСтрока.Штрихкод						 = НоваяСтрока.ЗначениеШтрихкода;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Метаданные.Перечисления.Найти("ПрочиеЗоныПересчетаПродукцииИСМП") <> Неопределено Тогда
		ПеречислениеБлокиБезКоробки =  ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки")
	Иначе
		ПеречислениеБлокиБезКоробки =  ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаТабачнойПродукцииМОТП.БлокиБезКоробки");
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
		//Если Вычислить("ИнтеграцияИСКлиентСервер.ЭтоУпаковка(СтрокаДерева.ТипУпаковки)")
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки)
		 Или СтрокаДерева.ТипУпаковки = ПеречислениеБлокиБезКоробки Тогда
			РассчитатьХешСуммыУпаковки(СтрокаДерева, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСтрокуМаркируемойПродукции(ТаблицаМаркированнойПродукции,ШтрихкодПалеты,ШтрихкодКоробки,ШтрихкодБлока,ШтрихкодПачки)
	//когда ШтрихкодБлока = ШтрихкодПачки // значит, нет детализации по пачкам и мы сканируем блоки
	// в этом случае, нужно отметить и блок и все его пачки		
	Если ЗначениеЗаполнено(ШтрихкодПачки) и ЗначениеЗаполнено(ШтрихкодБлока)
		И ШтрихкодБлока = ШтрихкодПачки Тогда
		БезПачек = Истина;
		РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодБлока", ШтрихкодБлока));	
	Иначе
		БезПачек = Ложь;
		РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодПачки",ШтрихкодПачки));
	КонецЕсли;
	
	МассивПодходящихСтрок = Новый Массив;
	
	Для каждого СтрокаРезультата Из РезПоиска Цикл

		Если ЗначениеЗаполнено(ШтрихкодБлока)
			И СтрокаРезультата.ШтрихкодБлока <> ШтрихкодБлока Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодКоробки)
			И СтрокаРезультата.ШтрихкодКоробки <> ШтрихкодКоробки Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодПалеты)
			И СтрокаРезультата.ШтрихкодПалеты <> ШтрихкодПалеты Тогда
			Продолжить;
		КонецЕсли;
		
		 
		МассивПодходящихСтрок.Добавить(СтрокаРезультата); 
		Если НЕ БезПачек Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивПодходящихСтрок;
	
КонецФункции

Функция ЕстьРеквизитВКоллекции(КоллекцияРеквизитов, ИмяРеквизита)
	
	Возврат (КоллекцияРеквизитов.Найти(ИмяРеквизита) <> Неопределено);
	
КонецФункции	

Функция СвернутьСтрокиТабличнойЧасти(СтрокаНастройки, ТабличнаяЧасть, СтрокаТЧ)
	
	СтруктураПоиска 		= Новый Структура;
	СтруктураСуммирования 	= Новый Структура;
	СтрокиНастройки 		= СтрокаНастройки.ТабличнаяЧастьДокумента1С;
	
	Для каждого СтрокаДанных из СтрокиНастройки Цикл		
		
		Если СтрокаДанных.РеквизитКлючаСвязи ИЛИ НЕ СтрокаДанных.Загружать Тогда
			Продолжить;
		КонецЕсли;	
			
		Если СтрокаДанных.Полепоиска Тогда			
			СтруктураПоиска.Вставить(СтрокаДанных.Имя1С, СтрокаТЧ[СтрокаДанных.Имя1С]);			
		ИначеЕсли НЕ СтрокаДанных.Полепоиска Тогда		
			СтруктураСуммирования.Вставить(СтрокаДанных.Имя1С);			
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;			
	
	СтрокаСвернулась = Ложь;
	
	Попытка
		СтрокиТабличнойЧасти = ТабличнаяЧасть.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТабличнойЧасти.Количество() > 1 Тогда
			НайдСтрока = СтрокиТабличнойЧасти[0];
			Попытка			
				
				Для каждого КлючИЗначение из СтруктураСуммирования Цикл					
					
					// т.к. булевы нельзя суммировать
					Если ТипЗнч(НайдСтрока[КлючИЗначение.Ключ]) = Тип("Булево") И ТипЗнч(СтрокаТЧ[КлючИЗначение.Ключ]) = Тип("Булево") Тогда
						НайдСтрока[КлючИЗначение.Ключ] = СтрокаТЧ[КлючИЗначение.Ключ];					
					Иначе
						НайдСтрока[КлючИЗначение.Ключ] = НайдСтрока[КлючИЗначение.Ключ] + СтрокаТЧ[КлючИЗначение.Ключ];					
					КонецЕсли;	
					
					Если КлючИЗначение.Ключ = "КоличествоЕдиницИзмерения" Тогда
						Попытка
							НайдСтрока.Количество = НайдСтрока[КлючИЗначение.Ключ];	
						Исключение
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;	
				
				ТабличнаяЧасть.Удалить(СтрокаТЧ);				
				СтрокаТЧ = НайдСтрока; // Вернём свернутую строку для дальнейшей обработки				
				СтрокаСвернулась = Истина;				
				
			Исключение								
				СтрокаСвернулась = Ложь;				
			КонецПопытки;
		Иначе						
			СтрокаСвернулась = Ложь;						
		КонецЕсли;
	Исключение				
		СтрокаСвернулась = Ложь;		
	КонецПопытки;
	
	Возврат СтрокаСвернулась;

КонецФункции

Процедура РассчитатьАбсолютноеКоличествоВСтрокеТЧ(СтрокаТЧ, ИмяУпаковка, ИмяКоличество, ИмяКоличествоУпаковок)		
	
	Перем Коэффициент;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ИмяУпаковка]) Тогда
		СтрокаТЧ[ИмяКоличество]	= СтрокаТЧ[ИмяКоличествоУпаковок];
	Иначе	
		
		Коэффициент = 1;
		
		Попытка
			Коэффициент = СтрокаТЧ[ИмяУпаковка].Коэффициент;
		Исключение
			Коэффициент = СтрокаТЧ[ИмяУпаковка].Числитель / ?(СтрокаТЧ[ИмяУпаковка].Знаменатель <> 0, СтрокаТЧ[ИмяУпаковка].Знаменатель, 1);	
		КонецПопытки;			
		
		Если Коэффициент = 0 Тогда
			Коэффициент = 1;
		КонецЕсли;	
		
		СтрокаТЧ[ИмяКоличество]	= СтрокаТЧ[ИмяКоличествоУпаковок] * Коэффициент;
		
	КонецЕсли;				
	
КонецПроцедуры	

Процедура ТТНВходящаяЕГАИС_УстановитьСтатусПринято(ДокументОбъект, УстанавливаемыйСтатус = Неопределено)
	
	Если УстанавливаемыйСтатус = Неопределено Тогда
		Если Метаданные.Перечисления.Найти("СтатусыПроверкиИПодбораИС") <> Неопределено Тогда
			ДокументОбъект.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Завершено");
		Иначе
			ДокументОбъект.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораЕГАИС.Завершено");
		КонецЕсли;
	Иначе
		ДокументОбъект.СтатусПроверкиИПодбора = УстанавливаемыйСтатус;
	КонецЕсли;

	ПараметрыОбновленияСтатуса 						= ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ПараметрыОбновленияСтатуса();
	ПараметрыОбновленияСтатуса.ОбновлятьДвижения 	= Ложь;
	ПараметрыОбновленияСтатуса.СтатусОбработки   	= ПредопределенноеЗначение("Перечисление.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС");
	ПараметрыОбновленияСтатуса.ДокументОбъект    	= ДокументОбъект;
	
	Документы["ТТНВходящаяЕГАИС"].ОбновитьСтатусПослеПолученияДанных(ДокументОбъект.Ссылка, Перечисления.ВидыДокументовЕГАИС.ТТН, ПараметрыОбновленияСтатуса);
	
КонецПроцедуры

Процедура ТТНВходящаяЕГАИС_ТЧ_АкцизныеМарки_ЗаполнитьСправки2(ДокументОбъект)
	
	// Закомментировано. Входящие акцизные марки нужно переполучать только при наличии незаполненных справок 2 в ТЧ АкцизныеМарки
	//АкцизныеМарки = Документы["ТТНВходящаяЕГАИС"].ВходящиеАкцизныеМарки(ДокументОбъект.Ссылка);
	//
	// Изменения имени поля штрихкода при формировании дерева
	// хорошо бы определять в начале обработки и передавать параметрами
	//ИмяПоляШтрихкода = "Штрихкод";
	//Если АкцизныеМарки.Колонки.Найти("Штрихкод") = Неопределено Тогда 
	//	ИмяПоляШтрихкода = "ЗначениеШтрихкода";
	//КонецЕсли;
	
	// В ТЧ Акцизные марки заполняем:
	//	1. Справка2 из входящего сообщения ЕГАИС
	//	2. ИдентификаторСтроки после перезаполнения Справка2
	
	ТаблицаДокумента 		= ДокументОбъект.АкцизныеМарки;
	ТаблицаДокументаТовары 	= ДокументОбъект.Товары;
	АкцизныеМарки			= Неопределено;
	ИмяПоляШтрихкода		= "Штрихкод";
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		// Если справку 2 удалось заполнить при загрузке документа, перезаполнять ее не нужно
		Если НЕ СтрокаДокумента.Справка2.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Если АкцизныеМарки = Неопределено Тогда
			АкцизныеМарки = Документы["ТТНВходящаяЕГАИС"].ВходящиеАкцизныеМарки(ДокументОбъект.Ссылка);
			Если АкцизныеМарки.Колонки.Найти("Штрихкод") = Неопределено Тогда 
				ИмяПоляШтрихкода = "ЗначениеШтрихкода";
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура(ИмяПоляШтрихкода, СтрокаДокумента.АкцизнаяМарка.ЗначениеШтрихкода);
		СтрокиАкцизныхМарок = АкцизныеМарки.НайтиСтроки(ПараметрыОтбора);
		Если СтрокиАкцизныхМарок.Количество() > 0 Тогда 
			СтрокаДокумента.Справка2 = СтрокиАкцизныхМарок[0].Справка2; 
			
			ПараметрыОтбора = Новый Структура("Справка2", СтрокаДокумента.Справка2);
			СтрокиТоваров = ТаблицаДокументаТовары.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиТоваров.Количество() > 0 Тогда
				СтрокаДокумента.ИдентификаторСтроки = СтрокиТоваров[0].ИдентификаторСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура ТТНВходящаяЕГАИС_ТЧ_Товары_ЗаполнитьКоличествоФакт(СтруктураПараметров)

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;	
	Товары		   = Док1СРезультат.Товары;	
	
	Для каждого Строка Из Товары Цикл	
		Если Строка.Количество <> Строка.КоличествоФакт Тогда
			Док1СРезультат.ЕстьРасхождения = Истина;
			Прервать;
		КонецЕсли;                                                                                       
	КонецЦикла;	

КонецПроцедуры
 
Процедура ТТНВходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров)
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
		
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание","ТТНВходящаяЕГАИС. Данные маркированной продукции");
	
	ДанныеПроверкиИПодбора = Док1СРезультат.ДанныеПроверкиИПодбора.Получить();     	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		Попытка
			ДанныеПроверкиИПодбора = ДанныеДокумента_ПроверкаИПодборАлкогольнойПродукцииЕГАИС(Док1СРезультат, СтруктураПараметров);
		Исключение
			ДанныеПроверкиИПодбора = СформироватьСтруктуруДанныхПроверкиИПодбора(Док1СРезультат, СтруктураПараметров.ВерсииОбъектовКонфигурации); // Оставлено для совместимости со старыми релизами
		КонецПопытки;
	КонецЕсли;
	
	ДеревоМаркированнойПродукции  = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
	ТаблицаНеМаркируемойПродукции = ДанныеПроверкиИПодбора.ТаблицаНеМаркируемойПродукции;
	
	ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
    ЗавершатьПроверку = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборПриемка"), СтруктураПараметров) = Истина;	
	
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание","ТТНВходящаяЕГАИС. Установка статуса акцизных марок");
	
	// Отмечаем статусы в дереве маркированной продукции по табличной части СтрокиФакт
	Если ДеревоМаркированнойПродукции.Строки.Количество() > 0 Тогда
		Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияАлкогольнойПродукции") <> Неопределено  Тогда 
			СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.ВНаличии");
			СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеПроверялась");
			СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.Отсутствует");
			СтатусПроверкиНеЧислилась	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеЧислилась");
		Иначе
			СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
			СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");
			СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
			СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
		КонецЕсли;
		
		ВыгружаемыйУровеньДетализации = ИО_ЗначениеГлобальногоПараметраПоID("NDSf530dda2d3da4a218be1ffa14fe0b754", СтруктураПараметров);
		Если ВыгружаемыйУровеньДетализации = "Палеты" Тогда
			УровеньДетализации = 1;
		ИначеЕсли ВыгружаемыйУровеньДетализации = "Коробки" Тогда
			УровеньДетализации = 2;
		Иначе
			УровеньДетализации = 3;
		КонецЕсли;
		
		ЕГАИС_ЗаполнитьСтатусПроверки(ДеревоМаркированнойПродукции, ДокументТСД.СтрокиФакт, СтатусПроверкиВНаличии, СтруктураПараметров.ВерсииОбъектовКонфигурации, УровеньДетализации);
		
		Статусы = Новый Структура;
		Статусы.Вставить("СтатусПроверкиВНаличии", 		СтатусПроверкиВНаличии);
		Статусы.Вставить("СтатусПроверкиНеПроверялась", СтатусПроверкиНеПроверялась);
		Статусы.Вставить("СтатусПроверкиОтсутствует", 	СтатусПроверкиОтсутствует);
		Статусы.Вставить("СтатусПроверкиНеЧислилась", 	СтатусПроверкиНеЧислилась);
		
		ЕГАИС_ДополнитьСтатусыВДереве(ДеревоМаркированнойПродукции, Статусы, ЗавершатьПроверку);
		
		// УпаковкиДокумента = Новый СписокЗначений;
		// ЗаполнитьДанныеАкцизныхМарок(ДеревоМаркированнойПродукции.Строки, ДокументТСД.СтрокиФакт, УпаковкиДокумента, СтруктураПараметров);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание","ТТНВходящаяЕГАИС. Данные партионной продукции");
	МаркиПартионнойПродукции = Новый Массив();
	Если ТаблицаНеМаркируемойПродукции.Количество() > 0 Тогда
		ЗаполнитьПартионнуюПродукцию(ТаблицаНеМаркируемойПродукции, ДокументТСД, МаркиПартионнойПродукции);
	КонецЕсли;

	// Доработать при необходимости добавлять новые строки в дерево маркированной продукции (которых не было в плане)
	// СтруктураПараметров.Вставить("КритическаяОшибкаОписание","ТТНВходящаяЕГАИС. Дополнение дерева проверки и подбора");
	//
	//Если ДокументТСД.СтрокиФакт.Количество() > 1 Тогда
	//	ДополнитьДеревоДанныеПроверкиИПодбора(ДокументТСД.СтрокиФакт, ДанныеПроверкиИПодбора, СтруктураПараметров);
	//КонецЕсли;	
	
	ТТН_ЕГАИС_ДополнитьДерево(ДеревоМаркированнойПродукции);
	
	// Расчет хеш-сумм
	ТаблицаХешСумм = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ПустаяТаблицаХешСумм();
	Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").РассчитатьХешСуммыУпаковки(СтрокаДерева, ТаблицаХешСумм, Истина);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыПересчета = Новый Структура;
	ПараметрыПересчета.Вставить("ПроверяемыйДокумент", 					Док1СРезультат.Ссылка);
	ПараметрыПересчета.Вставить("РежимПодбораСуществующихУпаковок", 	Ложь);
	ПараметрыПересчета.Вставить("Справки2СопоставленнаяНоменклатура",	?(ДанныеПроверкиИПодбора.Свойство("Справки2СопоставленнаяНоменклатура"), 
		ДанныеПроверкиИПодбора.Справки2СопоставленнаяНоменклатура, Неопределено));
	
	ЕГАИС_ПересчитатьИтогиВДанныхПроверкиИПодбора(ДеревоМаркированнойПродукции, ПараметрыПересчета);
	
	Если ЗавершатьПроверку Тогда
		Попытка
			ТТНВходящаяЕГАИС_ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат, ДеревоМаркированнойПродукции, ТаблицаНеМаркируемойПродукции);
		Исключение
			Сообщить("Не удалось завершить проверку алкогольной продукции в документе " + Строка(Док1СРезультат) + ". Подробности см. в журнале регистрации.");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ТТНВходящаяЕГАИС_ОтразитьЗавершениеПроверкиДокумента", "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;	
	КонецЕсли;
			
	// Устанавливает статусы марок партионной продукции
	УстановитьСтатусАкцизныхМарок(МаркиПартионнойПродукции, СтруктураПараметров);		
	
	Док1СРезультат.ДанныеПроверкиИПодбора = Новый ХранилищеЗначения(ДанныеПроверкиИПодбора);
	
	// Явное проставление статуса документа (при его отсутствии)
	Если (Док1СРезультат.СтатусПроверкиИПодбора = Неопределено) Или 
		(Док1СРезультат.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.ПустаяСсылка")) Тогда
		Док1СРезультат.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Выполняется");
	КонецЕсли;
	 
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор.ДобавитьСтрокуВРезультирующееДерево
Процедура ТТНВходящаяЕГАИС_ДобавитьСтрокуВРезультирующееДерево(СтрокаИсточник, КоллекцияСтрокПриемника)
	
	Если СтрокаИсточник.ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаАлкогольнойПродукции.БутылкиБезКоробки")
		И СтрокаИсточник.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НоваяСтрока = КоллекцияСтрокПриемника.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
	
	Для Каждого ПодчиненнаяСтрокаИсточник Из СтрокаИсточник.Строки Цикл
		
		ТТНВходящаяЕГАИС_ДобавитьСтрокуВРезультирующееДерево(ПодчиненнаяСтрокаИсточник, НоваяСтрока.Строки);
		
	КонецЦикла;
	
	Если НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		
		Возврат ;
		
	КонецЕсли;
	
	НоваяСтрока.АлкогольнаяПродукция = ?(СтрокаИсточник.ВУпаковкеРазнаяАлкогольнаяПродукция, Неопределено, СтрокаИсточник.АлкогольнаяПродукция);
	НоваяСтрока.Номенклатура         = ?(СтрокаИсточник.ВУпаковкеРазнаяНоменклатура,         Неопределено, СтрокаИсточник.Номенклатура);
	НоваяСтрока.Характеристика       = ?(СтрокаИсточник.ВУпаковкеРазныеХарактеристики,       Неопределено, СтрокаИсточник.Характеристика);
	НоваяСтрока.Серия                = ?(СтрокаИсточник.ВУпаковкеРазныеСерии,                Неопределено, СтрокаИсточник.Серия);
	НоваяСтрока.Справка2             = ?(СтрокаИсточник.ВУпаковкеРазныеСправки2,             Неопределено, СтрокаИсточник.Справка2);
	
	Для Каждого ПодчиненнаяСтрока Из НоваяСтрока.Строки Цикл
		
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(ПодчиненнаяСтрока.ТипУпаковки) Тогда
			
			НоваяСтрока.КоличествоАкцизныхМарок = НоваяСтрока.КоличествоАкцизныхМарок + ПодчиненнаяСтрока.КоличествоАкцизныхМарок;
			
		ИначеЕсли ПодчиненнаяСтрока.ТипУпаковки =  ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
			
			НоваяСтрока.КоличествоАкцизныхМарок = НоваяСтрока.КоличествоАкцизныхМарок + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор.ПересчитатьВсеИтогиФормы (частично)
Процедура ЕГАИС_ПересчитатьИтогиВДанныхПроверкиИПодбора(ДеревоМаркированнойПродукции, ПараметрыПроцедуры)

	Если ПараметрыПроцедуры.Справки2СопоставленнаяНоменклатура = Неопределено Тогда
		Справки2СопоставленнаяНоменклатура = Справки2СопоставленнаяНоменклатура();
		
		ИО_ОбщийМодуль("ИнтеграцияЕГАИСПереопределяемый").ЗаполнитьТаблицуСопоставленныхСправок2ТТН_ЕГАИС(
			ПараметрыПроцедуры.ПроверяемыйДокумент, Справки2СопоставленнаяНоменклатура);
		
		ПараметрыПроцедуры.Вставить("Справки2СопоставленнаяНоменклатура", Справки2СопоставленнаяНоменклатура);
	КонецЕсли;
	
	ЕГАИС_ОпределитьТипыВсехУпаковок(ДеревоМаркированнойПродукции, ПараметрыПроцедуры);
	
КонецПроцедуры

// см. ПроверкаИПодборПродукцииЕГАИСКлиентСервер.ОпределитьТипыВсехУпаковок
Процедура ЕГАИС_ОпределитьТипыВсехУпаковок(ДеревоМаркированнойПродукции, ПараметрыПроцедуры) Экспорт
	
	Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
		
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
			
			ЕГАИС_ОпределитьТипУпаковки(ПараметрыПроцедуры, СтрокаДерева, Истина);
			
		КонецЕсли;
		
	КонецЦикла
	
КонецПроцедуры

// см. ПроверкаИПодборПродукцииЕГАИСКлиентСервер.ОпределитьТипУпаковки
Процедура ЕГАИС_ОпределитьТипУпаковки(ПараметрыПроцедуры, СтрокаДерева, ВключаяПодчиненные)
	
	АлкогольнаяПродукцияУпаковки = Новый Соответствие;
	НоменклатураУпаковки         = Новый Соответствие;
	ХарактеристикаУпаковки       = Новый Соответствие;
	СерииУпаковки                = Новый Соответствие;
	Справки2Упаковки             = Новый Соответствие;
	ДлиныМарокУпаковки           = Новый Соответствие;
	
	ВУпаковкеРазныеСерии                = Ложь;
	ВУпаковкеРазнаяНоменклатура         = Ложь;
	ВУпаковкеРазныеХарактеристики       = Ложь;
	ВУпаковкеРазнаяАлкогольнаяПродукция = Ложь;
	ВУпаковкеРазныеСправки2             = Ложь;
	ВУпаковкеРазныеДлиныМарок           = Ложь;
	
	ВсеСправки2Указаны           = Истина;
	
	Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
		
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(ПодчиненнаяСтрока.ТипУпаковки) Тогда
			
			Если ВключаяПодчиненные Тогда
				
				ЕГАИС_ОпределитьТипУпаковки(ПараметрыПроцедуры, ПодчиненнаяСтрока, ВключаяПодчиненные);
				
			КонецЕсли;
			
			Если Не ПодчиненнаяСтрока.ВсеСправки2Указаны Тогда
				ВсеСправки2Указаны = Ложь;
			КонецЕсли;
			
		Иначе
			
			Если Не ЗначениеЗаполнено(ПодчиненнаяСтрока.Справка2) Тогда
				
				ВсеСправки2Указаны = Ложь;
				ПодчиненнаяСтрока.ВсеСправки2Указаны = Ложь;
				
			Иначе
				
				ПодчиненнаяСтрока.ВсеСправки2Указаны = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ПараметрыПроцедуры.РежимПодбораСуществующихУпаковок
			И СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
			И Не ЗначениеЗаполнено(СтрокаДерева.Номенклатура) Тогда
			
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("Справка2", СтрокаДерева.Справка2);
			
			НайденныеСтроки = ПараметрыПроцедуры.Справки2СопоставленнаяНоменклатура.НайтиСтроки(ПараметрыПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				СтрокаДерева.Номенклатура   = НайденныеСтроки.Номенклатура;
				СтрокаДерева.Характеристика = НайденныеСтроки.Характеристика;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ВУпаковкеРазнаяАлкогольнаяПродукция Тогда
			ВУпаковкеРазнаяАлкогольнаяПродукция = Истина;
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ВУпаковкеРазнаяНоменклатура Тогда
			ВУпаковкеРазнаяНоменклатура = Истина;
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ВУпаковкеРазныеХарактеристики Тогда
			ВУпаковкеРазныеХарактеристики = Истина;
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ВУпаковкеРазныеСправки2 Тогда
			ВУпаковкеРазныеСправки2 = Истина;
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ВУпаковкеРазныеСерии Тогда
			ВУпаковкеРазныеСерии = Истина;
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ВУпаковкеРазныеДлиныМарок Тогда
			ВУпаковкеРазныеДлиныМарок = Истина;
		КонецЕсли;
		
		АлкогольнаяПродукцияУпаковки.Вставить(ПодчиненнаяСтрока.АлкогольнаяПродукция, Истина);
		НоменклатураУпаковки.Вставить(ПодчиненнаяСтрока.Номенклатура, Истина);
		ХарактеристикаУпаковки.Вставить(ПодчиненнаяСтрока.Характеристика, Истина);
		Справки2Упаковки.Вставить(ПодчиненнаяСтрока.Справка2, Истина);
		СерииУпаковки.Вставить(ПодчиненнаяСтрока.Серия, Истина);
		ДлиныМарокУпаковки.Вставить(ПодчиненнаяСтрока.ДлинаАкцизнойМарки, Истина);
		
	КонецЦикла;
	
	СтрокаДерева.ВсеСправки2Указаны = ВсеСправки2Указаны;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСКлиентСервер").УстановитьЗначениеДляУпаковки(СтрокаДерева,
		"АлкогольнаяПродукция", "ВУпаковкеРазнаяАлкогольнаяПродукция",
		АлкогольнаяПродукцияУпаковки, ВУпаковкеРазнаяАлкогольнаяПродукция);
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСКлиентСервер").УстановитьЗначениеДляУпаковки(СтрокаДерева,
		"Номенклатура", "ВУпаковкеРазнаяНоменклатура",
		НоменклатураУпаковки, ВУпаковкеРазнаяНоменклатура);
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСКлиентСервер").УстановитьЗначениеДляУпаковки(СтрокаДерева,
		"Характеристика", "ВУпаковкеРазныеХарактеристики",
		ХарактеристикаУпаковки, ВУпаковкеРазныеХарактеристики);
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСКлиентСервер").УстановитьЗначениеДляУпаковки(СтрокаДерева,
		"Серия", "ВУпаковкеРазныеСерии",
		СерииУпаковки, ВУпаковкеРазныеСерии);
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСКлиентСервер").УстановитьЗначениеДляУпаковки(СтрокаДерева,
		"Справка2", "ВУпаковкеРазныеСправки2",
		Справки2Упаковки, ВУпаковкеРазныеСправки2);
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСКлиентСервер").УстановитьЗначениеДляУпаковки(СтрокаДерева,
		"ДлинаАкцизнойМарки", "ВУпаковкеРазныеДлиныМарок",
		ДлиныМарокУпаковки, ВУпаковкеРазныеДлиныМарок);
	
	Если ЗначениеЗаполнено(СтрокаДерева.Номенклатура) Тогда
		СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
	Иначе
		СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка");
	КонецЕсли;
	
КонецПроцедуры	

Процедура ТТНВходящаяЕГАИС_ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат, ДеревоМаркируемойПродукции, ТаблицаНеМаркируемойПродукции)

	// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор.НачатьЗавершениеПроверки
	
	ТипЧастичноеВыбытиеВариантУчета = ОбщегоНазначения.ОписаниеТипаСтрока(50);	
	Если Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИС") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИС");
	ИначеЕсли Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИСМП") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИСМП");
	КонецЕсли;
	
	ОписаниеТиповТипУпаковки = Новый ОписаниеТипов;
	ОписаниеТиповТипУпаковки.Типы().Добавить(Тип("ПеречислениеСсылка.ТипыУпаковок"));
	ОписаниеТиповТипУпаковки.Типы().Добавить(Тип("ПеречислениеСсылка.ПрочиеЗоныПересчетаАлкогольнойПродукции"));
		
	ВозвращаемоеДерево = Новый ДеревоЗначений;
	ВозвращаемоеДерево.Колонки.Добавить("Штрихкод",                ОбщегоНазначения.ОписаниеТипаСтрока(200));
	ВозвращаемоеДерево.Колонки.Добавить("ТипУпаковки",             ОписаниеТиповТипУпаковки);
	ВозвращаемоеДерево.Колонки.Добавить("АлкогольнаяПродукция",    Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Номенклатура",            Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Характеристика",          Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Серия",                   Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Справка2",                Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("ВсеСправки2Указаны",      Новый ОписаниеТипов("Булево"));
	ВозвращаемоеДерево.Колонки.Добавить("СтатусПроверки",          Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыПроверкиНаличияПродукцииИС"));
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоАкцизныхМарок", ОбщегоНазначения.ОписаниеТипаЧисло(15));
	ВозвращаемоеДерево.Колонки.Добавить("ИдентификаторСтроки",     ОбщегоНазначения.ОписаниеТипаЧисло(15));
	ВозвращаемоеДерево.Колонки.Добавить("ХешСумма",                ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытие",               Новый ОписаниеТипов("Булево"));
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеВариантУчета",   ТипЧастичноеВыбытиеВариантУчета);
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеНоменклатура",   Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеХарактеристика", Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеКоличество",     ОбщегоНазначения.ОписаниеТипаЧисло(10, 3));
	ВозвращаемоеДерево.Колонки.Добавить("ВыбытиеБутылки",                 Новый ОписаниеТипов("Булево"));
	ВозвращаемоеДерево.Колонки.Добавить("Коэффициент",                    ОбщегоНазначения.ОписаниеТипаЧисло(18, 8));
	
	ТТН_ЕГАИС_ДополнитьДерево(ВозвращаемоеДерево);
		
	Для Каждого СтрокаПроверяемого Из ДеревоМаркируемойПродукции.Строки Цикл
		ТТНВходящаяЕГАИС_ДобавитьСтрокуВРезультирующееДерево(СтрокаПроверяемого, ВозвращаемоеДерево.Строки);
	КонецЦикла;
		
	// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ЗафиксироватьРезультатПроверкиИПодбора
	
	Попытка                                           		
		ШтрихкодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ЗначенияШтрихкодовИзДереваУпаковок(ВозвращаемоеДерево));
	Исключение
		ШтрихкодыУпаковок = ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ЗначенияШтрихкодовИзДереваУпаковок(ВозвращаемоеДерево));
	КонецПопытки;
		
	Попытка		
		// с версии 2.3.2.26
		ИО_ОбщийМодуль("ШтрихкодированиеЕГАИС").СоздатьШтрихкодыУпаковок(ВозвращаемоеДерево, ШтрихкодыУпаковок,, Док1СРезультат.Грузополучатель);
	Исключение 
		Справочники["ШтрихкодыУпаковокТоваров"].СоздатьШтрихкодыУпаковок(ВозвращаемоеДерево, ШтрихкодыУпаковок, Ложь, Док1СРезультат.Грузополучатель);
	КонецПопытки;
		
	// см. Документы.ТТНВходящаяЕГАИС.ФормаДокумента.СканированиеАлкогольнойПродукцииПослеЗакрытияНаСервере
	
	Док1СРезультат.АкцизныеМарки.Очистить();
		
	Документы["ТТНВходящаяЕГАИС"].ЗаполнитьАкцизныеМарки(
		Док1СРезультат,
		ВозвращаемоеДерево);
			
	Документы["ТТНВходящаяЕГАИС"].ЗаполнитьФактическоеКоличество(
		Док1СРезультат,
		ВозвращаемоеДерево,
		ТаблицаНеМаркируемойПродукции);
		
	Док1СРезультат.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Завершено");
		
	ПараметрыОбновленияСтатуса = ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ПараметрыОбновленияСтатуса();
	ПараметрыОбновленияСтатуса.ОбновлятьДвижения = Ложь;
	ПараметрыОбновленияСтатуса.СтатусОбработки   = ПредопределенноеЗначение("Перечисление.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС");
	ПараметрыОбновленияСтатуса.ДокументОбъект    = Док1СРезультат;
		
	Документы["ТТНВходящаяЕГАИС"].ОбновитьСтатусПослеПолученияДанных(
		Док1СРезультат.Ссылка, ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.ТТН"), ПараметрыОбновленияСтатуса);
	
КонецПроцедуры

Процедура ТТНИсходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров)

	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;
	ДокументТСД		= СтруктураПараметров.ДокументТСД;
	
	СтруктураПараметров.Вставить("ВерсииОбъектовКонфигурации", ВерсииОбъектовКонфигурации());
	
	ДанныеПроверкиИПодбора = Док1СРезультат.ДанныеПроверкиИПодбора.Получить();
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		Док1СРезультат.Записать();
		
		// Формируем структуру данных проверки и подбора по данным факта
		ДанныеПроверкиИПодбора = ДанныеДокумента_ПроверкаИПодборАлкогольнойПродукцииЕГАИС(Док1СРезультат, СтруктураПараметров);
	КонецЕсли;
	
	ДеревоМаркированнойПродукции				= ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
	ТаблицаНеМаркируемойПродукции				= ДанныеПроверкиИПодбора.ТаблицаНеМаркируемойПродукции;
	АлкогольнаяПродукцияКОпределениюСправок2	= ДанныеПроверкиИПодбора.АлкогольнаяПродукцияКОпределениюСправок2;
	
	ТаблицаИзмененийАлкогольнойПродукции = ЕГАИС_ТаблицаИзмененийАлкогольнойПродукции();
	
	// Дополняем существующее дерево маркированной продукции данными факта
	ТТНИсходящаяЕГАИС_ЗаполнитьДеревоДанныеПроверкиИПодбора(СтруктураПараметров, ДеревоМаркированнойПродукции, ТаблицаИзмененийАлкогольнойПродукции);
	
	Для Каждого Товар Из Док1СРезультат.Товары Цикл
		Если Не Товар.АлкогольнаяПродукция.ВидПродукции.Маркируемый Тогда
			НоваяСтрокаТНМП = ТаблицаНеМаркируемойПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТНМП, Товар);
			
			НоваяСтрокаТНМП.КоличествоФактическое = Товар.КоличествоФакт;
			НоваяСтрокаТНМП.КоличествоПоДокументу = Товар.КоличествоФакт;
			
			Если Не ЗначениеЗаполнено(Товар.Справка2) Тогда
				НоваяСтрокаАПСправка2 = АлкогольнаяПродукцияКОпределениюСправок2.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаАПСправка2, Товар);
				НоваяСтрокаАПСправка2.Маркируемая = Ложь;
			КонецЕсли;
		КонецЕсли;
    КонецЦикла;
	
	ЗавершатьПроверку = Ложь;
	
	ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
    Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНИсходящаяЕГАИС") Тогда
		ЗавершатьПроверку = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборОтгрузка"), СтруктураПараметров) = Истина;
	ИначеЕсли ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.АктСписанияЕГАИС") Тогда
		ЗавершатьПроверку = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборВозвратСписание"), СтруктураПараметров) = Истина;
	КонецЕсли;
	
	УпаковкиДокумента = Новый СписокЗначений;
	
	// Отмечаем статусы существующих в дереве марок
	ЗаполнитьДанныеАкцизныхМарок(ДеревоМаркированнойПродукции.Строки, ДокументТСД.СтрокиФакт, СтруктураПараметров,, ЗавершатьПроверку, ТаблицаИзмененийАлкогольнойПродукции);
	
	// Закомментировано. Дерево маркированной продукции уже заполнено по данным факта
	//Если ДокументТСД.СтрокиФакт.Количество() > 1 Тогда
	//	ДополнитьДеревоДанныеПроверкиИПодбора(ДокументТСД.СтрокиФакт, ДанныеПроверкиИПодбора, СтруктураПараметров);
	//КонецЕсли;
	
	//ЕГАИС_ОпределитьСправки2ПриСозданииДереваУпаковок(ДеревоМаркированнойПродукции.Строки, АлкогольнаяПродукцияКОпределениюСправок2);
	
	ЕГАИС_ОбработатьТаблицуИзмененияАлкогольнойПродукции(ТаблицаИзмененийАлкогольнойПродукции, АлкогольнаяПродукцияКОпределениюСправок2);
	
	ТТН_ЕГАИС_ДополнитьДерево(ДеревоМаркированнойПродукции);
	
	// Расчет хеш-сумм
	ТаблицаХешСумм = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ПустаяТаблицаХешСумм();
	Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").РассчитатьХешСуммыУпаковки(СтрокаДерева, ТаблицаХешСумм, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	// Доработать при необходимости загружать марки партионной продукции
	//МаркиПартионнойПродукции = Новый Массив();
	//УстановитьСтатусАкцизныхМарок(МаркиПартионнойПродукции, СтруктураПараметров);
	
	Док1СРезультат.ДанныеПроверкиИПодбора = Новый ХранилищеЗначения(ДанныеПроверкиИПодбора);
	
	Если ЗавершатьПроверку Тогда
		НачатьТранзакцию();
		Попытка
			ТТНИсходящаяЕГАИС_ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат, ДеревоМаркированнойПродукции, ТаблицаНеМаркируемойПродукции);
			
			ЗафиксироватьТранзакцию();
		Исключение
			Сообщить("Не удалось завершить проверку алкогольной продукции в документе " + Строка(Док1СРезультат) + ". Подробности см. в журнале регистрации.");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ТТНИсходящаяЕГАИС_ОтразитьЗавершениеПроверкиДокумента", "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ОтменитьТранзакцию();
		КонецПопытки;
		
		//ТТНИсходящаяЕГАИС_ЗавершениеПроверки(СтруктураПараметров);
	Иначе
		Док1СРезультат.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
	 
КонецПроцедуры

Процедура АктПостановкиНаБалансЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров)

	ТТНИсходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров);
	
КонецПроцедуры

Процедура АктСписанияЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров)

	ТТНИсходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров);
	
КонецПроцедуры

Функция ДанныеДокумента_ПроверкаИПодборАлкогольнойПродукцииЕГАИС(Док1СРезультат, СтруктураПараметров)
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияПродукцииИС") <> Неопределено  Тогда 
		НачальныйСтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");
	Иначе
		НачальныйСтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеПроверялась");
	КонецЕсли;
	
	Параметры = Новый Структура();
	Параметры.Вставить("НачальныйСтатусПроверки", НачальныйСтатусПроверки);
	Параметры.Вставить("ДетализацияСтруктурыХранения");
	Параметры.Вставить("РедактированиеФормыНедоступно");
	Параметры.Вставить("РежимПодбораСуществующихУпаковок");
	Параметры.Вставить("КонтролироватьСканируемуюПродукциюПоДокументуОснованию");
	
	// Код из Обработки "ПроверкаИПодборАлкогольнойПродукцииЕГАИС"
	// Процедура "ЗагрузитьДанныеДокументаДлительнаяОперация"
	
	ДанныеДокумента = Новый Структура();
	ДанныеДокумента.Вставить("ДеревоМаркированнойПродукции",             ДеревоМаркированнойПродукции(СтруктураПараметров.ВерсииОбъектовКонфигурации));
	ДанныеДокумента.Вставить("АлкогольнаяПродукцияКОпределениюСправок2", АлкогольнаяПродукцияКОпределениюСправок2());
	ДанныеДокумента.Вставить("ПулНеизвестныхАкцизныхМарок",              ПулНеизвестныхАкцизныхМарок());
	ДанныеДокумента.Вставить("ТаблицаНеМаркируемойПродукции",            ТаблицаНеМаркируемойПродукции());
	ДанныеДокумента.Вставить("Справки2СопоставленнаяНоменклатура",       Справки2СопоставленнаяНоменклатура());
	ДанныеДокумента.Вставить("ТаблицаШтрихкодовНеМаркируемойПродукции",  ТаблицаШтрихкодовНеМаркируемойПродукции());
	ДанныеДокумента.Вставить("УпаковкиДокумента",                        Новый СписокЗначений());
	ДанныеДокумента.Вставить("ДобавленныеУпаковки",                      Новый СписокЗначений());
	ДанныеДокумента.Вставить("ДоступныеДляПроверкиУпаковки",             Новый СписокЗначений());
	ДанныеДокумента.Вставить("НачальныйСтатусПроверки",                  Параметры.НачальныйСтатусПроверки);
	ДанныеДокумента.Вставить("ДетализацияСтруктурыХранения",             Параметры.ДетализацияСтруктурыХранения);
	ДанныеДокумента.Вставить("РедактированиеФормыНедоступно",            Параметры.РедактированиеФормыНедоступно);
	ДанныеДокумента.Вставить("РежимПодбораСуществующихУпаковок",         Параметры.РежимПодбораСуществующихУпаковок);
	ДанныеДокумента.Вставить("КонтролироватьСканируемуюПродукциюПоДокументуОснованию", Параметры.КонтролироватьСканируемуюПродукциюПоДокументуОснованию);
	
	СохраненнаяДетализацияСтруктурыХранения = Неопределено;
	
	ДанныеДокумента.Вставить("СохраненнаяДетализацияСтруктурыХранения", СохраненнаяДетализацияСтруктурыХранения);
	ДанныеДокумента.Вставить("СтрокаБутылкиБезКоробки", Неопределено);

	Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНВходящаяЕГАИС") Тогда

		ИО_ОбщийМодуль("ИнтеграцияЕГАИСПереопределяемый").ЗаполнитьТаблицуШтрихкодовНеМаркируемойПродукцииТТН_ЕГАИС(
			Док1СРезультат.Ссылка, ДанныеДокумента.ТаблицаШтрихкодовНеМаркируемойПродукции);
		
		ИО_ОбщийМодуль("ИнтеграцияЕГАИСПереопределяемый").ЗаполнитьТаблицуСопоставленныхСправок2ТТН_ЕГАИС(
			Док1СРезультат.Ссылка, ДанныеДокумента.Справки2СопоставленнаяНоменклатура);
		
		ДанныеПроверяемогоДокумента = Документы["ТТНВходящаяЕГАИС"].ВходящееДеревоУпаковок(Док1СРезультат.Ссылка);
		
		ЕГАИС_ЗагрузитьДеревоМаркированнойПродукции(ДанныеПроверяемогоДокумента.ДеревоУпаковок, ДанныеДокумента);
		ЕГАИС_ЗаполнитьТаблицуПартионнойПродукции(ДанныеПроверяемогоДокумента.ТоварыБезАкцизныхМарок, ДанныеДокумента);
		ЕГАИС_ЗаполнитьПулНеизвестныхАкцизныхМарок(ДанныеДокумента);
		
		ДанныеДокумента.Вставить("СтрокаБутылкиБезКоробки", Неопределено); // В хранилище значений строку дерева хранить не нужно
		
	ИначеЕсли ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.АктПостановкиНаБалансЕГАИС")
		Или ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.АктСписанияЕГАИС")
		Или ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ЧекЕГАИС")
		Или ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ЧекЕГАИСВозврат")
		Или ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ОтчетОПроизводствеЕГАИС") Тогда
		
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Док1СРезультат.Ссылка);
		ТаблицаКОпределениюСправок2 = МенеджерДокумента.ТаблицаАлкогольнойПродукцииКОпределениюСправок2(Док1СРезультат.Ссылка);
		
		ЕГАИС_ЗаполнитьДеревоКОпределениюСправок2(ТаблицаКОпределениюСправок2, ДанныеДокумента);	
		
	ИначеЕсли ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНИсходящаяЕГАИС") Тогда
		
		ТаблицаКОпределениюСправок2 = Документы.ТТНИсходящаяЕГАИС.ТаблицаАлкогольнойПродукцииКОпределениюСправок2(Док1СРезультат.Ссылка);
		ЕГАИС_ЗаполнитьДеревоКОпределениюСправок2(ТаблицаКОпределениюСправок2, ДанныеДокумента);

	КонецЕсли;

	Возврат	ДанныеДокумента;

КонецФункции

