		//Док1СРезультат.ОбменДанными.Загрузка = Истина; // Без этого документ никак не записывается
		Док1СРезультат.Записать();
	КонецЕсли;
	
	//ПараметрыОкончанияПроверки = Вычислить("ПроверкаИПодборПродукцииИСМП.ПараметрыОкончанияПроверки()");
	ПараметрыОкончанияПроверки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПараметрыОкончанияПроверки();
