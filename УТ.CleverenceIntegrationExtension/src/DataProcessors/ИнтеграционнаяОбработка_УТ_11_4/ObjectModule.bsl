			Исключение
				РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
			КонецПопытки;
			
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	
	ДокументПроведенПриПроверкеИСМП = Неопределено;
	Если СтруктураПараметров.Свойство("ДокументПроведенПриПроверкеИСМП", ДокументПроведенПриПроверкеИСМП) Тогда
		ЗавершатьПроверку = ДокументПроведенПриПроверкеИСМП;
	Иначе
		// Завершаем проверку только при условии успешного проведения документа
		Если ЗавершатьПроверку Тогда
			//НачатьТранзакцию();
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);
					
				СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
				СтруктураПараметров.Вставить("ДокументПроведенПриПроверкеИСМП", Истина);
				
				//ЗафиксироватьТранзакцию();
			Исключение
				//ОтменитьТранзакцию();
				ЗавершатьПроверку = Ложь;
				
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьТабачнуюПродукциюИСМПСЗапросомДанных", "Ошибка", "Ошибка при проведении " + Док1СРезультат + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
				СтруктураПараметров.Вставить("ДокументПроведенПриПроверкеИСМП", Ложь);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗавершатьПроверку Тогда
		МОТП_ЗафиксироватьРезультатПроверкиИПодбора(Док1СРезультат, ДеревоМаркированнойПродукции, ПодобраннаяМаркируемаяПродукция, ВидПродукцииИС);
		Док1СРезультат.Прочитать();
		Попытка
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора, ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить"));
		Исключение
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора, ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить"));
		КонецПопытки;
	Иначе
		Попытка
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
		Исключение
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, хзДанныеПроверкиИПодбора);
		КонецПопытки;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике",Истина);
		
КонецПроцедуры

Процедура МОТП_ДобавитьСтрокиВТаблицуМаркированнойПродукции(ТаблицаМаркированнойПродукции, СтруктураПоиска, СтрокаДокументаТСД = Неопределено, ВидПродукцииИС = Неопределено)

	РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(СтруктураПоиска);
	Если РезПоиска.Количество() <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодПалеты") Тогда
		СтруктураПоиска.Вставить("ШтрихкодПалеты", "");
	КонецЕсли;
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодКоробки") Тогда
		СтруктураПоиска.Вставить("ШтрихкодКоробки", "");
	КонецЕсли;
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодБлока") Тогда
		СтруктураПоиска.Вставить("ШтрихкодБлока", "");
	КонецЕсли;
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодПачки") Тогда
		СтруктураПоиска.Вставить("ШтрихкодПачки", "");
	КонецЕсли;
	
	// Пропускаем элементы с циклическими вложениями
	Если ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) И СтруктураПоиска.ШтрихкодПачки = СтруктураПоиска.ШтрихкодБлока
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) И СтруктураПоиска.ШтрихкодПачки = СтруктураПоиска.ШтрихкодКоробки
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) И СтруктураПоиска.ШтрихкодПачки = СтруктураПоиска.ШтрихкодПалеты
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодБлока) И СтруктураПоиска.ШтрихкодБлока = СтруктураПоиска.ШтрихкодКоробки
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодБлока) И СтруктураПоиска.ШтрихкодБлока = СтруктураПоиска.ШтрихкодПалеты
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодКоробки) И СтруктураПоиска.ШтрихкодКоробки = СтруктураПоиска.ШтрихкодПалеты Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнение верхнего уровня упаковок по тем элементам, которые уже есть в ТаблицаМаркированнойПродукции
	Если НЕ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) Тогда
		Если ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодБлока) Тогда
			РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодБлока", СтруктураПоиска.ШтрихкодБлока));
			
			СтрокиЗаполнены = Ложь;
			Для каждого НайденнаяСтрока ИЗ РезПоиска Цикл
				Если НЕ (ЗначениеЗаполнено(НайденнаяСтрока.ШтрихкодПалеты) ИЛИ ЗначениеЗаполнено(НайденнаяСтрока.ШтрихкодКоробки)) Тогда
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтруктураПоиска, "ШтрихкодКоробки, ШтрихкодПалеты");
					СтрокиЗаполнены = Истина;
				КонецЕсли;
			КонецЦикла;	
				
			Если СтрокиЗаполнены Тогда
				Возврат;
			КонецЕсли;
		Иначе
			РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодКоробки", СтруктураПоиска.ШтрихкодКоробки));
			
			СтрокиЗаполнены = Ложь;
			Для каждого НайденнаяСтрока ИЗ РезПоиска Цикл
				Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ШтрихкодПалеты) Тогда
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтруктураПоиска, "ШтрихкодПалеты");
					СтрокиЗаполнены = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокиЗаполнены Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
		Номенклатура   = СтрокаДокументаТСД.Номенклатура;
		Характеристика = СтрокаДокументаТСД.Характеристика;
	Иначе
		Номенклатура   = Неопределено;
		Характеристика = Неопределено;
	КонецЕсли;
	
	ТаблицаПустыхБлоков = Новый ТаблицаЗначений;
	ТаблицаПустыхБлоков.Колонки.Добавить("ШтрихкодБлока");
	ТаблицаПустыхБлоков.Колонки.Добавить("ШтрихкодEAN");
	
	ТаблицаПустыхКоробок = Новый ТаблицаЗначений;
	ТаблицаПустыхКоробок.Колонки.Добавить("ШтрихкодКоробки");
	ТаблицаПустыхКоробок.Колонки.Добавить("ШтрихкодEAN");
	
	СтатусПроверкиВНаличии = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
	
	Если ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) Тогда
		
		ЗначениеШтрихкода = СтруктураПоиска.ШтрихкодПачки;
		
	    НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
		НоваяСтрока.СтатусПроверки 		= СтатусПроверкиВНаличии;	
		НоваяСтрока.Номенклатура		= Номенклатура;
		НоваяСтрока.Характеристика		= Характеристика;
		НоваяСтрока.КоличествоУпаковок 	= 1;
		НоваяСтрока.GTIN 			   	= ?(Лев(ЗначениеШтрихкода, 1) = "(", Сред(ЗначениеШтрихкода, 5, 14), Лев(ЗначениеШтрихкода, 14));
		
	ИначеЕсли ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодБлока) Тогда
		
		// Собираем содержимое блока по данным ШУИТ
		БлокШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(СтруктураПоиска.ШтрихкодБлока);
				
		Если ЗначениеЗаполнено(БлокШУИТ) И БлокШУИТ.ВложенныеШтрихкоды.Количество() Тогда
			
			Для каждого ШтрихкодПачки ИЗ БлокШУИТ.ВложенныеШтрихкоды Цикл
				
				ЗначениеШтрихкода = ШтрихкодПачки.Штрихкод.ЗначениеШтрихкода;
				
				Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
					ПачкаШУИТ = ШтрихкодПачки.Штрихкод;
					
					Номенклатура   = ПачкаШУИТ.Номенклатура;
					Характеристика = ПачкаШУИТ.Характеристика;
				КонецЕсли;
				
				СтруктураПоиска.Вставить("ШтрихкодПачки", ЗначениеШтрихкода);
					
			    НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
	
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
				НоваяСтрока.СтатусПроверки 		= СтатусПроверкиВНаличии;	
				НоваяСтрока.Номенклатура		= Номенклатура;
				НоваяСтрока.Характеристика		= Характеристика;
				НоваяСтрока.КоличествоУпаковок 	= 1;
				НоваяСтрока.GTIN				= ?(Лев(ЗначениеШтрихкода, 1) = "(", Сред(ЗначениеШтрихкода, 5, 14), Лев(ЗначениеШтрихкода, 14));
				
			КонецЦикла;
			
		Иначе	
			
			ЗначениеШтрихкода = СтруктураПоиска.ШтрихкодБлока;
			
			// У блока может быть заполнена номенклатура
			Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) И ЗначениеЗаполнено(БлокШУИТ) Тогда
				Номенклатура 	= БлокШУИТ.Номенклатура;
				Характеристика 	= БлокШУИТ.Характеристика;
			КонецЕсли;
			
			// Вложенных пачек нет
			НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
			НоваяСтрока.СтатусПроверки 		= СтатусПроверкиВНаличии;	
			НоваяСтрока.Номенклатура		= Номенклатура;
			НоваяСтрока.Характеристика		= Характеристика;
			НоваяСтрока.КоличествоУпаковок 	= 1;
			НоваяСтрока.GTIN 			   	= ?(Лев(ЗначениеШтрихкода, 1) = "(", Сред(ЗначениеШтрихкода, 5, 14), Лев(ЗначениеШтрихкода, 14));
			
			СтрокаПустогоБлока = ТаблицаПустыхБлоков.Добавить();
			СтрокаПустогоБлока.ШтрихкодБлока = ЗначениеШтрихкода;
			СтрокаПустогоБлока.ШтрихкодEAN	 = ШтрихкодированиеИСКлиентСервер_ШтрихкодEANИзGTIN(НоваяСтрока.GTIN);
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодКоробки) Тогда
		
		// Собираем структуру вложенных штрихкодов
		КоробкаШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(СтруктураПоиска.ШтрихкодКоробки);
			
		Если ЗначениеЗаполнено(КоробкаШУИТ) И КоробкаШУИТ.ВложенныеШтрихкоды.Количество() Тогда
			
			Для каждого ШтрихкодБлока ИЗ КоробкаШУИТ.ВложенныеШтрихкоды Цикл
				
				ЗначениеШтрихкода = ШтрихкодБлока.Штрихкод.ЗначениеШтрихкода;
				
				БлокШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(ЗначениеШтрихкода);
				Если НЕ ЗначениеЗаполнено(БлокШУИТ) Тогда
					БлокШУИТ = ШтрихкодБлока.Штрихкод;
				КонецЕсли;
					
				СтруктураПоиска.Вставить("ШтрихкодБлока", ЗначениеШтрихкода);
				
				Если ЗначениеЗаполнено(БлокШУИТ) И БлокШУИТ.ВложенныеШтрихкоды.Количество() Тогда
					
					Для каждого ШтрихкодПачки ИЗ БлокШУИТ.ВложенныеШтрихкоды Цикл
						
						ЗначениеШтрихкода = ШтрихкодПачки.Штрихкод.ЗначениеШтрихкода;
						
						Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
							ПачкаШУИТ = ШтрихкодПачки.Штрихкод;
							
							Номенклатура   = ПачкаШУИТ.Номенклатура;
							Характеристика = ПачкаШУИТ.Характеристика;
						КонецЕсли;
						
						СтруктураПоиска.Вставить("ШтрихкодПачки", ЗначениеШтрихкода);
						
					    НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
		
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
						НоваяСтрока.СтатусПроверки 		= СтатусПроверкиВНаличии;	
						НоваяСтрока.Номенклатура		= Номенклатура;
						НоваяСтрока.Характеристика		= Характеристика;
						НоваяСтрока.КоличествоУпаковок 	= 1;
						НоваяСтрока.GTIN 			   	= ?(Лев(ЗначениеШтрихкода, 1) = "(", Сред(ЗначениеШтрихкода, 5, 14), Лев(ЗначениеШтрихкода, 14));
						
					КонецЦикла;
					
				Иначе	
					
					// У блока может быть заполнена номенклатура
					Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) И ЗначениеЗаполнено(БлокШУИТ) Тогда
						Номенклатура 	= БлокШУИТ.Номенклатура;
						Характеристика 	= БлокШУИТ.Характеристика;
					КонецЕсли;
					
					// Вложенных пачек нет
					НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
					НоваяСтрока.СтатусПроверки 		= СтатусПроверкиВНаличии;	
					НоваяСтрока.Номенклатура		= Номенклатура;
					НоваяСтрока.Характеристика		= Характеристика;
					НоваяСтрока.КоличествоУпаковок 	= 1;
					НоваяСтрока.GTIN 			   	= ?(Лев(ЗначениеШтрихкода, 1) = "(", Сред(ЗначениеШтрихкода, 5, 14), Лев(ЗначениеШтрихкода, 14));
					
					СтрокаПустогоБлока = ТаблицаПустыхБлоков.Добавить();
					СтрокаПустогоБлока.ШтрихкодБлока = ЗначениеШтрихкода;
					СтрокаПустогоБлока.ШтрихкодEAN	 = ШтрихкодированиеИСКлиентСервер_ШтрихкодEANИзGTIN(НоваяСтрока.GTIN);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе	
			
			ЗначениеШтрихкода = СтруктураПоиска.ШтрихкодКоробки;
				
			// Вложенных блоков нет
			НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
			НоваяСтрока.СтатусПроверки 		= СтатусПроверкиВНаличии;	
			НоваяСтрока.Номенклатура		= Номенклатура;
			НоваяСтрока.Характеристика		= Характеристика;
			НоваяСтрока.КоличествоУпаковок 	= 1;
			НоваяСтрока.GTIN 			   	= ?(Лев(ЗначениеШтрихкода, 1) = "(", Сред(ЗначениеШтрихкода, 5, 14), Сред(ЗначениеШтрихкода, 3, 14));
			
			СтрокаПустогоКороба = ТаблицаПустыхКоробок.Добавить();
			СтрокаПустогоКороба.ШтрихкодКоробки = ЗначениеШтрихкода;
			СтрокаПустогоКороба.ШтрихкодEAN	= ШтрихкодированиеИСКлиентСервер_ШтрихкодEANИзGTIN(НоваяСтрока.GTIN);
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если ТаблицаПустыхБлоков.Количество() Тогда
		МОТП_ПолучитьПлановуюИнформациюПоБлокамБезВложенныхПачек(ТаблицаМаркированнойПродукции, ТаблицаПустыхБлоков);
	КонецЕсли;
	
	Если ТаблицаПустыхКоробок.Количество() Тогда
		МОТП_ПолучитьПлановуюИнформациюПоКоробамБезВложенныхБлоков(ТаблицаМаркированнойПродукции, ТаблицаПустыхКоробок);
	КонецЕсли;
	
КонецПроцедуры

Процедура МОТП_ПолучитьПлановуюИнформациюПоБлокамБезВложенныхПачек(ТаблицаМаркированнойПродукции, ТаблицаПустыхБлоков)

	ИмяСобытия = "МОТП_ПолучитьПлановуюИнформациюПоБлокамБезВложенныхПачек";
	
	Попытка
		ШтрихкодыEAN = ТаблицаПустыхБлоков.Скопировать(, "ШтрихкодEAN");
		ШтрихкодыEAN.Свернуть("ШтрихкодEAN");
		
		ДанныеПоШтрихкодамEAN = ШтрихкодированиеИС_ДанныеПоШтрихкодамEAN(ШтрихкодыEAN.ВыгрузитьКолонку("ШтрихкодEAN"));
		Для каждого ДанныеБлока ИЗ ТаблицаПустыхБлоков Цикл
			ДанныеШтрихкода = ДанныеПоШтрихкодамEAN.Найти(ДанныеБлока.ШтрихкодEAN, "ШтрихкодEAN");
			Если НЕ ДанныеШтрихкода = Неопределено Тогда
				КоличествоПотребительскихУпаковок = ДанныеШтрихкода.ПлановоеКоличествоПотребительскихУпаковок;
				Если КоличествоПотребительскихУпаковок > 0 Тогда
					СтруктураОтбора = Новый Структура("ШтрихкодБлока, ШтрихкодПачки", ДанныеБлока.ШтрихкодБлока, "");
					
					НайденныеСтроки = ТаблицаМаркированнойПродукции.НайтиСтроки(СтруктураОтбора);
					Для каждого НайденнаяСтрока ИЗ НайденныеСтроки Цикл
						НайденнаяСтрока.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура МОТП_ПолучитьПлановуюИнформациюПоКоробамБезВложенныхБлоков(ТаблицаМаркированнойПродукции, ТаблицаПустыхКоробок)

	ИмяСобытия = "МОТП_ПолучитьПлановуюИнформациюПоКоробамБезВложенныхБлоков";
	
	Попытка
		ШтрихкодыEAN = ТаблицаПустыхКоробок.Скопировать(, "ШтрихкодEAN");
		ШтрихкодыEAN.Свернуть("ШтрихкодEAN");
		
		ДанныеПоШтрихкодамEAN = ШтрихкодированиеИС_ДанныеПоШтрихкодамEAN(ШтрихкодыEAN.ВыгрузитьКолонку("ШтрихкодEAN"));
		Для каждого ДанныеКоробки ИЗ ТаблицаПустыхКоробок Цикл
			ДанныеШтрихкода = ДанныеПоШтрихкодамEAN.Найти(ДанныеКоробки.ШтрихкодEAN, "ШтрихкодEAN");
			Если НЕ ДанныеШтрихкода = Неопределено Тогда
				КоличествоПотребительскихУпаковок = ДанныеШтрихкода.ПлановоеКоличествоПотребительскихУпаковок;
				Если КоличествоПотребительскихУпаковок > 0 Тогда
					СтруктураОтбора = Новый Структура("ШтрихкодКоробки, ШтрихкодБлока, ШтрихкодПачки", ДанныеКоробки.ШтрихкодКоробки, "", "");
					
					НайденныеСтроки = ТаблицаМаркированнойПродукции.НайтиСтроки(СтруктураОтбора);
					Для каждого НайденнаяСтрока ИЗ НайденныеСтроки Цикл
						НайденнаяСтрока.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура МОТП_ЗафиксироватьРезультатПроверкиИПодбора(Док1СРезультат, ДеревоМаркированнойПродукции, ПодобраннаяМаркируемаяПродукция, ВидПродукцииИС)

	ПараметрыОкончанияПроверки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПараметрыОкончанияПроверки();
	
	ДеревоМаркированнойПродукции.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	Если ДеревоМаркированнойПродукции.Колонки.Найти("КоличествоПодчиненныхПачек") <> Неопределено Тогда
		ДеревоМаркированнойПродукции.Колонки["КоличествоПодчиненныхПачек"].Имя = "КоличествоПодчиненнойПродукции";
	КонецЕсли;	
	
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").УдалитьПустыеУпаковкиДерева(ДеревоМаркированнойПродукции);
	Исключение
	КонецПопытки;
	
	ТаблицаШтрихкодовВерхнегоУровня        = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаШтрихкодовВерхнегоУровня();
	ТаблицаПодобраннойПровереннойПродукции = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаПодобраннойПровереннойПродукции();
	ТаблицаПодобраннойПровереннойПродукции.Колонки.Добавить("МРЦ", ОбщегоНазначения.ОписаниеТипаЧисло(10, 2));
		
	Попытка
		ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовВНаличииИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено));
	Исключение
		ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукции, Неопределено));
	КонецПопытки;
		 
	ШтрихкодыУпаковокСозданы = Истина;
	Попытка
		ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(ИО_ОбщийМодуль("ШтрихкодированиеИС").ПолучитьСтруктуруРеквизитовДокумента(Док1СРезультат));
	
		ПараметрыСозданияШтрихкодов = Справочники["ШтрихкодыУпаковокТоваров"].ПараметрыСозданияШтриходовУпаковокПоДеревуМаркируемойПродукции(
			ДеревоМаркированнойПродукции, ПараметрыСканирования);
		ПараметрыСозданияШтрихкодов.ВидПродукции = ВидПродукцииИС;
		
		Справочники["ШтрихкодыУпаковокТоваров"].РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(
			ДеревоМаркированнойПродукции, ТаблицаШтрихкодовВерхнегоУровня,
			ПараметрыСозданияШтрихкодов);
	Исключение	
		ШтрихкодыУпаковокСозданы = Ложь;		
	КонецПопытки;

	Если НЕ ШтрихкодыУпаковокСозданы Тогда
		Справочники["ШтрихкодыУпаковокТоваров"].РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(ДеревоМаркированнойПродукции, ТаблицаШтрихкодовВерхнегоУровня, ШтрихКодыУпаковок);
	КонецЕсли;
		
	Если Док1СРезультат.Метаданные().ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено Тогда																										 
		Док1СРезультат.ШтрихкодыУпаковок.Очистить();
		Для каждого ШКУпаковки Из ШтрихКодыУпаковок Цикл
			НоваяСтрока = Док1СРезультат.ШтрихкодыУпаковок.Добавить();
			НоваяСтрока.ШтрихкодУпаковки = ШКУпаковки.Ссылка;
		КонецЦикла;																										 
	КонецЕсли;
		
	ЕстьРасхождения = Ложь;
		
	ЕстьКолонкаКоличествоПотребительскихУпаковок = ПодобраннаяМаркируемаяПродукция.Колонки.Найти("ПодобраннаяМаркируемаяПродукция") <> Неопределено;
	
	Для Каждого СтрокаДерева Из ПодобраннаяМаркируемаяПродукция Цикл
			
		НоваяСтрока = ТаблицаПодобраннойПровереннойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		Если Не ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
			НоваяСтрока.Характеристика = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.Серия) Тогда
			НоваяСтрока.Серия = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры");
		КонецЕсли;
			
		Если НоваяСтрока.Количество <> НоваяСтрока.КоличествоПодобрано Тогда
			ЕстьРасхождения = Истина;
		КонецЕсли;
			
		Если ЕстьКолонкаКоличествоПотребительскихУпаковок И Не СтрокаДерева.ПроизвольнаяЕдиницаУчета Тогда
			НоваяСтрока.КоличествоПотребительскихУпаковок = 0;
		КонецЕсли;
		
	КонецЦикла;
		
	ПараметрыОкончанияПроверки.Вставить("ВидПродукцииИС", 	   			   		  ВидПродукцииИС);
	ПараметрыОкончанияПроверки.Вставить("ПроверяемыйДокумент", 					  Док1СРезультат.Ссылка);
	ПараметрыОкончанияПроверки.Вставить("ТаблицаШтрихкодовВерхнегоУровня", 		  ТаблицаШтрихкодовВерхнегоУровня);
	ПараметрыОкончанияПроверки.Вставить("ТаблицаПодобраннойПровереннойПродукции", ТаблицаПодобраннойПровереннойПродукции);
		
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ЗафиксироватьРезультатПроверкиИПодбора(ПараметрыОкончанияПроверки);
	
КонецПроцедуры

Функция ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(ЗначениеШтрихкода = "")
	
	Если НЕ ЗначениеЗаполнено(ЗначениеШтрихкода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭлементШУИТ = Справочники["ШтрихкодыУпаковокТоваров"].ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	               |	КОЛИЧЕСТВО(ЕСТЬNULL(ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Штрихкод, 0)) КАК КоличествоВложенных
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ШтрихкодыУпаковокТоваровВложенныеШтрихкоды
	               |		ПО (ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Ссылка = ШтрихкодыУпаковокТоваров.Ссылка)
	               |ГДЕ
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ШтрихкодыУпаковокТоваров.Ссылка,
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ШтрихкодыУпаковокТоваров.ПометкаУдаления,
	               |	КоличествоВложенных УБЫВ";
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", ЗначениеШтрихкода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.ЗначениеШтрихкода = ЗначениеШтрихкода Тогда
			Продолжить;
		КонецЕсли;
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат ЭлементШУИТ;
	
КонецФункции

Процедура ВставитьВСтрокуИДобавитьВМассивБезДублей(СтрокаФакт, Ключ, Значение, МассивВсехШК, МассивНеизвестныхШК, СоответствияШКНоменклатуре, ТребуетсяЗапросВИСМП = Ложь, ДанныеКодаМаркировки)
	
	ПачкаСМРЦ = Ложь;
	Если Лев(Значение, 1) <> "("
		И СтрДлина(Значение) = 25 Тогда
		ПачкаСМРЦ = Истина;
	КонецЕсли;
	
	ПозицияМРЦ = Найти(Значение, "(8005)");
	
	ЗначениеБезМРЦ = "";	
	Если ПачкаСМРЦ Тогда
		ЗначениеБезМРЦ = Лев(Значение, 21)
	ИначеЕсли ПозицияМРЦ > 0 Тогда
		ЗначениеБезМРЦ = Лев(Значение, ПозицияМРЦ - 1);
	КонецЕсли;
	
	Если ЗначениеБезМРЦ <> "" Тогда
		// Проверяем, есть ли отсканированный ШК с МРЦ в ШУИТе
		ШУИТ = НайтиУпаковкуТоваровПоШтрихкоду(Значение);
		Если ШУИТ = Неопределено Тогда
			// Если в ШУИТе нет отсканированного ШК с МРЦ, проверяем, нет ли аналогичного ШК без МРЦ
			ШУИТ = НайтиУпаковкуТоваровПоШтрихкоду(ЗначениеБезМРЦ);
			Если ШУИТ <> Неопределено Тогда
				// Если ШК без МРЦ найден в ШУИТе, далее работаем с ним
				Значение 		= ЗначениеБезМРЦ;
				ЗначениеБезМРЦ	= "";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаФакт.Вставить(Ключ, Значение);
	
	Если ЗначениеЗаполнено(Значение)
		И МассивВсехШК.Найти(Значение) = Неопределено Тогда
		
		МассивВсехШК.Добавить(Значение);
		Если ЗначениеБезМРЦ <> "" Тогда
			МассивВсехШК.Добавить(ЗначениеБезМРЦ);
		КонецЕсли;
		
		СтруктураДанных = ПодготовитьСтруктуруДляСопоставленияДанныхШК();
		СтруктураДанных.Номенклатура 	= СтрокаФакт.Номенклатура;
		СтруктураДанных.Характеристика 	= СтрокаФакт.Характеристика;
		//СтруктураДанных.Серия 		= СтрокаФакт.Серия;
		
		Если ДанныеКодаМаркировки <> Неопределено Тогда 
			СтруктураДанных.ВидУпаковки = ДанныеКодаМаркировки.ВидУпаковки;
		КонецЕсли;
		
		//ШтрихкодУпаковкиСсылка = НайтиУпаковкуТоваровПоШтрихкоду(Значение);		
		//Если ШтрихкодУпаковкиСсылка = Неопределено 
		//	Или ТребуетсяЗапросВИСМП Тогда
			МассивНеизвестныхШК.Добавить(Значение);
		//Иначе			
		//	СтруктураДанных.ШтрихкодУпаковки = ШтрихкодУпаковкиСсылка;
		//КонецЕсли;
		//СтруктураДанных.ТребуетсяЗапросВИСМП = ТребуетсяЗапросВИСМП;
		
		СоответствияШКНоменклатуре.Вставить(Значение,СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьСтруктуруДляСопоставленияДанныхШК()
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("Номенклатура");
	СтруктураДанных.Вставить("Характеристика");
	СтруктураДанных.Вставить("Серия");		
	СтруктураДанных.Вставить("ШтрихкодУпаковки");
	СтруктураДанных.Вставить("ВидУпаковки");
	СтруктураДанных.Вставить("Ошибка","");
	//СтруктураДанных.Вставить("ТребуетсяЗапросВИСМП");
	Возврат СтруктураДанных;
КонецФункции

Функция МОТП_ЗапроситьДанныеПоМаркам(Док1СРезультат, НеизвестныеУпаковки, СоответствияШКСтруктуреДанных, ПараметрыПроцедуры, ДанныеПроверкиИПодбора)
				
	ИмяСобытия = "МОТП_ЗапроситьДанныеПоМаркам";
	
	ДетализацияСтруктурыХранения = ПараметрыПроцедуры.ДетализацияСтруктурыХранения; // По умолчанию Полная
	
	// Если существуют сохраненные данные проверки и подбора, детализацию не меняем
	Если НЕ ДанныеПроверкиИПодбора = Неопределено
		И ДанныеПроверкиИПодбора.Свойство("ДетализацияСтруктурыХранения") И ЗначениеЗаполнено(ДанныеПроверкиИПодбора.ДетализацияСтруктурыХранения) Тогда
		ДетализацияСтруктурыХранения = ДанныеПроверкиИПодбора.ДетализацияСтруктурыХранения;
	Иначе
		СохраненнаяДетализацияСтруктурыХранения = СохраненнаяДетализацияСтруктурыХранения(ПараметрыПроцедуры.РежимПодбораСуществующихУпаковок);	
		
		Если ЗначениеЗаполнено(СохраненнаяДетализацияСтруктурыХранения) Тогда
			Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.МаркировкаТоваровИСМП")
				И (СохраненнаяДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками")
					ИЛИ СохраненнаяДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПалетыСМонотоварнымиКоробами")) Тогда
				ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
			Иначе
				ДетализацияСтруктурыХранения = СохраненнаяДетализацияСтруктурыХранения;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыПроцедуры.ПараметрыСканирования.Вставить("ДетализацияСтруктурыХранения", ДетализацияСтруктурыХранения);
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		ДанныеПроверкиИПодбора = Новый Структура();
		ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции",          					ПустоеДеревоТабачнойПродукцииИСМП());
		ДанныеПроверкиИПодбора.Вставить("ПодобраннаяМаркируемаяПродукция",      					ПустаяТаблицаПодобраннаяТабачнаяПродукцияИСМП());
		ДанныеПроверкиИПодбора.Вставить("ДоступныеДляПроверкиУпаковки",          					Новый СписокЗначений());
		ДанныеПроверкиИПодбора.Вставить("УпаковкиДокумента",                     					Новый СписокЗначений());
		ДанныеПроверкиИПодбора.Вставить("ШтрихкодыУпаковок",                    					Новый СписокЗначений());
		ДанныеПроверкиИПодбора.Вставить("НачальныйСтатусПроверки",               					ПараметрыПроцедуры.НачальныйСтатусПроверки);
		ДанныеПроверкиИПодбора.Вставить("ДетализацияСтруктурыХранения",          					ДетализацияСтруктурыХранения);
		ДанныеПроверкиИПодбора.Вставить("РежимПодбораСуществующихУпаковок",      					ПараметрыПроцедуры.РежимПодбораСуществующихУпаковок);
		ДанныеПроверкиИПодбора.Вставить("ПроверкаЭлектронногоДокумента",         					ПараметрыПроцедуры.ПроверкаЭлектронногоДокумента);
		ДанныеПроверкиИПодбора.Вставить("ПараметрыПроверкиКодовМаркировки",      					ПараметрыПроцедуры.ПараметрыПроверкиКодовМаркировки);
		ДанныеПроверкиИПодбора.Вставить("КоличествоНедопустимыхКодовМаркировки", 					0);
		ДанныеПроверкиИПодбора.Вставить("КонтролироватьСканируемуюПродукциюПоДокументуОснованию", 	ПараметрыПроцедуры.КонтролироватьСканируемуюПродукциюПоДокументуОснованию);
		ДанныеПроверкиИПодбора.Вставить("ВозможностьЗагрузкиДанныхБезПодключенияМОТП", 			  	ПараметрыПроцедуры.ПараметрыПроверкиКодовМаркировки.ВозможностьЗагрузкиДанныхБезПодключенияМОТП);
		ДанныеПроверкиИПодбора.Вставить("УточнениеКоэффициентовУпаковок",        					Неопределено);
		ДанныеПроверкиИПодбора.Вставить("ДополнительноеДействиеЗагрузки",        					Неопределено);
		
		//ДанныеПроверкиИПодбора.Вставить("СохраненнаяДетализацияСтруктурыХранения", СохраненнаяДетализацияСтруктурыХранения);
		//ДанныеПроверкиИПодбора.Вставить("СодержимоеУпаковокНедоступно", Ложь);
		//ДанныеПроверкиИПодбора.Вставить("СтрокаПачкиБезБлока",          Неопределено);
		//ДанныеПроверкиИПодбора.Вставить("СтрокаБлокиБезКоробки",        Неопределено);
		//ДанныеПроверкиИПодбора.Вставить("Организация",                  ПараметрыПроцедуры.ПараметрыСканирования.Организация);
