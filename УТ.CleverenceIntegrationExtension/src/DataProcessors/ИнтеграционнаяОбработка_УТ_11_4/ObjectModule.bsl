	УТ_11_2_Общий_ПослеЗаполненияСтрокиТЧ(СтруктураПараметров);
	
	ТекущаяСтрока 						= СтруктураПараметров.СтрокаДокумента;
	СтрокаТабличнойЧастиДокументаТСД 	= СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	
	// Заполнение реквизитов ВЕТИС
	Если ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторПроисхожденияВЕТИС) И НЕ СтрокаТабличнойЧастиДокументаТСД.Свойство("ИдентификаторПроисхожденияВЕТИС") Тогда
		СтрокаТабличнойЧастиДокументаТСД.Вставить("ИдентификаторПроисхожденияВЕТИС", ТекущаяСтрока.ИдентификаторПроисхожденияВЕТИС);
		СтрокаТабличнойЧастиДокументаТСД.Вставить("Скоропортящаяся", 				 ТекущаяСтрока.ИдентификаторПроисхожденияВЕТИС.СкоропортящаясяПродукция);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности) И НЕ СтрокаТабличнойЧастиДокументаТСД.Свойство("ГоденДо") Тогда
		СтрокаТабличнойЧастиДокументаТСД.Вставить("ГоденДо", 					 	 ТекущаяСтрока.СрокГодности)
