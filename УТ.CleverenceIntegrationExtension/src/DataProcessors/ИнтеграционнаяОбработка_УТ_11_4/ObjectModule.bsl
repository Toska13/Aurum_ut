Функция Конф_ПолучитьФункциональныеПараметры1С() Экспорт
	
	ИмяСобытия = "Конф_ПолучитьФункциональныеПараметры1С";
	
	ФункциональныеПараметры = Новый Структура;
		
	СписокДействий = Новый Массив;
	СписокДействий.Добавить(
		Новый Структура("СтрокаВызова, ДополнительныйПараметр", 
			"ПолучитьЗначениеФункциональногоПараметраРаботаСУпаковочнымиЛистами()", 
			Новый Структура("ФункциональныйПараметр, ЗначениеПоУмолчанию", "РаботаСУпаковочнымиЛистами", Ложь)
		)
	);
	СписокДействий.Добавить(
		Новый Структура("СтрокаВызова, ДополнительныйПараметр", 
			"ПолучитьЗначениеФункциональногоПараметраЗапросИнформацииПоКМ()", 
			Новый Структура("ФункциональныйПараметр, ЗначениеПоУмолчанию", "ЗапросИнформацииПоКМ", Ложь)
		)
	);
	СписокДействий.Добавить(
		Новый Структура("СтрокаВызова, ДополнительныйПараметр", 
			"ПолучитьЗначениеФункциональногоПараметраРедактированиеЯчеекСпрСклад()", 
			Новый Структура("ФункциональныйПараметр, ЗначениеПоУмолчанию", "РедактированиеЯчеекСпрСклад", Ложь)
		)
	);
	СписокДействий.Добавить(
		Новый Структура("СтрокаВызова, ДополнительныйПараметр", 
			"ПолучитьЗначениеФункциональногоПараметраПолучениеСодержимогоТУПрямымиВызовами()", 
			Новый Структура("ФункциональныйПараметр, ЗначениеПоУмолчанию", "ПолучениеСодержимогоТУПрямымиВызовами", Ложь)
		)
	);
	
	РезультатОбработчиков = ВыполнитьКаждыйОбработчикИзСписка(СписокДействий, ИмяСобытия);
	
	Для каждого Результат Из РезультатОбработчиков Цикл
		ФункциональныеПараметры.Вставить(Результат.ДополнительныйПараметр.ФункциональныйПараметр, ?(Результат.Успешно, Результат.Результат, Результат.ДополнительныйПараметр.ЗначениеПоУмолчанию));
	КонецЦикла;
	
	Возврат ФункциональныеПараметры;
	
КонецФункции

