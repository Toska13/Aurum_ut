// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукцияОбъект, ВидМаркируемойПродукции, СоответствиеПараметров)
	
	ТипЧисло  = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Коллекция = Новый Массив;
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ВключаетМРЦ",                                           ТипБулево, "ЗаполнениеКолонкиВключаетМРЦ");
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "НоменклатураСопоставленаПоУПД",                         ТипБулево);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковок",                     ТипЧисло,  "ЗаполнениеКолонкиКоличествоПотребительскихУпаковок");
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковокВСтруктуреУпаковок",   ТипЧисло);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ПроизвольнаяЕдиницаУчета",                              ТипБулево);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "ТребуетВзвешивания",                                    ТипБулево);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПотребительскихУпаковокТребующихВзвешивания", ТипЧисло);
	МОТП_ДополнитьОписаниеКолонок(Коллекция, "КоличествоПодобраноВзвешено",                           ТипЧисло);
	
	Для Каждого Элемент Из Коллекция Цикл
		
		Если ПодобраннаяМаркируемаяПродукцияОбъект.Колонки.Найти(Элемент.ИмяКолонки) = Неопределено Тогда
			ПодобраннаяМаркируемаяПродукцияОбъект.Колонки.Добавить(Элемент.ИмяКолонки, Элемент.Тип);
			МОТП_ВыполнитьДействиеПриВосстановленииКоллекции(ПодобраннаяМаркируемаяПродукцияОбъект, Элемент.Действие, ВидМаркируемойПродукции, СоответствиеПараметров);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиВидУпаковкиПриВосстановленииДерева(КоллекцияСтрок)
	
	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл
		
		Если СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПродукцияБезУпаковки") Тогда
			Продолжить;
		КонецЕсли;
		
		//Если Вычислить("ИнтеграцияИСКлиентСервер.ЭтоУпаковка(СтрокаДерева.ТипУпаковки)") Тогда
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
			Если СтрокаДерева.ГрупповаяТоварнаяУпаковка Тогда
				СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая");
			Иначе
				СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая");
			КонецЕсли;
		Иначе
			СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская");
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			МОТП_ЗаполнениеКолонкиВидУпаковкиПриВосстановленииДерева(СтрокаДерева.Строки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(КоллекцияСтрок, ВидМаркируемойПродукции)
	
	ИмяСобытия = "МОТП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева";
	
	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл
		
		ШтрихкодНормализован = Истина;
		Попытка
			СтрокаДерева.НормализованныйШтрихкод = ИО_ОбщийМодуль("ШтрихкодированиеМОТП").НормализованныйШтрихкод(СтрокаДерева.Штрихкод, ВидМаркируемойПродукции);
		Исключение
			ШтрихкодНормализован = Ложь;	
		КонецПопытки;
		
		Если НЕ ШтрихкодНормализован Тогда
			Попытка
				СтрокаДерева.НормализованныйШтрихкод = ИО_ОбщийМодуль("ШтрихкодированиеМОТП").НормализованныйШтрихкод(СтрокаДерева.Штрихкод);
			Исключение
				СтрокаДерева.НормализованныйШтрихкод = СтрокаДерева.Штрихкод;
				
				Если ЗначениеЗаполнено(СтрокаДерева.Штрихкод) Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Не удалось нормализовать штрихкод: " + СтрокаДерева.Штрихкод);
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			МОТП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(СтрокаДерева.Строки, ВидМаркируемойПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиВключаетМРЦПриВосстановленииДерева(КоллекцияСтрок, СтрокиДереваСНулевымМРЦ, ВидМаркируемойПродукции)
	
	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл
		
		Если СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПродукцияБезУпаковки") Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская")
			Или СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") Тогда
			
			Если СтрокаДерева.МРЦ = 0 И МОТП_КодМаркировкиВСтрокеДереваВключаетМРЦ(СтрокаДерева, ВидМаркируемойПродукции) Тогда
				СтрокаДерева.ВключаетМРЦ = Истина;
				СтрокиДереваСНулевымМРЦ.Добавить(СтрокаДерева);
			Иначе
				СтрокаДерева.ВключаетМРЦ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			МОТП_ЗаполнениеКолонкиВключаетМРЦПриВосстановленииДерева(СтрокаДерева.Строки, СтрокиДереваСНулевымМРЦ, ВидМаркируемойПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Функция МОТП_КодМаркировкиВСтрокеДереваВключаетМРЦ(СтрокаДерева, ВидМаркируемойПродукции)
	
	Если СтрокаДерева.МРЦ > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская")
		Или СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") Тогда
		
		ДанныеРазбора = ИО_РазобратьКодМаркировки(СтрокаДерева.Штрихкод, ВидМаркируемойПродукции);
		
		Если ДанныеРазбора = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Возврат ДанныеРазбора.СоставКодаМаркировки.ВключаетМРЦ;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Скопировано Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор
Процедура МОТП_ЗаполнениеКолонкиВключаетМРЦПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукцияОбъект)
	
