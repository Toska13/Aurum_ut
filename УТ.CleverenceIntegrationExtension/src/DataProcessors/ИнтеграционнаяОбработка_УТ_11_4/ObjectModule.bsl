Функция ВерсииОбъектовКонфигурации()
	
	ВерсииОбъектов = Новый Структура();
	ВерсииОбъектов.Вставить("ПолеШтрихкода", ВерсииОбъектовКонфигурации_ПолеШтрихкода());
	
	Возврат ВерсииОбъектов;
	
КонецФункции

Функция ВерсииОбъектовКонфигурации_ПолеШтрихкода()
	
	// Получим структуру данных по последней проведенной ТТН Входящая ЕГАИС, 
	
	ПолеШтрихкода = "Штрихкод";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТТНВходящаяЕГАИС.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ТТНВходящаяЕГАИС КАК ТТНВходящаяЕГАИС
		|ГДЕ
		|	ТТНВходящаяЕГАИС.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТТНВходящаяЕГАИС.Дата УБЫВ";
	
	Попытка
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			ВыборкаДетальныеЗаписи.Следующий();
			
			ДокСсылка = ВыборкаДетальныеЗаписи.Ссылка;
			
			//СтруктураДерева = Вычислить("Документы.ТТНВходящаяЕГАИС.ВходящееДеревоУпаковок(ДокСсылка)");
			СтруктураДерева = Документы["ТТНВходящаяЕГАИС"].ВходящееДеревоУпаковок(ДокСсылка);
			
			Если СтруктураДерева.ДеревоУпаковок.Колонки.Найти("Штрихкод") = Неопределено Тогда
				ПолеШтрихкода = "ЗначениеШтрихкода";	
			КонецЕсли;
			
		КонецЕсли;
	
	Исключение
		
	КонецПопытки;
	
	Возврат ПолеШтрихкода;
	
КонецФункции

Процедура ТТН_ЕГАИС_ДополнитьДерево(ВозвращаемоеДерево)
	
	Если ВозвращаемоеДерево.Колонки.Найти("КоличествоАкцизныхМарок") = Неопределено Тогда
		ВозвращаемоеДерево.Колонки.Добавить("КоличествоАкцизныхМарок");
	КонецЕсли;
	
	Если ВозвращаемоеДерево.Колонки.Найти("ШтрихкодУпаковки") = Неопределено Тогда
		ВозвращаемоеДерево.Колонки.Добавить("ШтрихкодУпаковки");
	КонецЕсли; 	

КонецПроцедуры

Функция ЕГАИС_СформироватьПараметрАкцизныеМарки(ДокументДляВыгрузки, СтруктураПараметров = Неопределено) Экспорт
	
	КоробкиДеревоЗначений = Документы["ТТНВходящаяЕГАИС"].ВходящееДеревоУпаковок(ДокументДляВыгрузки).ДеревоУпаковок;

	АкцизныеМарки = Новый ТаблицаЗначений;
	АкцизныеМарки.Колонки.Добавить("Справка2", 			Новый ОписаниеТипов("СправочникСсылка.Справки2ЕГАИС"));
	АкцизныеМарки.Колонки.Добавить("ЗначениеШтрихкода", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)));
	АкцизныеМарки.Колонки.Добавить("Коробка", 			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)));
	АкцизныеМарки.Колонки.Добавить("Паллета", 			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)));
	АкцизныеМарки.Колонки.Добавить("Количество", 		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	
	ИмяПоляШтрихкод = ?(КоробкиДеревоЗначений.Колонки.Найти("Штрихкод") <> Неопределено, "Штрихкод", "ЗначениеШтрихкода");
	
	УровеньДетализации = 3;
	Если НЕ СтруктураПараметров = Неопределено Тогда
		ВыгружаемыйУровеньДетализации = ИО_ЗначениеГлобальногоПараметраПоID("NDSf530dda2d3da4a218be1ffa14fe0b754", СтруктураПараметров);
		Если ВыгружаемыйУровеньДетализации = "Палеты" Тогда
			УровеньДетализации = 1;
		ИначеЕсли ВыгружаемыйУровеньДетализации = "Коробки" Тогда
			УровеньДетализации = 2;
		КонецЕсли;
	КонецЕсли;
	
	ЕГАИС_ПолучитьАкцизныеМаркиИзДереваУпаковок(КоробкиДеревоЗначений, АкцизныеМарки, ИмяПоляШтрихкод, УровеньДетализации);
		
	Если УровеньДетализации < 3 Тогда
		АкцизныеМарки.Свернуть("Справка2, ЗначениеШтрихкода, Коробка, Паллета", "Количество");
	КонецЕсли;
	
	Возврат АкцизныеМарки;	
	
КонецФункции

Функция ЕГАИС_ТаблицаИзмененийАлкогольнойПродукции()

	// см. реквизит формы Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
	
	ТаблицаИзмененийАлкогольнойПродукции = Новый ТаблицаЗначений();
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("Номенклатура",			Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("Характеристика",			Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("Серия",					Метаданные.ОпределяемыеТипы.СерияНоменклатуры.Тип);
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("АлкогольнаяПродукция",	Новый ОписаниеТипов("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));	
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("Справка2",				Новый ОписаниеТипов("СправочникСсылка.Справки2ЕГАИС"));	
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("Изменение",				Новый ОписаниеТипов("Число"));
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("ТипУпаковки",			Новый ОписаниеТипов("ПеречислениеСсылка.ТипыУпаковок"));
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("Штрихкод",				Новый ОписаниеТипов("Строка"));
	ТаблицаИзмененийАлкогольнойПродукции.Колонки.Добавить("СтатусПроверки",			Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыПроверкиНаличияПродукцииИС"));
	
	Возврат ТаблицаИзмененийАлкогольнойПродукции;
	
КонецФункции

Процедура ЕГАИС_ПолучитьАкцизныеМаркиИзДереваУпаковок(ДеревоМаркированнойПродукции, АкцизныеМарки, ИмяПоляШтрихкод, УровеньДетализации = 3)

	Для каждого СтрокаДерева ИЗ ДеревоМаркированнойПродукции.Строки Цикл
		
		ДобавитьСтрокуВДерево = Ложь;
		
		Попытка
			ПрочаяЗонаПересчетаАлкогольнойПродукции = СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаАлкогольнойПродукции.БутылкиБезКоробки");
		Исключение
			ПрочаяЗонаПересчетаАлкогольнойПродукции = Ложь;
		КонецПопытки;
		
		ЭтоБутылка = СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
		ЭтоКоробка = Ложь;
		ЭтоПаллета = Ложь;
		
		Если ПрочаяЗонаПересчетаАлкогольнойПродукции Тогда
			//
		ИначеЕсли НЕ СтрокаДерева.Строки.Количество() Тогда
			ДобавитьСтрокуВДерево = Истина;

			ЭтоКоробка = НЕ ЭтоБутылка;
		ИначеЕсли УровеньДетализации < 3 Тогда
			// Логистические упаковки можем различить только по уровню вложенности:
			// 	если в логистическую упаковку вложена другая логистическая упаковка, считаем ее паллетой, иначе - коробкой
			Если ЭтоБутылка Тогда
				ТекущийУровеньДетализации = 3;
			ИначеЕсли СтрокаДерева.Строки.Найти(ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"), "ТипУпаковки") = Неопределено
				И СтрокаДерева.Строки.Найти(ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка"), "ТипУпаковки") = Неопределено Тогда
				ЭтоКоробка = Истина;
				ТекущийУровеньДетализации = 2;
			Иначе
				ЭтоПаллета = Истина;
				ТекущийУровеньДетализации = 1;
			КонецЕсли;
				
			Если ТекущийУровеньДетализации >= УровеньДетализации Тогда
				ДобавитьСтрокуВДерево = Истина;
			КонецЕсли;
		КонецЕсли;
			
		Если ДобавитьСтрокуВДерево Тогда
			НоваяСтрока = АкцизныеМарки.Добавить();
			НоваяСтрока.Справка2 	= СтрокаДерева["Справка2"];
			НоваяСтрока.Количество  = 1;
				
			Если ЭтоБутылка Тогда
               	НоваяСтрока.ЗначениеШтрихкода = СтрокаДерева[ИмяПоляШтрихкод];
					
				СтрокаКоробки = СтрокаДерева.Родитель;
				Если НЕ СтрокаКоробки = Неопределено Тогда
					НоваяСтрока.Коробка = СтрокаКоробки[ИмяПоляШтрихкод];
					
		           	СтрокаПаллеты = СтрокаКоробки.Родитель;
					Если НЕ СтрокаПаллеты = Неопределено Тогда
						НоваяСтрока.Паллета = СтрокаПаллеты[ИмяПоляШтрихкод];
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ЭтоКоробка Тогда
				НоваяСтрока.Коробка = СтрокаДерева[ИмяПоляШтрихкод];
					
		    	СтрокаПаллеты = СтрокаДерева.Родитель;
				Если НЕ СтрокаПаллеты = Неопределено Тогда
					НоваяСтрока.Паллета = СтрокаПаллеты[ИмяПоляШтрихкод];
				КонецЕсли;
			Иначе
				НоваяСтрока.Паллета = СтрокаДерева[ИмяПоляШтрихкод];
			КонецЕсли;

			
			Если ЭтоКоробка ИЛИ ЭтоПаллета Тогда
				ТаблицаСправок2 = Новый ТаблицаЗначений;
				ТаблицаСправок2.Колонки.Добавить("Справка2", 	Новый ОписаниеТипов("СправочникСсылка.Справки2ЕГАИС"));
				ТаблицаСправок2.Колонки.Добавить("Количество", 	Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
				
				ЕГАИС_ЗаполнитьСправки2ИзПодчиненныхСтрок(СтрокаДерева, ТаблицаСправок2);
				
				ПерваяСтрока = Истина;
				Для каждого СтрокаСправка2 ИЗ ТаблицаСправок2 Цикл
					Если ПерваяСтрока Тогда
						НоваяСтрока.Справка2   = СтрокаСправка2.Справка2;
						НоваяСтрока.Количество = СтрокаСправка2.Количество;
						
						ПерваяСтрока = Ложь;
					Иначе
						СкопированнаяСтрока = АкцизныеМарки.Добавить();
						ЗаполнитьЗначенияСвойств(СкопированнаяСтрока, НоваяСтрока);
						СкопированнаяСтрока.Справка2   = СтрокаСправка2.Справка2;
						СкопированнаяСтрока.Количество = СтрокаСправка2.Количество;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Иначе
			ЕГАИС_ПолучитьАкцизныеМаркиИзДереваУпаковок(СтрокаДерева, АкцизныеМарки, ИмяПоляШтрихкод, УровеньДетализации);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЕГАИС_ЗаполнитьСправки2ИзПодчиненныхСтрок(ДеревоМаркированнойПродукции, ТаблицаСправок2)

	Для каждого СтрокаДерева ИЗ ДеревоМаркированнойПродукции.Строки Цикл
		
		Если СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
			НайденнаяСтрока = ТаблицаСправок2.Найти(СтрокаДерева.Справка2, "Справка2");
			Если НайденнаяСтрока = Неопределено Тогда
				НоваяСтрока = ТаблицаСправок2.Добавить();
				НоваяСтрока.Справка2 	= СтрокаДерева.Справка2;
				НоваяСтрока.Количество 	= 1;
			Иначе
				НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + 1;
			КонецЕсли;
		Иначе
			ЕГАИС_ЗаполнитьСправки2ИзПодчиненныхСтрок(СтрокаДерева, ТаблицаСправок2);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_ОпределитьСправки2ПриСозданииДереваУпаковок(СтрокиДерева, АлкогольнаяПродукцияКОпределениюСправок2)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ЕГАИС_ОпределениеСправок2ПриДобавленииСтроки(СтрокаДерева, АлкогольнаяПродукцияКОпределениюСправок2);
		
		ПодчиненныеСтроки = СтрокаДерева.Строки;
		
		Если ПодчиненныеСтроки.Количество() > 0 Тогда
			ЕГАИС_ОпределитьСправки2ПриСозданииДереваУпаковок(ПодчиненныеСтроки, АлкогольнаяПродукцияКОпределениюСправок2);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_ДобавитьСтрокуВТаблицуИзменений(ТаблицаИзмененийАлкогольнойПродукции, СтрокаДерева, Изменение)
	
	НоваяСтрока = ТаблицаИзмененийАлкогольнойПродукции.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
	НоваяСтрока.Изменение = Изменение;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_ОбработатьТаблицуИзмененияАлкогольнойПродукции(ТаблицаИзмененийАлкогольнойПродукции, АлкогольнаяПродукцияКОпределениюСправок2)

	Для Каждого СтрокаТаблицы Из ТаблицаИзмененийАлкогольнойПродукции Цикл
		
		Если СтрокаТаблицы.Изменение = 1 Тогда
			
			ЕГАИС_ОпределениеСправок2ПриДобавленииСтроки(СтрокаТаблицы, АлкогольнаяПродукцияКОпределениюСправок2);
			
		ИначеЕсли СтрокаТаблицы.Изменение = - 1 Тогда
			
			ЕГАИС_ОпределениеСправок2ПриУдаленииСтроки(СтрокаТаблицы, АлкогольнаяПродукцияКОпределениюСправок2);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаИзмененийАлкогольнойПродукции.Очистить();
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_ОпределениеСправок2ПриДобавленииСтроки(СтрокаДерева, АлкогольнаяПродукцияКОпределениюСправок2)
	
	Если СтрокаДерева.ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаАлкогольнойПродукцииНайдена           = Ложь;
	НайденнаяСтрокаСПустойАлкогольнойПродукцией = Неопределено;
	
	Для Каждого СтрокаАлкогольнойПродукции Из АлкогольнаяПродукцияКОпределениюСправок2.Строки Цикл
		
		Если СтрокаДерева.Номенклатура = СтрокаАлкогольнойПродукции.Номенклатура
			И СтрокаДерева.Характеристика = СтрокаАлкогольнойПродукции.Характеристика
			И СтрокаДерева.АлкогольнаяПродукция = СтрокаАлкогольнойПродукции.АлкогольнаяПродукция
			И (СтрокаДерева.Серия = СтрокаАлкогольнойПродукции.Серия
			   Или (Не ЗначениеЗаполнено(СтрокаДерева.Серия)
			        И Не ЗначениеЗаполнено(СтрокаАлкогольнойПродукции.Серия))) Тогда
			
			СтрокаАлкогольнойПродукцииНайдена = Истина;
			
			ЕГАИС_ДобавитьКоличествоОпределеннойСправки2(СтрокаАлкогольнойПродукции, СтрокаДерева);
			
			Прервать;
			
		ИначеЕсли СтрокаДерева.Номенклатура = СтрокаАлкогольнойПродукции.Номенклатура
			И СтрокаДерева.Характеристика = СтрокаАлкогольнойПродукции.Характеристика
			И (СтрокаДерева.Серия = СтрокаАлкогольнойПродукции.Серия
			   Или (Не ЗначениеЗаполнено(СтрокаДерева.Серия)
			        И Не ЗначениеЗаполнено(СтрокаАлкогольнойПродукции.Серия)))
			И Не ЗначениеЗаполнено(СтрокаАлкогольнойПродукции.АлкогольнаяПродукция) Тогда
			
			НайденнаяСтрокаСПустойАлкогольнойПродукцией = СтрокаАлкогольнойПродукции;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не СтрокаАлкогольнойПродукцииНайдена
		И НайденнаяСтрокаСПустойАлкогольнойПродукцией <> Неопределено Тогда
		
		СтрокаАлкогольнойПродукцииНайдена = Истина;
		
		ЕГАИС_ДобавитьКоличествоОпределеннойСправки2(НайденнаяСтрокаСПустойАлкогольнойПродукцией, СтрокаДерева);
		
	КонецЕсли;
	
	Если Не СтрокаАлкогольнойПродукцииНайдена Тогда
		
		КонтролироватьСканируемуюПродукциюПоДокументуОснованию = Ложь;
		
		Если Не КонтролироватьСканируемуюПродукциюПоДокументуОснованию Тогда
		
			НоваяСтрока = АлкогольнаяПродукцияКОпределениюСправок2.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
			НоваяСтрока.Справка2               = ПредопределенноеЗначение("Справочник.Справки2ЕГАИС.ПустаяСсылка");
			НоваяСтрока.КоличествоРаспределено = 1;
			НоваяСтрока.Маркируемая            = Истина;
			
			СтрокаРаспределения = НоваяСтрока.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СтрокаДерева);
			СтрокаРаспределения.КоличествоРаспределено = 1;
			
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").УстановитьИндексКартинкиСостояниеПодбораАкцизныхМарок(НоваяСтрока);
			
		Иначе
			
			ОшибкаКонтроля = Истина;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_ДобавитьКоличествоОпределеннойСправки2(СтрокаАлкогольнойПродукции, СтрокаДерева)

	СтрокаАлкогольнойПродукции.КоличествоРаспределено = СтрокаАлкогольнойПродукции.КоличествоРаспределено + 1;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").УстановитьИндексКартинкиСостояниеПодбораАкцизныхМарок(СтрокаАлкогольнойПродукции);
	
	СтрокаРаспределенияСправка2Найдена = Ложь;
	
	Для Каждого СтрокаРаспределения Из СтрокаАлкогольнойПродукции.Строки Цикл
		
		Если СтрокаРаспределения.Справка2 = СтрокаДерева.Справка2
			Или (Не ЗначениеЗаполнено(СтрокаРаспределения.Справка2) 
			И Не ЗначениеЗаполнено(СтрокаДерева.Справка2)) Тогда
			
			СтрокаРаспределенияСправка2Найдена = Истина;
			СтрокаРаспределения.КоличествоРаспределено = СтрокаРаспределения.КоличествоРаспределено + 1;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не СтрокаРаспределенияСправка2Найдена Тогда
		
		СтрокаРаспределения = СтрокаАлкогольнойПродукции.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СтрокаДерева);
		СтрокаРаспределения.Количество             = 0;
		СтрокаРаспределения.КоличествоРаспределено = СтрокаРаспределения.КоличествоРаспределено + 1;
		СтрокаРаспределения.Маркируемая            = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_ОпределениеСправок2ПриУдаленииСтроки(СтрокаДерева, АлкогольнаяПродукцияКОпределениюСправок2)
	
	Если СтрокаДерева.ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		Возврат;
	КонецЕсли;
	
	НайденнаяСтрокаСПустойАлкогольнойПродукцией = Неопределено;
	
	Для Каждого СтрокаАлкогольнойПродукции Из АлкогольнаяПродукцияКОпределениюСправок2.Строки Цикл
		
		Если СтрокаДерева.Номенклатура = СтрокаАлкогольнойПродукции.Номенклатура
			И СтрокаДерева.Характеристика = СтрокаАлкогольнойПродукции.Характеристика
			И СтрокаДерева.АлкогольнаяПродукция = СтрокаАлкогольнойПродукции.АлкогольнаяПродукция
			И СтрокаДерева.Серия = СтрокаАлкогольнойПродукции.Серия Тогда
			
			ЕГАИС_УменьшитьКоличествоОпределеннойСправки2(СтрокаАлкогольнойПродукции,
				СтрокаДерева, АлкогольнаяПродукцияКОпределениюСправок2);
			
			Возврат;
			
		ИначеЕсли СтрокаДерева.Номенклатура = СтрокаАлкогольнойПродукции.Номенклатура
			И СтрокаДерева.Характеристика = СтрокаАлкогольнойПродукции.Характеристика
			И СтрокаДерева.Серия = СтрокаАлкогольнойПродукции.Серия
			И Не ЗначениеЗаполнено(СтрокаАлкогольнойПродукции.АлкогольнаяПродукция) Тогда
			
			НайденнаяСтрокаСПустойАлкогольнойПродукцией = СтрокаАлкогольнойПродукции;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НайденнаяСтрокаСПустойАлкогольнойПродукцией <> Неопределено Тогда
		
		ЕГАИС_УменьшитьКоличествоОпределеннойСправки2(НайденнаяСтрокаСПустойАлкогольнойПродукцией,
			СтрокаДерева, АлкогольнаяПродукцияКОпределениюСправок2);
		
	КонецЕсли;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор
Процедура ЕГАИС_УменьшитьКоличествоОпределеннойСправки2(СтрокаАлкогольнойПродукции, СтрокаДерева, АлкогольнаяПродукцияКОпределениюСправок2)

	СтрокаАлкогольнойПродукции.КоличествоРаспределено = СтрокаАлкогольнойПродукции.КоличествоРаспределено - 1;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").УстановитьИндексКартинкиСостояниеПодбораАкцизныхМарок(СтрокаАлкогольнойПродукции);
		
	Для Каждого СтрокаРаспределения Из СтрокаАлкогольнойПродукции.Строки Цикл
		
		Если СтрокаРаспределения.Справка2 = СтрокаДерева.Справка2 Тогда
			
			СтрокаРаспределения.КоличествоРаспределено = СтрокаРаспределения.КоличествоРаспределено - 1;
			
			Если СтрокаРаспределения.КоличествоРаспределено = 0 Тогда
				
				СтрокаАлкогольнойПродукции.Строки.Удалить(СтрокаРаспределения);
				
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокаАлкогольнойПродукции.КоличествоРаспределено = 0
		И СтрокаАлкогольнойПродукции.Количество = 0 Тогда
		
		АлкогольнаяПродукцияКОпределениюСправок2.Строки.Удалить(СтрокаАлкогольнойПродукции);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Произвольные_Коды

// Вызывается из произвольного кода. В зависимости от параметра определяет единицу измерния из плановых значений, либо из фактически введенных
//
// Параметры:
//	СтруктураПараметров	 - Структура - содержит:
//		* ДанныеДляЗагрузки_Строка - Структура - данные для загрузки строки табличной части документа 1с
//		* СтрокаТабличнойЧастиДокументаТСД - Структура - обрабатываемая строка данных, полученных с ТСД
//		* ОбъектДокумент1С - ДокументОбъект - документ-объект, в который загружаются данные
//		* ЕдиницаИзмеренияИзПлана - Булево - необязательный параметр, признак использования единицы измерения из плановых строк, выгруженных на ТСД
//
// Возвращаемое значение:
//   - СправочникСсылка.УпаковкиЕдиницыИзмерения
Функция ПК_УпаковкаЕдиницаИзмерения(СтруктураПараметров) Экспорт
	
	ДанныеДляЗагрузки_Строка = СтруктураПараметров.ДанныеДляЗагрузки_Строка;
	СтрокаТабличнойЧастиДокументаТСД = СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	ОбъектДокумент1С = СтруктураПараметров.ОбъектДокумент1С;
	
	ЕдиницаИзмеренияИзПлана = Ложь;
	Если СтруктураПараметров.Свойство("ЕдиницаИзмеренияИзПлана") и СтруктураПараметров.ЕдиницаИзмеренияИзПлана Тогда
		ЕдиницаИзмеренияИзПлана = СтруктураПараметров.ЕдиницаИзмеренияИзПлана;
	КонецЕсли;
	
	АдресноеХранение = Ложь;	
	МетаданныеДокумента = ОбъектДокумент1С.Метаданные().Реквизиты;
	Если МетаданныеДокумента.Найти("Склад") <> Неопределено И МетаданныеДокумента.Найти("Помещение") <> Неопределено Тогда		
		//АдресноеХранение = Вычислить("СкладыСервер.ИспользоватьАдресноеХранение(ОбъектДокумент1С.Склад, ОбъектДокумент1С.Помещение)");
		АдресноеХранение = ИО_ОбщийМодуль("СкладыСервер").ИспользоватьАдресноеХранение(ОбъектДокумент1С.Склад, ОбъектДокумент1С.Помещение);
	КонецЕсли;

	Номенклатура = ДанныеДляЗагрузки_Строка.Номенклатура;
	ШК = ШтрихкодТСД(СтрокаТабличнойЧастиДокументаТСД);
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		БазоваяУпаковкаСТСД = Номенклатура.ЕдиницаИзмерения;
	КонецЕсли;

	УпаковкаПолучена = Ложь;
	Попытка
		Если ЗначениеЗаполнено(СтрокаТабличнойЧастиДокументаТСД.ИдЕдиницыИзмерения) Тогда
			Если ЕдиницаИзмеренияИзПлана Тогда
				УпаковкаСТСД = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТабличнойЧастиДокументаТСД.СвязаннаяСтрока.ИдЕдиницыИзмерения));
			Иначе
				УпаковкаСТСД = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТабличнойЧастиДокументаТСД.ИдЕдиницыИзмерения));				
			КонецЕсли;                        			
			УпаковкаПолучена = Истина;
		КонецЕсли;
	Исключение	
	КонецПопытки;

	НайденнаяЕИ = Неопределено;
	Если УпаковкаПолучена И Номенклатура.ИспользоватьУпаковки Тогда		
		Если Не УпаковкаСТСД = БазоваяУпаковкаСТСД Тогда
			Если Не(ТипЗнч(ОбъектДокумент1С) = Тип("ДокументОбъект.ПересчетТоваров") И НЕ АдресноеХранение) Тогда
				НайденнаяЕИ = УпаковкаСТСД;
			КонецЕсли;  	
		Иначе
			Если АдресноеХранение Тогда
				//НайденнаяЕИ = Вычислить("УТ_11_2_ПолучитьУпаковкуПоКоэффициентуИВладельцу(Номенклатура)");
				НайденнаяЕИ = УТ_11_2_ПолучитьУпаковкуПоКоэффициентуИВладельцу(Номенклатура);
			КонецЕсли;
		КонецЕсли; 
	Иначе
		НайденнаяЕИ = Неопределено;
	КонецЕсли;
		
	Возврат НайденнаяЕИ;

КонецФункции

#КонецОбласти

#Область Примеры_функций_для_внешних_вызовов_из_MS

// Функция возвращает первые буквы каждой строки, повторенные заданное количество раз
Функция МояФункция(Строка1, Строка2, Количество) Экспорт
	ПерваяБуква = Лев(Строка1,1);
	ВтораяБуква = Лев(Строка2,1);
	СтрокаВозврата = "";
	Для Инд = 1 По Количество Цикл
		СтрокаВозврата = СтрокаВозврата+ПерваяБуква+ВтораяБуква;
		Если Инд > 20 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокаВозврата;
КонецФункции

// Функция возвращает описание документа
// Для получения объекта MS должен быть указан тип - "Cleverence.Warehouse.DocumentDescription, Cleverence.MobileSMARTS"
// Безу указания типа вернется строка. 
Функция МояФункцияПолученияОписанияДокумента(Строка1, Строка2, Количество) Экспорт
	ИнформацияПоДокументу = Новый Структура;
	ИнформацияПоДокументу.Вставить("Id",				Строка1);
	ИнформацияПоДокументу.Вставить("Name",				Строка2);
	ИнформацияПоДокументу.Вставить("DocumentTypeName",	"ПодборЗаказа");						
	ИнформацияПоДокументу.Вставить("ТипДокумента1С",	"РеализацияТоваровУслуг");
	Возврат ИнформацияПоДокументу;
КонецФункции

// Функция возвращает таблицу значений, можно использовать при запросе RowCollection
// Для получения объекта MS должен быть указан тип - "Cleverence.Warehouse.RowCollection, Cleverence.MobileSMARTS"
// Безу указания типа вернется строка.
Функция МояФункцияПолученияКоллекцииСтрок(Строка1, Строка2, Количество) Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Значения");
	ТЗ.Колонки.Добавить("Количество");
	НС = ТЗ.Добавить();
	НС.Значения = Строка1;
	НС.Количество = Количество;
	НС = ТЗ.Добавить();
	НС.Значения = Строка2;
	НС.Количество = Количество;
	Возврат ТЗ;
КонецФункции

// Функция возвращет массив значений
Функция МояФункцияПолученияМассива(Строка1, Строка2) Экспорт
	
	МассивРезультат = Новый Массив;	
	МассивРезультат.Добавить(Строка1);	
	МассивРезультат.Добавить(Строка2);
	
	Возврат МассивРезультат;
КонецФункции

