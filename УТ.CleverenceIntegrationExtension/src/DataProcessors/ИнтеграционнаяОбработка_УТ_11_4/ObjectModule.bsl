Процедура ИнициализироватьДокумент(СтруктураПараметров) Экспорт
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;

	Если Док1СРезультат.ЭтоНовый() Тогда
		Если Док1СРезультат.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
			
			ОрганизацияПоУмолчанию = Неопределено;
			
			Если ЗначениеЗаполнено(Док1СОснование) 
				И Док1СОснование.Метаданные().Реквизиты.Найти("Организация") <> Неопределено 
				И ЗначениеЗаполнено(Док1СОснование.Организация) Тогда				
				
				ОрганизацияПоУмолчанию = Док1СОснование.Организация;
			КонецЕсли;
			
			Если ОрганизацияПоУмолчанию = Неопределено
				Тогда
				
				Если СтруктураПараметров.Свойство("ЗначенияПараметров") И ТипЗнч(СтруктураПараметров.ЗначенияПараметров) = Тип("Массив") Тогда
					ГлобальныеПараметры = СтруктураПараметров.ЗначенияПараметров;
				Иначе
					ГлобальныеПараметры = СтруктураПараметров.ТекущиеНастройкиMS.ГлобальныеПараметры;
				КонецЕсли;				

				Использование = Истина;
				Если ТипЗнч(СтруктураПараметров.ТекущиеНастройкиMS.ЗначенияПараметровУзлов) = Тип("Массив") Тогда
					ГлобальныеПараметры = СтруктураПараметров.ТекущиеНастройкиMS.ЗначенияПараметровУзлов;
					Использование = Ложь;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда 
					Для Каждого ЭлементГП Из ГлобальныеПараметры Цикл
						Если ЭлементГП.Свойство("ЭтоТаблицаЗначений") И ЭлементГП.ЭтоТаблицаЗначений Тогда Продолжить; КонецЕсли;
						Если (Использование Или ЭлементГП.Использование) 
								И ЭлементГП.Наименование = "Организация" И ТипЗнч(ЭлементГП.Значение) = Тип("СправочникСсылка.Организации") 
								И ЗначениеЗаполнено(ЭлементГП.Значение) И СсылкаСуществует(ЭлементГП.Значение) Тогда
							
							ОрганизацияПоУмолчанию = ЭлементГП.Значение;
							Прервать;
						КонецЕсли;					
					КонецЦикла;
				КонецЕсли;

			КонецЕсли;			
			
			Если ОрганизацияПоУмолчанию <> Неопределено Тогда
				Док1СРезультат.Организация = ОрганизацияПоУмолчанию;
			КонецЕсли;			
			
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УТ_11_4_ОбщиеОбработчики_ИСМП

Процедура УТ_11_4_ИСМП_ПослеЗаполненияДокумента		(СтруктураПараметров) Экспорт

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	Если Док1СРезультат.ЭтоНовый() Тогда
		ИСМП_ОпределитьВидПродукцииДокумента(СтруктураПараметров);
	КонецЕсли;
	
	ВидПродукцииИС = Док1СРезультат.ВидПродукции;
	
	Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.МаркировкаТоваровИСМП") Тогда
		Если ЗначениеЗаполнено(Док1СРезультат.ОперацияНанесения) Тогда
			ВозможнаОперацияНанесения = ИСМП_ВозможнаОперацияНанесения(ВидПродукцииИС);
			Если НЕ ВозможнаОперацияНанесения Тогда
				Док1СРезультат.ОперацияНанесения = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Обязательно выполняем последним, т.к. в случае работы с ИСМП документ будет принудительно записан
	
	// В случае ошибки при проверке маркированной продукции произойдет отмена загрузки документа
	СтруктураПараметров.Вставить("КритическаяОшибка", Истина); 
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ИО_ТекстКритическойОшибкиИСМП(ВидПродукцииИС));
	
	ВидыПродукцииИСМП = УТ_11_4_ПолучитьВидыПродукцииИСМП();
	ВидыПродукцииМОТП = УТ_11_4_ПолучитьВидыПродукцииМОТП();
	
	Если ВидыПродукцииИСМП.Найти(ВидПродукцииИС) <> Неопределено Тогда
		
		УТ_11_4_ПроверитьПродукциюИСМП(СтруктураПараметров, ВидПродукцииИС);
		
	ИначеЕсли (ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.МаркировкаТоваровИСМП")
		ИЛИ ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ВыводИзОборотаИСМП")
		ИЛИ ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.СписаниеКодовМаркировкиИСМП"))
		И ВидыПродукцииМОТП.Найти(ВидПродукцииИС) <> Неопределено Тогда
		
		ЭтоАгрегация = ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.МаркировкаТоваровИСМП")
			И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("Агрегация") <> Неопределено
			И Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.Агрегация");
		
		ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
		ИспользоватьПодключениеЧЗ = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ИспользоватьПодключениеЧЗ"), СтруктураПараметров);
		Если ИспользоватьПодключениеЧЗ = Ложь ИЛИ ЭтоАгрегация Тогда
			УТ_11_4_ПроверитьТабачнуюПродукциюИСМПБезЗапросаДанных(СтруктураПараметров, ВидПродукцииИС);
		Иначе
			УТ_11_4_ПроверитьТабачнуюПродукциюИСМПСЗапросомДанных(СтруктураПараметров, ВидПродукцииИС);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "");
	
КонецПроцедуры

Процедура УТ_11_4_ИСМП_Товары_ПослеЗаполненияСтрокиТЧ	(СтруктураПараметров) Экспорт

	Перем Кэш_ВесовыеРеквизитыНоменклатуры, ВесовыеРеквизитыНоменклатуры;
	
	СтрокаТСД 	= СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	СтрокаТЧ  	= СтруктураПараметров.СтрокаДокумента;
	ДокументТСД = СтруктураПараметров.ДокументТСД;
	
	ЕстьКоличествоПотребительскихУпаковок = Истина;
	Попытка
		КоличествоПотребительскихУпаковок = СтрокаТЧ.КоличествоПотребительскихУпаковок;
	Исключение
		ЕстьКоличествоПотребительскихУпаковок = Ложь;
	КонецПопытки;
	
	Если ЕстьКоличествоПотребительскихУпаковок Тогда
		ДокументТСД.ШапкаДокумента.Свойство("Кэш_ВесовыеРеквизитыНоменклатуры", Кэш_ВесовыеРеквизитыНоменклатуры);
	
		Если НЕ Кэш_ВесовыеРеквизитыНоменклатуры = Неопределено Тогда
			ВесовыеРеквизитыНоменклатуры = Кэш_ВесовыеРеквизитыНоменклатуры.Получить(СтрокаТЧ.Номенклатура);			
		Иначе
			Кэш_ВесовыеРеквизитыНоменклатуры
				= Новый Соответствие();
			ДокументТСД.ШапкаДокумента.Вставить("Кэш_ВесовыеРеквизитыНоменклатуры", Кэш_ВесовыеРеквизитыНоменклатуры);
		КонецЕсли;
		
		Если ВесовыеРеквизитыНоменклатуры = Неопределено Тогда
			Попытка
				// Временное решение
				ТаблицаТовары = Новый ТаблицаЗначений;
				ТаблицаТовары.Колонки.Добавить("НомерСтроки", 				Новый ОписаниеТипов("Число"));
				ТаблицаТовары.Колонки.Добавить("Номенклатура", 				Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
				ТаблицаТовары.Колонки.Добавить("ПроизвольнаяЕдиницаУчета", 	Новый ОписаниеТипов("Булево"));
				ТаблицаТовары.Колонки.Добавить("ТребуетВзвешивания",		Новый ОписаниеТипов("Булево"));
				
				НоваяСтрока = ТаблицаТовары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТЧ.Номенклатура;
				
				ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСлужебныеРеквизитыВКоллекции(Неопределено, ТаблицаТовары);
				
				ПроизвольнаяЕдиницаУчета = ТаблицаТовары[0].ПроизвольнаяЕдиницаУчета;
				ТребуетВзвешивания 		 = ТаблицаТовары[0].ТребуетВзвешивания;
			Исключение
				ПроизвольнаяЕдиницаУчета = Ложь;
				ТребуетВзвешивания		 = Ложь;
			КонецПопытки;
			
			СтруктураКэша = Новый Структура;
			СтруктураКэша.Вставить("ПроизвольнаяЕдиницаУчета", ПроизвольнаяЕдиницаУчета);
			СтруктураКэша.Вставить("ТребуетВзвешивания", 	   ТребуетВзвешивания);
			
			Кэш_ВесовыеРеквизитыНоменклатуры.Вставить(СтрокаТЧ.Номенклатура, СтруктураКэша);
		Иначе
			ПроизвольнаяЕдиницаУчета = ВесовыеРеквизитыНоменклатуры.ПроизвольнаяЕдиницаУчета;
			ТребуетВзвешивания		 = ВесовыеРеквизитыНоменклатуры.ТребуетВзвешивания;
		КонецЕсли;
		
		Если ПроизвольнаяЕдиницаУчета
			И НЕ ТребуетВзвешивания Тогда
			СтрокаТЧ.КоличествоПотребительскихУпаковок = СтрокаТЧ.КоличествоПотребительскихУпаковок + СтрокаТЧ.КоличествоУпаковок;
		Иначе
			СтрокаТЧ.КоличествоПотребительскихУпаковок = СтрокаТЧ.КоличествоПотребительскихУпаковок + 1;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура УТ_11_4_ИСМП_Товары_ПослеЗаполненияТЧ			(СтруктураПараметров) Экспорт
	
	Возврат; // Вернуть при возникновении необходимости пересчитывать фасованный товар в базовые единицы измерения
	
	ИмяСобытия = "УТ_11_4_ИСМП_Товары_ПослеЗаполненияТЧ";
	
	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;
	Товары 			= СтруктураПараметров.ТЧ;
	
	Если ТипЗнч(Товары) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаУпаковка = "Упаковка";
	Если НЕ ЕстьРеквизитВКоллекции(Товары.Колонки, "Упаковка") Тогда
		ИмяРеквизитаУпаковка = "ЕдиницаИзмерения";
	КонецЕсли;
	ИмяРеквизитаКоличество = "КоличествоУпаковок";
	Если НЕ ЕстьРеквизитВКоллекции(Товары.Колонки, "КоличествоУпаковок") Тогда
		ИмяРеквизитаКоличество = "Количество";
	КонецЕсли;
	ЕстьКолонкаЦена = Товары.Колонки.Найти("Цена") <> Неопределено;
	
	// Весовая продукция
	Попытка
		СлужебныеРеквизитыНоменклатуры = Товары.Скопировать(, "Номенклатура");
		СлужебныеРеквизитыНоменклатуры.Свернуть("Номенклатура");
		СлужебныеРеквизитыНоменклатуры.Колонки.Добавить("НомерСтроки", 				Новый ОписаниеТипов("Число"));
		СлужебныеРеквизитыНоменклатуры.Колонки.Добавить("ПроизвольнаяЕдиницаУчета", Новый ОписаниеТипов("Булево"));
		СлужебныеРеквизитыНоменклатуры.Колонки.Добавить("ТребуетВзвешивания",		Новый ОписаниеТипов("Булево"));
		
		НомерСтроки = 0;
		Для каждого ТекСтрока ИЗ СлужебныеРеквизитыНоменклатуры Цикл
			НомерСтроки = НомерСтроки + 1;
			ТекСтрока.НомерСтроки = НомерСтроки;
		КонецЦикла;
		
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСлужебныеРеквизитыВКоллекции(Неопределено, СлужебныеРеквизитыНоменклатуры);
		
		ИмяРеквизитаБазоваяЕИ = Конф_ПолучитьМетаданныеНСИ().Номенклатура.БазоваяЕдиницаИзмерения.ИмяРеквизита;
		
		Попытка
			ЗаданУпаковками = Перечисления["ВариантыИспользованияЕдиницыХраненияИС"].ЗаданУпаковками;
		Исключение
			ЗаданУпаковками = Перечисления["ВариантыИспользованияЕдиницыХраненияИСМП"].ЗаданУпаковками;
		КонецПопытки;
		
		ОписанияНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(Товары.ВыгрузитьКолонку("Номенклатура"));
		Для каждого ТекСтрока ИЗ Товары Цикл
			НайденнаяСтрока = СлужебныеРеквизитыНоменклатуры.Найти(ТекСтрока.Номенклатура, "Номенклатура");
			ПроизвольнаяЕдиницаУчета = НайденнаяСтрока <> Неопределено И НайденнаяСтрока.ПроизвольнаяЕдиницаУчета;
			ТребуетВзвешивания 		 = НайденнаяСтрока <> Неопределено И НайденнаяСтрока.ТребуетВзвешивания;
			
			Если ПроизвольнаяЕдиницаУчета И НЕ ТребуетВзвешивания Тогда // Фасованная весовая продукция
				ОписаниеНоменклатуры = ОписанияНоменклатуры.Получить(ТекСтрока.Номенклатура);
				Если ОписаниеНоменклатуры = Неопределено
					ИЛИ ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке = 0 Тогда
					Продолжить;
				КонецЕсли;
					
				УпаковкаСовпадаетСБазовой = НЕ ЗначениеЗаполнено(ТекСтрока[ИмяРеквизитаУпаковка])
					ИЛИ ТекСтрока[ИмяРеквизитаУпаковка] = ТекСтрока.Номенклатура[ИмяРеквизитаБазоваяЕИ];
				Если ОписаниеНоменклатуры.ВариантИспользованияЕдиницыХранения = ЗаданУпаковками
					И УпаковкаСовпадаетСБазовой Тогда		
					Продолжить;
				КонецЕсли;
				
				ЗагружаемаяУпаковка = ТекСтрока[ИмяРеквизитаУпаковка];
				Если ЗагружаемаяУпаковка = ОписаниеНоменклатуры.ПотребительскаяУпаковка Тогда
					КоэффициентЗагружаемойУпаковки = ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке;
				Иначе
					КоэффициентЗагружаемойУпаковки = ?(ЗагружаемаяУпаковка.Числитель = 0, 1, ЗагружаемаяУпаковка.Числитель) 
						/ ?(ЗагружаемаяУпаковка.Знаменатель = 0, 1, ЗагружаемаяУпаковка.Знаменатель);
				КонецЕсли;
					
				КоличествоЕдиницДоПересчета 		= ТекСтрока[ИмяРеквизитаКоличество];
				КоличествоЕдиницПослеПересчета		= КоличествоЕдиницДоПересчета * КоэффициентЗагружаемойУпаковки;
					
				ТекСтрока[ИмяРеквизитаУпаковка]		= Неопределено;
				ТекСтрока[ИмяРеквизитаКоличество] 	= КоличествоЕдиницПослеПересчета;
					
				Если ЕстьКолонкаЦена
					И НЕ УпаковкаСовпадаетСБазовой Тогда
					ТекСтрока.Цена = Окр(ТекСтрока.Цена
					   / КоличествоЕдиницПослеПересчета
					   * КоличествоЕдиницДоПересчета, 2, РежимОкругления.Окр15как20);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры
	
#КонецОбласти

#Область УТ_11_2_ПоступлениеТоваровУслуг

#Область ШапкаИФормаДокумента

// Вызывается при загрузке документа ПоступлениеТоваровУслуг из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ПоступлениеТоваровУслуг_ПередЗаполнениемДокумента			(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПередЗаполнениемДокумента(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;
	Если Док1СРезультат.ЭтоНовый() Тогда 		
		
		Док1СРезультат.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика");	
		
		Попытка
			ПараметрыЗаполнения = Документы["ПриобретениеТоваровУслуг"].ПараметрыЗаполненияВидаДеятельностиНДС(Док1СРезультат);
			ИО_ОбщийМодуль("УчетНДСУП").ЗаполнитьВидДеятельностиНДС(Док1СРезультат.ЗакупкаПодДеятельность, ПараметрыЗаполнения);
		Исключение КонецПопытки;
		
	КонецЕсли;		

КонецПроцедуры 

// Вызывается при загрузке документа ПоступлениеТоваровУслуг из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ПоступлениеТоваровУслуг_ПослеЗаполненияДокумента			(СтруктураПараметров) Экспорт
	
	УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);
	
	Док1СРезультат 			= СтруктураПараметров.Док1СРезультат;
	Док1СОснование 			= СтруктураПараметров.Док1СОснование;  
	ДокументMS              = СтруктураПараметров.ДанныеДокументаMS; 
		
	// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
	ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
	ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("Отказ", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ""); 
	
	//Миронов А.А
	Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументMS.ШапкаДокумента.ИдСклада1С));
	
	Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
		Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Документ обработан на ТСД! от " + ТекущаяДата();
	Иначе   
		Док1СРезультат.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
	КонецЕсли;
	
	
	Если Склад.ИспользоватьАдресноеХранение Тогда 
		
		Если СтруктураПараметров.ДокументТСД.ШапкаДокумента.НастройкаБизнесПроцесса = "BP017f2c1475954f9fa689a09398708390" Тогда
			//Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
			//	Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Документ обработан на ТСД! от " + ТекущаяДата();
			//Иначе   
			//	Док1СРезультат.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
			//КонецЕсли;
			
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);		
			Исключение
				ИнфоОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки  = "Ошибка при проведении " + Строка(Док1СРезультат) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Приобретение товаров и услуг", "Ошибка" , ТекстОшибки);
				СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
				СтруктураПараметров.Вставить("Отказ", Истина);
				Возврат
			КонецПопытки;
			
			Если Док1СРезультат.Проведен Тогда
				ПриходныйОрдерНаТоварыПоследовательнаяЗагрузка(СтруктураПараметров, Склад);
			КонецЕсли; 
			
		КонецЕсли;
		
		Если НЕ СтруктураПараметров.Отказ Тогда
			СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
		КонецЕсли;
		
	ИначеЕсли НЕ Склад.ИспользоватьАдресноеХранение	И СтруктураПараметров.ДокументТСД.ШапкаДокумента.НастройкаБизнесПроцесса = "BP017f2c1475954f9fa689a09398708390" Тогда 
		
		ТЗФакт 	 = ПолучитьСтруктуруТЗФакт(ДокументMS, Склад, СтруктураПараметров);
		ТЧТовары = Док1СРезультат.Товары;
		Для Каждого Стр Из ТЧТовары Цикл  
			
			СтруктураОтбора 		   = Новый Структура("Номенклатура, Характеристика", Стр.Номенклатура, Стр.Характеристика);
			МассивНайденныхСтрокТЧФакт = ТЗФакт.НайтиСтроки(СтруктураОтбора); 
			
			Если МассивНайденныхСтрокТЧФакт.Количество() > 0 Тогда
				Стр.Количество 		   = МассивНайденныхСтрокТЧФакт[0].Количество;
				Стр.КоличествоУпаковок = МассивНайденныхСтрокТЧФакт[0].КоличествоУпаковок; 
			Иначе
				ТЧТовары.Удалить(Стр);
			КонецЕсли;
			
		КонецЦикла;
		
		ОбработатьТЧПриИзменении(ТЧТовары, Док1СРезультат);
		
	КонецЕсли;	
	//Миронов А.А  
	
КонецПроцедуры  


//Миронов А.А
Процедура ПриходныйОрдерНаТоварыПоследовательнаяЗагрузка(СтруктураПараметров, Склад) Экспорт 
	
	Док1СРезультат 			= СтруктураПараметров.Док1СРезультат;
	Док1СОснование 			= СтруктураПараметров.Док1СОснование;  
	ДокументMS              = СтруктураПараметров.ДанныеДокументаMS; 
	СтруктураТЗФакт         = ПолучитьСтруктуруТЗФакт(ДокументMS, Склад, СтруктураПараметров);	
	
	//Создание и заполнение документа Приходный ордер
	ПриходныйОрдер 			= Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	ПриходныйОрдер.Дата 	= ТекущаяДата(); 
	ПриходныйОрдер.Склад    = Склад; 
	ПриходныйОрдер.Заполнить(Док1СРезультат.Ссылка);
	ПриходныйОрдер.СкладскаяОперация 	   = ПредопределенноеЗначение("Перечисление.СкладскиеОперации.ПриемкаОтПоставщика"); 
	ПриходныйОрдер.Распоряжение 	 	   = Док1СРезультат.Ссылка;
	ПриходныйОрдер.Отправитель       	   = Док1СРезультат.Партнер;
	ПриходныйОрдер.ХозяйственнаяОперация   = Док1СРезультат.ХозяйственнаяОперация;  
	
	Если ЗначениеЗаполнено(Док1СРезультат.ЗаказПоставщику) Тогда
		ПриходныйОрдер.НомерВходящегоДокумента = Док1СРезультат.ЗаказПоставщику.Номер;
		ПриходныйОрдер.ДатаВходящегоДокумента  = Док1СРезультат.ЗаказПоставщику.Дата;
	КонецЕсли;   
	
	ЗонаПриемки 				 		   = ДокументMS.ШапкаДокумента.Зона;
	ЗонаПриемки 				 	       = Справочники.СкладскиеЯчейки.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗонаПриемки));  
	Если Не ЗонаПриемки = Неопределено Тогда
		ПриходныйОрдер.ЗонаПриемки         = ЗонаПриемки;
	КонецЕсли;     
	ПриходныйОрдер.Комментарий 			   = "Документ создан на основании: " + Строка(Док1СРезультат);  
	                                      
	Попытка
		Помещение 	  = Справочники.СкладскиеПомещения.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументMS.ШапкаДокумента.ИдСклада1С));
		Если Помещение.ПолучитьОбъект() = Неопределено Тогда
			Результат = Неопределено;
		Иначе 
			Результат = Помещение;
		КонецЕсли;
	Исключение
		Результат 	  = Неопределено;
	КонецПопытки; 
	
	ПриходныйОрдер.Помещение = Результат;  
	
	Если Метаданные.Документы.ПриходныйОрдерНаТовары.Реквизиты.Найти("ЗакрыватьГрафикПоступления") <> Неопределено Тогда
    	ПриходныйОрдер.ЗакрыватьГрафикПоступления = Истина;
	КонецЕсли;
	
	//Заполнение статусов 
	Если ЗначениеЗаполнено(ДокументMS.ШапкаДокумента.ЕстьПереполнениеИлиНедобор) И ДокументMS.ШапкаДокумента.ЕстьПереполнениеИлиНедобор Тогда
		Если Склад.ИспользоватьСтатусыПриходныхОрдеров Тогда
			ПриходныйОрдер.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПриходныхОрдеров.ТребуетсяОбработка");
		Иначе
			ПриходныйОрдер.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПриходныхОрдеров.Принят");	
		КонецЕсли;
	Иначе
		ПриходныйОрдер.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПриходныхОрдеров.Принят");
	КонецЕсли;	
	
	//Заполнение исполнителя
	Исполнитель = ПолучитьСсылку("Пользователи", ДокументMS.ШапкаДокумента.ИдПользователя);
	
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		ПриходныйОрдер.Исполнитель = Исполнитель;
	Иначе  
		ПриходныйОрдер.Исполнитель = Пользователи.ТекущийПользователь();
	КонецЕсли;  
	
	////Заполнение комментария
	//Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
	//	Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Создан документ: " + Строка(ПриходныйОрдер);
	//Иначе   
	//	Док1СРезультат.Комментарий = "Создан документ: " + Строка(ПриходныйОрдер);
	//КонецЕсли;
	
	//Заполнение табличной части
	ПриходныйОрдер.Товары.Очистить();
	ПриходныйОрдер.ШтрихкодыУпаковок.Очистить();
	
	Для Каждого Строка Из СтруктураТЗФакт Цикл
		НоваяСтрока = ПриходныйОрдер.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
		ПолучитьСтатусСерий(НоваяСтрока, ПриходныйОрдер, Склад);	
	КонецЦикла;
	
	Попытка
		
		//Если Не ПриходныйОрдер.ПроверитьЗаполнение() И Склад.ИспользоватьСтатусыПриходныхОрдеров Тогда
		//	
		//	ПриходныйОрдер.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПриходныхОрдеров.ТребуетсяОбработка");
		//	
		//КонецЕсли;	
			
		//Проводим ПО
		ПриходныйОрдер.Записать(РежимЗаписиДокумента.Проведение);

		//Заполнение комментария документ основания
		Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
			Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Создан документ: " + Строка(ПриходныйОрдер);
		Иначе   
			Док1СРезультат.Комментарий = "Создан документ: " + Строка(ПриходныйОрдер);
		КонецЕсли;
		Док1СРезультат.Записать();
	
		// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
		//Меняем результирующий документ на приходный ордер и обрабатываем загрузку марок
		СтруктураПараметров.Док1СРезультат = ПриходныйОрдер;
		ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
		ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки  = "Ошибка при проведении " + Строка(ПриходныйОрдер) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Приходный ордер", "Ошибка" , ТекстОшибки);
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("Отказ", Истина);
		Возврат
	КонецПопытки;  
	
	//Создание документа Отбор и размещение
	Если Склад.ИспользоватьАдресноеХранение И ПриходныйОрдер.Проведен И ПриходныйОрдер.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят Тогда
		СоздатьОтборРазмещениеТовара(Док1СРезультат,ПриходныйОрдер, ДокументMS, СтруктураТЗФакт, Склад, СтруктураПараметров);
	ИначеЕсли ПриходныйОрдер.Статус <> Перечисления.СтатусыПриходныхОрдеров.Принят Тогда
		Сообщить("Ввод заданий на размещение допускается на основании приходных ордеров в статусе ""Принят"" ");	
	КонецЕсли;
	
	
КонецПроцедуры   

Функция ПолучитьСтруктуруТЗПлан(ДокументMS, Склад)
	
	СтруктураТЗПлан = Новый ТаблицаЗначений;
	СтруктураТЗПлан.Колонки.Добавить("Номенклатура");
	СтруктураТЗПлан.Колонки.Добавить("Серия");
	СтруктураТЗПлан.Колонки.Добавить("Характеристика");
	СтруктураТЗПлан.Колонки.Добавить("Ячейка");  
	СтруктураТЗПлан.Колонки.Добавить("СтатусУказанияСерий");
	СтруктураТЗПлан.Колонки.Добавить("Количество"); 
	СтруктураТЗПлан.Колонки.Добавить("Упаковка"); 
	СтруктураТЗПлан.Колонки.Добавить("КоличествоУпаковок");
	СтруктураТЗПлан.Колонки.Добавить("КоличествоПлан");
	СтруктураТЗПлан.Колонки.Добавить("КоличествоФакт");   
	
	ЗонаПриемки = ДокументMS.ШапкаДокумента.Area;
	ЗонаПриемки = Справочники.СкладскиеЯчейки.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗонаПриемки));  
	
	Для Каждого Строка Из ДокументMS.СтрокиПлан Цикл
		
		Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СтруктураТЗПлан.Добавить();	
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдТовара));;
		
		Если Строка.Свойство("ИдСерии") Тогда 
			Если ЗначениеЗаполнено(Строка.ИдСерии) Тогда
				НоваяСтрока.Серия = Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдСерии));
			Иначе
				НоваяСтрока.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли; 
		
		Если Строка.Свойство("ИдХарактеристики") Тогда 
			Если ЗначениеЗаполнено(Строка.ИдХарактеристики) Тогда	
				НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдХарактеристики));
			Иначе 
				НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;  
		
		Если Склад.ИспользоватьАдресноеХранение Тогда
			НоваяСтрока.Ячейка = ЗонаПриемки; 	
		КонецЕсли;
		
		Если Строка.Свойство("ИдУпаковки") Тогда 
			Если ЗначениеЗаполнено(Строка.ИдУпаковки) Тогда	
				НоваяСтрока.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдУпаковки));  
			Иначе
				НоваяСтрока.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();	
			КонецЕсли;
		КонецЕсли;
		
		//НоваяСтрока.СтатусУказанияСерий = 6; //5, 6, 25 — по сериям учитываются остатки, серии указываются при планировании отбора, заполняются по FEFO (используются только в документах отгрузки товаров) 
		НоваяСтрока.КоличествоФакт = Строка.КоличествоФакт;
		НоваяСтрока.КоличествоПлан = Строка.КоличествоПлан;
		
	КонецЦикла;
	
	Возврат СтруктураТЗПлан; 
КонецФункции


//Пересчет ТЧ Документа
Процедура ОбработатьТЧПриИзменении(ТЧ, Объект)
		
	СтруктураДействий = ПолучитьСтруктуруДействий(Объект);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ТЧ, СтруктураДействий, Неопределено);
	
КонецПроцедуры   

Функция ПолучитьСтруктуруДействий(Объект)
	
	СтруктураДействий = Новый Структура;
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий.Вставить("ПересчитатьСумму", "КоличествоУпаковок");
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки", "КоличествоУпаковок");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
	
	Возврат СтруктураДействий; 
	
КонецФункции
//Пересчет ТЧ Документа 


// Заполнение факт
Функция ПолучитьСтруктуруТЗФакт(ДокументMS, Склад, СтруктураПараметров)
	
	СтруктураТЗФакт = Новый ТаблицаЗначений;
	СтруктураТЗФакт.Колонки.Добавить("Номенклатура");
	СтруктураТЗФакт.Колонки.Добавить("Серия");
	СтруктураТЗФакт.Колонки.Добавить("Характеристика");
	СтруктураТЗФакт.Колонки.Добавить("Назначение");
	СтруктураТЗФакт.Колонки.Добавить("Ячейка");
	СтруктураТЗФакт.Колонки.Добавить("Упаковка"); 
	СтруктураТЗФакт.Колонки.Добавить("ЗонаПриемки");
	СтруктураТЗФакт.Колонки.Добавить("КоличествоПлан");
	СтруктураТЗФакт.Колонки.Добавить("КоличествоФакт");
	СтруктураТЗФакт.Колонки.Добавить("Количество");
	СтруктураТЗФакт.Колонки.Добавить("КоличествоУпаковок");   
	
	ЗонаПриемки = ДокументMS.ШапкаДокумента.Зона;
	
	Если ЗначениеЗаполнено(ЗонаПриемки) Тогда 
		ЗонаПриемки = Справочники.СкладскиеЯчейки.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗонаПриемки)); 
	КонецЕсли;
	
	Для Каждого Строка Из ДокументMS.СтрокиФакт Цикл
		
		Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СтруктураТЗФакт.Добавить(); 
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдТовара));

		Если Строка.Свойство("ИдПервогоМеста") Тогда
			Если ЗначениеЗаполнено(Строка.ИдПервогоМеста) Тогда 
				НоваяСтрока.Ячейка = Справочники.СкладскиеЯчейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдПервогоМеста));
			Иначе
				НоваяСтрока.Ячейка = ЗонаПриемки;
			КонецЕсли;	
		КонецЕсли;
			
		Если Строка.Свойство("ИдСерии") Тогда  
			Если ЗначениеЗаполнено(Строка.ИдСерии) Тогда  	
				НоваяСтрока.Серия = Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдСерии));
				Если НоваяСтрока.Серия.ПолучитьОбъект() = Неопределено Тогда
					НоваяСтрока.Серия = СоздатьСериюНоменклатуры(Строка, НоваяСтрока.Номенклатура, СтруктураПараметров);
				КонецЕсли;
			Иначе
				НоваяСтрока.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();		
			КонецЕсли;
		КонецЕсли; 
		
		Если Строка.Свойство("ИдХарактеристики") Тогда
			Если ЗначениеЗаполнено(Строка.ИдХарактеристики) Тогда
				НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ИдХарактеристики));
			Иначе 
				НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;  
		
		Если Строка.Свойство("ИдУпаковки") Тогда 
			Если ЗначениеЗаполнено(Строка.ИдУпаковки) Тогда	
				НоваяСтрока.Упаковка = ЗаполнятьБазовуюЕдиницуИлиУпаковку(НоваяСтрока.Номенклатура, Строка.ИдУпаковки, Склад); 
			Иначе
				НоваяСтрока.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();	
			КонецЕсли;
		КонецЕсли; 
		
		Если Строка.Свойство("Назначение") Тогда 
			Если ЗначениеЗаполнено(Строка.Назначение) Тогда	
				НоваяСтрока.Назначение = Справочники.Назначения.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.Назначение));; 
			Иначе
				НоваяСтрока.Назначение = Справочники.Назначения.ПустаяСсылка();	
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока.ЗонаПриемки = ЗонаПриемки;
		НоваяСтрока.КоличествоФакт = Строка.КоличествоФакт;
		НоваяСтрока.КоличествоПлан = Строка.КоличествоПлан;
		НоваяСтрока.Количество = КоличествоВБазовойЕдинице(НоваяСтрока.Номенклатура, Строка.КоличествоФакт, НоваяСтрока.Упаковка);
		НоваяСтрока.КоличествоУпаковок = Строка.КоличествоФакт;
		
	КонецЦикла;
	СтруктураТЗФакт.Свернуть("Номенклатура, Серия, Характеристика, Назначение, Ячейка, Упаковка, ЗонаПриемки", "КоличествоПлан, КоличествоФакт, Количество, КоличествоУпаковок");
	Возврат СтруктураТЗФакт;
	
КонецФункции

Функция ЗаполнятьБазовуюЕдиницуИлиУпаковку(Номенклатура, ИдЕдиницыСТСД, Склад) 
	
	Попытка
		ЕдиницаИзмеренияСТСД   = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдЕдиницыСТСД)); 
	Исключение 
		ЕдиницаИзмеренияСТСД   = Номенклатура.ЕдиницаИзмерения;
	КонецПопытки;    
	
	БазоваяЕдиницаНоменклатуры = Номенклатура.ЕдиницаИзмерения;	
	АдресноеХранение 		   = Склад.ИспользоватьАдресноеХранение; 
	
	Если ЕдиницаИзмеренияСТСД  = БазоваяЕдиницаНоменклатуры Тогда 
		
		Если НЕ АдресноеХранение Тогда//(ТипЗнч(ОбъектДокумент1С) = Тип("ДокументОбъект.ПересчетТоваров") И НЕ АдресноеХранение) Тогда
			НайденнаяЕИ = ЕдиницаИзмеренияСТСД;
		ИначеЕсли АдресноеХранение И Номенклатура.ИспользоватьУпаковки Тогда
			НайденнаяЕИ = УТ_11_2_ПолучитьУпаковкуПоКоэффициентуИВладельцу(Номенклатура);
		Иначе
			НайденнаяЕИ = ЕдиницаИзмеренияСТСД; 
		КонецЕсли;
		
		Возврат НайденнаяЕИ;
		
	Иначе
		
		Возврат ЕдиницаИзмеренияСТСД;
		
	КонецЕсли;	
	
КонецФункции

Функция КоличествоВБазовойЕдинице(Номенклатура, КоличествоФакт, Упаковка)
	
	КоэффициентФакт = 1; 	
	Попытка
		Если Номенклатура.ЕдиницаИзмерения <> Упаковка Тогда
			КоэффициентФакт = Упаковка.Числитель / Упаковка.Знаменатель;
		КонецЕсли;    
	Исключение
	КонецПопытки;
	РассчитанноеКоличество = КоличествоФакт * КоэффициентФакт;
	Возврат РассчитанноеКоличество;	
	
КонецФункции

Функция СоздатьСериюНоменклатуры(СтрокаТЗ, Номенклатура, СтруктураПараметров) 
	
	ИмяСобытия = "Дв_УТ_11_2_НайтиСоздатьСериюНоменклатуры";
	
	СтрокаТабличнойЧастиДокументаТСД = СтрокаТЗ;	
	ИмяТабличнойЧасти				 = "Товары";
	
	СерийныйНомер	= ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("СН"), СокрЛП(СтрокаТабличнойЧастиДокументаТСД.СН), "");	
	ПолеИдСерии 	= ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("ИдСерии"), "ИдСерии", ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("id"), "id", ""));	
	ИдСерии 		= ?(Не ПустаяСтрока(ПолеИдСерии), СокрЛП(СтрокаТабличнойЧастиДокументаТСД[ПолеИдСерии]), "");
	
    // Для маркируемой продуцкии в поле СН содержится идентификатор экземпляра (21)XXXX...
	// Серию не создаем
	ЭтоМаркируемаяПродукцияБезСерии = ИО_ЭтоМаркируемаяПродукцияБезСерии(СтрокаТабличнойЧастиДокументаТСД, СтруктураПараметров); 
	Если ЭтоМаркируемаяПродукцияБезСерии И НЕ ЗначениеЗаполнено(ИдСерии) Тогда
		Возврат Неопределено;
	КонецЕсли;                                                                                                                                  
	
	ВидНоменклатуры = ?(Номенклатура.ВидНоменклатуры.НастройкиСерийБерутсяИзДругогоВидаНоменклатуры,
		Номенклатура.ВидНоменклатуры.ВладелецСерий,
		Номенклатура.ВидНоменклатуры);
		
	ПустаяСерия = ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");
	
	Если ИмяТабличнойЧасти = "Товары" И ЗначениеЗаполнено(СерийныйНомер) И НЕ ЗначениеЗаполнено(ИдСерии) 
		И Не ВидНоменклатуры.НастройкаИспользованияСерий = ПредопределенноеЗначение("Перечисление.НастройкиИспользованияСерийНоменклатуры.ЭкземплярТовара") Тогда		
		Возврат ПустаяСерия;
	КонецЕсли;	
		
	Номер 	 		 = "";
	ИмяСерии 		 = "";
	ДатаСерии		 = Дата(1,1,1);
	СрокГодности	 = Дата(1,1,1);
	ДатаПроизводства = Дата(1,1,1);
	
	Если СтруктураПараметров.ДокументТСД.Свойство("Серии") Тогда
		
		СтрокаТабличнойЧастиСерии = НайтиЭлементМассива(СтруктураПараметров.ДокументТСД.Серии, "Ид", ИдСерии);
		Если СтрокаТабличнойЧастиСерии = Неопределено Тогда
			СтрокаТабличнойЧастиСерии = НайтиЭлементМассива(СтруктураПараметров.ДокументТСД.Серии, "id", ИдСерии);
		КонецЕсли;		
		
	    Если СтрокаТабличнойЧастиСерии <> Неопределено Тогда
			
	        Номер = ?(СтрокаТабличнойЧастиСерии.Свойство("Номер"), СокрЛП(СтрокаТабличнойЧастиСерии.Номер), "");
			Если ПустаяСтрока(Номер) Тогда
				Номер = ?(СтрокаТабличнойЧастиСерии.Свойство("nomer"), СокрЛП(СтрокаТабличнойЧастиСерии["nomer"]), "");
			КонецЕсли;                                                                                                          			
			
	        ИмяСерии = ?(СтрокаТабличнойЧастиСерии.Свойство("ИмяСерии"), СокрЛП(СтрокаТабличнойЧастиСерии.ИмяСерии), "");
			Если ПустаяСтрока(ИмяСерии) Тогда
				ИмяСерии = ?(СтрокаТабличнойЧастиСерии.Свойство("imyaSerii"), СокрЛП(СтрокаТабличнойЧастиСерии["imyaSerii"]), "");
			КонецЕсли;
			
	        Если СтрокаТабличнойЧастиСерии.Свойство("ДатаСерии") Тогда 
				Если ТипЗнч(СтрокаТабличнойЧастиСерии.ДатаСерии) = Тип("Строка") И НЕ ПустаяСтрока(СтрокаТабличнойЧастиСерии.ДатаСерии) Тогда
					ДатаСерии = НачалоДня(ПрочитатьДатуJSON(СтрокаТабличнойЧастиСерии.ДатаСерии, ФорматДатыJSON.ISO));
				ИначеЕсли ТипЗнч(СтрокаТабличнойЧастиСерии.ДатаСерии) = Тип("Дата") Тогда
					ДатаСерии = СтрокаТабличнойЧастиСерии.ДатаСерии;
				КонецЕсли;	            	 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДатаСерии) Тогда
				ДатаСерии = ?(СтрокаТабличнойЧастиСерии.Свойство("dataSerii"), СтрокаТабличнойЧастиСерии["dataSerii"], Дата(1,1,1));
				Если НЕ ТипЗнч(ДатаСерии) = Тип("Дата") Тогда
					ДатаСерии = НачалоДня(ПрочитатьДатуJSON(ДатаСерии, ФорматДатыJSON.ISO));
				КонецЕсли;
			КонецЕсли;
			
	    КонецЕсли;            
	    
	Иначе
	    
	    СтрокаТабличнойЧастиСерии = Неопределено;
	    
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СерийныйНомер) И НЕ ЭтоМаркируемаяПродукцияБезСерии Тогда
		
		Попытка
			Серия = Справочники["СерииНоменклатуры"].НайтиПоРеквизиту("Номер", СерийныйНомер);
		Исключение
			Серия = ПустаяСерия;
		КонецПопытки;		
		
		Если Серия.Пустая() ИЛИ Серия.ПолучитьОбъект() = Неопределено Тогда
			
			СерияОбъект					= Справочники["СерииНоменклатуры"].СоздатьЭлемент();
			СерияОбъект.Номер   		= СерийныйНомер;			
			СерияОбъект.ВидНоменклатуры = ВидНоменклатуры;		
			
			Если НЕ ЗначениеЗаполнено(СерияОбъект.ВидНоменклатуры) Тогда 
				СерияОбъект.ВидНоменклатуры = Справочники["ВидыНоменклатуры"].ВидНоменклатурыПоУмолчанию();
			КонецЕсли;
			
			СерияОбъект.Записать();
			
			Серия = СерияОбъект.Ссылка;
						
		КонецЕсли;	
		
	ИначеЕсли ЗначениеЗаполнено(ИдСерии) Тогда
		
		Попытка
			Серия = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСерии));
		Исключение
			Серия = ПустаяСерия;
		КонецПопытки; 		
		
		Если Серия.Пустая() ИЛИ Серия.ПолучитьОбъект() = Неопределено Тогда
			
			Попытка
				ИспользуетсяНомерСерии 	 	 = ВидНоменклатуры.ИспользоватьНомерСерии;
				ИспользуетсяСрокГодности 	 = ВидНоменклатуры.ИспользоватьСрокГодностиСерии;
				ИспользуетсяДатаПроизводства = ВидНоменклатуры.ИспользоватьДатуПроизводстваСерии;
			Исключение
				ИспользуетсяНомерСерии 	 	 = Истина;
				ИспользуетсяСрокГодности 	 = Истина;
				ИспользуетсяДатаПроизводства = Истина;
			КонецПопытки;
			
			// Дата производства
			ДатаРегистрацииСтрокаТСД = Неопределено;
			Если ИспользуетсяДатаПроизводства
				И СтрокаТабличнойЧастиДокументаТСД.Свойство("ДатаРегистрации", ДатаРегистрацииСтрокаТСД) Тогда
				Если ТипЗнч(ДатаРегистрацииСтрокаТСД) = Тип("Строка") И НЕ ПустаяСтрока(ДатаРегистрацииСтрокаТСД) Тогда
					ДатаПроизводства = НачалоДня(ПрочитатьДатуJSON(ДатаРегистрацииСтрокаТСД, ФорматДатыJSON.ISO));
				ИначеЕсли ТипЗнч(ДатаРегистрацииСтрокаТСД) = Тип("Дата") Тогда
					ДатаПроизводства = ДатаРегистрацииСтрокаТСД;
				КонецЕсли;
			КонецЕсли;
			
			// Срок годности
			Если ИспользуетсяСрокГодности Тогда
				СрокГодностиСтрокаТСД = Неопределено;
				Если СтрокаТабличнойЧастиДокументаТСД.Свойство("СрокГодности", СрокГодностиСтрокаТСД) Тогда
					Если ТипЗнч(СрокГодностиСтрокаТСД) = Тип("Строка") И НЕ ПустаяСтрока(СрокГодностиСтрокаТСД) Тогда
						СрокГодности = НачалоДня(ПрочитатьДатуJSON(СрокГодностиСтрокаТСД, ФорматДатыJSON.ISO));
					ИначеЕсли ТипЗнч(СрокГодностиСтрокаТСД) = Тип("Дата") Тогда
						СрокГодности = СрокГодностиСтрокаТСД;
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СрокГодности) И ЗначениеЗаполнено(ДатаСерии) Тогда
					СрокГодности = ДатаСерии;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СрокГодности)	И ЗначениеЗаполнено(ДатаПроизводства) Тогда
					Попытка
						РеквизитыСрокаГодности = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "СрокГодности, ЕдиницаИзмеренияСрокаГодности");
						
						Если ЗначениеЗаполнено(РеквизитыСрокаГодности.СрокГодности) Тогда
							Если РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Сутки") Тогда
								СрокГодности = ДатаПроизводства + РеквизитыСрокаГодности.СрокГодности * 86400;
							ИначеЕсли РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Час") Тогда
								СрокГодности = ДатаПроизводства + РеквизитыСрокаГодности.СрокГодности * 3600;
							ИначеЕсли РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Месяц") Тогда
								СрокГодности = ДобавитьМесяц(ДатаПроизводства, РеквизитыСрокаГодности.СрокГодности);
							ИначеЕсли РеквизитыСрокаГодности.ЕдиницаИзмеренияСрокаГодности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Год") Тогда
								СрокГодности = ДобавитьМесяц(ДатаПроизводства, РеквизитыСрокаГодности.СрокГодности * 12);
							КонецЕсли;
						КонецЕсли;
					Исключение
						ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
					
				Если НЕ ЗначениеЗаполнено(СрокГодности) Тогда	
					СрокГодностиМожетБытьВключенВКМ = ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("Маркировка"), СтрокаТабличнойЧастиДокументаТСД.Маркировка, "") = "Молоко";
					Если СрокГодностиМожетБытьВключенВКМ Тогда
						СрокГодности = УТ_11_2_ПолучитьСрокГодностиИзGS1Марка(СтруктураПараметров);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ИспользуетсяНомерСерии И ЗначениеЗаполнено(Номер) 
				ИЛИ ИспользуетсяСрокГодности И ЗначениеЗаполнено(СрокГодности)
				ИЛИ ИспользуетсяДатаПроизводства И ЗначениеЗаполнено(ДатаПроизводства) Тогда
			
				Запрос = Новый Запрос("ВЫБРАТЬ
				                      |	СерииНоменклатуры.Ссылка КАК Ссылка
				                      |ИЗ
				                      |	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
				                      |ГДЕ
				                      |	НЕ СерииНоменклатуры.ПометкаУдаления
				                      |	И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
				                      |	И &УсловиеСрокГодности
				                      |	И &УсловиеНомерСерии
									  |	И &УсловиеДатаПроизводства");
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНомерСерии",
					?(ИспользуетсяНомерСерии И ЗначениеЗаполнено(Номер), "СерииНоменклатуры.Номер = &Номер", "ИСТИНА"));
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСрокГодности",
					?(ИспользуетсяСрокГодности И ЗначениеЗаполнено(СрокГодности), "СерииНоменклатуры.ГоденДо = &СрокГодности", "ИСТИНА"));
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДатаПроизводства",
					?(ИспользуетсяДатаПроизводства И ЗначениеЗаполнено(ДатаПроизводства), "СерииНоменклатуры.ДатаПроизводства = &ДатаПроизводства", "ИСТИНА"));
					
				Запрос.УстановитьПараметр("Номер", 				Номер);
				Запрос.УстановитьПараметр("ВидНоменклатуры", 	ВидНоменклатуры);
				Запрос.УстановитьПараметр("СрокГодности", 		СрокГодности);
				Запрос.УстановитьПараметр("ДатаПроизводства",	ДатаПроизводства);
				
				Выборка = Запрос.Выполнить().Выбрать();		
				
				Если Выборка.Следующий() Тогда
					
					Серия = Выборка.Ссылка;
					
				Иначе
					
					Если НЕ ЗначениеЗаполнено(ИмяСерии)	Тогда
						ИмяСерии = ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("ИмяСерии"), СтрокаТабличнойЧастиДокументаТСД.ИмяСерии, "");
						Если ИспользуетсяДатаПроизводства И ЗначениеЗаполнено(ДатаПроизводства) Тогда
							ИмяСерии = ИмяСерии + ?(ПустаяСтрока(ИмяСерии), "", " ") + "от " + Формат(ДатаПроизводства, "ДФ=dd.MM.yy");
						КонецЕсли;
						Если ИспользуетсяСрокГодности И ЗначениеЗаполнено(СрокГодности) Тогда
							ИмяСерии = ИмяСерии + ?(ПустаяСтрока(ИмяСерии), "", " ") + "до " + Формат(СрокГодности, "ДФ=dd.MM.yy");
						КонецЕсли;
					КонецЕсли;
					
					СерияОбъект					 = Справочники["СерииНоменклатуры"].СоздатьЭлемент();
					СерияОбъект.Наименование	 = ИмяСерии;
					СерияОбъект.Номер   		 = Номер;
					СерияОбъект.ГоденДо   		 = СрокГодности;
					СерияОбъект.ДатаПроизводства = ДатаПроизводства;
					СерияОбъект.ВидНоменклатуры  = ВидНоменклатуры;
					
					Если НЕ ЗначениеЗаполнено(СерияОбъект.ВидНоменклатуры) Тогда
						СерияОбъект.ВидНоменклатуры = Справочники["ВидыНоменклатуры"].ВидНоменклатурыПоУмолчанию();
					КонецЕсли;
					
					СерияОбъект.Записать();
					
					Серия = СерияОбъект.Ссылка;
					
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;	
	
	Иначе
		
		Серия = ПустаяСерия;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Серия) И Серия.ПолучитьОбъект() <> Неопределено Тогда
		СтрокаТабличнойЧастиДокументаТСД.Вставить("ИдНайденнойСерии", СокрЛП(Серия.УникальныйИдентификатор()));
	КонецЕсли;
	
	Возврат Серия;

	
	Возврат Серия
КонецФункции

//Заполнение факт

// Получение статуса серий строки ТЧ
Процедура ПолучитьСтатусСерий(Строка, ДокОбъект, Склад) 
	
	ДокументМенеджер = "";
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ОрдерНаОтражениеНедостачТоваров") Тогда  
		ДокументМенеджер = Документы.ОрдерНаОтражениеНедостачТоваров; 
	КонецЕсли; 
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ОрдерНаОтражениеИзлишковТоваров") Тогда
		ДокументМенеджер = Документы.ОрдерНаОтражениеИзлишковТоваров;
	КонецЕсли; 
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ОтборРазмещениеТоваров") Тогда
		ДокументМенеджер = Документы.ОтборРазмещениеТоваров; 	
	КонецЕсли;  
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары") Тогда
		ДокументМенеджер = Документы.ПриходныйОрдерНаТовары; 	
	КонецЕсли;
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.РасходныйОрдерНаТовары") Тогда
		ДокументМенеджер = Документы.РасходныйОрдерНаТовары; 	
	КонецЕсли;
		
	Если Не ПустаяСтрока(ДокументМенеджер) Тогда 
		
		ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(ДокОбъект, ДокументМенеджер)); 
		
		Если ПараметрыУказанияСерий.Свойство("Отбор") Тогда	
			СтруктураСтатусСерии = НоменклатураСервер.ПроверитьСериюРассчитатьСтатусПриИзмененииРеквизитаВТЧ(Строка, Склад, ПараметрыУказанияСерий.Отбор);
		ИначеЕсли ПараметрыУказанияСерий.Свойство("Размещение") Тогда
			СтруктураСтатусСерии = НоменклатураСервер.ПроверитьСериюРассчитатьСтатусПриИзмененииРеквизитаВТЧ(Строка, Склад, ПараметрыУказанияСерий.Размещение);
		ИначеЕсли ПараметрыУказанияСерий.Свойство("ТоварыПоРаспоряжениям") Тогда
			СтруктураСтатусСерии = НоменклатураСервер.ПроверитьСериюРассчитатьСтатусПриИзмененииРеквизитаВТЧ(Строка, Склад, ПараметрыУказанияСерий.ТоварыПоРаспоряжениям);
		ИначеЕсли ПараметрыУказанияСерий.Свойство("ОтгружаемыеТовары") Тогда
			СтруктураСтатусСерии = НоменклатураСервер.ПроверитьСериюРассчитатьСтатусПриИзмененииРеквизитаВТЧ(Строка, Склад, ПараметрыУказанияСерий.ОтгружаемыеТовары);	
		Иначе
			СтруктураСтатусСерии = НоменклатураСервер.ПроверитьСериюРассчитатьСтатусПриИзмененииРеквизитаВТЧ(Строка, Склад, ПараметрыУказанияСерий)
		КонецЕсли;
		
		Если СтруктураСтатусСерии.Свойство("СтатусУказанияСерий") Тогда   
			Строка.СтатусУказанияСерий = СтруктураСтатусСерии.СтатусУказанияСерий;
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры
// Получение статуса серий строки ТЧ

//Ордер - может быть "Приходным" или "Расходным" Док1С - может быть как результирующим так и основанием - используется для формирования комментария
Процедура СоздатьОтборРазмещениеТовара(Док1С, Ордер, ДокументMS, СтруктураТЗФакт, Склад, СтруктураПараметров);
	
	ОтборРазмешение 			 = Документы.ОтборРазмещениеТоваров.СоздатьДокумент(); 
	ОтборРазмешение.Дата 		 = ТекущаяДата();   
	ОтборРазмешение.Склад        = Склад;
	ОтборРазмешение.Заполнить(Ордер.Ссылка);  
	ОтборРазмешение.Распоряжение = Ордер.Ссылка;
	ОтборРазмешение.Статус 		 = ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.Подготовлено");
	
	Если ТипЗнч(Ордер) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары") Тогда
		ОтборРазмешение.ВидОперации  = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Размещение");
		ОтборРазмешение.ЗонаПриемки  = Ордер.ЗонаПриемки; 	
	Иначе 
		ОтборРазмешение.ВидОперации  = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Отбор");
		ОтборРазмешение.ЗонаОтгрузки = Ордер.ЗонаОтгрузки;	
	КонецЕсли;

	ОтборРазмешение.Комментарий  = "Документ создан на основании: " + Строка(Ордер);
	
	Если ОтборРазмешение.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Отбор И НЕ ЗначениеЗаполнено(ОтборРазмешение.ЗонаОтгрузки) Тогда
		ОтборРазмешение.ЗонаОтгрузки = Справочники.СкладскиеЯчейки.ЗонаОтгрузкиПоУмолчанию(ОтборРазмешение.Склад, ОтборРазмешение.Помещение);
	ИначеЕсли ОтборРазмешение.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Размещение И НЕ ЗначениеЗаполнено(ОтборРазмешение.ЗонаПриемки) Тогда
		ОтборРазмешение.ЗонаПриемки = Справочники.СкладскиеЯчейки.ЗонаПриемкиПоУмолчанию(ОтборРазмешение.Склад, ОтборРазмешение.Помещение);
	КонецЕсли;

	Ответсвенный = ПолучитьСсылку("Пользователи", ДокументMS.ШапкаДокумента.ИдПользователя); 
	Если ЗначениеЗаполнено(Ответсвенный) Тогда
		ОтборРазмешение.Ответственный = Ответсвенный;
		ОтборРазмешение.Исполнитель   = Ответсвенный;
	Иначе  
		ОтборРазмешение.Ответственный = Пользователи.ТекущийПользователь();
		ОтборРазмешение.Исполнитель   = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ОтборРазмешение.ТоварыОтбор.Очистить();
	ОтборРазмешение.ТоварыРазмещение.Очистить();   
	
	Если ТипЗнч(Ордер) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары") Тогда
		Для Каждого Строка Из СтруктураТЗФакт Цикл	
			Если Строка.Ячейка = Строка.ЗонаПриемки Тогда 
				Продолжить;
			Иначе
				НоваяСтрока    = ОтборРазмешение.ТоварыРазмещение.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
				//ПолучитьСтатусСерий(НоваяСтрока, ОтборРазмешение, Склад); 
			КонецЕсли;		
		КонецЦикла;	
	Иначе 
		Для Каждого Строка Из СтруктураТЗФакт Цикл	
			Если Строка.Ячейка = Строка.ЗонаПриемки Тогда 
				Продолжить;
			Иначе
				НоваяСтрока    = ОтборРазмешение.ТоварыОтбор.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				//ПолучитьСтатусСерий(НоваяСтрока, ОтборРазмешение, Склад); 
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;
	
	ВосстанавливатьТЧ = Ложь;
	ОшибкаПроведения = Ложь;
	
	Если ОтборРазмешение.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено Тогда;
		ВосстанавливатьТЧ = Истина;
	КонецЕсли;
	
	// Для восстановления загруженных серий после проведения документа в статусе, не предполагающем указания серий
	Если ВосстанавливатьТЧ Тогда
		ТЧО = ОтборРазмешение.ТоварыОтбор.Выгрузить();
		ТЧР = ОтборРазмешение.ТоварыРазмещение.Выгрузить();
		Попытка
			ОтборРазмешение.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОшибкаПроведения = Истина;
		КонецПопытки;
	КонецЕсли;
			
	Если ОшибкаПроведения Тогда
		ИтоговыйСтатус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;
	Иначе		
		ИтоговыйСтатус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
	КонецЕсли;  
	
	//Коментарии, приходный ордер, приобретение товаров и услуг  
	
	Если ЗначениеЗаполнено(Ордер.Комментарий) Тогда
		Ордер.Комментарий = Ордер.Комментарий + Символы.ПС + "Создан документ: " + Строка(ОтборРазмешение);
	Иначе   
		Ордер.Комментарий = "Создан документ: " + Строка(ОтборРазмешение);
	КонецЕсли; 	
	Ордер.Записать(); 
		
	Если ЗначениеЗаполнено(Док1С.Комментарий) Тогда
		Док1С.Комментарий = Док1С.Комментарий + Символы.ПС + "Создан документ: " + Строка(ОтборРазмешение);
	Иначе   
		Док1С.Комментарий = "Создан документ: " + Строка(ОтборРазмешение);
	КонецЕсли;
	
	Док1С.Записать();
	
	// Восстановление загруженных серий после проведения документа в статусе, не предполагающем указания серий
	Если ВосстанавливатьТЧ Тогда
        ОтборРазмешение.ТоварыОтбор.Загрузить(ТЧО);
		ОтборРазмешение.ТоварыРазмещение.Загрузить(ТЧР);
	КонецЕсли;
	
	ОтборРазмешение.Статус = ИтоговыйСтатус;
	
	// Поле "Серия" зависит от поля СтатусУказанияСерий
	Если ТипЗнч(ОтборРазмешение) = Тип("ДокументОбъект.ОтборРазмещениеТоваров") Тогда 
		
		СтрокиТоваровДляОбработки = Неопределено;
		СтрокиСерийДляОбработки = Неопределено;
		
		//Код из МодульОбъекта ОтборРазмещениеТоваров		
		//ПараметрыУказанияСерий = Вычислить("НоменклатураСервер.ПараметрыУказанияСерий(Док1СРезультат, Документы.ОтборРазмещениеТоваров)");
		ПараметрыУказанияСерий = ИО_ОбщийМодуль("НоменклатураСервер").ПараметрыУказанияСерий(ОтборРазмешение, Документы.ОтборРазмещениеТоваров);
		
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Отбор)");		
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Размещение, СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки)");
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(ОтборРазмешение, ПараметрыУказанияСерий.Отбор);
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(ОтборРазмешение, ПараметрыУказанияСерий.Размещение, СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
		
	КонецЕсли;
	
	Попытка
		// При повторном проведении документа в УТ 11.5 возникает попытка использования закрытого менеджера временных таблиц
		ОтборРазмешение.Движения.ТоварыВЯчейках.ДополнительныеСвойства.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	Исключение
	КонецПопытки;
			
	
	Попытка  
		
		Если Не ОтборРазмешение.ПроверитьЗаполнение() Тогда
			ОтборРазмешение.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками");
		Иначе		
			ОтборРазмешение.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок");
		КонецЕсли;
	
		Для Каждого СтрокаОтбора Из ОтборРазмешение.ТоварыОтбор Цикл 
			Если СтрокаОтбора.Номенклатура.ВидНоменклатуры.ИспользоватьСерии И Склад.ИспользоватьСерииНоменклатуры И ОтборРазмешение.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками") Тогда
				Если Не ЗначениеЗаполнено(СтрокаОтбора.Серия) Тогда
					ОтборРазмешение.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;					
		
		//Если ОтборРазмешение.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Отбор") Тогда
		//	// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
		//	СтруктураПараметров.Док1СРезультат = ОтборРазмешение;
		//	ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
		//	ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
		//КонецЕсли; 
			
		ОтборРазмешение.Записать(РежимЗаписиДокумента.Проведение);  
		
	Исключение 
		
		ОтборРазмешение.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками");
		ОтборРазмешение.Записать();
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка при проведении " + Строка(ОтборРазмешение) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Отбор размещения товаров ", "Ошибка" , ТекстОшибки); 
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("Отказ", Истина); 
		
	КонецПопытки;
	
КонецПроцедуры

//Миронов А.А

#КонецОбласти

#Область ТЧ_Товары

// Вызывается при загрузке табличной части Товары документа ПоступлениеТоваровУслуг из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - Неопределено                - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ПоступлениеТоваровУслуг_ПередЗаполнениемТЧ_Товары			(СтруктураПараметров) Экспорт

	ИмяСобытия = "УТ_11_2_ПоступлениеТоваровУслуг_ПередЗаполнениемТЧ_Товары";
	
	УТ_11_2_Общий_ПередЗаполнениемТЧ(СтруктураПараметров);	
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
	ШапкаДокумента = ДокументТСД.ШапкаДокумента;
	
	ЕстьДокументОснование = Док1СОснование <> Неопределено И Док1СРезультат <> Док1СОснование;
	
	Если Док1СРезультат.ЭтоНовый()
		И НЕ ЕстьДокументОснование Тогда
		
		ИспользоватьСоглашенияСПоставщиками = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСПоставщиками");
		
		ЗаполнятьУсловияЗакупокПоУмолчанию = Ложь;
		Если ЗначениеЗаполнено(Док1СРезультат.Партнер) И ИспользоватьСоглашенияСПоставщиками Тогда
			УсловияЗакупокПоУмолчанию = ИО_ОбщийМодуль("ЗакупкиСервер").ПолучитьУсловияЗакупокПоУмолчанию(
				Док1СРезультат.Партнер,
				Новый Структура("УчитыватьГруппыСкладов,ИсключитьГруппыСкладовДоступныеВЗаказах,ВыбранноеСоглашение", Истина, Истина, Док1СРезультат.Соглашение));
			
			ЕстьУсловияЗакупокПоУмолчанию = НЕ УсловияЗакупокПоУмолчанию = Неопределено И ЗначениеЗаполнено(УсловияЗакупокПоУмолчанию.Соглашение);
			Если ЕстьУсловияЗакупокПоУмолчанию Тогда
				ЗаполненСкладТСД = ШапкаДокумента.Свойство("ИдСклада1С") И ЗначениеЗаполнено(ШапкаДокумента.ИдСклада1С);
				СкладСоответствуетСкладуДокумента = НЕ ЗаполненСкладТСД
					ИЛИ НЕ ЗначениеЗаполнено(УсловияЗакупокПоУмолчанию.Склад)
					ИЛИ Док1СРезультат.Склад = УсловияЗакупокПоУмолчанию.Склад;
					
				ЗаполнятьУсловияЗакупокПоУмолчанию = СкладСоответствуетСкладуДокумента;
				
				Если НЕ СкладСоответствуетСкладуДокумента Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
						"%1: не удалось заполнить условия закупок по умолчанию (склад в условиях закупок отличается от склада в документе Mobile SMARTS)", Док1СРезультат));
				КонецЕсли;
			Иначе
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
					"%1: не удалось получить соглашение по умолчанию для партнера %2", Док1СРезультат, Док1СРезультат.Партнер));
			КонецЕсли;
		ИначеЕсли ИспользоватьСоглашенияСПоставщиками Тогда
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
				"%1: не удалось получить условия закупок по умолчанию (в документе не заполнен партнер)", Док1СРезультат));
		КонецЕсли;
		
		Если ЗаполнятьУсловияЗакупокПоУмолчанию Тогда
			Попытка
				Док1СРезультат.ЗаполнитьУсловияЗакупокПоУмолчанию(Ложь);
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
					"%1: не удалось заполнить условия закупок по умолчанию. Причина: %2", Док1СРезультат, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));	
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

