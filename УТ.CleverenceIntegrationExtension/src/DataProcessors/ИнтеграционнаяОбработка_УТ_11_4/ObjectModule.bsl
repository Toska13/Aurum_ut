// Вызывается при загрузке табличной части Товары документа ВозвратТоваровПоставщику из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - Неопределено                - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ВозвратТоваровПоставщику_ПередЗаполнениемТЧ_Товары		(СтруктураПараметров) Экспорт

	ИмяСобытия = "УТ_11_2_ВозвратТоваровПоставщику_ПередЗаполнениемТЧ_Товары";
	
	УТ_11_2_Общий_ПередЗаполнениемТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Док1СОснование = СтруктураПараметров.Док1СОснование;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
	ШапкаДокумента = ДокументТСД.ШапкаДокумента;
	
	ЕстьДокументОснование = Док1СОснование <> Неопределено И Док1СРезультат <> Док1СОснование;
	
	Если Док1СРезультат.ЭтоНовый()
		И НЕ ЕстьДокументОснование Тогда
		
		ИспользоватьСоглашенияСПоставщиками = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСПоставщиками");
		
		ЗаполнятьУсловияЗакупокПоУмолчанию = Ложь;
		Если ЗначениеЗаполнено(Док1СРезультат.Партнер) И ИспользоватьСоглашенияСПоставщиками Тогда
			УсловияЗакупокПоУмолчанию = ИО_ОбщийМодуль("ЗакупкиСервер").ПолучитьУсловияЗакупокПоУмолчанию(
				Док1СРезультат.Партнер,
				Новый Структура("УчитыватьГруппыСкладов,ИсключитьГруппыСкладовДоступныеВЗаказах,ВыбранноеСоглашение", Истина, Истина, Док1СРезультат.Соглашение));
			
			ЕстьУсловияЗакупокПоУмолчанию = НЕ УсловияЗакупокПоУмолчанию = Неопределено И ЗначениеЗаполнено(УсловияЗакупокПоУмолчанию.Соглашение);
			Если ЕстьУсловияЗакупокПоУмолчанию Тогда
				ЗаполненСкладТСД = ШапкаДокумента.Свойство("ИдСклада1С") И ЗначениеЗаполнено(ШапкаДокумента.ИдСклада1С);
				СкладСоответствуетСкладуДокумента = НЕ ЗаполненСкладТСД
					ИЛИ НЕ ЗначениеЗаполнено(УсловияЗакупокПоУмолчанию.Склад)
					ИЛИ Док1СРезультат.Склад = УсловияЗакупокПоУмолчанию.Склад;
					
				ЗаполнятьУсловияЗакупокПоУмолчанию = СкладСоответствуетСкладуДокумента;
				
				Если НЕ СкладСоответствуетСкладуДокумента Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
						"%1: не удалось заполнить условия закупок по умолчанию (склад в условиях закупок отличается от склада в документе Mobile SMARTS)", Док1СРезультат));
				КонецЕсли;
			Иначе
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
					"%1: не удалось получить соглашение по умолчанию для партнера %2", Док1СРезультат, Док1СРезультат.Партнер));
			КонецЕсли;
		ИначеЕсли ИспользоватьСоглашенияСПоставщиками Тогда
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
				"%1: не удалось получить условия закупок по умолчанию (в документе не заполнен партнер)", Док1СРезультат));
		КонецЕсли;
		
		Если ЗаполнятьУсловияЗакупокПоУмолчанию Тогда
			Попытка
				Док1СРезультат.ЗаполнитьУсловияЗакупокПоУмолчанию();
			Исключение
