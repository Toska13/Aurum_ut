				И ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС." + ВидПродукцииСоСрокамиГодности) Тогда
				ЭтоВидПродукцииСоСрокамиГодности = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецПопытки;
		
	Возврат ЭтоВидПродукцииСоСрокамиГодности;
	
КонецФункции

Процедура ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров)
	
	ИспользуемыеВидыМаркируемойПродукции = ИСМП_ИспользуемыеВидыМаркируемойПродукцииИСМП();
	
	ВидыПродукцииИС = УТ_11_4_ПолучитьВидыПродукцииИСМП();
	Для каждого ВидПродукцииИС ИЗ ВидыПродукцииИС Цикл
		// Не обрабатываем неиспользуемые виды маркируемой продукции
		Если НЕ ИспользуемыеВидыМаркируемойПродукции = Неопределено
			И ИспользуемыеВидыМаркируемойПродукции.Найти(ВидПродукцииИС) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ИО_ТекстКритическойОшибкиИСМП(ВидПродукцииИС));
		
		УТ_11_4_ПроверитьПродукциюИСМП(СтруктураПараметров, ВидПродукцииИС);
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров)
	
	ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
	
	Если Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИС") <> Неопределено
		ИЛИ Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИСМП") <> Неопределено Тогда
		ИспользуемыеВидыМаркируемойПродукции = ИСМП_ИспользуемыеВидыМаркируемойПродукцииИСМП();
		
		ВидыПродукцииИС = УТ_11_4_ПолучитьВидыПродукцииМОТП();
		Для каждого ВидПродукцииИС ИЗ ВидыПродукцииИС Цикл
			// Не обрабатываем неиспользуемые виды маркируемой продукции
			Если НЕ ИспользуемыеВидыМаркируемойПродукции = Неопределено
				И ИспользуемыеВидыМаркируемойПродукции.Найти(ВидПродукцииИС) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураПараметров.Вставить("КритическаяОшибка", Истина); 
			СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ИО_ТекстКритическойОшибкиИСМП(ВидПродукцииИС));
			
			ИспользоватьПодключениеЧЗ = ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ИспользоватьПодключениеЧЗ"), СтруктураПараметров);
			Если ИспользоватьПодключениеЧЗ = Ложь Тогда
				УТ_11_4_ПроверитьТабачнуюПродукциюИСМПБезЗапросаДанных(СтруктураПараметров, ВидПродукцииИС);
			Иначе
				УТ_11_4_ПроверитьТабачнуюПродукциюИСМПСЗапросомДанных(СтруктураПараметров, ВидПродукцииИС);
			КонецЕсли;
		КонецЦикла;
	Иначе
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина); 
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "Ошибка заполнения данных проверки и подбора табачной продукции!");
		
		УТ_11_2_ПроверитьТабачнуюПродукцию(СтруктураПараметров);
	КонецЕсли;	
	
КонецПроцедуры

// см. ПроверкаИПодборПродукцииИСМПКлиентСервер.ПредставлениеМассиваGTIN
Функция ИО_ПредставлениеМассиваGTIN(КодыGTIN) Экспорт
	
	Если КодыGTIN.Количество() = 1 Тогда
		Возврат КодыGTIN[0].Значение;
	ИначеЕсли КодыGTIN.Количество() > 1 Тогда
		Возврат КодыGTIN[0].Значение + " ( + еще " + Формат(КодыGTIN.Количество() - 1, "ЧГ=0") + ")";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ИСМП_ОпределитьВидПродукцииДокумента(СтруктураПараметров)

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
	СтрокиФакт	   = ДокументТСД.СтрокиФакт;
	
	ОсобенностиУчетаИС = УТ_11_4_ПолучитьРеквизитыОсобенностейУчетаИС();
	
	ВидПродукцииПоДаннымФакта = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.ПустаяСсылка");
	
	ЗначенияПеречисления = Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления;
	
	Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара));
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;			
		КонецЕсли;

		ОсобенностьУчета = ОсобенностиУчетаИС.Получить(Номенклатура.ОсобенностьУчета);
		Если ОсобенностьУчета <> Неопределено Тогда
			Если ЗначенияПеречисления.Найти(ОсобенностьУчета.Имя) <> Неопределено Тогда
				ВидПродукцииПоДаннымФакта = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС." + ОсобенностьУчета.Имя);
			ИначеЕсли ЗначенияПеречисления.Найти(ОсобенностьУчета.ЗначениеМаркировки) <> Неопределено Тогда
				ВидПродукцииПоДаннымФакта = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС." + ОсобенностьУчета.ЗначениеМаркировки);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ВидПродукцииПоДаннымФакта.Пустая() Тогда
		Док1СРезультат.ВидПродукции = ВидПродукцииПоДаннымФакта;
	КонецЕсли;

КонецПроцедуры

Процедура ИСМП_ОпределитьДатуПроизводстваДокумента(СтруктураПараметров)

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
	СтрокиФакт	   = ДокументТСД.СтрокиФакт;
	
	ДатаПроизводстваПоДаннымФакта = Дата(1,1,1);
	
	Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПроверяемыеПоля = Новый Массив;
		ПроверяемыеПоля.Добавить("ДатаРегистрации");
		ПроверяемыеПоля.Добавить("ДатаПроизводства");
		
		Для каждого ИмяПоля ИЗ ПроверяемыеПоля Цикл
			Если НЕ СтрокаФакт.Свойство(ИмяПоля, ДатаПроизводстваПоДаннымФакта) Тогда
				Продолжить;
			КонецЕсли;
		
			Если ТипЗнч(ДатаПроизводстваПоДаннымФакта) = Тип("Строка")
				И НЕ ПустаяСтрока(ДатаПроизводстваПоДаннымФакта) Тогда
				ДатаПроизводстваПоДаннымФакта = НачалоДня(ПрочитатьДатуJSON(ДатаПроизводстваПоДаннымФакта, ФорматДатыJSON.ISO));
			КонецЕсли;
		
			Если ЗначениеЗаполнено(ДатаПроизводстваПоДаннымФакта) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДатаПроизводстваПоДаннымФакта) Тогда
		Док1СРезультат.ДатаПроизводства = ДатаПроизводстваПоДаннымФакта;
	КонецЕсли;

КонецПроцедуры

// см. Документ.МаркировкаТоваровИСМП.Форма.ФормаДокумента.ОпределитьДоступностьОтчетаПроизводственнойЛинии
Функция ИСМП_ОпределитьДоступностьОтчетаПроизводственнойЛинии(ВидПродукции, ОперацииМаркировки, ОперацияНанесения,
	ВозможнаОперацияНанесения = Неопределено) Экспорт
	
	ЗначенияПеречисления = Метаданные.Перечисления.ВидыПродукцииИС.ЗначенияПеречисления;
	
	ЭтоПивоВКегах = НЕ ЗначенияПеречисления.Найти("Пиво") = Неопределено
		И ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Пиво");
	ЭтоПивоВПотрУпаковках = НЕ ЗначенияПеречисления.Найти("ПивоВПотребительскихУпаковках") = Неопределено
		И ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.ПивоВПотребительскихУпаковках");
	
	ЭтоПродукцияМОТП = ИнтеграцияИСКлиентСервер_ЭтоПродукцияМОТП(ВидПродукции);
	ЭтоПиво = ЭтоПивоВКегах ИЛИ ЭтоПивоВПотрУпаковках;
	ЭтоМеха = НЕ ЗначенияПеречисления.Найти("ПродукцияИзНатуральногоМеха") = Неопределено
		И ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.ПродукцияИзНатуральногоМеха");
		
	Если ВозможнаОперацияНанесения = Неопределено Тогда	
		ВозможнаОперацияНанесения = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииИспользуетОтчетыОНанесенииКодовМаркировки(ВидПродукции);
	КонецЕсли;
	
	Если ЭтоПродукцияМОТП Или (ЭтоПиво И Не ОперацииМаркировки.ЭтоТрансграничнаяТорговля) Тогда
		Возврат Истина;
	ИначеЕсли ЭтоМеха Тогда
		Возврат Ложь;
	ИначеЕсли ОперацииМаркировки.ЭтоТрансграничнаяТорговля Или ОперацииМаркировки.ЭтоМаркировкаОстатков
		Или ОперацииМаркировки.ЭтоОперацияНанесения Тогда
		Возврат Ложь;
	ИначеЕсли ОперацииМаркировки.ЭтоВводВОборот И ВозможнаОперацияНанесения И Не ЗначениеЗаполнено(ОперацияНанесения) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Процедура ИСМП_ЗаполнитьДанныеОтчетаПроизводственнойЛинии(СтруктураПараметров)

	ИмяСобытия = "ИСМП_ЗаполнитьДанныеОтчетаПроизводственнойЛинии";
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
    Док1СРезультат.ОтчетПроизводственнойЛинии = Истина;
	
	// Номенклатура, характеристика, серия
	ВыгрузкаТЧ = Док1СРезультат.Товары.Выгрузить(, "Номенклатура, Характеристика, Серия");
	
	НаборыКолонок = Новый Массив;
	НаборыКолонок.Добавить("Номенклатура, Характеристика, Серия");
	НаборыКолонок.Добавить("Номенклатура, Характеристика");
	НаборыКолонок.Добавить("Номенклатура");
	Для каждого НаборКолонок ИЗ НаборыКолонок Цикл
		ВыгрузкаТЧ.Свернуть(НаборКолонок);
		
		Если ВыгрузкаТЧ.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(Док1СРезультат, ВыгрузкаТЧ[0]);	
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Код ТНВЭД
	Если ЗначениеЗаполнено(Док1СРезультат.Номенклатура) Тогда
		КодТНВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док1СРезультат.Номенклатура, "КодТНВЭД", Истина);
		
		Если ЗначениеЗаполнено(КодТНВЭД) Тогда
			Док1СРезультат.КодТНВЭД = КодТНВЭД;
		КонецЕсли;
	КонецЕсли;
	
	// Идентификатор происхождения ВЕТИС, срок годности, скоропортящаяся продукция
	Попытка
		ВыгрузкаТЧ = Док1СРезультат.Товары.Выгрузить(, "ИдентификаторПроисхожденияВЕТИС, СрокГодности");
		
		ВыгрузкаТЧ.Свернуть("ИдентификаторПроисхожденияВЕТИС, СрокГодности");
		Если ВыгрузкаТЧ.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(Док1СРезультат, ВыгрузкаТЧ[0]);	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Док1СРезультат.ИдентификаторПроисхожденияВЕТИС) Тогда
			Док1СРезультат.СкоропортящаясяПродукция	=
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док1СРезультат.ИдентификаторПроисхожденияВЕТИС, "СкоропортящаясяПродукция", Истина);
		КонецЕсли;	
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// см. Документ.МаркировкаТоваровИСМП.Форма.ФормаДокумента.ЗаполнитьКоличествоПоДаннымОтчетаНаСервере
Процедура ИСМП_ЗаполнитьКоличествоПоДаннымОтчетаПроизводственнойЛинии(СтруктураПараметров)
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;

	КОпределениюВидаУпаковки = Неопределено;
	
	//ПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИС.ПараметрыСканирования(ЭтотОбъект);
	ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(
		ИО_ОбщийМодуль("ШтрихкодированиеИС").ПолучитьСтруктуруРеквизитовДокумента(Док1СРезультат));
	
	ПараметрыСканирования.КонтрольУникальностиКодовМаркировки = Ложь;

	// Не требуются лишние запросы данных
	ПараметрыСканирования.ЭтоПроверкаКодовМаркировкиИСМП = Ложь;
	ПараметрыСканирования.ТребуетсяЧастичноеВыбытие      = Ложь;
	Если ИнтеграцияИСКлиентСервер_ЭтоПродукцияМОТП(Док1СРезультат.ВидПродукции) Тогда
		ПараметрыСканирования.ВариантПолученияМРЦ                                                = "Вычисление";
		ПараметрыСканирования.ДопустимыПроверкиСеройЗоныМОТП                                     = Ложь;
		ПараметрыСканирования.ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП          = Ложь;
		ПараметрыСканирования.ПроверятьЛогистическиеИГрупповыеУпаковкиНаСодержаниеСерыхКодовМОТП = Ложь;
	КонецЕсли;

	Если КОпределениюВидаУпаковки = Неопределено Тогда

		РезультатОбработки = ИСМП_КоличествоПоДаннымОтчетаПроизводственнойЛинии(Док1СРезультат, ПараметрыСканирования);
		Если ЗначениеЗаполнено(РезультатОбработки.ТекстОшибки) Тогда
			Возврат;
		КонецЕсли;

		КОпределениюВидаУпаковки = РезультатОбработки.КОпределениюВидаУпаковки;

	КонецЕсли;

	Если КОпределениюВидаУпаковки.GTIN.Количество() Тогда
		РезультатОпределенияВидаУпаковки = ИО_ОбщийМодуль("ГрупповаяОбработкаШтрихкодовИС").ОбработатьДанныеКОпределениюВидаУпаковки(
			КОпределениюВидаУпаковки);

		Если НЕ РезультатОпределенияВидаУпаковки.УточнениеДанныхНеТребуется Тогда
			Возврат;
		КонецЕсли;
				
		// Описание GTIN заполнено в регистре по данным сервиса, нужно пересчитать количество.
		РезультатОбработки = ИСМП_КоличествоПоДаннымОтчетаПроизводственнойЛинии(Док1СРезультат, ПараметрыСканирования);
		Если ЗначениеЗаполнено(РезультатОбработки.ТекстОшибки) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОписанияНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(Док1СРезультат.Номенклатура);
	ОписаниеНоменклатуры = ОписанияНоменклатуры.Получить(Док1СРезультат.Номенклатура);

	Док1СРезультат.Количество = РезультатОбработки.КоличествоПотребительскихУпаковок * ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке;
	
КонецПроцедуры

// см. Документ.МаркировкаТоваровИСМП.Форма.ФормаДокумента.КоличествоПоДаннымОтчетаПроизводственнойЛинии
Функция ИСМП_КоличествоПоДаннымОтчетаПроизводственнойЛинии(Док1СРезультат, ПараметрыСканирования)

	Результат = Новый Структура;
	Результат.Вставить("КоличествоПотребительскихУпаковок", 0);
	Результат.Вставить("КОпределениюВидаУпаковки",          Неопределено);
	Результат.Вставить("ТекстОшибки",                       "");
	
	// В данных отчета произодственной линии полная информация о вложенных потребительских упаковках
	ДанныеОтчета = Док1СРезультат.ДанныеОтчетаПроизводственнойЛинии.Выгрузить(, "ЗначениеШтрихкода, ФорматBase64");

	ДанныеОтчета.Колонки.Добавить("ЗначениеШтрихкодаУпаковки", Новый ОписаниеТипов("Строка"));
	ДанныеОтчета.Колонки.Добавить("НормализованноеЗначениеШтрихкода", Новый ОписаниеТипов("Строка"));
	ДанныеОтчета.Колонки.Добавить("НормализованноеЗначениеШтрихкодаУпаковки", Новый ОписаниеТипов("Строка"));
	ДанныеОтчета.Колонки.Добавить("ТекстОшибкиЗначениеШтрихкода", Новый ОписаниеТипов("Строка"));
	ДанныеОтчета.Колонки.Добавить("ТекстОшибкиЗначениеШтрихкодаУпаковки", Новый ОписаниеТипов("Строка"));
	
	ВидПродукции = Док1СРезультат.ВидПродукции;
	
	ПараметрыРазбора = Новый Структура;
	//Если флаг стоит, то из пула полные коды брать нельзя.
	ПараметрыРазбора.Вставить("ВосстанавливатьСтруктуруКодаМаркировки", Не ПараметрыСканирования.ПроверятьСтруктуруКодовМаркировки);
	ПараметрыРазбора.Вставить("ПроверятьАлфавитКодовМаркировки",        Ложь);
	
	Попытка
		РезультатОбработкиДанныхОтчета = ИО_ОбщийМодуль("РазборКодаМаркировкиИСОтчетПроизводственнойЛинии").НормализоватьДанныеОтчетаПроизводственнойЛинии(
			ДанныеОтчета, ВидПродукции, ПараметрыРазбора);
	Исключение
		РезультатОбработкиДанныхОтчета = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебный").НормализоватьДанныеОтчетаПроизводственнойЛинии(
			ДанныеОтчета, ВидПродукции, ПараметрыРазбора);
	КонецПопытки;
	
	Если РезультатОбработкиДанныхОтчета.ЕстьОшибки Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Некорректный формат данных отчета производственной линии'");
		Возврат Результат;
	КонецЕсли;
	
	КоличествоПотребительскихУпаковок = 0;
	
	КОпределениюВидаУпаковки = Новый Структура;
	КОпределениюВидаУпаковки.Вставить("GTIN",                  Новый Соответствие);
	КОпределениюВидаУпаковки.Вставить("ПараметрыСканирования", ПараметрыСканирования);

	Для Каждого СтрокаДанных Из РезультатОбработкиДанныхОтчета.ОбработанныеДанныеОтчета Цикл
		
		Для Каждого ИменаКолонок Из РезультатОбработкиДанныхОтчета.ГруппыКолонок Цикл
			
			ИсходнаяСтрока = СтрокаДанных.ИсходнаяСтрока;
			Если Не ЗначениеЗаполнено(ИсходнаяСтрока[ИменаКолонок.КодМаркировки]) Тогда
				Продолжить;
			КонецЕсли;
			
			ВидУпаковки = СтрокаДанных[ИменаКолонок.ВидУпаковки];
			GTIN        = СтрокаДанных[ИменаКолонок.GTIN];
			Если Не ЗначениеЗаполнено(ВидУпаковки) Тогда
				КОпределениюВидаУпаковки.GTIN.Вставить(GTIN, ИсходнаяСтрока[ИменаКолонок.НормализованныйКодМаркировки]);
				Продолжить;
			КонецЕсли;

			Если ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
				КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.КОпределениюВидаУпаковки = КОпределениюВидаУпаковки;
	Результат.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
	
	Возврат Результат;
	
КонецФункции

Функция ИСМП_ПараметрыОкончанияПроверки(СтруктураПараметров, ВидМаркируемойПродукции, ПодобраннаяМаркируемаяПродукция, ПроверкаЭлектронногоДокумента = Ложь)
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	ИСМП_ЗаполнитьСпецификуСрокиГодности(СтруктураПараметров, ВидМаркируемойПродукции);
	
	ТаблицаПодобраннойПровереннойПродукции = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаПодобраннойПровереннойПродукции();
	ТаблицаШтрихкодовВерхнегоУровня 	   = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаШтрихкодовВерхнегоУровня();
	
	Если СтруктураПараметров.ЗаполнитьСпецификуСрокиГодности Тогда
		ИСМП_ДополнитьКолонкамиМолочнойПродукции(ТаблицаПодобраннойПровереннойПродукции, СтруктураПараметров);
		ИСМП_ДополнитьКолонкамиМолочнойПродукции(ТаблицаШтрихкодовВерхнегоУровня, СтруктураПараметров);
	КонецЕсли;
	
	Если ТаблицаПодобраннойПровереннойПродукции.Колонки.Найти("ХарактеристикиИспользуются") = Неопределено Тогда	
		ТаблицаПодобраннойПровереннойПродукции.Колонки.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если ТаблицаПодобраннойПровереннойПродукции.Колонки.Найти("ИндексКодаМаркировки") = Неопределено Тогда	
		ТаблицаПодобраннойПровереннойПродукции.Колонки.Добавить("ИндексКодаМаркировки", Новый ОписаниеТипов("Число"));
	КонецЕсли;
		
	ПустаяХарактеристика = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры");
		
	СтруктураПараметров.Вставить("ЕстьРасхождения", Ложь);
		
	//Для каждого СтрокаДерева Из ТаблицаМаркированнойПродукцииИСМП Цикл
	Для каждого СтрокаДерева Из ПодобраннаяМаркируемаяПродукция Цикл // Попробуем заполнять отсюда, тут адекватнее данные
		
		НоваяСтрока = ТаблицаПодобраннойПровереннойПродукции.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		
		Если СтруктураПараметров.ЗаполнитьСпецификуСрокиГодности Тогда
			НоваяСтрока.СрокГодности = СтрокаДерева.ГоденДо;
		КонецЕсли;
			
		Если Не СтрокаДерева.ПроизвольнаяЕдиницаУчета Тогда
			НоваяСтрока.КоличествоПотребительскихУпаковок = 0;
		КонецЕсли;
		
		
		Если НЕ НоваяСтрока.Характеристика = ПустаяХарактеристика Тогда
			НоваяСтрока.ХарактеристикиИспользуются = Истина;
		КонецЕсли;
			
		Если НЕ НоваяСтрока.Количество = НоваяСтрока.КоличествоПодобрано Тогда
			СтруктураПараметров.Вставить("ЕстьРасхождения", Истина);
			
			НоваяСтрока.ИндексКодаМаркировки = 2;
		Иначе
			НоваяСтрока.ИндексКодаМаркировки = 1;
		КонецЕсли;
			
		//НоваяСтрока.Количество		  = СтрокаДерева.КоличествоУпаковок;
		//НоваяСтрока.КоличествоПодобрано = СтрокаДерева.КоличествоУпаковок;
		
	КонецЦикла;
		
	ПараметрыОкончанияПроверки = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПараметрыОкончанияПроверки();
	
	ПараметрыОкончанияПроверки.Вставить("ВидПродукцииИС",							ВидМаркируемойПродукции);
	ПараметрыОкончанияПроверки.Вставить("ПроверяемыйДокумент",						Док1СРезультат.Ссылка);
	ПараметрыОкончанияПроверки.Вставить("ПроверкаЭлектронногоДокумента",			ПроверкаЭлектронногоДокумента);
	ПараметрыОкончанияПроверки.Вставить("ТаблицаПодобраннойПровереннойПродукции",	ТаблицаПодобраннойПровереннойПродукции);
	ПараметрыОкончанияПроверки.Вставить("ТаблицаШтрихкодовВерхнегоУровня",			ТаблицаШтрихкодовВерхнегоУровня);
	
	Возврат ПараметрыОкончанияПроверки;

КонецФункции

// см. Обработка.ПроверкаИПодборПродукцииИСМП.МодульМенеджера.ЗафиксироватьРезультатПроверкиИПодбора
Процедура ИСМП_ЗаполнитьСпецификуСрокиГодности(СтруктураПараметров, ВидМаркируемойПродукции)
	
	ПроверяемыйДокумент = СтруктураПараметров.Док1СРезультат.Ссылка;
	
	ЕстьУточнениеСведенийОКодахМаркировкиИСМП = НЕ Метаданные.Документы.Найти("УточнениеСведенийОКодахМаркировкиИСМП") = Неопределено;
	
	ЗаполнитьСпецификуСрокиГодности = (ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.МаркировкаТоваровИСМП")
		Или ЕстьУточнениеСведенийОКодахМаркировкиИСМП И ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.УточнениеСведенийОКодахМаркировкиИСМП"))
		И ИСМП_ЭтоВидПродукцииСоСрокамиГодности(ВидМаркируемойПродукции);
	Если ЗаполнитьСпецификуСрокиГодности Тогда
		Если ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.МаркировкаТоваровИСМП") Тогда
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроверяемыйДокумент, "Операция, ОперацияНанесения");
			ОперацииМаркировки = ИО_ОбщийМодуль("ИнтеграцияИСМПСлужебныйКлиентСервер").ОперацииМаркировки(Реквизиты.Операция);
			ЗаполнитьСпецификуСрокиГодности =
				ОперацииМаркировки.ЭтоОперацияНанесения
				Или ЗначениеЗаполнено(Реквизиты.ОперацияНанесения)
				Или (ИСМП_ЭтоПродукцияВЕТИС(ВидМаркируемойПродукции)
					И ОперацииМаркировки.ТребуетсяЗаполнениеИдентификаторовПримененияВЕТИС);
		Иначе
			Попытка
				КорректировкаСведенийКМСрокГодностиВСД = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.КорректировкаСведенийКМСрокГодностиВСД");
				КорректировкаСведенийКМСрокГодности	= ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.КорректировкаСведенийКМСрокГодности");
			Исключение
				КорректировкаСведенийКМСрокГодностиВСД = Ложь;
				КорректировкаСведенийКМСрокГодности	= Ложь;	
			КонецПопытки;
			
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроверяемыйДокумент, "Операция");
			ЗаполнитьСпецификуСрокиГодности = Реквизиты.Операция = КорректировкаСведенийКМСрокГодностиВСД
				Или Реквизиты.Операция = КорректировкаСведенийКМСрокГодности;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.ПриемкаТоваровИСМП")
		Или ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.ОтгрузкаТоваровИСМП") Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроверяемыйДокумент, "Операция");
		
		Попытка
			ДоступенСрокГодностиПриПриемкеОтгрузке = ИО_ОбщийМодуль("ИнтеграцияИСМПСлужебныйКлиентСервер").ДоступенСрокГодностиПриПриемкеОтгрузке(
				Реквизиты.Операция, ВидМаркируемойПродукции);
		Исключение
			ДоступенСрокГодностиПриПриемкеОтгрузке = Ложь;
		КонецПопытки;
				
		Если ДоступенСрокГодностиПриПриемкеОтгрузке Тогда
			ЗаполнитьСпецификуСрокиГодности = Истина;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ЗаполнитьСпецификуСрокиГодности", ЗаполнитьСпецификуСрокиГодности);

КонецПроцедуры

// ОМ ПроверкаИПодборПродукцииИСМП.ДополнитьКолонкамиМолочнойПродукции
Процедура ИСМП_ДополнитьКолонкамиМолочнойПродукции(Таблица, СтруктураПараметров)
	
	Если Таблица.Колонки.Найти("ИдентификаторПроисхожденияВЕТИС") = Неопределено Тогда
		ОпределяемыйТип = ИО_ОпределяемыйТипПоИмениТипа("ИдентификаторПроисхожденияВЕТИС", СтруктураПараметров);
		Если НЕ ОпределяемыйТип = Неопределено Тогда
			Таблица.Колонки.Добавить("ИдентификаторПроисхожденияВЕТИС", ОпределяемыйТип.Тип);
		Иначе
			Таблица.Колонки.Добавить("ИдентификаторПроисхожденияВЕТИС");
		КонецЕсли;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СрокГодности") = Неопределено Тогда	
		Таблица.Колонки.Добавить("СрокГодности", Новый ОписаниеТипов("Дата"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ИСМП_ЗаполнитьШтрихкодыВерхнегоУровняСоСпецификой(СтрокиДерева, ТаблицаШтрихкодов, ЭтоВерхнийУровень = Истина)
	
	//Первый проход: заполнение признака общности упаковок (идентификатора ВЕТИС и срока годности для упаковки)
	Если ЭтоВерхнийУровень Тогда
		Для Каждого Строка Из СтрокиДерева Цикл
			ИСМП_ЗаполнитьПризнакиВЕТИСУпаковок(Строка);
		КонецЦикла;
	КонецЕсли;
	
	//Второй проход: заполнение верхнего уровня
	Для Каждого Строка Из СтрокиДерева Цикл
		Если ТипЗнч(Строка.ТипУпаковки) = Тип("ПеречислениеСсылка.ПрочиеЗоныПересчетаПродукцииИСМП") Тогда
			ИСМП_ЗаполнитьШтрихкодыВерхнегоУровняСоСпецификой(Строка.Строки, ТаблицаШтрихкодов, Истина);
			Продолжить;
		КонецЕсли;
		Если ЭтоВерхнийУровень Или ЗначениеЗаполнено(Строка.ГоденДо) Или ЗначениеЗаполнено(Строка.ИдентификаторПроисхожденияВЕТИС) Тогда
			НоваяСтрокаШтрихкод = ТаблицаШтрихкодов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаШтрихкод, Строка);
			НоваяСтрокаШтрихкод.СрокГодности = Строка.ГоденДо;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.ГоденДо)
			И Не ЗначениеЗаполнено(Строка.ИдентификаторПроисхожденияВЕТИС) Тогда
			ИСМП_ЗаполнитьШтрихкодыВерхнегоУровняСоСпецификой(Строка.Строки, ТаблицаШтрихкодов, Ложь);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ИСМП_ЗаполнитьПризнакиВЕТИСУпаковок(СтрокаУпаковок)
	
	Если СтрокаУпаковок.Строки.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаУпаковок.ТипУпаковки) = Тип("ПеречислениеСсылка.ПрочиеЗоныПересчетаПродукцииИСМП") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьОбщностьУпаковки = Неопределено;
	ИдентификаторПроисхожденияВЕТИС = Неопределено;
	ГоденДо = Неопределено;
	Для Каждого ВложеннаяСтрока Из СтрокаУпаковок.Строки Цикл
		ЕстьОбщностьУпаковкиСтроки = ИСМП_ЗаполнитьПризнакиВЕТИСУпаковок(ВложеннаяСтрока);
		Если Не ЕстьОбщностьУпаковкиСтроки Тогда
			ЕстьОбщностьУпаковки = Ложь;
		ИначеЕсли ЕстьОбщностьУпаковки = Неопределено Тогда
			ЕстьОбщностьУпаковки = Истина;
			ИдентификаторПроисхожденияВЕТИС = ВложеннаяСтрока.ИдентификаторПроисхожденияВЕТИС;
			ГоденДо = ВложеннаяСтрока.ГоденДо;
		Иначе
			ЕстьОбщностьУпаковки = ЕстьОбщностьУпаковки
				И ИдентификаторПроисхожденияВЕТИС = ВложеннаяСтрока.ИдентификаторПроисхожденияВЕТИС
				И ГоденДо = ВложеннаяСтрока.ГоденДо;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОбщностьУпаковки Тогда
		СтрокаУпаковок.ИдентификаторПроисхожденияВЕТИС = ИдентификаторПроисхожденияВЕТИС;
		СтрокаУпаковок.ГоденДо = ГоденДо;
	КонецЕсли;
	
	Возврат ЕстьОбщностьУпаковки;
	
КонецФункции

