Функция ПолучитьТолькоЦифры(Знач СтрокаПроверки)
	Если ТипЗнч(СтрокаПроверки) <> Тип("Строка") Тогда
		Возврат СтрокаПроверки;
	КонецЕсли;
	
	СтрокаПроверки = СокрЛП(СтрокаПроверки);
	Длина = СтрДлина(СтрокаПроверки);
	СтрокаИтог = "";
	
	Для а = 1 По Длина Цикл
		Цифра = Сред(СтрокаПроверки, а, 1);
		Если Найти("0123456789", Цифра) > 0 Тогда
			СтрокаИтог = СтрокаИтог + Цифра;
		КонецЕсли; 
	КонецЦикла;
	
	Возврат СтрокаИтог;
КонецФункции

Процедура ПроверитьЗаполнениеСтроки(НоваяСтрока, СтрокаДерева, Параметры = Неопределено)
	
	//если монотоварная упаковка, установим Номенклатура = первая строка марки
	Если СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка") 
			И СтрокаДерева.Строки.Количество() > 0
			И Не ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			
		НоваяСтрока.Номенклатура = СтрокаДерева.Строки[0].Номенклатура
	КонецЕсли;
	
КонецПроцедуры

Функция СсылкаСуществует(ПроверяемаяСсылка)
	            
	ТекстЗапроса = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	[ИмяТаблицы]
	|ГДЕ
	|	Ссылка = &Ссылка
	|";
	
	ИмяТаблицыПоСсылке = ПроверяемаяСсылка.Метаданные().ПолноеИмя();
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ИмяТаблицы]", ИмяТаблицыПоСсылке);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ПроверяемаяСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ИО_ВидЦены(СтруктураПараметров)
	
	ИдентификаторыГП 	= УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
	ВидЦеныПоУмолчанию 	= ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ВидЦеныПереоценка"), СтруктураПараметров);	
	
	Если ЗначениеЗаполнено(ВидЦеныПоУмолчанию) Тогда
		Возврат ВидЦеныПоУмолчанию;
	КонецЕсли;
	
	ВидЦеныПоУмолчанию = Справочники["ВидыЦен"].ВидЦеныПоУмолчанию(Неопределено);
		
	Если ВидЦеныПоУмолчанию.Пустая() Тогда		
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВидыЦен.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ВидыЦен КАК ВидыЦен
			|ГДЕ
			|	НЕ ВидыЦен.ПометкаУдаления";
		
		Выборка = Запрос.Выполнить().Выбрать();				
		
		Если Выборка.Следующий() Тогда
			ВидЦеныПоУмолчанию = Выборка.Ссылка;	
		КонецЕсли;	
		
	КонецЕсли;	

	Возврат ВидЦеныПоУмолчанию;
	
КонецФункции

Функция ИО_ЗначениеГлобальногоПараметра(ГлобальныйПараметр, СтруктураПараметров)
	
	ЗначениеПараметра = Неопределено;
	
	Если СтруктураПараметров.Свойство("ЗначенияПараметров") И ТипЗнч(СтруктураПараметров.ЗначенияПараметров) = Тип("Массив") Тогда
		ГлобальныеПараметры = СтруктураПараметров.ЗначенияПараметров;
	Иначе
		ГлобальныеПараметры = СтруктураПараметров.ТекущиеНастройкиMS.ГлобальныеПараметры;
	КонецЕсли;
	
	Использование = Истина;
	Если ТипЗнч(СтруктураПараметров.ТекущиеНастройкиMS.ЗначенияПараметровУзлов) = Тип("Массив") Тогда
		ГлобальныеПараметры = СтруктураПараметров.ТекущиеНастройкиMS.ЗначенияПараметровУзлов;
		Использование = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда
		Для Каждого ЭлементГП Из ГлобальныеПараметры Цикл
			Если ЭлементГП.Свойство("ЭтоТаблицаЗначений") И ЭлементГП.ЭтоТаблицаЗначений Тогда Продолжить; КонецЕсли;
			Если (Использование Или ЭлементГП.Использование) 
				И Найти(ЭлементГП.Наименование, ГлобальныйПараметр) > 0
				И ЗначениеЗаполнено(ЭлементГП.Значение) И СсылкаСуществует(ЭлементГП.Значение) Тогда
				
				ЗначениеПараметра = ЭлементГП.Значение;
				Прервать;
			КонецЕсли;					
		КонецЦикла;	
	КонецЕсли;

	Возврат ЗначениеПараметра;
	
КонецФункции

Функция ИО_ЗначениеГлобальногоПараметраПоID(ID_ГлобальногоПараметра, СтруктураПараметров)
	
	ЗначениеПараметра = Неопределено;
	
	Если СтруктураПараметров.Свойство("ЗначенияПараметров") И ТипЗнч(СтруктураПараметров.ЗначенияПараметров) = Тип("Массив") Тогда
		ГлобальныеПараметры = СтруктураПараметров.ЗначенияПараметров;
	Иначе
		ГлобальныеПараметры = СтруктураПараметров.ТекущиеНастройкиMS.ГлобальныеПараметры;
	КонецЕсли;
	
	Если ТипЗнч(ГлобальныеПараметры) <> Тип("Массив") И ТипЗнч(ГлобальныеПараметры) <> Тип("ТаблицаЗначений") Тогда 
		Возврат ЗначениеПараметра;	
	КонецЕсли;	
	
	Использование = Истина;
	Если ТипЗнч(СтруктураПараметров.ТекущиеНастройкиMS.ЗначенияПараметровУзлов) = Тип("Массив") Тогда
		ГлобальныеПараметры = СтруктураПараметров.ТекущиеНастройкиMS.ЗначенияПараметровУзлов;
		Использование = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда
		Для Каждого ЭлементГП Из ГлобальныеПараметры Цикл
			Если ЭлементГП.Свойство("ЭтоТаблицаЗначений") И ЭлементГП.ЭтоТаблицаЗначений Тогда Продолжить; КонецЕсли;
			Если (Использование Или ЭлементГП.Использование) Тогда 
				Если ТипЗнч(ID_ГлобальногоПараметра) = Тип("Строка") И ЭлементГП.ID_Параметра = ID_ГлобальногоПараметра
					ИЛИ ТипЗнч(ID_ГлобальногоПараметра) = Тип("Массив") И ID_ГлобальногоПараметра.Найти(ЭлементГП.ID_Параметра) <> Неопределено Тогда
				
					ЗначениеПараметра = ЭлементГП.Значение;
					Прервать;
				КонецЕсли;
			КонецЕсли;					
		КонецЦикла;
	КонецЕсли;

	Возврат ЗначениеПараметра;
	
КонецФункции

Функция ИО_ОпределяемыйТипПоИмениТипа(ИмяОпределяемогоТипа, СтруктураПараметров)
	
	ОпределяемыеТипы = Метаданные.ОпределяемыеТипы;
	Если ОпределяемыеТипы.Количество() = 0 Тогда
		// В некоторых конфигурациях (например, УТ 10.3) определяемых типов нет в дереве метаданных
		Попытка                     		
			ПараметрыАлгоритма = Новый Структура; 
			Если СтруктураПараметров <> Неопределено И СтруктураПараметров.Свойство("ИмяМодуляБезопасногоРежима") Тогда
				ПараметрыАлгоритма.Вставить("ИмяОбщегоМодуля", 	СтруктураПараметров.ИмяМодуляБезопасногоРежима);
			КонецЕсли;			

			ОпределяемыеТипы = ГлЯдро_ВычислитьВБезопасномРежиме("ОпределяемыеТипы()", ПараметрыАлгоритма).Результат;
			Если ОпределяемыеТипы = Неопределено Тогда
				ОпределяемыеТипы = Метаданные.ОпределяемыеТипы;
			КонецЕсли;	
		Исключение КонецПопытки;
	КонецЕсли;
	
	ОпределяемыйТип = Неопределено;
	
	Если ТипЗнч(ОпределяемыеТипы) = Тип("КоллекцияОбъектовМетаданных")
		И ОпределяемыеТипы.Найти(ИмяОпределяемогоТипа) <> Неопределено Тогда
		ОпределяемыйТип = ОпределяемыеТипы[ИмяОпределяемогоТипа];
	ИначеЕсли ТипЗнч(ОпределяемыеТипы) = Тип("ФиксированнаяСтруктура")
		И ОпределяемыеТипы.Свойство(ИмяОпределяемогоТипа) Тогда
		ОпределяемыйТип = ОпределяемыеТипы[ИмяОпределяемогоТипа];
	КонецЕсли;		
		
	Возврат ОпределяемыйТип;	
	
КонецФункции

