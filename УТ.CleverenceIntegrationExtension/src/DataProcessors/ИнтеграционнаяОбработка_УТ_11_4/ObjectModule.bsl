Процедура УТ_11_4_ПроверитьСерииВСтрокеТабличнойЧасти		(СтруктураПараметров) Экспорт

	Перем ИдСерии;

	СтрокаДокумента = СтруктураПараметров.СтрокаДокумента;
	
	ЯзыкПлатформыMS = ?(СтрокаДокумента.Свойство("ИдТовара"), "RU", "EN");
	Если ЯзыкПлатформыMS = "RU" Тогда
		ИмяПоляИдТовара = "ИдТовара";
		ИмяПоляИдСерии	= "ИдСерии";
		ИмяПоляИмяСерии	= "ИмяСерии";
		ИмяПоляСН		= "СН";
	Иначе
		ИмяПоляИдТовара = "ProductId";
		ИмяПоляИдСерии	= "SeriesId";
		ИмяПоляИмяСерии	= "SeriesName";
		ИмяПоляСН		= "SN";
	КонецЕсли;
	
	Если СтрокаДокумента.Свойство(ИмяПоляИдСерии, ИдСерии) И ЗначениеЗаполнено(ИдСерии) Тогда
		Попытка
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаДокумента[ИмяПоляИдТовара]));

			УчетПоСерийнымНомерам = Номенклатура.ВидНоменклатуры.ИспользоватьСерии
				И Номенклатура.ВидНоменклатуры.НастройкаИспользованияСерий = ПредопределенноеЗначение("Перечисление.НастройкиИспользованияСерийНоменклатуры.ЭкземплярТовара");
		Исключение
			УчетПоСерийнымНомерам = Ложь;
		КонецПопытки;

		Если УчетПоСерийнымНомерам Тогда
			СтрокаДокумента.Вставить(ИмяПоляИдСерии,  "");
			СтрокаДокумента.Вставить(ИмяПоляИмяСерии, "");
			
			Попытка
				СтрокаДокумента.Вставить(ИмяПоляСН, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСерии)), "Номер"));
			Исключение
		    	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьСерииВСтрокеТабличнойЧасти", "Ошибка",
					"Не удалось получить номер серии: " + Строка(ИдСерии) + ". Причина: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		    КонецПопытки;
		КонецЕсли;
		
		УдаляемыеРеквизиты = Новый Массив;
		УдаляемыеРеквизиты.Добавить("ИдСерииТовара");
		УдаляемыеРеквизиты.Добавить("ИмяСерииТовара");
		УдаляемыеРеквизиты.Добавить("КоличествоСерииТовара");

		Для каждого УдаляемыйРеквизит ИЗ УдаляемыеРеквизиты Цикл
			Если СтрокаДокумента.Свойство(УдаляемыйРеквизит) Тогда
				СтрокаДокумента.Удалить(УдаляемыйРеквизит);
			КонецЕсли;           
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
	
