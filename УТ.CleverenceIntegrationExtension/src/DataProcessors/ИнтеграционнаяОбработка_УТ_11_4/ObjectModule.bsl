		//	Выполнить("	
		//|Док1СРезультат.Склад = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Док1СРезультат.Склад);
		//|Док1СРезультат.Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Док1СРезультат.Организация);");
	    Док1СРезультат.Склад = ИО_ОбщийМодуль("ЗначениеНастроекПовтИсп").ПолучитьСкладПоУмолчанию(Док1СРезультат.Склад);
		Док1СРезультат.Организация = ИО_ОбщийМодуль("ЗначениеНастроекПовтИсп").ПолучитьОрганизациюПоУмолчанию(Док1СРезультат.Организация);

		КонецЕсли;		                         
	КонецЕсли;

