	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ТекущаяСтрока = СтруктураПараметров.СтрокаДокумента;
	
	СтруктураДействий = Новый Структура;
	
	Если ДобавленаНоваяСтрока Тогда
	
		СтруктураПроверкиСопоставленнойНоменклатурыПоставщика = ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруПроверкиСопоставленнойНоменклатурыПоставщикаВСтрокеТЧ(Док1СРезультат, Истина);
		СтруктураДействий.Вставить("ЗаполнитьНоменклатуруПартнераПоНоменклатуре", Док1СРезультат.Партнер);
		СтруктураДействий.Вставить("ПроверитьСопоставленнуюНоменклатуруПартнера", СтруктураПроверкиСопоставленнойНоменклатурыПоставщика);
		
		// Для совместимости с предыдущими релизами
		СтруктураДействий.Вставить("ЗаполнитьНоменклатуруПоставщикаПоНоменклатуре", Док1СРезультат.Партнер);
		СтруктураДействий.Вставить("ПроверитьСопоставленнуюНоменклатуруПоставщика", СтруктураПроверкиСопоставленнойНоменклатурыПоставщика);
	
