Процедура ИСМП_ЗаполнитьТЧКодыМаркировки(СтруктураПараметров, ТаблицаМаркированнойПродукцииИСМП)
	
	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;
	Товары			= Док1СРезультат.Товары;
	КодыМаркировки	= Док1СРезультат.ДанныеОтчетаПроизводственнойЛинии;
	
	ИСМП_ЗаполнитьДанныеОтчетаПроизводственнойЛинии(СтруктураПараметров);
	
	Товары.Очистить();
	
	// Товары
	
	РеквизитыТабличнойЧасти = Док1СРезультат.Метаданные().ТабличныеЧасти.ДанныеОтчетаПроизводственнойЛинии.Реквизиты;	
	ЕстьКолонкаФорматBase64 = РеквизитыТабличнойЧасти.Найти("ФорматBase64") <> Неопределено;
	
	ТоварыКоробки = ТаблицаМаркированнойПродукцииИСМП.Скопировать(, "ШтрихкодПачки, ПолныйКодМаркировки, ШтрихкодКоробки");
	ТоварыКоробки.Свернуть("ШтрихкодПачки, ПолныйКодМаркировки, ШтрихкодКоробки");
	
	Для каждого ТекСтрока ИЗ ТоварыКоробки Цикл
	    НоваяСтрока = КодыМаркировки.Добавить();
		Если ЕстьКолонкаФорматBase64 И ЗначениеЗаполнено(ТекСтрока.ПолныйКодМаркировки) Тогда
			НоваяСтрока.ЗначениеШтрихкода 			= ТекСтрока.ПолныйКодМаркировки;
			НоваяСтрока.ЗначениеШтрихкодаУпаковки 	= ТекСтрока.ШтрихкодКоробки;
			НоваяСтрока.ФорматBase64				= Истина;
		Иначе
			НоваяСтрока.ЗначениеШтрихкода 			= ТекСтрока.ШтрихкодПачки;
			НоваяСтрока.ЗначениеШтрихкодаУпаковки 	= ТекСтрока.ШтрихкодКоробки;
		КонецЕсли;
	КонецЦикла;	
	
	// Коробки
	
	КоробкиПалеты = ТаблицаМаркированнойПродукцииИСМП.Скопировать(, "ШтрихкодКоробки, ШтрихкодПалеты");
	КоробкиПалеты.Свернуть("ШтрихкодКоробки, ШтрихкодПалеты");
	
	Для каждого ТекСтрока ИЗ КоробкиПалеты Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ШтрихкодПалеты) Тогда
			Продолжить;
		КонецЕсли;	
			
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.ЗначениеШтрихкода 			= ТекСтрока.ШтрихкодКоробки;
		НоваяСтрока.ЗначениеШтрихкодаУпаковки 	= ТекСтрока.ШтрихкодПалеты;
	КонецЦикла;
	
	ИСМП_ЗаполнитьКоличествоПоДаннымОтчетаПроизводственнойЛинии(СтруктураПараметров)
	
КонецПроцедуры

Процедура ИСМП_СохранитьКодыМаркировкиВПул(ТаблицаДляСохраненияВПул, СтруктураПараметров)

	Если НЕ ТаблицаДляСохраненияВПул.Количество() Тогда
		Возврат;	
	КонецЕсли;
	
	Организация = СтруктураПараметров.Док1СРезультат.Организация;
	Статус 		= ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Неопределен");
	
	// Существующие записи перезаписывать не нужно
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки
	               |ИЗ
	               |	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	               |ГДЕ
	               |	ПулКодовМаркировкиСУЗ.КодМаркировки В(&КодыМаркировки)";
    Запрос.УстановитьПараметр("КодыМаркировки", ТаблицаДляСохраненияВПул.ВыгрузитьКолонку("КодМаркировки"));
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		НайденныеСтроки = ТаблицаДляСохраненияВПул.НайтиСтроки(Новый Структура("КодМаркировки", Выборка.КодМаркировки));
        Для каждого НайденнаяСтрока ИЗ НайденныеСтроки Цикл
			ТаблицаДляСохраненияВПул.Удалить(НайденнаяСтрока);		
		КонецЦикла;
	КонецЦикла;
	
	Если НЕ ТаблицаДляСохраненияВПул.Количество() Тогда
		Возврат;	
	КонецЕсли;
	
	// Проверяем, сколько на текущий момент записей в пуле кодов маркировки
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
	                      |ИЗ
	                      |	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ");
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		КоличествоЗаписей = Выборка.КоличествоЗаписей;
	Иначе
		КоличествоЗаписей = 10000;
	КонецЕсли;
	
	ИспользоватьНаборЗаписей = КоличествоЗаписей < 10000;
	Если ИспользоватьНаборЗаписей Тогда
	    НаборЗаписей = РегистрыСведений["ПулКодовМаркировкиСУЗ"].СоздатьНаборЗаписей();
		НаборЗаписей.Прочитать();
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого СтрокаТаблицы ИЗ ТаблицаДляСохраненияВПул Цикл
		НоваяЗапись = ?(ИспользоватьНаборЗаписей, НаборЗаписей.Добавить(), РегистрыСведений["ПулКодовМаркировкиСУЗ"].СоздатьМенеджерЗаписи());
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаТаблицы);
		НоваяЗапись.ХешСуммаКодаМаркировки 	= ИО_ОбщийМодуль("ИнтеграцияИС").ХешированиеДанныхSHA256(СтрокаТаблицы.КодМаркировки);
		НоваяЗапись.Организация 			= Организация;
		НоваяЗапись.ДатаПечатиУниверсальная = ТекущаяУниверсальнаяДата();
		НоваяЗапись.Статус					= Статус;
		
		Если НЕ ИспользоватьНаборЗаписей Тогда
			Попытка
				НоваяЗапись.Записать();
			Исключение
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИСМП_СохранитьКодыМаркировкиВПул", "Ошибка", ТекстОшибки);		
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Если ИспользоватьНаборЗаписей Тогда
	    Попытка
			НаборЗаписей.Записать();
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИСМП_СохранитьКодыМаркировкиВПул", "Ошибка", ТекстОшибки);		
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

