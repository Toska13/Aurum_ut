// Вызывается при загрузке строки табличной части Товары документа РеализацияТоваровУслуг из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура                  - содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Структура          - содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - СтрокаТаблицыЗначений       - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтрокаТабличнойЧастиДокументаТСД - Структура  - содержит данные загружаемой строки документа Mobile Smarts
//		* СтруктураПоискаКлючаСвязи - Структура         - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_РеализацияТоваровУслуг_ПослеЗаполненияСтрокиТЧ_Товары	(СтруктураПараметров) Экспорт

	ИмяСобытия = "УТ_11_2_РеализацияТоваровУслуг_ПослеЗаполненияСтрокиТЧ_Товары";
	
	ДобавленаНоваяСтрока = НЕ УТ_11_2_Общий_ПослеЗаполненияСтрокиТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ТекущаяСтрока = СтруктураПараметров.СтрокаДокумента;		
	
	Если ДобавленаНоваяСтрока Тогда
		
		СтруктураДействий = Новый Структура;
		
		// При создании строки РТУ на основании ЗаказаКлиента необходимо корректно переносить произвольные цены
		СтруктураЦеныОснования = ПроверитьНаличиеПроизвольнойЦеныВДокументеОсновании(СтруктураПараметров);
		
		СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Док1СРезультат, Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовЗакупки(Док1СРезультат.Склад)));
		
		Если Не СтруктураЦеныОснования.ПроизвольнаяЦена Тогда
			Если Не ЗначениеЗаполнено(СтруктураЦеныОснования.СтрокаЗаказа) Тогда
				УТ_11_2_ЗаполнитьЦенуВСтрокеТабличнойЧасти(СтруктураПараметров, ДобавленаНоваяСтрока,, "Отгрузка");
			Иначе
				// Если основание ЗаказКлиента проставим его в новой строке
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураЦеныОснования.СтрокаЗаказа, "ВидЦены, Цена");
				Если ТекущаяСтрока.Упаковка <> СтруктураЦеныОснования.СтрокаЗаказа.Упаковка Тогда
					Попытка
						СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПараметрыЗаполненияЦеныВСтрокеТЧ(Док1СРезультат));
					Исключение
						СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруЗаполненияЦеныВСтрокеТЧ(Док1СРезультат));
					КонецПопытки;
				КонецЕсли;
				
				ТекущаяСтрока.ЗаказКлиента = СтруктураПараметров.Док1СОснование;				
			КонецЕсли;
		Иначе
			// Если в заказе клиента стоит произвольная цена, не заполняем ее типовыми методами, а просто переносим
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураЦеныОснования.СтрокаЗаказа, "Цена");
			
			Если ЗначениеЗаполнено(СтруктураЦеныОснования.СтрокаЗаказа)
				И ТекущаяСтрока.Упаковка <> СтруктураЦеныОснования.СтрокаЗаказа.Упаковка Тогда
				Попытка
					КэшированныеЗначения = ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьСтруктуруКэшируемыеЗначения();
					КоэффициентПлан = ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьКоэффициентУпаковки(СтруктураЦеныОснования.СтрокаЗаказа.Упаковка, КэшированныеЗначения, ТекущаяСтрока.Номенклатура).Коэффициент;
					КоэффициентФакт = ИО_ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер").ПолучитьКоэффициентУпаковки(ТекущаяСтрока.Упаковка, КэшированныеЗначения, ТекущаяСтрока.Номенклатура).Коэффициент;
					
					КоэффициентПлан = ?(КоэффициентПлан = 0, 1, КоэффициентПлан);
					КоэффициентФакт = ?(КоэффициентФакт = 0, 1, КоэффициентФакт);
					ТекущаяСтрока.Цена = Окр(ТекущаяСтрока.Цена / КоэффициентПлан * КоэффициентФакт, 2, РежимОкругления.Окр15как20);
				Исключение	
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;	
		КонецЕсли;
		
		УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Новый Структура("ДатаОтгрузки", Док1СРезультат.Дата));	
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается при загрузке табличной части Товары документа РеализацияТоваровУслуг из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - Неопределено                - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_РеализацияТоваровУслуг_ПослеЗаполненияТЧ_Товары		(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ТабличнаяЧасть = СтруктураПараметров.ТЧ;
	
	// Обработка строк ТЧ
	СтруктураПересчетаСуммы = УТ_11_4_СтруктураПересчетаСуммыНДСВСтрокеТЧ(Док1СРезультат);
	СтруктураЗаполненияСтавкиНДС = УТ_11_4_СтруктураЗаполненияСтавкиНДС(СтруктураПараметров);
	
	Для каждого ТекущаяСтрока ИЗ ТабличнаяЧасть Цикл
		СтруктураДействий = Новый Структура;
		
		Если ТекущаяСтрока.СтавкаНДС.Пустая() Тогда
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", СтруктураЗаполненияСтавкиНДС);
		КонецЕсли;
		
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", 				Док1СРезультат.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары", 			Док1СРезультат.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", 							СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", 							СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", 			Новый Структура("Очищать", Ложь)); // см.модуль объекта РеализацияТоваровУслуг - ЗаполнитьУсловияПродажПоУмолчанию()
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", 	Новый Структура("Очищать", Ложь));
		СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
		СтруктураДействий.Вставить("ПересчитатьСуммуСверхЗаказа", 					Новый Структура("РеализацияПоступлениеПоЗаказу, ТребуетсяЗалогЗаТару",
			Док1СРезультат.РеализацияПоЗаказам, Док1СРезультат.ТребуетсяЗалогЗаТару));
		СтруктураДействий.Вставить("ПроверитьЗаполнитьНазначение", 					ТекущаяСтрока.Назначение);	
			
		УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Новый Структура("ДатаОтгрузки", Док1СРезультат.Дата));
	КонецЦикла;
	//
	
	УТ_11_4_ИСМП_Товары_ПослеЗаполненияТЧ(СтруктураПараметров);

