Функция ПолучитьЗначениеФункциональногоПараметраЗапросИнформацииПоКМ() Экспорт
	
	ИмяСобытия = "ПолучитьЗначениеФункциональногоПараметраЗапросИнформацииПоКМ";
	
	Попытка
		Возврат ИО_ОбщийМодуль("ОбщегоНазначенияИСМП").ИспользуетсяМаркируемаяПродукция();
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Возврат ИО_ОбщийМодуль("ИнтеграцияИСМП").ИспользуетсяМаркируемаяПродукция();
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ЗапросИнформацииПоКМ = ПолучитьФункциональнуюОпциюНаСервере("ВестиУчетМаркируемойПродукцииИСМП");
		
		Если ЗапросИнформацииПоКМ = Неопределено Тогда
			ЗапросИнформацииПоКМ = Ложь;		
		КонецЕсли;
		
		Возврат ЗапросИнформацииПоКМ;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Ложь;

КонецФункции

Функция ПолучитьЗначениеФункциональногоПараметраРедактированиеЯчеекСпрСклад() Экспорт
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	Если НЕ МетаданныеНСИ.Свойство("СпрЯчейки") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ЭтотОбъект.ПолучитьМакет("Склады");
	СхемаКомпоновкиДанных.НаборыДанных.Склады.Запрос = СтрЗаменить(СхемаКомпоновкиДанных.НаборыДанных.Склады.Запрос, "//%ПЕРВЫЕ_N%", "ПЕРВЫЕ 1");
	
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	СправочноеПоле = Новый ПолеКомпоновкиДанных("Справочный");
	ПолеНайдено = Ложь;
	
	Для каждого СтруктураПоля Из Настройки.Выбор.Элементы Цикл
		Если СтруктураПоля.Поле = СправочноеПоле И СтруктураПоля.Использование Тогда
			ПолеНайдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ПолеНайдено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Настройки.Выбор.Элементы.Очистить();
	ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = СправочноеПоле;
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= Новый ПолеКомпоновкиДанных("ЭтоПапка");
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= Ложь;  
	
	НовыйЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение  	= СправочноеПоле;
	НовыйЭлементОтбора.Использование  	= Истина;
	НовыйЭлементОтбора.ВидСравнения   	= ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.ПравоеЗначение 	= Истина;  
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаЗначений = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТаблицаЗначений.Количество() > 0;
	
КонецФункции 

