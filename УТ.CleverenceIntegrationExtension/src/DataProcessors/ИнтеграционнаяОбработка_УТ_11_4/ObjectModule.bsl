// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ПриходныйОрдерНаТовары_ПередЗаполнениемДокумента		(СтруктураПараметров) Экспорт

    // Не нужно вызывать общий обработчик, т.к. в "ОбработкаЗаполнения" модуля документа будет вызвано исключение
    
	ИмяСобытия = "УТ_11_2__ПриходныйОрдерНаТовары_ПередЗаполнениемДокумента";
		
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("СоздаемНовыеШтрихкодыИСоздаемНовыйТовар","СоздатьНовыеШтрихкоды(СтруктураПараметров)");
	
	ВыполнитьКаждыйОбработчикИзСтруктурыДействий(СтруктураПараметров, СтруктураДействий, ИмяСобытия);	
	
	Док1СРезультат 			= СтруктураПараметров.Док1СРезультат;
	Док1СОснование 			= СтруктураПараметров.Док1СОснование;
	
    Если Док1СРезультат.ЭтоНовый() Тогда
        
	    РеквизитыШапкиОснования = Док1СОснование.Метаданные().Реквизиты;	
    
		Если Док1СОснование <> Неопределено И Док1СРезультат <> Док1СОснование Тогда
			
			ДанныеЗаполнения = Новый Структура;
			
			ДанныеЗаполнения.Вставить("Распоряжение",               Док1СОснование.Ссылка);
			ДанныеЗаполнения.Вставить("Склад",                      ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "Склад"), 						Док1СОснование.Склад, 						Неопределено));
			ДанныеЗаполнения.Вставить("Помещение",                  ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "Помещение"), 					Док1СОснование.Помещение, 					Неопределено));			
			ДанныеЗаполнения.Вставить("ДатаПоступления",            ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "ДатаПоступления"), 				Док1СОснование.ДатаПоступления, 			Неопределено));
			ДанныеЗаполнения.Вставить("ЗонаПриемки",                ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "ЗонаПриемки"), 					Док1СОснование.ЗонаПриемки, 				Неопределено));
			ДанныеЗаполнения.Вставить("СкладскаяОперация",          ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "СкладскаяОперация"), 			Док1СОснование.СкладскаяОперация, 			Неопределено));
			ДанныеЗаполнения.Вставить("Отправитель",                ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "Партнер"), 						Док1СОснование.Партнер, 					Неопределено));
			ДанныеЗаполнения.Вставить("ЗакрыватьГрафикПоступления", ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "ЗакрыватьГрафикПоступления"), 	Док1СОснование.ЗакрыватьГрафикПоступления, 	Неопределено));
			ДанныеЗаполнения.Вставить("ДатаВходящегоДокумента",     ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "ДатаВходящегоДокумента"), 		Док1СОснование.ДатаВходящегоДокумента, 		Неопределено));
			ДанныеЗаполнения.Вставить("НомерВходящегоДокумента",    ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "НомерВходящегоДокумента"), 		Док1СОснование.НомерВходящегоДокумента, 	Неопределено));
			ДанныеЗаполнения.Вставить("ХозяйственнаяОперация",      ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "ХозяйственнаяОперация"), 		Док1СОснование.ХозяйственнаяОперация, 		Неопределено));			
			ДанныеЗаполнения.Вставить("Организация",                ?(ЕстьРеквизитВКоллекции(РеквизитыШапкиОснования, "Организация"), 					Док1СОснование.Организация, 				Неопределено));	
			
			Док1СРезультат.Заполнить(ДанныеЗаполнения);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	///
	Склад = Неопределено;
	Если Док1СОснование <> Неопределено Тогда
		Если Док1СОснование.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
			Склад = Док1СОснование.Склад;
		ИначеЕсли Док1СОснование.Метаданные().Реквизиты.Найти("СкладОтправитель") <> Неопределено Тогда
			Склад = Док1СОснование.СкладОтправитель;
		КонецЕсли;
		
		Если Склад.ЭтоГруппа И СтруктураПараметров.ДанныеДляЗагрузки_Шапка.Склад <> Склад Тогда
			Склад = СтруктураПараметров.ДанныеДляЗагрузки_Шапка.Склад;
			Док1СРезультат.Склад = Склад;		
		КонецЕсли;
	КонецЕсли;

	
	Если ЗначениеЗаполнено(Док1СРезультат.Склад) Тогда
		Если Док1СРезультат.Склад.ЭтоГруппа Тогда
			Док1СРезультат.Склад = Неопределено;
			Склад = Неопределено; 
		КонецЕсли;
	КонецЕсли;

    
КонецПроцедуры 

