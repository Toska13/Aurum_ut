Процедура ЗаполнитьКонтрагентаПартнера(СтруктураПараметров)
	
	ИдКонтрагента = Неопределено;
	
	// если в документе тсд нет контрагента
	Если Не СтруктураПараметров.ДанныеДокументаMS.ШапкаДокумента.Свойство("ИдКонтрагента", ИдКонтрагента) или Не ЗначениеЗаполнено(ИдКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	
	Документ1С = СтруктураПараметров.Док1СРезультат;
	МетаданныеДокумента = Документ1С.Метаданные();	
	РеквизитыШапки 	= МетаданныеДокумента.Реквизиты;		
	ЕстьКонтрагент = ЕстьРеквизитВКоллекции(РеквизитыШапки, "Контрагент");
	ЕстьПартнер = ЕстьРеквизитВКоллекции(РеквизитыШапки, "Партнер");
	КонтрагентЗаполнен = ЕстьКонтрагент и ЗначениеЗаполнено(Документ1С.Контрагент) и Документ1С.Контрагент.ПолучитьОбъект() <> Неопределено;
	ПартнерЗаполнен = ЕстьПартнер и ЗначениеЗаполнено(Документ1С.Партнер) и Документ1С.Партнер.ПолучитьОбъект() <> Неопределено;
	
	Если (Не ЕстьКонтрагент или КонтрагентЗаполнен) и (Не ЕстьПартнер или ПартнерЗаполнен) Тогда		
		Возврат;		
	КонецЕсли;
	
	КонтрагентПартнер = НайтиСсылкуПоУИД(ИдКонтрагента);
	ЭтоКонтрагент = ТипЗнч(КонтрагентПартнер) = Тип("СправочникСсылка.Контрагенты");
	ЭтоПартнер = ТипЗнч(КонтрагентПартнер) = Тип("СправочникСсылка.Партнеры");
	
	Если ЕстьКонтрагент и Не КонтрагентЗаполнен Тогда
		
		Если ЭтоКонтрагент Тогда
			Документ1С.Контрагент = КонтрагентПартнер;			
		ИначеЕсли ЭтоПартнер Тогда
			Контрагент = НайтиКонтрагентаВИерархииПартнера(КонтрагентПартнер);
			Если ЗначениеЗаполнено(Контрагент) Тогда
				Документ1С.Контрагент = Контрагент;				
			КонецЕсли;
		КонецЕсли;
		
		КонтрагентЗаполнен = ЗначениеЗаполнено(Документ1С.Контрагент); 
		
	КонецЕсли;
	
	Если ЕстьПартнер и Не ПартнерЗаполнен Тогда
		
		Если ЭтоПартнер Тогда
			Документ1С.Партнер = КонтрагентПартнер;			
		ИначеЕсли ЭтоКонтрагент Тогда
			Документ1С.Партнер = КонтрагентПартнер.Партнер;						
		КонецЕсли;
		
		ПартнерЗаполнен = ЗначениеЗаполнено(Документ1С.Партнер);
		
	КонецЕсли;	
	
	Если ЕстьКонтрагент и Не КонтрагентЗаполнен и ЕстьПартнер и ПартнерЗаполнен Тогда
		Контрагент = НайтиКонтрагентаВИерархииПартнера(Документ1С.Партнер);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Документ1С.Контрагент = Контрагент;
		КонецЕсли;
		
		КонтрагентЗаполнен = ЗначениеЗаполнено(Документ1С.Контрагент);
		
	КонецЕсли;

	Если ЕстьПартнер и Не ПартнерЗаполнен и ЕстьКонтрагент и КонтрагентЗаполнен Тогда
		Документ1С.Партнер = Документ1С.Контрагент.Партнер;		
	КонецЕсли;	
	
КонецПроцедуры

Функция НайтиСсылкуПоУИД(Ид)
	
	// пытаемся восстановить из идентификатора. 
	Попытка
		УИД = Новый УникальныйИдентификатор(Ид);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Ссылка = Справочники.Контрагенты.ПолучитьСсылку(УИД);
	
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Ссылка = Справочники.Партнеры.ПолучитьСсылку(УИД);
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Ссылка = Неопределено;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Ссылка;
	
КонецФункции

Функция НайтиКонтрагентаВИерархииПартнера(Партнер)

	Контрагент = Неопределено;
	Родитель = Партнер;
	
	Пока ЗначениеЗаполнено(Родитель) и Контрагент = Неопределено Цикл
		Контрагент = НайтиКонтрагентаПоПартнеру(Родитель);
		Родитель = Родитель.Родитель;
	КонецЦикла;
	
	Возврат Контрагент;
	
КонецФункции

Функция НайтиКонтрагентаПоПартнеру(Партнер)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты КАК Контрагенты ГДЕ ПометкаУдаления = ЛОЖЬ и Партнер = &Партнер");
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

