// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_4_ЗаказНаЭмиссиюКМ_ПослеЗаполненияДокумента	(СтруктураПараметров) Экспорт
	 
	ИмяСобытия = "УТ_11_4_ЗаказНаЭмиссиюКМ_ПослеЗаполненияДокумента";
	
	//УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	Если Док1СРезультат.ЭтоНовый() Тогда
		ИСМП_ОпределитьВидПродукцииДокумента(СтруктураПараметров);
	КонецЕсли;
	
	ТЧТовары	 = Док1СРезультат.Товары;
	ВидПродукции = Док1СРезультат.ВидПродукции;
	
	Попытка
		ОписанияGTIN 				  = РегистрыСведений["ОписаниеGTINИС"].ПолучитьОписание(ТЧТовары.ВыгрузитьКолонку("GTIN"));
		ИспользуютсяНаборы            = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетНаборы(ВидПродукции);
		ИспользуютсяГрупповыеУпаковки = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетГрупповыеУпаковки(ВидПродукции);
	Исключение
		ОписанияGTIN 				  = Новый Соответствие;
		ИспользуютсяНаборы			  = Ложь;
		ИспользуютсяГрупповыеУпаковки = Ложь;
	КонецПопытки;
	
	// В случае неуспешной загрузки GTIN с ТСД будем подбирать GTIN потребительской упаковки
	ДопустимыеВидыУпаковок = Новый Массив;
	ДопустимыеВидыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская"));
	
	Для каждого СтрокаТовары ИЗ ТЧТовары Цикл
		// I. Заполнение количества в базовой единице по количеству кодов маркировки (нельзя брать КоличествоФакт, т.к. оно может быть не целым числом)
		КоэффициентФакт = 1;
		Если ЗначениеЗаполнено(СтрокаТовары.Упаковка) Тогда
			КоэффициентФакт = ?(СтрокаТовары.Упаковка.Числитель = 0, 1, СтрокаТовары.Упаковка.Числитель) /
				?(СтрокаТовары.Упаковка.Знаменатель = 0, 1, СтрокаТовары.Упаковка.Знаменатель);
		КонецЕсли;
		
		СтрокаТовары.Количество = Макс(СтрокаТовары.КоличествоУпаковок * КоэффициентФакт, 1);
		
		// II. Попытка заполнить GTIN в случае неуспешной загрузки с ТСД
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.GTIN) Тогда
			Попытка
				ДопустимыеЗначенияGTIN = ИСМП_ПолучитьДопустимыеЗначенияGTIN(СтрокаТовары, ДопустимыеВидыУпаковок);
			Исключение
				ДопустимыеЗначенияGTIN = Новый Массив;
			КонецПопытки;
			Если ДопустимыеЗначенияGTIN.Количество() Тогда
				СтрокаТовары.GTIN = ДопустимыеЗначенияGTIN[0];
				
				ТекстОшибки = "Строка " + Формат(СтрокаТовары.НомерСтроки, "ЧГ=0") + ": не удалось загрузить GTIN! Был подобран GTIN потребительской упаковки " + СокрЛП(СтрокаТовары.GTIN);
				Сообщить(ТекстОшибки);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
		
		// III. Заполнение шаблона кода маркировки СУЗ (вид упаковки)
		ШаблонДляЗаполнения = Неопределено;
		
		// Режимы:
		//	0 - включать только потребительские упаковки
		//	4 - включать только групповые упаковки
		//	5 - включать только наборы
		РежимВключенияУпаковокИНаборов = 0;
		Если ИспользуютсяГрупповыеУпаковки ИЛИ ИспользуютсяНаборы Тогда
			// По умолчанию используем шаблон для потребительской упаковки.
			// Если вид продукции использует групповые упаковки или наборы,
			//	определяем вид упаковки по GTIN.
			Если ЗначениеЗаполнено(СтрокаТовары.GTIN) Тогда
				ОписаниеGTIN = ОписанияGTIN.Получить(СтрокаТовары.GTIN);
				Если ОписаниеGTIN <> Неопределено Тогда
					Если ОписаниеGTIN.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") Тогда
						РежимВключенияУпаковокИНаборов = 4;
					ИначеЕсли ОписаниеGTIN.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор") Тогда
						РежимВключенияУпаковокИНаборов = 5;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СписокШаблонов = ИО_ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ВидПродукции, РежимВключенияУпаковокИНаборов);
		
		Если НЕ СписокШаблонов = Неопределено Тогда
			ЗаполнитьШаблон = СтрокаТовары.Шаблон.Пустая()
				ИЛИ СписокШаблонов.НайтиПоЗначению(СтрокаТовары.Шаблон) = Неопределено;
			Если ЗаполнитьШаблон Тогда	
				СтрокаТовары.Шаблон = СписокШаблонов.Получить(0).Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры 

