	Если Не Константы.ИспользоватьСерииНоменклатуры.Получить()  Тогда
		СтруктураПараметров.Док1СРезультат.Серии.Очистить();
	КонецЕсли;
	
	// Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
	ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
	ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "");

