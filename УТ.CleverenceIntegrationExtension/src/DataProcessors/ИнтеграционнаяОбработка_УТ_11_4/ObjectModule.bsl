// Вызывается при загрузке табличной части Товары документа ЗаказКлиента из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - Неопределено                - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ЗаказКлиента_ПередЗаполнениемТЧ_Товары		(СтруктураПараметров) Экспорт

	ИмяСобытия = "УТ_11_2_ЗаказКлиента_ПередЗаполнениемТЧ_Товары";
	
	УТ_11_2_Общий_ПередЗаполнениемТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ДокументТСД	   = СтруктураПараметров.ДокументТСД;
	ШапкаДокумента = ДокументТСД.ШапкаДокумента;
	
	Если Док1СРезультат.ЭтоНовый() Тогда
		
		ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
		
		ЗаполнятьУсловияПродажПоУмолчанию = Ложь;
		Если ЗначениеЗаполнено(Док1СРезультат.Партнер) ИЛИ НЕ ИспользоватьСоглашенияСКлиентами Тогда
			УсловияПродажПоУмолчанию = ИО_ОбщийМодуль("ПродажиСервер").ПолучитьУсловияПродажПоУмолчанию(
				Док1СРезультат.Партнер,
				Новый Структура("УчитыватьГруппыСкладов, ВыбранноеСоглашение, ПустаяСсылкаДокумента", Истина, Док1СРезультат.Соглашение, Документы.ЗаказКлиента.ПустаяСсылка()));
				
			ЕстьУсловияПродажПоУмолчанию = НЕ УсловияПродажПоУмолчанию = Неопределено;
			Если ЕстьУсловияПродажПоУмолчанию Тогда
				ЗаполненСкладТСД = ШапкаДокумента.Свойство("ИдСклада1С") И ЗначениеЗаполнено(ШапкаДокумента.ИдСклада1С);
				СкладСоответствуетСкладуДокумента = НЕ ЗаполненСкладТСД
					ИЛИ НЕ ЗначениеЗаполнено(УсловияПродажПоУмолчанию.Склад)
					ИЛИ Док1СРезультат.Склад = УсловияПродажПоУмолчанию.Склад;
					
				ЗаполнятьУсловияПродажПоУмолчанию = СкладСоответствуетСкладуДокумента;
				
				Если НЕ СкладСоответствуетСкладуДокумента Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
						"%1: не удалось заполнить условия продаж по умолчанию (склад в условиях продаж отличается от склада в документе Mobile SMARTS)", Док1СРезультат));
				КонецЕсли;
			Иначе	
				Если ИспользоватьСоглашенияСКлиентами Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
						"%1: не удалось получить соглашение по умолчанию для партнера %2", Док1СРезультат, Док1СРезультат.Партнер));
				Иначе
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
						"%1: не удалось получить условия продаж по умолчанию", Док1СРезультат));
				КонецЕсли;
			КонецЕсли;
		Иначе
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
				"%1: не удалось получить условия продаж по умолчанию (в документе не заполнен партнер)", Док1СРезультат));
		КонецЕсли;
		
		Если ЗаполнятьУсловияПродажПоУмолчанию Тогда
			Попытка
				Док1СРезультат.ЗаполнитьУсловияПродажПоУмолчанию();
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ГлЯдро_СтрШаблон(
					"%1: не удалось заполнить условия продаж по умолчанию. Причина: %2", Док1СРезультат, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

