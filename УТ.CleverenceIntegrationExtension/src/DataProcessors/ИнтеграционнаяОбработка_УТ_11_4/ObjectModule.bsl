	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);
	
	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	Попытка
		// Создаем соответствие номенклатуры ЕГАИС
		ТаблицаТоваров = Док1СРезультат.Товары.Выгрузить(, "АлкогольнаяПродукция, Номенклатура");
		ТаблицаТоваров.Свернуть("АлкогольнаяПродукция, Номенклатура");
		Для каждого СтрокаДокумента ИЗ ТаблицаТоваров Цикл
			Если ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция)
				И ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) Тогда
				СоздатьСоответствиеНоменклатурыЕГАИС(СтрокаДокумента.Номенклатура, СтрокаДокумента.АлкогольнаяПродукция);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_2_ТТНВходящаяЕГАИС_ПослеЗаполненияТЧ_Товары", "Предупреждение", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

