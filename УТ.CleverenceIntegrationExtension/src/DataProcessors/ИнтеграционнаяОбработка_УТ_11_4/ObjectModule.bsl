// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ЗагрузитьДеревоМаркированнойПродукции
Процедура ЕГАИС_ЗагрузитьДеревоМаркированнойПродукции(ДеревоПоДаннымДокумента, ДанныеДокумента)
	
	ДетализацияСтруктурыХраненияДанныхДокумента = ЕГАИС_ДетализацияСтруктурыХраненияДерева(ДеревоПоДаннымДокумента);
	
	Если ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения <> Неопределено Тогда
		Если ДеревоПоДаннымДокумента.Строки.Количество() = 0 Тогда
			ДанныеДокумента.ДетализацияСтруктурыХранения = ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения;
		ИначеЕсли ДетализацияСтруктурыХраненияДанныхДокумента = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная")
			ИЛИ ДетализацияСтруктурыХраненияДанныхДокумента = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками") Тогда
			ДанныеДокумента.ДетализацияСтруктурыХранения = ДетализацияСтруктурыХраненияДанныхДокумента;
		Иначе
			ДанныеДокумента.ДетализацияСтруктурыХранения = ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения;
		КонецЕсли;
	Иначе
		ДанныеДокумента.ДетализацияСтруктурыХранения = ДетализацияСтруктурыХраненияДанныхДокумента;
	КонецЕсли;
	
	КоллекцияСтрокПриемника = ДанныеДокумента.ДеревоМаркированнойПродукции.Строки;
	
	Для каждого СтрокаПоДаннымДокумента Из ДеревоПоДаннымДокумента.Строки Цикл
		ЕГАИС_ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаПоДаннымДокумента, КоллекцияСтрокПриемника, ДанныеДокумента);
	КонецЦикла;
	
	Если ДанныеДокумента.СтрокаБутылкиБезКоробки = Неопределено
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковки") Тогда
		ЕГАИС_ДобавленнаяСтрокаБутылкиБезКоробки(ДанныеДокумента);
	КонецЕсли;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ДетализацияСтруктурыХраненияДерева
Функция ЕГАИС_ДетализацияСтруктурыХраненияДерева(ДеревоУпаковок) Экспорт

	ДетализацияСтруктурыХраненияДерева = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковки");
	
	Для Каждого СтрокаДерева Из ДеревоУпаковок.Строки Цикл
		
		Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
			
			ДетализацияСтруктурыХраненияДерева = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
			
			Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
				
				Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(ПодчиненнаяСтрока.ТипУпаковки) Тогда
					
					ДетализацияСтруктурыХраненияДерева = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ДетализацияСтруктурыХраненияДерева = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная") Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДетализацияСтруктурыХраненияДерева;
	
КонецФункции

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке
Процедура ЕГАИС_ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаИсточника, КоллекцияСтрокПриемника, ДанныеДокумента)
	
	Если СтрокаИсточника.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаАлкогольнойПродукции.БутылкиБезКоробки") Тогда
		
		Если ДанныеДокумента.ДетализацияСтруктурыХранения <> ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковки") Тогда
			
			НоваяСтрока = ДанныеДокумента.СтрокаБутылкиБезКоробки;
			
			Если НоваяСтрока = Неопределено Тогда
				НоваяСтрока = ЕГАИС_ДобавленнаяСтрокаБутылкиБезКоробки(ДанныеДокумента);
			КонецЕсли;
			
		Иначе
			
			Для Каждого ПодчиненнаяСтрокаИсточника Из СтрокаИсточника.Строки Цикл
		
				ЕГАИС_ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(ПодчиненнаяСтрокаИсточника, КоллекцияСтрокПриемника, ДанныеДокумента);
		
			КонецЦикла;
			
			Возврат;
			
		КонецЕсли;
		
	ИначеЕсли СтрокаИсточника.Родитель = Неопределено
		И СтрокаИсточника.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковки") Тогда
		
		СтрокаБутылкиБезУпаковки = ДанныеДокумента.СтрокаБутылкиБезКоробки;
		
		Если СтрокаБутылкиБезУпаковки = Неопределено Тогда
			СтрокаБутылкиБезУпаковки = ЕГАИС_ДобавленнаяСтрокаБутылкиБезКоробки(ДанныеДокумента);
		КонецЕсли;
		
		НоваяСтрока = СтрокаБутылкиБезУпаковки.Строки.Добавить();
		НоваяСтрока.СтатусПроверки = ДанныеДокумента.НачальныйСтатусПроверки;
		
	Иначе
		
		НоваяСтрока = КоллекцияСтрокПриемника.Добавить();
		НоваяСтрока.СтатусПроверки = ДанныеДокумента.НачальныйСтатусПроверки;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	
	Если НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.ПустаяСсылка") Тогда
		НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
	ИначеЕсли НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		НоваяСтрока.ДлинаАкцизнойМарки = СтрДлина(НоваяСтрока.Штрихкод);
	КонецЕсли;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").УстановитьДоступностьУпаковкиДляПроверки(НоваяСтрока, ДанныеДокумента.ДоступныеДляПроверкиУпаковки);
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").СформироватьПредставлениеДляСтрокиДереваМаркированнойПродукции(НоваяСтрока);
	
	Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(НоваяСтрока.ТипУпаковки) Тогда
		ДанныеДокумента.УпаковкиДокумента.Добавить(НоваяСтрока.Штрихкод);
	КонецЕсли;

	КоллекцияСтрокДобавленнойСтроки = НоваяСтрока.Строки;
	
	Для Каждого ПодчиненнаяСтрокаИсточника Из СтрокаИсточника.Строки Цикл
		
		ЕГАИС_ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(ПодчиненнаяСтрокаИсточника, КоллекцияСтрокДобавленнойСтроки, ДанныеДокумента);
		
	КонецЦикла;

КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ДобавленнаяСтрокаБутылкиБезКоробки
Функция ЕГАИС_ДобавленнаяСтрокаБутылкиБезКоробки(ДанныеДокумента)
	
	НоваяСтрока = ДанныеДокумента.ДеревоМаркированнойПродукции.Строки.Вставить(0);
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").ЗаполнитьСтрокуБутылкиБезКоробки(НоваяСтрока);
	
	ДанныеДокумента.СтрокаБутылкиБезКоробки = НоваяСтрока;
	
	Возврат НоваяСтрока;

КонецФункции

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ЗаполнитьТаблицуПартионнойПродукции
Процедура ЕГАИС_ЗаполнитьТаблицуПартионнойПродукции(ДанныеПартионнойПродукции, ДанныеДокумента)
	
	Для Каждого СтрокаТаблицы Из ДанныеПартионнойПродукции Цикл
		
		НоваяСтрока = ДанныеДокумента.ТаблицаНеМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.КоличествоПоДокументу = СтрокаТаблицы.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ЗаполнитьПулНеизвестныхАкцизныхМарок
Процедура ЕГАИС_ЗаполнитьПулНеизвестныхАкцизныхМарок(ДанныеДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеПартионнойПродукции.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ДанныеПартионнойПродукции.Справка2 КАК Справка2,
	|	ДанныеПартионнойПродукции.КоличествоПоДокументу КАК Количество,
	|	ДанныеПартионнойПродукции.КоличествоФактическое КАК КоличествоФактическое
	|ПОМЕСТИТЬ ДанныеПартионнойПродукции
	|ИЗ
	|	&ДанныеПартионнойПродукции КАК ДанныеПартионнойПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеПартионнойПродукции.АлкогольнаяПродукция               КАК АлкогольнаяПродукция,
	|	ДанныеПартионнойПродукции.Справка2                           КАК Справка2,
	|	ЕСТЬNULL(ДанныеПартионнойПродукции.Справка2.Поштучная, ЛОЖЬ) КАК Поштучная,
	|	СУММА(ДанныеПартионнойПродукции.Количество)                  КАК Количество
	|ИЗ
	|	ДанныеПартионнойПродукции КАК ДанныеПартионнойПродукции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	|		ПО ДанныеПартионнойПродукции.АлкогольнаяПродукция = КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыАлкогольнойПродукции КАК ВидыАлкогольнойПродукции
	|		ПО КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции = ВидыАлкогольнойПродукции.Ссылка
	|ГДЕ
	|	ВидыАлкогольнойПродукции.Маркируемый
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеПартионнойПродукции.АлкогольнаяПродукция,
	|	ДанныеПартионнойПродукции.Справка2,
	|	ЕСТЬNULL(ДанныеПартионнойПродукции.Справка2.Поштучная, ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("ДанныеПартионнойПродукции", ДанныеДокумента.ТаблицаНеМаркируемойПродукции);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДанныеДокумента.ПулНеизвестныхАкцизныхМарок.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЕГАИС_ЗаполнитьДеревоКОпределениюСправок2(ТаблицаКОпределениюСправок2, ДанныеДокумента)

	Для Каждого СтрокаТаблицы Из ТаблицаКОпределениюСправок2 Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.АлкогольнаяПродукция)
			И Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока = ДанныеДокумента.АлкогольнаяПродукцияКОпределениюСправок2.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		УстановитьИндексКартинкиСостояниеПодбораАкцизныхМарок(НоваяСтрока);
		
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьИндексКартинкиСостояниеПодбораАкцизныхМарок(ТекущаяСтрока) Экспорт
	
	Если НЕ ТекущаяСтрока.Маркируемая Тогда
		
		ТекущаяСтрока.ИндексАкцизнойМарки = 0;
		
	ИначеЕсли ТекущаяСтрока.КоличествоРаспределено >= ТекущаяСтрока.Количество Тогда
		
		ТекущаяСтрока.ИндексАкцизнойМарки = 1;
		
	Иначе
		
		ТекущаяСтрока.ИндексАкцизнойМарки = 2;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ТТНИсходящаяЕГАИС_ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат, ДеревоМаркируемойПродукции, ТаблицаНеМаркируемойПродукции)
	
	// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор.НачатьЗавершениеПроверки
	
	ТипЧастичноеВыбытиеВариантУчета = ОбщегоНазначения.ОписаниеТипаСтрока(50);	
	Если Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИС") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИС");
	ИначеЕсли Метаданные.Перечисления.Найти("ВариантыУчетаЧастичногоВыбытияИСМП") <> Неопределено Тогда
		ТипЧастичноеВыбытиеВариантУчета = Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИСМП");
	КонецЕсли;
	
	ОписаниеТиповТипУпаковки = Новый ОписаниеТипов;
	ОписаниеТиповТипУпаковки.Типы().Добавить(Тип("ПеречислениеСсылка.ТипыУпаковок"));
	ОписаниеТиповТипУпаковки.Типы().Добавить(Тип("ПеречислениеСсылка.ПрочиеЗоныПересчетаАлкогольнойПродукции"));
		
	ВозвращаемоеДерево = Новый ДеревоЗначений;
	ВозвращаемоеДерево.Колонки.Добавить("Штрихкод",                ОбщегоНазначения.ОписаниеТипаСтрока(200));
	ВозвращаемоеДерево.Колонки.Добавить("ТипУпаковки",             ОписаниеТиповТипУпаковки);
	ВозвращаемоеДерево.Колонки.Добавить("АлкогольнаяПродукция",    Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Номенклатура",            Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Характеристика",          Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Серия",                   Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("Справка2",                Неопределено);
	ВозвращаемоеДерево.Колонки.Добавить("ВсеСправки2Указаны",      Новый ОписаниеТипов("Булево"));
	ВозвращаемоеДерево.Колонки.Добавить("СтатусПроверки",          Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыПроверкиНаличияПродукцииИС"));
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоАкцизныхМарок", ОбщегоНазначения.ОписаниеТипаЧисло(15));
	ВозвращаемоеДерево.Колонки.Добавить("ИдентификаторСтроки",     ОбщегоНазначения.ОписаниеТипаЧисло(15));
	ВозвращаемоеДерево.Колонки.Добавить("ХешСумма",                ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытие",               Новый ОписаниеТипов("Булево"));
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеВариантУчета",   ТипЧастичноеВыбытиеВариантУчета);
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеНоменклатура",   Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеХарактеристика", Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	ВозвращаемоеДерево.Колонки.Добавить("ЧастичноеВыбытиеКоличество",     ОбщегоНазначения.ОписаниеТипаЧисло(10, 3));
	ВозвращаемоеДерево.Колонки.Добавить("ВыбытиеБутылки",                 Новый ОписаниеТипов("Булево"));
	ВозвращаемоеДерево.Колонки.Добавить("Коэффициент",                    ОбщегоНазначения.ОписаниеТипаЧисло(18, 8));
	
	ТТН_ЕГАИС_ДополнитьДерево(ВозвращаемоеДерево);
		
	Для Каждого СтрокаПроверяемого Из ДеревоМаркируемойПродукции.Строки Цикл
		ТТНВходящаяЕГАИС_ДобавитьСтрокуВРезультирующееДерево(СтрокаПроверяемого, ВозвращаемоеДерево.Строки);
	КонецЦикла;
	
	// см. Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.ЗафиксироватьРезультатПроверкиИПодбора
	
	Попытка                                           		
		ШтрихкодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(
			ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ЗначенияШтрихкодовИзДереваУпаковок(ВозвращаемоеДерево));
	Исключение
		ШтрихкодыУпаковок = ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ШтрихкодыУпаковок(
			ИО_ОбщийМодуль("ИнтеграцияЕГАИС").ЗначенияШтрихкодовИзДереваУпаковок(ВозвращаемоеДерево));
	КонецПопытки;
		
	Попытка
		Грузополучатель = Неопределено;
		
		ИО_ОбщийМодуль("ШтрихкодированиеЕГАИС").СоздатьШтрихкодыУпаковок(ВозвращаемоеДерево,
			ШтрихкодыУпаковок,, Грузополучатель);
	Исключение
		Справочники["ШтрихкодыУпаковокТоваров"].СоздатьШтрихкодыУпаковок(
			ВозвращаемоеДерево, ШтрихкодыУпаковок, Ложь, Док1СРезультат.Грузополучатель);
	КонецПопытки;
		
	// см. Документы.ТТНИсходящаяЕГАИС.ОтразитьРезультатыПроверкиИПодбора
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ПроверкаНеПоДокументу",			Ложь);
	ПараметрыПроцедуры.Вставить("ПроверяемыйДокумент",				Док1СРезультат.Ссылка);
	ПараметрыПроцедуры.Вставить("ПостфиксСохранения",				"");
	ПараметрыПроцедуры.Вставить("АдресРезультатовПроверки",			Неопределено);
	ПараметрыПроцедуры.Вставить("ДеревоМаркируемойПродукции",		ВозвращаемоеДерево);
	ПараметрыПроцедуры.Вставить("ТаблицаНеМаркируемойПродукции",	ТаблицаНеМаркируемойПродукции);
	
	Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНИсходящаяЕГАИС") Тогда
		Документы.ТТНИсходящаяЕГАИС.ОтразитьРезультатыПроверкиИПодбора(ПараметрыПроцедуры);
	ИначеЕсли ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.АктСписанияЕГАИС") Тогда
		Документы.АктСписанияЕГАИС.ОтразитьРезультатыПроверкиИПодбора(ПараметрыПроцедуры);
	КонецЕсли;
	
	// Документ был записан при отражении результатов проверки и подбора
	Док1СРезультат.Прочитать();
	
КонецПроцедуры

Процедура ТТНИсходящаяЕГАИС_ЗавершениеПроверки(СтруктураПараметров)
	
	ДокументОбъект = СтруктураПараметров.Док1СРезультат;
	
	РезультатПроверки = ДокументОбъект.ДанныеПроверкиИПодбора.Получить();
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ЕстьОшибки",                Ложь);
	СтруктураВозврата.Вставить("ТекстОшибки",               "");
	СтруктураВозврата.Вставить("АдресВоВременномХранилище", "");
	
	СтруктураВозврата.АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(РезультатПроверки);	
	
	ТаблицаНеМаркируемойПродукции = РезультатПроверки.ТаблицаНеМаркируемойПродукции;
	ДеревоМаркируемойПродукции    = РезультатПроверки.ДеревоМаркированнойПродукции;
	
	ОчиститьДанныеПередЗаполнением(ДокументОбъект);
		
	ПараметрыЗаполнения = ПараметрыЗаполненияТоваровИАкцизныхМарок(Истина);
		
	//Выполнить("АкцизныеМаркиЕГАИС.ЗаполнитьТоварыИАкцизныеМарки(ДокументОбъект, ДеревоМаркируемойПродукции, ПараметрыЗаполнения)");
	ИО_ОбщийМодуль("АкцизныеМаркиЕГАИС").ЗаполнитьТоварыИАкцизныеМарки(ДокументОбъект, ДеревоМаркируемойПродукции, ПараметрыЗаполнения);
			
	//Выполнить("АкцизныеМаркиЕГАИС.ЗаполнитьНеМаркируемыеТовары(ДокументОбъект, ТаблицаНеМаркируемойПродукции, ПараметрыЗаполнения)");
	ИО_ОбщийМодуль("АкцизныеМаркиЕГАИС").ЗаполнитьНеМаркируемыеТовары(ДокументОбъект, ТаблицаНеМаркируемойПродукции, ПараметрыЗаполнения);
		
	СтруктураПоискаПустыхСтрок = Новый Структура();
	СтруктураПоискаПустыхСтрок.Вставить("Количество", 0);
	СтруктураПоискаПустыхСтрок.Вставить("КоличествоУпаковок", 0);
		
	ПустыеСтроки = ДокументОбъект.Товары.НайтиСтроки(СтруктураПоискаПустыхСтрок);
		
	Для Каждого ПустаяСтрока Из ПустыеСтроки Цикл
		ДокументОбъект.Товары.Удалить(ПустаяСтрока);
	КонецЦикла;
		
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		СтрокаТовара.КоличествоФакт = СтрокаТовара.Количество;
		СтрокаТовара.КоличествоУпаковок = СтрокаТовара.Количество;
	КонецЦикла;
			
КонецПроцедуры

Процедура ОчиститьДанныеПередЗаполнением(ДокументОбъект)
	
	ДокументОбъект.АкцизныеМарки.Очистить();
	
	ИменаКолонокДляОчистки = Новый Массив();
	ИменаКолонокДляОчистки.Добавить("Количество");
	ИменаКолонокДляОчистки.Добавить("КоличествоУпаковок");
	
	Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
		Для Каждого ИмяКолонки Из ИменаКолонокДляОчистки Цикл
			СтрокаТовары[ИмяКолонки] = 0;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

//ОМ. АкцизныеМаркиЕГАИС
Функция ПараметрыЗаполненияТоваровИАкцизныхМарок(ДобавлятьКоличество = Истина, ПараметрыСканирования = Неопределено) Экспорт
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ДобавлятьКоличество",            ДобавлятьКоличество);
	ПараметрыЗаполнения.Вставить("ИзмененныеСтроки",               Новый Массив);
	ПараметрыЗаполнения.Вставить("ДобавленныеСтроки",              Новый Массив);
	ПараметрыЗаполнения.Вставить("ЕстьСправка2",                   Истина);
	ПараметрыЗаполнения.Вставить("ТолькоПустаяСправка2",           Ложь);
	ПараметрыЗаполнения.Вставить("УчитыватьСерии",                 Истина);
	ПараметрыЗаполнения.Вставить("ТекущаяСтрока",                  Неопределено);
	ПараметрыЗаполнения.Вставить("ЕстьКоличествоАкцизныхМарок",    Ложь);
	ПараметрыЗаполнения.Вставить("ПараметрыУказанияСерий",         Неопределено);
	ПараметрыЗаполнения.Вставить("ИмяКолонкиАлкогольнаяПродукция", "АлкогольнаяПродукция");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиКоличество",           "Количество");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиКоличествоУпаковок",   "КоличествоУпаковок");
	
	ПараметрыЗаполнения.Вставить("ТипШтрихКода", Неопределено); 
	
	ПараметрыСканирования = Новый Структура;
	
	ПараметрыСканирования.Вставить("ДопустимыеВидыПродукции",                        Новый Массив);
	ПараметрыСканирования.Вставить("АдресСоответствияАкцизныхМарок",                 Неопределено);
	ПараметрыСканирования.Вставить("СоздаватьШтрихкодУпаковки",                      Истина);
	ПараметрыСканирования.Вставить("ДокументОснование",                              Неопределено);
	ПараметрыСканирования.Вставить("ВозможнаЗагрузкаТСД",                            Ложь);
	ПараметрыСканирования.Вставить("ТолькоМаркируемаяПродукция",                     Ложь);
	ПараметрыСканирования.Вставить("КэшированныеЗначения",                           Неопределено);
	ПараметрыСканирования.Вставить("КонтрольРасхожденийСДокументомОснованием",       Истина);
	ПараметрыСканирования.Вставить("АдресДанныхДокументаОснования",                  Неопределено);
	ПараметрыСканирования.Вставить("ИспользуетсяСоответствиеШтрихкодовСтрокДерева",  Ложь);
	ПараметрыСканирования.Вставить("ДанныеВыбораПоМаркируемойПродукции",             Неопределено);
	ПараметрыСканирования.Вставить("ИспользуютсяДанныеВыбораПоМаркируемойПродукции", Ложь);
	ПараметрыСканирования.Вставить("ДополнительныеПараметры",                        Новый Структура);
	ПараметрыСканирования.Вставить("ОперацияКонтроляАкцизныхМарок",                  "");
	ПараметрыСканирования.Вставить("КлючевыеРеквизиты", Новый Массив());
	
	ПараметрыЗаполнения.Вставить("ПараметрыСканирования", ПараметрыСканирования);
	ПараметрыЗаполнения.Вставить("ПараметрыСканированияАкцизныхМарок", ПараметрыСканирования);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

Функция СформироватьСтруктуруДанныхПроверкиИПодбора(Док1СРезультат, ВерсииОбъектовКонфигурации)
	
	ТипЧисло10   = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой));
    ТипЧисло15   = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Любой));
    ТипЧисло15_3 = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
    ТипБулево    = Новый ОписаниеТипов("Булево");
    
    ТипСерияНоменклатуры = Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры");    
                        
    ОписаниеТиповТипУпаковки = Новый ОписаниеТипов;
    ОписаниеТиповТипУпаковки.Типы().Добавить(Тип("ПеречислениеСсылка.ТипыУпаковок"));
    ОписаниеТиповТипУпаковки.Типы().Добавить(Тип("ПеречислениеСсылка.ПрочиеЗоныПересчетаАлкогольнойПродукции"));    

	ВозвращаемоеДерево = Новый ДеревоЗначений;     
	
	ВозвращаемоеДерево.Колонки.Добавить("ТипУпаковки",             	ОписаниеТиповТипУпаковки);
	ВозвращаемоеДерево.Колонки.Добавить("АлкогольнаяПродукция",		Новый ОписаниеТипов("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));
	ВозвращаемоеДерево.Колонки.Добавить("Номенклатура",				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ВозвращаемоеДерево.Колонки.Добавить("Характеристика",			Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ВозвращаемоеДерево.Колонки.Добавить("Серия",					ТипСерияНоменклатуры);
	ВозвращаемоеДерево.Колонки.Добавить("Справка2",					Новый ОписаниеТипов("СправочникСсылка.Справки2ЕГАИС"));
	ВозвращаемоеДерево.Колонки.Добавить("ВсеСправки2Указаны",		ТипБулево);
	
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоАкцизныхМарок", 	ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("ШтрихкодУпаковки", 		Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	ВозвращаемоеДерево.Колонки.Добавить("ШтрихкодУпаковкиПоДаннымДокумента",	Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));	     
	
	// Замечание. Изменение перечисления и поля штрихкода не обязательно произошли в одном обновлении!! м.б. ошибка   
	ВозвращаемоеДерево.Колонки.Добавить(ВерсииОбъектовКонфигурации.ПолеШтрихкода, Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияАлкогольнойПродукции") <> Неопределено Тогда
		ВозвращаемоеДерево.Колонки.Добавить("СтатусПроверки",       Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыПроверкиНаличияАлкогольнойПродукции"));
	Иначе
		ВозвращаемоеДерево.Колонки.Добавить("СтатусПроверки",       Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыПроверкиНаличияПродукцииИС"));
	КонецЕсли;
	ВозвращаемоеДерево.Колонки.Добавить("ИдентификаторСтроки",		Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(36, ДопустимаяДлина.Переменная)));	
		  		
	ВозвращаемоеДерево.Колонки.Добавить("ВУпаковкеРазнаяАлкогольнаяПродукция",	ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ВУпаковкеРазнаяНоменклатура",			ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ВУпаковкеРазныеСерии",					ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ВУпаковкеРазныеСправки2",				ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ВУпаковкеРазныеХарактеристики",		ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ВсяУпаковкаПроверена",					ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ИдетПроверкаДаннойУпаковки",			ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ИндексКартинкиСтатусПроверки",			ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("ИндексКартинкиШтрихкод",				ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхБутылок",			ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхВНаличии",		ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхВсего",			ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхНеПроверялось",	ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхНеЧислилось",		ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхОтложено",		ТипЧисло15);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхОтсутствует",		ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("КоличествоПодчиненныхУпаковок",		ТипЧисло10);
	ВозвращаемоеДерево.Колонки.Добавить("НеСодержитсяВДанныхДокумента",			ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("НеСоответствуетОтбору",				ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("НомерСтикераОтложено",					Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));	
	ВозвращаемоеДерево.Колонки.Добавить("Представление",						Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(250, ДопустимаяДлина.Переменная)));	
	ВозвращаемоеДерево.Колонки.Добавить("ПредставлениеПроверкиПодчиненных",		Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(250, ДопустимаяДлина.Переменная)));	
	ВозвращаемоеДерево.Колонки.Добавить("ПредставлениеСодержимоеУпаковки",		Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(60, ДопустимаяДлина.Переменная)));	
	ВозвращаемоеДерево.Колонки.Добавить("ТребуетсяПеремаркировка",				ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ХешСумма",								Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));	
	ВозвращаемоеДерево.Колонки.Добавить("ВУпаковкеРазныеДлиныМарок",			ТипБулево);
	ВозвращаемоеДерево.Колонки.Добавить("ДлинаАкцизнойМарки",					ТипЧисло10);
	
	АлкогольнаяПродукцияКОпределениюСправок2 = Новый ДеревоЗначений;    
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("Номенклатура",			Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("Характеристика",			Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("Серия",					ТипСерияНоменклатуры);
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("АлкогольнаяПродукция",	Новый ОписаниеТипов("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("Справка2",				Новый ОписаниеТипов("СправочникСсылка.Справки2ЕГАИС"));
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("Количество",				ТипЧисло15);
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("КоличествоРаспределено",	ТипЧисло15);
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("Маркируемая",			ТипБулево);
    АлкогольнаяПродукцияКОпределениюСправок2.Колонки.Добавить("ИндексАкцизнойМарки",	ТипЧисло10);    
	
	ТаблицаНеМаркируемойПродукции = Новый ТаблицаЗначений;
    ТаблицаНеМаркируемойПродукции.Колонки.Добавить("АлкогольнаяПродукция", 	Новый ОписаниеТипов("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));    
    ТаблицаНеМаркируемойПродукции.Колонки.Добавить("КоличествоПоДокументу", ТипЧисло15_3);
    ТаблицаНеМаркируемойПродукции.Колонки.Добавить("КоличествоФактическое", ТипЧисло15_3);
    ТаблицаНеМаркируемойПродукции.Колонки.Добавить("Справка2",              Новый ОписаниеТипов("СправочникСсылка.Справки2ЕГАИС"));    
	
	ДоступныеДляПроверкиУпаковки = Новый СписокЗначений;
	
	Попытка
		
		ВходящееДеревоУпаковок = Документы["ТТНВходящаяЕГАИС"].ВходящееДеревоУпаковок(Док1СРезультат.Ссылка);
		
		КоробкиДеревоЗначений = ВходящееДеревоУпаковок.ДеревоУпаковок;
		
		ДанныеПартионнойПродукции = ВходящееДеревоУпаковок.ТоварыБезАкцизныхМарок; // парт.прод
		
		// дополнительные параметры для объектов, измененных в обновлении
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("СтатусыПроверкиНаличияПродукцииИС", Новый Соответствие());
		ДополнительныеПараметры.Вставить("ПолеШтрихкода");
		
		Если ВозвращаемоеДерево.Колонки.Найти("Штрихкод") <> Неопределено Тогда
			ДополнительныеПараметры.ПолеШтрихкода = "Штрихкод";
		Иначе
			ДополнительныеПараметры.ПолеШтрихкода = "ЗначениеШтрихкода";
		КонецЕсли;	
	
		Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияАлкогольнойПродукции") <> Неопределено Тогда
			ДополнительныеПараметры.СтатусыПроверкиНаличияПродукцииИС.Вставить("НеПроверялась",
				ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеПроверялась"));
		Иначе
			ДополнительныеПараметры.СтатусыПроверкиНаличияПродукцииИС.Вставить("НеПроверялась",
				ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась"));
		КонецЕсли;			
		
		// Заполняем дерево маркированной продукции из сообщения XML со статусом "Не проверялась"
		ЗаполнитьСтруктуруДанныхПроверкиИПодбора(КоробкиДеревоЗначений.Строки, ВозвращаемоеДерево, ДоступныеДляПроверкиУпаковки, ДополнительныеПараметры);			
		
		ЗаполнитьТаблицуПартионнойПродукции_Вариант(ДанныеПартионнойПродукции, ТаблицаНеМаркируемойПродукции);
		
	Исключение
		
	КонецПопытки; 
		
	ДанныеПроверкиИПодбора = Новый Структура;
    ДанныеПроверкиИПодбора.Вставить("АлкогольнаяПродукцияКОпределениюСправок2",	АлкогольнаяПродукцияКОпределениюСправок2);
    ДанныеПроверкиИПодбора.Вставить("ДанныеРанееСгенерированныхШтрихкодов");
    ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции",				ВозвращаемоеДерево);
    ДанныеПроверкиИПодбора.Вставить("ДобавленныеУпаковки",						Новый СписокЗначений);
    ДанныеПроверкиИПодбора.Вставить("ДоступныеДляПроверкиУпаковки",				ДоступныеДляПроверкиУпаковки);
    ДанныеПроверкиИПодбора.Вставить("ПулНеизвестныхАкцизныхМарок",				Новый ТаблицаЗначений);
    ДанныеПроверкиИПодбора.Вставить("СледующийСтикерОтложено",					0);
    ДанныеПроверкиИПодбора.Вставить("ТаблицаНеМаркируемойПродукции",			ТаблицаНеМаркируемойПродукции);
    ДанныеПроверкиИПодбора.Вставить("УпаковкиДокумента",						Новый СписокЗначений);
    ДанныеПроверкиИПодбора.Вставить("ШтрихкодТекущейПроверяемойУпаковки",		"");
	ДанныеПроверкиИПодбора.Вставить("Справки2СопоставленнаяНоменклатура",		Справки2СопоставленнаяНоменклатура());
			
	Возврат	ДанныеПроверкиИПодбора; 
	
КонецФункции

Процедура ЗаполнитьПартионнуюПродукцию(ТаблицаНеМаркируемойПродукции, ДокументТСД, МаркиПартионнойПродукции = Неопределено)
	
	СтруктураПоиска = Новый Структура();
	ПараметрыМарки = Новый Структура();
	
	Если МаркиПартионнойПродукции = Неопределено Тогда
		МаркиПартионнойПродукции = Новый Массив();
	КонецЕсли;	
	
	// предполагается что в СтрокиФакт остались только марки партионной продукции	
	// марки помарочного учета удалены
	Для каждого Строка Из ТаблицаНеМаркируемойПродукции Цикл
	
		СтруктураПоиска.Вставить("АлкогольнаяПродукция", 	Строка.АлкогольнаяПродукция);
		СтруктураПоиска.Вставить("Справка2", 				Строка.Справка2);
		
		Для Каждого СтрокаФакт Из ДокументТСД.СтрокиФакт Цикл
			Если ТипЗнч(СтрокаФакт) = Тип("ТаблицаЗначений") Тогда Продолжить; КонецЕсли;
			Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда Продолжить; КонецЕсли;			
			
			Если (СтрокаФакт.Справка2 = Строка.Справка2) И (СтрокаФакт.АлкогольнаяПродукция = Строка.АлкогольнаяПродукция) Тогда
				Строка.КоличествоФактическое = Строка.КоличествоФактическое + СтрокаФакт.КоличествоФакт;
				
				АлкоПДФ = ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, "");
				
				Если АлкоПДФ <> "" Тогда
					Марка = Новый Структура("Штрихкод, АлкогольнаяПродукция, Справка2");
					Марка.Штрихкод = АлкоПДФ;
					Марка.Справка2 = СтрокаФакт.Справка2;					
					Марка.АлкогольнаяПродукция = СтрокаФакт.АлкогольнаяПродукция;
					
					МаркиПартионнойПродукции.Добавить(Марка);
				КонецЕсли;
				
			КонецЕсли;			
		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТТНИсходящаяЕГАИС_ЗаполнитьДеревоДанныеПроверкиИПодбора(СтруктураПараметров, ДеревоМаркированнойПродукции, ТаблицаИзмененийАлкогольнойПродукции)
	
	СтрокиФакт = СтруктураПараметров.ДокументТСД.СтрокиФакт;
	
	ТаблицаАлкогольнойПродукции = Новый ТаблицаЗначений;
	
	КолонкиТаблицыЗначений = ТаблицаАлкогольнойПродукции.Колонки;
	
	КолонкиТаблицыЗначений.Добавить("АлкогольнаяПродукция");
	КолонкиТаблицыЗначений.Добавить("Номенклатура");
	КолонкиТаблицыЗначений.Добавить("Характеристика");
	КолонкиТаблицыЗначений.Добавить("Серия");
	КолонкиТаблицыЗначений.Добавить("Справка2");
	КолонкиТаблицыЗначений.Добавить("СтатусПроверки");		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодБутылки");
	КолонкиТаблицыЗначений.Добавить("ШтрихкодКоробки");		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПалеты");
	КолонкиТаблицыЗначений.Добавить("КоличествоУпаковок");
	
	ТаблицаМарок = Новый ТаблицаЗначений;
	ТаблицаМарок.Колонки.Добавить("Марка", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	
	КэшИнформацииПоМаркам = Новый Соответствие;
	
	Счетчик = 0 ;
	Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") И СтрокаФакт.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		АлкоПДФ = ?(СтрокаФакт.Свойство("Марка"), СтрокаФакт.Марка, ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, ""));		
		Если НЕ ЗначениеЗаполнено(АлкоПДФ) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаМарок.Добавить();
		НоваяСтрока.Марка = АлкоПДФ;                   
		
		Счетчик = Счетчик + 1;
		Если Счетчик = 1000 Тогда
			ЕГАИС_ПолучитьИнформациюПоТаблицеМарок(КэшИнформацииПоМаркам, ТаблицаМарок);
			ТаблицаМарок.Очистить();
			Счетчик = 0;
		КонецЕсли;	
	КонецЦикла;
	
	ЕГАИС_ПолучитьИнформациюПоТаблицеМарок(КэшИнформацииПоМаркам, ТаблицаМарок);
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияПродукцииИС") <> Неопределено Тогда
		СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
	Иначе
		СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.ВНаличии");
	КонецЕсли;
	
	ПустаяСерия = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры");
	
	Для каждого СтрокаФакт из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") И СтрокаФакт.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		АлкоПДФ = ?(СтрокаФакт.Свойство("Марка"), СтрокаФакт.Марка, ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, ""));
		Если НЕ ЗначениеЗаполнено(АлкоПДФ) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаАлкогольнойПродукции.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФакт);
		
		ИнфоОМарке = КэшИнформацииПоМаркам.Получить(АлкоПДФ);
		Если ИнфоОМарке <> Неопределено Тогда
			ЗаполняемыеДанные = Новый Массив;
			ЗаполняемыеДанные.Добавить("Номенклатура");
			ЗаполняемыеДанные.Добавить("АлкогольнаяПродукция");
			ЗаполняемыеДанные.Добавить("Серия");
			ЗаполняемыеДанные.Добавить("Справка2");
			
			Для каждого ЗаполняемоеПоле ИЗ ЗаполняемыеДанные Цикл
				Если НЕ ЗначениеЗаполнено(НоваяСтрока[ЗаполняемоеПоле]) Тогда
					НоваяСтрока[ЗаполняемоеПоле] = ИнфоОМарке[ЗаполняемоеПоле];
				КонецЕсли;
			КонецЦикла;
			
			АкцизнаяМарка = ИнфоОМарке.АкцизнаяМарка;
		Иначе
			АкцизнаяМарка = Неопределено;
		КонецЕсли;
		
		// Если номенклатура не заполнена в строке ТСД и в справочнике "Штрихкоды упаковок и товаров"
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			НоваяСтрока.Номенклатура = НайтиНоменклатуруПоАлкогольнойПродукции(СтрокаФакт.АлкогольнаяПродукция);
		КонецЕсли;
		
		// Если алкогольную продукцию не удалось получить из справочника "Штрихкоды упаковок и товаров" (см. Серия -> Справка2 -> Алкогольная продукция)
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.АлкогольнаяПродукция) Тогда 
			АлкогольнаяПродукция = ПредопределенноеЗначение("Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка");
			
			Если НЕ ЗначениеЗаполнено(АкцизнаяМарка) И НЕ ПустаяСтрока(АлкоПДФ) Тогда
				АкцизнаяМарка = НайтиСоздатьАкцизнуюМарку(СтруктураПараметров);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(АкцизнаяМарка) Тогда
				ДанныеАлкогольнойПродукции = ПолучитьДанныеАлкогольнойПродукцииПоАкцизнойМарке(АкцизнаяМарка);
				Если ДанныеАлкогольнойПродукции <> Неопределено Тогда
					АлкогольнаяПродукция = ДанныеАлкогольнойПродукции.АлкогольнаяПродукция;
				КонецЕсли;
			КонецЕсли;
			
			Если АлкогольнаяПродукция.Пустая() И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
				АлкогольнаяПродукция = НайтиАлкогольнуюПродукциюПоНоменклатуре(НоваяСтрока.Номенклатура);
			КонецЕсли;
			
			НоваяСтрока.АлкогольнаяПродукция = АлкогольнаяПродукция;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(НоваяСтрока.АлкогольнаяПродукция) Тогда
			НайденнаяНоменклатура = НайтиНоменклатуруПоАлкогольнойПродукции(НоваяСтрока.АлкогольнаяПродукция);
			Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
				НоваяСтрока.Номенклатура = НайденнаяНоменклатура;
			КонецЕсли;
		КонецЕсли;
		
		// Если серию не удалось получить из справочника "Штрихкоды упаковок и товаров"
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Серия) Тогда
			СерияНоменклатуры = Неопределено;
			
			Если СтрокаФакт.Свойство("ИдНайденнойСерии") И ЗначениеЗаполнено(СтрокаФакт.ИдНайденнойСерии) Тогда
				СерияНоменклатуры = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдНайденнойСерии));
				
				Если НЕ ЗначениеЗаполнено(СерияНоменклатуры)
					ИЛИ ГлЯдро_СтрНайти(Строка(СерияНоменклатуры), "бъект не найден")
					ИЛИ ГлЯдро_СтрНайти(Строка(СерияНоменклатуры), "bject not found") Тогда
					СерияНоменклатуры = Неопределено;
				КонецЕсли;
			КонецЕсли;
				
			Если СерияНоменклатуры = Неопределено
				И СтрокаФакт.Свойство("ИдСерии") И ЗначениеЗаполнено(СтрокаФакт.ИдСерии) Тогда
				СерияНоменклатуры = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдСерии));
				
				Если НЕ ЗначениеЗаполнено(СерияНоменклатуры)
					ИЛИ ГлЯдро_СтрНайти(Строка(СерияНоменклатуры), "бъект не найден")
					ИЛИ ГлЯдро_СтрНайти(Строка(СерияНоменклатуры), "bject not found") Тогда
					СерияНоменклатуры = Неопределено;
				КонецЕсли;
			КонецЕсли;				
			
			Если СерияНоменклатуры = Неопределено Тогда
				СерияНоменклатуры = ПустаяСерия;
			КонецЕсли;
			
			НоваяСтрока.Серия = СерияНоменклатуры;
		КонецЕсли;
		
		НоваяСтрока.СтатусПроверки = СтатусПроверки;
		
		НоваяСтрока.КоличествоУпаковок = СтрокаФакт.КоличествоФакт;
		
		ШтрихкодПалеты	= "";
		ШтрихкодКоробки = "";
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда
			ШтрихкодПалеты	= СтрокаФакт.SSCC;
			ШтрихкодКоробки = СтрокаФакт.ИдКоробки;
		Иначе
			ШтрихкодКоробки = СтрокаФакт.SSCC;
		КонецЕсли;
		
		НоваяСтрока.ШтрихкодПалеты 	= ШтрихкодПалеты;
		НоваяСтрока.ШтрихкодКоробки = ШтрихкодКоробки;
		НоваяСтрока.ШтрихкодБутылки	= АлкоПДФ;
	КонецЦикла;
	
	ЕГАИС_ДобавитьСтрокиВДеревоАлкогольнойПродукции(ДеревоМаркированнойПродукции, ТаблицаАлкогольнойПродукции, ТаблицаИзмененийАлкогольнойПродукции);
	
КонецПроцедуры

Процедура ЕГАИС_ПолучитьИнформациюПоТаблицеМарок(КэшСоответствие, ТЗ)
	
	ВремяНачалаСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВременнаяТаблица.Марка КАК Марка
	               |ПОМЕСТИТЬ ТЗ_Марки
	               |ИЗ
	               |	&ТЗ КАК ВременнаяТаблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1000
	               |	ТЗ_Марки.Марка КАК Марка,
	               |	ШтрихкодыУпаковокТоваров.Ссылка КАК АкцизнаяМарка,
	               |	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	               |	ШтрихкодыУпаковокТоваров.Серия КАК Серия,
	               |	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.Серия.Справка2ЕГАИС, ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК Справка2,
	               |	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.Серия.Справка2ЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК АлкогольнаяПродукция
	               |ИЗ
	               |	ТЗ_Марки КАК ТЗ_Марки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |		ПО (ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = ТЗ_Марки.Марка)
	               |			И (НЕ ШтрихкодыУпаковокТоваров.ПометкаУдаления)";
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		ИнформацияОМарке = Новый Структура("Номенклатура, АкцизнаяМарка, Серия, Справка2, АлкогольнаяПродукция",
			Выборка.Номенклатура,
			Выборка.АкцизнаяМарка,
			Выборка.Серия,
			Выборка.Справка2,
			Выборка.АлкогольнаяПродукция);
		КэшСоответствие.Вставить(Выборка.Марка, ИнформацияОМарке);
	КонецЦикла;
	
	ВремяКонцаСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЕГАИС_ПолучитьИнформациюПоТаблицеМарок", "Информация", "Время получения таблицы: " + Формат(ВремяКонцаСобытия - ВремяНачалаСобытия, "ЧГ=") + " мс.");

КонецПроцедуры

Процедура ЕГАИС_ДобавитьСтрокиВДеревоАлкогольнойПродукции(ДеревоМаркированнойПродукции, ТаблицаАлкогольнойПродукции, ТаблицаИзмененийАлкогольнойПродукции)
	
	Попытка
		Детализация = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
	Исключение	
		Детализация = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияАлкогольнойПродукции.Полная");
	КонецПопытки;
	
	МассивДетализаций = Новый Массив;
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияАлкогольнойПродукции") <> Неопределено Тогда
		МассивДетализаций.Добавить(ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияАлкогольнойПродукции.Бутылки"));
	КонецЕсли;
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		МассивДетализаций.Добавить(ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки"));
	КонецЕсли;
	
	// Добавим пустую строку для бутылки без упаковки, если её нет
	СтрокаБутылкаБезУпаковки = Неопределено;
	Если МассивДетализаций.Найти(Детализация) = Неопределено Тогда
		ЕстьСтрокаБутылкаБезУпаковки = Ложь;
		Для Каждого СтрокаДереваМаркированнойПродукции Из ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаАлкогольнойПродукции.БутылкиБезКоробки") Тогда
				СтрокаБутылкаБезУпаковки = СтрокаДереваМаркированнойПродукции;
				ЕстьСтрокаБутылкаБезУпаковки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьСтрокаБутылкаБезУпаковки Тогда
			СтрокаБутылкаБезУпаковки = ДеревоМаркированнойПродукции.Строки.Вставить(0);
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").ЗаполнитьСтрокуБутылкиБезКоробки(СтрокаБутылкаБезУпаковки);
		КонецЕсли;
	КонецЕсли;
	//
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияАлкогольнойПродукции") <> Неопределено Тогда
		СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.ВНаличии");									
		СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.Отсутствует");
		СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеПроверялась");									
		СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеЧислилась");
	Иначе
		СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
		СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
		СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
		СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
	КонецЕсли;
	
	ШтрихкодыПалет = ТаблицаАлкогольнойПродукции.Скопировать(, "ШтрихкодПалеты");
	ШтрихкодыПалет.Свернуть("ШтрихкодПалеты");
	
	Для каждого Штрихкод Из ШтрихкодыПалет Цикл
		
		БутылкиПалеты = ТаблицаАлкогольнойПродукции.Скопировать(Новый Структура("ШтрихкодПалеты", Штрихкод.ШтрихкодПалеты));
		
		КоробкиПалеты = БутылкиПалеты.Скопировать();
		КоробкиПалеты.Свернуть("ШтрихкодКоробки", "КоличествоУпаковок");
		
		// Палета
		Если ЗначениеЗаполнено(Штрихкод.ШтрихкодПалеты) Тогда
			РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.ШтрихкодПалеты, "Штрихкод");
			Если РезультатПоиска = Неопределено Тогда
				НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
				
				НоваяСтрока.ТипУпаковки 					 = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
				НоваяСтрока.КоличествоПодчиненныхУпаковок 	 = КоробкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхНеЧислилось = КоробкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхВсего 		 = КоробкиПалеты.Количество() + БутылкиПалеты.Количество();
				НоваяСтрока.Представление 					 = Штрихкод.ШтрихкодПалеты;
				НоваяСтрока.Штрихкод						 = Штрихкод.ШтрихкодПалеты;
				
				ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
				ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
				
				ЕГАИС_ДобавитьСтрокуВТаблицуИзменений(ТаблицаИзмененийАлкогольнойПродукции, НоваяСтрока, 1);
				
				СтрокаРодителяПаллета = НоваяСтрока;   
			Иначе
				СтрокаРодителяПаллета = РезультатПоиска;
			КонецЕсли;
			
			Если БутылкиПалеты.Найти(СтатусПроверкиВНаличии, "СтатусПроверки") <> Неопределено 
				ИЛИ БутылкиПалеты.Найти(СтатусПроверкиНеЧислилась, "СтатусПроверки") <> Неопределено Тогда
				СтрокаРодителяПаллета.СтатусПроверки = СтатусПроверкиВНаличии;
			Иначе
				СтрокаРодителяПаллета.СтатусПроверки = СтатусПроверкиОтсутствует;
			КонецЕсли;
			
		Иначе
			СтрокаРодителяПаллета = ДеревоМаркированнойПродукции;
		КонецЕсли;
			
		Для каждого СтрокаКоробки Из КоробкиПалеты Цикл
			
			БутылкиКоробки = БутылкиПалеты.Скопировать(Новый Структура("ШтрихкодКоробки,ШтрихкодПалеты", СтрокаКоробки.ШтрихкодКоробки, Штрихкод.ШтрихкодПалеты)); 
			БутылкиКоробки.Свернуть("АлкогольнаяПродукция,Номенклатура,Характеристика,Серия,Справка2,ШтрихкодБутылки,СтатусПроверки", "КоличествоУпаковок");
			
			ТоварыХарактеристикиКоробки = БутылкиКоробки.Скопировать();
			ТоварыХарактеристикиКоробки.Свернуть("АлкогольнаяПродукция,Номенклатура,Характеристика,Серия,Справка2");
			ЭтоМонотоварнаяКоробка = Ложь;
			Если ТоварыХарактеристикиКоробки.Количество() = 1 Тогда
				ЭтоМонотоварнаяКоробка = Истина;
				АлкогольнаяПродукцияКоробки = ТоварыХарактеристикиКоробки[0].АлкогольнаяПродукция;
				НоменклатураКоробки 		= ТоварыХарактеристикиКоробки[0].Номенклатура;
				ХарактеристикаКоробки 		= ТоварыХарактеристикиКоробки[0].Характеристика;
				СерияКоробки				= ТоварыХарактеристикиКоробки[0].Серия;
				Справка2Коробки				= ТоварыХарактеристикиКоробки[0].Справка2;
			КонецЕсли;
			
			// Коробка			
			Если ЗначениеЗаполнено(СтрокаКоробки.ШтрихкодКоробки) Тогда
				РезультатПоиска = СтрокаРодителяПаллета.Строки.Найти(СтрокаКоробки.ШтрихкодКоробки, "Штрихкод");
				Если РезультатПоиска = Неопределено Тогда
					НоваяСтрока = СтрокаРодителяПаллета.Строки.Добавить();
					
					Если ЭтоМонотоварнаяКоробка Тогда
						НоваяСтрока.ТипУпаковки 					= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); 
						НоваяСтрока.АлкогольнаяПродукция			= АлкогольнаяПродукцияКоробки;
						НоваяСтрока.Номенклатура 					= НоменклатураКоробки;
						НоваяСтрока.Характеристика					= ХарактеристикаКоробки;
						НоваяСтрока.Серия							= СерияКоробки;
						НоваяСтрока.Справка2						= Справка2Коробки;
					Иначе
						НоваяСтрока.ТипУпаковки 					= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка");
					КонецЕсли;
					
					НоваяСтрока.КоличествоПодчиненныхУпаковок 		= БутылкиКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхНеЧислилось	= БутылкиКоробки.Количество();
					НоваяСтрока.КоличествоПодчиненныхВсего 			= БутылкиКоробки.Количество();
					НоваяСтрока.Представление 						= СтрокаКоробки.ШтрихкодКоробки;
					НоваяСтрока.Штрихкод						    = СтрокаКоробки.ШтрихкодКоробки;
					
					ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
					ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").СформироватьПредставлениеСодержимогоУпаковки(НоваяСтрока);
					
					ЕГАИС_ДобавитьСтрокуВТаблицуИзменений(ТаблицаИзмененийАлкогольнойПродукции, НоваяСтрока, 1);
					
					СтрокаРодителяКоробка = НоваяСтрока;
				Иначе
					СтрокаРодителяКоробка = РезультатПоиска;
				КонецЕсли;
				
				Если БутылкиКоробки.Найти(СтатусПроверкиВНаличии, "СтатусПроверки") <> Неопределено 
					ИЛИ БутылкиКоробки.Найти(СтатусПроверкиНеЧислилась, "СтатусПроверки") <> Неопределено Тогда
					СтрокаРодителяКоробка.СтатусПроверки = СтатусПроверкиВНаличии;
				Иначе
					СтрокаРодителяКоробка.СтатусПроверки = СтатусПроверкиОтсутствует;
				КонецЕсли;
			Иначе
				СтрокаРодителяКоробка = СтрокаРодителяПаллета;
			КонецЕсли;
			
			// Бутылки без упаковки добавляем в строку продукции без упаковки
			Если СтрокаРодителяКоробка = ДеревоМаркированнойПродукции И НЕ СтрокаБутылкаБезУпаковки = Неопределено Тогда
				СтрокаРодителяКоробка = СтрокаБутылкаБезУпаковки;
			КонецЕсли;
				
			Для каждого СтрокаБутылки Из БутылкиКоробки Цикл
				
				// Бутылка
				Если ЗначениеЗаполнено(СтрокаБутылки.ШтрихкодБутылки) Тогда
					РезультатПоиска = СтрокаРодителяКоробка.Строки.Найти(СтрокаБутылки.ШтрихкодБутылки, "Штрихкод");
					Если РезультатПоиска = Неопределено Тогда
						НоваяСтрока = СтрокаРодителяКоробка.Строки.Добавить();
						
						НоваяСтрока.СтатусПроверки 					 	= СтрокаБутылки.СтатусПроверки;
						НоваяСтрока.ТипУпаковки 					 	= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
						НоваяСтрока.АлкогольнаяПродукция				= СтрокаБутылки.АлкогольнаяПродукция;
						НоваяСтрока.Номенклатура 					 	= СтрокаБутылки.Номенклатура;
						НоваяСтрока.Характеристика					 	= СтрокаБутылки.Характеристика;
						НоваяСтрока.Серия 								= СтрокаБутылки.Серия;
						НоваяСтрока.Справка2							= СтрокаБутылки.Справка2;
						НоваяСтрока.КоличествоПодчиненныхУпаковок 	 	= 1;
						НоваяСтрока.КоличествоПодчиненныхНеЧислилось 	= 1;
						НоваяСтрока.КоличествоПодчиненныхВсего 		 	= 1;
						НоваяСтрока.Представление 					 	= СтрокаБутылки.ШтрихкодБутылки;
						НоваяСтрока.Штрихкод							= СтрокаБутылки.ШтрихкодБутылки;
						
						ЕГАИС_ДобавитьСтрокуВТаблицуИзменений(ТаблицаИзмененийАлкогольнойПродукции, НоваяСтрока, 1);
						
						ИО_ОбщийМодуль("ПроверкаИПодборПродукцииЕГАИСКлиентСервер").СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока);
					Иначе
						РезультатПоиска.СтатусПроверки = СтрокаБутылки.СтатусПроверки;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла; 
						
		КонецЦикла; 
	
	КонецЦикла;
	
	//ТаблицаХешСумм = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").ПустаяТаблицаХешСумм();
	//Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
	//	Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки) Тогда
	//		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИС").РассчитатьХешСуммыУпаковки(СтрокаДерева, ТаблицаХешСумм, Ложь);
	//	КонецЕсли;
	//КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТоварыБезАкцизныхМарок(Док1СРезультат)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТТНВходящаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	                      |	ТТНВходящаяЕГАИСТовары.Справка2 КАК Справка2,
	                      |	ТТНВходящаяЕГАИСТовары.Количество КАК КоличествоПоДокументу
	                      |ИЗ
	                      |	Документ.ТТНВходящаяЕГАИС.Товары КАК ТТНВходящаяЕГАИСТовары
	                      |ГДЕ
	                      |	ТТНВходящаяЕГАИСТовары.Ссылка = &Ссылка
	                      |	И ТТНВходящаяЕГАИСТовары.АлкогольнаяПродукция.ВидПродукции.Маркируемый = ЛОЖЬ");
		
		Запрос.УстановитьПараметр("Ссылка", Док1СРезультат);
		
		Возврат Запрос.Выполнить().Выгрузить();
	    	
КонецФункции

Процедура ДополнитьДеревоДанныеПроверкиИПодбора(СтрокиФакт, ДанныеПроверкиИПодбора, СтруктураПараметров)
	
	ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
	
	Для каждого СтрокаФакт из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка	
			АлкоПДФ = ?(СтрокаФакт.Свойство("Марка"), СтрокаФакт.Марка, ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, ""));
			
			Если (АлкоПДФ <> "") И (СтрДлина(АлкоПДФ) > 70) Тогда	
				ДобавитьБутылкуВДанныеПроверкиИПодбора(СтрокаФакт, ДеревоМаркированнойПродукции, СтруктураПараметров);  
			КонецЕсли;	
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьБутылкуВДанныеПроверкиИПодбора(СтрокаФакт, ДеревоМаркированнойПродукции, СтруктураПараметров = Неопределено)
	
	НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФакт);
	
	АлкоПДФ = ?(СтрокаФакт.Свойство("Марка"), СтрокаФакт.Марка, ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, ""));
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияАлкогольнойПродукции") <> Неопределено Тогда
		НоваяСтрока.ЗначениеШтрихкода 	= АлкоПДФ;
		НоваяСтрока.СтатусПроверки 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.ВНаличии");
	Иначе
		НоваяСтрока.Штрихкод 			= АлкоПДФ;
		НоваяСтрока.СтатусПроверки 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
	КонецЕсли;
	НоваяСтрока.ПредставлениеСодержимоеУпаковки  = СтрокаФакт.АлкоНаим;
	НоваяСтрока.Представление 	= Строка(АлкоПДФ);
	НоваяСтрока.ТипУпаковки   	= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
	НоваяСтрока.Номенклатура    = НайтиНоменклатуруПоАлкогольнойПродукции(СтрокаФакт.АлкогольнаяПродукция);
	
	// для Исходящей ТТН, заполнить алкопродукцию по марке
	Если Не ЗначениеЗаполнено(НоваяСтрока.АлкогольнаяПродукция) Тогда 
		
		АлкогольнаяПродукция = ПредопределенноеЗначение("Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка");
		
		Если Не ПустаяСтрока(АлкоПДФ) Тогда
			АкцизнаяМарка = НайтиСоздатьАкцизнуюМарку(СтруктураПараметров);
			ДанныеАлкогольнойПродукции = ПолучитьДанныеАлкогольнойПродукцииПоАкцизнойМарке(АкцизнаяМарка);
			Если ДанныеАлкогольнойПродукции <> Неопределено Тогда
				АлкогольнаяПродукция = ДанныеАлкогольнойПродукции.АлкогольнаяПродукция;
			КонецЕсли;
		КонецЕсли;		
		
		Если АлкогольнаяПродукция = ПредопределенноеЗначение("Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка")
			И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда 
			АлкогольнаяПродукция = НайтиАлкогольнуюПродукциюПоНоменклатуре(НоваяСтрока.Номенклатура);
		КонецЕсли;
		
		НоваяСтрока.АлкогольнаяПродукция = АлкогольнаяПродукция;
		НоваяСтрока.ПредставлениеСодержимоеУпаковки  = АлкогольнаяПродукция.Наименование;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
		НайденнаяНоменклатура = НайтиНоменклатуруПоАлкогольнойПродукции(НоваяСтрока.АлкогольнаяПродукция);
		Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
			НоваяСтрока.Номенклатура = НайденнаяНоменклатура;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
  
Процедура ЗаполнитьСтруктуруДанныхПроверкиИПодбора(КоробкиДеревоЗначений, ВозвращаемоеДерево, ДоступныеДляПроверкиУпаковки, ДополнительныеПараметры)
	
	ПолеШтрихкода  = ДополнительныеПараметры.ПолеШтрихкода;
	СтатусПроверки = ДополнительныеПараметры.СтатусыПроверкиНаличияПродукцииИС.Получить("НеПроверялась");
	
	Для каждого СтрокаДерева из КоробкиДеревоЗначений Цикл
	
		НоваяСтрока = ВозвращаемоеДерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);		
		НоваяСтрока.Представление = СтрокаДерева[ПолеШтрихкода];
		
		НоваяСтрока.СтатусПроверки = СтатусПроверки;
		
		ДоступныеДляПроверкиУпаковки.Добавить(СтрокаДерева[ПолеШтрихкода]);
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда                                                                                        			
			ПроверитьЗаполнениеСтроки(НоваяСтрока, СтрокаДерева); //дополнительно			
			ЗаполнитьСтруктуруДанныхПроверкиИПодбора(СтрокаДерева.Строки, НоваяСтрока, ДоступныеДляПроверкиУпаковки, ДополнительныеПараметры); 
	    КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЕГАИС_ЗаполнитьИдентификаторСтрокиТЧ_Товары(СтруктураПараметров)
	
	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;	
	ИмяТЧ			= СтруктураПараметров.ИмяТабличнойЧасти;				
	КолонкиТЧ 		= Док1СРезультат.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты;	
	ТекущаяСтрока 	= СтруктураПараметров.СтрокаДокумента;
	
	Если ЕстьРеквизитВКоллекции(КолонкиТЧ, "ИдентификаторСтроки") И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтроки) Тогда
		ТекущаяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;	

КонецПроцедуры

Процедура ЕГАИС_ТЧ_АкцизныеМарки_УдалитьПустыеАкцизныеМарки(СтруктураПараметров)

	Таблица1С = СтруктураПараметров.ТЧ;			
	
	Икс = Таблица1С.Количество();
	Пока Икс > 0 Цикл
		Икс = Икс - 1;
		Строка = Таблица1С[Икс];
		Если Строка.АкцизнаяМарка.Пустая() Тогда
			Таблица1С.Удалить(Икс);
		КонецЕсли;                                                                                       
	КонецЦикла;	

КонецПроцедуры

Процедура ДополнитьДанныеСтрокиАкцизнойМарки(СтруктураПараметров)
	
	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;
	СтрокаТЧ 		= СтруктураПараметров.СтрокаДокумента;
	СтрокаТСД 		= СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;

	Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНИсходящаяЕГАИС") Тогда
		
		АкцизнаяМарка = НайтиСоздатьАкцизнуюМарку(СтруктураПараметров);
		
		ОрганизацияЕГАИС = Док1СРезультат.Грузоотправитель;
	
		ДанныеМарки = Неопределено;		
		Если ЗначениеЗаполнено(АкцизнаяМарка) Тогда
			ДанныеМарки = ПолучитьДанныеАлкогольнойПродукцииПоАкцизнойМарке(АкцизнаяМарка, ОрганизацияЕГАИС);
		КонецЕсли;
		Если Не ДанныеМарки = Неопределено Тогда
			СтрокаТЧ.Справка2 = ДанныеМарки.Справка2;
			СтрокаТСД.Справка2 = ДанныеМарки.Справка2;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура СкопироватьДеревоЗначений(СтрокиИсточника, СтрокиПриемника)

	Для каждого СтрокаИсточника Из СтрокиИсточника Цикл
		
		СтрокаПриемника = СтрокиПриемника.Добавить();		
		
		ЗаполнитьЗначенияСвойств(СтрокаПриемника, СтрокаИсточника);		
		СкопироватьДеревоЗначений(СтрокаИсточника.Строки, СтрокаПриемника.Строки);
	
	КонецЦикла; 
	
КонецПроцедуры

Функция ЗаполнитьДанныеАкцизныхМарок(СтрокиДерева, СтрокиФакт, СтруктураПараметров, ИмяПоляМарка = "", ЗавершатьПроверку = Ложь, ТаблицаИзмененийАлкогольнойПродукции)
		
	ВерсииОбъектовКонфигурации = СтруктураПараметров.ВерсииОбъектовКонфигурации;
	
	ЕстьВНаличии = Ложь;
	
	Если ПустаяСтрока(ИмяПоляМарка) Тогда
		ИмяПоляМарка = "Марка";
		
		Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
			Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
				
			ИмяПоляМарка = ?(СтрокаФакт.Свойство("Марка") И ЗначениеЗаполнено(СтрокаФакт.Марка), "Марка", "АлкоПДФ");
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Если Метаданные.Перечисления.Найти("СтатусыПроверкиНаличияПродукцииИС") <> Неопределено Тогда
		СтатусВНаличии 	  = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
		СтатусНеЧислилась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
		СтатусОтсутствует = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	Иначе
		СтатусВНаличии 	  = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.ВНаличии");
		СтатусНеЧислилась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.НеЧислилась");
		СтатусОтсутствует = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияАлкогольнойПродукции.Отсутствует");
	КонецЕсли;
	
	Для каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
			НайденныйЭлемент = НайтиЭлементМассива(СтрокиФакт, ИмяПоляМарка, СтрокаДерева[ВерсииОбъектовКонфигурации.ПолеШтрихкода]);
		Иначе
			НайденныйЭлемент = Неопределено;
		КонецЕсли;
		
		Если ЗаполнитьДанныеАкцизныхМарок(СтрокаДерева.Строки, СтрокиФакт, СтруктураПараметров, ИмяПоляМарка, ЗавершатьПроверку, ТаблицаИзмененийАлкогольнойПродукции)
			Или НайденныйЭлемент <> Неопределено Тогда
				
			Если НайденныйЭлемент <> Неопределено Тогда
				СтрокиФакт.Удалить(СтрокиФакт.Найти(НайденныйЭлемент)); //плохо, удаляются исходные данные - чупров
			КонецЕсли;
			
			Если СтрокаДерева.СтатусПроверки <> СтатусВНаличии
				И СтрокаДерева.СтатусПроверки <> СтатусНеЧислилась Тогда
				ЕГАИС_ДобавитьСтрокуВТаблицуИзменений(ТаблицаИзмененийАлкогольнойПродукции, СтрокаДерева, 1);
				
				СтрокаДерева.СтатусПроверки = СтатусВНаличии;
			КонецЕсли;
			
			ЕстьВНаличии = Истина;
		Иначе	
			Если ЗавершатьПроверку Тогда
				Если СтрокаДерева.СтатусПроверки <> СтатусВНаличии
					И СтрокаДерева.СтатусПроверки <> СтатусНеЧислилась
					И СтрокаДерева.СтатусПроверки <> СтатусОтсутствует Тогда
					ЕГАИС_ДобавитьСтрокуВТаблицуИзменений(ТаблицаИзмененийАлкогольнойПродукции, СтрокаДерева, -1);
					
					СтрокаДерева.СтатусПроверки = СтатусОтсутствует;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
		 
	КонецЦикла; 
	
	Возврат ЕстьВНаличии;
	
КонецФункции

Процедура ЕГАИС_ЗаполнитьСтатусПроверки(ДеревоМаркированнойПродукции, СтрокиФакт, СтатусПроверкиВНаличии, ВерсииОбъектовКонфигурации, УровеньДетализации = 3)

	МассивСканированныхШК = Новый Массив;
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ШтрихкодБутылки = ?(СтрокаФакт.Свойство("Марка"), СтрокаФакт.Марка, ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, ""));
		
		ШтрихкодПалеты  = "";
		ШтрихкодКоробки = "";
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда
			ШтрихкодПалеты  = СтрокаФакт.SSCC;
			ШтрихкодКоробки = СтрокаФакт.ИдКоробки;
		Иначе
			ШтрихкодКоробки = СтрокаФакт.SSCC;
		КонецЕсли;
		
		//Если НЕ ЗначениеЗаполнено(ШтрихкодБутылки) Тогда
		//	Продолжить;
		//КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодПалеты)
			И МассивСканированныхШК.Найти(ШтрихкодПалеты) = Неопределено Тогда
			МассивСканированныхШК.Добавить(ШтрихкодПалеты);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодКоробки)
			И МассивСканированныхШК.Найти(ШтрихкодКоробки) = Неопределено Тогда
			МассивСканированныхШК.Добавить(ШтрихкодКоробки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодБутылки)
			И МассивСканированныхШК.Найти(ШтрихкодБутылки) = Неопределено Тогда
			МассивСканированныхШК.Добавить(ШтрихкодБутылки);
		КонецЕсли;
	КонецЦикла;
	
	ЕГАИС_ОтметитьСтатусыВДереве(ДеревоМаркированнойПродукции, МассивСканированныхШК, СтатусПроверкиВНаличии,, ВерсииОбъектовКонфигурации, УровеньДетализации);
	
КонецПроцедуры

Процедура ЕГАИС_ОтметитьСтатусыВДереве(ДеревоМаркированнойПродукции, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, РодительОтмечен = Ложь, ВерсииОбъектовКонфигурации, УровеньДетализации = 3)
	
	Для каждого Строка из ДеревоМаркированнойПродукции.Строки Цикл
									
		Если РодительОтмечен
			ИЛИ НЕ МассивШКВсехУпаковокСТСД.Найти(Строка[ВерсииОбъектовКонфигурации.ПолеШтрихкода]) = Неопределено Тогда
			Строка.СтатусПроверки = СтатусПроверкиВНаличии;
		КонецЕсли;
		
		ПодчиненныеСтроки = Строка.Строки;
		Если ПодчиненныеСтроки.Количество() Тогда
			// Определяем, нужно ли отметить все вложенные упаковки
			Если РодительОтмечен Тогда
				ЕГАИС_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, РодительОтмечен, ВерсииОбъектовКонфигурации, УровеньДетализации);
			ИначеЕсли УровеньДетализации < 3
				И Строка.СтатусПроверки = СтатусПроверкиВНаличии Тогда
				// Логистические упаковки можем различить только по уровню вложенности:
				// 	если в логистическую упаковку вложена другая логистическая упаковка, считаем ее паллетой, иначе - коробкой
				Если ПодчиненныеСтроки.Найти(ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"), "ТипУпаковки") = Неопределено
					И ПодчиненныеСтроки.Найти(ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка"), "ТипУпаковки") = Неопределено Тогда
					ТекущийУровеньДетализации = 2;
				Иначе
					ТекущийУровеньДетализации = 1;
				КонецЕсли;
				
				Если ТекущийУровеньДетализации >= УровеньДетализации Тогда
					ЕГАИС_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, Истина, ВерсииОбъектовКонфигурации, УровеньДетализации);
				Иначе
					ЕГАИС_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии,, ВерсииОбъектовКонфигурации, УровеньДетализации);
				КонецЕсли;
			Иначе
				ЕГАИС_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии,, ВерсииОбъектовКонфигурации, УровеньДетализации);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЕГАИС_ДополнитьСтатусыВДереве(ДеревоМаркированнойПродукции, Статусы, ЗавершатьПроверку)
	
	ЕстьВНаличии = Ложь;
	
	СтатусПроверкиНеПроверялась	= Статусы.СтатусПроверкиНеПроверялась;
	СтатусПроверкиВНаличии 	  	= Статусы.СтатусПроверкиВНаличии;
	СтатусПроверкиНеЧислилась 	= Статусы.СтатусПроверкиНеЧислилась;
	СтатусПроверкиОтсутствует 	= Статусы.СтатусПроверкиОтсутствует;
	
	Для каждого Строка ИЗ ДеревоМаркированнойПродукции.Строки Цикл
		ЭтоУпаковка = НЕ Строка.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
		
		ОтмеченТекущийШтрихкод = Строка.СтатусПроверки = СтатусПроверкиВНаличии
			ИЛИ Строка.СтатусПроверки = СтатусПроверкиНеЧислилась;
		ОтмеченыВложенныеШтрихкоды = ЭтоУпаковка
			И ЕГАИС_ДополнитьСтатусыВДереве(Строка, Статусы, ЗавершатьПроверку);
			
		Если НЕ ОтмеченТекущийШтрихкод Тогда
			// Для упаковок проверяем статусы вложенных позиций
			Если ЭтоУпаковка И ОтмеченыВложенныеШтрихкоды Тогда
				Строка.СтатусПроверки = СтатусПроверкиВНаличии;
				
				ЕстьВНаличии = Истина;
			ИначеЕсли ЗавершатьПроверку Тогда
				Строка.СтатусПроверки = СтатусПроверкиОтсутствует;
			КонецЕсли;
		Иначе
			ЕстьВНаличии = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьВНаличии;
	
КонецФункции

Функция ЕГАИС_ОтметитьОтсутствующиеВДереве(ДеревоМаркированнойПродукции, СтатусПроверкиНеПроверялась, СтатусПроверкиОтсутствует)
	
	Для Каждого Строка из ДеревоМаркированнойПродукции.Строки Цикл
									
		Если Строка.СтатусПроверки = СтатусПроверкиНеПроверялась Тогда
			Строка.СтатусПроверки = СтатусПроверкиОтсутствует;
		КонецЕсли;
			
		Если Строка.Строки.Количество() > 0 Тогда
			ЕГАИС_ОтметитьОтсутствующиеВДереве(Строка, СтатусПроверкиНеПроверялась, СтатусПроверкиОтсутствует);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Процедура ЗаполнитьТаблицуПартионнойПродукции(ТоварыБезАкцизныхМарок, ТаблицаНеМаркируемойПродукции, Товары)

	Для каждого Строка Из ТоварыБезАкцизныхМарок Цикл
		
		НоваяСтрока = ТаблицаНеМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.КоличествоПоДокументу = Строка.Количество;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("АлкогольнаяПродукция", 	Строка.АлкогольнаяПродукция);
		СтруктураПоиска.Вставить("Справка2", 				Строка.Справка2);
		
		СтрокиТЧТовары = Товары.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиТЧТовары.Количество() Тогда											
			НоваяСтрока.КоличествоФактическое = СтрокиТЧТовары[0].КоличествоФакт;																	
		КонецЕсли; 					
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТаблицуПартионнойПродукции_Вариант(ДанныеПартионнойПродукции, ТаблицаНеМаркируемойПродукции)
	
	Для Каждого СтрокаТаблицы Из ДанныеПартионнойПродукции Цикл
		
		НоваяСтрока = ТаблицаНеМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.КоличествоПоДокументу = СтрокаТаблицы.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСоздатьАкцизнуюМарку(СтруктураПараметров, КодАкцизнойМарки = Неопределено, Номенклатура = Неопределено, Характеристика = Неопределено) Экспорт

	ИмяСобытия = "НайтиСоздатьАкцизнуюМарку";
	
	СтрокаТСД = СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	
	Если КодАкцизнойМарки = Неопределено Тогда
		// В новых релизах марка алкоголя находится в поле Марка
		КодАкцизнойМарки = ?(СтрокаТСД.Свойство("Марка"), СтрокаТСД.Марка, ?(СтрокаТСД.Свойство("АлкоПДФ"), СтрокаТСД.АлкоПДФ, ""));
	КонецЕсли;
	
	Попытка
		ПустаяМарка = ПредопределенноеЗначение("Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка");
	Исключение
		// Если в конфигурации нет справочника ШтрихкодыУпаковокТоваров, возвращаем строковый код
		Возврат КодАкцизнойМарки;
	КонецПопытки;
	
	Если НЕ ПустаяСтрока(КодАкцизнойМарки) Тогда
		
		АкцизнаяМарка = Справочники["ШтрихкодыУпаковокТоваров"].НайтиПоРеквизиту("ЗначениеШтрихкода", КодАкцизнойМарки);
		
		Если НЕ ЗначениеЗаполнено(АкцизнаяМарка) Тогда
			
			ТипШтрихкода = ?(СтрДлина(КодАкцизнойМарки) > 70,
				ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.DataMatrix"),
				ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.PDF417"));
			
			АкцизнаяМаркаОбъект 					= Справочники["ШтрихкодыУпаковокТоваров"].СоздатьЭлемент();
			АкцизнаяМаркаОбъект.ТипУпаковки 		= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар");
			АкцизнаяМаркаОбъект.ТипШтрихкода 		= ТипШтрихкода;
			АкцизнаяМаркаОбъект.ЗначениеШтрихкода 	= КодАкцизнойМарки;
			АкцизнаяМаркаОбъект.ДатаУпаковки 		= ТекущаяДата();
			АкцизнаяМаркаОбъект.Ответственный		= ПараметрыСеанса.ТекущийПользователь;
			
			Попытка
				Если СтруктураПараметров.Свойство("СтрокаДокумента") Тогда
					СтрокаДокумента 					= СтруктураПараметров.СтрокаДокумента;
					
					АкцизнаяМаркаОбъект.Номенклатура 	= СтрокаДокумента.Номенклатура;
					АкцизнаяМаркаОбъект.Характеристика 	= СтрокаДокумента.Характеристика;
					АкцизнаяМаркаОбъект.Серия 			= СтрокаДокумента.Серия;
				Иначе
					Если СтрокаТСД.Свойство("ИдТовара")
						И ЗначениеЗаполнено(СтрокаТСД.ИдТовара) И НЕ СтрокаТСД.ИдТовара = "*" Тогда
						АкцизнаяМаркаОбъект.Номенклатура   = Справочники["Номенклатура"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТСД.ИдТовара));
					КонецЕсли;
					Если СтрокаТСД.Свойство("ИдХарактеристики")
						И ЗначениеЗаполнено(СтрокаТСД.ИдХарактеристики) Тогда
						АкцизнаяМаркаОбъект.Характеристика = Справочники["ХарактеристикиНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТСД.ИдХарактеристики));
					КонецЕсли;
					Если СтрокаТСД.Свойство("ИдСерии")
						И ЗначениеЗаполнено(СтрокаТСД.ИдСерии) Тогда
			        	АкцизнаяМаркаОбъект.Серия		   = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТСД.ИдСерии));
					КонецЕсли;
				КонецЕсли;
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ОписаниеОшибки());
			КонецПопытки;
			
			АкцизнаяМаркаОбъект.Записать();
			
			АкцизнаяМарка = АкцизнаяМаркаОбъект.Ссылка;
			
		КонецЕсли;	
		
	Иначе
						
		АкцизнаяМарка = ПустаяМарка;
		
	КонецЕсли;	

	Возврат АкцизнаяМарка;
	
КонецФункции

Функция УстановитьСтатусАкцизныхМарок(МаркиПартионнойПродукции, СтруктураПараметров, НовыйСтатус = Неопределено)
	
	// заглушка, обрабатываем пока только ТТНВходящие
	Если ТипЗнч(СтруктураПараметров.Док1СРезультат) <> Тип("ДокументОбъект.ТТНВходящаяЕГАИС") Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если НовыйСтатус = Неопределено Тогда
		НовыйСтатус = ПредопределенноеЗначение("Перечисление.СтатусыАкцизныхМарок.ВНаличии");
	КонецЕсли;
	
	Организация = СтруктураПараметров.Док1СРезультат.Грузополучатель;
	
	Для Каждого Марка Из МаркиПартионнойПродукции Цикл
		
		АкцизнаяМарка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", Марка.Штрихкод);
		
		Если АкцизнаяМарка.Пустая() Тогда Продолжить; КонецЕсли;
		
		ДанныеМарки = Новый Структура();
		ДанныеМарки.Вставить("ОрганизацияЕГАИС", Организация);
		ДанныеМарки.Вставить("АкцизнаяМарка", АкцизнаяМарка);
		ДанныеМарки.Вставить("Статус", НовыйСтатус);
		ДанныеМарки.Вставить("Справка2", Марка.Справка2);
		ДанныеМарки.Вставить("АлкогольнаяПродукция", Марка.АлкогольнаяПродукция);
		ДанныеМарки.Вставить("Основание", СтруктураПараметров.Док1СРезультат.Ссылка);
		
		РегистрыСведений.АкцизныеМаркиЕГАИС.ВыполнитьЗаписьВРегистр(ДанныеМарки);
	
	КонецЦикла;

КонецФункции

Функция ЕГАИС_ПолучитьАкцизнуюМаркуИзДокумента(СтруктураПараметров)

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	АкцизнаяМарка = ПредопределенноеЗначение("Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка");
	
	Если Док1СРезультат.АкцизныеМарки.Количество() Тогда
		АкцизнаяМарка = Док1СРезультат.АкцизныеМарки[0].АкцизнаяМарка;
	Иначе
		СтрокиФакт	= СтруктураПараметров.ДокументТСД.СтрокиФакт;
		Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
			Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаФакт.КоличествоФакт <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			АлкоПДФ = ?(СтрокаФакт.Свойство("Марка"), СтрокаФакт.Марка, ?(СтрокаФакт.Свойство("АлкоПДФ"), СтрокаФакт.АлкоПДФ, ""));		
			Если НЕ ЗначениеЗаполнено(АлкоПДФ) Тогда
				Продолжить;
			КонецЕсли;
			
			АкцизнаяМарка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", АлкоПДФ);
			Если НЕ АкцизнаяМарка.Пустая() Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
			
	Возврат АкцизнаяМарка;
	
КонецФункции
	
Функция ПолучитьДанныеАлкогольнойПродукцииПоАкцизнойМарке(АкцизнаяМарка, ОрганизацияЕГАИС = Неопределено)
		
	Результат = Неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	АкцизныеМаркиЕГАИС.Статус КАК Статус,
	                      |	АкцизныеМаркиЕГАИС.Справка2 КАК Справка2,
	                      |	АкцизныеМаркиЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	                      |	АкцизныеМаркиЕГАИС.Основание КАК Основание
	                      |ИЗ
	                      |	РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	                      |ГДЕ
	                      |	АкцизныеМаркиЕГАИС.АкцизнаяМарка = &АкцизнаяМарка
	                      |	И АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС");
	
	Запрос.УстановитьПараметр("АкцизнаяМарка", 		АкцизнаяМарка);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", 	ОрганизацияЕГАИС);

	Если НЕ ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС", "ИСТИНА");		
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка;	
	Иначе	
		Результат = Неопределено;	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции 

Функция ПолучитьДанныеОрганизацииЕГАИСПоАкцизнойМарке(АкцизнаяМарка)
		
	Результат = Неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
	                      |ИЗ
	                      |	РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	                      |ГДЕ
	                      |	АкцизныеМаркиЕГАИС.АкцизнаяМарка = &АкцизнаяМарка
	                      |	И АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС.СоответствуетОрганизации");
	
	Запрос.УстановитьПараметр("АкцизнаяМарка", АкцизнаяМарка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ОрганизацияЕГАИС;	
	Иначе	
		Результат = Неопределено;	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция НайтиНоменклатуруПоАлкогольнойПродукции(АлкогольнаяПродукция)

	Результат = Неопределено;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	                      |ГДЕ
	                      |	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция");
	
	Запрос.УстановитьПараметр("АлкогольнаяПродукция", АлкогольнаяПродукция);
	
	Выборка = Запрос.Выполнить().Выбрать();		
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Номенклатура;
	Иначе	
	    Результат = Неопределено;
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

Функция НайтиАлкогольнуюПродукциюПоНоменклатуре(Номенклатура)

	Результат = Неопределено;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция
	                      |ИЗ
	                      |	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	                      |ГДЕ
	                      |	СоответствиеНоменклатурыЕГАИС.Номенклатура = &Номенклатура");
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();		
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.АлкогольнаяПродукция;
	Иначе	
	    Результат = Неопределено;
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

Функция НайтиНоменклатуруПоШтрихкоду(Штрихкод)

	Результат = Неопределено;		
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	Штрихкоды.Владелец КАК Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.Штрихкоды КАК Штрихкоды
	                      |ГДЕ
	                      |	Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура
	                      |	И Штрихкоды.Штрихкод = &Штрихкод");
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Выборка = Запрос.Выполнить().Выбрать();		
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Номенклатура;
	Иначе	
		Результат = Неопределено;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция НайтиСоздатьАлкогольнуюПродукциюЕГАИС(СтруктураПараметров)

	Результат				= Неопределено;
	АлкогольнаяПродукция 	= СтруктураПараметров.СтрокаДокумента.АлкогольнаяПродукция;	
	СтрокаТСД				= СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;	
	АлкоКод 				= СтрокаТСД.АлкоКод;
	
	Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) ИЛИ АлкогольнаяПродукция.ПолучитьОбъект() = Неопределено Тогда
				
		//АлкогольнаяПродукция = Вычислить("Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(АлкоКод)");
		АлкогольнаяПродукция = Справочники["КлассификаторАлкогольнойПродукцииЕГАИС"].НайтиПоКоду(АлкоКод);
		
		Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) ИЛИ АлкогольнаяПродукция.ПолучитьОбъект() = Неопределено Тогда
			
			//НовыйОбъект 						= Вычислить("Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент()");
			НовыйОбъект 						= Справочники["КлассификаторАлкогольнойПродукцииЕГАИС"].СоздатьЭлемент();
			НовыйОбъект.Код 					= АлкоКод;
			НовыйОбъект.Наименование 			= "Новая продукция ЕГАИС " + АлкоКод;
			НовыйОбъект.НаименованиеПолное 		= "Новая продукция ЕГАИС " + АлкоКод;			
			//НовыйОбъект.ОбменДанными.Загрузка 	= Истина; // Ограничение фреш
			
			Попытка
				НовыйОбъект.Записать();
				Результат = НовыйОбъект.Ссылка;
			Исключение
				Результат = Неопределено;
			КонецПопытки; 			
			
		КонецЕсли;
		
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции

Процедура СоздатьСоответствиеНоменклатурыЕГАИС(Номенклатура, АлкогольнаяПродукция)
	
	МенеджерЗаписи 							= РегистрыСведений["СоответствиеНоменклатурыЕГАИС"].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.АлкогольнаяПродукция 	= АлкогольнаяПродукция;
	МенеджерЗаписи.ИдентификаторУпаковки 	= Номенклатура.ЕдиницаИзмерения.Наименование;
	МенеджерЗаписи.Номенклатура 			= Номенклатура;
		
	Попытка
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Записать();
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры 

Процедура ЗаполнитьСтрокуТабличнойЧастиТоварыДокументаЕГАИС(СтруктураПараметров, СоздаватьСоответствиеНоменклатурыЕГАИС = Истина)
	
	ИмяСобытия = "ЗаполнитьСтрокуТабличнойЧастиТоварыДокументаЕГАИС";

	Док1СРезультат	= СтруктураПараметров.Док1СРезультат;	
	СтрокаДокумента = СтруктураПараметров.СтрокаДокумента;
	СтрокаТСД 		= СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	
	// В новых релизах марка алкоголя находится в поле Марка
	АлкоПДФ = ?(СтрокаТСД.Свойство("Марка"), СтрокаТСД.Марка, ?(СтрокаТСД.Свойство("АлкоПДФ"), СтрокаТСД.АлкоПДФ, ""));
		
	МетаданныеНСИ 						= Конф_ПолучитьМетаданныеНСИ();
	ИмяСправочникаНоменклатура 			= МетаданныеНСИ.Номенклатура.ИмяСправочника;		
	ИмяСправочникаАлкогольнаяПродукция 	= МетаданныеНСИ.АлкоНоменклатура.ИмяСправочника;		
	
	// ЕГАИС_ЗаполнитьИдентификаторСтрокиТЧ_Товары(СтруктураПараметров) при загрузке каждой строки обращается к метаданным документа
	Если ПустаяСтрока(СтрокаДокумента.ИдентификаторСтроки) Тогда
		СтрокаДокумента.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	Попытка
		// Заполняем номенклатуру из ИдТовара
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) И СтрокаТСД.ИдТовара <> "*" Тогда
	    	СтрокаДокумента.Номенклатура = Справочники[ИмяСправочникаНоменклатура].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТСД.ИдТовара));
		КонецЕсли;
	Исключение
		// В старых конфигурациях в строке может не быть заполняемых реквизитов табличной части
	КонецПопытки;
	
	АкцизнаяМарка = НайтиСоздатьАкцизнуюМарку(СтруктураПараметров, АлкоПДФ);
	
	Попытка
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаДокумента.Справка2) Тогда
			РеквизитыШапки = Док1СРезультат.Метаданные().Реквизиты;

            Если ЕстьРеквизитВКоллекции(РеквизитыШапки, "ОрганизацияЕГАИС") Тогда
				ОрганизацияЕГАИС = Док1СРезультат.ОрганизацияЕГАИС;
			ИначеЕсли ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНВходящаяЕГАИС") 	И ЕстьРеквизитВКоллекции(РеквизитыШапки, "Грузополучатель") Тогда
				ОрганизацияЕГАИС = Док1СРезультат.Грузополучатель;	
			ИначеЕсли ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ТТНИсходящаяЕГАИС") 	И ЕстьРеквизитВКоллекции(РеквизитыШапки, "Грузоотправитель") Тогда
				ОрганизацияЕГАИС = Док1СРезультат.Грузоотправитель;			
			Иначе	
				ОрганизацияЕГАИС = Справочники[ИмяСправочникаАлкогольнаяПродукция].ПустаяСсылка();
			КонецЕсли;	
			
			ДанныеАлкогольнойПродукции = ПолучитьДанныеАлкогольнойПродукцииПоАкцизнойМарке(АкцизнаяМарка, ОрганизацияЕГАИС);		

            // Заполняем алкогольную продукцию и справку 2 по данным акцизной марки
			Если ДанныеАлкогольнойПродукции <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция) Тогда
					СтрокаДокумента.АлкогольнаяПродукция = ДанныеАлкогольнойПродукции.АлкогольнаяПродукция;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Справка2) Тогда
					СтрокаДокумента.Справка2 = ДанныеАлкогольнойПродукции.Справка2;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Номенклатура)
			И ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция) Тогда
			// Заполняем номенклатуру по алкогольной продукции
			Номенклатура = НайтиНоменклатуруПоАлкогольнойПродукции(СтрокаДокумента.АлкогольнаяПродукция);
			Если Номенклатура <> Неопределено Тогда
				СтрокаДокумента.Номенклатура = Номенклатура;
			КонецЕсли;				
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) Тогда
			// Заполняем номенклатуру по штрихкоду
			Номенклатура = НайтиНоменклатуруПоШтрихкоду(ШтрихкодТСД(СтрокаТСД));
			Если Номенклатура <> Неопределено Тогда
				СтрокаДокумента.Номенклатура = Номенклатура;
			КонецЕсли;						
        КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция)
			И ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) Тогда		
			// Заполняем алкогольную продукцию по номенклатуре
			АлкогольнаяПродукция = НайтиАлкогольнуюПродукциюПоНоменклатуре(СтрокаДокумента.Номенклатура);
			Если АлкогольнаяПродукция <> Неопределено Тогда
				СтрокаДокумента.АлкогольнаяПродукция = АлкогольнаяПродукция;
			КонецЕсли;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция) Тогда
			// Создаем алкогольную продукцию по алкокоду
			АлкогольнаяПродукция = НайтиСоздатьАлкогольнуюПродукциюЕГАИС(СтруктураПараметров);
			Если АлкогольнаяПродукция <> Неопределено Тогда
				СтрокаДокумента.АлкогольнаяПродукция = АлкогольнаяПродукция;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция) Тогда
			// Переносим алкогольную продукцию в строку ТСД
			Если СтрокаТСД.Свойство("АлкогольнаяПродукция") И НЕ ЗначениеЗаполнено(СтрокаТСД.АлкогольнаяПродукция) Тогда
				СтрокаТСД.АлкогольнаяПродукция = СтрокаДокумента.АлкогольнаяПродукция;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.Справка2) Тогда
			// Переносим справку 2 в строку ТСД
			Если СтрокаТСД.Свойство("Справка2") И НЕ ЗначениеЗаполнено(СтрокаТСД.Справка2) Тогда
				СтрокаТСД.Справка2 = СтрокаДокумента.Справка2;
			КонецЕсли;
        КонецЕсли;

		Если СоздаватьСоответствиеНоменклатурыЕГАИС
			И ЗначениеЗаполнено(СтрокаДокумента.АлкогольнаяПродукция)
			И ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) Тогда
			// Создаем соответствие номенклатуры ЕГАИС
			СоздатьСоответствиеНоменклатурыЕГАИС(СтрокаДокумента.Номенклатура, СтрокаДокумента.АлкогольнаяПродукция);
		КонецЕсли;
	Исключение
		// В старых конфигурациях в строке может не быть заполняемхы реквизитов табличной части
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьИдентификаторСтрокиТЧ_АкцизныеМарки(СтруктураПараметров)
	
	ТоварыДокумента						= СтруктураПараметров.Док1СРезультат.Товары;	
	СтрокаДокумента 					= СтруктураПараметров.СтрокаДокумента;	
	СтруктураПоискаКлючаСвязи 			= СтруктураПараметров.СтруктураПоискаКлючаСвязи;
	СтрокаТабличнойЧастиДокументаТСД 	= СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	
	Попытка // Магазин
		
		Если СтруктураПоискаКлючаСвязи <> Неопределено Тогда			
			
			Для Каждого КлючИЗначение из СтруктураПоискаКлючаСвязи Цикл
				Если НЕ ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
					СтруктураПоискаКлючаСвязи.Удалить(КлючИЗначение.Ключ);
				КонецЕсли;
			КонецЦикла;
			
			КодАлкоПродукции = СтруктураПоискаКлючаСвязи.АлкогольнаяПродукция;
			//АлкоПродукция  = Вычислить("Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(КодАлкоПродукции)");
			АлкоПродукция  = Справочники["КлассификаторАлкогольнойПродукцииЕГАИС"].НайтиПоКоду(КодАлкоПродукции);
			Если НЕ АлкоПродукция.Пустая() Тогда
				СтруктураПоискаКлючаСвязи.Вставить("АлкогольнаяПродукция", АлкоПродукция); 
			КонецЕсли;
			
			Если СтруктураПоискаКлючаСвязи.Свойство("Справка2") Тогда
				//СтруктураПоискаКлючаСвязи.Вставить("Справка2", Вычислить("Справочники.Справки2ЕГАИС.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураПоискаКлючаСвязи.Справка2))"));
				СтруктураПоискаКлючаСвязи.Вставить("Справка2", Справочники["Справки2ЕГАИС"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураПоискаКлючаСвязи.Справка2)));
			КонецЕсли;	
			
			НайдСтроки = ТоварыДокумента.НайтиСтроки(СтруктураПоискаКлючаСвязи);
			Если НайдСтроки.Количество() Тогда
				СтрокаДокумента.ИдентификаторСтроки = НайдСтроки[0].ИдентификаторСтроки;
			Иначе 				
				Сообщить("Для акцизной марки " + СтрокаДокумента.АкцизнаяМарка.ЗначениеШтрихкода + " не найдена строка с кодом алкогольной продукции = " + АлкоПродукция.Код);
			КонецЕсли;	
			
		КонецЕсли;
		
	Исключение // Склад
		
		СтруктураПоискаКлючаСвязи = Новый Структура;

 		КодАлкоПродукции = ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("АлкоКод"), СтрокаТабличнойЧастиДокументаТСД.АлкоКод, "");
		//АлкоПродукция = Вычислить("Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(КодАлкоПродукции)");
		АлкоПродукция = Справочники["КлассификаторАлкогольнойПродукцииЕГАИС"].НайтиПоКоду(КодАлкоПродукции);
		Если НЕ АлкоПродукция.Пустая() Тогда
			СтруктураПоискаКлючаСвязи.Вставить("АлкогольнаяПродукция", АлкоПродукция); 
		КонецЕсли;
		
		Если СтрокаДокумента.Справка2 <> Неопределено Тогда
			СтруктураПоискаКлючаСвязи.Вставить("Справка2", СтрокаДокумента.Справка2);
		КонецЕсли;
		
		Если СтруктураПоискаКлючаСвязи <> Неопределено Тогда
			НайдСтроки = ТоварыДокумента.НайтиСтроки(СтруктураПоискаКлючаСвязи);
			Если НайдСтроки.Количество() Тогда
				СтрокаДокумента.ИдентификаторСтроки = НайдСтроки[0].ИдентификаторСтроки;
			КонецЕсли;
		КонецЕсли;
		
	КонецПопытки;		
	
КонецПроцедуры

Функция НайтиЭлементМассива(Массив, Колонка, Значение)

    Результат = Неопределено;
    
	Для каждого Элемент Из Массив Цикл
        Если Элемент.Свойство(Колонка) И Элемент[Колонка] = Значение Тогда
    	    Результат = Элемент;
            Прервать;
        КонецЕсли;
    КонецЦикла; 

    Возврат Результат;
    
КонецФункции

Функция НайтиЭлементыМассива(Массив, СтруктураПоиска)

    НайденныеЭлементы = Новый Массив;
    
	Для каждого Элемент Из Массив Цикл
		
		ЭлементНайден = Истина;
		
		Для каждого КлючИЗначение Из СтруктураПоиска Цикл			
								
			Если НЕ Элемент.Свойство(КлючИЗначение.Ключ) ИЛИ Элемент[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
				ЭлементНайден = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;         
		
		Если ЭлементНайден Тогда
			НайденныеЭлементы.Добавить(Элемент);					
		КонецЕсли; 
		
    КонецЦикла; 

    Возврат НайденныеЭлементы;
    
КонецФункции

Функция ПолучитьФункциональнуюОпциюНаСервере(ИмяФункциональнойОпции)
	
	Если Метаданные.ФункциональныеОпции.Найти(ИмяФункциональнойОпции) <> Неопределено Тогда
		Возврат ПолучитьФункциональнуюОпцию(ИмяФункциональнойОпции);
	Иначе
		Возврат Неопределено;
	КонецЕсли;	

КонецФункции

Функция ПолучитьСсылку(ИмяСправочника, Ид)		
	
	Если Не ЗначениеЗаполнено(Ид) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	Иначе
		Попытка
			Гуид = Новый УникальныйИдентификатор(Ид); 
			Возврат Справочники[ИмяСправочника].ПолучитьСсылку(Гуид);
		Исключение
			Возврат Справочники[ИмяСправочника].ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьПустуюСтруктуруШтрихкодов()
	
	СтруктураШтрихкодов = Новый Структура;
	СтруктураШтрихкодов.Вставить("ШтрихкодПалеты", 	    "");
	СтруктураШтрихкодов.Вставить("ШтрихкодКоробки",     "");
	СтруктураШтрихкодов.Вставить("ШтрихкодБлока", 	    "");
	СтруктураШтрихкодов.Вставить("ШтрихкодГруппы", 	    "");
	СтруктураШтрихкодов.Вставить("ШтрихкодПачки", 	    "");
	СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой",  "");
	СтруктураШтрихкодов.Вставить("ОбъемноСортовойУчет", Ложь);
	
	Возврат СтруктураШтрихкодов;
	
КонецФункции	

Процедура ЗаполнитьСтруктуруШтрихкодовМОТП(СтрокаДереваЗначений, СтруктураШтрихкодов, ПолеШтрихкода = "ЗначениеШтрихкода", НижнийУровень = Ложь)

	КоллекцияКолонок = СтрокаДереваЗначений.Владелец().Колонки;
	ЕстьРеквизитВидУпаковки  = ЕстьРеквизитВКоллекции(СтрокаДереваЗначений.Владелец().Колонки, "ВидУпаковки");
	ЕстьРеквизитТипШтрихкода = ЕстьРеквизитВКоллекции(СтрокаДереваЗначений.Владелец().Колонки, "ТипШтрихкода");
	
	ПредставлениеПроверкиПодчиненных = СтрокаДереваЗначений.ПредставлениеПроверкиПодчиненных;
	ЗначениеШтрихкода = СтрокаДереваЗначений[ПолеШтрихкода];	
	ВидУпаковки	 	  = ?(ЕстьРеквизитВидУпаковки, СтрокаДереваЗначений.ВидУпаковки, "");
	ТипШтрихкода 	  = ?(ЕстьРеквизитТипШтрихкода, СтрокаДереваЗначений.ТипШтрихкода, "");

	// Считаем палетами те коробки, в которые вложены другие коробки
	ЭтоПалета = Ложь;
	
	Если СтрокаДереваЗначений.Строки.Количество() Тогда
		Если ЕстьРеквизитВидУпаковки Тогда
			СтрокаКоробки
				= СтрокаДереваЗначений.Строки.Найти(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"), "ВидУпаковки", Ложь);
			ЭтоПалета = НЕ СтрокаКоробки = Неопределено;
		ИначеЕсли ЕстьРеквизитТипШтрихкода Тогда
			ЭтоПалета = ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.SSCC");
		КонецЕсли;
	КонецЕсли;
	
	//Если ПредставлениеПроверкиПодчиненных = "Палета" ИЛИ ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.SSCC") Тогда
	Если ПредставлениеПроверкиПодчиненных = "Палета" ИЛИ ЭтоПалета Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодПалеты", ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Палета");
		КонецЕсли;
		
	ИначеЕсли ПредставлениеПроверкиПодчиненных = "Коробка"
		ИЛИ ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая") Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодКоробки", ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Коробка");
		КонецЕсли;
		
	ИначеЕсли ПредставлениеПроверкиПодчиненных = "Блок"
		ИЛИ ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодБлока", ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Блок");
		КонецЕсли;
		
	ИначеЕсли ПредставлениеПроверкиПодчиненных = "Пачка"
		ИЛИ ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодПачки", ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Пачка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтруктуруШтрихкодовИСМП(СтрокаДереваЗначений, СтруктураШтрихкодов, ПолеШтрихкода = "ЗначениеШтрихкода", НижнийУровень = Ложь)

	ЕстьРеквизитВидУпаковки = ЕстьРеквизитВКоллекции(СтрокаДереваЗначений.Владелец().Колонки, "ВидУпаковки");
	
	ПредставлениеПроверкиПодчиненных = СтрокаДереваЗначений.ПредставлениеПроверкиПодчиненных;
	ЗначениеШтрихкода 				 = СтрокаДереваЗначений[ПолеШтрихкода];	
	ТипУпаковки						 = СтрокаДереваЗначений.ТипУпаковки;
	ВидУпаковки						 = ?(ЕстьРеквизитВидУпаковки, СтрокаДереваЗначений.ВидУпаковки, "");
	ОбъемноСортовойУчет				 = ЕстьРеквизитВидУпаковки И СтрокаДереваЗначений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ОбъемноСортовойУчет");
	
	// Нет смысла использовать ТипШтрихкода, т.к. он совпадает для коробок и палет
	
	// Считаем палетами те коробки, в которые вложены другие коробки
	ЭтоПалета = Ложь;
	Если СтрокаДереваЗначений.Строки.Количество() Тогда		
		СтрокаКоробки = Неопределено;
		Если ЕстьРеквизитВидУпаковки Тогда
			СтрокаКоробки = СтрокаДереваЗначений.Строки.Найти(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"), "ВидУпаковки", Ложь);
		Иначе	
			// Раньше ВидУпаковки не заполнялся, в старых документах может быть пусто
			СтрокаКоробки = СтрокаДереваЗначений.Строки.Найти(ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"), "ТипУпаковки", Ложь);	
		КонецЕсли;
		
		Если СтрокаКоробки <> Неопределено Тогда
			ЭтоПалета = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ПредставлениеПроверкиПодчиненных = "Палета" ИЛИ ЭтоПалета Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодПалеты", 	ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Палета");
		КонецЕсли;
		
	ИначеЕсли ОбъемноСортовойУчет Тогда	
		
		СтруктураШтрихкодов.Вставить("ШтрихкодПачки", 		ЗначениеШтрихкода);
		СтруктураШтрихкодов.Вставить("ОбъемноСортовойУчет", ОбъемноСортовойУчет);
		
	ИначеЕсли ЕстьРеквизитВидУпаковки
		И (ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая") ИЛИ ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор")) Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодГруппы", ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Группа");
		КонецЕсли;
		
	ИначеЕсли ПредставлениеПроверкиПодчиненных = "Коробка" 
		ИЛИ ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая")
		ИЛИ (ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка")
				И НЕ ОбъемноСортовойУчет) Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодКоробки", ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Коробка");
		КонецЕсли;
		
	ИначеЕсли (ВРег(ПредставлениеПроверкиПодчиненных = "ПАЧКА") ИЛИ ВРег(ПредставлениеПроверкиПодчиненных) = "ПАРА")
		ИЛИ ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская")
		ИЛИ ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		
		СтруктураШтрихкодов.Вставить("ШтрихкодПачки", 	ЗначениеШтрихкода);
		Если НижнийУровень Тогда
			СтруктураШтрихкодов.Вставить("ВидУпаковкиСтрокой", "Пачка");
		КонецЕсли;
		
	КонецЕсли;			
	
КонецПроцедуры

Процедура ПолучитьЛистьяДереваЗначений(СтрокиДереваЗначений, Листья, УровеньДетализации = 4)
	
	Перем КоллекцияКолонок, ЕстьРеквизитВидУпаковки, ЕстьРеквизитТипШтрихкода;
	
	СтатусПроверкиНеЧислилась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");

	Для каждого СтрокаДереваЗначений Из СтрокиДереваЗначений Цикл
		
		ДобавитьСтрокуВДерево = Ложь;
		
		Попытка
			ПрочаяЗонаПересчетаПродукцииИСМП = СтрокаДереваЗначений.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПродукцияБезУпаковки")
				ИЛИ СтрокаДереваЗначений.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки")
				ИЛИ СтрокаДереваЗначений.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока");
		Исключение
			ПрочаяЗонаПересчетаПродукцииИСМП = Ложь;
		КонецПопытки;
		
		Если ПрочаяЗонаПересчетаПродукцииИСМП Тогда
			//
		ИначеЕсли НЕ СтрокаДереваЗначений.Строки.Количество() Тогда
			ДобавитьСтрокуВДерево = Истина;
		ИначеЕсли УровеньДетализации < 4 Тогда
			
			Если КоллекцияКолонок = Неопределено Тогда
				КоллекцияКолонок 		 = СтрокаДереваЗначений.Владелец().Колонки;
				ЕстьРеквизитВидУпаковки  = ЕстьРеквизитВКоллекции(СтрокаДереваЗначений.Владелец().Колонки, "ВидУпаковки");
				ЕстьРеквизитТипШтрихкода = ЕстьРеквизитВКоллекции(СтрокаДереваЗначений.Владелец().Колонки, "ТипШтрихкода");
			КонецЕсли;
				
			ВидУпаковки	 = ?(ЕстьРеквизитВидУпаковки, СтрокаДереваЗначений.ВидУпаковки, "");
			ТипШтрихкода = ?(ЕстьРеквизитТипШтрихкода, СтрокаДереваЗначений.ТипШтрихкода, "");
				
			// Считаем палетами те коробки, в которые вложены другие коробки
			ЭтоПалета = Ложь;
				
			Если СтрокаДереваЗначений.Строки.Количество() Тогда
				Если ЕстьРеквизитВидУпаковки Тогда
					СтрокаКоробки
						= СтрокаДереваЗначений.Строки.Найти(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"), "ВидУпаковки", Ложь);
					ЭтоПалета = НЕ СтрокаКоробки = Неопределено;
				ИначеЕсли ЕстьРеквизитТипШтрихкода Тогда
					ЭтоПалета = ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.SSCC");
				КонецЕсли;
			КонецЕсли;
			
			//Если ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.SSCC") Тогда
			Если ЭтоПалета Тогда
				ТекущийУровеньДетализации = 1;
			ИначеЕсли ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая") Тогда
				ТекущийУровеньДетализации = 2;
			ИначеЕсли ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
				ИЛИ ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор") Тогда
				ТекущийУровеньДетализации = 3;
			ИначеЕсли ЕстьРеквизитВидУпаковки И ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
				ТекущийУровеньДетализации = 4;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ТекущийУровеньДетализации >= УровеньДетализации Тогда
				ДобавитьСтрокуВДерево = Истина;	
			КонецЕсли;
		КонецЕсли;
		
		//Если статус проверки НеЧислилось, то этих строк не должно быть в плане.
		Если НЕ ДобавитьСтрокуВДерево Тогда
			ПолучитьЛистьяДереваЗначений(СтрокаДереваЗначений.Строки, Листья, УровеньДетализации);
		ИначеЕсли СтрокаДереваЗначений.СтатусПроверки <> СтатусПроверкиНеЧислилась Тогда
			Листья.Добавить(СтрокаДереваЗначений);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьДеревоМаркированнойПродукции(ДеревоМаркированнойПродукции, ТаблицаМаркированнойПродукции, ШтрихкодыПалет, ШтрихкодыКоробок, ШтрихкодыБлоков)	
	
	// заполнение статусов пачек
	Для каждого СтрокаТаблицы Из ТаблицаМаркированнойПродукции Цикл
		
		СтрокаДерева = ДеревоМаркированнойПродукции.Строки.Найти(СтрокаТаблицы.ШтрихкодПачки, "ЗначениеШтрихкода", Истина);
		Если СтрокаДерева <> Неопределено  Тогда
			СтрокаДерева.СтатусПроверки = СтрокаТаблицы.СтатусПроверки;								
		КонецЕсли; 		
		
	КонецЦикла; 	
	
	// заполнение статусов палет
	Для каждого Штрихкод Из ШтрихкодыПалет Цикл
		СтрокаДерева = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.Ключ, "ЗначениеШтрихкода", Истина);
		Если СтрокаДерева <> Неопределено Тогда
			СтрокаДерева.СтатусПроверки = Штрихкод.Значение;								
		КонецЕсли; 			
	КонецЦикла; 
	
	// заполнение статусов коробок
	Для каждого Штрихкод Из ШтрихкодыКоробок Цикл
		СтрокаДерева = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.Ключ, "ЗначениеШтрихкода", Истина);
		Если СтрокаДерева <> Неопределено Тогда
			СтрокаДерева.СтатусПроверки = Штрихкод.Значение;								
		КонецЕсли; 			
	КонецЦикла; 	
	
	// заполнение статусов блоков
	Для каждого Штрихкод Из ШтрихкодыБлоков Цикл
		СтрокаДерева = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.Ключ, "ЗначениеШтрихкода", Истина);
		Если СтрокаДерева <> Неопределено Тогда
			СтрокаДерева.СтатусПроверки = Штрихкод.Значение;								
		КонецЕсли; 			
	КонецЦикла; 		
	
КонецФункции	

// Сохраняет переданное значение данных проверки и подбора табачной продукции для переданного документа
//
// Параметры:
//	ПроверяемыйДокумент - ДокументСсылка - ссылка на проверяемый документ	
//	ДанныеПроверкиИПодбора - ХранилищеЗначения - содержит сохраняемые данные проверки и подбора
Процедура СохранитьДанныеПроверкиИПодбора(ПроверяемыйДокумент, ДанныеПроверкиИПодбора) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	НаборЗаписей = РегистрыСведений.СтатусыПроверкиИПодбораДокументовМОТП.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ПроверяемыйДокумент);

	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() Тогда
		Запись = НаборЗаписей[0];		
	Иначе
		Запись = НаборЗаписей.Добавить();
		Запись.Документ               = ПроверяемыйДокумент;		
		Запись.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Выполняется");
		Запись.ТребуемоеДействиеЭДО   = ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить");
	КонецЕсли; 			
	
	Запись.ДанныеПроверкиИПодбора = ДанныеПроверкиИПодбора;
	
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

