Процедура ДобавитьСтрокиВДеревоТабачнойПродукцииМП(ДеревоМаркированнойПродукции, ТаблицаМаркированнойПродукции, ТаблицаМаркированнойПродукцииПлана, ТаблицаИзмененийТабачнойПродукции = Неопределено, ВидПродукцииИС = Неопределено, ДетализацияСтруктурыХранения = Неопределено)
	
	ЕстьМетаданныеВидыУпаковокИС = Метаданные.Перечисления.Найти("ВидыУпаковокИС") <> Неопределено;
	
	ДетализацияПачки = Неопределено;
	ДетализацияБлокиСПачками = Неопределено;
	
	// При необходимости добавить перечисления и значения перечисления из старых релизов
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		ЗначенияПеречисления = Метаданные.Перечисления["ДетализацияСтруктурыХраненияИС"].ЗначенияПеречисления;
		Если ЗначенияПеречисления.Найти("ПотребительскиеУпаковки") <> Неопределено Тогда
			ДетализацияПачки = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки");
		КонецЕсли;
		Если ЗначенияПеречисления.Найти("ГрупповыеУпаковкиСПотребительскими") <> Неопределено Тогда
			ДетализацияБлокиСПачками = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковкиСПотребительскими");
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("ДеревоМаркированнойПродукции", ДеревоМаркированнойПродукции);
	ДанныеДокумента.Вставить("ВидМаркируемойПродукции", 	 ВидПродукцииИС);
	ДанныеДокумента.Вставить("СтрокаПачкиБезБлока", 		 Неопределено);
	ДанныеДокумента.Вставить("СтрокаБлокиБезКоробки", 		 Неопределено);	
		
	// Добавим строку пачки без блока, если её нет
	СтрокаПачкиБезБлока = Неопределено;
	Если ДетализацияСтруктурыХранения <> ДетализацияПачки Тогда
		ЕстьСтрокаПачкиБезБлока = Ложь;
		Для Каждого СтрокаДереваМаркированнойПродукции Из ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].ПачкиБезБлока Тогда
				СтрокаПачкиБезБлока = СтрокаДереваМаркированнойПродукции;
				ЕстьСтрокаПачкиБезБлока = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьСтрокаПачкиБезБлока Тогда
			СтрокаПачкиБезБлока = ДобавленнаяСтрокаПачкиБезБлока(ДанныеДокумента);
		КонецЕсли;
	КонецЕсли;
	
	// Добавим строку блоки без коробки, если её нет
	СтрокаБлокиБезКоробки = Неопределено;
	Если ДетализацияСтруктурыХранения <> ДетализацияПачки
		И ДетализацияСтруктурыХранения <> ДетализацияБлокиСПачками Тогда
		ЕстьСтрокаБлокиБезКоробки = Ложь;
		Для Каждого СтрокаДереваМаркированнойПродукции Из ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = Перечисления["ПрочиеЗоныПересчетаПродукцииИСМП"].БлокиБезКоробки Тогда
				СтрокаБлокиБезКоробки = СтрокаДереваМаркированнойПродукции;
				ЕстьСтрокаБлокиБезКоробки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьСтрокаБлокиБезКоробки Тогда
			СтрокаБлокиБезКоробки = ДобавленнаяСтрокаБлокиБезКоробки(ДанныеДокумента);
		КонецЕсли;
	КонецЕсли;
	
	СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");									
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");
	
	КоллекцияКолонок = ДеревоМаркированнойПродукции.Колонки;
	ИмяКолонкиКоличествоПодчиненныхПачек = ?(КоллекцияКолонок.Найти("КоличествоПодчиненныхПотребительскихУпаковок") <> Неопределено,
		"КоличествоПодчиненныхПотребительскихУпаковок", "КоличествоПодчиненныхПачек");
	ИмяКолонкиКоличествоПодчиненныхБлоков = ?(КоллекцияКолонок.Найти("КоличествоПодчиненныхГрупповыхУпаковок") <> Неопределено,
		"КоличествоПодчиненныхГрупповыхУпаковок", "КоличествоПодчиненныхБлоков");
	ИмяКолонкиНеПересчитыватьКоличествоПотребительскихУпаковок = ?(КоллекцияКолонок.Найти("НеПересчитыватьКоличествоПотребительскихУпаковок") <> Неопределено,
		"НеПересчитыватьКоличествоПотребительскихУпаковок", "НеПересчитыватьКоличествоПачек");
	
	ЕстьКолонкаКоличествоПотребительскихУпаковок = ТаблицаМаркированнойПродукции.Колонки.Найти("КоличествоПотребительскихУпаковок") <> Неопределено;
	
	Попытка
		ПараметрыНормализацииКМ = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер").НастройкиРазбораКодаМаркировкиДляХэшаНормализации();
	Исключение
		ПараметрыНормализацииКМ = Неопределено;
	КонецПопытки;
	
	НастройкиРазбораКМ = ИО_НастройкиРазбораКодаМаркировки(ВидПродукцииИС);
	
	ШтрихкодыПалет = ТаблицаМаркированнойПродукции.Скопировать(,"ШтрихкодПалеты");
	ШтрихкодыПалет.Свернуть("ШтрихкодПалеты");
	
	Для каждого Штрихкод Из ШтрихкодыПалет Цикл
		
		ПачкиПалеты = ТаблицаМаркированнойПродукции.Скопировать(Новый Структура("ШтрихкодПалеты", Штрихкод.ШтрихкодПалеты));
		
		КоробкиПалеты = ПачкиПалеты.Скопировать();
		КоробкиПалеты.Свернуть("ШтрихкодКоробки", "КоличествоУпаковок");
		
		БлокиПалеты = ПачкиПалеты.Скопировать();
		БлокиПалеты.Свернуть("ШтрихкодБлока", "КоличествоУпаковок");
		
		//Палета
		
		Если ЗначениеЗаполнено(Штрихкод.ШтрихкодПалеты) Тогда
			РезультатПоиска = ДеревоМаркированнойПродукции.Строки.Найти(Штрихкод.ШтрихкодПалеты, "Штрихкод");
			Если РезультатПоиска = Неопределено Тогда
				НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
				// заполняем реквизиты палеты
				
				НоваяСтрока.ПредставлениеПроверкиПодчиненных 		= "Палета";
				НоваяСтрока.ТипУпаковки 					 		= ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"); // или мультитоварная, как определить?
				НоваяСтрока.КоличествоПодчиненныхУпаковок 	 		= КоробкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхНеЧислилось 		= КоробкиПалеты.Количество();
				НоваяСтрока.Штрихкод 				 		 		= Штрихкод.ШтрихкодПалеты;
				НоваяСтрока.Представление 					 		= Штрихкод.ШтрихкодПалеты;
				НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхПачек]	= ПачкиПалеты.Количество();
				НоваяСтрока.КоличествоПодчиненныхВсего 		 		= КоробкиПалеты.Количество() + БлокиПалеты.Количество() + ПачкиПалеты.Количество();
				НоваяСтрока[ИмяКолонкиКоличествоПодчиненныхБлоков] 	= БлокиПалеты.Количество();
				
