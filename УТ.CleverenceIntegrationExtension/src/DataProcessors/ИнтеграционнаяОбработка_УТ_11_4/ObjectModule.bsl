//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ТТНИсходящаяЕГАИС_ПослеЗаполненияДокумента		(СтруктураПараметров) Экспорт

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);	

	Если НЕ ЗначениеЗаполнено(Док1СРезультат.Грузоотправитель) Тогда
		Док1СРезультат.Поставщик 		= ПолучитьДанныеОрганизацииЕГАИСПоАкцизнойМарке(ЕГАИС_ПолучитьАкцизнуюМаркуИзДокумента(СтруктураПараметров));
		Док1СРезультат.Грузоотправитель = Док1СРезультат.Поставщик;
	КонецЕсли;
	
	// Пересчет сумм в ТЧ Товары
	СтруктураДействий = Новый Структура("ПересчитатьСумму");
	Для каждого ТекСтрока ИЗ Док1СРезультат.Товары Цикл
		ТекущаяСтрокаСтруктура = УТ_11_2_ПолучитьТекущуюСтрокуСтруктурой(ТекСтрока, СтруктураДействий);
		
		ИО_ОбщийМодуль("ОбработкаТабличнойЧастиСервер").ОбработатьСтрокуТЧ(ТекущаяСтрокаСтруктура, СтруктураДействий, Неопределено);
		
		ЗаполнитьЗначенияСвойств(ТекСтрока, ТекущаяСтрокаСтруктура);
	КонецЦикла;
	
	ТТНВходящаяЕГАИС_ТЧ_Товары_ЗаполнитьКоличествоФакт(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("КритическаяОшибка", Истина); 
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "Ошибка заполнения данных проверки и подбора алкогольной продукции!");
	
	// ТТНВходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров);
	
	ТТНИсходящаяЕГАИС_ПроверитьАкцизныеМарки(СтруктураПараметров);
	
	// ТТНИсходящаяЕГАИС_ЗавершениеПроверки(СтруктураПараметров);
	
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "");
	
