Функция ПолучитьСодержимоеТУ(ЗначениеШтрихкода) Экспорт
	
	// 1. Остатки
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОстатки();
	Запрос.УстановитьПараметр("Ссылка", НайтиУпаковкуТоваровПоШтрихкоду(ЗначениеШтрихкода, Истина));
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаЗаменыGUID = Новый ТаблицаЗначений;
	ТаблицаЗаменыGUID.Колонки.Добавить("КолонкаСсылка");
	ТаблицаЗаменыGUID.Колонки.Добавить("КолонкаGUID");
	
	Для каждого Колонка Из ТаблицаОстатков.Колонки Цикл
		Если Найти(Колонка.Имя, "_GUID") Тогда
			НоваяСтрока = ТаблицаЗаменыGUID.Добавить();
			НоваяСтрока.КолонкаСсылка = Колонка.Имя;
			НоваяСтрока.КолонкаGUID   = СтрЗаменить(Колонка.Имя, "_GUID", "");
			ТаблицаОстатков.Колонки.Добавить(НоваяСтрока.КолонкаGUID);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТаблицы ИЗ ТаблицаОстатков Цикл
		// Заменяем ссылки на текстовые гуиды
		Для Каждого СтрокаЗамены Из ТаблицаЗаменыGUID Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[СтрокаЗамены.КолонкаСсылка]) Тогда
				СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = XMLСтрока(СтрокаТаблицы[СтрокаЗамены.КолонкаСсылка]);
			Иначе
				СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = ""; // В MS нельзя отправлять значения "Неопределено" и "NULL", можно только значения примитивных типов
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Удаляем колонки с ссылками
	Для каждого СтрокаЗамены ИЗ ТаблицаЗаменыGUID Цикл
		ТаблицаОстатков.Колонки.Удалить(СтрокаЗамены.КолонкаСсылка);
	КонецЦикла;
	
	Возврат ТаблицаОстатков;
	
КонецФункции

Функция ПолучитьСтруктуруВложенностейТУ(ЗначениеШтрихкода) Экспорт
	
	// 2. Транспортные упаковки
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаУпаковки();
	Запрос.УстановитьПараметр("Ссылка", НайтиУпаковкуТоваровПоШтрихкоду(ЗначениеШтрихкода, Истина));
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаУпаковок = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаЗаменыGUID = Новый ТаблицаЗначений;
	ТаблицаЗаменыGUID.Колонки.Добавить("КолонкаСсылка");
	ТаблицаЗаменыGUID.Колонки.Добавить("КолонкаGUID");
	
	Для каждого Колонка Из ТаблицаУпаковок.Колонки Цикл
		Если Найти(Колонка.Имя, "_GUID") Тогда
			НоваяСтрока = ТаблицаЗаменыGUID.Добавить();
			НоваяСтрока.КолонкаСсылка = Колонка.Имя;
			НоваяСтрока.КолонкаGUID   = СтрЗаменить(Колонка.Имя, "_GUID", "");
			ТаблицаУпаковок.Колонки.Добавить(НоваяСтрока.КолонкаGUID);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТаблицы ИЗ ТаблицаУпаковок Цикл
		// Заменяем ссылки на текстовые гуиды
		Для Каждого СтрокаЗамены Из ТаблицаЗаменыGUID Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[СтрокаЗамены.КолонкаСсылка]) Тогда
				СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = XMLСтрока(СтрокаТаблицы[СтрокаЗамены.КолонкаСсылка]);
			Иначе
				СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = ""; // В MS нельзя отправлять значения "Неопределено" и "NULL", можно только значения примитивных типов
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Удаляем колонки с ссылками
	Для каждого СтрокаЗамены ИЗ ТаблицаЗаменыGUID Цикл
		ТаблицаУпаковок.Колонки.Удалить(СтрокаЗамены.КолонкаСсылка);
	КонецЦикла;
	
	Возврат ТаблицаУпаковок;
	
КонецФункции

