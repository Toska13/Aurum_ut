//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_4_ВозвратТоваровМеждуОрганизациями_ПослеЗаполненияСтрокиТЧ_Товары	(СтруктураПараметров) Экспорт

	ДобавленаНоваяСтрока = Не УТ_11_2_Общий_ПослеЗаполненияСтрокиТЧ(СтруктураПараметров);
	
	УТ_11_2_ЗаполнитьЦенуВСтрокеТабличнойЧасти(СтруктураПараметров, ДобавленаНоваяСтрока);
	
КонецПроцедуры

// Вызывается при загрузке табличной части Товары документа ВозвратТоваровМеждуОрганизациями из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура                 - содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект               - загружаемый документ 1С
//		* ДокументТСД - Структура                       - содержит данные документа Mobile Smarts
//		* ИмяТабличнойЧасти - Строка                    - имя загружаемой табличной части документа 1С
//		* СтрокаДокумента - Неопределено                - данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_4_ВозвратТоваровМеждуОрганизациями_ПослеЗаполненияТЧ_Товары			(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);
	
    Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	ТабличнаяЧасть = СтруктураПараметров.ТЧ;
	
	СтруктураЗаполненияСтавкиНДС = УТ_11_4_СтруктураЗаполненияСтавкиНДС(СтруктураПараметров);
	СтруктураПересчетаСуммыНДС = УТ_11_4_СтруктураПересчетаСуммыНДСВСтрокеТЧ(Док1СРезультат);	
	
	Для каждого ТекущаяСтрока ИЗ ТабличнаяЧасть Цикл
		СтруктураДействий = Новый Структура;
		
		Если ТекущаяСтрока.СтавкаНДС.Пустая() Тогда 
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", СтруктураЗаполненияСтавкиНДС);
		КонецЕсли;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", 	ТекущаяСтрока.Характеристика);
		СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС",  					СтруктураПересчетаСуммыНДС);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", 					Новый Структура("ЦенаВключаетНДС", Док1СРезультат.ЦенаВключаетНДС));
		СтруктураДействий.Вставить("ПересчитатьСумму");
		
		УТ_11_2_ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Новый Структура("ДатаОтгрузки", Док1СРезультат.Дата));
	КонецЦикла;
	
	УТ_11_4_ИСМП_Товары_ПослеЗаполненияТЧ(СтруктураПараметров);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область УТ_11_4_ПереагрегацияТоваров

Процедура УТ_11_4_ПереагрегацияАлкогольнойПродукции(СтруктураПараметров) Экспорт
	
	ИмяСобытия = "УТ_11_4_ПереагрегацияТоваров";
	
	ДокументТСД   = СтруктураПараметров.ДокументТСД;
	СтрокиФакт	  = ДокументТСД.СтрокиФакт;
	КоробкиПалеты = ДокументТСД.КоробкиПалеты;
	
	// Определяем новые упаковки перемещаемых штрихкодов
	ТаблицаНовыхУпаковок = Новый ТаблицаЗначений;
	ТаблицаНовыхУпаковок.Колонки.Добавить("ШтрихкодМарки",   Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	ТаблицаНовыхУпаковок.Колонки.Добавить("ШтрихкодКоробки", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	ТаблицаНовыхУпаковок.Колонки.Добавить("ШтрихкодПалеты",  Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	
	Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		ШтрихкодМарки	= "";
		ШтрихкодКоробки = "";
		ШтрихкодПалеты	= "";
		
		Если СтрокаФакт.Свойство("Марка",	  ШтрихкодМарки) Тогда КонецЕсли;
		Если СтрокаФакт.Свойство("ИдКоробки", ШтрихкодКоробки) Тогда КонецЕсли;
		Если СтрокаФакт.Свойство("SSCC",	  ШтрихкодПалеты) Тогда КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодМарки) И ЗначениеЗаполнено(ШтрихкодКоробки) Тогда
			НайденнаяСтрока = ТаблицаНовыхУпаковок.Найти(ШтрихкодМарки, "ШтрихкодМарки");
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = ТаблицаНовыхУпаковок.Добавить();
				
				// Акцизную марку при необходимости создаем сразу
				АкцизнаяМарка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", ШтрихкодМарки);
				Если АкцизнаяМарка.Пустая() Тогда
					АкцизнаяМарка = НайтиСоздатьАкцизнуюМарку(Новый Структура("СтрокаТабличнойЧастиДокументаТСД", СтрокаФакт), ШтрихкодМарки);
				КонецЕсли;
			КонецЕсли;
			
			НайденнаяСтрока.ШтрихкодМарки	= ШтрихкодМарки;
			НайденнаяСтрока.ШтрихкодКоробки = ШтрихкодКоробки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодКоробки) И ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
			НайденнаяСтрока = ТаблицаНовыхУпаковок.Найти(ШтрихкодКоробки, "ШтрихкодКоробки");
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = ТаблицаНовыхУпаковок.Добавить();
			КонецЕсли;
			
			НайденнаяСтрока.ШтрихкодКоробки = ШтрихкодКоробки;
			НайденнаяСтрока.ШтрихкодПалеты	= ШтрихкодПалеты;
		КонецЕсли;
	КонецЦикла;
	
	КоробкиПалеты = ИСМП_ПолучитьШтрихкодыКоробокПалетВТаблицеКоробкиПалеты(КоробкиПалеты);
	Для каждого КоробкаПалета ИЗ КоробкиПалеты Цикл
		НайденнаяСтрока = ТаблицаНовыхУпаковок.Найти(КоробкаПалета.Ключ, "ШтрихкодКоробки");
		Если НайденнаяСтрока = Неопределено Тогда
			НайденнаяСтрока = ТаблицаНовыхУпаковок.Добавить();
		КонецЕсли;	
		
		НайденнаяСтрока.ШтрихкодКоробки = КоробкаПалета.Ключ;
		НайденнаяСтрока.ШтрихкодПалеты	= КоробкаПалета.Значение;
	КонецЦикла;
	
	// Определяем исходные упаковки перемещаемых штрихкодов
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Штрихкод КАК Штрихкод,
	|	ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ШтрихкодыУпаковокТоваровВложенныеШтрихкоды
	|ГДЕ
	|	ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Штрихкод.ЗначениеШтрихкода В (&ПеремещаемыеМарки)
	|;
	|
	|ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Штрихкод КАК Штрихкод,
	|	ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ШтрихкодыУпаковокТоваровВложенныеШтрихкоды
	|ГДЕ
	|	ШтрихкодыУпаковокТоваровВложенныеШтрихкоды.Штрихкод.ЗначениеШтрихкода В (&ПеремещаемыеКоробки)";
	Запрос.УстановитьПараметр("ПеремещаемыеМарки", 	 ТаблицаНовыхУпаковок.ВыгрузитьКолонку("ШтрихкодМарки"));
	Запрос.УстановитьПараметр("ПеремещаемыеКоробки", ТаблицаНовыхУпаковок.ВыгрузитьКолонку("ШтрихкодКоробки"));
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	СоздаватьЭлементыШУИТ = Истина;
	
	МассивПараметров = Новый Массив;
	
	// Перемещаем марки в новые коробки
	ПараметрыПереагрегации = Новый Структура;
	ПараметрыПереагрегации.Вставить("ИмяПоляУпаковка", "ШтрихкодКоробки");
	ПараметрыПереагрегации.Вставить("ИмяПоляШтрихкод", "ШтрихкодМарки");
	ПараметрыПереагрегации.Вставить("ТаблицаСтарыхУпаковок", РезультатЗапроса[0].Выгрузить());
	МассивПараметров.Добавить(ПараметрыПереагрегации);
	
	// Перемещаем коробки в новые палеты
	ПараметрыПереагрегации = Новый Структура;
	ПараметрыПереагрегации.Вставить("ИмяПоляУпаковка", "ШтрихкодПалеты");
	ПараметрыПереагрегации.Вставить("ИмяПоляШтрихкод", "ШтрихкодКоробки");
	ПараметрыПереагрегации.Вставить("ТаблицаСтарыхУпаковок", РезультатЗапроса[1].Выгрузить());
	МассивПараметров.Добавить(ПараметрыПереагрегации);	                                                  
	
	Для каждого ПараметрыПереагрегации ИЗ МассивПараметров Цикл
		ИмяПоляУпаковка = ПараметрыПереагрегации.ИмяПоляУпаковка;
		ИмяПоляШтрихкод = ПараметрыПереагрегации.ИмяПоляШтрихкод;
		ТаблицаСтарыхУпаковок = ПараметрыПереагрегации.ТаблицаСтарыхУпаковок;
	
	    НовыеУпаковки = ТаблицаНовыхУпаковок.Скопировать(, ИмяПоляУпаковка);
		НовыеУпаковки.Свернуть(ИмяПоляУпаковка);
		
		Для каждого СтрокаУпаковки ИЗ НовыеУпаковки Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаУпаковки[ИмяПоляУпаковка]) Тогда
				Продолжить;
			КонецЕсли;
			
			СозданаНоваяУпаковка = Ложь;
			
			НоваяУпаковкаСсылка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", СтрокаУпаковки[ИмяПоляУпаковка]);
			Если НоваяУпаковкаСсылка.Пустая() Тогда
				НоваяУпаковкаОбъект = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
				НоваяУпаковкаОбъект.ТипУпаковки 		= ?(ИмяПоляУпаковка = "ШтрихкодКоробки",
					ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"),
					ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка"));
				НоваяУпаковкаОбъект.ТипШтрихкода 		= ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128");
				НоваяУпаковкаОбъект.ЗначениеШтрихкода	= СтрокаУпаковки[ИмяПоляУпаковка];
				НоваяУпаковкаОбъект.ДатаУпаковки		= ТекущаяДатаСеанса();
				НоваяУпаковкаОбъект.Ответственный		= ПараметрыСеанса.ТекущийПользователь;
				
				СозданаНоваяУпаковка = Истина;
			КонецЕсли;
				
			ПеремещаемыеШтрихкоды = Новый Массив;
			МассивСтарыхУпаковок  = Новый Массив;
			
			СтрокиНовыхУпаковок = ТаблицаНовыхУпаковок.Скопировать(Новый Структура(ИмяПоляУпаковка, СтрокаУпаковки[ИмяПоляУпаковка]));
			СтрокиНовыхУпаковок.Свернуть(ИмяПоляУпаковка + ", " + ИмяПоляШтрихкод);
			
			Для каждого СтрокаШтрихкода ИЗ СтрокиНовыхУпаковок Цикл
				Если НЕ ЗначениеЗаполнено(СтрокаШтрихкода[ИмяПоляШтрихкод]) Тогда
					Продолжить;
				КонецЕсли;
				
				ПеремещаемыйШтрихкод = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", СтрокаШтрихкода[ИмяПоляШтрихкод]);
				Если ПеремещаемыйШтрихкод.Пустая() Тогда
					Если ИмяПоляШтрихкод = "ШтрихкодКоробки" Тогда
						ПеремещаемыйШтрихкод = УТ_11_4_СоздатьУпаковкуЕГАИС(СтрокаШтрихкода[ИмяПоляШтрихкод], ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"));
					Иначе
						Сообщить("Не найден штрихкод " + СтрокаШтрихкода[ИмяПоляШтрихкод] + "! Перемещение не выполнено.");
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				СтрокиСтарыхУпаковок = ТаблицаСтарыхУпаковок.НайтиСтроки(Новый Структура("Штрихкод", ПеремещаемыйШтрихкод));
				Для каждого СтрокаСтаройУпаковки ИЗ СтрокиСтарыхУпаковок Цикл
					Если МассивСтарыхУпаковок.Найти(СтрокаСтаройУпаковки.Ссылка) = Неопределено Тогда
						МассивСтарыхУпаковок.Добавить(СтрокаСтаройУпаковки.Ссылка);
					КонецЕсли;
				КонецЦикла;
				
				Если НЕ СозданаНоваяУпаковка
					И НЕ МассивСтарыхУпаковок.Найти(НоваяУпаковкаСсылка) = Неопределено Тогда
					Сообщить("Штрихкод " + СтрокаШтрихкода[ИмяПоляШтрихкод] + " уже вложен в упаковку " + СтрокаУпаковки[ИмяПоляУпаковка] + "! Перемещение не выполнено.");
					Продолжить;
				КонецЕсли;
				
				Если ПеремещаемыеШтрихкоды.Найти(ПеремещаемыйШтрихкод) = Неопределено Тогда
					ПеремещаемыеШтрихкоды.Добавить(ПеремещаемыйШтрихкод);
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ПеремещаемыеШтрихкоды.Количество() Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ СозданаНоваяУпаковка Тогда
				НоваяУпаковкаОбъект = НоваяУпаковкаСсылка.ПолучитьОбъект();
			КонецЕсли;
			
			// Перемещаем штрикходы в новую упаковку
			Для каждого ПеремещаемыйШтрихкод ИЗ ПеремещаемыеШтрихкоды Цикл
				НоваяСтрока = НоваяУпаковкаОбъект.ВложенныеШтрихкоды.Добавить();
				НоваяСтрока.Штрихкод = ПеремещаемыйШтрихкод;
			КонецЦикла;
			
			// Удаляем штрихкоды из старых упаковок
			Для каждого СтараяУпаковкаСсылка ИЗ МассивСтарыхУпаковок Цикл
				СтараяУпаковкаОбъект = СтараяУпаковкаСсылка.ПолучитьОбъект();
				
				ЗаписыватьУпаковку = Ложь;
				Для каждого ПеремещаемыйШтрихкод ИЗ ПеремещаемыеШтрихкоды Цикл
					ПараметрыОтбора = Новый Структура("Штрихкод", ПеремещаемыйШтрихкод);
				
					НайденныеСтроки = СтараяУпаковкаОбъект.ВложенныеШтрихкоды.НайтиСтроки(ПараметрыОтбора);
				    Если НайденныеСтроки.Количество() Тогда
						СтараяУпаковкаОбъект.ВложенныеШтрихкоды.Удалить(НайденныеСтроки[0]);
						
						Если НЕ ЗначениеЗаполнено(НоваяУпаковкаОбъект.Номенклатура)
							И НоваяУпаковкаОбъект.ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МультитоварнаяУпаковка") Тогда
							НоваяУпаковкаОбъект.Номенклатура 	= СтараяУпаковкаОбъект.Номенклатура;
							НоваяУпаковкаОбъект.Характеристика	= СтараяУпаковкаОбъект.Характеристика; 
							НоваяУпаковкаОбъект.Упаковка		= СтараяУпаковкаОбъект.Упаковка;
							НоваяУпаковкаОбъект.Серия			= СтараяУпаковкаОбъект.Серия; 
						КонецЕсли;
						
						ЗаписыватьУпаковку = Истина;
					КонецЕсли;
				КонецЦикла;
				
				Если ЗаписыватьУпаковку Тогда
					СтараяУпаковкаОбъект.Записать();
				КонецЕсли;
			КонецЦикла;
			
			НоваяУпаковкаОбъект.Записать();
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция УТ_11_4_СоздатьУпаковкуЕГАИС(ЗначениеШтрихкода, ТипУпаковки)

	НоваяУпаковка = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
	
	НоваяУпаковка.ТипУпаковки 		= ТипУпаковки;
	НоваяУпаковка.ТипШтрихкода 		= ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128");
	НоваяУпаковка.ЗначениеШтрихкода	= ЗначениеШтрихкода;
	НоваяУпаковка.ДатаУпаковки		= ТекущаяДатаСеанса();
	НоваяУпаковка.Ответственный		= ПараметрыСеанса.ТекущийПользователь;

	НоваяУпаковка.Записать();
	
	Возврат НоваяУпаковка.Ссылка;
	
КонецФункции

#КонецОбласти

#Область УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП

Процедура УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП(СтруктураПараметров) Экспорт
	
	ИмяСобытия = "УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП";
	
	ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Пиво");
	
	ДокументТСД    = СтруктураПараметров.ДокументТСД;
	ШапкаДокумента = ДокументТСД.ШапкаДокумента;
	СтрокиФакт	   = ДокументТСД.СтрокиФакт;
	
	// 1. Получение данных нового подключения к оборудованию
	
	Организация = ИО_ЗначениеГлобальногоПараметра("Организация", СтруктураПараметров);
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстОшибки = "Не заполнена организация в глобальных параметрах.";
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
				
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
		
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Подразделение = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("Подразделение");
	
	РеквизитыОрганизации = ИнтеграцияИС_ИННКППGLNОрганизации(Организация, Подразделение);
	
	ДанныеЗаполнения = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ДанныеЗаполнения(Организация);
		
	ЭтоИндивидуальныйПредприниматель = (СтрДлина(РеквизитыОрганизации.ИНН) > 10);
	Если НЕ ЭтоИндивидуальныйПредприниматель Тогда
		ИспользоватьОбособленныеПодразделения = ИнтеграцияИС_ИспользоватьОбособленныеПодразделенияВыделенныеНаБаланс();
		Если ИспользоватьОбособленныеПодразделения Тогда
			Подразделение = ДанныеЗаполнения.Подразделение;
		КонецЕсли;
	КонецЕсли;
	
	ИдСклада1С = Неопределено;
	Если ДокументТСД.ШапкаДокумента.Свойство("ИдСклада1С", ИдСклада1С) И ЗначениеЗаполнено(ИдСклада1С) Тогда				
		Склад = Справочники["Склады"].ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСклада1С));
		
		Если НЕ ЗначениеЗаполнено(Склад)
			ИЛИ ГлЯдро_СтрНайти(СокрЛП(Склад), "бъект не найден")
			ИЛИ ГлЯдро_СтрНайти(СокрЛП(Склад), "bject not found") Тогда
			Склад = ДанныеЗаполнения.Склад;
		КонецЕсли;
	КонецЕсли;
	
	АдресПодключения 		= ДанныеЗаполнения.АдресПодключения;
	АдресПодключенияСтрокой = ДанныеЗаполнения.АдресПодключенияСтрокой;
	ОбъемСлива				= ДанныеЗаполнения.ОбъемСлива;
	КодФИАС					= ДанныеЗаполнения.КодФИАС;
	
	ДатаПодключения = Дата(1,1,1);
	
	ВремяЗавершения = Неопределено;
	Если ШапкаДокумента.Свойство("ВремяЗавершения", ВремяЗавершения)
		И ЗначениеЗаполнено(ВремяЗавершения) Тогда
		Если ТипЗнч(ВремяЗавершения) = Тип("Строка") Тогда
			ДатаПодключения = НачалоДня(ПрочитатьДатуJSON(ВремяЗавершения, ФорматДатыJSON.ISO));
		ИначеЕсли ТипЗнч(ВремяЗавершения) = Тип("Дата") Тогда
			ДатаПодключения = ВремяЗавершения;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаПодключения) Тогда
		ДатаПодключения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Попытка
		СрокРеализацииПоУмолчанию = Число(ИО_ЗначениеГлобальногоПараметраПоID("NDScfa42d7a6ff04a30affab760bd9d3fc8", СтруктураПараметров));
	Исключение
		СрокРеализацииПоУмолчанию = 7;
	КонецПопытки;
	
	СрокРеализации = ДатаПодключения + СрокРеализацииПоУмолчанию * 86400;		          
	
	Если ЭтоИндивидуальныйПредприниматель
		И НЕ ЗначениеЗаполнено(КодФИАС)
		И ЗначениеЗаполнено(АдресПодключения) Тогда
		КодФИАС = ИО_ОбщийМодуль("ИнтеграцияИСМП").ИдентификаторФИАСПоДаннымАдреса(АдресПодключения).Идентификатор;
	КонецЕсли;
	
	Попытка
		СтатусПодключено = ПредопределенноеЗначение("Перечисление.СтатусыВскрытыхПотребительскихУпаковокИС.Подключено");
	Исключение
		СтатусПодключено = ПредопределенноеЗначение("Перечисление.СтатусыПодключенияКОборудованиюРозливаИСМП.Подключено");
	КонецПопытки;
	
	ДанныеНовогоПодключения = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ИнициализироватьДанныеПодключенияКОборудованию();
	
	ДанныеНовогоПодключения.Вставить("Организация", 			Организация);
	ДанныеНовогоПодключения.Вставить("Подразделение", 			Подразделение);
	ДанныеНовогоПодключения.Вставить("Склад", 					Склад);
	ДанныеНовогоПодключения.Вставить("Статус", 					СтатусПодключено);
	ДанныеНовогоПодключения.Вставить("СрокРеализации", 			СрокРеализации);
	ДанныеНовогоПодключения.Вставить("ДатаПодключения", 		ДатаПодключения);
	ДанныеНовогоПодключения.Вставить("Ответственный", 			ИО_ОбщийМодуль("Пользователи").ТекущийПользователь());
	ДанныеНовогоПодключения.Вставить("АдресПодключения", 		АдресПодключения);
	ДанныеНовогоПодключения.Вставить("АдресПодключенияСтрокой", АдресПодключенияСтрокой);
	ДанныеНовогоПодключения.Вставить("ОбъемСлива", 				ОбъемСлива);
	ДанныеНовогоПодключения.Вставить("КодФИАС", 				КодФИАС);
	
	МассивПроверяемыхРеквизитов = Новый	Массив;
	МассивПроверяемыхРеквизитов.Добавить("Склад");
	МассивПроверяемыхРеквизитов.Добавить("ДатаПодключения");
	МассивПроверяемыхРеквизитов.Добавить("СрокРеализации");
	
	Если ЭтоИндивидуальныйПредприниматель Тогда
		МассивПроверяемыхРеквизитов.Добавить("АдресПодключения");
		МассивПроверяемыхРеквизитов.Добавить("КодФИАС");
	КонецЕсли;
	
	ТекстОшибки = "";
	Для каждого ПроверяемыйРеквизит ИЗ МассивПроверяемыхРеквизитов Цикл
		Если НЕ ЗначениеЗаполнено(ДанныеНовогоПодключения[ПроверяемыйРеквизит]) Тогда
			Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
				ТекстОшибки = ТекстОшибки + "; ";
			КонецЕсли;
			ТекстОшибки = ТекстОшибки + ПроверяемыйРеквизит;
		КонецЕсли;	
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Не удалось получить значение реквизитов: " + ТекстОшибки + ".";
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
				
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
		
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	// 2. Получение кодов маркировки для подключения к оборудованию
	
	МассивКодовМаркировки = Новый Массив;
	
	ДанныеКодовМаркировки = Новый Соответствие; // На ТСД могут быть указаны сроки годности
	
	ОшибкиПодключения = Новый Массив;
	
	Для каждого СтрокаФакт ИЗ СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Марка = Неопределено;
		
		Если НЕ СтрокаФакт.Свойство("Марка", Марка) ИЛИ НЕ ЗначениеЗаполнено(Марка) Тогда
			Продолжить;
		КонецЕсли;
		
		МаркировкаСтроки = Неопределено;
		
		Если НЕ СтрокаФакт.Свойство("Маркировка", МаркировкаСтроки) ИЛИ НЕ ЗначениеЗаполнено(МаркировкаСтроки) ИЛИ МаркировкаСтроки = "ИСМП" Тогда
			Попытка
				МаркировкаСтроки = ИО_МаркировкаПоНоменклатуре(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара)));
			Исключение
				ТекстОшибки = ГлЯдро_СтрШаблон("Не удалось определить вид продукции по коду маркировки %1", Марка);
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
				
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки + ". Причина: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ОшибкиПодключения.Добавить(ТекстОшибки);
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Если НЕ МаркировкаСтроки = "Пиво" Тогда
			ТекстОшибки = ГлЯдро_СтрШаблон("Указан неверный вид продукции (%1) по коду маркировки %2", МаркировкаСтроки, Марка);
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
				
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
			
			ОшибкиПодключения.Добавить(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		КодМаркировки = Справочники["ШтрихкодыУпаковокТоваров"].НайтиПоРеквизиту("ЗначениеШтрихкода", Марка);
		
		Если НЕ КодМаркировки.Пустая() Тогда
			ТекстОшибки = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ПроверитьШтрихкодУпаковки(КодМаркировки);
			
			Если НЕ ТекстОшибки = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
					
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
				
		        ОшибкиПодключения.Добавить(ТекстОшибки);
				Продолжить;
			КонецЕсли;
		Иначе
			Номенклатура =
				Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара));
			ТекстОшибки = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ПроверитьНоменклатуру(Номенклатура);
			
			Если НЕ ТекстОшибки = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
					
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
				
			    ОшибкиПодключения.Добавить(ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			КодМаркировки = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_СоздатьШтрихкодУпаковки(Марка, Организация);
			
			Если КодМаркировки = Неопределено Тогда
				ТекстОшибки = ГлЯдро_СтрШаблон("Не удалось создать штрихкод упаковки %1 в справочнике ""Штрихкоды упаковок и товаров"". Подробности см. в журнале регистрации.", Марка);
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
					
				ОшибкиПодключения.Добавить(ТекстОшибки);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Номенклатура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КодМаркировки, "Номенклатура").Номенклатура;
		
		ВидПродукцииКодаМаркировки = ИнтеграцияИС_ВидПродукцииПоНоменклатуре(Номенклатура);
		Если НЕ ВидПродукцииКодаМаркировки = ВидПродукции Тогда
			ТекстОшибки = ГлЯдро_СтрШаблон("Вид продукции ""%1"" кода маркировки %2 не соответствует виду продукции подключения к оборудованию ""%3""",
				ВидПродукцииКодаМаркировки, Марка, ВидПродукции);
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
				
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
			
			ОшибкиПодключения.Добавить(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		МассивКодовМаркировки.Добавить(КодМаркировки);
		
		ОписаниеНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(Номенклатура)[Номенклатура];
		
		ДанныеКодаМаркировки = Новый Структура;
		ДанныеКодаМаркировки.Вставить("ВидПродукции", 		 ВидПродукцииКодаМаркировки);
		ДанныеКодаМаркировки.Вставить("Остаток", 	  		 ОписаниеНоменклатуры.ЕмкостьПотребительскойУпаковки);
		ДанныеКодаМаркировки.Вставить("ПолныйКодМаркировки", "");
		ДанныеКодаМаркировки.Вставить("СрокРеализации", 	 Неопределено);
		
		ПолнаяМаркаBase64 = Неопределено;
		Если СтрокаФакт.Свойство("ПолнаяМаркаBase64", ПолнаяМаркаBase64) Тогда
			ДанныеКодаМаркировки.ПолныйКодМаркировки = ПолнаяМаркаBase64;
		КонецЕсли;
		
		СрокГодностиСтрокаТСД = Неопределено;
		Если СтрокаФакт.Свойство("СрокГодности", СрокГодностиСтрокаТСД) Тогда
			СрокГодности = Дата(1,1,1);
			
			Если ТипЗнч(СрокГодностиСтрокаТСД) = Тип("Строка") И НЕ ПустаяСтрока(СрокГодностиСтрокаТСД) Тогда
				СрокГодности = НачалоДня(ПрочитатьДатуJSON(СрокГодностиСтрокаТСД, ФорматДатыJSON.ISO));
			ИначеЕсли ТипЗнч(СрокГодностиСтрокаТСД) = Тип("Дата") Тогда
				СрокГодности = СрокГодностиСтрокаТСД;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СрокГодности) Тогда
				ДанныеКодаМаркировки.СрокРеализации = СрокГодности;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеКодовМаркировки.Вставить(КодМаркировки, ДанныеКодаМаркировки);
	КонецЦикла;
	
	ДанныеПодключенияКодовМаркировки = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ПолучитьПодключениеКОборудованию(МассивКодовМаркировки);
	
	Для каждого КодМаркировки ИЗ МассивКодовМаркировки Цикл
		
		ДанныеНовогоПодключения.Вставить("КодМаркировки", КодМаркировки);
		
		ДанныеКодаМаркировки = ДанныеКодовМаркировки.Получить(КодМаркировки);
		Если НЕ ДанныеКодаМаркировки = Неопределено Тогда
			ДанныеНовогоПодключения.Вставить("ВидПродукции", 		ДанныеКодаМаркировки.ВидПродукции);
			ДанныеНовогоПодключения.Вставить("Остаток", 			ДанныеКодаМаркировки.Остаток);
			ДанныеНовогоПодключения.Вставить("ПолныйКодМаркировки", ДанныеКодаМаркировки.ПолныйКодМаркировки);
			
			Если ДанныеКодаМаркировки.СрокРеализации = Неопределено Тогда
				ДанныеНовогоПодключения.Вставить("СрокРеализации", СрокРеализации);
			Иначе	
				ДанныеНовогоПодключения.Вставить("СрокРеализации", ДанныеНовогоПодключения.СрокРеализации);
			КонецЕсли;
		КонецЕсли;
		
		ТекстСообщения = "";
		
		ДанныеСуществующегоПодключения = ДанныеПодключенияКодовМаркировки[КодМаркировки];
		
		Если ДанныеСуществующегоПодключения = Неопределено
			ИЛИ (НЕ ЗначениеЗаполнено(ДанныеСуществующегоПодключения.Документ)
				И НЕ ЗначениеЗаполнено(ДанныеСуществующегоПодключения.Статус)) Тогда
			ДанныеСоздания = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_СоздатьПодключениеКегаКОборудованию(ДанныеНовогоПодключения);
			
			Если ЗначениеЗаполнено(ДанныеСоздания.ТекстОшибки) Тогда
				ТекстСообщения = ДанныеСоздания.ТекстОшибки;
				
				УровеньЖурнала = "Ошибка";
				
				ОшибкиПодключения.Добавить(ТекстСообщения);
			Иначе
				ТекстСообщения = ГлЯдро_СтрШаблон("Выполнено подключение кега %1 к оборудованию розлива", Строка(КодМаркировки));
				
				УровеньЖурнала = "Информация";
			КонецЕсли;
		Иначе
			ДанныеИзменения = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ИзменитьПодключениеКегиКОборудованиюНаСервере(Истина,
				ДанныеНовогоПодключения, ДанныеСуществующегоПодключения);
			
			Если ЗначениеЗаполнено(ДанныеИзменения.ТекстОшибки) Тогда
				ТекстСообщения = ДанныеИзменения.ТекстОшибки;
				
				УровеньЖурнала = "Ошибка";
				
				ОшибкиПодключения.Добавить(ТекстСообщения);
			Иначе
				ТекстСообщения = ГлЯдро_СтрШаблон("Изменено подключение кега %1 к оборудованию розлива", Строка(КодМаркировки));
				
				УровеньЖурнала = "Информация";
			КонецЕсли;
		КонецЕсли;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
			
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньЖурнала, ТекстСообщения);
		
	КонецЦикла;
	
	Если ОшибкиПодключения.Количество() Тогда
		ТекстОшибки = "см. в журнале регистрации 1С.";
		
		//Для каждого ОшибкаПодключения ИЗ ОшибкиПодключения Цикл
		//	ТекстОшибки = ТекстОшибки + Символы.ПС + ОшибкаПодключения;
		//КонецЦикла;
		
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание", ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
	СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "");

КонецПроцедуры

// см. ОбщаяФорма.ВскрытиеПотребительскойУпаковкиИС.КодМаркировкиПриИзмененииНаСервере
Функция УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ПроверитьШтрихкодУпаковки(КодМаркировки)
	
    Перем ТекстОшибки;
	
	ТипУпаковки = ИО_ОбщийМодуль("ОбщегоНазначения").ЗначениеРеквизитаОбъекта(КодМаркировки, "ТипУпаковки");
	
	Если ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		ТекстОшибки = СтрШаблон(НСтр(
			"ru = 'Выбранный код маркировки ""%1"" не является потребительской упаковкой.'"),
			КодМаркировки);
		Возврат ТекстОшибки;
	КонецЕсли;
	
	Номенклатура = ИО_ОбщийМодуль("ОбщегоНазначения").ЗначениеРеквизитаОбъекта(КодМаркировки, "Номенклатура");
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ТекстОшибки = СтрШаблон(НСтр(
			"ru = 'Выбранный код маркировки ""%1"" не сопоставлен с номенклатурой.'"),
			КодМаркировки);
		Возврат ТекстОшибки;
	КонецЕсли;
	
	ТекстОшибки = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ПроверитьНоменклатуру(Номенклатура);
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ПроверитьНоменклатуру(Номенклатура)
	
    Перем ТекстОшибки;
	
	ОписаниеНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(Номенклатура)[Номенклатура];

	Если Не ЗначениеЗаполнено(ОписаниеНоменклатуры.ВариантЧастичногоВыбытия) Тогда
		ВидПродукции = ИнтеграцияИС_ВидПродукцииПоНоменклатуре(Номенклатура);
		
		ЗначенияПеречисления = Метаданные.Перечисления.ВидыПродукцииИС.ЗначенияПеречисления;
	
		ЭтоПивоВКегах = НЕ ЗначенияПеречисления.Найти("Пиво") = Неопределено
			И ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Пиво");
		ЭтоПивоВПотрУпаковках = НЕ ЗначенияПеречисления.Найти("ПивоВПотребительскихУпаковках") = Неопределено
			И ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.ПивоВПотребительскихУпаковках");
		
		Если ЭтоПивоВКегах
			Или ЭтоПивоВПотрУпаковках Тогда
			ТекстОшибки = ГлЯдро_СтрШаблон(НСтр(
				"ru = 'Для номенклатуры ""%1"" не настроена продажа на разлив'"),
				Номенклатура);
		Иначе
			ТекстОшибки = ГлЯдро_СтрШаблон(НСтр(
				"ru = 'Для номенклатуры ""%1"" не настроено частичное выбытие'"),
			Номенклатура);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_СоздатьШтрихкодУпаковки(КодМаркировки, Организация)

	Перем ИмяРегистра;
	
	ИмяСобытия = "УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_СоздатьШтрихкодУпаковки";
	
	Если НЕ Метаданные.РегистрыСведений.Найти("ВскрытыеПотребительскиеУпаковкиИС") = Неопределено Тогда
		ИмяРегистра = "ВскрытыеПотребительскиеУпаковкиИС";
	ИначеЕсли НЕ Метаданные.РегистрыСведений.Найти("КегиНаОборудованииРозливаИСМП") = Неопределено Тогда
		ИмяРегистра = "КегиНаОборудованииРозливаИСМП";
	КонецЕсли;
	
	Если ИмяРегистра = Неопределено Тогда
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			НСтр("ru = 'Конфигурация не поддерживает подключение кегов к оборудованию розлива'"));
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураКМ = Новый Структура;
	СтруктураКМ.Вставить("Штрихкод",   КодМаркировки);
	СтруктураКМ.Вставить("Количество", 1);
	
	ДанныеШтрихкодовСписок = Новый Массив;
	ДанныеШтрихкодовСписок.Добавить(СтруктураКМ);
	
	СтруктураКонтекста = Новый Структура;
	СтруктураКонтекста.Вставить("ИмяФормы",		 "РегистрСведений." + ИмяРегистра);
	СтруктураКонтекста.Вставить("ИмяПодсистемы", "ИСМП");
	СтруктураКонтекста.Вставить("Организация",	 Организация);
		
	ПараметрыСканирования =
		ШтрихкодированиеИС_ПараметрыСканирования(СтруктураКонтекста);
	ДанныеПоШтрихкодам =
		ШтрихкодированиеИС_ИнициализацияДанныхПоШтрихкодам(Ложь);
	ШтрихкодированиеИС_ПодготовитьДанныеКодовМаркировкиДляОбработки(
		ДанныеПоШтрихкодам, ДанныеШтрихкодовСписок, ПараметрыСканирования);
		
	ДанныеКодовМаркировки = ДанныеПоШтрихкодам.ДанныеКодовМаркировки;
	
	ДанныеШтрихкода = ДанныеКодовМаркировки[0];
	
	// см. ШтрихкодированиеИСМПСлужебный.ЗаполнитьДанныеНеизвестнойМаркируемойПродукцииБезЗапросаСведенийИСМП
	Если ДанныеШтрихкода.ОбработанСОшибками Тогда
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			ДанныеШтрихкода.ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
		
	Если ДанныеШтрихкода.ЭтоКодВводаОстатков
		И ДанныеШтрихкода.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
		ДанныеШтрихкода.КоличествоПотребительскихУпаковок = 1;
	КонецЕсли;
		
	ВидыПродукцииИСМП = ИнтеграцияИСКлиентСервер_ВидыПродукцииИСМП();
	
	Если ВидыПродукцииИСМП.Найти(ДанныеШтрихкода.ВидПродукции) = Неопределено Тогда
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			ГлЯдро_СтрШаблон(НСтр("ru = 'Не удалось определить вид продукции кода маркировки %1'"), КодМаркировки));
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ДанныеШтрихкода.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			ГлЯдро_СтрШаблон(НСтр("ru = 'Код маркировки %1 не является потребительской упаковкой'"), КодМаркировки));
		Возврат Неопределено;
	КонецЕсли;
			
	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеИС").СоздатьМаркированныйТоварПоДаннымШтрихкода(ДанныеШтрихкода, ПараметрыСканирования);
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

// см. ОбщегоНазначенияИС.ВскрытьПотребительскуюУпаковку
// см. ИнтеграцияИСМП.ПодключитьНовыйКегКОборудованиюРозлива (old)
// см. РегистрСведений.КегиНаОборудованииРозливаИСМП.ФормаПодключенияКегаКОборудованию.СоздатьПодключениеКегаКОборудованиюНаСервере (old)
Функция УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_СоздатьПодключениеКегаКОборудованию(ДанныеПодключения)

	ИмяСобытия = "УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_СоздатьПодключениеКегаКОборудованию";
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Документ",	 Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки", Неопределено);
	
	// Данные подключения получаем ранее в обработчике и передаем в качестве параметра
	//
	//ДанныеПодключения = РегистрыСведений.КегиНаОборудованииРозливаИСМП.ИнициализироватьДанныеПодключенияКОборудованию();
	//ЗаполнитьЗначенияСвойств(ДанныеПодключения, ЭтотОбъект);
	//ДанныеПодключения.Статус        = Перечисления.СтатусыПодключенияКОборудованиюРозливаИСМП.Подключено;
	//ДанныеПодключения.Ответственный = Пользователи.ТекущийПользователь();
	//
	
	Блокировка = Новый БлокировкаДанных();
	
	Попытка
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений["ВскрытыеПотребительскиеУпаковкиИС"].ПолноеИмя());
	Исключение
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений["КегиНаОборудованииРозливаИСМП"].ПолноеИмя());
	КонецПопытки;
	
	ЭлементБлокировки.УстановитьЗначение("КодМаркировки", ДанныеПодключения.КодМаркировки);
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка.Заблокировать();
		
		ДокументОбъект = Документы.ПодключениеКегаКОборудованиюРозливаИСМП.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеПодключения);
		ДокументОбъект.КодМаркировки = ДанныеПодключения.КодМаркировки; // КодМаркировки;
		ДокументОбъект.Дата          = ТекущаяДатаСеанса();
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		ВозвращаемоеЗначение.Документ = ДокументОбъект.Ссылка;
		ДанныеПодключения.Документ    = ДокументОбъект.Ссылка;
		
		УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_УстановитьПодключениеКОборудованию(ДанныеПодключения);
		
		// Отключение от оборудования не выполняем
		//
		//Если ОтключитьОтОборудования И ЗначениеЗаполнено(КодМаркировкиОтключить) Тогда
		//	
		//	ТаблицаДанных = РегистрыСведений.КегиНаОборудованииРозливаИСМП.НоваяТаблицаОтключенияКегОтОборудованияРозлива();
		//	НоваяСтрока = ТаблицаДанных.Добавить();
		//	НоваяСтрока.КодМаркировки = КодМаркировкиОтключить;
		//	РегистрыСведений.КегиНаОборудованииРозливаИСМП.ОтключитьКегиОтОборудованияРозлива(ТаблицаДанных);
		//	
		//КонецЕсли;
		//
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
				
		ВозвращаемоеЗначение.ТекстОшибки = ГлЯдро_СтрШаблон(
			НСтр("ru = 'Ошибка записи данных подключения к оборудованию розлива %1:
				       |%2'"),
			ДанныеПодключения.КодМаркировки,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ТекстОшибкиПодробно = ГлЯдро_СтрШаблон(
			НСтр("ru = 'Ошибка записи данных подключения к оборудованию розлива %1:
				       |%2'"),
			ДанныеПодключения.КодМаркировки,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибкиПодробно);
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// см. РегистрСведений.ВскрытыеПотребительскиеУпаковкиИС.ФормаЗаписи.ИзменитьВскрытиеПотребительскойУпаковкиНаСервере
// см. ОбщаяФорма.ПодключенияКегаКОборудованиюРозливаИСМП.ИзменитьПодключениеКегиКОборудованиюНаСервере (old)
// см. РегистрСведений.КегиНаОборудованииРозливаИСМП.ФормаПодключенияКегаКОборудованию.ИзменитьПодключениеКегиКОборудованиюНаСервере (old)
Функция УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ИзменитьПодключениеКегиКОборудованиюНаСервере(ТолькоРегистрСведений = Ложь,
	ДанныеНовогоПодключения, ДанныеСуществующегоПодключения)

	ИмяСобытия = "УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ИзменитьПодключениеКегиКОборудованиюНаСервере";
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ТекстОшибки");
	
	// Сохраненные данные подключения получаем ранее в обработчике и передаем в качестве параметра
	//
	//СохраненныеДанные = РегистрыСведений.КегиНаОборудованииРозливаИСМП.ПолучитьПодключениеКОборудованию(КодМаркировки)[КодМаркировки];
	
	ДанныеПодключения = УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ИнициализироватьДанныеПодключенияКОборудованию();
	
	// Передачу данных в сервис не выполняем
	//
	//Если ТолькоРегистрСведений Тогда
		
		МожноРедактироватьПоля = НЕ ЗначениеЗаполнено(ДанныеСуществующегоПодключения.Документ)
			ИЛИ ДанныеСуществующегоПодключения.СтатусИСМП = ПредопределенноеЗначение("Перечисление.СтатусыОбработкиПодключениеКОборудованиюРозливаИСМП.Черновик")
			ИЛИ ДанныеСуществующегоПодключения.СтатусИСМП = ПредопределенноеЗначение("Перечисление.СтатусыОбработкиПодключениеКОборудованиюРозливаИСМП.ОшибкаПередачи");
				
		ДанныеПодключения.Комментарий  = ДанныеНовогоПодключения.Комментарий;
		ДанныеПодключения.Склад        = ДанныеНовогоПодключения.Склад;
		ДанныеПодключения.ОбъемСлива   = ДанныеНовогоПодключения.ОбъемСлива;
		
		ДанныеПодключения.Вставить("Организация",  ДанныеНовогоПодключения.Организация);
		ДанныеПодключения.Вставить("ВидПродукции", ДанныеНовогоПодключения.ВидПродукции);
		ДанныеПодключения.Вставить("Остаток",	   ДанныеНовогоПодключения.Остаток);
		
		Если МожноРедактироватьПоля Тогда
			ДанныеПодключения.Подразделение = ДанныеНовогоПодключения.Подразделение;
		КонецЕсли;
		
		РеквизитыОрганизации = ИнтеграцияИС_ИННКППGLNОрганизации(ДанныеНовогоПодключения.Организация,
			ДанныеНовогоПодключения.Подразделение);
		
		ЭтоИндивидуальныйПредприниматель = СтрДлина(РеквизитыОрганизации.ИНН) > 10;
		Если Не ЭтоИндивидуальныйПредприниматель Или МожноРедактироватьПоля Тогда
			ДанныеПодключения.АдресПодключения        = ДанныеНовогоПодключения.АдресПодключения;
			ДанныеПодключения.АдресПодключенияСтрокой = ДанныеНовогоПодключения.АдресПодключенияСтрокой;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеНовогоПодключения.ПолныйКодМаркировки) Тогда
			ДанныеПодключения.Вставить("ПолныйКодМаркировки", ДанныеНовогоПодключения.ПолныйКодМаркировки);
		КонецЕсли;
		
	//Иначе
	//	
	//	ЗаполнитьЗначенияСвойств(ДанныеПодключения, ЭтотОбъект);
	//	ДанныеПодключения.Ответственный = ИО_ОбщийМодуль("Пользователи").ТекущийПользователь();
	//	
	//КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных();
	
	Попытка
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений["ВскрытыеПотребительскиеУпаковкиИС"].ПолноеИмя());	
	Исключение
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений["КегиНаОборудованииРозливаИСМП"].ПолноеИмя());
	КонецПопытки;
	
	ЭлементБлокировки.УстановитьЗначение("КодМаркировки", ДанныеНовогоПодключения.КодМаркировки);
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка.Заблокировать();
		
		// Передачу данных в сервис не выполняем
		//
		//Если Не ТолькоРегистрСведений Тогда
		//	
		//	ДокументОбъект = Документ.ПолучитьОбъект();
		//	ДокументОбъект.Заблокировать();
		//	
		//	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеПодключения);
		//	ДокументОбъект.КодМаркировки = КодМаркировки;
		//	ДокументОбъект.Дата          = ТекущаяДатаСеанса();
		//	
		//	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//	
		//КонецЕсли;
		
		УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_УстановитьПодключениеКОборудованию(ДанныеПодключения, ДанныеСуществующегоПодключения); // СохраненныеДанные
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
				
		ВозвращаемоеЗначение.ТекстОшибки = ГлЯдро_СтрШаблон(
			НСтр("ru = 'Ошибка записи данных подключения к оборудованию розлива %1:
				       |%2'"),
			ДанныеПодключения.КодМаркировки,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ТекстОшибкиПодробно = ГлЯдро_СтрШаблон(
			НСтр("ru = 'Ошибка записи данных подключения к оборудованию розлива %1:
				       |%2'"),
			ДанныеПодключения.КодМаркировки,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибкиПодробно);
			
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция УТ_11_4_ПодключениеКегаКОборудованиюРозливаИСМП_ДанныеЗаполнения(Организация)

