Процедура МОТП_ДополнитьТаблицуМаркируемойПродукции(ДеревоУпаковок, ТаблицаМаркируемойПродукции)
	
	Для Каждого СтрокаДерева Из ДеревоУпаковок.Строки Цикл
		
		ДобавитьСтроку = Ложь;
		
		Если СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
			
			ДобавитьСтроку = Истина;
			
		ИначеЕсли СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
			Или СтрокаДерева.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая") Тогда
			
			Если СтрокаДерева.Строки.Количество() = 0 Тогда
				ДобавитьСтроку = Истина;
			Иначе
				МОТП_ДополнитьТаблицуМаркируемойПродукции(СтрокаДерева, ТаблицаМаркируемойПродукции);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ДобавитьСтроку Тогда
			
			СтрокаТЧ = ТаблицаМаркируемойПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаДерева);
			СтрокаТЧ.СтрокаДерева = СтрокаДерева;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция МОТП_ЗаполнитьДеревоПодобраннойПровереннойПродукции(ДокСсылка,ПараметрыПроцедуры)	
	
	ИдентификаторОперации = Новый УникальныйИдентификатор();
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторОперации);
	Попытка
		//Выполнить("Обработки.ПроверкаИПодборТабачнойПродукцииМОТП.ЗагрузитьДанныеДокументаДлительнаяОперация(ПараметрыПроцедуры,АдресРезультата)");
		Обработки["ПроверкаИПодборТабачнойПродукцииМОТП"].ЗагрузитьДанныеДокументаДлительнаяОперация(ПараметрыПроцедуры,АдресРезультата);
		Возврат ПолучитьИзВременногоХранилища(АдресРезультата);
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("МОТП_ЗаполнитьДеревоПодобраннойПровереннойПродукции", "Ошибка", "Не удалось заполнить данные проверки и подбора МОТП. Ошибка: " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
		Сообщить("Не удалось заполнить данные проверки и подбора МОТП. Ошибка: " + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
		Возврат Неопределено;
	КонецПопытки;		
		
КонецФункции

Функция МОТП_ПолучитьПараметрыПроцедуры(ДокСсылка, ЭтоРТУ, ВидПродукцииИС = Неопределено)
	
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
	Иначе
		ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
	КонецЕсли;
	
	ЭтоДокументПриобретения = ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ПриемкаТоваровИСМП")
		ИЛИ ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
		ИЛИ ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента");
	РежимПодбораСуществующихУпаковок = ?(ЭтоДокументПриобретения, Ложь, Истина);
	
	ПараметрыСканирования = МОТП_ПараметрыСканирования(ДокСсылка, ВидПродукцииИС);
	
	ПараметрыПроверкиКодовМаркировки = ИО_ПараметрыПроверкиКодовМаркировки("МОТП", ДокСсылка, ЭтоРТУ, ВидПродукцииИС, ПараметрыСканирования);
	
	МОТП_ИнициализироватьПараметрыСканирования(ДокСсылка, ПараметрыСканирования, ПараметрыПроверкиКодовМаркировки, ВидПродукцииИС);
	
	ПараметрыПроцедуры = Новый Структура();	
	ПараметрыПроцедуры.Вставить("ПроверкаНеПоДокументу",            Ложь);
	ПараметрыПроцедуры.Вставить("ПроверяемыйДокумент",              ДокСсылка);
	ПараметрыПроцедуры.Вставить("НачальныйСтатусПроверки",          ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась"));
	ПараметрыПроцедуры.Вставить("ДетализацияСтруктурыХранения",     ДетализацияСтруктурыХранения);
	ПараметрыПроцедуры.Вставить("РедактированиеФормыНедоступно",    Ложь);
	ПараметрыПроцедуры.Вставить("РежимПодбораСуществующихУпаковок", РежимПодбораСуществующихУпаковок); 
	ПараметрыПроцедуры.Вставить("ПараметрыСканирования",            ПараметрыСканирования);
	ПараметрыПроцедуры.Вставить("ПроверкаЭлектронногоДокумента",    Ложь);
	ПараметрыПроцедуры.Вставить("ПараметрыПроверкиКодовМаркировки", ПараметрыПроверкиКодовМаркировки);
	ПараметрыПроцедуры.Вставить("ВидМаркируемойПродукции",          ВидПродукцииИС);
	ПараметрыПроцедуры.Вставить("ЭтоВосстановлениеДетализации",     Ложь);
	ПараметрыПроцедуры.Вставить("КонтролироватьСканируемуюПродукциюПоДокументуОснованию", Ложь);
	
	ПараметрыПроцедуры.Вставить(
		"ВозможностьЗагрузкиДанныхБезПодключенияМОТП",
		ПараметрыПроверкиКодовМаркировки.ВозможностьЗагрузкиДанныхБезПодключенияМОТП);
	
	Если Метаданные.ПараметрыСеанса.Найти("ДанныеКлючаСессииМОТП") <> Неопределено Тогда
		ПараметрыПроцедуры.Вставить("ДанныеКлючаСессииМОТП",		ПараметрыСеанса.ДанныеКлючаСессииМОТП);
	Иначе
		ПараметрыПроцедуры.Вставить("ДанныеКлючаСессииИСМП",		ПараметрыСеанса.ДанныеКлючаСессииИСМП);
	КонецЕсли;
	
	Если Метаданные.ПараметрыСеанса.Найти("ПараметрыЛогированияЗапросовИСМП") <> Неопределено Тогда
		ПараметрыПроцедуры.Вставить("ПараметрыЛогированияЗапросовИСМП", ПараметрыСеанса.ПараметрыЛогированияЗапросовИСМП);
	КонецЕсли;
					
	Возврат ПараметрыПроцедуры
	
КонецФункции

Функция МОТП_ПараметрыСканирования(ПроверяемыйДокумент, ВидМаркируемойПродукции)
	
	ИмяСобытия = "МОТП_ПараметрыСканирования";
	
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
	Иначе
		ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
	КонецЕсли;
	
	Организация = Неопределено;
	
	РеквизитыДокумента = ПроверяемыйДокумент.Метаданные().Реквизиты;
	Если НЕ РеквизитыДокумента.Найти("Организация") = Неопределено Тогда
		Организация = ПроверяемыйДокумент.Организация;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Попытка
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМППереопределяемый").ПриОпределенииОрганизации(ПроверяемыйДокумент, Организация);
		Исключение
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение",
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(ПроверяемыйДокумент,, ВидМаркируемойПродукции);
	
	ПараметрыСканирования.Вставить("СоздаватьШтрихкодУпаковки", Ложь);
	ПараметрыСканирования.Вставить("СсылкаНаОбъект",			ПроверяемыйДокумент);
	ПараметрыСканирования.Вставить("Организация",				Организация);
	ПараметрыСканирования.Вставить("Детализация",				ДетализацияСтруктурыХранения);
	
	
	//ПараметрыСканирования = ИО_ОбщийМодуль("ШтрихкодированиеИСКлиентСервер").БазовыеПараметрыСканирования();
	//ИО_ОбщийМодуль("ШтрихкодированиеМОТПКлиентСервер").ЗаполнитьПараметрыСканирования(ПараметрыСканирования,Неопределено,Перечисления.ВидыПродукцииИС.Табак,Неопределено);
	//
	//ПараметрыСканирования.Вставить("ДопустимыеВидыПродукции", Новый Массив);
	//ПараметрыСканирования.ДопустимыеВидыПродукции.Очистить();
	//ПараметрыСканирования.ДопустимыеВидыПродукции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Табак"));
	//ПараметрыСканирования.ДопустимыеВидыПродукции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.АльтернативныйТабак"));
	//
	//ПараметрыСканирования.Вставить("СоздаватьШтрихкодУпаковки"                      , Ложь); // Истина);
	//ПараметрыСканирования.Вставить("КэшМаркируемойПродукции"                        , Неопределено);
	//ПараметрыСканирования.Вставить("ДанныеВыбораПоМаркируемойПродукции"             , Неопределено);
	//ПараметрыСканирования.Вставить("ИспользуютсяДанныеВыбораПоМаркируемойПродукции" , Истина);
	//ПараметрыСканирования.Вставить("ВозможнаЗагрузкаТСД"                            , Истина);
	//ПараметрыСканирования.Вставить("ИспользуетсяСоответствиеШтрихкодовСтрокДерева"  , Ложь); // Истина);
	//ПараметрыСканирования.Вставить("КонтрольПустыхУпаковок"         				  , Истина);
	//ПараметрыСканирования.Вставить("КонтрольУникальностиКодовМаркировки"         	  , Ложь);
	//ПараметрыСканирования.Вставить("СсылкаНаОбъект"                         		  , ДокСсылка);
	//ПараметрыСканирования.Вставить("КонтрольСоставаУпаковокМОТП"                    , Истина);
	//ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокМОТП"       , Истина);
	//ПараметрыСканирования.Вставить("ЗапрашиватьСтатусыМОТП"                    	  , Истина);
	//
	//// дубли параметров для версий 13.85+
	//ПараметрыСканирования.Вставить("КонтрольСоставаУпаковокИСМП"                    , Истина);
	//ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП"       , Истина);
	//ПараметрыСканирования.Вставить("ЗапрашиватьСтатусыИСМП"                    	  , Истина);
	//
	//ПараметрыСканирования.Вставить("Организация"                    				  , ДокСсылка.Организация);
	//ПараметрыСканирования.Вставить("Детализация" 									  , ДетализацияСтруктурыХранения);
	//ПараметрыСканирования.Вставить("ПараметрыУказанияСерий"                    	  , Неопределено);

	Возврат ПараметрыСканирования;
	
КонецФункции

// см. Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор.ИнициализироватьПараметрыСканирования
Процедура МОТП_ИнициализироватьПараметрыСканирования(ПроверяемыйДокумент, ПараметрыСканирования, ПараметрыПроверкиКодовМаркировки, ВидМаркируемойПродукции)
	
	Если ПараметрыСканирования = Неопределено Тогда
		ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(ПроверяемыйДокумент,, ВидМаркируемойПродукции);
	КонецЕсли;
	
	Попытка
		ЭтоДокументПриобретения = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЭтоДокументПриобретения(ПроверяемыйДокумент);
	Исключение
		ЭтоДокументПриобретения = Ложь;
	КонецПопытки;
	
	ЭтоДокументМаркировка = ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.МаркировкаТоваровИСМП");
	
	Если ЭтоДокументПриобретения Тогда
		РежимПодбораСуществующихУпаковок = Ложь;
	Иначе
		РежимПодбораСуществующихУпаковок = Истина;
	КонецЕсли;
	
	Если ПараметрыСканирования.Свойство("ДопустимыеВидыПродукции") Тогда
		ПараметрыСканирования.ДопустимыеВидыПродукции.Очистить();
		ПараметрыСканирования.ДопустимыеВидыПродукции.Добавить(ВидМаркируемойПродукции);
	КонецЕсли;
	
	ПараметрыСканирования.Вставить("СоздаватьШтрихкодУпаковки",                          Ложь);
	ПараметрыСканирования.Вставить("ИспользуетсяСоответствиеШтрихкодовСтрокДерева",      Истина);
	ПараметрыСканирования.Вставить("КонтрольУникальностиКодовМаркировки",                Ложь);
	ПараметрыСканирования.Вставить("СсылкаНаОбъект",                                     ПроверяемыйДокумент);
	
	Если ПараметрыСканирования.Свойство("ПоддерживаютсяОперацииАгрегации") Тогда
		ПоддерживаютсяОперацииАгрегации = ПараметрыСканирования.ПоддерживаютсяОперацииАгрегации;
	Иначе
		ПоддерживаютсяОперацииАгрегации = Ложь;
	КонецЕсли;
	
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
		ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
	Иначе
		ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
	КонецЕсли;
	
	ПараметрыСканирования.Вставить("РазрешенаОбработкаНеНайденныхЛогистическихУпаковок", ПоддерживаютсяОперацииАгрегации);
	ПараметрыСканирования.Вставить("ДетализацияСтруктурыХранения",                       ДетализацияСтруктурыХранения);
	ПараметрыСканирования.Вставить("РазрешенаОбработкаБезУказанияМарки",                 Ложь);
	
	КонтрольСоставаУпаковок = Истина;
	
	Если Не РежимПодбораСуществующихУпаковок Тогда
		
		КонтрольСоставаУпаковок = Ложь;
		
		Если ПараметрыПроверкиКодовМаркировки.ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Истина Тогда
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", Ложь);
			КонецЕсли;
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", Ложь);
			КонецЕсли;
		Иначе
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", Истина);
			КонецЕсли;
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", Истина);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЭтоДокументМаркировка Тогда
		КонтрольСоставаУпаковок = Ложь;
	КонецЕсли;
	
	// см. ОбщегоНазначенияИСМПКлиентСервер.ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП
	ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = Ложь;
	
	Если НЕ ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
		ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = Ложь;
	ИначеЕсли ТипЗнч(ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП) = Тип("Строка") Тогда
		Если ВРег(ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП) = "ПОУМОЛЧАНИЮ" Тогда
			ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = ИнтеграцияИСМПКлиентСерверПовтИсп_ЗапрашиватьДанныеСервиса();
		КонецЕсли;
	ИначеЕсли ТипЗнч(ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП) = Тип("Булево") Тогда
		ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП;
	КонецЕсли;
	//
	
	ПараметрыСканирования.Вставить("КонтролироватьРасхождениеСоставаУпаковокМеждуИБиИСМП", КонтрольСоставаУпаковок
		И ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП);
	
	Если ЭтоДокументМаркировка Тогда
		
		ПараметрыСканирования.Вставить("КонтролироватьСтандартнуюВложенность", Ложь);
		ПараметрыСканирования.Вставить("КонтролироватьСоставАгрегатов",		   Истина);
		
		Если ПараметрыСканирования.Свойство("ДопустимыеСтатусыУпаковокМОТП") Тогда
			ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиМОТП.Неопределен"));
			ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
	РедактированиеФормыНедоступно = Ложь;
	
	Если РедактированиеФормыНедоступно
		Или ПараметрыПроверкиКодовМаркировки.ОтсутствуетПодключениеМОТП Тогда
		
		ПараметрыСканирования.Вставить("КонтролироватьРасхождениеСоставаУпаковокМеждуИБиИСМП",		Ложь);
		
		ПараметрыСканирования.Вставить("Владелец",                                                	Неопределено);
		
		ПараметрыСканирования.Вставить("КонтролироватьСтандартнуюВложенность",                      Ложь);
		ПараметрыСканирования.Вставить("ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП", Ложь);
		ПараметрыСканирования.Вставить("КонтролироватьСтатусыКодовМаркировкиИСМП",                  Ложь);
		ПараметрыСканирования.Вставить("КонтролироватьВладельцевКодовМаркировкиИСМП",               Ложь);
		
		Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
			ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", Ложь);
		КонецЕсли;
		Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
			ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", Ложь);
		КонецЕсли;
		
	Иначе
		Если ПараметрыПроверкиКодовМаркировки.КонтролироватьВладельцевКодовМаркировки Тогда
			ПараметрыСканирования.Вставить("Владелец",                                    ПараметрыПроверкиКодовМаркировки.Владелец);
			ПараметрыСканирования.Вставить("КонтролироватьВладельцевКодовМаркировкиИСМП", Истина);
			
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", "ПоУмолчанию");
			КонецЕсли;
		Иначе
			ПараметрыСканирования.Вставить("Владелец", 									  Неопределено);
			ПараметрыСканирования.Вставить("КонтролироватьВладельцевКодовМаркировкиИСМП", Ложь);
		КонецЕсли;
		Если ПараметрыПроверкиКодовМаркировки.КонтролироватьСтатусыКодовМаркировки Тогда
			ПараметрыСканирования.Вставить("КонтролироватьСтатусыКодовМаркировкиИСМП", Истина);
			
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", "ПоУмолчанию");
			КонецЕсли;
		Иначе
			ПараметрыСканирования.Вставить("КонтролироватьСтатусыКодовМаркировкиИСМП", Ложь);
		КонецЕсли;
		Если ПараметрыСканирования.КонтролироватьСтатусыКодовМаркировкиИСМП
			Или ПараметрыПроверкиКодовМаркировки.КонтролироватьВладельцевКодовМаркировки Тогда
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", "ПоУмолчанию");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП
		И ПараметрыСканирования.Свойство("ВидОперацииИСМП")
		И (ИО_ОбщийМодуль("НастройкаПараметровСканированияСлужебныйКлиентСерверПовтИсп").КонтролироватьВладельцевКодовМаркировки(ВидМаркируемойПродукции, ПараметрыСканирования.ВидОперацииИСМП)
			Или ИО_ОбщийМодуль("НастройкаПараметровСканированияСлужебныйКлиентСерверПовтИсп").КонтролироватьСтатусыКодовМаркировки(ВидМаркируемойПродукции, ПараметрыСканирования.ВидОперацииИСМП)) Тогда
		ПараметрыСканирования.Вставить("ВариантПолученияМРЦ", "ВычислениеИЗапрос");
	Иначе
		ПараметрыСканирования.Вставить("ВариантПолученияМРЦ", "Вычисление");
	КонецЕсли;
	
	// см. Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор.ЗаполнитьПараметрыПроверкиКодовМаркировки
	ПараметрыПроверкиКодовМаркировки.КонтролироватьСтандартнуюВложенность                      = ПараметрыСканирования.КонтролироватьСтандартнуюВложенность;
	ПараметрыПроверкиКодовМаркировки.ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП = ПараметрыСканирования.ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП;
		
	Попытка
		ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ(ВидМаркируемойПродукции);
	Исключение
		ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ = Ложь;
	КонецПопытки;
	
	Если ЭтоДокументМаркировка
		И ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ Тогда
		ПараметрыПроверкиКодовМаркировки.КонтролироватьВложенностьУпаковок = Истина;
			
		ДопустимыеВложенияАгрегатовПоВидамПродукции = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ДопустимыеВложенияАгрегатовПоВидамПродукции();
		ПараметрыПроверкиКодовМаркировки.ДопустимыеВложенияАгрегатов = ДопустимыеВложенияАгрегатовПоВидамПродукции.Получить(ВидМаркируемойПродукции);
			
		ПараметрыПроверкиКодовМаркировки.КонтролироватьСоставАгрегатаПриИзмененииСтрокиДерева = Истина;
		Если ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.АльтернативныйТабак")
			Или ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.НикотиносодержащаяПродукция") Тогда
			ПараметрыПроверкиКодовМаркировки.КонтролироватьСоставГрупповойУпаковкиПриИзмененииСтрокиДерева = Истина;
		КонецЕсли;
	КонецЕсли;
	//
	
КонецПроцедуры

// см. Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор.ИнициализироватьПараметрыСканирования
Процедура ИСМП_ИнициализироватьПараметрыСканирования(ПроверяемыйДокумент, ПараметрыСканирования, ПараметрыПроверкиКодовМаркировки, ВидМаркируемойПродукции,
	ДетализацияСтруктурыХранения = Неопределено)
	
	Если ПараметрыСканирования = Неопределено Тогда
		ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(ПроверяемыйДокумент,, ВидМаркируемойПродукции);
	КонецЕсли;
	
	Попытка
		ЭтоДокументПриобретения = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ЭтоДокументПриобретения(ПроверяемыйДокумент);
	Исключение
		ЭтоДокументПриобретения = Ложь;
	КонецПопытки;
	
	ЭтоДокументМаркировка = ТипЗнч(ПроверяемыйДокумент) = Тип("ДокументСсылка.МаркировкаТоваровИСМП");
	
	Если ЭтоДокументПриобретения Тогда
		РежимПодбораСуществующихУпаковок = Ложь;
	Иначе
		РежимПодбораСуществующихУпаковок = Истина;
	КонецЕсли;
	
	Если ПараметрыСканирования.Свойство("ДопустимыеВидыПродукции") Тогда
		ПараметрыСканирования.ДопустимыеВидыПродукции.Очистить();
		ПараметрыСканирования.ДопустимыеВидыПродукции.Добавить(ВидМаркируемойПродукции);
	КонецЕсли;
	
	ПараметрыСканирования.Вставить("СоздаватьШтрихкодУпаковки",                          Ложь);
	ПараметрыСканирования.Вставить("ПроверятьДублиКодовМаркировки",                      "Элементы");
	ПараметрыСканирования.Вставить("ИспользуетсяСоответствиеШтрихкодовСтрокДерева",      Истина);
	ПараметрыСканирования.Вставить("КонтрольУникальностиКодовМаркировки",                Ложь);
	ПараметрыСканирования.Вставить("СсылкаНаОбъект",                                     ПроверяемыйДокумент);
	
	Если ПараметрыСканирования.Свойство("ПоддерживаютсяОперацииАгрегации") Тогда
		ПоддерживаютсяОперацииАгрегации = ПараметрыСканирования.ПоддерживаютсяОперацииАгрегации;
	Иначе
		ПоддерживаютсяОперацииАгрегации = Ложь;
	КонецЕсли;
	
	Если ДетализацияСтруктурыХранения = Неопределено Тогда
		Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
			ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
		Иначе
			ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияПродукцииИСМП.Полная");
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыСканирования.Вставить("РазрешенаОбработкаНеНайденныхЛогистическихУпаковок", ПоддерживаютсяОперацииАгрегации);
	ПараметрыСканирования.Вставить("ДетализацияСтруктурыХранения",                       ДетализацияСтруктурыХранения);
	ПараметрыСканирования.Вставить("РазрешенаОбработкаБезУказанияМарки",                 Ложь);
	
	КонтрольСоставаУпаковок = Истина;
	
	Если Не РежимПодбораСуществующихУпаковок Тогда
		
		КонтрольСоставаУпаковок = Ложь;
		
		Если ПараметрыПроверкиКодовМаркировки.ВозможностьЗагрузкиДанныхБезПодключенияМОТП = Истина Тогда
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", Ложь);
			КонецЕсли;
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", Ложь);
			КонецЕсли;
		Иначе
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", Истина);
			КонецЕсли;
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", Истина);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоДокументМаркировка Тогда
		КонтрольСоставаУпаковок = Ложь;
	КонецЕсли;
	
	// см. ОбщегоНазначенияИСМПКлиентСервер.ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП
	ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = Ложь;
	
	Если НЕ ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
		ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = Ложь;
	ИначеЕсли ТипЗнч(ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП) = Тип("Строка") Тогда
		Если ВРег(ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП) = "ПОУМОЛЧАНИЮ" Тогда
			ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = ИнтеграцияИСМПКлиентСерверПовтИсп_ЗапрашиватьДанныеСервиса();
		КонецЕсли;
	ИначеЕсли ТипЗнч(ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП) = Тип("Булево") Тогда
		ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП = ПараметрыСканирования.ЗапрашиватьДанныеСервисаИСМП;
	КонецЕсли;
	//
	
	ПараметрыСканирования.Вставить("КонтролироватьРасхождениеСоставаУпаковокМеждуИБиИСМП", КонтрольСоставаУпаковок
		И ЗначениеПараметраСканированияЗапрашиватьДанныеСервисаИСМП);
	
	Если ЭтоДокументМаркировка Тогда
		
		ПараметрыСканирования.Вставить("КонтролироватьСтандартнуюВложенность", Ложь);
		ПараметрыСканирования.Вставить("КонтролироватьСоставАгрегатов",		   Истина);
		
		Если ПараметрыСканирования.Свойство("ДопустимыеСтатусыУпаковокИСМП") Тогда
			ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(
				ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Неопределен"));
			ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
	РедактированиеФормыНедоступно = Ложь;
	
	Если РедактированиеФормыНедоступно
		Или ПараметрыПроверкиКодовМаркировки.ОтсутствуетПодключениеИСМП Тогда
		
		ПараметрыСканирования.Вставить("КонтролироватьРасхождениеСоставаУпаковокМеждуИБиИСМП", Ложь);
		ПараметрыСканирования.Вставить("Владелец",											   Неопределено);
		
		Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
			ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", Ложь);
		КонецЕсли;
		Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
			ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", Ложь);
		КонецЕсли;
		
		ПараметрыСканирования.Вставить("КонтролироватьСтандартнуюВложенность",        Ложь);
		ПараметрыСканирования.Вставить("КонтролироватьСтатусыКодовМаркировкиИСМП",    Ложь);
		ПараметрыСканирования.Вставить("КонтролироватьВладельцевКодовМаркировкиИСМП", Ложь);
		
	Иначе
		Если ПараметрыПроверкиКодовМаркировки.КонтролироватьВладельцевКодовМаркировки Тогда
			//Если РежимДобавленияКодовМаркировки = ПредопределенноеЗначение("Перечисление.РежимДобавленияКодовМаркировкиИСМП.ОСУ")
			//	Или РежимДобавленияКодовМаркировки = ПредопределенноеЗначение("Перечисление.РежимДобавленияКодовМаркировкиИСМП.ПоВладельцу") Тогда
			//	ПараметрыСканирования.Владелец                                    = Неопределено;
			//	ПараметрыСканирования.КонтролироватьВладельцевКодовМаркировкиИСМП = Ложь;
			//Иначе
				ПараметрыСканирования.Вставить("Владелец",                                    ПараметрыПроверкиКодовМаркировки.Владелец);
				ПараметрыСканирования.Вставить("КонтролироватьВладельцевКодовМаркировкиИСМП", Истина);
			//КонецЕсли;
			
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", "ПоУмолчанию");
			КонецЕсли;
		Иначе
			ПараметрыСканирования.Вставить("Владелец", Неопределено);
			ПараметрыСканирования.Вставить("КонтролироватьВладельцевКодовМаркировкиИСМП", Ложь);
		КонецЕсли;
		Если ПараметрыПроверкиКодовМаркировки.КонтролироватьСтатусыКодовМаркировки Тогда
			ПараметрыСканирования.Вставить("КонтролироватьСтатусыКодовМаркировкиИСМП", Истина);
			
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеНеизвестныхУпаковокИСМП", "ПоУмолчанию");
			КонецЕсли;
		Иначе
			ПараметрыСканирования.Вставить("КонтролироватьСтатусыКодовМаркировкиИСМП", Ложь);
		КонецЕсли;
		Если ПараметрыСканирования.КонтролироватьСтатусыКодовМаркировкиИСМП
			Или ПараметрыПроверкиКодовМаркировки.КонтролироватьВладельцевКодовМаркировки Тогда
			Если ПараметрыСканирования.Свойство("ЗапрашиватьДанныеСервисаИСМП") Тогда
				ПараметрыСканирования.Вставить("ЗапрашиватьДанныеСервисаИСМП", "ПоУмолчанию");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//Если РежимДобавленияКодовМаркировки = ПредопределенноеЗначение("Перечисление.РежимДобавленияКодовМаркировкиИСМП.ОСУ")
	//	Или РежимДобавленияКодовМаркировки = ПредопределенноеЗначение("Перечисление.РежимДобавленияКодовМаркировкиИСМП.ПоВладельцу") Тогда
	//	ПараметрыСканирования.ЗаполнятьGTINПотребительскихУпаковок = Истина;
	//Иначе
		ПараметрыСканирования.Вставить("ЗаполнятьGTINПотребительскихУпаковок", Ложь);
	//КонецЕсли;
	
	Попытка
		ПродукцияОнлайнПроверкиПриРозничнойПродаже = ИО_ОбщийМодуль("ОбщегоНазначенияИСМПКлиентСерверПовтИсп").ПродукцияПодлежитОбязательнойОнлайнПроверкеПередРозничнойПродажей(
			ВидМаркируемойПродукции,
			ПараметрыСканирования.ВидОперацииИСМП,
			ПараметрыСканирования.ТребуетсяПроверкаСредствамиККТ);
	Исключение
		ПродукцияОнлайнПроверкиПриРозничнойПродаже = Ложь;		
	КонецПопытки;		
		
	ПараметрыПроверкиКодовМаркировки.ПроверятьЗаполнениеИдентификатораГИСМТ = ПродукцияОнлайнПроверкиПриРозничнойПродаже;
	
	// см. Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор.ЗаполнитьПараметрыПроверкиКодовМаркировки
	ПараметрыПроверкиКодовМаркировки.КонтролироватьСтандартнуюВложенность = ПараметрыСканирования.КонтролироватьСтандартнуюВложенность;
		
	Попытка
		ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ(ВидМаркируемойПродукции);
	Исключение
		ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ = Ложь;
	КонецПопытки;
	
	Если ЭтоДокументМаркировка
		И ВидПродукцииПоддерживаетАгрегациюКодовМаркировкиЧерезСУЗ Тогда
		ПараметрыПроверкиКодовМаркировки.КонтролироватьВложенностьУпаковок = Истина;
			
		ДопустимыеВложенияАгрегатовПоВидамПродукции = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ДопустимыеВложенияАгрегатовПоВидамПродукции();
		ПараметрыПроверкиКодовМаркировки.ДопустимыеВложенияАгрегатов = ДопустимыеВложенияАгрегатовПоВидамПродукции.Получить(ВидМаркируемойПродукции);

		ПараметрыПроверкиКодовМаркировки.КонтролироватьСоставАгрегатаПриИзмененииСтрокиДерева          = Истина;
		ПараметрыПроверкиКодовМаркировки.КонтролироватьСоставГрупповойУпаковкиПриИзмененииСтрокиДерева = Истина;
	КонецЕсли;
	//
	
КонецПроцедуры

Функция МОТП_СоздатьСтруктуруДанныеПроверкиИПодбора(Документ, ЭтоРТУ, ВидМаркируемойПродукции)
	
    ДанныеПроверкиИПодбора = Новый Структура;
		
	ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции", 			ПустоеДеревоТабачнойПродукцииИСМП());
	ДанныеПроверкиИПодбора.Вставить("ПодобраннаяТабачнаяПродукция",				ПустаяТаблицаПодобраннаяТабачнаяПродукцияИСМП());
	ДанныеПроверкиИПодбора.Вставить("ПараметрыПроверкиКодовМаркировки",			ИО_ПараметрыПроверкиКодовМаркировки("МОТП", Документ, ЭтоРТУ, ВидМаркируемойПродукции));
	ДанныеПроверкиИПодбора.Вставить("КоличествоНедопустимыхКодовМаркировки",	0);
	ДанныеПроверкиИПодбора.Вставить("УпаковкиДокумента",						Новый СписокЗначений);
	ДанныеПроверкиИПодбора.Вставить("ДетализацияСтруктурыХранения"); 
	ДанныеПроверкиИПодбора.Вставить("РежимПроверки");
	ДанныеПроверкиИПодбора.Вставить("ДобавленныеУпаковки");
	ДанныеПроверкиИПодбора.Вставить("ДоступныеДляПроверкиУпаковки",				Новый СписокЗначений);
	ДанныеПроверкиИПодбора.Вставить("СледующийСтикерОтложено");
	ДанныеПроверкиИПодбора.Вставить("СохраненВыборПоМаркируемойПродукции");
	ДанныеПроверкиИПодбора.Вставить("ДанныеВыбораПоМаркируемойПродукции");
	ДанныеПроверкиИПодбора.Вставить("ШтрихкодТекущейПроверяемойУпаковки");	
	ДанныеПроверкиИПодбора.Вставить("ДанныеРанееСгенерированныхШтрихкодов");
	ДанныеПроверкиИПодбора.Вставить("ШтрихкодыУпаковок", 						Новый СписокЗначений);
	
	Возврат ДанныеПроверкиИПодбора;
	
КонецФункции

Процедура МОТП_ОтметитьСтатусыВДереве(ДеревоМаркированнойПродукции, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, РодительОтмечен = Ложь,
	ТаблицаИзмененийТабачнойПродукции = Неопределено, БлокиБезКоробки = Неопределено, ПачкиБезБлока = Неопределено, РежимСЗапросомДанных = Ложь)
	
	//Если БлокиБезКоробки = Неопределено Тогда
	//	Попытка
	//		БлокиБезКоробки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки");
	//		ПачкиБезБлока   = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока");
	//	Исключение
	//		БлокиБезКоробки = Ложь;
	//		ПачкиБезБлока   = Ложь;
	//	КонецПопытки;
	//КонецЕсли;
	
	Для Каждого Строка из ДеревоМаркированнойПродукции.Строки Цикл
									
		Если РодительОтмечен 
			ИЛИ МассивШКВсехУпаковокСТСД.Найти(Строка.Представление) <> Неопределено
			ИЛИ МассивШКВсехУпаковокСТСД.Найти(Строка.НормализованныйШтрихкод) <> Неопределено Тогда
						
			Если ТаблицаИзмененийТабачнойПродукции <> Неопределено И Строка.СтатусПроверки <> СтатусПроверкиВНаличии Тогда
				МОТП_ДобавитьСтрокуВТаблицуИзмененийТабачнойПродукции(ТаблицаИзмененийТабачнойПродукции, Строка, 1);
			КонецЕсли;
			
			Строка.СтатусПроверки = СтатусПроверкиВНаличии;
			
		КонецЕсли;
		
		Если Строка.Строки.Количество() <> 0 Тогда			
			//СтрокаБлокиБезКоробки = Строка.ТипУпаковки = БлокиБезКоробки;
			//СтрокаПачкиБезБлока	= Строка.ТипУпаковки = ПачкиБезБлока;
			
			МОТП_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, РодительОтмечен,
				ТаблицаИзмененийТабачнойПродукции, БлокиБезКоробки, ПачкиБезБлока);
			
			//Если Строка.СтатусПроверки = СтатусПроверкиВНаличии И НЕ СтрокаБлокиБезКоробки И НЕ СтрокаПачкиБезБлока Тогда
			//	МОТП_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, Истина, ТаблицаИзмененийТабачнойПродукции, БлокиБезКоробки, ПачкиБезБлока);
			//Иначе
			//	МОТП_ОтметитьСтатусыВДереве(Строка, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии,, ТаблицаИзмененийТабачнойПродукции, БлокиБезКоробки, ПачкиБезБлока);
			//КонецЕсли;
			
			РассчитатьХешСуммыУпаковки(Строка, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Если РежимСЗапросомДанных Тогда
		МОТП_ОтметитьСтатусыВДеревеЗагруженныеВложения(ДеревоМаркированнойПродукции, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, ТаблицаИзмененийТабачнойПродукции);
	КонецЕсли;
	
КонецПроцедуры

Процедура МОТП_ОтметитьСтатусыВДеревеЗагруженныеВложения(ДеревоМаркированнойПродукции, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии,
	ТаблицаИзмененийТабачнойПродукции = Неопределено, БлокиБезКоробки = Неопределено, ПачкиБезБлока = Неопределено)
	
	Если БлокиБезКоробки = Неопределено Тогда
		Попытка
			БлокиБезКоробки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки");
			ПачкиБезБлока   = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока");
		Исключение
			БлокиБезКоробки = Ложь;
			ПачкиБезБлока   = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Для каждого СтрокаДерева ИЗ ДеревоМаркированнойПродукции.Строки Цикл
		СтрокаБлокиБезКоробки = СтрокаДерева.ТипУпаковки = БлокиБезКоробки;
		СтрокаПачкиБезБлока	  = СтрокаДерева.ТипУпаковки = ПачкиБезБлока;
		
		Если СтрокаПачкиБезБлока Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ СтрокаБлокиБезКоробки Тогда
			ЭтоУпаковкаВНаличии = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки)
				И СтрокаДерева.СтатусПроверки = СтатусПроверкиВНаличии;
				
			// Если в отмеченной упаковке нет ни одного отмеченного вложения,
			// 	значит, вложения получены из ЧЗ и должны быть отмечены полностью
			Если ЭтоУпаковкаВНаличии Тогда
				НайденнаяСтрока = СтрокаДерева.Строки.Найти(СтатусПроверкиВНаличии, "СтатусПроверки", Ложь);
			
				Если НайденнаяСтрока = Неопределено Тогда
					МОТП_ОтметитьСтатусыВДереве(СтрокаДерева, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии, Истина, ТаблицаИзмененийТабачнойПродукции);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		МОТП_ОтметитьСтатусыВДеревеЗагруженныеВложения(СтрокаДерева, МассивШКВсехУпаковокСТСД, СтатусПроверкиВНаличии,
			ТаблицаИзмененийТабачнойПродукции, БлокиБезКоробки, ПачкиБезБлока);
	КонецЦикла;

КонецПроцедуры

Функция МОТП_ОтметитьОтсутствующиеВДереве(ДеревоМаркированнойПродукции, Статусы, ТаблицаИзмененийТабачнойПродукции = Неопределено,
	БлокиБезКоробки = Неопределено, ПачкиБезБлока = Неопределено)
	
	ЕстьВНаличии = Ложь;
	
	СтатусПроверкиВНаличии 	  = Статусы.СтатусПроверкиВНаличии;
	СтатусПроверкиНеЧислилась = Статусы.СтатусПроверкиНеЧислилась;
	СтатусПроверкиОтсутствует = Статусы.СтатусПроверкиОтсутствует;
	
	Если БлокиБезКоробки = Неопределено Тогда
		Попытка
			БлокиБезКоробки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки");
			ПачкиБезБлока   = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока");
		Исключение
			БлокиБезКоробки = Ложь;
			ПачкиБезБлока   = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Для Каждого Строка из ДеревоМаркированнойПродукции.Строки Цикл
									
		СтрокаБлокиБезКоробки = Строка.ТипУпаковки = БлокиБезКоробки;
		СтрокаПачкиБезБлока	  = Строка.ТипУпаковки = ПачкиБезБлока;
		
		Если Строка.СтатусПроверки <> СтатусПроверкиВНаличии И Строка.СтатусПроверки <> СтатусПроверкиНеЧислилась ИЛИ СтрокаБлокиБезКоробки ИЛИ СтрокаПачкиБезБлока Тогда
			
			// Для упаковок проверяем статусы вложенных позиций
			Если Строка.ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") 
				И МОТП_ОтметитьОтсутствующиеВДереве(Строка, Статусы, ТаблицаИзмененийТабачнойПродукции, БлокиБезКоробки, ПачкиБезБлока) Тогда
				
				Если НЕ СтрокаБлокиБезКоробки И НЕ СтрокаПачкиБезБлока Тогда
					Если ТаблицаИзмененийТабачнойПродукции <> Неопределено 
						И Строка.СтатусПроверки <> СтатусПроверкиВНаличии
						И Строка.СтатусПроверки <> СтатусПроверкиНеЧислилась Тогда
						МОТП_ДобавитьСтрокуВТаблицуИзмененийТабачнойПродукции(ТаблицаИзмененийТабачнойПродукции, Строка, 1);
					КонецЕсли;				
					Строка.СтатусПроверки = СтатусПроверкиВНаличии;
					ЕстьВНаличии = Истина;
				КонецЕсли;
				
			Иначе
				
				Если ТаблицаИзмененийТабачнойПродукции <> Неопределено И Строка.СтатусПроверки <> СтатусПроверкиОтсутствует Тогда
					МОТП_ДобавитьСтрокуВТаблицуИзмененийТабачнойПродукции(ТаблицаИзмененийТабачнойПродукции, Строка, -1);
				КонецЕсли;				
				Строка.СтатусПроверки = СтатусПроверкиОтсутствует;
				
			КонецЕсли;
			
		Иначе
			ЕстьВНаличии = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьВНаличии;
	
КонецФункции

Процедура МОТП_ДобавитьВДеревоУпаковкиСОшибками(ДеревоМаркированнойПродукции,СоответствияШКСтруктуреДанных)
	
	Для каждого Элемент из СоответствияШКСтруктуреДанных Цикл
		Если Элемент.Значение.Ошибка <> "" Тогда
			НоваяСтрока = ДеревоМаркированнойПродукции.Строки.Добавить();
			
			НоваяСтрока.ПредставлениеПроверкиПодчиненных = Элемент.Ключ;			
			НоваяСтрока.Штрихкод 				 		 = Элемент.Ключ;
			НоваяСтрока.Представление 					 = Элемент.Ключ+": "+Элемент.Значение.Ошибка;					
					
			//Выполнить("ПроверкаИПодборПродукцииМОТПКлиентСервер.СформироватьПредставлениеПроверкиПодчиненных(НоваяСтрока)");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция МОТП_ПустаяТаблицаИзмененийТабачнойПродукции()
	
	ТребуетсяПереименованиеКолонок = Ложь;
	Попытка
		КолонкиДерева = Обработки["РезультатыСверкиКодовМаркировкиТОРГ2"].ДеревоМаркированнойПродукции().Колонки; // Временное решение для проверки новых колонок
		Если КолонкиДерева.Найти("КоличествоПодчиненныхПотребительскихУпаковок") <> Неопределено Тогда
			ТребуетсяПереименованиеКолонок = Истина;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	ТипЧисло15_3 = Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Неотрицательный));
	ТипСтрока 	 = Новый ОписаниеТипов("Строка");
	ТипЧисло  	 = Новый ОписаниеТипов("Число");
	ТипБулево 	 = Новый ОписаниеТипов("Булево");
	
	ТаблицаИзменений = Новый ТаблицаЗначений;
	ТаблицаИзменений.Колонки.Добавить("Номенклатура", 					Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
	ТаблицаИзменений.Колонки.Добавить("Характеристика", 				Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	ТаблицаИзменений.Колонки.Добавить("Серия", 							Метаданные.ОпределяемыеТипы.СерияНоменклатуры.Тип);
	ТаблицаИзменений.Колонки.Добавить("Изменение", 						ТипЧисло);
	ТаблицаИзменений.Колонки.Добавить("ТипУпаковки", 					Новый ОписаниеТипов("ПеречислениеСсылка.ТипыУпаковок"));
	ТаблицаИзменений.Колонки.Добавить("GTIN", 							Метаданные.ОпределяемыеТипы.GTIN.Тип);
	ТаблицаИзменений.Колонки.Добавить("МРЦ", 							ТипЧисло);
	ТаблицаИзменений.Колонки.Добавить("ПредставлениеНоменклатуры",		ТипСтрока);
	ТаблицаИзменений.Колонки.Добавить("ВидУпаковки", 					?(Метаданные.Перечисления.Найти("ВидыУпаковокИС") <> Неопределено, Новый ОписаниеТипов("ПеречислениеСсылка.ВидыУпаковокИС"), ТипСтрока));
	
	Если ТребуетсяПереименованиеКолонок Тогда
		ТаблицаИзменений.Колонки.Добавить("НеПересчитыватьКоличествоПотребительскихУпаковок", ТипБулево);
	Иначе
		ТаблицаИзменений.Колонки.Добавить("НеПересчитыватьКоличествоПачек", ТипБулево);
	КонецЕсли;
	
	ТаблицаИзменений.Колонки.Добавить("ВключаетМРЦ", 					ТипБулево);
	ТаблицаИзменений.Колонки.Добавить("Количество", 					ТипЧисло15_3);
	ТаблицаИзменений.Колонки.Добавить("ПроизвольнаяЕдиницаУчета", 		ТипБулево);
	ТаблицаИзменений.Колонки.Добавить("ТребуетВзвешивания", 			ТипБулево);
	
	Возврат ТаблицаИзменений;
	
КонецФункции

Процедура МОТП_ДобавитьСтрокуВТаблицуИзмененийТабачнойПродукции(ТаблицаИзмененийТабачнойПродукции, СтрокаДерева, Изменение)
	
	НоваяСтрока = ТаблицаИзмененийТабачнойПродукции.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
	НоваяСтрока.ПредставлениеНоменклатуры = СтрокаДерева.ПредставлениеСодержимоеУпаковки;
	
	Если СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
		НоваяСтрока.Изменение = Изменение;
	Иначе
		Попытка
			НоваяСтрока.Изменение = Изменение * СтрокаДерева.КоличествоПодчиненныхПотребительскихУпаковок;
		Исключение
			НоваяСтрока.Изменение = Изменение * СтрокаДерева.КоличествоПодчиненныхПачек;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура МОТП_ОбработатьТаблицуИзмененийТабачнойПродукции(Форма)

	Для Каждого СтрокаТаблицы Из Форма.ТаблицаИзмененийТабачнойПродукции Цикл
		
		Если СтрокаТаблицы.Изменение > 0 Тогда
			
			МОТП_ПодобраннаяМаркируемаяПродукцияПриДобавленииСтроки(Форма, СтрокаТаблицы);
			
		ИначеЕсли СтрокаТаблицы.Изменение < 0 Тогда
			
			МОТП_ПодобраннаяМаркируемаяПродукцияПриУдаленииСтроки(Форма, СтрокаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ТаблицаИзмененийТабачнойПродукции.Очистить();

КонецПроцедуры

Процедура МОТП_ПодобраннаяМаркируемаяПродукцияПриДобавленииСтроки(Форма, СтрокаИзменений)
	
	Если Не МОТП_ТребуетсяОбработатьСтрокуИзмененийПродукции(Форма, СтрокаИзменений) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьПеречислениеИС 	 = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено;
	ЕстьПеречислениеМОТП = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП") <> Неопределено;
	Если ЕстьПеречислениеИС Тогда
		ДетализацияКоробаСГрупповымиУпаковками 	= ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
		ДетализацияПалетыСМонотоварнымиКоробами = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПалетыСМонотоварнымиКоробами");
	Иначе	
		ДетализацияКоробаСГрупповымиУпаковками 	= ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.КоробкиСБлоками");
		ДетализацияПалетыСМонотоварнымиКоробами = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Коробки");
	КонецЕсли;
	
	Если ТипЗнч(СтрокаИзменений) <> Тип("ДанныеФормыЭлементДерева") Тогда
		ИзменениеКоличества = СтрокаИзменений.Изменение;
	ИначеЕсли СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская")Тогда
		ИзменениеКоличества = 1;
	ИначеЕсли Форма.ДетализацияСтруктурыХранения = ДетализацияКоробаСГрупповымиУпаковками
		Или Форма.ДетализацияСтруктурыХранения = ДетализацияПалетыСМонотоварнымиКоробами Тогда
		Попытка
			ИзменениеКоличества = СтрокаИзменений.КоличествоПодчиненныхПотребительскихУпаковок;
		Исключение
			ИзменениеКоличества = СтрокаИзменений.КоличествоПодчиненныхПачек;			
		КонецПопытки;
	ИначеЕсли СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
		Или СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая") Тогда
		Попытка
			ИзменениеКоличества = СтрокаИзменений.КоличествоПодчиненныхПотребительскихУпаковок;
		Исключение
			ИзменениеКоличества = СтрокаИзменений.КоличествоПодчиненныхПачек;			
		КонецПопытки;
	Иначе
		ИзменениеКоличества = 1;
	КонецЕсли;
	
	ОбработчикВыполнен = Истина;
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ПодобраннаяПродукцияПриДобавленииСтроки(Форма, СтрокаИзменений, ИзменениеКоличества, ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП"));
    Исключение
		ОбработчикВыполнен = Ложь;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("МОТП_ПодобраннаяМаркируемаяПродукцияПриДобавленииСтроки", "Ошибка", ТекстОшибки);	
	КонецПопытки;
	
	Если НЕ ОбработчикВыполнен Тогда
		Попытка
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ПодобраннаяПродукцияПриДобавленииСтроки(Форма, СтрокаИзменений, ИзменениеКоличества);
		Исключение
			ОбработчикВыполнен = Ложь;
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("МОТП_ПодобраннаяМаркируемаяПродукцияПриДобавленииСтроки", "Ошибка", ТекстОшибки);	
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура МОТП_ПодобраннаяМаркируемаяПродукцияПриУдаленииСтроки(Форма, СтрокаИзменений)
	
	Если Не МОТП_ТребуетсяОбработатьСтрокуИзмененийПродукции(Форма, СтрокаИзменений) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработчикВыполнен = Истина;
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ПодобраннаяПродукцияПриУдаленииСтроки(Форма, СтрокаИзменений, СтрокаИзменений.Изменение, ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП"));
	Исключение
		ОбработчикВыполнен = Ложь;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("МОТП_ПодобраннаяМаркируемаяПродукцияПриУдаленииСтроки", "Ошибка", ТекстОшибки);	
	КонецПопытки;
	
	Если НЕ ОбработчикВыполнен Тогда
		Попытка
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ПодобраннаяПродукцияПриУдаленииСтроки(Форма, СтрокаИзменений, СтрокаИзменений.Изменение);
		Исключение
			ОбработчикВыполнен = Ложь;
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("МОТП_ПодобраннаяМаркируемаяПродукцияПриУдаленииСтроки", "Ошибка", ТекстОшибки);					
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры
	
Функция МОТП_ТребуетсяОбработатьСтрокуИзмененийПродукции(Форма, СтрокаИзменений)
	
	Если ПустаяСтрока(СтрокаИзменений.GTIN) Тогда
		Возврат Ложь;
	ИначеЕсли СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЕстьПеречислениеИС 	 = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено;
	ЕстьПеречислениеМОТП = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП") <> Неопределено;
	Если ЕстьПеречислениеИС Тогда
		ДетализацияКоробаСГрупповымиУпаковками 	= ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
		ДетализацияПалетыСМонотоварнымиКоробами = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПалетыСМонотоварнымиКоробами");
	Иначе	
		ДетализацияКоробаСГрупповымиУпаковками 	= ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.КоробкиСБлоками");
		ДетализацияПалетыСМонотоварнымиКоробами = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Коробки");
	КонецЕсли;
	
	Попытка
		НеПересчитыватьКоличествоПотребительскихУпаковок = СтрокаИзменений.НеПересчитыватьКоличествоПотребительскихУпаковок;
	Исключение
		НеПересчитыватьКоличествоПотребительскихУпаковок = СтрокаИзменений.НеПересчитыватьКоличествоПачек;
	КонецПопытки;
	
	Если Форма.ДетализацияСтруктурыХранения = ДетализацияКоробаСГрупповымиУпаковками Тогда
		
		Если НеПересчитыватьКоличествоПотребительскихУпаковок Тогда
			Возврат (СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
				Или СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"));
		КонецЕсли;
		
		Возврат (СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая"));
		
	ИначеЕсли Форма.ДетализацияСтруктурыХранения = ДетализацияПалетыСМонотоварнымиКоробами Тогда
		
		Возврат (СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
			Или СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"));
		
	КонецЕсли;
	
	Если НеПересчитыватьКоличествоПотребительскихУпаковок Тогда
		
		Возврат (СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
			Или СтрокаИзменений.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая"));
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция УТ_11_2_ПолучитьСрокГодностиИзGS1Марка(СтруктураПараметров)

	СтрокаТабличнойЧастиДокументаТСД = СтруктураПараметров.СтрокаТабличнойЧастиДокументаТСД;
	
	GS1Марка = ?(СтрокаТабличнойЧастиДокументаТСД.Свойство("GS1Марка"), СтрокаТабличнойЧастиДокументаТСД.GS1Марка, "");
	
	Если НЕ ЗначениеЗаполнено(GS1Марка) Тогда
		Возврат Дата(1,1,1);	
	КонецЕсли;
	
	ГоденДо = Дата(1,1,1);
					
	ПозицияДаты = ГлЯдро_СтрНайти(GS1Марка, "(17)");
	Если ПозицияДаты > 0 Тогда
		Попытка
			ГоденДо = Дата("20" + Сред(GS1Марка, ПозицияДаты + 4, 6));
		Исключение	
			ГоденДо = Дата(1,1,1);
		КонецПопытки;
	Иначе
		ПозицияДатыВремени = ГлЯдро_СтрНайти(GS1Марка, "(7003)");
		Если ПозицияДатыВремени > 0 Тогда
			Попытка
				ГоденДо = Дата("20" + Сред(GS1Марка, ПозицияДатыВремени + 6, 10));
			Исключение	
				ГоденДо = Дата(1,1,1);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ГоденДо;
	
КонецФункции

Процедура УТ_11_4_ПроверитьПродукциюИСМП(СтруктураПараметров, ВидПродукцииИС = Неопределено)
	
	ИмяСобытия = "УТ_11_4_ПроверитьПродукциюИСМП";
	
	ДокументТСД		   = СтруктураПараметров.ДокументТСД;	
	СтрокиФакт 		   = ДокументТСД.СтрокиФакт;
	Док1СРезультат 	   = СтруктураПараметров.Док1СРезультат;					
	НастройкаБП 	   = СтруктураПараметров.СтрокаНастройки;
	
	ЕстьРаботаСИСМП = Ложь;
	ЕстьИСМП = Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИС") <> Неопределено
		ИЛИ Метаданные.РегистрыСведений.Найти("СтатусыПроверкиИПодбораДокументовИСМП") <> Неопределено;
	ЕстьМТИСМП = Метаданные.Документы.Найти("МаркировкаТоваровИСМП") <> Неопределено;
	
	//Если в конфигурации нет необходимых метаданных, тогда ничего делать не нужно
	Если НЕ ЕстьИСМП
		ИЛИ НЕ ЕстьМТИСМП Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеНСИ = Конф_ПолучитьМетаданныеНСИ();
	ИспользованиеХарактеристик = МетаданныеНСИ.Свойство("Характеристики")
		И МетаданныеНСИ.Характеристики.Свойство("Использование")
		И МетаданныеНСИ.Характеристики.Использование = Истина;
	ИспользованиеСерий = МетаданныеНСИ.Свойство("Серии")
		И МетаданныеНСИ.Серии.Свойство("Использование")
		И МетаданныеНСИ.Серии.Использование = Истина;
	
	ИменаДокументов = УТ_11_4_ПолучитьИспользуемыеИменаДокументов();
	
	Если НЕ СтруктураПараметров.Свойство("ФлагиТипаДокумента") Тогда   
		ПараметрыАлгоритма = Новый Структура; 
		ПараметрыАлгоритма.Вставить("Док1СРезультат", Док1СРезультат);
		Если СтруктураПараметров.Свойство("ИмяМодуляБезопасногоРежима") Тогда
			ПараметрыАлгоритма.Вставить("ИмяОбщегоМодуля", 	СтруктураПараметров.ИмяМодуляБезопасногоРежима);
		КонецЕсли;
		
		ФлагиТипаДокумента = Новый Структура;
		Для каждого ИмяДокумента ИЗ ИменаДокументов Цикл
			ФлагиТипаДокумента.Вставить(ИмяДокумента.Ключ, ?(ЗначениеЗаполнено(ИмяДокумента.Значение), ГлЯдро_ВычислитьВБезопасномРежиме("ТипЗнч(Параметры.Док1СРезультат) = Тип(""ДокументОбъект." + ИмяДокумента.Значение + """)", ПараметрыАлгоритма).Результат, Ложь));
		КонецЦикла;
	    СтруктураПараметров.Вставить("ФлагиТипаДокумента", ФлагиТипаДокумента);
	Иначе
		ФлагиТипаДокумента = СтруктураПараметров.ФлагиТипаДокумента;
	КонецЕсли;
	
	ЭтоПриемка 	= ФлагиТипаДокумента.ПоступлениеТУ ИЛИ ФлагиТипаДокумента.ПриемкаИСМП
		ИЛИ ФлагиТипаДокумента.ПриходныйОрдерНаТовары;
	ЭтоОтгрузка = ФлагиТипаДокумента.РеализацияТУ ИЛИ ФлагиТипаДокумента.ОтгрузкаИСМП
		ИЛИ ФлагиТипаДокумента.РасходныйОрдерНаТовары ИЛИ ФлагиТипаДокумента.ПеремещениеПоЯчейкам;
	ЭтоВозвратСписание = ФлагиТипаДокумента.ВозвратПоставщику ИЛИ ФлагиТипаДокумента.ВыводИзОборотаИСМП 
		ИЛИ ФлагиТипаДокумента.СписаниеИСМП ИЛИ ФлагиТипаДокумента.ВозвратОтКлиента;
	ЭтоМаркировка = ФлагиТипаДокумента.МаркировкаИСМП;
	
	ЭтоАгрегация = Ложь;
	Если ФлагиТипаДокумента.МаркировкаИСМП И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("Агрегация") <> Неопределено Тогда
		ЭтоАгрегация = Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.Агрегация");			
	КонецЕсли;	
	
	Если Метаданные.Перечисления["ВидыПродукцииИС"].ЗначенияПеречисления.Найти("Обувь") <> Неопределено Тогда 
		ВидПродукцииОбувь = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Обувь");
	Иначе
		ВидПродукцииОбувь = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.Обувная");
	КонецЕсли;
	
	Если ВидПродукцииИС = Неопределено Тогда // По умолчанию обувь
		ВидПродукцииИС = ВидПродукцииОбувь;	
	КонецЕсли;
	
	РеквизитыВидовПродукцииИС = УТ_11_4_ПолучитьРеквизитыВидовПродукцииИС(Истина);
	
	ФлагиПризнакаМаркировки = Новый Структура;
	Для каждого РеквизитыВидаПродукцииИС ИЗ РеквизитыВидовПродукцииИС Цикл
		ФлагиПризнакаМаркировки.Вставить(РеквизитыВидаПродукцииИС.Значение.ЗначениеМаркировки, Ложь);
	КонецЦикла;

    // Определяем значение признака маркировки, по которому будем отбирать СтрокиФакт
	ОжидаемыйПризнакМаркировки = "";
	Для каждого РеквизитыВидаПродукцииИС ИЗ РеквизитыВидовПродукцииИС Цикл
		Если ВидПродукцииИС = РеквизитыВидаПродукцииИС.Ключ Тогда
			ЗначениеМаркировки = РеквизитыВидаПродукцииИС.Значение.ЗначениеМаркировки;
			ФлагиПризнакаМаркировки.Вставить(ЗначениеМаркировки, Истина);
			ОжидаемыйПризнакМаркировки = ЗначениеМаркировки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ОжидаемыйПризнакМаркировки) Тогда
		Сообщить("Не удалось определить признак маркировки для вида продукции " + СокрЛП(ВидПродукцииИС));
		Возврат;
	КонецЕсли;
	
	НеоднозначныеПризнакиМаркировки = Новый Массив;
	НеоднозначныеПризнакиМаркировки.Добавить("Молоко");
	НеоднозначныеПризнакиМаркировки.Добавить("Пиво");
	НеоднозначныеПризнакиМаркировки.Добавить("КормДляДЖ");
	НеоднозначныеПризнакиМаркировки.Добавить("КонсервПродукты");
	НеоднозначныеПризнакиМаркировки.Добавить("Соки");
	НеоднозначныеПризнакиМаркировки.Добавить("КреслаКоляски");
	НеоднозначныеПризнакиМаркировки.Добавить("Одежда");
	НеоднозначныеПризнакиМаркировки.Добавить("Радиоэлектроника");
	НеоднозначныеПризнакиМаркировки.Добавить("Антисептики");
	НеоднозначныеПризнакиМаркировки.Добавить("БАД");
	НеоднозначныеПризнакиМаркировки.Добавить("ИСМП");
	
	ЭтоНеоднозначныйПризнакМаркировки = Ложь;
	Для каждого ПризнакМаркировки ИЗ НеоднозначныеПризнакиМаркировки Цикл
		Если ФлагиПризнакаМаркировки.Свойство(ПризнакМаркировки) И ФлагиПризнакаМаркировки[ПризнакМаркировки] Тогда
			ЭтоНеоднозначныйПризнакМаркировки = Истина;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЭтоМолоко = ФлагиПризнакаМаркировки.Свойство("Молоко") И ФлагиПризнакаМаркировки.Молоко;
	ЭтоФото   = ФлагиПризнакаМаркировки.Свойство("Фото")   И ФлагиПризнакаМаркировки.Фото;
	ЭтоМеха   = ФлагиПризнакаМаркировки.Свойство("Меха")   И ФлагиПризнакаМаркировки.Меха;
	
	Если ЗначениеЗаполнено(Док1СРезультат.Ссылка) 
		//И (ЭтоМТИСМП ИЛИ ЭтоПТУ ИЛИ ЭтоРТУ) // 10.11.20 Осипов. Убрал проверку на тип документа, надо проверять сохраненные данные для любого типа
		Тогда		
		Попытка
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.Получить(Новый Структура("Документ, ВидМаркируемойПродукции, Сценарий", Док1СРезультат.Ссылка, ВидПродукцииИС, 0));
		Исключение
			РесурсыРС = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИСМП.Получить(Новый Структура("Документ, ВидМаркируемойПродукции", Док1СРезультат.Ссылка, ВидПродукцииИС));
		КонецПопытки;
		
		Если РесурсыРС.СтатусПроверкиИПодбора = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Завершено") Тогда
			Сообщить("В выбранном документе подбор маркированного товара уже завершен. Данные с ТСД не будут загружены.");
			Возврат;
		КонецЕсли;
		ДанныеПроверкиИПодбора = РесурсыРС.ДанныеПроверкиИПодбора.Получить();
	Иначе
		ДанныеПроверкиИПодбора = Неопределено;
	КонецЕсли;
	
	ИспользованиеПолныхКодовМаркировки = Ложь;
	Если Метаданные.ОпределяемыеТипы.Найти("ОснованиеФискальнойОперацииИСМП") <> Неопределено // Основание фиксальной операции
		И Метаданные.ОпределяемыеТипы["ОснованиеФискальнойОперацииИСМП"].Тип.СодержитТип(ТипЗнч(Док1СРезультат.Ссылка)) Тогда
		ИспользованиеПолныхКодовМаркировки = Истина;
	ИначеЕсли ФлагиТипаДокумента.МаркировкаИСМП // Отчет о верификации нанесенных КМ
		И Метаданные.Перечисления["ВидыОперацийИСМП"].ЗначенияПеречисления.Найти("ОтчетОВерификацииНанесенныхКМ") <> Неопределено
		И (Док1СРезультат.Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ОтчетОВерификацииНанесенныхКМ")
			ИЛИ Док1СРезультат.ОперацияНанесения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ОтчетОВерификацииНанесенныхКМ")) Тогда
		ИспользованиеПолныхКодовМаркировки = Истина;
	КонецЕсли;
	
	СтатусПроверкиВНаличии 		= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");									
	СтатусПроверкиОтсутствует 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.Отсутствует");
	СтатусПроверкиНеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась");									
	СтатусПроверкиНеЧислилась 	= ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась");									
	
	РежимПодбораСуществующихУпаковок = НЕ ИО_ЭтоДокументПриобретения(Док1СРезультат, ФлагиТипаДокумента);
	Если ДанныеПроверкиИПодбора = Неопределено 
		ИЛИ РежимПодбораСуществующихУпаковок Тогда
		СтатусДляНовыхСтрок = СтатусПроверкиВНаличии;
	Иначе
		СтатусДляНовыхСтрок = СтатусПроверкиНеЧислилась;
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора <> Неопределено Тогда
		ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;	
		ПодобраннаяМаркируемаяПродукция = ДанныеПроверкиИПодбора.ПодобраннаяМаркируемаяПродукция;		
	КонецЕсли;		
	    
	Если ДанныеПроверкиИПодбора = Неопределено
		ИЛИ ДеревоМаркированнойПродукции = Неопределено Тогда
		ДеревоМаркированнойПродукции = ПустоеДеревоМаркированнойПродукцииИСМП(СтруктураПараметров);
		
		// +++ 31.03.20 Если дерево пустое, то возможно в документе есть штрихкоды верхнего уровня упаковок,
		// но пока мы это учитывать не будем
		//РезультатПолученияДанных = ШтрихкодированиеИСМПСлужебный.ВложенныеШтрихкодыУпаковокПоДокументу(
		//		Док1СРезультат.Ссылка, Неопределено);
		//ДанныеПроверяемогоДокумента = РезультатПолученияДанных.ВложенныеШтрихкоды;
		
		//ДополнитьТаблицуПодобраннойМаркируемойПродукции(ДанныеПроверяемогоДокумента.МаркированныеТовары, ДанныеДокумента, Параметры.ВидМаркируемойПродукции);
		//ЗаполнитьДеревоМаркированнойПродукции(ДанныеПроверяемогоДокумента.ДеревоУпаковок, ДанныеДокумента);
		// ---		
	КонецЕсли;
	
	ЗаполнятьТаблицуМаркированнойПродукцииПоДаннымДокумента = Ложь;
	Если ДанныеПроверкиИПодбора = Неопределено
		ИЛИ ПодобраннаяМаркируемаяПродукция = Неопределено Тогда
		ПодобраннаяМаркируемаяПродукция = ПустаяТаблицаПодобраннойМаркируемойПродукцииИСМП(СтруктураПараметров);
		
		Если НЕ Док1СРезультат.ЭтоНовый() Тогда
			ЗаполнятьТаблицуМаркированнойПродукцииПоДаннымДокумента = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора <> Неопределено 
		И ДанныеПроверкиИПодбора.Свойство("ДетализацияСтруктурыХранения") Тогда
		ДетализацияСтруктурыХранения = ДанныеПроверкиИПодбора.ДетализацияСтруктурыХранения;
	Иначе
		Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено Тогда
			ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
		Иначе
			ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияПродукцииИСМП.Полная");
		КонецЕсли;
	КонецЕсли;
	
	СоответствиеПараметров = Новый Соответствие;
	
	Попытка
		ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукции, СоответствиеПараметров, ВидПродукцииИС);
		ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукция, СоответствиеПараметров, ВидПродукцииИС);
	Исключение КонецПопытки;
	
	КолонкиДерева = ДеревоМаркированнойПродукции.Колонки;
	ИмяКолонкиСкоропортящаясяПродукция = ?(КолонкиДерева.Найти("СкоропортящаясяПродукция") <> Неопределено,
		"СкоропортящаясяПродукция", "Скоропортящаяся");
	
	Если ПодобраннаяМаркируемаяПродукция.Колонки.Найти("ХарактеристикиИспользуются") = Неопределено Тогда	
		ПодобраннаяМаркируемаяПродукция.Колонки.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если ПодобраннаяМаркируемаяПродукция.Колонки.Найти("ИндексКодаМаркировки") = Неопределено Тогда	
		ПодобраннаяМаркируемаяПродукция.Колонки.Добавить("ИндексКодаМаркировки", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	// Выполняем начальное заполнение таблицы подобранной маркируемой продукции с помощью типового метода		
	Если ЗаполнятьТаблицуМаркированнойПродукцииПоДаннымДокумента Тогда
		ИСМП_МОТП_ЗаполнитьТаблицуМаркируемойПродукцииПоДаннымДокумента(ПодобраннаяМаркируемаяПродукция, Док1СРезультат.Ссылка, ВидПродукцииИС);
	КонецЕсли;
	
	Если ДанныеПроверкиИПодбора = Неопределено Тогда
		ДанныеПроверкиИПодбора = Новый Структура();
	КонецЕсли;
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло  = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипДата	  = Новый ОписаниеТипов("Дата");
	
	ТаблицаМаркированнойПродукцииИСМП = Новый ТаблицаЗначений;
	
	КолонкиТаблицыЗначений = ТаблицаМаркированнойПродукцииИСМП.Колонки;
	КолонкиТаблицыЗначений.Добавить("Номенклатура",			Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
	КолонкиТаблицыЗначений.Добавить("Характеристика",		Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	КолонкиТаблицыЗначений.Добавить("Серия",				Метаданные.ОпределяемыеТипы.СерияНоменклатуры.Тип);
	КолонкиТаблицыЗначений.Добавить("GTIN",					Метаданные.ОпределяемыеТипы.GTIN.Тип);
	КолонкиТаблицыЗначений.Добавить("СтатусПроверки",		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыПроверкиНаличияПродукцииИС"));		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПачки",		ТипСтрока);
	КолонкиТаблицыЗначений.Добавить("ШтрихкодГруппы",		ТипСтрока); // Групповая упаковка или набор
	КолонкиТаблицыЗначений.Добавить("ШтрихкодКоробки",		ТипСтрока);		
	КолонкиТаблицыЗначений.Добавить("ШтрихкодПалеты",		ТипСтрока);
	КолонкиТаблицыЗначений.Добавить("КоличествоУпаковок",	ТипЧисло);
	КолонкиТаблицыЗначений.Добавить("ПолныйКодМаркировки",	ТипСтрока);
	
	// Заполнение реквизитов ВЕТИС
	КолонкиТаблицыЗначений.Добавить("ИдентификаторПроисхожденияВетИС",	?(Метаданные.ОпределяемыеТипы.Найти("ИдентификаторПроисхожденияВЕТИС") <> Неопределено, Метаданные.ОпределяемыеТипы.ИдентификаторПроисхожденияВЕТИС.Тип, ТипСтрока));
	КолонкиТаблицыЗначений.Добавить("ГоденДо",							ТипДата);
	КолонкиТаблицыЗначений.Добавить(ИмяКолонкиСкоропортящаясяПродукция,	ТипБулево);
	
	// Весовая продукция
	КолонкиТаблицыЗначений.Добавить("НомерСтроки",						 ТипЧисло); // Для заполнения служебных реквизитов в коллекции
	КолонкиТаблицыЗначений.Добавить("ПроизвольнаяЕдиницаУчета", 		 ТипБулево);
	КолонкиТаблицыЗначений.Добавить("ТребуетВзвешивания",				 ТипБулево);
	КолонкиТаблицыЗначений.Добавить("ИдЕдиницыИзмерения",		 		 ТипСтрока); // Для пересчета количества фасованной продукции
	КолонкиТаблицыЗначений.Добавить("КоличествоПотребительскихУпаковок", ТипЧисло);
	КолонкиТаблицыЗначений.Добавить("ПотребительскаяУпаковка",			 Метаданные.ОпределяемыеТипы.Упаковка.Тип);
	
	// Объемно-сортовой учет
	КолонкиТаблицыЗначений.Добавить("ОбъемноСортовойУчет", 					ТипБулево);
	КолонкиТаблицыЗначений.Добавить("КоличествоПодобраноВзвешеноОСУ", 		ТипЧисло);
	КолонкиТаблицыЗначений.Добавить("КоличествоПотребительскихУпаковокОСУ", ТипЧисло);
	КолонкиТаблицыЗначений.Добавить("КоличествоНеПроверялось",				ТипЧисло);
	
	// Групповые упаковки и наборы
	КолонкиТаблицыЗначений.Добавить("GTINГруппы",	ТипСтрока);
	КолонкиТаблицыЗначений.Добавить("ВидУпаковки",	?(Метаданные.Перечисления.Найти("ВидыУпаковокИС") <> Неопределено, 
		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыУпаковокИС"),
		ТипСтрока));
	
	Листья = Новый Массив;
	
	ЕстьКолонкаКоличество 						 = КолонкиДерева.Найти("Количество") <> Неопределено;
	ЕстьКолонкаКоличествоПотребительскихУпаковок = КолонкиДерева.Найти("КоличествоПодчиненныхПотребительскихУпаковок") <> Неопределено;
	
	ПолучитьЛистьяДереваЗначений(ДеревоМаркированнойПродукции.Строки, Листья);	
	ПолеШтрихкода = "Штрихкод";
	Для каждого Лист Из Листья Цикл		
		
		СтруктураШтрихкодов = ПолучитьПустуюСтруктуруШтрихкодов();		
		ЗаполнитьСтруктуруШтрихкодовИСМП(Лист, СтруктураШтрихкодов, ПолеШтрихкода);
		
		Родитель = Лист.Родитель;
		Пока Родитель <> Неопределено Цикл		
			ЗаполнитьСтруктуруШтрихкодовИСМП(Родитель, СтруктураШтрихкодов,ПолеШтрихкода);									
			Родитель = Родитель.Родитель;			
		КонецЦикла;
		
		Если ТипЗнч(Лист.ТипУпаковки) <> Тип("ПеречислениеСсылка.ТипыУпаковок") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаМаркированнойПродукцииИСМП.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураШтрихкодов);
		НоваяСтрока.Номенклатура 	= Лист.Номенклатура;
		НоваяСтрока.Характеристика 	= Лист.Характеристика;
		НоваяСтрока.Серия			= Лист.Серия;
		НоваяСтрока.GTIN 			= Лист.GTIN;
		НоваяСтрока.СтатусПроверки	= Лист.СтатусПроверки;
		НоваяСтрока.ВидУпаковки		= Лист.ВидУпаковки;
		
		Если НЕ ПустаяСтрока(НоваяСтрока.ШтрихкодГруппы) Тогда
			НоваяСтрока.GTINГруппы = ?(Лев(НоваяСтрока.ШтрихкодГруппы, 1) = "(",
				Сред(НоваяСтрока.ШтрихкодГруппы, 5, 14),
				Лев(НоваяСтрока.ШтрихкодГруппы, 14));	
		КонецЕсли;
		
		// Заполнение реквизитов ВЕТИС
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Лист, "ИдентификаторПроисхожденияВЕТИС, ГоденДо, " + ИмяКолонкиСкоропортящаясяПродукция);
		
		ОбъемноСортовойУчет = СтруктураШтрихкодов.ОбъемноСортовойУчет;
		Если НоваяСтрока.СтатусПроверки = СтатусПроверкиВНаличии
			ИЛИ НоваяСтрока.СтатусПроверки = СтатусПроверкиНеЧислилась Тогда
			НоваяСтрока.КоличествоУпаковок 				  = ?(ЕстьКолонкаКоличество И Лист.Количество > 0,
				Лист.Количество, 
				1);
			НоваяСтрока.КоличествоПотребительскихУпаковок = ?(ЕстьКолонкаКоличествоПотребительскихУпаковок И Лист.КоличествоПодчиненныхПотребительскихУпаковок > 0,
				Лист.КоличествоПодчиненныхПотребительскихУпаковок,
				1);
			Если ОбъемноСортовойУчет Тогда
				НоваяСтрока.КоличествоПодобраноВзвешеноОСУ 		 = НоваяСтрока.КоличествоУпаковок;
				НоваяСтрока.КоличествоПотребительскихУпаковокОСУ = НоваяСтрока.КоличествоПотребительскихУпаковок;
			КонецЕсли;
		КонецЕсли;
		Если ОбъемноСортовойУчет Тогда
			НоваяСтрока.КоличествоНеПроверялось = Лист.КоличествоПодчиненныхНеПроверялось;
		КонецЕсли;
	КонецЦикла;
	
	// 27.05.20 Уберем сброс статусов перед загрузкой, потому что могут грузиться данные с нескольких ТСД
	//Если Не ЭтоРТУ Тогда
	//	ТаблицаМаркированнойПродукцииИСМП.ЗаполнитьЗначения(0, 								"КоличествоУпаковок");
	//	ТаблицаМаркированнойПродукцииИСМП.ЗаполнитьЗначения(СтатусПроверкиНеПроверялась, 	"СтатусПроверки");
	//КонецЕсли;
	
	Кэш_МаркировкаНоменклатуры 	= Новый Соответствие;
	Кэш_ОсобенностиНоменклатуры	= Новый Соответствие;
	СоответствующаяОсобенностьУчета = Неопределено;
	
	ТаблицаМаркированнойПродукцииИСМППлана = ТаблицаМаркированнойПродукцииИСМП.Скопировать();
	
	// 1. палеты и коробки не нужно отдельно проставлять, только блоки и пачки					
	
	//*******************************************************************************************************************************
	
	// Дополнительная табличная часть КоробкиПалеты
	КоробкиПалеты = Неопределено;
	Если ДокументТСД.Свойство("КоробкиПалеты") Тогда
		КоробкиПалеты = ДокументТСД.КоробкиПалеты;
	КонецЕсли;
	
	// 2. Перестроим иерархию по данным факта
	
	ФактПаллетаКоробка = Новый Соответствие;
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МаркировкаСтроки = "";
		Если СтрокаФакт.Свойство("Маркировка", МаркировкаСтроки) Тогда
			// Необходимо учитывать вариант, когда при записи сканированных коробок маркировка строки не заполняется в факте
			Если МаркировкаСтроки = "ИСМП" ИЛИ НЕ ЗначениеЗаполнено(МаркировкаСтроки) Тогда
				Попытка
					МаркировкаСтроки = Кэш_МаркировкаНоменклатуры.Получить(СтрокаФакт.ИдТовара);
					Если МаркировкаСтроки = Неопределено Тогда
						МаркировкаСтроки = ИО_МаркировкаПоНоменклатуре(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара)));	
						
						Кэш_МаркировкаНоменклатуры.Вставить(СтрокаФакт.ИдТовара, МаркировкаСтроки);
					КонецЕсли;
				Исключение	
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИО_МаркировкаПоНоменклатуре", "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					Если СтрокаФакт.Свойство("Марка") И ЗначениеЗаполнено(СтрокаФакт.Марка) Тогда
						Сообщить("Не удалось загрузить данные по марке: " + СтрокаФакт.Марка);						
					КонецЕсли;
					Продолжить;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ФлагиТипаДокумента.МаркировкаИСМП Тогда
			Если НЕ СтрокаФакт.Свойство("Маркировка") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МаркировкаСтроки <> ОжидаемыйПризнакМаркировки Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		// Нескольким видам продукции ИС может соответствовать одно значение маркировки в MS
		Если ЭтоНеоднозначныйПризнакМаркировки Тогда
			Попытка
				ОсобенностьУчета = Кэш_ОсобенностиНоменклатуры.Получить(СтрокаФакт.ИдТовара);
				Если ОсобенностьУчета = Неопределено Тогда
					ОсобенностьУчета = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара)).ОсобенностьУчета;
					
					Кэш_ОсобенностиНоменклатуры.Вставить(СтрокаФакт.ИдТовара, ОсобенностьУчета);
				КонецЕсли;
					
				Если СоответствующаяОсобенностьУчета = Неопределено Тогда
					СоответствующаяОсобенностьУчета = ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры." + РеквизитыВидовПродукцииИС.Получить(ВидПродукцииИС).Имя);
				КонецЕсли;
				
				Если ОсобенностьУчета <> СоответствующаяОсобенностьУчета Тогда
					Продолжить;
				КонецЕсли;
			Исключение	
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
			КонецПопытки;
		КонецЕсли;
		
		ЕстьРаботаСИСМП = Истина;
		
		ШтрихкодПалеты = "";
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда // Если нет свойства ИдКоробки, то в свойстве SSCC находится ШтрихкодКоробки
			
			Если СтрокаФакт.Свойство("SSCC") Тогда
				ШтрихкодПалеты = СтрокаФакт.SSCC;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ШтрихкодПалеты) И КоробкиПалеты <> Неопределено Тогда
				ШтрихкодПалеты = ИСМП_ПолучитьШтрихкодПалетыВТаблицеКоробкиПалеты(КоробкиПалеты, СтрокаФакт.ИдКоробки);
			КонецЕсли;
			
			ФактПаллетаКоробка.Вставить(СтрокаФакт.ИдКоробки, ШтрихкодПалеты);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Отдельно собираем данные из дополнительной табличной части КоробкиПалеты
	СоответствиеКоробкиПалеты = ИСМП_ПолучитьШтрихкодыКоробокПалетВТаблицеКоробкиПалеты(КоробкиПалеты);
	Для каждого КоробкаПалета Из СоответствиеКоробкиПалеты Цикл
		ФактПаллетаКоробка.Вставить(КоробкаПалета.Ключ, КоробкаПалета.Значение);
		ЕстьРаботаСИСМП = Истина;
	КонецЦикла;
	
	//Возврат если нет данных
	Если ЕстьРаботаСИСМП = Ложь
		И ТаблицаМаркированнойПродукцииИСМП.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Док1СРезультат.Метаданные().Реквизиты.Найти("ВидПродукции") <> Неопределено Тогда
		Док1СРезультат.ВидПродукции = ВидПродукцииИС;	
	КонецЕсли;
	
	// Определяем, будет выполняться завершение проверки или сохранение промежуточных результатов проверки
	ЗавершатьПроверку = Ложь;
	
	ДокументПроведенПриПроверкеИСМП = Неопределено;
	Если СтруктураПараметров.Свойство("ДокументПроведенПриПроверкеИСМП", ДокументПроведенПриПроверкеИСМП) Тогда
		ЗавершатьПроверку = ДокументПроведенПриПроверкеИСМП;	
	Иначе	
		ПроводитьДокументПослеЗагрузки = Док1СРезультат.Проведен ИЛИ НастройкаБП.Свойство("ПроводитьДокументПослеЗагрузки") И НастройкаБП.ПроводитьДокументПослеЗагрузки = Истина;
		Если ПроводитьДокументПослеЗагрузки Тогда
			ИдентификаторыГП = УТ_11_4_ПолучитьИдентификаторыГлобальныхПараметров();
			Если ЭтоПриемка И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборПриемка"), СтруктураПараметров) = Истина
				ИЛИ ЭтоОтгрузка И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборОтгрузка"), СтруктураПараметров) = Истина
				ИЛИ ЭтоВозвратСписание И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборВозвратСписание"), СтруктураПараметров) = Истина
				ИЛИ ЭтоМаркировка И ИО_ЗначениеГлобальногоПараметраПоID(ИдентификаторыГП.Получить("ЗавершатьПроверкуИПодборМаркировка"), СтруктураПараметров) = Истина Тогда
				ЗавершатьПроверку = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// Завершаем проверку только при условии успешного проведения документа
		Если ЗавершатьПроверку Тогда
			//НачатьТранзакцию();
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);
				
				СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
				СтруктураПараметров.Вставить("ДокументПроведенПриПроверкеИСМП", Истина);
				
				//ЗафиксироватьТранзакцию();
			Исключение
				//ОтменитьТранзакцию();
				ЗавершатьПроверку = Ложь;
				
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка при проведении " + Док1СРезультат + ": " + Строка(ОписаниеОшибки()));
				
				СтруктураПараметров.Вставить("ДокументПроведенПриПроверкеИСМП", Ложь);
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗавершатьПроверку Тогда
		СтатусДляНовыхСтрок = СтатусПроверкиВНаличии;
	КонецЕсли;	
	
	Для Каждого СтрокаСоответствия ИЗ ФактПаллетаКоробка Цикл
		Если ЗначениеЗаполнено(СтрокаСоответствия.Значение) Тогда
			РезультатПоиска = ТаблицаМаркированнойПродукцииИСМП.НайтиСтроки(Новый Структура("ШтрихкодКоробки",СтрокаСоответствия.Ключ));	
			Для Каждого СтрокаМП ИЗ РезультатПоиска Цикл
				СтрокаМП.ШтрихкодПалеты = СтрокаСоответствия.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	//*******************************************************************************************************************************
	
	Если ИспользованиеПолныхКодовМаркировки Тогда
		ТаблицаДляСохраненияВПул = Новый ТаблицаЗначений;		
		ТаблицаДляСохраненияВПул.Колонки.Добавить("КодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ПолныйКодМаркировки");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("GTIN");
		ТаблицаДляСохраненияВПул.Колонки.Добавить("ТипШтрихкода");
	КонецЕсли;
	
	Попытка
		ПоддерживаетсяВесоваяПродукция = ИО_ОбщийМодуль("ИнтеграцияИС").ЕдиницаУчетаМожетНеСовпадатьСИндивидуальнойПотребительскойУпаковкойПоВидуПродукции(ВидПродукцииИС);
	Исключение
		ПоддерживаетсяВесоваяПродукция = Ложь;
	КонецПопытки;	
	
	ПоддерживаетсяОбъемноСортовойУчет = ИнтеграцияИСМПКлиентСерверПовтИсп_ВидПродукцииПоддерживаетОбъемноСортовойУчет(ВидПродукцииИС);
	
	Попытка
		ПоддерживаютсяНаборыИлиГрупповыеУпаковки = ИнтеграцияИСКлиентСерверПовтИсп_ВидПродукцииИспользуетНаборыИлиГрупповыеУпаковки(ВидПродукцииИС);
	Исключение
		ПоддерживаютсяНаборыИлиГрупповыеУпаковки = Ложь;
	КонецПопытки;
	
	ПустаяХарактеристика = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры");
	ПустаяСерия			 = ИнтеграцияИС_ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры");
	
	НастройкиРазбораКМ = ИО_НастройкиРазбораКодаМаркировки(ВидПродукцииИС);
	
	// 3. нужно проверять палету и коробку из загружаемой строки факт (пачки или блока), что она в плане лежит там же 
	// т.е. (ид коробки и ид палеты одинаковые для СтрокиПлан и СтрокиФакт)
	// если она лежит не там, то нужно будет создать новые строки в той коробке и палете, в которой они лежат по факту
	// коробка и палета могут и не существовать, тогда их придется создать в коде
	// а текущей пачке/блоку установить статус - не числилась
	
	Для каждого СтрокаФакт Из СтрокиФакт Цикл
		Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФакт.КоличествоФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МаркировкаСтроки = "";
		Если СтрокаФакт.Свойство("Маркировка", МаркировкаСтроки) Тогда
			// Необходимо учитывать вариант, когда при записи сканированных коробок маркировка строки не заполняется в факте
			Если МаркировкаСтроки = "ИСМП" ИЛИ НЕ ЗначениеЗаполнено(МаркировкаСтроки) Тогда
				Попытка
					МаркировкаСтроки = Кэш_МаркировкаНоменклатуры.Получить(СтрокаФакт.ИдТовара);
					Если МаркировкаСтроки = Неопределено Тогда
						МаркировкаСтроки = ИО_МаркировкаПоНоменклатуре(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара)));	
						
						Кэш_МаркировкаНоменклатуры.Вставить(СтрокаФакт.ИдТовара, МаркировкаСтроки);
					КонецЕсли;
				Исключение	
					Продолжить;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ФлагиТипаДокумента.МаркировкаИСМП Тогда
			Если НЕ СтрокаФакт.Свойство("Маркировка") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МаркировкаСтроки <> ОжидаемыйПризнакМаркировки Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СканированнаяМарка = "";
		Если СтрокаФакт.Свойство("Марка") И ЗначениеЗаполнено(СтрокаФакт.Марка) Тогда
			СканированнаяМарка = СтрокаФакт.Марка;
		ИначеЕсли СтрокаФакт.Свойство("GS1Марка") И ЗначениеЗаполнено(СтрокаФакт.GS1Марка) Тогда
			СканированнаяМарка = СтрокаФакт.GS1Марка;
		ИначеЕсли СтрокаФакт.Свойство("МаркаСтандарт") И ЗначениеЗаполнено(СтрокаФакт.МаркаСтандарт) Тогда
			СканированнаяМарка = СтрокаФакт.МаркаСтандарт;
		КонецЕсли;
		
		ОбъемноСортовойУчет = Ложь;
		Если ПустаяСтрока(СканированнаяМарка) Тогда
			Если ПоддерживаютсяНаборыИлиГрупповыеУпаковки Тогда
				ШКГруппы  = "";
				ШККоробки = "";
				ШКПалеты  = "";
				Если СтрокаФакт.Свойство("ШтрихкодРодителя", ШКГруппы)
					И ЗначениеЗаполнено(ШКГруппы) Тогда
					СтрокаФакт.Свойство("ИдКоробки", ШККоробки);
					СтрокаФакт.Свойство("SSCC", ШКПалеты);
					
					Если НЕ ШКГруппы = ШККоробки
						И НЕ ШКГруппы = ШКПалеты Тогда
						СтрокаФакт.Вставить("Марка", ШКГруппы);
						СтрокаФакт.Вставить("GTIN", ?(Лев(ШКГруппы, 1) = "(",
							Сред(ШКГруппы, 5, 14),
							Лев(ШКГруппы, 14)));
						СтрокаФакт.Вставить("ШтрихкодРодителя", "");
						
						СканированнаяМарка = ШКГруппы;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;		
			
			Если ПустаяСтрока(СканированнаяМарка) Тогда
				Если НЕ ПоддерживаетсяОбъемноСортовойУчет Тогда
					Продолжить;
				КонецЕсли;
				ОбъемноСортовойУчет = Истина;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаФакт.Вставить("Номенклатура", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара)));
		
		// Нескольким видам продукции ИС может соответствовать одно значение маркировки в MS
		Если ЭтоНеоднозначныйПризнакМаркировки Тогда
			Попытка
				ОсобенностьУчета = Кэш_ОсобенностиНоменклатуры.Получить(СтрокаФакт.ИдТовара);
				Если ОсобенностьУчета = Неопределено Тогда
					ОсобенностьУчета = СтрокаФакт.Номенклатура.ОсобенностьУчета;
					
					Кэш_ОсобенностиНоменклатуры.Вставить(СтрокаФакт.ИдТовара, ОсобенностьУчета);
				КонецЕсли;
				
				Если СоответствующаяОсобенностьУчета = Неопределено Тогда
					СоответствующаяОсобенностьУчета = ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры." + РеквизитыВидовПродукцииИС.Получить(ВидПродукцииИС).Имя);
				КонецЕсли;
				
				Если ОсобенностьУчета <> СоответствующаяОсобенностьУчета Тогда
					Продолжить;				
				КонецЕсли;				
			Исключение	
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
			КонецПопытки;
		КонецЕсли;
		
		Если ИспользованиеХарактеристик
			И СтрокаФакт.Свойство("ИдХарактеристики")
			И ЗначениеЗаполнено(СтрокаФакт.ИдХарактеристики) Тогда
			СтрокаФакт.Вставить("Характеристика", Справочники["ХарактеристикиНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдХарактеристики)));
        Иначе
			СтрокаФакт.Вставить("Характеристика", ПустаяХарактеристика);
        КонецЕсли;
		
		СерияПолучена = Ложь;
		Если ИспользованиеСерий Тогда
			Если СтрокаФакт.Свойство("ИдНайденнойСерии") И ЗначениеЗаполнено(СтрокаФакт.ИдНайденнойСерии) Тогда
                СерияНоменклатуры = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдНайденнойСерии));
				СерияПолучена = ЗначениеЗаполнено(СерияНоменклатуры) И СерияНоменклатуры.ПолучитьОбъект() <> Неопределено;
			КонецЕсли;
			Если НЕ СерияПолучена И СтрокаФакт.Свойство("ИдСерии") И ЗначениеЗаполнено(СтрокаФакт.ИдСерии) Тогда
                СерияНоменклатуры = Справочники["СерииНоменклатуры"].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдСерии));
				СерияПолучена = ЗначениеЗаполнено(СерияНоменклатуры) И СерияНоменклатуры.ПолучитьОбъект() <> Неопределено;
			КонецЕсли;
		КонецЕсли;
		СтрокаФакт.Вставить("СерияНоменклатуры", ?(СерияПолучена, СерияНоменклатуры, ПустаяСерия));
		
		// Заполнение реквизитов ВЕТИС
		Если НЕ СтрокаФакт.Свойство("ИдентификаторПроисхожденияВЕТИС") Тогда
			СтрокаФакт.Вставить("ИдентификаторПроисхожденияВЕТИС", Неопределено);
		КонецЕсли;
		Если НЕ СтрокаФакт.Свойство("ГоденДо") Тогда
			СтрокаФакт.Вставить("ГоденДо", Дата(1,1,1));
		КонецЕсли;
		СтрокаФакт.Вставить(ИмяКолонкиСкоропортящаясяПродукция, ?(СтрокаФакт.Свойство("Скоропортящаяся"), СтрокаФакт.Скоропортящаяся, Ложь));
		
		СтрокаФакт.Вставить("КоличествоУпаковок", СтрокаФакт.КоличествоФакт);
		
		ПолеGTIN = ?(СтрокаФакт.Свойство("GTIN"),  СтрокаФакт.GTIN,  "");
		ПолеШК 	 = ?(СтрокаФакт.Свойство("ОснШК"), СтрокаФакт.ОснШК, "");
		
		ОбрабатываемыйGTIN = "";
		Если ЗначениеЗаполнено(ПолеGTIN) Тогда
			ОбрабатываемыйGTIN = ПолеGTIN;
		ИначеЕсли (ОбъемноСортовойУчет ИЛИ ЭтоМеха) И ЗначениеЗаполнено(ПолеШК)	И ГлЯдро_ТолькоЦифрыВСтроке(ПолеШК) Тогда
			ОбрабатываемыйGTIN = ?(СтрДлина(ПолеШК) = 13, "0" + ПолеШК, ПолеШК);
		Иначе
			// Из поля СтрокаФакт.ШК брать нельзя, т.к. там необязательно GTIN из отсканированной марки
			Если Лев(СканированнаяМарка, 4) = "(01)" Тогда
				ОбрабатываемыйGTIN = Сред(СканированнаяМарка, 5, 14);
			Иначе
				ОбрабатываемыйGTIN = "";
			КонецЕсли;
		КонецЕсли;
		
		ШтрихкодПалеты  = "";
		ШтрихкодКоробки = "";
		ШтрихкодГруппы 	= "";
		
		Если СтрокаФакт.Свойство("ИдКоробки") Тогда // Если нет свойства ИдКоробки, то в свойстве SSCC находится ШтрихкодКоробки
			Если СтрокаФакт.Свойство("SSCC")
				И НЕ ПустаяСтрока(СтрокаФакт.SSCC) Тогда
				ШтрихкодПалеты = СтрокаФакт.SSCC;
			КонецЕсли;
			
			ШтрихкодКоробки = СтрокаФакт.ИдКоробки;
			
			Если ПустаяСтрока(ШтрихкодПалеты)
				И НЕ КоробкиПалеты = Неопределено Тогда
				ШтрихкодПалеты = ИСМП_ПолучитьШтрихкодПалетыВТаблицеКоробкиПалеты(КоробкиПалеты, ШтрихкодКоробки);
			КонецЕсли;
		ИначеЕсли СтрокаФакт.Свойство("SSCC")
			И НЕ ПустаяСтрока(СтрокаФакт.SSCC) Тогда
			ШтрихкодКоробки = СтрокаФакт.SSCC;
		КонецЕсли;
		
		НормализованныйКодМаркировки = "";
		Если НЕ ОбъемноСортовойУчет Тогда
			ДанныеРазбора = ИО_РазобратьКодМаркировки(СканированнаяМарка, ВидПродукцииИС,, НастройкиРазбораКМ);
			Если ТипЗнч(ДанныеРазбора) = Тип("Структура")
				И ДанныеРазбора.Свойство("НормализованныйКодМаркировки", НормализованныйКодМаркировки)
				И ЗначениеЗаполнено(НормализованныйКодМаркировки) Тогда
				СканированнаяМарка = НормализованныйКодМаркировки;
			ИначеЕсли ЭтоМолоко Тогда
				Если ГлЯдро_СтрНайти(СканированнаяМарка, "(17)") > 0 Тогда
					СканированнаяМарка = Лев(СканированнаяМарка, 4+14+4+13+4+6); // дата
				ИначеЕсли ГлЯдро_СтрНайти(СканированнаяМарка, "(7003)") > 0 Тогда
					СканированнаяМарка = Лев(СканированнаяМарка, 4+14+4+13+6+10); // дата и время
				КонецЕсли;
			ИначеЕсли ЭтоФото Тогда
				СканированнаяМарка = Лев(СканированнаяМарка,4+14+4+20); // Полную марку ИСМП не принимает, нужна только GTIN+Серийный номер
			Иначе
				Если Сред(СканированнаяМарка,36,5) = "(240)" Тогда
					СканированнаяМарка = Лев(СканированнаяМарка,4+14+4+13+5+4); // 10.04.20 Для Старых марок с ТНВЭД	
				Иначе			
					СканированнаяМарка = Лев(СканированнаяМарка,4+14+4+13); // Полную марку ИСМП не принимает, нужна только GTIN+Серийный номер
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ОбъемноСортовойУчет", ОбъемноСортовойУчет);
		Если ОбъемноСортовойУчет Тогда
			СтруктураПоиска.Вставить("ИдЕдиницыИзмерения",  СтрокаФакт.ИдЕдиницыИзмерения);
			СтруктураПоиска.Вставить("Номенклатура",  		СтрокаФакт.Номенклатура);
			СтруктураПоиска.Вставить("Характеристика", 		СтрокаФакт.Характеристика);
			СтруктураПоиска.Вставить("Серия", 		  		СтрокаФакт.СерияНоменклатуры);			
			СтруктураПоиска.Вставить("GTIN", 		  		ОбрабатываемыйGTIN);
		Иначе
			СтруктураПоиска.Вставить("ШтрихкодПачки",		СканированнаяМарка);
        КонецЕсли;
		РезПоиска = ТаблицаМаркированнойПродукцииИСМП.НайтиСтроки(СтруктураПоиска);
		Если НЕ РезПоиска.Количество() Тогда
            НоваяСтрока = ТаблицаМаркированнойПродукцииИСМП.Добавить();
			НоваяСтрока.СтатусПроверки = СтатусДляНовыхСтрок;
		Иначе
			НоваяСтрока = РезПоиска[0];
			Если НоваяСтрока.СтатусПроверки <> СтатусДляНовыхСтрок Тогда
				НоваяСтрока.СтатусПроверки = СтатусПроверкиВНаличии;
			КонецЕсли;
		КонецЕсли;
		
		// Подберем GTIN для меховой продукции
		Если ЭтоМеха И ПустаяСтрока(ОбрабатываемыйGTIN) Тогда
			Если ЗначениеЗаполнено(НоваяСтрока.GTIN) Тогда
				ОбрабатываемыйGTIN = НоваяСтрока.GTIN;
			Иначе
				ДанныеТовара = Новый Структура("Номенклатура, Характеристика", СтрокаФакт.Номенклатура, СтрокаФакт.Характеристика);
				ДопустимыеВидыУпаковок = Новый Массив;
				ДопустимыеВидыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская"));
				
				ДопустимыеGTIN = ИСМП_ПолучитьДопустимыеЗначенияGTIN(ДанныеТовара, ДопустимыеВидыУпаковок);
			    Если ДопустимыеGTIN.Количество() Тогда
					ОбрабатываемыйGTIN = ДопустимыеGTIN[0];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Групповые упаковки и наборы
		Если ПоддерживаютсяНаборыИлиГрупповыеУпаковки Тогда
			Если СтрокаФакт.Свойство("ИдРодителя")
				И НЕ ПустаяСтрока(СтрокаФакт.ИдРодителя) Тогда
				Попытка
					ГруппаСсылка = Справочники["ШтрихкодыУпаковокТоваров"].ПолучитьСсылку(
						Новый УникальныйИдентификатор(СтрокаФакт.ИдРодителя));
					ШтрихкодГруппы = ГруппаСсылка.ЗначениеШтрихкода;
				Исключение
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка",
						ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
				
				// В ИдРодителя может быть записан GUID коробки или палеты
				Если НЕ ПустаяСтрока(ШтрихкодГруппы) Тогда
					Если ШтрихкодГруппы = ШтрихкодКоробки Тогда	
						ШтрихкодГруппы = "";
					КонецЕсли;
					Если ШтрихкодГруппы = ШтрихкодПалеты Тогда
						ШтрихкодГруппы = "";
					КонецЕсли;
					
					// В 1С может храниться упаковка в формате без скобок, в документе MS - со скобками
					Если НЕ ПустаяСтрока(ШтрихкодГруппы) И НЕ ПустаяСтрока(ШтрихкодКоробки) Тогда
						ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодКоробки, "(", ""), ")", "");
						
						Если ШтрихкодГруппы = ШтрихкодБезСкобок Тогда	
							ШтрихкодКоробки = ШтрихкодБезСкобок;
							ШтрихкодГруппы = "";
						КонецЕсли;
					КонецЕсли;
					
					Если НЕ ПустаяСтрока(ШтрихкодГруппы) И НЕ ПустаяСтрока(ШтрихкодПалеты) Тогда
						ШтрихкодБезСкобок = СтрЗаменить(СтрЗаменить(ШтрихкодПалеты, "(", ""), ")", "");
						
						Если ШтрихкодГруппы = ШтрихкодБезСкобок Тогда	
							ШтрихкодПалеты = ШтрихкодБезСкобок;
							ШтрихкодГруппы = "";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		
			Если ПустаяСтрока(ШтрихкодГруппы)
				И СтрокаФакт.Свойство("ШтрихкодРодителя") Тогда
				ШтрихкодГруппы = СтрокаФакт.ШтрихкодРодителя;
					
				Если НЕ ПустаяСтрока(ШтрихкодГруппы) Тогда
					Если ШтрихкодГруппы = ШтрихкодКоробки Тогда
						ШтрихкодГруппы = "";
					КонецЕсли;
					Если ШтрихкодГруппы = ШтрихкодПалеты Тогда
						ШтрихкодГруппы = "";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ПустаяСтрока(ШтрихкодГруппы)
				И НЕ ШтрихкодГруппы = СканированнаяМарка Тогда
				НоваяСтрока.ШтрихкодГруппы = ШтрихкодГруппы;
				НоваяСтрока.GTINГруппы = ?(Лев(ШтрихкодГруппы, 1) = "(",
					Сред(ШтрихкодГруппы, 5, 14),
					Лев(ШтрихкодГруппы, 14));	
			КонецЕсли;
		КонецЕсли;
		
		// Найдем подходящую ветку для добавления элемента
		СтруктураПоиска = Новый Структура();
		Если НЕ ПустаяСтрока(ШтрихкодПалеты) Тогда
			НоваяСтрока.ШтрихкодПалеты = ШтрихкодПалеты;
			СтруктураПоиска.Вставить("ШтрихкодПалеты", ШтрихкодПалеты);
		КонецЕсли;
		Если НЕ ПустаяСтрока(ШтрихкодКоробки) Тогда
			НоваяСтрока.ШтрихкодКоробки = ШтрихкодКоробки;
			СтруктураПоиска.Вставить("ШтрихкодКоробки", ШтрихкодКоробки);
			РезПоиска = ТаблицаМаркированнойПродукцииИСМП.НайтиСтроки(СтруктураПоиска);
			Если РезПоиска.Количество() > 0 Тогда
				НоваяСтрока.ШтрихкодПалеты = РезПоиска[0].ШтрихкодПалеты;
			КонецЕсли;
		КонецЕсли;
		
		Если ОбъемноСортовойУчет Тогда
			КоличествоТовараОСУ	= ?(СтрокаФакт.Свойство("КоличествоТовараОСУ") И ЗначениеЗаполнено(СтрокаФакт.КоличествоТовараОСУ), СтрокаФакт.КоличествоТовараОСУ, 1);
			
			КоличествоУпаковок 				  = НоваяСтрока.КоличествоУпаковок + СтрокаФакт.КоличествоУпаковок;
			КоличествоПотребительскихУпаковок = НоваяСтрока.КоличествоПотребительскихУпаковок + КоличествоТовараОСУ;
			СканированнаяМарка 				  = ""; // Регулярные выражение сформируем после заполнения реквизитов весовой продукции, чтобы
													// понимать, какое количество передават в тег [37]
		Иначе
			КоличествоУпаковок 				  = СтрокаФакт.КоличествоУпаковок;
			КоличествоПотребительскихУпаковок = 1;
		КонецЕсли;		
		
		НоваяСтрока.Номенклатура 					  = СтрокаФакт.Номенклатура;
		НоваяСтрока.Характеристика 					  = СтрокаФакт.Характеристика;  
		
		//Миронов А.А
		Если НЕ ТипЗнч(СтруктураПараметров.Док1СРезультат) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") И НЕ ТипЗнч(СтруктураПараметров.Док1СРезультат) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда	
		НоваяСтрока.Серия							  = СтрокаФакт.СерияНоменклатуры; 
	    КонецЕсли;   
	    //Миронов А.А

		НоваяСтрока.КоличествоУпаковок 				  = КоличествоУпаковок;
		НоваяСтрока.ШтрихкодПачки 					  = СканированнаяМарка;
		НоваяСтрока.ПолныйКодМаркировки				  = ?(СтрокаФакт.Свойство("ПолнаяМаркаBase64"), СтрокаФакт.ПолнаяМаркаBase64, "");
		НоваяСтрока.GTIN 							  = ОбрабатываемыйGTIN;
		НоваяСтрока.ОбъемноСортовойУчет 			  = ОбъемноСортовойУчет;
		НоваяСтрока.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
		НоваяСтрока.ИдЕдиницыИзмерения				  = СтрокаФакт.ИдЕдиницыИзмерения;
		
		// Заполнение реквизитов ВЕТИС
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФакт, "ИдентификаторПроисхожденияВЕТИС, ГоденДо, " + ИмяКолонкиСкоропортящаясяПродукция);
		
		Если ИспользованиеПолныхКодовМаркировки 
			И ЗначениеЗаполнено(НоваяСтрока.ПолныйКодМаркировки) Тогда
			НоваяСтрокаДляПула = ТаблицаДляСохраненияВПул.Добавить();
			НоваяСтрокаДляПула.ПолныйКодМаркировки = НоваяСтрока.ПолныйКодМаркировки;
			
			Если ТипЗнч(ДанныеРазбора) = Тип("Структура") Тогда
				Если ДанныеРазбора.Свойство("СоставКодаМаркировки")
					И ТипЗнч(ДанныеРазбора.СоставКодаМаркировки) = Тип("Структура")
					И ДанныеРазбора.СоставКодаМаркировки.Свойство("GTIN") Тогда
					GTIN = ДанныеРазбора.СоставКодаМаркировки.GTIN;
					НоваяСтрока.GTIN = GTIN;
				Иначе
					GTIN = НоваяСтрока.GTIN;	
				КонецЕсли;
				
				НоваяСтрокаДляПула.КодМаркировки = СканированнаяМарка;
				НоваяСтрокаДляПула.ТипШтрихкода  = ?(ДанныеРазбора.Свойство("ТипШтрихкода"), ДанныеРазбора.ТипШтрихкода, Неопределено);
				НоваяСтрокаДляПула.GTIN 		 = GTIN;
			Иначе
				НоваяСтрокаДляПула.КодМаркировки = СканированнаяМарка;
				НоваяСтрокаДляПула.GTIN 		 = НоваяСтрока.GTIN;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Отдельно собираем данные из дополнительной табличной части КоробкиПалеты
	Для каждого КоробкаПалета Из СоответствиеКоробкиПалеты Цикл
		ШтрихкодКоробки = КоробкаПалета.Ключ;
		ШтрихкодПалеты 	= КоробкаПалета.Значение;
		
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("ШтрихкодПалеты", 		ШтрихкодПалеты);
		СтруктураПоиска.Вставить("ШтрихкодКоробки",		ШтрихкодКоробки);
		СтруктураПоиска.Вставить("ОбъемноСортовойУчет",	Ложь);
			
		ИСМП_ДобавитьСтрокиВТаблицуМаркированнойПродукции(ТаблицаМаркированнойПродукцииИСМП, СтруктураПоиска,, СтатусДляНовыхСтрок);
	КонецЦикла;
	
	//*******************************************************************************************************************************
	
	// 4. все, что не в наличии - отсутствует
	Если ЗавершатьПроверку Тогда
		Для каждого Строка Из ТаблицаМаркированнойПродукцииИСМП Цикл
			Если Строка.СтатусПроверки <> СтатусПроверкиВНаличии И Строка.СтатусПроверки <> СтатусПроверкиНеЧислилась Тогда		
				Строка.СтатусПроверки = СтатусПроверкиОтсутствует;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИспользованиеПолныхКодовМаркировки Тогда	
		ИСМП_СохранитьКодыМаркировкиВПул(ТаблицаДляСохраненияВПул, СтруктураПараметров);
	КонецЕсли;	
	
	Если ЭтоМаркировка Тогда
		ЗаполнятьТЧКодыМаркировки = ИСМП_ЗаполнятьТЧКодыМаркировки(СтруктураПараметров, ВидПродукцииИС);
		Если ЗаполнятьТЧКодыМаркировки Тогда
			ИСМП_ЗаполнитьТЧКодыМаркировки(СтруктураПараметров, ТаблицаМаркированнойПродукцииИСМП);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Весовая продукция
	Если ПоддерживаетсяВесоваяПродукция Тогда
		ИСМП_ЗаполнитьСлужебныеРеквизитыВесовойПродукции(ТаблицаМаркированнойПродукцииИСМП, ВидПродукцииИС);
	КонецЕсли;
	
	// Групповые упаковки и наборы
	ДанныеНаборов = Неопределено;
	Если ПоддерживаютсяНаборыИлиГрупповыеУпаковки Тогда
		Если ЭтоМаркировка Тогда
			ДанныеНаборов = Новый Соответствие;
		КонецЕсли;
		
		ИСМП_ЗаполнитьДанныеГрупповыхУпаковокВТаблицеМаркированнойПродукции(ТаблицаМаркированнойПродукцииИСМП, ДанныеНаборов);
	КонецЕсли;
	
	// Объемно-сортовой учет
	Если ПоддерживаетсяОбъемноСортовойУчет Тогда
		ТаблицаGTIN = ТаблицаМаркированнойПродукцииИСМП.Скопировать(Новый Структура("ОбъемноСортовойУчет", Истина), "GTIN");
		ТаблицаGTIN.Свернуть("GTIN");
		
		ОписанияGTIN = ИСМП_ПолучитьОписанияGTIN(ТаблицаGTIN.ВыгрузитьКолонку("GTIN"));
		
		СтрокиОСУ = ТаблицаМаркированнойПродукцииИСМП.НайтиСтроки(Новый Структура("ОбъемноСортовойУчет", Истина));
		Для каждого СтрокаОСУ ИЗ СтрокиОСУ Цикл
			// Пересчет в потребительские упаковки
			ОписаниеGTIN = ОписанияGTIN.Получить(СтрокаОСУ.GTIN);
			Если ОписаниеGTIN <> Неопределено
				И ОписаниеGTIN.КоличествоПотребительскихУпаковок <> 0
				И ОписаниеGTIN.КоличествоПотребительскихУпаковок <> 1 Тогда
				ДопустимыеGTIN = ИСМП_ПолучитьДопустимыеЗначенияGTIN(СтрокаОСУ);
				Если ДопустимыеGTIN.Количество() Тогда
					Коэффициент = ОписаниеGTIN.КоличествоПотребительскихУпаковок;
						
					СтрокаОСУ.GTIN 								= ДопустимыеGTIN[0];
					СтрокаОСУ.КоличествоУпаковок				= ?(СтрокаОСУ.ПроизвольнаяЕдиницаУчета И НЕ СтрокаОСУ.ТребуетВзвешивания,
						СтрокаОСУ.КоличествоУпаковок, 				 // Для фасованной продукции вес уже рассчитан
						СтрокаОСУ.КоличествоУпаковок * Коэффициент);
					СтрокаОСУ.КоличествоПотребительскихУпаковок = ?(СтрокаОСУ.ТребуетВзвешивания,
						СтрокаОСУ.КоличествоПотребительскихУпаковок, // Для весовой продукции количество упаковок считаем по указанному на ТСД
																	 // количеству (если не указано, то по количеству мест)
						СтрокаОСУ.КоличествоПотребительскихУпаковок * Коэффициент);
				КонецЕсли;
			КонецЕсли;
			//
						
			КоличествоПотребительскихУпаковок = ?(СтрокаОСУ.ПроизвольнаяЕдиницаУчета,
				СтрокаОСУ.КоличествоПотребительскихУпаковок,
				СтрокаОСУ.КоличествоУпаковок);
			СтрокаОСУ.КоличествоПодобраноВзвешеноОСУ 	   = СтрокаОСУ.КоличествоУпаковок;
			СтрокаОСУ.КоличествоПотребительскихУпаковокОСУ = КоличествоПотребительскихУпаковок;
		КонецЦикла;
		
		Если СтрокиОСУ.Количество()
			И ФлагиТипаДокумента.ВыводИзОборотаИСМП Тогда
			ИСМП_ЗаполнитьВыводИзОборотаДаннымиОСУ(ТаблицаМаркированнойПродукцииИСМП, СтруктураПараметров);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
		
	//*******************************************************************************************************************************
		
	// 5. Если внутри коробки или палеты хотя бы 1 отсканирован блок или марка, то вся коробка или палета = В наличии
	
	// 6. Сделать подсчет количества подчиненных упаковок - всего, в наличии, отсутствует, не проверялось, отложена, не числилась
	
	// 7. Если добавлялись новые палеты или коробки, то добавить их в дерево МП в методе "ЗаполнитьДеревоМаркированнойПродукции"
	ДеревоМаркированнойПродукции = ПустоеДеревоМаркированнойПродукцииИСМП(СтруктураПараметров);	
	
	ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукции, СоответствиеПараметров, ВидПродукцииИС);
	
	ПересчитыватьХешиСУчетомВложенныхШК = ФлагиТипаДокумента.РеализацияТУ; // Или ЭтоАгрегация;
	
	СтруктураПараметровДеревоИСМП = Новый Структура;
	СтруктураПараметровДеревоИСМП.Вставить("СУчетомВложенныхШК", 	ПересчитыватьХешиСУчетомВложенныхШК);
	СтруктураПараметровДеревоИСМП.Вставить("Детализация", 			ДетализацияСтруктурыХранения);
	СтруктураПараметровДеревоИСМП.Вставить("ЗавершатьПроверку", 	ЗавершатьПроверку);
	СтруктураПараметровДеревоИСМП.Вставить("ВидПродукцииИС", 		ВидПродукцииИС);
	СтруктураПараметровДеревоИСМП.Вставить("ОбъемноСортовойУчет",	ПоддерживаетсяОбъемноСортовойУчет);
	СтруктураПараметровДеревоИСМП.Вставить("ДанныеНаборов",			ДанныеНаборов);
	ДобавитьСтрокиВДеревоИСМП(ДеревоМаркированнойПродукции, ТаблицаМаркированнойПродукцииИСМП, ТаблицаМаркированнойПродукцииИСМППлана, СтруктураПараметровДеревоИСМП);
	
	ИСМП_ЗаполнениеКолонкиНормализованныйШтрихкодПриВосстановленииДерева(ДеревоМаркированнойПродукции.Строки, ВидПродукцииИС);	
	
	ЗаполнятьРеквизитыВЕТИС = ЭтоМаркировка И ИСМП_ЭтоПродукцияВЕТИС(ВидПродукцииИС);
	ЗаполнятьСрокиГодности 	= ЭтоМаркировка И ИСМП_ЭтоВидПродукцииСоСрокамиГодности(ВидПродукцииИС); 
			
	ИменаКолонокДляСворачивания = Новый Массив;
	ИменаКолонокДляСворачивания.Добавить("Номенклатура");
	ИменаКолонокДляСворачивания.Добавить("Характеристика");
	ИменаКолонокДляСворачивания.Добавить("Серия");
	ИменаКолонокДляСворачивания.Добавить("GTIN");
	ИменаКолонокДляСворачивания.Добавить("СтатусПроверки");
	// Заполнение реквизитов ВЕТИС
	ИменаКолонокДляСворачивания.Добавить("ИдентификаторПроисхожденияВЕТИС");
	ИменаКолонокДляСворачивания.Добавить("ГоденДо");
	ИменаКолонокДляСворачивания.Добавить(ИмяКолонкиСкоропортящаясяПродукция);
	// Весовая продукция
	ИменаКолонокДляСворачивания.Добавить("ПроизвольнаяЕдиницаУчета");
	ИменаКолонокДляСворачивания.Добавить("ТребуетВзвешивания");
	
	ИменаКолонокДляСуммирования = Новый Массив;
	ИменаКолонокДляСуммирования.Добавить("КоличествоУпаковок");
	ИменаКолонокДляСуммирования.Добавить("КоличествоПотребительскихУпаковок");
	ИменаКолонокДляСуммирования.Добавить("КоличествоПодобраноВзвешеноОСУ");
	ИменаКолонокДляСуммирования.Добавить("КоличествоПотребительскихУпаковокОСУ");

	КолонкиДляСворачивания = "";
	Для каждого ИмяКолонки ИЗ ИменаКолонокДляСворачивания Цикл
		КолонкиДляСворачивания = КолонкиДляСворачивания + ?(ПустаяСтрока(КолонкиДляСворачивания), "", ", ") + ИмяКолонки;
	КонецЦикла;
	КолонкиДляСуммирования = "";
	Для каждого ИмяКолонки ИЗ ИменаКолонокДляСуммирования Цикл
		КолонкиДляСуммирования = КолонкиДляСуммирования + ?(ПустаяСтрока(КолонкиДляСуммирования), "", ", ") + ИмяКолонки;
	КонецЦикла;
	ТаблицаМаркированнойПродукцииИСМП.Свернуть(КолонкиДляСворачивания, КолонкиДляСуммирования);
	
	// Если таблица маркированной продукции создается не по факту, а дополняется существующая, в новых строках не нужно заполнять количество по документу
	ПервоеЗаполнениеТаблицыПодобраннойМаркированнойПродукции = ПодобраннаяМаркируемаяПродукция.Количество() = 0;
	
	// Количество по данным документа к этому моменту должно быть заполнено, редактируем его только для новых строк
	// ПодобраннаяМаркируемаяПродукция.ЗаполнитьЗначения(0, "Количество");
	ПодобраннаяМаркируемаяПродукция.ЗаполнитьЗначения(0, "КоличествоПодобрано");
	ПодобраннаяМаркируемаяПродукция.ЗаполнитьЗначения(0, "КоличествоПотребительскихУпаковок");
	ПодобраннаяМаркируемаяПродукция.ЗаполнитьЗначения(0, "КоличествоПодобраноВзвешеноОСУ");
	ПодобраннаяМаркируемаяПродукция.ЗаполнитьЗначения(0, "КоличествоПотребительскихУпаковокОСУ");
	
	Для каждого СтрокаТаблицы Из ТаблицаМаркированнойПродукцииИСМП Цикл
		СтруктураПоиска = Новый Структура("Номенклатура,Характеристика,GTIN,Серия");
		
		Если ЗаполнятьРеквизитыВЕТИС Тогда
			СтруктураПоиска.Вставить("ИдентификаторПроисхожденияВЕТИС");
			СтруктураПоиска.Вставить("ГоденДо");
			СтруктураПоиска.Вставить(ИмяКолонкиСкоропортящаясяПродукция);
		ИначеЕсли ЗаполнятьСрокиГодности Тогда
			СтруктураПоиска.Вставить("ГоденДо");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
		
		КоличествоУпаковок 				  	 = СтрокаТаблицы.КоличествоУпаковок;
		КоличествоПотребительскихУпаковок 	 = ?(СтрокаТаблицы.ПроизвольнаяЕдиницаУчета,
			СтрокаТаблицы.КоличествоПотребительскихУпаковок,
			СтрокаТаблицы.КоличествоУпаковок);
		КоличествоПодобраноВзвешеноОСУ	  	 = СтрокаТаблицы.КоличествоПодобраноВзвешеноОСУ;
		КоличествоПотребительскихУпаковокОСУ = СтрокаТаблицы.КоличествоПотребительскихУпаковокОСУ;
		
		ДобавленаНоваяСтрока = Ложь;
		
		НайденныеСтроки = ПодобраннаяМаркируемаяПродукция.НайтиСтроки(СтруктураПоиска);
		Если НЕ НайденныеСтроки.Количество()
			И НЕ ПервоеЗаполнениеТаблицыПодобраннойМаркированнойПродукции Тогда
			// Возможно, в существующей строке указано несколько возможных GTIN
			СтруктураПоиска.Вставить("GTIN", "");
			
			НайденныеСтроки = ПодобраннаяМаркируемаяПродукция.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() Тогда
				НайденныеСтроки[0].GTIN = СтрокаТаблицы.GTIN;
			КонецЕсли;
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() Тогда
			НоваяСтрока =  НайденныеСтроки[0];
			
			// Количество по данным документа к этому моменту должно быть заполнено, редактируем его только для новых строк
			// НоваяСтрока.Количество = НоваяСтрока.Количество + КоличествоУпаковок;
			
			Если СтрокаТаблицы.СтатусПроверки = СтатусПроверкиВНаличии
				ИЛИ СтрокаТаблицы.СтатусПроверки = СтатусПроверкиНеЧислилась Тогда
				НоваяСтрока.КоличествоПодобрано 			  	 = НоваяСтрока.КоличествоПодобрано + КоличествоУпаковок;
				НоваяСтрока.КоличествоПотребительскихУпаковок 	 = НоваяСтрока.КоличествоПотребительскихУпаковок + КоличествоПотребительскихУпаковок;
				НоваяСтрока.КоличествоПодобраноВзвешеноОСУ 		 = НоваяСтрока.КоличествоПодобраноВзвешеноОСУ + КоличествоПодобраноВзвешеноОСУ;
				НоваяСтрока.КоличествоПотребительскихУпаковокОСУ = НоваяСтрока.КоличествоПотребительскихУпаковокОСУ + КоличествоПотребительскихУпаковокОСУ;
			КонецЕсли;
		Иначе
			НоваяСтрока = ПодобраннаяМаркируемаяПродукция.Добавить();
			
			ДобавленаНоваяСтрока = Истина;
			
			НоваяСтрока.Номенклатура 					= СтрокаТаблицы.Номенклатура;
			НоваяСтрока.Характеристика 					= СтрокаТаблицы.Характеристика;
			НоваяСтрока.Серия 							= СтрокаТаблицы.Серия;
			НоваяСтрока.GTIN 							= СтрокаТаблицы.GTIN;
			
			Если ПервоеЗаполнениеТаблицыПодобраннойМаркированнойПродукции Тогда
				НоваяСтрока.Количество 						= КоличествоУпаковок;
				НоваяСтрока.КоличествоИС 					= КоличествоУпаковок;
				НоваяСтрока.КоличествоПотребительскихУпаковокВСтруктуреУпаковок = 
					НоваяСтрока.КоличествоПотребительскихУпаковокВСтруктуреУпаковок + КоличествоПотребительскихУпаковок;
			КонецЕсли;
			
			Если СтрокаТаблицы.СтатусПроверки = СтатусПроверкиВНаличии
				ИЛИ СтрокаТаблицы.СтатусПроверки = СтатусПроверкиНеЧислилась Тогда
				НоваяСтрока.КоличествоПодобрано 			  	 = КоличествоУпаковок;
				НоваяСтрока.КоличествоПотребительскихУпаковок 	 = КоличествоПотребительскихУпаковок;
				НоваяСтрока.КоличествоПодобраноВзвешеноОСУ 		 = КоличествоПодобраноВзвешеноОСУ;
				НоваяСтрока.КоличествоПотребительскихУпаковокОСУ = КоличествоПотребительскихУпаковокОСУ;
			КонецЕсли;
			
			НоваяСтрока.ПредставлениеНоменклатуры 		= Строка(СтрокаТаблицы.Номенклатура);
			НоваяСтрока.ТипНоменклатуры 				= СтрокаТаблицы.Номенклатура.ТипНоменклатуры;
			НоваяСтрока.НомерСтроки 					= ПодобраннаяМаркируемаяПродукция.Количество();
			
			Если ЗначениеЗаполнено(НоваяСтрока.Серия) Тогда
				НоваяСтрока.СтатусУказанияСерий = 2;	
			КонецЕсли;
			
			// Заполнение реквизитов ВЕТИС
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "ИдентификаторПроисхожденияВЕТИС, ГоденДо, " + ИмяКолонкиСкоропортящаясяПродукция);
			
			// Весовая продукция
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "ПроизвольнаяЕдиницаУчета, ТребуетВзвешивания");
		КонецЕсли;
		Если ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
			НоваяСтрока.ХарактеристикиИспользуются 	= Истина;
		КонецЕсли;
		Если НоваяСтрока.Количество = НоваяСтрока.КоличествоПодобрано
			ИЛИ ДобавленаНоваяСтрока Тогда			
			НоваяСтрока.ИндексКодаМаркировки = 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ДанныеПроверкиИПодбора) Тогда
		ДанныеПроверкиИПодбора = Новый Структура;
				
		ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции");
		ДанныеПроверкиИПодбора.Вставить("ПодобраннаяМаркируемаяПродукция");
		ДанныеПроверкиИПодбора.Вставить("ПараметрыПроверкиКодовМаркировки");
		ДанныеПроверкиИПодбора.Вставить("КоличествоНедопустимыхКодовМаркировки");
		ДанныеПроверкиИПодбора.Вставить("УпаковкиДокумента");
		ДанныеПроверкиИПодбора.Вставить("ДетализацияСтруктурыХранения", ДетализацияСтруктурыХранения);
		ДанныеПроверкиИПодбора.Вставить("РежимПроверки");
		ДанныеПроверкиИПодбора.Вставить("ДобавленныеУпаковки");
		ДанныеПроверкиИПодбора.Вставить("ДоступныеДляПроверкиУпаковки");
		ДанныеПроверкиИПодбора.Вставить("СледующийСтикерОтложено");
		ДанныеПроверкиИПодбора.Вставить("СодержимоеУпаковокНедоступно");
		ДанныеПроверкиИПодбора.Вставить("СохраненВыборПоМаркируемойПродукции");
		ДанныеПроверкиИПодбора.Вставить("ДанныеВыбораПоМаркируемойПродукции");
		ДанныеПроверкиИПодбора.Вставить("ШтрихкодТекущейПроверяемойУпаковки");
		ДанныеПроверкиИПодбора.Вставить("ДанныеРанееСгенерированныхШтрихкодов");
	КонецЕсли;
	
	ПараметрыПроверкиКодовМаркировки = Неопределено;
	Если НЕ ДанныеПроверкиИПодбора.Свойство("ПараметрыПроверкиКодовМаркировки", ПараметрыПроверкиКодовМаркировки) ИЛИ НЕ ЗначениеЗаполнено(ПараметрыПроверкиКодовМаркировки) Тогда
		ПараметрыПроверкиКодовМаркировки
			= ИО_ПараметрыПроверкиКодовМаркировки("ИСМП", Док1СРезультат, ФлагиТипаДокумента.РеализацияТУ, ВидПродукцииИС);
		
		ДанныеПроверкиИПодбора.Вставить("ПараметрыПроверкиКодовМаркировки", ПараметрыПроверкиКодовМаркировки);
	Иначе	
		ПараметрыПроверкиКодовМаркировки = ДанныеПроверкиИПодбора.ПараметрыПроверкиКодовМаркировки;
	КонецЕсли;
	
	Попытка
		ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииДереваМаркированнойПродукции(ДеревоМаркированнойПродукции, СоответствиеПараметров, ВидПродукцииИС);
		ИСМП_ДобавитьИЗаполнитьКолонкиПриВосстановленииПодобраннойМаркируемойПродукции(ПодобраннаяМаркируемаяПродукция, СоответствиеПараметров, ВидПродукцииИС);
	Исключение КонецПопытки;
	
	ДанныеПроверкиИПодбора.Вставить("ДеревоМаркированнойПродукции", ДеревоМаркированнойПродукции);	
	ДанныеПроверкиИПодбора.Вставить("ПодобраннаяМаркируемаяПродукция", ПодобраннаяМаркируемаяПродукция);
	
	ДанныеПроверкиИПодбора = Новый ХранилищеЗначения(ДанныеПроверкиИПодбора);
	
	Если НЕ ЗавершатьПроверку И Док1СРезультат.ЭтоНовый() Тогда
		Док1СРезультат.Записать();
		
		СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
	КонецЕсли;
	
	// Табличную часть Товары заполняем по данным дерева проверки и подбора, т.к. при многоуровневой агрегации данные на ТСД могут дублироваться
	Если НЕ ЗавершатьПроверку И ЭтоАгрегация Тогда
		ПараметрыОкончанияПроверки = ИСМП_ПараметрыОкончанияПроверки(
			СтруктураПараметров, ВидПродукцииИС, ПодобраннаяМаркируемаяПродукция, ФлагиТипаДокумента.ПриемкаИСМП);
		Документы.МаркировкаТоваровИСМП.ОтразитьРезультатыПроверкиИПодбора(ПараметрыОкончанияПроверки);
			
		Док1СРезультат.Прочитать();
	КонецЕсли;
	
	Если ЗавершатьПроверку Тогда
	
		ПараметрыОкончанияПроверки = ИСМП_ПараметрыОкончанияПроверки(СтруктураПараметров, ВидПродукцииИС, ПодобраннаяМаркируемаяПродукция, ФлагиТипаДокумента.ПриемкаИСМП);
		
		// см. Обработка.ПроверкаИПодборПродукцииИСМП.ЗафиксироватьРезультатПроверкиИПодбора	
		ДеревоМаркированнойПродукцииДляСозданияШтрихкодов = ДеревоМаркированнойПродукции.Скопировать();
			
		Если ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Найти("ШтрихкодУпаковки") = Неопределено Тогда
			ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
		КонецЕсли;
		Если ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Найти("Штрихкод") = Неопределено Тогда
			ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
		КонецЕсли;
			
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").УдалитьПустыеУпаковкиДерева(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов);
		
		// Инициализация параметров сканирования
		ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(ИО_ОбщийМодуль("ШтрихкодированиеИС").ПолучитьСтруктуруРеквизитовДокумента(Док1СРезультат));
		
		ИСМП_ИнициализироватьПараметрыСканирования(ПараметрыОкончанияПроверки.ПроверяемыйДокумент, ПараметрыСканирования, ПараметрыПроверкиКодовМаркировки, ВидПродукцииИС,
			ДетализацияСтруктурыХранения);
		
		// Количество для мультитоварных наборов и монотоварных наборов с отдельной номенклатурой требуется рассчитать заново
		Попытка
			СтрокиДереваНаборов = Новый Массив;
			Если ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Найти("КоличествоПоДаннымИБ") = Неопределено Тогда
				ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Добавить("КоличествоПоДаннымИБ", Новый ОписаниеТипов("Число"));
			КонецЕсли;
			Если ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Найти("КоличествоПотребительскихУпаковокПоДаннымИБ") = Неопределено Тогда
				ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Добавить("КоличествоПотребительскихУпаковокПоДаннымИБ", Новый ОписаниеТипов("Число"));
			КонецЕсли;
		
			ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ЗаполнитьРекурсивноКоличествоПоДаннымИБПоКолонкеКоличество(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Строки, СтрокиДереваНаборов);
			Если СтрокиДереваНаборов.Количество() Тогда
				ИО_ОбщийМодуль("ШтрихкодированиеИСМПСлужебный").НормализоватьСвойстваКоллекцииВложенныхШтрихкодов(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, ПараметрыСканирования);
				
				Если ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Найти("СтрокаДерева") = Неопределено Тогда
					ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Добавить("СтрокаДерева");
				КонецЕсли;
				Если ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Найти("ОбработанСОшибками") = Неопределено Тогда
					ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Колонки.Добавить("ОбработанСОшибками", Новый ОписаниеТипов("Булево"));
				КонецЕсли;
				
				ИО_ОбщийМодуль("ШтрихкодированиеИСМПСлужебный").ЗаполнитьСтрокиТаблицыДанныхПоГрупповымУпаковкам(СтрокиДереваНаборов, ПараметрыСканирования);
				Для Каждого СтрокаДерева Из СтрокиДереваНаборов Цикл
					СтрокаДерева.КоличествоПоДаннымИБ = СтрокаДерева.Количество;
				КонецЦикла;
				ИО_ОбщийМодуль("ШтрихкодированиеИСМПСлужебный").НормализоватьДанныеДереваУпаковок(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, ПараметрыСканирования);
			КонецЕсли;
		Исключение
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		//
		
		Попытка
			ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовВНаличииИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, Неопределено));
		Исключение
			ШтрихКодыУпаковок = ИО_ОбщийМодуль("ШтрихкодированиеИС").ШтрихкодыУпаковок(ИО_ОбщийМодуль("ШтрихкодированиеИС").ЗначенияШтрихкодовИзДереваМаркируемойПродукции(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, Неопределено));
		КонецПопытки;
		
		ТаблицаШтрихкодовВерхнегоУровня = ПараметрыОкончанияПроверки.ТаблицаШтрихкодовВерхнегоУровня;
		
		ШтрихкодыУпаковокСозданы = Истина;
		Попытка
			ПараметрыСозданияШтрихкодов = Справочники["ШтрихкодыУпаковокТоваров"].ПараметрыСозданияШтриходовУпаковокПоДеревуМаркируемойПродукции(
				ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, ПараметрыСканирования);
			ПараметрыСозданияШтрихкодов.ВидПродукции = ВидПродукцииИС;
			
			Справочники["ШтрихкодыУпаковокТоваров"].РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(
				ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, ТаблицаШтрихкодовВерхнегоУровня,
				ПараметрыСозданияШтрихкодов);
		Исключение	
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ШтрихкодыУпаковокСозданы = Ложь;		
		КонецПопытки;

		Если НЕ ШтрихкодыУпаковокСозданы Тогда
			Справочники["ШтрихкодыУпаковокТоваров"].РезультатСозданияШтрихкодовУпаковокПоДеревуМаркируемойПродукции(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов, ТаблицаШтрихкодовВерхнегоУровня, ШтрихКодыУпаковок);
		КонецЕсли;
		
		Если СтруктураПараметров.ЗаполнитьСпецификуСрокиГодности Тогда
			ТаблицаШтрихкодовВерхнегоУровня.Очистить();
			Попытка
				ИСМП_ЗаполнитьШтрихкодыВерхнегоУровняСоСпецификой(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов.Строки,	ТаблицаШтрихкодовВерхнегоУровня);
			Исключение
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
			КонецПопытки;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			РегистрыСведений["ПулКодовМаркировкиСУЗ"].ОтразитьАгрегациюКодовМаркировкиВПуле(ДеревоМаркированнойПродукцииДляСозданияШтрихкодов);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки;
		
		// В документе ПриемкаТоваровИСМП табличная часть ШтрихкодыУпаковок заполняется перебором строк таблицы ТаблицаШтрихкодовВерхнегоУровня
		// При этом производится разбор каждого кода маркировки без передачи настроек разбора, что вызывает ошибку во внешнем соединении
		// Поэтому для документа ПриемкаТоваровИСМП табличная часть ШтрихкодыУпаковок будет заполнена ниже
		Если ФлагиТипаДокумента.ПриемкаИСМП Тогда
			ПараметрыОкончанияПроверки.ТаблицаШтрихкодовВерхнегоУровня = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ПустаяТаблицаШтрихкодовВерхнегоУровня();
		КонецЕсли;
			
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ЗафиксироватьРезультатПроверкиИПодбора(ПараметрыОкончанияПроверки);
		
		// Документ был записан при фиксации результатов проверки и подбора, но в случае удаления строк с пустым количеством
		// необходимо будет еще раз записать документ, поэтому прочитаем объект для соответствия данных
		Док1СРезультат.Прочитать();
		
		// Заполнение табличной части ШтрихкодыУпаковок для документа ПриемкаТоваровИСМП
		Если ФлагиТипаДокумента.ПриемкаИСМП Тогда 
			
			ПараметрыНормализацииПрочее = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер").ПараметрыНормализацииКодаМаркировки();
			ПараметрыНормализацииПрочее.ИмяСвойстваКодМаркировки = "Штрихкод";
			ПараметрыНормализацииПрочее.НачинаетсяСоСкобки       = Ложь;
			
			//Док1СРезультат.ШтрихкодыУпаковок.Очистить(); // 19.01.20 Очищать ТЧ ШтрихкодыУпаковок нельзя
			
			// +++ Из модуля менеджера документа Приемка ИСМП ОтразитьРезультатыПроверкиИПодбора
			// Обход результатов проверки верхнего уровня
			Для Каждого СтрокаШтрихкодаВерхнегоУровня из ТаблицаШтрихкодовВерхнегоУровня Цикл
				
				Попытка
					ПользовательскиеПараметрыРазбораКодаМаркировки = ИО_ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер").ПользовательскиеПараметрыРазбораКодаМаркировки();
					ПользовательскиеПараметрыРазбораКодаМаркировки.ПроверятьАлфавитЭлементов = Ложь;
					
					РезультатРазбора = ШтрихкодированиеИС_НоваяСтруктураОбработкиШтрихкода(
						СтрокаШтрихкодаВерхнегоУровня.Штрихкод, ПараметрыОкончанияПроверки.ВидПродукцииИС, ПользовательскиеПараметрыРазбораКодаМаркировки);
				Исключение
					РезультатРазбора = ИО_НоваяСтруктураОбработкиШтрихкода(
						СтрокаШтрихкодаВерхнегоУровня.Штрихкод, ПараметрыОкончанияПроверки.ВидПродукцииИС, Ложь);
				КонецПопытки;
					
				КодМаркировкиДляПередачиИСМП = ИО_ОбщийМодуль("ШтрихкодированиеИСМП").КодМаркировкиДляПередачиИСМП(РезультатРазбора, ПараметрыНормализацииПрочее);
				ПараметрыОтбора = Новый Структура("ЗначениеШтрихкода", КодМаркировкиДляПередачиИСМП);
				НайденнаяСтрокаШтрихкода = Док1СРезультат.ШтрихкодыУпаковок.НайтиСтроки(ПараметрыОтбора);
				
				Если НайденнаяСтрокаШтрихкода.Количество() > 0 Тогда
					НайденнаяСтрокаШтрихкода[0].ШтрихкодУпаковки = СтрокаШтрихкодаВерхнегоУровня.ШтрихкодУпаковки;
				Иначе
					НоваяСтрока = Док1СРезультат.ШтрихкодыУпаковок.Добавить();
					НоваяСтрока.ШтрихкодУпаковки   = СтрокаШтрихкодаВерхнегоУровня.ШтрихкодУпаковки;
					НоваяСтрока.КоличествоУпаковок = 1;
				КонецЕсли;
				
			КонецЦикла;
			// ---
					
			Док1СРезультат.Записать();
		КонецЕсли;
		
		Если СтруктураПараметров.ЕстьРасхождения Тогда
			ТребуемоеДействие = Перечисления.ТребуемоеДействиеДокументЭДО.Отклонить;
		Иначе
			ТребуемоеДействие = Перечисления.ТребуемоеДействиеДокументЭДО.Подтвердить;
		КонецЕсли;
		
		Попытка
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, ДанныеПроверкиИПодбора, ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить"));
		Исключение
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].ОтразитьЗавершениеПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, ДанныеПроверкиИПодбора, ПредопределенноеЗначение("Перечисление.ТребуемоеДействиеДокументЭДО.Подтвердить"));
		КонецПопытки;
	Иначе
		// Не будем сразу завершать, а просто сохраним как промежуточный результат
		Попытка
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИС"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, ДанныеПроверкиИПодбора);
		Исключение
			РегистрыСведений["СтатусыПроверкиИПодбораДокументовИСМП"].СохранитьПромежуточныеРезультатыПроверкиДокумента(Док1СРезультат.Ссылка, ВидПродукцииИС, ДанныеПроверкиИПодбора);
		КонецПопытки;
	КонецЕсли;
	
	//СохранитьДанныеПроверкиИПодбора(Док1СРезультат.Ссылка, ДанныеПроверкиИПодбора);
	
	// Если проверка не завершается, то будут записаны только новые документы
	//СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
		
КонецПроцедуры

Функция ИСМП_ПолучитьШтрихкодПалетыВТаблицеКоробкиПалеты(КоробкиПалеты, ИдКоробки)
	
	Если КоробкиПалеты = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИдКоробки) Тогда
		Возврат "";
	КонецЕсли;
	
	ШтрихкодПалеты = "";
	
	СтрокаКоробки = НайтиЭлементМассива(КоробкиПалеты, "Ид", ИдКоробки);
	Если СтрокаКоробки = Неопределено Тогда
		СтрокаКоробки = НайтиЭлементМассива(КоробкиПалеты, "id", ИдКоробки);
	КонецЕсли;
	
	Если СтрокаКоробки <> Неопределено Тогда
		
		ШтрихкодПалеты = ?(СтрокаКоробки.Свойство("Родитель"), СокрЛП(СтрокаКоробки.Родитель), "");
		Если ПустаяСтрока(ШтрихкодПалеты) Тогда
			ШтрихкодПалеты = ?(СтрокаКоробки.Свойство("roditel"), СокрЛП(СтрокаКоробки["roditel"]), "");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
			ЭтоРодитель = Ложь;
			
			СтрокаПалеты = НайтиЭлементМассива(КоробкиПалеты, "Ид", ШтрихкодПалеты);
			Если СтрокаПалеты = Неопределено Тогда
				СтрокаПалеты = НайтиЭлементМассива(КоробкиПалеты, "id", ШтрихкодПалеты);
			КонецЕсли;
			
			Если СтрокаПалеты <> Неопределено Тогда
				ИмяПоляТип = "";
				Если СтрокаПалеты.Свойство("Тип") Тогда
					ИмяПоляТип = "Тип";
				ИначеЕсли СтрокаПалеты.Свойство("Type") Тогда
					ИмяПоляТип = "Type"
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(ИмяПоляТип) Тогда
					ЭтоРодитель = СтрокаПалеты[ИмяПоляТип] = "Палета"
						ИЛИ СтрокаПалеты[ИмяПоляТип] = "Pallet";
				Иначе
					Если СтрокаПалеты.Свойство("ЭтоРодитель") Тогда
						ЭтоРодитель = СтрокаПалеты.ЭтоРодитель;
					ИначеЕсли СтрокаПалеты.Свойство("EtoRoditel") Тогда
						ЭтоРодитель = СтрокаПалеты["EtoRoditel"];
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ЭтоРодитель <> Истина Тогда
				ШтрихкодПалеты = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
 
	Возврат ШтрихкодПалеты;
	
КонецФункции

Функция ИСМП_ПолучитьШтрихкодыКоробокПалетВТаблицеКоробкиПалеты(КоробкиПалеты)

	Перем ИмяПоляТип;
	
	Если КоробкиПалеты = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;
	
	СоответствиеКоробкиПалеты = Новый Соответствие();
	
	Для каждого СтрокаКоробки Из КоробкиПалеты Цикл
		
		Если СтрокаКоробки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
			
		Если ИмяПоляТип = Неопределено Тогда
			ИмяПоляТип = "";
			
			Если СтрокаКоробки.Свойство("Тип") Тогда
				ИмяПоляТип = "Тип";
			ИначеЕсли СтрокаКоробки.Свойство("Type") Тогда
				ИмяПоляТип = "Type"
			КонецЕсли;
		КонецЕсли;
		
		ШтрихкодПалеты 	= "";
		ШтрихкодКоробки = "";
		
		// Собираем в таблицу только строки с коробками
		Если НЕ ПустаяСтрока(ИмяПоляТип) Тогда
			ЭтоКоробка = СтрокаКоробки[ИмяПоляТип] = "Коробка"
				ИЛИ СтрокаКоробки[ИмяПоляТип] = "Box";
			Если НЕ ЭтоКоробка Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			ЭтоРодитель = ?(СтрокаКоробки.Свойство("ЭтоРодитель"), СтрокаКоробки.ЭтоРодитель, 
				?(СтрокаКоробки.Свойство("EtoRoditel"), СтрокаКоробки["EtoRoditel"], 
				?(СтрокаКоробки.Свойство("IsParent"), СтрокаКоробки["IsParent"], Ложь)));
			Если ЭтоРодитель = Истина Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ШтрихкодКоробки = ?(СтрокаКоробки.Свойство("Ид"), СтрокаКоробки.Ид, ?(СтрокаКоробки.Свойство("Id"), СтрокаКоробки["Id"], ""));
		Если НЕ ЗначениеЗаполнено(ШтрихкодКоробки) Тогда
			Продолжить;
		КонецЕсли;
		
		// Пропускаем коробки, которые не вложены в палету
		ШтрихкодПалеты = ?(СтрокаКоробки.Свойство("Родитель"), СокрЛП(СтрокаКоробки.Родитель), ?(СтрокаКоробки.Свойство("roditel"), СокрЛП(СтрокаКоробки["roditel"]), ""));
		Если НЕ ЗначениеЗаполнено(ШтрихкодПалеты) Тогда
			Продолжить;	
		КонецЕсли;
		
		// Пропускаем коробки, по которым в таблице КоробкиПалеты нет родителя или у родителя нет флага ЭтоРодитель
		СтрокаПалеты = НайтиЭлементМассива(КоробкиПалеты, "Ид", ШтрихкодПалеты);
		Если СтрокаПалеты = Неопределено Тогда
			СтрокаПалеты = НайтиЭлементМассива(КоробкиПалеты, "id", ШтрихкодПалеты);
		КонецЕсли;
		Если СтрокаПалеты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ИмяПоляТип) Тогда
			ЭтоПалета = СтрокаПалеты[ИмяПоляТип] = "Палета"
				ИЛИ СтрокаПалеты[ИмяПоляТип] = "Pallet";
			Если НЕ ЭтоПалета Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			СтрокаПалеты_ЭтоРодитель = ?(СтрокаПалеты.Свойство("ЭтоРодитель"), СтрокаПалеты.ЭтоРодитель,
				?(СтрокаПалеты.Свойство("EtoRoditel"), СтрокаПалеты["EtoRoditel"], 
				?(СтрокаПалеты.Свойство("IsParent"), СтрокаПалеты["IsParent"], Ложь)));
			Если СтрокаПалеты_ЭтоРодитель <> Истина Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СоответствиеКоробкиПалеты.Вставить(ШтрихкодКоробки, ШтрихкодПалеты);
		
	КонецЦикла;
	
	Возврат СоответствиеКоробкиПалеты;
	
КонецФункции

Процедура ИСМП_ДобавитьСтрокиВТаблицуМаркированнойПродукции(ТаблицаМаркированнойПродукции, СтруктураПоиска, СтрокаДокументаТСД = Неопределено, СтатусДляНовыхСтрок = Неопределено)

	РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(СтруктураПоиска);
	Если РезПоиска.Количество() <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодПалеты") Тогда
		СтруктураПоиска.Вставить("ШтрихкодПалеты", "");
	КонецЕсли;
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодКоробки") Тогда
		СтруктураПоиска.Вставить("ШтрихкодКоробки", "");
	КонецЕсли;
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодГруппы") Тогда
		СтруктураПоиска.Вставить("ШтрихкодГруппы", "");
	КонецЕсли;
	Если НЕ СтруктураПоиска.Свойство("ШтрихкодПачки") Тогда
		СтруктураПоиска.Вставить("ШтрихкодПачки", "");
	КонецЕсли;
	
	// Пропускаем элементы с циклическими вложениями
	Если ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) И СтруктураПоиска.ШтрихкодПачки = СтруктураПоиска.ШтрихкодГруппы
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) И СтруктураПоиска.ШтрихкодПачки = СтруктураПоиска.ШтрихкодКоробки
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) И СтруктураПоиска.ШтрихкодПачки = СтруктураПоиска.ШтрихкодПалеты
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодГруппы) И СтруктураПоиска.ШтрихкодГруппы = СтруктураПоиска.ШтрихкодКоробки
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодГруппы) И СтруктураПоиска.ШтрихкодГруппы = СтруктураПоиска.ШтрихкодПалеты
			ИЛИ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодКоробки) И СтруктураПоиска.ШтрихкодКоробки = СтруктураПоиска.ШтрихкодПалеты Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнение верхнего уровня упаковок по тем элементам, которые уже есть в ТаблицаМаркированнойПродукции
	Если НЕ ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) Тогда
		Если ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодГруппы) Тогда
			РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодГруппы", СтруктураПоиска.ШтрихкодГруппы));
			
			СтрокиЗаполнены = Ложь;
			Для каждого НайденнаяСтрока ИЗ РезПоиска Цикл
				Если НЕ (ЗначениеЗаполнено(НайденнаяСтрока.ШтрихкодПалеты) ИЛИ ЗначениеЗаполнено(НайденнаяСтрока.ШтрихкодКоробки)) Тогда
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтруктураПоиска, "ШтрихкодКоробки, ШтрихкодПалеты");
					СтрокиЗаполнены = Истина;
				КонецЕсли;
			КонецЦикла;	
				
			Если СтрокиЗаполнены Тогда
				Возврат;
			КонецЕсли;
		Иначе
			РезПоиска = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодКоробки", СтруктураПоиска.ШтрихкодКоробки));
			
			СтрокиЗаполнены = Ложь;
			Для каждого НайденнаяСтрока ИЗ РезПоиска Цикл
				Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ШтрихкодПалеты) Тогда
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтруктураПоиска, "ШтрихкодПалеты");
					СтрокиЗаполнены = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокиЗаполнены Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
		Номенклатура 	= ?(СтрокаДокументаТСД.Свойство("Номенклатура"), 		СтрокаДокументаТСД.Номенклатура, 	  Неопределено);
		Характеристика	= ?(СтрокаДокументаТСД.Свойство("Характеристика"), 		СтрокаДокументаТСД.Характеристика, 	  Неопределено);
		Серия			= ?(СтрокаДокументаТСД.Свойство("СерияНоменклатуры"), 	СтрокаДокументаТСД.СерияНоменклатуры, Неопределено);
		GTIN			= ?(СтрокаДокументаТСД.Свойство("GTIN"), 				СтрокаДокументаТСД.GTIN, 			  "");
	Иначе
		Номенклатура 	= Неопределено;
		Характеристика	= Неопределено;
		Серия			= Неопределено;
		GTIN 			= "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодПачки) Тогда
		
		ЗначениеШтрихкода = СтруктураПоиска.ШтрихкодПачки;
		
		Если НЕ ЗначениеЗаполнено(GTIN) Тогда
			GTIN = ?(Лев(ЗначениеШтрихкода, 4) = "(01)", Сред(ЗначениеШтрихкода, 5, 14), "");
		КонецЕсли;
		
		GTINГруппы = ?(Лев(СтруктураПоиска.ШтрихкодГруппы, 4) = "(01)", Сред(СтруктураПоиска.ШтрихкодГруппы, 5, 14), "");
		
		НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
		НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
		НоваяСтрока.Номенклатура		= Номенклатура;
		НоваяСтрока.Характеристика		= Характеристика;
		НоваяСтрока.Серия				= Серия;
		НоваяСтрока.GTIN 			   	= GTIN;
		НоваяСтрока.GTINГруппы 			= GTINГруппы;
		НоваяСтрока.КоличествоУпаковок 	= 1;
		НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
		
	ИначеЕсли ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодГруппы) Тогда
		
		GTINГруппы = ?(Лев(СтруктураПоиска.ШтрихкодГруппы, 4) = "(01)", Сред(СтруктураПоиска.ШтрихкодГруппы, 5, 14), "");
		
		// Собираем содержимое групповой упаковки по данным ШУИТ
		ГруппаШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(СтруктураПоиска.ШтрихкодГруппы);
				
		Если ЗначениеЗаполнено(ГруппаШУИТ) И ГруппаШУИТ.ВложенныеШтрихкоды.Количество() Тогда
			
			Для каждого ШтрихкодПачки ИЗ ГруппаШУИТ.ВложенныеШтрихкоды Цикл
				
				Если НЕ ЗначениеЗаполнено(ШтрихкодПачки.Штрихкод) Тогда
					Продолжить;
				КонецЕсли;
				
				ПачкаШУИТ = ШтрихкодПачки.Штрихкод;
				
				ЗначениеШтрихкода = ПачкаШУИТ.ЗначениеШтрихкода;
				
				Если НЕ ЗначениеЗаполнено(GTIN) Тогда
					GTIN = ?(Лев(ЗначениеШтрихкода, 4) = "(01)", Сред(ЗначениеШтрихкода, 5, 14), "");
				КонецЕсли;
				
				// Заполняем номенклатуру по данным ШУИТ
				Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
					Номенклатура   = ПачкаШУИТ.Номенклатура;
					Характеристика = ПачкаШУИТ.Характеристика;
					Серия		   = ПачкаШУИТ.Серия;   
				КонецЕсли;
				
				СтруктураПоиска.Вставить("ШтрихкодПачки", ЗначениеШтрихкода);
				
			    НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();

				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
				НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
				НоваяСтрока.Номенклатура		= Номенклатура;
				НоваяСтрока.Характеристика		= Характеристика;
				НоваяСтрока.Серия				= Серия;
				НоваяСтрока.GTIN 			   	= GTIN;
				НоваяСтрока.GTINГруппы		   	= GTINГруппы;
				НоваяСтрока.КоличествоУпаковок 	= 1;
				НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
				
			КонецЦикла;
			
		Иначе	
			
			ЗначениеШтрихкода = СтруктураПоиска.ШтрихкодГруппы;
			
			// Заполняем номенклатуру по данным ШУИТ
			Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) И ЗначениеЗаполнено(ГруппаШУИТ) Тогда
				Номенклатура 	= ГруппаШУИТ.Номенклатура;
				Характеристика 	= ГруппаШУИТ.Характеристика;
				Серия			= ГруппаШУИТ.Серия;
			КонецЕсли;
			
			// Вложенных товаров нет
			НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
			НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
			НоваяСтрока.Номенклатура		= Номенклатура;
			НоваяСтрока.Характеристика		= Характеристика;
			НоваяСтрока.Серия				= Серия;
			НоваяСтрока.GTIN		   		= GTINГруппы;
			НоваяСтрока.GTINГруппы	   		= GTINГруппы;
			НоваяСтрока.КоличествоУпаковок 	= 1;
			НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
					
		КонецЕсли;	
		
	ИначеЕсли ЗначениеЗаполнено(СтруктураПоиска.ШтрихкодКоробки) Тогда
		
		// Собираем содержимое коробки по данным ШУИТ
		КоробкаШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(СтруктураПоиска.ШтрихкодКоробки);
			
		Если ЗначениеЗаполнено(КоробкаШУИТ) И КоробкаШУИТ.ВложенныеШтрихкоды.Количество() Тогда
			
			Для каждого ШтрихкодВложенияВКоробку ИЗ КоробкаШУИТ.ВложенныеШтрихкоды Цикл
				
				Если НЕ ЗначениеЗаполнено(ШтрихкодВложенияВКоробку.Штрихкод) Тогда
					Продолжить;
				КонецЕсли;
				
				УпаковкаШУИТ = ШтрихкодВложенияВКоробку.Штрихкод;
				
				ЗначениеШтрихкода = УпаковкаШУИТ.ЗначениеШтрихкода;
				
				// В коробку могут быть вложены как групповые, так и потребительские упаковки
				ЭтоПотребительскаяУпаковка = УпаковкаШУИТ.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
					ИЛИ УпаковкаШУИТ.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.ПустаяСсылка");
					
				Если ЭтоПотребительскаяУпаковка Тогда
				
					ПачкаШУИТ = УпаковкаШУИТ;
					
					Если НЕ ЗначениеЗаполнено(GTIN) Тогда
						GTIN = ?(Лев(ЗначениеШтрихкода, 4) = "(01)", Сред(ЗначениеШтрихкода, 5, 14), "");
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
						Номенклатура   = ПачкаШУИТ.Номенклатура;
						Характеристика = ПачкаШУИТ.Характеристика;
						Серия		   = ПачкаШУИТ.Серия;   
					КонецЕсли;
						
					СтруктураПоиска.Вставить("ШтрихкодПачки", ЗначениеШтрихкода);
						
					НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();

					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
					НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
					НоваяСтрока.Номенклатура		= Номенклатура;
					НоваяСтрока.Характеристика		= Характеристика;
					НоваяСтрока.Серия				= Серия;
					НоваяСтрока.GTIN 			   	= GTIN;
					НоваяСтрока.GTINГруппы		   	= "";
					НоваяСтрока.КоличествоУпаковок 	= 1;
					НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
					
				Иначе
					
					ШтрихкодГруппы = ЗначениеШтрихкода;
					
					GTINГруппы = ?(Лев(ЗначениеШтрихкода, 4) = "(01)", Сред(ЗначениеШтрихкода, 5, 14), "");
					
					// Собираем содержимое групповой упаковки по данным ШУИТ
					ГруппаШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(ЗначениеШтрихкода);
							
					Если ЗначениеЗаполнено(ГруппаШУИТ) И ГруппаШУИТ.ВложенныеШтрихкоды.Количество() Тогда
						
						Для каждого ШтрихкодПачки ИЗ ГруппаШУИТ.ВложенныеШтрихкоды Цикл
							
							Если НЕ ЗначениеЗаполнено(ШтрихкодПачки.Штрихкод) Тогда
								Продолжить;
							КонецЕсли;
							
							ПачкаШУИТ = ШтрихкодПачки.Штрихкод;
							
							ЗначениеШтрихкода = ПачкаШУИТ.ЗначениеШтрихкода;
							
							Если НЕ ЗначениеЗаполнено(GTIN) Тогда
								GTIN = ?(Лев(ЗначениеШтрихкода, 4) = "(01)", Сред(ЗначениеШтрихкода, 5, 14), "");
							КонецЕсли;
							
							// Заполняем номенклатуру по данным ШУИТ
							Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) Тогда
								Номенклатура   = ПачкаШУИТ.Номенклатура;
								Характеристика = ПачкаШУИТ.Характеристика;
								Серия		   = ПачкаШУИТ.Серия;   
							КонецЕсли;
							
							СтруктураПоиска.Вставить("ШтрихкодПачки", ЗначениеШтрихкода);
							
						    НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();

							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
							НоваяСтрока.ШтрихкодГруппы		= ШтрихкодГруппы;
							НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
							НоваяСтрока.Номенклатура		= Номенклатура;
							НоваяСтрока.Характеристика		= Характеристика;
							НоваяСтрока.Серия				= Серия;
							НоваяСтрока.GTIN 			   	= GTIN;
							НоваяСтрока.GTINГруппы			= GTINГруппы;
							НоваяСтрока.КоличествоУпаковок 	= 1;
							НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
							
						КонецЦикла;
						
					Иначе	
						
						// Заполняем номенклатуру по данным ШУИТ
						Если НЕ ЗначениеЗаполнено(СтрокаДокументаТСД) И ЗначениеЗаполнено(ГруппаШУИТ) Тогда
							Номенклатура 	= ГруппаШУИТ.Номенклатура;
							Характеристика 	= ГруппаШУИТ.Характеристика;
							Серия			= ГруппаШУИТ.Серия;
						КонецЕсли;
						
						// Вложенных товаров нет
						НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
						
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
						НоваяСтрока.ШтрихкодГруппы		= ШтрихкодГруппы;
						НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
						НоваяСтрока.Номенклатура		= Номенклатура;
						НоваяСтрока.Характеристика		= Характеристика;
						НоваяСтрока.Серия				= Серия;
						НоваяСтрока.GTIN 			   	= GTINГруппы;
						НоваяСтрока.GTINГруппы		   	= GTINГруппы;
						НоваяСтрока.КоличествоУпаковок 	= 1;
						НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
													
					КонецЕсли;
					
				КонецЕсли;
						
			КонецЦикла; // цикл по вложениям коробки
					
		Иначе	
			
			// Вложенных товаров нет
			НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоиска);
			НоваяСтрока.СтатусПроверки 		= СтатусДляНовыхСтрок;	
			НоваяСтрока.Номенклатура		= Номенклатура;
			НоваяСтрока.Характеристика		= Характеристика;
			НоваяСтрока.Серия				= Серия;
			НоваяСтрока.GTIN 			   	= GTIN;
			НоваяСтрока.GTINГруппы		   	= "";
			НоваяСтрока.КоличествоУпаковок 	= 1;
			НоваяСтрока.КоличествоПотребительскихУпаковок = 1;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ИСМП_МОТП_ЗаполнитьТаблицуМаркируемойПродукцииПоДаннымДокумента(ТаблицаМаркированнойПродукции, Контекст, ВидПродукцииИС)
	
	МаркируемаяПродукцияДокумента = ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ТаблицаМаркируемойПродукцииДокумента(Контекст, ВидПродукцииИС);
	
	// см. Обработка.ПроверкаИПодборПродукцииИСМП.ЗаполнитьТаблицуПодобраннойМаркируемойПродукции
	НомерСтроки = 1;
	Для Каждого СтрокаИсточника Из МаркируемаяПродукцияДокумента Цикл
			
		СтрокаПодобраннойПродукции = ТаблицаМаркированнойПродукции.Добавить();
			
		ЗаполнитьЗначенияСвойств(СтрокаПодобраннойПродукции, СтрокаИсточника);
			
		СтрокаПодобраннойПродукции.НоменклатураСопоставлена = ЗначениеЗаполнено(СтрокаПодобраннойПродукции.Номенклатура);
		СтрокаПодобраннойПродукции.ПредставлениеGTIN 		= ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").ПредставлениеМассиваGTIN(СтрокаПодобраннойПродукции.КодыGTIN);
		Если СтрокаПодобраннойПродукции.КодыGTIN.Количество() = 1 Тогда
			СтрокаПодобраннойПродукции.GTIN = СтрокаПодобраннойПродукции.КодыGTIN[0].Значение;
		КонецЕсли;
		СтрокаПодобраннойПродукции.НомерСтроки 				  = НомерСтроки;
		СтрокаПодобраннойПродукции.ИндексКодаМаркировки 	  = 2;
		СтрокаПодобраннойПродукции.ХарактеристикиИспользуются = ЗначениеЗаполнено(СтрокаПодобраннойПродукции.Характеристика);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИСМП_ЗаполнитьСлужебныеРеквизитыВесовойПродукции(ТабличнаяЧасть, ВидПродукцииИС)
	
	ИмяСобытия = "ИСМП_ЗаполнитьСлужебныеРеквизитыВесовойПродукции";
	
	МетаданныеНСИ 		   = Конф_ПолучитьМетаданныеНСИ();
	ИмяСправочникаУпаковки = МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника;
	ИмяРеквизитаБазоваяЕИ  = МетаданныеНСИ.Номенклатура.БазоваяЕдиницаИзмерения.ИмяРеквизита;
	
	Попытка
		НомерСтроки = 0;
		Для каждого ТекСтрока ИЗ ТабличнаяЧасть Цикл
			НомерСтроки = НомерСтроки + 1;
			ТекСтрока.НомерСтроки = НомерСтроки;
		КонецЦикла;
			
		ИО_ОбщийМодуль("ИнтеграцияИСПереопределяемый").ЗаполнитьСлужебныеРеквизитыВКоллекции(Неопределено, ТабличнаяЧасть);
				
		ОписанияНоменклатуры = РС_ОписаниеНоменклатурыИС_ПолучитьОписание(ТабличнаяЧасть.ВыгрузитьКолонку("Номенклатура"));
		Для каждого ТекСтрока ИЗ ТабличнаяЧасть Цикл
			// На количество упаковок ориентироваться нельзя, т.к. возможно суммирование в рамках ОСУ
			// Если ТекСтрока.КоличествоУпаковок <> 1 Тогда
			// 	Продолжить;
			// КонецЕсли;
				
			ОписаниеНоменклатуры = ОписанияНоменклатуры.Получить(ТекСтрока.Номенклатура);
			Если ОписаниеНоменклатуры <> Неопределено Тогда
				ТекСтрока.ПотребительскаяУпаковка = ОписаниеНоменклатуры.ПотребительскаяУпаковка;
			КонецЕсли;
			
			Если ТекСтрока.ПроизвольнаяЕдиницаУчета И НЕ ТекСтрока.ТребуетВзвешивания Тогда // Фасованная весовая продукция
				Если ОписаниеНоменклатуры = Неопределено
					ИЛИ ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.ИдЕдиницыИзмерения) Тогда
					// Строка была восстановлена из сохраненных результатов проверки и подбора
					Продолжить;
				КонецЕсли;
					
				УпаковкаСовпадаетСБазовой = Истина;
				ЗагружаемаяУпаковка = Справочники[МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(ТекСтрока.ИдЕдиницыИзмерения));
				Если ЗначениеЗаполнено(ЗагружаемаяУпаковка)
					И НЕ ГлЯдро_СтрНайти(СокрЛП(ЗагружаемаяУпаковка), "бъект не найден")
					И НЕ ГлЯдро_СтрНайти(СокрЛП(ЗагружаемаяУпаковка), "bject not found") Тогда
					УпаковкаСовпадаетСБазовой = ЗагружаемаяУпаковка = УТ_11_2_ПолучитьБазовуюУпаковкуНоменклатуры(ТекСтрока.Номенклатура);
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если ЗагружаемаяУпаковка = ОписаниеНоменклатуры.ПотребительскаяУпаковка Тогда
					КоэффициентЗагружаемойУпаковки = ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке;
				Иначе
					КоэффициентЗагружаемойУпаковки = ?(ЗагружаемаяУпаковка.Числитель = 0, 1, ЗагружаемаяУпаковка.Числитель) 
						/ ?(ЗагружаемаяУпаковка.Знаменатель = 0, 1, ЗагружаемаяУпаковка.Знаменатель);
				КонецЕсли;
				Если УпаковкаСовпадаетСБазовой Тогда
					// Для объемно-сортового учета пересчитываем количество потребительских упаковок (в строках с марками уже указана 1)
					Если ТекСтрока.ОбъемноСортовойУчет Тогда
						ТекСтрока.КоличествоПотребительскихУпаковок = ТекСтрока.КоличествоУпаковок / КоэффициентЗагружаемойУпаковки;
					КонецЕсли;					
					Продолжить;
				Иначе
					// Для объемно-сортового учета записываем количество потребительских упаковок (в строках с марками уже указана 1)
					Если ТекСтрока.ОбъемноСортовойУчет Тогда
						ТекСтрока.КоличествоПотребительскихУпаковок = ТекСтрока.КоличествоУпаковок;
					КонецЕсли;
					ТекСтрока.КоличествоУпаковок = ТекСтрока.КоличествоУпаковок * КоэффициентЗагружаемойУпаковки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Функция ИСМП_ПолучитьОписанияGTIN(МассивGTIN)
	
	ОписанияGTIN = Новый Соответствие;
	
	Если НЕ МассивGTIN.Количество() Тогда
		Возврат ОписанияGTIN;
	КонецЕсли;
	
	Попытка
		ОписанияGTIN = РегистрыСведений["ОписаниеGTINИС"].ПолучитьОписание(МассивGTIN);
	Исключение	
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ИСМП_ПолучитьОписанияGTIN", "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
		
	Возврат ОписанияGTIN;
		
КонецФункции

Процедура ИСМП_ЗаполнитьДанныеГрупповыхУпаковокВТаблицеМаркированнойПродукции(ТаблицаМаркированнойПродукции, ДанныеНаборов = Неопределено)

	Попытка
		ВидУпаковкиГрупп = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая");
		ВидУпаковкиНабор = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор");
	Исключение
		Возврат;
	КонецПопытки;
	
	// Определяем вид групповых упаковок, полученных из строк документа ТСД
	СтрокиДляОпределенияВидаГрупповыхУпаковок = Новый Массив;
	
	МассивGTIN = Новый Массив;
	Для каждого СтрокаТаблицы ИЗ ТаблицаМаркированнойПродукции Цикл
		Если ПустаяСтрока(СтрокаТаблицы.ШтрихкодГруппы) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивGTIN.Найти(СтрокаТаблицы.GTINГруппы) = Неопределено Тогда
			МассивGTIN.Добавить(СтрокаТаблицы.GTINГруппы);
		КонецЕсли;
		
		СтрокиДляОпределенияВидаГрупповыхУпаковок.Добавить(СтрокаТаблицы);
	КонецЦикла;
	
	Если МассивGTIN.Количество() Тогда
		ОписанияGTIN = ИСМП_ПолучитьОписанияGTIN(МассивGTIN);
		
		Для каждого СтрокаТаблицы ИЗ СтрокиДляОпределенияВидаГрупповыхУпаковок Цикл
			ДанныеGTIN = ОписанияGTIN.Получить(СтрокаТаблицы.GTINГруппы);
			Если НЕ ДанныеGTIN = Неопределено Тогда
				СтрокаТаблицы.ВидУпаковки = ДанныеGTIN.ВидУпаковки;
			
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ШтрихкодПачки) Тогда
					КоличествоПотребительскихУпаковок = ?(ДанныеGTIN.КоличествоПотребительскихУпаковок = 0, 1, ДанныеGTIN.КоличествоПотребительскихУпаковок);
					
					СтрокаТаблицы.КоличествоУпаковок = КоличествоПотребительскихУпаковок;
					СтрокаТаблицы.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//
	
	// Наборы должны загружаться без вложений для всех документов, кроме агрегаций
	Если ДанныеНаборов = Неопределено Тогда
		ТаблицаНаборы = ТаблицаМаркированнойПродукции.Скопировать(
			Новый Структура("ВидУпаковки", ВидУпаковкиНабор), "ШтрихкодГруппы, GTINГруппы");
		ТаблицаНаборы.Свернуть("ШтрихкодГруппы, GTINГруппы");
		
		ДанныеПоШтрихкодамEAN = ШтрихкодированиеИС_ДанныеПоШтрихкодамEAN(ТаблицаНаборы.ВыгрузитьКолонку("GTINГруппы"));
		
		Для каждого СтрокаНабор ИЗ ТаблицаНаборы Цикл
			ДанныеПоШтрихкоду = НайтиУпаковкуТоваровПоШтрихкоду(СтрокаНабор.ШтрихкодГруппы);
			
			Если ДанныеПоШтрихкоду = Неопределено Тогда
				ДанныеПоШтрихкоду = ДанныеПоШтрихкодамEAN.Найти(СтрокаНабор.GTINГруппы, "ШтрихкодEAN");
				
				Если ДанныеПоШтрихкоду = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ПерваяСтрока = Истина;
			
			СтрокиТаблицыМП = ТаблицаМаркированнойПродукции.НайтиСтроки(
				Новый Структура("ШтрихкодГруппы", СтрокаНабор.ШтрихкодГруппы));
			Для каждого СтрокаТаблицы ИЗ СтрокиТаблицыМП Цикл
				Если ПустаяСтрока(СтрокаТаблицы.ШтрихкодПачки) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПерваяСтрока Тогда
					СтрокаТаблицы.ШтрихкодПачки	 = СтрокаНабор.ШтрихкодГруппы;
					СтрокаТаблицы.ШтрихкодГруппы = "";
					СтрокаТаблицы.GTIN			 = СтрокаНабор.GTINГруппы;
					
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеПоШтрихкоду, "Номенклатура, Характеристика, Серия");
				Иначе	
					ТаблицаМаркированнойПродукции.Удалить(СтрокаТаблицы);	
				КонецЕсли;
				
				ПерваяСтрока = Ложь;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// Проверяем, не являются ли коробки в строках документа ТСД групповыми упаковками/наборами (возможно только для агрегаций)
	Если НЕ ДанныеНаборов = Неопределено Тогда
		ИСМП_ДополнитьДанныеGTINКоробами(ДанныеНаборов, ТаблицаМаркированнойПродукции);
		
		Для каждого ДанныеНабора ИЗ ДанныеНаборов Цикл
			ШтрихкодГруппы = ДанныеНабора.Ключ;
			
			НайденныеСтроки = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодКоробки", ШтрихкодГруппы));
			Для каждого СтрокаТаблицы ИЗ НайденныеСтроки Цикл	
		
				// Переносим коробки в групповые упаковки
				СтрокаТаблицы.ШтрихкодГруппы 	= СтрокаТаблицы.ШтрихкодКоробки;
				СтрокаТаблицы.ШтрихкодКоробки	= "";
				СтрокаТаблицы.GTINГруппы	 	= ДанныеНабора.Значение.GTIN;
				СтрокаТаблицы.ВидУпаковки 	 	= ДанныеНабора.Значение.ВидУпаковки;
				
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	//
	
	СтруктураОтбора = Новый Структура("ШтрихкодГруппы, ОбъемноСортовойУчет", "", Ложь);
	
	// Проверяем, не являются ли марки в строках документа ТСД групповыми упаковками/наборами
	СтрокиGTIN = ТаблицаМаркированнойПродукции.Скопировать(СтруктураОтбора, "GTIN");
	СтрокиGTIN.Свернуть("GTIN");
	
	МассивGTIN = СтрокиGTIN.ВыгрузитьКолонку("GTIN");
	Если МассивGTIN.Количество() Тогда
		ОписанияGTIN = ИСМП_ПолучитьОписанияGTIN(МассивGTIN);
		
		Для каждого ОписаниеGTIN ИЗ ОписанияGTIN Цикл
			ДанныеGTIN = ОписаниеGTIN.Значение;
			
			Если НЕ ДанныеGTIN.ВидУпаковки = ВидУпаковкиГрупп
				И НЕ ДанныеGTIN.ВидУпаковки = ВидУпаковкиНабор Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныеСтроки = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("GTIN", ОписаниеGTIN.Ключ));
			Для каждого СтрокаТаблицы ИЗ НайденныеСтроки Цикл
				
				// Возможно, штрихкод группы уже есть в текущем документе (агрегация в групповую упаковку/набор, повторная загрузка одних и тех же КИГУ)
				СтрокиВложений = ТаблицаМаркированнойПродукции.НайтиСтроки(Новый Структура("ШтрихкодГруппы", СтрокаТаблицы.ШтрихкодПачки));
					
				Для каждого СтрокаВложения ИЗ СтрокиВложений Цикл
					ЗаполнитьЗначенияСвойств(СтрокаВложения, СтрокаТаблицы, "ШтрихкодКоробки, ШтрихкодПалеты");						
				КонецЦикла;
					
				Если СтрокиВложений.Количество() Тогда
					ТаблицаМаркированнойПродукции.Удалить(СтрокаТаблицы);
					Продолжить;
				КонецЕсли;
				//
				
				// Переносим марки в групповые упаковки
				СтрокаТаблицы.ШтрихкодГруппы = СтрокаТаблицы.ШтрихкодПачки;
				СтрокаТаблицы.ШтрихкодПачки	 = "";
				СтрокаТаблицы.GTINГруппы	 = СтрокаТаблицы.GTIN;
				СтрокаТаблицы.ВидУпаковки 	 = ДанныеGTIN.ВидУпаковки;
				
				Если ДанныеGTIN.ВидУпаковки = ВидУпаковкиГрупп ИЛИ НЕ ДанныеНаборов = Неопределено Тогда
					// Заполняем состав групповых упаковок по данным ШУИТ
					ГруппаШУИТ = ИСМП_МОТП_ПолучитьПоЗначениюШтрихкодаЭлементШУИТ(СтрокаТаблицы.ШтрихкодГруппы);
					
					Если ЗначениеЗаполнено(ГруппаШУИТ) Тогда
						ДобавленоСтрок = 0;
						
						Для каждого ШтрихкодПачки ИЗ ГруппаШУИТ.ВложенныеШтрихкоды Цикл
							ПачкаШУИТ = ШтрихкодПачки.Штрихкод;
								
							Если НЕ ЗначениеЗаполнено(ПачкаШУИТ) Тогда
								Продолжить;
							КонецЕсли;
								
							ЗначениеШтрихкода = ПачкаШУИТ.ЗначениеШтрихкода;
							
							НоваяСтрока = ТаблицаМаркированнойПродукции.Добавить();
							
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
							
							// Номенклатура набора отличается от номенклатуры вложенных строк
							Если ДанныеGTIN.ВидУпаковки = ВидУпаковкиНабор Тогда
								ЗаполнитьЗначенияСвойств(НоваяСтрока, ПачкаШУИТ, "Номенклатура, Характеристика, Серия");
								
								СтруктураДанных = Новый Структура;
								СтруктураДанных.Вставить("ВидУпаковки", 	СтрокаТаблицы.ВидУпаковки);
								СтруктураДанных.Вставить("Номенклатура", 	СтрокаТаблицы.Номенклатура);
								СтруктураДанных.Вставить("Характеристика", 	СтрокаТаблицы.Характеристика);
								СтруктураДанных.Вставить("Серия", 			СтрокаТаблицы.Серия);
								СтруктураДанных.Вставить("GTIN", 			СтрокаТаблицы.GTINГруппы);
								
								ДанныеНаборов.Вставить(СтрокаТаблицы.ШтрихкодГруппы, СтруктураДанных);
							Иначе
								НоваяСтрока.КоличествоУпаковок = ПачкаШУИТ.Количество;
								НоваяСтрока.КоличествоПотребительскихУпаковок =
									ПачкаШУИТ.КоличествоПотребительскихУпаковок;
							КонецЕсли;
								
							НоваяСтрока.ШтрихкодПачки = ЗначениеШтрихкода;
							НоваяСтрока.GTIN = ?(Лев(ЗначениеШтрихкода, 1) = "(",
								Сред(ЗначениеШтрихкода, 5, 14),
								Лев(ЗначениеШтрихкода, 14));
							
							ДобавленоСтрок = ДобавленоСтрок + 1;
						КонецЦикла;
							
						Если ДобавленоСтрок Тогда	
							ТаблицаМаркированнойПродукции.Удалить(СтрокаТаблицы);
						Иначе
							СтрокаТаблицы.КоличествоУпаковок = ГруппаШУИТ.Количество;
							СтрокаТаблицы.КоличествоПотребительскихУпаковок = ГруппаШУИТ.Количество;
						КонецЕсли;
					Иначе
						КоличествоПотребительскихУпаковок = ?(ДанныеGTIN.КоличествоПотребительскихУпаковок = 0, 1, ДанныеGTIN.КоличествоПотребительскихУпаковок);
					
						СтрокаТаблицы.КоличествоУпаковок = КоличествоПотребительскихУпаковок;
						СтрокаТаблицы.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
					КонецЕсли;
				Иначе	
					КоличествоПотребительскихУпаковок = ?(ДанныеGTIN.КоличествоПотребительскихУпаковок = 0, 1, ДанныеGTIN.КоличествоПотребительскихУпаковок);
					
					СтрокаТаблицы.КоличествоУпаковок = КоличествоПотребительскихУпаковок;
					СтрокаТаблицы.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковок;
				КонецЕсли;				
				
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	//
	
КонецПроцедуры

Процедура ИСМП_ДополнитьДанныеGTINКоробами(ДанныеGTIN, ТаблицаМаркированнойПродукцииИСМП)

	Попытка
		ВидУпаковкиГрупп = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая");
		ВидУпаковкиНабор = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор");
	Исключение
		Возврат;
	КонецПопытки;
	
	ШтрихкодыEAN = ТаблицаМаркированнойПродукцииИСМП.Скопировать(, "ШтрихкодКоробки");
	ШтрихкодыEAN.Свернуть("ШтрихкодКоробки");
	ШтрихкодыEAN.Колонки.Добавить("ШтрихкодEAN", Новый ОписаниеТипов("Строка"));
	Для каждого СтрокаШтрихкода ИЗ ШтрихкодыEAN Цикл
		ШтрихкодКоробки = СтрокаШтрихкода.ШтрихкодКоробки;
		Если ПустаяСтрока(ШтрихкодКоробки) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаШтрихкода.ШтрихкодEAN = ?(Лев(ШтрихкодКоробки, 1) = "(", Сред(ШтрихкодКоробки, 5, 14), Лев(ШтрихкодКоробки, 14));
	КонецЦикла;
	
	ДанныеПоШтрихкодамEAN = ШтрихкодированиеИС_ДанныеПоШтрихкодамEAN(ШтрихкодыEAN.ВыгрузитьКолонку("ШтрихкодEAN"));
	
	Для каждого ДанныеПоШтрихкоду ИЗ ДанныеПоШтрихкодамEAN Цикл
		Если НЕ ДанныеПоШтрихкоду.ВидУпаковкиИС = ВидУпаковкиГрупп
			И НЕ ДанныеПоШтрихкоду.ВидУпаковкиИС = ВидУпаковкиНабор Тогда
		    Продолжить;
		КонецЕсли;
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ВидУпаковки", 	ДанныеПоШтрихкоду.ВидУпаковкиИС);
		СтруктураДанных.Вставить("Номенклатура", 	ДанныеПоШтрихкоду.Номенклатура);
		СтруктураДанных.Вставить("Характеристика", 	ДанныеПоШтрихкоду.Характеристика);
		СтруктураДанных.Вставить("Серия", 			ДанныеПоШтрихкоду.Серия);
		СтруктураДанных.Вставить("GTIN", 			ДанныеПоШтрихкоду.ШтрихкодEAN);
			
		Попытка
			СтруктураДанных.Вставить("КоличествоПотребительскихУпаковок", ДанныеПоШтрихкоду.ПлановоеКоличествоПотребительскихУпаковок);
		Исключение
			СтруктураДанных.Вставить("КоличествоПотребительскихУпаковок", 1);
		КонецПопытки;
			
		НайденныеСтроки = ШтрихкодыEAN.НайтиСтроки(Новый Структура("ШтрихкодEAN", ДанныеПоШтрихкоду.ШтрихкодEAN));
		Для каждого НайденнаяСтрока ИЗ НайденныеСтроки Цикл
			ДанныеGTIN.Вставить(НайденнаяСтрока.ШтрихкодКоробки, СтруктураДанных);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// см. ФормаУточненияДанныхИС.МассивЗначенийGTINДляВыбора
Функция ИСМП_ПолучитьДопустимыеЗначенияGTIN(СтрокаОСУ, ДопустимыеВидыУпаковок = Неопределено)
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Номенклатура",               СтрокаОСУ.Номенклатура);
	ПараметрыВыбора.Вставить("Характеристика",             СтрокаОСУ.Характеристика);
	ПараметрыВыбора.Вставить("ХарактеристикиИспользуются", ЗначениеЗаполнено(СтрокаОСУ.Характеристика));
	
	Если ДопустимыеВидыУпаковок = Неопределено Тогда
		ДопустимыеВидыУпаковок = Новый Массив;
		ДопустимыеВидыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская"));
		ДопустимыеВидыУпаковок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Набор"));
	КонецЕсли;
					
	Возврат ИО_ОбщийМодуль("ИнтеграцияИСМП").МассивЗначенийGTINДляВыбора(ПараметрыВыбора,,, ДопустимыеВидыУпаковок);	
	
КонецФункции

Процедура ИСМП_ЗаполнитьВыводИзОборотаДаннымиОСУ(ТаблицаМаркированнойПродукции, СтруктураПараметров)

	Док1СРезультат = СтруктураПараметров.Док1СРезультат;
	
	МетаданныеНСИ 		  = Конф_ПолучитьМетаданныеНСИ();
	ИмяРеквизитаБазоваяЕИ = Конф_ПолучитьМетаданныеНСИ().Номенклатура.БазоваяЕдиницаИзмерения.ИмяРеквизита;
	ИмяСправочникаЕИ	  = МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника;
	
	Док1СРезультат.ОбъемноСортовойУчет = Истина;
	
	КолонкиТаблицы = ТаблицаМаркированнойПродукции.Колонки;
	КолонкиТаблицы.Добавить("Упаковка", Метаданные.ОпределяемыеТипы.Упаковка.Тип);	
	Для каждого ТекСтрока ИЗ ТаблицаМаркированнойПродукции Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ПотребительскаяУпаковка) Тогда
			ТекСтрока.Упаковка = ТекСтрока.ПотребительскаяУпаковка;	
		Иначе	
			ТекСтрока.Упаковка = УТ_11_2_ПолучитьБазовуюУпаковкуНоменклатуры(ТекСтрока.Номенклатура);
		КонецЕсли;
		
		Если ТекСтрока.ПроизвольнаяЕдиницаУчета
			И НЕ ТекСтрока.ТребуетВзвешивания Тогда
			ТекСтрока.КоличествоУпаковок = ТекСтрока.КоличествоПотребительскихУпаковок;
		КонецЕсли;
	КонецЦикла;
	
	// Переносим загружаемые данные в табличную часть документа
	КолонкиДляСворачивания = Новый Массив;
	КолонкиДляСворачивания.Добавить("Номенклатура");
	КолонкиДляСворачивания.Добавить("Характеристика");
	КолонкиДляСворачивания.Добавить("Серия");
	КолонкиДляСворачивания.Добавить("Упаковка");
	КолонкиДляСворачивания.Добавить("GTIN");
	
	ИменаКолонокДляСворачивания = "";
	Для каждого ИмяКолонки ИЗ КолонкиДляСворачивания Цикл
		ИменаКолонокДляСворачивания = ИменаКолонокДляСворачивания + ?(ПустаяСтрока(ИменаКолонокДляСворачивания), "", ", ") + ИмяКолонки; 
	КонецЦикла;
	ТаблицаМаркированнойПродукции.Свернуть(ИменаКолонокДляСворачивания, "КоличествоУпаковок, КоличествоПотребительскихУпаковок");
	
	Док1СРезультат.Товары.Загрузить(ТаблицаМаркированнойПродукции);
	//
	
	// Заполняем служебные реквизиты табличной части
	СтруктураЗаполненияСтавкиНДС = УТ_11_4_СтруктураЗаполненияСтавкиНДС(СтруктураПараметров);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", СтруктураЗаполненияСтавкиНДС);
	
	Для каждого ТекущаяСтрока ИЗ Док1СРезультат.Товары Цикл
		ТекущаяСтрокаСтруктура = УТ_11_2_ПолучитьТекущуюСтрокуСтруктурой(ТекущаяСтрока, СтруктураДействий);
		
		// Для заполнения ставки НДС по дате отгрузки
		ТекущаяСтрокаСтруктура.Вставить("ДатаОтгрузки", Док1СРезультат.Дата);
		ИО_ОбщийМодуль("ОбработкаТабличнойЧастиСервер").ОбработатьСтрокуТЧ(ТекущаяСтрокаСтруктура, СтруктураДействий, Неопределено);
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекущаяСтрокаСтруктура);
	КонецЦикла;
	//
	
    // Пока сделаем принудительную запись в обработчике для корректного отображения реквизитов формы
	// Потом можно будет добавить функционал в обработчик ПослеОткрытияФормы
	Док1СРезультат.Записать();
		
	СтруктураПараметров.Вставить("ДокументЗаписанВОбработчике", Истина);
	//
	
КонецПроцедуры

Процедура МОТП_ДополнитьТаблицуПодобраннойТабачнойПродукции(ТаблицаМаркируемойПродукции, ДанныеДокумента, ПараметрыСканирования)
	
	Попытка
		//Выполнить("ПроверкаИПодборПродукцииИСМП.ДополнитьТаблицуПодобраннойМаркируемойПродукцииМОТП(ТаблицаМаркируемойПродукции, ДанныеДокумента, Перечисления.ВидыПродукцииИС.Табак, ПараметрыСканирования)");
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ДополнитьТаблицуПодобраннойМаркируемойПродукцииМОТП(ТаблицаМаркируемойПродукции, ДанныеДокумента, Перечисления.ВидыПродукцииИС.Табак, ПараметрыСканирования);
	Исключение
		//Выполнить("ПроверкаИПодборПродукцииИСМП.ДополнитьТаблицуПодобраннойМаркируемойПродукции(ТаблицаМаркируемойПродукции, ДанныеДокумента, Перечисления.ВидыПродукцииИС.Табак, ПараметрыСканирования)");
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМП").ДополнитьТаблицуПодобраннойМаркируемойПродукции(ТаблицаМаркируемойПродукции, ДанныеДокумента, Перечисления.ВидыПродукцииИС.Табак, ПараметрыСканирования);
	КонецПопытки;
	
КонецПроцедуры

Процедура МОТП_ЗаполнитьДеревоМаркированнойПродукции(ДеревоУпаковокДокумента, ДанныеДокумента, ПринудительноУстановитьДетализацию = Неопределено)
	
	ЕстьПеречислениеИС 	 = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено;
	ЕстьПеречислениеМОТП = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП") <> Неопределено;
	Если ЕстьПеречислениеИС Тогда
		ДетализацияПолная 					   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
		ДетализацияКоробаСГрупповымиУпаковками 		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
		ДетализацияПотребительскиеУпаковки 	   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки");
		ДетализацияГрупповыеУпаковкиСПотребительскими = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковкиСПотребительскими");	
	Иначе	
		ДетализацияПолная 					   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
		ДетализацияКоробаСГрупповымиУпаковками 		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.КоробкиСБлоками");
		ДетализацияПотребительскиеУпаковки 	   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Пачки");
		ДетализацияГрупповыеУпаковкиСПотребительскими = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.БлокиСПачками");	
	КонецЕсли;
	
	Если ПринудительноУстановитьДетализацию = Неопределено Тогда
		
		ДетализацияСтруктурыХраненияДанныхДокумента = ДетализацияСтруктурыХраненияДерева(ДеревоУпаковокДокумента);
		Если ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения <> Неопределено Тогда
			
			Если ДеревоУпаковокДокумента.Строки.Количество() = 0 Тогда
				ДанныеДокумента.ДетализацияСтруктурыХранения = ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения;
			ИначеЕсли ДетализацияСтруктурыХраненияДанныхДокумента = ДетализацияПолная
				И ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения = ДетализацияКоробаСГрупповымиУпаковками Тогда
				ДанныеДокумента.ДетализацияСтруктурыХранения = ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения;
			ИначеЕсли ДетализацияСтруктурыХраненияДанныхДокумента <> ДетализацияПотребительскиеУпаковки Тогда
				ДанныеДокумента.ДетализацияСтруктурыХранения = ДетализацияСтруктурыХраненияДанныхДокумента;
			Иначе
				ДанныеДокумента.ДетализацияСтруктурыХранения = ДанныеДокумента.СохраненнаяДетализацияСтруктурыХранения;
			КонецЕсли;
			
		Иначе
			
			ДанныеДокумента.ДетализацияСтруктурыХранения = ДетализацияСтруктурыХраненияДерева(ДеревоУпаковокДокумента);
			
		КонецЕсли;
		
	Иначе
		
		ДанныеДокумента.ДетализацияСтруктурыХранения = ПринудительноУстановитьДетализацию;
		
	КонецЕсли;
	
	СтрокаПачкиБезБлока = Неопределено;
	
	Если НЕ ДанныеДокумента.СтрокаПачкиБезБлока = Неопределено Тогда
		СтрокаПачкиБезБлока = ДанныеДокумента.СтрокаПачкиБезБлока;
	Иначе
	    Для Каждого СтрокаДереваМаркированнойПродукции Из ДанныеДокумента.ДеревоМаркированнойПродукции.Строки Цикл
			Если СтрокаДереваМаркированнойПродукции.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока") Тогда
				СтрокаПачкиБезБлока = СтрокаДереваМаркированнойПродукции;
				
				ДанныеДокумента.СтрокаПачкиБезБлока = СтрокаПачкиБезБлока;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	КоллекцияСтрокПриемника = ДанныеДокумента.ДеревоМаркированнойПродукции.Строки;
	
	Для Каждого СтрокаДереваУпаковок Из ДеревоУпаковокДокумента.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДереваУпаковок.Штрихкод) Тогда
			Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДереваУпаковок.ТипУпаковки) Тогда	
				НайденнаяСтрока = ДанныеДокумента.УпаковкиДокумента.НайтиПоЗначению(СтрокаДереваУпаковок.Штрихкод);
			Иначе
				НайденнаяСтрока = ДанныеДокумента.ДеревоМаркированнойПродукции.Строки.Найти(СтрокаДереваУпаковок.Штрихкод, "Штрихкод", Ложь);
				
				Если НайденнаяСтрока = Неопределено И НЕ СтрокаПачкиБезБлока = Неопределено Тогда
					НайденнаяСтрока = СтрокаПачкиБезБлока.Строки.Найти(СтрокаДереваУпаковок.Штрихкод, "Штрихкод", Ложь);
				КонецЕсли;	
			КонецЕсли;
				
			Если НЕ НайденнаяСтрока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаДереваУпаковок, КоллекцияСтрокПриемника, ДанныеДокумента);
		
	КонецЦикла;
	
	Если ДанныеДокумента.СтрокаПачкиБезБлока = Неопределено
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияПотребительскиеУпаковки Тогда
		ДобавленнаяСтрокаПачкиБезБлока(ДанныеДокумента);
	КонецЕсли;
	
	Если ДанныеДокумента.СтрокаБлокиБезКоробки = Неопределено
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияПотребительскиеУпаковки
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияГрупповыеУпаковкиСПотребительскими Тогда
		ДобавленнаяСтрокаБлокиБезКоробки(ДанныеДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаИсточника, КоллекцияСтрокПриемника, ДанныеДокумента)
	
	ИмяСобытия = "ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке";
	
	ЕстьПеречислениеИС 	 = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено;
	ЕстьПеречислениеМОТП = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП") <> Неопределено;
	Если ЕстьПеречислениеИС Тогда
		ДетализацияПолная 					   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
		ДетализацияКоробаСГрупповымиУпаковками 		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
		ДетализацияПотребительскиеУпаковки 	   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки");
		ДетализацияГрупповыеУпаковкиСПотребительскими = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковкиСПотребительскими");	
	Иначе	
		ДетализацияПолная 					   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
		ДетализацияКоробаСГрупповымиУпаковками 		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.КоробкиСБлоками");
		ДетализацияПотребительскиеУпаковки 	   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Пачки");
		ДетализацияГрупповыеУпаковкиСПотребительскими = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.БлокиСПачками");	
	КонецЕсли;
	
	ВидМаркируемойПродукции = ДанныеДокумента.ВидМаркируемойПродукции;
	
	Если СтрокаИсточника.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока") Тогда
		
		Если ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияПотребительскиеУпаковки Тогда
			
			НоваяСтрока = ДанныеДокумента.СтрокаПачкиБезБлока;
			
			Если НоваяСтрока = Неопределено Тогда
				НоваяСтрока = ДобавленнаяСтрокаПачкиБезБлока(ДанныеДокумента);
			КонецЕсли;
			
		Иначе
			
			Для Каждого СтрокаИсточникаПачка Из СтрокаИсточника.Строки Цикл
				ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаИсточникаПачка, КоллекцияСтрокПриемника, ДанныеДокумента);
			КонецЦикла;
			
			Возврат;
			
		КонецЕсли;
	
	ИначеЕсли СтрокаИсточника.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки") Тогда
		
		Если ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияПотребительскиеУпаковки
			И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияГрупповыеУпаковкиСПотребительскими Тогда
			
			НоваяСтрока = ДанныеДокумента.СтрокаБлокиБезКоробки;
			
			Если НоваяСтрока = Неопределено Тогда
				НоваяСтрока = ДобавленнаяСтрокаБлокиБезКоробки(ДанныеДокумента);
			КонецЕсли;
			
		Иначе

			Для Каждого СтрокаИсточникаБлок Из СтрокаИсточника.Строки Цикл
				Если ДанныеДокумента.ДетализацияСтруктурыХранения = ДетализацияГрупповыеУпаковкиСПотребительскими Тогда
					ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаИсточникаБлок, КоллекцияСтрокПриемника, ДанныеДокумента);
				Иначе
					Для Каждого СтрокаИсточникаПачка Из СтрокаИсточникаБлок.Строки Цикл
						ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(СтрокаИсточникаПачка, КоллекцияСтрокПриемника, ДанныеДокумента);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
			Возврат;

		КонецЕсли;
		
	ИначеЕсли СтрокаИсточника.Родитель = Неопределено
		И СтрокаИсточника.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияПотребительскиеУпаковки Тогда
			
		СтрокаПачкиБезБлока = ДанныеДокумента.СтрокаПачкиБезБлока;
		
		Если СтрокаПачкиБезБлока = Неопределено Тогда
			СтрокаПачкиБезБлока = ДобавленнаяСтрокаПачкиБезБлока(ДанныеДокумента);
		КонецЕсли;
		
		НоваяСтрока = СтрокаПачкиБезБлока.Строки.Добавить();
		НоваяСтрока.СтатусПроверки = ДанныеДокумента.НачальныйСтатусПроверки;
		
	ИначеЕсли СтрокаИсточника.Родитель = Неопределено
		И ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЭтоУпаковкаБлока(СтрокаИсточника)
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияПотребительскиеУпаковки
		И ДанныеДокумента.ДетализацияСтруктурыХранения <> ДетализацияГрупповыеУпаковкиСПотребительскими Тогда
			
		СтрокаБлокиБезКоробки = ДанныеДокумента.СтрокаБлокиБезКоробки;
		                                                                    
		Если СтрокаБлокиБезКоробки = Неопределено Тогда
			СтрокаБлокиБезКоробки = ДобавленнаяСтрокаБлокиБезКоробки(ДанныеДокумента);
		КонецЕсли;
		
		НоваяСтрока = СтрокаБлокиБезКоробки.Строки.Добавить();
		НоваяСтрока.СтатусПроверки = ДанныеДокумента.НачальныйСтатусПроверки;
		
	ИначеЕсли СтрокаИсточника.Родитель <> Неопределено
		И ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЭтоУпаковкаБлока(СтрокаИсточника.Родитель)
		И СтрокаИсточника.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
		И ДанныеДокумента.ДетализацияСтруктурыХранения = ДетализацияКоробаСГрупповымиУпаковками Тогда
		
		Возврат;
		
	Иначе
		
		НоваяСтрока = КоллекцияСтрокПриемника.Добавить();
		НоваяСтрока.СтатусПроверки = ДанныеДокумента.НачальныйСтатусПроверки;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	
	НоваяСтрока.СтатусКодаМаркировки = СтрокаИсточника.Статус;
	
	Если НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.ПустаяСсылка") Тогда
		НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка");
	ИначеЕсли НоваяСтрока.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар")
		И НЕ ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
		НоваяСтрока.ПредставлениеСодержимоеУпаковки = СтрокаИсточника.ПредставлениеНоменклатуры;
		НоваяСтрока.ПредставлениеСодержимогоДоСопоставления = СтрокаИсточника.ПредставлениеНоменклатуры;
	КонецЕсли;
	
	ЗаполненоКоличество = Истина;
	Попытка
		НоваяСтрока.КоличествоПодчиненныхПотребительскихУпаковок = СтрокаИсточника.КоличествоПотребительскихУпаковок;
	Исключение
		ЗаполненоКоличество = Ложь;
	КонецПопытки;
	Если НЕ ЗаполненоКоличество Тогда
		Попытка
			НоваяСтрока.КоличествоПодчиненныхПачек = СтрокаИсточника.КоличествоПачек;
		Исключение
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));			
		КонецПопытки;
	КонецЕсли;
	
	Если НоваяСтрока.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Групповая")
		И СтрокаИсточника.Строки.Количество() = 0 Тогда
		Попытка
			НоваяСтрока.НеПересчитыватьКоличествоПотребительскихУпаковок = Истина;
		Исключение
			НоваяСтрока.НеПересчитыватьКоличествоПачек = Истина;			
		КонецПопытки;
	КонецЕсли;
	
	Если НоваяСтрока.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая")
		И ЗначениеЗаполнено(НоваяСтрока.GTIN)
		И СтрокаИсточника.Строки.Количество() = 0 Тогда
		Попытка
			НоваяСтрока.НеПересчитыватьКоличествоПотребительскихУпаковок = Истина;
		Исключение
			НоваяСтрока.НеПересчитыватьКоличествоПачек = Истина;			
		КонецПопытки;
	КонецЕсли;
	
	КоллекцияСтрокНовойСтроки = НоваяСтрока.Строки;
	
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").УстановитьДоступностьУпаковкиДляПроверки(НоваяСтрока, ДанныеДокумента.ДоступныеДляПроверкиУпаковки);
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеДляСтрокиДереваМаркированнойПродукции(НоваяСтрока, ВидМаркируемойПродукции);
	Исключение
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииИСМПКлиентСервер").СформироватьПредставлениеДляСтрокиДереваМаркированнойПродукции(НоваяСтрока);
	КонецПопытки;
	ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ПроверитьДопустимостьКодаМаркировки(НоваяСтрока, ДанныеДокумента.ПараметрыПроверкиКодовМаркировки, ДанныеДокумента.РежимПодбораСуществующихУпаковок);
	
	Если НоваяСтрока.НедопустимыйКодМаркировки Тогда
		ДанныеДокумента.КоличествоНедопустимыхКодовМаркировки = ДанныеДокумента.КоличествоНедопустимыхКодовМаркировки + 1;
	КонецЕсли;
	
	Если НоваяСтрока.СодержимоеНедоступно Тогда
		ДанныеДокумента.СодержимоеУпаковокНедоступно = Истина;
	КонецЕсли;
	
	Если ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(НоваяСтрока.ТипУпаковки) Тогда
		ДанныеДокумента.УпаковкиДокумента.Добавить(НоваяСтрока.Штрихкод);
	КонецЕсли;
	
	Для Каждого ПодчиненнаяСтрокаИсточника Из СтрокаИсточника.Строки Цикл
		ДобавитьСтрокуДереваМаркированнойПродукцииПриЗагрузке(ПодчиненнаяСтрокаИсточника, КоллекцияСтрокНовойСтроки, ДанныеДокумента);
	КонецЦикла;

КонецПроцедуры

Функция ДобавленнаяСтрокаПачкиБезБлока(ДанныеДокумента)
	
	НоваяСтрока = ДанныеДокумента.ДеревоМаркированнойПродукции.Строки.Вставить(0);
	
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЗаполнитьСтрокуПачкиБезБлока(НоваяСтрока, ДанныеДокумента.ВидМаркируемойПродукции);
	Исключение
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЗаполнитьСтрокуПачкиБезБлока(НоваяСтрока);		
	КонецПопытки;
	
	ДанныеДокумента.СтрокаПачкиБезБлока = НоваяСтрока;
	
	Возврат НоваяСтрока;

КонецФункции

Функция ДобавленнаяСтрокаБлокиБезКоробки(ДанныеДокумента)
	
	СтрокиДерева = ДанныеДокумента.ДеревоМаркированнойПродукции.Строки;
	
	Если СтрокиДерева.Количество() = 0 Тогда
		НоваяСтрока = СтрокиДерева.Вставить(0);
	ИначеЕсли СтрокиДерева[0].ТипУпаковки <> ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока") Тогда
		НоваяСтрока = СтрокиДерева.Вставить(0);
	Иначе
		НоваяСтрока = СтрокиДерева.Вставить(1);
	КонецЕсли;
	
	Попытка
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЗаполнитьСтрокуБлокиБезКоробки(НоваяСтрока, ДанныеДокумента.ВидМаркируемойПродукции);
	Исключение
		ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЗаполнитьСтрокуБлокиБезКоробки(НоваяСтрока);		
	КонецПопытки;
	
	ДанныеДокумента.СтрокаБлокиБезКоробки = НоваяСтрока;
	
	Возврат НоваяСтрока;

КонецФункции

Функция ДетализацияСтруктурыХраненияДерева(ДеревоУпаковок) Экспорт
	
	ЕстьПеречислениеИС 	 = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") <> Неопределено;
	ЕстьПеречислениеМОТП = Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП") <> Неопределено;
	Если ЕстьПеречислениеИС Тогда
		ДетализацияПолная 					   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
		ДетализацияКоробаСГрупповымиУпаковками 		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
		ДетализацияПотребительскиеУпаковки 	   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки");
		ДетализацияГрупповыеУпаковкиСПотребительскими = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковкиСПотребительскими");	
	Иначе	
		ДетализацияПолная 					   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная");
		ДетализацияКоробаСГрупповымиУпаковками 		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.КоробкиСБлоками");
		ДетализацияПотребительскиеУпаковки 	   		  = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Пачки");
		ДетализацияГрупповыеУпаковкиСПотребительскими = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.БлокиСПачками");	
	КонецЕсли;
	
	УпаковкиДерева = Новый Структура;
	УпаковкиДерева.Вставить("ЕстьПачки",           Ложь);
	УпаковкиДерева.Вставить("ЕстьБлоки",           Ложь);
	УпаковкиДерева.Вставить("ЕстьКоробки",         Ложь);
	УпаковкиДерева.Вставить("ЕстьПалеты",          Ложь);
	УпаковкиДерева.Вставить("ЕстьПачкиБезБлока",   Ложь);
	УпаковкиДерева.Вставить("ЕстьБлокиБезКоробки", Ложь);
	
	РазрешеныПачкиВКоробках = Истина;
	
	Если ТипЗнч(ДеревоУпаковок) = Тип("ДеревоЗначений") Тогда
		СтрокиДерева = ДеревоУпаковок.Строки;
	Иначе
		СтрокиДерева = Новый Массив;
		СтрокиДерева.Добавить(ДеревоУпаковок);
	КонецЕсли;
	
	ОпределитьНаличиеУпаковокВСтрокахДерева(СтрокиДерева, УпаковкиДерева, РазрешеныПачкиВКоробках);
	
	Если УпаковкиДерева.ЕстьКоробки Тогда
		Если УпаковкиДерева.ЕстьБлоки И УпаковкиДерева.ЕстьПачки Тогда
			ДетализацияСтруктурыХраненияДерева = ДетализацияПолная;
		ИначеЕсли УпаковкиДерева.ЕстьБлоки Тогда
			ДетализацияСтруктурыХраненияДерева = ДетализацияКоробаСГрупповымиУпаковками;
		Иначе
			ДетализацияСтруктурыХраненияДерева = ДетализацияПолная;
		КонецЕсли;
	ИначеЕсли УпаковкиДерева.ЕстьБлоки Тогда
		ДетализацияСтруктурыХраненияДерева = ДетализацияГрупповыеУпаковкиСПотребительскими;
	ИначеЕсли УпаковкиДерева.ЕстьПачки Тогда
		ДетализацияСтруктурыХраненияДерева = ДетализацияПотребительскиеУпаковки;
	ИначеЕсли УпаковкиДерева.ЕстьБлокиБезКоробки Тогда
		ДетализацияСтруктурыХраненияДерева = ДетализацияКоробаСГрупповымиУпаковками;
	ИначеЕсли УпаковкиДерева.ЕстьПачкиБезБлока Тогда
		ДетализацияСтруктурыХраненияДерева = ДетализацияГрупповыеУпаковкиСПотребительскими;
	Иначе
		ДетализацияСтруктурыХраненияДерева = ДетализацияПотребительскиеУпаковки;
	КонецЕсли;
	
	Возврат ДетализацияСтруктурыХраненияДерева;
	
КонецФункции

Процедура ОпределитьНаличиеУпаковокВСтрокахДерева(СтрокиДерева, УпаковкиДерева, РазрешеныПачкиВКоробках)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если УпаковкиДерева.ЕстьПачки И НЕ РазрешеныПачкиВКоробках Тогда
			Прервать;
		ИначеЕсли СтрокаДерева.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МаркированныйТовар") Тогда
			Если СтрокаДерева.Родитель <> Неопределено
				И СтрокаДерева.Родитель.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.ПачкиБезБлока") Тогда
				УпаковкиДерева.ЕстьПачкиБезБлока = Истина;
			Иначе
				УпаковкиДерева.ЕстьПачки = Истина;
				Если НЕ РазрешеныПачкиВКоробках Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Если Вычислить("ПроверкаИПодборПродукцииМОТПКлиентСервер.ЭтоУпаковкаБлока(СтрокаДерева)") Тогда
		Если ИО_ОбщийМодуль("ПроверкаИПодборПродукцииМОТПКлиентСервер").ЭтоУпаковкаБлока(СтрокаДерева) Тогда
			Если СтрокаДерева.Родитель <> Неопределено
				И СтрокаДерева.Родитель.ТипУпаковки = ПредопределенноеЗначение("Перечисление.ПрочиеЗоныПересчетаПродукцииИСМП.БлокиБезКоробки") Тогда
				УпаковкиДерева.ЕстьБлокиБезКоробки = Истина;
			Иначе
				УпаковкиДерева.ЕстьБлоки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ УпаковкиДерева.ЕстьКоробки Тогда
			//УпаковкиДерева.ЕстьКоробки = Вычислить("ИнтеграцияИСКлиентСервер.ЭтоУпаковка(СтрокаДерева.ТипУпаковки)");
			УпаковкиДерева.ЕстьКоробки = ИО_ОбщийМодуль("ИнтеграцияИСКлиентСервер").ЭтоУпаковка(СтрокаДерева.ТипУпаковки);
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			ОпределитьНаличиеУпаковокВСтрокахДерева(СтрокаДерева.Строки, УпаковкиДерева, РазрешеныПачкиВКоробках);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СохраненнаяДетализацияСтруктурыХранения(РежимПодбораСуществующихУпаковок) Экспорт
	
	СохраненнаяДетализация = Неопределено;
	//СохраненныеНастройки   = Вычислить("ОбщегоНазначения.ХранилищеНастроекДанныхФормЗагрузить(""Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор"", """")");
	СохраненныеНастройки   = ОбщегоНазначения.ХранилищеНастроекДанныхФормЗагрузить("Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор", "");
	
	Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
		Если РежимПодбораСуществующихУпаковок
			И СохраненныеНастройки.Свойство("ДетализацияСтруктурыХранения") Тогда
			СохраненнаяДетализация = СохраненныеНастройки.ДетализацияСтруктурыХранения;
		ИначеЕсли Не РежимПодбораСуществующихУпаковок
			И СохраненныеНастройки.Свойство("ДетализацияСтруктурыХраненияПриобретение") Тогда
			СохраненнаяДетализация = СохраненныеНастройки.ДетализацияСтруктурыХраненияПриобретение;
		ИначеЕсли СохраненныеНастройки.Свойство("ДетализацияСтруктурыХранения") Тогда
			СохраненнаяДетализация = СохраненныеНастройки.ДетализацияСтруктурыХранения;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДетализацияСтруктурыХраненияИС(СохраненнаяДетализация);
	
КонецФункции

Функция ДетализацияСтруктурыХраненияИС(ДетализацияСтруктурыХранения) Экспорт
	
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияИС") = Неопределено Тогда
		Возврат ДетализацияСтруктурыХранения;
	КонецЕсли;
	Если Метаданные.Перечисления.Найти("ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП") = Неопределено Тогда
		Возврат ДетализацияСтруктурыХранения;
	КонецЕсли;
	
	Если ТипЗнч(ДетализацияСтруктурыХранения) = Тип("ПеречислениеСсылка.ДетализацияСтруктурыХраненияИС") Тогда
		Возврат ДетализацияСтруктурыХранения;
	КонецЕсли;
	
	НоваяДетализация = Неопределено;
	
	Если ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Полная") Тогда
		НоваяДетализация =  ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.Полная");
	ИначеЕсли ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.БлокиСПачками") Тогда
		НоваяДетализация =  ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ГрупповыеУпаковкиСПотребительскими");
	ИначеЕсли ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Коробки") Тогда
		НоваяДетализация =  ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПалетыСМонотоварнымиКоробами");
	ИначеЕсли ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.КоробкиСБлоками") Тогда
		НоваяДетализация =  ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.КоробаСГрупповымиУпаковками");
	ИначеЕсли ДетализацияСтруктурыХранения = ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияТабачнойПродукцииМОТП.Пачки") Тогда
		НоваяДетализация =  ПредопределенноеЗначение("Перечисление.ДетализацияСтруктурыХраненияИС.ПотребительскиеУпаковки");
	КонецЕсли;
	
	Возврат НоваяДетализация;
	
КонецФункции

