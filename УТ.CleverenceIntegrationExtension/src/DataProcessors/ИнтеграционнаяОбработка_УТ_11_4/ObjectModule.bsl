		ДанныеДляВыгрузки_Строка.Вставить("Марка",						СтрокаТЧ.ШтрихкодБлока);		
		ДанныеДляВыгрузки_Строка.Вставить("Маркировка",					"Табак");		
		
		// Поля ИдТовара(ProductId) и ИдУпаковки(PackingId) обязательно должны быть заполнены,
		// поэтому дополнительно проверяем и, если нужно, дозаполняем их значениями по умолчанию
		
		Если НЕ ЗначениеЗаполнено(ДанныеДляВыгрузки_Строка.ИдУпаковки) Тогда
