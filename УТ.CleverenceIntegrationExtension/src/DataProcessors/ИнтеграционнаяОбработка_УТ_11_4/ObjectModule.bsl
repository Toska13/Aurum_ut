		ТекстОшибки = Строка(Док1СРезультат) + ": возникли ошибки при проверке отсканированных кодов маркировки в сервисе ГИС МТ. См. данные проверки и подбора!";
		Сообщить(ТекстОшибки);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("УТ_11_4_ПроверитьТабачнуюПродукциюИСМПСЗапросомДанных", "Ошибка", ТекстОшибки);
