#Область ПолучениеДанныхКМизЧЗОнлайн

Функция ПолучениеДанныхКМИзЧЗ(КМ) Экспорт	
		
	ТаблицаОтвета = ПустаяТаблицаРезультатаЗапросаВЧЗ();	
	
	Организация = Неопределено; // Надо придумать как сюда подцепить организцию из ГП
	МассивКМ = Новый Массив;	// Сделаем заранее возможность запрашивать информацию по нескольким КМ
	Если ТипЗнч(КМ) = Тип("Строка") Тогда
		Если ГлЯдро_СтрНайти(КМ,"; ")>0 Тогда
			МассивКМ = РазложитьСтрокуВМассивПодстрок(КМ,"; ");
		Иначе
			МассивКМ.Добавить(КМ);
		КонецЕсли;
	ИначеЕсли ТипЗнч(КМ) = Тип("Соответствие")
		И КМ.Получить("$values") <> Неопределено Тогда
		МассивКМ = КМ.Получить("$values");
	ИначеЕсли ТипЗнч(КМ) = Тип("Массив") Тогда		
		МассивКМ = КМ;
	КонецЕсли;
	
	СтруктураРезультата = ЗапроситьИнформациюОМарках(МассивКМ,Истина,Организация);
	
	Если ЗначениеЗаполнено(СтруктураРезультата.ТекстОшибки) Тогда
		СтрокаОтвета = ТаблицаОтвета.Добавить();				
		ЗаполнитьЗначенияСвойств(СтрокаОтвета,СтруктураРезультата);
	Иначе
		СтатусыКМ = СтруктураРезультата.Данные;
	   	КолонкиТЗ = ТаблицаОтвета.Колонки;
		Если СтатусыКМ <> Неопределено Тогда
			Для Каждого КлючИЗначение Из СтатусыКМ Цикл
				ДанныеЧЗ = КлючИЗначение.Значение;
				Марка 	 = КлючИЗначение.Ключ.НормализованныйШтрихкод;
				
				СтрокаОтвета = ТаблицаОтвета.Добавить();
				
				//Для Каждого КолонкаОтвета Из КолонкиТЗ Цикл
				//	ИмяКолонки = КолонкаОтвета.Имя;
				//	Если ДанныеЧЗ.Свойство(ИмяКолонки) Тогда
				//		Значение = ДанныеЧЗ[ИмяКолонки];
				//		Если ТипЗнч(Значение) = Тип("Дата") Тогда
				//			СтрокаОтвета[ИмяКолонки] = Значение;
				//		Иначе
				//			СтрокаОтвета[ИмяКолонки] = Строка(Значение);
				//		КонецЕсли;					
				//	Иначе
				//		СтрокаОтвета[ИмяКолонки] = "";
				//	КонецЕсли;
				//КонецЦикла;
				
				Для каждого СтрокаДанных ИЗ ДанныеЧЗ Цикл
					Значение = СтрокаДанных.Значение;
					Если ЭтоКоллекция(Значение) Тогда
						Продолжить;
					КонецЕсли;
					
					ИмяКолонки = СтрокаДанных.Ключ;
					Если КолонкиТЗ.Найти(ИмяКолонки) = Неопределено Тогда
						НоваяКолонка = КолонкиТЗ.Добавить(ИмяКолонки);
					КонецЕсли;
					
					Если ТипЗнч(Значение) = Тип("Дата") Тогда
						СтрокаОтвета[ИмяКолонки] = Значение;
					Иначе
						СтрокаОтвета[ИмяКолонки] = Строка(Значение);
					КонецЕсли;
				КонецЦикла;
				
				СтрокаОтвета.Марка = Марка;
				Если СтрокаОтвета.Статус = "Неопределен" Тогда
					СтрокаОтвета.ТекстОшибки = "Нет информации в Честном знаке";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаОтвета;
КонецФункции

Функция ЗапроситьИнформациюОМарках(МассивМарок, ВозвращатьРазвернутыйРезультат = Ложь, Организация = Неопределено) Экспорт
	
	ИмяСобытия = "ЗапроситьИнформациюОМарках";
	
	СтруктураРезультата = Новый Структура("ТекстОшибки,КодОшибки,Данные", "","");
	
	ПолученаТаблицаКМ = Ложь;
	Попытка
		ДанныеШтрихкодовСписок = Новый Массив;
		Для каждого КМ ИЗ МассивМарок Цикл
			СтруктураКМ = Новый Структура;
			СтруктураКМ.Вставить("Штрихкод",	КМ);
			СтруктураКМ.Вставить("Количество", 	1);
			ДанныеШтрихкодовСписок.Добавить(СтруктураКМ);
		КонецЦикла;
		
		СтруктураКонтекста = Новый Структура;
		СтруктураКонтекста.Вставить("ИмяФормы",		"Обработка.ПроверкаКодовМаркировкиИСМП");
		СтруктураКонтекста.Вставить("Организация",	Организация);
		СтруктураКонтекста.Вставить("Ссылка", 		Неопределено); // Для совместимости со старыми релизами
		
		ПараметрыСканирования = ШтрихкодированиеИС_ПараметрыСканирования(СтруктураКонтекста);
		ПараметрыСканирования.Вставить("ТолькоМаркируемаяПродукция",			Истина);
		ПараметрыСканирования.Вставить("ОпределениеВидаПродукцииИСМП",			Истина);
		ПараметрыСканирования.Вставить("КонтрольУникальностиКодовМаркировки",	Ложь);
		ПараметрыСканирования.Вставить("Организация",							Организация);
		ПараметрыСканирования.Вставить("ДопустимыеВидыПродукции",				ИнтеграцияИСКлиентСервер_ВидыПродукцииИСМП(Истина));
		
		// Для совместимости со старыми релизами
		Если НЕ ПараметрыСканирования.Свойство("ЭтоПроверкаКодовМаркировкиИСМП") Тогда
			ПараметрыСканирования.Вставить("ЭтоПроверкаКодовМаркировкиИСМП", Истина);
		КонецЕсли;
		Если НЕ ПараметрыСканирования.Свойство("ЭтоОтчетПроизводственнойЛинии") Тогда
			ПараметрыСканирования.Вставить("ЭтоОтчетПроизводственнойЛинии", Ложь);
		КонецЕсли;
		
		ДанныеПоШтрихкодам = ШтрихкодированиеИС_ИнициализацияДанныхПоШтрихкодам(Ложь);
		ШтрихкодированиеИС_ПодготовитьДанныеКодовМаркировкиДляОбработки(
			ДанныеПоШтрихкодам, ДанныеШтрихкодовСписок, ПараметрыСканирования);
		
		ТаблицаКМ = ДанныеПоШтрихкодам.ДанныеКодовМаркировки;
		
    	ПолученаТаблицаКМ = Истина;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если НЕ ПолученаТаблицаКМ Тогда
		ТаблицаКМ = ШтрихкодированиеИС_ИнициализацияТаблицыДанныхКодовМаркировки();	
		Для Каждого Строка из МассивМарок Цикл
			Попытка
				СтруктураКМ = ШтрихкодированиеИС_НоваяСтруктураОбработкиШтрихкода(СокрЛП(Строка));			
			Исключение
				СтруктураРезультата.ТекстОшибки = "Не удалось разобрать марку: "+Строка;
				СтруктураРезультата.КодОшибки = "#ONLEX011";
				Возврат СтруктураРезультата;			
			КонецПопытки;		
			
			НС = ТаблицаКМ.Добавить();
			ЗаполнитьЗначенияСвойств(НС,СтруктураКМ);		
		КонецЦикла;
	КонецЕсли;
	
	// Функция ИнтерфейсИСМП.СтатусыКодовМаркировки() требует во входящем параметре массив строк, 
	// поэтому формируем его из подготовленной таблицы
	МассивКМ = Новый Массив;	
	Для Каждого СтрокаТЧ из ТаблицаКМ Цикл
		МассивКМ.Добавить(СтрокаТЧ);
	КонецЦикла;
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Прим. Метод не работает для табачной продукции, при необходимости нужно доработать
	РезультатЗапроса = ИО_ОбщийМодуль("ИнтерфейсИСМП").СтатусыКодовМаркировки(МассивКМ,Организация);
	
	ВремяОбращения = ТекущаяУниверсальнаяДатаВМиллисекундах()- НачалоЗамера;	
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", "Время обращения в ЧЗ: "+Строка(ВремяОбращения)+" мс.","Полный");
	
	Если РезультатЗапроса.ТребуетсяОбновлениеКлючаСессии Тогда
		СтруктураРезультата.ТекстОшибки = "Требуется обновить ключ сессии";
		СтруктураРезультата.КодОшибки = "#ONLEX012";
	Иначе 
		РезультатОтправкиЗапроса = РезультатЗапроса.РезультатОтправкиЗапроса;
		Если РезультатОтправкиЗапроса <> Неопределено Тогда
			КодОтвета = РезультатОтправкиЗапроса.КодСостояния;
			Если КодОтвета <> 200 Тогда 
				СтруктураРезультата.ТекстОшибки = РезультатОтправкиЗапроса.ТекстОшибки;
				СтруктураРезультата.КодОшибки = "#ONLEX01x";
				Возврат СтруктураРезультата;
			КонецЕсли;
		КонецЕсли;
		Если РезультатЗапроса.СтатусыКодовМаркировки = Неопределено Тогда
			СтруктураРезультата.ТекстОшибки = "Данные из ЧЗ не получены";
			СтруктураРезультата.КодОшибки = "#ONLEX013";
			Возврат СтруктураРезультата;
		КонецЕсли;
		
		СтруктураРезультата.Вставить("Данные", РезультатЗапроса.СтатусыКодовМаркировки);
				
	КонецЕсли;
		
	Возврат СтруктураРезультата; 
	
КонецФункции

