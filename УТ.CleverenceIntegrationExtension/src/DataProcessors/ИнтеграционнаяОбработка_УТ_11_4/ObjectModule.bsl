//		* СтрокаНастройки - Структура                   - содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено      - содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - ТаблицаЗначений                          - содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура                - содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_РасходныйОрдерНаТовары_ПослеЗаполненияТЧ_ОтгружаемыеТовары		(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПослеЗаполненияТЧ(СтруктураПараметров);
	
	Док1СРезультат 	= СтруктураПараметров.Док1СРезультат;
	Док1СОснование 	= СтруктураПараметров.Док1СОснование;
	ТабличнаяЧасть	= СтруктураПараметров.ТЧ;
	
	КолонкиТЧ 		 = Неопределено;
	НазначениеЗаказа = ПредопределенноеЗначение("Справочник.Назначения.ПустаяСсылка");
	
	ЕстьДокументОснование = Док1СОснование <> Неопределено И Док1СОснование <> Док1СРезультат;
	Если ЕстьДокументОснование Тогда
		КолонкиТЧ = Док1СОснование.Товары.ВыгрузитьКолонки().Колонки;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
			|ВЫБРАТЬ
			|	Назначения.Ссылка КАК Ссылка	
			|ИЗ
			|	Справочник.Назначения КАК Назначения
			|ГДЕ
			|	Назначения.Заказ = &Заказ";
		Запрос.УстановитьПараметр("Заказ", Док1СОснование);
		
		УстановитьПривилегированныйРежим(Истина);
		Выборка = Запрос.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Выборка.Следующий() Тогда
			НазначениеЗаказа = Выборка.Ссылка;
		КонецЕсли;	
	КонецЕсли;
	
	Для каждого ТекущаяСтрока ИЗ ТабличнаяЧасть Цикл
		Если ТекущаяСтрока.Действие.Пустая() Тогда
			ТекущаяСтрока.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
		КонецЕсли;
	
		Если ТекущаяСтрока.Серия <> Справочники.СерииНоменклатуры.ПустаяСсылка() Тогда
			ТекущаяСтрока.СтатусУказанияСерий = 2;
		КонецЕсли;
		
		Если ЕстьДокументОснование Тогда
			Если ЕстьРеквизитВКоллекции(КолонкиТЧ, "ВариантОбеспечения") Тогда
				НайденныеСтрокиВЗаказе = Док1СОснование.Товары.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",ТекущаяСтрока.Номенклатура,ТекущаяСтрока.Характеристика));
				Если НайденныеСтрокиВЗаказе.Количество()>0 Тогда
					НайденнаяСтрока = НайденныеСтрокиВЗаказе[0];
					
					Если ЕстьРеквизитВКоллекции(КолонкиТЧ, "Обособленно") Тогда
						ОформитьОбособленно = НайденнаяСтрока.Обособленно;
					Иначе
						Попытка
							ОформитьОбособленно = НайденнаяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно
								ИЛИ НайденнаяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
						Исключение
							ОформитьОбособленно = Ложь;
						КонецПопытки;
					КонецЕсли;
					
	                Если ОформитьОбособленно Тогда
						ТекущаяСтрока.Назначение = НазначениеЗаказа;
					КонецЕсли;
				КонецЕсли;
				// План Б по заполнению Назначения для БП "ЗаказКлиента -> РО"
				Если Не ЗначениеЗаполнено(ТекущаяСтрока.Назначение) 
					И ТипЗнч(Док1СОснование) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
					НайденныеСтрокиВТПР = Док1СРезультат.ТоварыПоРаспоряжениям.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",ТекущаяСтрока.Номенклатура,ТекущаяСтрока.Характеристика));
					Если НайденныеСтрокиВТПР.Количество()>0 Тогда
						НайденнаяСтрока = НайденныеСтрокиВТПР[0];
						ТекущаяСтрока.Назначение = НайденнаяСтрока.Назначение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ИО_ЭтоНужныйОрдер(Ордер, СтруктураПараметров)
    #Если Сервер И Не Сервер Тогда
        Ордер = Документы.РасходныйОрдерНаТовары.ПустаяСсылка();
    #КонецЕсли
    
    СтрокиФакт = СтруктураПараметров.ДанныеДокументаMS.СтрокиФакт;
    
    Товары = Ордер.ОтгружаемыеТовары;
    
    НоменклатураСоответствует = Истина;
    Для Каждого СтрокаФакт Из СтрокиФакт Цикл
    	Если СтрокаФакт.Свойство("ЭтоТаблицаЗначений") И СтрокаФакт.ЭтоТаблицаЗначений Тогда Продолжить; КонецЕсли;
    	
    	НоменклатураТСД = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаФакт.ИдТовара));
    	
    	Если СсылкаСуществует(НоменклатураТСД) И Товары.Найти(НоменклатураТСД, "Номенклатура") = Неопределено Тогда
    		НоменклатураСоответствует = Ложь;
    		Прервать;
    	КонецЕсли;	
        
    КонецЦикла;    
    
    Возврат НоменклатураСоответствует;
КонецФункции

#КонецОбласти

#Область УТ_11_2_ОтборРазмещениеТоваров

#Область ШапкаИФормаДокумента

// Вызывается при загрузке документа ОтборРазмещениеТоваров из базы Mobile Smarts
// Выполняет обработку документа 1С перед заполнением его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ОтборРазмещениеТоваров_ПередЗаполнениемДокумента		(СтруктураПараметров) Экспорт

	УТ_11_2_Общий_ПередЗаполнениемДокумента(СтруктураПараметров);
	
КонецПроцедуры 

// Вызывается при загрузке документа ОтборРазмещениеТоваров из базы Mobile Smarts
// Выполняет обработку документа 1С после заполнения его данными документа Mobile Smarts
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* АдресаПеременных - Структура 					- содержит адреса переменных, содержащих текущие настройки подключения Mobile Smarts
//		* ДанныеДляЗагрузки_Строка - Неопределено 		- содержит данные для загрузки строки табличной части
//		* ДанныеДокументаMS - Структура 				- содержит данные документа Mobile Smarts
//		* Док1СОснование - Неопределено, ДокументОбъект - документ-основание загружаемого документа 1С
//		* Док1СРезультат - ДокументОбъект 				- загружаемый документ 1С
//		* ДокументТСД - Структура 						- содержит данные документа Mobile Smarts
//		* СтрокаДокумента - Неопределено 				- данные загружаемой строки документа 1С
//		* СтрокаНастройки - Структура 					- содержит настройку бизнес-процесса
//		* СтруктураПоискаКлючаСвязи - Неопределено 		- содержит структуру поиска ключа связи загружаемой строки
//		* ТЧ - Неопределено 							- содержит данные загружаемой табличной части документа 1С
//		* ТекущиеНастройкиMS - Структура 				- содержит текущие настройки подключения Mobile Smarts
Процедура УТ_11_2_ОтборРазмещениеТоваров_ПослеЗаполненияДокумента		(СтруктураПараметров) Экспорт
	
	Док1СОснование		= СтруктураПараметров.Док1СОснование;
	Док1СРезультат 		= СтруктураПараметров.Док1СРезультат;
	ТоварыОтбор			= Док1СРезультат.ТоварыОтбор;
	ТоварыРазмещение	= Док1СРезультат.ТоварыРазмещение;
	ШапкаДокументаТСД 	= СтруктураПараметров.ДокументТСД.ШапкаДокумента;
	НастройкаБП 		= СтруктураПараметров.СтрокаНастройки;
	
	Если Док1СОснование <> Неопределено
		И ЗначениеЗаполнено(Док1СОснование.Ссылка)
		И ТипЗнч(Док1СОснование.Ссылка) = Тип("ДокументСсылка.РасходныйОрдерНаТовары")
		И Док1СРезультат.Распоряжение <> Док1СОснование.Ссылка Тогда
		Док1СРезультат.Распоряжение = Док1СОснование.Ссылка;
	ИначеЕсли Док1СОснование <> Неопределено
    	И ЗначениеЗаполнено(Док1СОснование.Ссылка)
	    И ТипЗнч(Док1СОснование.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
    	И Док1СРезультат.Распоряжение <> Док1СОснование.Ссылка Тогда   
	    Док1СРезультат.Распоряжение = ПолучитьСсылкуРасходныйОрдерНаТовары(Док1СОснование.Ссылка);
	КонецЕсли;
	
	УТ_11_2_Общий_ПослеЗаполненияДокумента(СтруктураПараметров);	
	
	Если Док1СРезультат.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Отбор И НЕ ЗначениеЗаполнено(Док1СРезультат.ЗонаОтгрузки) Тогда
		Док1СРезультат.ЗонаОтгрузки = Справочники.СкладскиеЯчейки.ЗонаОтгрузкиПоУмолчанию(Док1СРезультат.Склад, Док1СРезультат.Помещение);
	ИначеЕсли Док1СРезультат.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Размещение И НЕ ЗначениеЗаполнено(Док1СРезультат.ЗонаПриемки) Тогда
		Док1СРезультат.ЗонаПриемки = Справочники.СкладскиеЯчейки.ЗонаПриемкиПоУмолчанию(Док1СРезультат.Склад, Док1СРезультат.Помещение);
	КонецЕсли;
	
	ВосстанавливатьТЧ = Ложь;
	ОшибкаПроведения = Ложь;
	
	Если НастройкаБП.Свойство("ПроводитьДокументПослеЗагрузки") 
		И НастройкаБП.ПроводитьДокументПослеЗагрузки = Истина Тогда
		
		//В случае ошибки выполнения УТ_11_2_ОтборРазмещениеТоваров_ПередЗаполнениемДокумента произойдет отмена загрузки документа
		СтруктураПараметров.Вставить("КритическаяОшибка",Истина); 
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание","Ошибка проведения ОтборРазмещениеТоваров в статусе Подготовлено!");
		
		Если Док1СРезультат.ЭтоНовый() Тогда
			
			Док1СРезультат.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;
			ВосстанавливатьТЧ = Истина;
			
		Иначе	
			
			Если НЕ Док1СРезультат.Проведен = Истина Тогда
				Если НЕ (Док1СРезультат.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено
					ИЛИ Док1СРезультат.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВРаботе) Тогда	
					Док1СРезультат.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;					
				КонецЕсли;
				ВосстанавливатьТЧ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// Для восстановления загруженных серий после проведения документа в статусе, не предполагающем указания серий
		Если ВосстанавливатьТЧ Тогда
			ТЧО = ТоварыОтбор.Выгрузить();
			ТЧР = ТоварыРазмещение.Выгрузить();
			Попытка
				Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ОшибкаПроведения = Истина;
			КонецПопытки;
		КонецЕсли;
		
		СтруктураПараметров.Вставить("КритическаяОшибка",Ложь);
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание","");

	КонецЕсли;
	
	Если Док1СРезультат.ЭтоНовый() или ОшибкаПроведения Тогда
		ИтоговыйСтатус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;
	Иначе		
		ИтоговыйСтатус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
	КонецЕсли;
	
	ДокументТСДВыполненСОшибками = Ложь;
	Если СтруктураПараметров.СтрокаНастройки.ЗагружатьВТотЖе Тогда
		Если ШапкаДокументаТСД.Свойство("Underloaded") И ШапкаДокументаТСД.Underloaded = Истина
			ИЛИ ШапкаДокументаТСД.Свойство("Overloaded") И ШапкаДокументаТСД.Overloaded = Истина
			ИЛИ ШапкаДокументаТСД.Свойство("ЕстьНедобор") И ШапкаДокументаТСД.ЕстьНедобор = Истина
			ИЛИ ШапкаДокументаТСД.Свойство("ЕстьПереполнение") И ШапкаДокументаТСД.ЕстьПереполнение = Истина
			ИЛИ УТ_11_5_ОтборРазмещениеТоваров_ЕстьРасхождения(Док1СРезультат) Тогда
			ДокументТСДВыполненСОшибками = Истина;
		КонецЕсли;
	КонецЕсли;
	
	//Если НЕ ШапкаДокументаТСД.СозданНаТСД И ДокументТСДВыполненСОшибками Тогда
	//	ИтоговыйСтатус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками;
	//КонецЕсли;
	
	// Восстановление загруженных серий после проведения документа в статусе, не предполагающем указания серий
	Если ВосстанавливатьТЧ Тогда
        ТоварыОтбор.Загрузить(ТЧО);
		ТоварыРазмещение.Загрузить(ТЧР);
	КонецЕсли;
	
	Док1СРезультат.Статус = ИтоговыйСтатус;
	
	// Поле "Серия" зависит от поля СтатусУказанияСерий
	Если ТипЗнч(Док1СРезультат) = Тип("ДокументОбъект.ОтборРазмещениеТоваров") Тогда 
		
		СтрокиТоваровДляОбработки = Неопределено;
		СтрокиСерийДляОбработки = Неопределено;
		
		//Код из МодульОбъекта ОтборРазмещениеТоваров		
		//ПараметрыУказанияСерий = Вычислить("НоменклатураСервер.ПараметрыУказанияСерий(Док1СРезультат, Документы.ОтборРазмещениеТоваров)");
		ПараметрыУказанияСерий = ИО_ОбщийМодуль("НоменклатураСервер").ПараметрыУказанияСерий(Док1СРезультат, Документы.ОтборРазмещениеТоваров);
		
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Отбор)");		
		//Выполнить("НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Размещение, СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки)");
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Отбор);
		ИО_ОбщийМодуль("НоменклатураСервер").ЗаполнитьСтатусыУказанияСерий(Док1СРезультат, ПараметрыУказанияСерий.Размещение, СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
		
	КонецЕсли;
	
	Попытка
		// При повторном проведении документа в УТ 11.5 возникает попытка использования закрытого менеджера временных таблиц
		Док1СРезультат.Движения.ТоварыВЯчейках.ДополнительныеСвойства.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	Исключение
	КонецПопытки;
	
	// Какой-то баг с открытием формы нового документа, без передечи значний заполнения не видны реквизиты (заполненные и с пометкой видимости)
	Если Не СтруктураПараметров.Свойство("ПараметрыОткрытияФормы") Тогда 		
		ПараметрыЗаполнения = Новый Структура("Склад,Помещение,ВидОперации");
		ПараметрыОткрытияФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
		СтруктураПараметров.Вставить("ПараметрыОткрытияФормы", ПараметрыОткрытияФормы);
	КонецЕсли;
		
	Если Док1СРезультат.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Отбор") Тогда
	    // Обязательно выполняем последним, т.к. в случае работы с маркированной продукцией документ будет принудительно записан
		ЗаполнитьДанныеПроверкиИПодбораИСМП(СтруктураПараметров);
		ЗаполнитьДанныеПроверкиИПодбораМОТП(СтруктураПараметров);
		
		СтруктураПараметров.Вставить("КритическаяОшибка", Ложь);
		СтруктураПараметров.Вставить("КритическаяОшибкаОписание", "");
	КонецЕсли;
	
	//Миронов А.А
	ОшибкаПриПроведении = Ложь;
	Попытка 
		Для Каждого Стр Из Док1СРезультат.ТоварыРазмещение Цикл
			МассивСтрок = Док1СРезультат.ТоварыОтбор.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия", Стр.Номенклатура, Стр.Характеристика, Стр.Серия));
			Если МассивСтрок.Количество() > 0 Тогда
				Если Стр.Упаковка <> МассивСтрок[0].Упаковка Тогда
					Стр.Упаковка = МассивСтрок[0].Упаковка;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Док1СРезультат.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
		Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);		
	Исключение 
		ОшибкаПриПроведении 	= Истина; 
		Док1СРезультат.Статус 	= ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками");
		Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);		
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки  = "Ошибка при проведении " + Строка(Док1СРезультат) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Отбор (размешение) товаров ", "Ошибка" , ТекстОшибки);	
	КонецПопытки;	
	
	Попытка
		//Если НЕ ДокументТСДВыполненСОшибками 		
		Если НЕ ШапкаДокументаТСД.СозданНаТСД 
			И ОшибкаПриПроведении = Ложь 
			И ЗначениеЗаполнено(Док1СРезультат.Распоряжение)
			И ТипЗнч(Док1СРезультат.Распоряжение) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") 
			И Док1СРезультат.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок") Тогда
			
			Если ЗначениеЗаполнено(Док1СРезультат.Комментарий) Тогда
				Док1СРезультат.Комментарий = Док1СРезультат.Комментарий + Символы.ПС + "Документ обработан на ТСД! от " + ТекущаяДата();
			Иначе   
				Док1СРезультат.Комментарий = "Документ обработан на ТСД! от " + ТекущаяДата();
			КонецЕсли;
			
			Док1СРезультат.Записать(РежимЗаписиДокумента.Проведение);
			
			РасходныйОрдер 		  = Док1СРезультат.Распоряжение.ПолучитьОбъект();
			РасходныйОрдер.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.Отгружен");
			ТЧОтгружаемыеТовары   = РасходныйОрдер.ОтгружаемыеТовары;
			
			Для Каждого Стр из ТЧОтгружаемыеТовары Цикл
				Стр.Действие 	  = ПредопределенноеЗначение("Перечисление.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить");
			КонецЦикла;
			
			РасходныйОрдер.Записать(РежимЗаписиДокумента.Проведение);			
		КонецЕсли;	
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки  = "Ошибка при проведении " + Строка(РасходныйОрдер) + "; " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Расходный ордер на товары", "Ошибка" , ТекстОшибки);
		СтруктураПараметров.Вставить("КритическаяОшибка", Истина);	
	КонецПопытки		
	//Миронов А.А
	

КонецПроцедуры

Функция УТ_11_5_ОтборРазмещениеТоваров_ЕстьРасхождения(Док1СРезультат)

	ЕстьРасхождения = Ложь;
	
	Если Док1СРезультат.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Отбор")
		ИЛИ Док1СРезультат.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Перемещение") Тогда
        Для каждого СтрокаДокумента ИЗ Док1СРезультат.ТоварыОтбор Цикл
			Если СтрокаДокумента.КоличествоУпаковок <> СтрокаДокумента.КоличествоУпаковокОтобрано Тогда
				ЕстьРасхождения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьРасхождения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Док1СРезультат.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Размещение")
		ИЛИ Док1СРезультат.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Перемещение") Тогда
		Для каждого СтрокаДокумента ИЗ Док1СРезультат.ТоварыРазмещение Цикл
			Если СтрокаДокумента.КоличествоУпаковок <> СтрокаДокумента.КоличествоУпаковокРазмещено Тогда
				ЕстьРасхождения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьРасхождения;
		
КонецФункции

Функция ПолучитьСсылкуРасходныйОрдерНаТовары(СсылкаНаРеализацияТоваровУслуг)
  
	СсылкаРасходныйОрдерНаТовары = Документы.РасходныйОрдерНаТовары.ПустаяСсылка();

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыКОтгрузкеОбороты.Регистратор КАК Ссылка
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыКОтгрузке.Обороты(, , Регистратор, ) КАК ТоварыКОтгрузкеОбороты
	                      |ГДЕ
	                      |	ТоварыКОтгрузкеОбороты.ДокументОтгрузки = &Распоряжение
	                      |	И ТоварыКОтгрузкеОбороты.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары");

	Запрос.УстановитьПараметр("Распоряжение", СсылкаНаРеализацияТоваровУслуг);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		СсылкаРасходныйОрдерНаТовары = Выборка.Ссылка;
	КонецЕсли;

	Возврат СсылкаРасходныйОрдерНаТовары;

