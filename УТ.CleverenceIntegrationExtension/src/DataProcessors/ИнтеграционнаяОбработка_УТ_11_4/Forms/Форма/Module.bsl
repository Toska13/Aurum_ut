&НаКлиентеНаСервереБезКонтекста
Функция УТ_11_4_ЗаказНаЭмиссиюКодовМаркировкиСУЗ_ЭтоРасширеннаяМаркировкаОстатковЛегкойПромышленности(Форма)
	
	Если Форма.ЭтоМаркировкаОстатков
		И Форма.Объект.ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.ЛегкаяПромышленность")
		И Не Форма.Объект.Ссылка.Пустая() Тогда
		
		Если Форма.Объект.БезУчетаНоменклатуры
			Или Форма.Объект.ВвезенПослеДатыОбязательнойМаркировки
			Или Форма.Объект.ПриобретенПроизведенПослеДатыОбязательнойМаркировки Тогда
				Возврат Истина;
		КонецЕсли;
		
		Для Каждого Строка Из Форма.Объект.Товары Цикл
			Если ЗначениеЗаполнено(Строка.КодТНВЭД)
				Или ЗначениеЗаполнено(Строка.ЦелевойПол)
				Или ЗначениеЗаполнено(Строка.ВозрастнаяКатегория)
				Или ЗначениеЗаполнено(Строка.СпособВводаВОборот) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УТ_11_4_МаркировкаТоваровИСМП_ЗаполнитьДоступныеОперации(Форма)
	
	ДокументОбъект = Форма.Объект;
	ЭлементыФормы  = Форма.Элементы;
	
	Попытка
		ДоступныОперацииНанесения = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииИспользуетОтчетыОНанесенииКодовМаркировки(ДокументОбъект.ВидПродукции);
	Исключение
		// адаптация к старым релизам
		ДоступныОперацииНанесения = Ложь;	
	КонецПопытки;
	Попытка
		ДоступноПолучениеПродукцииОтФизическихЛиц = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииИспользуетПолучениеПродукцииОтФизическихЛиц(ДокументОбъект.ВидПродукции);
	Исключение
		// адаптация к старым релизам
		ДоступноПолучениеПродукцииОтФизическихЛиц = Ложь;	
	КонецПопытки;
	
	ЗначенияПеречисленияВидыПродукцииИС = УТ_11_4_ПолучитьЗначенияПеречисления("ВидыПродукцииИС");
	
	Попытка
		ЭтоПродукцияПодконтрольнаяВЕТИС = ИнтеграцияИСКлиентСервер_ЭтоПродукцияПодконтрольнаяВЕТИС(ДокументОбъект.ВидПродукции);
	Исключение
		// адаптация к старым релизам
		ЭтоПродукцияПодконтрольнаяВЕТИС = ЗначенияПеречисленияВидыПродукцииИС.Найти("МолочнаяПродукцияПодконтрольнаяВЕТИС") <> Неопределено
			И ДокументОбъект.ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.МолочнаяПродукцияПодконтрольнаяВЕТИС");
	КонецПопытки;
	
	ЭтоОбувь = ИСМП_ЭтоВидПродукции(ЗначенияПеречисленияВидыПродукцииИС, ДокументОбъект.ВидПродукции, "Обувь");
	ЭтоМех   = ИСМП_ЭтоВидПродукции(ЗначенияПеречисленияВидыПродукцииИС, ДокументОбъект.ВидПродукции, "ПродукцияИзНатуральногоМеха");
	ЭтоПиво  = ИСМП_ЭтоВидПродукции(ЗначенияПеречисленияВидыПродукцииИС, ДокументОбъект.ВидПродукции, "Пиво")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисленияВидыПродукцииИС, ДокументОбъект.ВидПродукции, "ПивоВПотребительскихУпаковках");
	ЭтоТитановаяПродукция = ИСМП_ЭтоВидПродукции(ЗначенияПеречисленияВидыПродукцииИС, ДокументОбъект.ВидПродукции, "ТитановаяМеталлопродукция");
	
	ЭлементыФормы.Операция.СписокВыбора.Очистить();
	ЭлементыФормы.ОперацияНанесения.СписокВыбора.Очистить();
	
	Если ЭлементыФормы.Найти("ВариантВыполненияАгрегации") <> Неопределено Тогда
		ЭлементыФормы.ВариантВыполненияАгрегации.СписокВыбора.Очистить();
	КонецЕсли;
	
	ИспользуетсяПодсистемаВЕТИС = УТ_11_4_МаркировкаТоваровИСМП_ИспользуетсяПодсистемаВетИС();
	
	Попытка	
		ОперацииНанесенияКодовМаркировки = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ОперацииНанесенияКодовМаркировки(Ложь, ЭтоМех);
	Исключение
		ОперацииНанесенияКодовМаркировки = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ОперацииНанесенияКодовМаркировки();
	КонецПопытки;
	
	Если ДоступныОперацииНанесения
		И (ИспользуетсяПодсистемаВЕТИС Или Не ЭтоПродукцияПодконтрольнаяВЕТИС) Тогда
		
		Для Каждого ОперацияНанесения Из ОперацииНанесенияКодовМаркировки Цикл
			ЭлементыФормы.Операция.СписокВыбора.Добавить(ОперацияНанесения);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ЭтоМех И Не ЭтоТитановаяПродукция Тогда
		ЭлементыФормы.Операция.СписокВыбора.Добавить(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.Агрегация"));
	КонецЕсли;
		
	Если УТ_11_4_МаркировкаТоваровИСМП_ЭтоПродукцияИСМП(ДокументОбъект.ВидПродукции) Тогда
		
		Если УТ_11_4_МаркировкаТоваровИСМП_ВидыПродукцииОперацииПроизводствоВнеЕАЭС(ЗначенияПеречисленияВидыПродукцииИС).Получить(ДокументОбъект.ВидПродукции) <> Неопределено Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотПроизводствоВнеЕАЭС"));
		КонецЕсли;
		
		ЭлементыФормы.Операция.СписокВыбора.Добавить(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотПроизводствоРФ"));
		
		Если УТ_11_4_МаркировкаТоваровИСМП_ВидыПродукцииОперацииИмпортСФТС(ЗначенияПеречисленияВидыПродукцииИС).Получить(ДокументОбъект.ВидПродукции) <> Неопределено Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотИмпортСФТС"));
		ИначеЕсли ЭтоМех Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотИмпортСФТСМех"));
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ПодтверждениеПоступленияКИЗ"));
		КонецЕсли;
		
		Если ДоступныОперацииНанесения Тогда
			
			ЭлементыФормы.ОперацияНанесения.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ПустаяСсылка"),
				НСтр("ru = '<Выполнена независимо>'"));
			Для Каждого ОперацияНанесения Из ОперацииНанесенияКодовМаркировки Цикл
				ЭлементыФормы.ОперацияНанесения.СписокВыбора.Добавить(ОперацияНанесения);
			КонецЦикла;
		
		КонецЕсли;
		
		ИспользуетсяПереработкаНаСтороне = Истина;
		Попытка
			ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМППереопределяемый").ИспользуетсяПереработкаНаСтороне(ИспользуетсяПереработкаНаСтороне);
		Исключение
			// адаптация к старым релизам
		КонецПопытки;
		
		ЭлементыФормы.Операция.СписокВыбора.Добавить(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотПроизводствоРФПоДоговору"));
		
		Если ИспользуетсяПереработкаНаСтороне Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотПроизводствоРФПоДоговоруНаСторонеЗаказчика"));
		КонецЕсли;
		
		Если ДоступноПолучениеПродукцииОтФизическихЛиц Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотПолучениеПродукцииОтФизическихЛиц"));
		КонецЕсли;
		
		// Недоступно для отчетов производственной линии: требует цены/суммы
		Если (ИспользуетсяПодсистемаВЕТИС Или Не ЭтоПродукцияПодконтрольнаяВЕТИС) И Не ЭтоМех И Не ЭтоТитановаяПродукция Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотТрансграничнаяТорговля"));
		КонецЕсли;
		
		Попытка
			ВидПродукцииПодлежитМаркировкеОстатков = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииПодлежитМаркировкеОстатков(ДокументОбъект.ВидПродукции);
		Исключение
			// адаптация к старым режимам
			ВидПродукцииПодлежитМаркировкеОстатков = Ложь;	
		КонецПопытки;		
		
		Если ВидПродукцииПодлежитМаркировкеОстатков Тогда
			ЭлементыФормы.Операция.СписокВыбора.Добавить(
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотМаркировкаОстатков"));
		КонецЕсли;
		
		Если ЭлементыФормы.Найти("ВариантВыполненияАгрегации") <> Неопределено Тогда
			ЭлементыФормы.ВариантВыполненияАгрегации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыВыполненияАгрегацииИСМП.ПустаяСсылка"),
				НСтр("ru = 'После ввода в оборот'"));
			ЭлементыФормы.ВариантВыполненияАгрегации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыВыполненияАгрегацииИСМП.ПередВводомВОборот"));
			ЭлементыФормы.ВариантВыполненияАгрегации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыВыполненияАгрегацииИСМП.НеТребуется"));
		КонецЕсли;
		
	ИначеЕсли ЭтоПиво Тогда
		
		ЭлементыФормы.Операция.СписокВыбора.Добавить(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотИмпортСФТС"));
		
		ЭлементыФормы.Операция.СписокВыбора.Добавить(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотТрансграничнаяТорговля"));
		
		Если ДоступныОперацииНанесения Тогда
			
			ЭлементыФормы.ОперацияНанесения.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыВыполненияАгрегацииИСМП.ПустаяСсылка"),
				НСтр("ru = '<Выполнена независимо>'"));
			Для Каждого ОперацияНанесения Из ОперацииНанесенияКодовМаркировки Цикл
				ЭлементыФормы.ОперацияНанесения.СписокВыбора.Добавить(ОперацияНанесения);
			КонецЦикла;
		
		КонецЕсли;
	
	КонецЕсли;
	
	Попытка
		Для Каждого ЭлементСписка Из ЭлементыФормы.Операция.СписокВыбора Цикл
			ЭлементСписка.Представление = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ПредставлениеВидаОперацииИСМП(ЭлементСписка.Значение);
		КонецЦикла;
	Исключение
		// адаптация к старым релизам
	КонецПопытки;
	
	ЭлементыФормы.Операция.СписокВыбора.СортироватьПоПредставлению();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УТ_11_4_МаркировкаТоваровИСМП_ИспользуетсяПодсистемаВЕТИС() 

	Возврат ОбщегоНазначения.ОбщийМодуль("ИнтеграцияИСМПВЕТИС").ИспользуетсяПодсистемаВетИС();
	
КонецФункции

&НаСервере
Функция УТ_11_4_МаркировкаТоваровИСМП_ЭтоПродукцияИСМП(ВидПродукции)

	Попытка
		ЭтоПродукцияИСМП = ИнтеграцияИСПовтИсп_ЭтоПродукцияИСМП(ВидПродукции, Ложь, Истина, Ложь);
	Исключение
		// адаптация к старым релизам
		ЭтоПродукцияИСМП = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияИСПовтИсп").ЭтоПродукцияИСМП(ВидПродукции, Ложь, Истина);
	КонецПопытки;
	
	Возврат ЭтоПродукцияИСМП;

КонецФункции

&НаКлиенте
Функция УТ_11_4_МаркировкаТоваровИСМП_ПредставлениеСертификации(ВидСертификации, НомерСертификации, ДатаСертификации)
		
	Если ЗначениеЗаполнено(ВидСертификации)
		И ЗначениеЗаполнено(НомерСертификации)
		И ЗначениеЗаполнено(ДатаСертификации) Тогда
		
		ПредставлениеСертификата = 
			"" + ВидСертификации + " №" +
			НомерСертификации + " от " +
			Формат(ДатаСертификации, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
	Возврат ПредставлениеСертификата;
	
КонецФункции

&НаКлиенте
Процедура УТ_11_4_МаркировкаТоваровИСМП_НастроитьЭлементыФормы(Форма)
	
	ЭлементыФормы              = Форма.Элементы;
	Операция                   = Форма.Объект.Операция;
	ОперацияНанесения          = Форма.Объект.ОперацияНанесения;
	ОтчетПроизводственнойЛинии = Форма.Объект.ОтчетПроизводственнойЛинии;
	ВидПродукции               = Форма.Объект.ВидПродукции;
	ПередаватьВДекларациюАТК   = Форма.Объект.ВариантЗаполненияДекларации = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДекларацииИСМП.АТК");
	
	Попытка
		ПроверятьСоставУпаковокПоДаннымИСМП = Форма.Объект.ПроверятьСоставУпаковокПоДаннымИСМП;
	Исключение
		// Адаптация к старым режимам
		ПроверятьСоставУпаковокПоДаннымИСМП = Ложь;
	КонецПопытки;
	
	ОперацииМаркировки = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПСлужебныйКлиентСервер").ОперацииМаркировки(Операция);
	ЭтоПроизводствоРФ                           = ОперацииМаркировки.Свойство("ЭтоПроизводствоРФ") И ОперацииМаркировки.ЭтоПроизводствоРФ;
	ЭтоПроизводствоВнеЕАЭС                      = ОперацииМаркировки.Свойство("ЭтоПроизводствоВнеЕАЭС") И ОперацииМаркировки.ЭтоПроизводствоВнеЕАЭС;
	ЭтоПроизводствоПоДоговору                   = ОперацииМаркировки.Свойство("ЭтоПроизводствоПоДоговору") И ОперацииМаркировки.ЭтоПроизводствоПоДоговору;
	ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика = ОперацииМаркировки.Свойство("ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика") И ОперацииМаркировки.ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика;
	ЭтоПолучениеПродукцииОтФизическихЛиц        = ОперацииМаркировки.Свойство("ЭтоПолучениеПродукцииОтФизическихЛиц") И ОперацииМаркировки.ЭтоПолучениеПродукцииОтФизическихЛиц;
	ЭтоМаркировкаОстатков                       = ОперацииМаркировки.Свойство("ЭтоМаркировкаОстатков") И ОперацииМаркировки.ЭтоМаркировкаОстатков;
	ЭтоТрансграничнаяТорговля                   = ОперацииМаркировки.Свойство("ЭтоТрансграничнаяТорговля") И ОперацииМаркировки.ЭтоТрансграничнаяТорговля;
	ЭтоАгрегация                                = ОперацииМаркировки.Свойство("ЭтоАгрегация") И ОперацииМаркировки.ЭтоАгрегация;
	ЭтоИмпортСФТС                               = ОперацииМаркировки.Свойство("ЭтоИмпортСФТС") И ОперацииМаркировки.ЭтоИмпортСФТС;
	ЭтоВводВОборот                              = ОперацииМаркировки.Свойство("ЭтоВводВОборот") И ОперацииМаркировки.ЭтоВводВОборот;
	ЭтоКонтрактноеПроизводство                  = ОперацииМаркировки.Свойство("ЭтоКонтрактноеПроизводство") И ОперацииМаркировки.ЭтоКонтрактноеПроизводство;
	ЭтоПриемкаКИЗ                               = ОперацииМаркировки.Свойство("ЭтоПриемкаКИЗ") И ОперацииМаркировки.ЭтоПриемкаКИЗ;
	
	ЗначенияПеречисления = УТ_11_4_ПолучитьЗначенияПеречисления("ВидыПродукцииИС");
	
	ЭтоТабак                     = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "Табак");
	ЭтоМолочнаяПродукцияВЕТИС    = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МолочнаяПродукцияПодконтрольнаяВЕТИС");
	ЭтоМолочнаяПродукцияБезВЕТИС = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МолочнаяПродукцияБезВЕТИС");
	ЭтоМолочнаяПродукция         = ЭтоМолочнаяПродукцияБезВЕТИС Или ЭтоМолочнаяПродукцияВЕТИС;
	ЭтоПродукцияМОТП             = ИнтеграцияИСКлиентСервер_ЭтоПродукцияМОТП(ВидПродукции);
	ЭтоУпакованнаяВода           = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "УпакованнаяВода");
	ЭтоПиво                      = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "Пиво")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ПивоВПотребительскихУпаковках");
	ЭтоБАПиво                    = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "БезалкогольноеПиво");
	ЭтоБАД                       = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "БАДы")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "БАДы2025");
	ЭтоМех                       = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ПродукцияИзНатуральногоМеха");
	ЭтоШины                      = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "Шины");
	ЭтоКреслаКоляски             = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "КреслаКоляски")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ТехническиеСредстваРеабилитации")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МедицинскиеИзделия")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МедицинскиеИзделия20");
	ЭтоМорепродукты              = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МорепродуктыПодконтрольныеВЕТИС");
	ЭтоВетеринарныеПрепараты     = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ВетеринарныеПрепараты");
	
	Попытка
		ЭтоПродукцияПодконтрольнаяВЕТИС = ИнтеграцияИСКлиентСервер_ЭтоПродукцияПодконтрольнаяВЕТИС(ВидПродукции);
	Исключение
		// Адаптация к старым релизам
		ЭтоПродукцияПодконтрольнаяВЕТИС	= ЭтоМолочнаяПродукцияВЕТИС ИЛИ ЭтоМорепродукты;
	КонецПопытки;
	
	// Перенесено выше по коду для определения использования срока годности/даты производства в старых релизах
	ВозможнаОперацияНанесения = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииИспользуетОтчетыОНанесенииКодовМаркировки(ВидПродукции);
	ЭтоОперацияНанесения =
		ОперацииМаркировки.ЭтоОперацияНанесения
		Или (ЭтоПродукцияПодконтрольнаяВЕТИС И Не Форма.ИспользуетсяПодсистемаВЕТИС);
	
	ПрисутствуетОперацияНанесения = ЗначениеЗаполнено(Форма.Объект.ОперацияНанесения) Или ЭтоОперацияНанесения;
	ДоступнаОперацияНанесенияПоВидуОперацииИСМП = УТ_11_4_МаркировкаТоваровИСМП_ДоступнаОперацияНанесенияПоВидуОперацииИСМП(Операция);
	
	Попытка
		ЭтоПродукцияСоСрокамиГодности = ИнтеграцияИСМПКлиентСервер_ЭтоВидПродукцииСоСрокамиГодности(ВидПродукции);
		ДляВидаПродукцииИспользуетсяДатаПроизводства = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ДляВидаПродукцииИспользуетсяДатаПроизводства(ВидПродукции);
	Исключение
		// Адаптация к старым релизам	
		ЭтоПродукцияСоСрокамиГодности = ПрисутствуетОперацияНанесения И (ЭтоМолочнаяПродукция Или ЭтоБАД Или ЭтоПиво Или ЭтоБАПиво);
		ДляВидаПродукцииИспользуетсяДатаПроизводства = ЭтоОперацияНанесения И (ЭтоБАД Или ЭтоПиво Или ЭтоБАПиво);
	КонецПопытки;
	
	ПроверятьСоставУпаковокПоДаннымИСМП = ПроверятьСоставУпаковокПоДаннымИСМП И ЭтоАгрегация И ЭтоПродукцияМОТП;
	
	Попытка
		ТребуетсяУказатьДанныеДекларации = УТ_11_4_МаркировкаТоваровИСМП_ТребуетсяУказатьДанныеДекларации(Форма);
		Если ТребуетсяУказатьДанныеДекларации Тогда
			ЭлементыФормы.РегистрационныйНомерДекларации.АвтоОтметкаНезаполненного = Истина;
			ЭлементыФормы.ДатаДекларации.АвтоОтметкаНезаполненного                 = Истина;
			ЭлементыФормы.ПринятоеРешениеПолеВвода.АвтоОтметкаНезаполненного       = Истина;
			ЭлементыФормы.КодТаможенногоОргана.АвтоОтметкаНезаполненного           = Истина;
		Иначе
			ЭлементыФормы.РегистрационныйНомерДекларации.АвтоОтметкаНезаполненного = Ложь;
			ЭлементыФормы.ДатаДекларации.АвтоОтметкаНезаполненного                 = Ложь;
			ЭлементыФормы.ПринятоеРешениеПолеВвода.АвтоОтметкаНезаполненного       = Ложь;
			ЭлементыФормы.КодТаможенногоОргана.АвтоОтметкаНезаполненного           = Ложь;
		КонецЕсли;
	Исключение
		// Адаптация к старым релизам
		ТребуетсяУказатьДанныеДекларации = Ложь;
	КонецПопытки;
	
	Если ЭтоПродукцияПодконтрольнаяВЕТИС И Не Форма.ИспользуетсяПодсистемаВЕТИС Тогда
		ОтчетПроизводственнойЛинии = Истина;
	КонецЕсли;
	
	ДоступенОтчетПроизводственнойЛинии = УТ_11_4_МаркировкаТоваровИСМП_ОпределитьДоступностьОтчетаПроизводственнойЛинии(
		ВидПродукции, ОперацииМаркировки, ОперацияНанесения, ЗначенияПеречисления);
	
	ОтчетПроизводственнойЛинии = ОтчетПроизводственнойЛинии И ДоступенОтчетПроизводственнойЛинии;
	
	УказаниеРеквизитовНанесенияНаПиво = ПрисутствуетОперацияНанесения И ЭтоПиво;
	
	Попытка
		ЭлементыФормы.ОтчетПроизводственнойЛинии.Видимость       = ДоступенОтчетПроизводственнойЛинии;
		Форма.Объект.ОтчетПроизводственнойЛинии             	 = ОтчетПроизводственнойЛинии;
		ЭлементыФормы.ОтчетПроизводственнойЛинии.ТолькоПросмотр  = Ложь;
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	Попытка
		ВидПродукцииИспользуетНаборы            = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетНаборы(ВидПродукции);
		ВидПродукцииИспользуетГрупповыеУпаковки = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетГрупповыеУпаковки(ВидПродукции);
		
		КомплектующиеМогутБытьНанесеныНезависимо = ВидПродукцииИспользуетНаборы Или ВидПродукцииИспользуетГрупповыеУпаковки И Не ЭтоТабак;
		ЭлементыФормы.ОперацияНанесенияТолькоДляНаборов.Доступность = ЗначениеЗаполнено(Форма.Объект.ОперацияНанесения);
		ЭлементыФормы.ОперацияНанесенияТолькоДляНаборов.Видимость   = КомплектующиеМогутБытьНанесеныНезависимо И Не ЭтоИмпортСФТС;
		ЭлементыФормы.ОперацияТолькоДляНаборов.Видимость            = КомплектующиеМогутБытьНанесеныНезависимо И ЭтоОперацияНанесения;
	Исключение
		// Адаптация к старым релизам
		ВидПродукцииИспользуетНаборы			 = Ложь;
		ВидПродукцииИспользуетГрупповыеУпаковки	 = Ложь;
		КомплектующиеМогутБытьНанесеныНезависимо = Ложь;
	КонецПопытки;
	
	Попытка
		ЭлементыФормы.Номенклатура.АвтоОтметкаНезаполненного = ОтчетПроизводственнойЛинии И (ЭтоИмпортСФТС Или Форма.Объект.СоздаватьШтрихкодыУпаковок);
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	ЭлементыФормы.ТоварыЗагрузитьДанныеИзТСД.Видимость     = Не ЭтоАгрегация;
	ЭлементыФормы.ТоварыЗагрузитьИзВнешнегоФайла.Видимость = Не ЭтоАгрегация;
	
	ЭлементыФормы.ДатаДекларации.Видимость                 = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.ДатаДекларацииЗаголовок.Видимость        = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	
	ЭлементыФормы.РегистрационныйНомерДекларации.Видимость = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.ВариантЗаполненияДекларации.Видимость    = ЭтоИмпортСФТС И Не ЭтоМех;
	ЭлементыФормы.ВариантФормированияАТКИСМП.Видимость     = ЭтоИмпортСФТС И Не ЭтоМех;
	ЭлементыФормы.ВариантФормированияАТКИСМП.Доступность   = ЭтоИмпортСФТС И ПередаватьВДекларациюАТК И Не ЭтоМех;
	
	ЭлементыФормы.КодТаможенногоОргана.Видимость           = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.КодТаможенногоОрганаЗаголовок.Видимость  = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	
	ЭлементыФормы.ПринятоеРешение.Видимость                = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.СтранаПроисхождения.Видимость            = ЭтоТрансграничнаяТорговля;
	ЭлементыФормы.ТоварыСтранаПроизводства.Видимость       = ЭтоМаркировкаОстатков;
	ЭлементыФормы.ТоварыТаможеннаяДекларация.Видимость     = ЭтоМаркировкаОстатков;
	ЭлементыФормы.ЗаполнитьПараметрыТовары.Видимость       = ЭтоМаркировкаОстатков;
	ЭлементыФормы.ТоварыGTIN.Видимость                     = ЭтоМаркировкаОстатков Или ЭтоАгрегация Или (ЭтоОперацияНанесения И ЭтоТабак);
	ЭлементыФормы.ДатаИмпорта.Видимость                    = ЭтоТрансграничнаяТорговля;
	ЭлементыФормы.ТоварыЦена.Видимость                     = ЭтоТрансграничнаяТорговля;
	ЭлементыФормы.ТоварыСуммаНДС.Видимость                 = ЭтоТрансграничнаяТорговля;
	ЭлементыФормы.ТоварыСумма.Видимость                    = ЭтоТрансграничнаяТорговля;
	ЭлементыФормы.ТоварыСтавкаНДС.Видимость                = ЭтоТрансграничнаяТорговля Или ЭтоИмпортСФТС;
	ЭлементыФормы.ТоварыСуммаСНДС.Видимость                = ЭтоТрансграничнаяТорговля;
	
	Попытка
		ЭлементыФормы.ТоварыСуммаАкциза.Видимость     	   = ЭтоТрансграничнаяТорговля И ЭтоПиво;
	Исключение
		// Адаптация к старым релизам
		ЭлементыФормы.ТоварыСертификация.Видимость		   = ЭтоВводВОборот;
	КонецПопытки;
		
	ЭлементыФормы.ГруппаПервичныйДокумент.Видимость        = ЭтоТрансграничнаяТорговля Или ЭтоПриемкаКИЗ
		Или УказаниеРеквизитовНанесенияНаПиво И ОтчетПроизводственнойЛинии;
		
	Попытка
		ЭлементыФормы.СодержаниеЭтиловогоСпирта.Видимость	= УказаниеРеквизитовНанесенияНаПиво И ОтчетПроизводственнойЛинии;
	Исключение
		// Адаптация к старым релизам	
	КонецПопытки;
		
	ЭлементыФормы.ТоварыКодТНВЭД.Видимость					= ЭтоВводВОборот;
	
	Попытка
		ЭлементыФормы.ТоварыСодержаниеЭтиловогоСпирта.Видимость = УказаниеРеквизитовНанесенияНаПиво И Не ОтчетПроизводственнойЛинии;
		ЭлементыФормы.ТоварыПервичныйДокумент.Видимость         = УказаниеРеквизитовНанесенияНаПиво И Не ОтчетПроизводственнойЛинии;
		ЭлементыФормы.ЗаполнитьПервичныйДокумент.Видимость      = УказаниеРеквизитовНанесенияНаПиво И Не ОтчетПроизводственнойЛинии;
		
		ОбязательноеУказаниеПервичногоДокумента = Не (УказаниеРеквизитовНанесенияНаПиво
			И Не ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ОбязательноеУказаниеПервичногоДокументаДляПиваВОтчетеОНанесении());
		ЭлементыФормы.НомерПервичногоДокумента.АвтоотметкаНезаполненного = ОбязательноеУказаниеПервичногоДокумента;
		ЭлементыФормы.ДатаПервичногоДокумента.АвтоотметкаНезаполненного  = ОбязательноеУказаниеПервичногоДокумента;
		ЭлементыФормы.ТоварыПервичныйДокумент.АвтоотметкаНезаполненного  = ОбязательноеУказаниеПервичногоДокумента;
		
		ОбязательноеУказаниеСодержанияЭтиловогоСпирта = Не (УказаниеРеквизитовНанесенияНаПиво
			И Не ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ОбязательноеУказаниеСодержанияЭтиловогоСпиртаДляПиваВОтчетеОНанесении());
		ЭлементыФормы.СодержаниеЭтиловогоСпирта.АвтоотметкаНезаполненного = ОбязательноеУказаниеСодержанияЭтиловогоСпирта;
		ЭлементыФормы.ТоварыСодержаниеЭтиловогоСпирта.АвтоотметкаНезаполненного = ОбязательноеУказаниеСодержанияЭтиловогоСпирта;
	Исключение
		// Адаптация к старым релизам	
	КонецПопытки;
	
	ЭлементыФормы.ТоварыИдентификаторПроисхожденияВЕТИС.Видимость            = Ложь;
	ЭлементыФормы.ТоварыСрокГодности.Видимость                               = Ложь;
	ЭлементыФормы.ШтрихкодыУпаковокИдентификаторПроисхожденияВЕТИС.Видимость = Ложь;
	ЭлементыФормы.ШтрихкодыУпаковокСрокГодности.Видимость                    = Ложь;
	ЭлементыФормы.ИдентификаторПроизводственногоЗаказа.Видимость             = Ложь;
	ЭлементыФормы.ИдентификаторПроизводственнойЛинии.Видимость               = Ложь;
	
	Попытка
		ЭлементыФормы.ПроверятьСоставУпаковокПоДаннымИСМП.Видимость 			= Ложь;
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	Попытка
		ЭлементыФормы.ТоварыВидМеха.Видимость    = ЭтоМех И ЭтоИмпортСФТС;
		ЭлементыФормы.ЗаполнитьВидМеха.Видимость = ЭтоМех И ЭтоИмпортСФТС;
		
		ДоступноЗаполнениеЛицензий = (ЭтоПроизводствоРФ Или ЭтоКонтрактноеПроизводство) И ЭтоУпакованнаяВода;
		ЭлементыФормы.ТоварыЛицензияНаПользованиеНедрами.Видимость = ДоступноЗаполнениеЛицензий;
		ЭлементыФормы.ЗаполнитьЛицензии.Видимость                  = ДоступноЗаполнениеЛицензий;
	Исключение
		// Адаптация к старым релизам		
	КонецПопытки;
	
	// Реквизиты отчета производственной линии
	Попытка
		ЭлементыФормы.ИдентификаторПроисхожденияВЕТИССтрокой.Видимость = ЭтоВводВОборот И Не Форма.ИспользуетсяПодсистемаВЕТИС;
		ЭлементыФормы.ИдентификаторПроисхожденияВЕТИС.Видимость   	   = ЭтоВводВОборот И Форма.ИспользуетсяПодсистемаВЕТИС;
		ЭлементыФормы.КодТНВЭД.Видимость                               = ЭтоВводВОборот;
		ЭлементыФормы.СрокГодности.Видимость                           = ПрисутствуетОперацияНанесения;
		ЭлементыФормы.СкоропортящаясяПродукция.Видимость               = ПрисутствуетОперацияНанесения;
	Исключение	
		// Адаптация к старым релизам
		ЭлементыФормы.ИдентификаторПроисхожденияВЕТИССтрокой.Видимость = ЭтоВводВОборот И Не Форма.ИспользуетсяПодсистемаВЕТИС;
		ЭлементыФормы.КодТНВЭД.Видимость                               = ЭтоВводВОборот;
		ЭлементыФормы.СрокГодности.Видимость                           = ПрисутствуетОперацияНанесения;
		ЭлементыФормы.СкоропортящаясяПродукция.Видимость               = ПрисутствуетОперацияНанесения;
	КонецПопытки;
	
	ЭлементыФормы.КодТНВЭД.АвтоОтметкаНезаполненного = ЭтоВводВОборот;
	
	Попытка
	    ЭлементыФормы.ТоварыЦена.АвтоОтметкаНезаполненного = ЭтоТрансграничнаяТорговля И ЭтоПиво;
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	Попытка
		ЭлементыФормы.ТоварыСертификация.АвтоОтметкаНезаполненного = ЭтоТрансграничнаяТорговля И ЭтоПиво;
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	Если ЭтоПродукцияСоСрокамиГодности И ПрисутствуетОперацияНанесения Тогда
		УТ_11_4_МаркировкаТоваровИСМП_УстановитьФорматСрокГодности(Форма);
		
		Попытка
			ЭтоВидПродукцииСоСрокамиГодностиБезОбязательногоЗаполнения = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ЭтоВидПродукцииСоСрокамиГодностиБезОбязательногоЗаполнения(ВидПродукции);
		
			ЭлементыФормы.СрокГодности.АвтоОтметкаНезаполненного = Не ЭтоВидПродукцииСоСрокамиГодностиБезОбязательногоЗаполнения;
			ЭлементыФормы.ТоварыСрокГодности.АвтоОтметкаНезаполненного = Не ЭтоВидПродукцииСоСрокамиГодностиБезОбязательногоЗаполнения;
		Исключение
			// Адаптация к старым релизам
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		УТ_11_4_МаркировкаТоваровИСМП_УстановитьФорматДатыПроизводства(Форма, ПрисутствуетОперацияНанесения);
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	ЭлементыФормы.ДатаПроизводства.Видимость = ЭтоКонтрактноеПроизводство
		Или ЭтоПроизводствоРФ
		Или ЭтоИмпортСФТС И ЭтоМолочнаяПродукция
		Или ПрисутствуетОперацияНанесения И ДляВидаПродукцииИспользуетсяДатаПроизводства;
	
	ЭлементыФормы.ДатаПроизводства.АвтоОтметкаНезаполненного =
		ДляВидаПродукцииИспользуетсяДатаПроизводства И ПрисутствуетОперацияНанесения
		Или Не (ЭтоШины Или ДляВидаПродукцииИспользуетсяДатаПроизводства)
			И (ЭтоПроизводствоРФ Или ЭтоКонтрактноеПроизводство)
			И (Не ЗначениеЗаполнено(ОперацияНанесения)
			   Или ЗначениеЗаполнено(ОперацияНанесения)
			       И УТ_11_4_МаркировкаТоваровИСМП_СтатусыКодыМаркировкиНанесениеНеЗавершен().Найти(Форма.СтатусИСМП) = Неопределено)
		Или ТребуетсяУказатьДанныеДекларации И ЭтоИмпортСФТС И ЭтоМолочнаяПродукция;
		
	Попытка	
