&НаСервереБезКонтекста
Функция ПолучитьЗначенияРеквизитовМассиваОбъектов(ИмяСправочника, МассивСсылок, СписокИменРеквизитов)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	*
	                      |ИЗ
	                      |	Справочник.ИмяСправочника КАК ИмяСправочника
	                      |ГДЕ
	                      |	Ссылка В ИЕРАРХИИ (&МассивСсылок)");
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);	
	
	СписокРеквизитов = "Ссылка";
	Для каждого ИмяРеквизита Из СписокИменРеквизитов Цикл		
		СписокРеквизитов = СписокРеквизитов + ", " + ИмяРеквизита.Значение + " КАК " + ИмяРеквизита.Представление;
	КонецЦикла; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "*", СписокРеквизитов);	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочника);	
	
	РезультатЗапроса 	= Запрос.Выполнить();
	КолонкиВыборки 		= РезультатЗапроса.Колонки;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СоответствиеСсылокИРеквизитов = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		СтруктураРеквизитов = Новый Структура;
		
		Для каждого Колонка Из КолонкиВыборки Цикл	
			СтруктураРеквизитов.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);		
		КонецЦикла; 
		
		СоответствиеСсылокИРеквизитов.Вставить(Выборка.Ссылка, СтруктураРеквизитов);
		
	КонецЦикла; 
	
	Возврат СоответствиеСсылокИРеквизитов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФункциональнуюОпциюНаСервере(ИмяФункциональнойОпции)
	
