&НаКлиенте
Процедура УТ_11_4_МаркировкаТоваровИСМП_УстановитьУсловноеОформлениеВНетабличноеПоле(Форма)

	ЭлементыФормы = Форма.Элементы;
	
	СтруктураЗаполнения =
		УТ_11_4_МаркировкаТоваровИСМП_ИнициализироватьСтруктуруЗаполненияСлужебныхРеквизитовНоменклатуры(Ложь);
	ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Форма);
	
	СтруктураФормы = Новый Структура;
	СтруктураФормы.Вставить("Объект", 	Форма.Объект);
	СтруктураФормы.Вставить("ИмяФормы", "Документ.МаркировкаТоваровИСМП.Форма.ФормаДокумента");
	
	УТ_11_4_МаркировкаТоваровИСМП_ЗаполнитьСлужебныеРеквизитыНоменклатуры(
		СтруктураФормы, СтруктураЗаполнения,, Форма.ПараметрыУказанияСерий);
	
	ЗаполнитьЗначенияСвойств(Форма, СтруктураЗаполнения);
	
	// см. СобытияФормИСПереопределяемый.УстановитьУсловноеОформлениеХарактеристикНоменклатуры
	ИмяПоляВводаХарактеристики = "Характеристика";
	
	Если НЕ Форма.ХарактеристикиИспользуются Тогда
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ЦветТекста 				= ПолучитьЦветСтиля("ТекстЗапрещеннойЯчейкиЦвет");
		ЭлементыФормы[ИмяПоляВводаХарактеристики].АвтоОтметкаНезаполненного = Ложь;
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ПодсказкаВвода 			= НСтр("ru = '<характеристики не используются>'");
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ТолькоПросмотр 			= Истина;
	Иначе
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ЦветТекста 				= ПолучитьЦветСтиля("ЦветТекстаПоля");
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ПодсказкаВвода 			= "";
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ТолькоПросмотр 			= Ложь;
	КонецЕсли;
	
	// см. СобытияФормИСПереопределяемый.УстановитьУсловноеОформлениеСерийНоменклатуры
	ИмяПоляВводаСерии 				   = "Серия";
	ПутьКПолюОтбораСтатусУказанияСерий = "СтатусУказанияСерий";
	ПутьКПолюОтбораТипНоменклатуры 	   = "ТипНоменклатуры";
	ПутьКПолюОтбораСерия 			   = "Серия";
	
	Если НЕ ПолучитьФункциональнуюОпциюНаСервере("ИспользоватьСерииНоменклатуры") Тогда
		ЭлементыФормы[ИмяПоляВводаСерии].Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	СписокТиповДляСерий = Новый СписокЗначений;
	СписокТиповДляСерий.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Товар"));
	СписокТиповДляСерий.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МногооборотнаяТара"));
	
	Если Форма[ПутьКПолюОтбораСтатусУказанияСерий] = 0
		И НЕ СписокТиповДляСерий.НайтиПоЗначению(Форма[ПутьКПолюОтбораТипНоменклатуры]) = Неопределено Тогда
		ЭлементыФормы[ИмяПоляВводаСерии].ЦветТекста 				= ПолучитьЦветСтиля("ТекстЗапрещеннойЯчейкиЦвет");
		ЭлементыФормы[ИмяПоляВводаСерии].АвтоОтметкаНезаполненного 	= Ложь;
		ЭлементыФормы[ИмяПоляВводаСерии].ПодсказкаВвода 			= НСтр("ru = '<серия не указывается>'");
		ЭлементыФормы[ИмяПоляВводаСерии].ТолькоПросмотр 			= Истина;
	Иначе
		ЭлементыФормы[ИмяПоляВводаСерии].ЦветТекста 				= ПолучитьЦветСтиля("ЦветТекстаПоля");
		ЭлементыФормы[ИмяПоляВводаСерии].ПодсказкаВвода 			= "";
		ЭлементыФормы[ИмяПоляВводаСерии].ТолькоПросмотр 			= Ложь;
	КонецЕсли;
	
	// Статусы FEFO
	СписокСтатусовСерий = Новый СписокЗначений;
	СписокСтатусовСерий.Добавить(5);
	СписокСтатусовСерий.Добавить(6);
	СписокСтатусовСерий.Добавить(25);

	Если НЕ СписокСтатусовСерий.НайтиПоЗначению(Форма[ПутьКПолюОтбораСтатусУказанияСерий]) = Неопределено
		И НЕ ЗначениеЗаполнено(Форма[ПутьКПолюОтбораСерия]) Тогда
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ЦветТекста 				= ПолучитьЦветСтиля("ТекстЗапрещеннойЯчейкиЦвет");
		ЭлементыФормы[ИмяПоляВводаХарактеристики].АвтоОтметкаНезаполненного = Ложь;
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ПодсказкаВвода 			= НСтр("ru = '<Автозаполнение FEFO>'");
		ЭлементыФормы[ИмяПоляВводаХарактеристики].ТолькоПросмотр 			= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньСтрокой, Комментарий, РежимОтладки = "ТолькоОшибки")
	
	// Режимы отладки:
	// "Полный"
	// "ТолькоОшибки", по умолчанию и если режим не задан, то режим "ТолькоОшибки",
	// "БезОтладки", никакая интформация не пишется в ЖР
	Если РежимОтладки = "БезОтладки" Тогда
		Возврат;
	КонецЕсли;
	
	Если УровеньСтрокой = "Информация" Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	ИначеЕсли УровеньСтрокой = "Ошибка" Тогда	
		Уровень = УровеньЖурналаРегистрации.Ошибка;		
	ИначеЕсли УровеньСтрокой = "Предупреждение" Тогда
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли УровеньСтрокой = "Примечание" Тогда
		Уровень = УровеньЖурналаРегистрации.Примечание;			
	Иначе
		Уровень = УровеньЖурналаРегистрации.Информация;	
	КонецЕсли;
	
	Если РежимОтладки = "ТолькоОшибки" И Уровень = УровеньЖурналаРегистрации.Ошибка Тогда
		ЗаписьЖурналаРегистрации("КлеверенсТСД." + ИмяСобытия, Уровень, , , Комментарий);	
	ИначеЕсли РежимОтладки = "Полный" Тогда	
		ЗаписьЖурналаРегистрации("КлеверенсТСД." + ИмяСобытия, Уровень, , , Комментарий);
	Иначе
		Возврат
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Функция ВернутьСтатусДокумента(АдресХранилища) 
	
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		ДокСтруктура = ПолучитьИзВременногоХранилища(АдресХранилища);
	КонецЕсли;
	
	МенеджерОбъекта 			= ИнтеграцияИС_МенеджерОбъектаПоСсылке(ДокСтруктура.СсылкаНаДокумент);
	ДальнейшееДействие 			= МенеджерОбъекта.ДальнейшееДействиеПоУмолчанию(Новый Структура("ОбъектРасчета", ДокСтруктура.ДокументОбъект));
	ДопустимыеДействия 			= Новый Массив;
			
	Возврат ОбщегоНазначения.ОбщийМодуль("ИнтеграцияИСМП").ПредставлениеСтатуса(ДокСтруктура.СтатусИСМП, ДальнейшееДействие, ДопустимыеДействия);
	
КонецФункции

