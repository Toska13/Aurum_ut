//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_4_ВозвратТоваровОтКлиента_ПослеОткрытияФормыДокумента	() Экспорт
	
	ИмяСобытия = "УТ_11_4_ВозвратТоваровОтКлиента_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;

	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма 			= СтруктураПараметров.ФормаДокумента;		
		ДокументОбъект 	= Форма.Объект;		
		
		СтруктураОбъекта = Новый Структура("Организация,Дата,Склад,Договор,НаправлениеДеятельности,Подразделение,ХозяйственнаяОперация");
		ЗаполнитьЗначенияСвойств(СтруктураОбъекта, ДокументОбъект);		
		ЗаполнитьНалогообложениеНДСПродажиВозврата(ДокументОбъект.НалогообложениеНДС, СтруктураОбъекта);				
		
		СуммаВсего = ?(СтруктураПараметров.ФормаДокумента.Объект.ПредусмотренЗалогЗаТару Или Не СтруктураПараметров.ФормаДокумента.Объект.ВозвратПереданнойМногооборотнойТары,
			СтруктураПараметров.ФормаДокумента.Объект.Товары.Итог("СуммаСНДС"),
			СтруктураПараметров.ФормаДокумента.Объект.Товары.Итог("СуммаСНДСБезВозвратнойТары"));
		СтруктураПараметров.ФормаДокумента.СуммаНДС = ?(СтруктураПараметров.ФормаДокумента.Объект.ПредусмотренЗалогЗаТару Или Не СтруктураПараметров.ФормаДокумента.Объект.ВозвратПереданнойМногооборотнойТары,
			СтруктураПараметров.ФормаДокумента.Объект.Товары.Итог("СуммаНДС"),
			СтруктураПараметров.ФормаДокумента.Объект.Товары.Итог("СуммаНДСБезВозвратнойТары"));			
			
		Попытка
			ОбщегоНазначенияКлиент.ОбщийМодуль("ФинансыКлиентСервер").ПересчитатьСуммыВСтрокеРасшифровкиПлатежа(СтруктураПараметров.ФормаДокумента.Объект, СуммаВсего);
		Исключение
			Сообщить("Не удалось пересчитать суммы в строке расшифровки платежа. Причина: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		Попытка
			СуммаУменьшенДолг = УТ_11_4_ВозвратТоваровОтКлиента_ОбновитьРаспределеннуюСуммуРасшифровки(ДокументОбъект);
		Исключение
			СуммаУменьшенДолг = 0;
			Для Каждого СтрокаРасшифровкаПлатежа Из СтруктураПараметров.ФормаДокумента.Объект.РасшифровкаПлатежа Цикл
				Если ЗначениеЗаполнено(СтрокаРасшифровкаПлатежа.Заказ) Тогда
					СуммаУменьшенДолг = СуммаУменьшенДолг + СтрокаРасшифровкаПлатежа.Сумма;
				КонецЕсли;
			КонецЦикла;
		КонецПопытки;
		
		СтруктураПараметров.ФормаДокумента.СуммаВсего 		= СуммаВсего;
		СтруктураПараметров.ФормаДокумента.СуммаКомпенсации = СуммаВсего - СуммаУменьшенДолг;
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ПеремаркировкаТоваровИСМП, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_4_ПеремаркировкаТоваровИСМП_ПослеОткрытияФормыДокумента() Экспорт
	
	ИмяСобытия = "УТ_11_4_ПеремаркировкаТоваровИСМП_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Форма 						= СтруктураПараметров.ФормаДокумента;
		СсылкаНаДокумент 			= СтруктураПараметров.СсылкаНаДокумент;		
		ДокументОбъект 				= Форма.Объект;		
		
		ДокСтруктура = Новый Структура("СсылкаНаДокумент,ДокументОбъект,СтатусИСМП", СсылкаНаДокумент, ДокументОбъект, Форма.СтатусИСМП);
		АдресХранилища = ПоместитьВоВременноеХранилище(ДокСтруктура);
		Форма.СтатусПредставление 	= ВернутьСтатусДокумента(АдресХранилища);		
		
		Для Каждого Строка из ДокументОбъект.Товары Цикл
			
			Если Не ЗначениеЗаполнено(Строка.ВидДокументаСертификации) Тогда
				Продолжить;
			КонецЕсли;
			
			Строка.Сертификация = УТ_11_4_МаркировкаТоваровИСМП_ПредставлениеСертификации(
				Строка.ВидДокументаСертификации, 
				Строка.НомерДокументаСертификации, 
				Строка.ДатаДокументаСертификации);
				
		КонецЦикла;
		
		Попытка
			КопироватьДанныеФормы(ДокументОбъект, Форма.Объект);				
		Исключение
			// Ничего...
		КонецПопытки;
		
		Форма.Модифицированность = Ложь;
		
	Исключение
		
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
		
	КонецПопытки;

КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ПередачаТоваровМеждуОрганизациями, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_4_ПередачаТоваровМеждуОрганизациями_ПослеОткрытияФормыДокумента	() Экспорт
	
	ИмяСобытия = "УТ_11_4_ПередачаТоваровМеждуОрганизациями_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;

	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;		
		
		// см. Документ.ПередачаТоваровМеждуОрганизациями.Форма.ФормаДокумента.РассчитатьИтоговыеПоказателиПередачиТоваровМеждуОрганизациями
		Форма.СуммаВсего = Форма.Объект.Товары.Итог("Сумма");
		
		Если Не Форма.Объект.ЦенаВключаетНДС Тогда
			Форма.СуммаВсего = Форма.СуммаВсего + Форма.Объект.Товары.Итог("СуммаНДС");
		КонецЕсли;
		
		Если Не ОбщегоНазначенияКлиент.ОбщийМодуль("УчетНДСУПКлиентСервер").ОтображатьНДСВИтогахДокументаПродажи(Форма.Объект.НалогообложениеНДС) Тогда
			Форма.Элементы.ГруппаСтраницыНДС.ТекущаяСтраница   = Форма.Элементы.СтраницаБезНДС;
			Форма.Элементы.ГруппаСтраницыВсего.ТекущаяСтраница = Форма.Элементы.СтраницаВсегоБезНДС;
		Иначе
			Форма.Элементы.ГруппаСтраницыНДС.ТекущаяСтраница   = Форма.Элементы.СтраницаСНДС;
			Форма.Элементы.ГруппаСтраницыВсего.ТекущаяСтраница = Форма.Элементы.СтраницаВсегоСНДС;
		КонецЕсли;
		// РассчитатьИтоговыеПоказателиПередачиТоваровМеждуОрганизациями
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ВозвратТоваровМеждуОрганизациями, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_4_ВозвратТоваровМеждуОрганизациями_ПослеОткрытияФормыДокумента	() Экспорт
	
	ИмяСобытия = "УТ_11_4_ВозвратТоваровМеждуОрганизациями_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;

	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;		
		
		// см. Документ.ВозвратТоваровМеждуОрганизациями.Форма.ФормаДокумента.НастроитьИтогиФормы
		Если Не ОбщегоНазначенияКлиент.ОбщийМодуль("УчетНДСУПКлиентСервер").ОтображатьНДСВИтогахДокументаЗакупки(Форма.Объект.НалогообложениеНДС) Тогда
			Форма.Элементы.ГруппаСтраницыНДС.ТекущаяСтраница   = Форма.Элементы.СтраницаБезНДС;
			Форма.Элементы.ГруппаСтраницыВсего.ТекущаяСтраница = Форма.Элементы.СтраницаВсегоБезНДС;
		Иначе
			Форма.Элементы.ГруппаСтраницыНДС.ТекущаяСтраница   = Форма.Элементы.СтраницаСНДС;
			Форма.Элементы.ГруппаСтраницыВсего.ТекущаяСтраница = Форма.Элементы.СтраницаВсегоСНДС;
		КонецЕсли;
		// НастроитьИтогиФормы
		
		КэшированныеЗначения = Неопределено;
		
		// см. Документ.ВозвратТоваровМеждуОрганизациями.Форма.ФормаДокумента.УстановитьПредставлениеСебестоимостиВСтроке
		ПараметрыОпределенияСебестоимости = Новый Структура;
		ПараметрыОпределенияСебестоимости.Вставить("НалогообложениеНДС", 				Форма.Объект.НалогообложениеНДС);
		ПараметрыОпределенияСебестоимости.Вставить("ВалютаУправленческогоУчета", 		Форма.ВалютаУправленческогоУчета);
		ПараметрыОпределенияСебестоимости.Вставить("ВалютаРегламентированногоУчета", 	Форма.ВалютаРегламентированногоУчета);
		ПараметрыОпределенияСебестоимости.Вставить("ИспользоватьРеглУчет",  			Форма.ИспользоватьРеглУчет);
		
		Для каждого СтрокаДокумента ИЗ Форма.Объект.Товары Цикл
			СтруктураДействий = Новый Структура("ЗаполнитьСпособОпределенияСебестоимостиСтрокой", ПараметрыОпределенияСебестоимости);
			
			Попытка
				ОбщегоНазначенияКлиент.ОбщийМодуль("ОбработкаТабличнойЧастиКлиент").ОбработатьСтрокуТЧ(СтрокаДокумента, СтруктураДействий, КэшированныеЗначения);
			Исключение
				ОбщегоНазначенияКлиент.ОбщийМодуль("ОбработкаТабличнойЧастиТоварыКлиент").ПриИзмененииРеквизитовВТЧКлиент(Форма.Объект.Товары, СтрокаДокумента, СтруктураДействий, Неопределено);
			КонецПопытки;
		КонецЦикла;
		// УстановитьПредставлениеСебестоимостиВСтроке
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьЦенников

// Вызывает окно выбора шаблона этикетки/ценника для последующей печати
//
// Параметры:
//	ДанныеДляПечати - ДанныеФормыКоллекция - содержит данные для печати из формы просмотра документа Mobile Smarts
&НаКлиенте
Процедура ПечатьЦенников(ДанныеДляПечати) Экспорт
	
	ОповещениеВыбораШаблона = Новый ОписаниеОповещения("ПослеВыбораШаблона", ЭтаФорма, ДанныеДляПечати);
	ПоказатьВводЗначения(ОповещениеВыбораШаблона, ПредопределенноеЗначение("Справочник.ШаблоныЭтикетокИЦенников.ПустаяСсылка"), "Выберите шаблон ценника",);	
	
КонецПроцедуры

// Формирует структуру данных для печати этикеток/ценников на основании данных формы просмотра документа Mobile Smarts.
// Открывает форму обработки печати этикеток/ценников и передает в нее полученную структуру данных.
//
// Параметры:
//	ШаблонЦенника - СправочникСсылка.ШаблоныЭтикетокИЦенников - выбранный шаблон этикетки/ценника	
//	ДанныеДляПечати - ДанныеФормыКоллекция - содержит данные для печати из формы просмотра документа Mobile Smarts
&НаКлиенте
Процедура ПослеВыбораШаблона(ШаблонЦенника, ДанныеДляПечати) Экспорт
	
	Если ЗначениеЗаполнено(ШаблонЦенника) Тогда
		
		ПараметрыФормы = ДанныеДляПечати(ДанныеДляПечати, ШаблонЦенника);
		
		Попытка
			
			ФормаКОткрытию = ПолучитьФорму(ПараметрыФормы.ИмяФормыПечати,, ЭтаФорма);
			
			ОбъектФормы = ФормаКОткрытию.Объект;
			ЗаполнитьОбъектПечатиЦенников(ОбъектФормы, ДанныеДляПечати, ШаблонЦенника);
			КопироватьДанныеФормы(ОбъектФормы, ФормаКОткрытию.Объект);
			
			Если ФормаКОткрытию.Объект.Товары.Количество() <> 0 Тогда
				ФормаКОткрытию.Открыть();
			Иначе
				Сообщить("Нет данных для печати");
			КонецЕсли;
			
		Исключение
			
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Сообщить("Не удалось открыть форму печати ценников. Причина: "
			+ ТекстОшибки);
			
		КонецПопытки;
		
	КонецЕсли;
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеДляПечати(ДанныеДляПечати, Шаблон)
			
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьОрганизацию", 					Справочники["Организации"].ОрганизацияПоУмолчанию());
	СтруктураДействий.Вставить("УстановитьРежим", 						"ПечатьЦенников");
	СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Ложь);	
	
	СтруктураТовары = Новый Структура;
	СтруктураТовары.Вставить("СтруктураДействий", 	СтруктураДействий);
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("АдресВХранилище", 					ПоместитьВоВременноеХранилище(СтруктураТовары));
	СтруктураПараметры.Вставить("ИмяФормыПечати", 					"Обработка.ПечатьЭтикетокИЦенников.Форма");
	СтруктураПараметры.Вставить("ИмяВОбъектеФормы", 				"Товары");
	СтруктураПараметры.Вставить("ЗакрыватьПриЗакрытииВладельца", 	Истина);	

	Возврат СтруктураПараметры;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьОбъектПечатиЦенников(ОбъектФормы, ДанныеДляПечати, ШаблонЦенника)
	
	ЭтоЦенник = ?(ШаблонЦенника.Назначение = Перечисления.НазначенияШаблоновЭтикетокИЦенников.ЦенникДляТоваров, Истина, Ложь);
	
	ТаблицаДанных = ДанныеФормыВЗначение(ДанныеДляПечати, Тип("ТаблицаЗначений"));
	
	УчетПоХарактеристикам = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	
	КолонкиТаблицыДанных  = ТаблицаДанных.Колонки;
	
	КолонкиТаблицыДанных.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
	
	ЕстьКолонкаЦенаПечать = КолонкиТаблицыДанных.Найти("ЦенаПечать") <> Неопределено;
	ЕстьКолонкаЦена 	  = КолонкиТаблицыДанных.Найти("Цена") <> Неопределено;
	ЕстьКолонкаНовШК 	  = КолонкиТаблицыДанных.Найти("НовШК") <> Неопределено;
	ЕстьКолонкаОснШК 	  = КолонкиТаблицыДанных.Найти("ОснШК") <> Неопределено;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл 		
		
		Если Не СтрокаТаблицы.Флаг Тогда
			Продолжить;
		КонецЕсли;
		
		Цена = 0;
		Если ЕстьКолонкаЦенаПечать И ЗначениеЗаполнено(СтрокаТаблицы.ЦенаПечать) Тогда
			Цена = СтрокаТаблицы.ЦенаПечать;			
		ИначеЕсли ЕстьКолонкаЦена И ЗначениеЗаполнено(СтрокаТаблицы.Цена) Тогда			
			Цена = СтрокаТаблицы.Цена;			
		КонецЕсли;
		
		ШтрихкодТСД = СтрокаТаблицы.ШК;
		Если ЕстьКолонкаНовШК И ЗначениеЗаполнено(СтрокаТаблицы.НовШК) Тогда
			ШтрихкодТСД = СтрокаТаблицы.НовШК;			
		ИначеЕсли ЕстьКолонкаОснШК И ЗначениеЗаполнено(СтрокаТаблицы.ОснШК) Тогда			
			ШтрихкодТСД = СтрокаТаблицы.ОснШК;			
		КонецЕсли;
		
		СтрокаТаблицы.ХарактеристикиИспользуются = УчетПоХарактеристикам И ЗначениеЗаполнено(СтрокаТаблицы.Характеристика);
		
		НоваяСтрокаТовары = ОбъектФормы.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары, СтрокаТаблицы);
		НоваяСтрокаТовары.Выбран 				= Истина;
		НоваяСтрокаТовары.Характеристика 		= ?(УчетПоХарактеристикам, НоваяСтрокаТовары.Характеристика, ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
		НоваяСтрокаТовары.ШтрихКод 				= ШтрихкодТСД;
		НоваяСтрокаТовары.Цена 					= Цена;		
		Если ЭтоЦенник Тогда
		НоваяСтрокаТовары.ШаблонЦенника 		= ШаблонЦенника; 
		НоваяСтрокаТовары.КоличествоЦенников 	= СтрокаТаблицы.КоличествоФакт;
		Иначе	
		НоваяСтрокаТовары.ШаблонЭтикетки 		= ШаблонЦенника; 
		НоваяСтрокаТовары.КоличествоЭтикеток 	= СтрокаТаблицы.КоличествоФакт;
	КонецЕсли;
		
	КонецЦикла;
	
	//Для Каждого СтрокаТовары Из ОбъектФормы.Товары Цикл
	//	НоваяСтрока = 
	//КонецЦикла;
	
КонецПроцедуры

