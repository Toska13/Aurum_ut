&НаКлиенте
Процедура УТ_11_2_ТТНВходящаяЕГАИС_ПослеОткрытияФормыДокумента			() Экспорт
	
	ИмяСобытия = "УТ_11_2_ТТНВходящаяЕГАИС_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;
	
	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;
		
		Попытка 
			
			тчТовары = Форма.Объект.Товары;																						
			Для каждого Стр Из тчТовары Цикл					
				Стр.РасхождениеКоличества = Стр.Количество <> Стр.КоличествоФакт;										
			КонецЦикла;								
			
			Форма.Элементы.ТоварыКоличествоФакт.Видимость = Форма.Объект.ЕстьРасхождения;
			
		Исключение
		КонецПопытки;	
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ТТНИсходящаяЕГАИС, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_2_ТТНИсходящаяЕГАИС_ПослеОткрытияФормыДокумента			() Экспорт
	
	ИмяСобытия = "УТ_11_2_ТТНИсходящаяЕГАИС_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;
	
	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;
		
		Попытка 
			
			тчТовары = Форма.Объект.Товары;																						
			Для каждого Стр Из тчТовары Цикл					
				Стр.РасхождениеКоличества = Стр.КоличествоУпаковок <> Стр.КоличествоФакт;										
			КонецЦикла;	
			
			Форма.Элементы.ТоварыКоличествоФакт.Видимость = Форма.Объект.ЕстьРасхождения;
			
		Исключение
		КонецПопытки;
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа МаркировкаТоваровГИСМ, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_2_МаркировкаТоваровГИСМ_ПослеОткрытияФормыДокумента			() Экспорт
	
	
	ИмяСобытия = "УТ_11_2_МаркировкаТоваровГИСМ_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;
	
	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;
		
		ДанныеОбъекта = Новый Структура;
		ДанныеОбъекта.Вставить("КиЗГИСМВид", 					Форма.Объект.КиЗГИСМВид);
		ДанныеОбъекта.Вставить("КиЗГИСМРазмер", 				Форма.Объект.КиЗГИСМРазмер);
		ДанныеОбъекта.Вставить("КиЗГИСМСпособВыпускаВОборот", 	Форма.Объект.КиЗГИСМСпособВыпускаВОборот);
		ДанныеОбъекта.Вставить("КиЗГИСМСИндивидуализацией", 	Форма.Объект.КиЗГИСМСИндивидуализацией);								
		
		СписокНоменклатураКиЗ = Новый СписокЗначений;
		СписокНоменклатураКиЗ.ЗагрузитьЗначения(Форма.СписокНоменклатураКиЗ.ВыгрузитьЗначения());
		
		УТ_11_2_ЗаполнитьКИЗ(ДанныеОбъекта, СписокНоменклатураКиЗ);
		
		Форма.СписокНоменклатураКиЗ.ЗагрузитьЗначения(СписокНоменклатураКиЗ.ВыгрузитьЗначения());
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ЗаказНаЭмиссиюКМ, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_4_ЗаказНаЭмиссиюКМ_ПослеОткрытияФормы() Экспорт
	
	ИмяСобытия = "УТ_11_4_ЗаказНаЭмиссиюКМ_ПослеОткрытияФормы";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Форма = СтруктураПараметров.ФормаДокумента;
		ДокументОбъект = Форма.Объект;
		ЭлементыФормы  = Форма.Элементы;
		
		ЗначенияПеречисления = УТ_11_4_ПолучитьЗначенияПеречисления("ВидыПродукцииИС");
		
		ЭтоНикотиносодержащаяПродукция = ЗначенияПеречисления.Найти("НикотиносодержащаяПродукция") <> Неопределено
			И ДокументОбъект.ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.НикотиносодержащаяПродукция");
		
		Форма.ЭтоМаркировкаОстатков =
			ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.МаркировкаОстатков")
			И НЕ ЭтоНикотиносодержащаяПродукция;
		
		ЭтоТрансграничнаяТорговля = ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.ТрансграничнаяТорговля");
		
		Попытка
			ЭтоКомиссия = ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.Комиссия");
		Исключение
			// Адаптация к старым релизам
			ЭтоКомиссия = Ложь;	
		КонецПопытки;
		
		ЭтоШины                 = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Шины");
		ЭтоДухи                 = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Духи");
		ЭтоМолочнаяПродукция    = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "МолочнаяПродукцияПодконтрольнаяВЕТИС");
		ЭтоОбувь                = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Обувь");
		ЭтоЛегкаяПромышленность = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ЛегкаяПромышленность")
			ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ЛегкаяПромышленность2025");
		ЭтоТабак                = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Табак");
		ЭтоАльтернативныйТабак  = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "АльтернативныйТабак");
		ЭтоТабачнаяПродукция    = ИнтеграцияИСКлиентСервер_ЭтоПродукцияМОТП(ДокументОбъект.ВидПродукции);
		ЭтоМех                  = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ПродукцияИзНатуральногоМеха");
		ЭтоАнтисептики          = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Антисептики")
			ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ДезинфицирующиеСредства");
		ЭтоБАД                  = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "БАДы")
			ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "БАДы2025");
		ЭтоКреслаКоляски        = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "КреслаКоляски")
			ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ТехническиеСредстваРеабилитации")
			ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "МедицинскиеИзделия")
			ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "МедицинскиеИзделия20");
		ЭтоВелосипеды           = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Велосипеды");
		ЭтоТитановаяПродукция   = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ТитановаяМеталлопродукция");
		
		Попытка
			ДоставкаЭмитентомДоУказанногоМеста = ПредопределенноеЗначение("Перечисление.СпособыПолученияИзготовленныхКИЗГИСМ.ДоставкаЭмитентомДоУказанногоМеста");
		Исключение
			// Адаптация к старым релизам
			ДоставкаЭмитентомДоУказанногоМеста = Ложь;	
		КонецПопытки;
		
		ВидимостьАдреса = (ЭтоТабачнаяПродукция И Не Форма.ЭтоМаркировкаОстатков)
			Или ЭтоМех
			И ДокументОбъект.СпособПолучения = ДоставкаЭмитентомДоУказанногоМеста;
		
		Попытка	
			ЭлементыФормы.ТоварыМаксимальнаяРозничнаяЦена.Видимость             = ЭтоТабак;
			ЭлементыФормы.ПроизводственныйОбъектИдентификатор.Видимость         = (ЭтоТабачнаяПродукция И Не Форма.ЭтоМаркировкаОстатков);
			ЭлементыФормы.ИдентификаторПроизводственнойЛинии.Видимость          = (ЭтоТабачнаяПродукция И Не Форма.ЭтоМаркировкаОстатков);
			ЭлементыФормы.ОжидаемаяДатаНачалаПроизводства.Видимость             = (ЭтоТабачнаяПродукция И Не Форма.ЭтоМаркировкаОстатков);
			ЭлементыФормы.ПредставлениеАдресаПроизводственногоОбъекта.Видимость = ВидимостьАдреса;
		Исключение
			// Адаптация к старым релизам
			Если ЭлементыФормы.Найти("ГруппаМОТП") <> Неопределено Тогда
				ЭлементыФормы.ТоварыМаксимальнаяРозничнаяЦена.Видимость = ЭтоТабак;
				ЭлементыФормы.ГруппаМОТП.Видимость                      = (ЭтоТабачнаяПродукция И Не Форма.ЭтоМаркировкаОстатков);
			Иначе
				Если ЭтоТабак Тогда
					Если ЭлементыФормы.Найти("ГруппаТабачнаяПродукция") <> Неопределено Тогда
						ЭлементыФормы.ГруппаТабачнаяПродукция.Видимость         = Истина;
					КонецЕсли;
					Если ЭлементыФормы.Найти("ТоварыМаксимальнаяРозничнаяЦена") <> Неопределено Тогда
						ЭлементыФормы.ТоварыМаксимальнаяРозничнаяЦена.Видимость = Истина;
					КонецЕсли;
					Если ЭлементыФормы.Найти("ГруппаОбувнаяПродукция") <> Неопределено Тогда
						ЭлементыФормы.ГруппаОбувнаяПродукция.Видимость          = Ложь;
					КонецЕсли;
				ИначеЕсли ИнтеграцияИСКлиентСервер_ЭтоПродукцияИСМП(ДокументОбъект.ВидПродукции) Тогда
					Если ЭлементыФормы.Найти("ГруппаТабачнаяПродукция") <> Неопределено Тогда
						ЭлементыФормы.ГруппаТабачнаяПродукция.Видимость         = Ложь;
					КонецЕсли;
					Если ЭлементыФормы.Найти("ТоварыМаксимальнаяРозничнаяЦена") <> Неопределено Тогда
						ЭлементыФормы.ТоварыМаксимальнаяРозничнаяЦена.Видимость = Ложь;
					КонецЕсли;
					Если ЭлементыФормы.Найти("ГруппаОбувнаяПродукция") <> Неопределено Тогда
						ЭлементыФормы.ГруппаОбувнаяПродукция.Видимость          = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецПопытки;
		
		Попытка
			Форма.ИспользуютсяНаборы            = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетНаборы(ДокументОбъект.ВидПродукции);
			Форма.ИспользуютсяГрупповыеУпаковки = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетГрупповыеУпаковки(ДокументОбъект.ВидПродукции);
			Форма.ШаблоныГрупповойУпаковки      = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ВидПродукции, 4);
			Форма.ШаблоныНабора                 = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ВидПродукции, 5);
			Если Форма.ИспользуютсяНаборы И Форма.ИспользуютсяГрупповыеУпаковки Тогда
				ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Заголовок = НСтр("ru = 'Перезаполнить наборы / групповые упаковки'");
				ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Заголовок =
					НСтр("ru = 'Установить отбор строк по набору / групповой упаковке'");
			ИначеЕсли Форма.ИспользуютсяНаборы Тогда
				ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Заголовок = НСтр("ru = 'Перезаполнить наборы'");
				ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Заголовок =
					НСтр("ru = 'Установить отбор строк по набору'");
			ИначеЕсли Форма.ИспользуютсяГрупповыеУпаковки Тогда
				ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Заголовок = НСтр("ru = 'Перезаполнить групповые упаковки'");
				ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Заголовок =
					НСтр("ru = 'Установить отбор строк по групповой упаковке'");
			КонецЕсли;
			ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Видимость =
				Форма.ИспользуютсяНаборы Или Форма.ИспользуютсяГрупповыеУпаковки;
			ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Видимость =
				Форма.ИспользуютсяНаборы Или Форма.ИспользуютсяГрупповыеУпаковки;
		Исключение
			// Адаптация к старым релизам				
		КонецПопытки;
		
		Попытка
			Форма.ИспользованиеСервисПровайдераЗапрещено =
				ЭтоТабачнаяПродукция Или ЭтоКомиссия Или ЭтоМех Или ЭтоТитановаяПродукция;
			ЭлементыФормы.ГруппаСервисПровайдер.Видимость =
				Не Форма.ИспользованиеСервисПровайдераЗапрещено;
			ЭлементыФормы.СервисПровайдер.Доступность =
				Форма.ПечатьКодовМаркировки = 1;
		Исключение
			// Адаптация к старым релизам
		КонецПопытки;
		
		Попытка
			ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВКаталогGS46.Видимость         =
				ЭтоОбувь И Форма.ОтображатьКомандуТоварыПодготовитьПередатьСведенияОТоварахВКаталогGS46;
			ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог.Видимость =
				Форма.ОтображатьКомандуТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог;
			ЭлементыФормы.ТоварыВключить1СНоменклатуру.Видимость                                  =
				Форма.ОтображатьКомандуВключить1СНоменклатуру;
		Исключение
			// Адаптация к старым релизам
			Если ЭлементыФормы.Найти("ТоварыПодготовитьПередатьСведенияОТоварахВКаталогGS46") <> Неопределено Тогда
				Если ЭтоОбувь Тогда
					ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВКаталогGS46.Видимость         = Форма.ОтображатьКомандуТоварыПодготовитьПередатьСведенияОТоварахВКаталогGS46;
					ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог.Видимость = Ложь;
					ЭлементыФормы.ТоварыВключить1СНоменклатуру.Видимость                                  = Ложь;
				Иначе
					ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВКаталогGS46.Видимость         = Ложь;
					ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог.Видимость = Форма.ОтображатьКомандуТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог;
					ЭлементыФормы.ТоварыВключить1СНоменклатуру.Видимость                                  = Форма.ОтображатьКомандуВключить1СНоменклатуру;
				КонецЕсли;
			Иначе
				ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварах.Видимость = ЭтоОбувь И Форма.ОтображатьКомандуТоварыПодготовитьПередатьСведенияОТоварах;
			КонецЕсли;
		КонецПопытки;
		
		Попытка
			ЭтоРасширеннаяМаркировкаОстатковЛегкойПромышленности = УТ_11_4_ЗаказНаЭмиссиюКодовМаркировкиСУЗ_ЭтоРасширеннаяМаркировкаОстатковЛегкойПромышленности(Форма);
		Исключение
			// Адаптация к старым релизам
			ЭтоРасширеннаяМаркировкаОстатковЛегкойПромышленности = Ложь;
		КонецПопытки;
		
		Попытка
			Если (Форма.ЭтоМаркировкаОстатков И Не ЭтоЛегкаяПромышленность)
				Или ЭтоРасширеннаяМаркировкаОстатковЛегкойПромышленности Тогда
				
				Если ЭтоРасширеннаяМаркировкаОстатковЛегкойПромышленности Тогда
					ПолноеОписание = Неопределено;
				Иначе
					ПолноеОписание = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ИспользованиеСпособаОписанияОстатков(ДокументОбъект.ВидПродукции);
				КонецЕсли;
				
				ПараметрыОписанияОстатков =
					ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ИспользованиеПараметровОписанияОстатковПоВидуПродукции(ДокументОбъект.ВидПродукции);
				
				ЭлементыФормы.БезУчетаНоменклатуры.Видимость = Не ЭтоАльтернативныйТабак И Не ЭтоДухи
					И Не ЭтоАнтисептики И Не ЭтоБАД И Не ЭтоКреслаКоляски И Не ЭтоВелосипеды;
				
				БылДоступен = ДокументОбъект.ВвезенПослеДатыОбязательнойМаркировки
					И (ЭтоДухи Или ЭтоШины Или ЭтоЛегкаяПромышленность Или ЭтоОбувь);
				СейчасДоступен = Не ЭтоТабачнаяПродукция
					И Не ЭтоАнтисептики И Не ЭтоБАД И Не ЭтоКреслаКоляски И Не ЭтоВелосипеды
					Или БылДоступен;
				ЭлементыФормы.ВвезенПослеДатыОбязательнойМаркировки.Видимость = СейчасДоступен;
				
				БылДоступен = ДокументОбъект.ПриобретенПроизведенПослеДатыОбязательнойМаркировки
					И (ЭтоДухи Или ЭтоШины Или ЭтоЛегкаяПромышленность Или ЭтоОбувь);
				СейчасДоступен = Не ЭтоТабачнаяПродукция
					И Не ЭтоАнтисептики И Не ЭтоБАД И Не ЭтоКреслаКоляски И Не ЭтоВелосипеды
					Или БылДоступен;
				ЭлементыФормы.ПриобретенПроизведенПослеДатыОбязательнойМаркировки.Видимость = СейчасДоступен;
				
				ЭлементыФормы.ЗаполнитьПараметрыОписанияОстатков.Видимость = (Не ПолноеОписание = Истина);
				
				ЭлементыФормы.ТоварыПолноеОписаниеОстатков.Видимость = (ПолноеОписание = Неопределено);
				ЭлементыФормы.ТоварыКодТНВЭД.Видимость               = (Не ПолноеОписание = Истина);
				ЭлементыФормы.ТоварыЦелевойПол.Видимость             = ПараметрыОписанияОстатков.ИспользоватьЦелевойПол;
				ЭлементыФормы.ТоварыВозрастнаяКатегория.Видимость    = ПараметрыОписанияОстатков.ИспользоватьВозрастнуюКатегорию;
				ЭлементыФормы.ТоварыМодель.Видимость                 = ПараметрыОписанияОстатков.ИспользоватьМодель;
				ЭлементыФормы.ТоварыСпособВводаВОборот.Видимость     = ПараметрыОписанияОстатков.ИспользоватьСпособВводаВОборот;
				ЭлементыФормы.ТоварыНаименование.Видимость           = ПараметрыОписанияОстатков.ИспользоватьНаименование;
				ЭлементыФормы.ТоварыТоварныйЗнак.Видимость           = (Не ПолноеОписание = Истина);
				
			Иначе
				
				ЭлементыФормы.БезУчетаНоменклатуры.Видимость                                = Ложь;
				ЭлементыФормы.ВвезенПослеДатыОбязательнойМаркировки.Видимость               = Ложь;
				ЭлементыФормы.ПриобретенПроизведенПослеДатыОбязательнойМаркировки.Видимость = Ложь;
				ЭлементыФормы.ЗаполнитьПараметрыОписанияОстатков.Видимость                  = Ложь;
				
				ЭлементыФормы.ТоварыПолноеОписаниеОстатков.Видимость = Ложь;
				ЭлементыФормы.ТоварыКодТНВЭД.Видимость               = ЭтоМех;
				ЭлементыФормы.ТоварыЦелевойПол.Видимость             = Ложь;
				ЭлементыФормы.ТоварыВозрастнаяКатегория.Видимость    = Ложь;
				ЭлементыФормы.ТоварыМодель.Видимость                 = Ложь;
				ЭлементыФормы.ТоварыСпособВводаВОборот.Видимость     = ЭтоМех;
				ЭлементыФормы.ТоварыНаименование.Видимость           = Ложь;
				ЭлементыФормы.ТоварыТоварныйЗнак.Видимость           = ЭтоТабак Или ЭтоАльтернативныйТабак;
				
			КонецЕсли;
		Исключение
			// Адаптация к старым релизам
			Попытка
				ВидПродукцииПодлежитМаркировкеОстатков = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииПодлежитМаркировкеОстатков(ДокументОбъект.ВидПродукции);
			Исключение
				ВидПродукцииПодлежитМаркировкеОстатков = Ложь;
			КонецПопытки;		
		
			ЭлементыФормы.ТоварыКодТНВЭД.Видимость                            			 = Форма.ЭтоМаркировкаОстатков;
			ЭлементыФормы.ЗаполнитьПараметрыОписанияОстатков.Видимость                  = ВидПродукцииПодлежитМаркировкеОстатков И Форма.ЭтоМаркировкаОстатков;
			ЭлементыФормы.БезУчетаНоменклатуры.Видимость                                = ВидПродукцииПодлежитМаркировкеОстатков И Форма.ЭтоМаркировкаОстатков И Не ЭтоАльтернативныйТабак;
			ЭлементыФормы.ВвезенПослеДатыОбязательнойМаркировки.Видимость               = ВидПродукцииПодлежитМаркировкеОстатков И Форма.ЭтоМаркировкаОстатков И Не ЭтоТабачнаяПродукция;
			ЭлементыФормы.ПриобретенПроизведенПослеДатыОбязательнойМаркировки.Видимость = ВидПродукцииПодлежитМаркировкеОстатков И Форма.ЭтоМаркировкаОстатков И Не ЭтоТабачнаяПродукция;
			ЭлементыФормы.ТоварыПолноеОписаниеОстатков.Видимость                        = ВидПродукцииПодлежитМаркировкеОстатков И Форма.ЭтоМаркировкаОстатков И Не ЭтоТабак;
			
			Если ЭлементыФормы.Найти("ТоварыНаименование") <> Неопределено Тогда
				ЭлементыФормы.ТоварыНаименование.Видимость = Форма.ЭтоМаркировкаОстатков И ЭтоТабачнаяПродукция;
			КонецЕсли;
			
			Если Форма.ЭтоМаркировкаОстатков Тогда
				ЭлементыФормы.ТоварыЦелевойПол.Видимость          = ЭтоОбувь Или ЭтоЛегкаяПромышленность;
				ЭлементыФормы.ТоварыСпособВводаВОборот.Видимость  = ЭтоОбувь Или ЭтоЛегкаяПромышленность;
				ЭлементыФормы.ТоварыМодель.Видимость              = ЭтоШины;
				ЭлементыФормы.ТоварыВозрастнаяКатегория.Видимость = ЭтоЛегкаяПромышленность;
				ЭлементыФормы.ТоварыТоварныйЗнак.Видимость        = Не ЭтоОбувь;
			Иначе
				ЭлементыФормы.ТоварыЦелевойПол.Видимость          = Ложь;
				ЭлементыФормы.ТоварыСпособВводаВОборот.Видимость  = Ложь;
				ЭлементыФормы.ТоварыТоварныйЗнак.Видимость        = ЭтоТабачнаяПродукция;
				ЭлементыФормы.ТоварыМодель.Видимость              = Ложь;
				ЭлементыФормы.ТоварыВозрастнаяКатегория.Видимость = Ложь;
			КонецЕсли;
		КонецПопытки;
		
		ЭлементыФормы.ТоварыШаблон.СписокВыбора.Очистить();
		
		ДоступныеШаблоны = Неопределено;
		Попытка
			ДоступныеШаблоны = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ВидПродукции, 3);
		Исключение 
			// Адаптация к старым релизам
		КонецПопытки;
		
		Если ДоступныеШаблоны = Неопределено Тогда
			Попытка
				ДоступныеШаблоны = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ВидПродукции);
			Исключение
				ВключатьКомлекты = Не Форма.ЭтоМаркировкаОстатков;
				
				ДоступныеШаблоны = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ВидПродукции, ВключатьКомлекты);
			КонецПопытки;
		КонецЕсли;
		
		Для Каждого ЭлементСпискаЗначений Из ДоступныеШаблоны Цикл
			ЭлементыФормы.ТоварыШаблон.СписокВыбора.Добавить(
				ЭлементСпискаЗначений.Значение, ЭлементСпискаЗначений.Представление);
		КонецЦикла;
			
		Если ЭтоМолочнаяПродукция Тогда
			ЭлементыФормы.ТоварыШаблон.Заголовок = НСтр("ru = 'Шаблон КМ';
				|en = 'Шаблон КМ'");
		Иначе
			ЭлементыФормы.ТоварыШаблон.Заголовок = НСтр("ru = 'Вид упаковки';
				|en = 'Вид упаковки'");
		КонецЕсли;
		
		ЭтоУстаревшаяМолочнаяПродукция = Ложь;
		
		Попытка
			Если ЭтоМолочнаяПродукция Тогда
				Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
					Если СтрокаТовары.Шаблон = ПредопределенноеЗначение("Перечисление.ШаблоныКодовМаркировкиСУЗ.СкоропортящаясяМолочнаяПродукцияВЕТИС")
						Или СтрокаТовары.Шаблон = ПредопределенноеЗначение("Перечисление.ШаблоныКодовМаркировкиСУЗ.МолочнаяПродукцияПодконтрольнаяВЕТИС") Тогда
						ЭтоУстаревшаяМолочнаяПродукция = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ЭтоУстаревшаяМолочнаяПродукция Тогда
					ЭлементыФормы.ТоварыСрокГодности.Видимость      = Истина;
					ЭлементыФормы.ТоварыСрокГодности.ТолькоПросмотр = Истина;
				Иначе
					ЭлементыФормы.ТоварыСрокГодности.Видимость = Ложь;
				КонецЕсли;
			Иначе
				ЭлементыФормы.ТоварыСрокГодности.Видимость = Ложь;
			КонецЕсли;
		Исключение
			ЭлементыФормы.ТоварыСрокГодности.Видимость = ЭтоМолочнаяПродукция;
		КонецПопытки;
		
		ЭлементыФормы.ТоварыШаблон.Видимость = (ЭлементыФормы.ТоварыШаблон.СписокВыбора.Количество() > 1 Или ЭтоУстаревшаяМолочнаяПродукция);
		
		
		ЗависимыеОтСтатусаОбработкиЗаказа = Новый Массив;
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ГруппаШапка");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("Товары");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыКоманднаяПанельЕще");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыГруппаПодменюЗаполнить");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыГруппаТорговоеОборудование");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыУказатьСерийныеНомера");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ГруппаДоговор");
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("Ответственный");
		
		ИнтеграцияИСКлиентСервер_УстановитьДоступностьЭлементовФормы(Форма, ЗависимыеОтСтатусаОбработкиЗаказа, Не Форма.РедактированиеФормыНеДоступно);
		
		ЭлементыФормы.ТоварыКоличествоЭмитировано.Видимость = Форма.ОтобразитьКоличествоЭмитировано;
		ЭлементыФормы.ОтборСтрок.Видимость                  = Форма.ОтобразитьКоличествоЭмитировано;
		ЭлементыФормы.Контрагент.Видимость                  = ЭтоТрансграничнаяТорговля;
		
		Попытка
			ИспользуетсяТипОплатыКодовМаркировки = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ИспользуетсяТипОплатыКодовМаркировки(
				ДокументОбъект.ВидПродукции, ДокументОбъект.Организация);
			ЭлементыФормы.ТипОплатыКодовМаркировки.Видимость = ИспользуетсяТипОплатыКодовМаркировки;

			Если ИспользуетсяТипОплатыКодовМаркировки
				И Не ЗначениеЗаполнено(ДокументОбъект.ТипОплатыКодовМаркировки) Тогда
				ДокументОбъект.ТипОплатыКодовМаркировки = ПредопределенноеЗначение("Перечисление.ТипыОплатыКодовМаркировкиСУЗ.ОплатаПоНанесению");
			КонецЕсли;
			ЭлементыФормы.GLNОрганизации.Видимость              = ЭтоМех;
			ЭлементыФормы.ФормаВиртуальнаяАгрегация.Видимость   = (Не ЭтоМех);
			ЭлементыФормы.ФормаПечать.Видимость                 = (Не ЭтоМех);
			ЭлементыФормы.СброситьПризнакПечати.Видимость       = (Не ЭтоМех);
			ЭлементыФормы.ТоварыУказатьСерийныеНомера.Видимость = (Не ЭтоМех);
			
