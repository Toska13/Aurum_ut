	КонецЕсли;

	Попытка
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма 			= СтруктураПараметров.ФормаДокумента;
		ДокументОбъект 	= Форма.Объект;
		
		Попытка
			ПараметрыЗаполнения = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияЕГАИСКлиентСервер").ПараметрыЗаполненияТабличнойЧасти();
			ПараметрыЗаполнения.ПересчитатьСумму               = Истина;
			ПараметрыЗаполнения.ПересчитатьКоличествоЕдиниц    = Истина;
			ПараметрыЗаполнения.МаркируемаяПродукцияВТЧ        = Истина;
			ПараметрыЗаполнения.ЗаполнитьАлкогольнуюПродукцию  = Истина;
			ПараметрыЗаполнения.ПроверитьСериюРассчитатьСтатус = Истина;
			ПараметрыЗаполнения.ЗаполнитьАртикул               = Истина;
			ПараметрыЗаполнения.ЗаполнитьКод                   = Истина;
		Исключение
			ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		Попытка
			Если ПараметрыЗаполнения = Неопределено Тогда
				ПараметрыЗаполнения = ОбщегоНазначенияКлиент.ОбщийМодуль("СобытияФормЕГАИСКлиент").СтруктураПараметрыЗаполнения();
				ПараметрыЗаполнения.МаркируемаяАлкогольнаяПродукцияВТЧ = Истина;
				ПараметрыЗаполнения.ПроверитьСериюРассчитатьСтатус     = Истина;
				ПараметрыЗаполнения.ОбработатьУпаковки                 = Ложь;		
			КонецЕсли;
		Исключение
			ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
			
		Если НЕ ПараметрыЗаполнения = Неопределено Тогда
			КэшированныеЗначения = Неопределено;
			
			Для каждого СтрокаДокумента из ДокументОбъект.Товары Цикл	
				ОбщегоНазначенияКлиент.ОбщийМодуль("СобытияФормЕГАИСКлиентПереопределяемый").ПриИзмененииНоменклатуры(Форма, СтрокаДокумента, КэшированныеЗначения,
					ПараметрыЗаполнения, Форма.ПараметрыУказанияСерий);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

