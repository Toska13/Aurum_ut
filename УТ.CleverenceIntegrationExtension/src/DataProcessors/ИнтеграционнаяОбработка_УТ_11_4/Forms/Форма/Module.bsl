&НаСервере
Функция ИнтеграцияИСПовтИсп_ЭтоПродукцияИСМП(ВидПродукции, ВключаяТабачнуюПродукцию = Ложь, ВключатьМолочнуюПродукцию = Истина, ВключатьПиво = Истина)
	
	ИмяСобытия = "ИнтеграцияИСПовтИсп_ЭтоПродукцияИСМП";
	
	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияИСПовтИсп").ЭтоПродукцияИСМП(ВидПродукции, ВключаяТабачнуюПродукцию, ВключатьМолочнуюПродукцию, ВключатьПиво);
	Исключение
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль("ИнтеграцияИСПовтИсп").ЭтоПродукцияИСМП(ВидПродукции, ВключаяТабачнуюПродукцию, ВключатьМолочнуюПродукцию, ВключатьПиво);
	Исключение
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ИнтеграцияИСМПКлиентСервер_ЭтоВидПродукцииСоСрокамиГодности(ВидПродукции, УчитыватьМолочнуюПродукцию = Истина)
	
	Возврат РеквизитФормыВЗначение("Объект").ИСМП_ЭтоВидПродукцииСоСрокамиГодности(ВидПродукции, УчитыватьМолочнуюПродукцию);
	
КонецФункции

#КонецОбласти

#Область ПереименованиеМодулей_Прочее

&НаКлиенте
Процедура ИнтеграцияИСКлиентСервер_УстановитьДоступностьЭлементовФормы(Форма, МассивЭлементов, Доступно) Экспорт

	ИмяСобытия = "ИнтеграцияИСКлиентСервер_УстановитьДоступностьЭлементовФормы";
	
	Попытка
		ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияИСКлиентСервер").УстановитьДоступностьЭлементовФормы(Форма, МассивЭлементов, Доступно);
		Возврат;
	Исключение
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").УстановитьДоступностьЭлементовФормы(Форма, МассивЭлементов, Доступно);
		Возврат;
	Исключение
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").УправлениеДоступностьюЭлементовФормы(Форма, МассивЭлементов, Доступно);
		Возврат;
	Исключение
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти