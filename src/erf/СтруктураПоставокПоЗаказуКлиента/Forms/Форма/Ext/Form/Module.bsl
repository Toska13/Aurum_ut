#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, Расшифровка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда
		ТабличныйДокумент.Очистить();
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите заказ клиента.'"),
			,
			"ЗаказКлиента");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	ТабличныйДокумент.Очистить();
	
	СобранныеСсылки = Новый Массив;
	ПосещенныеСсылки = Новый Соответствие;
	СобратьПодчиненныеДокументы(ЗаказКлиента, СобранныеСсылки, ПосещенныеСсылки);
	
	// Дополнение по связям Aurum: ДокументОснование / Товары.АУ_ЗаказКлиента /
	// ЗаказКлиента.Товары.АУ_ЗаказПоставщику - критерий СвязанныеДокументы их может не видеть.
	ДополнитьЗаказамиПоставщикуПоЗаказуКлиента(ЗаказКлиента, СобранныеСсылки, ПосещенныеСсылки);
	
	ЗаказыПоставщику = Новый Массив;
	Приобретения = Новый Массив;
	
	Для Каждого СсылкаДокумента Из СобранныеСсылки Цикл
		
		ТипДокумента = ТипЗнч(СсылкаДокумента);
		Если ТипДокумента = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			ЗаказыПоставщику.Добавить(СсылкаДокумента);
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			Приобретения.Добавить(СсылкаДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеЗаказа = ДанныеЗаказаКлиента(ЗаказКлиента);
	ДанныеЗаказовПоставщику = ДанныеЗаказовПоставщику(ЗаказыПоставщику);
	ДанныеПриобретений = ДанныеПриобретений(Приобретения);
	СтрокиТоваров = СтрокиТоваровПриобретений(Приобретения);
	
	ПриобретенияПоЗаказам = Новый Соответствие;
	ПриобретенияБезЗаказа = Новый Массив;
	
	Для Каждого СтрокаПриобретения Из ДанныеПриобретений Цикл
		
		ЗаказПоставщику = СтрокаПриобретения.ЗаказПоставщику;
		Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
			ЗаказПоставщику = ЗаказПоставщикуИзТоваров(СтрокаПриобретения.Ссылка, СтрокиТоваров);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗаказПоставщику)
			И ЗаказыПоставщику.Найти(ЗаказПоставщику) <> Неопределено Тогда
			
			СписокПриобретений = ПриобретенияПоЗаказам.Получить(ЗаказПоставщику);
			Если СписокПриобретений = Неопределено Тогда
				СписокПриобретений = Новый Массив;
				ПриобретенияПоЗаказам.Вставить(ЗаказПоставщику, СписокПриобретений);
			КонецЕсли;
			СписокПриобретений.Добавить(СтрокаПриобретения);
			
		Иначе
			ПриобретенияБезЗаказа.Добавить(СтрокаПриобретения);
		КонецЕсли;
		
	КонецЦикла;
	
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОтчетОбъект.ПолучитьМакет("Макет");
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	ОбластьЗаказа = Макет.ПолучитьОбласть("ЗаказКлиента");
	ОбластьЗаказа.Параметры.ПредставлениеДокумента = ДанныеЗаказа.ПредставлениеДокумента;
	ОбластьЗаказа.Параметры.Ссылка = ДанныеЗаказа.Ссылка;
	ОбластьЗаказа.Параметры.Валюта = ДанныеЗаказа.Валюта;
	ОбластьЗаказа.Параметры.СуммаДокумента = ДанныеЗаказа.СуммаДокумента;
	ТабличныйДокумент.Вывести(ОбластьЗаказа);
	
	Если ЗаказыПоставщику.Количество() = 0
		И Приобретения.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("НетСвязанных"));
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаЗаказаПоставщику Из ДанныеЗаказовПоставщику Цикл
		
		ОбластьЗаказаПоставщику = Макет.ПолучитьОбласть("ЗаказПоставщику");
		ОбластьЗаказаПоставщику.Параметры.ПредставлениеДокумента =
			ОтступИерархии(1) + СтрокаЗаказаПоставщику.ПредставлениеДокумента;
		ОбластьЗаказаПоставщику.Параметры.Ссылка = СтрокаЗаказаПоставщику.Ссылка;
		ОбластьЗаказаПоставщику.Параметры.Поставщик = СтрокаЗаказаПоставщику.Поставщик;
		ОбластьЗаказаПоставщику.Параметры.Валюта = СтрокаЗаказаПоставщику.Валюта;
		ОбластьЗаказаПоставщику.Параметры.СуммаДокумента = СтрокаЗаказаПоставщику.СуммаДокумента;
		ТабличныйДокумент.Вывести(ОбластьЗаказаПоставщику);
		
		СписокПриобретений = ПриобретенияПоЗаказам.Получить(СтрокаЗаказаПоставщику.Ссылка);
		Если СписокПриобретений = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаПриобретения Из СписокПриобретений Цикл
			ВывестиПриобретение(Макет, СтрокаПриобретения, СтрокиТоваров);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаПриобретения Из ПриобретенияБезЗаказа Цикл
		ВывестиПриобретение(Макет, СтрокаПриобретения, СтрокиТоваров);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПриобретение(Макет, СтрокаПриобретения, СтрокиТоваров)
	
	ОбластьПриобретения = Макет.ПолучитьОбласть("Приобретение");
	ОбластьПриобретения.Параметры.ПредставлениеДокумента =
		ОтступИерархии(2) + СтрокаПриобретения.ПредставлениеДокумента;
	ОбластьПриобретения.Параметры.Ссылка = СтрокаПриобретения.Ссылка;
	ОбластьПриобретения.Параметры.Поставщик = СтрокаПриобретения.Поставщик;
	ОбластьПриобретения.Параметры.Комментарий = СтрокаПриобретения.Комментарий;
	ОбластьПриобретения.Параметры.Валюта = СтрокаПриобретения.Валюта;
	ОбластьПриобретения.Параметры.СуммаДокумента = СтрокаПриобретения.СуммаДокумента;
	ТабличныйДокумент.Вывести(ОбластьПриобретения);
	
	ОтборТоваров = Новый Структура("Ссылка", СтрокаПриобретения.Ссылка);
	НайденныеСтроки = СтрокиТоваров.НайтиСтроки(ОтборТоваров);
	
	Для Каждого СтрокаТовара Из НайденныеСтроки Цикл
		
		ОбластьНоменклатуры = Макет.ПолучитьОбласть("Номенклатура");
		ОбластьНоменклатуры.Параметры.ПредставлениеНоменклатуры =
			ОтступИерархии(3) + Строка(СтрокаТовара.Номенклатура);
		ОбластьНоменклатуры.Параметры.Номенклатура = СтрокаТовара.Номенклатура;
		ОбластьНоменклатуры.Параметры.ПредставлениеХарактеристики = СтрокаТовара.ПредставлениеХарактеристики;
		ОбластьНоменклатуры.Параметры.Характеристика = СтрокаТовара.Характеристика;
		ОбластьНоменклатуры.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьНоменклатуры.Параметры.Цена = СтрокаТовара.Цена;
		СуммаСтроки = СтрокаТовара.Сумма;
		Если СуммаСтроки = 0 Тогда
			СуммаСтроки = СтрокаТовара.СуммаСНДС;
		КонецЕсли;
		ОбластьНоменклатуры.Параметры.Сумма = СуммаСтроки;
		ТабличныйДокумент.Вывести(ОбластьНоменклатуры);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОтступИерархии(Уровень)
	
	Если Уровень <= 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	Счетчик = 0;
	Пока Счетчик < Уровень Цикл
		Результат = Результат + " -";
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Возврат Результат + " ";
	
КонецФункции

&НаСервере
Процедура ДополнитьЗаказамиПоставщикуПоЗаказуКлиента(ЗаказКлиентаСсылка, СобранныеСсылки, ПосещенныеСсылки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказыПоставщику.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказыПоставщику
	|ГДЕ
	|	ЗаказыПоставщику.ДокументОснование = &ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары
	|ГДЕ
	|	Товары.АУ_ЗаказКлиента = &ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыЗаказа.АУ_ЗаказПоставщику
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ТоварыЗаказа
	|ГДЕ
	|	ТоварыЗаказа.Ссылка = &ЗаказКлиента
	|	И ТоварыЗаказа.АУ_ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиентаСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СобранныеСсылки.Найти(Выборка.Ссылка) = Неопределено Тогда
			СобранныеСсылки.Добавить(Выборка.Ссылка);
		КонецЕсли;
		
		СобратьПодчиненныеДокументы(Выборка.Ссылка, СобранныеСсылки, ПосещенныеСсылки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СобратьПодчиненныеДокументы(ДокументСсылка, СобранныеСсылки, ПосещенныеСсылки)
	
	Если ПосещенныеСсылки.Получить(ДокументСсылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПосещенныеСсылки.Вставить(ДокументСсылка, Истина);
	
	ТаблицаПодчиненных = ОбъектыПоКритериюОтбора(ДокументСсылка);
	
	Для Каждого СтрокаТаблицы Из ТаблицаПодчиненных Цикл
		
		СсылкаПодчиненного = СтрокаТаблицы.Ссылка;
		Если ПосещенныеСсылки.Получить(СсылкаПодчиненного) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СобранныеСсылки.Найти(СсылкаПодчиненного) = Неопределено Тогда
			СобранныеСсылки.Добавить(СсылкаПодчиненного);
		КонецЕсли;
		
		СобратьПодчиненныеДокументы(СсылкаПодчиненного, СобранныеСсылки, ПосещенныеСсылки);
		
	КонецЦикла;
	
КонецПроцедуры

// Собирает документы, ссылающиеся на переданный, по составу критерия отбора СвязанныеДокументы.
// Типовой алгоритм общей формы СвязанныеДокументы (ОбъектыПоКритериюОтбора).
//
&НаСервере
Функция ОбъектыПоКритериюОтбора(ЗначениеКритерияОтбора)
	
	ШаблонЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПсевдонимТаблицы.Ссылка КАК Ссылка
	|ИЗ
	|	ИмяТаблицы КАК ПсевдонимТаблицы
	|ГДЕ
	|	ПсевдонимТаблицы.ИмяРеквизита = &ЗначениеКритерияОтбора";
	
	ШаблонЗапросаОбъединения = "ВЫБРАТЬ
	|	ПсевдонимТаблицы.Ссылка КАК Ссылка
	|ИЗ
	|	ИмяТаблицы КАК ПсевдонимТаблицы
	|ГДЕ
	|	ПсевдонимТаблицы.ИмяРеквизита = &ЗначениеКритерияОтбора";
	
	ЧастиЗапроса = Новый Массив;
	ТекстЧастиЗапроса = "";
	
	Для Каждого ЭлементСостава Из Метаданные.КритерииОтбора.СвязанныеДокументы.Состав Цикл
		
		Если Не ЭлементСостава.Тип.СодержитТип(ТипЗнч(ЗначениеКритерияОтбора)) Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьКДанным = ЭлементСостава.ПолноеИмя();
		
		Если СтрНайти(ПутьКДанным, "ТабличнаяЧасть") Тогда
			ОбъектМетаданных = ЭлементСостава.Родитель().Родитель();
		Иначе
			ОбъектМетаданных = ЭлементСостава.Родитель();
		КонецЕсли;
		
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		Точка = СтрНайти(ПутьКДанным, ".", НаправлениеПоиска.СКонца);
		ИмяРеквизита = Сред(ПутьКДанным, Точка + 1);
		
		ИмяТаблицы = ЭлементСостава.Родитель().ПолноеИмя();
		ИмяТаблицы = СтрЗаменить(ИмяТаблицы, "ТабличнаяЧасть.", "");
		
		Точка = СтрНайти(ИмяТаблицы, ".", НаправлениеПоиска.СКонца);
		ПсевдонимТаблицы = "Таблица_" + Сред(ИмяТаблицы, Точка + 1);
		
		ТекстЧастиЗапроса = ?(ТекстЧастиЗапроса = "", ШаблонЗапроса, ШаблонЗапросаОбъединения);
		ТекстЧастиЗапроса = СтрЗаменить(ТекстЧастиЗапроса, "ИмяТаблицы", ИмяТаблицы);
		ТекстЧастиЗапроса = СтрЗаменить(ТекстЧастиЗапроса, "ПсевдонимТаблицы", ПсевдонимТаблицы);
		ТекстЧастиЗапроса = СтрЗаменить(ТекстЧастиЗапроса, "ИмяРеквизита", ИмяРеквизита);
		
		ЧастиЗапроса.Добавить(ТекстЧастиЗапроса);
		
	КонецЦикла;
	
	Если ЧастиЗапроса.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Разделитель = Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС;
		Запрос.Текст = СтрСоединить(ЧастиЗапроса, Разделитель);
		Запрос.УстановитьПараметр("ЗначениеКритерияОтбора", ЗначениеКритерияОтбора);
		Возврат Запрос.Выполнить().Выгрузить();
	Иначе
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ДанныеЗаказаКлиента(ЗаказКлиентаСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыКлиента.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказыКлиента.Ссылка) КАК ПредставлениеДокумента,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказыКлиента.Валюта) КАК Валюта,
	|	ЗаказыКлиента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказыКлиента
	|ГДЕ
	|	ЗаказыКлиента.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиентаСсылка);
	
	Результат = Новый Структура("Ссылка, ПредставлениеДокумента, Валюта, СуммаДокумента",
		ЗаказКлиентаСсылка, Строка(ЗаказКлиентаСсылка), "", 0);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеЗаказовПоставщику(ЗаказыПоставщику)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Ссылка");
	ТаблицаДанных.Колонки.Добавить("ПредставлениеДокумента");
	ТаблицаДанных.Колонки.Добавить("Поставщик");
	ТаблицаДанных.Колонки.Добавить("Валюта");
	ТаблицаДанных.Колонки.Добавить("СуммаДокумента");
	
	Если ЗаказыПоставщику.Количество() = 0 Тогда
		Возврат ТаблицаДанных;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПоставщику.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказыПоставщику.Ссылка) КАК ПредставлениеДокумента,
	|	ВЫБОР
	|		КОГДА ЗаказыПоставщику.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ЗаказыПоставщику.Партнер)
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ЗаказыПоставщику.Контрагент)
	|	КОНЕЦ КАК Поставщик,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказыПоставщику.Валюта) КАК Валюта,
	|	ЗаказыПоставщику.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказыПоставщику
	|ГДЕ
	|	ЗаказыПоставщику.Ссылка В (&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказыПоставщику.Дата,
	|	ЗаказыПоставщику.Номер";
	Запрос.УстановитьПараметр("Ссылки", ЗаказыПоставщику);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

