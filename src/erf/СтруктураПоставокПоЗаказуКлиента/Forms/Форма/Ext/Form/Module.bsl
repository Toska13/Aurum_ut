&НаСервере
Функция СтрокиТоваровПриобретений(Приобретения)
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Ссылка");
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("Характеристика");
	ТаблицаТоваров.Колонки.Добавить("ПредставлениеХарактеристики");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("Сумма");
	ТаблицаТоваров.Колонки.Добавить("СуммаСНДС");
	ТаблицаТоваров.Колонки.Добавить("ЗаказПоставщику");
	ТаблицаТоваров.Индексы.Добавить("Ссылка");
	
	Если Приобретения.Количество() = 0 Тогда
		Возврат ТаблицаТоваров;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Характеристика) КАК ПредставлениеХарактеристики,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.ЗаказПоставщику КАК ЗаказПоставщику
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Ссылка,
	|	Товары.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Приобретения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаТоваров.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат ТаблицаТоваров;
	
КонецФункции

&НаСервере
Функция ЗаказПоставщикуИзТоваров(ПриобретениеСсылка, СтрокиТоваров)
	
	ОтборТоваров = Новый Структура("Ссылка", ПриобретениеСсылка);
	НайденныеСтроки = СтрокиТоваров.НайтиСтроки(ОтборТоваров);
	
	Для Каждого СтрокаТовара Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.ЗаказПоставщику) Тогда
			Возврат СтрокаТовара.ЗаказПоставщику;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ЗаказПоставщику.ПустаяСсылка();
	
КонецФункции

