#Область ПрограммныйИнтерфейс

// Возвращает сведения о внешней обработке для подсистемы дополнительных отчетов и обработок.
//
// Возвращаемое значение:
//  Структура - параметры регистрации внешней обработки.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	МетаданныеОбработки = Метаданные();
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Переформирует суммы и НДС в назначении платежа заявок на расходование и списаний с расчетного счета за период.
//
// Параметры:
//  ДатаНачала - Дата - начало периода отбора документов.
//  ДатаОкончания - Дата - конец периода отбора документов.
//
// Возвращаемое значение:
//  Структура:
//   * Обработано - Число - количество прочитанных документов.
//   * Изменено - Число - количество записанных документов с измененным назначением.
//   * Пропущено - Число - количество документов, у которых текст назначения не изменился.
//
Функция ПереформироватьНазначенияПлатежа(ДатаНачала, ДатаОкончания) Экспорт
	
	НачалоПериода = НачалоДня(ДатаНачала);
	КонецПериода = КонецДня(ДатаОкончания);
	
	СсылкиКОбработке = Новый Массив;
	ДобавитьСсылкиДокументовЗаПериод(СсылкиКОбработке, ТекстЗапросаЗаявок(), НачалоПериода, КонецПериода);
	ДобавитьСсылкиДокументовЗаПериод(СсылкиКОбработке, ТекстЗапросаСписаний(), НачалоПериода, КонецПериода);
	
	Обработано = 0;
	Изменено = 0;
	Пропущено = 0;
	
	Для Каждого СсылкаДокумента Из СсылкиКОбработке Цикл
		
		ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
		СтароеНазначение = ДокументОбъект.НазначениеПлатежа;
		ДенежныеСредстваКлиентСервер.АУ_ОбновитьСуммуИНДСВНазначенииПлатежа(ДокументОбъект);
		
		Если ДокументОбъект.НазначениеПлатежа <> СтароеНазначение Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			Изменено = Изменено + 1;
		Иначе
			Пропущено = Пропущено + 1;
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	Итоги = Новый Структура;
	Итоги.Вставить("Обработано", Обработано);
	Итоги.Вставить("Изменено", Изменено);
	Итоги.Вставить("Пропущено", Пропущено);
	
	Возврат Итоги;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаЗаявок()
	
	Возврат
	"ВЫБРАТЬ
	|	Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявки
	|ГДЕ
	|	Заявки.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Заявки.ПометкаУдаления
	|	И Заявки.НазначениеПлатежа <> &ПустаяСтрока";
	
КонецФункции

Функция ТекстЗапросаСписаний()
	
	Возврат
	"ВЫБРАТЬ
	|	Списания.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Списания
	|ГДЕ
	|	Списания.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Списания.ПометкаУдаления
	|	И Списания.НазначениеПлатежа <> &ПустаяСтрока";
	
КонецФункции

Процедура ДобавитьСсылкиДокументовЗаПериод(СсылкиКОбработке, ТекстЗапроса, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецПериода);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СсылкиКОбработке.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
