
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресДанных") Тогда
		
		ДвоичныеДанные = Base64Значение(ПолучитьИзВременногоХранилища(Параметры.АдресДанных));
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ДвоичныеДанные.ОткрытьПотокДляЧтения());
		Текст = ТекстовыйДокумент.ПолучитьТекст();
		
	КонецЕсли;
	
КонецПроцедуры
