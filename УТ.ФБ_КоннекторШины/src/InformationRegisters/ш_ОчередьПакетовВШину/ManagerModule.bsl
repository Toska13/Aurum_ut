Функция ПолучитьСтруктуруПакетаДляДальнейшейОтправки() Экспорт
	
	Результат=Новый Структура;
	Результат.Вставить("СистемаНазначения");
	Результат.Вставить("ВидПакета");
	Результат.Вставить("ТипСообщения");
	Результат.Вставить("Пакет");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьПакетДляОтправки(Данные) Экспорт
	
	МассивПакетов=Новый Массив;
	Если ТипЗнч(Данные)=Тип("Массив") Тогда
		МассивПакетов=Данные;
	Иначе
		МассивПакетов.Добавить(Данные);
	КонецЕсли;
	
	Для каждого стрПакет Из МассивПакетов Цикл
	
		ИДПакета=СокрЛП(Новый УникальныйИдентификатор);
		рег=РегистрыСведений.ш_ОчередьПакетовВШину.СоздатьНаборЗаписей();
		рег.Отбор.ИД.Установить(ИДПакета,Истина);
		
		стрРег=рег.Добавить();
		ЗаполнитьЗначенияСвойств(стрРег,стрПакет);
		стрРег.ИД=ИДпакета;
		стрРег.ДатаОчереди=ТекущаяДатаСеанса();
		
		рег.ОбменДанными.Загрузка=Истина;
		рег.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры