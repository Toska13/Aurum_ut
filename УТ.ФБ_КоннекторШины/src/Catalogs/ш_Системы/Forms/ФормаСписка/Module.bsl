
&НаСервере
Процедура ОбновитьСписокСистемИзШиныНаСервере()
	
	Результат=ш_ЗапросыКШинеСервер.ОбновитьСписокСистемИзШины();
	
	Если Результат.Результат Тогда
		
		Попытка
			Для каждого стрСистема Из Результат.Данные Цикл
				Справочники.ш_Системы.ПолучитьСистемуПоИД(стрСистема.id,стрСистема.name,стрСистема.isIt);
			КонецЦикла;
		Исключение
		КонецПопытки;
		
		ш_РаботаСшинойДанныхСервер.СообщитьПользователю("Обновление систем успешно завершено");
		
	Иначе
		ш_РаботаСшинойДанныхСервер.СообщитьПользователю("В ходе обновления возникла ошибка. Подробнее в логе ошибок шины");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокСистемИзШины(Команда)
	ОбновитьСписокСистемИзШиныНаСервере();
	Элементы.Список.Обновить();
КонецПроцедуры
