Функция ПолучитьСистемуПоИД(ПереданныйИД,Наименование=Неопределено,ЭтоТекущаяСистема=Неопределено) Экспорт
	
	ИД = Новый УникальныйИдентификатор(ПереданныйИД);
	СсылкаНаСистему = Справочники.ш_Системы.ПолучитьСсылку(ИД);
	СистемаОбъект = СсылкаНаСистему.ПолучитьОбъект();
	
	Если НЕ СистемаОбъект=Неопределено Тогда
		
		Если НЕ ЗначениеЗаполнено(СистемаОбъект.Наименование) Тогда
			СистемаОбъект.Наименование = Наименование;
			СистемаОбъект.Записать();
		КонецЕсли;
		
		Возврат СсылкаНаСистему;
		
	КонецЕсли;
	
	СистемаОбъект = Справочники.ш_Системы.СоздатьЭлемент();
	СистемаОбъект.УстановитьСсылкуНового(СсылкаНаСистему);
	СистемаОбъект.Наименование = Наименование;
	СистемаОбъект.ЭтоТекущаяСистема = ЭтоТекущаяСистема;
	СистемаОбъект.Записать();
	
	Возврат СистемаОбъект.Ссылка;
	
КонецФункции