Функция СформироватьПакетПоОбъекту(Объект, ВидОбъекта, РежимПроведения=Неопределено) Экспорт
	
	ИмяМетаданных=стрШаблон("%1.%2",ВидОбъекта,Объект.Метаданные().Имя);
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ш_ПравилаФормированияПакетовДляОтправки.ВидПакета КАК ВидПакета,
	             |	ш_ПравилаФормированияПакетовДляОтправки.ТипСообщения КАК ТипСообщения,
	             |	ш_ПравилаФормированияПакетовДляОтправки.СистемаНазначения КАК СистемаНазначения,
	             |	ш_ПравилаФормированияПакетовДляОтправки.Алгоритм КАК Алгоритм
	             |ИЗ
	             |	Справочник.ш_ПравилаФормированияПакетовДляОтправки КАК ш_ПравилаФормированияПакетовДляОтправки
	             |ГДЕ
	             |	ш_ПравилаФормированияПакетовДляОтправки.ИмяМетаданных = &ИмяМетаданных
	             |	И НЕ ш_ПравилаФормированияПакетовДляОтправки.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИмяМетаданных",ИмяМетаданных);
	Выборка=Запрос.Выполнить().Выбрать();
	
	МассивПакетов=Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Сообщение="";
		Попытка
			Выполнить(Выборка.Алгоритм);
		Исключение
			ТекстОшибки=СформироватьОписаниеОшибки(ИнформацияОбОшибке());
			ЗаписатьОшибкуВЛог("СформироватьПакетПоОбъекту",ЗначениеВСтрокуВнутр(Объект.Ссылка),0,СтрШаблон("%1%2%3",ИмяМетаданных,Символы.ПС,ТекстОшибки));
			Продолжить;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Сообщение) Тогда
			
			Пакет=РегистрыСведений.ш_ОчередьПакетовВШину.ПолучитьСтруктуруПакетаДляДальнейшейОтправки();
			ЗаполнитьЗначенияСвойств(Пакет,Выборка);
			Пакет.Пакет=Сообщение;
			МассивПакетов.Добавить(Пакет);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивПакетов;
	
КонецФункции

Процедура ЗаписатьОшибкуВЛог(ИмяМетода,ДанныеЗапроса,КодОшибки,ТекстОшибки) Экспорт
	
	ИД=Строка(Новый УникальныйИдентификатор);
	Дата=ТекущаяДата();
	
	рег=РегистрыСведений.ш_ЛогОшибок.СоздатьНаборЗаписей();
	рег.Отбор.Дата.Установить(Дата,Истина);
	рег.Отбор.Метод.Установить(ИмяМетода,Истина);
	рег.Отбор.ИД.Установить(ИД,Истина);
	рег.ОбменДанными.Загрузка=Истина;
	
	стрРег=рег.Добавить();
	стрРег.Дата=Дата;
	стрРег.Метод=ИмяМетода;
	стрРег.ИД=ИД;
	стрРег.КодОшибки=КодОшибки;
	стрРег.ДанныеЗапроса=ДанныеЗапроса;
	стРрег.ТекстОшибки=ТекстОшибки;
	
	рег.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьСтрокуПодключения() Экспорт
	
	СтрокаПодключения = ВРЕГ(НСтр(СтрокаСоединенияИнформационнойБазы(), "Ref"));
	Если НЕ ЗначениеЗаполнено(СтрокаПодключения) Тогда
		СтрокаПодключения = ВРЕГ(НСтр(СтрокаСоединенияИнформационнойБазы(), "File"));
	КонецЕсли;
	
	Возврат СтрокаПодключения;
	
КонецФункции

#КонецОбласти

#Область РегламентныеЗадания

Процедура ш_ОтправкаДанныхВШину() Экспорт
	
	Если НЕ ш_РаботаСШинойПовтИсп.ПроверитьВозможностьРаботыСШиной() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПакетов=Новый Массив;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ш_ОчередьПакетовВШину.ИД КАК ИД,
	             |	ш_ОчередьПакетовВШину.СистемаНазначения КАК СистемаНазначения,
	             |	ш_ОчередьПакетовВШину.ВидПакета КАК ВидПакета,
	             |	ш_ОчередьПакетовВШину.ТипСообщения.Наименование КАК ТипСообщенияНаименование,
	             |	ш_ОчередьПакетовВШину.Пакет КАК Пакет,
	             |	ш_ОчередьПакетовВШину.ТипСообщения КАК ТипСообщения,
	             |	ш_ОчередьПакетовВШину.ДатаОчереди КАК ДатаОчереди
	             |ИЗ
	             |	РегистрСведений.ш_ОчередьПакетовВШину КАК ш_ОчередьПакетовВШину
	             |ГДЕ
	             |	НЕ ш_ОчередьПакетовВШину.Отправлен
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ДатаОчереди";
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Пакет=ПолучитьСтруктуруПакета();
		Пакет.id=Выборка.ИД;
		Пакет.type=?(Выборка.ВидПакета=Перечисления.ш_ВидыПакетов.Адресный,"personal","all");
		Пакет.destination=?(ЗначениеЗаполнено(Выборка.СистемаНазначения),Строка(Выборка.СистемаНазначения.УникальныйИдентификатор()),"");
		Пакет.name=Выборка.ТипСообщенияНаименование;
		Пакет.data=Выборка.Пакет;
		МассивПакетов.Добавить(Пакет);
		
	КонецЦикла;
	
	ДанныеПодключенияКШине=ш_РаботаСШинойПовтИсп.ПолучитьПараметрыШины();
	Если НЕ ЗначениеЗаполнено(ДанныеПодключенияКШине.КоличествоОтправляемыхПакетовЗаРаз) Тогда
		РазмерПорции=100;
	Иначе
		РазмерПорции=ДанныеПодключенияКШине.КоличествоОтправляемыхПакетовЗаРаз;
	КонецЕсли;
	
	Для н=1 По Цел(МассивПакетов.Количество()/РазмерПорции)+1 Цикл
		
		ПакетыДляОтправки=Новый Массив;
		Для к=0 По РазмерПорции-1 Цикл
			
			ТекущийИндекс=(н-1)*РазмерПорции+к;
			Если ТекущийИндекс>МассивПакетов.Количество()-1 Тогда
				Прервать;
			КонецЕсли;
			
			ПакетыДляОтправки.Добавить(МассивПакетов[ТекущийИндекс]);
		КонецЦикла;
		
		Если ПакетыДляОтправки.Количество()>0 Тогда
			
			Результат=ш_ЗапросыКШинеСервер.ОтправитьПакетыВШину(МассивПакетов);
			Если Результат.Результат Тогда
				
				Ошибки=Новый Соответствие;
				Для каждого стрДанные Из Результат.Данные Цикл
					Ошибки.Вставить(стрДанные.id,стрДанные.error);
				КонецЦикла;
				
				Выборка.Сбросить();
				Пока Выборка.Следующий() Цикл
					
					рег=РегистрыСведений.ш_ОчередьПакетовВШину.СоздатьНаборЗаписей();
					рег.Отбор.ИД.Установить(Выборка.ИД,Истина);
					
					стрРег=рег.Добавить();
					ЗаполнитьЗначенияСвойств(стрРег,Выборка);
					стрРег.Отправлен=Истина;
					стрРег.ДатаОтправки=ТекущаяДата();
					стрРег.Ошибка=Ошибки[Выборка.ИД];
					
					рег.Записать(Истина);
					
				КонецЦикла;
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ш_ПолучениеДанныхИзШины() Экспорт
	
	Если НЕ ш_РаботаСШинойПовтИсп.ПроверитьВозможностьРаботыСШиной() Тогда
		Возврат;
	КонецЕсли;
	
	Результат=ш_ЗапросыКШинеСервер.ПолучитьПакетыИзШины();
	Если Результат.Результат Тогда
		
		Если ТипЗнч(Результат.Данные)=Тип("Массив") Тогда
			
			Если Результат.Данные.Количество()>0 Тогда
				
				МассивИД=Новый Массив;
				Для каждого стрПакет Из Результат.Данные Цикл
					
					рег=РегистрыСведений.ш_ОчередьПакетовИзШины.СоздатьНаборЗаписей();
					рег.Отбор.ИД.Установить(стрПакет.id,Истина);
					
					стрРег=рег.Добавить();
					стрРег.ИД=стрПакет.id;
					стрРег.Система=Справочники.ш_Системы.ПолучитьСистемуПоИД(стрПакет.from);
					стрРег.ВидПакета=?(стрПакет.type="personal",Перечисления.ш_ВидыПакетов.Адресный,Перечисления.ш_ВидыПакетов.Широковещательный);
					стрРег.ТипСообщения=ш_РаботаСШинойПовтИсп.ПолучитьТипСообщения(стрПакет.name);
					стрРег.Пакет=стрПакет.data;
					стрРег.ДатаПолучения=ТекущаяДатаСеанса();
					
					рег.ОбменДанными.Загрузка=Истина;
					рег.Записать(Истина);
					
					МассивИД.Добавить(стрПакет.id);
					
				КонецЦикла;
				
				Результат=ш_ЗапросыКШинеСервер.ОтправитьПодтверждениеПолученияДанных(МассивИД);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ш_ОбработкаОчередиСообщенийИзШины() Экспорт
	
	Если НЕ ш_РаботаСШинойПовтИсп.ПроверитьВозможностьРаботыСШиной() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыШины=ш_РаботаСШинойПовтИсп.ПолучитьПараметрыШины();
	МаксимальноеКоличествоОбработкиПакетовИзШины=0;
	ПараметрыШины.Свойство("МаксимальноеКоличествоОбработкиПакетовИзШины",МаксимальноеКоличествоОбработкиПакетовИзШины);
	Если НЕ ЗначениеЗаполнено(МаксимальноеКоличествоОбработкиПакетовИзШины) Тогда
		МаксимальноеКоличествоОбработкиПакетовИзШины=3;
	КонецЕсли;
	
	// 1. пакеты с произвольным алгоритмом обмена
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("МаксимальноеКоличествоОбработкиПакетовИзШины",МаксимальноеКоличествоОбработкиПакетовИзШины);
	Запрос.Текст="ВЫБРАТЬ
	             |	ш_ОчередьПакетовИзШины.ИД КАК ИД,
	             |	ш_ОчередьПакетовИзШины.Система КАК Система,
	             |	ш_ОчередьПакетовИзШины.ВидПакета КАК ВидПакета,
	             |	ш_ОчередьПакетовИзШины.ТипСообщения КАК ТипСообщения,
	             |	ш_ОчередьПакетовИзШины.Пакет КАК Пакет,
	             |	ш_ПравилаОбработкиПакетовПриПриеме.Алгоритм КАК Алгоритм,
	             |	ш_ПравилаОбработкиПакетовПриПриеме.Ссылка КАК Ссылка,
	             |	ш_ОчередьПакетовИзШины.ДатаПолучения КАК ДатаПолучения,
	             |	ш_ОчередьПакетовИзШины.КоличествоПопыток КАК КоличествоПопыток
	             |ИЗ
	             |	РегистрСведений.ш_ОчередьПакетовИзШины КАК ш_ОчередьПакетовИзШины
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ш_ПравилаОбработкиПакетовПриПриеме КАК ш_ПравилаОбработкиПакетовПриПриеме
	             |		ПО (ш_ОчередьПакетовИзШины.ВидПакета = ш_ПравилаОбработкиПакетовПриПриеме.ВидПакета
	             |				ИЛИ ш_ПравилаОбработкиПакетовПриПриеме.ВидПакета = ЗНАЧЕНИЕ(Перечисление.ш_ВидыПакетов.ПустаяСсылка))
	             |			И ш_ОчередьПакетовИзШины.ТипСообщения = ш_ПравилаОбработкиПакетовПриПриеме.ТипСообщения
	             |			И (ш_ОчередьПакетовИзШины.Система = ш_ПравилаОбработкиПакетовПриПриеме.СистемаОтправления
	             |				ИЛИ ш_ПравилаОбработкиПакетовПриПриеме.СистемаОтправления = ЗНАЧЕНИЕ(Справочник.ш_Системы.ПустаяСсылка))
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ш_ОбменДаннымиПоПравиламКД2 КАК ш_ОбменДаннымиПоПравиламКД2
	             |		ПО ш_ОчередьПакетовИзШины.Система = ш_ОбменДаннымиПоПравиламКД2.Система
	             |			И ш_ОчередьПакетовИзШины.ТипСообщения = ш_ОбменДаннымиПоПравиламКД2.ТипСообщенияОбмена
	             |			И (ш_ОбменДаннымиПоПравиламКД2.Загрузка)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ш_ОбменДаннымиПоПравиламКД3 КАК ш_ОбменДаннымиПоПравиламКД3
	             |		ПО ш_ОчередьПакетовИзШины.ТипСообщения = ш_ОбменДаннымиПоПравиламКД3.ТипСообщенияОбмена
	             |			И ш_ОчередьПакетовИзШины.Система = ш_ОбменДаннымиПоПравиламКД3.Система
	             |			И (ш_ОбменДаннымиПоПравиламКД3.Загрузка)
	             |ГДЕ
	             |	НЕ ш_ОчередьПакетовИзШины.Обработано
	             |	И ш_ОчередьПакетовИзШины.КоличествоПопыток <= &МаксимальноеКоличествоОбработкиПакетовИзШины
	             |	И ш_ОбменДаннымиПоПравиламКД2.Ссылка ЕСТЬ NULL
	             |	И ш_ОбменДаннымиПоПравиламКД3.Ссылка ЕСТЬ NULL
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ш_ОчередьПакетовИзШины.ДатаПолучения";
	
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Пакет<>"" Тогда
			Пакет=ПолучитьОбъектИзJSON(Выборка.Пакет);
		Иначе
			Пакет=Неопределено
		КонецЕсли;
		
		Попытка
			Выполнить(Выборка.Алгоритм);
		Исключение
			ТекстОшибки=СформироватьОписаниеОшибки(ИнформацияОбОшибке());
			ЗаписатьОшибкуВЛог("ш_ОбработкаОчередиСообщенийИзШины",ЗначениеВСтрокуВнутр(Выборка.Ссылка),0,СтрШаблон("%1%2%3",Выборка.ИД,Символы.ПС,ТекстОшибки));
			
			рег=РегистрыСведений.ш_ОчередьПакетовИзШины.СоздатьНаборЗаписей();
			рег.Отбор.ИД.Установить(Выборка.ИД,Истина);
			
			стрРег=рег.Добавить();
			ЗаполнитьЗначенияСвойств(стрРег,Выборка);
			стрРег.ДатаОбработки=ТекущаяДатаСеанса();
			стрРег.КоличествоПопыток=стрРег.КоличествоПопыток+1;
			стрРег.ТекстОшибки=ТекстОшибки;
			рег.ОбменДанными.Загрузка=Истина;
			рег.Записать(Истина);
			
			Продолжить;
			
		КонецПопытки;
		
		рег=РегистрыСведений.ш_ОчередьПакетовИзШины.СоздатьНаборЗаписей();
		рег.Отбор.ИД.Установить(Выборка.ИД,Истина);
		
		стрРег=рег.Добавить();
		ЗаполнитьЗначенияСвойств(стрРег,Выборка);
		стрРег.ДатаОбработки=ТекущаяДатаСеанса();
		стрРег.Обработано=Истина;
		
		рег.ОбменДанными.Загрузка=Истина;
		рег.Записать(Истина);
		
	КонецЦикла;
	
