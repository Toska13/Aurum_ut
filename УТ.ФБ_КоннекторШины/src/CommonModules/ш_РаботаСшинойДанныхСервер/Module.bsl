Процедура ш_КонтрольРаботыИОповещения() Экспорт
	
	Если НЕ ш_РаботаСШинойПовтИсп.ПроверитьВозможностьРаботыСШиной() Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ш_ВыполнениеОбменаПоПравиламКД2(УзелОбмена) Экспорт
	
	Если НЕ ш_РаботаСШинойПовтИсп.ПроверитьВозможностьРаботыСШиной() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ УзелОбмена.Использование Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ УзелОбмена.Выгрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пакет=РегистрыСведений.ш_ОчередьПакетовВШину.ПолучитьСтруктуруПакетаДляДальнейшейОтправки();
	
	Пакет.СистемаНазначения = УзелОбмена.Система;
	Пакет.ТипСообщения = УзелОбмена.ТипСообщенияОбмена;
	Пакет.ВидПакета = Перечисления.ш_ВидыПакетов.Адресный;
	
	Правила = УзелОбмена.ПравилаОбменаДанными.Получить();
	
	ДанныеДляВыгрузки = ш_РаботаСПравиламиОбмена.ВыгрузитьДанныеПоПравиламОбмена20(УзелОбмена, Правила);
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки) Тогда
		
		Пакет.Пакет = ДанныеДляВыгрузки;
		РегистрыСведений.ш_ОчередьПакетовВШину.ЗаписатьПакетДляОтправки(Пакет);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ш_ВыполнениеОбменаПоПравиламКД3(УзелОбмена) Экспорт
	
	Если НЕ ш_РаботаСШинойПовтИсп.ПроверитьВозможностьРаботыСШиной() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ УзелОбмена.Использование Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ УзелОбмена.Выгрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пакет=РегистрыСведений.ш_ОчередьПакетовВШину.ПолучитьСтруктуруПакетаДляДальнейшейОтправки();
	
	Пакет.СистемаНазначения = УзелОбмена.Система;
	Пакет.ТипСообщения = УзелОбмена.ТипСообщенияОбмена;
	Пакет.ВидПакета = Перечисления.ш_ВидыПакетов.Адресный;
	
	МассивДанных = Новый Массив;
	Выборка = ПланыОбмена.ВыбратьИзменения(УзелОбмена, УзелОбмена.НомерОтправленного + 1);
	Пока Выборка.Следующий() Цикл
		МассивДанных.Добавить(Выборка.Получить());
	КонецЦикла;
	
	Пакет.Пакет = ш_РаботаСПравиламиОбмена.ЗагрузитьДанныеКД3(МассивДанных);
	
	РегистрыСведений.ш_ОчередьПакетовВШину.ЗаписатьПакетДляОтправки(Пакет);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ш_ОчисткаУстаревшихДанных() Экспорт
	
	ПараметрыШины = ш_РаботаСШинойПовтИсп.ПолучитьПараметрыШины();
	
	Если ПараметрыШины.УдалятьОтработанныеПакеты = Истина Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ш_ОчередьПакетовВШину.ИД КАК ИД,
		|	ш_ОчередьПакетовВШину.ДатаОчереди КАК ДатаОчереди,
		|	ш_ОчередьПакетовВШину.СистемаНазначения КАК СистемаНазначения,
		|	ш_ОчередьПакетовВШину.ВидПакета КАК ВидПакета,
		|	ш_ОчередьПакетовВШину.ТипСообщения КАК ТипСообщения
		|ИЗ
		|	РегистрСведений.ш_ОчередьПакетовВШину КАК ш_ОчередьПакетовВШину
		|ГДЕ
		|	ш_ОчередьПакетовВШину.Отправлен
		|	И ш_ОчередьПакетовВШину.ДатаОчереди < &ДатаОчистки";
		
		Запрос.УстановитьПараметр("ДатаОчистки", ТекущаяДатаСеанса() - 86400 * ПараметрыШины.КоличествоДнейХраненияОтработанныхПакетов);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			рег = РегистрыСведений.ш_ОчередьПакетовВШину.СоздатьНаборЗаписей();
			рег.Отбор.ИД.Установить(Выборка.ИД, Истина);
			рег.Отбор.ДатаОчереди.Установить(Выборка.ДатаОчереди, Истина);
			рег.Отбор.СистемаНазначения.Установить(Выборка.СистемаНазначения, Истина);
			рег.Отбор.ВидПакета.Установить(Выборка.ВидПакета, Истина);
			рег.Отбор.ТипСообщения.Установить(Выборка.ТипСообщения, Истина);
			
			рег.ОбменДанными.Загрузка = Истина;
			рег.Записать(Истина);
			
		КонецЦикла;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ш_ОчередьПакетовИзШины.ИД КАК ИД,
		|	ш_ОчередьПакетовИзШины.Система КАК Система,
		|	ш_ОчередьПакетовИзШины.ВидПакета КАК ВидПакета,
		|	ш_ОчередьПакетовИзШины.ТипСообщения КАК ТипСообщения
		|ИЗ
		|	РегистрСведений.ш_ОчередьПакетовИзШины КАК ш_ОчередьПакетовИзШины
		|ГДЕ
		|	ш_ОчередьПакетовИзШины.Обработано
		|	И ш_ОчередьПакетовИзШины.ДатаПолучения < &ДатаОчистки";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			рег = РегистрыСведений.ш_ОчередьПакетовИзШины.СоздатьНаборЗаписей();
			рег.Отбор.ИД.Установить(Выборка.ИД, Истина);
			рег.Отбор.Система.Установить(Выборка.Система, Истина);
			рег.Отбор.ВидПакета.Установить(Выборка.ВидПакета, Истина);
			рег.Отбор.ТипСообщения.Установить(Выборка.ТипСообщения, Истина);
			
			рег.ОбменДанными.Загрузка = Истина;
			рег.Записать(Истина);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

