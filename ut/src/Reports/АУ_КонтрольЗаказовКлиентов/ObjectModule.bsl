#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);

	ВнешниеНаборы = Новый Структура("Объект", ФактыЗаказов(НастройкиКомпоновки));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФактыЗаказов(НастройкиКомпоновки)

	Факты = НовыйТаблицаФактов();
	Период = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Период");
	НачалоПериода = Дата(1, 1, 1);
	КонецПериода = Дата(3999, 12, 31);

	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда

		НачалоПериода = Период.ДатаНачала;
		КонецПериода = Период.ДатаОкончания;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда

		НачалоПериода = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "НачалоПериода", Дата(1, 1, 1));

	КонецЕсли;

	Если Не ЗначениеЗаполнено(КонецПериода) Тогда

		КонецПериода = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "КонецПериода", Дата(3999, 12, 31));

	КонецЕсли;

	Организация = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Организация");
	Контрагент = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Контрагент");
	Программа = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Программа");
	ХарактеристикаОтбора = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Характеристика");
	ТолькоРасхождения = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "ТолькоРасхождения", Ложь);
	ВалютаИтогов = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "ВалютаИтогов");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиента.Ссылка КАК ЗаказКлиента,
	|	ЗаказКлиента.Дата КАК Дата,
	|	ЗаказКлиента.Организация КАК Организация,
	|	ЗаказКлиента.Контрагент КАК Контрагент,
	|	ЗаказКлиента.АУ_Программа КАК Программа
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	НЕ ЗаказКлиента.ПометкаУдаления
	|	И ЗаказКлиента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&ОрганизацияНеИспользуется
	|			ИЛИ ЗаказКлиента.Организация = &Организация)
	|	И (&КонтрагентНеИспользуется
	|			ИЛИ ЗаказКлиента.Контрагент = &Контрагент)
	|	И (&ПрограммаНеИспользуется
	|			ИЛИ ЗаказКлиента.АУ_Программа = &Программа)";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Программа", Программа);
	Запрос.УстановитьПараметр("ОрганизацияНеИспользуется", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("КонтрагентНеИспользуется", Не ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("ПрограммаНеИспользуется", Не ЗначениеЗаполнено(Программа));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Состояние = АУ_КонтрольЗаказаКлиентаСервер.СостояниеЦепочкиЗаказа(Выборка.ЗаказКлиента, ВалютаИтогов);

		Если ТолькоРасхождения
			И Не Состояние.РасхождениеРасчетовСКлиентами
			И Не Состояние.РасхождениеРасчетовСПоставщиками Тогда

			Продолжить;

		КонецЕсли;

		Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

			Если ЗначениеЗаполнено(ХарактеристикаОтбора)
				И СтрокаФактов.Характеристика <> ХарактеристикаОтбора Тогда

				Продолжить;

			КонецЕсли;

			НоваяСтрока = Факты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФактов);
			НоваяСтрока.ЗаказКлиента = Выборка.ЗаказКлиента;
			НоваяСтрока.Дата = Выборка.Дата;
			НоваяСтрока.Организация = Выборка.Организация;
			НоваяСтрока.Контрагент = Выборка.Контрагент;
			НоваяСтрока.Программа = Выборка.Программа;
			НоваяСтрока.РасхождениеРасчетовСКлиентами = Состояние.РасхождениеРасчетовСКлиентами;
			НоваяСтрока.РасхождениеРасчетовСПоставщиками = Состояние.РасхождениеРасчетовСПоставщиками;

		КонецЦикла;

	КонецЦикла;

	Возврат Факты;

КонецФункции

Функция НовыйТаблицаФактов()

	Факты = Новый ТаблицаЗначений;
	Факты.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	Факты.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Факты.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Факты.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Факты.Колонки.Добавить("Программа", Новый ОписаниеТипов("СправочникСсылка.АУ_Программы"));
	Факты.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Факты.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Факты.Колонки.Добавить("Шифр", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	Факты.Колонки.Добавить("Заказано", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ВСборке", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ЗаказаноПоставщику", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("Приобретено", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ПринятоОрдером", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ОстатокНаСкладе", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("Реализовано", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ОтгруженоОрдером", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ОплаченоКлиентом", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Факты.Колонки.Добавить("Заявлено", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Факты.Колонки.Добавить("ОплаченоПоставщику", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Факты.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Факты.Колонки.Добавить("НетКурса", Новый ОписаниеТипов("Булево"));
	Факты.Колонки.Добавить("РасхождениеРасчетовСКлиентами", Новый ОписаниеТипов("Булево"));
	Факты.Колонки.Добавить("РасхождениеРасчетовСПоставщиками", Новый ОписаниеТипов("Булево"));

	Возврат Факты;

КонецФункции

Функция ЗначениеПараметраКомпоновки(НастройкиКомпоновки, ИмяПараметра, ЗначениеПоУмолчанию = Неопределено)

	Параметр = НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);

	Если Параметр = Неопределено Или Не Параметр.Использование Тогда

		Возврат ЗначениеПоУмолчанию;

	КонецЕсли;

	Возврат Параметр.Значение;

КонецФункции

#КонецОбласти

#КонецЕсли
