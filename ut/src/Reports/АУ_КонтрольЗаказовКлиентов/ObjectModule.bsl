#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);

	ВнешниеНаборы = Новый Структура("Объект", ФактыЗаказов(НастройкиКомпоновки));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФактыЗаказов(НастройкиКомпоновки)

	Факты = НовыйТаблицаФактов();
	Период = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Период");
	НачалоПериода = Дата(1, 1, 1);
	КонецПериода = Дата(3999, 12, 31);

	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда

		НачалоПериода = Период.ДатаНачала;
		КонецПериода = Период.ДатаОкончания;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда

		НачалоПериода = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "НачалоПериода", Дата(1, 1, 1));

	КонецЕсли;

	Если Не ЗначениеЗаполнено(КонецПериода) Тогда

		КонецПериода = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "КонецПериода", Дата(3999, 12, 31));

	КонецЕсли;

	Организация = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Организация");
	Контрагент = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Контрагент");
	Программа = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Программа");
	ХарактеристикаОтбора = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Характеристика");
	ТолькоРасхождения = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "ТолькоРасхождения", Ложь);
	ВалютаИтогов = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "ВалютаИтогов");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиента.Ссылка КАК ЗаказКлиента,
	|	ЗаказКлиента.Дата КАК Дата,
	|	ЗаказКлиента.Организация КАК Организация,
	|	ЗаказКлиента.Контрагент КАК Контрагент,
	|	ЗаказКлиента.АУ_Программа КАК Программа
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	НЕ ЗаказКлиента.ПометкаУдаления
	|	И ЗаказКлиента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&ОрганизацияНеИспользуется
	|			ИЛИ ЗаказКлиента.Организация = &Организация)
	|	И (&КонтрагентНеИспользуется
	|			ИЛИ ЗаказКлиента.Контрагент = &Контрагент)
	|	И (&ПрограммаНеИспользуется
	|			ИЛИ ЗаказКлиента.АУ_Программа = &Программа)";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Программа", Программа);
	Запрос.УстановитьПараметр("ОрганизацияНеИспользуется", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("КонтрагентНеИспользуется", Не ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("ПрограммаНеИспользуется", Не ЗначениеЗаполнено(Программа));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Состояние = АУ_КонтрольЗаказаКлиентаСервер.СостояниеЦепочкиЗаказа(Выборка.ЗаказКлиента, ВалютаИтогов);

		Если ТолькоРасхождения
			И Не Состояние.РасхождениеРасчетовСКлиентами
			И Не Состояние.РасхождениеРасчетовСПоставщиками Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьСтрокиЗаказаВИерархию(Факты, Выборка, Состояние, ХарактеристикаОтбора);

	КонецЦикла;

	Возврат Факты;

КонецФункции

Процедура ДобавитьСтрокиЗаказаВИерархию(Факты, ШапкаЗаказа, Состояние, ХарактеристикаОтбора)

	ИдентификаторЗаказа = "ZK|" + Строка(ШапкаЗаказа.ЗаказКлиента.УникальныйИдентификатор());
	СтрокаЗаказа = Факты.Добавить();
	СтрокаЗаказа.Идентификатор = ИдентификаторЗаказа;
	СтрокаЗаказа.Родитель = "";
	СтрокаЗаказа.Уровень = 0;
	СтрокаЗаказа.Представление = Строка(ШапкаЗаказа.ЗаказКлиента);
	СтрокаЗаказа.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
	СтрокаЗаказа.Дата = ШапкаЗаказа.Дата;
	СтрокаЗаказа.Организация = ШапкаЗаказа.Организация;
	СтрокаЗаказа.Контрагент = ШапкаЗаказа.Контрагент;
	СтрокаЗаказа.Программа = ШапкаЗаказа.Программа;
	СтрокаЗаказа.РасхождениеРасчетовСКлиентами = Состояние.РасхождениеРасчетовСКлиентами;
	СтрокаЗаказа.РасхождениеРасчетовСПоставщиками = Состояние.РасхождениеРасчетовСПоставщиками;
	СтрокаЗаказа.ЕстьСироты = Состояние.ЕстьСироты;

	Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

		Если ЗначениеЗаполнено(ХарактеристикаОтбора)
			И СтрокаФактов.Характеристика <> ХарактеристикаОтбора Тогда

			Продолжить;

		КонецЕсли;

		ИдентификаторПозиции = ИдентификаторЗаказа + "|POS|"
			+ Строка(СтрокаФактов.Номенклатура.УникальныйИдентификатор()) + "|"
			+ Строка(СтрокаФактов.Характеристика.УникальныйИдентификатор());
		СтрокаПозиции = Факты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПозиции, СтрокаФактов);
		СтрокаПозиции.Идентификатор = ИдентификаторПозиции;
		СтрокаПозиции.Родитель = ИдентификаторЗаказа;
		СтрокаПозиции.Уровень = 1;
		СтрокаПозиции.Представление = Строка(СтрокаФактов.Номенклатура) + " / " + Строка(СтрокаФактов.Характеристика);
		СтрокаПозиции.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
		СтрокаПозиции.Дата = ШапкаЗаказа.Дата;
		СтрокаПозиции.Организация = ШапкаЗаказа.Организация;
		СтрокаПозиции.Контрагент = ШапкаЗаказа.Контрагент;
		СтрокаПозиции.Программа = ШапкаЗаказа.Программа;
		СтрокаПозиции.РасхождениеРасчетовСКлиентами = Состояние.РасхождениеРасчетовСКлиентами;
		СтрокаПозиции.РасхождениеРасчетовСПоставщиками = Состояние.РасхождениеРасчетовСПоставщиками;
		СтрокаПозиции.ЕстьСироты = Состояние.ЕстьСироты;

		УжеДобавленныеДокументы = Новый Соответствие;
		ДобавитьСвязанныеДокументыПозиции(
			Факты,
			Состояние,
			СтрокаФактов,
			ИдентификаторПозиции,
			ШапкаЗаказа,
			УжеДобавленныеДокументы);

	КонецЦикла;

	Если Состояние.ЕстьСироты Тогда

		ДобавитьВеткуНеСвязанные(Факты, ИдентификаторЗаказа, ШапкаЗаказа, Состояние);

	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьВеткуНеСвязанные(Факты, ИдентификаторЗаказа, ШапкаЗаказа, Состояние)

	УзелНеСвязанные = НайтиУзелДереваПоТипу(Состояние.Дерево.Строки, "НеСвязанные");

	Если УзелНеСвязанные = Неопределено Тогда

		Возврат;

	КонецЕсли;

	ИдентификаторВетки = ИдентификаторЗаказа + "|ORPHANS";
	СтрокаВетки = Факты.Добавить();
	СтрокаВетки.Идентификатор = ИдентификаторВетки;
	СтрокаВетки.Родитель = ИдентификаторЗаказа;
	СтрокаВетки.Уровень = 1;
	СтрокаВетки.Представление = "Не связанные";
	СтрокаВетки.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
	СтрокаВетки.Дата = ШапкаЗаказа.Дата;
	СтрокаВетки.Организация = ШапкаЗаказа.Организация;
	СтрокаВетки.Контрагент = ШапкаЗаказа.Контрагент;
	СтрокаВетки.Программа = ШапкаЗаказа.Программа;
	СтрокаВетки.ЕстьСироты = Истина;

	УжеДобавленные = Новый Соответствие;

	Для Каждого СтрокаСироты Из УзелНеСвязанные.Строки Цикл

		Если Не ЗначениеЗаполнено(СтрокаСироты.Ссылка)
			Или СтрокаСироты.Тип = "ШтрихкодыУпаковокТоваров" Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьСтрокуДокументаПозиции(
			Факты,
			ИдентификаторВетки,
			ШапкаЗаказа,
			СтрокаСироты.Ссылка,
			СтрокаСироты.Тип,
			СтрокаСироты.Представление,
			Неопределено,
			УжеДобавленные);

	КонецЦикла;

КонецПроцедуры

Функция НайтиУзелДереваПоТипу(СтрокиДерева, ИмяТипа)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = ИмяТипа Тогда

			Возврат СтрокаДерева;

		КонецЕсли;

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			Результат = НайтиУзелДереваПоТипу(СтрокаДерева.Строки, ИмяТипа);

			Если Результат <> Неопределено Тогда

				Возврат Результат;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьСвязанныеДокументыПозиции(
	Факты,
	Состояние,
	СтрокаФактов,
	ИдентификаторПозиции,
	ШапкаЗаказа,
	УжеДобавленныеДокументы)

	ЯкоряПозиции = ЯкоряДокументовПозиции(Состояние, СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика);
	ДобавитьДокументыСборкиИЗП(
		Факты,
		Состояние,
		СтрокаФактов,
		ИдентификаторПозиции,
		ШапкаЗаказа,
		УжеДобавленныеДокументы);
	ДобавитьДокументыИзДереваЦепочки(
		Факты,
		Состояние.Дерево.Строки,
		Новый Массив,
		ЯкоряПозиции,
		СтрокаФактов,
		ИдентификаторПозиции,
		ШапкаЗаказа,
		УжеДобавленныеДокументы);

КонецПроцедуры

Процедура ДобавитьДокументыСборкиИЗП(
	Факты,
	Состояние,
	СтрокаФактов,
	ИдентификаторПозиции,
	ШапкаЗаказа,
	УжеДобавленныеДокументы)

	Для Каждого СтрокаСборки Из Состояние.ЗаказыНаСборку Цикл

		Если СтрокаСборки.Номенклатура <> СтрокаФактов.Номенклатура
			Или СтрокаСборки.Характеристика <> СтрокаФактов.Характеристика Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьСтрокуДокументаПозиции(
			Факты,
			ИдентификаторПозиции,
			ШапкаЗаказа,
			СтрокаСборки.ЗаказНаСборку,
			"ЗаказНаСборку",
			Строка(СтрокаСборки.ЗаказНаСборку),
			СтрокаСборки,
			УжеДобавленныеДокументы);

	КонецЦикла;

	Для Каждого СтрокаЗП Из Состояние.ЗаказыПоставщику Цикл

		Если СтрокаЗП.Номенклатура <> СтрокаФактов.Номенклатура
			Или СтрокаЗП.Характеристика <> СтрокаФактов.Характеристика Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьСтрокуДокументаПозиции(
			Факты,
			ИдентификаторПозиции,
			ШапкаЗаказа,
			СтрокаЗП.ЗаказПоставщику,
			"ЗаказПоставщику",
			Строка(СтрокаЗП.ЗаказПоставщику),
			СтрокаЗП,
			УжеДобавленныеДокументы);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьДокументыИзДереваЦепочки(
	Факты,
	СтрокиДерева,
	ПутьДокументов,
	ЯкоряПозиции,
	СтрокаФактов,
	ИдентификаторПозиции,
	ШапкаЗаказа,
	УжеДобавленныеДокументы)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			ДобавитьДокументыИзДереваЦепочки(
				Факты,
				СтрокаДерева.Строки,
				ПутьДокументов,
				ЯкоряПозиции,
				СтрокаФактов,
				ИдентификаторПозиции,
				ШапкаЗаказа,
				УжеДобавленныеДокументы);
			Продолжить;

		КонецЕсли;

		Если СтрокаДерева.Тип = "НеСвязанные"
			Или СтрокаДерева.Тип = "ШтрихкодыУпаковокТоваров" Тогда

			Продолжить;

		КонецЕсли;

		НовыйПуть = Новый Массив;

		Для Каждого ЭлементПути Из ПутьДокументов Цикл

			НовыйПуть.Добавить(ЭлементПути);

		КонецЦикла;

		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			НовыйПуть.Добавить(СтрокаДерева.Ссылка);

		КонецЕсли;

		Если ДокументДереваОтноситсяКПозиции(СтрокаДерева, НовыйПуть, ЯкоряПозиции, СтрокаФактов)
			И ЗначениеЗаполнено(СтрокаДерева.Ссылка)
			И СтрокаДерева.Тип <> "ЗаказНаСборку"
			И СтрокаДерева.Тип <> "ЗаказПоставщику" Тогда

			ПредставлениеДокумента = СтрокаДерева.Представление;

			Если ПустаяСтрока(ПредставлениеДокумента) Тогда

				ПредставлениеДокумента = Строка(СтрокаДерева.Ссылка);

			КонецЕсли;

			ДобавитьСтрокуДокументаПозиции(
				Факты,
				ИдентификаторПозиции,
				ШапкаЗаказа,
				СтрокаДерева.Ссылка,
				СтрокаДерева.Тип,
				ПредставлениеДокумента,
				Неопределено,
				УжеДобавленныеДокументы,
				СтрокаФактов);

		КонецЕсли;

		ДобавитьДокументыИзДереваЦепочки(
			Факты,
			СтрокаДерева.Строки,
			НовыйПуть,
			ЯкоряПозиции,
			СтрокаФактов,
			ИдентификаторПозиции,
			ШапкаЗаказа,
			УжеДобавленныеДокументы);

	КонецЦикла;

КонецПроцедуры

Функция ЯкоряДокументовПозиции(Состояние, Номенклатура, Характеристика)

	Якоря = Новый Соответствие;

	Для Каждого СтрокаСборки Из Состояние.ЗаказыНаСборку Цикл

		Если СтрокаСборки.Номенклатура = Номенклатура
			И СтрокаСборки.Характеристика = Характеристика Тогда

			Якоря.Вставить(СтрокаСборки.ЗаказНаСборку, Истина);

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаЗП Из Состояние.ЗаказыПоставщику Цикл

		Если СтрокаЗП.Номенклатура = Номенклатура
			И СтрокаЗП.Характеристика = Характеристика Тогда

			Якоря.Вставить(СтрокаЗП.ЗаказПоставщику, Истина);

		КонецЕсли;

	КонецЦикла;

	Возврат Якоря;

КонецФункции

Функция ДокументДереваОтноситсяКПозиции(СтрокаДерева, ПутьДокументов, ЯкоряПозиции, СтрокаФактов)

	Если ПутьСодержитЯкорь(ПутьДокументов, ЯкоряПозиции) Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "РеализацияТоваровУслуг"
		И СтрокаФактов.Реализовано > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "РасходныйОрдерНаТовары"
		И (СтрокаФактов.ОтгруженоОрдером > 0 Или ПутьСодержитТип("РеализацияТоваровУслуг", ПутьДокументов)) Тогда

		Возврат Истина;

	КонецЕсли;

	Если (СтрокаДерева.Тип = "ПоступлениеБезналичныхДенежныхСредств"
			Или СтрокаДерева.Тип = "ПриходныйКассовыйОрдер")
		И СтрокаФактов.ОплаченоКлиентом > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "ЗаявкаНаРасходованиеДенежныхСредств"
		И СтрокаФактов.Заявлено > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если (СтрокаДерева.Тип = "СписаниеБезналичныхДенежныхСредств"
			Или СтрокаДерева.Тип = "РасходныйКассовыйОрдер")
		И СтрокаФактов.ОплаченоПоставщику > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПутьСодержитЯкорь(ПутьДокументов, ЯкоряПозиции)

	Для Каждого ДокументПути Из ПутьДокументов Цикл

		Если ЯкоряПозиции.Получить(ДокументПути) <> Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПутьСодержитТип(ИмяТипа, ПутьДокументов)

	Для Каждого ДокументПути Из ПутьДокументов Цикл

		Если ТипЗнч(ДокументПути) = Тип("ДокументСсылка." + ИмяТипа) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьСтрокуДокументаПозиции(
	Факты,
	ИдентификаторПозиции,
	ШапкаЗаказа,
	СсылкаДокумента,
	ТипДокумента,
	ПредставлениеДокумента,
	СтрокаМетрик,
	УжеДобавленныеДокументы,
	СтрокаФактов = Неопределено)

	КлючДокумента = ТипДокумента + "|" + Строка(СсылкаДокумента.УникальныйИдентификатор());

	Если УжеДобавленныеДокументы.Получить(КлючДокумента) <> Неопределено Тогда

		Возврат;

	КонецЕсли;

	УжеДобавленныеДокументы.Вставить(КлючДокумента, Истина);
	СтрокаДокумента = Факты.Добавить();
	СтрокаДокумента.Идентификатор = ИдентификаторПозиции + "|DOC|" + КлючДокумента;
	СтрокаДокумента.Родитель = ИдентификаторПозиции;
	СтрокаДокумента.Уровень = 2;
	СтрокаДокумента.Представление = ПредставлениеДокумента;
	СтрокаДокумента.ТипДокумента = ТипДокумента;
	СтрокаДокумента.СвязанныйДокумент = СсылкаДокумента;
	СтрокаДокумента.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
	СтрокаДокумента.Дата = ШапкаЗаказа.Дата;
	СтрокаДокумента.Организация = ШапкаЗаказа.Организация;
	СтрокаДокумента.Контрагент = ШапкаЗаказа.Контрагент;
	СтрокаДокумента.Программа = ШапкаЗаказа.Программа;

	Если СтрокаМетрик <> Неопределено Тогда

		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаМетрик);

		Если СтрокаМетрик.Свойство("Оплачено") Тогда

			СтрокаДокумента.ОплаченоПоставщику = СтрокаМетрик.Оплачено;

		КонецЕсли;

	ИначеЕсли СтрокаФактов <> Неопределено Тогда

		СтрокаДокумента.Номенклатура = СтрокаФактов.Номенклатура;
		СтрокаДокумента.Характеристика = СтрокаФактов.Характеристика;

	КонецЕсли;

КонецПроцедуры

