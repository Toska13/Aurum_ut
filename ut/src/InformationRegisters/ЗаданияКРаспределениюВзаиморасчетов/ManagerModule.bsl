	|	ЗаданияКРаспределениюВзаиморасчетов.Документ КАК Документ,
	|	ЗаданияКРаспределениюВзаиморасчетов.Документ КАК Регистратор,
	|	ЗаданияКРаспределениюВзаиморасчетов.Организация КАК Организация,
	|	МИНИМУМ(ЗаданияКРаспределениюВзаиморасчетов.ПериодЗадания) КАК ДатаПересчета,
	|	МИНИМУМ(ЗаданияКРаспределениюВзаиморасчетов.ПериодЗадания) КАК ДатаНачалаПересчета,
	|	МИНИМУМ(ЗаданияКРаспределениюВзаиморасчетов.ПериодКонтроляИзменений) КАК ПериодКонтроляИзмененийИСозданияЗаданий,
	|	1 КАК Приоритет,
	|	ЛОЖЬ КАК ПоДаннымОбъектаРасчетовИсточника
	|ИЗ
	|	ВтКортежиКОбработке КАК ВтКортежиКОбработке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияКРаспределениюВзаиморасчетов КАК ЗаданияКРаспределениюВзаиморасчетов
	|		ПО ВтКортежиКОбработке.АналитикаУчетаПоПартнерам = ЗаданияКРаспределениюВзаиморасчетов.АналитикаУчетаПоПартнерам
	|		И ВтКортежиКОбработке.ОбъектРасчетов = ЗаданияКРаспределениюВзаиморасчетов.ОбъектРасчетов
	|		И ВтКортежиКОбработке.Валюта = ЗаданияКРаспределениюВзаиморасчетов.Валюта
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|		ПО ВтКортежиКОбработке.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВтКортежиКОбработке.АналитикаУчетаПоПартнерам,
	|	ВтКортежиКОбработке.ОбъектРасчетов,
	|	ВтКортежиКОбработке.Валюта,
	|	ЕСТЬNULL(ОбъектыРасчетов.ТипРасчетов, ЗНАЧЕНИЕ(Перечисление.ТипыРасчетовСПартнерами.ПустаяСсылка)),
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОбъектыРасчетов.ТипРасчетов,
	|			ЗНАЧЕНИЕ(Перечисление.ТипыРасчетовСПартнерами.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетовСПартнерами.РасчетыСКлиентом)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ЕСТЬNULL(ОбъектыРасчетов.Объект, НЕОПРЕДЕЛЕНО),
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПоПартнерам.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	ЗаданияКРаспределениюВзаиморасчетов.Документ,
	|	ЗаданияКРаспределениюВзаиморасчетов.Организация
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КортежиКОбработке.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	КортежиКОбработке.ОбъектРасчетов КАК ОбъектРасчетов,
	|	КортежиКОбработке.Валюта КАК Валюта,
	|	ЗаданияКРаспределениюВзаиморасчетов.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ЗаданияКРаспределениюВзаиморасчетов.ВыполненоСОшибкой КАК ВыполненоСОшибкой
	|ИЗ
	|	ВтКортежиКОбработке КАК КортежиКОбработке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияКРаспределениюВзаиморасчетов КАК ЗаданияКРаспределениюВзаиморасчетов
	|		ПО КортежиКОбработке.АналитикаУчетаПоПартнерам = ЗаданияКРаспределениюВзаиморасчетов.АналитикаУчетаПоПартнерам
	|		И КортежиКОбработке.ОбъектРасчетов = ЗаданияКРаспределениюВзаиморасчетов.ОбъектРасчетов
	|		И КортежиКОбработке.Валюта = ЗаданияКРаспределениюВзаиморасчетов.Валюта";
	
	Запрос.УстановитьПараметр("ТаблицаПорции", ПараметрыДанных.ПорцияДанных);
	
	УстановитьПривилегированныйРежим(Истина);
	ДанныеПоКортежам = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ИсходныеДанныеКРаспределению = ДанныеПоКортежам[ДанныеПоКортежам.ВГраница() - 1].Выгрузить(); // ТаблицаЗначений
	ИсходныеДанныеКРаспределению.Индексы.Добавить("АналитикаУчетаПоПартнерам, ОбъектРасчетов, Валюта");
	
	ИдентификаторыЗаданийКортежей = ДанныеПоКортежам[ДанныеПоКортежам.ВГраница()].Выгрузить();
	ИдентификаторыЗаданийКортежей.Индексы.Добавить("АналитикаУчетаПоПартнерам, ОбъектРасчетов, Валюта");
	
	ПараметрыОбработкиДанных = Новый Структура;
	ПорцияУспешноОбработана = Истина;
	Если Не ПараметрыДанных.ВыполнениеЗаданийВТранзакцииПроведения Тогда
		
		НачатьТранзакцию();
		Попытка
			
			ПричинаИсключения = "Блокировка";
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗаданияКРаспределениюВзаиморасчетов");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = ИдентификаторыЗаданийКортежей.Скопировать(Новый Структура("ВыполненоСОшибкой", Ложь));
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИдентификаторЗаписи", "ИдентификаторЗаписи");
			Блокировка.Заблокировать();
			
			ПричинаИсключения = "ПлохиеДанные";
			
			ПараметрыОбработкиДанных.Вставить("ДанныеКОбработке", ИсходныеДанныеКРаспределению);
			ПараметрыОбработкиДанных.Вставить("ДополнитьРаспределитьПриемники", Истина);
			ПараметрыОбработкиДанных.Вставить("РегистрироватьЗаданияПоПриемникам", Истина);
			УстановитьПривилегированныйРежим(Истина);
			ВзаиморасчетыСлужебный.ВыполнитьОтложенноеРаспределение(ПараметрыОбработкиДанных);
			НеоперативнаяОчередьЗаданий.УдалитьЗаданияОчереди(ПараметрыДанных.ИмяРегистраОчереди,
				ИдентификаторыЗаданийКортежей.ВыгрузитьКолонку("ИдентификаторЗаписи"));
			УстановитьПривилегированныйРежим(Ложь);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ПорцияУспешноОбработана = Ложь;
		КонецПопытки;
		
		Если ПорцияУспешноОбработана Тогда
			УстановитьПривилегированныйРежим(Истина);
			НеоперативнаяОчередьЗаданий.СнятьПризнакВыполненоСОшибкойПоДокументам(
				ОбщегоНазначенияКлиентСервер.СвернутьМассив(ИсходныеДанныеКРаспределению.ВыгрузитьКолонку("Документ")),
				ПараметрыДанных.ВидЗадания);
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаОшибок = ТаблицаГранулРасчета();
	ТаблицаОшибок.Колонки.Добавить("ОписаниеОшибки", Новый ОписаниеТипов("Строка"));
	
	СтруктураОтбораДанных = Новый Структура("АналитикаУчетаПоПартнерам, ОбъектРасчетов, Валюта");

	ОбработанныеСтрокиПорцииДанных = Новый Массив;
	ОбработанныеИдентификаторыКортежей = Новый Массив;

	НомерПопытки = 1;
	КоличествоПопыток = ?(ПараметрыДанных.ВыполнениеЗаданийВТранзакцииПроведения, 1, 3);
	Пока НомерПопытки <= КоличествоПопыток Цикл

		Если ПараметрыДанных.ПорцияДанных.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого КортежКОбработке Из ПараметрыДанных.ПорцияДанных Цикл
			
			ОбработкаКортежаВыполненаУспешно = Истина;
			ПричинаИсключения = "ПлохиеДанные";
			
			СтруктураОтбораДанных.АналитикаУчетаПоПартнерам = КортежКОбработке.АналитикаУчетаПоПартнерам;
			СтруктураОтбораДанных.ОбъектРасчетов = КортежКОбработке.ОбъектРасчетов;
			СтруктураОтбораДанных.Валюта = КортежКОбработке.Валюта;
			
			ДанныеКОбработке = ИсходныеДанныеКРаспределению.Скопировать(СтруктураОтбораДанных);
			ТаблицаИдентификаторовКортежей = ИдентификаторыЗаданийКортежей.Скопировать(СтруктураОтбораДанных);
			СписокОбрабатываемыхИдентификаторовЗаданий = ТаблицаИдентификаторовКортежей.ВыгрузитьКолонку("ИдентификаторЗаписи");
			ДокументыПоКортежу = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДанныеКОбработке.ВыгрузитьКолонку("Документ"));
			
			НачатьТранзакцию();

			Попытка
				
				ПричинаИсключения = "Блокировка";
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗаданияКРаспределениюВзаиморасчетов");
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
				ЭлементБлокировки.ИсточникДанных = ТаблицаИдентификаторовКортежей.Скопировать(Новый Структура("ВыполненоСОшибкой", Ложь));
				ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИдентификаторЗаписи", "ИдентификаторЗаписи");
				Блокировка.Заблокировать();
				
				ПричинаИсключения = "ПлохиеДанные";
				
				ПараметрыОбработкиДанных.Вставить("ДанныеКОбработке", ДанныеКОбработке);
				ПараметрыОбработкиДанных.Вставить("ДополнитьРаспределитьПриемники", Истина);
				ПараметрыОбработкиДанных.Вставить("РегистрироватьЗаданияПоПриемникам", Истина);
				УстановитьПривилегированныйРежим(Истина);
				ВзаиморасчетыСлужебный.ВыполнитьОтложенноеРаспределение(ПараметрыОбработкиДанных);
				НеоперативнаяОчередьЗаданий.УдалитьЗаданияОчереди(ПараметрыДанных.ИмяРегистраОчереди,
					СписокОбрабатываемыхИдентификаторовЗаданий);
				УстановитьПривилегированныйРежим(Ложь);

				ЗафиксироватьТранзакцию();

			Исключение

				ОтменитьТранзакцию();
				
				ОбработкаКортежаВыполненаУспешно = Ложь;
				
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
				ДокументыГруппыОбработки = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
					ДанныеКОбработке.ВыгрузитьКолонку("Документ"));
				
				Для Каждого ТекущийДокумент Из ДокументыГруппыОбработки Цикл
					НеоперативнаяОчередьЗаданий.ЗаписатьОшибкуВЖурналРегистрации(
						МетаданныеРегистраОчереди, ПараметрыДанных.ВидЗадания, ТекстОшибки, ТекущийДокумент);
				КонецЦикла;
				
				Если ПричинаИсключения = "ПлохиеДанные" Или ПараметрыДанных.ВыполнениеЗаданийВТранзакцииПроведения Тогда
					
					ЗаписьОбОшибке = ТаблицаОшибок.Добавить();
					ЗаписьОбОшибке.АналитикаУчетаПоПартнерам = КортежКОбработке.АналитикаУчетаПоПартнерам;
					ЗаписьОбОшибке.ОбъектРасчетов = КортежКОбработке.ОбъектРасчетов;
					ЗаписьОбОшибке.Валюта = КортежКОбработке.Валюта;
					ЗаписьОбОшибке.ОписаниеОшибки = ТекстОшибки;
					
				КонецЕсли;
				
			КонецПопытки;
			
			Если ОбработкаКортежаВыполненаУспешно 
				Или (Не ПараметрыДанных.ВыполнениеЗаданийВТранзакцииПроведения 
					И ПричинаИсключения = "Блокировка" И НомерПопытки = КоличествоПопыток) Тогда
				
				ОбработанныеСтрокиПорцииДанных.Добавить(КортежКОбработке);
				
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОбработанныеИдентификаторыКортежей,
						СписокОбрабатываемыхИдентификаторовЗаданий);
				
				Если ОбработкаКортежаВыполненаУспешно Тогда
					УстановитьПривилегированныйРежим(Истина);
					НеоперативнаяОчередьЗаданий.СнятьПризнакВыполненоСОшибкойПоДокументам(ДокументыПоКортежу,
						ПараметрыДанных.ВидЗадания);
					УстановитьПривилегированныйРежим(Ложь);
				КонецЕсли;
					
			КонецЕсли;

		КонецЦикла;

		Если ОбработанныеСтрокиПорцииДанных.Количество() > 0 Тогда

			Для Каждого ДанныеКУдалению Из ОбработанныеСтрокиПорцииДанных Цикл
				ПараметрыДанных.ПорцияДанных.Удалить(ДанныеКУдалению);
			КонецЦикла;
			
			ОбработанныеСтрокиПорцииДанных.Очистить();

		КонецЕсли;

		НомерПопытки = НомерПопытки + 1;

	КонецЦикла;
	
	Если Не ПараметрыДанных.ВыполнениеЗаданийВТранзакцииПроведения Тогда
		
		Если ПараметрыДанных.ПорцияДанных.Количество() > 0 Тогда
			ЗарегистрироватьОшибкиОбработкиДанных(ОбщегоНазначенияКлиентСервер.РазностьМассивов(
				ИдентификаторыЗаданийКортежей.ВыгрузитьКолонку("ИдентификаторЗаписи"),
				ОбработанныеИдентификаторыКортежей), ТаблицаОшибок);
		КонецЕсли;
		
	Иначе
		
		СообщитьОбОшибкахОбработкиДанных(ТаблицаОшибок);
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОтложенныеЗадания

// Возвращает текст запроса выборки заданий.
//
// Параметры:
//  Запрос            - см. ОтложенныеЗадания.ТекстЗапросаВыборкиЗаданийПоУмолчанию.Запрос
//  ПараметрыОчереди  - см. ОтложенныеЗадания.ТекстЗапросаВыборкиЗаданийПоУмолчанию.ПараметрыОчереди
//  КоличествоЗаданий - см. ОтложенныеЗадания.ТекстЗапросаВыборкиЗаданийПоУмолчанию.Запрос
//
// Возвращаемое значение:
//  Строка - текст запроса выборки заданий
//
Функция ТекстЗапросаВыборкиЗаданий(Запрос, ПараметрыОчереди, КоличествоЗаданий) Экспорт
	
	ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаданияКРаспределениюВзаиморасчетов.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
		|	ЗаданияКРаспределениюВзаиморасчетов.ОбъектРасчетов КАК ОбъектРасчетов,
		|ЗаданияКРаспределениюВзаиморасчетов.Валюта КАК Валюта
		|ПОМЕСТИТЬ ВТ_ОбрабатываемыеКортежи
		|ИЗ
		|	РегистрСведений.ЗаданияКРаспределениюВзаиморасчетов КАК ЗаданияКРаспределениюВзаиморасчетов
		|ГДЕ
		|	ЗаданияКРаспределениюВзаиморасчетов.ИдентификаторЗаписи В(&ИдентификаторыПереданныеВРабочиеПотоки)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	АналитикаУчетаПоПартнерам,
		|	ОбъектРасчетов,
		|	Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Задания.АналитикаУчетаПоПартнерам    КАК АналитикаУчетаПоПартнерам,
		|	Задания.ОбъектРасчетов               КАК ОбъектРасчетов,
		|	Задания.Валюта                       КАК Валюта,
		|	МИНИМУМ(Задания.ИдентификаторЗаписи) КАК ИдентификаторЗадания,
		|	ЛОЖЬ                                 КАК ВыполненоСОшибкой,
		|	МИНИМУМ(Задания.ПериодЗадания)       КАК ДатаНачалаПересчета
		|ПОМЕСТИТЬ ВсеЗадания
		|ИЗ
		|	РегистрСведений.ЗаданияКРаспределениюВзаиморасчетов КАК Задания
		|
		|ГДЕ
		|	Задания.ВыполненоСОшибкой = ЛОЖЬ
		|	И НЕ ИСТИНА В
		|		(ВЫБРАТЬ ПЕРВЫЕ 1
		|			ИСТИНА
		|			ИЗ
		|				ВТ_ОбрабатываемыеКортежи КАК ОбрабатываемыеКортежи
		|			ГДЕ
		|				Задания.АналитикаУчетаПоПартнерам = ОбрабатываемыеКортежи.АналитикаУчетаПоПартнерам
		|				И Задания.ОбъектРасчетов = ОбрабатываемыеКортежи.ОбъектРасчетов
		|				И Задания.Валюта = ОбрабатываемыеКортежи.Валюта)
		|
		|СГРУППИРОВАТЬ ПО
