// СтандартныеПодсистемы.ОбновлениеВерсииИБ

// Заполняет регистр сведений по данным общих настроек созданных патчем.
//
// Параметры:
//  Параметры - Структура - параметры обработчика обновления.
//                          См. документацию по подсистеме СтандартныеПодсистемы.ОбновлениеВерсииИБ.
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ОбработкаЗавершена = Ложь;
	
	НачатьТранзакцию();
	Попытка
		ОписаниеЧисла_15_0 = ОбщегоНазначения.ОписаниеТипаЧисло(15, 0, ДопустимыйЗнак.Неотрицательный);
		
		ТаблицаНастроек = Новый ТаблицаЗначений;
		ТаблицаНастроек.Колонки.Добавить("ИдентификаторЭДО", ОбщегоНазначения.ОписаниеТипаСтрока(70));
		ТаблицаНастроек.Колонки.Добавить("ДатаПолучения", ОписаниеЧисла_15_0);
		ТаблицаНастроек.Колонки.Добавить("ДатаПолученияЭПД", ОписаниеЧисла_15_0);
		ТаблицаНастроек.Колонки.Добавить("ПроверочнаяДатаПолучения", ОписаниеЧисла_15_0);
		
		ТаблицаНастроекПатча = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ПереводИзТакскомКлючНастроек", 
			"УчетныеЗаписиПереведенныеИзТакском", 
			ТаблицаНастроек, 
			, 
			"ПереводИзТакскомКлючНастроек");
			
		Если ЗначениеЗаполнено(ТаблицаНастроекПатча) Тогда
			
			Для Каждого СтрокаИзПатча Из ТаблицаНастроекПатча Цикл
				
				Набор = СоздатьНаборЗаписей();
				Набор.Отбор.ИдентификаторЭДО.Установить(СтрокаИзПатча.ИдентификаторЭДО);
				СтрокаНабора = Набор.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНабора, СтрокаИзПатча);
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Набор);
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОбработкаЗавершена = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить регистр Учетные записи переводимые из Такском по причине:'") + Символы.ПС 
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,,, ТекстСообщения);
	КонецПопытки;
	
	Параметры.ОбработкаЗавершена = ОбработкаЗавершена;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ОбновлениеВерсииИБ

