#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьРеквизитыИзПараметров();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВложения

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	Если Не ЗначениеЗаполнено(ОписаниеПроблемы) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо заполнить описание проблемы.'"),
			,
			"ОписаниеПроблемы");
		Возврат;
		
	КонецЕсли;
	
	ОтправитьОбращениеВПоддержку();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложение(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьВложениеЗавершение", ЭтотОбъект);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ФайловаяСистемаКлиент.ЗагрузитьФайлы(Оповещение, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВложение(Команда)
	
	ИдентификаторыСтрок = Элементы.Вложения.ВыделенныеСтроки;
	
	Если ИдентификаторыСтрок.Количество() = 0 Тогда
		
		ТекущаяСтрока = Элементы.Вложения.ТекущиеДанные;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Вложения.Удалить(ТекущаяСтрока);
		Возврат;
		
	КонецЕсли;
	
	КоличествоВыделенных = ИдентификаторыСтрок.Количество();
	Для Смещение = 1 По КоличествоВыделенных Цикл
		
		ИдентификаторСтроки = ИдентификаторыСтрок[КоличествоВыделенных - Смещение];
		СтрокаВложения = Вложения.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаВложения <> Неопределено Тогда
			Вложения.Удалить(СтрокаВложения);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьРеквизитыИзПараметров()
	
	ИмяФормыИсточника = СтрокаИзПараметров("ИмяФормыИсточника", "ИмяФормы");
	ЗаголовокФормыИсточника = СтрокаИзПараметров("ЗаголовокФормыИсточника", "ЗаголовокФормы");
	ТекстКонтекста = СтрокаИзПараметров("ТекстКонтекста", "ТекстКонтекста");
	
	ДополнитьТекстКонтекстаОшибками();
	ЗаполнитьСнимокЭкранаИзПараметров();
	
КонецПроцедуры

&НаСервере
Функция СтрокаИзПараметров(ИмяКлючаРеквизита, ИмяКлючаСбора)
	
	ЗначениеПараметра = Неопределено;
	
	Если Параметры.Свойство(ИмяКлючаРеквизита, ЗначениеПараметра)
		И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		
		Возврат Строка(ЗначениеПараметра);
		
	КонецЕсли;
	
	Если ИмяКлючаСбора <> ИмяКлючаРеквизита
		И Параметры.Свойство(ИмяКлючаСбора, ЗначениеПараметра)
		И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		
		Возврат Строка(ЗначениеПараметра);
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура ДополнитьТекстКонтекстаОшибками()
	
	ОшибкиСбора = Неопределено;
	Если Не Параметры.Свойство("Ошибки", ОшибкиСбора) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОшибкиСбора) <> Тип("Массив") Или ОшибкиСбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиТекста = Новый Массив;
	Если Не ПустаяСтрока(ТекстКонтекста) Тогда
		ЧастиТекста.Добавить(ТекстКонтекста);
	КонецЕсли;
	
	ЧастиТекста.Добавить(НСтр("ru = '=== Ошибки сбора ==='"));
	Для Каждого ТекстОшибки Из ОшибкиСбора Цикл
		ЧастиТекста.Добавить(Строка(ТекстОшибки));
	КонецЦикла;
	
	ТекстКонтекста = СтрСоединить(ЧастиТекста, Символы.ПС);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСнимокЭкранаИзПараметров()
	
	ЗначениеСнимка = Неопределено;
	Если Не Параметры.Свойство("СнимокЭкрана", ЗначениеСнимка)
		Или ЗначениеСнимка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеСнимка) = Тип("Картинка") Тогда
		СнимокЭкрана = ЗначениеСнимка;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеСнимка) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	АдресСнимка = "";
	Если Не ЗначениеСнимка.Свойство("АдресФайла", АдресСнимка)
		Или Не ЗначениеЗаполнено(АдресСнимка) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанныеСнимка = ПолучитьИзВременногоХранилища(АдресСнимка);
	Если ТипЗнч(ДвоичныеДанныеСнимка) = Тип("ДвоичныеДанные") Тогда
		СнимокЭкрана = Новый Картинка(ДвоичныеДанныеСнимка);
	КонецЕсли;
	
КонецПроцедуры

// Отправляет обращение в поддержку. Заглушка: фактическая отправка будет добавлена позже.
//
&НаКлиенте
Процедура ОтправитьОбращениеВПоддержку()
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(
		НСтр("ru = 'Отправка обращения в поддержку будет реализована позже.'"));
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложениеЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПомещенныеФайлы) = Тип("Массив") Тогда
		
		Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
			ДобавитьСтрокуВложения(ПомещенныйФайл);
		КонецЦикла;
		
	Иначе
		
		ДобавитьСтрокуВложения(ПомещенныеФайлы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуВложения(ПомещенныйФайл)
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайла = ПомещенныйФайл.Хранение;
	Если Не ЗначениеЗаполнено(АдресФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСтроки = ПомещенныйФайл.Имя;
	Если ЗначениеЗаполнено(ИмяФайлаСтроки) Тогда
		ФайлНаДиске = Новый Файл(ИмяФайлаСтроки);
		ИмяФайлаСтроки = ФайлНаДиске.Имя;
	КонецЕсли;
	
	СтрокаВложения = Вложения.Добавить();
	СтрокаВложения.ИмяФайла = ИмяФайлаСтроки;
	СтрокаВложения.АдресФайла = АдресФайла;
	
КонецПроцедуры

#КонецОбласти
