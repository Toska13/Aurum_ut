&НаСервере
Функция ПолучитьЕдиницуИзмерения(Единица) Экспорт
	
	НайденнаяЕдиница=Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(Единица,,,Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Если НЕ ЗначениеЗаполнено(НайденнаяЕдиница) Тогда
		НайденнаяЕдиница=Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт",,,Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	КонецЕсли;
	
	Возврат НайденнаяЕдиница;
	
КонецФункции

&НаСервере
Функция ПолучитьСтавкуНДС(СтавкаНДС) Экспорт
	
	Если Найти(ВРЕГ(СокрЛП(СтавкаНДС)),"БЕЗ")>0 Тогда
		Возврат УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.БезНДС);
	ИначеЕсли Найти(СокрЛП(СтавкаНДС),"20")>0 Тогда
		Возврат УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
	ИначеЕсли Найти(СокрЛП(СтавкаНДС),"22")>0 Тогда
		Возврат УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
	ИначеЕсли Найти(СокрЛП(СтавкаНДС),"10")>0 Тогда
		Возврат УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС10);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьГруппуДляНовыхЭлементов(ПапкаНовойНоменклатуры) Экспорт
	
	Если ЗначениеЗаполнено(ПапкаНовойНоменклатуры) Тогда
		Возврат ПапкаНовойНоменклатуры;
	Иначе
		Возврат Справочники.Номенклатура.НайтиПоНаименованию("! Новые элементы - разобрать по группам");
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьСоздатьНоменклатуруКонтрагента(Партнер,Наименование,Артикул,СтавкаНДС) Экспорт
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	СпрНоменклатура.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.НоменклатураКонтрагентов КАК СпрНоменклатура
		             |ГДЕ
		             |	СпрНоменклатура.НаименованиеНоменклатуры = &Наименование
		             |	И СпрНоменклатура.Владелец = &Партнер";
		Запрос.УстановитьПараметр("Наименование",СокрЛП(Лев(Наименование,1024)));
		Запрос.УстановитьПараметр("Партнер",Партнер);
		
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Артикул) Тогда
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	СпрНоменклатура.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.НоменклатураКонтрагентов КАК СпрНоменклатура
		             |ГДЕ
		             |	СпрНоменклатура.Артикул = &Артикул
		             |	И СпрНоменклатура.Владелец = &Партнер";
		Запрос.УстановитьПараметр("Артикул",СокрЛП(Лев(Артикул,1024)));
		Запрос.УстановитьПараметр("Партнер",Партнер);
		
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	НоваяНоменклатура=Справочники.НоменклатураКонтрагентов.СоздатьЭлемент();
	НоваяНоменклатура.Владелец=Партнер;
	НоваяНоменклатура.ВладелецНоменклатуры=Партнер;
	НоваяНоменклатура.Наименование=Наименование;
	НоваяНоменклатура.НаименованиеНоменклатуры=Наименование;
	НоваяНоменклатура.Артикул=Артикул;
	НоваяНоменклатура.СтавкаНДС=ПолучитьСтавкуНДС(СтавкаНДС);
	НоваяНоменклатура.ОбменДанными.Загрузка=Истина;
	НоваяНоменклатура.Номенклатура=ПолучитьНоменклатуру(Артикул,Наименование);
	НоваяНоменклатура.Записать();
	
	Возврат НоваяНоменклатура.Ссылка;
	
КонецФункции

