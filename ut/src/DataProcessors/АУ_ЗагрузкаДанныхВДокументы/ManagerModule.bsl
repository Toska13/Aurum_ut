&НаСервере
Функция ПолучитьСоздатьНоменклатуру(ВидНовойНоменклатуры,ПапкаНовойНоменклатуры,Наименование,Единица,СтавкаНДС,Артикул,ИмпортныйТовар = "", Производитель = "", НеИскатьПоАртикулу = Ложь, НеИскатьПоНаименованию = Ложь, ОбновитьРеквизиты = Ложь, НеИскатьАрхивные = Ложь) Экспорт
	
	НоваяНоменклатура = Неопределено;
	
	Если ЗначениеЗаполнено(Наименование) И НЕ НеИскатьПоНаименованию Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	Номенклатура.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.Номенклатура КАК Номенклатура
		             |ГДЕ
		             |	Номенклатура.НаименованиеПолное = &Наименование";
		
		Если НеИскатьАрхивные Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И НЕ Номенклатура.АУ_ВАрхиве
			|	И НЕ Номенклатура.Наименование ПОДОБНО ""(не использовать)%""";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Наименование",СокрЛП(Лев(Наименование,1024)));
		
		Выборка=Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если НЕ ОбновитьРеквизиты Тогда
				Возврат Выборка.Ссылка;
			Иначе
				НоваяНоменклатура = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	Номенклатура.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.Номенклатура КАК Номенклатура
		             |ГДЕ
		             |	Номенклатура.Наименование = &Наименование";
		
		Если НеИскатьАрхивные Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И НЕ Номенклатура.АУ_ВАрхиве
			|	И НЕ Номенклатура.Наименование ПОДОБНО ""(не использовать)%""";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Наименование",СокрЛП(Лев(Наименование,1024)));
		
		Выборка=Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если НЕ ОбновитьРеквизиты Тогда
				Возврат Выборка.Ссылка;
			Иначе
				НоваяНоменклатура = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	Номенклатура.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.Номенклатура КАК Номенклатура
		             |ГДЕ
		             |	Номенклатура.Код = &Наименование";
		
		Если НеИскатьАрхивные Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И НЕ Номенклатура.АУ_ВАрхиве
			|	И НЕ Номенклатура.Наименование ПОДОБНО ""(не использовать)%""";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Наименование",СокрЛП(Лев(Наименование,1024)));
		
		Выборка=Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если НЕ ОбновитьРеквизиты Тогда
				Возврат Выборка.Ссылка;
			Иначе
				НоваяНоменклатура = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ НеИскатьПоАртикулу Тогда
			
			Запрос=Новый Запрос;
			Запрос.Текст="ВЫБРАТЬ
			             |	Номенклатура.Ссылка КАК Ссылка
			             |ИЗ
			             |	Справочник.Номенклатура КАК Номенклатура
			             |ГДЕ
			             |	Номенклатура.Артикул = &Наименование";
			
			Если НеИскатьАрхивные Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И НЕ Номенклатура.АУ_ВАрхиве
				|	И НЕ Номенклатура.Наименование ПОДОБНО ""(не использовать)%""";
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Наименование",СокрЛП(Лев(Наименование,1024)));
			
			Выборка=Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Если НЕ ОбновитьРеквизиты Тогда
					Возврат Выборка.Ссылка;
				Иначе
					НоваяНоменклатура = Выборка.Ссылка.ПолучитьОбъект();
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Артикул) И НЕ НеИскатьПоАртикулу Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		             |	Номенклатура.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.Номенклатура КАК Номенклатура
		             |ГДЕ
		             |	Номенклатура.Артикул = &Артикул";
		
		Если НеИскатьАрхивные Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И НЕ Номенклатура.АУ_ВАрхиве
			|	И НЕ Номенклатура.Наименование ПОДОБНО ""(не использовать)%""";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Артикул",Артикул);
		
		Выборка=Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если НЕ ОбновитьРеквизиты Тогда
				Возврат Выборка.Ссылка;
			Иначе
				НоваяНоменклатура = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоваяНоменклатура = Неопределено Тогда
		НоваяНоменклатура=Справочники.Номенклатура.СоздатьЭлемент();
	КонецЕсли;
	
	НоваяНоменклатура.ВидНоменклатуры=?(ЗначениеЗаполнено(ВидНовойНоменклатуры),ВидНовойНоменклатуры,Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары со сроками годности (с шифром, с сериями, без маркировки)"));
	ЗаполнитьЗначенияСвойств(НоваяНоменклатура,НоваяНоменклатура.ВидНоменклатуры,,"Наименование,Код,Владелец,Родитель");
	НоваяНоменклатура.Наименование=Наименование;
	НоваяНоменклатура.НаименованиеПолное=Наименование;
	НоваяНоменклатура.Описание=Наименование;
	НоваяНоменклатура.Артикул=Артикул;
	НоваяНоменклатура.ВариантОформленияПродажи=Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	НоваяНоменклатура.ЕдиницаИзмерения=ПолучитьЕдиницуИзмерения(Единица);
	НоваяНоменклатура.СтавкаНДС=ПолучитьСтавкуНДС(СтавкаНДС);
	НоваяНоменклатура.Родитель=ПолучитьГруппуДляНовыхЭлементов(ПапкаНовойНоменклатуры);
	
	Если ЗначениеЗаполнено(ИмпортныйТовар) И НЕ ВРЕГ(СокрЛП(ИмпортныйТовар))="НЕТ" Тогда
		НоваяНоменклатура.ВестиУчетПоГТД = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Производитель) Тогда
		НоваяНоменклатура.Производитель = ПолучитьПроизводителя(Производитель);
	КонецЕсли;
	
	НоваяНоменклатура.ОбменДанными.Загрузка=Истина;
	НоваяНоменклатура.Записать();
	
	рег=РегистрыСведений.СтавкиНДСНоменклатуры.СоздатьМенеджерЗаписи();
	рег.Номенклатура=НоваяНоменклатура.Ссылка;
	рег.СтавкаНДС=НоваяНоменклатура.СтавкаНДС;
	рег.Период=НачалоГода(ДобавитьМесяц(ТекущаяДата(),-12));
	рег.Страна=Константы.ОсновнаяСтрана.Получить();
	рег.Записать(Истина);
	
	Возврат НоваяНоменклатура.Ссылка;
	
КонецФункции

