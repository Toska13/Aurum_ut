
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВводДанных.Область(1,1,1,1).Текст="Артикул";
	ВводДанных.Область(1,2,1,2).Текст="Наименование";
	ВводДанных.Область(1,3,1,3).Текст="Количество";
	
	НеИскатьАрхивные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Закрыть(ПодготовитьДанныеДляЗагрузки());
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляЗагрузки()
	
	Результат=Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Артикул");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Количество");
	
	Для н=2 По ВводДанных.ВысотаТаблицы Цикл
		
		Артикул=СокрЛП(ВводДанных.Область(н,1,н,1).Текст);
		Наименование=СокрЛП(ВводДанных.Область(н,2,н,2).Текст);
		Количество=ВводДанных.Область(н,3,н,3).Текст;
		
		Если НЕ ЗначениеЗаполнено(СокрЛП(Наименование)) И НЕ ЗначениеЗаполнено(СокрЛП(Артикул)) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока=Результат.Добавить();
		НоваяСтрока.Номенклатура=Обработки.АУ_ЗагрузкаДанныхВДокументы.ПолучитьНоменклатуру(Артикул, Наименование, НеИскатьПоАртикулу, НеИскатьПоНаименованию, НеИскатьАрхивные);
		НоваяСтрока.Количество=Количество;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Результат);
	
КонецФункции

