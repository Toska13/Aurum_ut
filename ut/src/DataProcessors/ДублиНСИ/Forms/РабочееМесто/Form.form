    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДублиНСИ.ДатаПоискаМестИспользования</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДублиНСИ.ИндексКартинки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДублиНСИ.КоличествоМестИспользования</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДублиНСИ.ТипСсылки КАК ТипСсылки,
	ДублиНСИ.Дубль КАК Дубль,
	ДублиНСИ.Оригинал КАК Оригинал,
	ДублиНСИ.Ответственный КАК Ответственный,
	ДублиНСИ.ДатаДобавления КАК ДатаДобавления,
	ДублиНСИ.КоличествоМестИспользования КАК КоличествоМестИспользования,
	ДублиНСИ.ДатаПоискаМестИспользования КАК ДатаПоискаМестИспользования,
	ДублиНСИ.СостояниеУдаленияДубля КАК СостояниеУдаленияДубля,
	ДублиНСИ.КоличествоПопытокЗамены КАК КоличествоПопытокЗамены,
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(50)) КАК МестИспользования,
	0 КАК ИндексКартинки,
	ВЫБОР
		КОГДА ДублиНСИ.КоличествоПопытокЗамены > 0
			ТОГДА &quot;Подробнее&quot;
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК ОшибкиЗамены
ИЗ
	РегистрСведений.ДублиНСИ КАК ДублиНСИ</queryText>
      <mainTable>InformationRegister.ДублиНСИ</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Дубль</dataPath>
        <field>Дубль</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Оригинал</dataPath>
        <field>Оригинал</field>
      </fields>
