&НаКлиенте
Процедура РассчитатьСуммуАкцизаВТабЧасти(СтрокаТаблицы)
	
	СтрокаТаблицы.СуммаАкциза = СтрокаТаблицы.Количество * СтрокаТаблицы.КоэффициентПересчета * СтрокаТаблицы.ТвердаяСтавкаАкциза;
	Если СтрокаТаблицы.ЕдиницаИзмеренияАкциза = "214" Тогда
		СтрокаТаблицы.СуммаАкциза = СтрокаТаблицы.СуммаАкциза / 0.75;
	КонецЕсли;
	СтрокаТаблицы.НалоговаяБазаАкцизы = СтрокаТаблицы.Количество * СтрокаТаблицы.КоэффициентПересчета;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыбораНоменклатурыПартнера(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекущаяСтрока.НоменклатураПартнера = ВыбранноеЗначение;
	
	ТоварыНоменклатураПартнераПриИзменении(ДополнительныеПараметры.ЭлементФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСЗапросомДальнейшегоДействия(ОповещениеЗавершения = Неопределено)
	
	ОчиститьСообщения();
	
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ОбновитьТекстСостояние(Организация, НомерДОПП, СуммаОП)
	
	Если Не ЗначениеЗаполнено(НомерДОПП) Тогда
				ТекстРаспоряжения = НСтр("ru = 'Принять к учету / отменить'");
	Иначе
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("НомерДОПП", НомерДОПП);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.Текст = "ВЫБРАТЬ
		|	СУММА(ДокументыОПредстоящейПоставке.СуммаНалога) КАК СуммаНалога
		|ИЗ
		|	РегистрСведений.ДокументыОПредстоящейПоставке КАК ДокументыОПредстоящейПоставке
		|ГДЕ
		|	ДокументыОПредстоящейПоставке.НомерДОПП = &НомерДОПП
		|	И ДокументыОПредстоящейПоставке.Организация = &Организация
		|	И ДокументыОПредстоящейПоставке.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостояниеДОПП.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументыОПредстоящейПоставке.НомерДОПП";
		
		Результат = Запрос.Выполнить().Выбрать();
		
		СуммаПринято = 0;
		ЗаписьЕсть = Ложь;
		Если Результат.Следующий() Тогда
			СуммаПринято = Результат.СуммаНалога;
			ЗаписьЕсть = Истина;
		КонецЕсли;
		
		ОсталосьПринять = СуммаОП - СуммаПринято;
		
		Если СуммаПринято = 0 Или Не ЗаписьЕсть Тогда
			ТекстРаспоряжения = НСтр("ru = 'Принять к учету / отменить'");
		ИначеЕсли ОсталосьПринять <= 0 Тогда
			ТекстРаспоряжения = НСтр("ru = 'Принят к учету / отменен полностью'");
		Иначе
			ТекстРаспоряжения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru = 'Принято к учету / отменено %1; Осталось принять / отменить %2'"),
												СуммаПринято,
												ОсталосьПринять);
		КонецЕсли;
	КонецЕсли;
	
	НавигационнаяСсылкаСостояние = "СостояниеДОПП";
	ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
	
	Возврат Новый ФорматированнаяСтрока(ТекстРаспоряжения, , ЦветТекста, , НавигационнаяСсылкаСостояние);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыДОПП(Объект)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерДОПП", Объект.НомерДОПП);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	|	ДокументыОПредстоящейПоставке.Организация КАК Организация,
	|	ДокументыОПредстоящейПоставке.ДатаСобытия КАК ДатаСобытия,
	|	ДокументыОПредстоящейПоставке.КБК КАК КБК,
	|	ДокументыОПредстоящейПоставке.НомерДОПП КАК НомерДОПП
	|ИЗ
	|	РегистрСведений.ДокументыОПредстоящейПоставке КАК ДокументыОПредстоящейПоставке
	|ГДЕ
	|	ДокументыОПредстоящейПоставке.НомерДОПП = &НомерДОПП
	|	И ДокументыОПредстоящейПоставке.Организация = &Организация";
	
	Результат = Запрос.Выполнить().Выгрузить();
	РеквизитыДОПП = Новый Структура();
	РеквизитыДОПП.Вставить("КоличествоЗаписей", Результат.Количество());
	РеквизитыДОПП.Вставить("Организация",       Объект.Организация);
	РеквизитыДОПП.Вставить("НомерДОПП",         Объект.НомерДОПП);
	РеквизитыДОПП.Вставить("Проведен",          Объект.Проведен);
	РеквизитыДОПП.Вставить("СуммаДокумента",    Объект.СуммаДокумента);
	Если Результат.Количество() = 1 Тогда
		ЗначениеКлюча = Новый Структура();
		ЗначениеКлюча.Вставить("Организация", Результат[0].Организация);
		ЗначениеКлюча.Вставить("ДатаСобытия", Результат[0].ДатаСобытия);
		ЗначениеКлюча.Вставить("КБК"        , Результат[0].КБК);
		ЗначениеКлюча.Вставить("НомерДОПП"  , Результат[0].НомерДОПП);
		КлючЗаписи = РегистрыСведений["ДокументыОПредстоящейПоставке"].СоздатьКлючЗаписи(ЗначениеКлюча);
		РеквизитыДОПП.Вставить("КлючЗаписи", КлючЗаписи);
	КонецЕсли;
	
	Возврат РеквизитыДОПП;
	
КонецФункции

#КонецОбласти

#Область ДОПП

&НаСервере
Функция ПроверкиФорматаДОППВыполнены()
	
	ПроверкиВыполнены = Истина;
	
	// Проверка уникальности регистрационных номеров
	Если СокрЛП(Объект.РегистрационныйЗнак) = СокрЛП(Объект.РегистрационныйЗнакПрицепа)
	 Или СокрЛП(Объект.РегистрационныйЗнак) = СокрЛП(Объект.РегистрационныйЗнакПрицепаДополнительный) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Регистрационный номер не уникален.'"), ,
			"РегистрационныйЗнак",
			"Объект");
		ПроверкиВыполнены = Ложь;
	КонецЕсли;
	
	Если СокрЛП(Объект.РегистрационныйЗнакПрицепа) = СокрЛП(Объект.РегистрационныйЗнакПрицепаДополнительный)
	   И ЗначениеЗаполнено(Объект.РегистрационныйЗнакПрицепа) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Регистрационный номер прицепа не уникален.'"), ,
			"РегистрационныйЗнакПрицепа",
			"Объект");
		ПроверкиВыполнены = Ложь;
		
	КонецЕсли;
	
	Если КонецДня(Объект.ДатаВвоза) < Объект.Дата Тогда
	
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата ввоза не может быть ранее даты регистрации ДОПП.'"), ,
			"ДатаВвоза",
			"Объект");
		ПроверкиВыполнены = Ложь;
	
	КонецЕсли;
	
	Возврат ПроверкиВыполнены;

КонецФункции

&НаСервере
Процедура ЗарегистрироватьАктуализироватьДОПП()
	
	Если Не ПроверкиФорматаДОППВыполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтатусДОППТекст) Тогда
		// ДОПП был зарегистрирован в СПОТ, актуализация не выполняется.
		// При необходимости исправления ранее зарегистрированного ДОПП необходимо формировать корректировочный ДОПП.
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьТекстПроДОПП()
	
	Элементы.ДекорацияСсылкаНаДОПП.Видимость           = Ложь;
	Элементы.ГруппаРегистрационныеДанныеДОПП.Видимость = Ложь;
	Элементы.ДекорацияСкорректироватьДОПП.Видимость    = Ложь;
	
	ЭтоУТ = ПолучитьФункциональнуюОпцию("УправлениеТорговлей");
	
	Если ЗначениеЗаполнено(СсылкаНаДОПП)  Или ЭтоУТ Тогда
		
		Элементы.ДекорацияСсылкаНаДОПП.Видимость           = Истина  И Не ЭтоУТ;
		Элементы.ДекорацияСкорректироватьДОПП.Видимость    = Истина  И Не ЭтоУТ;
		Элементы.ГруппаРегистрационныеДанныеДОПП.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	ВидимостьКнопокВыгрузки = Ложь;
	
	
	Элементы.ПодменюПроверка.Видимость = ВидимостьКнопокВыгрузки;
	Элементы.ЗаписатьНаДиск.Видимость = ВидимостьКнопокВыгрузки;
	Элементы.ОтправитьВКонтролирующийОрган.Видимость = ВидимостьКнопокВыгрузки;
	Элементы.ПечатьДОПП.Видимость = ВидимостьКнопокВыгрузки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередИзменениемПризнакаДОППЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьОсобыйПризнакДОППВТаблице();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОсобыйПризнакДОППВТаблице()
	
	Для каждого СтрокаТаблицы Из Объект.Товары Цикл
		СтрокаТаблицы.ОсобыйПризнакДОПП = Объект.ОсобыйПризнакДОПП;
		АктуализироватьНалогиПоСтрокеТовары(СтрокаТаблицы);
	КонецЦикла;
	
	УправлениеФормой(ЭтотОбъект);
	ОбновитьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораСтавкиНДС()
	
	МассивСтавок = Новый Массив();
	СтавкаНДС10 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС10, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	Если ЗначениеЗаполнено(СтавкаНДС10) Тогда
		МассивСтавок.Добавить(СтавкаНДС10);
	КонецЕсли;
	
	ОсновнаяСтавкаНДС = УчетНДСУП.СтавкаНДСПоУмолчанию(Неопределено, Объект.Дата);
	МассивСтавок.Добавить(ОсновнаяСтавкаНДС);
	
	Элементы["ТоварыСтавкаНДС"].СписокВыбора.ЗагрузитьЗначения(МассивСтавок);
	
КонецПроцедуры

