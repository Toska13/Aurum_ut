&НаКлиенте
Процедура СостояниеДОПП(Элемент, НавигационнаяСсылка, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	СтандартнаяОбработка = Ложь;
	
	КлючиСтруктуры = "Организация, Проведен, НомерДОПП, СуммаДокумента";
	ПараметрыФормы = Новый Структура(КлючиСтруктуры);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.СуммаДокумента = Объект.СуммаОбеспечительногоПлатежа;
	РеквизитыДОПП = ПолучитьРеквизитыДОПП(ПараметрыФормы);
	
	Если РеквизитыДОПП.Проведен И РеквизитыДОПП.КоличествоЗаписей =1 Тогда
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Ключ"          ,   РеквизитыДОПП.КлючЗаписи);
		ПараметрыФормы.Вставить("СуммаДокумента",   РеквизитыДОПП.СуммаДокумента);
		ПараметрыФормы.Вставить("УрезанныйВариант", Истина);
		ОткрытьФорму("РегистрСведений.ДокументыОПредстоящейПоставке.ФормаЗаписи",
			ПараметрыФормы,
			ЭтотОбъект,,,,
			,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
	
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Организация",    РеквизитыДОПП.Организация);
		ПараметрыФормы.Вставить("СуммаДокумента", РеквизитыДОПП.СуммаДокумента);
		ПараметрыФормы.Вставить("НомерДОПП",      РеквизитыДОПП.НомерДОПП);
		СтруктураОтбора = Новый Структура();
		СтруктураОтбора.Вставить("НомерДОПП",   РеквизитыДОПП.НомерДОПП);
		СтруктураОтбора.Вставить("Организация", РеквизитыДОПП.Организация);
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		ПараметрыФормы.Вставить("НеВыводитьЗаголовок", Истина);
		
		ОткрытьФорму("РегистрСведений.ДокументыОПредстоящейПоставке.Форма.РабочееМесто",
					ПараметрыФормы,
					ЭтотОбъект,
					,
					,
					);
					
	КонецЕсли;
	
КонецПроцедуры

