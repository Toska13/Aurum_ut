#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизитыИЭлементы();
	// Программные реквизиты только через ЭтотОбъект, иначе локальная переменная.
	ЭтотОбъект.ЗаказКлиента = Параметры.ЗаказКлиента;
	ЗаполнитьФормуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимВалютПриИзменении(Элемент)

	ЗаполнитьФормуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВалютаИтоговПриИзменении(Элемент)

	ЗаполнитьФормуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоДокументов

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтрокиЗаказа

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказыНаСборку

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказыПоставщику

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыШтрихкодыУпаковок

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Пересчитать(Команда)

	ПересчитатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьРеквизитыИЭлементы()

	ЭлементыФормы = АУ_СозданиеЭлементовФормы;

	// Старый ДС «ДанныеОЗаказе» в Form.form — скрыть, UI строится программно.
	Если Элементы.Найти("ДанныеОЗаказе") <> Неопределено Тогда

		Элементы.ДанныеОЗаказе.Видимость = Ложь;

	КонецЕсли;

	// «ЗаказКлиента» уже объявлен в Form.form — не создавать повторно (ИзменитьРеквизиты → неуникальное имя).
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ВалютаИтогов", ЭлементыФормы.ОписаниеТипаСправочник("Валюты"));
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ДатаРасчета", ЭлементыФормы.ОписаниеТипаДатаВремя("ДатаВремя"));
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ИзКэша", ЭлементыФормы.ОписаниеТипаБулево());
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "РасхождениеРасчетовСКлиентами", ЭлементыФормы.ОписаниеТипаБулево());
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "РасхождениеРасчетовСПоставщиками", ЭлементыФормы.ОписаниеТипаБулево());
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ЕстьСироты", ЭлементыФормы.ОписаниеТипаБулево());

	МассивТипаДерева = Новый Массив;
	МассивТипаДерева.Добавить(Тип("ДеревоЗначений"));
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ДеревоДокументов", Новый ОписаниеТипов(МассивТипаДерева));
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "СтрокиЗаказа", ЭлементыФормы.ОписаниеТипаТаблицаЗначений());
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ЗаказыНаСборку", ЭлементыФормы.ОписаниеТипаТаблицаЗначений());
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ЗаказыПоставщику", ЭлементыФормы.ОписаниеТипаТаблицаЗначений());
	ЭлементыФормы.СоздатьРеквизит(ЭтотОбъект, "ШтрихкодыУпаковок", ЭлементыФормы.ОписаниеТипаТаблицаЗначений());

	КолонкиДерева = Новый Структура;
	КолонкиДерева.Вставить("Представление", ЭлементыФормы.ОписаниеТипаСтрока(200));
	КолонкиДерева.Вставить("Тип", ЭлементыФормы.ОписаниеТипаСтрока(100));
	КолонкиДерева.Вставить("Проведен", ЭлементыФормы.ОписаниеТипаБулево());
	КолонкиДерева.Вставить("Ссылка", Новый ОписаниеТипов(
		"ДокументСсылка.ЗаказКлиента, ДокументСсылка.ЗаказНаСборку, ДокументСсылка.ЗаказПоставщику,
		|ДокументСсылка.ПриобретениеТоваровУслуг, ДокументСсылка.ПриходныйОрдерНаТовары,
		|ДокументСсылка.СборкаТоваров, ДокументСсылка.РеализацияТоваровУслуг,
		|ДокументСсылка.РасходныйОрдерНаТовары, ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств,
		|ДокументСсылка.СписаниеБезналичныхДенежныхСредств, ДокументСсылка.РасходныйКассовыйОрдер,
		|ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств, ДокументСсылка.ПриходныйКассовыйОрдер,
		|СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	ЭлементыФормы.СоздатьРеквизитыТаблицы(ЭтотОбъект, "ДеревоДокументов", КолонкиДерева);

	ТипКоличество = ЭлементыФормы.ОписаниеТипаЧисло(15, 3);
	ТипСумма = ЭлементыФормы.ОписаниеТипаЧисло(15, 2);
	ТипНоменклатура = ЭлементыФормы.ОписаниеТипаСправочник("Номенклатура");
	ТипХарактеристика = ЭлементыФормы.ОписаниеТипаСправочник("ХарактеристикиНоменклатуры");
	ТипВалюта = ЭлементыФормы.ОписаниеТипаСправочник("Валюты");

	КолонкиСтрокЗаказа = Новый Структура;
	КолонкиСтрокЗаказа.Вставить("Номенклатура", ТипНоменклатура);
	КолонкиСтрокЗаказа.Вставить("Характеристика", ТипХарактеристика);
	КолонкиСтрокЗаказа.Вставить("Шифр", ЭлементыФормы.ОписаниеТипаСтрока(10));
	КолонкиСтрокЗаказа.Вставить("Заказано", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("ВСборке", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("ЗаказаноПоставщику", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("Приобретено", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("ПринятоОрдером", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("ОстатокНаСкладе", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("Реализовано", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("ОтгруженоОрдером", ТипКоличество);
	КолонкиСтрокЗаказа.Вставить("ОплаченоКлиентом", ТипСумма);
	КолонкиСтрокЗаказа.Вставить("Заявлено", ТипСумма);
	КолонкиСтрокЗаказа.Вставить("ОплаченоПоставщику", ТипСумма);
	КолонкиСтрокЗаказа.Вставить("Валюта", ТипВалюта);
	КолонкиСтрокЗаказа.Вставить("НетКурса", ЭлементыФормы.ОписаниеТипаБулево());
	ЭлементыФормы.СоздатьРеквизитыТаблицы(ЭтотОбъект, "СтрокиЗаказа", КолонкиСтрокЗаказа);

	КолонкиСборки = Новый Структура;
	КолонкиСборки.Вставить("ЗаказНаСборку", ЭлементыФормы.ОписаниеТипаДокумент("ЗаказНаСборку"));
	КолонкиСборки.Вставить("Номенклатура", ТипНоменклатура);
	КолонкиСборки.Вставить("Характеристика", ТипХарактеристика);
	КолонкиСборки.Вставить("Заказано", ТипКоличество);
	КолонкиСборки.Вставить("ЗаказаноПоставщику", ТипКоличество);
	КолонкиСборки.Вставить("Приобретено", ТипКоличество);
	КолонкиСборки.Вставить("ПринятоОрдером", ТипКоличество);
	КолонкиСборки.Вставить("Заявлено", ТипСумма);
	КолонкиСборки.Вставить("Оплачено", ТипСумма);
	КолонкиСборки.Вставить("Валюта", ТипВалюта);
	КолонкиСборки.Вставить("НетКурса", ЭлементыФормы.ОписаниеТипаБулево());
	ЭлементыФормы.СоздатьРеквизитыТаблицы(ЭтотОбъект, "ЗаказыНаСборку", КолонкиСборки);

	КолонкиЗП = Новый Структура;
	КолонкиЗП.Вставить("ЗаказПоставщику", ЭлементыФормы.ОписаниеТипаДокумент("ЗаказПоставщику"));
	КолонкиЗП.Вставить("Номенклатура", ТипНоменклатура);
	КолонкиЗП.Вставить("Характеристика", ТипХарактеристика);
	КолонкиЗП.Вставить("Заказано", ТипКоличество);
	КолонкиЗП.Вставить("Приобретено", ТипКоличество);
	КолонкиЗП.Вставить("ПринятоОрдером", ТипКоличество);
	КолонкиЗП.Вставить("Заявлено", ТипСумма);
	КолонкиЗП.Вставить("Оплачено", ТипСумма);
	КолонкиЗП.Вставить("Валюта", ТипВалюта);
	КолонкиЗП.Вставить("НетКурса", ЭлементыФормы.ОписаниеТипаБулево());
	ЭлементыФормы.СоздатьРеквизитыТаблицы(ЭтотОбъект, "ЗаказыПоставщику", КолонкиЗП);

	КолонкиШтрихкодов = Новый Структура;
	КолонкиШтрихкодов.Вставить("ШтрихкодУпаковки", ЭлементыФормы.ОписаниеТипаСправочник("ШтрихкодыУпаковокТоваров"));
	КолонкиШтрихкодов.Вставить("Принято", ЭлементыФормы.ОписаниеТипаЧисло(1, 0));
	КолонкиШтрихкодов.Вставить("Отгружено", ЭлементыФормы.ОписаниеТипаЧисло(1, 0));
	КолонкиШтрихкодов.Вставить("Остаток", ЭлементыФормы.ОписаниеТипаЧисло(1, 0));
	ЭлементыФормы.СоздатьРеквизитыТаблицы(ЭтотОбъект, "ШтрихкодыУпаковок", КолонкиШтрихкодов);

	ГруппаШапка = ЭлементыФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтотОбъект, "ГруппаШапка", Неопределено, 2, 1, 2);
	ЭлементыФормы.СоздатьПоле(ЭтотОбъект, "ПолеЗаказКлиента", ГруппаШапка, "Заказ клиента", 7, "ЗаказКлиента");
	ЭлементыФормы.СоздатьПоле(ЭтотОбъект, "ПолеДатаРасчета", ГруппаШапка, "Дата расчета", 7, "ДатаРасчета");
	ЭлементыФормы.СоздатьПолеФлажок(ЭтотОбъект, "ПолеИзКэша", ГруппаШапка, "Из кэша", 0, "ИзКэша");
	ЭлементыФормы.СоздатьПолеФлажок(
		ЭтотОбъект,
		"ПолеРасхождениеКлиенты",
		ГруппаШапка,
		"Расхождение с расчетами клиентов",
		0,
		"РасхождениеРасчетовСКлиентами");
	ЭлементыФормы.СоздатьПолеФлажок(
		ЭтотОбъект,
		"ПолеРасхождениеПоставщики",
		ГруппаШапка,
		"Расхождение с расчетами поставщиков",
		0,
		"РасхождениеРасчетовСПоставщиками");
	ЭлементыФормы.СоздатьПолеФлажок(
		ЭтотОбъект,
		"ПолеЕстьСироты",
		ГруппаШапка,
		"Есть сироты",
		0,
		"ЕстьСироты");

	ВариантыВалют = Новый Массив;
	ВариантыВалют.Добавить("Валюты документов");
	ВариантыВалют.Добавить("Валюта отчета");
	СобытияРежимаВалют = Новый Структура("ПриИзменении", "РежимВалютПриИзменении");
	ЭлементыФормы.СоздатьПереключатель(
		ЭтотОбъект,
		"РежимВалют",
		ГруппаШапка,
		"Суммы",
		ВариантыВалют,
		1,
		Неопределено,
		СобытияРежимаВалют);

	СобытияВалюты = Новый Структура("ПриИзменении", "ВалютаИтоговПриИзменении");
	ЭлементыФормы.СоздатьПоле(
		ЭтотОбъект,
		"ПолеВалютаИтогов",
		ГруппаШапка,
		"Валюта отчета",
		1,
		"ВалютаИтогов",
		Неопределено,
		СобытияВалюты);

	ЭлементыФормы.СоздатьКоманду(ЭтотОбъект, "Пересчитать", "Пересчитать", "Пересчитать");
	ЭлементыФормы.СоздатьКнопка(ЭтотОбъект, "КнопкаПересчитать", ГруппаШапка, "Пересчитать", "Пересчитать", 1);

	КолонкиДереваФормы = Новый Структура;
	КолонкиДереваФормы.Вставить("Представление", "Документ");
	КолонкиДереваФормы.Вставить("Тип", "Тип");
	КолонкиДереваФормы.Вставить("Проведен", "Проведен");
	ЭлементыФормы.СоздатьТаблицаФормы(ЭтотОбъект, "ДеревоДокументов", Неопределено, "ДеревоДокументов", КолонкиДереваФормы);

	ГруппаСтраниц = ЭлементыФормы.СоздатьГруппаСтраниц(ЭтотОбъект, "ГруппаСтраницФактов", Неопределено, 1, 1);
	СтраницаСтрок = ЭлементыФормы.СоздатьСтраница(ЭтотОбъект, "СтраницаСтрокиЗаказа", ГруппаСтраниц, "Строки заказа", 1, 1);
	СтраницаСборки = ЭлементыФормы.СоздатьСтраница(ЭтотОбъект, "СтраницаСборка", ГруппаСтраниц, "Сборка", 1, 1);
	СтраницаЗП = ЭлементыФормы.СоздатьСтраница(ЭтотОбъект, "СтраницаЗаказыПоставщику", ГруппаСтраниц, "Заказы поставщику", 1, 1);
	СтраницаКМ = ЭлементыФормы.СоздатьСтраница(ЭтотОбъект, "СтраницаШтрихкоды", ГруппаСтраниц, "Штрихкоды упаковок", 1, 1);

	КолонкиСтрокФормы = Новый Структура;
	КолонкиСтрокФормы.Вставить("Номенклатура", "Номенклатура");
	КолонкиСтрокФормы.Вставить("Характеристика", "Характеристика");
	КолонкиСтрокФормы.Вставить("Шифр", "Шифр");
	КолонкиСтрокФормы.Вставить("Заказано", "Заказано");
	КолонкиСтрокФормы.Вставить("ВСборке", "В сборке");
	КолонкиСтрокФормы.Вставить("ЗаказаноПоставщику", "Заказано поставщику");
	КолонкиСтрокФормы.Вставить("Приобретено", "Приобретено");
	КолонкиСтрокФормы.Вставить("ПринятоОрдером", "Принято приходным ордером");
	КолонкиСтрокФормы.Вставить("ОстатокНаСкладе", "Остаток на складе");
	КолонкиСтрокФормы.Вставить("Реализовано", "Реализовано");
	КолонкиСтрокФормы.Вставить("ОтгруженоОрдером", "Отгружено расходным ордером");
	КолонкиСтрокФормы.Вставить("ОплаченоКлиентом", "Оплачено клиентом");
	КолонкиСтрокФормы.Вставить("Заявлено", "Заявлено");
	КолонкиСтрокФормы.Вставить("ОплаченоПоставщику", "Оплачено поставщику");
	КолонкиСтрокФормы.Вставить("Валюта", "Валюта");
	КолонкиСтрокФормы.Вставить("НетКурса", "Нет курса");
	ЭлементыФормы.СоздатьТаблицаФормы(ЭтотОбъект, "СтрокиЗаказа", СтраницаСтрок, "СтрокиЗаказа", КолонкиСтрокФормы);

	КолонкиСборкиФормы = Новый Структура;
	КолонкиСборкиФормы.Вставить("ЗаказНаСборку", "Заказ на сборку");
	КолонкиСборкиФормы.Вставить("Номенклатура", "Номенклатура");
	КолонкиСборкиФормы.Вставить("Характеристика", "Характеристика");
	КолонкиСборкиФормы.Вставить("Заказано", "Заказано");
	КолонкиСборкиФормы.Вставить("ЗаказаноПоставщику", "Заказано поставщику");
	КолонкиСборкиФормы.Вставить("Приобретено", "Приобретено");
	КолонкиСборкиФормы.Вставить("ПринятоОрдером", "Принято ордером");
	КолонкиСборкиФормы.Вставить("Заявлено", "Заявлено");
	КолонкиСборкиФормы.Вставить("Оплачено", "Оплачено");
	КолонкиСборкиФормы.Вставить("Валюта", "Валюта");
	ЭлементыФормы.СоздатьТаблицаФормы(ЭтотОбъект, "ЗаказыНаСборку", СтраницаСборки, "ЗаказыНаСборку", КолонкиСборкиФормы);

	КолонкиЗПФормы = Новый Структура;
	КолонкиЗПФормы.Вставить("ЗаказПоставщику", "Заказ поставщику");
	КолонкиЗПФормы.Вставить("Номенклатура", "Номенклатура");
	КолонкиЗПФормы.Вставить("Характеристика", "Характеристика");
	КолонкиЗПФормы.Вставить("Заказано", "Заказано");
	КолонкиЗПФормы.Вставить("Приобретено", "Приобретено");
	КолонкиЗПФормы.Вставить("ПринятоОрдером", "Принято ордером");
	КолонкиЗПФормы.Вставить("Заявлено", "Заявлено");
	КолонкиЗПФормы.Вставить("Оплачено", "Оплачено");
	КолонкиЗПФормы.Вставить("Валюта", "Валюта");
	ЭлементыФормы.СоздатьТаблицаФормы(ЭтотОбъект, "ЗаказыПоставщику", СтраницаЗП, "ЗаказыПоставщику", КолонкиЗПФормы);

	КолонкиКМФормы = Новый Структура;
	КолонкиКМФормы.Вставить("ШтрихкодУпаковки", "Штрихкод упаковки");
	КолонкиКМФормы.Вставить("Принято", "Принято");
	КолонкиКМФормы.Вставить("Отгружено", "Отгружено");
	КолонкиКМФормы.Вставить("Остаток", "Остаток");
	ЭлементыФормы.СоздатьТаблицаФормы(ЭтотОбъект, "ШтрихкодыУпаковок", СтраницаКМ, "ШтрихкодыУпаковок", КолонкиКМФормы);

	ЭтотОбъект.РежимВалют = 0;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуНаСервере()

	ВалютаДляИтогов = Неопределено;

	Если ЭтотОбъект.РежимВалют = 1 Тогда

		ВалютаДляИтогов = ЭтотОбъект.ВалютаИтогов;

	КонецЕсли;

	Состояние = АУ_КонтрольЗаказаКлиентаСервер.СостояниеЦепочкиЗаказа(
		ЭтотОбъект.ЗаказКлиента,
		ВалютаДляИтогов);
	ЭтотОбъект.ДатаРасчета = Состояние.ДатаРасчета;
	ЭтотОбъект.ИзКэша = Состояние.ИзКэша;
	ЭтотОбъект.РасхождениеРасчетовСКлиентами = Состояние.РасхождениеРасчетовСКлиентами;
	ЭтотОбъект.РасхождениеРасчетовСПоставщиками = Состояние.РасхождениеРасчетовСПоставщиками;
	ЭтотОбъект.ЕстьСироты = Состояние.ЕстьСироты;

	ЗначениеВРеквизитФормы(Состояние.Дерево, "ДеревоДокументов");
	ЗначениеВРеквизитФормы(Состояние.СтрокиЗаказа, "СтрокиЗаказа");
	ЗначениеВРеквизитФормы(Состояние.ЗаказыНаСборку, "ЗаказыНаСборку");
	ЗначениеВРеквизитФормы(Состояние.ЗаказыПоставщику, "ЗаказыПоставщику");
	ЗначениеВРеквизитФормы(Состояние.ШтрихкодыУпаковок, "ШтрихкодыУпаковок");

	Элементы.ПолеВалютаИтогов.Видимость = (ЭтотОбъект.РежимВалют = 1);

КонецПроцедуры

&НаСервере
Процедура ПересчитатьНаСервере()

	АУ_КонтрольЗаказаКлиентаСервер.ПересчитатьЗаказ(ЭтотОбъект.ЗаказКлиента);
	ЗаполнитьФормуНаСервере();

КонецПроцедуры

#КонецОбласти
