
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		
		МассивДоступныхОбъектовМетаданных = АУ_КонструкторПечатныхФормСервер.ПолучитьМассивДоступныхДляРедактированияВидовМетаданныхДляПользователя(Пользователи.АвторизованныйПользователь());
		Если МассивДоступныхОбъектовМетаданных.Количество() = 0 Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		СписокОтбора = Новый СписокЗначений;
		СписокОтбора.ЗагрузитьЗначения(МассивДоступныхОбъектовМетаданных);
		
		НовыйОтбор = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОбъектМетаданных");
		НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйОтбор.ПравоеЗначение = СписокОтбора;
		НовыйОтбор.Использование = Истина;
		
	КонецЕсли;
	
КонецПроцедуры
