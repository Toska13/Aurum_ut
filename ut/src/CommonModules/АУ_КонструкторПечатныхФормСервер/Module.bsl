#Область Интерфейс

Функция ПолучитьМассивПечатныхФормДляОбъекта(Объект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АУ_ПечатныеФормы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АУ_ПечатныеФормы КАК АУ_ПечатныеФормы
	|ГДЕ
	|	АУ_ПечатныеФормы.ОбъектМетаданных = &ОбъектМетаданных";
	Запрос.УстановитьПараметр("ОбъектМетаданных", ПолучитьОбъектМетаданныхПодОбъекту(Объект));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ДобавитьКомандыПечатиДляОбъекта(Объект, КомандыПечати) Экспорт
	
	МассивПечатныхФорм = ПолучитьМассивПечатныхФормДляОбъекта(Объект);
	
	Для каждого стрПечатнаяФорма Из МассивПечатныхФорм Цикл
		
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Идентификатор = стрПечатнаяФорма.Идентификатор;
		КомандаПечати.Представление = стрПечатнаяФорма.НаименованиеКомандыПечати;
		КомандаПечати.Картинка = БиблиотекаКартинок.ФорматWord2007;
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		МассивПечатныхФорм = ПолучитьМассивПечатныхФормДляОбъекта(Ссылка);
		
		Для каждого стрПечатнаяФорма Из МассивПечатныхФорм Цикл
		
			ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, стрПечатнаяФорма.Идентификатор);
			Если ПечатнаяФорма <> Неопределено Тогда
				
				ОфисныеДокументы = Новый Соответствие;
				
				Шаблон = стрПечатнаяФорма.ШаблонНазванияДокумента;
				ЗначенияРеквизитовДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектов, стрПечатнаяФорма.РеквизитыДляНазванияДокумента);
				
				МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Ссылка.Метаданные().ПолноеИмя());
				ДанныеДляПечати = МенеджерОбъекта.АУ_ДанныеДляПечатиДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка));
				
				ЗначенияРеквизитовДокумента = ЗначенияРеквизитовДокументов[Ссылка];
				ИмяДокумента = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ЗначенияРеквизитовДокументов[Ссылка]);
				
				АдресХранилищаОфисныйДокумент = ПечатьМакета(Ссылка, ДанныеДляПечати[0], стрПечатнаяФорма);
				
				ОфисныеДокументы.Вставить(АдресХранилищаОфисныйДокумент, ИмяДокумента);
				
				ПечатнаяФорма.СинонимМакета    = стрПечатнаяФорма.НаименованиеКомандыПечати;
				ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивДоступныхДляРедактированияВидовМетаданныхДляПользователя(Пользователь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АУ_ДоступностьРедактированияМакетовПоОбъектамПользователи.Ссылка.ОбъектМетаданных КАК ОбъектМетаданных
	|ИЗ
	|	Справочник.АУ_ДоступностьРедактированияМакетовПоОбъектам.Пользователи КАК АУ_ДоступностьРедактированияМакетовПоОбъектамПользователи
	|ГДЕ
	|	АУ_ДоступностьРедактированияМакетовПоОбъектамПользователи.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОбъектМетаданных");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуурыИФункции

Функция ПолучитьОбъектМетаданныхПодОбъекту(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя";
	
	Запрос.УстановитьПараметр("ПолноеИмя", Объект.Метаданные().ПолноеИмя());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СформироватьОбластиМакета(ПечатнаяФорма)
	
	Области = Новый Структура;
	
	Для каждого стрСекция Из ПечатнаяФорма.Секции Цикл
		Области.Вставить(стрСекция.НазваниеСекции, Новый Структура("ИмяОбласти, ТипОбласти, НазваниеТабличнойЧасти", стрСекция.НазваниеСекции, стрСекция.ВидСекции, стрСекция.НазваниеТабличнойЧасти));
	КонецЦикла;
	
	Возврат Области;
	
КонецФункции

Функция ПечатьМакета(Ссылка, ДанныеДляПечати, ПечатнаяФорма)
	
	ДвоичныеДанныеМакетов	= ПечатнаяФорма.ШаблонПечатнойФормы.Получить();
	Области					= СформироватьОбластиМакета(ПечатнаяФорма);
	
	Макет = УправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(ДвоичныеДанныеМакетов, Неопределено, ПечатнаяФорма.Идентификатор);
	Если Макет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗакрытьОкноПечатнойФормы = Ложь;
	Попытка
		Документ = УправлениеПечатью.ИнициализироватьПечатнуюФорму(Неопределено, Макет.НастройкиСтраницыМакета, Макет);
		АдресХранилищаПечатнойФормы = "";
		Если Документ = Неопределено Тогда
			УправлениеПечатью.ОчиститьСсылки(Макет);
			Возврат "";
		КонецЕсли;
		
		Для каждого стрОбласть Из Области Цикл
			
			Если ЗначениеЗаполнено(стрОбласть.Значение.НазваниеТабличнойЧасти) Тогда
				
				Для каждого стр Из ДанныеДляПечати[стрОбласть.Значение.НазваниеТабличнойЧасти] Цикл
			
					Область = УправлениеПечатью.ОбластьМакета(Макет, стрОбласть.Значение);
					УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(Документ, Область, стр, Ложь);
					УправлениеПечатью.ЗаполнитьПараметры(Документ, ДанныеДляПечати);
					
				КонецЦикла;
				
			Иначе
				Область = УправлениеПечатью.ОбластьМакета(Макет, стрОбласть.Значение);
				УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(Документ, Область, ДанныеДляПечати, Ложь);
			КонецЕсли;
			
		КонецЦикла;
		
		АдресХранилищаПечатнойФормы = УправлениеПечатью.СформироватьДокумент(Документ);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗакрытьОкноПечатнойФормы = Истина;
		Возврат "";
	КонецПопытки;
	
	УправлениеПечатью.ОчиститьСсылки(Документ, ЗакрытьОкноПечатнойФормы);
	УправлениеПечатью.ОчиститьСсылки(Макет);
	
	Возврат АдресХранилищаПечатнойФормы;
	
КонецФункции

#КонецОбласти