Функция НайтиЧислаВСтроке(Строка) Экспорт

   МассивЧисел = Новый Массив;

   СтрокаЧисел = "";

   Для Индекс = 1 По СтрДлина(Строка) Цикл
   
      Символ = Сред(Строка, Индекс, 1);

      Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // Код нуля - 48, код 9-ки - 57
         СтрокаЧисел = СтрокаЧисел + Символ;
      ИначеЕсли СтрДлина(СтрокаЧисел) > 0 Тогда
         МассивЧисел.Добавить(СтрокаЧисел);
         СтрокаЧисел = "";
      КонецЕсли;
   
  КонецЦикла;
  
   Если СтрДлина(СтрокаЧисел)>0 Тогда
       МассивЧисел.Добавить(СтрокаЧисел);
   КонецЕсли;
   
   Возврат МассивЧисел;

КонецФункции

Функция СоздатьСтруктуруПоРегиструСведений(ИмяРегистраСведений) Экспорт
	
    // Получаем описание регистра сведений из метаданных
    РегистрСведений = Метаданные.РегистрыСведений[ИмяРегистраСведений];
    
    // Проверяем, существует ли указанный регистр сведений
    Если РегистрСведений = Неопределено Тогда
        ВызватьИсключение "Регистр сведений '" + ИмяРегистраСведений + "' не найден!";
    КонецЕсли;
    
    // Создаем новую структуру
    НоваяСтруктура = Новый Структура;
    
    // Добавляем измерения
    Для Каждого Измерение Из РегистрСведений.Измерения Цикл
        НоваяСтруктура.Вставить(Измерение.Имя, Неопределено);
    КонецЦикла;
    
    // Добавляем ресурсы
    Для Каждого Ресурс Из РегистрСведений.Ресурсы Цикл
        НоваяСтруктура.Вставить(Ресурс.Имя, Неопределено);
    КонецЦикла;
    
    // Возвращаем созданную структуру
    Возврат НоваяСтруктура;
	
КонецФункции

