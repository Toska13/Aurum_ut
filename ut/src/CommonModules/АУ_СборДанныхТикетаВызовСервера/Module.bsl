#Область ПрограммныйИнтерфейс

// Возвращает описание реквизитов и табличных частей объекта по ссылке.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка на объект формы.
//
// Возвращаемое значение:
//  Структура:
//    * ПолноеИмя - Строка
//    * Синоним - Строка
//    * РеквизитыШапки - Массив из Строка
//    * ТабличныеЧасти - Массив из Структура:
//        ** Имя - Строка
//        ** Колонки - Массив из Строка
//
Функция ОписаниеМетаданныхПоСсылке(Знач Ссылка) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПолноеИмя", "");
	Результат.Вставить("Синоним", "");
	Результат.Вставить("РеквизитыШапки", Новый Массив);
	Результат.Вставить("ТабличныеЧасти", Новый Массив);
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = Ссылка.Метаданные();
	Результат.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Результат.Синоним = Строка(ОбъектМетаданных);
	
	Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Результат.РеквизитыШапки.Добавить(СтандартныйРеквизит.Имя);
	КонецЦикла;
	
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Результат.РеквизитыШапки.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		
		ОписаниеТЧ = Новый Структура;
		ОписаниеТЧ.Вставить("Имя", ТабличнаяЧасть.Имя);
		ОписаниеТЧ.Вставить("Колонки", Новый Массив);
		
		Для Каждого СтандартныйРеквизит Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
			ОписаниеТЧ.Колонки.Добавить(СтандартныйРеквизит.Имя);
		КонецЦикла;
		
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ОписаниеТЧ.Колонки.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Результат.ТабличныеЧасти.Добавить(ОписаниеТЧ);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает представления значений для текстового дампа.
//
// Параметры:
//  Значения - Массив из Произвольный - значения для представления.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПредставленияЗначений(Знач Значения) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого Значение Из Значения Цикл
		Результат.Добавить(ПредставлениеЗначения(Значение));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "<Неопределено>";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	
	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат СтрШаблон(НСтр("ru = '<тип %1>'"), ТипЗначения);
	КонецПопытки;
	
КонецФункции

#КонецОбласти
