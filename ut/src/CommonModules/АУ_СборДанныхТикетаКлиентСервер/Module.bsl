#Область ПрограммныйИнтерфейс

// Формирует человекочитаемый текстовый дамп содержимого управляемой формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, с которой собирается контекст.
//
// Возвращаемое значение:
//  Строка - многострочный текст дампа.
//
Функция СобратьТекстКонтекстаФормы(Форма) Экспорт
	
	Строки = Новый Массив;
	Ошибки = Новый Массив;
	
	ДобавитьШапкуФормы(Строки, Форма);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект") Тогда
		ДобавитьДанныеОбъектаФормы(Строки, Форма, Ошибки);
	КонецЕсли;
	
	ДобавитьВидимыеЭлементыФормы(Строки, Форма, Ошибки);
	
	Если Ошибки.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(НСтр("ru = '=== Предупреждения при сборе ==='"));
		Для Каждого ТекстОшибки Из Ошибки Цикл
			Строки.Добавить("- " + ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Конструктор результата сбора данных обращения.
//
// Возвращаемое значение:
//  Структура:
//    * ИмяФормы - Строка
//    * ЗаголовокФормы - Строка
//    * ТекстКонтекста - Строка
//    * СнимокЭкрана - Неопределено, Структура - см. ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ДанныеДополнительногоФайла:
//    * СнимокДоступен - Булево
//    * Ошибки - Массив из Строка
//
Функция НовыйРезультатСбораДанных() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("ЗаголовокФормы", "");
	Результат.Вставить("ТекстКонтекста", "");
	Результат.Вставить("СнимокЭкрана", Неопределено);
	Результат.Вставить("СнимокДоступен", Ложь);
	Результат.Вставить("Ошибки", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьШапкуФормы(Строки, Форма)
	
	Строки.Добавить(НСтр("ru = '=== Контекст формы ==='"));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Имя формы: %1'"), Форма.ИмяФормы));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Заголовок: %1'"), Форма.Заголовок));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Уникальный идентификатор: %1'"), Форма.УникальныйИдентификатор));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Клиент: %1'"), ОписаниеКлиента()));
	Строки.Добавить("");
	
КонецПроцедуры

Функция ОписаниеКлиента()
	
	#Если ВебКлиент Тогда
		Возврат НСтр("ru = 'Веб-клиент'");
	#ИначеЕсли ТонкийКлиент Тогда
		Возврат НСтр("ru = 'Тонкий клиент'");
	#ИначеЕсли ТолстыйКлиентУправляемоеПриложение Тогда
		Возврат НСтр("ru = 'Толстый клиент (управляемое приложение)'");
	#ИначеЕсли ТолстыйКлиентОбычноеПриложение Тогда
		Возврат НСтр("ru = 'Толстый клиент (обычное приложение)'");
	#Иначе
		Возврат НСтр("ru = 'Сервер / иное'");
	#КонецЕсли
	
КонецФункции

Процедура ДобавитьДанныеОбъектаФормы(Строки, Форма, Ошибки)
	
	Строки.Добавить(НСтр("ru = '=== Объект формы ==='"));
	
	ДанныеОбъекта = Форма.Объект;
	СсылкаОбъекта = Неопределено;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеОбъекта, "Ссылка") Тогда
		СсылкаОбъекта = ДанныеОбъекта.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаОбъекта) Тогда
		
		#Если Клиент Тогда
			ОписаниеМетаданных = АУ_СборДанныхТикетаВызовСервера.ОписаниеМетаданныхПоСсылке(СсылкаОбъекта);
		#Иначе
			ОписаниеМетаданных = АУ_СборДанныхТикетаВызовСервера.ОписаниеМетаданныхПоСсылке(СсылкаОбъекта);
		#КонецЕсли
		
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Метаданные: %1 (%2)'"),
			ОписаниеМетаданных.ПолноеИмя, ОписаниеМетаданных.Синоним));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Ссылка: %1'"), ПредставлениеЗначенияЛокально(СсылкаОбъекта)));
		Строки.Добавить("");
		Строки.Добавить(НСтр("ru = '-- Реквизиты шапки --'"));
		
		Для Каждого ИмяРеквизита Из ОписаниеМетаданных.РеквизитыШапки Цикл
			
			Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеОбъекта, ИмяРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеРеквизита = ДанныеОбъекта[ИмяРеквизита];
			Если ЭтоСлужебноеИлиНепечатаемоеЗначение(ЗначениеРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			
			Строки.Добавить(СтрШаблон("%1 = %2",
				ИмяРеквизита, ПредставлениеЗначенияЛокально(ЗначениеРеквизита)));
			
		КонецЦикла;
		
		Для Каждого ОписаниеТЧ Из ОписаниеМетаданных.ТабличныеЧасти Цикл
			ДобавитьТабличнуюЧастьОбъекта(Строки, ДанныеОбъекта, ОписаниеТЧ, Ошибки);
		КонецЦикла;
		
	Иначе
		
		Строки.Добавить(НСтр("ru = 'Ссылка объекта не заполнена — полный дамп по метаданным недоступен.'"));
		Строки.Добавить(НСтр("ru = 'Будут выведены видимые поля с путём данных Объект.*'"));
		
	КонецЕсли;
	
	Строки.Добавить("");
	
КонецПроцедуры

Процедура ДобавитьТабличнуюЧастьОбъекта(Строки, ДанныеОбъекта, ОписаниеТЧ, Ошибки)
	
	ИмяТЧ = ОписаниеТЧ.Имя;
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеОбъекта, ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	Коллекция = ДанныеОбъекта[ИмяТЧ];
	КоличествоСтрок = Коллекция.Количество();
	ЛимитСтрок = ЛимитСтрокТабличнойЧасти();
	
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон(НСтр("ru = '-- Табличная часть %1 (строк: %2) --'"),
		ИмяТЧ, КоличествоСтрок));
	
	Если КоличествоСтрок = 0 Тогда
		Строки.Добавить(НСтр("ru = '(пусто)'"));
		Возврат;
	КонецЕсли;
	
	ВывестиСтрок = Мин(КоличествоСтрок, ЛимитСтрок);
	
	Для Индекс = 0 По ВывестиСтрок - 1 Цикл
		
		СтрокаТЧ = Коллекция[Индекс];
		ЧастиСтроки = Новый Массив;
		ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = '[%1]'"), Индекс + 1));
		
		Для Каждого ИмяКолонки Из ОписаниеТЧ.Колонки Цикл
			
			Если ИмяКолонки = "НомерСтроки" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, ИмяКолонки) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеКолонки = СтрокаТЧ[ИмяКолонки];
			Если ЭтоСлужебноеИлиНепечатаемоеЗначение(ЗначениеКолонки) Тогда
				Продолжить;
			КонецЕсли;
			
			ЧастиСтроки.Добавить(СтрШаблон("%1=%2",
				ИмяКолонки, ПредставлениеЗначенияЛокально(ЗначениеКолонки)));
			
		КонецЦикла;
		
		Строки.Добавить(СтрСоединить(ЧастиСтроки, "; "));
		
	КонецЦикла;
	
	Если КоличествоСтрок > ЛимитСтрок Тогда
		Строки.Добавить(СтрШаблон(
			НСтр("ru = '... обрезано: показано %1 из %2 строк'"),
			ЛимитСтрок, КоличествоСтрок));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьВидимыеЭлементыФормы(Строки, Форма, Ошибки)
	
	Строки.Добавить(НСтр("ru = '=== Видимые элементы формы ==='"));
	
	Для Каждого Элемент Из Форма.Элементы Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		
		Если ТипЭлемента = Тип("ПолеФормы") Тогда
			ДобавитьПолеФормыВДамп(Строки, Элемент);
		ИначеЕсли ТипЭлемента = Тип("ТаблицаФормы") Тогда
			ДобавитьТаблицуФормыВДамп(Строки, Форма, Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Строки.Добавить("");
	
КонецПроцедуры

Процедура ДобавитьПолеФормыВДамп(Строки, Элемент)
	
	Если Не Элемент.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКДанным = Элемент.ПутьКДанным;
	ТекстРедактирования = "";
	
	Попытка
		ТекстРедактирования = Элемент.ТекстРедактирования;
	Исключение
		// У части полей ТекстРедактирования недоступен — пропускаем значение.
		ТекстРедактирования = "";
	КонецПопытки;
	
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Поле %1 | путь=%2 | значение=%3'"),
		Элемент.Имя, ПутьКДанным, ТекстРедактирования));
	
КонецПроцедуры

Процедура ДобавитьТаблицуФормыВДамп(Строки, Форма, Элемент)
	
	Если Не Элемент.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКДанным = Элемент.ПутьКДанным;
	ОписаниеТекущейСтроки = "";
	
	#Если Клиент Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ОписаниеТекущейСтроки = ПредставлениеТекущейСтрокиТаблицы(ТекущиеДанные);
		КонецЕсли;
	#КонецЕсли
	
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Таблица %1 | путь=%2 | текущаяСтрока=%3'"),
		Элемент.Имя, ПутьКДанным, ОписаниеТекущейСтроки));
	
КонецПроцедуры

Функция ПредставлениеТекущейСтрокиТаблицы(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	// Детальный разбор колонок текущей строки без ПолучитьРеквизиты недоступен.
	Возврат НСтр("ru = '<есть>'");
	
КонецФункции

Функция ПредставлениеЗначенияЛокально(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "<Неопределено>";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	
	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат СтрШаблон(НСтр("ru = '<тип %1>'"), ТипЗначения);
	КонецПопытки;
	
КонецФункции

Функция ЭтоСлужебноеИлиНепечатаемоеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("ДвоичныеДанные")
		Или ТипЗначения = Тип("Картинка")
		Или ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") И СтрДлина(Значение) > 4000 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЛимитСтрокТабличнойЧасти()
	Возврат 100;
КонецФункции

#КонецОбласти
