#Область ПрограммныйИнтерфейс

// Собирает текст контекста формы и запрашивает снимок экрана (БСП), затем возвращает единый результат.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма-источник контекста.
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - обработчик с результатом
//   см. АУ_СборДанныхТикетаКлиентСервер.НовыйРезультатСбораДанных.
//
Процедура СобратьДанныеОбращения(Форма, ОписаниеОповещенияОЗавершении) Экспорт
	
	Результат = АУ_СборДанныхТикетаКлиентСервер.НовыйРезультатСбораДанных();
	Результат.ИмяФормы = Форма.ИмяФормы;
	Результат.ЗаголовокФормы = Форма.Заголовок;
	Результат.СнимокДоступен = СнимокЭкранаДоступен();
	
	Попытка
		Результат.ТекстКонтекста = АУ_СборДанныхТикетаКлиентСервер.СобратьТекстКонтекстаФормы(Форма);
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
		Результат.ТекстКонтекста = "";
	КонецПопытки;
	
	Если Не Результат.СнимокДоступен Тогда
		Результат.Ошибки.Добавить(НСтр("ru = 'Снимок экрана недоступен на этом клиенте (нужны Windows и буфер обмена).'"));
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗавершении, Результат);
		Возврат;
	КонецЕсли;
	
	ПараметрыПродолжения = Новый Структура;
	ПараметрыПродолжения.Вставить("Результат", Результат);
	ПараметрыПродолжения.Вставить("ОписаниеОповещенияОЗавершении", ОписаниеОповещенияОЗавершении);
	
	ОповещениеПослеСнимка = Новый ОписаниеОповещения(
		"СобратьДанныеОбращенияПослеСнимка",
		ЭтотОбъект,
		ПараметрыПродолжения);
	
	ЗапроситьСнимокЭкрана(ОповещениеПослеСнимка);
	
КонецПроцедуры

// Синхронно собирает текстовый контекст формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
// Возвращаемое значение:
//  Строка
//
Функция СобратьТекстКонтекстаФормы(Форма) Экспорт
	
	Возврат АУ_СборДанныхТикетаКлиентСервер.СобратьТекстКонтекстаФормы(Форма);
	
КонецФункции

// Запрашивает снимок экрана через БСП (ms-screenclip + буфер обмена).
//
// Параметры:
//  ОписаниеОповещения - ОписаниеОповещения - получает Неопределено или
//   структуру см. ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ДанныеДополнительногоФайла.
//
Процедура ЗапроситьСнимокЭкрана(ОписаниеОповещения) Экспорт
	
	Если Не СнимокЭкранаДоступен() Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Неопределено);
		Возврат;
	КонецЕсли;
	
	ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ЗапроситьСозданиеСнимкаЭкрана(ОписаниеОповещения);
	
КонецПроцедуры

// Признак доступности средства снимка экрана БСП.
//
// Возвращаемое значение:
//  Булево
//
Функция СнимокЭкранаДоступен() Экспорт
	
	Возврат ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ПриложениеДляСнимкаЭкранаДоступно();
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик завершения запроса снимка в сценарии СобратьДанныеОбращения.
//
// Параметры:
//  ДанныеСнимка - Неопределено, Структура - см. ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ДанныеДополнительногоФайла:
//    * АдресФайла - Строка
//    * ПолноеИмяФайла - Строка
//  ДополнительныеПараметры - Структура:
//    * Результат - Структура
//    * ОписаниеОповещенияОЗавершении - ОписаниеОповещения
//
Процедура СобратьДанныеОбращенияПослеСнимка(ДанныеСнимка, ДополнительныеПараметры) Экспорт
	
	Результат = ДополнительныеПараметры.Результат;
	Результат.СнимокЭкрана = ДанныеСнимка;
	
	Если ДанныеСнимка = Неопределено Тогда
		Результат.Ошибки.Добавить(НСтр("ru = 'Снимок экрана не получен (пропущен или не удалось сохранить).'"));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещенияОЗавершении, Результат);
	
КонецПроцедуры

#КонецОбласти
