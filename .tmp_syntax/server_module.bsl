КонецФункции

Процедура ДополнитьВложенныеШтрихкоды(ДокументыЦепочки)

	Родители = Новый Массив;

	Для Каждого СтрокаШтрихкода Из ДокументыЦепочки.ШтрихкодыПриемки Цикл

		Если Родители.Найти(СтрокаШтрихкода.ШтрихкодУпаковки) = Неопределено Тогда

			Родители.Добавить(СтрокаШтрихкода.ШтрихкодУпаковки);

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаШтрихкода Из ДокументыЦепочки.ШтрихкодыОтгрузки Цикл

		Если Родители.Найти(СтрокаШтрихкода.ШтрихкодУпаковки) = Неопределено Тогда

			Родители.Добавить(СтрокаШтрихкода.ШтрихкодУпаковки);

		КонецЕсли;

	КонецЦикла;

	Вложенные = Новый ТаблицаЗначений;
	Вложенные.Колонки.Добавить("Родитель");
	Вложенные.Колонки.Добавить("Вложенный");

	МаксимумУровней = 10;
	ТекущиеРодители = Родители;

	Для НомерУровня = 1 По МаксимумУровней Цикл

		Если ТекущиеРодители.Количество() = 0 Тогда

			Прервать;

		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныеШтрихкоды.Ссылка КАК Родитель,
		|	ВложенныеШтрихкоды.Штрихкод КАК Вложенный
		|ИЗ
		|	Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ВложенныеШтрихкоды
		|ГДЕ
		|	ВложенныеШтрихкоды.Ссылка В (&Родители)";
		Запрос.УстановитьПараметр("Родители", ТекущиеРодители);

		Выборка = Запрос.Выполнить().Выбрать();
		СледующиеРодители = Новый Массив;

		Пока Выборка.Следующий() Цикл

			СтрокаВложенных = Вложенные.Добавить();
			СтрокаВложенных.Родитель = Выборка.Родитель;
 mar			СтрокаВложенных.Вложенный = Выборка.Вложенный;

			Если СледующиеРодители.Найти(Выборка.Вложенный) = Неопределено Тогда

				СледующиеРодители.Добавить(Выборка.Вложенный);

			КонецЕсли;

		КонецЦикла;

		ТекущиеРодители = СледующиеРодители;

	КонецЦикла;

	ДокументыЦепочки.Вставить("ВложенныеШтрихкоды", Вложенные);

КонецПроцедуры

