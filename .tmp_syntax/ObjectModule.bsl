#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);

	ВнешниеНаборы = Новый Структура("Объект", ФактыЗаказов(НастройкиКомпоновки));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФактыЗаказов(НастройкиКомпоновки)

	Факты = НовыйТаблицаФактов();
	Период = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Период");
	НачалоПериода = Дата(1, 1, 1);
	КонецПериода = Дата(3999, 12, 31);

	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда

		НачалоПериода = Период.ДатаНачала;
		КонецПериода = Период.ДатаОкончания;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда

		НачалоПериода = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "НачалоПериода", Дата(1, 1, 1));

	КонецЕсли;

	Если Не ЗначениеЗаполнено(КонецПериода) Тогда

		КонецПериода = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "КонецПериода", Дата(3999, 12, 31));

	КонецЕсли;

	Организация = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Организация");
	Контрагент = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Контрагент");
	Программа = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Программа");
	ХарактеристикаОтбора = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "Характеристика");
	ТолькоРасхождения = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "ТолькоРасхождения", Ложь);
	ВалютаИтогов = ЗначениеПараметраКомпоновки(НастройкиКомпоновки, "ВалютаИтогов");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиента.Ссылка КАК ЗаказКлиента,
	|	ЗаказКлиента.Дата КАК Дата,
	|	ЗаказКлиента.Организация КАК Организация,
	|	ЗаказКлиента.Контрагент КАК Контрагент,
	|	ЗаказКлиента.АУ_Программа КАК Программа
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	НЕ ЗаказКлиента.ПометкаУдаления
	|	И ЗаказКлиента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&ОрганизацияНеИспользуется
	|			ИЛИ ЗаказКлиента.Организация = &Организация)
	|	И (&КонтрагентНеИспользуется
	|			ИЛИ ЗаказКлиента.Контрагент = &Контрагент)
	|	И (&ПрограммаНеИспользуется
	|			ИЛИ ЗаказКлиента.АУ_Программа = &Программа)";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Программа", Программа);
	Запрос.УстановитьПараметр("ОрганизацияНеИспользуется", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("КонтрагентНеИспользуется", Не ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("ПрограммаНеИспользуется", Не ЗначениеЗаполнено(Программа));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Состояние = АУ_КонтрольЗаказаКлиентаСервер.СостояниеЦепочкиЗаказа(Выборка.ЗаказКлиента, ВалютаИтогов);

		Если ТолькоРасхождения
			И Не Состояние.РасхождениеРасчетовСКлиентами
			И Не Состояние.РасхождениеРасчетовСПоставщиками Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьСтрокиЗаказаВИерархию(Факты, Выборка, Состояние, ХарактеристикаОтбора);

	КонецЦикла;

	Возврат Факты;

КонецФункции

Процедура ДобавитьСтрокиЗаказаВИерархию(Факты, ШапкаЗаказа, Состояние, ХарактеристикаОтбора)

	ИдентификаторЗаказа = "ZK|" + Строка(ШапкаЗаказа.ЗаказКлиента.УникальныйИдентификатор());
	СтрокаЗаказа = Факты.Добавить();
	СтрокаЗаказа.Идентификатор = ИдентификаторЗаказа;
	СтрокаЗаказа.Родитель = "";
	СтрокаЗаказа.Уровень = 0;
	СтрокаЗаказа.Представление = Строка(ШапкаЗаказа.ЗаказКлиента);
	СтрокаЗаказа.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
	СтрокаЗаказа.Дата = ШапкаЗаказа.Дата;
	СтрокаЗаказа.Организация = ШапкаЗаказа.Организация;
	СтрокаЗаказа.Контрагент = ШапкаЗаказа.Контрагент;
	СтрокаЗаказа.Программа = ШапкаЗаказа.Программа;
	СтрокаЗаказа.РасхождениеРасчетовСКлиентами = Состояние.РасхождениеРасчетовСКлиентами;
	СтрокаЗаказа.РасхождениеРасчетовСПоставщиками = Состояние.РасхождениеРасчетовСПоставщиками;
	СтрокаЗаказа.ЕстьСироты = Состояние.ЕстьСироты;

	УжеДобавленныеДокументы = Новый Соответствие;

	Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

		Если ЗначениеЗаполнено(ХарактеристикаОтбора)
			И СтрокаФактов.Характеристика <> ХарактеристикаОтбора Тогда

			Продолжить;

		КонецЕсли;

		ИдентификаторПозиции = ИдентификаторЗаказа + "|POS|"
			+ Строка(СтрокаФактов.Номенклатура.УникальныйИдентификатор()) + "|"
			+ Строка(СтрокаФактов.Характеристика.УникальныйИдентификатор());
		СтрокаПозиции = Факты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПозиции, СтрокаФактов);
		СтрокаПозиции.Идентификатор = ИдентификаторПозиции;
		СтрокаПозиции.Родитель = ИдентификаторЗаказа;
		СтрокаПозиции.Уровень = 1;
		СтрокаПозиции.Представление = Строка(СтрокаФактов.Номенклатура) + " / " + Строка(СтрокаФактов.Характеристика);
		СтрокаПозиции.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
		СтрокаПозиции.Дата = ШапкаЗаказа.Дата;
		СтрокаПозиции.Организация = ШапкаЗаказа.Организация;
		СтрокаПозиции.Контрагент = ШапкаЗаказа.Контрагент;
		СтрокаПозиции.Программа = ШапкаЗаказа.Программа;
		СтрокаПозиции.РасхождениеРасчетовСКлиентами = Состояние.РасхождениеРасчетовСКлиентами;
		СтрокаПозиции.РасхождениеРасчетовСПоставщиками = Состояние.РасхождениеРасчетовСПоставщиками;
		СтрокаПозиции.ЕстьСироты = Состояние.ЕстьСироты;

		ДобавитьСвязанныеДокументыПозиции(
			Факты,
			Состояние,
			СтрокаФактов,
			ИдентификаторПозиции,
			ШапкаЗаказа,
			УжеДобавленныеДокументы);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСвязанныеДокументыПозиции(
	Факты,
	Состояние,
	СтрокаФактов,
	ИдентификаторПозиции,
	ШапкаЗаказа,
	УжеДобавленныеДокументы)

	Для Каждого СтрокаСборки Из Состояние.ЗаказыНаСборку Цикл

		Если СтрокаСборки.Номенклатура <> СтрокаФактов.Номенклатура
			Или СтрокаСборки.Характеристика <> СтрокаФактов.Характеристика Тогда

			Продолжить;

		КонецЕсли;

		КлючДокумента = "ZS|" + Строка(СтрокаСборки.ЗаказНаСборку.УникальныйИдентификатор());

		Если УжеДобавленныеДокументы.Получить(КлючДокумента) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		УжеДобавленныеДокументы.Вставить(КлючДокумента, Истина);
		СтрокаДокумента = Факты.Добавить();
		СтрокаДокумента.Идентификатор = КлючДокумента;
		СтрокаДокумента.Родитель = ИдентификаторПозиции;
		СтрокаДокумента.Уровень = 2;
		СтрокаДокумента.Представление = Строка(СтрокаСборки.ЗаказНаСборку);
		СтрокаДокумента.СвязанныйДокумент = СтрокаСборки.ЗаказНаСборку;
		СтрокаДокумента.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
		СтрокаДокумента.Дата = ШапкаЗаказа.Дата;
		СтрокаДокумента.Организация = ШапкаЗаказа.Организация;
		СтрокаДокумента.Контрагент = ШапкаЗаказа.Контрагент;
		СтрокаДокумента.Программа = ШапкаЗаказа.Программа;
		СтрокаДокумента.Номенклатура = СтрокаСборки.Номенклатура;
		СтрокаДокумента.Характеристика = СтрокаСборки.Характеристика;
		СтрокаДокумента.Заказано = СтрокаСборки.Заказано;
		СтрокаДокумента.ЗаказаноПоставщику = СтрокаСборки.ЗаказаноПоставщику;
		СтрокаДокумента.Приобретено = СтрокаСборки.Приобретено;
		СтрокаДокумента.ПринятоОрдером = СтрокаСборки.ПринятоОрдером;
		СтрокаДокумента.Заявлено = СтрокаСборки.Заявлено;
		СтрокаДокумента.ОплаченоПоставщику = СтрокаСборки.Оплачено;
		СтрокаДокумента.Валюта = СтрокаСборки.Валюта;
		СтрокаДокумента.НетКурса = СтрокаСборки.НетКурса;

	КонецЦикла;

	Для Каждого СтрокаЗП Из Состояние.ЗаказыПоставщику Цикл

		Если СтрокаЗП.Номенклатура <> СтрокаФактов.Номенклатура
			Или СтрокаЗП.Характеристика <> СтрокаФактов.Характеристика Тогда

			Продолжить;

		КонецЕсли;

		КлючДокумента = "ZP|" + Строка(СтрокаЗП.ЗаказПоставщику.УникальныйИдентификатор());

		Если УжеДобавленныеДокументы.Получить(КлючДокумента) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		УжеДобавленныеДокументы.Вставить(КлючДокумента, Истина);
		СтрокаДокумента = Факты.Добавить();
		СтрокаДокумента.Идентификатор = КлючДокумента;
		СтрокаДокумента.Родитель = ИдентификаторПозиции;
		СтрокаДокумента.Уровень = 2;
		СтрокаДокумента.Представление = Строка(СтрокаЗП.ЗаказПоставщику);
		СтрокаДокумента.СвязанныйДокумент = СтрокаЗП.ЗаказПоставщику;
		СтрокаДокумента.ЗаказКлиента = ШапкаЗаказа.ЗаказКлиента;
		СтрокаДокумента.Дата = ШапкаЗаказа.Дата;
		СтрокаДокумента.Организация = ШапкаЗаказа.Организация;
		СтрокаДокумента.Контрагент = ШапкаЗаказа.Контрагент;
		СтрокаДокумента.Программа = ШапкаЗаказа.Программа;
		СтрокаДокумента.Номенклатура = СтрокаЗП.Номенклатура;
		СтрокаДокумента.Характеристика = СтрокаЗП.Характеристика;
		СтрокаДокумента.Заказано = СтрокаЗП.Заказано;
		СтрокаДокумента.Приобретено = СтрокаЗП.Приобретено;
		СтрокаДокумента.ПринятоОрдером = СтрокаЗП.ПринятоОрдером;
		СтрокаДокумента.Заявлено = СтрокаЗП.Заявлено;
		СтрокаДокумента.ОплаченоПоставщику = СтрокаЗП.Оплачено;
		СтрокаДокумента.Валюта = СтрокаЗП.Валюта;
		СтрокаДокумента.НетКурса = СтрокаЗП.НетКурса;

	КонецЦикла;

КонецПроцедуры

Функция НовыйТаблицаФактов()

	Факты = Новый ТаблицаЗначений;
	Факты.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(120)));
	Факты.Колонки.Добавить("Родитель", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(120)));
