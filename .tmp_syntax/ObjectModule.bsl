	Факты.Колонки.Добавить("ЗаказаноПоставщику", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("Приобретено", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ПринятоОрдером", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ОстатокНаСкладе", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("Реализовано", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Факты.Колонки.Добавить("ОтгруженоОрдером", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
