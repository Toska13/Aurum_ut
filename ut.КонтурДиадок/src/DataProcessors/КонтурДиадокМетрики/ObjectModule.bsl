Функция СравнитьВерсииЛок(Знач СтрокаВерсия1, Знач СтрокаВерсия2)
	
	Результат = 0;
	Если СокрЛП(СтрокаВерсия1) = СокрЛП(СтрокаВерсия2) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Версия1 = СтрРазделитьЛок(СтрокаВерсия1, ".");
	Версия2 = СтрРазделитьЛок(СтрокаВерсия2, ".");
	
	КоличествоИтераций = Мин(Версия1.Количество(), Версия2.Количество()) - 1;
	Для Разряд = 0 По КоличествоИтераций Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат (Результат > 0) - (Результат < 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтрРазделитьЛок(Знач Строка, Знач Разделитель = ",", ВключатьПустые = Истина)
	
	ПропускатьПустыеСтроки = НЕ ВключатьПустые;
	Результат = Новый Массив;
	
	НачалоСтроки = 1;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если СтрНайтиЛок(Разделитель, Символ) > 0 Тогда
			Результат.Добавить(Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки));
			НачалоСтроки = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Значение = Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки);
	Если НЕ ПропускатьПустыеСтроки ИЛИ НЕ ПустаяСтрока(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрНайтиЛок(Знач Строка,
	Знач Подстрока,
	Направление = "СНачала",
	НачальнаяПозиция = Неопределено,
	НомерВхождения = 1)
	
	Если НачальнаяПозиция = Неопределено Тогда
		Если Направление = "СНачала" ИЛИ Строка(Направление) = "С начала" Тогда
			НачальнаяПозиция = 1;
		Иначе
			НачальнаяПозиция = СтрДлина(Строка);
		КонецЕсли;
	КонецЕсли;
	
	Позиция = НачальнаяПозиция;
	Если Направление = "СКонца" Тогда
		Строка = СтрРазвернутьЛок(Строка);
		Подстрока = СтрРазвернутьЛок(Подстрока);
		Позиция = 1;
	КонецЕсли;
	
	Результат = 0;
	Вхождение = 0;
	ДлинаСтроки = СтрДлина(Строка);
	ДлинаПодстроки = СтрДлина(Подстрока);
	
	Пока Позиция <> ДлинаСтроки + 1 Цикл
		Если Сред(Строка, Позиция, ДлинаПодстроки) = Подстрока Тогда
			Результат = Позиция;
			Вхождение = Вхождение + 1;
			Если Вхождение = НомерВхождения Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Если Направление = "СКонца" Тогда
		Сдвиг = 2;
		Результат = ДлинаСтроки - ДлинаПодстроки - Результат + Сдвиг;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрРазвернутьЛок(Знач Строка)
	
	Результат = "";
	ВторойСимвол = 2;
	Для Сч = 1 По СтрДлина(Строка) Цикл
		Результат = Лев(Строка, 1) + Результат;
		Строка = Сред(Строка, ВторойСимвол);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьЗначение(Структура, Путь, Значение)
	
	ТекСтруктура = Структура;
	
	Ключи = СтрРазделитьЛок(Путь, ".");
	
	ВГраница = Ключи.ВГраница();
	ИтоговыйКлюч = Ключи[ВГраница];
	Ключи.Удалить(ВГраница);
	
	Для Каждого ТекКлюч Из Ключи Цикл
		Если Не ТекСтруктура.Свойство(ТекКлюч) Тогда
			ТекСтруктура.Вставить(ТекКлюч, Новый Структура);
		КонецЕсли;
		ТекСтруктура = ТекСтруктура[ТекКлюч];
	КонецЦикла;
	
	ТекСтруктура.Вставить(ИтоговыйКлюч, Значение);
	
КонецПроцедуры

Процедура УстановитьЗначениеСоответствия(Соответствие, Путь, Значение)
	
	ТекСоответствие = Соответствие;
	
