			(Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.Реквизиты.Найти("Заголовок") <> Неопределено);
		Если ЕстьРеквизитЗаголовок Тогда
			СвойствоОбъект.Заголовок = СвойствоОбъект.Наименование;
		КонецЕсли;
		
		СвойствоОбъект.ОбменДанными.Загрузка = Истина;
		СвойствоОбъект.Записать();
		
		Если ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		Результат = СвойствоОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
