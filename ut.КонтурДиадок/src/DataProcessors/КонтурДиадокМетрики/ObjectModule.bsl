// Программный интерфейс

// Инициализирует новую метрику
//
Процедура НоваяМетрика() Экспорт
	
	Метрика = Новый Структура;
	
	// Переменные свойства
	УстановитьЗначение(Метрика, "ClientInfo.ClientName", "");
	УстановитьЗначение(Метрика, "ClientInfo.ClientVersion", "");
	
	УстановитьЗначение(Метрика, "Path.Category", "");
	УстановитьЗначение(Метрика, "Path.Action", "");
	
	УстановитьЗначение(Метрика, "AppContext.Hardware.CoresCount", "");
	
	//УстановитьЗначение(Метрика, "Session.PortalSession.PortalUserId", ""); // Зарезервировано 
	//УстановитьЗначение(Метрика, "Session.CustomSessionId", ""); // Зарезервировано
	
	// Постоянные свойства
	УстановитьЗначение(Метрика, "Id", Строка(НовыйИдентификаторИБ()));
	
	УстановитьЗначение(Метрика, "Time.ClientTime", ДатаISO8601(ТекущаяУниверсальнаяДата()));
	УстановитьЗначение(Метрика, "Time.SendFromClientTime", ДатаISO8601(ТекущаяУниверсальнаяДата()));
	
	УстановитьЗначение(Метрика, "AppContext.OS.Name", НаименованиеОС());
	УстановитьЗначение(Метрика, "AppContext.OS.Version", ВерсияСпецификации());
	УстановитьЗначение(Метрика, "AppContext.OS.BitSet", РазрядностьОС());
	
	УстановитьЗначение(Метрика, "AppContext.Platform.Name", ИмяПлатформы());
	УстановитьЗначение(Метрика, "AppContext.Platform.Version", ВерсияПлатформы());
	УстановитьЗначение(Метрика, "AppContext.Platform.Configuration", ИмяКонфигурации());
	УстановитьЗначение(Метрика, "AppContext.Platform.ConfigurationVersion", ВерсияКонфигурации());
	УстановитьЗначение(Метрика, "AppContext.Platform.RunMode", РежимЗапускаПриложения());
	
	УстановитьЗначение(Метрика, "Session.KeSession.AbonId", Строка(ИдентификаторИнформационнойБазы()));
	УстановитьЗначение(Метрика, "ClientInstanceId", Строка(ИдентификаторПользователяИБ()));
	УстановитьЗначение(Метрика, "Session.KeSession.UserId", Строка(ИдентификаторПользователяОС()));
		
КонецПроцедуры

// Возвращает метрику и топик
// 
// Возвращаемое значение:
//  Структура - Метрика И Топик в виде структур
//
Функция ПолучитьМетрику() Экспорт
	
	Результат = Новый Структура;
	
	УстановитьЗначение(Результат, "Топик.Источник", "1CModule");
	УстановитьЗначение(Результат, "Топик.Ключ", "Common_Statistics");
	УстановитьЗначение(Результат, "Событие", КоллекцияСкопироватьРекурсивно(Метрика));
	
	ПроверитьЗаполнениеМетрики(Результат);
	
	Возврат Результат;
	
КонецФункции

// Устанавливает имя продукта и версию продукта
//
// Параметры:
//  ИмяПродукта		 - Строка - ClientInfo.ClientName
//  ВерсияПродукта	 - Строка - ClientInfo.ClientVersion
//
Процедура Установить_ИмяВерсиюПродукта(ИмяПродукта, ВерсияПродукта) Экспорт
	
	Если ТипЗнч(Метрика) <> Тип("Структура") Тогда
		ВызватьИсключение "Невозможно установить свойство. Метрика не инициализирована";
	КонецЕсли;
	
	УстановитьЗначение(Метрика, "ClientInfo.ClientName", ИмяПродукта);
	УстановитьЗначение(Метрика, "ClientInfo.ClientVersion", ВерсияПродукта);	
		
КонецПроцедуры

// Устанавливает признак первичного действия
//
Процедура Установить_ПервичноеДействие() Экспорт
	
	Если ТипЗнч(Метрика) <> Тип("Структура") Тогда
		ВызватьИсключение "Невозможно установить свойство. Метрика не инициализирована";
	КонецЕсли;
	
	УстановитьЗначение(Метрика, "AppContext.Hardware.CoresCount", "1");
		
КонецПроцедуры

// Устанавливает категорию и действие
//
// Параметры:
//  Категория	- Строка - Path.Category
//  Действие	- Строка - Path.Action
//
Процедура Установить_КатегориюДействие(Категория, Действие) Экспорт
	
	Если ТипЗнч(Метрика) <> Тип("Структура") Тогда
		ВызватьИсключение "Невозможно установить свойство. Метрика не инициализирована";
	КонецЕсли;
	
	УстановитьЗначение(Метрика, "Path.Category", Категория);
	УстановитьЗначение(Метрика, "Path.Action", Действие);
		
КонецПроцедуры

// Устанавливает идентификатор пользователя Контур
//
// Параметры:
//  ИД	- Строка - Session.PortalSession.PortalUserId
//
Процедура Установить_ИдентификаторПользователяКонтур(ИД) Экспорт
	
	Если ТипЗнч(Метрика) <> Тип("Структура") Тогда
		ВызватьИсключение "Невозможно установить свойство. Метрика не инициализирована";
	КонецЕсли;
	
	УстановитьЗначение(Метрика, "Session.PortalSession.PortalUserId", ИД);
		
КонецПроцедуры

// Устанавливает значение переменной (поле Variables)
// КлючПеременной может быть вложенный - путь через точку
//
// Параметры:
//  КлючПеременной	 - Строка - имя переменной
//  ЗначениеПеременной	 - Строка,Число,Булева - значение переменной
// 
Процедура Установить_Переменную(КлючПеременной, ЗначениеПеременной) Экспорт
	
	Если ТипЗнч(Метрика) <> Тип("Структура") Тогда
		ВызватьИсключение "Невозможно установить свойство. Метрика не инициализирована";
	КонецЕсли;
	
	Если Не Метрика.Свойство("Variables") Тогда
		Метрика.Вставить("Variables", Новый Соответствие);
	КонецЕсли;
		
	УстановитьЗначениеСоответствия(Метрика.Variables, КлючПеременной, СтруктураОписанияЗначения(ЗначениеПеременной));
	
КонецПроцедуры

// Устанавливает произвольное свойство метрики
// Свойство может быть вложенным - путь через точку
//
// Параметры:
//  Свойство - Строка - имя свойства
//  Значение - Строка - значение свойства
// 
Процедура Установить_Свойство(Свойство, Значение) Экспорт
	
	Если ТипЗнч(Метрика) <> Тип("Структура") Тогда
		ВызватьИсключение "Невозможно установить свойство. Метрика не инициализирована";
	КонецЕсли;
	
	УстановитьЗначение(Метрика, Свойство, Значение);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции

Функция ВариантХранения()
	
	Если ДоступенВариант_КонстантаКонтур() Тогда
		Результат = "Константа_ИдентификаторИБ";
	ИначеЕсли ДоступенВариант_РегистрДополнительныеСведения() Тогда
		Результат = "РегистрСведений_ДополнительныеСведения";
	ИначеЕсли ДоступенВариант_РегистрЗначенияСвойствОбъектов() Тогда
		Результат = "РегистрСведений_ЗначенияСвойствОбъектов";
	ИначеЕсли ДоступенВариант_Файл() Тогда
		Результат = "Файл";
	Иначе
		Результат = "null";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Служебный программный интерфейс

// Возвращает идентификатор информационной базы
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазы() Экспорт
	
	Результат = ИдентификаторИнформационнойБазыБСП();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ВариантХранения = ВариантХранения();
		
		Результат = ИдентификаторИнформационнойБазыКонтур(ВариантХранения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы по умолчанию
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыНеОпределен() Экспорт
	
	Возврат Новый УникальныйИдентификатор("aacc64c0-e8d8-4ae7-b3f8-8300b2f70d2b");
	
КонецФункции

// Возвращает идентификатор пользователя ИБ
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор пользователя ИБ
//
Функция ИдентификаторПользователяИБ() Экспорт
 
    Результат = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
	
	ИдентификаторАнонимногоПользователяИБ = "071523a4-516f-4fce-ba4b-0d11ab7a1893";
	
    ЭтоАнонимныйПользовательИБ = Строка(Результат) = ИдентификаторАнонимногоПользователяИБ;
    Если ЭтоАнонимныйПользовательИБ Тогда
        Результат = ИдентификаторПользователяОС();
    КонецЕсли;
 
    Возврат Результат;
 
КонецФункции

// Возвращает идентификатор пользователя ОС
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор пользователя ОС
//
Функция ИдентификаторПользователяОС() Экспорт
 
    СистемнаяИнформация1 = Новый СистемнаяИнформация;
    СистемнаяИнформация2 = Новый СистемнаяИнформация;
 
    Если СистемнаяИнформация1.ИдентификаторКлиента = СистемнаяИнформация2.ИдентификаторКлиента Тогда
        Результат = СистемнаяИнформация1.ИдентификаторКлиента;
    Иначе
        // https://devtrainingforum.v8.1c.ru/forum/thread.jsp?id=588350&threadtype=0
        // Константа - Ошибка идентификации клиента, переменный идентификатор
        Результат = Новый УникальныйИдентификатор("d808d128-2d0e-498e-a728-20bdbe6aae56");
    КонецЕсли; 
	
    Если Строка(Результат) = "00000000-0000-0000-0000-000000000000" Тогда
        // Константа - Ошибка идентификации клиента, пустой идентификатор
        Результат = Новый УникальныйИдентификатор("d808d128-7a45-43c4-88f2-7d666470b842");
    КонецЕсли;  
 
    Возврат Результат;
 
КонецФункции

// Проверяет доступность константы КонтурИдентификаторИБ
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в константе
//
Функция ДоступенВариант_КонстантаКонтур() Экспорт
	
	ИмяКонстанты = "КонтурИдентификаторИБ";
	
	Результат = Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступность регистра сведений ДополнительныеСведения
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в регистре
//
Функция ДоступенВариант_РегистрДополнительныеСведения() Экспорт
	
	ИмяРегистра = "ДополнительныеСведения";
	ИмяПВХ = "ДополнительныеРеквизитыИСведения";
	
	ЕстьРегистрДополнительныеСведения = Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено;
	ЕстьПланВидовХарактеристик = Метаданные.ПланыВидовХарактеристик.Найти(ИмяПВХ) <> Неопределено;
	ЕстьСправочникВалюты = Метаданные.Справочники.Найти("Валюты") <> Неопределено;
	ЕстьВладелецВалюты = (ЕстьСправочникВалюты И ЗначениеЗаполнено(ЗаписьСправочникаВалютыРуб()));
	ВалютаВладелецСвойства = (ЕстьПланВидовХарактеристик
		И ЕстьСправочникВалюты
		И ПроверитьВладельцаДополнительногоСвойства());
	
	Результат = (ЕстьРегистрДополнительныеСведения
		И ЕстьПланВидовХарактеристик
		И ЕстьВладелецВалюты
		И ВалютаВладелецСвойства);
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступность регистра сведений ЗначенияСвойствОбъектов
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в регистре
//
Функция ДоступенВариант_РегистрЗначенияСвойствОбъектов() Экспорт
	
	ИмяРегистра = "ЗначенияСвойствОбъектов";
	ИмяПВХСвойстваОбъектов = "СвойстваОбъектов";
	
	ЕстьРегистрЗначенияСвойствОбъектов = Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено;
	ЕстьПланВидовХарактеристик = Метаданные.ПланыВидовХарактеристик.Найти(ИмяПВХСвойстваОбъектов) <> Неопределено;
	ЕстьСправочникВалюты = Метаданные.Справочники.Найти("Валюты") <> Неопределено;
	ЕстьВладелецВалюты = (ЕстьСправочникВалюты И ЗначениеЗаполнено(ЗаписьСправочникаВалютыРуб()));
	ВалютаВладелецСвойства = (ЕстьПланВидовХарактеристик
		И ЕстьСправочникВалюты
		И ПроверитьВладельцаЗначенияСвойства());
	
	Результат = (ЕстьРегистрЗначенияСвойствОбъектов
		И ЕстьПланВидовХарактеристик
		И ЕстьВладелецВалюты
		И ВалютаВладелецСвойства);
	
	Возврат Результат;
	
КонецФункции

// Проверяет права на чтение и запись в каталоге информационной базы
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в файле
//
Функция ДоступенВариант_Файл() Экспорт
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	ЧислоСимволовПризнакИБ = 5;
	ЭтоФайловаяИнформационнаяБаза = (ВРег(Лев(СтрокаСоединения, ЧислоСимволовПризнакИБ)) = "FILE=");
	
	Результат = (ЭтоФайловаяИнформационнаяБаза
		И РазрешенаЗаписьВКаталогИнформационнойБазы());
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный методом БСП
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыБСП() Экспорт
	
	Попытка
		
		ИнтерфейсБСП = Вычислить("СтандартныеПодсистемыСервер");
		Результат = ИнтерфейсБСП.ИдентификаторИнформационнойБазы();
		
	Исключение
		
		Результат = "";
		
		ОписаниеОшибки_ = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		// BSLLS:UsageWriteLogEvent-off
		ЗаписьЖурналаРегистрации(
			"МетрикиКонтур",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ОписаниеОшибки_
		);
		// BSLLS:UsageWriteLogEvent-on
		
		Возврат Результат;
		
	КонецПопытки;
	
	Возврат Новый УникальныйИдентификатор(Результат);
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный бизнес-логикой библиотеки
//
// Параметры:
//  ВариантХранения - Строка - Вариант хранения идентификатора ИБ (см. метод ВариантХранения())
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыКонтур(ВариантХранения) Экспорт
	
	Если ВариантХранения = "Константа_ИдентификаторИБ" Тогда
		Результат = ИдентификаторИнформационнойБазыИзКонстанты();
	ИначеЕсли ВариантХранения = "РегистрСведений_ДополнительныеСведения" Тогда
		Результат = ИдентификаторИнформационнойБазыИзРегистраДополнительныеСведения();
	ИначеЕсли ВариантХранения = "РегистрСведений_ЗначенияСвойствОбъектов" Тогда
		Результат = ИдентификаторИнформационнойБазыИзРегистраЗначенияСвойствОбъектов();
	ИначеЕсли ВариантХранения = "Файл" Тогда
		Результат = ИдентификаторИнформационнойБазыИзФайла();
	Иначе
		Результат = ИдентификаторИнформационнойБазыНеОпределен();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзКонстанты()
	
	Результат = ПрочитатьКонстантуИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьКонстантуИдентификаторИнформационнойБазы();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзРегистраДополнительныеСведения()
	
	Результат = ПрочитатьДополнительноеСведениеИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьДополнительноеСведениеИдентификаторИнформационнойБазы();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзРегистраЗначенияСвойствОбъектов()
	
	Результат = ПрочитатьЗначениеСвойстваИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьЗначениеСвойстваИдентификаторИнформационнойБазы();
