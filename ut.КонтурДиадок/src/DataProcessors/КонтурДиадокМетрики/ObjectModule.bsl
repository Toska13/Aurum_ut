	Ключи.Удалить(ВГраница);
	
	Для Каждого ТекКлюч Из Ключи Цикл
		Если Не ТекСоответствие[ТекКлюч] = Неопределено Тогда
			ТекСоответствие.Вставить(ТекКлюч, Новый Соответствие);
		КонецЕсли;
		ТекСоответствие = ТекСоответствие[ТекКлюч];
	КонецЦикла;
	
	ТекСоответствие.Вставить(ИтоговыйКлюч, Значение);
	
КонецПроцедуры

