Функция СтруктураОписанияЗначения(Значение)
	
	Результат = Новый Структура("value, type");
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Результат.value = XMLСтрока(Значение);
		Результат.type = "number";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Результат.value = Значение;
		Результат.type = "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Результат.value = XMLСтрока(Значение);
		Результат.type = "uuid";
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Результат.value = Base64Строка(Значение);
		Результат.type = "base64";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Результат.value = XMLСтрока(Значение);
		Результат.type = "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат.value = XMLСтрока(Значение);
		Результат.type = "string";
	Иначе
		Результат.value = "convert_error";
		Результат.type = "string";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьЗаполнениеМетрики(Результат)
	
	Если Не ЗначениеЗаполнено(Результат.Событие.ClientInfo.ClientName) Тогда
		ВызватьИсключение "Свойство ClientInfo.ClientName не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.ClientInfo.ClientVersion) Тогда
		ВызватьИсключение "Свойство ClientInfo.ClientVersion не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.Path.Category) Тогда
		ВызватьИсключение "Свойство Path.Category не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.Path.Action) Тогда
		ВызватьИсключение "Свойство Path.Action не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.AppContext.Platform.Name) Тогда
		ВызватьИсключение "Свойство AppContext.Platform.Name не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.AppContext.Platform.Version) Тогда
		ВызватьИсключение "Свойство AppContext.Platform.Version не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.AppContext.OS.Name) Тогда
		ВызватьИсключение "Свойство AppContext.OS.Name не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.AppContext.OS.Version) Тогда
		ВызватьИсключение "Свойство AppContext.OS.Version не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.Session.KeSession.UserId) Тогда
		ВызватьИсключение "Свойство Session.KeSession.UserId не может быть пустым";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Событие.Session.KeSession.AbonId) Тогда
		ВызватьИсключение "Свойство Session.KeSession.AbonId не может быть пустым";
	КонецЕсли;
	
	Если Результат.Событие.Свойство("Variables") Тогда
		
		Для Каждого Элемент Из Результат.Событие.Variables Цикл
			
			Если Не ЗначениеЗаполнено(Элемент.Ключ) Тогда
				ВызватьИсключение "Ключ переменной из коллекции Variables не может быть пустым";
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Элемент.Значение.Value) Тогда
				ВызватьИсключение "Элемент Value переменной из коллекции Variables не может быть пустым";
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Элемент.Значение.Type) Тогда
				ВызватьИсключение "Элемент Type переменной из коллекции Variables не может быть пустым";
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Копирование коллекций

Функция КоллекцияСкопироватьРекурсивно(Источник, ФиксироватьДанные = Неопределено)
	
	ТипИсточника = ТипЗнч(Источник);
	
	Если ЭтоСтруктура(Источник) Тогда
		Приемник = Структура_Скопировать(Источник, ФиксироватьДанные);
	ИначеЕсли ЭтоСоответствие(Источник) Тогда
		Приемник = Соответствие_Скопировать(Источник, ФиксироватьДанные);
	ИначеЕсли ЭтоМассив(Источник) Тогда
		Приемник = Массив_Скопировать(Источник, ФиксироватьДанные);
	Иначе
		Приемник = Источник;
	КонецЕсли;
	
	Возврат Приемник;
	
КонецФункции

Функция Структура_Скопировать(СтруктураИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый Структура;
	
	Для Каждого КлючИЗначение Из СтруктураИсточник Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КоллекцияСкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина
		ИЛИ ФиксироватьДанные = Неопределено
		И ТипЗнч(СтруктураИсточник) = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Новый ФиксированнаяСтруктура(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Массив_Скопировать(МассивИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из МассивИсточник Цикл
		
		НовыйЭлемент = КоллекцияСкопироватьРекурсивно(Элемент, ФиксироватьДанные);
		Результат.Добавить(НовыйЭлемент);
		
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина
		ИЛИ ФиксироватьДанные = Неопределено
		И ТипЗнч(МассивИсточник) = Тип("ФиксированныйМассив") Тогда
		
		Результат = Новый ФиксированныйМассив(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Соответствие_Скопировать(СоответствиеИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеИсточник Цикл
		
		Ключ = КлючИЗначение.Ключ;
		Значение = КоллекцияСкопироватьРекурсивно(КлючИЗначение.Значение, ФиксироватьДанные);
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина
		ИЛИ ФиксироватьДанные = Неопределено
		И ТипЗнч(СоответствиеИсточник) = Тип("ФиксированноеСоответствие") Тогда
		
		Результат = Новый ФиксированноеСоответствие(Результат);
		
	КонецЕсли;
	
