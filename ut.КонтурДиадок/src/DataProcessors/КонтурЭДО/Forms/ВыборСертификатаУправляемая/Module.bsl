////////////////////////////////////////////////////////////////////////////////
// ОписаниеПеременных

// Кэш

// BSLLS:UnusedLocalVariable-off
&НаКлиенте
Перем
_Платформа, // Интерфейс модуля Платформа
_ЯдроКлиент, // Интерфейс модуля Ядро
_Стд, // Интерфейс модуля Клиент Стд
_ОповещениеОЗакрытииЛок; // Описание оповещения

// Кэш серверный

&НаСервере
Перем              
_ОбработкаОбъект, // Интерфейс модуля обработки
_БиблиотекаКартинок; // Интерфейс модуля БиблиотекаКартинок
// BSLLS:UnusedLocalVariable-on

////////////////////////////////////////////////////////////////////////////////
// ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Объект, Параметры);
	Параметры.Свойство("ОтборСертификатов", ОтборСертификатов);
	
	// BSLLS:UnusedLocalVariable-off
	ПутьКФормам = ОбработкаОбъект().Метаданные().ПолноеИмя() + ".Форма.";	
	КартинкаДлительнаяОперация 
		= ПоместитьВоВременноеХранилище(БиблиотекаКартинок().КартинкаДлительнаяОперация, УникальныйИдентификатор);
	КартинкаПредупреждение = 
		ПоместитьВоВременноеХранилище(БиблиотекаКартинок().КартинкаБольшоеПредупреждениеБезФона, УникальныйИдентификатор);
	// BSLLS:UnusedLocalVariable-on
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭтуФорму(Оповещение = Неопределено) Экспорт
	
	// BSLLS:UnusedLocalVariable-off
	_ОповещениеОЗакрытииЛок = Оповещение;
	РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	// BSLLS:UnusedLocalVariable-on
	
	Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОбновитьСписокСертификатов", Интервал01(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СертификатыИнформацияОбСертификате" Тогда
		ОткрытьИнформациюОбСертификате(Элемент.ТекущиеДанные.Отпечаток); 
	Иначе
		ОбработатьВыборСертификата();
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура НетНужногоСертификатаНажатие(Элемент)
		
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_НажатиеКнопки(
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().ПоСертификату, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().НетНужногоСертификата, 
		"Нажать кнопку", 
		ИмяФормы);
	
	ПоказатьФормуНетНужногоСертификата();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНетСертификатовЦПТекстНажатие(Элемент)

	Переменные = Новый Соответствие;
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ЗадатьВопросОнлайнКонсультанту, 
		Элемент.Имя, 
		Переменные, 
		ИмяФормы);
	
	Модуль_Платформа().ЦентрПоддержки_Открыть("", ИмяФормы);

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНетСертификатовПодробнееНажатие(Элемент)
	
	Переменные = Новый Соответствие;
		
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
		"ПоказатьПодробности", 
		Элемент.Имя, 
		Переменные, 
		ИмяФормы);
	
	Элементы.НетСертификатовПодробности.Видимость = НЕ Элементы.НетСертификатовПодробности.Видимость;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ОбработатьВыборСертификата();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Зависимости          

&НаСервере
Функция БиблиотекаКартинок()
	
	Если _БиблиотекаКартинок = Неопределено Тогда
		_БиблиотекаКартинок = ОбработкаОбъект().БиблиотекаКартинок();
	КонецЕсли;
	
	Возврат _БиблиотекаКартинок;
	
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте() Экспорт

	Если _ЯдроКлиент = Неопределено Тогда
		_ЯдроКлиент = Модуль_Платформа().Модуль_ЯдроНаКлиенте();
	КонецЕсли;
	
	Возврат _ЯдроКлиент;
	
КонецФункции

&НаКлиенте
Функция Модуль_Платформа() Экспорт
	
	Если _Платформа = Неопределено Тогда                                                   
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбщийКонтекстКлиентСервер", Объект.ОбщийКонтекстКлиентСервер);
		
		// BSLLS:GetFormMethod-off
		_Платформа = ПолучитьФорму(ПутьКФормам + "Модуль_ПлатформаУправляемая", ПараметрыФормы, ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	
	Возврат _Платформа;
	
КонецФункции

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции 

////////////////////////////////////////////////////////////////////////////////
// Служебные

&НаКлиенте
Процедура ОбработатьВыборСертификата()
	
	ТекущиеДанные = Элементы.Сертификаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Результат = Новый Структура("Отпечаток, Представление");
	Результат.Отпечаток = ТекущиеДанные.Отпечаток;
	Результат.Представление = ТекущиеДанные.Наименование;
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Модуль_ЯдроНаКлиенте()._СтдОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(
		_ОповещениеОЗакрытииЛок, Результат);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокСертификатов()

	ЛокальныеСертификаты = ЛокальныеСертификаты();
	ЕстьОтбор = ТипЗнч(ОтборСертификатов) = Тип("ФиксированныйМассив");
	
	Для Каждого Элемент Из ЛокальныеСертификаты Цикл
		
		Если ЕстьОтбор И ОтборСертификатов.Найти(Элемент.ОтпечатокСертификата) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Сертификаты.Добавить();
		НоваяСтрока.Отпечаток = Элемент.ОтпечатокСертификата;
		НоваяСтрока.ИНН = Элемент.ИНН;
		НоваяСтрока.КПП = Элемент.КПП;
		НоваяСтрока.Наименование = Элемент.Наименование;
		НоваяСтрока.СрокДействия = Элемент.СрокДействия;
		НоваяСтрока.Организация = Элемент.Организация;
		НоваяСтрока.Актуален = Элемент.СрокДействия > ТекущаяДата();
		НоваяСтрока.ДатаВыдачи = Элемент.ДатаВыдачи;
		
		Если ЗначениеЗаполнено(НоваяСтрока.КПП) Тогда
			ИннКпп = Модуль_ЯдроНаКлиенте()._СтдСтр().СтрШаблонЛок("%1-%2", НоваяСтрока.ИНН, НоваяСтрока.КПП);
		Иначе                                                                            
			ИннКпп = НоваяСтрока.ИНН;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Организация) Тогда
			Представление = Модуль_ЯдроНаКлиенте()._СтдСтр().СтрШаблонЛок("%1 • %2", ИннКпп, НоваяСтрока.Организация);
		Иначе
			Представление = ИннКпп;
		КонецЕсли;
		
		НоваяСтрока.ПредставлениеПодвал = Модуль_ЯдроНаКлиенте()._СтдСтр().СтрШаблонЛок("%1, до %2", 
			Представление, 
			Формат(НоваяСтрока.СрокДействия, "ДЛФ=Д"));
		
	КонецЦикла;
	
	Сертификаты.Сортировать("ДатаВыдачи Убыв"); 
	Если Сертификаты.Количество() = 0 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНетСертификатов;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСписокСертификатов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЛокальныеСертификаты()

	Попытка
		
		Результат = Модуль_ЯдроНаКлиенте().Сертификаты_СписокСертификатов();
		
	Исключение
		
		Результат = Новый Массив;
		
		Ошибка = ИнформацияОбОшибке();
		
		// BSLLS:UnusedLocalVariable-off
		НетСертификатовПодробности = КраткоеПредставлениеОшибки(Ошибка);
		// BSLLS:UnusedLocalVariable-on
		ТекстОшибки	= ПодробноеПредставлениеОшибки(Ошибка);
		
		ДопПеременные = Новый Соответствие;
		ДопПеременные.Вставить("Идентификатор ошибки", "НетДоступаКСертификатам");
		
		Модуль_ЯдроНаКлиенте().Метрика_ДобавитьОшибку_СУчетомЗаполненияКонтекста(
			Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
			Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ОткрытиеФормы, 
			ТекстОшибки, 
			ДопПеременные);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьИнформациюОбСертификате(Отпечаток)
	
	ДанныеСертификата = Модуль_ЯдроНаКлиенте().Сертификаты_ДанныеСертификата(Отпечаток);
	ОписаниеСертификата = Модуль_ЯдроНаКлиенте().Сертификаты_ОписаниеСертификата(ДанныеСертификата);
	Модуль_Платформа().ПоказатьОписаниеСертификата(ОписаниеСертификата, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуНетНужногоСертификата()
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПропуститьВыборОрганизацииДляЧатаИEmail", Истина);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Режим", "НетНужногоСертификата");
	ПараметрыОткрытияФормы.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Модуль_Платформа = Модуль_Платформа();
	Модуль_Платформа.ОткрытьФормуДиадокМодальноЛок(
		"ФормаHTMLСообщенияУправляемая",
		ЭтаФорма,
		ПараметрыОткрытияФормы, ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция Интервал01()
	
	Возврат 0.1;
	
КонецФункции