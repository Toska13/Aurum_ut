&НаСервере
Процедура ЗагрузитьИзФайлаНаСервере(Знач АдресХранилища, Знач ТипКонтента)
	
	Имя = Менеджер().ХранилищеПлагинов().ПодключитьВнешняяОбработка(АдресХранилища);
	Обработка = Новый(СтрЗаменить("ExternalDataProcessorObject.%1", "%1", Имя));
	Манифест = Обработка.МанифестПлагина();
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Контент = Менеджер().МодельКонтент();
	Контент.Имя = Манифест.Идентификатор;
	Контент.Данные = ДвоичныеДанные;
	Контент.Тип = ТипКонтента;	
	
	ОписаниеПлагина = Менеджер().МодельОписаниеПлагина();
	ОписаниеПлагина.Ид = Манифест.Идентификатор;
	ОписаниеПлагина.Представление = Манифест.Представление;
	ОписаниеПлагина.Версия = Манифест.Версия;
	ОписаниеПлагина.ТипКонтента = ТипКонтента;
	ОписаниеПлагина.Проект = КонфигурацияПриложения.Имя;
	
	Менеджер().ХранилищеПлагинов().Сохранить(ОписаниеПлагина, Контент);
	УдалитьИзВременногоХранилища(АдресХранилища);
	
	ПротестироватьПлагинНаСервере(ОписаниеПлагина);
	ОбновитьСписокПлагиновНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ДвоичныеДанныеПлагинаНаСервере(Знач ОписаниеПлагина)
	
	ХранилищеПлагина = Менеджер().ХранилищеПлагинов().Контент(ОписаниеПлагина);
	Если ХранилищеПлагина.Ссылка.Пустая() Тогда
		ВызватьИсключение "Не удалось получить объект хранилища плагина";
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ХранилищеПлагина.Хранилище.Получить(), УникальныйИдентификатор);
	
КонецФункции

