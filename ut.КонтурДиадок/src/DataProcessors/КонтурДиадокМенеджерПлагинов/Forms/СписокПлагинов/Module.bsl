&НаСервере
Процедура СохранитьПлагинНаСервере(ПутьДоКаталога)
	
	ОписаниеПлагина = ОписаниеПлагина();
	АдресХранилища = ДвоичныеДанныеПлагинаНаСервере(ОписаниеПлагина);
	
	Имя = ОписаниеПлагина.Ид;
	Расширение = РасширенияФайлаПоТипуКонтента(ОписаниеПлагина.ТипКонтента);
	Разделитель = Менеджер()._СтдОС().ПолучитьРазделительПутиЛок();
	
	Пути = Новый Массив;
	Пути.Добавить(ПутьДоКаталога);
	Пути.Добавить(Менеджер()._СтдСтр().СтрШаблонЛок("%1%2",  Имя, Расширение));
	
	Путь = Менеджер()._СтдОС().СоединитьПуть(Пути, Менеджер()._СтдОС().ПолучитьРазделительПутиЛок());
	ПолучитьИзВременногоХранилища(АдресХранилища).Записать(Путь);
	УдалитьИзВременногоХранилища(АдресХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогОтладки(Оповещение)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите каталог для сохранения плагина";
	Если ЗначениеЗаполнено(КаталогОтладки) Тогда
		Диалог.Каталог = КаталогОтладки;
	КонецЕсли;
	
	КлиентскиеМетоды()._Стд().Диалоги().ПоказатьДиалогВыбораФайла(Диалог, Оповещение);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокПлагиновНаСервере()
	
	Отбор = Менеджер().ХранилищеПлагинов().МодельОтборСписка();
	Отбор.Проект = КонфигурацияПриложения.Имя;
	
	Список = Менеджер().ХранилищеПлагинов().Список(Отбор); 
	ТаблицаПлагинов.Очистить();
	
	Для Каждого Элемент Из Список Цикл
		
		Строка = ТаблицаПлагинов.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Элемент);
		
		Строка.КартинкаОбновление = 1;
		Строка.КартинкаСостояние = 1;
		
		Если Строка.Состояние = СостоянияПлагина().Включен Тогда
			Строка.КартинкаСостояние = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

