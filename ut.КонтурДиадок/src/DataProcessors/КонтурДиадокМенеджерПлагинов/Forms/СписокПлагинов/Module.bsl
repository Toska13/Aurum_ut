&НаКлиентеНаСервереБезКонтекста
Функция ТипКонтентаФайла(Файл)

	Если Файл.Расширение = ".epf" Тогда
		Результат = ТипКонтентаОбработка();
	ИначеЕсли Файл.Расширение = ".cfe" Тогда
		Результат = ТипКонтентаРасширение();
	Иначе
		ВызватьИсключение СтрЗаменить("Не ожидаемый тип плагина: %1", "%1", Файл.Расширение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РасширенияФайлаПоТипуКонтента(ТипКонтента)

	Если ТипКонтента = ТипКонтентаОбработка() Тогда
		Результат = ".epf";
	ИначеЕсли ТипКонтента = ТипКонтентаРасширение() Тогда
		Результат = ".cfe";
	Иначе
		ВызватьИсключение СтрЗаменить("Не ожидаемый тип контента: %1", "%1", ТипКонтента);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

