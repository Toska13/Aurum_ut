// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ПротестироватьПлагин(ОписаниеПлагина) Экспорт
	
	Попытка
		Результат = ХранилищеПлагинов().Протестировать(ОписаниеПлагина);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат <> Неопределено И Результат.ТребуетсяНастройка = Истина Тогда
		ХранилищеПлагинов().УстановитьСостояние(ОписаниеПлагина, ХранилищеПлагинов()._СостоянияПлагина().ТребуетсяНастройка);
	КонецЕсли;	
	Если Результат = Неопределено Или Результат.Успешно = Ложь Тогда
		ХранилищеПлагинов().УстановитьСостояние(ОписаниеПлагина, ХранилищеПлагинов()._СостоянияПлагина().Отключен);
	КонецЕсли;
	
КонецПроцедуры

Функция _ЭтоВнешняяОбработка() Экспорт
	
	Если ЭтоВнешняяОбработкаКэш = Неопределено Тогда
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
			ЭтоВнешняяОбработкаКэш = Ложь;
		Иначе
			ЭтоВнешняяОбработкаКэш = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработкаКэш;
	
КонецФункции

Функция _ХранилищеПлагиновПоУмолчанию() Экспорт
	
	Если _ЭтоВнешняяОбработка() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадокМенеджерПлагиновХранилище");
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадокМенеджерПлагиновХранилище");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция _СтдОС() Экспорт
	
	Если СтдОСЛок = Неопределено Тогда
		Если _ЭтоВнешняяОбработка() Тогда
			СтдОСЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдОС");
		Иначе
			СтдОСЛок = Новый("DataProcessorObject.КонтурДиадокСтдОС");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтдОСЛок;
	
КонецФункции

Функция _СтдСтр() Экспорт
	
	Если СтдСтрЛок = Неопределено Тогда
		Если _ЭтоВнешняяОбработка() Тогда
			СтдСтрЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			СтдСтрЛок = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтдСтрЛок;
	
КонецФункции

