// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// СПИСОК

Функция РазобратьВыборкуСписок(Выборка)
	
	Результат = МодельСписокОтвет();
	Результат.Всего = Выборка.Количество;
	
	Пока Обновлятор().Следующий(Выборка) Цикл
		Результат.Список.Добавить(РазобратьЭлементСписка(Выборка.ТекущийЭлемент));	
	КонецЦикла;
	
	Результат.Количество = Результат.Список.Количество();
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция РазобратьЭлементСписка(Элемент)
	
	Результат = МодельЭлементСписка();
	Результат.Ид = Элемент.Имя;
	Результат.Версия = ОпределитьАктуальнуюВерсию(Элемент.Имя);
	Результат.ДатаОбновления = ОпределитьДатуВерсии(Элемент.Имя, Результат.Версия);
	Результат.Синоним = Элемент.Синоним;
	Результат.Описание = Элемент.Описание;
	Результат.Проект = Элемент.Родитель;
	Результат.Тип = Элемент.Тип;
	Результат.АдресДокументации = Элемент.АдресДокументации;
	
	Возврат Результат;
	
КонецФункции

// МОДЕЛИ

Функция МодельСписокОтвет()
	
	Модель = Новый Структура;
	Модель.Вставить("Всего");
	Модель.Вставить("Количество");
	Модель.Вставить("Список", Новый Массив);
	
	Возврат Модель;
	
КонецФункции

Функция МодельЭлементСписка()
	
	Модель = Новый Структура;
	Модель.Вставить("Ид");
	Модель.Вставить("Версия");
	Модель.Вставить("ДатаОбновления");
	Модель.Вставить("Синоним");
	Модель.Вставить("Описание");
	Модель.Вставить("Проект");
	Модель.Вставить("Тип");
	Модель.Вставить("АдресДокументации");
	
	Возврат Модель;
	
КонецФункции

// ЗАВИСИМОСТИ

Функция Обновлятор()
	
	Если ОбновляторКэш = Неопределено Тогда
		
		ОбновляторКэш = СоздатьОбновлятор();
		ПараметрыОбновлятора = ОбновляторКэш.АпдейтКлиентПараметры();
		ЗаполнитьЗначенияСвойств(ПараметрыОбновлятора, КонфигурацияОбновлятора);
		
		ОбновляторКэш.АпдейтКлиент(ПараметрыОбновлятора);
		
		Если НастройкиПрокси <> Неопределено Тогда
			СессияОбновлятора = ОбновляторКэш.Сессия();	
			СессияОбновлятора.Прокси = Коннектор().НовыйИнтернетПрокси(НастройкиПрокси);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбновляторКэш;
	
КонецФункции

Функция Коннектор()
	
	Если HttpЛок = Неопределено Тогда
		Если _ЭтоВнешняяОбработка() Тогда
			HttpЛок = Новый("ExternalDataProcessorObject.КонтурДиадокКоннекторHTTP");
		Иначе
			HttpЛок = Новый("DataProcessorObject.КонтурДиадокКоннекторHTTP");
		КонецЕсли;
	КонецЕсли;
		
	Возврат HttpЛок;
	
КонецФункции

// ПРОВЕРКА КОНФИГУРАЦИЙ

Функция ПроверитьКоллекцию(Модель, Коллекция, ПропускатьЗаполнение = Неопределено)
	
	Если ПропускатьЗаполнение = Неопределено Тогда
		ПропускатьЗаполнение = Новый Массив;
	КонецЕсли;
	
	Ошибки = Новый Массив;
	Для Каждого Элемент Из Модель Цикл
		Если Коллекция.Свойство(Элемент.Ключ) = Ложь Тогда
				Ошибки.Добавить(_СтдСтр().СтрШаблонЛок("Не найден ключ: %1", Элемент.Ключ));
				Продолжить;
		КонецЕсли;
		Если ПропускатьЗаполнение.Найти(Элемент.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеКоллекцииЗаполнено(Коллекция[Элемент.Ключ]) = Ложь Тогда
				Ошибки.Добавить(_СтдСтр().СтрШаблонЛок("Пустое значение ключа: %1", Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

Процедура ПроверитьКонфигурациюПриложения(Значение)
	
	ПропускатьЗаполнение = Новый Массив;
	ПропускатьЗаполнение.Добавить("КаталогОтладки");
	
	Результат = ПроверитьКоллекцию(МодельКонфигурацияПриложения(), Значение, ПропускатьЗаполнение);
	
	Если Результат.Количество() Тогда
		Ошибки = _СтдСтр().СтрСоединитьЛок(Результат, ", ");
		Сообщение = _СтдСтр().СтрШаблонЛок("При проверке конфигурации приложения обнаружены ошибки: %1", Ошибки);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
КонецПроцедуры

// ПРОЧЕЕ

Функция СоздатьОбновлятор()	
	
	Если _ЭтоВнешняяОбработка() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадокАпдейтКлиент");
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадокАпдейтКлиент");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьАктуальнуюВерсию(Ид)
			
	ОписаниеПлагина = МодельОписаниеПлагина();
	ОписаниеПлагина.Ид = Ид;
	ОписаниеПлагина.Версия = "0.0.0";
	
	Попытка
		РезультатПроверки = ПроверитьОбновления(ОписаниеПлагина);
	Исключение
		Возврат Неопределено;  
	КонецПопытки;
	
	Если РезультатПроверки.ЕстьОбновление Тогда
		Результат = РезультатПроверки.Версия;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ОпределитьДатуВерсии(Имя, Версия)
	
	Если ЗначениеЗаполнено(Версия) = Ложь Тогда
		Возврат Дата("00010101");
	КонецЕсли;
	
	Возврат Обновлятор().ПолучитьВерсию(Имя, Версия).Дата;
	
КонецФункции

Функция ЗначениеКоллекцииЗаполнено(Значение)
	
	ТипЗнч = ТипЗнч(Значение);
	
	Если ТипЗнч = Тип("Строка") Тогда
		Результат = Значение <> "";
	ИначеЕсли ТипЗнч = Тип("Массив") Тогда
		Результат = Значение.Количество() > 0;
	ИначеЕсли Значение = Неопределено Тогда
		Результат = Ложь;
	ИначеЕсли ТипЗнч = Тип("Булево") Или ТипЗнч = Тип("Число") Тогда
		Результат = Истина;
	Иначе
		ВызватьИсключение "Неопределенный ключ конфигурации";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СобытияПлагинов()
	
	Длина150 = 150;
	Длина250 = 250;
	
	ОписаниеТипаСтрока150 = Новый ОписаниеТипов("Строка",,, Новый КвалификаторыСтроки(Длина150));
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ид", ОписаниеТипаСтрока150);
	Результат.Колонки.Добавить("Событие", Новый ОписаниеТипов("Строка",,, Новый КвалификаторыСтроки(Длина250)));
	Результат.Колонки.Добавить("Версия", ОписаниеТипаСтрока150);
	
	Отбор = ХранилищеПлагинов().МодельОтборСписка();
	Отбор.Проект = КонфигурацияПриложения.Имя;
	
	Плагины = ХранилищеПлагинов().Список(Отбор);
	
	Для Каждого Плагин Из Плагины Цикл
		
		Если Плагин.Состояние <> ХранилищеПлагинов()._СостоянияПлагина().Включен Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Манифест = ХранилищеПлагинов().Манифест(Плагин);
		Исключение
			Продолжить;               
		КонецПопытки;
		
		Для Каждого Элемент Из Манифест.События Цикл
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Ид = Плагин.Ид;
			НоваяСтрока.Версия = Плагин.Версия;
			НоваяСтрока.Событие = Элемент;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ХранилищеЭтоОбработка(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоЭлементов = 2;
	МассивЗначений = _СтдСтр().СтрРазделитьЛок(Значение, ".");
	Если МассивЗначений.Количество() <> КоличествоЭлементов Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат МассивЗначений[0] = "DataProcessorObject" 
		Или МассивЗначений[0] = "ExternalDataProcessorObject"
		Или МассивЗначений[0] = "DataProcessorManager";
		
КонецФункции

Функция ХранилищеЭтоСправочник(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.Справочники.Найти(Значение) <> Неопределено;
	
КонецФункции

Функция ХранилищеЭтоРегистрСведений(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.РегистрыСведений.Найти(Значение) <> Неопределено;
	
КонецФункции

Функция ХранилищеЭтоОбщийМодуль(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если _СтдСтр().СтрНайтиЛок(Значение, ".") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.ОбщиеМодули.Найти(Значение) <> Неопределено;
		
КонецФункции
