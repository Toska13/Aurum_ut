// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Возвращает список доступных плагинов для текущего приложения. Отбор происходит по родителю плагина в сервисе
// обновлений. 
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура:
//     * Всего        Число - Общее количество найденных плагинов
//     * Количество   Число - Количество элементов в списке
//     * Список       Массив структур - Массив описаний плагинов, каждый элемент содержит:
//         - Ид                 - Идентификатор плагина
//         - Версия             - Актуальная версия плагина
//         - ДатаОбновления     - Дата последнего обновления
//         - Синоним            - Отображаемое имя плагина
//         - Описание           - Текстовое описание
//         - Проект             - Проект, который указан в сервисе обновлений как родительский.
//         - Тип                - Тип продукта
//         - АдресДокументации	- URL документации
//
Функция Список() Экспорт
	
	Отбор = Обновлятор().ОтборПродуктов();
	Отбор.ТипПродукта = "Плагин";
	Отбор.Родитель = КонфигурацияОбновлятора.Приложение;
	
	Выборка = Обновлятор().ВыбратьПродукты(Отбор);
	
	Возврат РазобратьВыборкуСписок(Выборка);
	
КонецФункции

// Скачивает контент плагина указанной версии из сервиса обновлений.
//
// Параметры:
//   ОписаниеПлагина - Структура - см. МодельОписаниеПлагина
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - см. МодельКонтент
//
Функция Скачать(ОписаниеПлагина) Экспорт
	
	Результат = Неопределено;
	ВыборкаКонтентов = Обновлятор().ВыбратьКонтентыВерсии(ОписаниеПлагина.Ид, ОписаниеПлагина.Версия);
	
	Пока Обновлятор().Следующий(ВыборкаКонтентов) Цикл
		
		Если НРег(ВыборкаКонтентов.ТекущийЭлемент.Имя) <> НРег(ОписаниеПлагина.ТипКонтента) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = МодельКонтент();
		Результат.Имя = ВыборкаКонтентов.ТекущийЭлемент.ИмяФайла;
		Результат.Тип = ВыборкаКонтентов.ТекущийЭлемент.Имя;
		Результат.Хэш = ВыборкаКонтентов.ТекущийЭлемент.MD5Хеш;
		Результат.Данные = Обновлятор().СкачатьКонтент(ОписаниеПлагина.Ид, 
														ОписаниеПлагина.Версия, 
														ОписаниеПлагина.ТипКонтента);
		
		Прервать;
		
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		ВызватьИсключение _СтдСтр().СтрШаблонЛок(
			"Не удалось скачать контент: тип контента не найден: %1", ОписаниеПлагина.ТипКонтента);
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Скачивает из сервиса обновлений и устанавливает плагин в хранилище.
//
// Параметры:
//   ОписаниеПлагина - Структура - см. МодельОписаниеПлагина
//
// Возвращаемое значение - Ссылка - Ссылка на объект хранилища.
//
Функция Установить(ОписаниеПлагина) Экспорт
		
	Контент = Скачать(ОписаниеПлагина);
    Результат = ХранилищеПлагинов().Сохранить(ОписаниеПлагина, Контент);
	
	Возврат Результат;
	
КонецФункции

// Обновляет плагин до последней доступной версии.
//
// Параметры:
//   ОписаниеПлагина - Структура - см. МодельОписаниеПлагина
//
// Возвращаемое значение - Ссылка - Ссылка на объект хранилища.
//
Функция Обновить(Знач ОписаниеПлагина) Экспорт
	
	РезультатПроверки = ПроверитьОбновления(ОписаниеПлагина);
	
	Если РезультатПроверки.ЕстьОбновление = Ложь Тогда
		ВызватьИсключение "Обновления для плагина не найдены";
	КонецЕсли;
	
	ОписаниеПлагина.Версия = РезультатПроверки.Версия;
	Возврат Установить(ОписаниеПлагина);
	
КонецФункции

// Проверяет наличие обновлений для плагина.
//
// Параметры:
//   ОписаниеПлагина - Структура - см. МодельОписаниеПлагина
//
// Возвращаемое значение - Структура - см. Обновлятор.РезультатПроверки
//
Функция ПроверитьОбновления(ОписаниеПлагина) Экспорт

	КонтекстВерсии = Обновлятор().КонтекстВерсии();
	КонтекстВерсии.Версия = ОписаниеПлагина.Версия;
	КонтекстВерсии.ИдБазы = КонфигурацияОбновлятора.КлючИБ;
	КонтекстВерсии.ПолучатьБетаВерсии = Ложь; // TODO Исправить когда сделаем конореечное обновление
	
	Возврат Обновлятор().ПроверитьОбновление(ОписаниеПлагина.Ид, КонтекстВерсии);
	
КонецФункции

// Возвращает интерфейс для работы с хранилищем плагинов.
//
// Возвращаемое значение:
//	Произвольный - Зависит от конкретной реализации хранилища.
//
Функция ХранилищеПлагинов() Экспорт
	
	Если ХранилищеПлагинов = Неопределено Тогда
		ВызватьИсключение "Хранилище плагинов не определенно";
	КонецЕсли;
	
	Возврат ХранилищеПлагинов;
	
КонецФункции

// СОБЫТИЯ

// Возвращает список плагинов, подписанных на указанное событие.
//
// Параметры:
//   ИмяСобытия - Строка
//
// Возвращаемое значение:
//   ФиксированныйМассив структур с полями: см. МодельОписаниеПлагина
//
Функция НайтиПлагиныПоСобытию(ИмяСобытия) Экспорт
	
	Результат = Новый Массив;
	ТаблицаСобытий = СобытияПлагинов();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Событие", ИмяСобытия);
	
	НайденныеСтроки = ТаблицаСобытий.НайтиСтроки(Отбор);
	
	Для Каждого Элемент Из НайденныеСтроки Цикл
		
		Описание = МодельОписаниеПлагина();
		Описание.Ид = Элемент.Ид;
		Описание.Версия = Элемент.Версия;
		Описание.Проект = КонфигурацияПриложения.Имя;
		
		Результат.Добавить(Описание);
		
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(Результат);
	
КонецФункции

// УСТАНОВЩИКИ

// Устанавливает свойство формы для использования указанной конфигурации приложения.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Конфигурация приложения.
//                                     См. МодельКонфигурацияПриложения.
//
Процедура УстановитьКонфигурациюПриложения(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки конфигурации приложения: ожидалась структура или фиксированная структура";	
	КонецЕсли; 
	
	ПроверитьКонфигурациюПриложения(Значение);
	
	КонфигурацияПриложения = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для использования указанной конфигурации обновлятора.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Конфигурация обновлятора.
//                                     См. МодельКонфигурацияОбновлятора.
//
Процедура УстановитьКонфигурациюОбновлятора(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки конфигурации обновлятора: ожидалась структура или фиксированная структура";	
	КонецЕсли;
	
	КонфигурацияОбновлятора = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для использования указанного объекта метаданных в качестве хранилища плагинов.
//
// Параметры:
//  Значение - Строка - Имя объекта метаданных, используемого как хранилище плагинов.
//                     Допустимые значения: "Обработка", "Справочник", "РегистрСведений", "ОбщийМодуль".
//
Процедура УстановитьХранилищеПлагинов(Значение = Неопределено) Экспорт

	Если Значение = Неопределено Тогда
		ХранилищеПлагинов = _ХранилищеПлагиновПоУмолчанию();
	Иначе
		Если ХранилищеЭтоОбработка(Значение) Тогда
			ХранилищеПлагинов = Новый(Значение);
		ИначеЕсли ХранилищеЭтоСправочник(Значение) Тогда
			ХранилищеПлагинов = Справочники[Значение];
		ИначеЕсли ХранилищеЭтоРегистрСведений(Значение) Тогда
			ХранилищеПлагинов = РегистрыСведений[Значение];
		ИначеЕсли ХранилищеЭтоОбщийМодуль(Значение) Тогда
			ХранилищеПлагинов = Вычислить(Значение);			
		Иначе
			ВызватьИсключение "Неопределенный тип хранилища плагинов";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает вызывающий модуль, для предоставления публичного интерфейса приложения.
//
// Параметры:
//   Значение - Произвольный - Объект метаданных.
//
Процедура УстановитьВызывающийМодуль(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		ВызватьИсключение "Пустое значение вызывающего модуля";
	КонецЕсли;
	
	ВызывающийМодуль = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для настроек прокси
//
// Параметры:
//  Значение - Структура, ФиксированнаяСтруктура - см КоннекторHTTP.СоздатьНастройкиПрокси.
//
Процедура УстановитьНастройкиПрокси(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);	
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки прокси: ожидалась структура или фиксированная структура";	
	КонецЕсли;
	
	НастройкиПрокси = Значение;
	
КонецПроцедуры

// МОДЕЛИ

// Модель конфигурации приложения. Используется для хранения и передачи параметров текущего приложения.
//
// Возвращаемое значение:
// 	Стуктура:
//  	* Имя      - Строка - Имя приложения, по которому будет производиться поиск и сохранения плагинов в базе 1С
//  	* Каталог  - Строка - родитель элементов спраовчника, где хранятся плагины 
//	      КаталогОтладки - Строка - Каталог, где будет происходить поиск плагинов для отладки
//
Функция МодельКонфигурацияПриложения() Экспорт

	Модель = Новый Структура;
	Модель.Вставить("Имя");
	Модель.Вставить("Каталог");
	Модель.Вставить("КаталогОтладки");
	
	Возврат Модель;
	
КонецФункции

// Модель конфигурации обновлятора. Содержит параметры подключения к сервису обновлений.
//
// Возвращаемое значение:
//	Структура:
//   * Локация 	- Строка - Локация сервиса
//   * КлючАПИ 	- Строка - X-Kontur-Apikey
//   * КлючИБ 	- Строка - X-Kontur-Secret-Key
//   * Приложение  - Строка - Имя приложения в сервисе обновлений
//
Функция МодельКонфигурацияОбновлятора() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Локация");
	Модель.Вставить("КлючАПИ");
	Модель.Вставить("КлючИБ");
	Модель.Вставить("Приложение");
	
	Возврат Модель;
	
КонецФункции

// Модель описания плагина для работы с хранилищем.
//
// Возвращаемое значение:
//	Структура:
//   * Представление	- Строка - Наименование плагина
//   * Ид 				- Строка - Идентификатор плагина
//   * Проект 			- Строка - Имя проекта, для которого предназначени плагин
//   * Версия		 	- Строка - Версия плагина
//   * ТипКонтента 		- Строка - "data-processor", "extension"
//
Функция МодельОписаниеПлагина() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Представление");
	Модель.Вставить("Ид");
	Модель.Вставить("Проект");
	Модель.Вставить("Версия");
	Модель.Вставить("ТипКонтента");
	
	Возврат Модель;
	
КонецФункции

// Модель контента плагина. Представляет загружаемый или устанавливаемый контент плагина.
//
// Возвращаемое значение:
//	Структура:
//   * Имя		- Строка - Имя контента
//   * Тип 		- Строка - "data-processor", "extension"
//   * Хэш 		- Строка - Хеш данные плагина
//   * Данные	- ДвоичныеДанные - Данные контента
//
Функция МодельКонтент() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Имя");
	Модель.Вставить("Тип");
	Модель.Вставить("Хэш");
	Модель.Вставить("Данные");
	
	Возврат Модель;
	
КонецФункции

