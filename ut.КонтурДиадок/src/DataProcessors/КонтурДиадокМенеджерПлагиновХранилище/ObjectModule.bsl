// Возвращает сохранённый плагин по описанию плагина.
//
// Параметры:
//  ОписаниеПлагина 	- Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//  ПараметрыПлагина 	- Структура - параметры публичных свойств плагина
//	Каталог				- Строка 	- Каталог отладки плагина
//
// Возвращаемое значение:
//   Объект внешней обработки.
//
Функция Получить(ОписаниеПлагина, ПараметрыПлагина = Неопределено, Каталог = Неопределено) Экспорт 
	
	Если ТолстыйКлиентОбычноеПриложение() Или ЗначениеЗаполнено(Каталог) Тогда
		Результат = СоздатьПлагин(ОписаниеПлагина, Каталог);
	Иначе
		Имя = ПодключитьПлагин(ОписаниеПлагина);
		Результат = Новый(СтрЗаменить("ExternalDataProcessorObject.%1", "%1", Имя));
	КонецЕсли;
	
	Если ПараметрыПлагина <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, ПараметрыПлагина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает список сохранённых плагинов.
//
// Параметры:
//	Отбор - Структура - см. МодельОтборСписка
//
// Возвращаемое значение:
//   Список установленных плагинов - ТаблицаЗначений.
//
Функция Список(Отбор) Экспорт
	
	Если ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда
		Результат = СписокДополнительныеОбработки(Отбор);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда
		Результат = СписокВнешниеОбработки(Отбор);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда
		Результат = СписокВнешниеПечатныеФормы(Отбор);
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции                                 	

// Возвращает описание плагина с его контентом.
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
// Возвращаемое значение:
//   Структура - см. МодельХранилищаПлагина.
//
Функция Контент(ОписаниеПлагина) Экспорт 
	
	Если ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда
		Результат = КонтентДополнительныеОбработки(ОписаниеПлагина);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда
		Результат = КонтентВнешниеОбработки(ОписаниеПлагина);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда
		Результат = КонтентВнешниеПечатныеФормы(ОписаниеПлагина);
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Сохраняет данные о плагине и его контент в хранилище.
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//  Контент			- Структура - см. МенеджерПлагинов.МодельКонтент
//
// Возвращаемое значение:
//   Ссылка - ссылка на объект хранилища
//
Функция Сохранить(ОписаниеПлагина, Контент) Экспорт
	
	Отказ = (ТипЗнч(ОписаниеПлагина) <> Тип("Структура") И ТипЗнч(ОписаниеПлагина) <> Тип("ФиксированнаяСтруктура"))
			Или (ОписаниеПлагина.Свойство("Ид") = Ложь Или ОписаниеПлагина.Свойство("ТипКонтента") = Ложь);
			
	Если Отказ Тогда
		ВызватьИсключение "Невалидный контракт описания плагина";
	КонецЕсли;
	Если Не (ТипЗнч(Контент) <> Тип("Структура") Или ТипЗнч(Контент) <> Тип("ФиксированнаяСтруктура")) 
			Или Контент.Свойство("Данные") = Ложь Тогда
		ВызватьИсключение "Невалидный контракт контента";
	КонецЕсли;
	Если ТипЗнч(Контент.Данные) <> Тип("ДвоичныеДанные") Или  Контент.Данные.Размер() = 0 Тогда
		ВызватьИсключение "Отсутствуют данные для сохранения"; 
	КонецЕсли;
	
	Если ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда
		Ссылка = СохранитьВДополнительныеОбработки(ОписаниеПлагина, Контент);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда
		Ссылка = СохранитьВоВнешниеОбработки(ОписаниеПлагина, Контент);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда
		Ссылка = СохранитьВоВнешниеПечатныеФормы(ОписаниеПлагина, Контент);
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	ПриСозданииХранилищаПлагинаЗаписатьСвойства(Ссылка, ОписаниеПлагина);
	
	Возврат Ссылка;
	
КонецФункции

// Удаляет данныне плагина, помечает хранилище плагина на удаление.
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
Процедура Удалить(ОписаниеПлагина) Экспорт
	
	УдалитьПлагин(ОписаниеПлагина);
	
КонецПроцедуры

// Устанавливает состояние плагина "Включен".
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
Процедура Включить(ОписаниеПлагина) Экспорт
	
	РезультатТестирования = Протестировать(ОписаниеПлагина);
	Если РезультатТестирования.Успешно = Ложь Тогда
		ВызватьИсключение РезультатТестирования.ОписаниеОшибки;
	КонецЕсли;
	Если РезультатТестирования.ТребуетсяНастройка = Истина Тогда
		ВызватьИсключение "Необходимо настроить плагин";
	КонецЕсли;

	УстановитьСостояние(ОписаниеПлагина, _СостоянияПлагина().Включен);
	
КонецПроцедуры

// Устанавливает состояние плагина "Отключен".
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
Процедура Отключить(ОписаниеПлагина) Экспорт
	
	УстановитьСостояние(ОписаниеПлагина, _СостоянияПлагина().Отключен);
	
КонецПроцедуры

// Устанавливает состояние плагина на переданное значение.
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
// 	Состояние		- Строка 	- Значение состояния
//
Процедура УстановитьСостояние(ОписаниеПлагина, Состояние) Экспорт
	
	Контент = Контент(ОписаниеПлагина);
	ЗаписатьСвойство(Контент.Ссылка, СвойствоСостояние(), Состояние);
	
КонецПроцедуры

// Выполняет тестирование плагина.
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
// Возвращаемое значение:
//   Структура - результат тестирования и сообщения об ошибках.
//
Функция Протестировать(ОписаниеПлагина) Экспорт

	Возврат Получить(ОписаниеПлагина).ПротестироватьПлагин();
	
КонецФункции

// Возвращает манифест плагина.
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
// Возвращаемое значение:
//   Cтруктура - манифест (метаданные) плагина.
//
Функция Манифест(ОписаниеПлагина) Экспорт
	
	Возврат Получить(ОписаниеПлагина).МанифестПлагина();
	
КонецФункции

// Подключает внешнюю обработку.
//
// Параметры:
// 	АдресОбработки 	- Строка - адрес временного хранилища.
//	Имя				- Строка - Имя подключаемого плагина.
//
// Возвращаемое значение:
//   Имя внешней обработки
//
Функция ПодключитьВнешняяОбработка(АдресОбработки, Имя = Неопределено) Экспорт

	ЗащитаОтОпасныхДействий = ОписаниеЗащитыБезПредупреждений();
	
	Если ЗащитаОтОпасныхДействий = Неопределено Тогда	
		Результат = ВнешниеОбработки.Подключить(АдресОбработки, Имя, Ложь);	
	Иначе	
		Результат = ВнешниеОбработки.Подключить(АдресОбработки, Имя, Ложь, ЗащитаОтОпасныхДействий);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создаёт объект внешней обработки на основании плагина.
//
// Параметры:
//	ПолноеИмяФайла - Строка - Полное имя файла внешней обработки 
//
// Возвращаемое значение:
//   Объект внешней обработки.
//
Функция СоздатьВнешняяОбработка(ПолноеИмяФайла) Экспорт
	
	Файл = Новый Файл(ПолноеИмяФайла);
	Если Не Файл.Существует() Тогда
		ВызватьИсключение "Для загрузки, плагин должен находиться в каталоге отладки";
	КонецЕсли;
	
	ЗащитаОтОпасныхДействий = ОписаниеЗащитыБезПредупреждений(); 
	
	Если СтдСтр().ВерсияПлатформыБольшеИлиРавна("8.3.11") Или ЗащитаОтОпасныхДействий <> Неопределено Тогда
		Результат = ВнешниеОбработки.Создать(ПолноеИмяФайла, Ложь, ЗащитаОтОпасныхДействий);
	ИначеЕсли СтдСтр().ВерсияПлатформыБольшеИлиРавна("8.3.11") Или ЗащитаОтОпасныхДействий = Неопределено Тогда
		Результат = ВнешниеОбработки.Создать(ПолноеИмяФайла, Ложь);
	Иначе
		Результат = ВнешниеОбработки.Создать(ПолноеИмяФайла);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Получает настройки плагина
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
// Возвращаемое значение:
//   Произвольное значение // TODO уточнить какое значение
//
Функция НастройкиПлагина(ОписаниеПлагина) Экспорт
	
	Ссылка = Контент(ОписаниеПлагина).Ссылка;
	Если Ссылка.Пустая() Тогда
		ВызватьИсключение "Не удалось найти плагин";
	КонецЕсли;
	
	Результат = Неопределено;
	
	Если ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда		
		Результат = Ссылка.ХранилищеНастроек.Получить();	
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда	
		Если Ссылка.Принадлежность.Количество() > 0 Тогда
			Результат = Ссылка.Принадлежность[0].ДополнительныеПараметрыОбработки.Получить();
		КонецЕсли;	
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда		
		СтрокаНастроек = Ссылка.Принадлежность.Найти("Настройки", "ПредставлениеОбъекта");		
		Если Не СтрокаНастроек = Неопределено Тогда 		
			Результат = СтрокаНастроек.НастройкиПостроителяОтбор.Получить();		
		КонецЕсли;	
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сохраняет настройки плагина в хранилище
//
// Параметры:
//  ОписаниеПлагина - Структура - см. МенеджерПлагинов.МодельОписаниеПлагина
//
Процедура СохранитьНастройкиПлагина(ОписаниеПлагина, Настройки) Экспорт

	Ссылка = Контент(ОписаниеПлагина).Ссылка;
	Если Ссылка.Пустая() Тогда
		ВызватьИсключение "Не удалось найти плагин";
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	
	Если ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда		
		Объект.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);	
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда	
		Если Объект.Принадлежность.Количество() = 0 Тогда
			СтрокаНастроек = Объект.Принадлежность.Добавить();
		Иначе
			СтрокаНастроек = Объект.Принадлежность[0];
		КонецЕсли;	
		СтрокаНастроек.ДополнительныеПараметрыОбработки = Новый ХранилищеЗначения(Настройки);	
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда		
		СтрокаНастроек = Объект.Принадлежность.Найти("Настройки", "ПредставлениеОбъекта");	
		Если СтрокаНастроек = Неопределено Тогда 	
			СтрокаНастроек = Объект.Принадлежность.Добавить();
			СтрокаНастроек.ПредставлениеОбъекта = "Настройки";	
		КонецЕсли;
		СтрокаНастроек.НастройкиПостроителяОтбор = Новый ХранилищеЗначения(Настройки);	
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Объект.Записать();
	
КонецПроцедуры

// МОДЕЛИ

