//		Проект - Строка - Имя проекта, для которого нужно получитьплагины
//
Функция МодельОтборСписка() Экспорт

	Модель = Новый Структура;
	Модель.Вставить("Проект");
	
	Возврат Модель;
	
КонецФункции

// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ИзменитьСвойства(ОписаниеПлагина, НовыеЗначения) Экспорт
	
	Контент = Контент(ОписаниеПлагина);
	Для Каждого Значение Из НовыеЗначения Цикл
		
		Если Значение.Ключ = "Ид" Тогда
			КлючСвойства = "КонтурПлагин_ID";
		ИначеЕсли Значение.Ключ = "Версия" Тогда
			КлючСвойства = "КонтурПлагин_Версия";
		ИначеЕсли Значение.Ключ = "Проект" Тогда
			КлючСвойства = "КонтурПлагин_Проект";
		Иначе
			Продолжить;
		КонецЕсли;
		
		ЗаписатьСвойство(Контент.Ссылка, КлючСвойства, Значение.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

Функция _ЭтоВнешняяОбработка() Экспорт
	
	Если ЭтоВнешняяОбработкаКэш = Неопределено Тогда
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
			ЭтоВнешняяОбработкаКэш = Ложь;
		Иначе
			ЭтоВнешняяОбработкаКэш = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработкаКэш;
	
КонецФункции

Функция _СостоянияПлагина() Экспорт

	Если СостоянияПлагинаКэш = Неопределено Тогда 
		
		СостоянияПлагинаКэш = Новый Структура;
		СостоянияПлагинаКэш.Вставить("Включен", "Включен");
		СостоянияПлагинаКэш.Вставить("Отключен", "Отключен");
		СостоянияПлагинаКэш.Вставить("ТребуетсяНастройка", "Требуется настройка");
		
	КонецЕсли;
	
