	Запрос.УстановитьПараметр("Ид", ОписаниеПлагина.Ид);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = МодельХранилищаПлагина();
	Результат.Ид = ОписаниеПлагина.Ид;
	
	Если Выборка.Следующий() Тогда
		Результат.Ссылка = Выборка.Ссылка;
		Результат.Хранилище = Выборка.ХранилищеВнешнейОбработки;
		Результат.Версия = Выборка.Версия;
		Результат.Состояние = Выборка.Состояние;
		Результат.Приложение = Выборка.Проект;
	Иначе
		Результат.Ссылка = Справочники.ВнешниеОбработки.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтентВнешниеПечатныеФормы(ОписаниеПлагина)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВнешниеПечатныеФормы.Ссылка КАК Ссылка,
	|	ВнешниеПечатныеФормы.Наименование КАК Представление,
	|	ВнешниеПечатныеФормы.Хранилище КАК ХранилищеВнешнейОбработки,
	|	Ид.ИмяОбъекта КАК Ид,
	|	ВерсияПлагина.ИмяОбъекта КАК Версия,
	|	Проект.ИмяОбъекта КАК Проект,
	|	ЕСТЬNULL(Состояние.ИмяОбъекта, &СостояниеПоУмолчанию) КАК Состояние
	|ИЗ
	|	Справочник.ВнешниеПечатныеФормы КАК ВнешниеПечатныеФормы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВнешниеПечатныеФормы.Принадлежность КАК Ид
	|		ПО ВнешниеПечатныеФормы.Ссылка = Ид.Ссылка
	|			И (Ид.ПредставлениеОбъекта = &СвойствоИд)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнешниеПечатныеФормы.Принадлежность КАК ВерсияПлагина
	|		ПО ВнешниеПечатныеФормы.Ссылка = ВерсияПлагина.Ссылка
	|			И (ВерсияПлагина.ПредставлениеОбъекта = &СвойствоВерсия)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнешниеПечатныеФормы.Принадлежность КАК Проект
	|		ПО ВнешниеПечатныеФормы.Ссылка = Проект.Ссылка
	|			И (Проект.ПредставлениеОбъекта = &СвойствоПроект)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнешниеПечатныеФормы.Принадлежность КАК Состояние
	|		ПО ВнешниеПечатныеФормы.Ссылка = Состояние.Ссылка
	|			И (Состояние.ПредставлениеОбъекта = &СвойствоСостояние)
	|ГДЕ
	|	ВнешниеПечатныеФормы.ПометкаУдаления = ЛОЖЬ
	|	И Проект.ИмяОбъекта = &Проект
	|	И Ид.ИмяОбъекта = &Ид";
	
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоКонтурИд());
	Запрос.УстановитьПараметр("СвойствоВерсия", СвойствоВерсия());
	Запрос.УстановитьПараметр("СвойствоПроект", СвойствоПроект());
	Запрос.УстановитьПараметр("СвойствоСостояние", СвойствоСостояние());
	
	Запрос.УстановитьПараметр("СостояниеПоУмолчанию", _СостоянияПлагина().Включен);
	Запрос.УстановитьПараметр("Проект", ОписаниеПлагина.Проект);
	Запрос.УстановитьПараметр("Ид", ОписаниеПлагина.Ид);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = МодельХранилищаПлагина();
	Результат.Ид = ОписаниеПлагина.Ид;
	
	Если Выборка.Следующий() Тогда
		Результат.Ссылка = Выборка.Ссылка;
		Результат.Хранилище = Выборка.ХранилищеВнешнейОбработки;
		Результат.Версия = Выборка.Версия;
		Результат.Состояние = Выборка.Состояние;
		Результат.Приложение = Выборка.Проект;
	Иначе
		Результат.Ссылка = Справочники.ВнешниеПечатныеФормы.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// УДАЛИТЬ

Процедура УдалитьПлагин(ОписаниеПлагина)

	Контент = Контент(ОписаниеПлагина);
	
	Если Контент.Ссылка.Пустая() Тогда
		ВызватьИсключение "Плагин не найден в хранилище";
	КонецЕсли;
	Если Контент.Ссылка.ПометкаУдаления = Истина Тогда
		ВызватьИсключение "Плагин уже помечен на удаление";
	КонецЕсли;
	
	ОбъектХранилища = Контент.Ссылка.ПолучитьОбъект();
	ОбъектХранилища.УстановитьПометкуУдаления(Истина);
	
	Если ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда
		
		Объект = Контент.Ссылка.ПолучитьОбъект();
		Объект.Принадлежность.Очистить();
		Объект.Записать();
		
	Иначе
		
		УдалитьСвойство(Контент.Ссылка, СвойствоКонтурИд());
		УдалитьСвойство(Контент.Ссылка, СвойствоВерсия());
		УдалитьСвойство(Контент.Ссылка, СвойствоПроект());
		УдалитьСвойство(Контент.Ссылка, СвойствоСостояние());
		
	КонецЕсли;
	
КонецПроцедуры

// СВОЙСТВА

Процедура ЗаписатьСвойство(Объект, ИмяСвойства, Значение)

	Если ВариантХранилища() = ВариантыХранилища().ВнешниеПечатныеФормы Тогда
		ЗаписатьСвойствоВоВнешниеПечатныеФормы(Объект, ИмяСвойства, Значение);
	Иначе
		ЗаписатьСвойствоВРегистр(Объект, Свойство(ИмяСвойства), Значение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьСвойствоВРегистр(Объект, Свойство, Значение)

	Если ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда	
		МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();	
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда	
		МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();	
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Свойство = Свойство;
	МенеджерЗаписи.Значение = Значение;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ЗаписатьСвойствоВоВнешниеПечатныеФормы(Ссылка, Свойство, Значение)
	
	Объект = Ссылка.ПолучитьОбъект();
	Элемент = Объект.Принадлежность.Найти(Свойство, "ПредставлениеОбъекта");
	
	Если Элемент = Неопределено Тогда 	
		Элемент = Объект.Принадлежность.Добавить();	
	КонецЕсли;
	
	Элемент.ПредставлениеОбъекта = Свойство;
	Элемент.ИмяОбъекта = Значение;
	
	Объект.Записать();
	
КонецПроцедуры

Процедура УдалитьСвойство(Объект, ИмяСвойства)

	УдалитьСвойствоИзРегистр(Объект, Свойство(ИмяСвойства));
	
КонецПроцедуры

Процедура УдалитьСвойствоИзРегистр(Объект, Свойство)

	Если ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда	
		МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();	
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда	
		МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();	
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Свойство = Свойство;
	
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Удалить();
	
КонецПроцедуры

Функция Свойство(Имя)
	
	Если ВариантХранилища() = ВариантыХранилища().ДополнительныеОбработки Тогда
		Результат = СвойствоДополнительныеРеквизитыИСведения(Имя);
	ИначеЕсли ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда
		Результат = СвойствоВнешниеОбработки(Имя);
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СвойствоДополнительныеРеквизитыИСведения(Имя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Источник.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Источник
	|ГДЕ
	|	Источник.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат СоздатьСвойство(Имя);
	
КонецФункции

Функция СвойствоВнешниеОбработки(Имя)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Источник.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.СвойстваОбъектов КАК Источник
	|ГДЕ
	|	Источник.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат СоздатьСвойство(Имя);
	
КонецФункции

Функция СоздатьСвойство(Имя)

	Результат = Неопределено;
	
	Если ВариантХранилища() = ВариантыХранилища().ВнешниеОбработки Тогда
		Результат = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		Результат.НазначениеСвойства = ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочники;	
	Иначе
		Результат = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	КонецЕсли;
	
	ПятьДесятков = 50;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Имя", Имя);
	СтруктураРеквизитов.Вставить("Заголовок", Имя);
	СтруктураРеквизитов.Вставить("Наименование", Имя);
	СтруктураРеквизитов.Вставить("ИдентификаторДляФормул", Имя);
	СтруктураРеквизитов.Вставить("ТипЗначения", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(ПятьДесятков)));
	
	ЗаполнитьЗначенияСвойств(Результат, СтруктураРеквизитов); 
	
	Результат.ОбменДанными.Загрузка = Истина;
	Результат.Записать();
	
	Возврат Результат.Ссылка;
	
КонецФункции

Функция СвойствоКонтурИд()

	Возврат "КонтурПлагин_ID";
	
КонецФункции

Функция СвойствоВерсия()

	Возврат "КонтурПлагин_Версия";
	
КонецФункции

Функция СвойствоПроект()

	Возврат "КонтурПлагин_Проект";
	
КонецФункции

Функция СвойствоСостояние()

	Возврат "КонтурПлагин_Состояние";
	
КонецФункции

// ДОПОЛНИТЕЛЬНЫЕ ОБРАБОТКИ

Функция ОписаниеЗащитыБезПредупреждений()
	
	Попытка
		Результат = Новый("ОписаниеЗащитыОтОпасныхДействий");	
	Исключение	
		Результат = Неопределено;	
	КонецПопытки;
	
	Если Результат <> Неопределено Тогда
		Результат.ПредупреждатьОбОпасныхДействиях = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ПРОЧЕЕ

Функция ПодключитьПлагин(ОписаниеПлагина)
	
	Контент = Контент(ОписаниеПлагина);
	Если Контент.Ссылка.Пустая() Тогда
		ВызватьИсключение "Не удалось найти хранилище плагина";
	КонецЕсли;
	
	АдресОбработки = ПоместитьВоВременноеХранилище(Контент.Хранилище.Получить());
	
	Возврат ПодключитьВнешняяОбработка(АдресОбработки, ОписаниеПлагина.Ид);
	
КонецФункции

Функция СоздатьПлагин(ОписаниеПлагина, Каталог = Неопределено)
	
	Если ЗначениеЗаполнено(Каталог) Тогда
		ИмяФайла = СтдСтр().СтрШаблонЛок("%1%2%3", Каталог, ОписаниеПлагина.Ид, ".epf");	
	Иначе
		Контент = Контент(ОписаниеПлагина);
		Если Контент.Ссылка.Пустая() Тогда
			ВызватьИсключение "Не удалось найти хранилище плагина";
		КонецЕсли;
		// BSLLS:MissingTemporaryFileDeletion-off
		// временный файл будет удален клиентом при перезапуске
		ИмяФайла = ПолучитьИмяВременногоФайла("epf");
		// BSLLS:MissingTemporaryFileDeletion-on     
		Контент.Хранилище.Получить().Записать(ИмяФайла);
	КонецЕсли;
		
	Возврат СоздатьВнешняяОбработка(ИмяФайла);	
	
КонецФункции

Функция ВариантХранилища()
	
	Если ВариантХранилищаКэш <> Неопределено Тогда
		Возврат ВариантХранилищаКэш;
	КонецЕсли;
	
	Если ВариантХранилищаДополнительныеОтчетыИОбработки() Тогда
		ВариантХранилищаКэш = ВариантыХранилища().ДополнительныеОбработки;
	ИначеЕсли ВариантХранилищаВнешниеОбработки() Тогда
		ВариантХранилищаКэш = ВариантыХранилища().ВнешниеОбработки;
	ИначеЕсли ВариантХранилищаВнешниеПечатныеФормы() Тогда
		ВариантХранилищаКэш = ВариантыХранилища().ВнешниеПечатныеФормы;
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Возврат ВариантХранилищаКэш;
	
КонецФункции

Функция ВариантХранилищаДополнительныеОтчетыИОбработки()

	Возврат Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено
		И Метаданные.Справочники.ДополнительныеОтчетыИОбработки.Реквизиты.Найти("ХранилищеОбработки") <> Неопределено
		И Метаданные.Справочники.ДополнительныеОтчетыИОбработки.Реквизиты.Найти("ХранилищеНастроек") <> Неопределено
		И Метаданные.РегистрыСведений.Найти("ДополнительныеСведения") <> Неопределено
		И Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") <> Неопределено;
		
КонецФункции

Функция ВариантХранилищаВнешниеОбработки()

	 Возврат ВнешниеОбработкиЕстьХранилище()
		И Метаданные.РегистрыСведений.Найти("ЗначенияСвойствОбъектов") <> Неопределено
		И Метаданные.ПланыВидовХарактеристик.Найти("СвойстваОбъектов") <> Неопределено;
		
КонецФункции

Функция ВнешниеОбработкиЕстьХранилище()

	Если Метаданные.Справочники.Найти("ВнешниеОбработки") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеХранилища = Метаданные.Справочники.ВнешниеОбработки;
	Если МетаданныеХранилища.Реквизиты.Найти("ХранилищеВнешнейОбработки") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеТаблица = МетаданныеХранилища.ТабличныеЧасти;
	Возврат МетаданныеТаблица.Найти("Принадлежность") <> Неопределено
		И МетаданныеТаблица.Принадлежность.Реквизиты.Найти("ДополнительныеПараметрыОбработки") <> Неопределено;
		
КонецФункции

Функция ВариантХранилищаВнешниеПечатныеФормы()

	Если Метаданные.Справочники.Найти("ВнешниеПечатныеФормы") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеХранилища =  Метаданные.Справочники.ВнешниеПечатныеФормы;
	
	Возврат МетаданныеХранилища.Реквизиты.Найти("Хранилище") <> Неопределено
		И МетаданныеХранилища.ТабличныеЧасти.Найти("Принадлежность") <> Неопределено
		И МетаданныеХранилища.ТабличныеЧасти.Принадлежность.Реквизиты.Найти("НастройкиПостроителяОтбор") <> Неопределено;
	
КонецФункции

Функция ВариантыХранилища()
	
	Если ВариантыХранилищаКэш = Неопределено Тогда 
		
		ВариантВнешниеОбработки = 2;
		ВариантВнешниеПечатныеФормы = 3;
		
		ВариантыХранилищаКэш = Новый Структура;
		ВариантыХранилищаКэш.Вставить("ДополнительныеОбработки", 1);
		ВариантыХранилищаКэш.Вставить("ВнешниеОбработки", ВариантВнешниеОбработки);
		ВариантыХранилищаКэш.Вставить("ВнешниеПечатныеФормы", ВариантВнешниеПечатныеФормы); 
		
	КонецЕсли;
	
	Возврат ВариантыХранилищаКэш;
		
КонецФункции

Функция КаталогПлагинов()
	
	Имя = ИмяКаталогаПоУмолчанию();
	ИсточникНаименование = ОпределитьИмяСправочникаХранилищаПоВариантуХранилища(ВариантХранилища());
	
	ШаблонЗапроса = "ВЫБРАТЬ
	|	Источник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Источник
	|ГДЕ
	|	Источник.ЭтоГруппа
	|	И НЕ Источник.ПометкаУдаления
	|	И Источник.Наименование = &Наименование";
	
	Запрос = Новый Запрос();
	Запрос.Текст = СтрЗаменить(ШаблонЗапроса, "%1", ИсточникНаименование);
	Запрос.УстановитьПараметр("Наименование", Имя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда	
		Результат = Выборка.Ссылка;	
	Иначе	
		Результат = СоздатьКаталогПлагинов(ИсточникНаименование, Имя);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьКаталогПлагинов(Источник, Имя)

	Каталог = Справочники[Источник].СоздатьГруппу();
	Каталог.Наименование = Имя;
	Каталог.ОбменДанными.Загрузка = Истина;
	Каталог.Записать();
	
	Возврат Каталог.Ссылка;
		
КонецФункции

Функция ОпределитьИмяСправочникаХранилищаПоВариантуХранилища(ВариантХранилища)
	
	Если ВариантХранилища = ВариантыХранилища().ДополнительныеОбработки Тогда
		Результат = "ДополнительныеОтчетыИОбработки";
	ИначеЕсли ВариантХранилища = ВариантыХранилища().ВнешниеОбработки Тогда
		Результат = "ВнешниеОбработки";
	ИначеЕсли ВариантХранилища = ВариантыХранилища().ВнешниеПечатныеФормы Тогда
		Результат = "ВнешниеПечатныеФормы";
	Иначе
		ВызватьИсключение ОшибкаПоискаВариантаХранилища();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТолстыйКлиентОбычноеПриложение()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Результат = Истина;
	#Иначе
		Результат = Ложь;
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

Функция ИмяКаталогаПоУмолчанию()
	
	Возврат "Контур.Плагины";
	
КонецФункции

Функция МодельХранилищаПлагина()

	Модель = Новый Структура;
	Модель.Вставить("Ссылка");
	Модель.Вставить("Ид");
	Модель.Вставить("Хранилище");
	Модель.Вставить("Версия");
	Модель.Вставить("Состояние");
	Модель.Вставить("Приложение");
	
	Возврат Модель;
	
КонецФункции

Функция ОшибкаПоискаВариантаХранилища()
	
	Возврат "Не удалось определить вариант хранилища плагинов";
	
КонецФункции