&НаКлиенте
функция Метрика_НаименованиеФормы()
	Возврат "Подбор документов";
КонецФункции

&НаСервереБезКонтекста
Функция Метрика_СгруппироватьВыбранныеДокументыПоТипам(ВыбранныеДокументы)
	
	Результат = Новый Соответствие;
	
	Для Счетчик = 0 По ВыбранныеДокументы.ВГраница() Цикл
		
		ТипДокумента = ВыбранныеДокументы[Счетчик].Метаданные().Имя;
		
		КоличествоДокументовТипа = Результат.Получить(ТипДокумента);
		КоличествоДокументовТипа = ?(КоличествоДокументовТипа = Неопределено, 0, КоличествоДокументовТипа);
		
		Результат.Вставить(ТипДокумента, КоличествоДокументовТипа + 1);
		
	КонецЦикла;
	
	Возврат Результат;
	
Конецфункции


