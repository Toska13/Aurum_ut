&НаСервере
Процедура ВыполнитьСозданиеЭПЭДляКаждогоДокументаНаСервере(ДокументыОснования)
	
	ОбработкаОбъект().СоздатьПЭДляКаждогоДокумента(ДокументыОснования);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
 	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораПериода", ЭтаФорма);
 	Диалог = Новый ДиалогРедактированияСтандартногоПериода;  
    Диалог.Период = Период;
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПериода(РезультатВыбораПериода, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбораПериода <> Неопределено Тогда
		
		Период = РезультатВыбораПериода;
		
		УстановитьПараметрыСпискаДокументов();
		
		УстановитьЗаголовокКнопкиПериода();
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьЗаголовокКнопкиПериода()
	
	Элементы.ВыбратьПериод.Заголовок = ЗаголовокКнопкиВыбораПериода();
	
КонецПроцедуры

&НаКлиенте
Функция ЗаголовокКнопкиВыбораПериода()
	
	ТекстРежимОтбораПоПериоду = "по дате документа";
	
	Результат = СтруктураПериода().Представление + " " + "(" + ТекстРежимОтбораПоПериоду + ")";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтруктураПериода()
	
	ДатаНачала		 = Период.ДатаНачала;
	ДатаОкончания	 = Период.ДатаОкончания;
	
	Если ДатаОкончания < ДатаНачала Тогда
		ДатаОкончания = '00010101';
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ДатаОкончания);
	КонецЕсли;
	
	Представление = ПредставлениеПериода(ДатаНачала, ДатаОкончания);
	
	Если НЕ ЗначениеЗаполнено(Представление) Тогда
		Представление = "<период не установлен>";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня('39990101');
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаНачала",	ДатаНачала);
	Результат.Вставить("ДатаОкончания",	ДатаОкончания);
	Результат.Вставить("Представление",	Представление);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьСозданиеЗаказаЗаявки(Команда)
	
	ДокументыОснования = ДокументыКОбработке(Ложь, Истина, Ложь);
	Если ДокументыОснования.Количество() > 0 Тогда
		
		ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().СоздатьОдинЗЗ;
		Метрика_ПриВыполненииСозданияПеревозочныхДокументов(ДействиеМетрики, ДокументыОснования);
		
		Результат = Новый Структура;
		Результат.Вставить("ВидПакетаID", _КлиентскиеВызовы.ИдентификаторПакетаЗаказЗаявка()); 
		Результат.Вставить("ДокументыОснования", ДокументыОснования);
		ОповеститьОВыборе(Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПодбора(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Метрика_НаименованиеФормы", Метрика_НаименованиеФормы());
	
	ДополнительныеПараметры = Новый Структура;
	
	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеЗакрытияНастройкиПодбора", ЭтаФорма, ДополнительныеПараметры);
	
	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаНастройкиПодбораДокументов", ПараметрыФормы, ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаСервере
Функция ИмяОбработки()
	
	Возврат РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя();
	
КонецФункции

&НаКлиенте
Процедура Оповещение_ПослеЗакрытияНастройкиПодбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ИнициализироватьСписокДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;                                                  
	ВыбраннаяСтрока = Элемент.ТекущиеДанные;
	
	Если ВыбраннаяСтрока <> Неопределено Тогда
		
		Если Поле.Имя = "СписокДокументовСсылка"
			И ЗначениеЗаполнено(ВыбраннаяСтрока.Ссылка) Тогда
			
			ОткрытьВыбранныйДокумент();
						
		Иначе
			
 		   ДобавитьВыбранныйДокумент();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыбранныйДокумент()
		
	ВыделенныеСтроки = Элементы.СписокДокументов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() > 0 Тогда
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			ТекущиеДанные = Элементы.СписокДокументов.ДанныеСтроки(ИдентификаторСтроки);
			
			Если ТекущиеДанные <> Неопределено Тогда 
				ВыбранныйДокумент = ТекущиеДанные.Ссылка;
				ЕстьЭТрН = ТекущиеДанные.ЕстьЭТрН;
				ЕстьЭЗЗ = ТекущиеДанные.ЕстьЭЗЗ;
				ЕстьЭПЭ = ТекущиеДанные.ЕстьЭПЭ;
				
				Поиск = Новый Структура;
				Поиск.Вставить("Документ", ВыбранныйДокумент);
				Если СписокВыбранныхДокументов.НайтиСтроки(Поиск).Количество() = 0 Тогда
					НоваяСтрока = СписокВыбранныхДокументов.Добавить();                                   
					НоваяСтрока.Документ = ВыбранныйДокумент; 
					НоваяСтрока.ЕстьЭТрН = ЕстьЭТрН; 
					НоваяСтрока.ЕстьЭЗЗ = ЕстьЭЗЗ; 
					НоваяСтрока.ЕстьЭПЭ = ЕстьЭПЭ; 
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДокументыКОбработке(ЭтоЭТрН, ЭтоЭЗЗ, ЭтоЭПЭ)

	ДокументыОснования = Новый Массив;
	ОформленныеДокументы = Новый Массив;
	
	Если СписокВыбранныхДокументов.Количество() = 0 Тогда
		
		ВыделенныеСтроки = Элементы.СписокДокументов.ВыделенныеСтроки;
		Если ВыделенныеСтроки.Количество() > 0 Тогда
			Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
				ТекущиеДанные = Элементы.СписокДокументов.ДанныеСтроки(ИдентификаторСтроки);
				
				Если ТекущиеДанные <> Неопределено Тогда 
					ВыбранныйДокумент = ТекущиеДанные.Ссылка;
					ЕстьЭТрН = ТекущиеДанные.ЕстьЭТрН;
					ЕстьЭЗЗ = ТекущиеДанные.ЕстьЭЗЗ;
					ЕстьЭПЭ = ТекущиеДанные.ЕстьЭПЭ;
					Если ЭтоЭТрН И Не ЕстьЭТрН Тогда
						ДокументыОснования.Добавить(ВыбранныйДокумент);
					ИначеЕсли ЭтоЭТрН И ЕстьЭТрН Тогда
						ОформленныеДокументы.Добавить(ВыбранныйДокумент);
					ИначеЕсли ЭтоЭЗЗ И Не ЕстьЭЗЗ Тогда
						ДокументыОснования.Добавить(ВыбранныйДокумент);
					ИначеЕсли ЭтоЭЗЗ И ЕстьЭЗЗ Тогда
						ОформленныеДокументы.Добавить(ВыбранныйДокумент);
					ИначеЕсли ЭтоЭПЭ И Не ЕстьЭПЭ Тогда
						ДокументыОснования.Добавить(ВыбранныйДокумент);
					ИначеЕсли ЭтоЭПЭ И ЕстьЭПЭ Тогда
						ОформленныеДокументы.Добавить(ВыбранныйДокумент);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
		Для Каждого СтрокаДокумент Из СписокВыбранныхДокументов Цикл
			Если ЭтоЭТрН И Не СтрокаДокумент.ЕстьЭТрН Тогда
				ДокументыОснования.Добавить(СтрокаДокумент.Документ);
			ИначеЕсли ЭтоЭТрН И СтрокаДокумент.ЕстьЭТрН Тогда
				ОформленныеДокументы.Добавить(СтрокаДокумент.Документ);
			ИначеЕсли ЭтоЭЗЗ И Не СтрокаДокумент.ЕстьЭЗЗ Тогда
				ДокументыОснования.Добавить(СтрокаДокумент.Документ);
			ИначеЕсли ЭтоЭЗЗ И СтрокаДокумент.ЕстьЭЗЗ Тогда
				ОформленныеДокументы.Добавить(СтрокаДокумент.Документ);
			ИначеЕсли ЭтоЭПЭ И Не СтрокаДокумент.ЕстьЭПЭ Тогда
				ДокументыОснования.Добавить(СтрокаДокумент.Документ);
			ИначеЕсли ЭтоЭПЭ И СтрокаДокумент.ЕстьЭПЭ Тогда
				ОформленныеДокументы.Добавить(СтрокаДокумент.Документ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли; 
	
	Если ОформленныеДокументы.Количество() > 0 Тогда
		
		ПредставлениеДокумента = "перевозочный документ";
		Если ЭтоЭТрН Тогда
			ПредставлениеДокумента = "транспортная накладная";
		ИначеЕсли ЭтоЭЗЗ Тогда
			ПредставлениеДокумента = "заказ-заявка";
		ИначеЕсли ЭтоЭПЭ Тогда
			ПредставлениеДокумента = "поручение экспедитору";
		КонецЕсли;
		
		СтрокаОформленныхДокументов = СтрСоединитьЛок(ОформленныеДокументы, "; ");
		ТекстПредупреждения = СтрШаблонЛок(
			"На документы: %1%2%3 уже оформлен %4, уберите их из списка к офомлению!",
			Символы.ПС,
			СтрокаОформленныхДокументов,
			Символы.ПС,
			ПредставлениеДокумента
		);
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
		
		Возврат Новый Массив;
		
	ИначеЕсли ДокументыОснования.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(Неопределено, "Необходимо выбрать хотя бы один документ!");

	КонецЕсли;
	
	Возврат ДокументыОснования;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьВыбранныйДокумент()
	
	ТекущиеДанные = Элементы.СписокДокументов.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда 
		ВыбранныйДокумент = ТекущиеДанные.Ссылка;
		Платформа = Модуль_Платформа();
		Платформа.ПоказатьЗначениеЛок(ВыбранныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьПараметры()

	Если Параметры.Свойство("Период") Тогда
		Период = Параметры.Период;
	КонецЕсли;
	Если Параметры.Свойство("ОтборПоОрганизации") И ЗначениеЗаполнено(Параметры.ОтборПоОрганизации) Тогда
		ОтборОрганизация = Параметры.ОтборПоОрганизации;
	Иначе
    	ОтборОрганизация = Справочники["Организации"].ПустаяСсылка();
	КонецЕсли;
	Если Параметры.Свойство("ОтборПоКонтрагенту") И ЗначениеЗаполнено(Параметры.ОтборПоКонтрагенту)  Тогда
		ОтборКонтрагент = Параметры.ОтборПоКонтрагенту;
	Иначе
    	ОтборКонтрагент = Справочники["Контрагенты"].ПустаяСсылка();
	КонецЕсли;
	
	Если Параметры.Свойство("ДокументыОснования") Тогда
		Для Каждого ДокументОснования Из Параметры.ДокументыОснования Цикл
			НоваяСтрока = СписокВыбранныхДокументов.Добавить();
			НоваяСтрока.Документ = ДокументОснования;
		КонецЦикла;
	КонецЕсли;
	
	Если Параметры.Свойство("РежимПодбораИзЭТрН") Тогда
		РежимПодбораИзЭТрН = Параметры.РежимПодбораИзЭТрН;
	КонецЕсли;	
	Если Параметры.Свойство("РежимПодбораИзЗЗ") Тогда
		РежимПодбораИзЗЗ = Параметры.РежимПодбораИзЗЗ;
	КонецЕсли;	
	Если Параметры.Свойство("РежимПодбораИзЭПЭ") Тогда
		РежимПодбораИзЭПЭ = Параметры.РежимПодбораИзЭПЭ;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСписокДокументов()
	
	Элементы.НастройкиПодбора.ЦветФона = Новый Цвет();

	ОбработкаОбъект = ОбработкаОбъект();
	Элементы.ОтборТипДокумента.СписокВыбора.Очистить();
	
	НастройкиПодбораПоСКД = ВосстановитьНастройки("ПодборПоСКД").Настройки;
	Если НастройкиПодбораПоСКД = Неопределено Тогда
		НастройкиПодбораПоСКД = ОбработкаОбъект.НастройкиПодбораПоСКДПоУмолчанию();
	ИначеЕсли ТипЗнч(НастройкиПодбораПоСКД) = Тип("Массив") И НастройкиПодбораПоСКД.Количество() = 0 Тогда
		НастройкиПодбораПоСКД = ОбработкаОбъект.НастройкиПодбораПоСКДПоУмолчанию();
	КонецЕсли;
	
	Если НастройкиПодбораПоСКД <> Неопределено Тогда

		НовыйСКД = ОбработкаОбъект.ИнициализироватьСКД(НастройкиПодбораПоСКД);
		ТекстЗапроса = "";
		Если НовыйСКД <> Неопределено Тогда
			
			Для Каждого Набор Из НовыйСКД.НаборыДанных.ОбъединениеНаборов.Элементы Цикл
				ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", Набор.Запрос, " ОБЪЕДИНИТЬ " + СтрЗаменить(Набор.Запрос, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ"));	
			КонецЦикла;
			
		КонецЕсли; 
		
		СписокДокументов.ТекстЗапроса = ТекстЗапроса; 
		
		// Отборы
		СписокДокументов.Отбор.Элементы.Очистить();
		
		НастройкиСКД = НовыйСКД.НастройкиПоУмолчанию;  
		ГруппаОтбораВерхняя = СписокДокументов.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбораВерхняя.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;  
		
		Для Каждого СтруктураНастройкиСКД Из НастройкиПодбораПоСКД Цикл
			ИдентификаторНастройки = СтруктураНастройкиСКД.ИдентификаторНастройки;
			НастройкаСКД = СтруктураНастройкиСКД.НастройкаСКД;
			Элементы.ОтборТипДокумента.СписокВыбора.Добавить(СтруктураНастройкиСКД.МетаданныеДокумента, СтруктураНастройкиСКД.МетаданныеДокументаПредставление);
			Если НастройкаСКД <> Неопределено И ЕстьАктивныеОтборыСКД(НастройкаСКД) Тогда
				Элементы.НастройкиПодбора.ЦветФона = WebЦвета.Золотой;
				ГруппаОтбора = ГруппаОтбораВерхняя.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
				
				ЭлементыОтбора = НастройкаСКД.Отбор.Элементы;
				ОбработкаОбъект.ДобавитьОтборыСхемыКомпоновкиРекурсивно(ГруппаОтбора, ЭлементыОтбора); 
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИдентификаторНастройки");
				ЭлементОтбора.ПравоеЗначение = СокрЛП(ИдентификаторНастройки); 
				
			Иначе
				ЭлементОтбора = ГруппаОтбораВерхняя.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИдентификаторНастройки");
				ЭлементОтбора.ПравоеЗначение = СокрЛП(ИдентификаторНастройки);
			КонецЕсли;
		КонецЦикла; 
		
		УстановитьПараметрыСпискаДокументов();
		Элементы.СписокДокументов.Обновить();
		  
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьАктивныеОтборыСКД(НастройкаСКД)
	
	ЕстьАктивныеОтборы = Ложь;
	 Для Каждого СтрокаОтбора Из НастройкаСКД.Отбор.Элементы Цикл
		 Если СтрокаОтбора.Использование Тогда
			 ЕстьАктивныеОтборы = Истина;
		 КонецЕсли;
	 КонецЦикла;
	 
	 Возврат ЕстьАктивныеОтборы;
	 
КонецФункции

&НаСервере
Процедура УстановитьПараметрыСпискаДокументов()
	
	ОбработкаОбъект = ОбработкаОбъект();

	СписокДокументов.Параметры.УстановитьЗначениеПараметра("НачалоПериода", НачалоДня(Период.ДатаНачала));
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("КонецПериода", КонецДня(Период.ДатаОкончания));
	Свойство_ИдентификаторТрН = ОбработкаОбъект.ПолучитьСведениеПоИмени(ОбработкаОбъект.КлючИдентификатораТрН());
	Свойство_ИдентификаторЗЗ = ОбработкаОбъект.ПолучитьСведениеПоИмени(ОбработкаОбъект.КлючИдентификатораЗЗ());
	Свойство_ИдентификаторПЭ = ОбработкаОбъект.ПолучитьСведениеПоИмени(ОбработкаОбъект.КлючИдентификатораПЭ());
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Свойство_ИдентификаторТрН", Свойство_ИдентификаторТрН);
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Свойство_ИдентификаторЗЗ", Свойство_ИдентификаторЗЗ);
 	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Свойство_ИдентификаторПЭ", Свойство_ИдентификаторПЭ);

	УстановитьПользовательскийОтбор("Организация", ОтборОрганизация);
	УстановитьПользовательскийОтбор("Контрагент", ОтборКонтрагент);
	УстановитьПользовательскийОтбор("ТипДокумента", ОтборТипДокумента);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПользовательскийОтбор(ИмяОтбора, ЗначениеОтбора, ВидСравнения = Неопределено)
	
	Если ВидСравнения = Неопределено Тогда
		ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;

	ЭлементыОтбора = СписокДокументов.Отбор.Элементы;
	ОтборУстановлен = Ложь;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		ТипЗначенияОтбора = ТипЗнч(ЭлементОтбора); 
		Если ТипЗначенияОтбора = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если СокрЛП(ЭлементОтбора.ЛевоеЗначение) = ИмяОтбора Тогда
				ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора; 
				ЭлементОтбора.ВидСравнения = ВидСравнения;
				Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
					ЭлементОтбора.Использование = Истина;       
				Иначе
					ЭлементОтбора.Использование = Ложь;
				КонецЕсли; 
				ОтборУстановлен = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ОтборУстановлен Тогда
		ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяОтбора);
		ЭлементОтбора.ВидСравнения = ВидСравнения;
		ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
		Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			ЭлементОтбора.Использование = Истина;       
		Иначе
			ЭлементОтбора.Использование = Ложь;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	УстановитьПараметрыСпискаДокументов();
КонецПроцедуры

