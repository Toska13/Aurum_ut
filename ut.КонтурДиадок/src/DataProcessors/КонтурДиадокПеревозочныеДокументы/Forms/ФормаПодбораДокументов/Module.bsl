&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Модуль_Ядро = Модуль_Ядро();
		_ОбработкаОбъект.ИнициализироватьМодуль(Модуль_Ядро); 
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ОбщийКонтекстКлиентСервер") Тогда
		ОбщийКонтекстКлиентСервер = Параметры.ОбщийКонтекстКлиентСервер;
	КонецЕсли;
	Если Параметры.Свойство("СтрокаСписка") Тогда
		СтрокаСписка = Параметры.СтрокаСписка;
	КонецЕсли;
	
	ИнициализироватьПараметры();
	ИнициализироватьСписокДокументов();
	ВидимостьПоРежимуПодбора();
		
КонецПроцедуры

&НаСервере
Процедура ВидимостьПоРежимуПодбора()
	
	Если РежимПодбораИзЭТрН Тогда
		
		Элементы.ОтборРежимПодбора.Видимость = Ложь;
		
		Элементы.ВыполнитьСозданиеЭТрН.Видимость = Истина;
		Элементы.ВыполнитьСозданиеЭТрН.Заголовок = "Перенести в ЭТрН";
		Элементы.ВыполнитьСозданиеЭТрНДляКаждогоДокумента.Видимость = Ложь;

		Элементы.ВыполнитьСозданиеЗаказаЗаявки.Видимость = Ложь;
		Элементы.ВыполнитьСозданиеЗаказЗаявкиДляКаждогоДокумента.Видимость = Ложь;

		Элементы.ВыполнитьСозданиеЭПЭ.Видимость = Ложь;
		Элементы.ВыполнитьСозданиеЭПЭДляКаждогоДокумента.Видимость = Ложь;
		
	ИначеЕсли РежимПодбораИзЗЗ Тогда
		
		Элементы.ОтборРежимПодбора.Видимость = Ложь;
		
		Элементы.ВыполнитьСозданиеЭТрН.Видимость = Ложь;
