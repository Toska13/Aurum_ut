КонецПроцедуры

&НаКлиенте
Процедура ПеревозочныеДокументы_ПослеВыбораСценария(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда

		Модуль_Платформа = Модуль_Платформа();

		ТекущийСценарий = Результат;
		
		ДокументыОснования = ДокументыКОбработке(Истина, Ложь, Ложь);
		Если ДокументыОснования.Количество() > 0 Тогда
			
			ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().СоздатьНесколькоЭТРН;
			Метрика_ПриВыполненииСозданияПеревозочныхДокументов(ДействиеМетрики, ДокументыОснования);
			
			ВыполнитьСозданиеТрНДляКаждогоДокументаНаСервере(ДокументыОснования, ТекущийСценарий);
			
			ЭтаФорма.Закрыть(Истина);
			
		КонецЕсли;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

