&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	МодульОбъекта = ОбработкаОбъект();
	
	Если Параметры.Свойство("СсылкаНаОбъект") Тогда
		
		СсылкаНаОбъект = Параметры.СсылкаНаОбъект;
		ОпределитьТипУчастника();				
		ЗаполнитьДанныеФормы();
		
	КонецЕсли;
	
	Если Параметры.Свойство("ИмяТекущегоЭлемента") Тогда
		
		Попытка
			ЭтаФорма.ТекущийЭлемент = Элементы[Параметры.ИмяТекущегоЭлемента];
		Исключение
		КонецПопытки;
		
	КонецЕсли;
		
	Если Параметры.Свойство("ОбязательныеРеквизиты") Тогда
		
		Попытка
			Для Каждого ОбязательныйРеквизит Из Параметры.ОбязательныеРеквизиты Цикл
				Элементы[ОбязательныйРеквизит].АвтоОтметкаНезаполненного = Истина;
			КонецЦикла;
		Исключение
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура рл_Адрес_АдрИнф_АдрТекстПриИзменении(Элемент)
	
	Адреса = ПолучитьИзВременногоХранилища(ХранениеАдреса);
	Адрес = рл_Адрес_АдрИнф_АдрТекст;
	Для Каждого СтруктураАдреса Из Адреса Цикл
		Если СтруктураАдреса.Адрес = Адрес Тогда
			рл_Адрес_АдрРФ = СтруктураАдреса.ЗначениеАдреса;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть(СсылкаНаОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоСсылке(Команда)
	ОбновитьПоСсылкеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	ИнициализацияФормы();

	МодульОбъекта = ОбработкаОбъект();

	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Элементы.ОбновитьПоСсылке.Видимость = Истина; 
	Иначе
		Элементы.ОбновитьПоСсылке.Видимость = Ложь; 
	КонецЕсли;
	
	ДанныеУчастник = МодульОбъекта.ДанныеУчастника(СсылкаНаОбъект);
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеУчастник, ЭтаФорма);
	
	УстановитьСписокВыбораАдрес(ДанныеУчастник);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьТипУчастника()
	
	МодульОбъекта = ОбработкаОбъект();

	ТипКонтрагента = МодульОбъекта.ТипКонтрагента(СсылкаНаОбъект);
	
	Элементы.ГруппаИН.Видимость = Ложь;	
	Элементы.ГруппаИП.Видимость = Ложь;	
	Элементы.ГруппаФЛ.Видимость = Ложь;	
	Элементы.ГруппаЮЛ.Видимость = Ложь;	
	Если ТипКонтрагента = "ЮЛ" Тогда
		Элементы.ГруппаЮЛ.Видимость = Истина;	
	ИначеЕсли ТипКонтрагента = "ФЛ" Тогда
		Элементы.ГруппаФЛ.Видимость = Истина;	
	ИначеЕсли ТипКонтрагента = "ИП" Тогда
		Элементы.ГруппаИП.Видимость = Истина;	
	ИначеЕсли ТипКонтрагента = "ИН" Тогда
		Элементы.ГруппаИН.Видимость = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	МодульОбъекта = ОбработкаОбъект();

	УдалитьПустыеЗначенияТелефоныАдресаЭП();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма);

	ИмяМтд = СсылкаНаОбъект.Метаданные().Имя;
	Если ИмяМтд = "Организации" Тогда
		МодульОбъекта.СохранитьЗначения(СсылкаНаОбъект, ЗначенияДополнительныхСвойств, "СвУчОрг");
	Иначе
		МодульОбъекта.СохранитьЗначения(СсылкаНаОбъект, ЗначенияДополнительныхСвойств, "СвУч");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормы()

	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить(Тип("Строка"));
	ЭтаФорма.рл_Контакт_Тлф.ТипЗначения = Новый ОписаниеТипов(ДопустимыеТипы);		

	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить(Тип("Строка"));
	ЭтаФорма.рл_Контакт_ЭлПочта.ТипЗначения = Новый ОписаниеТипов(ДопустимыеТипы);		

КонецПроцедуры 

&НаСервере
Процедура УстановитьСписокВыбораАдрес(ДанныеУчастник)

	МодульОбъекта = ОбработкаОбъект();
	
	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей

	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(СсылкаНаОбъект);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));	
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;

	СписокВыбораАдрес = Элементы.рл_Адрес_АдрИнф_АдрТекст.СписокВыбора;
	СписокВыбораАдрес.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		Элементы.рл_Адрес_АдрИнф_АдрТекст.СписокВыбора.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;

	Если МодульОбъекта.ЕстьИЗаполненоСвойствоСтруктуры(ДанныеУчастник, "Адрес") Тогда
		Адрес = ДанныеУчастник.Адрес.АдрИнф.АдрТекст;
		АдресРФ = ДанныеУчастник.Адрес.АдрРФ;
		Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, АдресРФ, Адрес));
		НайденныйАдрес = СписокВыбораАдрес.НайтиПоЗначению(Адрес);
		Если НайденныйАдрес = Неопределено Тогда
			СписокВыбораАдрес.Добавить(Адрес, Адрес);
		КонецЕсли;
	КонецЕсли;
			
	ХранениеАдреса = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура УдалитьПустыеЗначенияТелефоныАдресаЭП()
	
	МассивПустыхТелефонов = Новый Массив;
	Для Каждого Телефон Из рл_Контакт_Тлф Цикл
		Если Не ЗначениеЗаполнено(Телефон.Значение) Тогда
			МассивПустыхТелефонов.Добавить(Телефон);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПустойТелефон Из МассивПустыхТелефонов Цикл
		рл_Контакт_Тлф.Удалить(ПустойТелефон);
	КонецЦикла;
	
	МассивПустыхАдресовЭП = Новый Массив;
	Для Каждого АдресЭП Из рл_Контакт_ЭлПочта Цикл
		Если Не ЗначениеЗаполнено(АдресЭП.Значение) Тогда
			МассивПустыхАдресовЭП.Добавить(АдресЭП);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПустойАдресЭП Из МассивПустыхАдресовЭП Цикл
		рл_Контакт_ЭлПочта.Удалить(ПустойАдресЭП);
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоСсылкеНаСервере()

	МодульОбъекта = ОбработкаОбъект();

	ОпределитьТипУчастника();		
	ДанныеУчастник = МодульОбъекта.ДанныеУчастника(СсылкаНаОбъект, "УчСист");
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеУчастник, ЭтаФорма);
	УстановитьСписокВыбораАдрес(ДанныеУчастник);
	
КонецПроцедуры

#КонецОбласти

