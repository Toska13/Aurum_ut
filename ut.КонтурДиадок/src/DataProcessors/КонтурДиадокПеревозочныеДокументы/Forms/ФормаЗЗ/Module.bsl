#КонецОбласти


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗаголовок();
	
	Если Параметры.Свойство("ОбщийКонтекстКлиентСервер") Тогда
		ОбщийКонтекстКлиентСервер = Параметры.ОбщийКонтекстКлиентСервер;
	КонецЕсли;
	
	Если Параметры.Свойство("СтрокаСписка") Тогда
		СтрокаСписка = Параметры.СтрокаСписка;
	КонецЕсли;
	
	Если ЭтоНовыйДокументЗЗ() Тогда
		Модифицированность = Истина;
	КонецЕсли;

	_ДокументыОснования = ОпределитьДокументыОснованияИОсновной(Параметры);

	УстановитьСписокВыбораМетодОпределенияМассы();

	МодульОбъекта = ОбработкаОбъект();

	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипОрганизации());
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвГО.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
 	Элементы.рл_СвПрв.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
  	Элементы.рл_АдрПунктОргВладИнфр.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);

	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());

	МассивТиповДоговоры = Новый Массив;
	МассивТиповДоговоры.Добавить(МодульОбъекта.СправочникТипДоговорыКонтрагентов());

	МассивТиповСотрудники = Новый Массив;
	МассивТиповСотрудники.Добавить(МодульОбъекта.СправочникТипФизическиеЛица());
	
	МассивТиповВалюта = Новый Массив;
	МассивТиповВалюта.Добавить(МодульОбъекта.СправочникТипВалюты());
	Элементы.рл_ОпГрузЦеннГруз_Валюта.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповВалюта);
	
	МассивТиповНоменклатура = Новый Массив;
	МассивТиповНоменклатура.Добавить(МодульОбъекта.СправочникТипНоменклатура());
	Элементы.рл_ОпГрузНоменклатура.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповНоменклатура);
	
	Если _ДокументыОснования.Количество() > 0 Тогда
		ЗаполнитьДокументыОснования(_ДокументыОснования);
		ЗаполнитьДанныеФормы();
	КонецЕсли;
	
	//УстановитьСписокВыбора_ПунктПод_АдрПунктПод(); 
	
	УстановитьЗаголовокГруппыДатыИВремя();
	УстановитьУсловноеОформлениеНаСервере();
	
	ИдентификаторыГО = МодульОбъекта.ИдентификаторыЭДО(рл_СвГО, Истина);
	ИдГО = ИдентификаторыГО.ID;
	ИдентификаторыПВ = МодульОбъекта.ИдентификаторыЭДО(рл_СвПрв, Ложь);
	ИдПрв = ИдентификаторыПВ.ID;
	
	РежимПереотправки = Ложь;
	
	ОпределитьЗапретРедактирования();
	ДоступностьФормы();
		
	ПроверитьЭлектроннуюЗаказЗаявку();
	ОбновитьАвтоОтметкуНезаполненногоОбязательныхПолей();
	ПоказатьОтветныйТитулЗЗ();
	
	ДопПеременные = Новый Соответствие;
	
	Если ЭтоНовыйДокументЗЗ() Тогда
		
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().СозданиеЗЗ;
		
	Иначе
		
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().ОткрытиеФормыЗЗ;
		ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве());
		
	КонецЕсли;
	
	МодульОбъекта.Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, _ДокументыОснования);
	ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторЗЗ));
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	МодульОбъекта.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
	
	Ядро = Модуль_Ядро();
	Ядро.СписокОшибок_Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьКомандФормы(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность
		И НЕ РежимПереотправки Тогда
		
		Отказ = Истина;
		Если ЗавершениеРаботы = Истина Тогда
			ТекстПредупреждения = "Настройки были изменены. Все изменения будут потеряны.";
			Возврат;
		КонецЕсли;

		Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВопросаОЗакрытии", ЭтаФорма);
		ПоказатьВопрос(Оповещение,"Настройки были изменены, ВЫЙТИ без сохранения?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВопросаОЗакрытии(РезультатВопроса,ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		ЭтаФорма.Закрыть();	
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ЗавершениеРаботы = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(СтрокаСписка);

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура рл_СвГООткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
 	Если НельзяОткрыть(рл_СвГО, "рл_СвГО") Тогда
		Возврат;	
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СсылкаНаОбъект", рл_СвГО);
	
	ДополнительныеПараметры = Новый Структура;
 	ДополнительныеПараметры.Вставить("ИмяРеквизита", "рл_СвГО");

	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаУчастника", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

