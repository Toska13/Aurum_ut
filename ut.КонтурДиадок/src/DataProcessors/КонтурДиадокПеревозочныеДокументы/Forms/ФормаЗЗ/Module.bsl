		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(НаименованиеЗначения, НаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Функция СписокВыбораСостояниеГруза()
	
	СписокВыбора = Новый СписокЗначений;

	МодульОбъекта = ОбработкаОбъект();
	Макет = МодульОбъекта.ПолучитьМакет("ЗначенияСостояниеГруза");
		
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(НаименованиеЗначения, НаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Функция СписокВыбораТипКузова()
	
	СписокВыбора = Новый СписокЗначений;

	МодульОбъекта = ОбработкаОбъект();
	Макет = МодульОбъекта.ПолучитьМакет("ЗначенияТипКузова");
		
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(НаименованиеЗначения, НаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Функция СписокВыбораАдреса(Участник, техДокОсн, ТекущиеАдрес)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей 
	
	ИсточникиАдреса = Новый Массив;
	Если ЗначениеЗаполнено(Участник) Тогда
		ИсточникиАдреса.Добавить(Участник);
	КонецЕсли;
	
 	Если ЗначениеЗаполнено(техДокОсн) Тогда
		ДанныеСклада = Новый Структура("Склад, СкладПолучатель, СкладОтправитель, СтруктурнаяЕдиница, СтруктурнаяЕдиницаПолучатель, СкладКомпании");
		ЗаполнитьЗначенияСвойств(ДанныеСклада, техДокОсн);
		Если ЗначениеЗаполнено(ДанныеСклада.Склад) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.Склад);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладПолучатель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладПолучатель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладОтправитель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладОтправитель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СтруктурнаяЕдиница) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СтруктурнаяЕдиница);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СтруктурнаяЕдиницаПолучатель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СтруктурнаяЕдиницаПолучатель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладКомпании) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладКомпании);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Источник Из ИсточникиАдреса Цикл
		
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Источник);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));	
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли; 
		КонецЦикла;
			
	КонецЦикла;
		
	ХранениеАдреса = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);
	Возврат АдресаПоПредставлению;
			
КонецФункции

#КонецОбласти


#Область ПроверкаИСтатусы

&НаСервере
Процедура ОбновитьАвтоОтметкуНезаполненногоОбязательныхПолей()
	
	МодульОбъекта = ОбработкаОбъект();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаЗЗ");
	СообщениеЗЗ = Новый Структура;
	МодульОбъекта.ЗаменитьСсылкиНаСтруктуры(СообщениеЗЗ, ЗначенияДополнительныхСвойств);
	
	ЗначениеАвтоОтметкаНезаполненногоОбязательныхПолей(Ложь);

	ПараметрыВалидации = МодульОбъекта.ВсеПараметрыВалидацииЗЗ();
	ОбязательныеРеквизитыПоФормам = МодульОбъекта.РеквизитыОбязательныхПолейПоФормам(СообщениеЗЗ, СообщениеЗЗ, ПараметрыВалидации);
	
	ЗначениеАвтоОтметкаНезаполненногоОбязательныхПолей(Истина);

КонецПроцедуры

&НаСервере
Процедура ЗначениеАвтоОтметкаНезаполненногоОбязательныхПолей(Значение)
	
	ОбязательныеРеквизиты = ОбязательныеРеквизитыФормы("ФормаТрН");
	
	Для Каждого ИмяРеквизита Из ОбязательныеРеквизиты Цикл
		Попытка
			Если ЭтоРеквизитXML(ИмяРеквизита) Тогда
				ИмяРеквизита = СтрЗаменить(ИмяРеквизита, "рл", "пр");
			КонецЕсли;
			Элементы[ИмяРеквизита].АвтоОтметкаНезаполненного = Значение;
			Если Не ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизита]) И Значение = Истина Тогда
				Элементы[ИмяРеквизита].ОтметкаНезаполненного = Истина;
			Иначе 
				Элементы[ИмяРеквизита].ОтметкаНезаполненного = Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НельзяОткрыть(ЗначениеРеквизита, ИмяРеквизита)
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита)
		И Не ЭтоРеквизитXML(ИмяРеквизита) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ОбязательныеРеквизитыФормы(ИмяФормы)
	
