#Область ОбработчикиСобытийЭлементовТаблицыФормыОшибки

&НаКлиенте
Процедура ОшибкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда
		
		ТекДанные = Элементы.Ошибки.ТекущиеДанные;
		Если СтрНайтиЛок(ЭтаФорма.ИмяФормы, ТекДанные.ИмяФормы) = 0 Тогда
			
			ОбязательныеРеквизиты = ОбязательныеРеквизитыФормы(ТекДанные.ИмяФормы);
			
			Попытка
				ЗначениеРодителя = ЭтаФорма[ТекДанные.ИмяРеквизитаРодителя];
			Исключение
				ЗначениеРодителя = Неопределено;
			КонецПопытки;
			
			Если ЗначениеРодителя <> Неопределено И ЗначениеЗаполнено(ЗначениеРодителя) Тогда
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("СсылкаНаОбъект", ЗначениеРодителя); 
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРодителя);
				ПараметрыФормы.Вставить("ИмяТекущегоЭлемента", ТекДанные.НазваниеРеквизита);
				ПараметрыФормы.Вставить("ОбязательныеРеквизиты", ОбязательныеРеквизиты);
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ИмяРеквизита", ТекДанные.ИмяРеквизитаРодителя);
				ДополнительныеПараметры.Вставить("ЗначениеРеквизита", ЗначениеРодителя);
				
				Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);
				
				_КлиентскиеВызовы.ОткрытьФормуПоИмени(ТекДанные.ИмяФормы, ПараметрыФормы, ЭтаФорма, Оповещение);

			КонецЕсли;
			
		Иначе
			
			Попытка
				ЭтаФорма.ТекущийЭлемент = Элементы[ТекДанные.НазваниеРеквизита];
			Исключение
			КонецПопытки;
				
			Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
				Элементы[ТекДанные.ИмяРеквизитаТЧ].ТекущаяСтрока = Число(ТекДанные.ИдентификаторСтроки);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекДанные.НазваниеРеквизита = "рл_СвГО"
			Или ТекДанные.НазваниеРеквизита = "рл_СвПрв" Тогда
			Если СтрНайтиЛок(ТекДанные.Представление, "ЭДО - совпадают идентификаторы") > 0 Тогда
			Иначе
				ПредложитьСопоставитьКонтрагента(ТекДанные.НазваниеРеквизита);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеЗакрытияФормыРедактирования(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ИмяРеквизита") Тогда
			Если ЭтоРеквизитXML(ДополнительныеПараметры.ИмяРеквизита) И ТипЗнч(РезультатЗакрытия) = Тип("Строка") Тогда
				ЭтаФорма[ДополнительныеПараметры.ИмяРеквизита] = РезультатЗакрытия;
				ЭтаФорма[КлючПредставление(ДополнительныеПараметры.ИмяРеквизита)] = ЗначениеПредставлениеПоСтрокеXML(РезультатЗакрытия);
			ИначеЕсли ДополнительныеПараметры.ИмяРеквизита = "рл_СвГО" Тогда	
				УстановитьСписокВыбора_ПунктПод_АдрПунктПод();
			КонецЕсли;		
		КонецЕсли;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры 

