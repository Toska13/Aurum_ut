&НаКлиенте
Процедура КомандаПроверитьЭлектроннуюЗаказЗаявку(Команда)
	
	ПредставлениеОшибокВМассивеДо = Метрики_ПредставлениеОшибокВМассиве();
	КоличествоОшибокДо = ФорматированиеЧислаСтрокой(ПредставлениеОшибокВМассивеДо.Количество());
	
	ПроверитьЭлектроннуюЗаказЗаявку();
	
	ПредставлениеОшибокВМассивеПосле = Метрики_ПредставлениеОшибокВМассиве();
	КоличествоОшибокПосле = ФорматированиеЧислаСтрокой(ПредставлениеОшибокВМассивеПосле.Количество());
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПроверитьНаНаличиеОшибок;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючИдентификатораПеревозочногоДокумента(),
		Строка(ИдентификаторЗЗ));
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючКоличествоОшибокДо(), КоличествоОшибокДо);
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючКоличествоОшибокПосле(), КоличествоОшибокПосле);
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючОшибкиПосле(), ПредставлениеОшибокВМассивеПосле);
		
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
КонецПроцедуры

&НаКлиенте
Функция ФорматированиеЧислаСтрокой(ВходящееЧисло)
	Возврат Формат(ВходящееЧисло, "ЧН=; ЧГ=");
КонецФункции

&НаКлиенте
Процедура ПодборДокументовОснования(Команда)

	ПараметрыФормы = Новый Структура;
	мДокументыОснования = Новый Массив;
	Для Каждого СтрокаОснования Из ДокументыОснования Цикл
		мДокументыОснования.Добавить(СтрокаОснования.ДокументОснование);	
	КонецЦикла;
	ПараметрыФормы.Вставить("ДокументыОснования", мДокументыОснования);
	ПараметрыФормы.Вставить("Период", Новый СтандартныйПериод(рл_ДатаЗак, ТекущаяДата()));
	ПараметрыФормы.Вставить("РежимПодбораИзЗЗ", Истина);
	
	ДополнительныеПараметры = Новый Структура;

	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеПодбораДокументовОснования", ЭтаФорма, ДополнительныеПараметры);
  	_КлиентскиеВызовы.ОткрытьФормуПодбораДокументов(ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеПодбораДокументовОснования(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено 
		И РезультатЗакрытия.ДокументыОснования.Количество() > 0 Тогда
		
		ПерезаполнитьШапку = Ложь;
		ДокументыОснования.Очистить();
		Если РезультатЗакрытия.ДокументыОснования.Найти(ОсновнойДокумент) = Неопределено Тогда
			ОсновнойДокумент = РезультатЗакрытия.ДокументыОснования[0];
			ПерезаполнитьШапку = Истина;
		КонецЕсли;
		
		Для Каждого ВыбранныйДокумент Из РезультатЗакрытия.ДокументыОснования Цикл	
			НоваяСтрока = ДокументыОснования.Добавить();
			НоваяСтрока.ДокументОснование = ВыбранныйДокумент;
			Если НоваяСтрока.ДокументОснование = ОсновнойДокумент Тогда
				НоваяСтрока.ГлавныйДокумент = Истина;	
			КонецЕсли;
		КонецЦикла;
		
		ПерезаполнитьОпГруз = Истина;
		ПерезаполнитьАдрПункт = Истина;
		ЗаполнитьДанныеФормы(ПерезаполнитьШапку, ПерезаполнитьОпГруз, ПерезаполнитьАдрПункт);
		ПроверитьЭлектроннуюЗаказЗаявку();
		Модифицированность = Истина;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДокументОсновным(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИдентификаторСтроки", Элементы.ДокументыОснования.ТекущаяСтрока);

	Оповещение = Новый ОписаниеОповещения("Оповещение_ОтветУстановитьДокументОсновным", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Установить документ основным?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ОтветУстановитьДокументОсновным(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> Неопределено Тогда
		Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
			Поиск = Новый Структура("ГлавныйДокумент", Истина);
			НашлиСтроки = ДокументыОснования.НайтиСтроки(Поиск);
			Для Каждого НашлиСтроку Из НашлиСтроки Цикл
				НашлиСтроку.ГлавныйДокумент = Ложь;
			КонецЦикла;
			ТекущиеДанные = ДокументыОснования.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
			ТекущиеДанные.ГлавныйДокумент = Истина;
			ОсновнойДокумент = ТекущиеДанные.ДокументОснование;
			ДокументыОснования.Сортировать("ГлавныйДокумент Убыв");
			Модифицированность = Истина;
		КонецЕсли;    
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИОтправитьИсходящий(Команда)
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПодписатьИОтправить;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("Resend", РежимПереотправки);
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторЗЗ));
	ДополнитьДопПеременныеИдентификаторамиУчастников(ДопПеременные);
	
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
	Если РежимПереотправки Тогда
		ПодписатьИОтправитьПовторноИсходящийДокумент();
	Иначе
		ПодписатьИОтправитьИсходящийДокумент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьДопПеременныеИдентификаторамиУчастников(ДопПеременные)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникГО = _КлиентскиеВызовы.Контракт_СтруктураУчастника(рл_СвГО, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникГО);
	
	УчастникПер = _КлиентскиеВызовы.Контракт_СтруктураУчастника(рл_СвПрв, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникПер);
	
	ЗаполнитьИдентификаторыЭДОУчастниковНаСервере(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючBoxIDГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючBoxIDПРВ(), УчастникПер.Идентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИдентификаторыЭДОУчастниковНаСервере(СтруктураУчастников)
	
	МодульОбъекта = ОбработкаОбъект();
	МодульОбъекта.ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументНаДиск(Команда)
	
	ДокументОтправлен = ДокументОтправлен();
	Если ДокументОтправлен Тогда
		Пакет = ПодготовитьПакетНаСервере();
		ВОтправленномПакетеЕстьДокумент = Пакет.Документы.Количество() > 0;
	Иначе
		ВОтправленномПакетеЕстьДокумент = Ложь;
	КонецЕсли;
	
	ДокументПакета = Неопределено;
	
	Если ВОтправленномПакетеЕстьДокумент Тогда
		
		ДокументПакета = Пакет.Документы[0];
		
		ИмяФайла = ДокументПакета.Документооборот.ХранилищеКонтента.ИмяФайла;
		ДанныеДокумента = ДокументПакета.Документооборот.ХранилищеКонтента.Данные;
		
	Иначе
		
		ЭПДСтрокой = ПодготовитьЭлектроннуюЗаказЗаявку();
		
		ИдФайлСтрокой = СтрПолучитьСтроку(ЭПДСтрокой, 2);
		ИдФайлСтроками = СтрЗаменить(ИдФайлСтрокой, """", Символы.ПС);
		
		ИмяФайла = СтрПолучитьСтроку(ИдФайлСтроками, 2) + ".xml";
		ДанныеДокумента = ЭПДСтрокой;
		
	КонецЕсли;
	
	ПараметрыКоманды = _Платформа.ПараметрыКомандыСохранитьДокументНаДиск(ИмяФайла, ДанныеДокумента);
	
	ПараметрыКоманды.КатегорияМетрики = _КлиентскиеВызовы.Метрика_НазваниеКатегории().Перевозочные;
	ПараметрыКоманды.НазваниеФормыДляМетрики = Метрика_НаименованиеФормы();
	ПараметрыКоманды.ПредставлениеМетрики = Метрика_ПредставленияМетрик().Исходящийпакет;
	ПараметрыКоманды.ДокументДляМетрики = ДокументПакета;
	
	_Платформа.СохранитьДокументНаДиск(ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПечатнуюФорму(Команда)
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПолучитьПечатнуюФорму;
	ПредставлениеМетрики = Метрика_ПредставленияМетрик().Исходящийпакет;
	
	_КлиентскиеВызовы.Метрика_ДобавитьПоведение_НажатиеКнопки(НаименованиеФормы, ДействиеМетрики, ПредставлениеМетрики);
	
	Документ = Пакет.Документы[0];
	
	ДокументОтправлен = ДокументОтправлен();
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("BoxID", Документ.Идентификаторы.BoxId);
	ДопПеременные.Вставить("DocumentType", Документ.Тип.ТипДокумента);
	
	Если ДокументОтправлен Тогда
		ДопПеременные.Вставить("LetterId", Документ.Идентификаторы.LetterId);
		ДопПеременные.Вставить("DocumentId", Документ.Идентификаторы.DocumentId);
		ДопПеременные.Вставить("Status", Документ.Статусы.Статус);
	Иначе
		ДопПеременные.Вставить("Status", Перечисление_ЛокальныеСтатусыДокумента().Подготовлен);
	КонецЕсли;
	
	КатегорияМетрики = _КлиентскиеВызовы.Метрика_НазваниеКатегории().Перевозочные;
	
	_Платформа.ПолучитьПечатнуюФормуСервераДиадок(Документ, ДопПеременные, КатегорияМетрики, ДействиеМетрики);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВДиадок(Команда)
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПерейтиВДиадок;
	Метрика_ПриВыполненииДействия(ДействиеМетрики);
	
	_Платформа.ПерейтиВДиадок(Пакет.Документы[0]);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументооборот(Команда)
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Документ = Пакет.Документы[0];
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().СохранитьДокументооборот;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("BoxID"		, Документ.Идентификаторы.BoxId);
	ДопПеременные.Вставить("LetterId"	, Документ.Идентификаторы.LetterId);
	ДопПеременные.Вставить("DocumentId", Документ.Идентификаторы.DocumentId);
	ДопПеременные.Вставить("Status", Документ.Статусы.Статус);
	
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
	_Платформа.СохранитьДокументооборот(Документ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереотправитьИсходящий(Команда)
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().Переотправить;
	Метрика_ПриВыполненииДействия(ДействиеМетрики);
	
	РежимПереотправки = Истина;
	ЗапретРедактирования = Ложь;
	
	СтрокаСписка.Статус = "";
	
	ПодготовитьЭлектроннуюЗаказЗаявку();
	НастроитьВидимостьКомандФормы();
	ДоступностьФормы();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТипКонтента_ЗаказЗаявка()
	Возврат "zakzvper";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидТитула_ЗаказЗаявка()
	Возврат "LogisticsOrderRequest";
КонецФункции

&НаКлиенте
Процедура НастроитьПараметрыПодписания(Команда)
	
	BoxId = ПолучитьBoxIdНаСервере();
	
	Если ЗначениеЗаполнено(BoxId) Тогда
		
		Модуль_Платформа = Модуль_Платформа();
		ПараметрыОткрытия = Модуль_Платформа.ПараметрыФормыРедактированияПолномочий();
		
		ПараметрыОткрытия.АдресЯщика = BoxId;
		ПараметрыОткрытия.ТипКонтента = ТипКонтента_ЗаказЗаявка();
		ПараметрыОткрытия.ПокупательПродавец = "Продавец";
		ПараметрыОткрытия.ВидТитула = ВидТитула_ЗаказЗаявка();
		
		Модуль_Платформа.ОткрытьФормуДиадокМодальноЛок(
			"РедактированиеПолномочийУправляемая",
			ЭтаФорма,
			ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Перезаполнить(Команда)
		
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеОтветаПерезаполнения", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Документ заказ-заявка будет перезаполнен. Продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры 

&НаКлиенте
Процедура Оповещение_ПослеОтветаПерезаполнения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПерезаполнитьШапку = Истина;
		ПерезаполнитьОпГруз = Истина;
		ПерезаполнитьАдрПункт = Истина;
		ЗаполнитьДанныеФормы(ПерезаполнитьШапку, ПерезаполнитьОпГруз, ПерезаполнитьАдрПункт);
		ПроверитьЭлектроннуюЗаказЗаявку();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ИнфраструктураМодуля

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Модуль_Ядро = Модуль_Ядро();
		_ОбработкаОбъект.ИнициализироватьМодуль(Модуль_Ядро); 
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Функция Модуль_Платформа() Экспорт
	Возврат _Платформа;
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте()
	
	Возврат _КлиентскиеВызовы.Модуль_ЯдроНаКлиенте();
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы, Модуль_Платформа) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	_Платформа = Модуль_Платформа;
	
КонецПроцедуры

&НаСервере
Функция Модуль_Ядро() Экспорт
	
	Если _МодульЯдроНаСервере = Неопределено Тогда
		АдресОбработкиЯдра = СвойствоСтруктуры(ОбщийКонтекстКлиентСервер, "АдресОбработкиЯдра");
		
		Если ЗначениеЗаполнено(АдресОбработкиЯдра) Тогда
			_МодульЯдроНаСервере = ХранилищеОбработки_Прочитать(АдресОбработкиЯдра);
		КонецЕсли;
	КонецЕсли;
	
	Возврат _МодульЯдроНаСервере;
	
КонецФункции

// Возвращает объект обработки из временного хранилища
//
// Параметры:
//  АдресОбработки - Строка - адрес обработки во временном хранилище
// 
// Возвращаемое значение:
//  ОбработкаОбъект - если обект обработки все еще загружен в память
//  Неопределено    - если объект обработки уже уничтожен
//
&НаСервереБезКонтекста
Функция ХранилищеОбработки_Прочитать(АдресОбработки)
	
	СтруктураОбработки = ПолучитьИзВременногоХранилища(АдресОбработки);
	
	Результат = СвойствоСтруктуры(СтруктураОбработки, "ОбработкаОбъект");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


