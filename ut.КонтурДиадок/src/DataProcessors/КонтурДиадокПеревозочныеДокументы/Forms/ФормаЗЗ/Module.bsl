&НаКлиенте
Процедура рл_ПунктПод_АдрПунктПод_Адрес_АдрИнф_АдрТекстПриИзменении(Элемент)

	Адреса = ПолучитьИзВременногоХранилища(ХранениеАдресаПодачи);
	Адрес = рл_ПунктПод_АдрПунктПод_Адрес_АдрИнф_АдрТекст;
	Для Каждого СтруктураАдреса Из Адреса Цикл
		Если СтруктураАдреса.Адрес = Адрес Тогда
			рл_ПунктПод_АдрПунктПод_Адрес_АдрРФ = СтруктураАдреса.ЗначениеАдреса;                     
		КонецЕсли;
	КонецЦикла;
	//Добавить_АдрПункт();
	ОбработатьАдрПункт();
	Модифицированность = Истина;
	
КонецПроцедуры 

Процедура ОбработатьАдрПункт()
	
	МодульОбъекта = ОбработкаОбъект();
	мДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	АдрПункт = Новый Массив;
	Для Каждого Пункт Из рл_АдрПункт Цикл
		НовыйПункт = МодульОбъекта.АдрПунктТип(); 
		ЗаполнитьЗначенияСвойств(НовыйПункт, Пункт);
		НовыйПункт.АдресПункт.Адрес.АдрИнф.АдрТекст = Пункт.АдресПункт_Адрес_АдрИнф_АдрТекст;
		НовыйПункт.АдресПункт.Адрес.АдрИнф.КодСтр = Пункт.АдресПункт_Адрес_АдрИнф_КодСтр;
		НовыйПункт.АдресПункт.Адрес.АдрРФ = Пункт.АдресПункт_Адрес_АдрРФ;
		АдрПункт.Добавить(НовыйПункт);
	КонецЦикла;

	ДанныеАдреса = Новый Структура;
	ДанныеАдреса.Вставить("Адрес", рл_ПунктПод_АдрПунктПод_Адрес_АдрИнф_АдрТекст);
	ДанныеАдреса.Вставить("АдресРФ", рл_ПунктПод_АдрПунктПод_Адрес_АдрРФ);
	ДанныеАдреса.Вставить("КодСтраны", рл_ПунктПод_АдрПунктПод_Адрес_АдрИнф_КодСтр);

	МодульОбъекта.ОбработатьАдрПункт(мДокументыОснования, АдрПункт, рл_СвГО, рл_Контрагент, ДанныеАдреса);
	
	рл_АдрПункт.Очистить();
	Для Каждого текПункт Из АдрПункт Цикл
		НовыйПункт = рл_АдрПункт.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйПункт, текПункт);
		НовыйПункт.АдресПункт_Адрес_АдрИнф_АдрТекст = текПункт.АдресПункт.Адрес.АдрИнф.АдрТекст;
		НовыйПункт.АдресПункт_Адрес_АдрИнф_КодСтр = текПункт.АдресПункт.Адрес.АдрИнф.КодСтр;
		НовыйПункт.АдресПункт_Адрес_АдрРФ = текПункт.АдресПункт.Адрес.АдрРФ;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура рл_ПарТСПрвз_ТипПогрНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

