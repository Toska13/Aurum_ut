	Если СписокВыбораВидТары = Неопределено Тогда
		СписокВыбораВидТары = СписокВыбораВидТары(); 
	КонецЕсли;
	
	ТекущиеДанные = Элементы.рл_ОпГруз.ТекущиеДанные;
	ЭлементСписка = СписокВыбораВидТары.НайтиПоЗначению(ВыбранноеЗначение);
	Если ЭлементСписка = Неопределено Тогда
		ТекущиеДанные.ВидТар = "00";
		ТекущиеДанные.ВидТарПредставление = "-";
	Иначе
		ТекущиеДанные.ВидТарПредставление = ?(ЭлементСписка.Представление = "", ЭлементСписка.Значение, ЭлементСписка.Представление);
