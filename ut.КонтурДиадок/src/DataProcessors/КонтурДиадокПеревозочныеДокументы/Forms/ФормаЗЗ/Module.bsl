&НаСервере
Процедура УстановитьЗаголовок()
	ЭтаФорма.Заголовок = "Диадок: Заказ-заявка";
КонецПроцедуры

&НаСервере
Процедура ОпределитьЗапретРедактирования()
	
	Если ТипЗнч(СтрокаСписка) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(СтрокаСписка.LetterId) Тогда
			ЗапретРедактирования = Истина;
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ДоступностьФормы()
	
	Элементы.ГруппаНомерДата.ТолькоПросмотр = ЗапретРедактирования;
	Элементы.ГруппаСтраницы.ТолькоПросмотр = ЗапретРедактирования;
	Элементы.ФормаСохранить.Доступность = Не ЗапретРедактирования; 

	Элементы.ДокументыОснованияПодборДокументовОснования.Доступность = Не ЗапретРедактирования;
	Элементы.ДокументыОснованияУстановитьДокументОсновным.Доступность = Не ЗапретРедактирования;
	Элементы.УстановитьДатуВремяПодачиТекущим.Доступность = Не ЗапретРедактирования;
	
КонецПроцедуры

#КонецОбласти


#Область ДанныеФормыИСохранение

&НаКлиенте
Процедура СохранитьЧерновик()
	
	СохранитьНаСервере();
	ПодготовитьЭлектроннуюЗаказЗаявку();
	СохранитьСтатусНаСервере();
	ПодготовитьСтрокуСпискаПоДаннымЧерновика();
	НастроитьВидимостьКомандФормы();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	
	Модифицированность = Ложь;
	
	МодульОбъекта = ОбработкаОбъект();
	
	РеквизитыЗЗ = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаЗЗ");
	_ДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	ПараметрыЗЗ = МодульОбъекта.ПараметрыЗЗ(ОсновнойДокумент, _ДокументыОснования, РеквизитыЗЗ);
 	МодульОбъекта.СохранитьЗначенияЭПД(МодульОбъекта.КлючИдентификатораЗЗ(), ИдентификаторЗЗ, МодульОбъекта.КлючРеквизитовЗЗ(), РеквизитыЗЗ, ПараметрыЗЗ);

КонецПроцедуры

&НаСервере
Процедура СохранитьСтатусНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();

	// ошибки заполняются в процессе сохранения, статус необходимо записать после сохранения и проверок.
	ЕстьОшибки = ?(Ошибки.Количество() = 0, Ложь, Истина);
	Статус = МодульОбъекта.ОпределитьСтатусЗЗ(ЕстьОшибки);
	МодульОбъекта.СохранитьСтатусТрН(ИдентификаторЗЗ, Статус);

КонецПроцедуры

&НаСервере
Процедура УдалитьНаСервере()
	
	Если ЗначениеЗаполнено(ИдентификаторЗЗ) Тогда
		
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.Удалить(МодульОбъекта.КлючИдентификатораЗЗ(), ИдентификаторЗЗ);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокГруппыДатыИВремя()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЧасовойПоясСервера  = ЧасовойПоясСеанса();
	ТекущаяДатаСервера = ТекущаяДатаСеанса();
	УниверсальнаяДата = УниверсальноеВремя(ТекущаяДатаСервера, ЧасовойПоясСервера);
	СмещениеОтUTC = СмещениеСтандартногоВремени(ЧасовойПоясСервера, УниверсальнаяДата);
	
	ЗнакСмещенияUTC = ?(СмещениеОтUTC >= 0, "+", "-");
	СмещениеОтUTCВЧасах = СмещениеОтUTC / 3600;
	СтрокаСмещениеUTC = ЗнакСмещенияUTC + Строка(СмещениеОтUTCВЧасах);
	
	СмещениеОтMSKВЧасах = СмещениеОтUTCВЧасах - 3;
	ЗнакСмещенияMSK = ?(СмещениеОтMSKВЧасах >= 0, "+", "-");
	СтрокаСмещениеMSK = ЗнакСмещенияMSK + Строка(СмещениеОтMSKВЧасах);
	
	Элементы.ДекорацияСмещение.Заголовок = МодульОбъекта.СтрШаблонЛок("MSK%1 (UTC%2)", СтрокаСмещениеMSK, СтрокаСмещениеUTC);
	Элементы.рл_АдрПунктДатВрОпер.Заголовок = МодульОбъекта.СтрШаблонЛок("%1 MSK%2 (UTC%3)", "Дата/время", СтрокаСмещениеMSK, СтрокаСмещениеUTC);
	
КонецПроцедуры

#КонецОбласти


#Область СпискиВыбора

&НаСервере
Процедура УстановитьСписокВыбора_ПунктПод_АдрПунктПод(ДанныеЗЗ = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();

	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей
	
	Грузоотправитель = ЭтаФорма.рл_СвГО;

	ИсточникиАдреса = Новый Массив;
	Если ЗначениеЗаполнено(Грузоотправитель) Тогда
		ИсточникиАдреса.Добавить(Грузоотправитель);
	КонецЕсли;
	
	Если ЭтаФорма.ОсновнойДокумент <> Неопределено Тогда
		ДанныеСклада = Новый Структура("Склад, СкладОтправитель, СтруктурнаяЕдиница, СкладКомпании");
		ЗаполнитьЗначенияСвойств(ДанныеСклада, ЭтаФорма.ОсновнойДокумент);
		Если ЗначениеЗаполнено(ДанныеСклада.Склад) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.Склад);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладОтправитель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладОтправитель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СтруктурнаяЕдиница) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СтруктурнаяЕдиница);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладКомпании) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладКомпании);
		КонецЕсли;
	КонецЕсли;

	Для Каждого Источник Из ИсточникиАдреса Цикл
		
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Источник);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));	
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли; 
		КонецЦикла;
			
	КонецЦикла;
	
	СписокВыбораАдреса = Элементы.рл_ПунктПод_АдрПунктПод_Адрес_АдрИнф_АдрТекст.СписокВыбора;
	СписокВыбораАдреса.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораАдреса.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	Если МодульОбъекта.ЕстьИЗаполненоСвойствоСтруктуры(ДанныеЗЗ, "ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст") Тогда
		Адрес = ДанныеЗЗ.ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст;
		АдресРФ = ДанныеЗЗ.ПунктПод.АдрПунктПод.Адрес.АдрРФ;
		Если ЗначениеЗаполнено(Адрес) Тогда
			Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, АдресРФ, Адрес));
			НайденныйАдрес = СписокВыбораАдреса.НайтиПоЗначению(Адрес);
			Если НайденныйАдрес = Неопределено Тогда
				СписокВыбораАдреса.Добавить(Адрес, Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ХранениеАдресаПодачи = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораМетодОпределенияМассы()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("01", "Взвешивание по общей массе (код 01)");
	СписокВыбора.Добавить("02", "Взвешивание поосно (код 02)");
