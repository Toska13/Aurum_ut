&НаКлиенте
Процедура ПредложитьСопоставитьКонтрагента(ИмяРеквизита)
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().НеСопоставленУчастник;
	Представление = "Контрагент не сопоставлен";
	_КлиентскиеВызовы.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, , Представление);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
	
	ОписаниеЗакрытияФормы = Новый ОписаниеОповещения("ОбработатьРезультатПредложенияСопоставленияКонтрагента", ЭтаФорма, ДополнительныеПараметры);
	
	ТипУчастникаБезСопоставления = СокрЛП(ТипЗнч(ЭтаФорма[ИмяРеквизита]));
	
	_КлиентскиеВызовы.ОткрытьПредложениеСопоставления(ОписаниеЗакрытияФормы, ТипУчастникаБезСопоставления);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПредложенияСопоставленияКонтрагента(РезультатПредложения, ДополнительныеПараметры) Экспорт
	
	Если РезультатПредложения = КодВозвратаДиалога.Да Тогда
		
		НачатьСопоставление(ДополнительныеПараметры.ИмяРеквизита);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСопоставление(ИмяРеквизита)

	ОписаниеЗакрытияФормы = Новый ОписаниеОповещения("ОбработатьРезультатСопоставленияКонтрагента", ЭтаФорма);
	ОтборПоКонтрагенту = ЭтаФорма[ИмяРеквизита];
	
	НужноСопоставлениеСОрганизациейДиадок = НужноСопоставлениеСОрганизациейДиадок(ИмяРеквизита);
	Если НужноСопоставлениеСОрганизациейДиадок Тогда
		
		_КлиентскиеВызовы.НачатьСопоставлениеСОрганизациейДиадок(ОтборПоКонтрагенту, ОписаниеЗакрытияФормы);
		
	Иначе
		
		ОтборПоОрганизации = ЭтаФорма["рл_Организация"];
		
		Если ЗначениеЗаполнено(ОтборПоКонтрагенту) И ЗначениеЗаполнено(ОтборПоОрганизации) Тогда
			_КлиентскиеВызовы.ОткрытьСопоставление(ОтборПоОрганизации, ОтборПоКонтрагенту, ОписаниеЗакрытияФормы);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатСопоставленияКонтрагента(РезультатСопоставления, ДополнительныеПараметры) Экспорт
	
	Если РезультатСопоставления = КодВозвратаДиалога.Да Тогда
		ПроверитьЭлектроннуюЗаказЗаявку();			
	Иначе
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьИдентификаторыЭДО(ЗначениеРеквизита, ЭтоОрганизация) 
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		МодульОбъекта = ОбработкаОбъект();
		
		ИдентификаторыЭДО = МодульОбъекта.ИдентификаторыЭДО(ЗначениеРеквизита, ЭтоОрганизация);
		ID = ИдентификаторыЭДО.ID;
		Если ЗначениеЗаполнено(ID) Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

