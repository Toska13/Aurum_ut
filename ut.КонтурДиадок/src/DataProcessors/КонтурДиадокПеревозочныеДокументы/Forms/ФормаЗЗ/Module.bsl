	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Элементы.рл_техМетОпрМасс.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


#Область ПроверкаИСтатусы

&НаСервере
Функция ПодготовитьЭлектроннуюЗаказЗаявку(УчитыватьОшибки = Истина)
	
	МодульОбъекта = ОбработкаОбъект();
	Формат = "__zzTitle1";
	ПараметрыЗЗ = Новый Структура;
	ПараметрыЗЗ.Вставить("ДанныеСотрудника", Новый Структура);
	
	Если Модифицированность Тогда 
		ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаЗЗ");
		СообщениеЗЗ = Новый Структура;
		МодульОбъекта.ЗаменитьСсылкиНаСтруктуры(СообщениеЗЗ, ЗначенияДополнительныхСвойств);
	Иначе
		мДокументыОснования = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораЗЗ(), ИдентификаторЗЗ);
		Если мДокументыОснования.Найти(ОсновнойДокумент) = Неопределено
			И ЗначениеЗаполнено(ОсновнойДокумент) Тогда
			мДокументыОснования.Добавить(ОсновнойДокумент);
		КонецЕсли;
		СообщениеЗЗ = МодульОбъекта.ПодготовитьСообщениеЗЗ(Формат, ИдентификаторЗЗ, мДокументыОснования, ПараметрыЗЗ);
	КонецЕсли;

	ЕстьОшибки = ОбработатьОшибки(МодульОбъекта, СообщениеЗЗ);
	Если ЕстьОшибки И УчитыватьОшибки Тогда
		Результат = Неопределено;
	Иначе
		Результат = МодульОбъекта.СобратьXmlПоДокументу(СообщениеЗЗ, Формат, ПараметрыЗЗ);
	КонецЕсли;                            
	
	ОпределитьСтатусДокумента(ЕстьОшибки);	

	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОпределитьСтатусДокумента(ЕстьОшибки)

	МодульОбъекта = ОбработкаОбъект();

	СтатусЛокальный = МодульОбъекта.ОпределитьСтатусЗЗ(ЕстьОшибки);
	СтатусДокумента = МодульОбъекта.СтрШаблонЛок("(%1)", СтатусЛокальный);
	
	СтатусыДоОтправки = МодульОбъекта.СтатусыДоОтправки();
	Если ТипЗнч(СтрокаСписка) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(СтрокаСписка.Статус) 
			И СтатусыДоОтправки.Найти(СтрокаСписка.Статус) = Неопределено Тогда
			СтатусДокумента = МодульОбъекта.СтрШаблонЛок("(%1 %2)", СтрокаСписка.Статус, СтрокаСписка.ДополнительныйСтатус);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Возвращает значение свойства структуры или значение по умолчанию,
// если в структуре нет такого свойства.
// 
// Параметры:
//  Структура           - Структура    - Структура, которая может содержать вложенные структуры.
//  Ключ                - Строка       - Имя ключа структуры,
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае если в структуре нет указанного свойства.
// 
// Возвращаемое значение:
//   Произвольный - Значение свойства структуры или ЗначениеПоУмолчанию,
//                  если в структуре нет такого свойства.
//
&НаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение структурой или фиксированной структурой.
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить.
// 
// Возвращаемое значение:
//   Булево - Истина, если переданое значение является структрой или фиксированной структурой.
//
&НаСервереБезКонтекста
Функция ЭтоСтруктура(Значение)
	
	Результат = Ложь;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПроверитьЭлектроннуюЗаказЗаявку()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаЗЗ");
	СообщениеЗЗ = Новый Структура;
	МодульОбъекта.ЗаменитьСсылкиНаСтруктуры(СообщениеЗЗ, ЗначенияДополнительныхСвойств);

	ЕстьОшибки = ОбработатьОшибки(МодульОбъекта, СообщениеЗЗ);

	ОпределитьСтатусДокумента(ЕстьОшибки);	
		
КонецПроцедуры

&НаСервере
Функция ОбработатьОшибки(МодульОбъекта, СообщениеЗЗ)
	
	НезаполненныеРеквизиты = Новый Массив;
	ПараметрыВалидации = МодульОбъекта.ВсеПараметрыВалидацииЗЗ();
	МодульОбъекта.ПроверитьОбязательныеПоля(СообщениеЗЗ, СообщениеЗЗ, ПараметрыВалидации, НезаполненныеРеквизиты);
	МодульОбъекта.ПроверитьИдентификаторыЭДО(СообщениеЗЗ, НезаполненныеРеквизиты, "ФормаЗЗ");
	
	Ошибки.Очистить();
	Для Каждого ПараметрыПоля Из НезаполненныеРеквизиты Цикл
		
		СтрокаСОшибкой = "";
		ИдентификаторСтроки = "";
		Если ПараметрыПоля.Свойство("НомерСтрокиОшибки") И ПараметрыПоля.НомерСтрокиОшибки > 0 Тогда
			СтрокаСОшибкой = " строка " + ПараметрыПоля.НомерСтрокиОшибки;
			ИдентификаторСтроки = ЭтаФорма[ПараметрыПоля.ИмяРеквизитаТЧ][ПараметрыПоля.НомерСтрокиОшибки-1].ПолучитьИдентификатор();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыПоля.ИмяФормы) Тогда
			НоваяСтрока = Ошибки.Добавить();
			НоваяСтрока.НазваниеРеквизита = ПараметрыПоля.НазваниеРеквизита;
			Если ПараметрыПоля.Свойство("ТекстОшибки") Тогда
				НоваяСтрока.Представление = ПараметрыПоля.ТекстОшибки;
				НоваяСтрока.НекорректноЗаполнено = Истина;
			Иначе
				НоваяСтрока.Представление = "Указать: " + ПараметрыПоля.Представление + СтрокаСОшибкой;
			КонецЕсли;
			НоваяСтрока.Действие = "Указать";
			НоваяСтрока.ИмяФормы = ПараметрыПоля.ИмяФормы;
			НоваяСтрока.ИмяРеквизитаРодителя = ПараметрыПоля.ИмяРеквизитаРодителя;
			НоваяСтрока.ИмяРеквизитаТЧ = ПараметрыПоля.ИмяРеквизитаТЧ;
			НоваяСтрока.ИндексКартинки = Истина;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			Если МодульОбъекта.СтрНайтиЛок(ЭтаФорма.ИмяФормы, ПараметрыПоля.ИмяФормы) > 0 Тогда
				Попытка
					Элементы[ПараметрыПоля.НазваниеРеквизита].АвтоОтметкаНезаполненного = Истина;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьОшибки = Ошибки.Количество() > 0;
	Если ЕстьОшибки Тогда
		Элементы.ГруппаОшибки.Видимость = Истина;
	Иначе
		Элементы.ГруппаОшибки.Видимость = Ложь;
	КонецЕсли; 
	
	Возврат ЕстьОшибки;
	
КонецФункции

#КонецОбласти


#Область ДанныеФормыИСохранение

&НаСервере
Процедура ЗаполнитьДокументыОснования(_ДокументыОснования)
	
	МодульОбъекта = ОбработкаОбъект();
	
	мДокументыОснования = Новый Массив;
	
	Для Каждого ДокументОснование Из _ДокументыОснования Цикл
		
		ИдентификаторЗЗ = МодульОбъекта.ИдентификаторЗЗ(ДокументОснование, Истина);
		Если ИдентификаторЗЗ = Неопределено Тогда
			ОснованияПоИдентификаторуЗЗ = Новый Массив;
		Иначе
			ОснованияПоИдентификаторуЗЗ = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораЗЗ(), ИдентификаторЗЗ);
		КонецЕсли;
		
		Если ОснованияПоИдентификаторуЗЗ.Количество() = 0 Тогда
			ОснованияПоИдентификаторуЗЗ.Добавить(ДокументОснование);
		КонецЕсли;
		
		Для Каждого ОснованиеПоИдентификаторуЗЗ Из ОснованияПоИдентификаторуЗЗ Цикл
			Если мДокументыОснования.Найти(ОснованиеПоИдентификаторуЗЗ) = Неопределено Тогда
				мДокументыОснования.Добавить(ОснованиеПоИдентификаторуЗЗ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Элементы.рл_АдрПункттехДокОсн.СписокВыбора.Очистить();
	Элементы.рл_ОпГрузтехДокОсн.СписокВыбора.Очистить();
	ДокументыОснования.Очистить();
	Для Каждого ДокументОснование Из мДокументыОснования Цикл
		НоваяСтрока = ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснование;
		Если ДокументОснование = ОсновнойДокумент Тогда
			НоваяСтрока.ГлавныйДокумент = Истина;	
		КонецЕсли;
		Элементы.рл_АдрПункттехДокОсн.СписокВыбора.Добавить(ДокументОснование);
		Элементы.рл_ОпГрузтехДокОсн.СписокВыбора.Добавить(ДокументОснование);
	КонецЦикла; 
	ДокументыОснования.Сортировать("ГлавныйДокумент Убыв");

	Если ИдентификаторЗЗ = Неопределено И ДокументыОснования.Количество() > 0  Тогда
		ИдентификаторЗЗ = МодульОбъекта.ИдентификаторЗЗ(ДокументыОснования[0].ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы(ПерезаполнитьШапку = Ложь, ПерезаполнитьОпГруз = Ложь, ПерезаполнитьАдрПункт = Ложь)
	
	МодульОбъекта = ОбработкаОбъект();	
	
	//первый всегда главный
	мДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");

	ДанныеЗЗ = МодульОбъекта.ДанныеЗЗ(ИдентификаторЗЗ, мДокументыОснования, ПерезаполнитьШапку, ПерезаполнитьОпГруз, ПерезаполнитьАдрПункт);
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеЗЗ, ЭтаФорма); 
	УстановитьСписокВыбора_ПунктПод_АдрПунктПод(ДанныеЗЗ);
	
КонецПроцедуры

