&НаКлиенте
Процедура ПодписатьИОтправитьИсходящийДокумент()
	
	МожноПодписатьОтправить = Ошибки.Количество() = 0;
	
	Если МожноПодписатьОтправить Тогда
		
		СохранитьЧерновик();
		
		Пакет = ПодготовитьПакетНаСервере();
		ОповещениеПослеОтправкиПакета = _Платформа.НовыйОписаниеОповещения("ПослеОтправкиПакета", ЭтаФорма);
		
		ПараметрыКоманды = _Платформа.ПараметрыКомандыДействияСПакетом(
			Пакет,
			ОповещениеПослеОтправкиПакета
		);
		
		_Платформа.ПодписатьИОтправитьИсходящийПакет(ПараметрыКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИОтправитьПовторноИсходящийДокумент()
	
	ПроверитьЭлектроннуюЗаказЗаявку();
	
	МожноПодписатьОтправить = Ошибки.Количество() = 0;
	
	Если МожноПодписатьОтправить Тогда
		
		СохранитьЧерновик();
		
		Пакет = ПодготовитьПереотправляемыйПакетНаСервере();
		ОповещениеПослеОтправкиПакета = _Платформа.НовыйОписаниеОповещения("ПослеОтправкиПакета", ЭтаФорма);
		
		ПараметрыКоманды = _Платформа.ПараметрыКомандыДействияСПакетом(
			Пакет,
			ОповещениеПослеОтправкиПакета
		);
		
		_Платформа.ПодписатьИОтправитьИсходящийПакет(ПараметрыКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПереотправляемыйПакетНаСервере()
	
	ПереотправляемыйПакет = Новый Структура;
	ПереотправляемыйПакет.Вставить("BoxId", СтрокаСписка.BoxId);
	ПереотправляемыйПакет.Вставить("LetterId", СтрокаСписка.LetterId);
	ПереотправляемыйПакет.Вставить("ПакетЭДО", СтрокаСписка.Пакет);
	
	ПодготовитьСтрокуСпискаПоДаннымЧерновика();
	
	СтрокаСписка.Пакет = Неопределено;
	СтрокаСписка.LetterId = "";
	
	Результат = ПодготовитьПакетНаСервере();
	
	ПараметрыПереотправки = Новый Структура;
	ПараметрыПереотправки.Вставить("ПереотправляемыйПакет", ПереотправляемыйПакет);
	ПараметрыПереотправки.Вставить("ВыполнитьУдалениеНеактуальныхДокументовПакета", Ложь);
	
	Результат.СлужебнаяИнформация.Вставить("ПараметрыПереотправки", ПараметрыПереотправки);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура ПоказатьОтветныйТитулЗЗ() 

	МодульОбъекта = ОбработкаОбъект();  
	Если ТипЗнч(СтрокаСписка) = Тип("Структура")
		И ЗначениеЗаполнено(СтрокаСписка.LetterId) Тогда
		ОтветныйТитул = МодульОбъекта.ПолучитьОтветныйТитулЗЗ(СтрокаСписка);
		Если ОтветныйТитул <> Неопределено Тогда
			Титул2 = ПредставлениеОтветногоТитула(ОтветныйТитул);
		КонецЕсли;
	Иначе
		Титул2 = "";
  	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеОтветногоТитула(ОтветныйТитул)
	
	МодульОбъекта = ОбработкаОбъект();  
	Результат = "";
	
	СодИнфПрв = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(ОтветныйТитул, "Документ.СодИнфПрв");
	Если СодИнфПрв = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	УИД_Зак = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(СодИнфПрв, "УИД_Зак");
	ТС =  МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(СодИнфПрв, "СвТС.ТС");
	ПредставлениеТС = "ТС: <отсутствует>";
	Если ТС <> Неопределено Тогда
		Тип = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(ТС, "ПарТС.Тип");
		Марка = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(ТС, "ПарТС.Марка");
		РегНомер = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(ТС, "РегНомер");
		ПредставлениеТС = МодульОбъекта.СтрШаблонЛок("%1: %2, %3: %4","ТС", Тип, Марка, РегНомер);
	КонецЕсли;
		
	Прицеп =  МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(СодИнфПрв, "СвТС.Прицеп");
	ПредставлениеПрицеп = "Прицеп: <отсутствует>";
	Если Прицеп <> Неопределено Тогда
		Тип = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Прицеп, "ПарТС.Тип");
		Марка = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Прицеп, "ПарТС.Марка");
		РегНомер = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Прицеп, "РегНомер");
		ПредставлениеПрицеп = МодульОбъекта.СтрШаблонЛок("%1: %2, %3: %4","Прицеп", Тип, Марка, РегНомер);
	КонецЕсли;
	
	Водитель =  МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(СодИнфПрв, "СвВодит");
	ПредставлениеВодитель = "Водитель: <отсутствует>";
	Если Водитель <> Неопределено Тогда
		СерВУ = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "СерВУ");
		НомВУ = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "НомВУ");
		ДатаВыдВУ = Формат(МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "ДатаВыдВУ"), "ДЛФ=Д");
		Тлф = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "Тлф");
		Фамилия = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "ФИО.Фамилия");
		Имя = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "ФИО.Имя");
		Отчество = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(Водитель, "ФИО.Отчество");
		ФИО = МодульОбъекта.СтрШаблонЛок("%1 %2 %3", Фамилия, Имя, Отчество);
		
		ПредставлениеВодитель = МодульОбъекта.СтрШаблонЛок("%1: %2; Тел: %3; %4Водительское удостоверение: %5 %6 от %7", "Водитель", ФИО, Тлф, Символы.ПС, СерВУ, НомВУ, ДатаВыдВУ);
	КонецЕсли;

	Результат = МодульОбъекта.СтрШаблонЛок("%1%2%3%4%5", ПредставлениеТС, Символы.ПС, ПредставлениеПрицеп, Символы.ПС, ПредставлениеВодитель);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПодготовитьСтрокуСпискаПоДаннымЧерновика()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЕстьОшибки = Ошибки.Количество() > 0;
	СтатусЗЗ = МодульОбъекта.ОпределитьСтатусЗЗ(ЕстьОшибки);
	СтатусПодготовлен = Перечисление_ЛокальныеСтатусыДокумента().Подготовлен;
	
	//Если СтатусЗЗ <> СтатусПодготовлен Тогда
	//	Возврат;
	//КонецЕсли;
	
	КлючИдентификатораЗЗ = МодульОбъекта.КлючИдентификатораЗЗ();
	
	ПараметрыПолученияЧерновиковЗЗ = Новый Структура;
	ПараметрыПолученияЧерновиковЗЗ.Вставить(КлючИдентификатораЗЗ, ИдентификаторЗЗ);
	ПараметрыПолученияЧерновиковЗЗ.Вставить("НачалоПериода", НачалоДня(рл_ДатаЗак));
	ПараметрыПолученияЧерновиковЗЗ.Вставить("КонецПериода", КонецДня(рл_ДатаЗак));
	
	ДанныеЧерновиковЗЗ = МодульОбъекта.ДанныеДляОтправкиТитуловЗаказЗаявка(ПараметрыПолученияЧерновиковЗЗ);
	
	Если ДанныеЧерновиковЗЗ[ОсновнойДокумент] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЧерновика = ДанныеЧерновиковЗЗ[ОсновнойДокумент];
	
	ВидПакетаID = МодульОбъекта.ИдентификаторПакетаЗаказЗаявка();
	ВидПакета = ОписаниеВидаПакета(ВидПакетаID);
	
	ЗаполнитьЗначенияСвойств(СтрокаСписка, ДанныеЧерновика);
	
	СтрокаСписка.Ключ = Строка(ДанныеЧерновика.ИдентификаторДокумента);
	СтрокаСписка.Направление = "Исходящее";
	СтрокаСписка.ВидПакета = ВидПакета.Наименование;
	СтрокаСписка.СодержимоеПакета = ВидПакета.Наименование;
	СтрокаСписка.Организация = ДанныеЧерновика.Грузоотправитель;
	СтрокаСписка.Контрагент = ДанныеЧерновика.Перевозчик;
	
	СлужебнаяИнформацияСтроки = СвойствоСтруктуры(СтрокаСписка, "СлужебнаяИнформация", Новый Структура);
	СлужебнаяИнформацияСтроки.Вставить(МодульОбъекта.КлючИдентификаторПеревозочногоДокумента(), Строка(ИдентификаторЗЗ));
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьКомандФормы()
	
	СтатусПодготовлен = Перечисление_ЛокальныеСтатусыДокумента().Подготовлен;
	СтатусДокументаПодготовлен = Найти(СтатусДокумента, СтатусПодготовлен) > 0;
	ДокументБезОшибок = Ошибки.Количество() = 0;
	
	Если РежимПереотправки Тогда
		ЭтоНовыйДокумент = Истина;
		ДокументОтправлен = Ложь;
	Иначе
		ЭтоНовыйДокумент = ЭтоНовыйДокументЗЗ();
		ДокументОтправлен = ДокументОтправлен();
	КонецЕсли;
	
	ДоступныеДействияПодписатьИОтправить = Ложь;
	ДоступныеДействияНастроитьПараметрыПодписания = Ложь;
	
	Если Не ЭтоНовыйДокумент И ДокументБезОшибок Тогда
	
		Пакет = ПодготовитьПакетНаСервере();
		Документ = Пакет.Документы[0];
		
		Ядро = Модуль_ЯдроНаКлиенте();
		ДоступныеДействия = Ядро.Документы_ДоступныеДействия(Документ);
		
		ДоступныеДействияПодписатьИОтправить = ДоступныеДействия.ПодписатьИОтправить;
		ДоступныеДействияНастроитьПараметрыПодписания = ДоступныеДействия.НастроитьПараметрыПодписания;
		
		Элементы.ПередатьНаСогласование.Видимость = ДоступныеДействия.ПередатьНаСогласование;
		Элементы.ПередатьНаПодпись.Видимость = ДоступныеДействия.ПередатьНаПодпись;
		Элементы.ПередатьПоМаршруту.Видимость = ДоступныеДействия.ПередатьПоМаршруту;
		Элементы.Согласовать.Видимость = ДоступныеДействия.Согласование;
		Элементы.ОтказатьВСогласовании.Видимость = ДоступныеДействия.ОтказВСогласовании;
		Элементы.КнопкаОтказатьВЗапросеПодписи.Видимость = ДоступныеДействия.ОтказВЗапросеПодписи;
		
		Элементы.ГруппаСогласованиеПередать.Видимость = ДоступныеДействия.ПередатьНаСогласование
			Или ДоступныеДействия.ПередатьНаПодпись
			Или ДоступныеДействия.ПередатьПоМаршруту;
		Элементы.ГруппаСогласованиеВердикт.Видимость = ДоступныеДействия.Согласование
			Или ДоступныеДействия.ОтказВСогласовании;
		Элементы.ГруппаСогласование.Видимость = Элементы.ГруппаСогласованиеПередать.Видимость
			Или Элементы.ГруппаСогласованиеВердикт.Видимость;
			
	Иначе
			
		Элементы.ПередатьНаСогласование.Видимость = Ложь;
		Элементы.ПередатьНаПодпись.Видимость = Ложь;
		Элементы.ПередатьПоМаршруту.Видимость = Ложь;
		Элементы.Согласовать.Видимость = Ложь;
		Элементы.ОтказатьВСогласовании.Видимость = Ложь;
		Элементы.КнопкаОтказатьВЗапросеПодписи.Видимость = Ложь;
		
		Элементы.ГруппаСогласованиеПередать.Видимость = Ложь;
		Элементы.ГруппаСогласованиеВердикт.Видимость = Ложь;
		Элементы.ГруппаСогласование.Видимость = Ложь;
		
	КонецЕсли;
	
	Элементы.ПодписатьИОтправитьИсходящий.Видимость = ДоступныеДействияПодписатьИОтправить Или РежимПереотправки;
	Элементы.НастроитьПараметрыПодписания.Видимость = ДоступныеДействияНастроитьПараметрыПодписания;
	Элементы.СохранитьДокументНаДиск.Видимость = ДокументОтправлен Или ДокументБезОшибок;
	Элементы.ПолучитьПечатнуюФорму.Видимость = ДокументОтправлен Или СтатусДокументаПодготовлен;
	Элементы.СохранитьДокументооборот.Видимость = ДокументОтправлен;
	Элементы.ПерейтиВДиадок.Видимость = ДокументОтправлен;
	Элементы.ПереотправитьИсходящий.Видимость = ДокументОтправлен;
	Элементы.ФормаСохранить.Видимость = Не ДокументОтправлен И Не РежимПереотправки;
	Элементы.ФормаВвестиЭТрН.Видимость = Не ЕстьИдентификаторЭтРнПоОснованиям();
	Элементы.Перезаполнить.Видимость = Не ДокументОтправлен;
	Элементы.ПоказатьСодержимоеДокументаXML.Видимость = Не ДокументОтправлен;
	
	Элементы.ПередатьВПодразделение.Видимость = ДокументОтправлен;
	
	Элементы.СтраницаИсторияПоДокументу.Видимость = ДокументОтправлен;
	Если ДокументОтправлен Тогда
		УстановитьВидимостьКартинкаОшибкиИсторияПоДокументу();
	КонецЕсли;
	
	УстановитьДоступностьФункцийТарифа();
	
КонецПроцедуры

&НаКлиенте
Функция ДокументОтправлен()
	
	Если ТипЗнч(СтрокаСписка) = Тип("Структура")
		И ЗначениеЗаполнено(СтрокаСписка.LetterId) Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПараметрыФормыВводаНаОсновании(СтрокаСписка)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Результат = Новый Массив;
	
	мДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	ДанныеЗЗ = МодульОбъекта.ДанныеЗЗ(ИдентификаторЗЗ, мДокументыОснования);

	ОтветныйТитул = МодульОбъекта.ПолучитьОтветныйТитулЗЗ(СтрокаСписка);
	СодИнфПрв = МодульОбъекта.ЕстьИЗначениеСвойствоСтруктуры(ОтветныйТитул, "Документ.СодИнфПрв");
	Если Не СодИнфПрв = Неопределено Тогда
		ДанныеЗЗ.Вставить("СодИнфПрв", СодИнфПрв);
	КонецЕсли;	

	мДанныеЭТрН = МодульОбъекта.ЗаполнитьЭтРн(ДанныеЗЗ);

	Для Каждого ДанныеПоОснованиюЗЗ из мДанныеЭТрН Цикл
		
		ПараметрыФормыРедактированияЭТрН = Новый Структура;

		Если ДанныеПоОснованиюЗЗ.Свойство("техДокОсн") И ЗначениеЗаполнено(ДанныеПоОснованиюЗЗ.техДокОсн) Тогда
			лДокументыОснования = ДанныеПоОснованиюЗЗ.техДокОсн;
			ПараметрыФормыРедактированияЭТрН.Вставить("ДокументыОснования", ПодобратьОснованияЭТрН(лДокументыОснования));
		Иначе
			ПараметрыФормыРедактированияЭТрН.Вставить("ДокументыОснования", ПодобратьОснованияЭТрН(мДокументыОснования));
		КонецЕсли;
		
		ПараметрыФормыРедактированияЭТрН.Вставить("ОбщийКонтекстКлиентСервер", ОбщийКонтекстКлиентСервер);
	 	ПараметрыФормыРедактированияЭТрН.Вставить("ДанныеПоОснованиюЗЗ", ДанныеПоОснованиюЗЗ);
		
		Ядро = Модуль_Ядро();
		СтрокаСпискаЭТрН = Ядро.Контракт_СтрокаСпискаДокументов();
		
	 	ПараметрыФормыРедактированияЭТрН.Вставить("СтрокаСписка", СтрокаСпискаЭТрН);
		
		Результат.Добавить(ПараметрыФормыРедактированияЭТрН);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодобратьОснованияЭТрН(мДокументыОснования)
	
	Результат = Новый Массив;
	
	Для Каждого ДокОсн Из мДокументыОснования Цикл
		
		мтд = ДокОсн.Метаданные();
		НайденныеДокументы = Новый Массив;
		
		// заказ-рту
		Если мтд.Имя = "СчетНаОплатуПокупателю" //бух, со счетом на оплату работаем только с бух.
			И Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено
			И Метаданные.Документы["РеализацияТоваровУслуг"].Реквизиты.Найти("СчетНаОплатуПокупателю") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "РеализацияТоваровУслуг", "СчетНаОплатуПокупателю");
			
		ИначеЕсли мтд.Имя = "ЗаказПокупателя" // упп
			И Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено
			И Метаданные.Документы["РеализацияТоваровУслуг"].Реквизиты.Найти("Сделка") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "РеализацияТоваровУслуг", "Сделка");

		ИначеЕсли мтд.Имя = "ЗаказКлиента" // erp
			И Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено
			И Метаданные.Документы["РеализацияТоваровУслуг"].Реквизиты.Найти("ЗаказКлиента") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "РеализацияТоваровУслуг", "ЗаказКлиента");

		ИначеЕсли мтд.Имя = "ЗаказПокупателя" // унф
			И Метаданные.Документы.Найти("РасходнаяНакладная") <> Неопределено
			И Метаданные.Документы["РасходнаяНакладная"].Реквизиты.Найти("Заказ") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "РасходнаяНакладная", "Заказ");

		ИначеЕсли мтд.Имя = "СчетНаОплатуПоставщика"
			И Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") <> Неопределено
			И Метаданные.Документы["ПоступлениеТоваровУслуг"].Реквизиты.Найти("СчетНаОплатуПоставщика") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "ПоступлениеТоваровУслуг", "СчетНаОплатуПоставщика");
			
		ИначеЕсли мтд.Имя = "ЗаказПоставщику" // упп
			И Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") <> Неопределено
			И Метаданные.Документы["ПоступлениеТоваровУслуг"].Реквизиты.Найти("Сделка") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "ПоступлениеТоваровУслуг", "Сделка");

		ИначеЕсли мтд.Имя = "ЗаказПоставщику" // erp
			И Метаданные.Документы.Найти("ПриобретениеТоваровУслуг") <> Неопределено
			И Метаданные.Документы["ПриобретениеТоваровУслуг"].Реквизиты.Найти("ЗаказПоставщику") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "ПриобретениеТоваровУслуг", "ЗаказПоставщику");

		ИначеЕсли мтд.Имя = "ЗаказПоставщику" // унф
			И Метаданные.Документы.Найти("ПриходнаяНакладная") <> Неопределено
			И Метаданные.Документы["ПриходнаяНакладная"].Реквизиты.Найти("Заказ") <> Неопределено Тогда
			
			НайденныеДокументы = НайтиДокументыПоОснованию(ДокОсн, "ПриходнаяНакладная", "Заказ");

		Иначе
			
			НайденныеДокументы = мДокументыОснования;
			
		КонецЕсли;
		
		Для Каждого Док Из НайденныеДокументы Цикл 
			Результат.Добавить(Док);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиДокументыПоОснованию(ДокОсн, ТипДокумента, РеквизитОснование)
	
	Результат = Новый Массив;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ДокументПоТипу.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + ТипДокумента + " КАК ДокументПоТипу
	|ГДЕ
	|	ДокументПоТипу." + РеквизитОснование + " = &Основание";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Основание", ДокОсн);
	РезультатЗапроса = Запрос.Выполнить();  
	Если РезультатЗапроса.Пустой() Тогда
		Результат.Добавить(ДокОсн);
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);	
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура ВвестиЭТрН(Команда)
	
	Если ЕстьИдентификаторЭтРнПоОснованиям() Тогда
		ПоказатьПредупреждение(Неопределено, "На основании заказ-заявки уже введены ЭТрН");
	Иначе	
		
		// поддержка только 1 сценария: Простая отгрузка, экспедитор агент. Отгрузка со своего склада,
		// мы подписываем документы остальные включим после поддержки диадок.апи.
		ТекущийСценарий = Новый Структура;
		ТекущийСценарий.Вставить("КтоЗаказываетПеревозку", "Мы");
		ТекущийСценарий.Вставить("МестоФактическойПогрузки", "НашСклад");
		ТекущийСценарий.Вставить("РольЭкспедитора", "ТолькоСопровождает");
		ДополнительныеПараметры = Новый Структура;
		ПеревозочныеДокументы_ПослеВыбораСценария(ТекущийСценарий, ДополнительныеПараметры); 
		
		// поддержка всех сценариев
		//Модуль_Платформа = Модуль_Платформа();
		//ДополнительныеПараметры = Новый Структура;
		//ОповещениеПослеЗакрытия = Новый ОписаниеОповещения("ПеревозочныеДокументы_ПослеВыбораСценария", ЭтаФорма, ДополнительныеПараметры);
		//ПараметрыФормы = Новый Структура;
		//Модуль_Платформа.ПеревозочныеДокументы_ОткрытьФормуВыбораСценария(ПараметрыФормы, ЭтаФорма, ОповещениеПослеЗакрытия); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревозочныеДокументы_ПослеВыбораСценария(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда

		Модуль_Платформа = Модуль_Платформа();

		ТекущийСценарий = Результат;
		
		ПараметрыФормыВводаНаОсновании = ПараметрыФормыВводаНаОсновании(СтрокаСписка);
		Для Каждого ПараметрыФормыРедактированияЭТрН из ПараметрыФормыВводаНаОсновании Цикл
			
			ПараметрыФормыРедактированияЭТрН.Вставить("Сценарий", ТекущийСценарий);
			
			ОписаниеОповещения = Неопределено;
			_КлиентскиеВызовы.ОткрытьФормуРедактированияЭТрН(ПараметрыФормыРедактированияЭТрН, ЭтаФорма.ВладелецФормы, ОписаниеОповещения);
			
		КонецЦикла;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьИдентификаторЭтРнПоОснованиям()
	
	МодульОбъекта = ОбработкаОбъект();
	//проверим главный документ
	Результат = Ложь;                 
	Если ЗначениеЗаполнено(ОсновнойДокумент) Тогда
		ИдентификаторТрН = МодульОбъекта.ИдентификаторТрН(ОсновнойДокумент, Истина); 
		Если ЗначениеЗаполнено(ИдентификаторТрН) Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура рл_ПарТСПрвз_ТипНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если СписокВыбораТипТС = Неопределено Тогда
		СписокВыбораТипТС = СписокВыбораТипТС();
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВыбораТипТС", ЭтаФорма);
	ВыполнитьНачалоВыбораИзСписка(СписокВыбораТипТС, Оповещение, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораТипТС(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		рл_ПарТСПрвз_Тип = ЗначениеВыбора.Значение;
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура рл_ПарТСПрвз_ТипАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если СписокВыбораТипТС = Неопределено Тогда
		СписокВыбораТипТС = СписокВыбораТипТС();
	КонецЕсли; 
	ВыполнитьАвтоПодбор(СписокВыбораТипТС, Текст, Элемент.ТекстРедактирования, ДанныеВыбора, СтандартнаяОбработка);

КонецПроцедуры 

&НаСервере
Функция СписокВыбораТипТС()
	
	СписокВыбора = Новый СписокЗначений;

	МодульОбъекта = ОбработкаОбъект();
	Макет = МодульОбъекта.ПолучитьМакет("ЗначенияТипТС");
		
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(НаименованиеЗначения, НаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура ПунктПод_ДатВрПодВрПриИзменении(Элемент)
	
	Если НачалоДня(рл_ПунктПод_ДатВрПод) = '00010101000000' Тогда
