Функция ДанныеОбъекта(СсылкаНаОбъект, ИмяРеквизита) Экспорт
	
	ДанныеОбъекта = Новый Структура;
	
	Если ИмяРеквизита = "ТС" Тогда
		ДанныеОбъекта = ДанныеТС(СсылкаНаОбъект, "ДопСв");
	//ИначеЕсли ИмяРеквизита = "ОснАрЛизВлад" Тогда
	//	ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "ОснАрЛиз" Тогда
		ДанныеОбъекта = ДанныеДоговора(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "Прицеп" Тогда
		ДанныеОбъекта = ДанныеТС(СсылкаНаОбъект, "ДопСв");
	ИначеЕсли ИмяРеквизита = "РекИдентГО" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "ОргВладИнфр" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "РекИдентГП" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "СвПер" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "СвПрв" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "СвГО" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "СвГП" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "СвЭксп" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "СвКлнт" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "РекИдентЗак" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "РекЛицПогрГр" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "РекВладИнф" Тогда
		ДанныеОбъекта = ДанныеУчастника(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "ИдРекСост" Тогда
		ДанныеОбъекта = ДанныеИдРекСост(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "ДогУслПер" Тогда
		ДанныеОбъекта = ДанныеДоговора(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "ОснПогрГр" Тогда
		ДанныеОбъекта = ДанныеДоговора(СсылкаНаОбъект);
	ИначеЕсли ИмяРеквизита = "ДогТрЭксп" Тогда
		ДанныеОбъекта = ДанныеДоговора(СсылкаНаОбъект, , "ФормаПЭ");
	ИначеЕсли ИмяРеквизита = "СвВодит1"
		Или ИмяРеквизита = "СвВодит2" 
		Или ИмяРеквизита = "СвВодит3" Тогда
		ДанныеОбъекта = ДанныеВодителя(СсылкаНаОбъект, "ДопСв");
	ИначеЕсли ИмяРеквизита = "РабЛицПогрГр" Тогда
		ДанныеОбъекта = ДанныеПогрузкаСотрудник(СсылкаНаОбъект);
	Иначе
		ДанныеОбъекта.Вставить("Ссылка", СсылкаНаОбъект);
	КонецЕсли;
	
	Возврат ДанныеОбъекта;

КонецФункции

Функция ДанныеТрН(ИдентификаторТрН, ДокументыОснования, ПерезаполнитьШапку = Ложь, ПерезаполнитьОпГруз = Ложь, ДанныеПоОснованиюЗЗ = Неопределено) Экспорт
	
	// ДокументыОснования отсортированы по основному, первый - основной
	// есть 3 источника данных для заполнения
	// 1. документы оснований: из основного документа заполняется шапка, ТЧ заполняется по всем документам оснований.
	// 2. сохраненные значения - значения, которые привязаны к ЭТрН (суть основной документ).
	// 3. значения по умолчанию - те значения, которые установил пользователь как по умолчанию.
	// ПерезаполнитьШапку - это смена документа основания, необходимо вообще перезаполнить данные
	
	Результат = Новый Структура();
	
	НеОбработанные = СтруктураТрН();	
	
	Если ПерезаполнитьШапку Тогда 
		
		//приоритет 1с	
		ТекстЗапроса = ТекстЗапросаТрН(ДокументыОснования);
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, ДокументыОснования, ТекстЗапроса);
		
		ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, ДокументыОснования[0], КлючРеквизитовТрН());
		ЗаполнитьНеОбработанные(Результат, НеОбработанные);
 		ЗаполнитьЗначениямиПоУмолчанию(Результат, НеОбработанные);
		
		ЭтоНовыйДокумент = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, ИдентификаторТрН, КлючРеквизитовТрН(), ДанныеПоОснованиюЗЗ);
		
	Иначе

		//приоритет доп. сведений
		ЭтоНовыйДокумент = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, ИдентификаторТрН, КлючРеквизитовТрН(), ДанныеПоОснованиюЗЗ);
		Если ЭтоНовыйДокумент Тогда   
			
			ТекстЗапроса = ТекстЗапросаТрН(ДокументыОснования);
			ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, ДокументыОснования, ТекстЗапроса);
			
			ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, ДокументыОснования[0], КлючРеквизитовТрН());
			ЗаполнитьНеОбработанные(Результат, НеОбработанные);
			ЗаполнитьЗначениямиПоУмолчанию(Результат, НеОбработанные);
			
		Иначе
			
			ЗаполнитьНеОбработанные(Результат, НеОбработанные);
			ЗаполнитьЗначениямиПоУмолчанию(Результат, НеОбработанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//ЭтоНовыйДокумент = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, ИдентификаторТрН, КлючРеквизитовТрН(), ДанныеПоОснованиюЗЗ);
	//
	//Если ЭтоНовыйДокумент Или ПерезаполнитьШапку Тогда   
	//	//приоритет доп. сведений
	//			
	//	ТекстЗапроса = ТекстЗапросаТрН(ДокументыОснования);
	//	ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, ДокументыОснования, ТекстЗапроса);
	//	
	//	ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, ДокументыОснования[0], КлючРеквизитовТрН());
	//	ЗаполнитьНеОбработанные(Результат, НеОбработанные);
	//	ЗаполнитьЗначениямиПоУмолчанию(Результат, НеОбработанные);
	//			
	//Иначе
	//	
	//	ЗаполнитьНеОбработанные(Результат, НеОбработанные);
	//	ЗаполнитьЗначениямиПоУмолчанию(Результат, НеОбработанные);
	//	
	//КонецЕсли;
	
	Если ЭтоНовыйДокумент Или ПерезаполнитьОпГруз Тогда
		Если ДанныеПоОснованиюЗЗ <> Неопределено Тогда
			ОбработатьОпГрузТрН(ДокументыОснования, Результат, "ДопСв");
		Иначе
			ОбработатьОпГрузТрН(ДокументыОснования, Результат, "УчСис");
		КонецЕсли;
	Иначе
		ПривестиКФорматуОпГрузТрН(Результат);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеЗЗ(ИдентификаторЗЗ, ДокументыОснования, ПерезаполнитьШапку = Ложь, ПерезаполнитьОпГруз = Ложь, ПерезаполнитьАдрПункт = Ложь) Экспорт

	// ДокументыОснования отсортированы по основному, первый - основной
	// есть 3 источника данных для заполнения
	// 1. документы оснований: из основного документа заполняется шапка, ТЧ заполняется по всем документам оснований.
	// 2. сохраненные значения - значения, которые привязаны к ЭТрН (суть основной документ).
	// 3. значения по умолчанию - те значения, которые установил пользователь как по умолчанию.
	
	Результат = Новый Структура();
	
	НеОбработанные = СтруктураЗЗ();	

	ЭтоНовыйДокумент = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, ИдентификаторЗЗ, КлючРеквизитовЗЗ());
		
	Если ЭтоНовыйДокумент Или ПерезаполнитьШапку Тогда   
		
		ТекстЗапроса = ТекстЗапросаЗЗ(ДокументыОснования);
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, ДокументыОснования, ТекстЗапроса); // заполняет не пустыми значениями.
		//ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, ДокументыОснования[0], КлючРеквизитовЗЗ());	
		ЗаполнитьНеОбработанные(Результат, НеОбработанные);
		ЗаполнитьЗначениямиПоУмолчаниюЗЗ(Результат, НеОбработанные);
		
	Иначе

		ЗаполнитьНеОбработанные(Результат, НеОбработанные);
		ЗаполнитьЗначениямиПоУмолчаниюЗЗ(Результат, НеОбработанные);
		
	КонецЕсли;

	
	Если ЭтоНовыйДокумент Или ПерезаполнитьОпГруз Тогда   
		ОбработатьОпГрузЗЗ(ДокументыОснования, Результат, "УчСис");
	Иначе
		ПривестиКФорматуОпГрузЗЗ(Результат);	
	КонецЕсли;
	
	Если ЭтоНовыйДокумент Или ПерезаполнитьАдрПункт Тогда
		
		Если ЕстьИЗаполненоСвойствоСтруктуры(Результат, "ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст") Тогда
			ДанныеАдреса = СтруктураАдреса();
			ДанныеАдреса.Вставить("Адрес", ЕстьИЗначениеСвойствоСтруктуры(Результат, "ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст"));
			ДанныеАдреса.Вставить("АдресРФ", ЕстьИЗначениеСвойствоСтруктуры(Результат, "ПунктПод.АдрПунктПод.Адрес.АдрРФ"));
			ДанныеАдреса.Вставить("АдресКодСтраны", "643");
		Иначе
			ДанныеАдреса = Неопределено;
		КонецЕсли; 
		
		ОбработатьАдрПункт(ДокументыОснования, Результат.АдрПункт, Результат.СвГО, Результат.Контрагент, ДанныеАдреса);

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеПЭ(ИдентификаторПЭ, ДокументыОснования, ПерезаполнитьШапку = Ложь, ПерезаполнитьОпГруз = Ложь) Экспорт
	
	// ДокументыОснования отсортированы по основному, первый - основной
	// есть 3 источника данных для заполнения
	// 1. документы оснований: из основного документа заполняется шапка, ТЧ заполняется по всем документам оснований.
	// 2. сохраненные значения - значения, которые привязаны к ЭПЭ (суть основной документ).
	// 3. значения по умолчанию - те значения, которые установил пользователь как по умолчанию.
	// ПерезаполнитьШапку - это смена документа основания, необходимо вообще перезаполнить данные
	
	Результат = Новый Структура();
	
	НеОбработанные = СтруктураПЭ();	
	
	Если ПерезаполнитьШапку Тогда 
		
		//приоритет 1с	
		ТекстЗапроса = ТекстЗапросаПЭ(ДокументыОснования);
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, ДокументыОснования, ТекстЗапроса);
		
		//ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, ДокументыОснования[0], КлючРеквизитовПЭ());
		ЗаполнитьНеОбработанные(Результат, НеОбработанные);
 		ЗаполнитьЗначениямиПоУмолчаниюПЭ(Результат, НеОбработанные);
		
		ЭтоНовыйДокумент = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, ИдентификаторПЭ, КлючРеквизитовПЭ());
		
	Иначе

		//приоритет доп. сведений
		ЭтоНовыйДокумент = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, ИдентификаторПЭ, КлючРеквизитовПЭ());
		Если ЭтоНовыйДокумент Тогда   
			
			ТекстЗапроса = ТекстЗапросаПЭ(ДокументыОснования);
			ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, ДокументыОснования, ТекстЗапроса);
			
			//ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, ДокументыОснования[0], КлючРеквизитовПЭ());
			ЗаполнитьНеОбработанные(Результат, НеОбработанные);
			ЗаполнитьЗначениямиПоУмолчаниюПЭ(Результат, НеОбработанные);
			
		Иначе
			
			ЗаполнитьНеОбработанные(Результат, НеОбработанные);
			ЗаполнитьЗначениямиПоУмолчаниюПЭ(Результат, НеОбработанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДокументыОснования.Количество() > 0 Тогда
		УстановитьЗначениеСвойстваСтруктуры(Результат, "СвГруз.ИдентПартГруз", Строка(ДокументыОснования[0].УникальныйИдентификатор()));
	КонецЕсли;
	
	Если ЭтоНовыйДокумент Или ПерезаполнитьОпГруз Тогда
		ОбработатьОпГрузПЭ(ДокументыОснования, Результат, "УчСис");
	Иначе
		ПривестиКФорматуОпГрузПЭ(Результат);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьОпГрузЗЗ(ДокументыОснования, Результат, Приоритет)
	
	//необхдимо задать приритетность, либо допсв либо учСист
	мРезультат = Новый Массив;
	ОпГруз = Результат.ОпГруз;
	КолМестПрием = 0;
	МасБрутОтгр = 0;
	
	ОпГрузТип = ОпГрузТипЗЗ();
	ОбщаяТаблицаТоваров = ДанныеТоварыДокументов(ДокументыОснования, ОпГрузТип);
	СписокКолонок = ОбщаяТаблицаТоваров.Колонки;
	
	Если Приоритет = "УчСис" Тогда
		
		Для Каждого СтрокаТовара Из ОбщаяТаблицаТоваров Цикл
			
			Сведение = ОпГрузТипЗЗ();
			
			Для Каждого Груз Из ОпГруз Цикл
				Если Груз.Номенклатура = СтрокаТовара.Номенклатура Тогда
					ЗаполнитьЗначенияСвойств(Сведение, Груз); //заполнение из доп. свойств
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Колонка Из СписокКолонок Цикл
				УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТовара[Колонка.Имя]);
			КонецЦикла;
			
			мРезультат.Добавить(Сведение);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Груз Из ОпГруз Цикл
			Сведение = ОпГрузТипЗЗ();
			Для Каждого СтрокаТовара Из ОбщаяТаблицаТоваров Цикл
				Если Груз.Номенклатура = СтрокаТовара.Номенклатура Тогда
					Для Каждого Колонка Из СписокКолонок Цикл
						УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТовара[Колонка.Имя]);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла; 
			Для Каждого КлючЗначение Из Груз Цикл
				Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					Сведение.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЕсли;
			КонецЦикла;

			мРезультат.Добавить(Сведение);

		КонецЦикла;
			
	КонецЕсли;
	
	Для Каждого Сведение Из мРезультат Цикл
				
		Если Сведение.Свойство("СостГруз")
			И Не ЗначениеЗаполнено(Сведение.СостГруз) Тогда
			Сведение.СостГруз = "упаковка не нарушена";
		КонецЕсли;
		
		Если ЕстьСвойствоСтруктуры(Сведение, "ЦеннГруз.Валюта")
			И (Не ЗначениеЗаполнено(Сведение.ЦеннГруз.Валюта) 
			Или ТипЗнч(Сведение.ЦеннГруз.Валюта) = Тип("Строка")) Тогда
			Сведение.ЦеннГруз.Валюта = Справочники["Валюты"].НайтиПоКоду(643); //рубль по умолчанию
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Сведение.ВидТар) Тогда
			Сведение.ВидТар = "00";
			Сведение.ВидТарПредставление = "не указан";
		КонецЕсли;
		
		КолМестПрием = КолМестПрием + Сведение.КолГрМест;
		МасБрутЗнач = ЕстьИЗначениеСвойствоСтруктуры(Сведение, "МасГруз.МасБрутЗнач", 0);
		МасБрутОтгр = МасБрутОтгр + МасБрутЗнач;
		
	КонецЦикла;
	
	Результат.техКолГрМест = КолМестПрием;
	Результат.техМасБрутЗнач = МасБрутОтгр;

	Результат.Вставить("ОпГруз", мРезультат);
	
КонецПроцедуры
                           
Процедура ОбработатьОпГрузТрН(ДокументыОснования, Результат, Приоритет)
	
	//необхдимо задать приритетность, либо допсв либо учСист
