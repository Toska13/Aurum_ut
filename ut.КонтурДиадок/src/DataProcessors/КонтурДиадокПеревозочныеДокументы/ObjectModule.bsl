	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИныеУслв", ЗЗСтруктура, "ИныеУслв");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ПрвзПищПрод", ЗЗСтруктура, "ПрвзПищПрод", "Отсутствуют");
	
