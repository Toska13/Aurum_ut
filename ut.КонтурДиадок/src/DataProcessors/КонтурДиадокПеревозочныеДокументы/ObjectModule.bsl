Функция ИдентификаторТрН(СсылкаНаОбъект, Поиск = Ложь) Экспорт
	
	Результат = ПолучитьЗначениеСведения(СсылкаНаОбъект, КлючИдентификатораТрН(), Ложь);
	
	Если Не ЗначениеЗаполнено(Результат) И Не Поиск Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ИдентификаторТрН = Строка(Новый УникальныйИдентификатор);
		
		НовоеЗначение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
		НовоеЗначение.Владелец = ПолучитьСведениеПоИмени(КлючИдентификатораТрН());
		НовоеЗначение.Наименование = ИдентификаторТрН;
		Если НовоеЗначение.Метаданные().Реквизиты.Найти("ПолноеНаименование") <> Неопределено Тогда
			НовоеЗначение.ПолноеНаименование = ИдентификаторТрН;                                                           
		КонецЕсли;
		НовоеЗначение.Записать();
		
		Если ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		Результат = НовоеЗначение.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
