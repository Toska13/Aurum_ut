Процедура ЗаполнитьСписокXDTO_СвОпГруз(СписокXDTO, ДанныеГруза)

	СведенияОбОпасныхГрузах = ДанныеГруза.СвОпГруз;
	
	Для Каждого СведениеОбОпасномГрузе Из СведенияОбОпасныхГрузах Цикл
		
		//обязательные поля
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO); 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НПА", СведениеОбОпасномГрузе, "НПА"); //ПЭ
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НомООН", СведениеОбОпасномГрузе, "НомООН");
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ИдОпаснООН", СведениеОбОпасномГрузе, "НомООН"); //ПЭ
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НадОтгНаим", СведениеОбОпасномГрузе, "НадОтгНаим");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Клас", СведениеОбОпасномГрузе, "Клас");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КлассОпасн", СведениеОбОпасномГрузе, "Клас"); //ПЭ
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КласКод", СведениеОбОпасномГрузе, "КласКод");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ГрУп", СведениеОбОпасномГрузе, "ГрУп");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ЗнОп", СведениеОбОпасномГрузе, "ЗнОп");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КодОгрЧерТун", СведениеОбОпасномГрузе, "КодОгрЧерТун");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ТехНаим", СведениеОбОпасномГрузе, "ТехНаим");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Описание", СведениеОбОпасномГрузе, "Описание");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НазРадионук", СведениеОбОпасномГрузе, "НазРадионук");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОписФизХимФорм", СведениеОбОпасномГрузе, "ОписФизХимФорм");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "МаксАкт", СведениеОбОпасномГрузе, "МаксАкт");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КатУпак", СведениеОбОпасномГрузе, "КатУпак");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ТрансИндекс", СведениеОбОпасномГрузе, "ТрансИндекс");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ИндексБез", СведениеОбОпасномГрузе, "ИндексБез");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОпозЗнак", СведениеОбОпасномГрузе, "ОпозЗнак");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ПолнАктГр", СведениеОбОпасномГрузе, "ПолнАктГр");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОбМасНетВзрСод", СведениеОбОпасномГрузе, "ОбМасНетВзрСод"); //ЭТрН
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОбМасНетВзрСодВсех", СведениеОбОпасномГрузе, "ОбМасНетВзрСодВсех"); //ЭТрН
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ПроцСмеси", СведениеОбОпасномГрузе, "ПроцСмеси"); //ЭТрН
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КонтТемпер", СведениеОбОпасномГрузе, "КонтТемпер");
