Процедура ПараметрыВалидацииПЭ(Результат, Префикс = "")
	
	ИмяФормы = "ФормаПЭ";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомерДок", Истина, "Номер поручения");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ДатаДок", Истина, "Дата поручения");

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.СвТС.ВидТС", Истина, "Вид транспортного средства");

	УсловияИстины = Новый Массив;
	ЗначенияИли = Новый Массив;
	ЗначенияИли.Добавить("автомобильный транспорт");
	ЗначенияИли.Добавить("железнодорожный транспорт");
	УсловиеИстины = Новый Структура;
	УсловиеИстины.Вставить("ИмяПоля", "СвГруз.СвТС.ВидТС");
	УсловиеИстины.Вставить("ЗначениеПоля", ЗначенияИли);
	УсловиеИстины.Вставить("Источник", "Общий");
	УсловияИстины.Добавить(УсловиеИстины);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.СвТС.ТипКузов", УсловияИстины, "Требования к типу кузова"); //обяз, когда ВидТС = 1/4 

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвКлнт", Истина, "Клиент");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвЭксп", Истина, "Экспедитор");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ДогТрЭксп", Истина, "Договор с экспедитором");
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.ДатОтгрС", Истина, "Дата отгрузки с");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.ДатОтгрПо", Истина, "Дата отгрузки по");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.СвГП", Истина, "Грузоотправитель");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.СвГО", Истина, "Грузополучатель");
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.ОпГруз", Истина, "Сведения о грузе");

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.АдрГруз.АдрПриемГруз.Адрес.АдрИнф.АдрТекст", Истина, "Адрес пункта приема"); 
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГруз.АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.АдрТекст", Истина, "Адрес пункта доставки"); 

КонецПроцедуры

