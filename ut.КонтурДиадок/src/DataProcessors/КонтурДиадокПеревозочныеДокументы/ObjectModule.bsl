Функция ИмяКонфигурации()
	
	Результат = "Неизвестно";
	
	Если Найти(Метаданные.Синоним, "Бухгалтерия предприятия, редакция 2.0") > 0
		ИЛИ Найти(Метаданные.Синоним, "Бухгалтерия предприятия КОРП, редакция 2.0") > 0 Тогда
		
		Результат = "БП_20";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Управление производственным предприятием, редакция 1.3") > 0 Тогда
		
		Результат = "УПП";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Бухгалтерия предприятия, редакция 3") > 0
		ИЛИ Найти(Метаданные.Синоним, "Бухгалтерия предприятия КОРП, редакция 3.0") > 0 Тогда
		
		Результат = "БП_30";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Управление торговлей, редакция 11") > 0 Тогда
		
		Результат = "УТ_11";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Управление торговлей") > 0 И Найти(Метаданные.Синоним, "10.2") = 0 Тогда // Управление торговлей, редакция 10.2 снята с поддержки в 5.38.01
		
		Результат = "УТ_102";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Управление торговлей") > 0 И Найти(Метаданные.Синоним, "10.3") > 0 Тогда // Управление торговлей, редакция 10.2 снята с поддержки в 5.38.01
		
		Результат = "УТ_103";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Комплексная автоматизация") > 0 Тогда
		
		Результат = "КА";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Автосалон+Автосервис+Автозапчасти") > 0 Тогда
		
		Результат = "ААА";

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает значение в структуре по составному ключу, например: "Контрагент.Адрес.Город".
// Промежуточные узлы, если отсутствуют, создаются как Структура.
Процедура УстановитьЗначениеСвойстваСтруктуры(СтруктураНазначения, СоставнойКлюч, Значение) Экспорт
	
	Разделитель = ".";
	
	Если ТипЗнч(СтруктураНазначения) <> Тип("Структура") Тогда
    	Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(СоставнойКлюч)) Тогда
    	Возврат;
	КонецЕсли;
	
	Ключи = РазделитьСтрокуЛок(СоставнойКлюч, Разделитель, Ложь);
	ТекущаяСтруктура = СтруктураНазначения;	
	Для Индекс = 0 По Ключи.Количество() - 2 Цикл
		
		Ключ = СокрЛП(Ключи[Индекс]);
		Если ПустаяСтрока(Ключ) Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ТекущаяСтруктура.Свойство(Ключ) Тогда
			ТекущаяСтруктура.Вставить(Ключ, Новый Структура);
		КонецЕсли;
		
		Если ТипЗнч(ТекущаяСтруктура[Ключ]) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;
		
		ТекущаяСтруктура = ТекущаяСтруктура[Ключ];
		
	КонецЦикла;
	
	ПоследнийКлюч = СокрЛП(Ключи[Ключи.Количество() - 1]);
	Если ПустаяСтрока(ПоследнийКлюч) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтруктура.Вставить(ПоследнийКлюч, Значение);
	
КонецПроцедуры

Функция ЕстьИЗаполненоСвойствоСтруктуры(ДанныеСтруктуры, ИмяСвойства) Экспорт
	
	Результат = Ложь;
	Если ТипЗнч(ДанныеСтруктуры) <> Тип("Структура")
		Или Не ЗначениеЗаполнено(ИмяСвойства) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПроверкаСтруктуры = ДанныеСтруктуры;
	СписокСвойств = РазделитьСтрокуЛок(ИмяСвойства, ".");
	Для Каждого ТекСвойство Из СписокСвойств Цикл
		Если ТипЗнч(ПроверкаСтруктуры) <> Тип("Структура")
			Или Не ПроверкаСтруктуры.Свойство(ТекСвойство)
			Или Не ЗначениеЗаполнено(ПроверкаСтруктуры[ТекСвойство]) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ПроверкаСтруктуры = ПроверкаСтруктуры[ТекСвойство];
	КонецЦикла;
	
	Результат = Истина;
	
	Возврат Результат;
	
КонецФункции

