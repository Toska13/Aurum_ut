Процедура ЗаполнитьXDTO_АдресПогрузки(XDTO, Адрес, АдресРФ, КодСтраны) 

	Если Не ЗначениеЗаполнено(КодСтраны) Тогда
		КодСтраны = "643";
	КонецЕсли;
	НаименованиеСтраны = "РОССИЯ";
	
	Если ЗначениеЗаполнено(АдресРФ) Тогда	
		СтрАдреса = АдресВСтруктуру(АдресРФ, Адрес);
		Если СтрАдреса.addressType = "ВСвободнойФорме"
			Или СтрАдреса.areaCode = ""
			Или СтрАдреса.areaCode = "00" Тогда
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO.АдресИнф, "АдрТекст", СтрАдреса, "value");
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO.АдресИнф, "КодСтр", СтрАдреса, "countryCode");
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO.АдресИнф, "НаимСтр", СтрАдреса, "country");
		Иначе
			ЗаполнитьXDTO_АдресРФ(XDTO.АдресРФ, СтрАдреса);
		КонецЕсли;
	Иначе
		ЗаполнитьXDTO_СПроверкой(XDTO.АдресИнф, "АдрТекст", Адрес);
		ЗаполнитьXDTO_СПроверкой(XDTO.АдресИнф, "КодСтр", КодСтраны);
		ЗаполнитьXDTO_СПроверкой(XDTO.АдресИнф, "НаимСтр", НаименованиеСтраны);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_АдресРФ(XDTO, СтрАдреса) 
	
	Город = ?(СтрАдреса.city = "", СтрАдреса.area, СтрАдреса.city);
	ЗаполнитьXDTO_СПроверкой(XDTO, "Город", Город);

	Дом = СтрАдреса.houseNumber;
	ЗаполнитьXDTO_СПроверкой(XDTO, "Дом", Дом);

	Индекс = ?(ЗначениеЗаполнено(СтрАдреса.ZIPcode), СтрАдреса.ZIPcode, "000000");
	Индекс = Лев(Индекс, 6);
	ЗаполнитьXDTO_СПроверкой(XDTO, "Индекс", Индекс);

	Если СтрАдреса.apartments.Количество() > 0 Тогда
		Для Каждого apartment Из СтрАдреса.apartments Цикл
			Если apartment.type = "Помещение" Тогда
				Корпус = apartment.number;
				ЗаполнитьXDTO_СПроверкой(XDTO, "Корпус", Корпус);
			ИначеЕсли apartment.type = "Комната" Тогда
				Кварт = apartment.number;               
				ЗаполнитьXDTO_СПроверкой(XDTO, "Кварт", Кварт);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Улица = СтрАдреса.street;	
	ЗаполнитьXDTO_СПроверкой(XDTO, "Улица", Улица);

	КодРегион = ?(СтрАдреса.areaCode = "", "00", СтрАдреса.areaCode);
	КодРегион = Лев(КодРегион, 2);
	ЗаполнитьXDTO_СПроверкой(XDTO, "КодРегион", КодРегион);

	НаимРегион = ?(СтрАдреса.areaValue = "", "РОССИЯ", СтрАдреса.areaValue);
	ЗаполнитьXDTO_СПроверкой(XDTO, "НаимРегион", НаимРегион);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Контакт(XDTO, Телефоны, АдресаЭП, ИныеСведения) 
	
	Если ЗначениеЗаполнено(Телефоны) Тогда
		Для Каждого Телефон Из Телефоны Цикл
			Если ЗначениеЗаполнено(Телефон) Тогда
				XDTO.Тлф.Добавить(Телефон);	         
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресаЭП) Тогда
		Для Каждого АдресЭП Из АдресаЭП Цикл
			Если ЗначениеЗаполнено(АдресЭП) Тогда
				XDTO.ЭлПочта.Добавить(АдресЭП);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_РеквизитыДокумента(XDTO, РеквизитыДокумента)
	
	Если РеквизитыДокумента <> Неопределено Тогда
		XDTO.ДатаДок = Формат_ДатаДляXml(РеквизитыДокумента.Дата);
		XDTO.НаимДок = РеквизитыДокумента.Наименование;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СПроверкой(XDTO, КлючXDTO, Данные, ЗначениеПоУмолчанию = Неопределено)

	Если XDTO_ЕстьСвойство(XDTO, КлючXDTO) Тогда
		Если ЗначениеЗаполнено(Данные) Тогда
			XDTO[КлючXDTO] = Данные;
		ИначеЕсли ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда
			XDTO[КлючXDTO] = ЗначениеПоУмолчанию;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, КлючXDTO, Данные, Ключ, ЗначениеПоУмолчанию = Неопределено)

	Если XDTO_ЕстьСвойство(XDTO, КлючXDTO) Тогда
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Если ЕстьИЗаполненоСвойствоСтруктуры(Данные, Ключ) Тогда
				XDTO[КлючXDTO] = ЕстьИЗначениеСвойствоСтруктуры(Данные, Ключ);
			ИначеЕсли ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда
				XDTO[КлючXDTO] = ЗначениеПоУмолчанию;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Данные) Тогда
			XDTO[КлючXDTO] = Данные;
		ИначеЕсли ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда
			XDTO[КлючXDTO] = ЗначениеПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция XDTO_СтрокаПоСсылке(Значение)
	
	Результат = Строка(Значение);
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Если Значение.Свойство("Ссылка") И ЗначениеЗаполнено(Значение.Ссылка) Тогда
			Результат = Строка(Значение.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XDTO_ОграничениеСтроки(Значение, Длина)
	
	Результат = Строка(Значение);
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Результат = Лев(Строка(Значение) + "0000", Длина); 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


