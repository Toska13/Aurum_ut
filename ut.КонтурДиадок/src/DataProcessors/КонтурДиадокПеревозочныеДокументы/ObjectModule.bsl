		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "плМасГруз.МасБрутЗнач", Истина, "Масса брутто", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СостГруз", Истина, "Состояние груза", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ВидТар", Истина, "Вид тары", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ЦеннГруз.СтЦеннГр", Ложь, "Ценность груза", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ЦеннГруз.Валюта", Ложь, "Валюта", , ИмяРеквизитаТЧ);
