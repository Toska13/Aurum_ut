	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ТипВлад", Истина, "Тип владения " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Тип", Истина, "Тип " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Марка", Истина, "Марка " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Грузопод", Истина, "Грузоподъемность " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Вместим", Истина, "Вместимость " + ДопИнфо, РеквизитНаФорме);
