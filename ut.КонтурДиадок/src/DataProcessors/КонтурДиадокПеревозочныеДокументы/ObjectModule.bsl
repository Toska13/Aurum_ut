Процедура ОбработатьАдрПункт(ДокументыОснования, АдрПункт, СвГО, Контрагент, ДанныеАдреса = Неопределено) Экспорт
	
	//связь по документу основанию.
	Если ДокументыОснования.Количество() > 0 Тогда 
		
		ОсновнойДокумент = ДокументыОснования[0];
		НеИзменятьАдреса = Новый Массив;
		//по основному документу адрес берем из СвГО и из адреса формы
		
		//удалить из текущих пунктов, те которых нет в документах оснований
		ВсегоПунктов = АдрПункт.Количество();
		Пока ВсегоПунктов > 0 Цикл
			ВсегоПунктов = ВсегоПунктов - 1;
			текПункт = АдрПункт[ВсегоПунктов];
			Если ЗначениеЗаполнено(текПункт.техДокОсн)
				И ДокументыОснования.Найти(текПункт.техДокОсн) = Неопределено Тогда
				АдрПункт.Удалить(ВсегоПунктов);	
			ИначеЕсли ЗначениеЗаполнено(текПункт.техДокОсн) Тогда
				НеИзменятьАдреса.Добавить(текПункт.техДокОсн);
			КонецЕсли;
		КонецЦикла;
		
		ИндексОснПогрузка = Неопределено;
		Индекс = -1;
		Для Каждого текПункт Из АдрПункт Цикл
			Индекс = Индекс + 1;
			Если текПункт.техДокОсн = ОсновнойДокумент И текПункт.Опер = "Погрузка" Тогда
				ИндексОснПогрузка = Индекс;
            	Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//адрес по основному документу синхронизируем по переданным данным.
		Если ДанныеАдреса = Неопределено Тогда
			ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдреса(СвГО);
			Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
				ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];
			КонецЕсли;
		КонецЕсли;
		Если ДанныеАдреса <> Неопределено Тогда
			Добавить_АдрПункт(АдрПункт, ИндексОснПогрузка, ОсновнойДокумент,
			"Погрузка",
			СвГО,
			ДанныеАдреса.Адрес,
			"643",
			ДанныеАдреса.АдресРФ);
		КонецЕсли;
		
		//добавить только новые, текущие изменять не будем, поскольку могло быть ручное изменение.
		Для Каждого ДокументОснование Из ДокументыОснования Цикл 
			
			Если НеИзменятьАдреса.Найти(ДокументОснование) <> Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			ДанныеАдреса = Неопределено;
			
			ДанныеКонтрагента = Новый Структура("Организация, АдресДоставки, АдресДоставкиЗначение, СкладПолучатель");
			ЗаполнитьЗначенияСвойств(ДанныеКонтрагента, ДокументОснование);
			Если ЗначениеЗаполнено(ДанныеКонтрагента.АдресДоставки)  Тогда
				ДанныеАдреса = СтруктураАдреса();
				ДанныеАдреса.Адрес = ДанныеКонтрагента.АдресДоставки;
				ДанныеАдреса.АдресРФ = ДанныеКонтрагента.АдресДоставкиЗначение;
				ДанныеАдреса.АдресКодСтраны = "643";
			ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.СкладПолучатель) Тогда
				ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдреса(ДанныеКонтрагента.СкладПолучатель);				
				Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
					ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];			
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Контрагент) Тогда
				ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдреса(Контрагент);				
				Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
					ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];			
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеАдреса <> Неопределено Тогда
				Добавить_АдрПункт(АдрПункт, Неопределено, ДокументОснование,
				"Выгрузка",
				?(ЗначениеЗаполнено(Контрагент), Контрагент, ДанныеКонтрагента.Организация),
				ДанныеАдреса.Адрес,
				"643",
				ДанныеАдреса.АдресРФ);
			Иначе
				Добавить_АдрПункт(АдрПункт, Неопределено, ДокументОснование,
				"Выгрузка",
				?(ЗначениеЗаполнено(Контрагент), Контрагент, ДанныеКонтрагента.Организация),
				Неопределено,
				Неопределено,
				Неопределено);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура Добавить_АдрПункт(АдрПункт, ТекущийИндекс, техДокОсн, Опер, ОргВладИнфр, АдрТекст, КодСтр, АдрРФ)
	
	Поиск = Новый Структура;
	Поиск.Вставить("ОргВладИнфр", ОргВладИнфр);

	НовыйПункт = АдрПунктТип();
	НовыйПункт.Опер = Опер;
	НовыйПункт.ДатВрОпер = ТекущаяДата();
	//НовыйПункт.ПредВрОпер = НовыйПункт.ДатВрОпер + 10;
	НовыйПункт.АдресПункт.Адрес.АдрИнф.АдрТекст = АдрТекст;
	НовыйПункт.АдресПункт.Адрес.АдрИнф.КодСтр = КодСтр;
	НовыйПункт.АдресПункт.Адрес.АдрРФ = АдрРФ;
	НовыйПункт.ОргВладИнфр = ОргВладИнфр;
	НовыйПункт.техДокОсн = техДокОсн;
	
	Если ТекущийИндекс = Неопределено Тогда
		Если Опер = "Погрузка" Тогда
			АдрПункт.Вставить(0, НовыйПункт);         
		Иначе
			АдрПункт.Добавить(НовыйПункт);         
		КонецЕсли;
	Иначе 
		АдрПункт[ТекущийИндекс] = НовыйПункт;
	КонецЕсли;
	
КонецПроцедуры

