Функция ПолучитьСведениеПоИмени(пИмяСведения) Экспорт
	
	ИмяСведения = "КонтурЛогистика_" + пИмяСведения;             
	
	НазваниеХарактеристикДополнительныеСвойства = НазваниеХарактеристикДополнительныеСвойства();	
	НашлиСведение = ПланыВидовХарактеристик[НазваниеХарактеристикДополнительныеСвойства].НайтиПоНаименованию(ИмяСведения, Истина);
	
	Если НашлиСведение.Пустая() Тогда 
		
		УстановитьПривилегированныйРежим(Истина);
		
		НовСведение = ПланыВидовХарактеристик[НазваниеХарактеристикДополнительныеСвойства].СоздатьЭлемент();
		
		НовСведение.Наименование = ИмяСведения;
		ЗаполнитьРеквизитПоИмениСПроверкой(НовСведение, "Виден", Истина);
		ЗаполнитьРеквизитПоИмениСПроверкой(НовСведение, "ЭтоДополнительноеСведение", Истина);
		ЗаполнитьРеквизитПоИмениСПроверкой(НовСведение, "Имя", ИмяСведения);
		ЗаполнитьРеквизитПоИмениСПроверкой(НовСведение, "Заголовок", ИмяСведения);
		
		КС = Метаданные.ПланыВидовХарактеристик[НазваниеХарактеристикДополнительныеСвойства].Тип.КвалификаторыСтроки;	
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
		НовСведение.ТипЗначения = ОписаниеТиповС;
		
		
		НовСведение.ОбменДанными.Загрузка = Истина;
		НовСведение.Записать();
		
		Если ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		НашлиСведение = НовСведение.Ссылка;	

	КонецЕсли; 
	
	//для 8.2 критично, при записи элементов происходит полное очищение свойств без назначения
	//будем имени определять назначение
	мтд = НашлиСведение.Метаданные();
	Если мтд.Реквизиты.Найти("НазначениеСвойства") <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(НашлиСведение.НазначениеСвойства) Тогда
			СтрокаНазначения = НазначениеСвойстваПоИмени(пИмяСведения);
			Если СтрокаНазначения <> Неопределено Тогда
				мтдНазначения = НашлиСведение.НазначениеСвойства.Метаданные();
				ПолноеИмя = мтдНазначения.ПолноеИмя();
				Если Лев(ПолноеИмя, 23) = "ПланВидовХарактеристик." Тогда     
					Попытка
						НашлиНазначение = ПланыВидовХарактеристик[мтдНазначения.Имя][СтрокаНазначения];
						ОбъектСведение = НашлиСведение.ПолучитьОбъект();
						ОбъектСведение.НазначениеСвойства = НашлиНазначение;
						ОбъектСведение.ОбменДанными.Загрузка = Истина;
						ОбъектСведение.Записать();
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НашлиСведение;
	
КонецФункции

Функция НазначениеСвойстваПоИмени(ИмяСведения)
	
	Результат = Неопределено;
	
	Если ИмяСведения = "ОсновнойДокумент" Тогда
	ИначеЕсли ИмяСведения = "трнТитул1" Тогда
	ИначеЕсли ИмяСведения = "ззТитул1" Тогда
	ИначеЕсли ИмяСведения = "пэТитул1" Тогда
	ИначеЕсли ИмяСведения = "Номер" Тогда
	ИначеЕсли ИмяСведения = "Дата" Тогда
	ИначеЕсли ИмяСведения = "Организация" Тогда
	ИначеЕсли ИмяСведения = "Грузоотправитель" Тогда
	ИначеЕсли ИмяСведения = "Контрагент" Тогда
 	ИначеЕсли ИмяСведения = "Грузополучатель" Тогда
 	ИначеЕсли ИмяСведения = "Перевозчик" Тогда
  	ИначеЕсли ИмяСведения = "Сумма" Тогда
  	ИначеЕсли ИмяСведения = "Статус" Тогда
	ИначеЕсли ИмяСведения = "ИдентификаторТрН" Тогда
		Результат = "Документы";
	ИначеЕсли ИмяСведения = "ИдентификаторЗЗ" Тогда
		Результат = "Документы";
	ИначеЕсли ИмяСведения = "ИдентификаторПЭ" Тогда
		Результат = "Документы";
	ИначеЕсли ИмяСведения = "СвВодит" Тогда
		Результат = "Справочник_ФизическиеЛица";
	ИначеЕсли ИмяСведения = "РеквДок" Тогда
		Результат = "Справочник_ДоговорыКонтрагентов";
	ИначеЕсли ИмяСведения = "РабЛиц" Тогда
		Результат = "Справочник_ФизическиеЛица";
	ИначеЕсли ИмяСведения = "СвУч" Тогда
		Результат = "Справочник_Контрагенты";
	ИначеЕсли ИмяСведения = "СвУчОрг" Тогда
		Результат = "Справочник_Организации";
	ИначеЕсли ИмяСведения = "СвТС" Тогда
		Результат = "Справочник_ОсновныеСредства";
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначениеСведения(ОбъектДанных, ИмяСведения, ВернутьСтроку) Экспорт
	
	Сведение = ПолучитьСведениеПоИмени(ИмяСведения);
	ТекОтбор = Новый Структура("Объект, Свойство", ОбъектДанных, Сведение);	
	НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
	Значение = РегистрыСведений[НазваниеРегистраДополнительныеСвойства].Получить(ТекОтбор).Значение;
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") И ВернутьСтроку Тогда
		ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов = ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов();
		Если ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов Тогда
			Результат = Значение.ПолноеНаименование;                 
		Иначе
			Результат = ВосстановитьЗначениеСвойствоОбъекта(Значение);
		КонецЕсли;
	Иначе
		Результат = Значение;
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, Неопределено);
	
КонецФункции

Процедура УстановитьЗначениеСведения(ОбъектДанных, ИмяСведения, Значение, СоздатьСправочник)
		
	Если ЗначениеЗаполнено(ОбъектДанных) Тогда
		
		Сведение = ПолучитьСведениеПоИмени(ИмяСведения);
		
		НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
		
		Если СоздатьСправочник Тогда
			
			ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов = ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов();
			
			УИД = Строка(ОбъектДанных.УникальныйИдентификатор());
			
			УстановитьПривилегированныйРежим(Истина);
			
			НашлиСпр = Справочники["ЗначенияСвойствОбъектов"].НайтиПоНаименованию(УИД, Истина, , Сведение);
			Если НашлиСпр.Пустая() Тогда
				ОбъектСпр = Справочники["ЗначенияСвойствОбъектов"].СоздатьЭлемент();
			Иначе
				ОбъектСпр = НашлиСпр.ПолучитьОбъект();
			КонецЕсли;
			ОбъектСпр.Наименование = УИД;
			Если ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов Тогда
				ОбъектСпр.ПолноеНаименование = Значение;
			КонецЕсли;
			ОбъектСпр.Владелец = Сведение;
			ОбъектСпр.Записать();
			
			Если Не ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов Тогда
				ЗаписатьЗначениеСвойствоОбъекта(ОбъектСпр.Ссылка, Значение);
			КонецЕсли;
			
			Если ПривилегированныйРежим() Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			
			Значение = ОбъектСпр.Ссылка;
			
		КонецЕсли;
		
		Попытка       
			
			НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
						
			УстановитьПривилегированныйРежим(Истина);
			
			МенеджерЗаписи = РегистрыСведений[НазваниеРегистраДополнительныеСвойства].СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = ОбъектДанных;
			МенеджерЗаписи.Свойство = Сведение;
			МенеджерЗаписи.Значение = Значение;    
			Если Значение = Неопределено Тогда
				МенеджерЗаписи.Удалить();
			Иначе
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
			Если ПривилегированныйРежим() Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();  
			
		Исключение               
			
			ОтменитьТранзакцию(); 
			
		КонецПопытки; 
		
	КонецЕсли;          
	
КонецПроцедуры

Функция ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов()
	Возврат Метаданные.Справочники["ЗначенияСвойствОбъектов"].Реквизиты.Найти("ПолноеНаименование") <> Неопределено;
КонецФункции

Процедура ЗаполнитьРеквизитПоИмениСПроверкой(Объект1С, ИмяРеквизита, Значение, РеквизитИзменен = ложь)
	
	Если Объект1С.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		
		Если Объект1С[ИмяРеквизита] <> Значение Тогда
			Объект1С[ИмяРеквизита] = Значение;
			РеквизитИзменен = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьТрНДляКаждогоДокумента(СписокДокументов, ТекущийСценарий = Неопределено) Экспорт
	
	Для Каждого Документ Из СписокДокументов Цикл
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(Документ);
		
		ИдентификаторТрН = ИдентификаторТрН(Документ);
		ДанныеТрН = ДанныеТрН(ИдентификаторТрН, ДокументыОснования);
		НезаполненныеРеквизиты = ОшибкиПроверкиТрН(ИдентификаторТрН, ДокументыОснования);
		ЕстьОшибки = ЕстьОшибкиПроверки(НезаполненныеРеквизиты);
		
		ЗначенияРеквизитовТрН = ЗначенияДополнительныхСвойствПоДанным(ДанныеТрН);
		ПараметрыТрН = ПараметрыТрН(Документ, ДокументыОснования, ЗначенияРеквизитовТрН, ТекущийСценарий);
		СохранитьЗначенияЭПД(КлючИдентификатораТрН(), ИдентификаторТрН, КлючРеквизитовТрН(), ЗначенияРеквизитовТрН, ПараметрыТрН);
		Статус = ОпределитьСтатусТрН(ЕстьОшибки);
		СохранитьСтатусТрН(ИдентификаторТрН, Статус);
		
		ДопПеременные = Новый Соответствие;
		ДействиеМетрики = Метрика_НазваниеДействий().СозданиеЭТРН;
		ДопПеременные.Вставить(Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве(НезаполненныеРеквизиты));
		Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, ДокументыОснования);
		ДопПеременные.Вставить(Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторТрН));
		НаименованиеФормы = Метрика_НаименованиеФормыЭТРН();
		Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
		
	КонецЦикла;
		
КонецПроцедуры

