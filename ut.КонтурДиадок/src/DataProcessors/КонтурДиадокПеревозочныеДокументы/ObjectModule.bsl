		Если НЕ ЗначениеЗаполнено(СтороныСоставителиАкта) Тогда
			
			ОписаниеОшибки = Контракт_ОписаниеОшибкиДанных();
			
			ОписаниеОшибки.ИмяРеквизита = "Наименование";
			ОписаниеОшибки.ИмяТабЧасти = ИмяТабЧасти;
