Функция ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, ИмяФормы = "", ЭтоОбычнаяФорма = Ложь) Экспорт
	
	Результат = Новый Структура;
	                   
	Если ЭтоОбычнаяФорма Тогда
		РеквизитыФормы = ЭтаФорма.ЭлементыФормы;
	Иначе 
		РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	КонецЕсли;
			
	Для Каждого Реквизит Из РеквизитыФормы Цикл
		
		Если Лев(Реквизит.Имя, 3) = "рл_" Тогда 

			// сохранить как доп. сведение.
			ТипыСписокЗначений = Новый Массив;
			ТипыСписокЗначений.Добавить(Тип("СписокЗначений"));
			ТипыТаблицаЗначений = Новый Массив;
			ТипыТаблицаЗначений.Добавить(Тип("ТаблицаЗначений"));
			Если Реквизит.ТипЗначения = Новый ОписаниеТипов(ТипыСписокЗначений) Тогда
				Значение = Новый Массив;
				Для Каждого ЭлементСписка Из ЭтаФорма[Реквизит.Имя] Цикл
					Значение.Добавить(ЭлементСписка.Значение);	
				КонецЦикла;
			ИначеЕсли Реквизит.ТипЗначения = Новый ОписаниеТипов(ТипыТаблицаЗначений) Тогда
				Значение = Новый Массив;
				Если ЭтоОбычнаяФорма Тогда
					ТаблицаФормы = ЭтаФорма[Реквизит.Имя];
				Иначе
					ТаблицаФормы = ЭтаФорма[Реквизит.Имя].Выгрузить();
				КонецЕсли;			
				СписокКолонок = ТаблицаФормы.Колонки;
				Для Каждого СтрокаТЗ Из ТаблицаФормы Цикл
					                            
					Если Реквизит.Имя = "рл_ОпГруз" И ИмяФормы = "ФормаТрН" Тогда
						Сведение = ОпГрузТипТрН();
					ИначеЕсли Реквизит.Имя = "рл_ОпГруз" И ИмяФормы = "ФормаЗЗ" Тогда
						Сведение = ОпГрузТипЗЗ();
					ИначеЕсли Реквизит.Имя = "рл_СвГруз_ОпГруз" И ИмяФормы = "ФормаПЭ" Тогда
						Сведение = ОпГрузТипПЭ();
					ИначеЕсли Реквизит.Имя = "рл_СопрДок" И ИмяФормы = "ФормаПЭ" Тогда
						Сведение = РеквДокТипПЭ(); 
					ИначеЕсли Реквизит.Имя = "рл_СопрДок" Тогда
						Сведение = СтруктураСопрДок(); 
					ИначеЕсли Реквизит.Имя = "рл_ИнфПол" Тогда
						Сведение = ИнфПолТип(); 
					ИначеЕсли Реквизит.Имя = "рл_СвГруз_ИнфПол" Тогда
						Сведение = ИнфПолТип(); 
					ИначеЕсли  Реквизит.Имя = "рл_АдрПункт" Тогда
						Сведение = АдрПунктТип(); 
					Иначе
						Продолжить;
					КонецЕсли;
					
					Для Каждого Колонка Из СписокКолонок Цикл
						УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТЗ[Колонка.Имя]);
					КонецЦикла;
					
					Если (Реквизит.Имя = "рл_ОпГруз" Или Реквизит.Имя = "рл_СвГруз_ОпГруз")
						И Сведение.Свойство("СвОпГруз")
						 И Сведение.Свойство("СвКонтейн") Тогда
						 
						 Если ЗначениеЗаполнено(СтрокаТЗ.ОпасныеГрузыXML) Тогда
							ДанныеОпасныхГрузов = ДесериализоватьXML(СтрокаТЗ.ОпасныеГрузыXML);
							Если ТипЗнч(ДанныеОпасныхГрузов) = Тип("Массив") Тогда
								Для Каждого ДанныеОпасногоГруза Из ДанныеОпасныхГрузов Цикл
									Если ТипЗнч(ДанныеОпасногоГруза) = Тип("Структура") Тогда
										Сведение.СвОпГруз.Добавить(ДанныеОпасногоГруза);
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрокаТЗ.КонтейнерыXML) Тогда
							ДанныеКонтейнеры = ДесериализоватьXML(СтрокаТЗ.КонтейнерыXML);
							Если ТипЗнч(ДанныеКонтейнеры) = Тип("Массив") Тогда
								Для Каждого ДанныеКонтейнера Из ДанныеКонтейнеры Цикл
									Если ТипЗнч(ДанныеКонтейнера) = Тип("Структура") Тогда
										Сведение.СвКонтейн.Добавить(ДанныеКонтейнера);
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					Значение.Добавить(Сведение);
				КонецЦикла;	
				
			ИначеЕсли ЭтоРеквизитXML(Реквизит.Имя) Тогда
				Если ЗначениеЗаполнено(ЭтаФорма[Реквизит.Имя]) Тогда
					Значение = ДесериализоватьXML(ЭтаФорма[Реквизит.Имя]);
				Иначе
					Значение = Неопределено;
				КонецЕсли;
			Иначе
				Значение = ЭтаФорма[Реквизит.Имя];
			КонецЕсли; 
			
			УстановитьЗначениеИзСтрокиВСтруктуру(Результат, Реквизит.Имя, Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначенияДополнительныхСвойствПоДанным(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура") Тогда
		
		Результат = Новый Структура;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(КлючЗначение.Ключ, ЗначенияДополнительныхСвойствПоДанным(КлючЗначение.Значение));
		КонецЦикла;
		
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначенияДополнительныхСвойствПоДанным(ЭлементМассива));
		КонецЦикла;
		
	Иначе
		
		Результат = Значение;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыТрН(ОсновнойДокумент, ДокументыОснования, ЗначенияДополнительныхСвойств, Сценарий = Неопределено) Экспорт
	
	ПараметрыТрН = Новый Структура;
	ПараметрыТрН.Вставить("ОсновнойДокумент", ОсновнойДокумент);
	ПараметрыТрН.Вставить("ДокументыОснования", ДокументыОснования);
	ПараметрыТрН.Вставить("Номер", ЗначенияДополнительныхСвойств.НомерТрН);
	ПараметрыТрН.Вставить("Дата", ЗначенияДополнительныхСвойств.ДатаТрН);
	ПараметрыТрН.Вставить("Организация", ЗначенияДополнительныхСвойств.Организация);
	ПараметрыТрН.Вставить("Контрагент", ЗначенияДополнительныхСвойств.Контрагент);
	ПараметрыТрН.Вставить("Грузоотправитель", ЗначенияДополнительныхСвойств.СвГО.РекИдентГО);
	ПараметрыТрН.Вставить("Перевозчик", ЗначенияДополнительныхСвойств.СвПер);
	ПараметрыТрН.Вставить("Грузополучатель", ЗначенияДополнительныхСвойств.СвГП.РекИдентГП);
	Если Сценарий = Неопределено Тогда 	
		Сценарий = СценарийУниверсальный();	
	КонецЕсли;
	ПараметрыТрН.Вставить("Сценарий", Сценарий);
	
	СуммаДокумента = 0;
	ОпГруз = ЗначенияДополнительныхСвойств.ОпГруз;
	Если ЗначениеЗаполнено(ОпГруз) Тогда
		Для Каждого Сведение Из ОпГруз Цикл
			СуммаДокумента = СуммаДокумента + Сведение.ЦеннГруз.СтЦеннГр;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыТрН.Вставить("Сумма", СуммаДокумента);
	
	Возврат ПараметрыТрН;

КонецФункции

Функция ПараметрыЗЗ(ОсновнойДокумент, ДокументыОснования, ЗначенияДополнительныхСвойств) Экспорт
	
	ПараметрыЗЗ = Новый Структура;
	ПараметрыЗЗ.Вставить("ОсновнойДокумент", ОсновнойДокумент);
	ПараметрыЗЗ.Вставить("ДокументыОснования", ДокументыОснования);
	ПараметрыЗЗ.Вставить("Номер", ЗначенияДополнительныхСвойств.НомЗак);
	ПараметрыЗЗ.Вставить("Дата", ЗначенияДополнительныхСвойств.ДатаЗак);
	ПараметрыЗЗ.Вставить("Организация", ЗначенияДополнительныхСвойств.Организация);
	ПараметрыЗЗ.Вставить("Грузоотправитель", ЗначенияДополнительныхСвойств.СвГО); 
	ПараметрыЗЗ.Вставить("Перевозчик", ЗначенияДополнительныхСвойств.СвПрв);
	ПараметрыЗЗ.Вставить("Грузополучатель", ЗначенияДополнительныхСвойств.СвПрв);
	ПараметрыЗЗ.Вставить("Контрагент", ЗначенияДополнительныхСвойств.СвПрв);
	
	СуммаДокумента = 0;

	ОпГруз = ЗначенияДополнительныхСвойств.ОпГруз;
	Если ЗначениеЗаполнено(ОпГруз) Тогда
		Для Каждого Сведение Из ОпГруз Цикл
			СуммаДокумента = СуммаДокумента + ?(Сведение.ЦеннГруз.СтЦеннГр = Неопределено, 0, Сведение.ЦеннГруз.СтЦеннГр);
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыЗЗ.Вставить("Сумма", СуммаДокумента);
	
	Возврат ПараметрыЗЗ;

КонецФункции

Функция ПараметрыПЭ(ОсновнойДокумент, ДокументыОснования, ЗначенияДополнительныхСвойств) Экспорт
	
	ПараметрыПЭ = Новый Структура;
	ПараметрыПЭ.Вставить("ОсновнойДокумент", ОсновнойДокумент);
	ПараметрыПЭ.Вставить("ДокументыОснования", ДокументыОснования);
	ПараметрыПЭ.Вставить("Номер", ЗначенияДополнительныхСвойств.НомДок);
	ПараметрыПЭ.Вставить("Дата", ЗначенияДополнительныхСвойств.ДатаДок);
	ПараметрыПЭ.Вставить("Организация", ЗначенияДополнительныхСвойств.Организация);
	ПараметрыПЭ.Вставить("Контрагент", ЗначенияДополнительныхСвойств.Контрагент);
	ПараметрыПЭ.Вставить("Грузоотправитель", ЗначенияДополнительныхСвойств.СвКлнт);
	ПараметрыПЭ.Вставить("Перевозчик", ЗначенияДополнительныхСвойств.СвЭксп);
	ПараметрыПЭ.Вставить("Грузополучатель", ЗначенияДополнительныхСвойств.СвГруз.СвГП);
	
	СуммаДокумента = 0;                       
	ОпГруз = ЗначенияДополнительныхСвойств.СвГруз.ОпГруз;
	Если ЗначениеЗаполнено(ОпГруз) Тогда
		Для Каждого Сведение Из ОпГруз Цикл
			СуммаДокумента = СуммаДокумента + Сведение.ОбъявлСтГруз.СтГр;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыПЭ.Вставить("Сумма", СуммаДокумента);
	
	Возврат ПараметрыПЭ;

КонецФункции

Процедура СохранитьЗначения(СсылкаНаОбъект, ЗначенияДополнительныхСвойств, КлючДополнительныхСвойств) Экспорт
	
	РезультатXML = СериализоватьXML(ЗначенияДополнительныхСвойств);

	УстановитьЗначениеСведения(СсылкаНаОбъект, КлючДополнительныхСвойств, РезультатXML, Истина);	
	
КонецПроцедуры
                                
Процедура СохранитьЗначенияЭПД(КлючИдентификатораЭПД, ИдентификаторЭПД, КлючДополнительныхСвойств, ЗначенияДополнительныхСвойств, ПараметрыЭПД) Экспорт
		                                                       
	Документы1С = ДокументыОснования(КлючИдентификатораЭПД, ИдентификаторЭПД);
	Для Каждого Документ1С Из Документы1С Цикл
		УстановитьЗначениеСведения(Документ1С, КлючИдентификатораЭПД, Неопределено, Ложь);
	КонецЦикла;
	Для Каждого ДокументОснование Из ПараметрыЭПД.ДокументыОснования Цикл
		УстановитьЗначениеСведения(ДокументОснование, КлючИдентификатораЭПД, ИдентификаторЭПД, Ложь);	
	КонецЦикла;

	СохранитьЗначения(ИдентификаторЭПД, ЗначенияДополнительныхСвойств, КлючДополнительныхСвойств);
	
	УстановитьЗначениеСведения(ИдентификаторЭПД, "ОсновнойДокумент", СериализоватьXML(ПараметрыЭПД.ОсновнойДокумент), Истина);	
	УстановитьЗначениеСведения(ИдентификаторЭПД, "Номер", ПараметрыЭПД.Номер, Ложь);	
	УстановитьЗначениеСведения(ИдентификаторЭПД, "Дата", ПараметрыЭПД.Дата, Ложь);	
	УстановитьЗначениеСведения(ИдентификаторЭПД, "Сумма", ПараметрыЭПД.Сумма, Ложь);
	Если ПараметрыЭПД.Свойство("Сценарий") Тогда
 		УстановитьЗначениеСведения(ИдентификаторЭПД, "Сценарий", СериализоватьXML(ПараметрыЭПД.Сценарий), Истина);
	КонецЕсли;

	//необходимо проверить, можно ли в значение записать данные ссылки	
	НазваниеХарактеристикДополнительныеСвойства = НазваниеХарактеристикДополнительныеСвойства();
	ТипЗначенийПВХ = Метаданные.ПланыВидовХарактеристик[НазваниеХарактеристикДополнительныеСвойства].Тип;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Организация)) Тогда
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Организация", ПараметрыЭПД.Организация, Ложь);	 
	Иначе
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Организация", СериализоватьXML(ПараметрыЭПД.Организация), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Контрагент)) Тогда
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Контрагент", ПараметрыЭПД.Контрагент, Ложь);	
	Иначе
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Контрагент", СериализоватьXML(ПараметрыЭПД.Контрагент), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Перевозчик)) Тогда
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Перевозчик", ПараметрыЭПД.Перевозчик, Ложь);	
	Иначе
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Перевозчик", СериализоватьXML(ПараметрыЭПД.Перевозчик), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Грузоотправитель)) Тогда
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Грузоотправитель", ПараметрыЭПД.Грузоотправитель, Ложь);	
	Иначе
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Грузоотправитель", СериализоватьXML(ПараметрыЭПД.Грузоотправитель), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Грузополучатель)) Тогда
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Грузополучатель", ПараметрыЭПД.Грузополучатель, Ложь);	
	Иначе
		УстановитьЗначениеСведения(ИдентификаторЭПД, "Грузополучатель", СериализоватьXML(ПараметрыЭПД.Грузополучатель), Истина);	 
	КонецЕсли;
	                            
КонецПроцедуры

