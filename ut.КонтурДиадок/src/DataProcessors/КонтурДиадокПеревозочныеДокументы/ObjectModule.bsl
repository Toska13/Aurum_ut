Процедура ЗаполнитьXDTO_Адрес(XDTO, Адрес, АдресРФ, КодСтраны) 
	
	Если Не ЗначениеЗаполнено(КодСтраны) Тогда
		КодСтраны = "643";
	КонецЕсли;
	НаименованиеСтраны = "РОССИЯ";
	
	Если ЗначениеЗаполнено(АдресРФ) Тогда
		СтрАдреса = АдресВСтруктуру(АдресРФ, Адрес);
		Если СтрАдреса.addressType = "ВСвободнойФорме"
			Или СтрАдреса.areaCode = ""
			Или СтрАдреса.areaCode = "00" Тогда
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO.АдрИнф, "АдрТекст", СтрАдреса, "value");
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO.АдрИнф, "КодСтр", СтрАдреса, "countryCode");
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO.АдрИнф, "НаимСтр", СтрАдреса, "country");
		Иначе
			ЗаполнитьXDTO_АдресРФ(XDTO.АдрРФ, СтрАдреса);
		КонецЕсли;
	Иначе
		ЗаполнитьXDTO_СПроверкой(XDTO.АдрИнф, "АдрТекст", Адрес);
		ЗаполнитьXDTO_СПроверкой(XDTO.АдрИнф, "КодСтр", КодСтраны);
		ЗаполнитьXDTO_СПроверкой(XDTO.АдрИнф, "НаимСтр", НаименованиеСтраны);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_АдресДоставки(XDTO, Адрес, АдресРФ, КодСтраны) 

