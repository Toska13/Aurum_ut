Процедура ЗаполнитьДанныеФормы(ДанныеПоСтруктуре, ЭтаФорма, Префикс = "", ЭтоОбычнаяФорма = Ложь) Экспорт
	
	Для Каждого КлючЗначение Из ДанныеПоСтруктуре Цикл
		
		Ключ = Префикс + КлючЗначение.Ключ;
		КлючФормы = СтрШаблонЛок("рл_%1", Ключ);
		ДанныеЗначения = КлючЗначение.Значение;
		
		Если ЭтоОбычнаяФорма Тогда
			НайденныйЭлемент =  ЭтаФорма.ЭлементыФормы.Найти(КлючФормы);
		Иначе
			НайденныйЭлемент =  ЭтаФорма.Элементы.Найти(КлючФормы);
		КонецЕсли;
		
		Если ТипЗнч(ДанныеЗначения) = Тип("Структура") И НайденныйЭлемент <> Неопределено Тогда
			// вариант когда значением является структура, и ее надо разместить в поле формы - сериализуем значение.
			ЭтаФорма[КлючФормы] = СериализоватьXML(ДанныеЗначения);
			ЭтаФорма[КлючПредставление(КлючФормы)] = ЗначениеПредставление(ДанныеЗначения);
			
		ИначеЕсли ТипЗнч(ДанныеЗначения) = Тип("Структура") И НайденныйЭлемент = Неопределено Тогда
			
			ЗаполнитьДанныеФормы(ДанныеЗначения, ЭтаФорма, Ключ + "_", ЭтоОбычнаяФорма);	
			
		ИначеЕсли НайденныйЭлемент <> Неопределено Тогда
			
			Если ТипЗнч(ДанныеЗначения) = Тип("Массив")
				И ТипЗнч(ЭтаФорма[КлючФормы]) = Тип("СписокЗначений") Тогда
				
				ЭтаФорма[КлючФормы].Очистить();
				Для Каждого ЭлементМассива Из ДанныеЗначения Цикл
					ЭтаФорма[КлючФормы].Добавить(ЭлементМассива);	
				КонецЦикла;  
				
			ИначеЕсли ТипЗнч(ДанныеЗначения) = Тип("Массив")
				И (ТипЗнч(ЭтаФорма[КлючФормы]) = Тип("ДанныеФормыКоллекция")
				Или ТипЗнч(ЭтаФорма[КлючФормы]) = Тип("ТаблицаЗначений")) Тогда
				
				ЭтаФорма[КлючФормы].Очистить();
				Если ЭтоОбычнаяФорма Тогда
					ТаблицаФормы = ЭтаФорма[КлючФормы];
				Иначе
					ТаблицаФормы = ЭтаФорма[КлючФормы].Выгрузить();
				КонецЕсли;

				СписокКолонок = ТаблицаФормы.Колонки;

				Для Каждого ЭлементМассива Из ДанныеЗначения Цикл
					
					НоваяСтрока = ЭтаФорма[КлючФормы].Добавить();
										                            					
					Для Каждого Колонка Из СписокКолонок Цикл
						ИмяКолонки = Колонка.Имя;
						Ключи = РазделитьСтрокуЛок(ИмяКолонки, "_", Истина);  
						Если ЭлементМассива.Свойство(Ключи[0]) Тогда
							ЗначениеПоКлючу = ЭлементМассива[Ключи[0]];
							Для Индекс = 1 По Ключи.Количество() - 1 Цикл
								Если ТипЗнч(ЗначениеПоКлючу) = Тип("Структура") И ЗначениеПоКлючу.Свойство(Ключи[Индекс]) Тогда
									ЗначениеПоКлючу = ЗначениеПоКлючу[Ключи[Индекс]];
								Иначе
									ЗначениеПоКлючу = Неопределено;
								КонецЕсли;
							КонецЦикла;
							НоваяСтрока[ИмяКолонки] = ЗначениеПоКлючу;
						КонецЕсли;
					КонецЦикла;					
					
					Если (Ключ = "ОпГруз" или Ключ = "СвГруз_ОпГруз")
						И ЭлементМассива.Свойство("СвКонтейн")
						И ЭлементМассива.Свойство("СвОпГруз")Тогда
						//todo: проверить на наличие в НоваяСтрока.
						НоваяСтрока.КонтейнерыXML = СериализоватьXML(ЭлементМассива.СвКонтейн);
						Если ЗначениеЗаполнено(ЭлементМассива.СвКонтейн) Тогда
							НоваяСтрока.КонтейнерыГиперссылка = "<редактировать>";
						Иначе
							НоваяСтрока.КонтейнерыГиперссылка = "<добавить>";
						КонецЕсли;
						НоваяСтрока.ОпасныеГрузыXML = СериализоватьXML(ЭлементМассива.СвОпГруз);
						Если ЗначениеЗаполнено(ЭлементМассива.СвОпГруз) Тогда
							НоваяСтрока.ОпасныеГрузыГиперссылка = "<редактировать>";
						Иначе
							НоваяСтрока.ОпасныеГрузыГиперссылка = "<добавить>";
						КонецЕсли;
					КонецЕсли;					
				КонецЦикла;
				
			ИначеЕсли ДанныеЗначения <> Неопределено Тогда
				
				ЭтаФорма[КлючФормы] = ДанныеЗначения; 
				
				// заполнение подчиненных реквизитов
				Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗначения)) Тогда
					
					ДанныеОбъекта = ДанныеОбъекта(ДанныеЗначения, КлючЗначение.Ключ);
					ЗаполнитьДанныеФормы(ДанныеОбъекта, ЭтаФорма, Ключ + "_", ЭтоОбычнаяФорма);
					
				КонецЕсли;
				
			Иначе
				
				ЭтаФорма[КлючФормы] = ДанныеЗначения; 
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КлючПредставление(Ключ) Экспорт
	
	Результат = СтрЗаменить(Ключ, "рл_", "пр_");
	Возврат Результат;

КонецФункции

Функция ЗначениеПредставление(Значение) Экспорт
	
	Результат = "";
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Если Значение.Свойство("Ссылка") И ЗначениеЗаполнено(Значение.Ссылка) Тогда
			Результат = Строка(Значение.Ссылка);
		Иначе
			ПорядокОбхода = Новый Массив;
			ПорядокОбхода.Добавить("РегНомер");
			ПорядокОбхода.Добавить("Марка"); 
			ПорядокОбхода.Добавить("ПарТС.Марка"); 
			ПорядокОбхода.Добавить("ФИО.Фамилия");
			ПорядокОбхода.Добавить("ФИО.Имя");
			ПорядокОбхода.Добавить("ФИО.Отчество");
			 
			ПорядокОбхода.Добавить("НаимДок");
			ПорядокОбхода.Добавить("НомерДок");
			ПорядокОбхода.Добавить("ДатаДок");
			  
			Для Каждого Ключ Из ПорядокОбхода Цикл
				Если ЕстьИЗаполненоСвойствоСтруктуры(Значение, Ключ) Тогда
					ЗначениеКлюча = ЕстьИЗначениеСвойствоСтруктуры(Значение, Ключ);
					Если Ключ = "ДатаДок" Тогда
						ЗначениеКлюча = Формат(ЗначениеКлюча, "ДЛФ=Д");
					Иначе
						ЗначениеКлюча = Строка(ЗначениеКлюча);
					КонецЕсли;
					
					Результат = СтрШаблонЛок("%1%2 ", Результат, ЗначениеКлюча);	
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;	
	Иначе
		Результат = Строка(Значение);
	КонецЕсли;
	                 
	Возврат СокрЛП(Результат);

КонецФункции

Функция ЗначениеПредставлениеПоСтрокеXML(Значение) Экспорт
	
	ЗначениеСтруктура = ДесериализоватьXML(Значение);
	Возврат ЗначениеПредставление(ЗначениеСтруктура);

КонецФункции

Процедура ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса)
	
	Если ТекстЗапроса <> "" Тогда
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Если ТипЗнч(СсылкаНаОбъект) = Тип("Массив") Тогда
			Индекс = 0;
			Для Каждого Значение Из СсылкаНаОбъект Цикл
				Индекс = Индекс + 1;
				Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), Значение); 
			КонецЦикла;
		Иначе
			Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПустойКонтрагент", Справочники.Контрагенты.ПустаяСсылка()); 
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить(); // через ТЗ, потому что нам нужны колонки.
		Если РезультатЗапроса.Количество() > 0 Тогда
			СтрокаДанных = РезультатЗапроса[0];
			Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл 
				ИмяКолонки = Колонка.Имя;				
				Значение = СтрокаДанных[Колонка.Имя];
				ОбработатьПоУчетнойСистеме(Результат, ИмяКолонки, Значение, НеОбработанные);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьПоУчетнойСистеме(Результат, Ключ, Значение, НеОбработанные, Перезаписать = Ложь)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		_Значение = Значение;
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
			Если Ключ = "СвТС_ТС"  Тогда
				_Значение = ДанныеТС(Значение, "ДопСв");
			ИначеЕсли Ключ = "СвТС_Прицеп" Тогда
				_Значение = ДанныеТС(Значение, "ДопСв");
			ИначеЕсли Ключ = "СвВодит1"
				Или Ключ = "СвВодит2"
				Или Ключ = "СвВодит3" Тогда
				_Значение = ДанныеВодителя(Значение, "ДопСв"); 
			КонецЕсли;            
		КонецЕсли;            
		
		КлючСТочкой = СтрЗаменить(Ключ, "_", ".");
		Если ЕстьСвойствоСтруктуры(НеОбработанные, КлючСТочкой) Или Перезаписать Тогда
			УстановитьЗначениеИзСтрокиВСтруктуру(Результат, Ключ, _Значение);
			УдалитьКлючИзСтрокиВСтруктуру(НеОбработанные, Ключ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, ТипСтруктуры, ДанныеПоОснованиюЗЗ = Неопределено)
			
	РезультатXML = ПолучитьЗначениеСведения(СсылкаНаОбъект, ТипСтруктуры, Истина);

	ДополнительныеСведения = ДесериализоватьXML(РезультатXML);
	
	Если ДополнительныеСведения.Количество() = 0 Тогда //пустая структура
		ЭтоНовыйДокумент = Истина;
		Если ДанныеПоОснованиюЗЗ <> Неопределено Тогда
			ДополнительныеСведения = ДанныеПоОснованиюЗЗ;
			УдалятьПустыеИзНеобработанных = Истина;
			ОбработатьПоДополнительнымСведениям(Результат, НеОбработанные, ДополнительныеСведения, УдалятьПустыеИзНеобработанных);
		КонецЕсли;
	Иначе   
		ЭтоНовыйДокумент = Ложь;
		ОбработатьПоДополнительнымСведениям(Результат, НеОбработанные, ДополнительныеСведения);
	КонецЕсли;
	
	Возврат ЭтоНовыйДокумент;
	
КонецФункции

Процедура ОбработатьПоДополнительнымСведениям(Результат, НеОбработанные, ДополнительныеСведения, УдалятьПустыеИзНеобработанных = Истина)
			
	Для Каждого КлючЗначение Из ДополнительныеСведения Цикл
		
		Если НеОбработанные <> Неопределено
			И НеОбработанные.Свойство(КлючЗначение.Ключ) Тогда
			
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				Значение = Новый Массив;
				Для Каждого ЭлементМассива Из КлючЗначение.Значение Цикл
					Значение.Добавить(ЭлементМассива);	
				КонецЦикла;                                                                     

				Результат.Вставить(КлючЗначение.Ключ, Значение);
				НеОбработанные.Удалить(КлючЗначение.Ключ);

			ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
				
				Если Результат.Свойство(КлючЗначение.Ключ) 
					И ТипЗнч(Результат[КлючЗначение.Ключ]) = Тип("Структура") Тогда
					Значение = Результат[КлючЗначение.Ключ];
				Иначе
					Значение = Новый Структура;
				КонецЕсли;
				
				ОбработатьПоДополнительнымСведениям(Значение, НеОбработанные[КлючЗначение.Ключ], КлючЗначение.Значение, УдалятьПустыеИзНеобработанных);
				Результат.Вставить(КлючЗначение.Ключ, Значение);
				
				Если ТипЗнч(НеОбработанные[КлючЗначение.Ключ]) = Тип("Структура") И НеОбработанные[КлючЗначение.Ключ].Количество() = 0 Тогда
					НеОбработанные.Удалить(КлючЗначение.Ключ);
				КонецЕсли;
				
			Иначе
								
				Если КлючЗначение.Значение <> Неопределено Тогда
					Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
					НеОбработанные.Удалить(КлючЗначение.Ключ);
				ИначеЕсли УдалятьПустыеИзНеобработанных Тогда
					Если ТипЗнч(НеОбработанные[КлючЗначение.Ключ]) = Тип("Структура")
						И НеОбработанные[КлючЗначение.Ключ].Количество() = 0 Тогда
						Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
						НеОбработанные.Удалить(КлючЗначение.Ключ);
					КонецЕсли;
				КонецЕсли;
								
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьНеОбработанные(Результат, НеОбработанные)
	
	// пока удалим необязательные поля Водитель2, Водитель3, Прицеп.
	// если они естьв необработанных, то значит не заполнены
	//Если НеОбработанные.Свойство("Прицеп") И ЗначениеЗаполнено(Прицеп.Прицеп) Тогда
	//	// если осталась только Ссылка, считаем что обработано
	//	//Если НеОбработанные.Прицеп.Количество() = 1 И НеОбработанные.Прицеп.Свойство("Ссылка") Тогда
	//	//Иначе
	//	//	НеОбработанные.Вставить("Прицеп", Неопределено);
	//	//КонецЕсли;
	//КонецЕсли;
	Если НеОбработанные.Свойство("СвВодит2") Тогда
		Если НеОбработанные.СвВодит2.Количество() = 1 И НеОбработанные.СвВодит2.Свойство("Ссылка") Тогда
		Иначе
			НеОбработанные.Вставить("СвВодит2", Неопределено);
		КонецЕсли;
	КонецЕсли;
	Если НеОбработанные.Свойство("СвВодит3") Тогда
		Если НеОбработанные.СвВодит3.Количество() = 1 И НеОбработанные.СвВодит3.Свойство("Ссылка") Тогда
		Иначе
			НеОбработанные.Вставить("СвВодит3", Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из НеОбработанные Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			Если Не Результат.Свойство(КлючЗначение.Ключ) Тогда
				Результат.Вставить(КлючЗначение.Ключ, Новый Структура);
			КонецЕсли;
			ЗаполнитьНеОбработанные(Результат[КлючЗначение.Ключ], КлючЗначение.Значение);
		Иначе
			Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗначениямиПользователяПоУмолчанию(Результат, НеОбработанные, Документ, КлючРеквизитов)
	                                                       
	ИмяПродукта = "КонтурЛогистика";
	МетаданныеДокумента = Документ.Метаданные().ПолноеИмя();
  	ИдентификаторНастройки = МетаданныеДокумента + "_" + КлючРеквизитов + "_";
	НазваниеНастройки = СтрШаблонЛок("%1_%2", ИмяПродукта, ИдентификаторНастройки); 
	Перезаписать = Истина; 
	
	ДанныеХранилищаЗначений = ДанныеХранилищаЗначений();
	
	Если ДанныеХранилищаЗначений.ИмяХранилища = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		Запрос.УстановитьПараметр("Ключ1", НазваниеНастройки + "%");
		ТекстЗапроса = "ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ХранилищеДанных." + ДанныеХранилищаЗначений.Ключ1 + " КАК СТРОКА(250)) КАК Ключ1
		|ИЗ
		|	РегистрСведений." + ДанныеХранилищаЗначений.ИмяХранилища + " КАК ХранилищеДанных
		|ГДЕ
		|	ВЫРАЗИТЬ(ХранилищеДанных." + ДанныеХранилищаЗначений.Ключ1 + " КАК СТРОКА(250)) ПОДОБНО &Ключ1";
	Иначе
		Запрос.УстановитьПараметр("Ключ1", ИмяПродукта);
		Запрос.УстановитьПараметр("Ключ2", ИдентификаторНастройки + "%");
		ТекстЗапроса = "ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ХранилищеДанных." + ДанныеХранилищаЗначений.Ключ1 + " КАК СТРОКА(250)) КАК Ключ1,
		|	ВЫРАЗИТЬ(ХранилищеДанных." + ДанныеХранилищаЗначений.Ключ2 + " КАК СТРОКА(250)) КАК Ключ2
		|ИЗ
		|	РегистрСведений." + ДанныеХранилищаЗначений.ИмяХранилища + " КАК ХранилищеДанных
		|ГДЕ
		|	ВЫРАЗИТЬ(ХранилищеДанных." + ДанныеХранилищаЗначений.Ключ1 + " КАК СТРОКА(250)) = &Ключ1
		|	И ВЫРАЗИТЬ(ХранилищеДанных." + ДанныеХранилищаЗначений.Ключ2 + " КАК СТРОКА(250)) ПОДОБНО &Ключ2";
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
			ИмяНастройки = СтрЗаменить(Выборка.Ключ1, НазваниеНастройки, "");
		Иначе
			ИмяНастройки = СтрЗаменить(СтрШаблонЛок("%1_%2", Выборка.Ключ1, Выборка.Ключ2), НазваниеНастройки, "");
		КонецЕсли;
		
		ЗначениеПоУмолчанию = ЗначениеПоУмолчанию(Документ, ИмяНастройки, КлючРеквизитов); 
		
		Если ЗначениеПоУмолчанию.ЗначениеРеквизита <> Неопределено Тогда
			
			Если ТипЗнч(ЗначениеПоУмолчанию.ЗначениеРеквизита) = Тип("Структура") Тогда
				Для Каждого КлючЗначение Из ЗначениеПоУмолчанию.ЗначениеРеквизита Цикл
					Значение = КлючЗначение.Значение;
					Ключ = КлючЗначение.Ключ;
					ОбработатьПоУчетнойСистеме(Результат, Ключ, Значение, НеОбработанные, Перезаписать);
				КонецЦикла;
			Иначе
				Если ЗначениеПоУмолчанию.ИмяРеквизита = "СвТС_ТС" 
					Или ЗначениеПоУмолчанию.ИмяРеквизита = "СвТС_Прицеп" Тогда
					Значение = ДанныеТС(ЗначениеПоУмолчанию.ЗначениеРеквизита, "ДопСв");
				ИначеЕсли ЗначениеПоУмолчанию.ИмяРеквизита = "СвВодит1"
					Или ЗначениеПоУмолчанию.ИмяРеквизита = "СвВодит2"
					Или ЗначениеПоУмолчанию.ИмяРеквизита = "СвВодит3" Тогда
					Значение = ДанныеВодителя(ЗначениеПоУмолчанию.ЗначениеРеквизита, "ДопСв");
				Иначе
					Значение = ЗначениеПоУмолчанию.ЗначениеРеквизита;
				КонецЕсли;
				
				Ключ = ЗначениеПоУмолчанию.ИмяРеквизита;
				ОбработатьПоУчетнойСистеме(Результат, Ключ, Значение, НеОбработанные, Перезаписать);
				Если (ЗначениеПоУмолчанию.ИмяРеквизита = "СвЗак_РекИдентЗак"
					Или ЗначениеПоУмолчанию.ИмяРеквизита = "СвЗак_ДогУслПер")
					И ЗначениеЗаполнено(Значение) Тогда
					Ключ = "СвГО_ГОЭксп";
					ОбработатьПоУчетнойСистеме(Результат, Ключ, 1, НеОбработанные, Перезаписать);
				ИначеЕсли ЗначениеПоУмолчанию.ИмяРеквизита = "СвПогруз_ВладИнфр_РекВладИнф"
					И ЗначениеЗаполнено(Значение) Тогда
					Ключ = "СвПогруз_ВладИнфр_СовпГОВ";
					ОбработатьПоУчетнойСистеме(Результат, Ключ, 2, НеОбработанные, Перезаписать);
				ИначеЕсли (ЗначениеПоУмолчанию.ИмяРеквизита = "СвПогруз_СвЛицПогрГр_РекЛицПогрГр"
					Или ЗначениеПоУмолчанию.ИмяРеквизита = "СвПогруз_СвЛицПогрГр_ОснПогрГр")
					И ЗначениеЗаполнено(Значение) Тогда
					Ключ = "СвПогруз_СвЛицПогрГр_СовпГОП";
					ОбработатьПоУчетнойСистеме(Результат, Ключ, 2, НеОбработанные, Перезаписать);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

Процедура ЗаполнитьЗначениямиПоУмолчанию(Результат, НеОбработанные)
	
