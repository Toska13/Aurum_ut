// Преобразует поток ЧтениеXML в структуру 1С.
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - поток чтения XML.
//
// Возвращаемое значение:
//  Структура - корневой узел XML и его содержимое.
//
Функция ЧтениеXML_В_Структуру(ЧтениеXML) Экспорт
	
	Результат = Новый Структура;
	
	Если ЧтениеXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Цикл
			Если НЕ ЧтениеXML.Прочитать() Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		
		Результат = ЧтениеXML_ПрочитатьУзелВЗначение(ЧтениеXML);
	Исключение

	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЧтениеXML_ПрочитатьУзелВЗначение(ЧтениеXML)
	
	Результат = Новый Структура;
	ТекстУзла = "";
	ЕстьДочерниеЭлементы = Ложь;
	
	XML_ПрочитатьАтрибутыУзла(Результат, ЧтениеXML);

	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ЕстьДочерниеЭлементы = Истина;
			ИмяУзла = XML_НормализоватьИмяУзла(ЧтениеXML.Имя);
			ЗначениеУзла = ЧтениеXML_ПрочитатьУзелВЗначение(ЧтениеXML);
			XML_ДобавитьЗначениеУзла(Результат, ИмяУзла, ЗначениеУзла);
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ТекстУзла = ТекстУзла + ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьДочерниеЭлементы И Результат.Количество() = 0 Тогда
		Возврат XML_СтрокаУзлаВЗначение(ТекстУзла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ПрочитатьАтрибутыУзла(Результат, ЧтениеXML)
		
	Если ЧтениеXML = Неопределено Тогда

	КонецЕсли;
		
	Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
		Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
			ИмяАтрибута = XML_НормализоватьИмяУзла(ЧтениеXML.Имя);
			Результат.Вставить(ИмяАтрибута, XML_СтрокаУзлаВЗначение(ЧтениеXML.Значение));
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Процедура XML_ДобавитьЗначениеУзла(Узел, ИмяУзла, ЗначениеУзла)
	
	Если НЕ Узел.Свойство(ИмяУзла) Тогда
		Узел.Вставить(ИмяУзла, ЗначениеУзла);
		Возврат;
	КонецЕсли;
	
	ТекущееЗначение = Узел[ИмяУзла];
	
	Если ТипЗнч(ТекущееЗначение) = Тип("Массив") Тогда
		ТекущееЗначение.Добавить(ЗначениеУзла);
	Иначе
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(ТекущееЗначение);
		МассивЗначений.Добавить(ЗначениеУзла);
		Узел.Вставить(ИмяУзла, МассивЗначений);
	КонецЕсли;
	
КонецПроцедуры

Функция XML_НормализоватьИмяУзла(ИмяУзла)
	
	Результат = СтрЗаменить(ИмяУзла, ".", "_");
	Результат = СтрЗаменить(Результат, ":", "_");
	
	Возврат Результат;
	
КонецФункции

Функция XML_СтрокаУзлаВЗначение(СтрокаЗначения)
	
	СтрокаСокр = СокрЛП(СтрокаЗначения);
	Если ПустаяСтрока(СтрокаСокр) Тогда
		Возврат "";
	КонецЕсли;
	
	ДатаИзСтроки = XML_ПопробоватьРазобратьДатуИзСтроки(СтрокаСокр);
	Если ДатаИзСтроки <> Неопределено Тогда
		Возврат ДатаИзСтроки;
	КонецЕсли;
	
	Возврат СтрокаСокр;
	
КонецФункции

Функция XML_ПопробоватьРазобратьДатуИзСтроки(СтрокаСокр)
	
	Длина = СтрДлина(СтрокаСокр);
	Если Длина < 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ISO 8601: yyyy-MM-dd или yyyy-MM-ddTHH:mm:ss…
	Если Длина >= 10 И Сред(СтрокаСокр, 5, 1) = "-" И Сред(СтрокаСокр, 8, 1) = "-" Тогда
		ЧастьДаты = Лев(СтрокаСокр, 10);
		Попытка
			Год = Число(Лев(ЧастьДаты, 4));
			Месяц = Число(Сред(ЧастьДаты, 6, 2));
			День = Число(Прав(ЧастьДаты, 2));
			Если Год > 0 И Месяц >= 1 И Месяц <= 12 И День >= 1 И День <= 31 Тогда
				Возврат Дата(Год, Месяц, День);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Российский формат: dd.MM.yyyy
	Если Длина = 10 И Сред(СтрокаСокр, 3, 1) = "." И Сред(СтрокаСокр, 6, 1) = "." Тогда
		Попытка
			День = Число(Лев(СтрокаСокр, 2));
			Месяц = Число(Сред(СтрокаСокр, 4, 2));
			Год = Число(Прав(СтрокаСокр, 4));
			Если Год > 0 И Месяц >= 1 И Месяц <= 12 И День >= 1 И День <= 31 Тогда
				Возврат Дата(Год, Месяц, День);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, СтрокаXML)
	
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", "");
	
КонецПроцедуры

Функция РазложитьСтрокуВМассивСлов(Знач Строка, РазделителиСлов = ",")
	
	Слова = Новый Массив;
	
	Для Сч = 1 По СтрДлина(РазделителиСлов) Цикл
		Строка = СтрЗаменить(Строка, Сред(РазделителиСлов, Сч, 1), Символы.ПС);
	КонецЦикла;
	
	Для Сч = 1 По СтрЧислоСтрок(Строка) Цикл
		
		ТекСлово = СокрЛП(СтрПолучитьСтроку(Строка, Сч));
		Если ТекСлово <> "" Тогда
			Слова.Добавить(ТекСлово);
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Слова;
	
КонецФункции

Функция НовыйОбъектXDTO(мФабрика, Тип_Основной, СоздатьВложенныеОбъекты = Ложь)
	
	Результат = мФабрика.Создать(Тип_Основной);
	
	Если СоздатьВложенныеОбъекты Тогда
		
		Для Каждого Эл Из Тип_Основной.Свойства Цикл
			
	        флСвойствоНеСписковое =	(Эл.ВерхняяГраница = 1);
			
			Если Эл.Тип.URIПространстваИмен = Тип_Основной.URIПространстваИмен 
				И флСвойствоНеСписковое	Тогда
				
				Если ТипЗнч(Эл.Тип) = Тип("ТипОбъектаXDTO") Тогда //вложенные свойства создаем только для объектов
					Результат[Эл.Имя] = НовыйОбъектXDTO(мФабрика, Эл.Тип, СоздатьВложенныеОбъекты);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйДочернийОбъектXDTO(Фабрика, Родитель, ИмяЭлемента, ЗначениеЭлемента = Неопределено)
	
	СвойствоДочернего	 = Родитель.Тип().Свойства.Получить(ИмяЭлемента);
	ТипДочернего		 = СвойствоДочернего.Тип;
	ЭтоСписок			 = СвойствоДочернего.ВерхняяГраница <> 1;
	
	Если ЗначениеЭлемента = Неопределено Тогда
		Результат = Фабрика.Создать(ТипДочернего);
	Иначе
		Результат = Фабрика.Создать(ТипДочернего, ЗначениеЭлемента);
	КонецЕсли;
	
	Если ЭтоСписок Тогда
		Родитель[ИмяЭлемента].Добавить(Результат);
	Иначе
		Родитель[ИмяЭлемента] = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ФабрикаXDTO_Инициализировать(ФорматДок) Экспорт
	
	Отладка = Ложь;
	
	МассивСхемXML = Новый Массив;
	
	Если ФорматДок = "__etrnTitle1" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__etrnTitle1");
		МассивПакетов.Добавить("__etrnTitle2_Transporter");
		
	ИначеЕсли ФорматДок = "__etrnTitle3_Receiver" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__etrnTitle3_Receiver");
		
	ИначеЕсли ФорматДок = "__zzTitle1" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__zzTitle1");
		МассивПакетов.Добавить("__zzTitle2");
		
	ИначеЕсли ФорматДок = "__kl_porek_wt3_05_02_01" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__kl_porek_wt3_05_02_01");
		
	КонецЕсли;
	
	НаборСхемXML = Новый НаборСхемXML;
	
	Для Каждого ИмяМакета Из МассивПакетов Цикл 
		
		ТекстМакета	 = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстМакета);
		
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		ПостроительСхемXML = Новый ПостроительСхемXML;
		СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
		
		НаборСхемXML.Добавить(СхемаXML);
		
	КонецЦикла;
	
	ФабрикаXDTOНакладной = Новый ФабрикаXDTO(НаборСхемXML);
	
КонецПроцедуры

