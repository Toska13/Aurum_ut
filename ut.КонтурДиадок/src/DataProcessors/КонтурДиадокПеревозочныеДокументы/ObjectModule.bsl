		Если ЕстьИЗаполненоСвойствоСтруктуры(СведениеОбОпасномГрузе, "ДатИстВрУдер") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ДатИстВрУдер", Формат_ДатаДляXml(СведениеОбОпасномГрузе.ДатИстВрУдер));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СвКонтейн(СписокXDTO, ДанныеГруза)
	
	СведенияКонтейнеры = ДанныеГруза.СвКонтейн;
	
	Для Каждого СведениеКонтейнер Из СведенияКонтейнеры Цикл
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КолКонтейн", СведениеКонтейнер, "КолКонтейн");
		
		Если ТипЗнч(СведениеКонтейнер.ИдКонтейн) = Тип("Массив") Тогда
			Для Каждого ИдентификаторКонтейнера Из СведениеКонтейнер.ИдКонтейн Цикл
				ДобавитьСтрокуВСписокXDTO(ЭлементXDTO.ИдКонтейн, Строка(ИдентификаторКонтейнера));
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(СведениеКонтейнер.ИдКонтейн) Тогда
			ДобавитьСтрокуВСписокXDTO(ЭлементXDTO.ИдКонтейн, Строка(СведениеКонтейнер.ИдКонтейн));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СвКонтейн_ПЭ(СписокXDTO, ДанныеГруза, НомКонтейн)
	
	СведенияКонтейнеры = ДанныеГруза.СвКонтейн;
	
	Для Каждого СведениеКонтейнер Из СведенияКонтейнеры Цикл
		НомКонтейн = НомКонтейн + 1;
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);

		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НомКонтейн", Строка(НомКонтейн));
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ИдКонтейнНест", СведениеКонтейнер, "ИдКонтейн");
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ИспКонтейн", "2");
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ПредКонтейн", "2");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СопрДок(СписокXDTO, ТрНСтруктура)
	
	Для Каждого СопроводительныйДокумент Из ТрНСтруктура.СопрДок Цикл
		
		СписокТипСопрДок = СписокТипСопрДок();
		КодТипСопрДок = СписокТипСопрДок[СопроводительныйДокумент.ТипСопрДок];
		Если КодТипСопрДок = Неопределено Тогда
			КодТипСопрДок = СопроводительныйДокумент.ТипСопрДок;
		КонецЕсли;
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO[КодТипСопрДок]);
		ДоговорСтруктура = РеквДокТип(); //"Составитель документа"
		ЗаполнитьЗначенияСвойств(ДоговорСтруктура, СопроводительныйДокумент);
		ЗаполнитьXDTO_РеквДокТип(ЭлементXDTO, СопроводительныйДокумент.ИдРекСост, ДоговорСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СопрДок_ПЭ(СписокXDTO, ПЭСтруктура)
	
	Для Каждого СопроводительныйДокумент Из ПЭСтруктура.СопрДок Цикл
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
		ДоговорСтруктура = РеквДокТипПЭ(); //"Составитель документа"
		ЗаполнитьЗначенияСвойств(ДоговорСтруктура, СопроводительныйДокумент);
		ЗаполнитьXDTO_РеквДокТип_ПЭ(ЭлементXDTO, Неопределено, ДоговорСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_АдрПункт(СписокXDTO, АдрПункт)
	
	ПорНомПункт = 0;
	//свернем одинаковые адреса
	Пункты = Новый ТаблицаЗначений;
	Пункты.Колонки.Добавить("Адрес");
	Пункты.Колонки.Добавить("Опер");
	Пункты.Колонки.Добавить("ДатВрОпер");
	
	Для Каждого Пункт Из АдрПункт Цикл
		
		Поиск = Новый Структура("Опер, Адрес, ДатВрОпер", Пункт.Опер, Пункт.АдресПункт.Адрес.АдрИнф.АдрТекст, Пункт.ДатВрОпер);
		Если Пункты.НайтиСтроки(Поиск).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;		                                                                      
		
		ПорНомПункт = ПорНомПункт + 1;
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
		ЭлементXDTO.Опер = Пункт.Опер;
		ЭлементXDTO.ПорНомПункт = Формат(ПорНомПункт, "ЧГ=");
		Если ЗначениеЗаполнено(Пункт.ДатВрОпер) Тогда
			ЭлементXDTO.ДатВрОпер = Формат_ДатаВремяСоСмещениемUTCДляXml(Пункт.ДатВрОпер);
			ЭлементXDTO.НалКоорТочВрОпер = "1";
		КонецЕсли;
		
		Если Пункт.Опер = "Погрузка" Тогда
			Если ЕстьИЗаполненоСвойствоСтруктуры(Пункт, "ОргВладИнфр.ИдСв.СвЮЛУч.ИННЮЛ") Тогда
				ЭлементXDTO.ОргВладИнфр.ИННВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвЮЛУч.ИННЮЛ; 
				ЭлементXDTO.ОргВладИнфр.НаимВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвЮЛУч.НаимОрг;
			ИначеЕсли ЕстьИЗаполненоСвойствоСтруктуры(Пункт, "ОргВладИнфр.ИдСв.СвФЛУчаст.ИННФЛ") Тогда
				ЭлементXDTO.ОргВладИнфр.ИННВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвФЛУчаст.ИННФЛ; 
				ЭлементXDTO.ОргВладИнфр.НаимВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвФЛУчаст.ФИО.Фамилия;
			ИначеЕсли ЕстьИЗаполненоСвойствоСтруктуры(Пункт, "ОргВладИнфр.ИдСв.СвИП.ИННФЛ") Тогда
				ЭлементXDTO.ОргВладИнфр.ИННВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвИП.ИННФЛ; 
				ЭлементXDTO.ОргВладИнфр.НаимВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвИП.ФИО.Фамилия;
			КонецЕсли;                         
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Пункт.ПредВрОпер) Тогда
			ЭлементXDTO.ПредВрОпер = Формат_ВремяСоСмещениемUTCДляXml(Пункт.ПредВрОпер);          
			ЭлементXDTO.НалКоорТочПредВрОпер = "1";
		КонецЕсли;
		
		КодСтраны 	= ЕстьИЗначениеСвойствоСтруктуры(Пункт, "АдресПункт.Адрес.АдрИнф.КодСтр");
		Адрес 		= ЕстьИЗначениеСвойствоСтруктуры(Пункт, "АдресПункт.Адрес.АдрИнф.АдрТекст");
		АдресРФ		= ЕстьИЗначениеСвойствоСтруктуры(Пункт, "АдресПункт.Адрес.АдрРФ");
		ЗаполнитьXDTO_Адрес(ЭлементXDTO.АдресПункт.Адрес, Адрес, АдресРФ, КодСтраны);
		
		СтрокаПункта = Пункты.Добавить();
		СтрокаПункта.Адрес = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "АдресПункт.Адрес.АдрИнф.АдрТекст");
		СтрокаПункта.Опер = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "Опер");
		СтрокаПункта.ДатВрОпер = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "ДатВрОпер");

	КонецЦикла;                                                        			
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_УказГО(XDTO, ТрНСтруктура)
	
	УказГО = ТрНСтруктура.УказГО;
		
	Если ЗначениеЗаполнено(УказГО.ОгрСкор) Тогда
		XDTO.ОгрСкор = УказГО.ОгрСкор;              
	КонецЕсли;               
	
	УкНормПрвз = СокрЛП(УказГО.УкНормПрвз);
	Если УкНормПрвз = "" Тогда
		УкНормПрвз = "Отсутствуют";
	КонецЕсли;
	XDTO.УкНормПрвз = УкНормПрвз; 
		
	XDTO.ЗапрПерегруз = "1"; 

	// переадресация
	ЗаполнитьXDTO_СвПА(XDTO.СвПА, ТрНСтруктура);

	// маршрут перевозки
	ЗаполнитьXDTO_МршПрвз(XDTO, ТрНСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_УказКлнт(ЭлементXDTO, СвГруз)
	
	УказКлнт = СвГруз.УказКлнт;

	ОгрСкор = СокрЛП(УказКлнт.ОгрСкор);
	Если ОгрСкор = "" Тогда
		ОгрСкор = "Нет";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УказКлнт.ОгрСкор) Тогда
		ЭлементXDTO.ОгрСкор = УказКлнт.ОгрСкор;              
	КонецЕсли;               
	
	УкНормПрвз = СокрЛП(УказКлнт.УкНормПрвз);
	Если УкНормПрвз = "" Тогда
		УкНормПрвз = "Отсутствуют";
	КонецЕсли;
	ЭлементXDTO.Отмет = "Отсутствуют";
	ЭлементXDTO.УкНормПрвз = УкНормПрвз; 
    ЗаполнитьXDTO_КлимРеж_ПЭ(ЭлементXDTO.КлимРеж, СвГруз);

КонецПроцедуры

Процедура ЗаполнитьXDTO_СвПА(XDTO, ТрНСтруктура)

	XDTO.ЛицоПА = "Грузоотправитель";
	XDTO.СпосПерУкПА = "Электронное уведомление перевозчика о переадресовке";

	Телефоны 	= ТрНСтруктура.СвГО.РекИдентГО.Контакт.Тлф;
	АдресаЭП	= ТрНСтруктура.СвГО.РекИдентГО.Контакт.ЭлПочта;
	
	ЗаполнитьXDTO_Контакт(XDTO.КонтПА, Телефоны, АдресаЭП, Неопределено);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_МршПрвз(XDTO, ТрНСтруктура)
	
	Если ТрНСтруктура.Свойство("МаршрутТекст")
		И ЗначениеЗаполнено(ТрНСтруктура.МаршрутТекст) Тогда 
		
		XDTO.МршПрвз.МршТекст = ТрНСтруктура.МаршрутТекст;
		XDTO.МршПрвз.МршМашЧит = ТрНСтруктура.МаршрутМашиночитаемый;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СвВодит(СписокXDTO, ТрНСтруктура)
	
	СведенияОВодителях = Новый Массив;
	Если ЗначениеЗаполнено(ТрНСтруктура.СвВодит1) Тогда
		СведенияОВодителях.Добавить(ТрНСтруктура.СвВодит1);	
	КонецЕсли;
	Если ЗначениеЗаполнено(ТрНСтруктура.СвВодит2)
		И (ЗначениеЗаполнено(ТрНСтруктура.СвВодит2.ИННФЛ)
		Или ЗначениеЗаполнено(ТрНСтруктура.СвВодит2.НомВУ)) Тогда
		СведенияОВодителях.Добавить(ТрНСтруктура.СвВодит2);	
	КонецЕсли;
	Если ЗначениеЗаполнено(ТрНСтруктура.СвВодит3)
		И (ЗначениеЗаполнено(ТрНСтруктура.СвВодит3.ИННФЛ)
		Или ЗначениеЗаполнено(ТрНСтруктура.СвВодит3.НомВУ)) Тогда
		СведенияОВодителях.Добавить(ТрНСтруктура.СвВодит3);	
	КонецЕсли;
	
	Для Каждого СвВодит Из СведенияОВодителях Цикл 
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
		
		Если ЗначениеЗаполнено(СвВодит.ДатаВыдВУ) Тогда 
			ЭлементXDTO.ДатаВыдВУ = Формат_ДатаДляXml(СвВодит.ДатаВыдВУ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвВодит.ИННФЛ) Тогда 
			ЭлементXDTO.ИННФЛ = СвВодит.ИННФЛ;
		КонецЕсли;
		Если ЗначениеЗаполнено(СвВодит.НомВУ) Тогда 
			ЭлементXDTO.НомВУ = СвВодит.НомВУ;
		КонецЕсли;
		Если ЗначениеЗаполнено(СвВодит.СерВУ) Тогда 
			ЭлементXDTO.СерВУ = СвВодит.СерВУ;
		КонецЕсли;
		
		Если СвВодит.Тлф <> Неопределено Тогда 
			ЗаполнитьСписокXDTOПоМассивуСтрок(ЭлементXDTO.Тлф, СвВодит.Тлф);
		КонецЕсли;
		ЗаполнитьСписокXDTO_ПутевойЛист(ЭлементXDTO.ПутевойЛист, ТрНСтруктура);
		ЗаполнитьXDTO_ФИО(ЭлементXDTO.ФИО, СвВодит.ФИО);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTOПоМассивуСтрок(СписокXDTO, МассивСтрок)
		
	Для Каждого Строка Из МассивСтрок Цикл 
		
		ДобавитьСтрокуВСписокXDTO(СписокXDTO, Строка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_ПутевойЛист(СписокXDTO, ТрНСтруктура)
	
	ПутевойЛист = ТрНСтруктура.ПутевойЛист;
	
	ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
	Если ЗначениеЗаполнено(ПутевойЛист.НаимДок)
		И ЗначениеЗаполнено(ПутевойЛист.НомерДок)
		И ЗначениеЗаполнено(ПутевойЛист.ДатаДок) Тогда
		ЭлементXDTO.НаимДок = ПутевойЛист.НаимДок;
		ЭлементXDTO.НомерДок = ПутевойЛист.НомерДок;
		ЭлементXDTO.ДатаДок = Формат_ДатаДляXml(ПутевойЛист.ДатаДок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПутевойЛист.ИдРекСост) Тогда
		СписокИдРекСост = Новый Массив;
		СписокИдРекСост.Добавить(ПутевойЛист.ИдРекСост);
		ЗаполнитьСписокXDTO_ИдентРек(ЭлементXDTO.ИдРекСост, СписокИдРекСост);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_ИдентРек(ИдентРек, СписокИдРекСост) 
	
	Для Каждого ИдРекСост Из СписокИдРекСост Цикл
		XDTO = НовыйЭлементСпискаXDTO(ИдентРек);
		ЗаполнитьXDTO_ИдентРек(XDTO, ИдРекСост);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ИдентРек(XDTO, Участник) 
	
	Если Участник <> Неопределено Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИННЮЛ", Участник, "ИдСв.СвЮЛУч.ИННЮЛ");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИННФЛ", Участник, "ИдСв.СвФЛУчаст.ИННФЛ");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИННФЛ", Участник, "ИдСв.СвИП.ИННФЛ");
		
		Если Участник.Свойство("ИНН") Тогда
			Если СтрДлина(Участник.ИНН) = 12 Тогда
				ЗаполнитьXDTO_СПроверкой(XDTO, "ИННФЛ", Участник.ИНН);
			Иначе //минимум 10
				ЗаполнитьXDTO_СПроверкой(XDTO, "ИННЮЛ", XDTO_ОграничениеСтроки(Участник.ИНН, 10));
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;                         
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвТС(XDTO, ТрНСтруктура)
	
	ЗаполнитьXDTO_ТС(XDTO.ТС, ТрНСтруктура.СвТС.ТС);
	Если ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура,"СвТС.Прицеп.Ссылка")
		Или ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура,"СвТС.Прицеп.РегНомер") Тогда
		ЗаполнитьСписокXDTO_Прицеп(XDTO.Прицеп, ТрНСтруктура.СвТС.Прицеп);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ТС(XDTO, ТС)

	Если ЕстьИЗаполненоСвойствоСтруктуры(ТС, "НомСТС") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "НомСТС", СтрЗаменить(ТС.НомСТС, " ", ""));           
	КонецЕсли;
	Если ЕстьИЗаполненоСвойствоСтруктуры(ТС, "НомерВИН") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "НомерВИН", СтрЗаменить(ТС.НомерВИН, " ", ""));           
	КонецЕсли;
	Если ЕстьИЗаполненоСвойствоСтруктуры(ТС, "РегНомер") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "РегНомер", СтрЗаменить(ТС.РегНомер, " ", ""));           
	КонецЕсли;
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(ТС, "ТипВлад") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "ТипВлад", ТС.ТипВлад);           
		Если ТС.ТипВлад = "3"
			Или ТС.ТипВлад = "4"
			Или ТС.ТипВлад = "5" Тогда
			//обязательно
			Если ЕстьИЗаполненоСвойствоСтруктуры(ТС, "ОснАрЛиз") Тогда
				//И ЕстьИЗаполненоСвойствоСтруктуры(ТС, "ОснАрЛизВлад") Тогда
				ЭлементXDTO = НовыйЭлементСпискаXDTO(XDTO.ОснАрЛиз);
				ЗаполнитьXDTO_РеквДокТип(ЭлементXDTO, ТС.ОснАрЛиз.ИдРекСост, ТС.ОснАрЛиз);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(ТС, "ПарТС") Тогда 
		ЗаполнитьXDTO_ПарТСТип(XDTO.ПарТС, ТС.ПарТС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ПарТСТип(XDTO_ПарТС, ПарТС)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Вместим", ПарТС, "Вместим");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Тип", ПарТС, "Тип");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Грузопод", ПарТС, "Грузопод");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Марка", ПарТС, "Марка");
	  	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_Прицеп(СписокXDTO, Прицеп)
	
	ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
	ЗаполнитьXDTO_ТС(ЭлементXDTO, Прицеп);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвТС_ПЭ(ЭлементXDTO_СвГруз, СвГруз)
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(СвГруз, "СвТС.ВидТС") Тогда
		ВидТС = СвГруз.СвТС.ВидТС;
		СписокВыбораВидТС = СписокВыбораВидТС();
		КодВидТС = СписокВыбораВидТС[ВидТС];
		Если КодВидТС <> Неопределено Тогда 
			ЭлементXDTO_СвТС = НовыйЭлементСпискаXDTO(ЭлементXDTO_СвГруз.СвТС);
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвТС, "ВидТС", КодВидТС);
			Если КодВидТС = "1" Или КодВидТС = "4" Тогда
				ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвТС, "ТипКузов", СвГруз, "СвТС.ТипКузов");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвПогруз(XDTO, ТрНСтруктура)
	
	СвПогруз = ТрНСтруктура.СвПогруз;
	
	// по формату не более 4 разрядов в числе
	Если ЗначениеЗаполнено(СвПогруз.КолМестПрием)
		Или СвПогруз.КолМестПрием = 0 Тогда
		XDTO.КолМестПрием = Мин(СвПогруз.КолМестПрием, 9999);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвПогруз.МасБрутОтгр) Или СвПогруз.МасБрутОтгр = 0 Тогда
		XDTO.МасБрутОтгр 	= СвПогруз.МасБрутОтгр;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(СвПогруз.МетОпрМасс)) Тогда
		XDTO.МетОпрМасс 	= СокрЛП(СвПогруз.МетОпрМасс);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвПогруз.ФДатВрПриб) Тогда
		XDTO.ФДатВрПриб 	= Формат_ДатаВремяСоСмещениемUTCДляXml(СвПогруз.ФДатВрПриб);
	КонецЕсли;
	XDTO.НалКоорТочВрФПогр 	= "1";

	Если ЗначениеЗаполнено(СвПогруз.ЗаявПогр) Тогда
		XDTO.ЗаявПогр 	= Формат_ДатаВремяСоСмещениемUTCДляXml(СвПогруз.ЗаявПогр);
	КонецЕсли;
	XDTO.НалКоорТочВрЗаяв 	= "1";
	
	Если ЗначениеЗаполнено(СвПогруз.ФДатВрУбыт) Тогда
		XDTO.ФДатВрУбыт 	= Формат_ДатаВремяСоСмещениемUTCДляXml(СвПогруз.ФДатВрУбыт);
	КонецЕсли;
	XDTO.НалКоорТочВрФУбыт 	= "1";
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ФСостТар", СвПогруз, "ФСостТар");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ФСостУп", СвПогруз, "ФСостУп");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ФСостКуз", СвПогруз, "ФСостКуз");
	
	ЗаполнитьXDTO_ВладИнфр(XDTO.ВладИнфр, ТрНСтруктура);
	ЗаполнитьXDTO_СвЛицПогрГр(XDTO.СвЛицПогрГр, ТрНСтруктура);
	
	КодСтраны 	= СвПогруз.ФАдресПогр.КодСтраны;
	Адрес 		= СвПогруз.ФАдресПогр.Адрес;
	АдресРФ		= СвПогруз.ФАдресПогр.АдресРФ;
	ЗаполнитьXDTO_АдресПогрузки(XDTO.ФАдресПогр, Адрес, АдресРФ, КодСтраны);
	
	ЗаполнитьXDTO_РеквизитыДокумента(XDTO.ОснДостОбИнфрДок, СвПогруз.ОснДостОбИнфрДок);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ПунктПод(XDTO, ПунктПод)
	
	Если ЗначениеЗаполнено(ПунктПод.ДатВрПод) Тогда
		XDTO.ДатВрПод = Формат_ДатаВремяСоСмещениемUTCДляXml(ПунктПод.ДатВрПод);  
		XDTO.НалКоорТочВрПод = "1"; 
		XDTO.НалКоорТочПредВрПод = "1"; 
	КонецЕсли;
	
	КодСтраны 	= ПунктПод.АдрПунктПод.Адрес.АдрИнф.КодСтр;
	Адрес 		= ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст;
	АдресРФ		= ПунктПод.АдрПунктПод.Адрес.АдрРФ;
	ЗаполнитьXDTO_Адрес(XDTO.АдрПунктПод.Адрес, Адрес, АдресРФ, КодСтраны);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ВладИнфр(XDTO, ТрНСтруктура)
	
	ВладИнфр = ТрНСтруктура.СвПогруз.ВладИнфр; 
	
	Если ВладИнфр.СовпГОВ = 1 Тогда 
		XDTO.СовпГОВ = "1";
	Иначе
		XDTO.СовпГОВ = "2";
	КонецЕсли;
	//XDTO.СовпГОВ = "3";// когда лицо неизвестно не обрабатываем
	
	Если XDTO.СовпГОВ = "1" Тогда
		ЗаполнитьXDTO_ИдентРек(XDTO.ИдентРекГО, ТрНСтруктура.СвГО.РекИдентГО);
	Иначе
		ЗаполнитьXDTO_УчастникТрНТип(XDTO.РекВладИнф, ВладИнфр.РекВладИнф);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьXDTO_СвЛицПогрГр(XDTO, ТрНСтруктура)
	
	СвЛицПогрГр = ТрНСтруктура.СвПогруз.СвЛицПогрГр;
	
	Если СвЛицПогрГр.СовпГОП = 1 Тогда 
		XDTO.СовпГОП = "1";
	Иначе
		XDTO.СовпГОП = "2";
	КонецЕсли;

	Если XDTO.СовпГОП = "1" Тогда
		ЗаполнитьXDTO_ИдентРек(XDTO.ИдентРекГО, ТрНСтруктура.СвГО.РекИдентГО);
		Если ЕстьИЗаполненоСвойствоСтруктуры(СвЛицПогрГр, "РабЛицПогрГр") Тогда
			ЗаполнитьXDTO_РабЛицПогрГр(XDTO.РабЛицПогрГр, СвЛицПогрГр.РабЛицПогрГр);		
		КонецЕсли;
	Иначе
		ЗаполнитьXDTO_УчастникТрНТип(XDTO.РекЛицПогрГр, СвЛицПогрГр.РекЛицПогрГр);
		ЗаполнитьXDTO_РеквДокТип(XDTO.ОснПогрГр, СвЛицПогрГр.РекЛицПогрГр, СвЛицПогрГр.ОснПогрГр);
		ЗаполнитьXDTO_РабЛицПогрГр(XDTO.РабЛицПогрГр, СвЛицПогрГр.РабЛицПогрГр);		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_РабЛицПогрГр(XDTO, РабЛицПогрГр)
	
	// фамилия обязательна, заполняем только при условии наличия фамилии, иначе ошибка
	Если ЕстьИЗаполненоСвойствоСтруктуры(РабЛицПогрГр, "ФИО.Фамилия") Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "Должность", РабЛицПогрГр, "Должность");
		ЗаполнитьXDTO_СПроверкой(XDTO, "ОДолжОб", "Должностные обязанности");
		ЗаполнитьXDTO_ФИО(XDTO.ФИО, РабЛицПогрГр.ФИО)                          
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ОтметГО(XDTO, ТрНСтруктура)
	
	// TODO необязательный блок
	
КонецПроцедуры

