		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Номенклатура", Истина, "Номенклатура", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "КолГрМест", Истина, "Кол-во грузовых мест", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Объем", Истина, "Объем", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "МасГруз.МасБрутЗнач", Истина, "Масса брутто", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "РазмерГрМест.ВысЗнач", Истина, "Высота груза", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "РазмерГрМест.ДлЗнач", Истина, "Длина груза", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "РазмерГрМест.ШирЗнач", Истина, "Ширина груза", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СостГруз", Истина, "Состояние груза", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ВидТар", Истина, "Вид тары", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "техДокОсн", Истина, "Документ", , ИмяРеквизитаТЧ);
	ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда		
		ИмяРеквизитаТЧ = "рл_СвГруз_ОпГруз";
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Номенклатура", Истина, "Номенклатура", , ИмяРеквизитаТЧ);       
