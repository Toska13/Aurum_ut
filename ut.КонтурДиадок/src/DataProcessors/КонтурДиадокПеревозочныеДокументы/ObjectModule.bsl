	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "Имя", ФИО, "Имя");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "Фамилия", ФИО, "Фамилия");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "Отчество", ФИО, "Отчество");
	
