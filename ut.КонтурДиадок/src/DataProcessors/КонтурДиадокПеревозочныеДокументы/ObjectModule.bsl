Функция АдресВСтруктуру(ЗначенияПолей, Представление)
	
	ДанныеАдреса = Новый Структура;
	
	Модуль_УправлениеКонтактнойИнформациейКлиентСервер = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейКлиентСервер");
	Модуль_УправлениеКонтактнойИнформациейСлужебный = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейСлужебный");
	
	Если ПустаяСтрока(ЗначенияПолей) Тогда
		ДанныеАдреса = Новый Структура;
	ИначеЕсли Модуль_УправлениеКонтактнойИнформациейКлиентСервер <> Неопределено
		И Модуль_УправлениеКонтактнойИнформациейСлужебный <> Неопределено Тогда
		
		Если Модуль_УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(ЗначенияПолей) Тогда
			ДанныеАдреса = Модуль_УправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(ЗначенияПолей, ТипКонтактнойИнформации_Адрес());
		Иначе
			ТипКонтактнойИнформации = ТипКонтактнойИнформации_Адрес();
			XDTOКонтактная = ИзвлечьСтарыйФорматАдреса(ЗначенияПолей, Представление);
			ДанныеАдреса = Модуль_УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияВСтруктуруJSON(XDTOКонтактная, ТипКонтактнойИнформации);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеАдреса;
	
КонецФункции

Функция ИзвлечьСтарыйФорматАдреса(Знач ЗначенияПолей, Знач Представление)
	
	Перем XDTOКонтактная, РезультатыЧтения;
	
	ТипКонтактнойИнформации = ТипКонтактнойИнформации_Адрес();
	Страна = ОсновнаяСтрана();
	ОсновнаяСтрана = ОсновнаяСтрана();
	Комментарий = Неопределено;

	Модуль_УправлениеКонтактнойИнформациейКлиентСервер = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейКлиентСервер");
	Модуль_УправлениеКонтактнойИнформацией = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейЛокализация");
	Если Модуль_УправлениеКонтактнойИнформацией = Неопределено Тогда
		Модуль_УправлениеКонтактнойИнформацией = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейСлужебный");
	КонецЕсли;
	Модуль_ОбщегоНазначения = ОбщийМодульПоИмениЛок("ОбщегоНазначения"); 
	
	Если Модуль_УправлениеКонтактнойИнформациейКлиентСервер <> Неопределено
		И Модуль_УправлениеКонтактнойИнформацией <> Неопределено
		И Модуль_ОбщегоНазначения <> Неопределено Тогда
		
		Если Модуль_УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(ЗначенияПолей)
			И ТипКонтактнойИнформации = ТипКонтактнойИнформации_Адрес() Тогда
			РезультатыЧтения = Новый Структура;
			XDTOКонтактная = Модуль_УправлениеКонтактнойИнформацией.КонтактнаяИнформацияИзXML(ЗначенияПолей, ТипКонтактнойИнформации, РезультатыЧтения);
			Если РезультатыЧтения.Свойство("ТекстОшибки") Тогда
				// Распознали с ошибками, сообщим при открытии.
				ТекстПредупрежденияПриОткрытии = РезультатыЧтения.ТекстОшибки;
				XDTOКонтактная.Представление   = Представление;
				XDTOКонтактная.Состав.Страна   = Модуль_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнаяСтрана, "Наименование");
			КонецЕсли;
		Иначе
			XDTOКонтактная = Модуль_УправлениеКонтактнойИнформацией.АдресXMLВXDTO(ЗначенияПолей, Представление, );
			Если ЗначениеЗаполнено(Страна) Тогда
				Если ТипЗнч(Страна) = ТипЗнч(Справочники["СтраныМира"].ПустаяСсылка()) Тогда
					СтранаСсылка = Страна; // СправочникСсылка.СтраныМира
					XDTOКонтактная.Состав.Страна = Модуль_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтранаСсылка , "Наименование");
				Иначе
					XDTOКонтактная.Состав.Страна = Строка(Страна);
				КонецЕсли;
			Иначе
				XDTOКонтактная.Состав.Страна = Модуль_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнаяСтрана, "Наименование");
			КонецЕсли;
		КонецЕсли;
		Если Комментарий <> Неопределено Тогда
			// Ставим новый комментарий, иначе он придет из информации.
			XDTOКонтактная.Комментарий = Комментарий;
		КонецЕсли;
		
	КонецЕсли;

	Возврат XDTOКонтактная;

КонецФункции


Процедура УстановитьЗначениеСвойстваПоУмолчанию(Результат, НеОбработанные, Ключ, Значение)

	Если ЕстьСвойствоСтруктуры(НеОбработанные, Ключ) Тогда
		УстановитьЗначениеСвойстваСтруктуры(Результат, Ключ, Значение);
		КлючСПодчеркиванием = СтрЗаменить(Ключ, ".", "_");
		УдалитьКлючИзСтрокиВСтруктуру(НеОбработанные, КлючСПодчеркиванием);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗначениеСвойстваПоПоиску(Результат, НеОбработанные, Ключ, КлючПоиска)

	Если НеОбработанные.Свойство(Ключ) Тогда
		Если КлючПоиска = "ГосНомерТС" И Ключ = "СвТС_ТС" Тогда
			Если Результат.Свойство(КлючПоиска)
				И Результат.Свойство(Ключ)
				И ИмяСправочникаТранспортныеСредства() <> Неопределено Тогда 
				ЗначениеСсылки = Справочники[ИмяСправочникаТранспортныеСредства()].НайтиПоКоду(Результат[КлючПоиска]); 
				Если ЗначениеЗаполнено(ЗначениеСсылки) Тогда
					Результат.Вставить(Ключ, ДанныеОбъекта(ЗначениеСсылки, Ключ));
					НеОбработанные.Удалить(Ключ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПараметрВСтруктуру(Результат, Префикс, ИмяСвойства, ИмяПараметра, ЗначениеПараметра)
	
	Если Префикс = "" Тогда
		Ключ = СтрШаблонЛок("%1.%2", ИмяСвойства, ИмяПараметра);
	Иначе
		Ключ = СтрШаблонЛок("%1.%2.%3", Префикс, ИмяСвойства, ИмяПараметра);
	КонецЕсли;
		
	УстановитьЗначениеСвойстваСтруктуры(Результат, Ключ, ЗначениеПараметра);
	
КонецПроцедуры

Процедура ЗаменитьСсылкиНаСтруктуры(Результат, ДанныеОбъекта) Экспорт 
		
	Для Каждого КлючЗначение Из ДанныеОбъекта Цикл
		Если КлючЗначение.Ключ <> "СсылкаНаОбъект" Тогда
			
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				
				РезультатМассив = Новый Массив;
				Для Каждого ЭлементМассива Из КлючЗначение.Значение Цикл
					
					Если ЭлементМассива <> Неопределено 
						И Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭлементМассива)) Тогда
						ДанныеЗначения = ДанныеОбъекта(ЭлементМассива, КлючЗначение.Ключ);
						РезультатЗначения = Новый Структура;
						ЗаменитьСсылкиНаСтруктуры(РезультатЗначения, ДанныеЗначения);
						РезультатМассив.Добавить(РезультатЗначения);
					ИначеЕсли ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
						РезультатЗначения = Новый Структура;
						ЗаменитьСсылкиНаСтруктуры(РезультатЗначения, ЭлементМассива);
						РезультатМассив.Добавить(РезультатЗначения);
					Иначе
						РезультатМассив.Добавить(ЭлементМассива);		
					КонецЕсли;
					
				КонецЦикла;
				Результат.Вставить(КлючЗначение.Ключ, РезультатМассив);
				
			Иначе
				
				Если КлючЗначение.Значение <> Неопределено 
					И Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(КлючЗначение.Значение)) Тогда
					Если КлючЗначение.Ключ = "Ссылка" Тогда
						РезультатЗначения = КлючЗначение.Значение;
					Иначе						
						ДанныеЗначения = ДанныеОбъекта(КлючЗначение.Значение, КлючЗначение.Ключ);
						РезультатЗначения = Новый Структура;
						ЗаменитьСсылкиНаСтруктуры(РезультатЗначения, ДанныеЗначения);
					КонецЕсли;
					Результат.Вставить(КлючЗначение.Ключ, РезультатЗначения);
				ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
					ДанныеЗначения = КлючЗначение.Значение;
					РезультатЗначения = Новый Структура;
					ЗаменитьСсылкиНаСтруктуры(РезультатЗначения, ДанныеЗначения);
					Результат.Вставить(КлючЗначение.Ключ, РезультатЗначения);
				Иначе
					Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

