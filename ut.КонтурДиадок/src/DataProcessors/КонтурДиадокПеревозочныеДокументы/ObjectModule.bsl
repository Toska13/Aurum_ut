Функция ТипКонтрагента(СсылкаНаОбъект) Экспорт
	
	Результат = "ЮЛ";
	мтд = СсылкаНаОбъект.Метаданные();
	ИмяСправочника = мтд.Имя;
	ИмяРеквизитаЮрФизЛицо = Неопределено;
	Если мтд.Реквизиты.Найти("ФормаСобственности") <> Неопределено Тогда
		ИмяРеквизитаЮрФизЛицо = "ФормаСобственности";
	ИначеЕсли мтд.Реквизиты.Найти("ВидКонтрагента") <> Неопределено Тогда
		ИмяРеквизитаЮрФизЛицо = "ВидКонтрагента";
	ИначеЕсли мтд.Реквизиты.Найти("ЮрФизЛицо") <> Неопределено Тогда 
		ИмяРеквизитаЮрФизЛицо = "ЮрФизЛицо";
	ИначеЕсли мтд.Реквизиты.Найти("ЮридическоеФизическоеЛицо") <> Неопределено Тогда
		ИмяРеквизитаЮрФизЛицо = "ЮридическоеФизическоеЛицо";
	КонецЕсли;
	
	Если ИмяРеквизитаЮрФизЛицо <> Неопределено Тогда
		
		ИмяПеречисления = СсылкаНаОбъект[ИмяРеквизитаЮрФизЛицо].Метаданные().Имя;
		Если Не СсылкаНаОбъект[ИмяРеквизитаЮрФизЛицо].Пустая() Тогда
			
			ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(СсылкаНаОбъект[ИмяРеквизитаЮрФизЛицо]);
			ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
			
			Если ИмяЗначенияПеречисления = "ЮридическоеЛицо" 
				Или ИмяЗначенияПеречисления = "ЮрЛицо"
				Или ИмяЗначенияПеречисления = "Компания" Тогда
				
				Результат = "ЮЛ";
				
			ИначеЕсли ИмяЗначенияПеречисления = "ИндивидуальныйПредприниматель" Тогда
				
				Результат = "ИП";
				
			ИначеЕсли ИмяЗначенияПеречисления = "ФизическоеЛицо" 
				Или ИмяЗначенияПеречисления = "ЧастноеЛицо"
				Или ИмяЗначенияПеречисления = "ФизЛицо" Тогда
				
				Если ИмяСправочника = "Организации" Тогда
					Результат = "ИП";
				Иначе
					Результат = "ФЛ";
				КонецЕсли;
				
				Если мтд.Реквизиты.Найти("СтатусФизическогоЛица") <> Неопределено Тогда
					Если ЗначениеЗаполнено(СсылкаНаОбъект["СтатусФизическогоЛица"]) Тогда
						ИмяПеречисленияФЛ = СсылкаНаОбъект["СтатусФизическогоЛица"].Метаданные().Имя;
                    	ИндексЗначенияПеречисленияФЛ = Перечисления[ИмяПеречисленияФЛ].Индекс(СсылкаНаОбъект["СтатусФизическогоЛица"]);
						ИмяЗначенияПеречисленияФЛ = Метаданные.Перечисления[ИмяПеречисленияФЛ].ЗначенияПеречисления[ИндексЗначенияПеречисленияФЛ].Имя;
						Если ИмяЗначенияПеречисленияФЛ = "ИндивидуальныйПредприниматель" Тогда
							Результат = "ИП";
						Иначе
							Результат = "ФЛ";
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли мтд.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
					Если ЗначениеЗаполнено(СсылкаНаОбъект.ИндивидуальныйПредприниматель) Тогда
						Результат = "ИП";
					Иначе
						Результат = "ФЛ";
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПредопределенныеЭлементыСправочника(ИмяСправочника, Варианты)
	
	Результат = Новый Массив;
	
	Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИмяСправочника.Ссылка
		|ИЗ
		|	&СправочникИмяСправочника КАК ИмяСправочника
		|ГДЕ
		|	ИмяСправочника.Наименование В (&Варианты)
		|	И ИмяСправочника.Предопределенный";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СправочникИмяСправочника", "Справочник." + ИмяСправочника);
		Запрос.Параметры.Вставить("Варианты", Варианты);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
