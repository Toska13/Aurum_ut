Функция ТекстЗапросаКонтактнаяИнформация(СсылкаНаОбъект, УсловияПоВидам = Ложь)
	
	ТекстЗапросаКИ = Неопределено;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();	
	
	Если МетаданныеОбъекта.ТабличныеЧасти.Найти("КонтактнаяИнформация") <> Неопределено Тогда
		ТекстЗапросаКИ = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СправочникКонтактнаяИнформация.Ссылка КАК Ссылка,
		|	СправочникКонтактнаяИнформация.Представление КАК Значение,
		|	СправочникКонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей,
		|	СправочникКонтактнаяИнформация.ЗначенияПолей КАК АдресЭП,
		|	СправочникКонтактнаяИнформация.ЗначенияПолей КАК НомерТелефона,
		|	СправочникКонтактнаяИнформация.Вид КАК Вид,
		|	""643"" КАК КодСтраны
		|ИЗ
		|	Справочник." + МетаданныеОбъекта.Имя + ".КонтактнаяИнформация КАК СправочникКонтактнаяИнформация
		|ГДЕ
		|	СправочникКонтактнаяИнформация.Ссылка = &СсылкаНаОбъект
		|	И СправочникКонтактнаяИнформация.Тип = &ТипКИ";
		Если УсловияПоВидам Тогда
			ТекстЗапросаКИ = ТекстЗапросаКИ + "
			|	И СправочникКонтактнаяИнформация.Вид В (&ВидыКИ)";	
		КонецЕсли;
	ИначеЕсли Метаданные.РегистрыСведений.Найти("КонтактнаяИнформация") <> Неопределено Тогда
		ТекстЗапросаКИ = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрКонтактнаяИнформация.Объект КАК Ссылка,
		|	РегистрКонтактнаяИнформация.Представление КАК Значение,
		|	"""" КАК ЗначенияПолей,
		|	РегистрКонтактнаяИнформация.Представление КАК АдресЭП,
		|	РегистрКонтактнаяИнформация.Представление КАК НомерТелефона,
		|	РегистрКонтактнаяИнформация.Вид КАК Вид,
		|	""643"" КАК КодСтраны
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК РегистрКонтактнаяИнформация
		|ГДЕ
		|	РегистрКонтактнаяИнформация.Объект = &СсылкаНаОбъект
		|	И РегистрКонтактнаяИнформация.Тип = &ТипКИ";
		Если УсловияПоВидам Тогда
			ТекстЗапросаКИ = ТекстЗапросаКИ + "
			|	И РегистрКонтактнаяИнформация.Вид В (&ВидыКИ)";	
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстЗапросаКИ;
	
КонецФункции

Функция ТекстЗапросаПогрузкаСотрудник(СсылкаНаОбъект)

	Мтд = СсылкаНаОбъект.Метаданные();
	
	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ИмяКонфигурации = "УТ_11" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|" + ПолеЗапроса(Мтд, "Должность") + " КАК Должность
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	ИначеЕсли Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") <> Неопределено Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|	ФИОФизЛицСрезПоследних.Фамилия КАК ФИО_Фамилия,
		|	ФИОФизЛицСрезПоследних.Имя КАК ФИО_Имя,
		|	ФИОФизЛицСрезПоследних.Отчество КАК ФИО_Отчество
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
		|	ПО ФИОФизЛицСрезПоследних.ФизЛицо = " + ПолеЗапроса(Мтд, "Ссылка") + "
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|" + ПолеЗапроса(Мтд, "Фамилия") + " КАК ФИО_Фамилия,
		|" + ПолеЗапроса(Мтд, "Имя") + " КАК ФИО_Имя,
		|" + ПолеЗапроса(Мтд, "Отчество") + " КАК ФИО_Отчество,
		|" + ПолеЗапроса(Мтд, "Должность") + " КАК Должность
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
	
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Процедура ТекстЗапросаТовары(ДокументОснование, ИмяТЧ, ТекстЗапроса, Индекс)
	
	Мтд = ДокументОснование.Метаданные();
	МтдТовары = Неопределено;
	
	Если ИмяТЧ = "Ссылка" Тогда
		МтдТовары = Мтд; 
	ИначеЕсли ИмяТЧ <> Неопределено И Мтд.ТабличныеЧасти.Найти(ИмяТЧ) <> Неопределено Тогда
		МтдТовары = Мтд.ТабличныеЧасти[ИмяТЧ]; 
	ИначеЕсли Мтд.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
		МтдТовары = Мтд.ТабличныеЧасти.Товары; 
	ИначеЕсли Мтд.ТабличныеЧасти.Найти("Запасы") <> Неопределено Тогда
		МтдТовары = Мтд.ТабличныеЧасти.Запасы; 
	КонецЕсли;
	
	Если МтдТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//определить сумму с ндс
	ПолеЗапросаСумма = ПолеЗапроса(МтдТовары, ПолеСумма());
	Если Мтд.Реквизиты.Найти("СуммаВключаетНДС") <> Неопределено
		И ПолеЗапроса(МтдТовары, "СуммаНДС") <> "НЕОПРЕДЕЛЕНО" Тогда
		ПолеЗапросаСумма = ПолеЗапросаСумма + ?(ДокументОснование.СуммаВключаетНДС, "",  " + " + ПолеЗапроса(МтдТовары, ПолеСуммаНДС()));
	ИначеЕсли Мтд.Реквизиты.Найти("ЦенаВключаетНДС") <> Неопределено
		И ПолеЗапроса(МтдТовары, "СуммаНДС") <> "НЕОПРЕДЕЛЕНО" Тогда
		ПолеЗапросаСумма = ПолеЗапросаСумма + ?(ДокументОснование.ЦенаВключаетНДС, "", " + " + ПолеЗапроса(МтдТовары, ПолеСуммаНДС()));
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ") + " 
	|&СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " КАК техДокОсн,
	|" + ПолеЗапроса(МтдТовары, ПолеНоменклатура()) + " КАК Номенклатура,
	|" + ПолеЗапроса(МтдТовары, "Количество") + " КАК КолМестГр,
	|" + ПолеЗапроса(МтдТовары, "Количество") + " КАК КолГрМест,
	|" + ПолеЗапросаСумма + " КАК ЦеннГруз_СтЦеннГр,
	|" + ПолеЗапросаСумма + " КАК ОбъявлСтГруз_СтГр";
	
	ПолеЗапросаНоменклатура = ПолеЗапроса(МтдТовары, ПолеНоменклатура());
	
	ЕстьКодТНВЭД = Ложь;
	ЕстьВес = Ложь;
	ЕстьСтрана = Ложь;
	Если ПолеЗапросаНоменклатура = "ДанныеИз1С.Номенклатура" Тогда
		мтдНоменклатура = Метаданные.Справочники.Найти("Номенклатура");
		Если мтдНоменклатура <> Неопределено Тогда
			Если ЕстьРеквизитМетаданных(мтдНоменклатура, "КодТНВЭД") Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|" + ПолеЗапросаНоменклатура + ".КодТНВЭД КАК КодТовНом"; 
				ЕстьКодТНВЭД = Истина;
			КонецЕсли;
			Если ЕстьРеквизитМетаданных(мтдНоменклатура, "ВесПоСертификатуТовара") Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|" + ПолеЗапросаНоменклатура + ".ВесПоСертификатуТовара КАК ПлМасГруз_МасБрутЗнач";
				ТекстЗапроса = ТекстЗапроса + ",
				|" + ПолеЗапросаНоменклатура + ".ВесПоСертификатуТовара КАК ВесГруз_ВесБрутто";
				ЕстьВес = Истина;
			КонецЕсли;
			Если РеквизитМетаданных(мтдНоменклатура, ПолеСтрана()) <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|" + ПолеЗапросаНоменклатура + "." + РеквизитМетаданных(мтдНоменклатура, ПолеСтрана()) + " КАК СвСтрПроисх";
				ЕстьСтрана = Истина;
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
	Если Не ЕстьКодТНВЭД Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|НЕОПРЕДЕЛЕНО КАК КодТовНом";
	КонецЕсли;
	Если Не ЕстьВес Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|НЕОПРЕДЕЛЕНО КАК ПлМасГруз_МасБрутЗнач";
		ТекстЗапроса = ТекстЗапроса + ",
		|НЕОПРЕДЕЛЕНО КАК ВесГруз_ВесБрутто";
	КонецЕсли;
	Если Не ЕстьСтрана Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|НЕОПРЕДЕЛЕНО КАК СвСтрПроисх";
	КонецЕсли;
	
	Если МтдТовары <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|" + Мтд.ПолноеИмя() + ?(ИмяТЧ = "Ссылка", "", "." + МтдТовары.Имя) + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " 
		|";
	КонецЕсли;
	
	Если ПолеЗапросаНоменклатура = "ДанныеИз1С.Номенклатура" Тогда
		мтдНоменклатура = Метаданные.Справочники.Найти("Номенклатура");
		Если мтдНоменклатура <> Неопределено Тогда
			Если ЕстьРеквизитМетаданных(мтдНоменклатура, "Услуга") Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	И НЕ " + ПолеЗапросаНоменклатура + ".Услуга = ИСТИНА
				|";
			ИначеЕсли ЕстьРеквизитМетаданных(мтдНоменклатура, "ТипНоменклатуры") И Метаданные.Перечисления.Найти("ТипыНоменклатуры") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	И НЕ " + ПолеЗапросаНоменклатура + ".ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
				|	И НЕ " + ПолеЗапросаНоменклатура + ".ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
				|";
				Если Метаданные.Перечисления.ТипыНоменклатуры.ЗначенияПеречисления.Найти("МногооборотнаяТара") <> Неопределено Тогда
					ТекстЗапроса = ТекстЗапроса + "
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
					|";
				КонецЕсли;
			ИначеЕсли ЕстьРеквизитМетаданных(мтдНоменклатура, "ВидНоменклатуры") Тогда
				мтдВидНоменклатуры = Метаданные.Справочники.Найти("ВидыНоменклатуры");
				Если мтдВидНоменклатуры <> Неопределено И ЕстьРеквизитМетаданных(мтдВидНоменклатуры, "ТипНоменклатуры") Тогда
					ТекстЗапроса = ТекстЗапроса + "
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
					|";
					Если Метаданные.Перечисления.ТипыНоменклатуры.ЗначенияПеречисления.Найти("МногооборотнаяТара") <> Неопределено Тогда
						ТекстЗапроса = ТекстЗапроса + "
						|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
						|";
					КонецЕсли;
				ИначеЕсли Метаданные.Перечисления.Найти("ВидыНоменклатуры") <> Неопределено Тогда
					ТекстЗапроса = ТекстЗапроса + "
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
					|";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолеЗапроса(МетаданныеОбъекта, Реквизиты, ТекстЗапросаВТ = "", ТекстСоединенияВТ = "")
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	ПолноеИмяМетаданных = МетаданныеОбъекта.ПолноеИмя();
	ЭтоДокумент = Лев(МетаданныеОбъекта.ПолноеИмя(), 8) = "Документ";
	ЭтоСправочник = Лев(МетаданныеОбъекта.ПолноеИмя(), 10) = "Справочник";
	
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		СписокРеквизитов = Новый Массив; 
		СписокРеквизитов.Добавить(Реквизиты);
	Иначе
		СписокРеквизитов = Реквизиты;
	КонецЕсли;
	
	Для Каждого ДанныеРеквизита Из СписокРеквизитов Цикл
			
		Если ТипЗнч(ДанныеРеквизита) = Тип("Структура") Тогда
			ИмяРеквизита = ДанныеРеквизита.ИмяРеквизита;
			ПолеЗапроса = ДанныеРеквизита.ПолеЗапроса;
			
			_ТекстЗапросаВТ = ?(СтрНайтиЛок(ТекстЗапросаВТ, ДанныеРеквизита.ТекстЗапросаВТ) > 0, "", ДанныеРеквизита.ТекстЗапросаВТ);
			_ТекстСоединенияВТ =  ДанныеРеквизита.ТекстСоединенияВТ;
		Иначе
			ИмяРеквизита = ДанныеРеквизита;
			ПолеЗапроса = "ДанныеИз1С." + ДанныеРеквизита;
			_ТекстЗапросаВТ = "";
			_ТекстСоединенияВТ = "";
		КонецЕсли;
		
		Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			ТекстЗапросаВТ = ТекстЗапросаВТ + _ТекстЗапросаВТ;
			ТекстСоединенияВТ = ТекстСоединенияВТ + _ТекстСоединенияВТ;
			Возврат ПолеЗапроса;
		ИначеЕсли Метаданные.ОбщиеРеквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			ТекстЗапросаВТ = ТекстЗапросаВТ + _ТекстЗапросаВТ;
			ТекстСоединенияВТ = ТекстСоединенияВТ + _ТекстСоединенияВТ;
			Возврат ПолеЗапроса;
		ИначеЕсли ИмяРеквизита = "Ссылка" Тогда
			Возврат "ДанныеИз1С.Ссылка";
		ИначеЕсли ИмяРеквизита = "Код" И ЭтоСправочник Тогда
			Возврат "ДанныеИз1С.Код";
		ИначеЕсли ИмяРеквизита = "Наименование" И ЭтоСправочник Тогда
			Возврат "ДанныеИз1С.Наименование";
		ИначеЕсли ИмяРеквизита = "Дата" И ЭтоДокумент Тогда
			Возврат "ДанныеИз1С.Дата";
		ИначеЕсли ИмяРеквизита = "Номер" И ЭтоДокумент Тогда
			Возврат "ДанныеИз1С.Номер";
		ИначеЕсли ИмяРеквизита = "Владелец" И ЭтоСправочник Тогда
			Возврат "ДанныеИз1С.Владелец";
		КонецЕсли;
		
	КонецЦикла;

	Возврат "НЕОПРЕДЕЛЕНО";
	
КонецФункции

