	ЗаполнитьXDTO_УчастникТрНТип(XDTO.СвКлнт, ПЭСтруктура.СвКлнт);
 	ЗаполнитьXDTO_УчастникТрНТип(XDTO.СвЭксп, ПЭСтруктура.СвЭксп);
	
	СтороныДоговора = Новый Массив;
	СтороныДоговора.Добавить(ПЭСтруктура.СвКлнт);
	СтороныДоговора.Добавить(ПЭСтруктура.СвЭксп);
	ЗаполнитьXDTO_РеквДокТип_ПЭ(XDTO.ДогТрЭксп, СтороныДоговора, ПЭСтруктура.ДогТрЭксп);

	//ЗаполнитьXDTO_СвЗак(XDTO.СвЗак, ПЭСтруктура);
	//ЗаполнитьXDTO_СвГП(XDTO.СвГП, ПЭСтруктура);	
	//ЗаполнитьXDTO_УчастникТрНТип(XDTO.СвПер, ПЭСтруктура.СвПер);
	//
	//XDTO.ДокГруз = 1;
	//ЗаполнитьСписокXDTO_СвВодит(XDTO.СвВодит, ПЭСтруктура);
	//ЗаполнитьXDTO_СвТС(XDTO.СвТС, ПЭСтруктура);
	//ЗаполнитьXDTO_СвПогруз(XDTO.СвПогруз, ПЭСтруктура);

	//
	//// TODO необязательные
	ЗаполнитьСписокXDTO_СопрДок_ПЭ(XDTO.СопрДок, ПЭСтруктура);
	//ЗаполнитьXDTO_ОтметГО(XDTO.ОтметГО, ПЭСтруктура);
	//ЗаполнитьXDTO_КлимРеж(XDTO.УказГО.КлимРеж, ПЭСтруктура);
	//ЗаполнитьXDTO_ИнфПол(XDTO.ИнфПол, ПЭСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГО(XDTO, ТрНСтруктура)
	
	СвГО = ТрНСтруктура.СвГО;
	
	ЗаполнитьXDTO_УчастникТрНТип(XDTO.РекИдентГО, СвГО.РекИдентГО);
	
	// флаг экспедиция
	Если СвГО.ГОЭксп = 1 Тогда 
		XDTO.ГОЭксп = "1";
	Иначе
		XDTO.ГОЭксп = "0";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвЗак(XDTO, ТрНСтруктура)
	
	СвГО = ТрНСтруктура.СвГО;
	СвЗак = ТрНСтруктура.СвЗак;
	
	Если СвГО.ГОЭксп = 1 Тогда 

		ЗаполнитьXDTO_УчастникТрНТип(XDTO.РекИдентЗак, СвЗак.РекИдентЗак);
		ЗаполнитьXDTO_РеквДокТип(XDTO.ДогУслПер, СвЗак.РекИдентЗак, СвЗак.ДогУслПер);

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГП(XDTO, ТрНСтруктура)
	
	СвГП = ТрНСтруктура.СвГП;
	АдресДостГр = СвГП.АдресДостГр;
	
	ЗаполнитьXDTO_УчастникТрНТип(XDTO.РекИдентГП, СвГП.РекИдентГП);

	// адрес доставки
	КодСтраны 	= АдресДостГр.КодСтраны;
	Адрес 		= АдресДостГр.Адрес;
	АдресРФ		= АдресДостГр.АдресРФ;
	
	ЗаполнитьXDTO_АдресДоставки(XDTO.АдресДостГр, Адрес, АдресРФ, КодСтраны);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_УчастникТрНТип(XDTO_Участник, Участник)
	
	// Если это ИП
	Если ЕстьИЗаполненоСвойствоСтруктуры(Участник, "ИдСв.СвИП.ИННФЛ") Тогда

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП, "ИННФЛ",	Участник.ИдСв.СвИП, "ИННФЛ"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП, "ОГРНИП",	Участник.ИдСв.СвИП, "ОГРНИП");
		
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП.ФИО, "Фамилия",		Участник.ИдСв.СвИП.ФИО, "Фамилия"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП.ФИО, "Имя",			Участник.ИдСв.СвИП.ФИО, "Имя"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП.ФИО, "Отчество",	Участник.ИдСв.СвИП.ФИО, "Отчество"); 
				
	// Юридицеское лицо	
	ИначеЕсли ЕстьИЗаполненоСвойствоСтруктуры(Участник, "ИдСв.СвЮЛУч.ИННЮЛ") Тогда
				
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвЮЛУч, "ИННЮЛ",		Участник.ИдСв.СвЮЛУч, "ИННЮЛ"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвЮЛУч, "НаимОрг",	Участник.ИдСв.СвЮЛУч, "НаимОрг"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвЮЛУч, "КПП",		Участник.ИдСв.СвЮЛУч, "КПП"); 
		
	// Физлицо
	
	ИначеЕсли ЕстьИЗаполненоСвойствоСтруктуры(Участник, "ИдСв.СвФЛУчаст.ИННФЛ") И XDTO_ЕстьСвойство(XDTO_Участник.ИдСв, "СвФЛУчаст") Тогда

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст, "ИННФЛ",	Участник.ИдСв.СвФЛУчаст, "ИННФЛ"); 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст.ФИО, "Фамилия",	Участник.ИдСв.СвФЛУчаст.ФИО, "Фамилия"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст.ФИО, "Имя",		Участник.ИдСв.СвФЛУчаст.ФИО, "Имя"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст.ФИО, "Отчество",	Участник.ИдСв.СвФЛУчаст.ФИО, "Отчество"); 

	ИначеЕсли ЕстьИЗаполненоСвойствоСтруктуры(Участник, "ИдСв.СвФЛУчаст.ИННФЛ") И XDTO_ЕстьСвойство(XDTO_Участник.ИдСв, "СвФЛУч") Тогда

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч, "ИННФЛ",	Участник.ИдСв.СвФЛУчаст, "ИННФЛ"); 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч.ФИО, "Фамилия",	Участник.ИдСв.СвФЛУчаст.ФИО, "Фамилия"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч.ФИО, "Имя",		Участник.ИдСв.СвФЛУчаст.ФИО, "Имя"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч.ФИО, "Отчество",	Участник.ИдСв.СвФЛУчаст.ФИО, "Отчество"); 

	Иначе
		
		//ВызватьИсключение "Не могу определить Кто ГП в СведенияГП";
		
	КонецЕсли;
	
	КодСтраны 	= ЕстьИЗначениеСвойствоСтруктуры(Участник, "Адрес.АдрИнф.КодСтр");
	Адрес 		= ЕстьИЗначениеСвойствоСтруктуры(Участник, "Адрес.АдрИнф.АдрТекст");
	АдресРФ		= ЕстьИЗначениеСвойствоСтруктуры(Участник, "Адрес.АдрРФ");
	
	ЗаполнитьXDTO_Адрес(XDTO_Участник.Адрес, Адрес, АдресРФ, КодСтраны);

	Телефоны 	= ЕстьИЗначениеСвойствоСтруктуры(Участник, "Контакт.Тлф");
	АдресаЭП	= ЕстьИЗначениеСвойствоСтруктуры(Участник, "Контакт.ЭлПочта");
	
	//либо конт, либо контакт
	
	Если XDTO_ЕстьСвойство(XDTO_Участник, "Контакт") Тогда
		ЗаполнитьXDTO_Контакт(XDTO_Участник.Контакт, Телефоны, АдресаЭП, Неопределено);
	Иначе
		ЗаполнитьXDTO_Контакт(XDTO_Участник.Конт, Телефоны, АдресаЭП, Неопределено);
	КонецЕсли;
		
КонецПроцедуры	

Процедура ЗаполнитьXDTO_ПарТСПрвзТип(XDTO_ПарТСПрвз, ПарТСПрвз)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "Тип", ПарТСПрвз, "Тип"); 
