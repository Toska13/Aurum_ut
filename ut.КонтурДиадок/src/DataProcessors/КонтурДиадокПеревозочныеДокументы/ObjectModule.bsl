Функция Метрики_ПредставлениеОшибокВМассиве(НезаполненныеРеквизиты)
	
	ПредставлениеОшибок = Новый Массив;
	
	Для Каждого ПараметрыПоля Из НезаполненныеРеквизиты Цикл
		
		СтрокаСОшибкой = "";
		Если ПараметрыПоля.Свойство("НомерСтрокиОшибки") И ПараметрыПоля.НомерСтрокиОшибки > 0 Тогда
			СтрокаСОшибкой = " строка " + ПараметрыПоля.НомерСтрокиОшибки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыПоля.ИмяФормы) Тогда
			Если ПараметрыПоля.Свойство("ТекстОшибки") Тогда
				Представление = ПараметрыПоля.ТекстОшибки;
			Иначе
				Представление = "Указать: " + ПараметрыПоля.Представление + СтрокаСОшибкой;
			КонецЕсли;
			ПредставлениеОшибок.Добавить(Представление);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПредставлениеОшибок;
	
КонецФункции
