Функция ОбязательноеПоле(ОбщиеДанные, ЛокальныеДанные, ПараметрыПоля)

	Обязательное = Ложь;

	Если ПараметрыПоля.Свойство("Обязательное") И ТипЗнч(ПараметрыПоля.Обязательное) = Тип("Массив") Тогда

		Обязательное = Истина;
		УсловияИстины = ПараметрыПоля.Обязательное;
		Для Каждого УсловиеИстины Из УсловияИстины Цикл
			Если УсловиеИстины.Свойство("УсловиеНЕ") Тогда
				Обязательное = НЕ Обязательное;
			КонецЕсли;			
			ОбязательноеИмяПоля = УсловиеИстины.ИмяПоля;
			ОбязательноеЗначение = ЕстьИЗначениеСвойствоСтруктуры(?(УсловиеИстины.Источник = "Локальный", ЛокальныеДанные, ОбщиеДанные), ОбязательноеИмяПоля);
			Если ТипЗнч(УсловиеИстины.ЗначениеПоля) = Тип("Массив") Тогда
				Если УсловиеИстины.ЗначениеПоля.Найти(ОбязательноеЗначение) = Неопределено Тогда
					Обязательное = НЕ Обязательное;
					Прервать;
				КонецЕсли;
			ИначеЕсли Не УсловиеИстины.ЗначениеПоля = ОбязательноеЗначение Тогда
				Обязательное = НЕ Обязательное;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ПараметрыПоля.Свойство("Обязательное") Тогда
		Обязательное = ПараметрыПоля.Обязательное;
	КонецЕсли;

	Возврат Обязательное;

КонецФункции

Функция РеквизитыОбязательныхПолейПоФормам(ОбщиеДанные, ЛокальныеДанные, ПараметрыВалидации) Экспорт

	Результат = Новый Структура;
	ЗаполнитьРеквизитыОбязательныхПолейПоФормам(ОбщиеДанные, ЛокальныеДанные, ПараметрыВалидации, Результат);

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьРеквизитыОбязательныхПолейПоФормам(ОбщиеДанные, ЛокальныеДанные, ПараметрыВалидации, РеквизитыПоФормам, Путь = "")
                 
	Для Каждого КлючЗначение Из ЛокальныеДанные Цикл

		ИмяПоля = КлючЗначение.Ключ;
		ЗначениеПоля = КлючЗначение.Значение;

		Если Путь = "" Тогда
			ПолныйПуть = ИмяПоля;
		Иначе
			ПолныйПуть = Путь + ИмяПоля;
		КонецЕсли;

		Если ПараметрыВалидации.Свойство(ИмяПоля) Тогда
			ЗначениеВалидации = ПараметрыВалидации[ИмяПоля];
			ПараметрыПоля = КлючиВалидации();
			ЗаполнитьЗначенияСвойств(ПараметрыПоля, ПараметрыВалидации[ИмяПоля]);
		Иначе
			ЗначениеВалидации = Новый Структура;
			ПараметрыПоля = Неопределено;
		КонецЕсли;
		
		Если ПараметрыПоля <> Неопределено Тогда
								
			Если ОбязательноеПоле(ОбщиеДанные, ЛокальныеДанные, ПараметрыПоля)
				И ЗначениеЗаполнено(ПараметрыПоля.ИмяФормы)
				И ПараметрыПоля.ОтметкаНезаполненного Тогда
				
				РеквизитыФормы = Неопределено; 
				
				Если ПараметрыПоля.Свойство("ИмяРеквизитаРодителя") И ЗначениеЗаполнено(ПараметрыПоля.ИмяРеквизитаРодителя) Тогда
					НазваниеРеквизита = СтрЗаменить("рл_" + ПолныйПуть, ПараметрыПоля.ИмяРеквизитаРодителя, "рл");
				Иначе
					НазваниеРеквизита = "рл_" + ПолныйПуть;
				КонецЕсли;
				
				Если Не РеквизитыПоФормам.Свойство(ПараметрыПоля.ИмяФормы, РеквизитыФормы) Тогда
					РеквизитыФормы = Новый Массив;
					РеквизитыПоФормам.Вставить(ПараметрыПоля.ИмяФормы, РеквизитыФормы);
				КонецЕсли;
				Если РеквизитыФормы.Найти(НазваниеРеквизита) = Неопределено Тогда
					РеквизитыФормы.Добавить(НазваниеРеквизита);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(ЗначениеПоля) = Тип("Структура") Тогда
			ЗаполнитьРеквизитыОбязательныхПолейПоФормам(ОбщиеДанные, ЗначениеПоля, ЗначениеВалидации, РеквизитыПоФормам, ПолныйПуть + "_");
		ИначеЕсли ТипЗнч(ЗначениеПоля) = Тип("Массив") Тогда
			Для Каждого Стр Из ЗначениеПоля Цикл
				Если ТипЗнч(Стр) = Тип("Структура") Тогда
					ЗаполнитьРеквизитыОбязательныхПолейПоФормам(Стр, Стр, ЗначениеВалидации, РеквизитыПоФормам, ПолныйПуть);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, Ключ, Обязательное, Представление, ИмяРеквизитаРодителя = "", ИмяРеквизитаТЧ = "", ТипВалидации = "", ОтметкаНезаполненного = Истина)
	
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "Обязательное", Обязательное);
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "Представление", Представление);
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "ИмяФормы", ИмяФормы);
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "ИмяРеквизитаРодителя", ИмяРеквизитаРодителя);
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "ИмяРеквизитаТЧ", ИмяРеквизитаТЧ);
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "ТипВалидации", ТипВалидации);
	ДобавитьПараметрВСтруктуру(Результат, Префикс, Ключ, "ОтметкаНезаполненного", ОтметкаНезаполненного);
	
КонецПроцедуры

Функция КлючиВалидации()
	
	Результат = Новый Структура;
	Результат.Вставить("Обязательное", Ложь);
	Результат.Вставить("Представление", "");
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("ИмяРеквизитаРодителя", "");
	Результат.Вставить("ИмяРеквизитаТЧ", "");
	Результат.Вставить("ТипВалидации", "");
	Результат.Вставить("ОтметкаНезаполненного", Истина);
	Возврат Результат;
	
КонецФункции

