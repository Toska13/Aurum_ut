		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Клас", Истина, "Опасные грузы: Класс", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "КласКод", Истина, "Опасные грузы: Классификационный код", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ГрУп", Истина, "Опасные грузы: Группа упаковки", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ЗнОп", Истина, "Опасные грузы: Знак опасности", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "КодОгрЧерТун", Истина, "Опасные грузы: Код ограничения проезда через туннели", , ИмяРеквизитаТЧ);
	Иначе
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НПА", Истина, "Опасные грузы: Документ, регл. перевозку", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомООН", Истина, "Опасные грузы: Номер ООН", , ИмяРеквизитаТЧ);
