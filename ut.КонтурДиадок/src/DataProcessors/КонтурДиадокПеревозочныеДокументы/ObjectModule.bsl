	ЗаполнитьXDTO_СвГруз(XDTO.СвГруз, ТрНСтруктура);
	ЗаполнитьСписокXDTO_СвВодит(XDTO.СвВодит, ТрНСтруктура);
	ЗаполнитьXDTO_СвТС(XDTO.СвТС, ТрНСтруктура);
	ЗаполнитьXDTO_СвПогруз(XDTO.СвПогруз, ТрНСтруктура);

	ЗаполнитьXDTO_УказГО(XDTO.УказГО, ТрНСтруктура);
	
	// TODO необязательные
	ЗаполнитьСписокXDTO_СопрДок(XDTO.СопрДок, ТрНСтруктура);
	ЗаполнитьXDTO_ОтметГО(XDTO.ОтметГО, ТрНСтруктура);
	ЗаполнитьXDTO_КлимРеж(XDTO.УказГО.КлимРеж, ТрНСтруктура);
	ЗаполнитьXDTO_ИнфПол(XDTO.ИнфПол, ТрНСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СодИнфГО_ЗЗ(XDTO, ЗЗСтруктура)
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(ЗЗСтруктура, "УИД") Тогда 
		XDTO.УИД = ЗЗСтруктура.УИД;
	КонецЕсли;
	
	XDTO.СодОпер 		= "Предоставление заказа и заявки на перевозку груза автомобильным транспортом";
	XDTO.НомЗак 		= ЗЗСтруктура.НомЗак;
	XDTO.ДатаЗак 		= Формат_ДатаДляXml(ЗЗСтруктура.ДатаЗак);
