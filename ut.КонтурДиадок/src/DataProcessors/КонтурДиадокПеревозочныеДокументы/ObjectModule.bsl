Функция ТекстЗапросаУчастника(СсылкаНаОбъект, ТипКонтрагента)
	
	//СсылкаНаОбъект - может быть любая, проверяем по метаданным.
	Мтд = СсылкаНаОбъект.Метаданные();

	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ТипКонтрагента = "ЮЛ" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвЮЛУч_ИННЮЛ,
		|" + ПолеЗапроса(Мтд, "КПП") + " КАК ИдСв_СвЮЛУч_КПП,
		|" + ПолеЗапроса(Мтд, "Наименование") + " КАК ИдСв_СвЮЛУч_НаимОрг
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	ИначеЕсли ТипКонтрагента = "ИП" Тогда
		
		ТекстЗапроса = "";
		Если Мтд.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
			ЗначениеИП = СсылкаНаОбъект.ИндивидуальныйПредприниматель;
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеИП))
				И ЗначениеЗаполнено(ЗначениеИП) Тогда
				
				ТекстЗапросаФЛ = ТекстЗапросаУчастника(ЗначениеИП, "ФЛ");
				ТекстЗапросаФЛ = СтрЗаменить(ТекстЗапросаФЛ, Символы.ПС + "ИЗ" + Символы.ПС, Символы.ПС + "ПОМЕСТИТЬ ВТДанныеИз1С" + Символы.ПС +"ИЗ" + Символы.ПС); 
				ТекстЗапросаФЛ = СтрЗаменить(ТекстЗапросаФЛ, "ДанныеИз1С.Ссылка = &СсылкаНаОбъект", "Истина");
				ТекстЗапросаФЛ = ТекстЗапросаФЛ + "
				|;
				|";
				
				ТекстЗапроса = ТекстЗапросаФЛ + "
				|ВЫБРАТЬ
				|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
				|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвИП_ИННФЛ,
				|" + ПолеЗапроса(Мтд, ПолеОГРН()) + " КАК ИдСв_СвИП_ОГРНИП,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Наименование КАК ИдСв_СвИП_ФИО_Наименование,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Фамилия КАК ИдСв_СвИП_ФИО_Фамилия,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Имя  КАК ИдСв_СвИП_ФИО_Имя,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Отчество  КАК ИдСв_СвИП_ФИО_Отчество		
				|ИЗ
				|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
				|ЛЕВОЕ СОЕДИНЕНИЕ ВТДанныеИз1С КАК ВТДанныеИз1С
				|ПО ДанныеИз1С.ИндивидуальныйПредприниматель = ВТДанныеИз1С.Ссылка
				|ГДЕ
				|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
				
			КонецЕсли;
		КонецЕсли;
		
		Если ТекстЗапроса = "" Тогда
			                  
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
			|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ИдСв_СвИП_ФИО_ПолноеНаименование,		
			|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвИП_ИННФЛ,
			|" + ПолеЗапроса(Мтд, ПолеОГРН()) + " КАК ИдСв_СвИП_ОГРНИП,		
			|" + ПолеЗапроса(Мтд, ПолеПолноеНаименование()) + " КАК ИдСв_СвИП_ФИО_Наименование,		
			|" + ПолеЗапроса(Мтд, ПолеФамилия()) + " КАК ИдСв_СвИП_ФИО_Фамилия,		
			|" + ПолеЗапроса(Мтд, ПолеИмя()) + " КАК ИдСв_СвИП_ФИО_Имя,		
			|" + ПолеЗапроса(Мтд, ПолеОтчество()) + " КАК ИдСв_СвИП_ФИО_Отчество		
			|ИЗ
			|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
			|ГДЕ
			|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
			
		КонецЕсли;

	ИначеЕсли ТипКонтрагента = "ФЛ" Тогда
		
		Если Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") <> Неопределено Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
			|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ИдСв_СвФЛУчаст_ФИО_ПолноеНаименование,		
			|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвФЛУчаст_ИННФЛ,
			|" + ПолеЗапроса(Мтд, ПолеПолноеНаименование()) + " КАК ИдСв_СвФЛУчаст_ФИО_Наименование,		
			|	ФИОФизЛицСрезПоследних.Фамилия КАК ИдСв_СвФЛУчаст_ФИО_Фамилия,
			|	ФИОФизЛицСрезПоследних.Имя КАК ИдСв_СвФЛУчаст_ФИО_Имя,
			|	ФИОФизЛицСрезПоследних.Отчество КАК ИдСв_СвФЛУчаст_ФИО_Отчество
			|ИЗ
			|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
			|	ПО ФИОФизЛицСрезПоследних.ФизЛицо = " + ПолеЗапроса(Мтд, "Ссылка") + "
			|ГДЕ
			|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
			
		Иначе
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
			|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ИдСв_СвФЛУчаст_ФИО_ПолноеНаименование,		
			|" + ПолеЗапроса(Мтд, ПолеПолноеНаименование()) + " КАК ИдСв_СвФЛУчаст_ФИО_Наименование,		
			|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвФЛУчаст_ИННФЛ,
			|" + ПолеЗапроса(Мтд, ПолеФамилия()) + " КАК ИдСв_СвФЛУчаст_ФИО_Фамилия,
			|" + ПолеЗапроса(Мтд, ПолеИмя()) + " КАК ИдСв_СвФЛУчаст_ФИО_Имя,
			|" + ПолеЗапроса(Мтд, ПолеОтчество()) + " КАК ИдСв_СвФЛУчаст_ФИО_Отчество
			|ИЗ
			|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
			|ГДЕ
			|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции

