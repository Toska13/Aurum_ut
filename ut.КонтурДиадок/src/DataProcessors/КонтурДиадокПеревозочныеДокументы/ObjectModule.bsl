Функция ДокументыОснования(КлючИдентификатораЭПД, ИдентификаторЭПД) Экспорт
	
	// ЭПД может собираться на основании нескольких документов. 
	// При выборе указании любого из них - необходимо восстановить все документы. 
	Результат = Новый Массив;
	
	Свойство = ПолучитьСведениеПоИмени(КлючИдентификатораЭПД);

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДополнительныеСведения.Объект КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &Свойство
	               |	И ДополнительныеСведения.Значение = &Значение";
	
	НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + НазваниеРегистраДополнительныеСвойства);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Значение", ИдентификаторЭПД);

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Найти(Выборка.Ссылка) = Неопределено Тогда
			Результат.Добавить(Выборка.Ссылка);                      
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьЗначениеИзСтрокиВСтруктуру(Результат, ИмяРеквизита, Значение)
	
	Если Лев(ИмяРеквизита, 3) = "рл_" Тогда
		СоставнойКлюч = Сред(ИмяРеквизита, 4); 
	Иначе
		СоставнойКлюч = ИмяРеквизита;
	КонецЕсли;
	
	Ключи = РазделитьСтрокуЛок(СоставнойКлюч, "_", Ложь);
	
	ТекущаяСтруктура = Результат;
	
	// Проходим до предпоследнего ключа и создаем вложенные структуры
	Для Индекс = 0 По Ключи.Количество() - 2 Цикл
		
		Ключ = СокрЛП(Ключи[Индекс]);
		
		Если Не ТекущаяСтруктура.Свойство(Ключ) Тогда
			ТекущаяСтруктура.Вставить(Ключ, Новый Структура);
		ИначеЕсли ТекущаяСтруктура[Ключ] = Неопределено Тогда
			ТекущаяСтруктура.Вставить(Ключ, Новый Структура);
		ИначеЕсли ТипЗнч(ТекущаяСтруктура[Ключ]) <> Тип("Структура") Тогда
			ВызватьИсключение "По пути '" + Ключ + "' уже хранится не Структура.";
		КонецЕсли;
		
		ТекущаяСтруктура = ТекущаяСтруктура[Ключ];
		
	КонецЦикла;
	
	ПоследнийКлюч = СокрЛП(Ключи[Ключи.Количество() - 1]);
	
	ТекущаяСтруктура.Вставить(ПоследнийКлюч, Значение);

КонецПроцедуры

Процедура УдалитьКлючИзСтрокиВСтруктуру(Результат, ИмяРеквизита)
	
	Если Лев(ИмяРеквизита, 3) = "рл_" Тогда
		СоставнойКлюч = Сред(ИмяРеквизита, 4); 
	Иначе
		СоставнойКлюч = ИмяРеквизита;
	КонецЕсли;
	
	Ключи = РазделитьСтрокуЛок(СоставнойКлюч, "_", Ложь);
	
	ТекущаяСтруктура = Результат;
	
	// Проходим до предпоследнего ключа и создаем вложенные структуры
	Для Индекс = 0 По Ключи.Количество() - 2 Цикл
		
		Ключ = СокрЛП(Ключи[Индекс]);
		
		Если Не ТекущаяСтруктура.Свойство(Ключ) Тогда
        	Возврат;
		КонецЕсли;
		
		ТекущаяСтруктура = ТекущаяСтруктура[Ключ];
		
	КонецЦикла;
	
	ПоследнийКлюч = СокрЛП(Ключи[Ключи.Количество() - 1]);
	
	ТекущаяСтруктура.Удалить(ПоследнийКлюч);

КонецПроцедуры

Процедура ОбработатьФИО(Результат, ФИО, Фамилия, Имя, Отчество)

	Если ЕстьИЗаполненоСвойствоСтруктуры(Результат, ФИО)
		И Не ЗначениеЗаполнено(ЕстьИЗначениеСвойствоСтруктуры(Результат, Имя))
		И Не ЗначениеЗаполнено(ЕстьИЗначениеСвойствоСтруктуры(Результат, Фамилия))
		И Не ЗначениеЗаполнено(ЕстьИЗначениеСвойствоСтруктуры(Результат, Отчество)) Тогда
		
		Наименование = ЕстьИЗначениеСвойствоСтруктуры(Результат, ФИО);
		
		//уберем ИП и Индивидуальный предприниматель
		Если Лев(НРЕГ(Наименование), 3) = "ип " Тогда
			Наименование = Сред(Наименование, 4);
		ИначеЕсли Лев(НРЕГ(Наименование), 31) = "индивидуальный предприниматель " Тогда
			Наименование = Сред(Наименование, 32);
		КонецЕсли;
		
		ЧастиФИО = РазделитьСтрокуЛок(Наименование," ", Ложь);
		Если ЧастиФИО.Количество() = 1 Тогда
			УстановитьЗначениеСвойстваСтруктуры(Результат, Имя, ЧастиФИО[0]);
		ИначеЕсли ЧастиФИО.Количество() >= 2 Тогда
			УстановитьЗначениеСвойстваСтруктуры(Результат, Фамилия, ЧастиФИО[0]);
			УстановитьЗначениеСвойстваСтруктуры(Результат, Имя, ЧастиФИО[1]);
		КонецЕсли;
		Если ЧастиФИО.Количество() >= 3 Тогда
			СборноеОтчество = "";
			Для Индекс = 3 по ЧастиФИО.Количество() Цикл
				СборноеОтчество = СборноеОтчество + " " + ЧастиФИО[Индекс - 1];
			КонецЦикла;
			УстановитьЗначениеСвойстваСтруктуры(Результат, Отчество, СокрЛП(СборноеОтчество));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

