	СтруктураУчастника = Новый Структура();
	СтруктураУчастника.Вставить("Участник", Участник);
	СтруктураУчастника.Вставить("ЭтоГрузоотправитель", ЭтоГрузоотправитель);
	СтруктураУчастника.Вставить("Идентификатор", "");
	
	Возврат СтруктураУчастника;
	
