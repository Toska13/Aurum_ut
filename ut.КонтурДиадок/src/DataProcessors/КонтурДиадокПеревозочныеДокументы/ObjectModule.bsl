Функция СобратьXmlПоДокументу(СообщениеСДанными, ФорматДок, Параметры, ТипКодировки = "windows-1251") Экспорт
		
	Если ФабрикаXDTOНакладной = Неопределено Или ФорматXDTOНакладной <> ФорматДок Тогда
		
		XML_ФабрикаXDTO_Инициализировать(ФорматДок);
		ФорматXDTOНакладной = ФорматДок;
		
	КонецЕсли;
	
	Пакет = ФабрикаXDTOНакладной.Пакеты.Получить(ФорматДок);
	ТипОбъектаXDTO_Файл = Пакет.КорневыеСвойства.Получить("Файл").Тип;
	Файл = НовыйОбъектXDTO(ФабрикаXDTOНакладной, ТипОбъектаXDTO_Файл, Истина);
	
	// создание и конвертация в XDTO
	
	ЗаполнитьXDTO_Файл(Файл, СообщениеСДанными, ФорматДок, Параметры);
	
	УдалитьПустыеСвойстваXDTO(Файл);
	                                               
	Результат = ОбъектXDTO_В_СтрокуXML(Файл, ТипКодировки);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьXDTO_Файл(Файл, СообщениеСДанными, ФорматДок, Параметры)
	
	Если ФорматДок = ИмяТитулаТрнПоНомеру(1) Тогда
		
		ЗаполнитьXDTO_ТрН_ФорматФНС2021_Титул1(Файл, СообщениеСДанными, Параметры);
		
	ИначеЕсли ФорматДок = ИмяТитулаЗЗПоНомеру(1) Тогда
		
		ЗаполнитьXDTO_ЗЗ_ФорматФНС2021_Титул1(Файл, СообщениеСДанными, Параметры);
		
	ИначеЕсли ФорматДок = ИмяТитулаПЭПоНомеру(1) Тогда
		
		ЗаполнитьXDTO_ПЭ_ФорматФНС2026_Титул1(Файл, СообщениеСДанными, Параметры);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьXDTO_ТрН_ФорматФНС2021_Титул1(Файл, ТрНСтруктура, Параметры)
		
	Файл.ВерсПрог = "DiadocLogist1C";
	Файл.ВерсФорм = "5.01";
	Файл.ИдФайл = ИдентификаторФайлаТитулаТрн(ТрНСтруктура, 1);
	
	// Файл.Документ
	ЗаполнитьXDTO_ЭкспедиторАгент(Файл.ИдПолИной, ТрНСтруктура);

	Файл.Документ.ДатИнфГО = Формат_ДатаДляXml(ТекущаяДатаСеанса());
	Файл.Документ.ВрИнфГО = Формат_ВремяДляXml(ТекущаяДатаСеанса());
	Файл.Документ.КНД = "1110339";
	Файл.Документ.ПоФактХЖ =  "Транспортная накладная, информация грузоотправителя";
	
	ЗаполнитьXDTO_СодИнфГО_ТрН(Файл.Документ.СодИнфГО, ТрНСтруктура);
	
	ЗаполнитьXDTO_Подписант(Файл.Документ.Подписант, ТрНСтруктура);
	
