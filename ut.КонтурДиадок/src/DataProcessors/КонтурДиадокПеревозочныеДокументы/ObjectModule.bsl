Функция ИдентификаторФайлаТитулаТрн(ТрНСтруктура, Номер)
	
	// Формат ИдФайл титулов: R_Т_A_E_О_W_GGGGMMDD_N
	Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6_%7'");
	
	Если _Ядро <> Неопределено Тогда

		Если ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура, "СвГО.РекИдентГО.Ссылка") Тогда
			Если ЕстьИЗначениеСвойствоСтруктуры(ТрНСтруктура,"СвПогруз.СвЛицПогрГр.СовпГОП") = 2
				И ЕстьИЗначениеСвойствоСтруктуры(ТрНСтруктура,"СвПогруз.СвЛицПогрГр.ОтпрДрЮЛ") = Истина
				И ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура,"СвПогруз.СвПогруз.СвЛицПогрГр.РекЛицПогрГр.Ссылка")
				Тогда 
				ИдентификаторыГО = ИдентификаторыЭДО(ТрНСтруктура.СвПогруз.СвЛицПогрГр.РекЛицПогрГр.Ссылка, Ложь);
			Иначе
				ИдентификаторыГО = ИдентификаторыЭДО(ТрНСтруктура.СвГО.РекИдентГО.Ссылка, Истина);
			КонецЕсли;
			
			ИдГО = ИдентификаторыГО.ID;
		Иначе
			ИдГО = "";
		КонецЕсли;
		
 		Если ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура, "СвПер.Ссылка") Тогда
			ИдентификаторыПВ = ИдентификаторыЭДО(ТрНСтруктура.СвПер.Ссылка, Ложь);
			ИдПер = ИдентификаторыПВ.ID;
		Иначе
			ИдПер = "";
		КонецЕсли;
		
		Если ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура, "СвГП.РекИдентГП.Ссылка") Тогда
			ИдентификаторыГП = ИдентификаторыЭДО(ТрНСтруктура.СвГП.РекИдентГП.Ссылка, Ложь);
			ИдГП = ИдентификаторыГП.ID;
		Иначе
			ИдГП = "";
		КонецЕсли;
		
		Если ЕстьИЗаполненоСвойствоСтруктуры(ТрНСтруктура, "ИдПолИной.Ссылка") Тогда
			ИдентификаторыЭксп = ИдентификаторыЭДО(ТрНСтруктура.ИдПолИной.Ссылка, Ложь);
			ИдЭксп = ИдентификаторыЭксп.ID;
		Иначе
			ИдЭксп = "";
		КонецЕсли;

	Иначе
		
		ИдГО 	= "";
		ИдПер 	= "";
		ИдГП	= "";
		ИдЭксп = "";
		
	КонецЕсли;

	Если Номер = 1 Тогда
		
		R_Т = "ON_TRNACLGROT";
		A	= ИдПер;
		E	= ИдГП;
		O 	= ИдГО;
		
	ИначеЕсли Номер = 2 Или Номер = 4 Тогда
		
		R_Т = "ON_TRNACLPPRIN";
		A	= ИдГП;
		E	= ИдГО;
		O 	= ИдПер;
			
	ИначеЕсли Номер = 3 Тогда
		
		R_Т = "ON_TRNACLGRPO";
		A	= ИдПер;
		E	= ИдГО;
		O 	= ИдГП;
		
	Иначе
		
		ВызватьИсключение "Непредполагаемый номер титула транспортной накладной";
		
	КонецЕсли;
	
	Если ИдЭксп = "" Тогда
		W = 0;
	Иначе
		W = 1;
	КонецЕсли;

	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	N = Строка(Новый УникальныйИдентификатор);
	
	ИдФайла = ПодставитьПараметрыВСтроку(Шаблон, R_Т, A, E, O, W, GGGGMMDD, N);
	
	Возврат ИдФайла;
	
