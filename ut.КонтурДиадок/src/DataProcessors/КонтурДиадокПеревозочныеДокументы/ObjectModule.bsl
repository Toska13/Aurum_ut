Функция ЗначениеПоУмолчанию(Документ, ИмяРеквизита, КлючРеквизитов) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеРеквизита", Неопределено);
	Результат.Вставить("ИмяРеквизита", ИмяРеквизита);
	
	МетаданныеДокумента = Документ.Метаданные().ПолноеИмя();
	ПредставлениеНастройки = Документ.Метаданные().Представление();
	ИдентификаторНастройки = МетаданныеДокумента + "_" + КлючРеквизитов + "_" + ИмяРеквизита;

	Настройки = ВосстановитьНастройки(ИдентификаторНастройки).Настройки;
	Если ЗначениеЗаполнено(Настройки) Тогда
		Для Каждого СтрокаНастройки Из Настройки Цикл
			НастройкаСКДПользователя = Неопределено;
			Если ЗначениеЗаполнено(Настройки) Тогда
				НастройкаСКДПользователя = СтрокаНастройки.НастройкаСКД;  
			КонецЕсли;
			
			Если НастройкаСКДПользователя <> Неопределено Тогда
				
				СтруктураНастройкиТипа = Новый Структура;
				СтруктураНастройкиТипа.Вставить("МетаданныеДокумента", МетаданныеДокумента);	
				СтруктураНастройкиТипа.Вставить("ИдентификаторНастройки", ИдентификаторНастройки);	
				СтруктураНастройкиТипа.Вставить("МетаданныеДокументаПредставление", ПредставлениеНастройки);	
				
				МассивНастроек = Новый Массив;
				МассивНастроек.Добавить(СтруктураНастройкиТипа);
				НовыйСКД = ИнициализироватьСКД(МассивНастроек);
				
				НастройкиСКД = НовыйСКД.НастройкиПоУмолчанию;
				ЭлементОтбора = НастройкиСКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
				ЭлементОтбора.ПравоеЗначение = Документ; 
				
				Если НастройкаСКДПользователя <> Неопределено Тогда  
					ПользовательскиеОтборы = НастройкаСКДПользователя.Отбор.Элементы;
					ДобавитьОтборыСхемыКомпоновкиРекурсивно(НастройкиСКД.Отбор, ПользовательскиеОтборы); 
				КонецЕсли;
				
				ВыбранноеПоле = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ВыбранноеПоле.Использование = Истина;
				ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Ссылка");    
				
				Структура = НастройкиСКД.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
				Структура.Использование = Истина;
				Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
				Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));	
				
				НовПараметр = НовыйСКД.Параметры.Добавить();
				НовПараметр.Имя = "НачалоПериода"; 
				НовПараметр.Значение = Документ.Дата; 
				НовПараметр.Использование = ИспользованиеПараметраКомпоновкиданных.Всегда;
				
				НовПараметр = НовыйСКД.Параметры.Добавить();
				НовПараметр.Имя = "КонецПериода"; 
				НовПараметр.Значение = Документ.Дата; 
				НовПараметр.Использование = ИспользованиеПараметраКомпоновкиданных.Всегда;
				
				НовПараметр = НовыйСКД.Параметры.Добавить();
				НовПараметр.Имя = "Свойство_ИдентификаторТрН"; 
				НовПараметр.Значение = ПолучитьСведениеПоИмени(КлючИдентификатораТрН()); 
				НовПараметр.Использование = ИспользованиеПараметраКомпоновкиданных.Всегда;
				
				НовПараметр = НовыйСКД.Параметры.Добавить();
				НовПараметр.Имя = "Свойство_ИдентификаторЗЗ"; 
				НовПараметр.Значение = ПолучитьСведениеПоИмени(КлючИдентификатораЗЗ()); 
				НовПараметр.Использование = ИспользованиеПараметраКомпоновкиданных.Всегда;

				НовПараметр = НовыйСКД.Параметры.Добавить();
				НовПараметр.Имя = "Свойство_ИдентификаторПЭ"; 
				НовПараметр.Значение = ПолучитьСведениеПоИмени(КлючИдентификатораПЭ()); 
				НовПараметр.Использование = ИспользованиеПараметраКомпоновкиданных.Всегда;
				
				ДанныеРасшифровкиСКД = Новый ДанныеРасшифровкиКомпоновкиДанных;
				КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
				ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
				
				МакетКомпоновки = КомпоновщикМакета.Выполнить(НовыйСКД, НастройкиСКД, ДанныеРасшифровкиСКД, , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));		
				ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровкиСКД);
				ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
				РезультатЗапроса = Новый ТаблицаЗначений;
				ПроцессорВывода.УстановитьОбъект(РезультатЗапроса);   
				ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);   
				
				Если РезультатЗапроса.Количество() > 0 Тогда 
					Результат.Вставить("ЗначениеРеквизита", СтрокаНастройки.ЗначениеРеквизита);
					Возврат Результат;
				КонецЕсли;
				
			Иначе
				Результат.Вставить("ЗначениеРеквизита", СтрокаНастройки.ЗначениеРеквизита);
				Возврат Результат;
			КонецЕсли;
			
		КонецЦикла;  
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ВосстановитьНастройки(ИмяНастрйки) Экспорт
	
	ИмяПродукта = "КонтурЛогистика";
	НазваниеНастройки = СтрШаблонЛок("%1_%2", ИмяПродукта, ИмяНастрйки);
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Настройки", Неопределено); // обязательная
	
	ДанныеХранилищаЗначений = ДанныеХранилищаЗначений();
	Если ДанныеХранилищаЗначений.ИмяХранилища = Неопределено Тогда
		ВызватьИсключение "Конфигурация не поддерживает хранение данных для работы с модулем Диадок-Логистика";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Набор = РегистрыСведений[ДанныеХранилищаЗначений.ИмяХранилища].СоздатьНаборЗаписей();
	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(НазваниеНастройки);
	Иначе
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(ИмяПродукта);
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ2].Установить(ИмяНастрйки);
	КонецЕсли;
	
	Набор.Прочитать();
	
	Если Набор.Количество() > 0 Тогда
		СтруктураНастроекНабора = Набор[0][ДанныеХранилищаЗначений.ИмяДанных].Получить();         
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, СтруктураНастроекНабора);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураНастроек;
	
КонецФункции

Процедура ЗаписатьНастройки(СохраняемыеНастройки, ИмяНастрйки) Экспорт
	
	ИмяПродукта = "КонтурЛогистика";
	НазваниеНастройки = СтрШаблонЛок("%1_%2", ИмяПродукта, ИмяНастрйки);
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Настройки", СохраняемыеНастройки);
	
	ДанныеХранилищаЗначений = ДанныеХранилищаЗначений();
	Если ДанныеХранилищаЗначений.ИмяХранилища = Неопределено Тогда
		ВызватьИсключение "Конфигурация не поддерживает хранение данных для работы с модулем Диадок-Логистика";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Набор = РегистрыСведений[ДанныеХранилищаЗначений.ИмяХранилища].СоздатьНаборЗаписей();
	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(НазваниеНастройки);
	Иначе
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(ИмяПродукта);
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ2].Установить(ИмяНастрйки);
	КонецЕсли;
	
	НовСтрока = Набор.Добавить();

	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		НовСтрока[ДанныеХранилищаЗначений.Ключ1] = НазваниеНастройки;
	Иначе
		НовСтрока[ДанныеХранилищаЗначений.Ключ1] = ИмяПродукта;
		НовСтрока[ДанныеХранилищаЗначений.Ключ2] = ИмяНастрйки;
	КонецЕсли;
	НовСтрока[ДанныеХранилищаЗначений.ИмяДанных] = Новый ХранилищеЗначения(СтруктураНастроек);
	
	Набор.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ВосстановитьЗначениеСвойствоОбъекта(СсылкаНаОбъект) Экспорт
	
	Результат = Неопределено;
	
	Идентификатор = Строка(СсылкаНаОбъект.УникальныйИдентификатор());
	ИмяПродукта = "КонтурЛогистика";
	НазваниеНастройки = СтрШаблонЛок("%1_%2", ИмяПродукта, Идентификатор);
		
	ДанныеХранилищаЗначений = ДанныеХранилищаЗначений();
	Если ДанныеХранилищаЗначений.ИмяХранилища = Неопределено Тогда
		ВызватьИсключение "Конфигурация не поддерживает хранение данных для работы с модулем Диадок-Логистика";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Набор = РегистрыСведений[ДанныеХранилищаЗначений.ИмяХранилища].СоздатьНаборЗаписей();
	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(НазваниеНастройки);
	Иначе
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(ИмяПродукта);
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ2].Установить(Идентификатор);
	КонецЕсли;

	Набор.Прочитать();
	
	Если Набор.Количество() > 0 Тогда
		Результат = Набор[0][ДанныеХранилищаЗначений.ИмяДанных].Получить();         
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьЗначениеСвойствоОбъекта(СсылкаНаОбъект, Значение) Экспорт
	
	Идентификатор = Строка(СсылкаНаОбъект.УникальныйИдентификатор());
	ИмяПродукта = "КонтурЛогистика";
	НазваниеНастройки = СтрШаблонЛок("%1_%2", ИмяПродукта, Идентификатор);
	
	ДанныеХранилищаЗначений = ДанныеХранилищаЗначений();
	Если ДанныеХранилищаЗначений.ИмяХранилища = Неопределено Тогда
		ВызватьИсключение "Конфигурация не поддерживает хранение данных для работы с модулем Диадок-Логистика";
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	
	Набор = РегистрыСведений[ДанныеХранилищаЗначений.ИмяХранилища].СоздатьНаборЗаписей();
	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(НазваниеНастройки);
	Иначе
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ1].Установить(ИмяПродукта);
		Набор.Отбор[ДанныеХранилищаЗначений.Ключ2].Установить(Идентификатор);
	КонецЕсли;
	
	НовСтрока = Набор.Добавить();

	Если ДанныеХранилищаЗначений.Ключ2 = Неопределено Тогда
		НовСтрока[ДанныеХранилищаЗначений.Ключ1] = НазваниеНастройки;
	Иначе
		НовСтрока[ДанныеХранилищаЗначений.Ключ1] = ИмяПродукта;
		НовСтрока[ДанныеХранилищаЗначений.Ключ2] = Идентификатор;
	КонецЕсли;
	НовСтрока[ДанныеХранилищаЗначений.ИмяДанных] = Новый ХранилищеЗначения(Значение);
	
	Набор.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ДанныеХранилищаЗначений()
	
	Результат = Новый Структура;
	
	ИмяХранилища = Неопределено;
	Ключ1 = Неопределено;
	Ключ2 = Неопределено;
	ИмяДанных = Неопределено;
	
	Если Метаданные.РегистрыСведений.Найти("ХранилищеДанных") <> Неопределено Тогда   
		ИмяХранилища = "ХранилищеДанных";
		Ключ1 = "Владелец";
		ИмяДанных = "Данные";
	ИначеЕсли Метаданные.РегистрыСведений.Найти("БезопасноеХранилищеДанных") <> Неопределено Тогда
		ИмяХранилища = "БезопасноеХранилищеДанных";	
		Ключ1 = "Владелец";
		ИмяДанных = "Данные";
	ИначеЕсли Метаданные.РегистрыСведений.Найти("СохраненныеНастройки") <> Неопределено Тогда
		ИмяХранилища = "СохраненныеНастройки";
		Ключ1 = "ИмяОбъекта";
		Ключ2 = "НаименованиеНастройки";
		ИмяДанных = "СохраненнаяНастройка";
	//ИначеЕсли Метаданные.РегистрыСведений.Найти("ВерсииОбъектов") <> Неопределено Тогда
		//	ИмяХранилища = "ВерсииОбъектов";
	КонецЕсли;

 	Результат.Вставить("ИмяХранилища", ИмяХранилища);
 	Результат.Вставить("Ключ1", Ключ1);
 	Результат.Вставить("Ключ2", Ключ2);
 	Результат.Вставить("ИмяДанных", ИмяДанных);

	Возврат Результат;
	
КонецФункции

