Процедура ПараметрыВалидацииУчастника(Результат, Префикс) Экспорт
	
	ИмяФормы = "ФормаУчастника";
	ДопИнфо = "";
	РеквизитНаФорме = "рл_" + СтрЗаменить(Префикс, ".", "_");

	// ТрН
	Если Префикс = "СвГО.РекИдентГО" Тогда
		ДопИнфо = "грузоотправителя";
	ИначеЕсли Префикс = "СвГП.РекИдентГП" Тогда
		ДопИнфо = "грузополучателя";
	ИначеЕсли Префикс = "СвПер" Тогда
		ДопИнфо = "перевозчика";
	ИначеЕсли Префикс = "СвЗак.РекИдентЗак" Тогда
		ДопИнфо = "заказчика";
	ИначеЕсли Префикс = "СвПогруз.СвЛицПогрГр.РекЛицПогрГр" Тогда   
		ДопИнфо = "погрузчика";
	ИначеЕсли Префикс = "СвПогруз.ВладИнфр.РекВладИнф" Тогда
		ДопИнфо = "собственника пункта погрузки";
	КонецЕсли;
	
	// заказ заявка
	Если Префикс = "СвГО" Тогда
		ДопИнфо = "грузоотправителя";
	ИначеЕсли Префикс = "СвПрв" Тогда
		ДопИнфо = "перевозчика";
	КонецЕсли;

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Контакт.Тлф", Истина, "Телефон " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Адрес.АдрИнф.АдрТекст", Истина, "Адрес " + ДопИнфо, РеквизитНаФорме);
	
	//ИП
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИдСв.СвИП.ФИО.Фамилия", Истина, "Фамилия " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИдСв.СвИП.ФИО.Имя", Истина, "Имя " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИдСв.СвИП.ФИО.Отчество", Ложь, "Отчество " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИдСв.СвИП.ИННФЛ", Истина, "ИНН " + ДопИнфо, РеквизитНаФорме, , "ИННФЛ");
	
	//ЮрЛицо
