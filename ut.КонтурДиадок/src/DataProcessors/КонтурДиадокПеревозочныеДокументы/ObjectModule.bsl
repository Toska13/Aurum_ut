Процедура ПроверитьОбязательныеПоля(ОбщиеДанные, ЛокальныеДанные, ПараметрыВалидации, ОшибкиВалидации, Путь = "", Знач НомерСтрокиОшибки = 0) Экспорт
		
	Для Каждого КлючЗначение Из ЛокальныеДанные Цикл
		
		ИмяПоля = КлючЗначение.Ключ;
		ЗначениеПоля = КлючЗначение.Значение;

		// формируем полный путь поля
		Если Путь = "" Тогда
			ПолныйПуть = ИмяПоля;
		Иначе
			ПолныйПуть = Путь + ИмяПоля;
		КонецЕсли;
		
		// проверка выполнения условия
		Обязательное = Ложь;
		Если ПараметрыВалидации.Свойство(ИмяПоля) Тогда
			ЗначениеВалидации = ПараметрыВалидации[ИмяПоля];
			ПараметрыПоля = КлючиВалидации();
			ЗаполнитьЗначенияСвойств(ПараметрыПоля, ПараметрыВалидации[ИмяПоля]);
			Обязательное = ОбязательноеПоле(ОбщиеДанные, ЛокальныеДанные, ПараметрыПоля);
		Иначе
			ЗначениеВалидации = Новый Структура;
			ПараметрыПоля = Неопределено;
		КонецЕсли;
		// проверка выполнения условия
		
		// не проверяем поля без параметров
		Если ПараметрыПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//проверка заполненности значения
		ЭтоСтруктура = ТипЗнч(ЗначениеПоля) = Тип("Структура");
		ЭтоМассив    = ТипЗнч(ЗначениеПоля) = Тип("Массив");
		ЗначениеПоляЗаполнено = Ложь;
		Если ЭтоСтруктура Тогда
			Если ЗначениеПоля.Свойство("Ссылка") И Не ЭтоРеквизитXML("рл_" + ПолныйПуть) Тогда
				ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПоля.Ссылка);
			ИначеЕсли ЭтоРеквизитXML("рл_" + ПолныйПуть) Тогда
				ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПредставление(ЗначениеПоля));
			Иначе
				ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПоля);
			КонецЕсли;
		Иначе
			ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПоля);
		КонецЕсли;
						
		// Проверка заполненности обязательных полей
		НезаполненоОбязательноеПоле = Обязательное И Не ЗначениеПоляЗаполнено;
			
		Если НезаполненоОбязательноеПоле Тогда
			
			Если ПараметрыПоля.Свойство("ИмяРеквизитаРодителя") И ЗначениеЗаполнено(ПараметрыПоля.ИмяРеквизитаРодителя) Тогда
				НазваниеРеквизита = СтрЗаменить("рл_" + ПолныйПуть, ПараметрыПоля.ИмяРеквизитаРодителя, "рл");
			Иначе
				НазваниеРеквизита = "рл_" + ПолныйПуть;
			КонецЕсли;
			Если ЭтоРеквизитXML(НазваниеРеквизита) Тогда
				ПараметрыПоля.Вставить("НазваниеРеквизита", "пр_" + Сред(НазваниеРеквизита, 4));
			Иначе
				ПараметрыПоля.Вставить("НазваниеРеквизита", НазваниеРеквизита);
			КонецЕсли;
						
			Если НомерСтрокиОшибки > 0 Тогда
				ПараметрыПоля.Вставить("НомерСтрокиОшибки", НомерСтрокиОшибки);
			КонецЕсли;
			
			ОшибкиВалидации.Добавить(ПараметрыПоля);
			Продолжить;
			
		КонецЕсли;

		// Если поле не заполнено — дальше не проверяем
		Если Не ЗначениеПоляЗаполнено Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверка корректности
		Если ПараметрыПоля.Свойство("ТипВалидации") Тогда
			ТекстОшибки = "";
			Корректно = ЗначениеКорректно(ЛокальныеДанные, ПараметрыПоля.ТипВалидации, ЗначениеПоля, ТекстОшибки);
			Если Не Корректно Тогда
				Если ПараметрыПоля.Свойство("ИмяРеквизитаРодителя") И ЗначениеЗаполнено(ПараметрыПоля.ИмяРеквизитаРодителя) Тогда
					НазваниеРеквизита = СтрЗаменить("рл_" + ПолныйПуть, ПараметрыПоля.ИмяРеквизитаРодителя, "рл");
				Иначе
					НазваниеРеквизита = "рл_" + ПолныйПуть;
				КонецЕсли;
				Если ЭтоРеквизитXML(НазваниеРеквизита) Тогда
					ПараметрыПоля.Вставить("НазваниеРеквизита", "пр_" + Сред(НазваниеРеквизита, 4));
				Иначе
					ПараметрыПоля.Вставить("НазваниеРеквизита", НазваниеРеквизита);
				КонецЕсли;
				
				Если НомерСтрокиОшибки > 0  Тогда
					ПараметрыПоля.Вставить("НомерСтрокиОшибки", НомерСтрокиОшибки);
				КонецЕсли;

				ПараметрыПоля.Вставить("ТекстОшибки", ПараметрыПоля.Представление + ": " + ТекстОшибки);
				ОшибкиВалидации.Добавить(ПараметрыПоля);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
				
		// Если заполнено и есть дочерние — проверяем их
		Если ЭтоСтруктура Тогда
			ПроверитьОбязательныеПоля(ОбщиеДанные, ЗначениеПоля, ЗначениеВалидации, ОшибкиВалидации, ПолныйПуть + "_", НомерСтрокиОшибки);
		КонецЕсли;
		
		Если ЭтоМассив Тогда 

			//массивы в массиве пока не обрабатываем
			ЭтоМассивВМассиве = Ложь;
			Если НомерСтрокиОшибки > 0 Тогда
				ЭтоМассивВМассиве = Истина;	
			КонецЕсли;
			
			Для Каждого Стр Из ЗначениеПоля Цикл
				Если ТипЗнч(Стр) = Тип("Структура") Тогда
					Если Не ЭтоМассивВМассиве Тогда
						НомерСтрокиОшибки = НомерСтрокиОшибки + 1;
					КонецЕсли;
					//ПроверитьОбязательныеПоля(ОбщиеДанные, Стр, ЗначениеВалидации, ОшибкиВалидации, ПолныйПуть, НомерСтрокиОшибки);
					ПроверитьОбязательныеПоля(Стр, Стр, ЗначениеВалидации, ОшибкиВалидации, ПолныйПуть, НомерСтрокиОшибки);
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЭтоМассивВМассиве Тогда
				НомерСтрокиОшибки = 0;      
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИдентификаторыЭДО(ОбщиеДанные, ОшибкиВалидации, ИмяФормы) Экспорт
	
	ПараметрыПоляГО = Неопределено;
	ПараметрыПоляПрв = Неопределено;
	
	ШаблонОшибки = "ЭДО - не выполнено сопоставление участника перевозки ""%1""";
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(ОбщиеДанные, "СвГО.РекИдентГО.Ссылка") Тогда 
		ИдентификаторыЭДО = ИдентификаторыЭДО(ОбщиеДанные.СвГО.РекИдентГО.Ссылка, Истина);
		Если Не ЗначениеЗаполнено(ИдентификаторыЭДО.ID) Тогда
			ПараметрыПоля = КлючиВалидации();
			ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
			ПараметрыПоля.Вставить("НазваниеРеквизита", "рл_СвГО_РекИдентГО");
			ПараметрыПоля.Вставить("ТекстОшибки", СтрШаблонЛок(ШаблонОшибки, ОбщиеДанные.СвГО.РекИдентГО.Ссылка));
			ОшибкиВалидации.Добавить(ПараметрыПоля); 
		Иначе
			ПараметрыПоляГО = Новый Структура;
			ПараметрыПоляГО.Вставить("ИмяФормы", ИмяФормы);
			ПараметрыПоляГО.Вставить("НазваниеРеквизита", "рл_СвГО_РекИдентГО");
			ПараметрыПоляГО.Вставить("Участник", ОбщиеДанные.СвГО.РекИдентГО.Ссылка);
			ПараметрыПоляГО.Вставить("ИдентификаторыЭДО_ID", ИдентификаторыЭДО.ID); 
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(ОбщиеДанные, "СвГО.Ссылка") Тогда 
		ИдентификаторыЭДО = ИдентификаторыЭДО(ОбщиеДанные.СвГО.Ссылка, Истина);
		Если Не ЗначениеЗаполнено(ИдентификаторыЭДО.ID) Тогда
			ПараметрыПоля = КлючиВалидации();
			ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
			ПараметрыПоля.Вставить("НазваниеРеквизита", "рл_СвГО");
			ПараметрыПоля.Вставить("ТекстОшибки", СтрШаблонЛок(ШаблонОшибки, ОбщиеДанные.СвГО.Ссылка));
			ОшибкиВалидации.Добавить(ПараметрыПоля);
		Иначе
			ПараметрыПоляГО = Новый Структура;
