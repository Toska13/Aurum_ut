Функция ЭТрН_Титул_3_ГрузыИзТитулаОснования(ДокументЭТрН_Титул1) Экспорт
	
	Результат = Новый Массив;
	
	ДвоичныеДанныеТитула = ДокументЭТрН_Титул1.Документооборот.ХранилищеКонтента.Данные;
	
	КонтентXDTO = _Ядро.ГенерацияXML_XML_В_ОбъектXDTO(ДвоичныеДанныеТитула);
	
	СвГрузXDTO = XDTO_Вычислить(КонтентXDTO, "Документ.СодИнфГО.СвГруз");
	
	СписокГрузовXDTO = СписокXDTOИзЭлемента(СвГрузXDTO, "ОпГруз");
	
	Для Каждого ТекГрузXDTO Из СписокГрузовXDTO Цикл
		
		ДанныеГруза = ЭТрН_Титул_3_ПоляГрузаДляЗаполнения();
		
		Для Каждого ТекДанныеГруза Из ДанныеГруза Цикл
			
			ДанныеГруза[ТекДанныеГруза.Ключ] = XDTO_Вычислить(ТекГрузXDTO, ТекДанныеГруза.Значение);
			
		КонецЦикла;
		
		Результат.Добавить(ДанныеГруза);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

