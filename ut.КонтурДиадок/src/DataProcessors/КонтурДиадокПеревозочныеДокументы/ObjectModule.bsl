	КонецЕсли;

КонецФункции

Функция ПолучитьТаблицуИспользуемыхПакетов(Параметры)

	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		
		ТаблицаИспользуемыхПакетов = Параметры.Результат_ИМ;
		
		ВидПакетаID = ИдентификаторПакетаЭТрН();
		ВидПакетаНаименование = НаименованиеПакетаЭТрН();
		ВидДокументаID = ИдентификаторДокументаЭТрН();
		ВидДокументаНаименование = НаименованиеДокументаЭТрН();
		
		Если ТаблицаИспользуемыхПакетов.Найти(ВидПакетаID, "ID") = Неопределено Тогда 
			_Ядро.ДобавитьСтрокуВТаблицуЗначений(ТаблицаИспользуемыхПакетов, ВидПакетаID, ВидПакетаНаименование, ВидДокументаID, "БезКатегории", "");
		КонецЕсли;
		
		ВидПакетаID = ИдентификаторПакетаЗаказЗаявка();
		ВидПакетаНаименование = НаименованиеПакетаЗаказЗаявка();
		ВидДокументаID = ИдентификаторДокументаЗаказЗаявка();
		ВидДокументаНаименование = НаименованиеДокументаЗаказЗаявка();
		
		Если ТаблицаИспользуемыхПакетов.Найти(ВидПакетаID, "ID") = Неопределено Тогда 
			_Ядро.ДобавитьСтрокуВТаблицуЗначений(ТаблицаИспользуемыхПакетов, ВидПакетаID, ВидПакетаНаименование, ВидДокументаID, "БезКатегории", "");
		КонецЕсли;

		ВидПакетаID = ИдентификаторПакетаЭПЭ();
		ВидПакетаНаименование = НаименованиеПакетаЭПЭ();
		ВидДокументаID = ИдентификаторДокументаЭПЭ();
		ВидДокументаНаименование = НаименованиеДокументаЭПЭ();
		
		Если ТаблицаИспользуемыхПакетов.Найти(ВидПакетаID, "ID") = Неопределено Тогда 
			_Ядро.ДобавитьСтрокуВТаблицуЗначений(ТаблицаИспользуемыхПакетов, ВидПакетаID, ВидПакетаНаименование, ВидДокументаID, "БезКатегории", "");
		КонецЕсли;
		
		Возврат ТаблицаИспользуемыхПакетов;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуИспользуемыхВидовДокументов(Параметры)
	
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		
		ТаблицаИспользуемыхВидовДокументов = Параметры.Результат_ИМ;
		
		ВидДокументаID = ИдентификаторДокументаЭТрН();
		ВидДокументаНаименование = НаименованиеДокументаЭТрН();
		
		Если ТаблицаИспользуемыхВидовДокументов.Найти(ВидДокументаID, "ID") = Неопределено Тогда 
			_Ядро.ДобавитьСтрокуВТаблицуЗначений(ТаблицаИспользуемыхВидовДокументов, ВидДокументаID, ВидДокументаНаименование, "LogisticsWaybill", "kl", "reception");
		КонецЕсли;
		
		ВидДокументаID = ИдентификаторДокументаЗаказЗаявка();
		ВидДокументаНаименование = НаименованиеДокументаЗаказЗаявка();
		
		Если ТаблицаИспользуемыхВидовДокументов.Найти(ВидДокументаID, "ID") = Неопределено Тогда 
			_Ядро.ДобавитьСтрокуВТаблицуЗначений(ТаблицаИспользуемыхВидовДокументов, ВидДокументаID, ВидДокументаНаименование, "LogisticsOrderRequest", "zakzvper", "");
		КонецЕсли;

		ВидДокументаID = ИдентификаторДокументаЭПЭ();
		ВидДокументаНаименование = НаименованиеДокументаЭПЭ();
		
		Если ТаблицаИспользуемыхВидовДокументов.Найти(ВидДокументаID, "ID") = Неопределено Тогда
			_Ядро.ДобавитьСтрокуВТаблицуЗначений(ТаблицаИспользуемыхВидовДокументов, ВидДокументаID, ВидДокументаНаименование, "LogisticsForwardingOrder", "kl_porek_wt3_05_02_01", "");
		КонецЕсли;
		
		Возврат ТаблицаИспользуемыхВидовДокументов;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция ПодготовитьПакет(Параметры)
	
	Если Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЭТрН() Тогда
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(
			Параметры.Пакет,
			Параметры.СтрокаСписка.Документ,
			ИдентификаторДокументаЭТрН()
		);
		Возврат Истина;
		
	ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЗаказЗаявка() Тогда
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(
			Параметры.Пакет,
			Параметры.СтрокаСписка.Документ,
			ИдентификаторДокументаЗаказЗаявка()
		);
		Возврат Истина;

	ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЭПЭ() Тогда
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(
			Параметры.Пакет,
			Параметры.СтрокаСписка.Документ,
			ИдентификаторДокументаЭПЭ()
		);
		Возврат Истина;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции

Функция ПодготовитьЭлектронныйДокумент(Параметры)
	
	Если Параметры.ВидДокументаРазвернутый.ID = ИдентификаторДокументаЭТрН() Тогда  // пока считаем это титулом 1

		ФорматДок = ИмяТитулаТрнПоНомеру(1);
		Документ1С = Параметры.Результат.Документ1С;
		Результат = Параметры.Результат;
		
		// промежуточная структура - сообщение
		ИдентификаторТрН = ИдентификаторТрН(Документ1С);
		ДокументыОснования = ДокументыОснования(КлючИдентификатораТрН(), ИдентификаторТрН);
		СообщениеТрН = ПодготовитьСообщениеТрН(ФорматДок, ИдентификаторТрН, ДокументыОснования, Параметры);
		
		// XML
		ТекстXml = СобратьXmlПоДокументу(СообщениеТрН, ФорматДок, Параметры);
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXml = Новый ЗаписьXML;
		ЗаписьXml.ОткрытьФайл(ИмяВремФайла, "windows-1251");
		ЗаписьXml.ЗаписатьБезОбработки(ТекстXml);
		ЗаписьXml.Закрыть();
		
		//Результат.Метаданные.DocumentDate	= СообщениеТрН.ДатаТрН;
		//Результат.Метаданные.DocumentNumber	= СообщениеТрН.НомерТрН;
		
		Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВремФайла);
		
		Результат.ДатаСоздания  			= ТекущаяДатаСеанса();
		Результат.ДатаДокумента				= СообщениеТрН.ДатаТрН; // дата ТРН а не этого документа!	
		Результат.НомерДокумента 			= СообщениеТрН.НомерТрН;
		Результат.РеквизитыДокумента.Дата 	= СообщениеТрН.ДатаТрН;
		Результат.РеквизитыДокумента.Номер 	= СообщениеТрН.НомерТрН;
		
		Content = Новый Структура("LogisticsWaybill", СообщениеТрН);
		Результат.Content = Content;
		
		Результат.ЗапрашиватьОтветнуюПодпись = Истина;
		
		Параметры.Результат = Результат;
		УдалитьФайлы(ИмяВремФайла);
		
		Если Параметры.ДополнительныеПараметры = Неопределено  Тогда
			Параметры.ДополнительныеПараметры = Новый Структура();
		КонецЕсли;
		
		Параметры.ДополнительныеПараметры.Вставить(КлючИдентификаторПеревозочногоДокумента(), Строка(ИдентификаторТрН));
		ДополнитьДопПараметрыЭТрНИдентификаторамиУчастников(Параметры.ДополнительныеПараметры, СообщениеТрН);
		
		Возврат Истина;
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = ИдентификаторДокументаЗаказЗаявка() Тогда  // пока считаем это титулом 1

		ФорматДок = ИмяТитулаЗЗПоНомеру(1);
		Документ1С = Параметры.Результат.Документ1С;
		Результат = Параметры.Результат;
		
		// промежуточная структура - сообщение
		ИдентификаторЗЗ = ИдентификаторЗЗ(Документ1С);
		ДокументыОснования = ДокументыОснования(КлючИдентификатораЗЗ(), ИдентификаторЗЗ);
		СообщениеЗЗ = ПодготовитьСообщениеЗЗ(ФорматДок, ИдентификаторЗЗ, ДокументыОснования, Параметры);
		//ПроверитьСообщениеЗЗ(СообщениеЗЗ); // валидатор - куда его выводить? Видимо будет форма и выводить нужно туда
		
		// XML
		ТекстXml = СобратьXmlПоДокументу(СообщениеЗЗ, ФорматДок, Параметры);
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXml = Новый ЗаписьXML;
		ЗаписьXml.ОткрытьФайл(ИмяВремФайла, "windows-1251");
		ЗаписьXml.ЗаписатьБезОбработки(ТекстXml);
		ЗаписьXml.Закрыть();
		
		//Результат.Метаданные.DocumentDate	= СообщениеТрН.ДатаТрН;
		//Результат.Метаданные.DocumentNumber	= СообщениеТрН.НомерТрН;
		
		Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВремФайла);
		
		Результат.ДатаСоздания  			= ТекущаяДатаСеанса();
		Результат.ДатаДокумента				= СообщениеЗЗ.ДатаЗак; // дата ТРН а не этого документа!	
		Результат.НомерДокумента 			= СообщениеЗЗ.НомЗак;
		Результат.РеквизитыДокумента.Дата 	= СообщениеЗЗ.ДатаЗак;
		Результат.РеквизитыДокумента.Номер 	= СообщениеЗЗ.НомЗак;
		
		Content = Новый Структура("LogisticsOrderRequest", СообщениеЗЗ);
		Результат.Content = Content;
		
		Результат.ЗапрашиватьОтветнуюПодпись = Истина;
		
		Параметры.Результат = Результат;
		УдалитьФайлы(ИмяВремФайла);
			
		Если Параметры.ДополнительныеПараметры = Неопределено  Тогда
			Параметры.ДополнительныеПараметры = Новый Структура();
		КонецЕсли;
		Параметры.ДополнительныеПараметры.Вставить(КлючИдентификаторПеревозочногоДокумента(), Строка(ИдентификаторЗЗ));
		ДополнитьДопПараметрыЗЗИдентификаторамиУчастников(Параметры.ДополнительныеПараметры, СообщениеЗЗ);
		
		Возврат Истина;
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = ИдентификаторДокументаЭПЭ() Тогда  // пока считаем это титулом 1

		ФорматДок = ИмяТитулаПЭПоНомеру(1);
		Документ1С = Параметры.Результат.Документ1С;
		Результат = Параметры.Результат;
		
		// промежуточная структура - сообщение
		ИдентификаторПЭ = ИдентификаторПЭ(Документ1С);
		ДокументыОснования = ДокументыОснования(КлючИдентификатораПЭ(), ИдентификаторПЭ);
		СообщениеПЭ = ПодготовитьСообщениеПЭ(ФорматДок, ИдентификаторПЭ, ДокументыОснования, Параметры);
		
		Кодировка = "utf-8"; 
		ТекстXml = СобратьXmlПоДокументу(СообщениеПЭ, ФорматДок, Параметры, Кодировка); 
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXml = Новый ЗаписьXML;
		//ЗаписьXml.ОткрытьФайл(ИмяВремФайла, "windows-1251");
		//ЗаписьXml.ОткрытьФайл(ИмяВремФайла, "UTF-8", Ложь); // на старых платформах нет bom
		ЗаписьXml.ОткрытьФайл(ИмяВремФайла, "CESU-8");
		ЗаписьXml.ЗаписатьБезОбработки(ТекстXml);
		ЗаписьXml.Закрыть();
		
		//Результат.Метаданные.DocumentDate	= СообщениеПЭ.ДатаДок;
		//Результат.Метаданные.DocumentNumber	= СообщениеПЭ.НомерДок;
		
		Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВремФайла);
		
		Результат.ДатаСоздания  			= ТекущаяДатаСеанса();
		Результат.ДатаДокумента				= СообщениеПЭ.ДатаДок; // дата ПЭ а не этого документа!	
		Результат.НомерДокумента 			= СообщениеПЭ.НомДок;
		Результат.РеквизитыДокумента.Дата 	= СообщениеПЭ.ДатаДок;
		Результат.РеквизитыДокумента.Номер 	= СообщениеПЭ.НомДок;
		
		Content = Новый Структура("LogisticsForwardingOrder", СообщениеПЭ);
		Результат.Content = Content;
		
		Результат.ЗапрашиватьОтветнуюПодпись = Истина;
		
		Параметры.Результат = Результат;
		УдалитьФайлы(ИмяВремФайла);
		
		Если Параметры.ДополнительныеПараметры = Неопределено  Тогда
			Параметры.ДополнительныеПараметры = Новый Структура();
		КонецЕсли;
		
		Параметры.ДополнительныеПараметры.Вставить(КлючИдентификаторПеревозочногоДокумента(), Строка(ИдентификаторПЭ));
		ДополнитьДопПараметрыЭПЭИдентификаторамиУчастников(Параметры.ДополнительныеПараметры, СообщениеПЭ);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции

Процедура ДополнитьДопПараметрыЭТрНИдентификаторамиУчастников(ДопПараметры, СообщениеТрН)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникГОСсылка = СообщениеТрН.СвГО.РекИдентГО.Ссылка;
	УчастникГО = Контракт_СтруктураУчастника(УчастникГОСсылка, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникГО);
	
	УчастникПерСсылка = СообщениеТрН.СвПер.Ссылка;
	УчастникПер = Контракт_СтруктураУчастника(УчастникПерСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникПер);
	
	УчастникГПСсылка = СообщениеТрН.СвГп.РекИдентГП.Ссылка;
	УчастникГП = Контракт_СтруктураУчастника(УчастникГПСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникГП", УчастникГП);
	
	ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПараметры.Вставить(КлючИдентификаторГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПараметры.Вставить(КлючИдентификаторПер(), УчастникПер.Идентификатор);
	УчастникГП = СтруктураУчастников.УчастникГП;
	ДопПараметры.Вставить(КлючИдентификаторГП(), УчастникГП.Идентификатор);
	
КонецПроцедуры

Процедура ДополнитьДопПараметрыЗЗИдентификаторамиУчастников(ДопПараметры, СообщениеЗЗ)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникГОСсылка = СообщениеЗЗ.СвГО.Ссылка;
	УчастникГО = Контракт_СтруктураУчастника(УчастникГОСсылка, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникГО);
	
	УчастникПерСсылка = СообщениеЗЗ.СвПрв.Ссылка;
	УчастникПер = Контракт_СтруктураУчастника(УчастникПерСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникПер);
	
	ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПараметры.Вставить(КлючИдентификаторГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПараметры.Вставить(КлючИдентификаторПер(), УчастникПер.Идентификатор);
	
КонецПроцедуры

Процедура ДополнитьДопПараметрыЭПЭИдентификаторамиУчастников(ДопПараметры, СообщениеПЭ)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникКлнтСсылка = СообщениеПЭ.СвКлнт.Ссылка;
	УчастникКлнт = Контракт_СтруктураУчастника(УчастникКлнтСсылка, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникКлнт);
	
	УчастникЭкспСсылка = СообщениеПЭ.СвЭксп.Ссылка;
	УчастникЭксп = Контракт_СтруктураУчастника(УчастникЭкспСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникЭксп);
		
	ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПараметры.Вставить(КлючИдентификаторГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
