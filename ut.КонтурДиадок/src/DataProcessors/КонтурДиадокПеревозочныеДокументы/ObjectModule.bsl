Функция ДанныеКонтактнаяИнформацияАдреса(СсылкаНаОбъект, Рекурсия = Ложь) Экспорт
	
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	_СсылкаНаОбъект = СсылкаНаОбъект;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	Если Не Рекурсия И МетаданныеОбъекта.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
		ЗначениеИП = СсылкаНаОбъект.ИндивидуальныйПредприниматель;
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеИП))
			И ЗначениеЗаполнено(ЗначениеИП) Тогда
			//соберем информацию с 2х источников.
			Результат = ДанныеКонтактнаяИнформацияАдреса(ЗначениеИП, Истина);
		КонецЕсли;
	КонецЕсли;
	
	ТипКИ = ТипКонтактнойИнформации_Адрес(); 
	
	Варианты = Новый Массив; 
	Варианты.Добавить("АдресСклада");
	Варианты.Добавить("Адрес");
	Варианты.Добавить("АдресДоставкиКонтрагента");
	Варианты.Добавить("Адрес доставки");
	Варианты.Добавить("ФактАдресКонтрагента");
	Варианты.Добавить("ФактическийАдресКонтрагента"); 
	Варианты.Добавить("Фактический адрес контрагента");	
	Варианты.Добавить("ФактАдресОрганизации");
	Варианты.Добавить("ФактическийАдресОрганизации");
	Варианты.Добавить("Фактический адрес организации");		
	Варианты.Добавить("ФактАдресФизЛица");
	Варианты.Добавить("Адрес проживания физ. лица");
	Варианты.Добавить("Фактический адрес");	
		
	ВидыКИ = ПредопределенныеЭлементыСправочника("ВидыКонтактнойИнформации", Варианты);
	
	ТекстЗапроса = ТекстЗапросаКонтактнаяИнформация(_СсылкаНаОбъект, Ложь);
	
	Если ТекстЗапроса <> Неопределено Тогда
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("СсылкаНаОбъект", _СсылкаНаОбъект);
		Запрос.УстановитьПараметр("ТипКИ", ТипКИ); 

		РезультатЗапроса = Запрос.Выполнить(); 
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураАдреса = СтруктураАдреса();
			СтруктураАдреса.Адрес = Выборка.Значение;
			СтруктураАдреса.АдресКодСтраны = Выборка.КодСтраны;
			СтруктураАдреса.АдресРФ = Выборка.ЗначенияПолей;
			ЕстьПорядок = ВидыКИ.Найти(Выборка.Вид);
			Если ЕстьПорядок <> Неопределено Тогда
				Результат.Вставить(0, СтруктураАдреса);
			Иначе
				Результат.Добавить(СтруктураАдреса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

