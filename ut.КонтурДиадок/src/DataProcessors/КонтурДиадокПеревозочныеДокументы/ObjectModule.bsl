Процедура ЗаполнитьXDTO_РеквДокТип(XDTO_Договор, СторонаСтруктура, ДоговорСтруктура)

	Стороны = Новый Массив;
	Стороны.Добавить(СторонаСтруктура);
	ЗаполнитьСписокXDTO_ИдентРек(XDTO_Договор.ИдРекСост, Стороны);

	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "ИдДок", ДоговорСтруктура, "ИдДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "НаимДок", ДоговорСтруктура, "НаимДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "НомерДок", ДоговорСтруктура, "НомерДок");
	Если ЗначениеЗаполнено(ДоговорСтруктура.ДатаДок) Тогда
		ЗаполнитьXDTO_СПроверкой(XDTO_Договор, "ДатаДок", Формат_ДатаДляXml(ДоговорСтруктура.ДатаДок));
	КонецЕсли;
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "ДопСведДок", ДоговорСтруктура, "ДопСведДок");

КонецПроцедуры

Процедура ЗаполнитьXDTO_РеквДокТип_ПЭ(XDTO_Договор, СтороныДоговора, ДоговорСтруктура)
	
	Если СтороныДоговора <> Неопределено Тогда
		ЗаполнитьСписокXDTO_ИдентРек(XDTO_Договор.РеквИдРекСост, СтороныДоговора);
	КонецЕсли;
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквИдДок", ДоговорСтруктура, "РеквИдДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквНаимДок", ДоговорСтруктура, "РеквНаимДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквНомерДок", ДоговорСтруктура, "РеквНомерДок");
	Если ЕстьИЗаполненоСвойствоСтруктуры(ДоговорСтруктура, "РеквДатаДок") Тогда
		ЗаполнитьXDTO_СПроверкой(XDTO_Договор, "РеквДатаДок", Формат_ДатаДляXml(ДоговорСтруктура.РеквДатаДок));
	КонецЕсли;
 	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквДопСведДок", ДоговорСтруктура, "РеквДопСведДок");

КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГруз(XDTO, ТрНСтруктура)
	
	ЗаполнитьСписокXDTO_ОпГруз(XDTO.ОпГруз, ТрНСтруктура.ОпГруз, ТрНСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГруз_ПЭ(XDTO_СвГруз, СвГруз)

	ЭлементXDTO_СвГруз = НовыйЭлементСпискаXDTO(XDTO_СвГруз);
	
	ЭлементXDTO_СвГруз.ПрУведСторон = ?(СвГруз.ПрУведСторон = Истина, "1", "0");
	ЭлементXDTO_СвГруз.ОтмПрием = ?(СвГруз.ОтмПрием = Истина, "1", "0");
	
	Если ЗначениеЗаполнено(СвГруз.ДатОтгрС) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатОтгрС", Формат_ДатаДляXml(СвГруз.ДатОтгрС));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатОтгрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатОтгрПо", Формат_ДатаДляXml(СвГруз.ДатОтгрПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатОтгрС) И ЗначениеЗаполнено(СвГруз.ДатОтгрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ВрОтгр", Формат(СвГруз.ДатОтгрС, "ДФ=HH:mm") + "-" + Формат(СвГруз.ДатОтгрПо, "ДФ=HH:mm") + СмещениеUTCДляXml(СвГруз.ДатОтгрПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатДостГрС) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатДостГрС", Формат_ДатаДляXml(СвГруз.ДатДостГрС));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатДостГрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатДостГрПо", Формат_ДатаДляXml(СвГруз.ДатДостГрПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатДостГрС) И ЗначениеЗаполнено(СвГруз.ДатДостГрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ВрДостГр", Формат(СвГруз.ДатДостГрС, "ДФ=HH:mm") + "-" + Формат(СвГруз.ДатДостГрПо, "ДФ=HH:mm") + СмещениеUTCДляXml(СвГруз.ДатДостГрПо));
	КонецЕсли;
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз, "ИдентПартГруз", СвГруз, "ИдентПартГруз");
	
	ЭлементXDTO_СвГруз.ПрзПрвз = "0"; 
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз, "КолМестПарт", СвГруз, "КолМестПарт");
	
 	ЗаполнитьXDTO_УчастникТрНТип(ЭлементXDTO_СвГруз.СвГО, СвГруз.СвГО);
 	ЗаполнитьXDTO_УчастникТрНТип(ЭлементXDTO_СвГруз.СвГП, СвГруз.СвГП);
	
	ЗаполнитьXDTO_СвТС_ПЭ(ЭлементXDTO_СвГруз, СвГруз);
 	ЗаполнитьXDTO_УказКлнт(ЭлементXDTO_СвГруз.УказКлнт, СвГруз);
	
	ЗаполнитьXDTO_Вес_ПЭ(ЭлементXDTO_СвГруз.ВесГрузПарт, СвГруз.ВесГрузПарт);
		
	//АдрГруз 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз.АдрГруз, "МестоПрием", СвГруз, "АдрГруз.МестоПрием");
	КодСтраны 	= ЕстьИЗначениеСвойствоСтруктуры(СвГруз, "АдрГруз.АдрПриемГруз.Адрес.АдрИнф.КодСтр");
	Адрес 		= ЕстьИЗначениеСвойствоСтруктуры(СвГруз, "АдрГруз.АдрПриемГруз.Адрес.АдрИнф.АдрТекст");
	АдресРФ		= ЕстьИЗначениеСвойствоСтруктуры(СвГруз, "АдрГруз.АдрПриемГруз.Адрес.АдрРФ");
	ЗаполнитьXDTO_Адрес(ЭлементXDTO_СвГруз.АдрГруз.АдрПриемГруз.Адрес, Адрес, АдресРФ, КодСтраны);
	
	//АдрГруз 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз.АдрПунктНазн, "МестоВыд", СвГруз, "АдрПунктНазн.МестоВыд");
	КодСтраны 	= ЕстьИЗначениеСвойствоСтруктуры(СвГруз, "АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.КодСтр");
	Адрес 		= ЕстьИЗначениеСвойствоСтруктуры(СвГруз, "АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.АдрТекст");
	АдресРФ		= ЕстьИЗначениеСвойствоСтруктуры(СвГруз, "АдрПунктНазн.АдрВыдГруз.Адрес.АдрРФ");
	ЗаполнитьXDTO_Адрес(ЭлементXDTO_СвГруз.АдрПунктНазн.АдрВыдГруз.Адрес, Адрес, АдресРФ, КодСтраны);

	
	ЗаполнитьСписокXDTO_ОпГруз_ПЭ(ЭлементXDTO_СвГруз.ОпГруз, СвГруз.ОпГруз, ЭлементXDTO_СвГруз);
	
	ЗаполнитьXDTO_ИнфПол(ЭлементXDTO_СвГруз.ИнфПол, СвГруз);
	
КонецПроцедуры

