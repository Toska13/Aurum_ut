КонецФункции

Функция УдалитьПустыеСвойстваXDTO(ОбъектXDTO)
	
	ЕстьЗаполненныеСвойства = Ложь;
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		
		Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
			
			ТекущееСвойствоЗаполнено = УдалитьПустыеСвойстваXDTO(ОбъектXDTO[Свойство.Имя]);
			
			Если НЕ ТекущееСвойствоЗаполнено Тогда
				ОбъектXDTO.Сбросить(Свойство.Имя);
			КонецЕсли;
			
			ЕстьЗаполненныеСвойства = ЕстьЗаполненныеСвойства или ТекущееСвойствоЗаполнено;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда
		
		Для Каждого ЭлементКоллекции Из ОбъектXDTO Цикл
			УдалитьПустыеСвойстваXDTO(ЭлементКоллекции);
		КонецЦикла;	
		
		ЕстьЗаполненныеСвойства = (ОбъектXDTO.Количество() > 0);  // если нет строк, то удалим этот тег
		
	Иначе  // уткнулись в конец ветки, в примитивный / ссылочный тип
		
		ЕстьЗаполненныеСвойства = (ЗначениеЗаполнено(ОбъектXDTO) и ОбъектXDTO <> 0);  // значение "0" не будем считать пустым
		
	КонецЕсли;
	
	Возврат ЕстьЗаполненныеСвойства;
	
КонецФункции

Функция XDTO_Вычислить(ОбъектXDTO, Путь) Экспорт 
	
	ТекущийЭлемент = ОбъектXDTO;
	
	ТипСписок = Тип("СписокXDTO");
	
	МассивСлов = РазложитьСтрокуВМассивПодстрокЛогистика(Путь,".");
	
	Для Каждого ТекущийПуть Из МассивСлов Цикл
		
		Если ТекущийЭлемент = Неопределено Или ТипЗнч(ТекущийЭлемент) = ТипСписок Тогда
			ТекущийЭлемент = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТекущийЭлемент = XDTO_ПолучитьЗначениеСвойства(ТекущийЭлемент, ТекущийПуть);
		
	КонецЦикла;
	
	Возврат ТекущийЭлемент;

КонецФункции

Функция XDTO_ПолучитьЗначениеСвойства(ОбъектXDTO, ИмяСвойства) Экспорт
	
	ТекЗначение = Неопределено;
	
	Если ОбъектXDTO <> Неопределено 
		И НЕ ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда
		
		ТекЗначение = ОбъектXDTO[ИмяСвойства];
		
	КонецЕсли;
	
	Возврат ТекЗначение;
	
КонецФункции

Функция СписокXDTOИзЭлемента(ОбъектXDTO, ИмяСвойства)
	
	Если XDTO_ЕстьСвойство(ОбъектXDTO, ИмяСвойства) Тогда
		
		Элемент = ОбъектXDTO[ИмяСвойства];
		
		Если ТипЗнч(Элемент) = Тип("СписокXDTO") Тогда
			Результат = Элемент;
		Иначе
			Результат = Новый Массив;
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	Иначе
		Результат = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XDTO_ЕстьСвойство(ОбъектXDTO, ИмяСвойства)

	Результат = Ложь;
	
	Если ОбъектXDTO <> Неопределено 
		И НЕ ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


