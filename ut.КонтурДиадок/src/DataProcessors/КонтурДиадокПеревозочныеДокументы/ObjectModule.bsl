				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Колонка Из СписокКолонок Цикл
				УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТовара[Колонка.Имя]);
			КонецЦикла;
			
			мРезультат.Добавить(Сведение);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Груз Из ОпГруз Цикл
			
			Сведение = ОпГрузТипТрН();
			Для Каждого СтрокаТовара Из ОбщаяТаблицаТоваров Цикл
				Если Груз.Номенклатура = СтрокаТовара.Номенклатура Тогда
					Для Каждого Колонка Из СписокКолонок Цикл
						УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТовара[Колонка.Имя]);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла; 
			Для Каждого КлючЗначение Из Груз Цикл
				Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					Сведение.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЕсли;
			КонецЦикла;

			мРезультат.Добавить(Сведение);

		КонецЦикла;
			
	КонецЕсли;
	
	Для Каждого Сведение Из мРезультат Цикл
		
		Если Сведение.Свойство("СпУпак")
			И Не ЗначениеЗаполнено(Сведение.СпУпак) Тогда
			Сведение.СпУпак = "картонные коробки";
		КонецЕсли;
		
		Если Сведение.Свойство("СостГруз")
			И Не ЗначениеЗаполнено(Сведение.СостГруз) Тогда
			Сведение.СостГруз = "упаковка не нарушена";
		КонецЕсли;
		
		Если ЕстьСвойствоСтруктуры(Сведение, "ЦеннГруз.Валюта")
			И (Не ЗначениеЗаполнено(Сведение.ЦеннГруз.Валюта) 
			Или ТипЗнч(Сведение.ЦеннГруз.Валюта) = Тип("Строка")) Тогда
			Сведение.ЦеннГруз.Валюта = Справочники["Валюты"].НайтиПоКоду(643); //рубль по умолчанию
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Сведение.ВидТар) Тогда
			Сведение.ВидТар = "00";
			Сведение.ВидТарПредставление = "не указан";
		КонецЕсли;
		
		КолМестПрием = КолМестПрием + Сведение.КолМестГр;
		МасБрутЗнач = ЕстьИЗначениеСвойствоСтруктуры(Сведение, "ПлМасГруз.МасБрутЗнач", 0);
		МасБрутОтгр = МасБрутОтгр + МасБрутЗнач;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Результат.СвПогруз.КолМестПрием) Тогда
		Результат.СвПогруз.КолМестПрием = КолМестПрием;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.СвПогруз.МасБрутОтгр) Тогда
		Результат.СвПогруз.МасБрутОтгр = МасБрутОтгр;
	КонецЕсли;

	Результат.Вставить("ОпГруз", мРезультат);
	
КонецПроцедуры

Процедура ОбработатьОпГрузПЭ(ДокументыОснования, Результат, Приоритет)
	
	//необхдимо задать приритетность, либо допсв либо учСист
	мРезультат = Новый Массив;
	ОпГруз = Результат.СвГруз.ОпГруз;
	КолМестГр = 0;
	ВесГруз_ВесБрутто = 0;
	ВесГруз_ВесНетто = 0;
	
	ОпГрузТип = ОпГрузТипПЭ();
	ОбщаяТаблицаТоваров = ДанныеТоварыДокументов(ДокументыОснования, ОпГрузТип);
	СписокКолонок = ОбщаяТаблицаТоваров.Колонки;
	
	Если Приоритет = "УчСис" Тогда
		
		Для Каждого СтрокаТовара Из ОбщаяТаблицаТоваров Цикл
			
			Сведение = ОпГрузТипПЭ();
			
			Для Каждого Груз Из ОпГруз Цикл
				Если Груз.Номенклатура = СтрокаТовара.Номенклатура Тогда
					ЗаполнитьЗначенияСвойств(Сведение, Груз); //заполнение из доп. свойств
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Колонка Из СписокКолонок Цикл
				УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТовара[Колонка.Имя]);
			КонецЦикла;
			
			мРезультат.Добавить(Сведение);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Груз Из ОпГруз Цикл
			
			Сведение = ОпГрузТипПЭ();
			Для Каждого СтрокаТовара Из ОбщаяТаблицаТоваров Цикл
				Если Груз.Номенклатура = СтрокаТовара.Номенклатура Тогда
					Для Каждого Колонка Из СписокКолонок Цикл
						УстановитьЗначениеИзСтрокиВСтруктуру(Сведение, Колонка.Имя, СтрокаТовара[Колонка.Имя]);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла; 
			Для Каждого КлючЗначение Из Груз Цикл
				Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					Сведение.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЕсли;
			КонецЦикла;

			мРезультат.Добавить(Сведение);

		КонецЦикла;
			
	КонецЕсли;
	
	Для Каждого Сведение Из мРезультат Цикл
				
		Если ЕстьСвойствоСтруктуры(Сведение, "ОбъявлСтГруз.Валюта")
			И (Не ЗначениеЗаполнено(Сведение.ОбъявлСтГруз.Валюта) 
			Или ТипЗнч(Сведение.ОбъявлСтГруз.Валюта) = Тип("Строка")) Тогда
			Сведение.ОбъявлСтГруз.Валюта = Справочники["Валюты"].НайтиПоКоду(643); //рубль по умолчанию
		КонецЕсли;
				
		КолМестГр = КолМестГр + Сведение.КолМестГр;
		ВесГруз_ВесБрутто = ВесГруз_ВесБрутто + ЕстьИЗначениеСвойствоСтруктуры(Сведение, "ВесГруз.ВесБрутто", 0);
		ВесГруз_ВесНетто = ВесГруз_ВесНетто + ЕстьИЗначениеСвойствоСтруктуры(Сведение, "ВесГруз.ВесНетто", 0);
		
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Результат.СвГруз.КолМестПарт) Тогда
		Результат.СвГруз.КолМестПарт = КолМестГр;
	КонецЕсли;                   
	Если Не ЗначениеЗаполнено(Результат.СвГруз.ВесГрузПарт.ВесБрутто) Тогда
		Результат.СвГруз.ВесГрузПарт.ВесБрутто = ВесГруз_ВесБрутто;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.СвГруз.ВесГрузПарт.ВесНетто) Тогда
		Результат.СвГруз.ВесГрузПарт.ВесНетто = ВесГруз_ВесНетто;
	КонецЕсли;

	Результат.СвГруз.Вставить("ОпГруз", мРезультат);
	
КонецПроцедуры

