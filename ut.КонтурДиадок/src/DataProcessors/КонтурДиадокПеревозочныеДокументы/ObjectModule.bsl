Процедура ЗаполнитьПоКартеКлючей(Приемник, Источник, КартаКлючей)
	
	Если ТипЗнч(Приемник) <> Тип("Структура")
		Или ТипЗнч(Источник) <> Тип("Структура")
		Или ТипЗнч(КартаКлючей) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	//сначала проверим что есть данные по карте ключей, потом если есть данные, добавим ссылку.
	//это необходимо чтобы после данные по ссылке считались обработанными и не заполнялись по умолчанию
	ЕстьЗначения = Ложь;
	КлючСсылка = Неопределено;
	Для Каждого ЭлементКарты Из КартаКлючей Цикл
		
		КлючПриемника = ЭлементКарты.Ключ;
		КлючИсточника = ЭлементКарты.Значение;
		ЗначениеИсточника = ЕстьИЗначениеСвойствоСтруктуры(Источник, КлючИсточника);
		
		Если Прав(КлючПриемника, 6) = "Ссылка" Тогда 
			КлючСсылка = КлючПриемника;
			Продолжить;
		ИначеЕсли ЗначениеИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//Телефон необходимо преобразовать в массив
		Если Прав(КлючПриемника, 4) = ".Тлф" Или Прав(КлючПриемника, 7) = ".ЭлПочта" Тогда
			мЗначениеИсточника = Новый Массив;
			мЗначениеИсточника.Добавить(ЗначениеИсточника);
			УстановитьЗначениеСвойстваСтруктуры(Приемник, КлючПриемника, мЗначениеИсточника);
		Иначе	
			УстановитьЗначениеСвойстваСтруктуры(Приемник, КлючПриемника, ЗначениеИсточника);
		КонецЕсли;

		ЕстьЗначения = Истина;
		
	КонецЦикла; 
	
	Если ЕстьЗначения И КлючСсылка <> Неопределено Тогда
		УстановитьЗначениеСвойстваСтруктуры(Приемник, КлючСсылка, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьОпГрузПоКарте(ИсточникОпГруз, техДокОсн)
	
	Результат = Новый Массив;
	Если ТипЗнч(ИсточникОпГруз) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	КартаОпГруз = КартаОпГрузЭтРнИзЗЗ();
	Для Каждого ЭлементЗЗ Из ИсточникОпГруз Цикл
		
		Если ТипЗнч(ЭлементЗЗ) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если техДокОсн.Количество() > 0 И 
			техДокОсн.Найти(ЭлементЗЗ.техДокОсн) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементТрН = ОпГрузТипТрН();
		ЗаполнитьПоКартеКлючей(ЭлементТрН, ЭлементЗЗ, КартаОпГруз);
		Результат.Добавить(ЭлементТрН);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьСтруктуруПоШаблону(Шаблон)
	
	Результат = Новый Структура;
	Если ТипЗнч(Шаблон) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Шаблон Цикл
		ЗначениеШаблона = КлючЗначение.Значение;
		Если ТипЗнч(ЗначениеШаблона) = Тип("Структура") Тогда
			Результат.Вставить(КлючЗначение.Ключ, СоздатьСтруктуруПоШаблону(ЗначениеШаблона));
		ИначеЕсли ТипЗнч(ЗначениеШаблона) = Тип("Массив") Тогда
			Результат.Вставить(КлючЗначение.Ключ, ЗаполнитьМассивПоШаблону(ЗначениеШаблона, Новый Массив));
		Иначе
			Результат.Вставить(КлючЗначение.Ключ, ЗначениеШаблона);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьМассивПоШаблону(ШаблонМассива, ИсточникМассива)
	
	Результат = Новый Массив;
	Если ТипЗнч(ИсточникМассива) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ШаблонЭлемента = Неопределено;
	Если ТипЗнч(ШаблонМассива) = Тип("Массив")
		И ШаблонМассива.Количество() > 0 Тогда
		ШаблонЭлемента = ШаблонМассива[0];
	КонецЕсли;
	
	Для Каждого ЭлементИсточника Из ИсточникМассива Цикл
		Если ТипЗнч(ШаблонЭлемента) = Тип("Структура")
			И ТипЗнч(ЭлементИсточника) = Тип("Структура") Тогда
			ЭлементПриемника = СоздатьСтруктуруПоШаблону(ШаблонЭлемента);
			ЗаполнитьСтруктуруПоШаблону(ЭлементПриемника, ЭлементИсточника);
			Результат.Добавить(ЭлементПриемника);
		Иначе
			Результат.Добавить(ЭлементИсточника);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтруктуруПоШаблону(Приемник, Источник)
	
	Если ТипЗнч(Приемник) <> Тип("Структура")
		Или ТипЗнч(Источник) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Приемник Цикл
		ИмяСвойства = КлючЗначение.Ключ;
		ЗначениеИсточника = Неопределено;
		Если Не Источник.Свойство(ИмяСвойства, ЗначениеИсточника) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПриемника = КлючЗначение.Значение;
		Если ТипЗнч(ЗначениеПриемника) = Тип("Структура")
			И ТипЗнч(ЗначениеИсточника) = Тип("Структура") Тогда
			ЗаполнитьСтруктуруПоШаблону(ЗначениеПриемника, ЗначениеИсточника);
		ИначеЕсли ТипЗнч(ЗначениеПриемника) = Тип("Массив")
			И ТипЗнч(ЗначениеИсточника) = Тип("Массив") Тогда
			Приемник[ИмяСвойства] = ЗаполнитьМассивПоШаблону(ЗначениеПриемника, ЗначениеИсточника);
		Иначе
			Приемник[ИмяСвойства] = ЗначениеИсточника;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьЭтРнБазовая(ДанныеЗЗ, техДокОсн)
	
	Результат = Новый Структура;
	
	Если ТипЗнч(ДанныеЗЗ) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗаполнитьПоКартеКлючей(Результат, ДанныеЗЗ, КартаЗаполненияЭтРнИзЗЗ());
	ЗаполнитьПоКартеКлючей(Результат, ДанныеЗЗ, КартаТС("СвТС", "СодИнфПрв.СвТС"));
	ЗаполнитьПоКартеКлючей(Результат, ДанныеЗЗ, КартаВодитель("СвВодит1", "СодИнфПрв.СвВодит"));
	
	ОпГрузЗЗ = Неопределено;
	Если ДанныеЗЗ.Свойство("ОпГруз", ОпГрузЗЗ)
		И ТипЗнч(ОпГрузЗЗ) = Тип("Массив") Тогда
		Результат.Вставить("ОпГруз", ЗаполнитьОпГрузПоКарте(ОпГрузЗЗ, техДокОсн));
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьЭтРн(ДанныеЗЗ) Экспорт

	Результат = Новый Массив;
	
	Если ТипЗнч(ДанныеЗЗ) <> Тип("Структура") Тогда
		БазоваяТрН = ЗаполнитьЭтРнБазовая(ДанныеЗЗ, Новый Массив);
		Результат.Добавить(БазоваяТрН);
		Возврат Результат;
	КонецЕсли;
	
	//адрес, получатель, документы 
	ДанныеПоПункту = Новый ТаблицаЗначений;
	ДанныеПоПункту.Колонки.Добавить("АдресПункта");
	ДанныеПоПункту.Колонки.Добавить("АдресПунктаРФ");
	ДанныеПоПункту.Колонки.Добавить("РекИдентГП");
	ДанныеПоПункту.Колонки.Добавить("техДокОсн");

	АдрПунктЗЗ = Неопределено;
	Если ДанныеЗЗ.Свойство("АдрПункт", АдрПунктЗЗ)
		И ТипЗнч(АдрПунктЗЗ) = Тип("Массив") Тогда 
		
		Для Каждого Пункт Из АдрПунктЗЗ Цикл
			
			Если ТипЗнч(Пункт) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Пункт.Опер <> "Выгрузка" Тогда
				Продолжить;
			КонецЕсли;
			
			АдресПункта = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "АдресПункт.Адрес.АдрИнф.АдрТекст");
			АдресПунктаРФ = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "АдресПункт.Адрес.АдрРФ");
			Если АдресПункта = Неопределено Тогда
				АдресПункта = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "Адрес.АдрИнф.АдрТекст");
				АдресПунктаРФ = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "Адрес.АдрРФ");
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(АдресПункта) Тогда
				Продолжить;
			КонецЕсли;
			РекИдентГП = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "ОргВладИнфр");
			техДокОсн = ЕстьИЗначениеСвойствоСтруктуры(Пункт, "техДокОсн");
			
			НовСтрока = ДанныеПоПункту.Добавить();
			НовСтрока.АдресПункта = АдресПункта;
			НовСтрока.АдресПунктаРФ = АдресПунктаРФ;
			НовСтрока.РекИдентГП = РекИдентГП;
			НовСтрока.техДокОсн = техДокОсн;
			
		КонецЦикла;

	КонецЕсли;
	
	АдресаПунктов = ДанныеПоПункту.Скопировать();
	АдресаПунктов.Свернуть("АдресПункта, АдресПунктаРФ, РекИдентГП");
	Для Каждого Пункт Из АдресаПунктов Цикл
		
		Поиск = Новый Структура("АдресПункта, АдресПунктаРФ, РекИдентГП");
		ЗаполнитьЗначенияСвойств(Поиск, Пункт);
		НашлиСтроки = ДанныеПоПункту.НайтиСтроки(Поиск);
		техДокОсн = Новый Массив;
		Для Каждого НашлиСтроку Из НашлиСтроки Цикл
			Если НашлиСтроку.техДокОсн <> Неопределено Тогда
				техДокОсн.Добавить(НашлиСтроку.техДокОсн);	    
			КонецЕсли;
		КонецЦикла;
		
		ТрНПоПункту = ЗаполнитьЭтРнБазовая(ДанныеЗЗ, техДокОсн);
		
		УстановитьЗначениеСвойстваСтруктуры(ТрНПоПункту, "СвГП.АдресДостГр.Адрес", Пункт.АдресПункта);
		УстановитьЗначениеСвойстваСтруктуры(ТрНПоПункту, "СвГП.АдресДостГр.АдресРФ", Пункт.АдресПунктаРФ);
		УстановитьЗначениеСвойстваСтруктуры(ТрНПоПункту, "СвГП.РекИдентГП", Пункт.РекИдентГП);
		УстановитьЗначениеСвойстваСтруктуры(ТрНПоПункту, "техДокОсн", техДокОсн);
		
		Результат.Добавить(ТрНПоПункту);
		
	КонецЦикла;
		
	Если Результат.Количество() = 0 Тогда
		БазоваяТрН = ЗаполнитьЭтРнБазовая(ДанныеЗЗ, Новый Массив);
		Результат.Добавить(БазоваяТрН);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОтветныйТитулЗЗ(СтрокаСписка) Экспорт  

	ДанныеТитула = Неопределено;
	Если ЕстьИЗаполненоСвойствоСтруктуры(СтрокаСписка, "BoxId")
		И ЕстьИЗаполненоСвойствоСтруктуры(СтрокаСписка, "LetterId")
		И ЕстьИЗаполненоСвойствоСтруктуры(СтрокаСписка, "DocumentId") Тогда
		
		ИдентификаторыДокумента = Новый Структура("BoxId, LetterId, DocumentId", СтрокаСписка.BoxId, СтрокаСписка.LetterId, СтрокаСписка.DocumentId); 
		ОтветныйТитул = _Ядро.Документы_ДанныхХранения_АПИ(ИдентификаторыДокумента, "ТитулПокупателя");
		
		Если ОтветныйТитул.Данные <> Неопределено Тогда
			ДанныеТитула = ДвоичныеДанные_В_XMLДокумент(ОтветныйТитул.Данные);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДанныеТитула;
	
КонецФункции

