//          Если строка не содержит указанной подстроки, то возвращается 0.
//
Функция СтрНайтиЛок(Строка, ПодстрокаПоиска) Экспорт
	
	// BSLLS:DeprecatedFind-off
	Результат = Найти(Строка, ПодстрокаПоиска);
	// BSLLS:DeprecatedFind-on
	
	Возврат Результат;
	
КонецФункции

