			ОписаниеОшибки.ИдентификаторАкта = СтрокаТЗ.ИдентификаторСтроки;
			ОписаниеОшибки.ТекстОшибки = "Заполните стороны составителей акта";
			
			Ошибки.Добавить(ОписаниеОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
