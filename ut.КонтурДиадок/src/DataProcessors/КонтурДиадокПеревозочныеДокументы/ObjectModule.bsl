	XDTO.ДатаДок 	= Формат_ДатаДляXml(ПЭСтруктура.ДатаДок);
	
	XDTO.ДокГруз = 0;
	Если ЕстьИЗаполненоСвойствоСтруктуры(ПЭСтруктура, "СопрДок") Тогда
		Если ПЭСтруктура.СопрДок.Количество() > 0 Тогда
			XDTO.ДокГруз = 1;
		КонецЕсли;
	КонецЕсли;
	
	//XDTO.ОбщОбъявлСтГруз = ЕстьИЗначениеСвойствоСтруктуры(ПЭСтруктура, "ОбщОбъявлСтГруз", 0);
