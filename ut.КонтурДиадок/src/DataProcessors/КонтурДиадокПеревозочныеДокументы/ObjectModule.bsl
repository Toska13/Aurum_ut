//****************************************************************************
//{ ИДЕНТИФИКАТОРЫ ЭДО

Функция ИдентификаторыЭДО(Участник, ЭтоГрузоотправитель) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("BoxId", "");
	Результат.Вставить("ID", "");
	
	Если ЗначениеЗаполнено(Участник) Тогда
				
		Если ЭтоГрузоотправитель Тогда
			
			BoxId = _Ядро.Организации_ИдентификаторПоСсылке(Участник);
			
			Если BoxId <> Неопределено Тогда
				Идентификаторы = _Ядро.Новый_ИдентификаторыСправочника(Неопределено, BoxId);
				Реквизиты = _Ядро.Организации_ЗаполненныеРеквизиты(Идентификаторы);
				ID = Реквизиты.ИдентификаторУчастникаЭДО;
				Результат.Вставить("ID", ID);
				Результат.Вставить("BoxId", BoxId);
			КонецЕсли;

		Иначе
			
			BoxId = _Ядро.Контрагенты_ИдентификаторПоСсылке(Участник);
			
			Если BoxId <> Неопределено Тогда
				Идентификаторы = _Ядро.Новый_ИдентификаторыСправочника(Неопределено, BoxId);
				Реквизиты = _Ядро.Контрагенты_ЗаполненныеРеквизиты(Идентификаторы);
				ID = Реквизиты.ИдентификаторУчастникаЭДО;
				Результат.Вставить("ID", ID);
				Результат.Вставить("BoxId", BoxId);
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
//} ИДЕНТИФИКАТОРЫ ЭДО



//****************************************************************************
//{ ПОДБОР СКД

Функция ИнициализироватьСКД(МассивНастроек) Экспорт
	
	НовыйСКД = Новый СхемаКомпоновкиДанных();
	
	Источник = НовыйСКД.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных1";
	Источник.СтрокаСоединения = "";
	Источник.ТипИсточникаДанных = "Local";	
	
	НаборДанныхОбъединение = НовыйСКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных"));  
	НаборДанныхОбъединение.Имя = "ОбъединениеНаборов";
		
	ИндексНабора = 0;
	
	Для Каждого СтруктураНастройкиТипа Из МассивНастроек Цикл
		
		МетаданныеДокумента = СтруктураНастройкиТипа.МетаданныеДокумента;
		МетаданныеДокументаПредставление = СтруктураНастройкиТипа.МетаданныеДокументаПредставление;
		ИдентификаторНастройки = СтруктураНастройкиТипа.ИдентификаторНастройки;
		
		ДополнительныеПоля = Новый Массив;
		
		Если ЗначениеЗаполнено(МетаданныеДокумента) И ЗначениеЗаполнено(ИдентификаторНастройки) Тогда 
			
			// запрос используется для построения списка документов при добавлении ЭПД
			// передается в запрос динамического списка.
			ТекстЗапроса = "";
			ТекстЗапроса = ТекстЗапроса + "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	" + """" + СокрЛП(ИдентификаторНастройки) + """" + " КАК ИдентификаторНастройки,
			|	" + """" + МетаданныеДокумента + """" + " КАК РежимПодбора,
			|	" + """" + МетаданныеДокумента + """" + " КАК ТипДокумента,
			|	" + """" + МетаданныеДокументаПредставление + """" + " КАК ТипДокументаПредставление,
			|	ВЫБОР КОГДА ДанныеОбъекта.Проведен ТОГДА 2
			|	КОГДА ДанныеОбъекта.ПометкаУдаления ТОГДА 3
			|	ИНАЧЕ 0 КОНЕЦ КАК НомерКартинки,
			|	ДанныеОбъекта.Ссылка КАК Ссылка,
			|	ДанныеОбъекта.Проведен КАК Проведен,
			|	ДанныеОбъекта.Дата КАК Дата,
			|	ДанныеОбъекта.Номер КАК Номер,
			|	ВЫБОР КОГДА СведенияИдентификаторТрН.Объект ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ  КАК ЕстьЭТрН,
			|	ВЫБОР КОГДА СведенияИдентификаторЗЗ.Объект ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ  КАК ЕстьЭЗЗ, 
			|	ВЫБОР КОГДА СведенияИдентификаторПЭ.Объект ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ  КАК ЕстьЭПЭ, 
			|	" + ?(ЕстьРеквизитМетаданных(МетаданныеДокумента, "Организация"), "ДанныеОбъекта.Организация", "Неопределено") + " КАК Организация, 
			|	" + ?(ЕстьРеквизитМетаданных(МетаданныеДокумента, "Контрагент"), "ДанныеОбъекта.Контрагент", "Неопределено") + " КАК Контрагент, 
			|	" + ?(ЕстьРеквизитМетаданных(МетаданныеДокумента, "Грузоотправитель"), "ДанныеОбъекта.Грузоотправитель", "Неопределено") + " КАК Грузоотправитель, 
			|	" + ?(ЕстьРеквизитМетаданных(МетаданныеДокумента, "Грузополучатель"), "ДанныеОбъекта.Грузополучатель", "Неопределено") + " КАК Грузополучатель, 
			|	" + ?(ЕстьРеквизитМетаданных(МетаданныеДокумента, "СуммаДокумента"), "ДанныеОбъекта.СуммаДокумента", "Неопределено") + " КАК СуммаДокумента
			|ИЗ
			|	" + МетаданныеДокумента + " КАК ДанныеОбъекта 
			
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияИдентификаторТрН
			|		ПО СведенияИдентификаторТрН.Объект = ДанныеОбъекта.Ссылка
			|			И (СведенияИдентификаторТрН.Свойство = &Свойство_ИдентификаторТрН)

			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияИдентификаторЗЗ
			|		ПО СведенияИдентификаторЗЗ.Объект = ДанныеОбъекта.Ссылка
			|			И (СведенияИдентификаторЗЗ.Свойство = &Свойство_ИдентификаторЗЗ)

			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияИдентификаторПЭ
			|		ПО СведенияИдентификаторПЭ.Объект = ДанныеОбъекта.Ссылка
			|			И (СведенияИдентификаторПЭ.Свойство = &Свойство_ИдентификаторПЭ)

			|ГДЕ ДанныеОбъекта.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
			
			НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + НазваниеРегистраДополнительныеСвойства);
			
			НаборДанных = НаборДанныхОбъединение.Элементы.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
			НаборДанных.Имя = "НаборДанных" + Формат(ИндексНабора, "ЧГ=");
			НаборДанных.Запрос = ТекстЗапроса;
			НаборДанных.ИсточникДанных = "ИсточникДанных1";
			НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;

		КонецЕсли;    
		
	КонецЦикла;
	
	ДобавитьПоле(НаборДанныхОбъединение, "ЕстьЭТрН", "Есть ЭТрН", Ложь, Ложь);
	ДобавитьПоле(НаборДанныхОбъединение, "ЕстьЭЗЗ", "Есть ЭЗЗ", Ложь, Ложь);
	ДобавитьПоле(НаборДанныхОбъединение, "ЕстьЭПЭ", "Есть ЭПЭ", Ложь, Ложь);
	ДобавитьПоле(НаборДанныхОбъединение, "ИдентификаторНастройки", "ИдентификаторНастройки", Истина, Ложь);
	ДобавитьПоле(НаборДанныхОбъединение, "НомерКартинки", "НомерКартинки", Истина, Ложь);
	ДобавитьПоле(НаборДанныхОбъединение, "ТипДокумента", "ТипДокумента", Истина, Ложь);
	ДобавитьПоле(НаборДанныхОбъединение, "ТипДокументаПредставление", "ТипДокументаПредставление", Истина, Ложь);
	Если Не ЕстьРеквизитМетаданных(МетаданныеДокумента, "Организация") Тогда
		ДобавитьПоле(НаборДанныхОбъединение, "Организация", "Организация", Истина, Ложь);
	КонецЕсли;
	Если Не ЕстьРеквизитМетаданных(МетаданныеДокумента, "Контрагент") Тогда
		ДобавитьПоле(НаборДанныхОбъединение, "Контрагент", "Контрагент", Истина, Ложь);
	КонецЕсли;
	Если Не ЕстьРеквизитМетаданных(МетаданныеДокумента, "Грузоотправитель") Тогда
		ДобавитьПоле(НаборДанныхОбъединение, "Грузоотправитель", "Грузоотправитель", Истина, Ложь);
	КонецЕсли;
	Если Не ЕстьРеквизитМетаданных(МетаданныеДокумента, "Грузополучатель") Тогда
		ДобавитьПоле(НаборДанныхОбъединение, "Грузополучатель", "Грузополучатель", Истина, Ложь);
	КонецЕсли;
	
	Если НаборДанныхОбъединение.Элементы.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе           
		Возврат НовыйСКД;
	КонецЕсли;
	
КонецФункции

Функция ЕстьРеквизитМетаданных(МетаданныеДокумента, ИмяРеквизита) Экспорт

	Если ТипЗнч(МетаданныеДокумента) = Тип("Строка") Тогда
		мтд = Метаданные.НайтиПоПолномуИмени(МетаданныеДокумента);
	Иначе
		мтд = МетаданныеДокумента;
	КонецЕсли;
	
	Если мтд <> Неопределено Тогда
		Если мтд.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат Истина;
		ИначеЕсли Метаданные.ОбщиеРеквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция РеквизитМетаданных(МетаданныеДокумента, ДанныеРеквизитов) Экспорт
	
	Если ТипЗнч(МетаданныеДокумента) = Тип("Строка") Тогда
		мтд = Метаданные.НайтиПоПолномуИмени(МетаданныеДокумента);
	Иначе
		мтд = МетаданныеДокумента;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеРеквизитов) = Тип("Массив") Тогда
		ИменаРеквизитов = ДанныеРеквизитов;
	Иначе
		ИменаРеквизитов = Новый Массив;
		ИменаРеквизитов.Добавить(ДанныеРеквизитов);
	КонецЕсли;
	
	Если мтд <> Неопределено Тогда
		Для Каждого ЭлементИмяРеквизита Из ИменаРеквизитов Цикл
			Если мтд.Реквизиты.Найти(ЭлементИмяРеквизита) <> Неопределено Тогда
				Возврат ЭлементИмяРеквизита;
			ИначеЕсли Метаданные.ОбщиеРеквизиты.Найти(ЭлементИмяРеквизита) <> Неопределено Тогда
				Возврат ЭлементИмяРеквизита;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьПоле(НаборДанных, ИмяПоля, ЗаголовокПоля, ОграничениеУсловие, ОграничениеПоле)
	
	ДобавленноеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ДобавленноеПоле.Заголовок = ЗаголовокПоля;
	ДобавленноеПоле.ПутьКДанным = ИмяПоля;
	ДобавленноеПоле.Поле = ИмяПоля;  
	ДобавленноеПоле.ОграничениеИспользования.Условие = ОграничениеУсловие;
	ДобавленноеПоле.ОграничениеИспользования.Поле = ОграничениеПоле;
	
КонецПроцедуры

Процедура ДобавитьОтборыСхемыКомпоновкиРекурсивно(ОтборСКД, ЭлементыОтбора) Экспорт
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		ТипЗначенияОтбора = ТипЗнч(ЭлементОтбора); 
		
		НовыйЭлементОтбора = ОтборСКД.Элементы.Добавить(ТипЗначенияОтбора);
		ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, ЭлементОтбора);
		
		Если ТипЗначенияОтбора = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ДобавитьОтборыСхемыКомпоновкиРекурсивно(НовыйЭлементОтбора, ЭлементОтбора.Элементы);	
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Функция НастройкиПодбораПоСКДПоУмолчанию() Экспорт

	Результат = Новый Массив;                       

	//Транспортная накладная
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено Тогда
		
		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ИдентификаторНастройки", Строка(Новый УникальныйИдентификатор));
		СтрокаНастройки.Вставить("МетаданныеДокумента", Метаданные.Документы["РеализацияТоваровУслуг"].ПолноеИмя());
		СтрокаНастройки.Вставить("МетаданныеДокументаПредставление", Метаданные.Документы["РеализацияТоваровУслуг"].Представление());
		СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		СтрокаНастройки.Вставить("ПредставлениеНастройки", Метаданные.Документы["РеализацияТоваровУслуг"].Представление());
		
		Результат.Добавить(СтрокаНастройки);
		
	ИначеЕсли Метаданные.Документы.Найти("РасходнаяНакладная") <> Неопределено Тогда
		
		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ИдентификаторНастройки", Строка(Новый УникальныйИдентификатор));
		СтрокаНастройки.Вставить("МетаданныеДокумента", Метаданные.Документы["РасходнаяНакладная"].ПолноеИмя());
