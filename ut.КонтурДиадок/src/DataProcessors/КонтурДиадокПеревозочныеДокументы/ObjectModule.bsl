		|""643"" КАК СвПогруз_ФАдресПогр_КодСтраны,
		
		|" + ПолеЗапроса(Мтд, ПолеАдресДоставки(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрИнф_АдрТекст,
		|" + ПолеЗапроса(Мтд, ПолеАдресДоставкиЗначение(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрРФ,
		|""643"" КАК СвГП_АдресДостГр_КодСтраны
		
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|" + ТекстСоединенияВТ + "
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " 
		|";
		
		Прервать;
		
	КонецЦикла;
	
	Возврат ТекстЗапросаВТ + ТекстЗапроса;
	
КонецФункции

