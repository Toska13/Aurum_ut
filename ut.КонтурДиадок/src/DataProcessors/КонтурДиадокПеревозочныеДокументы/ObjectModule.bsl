КонецФункции

Функция СмещениеUTCДляXml(Дата)
	
	ЧасовойПоясСервера = ЧасовойПоясСеанса();
	УниверсальнаяДата = УниверсальноеВремя(Дата, ЧасовойПоясСервера);
	СмещениеОтUTC = СмещениеСтандартногоВремени(ЧасовойПоясСервера, УниверсальнаяДата);
	ЗнакСмещения = ?(СмещениеОтUTC >= 0, "+", "-");
	СмещениеСтрока = ЗнакСмещения + Формат(Дата(1,1,1) + ?(СмещениеОтUTC > 0, СмещениеОтUTC, -СмещениеОтUTC), "ДФ=HH:mm");
	
	Возврат СмещениеСтрока;
	
КонецФункции

Функция Формат_ДатаВремяДляXml(Дата)
	Возврат  "" + Формат(Дата, "ДФ=dd.MM.yyyy")+ "T" + Формат(Дата, "ДФ=HH:mm:ss");
КонецФункции	

Функция Формат_ДатаВремяСоСмещениемUTCДляXml(Дата)
	
	ЧасовойПоясСервера = ЧасовойПоясСеанса();
	УниверсальнаяДата = УниверсальноеВремя(Дата, ЧасовойПоясСервера);
	СмещениеОтUTC = СмещениеСтандартногоВремени(ЧасовойПоясСервера, УниверсальнаяДата);
	ЗнакСмещения = ?(СмещениеОтUTC >= 0, "+", "-");
	СмещениеСтрока = ЗнакСмещения + Формат(Дата(1,1,1) + ?(СмещениеОтUTC > 0, СмещениеОтUTC, -СмещениеОтUTC), "ДФ=HH:mm");
	
	Возврат Формат(Дата, "ДФ=dd.MM.yyyy") + "T" + Формат(Дата, "ДФ=HH:mm:ss") + СмещениеСтрока;
	
КонецФункции

