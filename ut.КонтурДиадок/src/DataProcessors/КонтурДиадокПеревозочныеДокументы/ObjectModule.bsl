	ЗначенияИли.Добавить("3");
	ЗначенияИли.Добавить("4");
	ЗначенияИли.Добавить("5");
	
	УсловиеИстины = Новый Структура;
	УсловиеИстины.Вставить("ИмяПоля", "ТипВлад");
	УсловиеИстины.Вставить("ЗначениеПоля", ЗначенияИли);
	УсловиеИстины.Вставить("Источник", "Локальный");
	УсловияИстины.Добавить(УсловиеИстины);

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ОснАрЛиз", УсловияИстины, "Договор аренды " + ДопИнфо, РеквизитНаФорме); //обяз, когда ТипВлад = 3/4/5 
	//ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ОснАрЛизВлад", УсловияИстины, "Арендодатель " + ДопИнфо, РеквизитНаФорме); //обяз, когда ТипВлад = 3/4/5 
		
КонецПроцедуры

