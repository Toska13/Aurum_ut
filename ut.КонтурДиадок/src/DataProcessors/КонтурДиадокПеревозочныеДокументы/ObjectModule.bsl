Процедура Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, ВыбранныеДокументы) Экспорт
	
	Для Счетчик = 0 По ВыбранныеДокументы.ВГраница() Цикл
		
		ТипДокумента = ВыбранныеДокументы[Счетчик].Метаданные().Имя;
		
		КоличествоДокументовТипа = ДопПеременные.Получить(ТипДокумента);
		КоличествоДокументовТипа = ?(КоличествоДокументовТипа = Неопределено, 0, КоличествоДокументовТипа);
		
		ДопПеременные.Вставить(ТипДокумента, КоличествоДокументовТипа + 1);
		
	КонецЦикла;
	
