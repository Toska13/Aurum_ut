Функция ТекстКонтентаXML(ТитулXDTO) Экспорт
	
	ФорматДокумента = ТитулXDTO.Тип().URIПространстваИмен;
	
	ПроверитьФабрикуXDTO(ФорматДокумента);
	
	УдалитьПустыеСвойстваXDTO(ТитулXDTO);
	
	Результат = ОбъектXDTO_В_СтрокуXML(ТитулXDTO);
	
	Возврат Результат;
	
КонецФункции

Процедура XDTO_СкопироватьДанныеИзОбъектаXDTO(ОбъектПриемник, ОбъектИсточник)
	
	Если ОбъектИсточник = Неопределено
		ИЛИ ОбъектПриемник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Свойство Из ОбъектПриемник.Свойства() Цикл
		
		ИмяСвойства = Свойство.Name;
		СвойствоИсточник = ОбъектИсточник.Свойства().Получить(ИмяСвойства);
		
		Если СвойствоИсточник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПриемник = ОбъектПриемник[ИмяСвойства];
		ЗначениеИсточник = ОбъектИсточник[ИмяСвойства];
		
		Если ТипЗнч(ЗначениеПриемник) = Тип("ОбъектXDTO") Тогда
			
			XDTO_СкопироватьДанныеИзОбъектаXDTO(ЗначениеПриемник, ЗначениеИсточник);
			
		ИначеЕсли ТипЗнч(ЗначениеПриемник) = Тип("СписокXDTO") Тогда
			
			// TODO Заполнение списка
			
		Иначе
			ЗаполнитьXDTO_СПроверкой(ОбъектПриемник, ИмяСвойства, ЗначениеИсточник);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьФабрикуXDTO(ФорматДокумента)
	
	Если ФабрикаXDTOНакладной = Неопределено 
		ИЛИ ФорматXDTOНакладной <> ФорматДокумента Тогда
		
		XML_ФабрикаXDTO_Инициализировать(ФорматДокумента);
		ФорматXDTOНакладной = ФорматДокумента;
		
	КонецЕсли;
	
КонецПроцедуры

