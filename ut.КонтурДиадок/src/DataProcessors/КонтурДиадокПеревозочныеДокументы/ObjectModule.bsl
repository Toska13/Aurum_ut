	ЗаполнитьXDTO_УчастникТрНТип(XDTO.СвГО, ЗЗСтруктура.СвГО);
	ЗаполнитьXDTO_УчастникТрНТип(XDTO.СвПрв, ЗЗСтруктура.СвПрв); 
	
	ЗаполнитьXDTO_ПарТСПрвзТип(XDTO.ПарТСПрвз, ЗЗСтруктура.ПарТСПрвз); 
