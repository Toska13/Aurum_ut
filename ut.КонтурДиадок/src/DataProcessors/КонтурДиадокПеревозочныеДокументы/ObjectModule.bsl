	Результат = "";
	
	АдресДостГрXDTO = ЭТрН_Титул_3_АдресДоставкиТитулаОснования(ДокументЭТрН_Титул1);
	
	Результат = ПредставлениеXDTO_АдресПользТип(АдресДостГрXDTO);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеXDTO_АдресПользТип(АдресXDTO) Экспорт
	
	Если АдресXDTO = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	АдресРФ = XDTO_Вычислить(АдресXDTO, "АдресРФ");
	АдресИнф = XDTO_Вычислить(АдресXDTO, "АдресИнф");
	КодГАР = XDTO_Вычислить(АдресXDTO, "КодГАР");
	ГЛН = XDTO_Вычислить(АдресXDTO, "ГЛН");
	Коорд = XDTO_Вычислить(АдресXDTO, "Коорд");
	
	Если АдресРФ <> Неопределено Тогда
		
		ЧастиАдреса = Новый Массив;
		
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Индекс"));
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "КодРегион"), "Код региона: ");
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Район"));
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Город"));
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "НаселПункт"));
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Улица"));
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Дом"), "дом № ");
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Корпус"), "корпус ");
		ДополнитьЧастьАдресаРФ(ЧастиАдреса, XDTO_Вычислить(АдресРФ, "Кварт"), "кв ");
		
		Разделитель = ", ";
		Результат = СтрСоединитьЛок(ЧастиАдреса, Разделитель);
		
		
	ИначеЕсли АдресИнф <> Неопределено Тогда
		
		КодСтр = XDTO_Вычислить(АдресИнф, "КодСтр");
		АдрТекст = XDTO_Вычислить(АдресИнф, "АдрТекст");
		
		ПредставлениеСтраны = НаименованиеСтраны(КодСтр);
		
		Если НЕ ЗначениеЗаполнено(ПредставлениеСтраны) Тогда
			ПредставлениеСтраны = "Код страны: " + КодСтр;
		КонецЕсли;
		
		Результат = ПредставлениеСтраны + ", " + АдрТекст;
		
	ИначеЕсли КодГАР <> Неопределено Тогда
		
		Результат = "Код ГАР: " + КодГАР;
		
	ИначеЕсли ГЛН <> Неопределено Тогда
		
		Результат = "ГЛН: " + ГЛН;
		
	ИначеЕсли Коорд <> Неопределено Тогда
		
		Долгота = XDTO_Вычислить(Коорд, "Долгота");
		Широта = XDTO_Вычислить(Коорд, "Широта");
		
		Результат = "Координаты: " + Долгота + ", " + Широта;
		
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьЧастьАдресаРФ(ЧастиАдреса, ЧастьАдреса, Префикс = "")
	
	Если ЗначениеЗаполнено(ЧастьАдреса) Тогда
		
		ПредставлениеЧастиАдреса = Префикс + ЧастьАдреса;
		ЧастиАдреса.Добавить(ПредставлениеЧастиАдреса);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НаименованиеСтраны(КодСтраны)
	
	Результат = "";
	
	СтрокаОКСМ = _Ядро.Модуль_ГенерацияXML(_Ядро).ПолучитьОКСМ().Найти(КодСтраны, "Код");
	
	Если СтрокаОКСМ <> Неопределено Тогда
		
		Результат = СтрокаОКСМ.НаименованиеКраткое;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭТрН_Титул_3_ИдФайл(Титул_1_ИдФайл)
	
	// Формат ИдФайл титулов: R_Т_A_E_О_W_GGGGMMDD_N
	Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6_%7'");
	
	R_Т = "ON_TRNACLGRPO";
	
	Части_ИдФайл = РазложитьСтрокуВМассивСлов(Титул_1_ИдФайл, "_");
	
	Если Части_ИдФайл.Количество() > 5 Тогда
		
		A = Части_ИдФайл[4]; // Перевозчик
		E = Части_ИдФайл[3]; // Грузотправитель
		O = Части_ИдФайл[2]; // Грузополучатель
		W = Части_ИдФайл[5]; // Признак наблюдателя
		
	КонецЕсли;
	
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	N = Строка(Новый УникальныйИдентификатор);
	
	ИдФайла = ПодставитьПараметрыВСтроку(Шаблон, R_Т, A, E, O, W, GGGGMMDD, N);
	
	Возврат ИдФайла;
	
КонецФункции

Функция ЭТрН_Титул_3_КонтентXDTO(ПараметрыФормирования) Экспорт
	
	ФорматДокумента = "__etrnTitle3_Receiver";
	
	Файл = Контракт_КонтентXml(ФорматДокумента);
	
	Файл.ВерсПрог = "DiadocLogist1C";
	Файл.ВерсФорм = "5.01";
	
	ДокументЭТрН_Титул2 = ПараметрыФормирования.ДокументЭТрН_Титул2;
	ХранилищеКонтента_Титул2 = ДокументЭТрН_Титул2.Документооборот.ХранилищеКонтента;
	
	ДанныеПодписи = Base64Строка(ХранилищеКонтента_Титул2.Подпись.ДанныеПодписи);
	ДанныеПодписи = СтрЗаменить(ДанныеПодписи, Символы.ПС, "");
	ДанныеПодписи = СтрЗаменить(ДанныеПодписи, Символы.ВК, "");
	
	КонтентXDTO_Титул2 = _Ядро.ГенерацияXML_XML_В_ОбъектXDTO(ХранилищеКонтента_Титул2.Данные);
	
	Файл.ИдФайл = ЭТрН_Титул_3_ИдФайл(КонтентXDTO_Титул2.ИдФайл);
	
	Файл.Документ.КНД = "1110341";
	Файл.Документ.ПоФактХЖ = "Транспортная накладная, информация грузополучателя о приеме груза";
	Файл.Документ.ДатИнфГП = Формат_ДатаДляXml(ТекущаяДатаСеанса());
	Файл.Документ.ВрИнфГП = Формат_ВремяДляXml(ТекущаяДатаСеанса());
	
	Файл.Документ.ИдИнфПрвПрием.ИдФайлИнфПрвПрием = КонтентXDTO_Титул2.ИдФайл;
	Файл.Документ.ИдИнфПрвПрием.ДатФайлПрвПрием = КонтентXDTO_Титул2.Документ.ДатИнфПрвПрием;
	Файл.Документ.ИдИнфПрвПрием.ВрФайлПрвПрием = КонтентXDTO_Титул2.Документ.ВрИнфПрвПрием;
	Файл.Документ.ИдИнфПрвПрием.ЭП = ДанныеПодписи;
	
	УИД_ТрН = XDTO_Вычислить(КонтентXDTO_Титул2, "Документ.СодИнфПрвПрием.УИД_ТрН");
	
	ЭТрН_Титул_3_Заполнить_СодИнфГП(Файл.Документ.СодИнфГП, ПараметрыФормирования, УИД_ТрН);
	
	BoxId = ДокументЭТрН_Титул2.Идентификаторы.BoxId;
	ТипКонтента = ДокументЭТрН_Титул2.Тип.ТипКонтента;
	
	ЭТрН_Титул_3_Заполнить_Подписант(Файл.Документ, BoxId, ТипКонтента);
	
	Возврат Файл;
	
КонецФункции

Процедура ЭТрН_Титул_3_Заполнить_СодИнфГП(СодИнфГП, ПараметрыФормирования, УИД_ТрН)
	
	ЗаполнитьXDTO_СПроверкой(СодИнфГП, "УИД_ТрН", УИД_ТрН);
	
	Если ПараметрыФормирования.ОтказВПриемке Тогда
		
		СодОпОтк = "Лицом, управомоченным на получение груза, при указанных обстоятельствах отказано в принятии от перевозчика груза с указанными характеристиками";
		
		ЗаполнитьXDTO_СПроверкой(СодИнфГП, "СодОпОтк", СодОпОтк);
		ЗаполнитьXDTO_СПроверкой(СодИнфГП, "ПричОтк", ПараметрыФормирования.ПричинаОтказа);
		
	Иначе
		
		Если ПараметрыФормирования.ПринятьЧастично Тогда
			СодОпПр = "Частичная выгрузка";
		Иначе
			СодОпПр = "Лицом, управомоченным на получение груза, при указанных обстоятельствах принят от перевозчика груз с указанными характеристиками";
		КонецЕсли;
		
		ЗаполнитьXDTO_СПроверкой(СодИнфГП, "СодОпПр", СодОпПр);
		
	КонецЕсли;
	
	XDTO_ИнфПол = НовыйЭлементСпискаXDTO(СодИнфГП.ИнфПол);
	
	Для Каждого СтрокаДопИнф Из ПараметрыФормирования.ДопИнформация Цикл
		ДобавитьТекстИнфXDTO(XDTO_ИнфПол.ТекстИнф, СтрокаДопИнф.Идентификатор, СтрокаДопИнф.Значение);
	КонецЦикла;
	
	ЭТрН_Титул_3_Заполнить_ПриемГрузГП(СодИнфГП.ПриемГрузГП, ПараметрыФормирования);
	
	ЭТрН_Титул_3_Заполнить_ОтметГП(СодИнфГП.ОтметГП, ПараметрыФормирования);
	
КонецПроцедуры

Процедура ЭТрН_Титул_3_Заполнить_ПриемГрузГП(ПриемГрузГП, ПараметрыФормирования)
	
	ДатаПрибытияПлан = Формат_ДатаВремяСоСмещениемUTCДляXml(ПараметрыФормирования.ДатаПрибытияПлан);
	ДатаПрибытияФакт = Формат_ДатаВремяСоСмещениемUTCДляXml(ПараметрыФормирования.ДатаПрибытияФакт);
	ДатаУбытияФакт = Формат_ДатаВремяСоСмещениемUTCДляXml(ПараметрыФормирования.ДатаУбытияФакт);
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "ЗаявДатВрПриб", ДатаПрибытияПлан);
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "НалКоорТочВрЗПр", "1");
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "ФДатВрПриб", ДатаПрибытияФакт);
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "НалКоорТочВрФПр", "1");
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "ФДатВрУбыт", ДатаУбытияФакт);
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "НалКоорТочВрФУб", "1");
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "МетОпрМасс", ПараметрыФормирования.МетодОпределенияМассы);
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "КолМестПриемЧ", ПараметрыФормирования.КоличествоМест);
	
	ОбщиеСведенияСостоянияГруза = ПараметрыФормирования.ОбщиеСведенияСостоянияГруза;
	
	Если НЕ ЗначениеЗаполнено(ОбщиеСведенияСостоянияГруза) Тогда 
		ОбщиеСведенияСостоянияГруза = "Без замечаний";
	КонецЕсли;
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "ОбщСвСост", ОбщиеСведенияСостоянияГруза);
	
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "МасБрутЗначПрием", ПараметрыФормирования.МассаБрутто);
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "МасНетЗначПрием", ПараметрыФормирования.МассаНетто);
	ЗаполнитьXDTO_СПроверкой(ПриемГрузГП, "Объем", ПараметрыФормирования.Объем);
	
	Если ПараметрыФормирования.ПринятьГрузПоПозициям Тогда
		ЭТрН_Титул_3_Заполнить_СвПринПоНаим(ПриемГрузГП.СвПринПоНаим, ПараметрыФормирования);
	КонецЕсли;
	
	ЭТрН_Титул_3_Заполнить_АдрВыгруз(ПриемГрузГП.АдрВыгруз, ПараметрыФормирования);
	
КонецПроцедуры

Процедура ЭТрН_Титул_3_Заполнить_СвПринПоНаим(СвПринПоНаим, ПараметрыФормирования)
	
	Для Каждого ТекГруз Из ПараметрыФормирования.Грузы Цикл
		
		XDTO_СвПринПоНаим = НовыйЭлементСпискаXDTO(СвПринПоНаим);
		
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим, "НаимГруз", ТекГруз.Наименование);
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим, "КолМест", ТекГруз.КоличествоМест);
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим, "СостГруз", ТекГруз.Состояние);
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим, "Объем", ТекГруз.Объем);
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим, "Плотн", ТекГруз.Плотность);
		
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим.МасГруз, "КолПалл", ТекГруз.КоличествоПаллет);
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим.МасГруз, "МасБрутЗнач", ТекГруз.МассаБрутто);
		ЗаполнитьXDTO_СПроверкой(XDTO_СвПринПоНаим.МасГруз, "МасНетЗнач", ТекГруз.МассаНетто);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЭТрН_Титул_3_Заполнить_ОтметГП(ОтметГП, ПараметрыФормирования)
	
	Для Каждого ТекОтметка Из ПараметрыФормирования.Отметки Цикл
		
		XDTO_ОтметГП = НовыйЭлементСпискаXDTO(ОтметГП);
		
		ДатаXML = ЭТрН_Титул_3_ДатаXML_МСК(ТекОтметка.Дата);
		
		ЗаполнитьXDTO_СПроверкой(XDTO_ОтметГП, "ДатВрОтмет", ДатаXML);
		ЗаполнитьXDTO_СПроверкой(XDTO_ОтметГП, "НалКоорТочВрОтм", "1");
		ЗаполнитьXDTO_СПроверкой(XDTO_ОтметГП, "ОбстОтмет", СокрЛП(ТекОтметка.Описание));
		
		Отбор = Новый Структура("ИдентификаторОтметки", ТекОтметка.ИдентификаторСтроки);
		
		// Акты по отметке
		АктыОтметки = ПараметрыФормирования.АктыОтметок.НайтиСтроки(Отбор);
		
		Для Каждого ТекАкт Из АктыОтметки Цикл
			
			Если ТекАкт.АктВзвешивания Тогда
				XDTO_СвАкт = НовыйЭлементСпискаXDTO(XDTO_ОтметГП.СвАктВзв);
			Иначе
				XDTO_СвАкт = НовыйЭлементСпискаXDTO(XDTO_ОтметГП.СвАкт);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекАкт.ИдентификаторФайла) Тогда
				
				ЗаполнитьXDTO_СПроверкой(XDTO_СвАкт, "ИдДок", ТекАкт.ИдентификаторФайла);
				
			Иначе
				
				ДатаАктаXML = Формат_ДатаДляXml(ТекАкт.Дата);
				НомерДокумента = ?(ЗначениеЗаполнено(ТекАкт.Номер), ТекАкт.Номер, "Без номера");
				
				ЗаполнитьXDTO_СПроверкой(XDTO_СвАкт, "ДатаДок", ДатаАктаXML);
				ЗаполнитьXDTO_СПроверкой(XDTO_СвАкт, "НомерДок", НомерДокумента);
				ЗаполнитьXDTO_СПроверкой(XDTO_СвАкт, "НаимДок", ТекАкт.Наименование);
				
			КонецЕсли;
			
			ЗаполнитьXDTO_СПроверкой(XDTO_СвАкт, "ДопСведДок", ТекАкт.ДопСведения);
			
			// Стороны-составители акта
			ОтборАкта = Новый Структура("ИдентификаторАкта", ТекАкт.ИдентификаторСтроки);
			СоставителиАкта = ПараметрыФормирования.СтороныСоставителиАктов.НайтиСтроки(ОтборАкта);
			
			Для Каждого ТекСоставительАкта Из СоставителиАкта Цикл
				
				XDTO_ИдРекСост = НовыйЭлементСпискаXDTO(XDTO_СвАкт.ИдРекСост);
				
				ИНН = СокрЛП(ТекСоставительАкта.ИНН);
				
				Если СтрДлина(ИНН) = 10 Тогда
					ЗаполнитьXDTO_СПроверкой(XDTO_ИдРекСост, "ИННЮЛ", ИНН);
				ИначеЕсли 
					СтрДлина(ИНН) = 12 Тогда
					ЗаполнитьXDTO_СПроверкой(XDTO_ИдРекСост, "ИННФЛ", ИНН);
				Иначе
					ЗаполнитьXDTO_СПроверкой(XDTO_ИдРекСост, "НаимОИВ", ТекСоставительАкта.ОрганИсполнительнойВласти);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		// Штрафы по отметке
		ШтрафыОтметки = ПараметрыФормирования.ШтрафыОтметок.НайтиСтроки(Отбор);
		
		Для Каждого ТекШтраф Из ШтрафыОтметки Цикл
			
			XDTO_РазмШтр = НовыйЭлементСпискаXDTO(XDTO_ОтметГП.РазмШтр);
			
			ЗаполнитьXDTO_СПроверкой(XDTO_РазмШтр, "ФактКолЕдИзм", ТекШтраф.База);
			ЗаполнитьXDTO_СПроверкой(XDTO_РазмШтр, "РасчШтр", ТекШтраф.Расчет);
			ЗаполнитьXDTO_СПроверкой(XDTO_РазмШтр, "ИтогРазмШтрРФ", ТекШтраф.Сумма);
			
		КонецЦикла;
		
		// Доп. информация по отметке
		ДопИнформацияОтметки = ПараметрыФормирования.ДопИнформацияОтметок.НайтиСтроки(Отбор);
		
		XDTO_ИнфПол = НовыйЭлементСпискаXDTO(XDTO_ОтметГП.ИнфПол);
		
		Для Каждого СтрокаДопИнф Из ДопИнформацияОтметки Цикл
			ДобавитьТекстИнфXDTO(XDTO_ИнфПол.ТекстИнф, СтрокаДопИнф.Идентификатор, СтрокаДопИнф.Значение);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЭТрН_Титул_3_Заполнить_АдрВыгруз(АдрВыгруз, ПараметрыФормирования)
	
	АдресВыгрузки = ПараметрыФормирования.АдресВыгрузки;
	
	ЭтоАдресИзЭТрН_Титул1 = _Ядро.СвойствоСтруктуры(АдресВыгрузки, "ЭтоАдресИзЭТрН_Титул1", Ложь);
	
	Если ЭтоАдресИзЭТрН_Титул1 Тогда
		
		АдресДостГр_Титул1 = ЭТрН_Титул_3_АдресДоставкиТитулаОснования(ПараметрыФормирования.ДокументЭТрН_Титул1);
		XDTO_СкопироватьДанныеИзОбъектаXDTO(АдрВыгруз, АдресДостГр_Титул1);
		
	Иначе
		
		Адрес = _Ядро.СвойствоСтруктуры(АдресВыгрузки, "Адрес");
		АдресРФ = _Ядро.СвойствоСтруктуры(АдресВыгрузки, "АдресРФ");
		КодСтраны = _Ядро.СвойствоСтруктуры(АдресВыгрузки, "АдресКодСтраны");
		
		Если ЗначениеЗаполнено(Адрес) Тогда
			ЗаполнитьXDTO_АдресДоставки(АдрВыгруз, Адрес, АдресРФ, КодСтраны);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭТрН_Титул_3_Заполнить_Подписант(ДокументXDTO, BoxId, ТипКонтента)
	
	ДанныеПодписанта = _Ядро.ПолномочияПодписанта_Покупателя(BoxId, ТипКонтента);
	ОписаниеПодписанта = ДанныеПодписанта.ОписаниеПодписанта;
	
	Если ЗначениеЗаполнено(ОписаниеПодписанта) Тогда
		
		ДокументXDTO.НаимЭконСубСост = ОписаниеПодписанта.НаименованиеОрганизации;
		
		Подписант = ДокументXDTO.Подписант;
		ФИО = Подписант.ФИО;
		
		ЗаполнитьXDTO_СПроверкой(ФИО, "Фамилия", ОписаниеПодписанта.Фамилия);
		ЗаполнитьXDTO_СПроверкой(ФИО, "Имя", ОписаниеПодписанта.Имя);
		ЗаполнитьXDTO_СПроверкой(ФИО, "Отчество", ОписаниеПодписанта.Отчество);
		
		ЗаполнитьXDTO_СПроверкой(Подписант, "Должн", ОписаниеПодписанта.Должность);
		ЗаполнитьXDTO_СПроверкой(Подписант, "СтатПодп", 1);
		
	КонецЕсли;

КонецПроцедуры

Функция ЭТрН_Титул_3_ПакетДляОтправки(ПараметрыФормирования) Экспорт
	
	Результат = _Ядро.Контракт_Пакет();
	
	ДокументЭТрН_Титул2 = ПараметрыФормирования.ДокументЭТрН_Титул2;
	
	Результат.Направление = _Ядро.Перечисление_Направления().Исходящее;
	Результат.Состояние = _Ядро.Перечисление_СтатусыПакетов().Подготовлен;
	Результат.Идентификаторы.BoxId = ДокументЭТрН_Титул2.Идентификаторы.BoxId;
	Результат.Отправитель = ДокументЭТрН_Титул2.Получатель;
	Результат.Получатель = ДокументЭТрН_Титул2.Отправитель;
	Результат.Реквизиты.Дата = ДокументЭТрН_Титул2.Реквизиты.Дата;
	Результат.Реквизиты.Номер = ДокументЭТрН_Титул2.Реквизиты.Номер;
	Результат.СлужебнаяИнформация.Вставить("ПараметрыОтправки", _Ядро.Контракт_ПараметрыОтправкиПакета());
	
	ТипДокумента = ДокументЭТрН_Титул2.Тип.ТипДокумента;
	ТипКонтента = "kl";
	ФункцияДокумента = "delivery";
	
	ДокументЭТрН_Титул3 = _Ядро.Пакеты_НовыйДокумент(Результат, ТипДокумента, ТипКонтента, ФункцияДокумента);
	ДокументЭТрН_Титул3.ИдентификаторВида = Результат.ИдентификаторВида;
	ДокументЭТрН_Титул3.СлужебнаяИнформация.ПараметрыОтправки.ЗапрашиватьОтветнуюПодпись = Истина;
	
	КонтентXDTO = ЭТрН_Титул_3_КонтентXDTO(ПараметрыФормирования);
	КонтентXML = ТекстКонтентаXML(КонтентXDTO);
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXml = Новый ЗаписьXML;
	ЗаписьXml.ОткрытьФайл(ИмяВремФайла, "windows-1251");
	ЗаписьXml.ЗаписатьБезОбработки(КонтентXML);
	ЗаписьXml.Закрыть();
	
	ДокументЭТрН_Титул3.Документооборот.ХранилищеКонтента.Данные = Новый ДвоичныеДанные(ИмяВремФайла);
	УдалитьФайлы(ИмяВремФайла);
	
	Результат.Документы.Добавить(ДокументЭТрН_Титул3);
	
	Возврат Результат;
	
КонецФункции

Функция ЭТрН_Титул_3_ОшибкиВалидацииДанных(ПараметрыФормирования) Экспорт
	
	Результат = Новый Массив;
	
	Если ПараметрыФормирования.ОтказВПриемке Тогда
		ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "ПричинаОтказа");
	КонецЕсли;
	
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "АдресВыгрузки");
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "ОбщиеСведенияСостоянияГруза");
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "ДатаПрибытияПлан");
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "ДатаПрибытияФакт");
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "ДатаУбытияФакт");
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "КоличествоМест");
	ЭТрН_Титул_3_ЗаполненностьРеквизита(Результат, ПараметрыФормирования, "МассаБрутто");
	
	ЭТрН_Титул_3_ВалидацияТЧ_Грузы(Результат, ПараметрыФормирования);
	ЭТрН_Титул_3_ВалидацияТЧ_ДопИнформация(Результат, ПараметрыФормирования);
	
	ЭТрН_Титул_3_ВалидацияТЧ_Отметки(Результат, ПараметрыФормирования);
	ЭТрН_Титул_3_ВалидацияТЧ_АктыОтметок(Результат, ПараметрыФормирования);
	ЭТрН_Титул_3_ВалидацияТЧ_ДопИнформацияОтметок(Результат, ПараметрыФормирования);
	
	ЭТрН_Титул_3_ВалидацияТЧ_СтороныСоставителиАктов(Результат, ПараметрыФормирования);
	
	Возврат Результат;
	
КонецФункции

Функция ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, Данные, ИмяРеквизита, ИмяТабЧасти = "", НомерСтроки = Неопределено)
	
	РеквизитЗаполнен = ЗначениеЗаполнено(Данные[ИмяРеквизита]);
	
	Если НЕ РеквизитЗаполнен Тогда
		
		Результат = Контракт_ОписаниеОшибкиДанных();
		
		Результат.ИмяРеквизита = ИмяРеквизита;
		Результат.ИмяТабЧасти = ИмяТабЧасти;
		Результат.НомерСтроки = НомерСтроки;
		
		ИдентификаторыВладельца = Новый Структура("ИдентификаторОтметки, ИдентификаторАкта");
		ЗаполнитьЗначенияСвойств(ИдентификаторыВладельца, Данные);
		ЗаполнитьЗначенияСвойств(Результат, ИдентификаторыВладельца);
		
		Ошибки.Добавить(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭТрН_Титул_3_ВалидацияТЧ_Грузы(Ошибки, ПараметрыФормирования)
	
	ИмяТабЧасти = "Грузы";
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЗ Из ПараметрыФормирования[ИмяТабЧасти] Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "Наименование", ИмяТабЧасти, НомерСтроки);
		ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "Состояние", ИмяТабЧасти, НомерСтроки);
		ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "КоличествоМест", ИмяТабЧасти, НомерСтроки);
		ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "МассаБрутто", ИмяТабЧасти, НомерСтроки);
		
	КонецЦикла;
	
КонецФункции

Функция ЭТрН_Титул_3_ВалидацияТЧ_Отметки(Ошибки, ПараметрыФормирования)
	
	ИмяТабЧасти = "Отметки";
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЗ Из ПараметрыФормирования[ИмяТабЧасти] Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "Дата", ИмяТабЧасти, НомерСтроки);
		ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "Описание", ИмяТабЧасти, НомерСтроки);
		
	КонецЦикла;
	
КонецФункции

Функция ЭТрН_Титул_3_ВалидацияТЧ_АктыОтметок(Ошибки, ПараметрыФормирования)
	
	ИмяТабЧасти = "АктыОтметок";
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЗ Из ПараметрыФормирования[ИмяТабЧасти] Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ИдентификаторФайла) Тогда
			
			ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "Наименование", ИмяТабЧасти, НомерСтроки);
			ОписаниеОшибки = ЭТрН_Титул_3_ЗаполненностьРеквизита(Ошибки, СтрокаТЗ, "Дата", ИмяТабЧасти, НомерСтроки);
			
		КонецЕсли;
		
		ОтборСтрок = Новый Структура("ИдентификаторАкта", СтрокаТЗ.ИдентификаторСтроки);
