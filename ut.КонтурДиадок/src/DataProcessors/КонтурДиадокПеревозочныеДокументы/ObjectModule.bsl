// Получает данные о перевозочных тилулах
//
// Параметры:
//  Параметры	 - 	Структура - Содержит параметры для выборки титулов
// 
// Возвращаемое значение:
//   - Массив 
//
Функция ДанныеДляОтправкиТитуловЭТрН(Параметры) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	// TODO получать КОРРЕКТНЫЕ данные без НЕЯВНОГО соединения с таблицами:
	// текущий Статус титула (Черновик, Подготовлен, Отправлен)
	// ВидПакетаID (отдельные методы для ID_Перевозочные_ЭТрН и ID_Перевозочные_ЗаказЗаявка)
	// ГО, ПВ, ГП
	
	// выбирается основной документ, либо первый
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СведенияОсновнойДокумент.Значение, ДополнительныеСведения.Объект) КАК Документ,
	|	ДополнительныеСведения.Значение КАК ИдентификаторДокумента,
	|	СведенияНомер.Значение КАК НомерДокумента,
	|	ЕстьNull(СведенияДата.Значение, &ТекущаяДата) КАК ДатаДокумента,
	|	СведенияОрганизация.Значение КАК Организация,
	|	СведенияГрузоотправитель.Значение КАК Грузоотправитель,
	|	СведенияКонтрагент.Значение КАК Контрагент,
	|	СведенияГрузополучатель.Значение КАК Грузополучатель,
	|	СведенияПеревозчик.Значение КАК Перевозчик,
	|	ЕСТЬNULL(СведенияСумма.Значение, 0) КАК СуммаДокумента,
	|	ЕСТЬNULL(СведенияСтатус.Значение, ""Черновик"") КАК Статус,
	|	&ВидПакетаID КАК ВидПакетаID
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОсновнойДокумент
	|		ПО ДополнительныеСведения.Значение = СведенияОсновнойДокумент.Объект
	|			И (СведенияОсновнойДокумент.Свойство = &Свойство_ОсновнойДокумент)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияНомер
	|		ПО ДополнительныеСведения.Значение = СведенияНомер.Объект
	|			И (СведенияНомер.Свойство = &Свойство_Номер)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияДата
	|		ПО ДополнительныеСведения.Значение = СведенияДата.Объект
	|			И (СведенияДата.Свойство = &Свойство_Дата)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОрганизация
	|		ПО ДополнительныеСведения.Значение = СведенияОрганизация.Объект
	|			И (СведенияОрганизация.Свойство = &Свойство_Организация)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузоотправитель
	|		ПО ДополнительныеСведения.Значение = СведенияГрузоотправитель.Объект
	|			И (СведенияГрузоотправитель.Свойство = &Свойство_Грузоотправитель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияКонтрагент
	|		ПО ДополнительныеСведения.Значение = СведенияКонтрагент.Объект
	|			И (СведенияКонтрагент.Свойство = &Свойство_Контрагент)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузополучатель
	|		ПО ДополнительныеСведения.Значение = СведенияГрузополучатель.Объект
	|			И (СведенияГрузополучатель.Свойство = &Свойство_Грузополучатель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПеревозчик
	|		ПО ДополнительныеСведения.Значение = СведенияПеревозчик.Объект
	|			И (СведенияПеревозчик.Свойство = &Свойство_Перевозчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСумма
	|		ПО ДополнительныеСведения.Значение = СведенияСумма.Объект
	|			И (СведенияСумма.Свойство = &Свойство_Сумма)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСтатус
	|		ПО ДополнительныеСведения.Значение = СведенияСтатус.Объект
	|			И (СведенияСтатус.Свойство = &Свойство_Статус)

	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство_ИдентификаторТрН";
	
	Если Параметры.Свойство(КлючИдентификатораТрН()) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДополнительныеСведения.Значение = &ИдентификаторТрН";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И ЕстьNull(СведенияДата.Значение, &ТекущаяДата) МЕЖДУ &НачалоПериода И &КонецПериода";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПакетаID", """" + ИдентификаторПакетаЭТрН() + """");
	НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + НазваниеРегистраДополнительныеСвойства);
	
	// TODO Сделать отдельные обертки для каждого свойства
	Свойство_ИдентификаторТрН = ПолучитьСведениеПоИмени(КлючИдентификатораТрН());
 	Свойство_ОсновнойДокумент = ПолучитьСведениеПоИмени("ОсновнойДокумент");
	Свойство_Номер = ПолучитьСведениеПоИмени("Номер");
	Свойство_Дата = ПолучитьСведениеПоИмени("Дата");
	Свойство_Организация = ПолучитьСведениеПоИмени("Организация");
	Свойство_Грузоотправитель = ПолучитьСведениеПоИмени("Грузоотправитель");
	Свойство_Контрагент = ПолучитьСведениеПоИмени("Контрагент");
	Свойство_Грузополучатель = ПолучитьСведениеПоИмени("Грузополучатель");
	Свойство_Перевозчик = ПолучитьСведениеПоИмени("Перевозчик");
	Свойство_Сумма = ПолучитьСведениеПоИмени("Сумма");
	Свойство_Статус = ПолучитьСведениеПоИмени("Статус");
	
	Запрос.Параметры.Вставить("Свойство_ИдентификаторТрН", Свойство_ИдентификаторТрН);
	Запрос.Параметры.Вставить("Свойство_ОсновнойДокумент", Свойство_ОсновнойДокумент);
 	Запрос.Параметры.Вставить("Свойство_Номер", Свойство_Номер);
	Запрос.Параметры.Вставить("Свойство_Дата", Свойство_Дата);
 	Запрос.Параметры.Вставить("Свойство_Организация", Свойство_Организация);
	Запрос.Параметры.Вставить("Свойство_Контрагент", Свойство_Контрагент);
	Запрос.Параметры.Вставить("Свойство_Грузоотправитель", Свойство_Грузоотправитель);
	Запрос.Параметры.Вставить("Свойство_Грузополучатель", Свойство_Грузополучатель);
	Запрос.Параметры.Вставить("Свойство_Перевозчик", Свойство_Перевозчик);
	Запрос.Параметры.Вставить("Свойство_Сумма", Свойство_Сумма);
	Запрос.Параметры.Вставить("Свойство_Статус", Свойство_Статус);
	Запрос.Параметры.Вставить("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	//Параметры.РежимОтбораПоПериоду = "ПоДатеОтправкиИлиПолучения"
	Запрос.Параметры.Вставить("НачалоПериода", Параметры.НачалоПериода);
	Запрос.Параметры.Вставить("КонецПериода", Параметры.КонецПериода);
	
	Если Параметры.Свойство(КлючИдентификатораТрН()) Тогда
		Запрос.Параметры.Вставить(КлючИдентификатораТрН(), Параметры.ИдентификаторТрН);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеПеревозочногоДокумента = Контракт_ДанныеПеревозочныхДокументов();
		ЗаполнитьЗначенияСвойств(ДанныеПеревозочногоДокумента, Выборка);
		
		ДокументXML = ПолучитьЗначениеСведения(Выборка.ИдентификаторДокумента, "ОсновнойДокумент", Истина);
		Если ТипЗнч(ДокументXML) = Тип("Строка") Тогда
			ДанныеПеревозочногоДокумента.Документ = ДесериализоватьXML(ДокументXML);
		КонецЕсли;
		
		Если ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Строка")
			Или ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Структура") Тогда
			ДанныеПеревозочногоДокумента.Документ = Выборка.ИдентификаторДокумента;
		КонецЕсли;
		
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Организация");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузоотправитель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузополучатель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Перевозчик");

		Результат.Вставить(ДанныеПеревозочногоДокумента.Документ, ДанныеПеревозочногоДокумента);
		
	КонецЦикла;

	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, ИмяПоля)
	Если ТипЗнч(Выборка[ИмяПоля]) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		ДанныеXML = ПолучитьЗначениеСведения(Выборка.ИдентификаторДокумента, ИмяПоля, Истина);
		ДанныеСсылка = ДесериализоватьXML(ДанныеXML);
		Если Не ТипЗнч(ДанныеСсылка) = Тип("Строка")
			И Не ТипЗнч(ДанныеСсылка) = Тип("Структура") Тогда
			ДанныеПеревозочногоДокумента[ИмяПоля] = ДанныеСсылка;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ДанныеДляОтправкиТитуловЗаказЗаявка(Параметры) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	// TODO получать КОРРЕКТНЫЕ данные без НЕЯВНОГО соединения с таблицами:
	// текущий Статус титула (Черновик, Подготовлен, Отправлен)
	// ВидПакетаID (отдельные методы для ID_Перевозочные_ЭТрН и ID_Перевозочные_ЗаказЗаявка)
	// ГО, ПВ, ГП
	
	// выбирается основной документ, либо первый
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СведенияОсновнойДокумент.Значение, ДополнительныеСведения.Объект) КАК Документ,
	|	ДополнительныеСведения.Значение КАК ИдентификаторДокумента,
	|	СведенияНомер.Значение КАК НомерДокумента,
	|	ЕстьNull(СведенияДата.Значение, &ТекущаяДата) КАК ДатаДокумента,
	|	СведенияОрганизация.Значение КАК Организация,
	|	СведенияГрузоотправитель.Значение КАК Грузоотправитель,
	|	СведенияКонтрагент.Значение КАК Контрагент,
	|	СведенияГрузополучатель.Значение КАК Грузополучатель,
	|	СведенияПеревозчик.Значение КАК Перевозчик,
	|	ЕСТЬNULL(СведенияСумма.Значение, 0) КАК СуммаДокумента,
	|	ЕСТЬNULL(СведенияСтатус.Значение, ""Черновик"") КАК Статус,
	|	&ВидПакетаID КАК ВидПакетаID
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОсновнойДокумент
	|		ПО ДополнительныеСведения.Значение = СведенияОсновнойДокумент.Объект
	|			И (СведенияОсновнойДокумент.Свойство = &Свойство_ОсновнойДокумент)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияНомер
	|		ПО ДополнительныеСведения.Значение = СведенияНомер.Объект
	|			И (СведенияНомер.Свойство = &Свойство_Номер)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияДата
	|		ПО ДополнительныеСведения.Значение = СведенияДата.Объект
	|			И (СведенияДата.Свойство = &Свойство_Дата)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОрганизация
	|		ПО ДополнительныеСведения.Значение = СведенияОрганизация.Объект
	|			И (СведенияОрганизация.Свойство = &Свойство_Организация)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузоотправитель
	|		ПО ДополнительныеСведения.Значение = СведенияГрузоотправитель.Объект
	|			И (СведенияГрузоотправитель.Свойство = &Свойство_Грузоотправитель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияКонтрагент
	|		ПО ДополнительныеСведения.Значение = СведенияКонтрагент.Объект
	|			И (СведенияКонтрагент.Свойство = &Свойство_Контрагент)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузополучатель
	|		ПО ДополнительныеСведения.Значение = СведенияГрузополучатель.Объект
	|			И (СведенияГрузополучатель.Свойство = &Свойство_Грузополучатель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПеревозчик
	|		ПО ДополнительныеСведения.Значение = СведенияПеревозчик.Объект
	|			И (СведенияПеревозчик.Свойство = &Свойство_Перевозчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСумма
	|		ПО ДополнительныеСведения.Значение = СведенияСумма.Объект
	|			И (СведенияСумма.Свойство = &Свойство_Сумма)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСтатус
	|		ПО ДополнительныеСведения.Значение = СведенияСтатус.Объект
	|			И (СведенияСтатус.Свойство = &Свойство_Статус)

	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство_ИдентификаторЗЗ";
	
	Если Параметры.Свойство(КлючИдентификатораЗЗ()) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДополнительныеСведения.Значение = &ИдентификаторЗЗ";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И ЕстьNull(СведенияДата.Значение, &ТекущаяДата) МЕЖДУ &НачалоПериода И &КонецПериода";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПакетаID", """" + ИдентификаторПакетаЗаказЗаявка() + """");
	НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + НазваниеРегистраДополнительныеСвойства);
	
	// TODO Сделать отдельные обертки для каждого свойства
	Свойство_ИдентификаторЗЗ = ПолучитьСведениеПоИмени(КлючИдентификатораЗЗ());
 	Свойство_ОсновнойДокумент = ПолучитьСведениеПоИмени("ОсновнойДокумент");
	Свойство_Номер = ПолучитьСведениеПоИмени("Номер");
	Свойство_Дата = ПолучитьСведениеПоИмени("Дата");
	Свойство_Организация = ПолучитьСведениеПоИмени("Организация");
	Свойство_Грузоотправитель = ПолучитьСведениеПоИмени("Грузоотправитель");
	Свойство_Контрагент = ПолучитьСведениеПоИмени("Контрагент");
	Свойство_Грузополучатель = ПолучитьСведениеПоИмени("Грузополучатель");
	Свойство_Перевозчик = ПолучитьСведениеПоИмени("Перевозчик");
	Свойство_Сумма = ПолучитьСведениеПоИмени("Сумма");
	Свойство_Статус = ПолучитьСведениеПоИмени("Статус");
	
	Запрос.Параметры.Вставить("Свойство_ИдентификаторЗЗ", Свойство_ИдентификаторЗЗ);
	Запрос.Параметры.Вставить("Свойство_ОсновнойДокумент", Свойство_ОсновнойДокумент);
 	Запрос.Параметры.Вставить("Свойство_Номер", Свойство_Номер);
	Запрос.Параметры.Вставить("Свойство_Дата", Свойство_Дата);
 	Запрос.Параметры.Вставить("Свойство_Организация", Свойство_Организация);
	Запрос.Параметры.Вставить("Свойство_Контрагент", Свойство_Контрагент);
	Запрос.Параметры.Вставить("Свойство_Грузоотправитель", Свойство_Грузоотправитель);
	Запрос.Параметры.Вставить("Свойство_Грузополучатель", Свойство_Грузополучатель);
	Запрос.Параметры.Вставить("Свойство_Перевозчик", Свойство_Перевозчик);
	Запрос.Параметры.Вставить("Свойство_Сумма", Свойство_Сумма);
	Запрос.Параметры.Вставить("Свойство_Статус", Свойство_Статус);
	Запрос.Параметры.Вставить("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	//Параметры.РежимОтбораПоПериоду = "ПоДатеОтправкиИлиПолучения"
	Запрос.Параметры.Вставить("НачалоПериода", Параметры.НачалоПериода);
	Запрос.Параметры.Вставить("КонецПериода", Параметры.КонецПериода);
	
	Если Параметры.Свойство(КлючИдентификатораЗЗ()) Тогда
		Запрос.Параметры.Вставить(КлючИдентификатораЗЗ(), Параметры.ИдентификаторЗЗ);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеПеревозочногоДокумента = Контракт_ДанныеПеревозочныхДокументов();
		ЗаполнитьЗначенияСвойств(ДанныеПеревозочногоДокумента, Выборка);
		ДанныеПеревозочногоДокумента.Грузополучатель = Неопределено;
		
		ДокументXML = ПолучитьЗначениеСведения(Выборка.ИдентификаторДокумента, "ОсновнойДокумент", Истина);

		Если ТипЗнч(ДокументXML) = Тип("Строка") Тогда
			ДанныеПеревозочногоДокумента.Документ = ДесериализоватьXML(ДокументXML);
		КонецЕсли;
		
		Если ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Строка")
			Или ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Структура") Тогда
			ДанныеПеревозочногоДокумента.Документ = Выборка.ИдентификаторДокумента;
		КонецЕсли;

		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Организация");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузоотправитель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузополучатель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Перевозчик");
		
		Результат.Вставить(ДанныеПеревозочногоДокумента.Документ, ДанныеПеревозочногоДокумента);
		
	КонецЦикла;

	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляОтправкиТитуловЭПЭ(Параметры) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	// TODO получать КОРРЕКТНЫЕ данные без НЕЯВНОГО соединения с таблицами:
	// текущий Статус титула (Черновик, Подготовлен, Отправлен)
	// ВидПакетаID (отдельные методы для ID_Перевозочные_ЭПЭ и ID_Перевозочные_ЗаказЗаявка)
	// ГО, ПВ, ГП
	
	// выбирается основной документ, либо первый
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СведенияОсновнойДокумент.Значение, ДополнительныеСведения.Объект) КАК Документ,
	|	ДополнительныеСведения.Значение КАК ИдентификаторДокумента,
	|	СведенияНомер.Значение КАК НомерДокумента,
	|	ЕстьNull(СведенияДата.Значение, &ТекущаяДата) КАК ДатаДокумента,
	|	СведенияОрганизация.Значение КАК Организация,
	|	СведенияГрузоотправитель.Значение КАК Грузоотправитель,
	|	СведенияКонтрагент.Значение КАК Контрагент,
	|	СведенияГрузополучатель.Значение КАК Грузополучатель,
	|	СведенияПеревозчик.Значение КАК Перевозчик,
	|	ЕСТЬNULL(СведенияСумма.Значение, 0) КАК СуммаДокумента,
	|	ЕСТЬNULL(СведенияСтатус.Значение, ""Черновик"") КАК Статус,
	|	&ВидПакетаID КАК ВидПакетаID
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОсновнойДокумент
	|		ПО ДополнительныеСведения.Значение = СведенияОсновнойДокумент.Объект
	|			И (СведенияОсновнойДокумент.Свойство = &Свойство_ОсновнойДокумент)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияНомер
	|		ПО ДополнительныеСведения.Значение = СведенияНомер.Объект
	|			И (СведенияНомер.Свойство = &Свойство_Номер)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияДата
	|		ПО ДополнительныеСведения.Значение = СведенияДата.Объект
	|			И (СведенияДата.Свойство = &Свойство_Дата)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОрганизация
	|		ПО ДополнительныеСведения.Значение = СведенияОрганизация.Объект
	|			И (СведенияОрганизация.Свойство = &Свойство_Организация)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузоотправитель
	|		ПО ДополнительныеСведения.Значение = СведенияГрузоотправитель.Объект
	|			И (СведенияГрузоотправитель.Свойство = &Свойство_Грузоотправитель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияКонтрагент
	|		ПО ДополнительныеСведения.Значение = СведенияКонтрагент.Объект
	|			И (СведенияКонтрагент.Свойство = &Свойство_Контрагент)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузополучатель
	|		ПО ДополнительныеСведения.Значение = СведенияГрузополучатель.Объект
	|			И (СведенияГрузополучатель.Свойство = &Свойство_Грузополучатель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПеревозчик
	|		ПО ДополнительныеСведения.Значение = СведенияПеревозчик.Объект
	|			И (СведенияПеревозчик.Свойство = &Свойство_Перевозчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСумма
	|		ПО ДополнительныеСведения.Значение = СведенияСумма.Объект
	|			И (СведенияСумма.Свойство = &Свойство_Сумма)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСтатус
	|		ПО ДополнительныеСведения.Значение = СведенияСтатус.Объект
	|			И (СведенияСтатус.Свойство = &Свойство_Статус)

	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство_ИдентификаторПЭ";
	
	Если Параметры.Свойство(КлючИдентификатораПЭ()) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДополнительныеСведения.Значение = &ИдентификаторПЭ";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И ЕстьNull(СведенияДата.Значение, &ТекущаяДата) МЕЖДУ &НачалоПериода И &КонецПериода";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПакетаID", """" + ИдентификаторПакетаЭПЭ() + """");
	НазваниеРегистраДополнительныеСвойства = НазваниеРегистраДополнительныеСвойства();	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + НазваниеРегистраДополнительныеСвойства);
	
	// TODO Сделать отдельные обертки для каждого свойства
	Свойство_ИдентификаторПЭ = ПолучитьСведениеПоИмени(КлючИдентификатораПЭ());
 	Свойство_ОсновнойДокумент = ПолучитьСведениеПоИмени("ОсновнойДокумент");
