Процедура ПараметрыВалидацииТС(Результат, Префикс) Экспорт
	
	ИмяФормы = "ФормаТранспортногоСредства";
	
	Если Префикс = "СвТС.Прицеп" Тогда
		ДопИнфо = "прицепа";
		РеквизитНаФорме = "рл_СвТС_Прицеп";
	ИначеЕсли Префикс = "СвТС.ТС" Тогда
		ДопИнфо = "транспортного средства";
		РеквизитНаФорме = "рл_СвТС_ТС";
	Иначе
		ДопИнфо = "";
		РеквизитНаФорме = "";
