		УсловияИстины.Добавить(УсловиеИстины);
                                                                  
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИнфУпГруз.ВидУпак", Ложь, "Вид упаковки", , ИмяРеквизитаТЧ);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИнфУпГруз.ВесУпак", УсловияИстины, "Вес упаковки", , ИмяРеквизитаТЧ, , Ложь);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИнфУпГруз.ГабарУпак.ВысЗнач", УсловияИстины, "Высота груза", , ИмяРеквизитаТЧ, , Ложь);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИнфУпГруз.ГабарУпак.ДлЗнач", УсловияИстины, "Длина груза", , ИмяРеквизитаТЧ, , Ложь);
		ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИнфУпГруз.ГабарУпак.ШирЗнач", УсловияИстины, "Ширина груза", , ИмяРеквизитаТЧ, , Ложь);
