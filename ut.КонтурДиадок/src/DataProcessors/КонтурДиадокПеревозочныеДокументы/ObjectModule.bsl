Функция ЭТрН_Титул_3_ВалидацияТЧ_СтороныСоставителиАктов(Ошибки, ПараметрыФормирования)
	
	ИмяТабЧасти = "СтороныСоставителиАктов";
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЗ Из ПараметрыФормирования[ИмяТабЧасти] Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ОрганИсполнительнойВласти)
			И НЕ ЗначениеЗаполнено(СтрокаТЗ.ИНН) Тогда
			
			Результат = Контракт_ОписаниеОшибкиДанных();
			
			Результат.ИмяРеквизита = "ИНН";
			Результат.ИмяТабЧасти = ИмяТабЧасти;
			Результат.НомерСтроки = НомерСтроки;
			Результат.ИдентификаторАкта = СтрокаТЗ.ИдентификаторАкта;
			Результат.ТекстОшибки = "Заполните одно из полей стороны-составителя акта: ""Орган исполнительной власти"" или ""ИНН (для юр. или физ. лиц)""";
			
			Ошибки.Добавить(Результат);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.ОрганИсполнительнойВласти)
			И ЗначениеЗаполнено(СтрокаТЗ.ИНН) Тогда
			
			Результат = Контракт_ОписаниеОшибкиДанных();
			
			Результат.ИмяРеквизита = "ИНН";
			Результат.ИмяТабЧасти = ИмяТабЧасти;
			Результат.НомерСтроки = НомерСтроки;
			Результат.ИдентификаторАкта = СтрокаТЗ.ИдентификаторАкта;
			Результат.ТекстОшибки = "Заполните только одно из полей стороны-составителя акта: ""Орган исполнительной власти"" или ""ИНН (для юр. или физ. лиц)""";
			
			Ошибки.Добавить(Результат);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.ИНН) Тогда
			
			ИНН = СокрЛП(СтрокаТЗ.ИНН);
			ТекстСообщения = "Проверьте ИНН стороны-составителя акта: ";
			ЭтоЮрЛицо = (СтрДлина(ИНН) <> 12);
			
			ЗначениеКорректно = ИННСоответствуетТребованиямЛок(ИНН, ЭтоЮрЛицо, ТекстСообщения);
			
			Если НЕ ЗначениеКорректно Тогда
				
				Результат = Контракт_ОписаниеОшибкиДанных();
				
				Результат.ИмяРеквизита = "ИНН";
				Результат.ИмяТабЧасти = ИмяТабЧасти;
				Результат.НомерСтроки = НомерСтроки;
				Результат.ИдентификаторАкта = СтрокаТЗ.ИдентификаторАкта;
				Результат.ТекстОшибки = ТекстСообщения;
				
				Ошибки.Добавить(Результат);
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецФункции

