  		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НалУпак", "0");
		
		Если ЕстьИЗаполненоСвойствоСтруктуры(ДанныеГруза, "ИнфУпГруз.ВидУпак") Тогда 
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НалУпак", "1");
			
			ВидУпак = ДанныеГруза.ИнфУпГруз.ВидУпак;
			СписокВыбораВидУпаковки = СписокВыбораВидУпаковки();
			КодВидУпак = СписокВыбораВидУпаковки[ВидУпак];
			Если КодВидУпак <> Неопределено Тогда 
				
				ЭлементXDTO_ИнфУпГруз = НовыйЭлементСпискаXDTO(ЭлементXDTO.ИнфУпГруз);

				ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_ИнфУпГруз, "ВидУпак", КодВидУпак);
				
				ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_ИнфУпГруз, "ВесУпак", ДанныеГруза, "ИнфУпГруз.ВесУпак");
				ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_ИнфУпГруз, "КолУп", ДанныеГруза, "ИнфУпГруз.КолУп");
				ЗаполнитьXDTO_Габар(ЭлементXDTO_ИнфУпГруз.ГабарУпак, ДанныеГруза.ИнфУпГруз.ГабарУпак);
			КонецЕсли;
		КонецЕсли;
		
		//ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СпУпак", ДанныеГруза, "СпУпак");
		//ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ВидТар", ДанныеГруза, "ВидТар", "00");
		//
		//ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ДрОГруз", ДанныеГруза, "ДрОГруз");
		//
		//Если XDTO_ЕстьСвойство(ЭлементXDTO, "Габар") Тогда
		//	ЗаполнитьXDTO_Габар(ЭлементXDTO.Габар, ДанныеГруза.Габар);
		//ИначеЕсли XDTO_ЕстьСвойство(ЭлементXDTO, "РазмерГрМест") Тогда
		//	ЗаполнитьXDTO_Габар(ЭлементXDTO.РазмерГрМест, ДанныеГруза.РазмерГрМест);
		//КонецЕсли;
		//
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "Марк") Тогда
			ЗаполнитьСписокXDTO_Марк(ЭлементXDTO.Марк, ДанныеГруза);
		КонецЕсли;
		
		ЗаполнитьXDTO_Страна_ПЭ(ЭлементXDTO.СвСтрПроисх, ДанныеГруза);
		ЗаполнитьXDTO_Вес_ПЭ(ЭлементXDTO.ВесГруз, ДанныеГруза.ВесГруз);
		
		ЗаполнитьXDTO_СтГруз_ПЭ(ЭлементXDTO.ОбъявлСтГруз, ДанныеГруза.ОбъявлСтГруз);
		
				
		//Если XDTO_ЕстьСвойство(ЭлементXDTO, "СвКонтейн") Тогда
		//	ЗаполнитьСписокXDTO_СвКонтейн(ЭлементXDTO.СвКонтейн, ДанныеГруза);
		//КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры


Процедура ЗаполнитьСписокXDTO_ОпГруз(СписокXDTO, ОпГруз, ЭПД)
	
	//todo: привести к нормализации xdto
	Для Каждого ДанныеГруза Из ОпГруз Цикл 
		
		ЭлементXDTO = НовыйЭлементСпискаXDTO(СписокXDTO);
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НаимГруз", XDTO_СтрокаПоСсылке(ДанныеГруза.Номенклатура)); 
		Если ДанныеГруза.Свойство("КодТовНом") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КодТовНом", XDTO_ОграничениеСтроки(XDTO_СтрокаПоСсылке(ДанныеГруза.КодТовНом), 4));
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СостГруз", ДанныеГруза, "СостГруз");
        // по формату не более 4х разрядов в числе                   
		Если ЕстьИЗаполненоСвойствоСтруктуры(ДанныеГруза, "КолМестГр") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КолМестГр", Мин(ДанныеГруза.КолМестГр, 9999));
		КонецЕсли;
		Если ЕстьИЗаполненоСвойствоСтруктуры(ДанныеГруза, "КолГрМест") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КолГрМест", Мин(ДанныеГруза.КолГрМест, 9999));
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СпУпак", ДанныеГруза, "СпУпак");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ВидТар", ДанныеГруза, "ВидТар", "00");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Объем", ДанныеГруза, "Объем");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Плотн", ДанныеГруза, "Плотн");
		
		Если ДанныеГруза.Свойство("ДелГр") Тогда			
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ДелГр", ?(ДанныеГруза.ДелГр = Истина, "1", "0"));
		КонецЕсли;
		Если ДанныеГруза.Свойство("РаспрГр") Тогда			
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "РаспрГр", ?(ДанныеГруза.РаспрГр = Истина, "1", "0"));
		КонецЕсли;
		
		Если ЭПД.Свойство("техМетОпрМасс") Тогда 
			//будем данные брать из владельца
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "МетОпрМасс", ЭПД.техМетОпрМасс);
		КонецЕсли; 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ДрОГруз", ДанныеГруза, "ДрОГруз");
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "Габар") Тогда
			ЗаполнитьXDTO_Габар(ЭлементXDTO.Габар, ДанныеГруза.Габар);
		ИначеЕсли XDTO_ЕстьСвойство(ЭлементXDTO, "РазмерГрМест") Тогда
			ЗаполнитьXDTO_Габар(ЭлементXDTO.РазмерГрМест, ДанныеГруза.РазмерГрМест);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "ПлМасГруз") Тогда
			ЗаполнитьXDTO_МасГруз(ЭлементXDTO.ПлМасГруз, ДанныеГруза.ПлМасГруз);
		ИначеЕсли XDTO_ЕстьСвойство(ЭлементXDTO, "МасГруз") Тогда
			ЗаполнитьXDTO_МасГруз(ЭлементXDTO.МасГруз, ДанныеГруза.МасГруз);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "ЦеннГруз") Тогда
			ЗаполнитьXDTO_ЦеннГруз(ЭлементXDTO.ЦеннГруз, ДанныеГруза.ЦеннГруз);
		КонецЕсли;
		//
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "Марк") Тогда
			ЗаполнитьСписокXDTO_Марк(ЭлементXDTO.Марк, ДанныеГруза);
		КонецЕсли;
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "СвОпГруз") Тогда
			ЗаполнитьСписокXDTO_СвОпГруз(ЭлементXDTO.СвОпГруз, ДанныеГруза);
		КонецЕсли;
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "СвКонтейн") Тогда
			ЗаполнитьСписокXDTO_СвКонтейн(ЭлементXDTO.СвКонтейн, ДанныеГруза);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Габар(XDTO, Габар)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ВысЗнач", Габар, "ВысЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ДлЗнач", Габар, "ДлЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ШирЗнач", Габар, "ШирЗнач");
	
КонецПроцедуры	

Процедура ЗаполнитьXDTO_МасГруз(XDTO, МасГруз)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "МасБрутЗнач", МасГруз, "МасБрутЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "МасНетЗнач", МасГруз, "МасНетЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "КолПалл", МасГруз, "КолПалл");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Вес_ПЭ(XDTO, Вес)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ВесНетто", Вес, "ВесНетто");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ВесБрутто", Вес, "ВесБрутто");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "КолПалл", Вес, "КолПалл");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Страна_ПЭ(ЭлементXDTO, ДанныеГруза)
	
	//todo: возможность список стран на 1 строку.
	СтранаДанные = Новый Структура("Наименование, Код");
	Если ЕстьИЗаполненоСвойствоСтруктуры(ДанныеГруза, "СвСтрПроисх") Тогда
		СтранаСсылка = Новый Структура("Ссылка");
		ЗаполнитьЗначенияСвойств(СтранаСсылка, ДанныеГруза.СвСтрПроисх);
		Если ЗначениеЗаполнено(СтранаСсылка.Ссылка) Тогда
			ЗаполнитьЗначенияСвойств(СтранаДанные, СтранаСсылка.Ссылка);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтранаДанные.Наименование) Тогда
		СтранаДанные.Наименование = "РОССИЯ";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтранаДанные.Код) Тогда
		СтранаДанные.Код = "643";
	КонецЕсли; 
	
	ЭлементXDTO_Страна = НовыйЭлементСпискаXDTO(ЭлементXDTO);
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_Страна, "НаимСтран", СтранаДанные, "Наименование");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_Страна, "КодСтр", СтранаДанные, "Код");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СтГруз_ПЭ(ЭлементXDTO, СтГруз)
	
	Если ЕстьИЗаполненоСвойствоСтруктуры(СтГруз, "СтГр") Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СтГр", СтГруз, "СтГр");
		
		ВалютаДанные = Новый Структура("Наименование, Код");
		Если ЕстьИЗаполненоСвойствоСтруктуры(СтГруз, "Валюта") Тогда
			ВалютаСсылка = Новый Структура("Ссылка");
			ЗаполнитьЗначенияСвойств(ВалютаСсылка, СтГруз.Валюта);
			Если ЗначениеЗаполнено(ВалютаСсылка.Ссылка) Тогда
				ЗаполнитьЗначенияСвойств(ВалютаДанные, ВалютаСсылка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ВалютаДанные.Наименование) Тогда
			ВалютаДанные.Наименование = "руб.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ВалютаДанные.Код) Тогда
			ВалютаДанные.Код = "643";
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НаимОКВ", ВалютаДанные, "Наименование");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КодОКВ", ВалютаДанные, "Код");
		
	КонецЕсли;
		
КонецПроцедуры

