Функция ДанныеТоварыДокументов(ДокументыОснования, ОпГрузТип)
	
	ТекстЗапроса = "";
	Запрос = Новый Запрос;
	
	Индекс = 0;
	Для Каждого ДокументОснование Из ДокументыОснования Цикл
		
		Мтд = ДокументОснование.Метаданные();
		
		Если Мтд.ТабличныеЧасти.Найти("Автомобили") <> Неопределено Тогда
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Автомобили", ТекстЗапроса, Индекс);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование);
		КонецЕсли;
		
		Если Мтд.Имя = "ЗаказНаАвтомобиль" Тогда //ААА 
			
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Ссылка", ТекстЗапроса, Индекс);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование);
			
		КонецЕсли;
		
		Если Мтд.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Товары", ТекстЗапроса, Индекс);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование); 
		ИначеЕсли Мтд.ТабличныеЧасти.Найти("Запасы") <> Неопределено Тогда
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Запасы", ТекстЗапроса, Индекс);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование); 
		ИначеЕсли Мтд.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда //Транспортная накладная
			МтдДокументыОснования = Мтд.ТабличныеЧасти.ДокументыОснования;
			Если МтдДокументыОснования.Реквизиты.Найти("ДокументОснование") <> Неопределено  Тогда
				Для Каждого СтрокаОснование Из ДокументОснование.ДокументыОснования Цикл
					Индекс = Индекс + 1;
					ТекстЗапросаТовары(СтрокаОснование.ДокументОснование, Неопределено, ТекстЗапроса, Индекс);
					Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), СтрокаОснование.ДокументОснование); 
				КонецЦикла;
			КонецЕсли;
		Иначе
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, Неопределено, ТекстЗапроса, Индекс);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование); 
		КонецЕсли;
				
	КонецЦикла;
		
	Запрос.Текст = ТекстЗапроса;
		
	ОбщаяТаблицаТоваров = Запрос.Выполнить().Выгрузить(); 
	СвернутьТоварыДокументов(ОбщаяТаблицаТоваров, ОпГрузТип);
	
	Возврат ОбщаяТаблицаТоваров;
	
КонецФункции

Процедура СвернутьТоварыДокументов(ОбщаяТаблицаТоваров, ОпГрузТип)

	Колонки = ОбщаяТаблицаТоваров.Колонки;
	
	КолонкиАгрегаты = Новый Массив;
	КолонкиАгрегаты.Добавить("ЦеннГруз_СтЦеннГр"); 
	КолонкиАгрегаты.Добавить("ОбъявлСтГруз_СтГр"); 	
	КолонкиАгрегаты.Добавить("КолГрМест");
	КолонкиАгрегаты.Добавить("КолМестГр");
	КолонкиАгрегаты.Добавить("ПлМасГруз_МасБрутЗнач");
	КолонкиАгрегаты.Добавить("ПлМасГруз_МасНетЗнач");
	КолонкиАгрегаты.Добавить("ПлМасГруз_КолПалл");
	КолонкиАгрегаты.Добавить("Объем");
	
	Если Не ОпГрузТип.Свойство("техДокОсн") Тогда
    	ОбщаяТаблицаТоваров.Колонки.Удалить("техДокОсн");	
	КонецЕсли;
	
	СтрокаКолонок = "";
	СтрокаАгрегатов = "";
	Для Каждого Колонка Из Колонки Цикл
		Если КолонкиАгрегаты.Найти(Колонка.Имя) <> Неопределено Тогда
			СтрокаАгрегатов = СтрокаАгрегатов + ?(СтрокаАгрегатов = "", "", ",") + Колонка.Имя;
		Иначе
			СтрокаКолонок = СтрокаКолонок + ?(СтрокаКолонок = "", "", ",") + Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаКолонок <> "" Тогда
		ОбщаяТаблицаТоваров.Свернуть(СтрокаКолонок, СтрокаАгрегатов);
	КонецЕсли;

КонецПроцедуры


Функция ДанныеТС(СсылкаНаОбъект, Приоритет) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Ссылка", СсылкаНаОбъект);
	
	НеОбработанные = ПараметрыТСТип();

	ТекстЗапроса = ТекстЗапросаТС(СсылкаНаОбъект);
	Если Приоритет = "ДопСв" Тогда
		ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвТС");
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
	Иначе
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
		ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвТС");
	КонецЕсли;
	ЗаполнитьНеОбработанные(Результат, НеОбработанные);
	
	// инициализируем незаполныенные значения по умолчанию 
	
	УстановитьЗначениеСвойстваПоУмолчанию(Результат, НеОбработанные, "ТипВлад", "1");
	УстановитьЗначениеСвойстваПоУмолчанию(Результат, НеОбработанные, "Тип", "Грузовой");
			
	Возврат Результат;
	
КонецФункции

Функция ДанныеВодителя(СсылкаНаОбъект, Приоритет) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Ссылка", СсылкаНаОбъект);
	
	НеОбработанные = СвВодитТип();

	ТекстЗапроса = ТекстЗапросаВодителя(СсылкаНаОбъект); 
	Если Приоритет = "ДопСв" Тогда
		ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвВодит");
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
		ОбработатьКонтактнуюИнформациюВодителя(Результат, СсылкаНаОбъект, НеОбработанные);
	Иначе
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
		ОбработатьКонтактнуюИнформациюВодителя(Результат, СсылкаНаОбъект, НеОбработанные);
		ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвВодит");
	КонецЕсли;
	ЗаполнитьНеОбработанные(Результат, НеОбработанные);
	
	// постобработка незаполненных значений
	ОбработатьФИО(Результат, "ФИО.Наименование", "ФИО.Фамилия", "ФИО.Имя", "ФИО.Отчество");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьКонтактнуюИнформациюВодителя(Результат, СсылкаНаОбъект, НеОбработанные)
	Если НеОбработанные.Свойство("Тлф") Тогда
		ДанныеКонтактнаяИнформацияТелефоны = ДанныеКонтактнаяИнформацияТелефоны(СсылкаНаОбъект);
		Результат.Вставить("Тлф", ДанныеКонтактнаяИнформацияТелефоны);
		Если ДанныеКонтактнаяИнформацияТелефоны.Количество() > 0 Тогда
			НеОбработанные.Удалить("Тлф");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


Функция ДанныеУчастника(СсылкаНаОбъект, Приоритет = "ДопСв") Экспорт
	
	ИмяМтд = СсылкаНаОбъект.Метаданные().Имя;
	
	ТипУчастника = ТипКонтрагента(СсылкаНаОбъект);

	Результат = Новый Структура();
	Результат.Вставить("Ссылка", СсылкаНаОбъект);
	
	НеОбработанные = УчастникТип(ТипУчастника);

	ТекстЗапроса = ТекстЗапросаУчастника(СсылкаНаОбъект, ТипУчастника);

	Если Приоритет = "ДопСв" Тогда
		
		Если ИмяМтд = "Организации" Тогда
			НетСведений = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвУчОрг");
			Если НетСведений Тогда
				ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвУч");
			КонецЕсли;
		Иначе
			ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвУч");
		КонецЕсли;
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
		ОбработатьКонтактнуюИнформациюУчастника(Результат, СсылкаНаОбъект, НеОбработанные);	

	Иначе 
		
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
		ОбработатьКонтактнуюИнформациюУчастника(Результат, СсылкаНаОбъект, НеОбработанные);	
		Если ИмяМтд = "Организации" Тогда
			НетСведений = ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвУчОрг");
			Если НетСведений Тогда
				ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвУч");
			КонецЕсли;
		Иначе
			ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "СвУч");
		КонецЕсли;
		
	КонецЕсли;

	ЗаполнитьНеОбработанные(Результат, НеОбработанные);
	
	ОбработатьФИО(Результат, "ИдСв.СвИП.ФИО.Наименование", "ИдСв.СвИП.ФИО.Фамилия", "ИдСв.СвИП.ФИО.Имя", "ИдСв.СвИП.ФИО.Отчество");
	ОбработатьФИО(Результат, "ИдСв.СвФЛУчаст.ФИО.Наименование", "ИдСв.СвФЛУчаст.ФИО.Фамилия", "ИдСв.СвФЛУчаст.ФИО.Имя", "ИдСв.СвФЛУчаст.ФИО.Отчество");

	ОбработатьФИО(Результат, "ИдСв.СвИП.ФИО.ПолноеНаименование", "ИдСв.СвИП.ФИО.Фамилия", "ИдСв.СвИП.ФИО.Имя", "ИдСв.СвИП.ФИО.Отчество");
	ОбработатьФИО(Результат, "ИдСв.СвФЛУчаст.ФИО.ПолноеНаименование", "ИдСв.СвФЛУчаст.ФИО.Фамилия", "ИдСв.СвФЛУчаст.ФИО.Имя", "ИдСв.СвФЛУчаст.ФИО.Отчество");

	Возврат Результат;

КонецФункции

Процедура ОбработатьКонтактнуюИнформациюУчастника(Результат, СсылкаНаОбъект, НеОбработанные)
	
	Если ЕстьСвойствоСтруктуры(НеОбработанные, "Адрес.АдрИнф.АдрТекст") Тогда
		ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдреса(СсылкаНаОбъект);
		Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
			Адрес = АдресТип();
			Адрес.АдрИнф.Вставить("АдрТекст", ДанныеКонтактнаяИнформацияАдреса[0].Адрес);
			Адрес.АдрИнф.Вставить("КодСтр", ДанныеКонтактнаяИнформацияАдреса[0].АдресКодСтраны);
			Адрес.Вставить("АдрРФ", ДанныеКонтактнаяИнформацияАдреса[0].АдресРФ);
			Результат.Вставить("Адрес", Адрес);
			НеОбработанные.Удалить("Адрес");
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьСвойствоСтруктуры(НеОбработанные, "Контакт.Тлф") Тогда
		Если Не ЕстьСвойствоСтруктуры(Результат, "Контакт") Тогда
			Результат.Вставить("Контакт", КонтактТип());	
		КонецЕсли;
		
		ДанныеКонтактнаяИнформацияТелефоны = ДанныеКонтактнаяИнформацияТелефоны(СсылкаНаОбъект);
		Результат.Контакт.Вставить("Тлф", ДанныеКонтактнаяИнформацияТелефоны);
		Если ДанныеКонтактнаяИнформацияТелефоны.Количество() > 0 Тогда
			НеОбработанные.Контакт.Удалить("Тлф");
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьСвойствоСтруктуры(НеОбработанные, "Контакт.ЭлПочта") Тогда
		Если Не ЕстьСвойствоСтруктуры(Результат, "Контакт") Тогда
			Результат.Вставить("Контакт", КонтактТип());	
		КонецЕсли;
		ДанныеКонтактнаяИнформацияАдресаЭП = ДанныеКонтактнаяИнформацияАдресаЭП(СсылкаНаОбъект);
		Результат.Контакт.Вставить("ЭлПочта", ДанныеКонтактнаяИнформацияАдресаЭП);
		Если ДанныеКонтактнаяИнформацияАдресаЭП.Количество() > 0 Тогда
			НеОбработанные.Контакт.Удалить("ЭлПочта");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


Функция ДанныеДоговора(СсылкаНаОбъект, Приоритет = "ДопСв", ИмяФормы = "") Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Ссылка", СсылкаНаОбъект);
	
	Если ИмяФормы = "ФормаПЭ" Тогда
		НеОбработанные = РеквДокТипПЭ();
	Иначе
		НеОбработанные = РеквДокТип();
	КонецЕсли;

	Если НеОбработанные.Свойство("Ссылка") Тогда
		НеОбработанные.Удалить("Ссылка");
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапросаДоговора(СсылкаНаОбъект);
	Если Приоритет = "ДопСв" Тогда
		ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "РеквДок");
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
	Иначе
		ЗаполнитьПоУчетнойСистеме(Результат, НеОбработанные, СсылкаНаОбъект, ТекстЗапроса);
		ЗаполнитьПоДополнительнымСведениям(Результат, НеОбработанные, СсылкаНаОбъект, "РеквДок");
	КонецЕсли;
	ЗаполнитьНеОбработанные(Результат, НеОбработанные);
	
	Возврат Результат;
	
