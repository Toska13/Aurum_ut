			ЭлементXDTO_СвГруз.ПрзПрвз = "1"; 
			ЗаполнитьСписокXDTO_СвКонтейн_ПЭ(ЭлементXDTO_СвГруз.СвКонтейн, ДанныеГруза, НомКонтейн);
