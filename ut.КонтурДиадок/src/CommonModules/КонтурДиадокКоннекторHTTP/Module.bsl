	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/reports+json");

	Возврат Заголовки;

КонецФункции

// Конструктор политики NEL.
// 
// Возвращаемое значение:
//  Структура - NEL создать политику:
// * NEL - Структура: см. NEL_СоздатьЭндпоинтОтчетов  - :
// * NEL_Домен - Строка - Домен NEL
// * report_to - Структура: см. NEL_СоздатьГруппуЭндпоинтов - Группа эндпоинтов
// * NEL_Сессия - Неопределено, Структура: см. СоздатьСессию - Сессия NEL
// * NEL_НеОтправлять - Булево - флаг запрета отправки NEL отчетов
// * NEL_ПоследнийОтчет - Неопределено, Структура: см. NEL_СоздатьОтчет - флаг запрета отправки NEL отчетов
//
Функция NEL_СоздатьПолитику()
	
	NEL_Политика = Новый Структура;
	NEL_Политика.Вставить("NEL", NEL_СоздатьЭндпоинтОтчетов());
	NEL_Политика.Вставить("NEL_Домен", "");
	NEL_Политика.Вставить("report_to", NEL_СоздатьГруппуЭндпоинтов()); 
	NEL_Политика.Вставить("NEL_Сессия", Неопределено); 
	NEL_Политика.Вставить("NEL_НеОтправлять", Ложь);
	NEL_Политика.Вставить("NEL_ПоследнийОтчет", Неопределено);
	
	Возврат NEL_Политика;
	
КонецФункции

// NEL создать политику по умолчанию.
// 
// Возвращаемое значение:
//  Структура: см. NEL_СоздатьПолитику - Политика NEL по умолчанию
//
Функция NEL_СоздатьПолитикуПоУмолчанию()
	
	NEL_ПолитикаПоУмолчанию = NEL_СоздатьПолитику();
	NEL_ПолитикаПоУмолчанию.NEL = NEL_ЭндпоинтОтчетовПоУмолчанию();
	NEL_ПолитикаПоУмолчанию.NEL_Домен = NEL_ДоменПоУмолчанию();
	NEL_ПолитикаПоУмолчанию.report_to = NEL_ГруппаЭндпоинтовПоУмолчанию(); 
	NEL_ПолитикаПоУмолчанию.NEL_НеОтправлять = Ложь;
	
	Возврат NEL_ПолитикаПоУмолчанию;
	
КонецФункции
