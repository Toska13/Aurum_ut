// Дата из строки RFC7231.
// 
// Параметры:
//  СтрокаДаты - Строка - Строка даты формата RFC7231
// 
// Возвращаемое значение:
//  Дата - Дата из строки RFC7231
//  
Функция ДатаИзСтрокиRFC7231(Знач СтрокаДаты) Экспорт

	Разделители = ",-:/\.";
	
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		
		Разделитель = Сред(Разделители, Индекс, 1);
		СтрокаДаты = СтрЗаменить(СтрокаДаты, Разделитель, " ");
		
	КонецЦикла;
	
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "  ", " ");

	СоставляющиеДаты = КонтурДиадокСтдСтрКлиентСервер.СтрРазделитьЛок(СтрокаДаты, " ");
	
	МесяцСтр = СоставляющиеДаты[2];

	Месяцы = КонтурДиадокСтдСтрКлиентСервер.СтрРазделитьЛок("Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec", ",");
	
	Месяц = Месяцы.Найти(МесяцСтр);
	
	Если Месяц = Неопределено Тогда
		
		Возврат '00010101';
		
	КонецЕсли;

	Дата = СоставляющиеДаты[3] + Формат(Месяц + 1, "ЧЦ=2; ЧВН=;") + СоставляющиеДаты[1];
	Время = СоставляющиеДаты[4] + СоставляющиеДаты[5] + СоставляющиеДаты[6];

	Возврат ДатаИзСтрокиЛок(Дата + Время);

КонецФункции

// Преобразует значение типа к типу, сериализация которого поддерживается.
//
// Параметры:
//  Свойство				 - Строка		 - имя свойства, если выполняется запись структуры или соответствия.
//  Значение				 - Произвольный	 - исходное значение.
//  ДополнительныеПараметры	 - Произвольный	 - дополнительные параметры, которые указаны в вызове метода ЗаписатьJSON.
//  Отказ					 - Булево		 - отказ от записи свойства.
// 
// Возвращаемое значение:
//  Строка - 
//
Функция ПреобразованиеJson(Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт

	Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		
		Возврат Строка(Значение);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		
		Возврат Base64Строка(Значение);
		
	Иначе
		
		// Если значение не поддерживает сериализацию в JSON, то будет выброшено исключение
		Возврат Значение;
		
	КонецЕсли;

КонецФункции

// Восстанавливает значение типа, десериализация которого не поддерживается.
//
// Параметры:
//  Свойство - Строка - имя свойства, значение которого нужно восстановить.
//  Значение - Строка - значение, которое нужно восстановить.
//  ТипыСвойств - Соответствие из Строка - типы свойств, которые нужно восстановить:
//   * Ключ - Строка - имя свойства. Равно значению параметра Свойство.
//   * Значение - Тип - исходный тип значения.
// 
// Возвращаемое значение:
//  Произвольный - восстановленное значение.
//
Функция ВосстановлениеJson(Свойство, Значение, ТипыСвойств) Экспорт

	ТипСвойства = ТипыСвойств.Получить(Свойство);
	
	Если ТипСвойства = Тип("УникальныйИдентификатор") Тогда
		
		Возврат Новый УникальныйИдентификатор(Значение);
		
	ИначеЕсли ТипСвойства = Тип("ДвоичныеДанные") Тогда
		
		Возврат Base64Значение(Значение);
		
	Иначе
		
		Возврат Значение;
		
	КонецЕсли;

КонецФункции

// Получить строку из двоичных данных.
//
// Параметры:
//  ВходящиеДвоичныеДанные - ДвоичныеДанные - Входящие Двоичные данные
//  Кодировка - Строка, КодировкаТекста, Неопределено - Кодировка текста файла
// 
// Возвращаемое значение:
//  Строка - Строка из двоичных данных
//
Функция ПолучитьСтрокуИзДвоичныхДанныхЛок(ВходящиеДвоичныеДанные, Кодировка = Неопределено) Экспорт
	
	Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавноЛок("8.3.10") Тогда
		
		Возврат КонтурДиадокКоннекторHTTPСлужебный8310.ПолучитьСтрокуИзДвоичныхДанныхЛок(ВходящиеДвоичныеДанные, Кодировка);
		
	Иначе
		
		Возврат КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПолучитьСтрокуИзДвоичныхДанныхЛок(ВходящиеДвоичныеДанные,
			Кодировка);
		
	КонецЕсли;
	
КонецФункции

// Получить двоичные данные из строки.
//
// Параметры:
//  ВходящаяСтрока - Строка - Входящая строка
//  Кодировка - Строка, КодировкаТекста - Кодировка текста
//  ЗаписатьBOM - Булево - Записать BOM
// 
// Возвращаемое значение:
//  ДвоичныеДанные - Двоичные данные из строки
//
Функция ПолучитьДвоичныеДанныеИзСтрокиЛок(ВходящаяСтрока, Кодировка = "UTF-8", ЗаписатьBOM = Ложь) Экспорт
	
	Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавноЛок("8.3.10") Тогда
		
