Функция ПрочитатьZip(СжатыеДанные, ТекстОшибки = Неопределено)

	Каталог = ПолучитьИмяВременногоФайла();
	СжатыйФайл = ПолучитьИмяВременногоФайла();
	СжатыеДанные.Записать(СжатыйФайл);
	ЧтениеZip = Новый ЧтениеZipФайла(СжатыйФайл);
	ИмяФайла = ЧтениеZip.Элементы[0].Имя;
	
	Попытка
		
		ЧтениеZip.Извлечь(ЧтениеZip.Элементы[0], Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		
	Исключение
		
		// Игнорируем проверку целостности архива, просто читаем результат
		ОписаниеОшибкиСтрокой = ОписаниеОшибки();
		ТекстОшибки = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
			НСтр("ru = 'Ошибка при разархивации . Описание: %1'"),
			ОписаниеОшибкиСтрокой);
		
	КонецПопытки;
	
	ЧтениеZip.Закрыть();

	Результат = Новый ДвоичныеДанные(Каталог + КонтурДиадокСтдОСКлиентСервер.ПолучитьРазделительПутиЛок() + ИмяФайла);
	
	Попытка
		
		УдалитьФайлы(Каталог);
		
	Исключение
		
		;
		
	КонецПопытки;

	Попытка
		
		УдалитьФайлы(СжатыйФайл);
		
	Исключение
		
		;
		
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет запись данных в архив GZip.
//
// Параметры:
//  Данные	 - ДвоичныеДанные	 - исходные данные.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - данные упакованные GZip.
//
Функция ЗаписатьGZipЛок(Данные)
	
	ЧтениеДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЧтениеДанных(ЗаписатьZip(Данные));
	
	НачальноеСмещение = 14;
	
	КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПропуститьЧтениеДанных(ЧтениеДанных, НачальноеСмещение);
	
	CRC32 = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПрочитатьЦелое32ЧтениеДанных(ЧтениеДанных);
	
	РазмерСжатыхДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПрочитатьЦелое32ЧтениеДанных(ЧтениеДанных);
	
	РазмерИсходныхДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПрочитатьЦелое32ЧтениеДанных(ЧтениеДанных);
	
	РазмерИмениФайла = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПрочитатьЦелое16ЧтениеДанных(ЧтениеДанных);
	
	РазмерДополнительногоПоля = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПрочитатьЦелое16ЧтениеДанных(ЧтениеДанных);
	
	КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПропуститьЧтениеДанных(ЧтениеДанных, РазмерИмениФайла +
		РазмерДополнительногоПоля);
	
	ПотокGZip = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Поток();
	
	ЗаписьДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписьДанных(ПотокGZip);
	
	GZipHeader(ЗаписьДанных);
	
	КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.КопироватьВЧтениеДанных(ЧтениеДанных, ЗаписьДанных, РазмерСжатыхДанных);
	
	ЗаписьДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписьДанных(ПотокGZip);
	
	GZipFooter(ЗаписьДанных, CRC32, РазмерИсходныхДанных);
	
	Возврат КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗакрытьИПолучитьДвоичныеДанныеПоток(ПотокGZip);
	
КонецФункции

Функция ЗаписатьZip(Данные)

	ВременныйФайл = ПолучитьИмяВременногоФайла(".bin");
	ВременныйФайлАрхив = ПолучитьИмяВременногоФайла();
	Данные.Записать(ВременныйФайл);
	ЗаписьZip = Новый ЗаписьZipФайла(ВременныйФайлАрхив);
	ЗаписьZip.Добавить(ВременныйФайл);
	ЗаписьZip.Записать();
	Результат = Новый ДвоичныеДанные(ВременныйФайлАрхив);

	Попытка
		
		УдалитьФайлы(ВременныйФайл);
		
	Исключение
		
		;
		
	КонецПопытки;

	Попытка
		
		УдалитьФайлы(ВременныйФайлАрхив);
		
	Исключение
		
		;
		
	КонецПопытки;

	Возврат Результат;

