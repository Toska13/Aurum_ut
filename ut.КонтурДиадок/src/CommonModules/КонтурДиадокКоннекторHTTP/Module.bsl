// Вызвать HTTPМетод соединения.
//
// Параметры:
//  Соединение - HTTPСоединение - Соединение
//  HTTPМетод - Строка - HTTPМетод
//  HTTPЗапрос - HTTPЗапрос - 
//  ИмяВыходногоФайла - Строка, Неопределено - Имя выходного файла
// 
// Возвращаемое значение:
//  HTTPОтвет - Результат вызова HTTPМетод
//
Функция ВызватьHTTPМетодЛок(Соединение, HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла = Неопределено)

	Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияПлатформыБольшеРавно8_3_6Лок() Тогда
		
		Возврат КонтурДиадокКоннекторHTTPСлужебный83.ВызватьHTTPМетодЛок(Соединение, HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла);
		
	Иначе
		
		Если ВРег(HTTPМетод) = ВРег("Put") Тогда
			
			Возврат Соединение.Записать(HTTPЗапрос);
			
		ИначеЕсли ВРег(HTTPМетод) = ВРег("Post") Тогда
			
			Возврат Соединение.ОтправитьДляОбработки(HTTPЗапрос, ИмяВыходногоФайла);
			
		ИначеЕсли ВРег(HTTPМетод) = ВРег("Get") Тогда
			
			Возврат Соединение.Получить(HTTPЗапрос, ИмяВыходногоФайла);
			
		ИначеЕсли ВРег(HTTPМетод) = ВРег("Delete") Тогда
			
			Возврат Соединение.Удалить(HTTPЗапрос);
			
		Иначе
			
			ВызватьИсключение
			КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
				НСтр("ru = 'Метод %1 не поддерживается в платформе версии ниже 8.3.6'"),
				HTTPМетод);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Вызвать HTTPМетод.
//
// Параметры:
//  Сессия - Структура: См. СоздатьСессию - 
//  Метод - Строка - Метод
//  URL - Строка - URL
//  ДополнительныеПараметры - Структура, Произвольный - Дополнительные параметры
// 
// Возвращаемое значение:
//  Структура: См. НовыйОтвет - 
//
Функция ВызватьHTTPМетод(Сессия, Метод, URL, ДополнительныеПараметры)

	ПодготовленныйЗапрос = ПодготовитьЗапрос(Сессия, Метод, URL, ДополнительныеПараметры);

	НастройкиПодключенияЛок = НастройкиПодключенияЛок(Метод, URL, ДополнительныеПараметры, Сессия);

	Ответ = ОтправитьЗапрос(Сессия, ПодготовленныйЗапрос, НастройкиПодключенияЛок);

	Если НастройкиПодключенияЛок.РазрешитьПеренаправление И Ответ.ЭтоРедирект Тогда
		
		// INFO: по хорошему аутентификацию нужно привести к новым параметрам, но пока будем игнорировать.
		Ответ = ПеренаправитьЗапрос(Сессия, НастройкиПодключенияЛок, ПодготовленныйЗапрос, Ответ);
		
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Перенаправить запрос.
// 
// Параметры:
//  Сессия - Структура: См. СоздатьСессию -
//  НастройкиПодключенияЛок - Структура: см. НастройкиПодключенияЛок - Настройки подключения
//  ПодготовленныйЗапрос - Структура: см. ПодготовитьЗапрос - Подготовленный запрос
//  ПеренаправленныйОтвет - Структура: см. НовыйОтвет- Перенаправленный ответ
// 
// Возвращаемое значение:
//  Структура: См. НовыйОтвет - Ответ из перенаправления
//  
Функция ПеренаправитьЗапрос(Сессия, НастройкиПодключенияЛок, ПодготовленныйЗапрос, ПеренаправленныйОтвет)

	Перенаправление = 0; // Число

	Пока ПеренаправленныйОтвет.ЭтоРедирект Цикл

		ПодготовитьЗапросДляРедиректа(Сессия, ПодготовленныйЗапрос, ПеренаправленныйОтвет);

		ПеренаправленныйОтвет = ОтправитьЗапрос(Сессия, ПодготовленныйЗапрос, НастройкиПодключенияЛок);

		Перенаправление = Перенаправление + 1;

		Если Перенаправление > Сессия.МаксимальноеКоличествоПеренаправлений Тогда
			
			ВызватьОшибкуПеренаправлений(Сессия, ПодготовленныйЗапрос, ПеренаправленныйОтвет);
			
		КонецЕсли;

	КонецЦикла;

	Возврат ПеренаправленныйОтвет;

КонецФункции

// Вызвать ошибку перенаправлений.
// 
// Параметры:
//  Сессия - Структура: См. СоздатьСессию -
//  ПодготовленныйЗапрос - Структура: см. ПодготовитьЗапрос - Подготовленный запрос
//  ПеренаправленныйОтвет - Структура: см. НовыйОтвет- Перенаправленный ответ
//
Процедура ВызватьОшибкуПеренаправлений(Сессия, ПодготовленныйЗапрос, ПеренаправленныйОтвет)
	
	ОписаниеОшибкиПеренаправлений = "СлишкомМногоПеренаправлений";
	НачалоДата = ТекущаяДатаСеанса();
	
	Попытка
		
		ВызватьИсключение (ОписаниеОшибкиПеренаправлений);
		
	Исключение
		
		ОшибкаВыполненияЗапроса = ИнформацияОбОшибке();
	
	КонецПопытки;
	
	ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ОшибкаВыполненияЗапроса);
	
	ТекстОшибки = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
		НСтр("ru = 'HTTP %1 %2
			|Network error:
			| %3'"),
			ПодготовленныйЗапрос.Метод,
			ПодготовленныйЗапрос.URL,
			ПредставлениеОшибки);
		
	Если Не Сессия.Лог = Неопределено Тогда
		
		СтрокаЛог = "[%1] ""%2 %3"" %4 %5";
		СтрокаЛог = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
			СтрокаЛог,
			Формат(НачалоДата, "ДФ='yyyy.MM.dd HH:mm:ss'"), // 1
			ПодготовленныйЗапрос.Метод, // 2
			ПодготовленныйЗапрос.URL, // 3
			ТекстОшибки, // 4
			XMLСтрока(0)); // 5
		
		Сессия.Лог.ДобавитьСтроку(СтрокаЛог);
		
	КонецЕсли;
	
	NEL_ОписаниеОшибки = NEL_СформироватьОтчет(Сессия, ПодготовленныйЗапрос, ОшибкаВыполненияЗапроса,
		ПеренаправленныйОтвет);
	
	Если Не NEL_ОписаниеОшибки = Неопределено Тогда
		
		NELПолитика = Сессия.NELПолитика;
		NEL_ОтправитьОписаниеОшибки(NEL_ОписаниеОшибки, NELПолитика);
		
	КонецЕсли;
	
	ВызватьИсключение (ОписаниеОшибкиПеренаправлений);
	
КонецПроцедуры

// Вызвать ошибку запроса.
// 
// Параметры:
//  Сессия - Структура: См. СоздатьСессию -
//  ПодготовленныйЗапрос - Структура: см. ПодготовитьЗапрос - Подготовленный запрос
//  ДлительностьМс - Число - Длительность запроса мс
//  ОшибкаВыполненияЗапроса - ИнформацияОбОшибке - Ошибка выполнения запроса
//
Процедура ВызватьОшибкуВыполненияЗапроса(Сессия, ПодготовленныйЗапрос, ДлительностьМс, ОшибкаВыполненияЗапроса)
	
	NEL_ОписаниеОшибки = NEL_СформироватьОтчет(Сессия, ПодготовленныйЗапрос, ОшибкаВыполненияЗапроса, ,
		ДлительностьМс);
	
	Если Не NEL_ОписаниеОшибки = Неопределено Тогда
		
		NELПолитика = Сессия.NELПолитика;
		NEL_ОтправитьОписаниеОшибки(NEL_ОписаниеОшибки, NELПолитика);
		
	КонецЕсли;
	
	ВызватьИсключение (ПодробноеПредставлениеОшибки(ОшибкаВыполненияЗапроса));
	
КонецПроцедуры

// Подготовить запрос для редиректа.
// 
// Параметры:
//  Сессия - Неопределено, Структура: см. СоздатьСессию - Сессия:
//  ПодготовленныйЗапрос - Структура: см. ПодготовитьЗапрос - Подготовленный запрос
//  ПеренаправленныйОтвет - Структура: см. НовыйОтвет - Перенаправленный ответ
//
Процедура ПодготовитьЗапросДляРедиректа(Сессия, ПодготовленныйЗапрос, ПеренаправленныйОтвет)

	КодыСостоянияHTTP = КодыСостоянияHTTP();

	НовыйURL = СформироватьНовыйURLПриПеренаправлении(ПеренаправленныйОтвет);

	ПодготовленныйЗапрос.URL = КодироватьСтрокуЛок(НовыйURL, "URLВКодировкеURL");
	НовыйHTTPЗапрос = Новый HTTPЗапрос(СобратьАдресРесурса(РазобратьURL(НовыйURL), Новый Соответствие));
	ПереопределитьМетод(ПодготовленныйЗапрос, ПеренаправленныйОтвет);

	Если ПеренаправленныйОтвет.КодСостояния <> КодыСостоянияHTTP.ВременноеПеренаправление_307
		И ПеренаправленныйОтвет.КодСостояния <> КодыСостоянияHTTP.ПостоянноеПеренаправление_308 Тогда
		
		УдалитьЗаголовки(ПодготовленныйЗапрос.Заголовки, "content-length,content-type,transfer-encoding");
		НовыйHTTPЗапрос.Заголовки = ПодготовленныйЗапрос.Заголовки;
		
	Иначе
		
		ИсходныеДвоичныеДанные = ПодготовленныйЗапрос.HTTPЗапрос.ПолучитьТелоКакДвоичныеДанные();
		
		Если Не ИсходныеДвоичныеДанные = Неопределено Тогда
			
			НовыйHTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ИсходныеДвоичныеДанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПодготовленныйЗапрос.HTTPЗапрос = НовыйHTTPЗапрос;
	УдалитьЗаголовки(ПодготовленныйЗапрос.Заголовки, "cookies");

	ПодготовленныйЗапрос.Cookies = ОбъединитьCookies(ПодготовленныйЗапрос.Cookies, Сессия.Cookies);
	ПодготовитьCookies(ПодготовленныйЗапрос);

КонецПроцедуры

Процедура ПодготовитьАутентификацию(ПодготовленныйЗапрос)

	ПодготовленныйЗапрос.Вставить("СобытияНаОтвет", Новый Массив);
	
	Если Не ЗначениеЗаполнено(ПодготовленныйЗапрос.Аутентификация) Тогда
		
		СтруктураURL = РазобратьURL(ПодготовленныйЗапрос.URL);
		
		Если ЗначениеЗаполнено(СтруктураURL.Аутентификация) Тогда
			
			ПодготовленныйЗапрос.Аутентификация = СтруктураURL.Аутентификация;
			
		КонецЕсли;
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ПодготовленныйЗапрос.Аутентификация) Тогда
		
		Если ПодготовленныйЗапрос.Аутентификация.Свойство("Тип") Тогда
			ТипАутентификации = ПодготовленныйЗапрос.Аутентификация.Тип; // Строка
			ТипАутентификации = НРег(ТипАутентификации);
			
			Если ТипАутентификации = "digest" Тогда
				
				ПодготовленныйЗапрос.СобытияНаОтвет.Добавить("ОбработкаОтветаСКодом401");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьТелоЗапроса(ПодготовленныйЗапрос, Данные, ФайлыЛок, JsonЛок, ПараметрыЗаписиJSON)

	СтруктураURL = РазобратьURL(ПодготовленныйЗапрос.URL);

	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса = СобратьАдресРесурса(СтруктураURL, ПодготовленныйЗапрос.ПараметрыЗапроса);
	
	Если ЗначениеЗаполнено(ФайлыЛок) Тогда
		
		ContentType = ЗакодироватьФайлы(HTTPЗапрос, ФайлыЛок, Данные);
		
	ИначеЕсли ЗначениеЗаполнено(Данные) Тогда
		
		ContentType = "application/x-www-form-urlencoded";
		
		Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
			
			HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(Данные);
			
		Иначе
			
			Если ТипЗнч(Данные) = Тип("Строка") Тогда
				
				Тело = Данные;
				
			Иначе
				
				Тело = КодироватьПараметрыЗапроса(Данные);
				
			КонецЕсли;
			
			ContentType = "application/x-www-form-urlencoded; charset=utf-8";
			HTTPЗапрос.УстановитьТелоИзСтроки(Тело, "CESU-8");
			
		КонецЕсли;
		
	ИначеЕсли JsonЛок <> Неопределено Тогда
		
		ContentType = "application/json; charset=utf-8";
		СтрокаJson = ОбъектВJson(JsonЛок);
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJson, "CESU-8");
		
	Иначе
		
		ContentType = Неопределено;
		
	КонецЕсли;
	
	ЗначениеЗаголовка = ЗначениеЗаголовка("content-type", ПодготовленныйЗапрос.Заголовки);
	
	Если ЗначениеЗаголовка = Ложь И ЗначениеЗаполнено(ContentType) Тогда
		
		ПодготовленныйЗапрос.Заголовки.Вставить("Content-Type", ContentType);
		
	КонецЕсли;

	HTTPЗапрос.Заголовки = ПодготовленныйЗапрос.Заголовки;

	УпаковатьЗапрос(HTTPЗапрос);

	ПодготовленныйЗапрос.Вставить("HTTPЗапрос", HTTPЗапрос);

КонецПроцедуры

Функция ЗакодироватьФайлы(HTTPЗапрос, ФайлыЛок, Данные)

	Части = Новый Массив;
	
	Если ЗначениеЗаполнено(Данные) Тогда
		
		Для Каждого Поле Из Данные Цикл
			
			Части.Добавить(СоздатьПолеФормы(Новый Структура("Имя, Данные", Поле.Ключ, Поле.Значение)));
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипЗнч(ФайлыЛок) = Тип("Массив") Тогда
		
		Для Каждого Файл Из ФайлыЛок Цикл
			
			Части.Добавить(СоздатьПолеФормы(Файл));
			
		КонецЦикла;
		
	Иначе
		
		Части.Добавить(СоздатьПолеФормы(ФайлыЛок));
		
	КонецЕсли;

	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");

	Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавноЛок("8.3.10") Тогда
		
		ДвоичныеДанныеТела = КонтурДиадокКоннекторHTTPСлужебный8310.ПолучитьДвоичныеДанныеТела(Части, Разделитель);
		
	Иначе
		
		ДвоичныеДанныеТела = ПолучитьДвоичныеДанныеТела(Части, Разделитель);
		
	КонецЕсли;
	
	HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеТела);

	Возврат КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок("multipart/form-data; boundary=%1", Разделитель);
	
КонецФункции

Функция ПолучитьДвоичныеДанныеТела(Части, Разделитель)
	
	РазделительСтрок = Символы.ВК + Символы.ПС;

	ПотокТелаЗапроса = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Поток();
	
	ЗаписьДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписьДанных(ПотокТелаЗапроса, КодировкаТекста.UTF8,
		"LittleEndian", "", "", Ложь);
	
	Для Каждого Часть Из Части Цикл
		
		КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, "--" + Разделитель);
		КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, РазделительСтрок);
		КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных,
			ЗаголовкиВСтроку(Часть.Заголовки));
		КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, РазделительСтрок);
		КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, РазделительСтрок);
		
		Если ТипЗнч(Часть.Данные) = Тип("ДвоичныеДанные") Тогда
			
			КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьЗаписьДанных(ЗаписьДанных, Часть.Данные);
			
		Иначе
			
			КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, Часть.Данные);
			
		КонецЕсли;
		
		КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, РазделительСтрок);
		
	КонецЦикла;

	КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписатьСтрокуЗаписьДанных(ЗаписьДанных, "--" + Разделитель + "--");
	
	Возврат КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗакрытьИПолучитьДвоичныеДанныеПоток(ПотокТелаЗапроса);
	
КонецФункции

Функция СоздатьПолеФормы(ИсходныеПараметры)

	Поле = Новый Структура;
	Поле.Вставить("Имя", ИсходныеПараметры.Имя);
	Поле.Вставить("ИмяФайла", ЗначениеПоКлючу(ИсходныеПараметры, "ИмяФайла"));
	Поле.Вставить("Данные", ИсходныеПараметры.Данные);
	Поле.Вставить("Тип", ЗначениеПоКлючу(ИсходныеПараметры, "Тип"));
	Поле.Вставить("Заголовки", ЗначениеПоКлючу(ИсходныеПараметры, "Заголовки", Новый Соответствие));

	Ключ = "Content-Disposition";
	
	Если ЗначениеЗаголовка("content-disposition", Поле.Заголовки, Ключ) = Ложь Тогда
		
		Поле.Заголовки.Вставить("Content-Disposition", "form-data");
		
	КонецЕсли;

	Части = Новый Массив; // Массив из Строка
	Части.Добавить(Поле.Заголовки[Ключ]);
	Части.Добавить(КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок("name=""%1""", Поле.Имя));
	
	Если ЗначениеЗаполнено(Поле.ИмяФайла) Тогда
		
		Части.Добавить(КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок("filename=""%1""", Поле.ИмяФайла));
		
	КонецЕсли;

	Поле.Заголовки[Ключ] = КонтурДиадокСтдСтрКлиентСервер.СтрСоединитьЛок(Части, "; ");
	Поле.Заголовки["Content-Type"] = Поле.Тип;

	Возврат Поле;

КонецФункции

Функция ЗаполнитьПараметрыЗапросаЛок(Путь)

	ПараметрыЗапроса = Новый Соответствие;

	Запрос = "";
	РазбитьСтрокуПоРазделителюЛок(Запрос, Путь, "?", Истина);
	МассивПоРазделителю = КонтурДиадокСтдСтрКлиентСервер.СтрРазделитьЛок(Запрос, "&", Ложь);
	
	Для Каждого СтрокаКлючРавноПараметр Из МассивПоРазделителю Цикл
		
		СтрокаКлючРавноПараметр = РаскодироватьСтрокуЛок(СтрокаКлючРавноПараметр, "URLВКодировкеURL");

		ПозицияРавно = КонтурДиадокСтдСтрКлиентСервер.СтрНайтиЛок(СтрокаКлючРавноПараметр, "=");
		
		Если ПозицияРавно = 0 Тогда
			
			Ключ = СтрокаКлючРавноПараметр;
			Значение = Неопределено;
			
		Иначе
			
			Ключ = Лев(СтрокаКлючРавноПараметр, ПозицияРавно - 1);
			Значение = Сред(СтрокаКлючРавноПараметр, ПозицияРавно + 1);
			
		КонецЕсли;

		Если ПараметрыЗапроса.Получить(Ключ) <> Неопределено Тогда
			
			Если ТипЗнч(ПараметрыЗапроса[Ключ]) = Тип("Массив") Тогда
				
				ПараметрыЗапроса[Ключ].Добавить(Значение);
				
			Иначе
				
				Значения = Новый Массив;
				Значения.Добавить(ПараметрыЗапроса[Ключ]);
				Значения.Добавить(Значение);
				ПараметрыЗапроса[Ключ] = Значения;
				
			КонецЕсли;
			
		Иначе
			
			ПараметрыЗапроса.Вставить(Ключ, Значение);
			
		КонецЕсли;

	КонецЦикла;

	Возврат ПараметрыЗапроса;

КонецФункции

Функция КодироватьПараметрыЗапроса(ПараметрыЗапроса)

	ЧастиПараметрыЗапроса = Новый Массив; // Массив из Строка
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			
			Значения = Параметр.Значение;
			
		Иначе
			
			Значения = Новый Массив; // Массив из Строка
			Значения.Добавить(Параметр.Значение);
			
		КонецЕсли;

		Если Параметр.Значение = Неопределено Тогда
			
			ЧастиПараметрыЗапроса.Добавить(Параметр.Ключ);
			
		Иначе
			
			Для Каждого Значение Из Значения Цикл
				
				ЗначениеПараметра = КодироватьСтрокуЛок(XMLСтрока(Значение), "КодировкаURL");
				КлючИЗначениеПараметра = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
					"%1=%2",
					Параметр.Ключ,
					ЗначениеПараметра);
				ЧастиПараметрыЗапроса.Добавить(КлючИЗначениеПараметра);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат КонтурДиадокСтдСтрКлиентСервер.СтрСоединитьЛок(ЧастиПараметрыЗапроса, "&");
	
КонецФункции

Процедура ПереопределитьМетод(ПодготовленныйЗапрос, Ответ)

	КодыСостоянияHTTP = КодыСостоянияHTTP();

	Метод = ПодготовленныйЗапрос.Метод;

	// http://tools.ietf.org/html/rfc7231#section-6.4.4
	Если Ответ.КодСостояния = КодыСостоянияHTTP.СмотретьДругое_303 И Метод <> "HEAD" Тогда
		
		Метод = "GET";
		
	КонецЕсли;

	// Поведение браузеров
	Если Ответ.КодСостояния = КодыСостоянияHTTP.ПеремещеноВременно_302 И Метод <> "HEAD" Тогда
		
		Метод = "GET";
		
	КонецЕсли;

	ПодготовленныйЗапрос.Метод = Метод;

КонецПроцедуры

// Отправить запрос.
//
// Параметры:
//  Сессия - Структура: См. СоздатьСессию - 
//  ПодготовленныйЗапрос - Структура: См. ПодготовитьЗапрос - Подготовленный запрос
//  НастройкиПодключенияЛок - Структура: См. НастройкиПодключенияЛок - Настройки подключения
// 
// Возвращаемое значение:
//  Структура: См. НовыйОтвет - Ответ на запрос
//
Функция ОтправитьЗапрос(Сессия, ПодготовленныйЗапрос, НастройкиПодключенияЛок)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачалоДата = ТекущаяДатаСеанса();
	МиллисекундВСекунде = 1000;

	Повтор = 0;
	Длительность = 0;
	Ошибки = Новый Массив; // Массив из Строка

	Пока Истина Цикл
		
		ТекстОшибки = "";

		Ответ = Неопределено;
		ОшибкаВыполненияЗапроса = Неопределено;

		Попытка
			
			Ответ = ОтправитьHTTPЗапрос(Сессия, ПодготовленныйЗапрос, НастройкиПодключенияЛок);
			
		Исключение
			
			ОшибкаВыполненияЗапроса = ИнформацияОбОшибке();

			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ОшибкаВыполненияЗапроса);
			ТекстОшибки = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
				НСтр("ru = 'HTTP %1 %2
					|Network error:
					| %3'"),
				ПодготовленныйЗапрос.Метод,
				ПодготовленныйЗапрос.URL,
				ПредставлениеОшибки);
				
			Ошибки.Добавить(ТекстОшибки);
			
		КонецПопытки;

		Повтор = Повтор + 1;
		Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ДлительностьМс = Конец - Начало;
		Длительность = ДлительностьМс / МиллисекундВСекунде;

		Если Не Сессия.Лог = Неопределено Тогда
			
			СтрокаЛог = "[%1] ""%2 %3"" %4 %5";
			СтрокаЛог = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
				СтрокаЛог,
				Формат(НачалоДата, "ДФ='yyyy.MM.dd HH:mm:ss'"), // 1
				ПодготовленныйЗапрос.Метод, // 2
				ПодготовленныйЗапрос.URL, // 3
				?(Ответ = Неопределено, ТекстОшибки, Ответ.КодСостояния), // 4
				XMLСтрока(Длительность)); // 5
			
			Сессия.Лог.ДобавитьСтроку(СтрокаЛог);
			
		КонецЕсли;

		Если Не НеобходимоПовторитьЗапрос(Ответ, НастройкиПодключенияЛок, ОшибкаВыполненияЗапроса) Тогда
			
			Прервать;
			
		КонецЕсли;

		Если Повтор > НастройкиПодключенияЛок.МаксимальноеКоличествоПовторов
			Или Длительность > НастройкиПодключенияЛок.МаксимальноеВремяПовторов Тогда
			
			Прервать;
			
		КонецЕсли;

		Если ОшибкаВыполненияЗапроса <> Неопределено
			Или Не ЭтоКодСостоянияПриКоторомНужноУчитыватьЗаголовокRetryAfter(Ответ.КодСостояния) Тогда
			
			ЗаголовокRetryAfter = Ложь;
			
		Иначе
			
			ЗаголовокRetryAfter = ЗначениеЗаголовка("retry-after", Ответ.Заголовки);
			
		КонецЕсли;

		ДлительностьПриостановки = РассчитатьДлительностьПриостановки(
			Повтор,
			НастройкиПодключенияЛок.КоэффициентЭкспоненциальнойЗадержки,
			ЗаголовокRetryAfter,
			НастройкиПодключенияЛок.МаксимальноеВремяПовторов - Длительность);
			
		Приостановить(ДлительностьПриостановки);
		
	КонецЦикла;
	
	Если Не Ответ = Неопределено Тогда
		
		ЗаголовокNEL = ЗначениеЗаголовка("NEL", Ответ.Заголовки); // Строка
		ЗаголовокReportTo = ЗначениеЗаголовка("report-to", Ответ.Заголовки); // Строка
		
		Если Не ЗаголовокNEL = Ложь
			И Не ЗаголовокReportTo = Ложь Тогда
				
			NEL_ЗаполнитьСтруктуруNELИReportTo(Сессия, ЗаголовокNEL, ЗаголовокReportTo);
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если ОшибкаВыполненияЗапроса <> Неопределено Тогда
		
		ВызватьОшибкуВыполненияЗапроса(Сессия, ПодготовленныйЗапрос, ДлительностьМс, ОшибкаВыполненияЗапроса);
		
	КонецЕсли;

	ЗаголовокContentType = ЗначениеЗаголовка("content-type", Ответ.Заголовки);
	
	Если ЗаголовокContentType = Ложь Тогда
		
		ЗаголовокContentType = "";
		
	КонецЕсли;

	ПодготовленныйОтвет = НовыйОтвет();
	ПодготовленныйОтвет.Метод = ПодготовленныйЗапрос.Метод;
	ПодготовленныйОтвет.URL = ПодготовленныйЗапрос.URL;
	ПодготовленныйОтвет.КодСостояния = Ответ.КодСостояния;
	ПодготовленныйОтвет.Заголовки = Ответ.Заголовки;
	ПодготовленныйОтвет.ТелоКакДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	ПодготовленныйОтвет.Кодировка = КодировкаИзЗаголовка(ЗаголовокContentType);
	ПодготовленныйОтвет.ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	ПодготовленныйОтвет.ЭтоПостоянныйРедирект = ЭтоПостоянныйРедирект(Ответ.КодСостояния, Ответ.Заголовки);
	ПодготовленныйОтвет.ЭтоРедирект = ЭтоРедирект(Ответ.КодСостояния, Ответ.Заголовки);
	ПодготовленныйОтвет.Cookies = ИзвлечьCookies(Ответ.Заголовки, ПодготовленныйЗапрос.URL);
	ПодготовленныйОтвет.Ошибки = Ошибки;

	Сессия.Cookies = ОбъединитьCookies(Сессия.Cookies, ПодготовленныйОтвет.Cookies);

	NEL_ОписаниеОшибки = NEL_СформироватьОтчет(Сессия, ПодготовленныйЗапрос, , ПодготовленныйОтвет, ДлительностьМс);
	
	Если Не NEL_ОписаниеОшибки = Неопределено Тогда
		
		NELПолитика = Сессия.NELПолитика;
		NEL_ОтправитьОписаниеОшибки(NEL_ОписаниеОшибки, NELПолитика);
		
	КонецЕсли;
	
	Возврат ПодготовленныйОтвет;

КонецФункции

// Домен является поддоменом.
// ДоменЯвляетсяПоддоменом("diadoc.kontur.ru", "kontur.ru") = Истина
// ДоменЯвляетсяПоддоменом("kontur.ru", "kontur.ru") = Истина
// ДоменЯвляетсяПоддоменом("skbkontur.ru", "kontur.ru") = Ложь
// 
// Параметры:
//  ДоменСПоддоменом - Строка - Домен с поддоменом
//  Домен - Строка - Домен
// 
// Возвращаемое значение:
//  Булево - Домен является поддоменом
//  
Функция ДоменЯвляетсяПоддоменом(Знач ДоменСПоддоменом, Знач Домен)
	
	ЭтоТотЖеДомен = ДоменСПоддоменом = Домен;
	
	Домен = ДобавитьЛидирующуюТочку(Домен);

	Возврат КонтурДиадокСтдСтрКлиентСервер.СтрЗаканчиваетсяНаЛок(ДоменСПоддоменом, Домен)
		Или ЭтоТотЖеДомен;
	
КонецФункции

Функция Сформировать_user_agent()
	
	Возврат "1C+Enterprise/" + КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияПриложенияЛок();
	
КонецФункции

// Отправить HTTPЗапрос.
// 
// Параметры:
//  Сессия - Структура: См. СоздатьСессию - 
//  ПодготовленныйЗапрос - Структура: См. ПодготовитьЗапрос - Подготовленный запрос
//  НастройкиПодключенияЛок - Структура: См. НастройкиПодключенияЛок - Настройки подключения
// 
// Возвращаемое значение:
//  HTTPОтвет - Ответ на запрос
//
Функция ОтправитьHTTPЗапрос(Сессия, ПодготовленныйЗапрос, НастройкиПодключенияЛок)

	СтруктураURL = РазобратьURL(ПодготовленныйЗапрос.URL);
	Соединение = Соединение(СтруктураURL, ПодготовленныйЗапрос.Аутентификация, НастройкиПодключенияЛок, Сессия);

	Ответ = ВызватьHTTPМетодЛок(Соединение, ПодготовленныйЗапрос.Метод, ПодготовленныйЗапрос.HTTPЗапрос);

	Для Каждого Обработчик Из ПодготовленныйЗапрос.СобытияНаОтвет Цикл
		
		Если Обработчик = "ОбработкаОтветаСКодом401" Тогда
			
			ОбработкаОтветаСКодом401(Сессия, ПодготовленныйЗапрос, НастройкиПодключенияЛок, Ответ);
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Функция НеобходимоПовторитьЗапрос(Ответ, Настройки, ОшибкаВыполненияЗапроса)

	Если Настройки.МаксимальноеКоличествоПовторов < 1 Тогда
		
		ПовторитьЗапрос = Ложь;
		
	ИначеЕсли ОшибкаВыполненияЗапроса <> Неопределено
		Или ПовторятьПриКодеСостояния(Ответ.КодСостояния, Настройки) Тогда
		
		ПовторитьЗапрос = Истина;
		
	Иначе
		
		ЗаголовокRetryAfter = ЗначениеЗаголовка("retry-after", Ответ.Заголовки);
		
		ПовторитьЗапрос = ЗаголовокRetryAfter <> Ложь
			И ЭтоКодСостоянияПриКоторомНужноУчитыватьЗаголовокRetryAfter(Ответ.КодСостояния);
		
	КонецЕсли;

	Возврат ПовторитьЗапрос;

КонецФункции

Функция ПовторятьПриКодеСостояния(КодСостояния, Настройки)

	ПовторПриЛюбомКодеСостоянияБольшеИлиРавным500 = Настройки.ПовторятьДляКодовСостояний = Неопределено
		И КодСостояния >= КодыСостоянияHTTP().ВнутренняяОшибкаСервера_500;
	
	КодСостоянияСоответствуетКодуСостоянияПовтора = ТипЗнч(Настройки.ПовторятьДляКодовСостояний) = Тип("Массив")
		И Настройки.ПовторятьДляКодовСостояний.Найти(КодСостояния) <> Неопределено;

	Возврат ПовторПриЛюбомКодеСостоянияБольшеИлиРавным500 Или КодСостоянияСоответствуетКодуСостоянияПовтора;
	
КонецФункции

Функция ЭтоПостоянныйРедирект(КодСостояния, Заголовки)

	КодыСостоянияHTTP = КодыСостоянияHTTP();

	Возврат ЕстьЗаголовокLocation(Заголовки) И (КодСостояния = КодыСостоянияHTTP.ПеремещеноНавсегда_301
		Или КодСостояния = КодыСостоянияHTTP.ПостоянноеПеренаправление_308);

КонецФункции

Функция ЭтоРедирект(КодСостояния, Заголовки)

	КодыСостоянияHTTP = КодыСостоянияHTTP();

	СостоянияРедиректа = Новый Массив; // Массив из Число
	СостоянияРедиректа.Добавить(КодыСостоянияHTTP.ПеремещеноНавсегда_301);
	СостоянияРедиректа.Добавить(КодыСостоянияHTTP.ПеремещеноВременно_302);
	СостоянияРедиректа.Добавить(КодыСостоянияHTTP.СмотретьДругое_303);
	СостоянияРедиректа.Добавить(КодыСостоянияHTTP.ВременноеПеренаправление_307);
	СостоянияРедиректа.Добавить(КодыСостоянияHTTP.ПостоянноеПеренаправление_308);

	Возврат ЕстьЗаголовокLocation(Заголовки) И СостоянияРедиректа.Найти(КодСостояния) <> Неопределено;

КонецФункции

Процедура УпаковатьЗапрос(Запрос)

	Заголовок = ЗначениеЗаголовка("content-encoding", Запрос.Заголовки);
	
	Если Заголовок <> Ложь Тогда
		
		Если НРег(Заголовок) = "gzip" Тогда
			
			Запрос.УстановитьТелоИзДвоичныхДанных(ЗаписатьGZip(Запрос.ПолучитьТелоКакДвоичныеДанные()));
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Распаковать ответ.
//
// Параметры:
//  Ответ - Структура: См. НовыйОтвет - 
// 
// Возвращаемое значение:
//  ДвоичныеДанные - Распакованный ответ
//
Функция РаспаковатьОтвет(Ответ)

	Заголовок = ЗначениеЗаголовка("content-encoding", Ответ.Заголовки);
	
	Если Заголовок <> Ложь Тогда
		
		Если НРег(Заголовок) = "gzip" Тогда
			
			Возврат ПрочитатьGZip(Ответ.ТелоКакДвоичныеДанные);
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат Ответ.ТелоКакДвоичныеДанные;

КонецФункции

Процедура ОбработкаОтветаСКодом401(Сессия, ПодготовленныйЗапрос, Настройки, Ответ)

	Если ЭтоРедирект(Ответ.КодСостояния, Ответ.Заголовки) Тогда
		
		Возврат;
		
	КонецЕсли;

	КодыСостоянияHTTP = КодыСостоянияHTTP();
	
	Если Ответ.КодСостояния < КодыСостоянияHTTP.НеверныйЗапрос_400
		Или Ответ.КодСостояния >= КодыСостоянияHTTP.ВнутренняяОшибкаСервера_500 Тогда
		
		Возврат;
		
	КонецЕсли;

	Значение = ЗначениеЗаголовка("www-authenticate", Ответ.Заголовки);

	Позиция = КонтурДиадокСтдСтрКлиентСервер.СтрНайтиЛок(НРег(Значение), "digest");

	Если Значение <> Ложь И Позиция Тогда
		
		Значение = Сред(Значение, Позиция + СтрДлина("digest") + 1);
		Значение = СтрЗаменить(Значение, """", "");
		Значение = СтрЗаменить(Значение, Символы.ПС, "");

		ПараметрыDigest = Новый Структура("algorithm,realm,nonce,qop,opaque");
		
		Для Каждого Часть Из РазбитьСтрокуПоСтроке(Значение, ", ") Цикл
			
			КлючЗначение = КонтурДиадокСтдСтрКлиентСервер.СтрРазделитьЛок(Часть, "=");
			ПараметрыDigest.Вставить(КлючЗначение[0], КлючЗначение[1]);
			
		КонецЦикла;

		Сессия.СлужебныеДанные.ПараметрыDigest = ПараметрыDigest;

		ПодготовленныйЗапрос.Заголовки.Вставить("Authorization",
			ПодготовитьЗаголовокDigest(Сессия, ПодготовленныйЗапрос));
		ПодготовленныйЗапрос.HTTPЗапрос.Заголовки = ПодготовленныйЗапрос.Заголовки;

		Ответ = ОтправитьHTTPЗапрос(Сессия, ПодготовленныйЗапрос, Настройки);
		
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьURL(Знач URL, ПараметрыЗапроса = Неопределено)

	URL = СокрЛ(URL);

	СтруктураURL = РазобратьURL(URL);

	ПодготовленныйURL = СтруктураURL.Схема + "://";
	
	Если ЗначениеЗаполнено(СтруктураURL.Аутентификация.Пользователь) Тогда
		
		ПодготовленныйURL = ПодготовленныйURL + СтруктураURL.Аутентификация.Пользователь + ":"
			+ СтруктураURL.Аутентификация.Пароль + "@";
			
	КонецЕсли;
	
	ПодготовленныйURL = ПодготовленныйURL + СтруктураURL.Сервер;
	
	Если ЗначениеЗаполнено(СтруктураURL.Порт) Тогда
		
		ПодготовленныйURL = ПодготовленныйURL + ":" + ПолучитьПредставлениеЧислаЛок(СтруктураURL.Порт);
		
	КонецЕсли;

	ПодготовленныйURL = ПодготовленныйURL + СобратьАдресРесурса(СтруктураURL, ПараметрыЗапроса);

	Возврат ПодготовленныйURL;

КонецФункции

Функция СобратьАдресРесурса(СтруктураURL, ПараметрыЗапроса)

	ОбъединенныеПараметрыЗапроса = Объединить(Скопировать(ПараметрыЗапроса), СтруктураURL.ПараметрыЗапроса);
	
	АдресРесурса = СформироватьАдресРесурса(СтруктураURL.Путь, ОбъединенныеПараметрыЗапроса, СтруктураURL.Фрагмент);
	
	Возврат АдресРесурса;

КонецФункции

Функция СформироватьАдресРесурса(Путь, ПараметрыЗапроса, Фрагмент = "")
	
	АдресРесурса = Путь;
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		
		АдресРесурса = АдресРесурса + "?" + КодироватьПараметрыЗапроса(ПараметрыЗапроса);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Фрагмент) Тогда
		
		АдресРесурса = АдресРесурса + "#" + Фрагмент;
		
	КонецЕсли;

	Возврат АдресРесурса;

КонецФункции

Функция СформироватьНовыйURLПриПеренаправлении(Ответ)

	НовыйURL = ЗначениеЗаголовка("location", Ответ.Заголовки);
	НовыйURL = РаскодироватьСтрокуЛок(НовыйURL, "URLВКодировкеURL");

	// Редирект без схемы
	Если КонтурДиадокСтдСтрКлиентСервер.СтрНачинаетсяСЛок(НовыйURL, "//") Тогда
		
		СтруктураURL = РазобратьURL(Ответ.URL);
		НовыйURL = СтруктураURL.Схема + ":" + НовыйURL;
		
	КонецЕсли;

	СтруктураURL = РазобратьURL(НовыйURL);
	
	Если РазбитьСтрокуПоСтроке(НовыйURL, "://").Количество() < 2 Тогда
		
		СтруктураURLОтвета = РазобратьURL(Ответ.URL);
		БазовыйURL = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
			"%1://%2",
			СтруктураURLОтвета.Схема,
			СтруктураURLОтвета.Сервер);
		
		Если ЗначениеЗаполнено(СтруктураURLОтвета.Порт) Тогда
			
			БазовыйURL = БазовыйURL + ":" + ПолучитьПредставлениеЧислаЛок(СтруктураURLОтвета.Порт);
			
		КонецЕсли;
		
		Если КонтурДиадокСтдСтрКлиентСервер.СтрНачинаетсяСЛок(НовыйURL, "/") Тогда
			
			НовыйURL = БазовыйURL + НовыйURL;
			
		Иначе
			
			ИндексПоследнегоСлеша = КонтурДиадокСтдСтрКлиентСервер.СтрНайтиЛок(СтруктураURLОтвета.Путь, "/", "СКонца");
			РодительскаяДиректория = Лев(СтруктураURLОтвета.Путь, ИндексПоследнегоСлеша);
			НовыйURL = БазовыйURL + РодительскаяДиректория + НовыйURL;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат НовыйURL;

КонецФункции

// Настройки подключения.
//
// Параметры:
//  Метод					 - Строка					 - Метод
//  URL						 - Строка					 - URL
//  ДополнительныеПараметры	 - Структура, Произвольный	 - Дополнительные параметры
//  Сессия	 - Структура: см. НоваяСессия - Дополнительные параметры
// 
// Возвращаемое значение:
//  Структура - Настройки подключения:
//  * Таймаут - Число -
//  * РазрешитьПеренаправление - Булево -
//  * ПроверятьSSL - Булево -
//  * КлиентскийСертификатSSL - Булево, СертификатКлиентаФайл, СертификатКлиентаWindows -
//  * Прокси - Неопределено, ИнтернетПрокси -
//  * МаксимальноеКоличествоПовторов - Число -
//  * ПовторятьДляКодовСостояний - Булево -
//  * КоэффициентЭкспоненциальнойЗадержки - Число -
//  * МаксимальноеВремяПовторов - Число -
//
Функция НастройкиПодключенияЛок(Метод, URL, ДополнительныеПараметры, Сессия)

	РазрешитьПеренаправление = ЗначениеПоКлючу(ДополнительныеПараметры, "РазрешитьПеренаправление",
		ВРег(Метод) <> "HEAD");
	ПроверятьSSL = ЗначениеПоКлючу(ДополнительныеПараметры, "ПроверятьSSL", Истина);
	КлиентскийСертификатSSL = ЗначениеПоКлючу(ДополнительныеПараметры, "КлиентскийСертификатSSL");
	ПроксиБСП = ПроксиПоУмолчанию(URL);
	ПроксиСессии = ЗначениеПоКлючу(Сессия, "Прокси", ПроксиБСП);
	Прокси = ЗначениеПоКлючу(ДополнительныеПараметры, "Прокси", ПроксиСессии);
	МаксимальноеКоличествоПовторов = ЗначениеПоКлючу(ДополнительныеПараметры, "МаксимальноеКоличествоПовторов", 0);
	ПовторятьДляКодовСостояний = ЗначениеПоКлючу(ДополнительныеПараметры, "ПовторятьДляКодовСостояний", Неопределено);
	КоэффициентЭкспоненциальнойЗадержки = ЗначениеПоКлючу(ДополнительныеПараметры,
		"КоэффициентЭкспоненциальнойЗадержки", 1);
	МаксимальноеВремяПовторов = ЗначениеПоКлючу(ДополнительныеПараметры, "МаксимальноеВремяПовторов", 600);

	Настройки = Новый Структура;
	Настройки.Вставить("Таймаут", Таймаут(ДополнительныеПараметры));
	Настройки.Вставить("РазрешитьПеренаправление", РазрешитьПеренаправление);
	Настройки.Вставить("ПроверятьSSL", ПроверятьSSL);
	Настройки.Вставить("КлиентскийСертификатSSL", КлиентскийСертификатSSL);
	Настройки.Вставить("Прокси", Прокси);
	Настройки.Вставить("МаксимальноеКоличествоПовторов", МаксимальноеКоличествоПовторов);
	Настройки.Вставить("ПовторятьДляКодовСостояний", ПовторятьДляКодовСостояний);
	Настройки.Вставить("КоэффициентЭкспоненциальнойЗадержки", КоэффициентЭкспоненциальнойЗадержки);
	Настройки.Вставить("МаксимальноеВремяПовторов", МаксимальноеВремяПовторов);

	Возврат Настройки;

КонецФункции

// Ищет в пуле или создает новое HTTPСоединение.
//
// Параметры:
//  ПараметрыСоединения - Структура: см. РазобратьURL - Параметры соединения
//  АутентификацияЛок - Неопределено, Структура - Аутентификация:
//  * ИспользоватьАутентификациюОС - Булево - включает использование аутентификации NTLM или Negotiate.
//                                   Значение по умолчанию = Ложь.
//  * Тип - Строка - тип аутентификации. Для Basic Тип можно не указывать.
//                                   Если Тип = Digest или Basic
//  * Пользователь - Строка - имя пользователя.
//  * Пароль - Строка - пароль пользователя.
//  ДополнительныеПараметры - Структура - Дополнительные параметры
//  Сессия - Структура: См. СоздатьСессию - 
// 
// Возвращаемое значение:
//  HTTPСоединение - Соединение
//
Функция Соединение(ПараметрыСоединения, АутентификацияЛок, ДополнительныеПараметры, Сессия)

	Если Не ЗначениеЗаполнено(ПараметрыСоединения.Порт) Тогда
		
		Если ПараметрыСоединения.Схема = "https" Тогда
			
			ПараметрыСоединения.Порт = 443;
			
		Иначе
			
			ПараметрыСоединения.Порт = 80;
			
		КонецЕсли;
		
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	
	Если ПараметрыСоединения.Схема = "https" Тогда
		
		ЗащищенноеСоединение = ОбъектЗащищенногоСоединения(ДополнительныеПараметры);
		
	КонецЕсли;

	ПользовательЛок = "";
	ПарольЛок = "";
	
	Если ЗначениеЗаполнено(АутентификацияЛок) Тогда
		
		Если АутентификацияЛок.Свойство("Пользователь") И АутентификацияЛок.Свойство("Пароль") Тогда
			
			ПользовательЛок = АутентификацияЛок.Пользователь;
			ПарольЛок = АутентификацияЛок.Пароль;
			
		КонецЕсли;
		
	КонецЕсли;

	ИспользоватьАутентификациюОС = АутентификацияЛок.Свойство("ИспользоватьАутентификациюОС")
		И АутентификацияЛок.ИспользоватьАутентификациюОС = Истина;

	ПараметрыДляРасчетаИдентификатора = Новый Массив; // Массив из Произвольный
	ПараметрыДляРасчетаИдентификатора.Добавить(ПараметрыСоединения.Сервер);
	ПараметрыДляРасчетаИдентификатора.Добавить(ПараметрыСоединения.Порт);
	ПараметрыДляРасчетаИдентификатора.Добавить(ПользовательЛок);
	ПараметрыДляРасчетаИдентификатора.Добавить(ПарольЛок);
	ПараметрыДляРасчетаИдентификатора.Добавить(ДополнительныеПараметры.Таймаут);
	ПараметрыДляРасчетаИдентификатора.Добавить(ИспользоватьАутентификациюОС);
	ПараметрыДляРасчетаИдентификатора.Добавить(ЗащищенноеСоединение);
	ПараметрыДляРасчетаИдентификатора.Добавить(ДополнительныеПараметры.Прокси);

	ПулСоединений = Сессия.СлужебныеДанные.ПулСоединений;

	ИдентификаторСоединения = ИдентификаторСоединения(ПараметрыДляРасчетаИдентификатора);

	Если ПулСоединений.Получить(ИдентификаторСоединения) = Неопределено Тогда
		
		Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавно8_3_6Лок() Тогда
			
			Если Не КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавноЛок("8.3.7") Тогда
				
				ИспользоватьАутентификациюОС = Неопределено;
				
			КонецЕсли;

			НовоеСоединение = КонтурДиадокКоннекторHTTPСлужебный83.HTTPСоединениеЛок(
				ПараметрыСоединения.Сервер,
				ПараметрыСоединения.Порт,
				ПользовательЛок,
				ПарольЛок,
				ДополнительныеПараметры.Прокси,
				ДополнительныеПараметры.Таймаут,
				ЗащищенноеСоединение,
				ИспользоватьАутентификациюОС);
			
		Иначе
			
			НовоеСоединение = Новый HTTPСоединение(
				ПараметрыСоединения.Сервер,
				ПараметрыСоединения.Порт,
				ПользовательЛок,
				ПарольЛок,
				ДополнительныеПараметры.Прокси,
				ДополнительныеПараметры.Таймаут,
				ЗащищенноеСоединение);
			
		КонецЕсли;
		
		ПулСоединений.Вставить(ИдентификаторСоединения, НовоеСоединение);
		
	КонецЕсли;

	Возврат ПулСоединений[ИдентификаторСоединения];

КонецФункции

Функция ИдентификаторСоединения(ПараметрыСоединения)

	ПараметрыДляРасчетаИдентификатора = Новый Массив; // Массив из Строка

	Для Каждого Элемент Из ПараметрыСоединения Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		
		Если ТипЭлемента = Тип("ИнтернетПрокси") Тогда
			
			ПараметрыДляРасчетаИдентификатора.Добавить(
				КонтурДиадокСтдСтрКлиентСервер.СтрСоединитьЛок(Элемент.НеИспользоватьПроксиДляАдресов, ""));
			
			ПараметрыДляРасчетаИдентификатора.Добавить(XMLСтрока(Элемент.НеИспользоватьПроксиДляЛокальныхАдресов));
			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Пользователь);
			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Пароль);

			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Сервер());
			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Сервер("http"));
			ПараметрыДляРасчетаИдентификатора.Добавить(Элемент.Сервер("https"));
			
		ИначеЕсли ТипЭлемента = Тип("ЗащищенноеСоединениеOpenSSL") Тогда
			
			Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавно8_3_6Лок() Тогда
				
				// Для упрощения будет считать, что сертификаты в рамках сессии не меняются
				Если Элемент.СертификатКлиента = Неопределено Тогда
					
					ПараметрыДляРасчетаИдентификатора.Добавить("");
					
				Иначе
					
					ПараметрыДляРасчетаИдентификатора.Добавить(Строка(ТипЗнч(Элемент.СертификатКлиента)));
					
				КонецЕсли;
				
				Если Элемент.СертификатыУдостоверяющихЦентров = Неопределено Тогда
					
					ПараметрыДляРасчетаИдентификатора.Добавить("");
					
				Иначе
					
					ПараметрыДляРасчетаИдентификатора.Добавить(Строка(ТипЗнч(Элемент.СертификатыУдостоверяющихЦентров)));
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			ПараметрыДляРасчетаИдентификатора.Добавить(XMLСтрока(Элемент));
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ПростойХэшЛок(КонтурДиадокСтдСтрКлиентСервер.СтрСоединитьЛок(ПараметрыДляРасчетаИдентификатора, ""));

КонецФункции

// Расчет простого хеша строки
// Ссылки:
// https://www.strchr.com/hash_functions
// https://infostart.ru/1c/tools/70030/
// 
// Параметры:
//  СтрокаХэш - Строка - исходный текст
//  hash - Число - начальное значение hash начальное значение hash
//  M - Число - множитель (влияет накачество хэш и производительность)
//  по умолчанию M = 31; Умножитель
//  TABLE_SIZE - Число - - размер получаемого ключа, как Максимальная величина + 1
//  по умолчанию TABLE_SIZE = 18446744073709551615 (64 бита)
// 
// Возвращаемое значение:
//  Число - Простой хэш лок
//  
Функция ПростойХэшЛок(СтрокаХэш, hash = 0, M = 31, TABLE_SIZE = 18446744073709551616)
	 
	ДлинаСтроки = СтрДлина(СтрокаХэш);
	
	Для Инд = 1 По ДлинаСтроки Цикл
		
		hash = M * hash + КодСимвола(Сред(СтрокаХэш, Инд, 1));
		
	КонецЦикла;
	
	Возврат hash % TABLE_SIZE;
	
КонецФункции

Функция ОбъектЗащищенногоСоединения(ДополнительныеПараметры)
	
	Если КонтурДиадокКоннекторHTTPСлужебныйПовтИсп.ВерсияСовместимостиБольшеРавноЛок("8.3.8") Тогда
		
		Возврат КонтурДиадокКоннекторHTTPСлужебный83.ОбъектЗащищенногоСоединенияЛок(ДополнительныеПараметры);
		
	Иначе
		
		Возврат Новый ЗащищенноеСоединениеOpenSSL;
		
	КонецЕсли;
	
КонецФункции

Функция Таймаут(ДополнительныеПараметры)

	Если ДополнительныеПараметры.Свойство("Таймаут") И ЗначениеЗаполнено(ДополнительныеПараметры.Таймаут) Тогда
		
		Таймаут = ДополнительныеПараметры.Таймаут;
		
	Иначе
		
		Таймаут = СтандартныйТаймаут();
		
	КонецЕсли;

	Возврат Таймаут;

КонецФункции

