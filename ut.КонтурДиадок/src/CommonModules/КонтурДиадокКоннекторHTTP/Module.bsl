			ЗаписатьBOM);
		
	Иначе
		
		Возврат КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПолучитьДвоичныеДанныеИзСтрокиЛок(ВходящаяСтрока,
			Кодировка, ЗаписатьBOM);
		
	КонецЕсли;

КонецФункции

// Возвращает структурированное представление URL.
//
// Параметры:
//  URL - Строка - URL ресурса, к которому будет отправлен запрос.
// 
// Возвращаемое значение:
//  Структура: см. НовыйСтруктураURL() - структура URL
//
Функция РазобратьURL(Знач URL) Экспорт

	Схема = "";
	Путь = "";
	АутентификацияЛок = НовыйАутентификация();
	СерверЛок = "";
	ПортСтрока = "";
	Фрагмент = "";

	ДопустимыеСхемы = ДопустимыеСхемы();

	URLБезСхемы = URL;
	РазбитьСтрокуПоРазделителюЛок(Схема, URLБезСхемы, "://");
	
	Если ДопустимыеСхемы.Найти(НРег(Схема)) <> Неопределено Тогда
		
		URL = URLБезСхемы;
		
	Иначе
		
		Схема = "";
		
	КонецЕсли;
	
	ДопустимыеРазделители = КонтурДиадокСтдСтрКлиентСервер.СтрРазделитьЛок("/,?,#", ",");
	
	URLВМассиве = РазделитьПоПервомуНайденномуРазделителюЛок(URL, ДопустимыеРазделители);
	
	URL = URLВМассиве[0];
	
	Если ЗначениеЗаполнено(URLВМассиве[2]) Тогда
		
		Путь = URLВМассиве[2] + URLВМассиве[1];
		
	КонецЕсли;

	АутентификацияСтрока = "";
	РазбитьСтрокуПоРазделителюЛок(АутентификацияСтрока, URL, "@");
	
	Если ЗначениеЗаполнено(АутентификацияСтрока) Тогда
		
		АутентификацияЧасти = КонтурДиадокСтдСтрКлиентСервер.СтрРазделитьЛок(АутентификацияСтрока, ":");
		
		АутентификацияЛок.Пользователь = АутентификацияЧасти[0];
		
		Если АутентификацияЧасти.Количество() > 1 Тогда
			
			АутентификацияЛок.Пароль = АутентификацияЧасти[1];
			
		КонецЕсли;
		
	КонецЕсли;

	// IPv6
	РазбитьСтрокуПоРазделителюЛок(СерверЛок, URL, "]");
	
	Если ЗначениеЗаполнено(СерверЛок) Тогда
		
		СерверЛок = СерверЛок + "]";
		
	КонецЕсли;

	URL = СтрЗаменить(URL, "/", "");

	РазбитьСтрокуПоРазделителюЛок(ПортСтрока, URL, ":", Истина);

	Если Не ЗначениеЗаполнено(СерверЛок) Тогда
		
		СерверЛок = URL;
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ПортСтрока) Тогда
		
		Порт = Число(ПортСтрока);
		
	Иначе
		
		Порт = 0;
		
	КонецЕсли;

	РазбитьСтрокуПоРазделителюЛок(Фрагмент, Путь, "#", Истина);

	ПараметрыЗапроса = ЗаполнитьПараметрыЗапросаЛок(Путь);

	Если Не ЗначениеЗаполнено(Схема) Тогда
		
		Схема = "http";
		
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Путь) Тогда
		
		Путь = "/";
		
	КонецЕсли;

	Результат = НовыйСтруктураURL();
	Результат.Схема = Схема;
	Результат.Аутентификация = АутентификацияЛок;
	Результат.Сервер = СерверЛок;
	Результат.Порт = Порт;
	Результат.Путь = Путь;
	Результат.ПараметрыЗапроса = ПараметрыЗапроса;
	Результат.Фрагмент = Фрагмент;

	Возврат Результат;

КонецФункции

// Возвращает структурированное представление URL.
//
// Параметры:
//  СтруктураURL - Структура: см. НовыйСтруктураURL() - Структура URL ресурса
// 
// Возвращаемое значение:
//  Строка - URL
//
Функция СобратьURL(СтруктураURL) Экспорт
	
	Результат = "";
	
	Если ДопустимыеСхемы().Найти(СтруктураURL.Схема) = Неопределено Тогда
		Результат = "http";
	Иначе
		Результат = СтруктураURL.Схема;
	КонецЕсли;
	
	Результат = Результат + "://";
	
	АутентификацияЛок = СтруктураURL.Аутентификация;
	
	Если ЗначениеЗаполнено(АутентификацияЛок) Тогда
		Если ЗначениеЗаполнено(АутентификацияЛок.Пользователь) Тогда

			Результат = Результат + АутентификацияЛок.Пользователь + ":" + АутентификацияЛок.Пароль + "@";

		КонецЕсли;
	КонецЕсли;
	
	Результат = Результат + СтруктураURL.Сервер;
	
	Если ЗначениеЗаполнено(СтруктураURL.Порт) Тогда
		
		Результат = Результат + ":" + ПолучитьПредставлениеЧислаЛок(СтруктураURL.Порт);
		
	КонецЕсли;
	
	Результат = Результат +
		СформироватьАдресРесурса(СтруктураURL.Путь, СтруктураURL.ПараметрыЗапроса, СтруктураURL.Фрагмент);
	
	Возврат Результат;

КонецФункции

// Возвращает структуру именованных кодов состояний HTTP.
// 
// Возвращаемое значение:
//  Структура - именованные коды состояний HTTP:
//	* Продолжай_100 - Число - Код 100 Continue
//	* ПереключениеПротокола_101 - Число - Код 101 Switching Protocols
//	* ИдетОбработка_102 - Число - Код 102 Processing
//	* РанняяМетаинформация_103 - Число - Код 103 Early Hints
//  * ОК_200 - Число - Код 200 OK
//	* Создано_201 - Число - Код 201 Created
//	* Принято_202 - Число - Код Accepted
//	* ИнформацияНеАвторитетна_203 - Число - Код 203 Non-Authoritative Information
//	* НетСодержимого_204 - Число - Код 204 No Content
//	* СброситьСодержимое_205 - Число - Код 205 Reset Content
//	* ЧастичноеСодержимое_206 - Число - Код 206 Partial Content
//	* Многостатусный_207 - Число - Код 207 Multi-Status
//	* УжеСообщалось_208 - Число - Код 208 Already Reported
//	* ИспользованоIM_226 - Число - Код 226 IM Used
//	* МножествоВыборов_300 - Число - Код 300 Multiple Choices
//	* ПеремещеноНавсегда_301 - Число - Код 301 Moved Permanently
//	* ПеремещеноВременно_302 - Число - Код 302 Moved Temporarily
//	* СмотретьДругое_303 - Число - Код 303 See Other
