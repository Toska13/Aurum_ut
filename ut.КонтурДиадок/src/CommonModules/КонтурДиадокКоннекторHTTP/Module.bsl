Функция NEL_ПодготовитьURL(URL)
	
	СтруктураURL = РазобратьURL(URL);

	ПодготовленныйURL = СтруктураURL.Схема + "://";
	ПодготовленныйURL = ПодготовленныйURL + СтруктураURL.Сервер;
	
	Если ЗначениеЗаполнено(СтруктураURL.Порт) Тогда
		
		ПодготовленныйURL = ПодготовленныйURL + ":" + ПолучитьПредставлениеЧислаЛок(СтруктураURL.Порт);
		
	КонецЕсли;

	ПодготовленныйURL = ПодготовленныйURL + СтруктураURL.Путь;

	Возврат ПодготовленныйURL;
	
КонецФункции

// NEL код состояния для отправки ошибки.
// 
// Параметры:
//  КодСостояния - Число - Код состояния
// 
// Возвращаемое значение:
//  Булево - NEL код состояния для отправки ошибки
//  
Функция NEL_КодСостоянияДляОтправкиОшибки(КодСостояния)
	
	Если КодСостояния >= 400
		И КодСостояния <= 599 Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// NEL код состояния для отправки успеха.
// 
// Параметры:
//  КодСостояния - Число - Код состояния
// 
// Возвращаемое значение:
//  Булево - NEL код состояния для отправки успеха
//  
Функция NEL_КодСостоянияДляОтправкиУспеха(КодСостояния)
	
	Если КодСостояния >= 200
		И КодСостояния <= 299 Тогда
			
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// NEL заполнить Структуру NEL.
// 
// Параметры:
//  Сессия - Структура: См. СоздатьСессию - 
//  ЗначениеNEL - Строка - Значение NEL - 
//  ЗначениеReportTo - Строка - Значение report-to
//  
Процедура NEL_ЗаполнитьСтруктуруNELИReportTo(Сессия, ЗначениеNEL, ЗначениеReportTo)
	
	СтруктураNEL = NEL_СоздатьЭндпоинтОтчетов();
	СтруктураReportTo = NEL_СоздатьГруппуЭндпоинтов();
	ФлагЗаполнения = Истина;
	
	Попытка
		
		ОбъектNEL = JsonВОбъект(ЗначениеNEL);
		
	Исключение
		
		// Ошибка разбора ЗначениеNEL
		ФлагЗаполнения = Ложь;
		
	КонецПопытки;
	
	Если ФлагЗаполнения Тогда
		
		Попытка
			
			ОбъектReportTo = JsonВОбъект(ЗначениеReportTo);
			
		Исключение
			
			// Ошибка разбора ЗначениеReportTo
			ФлагЗаполнения = Ложь;
			
		КонецПопытки;
		
	КонецЕсли;

	Если ФлагЗаполнения Тогда
		
		КонтурДиадокСтдКоллекцииКлиентСервер.ДополнитьСтруктуруЛок(СтруктураNEL, ОбъектNEL, Истина);
		
		Сессия.NELПолитика.NEL = СтруктураNEL;
		
		КонтурДиадокСтдКоллекцииКлиентСервер.ДополнитьСтруктуруЛок(СтруктураReportTo, ОбъектReportTo, Истина);
		
		Сессия.NELПолитика.report_to = СтруктураReportTo;
		
	КонецЕсли;
	
КонецПроцедуры

