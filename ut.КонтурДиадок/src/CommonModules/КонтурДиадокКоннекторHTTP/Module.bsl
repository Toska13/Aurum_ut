// NEL отправить отчет.
// 
// Параметры:
//  Сессия - Структура: См. СоздатьСессию - Сессия
//  ПодготовленныйЗапрос - Структура: см. ПодготовитьЗапрос - Подготовленный запрос
//  ОшибкаВыполненияЗапроса - ИнформацияОбОшибке, Неопределено - Ошибка
//  выполнения запроса
//  ПодготовленныйОтвет - Неопределено, Структура: См. НовыйОтвет - Подготовленный ответ
//  ДлительностьМс - Число - Длительность запроса милисекунд
// Возвращаемое значение:
//  Структура: см. NEL_СоздатьОтчет, Неопределено - Описание ошибки
// 
Функция NEL_СформироватьОтчет(Сессия, ПодготовленныйЗапрос, ОшибкаВыполненияЗапроса = Неопределено,
	ПодготовленныйОтвет = Неопределено, ДлительностьМс = 0)
	
	NEL_ОписаниеОшибки = Неопределено;
	
	NELПолитика = Сессия.NELПолитика; // Структура: см. NEL_СоздатьПолитику
	Структура_NEL = NELПолитика.NEL; // Структура: см. NEL_СоздатьЭндпоинтОтчетов
	Структура_report_to = NELПолитика.report_to; // Структура: см. NEL_СоздатьГруппуЭндпоинтов
	NEL_Отправлять = Не NELПолитика.NEL_НеОтправлять;
	ФлагОтправкиОтчета = ЗначениеЗаполнено(Структура_NEL) И ЗначениеЗаполнено(Структура_report_to) И NEL_Отправлять;
	СтруктураURL = РазобратьURL(ПодготовленныйЗапрос.URL); // Структура: см. РазобратьURL

	Если ФлагОтправкиОтчета Тогда
		
		// Проверяем что энпоинт есть в группе
		
		Если Не Структура_report_to.Свойство("group") Тогда
			
			ФлагОтправкиОтчета = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ФлагОтправкиОтчета Тогда
		
		Если Не Структура_report_to.group = Структура_NEL.report_to Тогда
			
			ФлагОтправкиОтчета = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ФлагОтправкиОтчета Тогда
		
		Если NELПолитика.NEL_Сессия = Неопределено Тогда
			
			NEL_СоздатьСессию(NELПолитика, СтруктураURL.Сервер, Сессия.Прокси);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ФлагОтправкиОтчета Тогда
		
		Если Структура_report_to.failure_fraction > 0 Тогда
			
			Если Не ОшибкаВыполненияЗапроса = Неопределено Тогда
				ПолитикаВключаяПоддомены = Структура_report_to.include_subdomains;
				ЭтотДоменЯвляетсяПоддоменом = ДоменЯвляетсяПоддоменом(СтруктураURL.Сервер, NELПолитика.NEL_Домен);
				
				// ошибка на этапе отправки
				NEL_ОписаниеОшибки = NEL_ПолучитьОписаниеОшибкиОтправки(ПодготовленныйЗапрос, ОшибкаВыполненияЗапроса,
					ДлительностьМс, ПолитикаВключаяПоддомены, ЭтотДоменЯвляетсяПоддоменом);
				
			ИначеЕсли Не ПодготовленныйОтвет = Неопределено
				И Не ПодготовленныйОтвет.ЭтоРедирект
				И NEL_КодСостоянияДляОтправкиОшибки(ПодготовленныйОтвет.КодСостояния) Тогда
				
				ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().http_error;
				NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplicationСОтветом(ПодготовленныйЗапрос, ПодготовленныйОтвет,
					ДлительностьМс, ТипОшибкиNEL);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Структура_report_to.success_fraction > 0 Тогда
			
			Если ОшибкаВыполненияЗапроса = Неопределено
				И Не ПодготовленныйОтвет = Неопределено
				И NEL_КодСостоянияДляОтправкиУспеха(ПодготовленныйОтвет.КодСостояния) Тогда
				
				ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().ok;
				NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplicationСОтветом(ПодготовленныйЗапрос, ПодготовленныйОтвет,
					ДлительностьМс, ТипОшибкиNEL);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат NEL_ОписаниеОшибки;
	
КонецФункции

// NEL описание ошибки отправки.
// 
// Параметры:
//  ПодготовленныйЗапрос - Структура: см. ПодготовитьЗапрос - Подготовленный запрос
//  ОшибкаВыполненияЗапроса - ИнформацияОбОшибке, Неопределено - Ошибка выполнения запроса
//  ДлительностьМс - Число - Длительность выполнения запроса мс
//  ПолитикаВключаяПоддомены - Булево - Политика включая поддомены
//  ДоменЯвляетсяПоддоменом - Булево - Домен является поддоменом
// 
// Возвращаемое значение:
//  Структура: см. NEL_СоздатьОтчет - Описание ошибки отправки
//
Функция NEL_ПолучитьОписаниеОшибкиОтправки(ПодготовленныйЗапрос, ОшибкаВыполненияЗапроса, ДлительностьМс,
	ПолитикаВключаяПоддомены, ДоменЯвляетсяПоддоменом)
	
	ОписаниеПричиныОшибки = "";
	Если ОшибкаВыполненияЗапроса.Причина = Неопределено Тогда
		
		ОписаниеПричиныОшибки = ОшибкаВыполненияЗапроса.Описание;
		
	Иначе
		
		ОписаниеПричиныОшибки = ОшибкаВыполненияЗапроса.Причина.Описание;
		
	КонецЕсли;
	
	Если NEL_ЭтоDnsNameNotResolved(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиDns().dns_name_not_resolved;
		
		Если Не ПолитикаВключаяПоддомены Тогда
			
			Если ДоменЯвляетсяПоддоменом Тогда
				
				NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиDns(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);
				
			КонецЕсли;
			
		Иначе
			
			NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиDns(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);
			
		КонецЕсли;
		
	ИначеЕсли NEL_ЭтоHttpResponseInvalid(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().http_response_invalid;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplication(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);
		
	ИначеЕсли NEL_ЭтоHttpResponseRedirectLoop(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().http_response_redirect_loop;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplication(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);
		
	ИначеЕсли NEL_ЭтоHttpProtocolError(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().http_protocol_error;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplication(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);
		
	ИначеЕсли NEL_ЭтоTlsCertInvalid(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиConnection().tls_cert_invalid;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиConnection(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);

	ИначеЕсли NEL_ЭтоTcpTimedOut(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиConnection().tcp_timed_out;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиConnection(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);

	ИначеЕсли NEL_ЭтоTcpRefused(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиConnection().tcp_refused;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиConnection(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);

	ИначеЕсли NEL_ЭтоHttpFailed(ОписаниеПричиныОшибки) Тогда
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().http_failed;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplication(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);
		
	Иначе
		
		ТипОшибкиNEL = NEL_ДопустимыеОшибкиApplication().unknown;
		NEL_ОписаниеОшибки = NEL_ОписаниеОшибкиApplication(ПодготовленныйЗапрос, ДлительностьМс, ТипОшибкиNEL);

	КонецЕсли;
	
	Возврат NEL_ОписаниеОшибки;
	
КонецФункции

// NEL создать сессию.
// 
// Параметры:
//  NELПолитика - Структура: см. NEL_СоздатьПолитику - Политика NEL
//  NEL_Сервер - Строка - сервер NEL
//  НастройкиПрокси - ИнтернетПрокси, Неопределено - Настройки прокси
//
Процедура NEL_СоздатьСессию(NELПолитика, NEL_Сервер, НастройкиПрокси)
	
	NEL_Сессия = СоздатьСессию();
	NEL_Сессия.ПроверятьSSL = Ложь;
	NEL_Сессия.Заголовки = NEL_ЗаголовкиПоУмолчанию();
	NEL_Сессия.NELПолитика.NEL_НеОтправлять = Истина;
	NEL_Сессия.Прокси = НастройкиПрокси;
	
	NELПолитика.NEL_Домен = NEL_Сервер;
	NELПолитика.NEL_Сессия = NEL_Сессия;
	
КонецПроцедуры

// NEL отправить описание ошибки.
// 
// Параметры:
//  NEL_ОписаниеОшибки - Структура: см. NEL_СоздатьОтчет - NEL описание ошибки
//  NELПолитика - Структура: см. NEL_СоздатьПолитику - Политика NEL
//  
Процедура NEL_ОтправитьОписаниеОшибки(NEL_ОписаниеОшибки, NELПолитика)
	
	NEL_ДополнительныеПараметры = NEL_СоздатьДополнительныеПараметры();

	Структура_report_to = NELПолитика.report_to;
	
	Для Каждого Эндпоинт Из Структура_report_to.endpoints Цикл
		
		ОтветПолучен = Истина;
		Эндпоинт_url = ЗначениеПоКлючу(Эндпоинт, "url", ""); // Строка
		
		Попытка
			
			Ответ = PostJsonБезПреобразованияОтвета(Эндпоинт_url, NEL_ОписаниеОшибки, NEL_ДополнительныеПараметры,
				NELПолитика.NEL_Сессия);
			
		Исключение
			
			ОтветПолучен = Ложь;
			
		КонецПопытки;

		Если ОтветПолучен Тогда
			
			NELПолитика.NEL_ПоследнийОтчет = NEL_ОписаниеОшибки;
			
			Если NEL_КодСостоянияДляОтправкиУспеха(Ответ.КодСостояния) Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

