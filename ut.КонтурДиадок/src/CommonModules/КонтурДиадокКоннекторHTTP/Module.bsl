// Конструктор параметров.
// 
// Возвращаемое значение:
//  Структура - позволяет задать дополнительные параметры:
//  * Заголовки - Соответствие из Строка: См. ЗаголовкиПоУмолчанию - 
//  * Аутентификация - Неопределено, Структура: См. СоздатьСессию.Аутентификация - 
//  * Прокси - Неопределено, ИнтернетПрокси: См. СоздатьСессию.Прокси - 
//  * ПараметрыЗапроса - Неопределено, Структура, Соответствие из Строка -  СоздатьСессию.ПараметрыЗапроса.
//  * ПроверятьSSL - Булево , СертификатыУдостоверяющихЦентровФайл - СоздатьСессию.ПроверятьSSL.
//  * КлиентскийСертификатSSL - СертификатКлиентаФайл, СертификатКлиентаWindows, Неопределено -
//  Значение по умолчанию: Неопределено.
//  * Cookies - Соответствие из Строка: См. СоздатьСессию.Cookies.
//  * Таймаут - Число -
//      время ожидания осуществляемого соединения и операций, в секундах.
//      Значение по умолчанию - 30 сек.
//  * РазрешитьПеренаправление - Булево - 
//      Истина = редиректы будут автоматически разрешены,
//      Ложь = будет выполнен только один запрос к серверу.
//  * Json - Неопределено, Структура, Соответствие из Произвольный - данные, которые необходимо сериализовать в JSON.
//  * ПараметрыПреобразованияJSON - Структура: См. ПолучитьПараметрыПреобразованияJSONПоУмолчанию -
//  * Данные - Неопределено, Строка, ДвоичныеДанные - произвольные данные, которые необходимо отправить в запросе.
//  * Файлы - Массив из Структура - файлы, к отправке
//  * МаксимальноеКоличествоПовторов - Число -
//      количество повторных попыток соединения/отправки запроса.
//      Между попытками выполняется задержка, растущая по экспоненте.
//      Но если код состояния один из 413, 429, 503
//      и в ответе есть заголовок Retry-After,
//      то время задержки формируется из значения этого заголовка
//      Значение по умолчанию: 0 - повторы не выполняются.
//  * МаксимальноеВремяПовторов - Число -
//      максимальное общее время (в секундах) отправки запроса с учетом повторов.
//      Значение по умолчанию: 600.
//  * КоэффициентЭкспоненциальнойЗадержки - Число -
//      коэффициент изменения экспоненциальной задержки.
//      1 формирует последовательность задержек: 1, 2, 4, 8 и т.д.
//      2 формируется последовательность задержек: 2, 4, 8, 16 и т.д.
//      Значение по умолчанию: 1.
//  * ПовторятьДляКодовСостояний - Неопределено, Массив из Число -
//      повторы будут выполняться для кодов состояний >= 500.
//      Значение по умолчанию: Неопределено.
//
Функция НовыеПараметры() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Заголовки", Новый Соответствие);
	Параметры.Вставить("Аутентификация", Неопределено);
	Параметры.Вставить("Прокси", Неопределено);
	Параметры.Вставить("ПараметрыЗапроса", Неопределено);
	Параметры.Вставить("ПроверятьSSL", Истина);
	Параметры.Вставить("КлиентскийСертификатSSL", Неопределено);
	Параметры.Вставить("Cookies", Новый Соответствие);
	Параметры.Вставить("Таймаут", СтандартныйТаймаут());
	Параметры.Вставить("РазрешитьПеренаправление", Истина);
	Параметры.Вставить("Json", Неопределено);
	Параметры.Вставить("ПараметрыПреобразованияJSON", ПолучитьПараметрыПреобразованияJSONПоУмолчанию());
	Параметры.Вставить("Данные", Неопределено);
	Параметры.Вставить("Файлы", Новый Массив);
	Параметры.Вставить("МаксимальноеКоличествоПовторов", 0);
	Параметры.Вставить("МаксимальноеВремяПовторов", 600);
	Параметры.Вставить("КоэффициентЭкспоненциальнойЗадержки", 1);
	Параметры.Вставить("ПовторятьДляКодовСостояний", Неопределено);

	Возврат Параметры;

КонецФункции

// Конструктор описания отправляемого файла.
//
// Параметры:
//  Имя - Строка - имя поля формы.
//  ИмяФайла - Строка - имя файла.
//  Данные - ДвоичныеДанные, Неопределено - двоичные данные файла.
//  Тип - Строка - MIME-тип файла
// 
// Возвращаемое значение:
//  Структура - Новый отправляемый файл:
//  * Имя - Строка - имя поля формы.
//  * ИмяФайла - Строка - имя файла.
//  * Данные - ДвоичныеДанные - двоичные данные файла.
//  * Тип - Строка, Неопределено - MIME-тип файла.
//  * Заголовки - Соответствие из Строка - HTTP заголовки запроса.
//
Функция НовыйОтправляемыйФайл(Имя, ИмяФайла, Данные = Неопределено, Тип = Неопределено) Экспорт
	
	Файл = Новый Структура;
	Файл.Вставить("Имя", Имя);
	Файл.Вставить("ИмяФайла", ИмяФайла);
	
	Если Данные = Неопределено Тогда
		Файл.Вставить("Данные", Base64Значение(""));
	Иначе
		Файл.Вставить("Данные", Данные);
	КонецЕсли;
	
	Файл.Вставить("Тип", Тип);
	Файл.Вставить("Заголовки", Новый Соответствие);

	//@skip-check constructor-function-return-section
	Возврат Файл;

КонецФункции

// Создает объект для хранения параметров сессии.
// 
// Возвращаемое значение:
//  Структура - параметры сессии:
//  * Заголовки - Соответствие из Строка - HTTP заголовки запроса.
//  * Аутентификация - Неопределено, Структура - параметры аутентификации запроса:
//  ** ИспользоватьАутентификациюОС - Булево - включает использование аутентификации NTLM или Negotiate.
//  Значение по умолчанию: Ложь.
//  ** Тип - Строка - тип аутентификации. Для Basic Тип можно не указывать.
//  Если Тип = Digest или Basic тогда.
//  ** Пользователь - Строка - имя пользователя.
//  ** Пароль - Строка - пароль пользователя.
//  * Прокси - ИнтернетПрокси, Неопределено - параметры прокси, которые будут использованы при отправке запроса.
//  Значение по умолчанию: Неопределено. При этом если в конфигурации используется БСП,
//  то значения прокси будет взято из БСП.
//  * ПараметрыЗапроса - Структура, Соответствие из Строка - параметры, которые будут отправлены в URL (часть после ?):
//  ** Ключ - Строка - ключ параметра в URL.
//  ** Значение - Строка, Число, Булево, Дата - значение параметра URL
//  * ПроверятьSSL - Булево, СертификатыУдостоверяющихЦентровФайл - Ложь - проверка сертификата сервера не выполняется.
//  * КлиентскийСертификатSSL - СертификатКлиентаФайл - 
//                            - СертификатКлиентаWindows -
//                            - Неопределено - Значение по умолчанию
//  * МаксимальноеКоличествоПеренаправлений - Число - максимальное количество редиректов. Защита от зацикливания.
//  Значение по умолчанию = 30.
//  * Cookies - Соответствие из Строка - хранилище cookies:
//  ** Ключ - Строка - Имя cookie
//  ** Значение - Строка - значение cookie
//  * СлужебныеДанные - Структура: см. СоздатьСлужебныеДанные - Служебные данные
//  * Лог - Неопределено, ТекстовыйДокумент - Текстовый документ, куда будет писаться Лог.
//  Если Неопределено, то лог не ведется.
//	* NELПолитика - Структура: см. NEL_СоздатьПолитику - Политика NEL
//
Функция СоздатьСессию() Экспорт

	Сессия = Новый Структура;
	Сессия.Вставить("Заголовки", ЗаголовкиПоУмолчанию());
	Сессия.Вставить("Аутентификация", Неопределено);
	Сессия.Вставить("Прокси", Неопределено);
	Сессия.Вставить("ПараметрыЗапроса", Новый Соответствие);
	Сессия.Вставить("ПроверятьSSL", Истина);
	Сессия.Вставить("КлиентскийСертификатSSL", Неопределено);
	Сессия.Вставить("МаксимальноеКоличествоПеренаправлений", МаксимальноеКоличествоПеренаправлений());
	Сессия.Вставить("Cookies", Новый Соответствие);
	Сессия.Вставить("СлужебныеДанные", СоздатьСлужебныеДанные());
	Сессия.Вставить("Лог", Неопределено);
	Сессия.Вставить("NELПолитика", NEL_СоздатьПолитикуПоУмолчанию());

	Возврат Сессия;

КонецФункции

// Создать индивидуальные настройки прокси для протокола.
// 
// Возвращаемое значение:
//  Структура - настройки прокси для протокола:
// * Сервер - Строка - Сервер прокси
// * Порт - Неопределено, Число - Порт прокси сервера. Пустая строка - порт по-умолчанию
// * Пользователь - Строка - Логин пользователя прокси сервера
// * Пароль - Строка - Пароль пользователя прокси сервера
// * ИспользоватьАутентификациюОС - Булево - использование NTLM-аутентификации
//
Функция СоздатьНастройкиПроксиДляПротокола() Экспорт
	
	ПроксиПротокола = Новый Структура;
	
	ПроксиПротокола.Вставить("Сервер", "");
	ПроксиПротокола.Вставить("Порт", Неопределено);
	ПроксиПротокола.Вставить("Пользователь", "");
	ПроксиПротокола.Вставить("Пароль", "");
	ПроксиПротокола.Вставить("ИспользоватьАутентификациюОС", Истина);
	
	Возврат ПроксиПротокола;
	
КонецФункции

// Создать прокси.
// 
// Возвращаемое значение:
//  Структура - Создать прокси:
// * ИспользоватьСистемныеНастройки - Булево - Использовать системные настройки. Подробности в документации
// * НеИспользоватьПроксиДляЛокальныхАдресов - Булево - Для локальных адресов прокси не используется
// * НеИспользоватьПроксиДляАдресов - Неопределено, Массив из Строка - Массив адресов для которых не используется
//   прокси
// * ПротоколОбщий - Структура: см. СоздатьНастройкиПроксиДляПротокола - 
// * ПротоколHTTP - Неопределено, Структура: см. СоздатьНастройкиПроксиДляПротокола - Особые настройки для http
// * ПротоколHTTPS - Неопределено, Структура: см. СоздатьНастройкиПроксиДляПротокола - Особые настройки для https
//
Функция СоздатьНастройкиПрокси() Экспорт
	
	НастройкиПрокси = Новый Структура;
	НастройкиПрокси.Вставить("ИспользоватьСистемныеНастройки", Истина);
	НастройкиПрокси.Вставить("НеИспользоватьПроксиДляЛокальныхАдресов", Истина);
	НастройкиПрокси.Вставить("НеИспользоватьПроксиДляАдресов", Неопределено);
	
	НастройкиПрокси.Вставить("ПротоколОбщий", СоздатьНастройкиПроксиДляПротокола());
	НастройкиПрокси.Вставить("ПротоколHTTP", Неопределено);
	НастройкиПрокси.Вставить("ПротоколHTTPS", Неопределено);
	
	Возврат НастройкиПрокси;
	
КонецФункции

// Новый ИнтернетПрокси. Создает объект ИнтернетПрокси на основании контракта СоздатьПрокси.
// 
// Параметры:
// НастройкиПрокси - Структура: см. СоздатьНастройкиПрокси - 
// 
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - Создать параметры прокси
//
Функция НовыйИнтернетПрокси(НастройкиПрокси) Экспорт
	
	Если НастройкиПрокси.ИспользоватьСистемныеНастройки Тогда
		
		Возврат Новый ИнтернетПрокси(Истина);
		
	КонецЕсли;
	
	Результат = Новый ИнтернетПрокси;
	
	Результат.НеИспользоватьПроксиДляЛокальныхАдресов = НастройкиПрокси.НеИспользоватьПроксиДляЛокальныхАдресов;
	
	Если Не НастройкиПрокси.ПротоколОбщий = Неопределено Тогда
		
		МассивПротоколов = Новый Массив(); // Массив из Строка
		МассивПротоколов.Добавить("http");
		МассивПротоколов.Добавить("https");
		
		Для Каждого ПротоколПрокси Из МассивПротоколов Цикл
			
			ЗаполнитьНастройкиПроксиДляПротокола(ПротоколПрокси, НастройкиПрокси.ПротоколОбщий, Результат);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не НастройкиПрокси.ПротоколHTTP = Неопределено Тогда
		
		ЗаполнитьНастройкиПроксиДляПротокола("http", НастройкиПрокси.ПротоколHTTP, Результат);
	
	КонецЕсли;
	
	Если Не НастройкиПрокси.ПротоколHTTPS = Неопределено Тогда
		
		ЗаполнитьНастройкиПроксиДляПротокола("https", НастройкиПрокси.ПротоколHTTPS, Результат);
	
	КонецЕсли;
	
	Если НастройкиПрокси.Свойство("НеИспользоватьПроксиДляАдресов")
		И Не НастройкиПрокси.НеИспользоватьПроксиДляАдресов = Неопределено Тогда
			Для Каждого АдресИсключения Из НастройкиПрокси.НеИспользоватьПроксиДляАдресов Цикл
				
				//@skip-check typed-value-adding-to-untyped-collection
				Результат.НеИспользоватьПроксиДляАдресов.Добавить(АдресИсключения);
				
			КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Пакет ответа результата вызова метода HTTP.
// 
// Возвращаемое значение:
//  Структура - пакет ответа:
//  * Метод - Строка - имя HTTP-метода запроса
//  * URL - Строка - итоговый URL, по которому был выполнен запрос.
//  * КодСостояния - Число - Код состояния ответа..
//  * Заголовки - Соответствие из Строка - Заголовки ответа.
//  * ТелоКакДвоичныеДанные - ДвоичныеДанные - Тело ответа двоичные данные.
//  * Кодировка - Строка, КодировкаТекста - код кодировки ответа.
//  * ВремяВыполнения - Число, Неопределено - время выполнения запроса в миллисекундах.
//  * ЭтоПостоянныйРедирект - Булево - указывает что это постоянный редирект.
//  * ЭтоРедирект - Булево - указывает что это редирект.
//  * Cookies - Соответствие из Строка - хранилище cookies:
//  ** Ключ - Строка - Имя cookie
//  ** Значение - Строка - значение cookie
//  * Ошибки - Массив из Строка - Список ошибок возникших в ходе выполнения запроса.
//  
Функция НовыйОтвет() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Метод", "GET");
	Результат.Вставить("URL", "");
	Результат.Вставить("КодСостояния", 600); // Сетевая ошибка (>500)
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("ТелоКакДвоичныеДанные", Base64Значение(""));
	Результат.Вставить("Кодировка", "UTF-8");
	Результат.Вставить("ВремяВыполнения", Неопределено);
	Результат.Вставить("ЭтоПостоянныйРедирект", Ложь);
	Результат.Вставить("ЭтоРедирект", Ложь);
	Результат.Вставить("Cookies", Новый Соответствие);
	Результат.Вставить("Ошибки", Новый Массив);

	Возврат Результат;

КонецФункции

// Новый аутентификация.
// 
// Возвращаемое значение:
//  Структура - Новый аутентификация:
// * Пользователь - Строка - имя пользователя
// * Пароль - Строка - пароль пользователя
//
Функция НовыйАутентификация() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Пользователь", "");
	Результат.Вставить("Пароль", "");
	
	Возврат Результат;
	
КонецФункции

// Новый структура URL.
// 
// Возвращаемое значение:
//  Структура - Новый структура URL:
// * Схема - Строка - схема обращения к серверу (http, https)
// * Аутентификация - Неопределено, Структура: см. НовыйАутентификация() - параметры аутентификации
// * Сервер - Строка - адрес сервера
// * Порт - Число - порт сервера
// * Путь - Строка - адрес ресурса на сервере
// * ПараметрыЗапроса - Неопределено, Структура, Соответствие - параметры, которые будут отправлены в URL
//  (часть после ?):
//  ** Ключ - Строка - ключ параметра в URL.
//  ** Значение - Строка, Массив из Строка - значение параметра URL, массив сформирует строку из нескольких
//  параметров: key=value1&key=value2 и т.д.
// * Фрагмент - Строка - часть URL после #
//
Функция НовыйСтруктураURL() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", "http");
	Результат.Вставить("Аутентификация", Неопределено);
	Результат.Вставить("Сервер", "");
	Результат.Вставить("Порт", 0);
	Результат.Вставить("Путь", "");
	Результат.Вставить("ПараметрыЗапроса", Неопределено);
	Результат.Вставить("Фрагмент", "");
	
	Возврат Результат;
	
КонецФункции

// Допустимые схемы.
// 
// Возвращаемое значение:
//  ФиксированныйМассив из Строка - Допустимые схемы
//
Функция ДопустимыеСхемы()
	
	Результат = Новый Массив(); // Массив из Строка
	Результат.Добавить("http");
	Результат.Добавить("https");
	
	Возврат Новый ФиксированныйМассив(Результат);
	
КонецФункции

// Возвращает ответ сервера в виде десериализованного значения JSON.
//
// Параметры:
//  Ответ - Структура: См. НовыйОтвет - Полученный ответ
//  ПараметрыПреобразованияJSON - Неопределено, Структура: См. ПолучитьПараметрыПреобразованияJSONПоУмолчанию - задает
//  параметры преобразования JSON:
// 
// Возвращаемое значение:
//  - Соответствие из Строка, Число, Дата - ответ сервера в виде десериализованного значения JSON.
//  Если ПараметрыПреобразования.ПрочитатьВСоответствие = Истина (по умолчанию).
//  - Структура из Строка, Число, Дата - ответ сервера в виде десериализованного значения JSON.
//  Если ПараметрыПреобразования.ПрочитатьВСоответствие = Ложь (по умолчанию).
//
Функция КакJson(Ответ, ПараметрыПреобразованияJSON = Неопределено) Экспорт

	Попытка
		
		Возврат JsonВОбъект(РаспаковатьОтвет(Ответ), Ответ.Кодировка, ПараметрыПреобразованияJSON);
		
	Исключение
		
		ОписаниеОшибкиСтрокой = ОписаниеОшибки();
		ТекстИсключения = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
			НСтр("ru = 'Ошибка при десериализации JSON. Описание: %1'"), ОписаниеОшибкиСтрокой);
			
		ВызватьИсключение КакИсключение(Ответ, ТекстИсключения);
		
	КонецПопытки;

КонецФункции

// Возвращает ответ сервера в виде текста.
//
// Параметры:
//  Ответ - Структура: См. НовыйОтвет - полученный ответ
//  Кодировка - Строка, КодировкаТекста - определяет кодировку текста.
//  Если значение не задано, то кодировка извлекается из Ответ.Кодировка.
// 
// Возвращаемое значение:
//  Строка - ответ сервера в виде текста.
//
Функция КакТекст(Ответ, Кодировка = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Кодировка) Тогда
		
		Кодировка = Ответ.Кодировка;
		
	КонецЕсли;

	Возврат ПолучитьСтрокуИзДвоичныхДанныхЛок(РаспаковатьОтвет(Ответ), Кодировка);
	
КонецФункции

// Возвращает ответ сервера в двоичных данных.
//
// Параметры:
//  Ответ - Структура: См. НовыйОтвет - полученный ответ
// 
// Возвращаемое значение:
//  ДвоичныеДанные - ответ сервера в виде двоичных данных.
//
Функция КакДвоичныеДанные(Ответ) Экспорт

	Возврат РаспаковатьОтвет(Ответ);

КонецФункции

// Возвращает ответ сервера в XDTO.
//
// Параметры:
//  Ответ - Структура: См. НовыйОтвет - 
//  ПараметрыЧтенияXML - ПараметрыЧтенияXML - Параметры чтения, которые будут использованы при чтении данных XML
//  НаборСхемXML - НаборСхемXML - Набор схем XML, используемых при проверке читаемого документа XML
//  Если набор схем указан, но не проверен и включена проверка документа XML, то будет выполнена проверка набора схем.
//  Кодировка - Строка, КодировкаТекста, Неопределено - Позволяет задать кодировку.
// 
// Возвращаемое значение:
//  ОбъектXDTO, СписокXDTO - тип возвращаемого значения может быть любым из поддерживаемых сериализацию в XDTO.
//
Функция КакXDTO(Ответ, ПараметрыЧтенияXML = Неопределено, НаборСхемXML = Неопределено,
	Кодировка = Неопределено) Экспорт

	Попытка
		
		ДвоичныеДанные = РаспаковатьОтвет(Ответ);

		ПотокДляЧтения = ДвоичныеДанные.ОткрытьПотокДляЧтения();

		Если Не ЗначениеЗаполнено(Кодировка) Тогда
			
			Кодировка = Ответ.Кодировка;
			
		КонецЕсли;

		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьПоток(ПотокДляЧтения, ПараметрыЧтенияXML, НаборСхемXML, Кодировка);

		ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		
	Исключение
		
		ВызватьИсключение КакИсключение(Ответ, НСтр("ru = 'Ошибка при десериализации XDTO.'"));
		
	КонецПопытки;

	Возврат ОбъектXDTO;

КонецФункции

// Возвращает ответ сервера в виде текста предназначенного для использования в ВызватьИсключение.
//
// Параметры:
//  Ответ - Структура: См. НовыйОтвет - 
//  ТекстДляПользователя - Строка - Текст пояснения причины для пользователя.
// 
// Возвращаемое значение:
//  Строка - ответ сервера в виде текста исключения.
//
Функция КакИсключение(Ответ, Знач ТекстДляПользователя = "") Экспорт

	ТекстИсключения = КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(
		НСтр("ru = 'HTTP %1 %2 %3'"),
		Ответ.Метод,
		Ответ.URL,
		ПредставлениеКодаСостоянияHTTP(Ответ.КодСостояния));

	ТелоОтвета = ВырезатьТекст(КакТекст(Ответ));

	Если Не ПустаяСтрока(ТелоОтвета) Тогда
		
		ТекстИсключения = ТекстИсключения + Символы.ПС
			+ КонтурДиадокСтдСтрКлиентСервер.ПодставитьПараметрыВСтрокуЛок(НСтр("ru = 'Тело ответа: %1'"), ТелоОтвета);
		
	КонецЕсли;

	Если Ответ.Ошибки.Количество() Тогда
		
		ТекстИсключения = ТекстИсключения + Символы.ПС + Символы.ПС
			+ КонтурДиадокСтдСтрКлиентСервер.СтрСоединитьЛок(Ответ.Ошибки, Символы.ПС + Символы.ПС);
		
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстДляПользователя) Тогда
		
		ТекстИсключения = ТекстДляПользователя + Символы.ПС + Символы.ПС + ТекстИсключения;
		
	КонецЕсли;

	Возврат ТекстИсключения;

КонецФункции

