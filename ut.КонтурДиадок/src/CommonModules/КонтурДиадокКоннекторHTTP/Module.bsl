// Раскодировать строку для 8.2. Аналог РаскодироватьСтроку().
// 
// Параметры:
//  КодированнаяСтрока - Строка - Кодированная строка
//  СпособКодирования - Строка - Способ кодирования URLВКодировкеURL или КодировкаURL
// 
// Возвращаемое значение:
//  Строка - Раскодированная строка
//  
Функция РаскодироватьСтроку82(КодированнаяСтрока, СпособКодирования)
	
	ДлинаСтроки = СтрДлина(КодированнаяСтрока);
	Инд = 1;
	НекодированнаяСтрока = "";
	ПолныйКод = 0;
	ОсталосьСимволов = 0;

	Пока Инд <= ДлинаСтроки Цикл

		Код = КодСимвола(КодированнаяСтрока, Инд);

		Если Код = 37 Тогда
			
			Попытка
				
				// Символ(37) = "%"
				Код = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Hex2Dec(Сред(КодированнаяСтрока, Инд + 1, 2));
				Инд = Инд + 2;
				
			Исключение
				
				НекодированнаяСтрока = НекодированнаяСтрока + Символ(Код);
				Инд = Инд + 1;
				Продолжить;
				
			КонецПопытки;

		ИначеЕсли ОсталосьСимволов = 0 Тогда
			
			НекодированнаяСтрока = НекодированнаяСтрока + Символ(Код);
			Инд = Инд + 1;
			Продолжить;
			
		КонецЕсли;

		Если Код <= 127 Тогда
			
			// Код = 0b0ххххххх
			НекодированнаяСтрока = НекодированнаяСтрока + Символ(Код);
			
		ИначеЕсли Код <= 191 Тогда
			
			// Код = 0b10хххххх
			ПолныйКод = (ПолныйКод * 64) + (Код % 64); // shl(ПолныйКод, 6) + (Код & 0x3F)
			ОсталосьСимволов = ОсталосьСимволов - 1;
			
			Если ОсталосьСимволов = 0 Тогда
				
				НекодированнаяСтрока = НекодированнаяСтрока + Символ(ПолныйКод);
				
			КонецЕсли;
			
		ИначеЕсли Код <= 223 Тогда
			
			// Код = 0b110ххххх
			ПолныйКод = Код % 32; // Код & 0x1F
			ОсталосьСимволов = 1;
			
		ИначеЕсли Код <= 239 Тогда
			
			// Код = 0b1110хххх
			ПолныйКод = Код % 16; // Код & 0x0F
			ОсталосьСимволов = 2;
			
		ИначеЕсли Код <= 247 Тогда
			
			// Код = 0b11110ххх
			ПолныйКод = Код % 8; // Код & 0x07
			ОсталосьСимволов = 3;
			
		ИначеЕсли Код <= 251 Тогда
			
			// Код = 0b111110хх
			ПолныйКод = Код % 4; // Код & 0x03
			ОсталосьСимволов = 4;
			
		ИначеЕсли Код <= 253 Тогда
			
			// Код = 0b1111110х
			ПолныйКод = Код % 2; // Код & 0x01
			ОсталосьСимволов = 5;
			
		КонецЕсли;

		Инд = Инд + 1;
		
	КонецЦикла;

	Возврат НекодированнаяСтрока;
	
КонецФункции

// Кодировать строку для 8.2. Аналог КодироватьСтроку().
// 
// Параметры:
//  НекодированнаяСтрока - Строка - Некодированная строка
//  СпособКодирования - Строка - Способ кодирования URLВКодировкеURL или КодировкаURL
// 
// Возвращаемое значение:
//  Строка - Кодировнная строка
//  
Функция КодироватьСтроку82(НекодированнаяСтрока, СпособКодирования)
	
	КодированнаяСтрока = "";
	ДлинаСтроки = СтрДлина(НекодированнаяСтрока);
	СпецСимволыURL = "!#$%'()*+,/:;=?@[].&";

	Для Сч = 1 По ДлинаСтроки Цикл

		СимволСтроки = Сред(НекодированнаяСтрока, Сч, 1);
		КодСимволаСтроки = КодСимвола(СимволСтроки);
		
		Если НРег(СпособКодирования) = НРег("URLВКодировкеURL") Тогда
			
			// URLВКодировкеURL Спецсимволы URL ( !#$%'()*+,/:;=?@[]. ) не кодируются.
			
			Если Найти(СпецСимволыURL, СимволСтроки) > 0 Тогда
				
				КодированнаяСтрока = КодированнаяСтрока + СимволСтроки;
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;

		Если ("A" <= СимволСтроки И СимволСтроки <= "Z") // "A".."Z"
			Или ("a" <= СимволСтроки И СимволСтроки <= "z") // "a".."z"
			Или ("0" <= СимволСтроки И СимволСтроки <= "9") // "0".."9"
			Или (СимволСтроки = "-")
			Или (СимволСтроки = "_")
			Или (СимволСтроки = ".") Тогда
				
			КодированнаяСтрока = КодированнаяСтрока + СимволСтроки;
			
		ИначеЕсли (КодСимволаСтроки <= 127) Тогда
			
			// other ASCII
			КодированнаяСтрока = КодированнаяСтрока + "%"
				+ КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Dec2Hex(КодСимволаСтроки, 2);
			
		ИначеЕсли (КодСимволаСтроки <= 2047) Тогда
			
			// non-ASCII <= 0x07FF
			КодированнаяСтрока = КодированнаяСтрока + "%"
				+ КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Dec2Hex(192 + Цел(КодСимволаСтроки / 64), 2);
			
			КодированнаяСтрока = КодированнаяСтрока + "%"
				+ КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Dec2Hex(128 + (КодСимволаСтроки % 64), 2);
			
		Иначе
			
			// 0x07FF < ch <= 0xFFFF
			КодированнаяСтрока = КодированнаяСтрока + "%"
				+ КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Dec2Hex(224 + Цел(КодСимволаСтроки / 4096), 2);
			
			КодированнаяСтрока = КодированнаяСтрока + "%"
				+ КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Dec2Hex(128 + (Цел(КодСимволаСтроки / 64) % 64), 2);
			
			КодированнаяСтрока = КодированнаяСтрока + "%"
				+ КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Dec2Hex(128 + (КодСимволаСтроки % 64), 2);
			
		КонецЕсли;

	КонецЦикла;

	Возврат КодированнаяСтрока;
	
КонецФункции

// Выполняет чтение данных из архива GZip.
//
// Параметры:
//  СжатыеДанные - ДвоичныеДанные	 - данные упакованные GZip.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - распакованные данные.
//
Функция ПрочитатьGZipЛок(СжатыеДанные)

	РазмерПрефиксаGZip = 10;
	РазмерПостфиксаGZip = 8;

	ЧтениеДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЧтениеДанных(СжатыеДанные);
	
	КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ПропуститьЧтениеДанных(ЧтениеДанных, РазмерПрефиксаGZip);
	
	ИсходныйПоток = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ИсходныйПотокЧтениеДанных(ЧтениеДанных);

	РазмерСжатыхДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.РазмерПотока(ИсходныйПоток) - РазмерПрефиксаGZip
		- РазмерПостфиксаGZip;

	ПотокZip = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.Поток();
	
	ЗаписьДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписьДанных(ПотокZip);
	
	ZipLFH(ЗаписьДанных);
	
	КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.КопироватьВЧтениеДанных(ЧтениеДанных, ЗаписьДанных, РазмерСжатыхДанных);

	ЗаписьДанных = КонтурДиадокКоннекторHTTPДвоичныеДанные82Служебный.ЗаписьДанных(ПотокZip);

