// Объект защищенного соединения лок.
// 
// Параметры:
//  ДополнительныеПараметры - Структура - Дополнительные параметры:
//  * ПроверятьSSL - Булево, СертификатыУдостоверяющихЦентровФайл - СоздатьСессию.ПроверятьSSL.
//  * КлиентскийСертификатSSL - СертификатКлиентаФайл, СертификатКлиентаWindows, Неопределено -
// 
// Возвращаемое значение:
//  ЗащищенноеСоединениеOpenSSL - Объект защищенного соединения
//  
Функция ОбъектЗащищенногоСоединенияЛок(ДополнительныеПараметры) Экспорт

	Если ДополнительныеПараметры.ПроверятьSSL = Ложь Тогда
		
		СертификатыУЦ = Неопределено;
		
	ИначеЕсли ТипЗнч(ДополнительныеПараметры.ПроверятьSSL) = Тип("СертификатыУдостоверяющихЦентровФайл") Тогда
		
		СертификатыУЦ = ДополнительныеПараметры.ПроверятьSSL;
		
	Иначе
		
		СертификатыУЦ = Неопределено;
		
	КонецЕсли;
	
	КлиентскийСертификат = Неопределено;
	
	Если ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаФайл")
		Или ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаWindows") Тогда
		
		КлиентскийСертификат = ДополнительныеПараметры.КлиентскийСертификатSSL;
		
	КонецЕсли;

	Возврат Новый ЗащищенноеСоединениеOpenSSL(КлиентскийСертификат, СертификатыУЦ);

КонецФункции

// HTTPСоединение лок.
// 
// Параметры:
//  СерверЛок - Строка - Сервер
//  ПортЛок - Число - Порт
//  ПользовательЛок - Строка - Пользователь
//  ПарольЛок - Строка - Пароль
//  ПроксиЛок - ИнтернетПрокси, Неопределено - Прокси
//  ТаймаутЛок - Число - Таймаут
//  ЗащищенноеСоединениеЛок - ЗащищенноеСоединениеOpenSSL, Неопределено - Защищенное соединение
//  ИспользоватьАутентификациюОСЛок - Булево, Неопределено - Использовать аутентификацию ОС
// 
// Возвращаемое значение:
//  HTTPСоединение - 
//  
Функция HTTPСоединениеЛок(СерверЛок, ПортЛок, ПользовательЛок, ПарольЛок, ПроксиЛок, ТаймаутЛок,
	ЗащищенноеСоединениеЛок, ИспользоватьАутентификациюОСЛок) Экспорт
	
	ТипЗначенияHTTPСоединение = Тип("HTTPСоединение");
	
	ПараметрыHTTPСоединение = Новый Массив;
	ПараметрыHTTPСоединение.Добавить(СерверЛок);
	ПараметрыHTTPСоединение.Добавить(ПортЛок);
	ПараметрыHTTPСоединение.Добавить(ПользовательЛок);
	ПараметрыHTTPСоединение.Добавить(ПарольЛок);
	ПараметрыHTTPСоединение.Добавить(ПроксиЛок);
	ПараметрыHTTPСоединение.Добавить(ТаймаутЛок);
	ПараметрыHTTPСоединение.Добавить(ЗащищенноеСоединениеЛок);

	Если Не ИспользоватьАутентификациюОСЛок = Неопределено Тогда
		
		// Доступен, начиная с версии 8.3.7
		ПараметрыHTTPСоединение.Добавить(ИспользоватьАутентификациюОСЛок);
			
	КонецЕсли;
	
	Возврат Новый (ТипЗначенияHTTPСоединение, ПараметрыHTTPСоединение);
	
КонецФункции

// Раскодировать строку лок.
// 
// Параметры:
//  ЗакодированнаяСтрока - Строка - Закодированная строка
//  СпособКодирования - Строка - Способ кодирования. URLВКодировкеURL или КодировкаURL
// 
// Возвращаемое значение:
//  Строка - Раскодированная строка
//  
Функция РаскодироватьСтрокуЛок(ЗакодированнаяСтрока, СпособКодирования) Экспорт
	
	СпособКодированияСтрокиЛок = СпособКодированияСтроки[СпособКодирования]; // СпособКодированияСтроки
	Возврат РаскодироватьСтроку(ЗакодированнаяСтрока, СпособКодированияСтрокиЛок); 
	
КонецФункции

// Кодировать строку лок.
// 
// Параметры:
//  НекодированнаяСтрока - Строка - Некодированная строка
//  СпособКодирования - Строка - Способ кодирования. URLВКодировкеURL или КодировкаURL
// 
// Возвращаемое значение:
//  Строка - Кодированная строка
//  
Функция КодироватьСтрокуЛок(НекодированнаяСтрока, СпособКодирования) Экспорт
	
	СпособКодированияСтрокиЛок = СпособКодированияСтроки[СпособКодирования]; // СпособКодированияСтроки
	Возврат КодироватьСтроку(НекодированнаяСтрока, СпособКодированияСтрокиЛок);
	
КонецФункции

// Вызвать HTTPМетод.
// 
// Параметры:
//  Соединение - HTTPСоединение  - Соединение
//  HTTPМетод - Строка - HTTPМетод
//  HTTPЗапрос - HTTPЗапрос -
//  ИмяВыходногоФайла - Строка, Неопределено - Имя выходного файла
// 
// Возвращаемое значение:
//  HTTPОтвет 
Функция ВызватьHTTPМетодЛок(Соединение, HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла = Неопределено) Экспорт
	
	Возврат Соединение.ВызватьHTTPМетод(HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла);
	
КонецФункции
