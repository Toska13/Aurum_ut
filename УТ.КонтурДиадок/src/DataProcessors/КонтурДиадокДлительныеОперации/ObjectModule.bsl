		МенеджерОбъекта = СтдОбщегоНазначения.ОбщийМодульЛок("СтандартныеПодсистемыСервер");
		Результат = МенеджерОбъекта.ВерсияБиблиотеки();
	Исключение
		Результат = "0.0.0";
	КонецПопытки;
	
	Возврат Результат;
	
