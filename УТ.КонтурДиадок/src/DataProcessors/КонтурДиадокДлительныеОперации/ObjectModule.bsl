// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Запускает фоновое задании, использую общий модуль расширения
// КонтурДиадокДлительныеОперации.ВыполнитьКоманду
//
// Параметры:
//  ПараметрыВыполненияКоманды - Структура - структура параметров выполнения ФЗ, заполняемая в вызывающем
//										коде (см. ПараметрыВыполненияКоманды())
// 
// Возвращаемое значение:
//  Структура - описание длительной операции (см. ОписаниеЗадания())
//
Функция ЗапуститьВФонеЧерезПодсистемуДлительныеОперации(ПараметрыВыполненияКоманды)
	
	ПараметрыОперации = ПараметрыВыполненияКоманды.ПараметрыКоманды.ПараметрыОперации;
	ПроверитьИЗаполнитьАдресРезультата(ПараметрыВыполненияКоманды, ПараметрыОперации.ИмяМетода);

	ПараметрыМетодаКоллекцией = ПараметрыВМассивЛок(
		ПараметрыВыполненияКоманды.ИдентификаторКоманды,
		ПараметрыВыполненияКоманды,
		ПараметрыВыполненияКоманды.АдресРезультата);
		
	НаименованиеЗадания = СформироватьНаименованиеЗадания(ПараметрыОперации.ИмяМетода);
	
	КлючЗадания = ПараметрыВыполненияКоманды.КлючФоновогоЗадания;
	
	ИмяМетодаРасширения = "КонтурДиадокДлительныеОперации.ВыполнитьКоманду";

	Задание = ФоновыеЗадания.Выполнить(ИмяМетодаРасширения, ПараметрыМетодаКоллекцией, , НаименованиеЗадания);
	
	Если ЗначениеЗаполнено(Задание.ИнформацияОбОшибке) Тогда
		ЗаписатьОшибкуВЖурнал(Задание.ИнформацияОбОшибке);
	КонецЕсли;
	
	Результат = СформироватьОписаниеЗадания(Задание, ПараметрыВыполненияКоманды, Задание.ИнформацияОбОшибке, КлючЗадания);
	Результат.ИмяМетода = ПараметрыОперации.ИмяМетода;
	
	Возврат Результат;

КонецФункции

// Запускает фоновое задании, использую общий модуль подсистемы хранения Диадок
//  Диадок_ФоновыеЗадания.ВыполнитьКоманду
//
// Параметры:
//  ПараметрыВыполненияКоманды - Структура - структура параметров выполнения ФЗ, заполняемая в вызывающем
//  							коде (см. ПараметрыВыполненияКоманды())
// 
// Возвращаемое значение:
//  Структура - описание длительной операции (см. ОписаниеЗадания())
//
Функция ЗапуститьВФонеЧерезПодсистемуХраненияДиадок(ПараметрыВыполненияКоманды)
	
	ПараметрыОперации = ПараметрыВыполненияКоманды.ПараметрыКоманды.ПараметрыОперации;
	ПроверитьИЗаполнитьАдресРезультата(ПараметрыВыполненияКоманды, ПараметрыОперации.ИмяМетода);
	
	ПараметрыМетодаКоллекцией = ПараметрыВМассивЛок(
		_Обработка,
		ПараметрыВыполненияКоманды,
		ПараметрыВыполненияКоманды.АдресРезультата);
	
	НаименованиеЗадания = СформироватьНаименованиеЗадания(ПараметрыОперации.ИмяМетода);
	
	КлючЗадания = ПараметрыВыполненияКоманды.КлючФоновогоЗадания;

	ИмяМетодаПодсистемы = "Диадок_ФоновыеЗадания.ВыполнитьКоманду";
	
	Задание = ФоновыеЗадания.Выполнить(ИмяМетодаПодсистемы, ПараметрыМетодаКоллекцией, , НаименованиеЗадания);
	
	Если ЗначениеЗаполнено(Задание.ИнформацияОбОшибке) Тогда
		ЗаписатьОшибкуВЖурнал(Задание.ИнформацияОбОшибке);
	КонецЕсли;

	Результат = СформироватьОписаниеЗадания(Задание, ПараметрыВыполненияКоманды, Задание.ИнформацияОбОшибке, КлючЗадания);
	Результат.ИмяМетода = ПараметрыОперации.ИмяМетода;

	Возврат Результат;

КонецФункции

// Запускает фоновое задании, использую функциональность БСП
//
// Параметры:
//  ПараметрыВыполненияКоманды - Структура - структура параметров выполнения ФЗ, заполняемая в вызывающем
//  							коде (см. ПараметрыВыполнения())
// 
// Возвращаемое значение:
//  Структура - описание длительной операции (см. ОписаниеЗадания())
//
Функция ЗапуститьВФонеЧерезБСП(ПараметрыВыполненияКоманды)
	
	ПараметрыВыполненияКоманды.Вставить("ДополнительнаяОбработкаСсылка", _Обработка);

	ПараметрыОперации = ПараметрыВыполненияКоманды.ПараметрыКоманды.ПараметрыОперации;
	
	НаименованиеЗадания = СформироватьНаименованиеЗадания(ПараметрыОперации.ИмяМетода);
	
	КлючЗадания = ПараметрыВыполненияКоманды.КлючФоновогоЗадания;
	
	ОбщийМодульДлительныеОперации = СтдОбщегоНазначения.ОбщийМодульЛок("ДлительныеОперации");
	
	ПроверитьИЗаполнитьАдресРезультата(ПараметрыВыполненияКоманды, ПараметрыОперации.ИмяМетода);
	
	ИдентификаторФормы = ПараметрыВыполненияКоманды.ИдентификаторФормы;
	ПараметрыВыполненияБСП = ОбщийМодульДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	
	ПараметрыВыполненияБСП.АдресРезультата = ПараметрыВыполненияКоманды.АдресРезультата;
	ПараметрыВыполненияБСП.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполненияБСП.ОжидатьЗавершение = 0;
	
	ПолныйПутьКМетодуКоманды = "ДополнительныеОтчетыИОбработки.ВыполнитьКоманду";
	
	Если ИспользоватьНовыеМетодыПрограммногоИнтерфейсаБСП() Тогда
		
		ОписаниеЗаданияБСП = ОбщийМодульДлительныеОперации.ВыполнитьФункцию(
			ПараметрыВыполненияБСП,
			ПолныйПутьКМетодуКоманды,
			ПараметрыВыполненияКоманды);
		
	Иначе
	
		ОписаниеЗаданияБСП = ОбщийМодульДлительныеОперации.ВыполнитьВФоне(
			ПолныйПутьКМетодуКоманды,
			ПараметрыВыполненияКоманды,
			ПараметрыВыполненияБСП);
		
	КонецЕсли;
	
	Если ОписаниеЗаданияБСП.Статус = "Ошибка" Тогда
		ЗаписатьОшибкуВЖурнал(ОписаниеЗаданияБСП.ИнформацияОбОшибке);
	КонецЕсли;
	
	Задание = Неопределено;
	Если ОписаниеЗаданияБСП.Свойство("УникальныйИдентификатор") Тогда
		ЗаданиеИдентификатор = ОписаниеЗаданияБСП.УникальныйИдентификатор;
	ИначеЕсли ОписаниеЗаданияБСП.Свойство("ИдентификаторЗадания") Тогда
		ЗаданиеИдентификатор = ОписаниеЗаданияБСП.ИдентификаторЗадания;
	Иначе
		ТекстОшибки = НСтр("ru='Произошла ошибка при попытке получить идентификатор фонового задания
			|при выполнении метода %1 через Библиотеку стандартных подсистем'");
		ТекстОшибки = СтдСтр.СтрШаблонЛок(ТекстОшибки, ПараметрыОперации.ИмяМетода);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
		
	Если ОписаниеЗаданияБСП.Статус = "Ошибка" Тогда
		СостояниеФЗ = СостояниеФоновогоЗадания.ЗавершеноАварийно;
	ИначеЕсли ОписаниеЗаданияБСП.Статус = "Выполнено"
		Или Не ЗначениеЗаполнено(ЗаданиеИдентификатор) Тогда
		СостояниеФЗ = СостояниеФоновогоЗадания.Завершено;
	Иначе
		СостояниеФЗ = СостояниеФоновогоЗадания.Активно;
	КонецЕсли;
	
	Задание = Новый Структура;
	Задание.Вставить("Состояние", СостояниеФЗ);
	Задание.Вставить("УникальныйИдентификатор", ЗаданиеИдентификатор);

	Результат = СформироватьОписаниеЗадания(
		Задание,
		ПараметрыВыполненияКоманды,
		ОписаниеЗаданияБСП.ИнформацияОбОшибке,
		КлючЗадания);
	
	Результат.АдресРезультата = ОписаниеЗаданияБСП.АдресРезультата;
	Результат.ИмяМетода = ПараметрыОперации.ИмяМетода;
	
	Возврат Результат;
	
КонецФункции

Функция ПеречислениеВариантыЗапуска()
	
	Результат = СобратьПеречислениеСлужебный(
		"ПодсистемаДлительныеОперации, ПодсистемаХраненияДиадок, БСП");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
КонецФункции

// Вычисляет вариант запуска фоновых заданий
// Если в конфигурации есть подсистема длительных операций, то ФЗ будут запускаться через нее
// и в этом случае будет использоваться встроенная обработка (в расширении), режим запуска через подсистему.
// Если подсистемы нет, но есть подсистема хранения Диадок и "установлена" обработка (заполнена _Обработка),
// то режим запуска будет через подсистему хранения
// Если же и подсистемы хранения нет, но есть подходящая версия БСП и ссылка на справочник. доп. обработок
// с модулем (заполнена _Обработка), то вариант запуска будет БСП
// 
// Возвращаемое значение:
//  Строка - значение программного перечисления с вариантом запуска ФЗ (см. ПеречислениеВариантыЗапуска())
//
Функция ВычислитьВариантЗапуска()
	
	Перем Результат;
	
	ФайловыйРежимРаботы = ЭтоФайловыйРежимРаботы1СПредприятия();
	ДоступенЗапускФоновыхВТомЖеСеансе = СтдСтр.ВерсияПлатформыБольшеИлиРавна("8.3.3.641");
	
	Если ФайловыйРежимРаботы И НЕ ДоступенЗапускФоновыхВТомЖеСеансе Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ВозможенЗапускЧерезПодсистемуДлительныхОпераций() Тогда
		
		Результат = _ПеречислениеВариантыЗапуска.ПодсистемаДлительныеОперации;
	
	ИначеЕсли ВозможенЗапускЧерезПодсистемуХраненияДиадок() Тогда
		
		Результат = _ПеречислениеВариантыЗапуска.ПодсистемаХраненияДиадок;
		
	ИначеЕсли ВозможенЗапускЧерезБСП() Тогда 
		
		Результат = _ПеречислениеВариантыЗапуска.БСП;
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйКлючОбработчикаУведомлений()
	
	Результат = "";
	Если ДоступенМенеджерУведомленийКлиента() Тогда
		Результат = "МодульДлительныхОпераций.ОбработчикСерверныхУведомленийСлужебный";
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура ПроверитьИЗаполнитьАдресРезультата(ПараметрыВыполнения, ИмяФункции)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если Не ЗначениеЗаполнено(ПараметрыВыполнения.АдресРезультата) Тогда
		
		Если Не ЗначениеЗаполнено(ПараметрыВыполнения.ИдентификаторФормы)
			Или ТипЗнч(ПараметрыВыполнения.ИдентификаторФормы) <> Тип("УникальныйИдентификатор") Тогда
		
			ШаблонТекстаОшибки = НСтр("ru = 'Не указан ни уникальный идентификатор формы в параметре %1,
				|ни адрес временного хранилища в параметре %2
				|функции %3.
				|Рекомендуется указать идентификатор формы или адрес.
				|Автоматически сформированный адрес содержит значение только до следующего
				|серверного вызова, что может приводить к неожиданным ошибкам.'");
			
			ТекстОшибки = СтдСтр.ПодставитьПараметрыВСтрокуЛок(
				ШаблонТекстаОшибки,
				"ПараметрыВыполнения.ИдентификаторФормы",
				"ПараметрыВыполнения.АдресРезультата",
				ИмяФункции);
				
			Попытка
				ВызватьИсключение ТекстОшибки;
			Исключение
				ЗаписатьОшибкуВЖурнал(ИнформацияОбОшибке());
			КонецПопытки;
				
		КонецЕсли;
		
		ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено,
			ПараметрыВыполнения.ИдентификаторФормы);
		
	ИначеЕсли Не ЭтоАдресВременногоХранилища(ПараметрыВыполнения.АдресРезультата) Тогда
		
		ШаблонТекстаОшибки = НСтр("ru = 'Указан некорректный адрес временного хранилища в параметре %1
			|функции %2.'");
		
		ТекстОшибки = СтдСтр.ПодставитьПараметрыВСтроку(
			ШаблонТекстаОшибки,
			"ПараметрыВыполнения.АдресРезультата",
			ИмяФункции);
			
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Функция МенеджерУведомленийКлиентаЛок()

	Результат = Вычислить("УведомленияКлиента");
