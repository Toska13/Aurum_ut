Функция СформироватьОписаниеЗадания(Задание, ПараметрыКоманды, ИнформацияОбОшибке, КлючЗадания)
	
	Результат = ОписаниеЗадания();
	
	Результат.АдресРезультата = ПараметрыКоманды.АдресРезультата;
	
	Если ИнформацияОбОшибке <> Неопределено Тогда
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Результат.ТекстОшибкиПолный = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;

	Если Задание <> Неопределено Тогда
		Результат.Завершено = (Задание.Состояние <> СостояниеФоновогоЗадания.Активно);
		Результат.УникальныйИдентификатор = Задание.УникальныйИдентификатор;
		Результат.Ключ = КлючЗадания;
	КонецЕсли;
	
	Результат.УведомлятьКлиент = ПараметрыКоманды.УведомлятьКлиент;
	
	Возврат Результат;
	
КонецФункции

Процедура ПодождатьЗавершения(Задание, ВремяОжидания)
	
	Если СтдСтр.ВерсияПлатформыБольшеИлиРавна("8.3.13") Тогда
		
		Задание = Задание.ОжидатьЗавершенияВыполнения(ВремяОжидания);
		Пока Задание.Состояние = СостояниеФоновогоЗадания.Активно Цикл
			Задание = Задание.ОжидатьЗавершенияВыполнения(ВремяОжидания);
		КонецЦикла;
		
	Иначе
		
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Задание.ОжидатьЗавершения(ВремяОжидания);
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьОшибкуВЖурнал(ТекстОшибки)
	
	ИмяСобытия = НСтр("ru = 'Диадок.Длительные операции'");
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
