// BSLLS:MissingReturnedValueDescription-off

Функция ПараметрыВМассивЛок(П0, П1 = Null, П2 = Null, П3 = Null, П4 = Null)

// BSLLS:NumberOfOptionalParams-on
// BSLLS:MissingParameterDescription-on
// BSLLS:MissingReturnedValueDescription-off
	
	ЧислоПараметров = 5;
	Результат = Новый Массив(ЧислоПараметров);
	
	Результат[0] = П0;
	Результат[1] = П1;
	Результат[2] = П2;
	Результат[3] = П3;
	Результат[4] = П4;
	
	Для Сч = - Результат.ВГраница() По 0 Цикл
		
		Если Результат[ - Сч] = Null Тогда
			Результат.Удалить(- Сч);
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ЭтоВнешняяОбработка()
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
	
	Возврат ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;
	
КонецФункции // ЭтоВнешняяОбработка

Функция СобратьПеречислениеСлужебный(Строка)
	
	Результат = Новый Структура(Строка);
	Для Каждого Эл Из Результат Цикл
		Результат[Эл.Ключ] = Эл.Ключ;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Инициализация

Процедура __Инит__(Мета)
	
	ПрефиксТипа = "";
	Если ЭтоВнешняяОбработка() Тогда
		ПрефиксТипа = "External";
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	_Обработка = Неопределено;

	СтдСтр = Новый(ПрефиксТипа + "DataProcessorObject.КонтурДиадокСтдСтр");
	СтдОбщегоНазначения = Новый(ПрефиксТипа + "DataProcessorObject.КонтурДиадокСтдОбщегоНазначения");
	
	_ПеречислениеВариантыЗапуска = ПеречислениеВариантыЗапуска();
	_ВариантЗапуска = Неопределено;
	_МенеджерУведомленийДоступен = ДоступенМенеджерУведомленийКлиента();
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры // __Инит__

__Инит__(Метаданные());
