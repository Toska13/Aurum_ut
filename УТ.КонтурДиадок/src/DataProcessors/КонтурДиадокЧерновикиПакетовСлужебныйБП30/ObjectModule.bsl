// Создает временную таблицу с предложениями для отправки.
//  Запрос должен содержать следующие временные таблицы:
//  * ВТ_ПартнерскиеОтношения - содержит колонки:
//  ** Контрагент1С - СправочникСсылка - Сущность, сопоставленная с ящиком получателя Диадока
//  * ВТ_Отправители - содержит колонки:
//  ** Организация1С - СправочникСсылка - Сущность, сопоставленная с ящиком отправителя Диадока
//  ** ВидПакета - Строка - Идентификатор вида пакета
//  * ВТ_НастройкиОрганизаций - содержит колонки:
//  ** Организация1С - СправочникСсылка - Сущность, сопоставленная с ящиком Диадока (например, "Организации")
//
// Параметры:
//  ВидПакетаID - Строка - идентификатор вида пакета
//  Запрос - Запрос - инициализированный запрос (с параметрами и менеджером временных таблиц)
// 
// Возвращаемое значение:
//  Массив - из Строка - имена добавленных временных таблиц
//
Функция СлужебныйПодготовитьДанныеДляОтправки(ВидПакетаID, Запрос) Экспорт
	
	Результат = Новый Массив;
	
	Если ЭтоВидПакетаУПД(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_НаРеализацию(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ОтчетКомиссионераОПродажах) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетаФактурыПоОтчетуКомиссионера_НаРеализацию(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаУКД(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_Корректировочный(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ОтчетКомиссионераОПродажах) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетаФактурыПоОтчетуКомиссионера_Корректировочный(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаНаАванс(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_НаАванс(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
		Если ПредопределенноеЗначение("Перечисление.ВидСчетаФактурыПолученного.НаАвансКомитента") <> Неопределено Тогда
			
			Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
				ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_НаАвансКомитента(Запрос, ВидПакетаID);
				Результат.Добавить(ИмяВТ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ОтчетКомиссионераОПродажах) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетаФактурыПоОтчетуКомиссионера_НаАванс(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаИУПД(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_НаРеализацию(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаИУКД(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_Корректировочный(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаИсправительныйНаАванс(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_НаАванс(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаКорректировочныйНаАванс(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетФактура_КорректировочныйНаАванс(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаБезНДС(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_ПервичныеДокументыБезНДС(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаСчетНаОплату(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетНаОплатуПокупателю) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_СчетНаОплатуПокупателю(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	ИначеЕсли ЭтоВидПакетаАктСверки(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Документы.АктСверкиВзаиморасчетов) Тогда
			ИмяВТ = ДобавитьТаблицуЧерновиков_АктСверки(Запрос, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	Иначе
		
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
// BSLLS:CognitiveComplexity-on
// BSLLS:CyclomaticComplexity-on

