Функция СтдСтр()
	
	Если __СтдСтр = Неопределено Тогда
		
		Если __ЭтоВнешняяОбработка Тогда
			__СтдСтр = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			__СтдСтр = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат __СтдСтр;
	
КонецФункции

Функция ЭтоВнешняяОбработкаЛок()
	
	Если __ЭтоВнешняяОбработка = Неопределено Тогда
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		
		__ЭтоВнешняяОбработка = ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;
		
	КонецЕсли;
	
	Возврат __ЭтоВнешняяОбработка;
	
КонецФункции 

// Возвращает описания всех библиотек конфигурации, включая
// описание самой конфигурации.
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - Строка - имя подсистемы, например, "СтандартныеПодсистемы".
//   * Значение - Структура - описание подсистемы:
//     ** Имя - Строка - имя подсистемы.
//     ** Версия - Строка - версия подсистемы.
//     ** ЭтоКонфигурация - Булево - Истина, если данная подсистема является основной конфигурацией.
//     ** ИдентификаторИнтернетПоддержки - Строка - уникальное имя программы в сервисах интернет-поддержки.
//
Функция ОписанияПодсистемКонфигурации()
	
	// Используем служебный интерфейс БСП, т.к. метод ОписанияПодсистем добавлен в
	// программный интерфейс модуля ОбщегоНазначения только в версии БСП 3.0.2 и выше
	ИнтерфейсБСП = ОбщийМодульПоИмениЛок("СтандартныеПодсистемыПовтИсп");
	Результат = ИнтерфейсБСП.ОписанияПодсистем().ПоИменам;
	Возврат Результат;
	
КонецФункции

Функция ОбщийМодульПоИмениЛок(ИмяМодуля)
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		Ошибка = СтрШаблон("Общий модуль ""%1"" не найден", ИмяМодуля);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат Вычислить(ИмяМодуля);
	
КонецФункции

Функция ВерсияБухгалтерскойПодсистемы()
	
	ИмяПодсистемы = ИмяБухгалтерскойПодсистемы();
	
	ПроверитьИмяПодсистемы(ИмяПодсистемы);
	
	Если ЗначениеЗаполнено(ИмяПодсистемы) Тогда
		ПодсистемыКонфигурации = ОписанияПодсистемКонфигурации();
		ОписаниеПодсистемы = ПодсистемыКонфигурации.Получить(ИмяПодсистемы);
		Результат = ОписаниеПодсистемы.Версия;
	Иначе
		Результат = Метаданные.Версия;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяБухгалтерскойПодсистемы()
	
	ПодсистемыКонфигурации = ОписанияПодсистемКонфигурации();
	ДопустимыеИмена = ИменаПодсистемБП();
	
	Результат = Неопределено;
	
	Для Каждого ИмяПодсистемы Из ДопустимыеИмена Цикл
		
		Если ПодсистемыКонфигурации.Получить(ИмяПодсистемы) <> Неопределено Тогда
			Результат = ИмяПодсистемы;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИменаПодсистемБП()
	
	Результат = Новый Массив;
	Результат.Добавить("БухгалтерияПредприятия");
	Результат.Добавить("БухгалтерияПредприятияКОРП");
	Результат.Добавить("БухгалтерияПредприятияБазовая");
	Результат.Добавить("БухгалтерияПредприятияБазовая1");
	Результат.Добавить("БухгалтерияМолокозавода");
	Результат.Добавить("АрендаИУправлениеНедвижимостью");
	Результат.Добавить("БухгалтерияСтроительнойОрганизации");
	Результат.Добавить("БухгалтерияСельскохозяйственногоПредприятия");
	Результат.Добавить("БухгалтерияСельскохозяйственногоПредприятияКОРП");
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьИмяПодсистемы(ИмяПодсистемы)
	
	Если ЗначениеЗаполнено(ИмяПодсистемы) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонОшибки = 
	"Не удалось определить имя бухгалтерской подсистемы.
	|Имя конфигурации: %1
	|Версия конфигурации: %2
	|Наименование конфигурации: %3";
	
	Ошибка = СтрШаблон(
		ШаблонОшибки,
		Метаданные.Имя,
		Метаданные.Версия,
		Метаданные.Синоним
	);
	
	ЖурналРегистрации_ЗаписатьОшибку(Ошибка);
	
КонецПроцедуры

Процедура ЖурналРегистрации_ЗаписатьОшибку(Ошибка)
	
	Операция = "Диадок.ЧерновикиПакетовБП30";
	
	ЗаписьЖурналаРегистрации(
		Операция,
		УровеньЖурналаРегистрации.Ошибка,
		Неопределено,
		Неопределено,
		Ошибка
	);
	
КонецПроцедуры

Функция ИспользуетсяРеализацияЧерезПередачуТоваров()
	
	ВерсияБП = ВерсияБухгалтерскойПодсистемы();
	Результат = (__СтдСтр.СравнитьВерсииЛок(ВерсияБП, "3.0.116") > 0);
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяАктСверкиВзаиморасчетов3_0_131()
	
	ВерсияБП = ВерсияБухгалтерскойПодсистемы();
	Результат = (__СтдСтр.СравнитьВерсииЛок(ВерсияБП, "3.0.131") >= 0);
	
	Возврат Результат;
	
КонецФункции

Процедура ТекстЗапроса_ДополнитьОтборыАктовСверкиВзаиморасчетов3_0_131(ТекстЗапроса)
	
	ЭтоДокументКонтрагента = "";
	Если ИспользуетсяАктСверкиВзаиморасчетов3_0_131() Тогда
		ЭтоДокументКонтрагента = "И НЕ Т.ЭтоДокументКонтрагента";
