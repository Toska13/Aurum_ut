Функция ДобавитьТаблицуЧерновиков_СчетФактура_НаРеализацию(Запрос, ВидПакетаID)
	
	ВидСчетаФактуры = "НаРеализацию";
	ИмяВременнойТаблицы = СтрШаблон("Диадок_СчетФактураЧерновики_%1_%2", ВидСчетаФактуры, ВидПакетаID);
	
	Запрос.Текст = ТекстЗапроса_СчетФактураЧерновики(ИмяВременнойТаблицы, ВидПакетаID, ВидСчетаФактуры);
	Запрос.Выполнить();
	
	Возврат ИмяВременнойТаблицы;
	
