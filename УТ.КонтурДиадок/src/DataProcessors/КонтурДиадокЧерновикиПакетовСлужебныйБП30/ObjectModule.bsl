Функция ЭтоВидПакетаУПД(ВидПакетаID)
	
	ВидыПакетов = Новый Массив();
	ВидыПакетов.Добавить("ID_ОсновнойПакет");
	ВидыПакетов.Добавить("ID_УПД");
	ВидыПакетов.Добавить("ID_УПД_раздельно");
	
	Результат = ВидыПакетов.Найти(ВидПакетаID) <> Неопределено;
	
