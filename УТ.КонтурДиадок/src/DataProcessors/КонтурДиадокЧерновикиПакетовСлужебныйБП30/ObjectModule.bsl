Функция ТекстЗапроса_ПервичныеДокументыБезНДСЧерновики(ИмяВременнойТаблицы, ВидПакетаID)
	
	ТекстЗапросаВТ =
	";
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Т.Ссылка КАК Документ,
	|	Т.Номер КАК НомерДокумента,
	|	Т.Дата КАК ДатаДокумента,
	|	Т.Контрагент КАК Контрагент,
	|	Т.Организация КАК Организация,
	|	Т.СуммаДокумента КАК СуммаДокумента,
	|	&ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	ВТ_ДокументыБезНДС КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|		ПО Т.Организация = ВТ_Настройки.Организация1С
	|			И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|			И (НЕ Т.Исправление)
	|			И (НЕ Т.Корректировка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|		ПО Т.Организация = ВТ_Отправители.Организация1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|		ПО Т.Контрагент = ВТ_Получатели.Контрагент1С
	|ГДЕ
	|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|	И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДокументыБезНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Документы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПодходящиеДокументы
	|;";
	
	Если ЭтоИсправительныйВидПакета(ВидПакетаID) Тогда
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "И (НЕ Т.Исправление)", "И (Т.Исправление)");
	КонецЕсли;
	
	Если ЭтоКорректировкаРеализацииБезНДС(ВидПакетаID) Тогда
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "И (НЕ Т.Корректировка)", "И (Т.Корректировка)");
	КонецЕсли;
	
	ВидПервичногоПакета = "= ""ID_ОсновнойПакет""";
	Если ВидПакетаID <> "ID_ТОРГ12_Акт_БезНДС" Тогда
		
		ВидПервичногоПакетаПолный = СтрЗаменить(ВидПакетаID, "ID_И", "ID_");
		ВидПервичногоПакетаПолный = СтрЗаменить(ВидПервичногоПакетаПолный, "_БезНДС", "");
		ВидПервичногоПакетаРаздельно = ВидПервичногоПакетаПолный + "_Раздельно";
		
		ВидПервичногоПакета = "В (""" + ВидПервичногоПакетаПолный + """,""" + ВидПервичногоПакетаРаздельно + """)";
		
	КонецЕсли;
	
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "ВТ_Настройки.ВидПакетаID = &ВидПакетаID",
		"ВТ_Настройки.ВидПакетаID " + ВидПервичногоПакета);
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	ЧастиЗапроса = ТекстЗапроса_ВТДокументыБезНДС();
	ЧастиЗапроса.Добавить(ТекстЗапросаВТ);
	
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, Символы.ПС);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ВТДокументыБезНДС()
	
	Результат = Новый Массив;
	
	ОсновнойЗапрос = ДокументыБезНДС_ТекстЗапроса_ВТДокументы() +
	";
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Документ КАК Ссылка,
	|	ВТ_Документы.ЭтоИсправление КАК Исправление,
	|	ВТ_Документы.ЭтоКорректировка КАК Корректировка
	|ПОМЕСТИТЬ ВТ_ПодходящиеДокументы
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Документы.Документ,
	|	ВТ_Документы.ЭтоИсправление,
	|	ВТ_Документы.ЭтоКорректировка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_Документы.ВсегоПозиций) = СУММА(ВТ_Документы.ПозицийБезНДС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПодходящиеДокументы.Ссылка КАК Ссылка,
	|	ВТ_ПодходящиеДокументы.Исправление КАК Исправление,
	|	ВТ_ПодходящиеДокументы.Корректировка КАК Корректировка,
	|	ВТ_ПодходящиеДокументы.Ссылка.Проведен КАК Проведен,
	|	ВТ_ПодходящиеДокументы.Ссылка.Номер КАК Номер,
	|	ВТ_ПодходящиеДокументы.Ссылка.Дата КАК Дата,
	|	ВТ_ПодходящиеДокументы.Ссылка.Контрагент КАК Контрагент,
	|	ВТ_ПодходящиеДокументы.Ссылка.Организация КАК Организация,
	|	ВТ_ПодходящиеДокументы.Ссылка.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТ_ДокументыБезНДС
	|ИЗ
	|	ВТ_ПодходящиеДокументы КАК ВТ_ПодходящиеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО ВТ_ПодходящиеДокументы.Ссылка = СчетФактураВыданныйДокументыОснования.ДокументОснование
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка ЕСТЬ NULL";
	
	Результат.Добавить(ОсновнойЗапрос);
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.КорректировкаРеализации) Тогда
		Результат.Добавить(ТекстЗапроса_ОбъединитьВсе());
		Результат.Добавить(ДокументыБезСФ_ДобавитьТекстЗапроса_КРТУКомиссионера());
	КонецЕсли;
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ОтчетКомитентуОПродажах) Тогда
		Результат.Добавить(ТекстЗапроса_ОбъединитьВсе());
		Результат.Добавить(ДокументыБезСФ_ДобавитьТекстЗапроса_ОтчетКомитентуОПродажах());
	КонецЕсли;
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ПередачаТоваров) Тогда
		Результат.Добавить(ТекстЗапроса_ОбъединитьВсе());
		Результат.Добавить(ДокументыБезСФ_ДобавитьТекстЗапроса_ПередачаТоваров());
	КонецЕсли;
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ПередачаНМА) Тогда
		Результат.Добавить(ТекстЗапроса_ОбъединитьВсе());
		Результат.Добавить(ДокументыБезСФ_ДобавитьТекстЗапроса_ПередачаНМА());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыБезНДС_ТекстЗапроса_ВТДокументы()
	
	ИмяТабличнойЧастиТовары = "Товары";
	ИмяТабличнойЧастиУслуги = "Услуги";
	ИмяТабличнойЧастиАгентскиеУслуги = "АгентскиеУслуги";
	
	Запросы = Новый Массив;
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "АктОбОказанииПроизводственныхУслуг", ИмяТабличнойЧастиУслуги);
	
	Условие = ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураТребуется();
	ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииТоваровУслуг(Запросы, ИмяТабличнойЧастиТовары, Условие);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииТоваровУслуг(Запросы, ИмяТабличнойЧастиУслуги);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииТоваровУслуг(Запросы, ИмяТабличнойЧастиАгентскиеУслуги);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииОтгруженныхТоваров(Запросы);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияУслугПоПереработке", ИмяТабличнойЧастиУслуги);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "ПередачаОС", "ОС");
	
	Условие = ТекстЗапрос_ОтборКорректировкиВПервичныхДокументах();
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоИсправлениюРеализации(Запросы, ИмяТабличнойЧастиТовары);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоИсправлениюРеализации(Запросы, ИмяТабличнойЧастиУслуги);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоКорректировкеРеализации(Запросы, ИмяТабличнойЧастиТовары);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоКорректировкеРеализации(Запросы, ИмяТабличнойЧастиУслуги);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоКорректировкеРеализации(Запросы, ИмяТабличнойЧастиАгентскиеУслуги);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииТоваровУслугПродажаКомиссия(Запросы);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоВозвратам(Запросы);
	
	Результат = СтрСоединить(Запросы, ТекстЗапроса_ОбъединитьВсе());
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииТоваровУслуг(Запросы, ТабличнаяЧасть, Условие = "")
	
	ВидДокумента = "РеализацияТоваровУслуг";
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, ВидДокумента, ТабличнаяЧасть, Условие);
	
КонецПроцедуры

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоИсправлениюРеализации(Запросы, ТабличнаяЧасть)
	
	ВидДокумента = "КорректировкаРеализации";
	Условие = ТекстЗапрос_ОтборКорректировкиВПервичныхДокументах();
	Исправление = "Истина";
	Корректировка = "Ложь";
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, ВидДокумента, ТабличнаяЧасть, Условие, Исправление,
		Корректировка);
	
КонецПроцедуры

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоКорректировкеРеализации(Запросы, ТабличнаяЧасть)
	
	ВидДокумента = "КорректировкаРеализации";
	Условие = ТекстЗапрос_ОтборКорректировкиПоСогласованиюСторон();
	Исправление = "Ложь";
	Корректировка = "Истина";
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, ВидДокумента, ТабличнаяЧасть, Условие, Исправление,
		Корректировка);
	
КонецПроцедуры

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииТоваровУслугПродажаКомиссия(Запросы)
	
	ИмяОбъектаМетаданных = "Документ.РеализацияТоваровУслуг";
	
	ТекстЗапроса = ТекстыЗапросов_ВыборкаДокументовЗаПериод(ИмяОбъектаМетаданных);
	
	ДополнительныеУсловия = ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураНеТребуется();
	
	ТекстЗапроса = ТекстЗапроса + " И " + ДополнительныеУсловия;
	
	ДобавитьТекстЗапросаВПакет(Запросы, ТекстЗапроса);
	
КонецПроцедуры

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоВозвратам(Запросы)
	
	ОбъектМетаданных = Метаданные.Документы.ВозвратТоваровПоставщику;
	
	Если Не РазрешеноЧтениеТаблицы(ОбъектМетаданных) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = ТекстыЗапросов_ВыборкаДокументовЗаПериод(ОбъектМетаданных.ПолноеИмя());
	
	ДобавитьТекстЗапросаВПакет(Запросы, ТекстЗапроса);
	
КонецПроцедуры

Функция ДокументыБезСФ_ДобавитьТекстЗапроса_КРТУКомиссионера()
	
	Результат =
	"ВЫБРАТЬ
	|	КРТУ.Ссылка КАК Документ,
	|	ВЫБОР
	|		КОГДА КРТУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоИсправление,
	|	ВЫБОР
	|		КОГДА КРТУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоКорректировка,
	|		КРТУ.Проведен КАК Проведен,
	|	КРТУ.Номер КАК НомерДокумента,
	|	КРТУ.Дата КАК ДатаДокумента,
	|	КРТУ.Контрагент КАК Контрагент,
	|	КРТУ.Организация КАК Организация,
	|	КРТУ.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КРТУ
	|ГДЕ
	|	КРТУ.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером)
	|	И КРТУ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ КРТУ.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыБезСФ_ДобавитьТекстЗапроса_ОтчетКомитентуОПродажах()
	
	Результат = 
	"ВЫБРАТЬ
	|	ОТОП.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	ОТОП.Проведен КАК Проведен,
	|	ОТОП.Номер КАК НомерДокумента,
	|	ОТОП.Дата КАК ДатаДокумента,
	|	ОТОП.Контрагент КАК Контрагент,
	|	ОТОП.Организация КАК Организация,
	|	ОТОП.СуммаВознаграждения КАК СуммаДокумента
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ОТОП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах.Товары КАК ТоварыДокумента
	|		ПО ОТОП.Ссылка = ТоварыДокумента.Ссылка
	|ГДЕ
	|	НЕ ОТОП.ПометкаУдаления
	|	И ОТОП.СтавкаНДСВознаграждения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И ОТОП.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ТоварыДокумента.СуммаВознаграждения > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ОТОП.Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыБезСФ_ДобавитьТекстЗапроса_ПередачаТоваров()
	
	Результат =
	"ВЫБРАТЬ
	|	ШапкаПередачаТоваров.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	ШапкаПередачаТоваров.Проведен КАК Проведен,
	|	ШапкаПередачаТоваров.Номер КАК НомерДокумента,
	|	ШапкаПередачаТоваров.Дата КАК ДатаДокумента,
	|	ШапкаПередачаТоваров.Контрагент КАК Контрагент,
	|	ШапкаПередачаТоваров.Организация КАК Организация,
	|	СУММА(ТоварПередачаТоваров.Сумма) КАК СуммаДокумента
	|ИЗ
	|	Документ.ПередачаТоваров.Товары КАК ТоварПередачаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаТоваров КАК ШапкаПередачаТоваров
	|		ПО ТоварПередачаТоваров.Ссылка = ШапкаПередачаТоваров.Ссылка
	|ГДЕ
	|	НЕ ШапкаПередачаТоваров.ПометкаУдаления
	|	И ТоварПередачаТоваров.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И ШапкаПередачаТоваров.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ШапкаПередачаТоваров.Ссылка,
	|	ШапкаПередачаТоваров.Проведен,
	|	ШапкаПередачаТоваров.Номер,
	|	ШапкаПередачаТоваров.Дата,
	|	ШапкаПередачаТоваров.Контрагент,
	|	ШапкаПередачаТоваров.Организация";
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыБезСФ_ДобавитьТекстЗапроса_ПередачаНМА()
	
	Результат =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	Т.Проведен КАК Проведен,
	|	Т.Номер КАК НомерДокумента,
	|	Т.Дата КАК ДатаДокумента,
	|	Т.Контрагент КАК Контрагент,
	|	Т.Организация КАК Организация,
	|	СУММА(Т.СуммаДокумента) КАК СуммаДокумента
	|ИЗ
	|	Документ.ПередачаНМА КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка,
	|	Т.Проведен,
	|	Т.Номер,
	|	Т.Дата,
	|	Т.Контрагент,
	|	Т.Организация";
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииОтгруженныхТоваров(Запросы)
	
	ОбъектМетаданных = Метаданные.Документы.РеализацияОтгруженныхТоваров;
	
	Если НЕ РазрешеноЧтениеТаблицы(ОбъектМетаданных) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Документ,
	|	1 КАК ВсегоПозиций,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПозицийБезНДС,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК ТабличнаяЧасть
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияОтгруженныхТоваров КАК Т
	|		ПО ТабличнаяЧасть.Ссылка = Т.ДокументОтгрузки
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	ДобавитьТекстЗапросаВПакет(Запросы, ТекстЗапроса);
	
КонецПроцедуры

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(
	Запросы,
	ВидДокумента,
	ТабличнаяЧасть,
	Условие = "",
	Исправление = "Ложь",
	Корректировка = "Ложь")
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ВидДокумента);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РазрешеноЧтениеТаблицы(МетаданныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ТабличнаяЧасть) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Документ,
	|	1 КАК ВсегоПозиций,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПозицийБезНДС,
	|	&Исправление КАК ЭтоИсправление,
	|	&Корректировка КАК ЭтоКорректировка
	|ИЗ
	|	&Таблица КАК ТабличнаяЧасть
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПолноеИмяДокумента КАК Т
	|		ПО ТабличнаяЧасть.Ссылка = Т.Ссылка
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода" + Условие;
	
	Документ = МетаданныеДокумента.ПолноеИмя();
	Таблица = Документ + "." + ТабличнаяЧасть;
	
	Результат = СтрЗаменить(Результат, "ПолноеИмяДокумента", Документ);
	Результат = СтрЗаменить(Результат, "&Таблица", Таблица);
	Результат = СтрЗаменить(Результат, "&Исправление", Исправление);
	Результат = СтрЗаменить(Результат, "&Корректировка", Корректировка);
	
	ДобавитьТекстЗапросаВПакет(Запросы, Результат);
	
КонецПроцедуры

Функция ТекстЗапрос_ОтборКорректировкиВПервичныхДокументах()
	
	Результат =
	" И Т.ВидОперации = 
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапрос_ОтборКорректировкиПоСогласованиюСторон()
	
	Результат =
	" И Т.ВидОперации = 
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение)";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураНеТребуется()
	
	ВидыОпераций = Новый Массив;
	ВидыОпераций.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.ПродажаКомиссия)");
	
	Если ИспользуетсяРеализацияЧерезПередачуТоваров() Тогда 
		ВидыОпераций.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.ПередачаТоваров)");
	КонецЕсли;
	
	ШаблонУсловия = "Т.ВидОперации В (%1)";
	
	ВидыИсправленийСтрокой = СтрСоединить(ВидыОпераций, ",");
	
	Результат = СтрШаблон(ШаблонУсловия, ВидыИсправленийСтрокой);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураТребуется()
	
	ОсновноеУсловие = ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураНеТребуется();
	
	ШаблонУсловия = " И НЕ (%1)";
	
	Результат = СтрШаблон(ШаблонУсловия, ОсновноеУсловие);
	
	Возврат Результат;
	
