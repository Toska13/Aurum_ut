// Получает авторизованых пользователей
// 
// Возвращаемое значение:
// 	ТаблицаЗначений - списсок атворизованных пользователей в модуле
//
Функция АвторизованныеПользователи() Экспорт
	
	АвторизованныеПользователи = АвторизованныеПользователиИзХранилища();	
	Результат = НовыйТаблицаАвторизованныеПользователи(); 
	
	Для Каждого Элемент Из АвторизованныеПользователи Цикл	
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Ид = Элемент.Значение.Пользователь.Идентификатор;
		НоваяСтрока.Пользователь = Элемент.Значение.Пользователь.Представление;
		НоваяСтрока.Почта = Элемент.Значение.Пользователь.Логин;
		НоваяСтрока.СостояниеКартинка = 1;
		НоваяСтрока.СхемаАутентификации = Элемент.Значение.СхемаАутентификации;
		НоваяСтрока.СпособВхода = СпособВходаПоСхеме(Элемент.Значение.СхемаАутентификации);
		НоваяСтрока.Сессия = Сессия(НоваяСтрока.Ид, Элемент.Значение.СхемаАутентификации);
		НоваяСтрока.СессияЖива = НоваяСтрока.Сессия <> Неопределено 
			И НоваяСтрока.Сессия.УниверсальнаяДатаОкончания > ТекущаяУниверсальнаяДата();
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует настройки организаций по авторизованным пользователеям
// 
// Параметры:
//	УчетныеЗаписи - МассивСтруктур - Данные об авторизованных пользователях 
//	
// Возвращаемое значение:
// 	ТаблицаЗначений - настройки авторизации организаций
//
Функция НастройкиОрганизаций(УчетныеЗаписи) Экспорт
	
	Результат = НовыйТаблицаОрганизаций();
	СохраненныеНастройки = _Ядро().КонтекстСеанса_СтрокиКонтекста(Истина);
	НеАктивныеСохраненныеНастройки = НеАктивныеНастройки();
	
	Для Каждого Строка Из УчетныеЗаписи Цикл
		
		Если Строка.Сессия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Список = _Ядро().Организации_ДоступныеОрганизации(Строка.Сессия);
		Пользователь = Строка.Сессия.Пользователь;
		
		Для Каждого Элемент  Из Список Цикл
			
			Настройка = НайтиСохраненнуюНастройку(Элемент.BoxId, СохраненныеНастройки, НеАктивныеСохраненныеНастройки);
			
			Отбор = Новый Структура("БоксИд");
			Отбор.БоксИд = Элемент.BoxId;
			НайденныеСтроки = Результат.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТаблицаОрганизацийЗаполнитьДубльСтроки(НайденныеСтроки, Настройка, Пользователь.Идентификатор);
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Ид = Элемент.OrgId;
			НоваяСтрока.БоксИд = Элемент.BoxId;
			НоваяСтрока.Наименование = Элемент.Наименование;
			НоваяСтрока.ИНН = Элемент.ИНН;
			НоваяСтрока.КПП = Элемент.КПП;                                                                                                                               
			НоваяСтрока.ПользовательИд = Строка.Ид;
			НоваяСтрока.ПользовательПредставление = _Ядро().СтдСтр().СтрШаблонЛок(
				"%1 (%2)", Пользователь.Представление, Пользователь.Логин);
			НоваяСтрока.ТарифСтартовый = _Ядро().КонтурШлюзАвторизации_ЭтоСтартовыйТариф(НоваяСтрока.БоксИд, Строка.Сессия);
			
			ТаблицаОрганизацийПользователиДобавитьВСтроку(НоваяСтрока, Строка.Ид);
			
			Если НоваяСтрока.ТарифСтартовый Тогда
				НоваяСтрока.Наименование = _Ядро().СтдСтр().СтрШаблонЛок("(Тариф ""Стартовый"") %1", НоваяСтрока.Наименование);
			КонецЕсли; 
			
			Если Настройка <> Неопределено Тогда	
				ТаблицаОрганизацийДополнитьСтрокуСохраненнымиНастройками(НоваяСтрока, Настройка);	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Сортировать("Наименование Возр");
	Возврат Результат;
	
КонецФункции

// Записывает информацию об ошибке при авторизации
//
// Параметры:
//	ИнформацияОбОшибке - ИнформацияОбОшибке - Информация об ошибке
//	ДопПеременные - Структура - Дополнительные параметры
//
Процедура ОбработатьОшибкуПолученияСессииВызовСервера(Знач ИнформацияОбОшибке, Знач ДопПеременные) Экспорт

	_Ядро().Метрика_ДобавитьОшибку("Авторизация", "ПолучитьСессию", ИнформацияОбОшибке, ДопПеременные);
	_Ядро().Ошибка_Обработать("Авторизация", ИнформацияОбОшибке);
	
КонецПроцедуры

// Записывает настройки для не активных организаций
//
// Параметры:
//  Настройки - Соответствие - данные для сохранения
//
Процедура СохранитьНеАктивныеНастройкиОрганизаций(Настройки) Экспорт

	СохранитьНеАктивныеНастройки(Настройки);
	
КонецПроцедуры

// Проверяет возможность авторизоваться в браузере
// 
// Параметры:
//	Опции - Структура - Функциональные опции 
//	
// Возвращаемое значение:
// 	Булеов - Истина, если опция включена
//
Функция ИспользоватьАутентификациюЧерезПортал(Опции) Экспорт

	Возврат НРег(Опции.Получить("Authorization.Tab.PortalV2")) = "true";
	
КонецФункции

// Проверяет возможность авторизоваться по сертификату
// 
// Параметры:
//	Опции - Структура - Функциональные опции 
//	
// Возвращаемое значение:
// 	Булеов - Истина, если опция включена
//
Функция ИспользоватьАутентификациюПоСертификату(Опции) Экспорт

	Возврат НРег(Опции.Получить("Authorization.Tab.CertificateV2")) = "true";
	
КонецФункции

// Устанавливает объект Ядра в свойства объекта
//
// Параметры:
//	Значение - Произвольный - Объекта Ядра
//
Процедура УстановитьЯдро(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		ВызватьИсключение "Пустое значение устанавливаемой зависимости";
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	_Ядро = Значение;               
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры

// Сохраняет сессию в хранилище общих настроек
//
// Параметры:
//	Сессия - ФиксированнаяСтруктура - Объект сесси в моделе Диадок
//	Ид - Строка - Идентификатор настройки
//
Процедура СохранитьСессию(Сессия, Ид) Экспорт

	Сессии = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаСессий(), КлючНастроекСессий());
	
	Если Сессии = Неопределено Тогда
		Сессии = Новый Соответствие;
	КонецЕсли;
	
	Сессии.Вставить(Ид, Сессия);
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаСессий(), КлючНастроекСессий(), Сессии);
	
КонецПроцедуры

// Удаляет сессию из хранилища общих настроек
//
// Параметры:
//	Ид - Строка - Идентификатор настройки
//
Процедура УдалитьСессию(Ид) Экспорт

	Сессии = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаСессий(), КлючНастроекСессий());
	
	Если Сессии = Неопределено Тогда
		Сессии = Новый Соответствие;
	КонецЕсли;
	
	Сессии.Удалить(Ид);
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаСессий(), КлючНастроекСессий(), Сессии);
	
КонецПроцедуры

// Пользователи сервиса

// Добавляет авторизованного пользователя в хранилище общих настроек
//
// Параметры:
//	Пользователь - Структура - описание пользователяПользователь
//	Схема - Строка - Схема, по которой был аутентифицирован пользователь
//
Процедура АвторизованныеПользователиДобавить(Пользователь, Схема) Экспорт
	
	Настройка = АвторизованныеПользователиИзХранилища();
	
	Если ТипЗнч(Настройка) <> Тип("Соответствие") Тогда
		Настройка = Новый Соответствие;
	КонецЕсли;
	
	ЗначениеНастройки = Новый Структура("Пользователь, СхемаАутентификации");
	ЗначениеНастройки.Пользователь = Пользователь;
	ЗначениеНастройки.СхемаАутентификации = Схема;
	
	Настройка.Вставить(Пользователь.Идентификатор, ЗначениеНастройки);
	
	_Ядро().ХранилищеОбщихНастроек_Поместить(КлючАвторизованныеПользователи(), Настройка);
	
КонецПроцедуры

// Удаляет данные пользователя из хранилища общих настроек
//
// Параметры:
//	Пользователи - Массив - список ид пользователей
//
Процедура ЗавершитьРаботуПользователейЛок(Пользователи) Экспорт
	
	Для Каждого Пользователь Из Пользователи Цикл
		
		АвторизованныеПользователиУдалить(Пользователь.Ид);
		УдалитьНастройкиОрганизаций(Пользователь.Организации);
		
		Если Пользователь.Сессия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Пользователь.Сессия.СхемаАутентификации = "oidc/device_flow" Тогда
			УдалитьПортальнуюСессию(Пользователь.Ид);	
		ИначеЕсли Пользователь.Сессия.СхемаАутентификации = "dd_auth/certificate" Тогда
			УдалитьСессию(Пользователь.Ид);
		ИначеЕсли Пользователь.Сессия.СхемаАутентификации = "dd_auth/password" Тогда
			ВызватьИсключение "Не реализованно";
		Иначе
			ВызватьИсключение "Не ожидаемая схема аутентификации";
		КонецЕсли;
		
	КонецЦикла;
	
	ПерезаполнитьНастройкиХранилища();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЗАВИСИМОСТИ

Функция _Ядро()
	
	Возврат _Ядро;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ

Процедура ТаблицаОрганизацийЗаполнитьДубльСтроки(СтрокиТаблицы, Настройка, ПользовательИд)
	
	Для Каждого НайденнаяСтрока Из СтрокиТаблицы Цикл
		
		ТаблицаОрганизацийПользователиДобавитьВСтроку(НайденнаяСтрока, ПользовательИд);
		Если Настройка <> Неопределено Тогда
			ТаблицаОрганизацийДополнитьСтрокуСохраненнымиНастройками(НайденнаяСтрока, Настройка);	
		Иначе	
			НайденнаяСтрока.ПользовательПредставление = "Выберите пользователя";
			НайденнаяСтрока.ПользовательИд = "";
			НайденнаяСтрока.СертификатОтпечаток = "";
			НайденнаяСтрока.СертификатПодписи = "";
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ТаблицаОрганизацийДополнитьСтрокуСохраненнымиНастройками(СтрокаТаблицы, Настройка)
	
	СтрокаТаблицы.Использовать = Настройка.Использовать;
	СтрокаТаблицы.ПользовательИд = Настройка.Значение.ОписаниеПользователя.Id;
	СтрокаТаблицы.ПользовательПредставление = _Ядро().СтдСтр().СтрШаблонЛок(
				"%1 (%2)", Настройка.Значение.Сессия.Пользователь.Представление, Настройка.Значение.Сессия.Пользователь.Логин);
	
	Если ЗначениеЗаполнено(Настройка.Значение.Сертификат) Тогда
		СтрокаТаблицы.СертификатОтпечаток = Настройка.Значение.Сертификат.ОтпечатокСертификата;
		СтрокаТаблицы.СертификатПодписи = Настройка.Значение.Сертификат.Наименование;
	КонецЕсли;
	
КонецПроцедуры

Процедура ТаблицаОрганизацийПользователиДобавитьВСтроку(СтрокаТаблицы, Ид)
	
	Если ТипЗнч(СтрокаТаблицы.Пользователи) = Тип("ФиксированныйМассив") Тогда
		Значение = Новый Массив(СтрокаТаблицы.Пользователи);
	Иначе
		Значение = Новый Массив;
	КонецЕсли;                                             
	
	Значение.Добавить(Ид);
	СтрокаТаблицы.Пользователи = Новый ФиксированныйМассив(Значение);	
	
КонецПроцедуры
	
Процедура УдалитьПортальнуюСессию(Ид)

	Аутх = Аутентификатор(Ид);
	Аутх.ЗавершитьСессию();
	
КонецПроцедуры

Процедура АвторизованныеПользователиУдалить(Идентификатор)
	
	Настройка = АвторизованныеПользователиИзХранилища();
	НоваяНастройка = Новый Соответствие;
	
	Если ТипЗнч(Настройка) <> Тип("Соответствие") Тогда
		Настройка = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого Элемент Из Настройка Цикл
		Если Элемент.Значение.Пользователь.Идентификатор = Идентификатор Тогда 
			Продолжить;
		КонецЕсли;
		НоваяНастройка.Вставить(Элемент.Значение.Пользователь.Идентификатор, Элемент.Значение);
	КонецЦикла;
	
	_Ядро().ХранилищеОбщихНастроек_Поместить(КлючАвторизованныеПользователи(), НоваяНастройка);
	
КонецПроцедуры

Процедура УдалитьНастройкиОрганизаций(БоксИдОрганизаций) Экспорт
	
	УдалитьНастройкиАктивныхПользователей(БоксИдОрганизаций);
	УдалитьНастройкиНеАктивныхПользователей(БоксИдОрганизаций);
	
КонецПроцедуры

Процедура ПерезаполнитьНастройкиХранилища()

	Настройки = _Ядро().КонтекстСеанса_СтрокиКонтекста(Истина);
	Аутх = _Ядро().АутхКонфигурацияПриложенияПоУмолчанию();
	_Ядро().КонтекстСеанса_ЗаписатьНастройки(Настройки, Аутх);
		
КонецПроцедуры

Процедура УдалитьНастройкиАктивныхПользователей(БоксИдОрганизаций)

	Для Каждого Ид Из БоксИдОрганизаций Цикл
		_Ядро().КонтекстСеанса_УдалитьСтроку(Ид);		
	КонецЦикла;	
	
КонецПроцедуры

Процедура УдалитьНастройкиНеАктивныхПользователей(БоксИдОрганизаций)

	Настройки = НеАктивныеНастройки();
	
	Для Каждого Ид Из БоксИдОрганизаций Цикл
		Настройки.Удалить(Ид);		
	КонецЦикла;

	СохранитьНеАктивныеНастройки(Настройки);	
	
КонецПроцедуры

Процедура СохранитьНеАктивныеНастройки(Значение)
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНеАктивныеНастройкиАвторизации(),
		КлючНастроекНеАктивныеНастройкиАвторизации(),
		Значение);
		
КонецПроцедуры
	
Функция АвторизованныеПользователиИзХранилища()
	
	Результат = _Ядро().ХранилищеОбщихНастроек_Прочитать(КлючАвторизованныеПользователи());
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючАвторизованныеПользователи()

	Возврат "ДиадокАвторизованныеПользователи";
	
КонецФункции

Функция НовыйТаблицаАвторизованныеПользователи()

	// Должна соответствовать КонтурДиадокЭДО.Формы.АвторизацияНоваяУправляемая.ТаблицаПльзователи
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("Пользователь");
	Результат.Колонки.Добавить("Почта"); 
	Результат.Колонки.Добавить("СхемаАутентификации");
	Результат.Колонки.Добавить("СпособВхода");
	Результат.Колонки.Добавить("Состояние");
	Результат.Колонки.Добавить("Сессия");
	Результат.Колонки.Добавить("Ид");
	Результат.Колонки.Добавить("СессияЖива");
	Результат.Колонки.Добавить("СостояниеКартинка");
	
	Возврат Результат;
	
КонецФункции

Функция НовыйТаблицаОрганизаций()
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("Наименование");
	Результат.Колонки.Добавить("Ид");
	Результат.Колонки.Добавить("ИНН");
	Результат.Колонки.Добавить("КПП");
	Результат.Колонки.Добавить("ПользовательИд");
	Результат.Колонки.Добавить("Пользователи"); // Пользователи, у которых есть доступ к этой организации
	Результат.Колонки.Добавить("СертификатПодписи");
	Результат.Колонки.Добавить("БоксИд");
	Результат.Колонки.Добавить("Использовать");
	Результат.Колонки.Добавить("ПользовательПредставление");
	Результат.Колонки.Добавить("ТарифСтартовый");
	Результат.Колонки.Добавить("СертификатОтпечаток");
	
	Возврат Результат;
	
КонецФункции

Функция НеАктивныеНастройки()
	
	Результат = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНеАктивныеНастройкиАвторизации(), 
		КлючНастроекНеАктивныеНастройкиАвторизации()); 
		
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСохраненнуюНастройку(БоксИд, СохраненныеНастройки, НеАктивныеСохраненныеНастройки)
	
	Результат = Новый Структура;
	Результат.Вставить("Значение");
	Результат.Вставить("Использовать");
		
	Если СохраненныеНастройки.Получить(БоксИд) <> Неопределено Тогда
		Результат.Значение = СохраненныеНастройки.Получить(БоксИд);
		Результат.Использовать = Истина;
	ИначеЕсли НеАктивныеСохраненныеНастройки.Получить(БоксИд) <> Неопределено Тогда
		Результат.Значение = НеАктивныеСохраненныеНастройки.Получить(БоксИд);
		Результат.Использовать = Ложь;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СпособВходаПоСхеме(СхемаАутентификации)
	
	Схемы = _Ядро().Перечисление_СхемыАутентификации();
	Если СхемаАутентификации = Схемы.ПорталБраузер Тогда
		Результат = "Портал";
	ИначеЕсли СхемаАутентификации = Схемы.ДиадокСертификат Тогда
		Результат = "Сертификат";
	ИначеЕсли СхемаАутентификации = Схемы.ДиадокПароль Тогда
		Результат = "Логин";
	Иначе
		ВызватьИсключение "Не ожидаемая схема аутентификации";
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Функция Аутентификатор(Ид)
	
	Ядро = _Ядро();
	
	Провайдер = Ядро.АутхКонфигурацияПровайдера();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Приложение = Ядро.АутхКонфигурацияПриложения();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ядро.Модуль_Аутентификатор(Провайдер, Приложение, Ид);
	
КонецФункции

// Сессии - сертифика

// Получает сессию в моделе Диадок из хранилища общих настроек
// 
// Параметры:
//	ПользовательИд - Строка - Идентификатор настройки
//	СхемаАутентификации - Строка - Схема аутентификации
//	
// Возвращаемое значение:
// 	ФиксированнаяСтруктура - Объект сесси в моделе Диадок
//
Функция Сессия(ПользовательИд, СхемаАутентификации)
	
	Результат = Неопределено;
	Сессии = Сессии();
	Схемы = _Ядро().Перечисление_СхемыАутентификации();
			
	Если СхемаАутентификации = Схемы.ПорталБраузер Тогда
		Сессия = Аутентификатор(ПользовательИд).ПолучитьСессию();
		Если Сессия = Неопределено И Сессии.Получить(ПользовательИд) = Неопределено Тогда
			Результат = Неопределено;                                                           
		Иначе
			Попытка
				Результат = _Ядро().Новый_СессияПорталБраузер(ПользовательИд, Сессия);
			Исключение
				Результат = Неопределено;
			КонецПопытки;
			СохранитьСессию(Результат, ПользовательИд);
		КонецЕсли;
	ИначеЕсли СхемаАутентификации = Схемы.ДиадокСертификат Тогда
		Результат = Сессии.Получить(ПользовательИд);
		Если Результат <> Неопределено И Результат.УниверсальнаяДатаОкончания < ПрогнозируемоеВремяОкончаниеСессии() Тогда
			Результат = ОбновитьСессиюПоСертификату(Результат);
			СохранитьСессию(Результат, ПользовательИд);
		КонецЕсли;	
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция Сессии()

	Результат = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаСессий(), КлючНастроекСессий());
	
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбновитьСессиюПоСертификату(Сессия)

	ТокенДоступа = _Ядро().Авторизация_ПоСертификату(Сессия.Ключ);
	Возврат _Ядро().Новый_СессияДиадокСертификат(Сессия.Ключ, ТокенДоступа);
			
КонецФункции

Функция ПрогнозируемоеВремяОкончаниеСессии()
	
	Возврат ТекущаяУниверсальнаяДата() + ЧасыВСекундах(ПрогнозируемаяДлительностьСессии());
	
КонецФункции

Функция ПрогнозируемаяДлительностьСессии()
	
	Возврат 4;
	
КонецФункции

Функция ЧасыВСекундах(КоличествоЧасов)

	Возврат СекундВМинуте() * МинутВЧасе() * КоличествоЧасов;
	
КонецФункции

