// Получает ссылку на обработку ХранениеДанных (КонтурДиадокХранениеДанных) для вызовов API.
//
// Возвращаемое значение:
//  ХранениеДанных - ОбработкаОбъект - экземпляр КонтурДиадокХранениеДанных.
//
Функция КонтурДиадокХранениеДанных()
	
	ПолноеИмяТипа = "DataProcessorObject.КонтурДиадокХранениеДанных";
	Если _ЭтоВнешняяОбработка() Тогда
		ПолноеИмяТипа = "ExternalDataProcessorObject.КонтурДиадокХранениеДанных";
	КонецЕсли;
	
	Результат = Новый(ПолноеИмяТипа);
	
	Возврат Результат;
	
КонецФункции

Функция СтдСтр()
	
	Если СтдСтрЛок = Неопределено Тогда
		Если _ЭтоВнешняяОбработка() Тогда
			СтдСтрЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			СтдСтрЛок = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтдСтрЛок;
	
КонецФункции

Функция _ЭтоВнешняяОбработка()
	
	Если ЭтоВнешняяОбработкаКэш = Неопределено Тогда
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		ЭтоВнешняяОбработкаКэш = (ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено);
		
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработкаКэш;
	
КонецФункции

// СВОЙСТВА

Процедура ЗаписатьСвойство(Объект, ИмяСвойства, Значение)
	
	МодульХранения = КонтурДиадокХранениеДанных();
	МодульХранения.ДопРеквизиты_УстановитьЗначение_Диадок(
		Объект,
		ИмяСвойства,
		Значение,
		""
	);
	
КонецПроцедуры

// ДОПОЛНИТЕЛЬНЫЕ ОБРАБОТКИ

Функция ОписаниеЗащитыБезПредупреждений()
	
	Попытка
		Результат = Новый("ОписаниеЗащитыОтОпасныхДействий");
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат <> Неопределено Тогда
		Результат.ПредупреждатьОбОпасныхДействиях = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
