// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС (совместимость с МенеджерПлагиновV3)

// Возвращает сведений об установленных в модуле плагинах
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Сведения об установленных в модуле плагинах
//   * ID - Строка - Идентификатор плагина
//   * Версия - Строка - Версия плагина
//   * Включен - Булево - Истина, если плагин активен
//   * Представление - Строка - Название плагина
//
Функция КонтурПлагины_ПолучитьСписокУстановленныхПлагинов() Экспорт
	
	ИмяСправочникаПлагинов = КонтурПлагины_ИмяСправочникаПлагинов();
	
	СвойстваПлагина = "ID,Версия,Включен,Представление";
	
	МодульХранения = КонтурДиадокХранениеДанных();
	Результат = МодульХранения.ДопСправочники_СписокЭлементов_Диадок(
		ИмяСправочникаПлагинов,
		СвойстваПлагина
	);
	
	Возврат Результат;
	
КонецФункции

// Добавляет или обновляет плагин в справочник КонтурПлагины.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - файл плагина;
//  ИдентификаторПлагина - Строка - идентификатор загружаемого плагина;
//  Версия - Строка - версия плагина;
//  Включен - Булево - Истина, если плагин включен
//  Представление - Строка - (Необязательный) название плагина;
//
Процедура КонтурПлагины_ЗаписатьПлагин(ДвоичныеДанные, Знач Идентификатор, Знач Версия, Знач Включен, Знач Представление = "") Экспорт
	
	ИмяСправочникаПлагинов = КонтурПлагины_ИмяСправочникаПлагинов();
	
	МодульХранения = КонтурДиадокХранениеДанных();
	ПлагинСсылка = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(
		ИмяСправочникаПлагинов,
		Идентификатор
	);
	
	Если ЗначениеЗаполнено(ПлагинСсылка) Тогда
		
		ТекОбъект = ПлагинСсылка.ПолучитьОбъект();
		ТекОбъект.ДополнительныеРеквизиты.Очистить();
		
	Иначе
		
		ТекОбъект = МодульХранения.ДопСправочники_СоздатьЭлемент_Диадок(
			ИмяСправочникаПлагинов,
			Представление
		);
		
	КонецЕсли;
	
	МодульХранения.ОбновитьЗначениеДопРеквизитаДиадок(
		ТекОбъект,
		"ID",
		Идентификатор,
		Представление
	);
	
	МодульХранения.ОбновитьЗначениеДопРеквизитаДиадок(
		ТекОбъект,
		"Версия",
		Версия,
		""
	);
	
	МодульХранения.ОбновитьЗначениеДопРеквизитаДиадок(
		ТекОбъект,
		"Включен",
		Включен,
		""
	);
	
	МодульХранения.ОбновитьЗначениеДопРеквизитаДиадок(
		ТекОбъект,
		"Представление",
		Представление,
		""
	);
	
	МодульХранения.ОбновитьЗначениеДопРеквизитаДиадок(
		ТекОбъект,
		"ДвоичныеДанные",
		Новый ХранилищеЗначения(ДвоичныеДанные),
		""
	);
	
	ТекОбъект.Записать();
	
КонецПроцедуры

// Удаляет плагин из справочника КонтурПлагины
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина, который будет удален
//
Процедура КонтурПлагины_УдалитьПлагин(ИдентификаторПлагина) Экспорт
	
	ИмяСправочникаПлагинов = КонтурПлагины_ИмяСправочникаПлагинов();
	
	МодульХранения = КонтурДиадокХранениеДанных();
	ПлагинСсылка = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(
		ИмяСправочникаПлагинов,
		ИдентификаторПлагина
	);
	
	ОбъектПлагина = ПлагинСсылка.ПолучитьОбъект();
	ОбъектПлагина.ОбменДанными.Загрузка = Истина;
	ОбъектПлагина.Удалить();
	
КонецПроцедуры

// Возвращает двоичные данные файла плагина
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//  ДвоичныеДанные - Файл плагина в виде двоичных данных
//
Функция КонтурПлагины_ПрочитатьФайлПлагина(ИдентификаторПлагина) Экспорт
	
	ИмяСвойства = "ДвоичныеДанные";
	
	Результат = КонтурПлагины_ПрочитатьСвойствоПлагина(
		ИдентификаторПлагина,
		ИмяСвойства
	);
	
	Возврат Результат;
	
КонецФункции

// Возвращает настройки плагина.
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//  Произвольный - Сохраненные настройки плагина
//
Функция КонтурПлагины_ПрочитатьНастройкиПлагина(ИдентификаторПлагина) Экспорт
	
	ИмяСвойства = "НастройкиПлагина";
	
	Результат = КонтурПлагины_ПрочитатьСвойствоПлагина(
		ИдентификаторПлагина,
		ИмяСвойства
	);
	
	Возврат Результат;
	
КонецФункции

// Сохраняет настройки плагина
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
//  Настройки - Произвольный - Данные настроек плагина
//
Процедура КонтурПлагины_СохранитьНастройкиПлагина(ИдентификаторПлагина, Настройки) Экспорт
	
	ИмяСвойства = "НастройкиПлагина";
	
	ЗначениеСвойства = Новый ХранилищеЗначения(Настройки);
	
	КонтурПлагины_ЗаписатьСвойствоПлагина(
		ИдентификаторПлагина,
		ИмяСвойства,
		ЗначениеСвойства
	);
	
КонецПроцедуры

// Включает или отключает использование плагина в модуле
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
//  ВключитьПлагин - Булево - Истина, если плагин нужно включить
//
Процедура КонтурПлагины_ВключитьОтключитьПлагин(ИдентификаторПлагина, ВключитьПлагин) Экспорт
	
	ИмяСвойства = "Включен";
	
	КонтурПлагины_ЗаписатьСвойствоПлагина(
		ИдентификаторПлагина,
		ИмяСвойства,
		ВключитьПлагин
	);
	
КонецПроцедуры

// Возвращает ссылку на плагин
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//  СправочникСсылка.Диадок_ДополнительныеСправочники - Ссылка на плагин в объектах подсистемы Диадок
//
Функция КонтурПлагины_ПрочитатьСсылкуПлагина(ИдентификаторПлагина) Экспорт
	
	ИмяСправочникаПлагинов = КонтурПлагины_ИмяСправочникаПлагинов();
	
	МодульХранения = КонтурДиадокХранениеДанных();
	Результат = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(
		ИмяСправочникаПлагинов,
		ИдентификаторПлагина
	);
	
	Возврат Результат;
	
КонецФункции

// Возвращает версию плагина
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//  Строка, Неопределено - Версия плагина. Неопределено если нет свойства версии.
//
Функция КонтурПлагины_ПрочитатьВерсиюПлагина(ИдентификаторПлагина) Экспорт
	
	ИмяСвойства = "Версия";
	
	Результат = КонтурПлагины_ПрочитатьСвойствоПлагина(
		ИдентификаторПлагина,
		ИмяСвойства
	);
	
	Возврат Результат;
	
КонецФункции

// Возвращает состояние плагина: включен или выключен
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//  Булево, Неопределено - Истина если плагин включен. Неопределено или Ложь если плагин выключен.
//
Функция КонтурПлагины_ПрочитатьСостояниеПлагина(ИдентификаторПлагина) Экспорт
	
	ИмяСвойства = "Включен";
	
	Результат = КонтурПлагины_ПрочитатьСвойствоПлагина(
		ИдентификаторПлагина,
		ИмяСвойства
	);
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение свойства плагина
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
//  ИмяСвойства - Строка - Имя свойства плагина
// 
// Возвращаемое значение:
//  Произвольный - Значение свойства плагина
//
Функция КонтурПлагины_ПрочитатьСвойствоПлагина(ИдентификаторПлагина, ИмяСвойства)
	
	ИмяСправочникаПлагинов = КонтурПлагины_ИмяСправочникаПлагинов();
	
	МодульХранения = КонтурДиадокХранениеДанных();
	ПлагинСсылка = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(
		ИмяСправочникаПлагинов,
		ИдентификаторПлагина
	);
	
	Результат = МодульХранения.ДопРеквизиты_Значение_Диадок(
		ПлагинСсылка,
		ИмяСвойства
	);
	
	Возврат Результат;
	
КонецФункции

// Записывает значение свойства плагина
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина
//  ИмяСвойства - Строка - Имя свойства плагина
//  ЗначениеСвойства - Произвольный - Значение свойства
//
Процедура КонтурПлагины_ЗаписатьСвойствоПлагина(ИдентификаторПлагина, ИмяСвойства, ЗначениеСвойства)
	
	ИмяСправочникаПлагинов = КонтурПлагины_ИмяСправочникаПлагинов();
	
	МодульХранения = КонтурДиадокХранениеДанных();
	ПлагинСсылка = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(
		ИмяСправочникаПлагинов,
		ИдентификаторПлагина
	);
	
	МодульХранения.ДопРеквизиты_УстановитьЗначение_Диадок(
		ПлагинСсылка,
		ИмяСвойства,
		ЗначениеСвойства,
		""
	);
	
КонецПроцедуры

Функция КонтурПлагины_ИмяСправочникаПлагинов()
	Возврат "КонтурПлагины";
КонецФункции

