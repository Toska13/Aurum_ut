// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Возвращает структуру отбора для Список
// См. КонтурДиадокМенеджерПлагиновХранилище.МодельОтборСписка()
// 
// Возвращаемое значение:
//  Структура - :
//  * Проект - Строка - Идентификатор группы плагинов для заданного продукта в системе хранения
//
Функция МодельОтборСписка() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Проект");
	
	Возврат Модель;
	
КонецФункции

// Возвращает список плагинов из ХранениеДанных
// Формат таблицы: Ид, Версия, Представление, Состояние, Проект
// См. КонтурДиадокМенеджерПлагиновХранилище.Список()
//
// Параметры:
//  Отбор - Структура - отбор по полю "Проект" (Строка).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ид, Версия, Представление, Состояние, Проект.
//
Функция Список(Отбор) Экспорт
	
	ТаблицаИсточник = КонтурПлагины_ПолучитьСписокУстановленныхПлагинов();
	
	ИдВключен = _СостоянияПлагина().Включен;
	ИдОтключен = _СостоянияПлагина().Отключен;
	
	ИмяТипаСтрока = "Строка";
	ТипСтрока = Новый ОписаниеТипов(ИмяТипаСтрока);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ид", ТипСтрока);
	Результат.Колонки.Добавить("Версия", ТипСтрока);
	Результат.Колонки.Добавить("Представление", ТипСтрока);
	Результат.Колонки.Добавить("Состояние", ТипСтрока);
	Результат.Колонки.Добавить("Проект", ТипСтрока);
	
	Для Каждого СтрокаИсходная Из ТаблицаИсточник Цикл
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Ид = СтрокаИсходная.ID;
		НоваяСтрока.Версия = СтрокаИсходная.Версия;
		НоваяСтрока.Представление = СтрокаИсходная.Представление;
		НоваяСтрока.Состояние = ИдОтключен;
		Если СтрокаИсходная.Включен <> Неопределено
			И СтрокаИсходная.Включен Тогда
			НоваяСтрока.Состояние = ИдВключен;
		КонецЕсли;
		
		НоваяСтрока.Проект = Отбор.Проект;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает экземпляр внешней обработки плагина по описанию.
// Двоичные данные читаются через Ядро.КонтурПлагины_ПрочитатьФайлПлагина, создаётся временный .epf.
// Имя Получить - контракт интерфейса хранилища (см. КонтурДиадокМенеджерПлагиновХранилище.Получить()).
//
// Параметры:
//  ОписаниеПлагина - Структура - поле Ид (Строка), идентификатор плагина;
//  ПараметрыПлагина - Неопределено, Структура - параметры свойств плагина (необяз.);
//  Каталог - Неопределено, Строка - каталог отладки (необяз.).
//
// Возвращаемое значение:
//  ВнешняяОбработка - экземпляр плагина.
//
// BSLLS:FunctionNameStartsWithGet-off
Функция Получить(ОписаниеПлагина, ПараметрыПлагина = Неопределено, Каталог = Неопределено) Экспорт
	
	ИдПлагина = ОписаниеПлагина.Ид;
	
	ДвоичныеДанные = КонтурПлагины_ПрочитатьФайлПлагина(ИдПлагина);
	
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	ДвоичныеДанные.Записать(ИмяФайла);
	Результат = СоздатьВнешняяОбработка(ИмяФайла);
	// BSLLS:UsingSynchronousCalls-off
	УдалитьФайлы(ИмяФайла);
	// BSLLS:UsingSynchronousCalls-on
	Если ПараметрыПлагина <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, ПараметрыПлагина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент(ОписаниеПлагина) Экспорт
	
	ИдПлагина = ОписаниеПлагина.Ид;
	
	СсылкаПлагина = КонтурПлагины_ПрочитатьСсылкуПлагина(ИдПлагина);
	ВерсияПлагина = КонтурПлагины_ПрочитатьВерсиюПлагина(ИдПлагина);
	Включен = КонтурПлагины_ПрочитатьСостояниеПлагина(ИдПлагина);
	ДвоичныеДанные = КонтурПлагины_ПрочитатьФайлПлагина(ИдПлагина);
	
	Модель = Новый Структура;
	Модель.Вставить("Ссылка", СсылкаПлагина);
	Модель.Вставить("Ид", ИдПлагина);
	Модель.Вставить("Хранилище", Новый ХранилищеЗначения(ДвоичныеДанные));
	Модель.Вставить("Версия", ВерсияПлагина);
	Модель.Вставить("Состояние", _СостоянияПлагина().Отключен);
	Если Включен <> Неопределено
		И Включен Тогда
		Модель.Вставить("Состояние", _СостоянияПлагина().Включен);
	КонецЕсли;
	Модель.Вставить("Приложение", ОписаниеПлагина.Проект);
	
	Возврат Новый ФиксированнаяСтруктура(Модель);
	
КонецФункции

Функция Сохранить(ОписаниеПлагина, Контент) Экспорт
	
	ИдПлагина = ОписаниеПлагина.Ид;
	ВерсияПлагина = ОписаниеПлагина.Версия;
	ПредставлениеПлагина = Неопределено;
	Если ОписаниеПлагина.Свойство("Представление") Тогда
		ПредставлениеПлагина = ОписаниеПлагина.Представление;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПредставлениеПлагина) Тогда
		ПредставлениеПлагина = ИдПлагина;
	КонецЕсли;
	
	ДвоичныеДанные = Контент.Данные;
	Включен = Ложь;
	
	КонтурПлагины_ЗаписатьПлагин(
		ДвоичныеДанные,
		ИдПлагина,
		ВерсияПлагина,
		Включен,
		ПредставлениеПлагина);
	
	// В старом хранилище здесь возвращалась ссылка на объект хранилища;
	// для backend СХ1 эта ссылка не используется, поэтому возвращаем Неопределено.
	Возврат Неопределено;
	
КонецФункции

Процедура Удалить(ОписаниеПлагина) Экспорт
	
	КонтурПлагины_УдалитьПлагин(ОписаниеПлагина.Ид);
	
КонецПроцедуры

Процедура Включить(ОписаниеПлагина) Экспорт
	
	КонтурПлагины_ВключитьОтключитьПлагин(
		ОписаниеПлагина.Ид,
		Истина);
	
КонецПроцедуры

Процедура Отключить(ОписаниеПлагина) Экспорт
	
	КонтурПлагины_ВключитьОтключитьПлагин(
		ОписаниеПлагина.Ид,
		Ложь);
	
КонецПроцедуры

Процедура УстановитьСостояние(ОписаниеПлагина, Состояние) Экспорт
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если Состояние = _СостоянияПлагина().Включен Тогда
		Включить(ОписаниеПлагина);
	ИначеЕсли Состояние = _СостоянияПлагина().Отключен Тогда
		Отключить(ОписаниеПлагина);
	КонецЕсли;
	// Для состояний ТребуетсяНастройка, ЕстьОшибки, НеИспользуется
	// отдельного хранения в ХранениеДанных нет; оставляем значение без изменений.
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Функция Протестировать(ОписаниеПлагина) Экспорт
	
	Плагин = Получить(ОписаниеПлагина);
	
	Результат = Плагин.ПротестироватьПлагин();
	
	Возврат Результат;
	
КонецФункции

Функция Манифест(ОписаниеПлагина) Экспорт
	
	Плагин = Получить(ОписаниеПлагина);
	
	Результат = Плагин.МанифестПлагина();
	
	Возврат Результат;
	
КонецФункции

Функция ПодключитьВнешняяОбработка(АдресОбработки, Имя = Неопределено) Экспорт
	
	// BSLLS:UsingExternalCodeTools-off
	ИмяОбработки = ВнешниеОбработки.Подключить(АдресОбработки, Имя, Ложь);
	// BSLLS:UsingExternalCodeTools-on
	Возврат ИмяОбработки;
	
КонецФункции

Функция СоздатьВнешняяОбработка(ПолноеИмяФайла) Экспорт
	
	Файл = Новый Файл(ПолноеИмяФайла);
	Если Не Файл.Существует() Тогда
		ВызватьИсключение "Для загрузки, плагин должен находиться в каталоге отладки";
	КонецЕсли;
	
	ЗащитаОтОпасныхДействий = ОписаниеЗащитыБезПредупреждений();
	
	Если СтдСтр().ВерсияПлатформыБольшеИлиРавна("8.3.11")
		Или ЗащитаОтОпасныхДействий <> Неопределено Тогда
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ПолноеИмяФайла, Ложь, ЗащитаОтОпасныхДействий);
		// BSLLS:UsingExternalCodeTools-on
	ИначеЕсли СтдСтр().ВерсияПлатформыБольшеИлиРавна("8.3.11")
		Или ЗащитаОтОпасныхДействий = Неопределено Тогда
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ПолноеИмяФайла, Ложь);
		// BSLLS:UsingExternalCodeTools-on
	Иначе
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ПолноеИмяФайла);
		// BSLLS:UsingExternalCodeTools-on
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// BSLLS:FunctionNameStartsWithGet-on

// Возвращает настройки плагина из подсистемы ХранениеДанных
//
// Параметры:
//  ОписаниеПлагина - Структура, Строка - описание плагина (структура с полем Ид) или идентификатор (Строка).
//
// Возвращаемое значение:
//  Структура, Строка - настройки плагина (формат зависит от хранилища).
//
Функция НастройкиПлагина(ОписаниеПлагина) Экспорт
	
	Если ТипЗнч(ОписаниеПлагина) = Тип("Строка") Тогда
		ИдПлагина = ОписаниеПлагина;
	Иначе
		ИдПлагина = ОписаниеПлагина.Ид;
	КонецЕсли;
	
	Возврат КонтурПлагины_ПрочитатьНастройкиПлагина(ИдПлагина);
	
КонецФункции

// Сохраняет настройки плагина в подсистему ХранениеДанных
//
// Параметры:
//  ОписаниеПлагина - Структура - описание плагина с полем Ид (Строка);
//  Настройки - Произвольный - настройки плагина для сохранения.
//
Процедура СохранитьНастройкиПлагина(ОписаниеПлагина, Настройки) Экспорт
	
	Если ТипЗнч(ОписаниеПлагина) = Тип("Строка") Тогда
		ИдПлагина = ОписаниеПлагина;
	Иначе
		ИдПлагина = ОписаниеПлагина.Ид;
	КонецЕсли;
	
	КонтурПлагины_СохранитьНастройкиПлагина(ИдПлагина, Настройки);
	
КонецПроцедуры

// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ИзменитьСвойства(ОписаниеПлагина, НовыеЗначения) Экспорт
	
	Контент = Контент(ОписаниеПлагина);
	Для Каждого Значение Из НовыеЗначения Цикл
		
		Если Значение.Ключ = "Ид" Тогда
			КлючСвойства = "ID";
		Иначе
			Продолжить;
		КонецЕсли;
		
		ЗаписатьСвойство(Контент.Ссылка, КлючСвойства, Значение.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

Функция _СостоянияПлагина() Экспорт
	
	Если СостоянияПлагинаКэш = Неопределено Тогда 
		
		СостоянияПлагинаКэш = Новый Структура;
		СостоянияПлагинаКэш.Вставить("Включен", "Включен");
		СостоянияПлагинаКэш.Вставить("Отключен", "Отключен");
		СостоянияПлагинаКэш.Вставить("ТребуетсяНастройка", "Требуется настройка");
		
	КонецЕсли;
	
	Возврат СостоянияПлагинаКэш;
	
КонецФункции

