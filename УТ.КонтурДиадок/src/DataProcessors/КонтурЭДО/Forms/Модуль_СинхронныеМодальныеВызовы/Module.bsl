//{		ОБЕРТКИ ДЛЯ СИНХРОННЫХ МЕТОДОВ КЛИЕНТА

&НаКлиенте
Функция смв_СохранитьДвоичныеДанныеВоВременныйФайл(ДвоичныеДанные, ИмяФайла) Экспорт
	
	Если НЕ ПроверитьРасширениеРаботыСФайламиВебКлиент() Тогда
		
		ТаймаутЛок = 30;
		смв_ПоказатьПредупреждение(
			,
			"Не подключено Расширения для работы с файлами. Обратитесь к администратору для решения проблемы.",
			ТаймаутЛок
		);
		Возврат Неопределено;
		
	КонецЕсли;
	
	Каталог = Вычислить("КаталогВременныхФайлов()");
	
	Результат = смв_СохранитьДвоичныеДанныеВФайл(ДвоичныеДанные, ИмяФайла, Каталог);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция смв_СохранитьДвоичныеДанныеВФайл(ДвоичныеДанные, Знач ИмяФайла, Каталог) Экспорт
	
	Если НЕ ПроверитьРасширениеРаботыСФайламиВебКлиент() Тогда
		
		ТаймаутЛок = 30;
		смв_ПоказатьПредупреждение(
			,
			"Не подключено Расширения для работы с файлами. Обратитесь к администратору для решения проблемы.",
			ТаймаутЛок
		);
		Возврат Неопределено;
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = ЗаменитьНедопустимыеСимволыИмениФайлаЛок(ИмяФайла);
	Иначе
		ИмяФайла = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Результат = ОбъединитьПутиЛок(Каталог, ИмяФайла);
	
	#Если ВебКлиент Тогда
		
		ПолучаемыйФайл = Новый ОписаниеПередаваемогоФайла;
		ПолучаемыйФайл.Имя = Результат;
		
		Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
			ПолучаемыйФайл.Хранение = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Вычислить("УникальныйИдентификатор"));
		Иначе
			ПолучаемыйФайл.Хранение = ДвоичныеДанные;
		КонецЕсли;
		
		МассивФайлов = Новый Массив;
		МассивФайлов.Добавить(ПолучаемыйФайл);
		
		ПолученныеФайлы = Новый Массив;
		РезультатПолученияФайлов = ПолучитьФайлы(МассивФайлов, ПолученныеФайлы, , Ложь);
		УдалитьИзВременногоХранилища(ПолучаемыйФайл.Хранение);
		
	#Иначе
		
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДвоичныеДанные);
		КонецЕсли;
		
		ДвоичныеДанные.Записать(Результат);
		
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

