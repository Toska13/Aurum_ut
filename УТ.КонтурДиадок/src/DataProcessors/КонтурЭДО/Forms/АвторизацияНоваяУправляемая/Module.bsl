////////////////////////////////////////////////////////////////////////////////
// ОбработчикиСобытийФормы
 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбщийКонтекстКлиентСервер", Объект.ОбщийКонтекстКлиентСервер);
	
	// BSLLS:UnusedLocalVariable-off
	Опции = Модуль_ЯдроНаСервере().ОбщийКонтекст_Прочитать("ФункциональныеОпции");
	ПутьКФормам = ОбработкаОбъект().Метаданные().ПолноеИмя() + ".Форма.";
	Заголовок = "Авторизация: Пользователи";
	// BSLLS:UnusedLocalVariable-off
	ОбновитьСписокПользователейНаСервере();
	ОбновитьОтборПользователь();
	
	УстановитьУсловноеОформление();	
	УстановитьСтатичныеИзображения();
	СкрытьПодчиненныеЭлементы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// BSLLS:UnusedLocalVariable-off
	ЕстьПолучитьСтрокиДляОбработки = Стд().Стр().ВерсияПлатформыБольшеИлиРавна("8.5.1");
	// BSLLS:UnusedLocalVariable-on
	ПодключитьОбработчикОжидания("ОтложенноеОткрытие", Интервал01(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если УбратьПроверкиПередЗакрытием Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "";
	
	Если ТаблицаПользователи.Количество() = 0 Тогда
		ИмяОповещения = "_ПослеВопросаДобавитьПользователя";
		ТекстВопроса = "Не выбран пользователь для работы в модуле. Хотите добавить пользователя?";
		ЗаписатьМетрикуПроверкаНастроек("СписокПользователейПуст");
	КонецЕсли;
	
	Если ТекстВопроса = "" И Не ПроверитьНастройкиОрганизацииВыбраны() Тогда
		ИмяОповещения = "_ПослеВопросаДобавитьОрганизацию";
		ТекстВопроса = "Не выбрано ни одной организации для работы в модуле? Хотите выбрать организацию?";
		ЗаписатьМетрикуПроверкаНастроек("СписокОрганизацийПуст");
	КонецЕсли;
	
	Если ТекстВопроса <> "" Тогда
		Отказ = Истина;
		Оповещение = Стд().ОбщегоНазначения().ОписаниеОповещения(ИмяОповещения, ЭтаФорма);
		Стд().Диалоги().ПоказатьВопросЛок(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
	Если Модифицированность И Отказ = Ложь Тогда
		Отказ = Истина;
		Текст = "Вы уверены, что хотите закрыть форму? Внесенные изменения не будут сохранены.";
		Оповещение = Стд().ОбщегоНазначения().ОписаниеОповещения("_ПослеВопросаМодифицированностьЗакрытие", ЭтаФорма);
		Стд().Диалоги().ПоказатьВопросЛок(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СлужебнынйПрограммныйИнтерфейс

&НаКлиенте
Процедура _ПослеПолученияСессии(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВызватьИсключение "Не удалось авторизоваться";
	КонецЕсли;
	
	ОбновитьСписокПользователейНаСервере();
	ОбновитьОтборПользователь();
	ПерейтиСписокПользователей();
	
	Переменные = Новый Соответствие;
	Переменные.Вставить("СхемаАутентификации", Результат.СхемаАутентификации);
	Переменные.Вставить("UserId", Результат.Пользователь.Идентификатор);
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().СоздатьСессию, 
		"Авторизоваться", 
		Переменные, 
		ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура _ПослеПоказатьОшибкуНевалидныйКлючАПИ(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_НажатиеКнопки(
		"КлючАпиНеДействителен", 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().НекорректныйКлючАпи, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().СкачатьОбновлениеМодуля, 
		"Нажатие кнопки");
	
	ВладелецФормы.ОсновнаяФорма().ОткрытьФормуОбновления();
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику_СУчетомЗаполненияКонтекста(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().НекорректныйКлючАпи, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().СкачатьОбновлениеМодуля);
	
КонецПроцедуры

&НаКлиенте
Процедура _ПослеВопросаЗавершитьСессии(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееКоличество = ТаблицаПользователи.Количество();
	
	ЗавершитьРаботуВыделенныхПользователейНаСервере();
	
	Переменные = Новый Соответствие;
	Переменные.Вставить("КоличествоПользователей", Строка(ТекущееКоличество - ТаблицаПользователи.Количество()));
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация,
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().УдалитьПользователя,
		"ЗавершитьРаботуПользователя ",
		Переменные,
		ИмяФормы,
		Модуль_ЯдроНаКлиенте().TraceId());
	
КонецПроцедуры

&НаКлиенте
Процедура _ПослеВопросаЗавершитьСессию(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьРаботуПользователяНаСервере(ДопПараметры.ДанныеСтроки.ПолучитьИдентификатор());
	
	Переменные = Новый Соответствие;
	Переменные.Вставить("КоличествоПользователей", "1");
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация,
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().УдалитьПользователя,
		"ЗавершитьРаботу ",
		Переменные,
		ИмяФормы,
		Модуль_ЯдроНаКлиенте().TraceId());
		
КонецПроцедуры

&НаКлиенте
Процедура _ПослеВопросаДобавитьПользователя(Результат, ДопПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	УбратьПроверкиПередЗакрытием = Истина;  
	// BSLLS:UnusedLocalVariable-on
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура _ПослеВопросаДобавитьОрганизацию(Результат, ДопПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	УбратьПроверкиПередЗакрытием = Истина;  
	// BSLLS:UnusedLocalVariable-on
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура _ПослеВыбораСертификатаПодписание(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	Модифицированность = Истина;
	// BSLLS:UnusedLocalVariable-on
	СтрокаТаблицы = ТаблицаОрганизацийТекущаяСтрока();
	
	СтрокаТаблицы.СертификатОтпечаток = Результат.Отпечаток;
	СтрокаТаблицы.СертификатПодписи = Результат.Представление;
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_НажатиеКнопки(
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().ВыборСертификатаДляПодписи, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().Сохранить, 
		"НажатиеКнопки",
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().TraceId());
		
КонецПроцедуры

&НаКлиенте
Процедура _АвторизацияПослеВыбораСертификата(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	_ОтпечатокКэш = Результат.Отпечаток;
	// BSLLS:UnusedLocalVariable-on
	
	// Вызывать через обработчик ожидания, нужно чтобы отработало ПоказатьПредупреждение
	ПодключитьОбработчикОжидания("_ПродолжитьАутентификациюПоСертификату", Интервал01(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура _ПослеВопросаМодифицированностьЗакрытие(Результат, ДопПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	УбратьПроверкиПередЗакрытием = Истина;  
	// BSLLS:UnusedLocalVariable-on
	Закрыть();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ДекорацияНужнаПомощьНажатие(Элемент)
	
	Платформа().ЦентрПоддержки_Открыть("", ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПользовательПредставлениеПриИзменении(Элемент)
	
	ОтборПользовательЗначение = ОтборПользовательПредставление;
	Если ЗначениеЗаполнено(ОтборПользовательПредставление) Тогда
		ОтборПользовательПредставление = Элемент.СписокВыбора.НайтиПоЗначению(ОтборПользовательЗначение).Представление;
	КонецЕсли;
	
	УстановитьОтборОрганизаций();
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_НажатиеКнопки(
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
		"ФильтрПользователь", 
		"НажатиеКнопки",
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().TraceId());

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборОрганизаций()

	Отбор = Новый Структура;
	
	Если ЗначениеЗаполнено(ОтборПользовательЗначение) Тогда
		Отбор.Вставить("ПользовательИд", ОтборПользовательЗначение);
	КонецЕсли;	
	
	Если Отбор.Количество() = 0 Тогда                                                
		Элементы.ТаблицаОрганизаций.ОтборСтрок = Неопределено;
	Иначе
		Элементы.ТаблицаОрганизаций.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОрганизацийПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Или Элемент.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаОрганизацийПользовательПредставление" Тогда
		ЗаполнитьСписокВыбораПользователями(
			Элементы.ТаблицаОрганизацийПользовательПредставление.СписокВыбора, 
			Элемент.ТекущиеДанные.Пользователи);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОрганизацийПользовательПредставлениеПриИзменении(Элемент)

	// BSLLS:UnusedLocalVariable-off
	Модифицированность = Истина;
	// BSLLS:UnusedLocalVariable-on

	СтрокаТаблицы = ТаблицаОрганизацийТекущаяСтрока();
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ПользовательПредставление) Тогда
		
		Отбор = Новый Структура("Ид");
		Отбор.Ид = СтрокаТаблицы.ПользовательПредставление;
		НайденныеСтроки = ТаблицаПользователи.НайтиСтроки(Отбор);
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			Представление = Модуль_ЯдроНаКлиенте()._СтдСтр().СтрШаблонЛок("%1 (%2)", Элемент.Пользователь, Элемент.Почта);
			СтрокаТаблицы.ПользовательИд = Элемент.Ид;
			СтрокаТаблицы.ПользовательПредставление = Представление;
		КонецЦикла;
		
		Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_НажатиеКнопки(
			ИмяФормы, 
			Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
			Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ВыборПользователя, 
			"НажатиеКнопки",
			ИмяФормы, 
			Модуль_ЯдроНаКлиенте().TraceId());
		
	Иначе
		
		СтрокаТаблицы.ПользовательИд = "";
		СтрокаТаблицы.ПользовательПредставление = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОрганизацийСертификатПодписиОчистка(Элемент, СтандартнаяОбработка)
	
	ОбработатьОчисткаСертификата();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОрганизацийСертификатПодписиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораСертификата();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПользователиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;	
	ТребуетсяАвторизация = Поле.Имя = "ТаблицаПользователиСостояние" И ТекущиеДанные.Состояние = "Войти";
	
	Если ТребуетсяАвторизация И ТекущиеДанные.СпособВхода = "Логин" Тогда
		ТекстОшибки = "Авторизация по логину больше не поддерживается. 
		|Завершите текущую сессию, и авторизуйтесь через браузер%1.";
		Если ИспользоватьАутентификациюПоСертификату() Тогда
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", " или по сертификату");
		Иначе
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", "");
		КонецЕсли;
		Стд().Диалоги().ПоказатьПредупреждениеЛок(, ТекстОшибки);
	ИначеЕсли ТребуетсяАвторизация Тогда
		ОбновитьУстаревшуюАвторизацию(Элемент.ТекущиеДанные);                                                          
	ИначеЕсли Поле.Имя = "ТаблицаПользователиСостояние" И ТекущиеДанные.Состояние = "Завершить работу" Тогда
		ЗавершитьРаботуПользователяНаКлиенте(ТекущиеДанные);
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

