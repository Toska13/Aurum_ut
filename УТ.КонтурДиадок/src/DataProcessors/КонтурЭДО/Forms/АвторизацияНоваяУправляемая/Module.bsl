	Если Не НастройкиЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	УбратьПроверкиПередЗакрытием = Истина;
	// BSLLS:UnusedLocalVariable-on
	ОбновитьСписокСертификатов();
	СохранитьНеАктивныеНастройки();
	Настройки = НастройкиАвторизации(Истина);
	
	ЗаписатьМетрикуСтатистикиНастроек();
	Закрыть(Настройки);
	
