&НаКлиенте
Процедура ЗаполнитьСписокВыбораПользователями(СписокВыбора, Пользователи)
	
	СписокВыбора.Очистить();
	
	Для Каждого Ид Из Пользователи Цикл
		НайденныеСтроки = ТаблицаПользователи.НайтиСтроки(Новый Структура("Ид", Ид));
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Строка.СессияЖива = Ложь Тогда
				Продолжить;
			КонецЕсли;
			Представление = Модуль_ЯдроНаКлиенте()._СтдСтр().СтрШаблонЛок("%1 (%2)", Строка.Пользователь, Строка.Почта);
			СписокВыбора.Добавить(Строка.Ид, Представление, Ложь);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

