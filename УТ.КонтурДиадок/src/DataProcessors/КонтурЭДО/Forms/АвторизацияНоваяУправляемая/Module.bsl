&НаКлиенте
Функция НастройкиЗаполнены()
	
	Если Не ПроверитьНастройкиОрганизацииВыбраны() Тогда
		Стд().Диалоги().ПоказатьПредупреждениеЛок(, "Не выбрано ни одной организации для работы.");
		ЗаписатьМетрикуПроверкаНастроек("НеВыбранаОрганизация");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьНастройкиЗаполнениеПользователей() Тогда
		Стд().Диалоги().ПоказатьПредупреждениеЛок(, 
			"Выберите пользователей для всех организаций, с которыми планируете работать.");
		ЗаписатьМетрикуПроверкаНастроек("НеВыбранПользователь");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьНастройкиСертификатов() Тогда
		Стд().Диалоги().ПоказатьПредупреждениеЛок(, 
			"Не выбран сертификат для всех организаций, с которыми планируете работать.");
		ЗаписатьМетрикуПроверкаНастроек("ОтсутствуетСертификат ");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьНастройкиТарифы() Тогда
		Стд().Диалоги().ПоказатьПредупреждениеЛок(, "Одновременное использование разных тарифных планов невозможно.
		|Выберите организации, которые используют один тарифный план.");
		ЗаписатьМетрикуПроверкаНастроек("ВыбраныОрганизацииСРазнымиТарифами");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
