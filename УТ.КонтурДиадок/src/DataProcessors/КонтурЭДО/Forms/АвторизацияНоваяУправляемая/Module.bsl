&НаКлиенте
Функция НастройкиАвторизации(Активные)

	Данные = Новый Массив;
	
	Для Каждого НастройкаОрганизации Из ТаблицаОрганизаций Цикл
		
		Если Не НастройкаОрганизации.Использовать = Активные Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаПользователи.НайтиСтроки(Новый Структура("Ид", НастройкаОрганизации.ПользовательИд));
		Для Каждого Элемент Из НайденныеСтроки Цикл
			
			Настройки = Новый Структура;
			Настройки.Вставить("Ид");
			Настройки.Вставить("Сертификат");
			Настройки.Вставить("БоксИд");
			Настройки.Вставить("Сессия");
			
			Настройки.Ид = НастройкаОрганизации.БоксИд;
			Настройки.Сертификат = НайтиСертификат(НастройкаОрганизации.СертификатОтпечаток);
			Настройки.БоксИд = НастройкаОрганизации.БоксИд;
			Настройки.Сессия = Элемент.Сессия;
			
			Данные.Добавить(Настройки);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СформироватьНастройкиНаСервере(Данные);
	
КонецФункции

&НаКлиенте
Функция НайтиСертификат(Отпечаток)
	
	Если ЗначениеЗаполнено(Отпечаток) = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаСертификатов.НайтиСтроки(Новый Структура("ОтпечатокСертификата", Отпечаток));
	
	Результат = Неопределено;
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Результат = Модуль_ЯдроНаКлиенте().Сертификаты_Контракт_ОписаниеСертификата();
		ЗаполнитьЗначенияСвойств(Результат, НайденныеСтроки[0]);
		
		Результат.Вставить("Base64", Модуль_ЯдроНаКлиенте().Сертификаты_СертификатВBase64(Отпечаток));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЯвляетсяОшибкойКатегории(Знач Ошибка, Знач Категория)
	
	Если Категория = ОшибкаСертификатНеАвторизован() Тогда
		Результат = ЭтоОшибкаСертификатНеАвторизован(Ошибка);
	ИначеЕсли Категория = ОшибкаНеверныйКлючАПИ() Тогда
		Результат = ЭтоОшибкаНеверныйКлючАПИ(Ошибка);
	ИначеЕсли Категория = ОшибкаНеверныйЛогинПароль() Тогда
		Результат = ЭтоОшибкаНеверныйЛогинПароль(Ошибка);
	ИначеЕсли Категория = ОшибкаКриптоПользовательНеВвелПинкод() Тогда
		Результат = ЭтоОшибкаКриптоПользовательНеВвелПинкод(Ошибка);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Функция ЭтоОшибкаСертификатНеАвторизован(Знач Ошибка)
	
	ТекстОшибки = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	
	// HTTP-ответ с ошибкой вида "401 Certificate with thumbprint <ОТПЕЧАТОК> is not authorized"
	Результат = Стд().Стр().СтрНайтиЛок(ТекстОшибки, "401") 
		И Стд().Стр().СтрНайтиЛок(ТекстОшибки, "certificate with thumbprint") 
		И Стд().Стр().СтрНайтиЛок(ТекстОшибки, "is not authorized");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоОшибкаНеверныйКлючАПИ(Знач Ошибка)
	
	ТекстОшибки = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	
	Результат = Стд().Стр().СтрНайтиЛок(ТекстОшибки, "invalid api client id") > 0;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоОшибкаНеверныйЛогинПароль(Знач Ошибка)
	
	ТекстОшибки = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	
	// HTTP-ответ с ошибкой вида "401 Wrong password provided for login <user@mail>"
	Результат = Стд().Стр().СтрНайтиЛок(ТекстОшибки, "401") 
		И Стд().Стр().СтрНайтиЛок(ТекстОшибки, "wrong password provided for login");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоОшибкаКриптоПользовательНеВвелПинкод(Знач Ошибка)
	
	ТекстОшибки = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	
	// Источник ошибки - библиотека CRYPTOAPI
	// Десятичный код ошибки - 2148532334
	// Шестнадцатиричный код ошибки - 0x8010006E
	Результат = Стд().Стр().СтрНайтиЛок(ТекстОшибки, НРег("CRYPTOAPI[0x8010006E]")) > 0;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьУстаревшуюАвторизацию(ТекущиеДанные)
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_НажатиеКнопки(
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ВыполнитьАвторизацию, 
		ТекущиеДанные.СпособВхода,
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().TraceId());
	
	Если ТекущиеДанные.СпособВхода = "Портал" Тогда
		АутентификацияНаПортале();
	ИначеЕсли ТекущиеДанные.СпособВхода = "Сертификат" Тогда
		Если ТекущиеДанные.Сессия = Неопределено Тогда
			АутентификацияПоСертификату();
		Иначе
			// BSLLS:UnusedLocalVariable-off
			_ОтпечатокКэш = ТекущиеДанные.Сессия.Ключ;
			// BSLLS:UnusedLocalVariable-on
			_ПродолжитьАутентификациюПоСертификату();         
		КонецЕсли;
	Иначе
