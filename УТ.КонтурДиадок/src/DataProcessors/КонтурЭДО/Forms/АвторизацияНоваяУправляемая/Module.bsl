Процедура ОбновитьСписокСертификатов()
	
	ТаблицаСертификатов.Очистить();	
	
	Попытка
		
		Сертификаты = Модуль_ЯдроНаКлиенте().Сертификаты_СписокСертификатов();
		
	Исключение
		
		Сертификаты = Новый Массив;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ДопПеременные = Новый Соответствие;
		ДопПеременные.Вставить("Идентификатор ошибки", "НетДоступаКСертификатам");
		
		Модуль_ЯдроНаКлиенте().Метрика_ДобавитьОшибку_СУчетомЗаполненияКонтекста(
			Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация, 
			Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ОткрытиеФормы, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке), 
			ДопПеременные);
			
	КонецПопытки;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		НоваяСтрока = ТаблицаСертификатов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Сертификат);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОшибкуАвторизации(ИнформацияОбОшибке, ТипАвторизации)
	
	Контекст = Новый Соответствие;
	Контекст.Вставить("ТипАвторизации", ТипАвторизации);
	
	Если ЯвляетсяОшибкойКатегории(ИнформацияОбОшибке, ОшибкаНеверныйКлючАПИ()) Тогда
		
		Контекст.Вставить(ИдентификаторОшибки(), "НекорректныйКлючАпи");
		ОбработатьОшибкуПолученияСессииВызовСервера(ИнформацияОбОшибке, Контекст);
		
		ПоказатьОшибкуНевалидныйКлючАПИ();
		
	ИначеЕсли ЯвляетсяОшибкойКатегории(ИнформацияОбОшибке, ОшибкаСертификатНеАвторизован()) Тогда
		
		Контекст.Вставить(ИдентификаторОшибки(), "НетДоступа");
		ОбработатьОшибкуПолученияСессииВызовСервера(ИнформацияОбОшибке, Контекст);
		
		ПоказатьОшибкуСертификатНеАвторизован();
		
	ИначеЕсли ЯвляетсяОшибкойКатегории(ИнформацияОбОшибке, ОшибкаКриптоПользовательНеВвелПинкод()) Тогда
		
		// BSLLS:Typo-off
		Контекст.Вставить(ИдентификаторОшибки(), "ПользовательОтказалсяОтВводаПинкода");
		// BSLLS:Typo-on
		ОбработатьОшибкуПолученияСессииВызовСервера(ИнформацияОбОшибке, Контекст);
		
		ПоказатьОшибкуКриптоПользовательНеВвелПинкод();
		
	Иначе
		
		Контекст.Вставить(ИдентификаторОшибки(), "НеизвестнаяОшибка");
		ОбработатьОшибкуПолученияСессииВызовСервера(ИнформацияОбОшибке, Контекст);
		
		ВызватьИсключение ИнформацияОбОшибке.Описание;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораСертификата()
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьПоведение_ДействиеСФормой(
		ИмяФормы, 
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().ВыборСертификатаДляПодписи,  
		Истина, 
		"НажатиеКнопки",
		, 
		Модуль_ЯдроНаКлиенте().TraceId());
		
	Если ЗначениеЗаполнено(Элементы.ТаблицаОрганизаций.ТекущиеДанные.ПользовательИд) = Ложь Тогда
		Стд().Диалоги().ПоказатьПредупреждениеЛок(, "Выберите пользователя.");
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаПользователи.НайтиСтроки(
		Новый Структура("Ид", Элементы.ТаблицаОрганизаций.ТекущиеДанные.ПользовательИд));
	Если НайденныеСтроки.Количество() = 0 Тогда
		ВызватьИсключение "Не удалось получить сессию пользователя";
	КонецЕсли;
			
	СервисныеСертификаты = СервисныеСертификатыНаСервере(
		Элементы.ТаблицаОрганизаций.ТекущиеДанные.БоксИд, НайденныеСтроки[0].Сессия);
		
	Отбор = Новый Массив;
	Для Каждого Элемент Из СервисныеСертификаты Цикл
		Отбор.Добавить(Элемент.Отпечаток);
	КонецЦикла;
	
	ФиксированныйОтбор = Новый ФиксированныйМассив(Отбор);
	ПараметрыФормы = Новый Структура("ОтборСертификатов", ФиксированныйОтбор);
	
	Оповещение = Стд().ОбщегоНазначения().ОписаниеОповещения("_ПослеВыбораСертификатаПодписание", ЭтаФорма);
			
	ФормаСертификатов = Платформа().ПолучитьФормуОбработки("ВыборСертификатаУправляемая", ЭтаФорма, ПараметрыФормы);
	ФормаСертификатов.ОткрытьЭтуФорму(Оповещение);
                
КонецПроцедуры

