&НаКлиенте
Процедура АутентификацияНаПортале()

	Оповещение = Платформа().НовыйОписаниеОповещения("_ПослеПолученияСессии", ЭтаФорма);
	
	Попытка

		Платформа().Авторизация_НачатьПолучениеСессииЧерезБраузерV2(Оповещение);
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОбработатьОшибкуАвторизации(ИнформацияОбОшибке, ТипАвторизацииПортал());

	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура АутентификацияПоСертификату()
	
	Оповещение = Стд().ОбщегоНазначения().ОписаниеОповещения("_АвторизацияПослеВыбораСертификата", ЭтаФорма);
	
	ФормаСертификатов = Платформа().ПолучитьФормуОбработки("ВыборСертификатаУправляемая", ЭтаФорма);
	ФормаСертификатов.ОткрытьЭтуФорму(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуПользователяНаКлиенте(ДанныеСтроки)

	ДопПараметры = Новый Структура("ДанныеСтроки");
	ДопПараметры.ДанныеСтроки = ДанныеСтроки;
	
	Оповещение = Стд().ОбщегоНазначения().ОписаниеОповещения("_ПослеВопросаЗавершитьСессию", ЭтаФорма, ДопПараметры);
	
	ТекстВопроса = "Вы точно хотите завершить этот сеанс? 
	|Список доступных организаций обновится с учетом оставшихся пользователей.";
	Стд().Диалоги().ПоказатьВопросЛок(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьРаботуВыделенныхПользователейНаСервере()
	
	ОбновитьСписокОрганизацийНаСервере();
	МассивПользователей = Новый Массив;
	ВыделенныеСтроки = ВыделенныеСтрокиЭлементаТаблицы(Элементы.ТаблицаПользователи);
	
	Для Каждого Ид Из ВыделенныеСтроки Цикл
		
		СтрокаПользователя = ТаблицаПользователи.НайтиПоИдентификатору(Ид);
		
		НастройкиОрганизаций = ТаблицаОрганизаций.НайтиСтроки(Новый Структура("ПользовательИд", СтрокаПользователя.Ид));
		Организации = Новый Массив;
		Для Каждого Настройка Из НастройкиОрганизаций Цикл
			Организации.Добавить(Настройка.БоксИд);		
		КонецЦикла;
		
		Элемент = Новый Структура("Ид, Сессия, Организации");
		Элемент.Ид = СтрокаПользователя.Ид;
		Элемент.Сессия = СтрокаПользователя.Сессия;
		Элемент.Организации = Организации;		
		
		МассивПользователей.Добавить(Элемент);		
		
	КонецЦикла;
	
	Модуль_ЯдроНаСервере().НастройкиАвторизации().ЗавершитьРаботуПользователейЛок(МассивПользователей);		
	ОбновитьСпискиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьРаботуПользователяНаСервере(Ид)
	
	ОбновитьСписокОрганизацийНаСервере();
	МассивПользователей = Новый Массив;
	
	СтрокаПользователя = ТаблицаПользователи.НайтиПоИдентификатору(Ид);
	
	НастройкиОрганизаций = ТаблицаОрганизаций.НайтиСтроки(Новый Структура("ПользовательИд", СтрокаПользователя.Ид));
	Организации = Новый Массив;
	Для Каждого Настройка Из НастройкиОрганизаций Цикл
		Организации.Добавить(Настройка.БоксИд);		
	КонецЦикла;
	
	Элемент = Новый Структура("Ид, Сессия, Организации");
	Элемент.Ид = СтрокаПользователя.Ид;
	Элемент.Сессия = СтрокаПользователя.Сессия;
	Элемент.Организации = Организации;		
	
	МассивПользователей.Добавить(Элемент);		
	
	Модуль_ЯдроНаСервере().НастройкиАвторизации().ЗавершитьРаботуПользователейЛок(МассивПользователей);
	ОбновитьСпискиНаСервере();	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ

&НаКлиенте
Процедура ЗаписатьМетрикуСтатистикиНастроек()
	
	БоксИд = Новый Массив;
	Портал = ТаблицаПользователи.НайтиСтроки(Новый Структура("СпособВхода", "Портал")).Количество();
	Сертификат = ТаблицаПользователи.НайтиСтроки(Новый Структура("СпособВхода", "Сертификат")).Количество();
	Неизвестный = ТаблицаПользователи.Количество() - (Сертификат + Портал);
	
	УникальныеСертификаты = Новый Массив;
	Для Каждого Элемент Из ТаблицаОрганизаций Цикл
		
		Если ЗначениеЗаполнено(Элемент.СертификатОтпечаток) 
			И УникальныеСертификаты.Найти(Элемент.СертификатОтпечаток) = Неопределено Тогда
			УникальныеСертификаты.Добавить(Элемент.СертификатОтпечаток);
		КонецЕсли;
		Если Элемент.Использовать Тогда
			БоксИд.Добавить(Модуль_ЯдроНаКлиенте().АдресЯщикаВИдентификатор(Элемент.БоксИд));
		КонецЕсли;
		
	КонецЦикла;
	
	Отбор = Новый Структура("Использовать");
	Отбор.Использовать = Истина;           
	
	Переменные = Новый Соответствие;
	Переменные.Вставить("КоличествоОрганизаций", ТаблицаОрганизаций.НайтиСтроки(Отбор).Количество());
	Переменные.Вставить("КоличествоСертификатов", УникальныеСертификаты.Количество());
	Переменные.Вставить("КоличествоПользователей", ТаблицаПользователи.Количество());
	Переменные.Вставить("BoxId", БоксИд);
	
	Если Портал > 0 Тогда
		Переменные.Вставить("oidc/device_flow", Портал);
	КонецЕсли;
	Если Сертификат > 0 Тогда
		Переменные.Вставить("dd_auth/certificate", Сертификат);
	КонецЕсли;
	Если Неизвестный > 0 Тогда
		Переменные.Вставить("dd_auth/unknown", Неизвестный);
	КонецЕсли;
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация,
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ПриступитьКРаботе,
		,
		Переменные,
		,
		Модуль_ЯдроНаКлиенте().TraceId());
		
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаписатьМетрикуПроверкаНастроек(Метка)

	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация,
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ОткрытиеФормыОшибки,
		Метка,
		,
		,
		Модуль_ЯдроНаКлиенте().TraceId());
		
КонецПроцедуры

&НаКлиенте
Процедура _ПродолжитьАутентификациюПоСертификату()

	Если _ОтпечатокКэш = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		// BSLLS:UnusedLocalVariable-off
		Сессия = Платформа().Авторизация_СессияПоСертификату(_ОтпечатокКэш);
		// BSLLS:UnusedLocalVariable-on
		ОбновитьСпискиНаСервере();
		ПерейтиСписокПользователей();
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОбработатьОшибкуАвторизации(ИнформацияОбОшибке, ТипАвторизацииСертификат());
				
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтраницуДлительнаяОперация(ТекстУведомления = "")

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперация;
	Элементы.ДекорацияТекстДлительнойОперации.Заголовок = ТекстУведомления;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиСписокОрганизаций()
	
	ОбновитьСписокОрганизацийНаСервере();
	
	Если ТаблицаОрганизаций.Количество() = 0 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНетОрганизаций;
		Если ТаблицаПользователи.Количество() > 0 Тогда
			Элементы.Декорация3.Заголовок = "У вас нет доступа ни в одну организацию";
			Элементы.Декорация4.Заголовок = "Попробуйте войти в веб-версию Диадока или выберите другого пользователя";
		КонецЕсли;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОрганизации;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиСписокПользователей()
	
	// BSLLS:UnusedLocalVariable-off
	Заголовок = "Авторизация: Пользователи";
	// BSLLS:UnusedLocalVariable-on
	
	Если ТаблицаПользователи.Количество() > 0 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПользователи;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНетПользователей;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложенноеОткрытие()
	
	ПерейтиСписокПользователей();
	
	Отбор = Новый Структура("СессияЖива");
	Отбор.СессияЖива = Ложь;
	
	КоличествоПротухшихТокенов = ТаблицаПользователи.НайтиСтроки(Отбор).Количество();
	
	Переменные = Новый Соответствие;
	Переменные.Вставить("КоличествоПротухшихТокенов", КоличествоПротухшихТокенов);
	
	УстановитьПризнакОткрытияНовойФормыАвторизацииНаСервере();
	
	Модуль_ЯдроНаКлиенте().Метрика_ДобавитьСтатистику(
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеКатегории().Авторизация,
		Модуль_ЯдроНаКлиенте().Метрика_НазваниеДействий().ОткрытиеФормы,
		"FormAuthV2",
		Переменные,
		,
		Модуль_ЯдроНаКлиенте().TraceId());
		
	Справка_ПоказатьНоваяФормаАвторизации();
		
КонецПроцедуры

&НаКлиенте
Процедура Справка_ПоказатьНоваяФормаАвторизации()
	
	Если Не НастройкиПользователяПрочитать_НеПоказыватьОнбордингНоваяФормаАвторизациинаСервере() Тогда
