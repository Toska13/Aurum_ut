Функция ПроверитьНастройкиОрганизацииВыбраны()
	
	Отбор = Новый Структура("Использовать");
	Отбор.Использовать = Истина;
	
	Возврат ТаблицаОрганизаций.НайтиСтроки(Отбор).Количество() > 0;
	
