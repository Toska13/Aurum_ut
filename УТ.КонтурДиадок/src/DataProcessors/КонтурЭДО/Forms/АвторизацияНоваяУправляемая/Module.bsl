&НаСервере
Процедура УстановитьВидимостьКомандВхода()
	
	ПоказатьВсеВариантыВхода = ИспользоватьАутентификациюПоСертификату();
	
	Элементы.ГруппаКомандаДобавитьПользователей.Видимость = ПоказатьВсеВариантыВхода;
	Элементы.ГруппаКомандаДобавитьПользователя.Видимость = Не ПоказатьВсеВариантыВхода;
	
	Элементы.ГруппаПользователиКомандыДобавитьПользователей.Видимость = ПоказатьВсеВариантыВхода;
	Элементы.ГруппаПользователиКомандыДобавитьПользователя.Видимость = Не ПоказатьВсеВариантыВхода;
	
	Если ПоказатьВсеВариантыВхода Тогда
		
		Элементы.ДобавитьПользователя1.Видимость = ИспользоватьАутентификациюЧерезПортал();
		Элементы.ДобавитьПользователяСертификат.Видимость = ИспользоватьАутентификациюПоСертификату();
		Элементы.ДобавитьПользователяПароль.Видимость = Ложь;
		
		Элементы.ДобавитьПользователяПортал1.Видимость = ИспользоватьАутентификациюЧерезПортал();
		Элементы.ДобавитьПользователяСертификат1.Видимость = ИспользоватьАутентификациюПоСертификату();
		Элементы.ДобавитьПользователяПароль1.Видимость = Ложь;
		
	КонецЕсли;
		
КонецПроцедуры


