	Результат = ДлительныеОперации_ВыполнитьВФонеНаСервере(ПараметрыВыполнения, ИмяМетода, ПараметрыМетода);
		
	Возврат Результат;

КонецФункции

&НаСервере
Функция ДлительныеОперации_ВыполнитьВФонеНаСервере(ПараметрыВыполнения, ИмяМетода, Знач ПараметрыМетода = Неопределено)
	
	Результат = Модуль_Ядро().ДлительныеОперации_ВыполнитьВФоне(ПараметрыВыполнения, ИмяМетода, ПараметрыМетода);
		
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДлительныеОперации_ПодождатьЗавершениеЛюбогоЗадания(ОписанияЗаданий)
	
	Модуль_Ядро().ДлительныеОперации_ПодождатьЗавершениеЛюбогоЗадания(ОписанияЗаданий);
	
КонецПроцедуры

&НаСервере
Процедура ДлительныеОперации_ОбработатьОшибкуПроверкисостоянияВызовСервера(Знач ОшибкаИнфо, Знач ДопПеременные)
	
	Ядро = Модуль_Ядро();
	
	КатегорияМетрики = "ДлительныеОперации";
	ДействиеМетрики = "ПроверитьСостояние";
	
	ДопИнформация = Новый Массив;
	Для Каждого ДопПеременная Из ДопПеременные Цикл
		ДопИнформация.Добавить(Ядро.Общее_ПодставитьПараметрыВСтроку("%1: %2", ДопПеременная.Ключ, ДопПеременная.Значение));
	КонецЦикла;
	
	Ядро.Метрика_ДобавитьОшибку(КатегорияМетрики, ДействиеМетрики, ОшибкаИнфо, ДопПеременные);
	Ядро.Ошибка_Обработать("Длительные операции", ОшибкаИнфо, ДопИнформация);
	
КонецПроцедуры

