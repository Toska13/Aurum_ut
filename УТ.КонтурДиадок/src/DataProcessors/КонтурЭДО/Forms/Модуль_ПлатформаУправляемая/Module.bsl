		// BSLLS:GetFormMethod-off
		_МодульПлагиныНаКлиенте = ПолучитьФорму(ИмяИнтерфейса, , ЭтаФорма);
		// BSLLS:GetFormMethod-on
		
		ИнтерфейсПродукта = Модуль_ВызовыПМ();
		
		_МодульПлагиныНаКлиенте.УстановитьКонфигурациюПриложения(ПлагиныПриложение);
