&НаКлиенте
Процедура ОткрытьЛичныйКабинет(СводноеОписаниеПредложений, ОбработчикЗакрытия, ФормаВладелец = Неопределено) Экспорт
	
	РежимОткрытияФормыПодпискиИОплата = РежимБаннераПриОткрытииФормыПодпискиИОплата(СводноеОписаниеПредложений);
	
	ОтображатьТолькоСрочные = НЕ (СводноеОписаниеПредложений.РекомендацияПлагинов
		ИЛИ СводноеОписаниеПредложений.РекомендацияПакетов);
	
	Если ФормаВладелец = Неопределено Тогда
		мВладелецФормы = ЭтаФорма;
	Иначе
		мВладелецФормы = ФормаВладелец;
	КонецЕсли;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ТолькоСрочные", ОтображатьТолькоСрочные);
	ПараметрыОткрытияФормы.Вставить("РежимБаннера", РежимОткрытияФормыПодпискиИОплата);
	
	ОткрытьФормуДиадокМодальноЛок(
		"ПодпискиИОплатаУправляемая",
		мВладелецФормы,
		ПараметрыОткрытияФормы,
		ОбработчикЗакрытия
	);
	
КонецПроцедуры

&НаКлиенте
Функция РежимБаннераПриОткрытииФормыПодпискиИОплата(СводноеОписаниеПредложений)
	
	Если СводноеОписаниеПредложений.ПодпискаНаМодульЗакончилась Тогда
		
		Результат = "Восстановить доступ";
		
	ИначеЕсли СводноеОписаниеПредложений.ПромоМодуля Тогда
		
		Результат = "Получить доступ";
		
	ИначеЕсли СводноеОписаниеПредложений.РекомендацияПлагинов
		И ОбработкаОбъект().ПредложенияДляПокупки_ТребуетсяПоказатьРекомендациюПокупкиПлагинов() Тогда
		
		Результат = "Подключить плагины";
		
	ИначеЕсли СводноеОписаниеПредложений.РекомендацияПакетов
		И ОбработкаОбъект().ПредложенияДляПокупки_ТребуетсяПоказатьРекомендациюПокупкиПакетаДокументов() Тогда
		
		Результат = "Подключить пакет";
		
	ИначеЕсли СводноеОписаниеПредложений.СертификатЗакончился
		ИЛИ СводноеОписаниеПредложений.СертификатЗаканчивается Тогда
		
		Результат = "Продлить сертификат";
		
	Иначе
		Результат = "Перейти к подпискам";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

