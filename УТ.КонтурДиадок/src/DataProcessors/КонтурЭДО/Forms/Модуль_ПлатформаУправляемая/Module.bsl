&НаКлиенте
Функция Госключ_ПроверитьДанныеГрупповойОперации(ДанныеДляОбработки, ДействиеЭДО, ИдентификаторФормы) Экспорт
	
	Возврат Госключ_ПроверитьДанныеГрупповойОперацииВызовСервера(ДанныеДляОбработки, ДействиеЭДО, ИдентификаторФормы);
	
КонецФункции

&НаСервере
Функция Госключ_ПроверитьДанныеГрупповойОперацииВызовСервера(ДанныеДляОбработки, ДействиеЭДО, ИдентификаторФормы)
	
	Результат = Новый Структура;
	Результат.Вставить("ОшибкиПроверки", Новый Массив);
	Результат.Вставить("ЕстьОшибкиПриПодготовке", Ложь);
	Результат.Вставить("ДанныеДляОбработкиБезОшибок", Новый Массив);
	Результат.Вставить("КоличествоПакетов", 0);
	Результат.Вставить("КоличествоФайловПакетов", 0);
	Результат.Вставить("РазмерФайловПакетов", 0);

	Модуль_Ядро = Модуль_Ядро();
	Модуль_Ядро.СписокОшибок_Очистить();
	
	КоличествоДанныхДляОбработки = ДанныеДляОбработки.Количество();
	
	ПакетыДляОтправки = Модуль_Ядро.Пакеты_ПодготовитьПакетыДляОтправки(ДанныеДляОбработки, Истина);
	
	КоличествоПакетовДляОтправки = ПакетыДляОтправки.Количество();
	
	Результат.ЕстьОшибкиПриПодготовке = (КоличествоДанныхДляОбработки <> КоличествоПакетовДляОтправки);

	РезультатПроверки = Госключ_ДанныеИсходящихПакетовЗаполнены(ПакетыДляОтправки);
	
	ПоместитьДвоичныеДанныеПакетовВоВременноеХранилищеНаСервере(РезультатПроверки.ДанныеДляОбработкиБезОшибок,
		ИдентификаторФормы);
	
	Модуль_Ядро.ДополнитьМассив(Результат.ОшибкиПроверки, РезультатПроверки.ОшибкиПроверки);
	Модуль_Ядро.ДополнитьМассив(Результат.ДанныеДляОбработкиБезОшибок, РезультатПроверки.ДанныеДляОбработкиБезОшибок);
	Результат.КоличествоПакетов = РезультатПроверки.КоличествоПакетов;
	Результат.КоличествоФайловПакетов = РезультатПроверки.КоличествоФайловПакетов;
	Результат.РазмерФайловПакетов = РезультатПроверки.РазмерФайловПакетов;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоместитьДвоичныеДанныеПакетовВоВременноеХранилищеНаСервере(МассивПакетов, ИдентификаторФормы) Экспорт
	Для Каждого Пакет Из МассивПакетов Цикл
		ПоместитьДвоичныеДанныеПакетаВоВременноеХранилищеНаСервере(Пакет, ИдентификаторФормы);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПоместитьДвоичныеДанныеПакетаВоВременноеХранилищеНаСервере(Пакет, ИдентификаторФормы) Экспорт
	
	Для Каждого Документ Из Пакет.Документы Цикл
		
		ХранилищеКонтента = Неопределено;
		Документ.Документооборот.Свойство("ХранилищеКонтента", ХранилищеКонтента);
		
		Если ХранилищеКонтента <> Неопределено
			И ЗначениеЗаполнено(ХранилищеКонтента.Данные)
			И ТипЗнч(ХранилищеКонтента.Данные) = Тип("ДвоичныеДанные") Тогда
			
			АдресВХ = ПоместитьВоВременноеХранилище(ХранилищеКонтента.Данные, ИдентификаторФормы);
			ХранилищеКонтента.Данные = АдресВХ;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция Госключ_ДанныеИсходящихПакетовЗаполнены(МассивПакетов)
	
	Модуль_Ядро = Модуль_Ядро();
	
	Результат = Новый Структура;
	Результат.Вставить("ОшибкиПроверки", Новый Массив);
	Результат.Вставить("ДанныеДляОбработкиБезОшибок", Новый Массив);
	Результат.Вставить("КоличествоПакетов", 0);
	Результат.Вставить("КоличествоФайловПакетов", 0);
	Результат.Вставить("РазмерФайловПакетов", 0);
	
	РазмерФайловПакетов = 0;
	КоличествоФайловПакетов = 0;
	КоличествоПакетов = 0;
	
	// BSLLS:MagicNumber-off
	
	Размер100МБ = 100 * 1024 * 1024;
	
	// BSLLS:MagicNumber-on
	
	Для Каждого Пакет Из МассивПакетов Цикл
		
		РезультатыПроверкиПакета = Госключ_ДанныеИсходящегоПакетаЗаполнены(Пакет);
		ОписаниеОшибкиПроверки = РезультатыПроверкиПакета.ОшибкиПроверки;
		
		Если ЗначениеЗаполнено(ОписаниеОшибкиПроверки) Тогда
			
			Модуль_Ядро.ДополнитьМассив(Результат.ОшибкиПроверки, ОписаниеОшибкиПроверки);
			
		Иначе
			
			Результат.ДанныеДляОбработкиБезОшибок.Добавить(Пакет);
			
			РазмерФайловПакетов = РазмерФайловПакетов + РезультатыПроверкиПакета.РазмерФайловПакета;
			КоличествоФайловПакетов = КоличествоФайловПакетов + РезультатыПроверкиПакета.КоличествоФайловПакета;
			КоличествоПакетов = КоличествоПакетов + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.КоличествоПакетов = КоличествоПакетов;
	Результат.КоличествоФайловПакетов = КоличествоФайловПакетов;
	Результат.РазмерФайловПакетов = РазмерФайловПакетов;
	
	// BSLLS:MagicNumber-off
	Если КоличествоФайловПакетов > 20 Тогда
		
		ТекстОшибки = НСтр("ru = 'Превышено максимальное количество файлов в пакетах: 20 шт'");
		Результат.ОшибкиПроверки.Добавить(ТекстОшибки);
		Результат.ДанныеДляОбработкиБезОшибок.Очистить();
		
	КонецЕсли;
	// BSLLS:MagicNumber-on
	
	Если РазмерФайловПакетов > Размер100МБ Тогда
		
		ТекстОшибки = НСтр("ru = 'Превышен максимальный размер файлов в пакетах: максимальный размер 100 Мб'");
		Результат.ОшибкиПроверки.Добавить(ТекстОшибки);
		Результат.ДанныеДляОбработкиБезОшибок.Очистить();
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции
	
&НаСервере
Функция Госключ_ДанныеИсходящегоПакетаЗаполнены(Пакет)
	
	Модуль_Ядро = Модуль_Ядро();

	Результат = Новый Структура;
	Результат.Вставить("ОшибкиПроверки", Новый Массив);
	Результат.Вставить("РазмерФайловПакета", 0);
	Результат.Вставить("КоличествоФайловПакета", 0);
	
	ДокументыПакета = Пакет.Документы;
	
	Если ДокументыПакета.Количество() = 0 Тогда
		
		ТекстОшибки = НСтр("ru = 'В пакете нет документов!'");
		Результат.ОшибкиПроверки.Добавить(ТекстОшибки);
		
	КонецЕсли;
	
	Для Каждого ДокументПакета Из ДокументыПакета Цикл
		
		СвойстваФайла = Модуль_Ядро.СвойствоСтруктуры(ДокументПакета.СлужебнаяИнформация, "СвойстваФайла");
		
		Если Не СвойстваФайла = Неопределено Тогда
		
			Результат.РазмерФайловПакета = Результат.РазмерФайловПакета + СвойстваФайла.РазмерФайла;
			Результат.КоличествоФайловПакета = Результат.КоличествоФайловПакета + 1;
			
			ОшибкиВалидации = Госключ_ВалидацияСвойстваФайла(СвойстваФайла);
			Если ЗначениеЗаполнено(ОшибкиВалидации) Тогда
				
				Модуль_Ядро.ДополнитьМассив(Результат.ОшибкиПроверки, ОшибкиВалидации);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Госключ_ВалидацияСвойстваФайла(СвойстваФайла)
	
	Результат = Новый Массив;
	ИмяФайла = СвойстваФайла.ИмяФайла;
	ТекстОшибки = Госключ_ПроверитьРасширениеФайла(ИмяФайла);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.Добавить(ТекстОшибки);
	КонецЕсли;
	
	РазмерФайла = СвойстваФайла.РазмерФайла;
	ТекстОшибки = Госключ_ПроверитьРазмерФайла(РазмерФайла);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.Добавить(ТекстОшибки);
	КонецЕсли;

	Возврат Результат;
		
КонецФункции

&НаСервере
Функция Госключ_ДоступныеРасширенияФайлов()
	
	Результат = Новый Массив;
	Результат.Добавить(".pdf");
	Результат.Добавить(".xml");
	Результат.Добавить(".tiff");
	Результат.Добавить(".gif");
	Результат.Добавить(".png");
	Результат.Добавить(".jpg");
	Результат.Добавить(".txt");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Госключ_ПроверитьРасширениеФайла(Значение)
	
	ТекстОшибки = "";
	
	ДоступныеРасширенияФайлов = Госключ_ДоступныеРасширенияФайлов();
	
	Если ПустаяСтрока(Значение) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный тип файла'");
	Иначе
		// BSLLS:MagicNumber-off
		РасширениеФайла4 = Прав(Значение, 5);
		РасширениеФайла3 = Прав(РасширениеФайла4, 4);
		// BSLLS:MagicNumber-on
		
		Если ДоступныеРасширенияФайлов.Найти(РасширениеФайла4) = Неопределено
			И ДоступныеРасширенияФайлов.Найти(РасширениеФайла3) = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Недопустимый тип файла, можно подписать только: pdf, xml, tiff, gif, png, jpg, txt'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

&НаСервере
Функция Госключ_ПроверитьРазмерФайла(Значение)
	
	// BSLLS:MagicNumber-off
	Размер16МБ = 16 * 1024 * 1024;
	// BSLLS:MagicNumber-on
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный размер файла'");
	ИначеЕсли Значение > Размер16МБ Тогда
		ТекстОшибки = НСтр("ru = 'Недопустимый размер файла: максимальный размер 16 Мб'");
	Иначе
		ТекстОшибки = "";
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

// Открывает форму ввода СНИЛС
//  ОповещениеОЗавершении содержит описание процедуры, которая будет вызвана после закрытия окна ввода значения
//  со следующими параметрами:
//  РезультатВводаСНИЛС_OID - Неопределено, Структура - см. РезультатВводаСНИЛС_OID результат ввода СНИЛС/OID
//  ДополнительныеПараметры - Произвольный - значение, которое было указано при создании объекта ОписаниеОповещения.
//
// Параметры:
//  ОповещениеОЗавершении	 - ОписаниеОповещения	 - оповещение, вызываемое после ввода СНИЛС/OID
//  ПараметрыОткрытияФормы	 - Структура			 - см. ПараметрыФормыВводаСНИЛС_OID переметры
//
&НаКлиенте
Процедура ОткрытьФормуВводаСНИЛС_OID(ОповещениеОЗавершении, ПараметрыОткрытияФормы) Экспорт
	
	ОткрытьФормуДиадокМодальноЛок("Госключ_ФормаВводаСНИЛСOIDУправляемая", ЭтаФорма,
		ПараметрыОткрытияФормы, ОповещениеОЗавершении);
	
КонецПроцедуры

// Возвращает параметры для формы ожидания подписания Госключ
//
// Параметры:
//  ИдентификаторЗадания	 - Строка		 - Идентификатор задания
//  ИдентификаторЯщика		 - Строка		 - Идентификатор ящика
// 
// Возвращаемое значение:
//  Структура - параметры формы ожидания подписания Госключ
//
&НаКлиенте
Функция ПараметрыФормыПодписанияГосключ(ИдентификаторЗадания, ИдентификаторЯщика) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗадания"	, ИдентификаторЗадания);
	Результат.Вставить("ИдентификаторЯщика"		, ИдентификаторЯщика);

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПараметрыФормыВводаСНИЛС_OID(ИдентификаторЯщика, КоличествоПакетов, КоличествоФайловПакетов,
	РазмерФайловПакетов, Метрика_НазваниеФормы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЯщика", ИдентификаторЯщика);
	Результат.Вставить("КоличествоПакетов", КоличествоПакетов);
	Результат.Вставить("КоличествоФайловПакетов", КоличествоФайловПакетов);
	Результат.Вставить("РазмерФайловПакетов", РазмерФайловПакетов);
