								 Параметр2 = Неопределено, Параметр3 = Неопределено, Параметр4 = Неопределено) Экспорт
		
	Возврат МетодСервера(ВозвращатьРезультат, ИмяМетода, Параметр0, Параметр1, Параметр2, Параметр3, Параметр4);
	
