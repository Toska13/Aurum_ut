// #Область Служебные

&НаКлиенте
Функция ИспользоватьНовуюФормуАвторизации()

	ЗначениеОпции = ЗначенияФункциональныхОпций.Получить("Authorization.NewForm");		
	Если ЗначениеОпции = "true" Тогда
		Результат = Истина;
	ИначеЕсли НРег(ЗначениеОпции) = "auto" Тогда
		Результат = Не ЕстьАвторизацияСтаройВерсии();
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

&НаКлиенте
Функция ЕстьАвторизацияСтаройВерсии() Экспорт
	
	Если _ЕстьАвторизацияСтаройВерсии = Неопределено Тогда
		_ЕстьАвторизацияСтаройВерсии = ЕстьАвторизацияСтаройВерсииНаСервере();
	КонецЕсли;
	
	Возврат _ЕстьАвторизацияСтаройВерсии;
	
КонецФункции

&НаСервере
Функция ЕстьАвторизацияСтаройВерсииНаСервере()
		
	Возврат ХранилищеНастроекДанныхФорм.Загрузить("Диадок", "СпособВхода") <> Неопределено
		И Модуль_Ядро().НастройкиАвторизации().АвторизованныеПользователи().Количество() = 0;
	
КонецФункции

