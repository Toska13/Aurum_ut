	ОткрытьСписокОшибок = ВыбранноеДействие = ДействияНаФормеВопросаКЭП.ОткрытьСписокОшибок;
	
	Если ОткрытьСписокОшибок Тогда
		
		Метрика_СписокОшибокКЭП(СписокОшибокКЭП);
		
