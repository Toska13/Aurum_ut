&НаКлиенте
Функция ПараметрыФормыВвода() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("ТекстСообщения", "");
	Результат.Вставить("ТекстКнопкиВыполнить", "");
	Результат.Вставить("ВозможноПустоеЗначение", Истина);
	Результат.Вставить("ДлинаПоляВвода", Неопределено);
	Результат.Вставить("РежимПароля", Ложь);
	Результат.Вставить("ИдентификаторыДокумента", Неопределено);
	Результат.Вставить("Действие", "");
	Результат.Вставить("ИдентификаторЯщика", "");
	Результат.Вставить("ГрупповоеДействие", Ложь);
	Результат.Вставить("КатегорияМетрикиДокумента", "");
	Результат.Вставить("КонтрагентПоддерживаетМЧД", Истина);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьОшибкиОбработкиДанных(Действие, ФормаВыполнения, ЭтоМассоваяОбработка = Ложь) Экспорт
	
	ТекстВопроса			= "";
	КнопкиВопроса			= Новый СписокЗначений;
	КнопкаПоУмолчанию		= КодВозвратаДиалога.ОК;
	ПредставлениеДействия	= ПредставлениеДействияЭДО(Действие);
	
	Если ЭтоМассоваяОбработка Тогда
		ТекстСообщения = "Не для всех выделенных документов удалось выполнить операцию";
	Иначе
		ТекстСообщения = "Не удалось выполнить операцию";
	КонецЕсли;
	
	ТекстСообщения = ТекстСообщения + ": " + ПредставлениеДействия;
	
	КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК);
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Прервать, НСтр("ru = 'Посмотреть причины'"));
	
	ОписаниеОповещенияЗавершения = НовыйОписаниеОповещения(
		"ПослеСообщенияОНеполномВыполненииДействия",
		ЭтаФорма,
		ФормаВыполнения
	);
	
	ПоказатьВопросЛок(ОписаниеОповещенияЗавершения, ТекстСообщения, КнопкиВопроса, , КнопкаПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСообщенияОНеполномВыполненииДействия(ПараметрОповещения, ФормаВыполнения) Экспорт 
	
	Если ПараметрОповещения = КодВозвратаДиалога.Прервать Тогда
		ОткрытьФормуСпискаОшибокЛок(ФормаВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьИлиПерейтиПоСсылке(
		Знач АдресСсылки,
		ДополнительныеПараметры = Неопределено,
		ФормаСобытия = Неопределено) Экспорт
	
	Если ЭтоОповещение(АдресСсылки) Тогда
		ВыполнитьОповещение(АдресСсылки, ДополнительныеПараметры, ФормаСобытия);
		Возврат;
	КонецЕсли;
	
	Если ЭтоАдресСсылки(АдресСсылки) Тогда
		ПерейтиПоСсылке(АдресСсылки);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоОповещение(Знач АдресСсылки) Экспорт
	
	АдресСсылки = НРег(АдресСсылки);
	
	Результат = Найти(АдресСсылки, "alert:") > 0 ИЛИ Найти(АдресСсылки, "alertandclose:") > 0;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоАдресСсылки(Знач АдресСсылки) Экспорт
	
	АдресСсылки = НРег(АдресСсылки);
	
	Префиксы = Новый Массив;
	Префиксы.Добавить("https://");
	Префиксы.Добавить("http://");
	Префиксы.Добавить("mailto:");
	Префиксы.Добавить("skype:");
	Префиксы.Добавить("tel:");
	Префиксы.Добавить("v8help:");
	Префиксы.Добавить("e1c:");
	Префиксы.Добавить("e1cib/");
	
	Результат = Ложь;
	СтдСтр = Модуль_СтдСтрНаКлиенте();
	Для Каждого ПрефиксСсылки Из Префиксы Цикл
		Если СтдСтр.СтрНачинаетсяСЛок(АдресСсылки, ПрефиксСсылки)
			И СтрДлина(АдресСсылки) > СтрДлина(ПрефиксСсылки) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьОповещение(АдресСсылки, ДополнительныеПараметры, ФормаСобытия) Экспорт
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	ПараметрыОповещения		= Ядро.ПараметрыОповещенияИзСтрокиHTMLСообщения(АдресСсылки);
	ОбработчикОповещения	= ПараметрыОповещения.ОбработчикОповещения;
	РезультатОповещения		= ПараметрыОповещения.РезультатОповещения;
	
	ОписаниеОповещения = НовыйОписаниеОповещения(ОбработчикОповещения, ФормаСобытия, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещения, РезультатОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоСсылке(АдресСсылки) Экспорт
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// BSLLS:UsingSynchronousCalls-off
		ЗапуститьПриложение(АдресСсылки);
		// BSLLS:UsingSynchronousCalls-on
	#Иначе
		ПерейтиПоНавигационнойСсылке(АдресСсылки);
	#КонецЕсли
	
КонецПроцедуры

// Запрашивает подтверждение при переходе по внешей ссылке и фиксирует метрики:
// - Поведение - перед запросом подтверждения
// - Статистика - при подтверждении пользователем или при отказе от перехода
//
// Параметры:
//  ВнешняяСсылка - Строка - адрес, по которому пользователь пытается перейти
//  Форма - ФормаКлиентскогоПриложения - Форма, из которой осуществляется переход
//  ДопПеременные - Неопределено, Соответствие - (необязательный) доп. параметры для передачи в переменные метрик
//
&НаКлиенте
Процедура НачатьПереходПоВнешнейСсылке(Знач ВнешняяСсылка, Знач Форма, Знач ДопПеременные = Неопределено) Экспорт
	
	ПараметрыПерехода = ПараметрыПереходаПоВнешнейСсылке(ВнешняяСсылка, Форма, ДопПеременные);
	
	Метрика_ПереходПоВнешнейСсылке_Начать(ПараметрыПерехода);
	
	СтдСтр = Модуль_СтдСтрНаКлиенте();
	
	Текст = СтдСтр.СтрШаблонЛок(
		"Вы собираетесь покинуть Диадок и перейти по ссылке '%1'.
		|
		|Не переходите по ссылке, если не уверены в безопасности её источника.
		|
		|Если всё же решите перейти, мы не рекомендуем вводить личные данные, номера телефонов и пароли.",
		ВнешняяСсылка
	);
	
	КнопкаОтмена = КодВозвратаДиалога.Отмена;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КнопкаОтмена, "Вернуться");
	Кнопки.Добавить(КодВозвратаДиалога.Да, "Всё равно перейти");
	Таймаут = 30;
	
	ОписаниеОповещения = НовыйОписаниеОповещения("ЗавершитьПереходПоВнешнейСсылке", ЭтаФорма, ПараметрыПерехода);
	
	ПоказатьВопросЛок(
		ОписаниеОповещения,
		Текст,
		Кнопки,
		Таймаут,
		КнопкаОтмена,
		"Переход по внешней ссылке",
		КнопкаОтмена);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПереходаПоВнешнейСсылке(Знач ВнешняяСсылка, Знач Форма, Знач ДопПеременные = Неопределено)
	
	ПараметрыПерехода = Новый Структура;
	ПараметрыПерехода.Вставить("ВнешняяСсылка", ВнешняяСсылка);
	ПараметрыПерехода.Вставить("Переменные", Новый Соответствие);
	ПараметрыПерехода.Вставить("ИмяФормы", Форма.ИмяФормы);
	ПараметрыПерехода.Вставить("ИмяЭлемента", "");
	
	Если Форма.ТекущийЭлемент <> Неопределено Тогда
		ПараметрыПерехода.ИмяЭлемента = Форма.ТекущийЭлемент.Имя;
	КонецЕсли;
	
	ПараметрыПерехода.Переменные.Вставить("url", ВнешняяСсылка);
	Если ТипЗнч(ДопПеременные) = Тип("Соответствие") Тогда
		ИнтерфейсСтд = Модуль_СтдОбщегоНазначенияНаКлиенте();
		ИнтерфейсСтд.ДополнитьСоответствиеЛок(ПараметрыПерехода.Переменные, ДопПеременные);
	КонецЕсли;
	
	Возврат ПараметрыПерехода;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьПереходПоВнешнейСсылке(Ответ, ПараметрыПерехода) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Метрика_ПереходПоВнешнейСсылке_Отменить(ПараметрыПерехода);
		Возврат;
	КонецЕсли;
	
	ПерейтиПоСсылке(ПараметрыПерехода.ВнешняяСсылка);
	
	Метрика_ПереходПоВнешнейСсылке_Продолжить(ПараметрыПерехода);
	
КонецПроцедуры

