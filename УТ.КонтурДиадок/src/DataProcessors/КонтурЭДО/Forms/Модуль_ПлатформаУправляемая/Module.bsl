	ПараметрыПМ.Вставить("ДополнительныеПараметры", РезультатПМ);
	
	РезультатПМ = Ядро.ПодключаемыйМодуль_ОбработатьСобытиеНаСервере("НажатиеДополнительнойКнопки", ПараметрыПМ);
	
