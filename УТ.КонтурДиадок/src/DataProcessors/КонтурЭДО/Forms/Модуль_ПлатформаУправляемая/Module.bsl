// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - описание сессии (см. Ядро.МодельСессияПользователя)
//
&НаКлиенте
Функция Авторизация_СессияПоСертификату(Знач ОтпечатокСертификата) Экспорт
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
		Ошибка = "ValueError: Не указан отпечаток сертификата";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Сессия = АвторизацияСлужебный_СессияПоСертификату(ОтпечатокСертификата);
	Если ИспользоватьНовуюФормуАвторизации() Тогда
		ЗаписатьДанныеОбАутентификацииНаСервере(Сессия);
	КонецЕсли;
	
	Возврат Сессия;
	
КонецФункции

// Формирует новую сессию по логину и паролю.
//
// Параметры:
//  Логин - Строка - логин пользователя Диадока
//  Пароль - Строка - пароль пользователя Диадока
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - описание сессии (см. Ядро.МодельСессияПользователя)
//
&НаКлиенте
Функция Авторизация_СессияПоЛогину(Знач Логин, Знач Пароль) Экспорт
	
	Если Не ЗначениеЗаполнено(Логин) Тогда
		Ошибка = "ValueError: Не указан логин";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Пароль) Тогда
		Ошибка = "ValueError: Не указан пароль";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Сессия = АвторизацияСлужебный_СессияПоЛогинуВызовСервера(Логин, Пароль);
	
	Возврат Сессия;
	
КонецФункции

// Асинхронный метод получения авторизационного токена Диадока по протоколу Open ID Connect.
// Передает структуру Ядро.МодельСессияПользователя как результат в обработчик ПриПолученииСессии.
//
// Параметры:
//  ПриПолученииСессии - ОписаниеОповещения - обработчик, который будет вызван при получении токена
//
&НаКлиенте
Процедура Авторизация_НачатьПолучениеСессииЧерезБраузер(ПриПолученииСессии) Экспорт
	
   	ПараметрыПолученияСессии = Новый Структура;
	ПараметрыПолученияСессии.Вставить("ПриПолученииСессии", ПриПолученииСессии);
	
	ПриПолученииСессииЧерезБраузер = НовыйОписаниеОповещения(
		"АвторизацияСлужебныйОбработчик_ПриПолученииСессииЧерезБраузер",
		ЭтаФорма,
		ПараметрыПолученияСессии
	);
	
	// BSLLS:UnusedLocalVariable-off
	КлючСессии = АутхКлючНастройки();
	// BSLLS:UnusedLocalVariable-on
	
	МодульАутх = МодульАутхСлужебныйНаКлиенте();
	МодульАутх.НачатьПолучениеСессии(ПриПолученииСессииЧерезБраузер);
	
КонецПроцедуры

// V2 Асинхронный метод получения авторизационного токена Диадока по протоколу Open ID Connec
// Передает структуру Ядро.МодельСессияПользователя как результат в обработчик ПриПолученииСессии.
// Записывает данные о пользователе и сессии в свое хранилище
//
// Параметры:
//  ПриПолученииСессии - ОписаниеОповещения - обработчик, который будет вызван при получении токена
//
&НаКлиенте
Процедура Авторизация_НачатьПолучениеСессииЧерезБраузерV2(ПриПолученииСессии) Экспорт
	
   	ПараметрыПолученияСессии = Новый Структура;
	ПараметрыПолученияСессии.Вставить("ПриПолученииСессии", ПриПолученииСессии);
	
	ПриПолученииСессииЧерезБраузер = НовыйОписаниеОповещения(
		"АвторизацияСлужебныйОбработчик_ПриПолученииСессииЧерезБраузерV2",
		ЭтаФорма,
		ПараметрыПолученияСессии
	);
	
	// BSLLS:UnusedLocalVariable-off
	КлючСессии = АутхКлючНастройки();
	// BSLLS:UnusedLocalVariable-on
	
	МодульАутх = МодульАутхСлужебныйНаКлиенте();
	
	МодульАутх.НачатьПолучениеСессии(ПриПолученииСессииЧерезБраузер);
	
КонецПроцедуры

// Метод для удаления авторизационного токена Диадока, полученного по протоколу Open ID Connect
//
// Параметры:
//	КлючНастройки - Строка - Ключ настройки авторизации
//
&НаКлиенте
Процедура Авторизация_СброситьПортальнуюСессию(КлючНастройки = Неопределено) Экспорт
	
	МодульАутх = МодульАутхСлужебныйНаКлиенте(КлючНастройки);
	МодульАутх.ЗавершитьСессию();
	
КонецПроцедуры

// Открывает форму настройки конфигурации клиента OAuth (имя и ключ приложения).
//
// Параметры:
//  ПриИзменении - ОписаниеОповещения - обработчик, который будет вызван при успешном сохранении настроек.
//
&НаКлиенте
Процедура Аутх_РедактироватьКонфигурациюПриложения(ПриИзменении) Экспорт
	
	Если Не Пользователи_ЕстьАдминистративныеПраваВызовСервера() Тогда
		
		ТекстЛок = "Для редактирования конфигурации OAuth требуются права администратора.";
		ТаймаутЛок = 60;
		ЗаголовокЛок = "Контур.Диадок: Доступ запрещён";
		ПоказатьПредупреждениеЛок(Неопределено, ТекстЛок, ТаймаутЛок, ЗаголовокЛок);
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыРедактированияКонфигурации = Новый Структура;
	ПараметрыРедактированияКонфигурации.Вставить("ПриИзмененииКонфигурации", ПриИзменении);
	
	ПриИзмененииКонфигурацииПриложения = НовыйОписаниеОповещения(
		"АутхСлужебныйОбработчик_ПриИзмененииКонфигурацииПриложения",
		ЭтаФорма,
		ПараметрыРедактированияКонфигурации
	);
	
	ПараметрыФормы = Новый Структура;
	
	ОткрытьФормуДиадокМодальноЛок(
		"АутхКонфигурацияПриложенияУправляемая",
		ПриИзменении.Модуль,
		ПараметрыФормы,
		ПриИзмененииКонфигурацииПриложения,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс
	);
	
КонецПроцедуры

&НаКлиенте
Процедура АутхСлужебныйОбработчик_ПриИзмененииКонфигурацииПриложения(Знач НастройкиИзменены, Знач ПараметрыРедактированияКонфигурации = Неопределено) Экспорт
	
	Если НастройкиИзменены <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещенияЛок(
		ПараметрыРедактированияКонфигурации.ПриИзмененииКонфигурации,
		НастройкиИзменены
	);
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияСлужебныйОбработчик_ПриПолученииСессииЧерезБраузер(ПортальнаяСессия, ПараметрыПолученияСессии) Экспорт
	
	Если ТипЗнч(ПортальнаяСессия) <> Тип("ФиксированнаяСтруктура")
		И ТипЗнч(ПортальнаяСессия) <> Тип("Структура") Тогда
		// Пользователь не подтвердил доступы приложения в браузере
		Возврат;
	КонецЕсли;
	
	Сессия = АвторизацияСлужебный_СессияПорталБраузерВызовСервера(АутхКлючНастройки(), ПортальнаяСессия);
	ВыполнитьОбработкуОповещенияЛок(
		ПараметрыПолученияСессии.ПриПолученииСессии,
		Сессия
	);
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияСлужебныйОбработчик_ПриПолученииСессииЧерезБраузерV2(ПортальнаяСессия, 
		ПараметрыПолученияСессии) Экспорт
	
	Если ТипЗнч(ПортальнаяСессия) <> Тип("ФиксированнаяСтруктура")
		И ТипЗнч(ПортальнаяСессия) <> Тип("Структура") Тогда
		// Пользователь не подтвердил доступы приложения в браузере
		Возврат;
	КонецЕсли;
	
	СохранитьПортальнуюСессиюПоЮзерИдНаСервере(ПортальнаяСессия);
	Сессия = АвторизацияСлужебный_СессияПорталБраузерВызовСервера(АутхКлючНастройки(), ПортальнаяСессия);
	АвторизацияСлужебный_ЗаписатьАвторизованногоПользователя(Сессия); // Подменим ключ стандартной сесисии на ид юзера
	ВыполнитьОбработкуОповещенияЛок(
		ПараметрыПолученияСессии.ПриПолученииСессии,
		Сессия
	);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПортальнуюСессиюПоЮзерИдНаСервере(ПортальнаяСессия)

	Аутх = МодульАутхСлужебныйНаСервере(ПортальнаяСессия.ПортальныйИд);
	
	// Добавим сессию с ид поратльного юзера
	
	Аутх.СохранитьСессию(ПортальнаяСессия);
	
	// Удалим сессию со стандартным ид
	
	ОтборСессий = АутхОтборСессий(Аутх.СобратьКлючОбъекта());
	Аутх.ХранилищеСессий().УдалитьСессию(ОтборСессий);
	
КонецПроцедуры

&НаСервере
Функция АвторизацияСлужебный_СессияПорталБраузерВызовСервера(Знач КлючСессии, Знач ПортальнаяСессия)
	
	Ядро = Модуль_Ядро();
	Результат = Ядро.Новый_СессияПорталБраузер(КлючСессии, ПортальнаяСессия);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаписатьДанныеОбАутентификацииНаСервере(Сессия)

	АвторизацияСлужебный_ЗаписатьАвторизованногоПользователя(Сессия); // Данные о пользователе
	Модуль_Ядро().НастройкиАвторизации().СохранитьСессию(Сессия, Сессия.Пользователь.Идентификатор); // Данные о сессии
	
КонецПроцедуры

&НаСервере
Процедура АвторизацияСлужебный_ЗаписатьАвторизованногоПользователя(Сессия)

	Модуль_Ядро().НастройкиАвторизации().АвторизованныеПользователиДобавить(
		Сессия.Пользователь, Сессия.СхемаАутентификации);
	
КонецПроцедуры

&НаКлиенте
Функция АвторизацияСлужебный_СессияПоСертификату(ОтпечатокСертификата)
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	ТокенДоступа = Ядро.Авторизация_ПоСертификату(ОтпечатокСертификата);
	Результат = АвторизацияСлужебный_СессияПоСертификатуВызовСервера(ОтпечатокСертификата, ТокенДоступа);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция АвторизацияСлужебный_СессияПоСертификатуВызовСервера(Знач ОтпечатокСертификата, Знач ТокенДоступа)
	
	Ядро = Модуль_Ядро();
	Результат = Ядро.Новый_СессияДиадокСертификат(ОтпечатокСертификата, ТокенДоступа);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция АвторизацияСлужебный_СессияПоЛогинуВызовСервера(Знач Логин, Знач Пароль)
	
	Ядро = Модуль_Ядро();
	
	ТокенДоступа = Ядро.Токен_ПолучитьИзДиадока(Неопределено, Логин, Пароль);
	Результат = Ядро.Новый_СессияДиадокПароль(Логин, ТокенДоступа);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МодульАутхСлужебныйНаКлиенте(КлючНастройки = Неопределено)
	
	ИмяФормыАутх = "Обработка.КонтурДиадокАутентификатор.Форма.Клиент";
	Если ЭтоВнешняяОбработка Тогда
		ИмяФормыАутх = "ВнешняяОбработка.КонтурДиадокАутентификатор.Форма.Клиент";
	КонецЕсли;
	
	// BSLLS:GetFormMethod-off
	Результат = ПолучитьФорму(ИмяФормыАутх);
	// BSLLS:GetFormMethod-on
	
	Результат.УстановитьКонфигурациюПровайдера(АутхПровайдер);
	Результат.УстановитьКонфигурациюПриложения(АутхПриложение);
	Если АутхПрокси <> Неопределено Тогда
		Результат.УстановитьНастройкиПрокси(АутхПрокси);
	КонецЕсли;
	Результат.УстановитьОтборСессий(АутхОтборСессий(Результат.СобратьКлючОбъекта(), КлючНастройки));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МодульАутхСлужебныйНаСервере(КлючНастроек = Неопределено)
	
	ИмяМодуляАутх = "ОбработкаОбъект.КонтурДиадокАутентификатор";
	Если ЭтоВнешняяОбработка Тогда
		ИмяМодуляАутх = "ВнешняяОбработкаОбъект.КонтурДиадокАутентификатор";
	КонецЕсли;
	
	Результат = Новый(ИмяМодуляАутх);
	Результат.УстановитьКонфигурациюПровайдера(АутхПровайдер);
	Результат.УстановитьКонфигурациюПриложения(АутхПриложение);
	Если АутхПрокси <> Неопределено Тогда
		Результат.УстановитьНастройкиПрокси(АутхПрокси);
	КонецЕсли;
	Результат.УстановитьХранилищеСессий(Неопределено);
	Результат.УстановитьОтборСессий(АутхОтборСессий(Результат.СобратьКлючОбъекта(), КлючНастроек));
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция АутхОтборСессий(Знач КлючОбъекта, КлючНастройки = Неопределено)
	
	Результат = Новый Структура("КлючОбъекта, КлючНастроек, Пользователь");
	Результат.КлючОбъекта = КлючОбъекта;
	Если КлючНастройки = Неопределено Тогда
		Результат.КлючНастроек = АутхКлючНастройки();
	Иначе
		Результат.КлючНастроек = КлючНастройки;
	КонецЕсли;
	Результат.Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция АутхКлючНастройки()
	Возврат "e2714b37-0f4e-492e-dd1c-d01ab55ac000"; // Константа, используется для первичной авторизации
КонецФункции

&НаКлиенте
Функция ИмяФормыАвторизации() Экспорт
			
	Если ИспользоватьНовуюФормуАвторизации() Тогда
		Результат = "АвторизацияНоваяУправляемая";
	Иначе
		Результат = "АвторизацияУправляемая";	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПараметрыСеансаОбновитьКонтекст(Контекст) Экспорт
	
	ПараметрыСеансаОбновитьКонтекстНаСервере(Контекст);
	 
КонецПроцедуры

&НаСервере
Процедура ПараметрыСеансаОбновитьКонтекстНаСервере(Контекст)
	
	ИмяМодуля = "КонтурДиадокСервер";
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		МодульДиадок = Модуль_Ядро().СтдОбщегоНазначения().ОбщийМодульЛок(ИмяМодуля);
		МодульДиадок.КонтекстСеансаУстановить(Контекст);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Модуль_Ядро().Ошибка_Обработать("Обновить контекст параметров сеанса", Ошибка);
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти Авторизация

// #Область СеансРаботыПользователя

// Запускает инициализацию сеанса пользователя. Если не удалось восстановить
// контекст предыдущего сеанса (его не было, истекло действие авторизационного
// токена и т.п.), открывается форма авторизации.
//
// Параметры:
//  ПриНачалеСеанса - ОписаниеОповещения - обработчик, который будет вызван
//                                         после иницилизации контекста сеанса
//
&НаКлиенте
Процедура Сеанс_Начать(Знач ПриНачалеСеанса) Экспорт
	
	ВидОперации = "Авторизация";
	СисИнфо = СистемнаяИнформацияНаКлиенте();
	СеансСлужебный_ПередНачаломСеанса(СисИнфо);
	
	СохраненныеНастройки = СеансСлужебный_НастройкиЯщиков();
	
	Если Не ЗначениеЗаполнено(СохраненныеНастройки) Тогда
		СеансСлужебный_ПоказатьФормуАвторизации(ВидОперации, ПриНачалеСеанса);
		Возврат;
	КонецЕсли;
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	Попытка
		ЛокальныеСертификаты = СеансСлужебный_ОписанияСертификатов(СохраненныеНастройки);
	Исключение
		ОшибкаИнфо = ИнформацияОбОшибке();
		Ядро.Ошибка_Обработать("Получить описания сертификатов", ОшибкаИнфо);
		СеансСлужебный_ПоказатьФормуАвторизации(ВидОперации, ПриНачалеСеанса);
		Возврат;
	КонецПопытки;
	
	Попытка
		Сессии = СеансСлужебный_Сессии(СохраненныеНастройки);
		Если ИспользоватьНовуюФормуАвторизации() 
				И Модуль_ЯдроНаКлиенте().ТребуетсяВосстановитьСессииДляСовместимости(Сессии) Тогда
			ВызватьИсключение "Переход на новую версию авторизации";
		КонецЕсли;                                                    
	Исключение
		ОшибкаИнфо = ИнформацияОбОшибке();
		Ядро.Ошибка_Обработать("Восстановить сессии", ОшибкаИнфо);
		СеансСлужебный_ПоказатьФормуАвторизации(ВидОперации, ПриНачалеСеанса);
		Возврат;
	КонецПопытки;
	
	Контекст = Новый Соответствие;
	ЕстьОшибки = Ложь;
	
	Массив = Новый Массив;
	Для Каждого НастройкаСеанса Из СохраненныеНастройки Цикл
		
		Структура = Новый Структура("ИдентификаторЯщика, Сессия, Сертификат");
		Структура.ИдентификаторЯщика = НастройкаСеанса.ИдентификаторЯщика;
		Структура.Сессия = Сессии.Получить(НастройкаСеанса.КлючСессии);
		Структура.Сертификат = ЛокальныеСертификаты.Получить(НастройкаСеанса.ОтпечатокСертификата);
		
		Массив.Добавить(Структура);
		
	КонецЦикла;
	
	СтрокиКонтекста = СеансСлужебный_НоваяСтрокиВызовСервера(Массив, ЕстьОшибки);
	
	Для Каждого СтрокаКонтекста Из СтрокиКонтекста Цикл
		Контекст.Вставить(СтрокаКонтекста.Ключ, СтрокаКонтекста.Значение);
	КонецЦикла;
	
	Если ЕстьОшибки Или Не ЗначениеЗаполнено(Контекст) Тогда 
		СеансСлужебный_ПоказатьФормуАвторизации("Авторизация", ПриНачалеСеанса);
	Иначе
		СеансСлужебный_ОбработатьПолучениеКонтекста(Контекст, ПриНачалеСеанса);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СеансСлужебный_ОписанияСертификатов(СохраненныеНастройки)
	
	Ядро = Модуль_ЯдроНаКлиенте();
	ЛокальныеСертификаты = Новый Соответствие;
	
	Для Каждого НастройкаСеанса Из СохраненныеНастройки Цикл
		
		Отпечаток = НастройкаСеанса.ОтпечатокСертификата;
		Сертификат = ЛокальныеСертификаты.Получить(Отпечаток);
		
		Если ЗначениеЗаполнено(Отпечаток)
			И Не ЗначениеЗаполнено(Сертификат) Тогда
			
			СертификатДанные = Ядро.Сертификаты_ДанныеСертификата(Отпечаток);
			СертификатBase64 = Ядро.Сертификаты_СертификатВBase64(Отпечаток);
			Сертификат = Ядро.Сертификаты_ОписаниеСертификата(СертификатДанные);
			Сертификат.Вставить("Base64", СертификатBase64);
			
			ЛокальныеСертификаты.Вставить(Отпечаток, Сертификат);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЛокальныеСертификаты;
	
КонецФункции

&НаКлиенте
Функция СеансСлужебный_Сессии(СохраненныеНастройки)
	
	Ядро = Модуль_ЯдроНаКлиенте();
	Сессии = Новый Соответствие;
	
	Для Каждого НастройкаСеанса Из СохраненныеНастройки Цикл
		
		Если НастройкаСеанса.СхемаАутентификации = СхемаАутентификацииПорталБраузер() Тогда
			
			Если Сессии.Получить(НастройкаСеанса.КлючСессии) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Сессия = СеансСлужебный_СессияПортал(НастройкаСеанса);
			Сессии.Вставить(НастройкаСеанса.КлючСессии, Сессия);
	
		Иначе
			
			ТребуетсяОбновитьТокенДоступа = СеансСлужебный_СессияИстекает(НастройкаСеанса.ТокенДоступаСрокДействия);
			
			Если Не ТребуетсяОбновитьТокенДоступа Тогда
				Сессия = Ядро.КонтекстСеанса_ВосстановитьСессию(НастройкаСеанса);
			ИначеЕсли НастройкаСеанса.СхемаАутентификации = СхемаАутентификацииДиадокСертификат() Тогда
				Сессия = АвторизацияСлужебный_СессияПоСертификату(НастройкаСеанса.ОтпечатокСертификата);
			Иначе
				Сессия = Неопределено;
			КонецЕсли;
			
			Сессии.Вставить(НастройкаСеанса.КлючСессии, Сессия);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Сессии;
	
КонецФункции

&НаСервере
Функция СеансСлужебный_СессияПортал(Знач НастройкаСеанса)
	
	Если НастройкаСеанса.ИмяПриложения <> АутхПриложение.Имя Тогда
		Ошибка = "Изменилось имя клиента аутентификации. Требуется актуализировать контекст сеанса.";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	КлючСессии = НастройкаСеанса.КлючСессии;
	Аутх = МодульАутхСлужебныйНаСервере(КлючСессии);
	Ядро = Модуль_Ядро();
	
	ПортальнаяСессия = Аутх.ПолучитьСессию();
	Сессия = Ядро.Новый_СессияПорталБраузер(КлючСессии, ПортальнаяСессия);
	
	Возврат Сессия;
	
КонецФункции

// Открывает форму авторизации в режиме выбора ящиков для работы
//
// Параметры:
//  ПриИзмененииКонтекстаСеанса - ОписаниеОповещения - обработчик, который будет вызван
//                                                     после изменения контекста сеанса
//
&НаКлиенте
Процедура Сеанс_РедактироватьКонтекст(Знач ПриИзмененииКонтекстаСеанса) Экспорт
	
	СеансСлужебный_ПоказатьФормуАвторизации("ВыборОрганизаций", ПриИзмененииКонтекстаСеанса);
	
КонецПроцедуры

// Открывает форму авторизации
//
// Параметры:
//  Режим - Строка - "Авторизация" или "ВыборОрганизаций"
//  ПриЗакрытииФормыАвторизации - ОписаниеОповещения - оповещение, которое необходимо вызвать
//                                                     после закрытия формы авторизации.
//
&НаКлиенте
Процедура СеансСлужебный_ПоказатьФормуАвторизации(Знач Режим, Знач ПриЗакрытииФормыАвторизации)
	
	ПараметрыЗакрытияФормы = Новый Структура;
	ПараметрыЗакрытияФормы.Вставить("ПриЗакрытииФормыАвторизации", ПриЗакрытииФормыАвторизации);
	ПараметрыЗакрытияФормы = Новый ФиксированнаяСтруктура(ПараметрыЗакрытияФормы);
	
	ПриЗакрытииФормыАвторизацииСлужебный = НовыйОписаниеОповещения(
		"СеансСлужебныйОбработчик_ПриЗакрытииФормыАвторизации",
		ЭтаФорма,
		ПараметрыЗакрытияФормы
	);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийРежимФормы", Режим);
	ПараметрыФормы.Вставить("ОбщийКонтекстКлиентСервер", Объект.ОбщийКонтекстКлиентСервер);
	
	ПутьКФорме = Модуль_СтдСтрНаКлиенте().СтрШаблонЛок("%1%2", ПутьКФормам, ИмяФормыАвторизации()); 
		
	ОткрытьФормуЛок(
		ПутьКФорме,
		ПараметрыФормы,
		ЭтаФорма,
		Неопределено,
		Неопределено,
		Неопределено,
		ПриЗакрытииФормыАвторизацииСлужебный,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

// Конструктор строки контекста сеанса
//
// Параметры:
//  ИдентификаторЯщика - Строка - идентификатор ящика организации
//  Сессия - Структура, ФиксированнаяСтруктура - см. Ядро.МодельСессияПользователя
//  Сертификат - Структура, ФиксированнаяСтруктура - Ядро.Сертификаты_ОписаниеСертификата + двоичка (Base64)
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. Ядро.МодельСтрокаКонтекстаСеанса
//
&НаКлиенте
Функция Сеанс_НоваяСтрока(Знач ИдентификаторЯщика, Знач Сессия, Знач Сертификат) Экспорт
	
	Результат = СеансСлужебный_НоваяСтрокаВызовСервера(ИдентификаторЯщика, Сессия, Сертификат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СеансСлужебный_НоваяСтрокаВызовСервера(Знач ИдентификаторЯщика, Знач Сессия, Знач Сертификат)
	
	Ядро = Модуль_Ядро();
	Результат = Ядро.СоздатьСтрокуКонтекстаСеанса(ИдентификаторЯщика, Сессия, Сертификат);
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция СеансСлужебный_НоваяСтрокиВызовСервера(Массив, ЕстьОшибки)
	
	Ядро = Модуль_Ядро();
	Результат = Новый Соответствие;
	
	Для Каждого Элемент Из Массив Цикл 
		
		Попытка
			
			НоваяСтрока = Ядро.СоздатьСтрокуКонтекстаСеанса(Элемент.ИдентификаторЯщика, Элемент.Сессия, Элемент.Сертификат);
			Результат.Вставить(Элемент.ИдентификаторЯщика, НоваяСтрока);

		Исключение
			
			ОшибкаИнфо = ИнформацияОбОшибке();
			// BSLLS:FunctionOutParameter-off
			ЕстьОшибки = Истина;
			// BSLLS:FunctionOutParameter-on
			Ядро.Ошибка_Обработать("Восстановление контекста", ОшибкаИнфо);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СеансСлужебный_НастройкиЯщиков()
	
	Ядро = Модуль_Ядро();
	Настройки = Ядро.КонтекстСеанса_СохраненныеНастройки();
	
	Возврат Настройки;
	
КонецФункции

&НаСервереБезКонтекста
Функция СеансСлужебный_СессияИстекает(Знач ТокенДоступаСрокДействия)
	
	ПрогнозируемаяДлительностьСессии = 14400; // 4 часа
	РасчетныйСрокДействия = ТекущаяУниверсальнаяДата() + ПрогнозируемаяДлительностьСессии;
	
	Результат = (ТокенДоступаСрокДействия < РасчетныйСрокДействия);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СеансСлужебный_ПередНачаломСеанса(Знач СисИнфо)
	
	Ядро = Модуль_Ядро();
	Ядро.ОбщийКонтекст_Поместить("СисИнфоНаКлиенте", СисИнфо);
	
	Ядро.МетрикиКонтур_ЗаписатьСобытие_Запуск();
	
КонецПроцедуры

// Обработчик закрытия формы авторизации
//
// Параметры:
//  ЗаполненныйКонтекст - Соответствие - Информация о доступных ящиках и их настройках
//  ПараметрыЗакрытияФормы - ФиксированнаяСтруктура - содержит ключи:
//   * ПриЗакрытииФормыАвторизации - ОписаниеОповещения - обработчик, который нужно вызвать изменении контекста сеанса
//
&НаКлиенте
Процедура СеансСлужебныйОбработчик_ПриЗакрытииФормыАвторизации(Знач ЗаполненныйКонтекст, Знач ПараметрыЗакрытияФормы = Неопределено) Экспорт
	
	СеансСлужебный_ОбработатьПолучениеКонтекста(ЗаполненныйКонтекст, ПараметрыЗакрытияФормы.ПриЗакрытииФормыАвторизации);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СхемаАутентификацииПорталБраузер()
	Возврат "oidc/device_flow";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СхемаАутентификацииДиадокСертификат()
	Возврат "dd_auth/certificate";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СхемаАутентификацииДиадокПароль()
	Возврат "dd_auth/password";
КонецФункции

&НаКлиенте
Процедура СеансСлужебный_ОбработатьПолучениеКонтекста(Знач ЗаполненныйКонтекст, Знач ПриЗаполненииКонтекста)
	
	Если ЗначениеЗаполнено(ЗаполненныйКонтекст) Тогда
		ПослеИнициализацииКонтекстаСеансаНаСервере(ЗаполненныйКонтекст);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещенияЛок(ПриЗаполненииКонтекста, ЗаполненныйКонтекст);
	
КонецПроцедуры

&НаСервере
Процедура ПослеИнициализацииКонтекстаСеансаНаСервере(Знач Контекст)
	
	КонтекстСеанса_УстановитьКонтекстНаСервере(Контекст);
	
	Ядро = Модуль_Ядро();
	
	Ядро.КонтекстСеанса_ЗаписатьНастройки(Контекст, АутхПриложение);
	
	Ядро.Метрика_ПриАвторизации();
	Ядро.Метрика_ДобавитьСтатистику_Авторизации();
	Ядро.Метрика_ДобавитьСтатистику_НастройкиОрганизацияПриАвторизации();
	Ядро.Метрика_ДобавитьСтатистику_ВидыДокументовПриАвторизации();
	Ядро.Метрика_ДобавитьСтатистику_Плагины();
	
КонецПроцедуры

&НаСервере
Процедура КонтекстСеанса_УстановитьКонтекстНаСервере(Знач Контекст)
	
	Ядро = Модуль_Ядро();
	Ядро.КонтекстСеанса_Очистить();
	
	Для Каждого КлючЗначение Из Контекст Цикл
		
		ИдентификаторЯщика = КлючЗначение.Ключ;
		СтрокаКонтекста = КлючЗначение.Значение;
		
		Ядро.КонтекстСеанса_ДобавитьСтроку(ИдентификаторЯщика, СтрокаКонтекста);
		
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти СеансРаботыПользователя

// #Область Аннулирование

&НаКлиенте
Процедура ОбработкаАннулирования(ПараметрыОбработки) Экспорт
	
	ДанныеДляОбработки	= ПараметрыОбработки.ДанныеДляОбработки;
	Действие			= ПараметрыОбработки.Действие;
	ФормаВыполнения		= ПараметрыОбработки.ФормаВыполнения;
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	ДоступныеДанныеДляОбработки = Ядро.Документы_ДоступныеДляАннулированияДокументы(
		ДанныеДляОбработки,
		Действие
	);
	
	КоличествоВыбранныхДокументов = ДанныеДляОбработки.Количество();
	КоличествоДоступныхДокументов = ДоступныеДанныеДляОбработки.Количество();
	
	Если КоличествоДоступныхДокументов = 0 Тогда
		
		ПоказатьПредупреждениеОНевозможностиВыполненияДействия(ПараметрыОбработки);
		
	Иначе
		
		ПараметрыОбработки.ДанныеДляОбработки = ДоступныеДанныеДляОбработки;
		
		ПараметрыФормы = ПараметрыФормыАннулированияОтказаВАннулировании(
			Действие,
			КоличествоВыбранныхДокументов,
			КоличествоДоступныхДокументов,
			ПараметрыОбработки
		);
		
		ОписаниеОповещения = НовыйОписаниеОповещения(
			"ОбработчикЗавершенияАннулированияОтказаВАннулировании",
			ЭтаФорма,
			ПараметрыОбработки
		);
		
		ОткрытьФормуДиадокМодальноЛок(
			"ФормаВводаУправляемая",
			ФормаВыполнения,
			ПараметрыФормы,
			ОписаниеОповещения
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыФормыАннулированияОтказаВАннулировании(Действие, КоличествоДокументов, КоличествоДоступныхДокументов, ПараметрыОбработки)

	Результат = ПараметрыФормыВвода();
	Результат.Заголовок					 = "";
	Результат.ТекстСообщения			 = "";
	Результат.ТекстКнопкиВыполнить		 = "";
	Результат.РежимПароля				 = Ложь;
	Результат.ВозможноПустоеЗначение	 = Истина;
	Результат.Действие					 = "";
	Результат.ИдентификаторЯщика		 = ПараметрыОбработки.ИдентификаторЯщика;
	Результат.ГрупповоеДействие			 = ПараметрыОбработки.ГрупповоеДействие;
	Результат.КатегорияМетрикиДокумента	 = ПараметрыОбработки.КатегорияМетрики;
	Результат.КонтрагентПоддерживаетМЧД	 = ПараметрыОбработки.КонтрагентПоддерживаетМЧД;
	 
	Если НЕ Результат.ГрупповоеДействие 
		И КоличествоДоступныхДокументов = 1 Тогда
		
		Документ							 = ПараметрыОбработки.ДанныеДляОбработки[0];
		Результат.ИдентификаторыДокумента	 = Документ.Идентификаторы;
		
	КонецЕсли;
	
	Если КоличествоДокументов = КоличествоДоступныхДокументов Тогда
		
		Если Действие = "Аннулировать" Тогда
			
			Результат.Заголовок					= "Аннулирование документа";
			Результат.ТекстСообщения			= "По каждому документу будет подписано соответствующее уведомление или соглашение об аннулировании";
			Результат.ТекстКнопкиВыполнить		= "Аннулировать";
			Результат.ВозможноПустоеЗначение	= Ложь;
			Результат.Действие					= "Аннулировать";
			
			Если ПараметрыОбработки.Свойство("ДействиеАннулироватьВложение") Тогда
				Результат.Заголовок					= "Аннулирование приглашений с вложениями";
			КонецЕсли;
			
		Иначе
			
			Результат.Заголовок					= "Отказ в аннулировании";
			Результат.ТекстСообщения			= "Документ сохранит юридическую значимость после отказа в аннулировании";
			Результат.ТекстКнопкиВыполнить		= "Отказать";
			Результат.Действие					= "ОтказатьВАннулировании";
			
		КонецЕсли;
		
	ИначеЕсли КоличествоДокументов > КоличествоДоступныхДокументов
		И Не КоличествоДоступныхДокументов = 0 Тогда
		
		Если Действие = "Аннулировать" Тогда
			
			Результат.Заголовок					= "Аннулирование доступных документов";
			Результат.ТекстСообщения			= "Среди выбранных есть документы, которые уже аннулированы или недоступны для аннулирования. "
												+ "Для аннулирования доступных документов оставьте комментарий в поле ниже";
			Результат.ТекстКнопкиВыполнить		= "Аннулировать доступные документы (" + Формат(КоличествоДоступныхДокументов, "ЧГ=0") + ")";
			Результат.ВозможноПустоеЗначение	= Ложь;
			Результат.Действие					= "Аннулировать";
			
		Иначе
			
			Результат.Заголовок					= "Отказ в аннулировании";
			Результат.ТекстСообщения			= "Среди выбранных есть документы, которые уже аннулированы или недоступны для аннулирования";
			Результат.ТекстКнопкиВыполнить		= "Отказать в аннулировании доступных документов (" + Формат(КоличествоДоступныхДокументов, "ЧГ=0") + ")";
			Результат.Действие					= "ОтказатьВАннулировании";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикЗавершенияАннулированияОтказаВАннулировании(РезультатАннулирования, ПараметрыОбработки) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(РезультатАннулирования) Тогда
		Возврат;
	КонецЕсли;
	
	Комментарий = РезультатАннулирования.Комментарий;
	КонтрактМЧД = РезультатАннулирования.КонтрактМЧД;
	
	Действие			= ПараметрыОбработки.Действие;
	ДанныеДляОбработки	= ПараметрыОбработки.ДанныеДляОбработки;
	КатегорияМетрики	= ПараметрыОбработки.КатегорияМетрики;
	ДействиеМетрики		= ПараметрыОбработки.ДействиеМетрики;
	ИсточникОткрытия	= ПараметрыОбработки.ИсточникОткрытия;
	ОписаниеОповещения	= СвойствоСтруктуры(ПараметрыОбработки, "ОписаниеОповещения");
	
	Для Каждого Документ Из ДанныеДляОбработки Цикл
		Документ.СлужебнаяИнформация.Вставить("КонтентОтвета", Комментарий);
	КонецЦикла;
	
	Если НЕ ПараметрыОбработки.ГрупповоеДействие Тогда
		// при групповом дейтсвии контракт уже заполнен в документе
		ДополнитьДокументыСведениямиМЧДНаКлиенте(ДанныеДляОбработки, КонтрактМЧД);
	КонецЕсли;
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	ПакетыДокументов = Ядро.СгруппироватьДокументыПоПакетам(ДанныеДляОбработки);
	
	ОбрабатываютсяДокументыНаОтправку = Ложь;
	
	ВыполнитьМассовуюОбработкуДанных(
		"ОбработатьДокументыСПодписанием",
		ПакетыДокументов,
		Действие,
		Действие,
		ОписаниеОповещения,
		ОбрабатываютсяДокументыНаОтправку
	);
	
	Ядро.Метрика_ДобавитьСтатистику_МассовоеДействиеПоДокументам(
		КатегорияМетрики,
		ДействиеМетрики,
		ДанныеДляОбработки,
		ИсточникОткрытия
	);
	
КонецПроцедуры

// #КонецОбласти Аннулирование

// #Область МЧД

&НаКлиенте
Функция ТребуетсяМЧД(ИдентификаторЯщика) Экспорт
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ИдентификаторЯщика) Тогда
		Ядро = Модуль_ЯдроНаКлиенте();
		КонтекстСеансаПоЯщику = Ядро.КонтекстСеанса_СтрокаКонтекста(ИдентификаторЯщика);
		Результат = КонтекстСеансаПоЯщику.ТребуетсяМЧД = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает параметры для формы выбора МЧД 
// 
// Параметры:
//    ЗаголовокФормы			 - Строка - .
//    ЗаголовокКнопки			 - Строка - .
//    ИдентификаторЯщика		 - Строка - .
//    ДействиеЭДО				 - Строка - элемент структуры ДействияЭДО().
//    КатегорияМетрикиДокумента	 - Строка - категория метрики документа.
//    КонтрагентПоддерживаетМЧД	 - Булево - Истина если оператор контрагента поддерживает отправку МЧД в роуминге.
// 
// Возвращаемое значение:
//    Структура
//
// BSLLS:NumberOfOptionalParams-off
&НаКлиенте
Функция ПараметрыФормыВыбораМЧД(
	ЗаголовокФормы = "",
	ЗаголовокКнопки = "",
	ИдентификаторЯщика = "",
	ДействиеЭДО = "",
	КатегорияМетрикиДокумента = "",
	КонтрагентПоддерживаетМЧД = Истина) Экспорт
// BSLLS:NumberOfOptionalParams-on
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаголовокФормы"				, ЗаголовокФормы);
	Результат.Вставить("ЗаголовокКнопкиДействия"	, ЗаголовокКнопки);
	Результат.Вставить("ИдентификаторЯщика"			, ИдентификаторЯщика);
	Результат.Вставить("ДействиеЭДО"				, ДействиеЭДО);
	Результат.Вставить("КатегорияМетрикиДокумента"	, КатегорияМетрикиДокумента);
	Результат.Вставить("КонтрагентПоддерживаетМЧД"	, КонтрагентПоддерживаетМЧД);
	Результат.Вставить("ДопПеременныеМетрик", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

// Возвращает праметры для метода проверки МЧД 
// 
// Параметры:
//    ОповещениеЗавершения		 - Структура - описание оповещения выполняемого после проверки МЧД.
//    ИдентификаторЯщика		 - Строка - .
//    ВыбраннаяМЧД				 - Структура - см. Модуль_Ядро.Контракт_МЧД().
//    ДействиеЭДО				 - Строка - элемент структуры ДействияЭДО().
//    ГрупповоеДействие			 - Булево - признак, что выполняется групповое действие.
// 
// Возвращаемое значение:
//    Структура
// 
&НаКлиенте
Функция ПараметрыДляПроверкиМЧД(
	ОповещениеЗавершения,
	ИдентификаторЯщика,
	ВыбраннаяМЧД,
	ДействиеЭДО,
	ГрупповоеДействие = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОповещениеЗавершения", ОповещениеЗавершения);
	Результат.Вставить("ИдентификаторЯщика", ИдентификаторЯщика);
	Результат.Вставить("ВыбраннаяМЧД", ВыбраннаяМЧД);
	Результат.Вставить("ДействиеЭДО", ДействиеЭДО);
	Результат.Вставить("ГрупповоеДействие", ГрупповоеДействие);
	Результат.Вставить("ВызовИзТитулаИлиОтказа", Ложь);
	Результат.Вставить("ОшибкиПроверокМЧД", Новый Массив);
	
	Результат.Вставить("РезультатПроверкиМЧД");
	Результат.Вставить("НазваниеФормыДляМетрики");
	Результат.Вставить("РежимОтображенияДокументов", "");
	
	Результат.Вставить("ОписаниеОповещенияДобавленияМетрики");
	
	Результат.Вставить("ДопПеременныеМетрик", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

// Выполняет проверку переданной мчд и по результатам выводит сообщения пользователю
//
// Параметры:
//    ПараметрыДляПроверкиМЧД	 - Структура - см.ПараметрыДляПроверкиМЧД().
//
&НаКлиенте
Процедура ПроверитьМЧДИВыполнитьОповещение(ПараметрыДляПроверкиМЧД) Экспорт
	
	ТребуетсяМЧД = ТребуетсяМЧД(ПараметрыДляПроверкиМЧД.ИдентификаторЯщика);
	ДействияНаФормеВопросаМЧД = ДействияНаФормеВопросаМЧД();
	ВыбраннаяМЧД = ПараметрыДляПроверкиМЧД.ВыбраннаяМЧД;
	ОбработчикПослеПроверкиМЧД = НовыйОписаниеОповещения(
			"ОбработчикПослеПроверкиМЧД",
			ЭтаФорма,
			ПараметрыДляПроверкиМЧД);
	
	Если ТребуетсяМЧД
		И НЕ ЗначениеЗаполнено(ВыбраннаяМЧД) Тогда
		
		ПоказатьВопрос_НеВыбранаМЧД(
			ОбработчикПослеПроверкиМЧД,
			ПараметрыДляПроверкиМЧД);
		
		Возврат;
		
	КонецЕсли;
	
	Если ТребуетсяМЧД Тогда
		
		ПараметрыДляПроверкиМЧД.РезультатПроверкиМЧД = МЧД_БыстраяПроверка(
				ВыбраннаяМЧД,
				ПараметрыДляПроверкиМЧД.ИдентификаторЯщика);
		
		Если ПараметрыДляПроверкиМЧД.РезультатПроверкиМЧД.ЭтоДействующаяМЧД Тогда
			
			ВыполнитьОбработкуОповещенияЛок(
				ОбработчикПослеПроверкиМЧД,
				ДействияНаФормеВопросаМЧД.ДействоватьСМЧД);
			
		ИначеЕсли ПараметрыДляПроверкиМЧД.РезультатПроверкиМЧД.ЭтоПредупреждение Тогда
			
			ПоказатьВопрос_ВыбраннаяМЧДИмеетПредупреждения(
				ОбработчикПослеПроверкиМЧД,
				ПараметрыДляПроверкиМЧД);
			
		Иначе
			
			ПоказатьВопрос_ВыбраннаяМЧДНеПодходит(
				ОбработчикПослеПроверкиМЧД,
				ПараметрыДляПроверкиМЧД);
			
		КонецЕсли;
		
	Иначе
		
		ВыполнитьОбработкуОповещенияЛок(
			ОбработчикПослеПроверкиМЧД,
			ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из ПроверитьМЧДИВыполнитьОповещение()
//
// Параметры:
//    ВыбранноеДействие			 - Строка - см.ДействияНаФормеВопросаМЧД().
//    ПараметрыДляПроверкиМЧД	 - Структура - см.ПараметрыДляПроверкиМЧД().
&НаКлиенте
Процедура ОбработчикПослеПроверкиМЧД(ВыбранноеДействие, ПараметрыДляПроверкиМЧД) Экспорт
	
	Результат = РезультатВыбораМЧД(Ложь, Неопределено);
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	Метрика_НазваниеКатегории = Ядро.Метрика_НазваниеКатегории();
	Метрика_НазваниеДействий = Ядро.Метрика_НазваниеДействий();
	ДействияНаФормеВопросаМЧД = ДействияНаФормеВопросаМЧД();
	
	НазваниеФормыДляМетрики = ПараметрыДляПроверкиМЧД.НазваниеФормыДляМетрики;
	ЛейблМетрики = Метрика_НазваниеДействий.НажатиеКнопки;
	ПредставлениеМетрики = Метрика_ЛейблПоНазваниюФормыМЧД(НазваниеФормыДляМетрики);
	ДопПеременные = Метрика_ДополнительныеПеременныеМЧД(ПараметрыДляПроверкиМЧД);
	
	Если ПараметрыДляПроверкиМЧД.ГрупповоеДействие Тогда
		КатегорияМетрики = Метрика_НазваниеКатегории.УведомлениеПриМассовыхДействиях;
	Иначе
		КатегорияМетрики = Метрика_НазваниеКатегории.УведомлениеИзформыПакета;
	КонецЕсли;
	
	Если ВыбранноеДействие = ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД Тогда
		
		ДействиеМетрики = Метрика_НазваниеДействий.ДействоватьБезДоверенности;
		
		Результат.РазрешитьДействие = Истина;
		
	ИначеЕсли ВыбранноеДействие = ДействияНаФормеВопросаМЧД.ДействоватьСМЧД
		ИЛИ ВыбранноеДействие = ДействияНаФормеВопросаМЧД.ПродолжитьСМЧД Тогда
		
		ДействиеМетрики = Метрика_НазваниеДействий.ДействоватьСДоверенностью;
		
		Результат.РазрешитьДействие = Истина;
		Результат.КонтрактМЧД = ПараметрыДляПроверкиМЧД.ВыбраннаяМЧД;
		
	Иначе
		
		ДействиеМетрики = Метрика_НазваниеДействий.ЗакрытиеФормы;
		
	КонецЕсли;
	
	ИдентификаторТрассировки = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(НазваниеФормыДляМетрики) Тогда
		ИдентификаторТрассировки = Ядро.TraceId();
	КонецЕсли;
	
	Ядро.Метрика_ДобавитьПоведение_НажатиеКнопки(
		НазваниеФормыДляМетрики,
		КатегорияМетрики,
		ДействиеМетрики,
		ЛейблМетрики,
		ПредставлениеМетрики,
		ИдентификаторТрассировки
	);
	Ядро.Метрика_ДобавитьСтатистику_ДляОрганизации(
		ПараметрыДляПроверкиМЧД.ИдентификаторЯщика,
		КатегорияМетрики,
		ДействиеМетрики,
		Неопределено,
		ДопПеременные,
		Неопределено
	);
	
	ВыполнитьОбработкуОповещенияЛок(ПараметрыДляПроверкиМЧД.ОповещениеЗавершения, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопрос_НеВыбранаМЧД(Оповещение, ПараметрыДляПроверкиМЧД)
	
	ПараметрыДляПроверкиМЧД.НазваниеФормыДляМетрики = Метрика_НазванияФормМЧД().НеВыбранаДоверенность;
	
	Метрика_ОткрытиеФормыПредупрежденияПослеПроверкиМЧД(ПараметрыДляПроверкиМЧД);
	
	ГрупповоеДействие = ПараметрыДляПроверкиМЧД.ГрупповоеДействие И НЕ ПараметрыДляПроверкиМЧД.ВызовИзТитулаИлиОтказа;
	
	ДействияНаФормеВопросаМЧД = ДействияНаФормеВопросаМЧД();
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД, ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД);
	Если ГрупповоеДействие Тогда
		КнопкиВопроса.Добавить(
			ДействияНаФормеВопросаМЧД.ОткрытьСписокОшибок,
			ДействияНаФормеВопросаМЧД.ОткрытьСписокОшибок
		);
	КонецЕсли;
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.Закрыть, ДействияНаФормеВопросаМЧД.Закрыть);
	
	ТекстВопроса = 
	"С 1 сентября 2024 года при работе с электронными документами требуется подтверждать полномочия подписанта "
	+ "машиночитаемой доверенностью (МЧД). Если подтверждаете полномочия иным способом, продолжите без МЧД.";
	
	Если ГрупповоеДействие Тогда
		ОписаниеОповещенияОЗавершении = НовыйОписаниеОповещения(
			"ОбработатьРезультатПриГрупповыхДействияхНаФормеВопросаМЧД",
			ЭтаФорма,
			ПараметрыДляПроверкиМЧД
		);
	Иначе
		ОписаниеОповещенияОЗавершении = Оповещение;
	КонецЕсли;
	
	ПоказатьВопросЛок(
		ОписаниеОповещенияОЗавершении,
		ТекстВопроса,
		КнопкиВопроса,
		,
		ДействияНаФормеВопросаМЧД.Закрыть,
		"Не выбрана доверенность"
	);
	
КонецПроцедуры

// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingParameterDescription-off
&НаКлиенте
Процедура ПоказатьВопрос_ВыбраннаяМЧДИмеетПредупреждения(Оповещение, ПараметрыДляПроверкиМЧД)
	// BSLLS:MissingReturnedValueDescription-on
	// BSLLS:MissingParameterDescription-on
	ПараметрыДляПроверкиМЧД.НазваниеФормыДляМетрики = Метрика_НазванияФормМЧД().ВыбраннаяДоверенностьИмеетПредупреждения;
	
	Метрика_ОткрытиеФормыПредупрежденияПослеПроверкиМЧД(ПараметрыДляПроверкиМЧД);
	Метрика_ЗаписатьСтатистику_ДоверенностьСПредупреждениями(ПараметрыДляПроверкиМЧД);
	
	ДействияНаФормеВопросаМЧД = ДействияНаФормеВопросаМЧД();
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.ПродолжитьСМЧД, ДействияНаФормеВопросаМЧД.ПродолжитьСМЧД);
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД, ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД);
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.Закрыть, ДействияНаФормеВопросаМЧД.Закрыть);
	
	ШаблонВопроса =
		"%1
		|
		|%2 
		|
		|Если хотите выполнить действие с выбранной доверенностью, то продолжите с МЧД. При необходимости выберите другую 
		|доверенность или продолжите действие без МЧД.";
	
	МассивОшибок = Новый Массив;
	Для Каждого ОписаниеОшибки Из ПараметрыДляПроверкиМЧД.РезультатПроверкиМЧД.СписокОшибок Цикл
		РасшифровкаОшибки = "- " + ОписаниеОшибки.Расшифровка;
		МассивОшибок.Добавить(РасшифровкаОшибки);
	КонецЦикла;
	
	Модуль_Ядро = Модуль_ЯдроНаКлиенте();
	
	СписокОшибокСтрокой = Модуль_Ядро.СоединитьСтроку(МассивОшибок, Символы.ПС);
	ПредставлениеМЧД = ПараметрыДляПроверкиМЧД.ВыбраннаяМЧД.ПредставлениеМЧД;
	
	ТекстВопроса = Модуль_Ядро.Общее_ПодставитьПараметрыВСтроку(ШаблонВопроса, ПредставлениеМЧД, СписокОшибокСтрокой);
	
	ПоказатьВопросЛок(
		Оповещение,
		ТекстВопроса,
		КнопкиВопроса,
		,
		ДействияНаФормеВопросаМЧД.ПродолжитьСМЧД,
		"Выбранная доверенность с предупреждениями");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопрос_ВыбраннаяМЧДНеПодходит(Оповещение, ПараметрыДляПроверкиМЧД)
	
	ПараметрыДляПроверкиМЧД.НазваниеФормыДляМетрики = Метрика_НазванияФормМЧД().ВыбраннаяДоверенностьНеПодходит;
	
	Метрика_ОткрытиеФормыПредупрежденияПослеПроверкиМЧД(ПараметрыДляПроверкиМЧД);
	
	ДействияНаФормеВопросаМЧД = ДействияНаФормеВопросаМЧД();
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД, ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД);
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.Закрыть, ДействияНаФормеВопросаМЧД.Закрыть);
	
	ШаблонВопроса = 
	"%1
	|
	|%2 
	|
	|Выберите другую доверенность или выпустите новую.";
	
	МассивОшибок = Новый Массив;
	Для каждого ОписаниеОшибки Из ПараметрыДляПроверкиМЧД.РезультатПроверкиМЧД.СписокОшибок Цикл
		РасшифровкаОшибки	 = "- " + ОписаниеОшибки.Расшифровка;
		МассивОшибок.Добавить(РасшифровкаОшибки);
	КонецЦикла;
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	СписокОшибокСтрокой = Ядро.СоединитьСтроку(МассивОшибок, Символы.ПС);
	ПредставлениеМЧД = ПараметрыДляПроверкиМЧД.ВыбраннаяМЧД.ПредставлениеМЧД;
	ТекстВопроса = Ядро.Общее_ПодставитьПараметрыВСтроку(ШаблонВопроса, ПредставлениеМЧД, СписокОшибокСтрокой);
	
	ПоказатьВопросЛок(
		Оповещение,
		ТекстВопроса,
		КнопкиВопроса,
		,
		ДействияНаФормеВопросаМЧД.Закрыть,
		"Выбранная доверенность не подходит"
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопрос_НетПодходящейДоверенности(ПараметрыДляПроверкиМЧД, ОбработчикВопроса) Экспорт
	
	ПараметрыДляПроверкиМЧД.НазваниеФормыДляМетрики = Метрика_НазванияФормМЧД().НетПодходящихДовереностей;
	
	Метрика_ОткрытиеФормыПредупрежденияПослеПроверкиМЧД(ПараметрыДляПроверкиМЧД);
	
	ДействияНаФормеВопросаМЧД = ДействияНаФормеВопросаМЧД();
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД	, ДействияНаФормеВопросаМЧД.ПродолжитьБезМЧД);
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.ОткрытьСписокОшибок, ДействияНаФормеВопросаМЧД.ОткрытьСписокОшибок);
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаМЧД.Закрыть			, ДействияНаФормеВопросаМЧД.Закрыть);
	
	ТекстВопроса =
	"С 1 сентября 2024 года при работе с электронными документами требуется подтверждать полномочия подписанта "
	+ "машиночитаемой доверенностью (МЧД).
	|
	|При выполнении действия с доверенностями произошли ошибки. Перейдите по кнопке ""Подробнее"" для просмотра причин";
	
	ПоказатьВопросЛок(
		ОбработчикВопроса,
		ТекстВопроса,
		КнопкиВопроса,
		,
		ДействияНаФормеВопросаМЧД.Закрыть,
		"Нет подходящих доверенностей"
	);
	
КонецПроцедуры

// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingParameterDescription-off
&НаСервере
Функция МЧД_БыстраяПроверка(Знач ВыбраннаяМЧД, Знач ИдентификаторЯщика)
	// BSLLS:MissingReturnedValueDescription-on
	// BSLLS:MissingParameterDescription-on
	Модуль_Ядро = Модуль_Ядро();
	
	Результат = Модуль_Ядро.МЧД_БыстраяПроверка(ВыбраннаяМЧД, ИдентификаторЯщика);
	
	Возврат Результат;
	
КонецФункции

// Открывает форму выбора МЧД 
// 
// Параметры:
//    ОписаниеОбработчикаЗакрытия.
//    ПараметрыОткрытияФормы		 - Структура - см. ПараметрыФормыВыбораМЧД().
// 
&НаКлиенте
Процедура ОткрытьФормуВыбораДоверенности(ОписаниеОбработчикаЗакрытия, ПараметрыОткрытияФормы) Экспорт
	
	ОткрытьФормуДиадокМодальноЛок(
		"МЧД_ФормаВыбораУправляемая",
		ОписаниеОбработчикаЗакрытия.Модуль,
		ПараметрыОткрытияФормы,
		ОписаниеОбработчикаЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиенте
Функция РезультатВыбораМЧД(РазрешитьДействие, КонтрактМЧД) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("РазрешитьДействие", РазрешитьДействие);
	Результат.Вставить("КонтрактМЧД", КонтрактМЧД);
	
	Возврат Результат;
	
КонецФункции

// см. ДополнитьДокументыСведениямиМЧДКлиентСервер()
// 
&НаКлиенте
Процедура ДополнитьДокументыСведениямиМЧДНаКлиенте(КонтрактыДокументов, КонтрактМЧД) Экспорт
	
	Для Каждого Документ Из КонтрактыДокументов Цикл	
		ДополнитьДокументСведениямиМЧДКлиентСервер(Документ, КонтрактМЧД);
	КонецЦикла;
	
КонецПроцедуры

// Дополняет служебную информацию переданных документов КонтрактомМЧД 
// 
// Параметры:
//    Документ		 - Структура - ДокументДД, см. Модуль_Ядро.Контракт_Документ().
//    КонтрактМЧД	 - Структура - см. Модуль_Ядро.Контракт_МЧД().
// 
&НаКлиентеНаСервереБезКонтекста
Процедура ДополнитьДокументСведениямиМЧДКлиентСервер(Документ, КонтрактМЧД)
	
	Если НЕ Документ.СлужебнаяИнформация.Свойство("КонтрактМЧД") Тогда
		Документ.СлужебнаяИнформация.Вставить("КонтрактМЧД", КонтрактМЧД);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МЧД_ПоказатьСведенияОДоверенности(КонтрактМЧД, ФормаВызова) Экспорт
	
	СведенияОМЧД = МЧД_ПредставлениеСведенийОДоверенностиНаСервере_HTML(КонтрактМЧД);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ЗаголовокФормы", НСтр("ru='Данные МЧД'"));	
	ПараметрыОткрытияФормы.Вставить("ТекстСообщения", СведенияОМЧД.ТекстHTML);
	ПараметрыОткрытияФормы.Вставить("ТекстДляКопирования", СведенияОМЧД.Текст);
	ПараметрыОткрытияФормы.Вставить("ПоказатьКнопкуСкопировать"	, Истина);
	
	ОткрытьФормуДиадокМодальноЛок(
		"ФормаHTMLСообщенияУправляемая",
		ФормаВызова,
		ПараметрыОткрытияФормы,
		Неопределено,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаСервере
Функция МЧД_ПредставлениеСведенийОДоверенностиНаСервере_HTML(КонтрактМЧД)
	
	Результат = ОбработкаОбъект().МЧД_ПредставлениеСведенийОДоверенности_HTML(КонтрактМЧД);
	Возврат Результат;
	
КонецФункции

// Обрабатывает нажатие гиперссылки на скачивание файлов доверенности в формах пакета и сообщения HTML
//
// Параметры:
//  ПараметрыСкачиванияФайловМЧД - Строка - см. Ядро.Новый_ПараметрыГиперссылкиСкачатьФайлыДоверенности()
//
&НаКлиенте
Процедура ОбработатьНажатиеГиперссылкиСкачатьФайлыМЧД(ПараметрыСкачиванияФайловМЧД) Экспорт
	
	ОписаниеОповещения = НовыйОписаниеОповещения("ОкончаниеВыбораКаталогаПриНажатииСкачатьФайлыДоверенности", ЭтаФорма, ПараметрыСкачиванияФайловМЧД);
	ПоказатьДиалогВыбораКаталога(ОписаниеОповещения, НСтр("ru = 'Сохранение файлов доверенности на диск'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВыбораКаталогаПриНажатииСкачатьФайлыДоверенности(ВыбранныйКаталог, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	Модуль_Ядро = Модуль_ЯдроНаКлиенте();
	
	ПредставлениеТекущегоДокумента = ДополнительныеПараметры.ПредставлениеТекущегоДокумента;
	ПрефиксКаталога = "МЧД к ";
	ИмяКаталога = ЗаменитьНедопустимыеСимволыИмениФайла(ПрефиксКаталога + ПредставлениеТекущегоДокумента);
	ПолноеИмяКаталога = Модуль_Ядро.ОбъединитьПути(ВыбранныйКаталог[0], ИмяКаталога);
	
	СоздатьКаталог(ПолноеИмяКаталога);
	
	ФайлыДоверенности = Модуль_Ядро.Документы_СобытияМЧД_ФайлыДоверенности(ДополнительныеПараметры.ПараметрыГиперссылки);
	
	СохранитьФайлыДоверенностиНаДиск(ФайлыДоверенности, ПолноеИмяКаталога);
	
	Если ФайлыДоверенности.ДанныеФайловДелегированныхМЧД.Количество() > 0 Тогда
		
		ПрефиксКаталогаДелегированныхМЧД = "Передоверие ";
		ИмяКаталогаДелегированныхМЧД = ЗаменитьНедопустимыеСимволыИмениФайла(ПрефиксКаталогаДелегированныхМЧД + ФайлыДоверенности.ИмяФайла);
		ПолноеИмяКаталогаДелегированныхМЧД = Модуль_Ядро.ОбъединитьПути(ПолноеИмяКаталога, ИмяКаталогаДелегированныхМЧД);
		
		СоздатьКаталог(ПолноеИмяКаталогаДелегированныхМЧД);
		
		Для Каждого ДанныеФайловДелегированнойМЧД Из ФайлыДоверенности.ДанныеФайловДелегированныхМЧД Цикл
			СохранитьФайлыДоверенностиНаДиск(ДанныеФайловДелегированнойМЧД, ПолноеИмяКаталогаДелегированныхМЧД);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатиеСкачатьФайлЭлектроннойПодписи(ДанныеЭлектроннойПодписи) Экспорт
	
	ОписаниеОповещения = НовыйОписаниеОповещения(
		"ОкончаниеВыбораКаталогаПриНажатииСкачатьФайлЭлектроннойПодписи",
		ЭтаФорма,
		ДанныеЭлектроннойПодписи
	);
	
	ПоказатьДиалогВыбораКаталога(ОписаниеОповещения, НСтр("ru = 'Сохранение файла электронной подписи'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВыбораКаталогаПриНажатииСкачатьФайлЭлектроннойПодписи(
	ВыбранныйКаталог,
	ДанныеЭлектроннойПодписи) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмяКаталога = ВыбранныйКаталог[0];
	// BSLLS:UsingSynchronousCalls-off
	СоздатьКаталог(ПолноеИмяКаталога);
	// BSLLS:UsingSynchronousCalls-on
	ДанныеПодписи = ДанныеЭлектроннойПодписи.ДанныеПодписи;
	ИмяФайлаПодписи = ДанныеЭлектроннойПодписи.ИмяФайлаПодписи;
	ДвоичныеДанныеПодписи = Base64Значение(ДанныеПодписи);
	
	ИнтерфейсСМВ = Модуль_СинхронноМодальныеВызовы();
	ИнтерфейсСМВ.смв_СохранитьДвоичныеДанныеВФайл(
		ДвоичныеДанныеПодписи,
		ИмяФайлаПодписи,
		ПолноеИмяКаталога
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатиеСкачатьФайлСертификата(ДанныеЭлектроннойПодписи) Экспорт
	
	ОписаниеОповещения = НовыйОписаниеОповещения(
		"ОкончаниеВыбораКаталогаПриНажатииСкачатьФайлСертификата",
		ЭтаФорма,
		ДанныеЭлектроннойПодписи
	);
	
	ПоказатьДиалогВыбораКаталога(ОписаниеОповещения, НСтр("ru = 'Сохранение файла электронной подписи'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВыбораКаталогаПриНажатииСкачатьФайлСертификата(
	ВыбранныйКаталог,
	ДанныеЭлектроннойПодписи) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	Модуль_Ядро = Модуль_ЯдроНаКлиенте();
	ПолноеИмяКаталога = ВыбранныйКаталог[0];
	// BSLLS:UsingSynchronousCalls-off
	СоздатьКаталог(ПолноеИмяКаталога);
	// BSLLS:UsingSynchronousCalls-on
	ДанныеПодписи = ДанныеЭлектроннойПодписи.ДанныеПодписи;
	ДвоичныеДанныеПодписи = Base64Значение(ДанныеПодписи);
	ДанныеСертификата = Модуль_Ядро.ПолучитьСертификатИзПодписи(ДвоичныеДанныеПодписи);
	ИмяФайлаСертификата = ДанныеСертификата.СерийныйНомер + ".crt";
	
	ИнтерфейсСМВ = Модуль_СинхронноМодальныеВызовы();
	ИнтерфейсСМВ.смв_СохранитьДвоичныеДанныеВФайл(
		ДанныеСертификата.ДвоичныеДанные,
		ИмяФайлаСертификата,
		ПолноеИмяКаталога
	);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлыДоверенностиНаДиск(ФайлыДоверенности, ПолноеИмяКаталога)
	
	ДанныеДоверенности = ФайлыДоверенности.Данные;
	ДанныеПодписи = ФайлыДоверенности.Подпись.ДанныеПодписи;
	
	ИмяФайлаДоверенности = ФайлыДоверенности.ИмяФайла + ".xml";
	ИмяФайлаПодписи	 = ФайлыДоверенности.ИмяФайла + ".sig";
	
	Модуль_смв = Модуль_СинхронноМодальныеВызовы();
	
	Модуль_смв.смв_СохранитьДвоичныеДанныеВФайл(ДанныеДоверенности, ИмяФайлаДоверенности, ПолноеИмяКаталога);
	Модуль_смв.смв_СохранитьДвоичныеДанныеВФайл(ДанныеПодписи, ИмяФайлаПодписи, ПолноеИмяКаталога);
	
КонецПроцедуры

// Для переданных данных групповой операции выполняет проверку сертификатов на КЭП.
//
// Параметры:
//	ДанныеДляОбработки - Массив - см. Новый_ПараметрыГрупповойОбработки().ДанныеДляОбработки
//	ДействиеЭДО - Строка - значение перечисления Перечисление_ДействияЭДО()
//
// Возвращаемое значение:
//  Структура
//		* ОшибкиПроверки				 - Массив- Список ошибок проверки. См Ядро.Новый_ОписаниеОшибкиПроверкиКЭП() 
//		* ДанныеДляОбработкиБезОшибок	 - Массив- ДанныеДляОбработки без ошибок КЭП 
//
&НаСервере
Функция КЭП_ПроверитьДанныеГрупповойОперацииНаСервере(ДанныеДляОбработки, ДействиеЭДО) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОшибкиПроверки", Новый Массив);
	Результат.Вставить("ДанныеДляОбработкиБезОшибок", Новый Массив);
	
	Модуль_Ядро = Модуль_Ядро();
	
	СгруппированныеДанные = СгруппироватьДанныеДляОбработкиПоИдентификаторуЯщика(ДанныеДляОбработки);
	
	Для каждого КлючЗначение Из СгруппированныеДанные Цикл
		
		BoxID = КлючЗначение.Ключ;
		
		ОписаниеОшибкиПроверкиКЭП = Модуль_Ядро.КЭП_ДоступноДействиеЭДО(ДействиеЭДО, BoxID);
		Если ЗначениеЗаполнено(ОписаниеОшибкиПроверкиКЭП) Тогда
			
			СгруппированныеДанные.Вставить(BoxId, Новый Массив);
			Модуль_Ядро.ДополнитьМассив(Результат.ОшибкиПроверки, ОписаниеОшибкиПроверкиКЭП);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ДанныеПоBoxID Из СгруппированныеДанные Цикл
		Модуль_Ядро.ДополнитьМассив(Результат.ДанныеДляОбработкиБезОшибок, ДанныеПоBoxID.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СгруппироватьДанныеДляОбработкиПоИдентификаторуЯщика(ДанныеДляОбработки)
	
	Модуль_Ядро = Модуль_Ядро();
	Результат = Новый Соответствие;
	
	Если ЕстьСвойствоИдентификаторыВОбрабатываемыхДанных(ДанныеДляОбработки) Тогда
		
		Для каждого Документ Из ДанныеДляОбработки Цикл
			
			BoxId = Документ.Идентификаторы.BoxId;
			
			Если Модуль_Ядро.ЭтоАдресЯщика(BoxId) Тогда
				BoxId = Модуль_Ядро.АдресЯщикаВИдентификатор(BoxId);
			КонецЕсли;
			
			ДанныеПоBoxId = Результат.Получить(BoxId);
			
			Если ДанныеПоBoxId = Неопределено Тогда
				Результат.Вставить(BoxId, Новый Массив);
				ДанныеПоBoxId = Результат.Получить(BoxId);
			КонецЕсли;
			
			ДанныеПоBoxId.Добавить(Документ);
			
		КонецЦикла;
		
	Иначе
		
		Организации1С = Новый Массив;
		Для Каждого СтрокаСписка Из ДанныеДляОбработки Цикл
			Организация = СтрокаСписка.Организация;
			Если Организации1С.Найти(Организация) = Неопределено Тогда
				Организации1С.Добавить(Организация);
			КонецЕсли;
		КонецЦикла;
		
		УчастникиДО = Модуль_Ядро.Организации_ДанныеУчастниковДОПоОрганизациям1С(Организации1С);
		
		Для каждого УчастникДО Из УчастникиДО Цикл
			
			BoxId = УчастникДО.BoxId;
			ПараметрыОтбора = Новый Структура("Организация", УчастникДО.Организация);
			ДокументыПоОрганизации = Модуль_Ядро.МассивСтруктур_НайтиСтроки(ДанныеДляОбработки, ПараметрыОтбора);
			Результат.Вставить(BoxId, ДокументыПоОрганизации);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьСвойствоИдентификаторыВОбрабатываемыхДанных(ДанныеДляОбработки)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ДанныеДляОбработки) Тогда
		
		ЭлементКоллекцииДанных = ДанныеДляОбработки[0];
		
		Если ТипЗнч(ЭлементКоллекцииДанных) = Тип("Структура")
			И ЭлементКоллекцииДанных.Свойство("Идентификаторы")
			И ЭлементКоллекцииДанных.Идентификаторы <> Неопределено Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьИПроверитьМЧДпоУмолчаниюПередОтправкойДокументов(ДанныеДляОбработки) Экспорт
	
	ДокументыБезМЧД = Новый Массив;
	Для каждого Документ Из ДанныеДляОбработки Цикл
		Если НЕ Документ.СлужебнаяИнформация.Свойство("КонтрактМЧД") Тогда
			ДокументыБезМЧД.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;
	
	СписокОшибок = Новый Массив;
	
	Модуль_Ядро = Модуль_Ядро();
	
	СгруппированныеДанные = СгруппироватьДанныеДляОбработкиПоИдентификаторуЯщика(ДокументыБезМЧД);
	ИдентификаторыЯщиков = Модуль_Ядро.ВыгрузитьКолонку(СгруппированныеДанные, "Ключ", Истина);
	
	КонтрактыМЧД = ПолучитьДействующиеМЧДпоУмолчанию(ИдентификаторыЯщиков, СписокОшибок);
	
	Для Каждого ИдентификаторЯщика Из ИдентификаторыЯщиков Цикл
		
		КонтрактМЧД = КонтрактыМЧД.Получить(ИдентификаторЯщика);
		
		ДокументыПоИдентификатору = СгруппированныеДанные.Получить(ИдентификаторЯщика);
		Для Каждого Документ Из ДокументыПоИдентификатору Цикл
			ДополнитьДокументСведениямиМЧДКлиентСервер(Документ, КонтрактМЧД);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СписокОшибок;
	
КонецФункции

&НаСервере
Функция ПолучитьДействующиеМЧДпоУмолчанию(ИдентификаторыЯщиков, СписокОшибок) Экспорт
	
	Результат = Новый Соответствие;
	
	Модуль_Ядро = Модуль_Ядро();
	
	КонекстыДанныхМЧД = Модуль_Ядро.МЧД_ДанныеПоИспользованиюДоверенностейПоСпискуBoxId(ИдентификаторыЯщиков);
	РазделыОшибок = Модуль_Ядро.МЧД_РазделыОшибокПроверкиМЧД();
	Метрика_ВидыОшибокПроверокМЧД = Метрика_ВидыОшибокПроверокМЧД();
	
	Для Каждого ИдентификаторЯщика Из ИдентификаторыЯщиков Цикл
		
		КонтекстМЧД = КонекстыДанныхМЧД.Получить(ИдентификаторЯщика);
		
		Если НЕ КонтекстМЧД.ТребуетсяМЧД Тогда
			Продолжить;
		КонецЕсли;
		
		КонтрактМЧД = Неопределено;
		
		Если ЗначениеЗаполнено(КонтекстМЧД.МЧД) Тогда
			
			КонтрактМЧД = КонтекстМЧД.СписокМЧД.Получить(КонтекстМЧД.МЧД);
			
			РезультатПроверкиМЧД = КонтекстМЧД.РезультатПроверкиМЧД;
			Если НЕ РезультатПроверкиМЧД.ЭтоДействующаяМЧД 
				И НЕ РезультатПроверкиМЧД.ЭтоПредупреждение Тогда
				
				НаименованиеОрганизации = Модуль_Ядро.КонтекстСеанса_Прочитать(ИдентификаторЯщика, "ОрганизацияНаименование");
				
				ТекстОшибки = Модуль_Ядро.Общее_ПодставитьПараметрыВСтроку(
					"Для организации ""%1"" доверенность ""%2"" не прошла проверку",
					НаименованиеОрганизации,
					КонтрактМЧД.Представитель.Наименование
				);
				
				ОписаниеОшибки = Новый_ОписаниеОшибкиПроверкиМЧДпоУмолчанию(
					РазделыОшибок.МЧДнеПодходит,
					ТекстОшибки,
					РезультатПроверкиМЧД.СписокОшибок,
					Метрика_ВидыОшибокПроверокМЧД.ДоверенностьНеПодходит,
					ИдентификаторЯщика
				);
				
				СписокОшибок.Добавить(ОписаниеОшибки);
				
				КонтрактМЧД = Неопределено;
				
			КонецЕсли;
			
		Иначе
			
			НаименованиеОрганизации = Модуль_Ядро.КонтекстСеанса_Прочитать(ИдентификаторЯщика, "ОрганизацияНаименование");
			
			ОписаниеОшибки = Новый_ОписаниеОшибкиПроверкиМЧДпоУмолчанию(
				РазделыОшибок.НетМЧДПоУмолчанию,
				НаименованиеОрганизации,
				Новый Массив,
				Метрика_ВидыОшибокПроверокМЧД.НеУказанаДоверенность,
				ИдентификаторЯщика
			);
			
			СписокОшибок.Добавить(ОписаниеОшибки);
			
		КонецЕсли;
		
		Результат.Вставить(ИдентификаторЯщика, КонтрактМЧД);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

