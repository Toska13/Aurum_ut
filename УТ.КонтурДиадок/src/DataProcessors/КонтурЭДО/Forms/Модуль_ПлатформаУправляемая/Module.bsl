&НаКлиенте
Функция ПроверитьЗаданиеОтправкиНаПодписьГосключ(ИдентификаторЗадания, ИдентификаторЯщика) Экспорт
	
	РезультатПодписанияГосключ = РезультатПодписанияГосключ();
	
	ЯдроНаКлиенте = Модуль_ЯдроНаКлиенте();
	
	РезультатПодписания = ЯдроНаКлиенте.Госключ_ПроверитьЗаданиеОтправкиНаПодпись(ИдентификаторЗадания,
		ИдентификаторЯщика);

	ПодробноеОписаниеСтатуса = РезультатПодписания.ПодробноеОписаниеСтатуса;
	
	РезультатПодписанияГосключ.ПодробноеОписаниеСтатуса = ПодробноеОписаниеСтатуса;
	
	Если РезультатПодписания.Завершено Тогда
		РезультатПодписанияГосключ.РазрешитьДействие = Истина;
		РезультатПодписанияГосключ.ОшибкаПриПодписании = РезультатПодписания.ОшибкаПриПодписании;
		РезультатПодписанияГосключ.РезультатПодписания = РезультатПодписания;
		
		Если РезультатПодписанияГосключ.ОшибкаПриПодписании Тогда
			Если РезультатПодписания.ОтказПользователя Тогда
				РезультатПодписанияГосключ.СтатусПодписания = Перечисление_СтатусыПодписанияГосключ().ОтказПользователя;
			Иначе
				РезультатПодписанияГосключ.СтатусПодписания = Перечисление_СтатусыПодписанияГосключ().ОшибкаПодписания;
			КонецЕсли;
		Иначе
			РезультатПодписанияГосключ.СтатусПодписания = Перечисление_СтатусыПодписанияГосключ().УспешноеПодписание;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПодписанияГосключ;
	
КонецФункции

// Проверяет валидность СНИЛС по контрольному числу
//
// Параметры:
//  ВведенныйСНИЛС	 - Строка	 - формата "XXXX-XXXX-XXX YY"
// 
// Возвращаемое значение:
//  Булево - Истина, если СНИЛС валиден
//
&НаКлиенте
Функция ЭтоВалидныйСНИЛС(Знач ВведенныйСНИЛС)
	// BSLLS:MagicNumber-off
	
	// https://info.gosuslugi.ru/articles/%D0%92%D0%B0%D0%BB%D0%B8%D0%B4%D0%B0%D1%86%D0%B8%D1%8F/
	
	СНИЛС = ВведенныйСНИЛС;
	СНИЛС = СтрЗаменить(СНИЛС, "-", "");
	СНИЛС = СтрЗаменить(СНИЛС, " ", "");
	
	Если СтрДлина(СНИЛС) <> 11
		Или Не Модуль_СтдСтрНаКлиенте().ТолькоЦифрыВСтрокеЛок(СНИЛС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтрольноеЧисло = 0;
	
	Для Инд = 1 По 9 Цикл
		
		ПроверяемыйРазряд = Сред(СНИЛС, 10 - Инд, 1);
		ПроверяемыйРазрядЧислом = Число(ПроверяемыйРазряд);
		
		КонтрольноеЧисло = КонтрольноеЧисло + ПроверяемыйРазрядЧислом * Инд;
		
	КонецЦикла;
	
	КонтрольноеЧислоСтрокой = "";
	
	Если КонтрольноеЧисло > 100 Тогда
		КонтрольноеЧисло = КонтрольноеЧисло % 101;
	КонецЕсли;
	
	Если КонтрольноеЧисло < 100 Тогда
		КонтрольноеЧислоСтрокой = Формат(КонтрольноеЧисло, "ЧЦ=2; ЧВН=; ЧГ=");
	Иначе
		// тут должно остаться только КонтрольноеЧисло = 100
		КонтрольноеЧислоСтрокой = "00";
	КонецЕсли;
	
	КонтрольноеЧислоВведенное = Сред(СНИЛС, 10, 2);
	
	Возврат КонтрольноеЧислоВведенное = КонтрольноеЧислоСтрокой;
	
	// BSLLS:MagicNumber-on
КонецФункции

// Проверяет валидность OID
// пока просто на заполненность
//
// Параметры:
//  ВведенныйOID	 - Строка	 - OID на проверку
// 
// Возвращаемое значение:
//  Булево - Истина, если OID валиден
//
&НаКлиенте
Функция ЭтоВалидныйOID(Знач ВведенныйOID)
	
	Если ПустаяСтрока(ВведенныйOID) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьВопрос_ДляДокументаНевозможноВыполнитьДействиеГосключ(СписокОшибокГосключ) Экспорт
	
	ДействияНаФормеВопросаКЭП = ДействияНаФормеВопросаКЭП();
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаКЭП.ОткрытьСписокОшибок, ДействияНаФормеВопросаКЭП.ОткрытьСписокОшибок);
	КнопкиВопроса.Добавить(ДействияНаФормеВопросаКЭП.Закрыть, ДействияНаФормеВопросаКЭП.Закрыть);
	
	ТекстВопроса = 
	"
	|Чтобы узнать о возможных причинах ошибки нажмите на кнопку ""Подробнее""."; 
	
	ОбработчикЗакрытияВопроса = НовыйОписаниеОповещения(
		"ОбработатьРезультатВыбора_ДляДокументаНевозможноВыполнитьДействиеГосключ",
		ЭтаФорма,
		СписокОшибокГосключ
	);
	ПоказатьВопросЛок(
		ОбработчикЗакрытияВопроса,
		ТекстВопроса,
		КнопкиВопроса,
		,
		ДействияНаФормеВопросаКЭП.Закрыть,
		"Ошибки при подписании Госключом"
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыбора_ДляДокументаНевозможноВыполнитьДействиеГосключ(ВыбранноеДействие,
	СписокОшибокГосключ) Экспорт
	
	ДействияНаФормеВопросаКЭП = ДействияНаФормеВопросаКЭП();
	
	ОткрытьСписокОшибок = ВыбранноеДействие = ДействияНаФормеВопросаКЭП.ОткрытьСписокОшибок;
	
	Если ОткрытьСписокОшибок Тогда
		
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("Режим", "ОшибкиГосключПриДействии");
		ПараметрыОткрытияФормы.Вставить("СписокОшибокГосключ", СписокОшибокГосключ);
		
		ОткрытьФормуДиадокМодальноЛок(
			"ФормаHTMLСообщенияУправляемая",
			ЭтаФорма,
			ПараметрыОткрытияФормы
		);
		
	КонецЕсли;
		
КонецПроцедуры

