// BSLLS:NumberOfOptionalParams-off
&НаКлиенте
Функция ДлительныеОперации_ВыполнитьВФоне(
	ИмяМетода,
	Знач Параметр1 = Null,
	Знач Параметр2 = Null,
	Знач Параметр3 = Null,
	Знач Параметр4 = Null,
	Знач Параметр5 = Null) Экспорт
	
// BSLLS:NumberOfOptionalParams-on
	
	ПараметрыВыполнения = Модуль_ДлительныеОперацииКлиент().НовыеПараметрыВыполнения(УникальныйИдентификатор);
	
