// Заменяет символы, которые не допускаются в путях файловой системы, на "_"
//
// Параметры:
//  ИмяФайла - Строка - любая строка
// 
// Возвращаемое значение:
//  Строка - обработанная строка.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНедопустимыеСимволыИмениФайла(Знач ИмяФайла)
	
	Результат = ИмяФайла;
	
	НедопустимыеСимволы = ":~!@/\#$%^&*=|`""?<>";
	КоличествоНедопустимыхСимволов = СтрДлина(НедопустимыеСимволы);
	
	Для Сч = 1 По КоличествоНедопустимыхСимволов Цикл
		Результат = СтрЗаменить(Результат, Сред(НедопустимыеСимволы, Сч, 1), "_");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОбщийBoxId(ВыбранныеBoxId)
	
	Результат = Неопределено;
	
	Если ВыбранныеBoxId.Количество() > 0 Тогда
		
		Если ВыбранныеBoxId.Количество() <> 1 Тогда
			ПоказатьПредупреждениеЛок(, "В списке выбраны документы по различным организациям.
										|Выберите документы, относящиеся только к одной организации.");
		Иначе
			Результат = ВыбранныеBoxId[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

