// BSLLS:NumberOfOptionalParams-off
&НаКлиенте
Процедура ПоказатьДиалогСохранение(
	ОписаниеОповещенияОЗавершении,
	Знач Фильтр = Неопределено,
	Знач ЗаголовокОкнаДиалога = Неопределено,
	Знач Каталог = Неопределено,
	Знач ПолноеИмяФайла = Неопределено)
// BSLLS:NumberOfOptionalParams-on
	
	Расширение	 = "";
	
	Если НЕ ЗначениеЗаполнено(Фильтр) И ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		
		Файл		 = Новый Файл(ПолноеИмяФайла);
		Расширение	 = Файл.Расширение;
		
		Если ЗначениеЗаполнено(Расширение) Тогда
			Фильтр = "Документ (*" + Расширение + ")|*" + Расширение + "|Все документы (*.*)|*.*";
		КонецЕсли;
		
	КонецЕсли;

	ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	
	Если ЗначениеЗаполнено(Фильтр) Тогда
		ДиалогСохраненияФайла.Фильтр = Фильтр;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаголовокОкнаДиалога) Тогда
		ДиалогСохраненияФайла.Заголовок = ЗаголовокОкнаДиалога;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Каталог) Тогда
		ДиалогСохраненияФайла.Каталог = Каталог;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		ДиалогСохраненияФайла.ПолноеИмяФайла = ПолноеИмяФайла;
	КонецЕсли;
	
	СтдДиалоги = Модуль_СтдДиалоги();
	СтдДиалоги.ПоказатьДиалогВыбораФайла(ДиалогСохраненияФайла, ОписаниеОповещенияОЗавершении);
	
КонецПроцедуры

