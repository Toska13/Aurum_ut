		ИмяИнтерфейса = "DataProcessor.КонтурДиадокМенеджерПлагинов.Форма.СписокПлагинов";
		Если ЭтоВнешняяОбработка Тогда
			ИмяИнтерфейса = "External" + ИмяИнтерфейса;
