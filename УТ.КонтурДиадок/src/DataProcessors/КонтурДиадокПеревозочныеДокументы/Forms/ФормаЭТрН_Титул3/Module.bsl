
&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаКлиенте
Перем _Платформа;

&НаСервере
Перем _МодульЯдроНаСервере;

#Область СлужебныеМетоды

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Модуль_Ядро = Модуль_ЯдроНаСервере();
		_ОбработкаОбъект.ИнициализироватьМодуль(Модуль_Ядро); 
		
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Функция Модуль_Платформа() Экспорт
	
	Возврат _Платформа;
	
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте()
	
	Возврат _КлиентскиеВызовы.Модуль_ЯдроНаКлиенте();
	
КонецФункции

&НаСервере
Функция Модуль_ЯдроНаСервере() Экспорт
	
	Если _МодульЯдроНаСервере = Неопределено Тогда
		АдресОбработкиЯдра = СвойствоСтруктуры(ОбщийКонтекстКлиентСервер, "АдресОбработкиЯдра");
		
		Если ЗначениеЗаполнено(АдресОбработкиЯдра) Тогда
			_МодульЯдроНаСервере = ХранилищеОбработки_Прочитать(АдресОбработкиЯдра);
		КонецЕсли;
	КонецЕсли;
	
	Возврат _МодульЯдроНаСервере;
	
КонецФункции

&НаСервереБезКонтекста
Функция ХранилищеОбработки_Прочитать(АдресОбработки)
	
	СтруктураОбработки = ПолучитьИзВременногоХранилища(АдресОбработки);
	
	Результат = СвойствоСтруктуры(СтруктураОбработки, "ОбработкаОбъект");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоСтруктура(Значение)
	
	Результат = Ложь;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ИнициализацияФормы

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы, Модуль_Платформа) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	_Платформа = Модуль_Платформа;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбщийКонтекстКлиентСервер", ОбщийКонтекстКлиентСервер);
	Параметры.Свойство("Действие", Действие);
	Параметры.Свойство("ДокументЭТрН_Титул1", ДокументЭТрН_Титул1);
	Параметры.Свойство("kl_id", Значение_kl_id);
	
	BoxId = ДокументЭТрН_Титул1.Идентификаторы.BoxId;
	
	Ядро = Модуль_ЯдроНаСервере();
	
	ДокументЭТрН_Титул2 = Ядро.ПеревозочныеДокументы_Документ_ЭТрН_Титул2(BoxId, Значение_kl_id);
	
	УстановитьОграниченияТиповНаСервере();
	ВладелецПунктаВыгрузки = ДокументЭТрН_Титул1.Получатель.Организация;
	
	НастроитьЭлементыПриСозданииФормыНаСервере(Отказ);
	
	Метрики_ПриСозданииФормы();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыПриСозданииФормыНаСервере(Отказ)
	
	Ядро = Модуль_ЯдроНаСервере();
	
	ДействияЭДО = Ядро.Перечисление_ДействияЭДО();
	
	Если Действие = ДействияЭДО.ПодписатьВходящий Тогда
		
		ОтказВПриемке = Ложь;
		
	ИначеЕсли Действие = ДействияЭДО.ОтказатьВПодписи Тогда
		
		ОтказВПриемке = Истина;
		
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
	Элементы.ПредставлениеДокумента.Заголовок = ДокументЭТрН_Титул2.ИмяФайла;
	
	ЗаполнитьАдресВыгрузкиИзТитулаОснованияНаСервере();
	ЗаполнитьМетодыОпределенияМассыНаСервере();
	ЗаполнитьГрузыДляПеревозки();
	
	ОбщиеСведенияСостоянияГруза = "Без замечаний";
	
	ОбработатьОшибкиВалидацииДанныхНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьЭлементыПоРеквизитуОтказВПриемке();
	НастроитьЭлементыПоРеквизитуПринятьГрузПоПозициям();
	
КонецПроцедуры

#КонецОбласти

#Область ОсновныеДействияФормы

&НаКлиенте
Процедура НастроитьПараметрыПодписания(Команда)
	
	BoxId = ДокументЭТрН_Титул2.Идентификаторы.BoxId;
	
	Если ЗначениеЗаполнено(BoxId) Тогда
		
		Модуль_Платформа = Модуль_Платформа();
		ПараметрыОткрытия = Модуль_Платформа.ПараметрыФормыРедактированияПолномочий();
		
		ПараметрыОткрытия.АдресЯщика = BoxId;
		ПараметрыОткрытия.ТипКонтента = ТипКонтента_ЭТрН();
		ПараметрыОткрытия.ПокупательПродавец = "Продавец";
		ПараметрыОткрытия.ВидТитула = ВидТитула_ЭТрН();
		
		Модуль_Платформа.ОткрытьФормуДиадокМодальноЛок(
			"РедактированиеПолномочийУправляемая",
			ЭтаФорма,
			ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьXML(Команда)
	
	ТесктXML = ПодготовитьXMLНаСервере();
	
	Если ТесктXML <> Неопределено Тогда
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТесктXML);
		ТекстовыйДокумент.Показать("Транспортная накладная (Титул Грузополучателя)");
		
		ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПоказатьЭТРН;
		Метрики_ПриВыполненииДействия(ДействиеМетрики);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьXMLНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ОбработатьОшибкиВалидацииДанныхНаСервере();
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		Результат = Неопределено;
	Иначе
		ПараметрыФормирования = ПараметрыФормированияТитулаНаСервере();
		Файл = МодульОбъекта.ЭТрН_Титул_3_КонтентXDTO(ПараметрыФормирования);
		Результат = МодульОбъекта.ТекстКонтентаXML(Файл);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПараметрыФормированияТитулаНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	
	Результат = МодульОбъекта.Контракт_ДанныеЭТрН_Титул_3();
	
	Результат.ДокументЭТрН_Титул1 = ДокументЭТрН_Титул1;
	Результат.ДокументЭТрН_Титул2 = ДокументЭТрН_Титул2;
	
	Результат.ВладелецПунктаВыгрузки = ВладелецПунктаВыгрузки;
	Результат.АдресВыгрузки = ДанныеАдресаВыгрузки();
	Результат.ДатаПрибытияПлан = ДатаПрибытияПлан;
	Результат.ДатаПрибытияФакт = ДатаПрибытияФакт;
	Результат.ДатаУбытияФакт = ДатаУбытияФакт;
	Результат.КоличествоМест = КоличествоМест;
	Результат.МассаБрутто = МассаБрутто;
	Результат.МассаНетто = МассаНетто;
	Результат.МетодОпределенияМассы = МетодОпределенияМассы;
	Результат.ОбщиеСведенияСостоянияГруза = ОбщиеСведенияСостоянияГруза;
	Результат.Объем = Объем;
	Результат.ОтказВПриемке = ОтказВПриемке;
	Результат.ПринятьГрузПоПозициям = ПринятьГрузПоПозициям;
	Результат.ПринятьЧастично = ПринятьЧастично;
	Результат.ПричинаОтказа = ПричинаОтказа;
	
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.Грузы, Грузы);
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.Отметки, Отметки);
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.АктыОтметок, АктыОтметок);
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.СтороныСоставителиАктов, СтороныСоставителиАктов);
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.ШтрафыОтметок, ШтрафыОтметок);
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.ДопИнформацияОтметок, ДопИнформацияОтметок);
	ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Результат.ДопИнформация, ДопИнформация);
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуЗначенийПоИсточникуНаСервере(Приемник, Источник)
	
	Для Каждого СтрокаТЗ Из Источник Цикл
		
		ЗаполнитьЗначенияСвойств(Приемник.Добавить(), СтрокаТЗ);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИОтправитьИсходящий(Команда)
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет <> Неопределено Тогда
		
		Метрики_ПриОтправкеПакета();
		
		ОповещениеПослеОтправкиПакета = _Платформа.НовыйОписаниеОповещения("ПослеОтправкиПакета", ЭтаФорма);
		ПараметрыКоманды = _Платформа.ПараметрыКомандыДействияСПакетом(Пакет, ОповещениеПослеОтправкиПакета);
		
		_Платформа.ПодписатьИОтправитьИсходящийПакет(ПараметрыКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПослеОтправкиПакета(ПакетОтправлен, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ПакетОтправлен Тогда
		
		Состояние("ЭТрН-3 подписан и отправлен");
		ЭтаФорма.Закрыть(Истина);
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПодготовитьПакетНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ОбработатьОшибкиВалидацииДанныхНаСервере();
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		Результат = Неопределено;
	Иначе
		ПараметрыФормирования = ПараметрыФормированияТитулаНаСервере();
		Результат = МодульОбъекта.ЭТрН_Титул_3_ПакетДляОтправки(ПараметрыФормирования);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипКонтента_ЭТрН()
	
	Возврат "kl";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидТитула_ЭТрН()
	Возврат "LogisticsWaybill";
КонецФункции

&НаКлиенте
Процедура БаннерБольшеВозможностейТекстГиперссылкаНажатие(Элемент)
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().БольшеВозможностейЛогистики;
	Метрики_ПриВыполненииДействия(ДействиеМетрики);
	
	_КлиентскиеВызовы.ОткрытьСтраницуСИнформациейОМодулеЛогистики();
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаОсновныеДанные

&НаСервере
Процедура ЗаполнитьМетодыОпределенияМассыНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	
	МетодыОпределенияМассы = МодульОбъекта.ЭТрН_МетодыОпределенияМассы();
	
	Для Каждого ЭлементСписка Из МетодыОпределенияМассы Цикл
		Элементы.МетодОпределенияМассы.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАдресВыгрузкиИзТитулаОснованияНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	
	АдресДоставкиЭТрН_Титул1 = МодульОбъекта.ЭТрН_Титул_3_ПредставлениеАдресаДоставкиТитулаОснования(ДокументЭТрН_Титул1);
	
	Если ЗначениеЗаполнено(АдресДоставкиЭТрН_Титул1) Тогда
		
		СписокВыбораАдреса = СписокВыбораАдреса();
		
		Для Каждого ЭлементСписка Из СписокВыбораАдреса Цикл
			Элементы.АдресВыгрузки.СписокВыбора.Добавить(ЭлементСписка);
		КонецЦикла;
		
		АдресВыгрузки = АдресДоставкиЭТрН_Титул1;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяЗаявленноеТекущим(Команда)
	
	ДатаПрибытияПлан = ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяПрибытияТекущим(Команда)
	
	ДатаПрибытияФакт = ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяУбытияТекущим(Команда)
	
	ДатаУбытияФакт = ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказВПриемкеПриИзменении(Элемент)
	
	НастроитьЭлементыПоРеквизитуОтказВПриемке();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПереченьГрузов(Команда)
	
	ЗаполнитьГрузыДляПеревозки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьГрузПоПозициямПриИзменении(Элемент)
	
	НастроитьЭлементыПоРеквизитуПринятьГрузПоПозициям();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементыПоРеквизитуОтказВПриемке()
	
	Элементы.ПричинаОтказа.Видимость = ОтказВПриемке;
	Элементы.ПринятьЧастично.Видимость = НЕ ОтказВПриемке;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементыПоРеквизитуПринятьГрузПоПозициям()
	
	ЗаполнитьГрузыДляПеревозки();
	
	Если ПринятьГрузПоПозициям Тогда
		Элементы.СтраницаГрузы.Заголовок = "Грузы";
	Иначе
		Элементы.СтраницаГрузы.Заголовок = "Грузы (справочно)";
	КонецЕсли;
	
	Элементы.Грузы.ТолькоПросмотр = НЕ ПринятьГрузПоПозициям;
	Элементы.КоличествоМест.ТолькоПросмотр = ПринятьГрузПоПозициям;
	Элементы.МассаБрутто.ТолькоПросмотр = ПринятьГрузПоПозициям;
	Элементы.МассаНетто.ТолькоПросмотр = ПринятьГрузПоПозициям;
	Элементы.Объем.ТолькоПросмотр = ПринятьГрузПоПозициям;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить();
	
	СписокВыбораАдреса = СписокВыбораАдреса();
	
	Для Каждого ЭлементСписка Из СписокВыбораАдреса Цикл
		
		Элемент.СписокВыбора.Добавить(ЭлементСписка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокВыбораАдреса()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ДанныеАдресов = Новый Массив;
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(АдресДоставкиЭТрН_Титул1) Тогда
		
		Результат.Добавить(АдресДоставкиЭТрН_Титул1);
		
		ДанныеАдреса = МодульОбъекта.СтруктураАдреса();
		ДанныеАдреса.Адрес = АдресДоставкиЭТрН_Титул1;
		
		ДанныеАдреса.Вставить("ЭтоАдресИзЭТрН_Титул1", Истина);
		
		ДанныеАдресов.Добавить(ДанныеАдреса);
		
	КонецЕсли;
	
	КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(ВладелецПунктаВыгрузки);
	
	Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
		
		Адрес = СтрокаАдреса.Адрес;
		
		Если Результат.Найти(Адрес) = Неопределено Тогда
			
			Результат.Добавить(Адрес);
			
			ДанныеАдреса = МодульОбъекта.СтруктураАдреса();
			ЗаполнитьЗначенияСвойств(ДанныеАдреса, СтрокаАдреса);
			
			ДанныеАдреса.Вставить("ЭтоАдресИзЭТрН_Титул1", Ложь);
			
			ДанныеАдресов.Добавить(ДанныеАдреса);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	АдресВыгрузкиХранение = ПоместитьВоВременноеХранилище(ДанныеАдресов, УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеАдресаВыгрузки()
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(АдресВыгрузкиХранение) Тогда
		
		ДанныеАдресов = ПолучитьИзВременногоХранилища(АдресВыгрузкиХранение);
		
		Для Каждого ДанныеАдреса Из ДанныеАдресов Цикл
			
			Если ДанныеАдреса.Адрес = АдресВыгрузки Тогда
				
				Результат = ДанныеАдреса;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

