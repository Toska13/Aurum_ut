&НаСервере
Процедура ОбработатьОшибкиВалидацииДанныхНаСервере()
	
	Ошибки.Очистить();
	
	ПараметрыФормирования = ПараметрыФормированияТитулаНаСервере();
	
	МодульОбъекта = ОбработкаОбъект();
	
	ОшибкиВалидацииДанных = МодульОбъекта.ЭТрН_Титул_3_ОшибкиВалидацииДанных(ПараметрыФормирования);
	
	Для Каждого ОписаниеОшибки Из ОшибкиВалидацииДанных Цикл
		
		ИмяРеквизита = ОписаниеОшибки.ИмяРеквизита;
		ИмяТабЧасти = ОписаниеОшибки.ИмяТабЧасти;
		ТекстОшибки = ОписаниеОшибки.ТекстОшибки;
		НомерСтроки = ОписаниеОшибки.НомерСтроки;
		
		СтрокаОшибки = Ошибки.Добавить();
		
		СтрокаОшибки.ИмяРеквизита = ИмяРеквизита;
		СтрокаОшибки.ИмяТабЧасти = ИмяТабЧасти;
		СтрокаОшибки.Представление = ПредставлениеРеквизитовДляОшибок(ТекстОшибки, ИмяРеквизита, ИмяТабЧасти);
		
		Если ЗначениеЗаполнено(ИмяТабЧасти) Тогда
			
			Если ИмяТабЧасти = "Отметки" Тогда
				СтрокаОшибки.Представление = СтрокаОшибки.Представление + " - строка " + НомерСтроки;
			КонецЕсли;
			
			СтрокаОшибки.ИдентификаторСтроки = ЭтаФорма[ИмяТабЧасти][НомерСтроки - 1].ПолучитьИдентификатор();
			
		КонецЕсли;
		
		СтрокаОшибки.ИдентификаторОтметки = ОписаниеОшибки.ИдентификаторОтметки;
		СтрокаОшибки.ИдентификаторАкта = ОписаниеОшибки.ИдентификаторАкта;
		
		СтрокаОшибки.ИндексКартинки = Истина;
		
	КонецЦикла;
	
	Элементы.ГруппаОшибки.Видимость = ЗначениеЗаполнено(Ошибки);
	
КонецПроцедуры

Функция ПредставлениеРеквизитовДляОшибок(ТекстОшибки, Знач ИмяРеквизита, ИмяТабЧасти)
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	
	СлужебныеЗаголовкиРеквизитов = Новый Соответствие;
	
	СлужебныеЗаголовкиРеквизитов.Вставить("ДатаПрибытияПлан", "Заявленные дата и время прибытия под выгрузку");
	СлужебныеЗаголовкиРеквизитов.Вставить("ДатаПрибытияФакт", "Дата и время прибытия под выгрузку");
	СлужебныеЗаголовкиРеквизитов.Вставить("ДатаУбытияФакт", "Дата и время убытия");
	
	ПредставлениеРеквизита = СлужебныеЗаголовкиРеквизитов.Получить(ИмяРеквизита);
	
	Если НЕ ЗначениеЗаполнено(ПредставлениеРеквизита) Тогда
		
		Если ЗначениеЗаполнено(ИмяТабЧасти) Тогда
			ИмяРеквизита = ИмяТабЧасти + ИмяРеквизита;
		КонецЕсли;
		
		НайденныйЭлементФормы = Элементы.Найти(ИмяРеквизита);
		
		Если НайденныйЭлементФормы <> Неопределено Тогда
			ПредставлениеРеквизита = НайденныйЭлементФормы.Заголовок;
		Иначе
			ПредставлениеРеквизита = ИмяРеквизита;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = "Указать: " + ПредставлениеРеквизита;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КомандаПроверитьНаличиеОшибок(Команда)
	
	ОбработатьОшибкиВалидацииДанныхНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда
		
		СтрокаОшибки = Элементы.Ошибки.ТекущиеДанные;
		
		Если ЗначениеЗаполнено(СтрокаОшибки.ИмяТабЧасти) Тогда
			
			Если ЗначениеЗаполнено(СтрокаОшибки.ИдентификаторОтметки) Тогда
				УстановитьОтборПоИдентификаторуОтметки(СтрокаОшибки.ИдентификаторОтметки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаОшибки.ИдентификаторАкта) Тогда
				УстановитьОтборПоИдентификаторуАкта(СтрокаОшибки.ИдентификаторАкта)
			КонецЕсли;
			
			УстановитьТекущуСтрокуПоОтметке(СтрокаОшибки.ИдентификаторОтметки);
			УстановитьТекущуСтрокуПоАкту(СтрокаОшибки.ИдентификаторАкта);
			
			ЭтаФорма.ТекущийЭлемент = Элементы[СтрокаОшибки.ИмяТабЧасти];
			ЭтаФорма.ТекущийЭлемент.ТекущаяСтрока = СтрокаОшибки.ИдентификаторСтроки;
			
		Иначе
			
			НайденныйЭлементФормы = Элементы.Найти(СтрокаОшибки.ИмяРеквизита);
			
			Если НайденныйЭлементФормы <> Неопределено Тогда
				ЭтаФорма.ТекущийЭлемент = НайденныйЭлементФормы;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуСтрокуПоОтметке(ИдентификаторОтметки)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОтметки) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура("ИдентификаторСтроки", ИдентификаторОтметки);
	
	НайденныеСтроки = Отметки.НайтиСтроки(ОтборСтрок);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Элементы.Отметки.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуСтрокуПоАкту(ИдентификаторАкта)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторАкта) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура("ИдентификаторСтроки", ИдентификаторАкта);
	
	НайденныеСтроки = АктыОтметок.НайтиСтроки(ОтборСтрок);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		УстановитьТекущуСтрокуПоОтметке(НайденныеСтроки[0].ИдентификаторОтметки);
		Элементы.АктыОтметок.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Метрики

&НаСервере
Процедура Метрики_ПриСозданииФормы()
	
	BoxId = ДокументЭТрН_Титул1.Идентификаторы.BoxId;
	LetterId = ДокументЭТрН_Титул1.Идентификаторы.LetterId;
	DocumentId = ДокументЭТрН_Титул1.Идентификаторы.DocumentId;
	
	ДействиеМетрики = _ОбработкаОбъект.Метрика_НазваниеДействий().ОткрытиеФормыЭТРН;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("kl_id", Значение_kl_id);
	ДопПеременные.Вставить("EtrnTitle", 3);
	ДопПеременные.Вставить("Title1_LetterId", LetterId);
	ДопПеременные.Вставить("Title1_DocumentId", DocumentId);
	
	ПредставлениеМетрики = Метрики_НаименованиеФормы();
	
	_ОбработкаОбъект.Метрика_ДобавитьСтатистику_ДляОрганизации(BoxId, ДействиеМетрики, ДопПеременные, ПредставлениеМетрики);
	
КонецПроцедуры

&НаКлиенте
Процедура Метрики_ПриОтправкеПакета()
	
	LetterId = ДокументЭТрН_Титул1.Идентификаторы.LetterId;
	DocumentId = ДокументЭТрН_Титул1.Идентификаторы.DocumentId;
	
	Если ОтказВПриемке Тогда
		Значение_Result = "Отказ";
	ИначеЕсли ПринятьЧастично Тогда
		Значение_Result = "Частичная приемка";
	Иначе
		Значение_Result = "Полная приемка";
	КонецЕсли;
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПодписатьИОтправить;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("kl_id", Значение_kl_id);
	ДопПеременные.Вставить("EtrnTitle", 3);
	ДопПеременные.Вставить("Title1_LetterId", LetterId);
	ДопПеременные.Вставить("Title1_DocumentId", DocumentId);
	
	ДопПеременные.Вставить("Result", Значение_Result);
	
	Метрики_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);

КонецПроцедуры

&НаКлиенте
Процедура Метрики_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные = Неопределено)
	
	BoxId = ДокументЭТрН_Титул1.Идентификаторы.BoxId;
	
	ПредставлениеМетрики = Метрики_НаименованиеФормы();
	
	_КлиентскиеВызовы.Метрика_ДобавитьПоведение_НажатиеКнопки(ПредставлениеМетрики, ДействиеМетрики, ПредставлениеМетрики);
	_КлиентскиеВызовы.Метрика_ДобавитьСтатистику_ДляОрганизации(BoxId, ДействиеМетрики, ДопПеременные, ПредставлениеМетрики);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция Метрики_НаименованиеФормы()
	
	Возврат "Транспортная накладная (Титул 3)";
	
КонецФункции

