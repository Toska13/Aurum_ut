		УдалитьДанныеТЗ(СтороныСоставителиАктов, ОтборСтрокСоставителей);
		
	КонецЦикла;
	
	УдалитьДанныеТЗ(АктыОтметок, ОтборСтрок);
	УдалитьДанныеТЗ(ШтрафыОтметок, ОтборСтрок);
