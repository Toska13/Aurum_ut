&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	МодульОбъекта = ОбработкаОбъект();
	
	СценарийПоУмолчанию = МодульОбъекта.ВосстановитьНастройки("Сценарий").Настройки;
	ТекущийСценарий = МодульОбъекта.СценарийПростаяОтгрузка();
	Если Параметры.Свойство("ТекущийСценарий") 
		И Параметры.ТекущийСценарий <> Неопределено Тогда
		ТекущийСценарий = Параметры.ТекущийСценарий;
	КонецЕсли;
	
	ОтборРольЭкспедитора = ТекущийСценарий.РольЭкспедитора;
	Если ОтборРольЭкспедитора = Неопределено Тогда
		ОтборРольЭкспедитора = "НеПривлекается";
	КонецЕсли;
	
	ЗаполнитьСценарии();

КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	АктивироватьТекущийСценарий();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСценарии()
	
	Сценарии.Очистить();
	
	ДобавитьСтрокуСценария("ПростаяОтгрузка", "Мы", "НашСклад", "НеПривлекается");
	ДобавитьСтрокуСценария("ПростаяОтгрузкаЭкспедиция", "Мы", "НашСклад", "ОтвечаетЗаГруз");
	ДобавитьСтрокуСценария("ПростаяОтгрузкаЭкспедицияАгент", "Мы", "НашСклад", "ТолькоСопровождает");
	
	ДобавитьСтрокуСценария("ОтгрузкаСоСкладаПартнера", "Мы", "СкладПартнера", "НеПривлекается");
	ДобавитьСтрокуСценария("ОтгрузкаСоСкладаПартнераЭкспедиция", "Мы", "СкладПартнера", "ОтвечаетЗаГруз");
	ДобавитьСтрокуСценария("ОтгрузкаСоСкладаПартнераЭкспедицияАгент", "Мы", "СкладПартнера", "ТолькоСопровождает");
	
	ДобавитьСтрокуСценария("СамовывозПокупателем", "Покупатель", "НашСклад", "НеПривлекается");
	ДобавитьСтрокуСценария("СамовывозПокупателемЭкспедиция", "Покупатель", "НашСклад", "ОтвечаетЗаГруз");
	ДобавитьСтрокуСценария("СамовывозПокупателемЭкспедицияАгент", "Покупатель", "НашСклад", "ТолькоСопровождает");
	
	ДобавитьСтрокуСценария("СамовывозСоСкладаПартнера", "Покупатель", "СкладПартнера", "НеПривлекается");
	ДобавитьСтрокуСценария("СамовывозСоСкладаПартнераЭкспедиция", "Покупатель", "СкладПартнера", "ОтвечаетЗаГруз");
	ДобавитьСтрокуСценария("СамовывозСоСкладаПартнераЭкспедицияАгент", "Покупатель", "СкладПартнера", "ТолькоСопровождает");
	
	ДобавитьСтрокуСценария("Универсальный", Неопределено, Неопределено, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуСценария(Сценарий, КтоЗаказываетПеревозку, МестоФактическойПогрузки, РольЭкспедитора)
	
	Если ОтборРольЭкспедитора = РольЭкспедитора
		Или ОтборРольЭкспедитора = ""
		Или ОтборРольЭкспедитора = Неопределено 
		Или РольЭкспедитора = Неопределено Тогда
		
		НоваяСтрока = Сценарии.Добавить();
		
		МодульОбъекта = ОбработкаОбъект();
		
		НоваяСтрока.Сценарий = Сценарий;
		НоваяСтрока.КтоЗаказываетПеревозку = КтоЗаказываетПеревозку;
		НоваяСтрока.МестоФактическойПогрузки = МестоФактическойПогрузки;
		НоваяСтрока.РольЭкспедитора = РольЭкспедитора;
		
		ПредставлениеСценария = МодульОбъекта.ПредставлениеСценария(НоваяСтрока);
		НоваяСтрока.ПредставлениеСценария = ПредставлениеСценария.ПредставлениеСценария;
		НоваяСтрока.ПодсказкаСценария = ПредставлениеСценария.ПодсказкаСценария;
		НоваяСтрока.НомерКартинки = ПредставлениеСценария.НомерКартинки;
		
		Если СценарийПоУмолчанию <> Неопределено 
			И КтоЗаказываетПеревозку = СценарийПоУмолчанию.КтоЗаказываетПеревозку 
			И МестоФактическойПогрузки = СценарийПоУмолчанию.МестоФактическойПогрузки
			И РольЭкспедитора = СценарийПоУмолчанию.РольЭкспедитора Тогда
			НоваяСтрока.Основной = 0;
		Иначе
			НоваяСтрока.Основной = 1;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктивироватьТекущийСценарий()
		
	Поиск = Новый Структура("КтоЗаказываетПеревозку, МестоФактическойПогрузки, РольЭкспедитора",
		ТекущийСценарий.КтоЗаказываетПеревозку,
		ТекущийСценарий.МестоФактическойПогрузки,
		ТекущийСценарий.РольЭкспедитора);
		
	НашлиСтроки = Сценарии.НайтиСтроки(Поиск);  
	Если НашлиСтроки.Количество() > 0 Тогда
		Элементы.Сценарии.ТекущаяСтрока = НашлиСтроки[0].ПолучитьИдентификатор();	
	КонецЕсли;
	
	ОписаниеПоСценарию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеПоСценарию()
		
	Если Не ЗначениеЗаполнено(ТекущийСценарий.КтоЗаказываетПеревозку) Тогда
		Элементы.ГруппаОписаниеВыбранногоСценария.Видимость = Ложь;
		Элементы.ГруппаОписаниеУниверсальногоСценария.Видимость = Истина;
	Иначе
		Элементы.ГруппаОписаниеВыбранногоСценария.Видимость = Истина;
		Элементы.ГруппаОписаниеУниверсальногоСценария.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьФлажкиПоОписанию();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиПоОписанию()

	Элементы["ПометкаГрузоотправительМы"].Видимость = Ложь;
	Элементы["ПометкаГрузоотправительПокупатель"].Видимость = Ложь;
	Элементы["ПометкаГрузоотправительМыПусто"].Видимость = Истина;
	Элементы["ПометкаГрузоотправительПокупательПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущийСценарий.КтоЗаказываетПеревозку) Тогда
		Элементы["ПометкаГрузоотправитель" + ТекущийСценарий.КтоЗаказываетПеревозку].Видимость = Истина;
		Элементы["ПометкаГрузоотправитель" + ТекущийСценарий.КтоЗаказываетПеревозку + "Пусто"].Видимость = Ложь;
	КонецЕсли;
	
	Элементы["ПометкаМестоФактическойПогрузкиНашСклад"].Видимость = Ложь;
	Элементы["ПометкаМестоФактическойПогрузкиСкладПартнера"].Видимость = Ложь;
	Элементы["ПометкаМестоФактическойПогрузкиНашСкладПусто"].Видимость = Истина;
	Элементы["ПометкаМестоФактическойПогрузкиСкладПартнераПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущийСценарий.МестоФактическойПогрузки) Тогда
		Элементы["ПометкаМестоФактическойПогрузки" + ТекущийСценарий.МестоФактическойПогрузки].Видимость = Истина;	
		Элементы["ПометкаМестоФактическойПогрузки" + ТекущийСценарий.МестоФактическойПогрузки + "Пусто"].Видимость = Ложь;	
  	КонецЕсли;

	Элементы["ПометкаРольЭкспедитораНеПривлекается"].Видимость = Ложь;
	Элементы["ПометкаРольЭкспедитораОтвечаетЗаГруз"].Видимость = Ложь;
	Элементы["ПометкаРольЭкспедитораТолькоСопровождает"].Видимость = Ложь;
	Элементы["ПометкаРольЭкспедитораНеПривлекаетсяПусто"].Видимость = Истина;
	Элементы["ПометкаРольЭкспедитораОтвечаетЗаГрузПусто"].Видимость = Истина;
	Элементы["ПометкаРольЭкспедитораТолькоСопровождаетПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущийСценарий.РольЭкспедитора) Тогда
		Элементы["ПометкаРольЭкспедитора" + ТекущийСценарий.РольЭкспедитора].Видимость = Истина;	
 		Элементы["ПометкаРольЭкспедитора" + ТекущийСценарий.РольЭкспедитора + "Пусто"].Видимость = Ложь;	
 	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
		
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные; 
	Если ТекущиеДанные <> Неопределено Тогда 
		
		РезультатВыбора = Новый Структура;
		РезультатВыбора.Вставить("РольЭкспедитора", ТекущиеДанные.РольЭкспедитора);
		РезультатВыбора.Вставить("КтоЗаказываетПеревозку", ТекущиеДанные.КтоЗаказываетПеревозку);
		РезультатВыбора.Вставить("МестоФактическойПогрузки", ТекущиеДанные.МестоФактическойПогрузки);
		
		ОповеститьОВыборе(РезультатВыбора);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РольЭкспедитораПриИзменении(Элемент)
	
	//СценарииПриАктивизацииСтроки(Элемент);
    ЗаполнитьСценарии();
	Если ОтборРольЭкспедитора <> "" И ОтборРольЭкспедитора <> Неопределено Тогда 
		ТекущийСценарий.РольЭкспедитора = ОтборРольЭкспедитора;
		АктивироватьТекущийСценарий();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарииПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные; 
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущийСценарий = Новый Структура;
		ТекущийСценарий.Вставить("РольЭкспедитора", ТекущиеДанные.РольЭкспедитора);
		ТекущийСценарий.Вставить("КтоЗаказываетПеревозку", ТекущиеДанные.КтоЗаказываетПеревозку);
		ТекущийСценарий.Вставить("МестоФактическойПогрузки", ТекущиеДанные.МестоФактическойПогрузки);
		ПодключитьОбработчикОжидания("ОписаниеПоСценарию", 0.01, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("РольЭкспедитора", ТекущиеДанные.РольЭкспедитора);
	РезультатВыбора.Вставить("КтоЗаказываетПеревозку", ТекущиеДанные.КтоЗаказываетПеревозку);
	РезультатВыбора.Вставить("МестоФактическойПогрузки", ТекущиеДанные.МестоФактическойПогрузки);
	
	ОповеститьОВыборе(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПоУмолчаниюНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	СценарийПоУмолчанию = МодульОбъекта.ВосстановитьНастройки("Сценарий").Настройки;
	Если СценарийПоУмолчанию <> Неопределено 
		И СценарийПоУмолчанию.КтоЗаказываетПеревозку = ТекущийСценарий.КтоЗаказываетПеревозку
		И СценарийПоУмолчанию.МестоФактическойПогрузки = ТекущийСценарий.МестоФактическойПогрузки
		И СценарийПоУмолчанию.РольЭкспедитора = ТекущийСценарий.РольЭкспедитора Тогда
		УстановитьПризнакОсновнойВСценариях(СценарийПоУмолчанию, 1);
		МодульОбъекта.ЗаписатьНастройки(Неопределено, "Сценарий");
		СценарийПоУмолчанию = Неопределено;
	Иначе
		Если СценарийПоУмолчанию <> Неопределено Тогда
			УстановитьПризнакОсновнойВСценариях(СценарийПоУмолчанию, 1);
		КонецЕсли;
		МодульОбъекта.ЗаписатьНастройки(ТекущийСценарий, "Сценарий");	
		СценарийПоУмолчанию = ТекущийСценарий;
		УстановитьПризнакОсновнойВСценариях(СценарийПоУмолчанию, 0);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакОсновнойВСценариях(Сценарий, Основной)
	
	Поиск = Новый Структура("КтоЗаказываетПеревозку, МестоФактическойПогрузки, РольЭкспедитора",
	Сценарий.КтоЗаказываетПеревозку,
	Сценарий.МестоФактическойПогрузки,
	Сценарий.РольЭкспедитора);

	НашлиСтроки = Сценарии.НайтиСтроки(Поиск);
	Для Каждого НашлиСтроку Из НашлиСтроки Цикл
		НашлиСтроку.Основной = Основной;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоУмолчанию(Команда)

	УстановитьПоУмолчаниюНаСервере();
	
КонецПроцедуры
