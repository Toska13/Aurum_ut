&Наклиенте
Функция СписокОрганизацийДляСопоставления()
	
	ДобавитьНеоплаченные = Ложь;
	Ядро = Модуль_ЯдроНаКлиенте();
	Результат = Ядро.Организации_СписокОрганизацийДляВыбора(ДобавитьНеоплаченные);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СопоставлениеСОрганизациейДиадок(ОрганизацияДиадок, ДополнительныеПараметры) Экспорт
	
	Если ОрганизацияДиадок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ядро = Модуль_ЯдроНаКлиенте();
	
	ОрганизацияДиадокBoxId = ОрганизацияДиадок.Значение;
	ОрганизацияДиадок = Ядро.Организации_ЗаполненныеРеквизитыПоBoxId(ОрганизацияДиадокBoxId);
	
	СопоставляемыеОрганизации = Новый Массив;
	
	Если ЗначениеЗаполнено(ОрганизацияДиадок.СвязанныйСправочник1) Тогда
		
		СопоставленныеОрганизации = Ядро.Организации_СопоставленныеВ1СПоBoxId(ОрганизацияДиадокBoxId);
		
		Для Счетчик = 0 По СопоставленныеОрганизации.ВГраница() Цикл
			СопоставляемыеОрганизации.Добавить(СопоставленныеОрганизации[Счетчик]);
		КонецЦикла;
		
	КонецЕсли;
	
	Если СопоставляемыеОрганизации.Найти(ДополнительныеПараметры.СопоставляемыйУчастникЭДО) = Неопределено Тогда
		СопоставляемыеОрганизации.Добавить(ДополнительныеПараметры.СопоставляемыйУчастникЭДО);
	Иначе
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("СвязанныеСправочники", СопоставляемыеОрганизации);
	
	Ядро.Организации_ОбновлениеРеквизитов(ОрганизацияДиадок, СтруктураРеквизитов);
	
	_Платформа.ВыполнитьОбработкуОповещенияЛок(
		ДополнительныеПараметры.ОповещенияПослеСопоставления,
		КодВозвратаДиалога.Да
	);
	
КонецПроцедуры

