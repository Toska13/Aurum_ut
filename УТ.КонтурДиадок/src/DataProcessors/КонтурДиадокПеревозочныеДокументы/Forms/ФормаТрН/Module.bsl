&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗаголовок();
	
	Если Параметры.Свойство("ОбщийКонтекстКлиентСервер") Тогда
		ОбщийКонтекстКлиентСервер = Параметры.ОбщийКонтекстКлиентСервер;
	КонецЕсли;
	
	_ДокументыОснования = ОпределитьДокументыОснованияИОсновной(Параметры);

	Если Параметры.Свойство("СтрокаСписка")
		И Параметры.СтрокаСписка <> Неопределено Тогда
		СтрокаСписка = Параметры.СтрокаСписка;
	КонецЕсли;
	
	Если Параметры.Свойство("Сценарий")
		И Параметры.Сценарий <> Неопределено Тогда
		Сценарий = Параметры.Сценарий;
	Иначе
		Сценарий = Неопределено;
	КонецЕсли; 
	
	МодульОбъекта = ОбработкаОбъект();
	
	
	УстановитьСписокВыбораМетодОпределенияМассы();
	УстановитьСписокВыбораТипСопроводительногоДокумента();
	
	УстановитьОграниченияТипов();
	
	Если _ДокументыОснования.Количество() > 0 Тогда
		ЗаполнитьДокументыОснования(_ДокументыОснования);
		Если Параметры.Свойство("ДанныеПоОснованиюЗЗ") Тогда
			ЗаполнитьДанныеФормы(Параметры.ДанныеПоОснованиюЗЗ);
		Иначе
			ЗаполнитьДанныеФормы(Неопределено);
		КонецЕсли;
	КонецЕсли;
		
	ТекущийСценарий = ТекущийСценарий(Сценарий);

	// поддержка только 1 сценария: Простая отгрузка, экспедитор агент. Отгрузка со своего склада, мы подписываем документы
	// остальные включим после поддержки диадок.апи.
	// {для включения убрать код ниже
	ТекущийСценарий = МодульОбъекта.СценарийПростаяОтгрузкаЭкспедиторАгент();
	// }

	ОбработатьСценарий(ТекущийСценарий, Ложь);

	//заполняется в "ЗаполнитьДанныеФормы"
	//УстановитьСписокВыбораСведенияОДоставкеФактАдресДоставки();
	//УстановитьСписокВыбораСведенияОПогрузкеФактАдресПогрузки();

	УстановитьПараметрыВыбораДоговора(рл_СвЗак_РекИдентЗак, "рл_СвЗак_ДогУслПер"); 
 	УстановитьПараметрыВыбораДоговора(рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр, "рл_СвПогруз_СвЛицПогрГр_ОснПогрГр");
	
	УстановитьЗаголовокГруппыДатыИВремя();
	УстановитьУсловноеОформлениеНаСервере();
	
	ИдентификаторыГО = МодульОбъекта.ИдентификаторыЭДО(рл_СвГО_РекИдентГО, Истина);
	ИдГО = ИдентификаторыГО.ID;
	ИдентификаторыПВ = МодульОбъекта.ИдентификаторыЭДО(рл_СвПер, Ложь);
	ИдПер = ИдентификаторыПВ.ID;
	ИдентификаторыГП = МодульОбъекта.ИдентификаторыЭДО(рл_СвГП_РекИдентГП, Ложь);
	ИдГП = ИдентификаторыГП.ID; 
	
	РежимПереотправки = Ложь;

	ОпределитьЗапретРедактирования();
	ДоступностьФормы();
		
	ПроверитьЭлектроннуюТранспортнуюНакладную();
	ОбновитьАвтоОтметкуНезаполненногоОбязательныхПолей();
	НомерДатаЗаказЗаявки();
	
	ДопПеременные = Новый Соответствие;
	
	Если ЭтоНовыйДокументТрН() Тогда
		
		Модифицированность = Истина;
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().СозданиеЭТРН;
		
	Иначе
		
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().ОткрытиеФормыЭТРН;
		ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве());
		
	КонецЕсли;
	
	МодульОбъекта.Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, _ДокументыОснования);
	ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторТрН));
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	
	МодульОбъекта.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
	
	Ядро = Модуль_Ядро();
	Ядро.СписокОшибок_Очистить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграниченияТипов()

	МодульОбъекта = ОбработкаОбъект();
	
	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипОрганизации());
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвПер.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	Элементы.рл_СвГО_РекИдентГО.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	Элементы.рл_СвГП_РекИдентГП.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
 	Элементы.рл_СвПогруз_ВладИнфр_РекВладИнф.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);

	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвЗак_РекИдентЗак.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	Элементы.рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	Элементы.рл_СопрДокИдРекСост.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	Элементы.рл_ИдПолИной.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	
	МассивТиповДоговоры = Новый Массив;
	МассивТиповДоговоры.Добавить(МодульОбъекта.СправочникТипДоговорыКонтрагентов());
	Элементы.рл_СвЗак_ДогУслПер.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповДоговоры);
	Элементы.рл_СвПогруз_СвЛицПогрГр_ОснПогрГр.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповДоговоры);
	
	МассивТиповСотрудники = Новый Массив;
	МассивТиповСотрудники.Добавить(МодульОбъекта.СправочникТипФизическиеЛица());
	Элементы.рл_СвПогруз_СвЛицПогрГр_РабЛицПогрГр.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповСотрудники);  
	Элементы.рл_СвВодит1.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповСотрудники);  
	Элементы.рл_СвВодит2.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповСотрудники);  
	Элементы.рл_СвВодит3.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповСотрудники);  
	
	МассивТиповВалюта = Новый Массив;
	МассивТиповВалюта.Добавить(МодульОбъекта.СправочникТипВалюты());
	Элементы.рл_ОпГрузЦеннГруз_Валюта.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповВалюта);

	МассивТиповНоменклатура = Новый Массив;
	МассивТиповНоменклатура.Добавить(МодульОбъекта.СправочникТипНоменклатура());
	Элементы.рл_ОпГрузНоменклатура.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповНоменклатура);

КонецПроцедуры

&НаСервере
Процедура НомерДатаЗаказЗаявки()
	
	МодульОбъекта = ОбработкаОбъект();
	Если рл_НомЗак <> "Без номера" И ЗначениеЗаполнено(рл_ДатаЗак) Тогда
		Элементы.ГруппаНомерДатаЗаказа.Видимость = Истина;
		ПредставлениеЗаказЗаявки = МодульОбъекта.СтрШаблонЛок("по заказ-заявке №%1 от %2", рл_НомЗак, Формат(рл_ДатаЗак, "ДЛФ=D")); 
	Иначе
		Элементы.ГруппаНомерДатаЗаказа.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьКомандФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ЗавершениеРаботы = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(СтрокаСписка);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность
		И НЕ РежимПереотправки Тогда
		
		Отказ = Истина;
		Если ЗавершениеРаботы = Истина Тогда
			ТекстПредупреждения = "Настройки были изменены. Все изменения будут потеряны.";
			Возврат;
		КонецЕсли;
		
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВопросаОЗакрытии", ЭтаФорма);
		ПоказатьВопрос(Оповещение,"Настройки были изменены, ВЫЙТИ без сохранения?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//#Область ОбработчикиСобытийЭлементовФормы

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура рл_СвТС_ТСОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НельзяОткрыть(рл_СвТС_ТС, "рл_СвТС_ТС") Тогда
		Возврат;	
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначениеРеквизита", рл_СвТС_ТС);
	ПараметрыФормы.Вставить("ОбязательныеРеквизиты", ОбязательныеРеквизитыФормы("ФормаТранспортногоСредства"));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", "рл_СвТС_ТС");
	ДополнительныеПараметры.Вставить("ЗначениеРеквизита", рл_СвТС_ТС);

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаТранспортногоСредства", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаСервере
Процедура рл_РекизитПриИзмененииНаСервере(ЗначениеРеквизита, ИмяРеквизита)
	
	//перезаполняет подчиненные реквизиты.
	Модифицированность = Истина;
	
	МодульОбъекта = ОбработкаОбъект();
	
	ДанныеОбъекта = МодульОбъекта.ДанныеОбъекта(ЗначениеРеквизита, ИмяРеквизита);
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеОбъекта, ЭтаФорма, ИмяРеквизита + "_");
	
КонецПроцедуры

&НаКлиенте
Процедура рл_СвТС_ТСПриИзменении(Элемент)
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура пр_СвТС_ТСНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если ИмяСправочникаТранспортныеСредства() <> Неопределено Тогда
		
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВыбораТС", ЭтаФорма);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ФормаВыбора = ПолучитьФорму("Справочник." + ИмяСправочникаТранспортныеСредства() + ".ФормаВыбора", ПараметрыФормы, ЭтаФорма);
		ФормаВыбора.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора.ОписаниеОповещенияОЗакрытии = Оповещение;  
		ФормаВыбора.Открыть();	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИмяСправочникаТранспортныеСредства()                                     
	
	МодульОбъекта = ОбработкаОбъект();
	Возврат МодульОбъекта.ИмяСправочникаТранспортныеСредства();		
	
КонецФункции

&НаСервере
Функция ИмяСправочникаФизическиеЛица()                                     
	
	МодульОбъекта = ОбработкаОбъект();
	Возврат МодульОбъекта.ИмяСправочникаФизическиеЛица();		
	
КонецФункции

&НаСервере
Процедура Оповещение_ПослеВыбораТС(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		МодульОбъекта = ОбработкаОбъект();
		ДанныеТС = МодульОбъекта.ДанныеТС(РезультатЗакрытия, "ДопСв");
		ЭтаФорма["рл_СвТС_ТС"] = МодульОбъекта.СериализоватьXML(ДанныеТС);
		ЭтаФорма["пр_СвТС_ТС"] = МодульОбъекта.ЗначениеПредставление(ДанныеТС);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура пр_СвВодит1НачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

