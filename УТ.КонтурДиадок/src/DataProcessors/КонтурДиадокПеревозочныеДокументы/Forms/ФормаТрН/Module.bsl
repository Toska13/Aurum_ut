&НаКлиенте
Процедура ОшибкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.ГиперссылкаЯчейки Тогда
		
		ТекДанные = Элементы.Ошибки.ТекущиеДанные;
		Если СтрНайтиЛок(ЭтаФорма.ИмяФормы, ТекДанные.ИмяФормы) = 0 Тогда
			
			ОбязательныеРеквизиты = ОбязательныеРеквизитыФормы(ТекДанные.ИмяФормы);
			
			Попытка
				ЗначениеРодителя = ЭтаФорма[ТекДанные.ИмяРеквизитаРодителя];
			Исключение
				ЗначениеРодителя = Неопределено;
			КонецПопытки;
			
			Если ЗначениеРодителя <> Неопределено И ЗначениеЗаполнено(ЗначениеРодителя) Тогда
				
				НазваниеФормы = ТекДанные.ИмяФормы;
				НазваниеРеквизита = ТекДанные.НазваниеРеквизита;
				Если НазваниеФормы = "ФормаДоговора" Тогда      
					//пока так, далее реализуем форму в форме.
					НазваниеФормы = "ФормаТранспортногоСредства";
					НазваниеРеквизита = "пр_ОснАрЛиз";
				КонецЕсли;
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("СсылкаНаОбъект", ЗначениеРодителя); 
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРодителя);
				ПараметрыФормы.Вставить("ИмяТекущегоЭлемента", НазваниеРеквизита);
				ПараметрыФормы.Вставить("ОбязательныеРеквизиты", ОбязательныеРеквизиты);
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ИмяРеквизита", ТекДанные.ИмяРеквизитаРодителя);
				ДополнительныеПараметры.Вставить("ЗначениеРеквизита", ЗначениеРодителя);
				
				Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);
				
				_КлиентскиеВызовы.ОткрытьФормуПоИмени(НазваниеФормы, ПараметрыФормы, ЭтаФорма, Оповещение);

			КонецЕсли;
			
		Иначе
			
			НазваниеРеквизита = ТекДанные.НазваниеРеквизита;
			Если НазваниеРеквизита = "рл_СопрДокИдРекСост_ИНН" Тогда      
				НазваниеРеквизита = "рл_СопрДокИдРекСост";
			КонецЕсли;
			Попытка
				ЭтаФорма.ТекущийЭлемент = Элементы[НазваниеРеквизита];
			Исключение
			КонецПопытки;
				
			Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
				Элементы[ТекДанные.ИмяРеквизитаТЧ].ТекущаяСтрока = Число(ТекДанные.ИдентификаторСтроки);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекДанные.НазваниеРеквизита = "рл_СвГО_РекИдентГО"
			Или ТекДанные.НазваниеРеквизита = "рл_СвГП_РекИдентГП"
			Или ТекДанные.НазваниеРеквизита = "рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр"
			Или ТекДанные.НазваниеРеквизита = "рл_ИдПолИной"
			Или ТекДанные.НазваниеРеквизита = "рл_СвПер" Тогда
			Если СтрНайтиЛок(ТекДанные.Представление, "ЭДО - совпадают идентификаторы") > 0 Тогда
			Иначе
				ПредложитьСопоставитьКонтрагента(ТекДанные.НазваниеРеквизита);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьЧерновик();
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ЗаписатьЭТРН;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить(
		_КлиентскиеВызовы.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторТрН));
		
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве());
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЭлектроннуюТранспортнуюНакладную(Команда)
	
	Результат = ПодготовитьЭлектроннуюТранспортнуюНакладную(Ложь);
	
	Если Результат <> Неопределено Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(Результат);
		ТекстовыйДокумент.Показать("Транспортная накладная");
	КонецЕсли;
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПоказатьЭТРН;
	Метрика_ПриВыполненииДействия(ДействиеМетрики);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСвВодит(Команда)
	
	Если Не Элементы.ГруппаСвВодит2.Видимость Тогда
		Элементы.ГруппаСвВодит2.Видимость = Истина;	
	ИначеЕсли Не Элементы.ГруппаСвВодит3.Видимость Тогда
		Элементы.ГруппаСвВодит3.Видимость = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСвВодит(Команда)

	Если Элементы.ГруппаСвВодит3.Видимость Тогда
		Элементы.ГруппаСвВодит3.Видимость = Ложь;	
		рл_СвВодит3 = Неопределено;
		пр_СвВодит3 = Неопределено;
	ИначеЕсли Элементы.ГруппаСвВодит2.Видимость Тогда
		Элементы.ГруппаСвВодит2.Видимость = Ложь;	
		рл_СвВодит2 = Неопределено;
		пр_СвВодит2 = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяПрибытияТекущим(Команда)

	рл_СвПогруз_ФДатВрПриб = ТекущаяДата();

	ПродолжительностьПогрузки = 30;
	Если ТипЗнч(ПродолжительностьПогрузки) = Тип("Число") Тогда
		рл_СвПогруз_ФДатВрУбыт = рл_СвПогруз_ФДатВрПриб + ПродолжительностьПогрузки * 60;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуВремяУбытияТекущим(Команда)

	рл_СвПогруз_ФДатВрУбыт = ТекущаяДата();

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИОтправитьИсходящий(Команда)
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПодписатьИОтправить;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("Resend", РежимПереотправки);
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторТрН));
	ДополнитьДопПеременныеИдентификаторамиУчастников(ДопПеременные);
	
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
	Если РежимПереотправки Тогда
		ПодписатьИОтправитьПовторноИсходящийДокумент();
	Иначе
		ПодписатьИОтправитьИсходящийДокумент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьДопПеременныеИдентификаторамиУчастников(ДопПеременные)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникГО = _КлиентскиеВызовы.Контракт_СтруктураУчастника(рл_СвГО_РекИдентГО, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникГО);
	
	УчастникПер = _КлиентскиеВызовы.Контракт_СтруктураУчастника(рл_СвПер, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникПер);
	
	УчастникГП = _КлиентскиеВызовы.Контракт_СтруктураУчастника(рл_СвГП_РекИдентГП, Ложь);
	СтруктураУчастников.Вставить("УчастникГП", УчастникГП);
	
	ЗаполнитьИдентификаторыЭДОУчастниковНаСервере(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючBoxIDГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючBoxIDПРВ(), УчастникПер.Идентификатор);
	УчастникГП = СтруктураУчастников.УчастникГП;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючBoxIDГП(), УчастникГП.Идентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИдентификаторыЭДОУчастниковНаСервере(СтруктураУчастников)
	
	МодульОбъекта = ОбработкаОбъект();
	МодульОбъекта.ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборДокументовОснования(Команда)

	ПараметрыФормы = Новый Структура;
	мДокументыОснования = Новый Массив;
	Для Каждого СтрокаОснования Из ДокументыОснования Цикл
		мДокументыОснования.Добавить(СтрокаОснования.ДокументОснование);	
	КонецЦикла;
	ПараметрыФормы.Вставить("ДокументыОснования", мДокументыОснования);
	ПараметрыФормы.Вставить("Период", Новый СтандартныйПериод(рл_ДатаТрН, ТекущаяДата()));
	ПараметрыФормы.Вставить("РежимПодбораИзЭТрН", Истина);
	
	ДополнительныеПараметры = Новый Структура;

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеПодбораДокументовОснования", ЭтаФорма, ДополнительныеПараметры);
  	_КлиентскиеВызовы.ОткрытьФормуПодбораДокументов(ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеПодбораДокументовОснования(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено 
		И РезультатЗакрытия.ДокументыОснования.Количество() > 0 Тогда
		
		ПерезаполнитьШапку = Ложь;
		
		ДокументыОснования.Очистить();
		Если РезультатЗакрытия.ДокументыОснования.Найти(ОсновнойДокумент) = Неопределено Тогда
			ОсновнойДокумент = РезультатЗакрытия.ДокументыОснования[0];
			ПерезаполнитьШапку = Истина;
		КонецЕсли;
		
		Для Каждого ВыбранныйДокумент Из РезультатЗакрытия.ДокументыОснования Цикл	
			НоваяСтрока = ДокументыОснования.Добавить();
			НоваяСтрока.ДокументОснование = ВыбранныйДокумент;
			Если НоваяСтрока.ДокументОснование = ОсновнойДокумент Тогда
				НоваяСтрока.ГлавныйДокумент = Истина;	
			КонецЕсли;
		КонецЦикла;
		
		ПерезаполнитьОпГруз = Истина;
		ЗаполнитьДанныеФормы(Неопределено, ПерезаполнитьШапку, ПерезаполнитьОпГруз);
        ПроверитьЭлектроннуюТранспортнуюНакладную();
		Модифицированность = Истина;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДокументОсновным(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИдентификаторСтроки", Элементы.ДокументыОснования.ТекущаяСтрока);

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ОтветУстановитьДокументОсновным", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, "Установить документ основным?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ОтветУстановитьДокументОсновным(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> Неопределено Тогда
		Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
			Поиск = Новый Структура("ГлавныйДокумент", Истина);
			НашлиСтроки = ДокументыОснования.НайтиСтроки(Поиск);
			Для Каждого НашлиСтроку Из НашлиСтроки Цикл
				НашлиСтроку.ГлавныйДокумент = Ложь;
			КонецЦикла;
			ТекущиеДанные = ДокументыОснования.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
			ТекущиеДанные.ГлавныйДокумент = Истина;
			ОсновнойДокумент = ТекущиеДанные.ДокументОснование;
			ДокументыОснования.Сортировать("ГлавныйДокумент Убыв");
			Модифицированность = Истина;
		КонецЕсли;    
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	//Только если не отправлен!
	
	Если ТипЗнч(СтрокаСписка) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(СтрокаСписка.LetterId) Тогда
			ПоказатьПредупреждение(Неопределено, "Нельзя удалять отправленный документ");
		Иначе
			Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ОтветНаВопросУдаления", ЭтаФорма);
			ПоказатьВопрос(Оповещение, "Вы действительно хотите удалить данные по ЭТрН?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеПоУмолчанию(Команда)
	
	ИмяРеквизита = СтрЗаменить(Команда.Имя, "кф_", "рл_");
	Элемент = Элементы.Найти(ИмяРеквизита);
	Если Элемент <> Неопределено Тогда
		                                     
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИмяРеквизита", Сред(Элемент.Имя, 4)); //убрать рл_
		ПараметрыФормы.Вставить("КлючРеквизитов", "трнТитул1");
		Если Элемент.Заголовок = "" Тогда
			//получим заголовок из реквизитов
			ПредставлениеРеквизита = ЗаголовокИзРеквизитов(Элемент.Имя);
		Иначе
			ПредставлениеРеквизита = Элемент.Заголовок;
		КонецЕсли;
		ПараметрыФормы.Вставить("ПредставлениеРеквизита", ПредставлениеРеквизита);
		Если Элемент.Имя = "рл_СвПогруз_ФАдресПогр_Адрес" Тогда
			ПараметрыФормы.Вставить("ИмяРеквизитаДоп", Сред(Элемент.Имя, 4) + "РФ");
			ЗначениеРеквизита = Новый Структура;
			ЗначениеРеквизита.Вставить(Сред(Элемент.Имя, 4), ЭтаФорма[Элемент.Имя]);
			ЗначениеРеквизита.Вставить(Сред(Элемент.Имя, 4) + "РФ", ЭтаФорма[Элемент.Имя + "РФ"]);
			ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРеквизита);
			ПараметрыФормы.Вставить("ХранениеВозможныхЗначений", ХранениеАдресаПогрузки);
		ИначеЕсли ЭтоРеквизитXML(ИмяРеквизита) Тогда
			ЗначениеРеквизита = ДесериализоватьXML(ЭтаФорма[Элемент.Имя]);
			Если ЗначениеРеквизита.Свойство("Ссылка") И ЗначениеЗаполнено(ЗначениеРеквизита.Ссылка) Тогда
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРеквизита.Ссылка);
			Иначе
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ПустаяСсылкаПоРеквизиту(Элемент.Имя));
			КонецЕсли;
			
		Иначе
			ПараметрыФормы.Вставить("ЗначениеРеквизита", ЭтаФорма[Элемент.Имя]);
		КонецЕсли;
		ПараметрыФормы.Вставить("ОсновнойДокумент", ОсновнойДокумент);
		
		ДополнительныеПараметры = Новый Структура;
		
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_УстановитьЗначениеПоУмолчанию", ЭтаФорма, ДополнительныеПараметры);
		
		_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаЗначенийПоУмолчанию", ПараметрыФормы, ЭтаФорма, Оповещение);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗначенийПоУмолчанию(Команда)

	УправлениеНастройкиЗначенийПоУмолчанию();
	ПроверитьНастройкиЗначенийПоУмолчанию();

КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьЭлектроннуюТранспортнуюНакладную(Команда)
	
	ПредставлениеОшибокВМассивеДо = Метрики_ПредставлениеОшибокВМассиве();
	КоличествоОшибокДо = ФорматированиеЧислаСтрокой(ПредставлениеОшибокВМассивеДо.Количество());
	
	ПроверитьЭлектроннуюТранспортнуюНакладную();
	
	ПредставлениеОшибокВМассивеПосле = Метрики_ПредставлениеОшибокВМассиве();
	КоличествоОшибокПосле = ФорматированиеЧислаСтрокой(ПредставлениеОшибокВМассивеПосле.Количество());
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПроверитьНаНаличиеОшибок;
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючИдентификатораПеревозочногоДокумента(),
		Строка(ИдентификаторТрН));
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючКоличествоОшибокДо(), КоличествоОшибокДо);
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючКоличествоОшибокПосле(), КоличествоОшибокПосле);
	ДопПеременные.Вставить(_КлиентскиеВызовы.Метрика_КлючОшибкиПосле(), ПредставлениеОшибокВМассивеПосле);
		
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
КонецПроцедуры

&НаКлиенте
Функция ФорматированиеЧислаСтрокой(ВходящееЧисло)
	Возврат Формат(ВходящееЧисло, "ЧН=; ЧГ=");
КонецФункции

&НаКлиенте
Процедура СохранитьДокументНаДиск(Команда)
	
	ДокументОтправлен = ДокументОтправлен();
	Если ДокументОтправлен Тогда
		Пакет = ПодготовитьПакетНаСервере();
		ВОтправленномПакетеЕстьДокумент = Пакет.Документы.Количество() > 0;
	Иначе
		ВОтправленномПакетеЕстьДокумент = Ложь;
	КонецЕсли;
	
	ДокументПакета = Неопределено;
	
	Если ВОтправленномПакетеЕстьДокумент Тогда
		
		ДокументПакета = Пакет.Документы[0];
		
		ИмяФайла = ДокументПакета.Документооборот.ХранилищеКонтента.ИмяФайла;
		ДанныеДокумента = ДокументПакета.Документооборот.ХранилищеКонтента.Данные;
		
	Иначе
		
		ЭПДСтрокой = ПодготовитьЭлектроннуюТранспортнуюНакладную();
		
		ИдФайлСтрокой = СтрПолучитьСтроку(ЭПДСтрокой, 2);
		ИдФайлСтроками = СтрЗаменить(ИдФайлСтрокой, """", Символы.ПС);
		
		ИмяФайла = СтрПолучитьСтроку(ИдФайлСтроками, 2) + ".xml";
		ДанныеДокумента = ЭПДСтрокой;
		
	КонецЕсли;

	ПараметрыКоманды = _Платформа.ПараметрыКомандыСохранитьДокументНаДиск(ИмяФайла, ДанныеДокумента);
	ПараметрыКоманды.КатегорияМетрики = _КлиентскиеВызовы.Метрика_НазваниеКатегории().Перевозочные;
	ПараметрыКоманды.НазваниеФормыДляМетрики = Метрика_НаименованиеФормы();
	ПараметрыКоманды.ПредставлениеМетрики = Метрика_ПредставленияМетрик().ИсходящийПакет;
	ПараметрыКоманды.ДокументДляМетрики = ДокументПакета;
	
	_Платформа.СохранитьДокументНаДиск(ПараметрыКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПечатнуюФорму(Команда)
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПолучитьПечатнуюФорму;
	ПредставлениеМетрики = Метрика_ПредставленияМетрик().Исходящийпакет;
	
	_КлиентскиеВызовы.Метрика_ДобавитьПоведение_НажатиеКнопки(НаименованиеФормы, ДействиеМетрики, ПредставлениеМетрики);
	
	Документ = Пакет.Документы[0];
	
	ДокументОтправлен = ДокументОтправлен();
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("BoxID", Документ.Идентификаторы.BoxId);
	ДопПеременные.Вставить("DocumentType", Документ.Тип.ТипДокумента);
	
	Если ДокументОтправлен Тогда
		ДопПеременные.Вставить("LetterId", Документ.Идентификаторы.LetterId);
		ДопПеременные.Вставить("DocumentId", Документ.Идентификаторы.DocumentId);
		ДопПеременные.Вставить("Status", Документ.Статусы.Статус);
	Иначе
		ДопПеременные.Вставить("Status", Перечисление_ЛокальныеСтатусыДокумента().Подготовлен);
	КонецЕсли;
	
	КатегорияМетрики = _КлиентскиеВызовы.Метрика_НазваниеКатегории().Перевозочные;
	
	_Платформа.ПолучитьПечатнуюФормуСервераДиадок(Документ, ДопПеременные, КатегорияМетрики, ДействиеМетрики);
	
КонецПроцедуры

