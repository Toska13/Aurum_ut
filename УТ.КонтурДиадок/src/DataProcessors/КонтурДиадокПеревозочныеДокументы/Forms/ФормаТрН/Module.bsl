&НаСервере
Процедура УстановитьСписокВыбораСведенияОДоставкеФактАдресДоставки(ДанныеТрН = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей

	Грузополучатель = ЭтаФорма.рл_СвГП_РекИдентГП;
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Грузополучатель);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));	
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли; 
	
	Если ЭтаФорма.ОсновнойДокумент <> Неопределено Тогда
		
		МетаданныеДокумента = ЭтаФорма.ОсновнойДокумент.Метаданные();
		
		Склад = Неопределено;
		Если МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "СкладПолучатель") Тогда
			Склад = ЭтаФорма.ОсновнойДокумент.СкладПолучатель;
		ИначеЕсли МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "СтруктурнаяЕдиницаПолучатель") Тогда //оу, это УНФ
			Склад = ЭтаФорма.ОсновнойДокумент.СтруктурнаяЕдиницаПолучатель;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Склад) Тогда
			Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
			КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Склад);
			Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
				Адрес = СтрокаАдреса.Адрес;
				Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
					ЗначениеАдреса = СтрокаАдреса.АдресРФ;
					ПредставлениеАдреса = СтрокаАдреса.Адрес;
					Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));		
					АдресаПоПредставлению.Добавить(Адрес)
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "АдресДоставкиЗначение") 
			И МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "АдресДоставки") Тогда
			Адрес = ЭтаФорма.ОсновнойДокумент.АдресДоставки;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = ЭтаФорма.ОсновнойДокумент.АдресДоставкиЗначение;
				ПредставлениеАдреса = ЭтаФорма.ОсновнойДокумент.АдресДоставки;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));		
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
	СписокВыбораФактАдресДоставки = Элементы.рл_СвГП_АдресДостГр_Адрес.СписокВыбора;
	СписокВыбораФактАдресДоставки.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораФактАдресДоставки.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	Если МодульОбъекта.ЕстьИЗаполненоСвойствоСтруктуры(ДанныеТрН, "СвГП.АдресДостГр") Тогда
		Адрес = ДанныеТрН.СвГП.АдресДостГр.Адрес;
		АдресРФ = ДанныеТрН.СвГП.АдресДостГр.АдресРФ; 
		Если ЗначениеЗаполнено(Адрес) Тогда
			Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, АдресРФ, Адрес));
			НайденныйАдрес = СписокВыбораФактАдресДоставки.НайтиПоЗначению(Адрес);
			Если НайденныйАдрес = Неопределено Тогда
				СписокВыбораФактАдресДоставки.Добавить(Адрес, Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	ХранениеАдресаДоставки = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораСведенияОПогрузкеФактАдресПогрузки(ДанныеТрН = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();

	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей

	Грузоотправитель = ЭтаФорма.рл_СвГО_РекИдентГО;
	Если ЗначениеЗаполнено(Грузоотправитель) Тогда
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Грузоотправитель);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));		
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтаФорма.ОсновнойДокумент <> Неопределено Тогда
		
		МетаданныеДокумента = ЭтаФорма.ОсновнойДокумент.Метаданные().ПолноеИмя();
		
		Склад = Неопределено;
		Если МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "Склад") Тогда
			Склад = ЭтаФорма.ОсновнойДокумент.Склад;                                     
		ИначеЕсли МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "СкладОтправитель") Тогда
			Склад = ЭтаФорма.ОсновнойДокумент.СкладОтправитель;
		ИначеЕсли МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "СтруктурнаяЕдиница") Тогда //оу, это УНФ
			Склад = ЭтаФорма.ОсновнойДокумент.СтруктурнаяЕдиница;
		ИначеЕсли МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "СкладКомпании") Тогда //аааа
			Склад = ЭтаФорма.ОсновнойДокумент.СкладКомпании;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Склад) Тогда
			Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
			КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Склад);
			Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
				Адрес = СтрокаАдреса.Адрес;
				Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
					ЗначениеАдреса = СтрокаАдреса.АдресРФ;
					ПредставлениеАдреса = СтрокаАдреса.Адрес;
					Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));		
					АдресаПоПредставлению.Добавить(Адрес)
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;  
		
	КонецЕсли;
	
	СписокВыбораФактАдресПогрузки = Элементы.рл_СвПогруз_ФАдресПогр_Адрес.СписокВыбора;
	СписокВыбораФактАдресПогрузки.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораФактАдресПогрузки.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	Если МодульОбъекта.ЕстьИЗаполненоСвойствоСтруктуры(ДанныеТрН, "СвПогруз.ФАдресПогр") Тогда
		Адрес = ДанныеТрН.СвПогруз.ФАдресПогр.Адрес;
		АдресРФ = ДанныеТрН.СвПогруз.ФАдресПогр.АдресРФ;
		Если ЗначениеЗаполнено(Адрес) Тогда
			Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, АдресРФ, Адрес));
			НайденныйАдрес = СписокВыбораФактАдресПогрузки.НайтиПоЗначению(Адрес);
			Если НайденныйАдрес = Неопределено Тогда
				СписокВыбораФактАдресПогрузки.Добавить(Адрес, Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ХранениеАдресаПогрузки = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

