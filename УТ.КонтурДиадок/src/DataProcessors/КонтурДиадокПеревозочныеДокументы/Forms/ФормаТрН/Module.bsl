КонецПроцедуры

&НаСервере
Процедура Оповещение_ПослеВыбораСведенияОВодителе2(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		МодульОбъекта = ОбработкаОбъект();
		ДанныеВодителя = МодульОбъекта.ДанныеВодителя(РезультатЗакрытия, "ДопСв");
		ЭтаФорма["рл_СвВодит2"] = МодульОбъекта.СериализоватьXML(ДанныеВодителя);
		ЭтаФорма["пр_СвВодит2"] = МодульОбъекта.ЗначениеПредставление(ДанныеВодителя);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура пр_СвВодит3НачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если ИмяСправочникаФизическиеЛица() <> Неопределено Тогда
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВыбораСведенияОВодителе3", ЭтаФорма);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ФормаВыбора = ПолучитьФорму("Справочник." + ИмяСправочникаФизическиеЛица() + ".Формавыбора", ПараметрыФормы, ЭтаФорма);
		ФормаВыбора.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора.ОписаниеОповещенияОЗакрытии = Оповещение;  
		ФормаВыбора.Открыть();	
	КонецЕсли;
	
