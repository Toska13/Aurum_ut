		ФормаВыбора.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора.ОписаниеОповещенияОЗакрытии = Оповещение;  
		ФормаВыбора.Открыть();	
		
	КонецЕсли;

КонецПроцедуры

