&НаКлиенте
Процедура УправлениеНастройкиЗначенийПоУмолчанию()
	
	Для Каждого Элемент Из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") 
			И Лев(Элемент.Имя, 3) = "кф_" Тогда
			Элемент.Видимость = Не Элемент.Видимость;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНастройкиЗначенийПоУмолчанию()

	ОбработкаОбъект = ОбработкаОбъект();
	Для Каждого Элемент Из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") 
			И Лев(Элемент.Имя, 3) = "кф_" Тогда
			ИмяРеквизита = Сред(Элемент.Имя, 4);
			Результат = Новый Структура;
			Результат.Вставить("ЗначениеРеквизита", Неопределено);
			Результат.Вставить("ИмяРеквизита", ИмяРеквизита);
			
			МетаданныеДокумента = ОсновнойДокумент.Метаданные().ПолноеИмя();
			ИдентификаторНастройки = МетаданныеДокумента + "_" + ОбработкаОбъект.КлючРеквизитовТрН() + "_" + ИмяРеквизита;
			
			Настройки = ОбработкаОбъект.ВосстановитьНастройки(ИдентификаторНастройки).Настройки;
			Если ЗначениеЗаполнено(Настройки)
				И Настройки.Количество() > 0 Тогда
				Элемент.ЦветФона = WebЦвета.Золотой;
			Иначе
				Элемент.ЦветФона = Новый Цвет();
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

