	Если НачалоДня(рл_СвПогруз_ФДатВрПриб) = '00010101000000' Тогда
		рл_СвПогруз_ФДатВрПриб = НачалоДня(ТекущаяДата()) + Час(рл_СвПогруз_ФДатВрПриб)*60*60 + Минута(рл_СвПогруз_ФДатВрПриб)*60;		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвПогруз_ФДатВрУбытВрПриИзменении(Элемент)

	Если НачалоДня(рл_СвПогруз_ФДатВрУбыт) = '00010101000000' Тогда
		рл_СвПогруз_ФДатВрУбыт = НачалоДня(ТекущаяДата()) + Час(рл_СвПогруз_ФДатВрУбыт)*60*60 + Минута(рл_СвПогруз_ФДатВрУбыт)*60;		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Метрика_ПриВыполненииДействия(ДействиеМетрики, Доппеременные = Неопределено)
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	
	ДокументОтправлен = ДокументОтправлен();
	Если РежимПереотправки Тогда
		ДокументОтправлен = Ложь;
	КонецЕсли;
	
	Если ДокументОтправлен Тогда
		ПредставлениеМетрики = Метрика_ПредставленияМетрик().Исходящийпакет;
	Иначе
		ПредставлениеМетрики = Метрика_ПредставленияМетрик().ПакетНаОтправку;
	КонецЕсли;
	
	_КлиентскиеВызовы.Метрика_ДобавитьПоведение_НажатиеКнопки(НаименованиеФормы, ДействиеМетрики, ПредставлениеМетрики);
	_КлиентскиеВызовы.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные);
	
КонецПроцедуры

