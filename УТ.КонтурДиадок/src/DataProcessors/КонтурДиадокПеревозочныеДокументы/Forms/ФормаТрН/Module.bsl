&НаКлиенте
Процедура рл_ОпГрузВидТарПредставлениеОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если СписокВыбораВидТары = Неопределено Тогда
		СписокВыбораВидТары = СписокВыбораВидТары(); 
	КонецЕсли;

	ТекущиеДанные = Элементы.рл_ОпГруз.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ТекущиеДанные.ВидТар = "00";
		ТекущиеДанные.ВидТарПредставление = "не указан";
	Иначе
		СтрокаПоиска = СтрокаПоискаФильтра(Текст, Элемент.ТекстРедактирования);
		Если СтрокаПоиска = Неопределено Тогда
			ТекущиеДанные.ВидТар = "00";
			ТекущиеДанные.ВидТарПредставление = "не указан";
		Иначе
			ДанныеВыбора = СписокЗначенийНайти(СтрокаПоиска, СписокВыбораВидТары);
			Если ДанныеВыбора.Количество() > 0 Тогда
				ТекущиеДанные.ВидТарПредставление = ?(ДанныеВыбора[0].Представление = "", ДанныеВыбора[0].Значение, ДанныеВыбора[0].Представление);
				ТекущиеДанные.ВидТар = ДанныеВыбора[0].Значение;
			Иначе
				ТекущиеДанные.ВидТар = "00";
				ТекущиеДанные.ВидТарПредставление = "не указан";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;  
	
КонецПроцедуры

