&НаСервере
Процедура СохранитьНаСервере()
	
	Модифицированность = Ложь;
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЗначенияРеквизитовТрН = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаТрН");
	_ДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	ПараметрыТрН = МодульОбъекта.ПараметрыТрН(ОсновнойДокумент, _ДокументыОснования, ЗначенияРеквизитовТрН, ТекущийСценарий);
 	МодульОбъекта.СохранитьЗначенияЭПД(МодульОбъекта.КлючИдентификатораТрН(), ИдентификаторТрН, МодульОбъекта.КлючРеквизитовТрН(), ЗначенияРеквизитовТрН, ПараметрыТрН);

КонецПроцедуры

&НаСервере
Процедура СохранитьСтатусНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();

	// ошибки заполняются в процессе сохранения, статус необходимо записать после сохранения и проверок.
	ЕстьОшибки = ?(Ошибки.Количество() = 0, Ложь, Истина);
	Статус = МодульОбъекта.ОпределитьСтатусТрН(ЕстьОшибки);
	МодульОбъекта.СохранитьСтатусТрН(ИдентификаторТрН, Статус);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыОснования(_ДокументыОснования)
	
	МодульОбъекта = ОбработкаОбъект();
	
	мДокументыОснования = Новый Массив;
	
	Для Каждого ДокументОснование Из _ДокументыОснования Цикл
		
		ИдентификаторТрН = МодульОбъекта.ИдентификаторТрН(ДокументОснование, Истина);
		Если ИдентификаторТрН = Неопределено Тогда
			ОснованияПоИдентификаторуТрН = Новый Массив;
		Иначе
			ОснованияПоИдентификаторуТрН = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораТрН(), ИдентификаторТрН);
		КонецЕсли;
		
		Если ОснованияПоИдентификаторуТрН.Количество() = 0 Тогда
			ОснованияПоИдентификаторуТрН.Добавить(ДокументОснование);
		КонецЕсли;
		
		Для Каждого ОснованиеПоИдентификаторуТрН Из ОснованияПоИдентификаторуТрН Цикл
			Если мДокументыОснования.Найти(ОснованиеПоИдентификаторуТрН) = Неопределено Тогда
				мДокументыОснования.Добавить(ОснованиеПоИдентификаторуТрН);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументыОснования.Очистить();
	Для Каждого ДокументОснование Из мДокументыОснования Цикл
		НоваяСтрока = ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснование;
		Если ДокументОснование = ОсновнойДокумент Тогда
			НоваяСтрока.ГлавныйДокумент = Истина;	
		КонецЕсли;
	КонецЦикла; 
	ДокументыОснования.Сортировать("ГлавныйДокумент Убыв");
	
	Если ИдентификаторТрН = Неопределено И ДокументыОснования.Количество() > 0  Тогда
		ИдентификаторТрН = МодульОбъекта.ИдентификаторТрН(ДокументыОснования[0].ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы(ДанныеПоОснованиюЗЗ, ПерезаполнитьШапку = Ложь, ПерезаполнитьОпГруз = Ложь)
	
	МодульОбъекта = ОбработкаОбъект();	
	
	мДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	
	ДанныеТрН = МодульОбъекта.ДанныеТрН(ИдентификаторТрН, мДокументыОснования, ПерезаполнитьШапку, ПерезаполнитьОпГруз, ДанныеПоОснованиюЗЗ);

	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеТрН, ЭтаФорма); 

	УстановитьСписокВыбораСведенияОДоставкеФактАдресДоставки(ДанныеТрН);
	УстановитьСписокВыбораСведенияОПогрузкеФактАдресПогрузки(ДанныеТрН);
	
	ВидимостьВодителей();
	ВидимостьЭкспедиции();
	ВидимостьСовпГОП();
	ВидимостьСовпГОВ();

КонецПроцедуры

&НаСервере
Функция ЭтоНовыйДокументТрН()

	Если Не ЭтоСтруктура(СтрокаСписка) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Не ЗначениеЗаполнено(СвойствоСтруктуры(СтрокаСписка, "Ключ"));

КонецФункции

