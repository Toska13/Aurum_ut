&НаСервере
Функция ПустаяСсылкаПоРеквизиту(ИмяРеквизита)
	
	МодульОбъекта = ОбработкаОбъект();
	Результат = Неопределено;
	Если ИмяРеквизита = "рл_СвТС_ТС" Или ИмяРеквизита = "рл_СвТС_Прицеп" Тогда
		Если МодульОбъекта.ИмяСправочникаТранспортныеСредства() <> Неопределено Тогда
			Результат = Справочники[МодульОбъекта.ИмяСправочникаТранспортныеСредства()].ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли ИмяРеквизита = "рл_СвВодит1" Или ИмяРеквизита = "рл_СвВодит2" Или ИмяРеквизита = "рл_СвВодит3" Тогда
		Если МодульОбъекта.ИмяСправочникаФизическиеЛица() <> Неопределено Тогда
			Результат = Справочники[МодульОбъекта.ИмяСправочникаФизическиеЛица()].ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
			
	Возврат Результат;
			
КонецФункции

&НаСервере
Функция ЗаголовокИзРеквизитов(ПутьКДанным)
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	Для Каждого СтрокаРеквизит Из РеквизитыФормы Цикл
		Если СтрокаРеквизит.Имя = ПутьКДанным Тогда
			Возврат СтрокаРеквизит.Заголовок;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

