&НаКлиенте
Процедура рл_ОпГрузВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	Если Поле.Имя = "рл_ОпГрузКонтейнерыГиперссылка" Тогда
		
		ТекущиеДанные = Элементы.рл_ОпГруз.ТекущиеДанные;
		ТекущаяСтрока = Элементы.рл_ОпГруз.ТекущаяСтрока;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("КонтейнерыXML", ТекущиеДанные.КонтейнерыXML);
		ПараметрыФормы.Вставить("ЗапретРедактирования", ЗапретРедактирования);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИндентификаторСтроки", ТекущаяСтрока);
		
		Если ЗапретРедактирования Тогда
			Оповещение = Неопределено;
		Иначе
			Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеРедактированияКонтейнеров", ЭтаФорма, ДополнительныеПараметры);
		КонецЕсли;
		
		_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаРедактированияКонтейнеров", ПараметрыФормы, ЭтаФорма, Оповещение);

	ИначеЕсли Поле.Имя = "рл_ОпГрузОпасныеГрузыГиперссылка"  Тогда

		ТекущиеДанные = Элементы.рл_ОпГруз.ТекущиеДанные;
		ТекущаяСтрока = Элементы.рл_ОпГруз.ТекущаяСтрока;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОпасныеГрузыXML", ТекущиеДанные.ОпасныеГрузыXML);
		ПараметрыФормы.Вставить("ЗапретРедактирования", ЗапретРедактирования);
		ПараметрыФормы.Вставить("ИмяФормы", "ФормаТрН");
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИндентификаторСтроки", ТекущаяСтрока);
		
		Если ЗапретРедактирования Тогда
			Оповещение = Неопределено;
		Иначе
			Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеРедактированияОпасныхГрузов", ЭтаФорма, ДополнительныеПараметры);
		КонецЕсли;
		
		_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаРедактированияОпасныхГрузов", ПараметрыФормы, ЭтаФорма, Оповещение);
		
	КонецЕсли;
	
