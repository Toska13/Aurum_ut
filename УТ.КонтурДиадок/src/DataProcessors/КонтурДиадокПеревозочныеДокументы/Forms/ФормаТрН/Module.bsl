&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	
	Если ТекущаяСтраница = Элементы.СтраницаИсторияПоДокументу Тогда
		
		ЗаполнитьИсториюПоДокументу();
		
	КонецЕсли;
	
КонецПроцедуры

#Область ИсторияПоДокументу

&НаКлиенте
Процедура ЗаполнитьИсториюПоДокументу()
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Документ = Пакет.Документы[0];
	
	ИсторияДокументаHTML = "";
	
	Если ЗначениеЗаполнено(Документ.Идентификаторы.DocumentId) Тогда
		ЗаполнитьИсториюПоДокументуВызовСервера(Документ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсториюПоДокументуВызовСервера(Документ)
	
	Ядро = Модуль_Ядро();
	ВнешниеСтатусы = Документ.Статусы.ВнешниеСтатусы;
	ИдентификаторПеревозочного_kl_id = СвойствоСтруктуры(ВнешниеСтатусы, "kl_id");
	
	ИсторияДО = Ядро.Документы_ИсторияДО(Документ.Идентификаторы, ИдентификаторПеревозочного_kl_id);
	// BSLLS:UnusedLocalVariable-off
	ИсторияДокументаHTML = Ядро.HTMLИсторияДокументооборота(ИсторияДО);
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияДокументаHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	АдресСсылки = Неопределено;
	ДопПараметры = Неопределено;
	
	ДанныеСобытия.Свойство("href", АдресСсылки);
	
	Если ЗначениеЗаполнено(АдресСсылки) Тогда
		// BSLLS:UnusedLocalVariables-off
		СтандартнаяОбработка = Ложь;
		// BSLLS:UnusedLocalVariables-on
		_Платформа.ОповеститьИлиПерейтиПоСсылке(АдресСсылки, ДопПараметры, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуЭлектроннаяПодписьИДоверенности(
		АдресВременногоХранилища = Неопределено,
		ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(АдресВременногоХранилища) Тогда
		Возврат;
	КонецЕсли;
	
	Пакет = ПодготовитьПакетНаСервере();
	Документ = Пакет.Документы[0];
	ПредставлениеТекущегоДокумента = Документ.ИмяФайла;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Режим", "ФормаЭлектроннаяПодписьИДоверенности");
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	ПараметрыОткрытияФормы.Вставить("ПредставлениеТекущегоДокумента", ПредставлениеТекущегоДокумента);
	
	_Платформа.ОткрытьФормуДиадокМодальноЛок(
		"ФормаHTMLСообщенияУправляемая",
		ЭтаФорма,
		ПараметрыОткрытияФормы
	);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_СохранитьQRКод(АдресВременногоХранилища, ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(АдресВременногоХранилища) Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:MissingTempStorageDeletion-off
	ДанныеQR = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	// BSLLS:MissingTempStorageDeletion-on
	ИмяФайла = ДанныеQR.ИмяФайла;
	ДвоичныеДанные = ДанныеQR.Data;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Заголовок = "Укажите файл, в который нужно сохранить QR код";
	ДиалогВыбора.Фильтр = "GIF (*.gif)|*.gif";
	ДиалогВыбора.ПолноеИмяФайла = ИмяФайла;
	
	Если НЕ ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		
		Попытка
			
			Файл = Новый Файл(ДиалогВыбора.ПолноеИмяФайла);
			// BSLLS:UsingSynchronousCalls-off
			СоздатьКаталог(Файл.Путь);
			// BSLLS:UsingSynchronousCalls-on
			ДвоичныеДанные.Записать(ДиалогВыбора.ПолноеИмяФайла);
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;
		
	Иначе
		
		Сообщить(НСтр("ru = 'Не удалось получить файл QR кода'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКартинкаОшибкиИсторияПоДокументу()
	
	Пакет = ПодготовитьПакетНаСервере();
	
	Если Пакет.Документы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Документ = Пакет.Документы[0];
	
	СтатусМЧДКритичность = Документ.Статусы.СтатусМЧДКритичность;
	СтатусПКФНСКритичность = Документ.Статусы.СтатусПКФНСКритичность;
	
	Ядро = Модуль_Ядро();
	УровниКритичности = Ядро.Контракт_УровниКритичностиСтатусаДокумента();
	
	ЕстьОшибкаПроверкиМЧД = СтатусМЧДКритичность = УровниКритичности.Error
		Или СтатусМЧДКритичность = УровниКритичности.Warning;
	
	СтатусПКФНСКритичность = СтатусПКФНСКритичность = УровниКритичности.Error
		Или СтатусПКФНСКритичность = УровниКритичности.Warning;
		
	Если Не ЕстьОшибкаПроверкиМЧД И Не СтатусПКФНСКритичность Тогда
		Элементы.СтраницаИсторияПоДокументу.Картинка = Новый Картинка;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Сценарии 

&НаКлиенте
Процедура ВыборСценария(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВыбораСценария", ЭтаФорма, ДополнительныеПараметры);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийСценарий", ТекущийСценарий);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаВыбораСценария", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораСценария(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора <> Неопределено Тогда
		ТекущийСценарий = РезультатВыбора;
		ОбработатьСценарий(ТекущийСценарий, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОписаниеСценария(ТекущийСценарий)

	МодульОбъекта = ОбработкаОбъект();
	Результат = МодульОбъекта.ПредставлениеСценария(ТекущийСценарий);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбработатьСценарий(ТекущийСценарий, ЭтоВыборСценария)
	
	Элементы.КартинкаСценарий0.Видимость = Ложь;
	Элементы.КартинкаСценарий1.Видимость = Ложь;
	Элементы.КартинкаСценарий2.Видимость = Ложь;
	Элементы.КартинкаСценарий3.Видимость = Ложь;
	Элементы.КартинкаСценарий4.Видимость = Ложь;
	
	ОписаниеСценария = ОписаниеСценария(ТекущийСценарий);
	Элементы.ВыборСценария.Заголовок = ОписаниеСценария.ПредставлениеСценария + " (" + ОписаниеСценария.ПодсказкаСценария + ")";
	Элементы["КартинкаСценарий" + ОписаниеСценария.НомерКартинки].Видимость = Истина;
	НастройкаФормыПоСценарию(ТекущийСценарий, ЭтоВыборСценария);
	
КонецПроцедуры

&НаСервере
Процедура НастройкаФормыПоСценарию(ТекущийСценарий, ЭтоВыборСценария)
	
	//сброс или универс. сценарий
	Элементы.рл_СвГО_РекИдентГО.Подсказка = "";
	Элементы.рл_СвПогруз_ВладИнфр_РекВладИнф.Подсказка = ""; 
	Элементы.ГруппаЭкспедиция.Заголовок = "Перевозку осуществляет";
	
	ВидимостьВыбораСовпГОП(Истина);	
	ВидимостьВыбораСовпГОВ(Истина);
	
	ВидимостьГруппыЭкспедиция(Истина);	
	ВидимостьВыбораЭкспедиция(Истина);
 	ВидимостьГруппыЭкспедицияАгент(Ложь);

	ВидимостьГруппыСовпГОВ(Истина);	

	Если ТекущийСценарий <> Неопределено Тогда
		
		Если ТекущийСценарий.КтоЗаказываетПеревозку = "Мы"
			И ТекущийСценарий.МестоФактическойПогрузки = "НашСклад" Тогда
			
			рл_СвПогруз_СвЛицПогрГр_СовпГОП = 1;
			рл_СвПогруз_СвЛицПогрГр_ОснПогрГр = Неопределено;
			рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр = Неопределено;
			
			рл_СвПогруз_ВладИнфр_СовпГОВ = 1;
			рл_СвПогруз_ВладИнфр_РекВладИнф = Неопределено;
			
			ВидимостьВыбораСовпГОВ(Ложь);
			ВидимостьГруппыСовпГОВ(Ложь);			
			ВидимостьВыбораСовпГОП(Ложь);
			
		ИначеЕсли ТекущийСценарий.КтоЗаказываетПеревозку = "Мы"
			И ТекущийСценарий.МестоФактическойПогрузки = "СкладПартнера" Тогда
			
			рл_СвПогруз_ВладИнфр_СовпГОВ = 2;
			ВидимостьВыбораСовпГОВ(Ложь);
			ВидимостьГруппыСовпГОВ(Истина);
			
			рл_СвПогруз_СвЛицПогрГр_СовпГОП = 2;
			ВидимостьВыбораСовпГОП(Ложь);	
			
		ИначеЕсли ТекущийСценарий.КтоЗаказываетПеревозку = "Покупатель"
			И ТекущийСценарий.МестоФактическойПогрузки = "НашСклад" Тогда
			
			рл_СвПогруз_СвЛицПогрГр_СовпГОП = 1;
			рл_СвПогруз_СвЛицПогрГр_ОснПогрГр = Неопределено;
			рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр = Неопределено;
			ВидимостьВыбораСовпГОП(Ложь);	
			
			Если ЭтоВыборСценария Тогда
				рл_СвГО_РекИдентГО = рл_Контрагент;
			КонецЕсли;
			Элементы.рл_СвГО_РекИдентГО.Подсказка = "грузоотправителем является покупатель";
			
			ВидимостьВыбораСовпГОВ(Ложь);
			ВидимостьГруппыСовпГОВ(Истина);
			
			рл_СвПогруз_ВладИнфр_СовпГОВ = 2;
			Если ЭтоВыборСценария Тогда
				рл_СвПогруз_ВладИнфр_РекВладИнф = рл_Организация;
			КонецЕсли;
			Элементы.рл_СвПогруз_ВладИнфр_РекВладИнф.Подсказка = "собственное юридическое лицо";

		ИначеЕсли ТекущийСценарий.КтоЗаказываетПеревозку = "Покупатель"
			И ТекущийСценарий.МестоФактическойПогрузки = "СкладПартнера" Тогда
			
			Если ЭтоВыборСценария Тогда
				рл_СвГО_РекИдентГО = рл_Контрагент; 
				рл_СвПогруз_ВладИнфр_РекВладИнф = Неопределено;
			КонецЕсли;
			
			рл_СвПогруз_ВладИнфр_СовпГОВ = 2;
			ВидимостьВыбораСовпГОВ(Ложь);
			ВидимостьГруппыСовпГОВ(Истина);
			
			рл_СвПогруз_СвЛицПогрГр_СовпГОП = 2;
			ВидимостьВыбораСовпГОП(Ложь);	
			
			Элементы.рл_СвПогруз_ВладИнфр_РекВладИнф.Подсказка = "юридическое лицо пункта погрузки";
 			Элементы.рл_СвГО_РекИдентГО.Подсказка = "грузоотправителем является покупатель";

		КонецЕсли;
		
		Если ТекущийСценарий.РольЭкспедитора = "ОтвечаетЗаГруз" Тогда
			
			рл_СвГО_ГОЭксп = 1;
			ВидимостьГруппыЭкспедиция(Истина);	
			ВидимостьВыбораЭкспедиция(Ложь);
 			ВидимостьГруппыЭкспедицияАгент(Ложь);	
			Элементы.рл_СвГО_РекИдентГО.Подсказка = Элементы.рл_СвГО_РекИдентГО.Подсказка + 
				?(Элементы.рл_СвГО_РекИдентГО.Подсказка = "", "", ", ") +
				"грузоотправителем является экспедитор";
			Элементы.ГруппаЭкспедиция.Заголовок = "Заказчик перевозки";
			
		ИначеЕсли ТекущийСценарий.РольЭкспедитора = "ТолькоСопровождает" Тогда
			
			рл_СвГО_ГОЭксп = 0;
			ВидимостьГруппыЭкспедиция(Ложь);	
			ВидимостьВыбораЭкспедиция(Ложь);
 			ВидимостьГруппыЭкспедицияАгент(Истина);	
			
		ИначеЕсли ТекущийСценарий.РольЭкспедитора = "НеПривлекается" Тогда
			
			рл_СвГО_ГОЭксп = 0;
			рл_СвЗак_РекИдентЗак = Неопределено;
			рл_СвЗак_ДогУслПер = Неопределено;
			ВидимостьГруппыЭкспедиция(Ложь);	
			ВидимостьВыбораЭкспедиция(Ложь);
 			ВидимостьГруппыЭкспедицияАгент(Ложь);	
			
		КонецЕсли;
		
	КонецЕсли;

	ВидимостьСовпГОВ();
	ВидимостьЭкспедиции();
	ВидимостьСовпГОП();	
	
	ОбновитьАвтоОтметкуНезаполненногоОбязательныхПолей();
	
КонецПроцедуры

&НаСервере
Функция ТекущийСценарий(Сценарий)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Результат = ?(Сценарий = Неопределено, МодульОбъекта.СценарийПростаяОтгрузка(), Сценарий);
	Если ЭтоНовыйДокументТрН() Тогда 

	ИначеЕсли ЗначениеЗаполнено(ИдентификаторТрН) Тогда
		Результат = МодульОбъекта.ПолучитьЗначениеСведения(ИдентификаторТрН, "Сценарий", Истина);
		Если Результат <> Неопределено Тогда
			Результат = ДесериализоватьXML(Результат);
		КонецЕсли;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = МодульОбъекта.СценарийУниверсальный();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  	

