КонецФункции

&НаСервере
Процедура УстановитьПараметрыВыбораДоговора(Владелец, РеквизитДоговор)
	
	МодульОбъекта = ОбработкаОбъект();
	ИмяСправочника = МодульОбъекта.ИмяСправочникаДоговорыКонтрагентов();
	Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		// проверим наличие владельца
		Если Метаданные.Справочники[ИмяСправочника].Владельцы.Количество() > 0 Тогда
			ПараметрыВыбора = Новый Массив;
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Владелец));
			ЭтаФорма.Элементы[РеквизитДоговор].ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
		// проверим наличие контрагента
		ИначеЕсли Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("Контрагент") <> Неопределено Тогда
			ПараметрыВыбора = Новый Массив;
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Контрагент", Владелец));
			ЭтаФорма.Элементы[РеквизитДоговор].ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

