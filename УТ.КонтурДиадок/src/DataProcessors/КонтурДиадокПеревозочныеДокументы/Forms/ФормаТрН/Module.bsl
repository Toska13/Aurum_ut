Процедура ОбновитьАвтоОтметкуНезаполненногоОбязательныхПолей()
	
	МодульОбъекта = ОбработкаОбъект();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаТрН");
	СообщениеТрН = Новый Структура;
	МодульОбъекта.ЗаменитьСсылкиНаСтруктуры(СообщениеТрН, ЗначенияДополнительныхСвойств);
	
	ЗначениеАвтоОтметкаНезаполненногоОбязательныхПолей(Ложь);

	ПараметрыВалидации = МодульОбъекта.ВсеПараметрыВалидацииТрН();
	ОбязательныеРеквизитыПоФормам = МодульОбъекта.РеквизитыОбязательныхПолейПоФормам(СообщениеТрН, СообщениеТрН, ПараметрыВалидации);
	
	ЗначениеАвтоОтметкаНезаполненногоОбязательныхПолей(Истина);

КонецПроцедуры

&НаСервере
Процедура ЗначениеАвтоОтметкаНезаполненногоОбязательныхПолей(Значение)
	
	ОбязательныеРеквизиты = ОбязательныеРеквизитыФормы("ФормаТрН");
	
	Для Каждого ИмяРеквизита Из ОбязательныеРеквизиты Цикл
		Попытка
			Если ЭтоРеквизитXML(ИмяРеквизита) Тогда
				ИмяРеквизита = СтрЗаменить(ИмяРеквизита, "рл", "пр");
			КонецЕсли;
			Элементы[ИмяРеквизита].АвтоОтметкаНезаполненного = Значение;
			Если Не ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизита]) И Значение = Истина Тогда
				Элементы[ИмяРеквизита].ОтметкаНезаполненного = Истина;
			Иначе 
				Элементы[ИмяРеквизита].ОтметкаНезаполненного = Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НельзяОткрыть(ЗначениеРеквизита, ИмяРеквизита)
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита)
		И Не ЭтоРеквизитXML(ИмяРеквизита) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ОбязательныеРеквизитыФормы(ИмяФормы)
	
	Результат = Новый Массив;
		
	Если ТипЗнч(ОбязательныеРеквизитыПоФормам) = Тип("Структура")
		И ОбязательныеРеквизитыПоФормам.Свойство(ИмяФормы) Тогда
		Результат = ОбязательныеРеквизитыПоФормам[ИмяФормы];
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодготовитьПакетНаСервере()
	
	Ядро = Модуль_Ядро();
	Результат = Ядро.Пакеты_ПодготовитьПакет(СтрокаСписка, Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПослеОтправкиПакета(ПакетОтправлен, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ПакетОтправлен Тогда
		
		СтрокаСписка = Истина; // Обновить весь список
		Состояние("ТрН подписан и отправлен");
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УдалитьНаСервере()
	
	Если ЗначениеЗаполнено(ИдентификаторТрН) Тогда
		
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.Удалить(МодульОбъекта.КлючИдентификатораТрН(), ИдентификаторТрН);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИОтправитьИсходящийДокумент()
	
	МожноПодписатьОтправить = Ошибки.Количество() = 0;
	
	Если МожноПодписатьОтправить Тогда
		
		СохранитьЧерновик();
		
		Пакет = ПодготовитьПакетНаСервере();
		ОповещениеПослеОтправкиПакета = _Платформа.НовыйОписаниеОповещения("ПослеОтправкиПакета", ЭтаФорма);
		
		ПараметрыКоманды = _Платформа.ПараметрыКомандыДействияСПакетом(
			Пакет,
			ОповещениеПослеОтправкиПакета
		);
		
		_Платформа.ПодписатьИОтправитьИсходящийПакет(ПараметрыКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИОтправитьПовторноИсходящийДокумент()
	
	ПроверитьЭлектроннуюТранспортнуюНакладную();
	
	МожноПодписатьОтправить = Ошибки.Количество() = 0;
	
	Если МожноПодписатьОтправить Тогда
		
		СохранитьЧерновик();
		
		Пакет = ПодготовитьПереотправляемыйПакетНаСервере();
		ОповещениеПослеОтправкиПакета = _Платформа.НовыйОписаниеОповещения("ПослеОтправкиПакета", ЭтаФорма);
		
		ПараметрыКоманды = _Платформа.ПараметрыКомандыДействияСПакетом(
			Пакет,
			ОповещениеПослеОтправкиПакета
		);
		
		_Платформа.ПодписатьИОтправитьИсходящийПакет(ПараметрыКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПереотправляемыйПакетНаСервере()
	
	ПереотправляемыйПакет = Новый Структура;
	ПереотправляемыйПакет.Вставить("BoxId", СтрокаСписка.BoxId);
	ПереотправляемыйПакет.Вставить("LetterId", СтрокаСписка.LetterId);
	ПереотправляемыйПакет.Вставить("ПакетЭДО", СтрокаСписка.Пакет);
	
	ПодготовитьСтрокуСпискаПоДаннымЧерновика();
	
	СтрокаСписка.Пакет = Неопределено;
	СтрокаСписка.LetterId = "";
	
	Результат = ПодготовитьПакетНаСервере();
	
	ПараметрыПереотправки = Новый Структура;
	ПараметрыПереотправки.Вставить("ПереотправляемыйПакет", ПереотправляемыйПакет);
	ПараметрыПереотправки.Вставить("ВыполнитьУдалениеНеактуальныхДокументовПакета", Ложь);
	
	Результат.СлужебнаяИнформация.Вставить("ПараметрыПереотправки", ПараметрыПереотправки);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьBoxIdНаСервере()
	
	BoxId = "";
	
	МодульОбъекта = ОбработкаОбъект();
	ИдентификаторыГО = МодульОбъекта.ИдентификаторыЭДО(рл_СвГО_РекИдентГО, Истина);
	BoxId = ИдентификаторыГО.BoxId;
	
	Возврат BoxId;

КонецФункции

