&НаКлиенте
Процедура НачатьПроцессСогласования(РежимФормыСогласования)
	
	ПакетОтправлен = ДокументОтправлен();
	
	Пакет = ПодготовитьПакетНаСервере();
	
	ДанныеДляОбработки = Новый Массив;
	Если ПакетОтправлен Тогда
		Документ = Пакет.Документы[0];
		ДанныеДляОбработки.Добавить(Документ);
	Иначе
		ДанныеДляОбработки.Добавить(Пакет);
	КонецЕсли;
	
	КатегорияМетрики = Метрика_НазваниеКатегорииПоНаправлению();
	КоличествоДанных = ДанныеДляОбработки.Количество();
	ЯдроНаКлиенте = Модуль_ЯдроНаКлиенте();
	ДействиеМетрики = ЯдроНаКлиенте.Метрика_НазваниеДействияМаршрутизации(РежимФормыСогласования);
	Метрика_НажатиеКнопкиПакетнойОбработки(КатегорияМетрики, ДействиеМетрики, КоличествоДанных);
	
	ПараметрыОбработки = Новый_ПараметрыГрупповойОбработки(
		ДанныеДляОбработки,
		РежимФормыСогласования,
		КатегорияМетрики,
		ДействиеМетрики);
	
	ПараметрыОбработки.Вставить("BoxId", Пакет.Идентификаторы.BoxId);
	ПараметрыОбработки.Вставить("ДокументыОтправлены", ПакетОтправлен);
	ПараметрыОбработки.ИсточникОткрытия = Неопределено; //ИсточникОткрытия;
	
	Модуль_Платформа = Модуль_Платформа();
	Модуль_Платформа.ОбработатьДействиеПоМаршрутизации( , ПараметрыОбработки);
	
КонецПроцедуры

&НаКлиенте
Функция Новый_ПараметрыГрупповойОбработки(
	ДокументыДляОбработки,
	Действие,
	КатегорияМетрики,
	ДействиеМетрики,
	Знач ФормаВыполнения = Неопределено,
	ИдентификаторЯщика = Неопределено,
	КонтрагентПоддерживаетМЧД = Истина)
	
	Если ФормаВыполнения = Неопределено Тогда
		ФормаВыполнения = ЭтаФорма;
	КонецЕсли;
	
	ВыполнениеИзФормыПакета = Истина;
	РежимОтображенияДокументов = РежимыОтображения().Перевозочные;
	ИдентификаторОсновнойФормы = Неопределено;
	
	Модуль_Платформа = Модуль_Платформа();
	
	Результат = Модуль_Платформа.Новый_ПараметрыГрупповойОбработки(
		ДокументыДляОбработки,
		Действие,
		КатегорияМетрики,
		ДействиеМетрики,
		ФормаВыполнения,
		ИдентификаторЯщика,
		КонтрагентПоддерживаетМЧД,
		ВыполнениеИзФормыПакета,
		РежимОтображенияДокументов,
		ИдентификаторОсновнойФормы
	);
	
	Возврат Результат;
	
КонецФункции

