КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_СвГООткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если НельзяОткрыть(рл_СвГруз_СвГО, "рл_СвГруз_СвГО") Тогда
		Возврат;	
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СсылкаНаОбъект", рл_СвГруз_СвГО);
	ПараметрыФормы.Вставить("ОбязательныеРеквизиты", ОбязательныеРеквизитыФормы("ФормаУчастника"));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", "рл_СвГруз_СвГО");

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаУчастника", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

