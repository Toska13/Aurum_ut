	Если СписокВыбораВидУпак = Неопределено Тогда
		СписокВыбораВидУпак = СписокВыбораВидУпак(); 
	КонецЕсли;

	ТекущиеДанные = Элементы.рл_СвГруз_ОпГруз.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ТекущиеДанные.ИнфУпГруз_ВидУпак = "";
	Иначе
		СтрокаПоиска = СтрокаПоискаФильтра(Текст, Элемент.ТекстРедактирования);
		Если СтрокаПоиска = Неопределено Тогда
			ТекущиеДанные.ИнфУпГруз_ВидУпак = "";
		Иначе
			ДанныеВыбора = СписокЗначенийНайти(СтрокаПоиска, СписокВыбораВидУпак);
			Если ДанныеВыбора.Количество() > 0 Тогда
				ТекущиеДанные.ИнфУпГруз_ВидУпак = ДанныеВыбора[0].Значение;
