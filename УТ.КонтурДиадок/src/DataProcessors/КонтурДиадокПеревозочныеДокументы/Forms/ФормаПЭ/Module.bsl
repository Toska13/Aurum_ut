&НаСервере
Процедура ПодготовитьСтрокуСпискаПоДаннымЧерновика()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЕстьОшибки = Ошибки.Количество() > 0;
	СтатусПЭ = МодульОбъекта.ОпределитьСтатусПЭ(ЕстьОшибки);
	СтатусПодготовлен = Перечисление_ЛокальныеСтатусыДокумента().Подготовлен;
	
	//Если СтатусПЭ <> СтатусПодготовлен Тогда
	//	Возврат;
	//КонецЕсли;
	
	КлючИдентификатораПЭ = МодульОбъекта.КлючИдентификатораПЭ();
	
	ПараметрыПолученияЧерновиковЭПЭ = Новый Структура;
	ПараметрыПолученияЧерновиковЭПЭ.Вставить(КлючИдентификатораПЭ, ИдентификаторПЭ);
	ПараметрыПолученияЧерновиковЭПЭ.Вставить("НачалоПериода", НачалоДня(рл_ДатаДок));
	ПараметрыПолученияЧерновиковЭПЭ.Вставить("КонецПериода", КонецДня(рл_ДатаДок));
	
	ДанныеЧерновиковЭПЭ = МодульОбъекта.ДанныеДляОтправкиТитуловЭПЭ(ПараметрыПолученияЧерновиковЭПЭ);
	
	Если ДанныеЧерновиковЭПЭ[ОсновнойДокумент] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЧерновика = ДанныеЧерновиковЭПЭ[ОсновнойДокумент];
		
	ВидПакетаID = МодульОбъекта.ИдентификаторПакетаЭПЭ();
	ВидПакета = ОписаниеВидаПакета(ВидПакетаID);
	
	ЗаполнитьЗначенияСвойств(СтрокаСписка, ДанныеЧерновика);
	
	СтрокаСписка.Ключ = Строка(ДанныеЧерновика.ИдентификаторДокумента);
	СтрокаСписка.Направление = "Исходящее";
	СтрокаСписка.ВидПакета = ВидПакета.Наименование;
	СтрокаСписка.СодержимоеПакета = ВидПакета.Наименование;
	СтрокаСписка.Организация = ДанныеЧерновика.Грузоотправитель;
	СтрокаСписка.Контрагент = ДанныеЧерновика.Перевозчик;
	СтрокаСписка.ПромежуточныйПолучатель = ДанныеЧерновика.Грузополучатель;
	
	СлужебнаяИнформацияСтроки = СвойствоСтруктуры(СтрокаСписка, "СлужебнаяИнформация", Новый Структура);
	СлужебнаяИнформацияСтроки.Вставить(МодульОбъекта.КлючИдентификаторПеревозочногоДокумента(), Строка(ИдентификаторПЭ));
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьКомандФормы()
	
	СтатусПодготовлен = Перечисление_ЛокальныеСтатусыДокумента().Подготовлен;
	СтатусДокументаПодготовлен = Найти(СтатусДокумента, СтатусПодготовлен) > 0;
	ДокументБезОшибок = Ошибки.Количество() = 0;

	Если РежимПереотправки Тогда
		ЭтоНовыйДокумент = Истина;
		ДокументОтправлен = Ложь;
	Иначе
		ЭтоНовыйДокумент = ЭтоНовыйДокументПЭ();
		ДокументОтправлен = ДокументОтправлен();
	КонецЕсли;
	
	ДоступныеДействияПодписатьИОтправить = Ложь;
	ДоступныеДействияНастроитьПараметрыПодписания = Ложь;
	
	Если Не ЭтоНовыйДокумент И ДокументБезОшибок Тогда
		
		Пакет = ПодготовитьПакетНаСервере();
		Документ = Пакет.Документы[0];
		
		Ядро = Модуль_ЯдроНаКлиенте();
		ДоступныеДействия = Ядро.Документы_ДоступныеДействия(Документ);
		
		ДоступныеДействияПодписатьИОтправить = ДоступныеДействия.ПодписатьИОтправить;
		ДоступныеДействияНастроитьПараметрыПодписания = ДоступныеДействия.НастроитьПараметрыПодписания;
		
		Элементы.ПередатьНаСогласование.Видимость = ДоступныеДействия.ПередатьНаСогласование;
		Элементы.ПередатьНаПодпись.Видимость = ДоступныеДействия.ПередатьНаПодпись;
		Элементы.ПередатьПоМаршруту.Видимость = ДоступныеДействия.ПередатьПоМаршруту;
		Элементы.Согласовать.Видимость = ДоступныеДействия.Согласование;
		Элементы.ОтказатьВСогласовании.Видимость = ДоступныеДействия.ОтказВСогласовании;
		Элементы.КнопкаОтказатьВЗапросеПодписи.Видимость = ДоступныеДействия.ОтказВЗапросеПодписи;
		
		Элементы.ГруппаСогласованиеПередать.Видимость = ДоступныеДействия.ПередатьНаСогласование
			Или ДоступныеДействия.ПередатьНаПодпись
			Или ДоступныеДействия.ПередатьПоМаршруту;
		Элементы.ГруппаСогласованиеВердикт.Видимость = ДоступныеДействия.Согласование
			Или ДоступныеДействия.ОтказВСогласовании;
		Элементы.ГруппаСогласование.Видимость = Элементы.ГруппаСогласованиеПередать.Видимость
			Или Элементы.ГруппаСогласованиеВердикт.Видимость;
			
	Иначе
			
		Элементы.ПередатьНаСогласование.Видимость = Ложь;
		Элементы.ПередатьНаПодпись.Видимость = Ложь;
		Элементы.ПередатьПоМаршруту.Видимость = Ложь;
		Элементы.Согласовать.Видимость = Ложь;
		Элементы.ОтказатьВСогласовании.Видимость = Ложь;
		Элементы.КнопкаОтказатьВЗапросеПодписи.Видимость = Ложь;
		
		Элементы.ГруппаСогласованиеПередать.Видимость = Ложь;
		Элементы.ГруппаСогласованиеВердикт.Видимость = Ложь;
		Элементы.ГруппаСогласование.Видимость = Ложь;
		
	КонецЕсли;
	
	Элементы.ПодписатьИОтправитьИсходящий.Видимость = ДоступныеДействияПодписатьИОтправить Или РежимПереотправки;
	Элементы.НастроитьПараметрыПодписания.Видимость = ДоступныеДействияНастроитьПараметрыПодписания;
	Элементы.СохранитьДокументНаДиск.Видимость = ДокументОтправлен Или ДокументБезОшибок;
	Элементы.ПолучитьПечатнуюФорму.Видимость = ДокументОтправлен Или СтатусДокументаПодготовлен;
	Элементы.СохранитьДокументооборот.Видимость = ДокументОтправлен;
	Элементы.ПерейтиВДиадок.Видимость = ДокументОтправлен;
	Элементы.ПереотправитьИсходящий.Видимость = ДокументОтправлен;
	Элементы.ФормаСохранить.Видимость = Не ДокументОтправлен И Не РежимПереотправки;
	Элементы.Перезаполнить.Видимость = Не ДокументОтправлен;
	Элементы.ПоказатьСодержимоеДокументаXML.Видимость = Не ДокументОтправлен;
	
	Элементы.ПередатьВПодразделение.Видимость = ДокументОтправлен;
	
	Элементы.СтраницаИсторияПоДокументу.Видимость = ДокументОтправлен;
	Если ДокументОтправлен Тогда
		УстановитьВидимостьКартинкаОшибкиИсторияПоДокументу();
	КонецЕсли;
	
	УстановитьДоступностьФункцийТарифа();
	
КонецПроцедуры

