&НаСервере
Функция ОпределитьДокументыОснованияИОсновной(Параметры)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено Тогда
		ОсновнойДокумент = Документы["РеализацияТоваровУслуг"].ПустаяСсылка();
	ИначеЕсли Метаданные.Документы.Найти("РасходнаяНакладная") <> Неопределено Тогда	
		ОсновнойДокумент = Документы["РасходнаяНакладная"].ПустаяСсылка();
	КонецЕсли;
	
	_ДокументыОснования = Новый Массив;
	
	Если Параметры.Свойство("ДокументОснование") Тогда
		
		ОсновнойДокумент = Параметры.ДокументОснование;
		_ДокументыОснования.Добавить(ОсновнойДокумент);
		
	ИначеЕсли Параметры.Свойство("ДокументыОснования")
		И Параметры.ДокументыОснования.Количество() > 0 Тогда
		
		Если ТипЗнч(Параметры.ДокументыОснования[0]) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
			
			ИдентификаторПЭ = Параметры.ДокументыОснования[0];
			_ДокументыОснования = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораПЭ(), ИдентификаторПЭ);
			ОсновнойДокумент = _ДокументыОснования[0];       
			
		Иначе
			_ДокументыОснования = Параметры.ДокументыОснования;
			ОсновнойДокумент = _ДокументыОснования[0];       
		КонецЕсли;
		
	Иначе
		
		_ДокументыОснования.Добавить(ОсновнойДокумент);

	КонецЕсли;  
	
	Возврат _ДокументыОснования;
	
КонецФункции

