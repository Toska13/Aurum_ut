&НаСервере
Процедура УстановитьЗаголовокГруппыДатыИВремя()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЧасовойПоясСервера = ЧасовойПоясСеанса();
	ТекущаяДатаСервера = ТекущаяДатаСеанса();
	УниверсальнаяДата = УниверсальноеВремя(ТекущаяДатаСервера, ЧасовойПоясСервера);
	СмещениеОтUTC = СмещениеСтандартногоВремени(ЧасовойПоясСервера, УниверсальнаяДата);
	
	ЗнакСмещенияUTC = ?(СмещениеОтUTC >= 0, "+", "-");
	СмещениеОтUTCВЧасах = СмещениеОтUTC / 3600;
	СтрокаСмещениеUTC = ЗнакСмещенияUTC + Строка(СмещениеОтUTCВЧасах);
	
	СмещениеОтMSKВЧасах = СмещениеОтUTCВЧасах - 3;
	ЗнакСмещенияMSK = ?(СмещениеОтMSKВЧасах >= 0, "+", "-");
	СтрокаСмещениеMSK = ЗнакСмещенияMSK + Строка(СмещениеОтMSKВЧасах);
	
	Элементы.ГруппаДатыИВремя.Заголовок = МодульОбъекта.СтрШаблонЛок("%1 MSK%2 (UTC%3)", Элементы.ГруппаДатыИВремя.Заголовок, СтрокаСмещениеMSK, СтрокаСмещениеUTC);
	Элементы.ГруппаДатаОтгрузки.Заголовок = МодульОбъекта.СтрШаблонЛок("%1 MSK%2 (UTC%3)", Элементы.ГруппаДатаОтгрузки.Заголовок, СтрокаСмещениеMSK, СтрокаСмещениеUTC);
	Элементы.ГруппаДатаДоставки.Заголовок = МодульОбъекта.СтрШаблонЛок("%1 MSK%2 (UTC%3)", Элементы.ГруппаДатаДоставки.Заголовок, СтрокаСмещениеMSK, СтрокаСмещениеUTC);
	
КонецПроцедуры

