	СписокВыбора = Новый СписокЗначений;

	МодульОбъекта = ОбработкаОбъект();
	Макет = МодульОбъекта.ПолучитьМакет("ЗначенияВидТары");
		
	Для НомерСтроки = 3 По Макет.ВысотаТаблицы Цикл  //пропустить "не указан"
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		ПолноеНаименованиеЗначения = СокрЛП(Макет.Область(НомерСтроки, 2).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(ПолноеНаименованиеЗначения, ПолноеНаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
