#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗаголовок();
	
	Если Параметры.Свойство("ОбщийКонтекстКлиентСервер") Тогда
		ОбщийКонтекстКлиентСервер = Параметры.ОбщийКонтекстКлиентСервер;
	КонецЕсли;
	
	_ДокументыОснования = ОпределитьДокументыОснованияИОсновной(Параметры);

	Если Параметры.Свойство("СтрокаСписка")
		И Параметры.СтрокаСписка <> Неопределено Тогда
		СтрокаСписка = Параметры.СтрокаСписка;
	КонецЕсли;
		
	МодульОбъекта = ОбработкаОбъект();
		
	УстановитьОграниченияТипов();
	
	Если _ДокументыОснования.Количество() > 0 Тогда
		ЗаполнитьДокументыОснования(_ДокументыОснования);
		ЗаполнитьДанныеФормы();
	КонецЕсли;
		
	//заполняется в "ЗаполнитьДанныеФормы"
	//УстановитьСписокВыбораАдрПунктНазн();
	//УстановитьСписокВыбораАдрГруз();
 	УстановитьПараметрыВыбораДоговора(рл_СвЭксп, "рл_ДогТрЭксп");
	
	УстановитьЗаголовокГруппыДатыИВремя();
	УстановитьУсловноеОформлениеНаСервере();
	
	ИдентификаторыКЛНТ = МодульОбъекта.ИдентификаторыЭДО(рл_СвКлнт, Истина);
	ИдКЛНТ = ИдентификаторыКЛНТ.ID;
	ИдентификаторыЭКСП = МодульОбъекта.ИдентификаторыЭДО(рл_СвЭксп, Ложь);
	ИдЭКСП = ИдентификаторыЭКСП.ID;
	
	РежимПереотправки = Ложь;

	ОпределитьЗапретРедактирования();
	ДоступностьФормы();
		
	ПроверитьЭПЭ();
	ОбновитьАвтоОтметкуНезаполненногоОбязательныхПолей();
	
	ДопПеременные = Новый Соответствие;
	
	Если ЭтоНовыйДокументПЭ() Тогда
		
		Модифицированность = Истина;
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().СозданиеЭПЭ;
		
	Иначе
		
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().ОткрытиеФормыЭПЭ;
		ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве());
		
	КонецЕсли;
	
	МодульОбъекта.Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, _ДокументыОснования);
	ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторПЭ));
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	
	МодульОбъекта.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
	
	Ядро = Модуль_Ядро();
	Ядро.СписокОшибок_Очистить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграниченияТипов()

	МодульОбъекта = ОбработкаОбъект();

	МассивТиповОрганизация = Новый Массив;
	МассивТиповОрганизация.Добавить(МодульОбъекта.СправочникТипОрганизации());
	Элементы.рл_СвКлнт.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповОрганизация);
	
	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипОрганизации());
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвГруз_СвГО.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	Элементы.рл_СвГруз_СвГП.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);

	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвЭксп.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	
	МассивТиповДоговоры = Новый Массив;
	МассивТиповДоговоры.Добавить(МодульОбъекта.СправочникТипДоговорыКонтрагентов());
	Элементы.рл_ДогТрЭксп.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповДоговоры);

	МассивТиповСотрудники = Новый Массив;
	МассивТиповСотрудники.Добавить(МодульОбъекта.СправочникТипФизическиеЛица());
	
	МассивТиповВалюта = Новый Массив;
	МассивТиповВалюта.Добавить(МодульОбъекта.СправочникТипВалюты());
	Элементы.рл_СвГруз_ОпГрузОбъявлСтГруз_Валюта.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповВалюта);

	МассивТиповНоменклатура = Новый Массив;
	МассивТиповНоменклатура.Добавить(МодульОбъекта.СправочникТипНоменклатура());
	Элементы.рл_СвГруз_ОпГрузНоменклатура.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповНоменклатура);
	
	МассивТиповСтраны = Новый Массив;
	МассивТиповСтраны.Добавить(МодульОбъекта.СправочникТипСтраны());
	Элементы.рл_СвГруз_ОпГрузСвСтрПроисх.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповСтраны);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьКомандФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ЗавершениеРаботы = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(СтрокаСписка);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность
		И НЕ РежимПереотправки Тогда
		
		Отказ = Истина;
		Если ЗавершениеРаботы = Истина Тогда
			ТекстПредупреждения = "Настройки были изменены. Все изменения будут потеряны.";
			Возврат;
		КонецЕсли;
		
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВопросаОЗакрытии", ЭтаФорма);
		ПоказатьВопрос(Оповещение,"Настройки были изменены, ВЫЙТИ без сохранения?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВопросаОЗакрытии(РезультатВопроса,ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		ЭтаФорма.Закрыть();	
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

