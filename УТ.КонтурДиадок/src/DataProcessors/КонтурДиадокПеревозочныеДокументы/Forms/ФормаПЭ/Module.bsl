// Возвращает объект обработки из временного хранилища
//
// Параметры:
//  АдресОбработки - Строка - адрес обработки во временном хранилище
// 
// Возвращаемое значение:
//  ОбработкаОбъект - если обект обработки все еще загружен в память
//  Неопределено    - если объект обработки уже уничтожен
//
&НаСервереБезКонтекста
Функция ХранилищеОбработки_Прочитать(АдресОбработки)
	
	СтруктураОбработки = ПолучитьИзВременногоХранилища(АдресОбработки);
	
	Результат = СвойствоСтруктуры(СтруктураОбработки, "ОбработкаОбъект");
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение свойства структуры или значение по умолчанию,
// если в структуре нет такого свойства.
// 
// Параметры:
//  Структура           - Структура    - Структура, которая может содержать вложенные структуры.
//  Ключ                - Строка       - Имя ключа структуры,
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае если в структуре нет указанного свойства.
// 
// Возвращаемое значение:
//   Произвольный - Значение свойства структуры или ЗначениеПоУмолчанию,
//                  если в структуре нет такого свойства.
//
&НаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение структурой или фиксированной структурой.
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить.
// 
// Возвращаемое значение:
//   Булево - Истина, если переданое значение является структрой или фиксированной структурой.
//
&НаСервереБезКонтекста
Функция ЭтоСтруктура(Значение)
	
	Результат = Ложь;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область РаботаСКонтрагентами

&НаКлиенте
Процедура ОсновнойДокументПриИзменении(Элемент)
	
	_ДокументыОснования = Новый Массив;
	_ДокументыОснования.Добавить(ОсновнойДокумент);
	
	ЗаполнитьДокументыОснования(_ДокументыОснования);
	ЗаполнитьДанныеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьСопоставитьКонтрагента(ИмяРеквизита)
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().НеСопоставленУчастник;
	Представление = "Контрагент не сопоставлен";
	_КлиентскиеВызовы.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, , Представление);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
	
	ОписаниеЗакрытияФормы = _Платформа.НовыйОписаниеОповещения("ОбработатьРезультатПредложенияСопоставленияКонтрагента", ЭтаФорма, ДополнительныеПараметры);
	
	ТипУчастникаБезСопоставления = СокрЛП(ТипЗнч(ЭтаФорма[ИмяРеквизита]));
	
	_КлиентскиеВызовы.ОткрытьПредложениеСопоставления(ОписаниеЗакрытияФормы, ТипУчастникаБезСопоставления);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПредложенияСопоставленияКонтрагента(РезультатПредложения, ДополнительныеПараметры) Экспорт
	
	Если РезультатПредложения = КодВозвратаДиалога.Да Тогда
		
		НачатьСопоставление(ДополнительныеПараметры.ИмяРеквизита);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСопоставление(ИмяРеквизита)
	
	ОписаниеЗакрытияФормы = _Платформа.НовыйОписаниеОповещения("ОбработатьРезультатСопоставленияКонтрагента", ЭтаФорма);
	ОтборПоКонтрагенту = ЭтаФорма[ИмяРеквизита];
	
	НужноСопоставлениеСОрганизациейДиадок = НужноСопоставлениеСОрганизациейДиадок(ИмяРеквизита);
	Если НужноСопоставлениеСОрганизациейДиадок Тогда
		
		_КлиентскиеВызовы.НачатьСопоставлениеСОрганизациейДиадок(ОтборПоКонтрагенту, ОписаниеЗакрытияФормы);
		
	Иначе
		
		ОтборПоОрганизации = ЭтаФорма["рл_Организация"];
		
		Если ЗначениеЗаполнено(ОтборПоКонтрагенту) И ЗначениеЗаполнено(ОтборПоОрганизации) Тогда
			_КлиентскиеВызовы.ОткрытьСопоставление(ОтборПоОрганизации, ОтборПоКонтрагенту, ОписаниеЗакрытияФормы);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатСопоставленияКонтрагента(РезультатСопоставления, ДополнительныеПараметры) Экспорт
	
	Если РезультатСопоставления = КодВозвратаДиалога.Да Тогда
		ПроверитьЭПЭ();			
	Иначе
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьИдентификаторыЭДО(ЗначениеРеквизита, ЭтоОрганизация) 
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		МодульОбъекта = ОбработкаОбъект();
		
		ИдентификаторыЭДО = МодульОбъекта.ИдентификаторыЭДО(ЗначениеРеквизита, ЭтоОрганизация);
		ID = ИдентификаторыЭДО.ID;
		Если ЗначениеЗаполнено(ID) Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция НужноСопоставлениеСОрганизациейДиадок(ИмяСопоставляемогоРеквизита)
	
	ИмяРеквизита = "рл_СвКлнт";
	
	Возврат ИмяСопоставляемогоРеквизита = ИмяРеквизита;
	
КонецФункции

#КонецОбласти


#Область ДанныеФормыИСохранение

&НаКлиенте
Процедура СохранитьЧерновик()
	
	СохранитьНаСервере();
	ПодготовитьЭПЭ();
	СохранитьСтатусНаСервере();
	ПодготовитьСтрокуСпискаПоДаннымЧерновика();
	НастроитьВидимостьКомандФормы();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	
	Модифицированность = Ложь;
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЗначенияРеквизитовПЭ = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаПЭ");
	_ДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	ПараметрыПЭ = МодульОбъекта.ПараметрыПЭ(ОсновнойДокумент, _ДокументыОснования, ЗначенияРеквизитовПЭ);
 	МодульОбъекта.СохранитьЗначенияЭПД(МодульОбъекта.КлючИдентификатораПЭ(), ИдентификаторПЭ, МодульОбъекта.КлючРеквизитовПЭ(), ЗначенияРеквизитовПЭ, ПараметрыПЭ);

КонецПроцедуры

&НаСервере
Процедура СохранитьСтатусНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();

	// ошибки заполняются в процессе сохранения, статус необходимо записать после сохранения и проверок.
	ЕстьОшибки = ?(Ошибки.Количество() = 0, Ложь, Истина);
	Статус = МодульОбъекта.ОпределитьСтатусПЭ(ЕстьОшибки);
	МодульОбъекта.СохранитьСтатусПЭ(ИдентификаторПЭ, Статус);

КонецПроцедуры

&НаСервере
Процедура УдалитьНаСервере()
	
	Если ЗначениеЗаполнено(ИдентификаторПЭ) Тогда
		
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.Удалить(МодульОбъекта.КлючИдентификатораПЭ(), ИдентификаторПЭ);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыОснования(_ДокументыОснования)
	
	МодульОбъекта = ОбработкаОбъект();
	
	мДокументыОснования = Новый Массив;
	
	Для Каждого ДокументОснование Из _ДокументыОснования Цикл
		
		ИдентификаторПЭ = МодульОбъекта.ИдентификаторПЭ(ДокументОснование, Истина);
		Если ИдентификаторПЭ = Неопределено Тогда
			ОснованияПоИдентификаторуПЭ = Новый Массив;
		Иначе
			ОснованияПоИдентификаторуПЭ = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораПЭ(), ИдентификаторПЭ);
		КонецЕсли;
		
		Если ОснованияПоИдентификаторуПЭ.Количество() = 0 Тогда
			ОснованияПоИдентификаторуПЭ.Добавить(ДокументОснование);
		КонецЕсли;
		
		Для Каждого ОснованиеПоИдентификаторуПЭ Из ОснованияПоИдентификаторуПЭ Цикл
			Если мДокументыОснования.Найти(ОснованиеПоИдентификаторуПЭ) = Неопределено Тогда
				мДокументыОснования.Добавить(ОснованиеПоИдентификаторуПЭ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументыОснования.Очистить();
	Для Каждого ДокументОснование Из мДокументыОснования Цикл
		НоваяСтрока = ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснование;
		Если ДокументОснование = ОсновнойДокумент Тогда
			НоваяСтрока.ГлавныйДокумент = Истина;	
		КонецЕсли;
	КонецЦикла; 
	ДокументыОснования.Сортировать("ГлавныйДокумент Убыв");
	
	Если ИдентификаторПЭ = Неопределено И ДокументыОснования.Количество() > 0  Тогда
		ИдентификаторПЭ = МодульОбъекта.ИдентификаторПЭ(ДокументыОснования[0].ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы(ПерезаполнитьШапку = Ложь, ПерезаполнитьОпГруз = Ложь)
	
	МодульОбъекта = ОбработкаОбъект();	
	
	мДокументыОснования = ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	
	ДанныеПЭ = МодульОбъекта.ДанныеПЭ(ИдентификаторПЭ, мДокументыОснования, ПерезаполнитьШапку, ПерезаполнитьОпГруз);

	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеПЭ, ЭтаФорма); 

	УстановитьСписокВыбораАдрПунктНазн(ДанныеПЭ);
	УстановитьСписокВыбораАдрГруз(ДанныеПЭ);
	
КонецПроцедуры

&НаСервере
Функция ЭтоНовыйДокументПЭ()

	Если Не ЭтоСтруктура(СтрокаСписка) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Не ЗначениеЗаполнено(СвойствоСтруктуры(СтрокаСписка, "Ключ"));

КонецФункции

&НаСервере
Функция ЗначениеПредставлениеПоСтрокеXML(РезультатЗакрытия)
	
	МодульОбъекта = ОбработкаОбъект();
	Возврат МодульОбъекта.ЗначениеПредставлениеПоСтрокеXML(РезультатЗакрытия);
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыВыбораДоговора(Владелец, РеквизитДоговор)
	
	МодульОбъекта = ОбработкаОбъект();
	ИмяСправочника = МодульОбъекта.ИмяСправочникаДоговорыКонтрагентов();
	Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		// проверим наличие владельца
		Если Метаданные.Справочники[ИмяСправочника].Владельцы.Количество() > 0 Тогда
			ПараметрыВыбора = Новый Массив;
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Владелец));
			ЭтаФорма.Элементы[РеквизитДоговор].ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
		// проверим наличие контрагента
		ИначеЕсли Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("Контрагент") <> Неопределено Тогда
			ПараметрыВыбора = Новый Массив;
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Контрагент", Владелец));
			ЭтаФорма.Элементы[РеквизитДоговор].ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере                
Процедура УстановитьСписокВыбораАдрПунктНазн(ДанныеПЭ = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();

	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей
	
	Если рл_СвГруз_АдрПунктНазн_МестоВыд = 2 Тогда
		Грузополучатель = ЭтаФорма.рл_СвЭксп;
	Иначе
		Грузополучатель = ЭтаФорма.рл_СвГруз_СвГП;
	КонецЕсли;
               
	ИсточникиАдреса = Новый Массив;
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		ИсточникиАдреса.Добавить(Грузополучатель);
	КонецЕсли;
	
	Если ЭтаФорма.ОсновнойДокумент <> Неопределено И рл_СвГруз_АдрПунктНазн_МестоВыд = 1 Тогда
		ДанныеСклада = Новый Структура("Склад, СкладПолучатель, СтруктурнаяЕдиницаПолучатель");
		ЗаполнитьЗначенияСвойств(ДанныеСклада, ЭтаФорма.ОсновнойДокумент);
		Если ЗначениеЗаполнено(ДанныеСклада.Склад) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.Склад);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладПолучатель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладПолучатель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СтруктурнаяЕдиницаПолучатель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СтруктурнаяЕдиницаПолучатель);
		КонецЕсли;
	КонецЕсли;
	
	
	Для Каждого Источник Из ИсточникиАдреса Цикл
		
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Источник);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));	
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли; 
		КонецЦикла;
			
	КонецЦикла;

	Если ЭтаФорма.ОсновнойДокумент <> Неопределено Тогда
		
		МетаданныеДокумента = ЭтаФорма.ОсновнойДокумент.Метаданные();
				
		Если МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "АдресДоставкиЗначение") 
			И МодульОбъекта.ЕстьРеквизитМетаданных(МетаданныеДокумента, "АдресДоставки") Тогда
			Адрес = ЭтаФорма.ОсновнойДокумент.АдресДоставки;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = ЭтаФорма.ОсновнойДокумент.АдресДоставкиЗначение;
				ПредставлениеАдреса = ЭтаФорма.ОсновнойДокумент.АдресДоставки;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));		
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	СписокВыбораАдреса = Элементы.рл_СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрИнф_АдрТекст.СписокВыбора;
	СписокВыбораАдреса.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораАдреса.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	Если МодульОбъекта.ЕстьИЗаполненоСвойствоСтруктуры(ДанныеПЭ, "СвГруз.АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.АдрТекст") Тогда
		Адрес = ДанныеПЭ.СвГруз.АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.АдрТекст;
		АдресРФ = ДанныеПЭ.СвГруз.АдрПунктНазн.АдрВыдГруз.Адрес.АдрРФ;
		Если ЗначениеЗаполнено(Адрес) Тогда
			Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, АдресРФ, Адрес));
			НайденныйАдрес = СписокВыбораАдреса.НайтиПоЗначению(Адрес);
			Если НайденныйАдрес = Неопределено Тогда
				СписокВыбораАдреса.Добавить(Адрес, Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ХранениеАдресаДоставки = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораАдрГруз(ДанныеПЭ = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();

	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей
	
	Если рл_СвГруз_АдрГруз_МестоПрием = 2 Тогда
		Грузоотправитель = ЭтаФорма.рл_СвЭксп;
	Иначе
		Грузоотправитель = ЭтаФорма.рл_СвГруз_СвГО;
	КонецЕсли;

	ИсточникиАдреса = Новый Массив;
	Если ЗначениеЗаполнено(Грузоотправитель) Тогда
		ИсточникиАдреса.Добавить(Грузоотправитель);
	КонецЕсли;
	
	Если ЭтаФорма.ОсновнойДокумент <> Неопределено И рл_СвГруз_АдрГруз_МестоПрием = 1 Тогда
		ДанныеСклада = Новый Структура("Склад, СкладОтправитель, СтруктурнаяЕдиница, СкладКомпании");
		ЗаполнитьЗначенияСвойств(ДанныеСклада, ЭтаФорма.ОсновнойДокумент);
		Если ЗначениеЗаполнено(ДанныеСклада.Склад) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.Склад);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладОтправитель) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладОтправитель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СтруктурнаяЕдиница) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СтруктурнаяЕдиница);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСклада.СкладКомпании) Тогда
			ИсточникиАдреса.Добавить(ДанныеСклада.СкладКомпании);
		КонецЕсли;
	КонецЕсли;

	Для Каждого Источник Из ИсточникиАдреса Цикл
		
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = МодульОбъекта.ДанныеКонтактнаяИнформацияАдреса(Источник);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			Если АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
				ЗначениеАдреса = СтрокаАдреса.АдресРФ;
				ПредставлениеАдреса = СтрокаАдреса.Адрес;
				Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));	
				АдресаПоПредставлению.Добавить(Адрес)
			КонецЕсли; 
		КонецЦикла;
			
	КонецЦикла;
	
	СписокВыбораАдреса = Элементы.рл_СвГруз_АдрГруз_АдрПриемГруз_Адрес_АдрИнф_АдрТекст.СписокВыбора;
	СписокВыбораАдреса.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораАдреса.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	Если МодульОбъекта.ЕстьИЗаполненоСвойствоСтруктуры(ДанныеПЭ, "СвГруз.АдрГруз.АдрПриемГруз.Адрес.АдрИнф.АдрТекст") Тогда
		Адрес = ДанныеПЭ.СвГруз.АдрГруз.АдрПриемГруз.Адрес.АдрИнф.АдрТекст;
		АдресРФ = ДанныеПЭ.СвГруз.АдрГруз.АдрПриемГруз.Адрес.АдрРФ;
		Если ЗначениеЗаполнено(Адрес) Тогда
			Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, АдресРФ, Адрес));
			НайденныйАдрес = СписокВыбораАдреса.НайтиПоЗначению(Адрес);
			Если НайденныйАдрес = Неопределено Тогда
				СписокВыбораАдреса.Добавить(Адрес, Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ХранениеАдресаПогрузки = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры


#КонецОбласти


#Область ПроверкаИСтатусы

&НаСервере
Функция ПодготовитьЭПЭ(УчитыватьОшибки = Истина)
	
	МодульОбъекта = ОбработкаОбъект();
	Формат = "__kl_porek_wt3_05_02_01";
	ПараметрыПЭ = Новый Структура;
	ПараметрыПЭ.Вставить("ДанныеСотрудника", Новый Структура);

	мДокументыОснования = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораПЭ(), ИдентификаторПЭ);
	Если мДокументыОснования.Найти(ОсновнойДокумент) = Неопределено
		И ЗначениеЗаполнено(ОсновнойДокумент) Тогда
		мДокументыОснования.Добавить(ОсновнойДокумент);
	КонецЕсли;
	СообщениеПЭ = МодульОбъекта.ПодготовитьСообщениеПЭ(Формат, ИдентификаторПЭ, мДокументыОснования, ПараметрыПЭ);

	ЕстьОшибки = ОбработатьОшибки(МодульОбъекта, СообщениеПЭ);
	Если ЕстьОшибки И УчитыватьОшибки Тогда
		Результат = Неопределено;
	Иначе
		Кодировка = "utf-8";
		Результат = МодульОбъекта.СобратьXmlПоДокументу(СообщениеПЭ, Формат, ПараметрыПЭ, Кодировка);
	КонецЕсли;

	ОпределитьСтатусДокумента(ЕстьОшибки);	

	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОпределитьСтатусДокумента(ЕстьОшибки)

	МодульОбъекта = ОбработкаОбъект();

	СтатусЛокальный = МодульОбъекта.ОпределитьСтатусПЭ(ЕстьОшибки);
	СтатусДокумента = МодульОбъекта.СтрШаблонЛок("(%1)", СтатусЛокальный);
	
	СтатусыДоОтправки = МодульОбъекта.СтатусыДоОтправки();
	Если ТипЗнч(СтрокаСписка) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(СтрокаСписка.Статус) 
			И СтатусыДоОтправки.Найти(СтрокаСписка.Статус) = Неопределено Тогда
			СтатусДокумента = МодульОбъекта.СтрШаблонЛок("(%1 %2)", СтрокаСписка.Статус, СтрокаСписка.ДополнительныйСтатус);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьЭПЭ()
	
	МодульОбъекта = ОбработкаОбъект();
	
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, "ФормаПЭ");
	СообщениеПЭ = Новый Структура;
	МодульОбъекта.ЗаменитьСсылкиНаСтруктуры(СообщениеПЭ, ЗначенияДополнительныхСвойств);

	ЕстьОшибки = ОбработатьОшибки(МодульОбъекта, СообщениеПЭ);
	
	ОпределитьСтатусДокумента(ЕстьОшибки);
	
КонецПроцедуры

&НаСервере
Функция ОбработатьОшибки(МодульОбъекта, СообщениеПЭ)
	     
	НезаполненныеРеквизиты = Новый Массив;
	ПараметрыВалидации = МодульОбъекта.ВсеПараметрыВалидацииПЭ();
	МодульОбъекта.ПроверитьОбязательныеПоля(СообщениеПЭ, СообщениеПЭ, ПараметрыВалидации, НезаполненныеРеквизиты);
	МодульОбъекта.ПроверитьИдентификаторыЭДО(СообщениеПЭ, НезаполненныеРеквизиты, "ФормаПЭ");
	
	Ошибки.Очистить();
	Для Каждого ПараметрыПоля Из НезаполненныеРеквизиты Цикл
		
		СтрокаСОшибкой = "";
		ИдентификаторСтроки = "";
		Если ПараметрыПоля.Свойство("НомерСтрокиОшибки") И ПараметрыПоля.НомерСтрокиОшибки > 0 Тогда
			СтрокаСОшибкой = " строка " + ПараметрыПоля.НомерСтрокиОшибки;
			ИдентификаторСтроки = ЭтаФорма[ПараметрыПоля.ИмяРеквизитаТЧ][ПараметрыПоля.НомерСтрокиОшибки-1].ПолучитьИдентификатор();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыПоля.ИмяФормы) Тогда
			НоваяСтрока = Ошибки.Добавить();
			НоваяСтрока.НазваниеРеквизита = ПараметрыПоля.НазваниеРеквизита;
			Если ПараметрыПоля.Свойство("ТекстОшибки") Тогда
				НоваяСтрока.Представление = ПараметрыПоля.ТекстОшибки;
				НоваяСтрока.НекорректноЗаполнено = Истина;
			Иначе
				НоваяСтрока.Представление = "Указать: " + ПараметрыПоля.Представление + СтрокаСОшибкой;
			КонецЕсли;
			НоваяСтрока.Действие = "Указать";
			НоваяСтрока.ИмяФормы = ПараметрыПоля.ИмяФормы;
			НоваяСтрока.ИмяРеквизитаРодителя = ПараметрыПоля.ИмяРеквизитаРодителя;
			НоваяСтрока.ИмяРеквизитаТЧ = ПараметрыПоля.ИмяРеквизитаТЧ;
			НоваяСтрока.ИндексКартинки = Истина;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			Если МодульОбъекта.СтрНайтиЛок(ЭтаФорма.ИмяФормы, ПараметрыПоля.ИмяФормы) > 0
				И ПараметрыПоля.ОтметкаНезаполненного Тогда
				Попытка
					Элементы[ПараметрыПоля.НазваниеРеквизита].АвтоОтметкаНезаполненного = Истина;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьОшибки = Ошибки.Количество() > 0;
	Если ЕстьОшибки Тогда
		Элементы.ГруппаОшибки.Видимость = Истина;
	Иначе
		Элементы.ГруппаОшибки.Видимость = Ложь;
	КонецЕсли; 
	
	Возврат ЕстьОшибки;
	
КонецФункции

