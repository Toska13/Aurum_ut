		ТекущиеДанные.ИнфУпГруз_ВесУпак = 0;
		ТекущиеДанные.ИнфУпГруз_ГабарУпак_ВысЗнач = 0;
		ТекущиеДанные.ИнфУпГруз_ГабарУпак_ДлЗнач = 0;
		ТекущиеДанные.ИнфУпГруз_ГабарУпак_ШирЗнач = 0;
