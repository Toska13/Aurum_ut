&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИмяРеквизита") Тогда
		ИмяРеквизита = Параметры.ИмяРеквизита;
	КонецЕсли;
	Если Параметры.Свойство("ИмяРеквизитаДоп") Тогда
		ИмяРеквизитаДоп = Параметры.ИмяРеквизитаДоп;
	КонецЕсли;
	Если Параметры.Свойство("ЗначениеРеквизита") Тогда
		ЗначениеРеквизита = Параметры.ЗначениеРеквизита;
	КонецЕсли;
	Если Параметры.Свойство("ПредставлениеРеквизита") Тогда
		ПредставлениеРеквизита = Параметры.ПредставлениеРеквизита;
	КонецЕсли;
	Если Параметры.Свойство("ОсновнойДокумент") Тогда
		ОсновнойДокумент = Параметры.ОсновнойДокумент;
		МетаданныеДокумента = ОсновнойДокумент.Метаданные().ПолноеИмя();
		МетаданныеДокументаПредставление = ОсновнойДокумент.Метаданные().Представление();
	КонецЕсли;
	Если Параметры.Свойство("КлючРеквизитов") Тогда
		КлючРеквизитов = Параметры.КлючРеквизитов;
	КонецЕсли;
	
	Если Параметры.Свойство("ХранениеВозможныхЗначений") Тогда
		ХранениеВозможныхЗначений = Параметры.ХранениеВозможныхЗначений;
	КонецЕсли;
	
	ИдентификаторНастройки = МетаданныеДокумента + "_" + КлючРеквизитов + "_" + ИмяРеквизита;
	ЗаполнитьКомпоновщикНастроекСКД(ЗначениеРеквизита, ИдентификаторНастройки);
		
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьКомпоновщикНастроекСКД(ЗначениеРеквизита, ИдентификаторНастройки)
	
	ОбработкаОбъект = ОбработкаОбъект();
	
	Настройки = ОбработкаОбъект.ВосстановитьНастройки(ИдентификаторНастройки).Настройки;
	Если ЗначениеЗаполнено(Настройки) Тогда
		Для Каждого СтрокаНастройки Из Настройки Цикл
			НоваяСтрока = ТаблицаЗначенийРеквизитаСУсловиями.Добавить(); 
			Если ТипЗнч(СтрокаНастройки.ЗначениеРеквизита) = Тип("Структура") Тогда
				НоваяСтрока.ЗначениеРеквизита = СтрокаНастройки.ЗначениеРеквизита[ИмяРеквизита];
				НоваяСтрока.ЗначениеРеквизитаДоп = СтрокаНастройки.ЗначениеРеквизита[ИмяРеквизитаДоп];
			Иначе
				НоваяСтрока.ЗначениеРеквизита = СтрокаНастройки.ЗначениеРеквизита;
			КонецЕсли;
			Если СтрокаНастройки.НастройкаСКД = Неопределено Тогда
				НоваяСтрока.ПредставлениеНастройкиСКД = "<Всегда>";
			Иначе
				НоваяСтрока.ПредставлениеНастройкиСКД = Строка(СтрокаНастройки.НастройкаСКД.Отбор);
				НастройкаСКД = Новый ХранилищеЗначения(СтрокаНастройки.НастройкаСКД);
				НоваяСтрока.АдресНастройкиСКД = ПоместитьВоВременноеХранилище(НастройкаСКД, УникальныйИдентификатор);
			КонецЕсли;
			
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ТипЗнч(НоваяСтрока.ЗначениеРеквизита));
			Элементы.ЗначениеРеквизита.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
			
		КонецЦикла;
	Иначе
		НоваяСтрока = ТаблицаЗначенийРеквизитаСУсловиями.Добавить();
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Структура") Тогда
			НоваяСтрока.ЗначениеРеквизита = ЗначениеРеквизита[ИмяРеквизита];
			НоваяСтрока.ЗначениеРеквизитаДоп = ЗначениеРеквизита[ИмяРеквизитаДоп];
		Иначе
			НоваяСтрока.ЗначениеРеквизита = ЗначениеРеквизита;
		КонецЕсли;
		НоваяСтрока.ПредставлениеНастройкиСКД = "<Всегда>";   

		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(НоваяСтрока.ЗначениеРеквизита));
		Элементы.ЗначениеРеквизита.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);

	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(ХранениеВозможныхЗначений) Тогда
		ВозможныеЗначения = ПолучитьИзВременногоХранилища(ХранениеВозможныхЗначений);
		Для Каждого Значение Из ВозможныеЗначения Цикл
			Элементы.ЗначениеРеквизита.СписокВыбора.Добавить(Значение.Адрес);
		КонецЦикла;                                                          
		Элементы.ЗначениеРеквизита.РежимВыбораИзСписка = Истина;
		Элементы.ЗначениеРеквизита.РедактированиеТекста = Ложь;
	КонецЕсли;


КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗначенияСУсловиями(Команда)
	
	ЗаписатьЗначенияСУсловиямиНаСервере(ИдентификаторНастройки);
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗначенияСУсловиямиНаСервере(ИдентификаторНастройки)
	
	ОбработкаОбъект = ОбработкаОбъект();
	
	СохраняемыеНастройки = Новый Массив;
	
	Для Каждого СтрокаЗначений Из ТаблицаЗначенийРеквизитаСУсловиями Цикл
		
		Если ЗначениеЗаполнено(СтрокаЗначений.ЗначениеРеквизитаДоп) Тогда 
			ЗначениеРеквизита = Новый Структура;
			ЗначениеРеквизита.Вставить(ИмяРеквизита, СтрокаЗначений.ЗначениеРеквизита);
			ЗначениеРеквизита.Вставить(ИмяРеквизитаДоп, СтрокаЗначений.ЗначениеРеквизитаДоп);
		Иначе
			ЗначениеРеквизита = СтрокаЗначений.ЗначениеРеквизита;
		КонецЕсли;
		
		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ЗначениеРеквизита",	ЗначениеРеквизита);
		Если ЭтоАдресВременногоХранилища(СтрокаЗначений.АдресНастройкиСКД) Тогда
			НастройкаСКД = ПолучитьИзВременногоХранилища(СтрокаЗначений.АдресНастройкиСКД);
			СтрокаНастройки.Вставить("НастройкаСКД", НастройкаСКД.Получить());
		Иначе
			СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		КонецЕсли;
		
		СохраняемыеНастройки.Добавить(СтрокаНастройки);
		
	КонецЦикла;
	
	ОбработкаОбъект.ЗаписатьНастройки(СохраняемыеНастройки, ИдентификаторНастройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗначенийРеквизитаСУсловиямиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ПредставлениеНастройкиСКД" Тогда
		
		ТекущиеДанные = Элементы.ТаблицаЗначенийРеквизитаСУсловиями.ТекущиеДанные;
 		ТекущаяСтрока = Элементы.ТаблицаЗначенийРеквизитаСУсловиями.ТекущаяСтрока;

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресНастройкиСКД", ТекущиеДанные.АдресНастройкиСКД);
		ПараметрыФормы.Вставить("МетаданныеДокумента", МетаданныеДокумента);
		ПараметрыФормы.Вставить("МетаданныеДокументаПредставление", МетаданныеДокументаПредставление);
		ПараметрыФормы.Вставить("ИдентификаторНастройки", ИдентификаторНастройки);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
		
		Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеНастройкиСКД", ЭтаФорма, ДополнительныеПараметры);
		
		_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаНастройкиСКД", ПараметрыФормы, ЭтаФорма, Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура Оповещение_ПослеНастройкиСКД(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		ТекущиеДанные = ТаблицаЗначенийРеквизитаСУсловиями.НайтиПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
		ТекущиеДанные.АдресНастройкиСКД = РезультатЗакрытия.АдресНастройкиСКД;
		ТекущиеДанные.ПредставлениеНастройкиСКД = РезультатЗакрытия.ПредставлениеНастройкиСКД;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеРеквизитаПриИзменении(Элемент) 
	
	ТекущиеДанные = Элементы.ТаблицаЗначенийРеквизитаСУсловиями.ТекущиеДанные;
	
	Если ЭтоАдресВременногоХранилища(ХранениеВозможныхЗначений) Тогда
		ВозможныеЗначения = ПолучитьИзВременногоХранилища(ХранениеВозможныхЗначений);
		Адрес = ТекущиеДанные.ЗначениеРеквизита;
		Для Каждого СтруктураАдреса Из ВозможныеЗначения Цикл
			Если СтруктураАдреса.Адрес = Адрес Тогда
				ТекущиеДанные.ЗначениеРеквизитаДоп = СтруктураАдреса.ЗначениеАдреса;                     
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	Оповещение = Новый ОписаниеОповещения("Оповещение_ОтветНаВопросУдаления", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Вы действительно хотите удалить настройки значения по умолчанию?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ОтветНаВопросУдаления(РезультатВопроса, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВопроса <> Неопределено Тогда
		Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
			УдалитьНаСервере();	
			ЭтаФорма.Закрыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНаСервере()
	
	ОбработкаОбъект = ОбработкаОбъект();
	ОбработкаОбъект.ЗаписатьНастройки(Неопределено, ИдентификаторНастройки);
		
КонецПроцедуры
