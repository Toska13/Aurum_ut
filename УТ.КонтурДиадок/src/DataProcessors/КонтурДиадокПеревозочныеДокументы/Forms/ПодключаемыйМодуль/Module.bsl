&НаКлиенте
Функция НажатиеДополнительнойКнопки(Параметры) экспорт
	
	Результат = Неопределено;
	
	ИмяФормыВызова = Параметры.ИмяФормы;
	ИмяКнопки = Параметры.ИмяКнопки;
	
	Если ИмяФормыВызова = "Форма" Тогда
		
		РежимОтображенияДокументов = Параметры.РежимОтображенияДокументов;		
		ВыделенныеСтроки = Параметры.ВыделенныеСтроки;	  
		
		Если ИмяКнопки = "РедактированиеТрН" И ВыделенныеСтроки.Количество() > 0 Тогда
			
			мСсылкиНаОбъект = Новый Массив;
			Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
				мСсылкиНаОбъект.Добавить(ВыделеннаяСтрока.Документ);
			КонецЦикла;
			
			П = Новый Структура;
			П.Вставить("СсылкиНаОбъект", мСсылкиНаОбъект);
			ОткрытьФорму(ИмяОбработки() + ".Форма.ФормаТрН",
				П,
				ЭтаФорма,,,,
				Новый ОписаниеОповещения("ЗавершениеРедактирования", ЭтаФорма, Параметры, "ОшибкаРедактирования", ЭтаФорма),
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

			
		ИначеЕсли ИмяКнопки = "Отправить" Тогда
			
		ИначеЕсли ИмяКнопки = "СоздатьДокумент1С" Тогда
			
			
		КонецЕсли;  
				
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

