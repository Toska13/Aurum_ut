    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВЫРАЗИТЬ(&quot;ИдентификаторНастройки&quot; КАК СТРОКА(36)) КАК ИдентификаторНастройки,
	ВЫРАЗИТЬ(&quot;РеализацияТоваровУслуг&quot; КАК СТРОКА(250)) КАК ТипДокумента,
	ВЫРАЗИТЬ(&quot;РеализацияТоваровУслуг&quot; КАК СТРОКА(250)) КАК ТипДокументаПредставление,
	ЛОЖЬ КАК ЕстьЭТрН,
	ЛОЖЬ КАК ЕстьЭЗЗ,
	ЛОЖЬ КАК ЕстьЭПЭ,
	ЛОЖЬ КАК Проведен,
	НЕОПРЕДЕЛЕНО КАК Ссылка,
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(15)) КАК Номер,
	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
	0 КАК СуммаДокумента,
	НЕОПРЕДЕЛЕНО КАК Организация,
	НЕОПРЕДЕЛЕНО КАК Контрагент,
	НЕОПРЕДЕЛЕНО КАК Грузоотправитель,
	НЕОПРЕДЕЛЕНО КАК Грузополучатель,
	0 КАК НомерКартинки</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
