&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОповеститьОВыборе(ЗначениеОпасныеГрузыXML());
	
КонецПроцедуры

&НаСервере
Функция ЗначениеОпасныеГрузыXML()

	МодульОбъекта = ОбработкаОбъект();

	МассивДанных = Новый Массив;
	Для Каждого СтрокаТЗ Из ОпасныеГрузы Цикл
		Сведение = МодульОбъекта.СтруктураОпасныйГруз();
		ЗаполнитьЗначенияСвойств(Сведение, СтрокаТЗ);
		МассивДанных.Добавить(Сведение);
	КонецЦикла;

	ЗначениеXML  = ?(МассивДанных.Количество() > 0, МодульОбъекта.СериализоватьXML(МассивДанных), "");
	
	Возврат ЗначениеXML;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОпасныеГрузыXML") Тогда
		ОпасныеГрузыXML = Параметры.ОпасныеГрузыXML;
		ЗагрузитьСведенияОпасныхГрузов(ОпасныеГрузыXML);
	КонецЕсли;
	
	Если Параметры.Свойство("ИмяФормы") Тогда
		_ИмяФормы = Параметры.ИмяФормы;
	КонецЕсли;
	
	УстановитьСписокВыбораКласс();
	УстановитьСписокВыбораГруппаУпаковки();
	
	ОбновитьВидимостьЭлементовОпасныхГрузов();
	
	Если Параметры.Свойство("ЗапретРедактирования")
		И Параметры.ЗапретРедактирования = Истина Тогда
		Элементы.ФормаСохранить.Доступность = Ложь;
		Элементы.ОпасныеГрузы.ТолькоПросмотр = Истина;
		Элементы.ДобавитьОпасныйГруз.Видимость = Ложь;
	КонецЕсли;
	
	Если _ИмяФормы = "ФормаПЭ" Тогда
		Элементы.ОпасныеГрузыНПА.Видимость = Истина;
		Элементы.ОпасныеГрузыОбМасНетВзрСод.Видимость = Ложь;
		Элементы.ОпасныеГрузыОбМасНетВзрСодВсех.Видимость = Ложь;
		Элементы.ОпасныеГрузыПроцСмеси.Видимость = Ложь;
	Иначе
		Элементы.ОпасныеГрузыНПА.Видимость = Ложь;
		Элементы.ОпасныеГрузыОбМасНетВзрСод.Видимость = Истина;
		Элементы.ОпасныеГрузыОбМасНетВзрСодВсех.Видимость = Истина;
		Элементы.ОпасныеГрузыПроцСмеси.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСведенияОпасныхГрузов(ОпасныеГрузыXML)

	ОпасныеГрузы.Очистить();
	
	МодульОбъекта = ОбработкаОбъект();
	ДанныеОпасныеГрузы = МодульОбъекта.ДесериализоватьXML(ОпасныеГрузыXML);
		
	Если ТипЗнч(ДанныеОпасныеГрузы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ОпасныйГруз Из ДанныеОпасныеГрузы Цикл
		Если ТипЗнч(ОпасныйГруз) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ОпасныеГрузы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОпасныйГруз);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОпасныеГрузыПриАктивизацииСтроки(Элемент)
	
	ОбновитьВидимостьЭлементовОпасныхГрузов();
	ВидимостьПоКлассам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОпасныеГрузыКласПриИзменении(Элемент)
	
	ВидимостьПоКлассам();
	ОчиститьДанныеПоКлассам();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьПоКлассам()
	
	ТекущиеДанные = Элементы.ОпасныеГрузы.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.ГруппаКласс1.Видимость = ТекущиеДанные.Клас = "1";
		Элементы.ГруппаКласс2.Видимость = ТекущиеДанные.Клас = "2";
		Элементы.ГруппаКласс7.Видимость = ТекущиеДанные.Клас = "7";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанныеПоКлассам()

	ТекущиеДанные = Элементы.ОпасныеГрузы.ТекущиеДанные; 
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если ТекущиеДанные.Клас <> "1" Тогда
			ТекущиеДанные.ОбМасНетВзрСод = Неопределено;
			ТекущиеДанные.ОбМасНетВзрСодВсех = Неопределено; 
		КонецЕсли;
		
		Если ТекущиеДанные.Клас <> "2" Тогда
			ТекущиеДанные.ПроцСмеси = Неопределено;
			ТекущиеДанные.ДатИстВрУдер = Неопределено; 
		КонецЕсли;
		
		Если ТекущиеДанные.Клас <> "7" Тогда
			ТекущиеДанные.НазРадионук = Неопределено;
			ТекущиеДанные.ОписФизХимФорм = Неопределено;
			ТекущиеДанные.МаксАкт = Неопределено;
			ТекущиеДанные.КатУпак = Неопределено;
			ТекущиеДанные.ТрансИндекс = Неопределено;
			ТекущиеДанные.ИндексБез = Неопределено;
			ТекущиеДанные.ОпозЗнак = Неопределено;
			ТекущиеДанные.ПолнАктГр = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораКласс()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("1",		"Класс 1: Взрывчатые вещества и изделия");
	СписокВыбора.Добавить("2",		"Класс 2: Газы");
	СписокВыбора.Добавить("3",		"Класс 3: Легковоспламеняющиеся жидкости");
	СписокВыбора.Добавить("4_1",	"Класс 4.1: Легковоспламеняющиеся твердые вещества, самореактивные вещества, полимеризирующиеся вещества и твердые десенсибилизированные взрывчатые вещества");
	СписокВыбора.Добавить("4_2",	"Класс 4.2: Вещества, способные к самовозгоранию");
	СписокВыбора.Добавить("4_3",	"Класс 4.3: Вещества, выделяющие легковоспламеняющиеся газы при соприкосновении с водой");
	СписокВыбора.Добавить("5_1",	"Класс 5.1: Окисляющие вещества");
	СписокВыбора.Добавить("5_2",	"Класс 5.2: Органические пероксиды");
	СписокВыбора.Добавить("6_1",	"Класс 6.1: Токсичные вещества");
	СписокВыбора.Добавить("6_2",	"Класс 6.2: Инфекционные вещества");
	СписокВыбора.Добавить("7",		"Класс 7: Радиоактивные материалы");
	СписокВыбора.Добавить("8",		"Класс 8: Коррозионные вещества");
	СписокВыбора.Добавить("9",		"Класс 9: Прочие опасные вещества и изделия");
	
	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Элементы.ОпасныеГрузыКлас.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораГруппаУпаковки()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("-", "-");
	СписокВыбора.Добавить("1", "I группа упаковки");
	СписокВыбора.Добавить("2", "II группа упаковки");
	СписокВыбора.Добавить("3", "III группа упаковки");
	
	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Элементы.ОпасныеГрузыГрУп.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОпасныйГруз(Команда)
	
	НоваяСтрока = ОпасныеГрузы.Добавить();
	Элементы.ОпасныеГрузы.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ОбновитьВидимостьЭлементовОпасныхГрузов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьЭлементовОпасныхГрузов()
	
	ЕстьСтрокиОпасныхГрузов = ОпасныеГрузы.Количество() > 0;
	Элементы.ГруппаКнопкаДобавления.Видимость = Не ЕстьСтрокиОпасныхГрузов;
	Элементы.ГруппаДанные.Видимость = ЕстьСтрокиОпасныхГрузов;
	
КонецПроцедуры

