&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Метрика_НаименованиеФормы", Метрика_НаименованиеФормы);
	
	ВосстановитьНастройкиПодбораПоСКД();
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиПодбораПоСКД()
	
	ОбработкаОбъект = ОбработкаОбъект();
	
	ВосстановленныеНастройки = ОбработкаОбъект.ВосстановитьНастройки("ПодборПоСКД").Настройки;
	Если ВосстановленныеНастройки = Неопределено Тогда
		ВосстановленныеНастройки = ОбработкаОбъект.НастройкиПодбораПоСКДПоУмолчанию();
	ИначеЕсли ТипЗнч(ВосстановленныеНастройки) = Тип("Массив") И ВосстановленныеНастройки.Количество() = 0 Тогда
		ВосстановленныеНастройки = ОбработкаОбъект.НастройкиПодбораПоСКДПоУмолчанию();
	КонецЕсли;
	
	Если ВосстановленныеНастройки <> Неопределено Тогда
		Для Каждого СтрокаНастройки Из ВосстановленныеНастройки Цикл
			
			НоваяСтрока = НастройкиПодбораПоСКД.Добавить();
			НоваяСтрока.МетаданныеДокумента = СтрокаНастройки.МетаданныеДокумента;
			НоваяСтрока.МетаданныеДокументаПредставление = СтрокаНастройки.МетаданныеДокументаПредставление;
			НоваяСтрока.ИдентификаторНастройки = СтрокаНастройки.ИдентификаторНастройки;
			
			Если СтрокаНастройки.НастройкаСКД = Неопределено Тогда
				НоваяСтрока.ПредставлениеНастройкиСКД = "<Все документы>";
			ИначеЕсли НетАктивныхОтборовСКД(СтрокаНастройки.НастройкаСКД) Тогда
				НоваяСтрока.ПредставлениеНастройкиСКД = "<Все документы>";
				НастройкаСКД = Новый ХранилищеЗначения(СтрокаНастройки.НастройкаСКД);
				НоваяСтрока.АдресНастройкиСКД = ПоместитьВоВременноеХранилище(НастройкаСКД, УникальныйИдентификатор);
			Иначе
				НоваяСтрока.ПредставлениеНастройкиСКД = Строка(СтрокаНастройки.НастройкаСКД.Отбор);
				НастройкаСКД = Новый ХранилищеЗначения(СтрокаНастройки.НастройкаСКД);
				НоваяСтрока.АдресНастройкиСКД = ПоместитьВоВременноеХранилище(НастройкаСКД, УникальныйИдентификатор);
			КонецЕсли;
			
		КонецЦикла;                                        
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НетАктивныхОтборовСКД(НастройкаСКД)
	
	ЕстьАктивныеОтборы = Ложь;
	 Для Каждого СтрокаОтбора Из НастройкаСКД.Отбор.Элементы Цикл
		 Если СтрокаОтбора.Использование Тогда
			 ЕстьАктивныеОтборы = Истина;
		 КонецЕсли;
	 КонецЦикла;
	 
	 Возврат Не ЕстьАктивныеОтборы;
	 
КонецФункции

&НаКлиенте
Процедура ЗаписатьНастройкиПодбораПоСКД(Команда)
	
	ЗаписатьНастройкиПодбораПоСКДНаСервере();
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ИзмененОтборДляПеревозочных;
	_КлиентскиеВызовы.Метрика_ДобавитьПоведение_НажатиеКнопки(Метрика_НаименованиеФормы, ДействиеМетрики);
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиПодбораПоСКДНаСервере()

	ОбработкаОбъект = ОбработкаОбъект();
	СохраняемыеНастройкиПодбораПоСКД = Новый Массив;
	
	Для Каждого НастройкаПодбораПоСКД Из НастройкиПодбораПоСКД Цикл    
		
		СтрокаНастройки = Новый Структура;
		
		СтрокаНастройки.Вставить("МетаданныеДокументаПредставление", НастройкаПодбораПоСКД.МетаданныеДокументаПредставление);
		СтрокаНастройки.Вставить("МетаданныеДокумента",			НастройкаПодбораПоСКД.МетаданныеДокумента);
		СтрокаНастройки.Вставить("ИдентификаторНастройки",		НастройкаПодбораПоСКД.ИдентификаторНастройки);
		Если ЭтоАдресВременногоХранилища(НастройкаПодбораПоСКД.АдресНастройкиСКД) Тогда
			НастройкаСКД = ПолучитьИзВременногоХранилища(НастройкаПодбораПоСКД.АдресНастройкиСКД);
			СтрокаНастройки.Вставить("НастройкаСКД", НастройкаСКД.Получить());
		Иначе
			СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		КонецЕсли;
		
		СохраняемыеНастройкиПодбораПоСКД.Добавить(СтрокаНастройки);	
		
	КонецЦикла;	
	
	ОбработкаОбъект.ЗаписатьНастройки(СохраняемыеНастройкиПодбораПоСКД, "ПодборПоСКД");

КонецПроцедуры

&НаКлиенте
Процедура НастройкиПодбораПоСКДВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "НастройкиПодбораПоСКДПредставлениеНастройкиСКД" Тогда
		
		ТекущиеДанные = Элементы.НастройкиПодбораПоСКД.ТекущиеДанные;
 		ТекущаяСтрока = Элементы.НастройкиПодбораПоСКД.ТекущаяСтрока;

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресНастройкиСКД", ТекущиеДанные.АдресНастройкиСКД);
		ПараметрыФормы.Вставить("МетаданныеДокумента", ТекущиеДанные.МетаданныеДокумента);
		ПараметрыФормы.Вставить("МетаданныеДокументаПредставление", ТекущиеДанные.МетаданныеДокументаПредставление);
		ПараметрыФормы.Вставить("ИдентификаторНастройки", ТекущиеДанные.ИдентификаторНастройки);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
		
		Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеНастройкиСКД", ЭтаФорма, ДополнительныеПараметры);
		
		_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаНастройкиСКД", ПараметрыФормы, ЭтаФорма, Оповещение);

	Иначе

		Отказ = Истина;      

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеНастройкиСКД(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		ТекущиеДанные = НастройкиПодбораПоСКД.НайтиПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
		ТекущиеДанные.АдресНастройкиСКД = РезультатЗакрытия.АдресНастройкиСКД;
		ТекущиеДанные.ПредставлениеНастройкиСКД = РезультатЗакрытия.ПредставлениеНастройкиСКД;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуНастройкиПодбораПоСКД()
	
	СписокМетаданныхПоОбъектам = СписокМетаданныхПоОбъектам(); 
	
	Если ЕстьОбщаяФормаОбъектаМетаданных() Тогда
		ПараметрыФормы = Новый Структура; 
		ПараметрыФормы.Вставить("ФильтрПоОбъектамМетаданных", СписокМетаданныхПоОбъектам);
		ПараметрыФормы.Вставить("Заголовок", 				  НСтр("ru = 'Выберите тип объекта'"));
		ПараметрыФормы.Вставить("СпособГруппировкиОбъектов",  "ПоВидам");
		ПараметрыФормы.Вставить("ВыборЕдинственного",		  Истина);
		Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВыбораМетаданныхОбъекта", ЭтаФорма); 
		ОткрытьФорму("ОбщаяФорма.ВыборОбъектовМетаданных", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор, , , Оповещение);  
	Иначе
		Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВыбораТипОбъекта", ЭтаФорма); 
		СписокМетаданныхПоОбъектам.ПоказатьВыборЭлемента(Оповещение, "Выберите тип объекта");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораМетаданныхОбъекта(ВыбранноеЗначение, Параметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		
	Иначе
		
		ПолноеИмяОбъекта = ВыбранноеЗначение[0].Значение;
		ДобавитьСтрокуНастройки(ПолноеИмяОбъекта, "", "");
		Элементы.НастройкиПодбораПоСКД.ТекущаяСтрока = НастройкиПодбораПоСКД.Получить(НастройкиПодбораПоСКД.Количество() - 1).ПолучитьИдентификатор();	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораТипОбъекта(ВыбранноеЗначение, Параметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		
	Иначе
		
		ПолноеИмяОбъекта = ВыбранноеЗначение.Значение;
		ДобавитьСтрокуНастройки(ПолноеИмяОбъекта, "", "");
		Элементы.НастройкиПодбораПоСКД.ТекущаяСтрока = НастройкиПодбораПоСКД.Получить(НастройкиПодбораПоСКД.Количество() - 1).ПолучитьИдентификатор();	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, ВыбранноеЗначение, Источник)

	Если ИмяСобытия = "ВыборОбъектовМетаданных"
		И ВыбранноеЗначение <> Неопределено Тогда
		ПолноеИмяОбъекта = ВыбранноеЗначение[0].Значение;
		ДобавитьСтрокуНастройки(ПолноеИмяОбъекта, "", "");
		Элементы.НастройкиПодбораПоСКД.ТекущаяСтрока = НастройкиПодбораПоСКД.Получить(НастройкиПодбораПоСКД.Количество() - 1).ПолучитьИдентификатор();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуНастройки(ИмяМетаданных, ИдентификаторНастройки, МетаданныеДокументаПредставление)
	
	Поиск = Новый Структура("МетаданныеДокумента", ИмяМетаданных);
	НашлиСтроки = НастройкиПодбораПоСКД.НайтиСтроки(Поиск);
	Если НашлиСтроки.Количество() = 0 Тогда
		НовСтрока = НастройкиПодбораПоСКД.Добавить();
		НовСтрока.МетаданныеДокумента				= ИмяМетаданных;         
		НовСтрока.ИдентификаторНастройки			= ?(ЗначениеЗаполнено(ИдентификаторНастройки), ИдентификаторНастройки, СокрЛП(Новый УникальныйИдентификатор()));
		НовСтрока.МетаданныеДокументаПредставление	= МетаданныеДокументаПредставление(ИмяМетаданных, МетаданныеДокументаПредставление);
		НовСтрока.ПредставлениеНастройкиСКД			= "<Все документы>";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокМетаданныхПоОбъектам()
	
