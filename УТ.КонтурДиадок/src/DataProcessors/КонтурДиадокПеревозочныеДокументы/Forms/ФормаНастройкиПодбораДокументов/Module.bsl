	ЕстьНовые = Истина;
	
	Пока ЕстьНовые Цикл
		
		ЕстьНовые = Ложь;
		
		// справочники не нужны
		//Для Каждого Справочник Из Метаданные.Справочники Цикл
		//	ЕстьРеквизит = ПроверитьМетаданныеНаНаличиеРеквизита(Справочник, ТипСправочникаКонтрагенты, Результат);
		//	
		//	Если ЕстьРеквизит И Результат.НайтиПоЗначению(Справочник.ПолноеИмя())=Неопределено Тогда
		//		Результат.Добавить(Справочник.ПолноеИмя());	
		//		ЕстьНовые = Истина;
		//	ИначеЕсли Справочник.Имя = ИмяСправочникаКонтрагенты И Результат.НайтиПоЗначению(Справочник.ПолноеИмя()) = Неопределено Тогда		
		//		Результат.Добавить(Справочник.ПолноеИмя()); 
		//		ЕстьНовые = Истина;
		//	КонецЕсли;
		//	
		//КонецЦикла;
		
		Для Каждого Документ Из Метаданные.Документы Цикл
			
			ЕстьРеквизит = ПроверитьМетаданныеНаНаличиеРеквизита(Документ, ТипСправочникаКонтрагенты, Результат);
			
			Если ЕстьРеквизит И Результат.НайтиПоЗначению(Документ.ПолноеИмя())=Неопределено Тогда
				Результат.Добавить(Документ.ПолноеИмя());	
