// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Инициализирует библиотеку интеграции
//
// Параметры:
//  ИдентификаторИнтеграции - Строка - (Необязательный) идентификатор семейства конфигураций (см. Конфигурации).
//                                     Если не указан, предпринимается попытка вычислить идентификатор по
//                                     метаданным текущей конфигурации (имя, версия, представление и т.д.).
//                                     Если указано невалидное значение, вызывается исключение.
// 
// Возвращаемое значение:
//  ОбработкаОбъект, ВнешняяОбработкаОбъект - инициализированный экземпляр библиотеки
//
Функция КлиентИнформационнойБазы(Знач ИдентификаторИнтеграции = "") Экспорт
	
	Если ТипЗнч(ИдентификаторИнтеграции) <> Тип("Строка") Тогда
		Ошибка = __СтдСтр.СтрШаблонЛок("Несоответствие типов ('%1')", ТипЗнч(ИдентификаторИнтеграции));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	__ИдентификаторИнтеграции = ИдентификаторИнтеграции;
	Если ПустаяСтрока(__ИдентификаторИнтеграции) Тогда
		__ИдентификаторИнтеграции = ВычислитьИдентификаторИнтеграции();
	КонецЕсли;
	
	Если Не Конфигурации.Свойство(__ИдентификаторИнтеграции) Тогда
		Ошибка = __СтдСтр.СтрШаблонЛок("Неизвестный идентификатор интеграции ('%1')", ИдентификаторИнтеграции);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции

// Формирует временные таблицы списков черновиков на отправку.
// Возвращает имена временных таблиц в МВТ для построения списка документов на отправку.
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - хранилище временных таблиц
//  ВидПакета - Строка - идентификатор вида пакета
//  Период - СтандартныйПериод - Период выборки данных для отправки
// 
// Возвращаемое значение:
//  Массив - Имена временных таблиц с данными для отправки
//
Функция ПодготовитьДанныеДляОтправки(МенеджерВТ, ВидПакета, Период) Экспорт
	
	_ПроверитьПараметры(
		НеЗаполнено(ВидПакета),
		НеЗаполнено(Период)
	);
	
	_ПроверитьПараметры(
		НесоответствиеТипов(МенеджерВТ, "МенеджерВременныхТаблиц"),
		НесоответствиеТипов(ВидПакета, "Строка"),
		НесоответствиеТипов(Период, "СтандартныйПериод")
		
	);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ВидПакетаID", ВидПакета);
	
	Интеграция = ИнтеграционныйМодульЧерновикиПакетов();
	Результат = Интеграция.СлужебныйПодготовитьДанныеДляОтправки(ВидПакета, Запрос);
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция СтдСтр()
	
	Если __СтдСтр = Неопределено Тогда
		
		Если ЭтоВнешняяОбработкаЛок() Тогда
			__СтдСтр = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			__СтдСтр = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат __СтдСтр;
	
КонецФункции

Функция СтдКоллекции()
	
	Если __СтдКоллекции = Неопределено Тогда
		
		Если ЭтоВнешняяОбработкаЛок() Тогда
			__СтдКоллекции = Новый("ExternalDataProcessorObject.КонтурДиадокСтдКоллекции");
		Иначе
			__СтдКоллекции = Новый("DataProcessorObject.КонтурДиадокСтдКоллекции");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат __СтдКоллекции;
	
КонецФункции

Функция ЭтоВнешняяОбработкаЛок()
	
	Если __ЭтоВнешняяОбработка = Неопределено Тогда
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		
		__ЭтоВнешняяОбработка = ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;
		
	КонецЕсли;
	
	Возврат __ЭтоВнешняяОбработка;
	
КонецФункции 

Функция МаркерыКонфигураций()
	
	Значения = Новый Структура;
	Значения.Вставить("БП30", "БП30");
	Значения.Вставить("УТ11", "УТ11");
	Значения.Вставить("УНФ", "УНФ");
	
	Результат = СтдКоллекции().ФиксированныеДанныеЛок(Значения);
	
	Возврат Результат;
	
КонецФункции

Функция ВычислитьИдентификаторИнтеграции()
	
	Если __СтдСтр.СтрНачинаетсяСЛок(Метаданные.Имя, "БухгалтерияПредприятия") Тогда
		Результат = Конфигурации.БП30;
	Иначе
		Ошибка = __СтдСтр.СтрШаблонЛок(
			"Не удалось вычислить идентификатор интеграции (Имя = '%1'; Версия = '%2')",
			Метаданные.Имя,
			Метаданные.Версия
		);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИнтеграционныйМодульЧерновикиПакетов()
	
	Если __ИдентификаторИнтеграции = Конфигурации.БП30 Тогда
		ИмяИМ = "ЧерновикиПакетовСлужебныйБП30";
	ИначеЕсли Не ЗначениеЗаполнено(__ИдентификаторИнтеграции) Тогда
		ВызватьИсключение "Не указан идентификатор интеграции";
	Иначе
		ВызватьИсключение __СтдСтр.СтрШаблонЛок("Неожиданное значение идентификатора интеграции ('%1')",
			__ИдентификаторИнтеграции);
	КонецЕсли;
	
	Если ЭтоВнешняяОбработкаЛок() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадок" + ИмяИМ);
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадок" + ИмяИМ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура _ПроверитьПараметры(Параметр1 = Неопределено, Параметр2 = Неопределено, // BSLLS:NumberOfOptionalParams-off
		Параметр3 = Неопределено, Параметр4 = Неопределено,
		Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено)
	
	Ошибка = ОшибкаПараметра(Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7);
	Если Ошибка <> Неопределено Тогда
		ВызватьИсключение Ошибка.Описание;
	КонецЕсли;
	
КонецПроцедуры // ПроверитьПараметры

Функция НесоответствиеТипов(Значение, ОписаниеТипов) // BSLLS:DuplicateStringLiteral-off
	
	// Проверка типа
	
	Если ТипЗнч(ОписаниеТипов) = Тип("Строка") Тогда
		ТипыСтрокой = __СтдСтр.СтрРазделитьЛок(ОписаниеТипов, ",");
		ТипыМассив = Новый Массив;
		Для Каждого Элемент Из ТипыСтрокой Цикл
			ТипыМассив.Добавить(Тип(СокрЛП(Элемент)));
		КонецЦикла;
		ОписаниеТипов_ = Новый ОписаниеТипов(ТипыМассив);
	Иначе
		ОписаниеТипов_ = ОписаниеТипов;
	КонецЕсли;
	
	Если НЕ ОписаниеТипов_.СодержитТип(ТипЗнч(Значение)) Тогда
		Ошибка = ОшибкаТипа();
	Иначе
		Ошибка = Неопределено;
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции

Функция НеЗаполнено(Значение)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Ошибка = ОшибкаЗначения();
	Иначе
		Ошибка = Неопределено;
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции // НеЗаполнено

Функция ОшибкаЛок()
	
	Возврат Новый Структура("Описание");
	
КонецФункции // Ошибка

Функция ОшибкаТипа()
	
	Ошибка = ОшибкаЛок();
	Ошибка.Описание = НСтр("ru = 'Несоответствие типов'; sys = 'TypeError'");
	
	Возврат Ошибка;
	
КонецФункции // ОшибкаТипа

Функция ОшибкаЗначения()
	
	Ошибка = ОшибкаЛок();
	Ошибка.Описание = НСтр("ru = 'Недопустимое значение параметра'; sys = 'ValueError'");
	
	Возврат Ошибка;
	
КонецФункции // ОшибкаЗначения

Функция ОшибкаПараметра(Параметр1 = Неопределено, Параметр2 = Неопределено, // BSLLS:NumberOfOptionalParams-off
		Параметр3 = Неопределено, Параметр4 = Неопределено,
		Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено)
	
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр1);
	Параметры.Добавить(Параметр2);
	Параметры.Добавить(Параметр3);
	Параметры.Добавить(Параметр4);
	Параметры.Добавить(Параметр5);
	Параметры.Добавить(Параметр6);
	Параметры.Добавить(Параметр7);
	
	Шаблон = "ru = ' (параметр номер %1)'";
	
	Для Сч = 0 По Параметры.ВГраница() Цикл
		
		Параметр = Параметры[Сч];
		Если Параметр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Параметр.Описание = Параметр.Описание + НСтр(СтрЗаменить(Шаблон, "%1", Строка(Сч + 1)));
		
		Возврат Параметр;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции // ОшибкаПараметра

////////////////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ

Процедура __Инит__()
	
	// BSLLS:UnusedLocalVariable-off
	__ЭтоВнешняяОбработка = ЭтоВнешняяОбработкаЛок();
	__СтдСтр = СтдСтр();
	Конфигурации = МаркерыКонфигураций();
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры

__Инит__();