
//{		ПРОГРАММНЫЙ ИНТЕРФЕЙС

// BSLLS:UnusedLocalVariable-off
&НаСервере
Перем _ОбработкаОбъект;
// BSLLS:MissingVariablesDescription-on

// Получает объект текущей обработки
// 
// Возвращаемое значение:
//  ОбработкаОбъект
//
&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

// BSLLS:MissingReturnedValueDescription-off

// Открывает форму просмотра сведений о маркировке
//
// Параметры:
//  ФормаВызова		 - Форма	 - Форма, из которой происходит вызов
//  ДокументыУчета	 - Массив	 - Коллекция ссылок на учетные документы пакета
//
&НаКлиенте
Функция ОткрытьСостояниеМаркировки(ФормаВызова, ДокументыУчета) Экспорт
	
	Результат = "";
	
	ОбщийМодульКонтурМаркировка = ОбщийМодульКонтурМаркировкиКлиент();
	
	ИспользуетсяКонтурМаркировка318 = ИспользуетсяКонтурМаркировка318();
	
	ВызывающийМодуль = ИмяВызывающегоМодуляДляКонтурМаркировки();
	
	Если ИспользуетсяКонтурМаркировка318 И ОбщийМодульКонтурМаркировка <> Неопределено Тогда
		
		Попытка
			
			ОбщийМодульКонтурМаркировка.МодульМаркировкиКлиент().ОткрытьСостояниеМаркировки(ФормаВызова,
			ДокументыУчета, ВызывающийМодуль);
			
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЖурналРегистрации_ЗаписатьОшибку("ОткрытьСведенияОМаркировке", ТекстОшибки);
			
			Результат = ТекстОшибки;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
// BSLLS:MissingReturnedValueDescription-on
//}		ПРОГРАММНЫЙ ИНТЕРФЕЙС

&НаСервере
Функция ИспользуетсяКонтурМаркировка318()
	
	РаботаСМаркировкой = ОбработкаОбъект();
	
	Результат = РаботаСМаркировкой.ИспользуетсяКонтурМаркировка318();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИмяВызывающегоМодуляДляКонтурМаркировки()
	Возврат "diadoc_um";
КонецФункции

&НаКлиенте
Функция ИмяМодуляИнтеграцииКлиент()
	
	Возврат "ВзаимодействиеКонтурМаркировкаКлиент";
	
КонецФункции

&НаКлиенте
Функция ОбщийМодульКонтурМаркировкиКлиент()
	
	ИмяМодуля = ИмяМодуляИнтеграцииКлиент();
	
	Результат = Вычислить(ИмяМодуля);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЖурналРегистрации_ЗаписатьОшибку(Знач ИмяСобытия, Знач Комментарий)
	
	ИдентификаторСобытия = "Диадок.ИнтеграцияСМаркировкой." + ИмяСобытия;
	
	ЗаписьЖурналаРегистрации(
		ИдентификаторСобытия,
		УровеньЖурналаРегистрации.Ошибка,
		Неопределено,
		Неопределено,
		Комментарий
	);
	
КонецПроцедуры