// ОПИСАНИЕ ПЕРЕМЕННЫХ

// Кэш клиент
&НаКлиенте
Перем
КлиентскиеМетодыКэш,
ОписаниеОповещенияЗакрытияЛок;

// Кэш
&НаСервере
Перем
МенеджерКэш;

////////////////////////////////////////////////////////////////////////////////
// ИНТЕРФЕЙС

&НаКлиенте
Процедура НачатьОткрытие(ОписаниеОповещения) Экспорт
	
	ОписаниеОповещенияЗакрытияЛок = ОписаниеОповещения;
	РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	
	Открыть();
		
КонецПроцедуры

// УСТАНОВЩИКИ

// Устанавливает свойство формы для использования указанной конфигурации приложения.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Конфигурация приложения.
//                                     См. КлиентскиеМетоды.МодельКонфигурацияПриложения.
//
&НаКлиенте
Процедура УстановитьКонфигурациюПриложения(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки конфигурации приложения: ожидалась структура или фиксированная структура";	
	КонецЕсли; 
	
	КлиентскиеМетоды().ПроверитьКонфигурациюПриложения(Значение);
	
	КонфигурацияПриложения = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для использования указанной конфигурации обновлятора.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Конфигурация обновлятора.
//                                     См. КлиентскиеМетоды.МодельКонфигурацияОбновлятора.
//
&НаКлиенте
Процедура УстановитьКонфигурациюОбновлятора(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки конфигурации обновлятора: ожидалась структура или фиксированная структура";	
	КонецЕсли;
	
	КонфигурацияОбновлятора = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для использования указанного объекта метаданных в качестве хранилища плагинов.
//
// Параметры:
//  Значение - Строка - Имя объекта метаданных, используемого как хранилище сессий.
//                     Допустимые значения: "Обработка", "Справочник", "РегистрСведений", "ОбщийМодуль".
//
&НаКлиенте
Процедура УстановитьХранилищеПлагинов(Значение) Экспорт

	Если Значение = Неопределено Тогда
		ВызватьИсключение "Ошибка установки хранилища плагинов: Неопределенный тип хранилища плагинов";	
	КонецЕсли;
	
	ХранилищеПлагинов = Значение;	
	
КонецПроцедуры

// Устанавливает свойство формы для настроек прокси
//
// Параметры:
//  Значение - Структура, ФиксированнаяСтруктура - см КоннекторHTTP.СоздатьНастройкиПрокси.
//
&НаКлиенте
Процедура УстановитьНастройкиПрокси(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);	
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки прокси: ожидалась структура или фиксированная структура";	
	КонецЕсли;
	
	НастройкиПрокси = Значение;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект_ = Объект_();
	ЭтоВнешняяОбработка = Объект_._ЭтоВнешняяОбработка();
	
	ТекущееПолеСортировки = "Синоним";
	ТекущееНаправлениеСортировки = "Возр";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОбновитьСписокПлагинов", Интервал01(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	КлиентскиеМетоды()._Стд().ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияЗакрытияЛок, Истина);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура СортироватьНаименование(Команда)
	
	Если ТекущееПолеСортировки = "Синоним" И ТекущееНаправлениеСортировки = "Возр" Тогда
		Направление = "Убыв";
	Иначе
		Направление = "Возр";
	КонецЕсли;
	
	СортироватьТаблицуПлагинов("Синоним", Направление);
	
КонецПроцедуры

&НаКлиенте
Процедура СортироватьДатаОбновления(Команда)
	
	Если ТекущееПолеСортировки = "ДатаОбновления" И ТекущееНаправлениеСортировки = "Убыв" Тогда
		Направление = "Возр";
	Иначе
		Направление = "Убыв";
	КонецЕсли;
	
	СортироватьТаблицуПлагинов("ДатаОбновления", Направление);
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаПлагинов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьНаСервере();
	ПротестироватьПлагинНаСервере();
	ПодключитьОбработчикОжидания("ОбновитьСписокПлагинов", Интервал01(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подробнее(Команда)
	
	ПерейтиПоНавигационнойСсылке(Элементы.ТаблицаПлагинов.ТекущиеДанные.АдресДокументации);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТаблицаПлагиновПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Элементы.ГруппаИнформация.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаИнформация.Видимость = Истина;
	Элементы.ДекорацияНаименование.Заголовок = Элемент.ТекущиеДанные.Синоним;
	Элементы.ДекорацияОписание.Заголовок = Элемент.ТекущиеДанные.Описание;
	Элементы.Подробнее.Видимость = ЗначениеЗаполнено(Элемент.ТекущиеДанные.АдресДокументации);
	
	Элементы.Загружен.Видимость = Элемент.ТекущиеДанные.Загружен;
	Элементы.Загрузить.Видимость = Не Элемент.ТекущиеДанные.Загружен;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// ЗАВИСИМОСТИ

&НаКлиенте
Функция КлиентскиеМетоды()

	Если КлиентскиеМетодыКэш = Неопределено Тогда
		Если ЭтоВнешняяОбработка Тогда
			// BSLLS:GetFormMethod-off
			КлиентскиеМетодыКэш = ПолучитьФорму("ВнешняяОбработка.КонтурДиадокМенеджерПлагинов.Форма.КлиентскиеМетоды");
			// BSLLS:GetFormMethod-on
		Иначе
			// BSLLS:GetFormMethod-off
			КлиентскиеМетодыКэш = ПолучитьФорму("Обработка.КонтурДиадокМенеджерПлагинов.Форма.КлиентскиеМетоды");	
			// BSLLS:GetFormMethod-on
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат КлиентскиеМетодыКэш;
	
КонецФункции

&НаСервере
Функция Объект_()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат Объект;
	#Иначе
		Возврат РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
КонецФункции

&НаСервере
Функция Менеджер()
	
	Если МенеджерКэш = Неопределено Тогда
		
		МенеджерКэш = Объект_();
		МенеджерКэш.УстановитьКонфигурациюПриложения(КонфигурацияПриложения);
		МенеджерКэш.УстановитьКонфигурациюОбновлятора(КонфигурацияОбновлятора);
		Если ЗначениеЗаполнено(ХранилищеПлагинов) Тогда
			МенеджерКэш.УстановитьХранилищеПлагинов(ХранилищеПлагинов);
		Иначе
			МенеджерКэш.УстановитьХранилищеПлагинов();
		КонецЕсли;
		Если НастройкиПрокси <> Неопределено Тогда
			МенеджерКэш.УстановитьНастройкиПрокси(НастройкиПрокси);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МенеджерКэш;
	
КонецФункции

// ПРОЧЕЕ

&НаКлиенте
Процедура ОбновитьСписокПлагинов()
	
	ОбновитьСписокПлагиновНаСервере();                                                                                   
	СортироватьТаблицуПлагинов(ТекущееПолеСортировки, ТекущееНаправлениеСортировки);
	
КонецПроцедуры

&НаКлиенте
Процедура СортироватьТаблицуПлагинов(Поле, Направление)
	
	ТаблицаПлагинов.Сортировать(КлиентскиеМетоды()._Стд().Стр().СтрШаблонЛок("%1 %2", Поле, Направление));
	
	Шаблон = "Картинка_Сортировка%1";
	Элементы.ГруппаСортировкаПлагинов.Картинка = 
		Элементы[КлиентскиеМетоды()._Стд().Стр().СтрШаблонЛок(Шаблон, Направление)].Картинка;
	
	Если Поле = "Синоним" Тогда
		Элементы.ГруппаСортировкаПлагинов.Заголовок = "По наименованию";
	Иначе
		Элементы.ГруппаСортировкаПлагинов.Заголовок = "По дате обновления";
	КонецЕсли;
	
	ТекущееПолеСортировки = Поле;
	ТекущееНаправлениеСортировки = Направление;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокПлагиновНаСервере()
	
	Плагины = Менеджер().Список();
	
	Отбор = Менеджер().ХранилищеПлагинов().МодельОтборСписка();
	Отбор.Проект = КонфигурацияПриложения.Имя;
	ЗагруженныеПлагины = Менеджер().ХранилищеПлагинов().Список(Отбор);
	
	Для Каждого Элемент Из ЗагруженныеПлагины Цикл
		Элемент.Ид = Нрег(Элемент.Ид);	
	КонецЦикла;
	
	ТаблицаПлагинов.Очистить();
	
	Для Каждого Элемент Из Плагины.Список Цикл
		
		Если ЗначениеЗаполнено(Элемент.Версия) = Ложь Тогда
			 Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПлагинов.Добавить();
		НоваяСтрока.Ид = Элемент.Ид;
		НоваяСтрока.Версия = Элемент.Версия;
		НоваяСтрока.Синоним = Элемент.Синоним;
		НоваяСтрока.Описание = Элемент.Описание;
		НоваяСтрока.АдресДокументации = Элемент.АдресДокументации;
		НоваяСтрока.ДатаОбновления = Элемент.ДатаОбновления;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Ид", Нрег(Элемент.Ид));
		
		НоваяСтрока.Загружен = ЗагруженныеПлагины.НайтиСтроки(Отбор).Количество() > 0; 
		НоваяСтрока.ЗагруженКартинка = Не НоваяСтрока.Загружен;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	ОписаниеПлагина = ОписаниеПлагина();
	
	Менеджер().Установить(ОписаниеПлагина);
	
КонецПроцедуры

&НаСервере
Процедура ПротестироватьПлагинНаСервере()
	
	ОписаниеПлагина = ОписаниеПлагина();
	Менеджер().ПротестироватьПлагин(ОписаниеПлагина);
	
КонецПроцедуры

&НаСервере
Функция ОписаниеПлагина()
	
	ТекущиеДанные = ТаблицаПлагинов.НайтиПоИдентификатору(Элементы.ТаблицаПлагинов.ТекущаяСтрока);
	
	Результат = Менеджер().МодельОписаниеПлагина();
	Результат.Ид = ТекущиеДанные.Ид;
	Результат.Версия = ТекущиеДанные.Версия;                                                  
	Результат.Представление = ТекущиеДанные.Синоним;          
	Результат.ТипКонтента = ТипКонтентаОбработка();
	Результат.Проект = КонфигурацияПриложения.Имя;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипКонтентаОбработка()
	
	Возврат "data-processor";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Интервал01()
	
	Возврат 0.1;
	
КонецФункции