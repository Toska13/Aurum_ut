#Область МониторФормы

Функция ПостроитьТабличныйДокументМонитора(Состояние, ЗаказКлиента)

	ТаблицаСтрок = ПодготовитьТаблицуСтрокОтчета(Состояние, ЗаказКлиента);
	Макет = Отчеты.АУ_КонтрольЗаказовКлиентов.ПолучитьМакет("МакетМонитора");
	ПараметрыШапки = Новый Структура("ЗаказКлиента, ДатаРасчета", ЗаказКлиента, Состояние.ДатаРасчета);

	Возврат СформироватьТабличныйДокументПоМакету(ТаблицаСтрок, ПараметрыШапки, Макет);

КонецФункции

Функция СформироватьТабличныйДокументПоМакету(ТаблицаСтрок, ПараметрыШапки, Макет)

	ТабДок = Новый ТабличныйДокумент;
	ОбластьШапкиОтчета = Макет.ПолучитьОбласть("Отчет_Шапка");
	ОбластьШапкиОтчета.Параметры.Заполнить(ПараметрыШапки);
	ТабДок.Вывести(ОбластьШапкиОтчета);
	ТабДок.ФиксацияСверху = ТабДок.ВысотаТаблицы;

	ПоследнийФормат = "";
	ПоследнийРодитель = Неопределено;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		СменаБлока = (СтрокаОтчета.ИмяФормата <> ПоследнийФормат)
			Или (СтрокаОтчета.Родитель <> ПоследнийРодитель);

		Если СменаБлока Тогда

			ВывестиКоннекторы(ТабДок, Макет, СтрокаОтчета);
			ПрисоединитьБлокФормата(ТабДок, Макет, СтрокаОтчета, Истина);
			ПоследнийФормат = СтрокаОтчета.ИмяФормата;
			ПоследнийРодитель = СтрокаОтчета.Родитель;

		КонецЕсли;

		ВывестиКоннекторы(ТабДок, Макет, СтрокаОтчета);
		ПрисоединитьБлокФормата(ТабДок, Макет, СтрокаОтчета, Ложь);

	КонецЦикла;

	Возврат ТабДок;

КонецФункции

Процедура ВывестиКоннекторы(ТабДок, Макет, СтрокаОтчета)

	Уровень = СтрокаОтчета.УровеньВложенности;

	Если Уровень <= 0 Тогда

		Возврат;

	КонецЕсли;

	Флаги = СтрокаОтчета.ФлагиВертикалиПредков;

	Для ИндексУровня = 1 По Уровень Цикл

		Если ИндексУровня < Уровень Тогда

			ЕстьВертикаль = (ИндексУровня <= СтрДлина(Флаги) И Сред(Флаги, ИндексУровня, 1) = "1");
			ИмяОбласти = ?(ЕстьВертикаль, "КоннекторВерхНиз", "Отступ");

		ИначеЕсли СтрокаОтчета.ЭтоПоследнийСредиБратьев Тогда

			ИмяОбласти = "КоннекторВерхПраво";

		Иначе

			ИмяОбласти = "КоннекторВерхПравоНиз";

		КонецЕсли;

		ОбластьКоннектора = Макет.ПолучитьОбласть(ИмяОбласти);

		Если ИндексУровня = 1 Тогда

			ТабДок.Вывести(ОбластьКоннектора);

		Иначе

			ТабДок.Присоединить(ОбластьКоннектора);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПрисоединитьБлокФормата(ТабДок, Макет, СтрокаОтчета, ЭтоШапка)

	ИмяОбласти = ИмяМакетаФормата(СтрокаОтчета.ИмяФормата, ЭтоШапка);
	ОбластьФормата = Макет.ПолучитьОбласть(ИмяОбласти);

	Если Не ЭтоШапка Тогда

		ОбластьФормата.Параметры.Заполнить(СтрокаОтчета);

	КонецЕсли;

	Если СтрокаОтчета.УровеньВложенности <= 0 Тогда

		ТабДок.Вывести(ОбластьФормата);

	Иначе

		ТабДок.Присоединить(ОбластьФормата);

	КонецЕсли;

КонецПроцедуры

Функция ИмяМакетаФормата(ИмяФормата, ЭтоШапка)

	Суффикс = ?(ЭтоШапка, "_Шапка", "_Строка");
	Префиксы = Новый Соответствие;
	Префиксы.Вставить("Ур1_Заказ", "Ур1");
	Префиксы.Вставить("Ур2_Позиция_Закупка", "Ур2З");
	Префиксы.Вставить("Ур2_Позиция_Сборка", "Ур2С");
	Префиксы.Вставить("Ур2_Позиция_СоСклада", "Ур2Ск");
	Префиксы.Вставить("Ур2_НеСвязанные", "Ур2С");
	Префиксы.Вставить("Ур3Т_ЗнС", "Ур3Т_ЗнС");
	Префиксы.Вставить("Ур3Т_ЗП", "Ур3Т_ЗП");
	Префиксы.Вставить("Ур3Т_РТУ", "Ур3Т_РТУ");
	Префиксы.Вставить("Ур3О_ОплатаКлиента", "Ур3О");
	Префиксы.Вставить("Ур3П_Заголовок", "Ур3П");
	Префиксы.Вставить("Ур4П_Заявка", "Ур4П");
	Префиксы.Вставить("Ур5П_Списание", "Ур5П");
	Префиксы.Вставить("Ур4С_Себестоимость", "Ур4С");
	Префиксы.Вставить("Ур4Т_ПТУ", "Ур4Т_ПТУ");
	Префиксы.Вставить("Ур4Т_ЗПКомпл", "Ур4Т_ЗП");
	Префиксы.Вставить("Ур5Т_ПТУ", "Ур5Т_ПТУ");
	Префиксы.Вставить("Ур6Т_ПО", "Ур6Т_ПО");
	Префиксы.Вставить("Ур7ШК_Приемка", "Ур7ШК");
	Префиксы.Вставить("Ур7Т_Сборка", "Ур7Т_Сборка");
	Префиксы.Вставить("Ур8Т_РТУ", "Ур8Т_РТУ");
	Префиксы.Вставить("Ур9Т_РО", "Ур9Т_РО");
	Префиксы.Вставить("Ур10ШК_Отгрузка", "Ур10ШК");

	Префикс = Префиксы.Получить(ИмяФормата);

	Если Префикс = Неопределено Тогда

		Префикс = "Ур1";

	КонецЕсли;

	Возврат Префикс + Суффикс;

КонецФункции

Функция СобратьТаблицуСтрокОтчетаМонитора(Состояние, ЗаказКлиента)

	ТаблицаСтрок = НоваяТаблицаСтрокОтчета();
	Контекст = Новый Структура;
	Контекст.Вставить("ТаблицаСтрок", ТаблицаСтрок);
	Контекст.Вставить("Состояние", Состояние);
	Контекст.Вставить("ЗаказКлиента", ЗаказКлиента);
	Контекст.Вставить("Счетчик", 0);
	Контекст.Вставить("ЗаявленоПоЗаявкам", ТаблицаЗаявленоПоЗаявкамЦепочки(Состояние.Дерево));
	Контекст.Вставить("ОплатыПоШифрам", ТаблицаОплатПоШифрамЗаказа(ЗаказКлиента));
	Контекст.Вставить("ИндексШтрихкодов", ИндексФактовШтрихкодов(Состояние.ШтрихкодыУпаковок));

	ИдентификаторЗаказа = НовыйИдентификаторСтрокиОтчета(Контекст);
	СтрокаЗаказа = ДобавитьСтрокуОтчета(Контекст, "", ИдентификаторЗаказа, 0, "Ур1_Заказ", Строка(ЗаказКлиента), ЗаказКлиента);
	ЗаполнитьИтогиЗаказаВСтрокеОтчета(СтрокаЗаказа, Состояние.СтрокиЗаказа);

	УзелЗаказа = НайтиУзелЗаказаВДереве(Состояние.Дерево);

	Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

		ИдентификаторПозиции = НовыйИдентификаторСтрокиОтчета(Контекст);
		ПредставлениеПозиции = Строка(СтрокаФактов.Номенклатура) + " / " + Строка(СтрокаФактов.Характеристика);
		СтрокаПозиции = ДобавитьСтрокуОтчета(
			Контекст,
			ИдентификаторЗаказа,
			ИдентификаторПозиции,
			1,
			ИмяФорматаПозицииОтчета(СтрокаФактов.ПутьОбеспечения),
			ПредставлениеПозиции,
			Неопределено);
		ЗаполнитьФактыПозицииВСтрокеОтчета(СтрокаПозиции, СтрокаФактов);

		Если УзелЗаказа <> Неопределено Тогда

			ЯкоряПозиции = ЯкоряДокументовПозицииМонитора(Состояние, СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика);
			ДобавитьУзлыДереваВОтчет(
				Контекст,
				УзелЗаказа.Строки,
				Новый Массив,
				ЯкоряПозиции,
				СтрокаФактов,
				ИдентификаторПозиции,
				1,
				Новый Соответствие,
				СтрокаФактов.ПутьОбеспечения);

		КонецЕсли;

	КонецЦикла;

	Если Состояние.ЕстьСироты И УзелЗаказа <> Неопределено Тогда

		УзелНеСвязанные = НайтиУзелДереваПоТипуМонитора(УзелЗаказа.Строки, "НеСвязанные");

		Если УзелНеСвязанные <> Неопределено Тогда

			ИдентификаторГруппы = НовыйИдентификаторСтрокиОтчета(Контекст);
			ДобавитьСтрокуОтчета(Контекст, ИдентификаторЗаказа, ИдентификаторГруппы, 1, "Ур2_НеСвязанные", "Не связанные", Неопределено);

			Для Каждого СтрокаСироты Из УзелНеСвязанные.Строки Цикл

				Если Не ЗначениеЗаполнено(СтрокаСироты.Ссылка)
					Или СтрокаСироты.Тип = "ШтрихкодыУпаковокТоваров" Тогда

					Продолжить;

				КонецЕсли;

				ИдентификаторСироты = НовыйИдентификаторСтрокиОтчета(Контекст);
				ДобавитьСтрокуОтчета(
					Контекст,
					ИдентификаторГруппы,
					ИдентификаторСироты,
					2,
					"Ур2_НеСвязанные",
					ПредставлениеУзлаМонитора(СтрокаСироты),
					СтрокаСироты.Ссылка);

			КонецЦикла;

		КонецЕсли;

	КонецЕсли;

	ЗаполнитьКонтрагентовСтрокОтчета(ТаблицаСтрок);
	ПроставитьФлагиКоннекторовОтчета(ТаблицаСтрок);

	Возврат ТаблицаСтрок;

КонецФункции

Функция НоваяТаблицаСтрокОтчета()

	ТаблицаСтрок = Новый ТаблицаЗначений;
	ОписаниеСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ОписаниеКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ТаблицаСтрок.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	ТаблицаСтрок.Колонки.Добавить("Родитель", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	ТаблицаСтрок.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	ТаблицаСтрок.Колонки.Добавить("УровеньВложенности", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	ТаблицаСтрок.Колонки.Добавить("ИмяФормата", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	ТаблицаСтрок.Колонки.Добавить("ЭтоШапка", Новый ОписаниеТипов("Булево"));
	ТаблицаСтрок.Колонки.Добавить("УчитыватьВИтогах", Новый ОписаниеТипов("Булево"));
	ТаблицаСтрок.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	ТаблицаСтрок.Колонки.Добавить("Ссылка");
	ТаблицаСтрок.Колонки.Добавить("Контрагент");
	ТаблицаСтрок.Колонки.Добавить("Договор");
	ТаблицаСтрок.Колонки.Добавить("Номенклатура");
	ТаблицаСтрок.Колонки.Добавить("Характеристика");
	ТаблицаСтрок.Колонки.Добавить("СуммаЗаказано", ОписаниеСуммы);
	ТаблицаСтрок.Колонки.Добавить("ОплаченоКлиентом", ОписаниеСуммы);
	ТаблицаСтрок.Колонки.Добавить("Заявлено", ОписаниеСуммы);
	ТаблицаСтрок.Колонки.Добавить("ОплаченоПоставщику", ОписаниеСуммы);
	ТаблицаСтрок.Колонки.Добавить("СуммаСебестоимости", ОписаниеСуммы);
	ТаблицаСтрок.Колонки.Добавить("Прибыль", ОписаниеСуммы);
	ТаблицаСтрок.Колонки.Добавить("Заказано", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("Реализовано", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ОтгруженоОрдером", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ЗаказаноПоставщику", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("Приобретено", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ПринятоОрдером", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ОсталосьЗаказать", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ВСборке", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("Собрано", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ОсталосьСобрать", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("Принято", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("Отгружено", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("Остаток", ОписаниеКоличества);
	ТаблицаСтрок.Колонки.Добавить("ЭтоПоследнийСредиБратьев", Новый ОписаниеТипов("Булево"));
	ТаблицаСтрок.Колонки.Добавить("ФлагиВертикалиПредков", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));

	Возврат ТаблицаСтрок;

КонецФункции

Функция НовыйИдентификаторСтрокиОтчета(Контекст)

	Контекст.Счетчик = Контекст.Счетчик + 1;

	Возврат Формат(Контекст.Счетчик, "ЧГ=0");

КонецФункции

Функция ДобавитьСтрокуОтчета(Контекст, Родитель, Идентификатор, Уровень, ИмяФормата, Представление, Ссылка)

	СтрокаОтчета = Контекст.ТаблицаСтрок.Добавить();
	СтрокаОтчета.Идентификатор = Идентификатор;
	СтрокаОтчета.Родитель = Родитель;
	СтрокаОтчета.Порядок = Контекст.ТаблицаСтрок.Количество();
	СтрокаОтчета.УровеньВложенности = Уровень;
	СтрокаОтчета.ИмяФормата = ИмяФормата;
	СтрокаОтчета.УчитыватьВИтогах = Истина;
	СтрокаОтчета.Представление = Представление;
	СтрокаОтчета.Ссылка = Ссылка;

	Если ИмяФормата = "Ур4П_Заявка" Или ИмяФормата = "Ур5П_Списание"
		Или ИмяФормата = "Ур7ШК_Приемка" Или ИмяФормата = "Ур10ШК_Отгрузка" Тогда

		СтрокаОтчета.УчитыватьВИтогах = Ложь;

	КонецЕсли;

	Возврат СтрокаОтчета;

КонецФункции

Функция ИмяФорматаПозицииОтчета(ПутьОбеспечения)

	Если ПутьОбеспечения = "Сборка" Тогда

		Возврат "Ур2_Позиция_Сборка";

	ИначеЕсли ПутьОбеспечения = "СоСклада" Тогда

		Возврат "Ур2_Позиция_СоСклада";

	КонецЕсли;

	Возврат "Ур2_Позиция_Закупка";

КонецФункции

Процедура ЗаполнитьИтогиЗаказаВСтрокеОтчета(СтрокаЗаказа, СтрокиЗаказа)

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		СтрокаЗаказа.СуммаЗаказано = СтрокаЗаказа.СуммаЗаказано + СтрокаФактов.СуммаЗаказано;
		СтрокаЗаказа.ОплаченоКлиентом = СтрокаЗаказа.ОплаченоКлиентом + СтрокаФактов.ОплаченоКлиентом;
		СтрокаЗаказа.Заявлено = СтрокаЗаказа.Заявлено + СтрокаФактов.Заявлено;
		СтрокаЗаказа.ОплаченоПоставщику = СтрокаЗаказа.ОплаченоПоставщику + СтрокаФактов.ОплаченоПоставщику;
		СтрокаЗаказа.СуммаСебестоимости = СтрокаЗаказа.СуммаСебестоимости + СтрокаФактов.СуммаСебестоимости;
		СтрокаЗаказа.Прибыль = СтрокаЗаказа.Прибыль + СтрокаФактов.Прибыль;
		СтрокаЗаказа.Заказано = СтрокаЗаказа.Заказано + СтрокаФактов.Заказано;
		СтрокаЗаказа.Реализовано = СтрокаЗаказа.Реализовано + СтрокаФактов.Реализовано;
		СтрокаЗаказа.ОтгруженоОрдером = СтрокаЗаказа.ОтгруженоОрдером + СтрокаФактов.ОтгруженоОрдером;
		СтрокаЗаказа.ЗаказаноПоставщику = СтрокаЗаказа.ЗаказаноПоставщику + СтрокаФактов.ЗаказаноПоставщику;
		СтрокаЗаказа.Приобретено = СтрокаЗаказа.Приобретено + СтрокаФактов.Приобретено;
		СтрокаЗаказа.ПринятоОрдером = СтрокаЗаказа.ПринятоОрдером + СтрокаФактов.ПринятоОрдером;
		СтрокаЗаказа.ВСборке = СтрокаЗаказа.ВСборке + СтрокаФактов.ВСборке;
		СтрокаЗаказа.Собрано = СтрокаЗаказа.Собрано + СтрокаФактов.Собрано;

	КонецЦикла;

	СтрокаЗаказа.ОсталосьЗаказать = Макс(0, СтрокаЗаказа.Заказано - СтрокаЗаказа.ЗаказаноПоставщику);
	СтрокаЗаказа.ОсталосьСобрать = Макс(0, СтрокаЗаказа.ВСборке - СтрокаЗаказа.Собрано);

КонецПроцедуры

Процедура ЗаполнитьФактыПозицииВСтрокеОтчета(СтрокаПозиции, СтрокаФактов)

	СтрокаПозиции.Номенклатура = СтрокаФактов.Номенклатура;
	СтрокаПозиции.Характеристика = СтрокаФактов.Характеристика;
	СтрокаПозиции.СуммаЗаказано = СтрокаФактов.СуммаЗаказано;
	СтрокаПозиции.ОплаченоКлиентом = СтрокаФактов.ОплаченоКлиентом;
	СтрокаПозиции.Заявлено = СтрокаФактов.Заявлено;
	СтрокаПозиции.ОплаченоПоставщику = СтрокаФактов.ОплаченоПоставщику;
	СтрокаПозиции.СуммаСебестоимости = СтрокаФактов.СуммаСебестоимости;
	СтрокаПозиции.Прибыль = СтрокаФактов.Прибыль;
	СтрокаПозиции.Заказано = СтрокаФактов.Заказано;
	СтрокаПозиции.Реализовано = СтрокаФактов.Реализовано;
	СтрокаПозиции.ОтгруженоОрдером = СтрокаФактов.ОтгруженоОрдером;
	СтрокаПозиции.ЗаказаноПоставщику = СтрокаФактов.ЗаказаноПоставщику;
	СтрокаПозиции.Приобретено = СтрокаФактов.Приобретено;
	СтрокаПозиции.ПринятоОрдером = СтрокаФактов.ПринятоОрдером;
	СтрокаПозиции.ВСборке = СтрокаФактов.ВСборке;
	СтрокаПозиции.Собрано = СтрокаФактов.Собрано;
	СтрокаПозиции.ОсталосьЗаказать = Макс(0, СтрокаФактов.Заказано - СтрокаФактов.ЗаказаноПоставщику);
	СтрокаПозиции.ОсталосьСобрать = Макс(0, СтрокаФактов.ВСборке - СтрокаФактов.Собрано);

КонецПроцедуры

Процедура ДобавитьУзлыДереваВОтчет(
	Контекст,
	СтрокиДерева,
	ПутьДокументов,
	ЯкоряПозиции,
	СтрокаФактов,
	ИдентификаторРодителя,
	УровеньРодителя,
	УжеДобавленные,
	ПутьОбеспечения)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			ДобавитьУзлыДереваВОтчет(
				Контекст,
				СтрокаДерева.Строки,
				ПутьДокументов,
				ЯкоряПозиции,
				СтрокаФактов,
				ИдентификаторРодителя,
				УровеньРодителя,
				УжеДобавленные,
				ПутьОбеспечения);
			Продолжить;

		КонецЕсли;

		Если СтрокаДерева.Тип = "НеСвязанные" Тогда

			Продолжить;

		КонецЕсли;

		НовыйПуть = КопияМассиваПутиОтчета(ПутьДокументов);

		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			НовыйПуть.Добавить(СтрокаДерева.Ссылка);

		КонецЕсли;

		ИдентификаторУзла = ИдентификаторРодителя;
		УровеньУзла = УровеньРодителя;
		НужнаРекурсия = Истина;

		Если СтрокаДерева.Тип = "ШтрихкодыУпаковокТоваров" Тогда

			Если ДокументДереваОтноситсяКПозицииМонитора(СтрокаДерева, НовыйПуть, ЯкоряПозиции, СтрокаФактов) Тогда

				ИдентификаторУзла = ДобавитьУзелШтрихкодаВОтчет(
					Контекст,
					СтрокаДерева,
					ИдентификаторРодителя,
					УровеньРодителя + 1,
					ПутьДокументов);

			КонецЕсли;

		ИначеЕсли ДокументДереваОтноситсяКПозицииМонитора(СтрокаДерева, НовыйПуть, ЯкоряПозиции, СтрокаФактов)
			И ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			КлючДокумента = СтрокаДерева.Тип + "|" + Строка(СтрокаДерева.Ссылка.УникальныйИдентификатор());

			Если УжеДобавленные.Получить(КлючДокумента) = Неопределено Тогда

				УжеДобавленные.Вставить(КлючДокумента, Истина);
				ИдентификаторУзла = НовыйИдентификаторСтрокиОтчета(Контекст);
				УровеньУзла = УровеньРодителя + 1;
				ИмяФормата = ИмяФорматаУзлаДереваОтчета(СтрокаДерева.Тип, ПутьОбеспечения, УровеньУзла);
				СтрокаОтчета = ДобавитьСтрокуОтчета(
					Контекст,
					ИдентификаторРодителя,
					ИдентификаторУзла,
					УровеньУзла,
					ИмяФормата,
					ПредставлениеУзлаМонитора(СтрокаДерева),
					СтрокаДерева.Ссылка);
				ЗаполнитьKPIУзлаОтчета(Контекст, СтрокаОтчета, СтрокаДерева, СтрокаФактов);

				Если ИмяФормата = "Ур3Т_РТУ" И ПутьОбеспечения = "СоСклада" Тогда

					ИдентификаторСебестоимости = НовыйИдентификаторСтрокиОтчета(Контекст);
					СтрокаСебестоимости = ДобавитьСтрокуОтчета(
						Контекст,
						ИдентификаторУзла,
						ИдентификаторСебестоимости,
						УровеньУзла + 1,
						"Ур4С_Себестоимость",
						"Себестоимость отгрузки",
						Неопределено);
					СтрокаСебестоимости.СуммаСебестоимости = СтрокаФактов.СуммаСебестоимости;

				КонецЕсли;

			Иначе

				НужнаРекурсия = Ложь;

			КонецЕсли;

		КонецЕсли;

		Если НужнаРекурсия Тогда

			ДобавитьУзлыДереваВОтчет(
				Контекст,
				СтрокаДерева.Строки,
				НовыйПуть,
				ЯкоряПозиции,
				СтрокаФактов,
				ИдентификаторУзла,
				УровеньУзла,
				УжеДобавленные,
				ПутьОбеспечения);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ДобавитьУзелШтрихкодаВОтчет(Контекст, СтрокаДерева, ИдентификаторРодителя, Уровень, ПутьДокументов)

	ИдентификаторУзла = НовыйИдентификаторСтрокиОтчета(Контекст);
	ЭтоПриемка = ПутьСодержитТипМонитора("ПриходныйОрдерНаТовары", ПутьДокументов)
		Или ПутьСодержитТипМонитора("ПриобретениеТоваровУслуг", ПутьДокументов);
	ИмяФормата = ?(ЭтоПриемка, "Ур7ШК_Приемка", "Ур10ШК_Отгрузка");
	СтрокаОтчета = ДобавитьСтрокуОтчета(
		Контекст,
		ИдентификаторРодителя,
		ИдентификаторУзла,
		Уровень,
		ИмяФормата,
		ПредставлениеУзлаМонитора(СтрокаДерева),
		СтрокаДерева.Ссылка);
	ФактШтрихкода = Контекст.ИндексШтрихкодов.Получить(СтрокаДерева.Ссылка);

	Если ФактШтрихкода <> Неопределено Тогда

		СтрокаОтчета.Принято = ФактШтрихкода.Принято;
		СтрокаОтчета.Отгружено = ФактШтрихкода.Отгружено;
		СтрокаОтчета.Остаток = ФактШтрихкода.Остаток;

	КонецЕсли;

	Возврат ИдентификаторУзла;

КонецФункции

Функция ИмяФорматаУзлаДереваОтчета(ТипУзла, ПутьОбеспечения, Уровень)

	Если ТипУзла = "ЗаказНаСборку" Тогда

		Возврат "Ур3Т_ЗнС";

	ИначеЕсли ТипУзла = "ЗаказПоставщику" Тогда

		Если ПутьОбеспечения = "Сборка" Тогда

			Возврат "Ур4Т_ЗПКомпл";

		КонецЕсли;

		Возврат "Ур3Т_ЗП";

	ИначеЕсли ТипУзла = "ПриобретениеТоваровУслуг" Тогда

		Если ПутьОбеспечения = "Сборка" Тогда

			Возврат "Ур5Т_ПТУ";

		КонецЕсли;

		Возврат "Ур4Т_ПТУ";

	ИначеЕсли ТипУзла = "ПриходныйОрдерНаТовары" Тогда

		Возврат "Ур6Т_ПО";

	ИначеЕсли ТипУзла = "СборкаТоваров" Тогда

		Возврат "Ур7Т_Сборка";

	ИначеЕсли ТипУзла = "РеализацияТоваровУслуг" Тогда

		Если ПутьОбеспечения = "СоСклада" Тогда

			Возврат "Ур3Т_РТУ";

		КонецЕсли;

		Возврат "Ур8Т_РТУ";

	ИначеЕсли ТипУзла = "РасходныйОрдерНаТовары" Тогда

		Возврат "Ур9Т_РО";

	ИначеЕсли ТипУзла = "ЗаявкаНаРасходованиеДенежныхСредств" Тогда

		Возврат "Ур4П_Заявка";

	ИначеЕсли ТипУзла = "СписаниеБезналичныхДенежныхСредств"
		Или ТипУзла = "РасходныйКассовыйОрдер" Тогда

		Возврат "Ур5П_Списание";

	ИначеЕсли ТипУзла = "ПоступлениеБезналичныхДенежныхСредств"
		Или ТипУзла = "ПриходныйКассовыйОрдер" Тогда

		Возврат "Ур3О_ОплатаКлиента";

	КонецЕсли;

	Возврат "Ур1_Заказ";

КонецФункции

Процедура ЗаполнитьKPIУзлаОтчета(Контекст, СтрокаОтчета, СтрокаДерева, СтрокаФактов)

	ТипУзла = СтрокаДерева.Тип;
	Шифр = СтрокаФактов.Шифр;

	Если ТипУзла = "ЗаказНаСборку" Тогда

		СтрокаОтчета.ВСборке = СтрокаФактов.ВСборке;

	ИначеЕсли ТипУзла = "ЗаказПоставщику" Тогда

		СтрокаОтчета.ЗаказаноПоставщику = КоличествоФактаДокумента(
			Контекст.Состояние.ЗаказыПоставщику,
			"ЗаказПоставщику",
			СтрокаДерева.Ссылка,
			СтрокаФактов,
			"Заказано");

	ИначеЕсли ТипУзла = "ПриобретениеТоваровУслуг" Тогда

		СтрокаОтчета.Приобретено = СтрокаФактов.Приобретено;

	ИначеЕсли ТипУзла = "ПриходныйОрдерНаТовары" Тогда

		СтрокаОтчета.ПринятоОрдером = СтрокаФактов.ПринятоОрдером;

	ИначеЕсли ТипУзла = "СборкаТоваров" Тогда

		СтрокаОтчета.Собрано = СтрокаФактов.Собрано;

	ИначеЕсли ТипУзла = "РеализацияТоваровУслуг" Тогда

		СтрокаОтчета.Реализовано = СтрокаФактов.Реализовано;

	ИначеЕсли ТипУзла = "РасходныйОрдерНаТовары" Тогда

		СтрокаОтчета.ОтгруженоОрдером = СтрокаФактов.ОтгруженоОрдером;

	ИначеЕсли ТипУзла = "ЗаявкаНаРасходованиеДенежныхСредств" Тогда

		СтрокаОтчета.Заявлено = ЗаявленоПоЗаявкеИШифру(Контекст.ЗаявленоПоЗаявкам, СтрокаДерева.Ссылка, Шифр);

	ИначеЕсли ТипУзла = "СписаниеБезналичныхДенежныхСредств"
		Или ТипУзла = "РасходныйКассовыйОрдер" Тогда

		СтрокаОтчета.ОплаченоПоставщику = ОплаченоПоДокументуИШифру(
			Контекст.ОплатыПоШифрам,
			СтрокаДерева.Ссылка,
			Шифр,
			Ложь);

	ИначеЕсли ТипУзла = "ПоступлениеБезналичныхДенежныхСредств"
		Или ТипУзла = "ПриходныйКассовыйОрдер" Тогда

		СтрокаОтчета.ОплаченоКлиентом = ОплаченоПоДокументуИШифру(
			Контекст.ОплатыПоШифрам,
			СтрокаДерева.Ссылка,
			Шифр,
			Истина);

	КонецЕсли;

КонецПроцедуры

Функция КоличествоФактаДокумента(ТаблицаФактов, ИмяКолонкиДокумента, Документ, СтрокаФактов, ИмяРесурса)

	Отбор = Новый Структура(ИмяКолонкиДокумента + ",Номенклатура,Характеристика", Документ, СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика);
	Найденные = ТаблицаФактов.НайтиСтроки(Отбор);

	Если Найденные.Количество() = 0 Тогда

		Возврат СтрокаФактов[ИмяРесурса];

	КонецЕсли;

	Возврат Найденные[0][ИмяРесурса];

КонецФункции

Функция КопияМассиваПутиОтчета(ПутьДокументов)

	НовыйПуть = Новый Массив;

	Для Каждого ЭлементПути Из ПутьДокументов Цикл

		НовыйПуть.Добавить(ЭлементПути);

	КонецЦикла;

	Возврат НовыйПуть;

КонецФункции

Функция ИндексФактовШтрихкодов(ШтрихкодыУпаковок)

	Индекс = Новый Соответствие;

	Для Каждого СтрокаФактов Из ШтрихкодыУпаковок Цикл

		Индекс.Вставить(СтрокаФактов.ШтрихкодУпаковки, СтрокаФактов);

	КонецЦикла;

	Возврат Индекс;

КонецФункции

Процедура ЗаполнитьКонтрагентовСтрокОтчета(ТаблицаСтрок)

	СсылкиПоТипам = Новый Соответствие;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		Если Не ЗначениеЗаполнено(СтрокаОтчета.Ссылка) Тогда

			Продолжить;

		КонецЕсли;

		ИмяТипа = СтрокаОтчета.Ссылка.Метаданные().ПолноеИмя();
		СписокСсылок = СсылкиПоТипам.Получить(ИмяТипа);

		Если СписокСсылок = Неопределено Тогда

			СписокСсылок = Новый Массив;
			СсылкиПоТипам.Вставить(ИмяТипа, СписокСсылок);

		КонецЕсли;

		Если СписокСсылок.Найти(СтрокаОтчета.Ссылка) = Неопределено Тогда

			СписокСсылок.Добавить(СтрокаОтчета.Ссылка);

		КонецЕсли;

	КонецЦикла;

	РеквизитыПоСсылке = Новый Соответствие;
	ТипыСКонтрагентом = СтрРазделить(
		"Документ.ЗаказПоставщику,Документ.ПриобретениеТоваровУслуг,Документ.ЗаявкаНаРасходованиеДенежныхСредств,Документ.СписаниеБезналичныхДенежныхСредств,Документ.РасходныйКассовыйОрдер",
		",");

	Для Каждого ИмяТипа Из ТипыСКонтрагентом Цикл

		СписокСсылок = СсылкиПоТипам.Получить(ИмяТипа);

		Если СписокСсылок = Неопределено Или СписокСсылок.Количество() = 0 Тогда

			Продолжить;

		КонецЕсли;

		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокСсылок, "Контрагент, Договор");

		Для Каждого КлючИЗначение Из ЗначенияРеквизитов Цикл

			РеквизитыПоСсылке.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);

		КонецЦикла;

	КонецЦикла;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		Реквизиты = РеквизитыПоСсылке.Получить(СтрокаОтчета.Ссылка);

		Если Реквизиты = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаОтчета.Контрагент = Реквизиты.Контрагент;
		СтрокаОтчета.Договор = Реквизиты.Договор;

	КонецЦикла;

КонецПроцедуры

Процедура ПроставитьФлагиКоннекторовОтчета(ТаблицаСтрок)

	ДетиПоРодителю = Новый Соответствие;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		СписокДетей = ДетиПоРодителю.Получить(СтрокаОтчета.Родитель);

		Если СписокДетей = Неопределено Тогда

			СписокДетей = Новый Массив;
			ДетиПоРодителю.Вставить(СтрокаОтчета.Родитель, СписокДетей);

		КонецЕсли;

		СписокДетей.Добавить(СтрокаОтчета);

	КонецЦикла;

	ИндексПоИдентификатору = Новый Соответствие;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		ИндексПоИдентификатору.Вставить(СтрокаОтчета.Идентификатор, СтрокаОтчета);

	КонецЦикла;

	Для Каждого КлючИЗначение Из ДетиПоРодителю Цикл

		СписокДетей = КлючИЗначение.Значение;

		Для ИндексРебенка = 0 По СписокДетей.ВГраница() Цикл

			СписокДетей[ИндексРебенка].ЭтоПоследнийСредиБратьев = (ИндексРебенка = СписокДетей.ВГраница());

		КонецЦикла;

	КонецЦикла;

	Для Каждого СтрокаРебенка Из ТаблицаСтрок Цикл

		Флаги = "";
		ИдентификаторПредка = СтрокаРебенка.Родитель;

		Пока Не ПустаяСтрока(ИдентификаторПредка) Цикл

			СтрокаПредка = ИндексПоИдентификатору.Получить(ИдентификаторПредка);

			Если СтрокаПредка = Неопределено Тогда

				Прервать;

			КонецЕсли;

			Флаг = ?(СтрокаПредка.ЭтоПоследнийСредиБратьев, "0", "1");
			Флаги = Флаг + Флаги;
			ИдентификаторПредка = СтрокаПредка.Родитель;

		КонецЦикла;

		СтрокаРебенка.ФлагиВертикалиПредков = Флаги;

	КонецЦикла;

КонецПроцедуры

Функция НайтиУзелЗаказаВДереве(Дерево)

	Для Каждого СтрокаДерева Из Дерево.Строки Цикл

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			Возврат СтрокаДерева;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиУзелДереваПоТипуМонитора(СтрокиДерева, ИмяТипа)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = ИмяТипа Тогда

			Возврат СтрокаДерева;

		КонецЕсли;

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			Результат = НайтиУзелДереваПоТипуМонитора(СтрокаДерева.Строки, ИмяТипа);

			Если Результат <> Неопределено Тогда

				Возврат Результат;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЯкоряДокументовПозицииМонитора(Состояние, Номенклатура, Характеристика)

	Якоря = Новый Соответствие;

	Для Каждого СтрокаСборки Из Состояние.ЗаказыНаСборку Цикл

		Если СтрокаСборки.Номенклатура = Номенклатура
			И СтрокаСборки.Характеристика = Характеристика Тогда

			Якоря.Вставить(СтрокаСборки.ЗаказНаСборку, Истина);

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаЗП Из Состояние.ЗаказыПоставщику Цикл

		Если СтрокаЗП.Номенклатура = Номенклатура
			И СтрокаЗП.Характеристика = Характеристика Тогда

			Якоря.Вставить(СтрокаЗП.ЗаказПоставщику, Истина);

		КонецЕсли;

	КонецЦикла;

	Возврат Якоря;

КонецФункции

Функция ПредставлениеУзлаМонитора(СтрокаДерева)

	Если Не ПустаяСтрока(СтрокаДерева.Представление) Тогда

		Возврат СтрокаДерева.Представление;

	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

		Возврат Строка(СтрокаДерева.Ссылка);

	КонецЕсли;

	Возврат СтрокаДерева.Тип;

КонецФункции

Функция ДокументДереваОтноситсяКПозицииМонитора(СтрокаДерева, ПутьДокументов, ЯкоряПозиции, СтрокаФактов)

	Если ПутьСодержитЯкорьМонитора(ПутьДокументов, ЯкоряПозиции) Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "РеализацияТоваровУслуг"
		И СтрокаФактов.Реализовано > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "РасходныйОрдерНаТовары"
		И (СтрокаФактов.ОтгруженоОрдером > 0 Или ПутьСодержитТипМонитора("РеализацияТоваровУслуг", ПутьДокументов)) Тогда

		Возврат Истина;

	КонецЕсли;

	Если (СтрокаДерева.Тип = "ПоступлениеБезналичныхДенежныхСредств"
			Или СтрокаДерева.Тип = "ПриходныйКассовыйОрдер")
		И СтрокаФактов.ОплаченоКлиентом > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "ЗаявкаНаРасходованиеДенежныхСредств"
		И СтрокаФактов.Заявлено > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если (СтрокаДерева.Тип = "СписаниеБезналичныхДенежныхСредств"
			Или СтрокаДерева.Тип = "РасходныйКассовыйОрдер")
		И СтрокаФактов.ОплаченоПоставщику > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "ШтрихкодыУпаковокТоваров"
		И (ПутьСодержитЯкорьМонитора(ПутьДокументов, ЯкоряПозиции)
			Или ПутьСодержитТипМонитора("РеализацияТоваровУслуг", ПутьДокументов)
			Или ПутьСодержитТипМонитора("РасходныйОрдерНаТовары", ПутьДокументов)
			Или ПутьСодержитТипМонитора("ПриходныйОрдерНаТовары", ПутьДокументов)) Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПутьСодержитЯкорьМонитора(ПутьДокументов, ЯкоряПозиции)

	Для Каждого ДокументПути Из ПутьДокументов Цикл

		Если ЯкоряПозиции.Получить(ДокументПути) <> Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПутьСодержитТипМонитора(ИмяТипа, ПутьДокументов)

	Для Каждого ДокументПути Из ПутьДокументов Цикл

		Если ДокументПути <> Неопределено И Строка(ДокументПути.Метаданные().Имя) = ИмяТипа Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
