
&Вместо("ВыполнитьКоманду")
Процедура CleverenceВыполнитьКоманду(Форма, Команда, Источник)
	
	CleverenceОбработатьВыполнениеКоманды(Форма, Команда, Источник);
	
КонецПроцедуры

&Вместо("НачатьВыполнениеКоманды")
Процедура CleverenceНачатьВыполнениеКоманды(Форма, Команда, Знач Источник = Неопределено)
	
	CleverenceОбработатьВыполнениеКоманды(Форма, Команда, Источник);
	
КонецПроцедуры

Процедура CleverenceОбработатьВыполнениеКоманды(Форма, Команда, Источник)

	ИмяСобытия = "CleverenceОбработатьВыполнениеКоманды";
	
	Попытка
		ЕстьРеквизитИмяКоманды = Вычислить("Клеверенс_ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Команда, ""Имя"")");
	Исключение
		// Если нет основого расширения, то пусть вызов продолжается
		ПродолжитьВызов(Форма, Команда, Источник);
		Возврат;
	КонецПопытки;
	
	Если ЕстьРеквизитИмяКоманды Тогда
		// Исправление ошибки в рознице 2.3
		ИмяКоманды = Команда.Имя;
	Иначе
		// Если команда не наша, то пусть вызов продолжается
		ПродолжитьВызов(Форма, Команда, Источник);
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ИмяКоманды, "Клеверенс_") > 0 Тогда
		
		ИмяГлавнойФормыОО = "Обработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ГлавнаяФорма";
		ГлавнаяФормаОО = ПолучитьФорму(ИмяГлавнойФормыОО);
			
		//Обработка команды
		ИмяКоманды = СтрЗаменить(ИмяКоманды, "Клеверенс_", "");
		
		ИмяФормы = Форма.ИмяФормы;
		
		ЭтоРМК = Найти(ИмяФормы, "РМК") > 0;
		
		МассивЧастейИмениФормы = Вычислить("Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ""."")");
		
		ТребуетсяОбъектНазначения = Ложь;
		
		Если МассивЧастейИмениФормы[0] <> "Справочник" И НЕ ЭтоРМК Тогда
			// Для справочников не обязательно иметь объект, т.к. выгружаем все справочники, а не конкретный элемент
			ТребуетсяОбъектНазначения = Истина;
		КонецЕсли;
		
		Если МассивЧастейИмениФормы.Количество() = 4 Тогда
			
			Элементы = Форма.Элементы;

			ЭтоФормаСписка = СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0 Или 
				СтрНайти(МассивЧастейИмениФормы[3], "Список") > 0;
			
			ОбъектыНазначения = Новый Массив;
			
			Если ЭтоФормаСписка Тогда
				
				ВСпискеСсылки = Ложь;
				
				Если МассивЧастейИмениФормы[0] = "Документ" Или
					МассивЧастейИмениФормы[0] = "Справочник" Тогда
					
					ВСпискеСсылки = Истина;
					
					ИмяОбъектаФормы = МассивЧастейИмениФормы[0] + "Ссылка." + МассивЧастейИмениФормы[1];
					ТипОбъекта = Тип(ИмяОбъектаФормы); 
				КонецЕсли;
				
				Если ИмяКоманды = "ЗагрузитьИзТСД" Тогда
					// При загрузке документа из формы списка не обязательно должен быть выделен элемент динамического списка
					ТребуетсяОбъектНазначения = Ложь;
				КонецЕсли;
				
				//Поиск выделенных строк в динамическом списке
				МассивТаблицФормы = Новый Массив;
				Для каждого Элемент Из Элементы Цикл
					Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
						
						МассивСсылок = Вычислить("Клеверенс_ОбщегоНазначенияКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элемент, ТребуетсяОбъектНазначения, ВСпискеСсылки)");
						Если МассивСсылок.Найти(Неопределено) <> Неопределено Тогда
							ТекстСообщения = НСтр("be = 'Не ўдалося атрымаць спасылку на дакумент'; en = 'Failed to get a link to the document'; es = 'No se pudo obtener el enlace al documento'; ka = 'დოკუმენტზე ბმულის მიღება ვერ ხერხდება'; kk = 'Құжатқа сілтеме алу мүмкін емес'; ro = 'Nu s-a putut obține link-ul către document'; ru = 'Не удалось получить ссылку на документ'; tr = 'Belge bağlantısı alınamadı'; uk = 'Не вдалося отримати посилання на документ'; uz = 'Ҳужжатга ҳавола олиш мумкин бўлмади'");
							Сообщить(ТекстСообщения);
							Возврат;
						КонецЕсли;
						
						Если МассивСсылок.Количество() = 0 И
							ВСпискеСсылки И
							ИмяКоманды = "ЗагрузитьИзТСД" Тогда
							
							// Добавим в МассивСсылок пустую ссылку с нужным типом
							МассивТипов = Новый Массив;
							МассивТипов.Добавить(ТипОбъекта);
							ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
							МассивСсылок.Добавить(ОписаниеТипов.ПривестиЗначение());
							
						КонецЕсли;
						
						Если Не ВСпискеСсылки Или
							Вычислить("Клеверенс_ОбщегоНазначенияКлиент.ПроверитьТипПараметраКоманды(МассивСсылок, ТипОбъекта)") Тогда
							ОбъектыНазначения = МассивСсылок;
							Прервать;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				
				Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) И НЕ ЭтоРМК Тогда
					ТекстСообщения = НСтр("be = 'Дакумент павінен быць запісаны перад выгрузкай у мабільнае прылада!'; en = 'The document must be saved before unloading to the mobile device!'; es = '¡El documento debe ser guardado antes de descargarlo en el dispositivo móvil!'; ka = 'დოკუმენტი უნდა იყოს ჩაწერილი მობილურ მოწყობაში გადასატანად!'; kk = 'Мобильді құрылғыға жіберу алдында документ жазылуы керек!'; ro = 'Documentul trebuie să fie înregistrat înainte de descărcarea pe dispozitivul mobil!'; ru = 'Документ должен быть записан перед выгрузкой в ТСД!'; tr = 'Mobil cihaza yüklemeden önce belge kaydedilmelidir!'; uk = 'Документ повинен бути записаний перед вивантаженням на мобільний пристрій!'; uz = 'Мобил қурилмага чиқаришдан олдин ҳужжат ёзилган бўлиши керак!'");
					Сообщить(ТекстСообщения);
					Возврат;
				Иначе
					ОбъектыНазначения.Добавить(Форма.Объект.Ссылка);				
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// смотрим реквизитах формы информацию о месте встраивания
		ИмяРеквизита = "Клеверенс_МестоВстраиванияКнопкиЗагрузки";
		Если ИмяКоманды = "ЗагрузитьИзТСД" И Вычислить("Клеверенс_ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизита)") Тогда
			МестоВстраивания = Форма[ИмяРеквизита];
			
			Если МестоВстраивания.Свойство("ТипыОбъектовДляЗагрузки") и Не ПустаяСтрока(МестоВстраивания.ТипыОбъектовДляЗагрузки) Тогда
				
				ОбъектыНазначения.Очистить();
				
				МассивТиповОбъектов = СтрЗаменить(МестоВстраивания.ТипыОбъектовДляЗагрузки, ",", Символы.ПС);
				Для к = 1 По СтрЧислоСтрок(МассивТиповОбъектов) Цикл
					ИмяТипаОбъекта = СтрПолучитьСтроку(МассивТиповОбъектов, к);
					Попытка
						ТипОбъекта = Тип(ИмяТипаОбъекта);
						МассивТипов = Новый Массив;
						МассивТипов.Добавить(ТипОбъекта);
						ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
						ОбъектыНазначения.Добавить(ОписаниеТипов.ПривестиЗначение());														
					Исключение
					КонецПопытки;									
				КонецЦикла;
									
			КонецЕсли;
			
			// если оставить Ложь, то будет загружать в текущий
			Если МестоВстраивания.Свойство("ЗагружатьВТекущийОбъект") и МестоВстраивания.ЗагружатьВТекущийОбъект = Ложь Тогда
				ЭтоФормаСписка = Истина;
			КонецЕсли;
						
		КонецЕсли;
		
		Если ТребуетсяОбъектНазначения И
			ОбъектыНазначения.Количество() = 0 Тогда
			ТекстСообщения = НСтр("be = ""Не ўдалося вызначыць спасылку (спасылкі) на аб'екты""; en = 'Failed to determine the link(s) to the objects'; es = 'No se pudo determinar el enlace (enlaces) a los objetos'; ka = 'ობიექტებზე ბმული (ბმულები) ვერ იქნება განსაზღვრული'; kk = 'Нысандарға сілтеме (сілтемелер) анықталмады'; ro = 'Nu s-a putut determina link-ul (link-urile) către obiecte'; ru = 'Не удалось определить ссылку (ссылки) на объекты'; tr = 'Nesne (ler) için bağlantı (ları) belirleyemedi'; uk = ""Не вдалося визначити посилання (посилання) на об'єкти""; uz = 'Объект(лар)га ҳавола(лар)ни аниқлаш мумкин бўлмади'");
			Сообщить(ТекстСообщения);
			Возврат;
		КонецЕсли;			
		
		Попытка	
			
			ОшибкиФоновойИнициализации 				= Ложь;
			ОшибкиФоновойИнициализацииСуществует 	= Ложь;
			
			КэшДанных = Вычислить("Клеверенс_ОбщегоНазначенияВызовСервера.ПолучитьНастройкуОбщегоХранилища(""CleverenceButtonsExtension_КэшДанных"")");
			
			Если Не ТипЗнч(КэшДанных) = Тип("Структура") Тогда
				КэшДанных = Новый Структура;
			КонецЕсли;
			
			Если КэшДанных.Свойство("ОшибкиФоновойИнициализации") Тогда
				ОшибкиФоновойИнициализации = КэшДанных.ОшибкиФоновойИнициализации;
			КонецЕсли;
			
			Если Вычислить("Клеверенс_ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ГлавнаяФормаОО, ""ОшибкиФоновойИнициализации"")") Тогда
				ОшибкиФоновойИнициализацииСуществует = Истина;
				ГлавнаяФормаОО.ОшибкиФоновойИнициализации = ОшибкиФоновойИнициализации;
			КонецЕсли;
			
			Выполнить("Клеверенс_ОбщегоНазначенияКлиент.ВыполнитьКомандуКлеверенс(ГлавнаяФормаОО, ИмяКоманды, ОбъектыНазначения, ЭтоФормаСписка, Форма)");
			
			Если ОшибкиФоновойИнициализацииСуществует Тогда
				
				// Получаем значение реквизита после попытки выполнения команды
				ОшибкиФоновойИнициализации = ГлавнаяФормаОО.ОшибкиФоновойИнициализации;
								
				// Сохраним значение, чтобы оно было доступно на время сеанса
				// При перезапуске значение будет недоступно, поэтому снова будет попытка инициализировать гл форму в фон задании
				КэшДанных.Вставить("ОшибкиФоновойИнициализации", ОшибкиФоновойИнициализации);
				Выполнить("Клеверенс_ОбщегоНазначенияВызовСервера.ЗаписатьНастройкуВХранилище(""CleverenceButtonsExtension_КэшДанных"", КэшДанных)");
				
			КонецЕсли;
			
		Исключение
			ИнфоОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
			Выполнить("Клеверенс_ОбщегоНазначенияВызовСервера.ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, ""Ошибка"", ТекстОшибки)");
			ТекстСообщения = НСтр("be = 'Памылка выканання аперацыі. Падрабязнасці ў журнале рэгістрацыі.'; en = 'Operation execution error. Details in the registration log.'; es = 'Error al realizar la operación. Detalles en el registro de eventos.'; ka = 'ოპერაციის შესრულების შეცდომა. დეტალები რეგისტრაციის ჟურნალში.'; kk = 'Операцияны орындауға қателік. Толық мәліметтер жазбаға кіргенде.'; ro = 'Eroare la executarea operației. Detalii în jurnalul de înregistrare.'; ru = 'Ошибка выполнения операции. Подробности в журнале регистрации.'; tr = 'İşlem hatası. Kayıt defterinde ayrıntılar için kontrol edin.'; uk = 'Помилка виконання операції. Деталі в журналі реєстрації.'; uz = 'Амалиётни бажаришда хатолик юз берди. Рўйхатга ёзиш журналида тафсилотлар кўрсатилган.'");
			Сообщить(ТекстСообщения);
		КонецПопытки;

	Иначе
		
		ПродолжитьВызов(Форма, Команда, Источник);
		
	КонецЕсли;
	
КонецПроцедуры