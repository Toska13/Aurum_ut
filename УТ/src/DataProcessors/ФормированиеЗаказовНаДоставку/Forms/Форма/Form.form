      <segments>СписокЗаказыНаДоставку.СпособДоставки</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументЗаказНаДоставку.Ссылка КАК Ссылка,
	ДокументЗаказНаДоставку.Номер КАК Номер,
	ДокументЗаказНаДоставку.Дата КАК Дата,
	ДокументЗаказНаДоставку.Организация КАК Организация,
	ДокументЗаказНаДоставку.ДатаОтгрузки КАК ДатаОтгрузки,
	ДокументЗаказНаДоставку.СпособДоставки КАК СпособДоставки,
	ВЫБОР
		КОГДА ДокументЗаказНаДоставку.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки25.СиламиПеревозчика)
			ТОГДА ДокументЗаказНаДоставку.Перевозчик
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	КОНЕЦ КАК Перевозчик,
	ДокументЗаказНаДоставку.Отправитель КАК Отправитель,
	ВЫБОР
		КОГДА ДокументЗаказНаДоставку.ДоставкаДоПеревозчика
			ТОГДА ДокументЗаказНаДоставку.Перевозчик
		ИНАЧЕ ДокументЗаказНаДоставку.Получатель
	КОНЕЦ КАК Получатель,
	ВЫБОР
		КОГДА ДокументЗаказНаДоставку.ДоставкаДоПеревозчика
			ТОГДА ДокументЗаказНаДоставку.ТочкаДоставкиПеревозчика
		ИНАЧЕ ДокументЗаказНаДоставку.ТочкаДоставкиПолучателя
	КОНЕЦ КАК ТочкаДоставки,
	ВЫБОР
		КОГДА ДокументЗаказНаДоставку.ДоставкаДоПеревозчика
			ТОГДА ДокументЗаказНаДоставку.ЗонаДоставкиПеревозчика
		ИНАЧЕ ДокументЗаказНаДоставку.ЗонаДоставки
	КОНЕЦ КАК ЗонаДоставки,
	ДокументЗаказНаДоставку.ДоставкаДоПеревозчика КАК ДоставкаДоПеревозчика,
	ДокументЗаказНаДоставку.Получатель КАК КонечныйПолучатель,
	ДокументЗаказНаДоставку.ТочкаДоставкиПолучателя КАК ТочкаКонечногоПолучателя
{ВЫБРАТЬ
	Номер,
	Дата,
	Организация.*,
	ДатаОтгрузки,
	СпособДоставки.*,
	Перевозчик.*,
	Отправитель.*,
	Получатель.*,
	ТочкаДоставки.*,
	ЗонаДоставки.*,
	ДоставкаДоПеревозчика,
	КонечныйПолучатель.*,
	ТочкаКонечногоПолучателя.*}
ИЗ
	Документ.ЗаказНаДоставку КАК ДокументЗаказНаДоставку
ГДЕ
	ДокументЗаказНаДоставку.Отправитель = &amp;НачальныйОтправитель
	И ДокументЗаказНаДоставку.Получатель = &amp;КонечныйПолучатель
	И ДокументЗаказНаДоставку.ДатаОтгрузки >= &amp;ДатаОтгрузкиС
{ГДЕ
	ДокументЗаказНаДоставку.Ссылка.*,
	ДокументЗаказНаДоставку.Номер,
	ДокументЗаказНаДоставку.Дата,
	ДокументЗаказНаДоставку.Организация.*,
	(ДокументЗаказНаДоставку.Организация = &amp;Организация),
	ДокументЗаказНаДоставку.ДатаОтгрузки,
	ДокументЗаказНаДоставку.СпособДоставки.*,
	ДокументЗаказНаДоставку.Перевозчик.*,
	ДокументЗаказНаДоставку.Отправитель.*,
	(ВЫБОР
			КОГДА ДокументЗаказНаДоставку.ДоставкаДоПеревозчика
				ТОГДА ДокументЗаказНаДоставку.Перевозчик
			ИНАЧЕ ДокументЗаказНаДоставку.Получатель
		КОНЕЦ).* КАК Получатель,
	(ВЫБОР
			КОГДА ДокументЗаказНаДоставку.ДоставкаДоПеревозчика
				ТОГДА ДокументЗаказНаДоставку.ТочкаДоставкиПеревозчика
			ИНАЧЕ ДокументЗаказНаДоставку.ТочкаДоставкиПолучателя
		КОНЕЦ).* КАК ТочкаДоставки,
	(ВЫБОР
			КОГДА ДокументЗаказНаДоставку.ДоставкаДоПеревозчика
				ТОГДА ДокументЗаказНаДоставку.ЗонаДоставкиПеревозчика
			ИНАЧЕ ДокументЗаказНаДоставку.ЗонаДоставки
		КОНЕЦ).* КАК ЗонаДоставки,
	ДокументЗаказНаДоставку.ДоставкаДоПеревозчика,
	ДокументЗаказНаДоставку.Получатель.* КАК КонечныйПолучатель,
	ДокументЗаказНаДоставку.ТочкаДоставкиПолучателя.* КАК ТочкаКонечногоПолучателя}</queryText>
      <mainTable>Document.ЗаказНаДоставку</mainTable>
