  <attributes>
    <name>СписокПоТоварам</name>
    <title>
      <key>ru</key>
      <value>Список по товарам</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.ДатаОтгрузки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.Детализация</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.ЗонаПолучателя</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.Номенклатура</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.Получатель</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.Распоряжение</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.Серия</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.СпособДоставки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.ТочкаПолучателя</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПоТоварам.Характеристика</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ДоставкаОбороты.Распоряжение КАК Распоряжение,
	ДоставкаОбороты.КодСтроки КАК КодСтроки
ПОМЕСТИТЬ ВТОстаткиПоКонечномуПлечу
ИЗ
	РегистрНакопления.Доставка.Обороты(
			,
			,
			,
			Получатель = &amp;КонечныйПолучатель {(Организация = &amp;Организация), (Распоряжение).* КАК Распоряжение, (ТипДоставки) КАК ТипДоставки, (ДатаОтгрузки >= &amp;ДатаОтгрузкиС), (ДатаОтгрузки &lt;= &amp;ДатаОтгрузкиПо)}) КАК ДоставкаОбороты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Доставка КАК ДоставкаКонечноеПлечо
		ПО ДоставкаОбороты.Распоряжение = ДоставкаКонечноеПлечо.Распоряжение
			И ДоставкаОбороты.КодСтроки = ДоставкаКонечноеПлечо.КодСтроки
			И ДоставкаОбороты.Плечо = ДоставкаКонечноеПлечо.Плечо
			И ДоставкаОбороты.Отправитель = ДоставкаКонечноеПлечо.Отправитель
			И ДоставкаОбороты.ТочкаОтправителя = ДоставкаКонечноеПлечо.ТочкаОтправителя
			И ДоставкаОбороты.ЗонаОтправителя = ДоставкаКонечноеПлечо.ЗонаОтправителя
			И ДоставкаОбороты.Получатель = ДоставкаКонечноеПлечо.Получатель
			И ДоставкаОбороты.ТочкаПолучателя = ДоставкаКонечноеПлечо.ТочкаПолучателя
			И ДоставкаОбороты.ЗонаПолучателя = ДоставкаКонечноеПлечо.ЗонаПолучателя
			И ДоставкаОбороты.ДатаОтгрузки = ДоставкаКонечноеПлечо.ДатаОтгрузки
			И ДоставкаОбороты.СпособДоставки = ДоставкаКонечноеПлечо.СпособДоставки
			И ДоставкаОбороты.Перевозчик = ДоставкаКонечноеПлечо.Перевозчик
			И ДоставкаКонечноеПлечо.ЭтоКонечноеПлечо
			И ДоставкаКонечноеПлечо.СторнируемыйДокументПланирования = НЕОПРЕДЕЛЕНО
			И ДоставкаКонечноеПлечо.КДоставке > 0
ГДЕ
	ДоставкаОбороты.КДоставкеОборот - ДоставкаОбороты.КРейсуОборот > 0

ИНДЕКСИРОВАТЬ ПО
	Распоряжение,
	КодСтроки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДоставкаОбороты.ДатаОтгрузки КАК ДатаОтгрузки,
	ДоставкаОбороты.СпособДоставки КАК СпособДоставки,
	ДоставкаОбороты.Отправитель КАК Отправитель,
	ДоставкаОбороты.Получатель КАК Получатель,
	ДоставкаОбороты.ТочкаПолучателя КАК ТочкаПолучателя,
	ДоставкаОбороты.ЗонаПолучателя КАК ЗонаПолучателя,
	ДоставкаОбороты.Распоряжение КАК Распоряжение,
	ДоставкаОбороты.ТипДоставки КАК ТипДоставки,
	ДоставкаОбороты.Номенклатура КАК Номенклатура,
	ДоставкаОбороты.Характеристика КАК Характеристика,
	ДоставкаОбороты.Серия КАК Серия,
	ДоставкаОбороты.Перевозчик КАК Перевозчик,
	ДоставкаОбороты.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	ДоставкаОбороты.КДоставкеОборот - ДоставкаОбороты.КРейсуОборот КАК Количество,
	0 КАК Подобрано,
	(ДоставкаОбороты.КДоставкеОборот - ДоставкаОбороты.КРейсуОборот) * &amp;ВыражениеВесУпаковки КАК Вес,
	(ДоставкаОбороты.КДоставкеОборот - ДоставкаОбороты.КРейсуОборот) * &amp;ВыражениеОбъемУпаковки КАК Объем,
	0 КАК Состояние,
	NULL КАК Детализация
{ВЫБРАТЬ
	ДатаОтгрузки,
	СпособДоставки.*,
	Отправитель.*,
	Получатель.*,
	ТочкаПолучателя.*,
	ЗонаПолучателя.*,
	Распоряжение.*,
	ТипДоставки,
	Номенклатура.*,
	Характеристика.*,
	Серия.*,
	Перевозчик.*,
	НоменклатураЕдиницаИзмерения.*,
	Количество,
	Подобрано,
	Вес,
	Объем,
	Состояние,
	Детализация}
ИЗ
	РегистрНакопления.Доставка.Обороты(
			,
			,
			,
			Плечо = 1
				И Отправитель = &amp;НачальныйОтправитель
				И (Распоряжение, КодСтроки) В
					(ВЫБРАТЬ
						ОстаткиПоКонечномуПлечу.Распоряжение,
						ОстаткиПоКонечномуПлечу.КодСтроки
					ИЗ
						ВТОстаткиПоКонечномуПлечу КАК ОстаткиПоКонечномуПлечу) {(ДатаОтгрузки >= &amp;ДатаОтгрузкиС), (ДатаОтгрузки &lt;= &amp;ДатаОтгрузкиПо), (Перевозчик).* КАК Перевозчик, (ДатаОтгрузки) КАК ДатаОтгрузки, (Получатель).* КАК Получатель, (ЗонаПолучателя).* КАК ЗонаПолучателя, (ТочкаПолучателя).* КАК ТочкаПолучателя, (ТипДоставки) КАК ТипДоставки, (СпособДоставки) КАК СпособДоставки, (Распоряжение).* КАК Распоряжение, (Номенклатура).* КАК Номенклатура, (Характеристика).*, (Серия).*}) КАК ДоставкаОбороты
ГДЕ
	ДоставкаОбороты.КДоставкеОборот - ДоставкаОбороты.КРейсуОборот > 0</queryText>
