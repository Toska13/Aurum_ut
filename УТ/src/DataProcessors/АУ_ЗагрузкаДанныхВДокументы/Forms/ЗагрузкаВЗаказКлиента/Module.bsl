
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВводДанных.Область(1,1,1,1).Текст="Артикул";
	ВводДанных.Область(1,2,1,2).Текст="Наименование";
	ВводДанных.Область(1,3,1,3).Текст="Ед. измерения";
	ВводДанных.Область(1,4,1,4).Текст="Количество";
	ВводДанных.Область(1,5,1,5).Текст="Ставка НДС";
	ВводДанных.Область(1,6,1,6).Текст="Цена";
	ВводДанных.Область(1,7,1,7).Текст="Сумма НДС";
	ВводДанных.Область(1,8,1,8).Текст="Сумма С НДС";
	ВводДанных.Область(1,9,1,9).Текст="Импортный товар";
	ВводДанных.Область(1,10,1,10).Текст="Производитель";
	
	НеИскатьАрхивные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Закрыть(ПодготовитьДанныеДляЗагрузки());
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляЗагрузки()
	
	Результат=Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Артикул");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Количество");
	Результат.Колонки.Добавить("СтавкаНДС");
	Результат.Колонки.Добавить("Цена");
	Результат.Колонки.Добавить("СуммаНДС");
	Результат.Колонки.Добавить("Сумма");
	
	Для н=2 По ВводДанных.ВысотаТаблицы Цикл
		
		Артикул=СокрЛП(ВводДанных.Область(н,1,н,1).Текст);
		Наименование=СокрЛП(ВводДанных.Область(н,2,н,2).Текст);
		Единица=СокрЛП(ВводДанных.Область(н,3,н,3).Текст);
		Количество=ВводДанных.Область(н,4,н,4).Текст;
		Ставка=ВводДанных.Область(н,5,н,5).Текст;
		Цена=ВводДанных.Область(н,6,н,6).Текст;
		СуммаНДС=ВводДанных.Область(н,7,н,7).Текст;
		Сумма=ВводДанных.Область(н,8,н,8).Текст;
		ИмпортныйТовар=ВводДанных.Область(н,9,н,9).Текст;
		Производитель=ВводДанных.Область(н,10,н,10).Текст;
		
		Если НЕ ЗначениеЗаполнено(СокрЛП(Наименование)) И НЕ ЗначениеЗаполнено(СокрЛП(Артикул)) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока=Результат.Добавить();
		НоваяСтрока.Номенклатура=Обработки.АУ_ЗагрузкаДанныхВДокументы.ПолучитьСоздатьНоменклатуру(ВидНовойНоменклатуры, ПапкаНовойНоменклатуры, Наименование, Единица, Ставка, Артикул, ИмпортныйТовар, Производитель, НеИскатьПоАртикулу, НеИскатьПоНаименованию, ОбновитьРеквизиты, НеИскатьАрхивные);
		НоваяСтрока.Количество=Количество;
		НоваяСтрока.СтавкаНДС=Обработки.АУ_ЗагрузкаДанныхВДокументы.ПолучитьСтавкуНДС(Ставка);
		НоваяСтрока.Цена=Цена;
		НоваяСтрока.СуммаНДС=СуммаНДС;
		НоваяСтрока.Сумма=Сумма;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Результат);
	
КонецФункции

