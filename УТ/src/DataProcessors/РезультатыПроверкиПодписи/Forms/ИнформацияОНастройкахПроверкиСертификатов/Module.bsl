// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.НадписьПерейтиВНастройки.Видимость = 
		ПравоДоступа("Просмотр", Метаданные.Обработки.ПанельАдминистрированияБЭД)
			И МашиночитаемыеДоверенности.ЕстьПравоНастройкиОбменаСКонтрагентами();
	
	ВариантПроверкиСертификатаДоверителя = МашиночитаемыеДоверенности.ВариантПроверкиСертификатаДоверителя();
	Если ВариантПроверкиСертификатаДоверителя = Перечисления.ВариантыПроверкиСертификатовМЧДЭДО.ПолнаяПроверка Тогда
		ПредставлениеВариантаПроверки = НСтр("ru = 'Проверять всё'");
	ИначеЕсли ВариантПроверкиСертификатаДоверителя = Перечисления.ВариантыПроверкиСертификатовМЧДЭДО.НеПроверятьПоСрокуДействия Тогда
		ПредставлениеВариантаПроверки = НСтр("ru = 'Проверять всё, кроме срока действия сертификата'");
	КонецЕсли;
		
	Элементы.НадписьИнформация.Заголовок = СтрШаблон(
		НСтр("ru = 'В 1С-ЭДО доступно два варианта проверки сертификатов доверителей МЧД:
			|- проверять всё;
			|- проверять всё, кроме срока действия сертификата.
			|
			|Сейчас выбран вариант ""%1"".
			|Изменить вариант может ответственный за ЭДО или Администратор в настройках программы.
			|Выбранный вариант применяется для всех накопленных МЧД.'") + Символы.ПС, 
				ПредставлениеВариантаПроверки);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПерейтиВНастройкиОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, 
	СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Раздел", "НастройкиЭДО");
	
	ОткрытьФорму(
		"Обработка.ПанельАдминистрированияБЭД.Форма.ОбщиеНастройки",
		ПараметрыФормы,,Истина);
	
КонецПроцедуры

#КонецОбласти

