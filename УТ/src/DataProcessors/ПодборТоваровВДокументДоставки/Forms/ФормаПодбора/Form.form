    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДоставкаОборотыПереопределяемый.ДатаОтгрузки КАК ДатаОтгрузки,
	ДоставкаОборотыПереопределяемый.СпособДоставки КАК СпособДоставки,
	ДоставкаОборотыПереопределяемый.Отправитель КАК Отправитель,
	ДоставкаОборотыПереопределяемый.Получатель КАК Получатель,
	ДоставкаОборотыПереопределяемый.ТочкаПолучателя КАК ТочкаПолучателя,
	ДоставкаОборотыПереопределяемый.ЗонаПолучателя КАК ЗонаПолучателя,
	ДоставкаОборотыПереопределяемый.Распоряжение КАК Распоряжение,
	ДоставкаОборотыПереопределяемый.ТипДоставки КАК ТипДоставки,
	ДоставкаОборотыПереопределяемый.Получатель КАК КонечныйПолучатель,
	ДоставкаОборотыПереопределяемый.ТочкаПолучателя КАК ТочкаКонечногоПолучателя,
	ДоставкаОборотыПереопределяемый.ЗонаПолучателя КАК ЗонаКонечногоПолучателя,
	0 КАК Вес,
	0 КАК Объем,
	-1 КАК ИндексКартинки,
	NULL КАК Детализация,
	ЛОЖЬ КАК ЕстьОтличияВПараметрахДоставки,
	NULL КАК ВариантыПараметровДоставки
{ВЫБРАТЬ
	ДатаОтгрузки,
	СпособДоставки.*,
	Отправитель.*,
	Получатель.*,
	ТочкаПолучателя.*,
	ЗонаПолучателя.*,
	КонечныйПолучатель,
	ТочкаКонечногоПолучателя.*,
	ЗонаКонечногоПолучателя.*,
	Распоряжение.*,
	ТипДоставки,
	Вес,
	Объем,
	ИндексКартинки,
	Детализация,
	ЕстьОтличияВПараметрахДоставки,
	ВариантыПараметровДоставки}
ИЗ
	РегистрНакопления.Доставка.Обороты(, , , {(ДатаОтгрузки), (ДатаОтгрузки >= &amp;ДатаОтгрузкиС), (ДатаОтгрузки &lt;= &amp;ДатаОтгрузкиПо), (Организация), (Перевозчик), (Плечо), (Получатель), (СпособДоставки), (ТипДоставки), (ТочкаПолучателя), (ЗонаПолучателя), (Распоряжение)}) КАК ДоставкаОборотыПереопределяемый</queryText>
      <mainTable>AccumulationRegister.Доставка.Turnovers</mainTable>
      <customQuery>true</customQuery>
