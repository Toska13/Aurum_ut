
&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Диалог=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр="mxl|*.mxl";
	Диалог.Показать(Новый ОписаниеОповещения("ИмяФайлаЗавершение",ЭтаФорма));
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗавершение(Значение,ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		ИмяФайла=Значение[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяПапкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Диалог=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Показать(Новый ОписаниеОповещения("ИмяПапкиЗавершение",ЭтаФорма));
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяПапкиЗавершение(Значение,ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		ИмяПапки=Значение[0];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьФайлыНаСервере(Адрес)
	
	Данные=ПолучитьИзВременногоХранилища(Адрес);
	ИмяВременногоМХЛ=ПолучитьИмяВременногоФайла("mxl");
	Данные.Записать(ИмяВременногоМХЛ);
	
	ИмяВременногоПДФ=ПолучитьИмяВременногоФайла("pdf");
	ВременнаяПапка="D:\1c data\Картинки";
	
	Таб=Новый ТабличныйДокумент;
	Таб.Прочитать(ИмяВременногоМХЛ);
	Таб.ОриентацияСтраницы=ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб=Истина;
	Таб.ПолеСверху=0;
	Таб.ПолеСлева=0;
	Таб.ПолеСправа=0;
	Таб.ПолеСнизу=0;
	Таб.Записать(ИмяВременногоПДФ,ТипФайлаТабличногоДокумента.PDF);
	
	МассивФайлов=Новый Массив;
	
	Для н=1 По Таб.ВысотаТаблицы/ВысотаСтраницы Цикл
		
		Конвертер = Новый COMОбъект("ArrowPDF.Converter");
		Конвертер.PdfPages=Формат(н,"ЧГ=");
		Конвертер.ImgFormat = "Png";
		Конвертер.ImgWidth=7086;
		Конвертер.ImgHeight=4724;
		Конвертер.ImgDpiX=2000;
		Конвертер.ImgDpiY=2000;
		
		Артикул=Таб.Область((н-1)*ВысотаСтраницы+15,30,(н-1)*ВысотаСтраницы+15,30).Текст;
		НомерФайла=Таб.Область((н-1)*ВысотаСтраницы+51,74,(н-1)*ВысотаСтраницы+51,74).Текст;
		
		Результат=Конвертер.PDF2IMG(ИмяВременногоПДФ,ВременнаяПапка);
		
		ИмяФайлаКартинки=СтрШаблон("%1-%2.png",Артикул,НомерФайла);
		ИмяФайлаКартинкиСПапкой=СтрШаблон("%1\%2",ВременнаяПапка,ИмяФайлаКартинки);
		ПереместитьФайл(СтрШаблон("%1\%2.png",ВременнаяПапка,Формат(н,"ЧЦ=3; ЧВН=; ЧГ=")),ИмяФайлаКартинкиСПапкой);
		
		Файл=Новый ДвоичныеДанные(ИмяФайлаКартинкиСПапкой);
		МассивФайлов.Добавить(Новый Структура("ИмяФайла,Адрес",ИмяФайлаКартинки,ПоместитьВоВременноеХранилище(Файл,УникальныйИдентификатор)));
		
		УдалитьФайлы(ИмяФайлаКартинкиСПапкой);
		
	КонецЦикла;
	
	УдалитьФайлы(ИмяВременногоМХЛ);
	УдалитьФайлы(ИмяВременногоПДФ);
	
	Возврат МассивФайлов;
	
КонецФункции

&НаСервере
Функция НапечататьРеестрФайлов(МассивФайлов)
	
	Таб=Новый ТабличныйДокумент;
	Макет=РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	
	Область=Макет.ПолучитьОбласть("Шапка");
	Таб.Вывести(Область);
	
	Для каждого стрФайл Из МассивФайлов Цикл
		
		Область=Макет.ПолучитьОбласть("Строка");
		Область.Параметры.ИмяФайла=стрФайл.ИмяФайла;
		Таб.Вывести(Область);
		
	КонецЦикла;
	
	Возврат Таб;
	
КонецФункции

&НаКлиенте
Процедура СформироватьФайлы(Команда)
	
	ДвоичныеДанные=Новый ДвоичныеДанные(ИмяФайла);
	Адрес=ПоместитьВоВременноеХранилище(ДвоичныеДанные,УникальныйИдентификатор);
	
	МассивФайлов=СформироватьФайлыНаСервере(Адрес);
	
	Для каждого стрФайл Из МассивФайлов Цикл
		
		Данные=ПолучитьИзВременногоХранилища(стрФайл.Адрес);
		Данные.Записать(СтрШаблон("%1\%2",ИмяПапки,стрФайл.ИмяФайла));
		
	КонецЦикла;
	
	Таб=НапечататьРеестрФайлов(МассивФайлов);
	Таб.Показать("Список файлов");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВысотаСтраницы=59;
	
КонецПроцедуры
