Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументОПредстоящейПоставке.Ссылка КАК Ссылка,
	|	ДокументОПредстоящейПоставке.Дата КАК Дата,
	|	ДокументОПредстоящейПоставке.Организация КАК Организация,
	|	ДокументОПредстоящейПоставке.Контрагент КАК Контрагент,
	|	ДокументОПредстоящейПоставке.Валюта КАК Валюта,
	|	ДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа КАК СуммаДокумента,
	|	ДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа КАК СуммаОбеспечительногоПлатежа,
	|	ДокументОПредстоящейПоставке.Номер КАК Номер,
	|	ДокументОПредстоящейПоставке.Договор КАК Договор,
	|	ДокументОПредстоящейПоставке.Подразделение КАК Подразделение,
	|	ДокументОПредстоящейПоставке.Комментарий КАК Комментарий,
	|	ДокументОПредстоящейПоставке.ПометкаУдаления КАК ПометкаУдаления,
	|	ДокументОПредстоящейПоставке.Проведен КАК Проведен,
	|	ДокументОПредстоящейПоставке.Организация.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета,
	|	ДокументОПредстоящейПоставке.Организация.СтранаРегистрации КАК СтранаРегистрации,
	|	ДокументОПредстоящейПоставке.Автор КАК Автор,
	|	ДокументОПредстоящейПоставке.НомерДОПП КАК НомерДОПП,
	|	ДокументОПредстоящейПоставке.ДатаДОПП КАК ДатаДОПП,
	|	ДокументОПредстоящейПоставке.Партнер КАК Поставщик,
	|	ДокументОПредстоящейПоставке.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	Документ.ДокументОПредстоящейПоставке КАК ДокументОПредстоящейПоставке
	|ГДЕ
	|	ДокументОПредстоящейПоставке.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.СуммаНДС, 0)) КАК СуммаНДС,
	|	СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.ОбеспечительныйПлатеж, 0)) КАК ОбеспечительныйПлатеж
	|ИЗ
	|	Документ.ДокументОПредстоящейПоставке.Товары КАК ДокументОПредстоящейПоставкеТовары
	|ГДЕ
	|	ДокументОПредстоящейПоставкеТовары.Ссылка = &Ссылка
	|
	|ИМЕЮЩИЕ НЕ СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.СуммаНДС, 0)) ЕСТЬ NULL
	|	ИЛИ НЕ СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.ОбеспечительныйПлатеж, 0)) ЕСТЬ NULL
	|";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	Реквизиты = РезультатыЗапроса[0].Выбрать();
	Реквизиты.Следующий();
	
	Для Каждого Колонка Из РезультатыЗапроса[0].Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, Реквизиты[Колонка.Имя]);
	КонецЦикла;
	
	Результат = РезультатыЗапроса[1].Выбрать();
	Если Результат.Следующий() Тогда
		СуммаОкругленияНДС = Результат.СуммаНДС - Окр(Результат.СуммаНДС);
		Запрос.УстановитьПараметр("СуммаОкругленияНДС", СуммаОкругленияНДС);
		
		Запрос.УстановитьПараметр("СуммаОкругленияАкциза", Результат.ОбеспечительныйПлатеж - Реквизиты.СуммаДокумента
															- СуммаОкругленияНДС);
	Иначе
		Запрос.УстановитьПараметр("СуммаОкругленияНДС",    0);
		Запрос.УстановитьПараметр("СуммаОкругленияАкциза", 0);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",                  Реквизиты.Дата);
	Запрос.УстановитьПараметр("ИдентификаторМетаданных", ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяОбъекта()));
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",   Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
	
	Если ЗначениеЗаполнено(Реквизиты.Договор) Тогда
		ШаблонСтроки = НСтр("ru = 'По договору ""%1""'"); // @НСтр
		ИнформацияПоДоговору = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтроки, Реквизиты.Договор);
	КонецЕсли;
	Запрос.УстановитьПараметр("ИнформацияПоДоговору", ИнформацияПоДоговору);
	
	Запрос.УстановитьПараметр("ИспользоватьПодакцизныеТовары",
		УчетПодакцизныхТоваров.ИспользуетсяИмпортПодакцизныхТоваров(Реквизиты.Организация, Реквизиты.Дата));
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьМногострановойУчет") Тогда
		Запрос.УстановитьПараметр("СтранаРегистрации", ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана());
	КонецЕсли;
	
	ВалютаРеглУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Реквизиты.Организация);
	КоэффициентыПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентыПересчетаВалюты(
		ВалютаРеглУчета, ВалютаРеглУчета, Реквизиты.Дата, Реквизиты.Организация);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУпр", КоэффициентыПересчета.КоэффициентПересчетаВВалютуУпр);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаПрочиеАктивыПассивы(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ПрочиеАктивыПассивы";
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВТРасшифровкаНалогов", ТекстыЗапроса) Тогда
		ДобавитьТекстЗапросаВТРасшифровкаНалогов(ТекстыЗапроса);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)              КАК ВидДвижения,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.НДС_ВвозимыеТовары)    КАК Аналитика,
	|	СУММА(Налоги.СуммаНДСУУ)                               КАК Сумма
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|
	|ГДЕ
	|	&СуммаДокумента <> 0
	|	И Налоги.СуммаНДС <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)              КАК ВидДвижения,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.Акцизы)      КАК Аналитика,
	|	СУММА(Налоги.СуммаАкцизаУУ)                         КАК Сумма
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	&СуммаДокумента <> 0
	|	И Налоги.СуммаАкциза <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)              КАК ВидДвижения,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)         КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги)     КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.ОбеспечительныйПлатежСПОТ) КАК Аналитика,
	|	СУММА(Налоги.СуммаНДСУУ + Налоги.СуммаАкциза)       КАК Сумма
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|
	|ГДЕ
	|	&СуммаДокумента <> 0
	|	И Налоги.СуммаАкциза + Налоги.СуммаНДС <> 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаДвиженияПоПрочимАктивамПассивам(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ДвиженияПоПрочимАктивамПассивам";
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВТРасшифровкаНалогов", ТекстыЗапроса) Тогда
		ДобавитьТекстЗапросаВТРасшифровкаНалогов(ТекстыЗапроса);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПрочихАктивовПассивов.Дебет) КАК ДебетКредит,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.НДС_ВвозимыеТовары)    КАК Аналитика,
	|	Налоги.СуммаНДС                                     КАК СуммаРегл,
	|	Налоги.СуммаНДСУУ                                   КАК СуммаБезНДС,
	|	Налоги.СуммаНДСУУ                                   КАК СуммаСНДС,
	|	Налоги.СуммаНДСУУ                                   КАК СуммаУпр,
	|	Налоги.ИдентификаторСтроки                          КАК ИдентификаторФинЗаписи,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ЗакупкаВСтранахЕАЭС) КАК НастройкаХозяйственнойОперации
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	Налоги.СуммаНДС <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПрочихАктивовПассивов.Дебет) КАК ДебетКредит,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.Акцизы)      КАК Аналитика,
	|	Налоги.СуммаАкциза                                  КАК СуммаРегл,
	|	Налоги.СуммаАкцизаУУ                                КАК СуммаБезНДС,
	|	Налоги.СуммаАкцизаУУ                                КАК СуммаСНДС,
	|	Налоги.СуммаАкцизаУУ                                КАК СуммаУпр,
	|	Налоги.ИдентификаторСтроки                          КАК ИдентификаторФинЗаписи,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ЗакупкаВСтранахЕАЭС) КАК НастройкаХозяйственнойОперации
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	Налоги.СуммаАкциза <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПрочихАктивовПассивов.Кредит) КАК ДебетКредит,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)         КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги)     КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.ОбеспечительныйПлатежСПОТ) КАК Аналитика,
	|	Налоги.СуммаАкциза + Налоги.СуммаНДС                КАК СуммаРегл,
	|	Налоги.СуммаАкцизаУУ + Налоги.СуммаНДСУУ            КАК СуммаБезНДС,
	|	Налоги.СуммаАкцизаУУ + Налоги.СуммаНДСУУ            КАК СуммаСНДС,
	|	Налоги.СуммаАкцизаУУ + Налоги.СуммаНДСУУ            КАК СуммаУпр,
	|	Налоги.ИдентификаторСтроки                          КАК ИдентификаторФинЗаписи,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ЗакупкаВСтранахЕАЭС) КАК НастройкаХозяйственнойОперации
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	Налоги.СуммаАкциза + Налоги.СуммаНДС <> 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ДобавитьТекстЗапросаВТРасшифровкаНалогов(ТекстыЗапроса)
	
	ИмяТаблицы = "ВТРасшифровкаНалогов";
	Если ПроведениеДокументов.ЕстьТаблицаЗапроса(ИмяТаблицы, ТекстыЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.КБК КАК КБК,
	|	ВЫБОР
	|		КОГДА Строки.МаркируемаяПродукция
	|		ТОГДА 0
	|		ИНАЧЕ Строки.СуммаАкциза
	|	КОНЕЦ КАК СуммаАкциза,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТРасшифровкаНалоговПредварительная
	|ИЗ
	|	Документ.ДокументОПредстоящейПоставке.Товары КАК Строки
	|
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|	И &СуммаДокумента <> 0
	|;
	|////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Строки.СуммаНДС) КАК СуммаНДС,
	|	МАКСИМУМ(Строки.СуммаАкциза) КАК СуммаАкциза
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК Строки
	|;
	|////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК ЭтоНДС,
	|	МАКСИМУМ(РасшифровкаНалогов.НомерСтроки) КАК НомерСтроки,
	|	&СуммаОкругленияНДС КАК ОкруглениеНалога
	|ПОМЕСТИТЬ ВТНомераСтрок
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК РасшифровкаНалогов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСтроки КАК Строки
	|		ПО РасшифровкаНалогов.СуммаНДС = Строки.СуммаНДС
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|	
	|ВЫБРАТЬ
	|	ЛОЖЬ КАК ЭтоНДС,
	|	МАКСИМУМ(РасшифровкаНалогов.НомерСтроки) КАК НомерСтроки,
	|	&СуммаОкругленияАкциза КАК ОкруглениеНалога
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК РасшифровкаНалогов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСтроки КАК Строки
	|		ПО РасшифровкаНалогов.СуммаАкциза = Строки.СуммаАкциза
	|;
	|////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасшифровкаНалогов.СуммаНДС - ЕстьNull(СтрокиНДС.ОкруглениеНалога, 0) КАК СуммаНДС,
	|	ВЫРАЗИТЬ((РасшифровкаНалогов.СуммаНДС - ЕстьNull(СтрокиНДС.ОкруглениеНалога, 0))
	|				* &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(31,2)) КАК СуммаНДСУУ,
	|	РасшифровкаНалогов.СуммаАкциза - ЕстьNull(СтрокиАкциз.ОкруглениеНалога, 0) КАК СуммаАкциза,
	|	ВЫРАЗИТЬ((РасшифровкаНалогов.СуммаАкциза  - ЕстьNull(СтрокиАкциз.ОкруглениеНалога, 0))
	|				* &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(31,2)) КАК СуммаАкцизаУУ,
	|	РасшифровкаНалогов.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТРасшифровкаНалогов
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК РасшифровкаНалогов
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТНомераСтрок КАК СтрокиНДС
	|		ПО РасшифровкаНалогов.НомерСтроки = СтрокиНДС.НомерСтроки
	|			И СтрокиНДС.ЭтоНДС
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТНомераСтрок КАК СтрокиАкциз
	|		ПО РасшифровкаНалогов.НомерСтроки = СтрокиАкциз.НомерСтроки
	|			И НЕ СтрокиАкциз.ЭтоНДС
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяТаблицы);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаРеестрДокументов(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "РеестрДокументов";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка                  КАК Ссылка,
	|	&Период                  КАК ДатаДокументаИБ,
	|	&Номер                   КАК НомерДокументаИБ,
	|	&ИдентификаторМетаданных КАК ТипСсылки,
	|	&Организация             КАК Организация,
	|	&ХозяйственнаяОперация   КАК ХозяйственнаяОперация,
	|	НЕОПРЕДЕЛЕНО             КАК Партнер,
	|	&Контрагент              КАК Контрагент,
	|	&Договор                 КАК Договор,
	|	&НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	НЕОПРЕДЕЛЕНО             КАК МестоХранения,
	|	&Подразделение           КАК Подразделение,
	|	&Автор                   КАК Ответственный,
	|	&Комментарий             КАК Комментарий,
	|	&Валюта                  КАК Валюта,
	|	&СуммаОбеспечительногоПлатежа КАК Сумма,
	
	
	|	&Проведен                КАК Проведен,
	|	&ПометкаУдаления         КАК ПометкаУдаления,
	|	ЛОЖЬ                     КАК ДополнительнаяЗапись,
	|	&ИнформацияПоДоговору    КАК Дополнительно,
	|	&ДатаДОПП                КАК ДатаПервичногоДокумента,
	|	&НомерДОПП               КАК НомерПервичногоДокумента,
	|	&Период                  КАК ДатаОтраженияВУчете,
	|	НЕОПРЕДЕЛЕНО             КАК Приоритет
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает результат адаптации текста запроса движений по регистру.
// 
// Параметры:
//  ИмяРегистра - Строка - имя регистра в конфигурации.
// 
// Возвращаемое значение:
//  см. ОбновлениеИнформационнойБазыУТ.РезультатАдаптацииЗапроса
//
Функция АдаптированныйТекстЗапросаДвиженийПоРегистру(ИмяРегистра) Экспорт
	
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый СписокЗначений;
	
	ПолноеИмяДокумента           = "Документ.ДокументОПредстоящейПоставке";
	СинонимТаблицыДокумента      = "";
	ВЗапросеЕстьИсточник         = Истина;
	ТекстыЗапросаВременныхТаблиц = Новый Соответствие();
	
	ПереопределениеРасчетаПараметров = Новый Структура;
	ПереопределениеРасчетаПараметров.Вставить("НомерНаПечать",        """""");
	ПереопределениеРасчетаПараметров.Вставить("ИнформацияПоДоговору", """""");
	
	ЗначенияПараметров = Новый Структура;
	ЗначенияПараметров.Вставить("ИдентификаторМетаданных",
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяДокумента));
	ЗначенияПараметров.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
	
	Если ИмяРегистра = "РеестрДокументов" Тогда
		
		ТекстЗапроса = ТекстЗапросаТаблицаРеестрДокументов(Запрос, ТекстыЗапроса, ИмяРегистра);
		СинонимТаблицыДокумента = "";
		ВЗапросеЕстьИсточник = Ложь;
		
	Иначе
		ТекстИсключения = НСтр("ru = 'В документе %ПолноеИмяДокумента% не реализована адаптация текста запроса формирования движений по регистру %ИмяРегистра%.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПолноеИмяДокумента%", 	ПолноеИмяДокумента);
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяРегистра%", 		ИмяРегистра);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если ИмяРегистра = "РеестрДокументов" Тогда
		
		ТекстЗапроса = ОбновлениеИнформационнойБазыУТ.АдаптироватьЗапросПроведенияПоНезависимомуРегистру(
			ТекстЗапроса,
			ПолноеИмяДокумента,
			СинонимТаблицыДокумента,
			ВЗапросеЕстьИсточник,
			ПереопределениеРасчетаПараметров,
			ТекстыЗапросаВременныхТаблиц);
		
	Иначе
		
		ТекстЗапроса = ОбновлениеИнформационнойБазыУТ.АдаптироватьЗапросМеханизмаПроведения(
			ТекстЗапроса,
			ПолноеИмяДокумента,
			СинонимТаблицыДокумента,
			ПереопределениеРасчетаПараметров,
			ТекстыЗапросаВременныхТаблиц);
		
	КонецЕсли;
	
	Результат = ОбновлениеИнформационнойБазыУТ.РезультатАдаптацииЗапроса();
	Результат.ЗначенияПараметров = ЗначенияПараметров;
	Результат.ТекстЗапроса = ТекстЗапроса;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#КонецОбласти

#КонецЕсли