// Возвращает данные для заполнения документа на основании Документ о предстоящей поставке .
//
// Параметры:
//   Ссылка - ДокументСсылка.ДокументОПредстоящейПоставке - Документ-основание
//
// Возвращаемое значение:
//   Структура:
//     * Шапка - Структура:
//         ** Организация - СправочникСсылка.Организации
//         ** Подразделение - СправочникСсылка.СтруктураПредприятия
//         ** Контрагент - СправочникСсылка.Контрагенты
//         ** Партнер - СправочникСсылка.Партнеры
//         ** Договор - СправочникСсылка.ДоговорыКонтрагентов
//         ** Валюта - СправочникСсылка.Валюты
//         ** НаправлениеДеятельности - СправочникСсылка.НаправленияДеятельности
//      * Товары - ТаблицаЗначений:
//         ** Номенклатура - СправочникСсылка.Номенклатура
//         ** Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры
//         ** Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения
//         ** Количество - Число
//         ** КоличествоУпаковок - Число
//         ** Сумма - Число
//         ** Цена - Число
//         ** НоменклатураПартнера - СправочникСсылка.НоменклатураКонтрагентов
Функция ДанныеЗаполненияНаОсновании(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	ТекстыЗапроса = Новый СписокЗначений;
	
	ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ДокументОПредстоящейПоставке.Организация             КАК Организация,
		|	ДокументОПредстоящейПоставке.Подразделение           КАК Подразделение,
		|	ДокументОПредстоящейПоставке.Контрагент              КАК Контрагент,
		|	ДокументОПредстоящейПоставке.Партнер                 КАК Партнер,
		|	ДокументОПредстоящейПоставке.Договор                 КАК Договор,
		|	ДокументОПредстоящейПоставке.Валюта                  КАК Валюта,
		|	ДокументОПредстоящейПоставке.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	ДоговорыКонтрагентов.ТипДоговора                     КАК ТипДоговора
		|ИЗ
		|	Документ.ДокументОПредстоящейПоставке КАК ДокументОПредстоящейПоставке
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ДокументОПредстоящейПоставке.Договор = ДоговорыКонтрагентов.Ссылка
		|ГДЕ
		|	ДокументОПредстоящейПоставке.Ссылка = &Ссылка",
		"Шапка");
	
	ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ТаблицаТовары.Номенклатура         КАК Номенклатура,
		|	ТаблицаТовары.НоменклатураПартнера КАК НоменклатураПартнера,
		|	ТаблицаТовары.Характеристика       КАК Характеристика,
		|	ТаблицаТовары.Упаковка             КАК Упаковка,
		|	ТаблицаТовары.Количество           КАК Количество,
		|	ТаблицаТовары.КоличествоУпаковок   КАК КоличествоУпаковок,
		|	ТаблицаТовары.ФактурнаяСтоимость   КАК Сумма,
		|	ТаблицаТовары.Цена                 КАК Цена
		|ИЗ
		|	Документ.ДокументОПредстоящейПоставке.Товары КАК ТаблицаТовары
		|ГДЕ
		|	ТаблицаТовары.Ссылка = &Ссылка",
		"Товары");

	РезультатПакета = ОбщегоНазначенияУТ.ПолучитьРезультатыЗапроса(Запрос, ТекстыЗапроса);
	
	РезультатЗапроса = РезультатПакета.Шапка; // РезультатЗапроса
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Шапка = Новый Структура;
	Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
		Шапка.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
	КонецЦикла;
	
	Товары = РезультатПакета.Товары.Выгрузить(); // ТаблицаЗначений
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Шапка", Шапка);
	ВозвращаемоеЗначение.Вставить("Товары", Товары);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Текст запроса заполнения табличной части товары.
// 
// Возвращаемое значение:
//  Строка - Текст запроса заполнения табличной части товары
Функция ТекстЗапросаЗаполненияТабличнойЧастиТовары() Экспорт
	
	ТекстЧастиЗапроса =
	"ВЫБРАТЬ
	|	ДокументОснованиеДОППТовары.НомерСтроки КАК НомерСтроки,
	|	ДокументОснованиеДОППТовары.Номенклатура КАК Номенклатура,
	|	ДокументОснованиеДОППТовары.Содержание КАК Содержание,
	|	ДокументОснованиеДОППТовары.НоменклатураПартнера КАК НоменклатураПартнера,
	|	ДокументОснованиеДОППТовары.Характеристика КАК Характеристика,
	|	ДокументОснованиеДОППТовары.Упаковка КАК Упаковка,
	|	ДокументОснованиеДОППТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ДокументОснованиеДОППТовары.Количество КАК Количество,
	|	ДокументОснованиеДОППТовары.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
	|	ДокументОснованиеДОППТовары.Цена КАК Цена,
	|	ДокументОснованиеДОППТовары.ОсобыйПризнакДОПП КАК ОсобыйПризнакДОПП,
	|	ДокументОснованиеДОППТовары.КодТНВЭД КАК КодТНВЭД,
	|	ДокументОснованиеДОППТовары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА КлючиВидовПродукцииИС.Ссылка ЕСТЬ NULL
	|			ИЛИ КлючиВидовПродукцииИС.ВидПродукцииГИСМТ = ЗНАЧЕНИЕ(Справочник.КлючиВидовПродукцииИС.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК МаркируемаяПродукция,
	|	ЕСТЬNULL(ПодакцизныеТовары.КоэффициентПересчетаЕдиницИзмерения, 0)
	|		 * ДокументОснованиеДОППТовары.Количество КАК НалоговаяБазаАкцизы,
	|	ЕСТЬNULL(ПодакцизныеТовары.Ставка, 0) КАК ТвердаяСтавкаАкциза,
	|	0 КАК АдвалорнаяСтавкаАкциза, // Адвалорная Ставка не поддерживается
	|	ЕСТЬNULL(ПодакцизныеТовары.СтавкаРегл, 0) * ЕСТЬNULL(ПодакцизныеТовары.КоэффициентПересчетаЕдиницИзмерения, 0)
	|		 * ДокументОснованиеДОППТовары.Количество КАК СуммаАкциза,
	|	ЕСТЬNULL(ПодакцизныеТовары.ПодакцизныйТовар, ЛОЖЬ) КАК ПодакцизныйТовар,
	|	ВЫБОР
	|		КОГДА СтавкиНДСНоменклатуры.Номенклатура ЕСТЬ NULL
	|			ТОГДА &ОсновнаяСтавкаНДС
	|		КОГДА СтавкиНДСНоменклатуры.СтавкаНДС.ПеречислениеСтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|			ТОГДА СтавкиНДСНоменклатуры.СтавкаНДС
	|		ИНАЧЕ
	|			&ОсновнаяСтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	0 КАК НалоговаяБазаНДС,
	|	0 КАК СуммаНДС,
	|	0 КАК ОбеспечительныйПлатеж,
	|	ВЫРАЗИТЬ("""" КАК Строка(20)) КАК КБК,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Код, """") КАК ЕдиницаИзмеренияАкциза,
	|	ЕСТЬNULL(ПодакцизныеТовары.КодАкциза, """") КАК КодАкциза,
	|	ЕСТЬNULL(ПодакцизныеТовары.КатегорияПодакцизногоТовара, ЗНАЧЕНИЕ(Справочник.КатегорииПодакцизныхТоваров.ПустаяСсылка)) КАК КатегорияПодакцизныхТоваров
	|ИЗ
	|	ВтТоварыОснования КАК ДокументОснованиеДОППТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодакцизныеТовары КАК ПодакцизныеТовары
	|			ПО ДокументОснованиеДОППТовары.Номенклатура = ПодакцизныеТовары.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНДСНоменклатуры.СрезПоследних(, Страна = &СтранаРегистрации) КАК СтавкиНДСНоменклатуры
	|			ПО ДокументОснованиеДОППТовары.Номенклатура = СтавкиНДСНоменклатуры.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|			ПО ДокументОснованиеДОППТовары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиВидовПродукцииИС КАК КлючиВидовПродукцииИС
	|			ПО ОписаниеНоменклатурыИС.КлючВидовПродукции = КлючиВидовПродукцииИС.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|			ПО ПодакцизныеТовары.ЕдиницаИзмеренияАкциза = УпаковкиЕдиницыИзмерения.Ссылка
	|";
	
	Возврат ТекстЧастиЗапроса;
	
КонецФункции

// Обновить структуру реквизитов выгрузки.
// 
// Параметры:
//  СтруктураРеквизитовВыгрузки - Структура реквизитов выгрузки
Процедура ОбновитьСтруктуруРеквизитовВыгрузки(СтруктураРеквизитовВыгрузки) Экспорт
	
	Если ТипЗнч(СтруктураРеквизитовВыгрузки) = Тип("Структура") Тогда
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ИмпортерСовпадаетСОтправителем") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ИмпортерСовпадаетСОтправителем", Истина);
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ИмпортерЯвляетсяЮЛ") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ИмпортерЯвляетсяЮЛ", Истина);
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("КтоИмпортирует") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("КтоИмпортирует", 1);
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("НаимИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("НаимИмпорт",  "");
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ИННЮЛИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ИННЮЛИмпорт", "");
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("КППИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("КППИмпорт",   "");
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ИННФЛИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ИННФЛИмпорт",      "");
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ФамилияФЛИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ФамилияФЛИмпорт",  "");
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ИмяФЛИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ИмяФЛИмпорт",      "");
		КонецЕсли;
		
		Если НЕ СтруктураРеквизитовВыгрузки.Свойство("ОтчествоФЛИмпорт") Тогда
			СтруктураРеквизитовВыгрузки.Вставить("ОтчествоФЛИмпорт", "");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


