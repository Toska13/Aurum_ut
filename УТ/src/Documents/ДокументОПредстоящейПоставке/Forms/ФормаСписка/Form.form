    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументДокументОПредстоящейПоставке.Ссылка КАК Ссылка,
	ДокументДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа - СУММА(
	ВЫБОР
		КОГДА ЕСТЬNULL(ДокументыОПредстоящейПоставке.Состояние, ЗНАЧЕНИЕ(Перечисление.СостояниеДОПП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СостояниеДОПП.ПустаяСсылка)
			ТОГДА 0
		ИНАЧЕ ДокументыОПредстоящейПоставке.СуммаНалога КОНЕЦ) КАК ОсталосьПринять,
	ДокументДокументОПредстоящейПоставке.Организация КАК Организация,
	ДокументДокументОПредстоящейПоставке.НомерДОПП КАК НомерДОПП,
	ДокументДокументОПредстоящейПоставке.Валюта КАК Валюта,
	ДокументДокументОПредстоящейПоставке.Номер КАК Номер,
	ДокументДокументОПредстоящейПоставке.Дата КАК Дата,
	ДокументДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа КАК СуммаОбеспечительногоПлатежа,
	ДокументДокументОПредстоящейПоставке.Контрагент КАК Контрагент,
	ДокументДокументОПредстоящейПоставке.Договор КАК Договор,
	ДокументДокументОПредстоящейПоставке.Проведен КАК Проведен,
	ДокументДокументОПредстоящейПоставке.ПометкаУдаления КАК ПометкаУдаления,
	МИНИМУМ(ВЫБОР
		КОГДА ЕСТЬNULL(ДокументыОПредстоящейПоставке.Состояние, ЗНАЧЕНИЕ(Перечисление.СостояниеДОПП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СостояниеДОПП.ПустаяСсылка)
		ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ) = 0 КАК ОжидаетсяПоставка,
	ДокументДокументОПредстоящейПоставке.Комментарий КАК Комментарий
ИЗ
	Документ.ДокументОПредстоящейПоставке КАК ДокументДокументОПредстоящейПоставке
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыОПредстоящейПоставке КАК ДокументыОПредстоящейПоставке
		ПО ДокументДокументОПредстоящейПоставке.Организация = ДокументыОПредстоящейПоставке.Организация
			И ДокументДокументОПредстоящейПоставке.НомерДОПП = ДокументыОПредстоящейПоставке.НомерДОПП

СГРУППИРОВАТЬ ПО
	ДокументДокументОПредстоящейПоставке.Ссылка,
	ДокументДокументОПредстоящейПоставке.Организация,
	ДокументДокументОПредстоящейПоставке.НомерДОПП,
	ДокументДокументОПредстоящейПоставке.Номер,
	ДокументДокументОПредстоящейПоставке.Дата,
	ДокументДокументОПредстоящейПоставке.Контрагент,
	ДокументДокументОПредстоящейПоставке.Валюта,
	ДокументДокументОПредстоящейПоставке.Проведен,
	ДокументДокументОПредстоящейПоставке.ПометкаУдаления,
	ДокументДокументОПредстоящейПоставке.Договор,
	ДокументДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа</queryText>
      <mainTable>Document.ДокументОПредстоящейПоставке</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
