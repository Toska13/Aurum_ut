
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.АУ_ПланФактБюджета.Записывать = Истина;
	
	Для Каждого ТекСтрокаСтатьиБюджета Из СтатьиБюджета Цикл
		
		Движение = Движения.АУ_ПланФактБюджета.Добавить();
		Движение.Период = НачалоМесяца(Месяц);
		Движение.Организация = Организация;
		Движение.СтатьяБюджета = ТекСтрокаСтатьиБюджета.СтатьяБюджета;
		Движение.СуммаПлан = ТекСтрокаСтатьиБюджета.Сумма;
		
	КонецЦикла;

КонецПроцедуры
