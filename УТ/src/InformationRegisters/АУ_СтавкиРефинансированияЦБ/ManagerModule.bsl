#Область Интерфейс

Функция ПолучитьСтавкуНаДату(Дата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АУ_СтавкиРефинансированияЦБСрезПоследних.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.АУ_СтавкиРефинансированияЦБ.СрезПоследних(&Дата, ) КАК АУ_СтавкиРефинансированияЦБСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Ставка <> NULL Тогда
		Возврат Выборка.Ставка;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти