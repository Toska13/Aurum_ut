  <attributes>
    <name>Классификатор</name>
    <title>
      <key>ru</key>
      <value>Классификатор</value>
    </title>
    <id>12</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Классификатор.ВидПродукции</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Классификатор.Загружен</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Классификатор.Код</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Классификатор.НаименованиеПолное</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ОКПД2ПоВидамПродукцииИС.Код,
	ОКПД2ПоВидамПродукцииИС.КодЧЗ,
	ОКПД2ПоВидамПродукцииИС.Ссылка,
	ОКПД2ПоВидамПродукцииИС.ПометкаУдаления,
	ОКПД2ПоВидамПродукцииИС.ВидПродукции,
	ОКПД2ПоВидамПродукцииИС.НаименованиеПолное,
	ВЫБОР
		КОГДА КодыОКПД2ИСМП.КодОКПД2 ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК Загружен
ИЗ
	Справочник.ОКПД2ПоВидамПродукцииИС КАК ОКПД2ПоВидамПродукцииИС
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыОКПД2ИСМП КАК КодыОКПД2ИСМП
		ПО ОКПД2ПоВидамПродукцииИС.Код = КодыОКПД2ИСМП.КодОКПД2
		И ОКПД2ПоВидамПродукцииИС.ВидПродукции = КодыОКПД2ИСМП.ВидПродукции
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеТНВЭДиОКПД2ИС КАК СоответствиеТНВЭДиОКПД2
		ПО ВЫБОР
				КОГДА &amp;ТНВЭД = ЗНАЧЕНИЕ(Справочник.ТНВЭДПоВидамПродукцииИС.ПустаяСсылка)
				ТОГДА ЛОЖЬ
				ИНАЧЕ ОКПД2ПоВидамПродукцииИС.Ссылка = СоответствиеТНВЭДиОКПД2.ОКПД2
			КОНЕЦ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			(ВЫБРАТЬ РАЗЛИЧНЫЕ ЗначенияЭлементовКонструктора.ВидПродукции КАК ВидПродукции
			ИЗ РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктора
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктора
				ПО ЗначенияЭлементовКонструктора.ЭлементКонструктора = ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора
				И ЗначенияЭлементовКонструктора.ВидПродукции = ЗначенияПользователяЭлементовКонструктора.ВидПродукции
			ГДЕ ЗначенияЭлементовКонструктора.ЭлементКонструктора = ЗНАЧЕНИЕ(Справочник.ЭлементыКонструктораВидовПродукцииИС.ВидыПродукцииГИСМТ)
				И ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора ЕСТЬ NULL
			ОБЪЕДИНИТЬ
			ВЫБРАТЬ ЗначенияПользователяЭлементовКонструктора.ВидПродукции
			ИЗ РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктора
			ГДЕ ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора = ЗНАЧЕНИЕ(Справочник.ЭлементыКонструктораВидовПродукцииИС.ВидыПродукцииГИСМТ)
				И НЕ ЗначенияПользователяЭлементовКонструктора.ПометкаУдаления
			) КАК ЗначенияВидыПродукции
		ПО ОКПД2ПоВидамПродукцииИС.ВидПродукции = ЗначенияВидыПродукции.ВидПродукции
ГДЕ
	ДЛИНАСТРОКИ(ОКПД2ПоВидамПродукцииИС.Код) = 12
	И ОКПД2ПоВидамПродукцииИС.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусыКлассификаторовВидовПродукцииИС.Архивный)
	И (&amp;ТНВЭД = ЗНАЧЕНИЕ(Справочник.ТНВЭДПоВидамПродукцииИС.ПустаяСсылка)
		ИЛИ СоответствиеТНВЭДиОКПД2.ТНВЭД = &amp;ТНВЭД)</queryText>
      <mainTable>Catalog.ОКПД2ПоВидамПродукцииИС</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
