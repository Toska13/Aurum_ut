					<v8:lang>ru</v8:lang>
					<v8:content>Сумма заказа</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заказ</dataPath>
			<field>Заказ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КраткийКод</dataPath>
			<field>КраткийКод</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Краткий код</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаОтгрузки</dataPath>
			<field>СуммаОтгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма отгрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Шифр</dataPath>
			<field>Шифр</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Шифр</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Дата</dataPath>
			<field>Дата</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проект</dataPath>
			<field>Проект</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Проект</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Договор</dataPath>
			<field>Договор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаОплаты</dataPath>
			<field>СуммаОплаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма оплаты</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоОтгрузки</dataPath>
			<field>КоличествоОтгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество отгрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Состояние</dataPath>
			<field>Состояние</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаВводаВЭсплуатацию</dataPath>
			<field>ДатаВводаВЭсплуатацию</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата ввода в эсплуатацию</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаГК</dataPath>
			<field>ДатаГК</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата ГК</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоДнейНаПоставку</dataPath>
			<field>КоличествоДнейНаПоставку</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество дней на поставку</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерГК</dataPath>
			<field>НомерГК</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер ГК</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	ПОДСТРОКА(СокрЛП(ВЫБОР
		КОГДА ЗаказКлиентаТовары.Характеристика &lt;&gt; ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			ТОГДА ПОДСТРОКА(ЗаказКлиентаТовары.Характеристика.Наименование, 1, 10)
		ИНАЧЕ ПОДСТРОКА(ЗаказКлиентаТовары.АУ_Шифр, 1, 10)
	КОНЕЦ), 1, 10) КАК Шифр,
	СУММА(ЗаказКлиентаТовары.СуммаСНДС) КАК СуммаЗаказа,
	ЗаказКлиентаТовары.Ссылка.Дата КАК Дата,
	ЗаказКлиентаТовары.Ссылка.Контрагент КАК Контрагент,
	ЗаказКлиентаТовары.Ссылка.Договор КАК Договор,
	ЗаказКлиентаТовары.Ссылка.АУ_Программа КАК Проект,
	ЗаказКлиентаТовары.Ссылка.Договор.АУ_КраткийНомер КАК КраткийКод,
	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	СостоянияЗаказовКлиентов.Состояние КАК Состояние,
	ЗаказКлиентаТовары.АУ_ДатаВводаВЭсплуатацию КАК ДатаВводаВЭсплуатацию
ПОМЕСТИТЬ ВТДанныеЗаказов
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ПО ЗаказКлиентаТовары.Ссылка = СостоянияЗаказовКлиентов.Заказ
ГДЕ
	ЗаказКлиентаТовары.Ссылка.Проведен
	И ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ПОДСТРОКА(СокрЛП(ВЫБОР
		КОГДА ЗаказКлиентаТовары.Характеристика &lt;&gt; ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			ТОГДА ПОДСТРОКА(ЗаказКлиентаТовары.Характеристика.Наименование, 1, 10)
		ИНАЧЕ ПОДСТРОКА(ЗаказКлиентаТовары.АУ_Шифр, 1, 10)
	КОНЕЦ), 1, 10),
	ЗаказКлиентаТовары.Ссылка,
	ЗаказКлиентаТовары.Номенклатура,
	ЗаказКлиентаТовары.Ссылка.Дата,
	ЗаказКлиентаТовары.Ссылка.Контрагент,
	ЗаказКлиентаТовары.Ссылка.Договор,
	ЗаказКлиентаТовары.Ссылка.АУ_Программа,
	ЗаказКлиентаТовары.Ссылка.Договор.АУ_КраткийНомер,
	СостоянияЗаказовКлиентов.Состояние,
	ЗаказКлиентаТовары.АУ_ДатаВводаВЭсплуатацию
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Оплаты.ЗаказКлиента КАК ЗаказКлиента,
	Оплаты.Номенклатура КАК Номенклатура,
	Оплаты.Шифр КАК Шифр,
	СУММА(Оплаты.СуммаПриход) КАК СуммаОплаты
ПОМЕСТИТЬ ВТОплатыСводно
ИЗ
	РегистрНакопления.АУ_ОплатаПоШифрам КАК Оплаты
ГДЕ
	Оплаты.Активность
	И Оплаты.ЗаказКлиента В
			(ВЫБРАТЬ
				Т.Заказ
			ИЗ
				ВТДанныеЗаказов КАК Т)
	И Оплаты.СуммаПриход &lt;&gt; 0

СГРУППИРОВАТЬ ПО
	Оплаты.ЗаказКлиента,
	Оплаты.Номенклатура,
	Оплаты.Шифр
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	СУММА(РеализацияТоваровУслугТовары.Количество) КАК КоличествоОтгрузки,
	СУММА(РеализацияТоваровУслугТовары.СуммаСНДС) КАК СуммаОтгрузки,
	ВЫБОР
		КОГДА РеализацияТоваровУслугТовары.ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
			ТОГДА РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента
		ИНАЧЕ РеализацияТоваровУслугТовары.ЗаказКлиента
	КОНЕЦ КАК ЗаказКлиента,
	ПОДСТРОКА(СокрЛП(ВЫБОР
		КОГДА РеализацияТоваровУслугТовары.Характеристика &lt;&gt; ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			ТОГДА ПОДСТРОКА(РеализацияТоваровУслугТовары.Характеристика.Наименование, 1, 10)
		ИНАЧЕ ПОДСТРОКА(РеализацияТоваровУслугТовары.АУ_Шифр, 1, 10)
	КОНЕЦ), 1, 10) КАК Шифр,
	РеализацияТоваровУслугТовары.Ссылка КАК ДокументОтгрузки
ПОМЕСТИТЬ ВТОтгрузкаПоДокументам
ИЗ
	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
ГДЕ
	РеализацияТоваровУслугТовары.Ссылка.Проведен
	И (РеализацияТоваровУслугТовары.ЗаказКлиента В
				(ВЫБРАТЬ
					Т.Заказ
				ИЗ
					ВТДанныеЗаказов КАК Т)
			ИЛИ РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента В
				(ВЫБРАТЬ
					Т.Заказ
				ИЗ
					ВТДанныеЗаказов КАК Т))

СГРУППИРОВАТЬ ПО
	ПОДСТРОКА(СокрЛП(ВЫБОР
		КОГДА РеализацияТоваровУслугТовары.Характеристика &lt;&gt; ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			ТОГДА ПОДСТРОКА(РеализацияТоваровУслугТовары.Характеристика.Наименование, 1, 10)
		ИНАЧЕ ПОДСТРОКА(РеализацияТоваровУслугТовары.АУ_Шифр, 1, 10)
	КОНЕЦ), 1, 10),
	ВЫБОР
		КОГДА РеализацияТоваровУслугТовары.ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
			ТОГДА РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента
		ИНАЧЕ РеализацияТоваровУслугТовары.ЗаказКлиента
	КОНЕЦ,
	РеализацияТоваровУслугТовары.Ссылка,
	РеализацияТоваровУслугТовары.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТОтгрузкаПоДокументам.Номенклатура КАК Номенклатура,
	СУММА(ВТОтгрузкаПоДокументам.КоличествоОтгрузки) КАК КоличествоОтгрузки,
	СУММА(ВТОтгрузкаПоДокументам.СуммаОтгрузки) КАК СуммаОтгрузки,
	ВТОтгрузкаПоДокументам.ЗаказКлиента КАК ЗаказКлиента,
	ВТОтгрузкаПоДокументам.Шифр КАК Шифр
ПОМЕСТИТЬ ВТОтгрузкаСводно
ИЗ
	ВТОтгрузкаПоДокументам КАК ВТОтгрузкаПоДокументам

СГРУППИРОВАТЬ ПО
	ВТОтгрузкаПоДокументам.Шифр,
	ВТОтгрузкаПоДокументам.ЗаказКлиента,
	ВТОтгрузкаПоДокументам.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТДанныеЗаказов.Заказ КАК Заказ,
	ВТДанныеЗаказов.Номенклатура КАК Номенклатура,
	ВТДанныеЗаказов.Шифр КАК Шифр,
	ВТДанныеЗаказов.СуммаЗаказа КАК СуммаЗаказа,
	ВТДанныеЗаказов.Дата КАК Дата,
	ВТДанныеЗаказов.Контрагент КАК Контрагент,
	ВТДанныеЗаказов.Договор КАК Договор,
	ВТДанныеЗаказов.Проект КАК Проект,
	ВТДанныеЗаказов.КраткийКод КАК КраткийКод,
	ВТДанныеЗаказов.Количество КАК Количество,
	ВТОплатыСводно.СуммаОплаты КАК СуммаОплаты,
	ВТОтгрузкаСводно.КоличествоОтгрузки КАК КоличествоОтгрузки,
	ВТОтгрузкаСводно.СуммаОтгрузки КАК СуммаОтгрузки,
	ВТДанныеЗаказов.Состояние КАК Состояние,
	ВТДанныеЗаказов.ДатаВводаВЭсплуатацию КАК ДатаВводаВЭсплуатацию,
	ВТДанныеЗаказов.Договор.АУ_КоличествоДнейНаПоставку КАК КоличествоДнейНаПоставку,
	ВТДанныеЗаказов.Договор.Номер КАК НомерГК,
	ВТДанныеЗаказов.Договор.Дата КАК ДатаГК
ИЗ
	ВТДанныеЗаказов КАК ВТДанныеЗаказов
		ЛЕВОЕ СОЕДИНЕНИЕ ВТОплатыСводно КАК ВТОплатыСводно
		ПО ВТДанныеЗаказов.Заказ = ВТОплатыСводно.ЗаказКлиента
			И ВТДанныеЗаказов.Шифр = ВТОплатыСводно.Шифр
			И ВТДанныеЗаказов.Номенклатура = ВТОплатыСводно.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТОтгрузкаСводно КАК ВТОтгрузкаСводно
		ПО ВТДанныеЗаказов.Заказ = ВТОтгрузкаСводно.ЗаказКлиента
			И ВТДанныеЗаказов.Шифр = ВТОтгрузкаСводно.Шифр
			И ВТДанныеЗаказов.Номенклатура = ВТОтгрузкаСводно.Номенклатура</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>РасшифровкаОплат</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказКлиента</dataPath>
			<field>ЗаказКлиента</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОплаты</dataPath>
			<field>ДокументОплаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ оплаты</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Шифр</dataPath>
			<field>Шифр</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОплаты</dataPath>
			<field>ДатаОплаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата оплаты</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказКлиента.Ссылка КАК Заказ
ПОМЕСТИТЬ ВТДанныеЗаказов
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Ссылка.Проведен
	И ЗаказКлиента.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	Оплаты.ЗаказКлиента КАК ЗаказКлиента,
	Оплаты.Номенклатура КАК Номенклатура,
	Оплаты.Шифр КАК Шифр,
	Оплаты.ДокументОплаты КАК ДокументОплаты,
	ЕСТЬNULL(Поступление.ДатаПроведенияБанком, ПКО.Дата) КАК ДатаОплаты
ИЗ
	РегистрНакопления.АУ_ОплатаПоШифрам КАК Оплаты
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств КАК Поступление
		ПО Оплаты.ДокументОплаты = Поступление.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК ПКО
		ПО Оплаты.ДокументОплаты = ПКО.Ссылка
ГДЕ
	Оплаты.Активность
	И Оплаты.ЗаказКлиента В
			(ВЫБРАТЬ
				Т.Заказ
			ИЗ
				ВТДанныеЗаказов КАК Т)
	И Оплаты.СуммаПриход &lt;&gt; 0</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>РасшифровкаОтгрузки</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаОтгрузки</dataPath>
			<field>СуммаОтгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма отгрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоОтгрузки</dataPath>
			<field>КоличествоОтгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество отгрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказКлиента</dataPath>
			<field>ЗаказКлиента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказ клиента</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Шифр</dataPath>
			<field>Шифр</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Шифр</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОтгрузки</dataPath>
			<field>ДокументОтгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ отгрузки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОтгрузки</dataPath>
			<field>ДатаОтгрузки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата отгрузки</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказКлиента.Ссылка КАК Заказ
ПОМЕСТИТЬ ВТДанныеЗаказов
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Ссылка.Проведен
	И ЗаказКлиента.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	РеализацияТоваровУслугТовары.Количество КАК КоличествоОтгрузки,
	РеализацияТоваровУслугТовары.СуммаСНДС КАК СуммаОтгрузки,
	ВЫБОР
		КОГДА РеализацияТоваровУслугТовары.ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
			ТОГДА РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента
		ИНАЧЕ РеализацияТоваровУслугТовары.ЗаказКлиента
	КОНЕЦ КАК ЗаказКлиента,
	РеализацияТоваровУслугТовары.АУ_Шифр КАК Шифр,
	РеализацияТоваровУслугТовары.Ссылка КАК ДокументОтгрузки,
	РеализацияТоваровУслугТовары.Ссылка.Дата КАК ДатаОтгрузки
ИЗ
	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
ГДЕ
	РеализацияТоваровУслугТовары.Ссылка.Проведен
	И (РеализацияТоваровУслугТовары.ЗаказКлиента В
				(ВЫБРАТЬ
					Т.Заказ
				ИЗ
					ВТДанныеЗаказов КАК Т)
			ИЛИ РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента В
				(ВЫБРАТЬ
					Т.Заказ
				ИЗ
					ВТДанныеЗаказов КАК Т))</query>
	</dataSet>
