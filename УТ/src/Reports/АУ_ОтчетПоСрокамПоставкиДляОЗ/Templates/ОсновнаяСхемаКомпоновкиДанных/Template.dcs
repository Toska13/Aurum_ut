		<field xsi:type="DataSetFieldField">
			<dataPath>НомерНакладнойПоставщика</dataPath>
			<field>НомерНакладнойПоставщика</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер накладной поставщика</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерСчетаЗакупки</dataPath>
			<field>НомерСчетаЗакупки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер счета закупки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаСчетаПоставщика</dataPath>
			<field>ДатаСчетаПоставщика</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата счета поставщика</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерРУ</dataPath>
			<field>НомерРУ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер РУ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПроцентОплаты</dataPath>
			<field>ПроцентОплаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>% оплаты</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА ЗаказПоставщикуТовары.АУ_ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
			ТОГДА ЗаказПоставщикуТовары.Ссылка.ДокументОснование
		ИНАЧЕ ЗаказПоставщикуТовары.АУ_ЗаказКлиента
	КОНЕЦ КАК ЗаказКлиента,
	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	ЗаказПоставщикуТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	ЗаказПоставщикуТовары.Цена КАК Цена,
	ЗаказПоставщикуТовары.СуммаСНДС КАК СуммаСНДС,
	ЗаказПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
	ЗаказПоставщикуТовары.СуммаНДС КАК СуммаНДС,
	ЗаказПоставщикуТовары.Ссылка.Валюта КАК Валюта,
	ЗаказПоставщикуТовары.Ссылка.Контрагент КАК Контрагент,
	ЗаказПоставщикуТовары.Ссылка.Договор КАК Договор,
	ЗаказПоставщикуТовары.Ссылка.Комментарий КАК Комментарий,
	ЗаказПоставщикуТовары.Ссылка.ЖелаемаяДатаПоступления КАК ЖелаемаяДатаПоступления,
	ЗаказПоставщикуТовары.ДатаПоступления КАК ДатаПоступления,
	ЗаказПоставщикуТовары.АУ_КодСтроки КАК АУ_КодСтроки,
	ЗаказПоставщикуТовары.Ссылка.АУ_КоличествоДнейДоПоставки КАК АУ_КоличествоДнейДоПоставки,
	ЗаказПоставщикуТовары.Ссылка.ДлительностьДоставки КАК ДлительностьДоставки
ПОМЕСТИТЬ ВТЗаказыПоставщику
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
ГДЕ
	ЗаказПоставщикуТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца
	И ЗаказПоставщикуТовары.Ссылка.Проведен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ЗаказКлиентаТовары.Цена) КАК Цена,
	МАКСИМУМ(ЗаказКлиентаТовары.СуммаСНДС) КАК СуммаСНДС,
	МАКСИМУМ(ЗаказКлиентаТовары.СуммаНДС) КАК СуммаНДС,
	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	МАКСИМУМ(ЗаказКлиентаТовары.СтавкаНДС) КАК СтавкаНДС
ПОМЕСТИТЬ ВТЗаказыКлиентовТовары
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
ГДЕ
	ЗаказКлиентаТовары.Ссылка В
			(ВЫБРАТЬ
				Т.ЗаказКлиента
			ИЗ
				ВТЗаказыПоставщику КАК Т)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Номенклатура,
	ЗаказКлиентаТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ЗаказКлиентаТовары.Цена) КАК Цена,
	МАКСИМУМ(ЗаказКлиентаТовары.СуммаСНДС) КАК СуммаСНДС,
	МАКСИМУМ(ЗаказКлиентаТовары.СуммаНДС) КАК СуммаНДС,
	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	ЗаказКлиентаТовары.АУ_КодСтроки КАК АУ_КодСтроки,
	МАКСИМУМ(ЗаказКлиентаТовары.СтавкаНДС) КАК СтавкаНДС
ПОМЕСТИТЬ ВТЗаказыКлиентовТоварыПоКодамСтрок
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
ГДЕ
	ЗаказКлиентаТовары.Ссылка В
			(ВЫБРАТЬ
				Т.ЗаказКлиента
			ИЗ
				ВТЗаказыПоставщику КАК Т)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Номенклатура,
	ЗаказКлиентаТовары.Ссылка,
	ЗаказКлиентаТовары.АУ_КодСтроки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТЗаказыПоставщику.ЗаказКлиента КАК ЗаказКлиента,
	ВТЗаказыПоставщику.ЗаказПоставщику КАК ЗаказПоставщику,
	ВТЗаказыПоставщику.ЗаказКлиента.Номер КАК НомерЗаказаКлиента,
	ВТЗаказыПоставщику.ЗаказПоставщику.Номер КАК НомерЗаказаПоставщику,
	ВЫБОР
		КОГДА ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента ЕСТЬ NULL
			ТОГДА ВТЗаказыКлиентовТовары.ЗаказКлиента.ДатаОтгрузки
		ИНАЧЕ ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента.ДатаОтгрузки
	КОНЕЦ КАК СрокИсполненияКонтракта,
	ВТЗаказыПоставщику.ЖелаемаяДатаПоступления КАК ЖелаемаяДатаПоступления,
	ВТЗаказыПоставщику.ЗаказПоставщику.Менеджер КАК МенеджерОтделаЗакупок,
	ВЫБОР
		КОГДА ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента ЕСТЬ NULL
			ТОГДА ВТЗаказыКлиентовТовары.ЗаказКлиента.Менеджер
		ИНАЧЕ ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента.Менеджер
	КОНЕЦ КАК МенеджерКО,
	ВТЗаказыПоставщику.Контрагент КАК Поставщик,
	СостоянияЗаказовПоставщикам.Состояние КАК Статус,
	ВТЗаказыПоставщику.ЗаказПоставщику.Комментарий КАК Комментарий,
	ВТЗаказыПоставщику.Номенклатура КАК Номенклатура,
	ВТЗаказыПоставщику.Номенклатура.Производитель КАК Производитель,
	ВТЗаказыПоставщику.Номенклатура.Код КАК Код,
	ВТЗаказыПоставщику.Номенклатура.Артикул КАК Артикул,
	ВТЗаказыПоставщику.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ВТЗаказыПоставщику.КоличествоУпаковок КАК Количество,
	ВЫБОР
		КОГДА ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента ЕСТЬ NULL
			ТОГДА ВТЗаказыКлиентовТовары.Цена
		ИНАЧЕ ВТЗаказыКлиентовТоварыПоКодамСтрок.Цена
	КОНЕЦ КАК ЦенаПродажи,
	ВЫБОР
		КОГДА ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента ЕСТЬ NULL
			ТОГДА ВТЗаказыКлиентовТовары.СтавкаНДС
		ИНАЧЕ ВТЗаказыКлиентовТоварыПоКодамСтрок.СтавкаНДС
	КОНЕЦ КАК СтавкаНДСПродажи,
	ВЫБОР
		КОГДА ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента ЕСТЬ NULL
			ТОГДА ВТЗаказыКлиентовТовары.Цена * ВТЗаказыПоставщику.КоличествоУпаковок
		ИНАЧЕ ВТЗаказыКлиентовТоварыПоКодамСтрок.Цена * ВТЗаказыПоставщику.КоличествоУпаковок
	КОНЕЦ КАК СуммаПродажи,
	ВТЗаказыПоставщику.Цена КАК ЦенаЗакупки,
	ВТЗаказыПоставщику.СуммаСНДС КАК СуммаЗакупки,
	ВТЗаказыПоставщику.СтавкаНДС КАК НДСЗакупки,
	ВТЗаказыПоставщику.ЗаказПоставщику.Валюта КАК ВалютаЗакупки,
	ВЫБОР
		КОГДА ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента ЕСТЬ NULL
			ТОГДА ВТЗаказыКлиентовТовары.ЗаказКлиента.Контрагент
		ИНАЧЕ ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента.Контрагент
	КОНЕЦ КАК Покупатель,
	ВТЗаказыПоставщику.ЗаказПоставщику.Договор КАК ДоговорЗакупки,
	ВТЗаказыПоставщику.АУ_КоличествоДнейДоПоставки КАК СрокПоставки,
	ВТЗаказыПоставщику.ЗаказПоставщику.СпособДоставки КАК СпособДоставки,
	"" КАК НомерСчетаЗакупки,
	"" КАК ДатаСчетаПоставщика,
	"" КАК НомерНакладнойПоставщика,
	ЕСТЬNULL(НомераРУ.Значение, "") КАК НомерРУ,
	ЕСТЬNULL(СостоянияЗаказовПоставщикам.ПроцентОплаты,0) КАК ПроцентОплаты
ИЗ
	ВТЗаказыПоставщику КАК ВТЗаказыПоставщику
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказыКлиентовТовары КАК ВТЗаказыКлиентовТовары
		ПО ВТЗаказыПоставщику.ЗаказКлиента = ВТЗаказыКлиентовТовары.ЗаказКлиента
			И ВТЗаказыПоставщику.Номенклатура = ВТЗаказыКлиентовТовары.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказыКлиентовТоварыПоКодамСтрок КАК ВТЗаказыКлиентовТоварыПоКодамСтрок
		ПО ВТЗаказыПоставщику.ЗаказКлиента = ВТЗаказыКлиентовТоварыПоКодамСтрок.ЗаказКлиента
			И ВТЗаказыПоставщику.АУ_КодСтроки = ВТЗаказыКлиентовТоварыПоКодамСтрок.АУ_КодСтроки
			И ВТЗаказыПоставщику.Номенклатура = ВТЗаказыКлиентовТоварыПоКодамСтрок.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НомераРУ
		ПО ВТЗаказыПоставщику.Номенклатура = НомераРУ.Ссылка
			И (НомераРУ.Свойство.Имя = "НомерРУ_73fb8c2093594a688f4375e5da1fbeb2")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовПоставщикам КАК СостоянияЗаказовПоставщикам
		ПО ВТЗаказыПоставщику.ЗаказПоставщику = СостоянияЗаказовПоставщикам.Заказ</query>
	</dataSet>
