		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Документ</dataPath>
			<field>Документ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Контрагент</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	АУ_ПланФактБюджетаОбороты.Организация КАК Организация,
	АУ_ПланФактБюджетаОбороты.СтатьяБюджета КАК СтатьяБюджета,
	АУ_ПланФактБюджетаОбороты.СуммаПланОборот КАК План,
	АУ_ПланФактБюджетаОбороты.СуммаФактОборот КАК Факт,
	АУ_ПланФактБюджетаОбороты.ПериодМесяц КАК Месяц,
	АУ_ПланФактБюджетаОбороты.СуммаФактОборот - АУ_ПланФактБюджетаОбороты.СуммаПланОборот КАК Отклонение,
	ВЫБОР
		КОГДА АУ_ПланФактБюджетаОбороты.СуммаПланОборот &lt;&gt; 0
			ТОГДА (АУ_ПланФактБюджетаОбороты.СуммаФактОборот - АУ_ПланФактБюджетаОбороты.СуммаПланОборот) / АУ_ПланФактБюджетаОбороты.СуммаПланОборот
		ИНАЧЕ 0
	КОНЕЦ КАК ОтклонениеПроцент,
	АУ_ПланФактБюджетаОбороты.ПериодКвартал КАК Квартал,
	АУ_ПланФактБюджетаОбороты.Регистратор КАК Документ,
	АУ_ПланФактБюджетаОбороты.Регистратор.Контрагент КАК Контрагент
ИЗ
	РегистрНакопления.АУ_ПланФактБюджета.Обороты({(&amp;ДатаНачала)}, {(КОНЕЦПЕРИОДА(&amp;ДатаКонца, ДЕНЬ))}, Авто, ) КАК АУ_ПланФактБюджетаОбороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	NULL,
	АУ_СтатьиБюджета.Ссылка,
	0,
	0,
	НАЧАЛОПЕРИОДА(&amp;ДатаНачала, МЕСЯЦ),
	0,
	0,
	НАЧАЛОПЕРИОДА(&amp;ДатаНачала, КВАРТАЛ),
	NULL,
	NULL
ИЗ
	Справочник.АУ_СтатьиБюджета КАК АУ_СтатьиБюджета
ГДЕ
	НЕ АУ_СтатьиБюджета.НеИспользуется</query>
	</dataSet>
	<totalField>
		<dataPath>План</dataPath>
		<expression>Сумма(План)</expression>
	</totalField>
	<totalField>
		<dataPath>Факт</dataPath>
		<expression>Сумма(Факт)</expression>
	</totalField>
	<totalField>
		<dataPath>Отклонение</dataPath>
		<expression>Сумма(Отклонение)</expression>
	</totalField>
	<totalField>
		<dataPath>ОтклонениеПроцент</dataPath>
		<expression>ВЫБОР КОГДА Сумма(План)&lt;&gt;0 ТОГДА (Сумма(Факт)-Сумма(План))*100/Сумма(План) ИНАЧЕ 0 КОНЕЦ</expression>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ДатаКонца</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
