		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка КАК Документ,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.СтатьяБюджета КАК СтатьяБюджета,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Сумма КАК ЧастнаяСуммаСписание,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.ДатаБюджета КАК ДатаБюджета,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Программа КАК Программа,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Объект КАК Объект,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.НомерКонтракта КАК НомерКонтракта,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.ЗаказКлиента КАК ЗаказКлиента,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Комментарий КАК Комментарий,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Шифр КАК Шифр,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Номер КАК Номер,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Дата КАК Дата,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.ДатаПроведенияБанком КАК ДатаПроведенияБанком,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.НазначениеПлатежа КАК НазначениеПлатежа,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.СуммаДокумента КАК Списание,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Валюта КАК Валюта,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Контрагент КАК Контрагент,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.ПризнакРасходов КАК ПризнакРасходов,
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.СтатьяБюджета.Код КАК КодСтатьи,
	0 КАК Поступление,
	0 КАК ЧастнаяСуммаПоступление
ИЗ
	Документ.СписаниеБезналичныхДенежныхСредств.АУ_СтатьиБюджета КАК СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета
ГДЕ
	СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Проведен
	И СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.ПроведеноБанком
	И СписаниеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.ДатаПроведенияБанком МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.СтатьяБюджета,
	0,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.ДатаБюджета,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Программа,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Объект,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.НомерКонтракта,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.ЗаказКлиента,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Комментарий,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Шифр,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Номер,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Дата,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.ДатаПроведенияБанком,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.НазначениеПлатежа,
	0,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Валюта,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Контрагент,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.ПризнакРасходов,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.СтатьяБюджета.Код,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.СуммаДокумента,
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Сумма
ИЗ
	Документ.ПоступлениеБезналичныхДенежныхСредств.АУ_СтатьиБюджета КАК ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета
ГДЕ
	ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.Проведен
	И ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.ПроведеноБанком
	И ПоступлениеБезналичныхДенежныхСредствАУ_СтатьиБюджета.Ссылка.ДатаПроведенияБанком МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца</query>
	</dataSet>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаНачала</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ДатаКонца</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата конца</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>КОНЕЦПЕРИОДА(&amp;ПериодОтчета.ДатаОкончания, "ДЕНЬ")</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ПериодОтчета</name>
