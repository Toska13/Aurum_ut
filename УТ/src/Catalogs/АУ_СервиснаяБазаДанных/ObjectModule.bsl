
Процедура ПередЗаписью(Отказ)
	
	Массив=Новый Массив;
	Массив.Добавить(СокрЛП(Прибор));
	Если ЗначениеЗаполнено(СерийныйНомер) Тогда
		Массив.Добавить(СокрЛП(СерийныйНомер));
	КонецЕсли;
	Если ЗначениеЗаполнено(НаименованиеЛПУ) Тогда
		Массив.Добавить(СокрЛП(НаименованиеЛПУ));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПодразделениеЛПУ) Тогда
		Массив.Добавить(СокрЛП(ПодразделениеЛПУ));
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресУстановки) Тогда
		Массив.Добавить(СокрЛП(АдресУстановки));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаМонтажа) Тогда
		Массив.Добавить(СокрЛП(ДатаМонтажа));
	КонецЕсли;
	
	Наименование=СтрСоединить(Массив,", ");
	
КонецПроцедуры
