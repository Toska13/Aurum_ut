
Процедура ПередЗаписью(Отказ)
	
	СтрокаСортировки="";
	
	МассивКодов=СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(Код),".");
	
	Для каждого стрКод Из МассивКодов Цикл
		
		Если СтрДлина(стрКод)=1 Тогда
			СтрокаСортировки=СтрокаСортировки+"."+"0"+стрКод;
		Иначе
			СтрокаСортировки=СтрокаСортировки+"."+стрКод;
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаСортировки=Сред(СтрокаСортировки,2);
	
КонецПроцедуры
