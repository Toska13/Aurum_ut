КонецФункции

Функция ПроверитьГотовностьНоменклатурнойПозиции(Знач УникальныйИдентификатор, Знач Организация, Знач Номенклатура, 
			Знач Состояние) Экспорт
	
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Если Номенклатура.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПервыйЭлемент = Номенклатура[0];
		Если НЕ Метаданные.ОпределяемыеТипы.НоменклатураРаботаСНоменклатурой.Тип.СодержитТип(ТипЗнч(ПервыйЭлемент)) Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПервыйЭлемент, "Номенклатура") Тогда
				МассивНоменклатуры = Новый Массив;
				Для каждого ЭлементМассива Из Номенклатура Цикл
					МассивНоменклатуры.Добавить(ЭлементМассива.Номенклатура);
				КонецЦикла;
				Номенклатура = МассивНоменклатуры;
			Иначе
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НаименованиеЗадания = НСтр("ru = 'Работа с номенклатурой. Проверка готовности номенклатурной позиции к выгрузке'");
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, 
		"РаботаСНоменклатуройСлужебный.ПроверитьГотовностьНоменклатурнойПозиции", 
		Организация, 
		Номенклатура, 
		Состояние);
	
КонецФункции

Функция ФоновыеЗаданияВыгрузки(ОбновлятьКлючи = Истина) Экспорт 
	
	КлючиВыгрузки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("РаботаСНоменклатурой", "ПомощникВыгрузки\КлючиВыгрузки");
	Если ТипЗнч(КлючиВыгрузки) <> Тип("Массив") ИЛИ КлючиВыгрузки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РазделениеВключено = ОбщегоНазначения.РазделениеВключено();
	Если РазделениеВключено Тогда
		КлючЗадания = "ВыгрузкаНоменклатуры" + Строка(ПараметрыСеанса.ОбластьДанныхЗначение);
	Иначе
		КлючЗадания = "ВыгрузкаНоменклатуры";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат        = Новый Массив;
	КоличествоКлючей = КлючиВыгрузки.Количество();
	Для ОбратныйИндекс = 1 По КоличествоКлючей Цикл
		Организация = КлючиВыгрузки[КоличествоКлючей - ОбратныйИндекс];
		Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ", КлючЗадания + XMLСтрока(Организация)));
		Если Задания.Количество() И Задания[0].Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Продолжить;
		ИначеЕсли Задания.Количество() И Задания[0].Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Результат.Добавить(Организация);
		КонецЕсли;
		Если ОбновлятьКлючи = Истина Тогда
			КлючиВыгрузки.Удалить(КоличествоКлючей - ОбратныйИндекс);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ОбновлятьКлючи = Истина Тогда
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("РаботаСНоменклатурой", "ПомощникВыгрузки\КлючиВыгрузки", КлючиВыгрузки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

