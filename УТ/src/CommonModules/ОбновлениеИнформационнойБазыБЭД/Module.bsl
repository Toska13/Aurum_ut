Процедура ПервыйЗапуск() Экспорт
	
	СоздатьКлючевыеОперацииЗамеровПроизводительности();
	
КонецПроцедуры

// Параметры:
//  Имя - Строка
//  Наименование - Строка
//  ЦелевоеВремя - Число
//  Приоритет - Число
// 
// Возвращаемое значение:
//  Структура:
// * ИмяКлючевойОперации - Строка
// * Наименование - Строка
// * ЦелевоеВремя - Число
// * Приоритет - Число
Функция КлючеваяОперацияЗамера(Имя, Наименование, ЦелевоеВремя = 0, Приоритет = 0)
	Результат = Новый Структура;
	Результат.Вставить("ИмяКлючевойОперации", Имя);
	Результат.Вставить("Наименование", Наименование);
	Результат.Вставить("ЦелевоеВремя", ЦелевоеВремя);
	Результат.Вставить("Приоритет", Приоритет);
	Возврат Результат;
КонецФункции

// Параметры:
//  КлючеваяОперацияЗамера - Произвольный
//  Приоритет - Число
Процедура УстановитьРеквизитыКлючевойОперации(КлючеваяОперацияЗамера, Приоритет)
	
	СсылкаНаКлючевуюОперацию = ОценкаПроизводительностиПовтИсп.ПолучитьКлючевуюОперациюПоИмени(
			КлючеваяОперацияЗамера.ИмяКлючевойОперации);
	
	СпрОбъект = СсылкаНаКлючевуюОперацию.ПолучитьОбъект();

	СпрОбъект.ДополнительныеСвойства.Вставить(ОценкаПроизводительностиКлиентСервер.НеПроверятьПриоритет());
	
	СпрОбъект.ПометкаУдаления = Ложь;
	СпрОбъект.Имя = КлючеваяОперацияЗамера.ИмяКлючевойОперации;
	СпрОбъект.Наименование = КлючеваяОперацияЗамера.Наименование;
	СпрОбъект.МинимальноДопустимыйУровень = Перечисления.УровниПроизводительности.Хорошо;
	Если НЕ ЗначениеЗаполнено(СпрОбъект.Приоритет) Тогда
		СпрОбъект.Приоритет = Приоритет;
	КонецЕсли;
	СпрОбъект.ЦелевоеВремя = КлючеваяОперацияЗамера.ЦелевоеВремя;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(СпрОбъект, Ложь, Ложь);
	
КонецПроцедуры

