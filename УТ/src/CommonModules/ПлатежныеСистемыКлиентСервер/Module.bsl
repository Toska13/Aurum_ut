// Подсистема "ИнтернетПоддержкаПользователей.ПлатежныеСистемы.БазоваяФункциональностьПлатежныхСистем".
// ОбщийМодуль.ПлатежныеСистемыКлиентСервер.
//
// Клиент-серверные процедуры статических идентификаторов:
//  - получение типов операции;
//  - получение имени события подсистемы для журнала регистрации.
//
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ПроверкаДоступности

// Формирует описание доступности общих методов для всех платежных систем.
// Информация формируется независимо от внедрения подсистем в конфигурацию.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - данные о доступности методов:
//   * Ключ - Строка - имя подсистемы. Задается методами
//            НастройкиПлатежныхСистемКлиентСервер.ИмяПодсистемыОзонПэй
//            НастройкиПлатежныхСистемКлиентСервер.ИмяПодсистемыЯндексПэй
//   * Значение - Структура - доступность метода. Если метод недоступен, то при его вызове будет сгенерировано
//            сообщение об ошибке. Содержит следующие свойства:
//     ** КассоваяСсылка - Булево - Истина, если для подсистемы доступна работа с кассовыми ссылками.
//     ** ДинамическаяСсылка - Булево - Истина, если для подсистемы доступна работа с динамическими ссылками
//            без подсистемы Онлайн-Заказы.
//     ** ОтменаОплаты - Булево - Истина, если платежная система предоставляет метод для
//            отмены динамических ссылок.
//
Функция ДоступныеМетоды() Экспорт
	
	Результат = Новый Соответствие;
	
	ПараметрыОзон = Новый Структура;
	ПараметрыОзон.Вставить("КассоваяСсылка", Ложь);
	ПараметрыОзон.Вставить("ДинамическаяСсылка", Ложь);
	ПараметрыОзон.Вставить("ОтменаОплаты", Ложь);
	
	Результат.Вставить(
		НастройкиПлатежныхСистемКлиентСервер.ИмяПодсистемыОзонПэй(),
		ПараметрыОзон);
	
	ПараметрыЯндекс = Новый Структура;
	ПараметрыЯндекс.Вставить("КассоваяСсылка", Истина);
	ПараметрыЯндекс.Вставить("ДинамическаяСсылка", Истина);
	ПараметрыЯндекс.Вставить("ОтменаОплаты", Истина);
	
	Результат.Вставить(
		НастройкиПлатежныхСистемКлиентСервер.ИмяПодсистемыЯндексПэй(),
		ПараметрыЯндекс);
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступность метода для указанной платежной системы.
// Проверка выполняется без учета внедрения подсистемы в конфигурацию.
// 
// Параметры:
//  ИмяПлатежнойСистемы - Строка - имя подсистемы. Задается методами
//            НастройкиПлатежныхСистемКлиентСервер.ИмяПодсистемыОзонПэй
//            НастройкиПлатежныхСистемКлиентСервер.ИмяПодсистемыЯндексПэй
//  ИмяМетода - Строка - имя метода, доступность которого необходимо проверить.
//            Возможные значения: "КассоваяСсылка", "ДинамическаяСсылка", "ОтменаОплаты"
// 
// Возвращаемое значение:
//  Неопределено, Булево - Истина, если указанный метод доступен для указанной платежной системы.
//           Ложь, если указанный метод не доступен.
//           Неопределено, если указаны ошибочные параметры.
//
Функция МетодДоступен(ИмяПлатежнойСистемы, ИмяМетода) Экспорт
	
	Если Не (ЗначениеЗаполнено(ИмяПлатежнойСистемы) И ЗначениеЗаполнено(ИмяМетода)) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ДоступныеМетоды = ДоступныеМетоды().Получить(ИмяПлатежнойСистемы);
	Если ДоступныеМетоды = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Эталон = Новый Структура(ИмяМетода, Неопределено);
	ЗаполнитьЗначенияСвойств(Эталон, ДоступныеМетоды);
	
	Возврат Эталон[ИмяМетода];
	
КонецФункции

#КонецОбласти

