// Выполняет проверку существования учетной записи ЭДО.
// 
// Параметры:
//  Отбор - Структура:
//  *НазначениеУчетнойЗаписи - Строка
//  *КодНалоговогоОргана - Строка
//  *СпособОбменаЭД - ПеречислениеСсылка.СпособыОбменаЭД
//  *Организация - ОпределяемыйТип.Организация
// 
// Возвращаемое значение:
//  Булево - Учетная запись существует
Функция УчетнаяЗаписьСуществует(Знач Отбор) Экспорт

	ЗапросУчетныхЗаписей = ЗапросУчетныхЗаписей("УчетныеЗаписиЭДО");
	
	Запросы = Новый Массив;
	Запросы.Добавить(ЗапросУчетныхЗаписей);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеЗаписиЭДО.ИдентификаторЭДО КАК ИдентификаторЭДО
	|ИЗ
	|	УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
	|ГДЕ
	|	УчетныеЗаписиЭДО.НазначениеУчетнойЗаписи = &НазначениеУчетнойЗаписи
	|	И УчетныеЗаписиЭДО.КодНалоговогоОргана = &КодНалоговогоОргана
	|	И УчетныеЗаписиЭДО.СпособОбменаЭД = &СпособОбменаЭД
	|	И УчетныеЗаписиЭДО.Организация = &Организация";
	
	ИтоговыйЗапрос = ОбщегоНазначенияБЭД.СоединитьЗапросы(Запрос, Запросы);
	ИтоговыйЗапрос.УстановитьПараметр("НазначениеУчетнойЗаписи", Отбор.НазначениеУчетнойЗаписи);
    ИтоговыйЗапрос.УстановитьПараметр("КодНалоговогоОргана", Отбор.КодНалоговогоОргана);
	ИтоговыйЗапрос.УстановитьПараметр("СпособОбменаЭД", Отбор.СпособОбменаЭД);
	ИтоговыйЗапрос.УстановитьПараметр("Организация", Отбор.Организация);
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = ИтоговыйЗапрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Не РезультатЗапроса.Пустой();
КонецФункции

// Параметры:
//  ИдентификаторУчетнойЗаписи - Строка
//  ПроизвестиПроверкуДействительныхСертификатовНаОтзыв - Булево
//
// Возвращаемое значение:
//  Булево
Функция ЕстьНедействительныеСертификаты(ИдентификаторУчетнойЗаписи,
	ПроизвестиПроверкуДействительныхСертификатовНаОтзыв = Ложь) Экспорт
	
	Если ПроизвестиПроверкуДействительныхСертификатовНаОтзыв Тогда
		ПроверкаНаОтзывДействительныхСертификатов(ИдентификаторУчетнойЗаписи);
	КонецЕсли;
	КоличествоПросроченныхСертификатов = КоличествоПросроченныхСертификатовУчетнойЗаписи(ИдентификаторУчетнойЗаписи);
	КоличествоОтозванныхСертификатов = КоличествоОтозванныхСертификатовУчетнойЗаписи(ИдентификаторУчетнойЗаписи);
	Возврат КоличествоПросроченныхСертификатов + КоличествоОтозванныхСертификатов > 0;
	
КонецФункции

// Возвращаемое значение:
//  Массив из СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования
Функция ОтозванныеСертификаты() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СертификатыУчетныхЗаписейЭДО.Сертификат КАК Сертификат
		|ИЗ
		|	РегистрСведений.СертификатыУчетныхЗаписейЭДО КАК СертификатыУчетныхЗаписейЭДО";
	Сертификаты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сертификат");
	Возврат ИнтеграцияБСПБЭД.ОтозванныеСертификаты(Сертификаты);
	
КонецФункции

// см. ОбменСКонтрагентами.ДанныеУчетныхЗаписейЭДООрганизации
//
Функция ДанныеУчетныхЗаписейЭДООрганизации(Организация) Экспорт
	
	УчетныеЗаписи = ЗначенияСвойствУчетныхЗаписейОрганизацииСервисаЭДО(Организация,
		"ИдентификаторЭДО, НаименованиеУчетнойЗаписи, НазначениеУчетнойЗаписи, СпособОбменаЭД");
	
	ИдентификаторыЭДО = ОбщегоНазначения.ВыгрузитьКолонку(УчетныеЗаписи, "ИдентификаторЭДО", Истина);
	ОператорыЭДО = СервисНастроекЭДО.НайтиОператоровЭДОПоИдентификаторам(ИдентификаторыЭДО);
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		УчетнаяЗапись.Вставить("ИдентификаторОператора");
		УчетнаяЗапись.Вставить("ПредставлениеОператора");
		ОператорЭДО = ОператорыЭДО.Найти(УчетнаяЗапись.ИдентификаторЭДО, "ИдентификаторЭДО");
		Если ОператорЭДО <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(УчетнаяЗапись, ОператорЭДО);
		КонецЕсли;
	КонецЦикла;
	
	Возврат УчетныеЗаписи;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
//  * ЗаполнятьРеквизитыПоИНН - Булево
//
Функция ПараметрыПомощникаПодключенияЭДО() Экспорт
	
	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("ЗаполнятьРеквизитыПоИНН", Ложь);
	ОбменСКонтрагентамиПереопределяемый.ПриОпределенииПараметровПомощникаПодключенияЭДО(ПараметрыПомощника);
	Возврат ПараметрыПомощника;
	
КонецФункции

#Область ПереводАбонентовИзТакскомВХаб

// Параметры:
//  КлючиСинхронизации - См. СинхронизацияЭДОКлиентСервер.НовыеКлючиСинхронизации
Процедура ПеревестиУчетныеЗаписиТакскомВХаб(КлючиСинхронизации) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если Не ДоступенПереводАбонентовИзТакскомВХаб() Тогда
		Возврат;
	КонецЕсли;
	
	УчетныеЗаписиПереведенныеИзТакском = СписокУчетныхЗаписейПереведенныхИзТакском();
	КлючиСинхронизацииЗаписейКПереводу = Новый Соответствие;
	СертификатыКлючейКПереводу = Новый Массив;
	Для Каждого КлючЗначениеКлючаСинхронизации Из КлючиСинхронизации Цикл
		КлючСинхронизации = КлючЗначениеКлючаСинхронизации.Значение;
		Если КлючСинхронизации.СпособОбмена = Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском
			И УчетныеЗаписиПереведенныеИзТакском.Найти(КлючСинхронизации.ИдентификаторУчетнойЗаписи) = Неопределено Тогда
			
			КлючиСинхронизацииЗаписейКПереводу.Вставить(КлючЗначениеКлючаСинхронизации.Ключ, КлючСинхронизации);
			СертификатыКлючейКПереводу.Добавить(КлючСинхронизации.ВыбранныйСертификат);
		КонецЕсли;
	КонецЦикла;
	
	СвойстваСертификатов = КриптографияБЭД.СвойстваСертификатов(СертификатыКлючейКПереводу);
	Для Каждого КлючЗначениеКлючаСинхронизацииКПереводу Из КлючиСинхронизацииЗаписейКПереводу Цикл
		КлючСинхронизации = КлючЗначениеКлючаСинхронизацииКПереводу.Значение;
		СвойстваСертификата = СвойстваСертификатов.Получить(КлючСинхронизации.ВыбранныйСертификат);	
		Если ЗначениеЗаполнено(СвойстваСертификата) Тогда
			СервисЭДО.ПеревестиУчетнуюЗаписьИзТакскомВХаб(КлючСинхронизации, 
				СвойстваСертификата.ДанныеСертификата);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура ИзменитьСпособОбменаВсехУчетныхЗаписейПереводимыхИзТакском() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаПереводаАбонентовИзТакском = ДатаПереводаАбонентовИзТакском();
	Если ЗначениеЗаполнено(ДатаПереводаАбонентовИзТакском) 
		И ДатаПереводаАбонентовИзТакском < ТекущаяДатаСеанса() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО КАК ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|ГДЕ
		|	УчетныеЗаписиЭДО.СпособОбменаЭД = &СпособОбменаЭД";
		
		Запрос.УстановитьПараметр("СпособОбменаЭД", Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		ВыборкаУчетныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаУчетныеЗаписи.Следующий() Цикл
			ИзменитьСпособОбменаУчетнойЗаписиПереводимойИзТакском(ВыборкаУчетныеЗаписи.ИдентификаторЭДО);
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Параметры:
//  ИдентификаторЭДО - Строка
Процедура ИзменитьСпособОбменаУчетнойЗаписиПереводимойИзТакском(ИдентификаторЭДО) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если УчетнаяЗаписьПереведенаИзТакском(ИдентификаторЭДО) Тогда
		Возврат;
	КонецЕсли;
	
	ПереводЗафиксирован = Ложь;
		
	НачатьТранзакцию();
	Попытка 
		
		ИзменитьСпособОбменаВПереводимойУчетнойЗаписиИзТакском(ИдентификаторЭДО);
		ИзменитьСпособОбменаОператораТакском();
		
		ДатыЗапросаДанныхОператораЭДО = СинхронизацияЭДО.ДатыЗапросаДанныхОператораЭДО(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторЭДО), 
			СинхронизацияЭДО.ТипДанныхЗапросаОператораЭДОДокументы());
		ДатыЗапросаДанныхОператораЭДО = ДатыЗапросаДанныхОператораЭДО.Получить(ИдентификаторЭДО);
		
		Набор = РегистрыСведений.УчетныеЗаписиПереведенныеИзТакскомЭДО.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЭДО.Установить(ИдентификаторЭДО);
		Запись = Набор.Добавить();
		Запись.ИдентификаторЭДО = ИдентификаторЭДО;
		
		Если ЗначениеЗаполнено(ДатыЗапросаДанныхОператораЭДО) Тогда
			Запись.ДатаПолучения = ДатыЗапросаДанныхОператораЭДО.ДатаПолучения;
			Запись.ДатаПолученияЭПД = ДатыЗапросаДанныхОператораЭДО.ДатаПолученияЭПД;
			Запись.ПроверочнаяДатаПолучения = ДатыЗапросаДанныхОператораЭДО.ПроверочнаяДатаПолучения;
		КонецЕсли;
		
		Набор.Записать();
		
		ПереводЗафиксирован = Истина;
		
		ЗафиксироватьТранзакцию();
	Исключение 
		ОтменитьТранзакцию();
				
		Информация = ИнформацияОбОшибке();
		
		ПодробныйТекстОшибкиПеревода = СтрШаблон(НСтр("ru = 'Не удалось выполнить изменение способа обмена учетной записи %1 по причине: %2'"),
			ИдентификаторЭДО, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		
		ЭлектронноеВзаимодействие.ОбработатьОшибку(НСтр("ru = 'Изменение способа обмена учетной записи'"),
			ПодробныйТекстОшибкиПеревода);
		
	КонецПопытки;
	
	Если ПереводЗафиксирован Тогда
		ОтклонитьВсеНепринятыеПриглашенияПриПереводеИзТакском(ИдентификаторЭДО);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Параметры:
//  ИдентификаторЭДО - Строка
// 
// Возвращаемое значение:
//  Булево 
Функция УчетнаяЗаписьПереведенаИзТакском(ИдентификаторЭДО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетныеЗаписиПереведенныеИзТакском.ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиПереведенныеИзТакскомЭДО КАК УчетныеЗаписиПереведенныеИзТакском
		|ГДЕ
		|	УчетныеЗаписиПереведенныеИзТакском.ИдентификаторЭДО = &ИдентификаторЭДО";
	
	Запрос.УстановитьПараметр("ИдентификаторЭДО", ИдентификаторЭДО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
КонецФункции

// Возвращаемое значение:
//  Массив Из Строка
Функция СписокУчетныхЗаписейПереведенныхИзТакском() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УчетныеЗаписиПереведенныеИзТакском.ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиПереведенныеИзТакскомЭДО КАК УчетныеЗаписиПереведенныеИзТакском";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторЭДО");
	Возврат Результат;
КонецФункции

// Возвращаемое значение:
//  Булево 
Функция ТребуетсяВыполнениеДействийПоAPIТакском() Экспорт
	
	Если НаступилаДатаОтключенияAPIТакском() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетныеЗаписиПереведенныеИзТакском.ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиПереведенныеИзТакскомЭДО КАК УчетныеЗаписиПереведенныеИзТакском";

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
КонецФункции

// Возвращаемое значение:
//  Булево
Функция НаступилаДатаОтключенияAPIТакском() Экспорт
	ДатаОтключенияAPIТакском = ДатаОтключенияAPIТакском();
	Возврат ЗначениеЗаполнено(ДатаОтключенияAPIТакском) И ДатаОтключенияAPIТакском < ТекущаяДатаСеанса();
КонецФункции

// Возвращаемое значение:
//  Дата
Функция ДатаОтключенияAPIТакском() Экспорт
	ЗагрузитьДатыПереводаАбонентовИзТакском();
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Константы.ДатаОтключенияAPIТакскомЭДО.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

// Возвращаемое значение:
//  Булево
Функция НаступилаДатаПереводаАбонентовИзТакском() Экспорт
	ДатаПереводаАбонентовИзТакском = ДатаПереводаАбонентовИзТакском();
	Возврат ЗначениеЗаполнено(ДатаПереводаАбонентовИзТакском) И ДатаПереводаАбонентовИзТакском < ТекущаяДатаСеанса();
КонецФункции

// Параметры:
//  КлючиСинхронизации - См. СинхронизацияЭДОКлиентСервер.НовыеКлючиСинхронизации
//  ПараметрыВыполнения - См. ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО
Процедура СкорректироватьСпособОбменаВКлючахСинхронизации(КлючиСинхронизации, ПараметрыВыполнения) Экспорт
	Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполнения, "ВыполнитьТолькоПоТакском", Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТребуетсяВыполнениеДействийПоAPIТакском() Тогда
		Возврат;
	КонецЕсли;
	
	УчетныеЗаписиПереведенныеИзТакском = СписокУчетныхЗаписейПереведенныхИзТакском();
	Для каждого КлючЗначение Из КлючиСинхронизации Цикл
		Если УчетныеЗаписиПереведенныеИзТакском.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
			КлючЗначение.Значение.СпособОбмена = Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Параметры:
//  КлючиСинхронизации - См. СинхронизацияЭДОКлиентСервер.НовыеКлючиСинхронизации
Процедура УдалитьПереведенныеУчетныеЗаписиТакскомаИзКлючейСинхронизации(КлючиСинхронизации) Экспорт
	Если Не ЗначениеЗаполнено(КлючиСинхронизации) Тогда
		Возврат;
	КонецЕсли;

	УчетныеЗаписиПереведенныеИзТакском = СписокУчетныхЗаписейПереведенныхИзТакском();
	Если ЗначениеЗаполнено(УчетныеЗаписиПереведенныеИзТакском) Тогда
		ИдентификаторыЭДОКУдалениюИзКлючей = Новый Массив;
		
		Для каждого КлючЗначение Из КлючиСинхронизации Цикл
			ИдентификаторЭДО = КлючЗначение.Ключ;
			СвойстваКлюча = КлючЗначение.Значение;
			
			Если СвойстваКлюча.СпособОбмена = Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском 
				И УчетныеЗаписиПереведенныеИзТакском.Найти(ИдентификаторЭДО) <> Неопределено Тогда
					
				ИдентификаторыЭДОКУдалениюИзКлючей.Добавить(ИдентификаторЭДО);
			КонецЕсли;
		КонецЦикла;
		
		Для каждого ИдентификаторЭДОКУдалению Из ИдентификаторыЭДОКУдалениюИзКлючей Цикл
			КлючиСинхронизации.Удалить(ИдентификаторЭДОКУдалению);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#Если Не ВнешнееСоединение Тогда
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
Процедура НастроитьГруппуПредупреждениеОЗавершенииДокументовТакском(Форма) Экспорт
	ПоказыватьСписокДокументовТакскомТребующихЗавершения = ПоказыватьСписокДокументовТакскомТребующихЗавершения();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, 
		"ГруппаПредупреждениеОЗавершенииДокументовТакском", 
		"Видимость",
		ПоказыватьСписокДокументовТакскомТребующихЗавершения);

	Если ПоказыватьСписокДокументовТакскомТребующихЗавершения Тогда
		ШаблонНадписиГруппы = НСтр("ru = 'В связи с переходом оператора Такском на платформу 1С:Хаб необходимо до %1 завершить документооборот для некоторых электронных документов. <a href = ""%2"">Количество документов к завершению %3</a>.'");
		ТекстСообщения = СтрШаблон(ШаблонНадписиГруппы,
			Формат(ДатаОтключенияAPIТакском(), "ДЛФ=DD"),
			"ОткрытьФормуНезавершенныхДокументовТакском",
			КоличествоНезавершенныхДокументовТакскомПоСтаромуAPI());
		ФорматированныйЗаголовок = СтроковыеФункции.ФорматированнаяСтрока(ТекстСообщения);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, 
			"НадписьПредупреждениеОЗавершенииДокументовТакском", 
			"Заголовок",
			ФорматированныйЗаголовок);
		
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

// Возвращаемое значение:
//  Булево
Функция ПоказыватьСписокДокументовТакскомТребующихЗавершения() Экспорт
 
	ДатаОтключенияAPIТакском = ДатаОтключенияAPIТакском();
	Если Не ЗначениеЗаполнено(ДатаОтключенияAPIТакском) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДатаНачалаПоказаУведомления = ДобавитьМесяц(ДатаОтключенияAPIТакском, -2);
	Если ДатаНачалаПоказаУведомления > ТекущаяДатаСеанса() Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(СписокУчетныхЗаписейПереведенныхИзТакском()) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	КоличествоНезавершенныхДокументовТакском = КоличествоНезавершенныхДокументовТакскомПоСтаромуAPI();
	Если КоличествоНезавершенныхДокументовТакском = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
КонецФункции

// Параметры:
//  ИдентификаторЭДО - Строка
//  ОшибкаОператора - Неопределено,
//					- См. СервисЭДО.НоваяОшибкаОператора
Процедура ДобавитьОшибкуПереводаИзТакскомВХаб(ИдентификаторЭДО, ОшибкаОператора) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	Если Не ЗначениеЗаполнено(ИдентификаторЭДО) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОшибкаОператора) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОшибкаОператора.Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторОшибки = Строка(Новый УникальныйИдентификатор);
	ДатаОшибки = ТекущаяДатаСеанса();
	
	ОшибкиПереводаАбонентовВХАБ = РегистрыСведений.ОшибкиПереводаАбонентовВХАБЭДО.СоздатьНаборЗаписей();
	ОшибкиПереводаАбонентовВХАБ.Отбор.ИдентификаторЭДО.Установить(ИдентификаторЭДО);
	ОшибкиПереводаАбонентовВХАБ.Отбор.ИдентификаторОшибки.Установить(ИдентификаторОшибки);
	ОшибкиПереводаАбонентовВХАБ.Отбор.Дата.Установить(ДатаОшибки);
	
	НоваяОшибки = ОшибкиПереводаАбонентовВХАБ.Добавить();
	НоваяОшибки.ИдентификаторЭДО = ИдентификаторЭДО;
	НоваяОшибки.ИдентификаторОшибки = ИдентификаторОшибки;
	НоваяОшибки.ТекстОшибки = ОшибкаОператора.Текст;
	НоваяОшибки.Дата = ДатаОшибки;
	
	ОшибкиПереводаАбонентовВХАБ.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область АвторизацияВСервисеЭДО

// Параметры:
//  ИдентификаторыЭДО - Массив из Строка
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//  * Ключ - Строка
//  * Значение - Строка
Функция ПредставленияУчетныхЗаписейЭДО(ИдентификаторыЭДО)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО КАК ИдентификаторЭДО,
		|	УчетныеЗаписиЭДО.НаименованиеУчетнойЗаписи КАК НаименованиеУчетнойЗаписи
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|ГДЕ
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО В (&ИдентификаторыЭДО)";
	
	Запрос.УстановитьПараметр("ИдентификаторыЭДО", ИдентификаторыЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИдентификаторЭДО, Выборка.НаименованиеУчетнойЗаписи);
	КонецЦикла;
	
	Возврат Результат
	
КонецФункции

#КонецОбласти

// Параметры:
//  ИмяВременнойТаблицы - Строка
//  ВыбираемыеПоля - Строка
//  ПоляУсловия - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ШаблонЗапросаУчетныхЗаписей(ИмяВременнойТаблицы, ВыбираемыеПоля, ПоляУсловия = "") 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ВыбираемыеПоля
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
	|ГДЕ
	|	&ПоляУсловия";
	
	Если ИмяВременнойТаблицы = "" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ИмяВременнойТаблицы", "");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	КонецЕсли;
	
	Возврат ОбщегоНазначенияБЭД.ТекстЗапросаИзШаблона(ТекстЗапроса, "УчетныеЗаписиЭДО", ВыбираемыеПоля, ПоляУсловия);
	
КонецФункции

// Параметры:
//  Организация - ОпределяемыйТип.Организация
//  Свойства - Строка
// 
// Возвращаемое значение:
//  Массив Из Структура
Функция ЗначенияСвойствУчетныхЗаписейОрганизацииСервисаЭДО(Организация, Свойства)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОрганизацииПоИНН.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	ИмяТаблицыОрганизации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИмяТаблицыОрганизации КАК ОрганизацииПоИНН
		|		ПО Организации.ИмяРеквизитаИНН = ОрганизацииПоИНН.ИмяРеквизитаИНН
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Свойства,
		|	УчетныеЗаписиЭДО.НаименованиеУчетнойЗаписи КАК Представление
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Организации КАК ВТ_Организации
		|		ПО УчетныеЗаписиЭДО.Организация = ВТ_Организации.Ссылка
		|ГДЕ
		|	УчетныеЗаписиЭДО.СпособОбменаЭД В (&СпособыОбменаЧерезОператора)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Свойства", Свойства);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяТаблицыОрганизации", ОбщегоНазначения.ИмяТаблицыПоСсылке(Организация));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяРеквизитаИНН",
		ИнтеграцияЭДО.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении("ИННОрганизации"));
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СпособыОбменаЧерезОператора", СинхронизацияЭДО.СпособыОбменаЧерезОператора());
	
	МассивЗначенийСвойств = Новый Массив;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗначенияСвойств = Новый Структура(Свойства);
			ЗаполнитьЗначенияСвойств(ЗначенияСвойств, Выборка);
			МассивЗначенийСвойств.Добавить(ЗначенияСвойств);
		КонецЦикла;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует(
		"ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС") Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		Если МодульЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС() Тогда
			МодульЭлектронноеАктированиеЕИС.ДополнитьЗначенияСвойствУчетныхЗаписейОрганизацииСервисаЭДО(
				Организация,
				Свойства,
				МассивЗначенийСвойств);
		КонецЕсли;
	КонецЕсли;
		
	Возврат МассивЗначенийСвойств;
	
КонецФункции

// Параметры:
//  ИдентификаторУчетнойЗаписи - Строка
//
// Возвращаемое значение:
//  Массив из ХранилищеЗначения
Функция ДанныеНеотозванныхСертификатовУчетнойЗаписи(ИдентификаторУчетнойЗаписи)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СертификатыУчетныхЗаписейЭДО.Сертификат КАК Сертификат
		|ИЗ
		|	РегистрСведений.СертификатыУчетныхЗаписейЭДО КАК СертификатыУчетныхЗаписейЭДО
		|ГДЕ
		|	СертификатыУчетныхЗаписейЭДО.ИдентификаторЭДО = &ИдентификаторЭДО
		|	И РАЗНОСТЬДАТ(&ТекущаяДата, СертификатыУчетныхЗаписейЭДО.ДействителенДо, МИНУТА) > 0";
	Запрос.УстановитьПараметр("ИдентификаторЭДО", ИдентификаторУчетнойЗаписи);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	ДействительныеСертификаты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сертификат");
	Возврат ИнтеграцияБСПБЭД.ДанныеНеотозванныхСертификатов(ДействительныеСертификаты);
	
КонецФункции

// Параметры:
//  ИдентификаторУчетнойЗаписи - Строка
//
// Возвращаемое значение:
//  Число
Функция КоличествоОтозванныхСертификатовУчетнойЗаписи(ИдентификаторУчетнойЗаписи)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СертификатыУчетныхЗаписейЭДО.Сертификат КАК Сертификат
		|ИЗ
		|	РегистрСведений.СертификатыУчетныхЗаписейЭДО КАК СертификатыУчетныхЗаписейЭДО
		|ГДЕ
		|	СертификатыУчетныхЗаписейЭДО.ИдентификаторЭДО = &ИдентификаторЭДО";
	Запрос.УстановитьПараметр("ИдентификаторЭДО", ИдентификаторУчетнойЗаписи);
	СертификатыУчетнойЗаписи = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сертификат");
	Возврат ИнтеграцияБСПБЭД.КоличествоОтозванныхСертификатов(СертификатыУчетнойЗаписи);
	
КонецФункции

// Параметры:
//  ИдентификаторУчетнойЗаписи - Строка
//
// Возвращаемое значение:
//  Число
Функция КоличествоПросроченныхСертификатовУчетнойЗаписи(ИдентификаторУчетнойЗаписи)
	
	Результат = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(СертификатыУчетныхЗаписейЭДО.Сертификат) КАК КоличествоСертификатов
		|ИЗ
		|	РегистрСведений.СертификатыУчетныхЗаписейЭДО КАК СертификатыУчетныхЗаписейЭДО
		|ГДЕ
		|	СертификатыУчетныхЗаписейЭДО.ИдентификаторЭДО = &ИдентификаторЭДО
		|	И РАЗНОСТЬДАТ(&ТекущаяДата, СертификатыУчетныхЗаписейЭДО.ДействителенДо, МИНУТА) < 0";
	Запрос.УстановитьПараметр("ИдентификаторЭДО", ИдентификаторУчетнойЗаписи);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КоличествоСертификатов;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Параметры:
// ИдентификаторУчетнойЗаписи - Строка
Процедура ПроверкаНаОтзывДействительныхСертификатов(ИдентификаторУчетнойЗаписи)
	
	МенеджерКриптографии = ЭлектроннаяПодпись.МенеджерКриптографии("", Ложь);
	ДанныеДействительныхСертификатов = ДанныеНеотозванныхСертификатовУчетнойЗаписи(ИдентификаторУчетнойЗаписи);
	Для Каждого ДанныеСертификата Из ДанныеДействительныхСертификатов Цикл
		ОписаниеОшибки = "";
		ЭлектроннаяПодпись.ПроверитьСертификат(МенеджерКриптографии, ДанныеСертификата.Получить(),
			ОписаниеОшибки);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  ИдентификаторЭДО - Строка
//  СпособОбмена - ПеречислениеСсылка.СпособыОбменаЭД
//  ИспользоватьЦентрЭДО - Булево
Процедура ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО, СпособОбмена, ИспользоватьЦентрЭДО)
	
	НаборЗаписей = РегистрыСведений.СертификатыУчетныхЗаписейЭДО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЭДО.Установить(ИдентификаторЭДО);
	НаборЗаписей.Записать();
	
	Если СпособОбмена = Перечисления.СпособыОбменаЭД.ЧерезFTP Тогда
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ИдентификаторЭДО);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	НастройкиЭДО.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО);
	ПриглашенияЭДО.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО);
	ОповещенияОСобытияхЭДО.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО);
	АвтоматическоеПолучениеЭДО.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО, СпособОбмена, ИспользоватьЦентрЭДО);
	
	Если ИспользоватьЦентрЭДО Тогда
		МодульУчетныеЗаписиЭДОИнтеграцияЦентраЭДО = ОбщегоНазначения.ОбщийМодуль("УчетныеЗаписиЭДОИнтеграцияЦентраЭДО");
		МодульУчетныеЗаписиЭДОИнтеграцияЦентраЭДО.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО);
	Иначе
		УчетныеЗаписиЭДОСлужебный.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.ЦентрЭДО") Тогда
		МодульУчетныеЗаписиЭДОЦентрЭДО = ОбщегоНазначения.ОбщийМодуль("УчетныеЗаписиЭДОЦентрЭДО");
		МодульУчетныеЗаписиЭДОЦентрЭДО.ПриУдаленииУчетнойЗаписи(ИдентификаторЭДО);
	КонецЕсли;
	
КонецПроцедуры

#Область ПереводАбонентовИзТакскомВХаб

// Возвращаемое значение:
//  Булево
Функция ДоступенПереводАбонентовИзТакскомВХаб()
	Возврат Ложь; // проектное поведение, перевод авторизацией выполняется только при наличии патча
КонецФункции

// Возвращаемое значение:
//  Число
Функция КоличествоНезавершенныхДокументовТакскомПоСтаромуAPI()
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЧерезОператораЭДОТакском", Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском);
	Запрос.УстановитьПараметр("СостоянияЗавершенногоЭДО", РегламентыЭДО.СостоянияЗавершенногоЭДО());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(СостоянияДокументовЭДО.ЭлектронныйДокумент) КАК ЭлектронныйДокумент
	|ПОМЕСТИТЬ ВТ_ВсеДокументы
	|ИЗ
	|	РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументВходящийЭДО КАК ЭлектронныйДокументВходящийЭДО
	|		ПО СостоянияДокументовЭДО.ЭлектронныйДокумент = ЭлектронныйДокументВходящийЭДО.Ссылка
	|		И НЕ СостоянияДокументовЭДО.Состояние В (&СостоянияЗавершенногоЭДО)
	|		И ЭлектронныйДокументВходящийЭДО.СпособОбмена = &ЧерезОператораЭДОТакском
	|		И ЭлектронныйДокументВходящийЭДО.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(СостоянияДокументовЭДО.ЭлектронныйДокумент)
	|ИЗ
	|	РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ПО СостоянияДокументовЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка
	|		И НЕ СостоянияДокументовЭДО.Состояние В (&СостоянияЗавершенногоЭДО)
	|		И ЭлектронныйДокументИсходящийЭДО.СпособОбмена = &ЧерезОператораЭДОТакском
	|		И ЭлектронныйДокументИсходящийЭДО.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_ВсеДокументы.ЭлектронныйДокумент) КАК ЭлектронныйДокумент
	|ИЗ
	|	ВТ_ВсеДокументы КАК ВТ_ВсеДокументы";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЭлектронныйДокумент;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Параметры:
//  ИдентификаторЭДО - Строка 
Процедура ИзменитьСпособОбменаВПереводимойУчетнойЗаписиИзТакском(ИдентификаторЭДО)
	Поля = Новый Структура;
	Поля.Вставить("ИдентификаторЭДО", ИдентификаторЭДО);
	ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировку("РегистрСведений.УчетныеЗаписиЭДО", Поля);
	
	НаборЗаписей = РегистрыСведений.УчетныеЗаписиЭДО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЭДО.Установить(ИдентификаторЭДО);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Отбор.ИдентификаторЭДО.Установить(ИдентификаторЭДО);
	Для каждого СтрокаНабора Из НаборЗаписей Цикл 
		Если СтрокаНабора.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском Тогда
			СтрокаНабора.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО;
			
			Если ВРег(СтрокаНабора.КодНалоговогоОргана) = "УКАЖ" Тогда
				СтрокаНабора.КодНалоговогоОргана = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();
КонецПроцедуры

Процедура ИзменитьСпособОбменаОператораТакском()
	ИдентификаторОператораТакском = "2AL";
	Поля = Новый Структура;
	Поля.Вставить("ИдентификаторОператора", ИдентификаторОператораТакском);
	ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировку("РегистрСведений.ОператорыЭДО", Поля);
	
	НаборЗаписей = РегистрыСведений.ОператорыЭДО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторОператора.Установить(ИдентификаторОператораТакском);
	НаборЗаписей.Прочитать();
	
	СпособИзменен = Ложь;
	НаборЗаписей.Отбор.ИдентификаторОператора.Установить(ИдентификаторОператораТакском);
	Для каждого СтрокаНабора Из НаборЗаписей Цикл 
		Если СтрокаНабора.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.ЧерезОператораЭДОТакском Тогда
			СтрокаНабора.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО; 
			СпособИзменен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если СпособИзменен Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ИдентификаторЭДО - Строка 
Процедура ОтклонитьВсеНепринятыеПриглашенияПриПереводеИзТакском(ИдентификаторЭДО) 
	Запросы = Новый Массив;
	
	Отбор = НовыйОтборУчетныхЗаписей();
	Отбор.УчетныеЗаписи = "&ИдентификаторОрганизации";
	ЗапросУчетныхЗаписей = ЗапросУчетныхЗаписей("УчетныеЗаписиЭДО", Отбор);
	Запросы.Добавить(ЗапросУчетныхЗаписей);
	
	ОтборПриглашений = ПриглашенияЭДО.НовыйОтборПриглашений();
	ОтборПриглашений.ИдентификаторОрганизации = "&ИдентификаторОрганизации";
	ОтборПриглашений.Статус = "&СтатусыНепринятыхПриглашений";
	ЗапросПриглашений = ПриглашенияЭДО.ЗапросПриглашений("Приглашения", ОтборПриглашений);
	Запросы.Добавить(ЗапросПриглашений);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Приглашения.КлючПриглашения КАК КлючПриглашения,
	|	Приглашения.ИдентификаторОрганизации КАК ИдентификаторОрганизации,
	|	УчетныеЗаписиЭДО.Организация КАК Организация
	|ИЗ
	|	Приглашения КАК Приглашения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
	|		ПО Приглашения.ИдентификаторОрганизации = УчетныеЗаписиЭДО.ИдентификаторЭДО";

	ИтоговыйЗапрос = ОбщегоНазначенияБЭД.СоединитьЗапросы(Запрос, Запросы);
	ИтоговыйЗапрос.УстановитьПараметр("ИдентификаторОрганизации", ИдентификаторЭДО);
	
	СтатусыНепринятыхПриглашений = Новый Массив;
	СтатусыНепринятыхПриглашений.Добавить(Перечисления.СтатусыПриглашений.ОжидаемСогласия);
	СтатусыНепринятыхПриглашений.Добавить(Перечисления.СтатусыПриглашений.ТребуетсяСогласие);
	ИтоговыйЗапрос.УстановитьПараметр("СтатусыНепринятыхПриглашений", СтатусыНепринятыхПриглашений);	
	
	РезультатЗапроса = ИтоговыйЗапрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СведенияОтклоненныхПриглашений = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			Поля = Новый Структура;
			Поля.Вставить("Ключ", Выборка.КлючПриглашения);
			Поля.Вставить("ИдентификаторОрганизации", Выборка.ИдентификаторОрганизации);
			ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировку("РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами", Поля);
			
			НаборЗаписей = РегистрыСведений.ПриглашенияКОбменуЭлектроннымиДокументами.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдентификаторОрганизации.Установить(Выборка.ИдентификаторОрганизации);
			НаборЗаписей.Отбор.Ключ.Установить(Выборка.КлючПриглашения);
			НаборЗаписей.Прочитать();
			
			НаборЗаписей.Отбор.ИдентификаторОрганизации.Установить(Выборка.ИдентификаторОрганизации);
			НаборЗаписей.Отбор.Ключ.Установить(Выборка.КлючПриглашения);
			
			СведенияОПриглашении = ПриглашенияЭДОСлужебный.СведенияОЗаписанномПриглашении();
			СведенияОПриглашении.Организация = Выборка.Организация;
			
			Для каждого СтрокаНабора Из НаборЗаписей Цикл 
				СтрокаНабора.Статус = Перечисления.СтатусыПриглашений.Отклонено;
				СтрокаНабора.ПричинаОтказа = НСтр("ru = 'Перевод в 1С:ХАБ'");
				
				ЗаполнитьЗначенияСвойств(СведенияОПриглашении, СтрокаНабора);
	
			КонецЦикла;
			
			НаборЗаписей.Записать();
			
			СведенияОтклоненныхПриглашений.Добавить(СведенияОПриглашении);
		
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			Информация = ИнформацияОбОшибке();
			
			ПодробныйТекстОшибкиПеревода = СтрШаблон(НСтр("ru = 'Не удалось отклонить приглашение при переводе учетной записи %1 по причине: %2'"),
			ИдентификаторЭДО, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
			
			ЭлектронноеВзаимодействие.ОбработатьОшибку(НСтр("ru = 'Отклонение приглашений'"),
			ПодробныйТекстОшибкиПеревода);
			
		КонецПопытки;
	КонецЦикла;
	
	КонтекстДиагностики = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
	ПричинаОстановки = Перечисления.ПричиныОстановкиЭДО.ОтклонениеПриглашения;
	Для каждого СведенияПриглашения Из СведенияОтклоненныхПриглашений Цикл	
		ЭлектронныеДокументыЭДОСлужебный.ОстановитьДокументыПослеИзмененияПриглашения(
			СведенияПриглашения.ИдентификаторОрганизации,
			СведенияПриглашения.ИдентификаторКонтрагента, 
			ПричинаОстановки, 
			КонтекстДиагностики,
			Истина);
		
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьДатыПереводаАбонентовИзТакском()
	Если Не ТребуетсяСинхронизацияДатПереводаИзСервисаНастроек() Тогда 
		Возврат;
	КонецЕсли;
	
	ПолныйАдрес = СервисНастроекЭДО.АдресОблачногоХранилищаНастроек() + "/operators/2AL/APIDeprecationDate.json";
	РезультатПолученияФайла = ПолучениеФайловИзИнтернета.СкачатьФайлВоВременноеХранилище(ПолныйАдрес); 
	Если РезультатПолученияФайла.Статус Тогда
		УстановитьПривилегированныйРежим(Истина);
		
		ДанныеФайла = ПолучитьИзВременногоХранилища(РезультатПолученияФайла.Путь);
		ДатыИзСервиса = ОбщегоНазначенияБЭД.JSONЗначение(ДанныеФайла, Истина);
		
		Если ЗначениеЗаполнено(ДатыИзСервиса["ДатаПереводаАбонентовИзТакском"]) Тогда
			Константы.ДатаПереводаАбонентовИзТакскомЭДО.Установить(ПрочитатьДатуJSON(ДатыИзСервиса["ДатаПереводаАбонентовИзТакском"], ФорматДатыJSON.ISO));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатыИзСервиса["ДатаОтключенияAPIТакском"]) Тогда
			Константы.ДатаОтключенияAPIТакскомЭДО.Установить(ПрочитатьДатуJSON(ДатыИзСервиса["ДатаОтключенияAPIТакском"], ФорматДатыJSON.ISO));
		КонецЕсли;
		
		СервисНастроекЭДО.ИзменитьСостояниеСинхронизации(Перечисления.ТипыСинхронизацииСервисаНастроекЭДО.СинхронизацияДатПереводаАбонентовИзТакскомВХАБ, 
			НачалоДня(ТекущаяДатаСеанса()));
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
КонецПроцедуры 

// Возвращаемое значение:
//  Булево
Функция ТребуетсяСинхронизацияДатПереводаИзСервисаНастроек()
	
	ДатаСинхронизацииДатПереводаАбонентовИзТакскомВХАБ = СинхронизацияЭДО.ДатаПоследнегоИзмененияДанныхСервисаНастроек(
		Перечисления.ТипыСинхронизацииСервисаНастроекЭДО.СинхронизацияДатПереводаАбонентовИзТакскомВХАБ);
	
	Возврат НачалоДня(ДатаСинхронизацииДатПереводаАбонентовИзТакскомВХАБ) < НачалоДня(ТекущаяДатаСеанса()) 
		Или Не ЗначениеЗаполнено(ДатаСинхронизацииДатПереводаАбонентовИзТакскомВХАБ);
		
КонецФункции

// Возвращаемое значение:
//  Дата
Функция ДатаПереводаАбонентовИзТакском()
	ЗагрузитьДатыПереводаАбонентовИзТакском();
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Константы.ДатаПереводаАбонентовИзТакскомЭДО.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

#КонецОбласти

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("АвторизоватьсяВСервисеЭДО", Истина);
	Методы.Вставить("ДанныеПоИдентификаторамДляРегистрацииВЭДО", Истина);
	Методы.Вставить("УдалитьУчетнуюЗапись", Истина);
	
КонецПроцедуры

#КонецОбласти
