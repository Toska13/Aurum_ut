// 
// Возвращаемое значение:
//  Булево
Функция ЕстьУчетнаяЗапись(ИдентификаторЭДО) Экспорт
	
	Возврат РегистрыСведений.УчетныеЗаписиЭДО.ЕстьУчетнаяЗапись(ИдентификаторЭДО);
	
КонецФункции

// Возвращаемое значение:
//  Булево
Функция ЕстьУчетныеЗаписиЭДО() Экспорт
	Возврат Не РегистрыСведений.УчетныеЗаписиЭДО.УчетныеЗаписиОтсутствуют();
КонецФункции

// Параметры:
//  Организация - ОпределяемыйТип.Организация
//  ИспользоватьЦентрЭДО - Неопределено,Булево
// 
// Возвращаемое значение:
//  Массив из Строка
Функция ИдентификаторыЭДОПоОрганизации(Организация, ИспользоватьЦентрЭДО = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|ГДЕ
		|	УчетныеЗаписиЭДО.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ИспользоватьЦентрЭДО <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И УчетныеЗаписиЭДО.ИспользоватьЦентрЭДО = &ИспользоватьЦентрЭДО";
		Запрос.УстановитьПараметр("ИспользоватьЦентрЭДО", ИспользоватьЦентрЭДО);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторЭДО");
	
КонецФункции

// Параметры:
//  Организации - Массив из ОпределяемыйТип.Организация
//  ИспользоватьЦентрЭДО - Неопределено,Булево
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//  * Ключ - ОпределяемыйТип.Организация
//  * Значение - Массив из Строка
Функция ИдентификаторыУчетныхЗаписейПоОрганизациям(Организации, ИспользоватьЦентрЭДО = Неопределено) Экспорт
	
	Результат = ОбщегоНазначенияБЭДКлиентСервер.НовоеМножественноеСоответствие();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО,
		|	УчетныеЗаписиЭДО.Организация
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|ГДЕ
		|	УчетныеЗаписиЭДО.Организация В (&Организации)";
	
	Запрос.УстановитьПараметр("Организации", Организации);
	
	Если ИспользоватьЦентрЭДО <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И УчетныеЗаписиЭДО.ИспользоватьЦентрЭДО = &ИспользоватьЦентрЭДО";
		Запрос.УстановитьПараметр("ИспользоватьЦентрЭДО", ИспользоватьЦентрЭДО);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияБЭДКлиентСервер.ВставитьВоМножественноеСоответствие(Результат,
			Выборка.Организация, Выборка.ИдентификаторЭДО);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  СпособОбмена - ПеречислениеСсылка.СпособыОбменаЭД
//  ИспользоватьЦентрЭДО - Неопределено,Булево
// 
// Возвращаемое значение:
//  Массив из Строка
Функция ИдентификаторыУчетныхЗаписейСпособаОбмена(СпособОбмена, ИспользоватьЦентрЭДО = Неопределено) Экспорт
	
	УчетныеЗаписи = Новый Массив; // Массив из Строка
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|ГДЕ
		|	УчетныеЗаписиЭДО.СпособОбменаЭД = &СпособОбменаЭД
		|	И &УсловиеИспользоватьЦентрЭДО";
	
	Запрос.УстановитьПараметр("СпособОбменаЭД", СпособОбмена);
	Если ИспользоватьЦентрЭДО = Неопределено Тогда
		УсловиеИспользоватьЦентрЭДО = "ИСТИНА";
	Иначе
		УсловиеИспользоватьЦентрЭДО = ?(ИспользоватьЦентрЭДО, "", "НЕ ") + "УчетныеЗаписиЭДО.ИспользоватьЦентрЭДО";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИспользоватьЦентрЭДО", УсловиеИспользоватьЦентрЭДО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		УчетныеЗаписи.Добавить(Выборка.ИдентификаторЭДО);
	КонецЦикла;
	
	Возврат УчетныеЗаписи;
	
КонецФункции

// Параметры:
//  Сертификаты - Массив из СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования
// 
// Возвращаемое значение:
//  Массив из Строка
Функция ИдентификаторыУчетныхЗаписейЧерезСервис1СЭДОСертификатов(Сертификаты) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СертификатыУчетныхЗаписейЭДО.ИдентификаторЭДО КАК ИдентификаторЭДО
		|ИЗ
		|	РегистрСведений.СертификатыУчетныхЗаписейЭДО КАК СертификатыУчетныхЗаписейЭДО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|		ПО СертификатыУчетныхЗаписейЭДО.ИдентификаторЭДО = УчетныеЗаписиЭДО.ИдентификаторЭДО
		|ГДЕ
		|	СертификатыУчетныхЗаписейЭДО.Сертификат В(&Сертификаты)
		|	И УчетныеЗаписиЭДО.СпособОбменаЭД = ЗНАЧЕНИЕ(Перечисление.СпособыОбменаЭД.ЧерезСервис1СЭДО)
		|	И НЕ УчетныеЗаписиЭДО.ИспользоватьЦентрЭДО";
	
	Запрос.УстановитьПараметр("Сертификаты", Сертификаты);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторЭДО");
	
КонецФункции

// Возвращаемое значение:
//  Строка
Функция ИдентификаторОшибкиНедействительныеСертификаты() Экспорт
	Возврат "НедействительныеСертификаты";
КонецФункции

// Параметры:
//  НаименованиеУчетнойЗаписи - Строка
//  ИдентификаторУчетнойЗаписи - Строка
//
// Возвращаемое значение:
//  см. ОбработкаНеисправностейБЭДКлиентСервер.НовоеОписаниеВидаОшибки
Функция ВидОшибкиНедействительныеСертификаты(НаименованиеУчетнойЗаписи, ИдентификаторУчетнойЗаписи) Экспорт

	ВидОшибки = ОбработкаНеисправностейБЭДКлиентСервер.НовоеОписаниеВидаОшибки();
	ВидОшибки.Идентификатор = ИдентификаторОшибкиНедействительныеСертификаты();
	ВидОшибки.ЗаголовокПроблемы = НСтр("ru = 'В учетной записи есть недействительные сертификаты'");
	ВидОшибки.ОписаниеПроблемы =
		ТекстСообщенияВУчетнойЗаписиНедействительныеСеритификаты(НаименованиеУчетнойЗаписи);
	ОписаниеРешения = НСтр("ru = '<a href = ""%1"">Удалите </a> недействительные сертификаты учетной записи'");
	ВидОшибки.ОписаниеРешения = СтрШаблон(ОписаниеРешения, "Удалите");
	ВидОшибки.ВыводитьСсылкуНаСписокОшибок = Ложь;
	ВидОшибки.ОбработчикиНажатия.Вставить("Удалите", "УчетныеЗаписиЭДОСлужебныйКлиент.ОткрытьФормуУчетнойЗаписи");
	ВидОшибки.ПараметрыОбработчиков.Вставить("Удалите", ИдентификаторУчетнойЗаписи);
	Возврат ВидОшибки;
	
КонецФункции

// Параметры:
//  НаименованиеУчетнойЗаписи - Строка
//
// Возвращаемое значение:
//  Строка
Функция ТекстСообщенияВУчетнойЗаписиНедействительныеСеритификаты(НаименованиеУчетнойЗаписи) Экспорт
	
	Возврат СтрШаблон(НСтр("ru = 'В учетной записи ""%1""
		|есть недействительные сертификаты.
		|Получение и отправка электронных документов по ней невозможны.'"), НаименованиеУчетнойЗаписи);
	
КонецФункции

// Параметры:
//  ДанныеДляСинхронизации - см. СинхронизацияЭДОСлужебный.ДанныеДляСинхронизации
//  ОбработанныеУчетныеЗаписи - Соответствие из КлючИЗначение:
//  * Ключ - Строка
//  * Значение - см. ДиагностикаЭДОКлиентСервер.НовоеОписаниеОбработаннойУчетнойЗаписи
Процедура ОбработатьОшибкиСинхронизации(ДанныеДляСинхронизации, ОбработанныеУчетныеЗаписи) Экспорт
	
	Для Каждого КлючИЗначение Из ДанныеДляСинхронизации.УчетныеЗаписиБезДоступаКСертификатам Цикл
		ОбработаннаяУчетнаяЗапись = ДиагностикаЭДОКлиентСервер.НовоеОписаниеОбработаннойУчетнойЗаписи();
		ОбработаннаяУчетнаяЗапись.Идентификатор = КлючИЗначение.Ключ;
		КоличествоСертификатов = КлючИЗначение.Значение.Количество();
		Если КоличествоСертификатов = 1 Тогда
			ШаблонОшибки = НСтр("ru = '<a href = ""%1"">Сертификат</a> доступен, но в поле ""Пользователь"" сертификата учетной записи указан пользователь, отличный от текущего'");
			ТекстОшибки = СтрШаблон(ШаблонОшибки, "Сертификаты");
		Иначе 
			ШаблонОшибки = НСтр("ru = '<a href = ""%1"">Сертификаты(%2)</a> доступны, но в поле ""Пользователь"" сертификата учетной записи указан пользователь, отличный от текущего'");
			ТекстОшибки = СтрШаблон(ШаблонОшибки, "Сертификаты", КоличествоСертификатов);
		КонецЕсли;
		ИнформацияОбОшибке = ОбработаннаяУчетнаяЗапись.ИнформацияОбОшибке;
		ИнформацияОбОшибке.ВидОшибки = ДиагностикаЭДОКлиентСервер.ВидОшибкиОтправкиИПолученияНетДоступаКСертификатам();
		ИнформацияОбОшибке.КраткоеПредставление = НСтр("ru = 'Нет доступа к сертификатам учетной записи'");
		ИнформацияОбОшибке.ПодробноеПредставление.Текст = СтроковыеФункции.ФорматированнаяСтрока(ТекстОшибки);
		Обработчик = Новый Структура;
		Обработчик.Вставить("ИмяПроцедуры", "ДиагностикаЭДОКлиент.ОткрытьСписокСертификатов");
		Обработчик.Вставить("Параметр", КлючИЗначение.Значение);
		ИнформацияОбОшибке.ПодробноеПредставление.ОбработчикиНажатия.Вставить("Сертификаты", Обработчик);
		ОбработанныеУчетныеЗаписи.Вставить(КлючИЗначение.Ключ, ОбработаннаяУчетнаяЗапись);
	КонецЦикла;
	
	Для Каждого УчетнаяЗапись Из ДанныеДляСинхронизации.УчетныеЗаписиБезДоступныхСертификатов Цикл
		ОбработаннаяУчетнаяЗапись = ДиагностикаЭДОКлиентСервер.НовоеОписаниеОбработаннойУчетнойЗаписи();
		ОбработаннаяУчетнаяЗапись.Идентификатор = УчетнаяЗапись;
		ТекстОшибки = НСтр("ru = 'Недоступен ни один личный сертификат из привязанных к учетной записи'");
		ИнформацияОбОшибке = ОбработаннаяУчетнаяЗапись.ИнформацияОбОшибке;
		ИнформацияОбОшибке.ВидОшибки = ДиагностикаЭДОКлиентСервер.ВидОшибкиОтправкиИПолученияНетДоступныхСертификатов();
		ИнформацияОбОшибке.КраткоеПредставление = НСтр("ru = 'Нет доступных сертификатов'");
		ИнформацияОбОшибке.ПодробноеПредставление.Текст = ТекстОшибки;
		ОбработанныеУчетныеЗаписи.Вставить(УчетнаяЗапись, ОбработаннаяУчетнаяЗапись);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  ИдентификаторЭДО - Строка
// 
// Возвращаемое значение:
//  Неопределено,Структура:
//  * ДатаПолученияДокументов - Число
//  * ДатаПолученияЭПД - Число
//  * ДатаПолученияПриглашений - Число
Функция СостояниеОбменаЧерезОператораЭДО(ИдентификаторЭДО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СостоянияОбменовЭДЧерезОператоровЭДО.ДатаПолученияЭД КАК ДатаПолученияЭД,
		|	СостоянияОбменовЭДЧерезОператоровЭДО.ДатаПолученияЭПД КАК ДатаПолученияЭПД,
		|	СостоянияОбменовЭДЧерезОператоровЭДО.ДатаПоследнегоПолученияПриглашений КАК ДатаПоследнегоПолученияПриглашений
		|ИЗ
		|	РегистрСведений.СостоянияОбменовЭДЧерезОператоровЭДО КАК СостоянияОбменовЭДЧерезОператоровЭДО
		|ГДЕ
		|	СостоянияОбменовЭДЧерезОператоровЭДО.ИдентификаторОрганизации = &ИдентификаторЭДО";
	
	Запрос.УстановитьПараметр("ИдентификаторЭДО", ИдентификаторЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Состояние = Новый Структура;
	Состояние.Вставить("ДатаПолученияДокументов", Выборка.ДатаПолученияЭД);
	Состояние.Вставить("ДатаПолученияЭПД", Выборка.ДатаПолученияЭПД);
	Состояние.Вставить("ДатаПолученияПриглашений", Выборка.ДатаПоследнегоПолученияПриглашений);
	Возврат Состояние;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// См. СинхронизацияЭДО.ПриЗаполненииСписковСОграничениемДоступа
