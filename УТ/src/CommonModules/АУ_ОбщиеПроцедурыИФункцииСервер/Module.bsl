#Область ПрограммныйИнтерфейс

// Возвращает граничную дату: если срок годности серии меньше этой даты, до истечения осталось менее 1 года от даты документа.
//
// Параметры:
//  ОбъектДокумента - документ
//
// Возвращаемое значение:
//  Дата - дата документа + 12 месяцев.
//
Функция ГраничнаяДатаСрокаГодностиСерий(ЗНАЧ ОбъектДокумента) Экспорт
	
	ДатаДокумента = ОбъектДокумента.Дата;
	КоличествоМесяцев = АУ_ОбщиеПроцедурыИФункцииСерверПовтИсп.ПолучитьЗначениеНастройки("КоличествоМесяцевДоИстеченияСрокаГодностиСерий");
	
	Если ТипЗнч(ОбъектДокумента.Ссылка) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		Распоряжение = ОбъектДокумента.Распоряжение;
	ИначеЕсли ТипЗнч(ОбъектДокумента.Ссылка) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
		
		Для каждого стрТовары Из ОбъектДокумента.ТоварыПоРаспоряжениям Цикл
			Если ЗначениеЗаполнено(стрТовары.Распоряжение) Тогда
				Распоряжение = стрТовары.Распоряжение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Распоряжение) И НЕ ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		
		Массив = Новый Массив;
		Массив.Добавить(Распоряжение.Контрагент);
		Массив.Добавить(Распоряжение.Партнер);
		
		ЗначенияРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Массив, "АУ_КоличествоМесяцевДоИстеченияСрокаГодностиСерий");
		
		Если ЗначенияРеквизита[Распоряжение.Контрагент] <> 0 Тогда
			КоличествоМесяцев = ЗначенияРеквизита[Распоряжение.Контрагент];
		ИначеЕсли ЗначенияРеквизита[Распоряжение.Партнер] <> 0 Тогда
			КоличествоМесяцев = ЗначенияРеквизита[Распоряжение.Партнер];
		КонецЕсли;
		
	КонецЕсли;
	
	Если КоличествоМесяцев = 0 Тогда
		КоличествоМесяцев = 12;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат ДобавитьМесяц(НачалоДня(ДатаДокумента), КоличествоМесяцев);
	
КонецФункции

// Проверяет наличие серий с заполненным сроком годности менее 1 года от даты документа.
//
// Параметры:
//  ДатаДокумента - Дата - дата документа.
//  ОбъектДокумента - ДокументОбъект - объект документа.
//  ИменаТабличныхЧастей - Массив из Строка - имена табличных частей с реквизитом Серия.
//
// Возвращаемое значение:
//  Булево - Истина, если найдена хотя бы одна подходящая серия.
//
Функция ЕстьСерииСИстекающимСрокомГодности(ДатаДокумента, ОбъектДокумента, ИменаТабличныхЧастей) Экспорт
	
	Серии = Новый Массив;
	УникальныеСерии = Новый Соответствие;
	
	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		
		ТабличнаяЧасть = ОбъектДокумента[ИмяТабличнойЧасти];
		
		Для Каждого СтрокаТабличнойЧасти Из ТабличнаяЧасть Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Серия) Тогда
				Продолжить;
			КонецЕсли;
			
			Если УникальныеСерии[СтрокаТабличнойЧасти.Серия] = Неопределено Тогда
				УникальныеСерии.Вставить(СтрокаТабличнойЧасти.Серия, Истина);
				Серии.Добавить(СтрокаТабличнойЧасти.Серия);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Серии.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ГраничнаяДата = ГраничнаяДатаСрокаГодностиСерий(ОбъектДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК Серии
	|ГДЕ
	|	Серии.Ссылка В(&Серии)
	|	И Серии.ГоденДо <> ДАТАВРЕМЯ(1, 1, 1)
	|	И Серии.ГоденДо < &ГраничнаяДата";
	
	Запрос.УстановитьПараметр("Серии", Серии);
	Запрос.УстановитьПараметр("ГраничнаяДата", ГраничнаяДата);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Добавляет условное оформление строк таблицы: красный шрифт для серий с истекающим сроком годности.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  ИмяЭлементаТаблицы - Строка - имя элемента таблицы на форме (например, "Товары").
//  ПутьКПолюСерии - Строка - путь к реквизиту Серия в данных строки (например, "Объект.Товары.Серия").
//  ИмяРеквизитаГраничнойДаты - Строка - имя реквизита формы с граничной датой.
//
Процедура УстановитьУсловноеОформлениеИстекающихСерий(Форма, ИмяЭлементаТаблицы, ПутьКПолюСерии, ИмяРеквизитаГраничнойДаты, МассивРеквизитовПосветки) Экспорт
	
	ПутьГоденДо = ПутьКПолюСерии + ".АУ_СрокГодности";
	
	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	
	Для каждого Имя Из МассивРеквизитовПосветки Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Имя);
	КонецЦикла;
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюСерии);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьГоденДо);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьГоденДо);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаГраничнойДаты);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
КонецПроцедуры

// Создаёт служебные реквизиты формы для проверки и условного оформления.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//
Процедура ПодготовитьРеквизитыФормыДляИстекающихСерий(Форма) Экспорт
	
	АУ_СозданиеЭлементовФормы.СоздатьРеквизит(Форма, "АУ_ГраничнаяДатаСрокаГодностиСерий", Новый ОписаниеТипов("Дата"));
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("АУ_СрокГодности", АУ_СозданиеЭлементовФормы.ОписаниеТипаДатаВремя("Дата"));
	
	Если Форма.Элементы.Найти("Товары") <> Неопределено Тогда
		АУ_СозданиеЭлементовФормы.СоздатьРеквизитыТаблицы(Форма, "Объект.Товары", Реквизиты);
		ЗаполнитьСрокГодностиТабличнойЧастиТовары(Форма.Объект.Товары);
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ТоварыПоРаспоряжениям") <> Неопределено Тогда
		АУ_СозданиеЭлементовФормы.СоздатьРеквизитыТаблицы(Форма, "Объект.ТоварыПоРаспоряжениям", Реквизиты);
		ЗаполнитьСрокГодностиТабличнойЧастиТовары(Форма.Объект.ТоварыПоРаспоряжениям);
	КонецЕсли;
	
	Если Форма.Элементы.Найти("ОтгружаемыеТовары") <> Неопределено Тогда
		АУ_СозданиеЭлементовФормы.СоздатьРеквизитыТаблицы(Форма, "Объект.ОтгружаемыеТовары", Реквизиты);
		ЗаполнитьСрокГодностиТабличнойЧастиТовары(Форма.Объект.ОтгружаемыеТовары);
	КонецЕсли;
	
КонецПроцедуры

// Обновляет граничную дату на форме по дате документа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//
Процедура ОбновитьГраничнуюДатуНаФормеДляИстекающихСерий(Форма) Экспорт
	
	Форма.АУ_ГраничнаяДатаСрокаГодностиСерий = ГраничнаяДатаСрокаГодностиСерий(Форма.Объект);
	
КонецПроцедуры

// Заполняет реквизит АУ_СрокГодности в строке табличной части Товары по серии номенклатуры.
//
// Параметры:
//  СтрокаТовары - СтрокаТабличнойЧасти - строка табличной части Товары документа ПриходныйОрдерНаТовары.
//
Процедура ЗаполнитьСрокГодностиВСтрокеТовары(СтрокаТовары) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
		СтрокаТовары.АУ_СрокГодности = Дата(1, 1, 1);
		Возврат;
	КонецЕсли;
	
	СтрокаТовары.АУ_СрокГодности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовары.Серия, "ГоденДо");
	
КонецПроцедуры

// Заполняет реквизит АУ_СрокГодности во всех строках табличной части Товары по сериям номенклатуры.
//
// Параметры:
//  ТабличнаяЧастьТовары - ТабличнаяЧасть - табличная часть Товары документа ПриходныйОрдерНаТовары.
//
Процедура ЗаполнитьСрокГодностиТабличнойЧастиТовары(ТабличнаяЧастьТовары) Экспорт
	
	Серии = Новый Массив;
	УникальныеСерии = Новый Соответствие;
	
	Для Каждого СтрокаТовары Из ТабличнаяЧастьТовары Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
			Продолжить;
		КонецЕсли;
		
		Если УникальныеСерии[СтрокаТовары.Серия] = Неопределено Тогда
			УникальныеСерии.Вставить(СтрокаТовары.Серия, Истина);
			Серии.Добавить(СтрокаТовары.Серия);
		КонецЕсли;
		
	КонецЦикла;
	
	СрокиГодностиПоСериям = Новый Соответствие;
	
	Если Серии.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Серии.Ссылка КАК Серия,
		|	Серии.ГоденДо КАК ГоденДо
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК Серии
		|ГДЕ
		|	Серии.Ссылка В(&Серии)";
		
		Запрос.УстановитьПараметр("Серии", Серии);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СрокиГодностиПоСериям.Вставить(Выборка.Серия, Выборка.ГоденДо);
		КонецЦикла;
		
	КонецЕсли;
	
	ПустаяДата = Дата(1, 1, 1);
	
	Для Каждого СтрокаТовары Из ТабличнаяЧастьТовары Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
			СтрокаТовары.АУ_СрокГодности = ПустаяДата;
			Продолжить;
		КонецЕсли;
		
		СрокГодности = СрокиГодностиПоСериям[СтрокаТовары.Серия];
		Если СрокГодности = Неопределено Тогда
			СтрокаТовары.АУ_СрокГодности = ПустаяДата;
		Иначе
			СтрокаТовары.АУ_СрокГодности = СрокГодности;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти



#Область ПрограммныйИнтерфейс

// Возвращает Истина, если у вида номенклатуры заполнен реквизит ОсобенностьУчета.
//
// Параметры:
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры
//
// Возвращаемое значение:
//  Булево
//
Функция АУ_ЭтоМаркируемыйВидНоменклатуры(ВидНоменклатуры) Экспорт

	Если Не ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ОсобенностьУчета"));

КонецФункции

// Находит существующую парную карточку или создаёт копию со сменой вида и префиксом имени.
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, ПарнаяНоменклатура
//
Функция АУ_СоздатьИлиНайтиПарнуюНоменклатуру(НоменклатураСсылка) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки, ПарнаяНоменклатура", Ложь, "", Справочники.Номенклатура.ПустаяСсылка());

	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Сначала запишите карточку номенклатуры.'");
		Возврат Результат;
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		НоменклатураСсылка, "АУ_НоменклатураСмаркировкой, ВидНоменклатуры, Наименование, НаименованиеПолное");

	Если ЗначениеЗаполнено(Реквизиты.АУ_НоменклатураСмаркировкой)
		И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.АУ_НоменклатураСмаркировкой, "ПометкаУдаления") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Связь с парной карточкой уже заполнена.'");
		Результат.ПарнаяНоменклатура = Реквизиты.АУ_НоменклатураСмаркировкой;
		Возврат Результат;
	КонецЕсли;

	ОбратнаяПара = НайтиОбратнуюПарнуюНоменклатуру(НоменклатураСсылка);
	Если ЗначениеЗаполнено(ОбратнаяПара) Тогда
		ЗаписатьСвязьПары(НоменклатураСсылка, ОбратнаяПара);
		ЗаписатьПубличныеИдентификаторыПары(НоменклатураСсылка, ОбратнаяПара);
		Результат.Успех = Истина;
		Результат.ПарнаяНоменклатура = ОбратнаяПара;
		Возврат Результат;
	КонецЕсли;

	ПарныйВид = ПарныйВидНоменклатуры(Реквизиты.ВидНоменклатуры);
	Если Не ЗначениеЗаполнено(ПарныйВид) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Нет соответствия видов номенклатуры маркировки. Заполните регистр соответствия видов.'");
		Возврат Результат;
	КонецЕсли;

	ТекущаяМаркируемая = АУ_ЭтоМаркируемыйВидНоменклатуры(Реквизиты.ВидНоменклатуры);
	ПарнаяМаркируемая = АУ_ЭтоМаркируемыйВидНоменклатуры(ПарныйВид);
	Если ТекущаяМаркируемая = ПарнаяМаркируемая Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У парного вида маркируемость не противоположна текущему виду.'");
		Возврат Результат;
	КонецЕсли;

	НовыйЭлемент = НоменклатураСсылка.Скопировать();
	НовыйЭлемент.ВидНоменклатуры = ПарныйВид;

	РеквизитыВида = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ПарныйВид,
		"ИспользованиеХарактеристик, ВладелецХарактеристик, ВладелецСерий, ОсобенностьУчета, ТипНоменклатуры, ИспользоватьСерии");
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, РеквизитыВида);

	Если Не РеквизитыВида.ИспользоватьСерии Тогда
		НовыйЭлемент.ВладелецСерий = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Если РеквизитыВида.ИспользованиеХарактеристик
		= Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
		НовыйЭлемент.ВладелецХарактеристик = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Если Не ПарнаяМаркируемая Тогда
		НовыйЭлемент.КиЗГИСМGTIN = "";
		НовыйЭлемент.ПродукцияМаркируемаяДляГИСМ = Ложь;
		НовыйЭлемент.КиЗГИСМ = Ложь;
	КонецЕсли;

	Префикс = ?(ПарнаяМаркируемая, "(маркировка) ", "(без маркировки) ");
	НовыйЭлемент.Наименование = ДобавитьПрефиксИмени(Реквизиты.Наименование, Префикс);
	Если ЗначениеЗаполнено(Реквизиты.НаименованиеПолное) Тогда
		НовыйЭлемент.НаименованиеПолное = ДобавитьПрефиксИмени(Реквизиты.НаименованиеПолное, Префикс);
	КонецЕсли;

	НовыйЭлемент.АУ_НоменклатураСмаркировкой = НоменклатураСсылка;
	НовыйЭлемент.Записать();

	ОчиститьШтрихкодыНоменклатуры(НовыйЭлемент.Ссылка);
	ЗаписатьСвязьПары(НоменклатураСсылка, НовыйЭлемент.Ссылка);
	ЗаписатьПубличныеИдентификаторыПары(НоменклатураСсылка, НовыйЭлемент.Ссылка);

	Результат.Успех = Истина;
	Результат.ПарнаяНоменклатура = НовыйЭлемент.Ссылка;
	Возврат Результат;

КонецФункции

// Меняет номенклатуру текущей строки документа на парную и связанные строки оснований поступления.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПриобретениеТоваровУслуг, ДокументСсылка.ПриходныйОрдерНаТовары
//  НомерСтрокиТовары - Число
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, ОписаниеЦепочки
//
Функция АУ_СменитьМаркировкуВСтрокеДокумента(ДокументСсылка, НомерСтрокиТовары) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки, ОписаниеЦепочки", Ложь, "", "");

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Сначала запишите документ.'");
		Возврат Результат;
	КонецЕсли;

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	СтрокаИсточника = СтрокаТоваровПоНомеру(ДокументОбъект, НомерСтрокиТовары);
	Если СтрокаИсточника = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найдена строка табличной части Товары.'");
		Возврат Результат;
	КонецЕсли;

	СтараяНоменклатура = СтрокаИсточника.Номенклатура;
	ПарнаяНоменклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтараяНоменклатура, "АУ_НоменклатураСмаркировкой");
	Если Не ЗначениеЗаполнено(ПарнаяНоменклатура) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У номенклатуры текущей строки не заполнена парная карточка.'");
		Возврат Результат;
	КонецЕсли;

	КонтекстСтроки = КонтекстСтрокиИсточника(СтрокаИсточника, СтараяНоменклатура, ПарнаяНоменклатура);
	Причины = Новый Массив;
	Цепочка = СобратьОснованияПоступления(ДокументОбъект, СтрокаИсточника, КонтекстСтроки, Причины);
	Если Причины.Количество() > 0 Тогда
		Результат.ТекстОшибки = СтрСоединить(Причины, Символы.ПС);
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	КонтекстОбходаКонтроля = ВключитьОбходКонтроляПриСменеМаркировки();
	НачатьТранзакцию();
	ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Истина);
	Попытка
		ОтчётЦепочки = Новый Массив;
		Для Каждого ЭлементЦепочки Из Цепочка Цикл
			СтатусЗаписи = ЗаписатьДокументСоСменойМаркировки(ЭлементЦепочки, КонтекстСтроки);
			ОтчётЦепочки.Добавить(Строка(ЭлементЦепочки.Ссылка) + ": " + СтатусЗаписи);
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Ложь);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ДатыЗапретаИзменения.ОтключитьПроверкуДатЗапрета(Ложь);
		ВыключитьОбходКонтроляПриСменеМаркировки(КонтекстОбходаКонтроля);
		УстановитьПривилегированныйРежим(Ложь);
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	ВыключитьОбходКонтроляПриСменеМаркировки(КонтекстОбходаКонтроля);
	УстановитьПривилегированныйРежим(Ложь);
	АУ_КонтрольЗаказаКлиентаСервер.ПометитьКПересчету(ДокументСсылка);

	Результат.Успех = Истина;
		Результат.ОписаниеЦепочки = СтрСоединить(ОтчётЦепочки, Символы.ПС);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиОбратнуюПарнуюНоменклатуру(НоменклатураСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.АУ_НоменклатураСмаркировкой = &Номенклатура
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.Ссылка <> &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

Функция ПарныйВидНоменклатуры(ВидНоменклатуры)

	Если Не ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Запись = РегистрыСведений.АУ_СоответствиеВидовНоменклатурыМаркировки.СоздатьМенеджерЗаписи();
	Запись.ВидНоменклатуры = ВидНоменклатуры;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Возврат Запись.ПарныйВидНоменклатуры;
	КонецЕсли;

	Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();

КонецФункции

Процедура ЗаписатьСвязьПары(ПерваяСсылка, ВтораяСсылка)

	ОбъектПервый = ПерваяСсылка.ПолучитьОбъект();
	Если ОбъектПервый.АУ_НоменклатураСмаркировкой <> ВтораяСсылка Тогда
		ОбъектПервый.АУ_НоменклатураСмаркировкой = ВтораяСсылка;
		ОбъектПервый.Записать();
	КонецЕсли;

	ОбъектВторой = ВтораяСсылка.ПолучитьОбъект();
	Если ОбъектВторой.АУ_НоменклатураСмаркировкой <> ПерваяСсылка Тогда
		ОбъектВторой.АУ_НоменклатураСмаркировкой = ПерваяСсылка;
		ОбъектВторой.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьПубличныеИдентификаторыПары(ИсходнаяНоменклатура, ПарнаяНоменклатура)

	Узел = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.НайтиПоКоду(
		"50e1e88f-c391-4c75-abe3-1ed5c94f29cc");
	Идентификатор = ИсходнаяНоменклатура.УникальныйИдентификатор();

	ЗаписьРегистра = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Идентификатор = Идентификатор;
	ЗаписьРегистра.Ссылка = ИсходнаяНоменклатура;
	ЗаписьРегистра.УзелИнформационнойБазы = Узел;
	ЗаписьРегистра.Записать(Истина);

	ЗаписьРегистра = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Идентификатор = Идентификатор;
	ЗаписьРегистра.Ссылка = ПарнаяНоменклатура;
	ЗаписьРегистра.УзелИнформационнойБазы = Узел;
	ЗаписьРегистра.Записать(Истина);

КонецПроцедуры

Функция ДобавитьПрефиксИмени(ИсходноеИмя, Префикс)

	Если СтрНачинаетсяС(ИсходноеИмя, "(маркировка)")
		Или СтрНачинаетсяС(ИсходноеИмя, "(без маркировки)") Тогда
		Возврат ИсходноеИмя;
	КонецЕсли;

	Возврат Префикс + ИсходноеИмя;

КонецФункции

Процедура ОчиститьШтрихкодыНоменклатуры(НоменклатураСсылка)

	Попытка
		Набор = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
		Набор.Отбор.Номенклатура.Установить(НоменклатураСсылка);
		Набор.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АУ.ПарнаяНоменклатура.Штрихкоды'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Справочники.Номенклатура,
			НоменклатураСсылка,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция СтрокаТоваровПоНомеру(ДокументОбъект, НомерСтрокиТовары)

	Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
		Если СтрокаТовары.НомерСтроки = НомерСтрокиТовары Тогда
			Возврат СтрокаТовары;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция КонтекстСтрокиИсточника(СтрокаИсточника, СтараяНоменклатура, ПарнаяНоменклатура)

	Контекст = Новый Структура;
	Контекст.Вставить("СтараяНоменклатура", СтараяНоменклатура);
	Контекст.Вставить("ПарнаяНоменклатура", ПарнаяНоменклатура);
	Контекст.Вставить("Количество", СтрокаИсточника.Количество);
	Контекст.Вставить("Характеристика", ЗначениеСвойстваСтроки(СтрокаИсточника, "Характеристика"));
	Контекст.Вставить("Назначение", ЗначениеСвойстваСтроки(СтрокаИсточника, "Назначение"));
	Контекст.Вставить("Серия", ЗначениеСвойстваСтроки(СтрокаИсточника, "Серия"));
	Контекст.Вставить("КодСтроки", ЗначениеСвойстваСтроки(СтрокаИсточника, "КодСтроки"));
	Контекст.Вставить("ОчиститьХарактеристику",
		Не ВидИспользуетХарактеристики(ПарнаяНоменклатура));

	Возврат Контекст;

КонецФункции

Функция ВидИспользуетХарактеристики(НоменклатураСсылка)

	ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка, "ВидНоменклатуры");
	Использование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ИспользованиеХарактеристик");
	Возврат Использование <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;

КонецФункции

Функция ЗначениеСвойстваСтроки(СтрокаДанных, ИмяСвойства)

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДанных, ИмяСвойства) Тогда
		Возврат СтрокаДанных[ИмяСвойства];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СобратьОснованияПоступления(ДокументОбъект, СтрокаИсточника, КонтекстСтроки, Причины)

	Цепочка = Новый Массив;
	ДобавитьЭлементЦепочки(Цепочка, ДокументОбъект, СтрокаИсточника, Истина);

	Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		Распоряжение = ДокументОбъект.Распоряжение;
		Если ЗначениеЗаполнено(Распоряжение) И ЭтоДокументБелогоСписка(Распоряжение) Тогда
			ДобавитьСвязанныйДокумент(Цепочка, Распоряжение, КонтекстСтроки, Причины, СтрокаИсточника);
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		ДобавитьЗаказыПриобретения(Цепочка, ДокументОбъект, СтрокаИсточника, КонтекстСтроки, Причины);
	КонецЕсли;

	Для Каждого ЭлементЦепочки Из КопияМассива(Цепочка) Цикл
		Если ТипЗнч(ЭлементЦепочки.Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
			И ЭлементЦепочки.Ссылка <> ДокументОбъект.Ссылка Тогда
			ДокументПТИУ = ЭлементЦепочки.Объект;
			СтрокаПТИУ = ЭлементЦепочки.СтрокаТовары;
			ДобавитьЗаказыПриобретения(Цепочка, ДокументПТИУ, СтрокаПТИУ, КонтекстСтроки, Причины);
		КонецЕсли;
	КонецЦикла;

	Возврат Цепочка;

КонецФункции

Функция ЭтоДокументБелогоСписка(СсылкаДокумента)

	ТипДокумента = ТипЗнч(СсылкаДокумента);
	Возврат ТипДокумента = Тип("ДокументСсылка.ПриходныйОрдерНаТовары")
		Или ТипДокумента = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
		Или ТипДокумента = Тип("ДокументСсылка.ЗаказПоставщику")
		Или ТипДокумента = Тип("ДокументСсылка.ЗаказКлиента")
		Или ТипДокумента = Тип("ДокументСсылка.ЗаказНаСборку")
		Или ТипДокумента = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление");

КонецФункции

Процедура ДобавитьЗаказыПриобретения(Цепочка, ДокументПТИУ, СтрокаПТИУ, КонтекстСтроки, Причины)

	ЗаказИзШапки = ДокументПТИУ.ЗаказПоставщику;
	ЗаказИзСтроки = ЗначениеСвойстваСтроки(СтрокаПТИУ, "ЗаказПоставщику");

	Если ЗначениеЗаполнено(ЗаказИзСтроки) Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ЗаказИзСтроки, КонтекстСтроки, Причины, СтрокаПТИУ);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаказИзШапки) И ЗаказИзШапки <> ЗаказИзСтроки Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ЗаказИзШапки, КонтекстСтроки, Причины, СтрокаПТИУ);
	КонецЕсли;

	Для Каждого ЭлементЦепочки Из КопияМассива(Цепочка) Цикл
		Если ТипЗнч(ЭлементЦепочки.Ссылка) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьОснованияЗаказаПоставщику(Цепочка, ЭлементЦепочки.Объект, ЭлементЦепочки.СтрокаТовары, КонтекстСтроки, Причины);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОснованияЗаказаПоставщику(Цепочка, ЗаказОбъект, СтрокаЗаказа, КонтекстСтроки, Причины)

	ЗаказКлиентаСтроки = ЗначениеСвойстваСтроки(СтрокаЗаказа, "АУ_ЗаказКлиента");
	ЗаказСборкиСтроки = ЗначениеСвойстваСтроки(СтрокаЗаказа, "АУ_ЗаказНаСборку");
	ОснованиеШапки = ЗаказОбъект.ДокументОснование;

	Если ЗначениеЗаполнено(ЗаказКлиентаСтроки) Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ЗаказКлиентаСтроки, КонтекстСтроки, Причины, СтрокаЗаказа);
	ИначеЕсли ТипЗнч(ОснованиеШапки) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ОснованиеШапки, КонтекстСтроки, Причины, СтрокаЗаказа);
	КонецЕсли;

	Если ЗначениеЗаполнено(ЗаказСборкиСтроки) Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ЗаказСборкиСтроки, КонтекстСтроки, Причины, СтрокаЗаказа);
	ИначеЕсли ТипЗнч(ОснованиеШапки) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ОснованиеШапки, КонтекстСтроки, Причины, СтрокаЗаказа);
	КонецЕсли;

	Если ТипЗнч(ОснованиеШапки) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
		ДобавитьСвязанныйДокумент(Цепочка, ОснованиеШапки, КонтекстСтроки, Причины, СтрокаЗаказа);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСвязанныйДокумент(Цепочка, СсылкаДокумента, КонтекстСтроки, Причины, СтрокаИсточникаСвязи)

	Если Не ЗначениеЗаполнено(СсылкаДокумента) Или Не ЭтоДокументБелогоСписка(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементЦепочки Из Цепочка Цикл
		Если ЭлементЦепочки.Ссылка = СсылкаДокумента Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
	СтрокаТовары = НайтиСвязаннуюСтроку(ДокументОбъект, КонтекстСтроки, СтрокаИсточникаСвязи);
	Если СтрокаТовары = Неопределено Тогда
		Причины.Добавить(СтрШаблон(
			НСтр("ru = 'В документе %1 не найдена связанная строка.'"),
			Строка(СсылкаДокумента)));
		Возврат;
	КонецЕсли;

	Если СтрокаТовары.Количество < КонтекстСтроки.Количество Тогда
		Причины.Добавить(СтрШаблон(
			НСтр("ru = 'В документе %1 количество связанной строки меньше количества текущей строки.'"),
			Строка(СсылкаДокумента)));
		Возврат;
	КонецЕсли;

	ДобавитьЭлементЦепочки(Цепочка, ДокументОбъект, СтрокаТовары, Ложь);

КонецПроцедуры

Процедура ДобавитьЭлементЦепочки(Цепочка, ДокументОбъект, СтрокаТовары, ЭтоИсточник)

	ЭлементЦепочки = Новый Структура;
	ЭлементЦепочки.Вставить("Ссылка", ДокументОбъект.Ссылка);
	ЭлементЦепочки.Вставить("Объект", ДокументОбъект);
	ЭлементЦепочки.Вставить("СтрокаТовары", СтрокаТовары);
	ЭлементЦепочки.Вставить("ЭтоИсточник", ЭтоИсточник);
	Цепочка.Добавить(ЭлементЦепочки);

КонецПроцедуры

Функция НайтиСвязаннуюСтроку(ДокументОбъект, КонтекстСтроки, СтрокаИсточникаСвязи)

	Если ДокументОбъект.Метаданные().ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдентификаторЗаказа = ЗначениеСвойстваСтроки(СтрокаИсточникаСвязи, "АУ_КодСтроки");
	КодСтрокиИсточника = ЗначениеСвойстваСтроки(СтрокаИсточникаСвязи, "КодСтроки");

	Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл

		Если СтрокаТовары.Номенклатура <> КонтекстСтроки.СтараяНоменклатура Тогда
			Продолжить;
		КонецЕсли;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "Характеристика")
			И СтрокаТовары.Характеристика <> КонтекстСтроки.Характеристика Тогда
			Продолжить;
		КонецЕсли;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "Назначение")
			И СтрокаТовары.Назначение <> КонтекстСтроки.Назначение Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента")
			И ЗначениеЗаполнено(ИдентификаторЗаказа)
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "ИдентификаторСтроки")
			И СтрокаТовары.ИдентификаторСтроки <> ИдентификаторЗаказа Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказПоставщику")
			И ЗначениеЗаполнено(КодСтрокиИсточника)
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "КодСтроки")
			И СтрокаТовары.КодСтроки <> КодСтрокиИсточника Тогда
			Продолжить;
		КонецЕсли;

		Возврат СтрокаТовары;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЗаписатьДокументСоСменойМаркировки(ЭлементЦепочки, КонтекстСтроки)

	ДокументОбъект = ЭлементЦепочки.Объект;
	СтрокаТовары = ЭлементЦепочки.СтрокаТовары;

	Если ЭлементЦепочки.ЭтоИсточник Или СтрокаТовары.Количество = КонтекстСтроки.Количество Тогда
		ЗаменитьНоменклатуруВСтроке(СтрокаТовары, КонтекстСтроки);
	Иначе
		РазбитьСтрокуТоваров(ДокументОбъект, СтрокаТовары, КонтекстСтроки);
	КонецЕсли;

	ОбновитьСерииДокумента(ДокументОбъект, КонтекстСтроки);

	ДокументОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);

	БылПроведен = ДокументОбъект.Проведен;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

	Если Не БылПроведен Тогда
		Возврат НСтр("ru = 'записан'");
	КонецЕсли;

	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Возврат НСтр("ru = 'проведён'");
	Исключение
		ИсправитьНоменклатуруВДвижениях(ДокументОбъект.Ссылка, КонтекстСтроки);
		Возврат НСтр("ru = 'движения'");
	КонецПопытки;

КонецФункции

Процедура ЗаменитьНоменклатуруВСтроке(СтрокаТовары, КонтекстСтроки)

	СтрокаТовары.Номенклатура = КонтекстСтроки.ПарнаяНоменклатура;
	Если КонтекстСтроки.ОчиститьХарактеристику
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "Характеристика") Тогда
		СтрокаТовары.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

Процедура РазбитьСтрокуТоваров(ДокументОбъект, СтрокаТовары, КонтекстСтроки)

	КоличествоОстаток = СтрокаТовары.Количество - КонтекстСтроки.Количество;
	КоэффициентУпаковки = 1;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "КоличествоУпаковок")
		И СтрокаТовары.Количество <> 0 Тогда
		КоэффициентУпаковки = СтрокаТовары.КоличествоУпаковок / СтрокаТовары.Количество;
	КонецЕсли;

	НоваяСтрока = ДокументОбъект.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);
	ЗаменитьНоменклатуруВСтроке(НоваяСтрока, КонтекстСтроки);
	НоваяСтрока.Количество = КонтекстСтроки.Количество;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "КоличествоУпаковок") Тогда
		НоваяСтрока.КоличествоУпаковок = КонтекстСтроки.Количество * КоэффициентУпаковки;
	КонецЕсли;

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "КодСтроки") Тогда
		НоваяСтрока.КодСтроки = МаксимальныйКодСтроки(ДокументОбъект) + 1;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "ИдентификаторСтроки") Тогда
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	СтрокаТовары.Количество = КоличествоОстаток;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "КоличествоУпаковок") Тогда
		СтрокаТовары.КоличествоУпаковок = КоличествоОстаток * КоэффициентУпаковки;
	КонецЕсли;

КонецПроцедуры

Функция КопияМассива(ИсходныйМассив)

	Результат = Новый Массив;
	Для Каждого ЭлементМассива Из ИсходныйМассив Цикл
		Результат.Добавить(ЭлементМассива);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МаксимальныйКодСтроки(ДокументОбъект)

	Максимум = 0;
	Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
		Если СтрокаТовары.КодСтроки > Максимум Тогда
			Максимум = СтрокаТовары.КодСтроки;
		КонецЕсли;
	КонецЦикла;

	Возврат Максимум;

КонецФункции

Процедура ОбновитьСерииДокумента(ДокументОбъект, КонтекстСтроки)

	Если ДокументОбъект.Метаданные().ТабличныеЧасти.Найти("Серии") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаСерии Из ДокументОбъект.Серии Цикл
		Если СтрокаСерии.Номенклатура <> КонтекстСтроки.СтараяНоменклатура Тогда
			Продолжить;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаСерии, "Характеристика")
			И СтрокаСерии.Характеристика <> КонтекстСтроки.Характеристика Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСерии.Номенклатура = КонтекстСтроки.ПарнаяНоменклатура;
		Если КонтекстСтроки.ОчиститьХарактеристику
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаСерии, "Характеристика") Тогда
			СтрокаСерии.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ИсправитьНоменклатуруВДвижениях(ДокументСсылка, КонтекстСтроки)

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

	Для Каждого ДвижениеМетаданных Из ДокументСсылка.Метаданные().Движения Цикл

		Попытка
			НаборЗаписей = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ДвижениеМетаданных.ПолноеИмя()).СоздатьНаборЗаписей();
		Исключение
			Продолжить;
		КонецПопытки;

		НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
		НаборЗаписей.Прочитать();
		Изменён = Ложь;

		Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
			Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЗаписьНабора, "Номенклатура") Тогда
				Прервать;
			КонецЕсли;
			Если ЗаписьНабора.Номенклатура <> КонтекстСтроки.СтараяНоменклатура Тогда
				Продолжить;
			КонецЕсли;
			ЗаписьНабора.Номенклатура = КонтекстСтроки.ПарнаяНоменклатура;
			Если КонтекстСтроки.ОчиститьХарактеристику
				И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЗаписьНабора, "Характеристика") Тогда
				ЗаписьНабора.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			КонецЕсли;
			Изменён = Истина;
		КонецЦикла;

		Если Изменён Тогда
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ВключитьОбходКонтроляПриСменеМаркировки()

	КонтекстОбхода = Новый Структура;
	КонтекстОбхода.Вставить("БезКонтроляОстатков",
		ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций);
	КонтекстОбхода.Вставить("БезКонтроляРезервов",
		ПараметрыСеанса.ПроводитьБезКонтроляРезервовТоваровПоЗаказам);

	ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций = Истина;
	ПараметрыСеанса.ПроводитьБезКонтроляРезервовТоваровПоЗаказам = Истина;

	Возврат КонтекстОбхода;

КонецФункции

Процедура ВыключитьОбходКонтроляПриСменеМаркировки(КонтекстОбхода)

	ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций = КонтекстОбхода.БезКонтроляОстатков;
	ПараметрыСеанса.ПроводитьБезКонтроляРезервовТоваровПоЗаказам = КонтекстОбхода.БезКонтроляРезервов;

КонецПроцедуры

#КонецОбласти
