		АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Выборка.АдресЭП;
		
	КонецЦикла;
		
	Возврат МассивАдресов;

