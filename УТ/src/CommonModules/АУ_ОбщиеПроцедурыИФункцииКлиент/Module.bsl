// Текст вопроса пользователю перед записью при наличии серий с истекающим сроком годности.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстВопросаПередЗаписьюСерииСИстекающимСроком() Экспорт
	
	Возврат НСтр("ru = 'В документе присутствуют серии со сроком годности менее 1 года. Вы уверены, что хотите принять/отгрузить данные серии?'");
	
КонецФункции

// Показывает все накопленные новые задачи исполнителя при запуске программы.
//
Процедура ПоказатьНовыеЗадачиИсполнителяПриНачалеРаботы() Экспорт
	
	ПоказатьНовыеЗадачиИсполнителя();
	
КонецПроцедуры

// Показывает всплывающие оповещения по всем новым (непросмотренным) задачам текущего пользователя.
// В рамках одного сеанса каждая задача показывается один раз.
//
Процедура ПоказатьНовыеЗадачиИсполнителя() Экспорт
	
	ПоказанныеЗадачи = ПараметрыПриложения["АУ_ПоказанныеЗадачиИсполнителя"];
	Если ПоказанныеЗадачи = Неопределено Тогда
		ПоказанныеЗадачи = Новый Соответствие;
		ПараметрыПриложения.Вставить("АУ_ПоказанныеЗадачиИсполнителя", ПоказанныеЗадачи);
	КонецЕсли;
	
	Задачи = АУ_Привелигированный.НовыеЗадачиИсполнителяДляОповещений();
	
	Для каждого Задача Из Задачи Цикл
		
		КлючЗадачи = Строка(Задача.Ссылка.УникальныйИдентификатор());
		Если ПоказанныеЗадачи[КлючЗадачи] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПоказанныеЗадачи.Вставить(КлючЗадачи, Истина);
		
		ТекстОповещения = СтрШаблон(НСтр("ru = 'Новая задача: %1'"), Задача.Наименование);
		
		ПоказатьОповещениеПользователя(
			ТекстОповещения,
			Задача.НавигационнаяСсылка,
			Задача.Описание,
			БиблиотекаКартинок.Информация,
			СтатусОповещенияПользователя.Важное,
			КлючЗадачи);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти