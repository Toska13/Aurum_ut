Функция КлючЗерна(Номенклатура, Характеристика)

	Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "|" + Строка(Характеристика.УникальныйИдентификатор());

КонецФункции

Функция КлючЗернаСборки(ЗаказНаСборку, Номенклатура, Характеристика)

	Возврат Строка(ЗаказНаСборку.УникальныйИдентификатор()) + "|" + КлючЗерна(Номенклатура, Характеристика);

КонецФункции

Функция КлючЗернаЗП(ЗаказПоставщику, Номенклатура, Характеристика)

	Возврат Строка(ЗаказПоставщику.УникальныйИдентификатор()) + "|" + КлючЗерна(Номенклатура, Характеристика);

КонецФункции

Функция СтрокаФактовПоЗерну(ТаблицаФактов, ИндексСтрок, Номенклатура, Характеристика, СоздаватьЕслиНет = Истина)

	Ключ = КлючЗерна(Номенклатура, Характеристика);
	СтрокаФактов = ИндексСтрок.Получить(Ключ);

	Если СтрокаФактов = Неопределено И Не СоздаватьЕслиНет Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если СтрокаФактов = Неопределено Тогда

		СтрокаФактов = ТаблицаФактов.Добавить();
		СтрокаФактов.Номенклатура = Номенклатура;
		СтрокаФактов.Характеристика = Характеристика;
		СтрокаФактов.Шифр = Лев(СокрЛП(Строка(Характеристика)), 10);
		ИндексСтрок.Вставить(Ключ, СтрокаФактов);

	КонецЕсли;

	Возврат СтрокаФактов;

КонецФункции

