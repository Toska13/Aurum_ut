КонецФункции

Процедура ДополнитьВложенныеШтрихкоды(ДокументыЦепочки)

	Родители = Новый Массив;

	Для Каждого СтрокаШтрихкода Из ДокументыЦепочки.ШтрихкодыПриемки Цикл

		Если Родители.Найти(СтрокаШтрихкода.ШтрихкодУпаковки) = Неопределено Тогда

			Родители.Добавить(СтрокаШтрихкода.ШтрихкодУпаковки);

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаШтрихкода Из ДокументыЦепочки.ШтрихкодыОтгрузки Цикл

		Если Родители.Найти(СтрокаШтрихкода.ШтрихкодУпаковки) = Неопределено Тогда

			Родители.Добавить(СтрокаШтрихкода.ШтрихкодУпаковки);

		КонецЕсли;

	КонецЦикла;

	Вложенные = Новый ТаблицаЗначений;
	Вложенные.Колонки.Добавить("Родитель");
	Вложенные.Колонки.Добавить("Вложенный");

	МаксимумУровней = 10;
	ТекущиеРодители = Родители;

	Для НомерУровня = 1 По МаксимумУровней Цикл

		Если ТекущиеРодители.Количество() = 0 Тогда

			Прервать;

		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныеШтрихкоды.Ссылка КАК Родитель,
		|	ВложенныеШтрихкоды.Штрихкод КАК Вложенный
		|ИЗ
		|	Справочник.ШтрихкодыУпаковокТоваров.ВложенныеШтрихкоды КАК ВложенныеШтрихкоды
		|ГДЕ
		|	ВложенныеШтрихкоды.Ссылка В (&Родители)";
		Запрос.УстановитьПараметр("Родители", ТекущиеРодители);

		Выборка = Запрос.Выполнить().Выбрать();
		СледующиеРодители = Новый Массив;

		Пока Выборка.Следующий() Цикл

			СтрокаВложенных = Вложенные.Добавить();
			СтрокаВложенных.Родитель = Выборка.Родитель;
			СтрокаВложенных.Вложенный = Выборка.Вложенный;

			Если СледующиеРодители.Найти(Выборка.Вложенный) = Неопределено Тогда

				СледующиеРодители.Добавить(Выборка.Вложенный);

			КонецЕсли;

		КонецЦикла;

		ТекущиеРодители = СледующиеРодители;

	КонецЦикла;

	ДокументыЦепочки.Вставить("ВложенныеШтрихкоды", Вложенные);

КонецПроцедуры

#КонецОбласти

#Область Дерево

Функция ПостроитьДеревоДокументов(ЗаказКлиента, РеквизитыЗаказа, ДокументыЦепочки)

	ЕстьСироты = Ложь;
	УзелНеСвязанные = Неопределено;
	Дерево = НовоеДеревоДокументов();
	УзелЗаказа = ДобавитьУзелДерева(
		Дерево.Строки,
		ЗаказКлиента,
		"ЗаказКлиента",
		РеквизитыЗаказа.Проведен,
		Неопределено);

	УзлыСборок = Новый Соответствие;
	УзлыЗаказовПоставщику = Новый Соответствие;
	УзлыПриобретений = Новый Соответствие;
	УзлыРеализаций = Новый Соответствие;
	УзлыЗаявок = Новый Соответствие;

	Для Каждого СтрокаСборки Из УникальныеСсылки(ДокументыЦепочки.Сборки, "Ссылка") Цикл

		УзлыСборок.Вставить(
			СтрокаСборки.Ссылка,
			ДобавитьУзелДерева(УзелЗаказа.Строки, СтрокаСборки.Ссылка, "ЗаказНаСборку", СтрокаСборки.Проведен, ЗаказКлиента));

	КонецЦикла;

	Для Каждого СтрокаЗП Из УникальныеСсылки(ДокументыЦепочки.СтрокиЗаказаПоставщику, "Ссылка") Цикл

		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;
		СтрокиЗП = ДокументыЦепочки.СтрокиЗаказаПоставщику.НайтиСтроки(Новый Структура("Ссылка", СтрокаЗП.Ссылка));

		Если СтрокиЗП.Количество() > 0 И ЗначениеЗаполнено(СтрокиЗП[0].ЗаказНаСборку) Тогда

			УзелСборки = УзлыСборок.Получить(СтрокиЗП[0].ЗаказНаСборку);

			Если УзелСборки <> Неопределено Тогда

				РодительскиеСтроки = УзелСборки.Строки;
				РодительСсылка = СтрокиЗП[0].ЗаказНаСборку;

			КонецЕсли;

		КонецЕсли;

		ОжидаемыйРодитель = Неопределено;

		Если СтрокиЗП.Количество() > 0 Тогда

			ОжидаемыйРодитель = СтрокиЗП[0].ЗаказНаСборку;

		КонецЕсли;

		РезультатРазмещения = РазместитьДочернийУзел(
			РодительскиеСтроки,
			РодительСсылка,
			ОжидаемыйРодитель,
			ЗаказКлиента,
			УзелЗаказа,
			СтрокаЗП.Ссылка,
			"ЗаказПоставщику",
			СтрокаЗП.Проведен,
			УзелНеСвязанные,
			ЕстьСироты);
		УзелНеСвязанные = РезультатРазмещения.УзелНеСвязанные;
		ЕстьСироты = РезультатРазмещения.ЕстьСироты;

		УзлыЗаказовПоставщику.Вставить(СтрокаЗП.Ссылка, РезультатРазмещения.Узел);

	КонецЦикла;

	Для Каждого СтрокаПриобретения Из УникальныеСсылки(ДокументыЦепочки.Приобретения, "Ссылка") Цикл

		УзелЗП = УзлыЗаказовПоставщику.Получить(СтрокаПриобретения.ЗаказПоставщику);
		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;

		Если УзелЗП <> Неопределено Тогда

			РодительскиеСтроки = УзелЗП.Строки;
			РодительСсылка = СтрокаПриобретения.ЗаказПоставщику;

		КонецЕсли;

		РезультатРазмещения = РазместитьДочернийУзел(
			РодительскиеСтроки,
			РодительСсылка,
			СтрокаПриобретения.ЗаказПоставщику,
			ЗаказКлиента,
			УзелЗаказа,
			СтрокаПриобретения.Ссылка,
			"ПриобретениеТоваровУслуг",
			СтрокаПриобретения.Проведен,
			УзелНеСвязанные,
			ЕстьСироты);
		УзелНеСвязанные = РезультатРазмещения.УзелНеСвязанные;
		ЕстьСироты = РезультатРазмещения.ЕстьСироты;

		УзлыПриобретений.Вставить(СтрокаПриобретения.Ссылка, РезультатРазмещения.Узел);

	КонецЦикла;

	Для Каждого СтрокаОрдера Из УникальныеСсылки(ДокументыЦепочки.ПриходныеОрдера, "Ссылка") Цикл

		УзелПриобретения = УзлыПриобретений.Получить(СтрокаОрдера.Распоряжение);
		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;

		Если УзелПриобретения <> Неопределено Тогда

			РодительскиеСтроки = УзелПриобретения.Строки;
			РодительСсылка = СтрокаОрдера.Распоряжение;

		КонецЕсли;

		РезультатРазмещения = РазместитьДочернийУзел(
			РодительскиеСтроки,
			РодительСсылка,
			СтрокаОрдера.Распоряжение,
			ЗаказКлиента,
			УзелЗаказа,
			СтрокаОрдера.Ссылка,
			"ПриходныйОрдерНаТовары",
			СтрокаОрдера.Проведен,
			УзелНеСвязанные,
			ЕстьСироты);
		УзелНеСвязанные = РезультатРазмещения.УзелНеСвязанные;
		ЕстьСироты = РезультатРазмещения.ЕстьСироты;
		УзелОрдера = РезультатРазмещения.Узел;
		ДобавитьУзлыШтрихкодов(УзелОрдера, СтрокаОрдера.Ссылка, ДокументыЦепочки.ШтрихкодыПриемки, ДокументыЦепочки.ВложенныеШтрихкоды);

	КонецЦикла;

	ДобавитьШтрихкодыПриобретенийБезОрдера(УзлыПриобретений, ДокументыЦепочки);

	Для Каждого СтрокаСборкиТоваров Из ДокументыЦепочки.СборкиТоваров Цикл

		УзелСборки = УзлыСборок.Получить(СтрокаСборкиТоваров.ЗаказНаСборку);
		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;

		Если УзелСборки <> Неопределено Тогда

			РодительскиеСтроки = УзелСборки.Строки;
			РодительСсылка = СтрокаСборкиТоваров.ЗаказНаСборку;

		КонецЕсли;

		ДобавитьУзелДерева(
			РодительскиеСтроки,
			СтрокаСборкиТоваров.Ссылка,
			"СборкаТоваров",
			СтрокаСборкиТоваров.Проведен,
			РодительСсылка);

	КонецЦикла;

	Для Каждого СтрокаРеализации Из ДокументыЦепочки.Реализации Цикл

		УзлыРеализаций.Вставить(
			СтрокаРеализации.Ссылка,
			ДобавитьУзелДерева(
				УзелЗаказа.Строки,
				СтрокаРеализации.Ссылка,
				"РеализацияТоваровУслуг",
				СтрокаРеализации.Проведен,
				ЗаказКлиента));

	КонецЦикла;

	ДобавитьРасходныеОрдераВДерево(УзелЗаказа, ЗаказКлиента, ДокументыЦепочки, УзлыРеализаций);

	Для Каждого СтрокаЗаявки Из ДокументыЦепочки.Заявки Цикл

		УзелЗП = УзлыЗаказовПоставщику.Получить(СтрокаЗаявки.ЗаказПоставщику);
		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;

		Если УзелЗП <> Неопределено Тогда

			РодительскиеСтроки = УзелЗП.Строки;
			РодительСсылка = СтрокаЗаявки.ЗаказПоставщику;

		КонецЕсли;

		УзлыЗаявок.Вставить(
			СтрокаЗаявки.Ссылка,
			ДобавитьУзелДерева(
				РодительскиеСтроки,
				СтрокаЗаявки.Ссылка,
				"ЗаявкаНаРасходованиеДенежныхСредств",
				СтрокаЗаявки.Проведен,
				РодительСсылка));

	КонецЦикла;

	Для Каждого СтрокаРасхода Из УникальныеСсылки(ДокументыЦепочки.РасходыДС, "Ссылка") Цикл

		УзелЗаявки = УзлыЗаявок.Получить(СтрокаРасхода.Заявка);
		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;

		Если УзелЗаявки <> Неопределено Тогда

			РодительскиеСтроки = УзелЗаявки.Строки;
			РодительСсылка = СтрокаРасхода.Заявка;

		КонецЕсли;

		ТипРасхода = "СписаниеБезналичныхДенежныхСредств";

		Если ТипЗнч(СтрокаРасхода.Ссылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда

			ТипРасхода = "РасходныйКассовыйОрдер";

		КонецЕсли;

		ДобавитьУзелДерева(РодительскиеСтроки, СтрокаРасхода.Ссылка, ТипРасхода, СтрокаРасхода.Проведен, РодительСсылка);

	КонецЦикла;

	Для Каждого СтрокаПоступления Из УникальныеСсылки(ДокументыЦепочки.ПоступленияДС, "Ссылка") Цикл

		ТипПоступления = "ПоступлениеБезналичныхДенежныхСредств";

		Если ТипЗнч(СтрокаПоступления.Ссылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда

			ТипПоступления = "ПриходныйКассовыйОрдер";

		КонецЕсли;

		ДобавитьУзелДерева(
			УзелЗаказа.Строки,
			СтрокаПоступления.Ссылка,
			ТипПоступления,
			СтрокаПоступления.Проведен,
			ЗаказКлиента);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Дерево", Дерево);
	Результат.Вставить("ЕстьСироты", ЕстьСироты);

	Возврат Результат;

КонецФункции

Процедура ДобавитьРасходныеОрдераВДерево(УзелЗаказа, ЗаказКлиента, ДокументыЦепочки, УзлыРеализаций)

	Для Каждого СтрокаОрдера Из УникальныеСсылки(ДокументыЦепочки.РасходныеОрдера, "Ссылка") Цикл

		РодительскиеСтроки = УзелЗаказа.Строки;
		РодительСсылка = ЗаказКлиента;
		РеализацияОрдера = СтрокаОрдера.Реализация;

		Если Не ЗначениеЗаполнено(РеализацияОрдера) Тогда

			РеализацияОрдера = РеализацияПоПересечениюТоваров(СтрокаОрдера.Ссылка, ДокументыЦепочки);

		КонецЕсли;

		Если ЗначениеЗаполнено(РеализацияОрдера) Тогда

			УзелРеализации = УзлыРеализаций.Получить(РеализацияОрдера);

			Если УзелРеализации <> Неопределено Тогда

				РодительскиеСтроки = УзелРеализации.Строки;
				РодительСсылка = РеализацияОрдера;

			КонецЕсли;

		КонецЕсли;

		УзелОрдера = ДобавитьУзелДерева(
			РодительскиеСтроки,
			СтрокаОрдера.Ссылка,
			"РасходныйОрдерНаТовары",
			СтрокаОрдера.Проведен,
			РодительСсылка);
		ДобавитьУзлыШтрихкодов(УзелОрдера, СтрокаОрдера.Ссылка, ДокументыЦепочки.ШтрихкодыОтгрузки, ДокументыЦепочки.ВложенныеШтрихкоды);

	КонецЦикла;

	Для Каждого КлючИЗначение Из УзлыРеализаций Цикл

		ДобавитьУзлыШтрихкодов(
			КлючИЗначение.Значение,
			КлючИЗначение.Ключ,
			ДокументыЦепочки.ШтрихкодыОтгрузки,
			ДокументыЦепочки.ВложенныеШтрихкоды);

	КонецЦикла;

КонецПроцедуры

Функция РеализацияПоПересечениюТоваров(Ордер, ДокументыЦепочки)

	СтрокиОрдера = ДокументыЦепочки.РасходныеОрдера.НайтиСтроки(Новый Структура("Ссылка", Ордер));
	Кандидаты = Новый Соответствие;

	Для Каждого СтрокаОрдера Из СтрокиОрдера Цикл

		Для Каждого СтрокаРеализации Из ДокументыЦепочки.Реализации Цикл

			Кандидаты.Вставить(СтрокаРеализации.Ссылка, Истина);

		КонецЦикла;

	КонецЦикла;

	Если Кандидаты.Количество() <> 1 Тогда

		Возврат Неопределено;

	КонецЕсли;

	Для Каждого КлючИЗначение Из Кандидаты Цикл

		Возврат КлючИЗначение.Ключ;

	КонецЦикла;

КонецФункции

Процедура ДобавитьШтрихкодыПриобретенийБезОрдера(УзлыПриобретений, ДокументыЦепочки)

	ОрдераПоРаспоряжению = Новый Соответствие;

	Для Каждого СтрокаОрдера Из ДокументыЦепочки.ПриходныеОрдера Цикл

		ОрдераПоРаспоряжению.Вставить(СтрокаОрдера.Распоряжение, Истина);

	КонецЦикла;

	Для Каждого СтрокаШтрихкода Из ДокументыЦепочки.ШтрихкодыПриемки Цикл

		Если ТипЗнч(СтрокаШтрихкода.Документ) <> Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда

			Продолжить;

		КонецЕсли;

		Если ОрдераПоРаспоряжению.Получить(СтрокаШтрихкода.Документ) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		УзелПриобретения = УзлыПриобретений.Получить(СтрокаШтрихкода.Документ);

		Если УзелПриобретения <> Неопределено Тогда

			ДобавитьУзлыШтрихкодов(
				УзелПриобретения,
				СтрокаШтрихкода.Документ,
				ДокументыЦепочки.ШтрихкодыПриемки,
				ДокументыЦепочки.ВложенныеШтрихкоды);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьУзлыШтрихкодов(РодительскийУзел, Документ, Штрихкоды, ВложенныеШтрихкоды)

	Отбор = Новый Структура("Документ", Документ);
	СтрокиДокумента = Штрихкоды.НайтиСтроки(Отбор);
	Добавленные = Новый Соответствие;

	Для Каждого СтрокаШтрихкода Из СтрокиДокумента Цикл

		Если Добавленные.Получить(СтрокаШтрихкода.ШтрихкодУпаковки) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		Добавленные.Вставить(СтрокаШтрихкода.ШтрихкодУпаковки, Истина);
		УзелШтрихкода = ДобавитьУзелДерева(
			РодительскийУзел.Строки,
			СтрокаШтрихкода.ШтрихкодУпаковки,
			"ШтрихкодыУпаковокТоваров",
			Истина,
			Документ);
		ДобавитьВложенныеУзлыШтрихкодов(УзелШтрихкода, СтрокаШтрихкода.ШтрихкодУпаковки, ВложенныеШтрихкоды);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВложенныеУзлыШтрихкодов(РодительскийУзел, Родитель, ВложенныеШтрихкоды)

	Отбор = Новый Структура("Родитель", Родитель);

	Для Каждого СтрокаВложенных Из ВложенныеШтрихкоды.НайтиСтроки(Отбор) Цикл

		УзелВложенного = ДобавитьУзелДерева(
			РодительскийУзел.Строки,
			СтрокаВложенных.Вложенный,
			"ШтрихкодыУпаковокТоваров",
			Истина,
			Родитель);
		ДобавитьВложенныеУзлыШтрихкодов(УзелВложенного, СтрокаВложенных.Вложенный, ВложенныеШтрихкоды);

	КонецЦикла;

КонецПроцедуры

Функция НовоеДеревоДокументов()

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Ссылка");
	Дерево.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("РодительСсылка");

	Возврат Дерево;

КонецФункции

Функция ПолучитьУзелНеСвязанные(УзелЗаказа, ЗаказКлиента, УзелНеСвязанные)

	Если УзелНеСвязанные = Неопределено Тогда

		УзелНеСвязанные = ДобавитьУзелДерева(
			УзелЗаказа.Строки,
			Неопределено,
			"НеСвязанные",
			Ложь,
			ЗаказКлиента);
		УзелНеСвязанные.Представление = "Не связанные";

	КонецЕсли;

	Возврат УзелНеСвязанные;

КонецФункции

Функция РазместитьДочернийУзел(
	СтрокиРодителя,
	РодительСсылка,
	ОжидаемыйРодитель,
	ЗаказКлиента,
	УзелЗаказа,
	СсылкаУзла,
	ТипУзла,
	Проведен,
	УзелНеСвязанные,
	ЕстьСироты)

	Если ЗначениеЗаполнено(ОжидаемыйРодитель)
		И ОжидаемыйРодитель <> ЗаказКлиента
		И СтрокиРодителя = УзелЗаказа.Строки
		И РодительСсылка = ЗаказКлиента Тогда

		УзелНеСвязанные = ПолучитьУзелНеСвязанные(УзелЗаказа, ЗаказКлиента, УзелНеСвязанные);
		ЕстьСироты = Истина;
		СтрокиРодителя = УзелНеСвязанные.Строки;
		РодительСсылка = Неопределено;

	КонецЕсли;

	Узел = ДобавитьУзелДерева(СтрокиРодителя, СсылкаУзла, ТипУзла, Проведен, РодительСсылка);

	Возврат Новый Структура("Узел, УзелНеСвязанные, ЕстьСироты", Узел, УзелНеСвязанные, ЕстьСироты);

КонецФункции


Функция ДобавитьУзелДерева(СтрокиРодителя, СсылкаУзла, ТипУзла, Проведен, РодительСсылка)

	Узел = СтрокиРодителя.Добавить();
	Узел.Ссылка = СсылкаУзла;
	Узел.Тип = ТипУзла;
	Узел.Проведен = Проведен;
	Узел.Представление = Строка(СсылкаУзла);
	Узел.РодительСсылка = РодительСсылка;

	Возврат Узел;

КонецФункции

Функция УникальныеСсылки(ИсходныеСтроки, ИмяКолонки)

	Результат = ИсходныеСтроки.СкопироватьКолонки();
	УжеЕсть = Новый Соответствие;

	Для Каждого СтрокаИсходных Из ИсходныеСтроки Цикл

		Если УжеЕсть.Получить(СтрокаИсходных[ИмяКолонки]) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		УжеЕсть.Вставить(СтрокаИсходных[ИмяКолонки], Истина);
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаИсходных);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Факты

Процедура ЗаполнитьФактыСтрокЗаказа(Состояние, ЗаказКлиента, РеквизитыЗаказа, ДокументыЦепочки)

	СтрокиЗаказа = НоваяТаблицаФактовСтрокЗаказа();
	ДлинаШифра = 10;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	СУММА(Товары.Количество) КАК Заказано,
	|	СУММА(Товары.СуммаСНДС) КАК СуммаЗаказано,
	|	ВЫРАЗИТЬ(Товары.Характеристика КАК Справочник.ХарактеристикиНоменклатуры).Наименование КАК НаименованиеХарактеристики
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &ЗаказКлиента
	|	И НЕ Товары.Отменено
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	ВЫРАЗИТЬ(Товары.Характеристика КАК Справочник.ХарактеристикиНоменклатуры).Наименование";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Выборка = Запрос.Выполнить().Выбрать();
	ИндексСтрок = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		СтрокаФактов = СтрокиЗаказа.Добавить();
		СтрокаФактов.Номенклатура = Выборка.Номенклатура;
		СтрокаФактов.Характеристика = Выборка.Характеристика;
		СтрокаФактов.Заказано = Выборка.Заказано;
		СтрокаФактов.СуммаЗаказано = Выборка.СуммаЗаказано;
		СтрокаФактов.Шифр = Лев(СокрЛП(Строка(Выборка.НаименованиеХарактеристики)), ДлинаШифра);
		СтрокаФактов.Валюта = РеквизитыЗаказа.Валюта;
		ИндексСтрок.Вставить(КлючЗерна(Выборка.Номенклатура, Выборка.Характеристика), СтрокаФактов);

	КонецЦикла;

	Для Каждого СтрокаСборки Из ДокументыЦепочки.Сборки Цикл

		СтрокаФактов = СтрокаФактовПоЗерну(СтрокиЗаказа, ИндексСтрок, СтрокаСборки.Номенклатура, СтрокаСборки.Характеристика, Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.ВСборке = СтрокаФактов.ВСборке + СтрокаСборки.Количество;

	КонецЦикла;

	Для Каждого СтрокаСборкиТоваров Из ДокументыЦепочки.СборкиТоваров Цикл

		Если Не СтрокаСборкиТоваров.Проведен Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов = СтрокаФактовПоЗерну(
			СтрокиЗаказа,
			ИндексСтрок,
			СтрокаСборкиТоваров.Номенклатура,
			СтрокаСборкиТоваров.Характеристика,
			Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.Собрано = СтрокаФактов.Собрано + СтрокаСборкиТоваров.Количество;

	КонецЦикла;

	Для Каждого СтрокаЗП Из ДокументыЦепочки.СтрокиЗаказаПоставщику Цикл

		Если ЗначениеЗаполнено(СтрокаЗП.ЗаказНаСборку) Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов = СтрокаФактовПоЗерну(СтрокиЗаказа, ИндексСтрок, СтрокаЗП.Номенклатура, СтрокаЗП.Характеристика, Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.ЗаказаноПоставщику = СтрокаФактов.ЗаказаноПоставщику + СтрокаЗП.Количество;

	КонецЦикла;

	Для Каждого СтрокаПриобретения Из ДокументыЦепочки.Приобретения Цикл

		СтрокаФактов = СтрокаФактовПоЗерну(
			СтрокиЗаказа,
			ИндексСтрок,
			СтрокаПриобретения.Номенклатура,
			СтрокаПриобретения.Характеристика,
			Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.Приобретено = СтрокаФактов.Приобретено + СтрокаПриобретения.Количество;

	КонецЦикла;

	Для Каждого СтрокаОрдера Из ДокументыЦепочки.ПриходныеОрдера Цикл

		СтрокаФактов = СтрокаФактовПоЗерну(СтрокиЗаказа, ИндексСтрок, СтрокаОрдера.Номенклатура, СтрокаОрдера.Характеристика, Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.ПринятоОрдером = СтрокаФактов.ПринятоОрдером + СтрокаОрдера.Количество;

	КонецЦикла;

	Для Каждого СтрокаОрдера Из ДокументыЦепочки.РасходныеОрдера Цикл

		СтрокаФактов = СтрокаФактовПоЗерну(СтрокиЗаказа, ИндексСтрок, СтрокаОрдера.Номенклатура, СтрокаОрдера.Характеристика, Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.ОтгруженоОрдером = СтрокаФактов.ОтгруженоОрдером + СтрокаОрдера.Количество;

	КонецЦикла;

	ДополнитьРеализовано(СтрокиЗаказа, ИндексСтрок, ЗаказКлиента);
	ДополнитьОстатокНаСкладе(СтрокиЗаказа, РеквизитыЗаказа.Назначение);
	ДополнитьДеньгиСтрокЗаказа(СтрокиЗаказа, ЗаказКлиента, ДокументыЦепочки, РеквизитыЗаказа.Валюта);
	ПрименитьВзаимоисключениеПутейСтрокЗаказа(СтрокиЗаказа);
	ДополнитьСуммаЗаказаноСтрокЗаказа(СтрокиЗаказа, ЗаказКлиента);
	ДополнитьСебестоимостьСтрокЗаказа(СтрокиЗаказа, ЗаказКлиента, Состояние.ВалютаИтогов);
	ОпределитьПутьОбеспеченияСтрокЗаказа(СтрокиЗаказа);
	РассчитатьПрибыльСтрокЗаказа(СтрокиЗаказа);

	Состояние.СтрокиЗаказа = СтрокиЗаказа;

КонецПроцедуры

Процедура ПрименитьВзаимоисключениеПутейСтрокЗаказа(СтрокиЗаказа)

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		Если СтрокаФактов.ВСборке > 0 Тогда

			СтрокаФактов.ЗаказаноПоставщику = 0;
			СтрокаФактов.Приобретено = 0;

		Иначе

			СтрокаФактов.ВСборке = 0;
			СтрокаФактов.Собрано = 0;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьРеализовано(СтрокиЗаказа, ИндексСтрок, ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Проведен
	|	И НЕ Товары.Ссылка.ПометкаУдаления
	|	И (Товары.Ссылка.ЗаказКлиента = &ЗаказКлиента
	|			ИЛИ Товары.ЗаказКлиента = &ЗаказКлиента)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		СтрокаФактов = СтрокаФактовПоЗерну(СтрокиЗаказа, ИндексСтрок, Выборка.Номенклатура, Выборка.Характеристика, Ложь);

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.Реализовано = Выборка.Количество;

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьОстатокНаСкладе(СтрокиЗаказа, Назначение)

	Если СтрокиЗаказа.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Зерно.Номенклатура КАК Номенклатура,
	|	Зерно.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Зерно
	|ИЗ
	|	&Зерно КАК Зерно
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.ВНаличииОстаток КАК ОстатокНаСкладе
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки(
	|			,
	|			Назначение = &Назначение
	|				И (Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						ВТ_Зерно.Номенклатура КАК Номенклатура,
	|						ВТ_Зерно.Характеристика КАК Характеристика
	|					ИЗ
	|						ВТ_Зерно КАК ВТ_Зерно)) КАК Остатки";

	Если ЗначениеЗаполнено(Назначение) Тогда

		Запрос.УстановитьПараметр("Назначение", Назначение);

	Иначе

		Запрос.УстановитьПараметр("Назначение", Справочники.Назначения.ПустаяСсылка());

	КонецЕсли;

	Запрос.УстановитьПараметр("Зерно", СтрокиЗаказа.Скопировать(, "Номенклатура, Характеристика"));

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		Отбор = Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Характеристика);
		НайденныеСтроки = СтрокиЗаказа.НайтиСтроки(Отбор);

		Если НайденныеСтроки.Количество() > 0 Тогда

			НайденныеСтроки[0].ОстатокНаСкладе = Выборка.ОстатокНаСкладе;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьДеньгиСтрокЗаказа(СтрокиЗаказа, ЗаказКлиента, ДокументыЦепочки, ВалютаЗаказа)

	Оплаты = ОплатыПоШифрамЗаказа(ЗаказКлиента);
	ЗаявленоПоШифрам = ЗаявленоПоШифрамЦепочки(ДокументыЦепочки);

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		СтрокаОплаты = Оплаты.Найти(СтрокаФактов.Шифр, "Шифр");

		Если СтрокаОплаты <> Неопределено Тогда

			СтрокаФактов.ОплаченоКлиентом = СтрокаОплаты.СуммаПриход;
			СтрокаФактов.ОплаченоПоставщику = СтрокаОплаты.СуммаРасход;
			СтрокаФактов.Валюта = СтрокаОплаты.Валюта;

		КонецЕсли;

		СуммаЗаявлено = ЗаявленоПоШифрам.Получить(СтрокаФактов.Шифр);

		Если СуммаЗаявлено <> Неопределено Тогда

			СтрокаФактов.Заявлено = СуммаЗаявлено;

		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаФактов.Валюта) Тогда

			СтрокаФактов.Валюта = ВалютаЗаказа;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ОплатыПоШифрамЗаказа(ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оплата.Шифр КАК Шифр,
	|	СУММА(Оплата.СуммаПриход) КАК СуммаПриход,
	|	СУММА(Оплата.СуммаРасход) КАК СуммаРасход,
	|	ЕСТЬNULL(Поступление.Валюта, ЕСТЬNULL(ПКО.Валюта, ЕСТЬNULL(Списание.Валюта, РКО.Валюта))) КАК Валюта
	|ИЗ
	|	РегистрНакопления.АУ_ОплатаПоШифрам КАК Оплата
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств КАК Поступление
	|		ПО Оплата.ДокументОплаты = Поступление.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК ПКО
	|		ПО Оплата.ДокументОплаты = ПКО.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств КАК Списание
	|		ПО Оплата.ДокументОплаты = Списание.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйКассовыйОрдер КАК РКО
	|		ПО Оплата.ДокументОплаты = РКО.Ссылка
	|ГДЕ
	|	Оплата.ЗаказКлиента = &ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	Оплата.Шифр,
	|	ЕСТЬNULL(Поступление.Валюта, ЕСТЬNULL(ПКО.Валюта, ЕСТЬNULL(Списание.Валюта, РКО.Валюта)))";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЗаявленоПоШифрамЦепочки(ДокументыЦепочки)

	ИтогиПоШифрам = Новый Соответствие;
	Заявки = ДокументыЦепочки.Заявки.ВыгрузитьКолонку("Ссылка");

	Если Заявки.Количество() = 0 Тогда

		Возврат ИтогиПоШифрам;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Статьи.Шифр КАК Шифр,
	|	Статьи.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.АУ_СтатьиБюджета КАК Статьи
	|ГДЕ
	|	Статьи.Ссылка В (&Заявки)";
	Запрос.УстановитьПараметр("Заявки", Заявки);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого ЧастьШифра Из ШифрыСписка(Выборка.Шифр) Цикл

			Было = ИтогиПоШифрам.Получить(ЧастьШифра);

			Если Было = Неопределено Тогда

				Было = 0;

			КонецЕсли;

			ИтогиПоШифрам.Вставить(ЧастьШифра, Было + Выборка.Сумма);

		КонецЦикла;

	КонецЦикла;

	Возврат ИтогиПоШифрам;

КонецФункции

Функция ШифрыСписка(ШифрСтрокой)

	Возврат АУ_ОплатыПоЗаказамСервер.ШифрыСписка(ШифрСтрокой);

КонецФункции

Процедура ДополнитьСуммаЗаказаноСтрокЗаказа(СтрокиЗаказа, ЗаказКлиента)

	Если СтрокиЗаказа.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	СУММА(Товары.СуммаСНДС) КАК СуммаЗаказано
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &ЗаказКлиента
	|	И НЕ Товары.Отменено
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ИндексСтрок = Новый Соответствие;

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		ИндексСтрок.Вставить(КлючЗерна(СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика), СтрокаФактов);

	КонецЦикла;

	Пока Выборка.Следующий() Цикл

		СтрокаФактов = ИндексСтрок.Получить(КлючЗерна(Выборка.Номенклатура, Выборка.Характеристика));

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.СуммаЗаказано = Выборка.СуммаЗаказано;

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьСебестоимостьСтрокЗаказа(СтрокиЗаказа, ЗаказКлиента, ВалютаИтогов)

	Если СтрокиЗаказа.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	ИспользоватьРегл = Ложь;

	Если ЗначениеЗаполнено(ВалютаИтогов) Тогда

		ИспользоватьРегл = (ВалютаИтогов = Константы.ВалютаРегламентированногоУчета.Получить());

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Продажи.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	Продажи.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	СУММА(ВЫБОР
	|			КОГДА &ИспользоватьРегл
	|				ТОГДА ЕСТЬNULL(Продажи.СтоимостьРеглОборот, 0) + ЕСТЬNULL(Продажи.ДопРасходыРеглОборот, 0)
	|			ИНАЧЕ ЕСТЬNULL(Продажи.СтоимостьУпрОборот, 0) + ЕСТЬNULL(Продажи.ДопРасходыУпрОборот, 0)
	|		КОНЕЦ) КАК СуммаСебестоимости
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(, , , ЗаказКлиента = &ЗаказКлиента) КАК Продажи
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.АналитикаУчетаНоменклатуры.Номенклатура,
	|	Продажи.АналитикаУчетаНоменклатуры.Характеристика";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Запрос.УстановитьПараметр("ИспользоватьРегл", ИспользоватьРегл);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ИндексСтрок = Новый Соответствие;

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		ИндексСтрок.Вставить(КлючЗерна(СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика), СтрокаФактов);

	КонецЦикла;

	Пока Выборка.Следующий() Цикл

		СтрокаФактов = ИндексСтрок.Получить(КлючЗерна(Выборка.Номенклатура, Выборка.Характеристика));

		Если СтрокаФактов = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.СуммаСебестоимости = Выборка.СуммаСебестоимости;

	КонецЦикла;

КонецПроцедуры

Процедура ОпределитьПутьОбеспеченияСтрокЗаказа(СтрокиЗаказа)

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		Если СтрокаФактов.ВСборке > 0 Тогда

			СтрокаФактов.ПутьОбеспечения = "Сборка";

		ИначеЕсли СтрокаФактов.ЗаказаноПоставщику > 0 Тогда

			СтрокаФактов.ПутьОбеспечения = "Закупка";

		Иначе

			СтрокаФактов.ПутьОбеспечения = "СоСклада";

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура РассчитатьПрибыльСтрокЗаказа(СтрокиЗаказа)

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		Если СтрокаФактов.ПутьОбеспечения = "СоСклада" Тогда

			СтрокаФактов.Прибыль = СтрокаФактов.ОплаченоКлиентом - СтрокаФактов.СуммаСебестоимости;

		Иначе

			СтрокаФактов.Прибыль = СтрокаФактов.ОплаченоКлиентом - СтрокаФактов.ОплаченоПоставщику;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПересчитатьСебестоимостьСтрокЗаказа(СтрокиЗаказа, ВалютаИтогов, ДатаКурса)

	Если Не ЗначениеЗаполнено(ВалютаИтогов) Тогда

		Возврат;

	КонецЕсли;

	ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
	ВалютаИсточника = ВалютаУпр;

	Если ВалютаИтогов = ВалютаРегл Тогда

		Возврат;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВалютаИсточника) Или ВалютаИсточника = ВалютаИтогов Тогда

		Возврат;

	КонецЕсли;

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		Если СтрокаФактов.СуммаСебестоимости = 0 Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактов.СуммаСебестоимости = РаботаСКурсамиВалют.ПересчитатьВВалюту(
			СтрокаФактов.СуммаСебестоимости,
			ВалютаИсточника,
			ВалютаИтогов,
			ДатаКурса);

	КонецЦикла;

КонецПроцедуры

Функция ЗаявленоПоЗаявкеИШифру(ТаблицаЗаявлено, Заявка, Шифр)

	Если ТаблицаЗаявлено = Неопределено Или Не ЗначениеЗаполнено(Заявка) Или ПустаяСтрока(Шифр) Тогда

		Возврат 0;

	КонецЕсли;

	Сумма = 0;
	Отбор = Новый Структура("Заявка, Шифр", Заявка, Шифр);
	НайденныеСтроки = ТаблицаЗаявлено.НайтиСтроки(Отбор);

	Для Каждого СтрокаЗаявлено Из НайденныеСтроки Цикл

		Сумма = Сумма + СтрокаЗаявлено.Сумма;

	КонецЦикла;

	Возврат Сумма;

КонецФункции

Функция ОплаченоПоДокументуИШифру(ТаблицаОплат, ДокументОплаты, Шифр, ЭтоПриход)

	Если ТаблицаОплат = Неопределено Или Не ЗначениеЗаполнено(ДокументОплаты) Или ПустаяСтрока(Шифр) Тогда

		Возврат 0;

	КонецЕсли;

	Сумма = 0;
	Отбор = Новый Структура("ДокументОплаты, Шифр", ДокументОплаты, Шифр);
	НайденныеСтроки = ТаблицаОплат.НайтиСтроки(Отбор);

	Для Каждого СтрокаОплаты Из НайденныеСтроки Цикл

		Если ЭтоПриход Тогда

			Сумма = Сумма + СтрокаОплаты.СуммаПриход;

		Иначе

			Сумма = Сумма + СтрокаОплаты.СуммаРасход;

		КонецЕсли;

	КонецЦикла;

	Возврат Сумма;

КонецФункции

Функция ТаблицаЗаявленоПоЗаявкамЦепочки(Дерево)

	ТаблицаЗаявлено = Новый ТаблицаЗначений;
	ТаблицаЗаявлено.Колонки.Добавить("Заявка");
	ТаблицаЗаявлено.Колонки.Добавить("Шифр", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	ТаблицаЗаявлено.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Заявки = Новый Массив;
	СобратьСсылкиДереваПоТипу(Дерево.Строки, "ЗаявкаНаРасходованиеДенежныхСредств", Заявки);

	Если Заявки.Количество() = 0 Тогда

		Возврат ТаблицаЗаявлено;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Статьи.Ссылка КАК Заявка,
	|	Статьи.Шифр КАК Шифр,
	|	Статьи.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.АУ_СтатьиБюджета КАК Статьи
	|ГДЕ
	|	Статьи.Ссылка В (&Заявки)";
	Запрос.УстановитьПараметр("Заявки", Заявки);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого ЧастьШифра Из ШифрыСписка(Выборка.Шифр) Цикл

			СтрокаЗаявлено = ТаблицаЗаявлено.Добавить();
			СтрокаЗаявлено.Заявка = Выборка.Заявка;
			СтрокаЗаявлено.Шифр = ЧастьШифра;
			СтрокаЗаявлено.Сумма = Выборка.Сумма;

		КонецЦикла;

	КонецЦикла;

	ТаблицаЗаявлено.Индексы.Добавить("Заявка, Шифр");

	Возврат ТаблицаЗаявлено;

КонецФункции

Функция ТаблицаОплатПоШифрамЗаказа(ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оплата.ДокументОплаты КАК ДокументОплаты,
	|	Оплата.Шифр КАК Шифр,
	|	СУММА(Оплата.СуммаПриход) КАК СуммаПриход,
	|	СУММА(Оплата.СуммаРасход) КАК СуммаРасход
	|ИЗ
	|	РегистрНакопления.АУ_ОплатаПоШифрам КАК Оплата
	|ГДЕ
	|	Оплата.ЗаказКлиента = &ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	Оплата.ДокументОплаты,
	|	Оплата.Шифр";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаОплат = РезультатЗапроса.Выгрузить();
	ТаблицаОплат.Индексы.Добавить("ДокументОплаты, Шифр");

	Возврат ТаблицаОплат;

КонецФункции

Процедура СобратьСсылкиДереваПоТипу(СтрокиДерева, ТипУзла, Ссылки)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = ТипУзла И ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			Если Ссылки.Найти(СтрокаДерева.Ссылка) = Неопределено Тогда

				Ссылки.Добавить(СтрокаДерева.Ссылка);

			КонецЕсли;

		КонецЕсли;

		СобратьСсылкиДереваПоТипу(СтрокаДерева.Строки, ТипУзла, Ссылки);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьФактыСборкиИЗаказовПоставщику(Состояние, ЗаказКлиента, ДокументыЦепочки)

	ЗаказыНаСборку = НоваяТаблицаФактовСборки();
	ЗаказыПоставщику = НоваяТаблицаФактовЗаказаПоставщику();
	ИндексСборки = Новый Соответствие;
	ИндексЗП = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК ЗаказНаСборку,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	СУММА(Товары.Количество) КАК Заказано
	|ИЗ
	|	Документ.ЗаказНаСборку.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Сборки)
	|	И НЕ Товары.Отменено
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка,
	|	Товары.Номенклатура,
	|	Товары.Характеристика";
	Запрос.УстановитьПараметр("Сборки", ДокументыЦепочки.Сборки.ВыгрузитьКолонку("Ссылка"));

	Если ДокументыЦепочки.Сборки.Количество() > 0 Тогда

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл

			СтрокаФактов = ЗаказыНаСборку.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаФактов, Выборка);
			ИндексСборки.Вставить(
				КлючЗернаСборки(Выборка.ЗаказНаСборку, Выборка.Номенклатура, Выборка.Характеристика),
				СтрокаФактов);

		КонецЦикла;

	КонецЕсли;

	Для Каждого СтрокаЗП Из ДокументыЦепочки.СтрокиЗаказаПоставщику Цикл

		СтрокаФактовЗП = СтрокаФактовЗППоЗерну(
			ЗаказыПоставщику,
			ИндексЗП,
			СтрокаЗП.Ссылка,
			СтрокаЗП.Номенклатура,
			СтрокаЗП.Характеристика);
		СтрокаФактовЗП.Заказано = СтрокаФактовЗП.Заказано + СтрокаЗП.Количество;
		СтрокаФактовЗП.Валюта = СтрокаЗП.Валюта;

		Если ЗначениеЗаполнено(СтрокаЗП.ЗаказНаСборку) Тогда

			СтрокаСборки = СтрокаФактовСборкиПоЗерну(
				ЗаказыНаСборку,
				ИндексСборки,
				СтрокаЗП.ЗаказНаСборку,
				СтрокаЗП.Номенклатура,
				СтрокаЗП.Характеристика);
			СтрокаСборки.ЗаказаноПоставщику = СтрокаСборки.ЗаказаноПоставщику + СтрокаЗП.Количество;

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаПриобретения Из ДокументыЦепочки.Приобретения Цикл

		СтрокаФактовЗП = СтрокаФактовЗППоЗерну(
			ЗаказыПоставщику,
			ИндексЗП,
			СтрокаПриобретения.ЗаказПоставщику,
			СтрокаПриобретения.Номенклатура,
			СтрокаПриобретения.Характеристика);
		СтрокаФактовЗП.Приобретено = СтрокаФактовЗП.Приобретено + СтрокаПриобретения.Количество;

		СтрокиЗП = ДокументыЦепочки.СтрокиЗаказаПоставщику.НайтиСтроки(
			Новый Структура("Ссылка, Номенклатура, Характеристика",
				СтрокаПриобретения.ЗаказПоставщику,
				СтрокаПриобретения.Номенклатура,
				СтрокаПриобретения.Характеристика));

		Если СтрокиЗП.Количество() > 0 И ЗначениеЗаполнено(СтрокиЗП[0].ЗаказНаСборку) Тогда

			СтрокаСборки = СтрокаФактовСборкиПоЗерну(
				ЗаказыНаСборку,
				ИндексСборки,
				СтрокиЗП[0].ЗаказНаСборку,
				СтрокаПриобретения.Номенклатура,
				СтрокаПриобретения.Характеристика);
			СтрокаСборки.Приобретено = СтрокаСборки.Приобретено + СтрокаПриобретения.Количество;

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаОрдера Из ДокументыЦепочки.ПриходныеОрдера Цикл

		СтрокиПриобретения = ДокументыЦепочки.Приобретения.НайтиСтроки(
			Новый Структура("Ссылка, Номенклатура, Характеристика",
				СтрокаОрдера.Распоряжение,
				СтрокаОрдера.Номенклатура,
				СтрокаОрдера.Характеристика));

		Если СтрокиПриобретения.Количество() = 0 Тогда

			Продолжить;

		КонецЕсли;

		СтрокаФактовЗП = СтрокаФактовЗППоЗерну(
			ЗаказыПоставщику,
			ИндексЗП,
			СтрокиПриобретения[0].ЗаказПоставщику,
			СтрокаОрдера.Номенклатура,
			СтрокаОрдера.Характеристика);
		СтрокаФактовЗП.ПринятоОрдером = СтрокаФактовЗП.ПринятоОрдером + СтрокаОрдера.Количество;

	КонецЦикла;

	ЗаявленоПоШифрам = ЗаявленоПоШифрамЦепочки(ДокументыЦепочки);
	Оплаты = ОплатыПоШифрамЗаказа(ЗаказКлиента);

	Для Каждого СтрокаСборки Из ЗаказыНаСборку Цикл

		Шифр = Лев(СокрЛП(Строка(СтрокаСборки.Характеристика)), 10);
		СуммаЗаявлено = ЗаявленоПоШифрам.Получить(Шифр);

		Если СуммаЗаявлено <> Неопределено Тогда

			СтрокаСборки.Заявлено = СуммаЗаявлено;

		КонецЕсли;

		СтрокаОплаты = Оплаты.Найти(Шифр, "Шифр");

		Если СтрокаОплаты <> Неопределено Тогда

			СтрокаСборки.Оплачено = СтрокаОплаты.СуммаРасход;

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаЗП Из ЗаказыПоставщику Цикл

		Шифр = Лев(СокрЛП(Строка(СтрокаЗП.Характеристика)), 10);
		СуммаЗаявлено = ЗаявленоПоШифрам.Получить(Шифр);

		Если СуммаЗаявлено <> Неопределено Тогда

			СтрокаЗП.Заявлено = СуммаЗаявлено;

		КонецЕсли;

		СтрокаОплаты = Оплаты.Найти(Шифр, "Шифр");

		Если СтрокаОплаты <> Неопределено Тогда

			СтрокаЗП.Оплачено = СтрокаОплаты.СуммаРасход;

		КонецЕсли;

	КонецЦикла;

	Состояние.ЗаказыНаСборку = ЗаказыНаСборку;
	Состояние.ЗаказыПоставщику = ЗаказыПоставщику;

КонецПроцедуры

Процедура ЗаполнитьФактыШтрихкодов(Состояние, ДокументыЦепочки)

	ШтрихкодыУпаковок = НоваяТаблицаФактовШтрихкодов();
	ИндексШтрихкодов = Новый Соответствие;

	ДобавитьФактШтрихкодов(ШтрихкодыУпаковок, ИндексШтрихкодов, ДокументыЦепочки.ШтрихкодыПриемки, "Принято");
	ДобавитьФактШтрихкодов(ШтрихкодыУпаковок, ИндексШтрихкодов, ДокументыЦепочки.ШтрихкодыОтгрузки, "Отгружено");

	Для Каждого СтрокаВложенных Из ДокументыЦепочки.ВложенныеШтрихкоды Цикл

		СтрокаРодителя = ИндексШтрихкодов.Получить(СтрокаВложенных.Родитель);

		Если СтрокаРодителя = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		СтрокаВложенного = ИндексШтрихкодов.Получить(СтрокаВложенных.Вложенный);

		Если СтрокаВложенного = Неопределено Тогда

			СтрокаВложенного = ШтрихкодыУпаковок.Добавить();
			СтрокаВложенного.ШтрихкодУпаковки = СтрокаВложенных.Вложенный;
			ИндексШтрихкодов.Вставить(СтрокаВложенных.Вложенный, СтрокаВложенного);

		КонецЕсли;

		СтрокаВложенного.Принято = Макс(СтрокаВложенного.Принято, СтрокаРодителя.Принято);
		СтрокаВложенного.Отгружено = Макс(СтрокаВложенного.Отгружено, СтрокаРодителя.Отгружено);

	КонецЦикла;

	Для Каждого СтрокаФактов Из ШтрихкодыУпаковок Цикл

		Если СтрокаФактов.Принято > 0 И СтрокаФактов.Отгружено = 0 Тогда

			СтрокаФактов.Остаток = 1;

		Иначе

			СтрокаФактов.Остаток = 0;

		КонецЕсли;

	КонецЦикла;

	Состояние.ШтрихкодыУпаковок = ШтрихкодыУпаковок;

КонецПроцедуры

Процедура ДобавитьФактШтрихкодов(ШтрихкодыУпаковок, ИндексШтрихкодов, Источник, ИмяКолонки)

	Для Каждого СтрокаИсточника Из Источник Цикл

		СтрокаФактов = ИндексШтрихкодов.Получить(СтрокаИсточника.ШтрихкодУпаковки);

		Если СтрокаФактов = Неопределено Тогда

			СтрокаФактов = ШтрихкодыУпаковок.Добавить();
			СтрокаФактов.ШтрихкодУпаковки = СтрокаИсточника.ШтрихкодУпаковки;
			ИндексШтрихкодов.Вставить(СтрокаИсточника.ШтрихкодУпаковки, СтрокаФактов);

		КонецЕсли;

		СтрокаФактов[ИмяКолонки] = 1;

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСверкуВзаиморасчетов(Состояние, ЗаказКлиента, РеквизитыЗаказа)

	ОплаченоКлиентом = 0;

	Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

		ОплаченоКлиентом = ОплаченоКлиентом + СтрокаФактов.ОплаченоКлиентом;

	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Расчеты.СуммаРасход), 0) КАК Оплачено
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Обороты(, , , ОбъектРасчетов.Объект = &ЗаказКлиента) КАК Расчеты";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Выборка = Запрос.Выполнить().Выбрать();
	ОплаченоПоРасчетам = 0;

	Если Выборка.Следующий() Тогда

		ОплаченоПоРасчетам = Выборка.Оплачено;

	КонецЕсли;

	Состояние.РасхождениеРасчетовСКлиентами = ОкруглитьСумму(ОплаченоКлиентом) <> ОкруглитьСумму(ОплаченоПоРасчетам);

	ОплаченоПоставщику = 0;

	Для Каждого СтрокаФактов Из Состояние.ЗаказыПоставщику Цикл

		ОплаченоПоставщику = ОплаченоПоставщику + СтрокаФактов.Оплачено;

	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Расчеты.СуммаРасход), 0) КАК Оплачено
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщиками.Обороты(
	|			,
	|			,
	|			,
	|			ОбъектРасчетов.Объект В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					СтрокиЗП.ЗаказПоставщику
	|				ИЗ
	|					(" + ТекстЗапросаСтрокиЗаказаПоставщику() + ") КАК СтрокиЗП
	|				ГДЕ
	|					СтрокиЗП.ЗаказКлиента = &ЗаказКлиента)) КАК Расчеты";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Выборка = Запрос.Выполнить().Выбрать();
	ОплаченоПоставщикамПоРасчетам = 0;

	Если Выборка.Следующий() Тогда

		ОплаченоПоставщикамПоРасчетам = Выборка.Оплачено;

	КонецЕсли;

	Состояние.РасхождениеРасчетовСПоставщиками =
		ОкруглитьСумму(ОплаченоПоставщику) <> ОкруглитьСумму(ОплаченоПоставщикамПоРасчетам);

КонецПроцедуры

