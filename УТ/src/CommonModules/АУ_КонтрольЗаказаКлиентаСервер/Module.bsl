#Область ПрограммныйИнтерфейс

// Возвращает дерево документов цепочки и таблицы фактов по заказу клиента.
// Читает кэш, если он свежий; иначе собирает из документов и обновляет кэш.
//
// Параметры:
//  ЗаказКлиента - ДокументСсылка.ЗаказКлиента
//  ВалютаИтогов - СправочникСсылка.Валюты, Неопределено - если заполнена, суммы пересчитываются в эту валюту
//
// Возвращаемое значение:
//  Структура:
//   * Дерево - ДеревоЗначений
//   * СтрокиЗаказа - ТаблицаЗначений (колонки incl. ВСборке, Собрано, ЗаказаноПоставщику, Приобретено, …)
//   * ЗаказыНаСборку - ТаблицаЗначений
//   * ЗаказыПоставщику - ТаблицаЗначений
//   * ШтрихкодыУпаковок - ТаблицаЗначений
//   * ДатаРасчета - Дата
//   * ИзКэша - Булево
//   * ВалютаИтогов - СправочникСсылка.Валюты, Неопределено
//   * РасхождениеРасчетовСКлиентами - Булево
//   * РасхождениеРасчетовСПоставщиками - Булево
//   * ЕстьСироты - Булево
//
Функция СостояниеЦепочкиЗаказа(ЗаказКлиента, ВалютаИтогов = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда

		Возврат ПустоеСостояние(ВалютаИтогов);

	КонецЕсли;

	СостояниеКэша = ПрочитатьКэшЕслиСвежий(ЗаказКлиента);

	Если СостояниеКэша <> Неопределено Тогда

		Состояние = КопияСостояния(СостояниеКэша);
		Состояние.ИзКэша = Истина;

	Иначе

		Состояние = СобратьСостояниеЦепочки(ЗаказКлиента);
		ЗаписатьКэш(ЗаказКлиента, Состояние);
		УдалитьИзОчереди(ЗаказКлиента);
		Состояние.ИзКэша = Ложь;

	КонецЕсли;

	Состояние.ВалютаИтогов = ВалютаИтогов;

	Если ЗначениеЗаполнено(ВалютаИтогов) Тогда

		ПрименитьВалютуИтогов(Состояние, ВалютаИтогов);

	КонецЕсли;

	Возврат Состояние;

КонецФункции

// Проверяет, не создается ли повторный заказ на сборку того же комплекта по тому же заказу клиента.
// Черновик в кэш не пишется.
//
// Параметры:
//  ЗаказКлиента - ДокументСсылка.ЗаказКлиента
//  ЧерновикЗаказаНаСборку - ДокументОбъект.ЗаказНаСборку, Структура - Номенклатура, Характеристика, Ссылка
//
// Возвращаемое значение:
//  Структура:
//   * ЕстьПредупреждение - Булево
//   * Текст - Строка
//
Функция ПроверитьВводЗаказаНаСборку(ЗаказКлиента, ЧерновикЗаказаНаСборку) Экспорт

	Результат = Новый Структура("ЕстьПредупреждение, Текст", Ложь, "");

	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда

		Возврат Результат;

	КонецЕсли;

	НоменклатураКомплекта = ЧерновикЗаказаНаСборку.Номенклатура;
	ХарактеристикаКомплекта = ЧерновикЗаказаНаСборку.Характеристика;
	СсылкаЧерновика = ЧерновикЗаказаНаСборку.Ссылка;

	Если Не ЗначениеЗаполнено(НоменклатураКомплекта) Тогда

		Возврат Результат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказНаСборку.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаСборку КАК ЗаказНаСборку
	|ГДЕ
	|	ЗаказНаСборку.ДокументОснование = &ЗаказКлиента
	|	И ЗаказНаСборку.Номенклатура = &Номенклатура
	|	И ЗаказНаСборку.Характеристика = &Характеристика
	|	И НЕ ЗаказНаСборку.ПометкаУдаления
	|	И ЗаказНаСборку.Ссылка <> &СсылкаЧерновика";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураКомплекта);
	Запрос.УстановитьПараметр("Характеристика", ХарактеристикаКомплекта);
	Запрос.УстановитьПараметр("СсылкаЧерновика", СсылкаЧерновика);

	Если Не Запрос.Выполнить().Пустой() Тогда

		Результат.ЕстьПредупреждение = Истина;
		Результат.Текст = "Заказ на сборку лишний: по этой номенклатуре и характеристике комплекта
			|для данного заказа клиента сборка уже есть.";

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Помечает к полному пересчету все заказы клиента, затронутые документом цепочки.
//
// Параметры:
//  ДокументИнициатор - ДокументСсылка
//
Процедура ПометитьКПересчету(ДокументИнициатор) Экспорт

	Если Не ЗначениеЗаполнено(ДокументИнициатор) Тогда

		Возврат;

	КонецЕсли;

	ЗаказыКлиента = ЗаказыКлиентаДокумента(ДокументИнициатор);

	Если ЗаказыКлиента.Количество() = 0 Тогда

		ЗаписьЖурналаРегистрации(
			"АУ.КонтрольЦепочкиЗаказа.РезолвЗаказа",
			УровеньЖурналаРегистрации.Предупреждение,
			ДокументИнициатор.Метаданные(),
			ДокументИнициатор,
			"Не удалось определить заказ клиента для документа цепочки.");
		Возврат;

	КонецЕсли;

	Для Каждого ЗаказКлиента Из ЗаказыКлиента Цикл

		ЗаписатьВОчередь(ЗаказКлиента, ДокументИнициатор);

	КонецЦикла;

КонецПроцедуры

// Пересчитывает помеченные заказы клиента порциями. Ошибка одного заказа не останавливает пачку.
//
// Параметры:
//  РазмерПорции - Число - сколько заказов обработать за запуск, по умолчанию 20
//
Процедура ПересчитатьПомеченные(РазмерПорции = 20) Экспорт

	Если РазмерПорции = 0 Тогда

		РазмерПорции = 20;

	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"АУ.КонтрольЦепочкиЗаказа.ПересчетКэша",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Старт пересчета кэша цепочки заказа.");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Очередь.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.АУ_ЗаданияКПересчётуЦепочкиЗаказа КАК Очередь
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаПометки";

	Если РазмерПорции <> 20 Тогда

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 20", "ПЕРВЫЕ " + Формат(РазмерПорции, "ЧГ=0"));

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Попытка

			ПересчитатьЗаказ(Выборка.ЗаказКлиента);

		Исключение

			ЗаписьЖурналаРегистрации(
				"АУ.КонтрольЦепочкиЗаказа.ПересчетКэша",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ЗаказКлиента,
				Выборка.ЗаказКлиента,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"АУ.КонтрольЦепочкиЗаказа.ПересчетКэша",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Финиш пересчета кэша цепочки заказа.");

КонецПроцедуры

// Принудительно собирает цепочку заказа и обновляет кэш, затем снимает пометку очереди.
//
// Параметры:
//  ЗаказКлиента - ДокументСсылка.ЗаказКлиента
//
Процедура ПересчитатьЗаказ(ЗаказКлиента) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда

		Возврат;

	КонецЕсли;

	АУ_ОплатыПоЗаказамСервер.ПересчитатьРаспределениеОплатЗаказа(ЗаказКлиента);

	Состояние = СобратьСостояниеЦепочки(ЗаказКлиента);
	ЗаписатьКэш(ЗаказКлиента, Состояние);
	УдалитьИзОчереди(ЗаказКлиента);

КонецПроцедуры

// Возвращает строку версии алгоритма сбора. Смена значения делает старый кэш промахом.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияАлгоритма() Экспорт

	Возврат "9";

КонецФункции

// Формирует табличный документ монитора цепочки заказа для формы подробной информации.
//
// Параметры:
//  Состояние - Структура - результат СостояниеЦепочкиЗаказа
//  ЗаказКлиента - ДокументСсылка.ЗаказКлиента
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция СформироватьТабличныйДокументМонитора(Состояние, ЗаказКлиента) Экспорт

	Возврат ПостроитьТабличныйДокументМонитора(Состояние, ЗаказКлиента);

КонецФункции

// Строит плоскую таблицу строк монитора (depth-first) для вывода по MXL-форматам.
//
// Параметры:
//  Состояние - Структура - результат СостояниеЦепочкиЗаказа
//  ЗаказКлиента - ДокументСсылка.ЗаказКлиента
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ПодготовитьТаблицуСтрокОтчета(Состояние, ЗаказКлиента) Экспорт

	Возврат СобратьТаблицуСтрокОтчетаМонитора(Состояние, ЗаказКлиента);

КонецФункции

// Агрегирует KPI по строкам заказа для итоговой строки заказа в отчётах.
//
// Параметры:
//  СтрокиЗаказа - ТаблицаЗначений
//
// Возвращаемое значение:
//  Структура
//
Функция ИтогиСтрокЗаказа(СтрокиЗаказа) Экспорт

	Возврат АгрегатФактовСтрокЗаказа(СтрокиЗаказа);

КонецФункции

// Обработчик подписки АУ_ЦепочкаЗаказаПометитьКПересчёту.
//
// Параметры:
//  Источник - ДокументОбъект
//  Отказ - Булево
//
Процедура ПриЗаписиДокументаЦепочки(Источник, Отказ) Экспорт

	Если Отказ Тогда

		Возврат;

	КонецЕсли;

	Если Источник.ОбменДанными.Загрузка Тогда

		Возврат;

	КонецЕсли;

	ПометитьКПересчету(Источник.Ссылка);

	Если ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		И Источник.Проведен Тогда

		ПроставитьРеализациюВРасходныхОрдерах(Источник.Ссылка);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Заполняет АУ_Реализация в расходном ордере, если реализация однозначно определяется товарами и заказом.
//
// Параметры:
//  ОрдерОбъект - ДокументОбъект.РасходныйОрдерНаТовары
//
Процедура ЗаполнитьРеализациюВРасходномОрдере(ОрдерОбъект) Экспорт

	Если ЗначениеЗаполнено(ОрдерОбъект.АУ_Реализация) Тогда

		Возврат;

	КонецЕсли;

	ЗаказыКлиента = Новый Массив;

	Для Каждого СтрокаРаспоряжения Из ОрдерОбъект.ТоварыПоРаспоряжениям Цикл

		Если ТипЗнч(СтрокаРаспоряжения.Распоряжение) = Тип("ДокументСсылка.ЗаказКлиента")
			И ЗаказыКлиента.Найти(СтрокаРаспоряжения.Распоряжение) = Неопределено Тогда

			ЗаказыКлиента.Добавить(СтрокаРаспоряжения.Распоряжение);

		КонецЕсли;

	КонецЦикла;

	Если ЗаказыКлиента.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Реализация = ОднозначнаяРеализацияОрдера(ОрдерОбъект, ЗаказыКлиента);

	Если ЗначениеЗаполнено(Реализация) Тогда

		ОрдерОбъект.АУ_Реализация = Реализация;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КэшИОчередь

Функция ПрочитатьКэшЕслиСвежий(ЗаказКлиента)

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кэш.Данные КАК Данные,
	|	Кэш.ДатаРасчёта КАК ДатаРасчета,
	|	Кэш.ВерсияАлгоритма КАК ВерсияАлгоритма,
	|	ВЫБОР
	|		КОГДА Очередь.ЗаказКлиента ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ВОчереди
	|ИЗ
	|	РегистрСведений.АУ_КэшЦепочкиЗаказаКлиента КАК Кэш
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АУ_ЗаданияКПересчётуЦепочкиЗаказа КАК Очередь
	|		ПО Кэш.ЗаказКлиента = Очередь.ЗаказКлиента
	|ГДЕ
	|	Кэш.ЗаказКлиента = &ЗаказКлиента";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если Выборка.ВОчереди Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если Выборка.ВерсияАлгоритма <> ВерсияАлгоритма() Тогда

		Возврат Неопределено;

	КонецЕсли;

	Состояние = Выборка.Данные.Получить();

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда

		Возврат Неопределено;

	КонецЕсли;

	Состояние.Вставить("ДатаРасчета", Выборка.ДатаРасчета);

	Возврат Состояние;

КонецФункции

Процедура ЗаписатьКэш(ЗаказКлиента, Состояние)

	УстановитьПривилегированныйРежим(Истина);

	НаборЗаписей = РегистрыСведений.АУ_КэшЦепочкиЗаказаКлиента.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказКлиента.Установить(ЗаказКлиента);

	Запись = НаборЗаписей.Добавить();
	Запись.ЗаказКлиента = ЗаказКлиента;
	Запись.Данные = Новый ХранилищеЗначения(Состояние);
	Запись.ДатаРасчёта = ТекущаяДатаСеанса();
	Запись.ВерсияАлгоритма = ВерсияАлгоритма();

	НаборЗаписей.Записать();

	Состояние.ДатаРасчета = Запись.ДатаРасчёта;

КонецПроцедуры

Процедура ЗаписатьВОчередь(ЗаказКлиента, ДокументИнициатор)

	УстановитьПривилегированныйРежим(Истина);

	НаборЗаписей = РегистрыСведений.АУ_ЗаданияКПересчётуЦепочкиЗаказа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказКлиента.Установить(ЗаказКлиента);

	Запись = НаборЗаписей.Добавить();
	Запись.ЗаказКлиента = ЗаказКлиента;
	Запись.ДокументИнициатор = ДокументИнициатор;
	Запись.ДатаПометки = ТекущаяДатаСеанса();

	НаборЗаписей.Записать();

КонецПроцедуры

Процедура УдалитьИзОчереди(ЗаказКлиента)

	УстановитьПривилегированныйРежим(Истина);

	НаборЗаписей = РегистрыСведений.АУ_ЗаданияКПересчётуЦепочкиЗаказа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказКлиента.Установить(ЗаказКлиента);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область РезолвЗаказаКлиента

Функция ЗаказыКлиентаДокумента(ДокументСсылка)

	ЗаказыКлиента = Новый Массив;
	ТипДокумента = ТипЗнч(ДокументСсылка);

	Если ТипДокумента = Тип("ДокументСсылка.ЗаказКлиента") Тогда

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказНаСборку") Тогда

		ДобавитьЗаказЕслиНет(
			ЗаказыКлиента,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДокументОснование"));

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПоставщику") Тогда

		ДополнитьЗаказамиИзЗаказаПоставщику(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда

		ДополнитьЗаказамиИзПриобретения(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда

		ДополнитьЗаказамиИзПриходногоОрдера(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СборкаТоваров") Тогда

		ЗаказНаСборку = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ЗаказНаСборку");

		Если ЗначениеЗаполнено(ЗаказНаСборку) Тогда

			ДобавитьЗаказЕслиНет(
				ЗаказыКлиента,
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказНаСборку, "ДокументОснование"));

		КонецЕсли;

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда

		ДополнитьЗаказамиИзРеализации(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда

		ДополнитьЗаказамиИзРасходногоОрдера(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда

		ДополнитьЗаказамиИзЗаявки(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств")
		Или ТипДокумента = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда

		ДополнитьЗаказамиИзРасходаДС(ЗаказыКлиента, ДокументСсылка, ТипДокумента);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда

		ДополнитьЗаказамиИзСтатейБюджета(ЗаказыКлиента, ДокументСсылка);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда

		ДополнитьЗаказамиИзОплатыПоШифрам(ЗаказыКлиента, ДокументСсылка);

	КонецЕсли;

	Возврат ЗаказыКлиента;

КонецФункции

Процедура ДобавитьЗаказЕслиНет(ЗаказыКлиента, ЗаказКлиента)

	Если ТипЗнч(ЗаказКлиента) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда

		Возврат;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда

		Возврат;

	КонецЕсли;

	Если ЗаказыКлиента.Найти(ЗаказКлиента) = Неопределено Тогда

		ЗаказыКлиента.Добавить(ЗаказКлиента);

	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзЗаказаПоставщику(ЗаказыКлиента, ЗаказПоставщику)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтрокиЗаказаПоставщику() + "
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЗаказПоставщику);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, Выборка.ЗаказКлиента);

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзПриобретения(ЗаказыКлиента, Приобретение)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтрокиЗаказаПоставщику() + "
	|ГДЕ
	|	Товары.Ссылка В
	|		(ВЫБРАТЬ
	|			ПриобретениеТовары.ЗаказПоставщику
	|		ИЗ
	|			Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТовары
	|		ГДЕ
	|			ПриобретениеТовары.Ссылка = &Ссылка
	|			И ПриобретениеТовары.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Ссылка", Приобретение);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, Выборка.ЗаказКлиента);

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзПриходногоОрдера(ЗаказыКлиента, ПриходныйОрдер)

	Распоряжение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПриходныйОрдер, "Распоряжение");

	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда

		ДополнитьЗаказамиИзПриобретения(ЗаказыКлиента, Распоряжение);

	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзРеализации(ЗаказыКлиента, Реализация)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Реализация, "ЗаказКлиента");
	ДобавитьЗаказЕслиНет(ЗаказыКлиента, Реквизиты.ЗаказКлиента);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента";
	Запрос.УстановитьПараметр("Ссылка", Реализация);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, Выборка.ЗаказКлиента);

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзРасходногоОрдера(ЗаказыКлиента, РасходныйОрдер)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Распоряжение КАК Распоряжение
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Распоряжение ССЫЛКА Документ.ЗаказКлиента
	|;
	|
	|ВЫБРАТЬ
	|	Ордер.АУ_Реализация КАК Реализация
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары КАК Ордер
	|ГДЕ
	|	Ордер.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", РасходныйОрдер);

	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, Выборка.Распоряжение);

	КонецЦикла;

	ВыборкаРеализации = Результаты[1].Выбрать();

	Если ВыборкаРеализации.Следующий() И ЗначениеЗаполнено(ВыборкаРеализации.Реализация) Тогда

		ДополнитьЗаказамиИзРеализации(ЗаказыКлиента, ВыборкаРеализации.Реализация);

	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзЗаявки(ЗаказыКлиента, Заявка)

	Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заявка, "ДокументОснование");

	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда

		ДополнитьЗаказамиИзЗаказаПоставщику(ЗаказыКлиента, Основание);

	КонецЕсли;

	ДополнитьЗаказамиИзСтатейБюджета(ЗаказыКлиента, Заявка);

КонецПроцедуры

Процедура ДополнитьЗаказамиИзРасходаДС(ЗаказыКлиента, ДокументСсылка, ТипДокумента)

	Если ТипДокумента = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда

		ИмяДокумента = "СписаниеБезналичныхДенежныхСредств";

	Иначе

		ИмяДокумента = "РасходныйКассовыйОрдер";

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументРасхода.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК ДокументРасхода
	|ГДЕ
	|	ДокументРасхода.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Расшифровка.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
	|ИЗ
	|	Документ." + ИмяДокумента + ".РасшифровкаПлатежа КАК Расшифровка
	|ГДЕ
	|	Расшифровка.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Результаты = Запрос.ВыполнитьПакет();

	Для ИндексПакета = 0 По 1 Цикл

		Выборка = Результаты[ИндексПакета].Выбрать();

		Пока Выборка.Следующий() Цикл

			Если ТипЗнч(Выборка.Заявка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств")
				И ЗначениеЗаполнено(Выборка.Заявка) Тогда

				ДополнитьЗаказамиИзЗаявки(ЗаказыКлиента, Выборка.Заявка);

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если ТипДокумента = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда

		ДополнитьЗаказамиИзСтатейБюджета(ЗаказыКлиента, ДокументСсылка);

	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзСтатейБюджета(ЗаказыКлиента, ДокументСсылка)

	ИмяДокумента = ДокументСсылка.Метаданные().Имя;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Статьи.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	Документ." + ИмяДокумента + ".АУ_СтатьиБюджета КАК Статьи
	|ГДЕ
	|	Статьи.Ссылка = &Ссылка
	|	И Статьи.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, Выборка.ЗаказКлиента);

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьЗаказамиИзОплатыПоШифрам(ЗаказыКлиента, ДокументОплаты)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Оплата.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрНакопления.АУ_ОплатаПоШифрам КАК Оплата
	|ГДЕ
	|	Оплата.ДокументОплаты = &ДокументОплаты
	|	И Оплата.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ДокументОплаты", ДокументОплаты);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьЗаказЕслиНет(ЗаказыКлиента, Выборка.ЗаказКлиента);

	КонецЦикла;

КонецПроцедуры

Функция ТекстЗапросаСтрокиЗаказаПоставщику()

	Возврат
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК ЗаказПоставщику,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.Ссылка.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА Товары.АУ_ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|			ТОГДА Товары.АУ_ЗаказКлиента
	|		КОГДА Товары.Ссылка.ДокументОснование ССЫЛКА Документ.ЗаказКлиента
	|			ТОГДА ВЫРАЗИТЬ(Товары.Ссылка.ДокументОснование КАК Документ.ЗаказКлиента)
	|		КОГДА Товары.АУ_ЗаказНаСборку <> ЗНАЧЕНИЕ(Документ.ЗаказНаСборку.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(Товары.АУ_ЗаказНаСборку КАК Документ.ЗаказНаСборку).ДокументОснование
	|		КОГДА Товары.Ссылка.ДокументОснование ССЫЛКА Документ.ЗаказНаСборку
	|			ТОГДА ВЫРАЗИТЬ(Товары.Ссылка.ДокументОснование КАК Документ.ЗаказНаСборку).ДокументОснование
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	КОНЕЦ КАК ЗаказКлиента,
	|	ВЫБОР
	|		КОГДА Товары.АУ_ЗаказНаСборку <> ЗНАЧЕНИЕ(Документ.ЗаказНаСборку.ПустаяСсылка)
	|			ТОГДА Товары.АУ_ЗаказНаСборку
	|		КОГДА Товары.Ссылка.ДокументОснование ССЫЛКА Документ.ЗаказНаСборку
	|			ТОГДА ВЫРАЗИТЬ(Товары.Ссылка.ДокументОснование КАК Документ.ЗаказНаСборку)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаСборку.ПустаяСсылка)
	|	КОНЕЦ КАК ЗаказНаСборку
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары";

КонецФункции

#КонецОбласти

#Область СборСостояния

Функция СобратьСостояниеЦепочки(ЗаказКлиента)

	Состояние = ПустоеСостояние(Неопределено);
	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказКлиента,
		"Назначение, Валюта, Проведен, ПометкаУдаления, Дата");

	ДокументыЦепочки = ДокументыЦепочкиЗаказа(ЗаказКлиента);
	РезультатДерева = ПостроитьДеревоДокументов(ЗаказКлиента, РеквизитыЗаказа, ДокументыЦепочки);
	Состояние.Дерево = РезультатДерева.Дерево;
	Состояние.ЕстьСироты = РезультатДерева.ЕстьСироты;

	ЗаполнитьФактыСтрокЗаказа(Состояние, ЗаказКлиента, РеквизитыЗаказа, ДокументыЦепочки);
	ЗаполнитьФактыСборкиИЗаказовПоставщику(Состояние, ЗаказКлиента, ДокументыЦепочки);
	ЗаполнитьФактыШтрихкодов(Состояние, ДокументыЦепочки);
	ЗаполнитьСверкуВзаиморасчетов(Состояние, ЗаказКлиента, РеквизитыЗаказа);

	Состояние.ДатаРасчета = ТекущаяДатаСеанса();
	Состояние.ИзКэша = Ложь;

	Возврат Состояние;

КонецФункции

Функция ДокументыЦепочкиЗаказа(ЗаказКлиента)

	Результат = Новый Структура;
	Результат.Вставить("Сборки", Новый ТаблицаЗначений);
	Результат.Вставить("СтрокиЗаказаПоставщику", Новый ТаблицаЗначений);
	Результат.Вставить("Приобретения", Новый ТаблицаЗначений);
	Результат.Вставить("ПриходныеОрдера", Новый ТаблицаЗначений);
	Результат.Вставить("СборкиТоваров", Новый ТаблицаЗначений);
	Результат.Вставить("Реализации", Новый ТаблицаЗначений);
	Результат.Вставить("РасходныеОрдера", Новый ТаблицаЗначений);
	Результат.Вставить("Заявки", Новый ТаблицаЗначений);
	Результат.Вставить("РасходыДС", Новый ТаблицаЗначений);
	Результат.Вставить("ПоступленияДС", Новый ТаблицаЗначений);
	Результат.Вставить("ШтрихкодыПриемки", Новый ТаблицаЗначений);
	Результат.Вставить("ШтрихкодыОтгрузки", Новый ТаблицаЗначений);
	Результат.Вставить("ШтрихкодыСборки", Новый ТаблицаЗначений);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДокументовЦепочки();
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);

	Результаты = Запрос.ВыполнитьПакет();
	ИменаТаблиц = СтрРазделить(
		"Сборки,СтрокиЗаказаПоставщику,Приобретения,ПриходныеОрдера,СборкиТоваров,Реализации,РасходныеОрдера,Заявки,РасходыДС,ПоступленияДС,ШтрихкодыПриемки,ШтрихкодыОтгрузки,ШтрихкодыСборки",
		",");

	Для ИндексТаблицы = 0 По ИменаТаблиц.ВГраница() Цикл

		Результат[ИменаТаблиц[ИндексТаблицы]] = Результаты[ИндексТаблицы].Выгрузить();

	КонецЦикла;

	ДополнитьВложенныеШтрихкоды(Результат);

	Возврат Результат;

КонецФункции

Функция ТекстЗапросаДокументовЦепочки()

	Возврат
	"ВЫБРАТЬ
	|	ЗаказНаСборку.Ссылка КАК Ссылка,
	|	ЗаказНаСборку.Проведен КАК Проведен,
	|	ЗаказНаСборку.Номенклатура КАК Номенклатура,
	|	ЗаказНаСборку.Характеристика КАК Характеристика,
	|	ЗаказНаСборку.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказНаСборку КАК ЗаказНаСборку
	|ГДЕ
