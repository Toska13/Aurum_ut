Функция КопияСостояния(Источник)

	Состояние = ПустоеСостояние(Неопределено);
	Состояние.Дерево = Источник.Дерево.Скопировать();
	Состояние.СтрокиЗаказа = Источник.СтрокиЗаказа.Скопировать();
	Состояние.ЗаказыНаСборку = Источник.ЗаказыНаСборку.Скопировать();
	Состояние.ЗаказыПоставщику = Источник.ЗаказыПоставщику.Скопировать();
	Состояние.ШтрихкодыУпаковок = Источник.ШтрихкодыУпаковок.Скопировать();
	Состояние.ДатаРасчета = Источник.ДатаРасчета;
	Состояние.ИзКэша = Источник.ИзКэша;

	Если Источник.Свойство("РасхождениеРасчетовСКлиентами") Тогда

		Состояние.РасхождениеРасчетовСКлиентами = Источник.РасхождениеРасчетовСКлиентами;

	КонецЕсли;

	Если Источник.Свойство("РасхождениеРасчетовСПоставщиками") Тогда

		Состояние.РасхождениеРасчетовСПоставщиками = Источник.РасхождениеРасчетовСПоставщиками;

	КонецЕсли;

	Если Источник.Свойство("ЕстьСироты") Тогда

		Состояние.ЕстьСироты = Источник.ЕстьСироты;

	КонецЕсли;

	Возврат Состояние;

КонецФункции

#КонецОбласти

#Область Валюта

Процедура ПрименитьВалютуИтогов(Состояние, ВалютаИтогов)

	ДатаКурса = ТекущаяДатаСеанса();

	Если ЗначениеЗаполнено(Состояние.ДатаРасчета) Тогда

		ДатаКурса = Состояние.ДатаРасчета;

	КонецЕсли;

	ПересчитатьСуммыТаблицы(
		Состояние.СтрокиЗаказа,
		"ОплаченоКлиентом,Заявлено,ОплаченоПоставщику,СуммаЗаказано",
		ВалютаИтогов,
		ДатаКурса);
	ПересчитатьСебестоимостьСтрокЗаказа(Состояние.СтрокиЗаказа, ВалютаИтогов, ДатаКурса);
	РассчитатьПрибыльСтрокЗаказа(Состояние.СтрокиЗаказа);
	ПересчитатьСуммыТаблицы(Состояние.ЗаказыНаСборку, "Заявлено,Оплачено", ВалютаИтогов, ДатаКурса);
	ПересчитатьСуммыТаблицы(Состояние.ЗаказыПоставщику, "Заявлено,Оплачено", ВалютаИтогов, ДатаКурса);

КонецПроцедуры

Процедура ПересчитатьСуммыТаблицы(ТаблицаФактов, ИменаКолонок, ВалютаИтогов, ДатаКурса)

	Колонки = СтрРазделить(ИменаКолонок, ",", Ложь);

	Для Каждого СтрокаФактов Из ТаблицаФактов Цикл

		Если Не ЗначениеЗаполнено(СтрокаФактов.Валюта) Или СтрокаФактов.Валюта = ВалютаИтогов Тогда

			СтрокаФактов.Валюта = ВалютаИтогов;
			Продолжить;

		КонецЕсли;

		КурсИсходный = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаФактов.Валюта, ДатаКурса);
		КурсЦелевой = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаИтогов, ДатаКурса);

		Если КурсИсходный.Курс = 0 Или КурсЦелевой.Курс = 0 Тогда

			СтрокаФактов.НетКурса = Истина;

			Для Каждого ИмяКолонки Из Колонки Цикл

				СтрокаФактов[ИмяКолонки] = 0;

			КонецЦикла;

			Продолжить;

		КонецЕсли;

		Для Каждого ИмяКолонки Из Колонки Цикл

			СтрокаФактов[ИмяКолонки] = РаботаСКурсамиВалют.ПересчитатьВВалюту(
				СтрокаФактов[ИмяКолонки],
				СтрокаФактов.Валюта,
				ВалютаИтогов,
				ДатаКурса);

		КонецЦикла;

		СтрокаФактов.Валюта = ВалютаИтогов;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СвязьОрдераИРеализации

Процедура ПроставитьРеализациюВРасходныхОрдерах(Реализация)

	ЗаказыКлиента = ЗаказыКлиентаДокумента(Реализация);

	Если ЗаказыКлиента.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ордер.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК Ордер
	|ГДЕ
	|	Ордер.Распоряжение В (&ЗаказыКлиента)
	|	И Ордер.Ссылка.АУ_Реализация = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	|	И НЕ Ордер.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЗаказыКлиента", ЗаказыКлиента);

	Выборка = Запрос.Выполнить().Выбрать();
	ТоварыРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Товары").Выгрузить();

	Пока Выборка.Следующий() Цикл

		ОрдерОбъект = Выборка.Ссылка.ПолучитьОбъект();

		Если Не ПересечениеТоваровОднозначно(ОрдерОбъект, ТоварыРеализации, Реализация, ЗаказыКлиента) Тогда

			Продолжить;

		КонецЕсли;

		ОрдерОбъект.АУ_Реализация = Реализация;
		ОрдерОбъект.ОбменДанными.Загрузка = Истина;
		ОрдерОбъект.Записать();

	КонецЦикла;

КонецПроцедуры

Функция ОднозначнаяРеализацияОрдера(ОрдерОбъект, ЗаказыКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реализация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.ЗаказКлиента В (&ЗаказыКлиента)
	|	И Реализация.Проведен
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.ЗаказКлиента В (&ЗаказыКлиента)
	|	И Товары.Ссылка.Проведен";
	Запрос.УстановитьПараметр("ЗаказыКлиента", ЗаказыКлиента);

	Реализации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Если Реализации.Количество() = 0 Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если Реализации.Количество() = 1 Тогда

		Возврат Реализации[0];

	КонецЕсли;

	Подходящие = Новый Массив;

	Для Каждого Реализация Из Реализации Цикл

		ТоварыРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Товары").Выгрузить();

		Если ЕстьПересечениеТоваров(ОрдерОбъект, ТоварыРеализации) Тогда

			Подходящие.Добавить(Реализация);

		КонецЕсли;

	КонецЦикла;

	Если Подходящие.Количество() = 1 Тогда

		Возврат Подходящие[0];

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПересечениеТоваровОднозначно(ОрдерОбъект, ТоварыРеализации, Реализация, ЗаказыКлиента)

	Если Не ЕстьПересечениеТоваров(ОрдерОбъект, ТоварыРеализации) Тогда

		Возврат Ложь;

	КонецЕсли;

	ДругаяРеализация = ОднозначнаяРеализацияОрдера(ОрдерОбъект, ЗаказыКлиента);

	Если Не ЗначениеЗаполнено(ДругаяРеализация) Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат ДругаяРеализация = Реализация;

КонецФункции

Функция ЕстьПересечениеТоваров(ОрдерОбъект, ТоварыРеализации)

	Для Каждого СтрокаОрдера Из ОрдерОбъект.ОтгружаемыеТовары Цикл

		Отбор = Новый Структура("Номенклатура, Характеристика", СтрокаОрдера.Номенклатура, СтрокаОрдера.Характеристика);

		Если ТоварыРеализации.НайтиСтроки(Отбор).Количество() > 0 Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаОрдера Из ОрдерОбъект.ТоварыПоРаспоряжениям Цикл

		Отбор = Новый Структура("Номенклатура, Характеристика", СтрокаОрдера.Номенклатура, СтрокаОрдера.Характеристика);

		Если ТоварыРеализации.НайтиСтроки(Отбор).Количество() > 0 Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область МониторФормы

Функция ПостроитьТабличныйДокументМонитора(Состояние, ЗаказКлиента)

	ТаблицаСтрок = ПодготовитьТаблицуСтрокОтчета(Состояние, ЗаказКлиента);

	Попытка

		Возврат СформироватьТабличныйДокументПоМакету(ТаблицаСтрок, ЗаказКлиента, Состояние);

	Исключение

		Возврат ПостроитьТабличныйДокументМонитораПрограммно(Состояние, ЗаказКлиента);

	КонецПопытки;

КонецФункции

Функция ПостроитьТабличныйДокументМонитораПрограммно(Состояние, ЗаказКлиента)

	ТабДок = Новый ТабличныйДокумент;
	НомерСтроки = 1;
	ВывестиЗаголовокМонитора(ТабДок, НомерСтроки);
	НомерСтроки = НомерСтроки + 1;
	ВывестиСтрокуМонитора(ТабДок, НомерСтроки, 0, Строка(ЗаказКлиента), ЗаказКлиента);

	УзелЗаказа = НайтиУзелЗаказаВДереве(Состояние.Дерево);

	Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

		НомерСтроки = НомерСтроки + 1;
		ПредставлениеПозиции = Строка(СтрокаФактов.Номенклатура) + " / " + Строка(СтрокаФактов.Характеристика);
		ВывестиСтрокуМонитора(ТабДок, НомерСтроки, 1, ПредставлениеПозиции, Неопределено, СтрокаФактов);

		Если УзелЗаказа <> Неопределено Тогда

			УжеДобавленные = Новый Соответствие;
			ЯкоряПозиции = ЯкоряДокументовПозицииМонитора(Состояние, СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика);
			НомерСтроки = ВывестиДокументыПозицииМонитора(
				ТабДок,
				НомерСтроки,
				УзелЗаказа.Строки,
				Новый Массив,
				ЯкоряПозиции,
				СтрокаФактов,
				Состояние,
				УжеДобавленные);

		КонецЕсли;

	КонецЦикла;

	Если Состояние.ЕстьСироты И УзелЗаказа <> Неопределено Тогда

		УзелНеСвязанные = НайтиУзелДереваПоТипуМонитора(УзелЗаказа.Строки, "НеСвязанные");

		Если УзелНеСвязанные <> Неопределено Тогда

			НомерСтроки = НомерСтроки + 1;
			ВывестиСтрокуМонитора(ТабДок, НомерСтроки, 1, "Не связанные", Неопределено);
			УжеДобавленные = Новый Соответствие;

			Для Каждого СтрокаСироты Из УзелНеСвязанные.Строки Цикл

				Если Не ЗначениеЗаполнено(СтрокаСироты.Ссылка)
					Или СтрокаСироты.Тип = "ШтрихкодыУпаковокТоваров" Тогда

					Продолжить;

				КонецЕсли;

				НомерСтроки = НомерСтроки + 1;
				ВывестиСтрокуМонитора(
					ТабДок,
					НомерСтроки,
					2,
					ПредставлениеУзлаМонитора(СтрокаСироты),
					СтрокаСироты.Ссылка);
				НомерСтроки = ВывестиШтрихкодыУзлаМонитора(ТабДок, НомерСтроки, СтрокаСироты.Строки);

			КонецЦикла;

		КонецЕсли;

	КонецЕсли;

	ТабДок.ФиксацияСверху = 1;
	Возврат ТабДок;

КонецФункции

Процедура ВывестиЗаголовокМонитора(ТабДок, НомерСтроки)

	ИменаКолонок = ИменаКолонокМонитора();
	Колонка = 1;
	Область = ТабДок.Область(НомерСтроки, Колонка);
	Область.Текст = "Представление";

	Для Каждого ИмяКолонки Из ИменаКолонок Цикл

		Колонка = Колонка + 1;
		Область = ТабДок.Область(НомерСтроки, Колонка);
		Область.Текст = ИмяКолонки;

	КонецЦикла;

	ЗафиксироватьФорматСтрокиМонитора(ТабДок, НомерСтроки);

КонецПроцедуры

Процедура ВывестиСтрокуМонитора(ТабДок, НомерСтроки, Уровень, Представление, Ссылка, СтрокаФактов = Неопределено)

	Отступ = СтроковыеФункцииКлиентСервер.ДополнитьСтроку("", Уровень * 2, " ");
	ОбластьПредставления = ТабДок.Область(НомерСтроки, 1);
	ОбластьПредставления.Текст = Отступ + Представление;
	ОбластьПредставления.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	ОбластьПредставления.ВертикальноеПоложение = ВертикальноеПоложение.Верх;

	Если ЗначениеЗаполнено(Ссылка) Тогда

		ОбластьПредставления.Расшифровка = Ссылка;

	КонецЕсли;

	Если СтрокаФактов = Неопределено Тогда

		ЗафиксироватьФорматСтрокиМонитора(ТабДок, НомерСтроки);

		Возврат;

	КонецЕсли;

	ИменаКолонок = ИменаКолонокМонитора();
	Колонка = 1;

	Для Каждого ИмяКолонки Из ИменаКолонок Цикл

		Колонка = Колонка + 1;
		Область = ТабДок.Область(НомерСтроки, Колонка);
		Область.Текст = СтрокаФактов[ИмяКолонки];

	КонецЦикла;

	ЗафиксироватьФорматСтрокиМонитора(ТабДок, НомерСтроки);

КонецПроцедуры

Функция ИменаКолонокМонитора()

	Имена = Новый Массив;
	Имена.Добавить("Шифр");
	Имена.Добавить("Заказано");
	Имена.Добавить("ВСборке");
	Имена.Добавить("Собрано");
	Имена.Добавить("ЗаказаноПоставщику");
	Имена.Добавить("Приобретено");
	Имена.Добавить("ПринятоОрдером");
	Имена.Добавить("ОстатокНаСкладе");
	Имена.Добавить("Реализовано");
	Имена.Добавить("ОтгруженоОрдером");
	Имена.Добавить("ОплаченоКлиентом");
	Имена.Добавить("Заявлено");
	Имена.Добавить("ОплаченоПоставщику");

	Возврат Имена;

КонецФункции

Функция НайтиУзелЗаказаВДереве(Дерево)

	Для Каждого СтрокаДерева Из Дерево.Строки Цикл

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			Возврат СтрокаДерева;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиУзелДереваПоТипуМонитора(СтрокиДерева, ИмяТипа)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = ИмяТипа Тогда

			Возврат СтрокаДерева;

		КонецЕсли;

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			Результат = НайтиУзелДереваПоТипуМонитора(СтрокаДерева.Строки, ИмяТипа);

			Если Результат <> Неопределено Тогда

				Возврат Результат;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЯкоряДокументовПозицииМонитора(Состояние, Номенклатура, Характеристика)

	Якоря = Новый Соответствие;

	Для Каждого СтрокаСборки Из Состояние.ЗаказыНаСборку Цикл

		Если СтрокаСборки.Номенклатура = Номенклатура
			И СтрокаСборки.Характеристика = Характеристика Тогда

			Якоря.Вставить(СтрокаСборки.ЗаказНаСборку, Истина);

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаЗП Из Состояние.ЗаказыПоставщику Цикл

		Если СтрокаЗП.Номенклатура = Номенклатура
			И СтрокаЗП.Характеристика = Характеристика Тогда

			Якоря.Вставить(СтрокаЗП.ЗаказПоставщику, Истина);

		КонецЕсли;

	КонецЦикла;

	Возврат Якоря;

КонецФункции

Функция ВывестиДокументыПозицииМонитора(
	ТабДок,
	НомерСтроки,
	СтрокиДерева,
	ПутьДокументов,
	ЯкоряПозиции,
	СтрокаФактов,
	Состояние,
	УжеДобавленные)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			НомерСтроки = ВывестиДокументыПозицииМонитора(
				ТабДок,
				НомерСтроки,
				СтрокаДерева.Строки,
				ПутьДокументов,
				ЯкоряПозиции,
				СтрокаФактов,
				Состояние,
				УжеДобавленные);
			Продолжить;

		КонецЕсли;

		Если СтрокаДерева.Тип = "НеСвязанные"
			Или СтрокаДерева.Тип = "ШтрихкодыУпаковокТоваров" Тогда

			Продолжить;

		КонецЕсли;

		НовыйПуть = Новый Массив;

		Для Каждого ЭлементПути Из ПутьДокументов Цикл

			НовыйПуть.Добавить(ЭлементПути);

		КонецЦикла;

		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			НовыйПуть.Добавить(СтрокаДерева.Ссылка);

		КонецЕсли;

		Если ДокументДереваОтноситсяКПозицииМонитора(СтрокаДерева, НовыйПуть, ЯкоряПозиции, СтрокаФактов)
			И ЗначениеЗаполнено(СтрокаДерева.Ссылка)
			И СтрокаДерева.Тип <> "ЗаказНаСборку"
			И СтрокаДерева.Тип <> "ЗаказПоставщику" Тогда

			КлючДокумента = СтрокаДерева.Тип + "|" + Строка(СтрокаДерева.Ссылка.УникальныйИдентификатор());

			Если УжеДобавленные.Получить(КлючДокумента) = Неопределено Тогда

				УжеДобавленные.Вставить(КлючДокумента, Истина);
				НомерСтроки = НомерСтроки + 1;
				ВывестиСтрокуМонитора(
					ТабДок,
					НомерСтроки,
					2,
					ПредставлениеУзлаМонитора(СтрокаДерева),
					СтрокаДерева.Ссылка);
				НомерСтроки = ВывестиШтрихкодыУзлаМонитора(ТабДок, НомерСтроки, СтрокаДерева.Строки);

			КонецЕсли;

		КонецЕсли;

		Если СтрокаДерева.Тип = "ЗаказНаСборку"
			И ЯкоряПозиции.Получить(СтрокаДерева.Ссылка) <> Неопределено Тогда

			КлючДокумента = СтрокаДерева.Тип + "|" + Строка(СтрокаДерева.Ссылка.УникальныйИдентификатор());

			Если УжеДобавленные.Получить(КлючДокумента) = Неопределено Тогда

				УжеДобавленные.Вставить(КлючДокумента, Истина);
				НомерСтроки = НомерСтроки + 1;
				ВывестиСтрокуМонитора(
					ТабДок,
					НомерСтроки,
					2,
					ПредставлениеУзлаМонитора(СтрокаДерева),
					СтрокаДерева.Ссылка);
				НомерСтроки = ВывестиДокументыПозицииМонитора(
					ТабДок,
					НомерСтроки,
					СтрокаДерева.Строки,
					НовыйПуть,
					ЯкоряПозиции,
					СтрокаФактов,
					Состояние,
					УжеДобавленные);

			КонецЕсли;

		ИначеЕсли СтрокаДерева.Тип = "ЗаказПоставщику"
			И ЯкоряПозиции.Получить(СтрокаДерева.Ссылка) <> Неопределено Тогда

			КлючДокумента = СтрокаДерева.Тип + "|" + Строка(СтрокаДерева.Ссылка.УникальныйИдентификатор());

			Если УжеДобавленные.Получить(КлючДокумента) = Неопределено Тогда

				УжеДобавленные.Вставить(КлючДокумента, Истина);
				НомерСтроки = НомерСтроки + 1;
				ВывестиСтрокуМонитора(
					ТабДок,
					НомерСтроки,
					2,
					ПредставлениеУзлаМонитора(СтрокаДерева),
					СтрокаДерева.Ссылка);
				НомерСтроки = ВывестиДокументыПозицииМонитора(
					ТабДок,
					НомерСтроки,
					СтрокаДерева.Строки,
					НовыйПуть,
					ЯкоряПозиции,
					СтрокаФактов,
					Состояние,
					УжеДобавленные);

			КонецЕсли;

		Иначе

			НомерСтроки = ВывестиДокументыПозицииМонитора(
				ТабДок,
				НомерСтроки,
				СтрокаДерева.Строки,
				НовыйПуть,
				ЯкоряПозиции,
				СтрокаФактов,
				Состояние,
				УжеДобавленные);

		КонецЕсли;

	КонецЦикла;

	Возврат НомерСтроки;

КонецФункции

Функция ВывестиШтрихкодыУзлаМонитора(ТабДок, НомерСтроки, СтрокиДерева)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип <> "ШтрихкодыУпаковокТоваров" Тогда

			Продолжить;

		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		ВывестиСтрокуМонитора(
			ТабДок,
			НомерСтроки,
			3,
			ПредставлениеУзлаМонитора(СтрокаДерева),
			СтрокаДерева.Ссылка);
		НомерСтроки = ВывестиШтрихкодыУзлаМонитора(ТабДок, НомерСтроки, СтрокаДерева.Строки);

	КонецЦикла;

	Возврат НомерСтроки;

КонецФункции

Функция ПредставлениеУзлаМонитора(СтрокаДерева)

	Если Не ПустаяСтрока(СтрокаДерева.Представление) Тогда

		Возврат СтрокаДерева.Представление;

	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

		Возврат Строка(СтрокаДерева.Ссылка);

	КонецЕсли;

	Возврат СтрокаДерева.Тип;

КонецФункции

Функция ДокументДереваОтноситсяКПозицииМонитора(СтрокаДерева, ПутьДокументов, ЯкоряПозиции, СтрокаФактов)

	Если ПутьСодержитЯкорьМонитора(ПутьДокументов, ЯкоряПозиции) Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "РеализацияТоваровУслуг"
		И СтрокаФактов.Реализовано > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "РасходныйОрдерНаТовары"
		И (СтрокаФактов.ОтгруженоОрдером > 0 Или ПутьСодержитТипМонитора("РеализацияТоваровУслуг", ПутьДокументов)) Тогда

		Возврат Истина;

	КонецЕсли;

	Если (СтрокаДерева.Тип = "ПоступлениеБезналичныхДенежныхСредств"
			Или СтрокаДерева.Тип = "ПриходныйКассовыйОрдер")
		И СтрокаФактов.ОплаченоКлиентом > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если СтрокаДерева.Тип = "ЗаявкаНаРасходованиеДенежныхСредств"
		И СтрокаФактов.Заявлено > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Если (СтрокаДерева.Тип = "СписаниеБезналичныхДенежныхСредств"
			Или СтрокаДерева.Тип = "РасходныйКассовыйОрдер")
		И СтрокаФактов.ОплаченоПоставщику > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПутьСодержитЯкорьМонитора(ПутьДокументов, ЯкоряПозиции)

	Для Каждого ДокументПути Из ПутьДокументов Цикл

		Если ЯкоряПозиции.Получить(ДокументПути) <> Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПутьСодержитТипМонитора(ИмяТипа, ПутьДокументов)

	Для Каждого ДокументПути Из ПутьДокументов Цикл

		Если ДокументПути <> Неопределено И ДокументПути.Метаданные().Имя = ИмяТипа Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СобратьТаблицуСтрокОтчетаМонитора(Состояние, ЗаказКлиента)

	ТаблицаСтрок = НоваяТаблицаСтрокОтчета();
	Контекст = Новый Структура;
	Контекст.Вставить("Состояние", Состояние);
	Контекст.Вставить("ЗаказКлиента", ЗаказКлиента);
	Контекст.Вставить("ТаблицаЗаявлено", ТаблицаЗаявленоПоЗаявкамЦепочки(Состояние.Дерево));
	Контекст.Вставить("ТаблицаОплат", ТаблицаОплатПоШифрамЗаказа(ЗаказКлиента));
	Контекст.Вставить("РеквизитыДокументов", РеквизитыКонтрагентДоговорПоДереву(Состояние.Дерево));
	Контекст.Вставить("ИндексШтрихкодов", ИндексФактовШтрихкодов(Состояние));
	Контекст.Вставить("Счетчик", 0);

	ИтогиЗаказа = АгрегатФактовСтрокЗаказа(Состояние.СтрокиЗаказа);
	СтрокаЗаказа = ДобавитьСтрокуОтчетаМонитора(
		ТаблицаСтрок,
		Контекст,
		"",
		1,
		"Ур1_Заказ",
		Строка(ЗаказКлиента),
		ЗаказКлиента,
		Истина);
	ЗаполнитьКPIСтрокиОтчетаИзСтруктуры(СтрокаЗаказа, ИтогиЗаказа);
	СтрокаЗаказа.Представление = Строка(ЗаказКлиента);

	УзелЗаказа = НайтиУзелЗаказаВДереве(Состояние.Дерево);

	Для Каждого СтрокаФактов Из Состояние.СтрокиЗаказа Цикл

		ИмяФорматаПозиции = ИмяФорматаПозицииМонитора(СтрокаФактов.ПутьОбеспечения);
		ПредставлениеПозиции = Строка(СтрокаФактов.Номенклатура) + " / " + Строка(СтрокаФактов.Характеристика);
		СтрокаПозиции = ДобавитьСтрокуОтчетаМонитора(
			ТаблицаСтрок,
			Контекст,
			СтрокаЗаказа.Идентификатор,
			2,
			ИмяФорматаПозиции,
			ПредставлениеПозиции,
			Неопределено,
			Истина);
		ЗаполнитьКPIСтрокиОтчетаИзФактов(СтрокаПозиции, СтрокаФактов);
		СтрокаПозиции.Номенклатура = СтрокаФактов.Номенклатура;
		СтрокаПозиции.Характеристика = СтрокаФактов.Характеристика;
		СтрокаПозиции.Шифр = СтрокаФактов.Шифр;
		СтрокаПозиции.ПутьОбеспечения = СтрокаФактов.ПутьОбеспечения;

		Если УзелЗаказа = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		КонтекстПозиции = СкопироватьКонтекстМонитора(Контекст);
		КонтекстПозиции.Вставить("СтрокаФактов", СтрокаФактов);
		КонтекстПозиции.Вставить(
			"ЯкоряПозиции",
			ЯкоряДокументовПозицииМонитора(Состояние, СтрокаФактов.Номенклатура, СтрокаФактов.Характеристика));
		КонтекстПозиции.Вставить("УжеДобавленные", Новый Соответствие);

		ДобавитьУзлыДереваВТаблицуОтчета(
			ТаблицаСтрок,
			КонтекстПозиции,
			УзелЗаказа.Строки,
			СтрокаПозиции.Идентификатор,
			2,
			Новый Массив,
			"ЗаказКлиента");
		Контекст.Счетчик = КонтекстПозиции.Счетчик;

	КонецЦикла;

	Если Состояние.ЕстьСироты И УзелЗаказа <> Неопределено Тогда

		УзелНеСвязанные = НайтиУзелДереваПоТипуМонитора(УзелЗаказа.Строки, "НеСвязанные");

		Если УзелНеСвязанные <> Неопределено Тогда

			СтрокаСирот = ДобавитьСтрокуОтчетаМонитора(
				ТаблицаСтрок,
				Контекст,
				СтрокаЗаказа.Идентификатор,
				2,
				"Ур2_НеСвязанные",
				"Не связанные",
				Неопределено,
				Ложь);

			Для Каждого СтрокаДерева Из УзелНеСвязанные.Строки Цикл

				Если Не ЗначениеЗаполнено(СтрокаДерева.Ссылка)
					Или СтрокаДерева.Тип = "ШтрихкодыУпаковокТоваров" Тогда

					Продолжить;

				КонецЕсли;

				ДобавитьСтрокуОтчетаМонитора(
					ТаблицаСтрок,
					Контекст,
					СтрокаСирот.Идентификатор,
					3,
					"Ур2_НеСвязанные",
					ПредставлениеУзлаМонитора(СтрокаДерева),
					СтрокаДерева.Ссылка,
					Ложь);

			КонецЦикла;

		КонецЕсли;

	КонецЕсли;

	ПроставитьИндексыСредиСiblings(ТаблицаСтрок);

	Возврат ТаблицаСтрок;

КонецФункции

Функция СкопироватьКонтекстМонитора(Контекст)

	Копия = Новый Структура;
	Копия.Вставить("Состояние", Контекст.Состояние);
	Копия.Вставить("ЗаказКлиента", Контекст.ЗаказКлиента);
	Копия.Вставить("ТаблицаЗаявлено", Контекст.ТаблицаЗаявлено);
	Копия.Вставить("ТаблицаОплат", Контекст.ТаблицаОплат);
	Копия.Вставить("РеквизитыДокументов", Контекст.РеквизитыДокументов);
	Копия.Вставить("ИндексШтрихкодов", Контекст.ИндексШтрихкодов);
	Копия.Вставить("Счетчик", Контекст.Счетчик);

	Возврат Копия;

КонецФункции

Процедура ДобавитьУзлыДереваВТаблицуОтчета(
	ТаблицаСтрок,
	Контекст,
	СтрокиДерева,
	ИдентификаторРодителя,
	УровеньРодителя,
	ПутьДокументов,
	ТипРодителя)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.Тип = "ЗаказКлиента" Тогда

			ДобавитьУзлыДереваВТаблицуОтчета(
				ТаблицаСтрок,
				Контекст,
				СтрокаДерева.Строки,
				ИдентификаторРодителя,
				УровеньРодителя,
				ПутьДокументов,
				"ЗаказКлиента");
			Продолжить;

		КонецЕсли;

		Если СтрокаДерева.Тип = "НеСвязанные" Тогда

			Продолжить;

		КонецЕсли;

		НовыйПуть = Новый Массив;

		Для Каждого ЭлементПути Из ПутьДокументов Цикл

			НовыйПуть.Добавить(ЭлементПути);

		КонецЦикла;

		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			НовыйПуть.Добавить(СтрокаДерева.Ссылка);

		КонецЕсли;

		ИмяФормата = ИмяФорматаУзлаМонитора(СтрокаДерева.Тип, Контекст.СтрокаФактов.ПутьОбеспечения, ТипРодителя);
		ОтноситсяКПозиции = ДокументДереваОтноситсяКПозицииМонитора(
			СтрокаДерева,
			НовыйПуть,
			Контекст.ЯкоряПозиции,
			Контекст.СтрокаФактов);

		Если СтрокаДерева.Тип = "ЗаказНаСборку" Или СтрокаДерева.Тип = "ЗаказПоставщику" Тогда

			ОтноситсяКПозиции = (Контекст.ЯкоряПозиции.Получить(СтрокаДерева.Ссылка) <> Неопределено);

		КонецЕсли;

		ИдентификаторТекущий = ИдентификаторРодителя;
		УровеньТекущий = УровеньРодителя;
		ТипДляДетей = ТипРодителя;

		Если ОтноситсяКПозиции И Не ПустаяСтрока(ИмяФормата) И ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			КлючДокумента = СтрокаДерева.Тип + "|" + Строка(СтрокаДерева.Ссылка.УникальныйИдентификатор());

			Если Контекст.УжеДобавленные.Получить(КлючДокумента) = Неопределено Тогда

				Контекст.УжеДобавленные.Вставить(КлючДокумента, Истина);
				СтрокаОтчета = ДобавитьСтрокуОтчетаМонитора(
					ТаблицаСтрок,
					Контекст,
					ИдентификаторРодителя,
					УровеньРодителя + 1,
					ИмяФормата,
					ПредставлениеУзлаМонитора(СтрокаДерева),
					СтрокаДерева.Ссылка,
					Ложь);
				ЗаполнитьПоказателиУзлаОтчета(СтрокаОтчета, СтрокаДерева, Контекст);
				ЗаполнитьКонтрагентаСтрокиОтчета(СтрокаОтчета, Контекст);

				Если ИмяФормата = "Ур3Т_РТУ" И Контекст.СтрокаФактов.ПутьОбеспечения = "СоСклада" Тогда

					ДобавитьСтрокуСебестоимостиОтчета(ТаблицаСтрок, Контекст, СтрокаОтчета);

				КонецЕсли;

				ИдентификаторТекущий = СтрокаОтчета.Идентификатор;
				УровеньТекущий = СтрокаОтчета.УровеньВложенности;
				ТипДляДетей = СтрокаДерева.Тип;

			КонецЕсли;

		КонецЕсли;

		ДобавитьУзлыДереваВТаблицуОтчета(
			ТаблицаСтрок,
			Контекст,
			СтрокаДерева.Строки,
			ИдентификаторТекущий,
			УровеньТекущий,
			НовыйПуть,
			ТипДляДетей);

	КонецЦикла;

КонецПроцедуры

Функция ДобавитьСтрокуОтчетаМонитора(
	ТаблицаСтрок,
	Контекст,
	Родитель,
	УровеньВложенности,
	ИмяФормата,
	Представление,
	Ссылка,
	УчитыватьВИтогах)

	Контекст.Счетчик = Контекст.Счетчик + 1;
	СтрокаОтчета = ТаблицаСтрок.Добавить();
	СтрокаОтчета.Идентификатор = Формат(Контекст.Счетчик, "ЧГ=0");
	СтрокаОтчета.Родитель = Родитель;
	СтрокаОтчета.УровеньВложенности = УровеньВложенности;
	СтрокаОтчета.ИмяФормата = ИмяФормата;
	СтрокаОтчета.Представление = Представление;
	СтрокаОтчета.Ссылка = Ссылка;
	СтрокаОтчета.ЭтоШапка = Ложь;
	СтрокаОтчета.УчитыватьВИтогах = УчитыватьВИтогах;

	Возврат СтрокаОтчета;

КонецФункции

Процедура ДобавитьСтрокуСебестоимостиОтчета(ТаблицаСтрок, Контекст, СтрокаРТУ)

	СтрокаСебестоимости = ДобавитьСтрокуОтчетаМонитора(
		ТаблицаСтрок,
		Контекст,
		СтрокаРТУ.Идентификатор,
		СтрокаРТУ.УровеньВложенности + 1,
		"Ур4С_Себестоимость",
		"Себестоимость отгрузки",
		Неопределено,
		Ложь);
	СтрокаСебестоимости.СуммаСебестоимости = Контекст.СтрокаФактов.СуммаСебестоимости;

	Если СтрокаСебестоимости.СуммаСебестоимости = 0 Тогда

		СтрокаСебестоимости.Представление = "Себестоимость отгрузки (не рассчитана)";

	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПоказателиУзлаОтчета(СтрокаОтчета, СтрокаДерева, Контекст)

	СтрокаФактов = Контекст.СтрокаФактов;

	Если СтрокаДерева.Тип = "ЗаказНаСборку" Тогда

		СтрокаОтчета.ВСборке = СтрокаФактов.ВСборке;

	ИначеЕсли СтрокаДерева.Тип = "ЗаказПоставщику" Тогда

		ФактЗП = ФактЗаказаПоставщикуПозиции(Контекст.Состояние, СтрокаДерева.Ссылка, СтрокаФактов);

		Если ФактЗП = Неопределено Тогда

			СтрокаОтчета.ЗаказаноПоставщику = СтрокаФактов.ЗаказаноПоставщику;

		Иначе

			СтрокаОтчета.ЗаказаноПоставщику = ФактЗП.Заказано;

		КонецЕсли;

	ИначеЕсли СтрокаДерева.Тип = "ПриобретениеТоваровУслуг" Тогда

		ФактЗП = ФактЗаказаПоставщикуПозиции(Контекст.Состояние, СтрокаДерева.РодительСсылка, СтрокаФактов);

		Если ФактЗП = Неопределено Тогда

			СтрокаОтчета.Приобретено = СтрокаФактов.Приобретено;

		Иначе

			СтрокаОтчета.Приобретено = ФактЗП.Приобретено;

		КонецЕсли;

	ИначеЕсли СтрокаДерева.Тип = "ПриходныйОрдерНаТовары" Тогда

		СтрокаОтчета.ПринятоОрдером = СтрокаФактов.ПринятоОрдером;

	ИначеЕсли СтрокаДерева.Тип = "СборкаТоваров" Тогда

		СтрокаОтчета.Собрано = СтрокаФактов.Собрано;

	ИначеЕсли СтрокаДерева.Тип = "РеализацияТоваровУслуг" Тогда

		СтрокаОтчета.Реализовано = СтрокаФактов.Реализовано;

	ИначеЕсли СтрокаДерева.Тип = "РасходныйОрдерНаТовары" Тогда

		СтрокаОтчета.ОтгруженоОрдером = СтрокаФактов.ОтгруженоОрдером;

	ИначеЕсли СтрокаДерева.Тип = "ПоступлениеБезналичныхДенежныхСредств"
		Или СтрокаДерева.Тип = "ПриходныйКассовыйОрдер" Тогда

		СтрокаОтчета.ОплаченоКлиентом = ОплаченоПоДокументуИШифру(
			Контекст.ТаблицаОплат,
			СтрокаДерева.Ссылка,
			СтрокаФактов.Шифр,
			Истина);

	ИначеЕсли СтрокаДерева.Тип = "ЗаявкаНаРасходованиеДенежныхСредств" Тогда

		СтрокаОтчета.Заявлено = ЗаявленоПоЗаявкеИШифру(
			Контекст.ТаблицаЗаявлено,
			СтрокаДерева.Ссылка,
			СтрокаФактов.Шифр);

	ИначеЕсли СтрокаДерева.Тип = "СписаниеБезналичныхДенежныхСредств"
		Или СтрокаДерева.Тип = "РасходныйКассовыйОрдер" Тогда

		СтрокаОтчета.ОплаченоПоставщику = ОплаченоПоДокументуИШифру(
			Контекст.ТаблицаОплат,
			СтрокаДерева.Ссылка,
			СтрокаФактов.Шифр,
			Ложь);

	ИначеЕсли СтрокаДерева.Тип = "ШтрихкодыУпаковокТоваров" Тогда

		ФактШК = Контекст.ИндексШтрихкодов.Получить(СтрокаДерева.Ссылка);

		Если ФактШК <> Неопределено Тогда

			СтрокаОтчета.ПринятоШК = ФактШК.Принято;
			СтрокаОтчета.ОтгруженоШК = ФактШК.Отгружено;
			СтрокаОтчета.ОстатокШК = ФактШК.Остаток;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьКонтрагентаСтрокиОтчета(СтрокаОтчета, Контекст)

	Если Не ЗначениеЗаполнено(СтрокаОтчета.Ссылка) Тогда

		Возврат;

	КонецЕсли;

	Реквизиты = Контекст.РеквизитыДокументов.Получить(СтрокаОтчета.Ссылка);

	Если Реквизиты = Неопределено Тогда

		Возврат;

	КонецЕсли;

	СтрокаОтчета.Контрагент = Реквизиты.Контрагент;
	СтрокаОтчета.Договор = Реквизиты.Договор;

КонецПроцедуры

Функция ФактЗаказаПоставщикуПозиции(Состояние, ЗаказПоставщику, СтрокаФактов)

	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("ЗаказПоставщику", ЗаказПоставщику);
	Отбор.Вставить("Номенклатура", СтрокаФактов.Номенклатура);
	Отбор.Вставить("Характеристика", СтрокаФактов.Характеристика);
	НайденныеСтроки = Состояние.ЗаказыПоставщику.НайтиСтроки(Отбор);

	Если НайденныеСтроки.Количество() = 0 Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат НайденныеСтроки[0];

КонецФункции

Функция ИмяФорматаПозицииМонитора(ПутьОбеспечения)

	Если ПутьОбеспечения = "Сборка" Тогда

		Возврат "Ур2_Позиция_Сборка";

	ИначеЕсли ПутьОбеспечения = "СоСклада" Тогда

		Возврат "Ур2_Позиция_СоСклада";

	КонецЕсли;

	Возврат "Ур2_Позиция_Закупка";

КонецФункции

Функция ИмяФорматаУзлаМонитора(ТипУзла, ПутьОбеспечения, ТипРодителя)

	Если ТипУзла = "ЗаказНаСборку" Тогда

		Возврат "Ур3Т_ЗнС";

	ИначеЕсли ТипУзла = "ЗаказПоставщику" Тогда

		Если ТипРодителя = "ЗаказНаСборку" Тогда

			Возврат "Ур4Т_ЗПКомпл";

		КонецЕсли;

		Возврат "Ур3Т_ЗП";

	ИначеЕсли ТипУзла = "ПриобретениеТоваровУслуг" Тогда

		Если ПутьОбеспечения = "Сборка" Тогда

			Возврат "Ур5Т_ПТУ";

		КонецЕсли;

		Возврат "Ур4Т_ПТУ";

	ИначеЕсли ТипУзла = "ПриходныйОрдерНаТовары" Тогда

		Возврат "Ур6Т_ПО";

	ИначеЕсли ТипУзла = "ШтрихкодыУпаковокТоваров" Тогда

		Если ТипРодителя = "ПриходныйОрдерНаТовары" Или ТипРодителя = "ПриобретениеТоваровУслуг" Тогда

			Возврат "Ур7ШК_Приемка";

		ИначеЕсли ТипРодителя = "РасходныйОрдерНаТовары" Тогда

			Возврат "Ур10ШК_Отгрузка";

		КонецЕсли;

		Возврат "";

	ИначеЕсли ТипУзла = "СборкаТоваров" Тогда

		Возврат "Ур7Т_Сборка";

	ИначеЕсли ТипУзла = "РеализацияТоваровУслуг" Тогда

		Если ПутьОбеспечения = "СоСклада" Тогда

			Возврат "Ур3Т_РТУ";

		КонецЕсли;

		Возврат "Ур8Т_РТУ";

	ИначеЕсли ТипУзла = "РасходныйОрдерНаТовары" Тогда

		Возврат "Ур9Т_РО";

	ИначеЕсли ТипУзла = "ПоступлениеБезналичныхДенежныхСредств"
		Или ТипУзла = "ПриходныйКассовыйОрдер" Тогда

		Возврат "Ур3О_ОплатаКлиента";

	ИначеЕсли ТипУзла = "ЗаявкаНаРасходованиеДенежныхСредств" Тогда

		Возврат "Ур4П_Заявка";

	ИначеЕсли ТипУзла = "СписаниеБезналичныхДенежныхСредств"
		Или ТипУзла = "РасходныйКассовыйОрдер" Тогда

		Возврат "Ур5П_Списание";

	КонецЕсли;

	Возврат "";

КонецФункции

Функция АгрегатФактовСтрокЗаказа(СтрокиЗаказа)

	Итоги = Новый Структура;
	Итоги.Вставить("СуммаЗаказано", 0);
	Итоги.Вставить("ОплаченоКлиентом", 0);
	Итоги.Вставить("Заявлено", 0);
	Итоги.Вставить("ОплаченоПоставщику", 0);
	Итоги.Вставить("СуммаСебестоимости", 0);
	Итоги.Вставить("Прибыль", 0);
	Итоги.Вставить("Заказано", 0);
	Итоги.Вставить("Реализовано", 0);
	Итоги.Вставить("ОтгруженоОрдером", 0);
	Итоги.Вставить("ЗаказаноПоставщику", 0);
	Итоги.Вставить("Приобретено", 0);
	Итоги.Вставить("ПринятоОрдером", 0);
	Итоги.Вставить("ВСборке", 0);
	Итоги.Вставить("Собрано", 0);

	Для Каждого СтрокаФактов Из СтрокиЗаказа Цикл

		Итоги.СуммаЗаказано = Итоги.СуммаЗаказано + СтрокаФактов.СуммаЗаказано;
		Итоги.ОплаченоКлиентом = Итоги.ОплаченоКлиентом + СтрокаФактов.ОплаченоКлиентом;
		Итоги.Заявлено = Итоги.Заявлено + СтрокаФактов.Заявлено;
		Итоги.ОплаченоПоставщику = Итоги.ОплаченоПоставщику + СтрокаФактов.ОплаченоПоставщику;
		Итоги.СуммаСебестоимости = Итоги.СуммаСебестоимости + СтрокаФактов.СуммаСебестоимости;
		Итоги.Прибыль = Итоги.Прибыль + СтрокаФактов.Прибыль;
		Итоги.Заказано = Итоги.Заказано + СтрокаФактов.Заказано;
		Итоги.Реализовано = Итоги.Реализовано + СтрокаФактов.Реализовано;
		Итоги.ОтгруженоОрдером = Итоги.ОтгруженоОрдером + СтрокаФактов.ОтгруженоОрдером;
		Итоги.ЗаказаноПоставщику = Итоги.ЗаказаноПоставщику + СтрокаФактов.ЗаказаноПоставщику;
		Итоги.Приобретено = Итоги.Приобретено + СтрокаФактов.Приобретено;
		Итоги.ПринятоОрдером = Итоги.ПринятоОрдером + СтрокаФактов.ПринятоОрдером;
		Итоги.ВСборке = Итоги.ВСборке + СтрокаФактов.ВСборке;
		Итоги.Собрано = Итоги.Собрано + СтрокаФактов.Собрано;

	КонецЦикла;

	Итоги.Вставить("ОсталосьЗаказать", Макс(Итоги.Заказано - Итоги.ЗаказаноПоставщику, 0));
	Итоги.Вставить("ОсталосьСобрать", Макс(Итоги.ВСборке - Итоги.Собрано, 0));

	Возврат Итоги;

КонецФункции

Процедура ЗаполнитьКPIСтрокиОтчетаИзСтруктуры(СтрокаОтчета, Итоги)

	ЗаполнитьЗначенияСвойств(СтрокаОтчета, Итоги);

КонецПроцедуры

Процедура ЗаполнитьКPIСтрокиОтчетаИзФактов(СтрокаОтчета, СтрокаФактов)

	ЗаполнитьЗначенияСвойств(СтрокаОтчета, СтрокаФактов);
	СтрокаОтчета.ОсталосьЗаказать = Макс(СтрокаФактов.Заказано - СтрокаФактов.ЗаказаноПоставщику, 0);
	СтрокаОтчета.ОсталосьСобрать = Макс(СтрокаФактов.ВСборке - СтрокаФактов.Собрано, 0);

КонецПроцедуры

Процедура ПроставитьИндексыСредиСiblings(ТаблицаСтрок)

	ПоРодителю = Новый Соответствие;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		КлючРодителя = СтрокаОтчета.Родитель;
		МассивСтрок = ПоРодителю.Получить(КлючРодителя);

		Если МассивСтрок = Неопределено Тогда

			МассивСтрок = Новый Массив;
			ПоРодителю.Вставить(КлючРодителя, МассивСтрок);

		КонецЕсли;

		МассивСтрок.Добавить(СтрокаОтчета);

	КонецЦикла;

	Для Каждого КлючИЗначение Из ПоРодителю Цикл

		Количество = КлючИЗначение.Значение.Количество();
		Индекс = 0;

		Для Каждого СтрокаОтчета Из КлючИЗначение.Значение Цикл

			СтрокаОтчета.КоличествоСiblings = Количество;
			СтрокаОтчета.ИндексСредиСiblings = Индекс;
			Индекс = Индекс + 1;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Функция ИндексФактовШтрихкодов(Состояние)

	ИндексШтрихкодов = Новый Соответствие;

	Для Каждого СтрокаФактов Из Состояние.ШтрихкодыУпаковок Цикл

		ИндексШтрихкодов.Вставить(СтрокаФактов.ШтрихкодУпаковки, СтрокаФактов);

	КонецЦикла;

	Возврат ИндексШтрихкодов;

КонецФункции

Функция РеквизитыКонтрагентДоговорПоДереву(Дерево)

	Результат = Новый Соответствие;
	СсылкиПоТипам = Новый Соответствие;
	СобратьСсылкиДереваДляРеквизитов(Дерево.Строки, СсылкиПоТипам);

	ЗаполнитьРеквизитыДокументовТипа(Результат, СсылкиПоТипам.Получить("ЗаказПоставщику"), "Документ.ЗаказПоставщику");
	ЗаполнитьРеквизитыДокументовТипа(
		Результат,
		СсылкиПоТипам.Получить("ПриобретениеТоваровУслуг"),
		"Документ.ПриобретениеТоваровУслуг");
	ЗаполнитьРеквизитыДокументовТипа(
		Результат,
		СсылкиПоТипам.Получить("ЗаявкаНаРасходованиеДенежныхСредств"),
		"Документ.ЗаявкаНаРасходованиеДенежныхСредств");
	ЗаполнитьРеквизитыДокументовТипа(
		Результат,
		СсылкиПоТипам.Получить("СписаниеБезналичныхДенежныхСредств"),
		"Документ.СписаниеБезналичныхДенежныхСредств");
	ЗаполнитьРеквизитыДокументовТипа(
		Результат,
		СсылкиПоТипам.Получить("РасходныйКассовыйОрдер"),
		"Документ.РасходныйКассовыйОрдер");

	Возврат Результат;

КонецФункции

Процедура СобратьСсылкиДереваДляРеквизитов(СтрокиДерева, СсылкиПоТипам)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда

			МассивСсылок = СсылкиПоТипам.Получить(СтрокаДерева.Тип);

			Если МассивСсылок = Неопределено Тогда

				МассивСсылок = Новый Массив;
				СсылкиПоТипам.Вставить(СтрокаДерева.Тип, МассивСсылок);

			КонецЕсли;

			Если МассивСсылок.Найти(СтрокаДерева.Ссылка) = Неопределено Тогда

				МассивСсылок.Добавить(СтрокаДерева.Ссылка);

			КонецЕсли;

		КонецЕсли;

		СобратьСсылкиДереваДляРеквизитов(СтрокаДерева.Строки, СсылкиПоТипам);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыДокументовТипа(Результат, Ссылки, ИмяТаблицы)

	Если Ссылки = Неопределено Или Ссылки.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументЦепочки.Ссылка КАК Ссылка,
	|	ДокументЦепочки.Контрагент КАК Контрагент,
	|	ДокументЦепочки.Договор КАК Договор
	|ИЗ
	|	" + ИмяТаблицы + " КАК ДокументЦепочки
	|ГДЕ
	|	ДокументЦепочки.Ссылка В (&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		Реквизиты = Новый Структура("Контрагент, Договор", Выборка.Контрагент, Выборка.Договор);
		Результат.Вставить(Выборка.Ссылка, Реквизиты);

	КонецЦикла;

КонецПроцедуры

Функция СформироватьТабличныйДокументПоМакету(ТаблицаСтрок, ЗаказКлиента, Состояние)

	ТабДок = Новый ТабличныйДокумент;
	МакетМонитора = МакетМонитораЦепочки();
	МакетКоннекторов = ПолучитьОбщийМакет("СтруктураПодчиненности");
	ИндексСтрок = ИндексСтрокОтчетаПоИдентификатору(ТаблицаСтрок);

	ВывестиШапкуОтчетаМонитора(ТабДок, МакетМонитора, ЗаказКлиента, Состояние);

	ВыведенныеШапкиФорматов = Новый Соответствие;
	ОткрытоГрупп = 0;
	КоличествоСтрок = ТаблицаСтрок.Количество();

	Для Индекс = 0 По КоличествоСтрок - 1 Цикл

		СтрокаОтчета = ТаблицаСтрок[Индекс];
		ОткрытоГрупп = ЗакрытьГруппыСтрокМонитораПередСтрокой(
			ТабДок,
			СтрокаОтчета.УровеньВложенности,
			ОткрытоГрупп);

		КлючШапки = СтрокаОтчета.Родитель + "|" + СтрокаОтчета.ИмяФормата;

		Если ВыведенныеШапкиФорматов.Получить(КлючШапки) = Неопределено Тогда

			ВывестиСтрокуМонитораСКоннекторами(
				ТабДок,
				МакетМонитора,
				МакетКоннекторов,
				СтрокаОтчета,
				ИндексСтрок,
				Истина);
			ВыведенныеШапкиФорматов.Вставить(КлючШапки, Истина);

		КонецЕсли;

		ВывестиСтрокуМонитораСКоннекторами(
			ТабДок,
			МакетМонитора,
			МакетКоннекторов,
			СтрокаОтчета,
			ИндексСтрок,
			Ложь);

		ОткрытоГрупп = ОткрытьГруппуСтрокМонитораПослеСтроки(
			ТабДок,
			ТаблицаСтрок,
			Индекс,
			СтрокаОтчета.УровеньВложенности,
			ОткрытоГрупп);

	КонецЦикла;

	Пока ОткрытоГрупп > 0 Цикл

		ТабДок.ЗакончитьГруппуСтрок();
		ОткрытоГрупп = ОткрытоГрупп - 1;

	КонецЦикла;

	Если ТабДок.КоличествоУровнейГруппировокСтрок() > 1 Тогда

		ТабДок.ПоказатьУровеньГруппировокСтрок(1);

	КонецЕсли;

	ТабДок.ФиксацияСверху = 1;
	ТабДок.ОтображатьГруппировки = Истина;
	ТабДок.ОтображатьСетку = Ложь;

	Возврат ТабДок;

КонецФункции

Функция МакетМонитораЦепочки()

	Если Метаданные.Отчеты.АУ_КонтрольЗаказовКлиентов.Макеты.Найти("МакетМонитора") = Неопределено Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат Отчеты.АУ_КонтрольЗаказовКлиентов.ПолучитьМакет("МакетМонитора");

КонецФункции

Процедура ВывестиШапкуОтчетаМонитора(ТабДок, МакетМонитора, ЗаказКлиента, Состояние)

	Если МакетМонитора <> Неопределено Тогда

		ОбластьШапки = ОбластьМакетаМонитора(МакетМонитора, "Отчет_Шапка");

		Если ОбластьШапки <> Неопределено Тогда

			ОбластьШапки.Параметры.ЗаголовокЗаказа = Строка(ЗаказКлиента);
			ОбластьШапки.Параметры.ДатаРасчета = Состояние.ДатаРасчета;
			ТабДок.Вывести(ОбластьШапки);
			ЗафиксироватьФорматСтрокиМонитора(ТабДок);
			Возврат;

		КонецЕсли;

	КонецЕсли;

	Область = ТабДок.Область(1, 1);
	Область.Текст = Строка(ЗаказКлиента) + " / " + Формат(Состояние.ДатаРасчета, "ДФ=dd.MM.yyyy HH:mm");

КонецПроцедуры

Процедура ВывестиСтрокуМонитораСКоннекторами(ТабДок, МакетМонитора, МакетКоннекторов, СтрокаОтчета, ИндексСтрок, ЭтоШапка)

	КоличествоКолонокКоннекторов = Макс(СтрокаОтчета.УровеньВложенности - 1, 0);
	ВывестиКоннекторы(ТабДок, МакетКоннекторов, СтрокаОтчета, ИндексСтрок);
	ПрисоединитьБлокФормата(ТабДок, МакетМонитора, СтрокаОтчета, ЭтоШапка, КоличествоКолонокКоннекторов > 0);
	ЗафиксироватьФорматСтрокиМонитора(ТабДок);

КонецПроцедуры

Функция ЗакрытьГруппыСтрокМонитораПередСтрокой(ТабДок, Уровень, ОткрытоГрупп)

	ЦелевоеЧислоГрупп = Макс(Уровень - 1, 0);

	Пока ОткрытоГрупп > ЦелевоеЧислоГрупп Цикл

		ТабДок.ЗакончитьГруппуСтрок();
		ОткрытоГрупп = ОткрытоГрупп - 1;

	КонецЦикла;

	Возврат ОткрытоГрупп;

КонецФункции

Функция ОткрытьГруппуСтрокМонитораПослеСтроки(ТабДок, ТаблицаСтрок, Индекс, Уровень, ОткрытоГрупп)

	Если Индекс >= ТаблицаСтрок.Количество() - 1 Тогда

		Возврат ОткрытоГрупп;

	КонецЕсли;

	СледующаяСтрока = ТаблицаСтрок[Индекс + 1];

	Пока СледующаяСтрока.УровеньВложенности > Уровень Цикл

		Уровень = Уровень + 1;
		Раскрыта = Уровень <= 2;
		ТабДок.НачатьГруппуСтрок(, Раскрыта);
		ОткрытоГрупп = ОткрытоГрупп + 1;

	КонецЦикла;

	Возврат ОткрытоГрупп;

КонецФункции

// Коннекторы дерева — картинки из СтруктураПодчиненности (как СвязанныеДокументы).
//
Процедура ВывестиКоннекторы(ТабДок, МакетКоннекторов, СтрокаОтчета, ИндексСтрок)

	УровниРекурсии = СтрокаОтчета.УровеньВложенности - 1;

	Если УровниРекурсии < 1 Тогда

		Возврат;

	КонецЕсли;

	Для Уровень = 1 По УровниРекурсии Цикл

		Если УровниРекурсии > Уровень Тогда

			Если ВыводитьВертикальныйКоннекторОтчета(СтрокаОтчета, УровниРекурсии - Уровень + 1, ИндексСтрок) Тогда

				Область = МакетКоннекторов.ПолучитьОбласть("КоннекторВерхНиз");

			Иначе

				Область = МакетКоннекторов.ПолучитьОбласть("Отступ");

			КонецЕсли;

		ИначеЕсли СтрокаОтчета.КоличествоСiblings > 1
			И СтрокаОтчета.ИндексСредиСiblings <> (СтрокаОтчета.КоличествоСiblings - 1) Тогда

			Область = МакетКоннекторов.ПолучитьОбласть("КоннекторВерхПравоНиз");

		Иначе

			Область = МакетКоннекторов.ПолучитьОбласть("КоннекторВерхПраво");

		КонецЕсли;

		Если Уровень = 1 Тогда

			ТабДок.Вывести(Область);

		Иначе

			ТабДок.Присоединить(Область);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ВыводитьВертикальныйКоннекторОтчета(СтрокаОтчета, УровеньВверх, ИндексСтрок)

	ТекущаяСтрока = СтрокаОтчета;
	ИскомаяСтрока = Неопределено;

	Для Индекс = 1 По УровеньВверх Цикл

		Если ПустаяСтрока(ТекущаяСтрока.Родитель) Тогда

			Возврат Ложь;

		КонецЕсли;

		ТекущаяСтрока = ИндексСтрок.Получить(ТекущаяСтрока.Родитель);

		Если ТекущаяСтрока = Неопределено Тогда

			Возврат Ложь;

		КонецЕсли;

		Если Индекс = УровеньВверх - 1 Тогда

			ИскомаяСтрока = ТекущаяСтрока;

		КонецЕсли;

	КонецЦикла;

	Если ИскомаяСтрока = Неопределено Тогда

		ИскомаяСтрока = СтрокаОтчета;

	КонецЕсли;

	Возврат ИскомаяСтрока.ИндексСредиСiblings < (ИскомаяСтрока.КоличествоСiblings - 1);

КонецФункции

Процедура ПрисоединитьБлокФормата(ТабДок, МакетМонитора, СтрокаОтчета, ЭтоШапка, СтрокаНачатаКоннекторами)

	ИмяОбласти = ИмяОбластиФормата(СтрокаОтчета.ИмяФормата, ЭтоШапка);
	Область = ОбластьМакетаМонитора(МакетМонитора, ИмяОбласти);

	Если Область <> Неопределено Тогда

		Если Не ЭтоШапка Тогда

			ЗаполнитьПараметрыОбластиМонитора(Область, СтрокаОтчета);

		КонецЕсли;

		Если СтрокаНачатаКоннекторами Тогда

			ТабДок.Присоединить(Область);

		Иначе

			ТабДок.Вывести(Область);

		КонецЕсли;

		Возврат;

	КонецЕсли;

	ВывестиБлокФорматаПрограммно(ТабДок, СтрокаОтчета, ЭтоШапка, СтрокаНачатаКоннекторами);

КонецПроцедуры

// Заполняет параметры области MXL-макета с учётом псевдонимов колонок.
//
// Параметры:
//  Область - ОбластьЯчеекТабличногоДокумента
//  СтрокаОтчета - СтрокаТаблицыЗначений
//
Процедура ЗаполнитьПараметрыОбластиМонитора(Область, СтрокаОтчета)

	Параметры = Область.Параметры;
	Параметры.Заполнить(СтрокаОтчета);

	УстановитьПараметрМакетаМонитора(Параметры, "СуммаПришло", СтрокаОтчета.ОплаченоКлиентом);
	УстановитьПараметрМакетаМонитора(Параметры, "ОтгруженоСкладом", СтрокаОтчета.ОтгруженоОрдером);
	УстановитьПараметрМакетаМонитора(Параметры, "ПринятоСкладом", СтрокаОтчета.ПринятоОрдером);

	Если СтрокаОтчета.ИмяФормата = "Ур7ШК_Приемка" Тогда

		УстановитьПараметрМакетаМонитора(Параметры, "Принято", СтрокаОтчета.ПринятоШК);
		УстановитьПараметрМакетаМонитора(Параметры, "Остаток", СтрокаОтчета.ОстатокШК);

	ИначеЕсли СтрокаОтчета.ИмяФормата = "Ур10ШК_Отгрузка" Тогда

		УстановитьПараметрМакетаМонитора(Параметры, "Отгружено", СтрокаОтчета.ОтгруженоШК);
		УстановитьПараметрМакетаМонитора(Параметры, "Остаток", СтрокаОтчета.ОстатокШК);

	Иначе

		УстановитьПараметрМакетаМонитора(Параметры, "Отгружено", СтрокаОтчета.Реализовано);

	КонецЕсли;

КонецПроцедуры

// Устанавливает параметр области макета, если он объявлен в макете.
//
// Параметры:
//  Параметры - ЗаполнениеМакета
//  ИмяПараметра - Строка
//  Значение - Произвольный
//
Процедура УстановитьПараметрМакетаМонитора(Параметры, ИмяПараметра, Значение)

	Попытка

		Параметры[ИмяПараметра] = Значение;

	Исключение

	КонецПопытки;

КонецПроцедуры

Функция ИмяОбластиФормата(ИмяФормата, ЭтоШапка)

	СоответствиеИмен = Новый Соответствие;
	СоответствиеИмен.Вставить("Ур1_Заказ", "Ур1");
	СоответствиеИмен.Вставить("Ур2_Позиция_Закупка", "Ур2З");
	СоответствиеИмен.Вставить("Ур2_Позиция_Сборка", "Ур2С");
	СоответствиеИмен.Вставить("Ур2_Позиция_СоСклада", "Ур2Ск");
	СоответствиеИмен.Вставить("Ур3Т_ЗнС", "Ур3Т_ЗнС");
	СоответствиеИмен.Вставить("Ур3Т_ЗП", "Ур3Т_ЗП");
	СоответствиеИмен.Вставить("Ур3Т_РТУ", "Ур3Т_РТУ");
	СоответствиеИмен.Вставить("Ур3О_ОплатаКлиента", "Ур3О");
	СоответствиеИмен.Вставить("Ур3П_Заголовок", "Ур3П");
	СоответствиеИмен.Вставить("Ур4П_Заявка", "Ур4П");
	СоответствиеИмен.Вставить("Ур5П_Списание", "Ур5П");
	СоответствиеИмен.Вставить("Ур4С_Себестоимость", "Ур4С");
	СоответствиеИмен.Вставить("Ур4Т_ПТУ", "Ур4Т_ПТУ");
	СоответствиеИмен.Вставить("Ур4Т_ЗПКомпл", "Ур4Т_ЗП");
	СоответствиеИмен.Вставить("Ур5Т_ПТУ", "Ур5Т_ПТУ");
	СоответствиеИмен.Вставить("Ур6Т_ПО", "Ур6Т_ПО");
	СоответствиеИмен.Вставить("Ур7ШК_Приемка", "Ур7ШК");
	СоответствиеИмен.Вставить("Ур7Т_Сборка", "Ур7Т_Сборка");
	СоответствиеИмен.Вставить("Ур8Т_РТУ", "Ур8Т_РТУ");
	СоответствиеИмен.Вставить("Ур9Т_РО", "Ур9Т_РО");
	СоответствиеИмен.Вставить("Ур10ШК_Отгрузка", "Ур10ШК");
	СоответствиеИмен.Вставить("Ур2_НеСвязанные", "Ур2С");

	Префикс = СоответствиеИмен.Получить(ИмяФормата);

	Если Префикс = Неопределено Тогда

		Префикс = ИмяФормата;

	КонецЕсли;

	Если ЭтоШапка Тогда

		Возврат Префикс + "_Шапка";

	КонецЕсли;

	Возврат Префикс + "_Строка";

КонецФункции

Функция ОбластьМакетаМонитора(МакетМонитора, ИмяОбласти)

	Если МакетМонитора = Неопределено Или ПустаяСтрока(ИмяОбласти) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Попытка

		Возврат МакетМонитора.ПолучитьОбласть(ИмяОбласти);

	Исключение

		Возврат Неопределено;

	КонецПопытки;

КонецФункции

Процедура ВывестиБлокФорматаПрограммно(ТабДок, СтрокаОтчета, ЭтоШапка, СтрокаНачатаКоннекторами)

	Если СтрокаНачатаКоннекторами Тогда

		НомерСтроки = ТабДок.ВысотаТаблицы;
		КолонкаНачала = ТабДок.ШиринаТаблицы + 1;

	Иначе

		НомерСтроки = ТабДок.ВысотаТаблицы + 1;
		КолонкаНачала = 1;

	КонецЕсли;

	ИменаКолонок = ИменаКолонокФорматаМонитора(СтрокаОтчета.ИмяФормата);
	Колонка = КолонкаНачала;
	ОбластьПредставления = ТабДок.Область(НомерСтроки, Колонка);

	Если ЭтоШапка Тогда

		ОбластьПредставления.Текст = "Представление";

	Иначе

		ОбластьПредставления.Текст = СтрокаОтчета.Представление;
		ОбластьПредставления.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ОбластьПредставления.ВертикальноеПоложение = ВертикальноеПоложение.Верх;

		Если ЗначениеЗаполнено(СтрокаОтчета.Ссылка) Тогда

			ОбластьПредставления.Расшифровка = СтрокаОтчета.Ссылка;

		КонецЕсли;

	КонецЕсли;

	Для Каждого ИмяКолонки Из ИменаКолонок Цикл

		Колонка = Колонка + 1;
		Область = ТабДок.Область(НомерСтроки, Колонка);

		Если ЭтоШапка Тогда

			Область.Текст = ИмяКолонки;

		Иначе

			Область.Текст = СтрокаОтчета[ИмяКолонки];

		КонецЕсли;

	КонецЦикла;

	ЗафиксироватьФорматСтрокиМонитора(ТабДок, НомерСтроки);

КонецПроцедуры

// Фиксирует ширину колонок и авто-высоту строки табличного документа монитора.
//
// Параметры:
//  ТабДок - ТабличныйДокумент
//  НомерСтроки - Число - 0 = последняя выведенная строка
//
Процедура ЗафиксироватьФорматСтрокиМонитора(ТабДок, НомерСтроки = 0)

	Если НомерСтроки = 0 Тогда

		НомерСтроки = ТабДок.ВысотаТаблицы;

	КонецЕсли;

	Если НомерСтроки < 1 Тогда

		Возврат;

	КонецЕсли;

	ТабДок.Область(НомерСтроки, , НомерСтроки).СоздатьФорматСтрок();
	ОбластьСтроки = ТабДок.Область(НомерСтроки, , НомерСтроки);
	ОбластьСтроки.ВысотаСтроки = 0;
	ОбластьСтроки.АвтоВысотаСтроки = Истина;

КонецПроцедуры

Функция ИменаКолонокФорматаМонитора(ИмяФормата)

	Имена = Новый Массив;

	Если ИмяФормата = "Ур1_Заказ" Тогда

		Имена.Добавить("СуммаЗаказано");
		Имена.Добавить("ОплаченоКлиентом");
		Имена.Добавить("Заявлено");
		Имена.Добавить("ОплаченоПоставщику");
		Имена.Добавить("СуммаСебестоимости");
		Имена.Добавить("Прибыль");
		Имена.Добавить("Заказано");
		Имена.Добавить("Реализовано");
		Имена.Добавить("ОтгруженоОрдером");
		Имена.Добавить("ЗаказаноПоставщику");
		Имена.Добавить("Приобретено");
		Имена.Добавить("ПринятоОрдером");
		Имена.Добавить("ОсталосьЗаказать");
		Имена.Добавить("ВСборке");
		Имена.Добавить("Собрано");
		Имена.Добавить("ОсталосьСобрать");

	ИначеЕсли ИмяФормата = "Ур2_Позиция_Закупка" Или ИмяФормата = "Ур2_Позиция_Сборка" Тогда

		Имена.Добавить("СуммаЗаказано");
		Имена.Добавить("ОплаченоКлиентом");
		Имена.Добавить("Заявлено");
		Имена.Добавить("ОплаченоПоставщику");
		Имена.Добавить("Прибыль");
		Имена.Добавить("Заказано");
		Имена.Добавить("Реализовано");
		Имена.Добавить("ЗаказаноПоставщику");
		Имена.Добавить("Приобретено");
		Имена.Добавить("ВСборке");
		Имена.Добавить("Собрано");

	ИначеЕсли ИмяФормата = "Ур2_Позиция_СоСклада" Тогда

		Имена.Добавить("СуммаЗаказано");
		Имена.Добавить("ОплаченоКлиентом");
		Имена.Добавить("СуммаСебестоимости");
		Имена.Добавить("Прибыль");
		Имена.Добавить("Заказано");
		Имена.Добавить("Реализовано");
		Имена.Добавить("ОтгруженоОрдером");

	ИначеЕсли ИмяФормата = "Ур3О_ОплатаКлиента" Тогда

		Имена.Добавить("ОплаченоКлиентом");

	ИначеЕсли ИмяФормата = "Ур4С_Себестоимость" Тогда

		Имена.Добавить("СуммаСебестоимости");

	ИначеЕсли ИмяФормата = "Ур4П_Заявка" Тогда

		Имена.Добавить("Контрагент");
		Имена.Добавить("Договор");
		Имена.Добавить("Заявлено");

	ИначеЕсли ИмяФормата = "Ур5П_Списание" Тогда

		Имена.Добавить("Контрагент");
		Имена.Добавить("Договор");
		Имена.Добавить("ОплаченоПоставщику");

	ИначеЕсли ИмяФормата = "Ур3Т_ЗнС" Тогда

		Имена.Добавить("ВСборке");

	ИначеЕсли ИмяФормата = "Ур3Т_ЗП" Или ИмяФормата = "Ур4Т_ЗПКомпл" Тогда

		Имена.Добавить("Контрагент");
		Имена.Добавить("Договор");
		Имена.Добавить("ЗаказаноПоставщику");

	ИначеЕсли ИмяФормата = "Ур3Т_РТУ" Или ИмяФормата = "Ур8Т_РТУ" Тогда

		Имена.Добавить("Реализовано");

	ИначеЕсли ИмяФормата = "Ур4Т_ПТУ" Или ИмяФормата = "Ур5Т_ПТУ" Тогда

		Имена.Добавить("Контрагент");
		Имена.Добавить("Договор");
		Имена.Добавить("Приобретено");

	ИначеЕсли ИмяФормата = "Ур6Т_ПО" Тогда

		Имена.Добавить("ПринятоОрдером");

	ИначеЕсли ИмяФормата = "Ур7ШК_Приемка" Тогда

		Имена.Добавить("ПринятоШК");
		Имена.Добавить("ОстатокШК");

	ИначеЕсли ИмяФормата = "Ур7Т_Сборка" Тогда

		Имена.Добавить("Собрано");

	ИначеЕсли ИмяФормата = "Ур9Т_РО" Тогда

		Имена.Добавить("ОтгруженоОрдером");

	ИначеЕсли ИмяФормата = "Ур10ШК_Отгрузка" Тогда

		Имена.Добавить("ОтгруженоШК");
		Имена.Добавить("ОстатокШК");

	КонецЕсли;

	Возврат Имена;

КонецФункции

Функция ИндексСтрокОтчетаПоИдентификатору(ТаблицаСтрок)

	ИндексСтрок = Новый Соответствие;

	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл

		ИндексСтрок.Вставить(СтрокаОтчета.Идентификатор, СтрокаОтчета);

	КонецЦикла;

	Возврат ИндексСтрок;

КонецФункции

