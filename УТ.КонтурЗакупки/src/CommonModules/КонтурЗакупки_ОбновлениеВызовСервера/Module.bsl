// Api получить актуальную версию расширения.
// 
// Параметры:
//  НазваниеМодуля - Строка - Название модуля
// 
// Возвращаемое значение:
//  См. КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса
Функция api_ПолучитьАктуальнуюВерсиюПродукта(НазваниеМодуля) Экспорт

	ПараметрыHTTPЗапроса = КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса();
	ПараметрыHTTPЗапроса.АдресСервера = ПолучитьАдресСервераОбновлений();

	СтрокаПодключения = "/1c/v1/" + НазваниеМодуля + "/check";

	СтруктураТела = Новый Структура;
	СтруктураТела.Вставить("productName", НазваниеМодуля);

	ТелоЗапроса = КонтурЗакупки_СлужебныеВызовСервера.ПреобразоватьВJSON(СтруктураТела);
	ПараметрыHTTPЗапроса.ТелоЗапроса = ТелоЗапроса;

	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("Content-Type", "application/json-patch+json");
	ПараметрыHTTPЗапроса.ЗаголовокHTTP = ЗаголовокHTTP;

	ПараметрыHTTPЗапроса.Метод = "POST";
	ПараметрыHTTPЗапроса.СтрокаПодключения = СтрокаПодключения;
	ПараметрыHTTPЗапроса.ОтправитьФайл = Ложь;
	ПараметрыHTTPЗапроса.ПолучитьФайл = Ложь;
	ПараметрыHTTPЗапроса.ЗащищенноеСоединение = Истина;
	ПараметрыHTTPЗапроса.ПортСервера = 443;

	Возврат ПараметрыHTTPЗапроса;
КонецФункции

// Api скачать обновление.
// 
// Параметры:
//  НазваниеПродукта - Строка - Название модуля
//  ТипМодуля - Строка - Тип модуля
//  НомерВерсии - Строка - Номер версии
// 
// Возвращаемое значение:
//  См. КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса
Функция api_СкачатьОбновление(НазваниеПродукта, ТипМодуля, НомерВерсии = "") Экспорт

	ПараметрыHTTPЗапроса = КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса();
	ПараметрыHTTPЗапроса.АдресСервера = ПолучитьАдресСервераОбновлений();

	Если НомерВерсии = "" Тогда
		СтрокаПодключения = "/1c/v1/" + НазваниеПродукта + "/" + ТипМодуля;
	Иначе
		СтрокаПодключения = "/1c/v1/" + НазваниеПродукта + "/" + ТипМодуля + "?id=" + НазваниеПродукта + "&version="
			+ НомерВерсии;
	КонецЕсли;

	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("Content-Type", "application/json-patch+json");
	ПараметрыHTTPЗапроса.ЗаголовокHTTP = ЗаголовокHTTP;

	ПараметрыHTTPЗапроса.Метод = "GET";
	ПараметрыHTTPЗапроса.СтрокаПодключения = СтрокаПодключения;
	ПараметрыHTTPЗапроса.ОтправитьФайл = Ложь;
	ПараметрыHTTPЗапроса.ПолучитьФайл = Истина;
	ПараметрыHTTPЗапроса.ТелоЗапроса = Неопределено;
	ПараметрыHTTPЗапроса.ЗащищенноеСоединение = Истина;
	ПараметрыHTTPЗапроса.ПортСервера = 443;

	Возврат ПараметрыHTTPЗапроса;
КонецФункции

// Получить текущую версию расширения.
// 
// Параметры:
//  КлючРасширения - Строка -  Ключ расширения
// 
// Возвращаемое значение:
//  Структура -  Получить текущую версию расширения:
// * Версия - Строка - 
// * Синоним - Строка - 
// * ХешСумма - Строка - 
// * ЗащитаОтОпасныхДействий - Булево - 
// * БезопасныйРежим - Булево - 
Функция ПолучитьТекущуюВерсиюРасширения(КлючРасширения) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Версия", "0.0.0.0");
	Результат.Вставить("Синоним", КлючРасширения);
	Результат.Вставить("ХешСумма", "");
	Результат.Вставить("ЗащитаОтОпасныхДействий", Истина);
	Результат.Вставить("БезопасныйРежим", Истина);

	УстановитьПривилегированныйРежим(Истина);
	Если КонтурЗакупки_СлужебныеВызовСервера.ЕстьПодсистема(КлючРасширения) Тогда

		Расширение = Метаданные.Подсистемы[КлючРасширения].РасширениеКонфигурации();
		Если Не Расширение = Неопределено Тогда
			Результат.Версия = Расширение.Версия;
			Результат.Синоним = Расширение.Синоним;
			Результат.ХешСумма = СтрЗаменить(Строка(Расширение.ХешСумма), " ", "");
			Результат.ЗащитаОтОпасныхДействий = Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
			Если ТипЗнч(Расширение.БезопасныйРежим) = Тип("Булево") Тогда
				Результат.БезопасныйРежим = Расширение.БезопасныйРежим;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Это новая версия.
// 
// Параметры:
//  СтараяВерсия - Строка -  Старая версия
//  НоваяВерсия - Строка -  Новая версия
// 
// Возвращаемое значение:
//  Булево -  Это новая версия
Функция ЭтоНоваяВерсия(СтараяВерсия, НоваяВерсия) Экспорт

	Результат = Ложь;

	Если НоваяВерсия = Неопределено Тогда
		Результат = Истина;
	Иначе
		СтараяВерсияСтрока = СтрЗаменить(СтараяВерсия, ".", Символы.ПС);
		НоваяВерсияСтрока = СтрЗаменить(НоваяВерсия, ".", Символы.ПС);
			//в версии у нас 4 строки 
		ВсегоСтрок = Мин(СтрЧислоСтрок(СтараяВерсияСтрока), СтрЧислоСтрок(НоваяВерсияСтрока));
		Для Индекс = 1 По ВсегоСтрок Цикл
			Попытка
				ЧислоНоваяВерсия = Число(СтрПолучитьСтроку(НоваяВерсияСтрока, Индекс));
			Исключение
				ЧислоНоваяВерсия = 0;
			КонецПопытки;

			Попытка
				ЧислоСтараяВерсия = Число(СтрПолучитьСтроку(СтараяВерсияСтрока, Индекс));
			Исключение
				ЧислоСтараяВерсия = 0;
			КонецПопытки;

			Если ЧислоНоваяВерсия > ЧислоСтараяВерсия Тогда
				Результат = Истина;
				Прервать;
			ИначеЕсли ЧислоНоваяВерсия < ЧислоСтараяВерсия Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подсистемы .
// 
// Возвращаемое значение:
//  Массив из Структура - Подсистемы 
Функция ПолучитьМассивПодсистем() Экспорт

	Результат = Новый Массив;

	Построитель = Новый ПостроительЗапроса;
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ПолучитьОбщийМакет("КонтурЗакупки_Подсистемы").Область());
	Построитель.ИсточникДанных = ИсточникДанных;
	Построитель.Выполнить();
	ТаблицаПодсистем = Построитель.Результат.Выгрузить();

	Для Каждого СтрокаПодсистема Из ТаблицаПодсистем Цикл

		ОписаниеПодсистемы = СтруктураОписанияПодсистемы();
		ЗаполнитьЗначенияСвойств(ОписаниеПодсистемы, СтрокаПодсистема);
		Если НРег(СтрокаПодсистема.ТипСодержимого) = "расширение" Тогда
//		Если СтрокаПодсистема.ТипМодуля = "cfe" Тогда
			ОписаниеПодсистемы.ТекущаяВерсия = ПолучитьТекущуюВерсиюРасширения(ОписаниеПодсистемы.Ключ);
//		ИначеЕсли СтрокаПодсистема.ТипМодуля = "epf" Тогда
		ИначеЕсли НРег(СтрокаПодсистема.ТипСодержимого) = "обработка" Тогда
			//@skip-check query-in-loop
			ОписаниеПодсистемы.ТекущаяВерсия = ПолучитьТекущуюВерсиюОбработки(ОписаниеПодсистемы.Ключ);
		КонецЕсли;
		Результат.Добавить(ОписаниеПодсистемы);
	КонецЦикла;

	Возврат Результат;

КонецФункции


// Записать хеш сумму расширения.
// 
// Параметры:
//  КлючРасширения - Строка -  Ключ расширения
Процедура ЗаписатьХешСуммуРасширения(КлючРасширения) Экспорт

	ТекущаяВерсия = ПолучитьТекущуюВерсиюРасширения(КлючРасширения);
	ИмяНастройки = СтрШаблон("ХешСумма_%1_%2", КлючРасширения, ТекущаяВерсия.Версия);

//	ТекущийХеш = КонтурЗакупки_ОбщийМодуль.ПолучитьДанныеИзХранилища(ИмяНастройки);
	ТекущийХеш = КонтурЗакупки_ПодсистемаНастройкиВызовСервера.ПолучитьЗначениеНастройки("КонтурПодсистема",
		ИмяНастройки, "");

	Если Не ЗначениеЗаполнено(ТекущийХеш) Тогда

		ТекущаяХешСумма = ТекущаяВерсия.ХешСумма;
//		КонтурЗакупки_ОбщийМодуль.ЗаписатьДанныеВХранилище(ИмяНастройки, ТекущаяХешСумма);
		КонтурЗакупки_ПодсистемаНастройкиВызовСервера.УстановитьЗначениеНастройки("КонтурПодсистема", ИмяНастройки,
			ТекущаяХешСумма);

	КонецЕсли;

КонецПроцедуры

// Получить текущую версию обработки.
// 
// Параметры:
//  КлючОбработки - Строка - Ключ обработки
// 
// Возвращаемое значение:
//  Структура - Получить текущую версию обработки:
// * Версия - Строка - 
// * Синоним - Строка - 
// * СсылкаНаОбработку - СправочникСсылка, Неопределено - 
Функция ПолучитьТекущуюВерсиюОбработки(КлючОбработки) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Версия", "0.0.0.0");
	Результат.Вставить("Синоним", КлючОбработки);
	Результат.Вставить("СсылкаНаОбработку", Неопределено);

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеОтчетыИОбработкиКоманды.Идентификатор КАК Идентификатор,
	|	ДополнительныеОтчетыИОбработкиКоманды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
	|ГДЕ
	|	ДополнительныеОтчетыИОбработкиКоманды.Идентификатор = &Идентификатор
	|	И ДополнительныеОтчетыИОбработкиКоманды.Ссылка.ПометкаУдаления = Ложь";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Идентификатор", КлючОбработки);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		Результат.Вставить("Версия", РезультатЗапроса.Ссылка.Версия);
		Результат.Вставить("Синоним", РезультатЗапроса.Ссылка.Наименование);
		Результат.Вставить("СсылкаНаОбработку", РезультатЗапроса.Ссылка);
	КонецЕсли;

	Возврат Результат;

КонецФункции



// Двоичные данные расширения.
// 
// Параметры:
//  КлючРасширения - Строка - Ключ расширения
// 
// Возвращаемое значение:
//  Неопределено, ДвоичныеДанные -  Двоичные данные расширения
Функция ДвоичныеДанныеРасширения(КлючРасширения) Экспорт

	Результат = Неопределено;

	УстановитьПривилегированныйРежим(Истина);

	ОтборПоРасширениям = Новый Структура("Имя", КлючРасширения);
	МассивРасширений = РасширенияКонфигурации.Получить(ОтборПоРасширениям);
	Для Каждого СтрокаМ Из МассивРасширений Цикл
		Если СокрЛП(СтрокаМ.Имя) = СокрЛП(КлючРасширения) Тогда
			Результат = СтрокаМ.ПолучитьДанные();
		КонецЕсли;
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции



// Двоичные данные обработки.
// 
// Параметры:
//  КлючОбработки - Строка - Ключ обработки
// 
// Возвращаемое значение:
//  Неопределено -  Двоичные данные обработки
Функция ДвоичныеДанныеОбработки(КлючОбработки) Экспорт

	Результат = Неопределено;

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Команды.Идентификатор КАК Идентификатор,
	|	Команды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК Команды
	|ГДЕ
	|	Команды.Идентификатор = &Идентификатор
	|	И Команды.Ссылка.ПометкаУдаления = ЛОЖЬ";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Идентификатор", КлючОбработки);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		Результат = РезультатЗапроса.Ссылка.ХранилищеОбработки.Получить();
	КонецЕсли;

	Возврат Результат;

КонецФункции


// Проверить обновление.
// 
// Параметры:
//  КлючРасширения - Строка - Ключ расширения где
// КлючРасширения = КонтурЗакупки_ДанныеПродуктаКлиентСервер.ПолучитьКлючРасширения().
//  АктуальнаяВерсия - Строка - Актуальная версия
// 
// Возвращаемое значение:
//  Структура - Проверить обновление:
// * ЕстьОбновление - Булево - 
// * Результат - Строка - 
Функция ПроверитьОбновление(КлючРасширения, АктуальнаяВерсия) Экспорт

	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ЕстьОбновление", Ложь);
	РезультатФункции.Вставить("Результат", "");

	ЕстьОбновление = Ложь;

	ТекущаяВерсия = ПолучитьТекущуюВерсиюРасширения(КлючРасширения);

	Если АктуальнаяВерсия = "0.0.0.0" Тогда
		РезультатФункции.Вставить("Результат", НСтр("ru = 'Нет данных для обновления.'"));
	ИначеЕсли ЭтоНоваяВерсия(ТекущаяВерсия.Версия, АктуальнаяВерсия) Тогда
		ЕстьОбновление = Истина;

		РезультатСтрока = СтрШаблон(
			НСтр("ru = 'Есть обновление для расширения %1, версия: %2'"), СокрЛП(КлючРасширения), СокрЛП(
			АктуальнаяВерсия));

		РезультатФункции.Вставить("Результат", РезультатСтрока);
	Иначе
		РезультатСтрока = СтрШаблон(
			НСтр("ru = 'Обновления для расширения %1 не требуется.'"), СокрЛП(КлючРасширения));

		РезультатФункции.Вставить("Результат", РезультатСтрока);
	КонецЕсли;

	РезультатФункции.Вставить("ЕстьОбновление", ЕстьОбновление);

	Возврат РезультатФункции;

КонецФункции





// Обновить расширение.
// 
// Параметры:
//  КлючРасширения - Строка - Ключ расширения
//  ДвоичныеДанные - ДвоичныеДанные - Двоичные данные
// 
// Возвращаемое значение:
//  Структура -  Обновить расширение:
// * Успех - Булево - 
// * Описание - Строка - 
Функция ОбновитьРасширение(КлючРасширения, ДвоичныеДанные) Экспорт

	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Успех", Истина);
	РезультатФункции.Вставить("Описание", "");

	Попытка

		РасширениеНайдено = Ложь;
		МассивР = РасширенияКонфигурации.Получить();
		Для Каждого СтрокаМ Из МассивР Цикл
			Если СокрЛП(СтрокаМ.Имя) = СокрЛП(КлючРасширения) Тогда
				РасширениеНайдено = Истина;
				СтрокаМ.БезопасныйРежим = Ложь;
				СтрокаМ.Записать(ДвоичныеДанные);
				РезультатФункции.Вставить("Описание", НСтр(
						"ru = 'Модуль успешно обновлен. Для принятия изменений необходимо перезапустить программу 1С'"));
			КонецЕсли;
		КонецЦикла;

		Если Не РасширениеНайдено Тогда
			НовоеРасширение = РасширенияКонфигурации.Создать();
			НовоеРасширение.ОбластьДействия = ОбластьДействияРасширенияКонфигурации.ИнформационнаяБаза;
			НовоеРасширение.БезопасныйРежим = Ложь;
			НовоеРасширение.Записать(ДвоичныеДанные);
			РезультатФункции.Вставить("Описание", НСтр(
					"ru = 'Модуль успешно установлен. Для принятия изменений необходимо перезапустить программу 1С'"));
		КонецЕсли;

//		ЗаписатьХешСуммуРасширения(КлючРасширения);

	Исключение

		ОписаниеОшибки = ОписаниеОшибки();
		РезультатФункции.Вставить("Описание", ОписаниеОшибки);
		РезультатФункции.Вставить("Успех", Ложь);

	КонецПопытки;

	Возврат РезультатФункции;

КонецФункции





