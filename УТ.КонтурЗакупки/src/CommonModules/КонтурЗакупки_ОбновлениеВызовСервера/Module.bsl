// Структура описания подсистемы.
// 
// Возвращаемое значение:
//  Структура - Структура описания подсистемы:
// * Ключ - Строка - 
// * НазваниеПродукта - Строка - 
// * Представление - Строка - 
// * ТипМодуля - Строка - 
// * ТекущаяВерсия - Строка - 
// * АктуальнаяВерсия - Строка - 
// * ПодсистемаРодитель - Строка - 
// * ТипСодержимого - Строка - Расширние, Обработка
Функция СтруктураОписанияПодсистемы() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ключ", "");
	Результат.Вставить("Представление", "");
	Результат.Вставить("НазваниеПродукта", "");
	Результат.Вставить("ТипМодуля", "");
	Результат.Вставить("ТекущаяВерсия", "");
	Результат.Вставить("АктуальнаяВерсия", "");
	Результат.Вставить("ПодсистемаРодитель", "");
	Результат.Вставить("ТипСодержимого", "");
	Возврат Результат;

КонецФункции



// Скачать обновление подсистемы.
// 
// Параметры:
//  НазваниеПродукта - Строка -  Название модуля
//  ТипМодуля - Строка -  Тип модуля
//  НомерВерсии - Строка -  Номер версии
// 
// Возвращаемое значение:
//  Неопределено -  Скачать обновление подсистемы
Функция СкачатьОбновлениеПодсистемы(НазваниеПродукта, ТипМодуля, НомерВерсии = "") Экспорт

	Результат = Неопределено;

	СтруктураДанныхДляЗапроса = api_СкачатьОбновление(НазваниеПродукта, ТипМодуля, НомерВерсии);
	РезультатHTTPЗапроса = КонтурЗакупки_httpКлиентСервер.ВыполнитьHTTPЗапрос(СтруктураДанныхДляЗапроса);

	Если РезультатHTTPЗапроса["data"] <> Неопределено Тогда
		Результат = РезультатHTTPЗапроса["data"];
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сравнивает текущие двоичные данные подсистемы с данными с сервера обновлений
// 
// Параметры: ОписаниеПодсистемы - Структура (Ключ, НазваниеПродукта, ТипМодуля)
//  Ключ - Строка - Ключ
//  НазваниеПродукта - Строка - Название продукта
//  ТипМодуля - Строка - Тип модуля
// 
// Возвращаемое значение:
//  Булево - Истина, если текущие двоичные данные не соответствуют данным с сервера обновлений
// Ложь, если текущие двоичные данные совпадают с данными сервера обновлений.
Функция ПодсистемаИзменена(Ключ, НазваниеПродукта, ТипМодуля) Экспорт

	Результат = Истина;
	ТекущийХеш = "";
	ОригинальныйХеш = "";

	Если ТипМодуля = "epf" Тогда

		ТекущаяВерсия = ПолучитьТекущуюВерсиюОбработки(Ключ);
		Если ТекущаяВерсия.СсылкаНаОбработку <> Неопределено Тогда
			ТекущиеДвоичныеДанные = ТекущаяВерсия.СсылкаНаОбработку.ХранилищеОбработки.Получить();
			ТекущийХеш = КонтурЗакупки_ОбновлениеВызовСервера.ХешДвоичныхДанныхСтрокой(ТекущиеДвоичныеДанные);
		КонецЕсли;

		ОригинальныеДвоичныеДанные = СкачатьОбновлениеПодсистемы(НазваниеПродукта, ТипМодуля, ТекущаяВерсия.Версия);

		Если ОригинальныеДвоичныеДанные <> Неопределено Тогда
			ОригинальныйХеш = КонтурЗакупки_ОбновлениеВызовСервера.ХешДвоичныхДанныхСтрокой(
				ОригинальныеДвоичныеДанные);
		КонецЕсли;

	ИначеЕсли ТипМодуля = "cfe" Тогда

		ТекущаяВерсия = ПолучитьТекущуюВерсиюРасширения(Ключ);
		ТекущийХеш = ТекущаяВерсия.ХешСумма;
		ИмяНастройки = СтрШаблон("ХешСумма_%1_%2", Ключ, ТекущаяВерсия.Версия);
		ОригинальныйХеш = КонтурЗакупки_ПодсистемаНастройкиВызовСервера.ПолучитьЗначениеНастройки("КонтурПодсистема",
			ИмяНастройки, "");

	КонецЕсли;

	Если ТекущийХеш = ОригинальныйХеш Тогда
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции
