// Параметры запроса к серверу.
// 
// Параметры:
//  НазваниеПроекта - Строка - Название проекта
// 
// Возвращаемое значение:
//  См. КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса
Функция ПараметрыЗапросаКСерверу(НазваниеПроекта) Экспорт

	ПараметрыHTTPЗапроса = КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса();
	ТестированиеЦентраУведомлений = КонтурЗакупки_ПодсистемаНастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"КонтурПодсистема", "ТестированиеЦентраУведомлений", Ложь);

	Если ТестированиеЦентраУведомлений Тогда
		ПараметрыHTTPЗапроса.АдресСервера = "update.testkontur.ru";
	Иначе
		ПараметрыHTTPЗапроса.АдресСервера = "update.kontur.ru";
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ПараметрыHTTPЗапроса.ЗаголовокHTTP = Заголовки;
	ПараметрыHTTPЗапроса.СтрокаПодключения = "/1c/v4/products/" + НазваниеПроекта + "/notifications";
	ПараметрыHTTPЗапроса.Метод = "POST";
	ПараметрыHTTPЗапроса.ЗащищенноеСоединение = Истина;
	ПараметрыHTTPЗапроса.ПортСервера = 443;

	Возврат ПараметрыHTTPЗапроса;
КонецФункции

