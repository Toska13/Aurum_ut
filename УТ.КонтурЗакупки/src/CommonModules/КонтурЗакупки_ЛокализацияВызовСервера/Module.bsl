#Область ПривязкаДокумента
// Получить закупку из привязки.
// 
// Параметры:
//  ТипОбъекта - Строка - Тип объекта
//  ИдентификаторОбъекта - Строка - Идентификатор объекта
//  Назначение - Строка, Неопределено - Назначение
// 
// Возвращаемое значение:
//  ДокументСсылка.КонтурЗакупки_Закупка, Неопределено - Получить закупку из привязки
Функция ПолучитьЗакупкуИзПривязки(ТипОбъекта, ИдентификаторОбъекта, Назначение = Неопределено) Экспорт
	ДокументЗакупки = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ПривязкаЗакупки.Закупка КАК Закупка
	|ИЗ
	|	РегистрСведений.КонтурЗакупки_ПривязкаЗакупки КАК КонтурЗакупки_ПривязкаЗакупки
	|ГДЕ
	|	КонтурЗакупки_ПривязкаЗакупки.ТипОбъекта = &ТипОбъекта
	|	И КонтурЗакупки_ПривязкаЗакупки.ИдентификаторОбъекта = &ИдентификаторОбъекта
	|	И ВЫБОР
	|			КОГДА &ЕстьНазначение
	|				ТОГДА КонтурЗакупки_ПривязкаЗакупки.Назначение = &Назначение
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";

	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Запрос.УстановитьПараметр("ЕстьНазначение", Не Назначение = Неопределено);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументЗакупки = Выборка.Закупка;
	КонецЕсли;

	Возврат ДокументЗакупки;
КонецФункции

// Получить ссылку на объект из привязки.
// 
// Параметры:
//  СсылкаНаЗакупку - ДокументСсылка.КонтурЗакупки_Закупка - Ссылка на закупку
//  ТипОбъекта - Строка - Тип объекта
//  Назначение - Строка - Назначение
// 
// Возвращаемое значение:
//  СправочникСсылкаИмяСправочника, ДокументСсылкаИмяДокумента, Неопределено, БизнесПроцессСсылкаИмяБизнесПроцесса - Получить ссылку на объект из привязки
Функция ПолучитьСсылкуНаОбъектИзПривязки(СсылкаНаЗакупку, ТипОбъекта, Назначение) Экспорт
	СсылкаНаОбъект = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЗакупки_ПривязкаЗакупки.ТипОбъекта КАК ТипОбъекта,
	|	КонтурЗакупки_ПривязкаЗакупки.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.КонтурЗакупки_ПривязкаЗакупки КАК КонтурЗакупки_ПривязкаЗакупки
	|ГДЕ
	|	КонтурЗакупки_ПривязкаЗакупки.Закупка = &Закупка
	|	И КонтурЗакупки_ПривязкаЗакупки.Назначение = &Назначение
	|	И КонтурЗакупки_ПривязкаЗакупки.ТипОбъекта = &ТипОбъекта";
	Запрос.УстановитьПараметр("Закупка", СсылкаНаЗакупку);
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МассивТипа = СтрРазделить(ТипОбъекта, ".");
		Если МассивТипа.Количество() = 2 Тогда
			Если МассивТипа[0] = "Справочники" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = Справочники[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
				Исключение
				КонецПопытки;
			ИначеЕсли МассивТипа[0] = "Документы" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = Документы[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
				Исключение
				КонецПопытки;
			ИначеЕсли МассивТипа[0] = "БизнесПроцессы" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = БизнесПроцессы[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат СсылкаНаОбъект;
КонецФункции

// Создать привязку закупки.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка.КонтурЗакупки_Закупка - Документ основание
//  ТипОбъекта - Строка - Тип объекта
//  Назначение - Строка - Назначение
//  ИдентификаторОбъекта - Строка, УникальныйИдентификатор - Идентификатор объекта
//  Представление - Строка - Представление
Процедура СоздатьПривязкуЗакупки(ДокументОснование, ТипОбъекта, Назначение, ИдентификаторОбъекта, Представление = "") Экспорт
	Запись = РегистрыСведений.КонтурЗакупки_ПривязкаЗакупки.СоздатьМенеджерЗаписи();
	Запись.Закупка = ДокументОснование;
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ИдентификаторОбъекта = ?(ТипЗнч(ИдентификаторОбъекта) = Тип("УникальныйИдентификатор"), XMLСтрока(
		ИдентификаторОбъекта), ИдентификаторОбъекта);
	Запись.Назначение = Назначение;
	Запись.Представление = Представление;
	Запись.Записать();
КонецПроцедуры
#КонецОбласти

