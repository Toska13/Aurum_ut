Функция api_ПолучитьИнформациюОЛимитах() Экспорт

	ПараметрыHTTPЗапроса = Неопределено;
	ApiKey= ПолучитьApiKey();
	Если ЗначениеЗаполнено(ApiKey) Тогда
		ПараметрыHTTPЗапроса = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьПараметрыHTTPЗапроса();
		СтрокаПодключения = "/external/v1/limitGroups";
		ПараметрыHTTPЗапроса.Вставить("Метод", "GET");
		ПараметрыHTTPЗапроса.Вставить("СтрокаПодключения", СтрокаПодключения);
		ПараметрыHTTPЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокПоУмолчанию(ApiKey));
		ПараметрыHTTPЗапроса.Вставить("ОтправитьФайл", Ложь);
		ПараметрыHTTPЗапроса.Вставить("ПолучитьФайл", Ложь);
		ПараметрыHTTPЗапроса.Вставить("ТелоЗапроса", Неопределено);
	КонецЕсли;
	Возврат ПараметрыHTTPЗапроса;
КонецФункции

