	ПараметрыHTTPЗапроса.Вставить("ТелоЗапроса", Неопределено);
	ПараметрыHTTPЗапроса.Вставить("ПортСервера", 443);
	ПараметрыHTTPЗапроса.Вставить("ЗащищенноеСоединение", Истина);

	Возврат ПараметрыHTTPЗапроса;
КонецФункции

