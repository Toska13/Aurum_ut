Функция СформироватьСтрокуURLЗапроса(СтруктураТелаЗапроса)
	СтрокаЗапроса= "";
	Для Каждого КлючЗначение Из СтруктураТелаЗапроса Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого ЭлМассива Из КлючЗначение.Значение Цикл
				Если ПустаяСтрока(СтрокаЗапроса) Тогда
					СтрокаЗапроса= "?";
				Иначе
					СтрокаЗапроса= СтрокаЗапроса + "&";
				КонецЕсли;
				СтрокаЗапроса= СтрокаЗапроса + КлючЗначение.Ключ + "=" + КодироватьСтроку(ЭлМассива,
					СпособКодированияСтроки.КодировкаURL);
			КонецЦикла;
		Иначе
			Если ПустаяСтрока(СтрокаЗапроса) Тогда
				СтрокаЗапроса= "?";
			Иначе
				СтрокаЗапроса= СтрокаЗапроса + "&";
			КонецЕсли;
			СтрокаЗапроса= СтрокаЗапроса + КлючЗначение.Ключ + "=" + КодироватьСтроку(
							КлючЗначение.Значение, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрокаЗапроса;
КонецФункции

// Получить api key.
// 
// Возвращаемое значение:
//  Структура, Неопределено -  Получить api key
Функция ПолучитьApiKey()

	Возврат КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки("ApiKey", "");

КонецФункции

Функция ЗаголовокПоУмолчанию(ApiKey = "")
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("Content-Type", "application/json");
	Если Не ПустаяСтрока(ApiKey) Тогда
		ЗаголовокHTTP.Вставить("X-Kontur-Apikey", ApiKey);
	КонецЕсли;
	Возврат ЗаголовокHTTP
КонецФункции

// Очистить структуру от незаполненных значений.
// 
// Параметры:
//  СтруктураЗапроса - Структура -  Структура запроса
// 
// Возвращаемое значение:
//  Соответствие из Строка -  Очистить с труктуру от незаполненных значений
Функция ОчиститьСтруктуруОтНезаполненныхЗначений(СтруктураЗапроса)

	СтруктураТелаЗапроса = Новый Соответствие;
	Для Каждого КлючЗначение Из СтруктураЗапроса Цикл
		Если Не КлючЗначение.Значение = Неопределено Тогда
			СтруктураТелаЗапроса.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат СтруктураТелаЗапроса
КонецФункции

