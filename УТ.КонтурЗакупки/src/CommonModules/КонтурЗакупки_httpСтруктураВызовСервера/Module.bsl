Функция api_ПолучитьСписокРегионов(НазваниеРегиона) Экспорт

	СтруктураТелаЗапроса = Новый Структура;
	СтруктураТелаЗапроса.Вставить("prefix", НазваниеРегиона);

	СтрокаЗапроса = СформироватьСтрокуURLЗапроса(СтруктураТелаЗапроса);
	СтрокаПодключения= "/Region/Suggest" + СтрокаЗапроса;

	ПараметрыHTTPЗапроса = КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса();
	ПараметрыHTTPЗапроса.Вставить("АдресСервера", "zakupki.kontur.ru");

	ПараметрыHTTPЗапроса.Вставить("Метод", "GET");
	ПараметрыHTTPЗапроса.Вставить("СтрокаПодключения", СтрокаПодключения);
	ПараметрыHTTPЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокПоУмолчанию());
	ПараметрыHTTPЗапроса.Вставить("ОтправитьФайл", Ложь);
