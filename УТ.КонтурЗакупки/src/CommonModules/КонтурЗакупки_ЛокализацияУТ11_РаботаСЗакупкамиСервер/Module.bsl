#Область ПрограммныйИнтерфейс

// Получить массив пользователей с ролью.
// 
// Параметры:
//  Роль - ОбъектМетаданныхРоль - Роль
// 
// Возвращаемое значение:
//  Массив Из СправочникСсылка.Пользователи - Массив пользователей с ролью
Функция ПолучитьМассивПользователейСРолью(Роль) Экспорт
	МассивПользователей = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если ПользовательИБ.Роли.Содержит(Роль) Тогда
			ПользовательПоИД = Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ",
				ПользовательИБ.УникальныйИдентификатор);
			Если ЗначениеЗаполнено(ПользовательПоИД) Тогда
				МассивПользователей.Добавить(ПользовательПоИД);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат МассивПользователей;
КонецФункции


// Найти создать организатора заказчика.
// 
// Параметры:
//  СтруктураОрганизатора - Структура - Структура заказчика:
// * ПолноеНаименование - Строка - Полное наименование
// * ИНН - Строка - ИНН
// * КПП - Строка - КПП
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЗакупки_ОрганизаторыЗаказчики - организатор или заказчика
Функция ПолучитьОрганизатора(СтруктураОрганизатора) Экспорт
	Заказчик = Справочники.КонтурЗакупки_ОрганизаторыЗаказчики.ПустаяСсылка();
	Искать = Истина;
	Создать = Ложь;

	Если Не ЗначениеЗаполнено(СтруктураОрганизатора.ПолноеНаименование) И Не ЗначениеЗаполнено(
		СтруктураОрганизатора.ИНН) Тогда
		Искать = Ложь;
	КонецЕсли;

	Если Искать Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЗакупки_ОрганизаторыЗаказчики.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЗакупки_ОрганизаторыЗаказчики КАК КонтурЗакупки_ОрганизаторыЗаказчики
		|ГДЕ
		|	Выбор
		|		Когда &ИскатьПоИмени
		|			Тогда КонтурЗакупки_ОрганизаторыЗаказчики.Наименование = &Наименование
		|			Или КонтурЗакупки_ОрганизаторыЗаказчики.ПолноеНаименование ПОДОБНО (&ПолноеНаименование)
		|		Иначе Истина
		|	Конец
		|	И Выбор
		|		Когда &ИскатьПоИНН
		|			Тогда КонтурЗакупки_ОрганизаторыЗаказчики.ИНН = &ИНН
		|		Иначе Истина
		|	Конец
		|	И Выбор
		|		Когда &ИскатьПоКПП
		|			Тогда КонтурЗакупки_ОрганизаторыЗаказчики.КПП = &КПП
		|		Иначе Истина
		|	Конец";

		Запрос.УстановитьПараметр("ПолноеНаименование", СтруктураОрганизатора.ПолноеНаименование);
		Запрос.УстановитьПараметр("Наименование", Лев(СтруктураОрганизатора.ПолноеНаименование, 150));
		Запрос.УстановитьПараметр("ИНН", СтруктураОрганизатора.ИНН);
		Запрос.УстановитьПараметр("КПП", СтруктураОрганизатора.КПП);

		Запрос.УстановитьПараметр("ИскатьПоИНН", Истина);
		Запрос.УстановитьПараметр("ИскатьПоКПП", Истина);
		Запрос.УстановитьПараметр("ИскатьПоИмени", Ложь);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Искать = Ложь;
			Заказчик = Выборка.Ссылка;
		КонецЕсли;

		Если Искать Тогда
			Запрос.УстановитьПараметр("ИскатьПоИНН", Истина);
			Запрос.УстановитьПараметр("ИскатьПоКПП", Ложь);
			Запрос.УстановитьПараметр("ИскатьПоИмени", Ложь);
			Если Выборка.Следующий() Тогда
				Искать = Ложь;
				Заказчик = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;

		Если Искать Тогда
			Запрос.УстановитьПараметр("ИскатьПоИНН", Ложь);
			Запрос.УстановитьПараметр("ИскатьПоКПП", Ложь);
			Запрос.УстановитьПараметр("ИскатьПоИмени", Истина);
			Если Выборка.Следующий() Тогда
				Искать = Ложь;
				Заказчик = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;

		Если Искать Тогда
			Создать = Истина;
		КонецЕсли;
	КонецЕсли;

	Если Создать Тогда
		НовСпр = Справочники.КонтурЗакупки_ОрганизаторыЗаказчики.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовСпр, СтруктураОрганизатора);
		НовСпр.Записать();
		Заказчик = НовСпр.Ссылка;
	КонецЕсли;

	Возврат Заказчик;
КонецФункции

