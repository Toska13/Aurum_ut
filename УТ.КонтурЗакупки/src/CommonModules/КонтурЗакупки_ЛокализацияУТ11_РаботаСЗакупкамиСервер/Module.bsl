// Найти создать объект закупки.
// 
// Параметры:
//  СтруктураЗакупки - ВыборкаИзРезультатаЗапроса, Структура - Структура закупки:
// * НаименованиеОбъектаЗакупки - Строка - 
// * КТРУКод - Строка - 
// * КТРУРасшифровка - Строка - 
// * ОКВЭД2Код - Строка - 
// * ОКВЭД2Расшифровка - Строка - 
// * ОКПД2Код - Строка - 
// * ОКПД2Расшифровка - Строка - 
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурЗакупки_ОбъектыЗакупки -  Найти создать объект закупки
Функция НайтиСоздатьОбъектЗакупки(СтруктураЗакупки) Экспорт
	ОбъектЗакупки = Справочники.КонтурЗакупки_ОбъектыЗакупки.ПустаяСсылка();

	СтруктураКТРУ = Новый Структура("Код, Наименование", СтруктураЗакупки.КТРУКод, СтруктураЗакупки.КТРУРасшифровка);
	КТРУ = НайтиСоздатьСправочникПоКоду("КонтурЗакупки_КТРУ", СтруктураКТРУ);

	СтруктураОКВЭД2 = Новый Структура("Код, Наименование", СтруктураЗакупки.ОКВЭД2Код,
		СтруктураЗакупки.ОКВЭД2Расшифровка);
	ОКВЭД2 = НайтиСоздатьСправочникПоКоду("КонтурЗакупки_ОКВЭД2", СтруктураОКВЭД2);

	СтруктураОКПД2 = Новый Структура("Код, Наименование", СтруктураЗакупки.ОКПД2Код, СтруктураЗакупки.ОКПД2Расшифровка);
	ОКПД2 = НайтиСоздатьСправочникПоКоду("КонтурЗакупки_ОКПД2", СтруктураОКПД2);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ОбъектыЗакупки.Ссылка
	|ИЗ
	|	Справочник.КонтурЗакупки_ОбъектыЗакупки КАК КонтурЗакупки_ОбъектыЗакупки
	|ГДЕ
	|	КонтурЗакупки_ОбъектыЗакупки.КТРУ = &КТРУ
	|	И КонтурЗакупки_ОбъектыЗакупки.ОКПД2 = &ОКПД2
	|	И КонтурЗакупки_ОбъектыЗакупки.ОКВЭД2 = &ОКВЭД2
	|	И КонтурЗакупки_ОбъектыЗакупки.НаименованиеОбъектаЗакупки = &НаименованиеОбъектаЗакупки";

	Запрос.УстановитьПараметр("КТРУ", КТРУ);
	Запрос.УстановитьПараметр("ОКПД2", ОКПД2);
	Запрос.УстановитьПараметр("ОКВЭД2", ОКВЭД2);
	Запрос.УстановитьПараметр("НаименованиеОбъектаЗакупки", СтруктураЗакупки.НаименованиеОбъектаЗакупки);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбъектЗакупки = Выборка.Ссылка;
	Иначе
		НовОбъект = Справочники.КонтурЗакупки_ОбъектыЗакупки.СоздатьЭлемент();
		НовОбъект.КТРУ = КТРУ;
		НовОбъект.ОКВЭД2 = ОКВЭД2;
		НовОбъект.ОКПД2 = ОКПД2;
		НовОбъект.НаименованиеОбъектаЗакупки = СтруктураЗакупки.НаименованиеОбъектаЗакупки;
		НовОбъект.Записать();
		ОбъектЗакупки = НовОбъект.Ссылка;

	КонецЕсли;
	Возврат ОбъектЗакупки;
КонецФункции

// Найти создать справочник [ИмяСправочника] по коду
// 
// Параметры:
//  ИмяСправочника - Строка - Имя справочника
//  СтруктураСправочника - Структура - Структура справочника:
// * Код - Строка - 
// * Наименование - Строка - 
// 
// Возвращаемое значение:
//  СправочникСсылка -
//  Возвращаемая ссылка на справочник
Функция НайтиСоздатьСправочникПоКоду(ИмяСправочника, СтруктураСправочника) Экспорт

	СпрСсылка = Справочники[ИмяСправочника].ПустаяСсылка();
	Если ЗначениеЗаполнено(СтруктураСправочника.Код) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЗакупки_Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИмяСправочника КАК КонтурЗакупки_Справочник
		|ГДЕ
		|	КонтурЗакупки_Справочник.Код = &Код";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочника);

		Запрос.УстановитьПараметр("Код", СтруктураСправочника.Код);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СпрСсылка = Выборка.Ссылка;
		Иначе
			НовСпр = Справочники[ИмяСправочника].СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовСпр, СтруктураСправочника);
			НовСпр.Записать();
			СпрСсылка = НовСпр.Ссылка;
		КонецЕсли;

	КонецЕсли;
	Возврат СпрСсылка;
КонецФункции

// Найти создать справочник [ИмяСправочника] по наименованию
// 
// Параметры:
//  ИмяСправочника - Строка - Имя справочника
//  СтруктураСправочника - Структура - Структура справочника:
// * Наименование - Строка - 
// 
// Возвращаемое значение:
//  СправочникСсылка - Возвращаемая ссылка на справочник
Функция НайтиСоздатьСправочникПоНаименованию(ИмяСправочника, СтруктураСправочника) Экспорт

	СпрСсылка = Справочники[ИмяСправочника].ПустаяСсылка();
	Если ЗначениеЗаполнено(СтруктураСправочника.Наименование) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЗакупки_Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИмяСправочника КАК КонтурЗакупки_Справочник
		|ГДЕ
		|	КонтурЗакупки_Справочник.Наименование = &Наименование";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочника);

		Запрос.УстановитьПараметр("Наименование", СтруктураСправочника.Наименование);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СпрСсылка = Выборка.Ссылка;
		Иначе
			НовСпр = Справочники[ИмяСправочника].СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовСпр, СтруктураСправочника);
			НовСпр.Записать();
			СпрСсылка = НовСпр.Ссылка;
		КонецЕсли;

	КонецЕсли;
	Возврат СпрСсылка;
КонецФункции

// Получить роль пользователя.
// 
// Возвращаемое значение:
//  ОбъектМетаданныхРоль, Неопределено -  Получить роль пользователя
Функция ПолучитьРольПользователя() Экспорт
	РольПользователя = Неопределено;
	Если РольДоступна(Метаданные.Роли.КонтурЗакупки_ОтделПродаж) Тогда
		РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделПродаж;
	ИначеЕсли РольДоступна(Метаданные.Роли.КонтурЗакупки_ОтделЛогистики) Тогда
		РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделЛогистики;
	ИначеЕсли РольДоступна(Метаданные.Роли.КонтурЗакупки_ОтделСнабжения) Тогда
		РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделСнабжения;
	КонецЕсли;
	Возврат РольПользователя;
КонецФункции

#КонецОбласти


#Область СлужебныйПрограммныйИнтерфейс
// Заполнить организатора в обработках закупки.
Процедура ЗаполнитьОрганизатораВОбработкахЗакупки() Экспорт
	
	ОбработкиЗакупок_ЗаполненОрганизатор = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"ОбработкиЗакупок_ЗаполненОрганизатор", Ложь);

	Если Не ОбработкиЗакупок_ЗаполненОрганизатор Тогда
		Документы.КонтурЗакупки_ОбработкаЗакупки.ЗаполнитьОрганизатораИзТабличнойЧасти();

		КонтурЗакупки_НастройкиВызовСервера.УстановитьЗначениеНастройки("ОбработкиЗакупок_ЗаполненОрганизатор", Истина);
	КонецЕсли;

КонецПроцедуры
#КонецОбласти
