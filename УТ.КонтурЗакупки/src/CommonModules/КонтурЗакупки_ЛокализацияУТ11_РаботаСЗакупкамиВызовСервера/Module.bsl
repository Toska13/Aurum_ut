Функция СоздатьЗаказКлиента(ДокументОснование, ЗаказКлиентаСсылка = Неопределено, ОписаниеРезультата = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Продолжать = Истина;
	Если ДокументОснование.Пустая() Тогда
		Продолжать = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Исходный документ не записан. Нажмите Записать'")
			+ Символы.ПС;
	КонецЕсли;

	Если Продолжать Тогда
		
		ДокументЗаказКлиентаОбъект = Документы["ЗаказКлиента"].СоздатьДокумент();

		СтандартнаяОбработкаПМ = Истина;

		ПараметрыПМ = Новый Структура;
		ПараметрыПМ.Вставить("ОбъектДляЗаполнения", ДокументЗаказКлиентаОбъект);
		ПараметрыПМ.Вставить("ДокументОснование", ДокументОснование);

		КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"ЗаполнитьДокументЗаказКлиента", ПараметрыПМ, СтандартнаяОбработкаПМ);

		Если СтандартнаяОбработкаПМ Тогда
			ЗаполнитьДокументЗаказКлиента(ДокументОснование, ДокументЗаказКлиентаОбъект);
		КонецЕсли;

		ДокументЗаказКлиентаОбъект.Записать();
		ЗаказКлиентаСсылка = ДокументЗаказКлиентаОбъект.Ссылка;

	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Продолжать;
	
КонецФункции

