// Получить данные Номенклатуры
// 
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура
// 
// Возвращаемое значение:
//  Структура - Номенклатура при изменении на сервере:
// * Производитель - СправочникСсылка.Производители - 
// * Контрагент - СправочникСсылка.Организации, СправочникСсылка.Контрагенты, Неопределено - 
// * Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения, Неопределено - 
// * ВесЕдиницы - Число - 
// * ОбъемЕдиницы - Число - 
// * СтавкаНДСПоставщика - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - 
// * НормативныйДокумент - Строка - 
// * СтавкаНДСПродажи - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - 
Функция ПолучитьДанныеНоменклатуры(Номенклатура) Экспорт
	СтруктураДанныеНоменклатуры = Новый Структура;
	СтруктураДанныеНоменклатуры.Вставить("Производитель", Справочники.Производители.ПустаяСсылка());
	СтруктураДанныеНоменклатуры.Вставить("Контрагент", Неопределено);
	СтруктураДанныеНоменклатуры.Вставить("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	СтруктураДанныеНоменклатуры.Вставить("ВесЕдиницы", 0);
	СтруктураДанныеНоменклатуры.Вставить("ОбъемЕдиницы", 0);
	СтруктураДанныеНоменклатуры.Вставить("СтавкаНДСПоставщика", Перечисления.КонтурЗакупки_СтавкиНДС.ПустаяСсылка());
	СтруктураДанныеНоменклатуры.Вставить("НормативныйДокумент", "");
	СтруктураДанныеНоменклатуры.Вставить("СтавкаНДСПродажи", Перечисления.КонтурЗакупки_СтавкиНДС.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Производитель КАК Производитель,
	|	Номенклатура.Контрагент КАК Контрагент,
	|	Номенклатура.ЕдиницаИзмерения КАК Упаковка,
	|	&СтакаНДСПоУмолчанию КАК СтавкаНДСПоставщика,
	|	&СтакаНДСПродажиПоУмолчанию КАК СтавкаНДСПродажи,
	|	ВЫБОР
	|		КОГДА Номенклатура.ВесИспользовать
	|		И ЕСТЬNULL(Номенклатура.ВесЗнаменатель, 0) <> 0
	|			ТОГДА ВЫРАЗИТЬ(Номенклатура.ВесЧислитель / Номенклатура.ВесЗнаменатель КАК ЧИСЛО(17, 7))
	|	КОНЕЦ КАК ВесЕдиницы,
	|	ВЫБОР
	|		КОГДА Номенклатура.ОбъемИспользовать
	|		И ЕСТЬNULL(Номенклатура.ОбъемЗнаменатель, 0) <> 0
	|			ТОГДА ВЫРАЗИТЬ(Номенклатура.ОбъемЧислитель / Номенклатура.ОбъемЗнаменатель КАК ЧИСЛО(17, 7))
	|	КОНЕЦ КАК ОбъемЕдиницы
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	Запрос.УстановитьПараметр("СтакаНДСПоУмолчанию", КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"СтакаНДСПоУмолчанию", Перечисления.КонтурЗакупки_СтавкиНДС.ПустаяСсылка()));
	Запрос.УстановитьПараметр("СтакаНДСПродажиПоУмолчанию", КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"СтакаНДСПродажиПоУмолчанию", Перечисления.КонтурЗакупки_СтавкиНДС.ПустаяСсылка()));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураДанныеНоменклатуры, Выборка);
		СтруктураДанныеНоменклатуры.НормативныйДокумент = УправлениеСвойствами.ЗначениеСвойства(Номенклатура,
			КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"ПВХНормативныйДокумент", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка()));
	КонецЕсли;

	Возврат СтруктураДанныеНоменклатуры;
КонецФункции

// Получить номенклатуру по объекту закупки.
// 
// Параметры:
//  МассивОрганизаторов - Массив Из СправочникСсылка.КонтурЗакупки_ОрганизаторыЗаказчики -  Массив организаторов
//  ОбъектЗакупки - СправочникСсылка.КонтурЗакупки_ОбъектыЗакупки - Объект закупки
// 
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - Найденная номенклатура
Функция ПолучитьНоменклатуруПоОбъектуЗакупки(МассивОрганизаторов, ОбъектЗакупки) Экспорт
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЗакупки_СоответствиеНоменклатуры.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.КонтурЗакупки_СоответствиеНоменклатуры КАК КонтурЗакупки_СоответствиеНоменклатуры
	|ГДЕ
	|	КонтурЗакупки_СоответствиеНоменклатуры.ОрганизаторЗаказчик В (&МассивОрганизаторЗаказчик)
	|	И КонтурЗакупки_СоответствиеНоменклатуры.ОбъектЗакупки = &ОбъектЗакупки
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЗакупки_СоответствиеНоменклатуры.ДатаПривязки УБЫВ";
	Запрос.УстановитьПараметр("МассивОрганизаторЗаказчик", МассивОрганизаторов);
	Запрос.УстановитьПараметр("ОбъектЗакупки", ОбъектЗакупки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Номенклатура = Выборка.Номенклатура;
	КонецЕсли;

	Возврат Номенклатура;
КонецФункции

// Записать номенклатуру по объекту закупки.
// 
// Параметры:
//  МассивОрганизаторов - Массив Из СправочникСсылка.КонтурЗакупки_ОрганизаторыЗаказчики - Массив организаторов
//  ОбъектЗакупки - СправочникСсылка.КонтурЗакупки_ОбъектыЗакупки - Объект закупки
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура
Процедура ЗаписатьНоменклатуруПоОбъектуЗакупки(МассивОрганизаторов, ОбъектЗакупки, Номенклатура) Экспорт

	Для Каждого Организатор Из МассивОрганизаторов Цикл
		Запись = РегистрыСведений.КонтурЗакупки_СоответствиеНоменклатуры.СоздатьМенеджерЗаписи();
		Запись.ОрганизаторЗаказчик = Организатор;
		Запись.ОбъектЗакупки = ОбъектЗакупки;
		Запись.Номенклатура = Номенклатура;
		Запись.ДатаПривязки = ТекущаяДатаСеанса();
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

// Создать задание обработки закупки.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Документ основание
//  Назначение - Строка - Назначение задания
//  ПараметрыЗадания - Структура из Неопределено - Параметры задания
//  ЗаданиеСсылка - ДокументСсылка - Задание ссылка
//  ОписаниеРезультата - Строка - Описание результата
// 
// Возвращаемое значение:
//  Булево - Создать задание на сервере
Функция СоздатьЗаданиеОбработкиЗакупки(ДокументОснование, Назначение, ПараметрыЗадания, ЗаданиеСсылка = Неопределено,
	ОписаниеРезультата = "") Экспорт
	Продолжать = Истина;
	ТипОбъекта = КонтурЗакупки_ЛокализацияВызовСервера.ПредставлениеТипаЗадание();
	Если ДокументОснование.Пустая() Тогда
		Продолжать = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Исходный документ не записан. Нажмите Записать'")
			+ Символы.ПС;
	КонецЕсли;

	Если Продолжать Тогда
		Задание = БизнесПроцессы["Задание"].СоздатьБизнесПроцесс();
		Задание.Дата = ТекущаяДатаСеанса();
		Задание.Заполнить(ДокументОснование);
		Задание.Содержание = СтрШаблон(НСтр("ru = 'Обработать документ обработка закупки: %1'"), Строка(
			ДокументОснование));
		Задание.Записать();
		Задание.Старт();

		ЗаданиеСсылка = Задание.Ссылка;

		СоздатьПривязкуОбработкиЗакупки(ДокументОснование, ТипОбъекта, Назначение, XMLСтрока(
			ЗаданиеСсылка.УникальныйИдентификатор()), Строка(ЗаданиеСсылка));

	КонецЕсли;

	Возврат Продолжать;
КонецФункции
#КонецОбласти

