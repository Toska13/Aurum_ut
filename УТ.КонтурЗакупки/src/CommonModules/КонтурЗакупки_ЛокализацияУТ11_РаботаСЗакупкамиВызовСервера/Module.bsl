#Область ПривязкаДокумента

// Получить закупку из привязки.
// 
// Параметры:
//  ТипОбъекта - Строка - Тип объекта
//  ИдентификаторОбъекта - Строка - Идентификатор объекта
//  Назначение - Строка, Неопределено - Назначение
// 
// Возвращаемое значение:
//  ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки, Неопределено - Получить закупку из привязки
Функция ПолучитьОбработкуЗакупкиИзПривязки(ТипОбъекта, ИдентификаторОбъекта, Назначение = Неопределено) Экспорт
	ДокументОбработкиЗакупки = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ОбработкаЗакупки КАК ОбработкаЗакупки
	|ИЗ
	|	РегистрСведений.КонтурЗакупки_ПривязкаОбработкиЗакупки КАК КонтурЗакупки_ПривязкаОбработкиЗакупки
	|ГДЕ
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ТипОбъекта = &ТипОбъекта
	|	И КонтурЗакупки_ПривязкаОбработкиЗакупки.ИдентификаторОбъекта = &ИдентификаторОбъекта
	|	И ВЫБОР
	|		КОГДА &ЕстьНазначение
	|			ТОГДА КонтурЗакупки_ПривязкаОбработкиЗакупки.Назначение = &Назначение
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ";

	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Запрос.УстановитьПараметр("ЕстьНазначение", Не Назначение = Неопределено);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументОбработкиЗакупки = Выборка.ОбработкаЗакупки;
	КонецЕсли;

	Возврат ДокументОбработкиЗакупки;
КонецФункции

// Получить ссылку на объект из привязки.
// 
// Параметры:
//  СсылкаНаОбработкуЗакупки - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Ссылка на закупку
//  ТипОбъекта - Строка - Тип объекта
//  Назначение - Строка - Назначение
// 
// Возвращаемое значение:
//  СправочникСсылкаИмяСправочника, ДокументСсылкаИмяДокумента, Неопределено, БизнесПроцессСсылкаИмяБизнесПроцесса - Получить ссылку на объект из привязки
Функция ПолучитьСсылкуНаОбъектИзПривязки(СсылкаНаОбработкуЗакупки, ТипОбъекта, Назначение) Экспорт
	СсылкаНаОбъект = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ТипОбъекта КАК ТипОбъекта,
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.КонтурЗакупки_ПривязкаОбработкиЗакупки КАК КонтурЗакупки_ПривязкаОбработкиЗакупки
	|ГДЕ
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ОбработкаЗакупки = &ОбработкаЗакупки
	|	И КонтурЗакупки_ПривязкаОбработкиЗакупки.Назначение = &Назначение
	|	И КонтурЗакупки_ПривязкаОбработкиЗакупки.ТипОбъекта = &ТипОбъекта";
	Запрос.УстановитьПараметр("ОбработкаЗакупки", СсылкаНаОбработкуЗакупки);
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МассивТипа = СтрРазделить(ТипОбъекта, ".");
		Если МассивТипа.Количество() = 2 Тогда
			Если МассивТипа[0] = "Справочники" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = Справочники[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
				Исключение
				КонецПопытки;
			ИначеЕсли МассивТипа[0] = "Документы" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = Документы[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
				Исключение
				КонецПопытки;
			ИначеЕсли МассивТипа[0] = "БизнесПроцессы" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = БизнесПроцессы[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат СсылкаНаОбъект;
КонецФункции

// Получить массив ссылок на объект из привязки.
// 
// Параметры:
//  СсылкаНаОбработкуЗакупки - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Ссылка на закупку
//  ТипОбъекта - Строка - Тип объекта
//  Назначение - Строка - Назначение
//  ТолькоНеПомеченныеНаУдаление - Булево - Только не помеченные на удаление
// 
// Возвращаемое значение:
//  Неопределено, Массив из СправочникСсылкаИмяСправочника, ДокументСсылкаИмяДокумента, БизнесПроцессСсылкаИмяБизнесПроцесса - Получить ссылку на объект из привязки
Функция ПолучитьМассивСсылокНаОбъектИзПривязки(СсылкаНаОбработкуЗакупки, ТипОбъекта, Назначение = Неопределено,
	ТолькоНеПомеченныеНаУдаление = Истина) Экспорт
	МассивСсылокНаОбъект = Новый Массив; // Массив из Произвольный
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ТипОбъекта КАК ТипОбъекта,
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.КонтурЗакупки_ПривязкаОбработкиЗакупки КАК КонтурЗакупки_ПривязкаОбработкиЗакупки
	|ГДЕ
	|	КонтурЗакупки_ПривязкаОбработкиЗакупки.ОбработкаЗакупки = &ОбработкаЗакупки
	|	И ВЫБОР
	|		КОГДА &ЕстьНазначение
	|			ТОГДА КонтурЗакупки_ПривязкаОбработкиЗакупки.Назначение = &Назначение
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|	И КонтурЗакупки_ПривязкаОбработкиЗакупки.ТипОбъекта = &ТипОбъекта";
	Запрос.УстановитьПараметр("ОбработкаЗакупки", СсылкаНаОбработкуЗакупки);
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Запрос.УстановитьПараметр("ЕстьНазначение", ЗначениеЗаполнено(Назначение));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивТипа = СтрРазделить(ТипОбъекта, ".");
		Если МассивТипа.Количество() = 2 Тогда
			Если МассивТипа[0] = "Справочники" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = Справочники[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));

					Если ТолькоНеПомеченныеНаУдаление Тогда
						Если Не СсылкаНаОбъект.ПометкаУдаления Тогда
							МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);
						КонецЕсли;
					Иначе
						МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);
					КонецЕсли;

				Исключение
				КонецПопытки;
			ИначеЕсли МассивТипа[0] = "Документы" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = Документы[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
					Если ТолькоНеПомеченныеНаУдаление Тогда
						Если Не СсылкаНаОбъект.ПометкаУдаления Тогда
							МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);
						КонецЕсли;
					Иначе
						МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);
					КонецЕсли;
				Исключение
				КонецПопытки;
			ИначеЕсли МассивТипа[0] = "БизнесПроцессы" Тогда
				//@skip-check empty-except-statement
				Попытка
					СсылкаНаОбъект = БизнесПроцессы[МассивТипа[1]].ПолучитьСсылку(
							Новый УникальныйИдентификатор(Выборка.ИдентификаторОбъекта));
					Если ТолькоНеПомеченныеНаУдаление Тогда
						Если Не СсылкаНаОбъект.ПометкаУдаления Тогда
							МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);
						КонецЕсли;
					Иначе
						МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	;
	Возврат МассивСсылокНаОбъект;
КонецФункции

// Создать привязку закупки.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Документ основание
//  ТипОбъекта - Строка - Тип объекта
//  Назначение - Строка - Назначение
//  ИдентификаторОбъекта - Строка, УникальныйИдентификатор - Идентификатор объекта
//  Представление - Строка - Представление
Процедура СоздатьПривязкуОбработкиЗакупки(ДокументОснование, ТипОбъекта, Назначение, ИдентификаторОбъекта,
	Представление = "") Экспорт
	Запись = РегистрыСведений.КонтурЗакупки_ПривязкаОбработкиЗакупки.СоздатьМенеджерЗаписи();
	Запись.ОбработкаЗакупки = ДокументОснование;
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ИдентификаторОбъекта = ?(ТипЗнч(ИдентификаторОбъекта) = Тип("УникальныйИдентификатор"), XMLСтрока(
		ИдентификаторОбъекта), ИдентификаторОбъекта);
