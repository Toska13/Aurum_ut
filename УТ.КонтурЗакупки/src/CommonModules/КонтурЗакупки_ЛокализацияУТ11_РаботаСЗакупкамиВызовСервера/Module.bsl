// Создать задачу сотруднику.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Документ основание
//  ЗадачаСсылка - ДокументСсылка - Задача ссылка
//  ОписаниеРезультата - Строка - Описание результата
// 
// Возвращаемое значение:
//  Булево - Создать задачу сотруднику на сервере
Функция СоздатьЗадачуСотруднику(ДокументОснование, ЗадачаСсылка = Неопределено, ОписаниеРезультата = "") Экспорт
	Продолжать = Истина;

	Если ДокументОснование.Пустая() Тогда
		Продолжать = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Исходный документ не записан. Нажмите Записать'")
			+ Символы.ПС;
	КонецЕсли;

	Если Продолжать Тогда
		ДокументЗадачаСотрудникаОбъект = Документы["ЗадачаСотрудника"].СоздатьДокумент();

		СтандартнаяОбработкаПМ = Истина;

		ПараметрыПМ = Новый Структура;
		ПараметрыПМ.Вставить("ОбъектДляЗаполнения", ДокументЗадачаСотрудникаОбъект);
		ПараметрыПМ.Вставить("ДокументОснование", ДокументОснование);

		КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
				"ЗаполнитьДокументЗадачаСотрудника", ПараметрыПМ, СтандартнаяОбработкаПМ);

		Если СтандартнаяОбработкаПМ Тогда
			ЗаполнитьДокументЗадачаСотрудника(ДокументОснование, ДокументЗадачаСотрудникаОбъект);
		КонецЕсли;

		ДокументЗадачаСотрудникаОбъект.Записать();
		ЗадачаСсылка = ДокументЗадачаСотрудникаОбъект.Ссылка;
	КонецЕсли;

	Возврат Продолжать;
КонецФункции
	
// Создать задание.
