	КонецЕсли;

	Если Продолжать Тогда
		БПЗаданиеОбъект = БизнесПроцессы["Задание"].СоздатьБизнесПроцесс();

		СтандартнаяОбработкаПМ = Истина;

		ПараметрыПМ = Новый Структура;
