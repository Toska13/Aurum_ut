#Область ЗаполнениеЗаказКлиента
// Заполнить документ ЗаказКлиента.
// 
// Параметры:
//  ОбработкаЗакупкиСсылка - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Закупка ссылка
//  ДокументЗаказКлиентаОбъект - ДокументОбъект.ЗаказКлиента - Документ ЗаказКлиента
// 
// Возвращаемое значение:
//  СправочникОбъект.СделкиСКлиентами - Заполнить справочник сделки с клиентами
Функция ЗаполнитьДокументЗаказКлиента(ОбработкаЗакупкиСсылка, ДокументЗаказКлиентаОбъект)
	
	// Инициализация заказа клиента
	ДокументЗаказКлиентаОбъект.Заполнить(Неопределено);
	
	Партнер = Неопределено;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик.ИНН КАК ОрганизаторЗаказчикИНН,
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик.КПП КАК ОрганизаторЗаказчикКПП,
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик.ПолноеНаименование КАК
	|		ОрганизаторЗаказчикПолноеНаименование
	|ИЗ
	|	Документ.КонтурЗакупки_ОбработкаЗакупки.ОрганизаторыЗаказчики КАК КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики
	|ГДЕ
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ЭтоОрганизатор
	|	И КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ОбработкаЗакупкиСсылка);

	Выборка = Запрос.Выполнить().Выбрать();

	ОрганизаторНаименование = "";
	ОрганизаторИНН = "";
	ОрганизаторКПП = "";
	Если Выборка.Следующий() Тогда
		ОрганизаторНаименование = Выборка.ОрганизаторЗаказчикПолноеНаименование;
		ОрганизаторИНН = Выборка.ОрганизаторЗаказчикИНН;
		ОрганизаторКПП = Выборка.ОрганизаторЗаказчикКПП;
	КонецЕсли;

	Контрагент = ПолучитьКонтрагента(ОрганизаторИНН, ОрганизаторКПП);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Партнер = Контрагент.Партнер;
	КонецЕсли;

	Если Истина Тогда
		СтруктураПартнера = Новый Структура;
		СтруктураПартнера.Вставить("Комментарий", НСтр("ru = '#Создан автоматически из закупки'"));

		СтруктураПартнера.Вставить("НаименованиеПолное", ОрганизаторНаименование);
		СтруктураПартнера.Вставить("Наименование", ОрганизаторНаименование);
		СтруктураПартнера.Вставить("ДатаРегистрации", ТекущаяДатаСеанса());
		СтруктураПартнера.Вставить("ПрочиеОтношения", Истина);
		СтруктураПартнера.Вставить("ЮрФизЛицо", Перечисления.КомпанияЧастноеЛицо.Компания);

		СтруктураКонтактнаяИнформацияПартнера = Новый Структура;
		Если Не ПустаяСтрока(ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеТелефон) Тогда
			СтруктураКонтактнаяИнформацияПартнера.Вставить("ТелефонКонтактногоЛица",
				ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеТелефон);
		КонецЕсли;
		Если Не ПустаяСтрока(ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеЭлектроннаяПочта) Тогда
			СтруктураКонтактнаяИнформацияПартнера.Вставить("EmailКонтактногоЛица",
				ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеЭлектроннаяПочта);
		КонецЕсли;
		Если Не ПустаяСтрока(ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеИмя) Тогда
			СтруктураКонтактнаяИнформацияПартнера.Вставить("КонтактноеЛицо",
				ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеИмя);
		КонецЕсли;
		СтруктураПартнера.Вставить("КонтактнаяИнформация", СтруктураКонтактнаяИнформацияПартнера);

		Партнер = НайтиСоздатьПартнера(СтруктураПартнера);
	КонецЕсли;

	ДокументЗаказКлиентаОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ДокументЗаказКлиентаОбъект.Контрагент = Контрагент;
	ДокументЗаказКлиентаОбъект.Партнер = Партнер;
	ДокументЗаказКлиентаОбъект.Дата = ТекущаяДатаСеанса();
	ДокументЗаказКлиентаОбъект.Валюта = ПолучитьВалютуПоСимвКоду(?(Не ПустаяСтрока(
		ОбработкаЗакупкиСсылка.ДокументОснования.Валюта), ОбработкаЗакупкиСсылка.ДокументОснования.Валюта, "RUB"));
	ДокументЗаказКлиентаОбъект.Комментарий = СтрШаблон(
			НСтр("ru = '#Создано автоматически на основании закупки %1 от %2'"),
		ОбработкаЗакупкиСсылка.ДокументОснования.НомерЗакупки, Формат(
		ОбработкаЗакупкиСсылка.ДокументОснования.ДатаСозданияЗакупки, "ДЛФ=DDT"));
	ЗаполнитьДокументЗаказКлиента_Товары(ОбработкаЗакупкиСсылка, ДокументЗаказКлиентаОбъект);

	Возврат ДокументЗаказКлиентаОбъект;
КонецФункции

Процедура ЗаполнитьДокументЗаказКлиента_Товары(ОбработкаЗакупкиСсылка, ЗаказКлиентаОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.Номенклатура,
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.СуммаПродажи КАК Сумма,
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ЦенаПродажи КАК Цена,
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.Количество КАК КоличествоУпаковок,
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.Упаковка КАК Упаковка
	|ИЗ
	|	Документ.КонтурЗакупки_ОбработкаЗакупки.ОбъектыЗакупки КАК КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки
	|ГДЕ
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.Ссылка = &Ссылка
	|	И КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ПозицияВыиграна";

	Запрос.УстановитьПараметр("Ссылка", ОбработкаЗакупкиСсылка);

	ЗаказКлиентаОбъект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСделки

// Заполнить справочник сделки с клиентами.
// 
// Параметры:
//  ОбработкаЗакупкиСсылка - ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Закупка ссылка
//  СправочникСделкиСКлиентамиОбъект - СправочникОбъект.СделкиСКлиентами - Справочник сделки с клиентами объект
// 
// Возвращаемое значение:
//  СправочникОбъект.СделкиСКлиентами - Заполнить справочник сделки с клиентами
Функция ЗаполнитьСправочникСделкиСКлиентами(ОбработкаЗакупкиСсылка, СправочникСделкиСКлиентамиОбъект)
	Партнер = Неопределено;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик.ИНН КАК ОрганизаторЗаказчикИНН,
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик.КПП КАК ОрганизаторЗаказчикКПП,
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик.ПолноеНаименование КАК
	|		ОрганизаторЗаказчикПолноеНаименование
	|ИЗ
	|	Документ.КонтурЗакупки_ОбработкаЗакупки.ОрганизаторыЗаказчики КАК КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики
	|ГДЕ
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ЭтоОрганизатор
	|	И КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ОбработкаЗакупкиСсылка);

	Выборка = Запрос.Выполнить().Выбрать();

	ОрганизаторНаименование = "";
	ОрганизаторИНН = "";
	ОрганизаторКПП = "";
	Если Выборка.Следующий() Тогда
		ОрганизаторНаименование = Выборка.ОрганизаторЗаказчикПолноеНаименование;
		ОрганизаторИНН = Выборка.ОрганизаторЗаказчикИНН;
		ОрганизаторКПП = Выборка.ОрганизаторЗаказчикКПП;
	КонецЕсли;

	Контрагент = ПолучитьКонтрагента(ОрганизаторИНН, ОрганизаторКПП);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Партнер = Контрагент.Партнер;
	КонецЕсли;

	Если Истина Тогда
		СтруктураПартнера = Новый Структура;
		СтруктураПартнера.Вставить("Комментарий", НСтр("ru = '#Создан автоматически из закупки'"));

		СтруктураПартнера.Вставить("НаименованиеПолное", ОрганизаторНаименование);
		СтруктураПартнера.Вставить("Наименование", ОрганизаторНаименование);
		СтруктураПартнера.Вставить("ДатаРегистрации", ТекущаяДатаСеанса());
		СтруктураПартнера.Вставить("ПрочиеОтношения", Истина);
		СтруктураПартнера.Вставить("ЮрФизЛицо", Перечисления.КомпанияЧастноеЛицо.Компания);

		СтруктураКонтактнаяИнформацияПартнера = Новый Структура;
		Если Не ПустаяСтрока(ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеТелефон) Тогда
			СтруктураКонтактнаяИнформацияПартнера.Вставить("ТелефонКонтактногоЛица",
				ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеТелефон);
		КонецЕсли;
		Если Не ПустаяСтрока(ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеЭлектроннаяПочта) Тогда
			СтруктураКонтактнаяИнформацияПартнера.Вставить("EmailКонтактногоЛица",
				ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеЭлектроннаяПочта);
		КонецЕсли;
		Если Не ПустаяСтрока(ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеИмя) Тогда
			СтруктураКонтактнаяИнформацияПартнера.Вставить("КонтактноеЛицо",
				ОбработкаЗакупкиСсылка.ДокументОснования.КонтактныеДанныеИмя);
		КонецЕсли;
		СтруктураПартнера.Вставить("КонтактнаяИнформация", СтруктураКонтактнаяИнформацияПартнера);

		Партнер = НайтиСоздатьПартнера(СтруктураПартнера);
	КонецЕсли;

	СправочникСделкиСКлиентамиОбъект.Партнер = Партнер;
	СправочникСделкиСКлиентамиОбъект.Статус = Перечисления.СтатусыСделок.ВРаботе;
	СправочникСделкиСКлиентамиОбъект.Комментарий = СтрШаблон(
			НСтр("ru = '#Создано автоматически на основании закупки %1 от %2'"),
		ОбработкаЗакупкиСсылка.ДокументОснования.НомерЗакупки, Формат(
		ОбработкаЗакупкиСсылка.ДокументОснования.ДатаСозданияЗакупки, "ДЛФ=DDT"));
	СправочникСделкиСКлиентамиОбъект.Наименование = ОбработкаЗакупкиСсылка.ДокументОснования.ИмяОписаниеЗакупки;
	СправочникСделкиСКлиентамиОбъект.ВалютаПервичногоСпроса = ПолучитьВалютуПоСимвКоду(?(Не ПустаяСтрока(
		ОбработкаЗакупкиСсылка.ДокументОснования.Валюта), ОбработкаЗакупкиСсылка.ДокументОснования.Валюта, "RUB"));
	ЗаполнитьПервичныйСпрос(ОбработкаЗакупкиСсылка, СправочникСделкиСКлиентамиОбъект);

	Возврат СправочникСделкиСКлиентамиОбъект;
КонецФункции

Процедура ЗаполнитьПервичныйСпрос(ОбработкаЗакупкиСсылка, СделкаОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.НаименованиеОбъектаЗакупки = """"
	|			ТОГДА КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.НаименованиеОбъектаЗакупки
	|		ИНАЧЕ ВЫБОР
	|			КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКПД2Код = """"
	|				ТОГДА КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКПД2Расшифровка
	|			ИНАЧЕ """"
	|		КОНЕЦ + ВЫБОР
	|			КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.КТРУКод = """"
	|				ТОГДА КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.КТРУРасшифровка
	|			ИНАЧЕ """"
	|		КОНЕЦ + ВЫБОР
	|			КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКВЭД2Код = """"
	|				ТОГДА КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКВЭД2Расшифровка
	|			ИНАЧЕ """"
	|		КОНЕЦ
	|	КОНЕЦ КАК ТекстовоеОписание,
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОбщаяСтоимостьОбъекта КАК Сумма,
	|	ВЫБОР
	|		КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКПД2Код = """"
	|			ТОГДА ""ОКПД2 "" + КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКПД2Код + "" "" +
	|				КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКПД2Расшифровка + "" | ""
	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.КТРУКод = """"
	|			ТОГДА ""КТРУ "" + КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.КТРУКод + "" "" +
	|				КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.КТРУРасшифровка + "" | ""
	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА НЕ КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКВЭД2Код = """"
	|			ТОГДА ""ОКВЭД2 "" + КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКВЭД2Код + "" "" +
	|				КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ОКВЭД2Расшифровка
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Комментарий
	|ИЗ
	|	Документ.КонтурЗакупки_ОбработкаЗакупки.ОбъектыЗакупки КАК КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки
	|ГДЕ
	|	КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.Ссылка = &Ссылка
	|	И КонтурЗакупки_ОбработкаЗакупкиТабличнаяЧастьОбъектыЗакупки.ПозицияВыиграна";

	Запрос.УстановитьПараметр("Ссылка", ОбработкаЗакупкиСсылка);

	СделкаОбъект.ПервичныйСпрос.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Функция ПолучитьВалютуПоСимвКоду(СимвКод)
	ВозвратВалюта = Справочники.Валюты.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Наименование = &Наименование";

	Запрос.УстановитьПараметр("Наименование", СимвКод);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВозвратВалюта = Выборка.Ссылка;
	КонецЕсли;

	Возврат ВозвратВалюта;

КонецФункции

Функция НайтиСоздатьПартнера(СтруктураПартнера)
	// обрежем, наименование, что бы искать по полному и не создать дубликат
	ВозвратПартнер = ПолучитьПартнера(Лев(СтруктураПартнера.НаименованиеПолное, 250));
	Если ЗначениеЗаполнено(ВозвратПартнер) Тогда
		НовПартнер = ВозвратПартнер.ПолучитьОбъект();
	Иначе
		НовПартнер = Справочники["Партнеры"].СоздатьЭлемент();
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(НовПартнер, СтруктураПартнера);

	Попытка
		НовПартнер.Записать();
		ВозвратПартнер = НовПартнер.Ссылка;
	Исключение
	КонецПопытки;

	СтруктураКИ = СтруктураПартнера.КонтактнаяИнформация;

	Если ЗначениеЗаполнено(ВозвратПартнер) И СтруктураКИ.Количество() > 0 Тогда
		НовоеКЛ = Справочники["КонтактныеЛицаПартнеров"].СоздатьЭлемент();
		НовоеКЛ.Владелец = ВозвратПартнер;

		Если СтруктураКИ.Свойство("КонтактноеЛицо") Тогда
			НовоеКЛ.Наименование = СтруктураПартнера.КонтактнаяИнформация["КонтактноеЛицо"];
		Иначе
			НовоеКЛ.Наименование = "Не указано";
		КонецЕсли;

		ЕстьОМ_УКИ = Истина;

		Попытка
			ОМУправлениеКонтактнойИнформацией = КонтурЗакупки_ОбщегоНазначения.ОбщийМодуль(
			"УправлениеКонтактнойИнформацией");
		Исключение
			ЕстьОМ_УКИ = Ложь;
		КонецПопытки;

		Если ЕстьОМ_УКИ Тогда
			Если СтруктураКИ.Свойство("ТелефонКонтактногоЛица") Тогда
				ОМУправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(НовоеКЛ,
					СтруктураКИ["ТелефонКонтактногоЛица"],
					Справочники["ВидыКонтактнойИнформации"].ТелефонКонтактногоЛица);
			КонецЕсли;

			Если СтруктураКИ.Свойство("EmailКонтактногоЛица") Тогда
				ОМУправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(НовоеКЛ,
					СтруктураКИ["EmailКонтактногоЛица"], Справочники["ВидыКонтактнойИнформации"].EmailКонтактногоЛица);
			КонецЕсли;

		КонецЕсли;
		НовоеКЛ.Записать();
