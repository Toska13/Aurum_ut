// Http получить данные поиска.
// 
// Параметры:
//  СтруктураПоиска - Структура - Структура поиска
// 
// Возвращаемое значение:
//   См. КонтурЗакупки_СтруктурыКлиентСервер.ИнициализироватьРезультатФункции
Функция http_ПолучитьДанныеПоиска(СтруктураПоиска) Экспорт

	РезультатHTTPЗапроса = Неопределено;
	ПараметрыHTTPЗапроса = КонтурЗакупки_httpСтруктураВызовСервера.api_ПолучитьДанныеПоиска(СтруктураПоиска);

	Если Не ПараметрыHTTPЗапроса = Неопределено Тогда

		ПолныйПутьЗапроса = ПараметрыHTTPЗапроса["АдресСервера"] + ПараметрыHTTPЗапроса["СтрокаПодключения"];
		ОписаниеДействия = КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьОписаниеДействия("search", "Поиск закупок",
			ПолныйПутьЗапроса, ПараметрыHTTPЗапроса["ТелоЗапроса"]);

		ОтключитьЛог = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки("ОтключитьЛог", Ложь);
		Если Не ОтключитьЛог Тогда
			КонтурЗакупки_СлужебныеВызовСервера.ДобавитьЛог(
				КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьПрефиксПродукта(), ПолныйПутьЗапроса);
		КонецЕсли;

		РезультатHTTPЗапроса = КонтурЗакупки_httpКлиентСервер.ВыполнитьHTTPЗапросСМетрикой(ПараметрыHTTPЗапроса,
			ОписаниеДействия);

	КонецЕсли;

	Возврат РезультатHTTPЗапроса;

КонецФункции

