#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаголовокУведомления = Параметры.Заголовок;
	Текст = Параметры.Текст;
	Идентификатор = Параметры.Идентификатор;
	Прочитано = Параметры.Прочитано;//РегистрыСведений.КонтурЗакупки_УведомленияЛентаПользователя.Прочитано(Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УправлениеВидимостьюДоступностью();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитаноНеПрочитано(Команда)

	ПрочитаноНеПрочитаноНаСервере();
	УправлениеВидимостьюДоступностью();
	СтруктураПараметров = Новый Структура("Идентификатор, Прочитано", Идентификатор, Прочитано);
	Оповестить("КонтурУведомленияПрочитаноНеПрочитано", СтруктураПараметров);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитаноНеПрочитаноНаСервере()
	НазваниеПродукта = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьНазваниеПродукта();

	Если РегистрыСведений.КонтурЗакупки_УведомленияЛентаПользователя.ОтметитьПрочитаннымОтложить(НазваниеПродукта,
		Идентификатор, Не Прочитано) Тогда
		Прочитано = Не Прочитано;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюДоступностью()

	Если Прочитано Тогда
		Элементы.ПрочитаноНеПрочитано.Заголовок = "Отметить непрочитанным";
		Элементы.ПрочитаноНеПрочитано.ЦветФона = WebЦвета.Белый;
	Иначе
		Элементы.ПрочитаноНеПрочитано.Заголовок = "Прочитано";
		Элементы.ПрочитаноНеПрочитано.ЦветФона = WebЦвета.Золотой;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти