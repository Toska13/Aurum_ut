<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Ссылки</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаЗагрузки</dataPath>
			<field>ДатаЗагрузки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Закупка</dataPath>
			<field>Закупка</field>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:DocumentRef.КонтурЗакупки_Закупка</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВебСсылка</dataPath>
			<field>ВебСсылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Веб-ссылка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдентификаторЗакупки</dataPath>
			<field>ИдентификаторЗакупки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>ID закупки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗакупкаНомер</dataPath>
			<field>ЗакупкаНомер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗакупкаДата</dataPath>
			<field>ЗакупкаДата</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	МАКСИМУМ(РезультатыЗакупок.Ссылка) КАК Ссылка,
	МАКСИМУМ(РезультатыЗакупок.ДатаЗагрузки) КАК ДатаЗагрузки,
	РезультатыЗакупок.Закупка КАК Закупка,
	РезультатыЗакупок.Закупка.Номер КАК ЗакупкаНомер,
	РезультатыЗакупок.Закупка.Дата КАК ЗакупкаДата,
	РезультатыЗакупок.ВебСсылка КАК ВебСсылка,
	РезультатыЗакупок.Наименование КАК ИдентификаторЗакупки
ИЗ
	Справочник.КонтурЗакупки_РезультатыЗакупок КАК РезультатыЗакупок
ГДЕ
	РезультатыЗакупок.Закупка В(&amp;Закупка)
	И НЕ РезультатыЗакупок.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	РезультатыЗакупок.ВебСсылка,
	РезультатыЗакупок.Закупка,
	РезультатыЗакупок.Наименование</query>
	</dataSet>
