	<calculatedField>
		<dataPath>КонтрактЭтап</dataPath>
		<expression>ВЫБОР КОГДА КонтрактЭтап = 0 ТОГДА "Исполняется" КОГДА КонтрактЭтап = 1 ТОГДА "Исполнен" КОГДА КонтрактЭтап = 2 ТОГДА "Прекращен" КОГДА КонтрактЭтап = 3 ТОГДА "Истек срок исполнения" ИНАЧЕ "Аннулирован" КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Этап</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>УчастникРезультатРассмотрения</dataPath>
		<expression>ВЫБОР КОГДА УчастникРезультатРассмотрения = ИСТИНА ТОГДА "Соответствует" ИНАЧЕ "Не соответствует" КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Участник результат рассмотрения</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>УчастникЯвляетсяПобедителем</dataPath>
		<expression>ВЫБОР КОГДА УчастникЯвляетсяПобедителем = ИСТИНА ТОГДА "Победитель" ИНАЧЕ "Проигравший" КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Участник является победителем</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КодыОКВЭД2</dataPath>
		<expression>СоединитьСтроки(Массив(ОКВЭД2КодРасшифровка), ";", "")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Коды ОКВЭД2</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КодыОКПД2</dataPath>
		<expression>СоединитьСтроки(Массив(ОКПД2КодРасшифровка), ";", "")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Коды ОКПД2</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КодыКТРУ</dataPath>
		<expression>СоединитьСтроки(Массив(КТРУКодРасшифровка), ";", "")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Коды КТРУ</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КонтрактЦена</dataPath>
		<expression>Формат(КонтрактЦена, "ЧДЦ=2")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Контракт цена</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
