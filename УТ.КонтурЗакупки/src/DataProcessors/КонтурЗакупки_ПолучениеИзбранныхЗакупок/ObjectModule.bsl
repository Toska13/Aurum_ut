#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ПрограммныйИнтерфейс

// Получить избранные.
// 
// Параметры:
//  СтраницаЗначение - Число -  Страница значение
//  ОписаниеРезультата - Строка -  Описание результата
// 
// Возвращаемое значение:
//  Булево -  Получить избранные
Функция ПолучитьИзбранные(СтраницаЗначение = 1, ОписаниеРезультата = "") Экспорт
	Результат = Истина;
	ИзбранныеЗакупки.Очистить();

	СтруктураПоиска = ПолучитьСтруктуруПоиска(СтраницаЗначение);

	РезультатHTTPЗапроса = КонтурЗакупки_httpЗапросыКлиентСервер.http_ПолучитьИзбранныеЗакупки(СтруктураПоиска);
	Если Не РезультатHTTPЗапроса = Неопределено Тогда
		Если Не РезультатHTTPЗапроса["data"] = Неопределено Тогда
			ДанныеПоиска = РезультатHTTPЗапроса["data"];
			ЗаполнитьТабличнуюЧастьРезультата(ДанныеПоиска);
		ИначеЕсли Не РезультатHTTPЗапроса["error"] = Неопределено И РезультатHTTPЗапроса["error"] = Истина Тогда
			Результат = Ложь;
			ОписаниеРезультата = ОписаниеРезультата + СтрШаблон(
			 НСтр("ru = 'Ошибка: %1'"), РезультатHTTPЗапроса["message"]) + Символы.ПС;
		КонецЕсли;
	Иначе
		Результат = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Ошибка'") + Символы.ПС;
	КонецЕсли;

	Возврат Результат
КонецФункции

// Получить структуру поиска.
// 
// Параметры:
//  СтраницаЗначение - Число - Значение Страница
// 
// Возвращаемое значение:
//  Соответствие из Строка - Получить структуру поиска
Функция ПолучитьСтруктуруПоиска(СтраницаЗначение = 1) Экспорт
	МассивМеток = Метки.Выгрузить( , "Метка").ВыгрузитьКолонку("Метка");
	Результат = Новый Соответствие;

	Результат.Вставить("markersNames", ?(МассивМеток.Количество() > 0, МассивМеток, Неопределено));

	Если ЗначениеЗаполнено(КонецПериода) Тогда
		ДатаПо = КонтурЗакупки_СлужебныеВызовСервера.ПолучитьУниверсальнуюДатуВремяСтрокой(КонецДня(КонецПериода),
			ЧасовойПоясСеанса());
	Иначе
		ДатаПо = Неопределено;
	КонецЕсли;

	Результат.Вставить("dateFrom", КонтурЗакупки_СлужебныеВызовСервера.ПолучитьУниверсальнуюДатуВремяСтрокой(
		НачалоДня(
			НачалоПериода), ЧасовойПоясСеанса()));
	Результат.Вставить("dateTo", ДатаПо);

	Если СтраницаЗначение > 1 Тогда
		Результат.Вставить("page", СтраницаЗначение - 1);
	КонецЕсли;

	Возврат Результат;

КонецФункции
#КонецОбласти
#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьТабличнуюЧастьРезультата(ДанныеПоиска) Экспорт
	ЗаписейВсего = ДанныеПоиска["TotalCount"];
	СтраницаТекущая = ДанныеПоиска["PageNumber"] + 1;

	Если Не ДанныеПоиска["Items"] = Неопределено Тогда
		МассивЗакупок = ДанныеПоиска["Items"];
		Для Каждого ЭлементЗакупка Из МассивЗакупок Цикл

			СтрукРезультата = Новый Структура;
			СтрукРезультата.Вставить("ИдентификаторЗакупки", ЭлементЗакупка["Id"]);
			СтрукРезультата.Вставить("Метка", ПолучитьСоздатьСправочникМетки(ЭлементЗакупка["MarkerName"]));
			СтрукРезультата.Вставить("Загружать", Ложь);
			СтрукЗагружена = КонтурЗакупки_РаботаСЗакупкамиСервер.ЗакупкаЗагружена(
					СтрукРезультата.ИдентификаторЗакупки);
			Для Каждого ЭлСтрукЗагружена Из СтрукЗагружена Цикл
				СтрукРезультата.Вставить(ЭлСтрукЗагружена.Ключ, ЭлСтрукЗагружена.Значение);
			КонецЦикла;

			ЗаполнитьСтрокуРезутьтата(СтрукРезультата);
		КонецЦикла;

		ЗаписейНаСтраницу = Макс(МассивЗакупок.Количество(), 1, ЗаписейНаСтраницу);
	КонецЕсли;

	СтраницВсего = Цел(ЗаписейВсего / ЗаписейНаСтраницу) + ?((ЗаписейВсего % ЗаписейНаСтраницу) > 0, 1, 0);
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

Процедура ВыбратьВсеНеЗагруженныеНаСтранице() Экспорт
	Для Каждого СтрокаТЧ Из ИзбранныеЗакупки Цикл
		Если Не СтрокаТЧ.Загружен Тогда
			СтрокаТЧ.Загружать = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Получить массив идентификаторов закупок на загрузку.
// 
// Возвращаемое значение:
//  Массив из Строка - Массив идентификаторов закупок на загрузку
Функция ПолучитьМассивИдентификаторовЗакупокНаЗагрузку() Экспорт
	МассивИдентификаторовЗакупок = Новый Массив;
	Для Каждого СтрокаИзбранного Из ИзбранныеЗакупки Цикл
		Если СтрокаИзбранного.Загружать Тогда
			МассивИдентификаторовЗакупок.Добавить(СтрокаИзбранного.ИдентификаторЗакупки);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивИдентификаторовЗакупок;
КонецФункции

Процедура ЗагрузитьЗакупкиПоСписку(ОписаниеРезультата = "") Экспорт
	ОписаниеРезультата = "";
	ОбработкаЗагрузки = Обработки.КонтурЗакупки_ДанныеЗакупки.Создать();
	МассивИдентификаторовЗакупок = ПолучитьМассивИдентификаторовЗакупокНаЗагрузку();
	Для Каждого ИдентификаторЗакупки Из МассивИдентификаторовЗакупок Цикл
		ОбработкаЗагрузки.ИдентификаторЗакупки = ИдентификаторЗакупки;
		ОбработкаЗагрузки.ПолучитьДанныеЗакупки(,ОписаниеРезультата);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоискПоШаблону() Экспорт
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ШаблонЗагрузки);
	Метки.Загрузить(ШаблонЗагрузки.Метки.Выгрузить());
	НачалоПериода = КонтурЗакупки_СлужебныеКлиентСервер.ДобавитьДней(КонецПериода, -1 * КоличествоДнейДоТекущейДаты);
КонецПроцедуры

Функция ПолучитьСоздатьСправочникМетки(НаименованиеМетки)
	СпрМеткаПоИмени = Справочники.КонтурЗакупки_Метки.НайтиПоНаименованию(НаименованиеМетки, Истина);
	Если СпрМеткаПоИмени.Пустая() Тогда
		СпрОбъект = Справочники.КонтурЗакупки_Метки.СоздатьЭлемент();
		СпрОбъект.Наименование = НаименованиеМетки;
		СпрОбъект.Записать();
		СпрМеткаПоИмени = СпрОбъект.Ссылка;
	КонецЕсли;

	Возврат СпрМеткаПоИмени;
КонецФункции

Процедура ОбновитьПризнакиЗагрузкиИСсылки() Экспорт
	Для Каждого СтрокаЗакупки Из ИзбранныеЗакупки Цикл
		СтрукЗагружена = КонтурЗакупки_РаботаСЗакупкамиСервер.ЗакупкаЗагружена(СтрокаЗакупки.ИдентификаторЗакупки);
		ЗаполнитьЗначенияСвойств(СтрокаЗакупки, СтрукЗагружена);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьСтрокуРезутьтата(СтрукРезультата)
	НовСтр = ИзбранныеЗакупки.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр, СтрукРезультата);
КонецПроцедуры
#КонецОбласти
#КонецЕсли