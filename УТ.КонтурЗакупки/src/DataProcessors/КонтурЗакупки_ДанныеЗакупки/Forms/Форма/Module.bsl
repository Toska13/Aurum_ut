#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.ИдентификаторЗакупки = Параметры.ИдентификаторЗакупки;
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьДанные(Команда)
	ПолучитьДанныеНаКлиенте();
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СоздатьОбновитьДокументНаСервере(ДанныеДокументаСоответствие, ОписаниеРезультата)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.СоздатьОбновитьДокумент(ДанныеДокументаСоответствие, ,ОписаниеРезультата);
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеЗакупкиНаКлиенте(ОписаниеРезультата = "")
	Результат = Истина;
	РезультатHTTPЗапроса = КонтурЗакупки_httpЗапросыКлиентСервер.http_ПолучитьДанныеЗакупки(Объект.ИдентификаторЗакупки);
	Если Не РезультатHTTPЗапроса = Неопределено Тогда
		Если Не РезультатHTTPЗапроса["data"] = Неопределено Тогда
			ДанныеДокументаСоответствие = РезультатHTTPЗапроса["data"];
			Результат = СоздатьОбновитьДокументНаСервере(ДанныеДокументаСоответствие, ОписаниеРезультата);
		ИначеЕсли Не РезультатHTTPЗапроса["error"] = Неопределено И РезультатHTTPЗапроса["error"] = Истина Тогда
			Результат = Ложь;
			ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Ошибка:'") + " " + РезультатHTTPЗапроса["message"]
				+ Символы.ПС;
		КонецЕсли;
	Иначе
		Результат = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Ошибка'") + Символы.ПС;
	КонецЕсли;

	Возврат Результат
КонецФункции

&НаКлиенте
Процедура ПолучитьДанныеНаКлиенте() Экспорт
	ОписаниеРезультата = "";
	Если Не ПолучитьДанныеЗакупкиНаКлиенте(ОписаниеРезультата) Тогда
		КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеРезультата);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти