#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновлениеСчетчиковНаСервере()
	// структура
	// ключ - название счетчика и реквизита формы
	// значение - представление счетчика
	СтруктураСчетчиков = Новый Структура;
	СтруктураСчетчиков.Вставить("СчетчикЗадачОбработкаЗакупок", "-");

	Обработки.КонтурЗакупки_РабочийСтол.ОбновитьСчетчики(СтруктураСчетчиков, ПараметрыСеанса.ТекущийПользователь,
		КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.ПолучитьРольПользователя());
	Если ТипЗнч(СтруктураСчетчиков) = Тип("Структура") Тогда
		Для Каждого Счетчик Из СтруктураСчетчиков Цикл
			Если Не Элементы.Найти(Счетчик.Ключ) = Неопределено Тогда
				ЭтотОбъект[Счетчик.Ключ] = Счетчик.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуУведомленийПриНеобходимости(ПервыйЗапуск, ИнформацияПоУведомлениям)

	Если ПервыйЗапуск И ИнформацияПоУведомлениям.ЕстьНепрочитанные Или ЗначениеЗаполнено(
			ИнформацияПоУведомлениям.ИдентификаторВажногоНепрочитанного) Тогда
		НазваниеПроекта = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьНазваниеПродукта();
		ВерсияМодуля = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьВерсиюПродукта();
		ИДКлиента = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьClientID();

		ПараметрыФормыУведомлений = Новый Структура;
		ПараметрыФормыУведомлений.Вставить("ОтборПрочитано", 1);
		ПараметрыФормыУведомлений.Вставить("НазваниеПроекта", НазваниеПроекта);
		ПараметрыФормыУведомлений.Вставить("ВерсияПроекта", ВерсияМодуля);
		ПараметрыФормыУведомлений.Вставить("ИДКлиента", ИДКлиента);
		Если ЗначениеЗаполнено(ИнформацияПоУведомлениям.ИдентификаторВажногоНепрочитанного) Тогда
			ПараметрыФормыУведомлений.Вставить("ИдентификаторПозиционирования",
				ИнформацияПоУведомлениям.ИдентификаторВажногоНепрочитанного);
		КонецЕсли;

		ОткрытьФорму("РегистрСведений.КонтурЗакупки_УведомленияЛентаПользователя.ФормаСписка",
			ПараметрыФормыУведомлений, , , , , , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияОткрытьФормуУведомленийПриЗапуске()
	ИнформацияПоУведомлениям = ИнформацияПоУведомлениям(Истина);
	ОткрытьФормуУведомленийПриНеобходимости(Истина, ИнформацияПоУведомлениям);

	ПодключитьОбработчикОжидания("ОбработчикОжиданияОткрытьФормуУведомленийПриПоявленииВажного", 600, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияОткрытьФормуУведомленийПриПоявленииВажного()

	ИнформацияПоУведомлениям = ИнформацияПоУведомлениям(Истина);
	ОткрытьФормуУведомленийПриНеобходимости(Ложь, ИнформацияПоУведомлениям);

КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюДоступностьюВиджетаУведомлений()

	ИнформацияПоУведомлениям = ИнформацияПоУведомлениям(Ложь);

	Если ИнформацияПоУведомлениям.ЕстьНепрочитанные Тогда

		Элементы.ОткрытьФормуУведомлений.Картинка = БиблиотекаКартинок.КонтурЗакупки_УведомленияВнимание;
		Элементы.ОткрытьФормуУведомлений.Заголовок = "У вас есть непрочитанные уведомления";
		Элементы.ОткрытьФормуУведомлений.ЦветТекста = WebЦвета.Красный;

	Иначе

		Элементы.ОткрытьФормуУведомлений.Картинка = БиблиотекаКартинок.КонтурЗакупки_УведомленияОбычный;
		Элементы.ОткрытьФормуУведомлений.Заголовок = "Уведомления";
		Элементы.ОткрытьФормуУведомлений.ЦветТекста = Новый Цвет(51, 51, 51);

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнформацияПоУведомлениям(УчитыватьИнтервалОтложенных)
	НазваниеПроекта = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьНазваниеПродукта();
	ВерсияПроекта = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьВерсиюПродукта();
	ИДКлиента = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьClientID();

	Инфо = РегистрыСведений.КонтурЗакупки_УведомленияЛентаПользователя.ИнформацияПоУведомлениям(
		НазваниеПроекта, ВерсияПроекта, ИДКлиента, УчитыватьИнтервалОтложенных);
	Возврат Инфо;

КонецФункции

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементовФормы()
	
	ЭтоАдминистратор = РольДоступна("КонтурЗакупки_Администратор") Или РольДоступна("АдминистраторСистемы");
	
	Элементы.ВсеФункцииПодменюНастройки.Видимость = ЭтоАдминистратор;
	Элементы.ПодменюНастройки.Видимость = ЭтоАдминистратор;
	
КонецПроцедуры

#КонецОбласти