#Область СлужебныйПрограммныйИнтерфейс
// Обновить признак загрузки и ссылку.
Процедура ОбновитьПризнакиЗагрузкиИСсылки() Экспорт
	Для Каждого СтрокаЗакупки Из РезультатыПоиска Цикл
		СтруктураЗагружена = КонтурЗакупки_РаботаСЗакупкамиСервер.ЗакупкаЗагружена(
				СтрокаЗакупки.ИдентификаторЗакупки);
		ЗаполнитьЗначенияСвойств(СтрокаЗакупки, СтруктураЗагружена);
		СтрокаЗакупки.Загружать = ЗакупкаНаЗагрузку(СтрокаЗакупки.ИдентификаторЗакупки);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеЗаказчиковПоМассивуИНН(МассивИНН)
	
	Результат = "";
	
	КоличествоИНН = МассивИНН.Количество();
	
	Для Индекс = 0 По КоличествоИНН - 1 Цикл
		
		ИНН = МассивИНН[Индекс];
		ПараметрыОтбора = Новый Структура("ИНН", ИНН);
		НайденныеСтроки = Заказчики.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			МассивИНН[Индекс] = СтрШаблон("%1 (%2)", НайденныеСтроки[0].Наименование, ИНН);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = СтрСоединить(МассивИНН, ", ");
	
	Возврат Результат;
	
КонецФункции

Функция ИзменитьТегиНазванияЗакупкиИСниппетов(НазваниеЗакупки, ЗаменяемыйСимвол = "")
	НазваниеЗакупкиБезТегов = НазваниеЗакупки;

	НазваниеЗакупкиБезТегов = СтрЗаменить(НазваниеЗакупкиБезТегов, "[b]", ЗаменяемыйСимвол);
	НазваниеЗакупкиБезТегов = СтрЗаменить(НазваниеЗакупкиБезТегов, "[/b]", ЗаменяемыйСимвол);

	Возврат НазваниеЗакупкиБезТегов;
КонецФункции

Функция ЗакупкаНаЗагрузку(ИДЗакупки)
	СтрукОтбор = Новый Структура("ИдентификаторЗакупки", ИДЗакупки);

	МассивСтрок = ЗакупкиНаЗагрузку.НайтиСтроки(СтрукОтбор);

	Возврат МассивСтрок.Количество() > 0;
КонецФункции

Процедура ЗаполнитьСтрокуРезутьтата(СтрукРезультата)
	НовСтр = РезультатыПоиска.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр, СтрукРезультата);
	Если Не СтрукРезультата["МассивСниппеты"] = Неопределено Тогда
		Для Каждого Сниппет Из СтрукРезультата["МассивСниппеты"] Цикл
			НовСтрСниппеты = Сниппеты.Добавить();
			НовСтрСниппеты.ИдентификаторЗакупки = СтрукРезультата.ИдентификаторЗакупки;
			НовСтрСниппеты.Сниппет = Сниппет;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьЗаписьРегистраСоханенныеРезультатыПоиска(СтрукРезультата)
	Набор = РегистрыСведений.КонтурЗакупки_СохраненныеРезультатыПоиска.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗакупки.Установить(СтрукРезультата.ИдентификаторЗакупки, Истина);
	НовЗапись = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(НовЗапись, СтрукРезультата);
	Набор.Записать();
КонецПроцедуры

