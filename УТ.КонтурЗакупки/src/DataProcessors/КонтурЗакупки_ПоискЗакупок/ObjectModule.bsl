#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ПрограммныйИнтерфейс

// Найти закупки.
// 
// Параметры:
//  СтраницаЗначение - Число -  Страница значение
//  ОписаниеРезультата - Строка -  Возврат описание результата
// 
// Возвращаемое значение:
//  Булево -  Результат найти закупки
Функция НайтиЗакупки(СтраницаЗначение = 1, ОписаниеРезультата = "") Экспорт
	Результат = Истина;
	РезультатыПоиска.Очистить();

	СтруктураПоиска = ПолучитьСтруктуруПоиска(СтраницаЗначение);


	РезультатHTTPЗапроса = КонтурЗакупки_httpЗапросыКлиентСервер.http_ПолучитьДанныеПоиска(СтруктураПоиска);
	Если Не РезультатHTTPЗапроса = Неопределено Тогда
		Если Не РезультатHTTPЗапроса["data"] = Неопределено Тогда
			ДанныеПоиска = РезультатHTTPЗапроса["data"];
			ЗаполнитьТабличнуюЧастьРезультата(ДанныеПоиска);
		ИначеЕсли Не РезультатHTTPЗапроса["error"] = Неопределено И РезультатHTTPЗапроса["error"] = Истина Тогда
			Результат = Ложь;
			ОписаниеРезультата = ОписаниеРезультата + СтрШаблон(
			НСтр("ru = 'Ошибка: %1'"), РезультатHTTPЗапроса["message"]) + Символы.ПС;
		КонецЕсли;
	Иначе
		Результат = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Ошибка'") + Символы.ПС;
	КонецЕсли;

	Возврат Результат
КонецФункции

// Заполнить поиск по шаблону.
Процедура ЗаполнитьПоискПоШаблону() Экспорт

	СписокИгнорируемыхРеквизитов = "Отрасли, ОтраслиОбновленные, Заказчики, Площадки, Регионы";

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ШаблонПоиска, , СписокИгнорируемыхРеквизитов);
	Если ШаблонПоиска.ТипТорговКоммерческиеИМалые Тогда
		ТипТорговКоммерческие = Истина;
		ТипТорговМалые = Истина;
	КонецЕсли;

	ОписаниеТипаСтрока10 = Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(10));

	ТЗШаблона = ШаблонПоиска.Заказчики.Выгрузить();
	Если ТЗШаблона.Колонки.Найти("ДействиеСоСтрокой") = Неопределено Тогда
		ТЗШаблона.Колонки.Добавить("ДействиеСоСтрокой", ОписаниеТипаСтрока10);
	КонецЕсли;
	ТЗШаблона.ЗаполнитьЗначения("Удалить", "ДействиеСоСтрокой");
	Заказчики.Загрузить(ТЗШаблона);

	ТЗШаблона = ШаблонПоиска.Площадки.Выгрузить();
	Если ТЗШаблона.Колонки.Найти("ДействиеСоСтрокой") = Неопределено Тогда
		ТЗШаблона.Колонки.Добавить("ДействиеСоСтрокой", ОписаниеТипаСтрока10);
	КонецЕсли;
	ТЗШаблона.ЗаполнитьЗначения("Удалить", "ДействиеСоСтрокой");
	Площадки.Загрузить(ТЗШаблона);

	ТЗШаблона = ШаблонПоиска.Регионы.Выгрузить();
	Если ТЗШаблона.Колонки.Найти("ДействиеСоСтрокой") = Неопределено Тогда
		ТЗШаблона.Колонки.Добавить("ДействиеСоСтрокой", ОписаниеТипаСтрока10);
	КонецЕсли;
	ТЗШаблона.ЗаполнитьЗначения("Удалить", "ДействиеСоСтрокой");
	Регионы.Загрузить(ТЗШаблона);

	Отрасли.Загрузить(ШаблонПоиска.Отрасли.Выгрузить());
	ОтраслиОбновленные.Загрузить(ШаблонПоиска.ОтраслиОбновленные.Выгрузить());
	НачалоПериода = КонтурЗакупки_СлужебныеКлиентСервер.ДобавитьДней(КонецПериода, -1 * КоличествоДнейДоТекущейДаты);

КонецПроцедуры

// Выбрать все не загруженные на странице.
Процедура ВыбратьВсеНеЗагруженныеНаСтранице() Экспорт
	Для Каждого СтрокаТЧ Из РезультатыПоиска Цикл
		Если Не СтрокаТЧ.Загружен Тогда
			СтрокаТЧ.Загружать = Истина;
			НовСтрокаНаЗагрузку = ЗакупкиНаЗагрузку.Добавить();
			НовСтрокаНаЗагрузку.ИдентификаторЗакупки = СтрокаТЧ.ИдентификаторЗакупки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Получить массив идентификаторов закупок на загрузку.
// 
// Возвращаемое значение:
//  Массив из Строка - Массив идентификаторов закупок на загрузку
Функция ПолучитьМассивИдентификаторовЗакупокНаЗагрузку() Экспорт
	МассивИдентификаторовЗакупок = Новый Массив;
	Для Каждого СтрокаЗакупкиНаЗагрузку Из ЗакупкиНаЗагрузку Цикл
		МассивИдентификаторовЗакупок.Добавить(СтрокаЗакупкиНаЗагрузку.ИдентификаторЗакупки);
	КонецЦикла;
	Возврат МассивИдентификаторовЗакупок;
КонецФункции

// Загрузить закупки по списку.
// 
// Параметры:
//  ОписаниеРезультата - Строка - Возвращает описание результата
Процедура ЗагрузитьЗакупкиПоСписку(ОписаниеРезультата = "") Экспорт
	ОбработкаЗагрузки = Обработки.КонтурЗакупки_ДанныеЗакупки.Создать();
	МассивИдентификаторовЗакупок = ПолучитьМассивИдентификаторовЗакупокНаЗагрузку();
	Для Каждого ИдентификаторЗакупки Из МассивИдентификаторовЗакупок Цикл
		ЗагрузитьЗакупкуПоИдентификатору(ИдентификаторЗакупки, ОбработкаЗагрузки, ОписаниеРезультата);
	КонецЦикла;

	ЗакупкиНаЗагрузку.Очистить();
КонецПроцедуры

// Загрузить закупку по идентификатору.
// 
// Параметры:
//  ИдентификаторЗакупки - Строка - Идентификатор закупки
//  ОбработкаЗагрузки - ОбработкаОбъект.КонтурЗакупки_ДанныеЗакупки -  Обработка загрузки
//  ОписаниеРезультата - Строка - Возвращает описание результата
Процедура ЗагрузитьЗакупкуПоИдентификатору(Знач ИдентификаторЗакупки, Знач ОбработкаЗагрузки = Неопределено,
	ОписаниеРезультата = "") Экспорт
	Если ОбработкаЗагрузки = Неопределено Тогда
		ОбработкаЗагрузки = Обработки.КонтурЗакупки_ДанныеЗакупки.Создать();
	КонецЕсли;
	ОбработкаЗагрузки.ИдентификаторЗакупки = ИдентификаторЗакупки;
	ОбработкаЗагрузки.ПолучитьДанныеЗакупки(,ОписаниеРезультата);
КонецПроцедуры

// Заполнить табличную часть результата.
// 
// Параметры:
//  ДанныеПоиска - ТаблицаЗначений - Данные поиска
Процедура ЗаполнитьТабличнуюЧастьРезультата(ДанныеПоиска) Экспорт
	ЗаписейВсего = ДанныеПоиска["TotalCount"];
	СтраницаТекущая = ДанныеПоиска["PageNumber"] + 1;

	Если Не ДанныеПоиска["Items"] = Неопределено Тогда
		МассивЗакупок = ДанныеПоиска["Items"];
		Для Каждого ЭлементЗакупка Из МассивЗакупок Цикл

			СтрукРезультата = Новый Структура;
			СтрукРезультата.Вставить("ИдентификаторЗакупки", ЭлементЗакупка["Id"]);
			СтрукРезультата.Вставить("НомерЗакупкиНаЭТП", ЭлементЗакупка["NotificationNumber"]);
			СтрукРезультата.Вставить("НазваниеЗакупки", ИзменитьТегиНазванияЗакупкиИСниппетов(
					ЭлементЗакупка["OrderName"]));
			СтрукРезультата.Вставить("СпособОтбора", ЭлементЗакупка["NotificationTypeDesc"]);
			Попытка
				СтрукРезультата.Вставить("ТипЗакупки", Перечисления.КонтурЗакупки_ТипыЗакупки["_" + XMLСтрока(
						ЭлементЗакупка["TypeOfTrading"])]);
			Исключение
				СтрукРезультата.Вставить("ТипЗакупки", Перечисления.КонтурЗакупки_ТипыЗакупки.ПустаяСсылка());
			КонецПопытки;
			СтрукРезультата.Вставить("НМЦ", ЭлементЗакупка["MaxPrice"]);
			СтрукРезультата.Вставить("Валюта", ЭлементЗакупка["Currency"]);
			СтрукРезультата.Вставить("СсылкаНаЭТП", ЭлементЗакупка["EpUri"]);
			СтрукРезультата.Вставить("СсылкаНаКЗ", ЭлементЗакупка["Link"]);
			СтрукРезультата.Вставить("ДатаОкончанияПодачиЗаявок", КонтурЗакупки_СлужебныеВызовСервера.ПолучитьДатуВремяИзСтроки(
					ЭлементЗакупка["ApplicationDeadline"], "GMT+3"));
			СтрукРезультата.Вставить("ЗакупкаОтменена", ЭлементЗакупка["IsCancelled"]);
			СтрукРезультата.Вставить("ДатаПубликации", КонтурЗакупки_СлужебныеВызовСервера.ПолучитьДатуВремяИзСтроки(
					ЭлементЗакупка["CreateDate"], ЧасовойПоясСеанса()));
			СтрукРезультата.Вставить("СпособОтбора", ЭлементЗакупка["NotificationTypeDesc"]);
			Если Не ЭлементЗакупка["DeliveryPlaces"] = Неопределено И ТипЗнч(ЭлементЗакупка["DeliveryPlaces"]) = Тип(
					"Массив") Тогда
				СтрукРезультата.Вставить("МестаПоставки", СтрСоединить(ЭлементЗакупка["DeliveryPlaces"], ","));
			КонецЕсли;
			Если Не ЭлементЗакупка["Inns"] = Неопределено И ТипЗнч(ЭлементЗакупка["Inns"]) = Тип("Массив") Тогда
				//СтрукРезультата.Вставить("ИННЗаказчиковИОрганизаторов", СтрСоединить(ЭлементЗакупка["Inns"], ","));
				СтрукРезультата.Вставить("ИННЗаказчиковИОрганизаторов", ПредставлениеЗаказчиковПоМассивуИНН(ЭлементЗакупка["Inns"]));
			КонецЕсли; 

			Если Не ЭлементЗакупка["Snippets"] = Неопределено И ТипЗнч(ЭлементЗакупка["Snippets"]) = Тип("Массив") Тогда
				СниппетыСтрокой = СтрСоединить(ЭлементЗакупка["Snippets"], ";");
				СниппетыДляОтображения = ИзменитьТегиНазванияЗакупкиИСниппетов(СниппетыСтрокой, "*");

				СтрукРезультата.Вставить("Сниппеты", СниппетыСтрокой);
				СтрукРезультата.Вставить("СниппетыДляОтображения", СниппетыДляОтображения);
				СтрукРезультата.Вставить("МассивСниппеты", ЭлементЗакупка["Snippets"]);
			КонецЕсли;

			Если Не ЭлементЗакупка["Participants"] = Неопределено И ТипЗнч(ЭлементЗакупка["Participants"]) = Тип(
				"Массив") Тогда
				СтрукРезультата.Вставить("Участники", КонтурЗакупки_СлужебныеВызовСервера.СериализаторМассивВСтроку(
					ЭлементЗакупка["Participants"]));
				СтрукРезультата.Вставить("УчастникиКоличество", ЭлементЗакупка["Participants"].Количество());
			КонецЕсли;
			СтрукРезультата.Вставить("ДатаПодведенияИтогов", КонтурЗакупки_СлужебныеВызовСервера.ПолучитьДатуВремяИзСтроки(
					ЭлементЗакупка["CommissionDeadline"], "GMT+3"));
			СтрукРезультата.Вставить("ЗакупкаНеСостоялась", ЭлементЗакупка["IsAbandoned"]);
			СтрукРезультата.Вставить("ЗакупкаПланируется", ЭлементЗакупка["IsPlanning"]);

			СтрукРезультата.Вставить("Загружать", ЗакупкаНаЗагрузку(СтрукРезультата.ИдентификаторЗакупки));
			СтрукЗагружена = КонтурЗакупки_РаботаСЗакупкамиСервер.ЗакупкаЗагружена(
					СтрукРезультата.ИдентификаторЗакупки);
			Для Каждого ЭлСтрукЗагружена Из СтрукЗагружена Цикл
				СтрукРезультата.Вставить(ЭлСтрукЗагружена.Ключ, ЭлСтрукЗагружена.Значение);
			КонецЦикла;

			СтрукРезультата.Вставить("ШаблонПоиска", ШаблонПоиска);

			ЗаполнитьСтрокуРезутьтата(СтрукРезультата);
			ДобавитьЗаписьРегистраСоханенныеРезультатыПоиска(СтрукРезультата);
		КонецЦикла;

		ЗаписейНаСтраницу = Макс(МассивЗакупок.Количество(), 1);
	КонецЕсли;

	СтраницВсего = Цел(ЗаписейВсего / ЗаписейНаСтраницу) + ?((ЗаписейВсего % ЗаписейНаСтраницу) > 0, 1, 0);
КонецПроцедуры

// Получить структуру поиска.
// 
// Параметры:
//  СтраницаЗначение - Число - Страница значение
// 
// Возвращаемое значение:
//  Соответствие из Неопределено - Получить структуру поиска
Функция ПолучитьСтруктуруПоиска(СтраницаЗначение = 1) Экспорт
	МассивОтраслей = ПолучитьМассивОтраслей();
	МассивОтраслейОбновленных = ПолучитьМассивОтраслейОбновленных();
	МассивКлючевыхСлов = КонтурЗакупки_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			КлючевыеСлова, , Истина, Истина);
	МассивИсключаемыхСлов = КонтурЗакупки_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			ИсключаемыеСлова, , Истина, Истина);
	МассивИдентификаторовРегионов = Регионы.Выгрузить( , "ИдентификаторРегиона").ВыгрузитьКолонку(
		"ИдентификаторРегиона");
	МассивЭтапов = ПолучитьМассивЭтапов();
	МассивТиповТоргов = ПолучитьМассивТиповТоргов();
	МассивЗаказчиков = Заказчики.Выгрузить( , "ИНН").ВыгрузитьКолонку("ИНН");
	МассивСпособовОтбора = ПолучитьМассивСпособовОтбора();
	МассивИдентификаторовПлощадок = Площадки.Выгрузить( , "ИдентификаторПлощадки").ВыгрузитьКолонку(
		"ИдентификаторПлощадки");

	Результат = Новый Соответствие;

	Результат.Вставить("text", ?(МассивКлючевыхСлов.Количество() > 0, МассивКлючевыхСлов, Неопределено));
	Результат.Вставить("strictSearch", ТочныйПоиск);
	Результат.Вставить("attachments", ПоискПоДокументам);
	Результат.Вставить("exclude", ?(МассивИсключаемыхСлов.Количество() > 0, МассивИсключаемыхСлов, Неопределено));
	Результат.Вставить("regionIds", ?(МассивИдентификаторовРегионов.Количество() > 0, МассивИдентификаторовРегионов,
		Неопределено));
	Результат.Вставить("categories", ?(МассивОтраслей.Количество() > 0, МассивОтраслей, Неопределено));
	Результат.Вставить("CategoryIds", ?(МассивОтраслейОбновленных.Количество() > 0, МассивОтраслейОбновленных,
		Неопределено));
	Результат.Вставить("purchaseStatuses", ?(МассивЭтапов.Количество() > 0, МассивЭтапов, Неопределено));
	Результат.Вставить("laws", ?(МассивТиповТоргов.Количество() > 0, МассивТиповТоргов, Неопределено));
	Результат.Вставить("includeInns", ?(МассивЗаказчиков.Количество() > 0 И ДобавленныеИсключенныеЗаказчики = 0,
		МассивЗаказчиков, Неопределено));
	Результат.Вставить("excludeInns", ?(МассивЗаказчиков.Количество() > 0 И ДобавленныеИсключенныеЗаказчики = 1,
		МассивЗаказчиков, Неопределено));
	Результат.Вставить("procedures", ?(МассивСпособовОтбора.Количество() > 0, МассивСпособовОтбора, Неопределено));
	Результат.Вставить("electronicPlaces", ?(МассивИдентификаторовПлощадок.Количество() > 0,
		МассивИдентификаторовПлощадок, Неопределено));
	Результат.Вставить("maxPriceFrom", ?(НачальнаяЦенаОт > 0, НачальнаяЦенаОт, Неопределено));
	Результат.Вставить("maxPriceTo", ?(НачальнаяЦенаДо > 0, НачальнаяЦенаДо, Неопределено));
	Результат.Вставить("maxPriceNone", ВключатьЗакупкиБезНМЦ);
	Результат.Вставить("advance44", Авансирование44);
	Результат.Вставить("advance223", Авансирование223);
	Результат.Вставить("smp", ПреимуществаСМП);
		// приводим к MSK времени
		// клиент ожидает увидеть закупки по московскому
	Результат.Вставить("dateTimeFrom", КонтурЗакупки_СлужебныеВызовСервера.ПолучитьУниверсальнуюДатуВремяСтрокой(
		НачалоДня(
			НачалоПериода), "GMT+3"));
	Результат.Вставить("dateTimeTo", КонтурЗакупки_СлужебныеВызовСервера.ПолучитьУниверсальнуюДатуВремяСтрокой(
		КонецДня(
			КонецПериода), "GMT+3"));
	Если СтраницаЗначение > 1 Тогда
		Результат.Вставить("pageNumber", СтраницаЗначение - 1);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Найти закупки оффлайн.
Процедура НайтиЗакупкиОффлайн() Экспорт

	МассивНаЗагрузку = ЗакупкиНаЗагрузку.Выгрузить().ВыгрузитьКолонку("ИдентификаторЗакупки");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_СохраненныеРезультатыПоиска.ИдентификаторЗакупки КАК ИдентификаторЗакупки,
