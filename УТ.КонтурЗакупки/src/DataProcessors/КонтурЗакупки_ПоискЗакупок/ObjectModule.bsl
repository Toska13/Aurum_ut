Функция ПолучитьМассивОтраслей()
	МассивОтраслей = Новый Массив;

	Для Каждого СтрокаОтраслей Из Отрасли Цикл
		МассивОтраслей.Добавить(СтрокаОтраслей.Отрасль.Код);
	КонецЦикла;

	Возврат МассивОтраслей;
КонецФункции

Функция ПолучитьМассивОтраслейОбновленных()
	МассивОтраслей = Новый Массив;

	Для Каждого СтрокаОтраслей Из ОтраслиОбновленные Цикл
		МассивОтраслей.Добавить(СтрокаОтраслей.Отрасль.Код);
	КонецЦикла;

	Возврат МассивОтраслей;
КонецФункции

Функция ПолучитьМассивЭтапов()
	МассивЭтапов = Новый Массив;

	Если ЭтапПодачаЗаявок Тогда
		МассивЭтапов.Добавить(1);
	КонецЕсли;

	Если ЭтапРаботаКомиссии Тогда
		МассивЭтапов.Добавить(2);
	КонецЕсли;

	Если ЭтапЗавершены Тогда
		Если ЭтапТолькоНесостоявшиеся Тогда
			МассивЭтапов.Добавить(6);
		Иначе
			МассивЭтапов.Добавить(3);
		КонецЕсли;
	КонецЕсли;

	Если ЭтапПланируются Тогда
		МассивЭтапов.Добавить(4);
	КонецЕсли;

	Если ЭтапОтменены Тогда
		МассивЭтапов.Добавить(5);
	КонецЕсли;

	Возврат МассивЭтапов;
КонецФункции

Функция ПолучитьМассивТиповТоргов()
	МассивТиповТоргов = Новый Массив;

	Если ТипТоргов44ФЗ Тогда
		МассивТиповТоргов.Добавить(1);
	КонецЕсли;

	Если ТипТоргов223ФЗ Тогда
		МассивТиповТоргов.Добавить(2);
	КонецЕсли;

//		Если ТипТорговКоммерческиеИМалые Тогда
//			МассивТиповТоргов.Добавить(3);
//		КонецЕсли;

	Если ТипТоргов615ПП Тогда
		МассивТиповТоргов.Добавить(5);
	КонецЕсли;

	Если ТипТорговКоммерческие Тогда
		МассивТиповТоргов.Добавить(8);
	КонецЕсли;

	Если ТипТорговМалые Тогда
		МассивТиповТоргов.Добавить(9);
	КонецЕсли;

	Возврат МассивТиповТоргов;
КонецФункции

Функция ПолучитьМассивСпособовОтбора()
	МассивСпособовОтбора = Новый Массив;

	Если СпособОтбораЭлектронныйАукцион Тогда
		МассивСпособовОтбора.Добавить(0);
	КонецЕсли;

	Если СпособОтбораЗапросКотировок Тогда
		МассивСпособовОтбора.Добавить(1);
	КонецЕсли;

	Если СпособОтбораЗакупкаУЕдинственногоПоставщика Тогда
		МассивСпособовОтбора.Добавить(2);
	КонецЕсли;

	Если СпособОтбораКонкурс Тогда
		МассивСпособовОтбора.Добавить(3);
	КонецЕсли;

	Если СпособОтбораЗапросИлиМониторингЦен Тогда
		МассивСпособовОтбора.Добавить(5);
	КонецЕсли;

	Если СпособОтбораДругиеСпособы Тогда
		МассивСпособовОтбора.Добавить(99);
	КонецЕсли;

	Возврат МассивСпособовОтбора;
КонецФункции
