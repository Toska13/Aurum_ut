&НаКлиенте
Перем гНаименованиеСправочникаКонтрагенты; // Строка     

&НаКлиенте
Перем гСоответствиеПолейСправочникаКонтрагенты; // Строка     

#Область ОбработчикиСобытийФормы   

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СтраницаТекущая = 1;
	Если Параметры.Свойство("ЗаказчикиВыбранные") Тогда
		Для Каждого ЗаказчикВыбран Из Параметры["ЗаказчикиВыбранные"] Цикл
			НовСтр = ЗаказчикиВыбранные.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ЗаказчикВыбран);
			НовСтр.ДействиеСоСтрокой = НСтр("ru = 'Удалить'");
		КонецЦикла;
	КонецЕсли;
	Если Параметры.Свойство("ЗаказчикиВРежимеИсключения") Тогда
		ЗаказчикиВРежимеИсключения = Параметры["ЗаказчикиВРежимеИсключения"];
	КонецЕсли;
КонецПроцедуры      

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницаТекущаяПриИзменении(Элемент)
	СтраницаТекущая = Мин(Макс(СтраницаТекущая, 1), СтраницВсего);
	НайтиЗаказчиковНаКлиенте(ПодборЗаказчика, СтраницаТекущая);
КонецПроцедуры

&НаКлиенте
Процедура ПодборЗаказчикаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных,
	СтандартнаяОбработка)
	НайтиЗаказчиковНаКлиенте(Текст);
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказчикиВыбранные
&НаКлиенте
Процедура ЗаказчикиВыбранныеПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		ПеренестиМассивЗначенийВЗаказчикиВыбранные(ПараметрыПеретаскивания.Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказчикиВыбранныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Элементы.ЗаказчикиВыбранныеДействиеСоСтрокой Тогда
		УдалитьСтрокуИзЗаказчиковВыбранных(ВыбраннаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказчикиВыбранныеПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказчики
&НаКлиенте
Процедура ЗаказчикиПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказчикиПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		УдалитьПоМассивуЗначенийИзЗаказчикиВыбранные(ПараметрыПеретаскивания.Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказчикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПеренестиСтрокуВЗаказчикиВыбранные(ВыбраннаяСтрока);
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы

#Область Пангинация

&НаКлиенте
Процедура НавигацияПоСтраницамПервая(Команда)
	Если Не СтраницаТекущая = 1 Тогда
		СтраницаТекущая = 1;
		НайтиЗаказчиковНаКлиенте(ПодборЗаказчика, СтраницаТекущая);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НавигацияПоСтраницамСледующая(Команда)
	Если Не СтраницаТекущая = Мин(СтраницаТекущая + 1, СтраницВсего) Тогда
		СтраницаТекущая = Мин(СтраницаТекущая + 1, СтраницВсего);
		НайтиЗаказчиковНаКлиенте(ПодборЗаказчика, СтраницаТекущая);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НавигацияПоСтраницамПредыдущая(Команда)
	Если Не СтраницаТекущая = Макс(СтраницаТекущая - 1, 1) Тогда
		СтраницаТекущая = Макс(СтраницаТекущая - 1, 1);
		НайтиЗаказчиковНаКлиенте(ПодборЗаказчика, СтраницаТекущая);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НавигацияПоСтраницамПоследняя(Команда)
	Если Не СтраницаТекущая = СтраницВсего Тогда
		СтраницаТекущая = СтраницВсего;
		НайтиЗаказчиковНаКлиенте(ПодборЗаказчика, СтраницаТекущая);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

&НаКлиенте
Процедура КомандаПеренестиВВыбранные(Команда)
	ПеренестиСтрокиВЗаказчикиВыбранные();
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьИзВыбранных(Команда)
	УдалитьСтрокиИзЗаказчикиВыбранные();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменить(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавить(Команда)   
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаказчикиВыбранные", ЗаказчикиВыбранные);
	Результат.Вставить("ЗаказчикиВРежимеИсключения", ЗаказчикиВРежимеИсключения);
	
	Закрыть(Результат); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказчикиВыбранныеОчистить(Команда)
	ЗаказчикиВыбранные.Очистить();
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НайтиЗаказчиковНаКлиенте(Название, СтраницаЗначение = 1)
	Заказчики.Очистить();

	РезультатHTTPЗапроса = КонтурЗакупки_httpЗапросыКлиентСервер.http_ПолучитьСписокЗаказчиков(Название, СтраницаЗначение - 1);
	Если Не РезультатHTTPЗапроса = Неопределено Тогда
		Если Не РезультатHTTPЗапроса["data"] = Неопределено Тогда
			СтруктураЗаказчиков = РезультатHTTPЗапроса["data"];
			ЗаписейВсего = СтруктураЗаказчиков["total"];
			Элементы.ЗаказчикиНаименование.Заголовок = СтрШаблон("Найдено заказчиков: %1", ЗаписейВсего);
			СтраницаТекущая = СтраницаЗначение;
			Если Не СтруктураЗаказчиков["organizations"] = Неопределено Тогда
				МассивЗаказчиков = СтруктураЗаказчиков["organizations"];
				Для Каждого ЭлементЗаказчик Из МассивЗаказчиков Цикл
					НовСтрокаЗаказчик = Заказчики.Добавить();
					НовСтрокаЗаказчик.Наименование = ЭлементЗаказчик["shortName"];
					НовСтрокаЗаказчик.ОГРН = ЭлементЗаказчик["ogrn"];
					НовСтрокаЗаказчик.ИНН = ЭлементЗаказчик["inn"];
					НовСтрокаЗаказчик.Адрес = ЭлементЗаказчик["address"];
				КонецЦикла;
				ЗаписейНаСтраницу = Макс(МассивЗаказчиков.Количество(), 1, ЗаписейНаСтраницу);
			КонецЕсли;
			СтраницВсего = Цел(ЗаписейВсего / ЗаписейНаСтраницу) + ?((ЗаписейВсего % ЗаписейНаСтраницу) > 0, 1, 0);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСтрокиВЗаказчикиВыбранные()
	ВыделенныеСтроки = Элементы.Заказчики.ВыделенныеСтроки;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		ПеренестиСтрокуВЗаказчикиВыбранные(ВыделеннаяСтрока);
	КонецЦикла;
КонецПроцедуры         

&НаКлиенте
Процедура ЗаголовокВыбранныхЗаказчиков()                                                   
	ЗаписейВсего = ЗаказчикиВыбранные.Количество();
	Элементы.ЗаказчикиВыбранныеНаименование.Заголовок = СтрШаблон("Выбрано заказчиков: %1", ЗаписейВсего);
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСтрокуВЗаказчикиВыбранные(ИдентификаторВыделеннойСтроки)
	СтрокаПоИдентификатору = Заказчики.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
	Если Не ЗаказчикЕстьВВыбранных(СтрокаПоИдентификатору) Тогда
		НовСтрока = ЗаказчикиВыбранные.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаПоИдентификатору);
		НовСтрока.ДействиеСоСтрокой = НСтр("ru = 'Удалить'");   
		ЗаголовокВыбранныхЗаказчиков();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиМассивЗначенийВЗаказчикиВыбранные(МассивЗначений)
	Для Каждого ЭлементМассива Из МассивЗначений Цикл
		Если Не ЗаказчикЕстьВВыбранных(ЭлементМассива) Тогда
			НовСтрока = ЗаказчикиВыбранные.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ЭлементМассива);
			НовСтрока.ДействиеСоСтрокой = НСтр("ru = 'Удалить'");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЗаказчикЕстьВВыбранных(СтруктураЗаказчик)
	СтруктураПоиск = Новый Структура("ИНН", СтруктураЗаказчик.ИНН);
	ЗаказчикВВыбранных = ЗаказчикиВыбранные.НайтиСтроки(СтруктураПоиск).Количество() > 0;

	Возврат ЗаказчикВВыбранных;
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокуИзЗаказчиковВыбранных(ВыделеннаяСтрока)
	УдаляемаяСтрока = ЗаказчикиВыбранные.НайтиПоИдентификатору(ВыделеннаяСтрока);
	ЗаказчикиВыбранные.Удалить(УдаляемаяСтрока);
	ЗаголовокВыбранныхЗаказчиков();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиИзЗаказчикиВыбранные()
	ВыделенныеСтроки = Элементы.ЗаказчикиВыбранные.ВыделенныеСтроки;
	Для Инд = -ВыделенныеСтроки.ВГраница() По 0 Цикл
		УдалитьСтрокуИзЗаказчиковВыбранных(ВыделенныеСтроки[-Инд]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоМассивуЗначенийИзЗаказчикиВыбранные(МассивЗначений)
	Для Каждого ЭлементМассива Из МассивЗначений Цикл
		СтрукОтбор = Новый Структура("ИНН", ЭлементМассива.ИНН);
		НайденныеСтрокиЗаказчикиВыбранные = ЗаказчикиВыбранные.НайтиСтроки(СтрукОтбор);
		Для Каждого СтрокаНаУдаление Из НайденныеСтрокиЗаказчикиВыбранные Цикл
			ЗаказчикиВыбранные.Удалить(СтрокаНаУдаление);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти         

&НаКлиенте
Процедура ЗаказчикиДобавитьИзКонфигурации(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ИмяКонфигурации1С = КонтурЗакупки_СлужебныеВызовСервера.ИмяКонфигурации1С();
	Если ИмяКонфигурации1С = "УТ" Или ИмяКонфигурации1С = "БСП" Или ИмяКонфигурации1С = "ERP" Тогда
		ОткрытьФорму(
		"Справочник." + гНаименованиеСправочникаКонтрагенты + ".ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму(
		"Справочник." + гНаименованиеСправочникаКонтрагенты + ".ФормаСписка", ПараметрыФормы, ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	гНаименованиеСправочникаКонтрагенты = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"НаименованиеСправочникаКонтрагентов", "Контрагенты"); 
	
	гСоответствиеПолейСправочникаКонтрагенты = Новый Структура;
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("Наименование", "Наименование");
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("ИНН", "ИНН");
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("ОГРН", "РегистрационныйНомер");
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("Адрес", "");

КонецПроцедуры

&НаКлиенте
Процедура КомандаНайти(Команда)
	НайтиЗаказчиковНаКлиенте(ПодборЗаказчика);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка." + гНаименованиеСправочникаКонтрагенты) Тогда
			ДобавитьЗаказчикаНаКлиенте(ВыбранноеЗначение);
			ЗаголовокВыбранныхЗаказчиков();
		ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
			Для Каждого ЭлМассива Из ВыбранноеЗначение Цикл
				Если ТипЗнч(ЭлМассива) = Тип("СправочникСсылка." + гНаименованиеСправочникаКонтрагенты) Тогда
					ДобавитьЗаказчикаНаКлиенте(ЭлМассива);
				КонецЕсли;
			КонецЦикла;
			ЗаголовокВыбранныхЗаказчиков();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ДобавитьЗаказчикаНаКлиенте(ВыбранноеЗначение)
	ДобавлятьЗаказчика = Истина;

	Если ДобавлятьЗаказчика Тогда
			// проверяем обязательно ИНН
		ИНН = ПолучитьИНННаСервере(ВыбранноеЗначение, гСоответствиеПолейСправочникаКонтрагенты["ИНН"]);
		Если Не ЗначениеЗаполнено(ИНН) Тогда
			ДобавлятьЗаказчика = Ложь;
			КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр(
					"ru = 'У контрагента не заполнено обязательное поле ИНН'"));
		КонецЕсли;
	КонецЕсли;

	Если ДобавлятьЗаказчика Тогда
		// Ищем в имеющихся по ИНН  
		ПоискПоИНН = Новый Структура;
		ПоискПоИНН.Вставить("ИНН", ИНН);
		Если ЗаказчикЕстьВВыбранных(ПоискПоИНН) Тогда
			ДобавлятьЗаказчика = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ДобавлятьЗаказчика Тогда
		ДобавитьЗаказчикаНаСервере(ВыбранноеЗначение, гСоответствиеПолейСправочникаКонтрагенты);
	КонецЕсли;
КонецПроцедуры  

&НаСервере
Процедура ДобавитьЗаказчикаНаСервере(ВыбранныйЗаказчик, СоответствиеПолейСправочникаКонтрагенты)
	СтрокаЗаказчик = ЗаказчикиВыбранные.Добавить();
	СтрокаЗаказчик.ДействиеСоСтрокой = НСтр("ru = 'Удалить'");
	Для Каждого ПолеСправочникеКонтрагенты Из СоответствиеПолейСправочникаКонтрагенты Цикл
		Если Не ПустаяСтрока(ПолеСправочникеКонтрагенты.Значение) Тогда
			Попытка
				СтрокаЗаказчик[ПолеСправочникеКонтрагенты.Ключ] = ВыбранныйЗаказчик[ПолеСправочникеКонтрагенты.Значение];  

			Исключение
				;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьИНННаСервере(ВыбранныйЗаказчик, ПолеИНН)
	ИНН = "";
	ИНН = ВыбранныйЗаказчик[ПолеИНН];
	Возврат ИНН
КонецФункции

