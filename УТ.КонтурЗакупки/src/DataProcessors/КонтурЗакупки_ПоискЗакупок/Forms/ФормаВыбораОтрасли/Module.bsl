// @strict-types
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Отрасли") Тогда
		Отрасли.Загрузить(Параметры.Отрасли.Выгрузить());
		ЗаполнитьДеревоОтраслей();
		УстиновитьФлагиДереваОтраслей(ДеревоОтраслей, Отрасли.Выгрузить( , "Отрасль"));
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОтраслей

&НаКлиенте
Процедура ДеревоОтраслейФлагПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ДеревоОтраслей.ТекущаяСтрока; // Число

	Если Не ИДТекущейСтроки = Неопределено Тогда

		СтрокаДерева = ДеревоОтраслей.НайтиПоИдентификатору(ИДТекущейСтроки);

		Если СтрокаДерева.ЭтоГруппа Тогда
			УстановкаПодчиненныхФлажковОтрасли(СтрокаДерева);
		Иначе
			УстановкаРодительскогоФлажка(СтрокаДерева);

			МассиивОтраслей = Новый Массив; // Массив из СправочникСсылка.КонтурЗакупки_Отрасли 
			МассиивОтраслей.Добавить(СтрокаДерева.Отрасль);
			Если СтрокаДерева.Флаг Тогда
				ДобавитьОтрасльВТабличнуюЧасть(МассиивОтраслей);
			Иначе
				УдалитьОтрасльИзТабличнойЧасти(МассиивОтраслей);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	Закрыть(Отрасли);
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановкаРодительскогоФлажка(СтрокаДерева)
	ЭлементРодитель = СтрокаДерева.ПолучитьРодителя();
	Если Не ЭлементРодитель = Неопределено Тогда
		ЭлементыРодителя = ЭлементРодитель.ПолучитьЭлементы();
		ЕстьФлаги = Ложь;
		Для Каждого ТекЭлемент Из ЭлементыРодителя Цикл
			ЕстьФлаги = ЕстьФлаги Или ТекЭлемент.Флаг;
		КонецЦикла;
		ЭлементРодитель.Флаг = ЕстьФлаги;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановкаПодчиненныхФлажковОтрасли(СтрокаДерева)
	ПодчинЭлементы = СтрокаДерева.ПолучитьЭлементы();
	МассиивОтраслей = Новый Массив; // Массив из СправочникСсылка.КонтурЗакупки_Отрасли 
	Если Не СтрокаДерева.ЭтоГруппа Тогда
		МассиивОтраслей.Добавить(СтрокаДерева.Отрасль);
	КонецЕсли;
	Для Каждого ТекЭлемент Из ПодчинЭлементы Цикл
		ТекЭлемент.Флаг = СтрокаДерева.Флаг;
		МассиивОтраслей.Добавить(ТекЭлемент.Отрасль);
	КонецЦикла;
	Если СтрокаДерева.Флаг Тогда
		ДобавитьОтрасльВТабличнуюЧасть(МассиивОтраслей);
	Иначе
		УдалитьОтрасльИзТабличнойЧасти(МассиивОтраслей);
	КонецЕсли;
КонецПроцедуры


// Добавить отрасль в табличную часть.
// 
// Параметры:
//  МассивОтраслей - Массив из СправочникСсылка.КонтурЗакупки_Отрасли - Массив отраслей
&НаКлиенте
Процедура ДобавитьОтрасльВТабличнуюЧасть(Знач МассивОтраслей)

	Для Каждого Отрасль Из МассивОтраслей Цикл
		ОтборПоОтрасли = Новый Структура("Отрасль", Отрасль);
		МассивСтрок = Отрасли.НайтиСтроки(ОтборПоОтрасли);
		Если МассивСтрок.Количество() = 0 Тогда
			НовСтр = Отрасли.Добавить();
			НовСтр.Отрасль = Отрасль;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


// Удалить отрасль из табличной части.
// 
// Параметры:
//  МассивОтраслей - Массив из СправочникСсылка.КонтурЗакупки_Отрасли - Массив отраслей
&НаКлиенте
Процедура УдалитьОтрасльИзТабличнойЧасти(Знач МассивОтраслей)
	Для Каждого Отрасль Из МассивОтраслей Цикл
		ОтборПоОтрасли = Новый Структура("Отрасль", Отрасль);
		МассивСтрок = Отрасли.НайтиСтроки(ОтборПоОтрасли);
		Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
			Отрасли.Удалить(СтрокаНаУдаление);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоОтраслей()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_Отрасли.Ссылка КАК Отрасль,
	|	КонтурЗакупки_Отрасли.ЭтоГруппа КАК ЭтоГруппа,
	|	КонтурЗакупки_Отрасли.Код КАК Код
	|ИЗ
	|	Справочник.КонтурЗакупки_Отрасли КАК КонтурЗакупки_Отрасли
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЗакупки_Отрасли.Ссылка ИЕРАРХИЯ";
	РезЗапроса = Запрос.Выполнить();

	Выборка = РезЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);

	ЗаполнитьСтрокиДереваОтраслей(Выборка, ДеревоОтраслей);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиДереваОтраслей(Выборка, РодительДереваОтраслей)
	ЭлементыДереваРодителя = РодительДереваОтраслей.ПолучитьЭлементы();
	Пока Выборка.Следующий() Цикл
		СтрокаДерева = ЭлементыДереваРодителя.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
		Выборка1 = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		ЗаполнитьСтрокиДереваОтраслей(Выборка1, СтрокаДерева);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстиновитьФлагиДереваОтраслей(Знач РодительДереваОтраслей, МассивВыбраныхОтраслей)
	ЭлементыДереваРодителя = РодительДереваОтраслей.ПолучитьЭлементы();
	Если ЭлементыДереваРодителя.Количество() > 0 Тогда
		Для Каждого ЭлементДереваРодителя Из ЭлементыДереваРодителя Цикл
			Если ЭлементДереваРодителя.ЭтоГруппа Тогда
				ЭлементДереваРодителя.Флаг = УстиновитьФлагиДереваОтраслейУровень2(ЭлементДереваРодителя,
					МассивВыбраныхОтраслей);
			Иначе
				Если МассивВыбраныхОтраслей.Найти(ЭлементДереваРодителя.Отрасль) = Неопределено Тогда
					ЭлементДереваРодителя.Флаг = Ложь;
				Иначе
					ЭлементДереваРодителя.Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция УстиновитьФлагиДереваОтраслейУровень2(Знач РодительДереваОтраслей, МассивВыбраныхОтраслей)
	ЕстьФлаги = Ложь;
	ЭлементыДереваРодителя = РодительДереваОтраслей.ПолучитьЭлементы();
	Если ЭлементыДереваРодителя.Количество() > 0 Тогда
		Для Каждого ЭлементДереваРодителя Из ЭлементыДереваРодителя Цикл
			Если МассивВыбраныхОтраслей.Найти(ЭлементДереваРодителя.Отрасль) = Неопределено Тогда
				ЭлементДереваРодителя.Флаг = Ложь;
			Иначе
				ЭлементДереваРодителя.Флаг = Истина;
				ЕстьФлаги = ЕстьФлаги Или Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ЕстьФлаги;
КонецФункции
#КонецОбласти