// @strict-types
#Область ОбработчикиСобытийФормы

// Код процедур и функций
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МассивСоответствийУчастники = КонтурЗакупки_СлужебныеВызовСервера.ДесериализаторМассивИзСтроки(
		Параметры.СтрокаМассивСтруктурУчастники);

	Для Каждого СоответствиеСтрока Из МассивСоответствийУчастники Цикл
		НовСтр	= Участники.Добавить();
		НовСтр.Inn = СоответствиеСтрока["Inn"];
		НовСтр.FoundFromDocuments = СоответствиеСтрока["FoundFromDocuments"];
		НовСтр.IsContractor = СоответствиеСтрока["IsContractor"];
		НовСтр.IsWinner = СоответствиеСтрока["IsWinner"];
	КонецЦикла;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУчастники

&НаКлиенте
Процедура УчастникиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти