          <titleLocation>Left</titleLocation>
          <toolTip>
            <key>ru</key>
            <value>СМП (субъекты малого предпринимательства)
 - Крупным компаниям полезно исключить из поиска закупки с пометкой потому что они не имеют права в них участвовать.
 - Поставщикам, которые относятся к СМП, фильтр поможет отобрать именно эти закупки.</value>
          </toolTip>
          <toolTipRepresentation>Button</toolTipRepresentation>
          <handlers>
            <event>OnChange</event>
            <name>ПреимуществаСМППриИзменении</name>
