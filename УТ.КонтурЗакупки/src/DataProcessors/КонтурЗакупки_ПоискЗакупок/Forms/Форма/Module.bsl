	Возврат Объект.Площадки.Количество();
КонецФункции

&НаСервере
Функция ПолучитьТЗПлощадок()
	Возврат КонтурЗакупки_ОбщегоНазначения.ТаблицаЗначенийВМассив(Объект.Площадки.Выгрузить());
КонецФункции
#КонецОбласти

#Область ОбработкиТабличнойЧастиЗакупок
&НаСервере
Процедура ЗагружатьПриИзмененииНаСервере(ИденификаторСтроки)
	СтрокаПоИдентификатору = Объект.РезультатыПоиска.НайтиПоИдентификатору(ИденификаторСтроки);
	Если СтрокаПоИдентификатору.Загружать Тогда
		НовСтрокаНаЗагрузку = Объект.ЗакупкиНаЗагрузку.Добавить();
		НовСтрокаНаЗагрузку.ИдентификаторЗакупки = СтрокаПоИдентификатору.ИдентификаторЗакупки;
	Иначе
		СтрукОтбор = Новый Структура("ИдентификаторЗакупки", СтрокаПоИдентификатору.ИдентификаторЗакупки);
		СтрокиНаУдаление = Объект.ЗакупкиНаЗагрузку.НайтиСтроки(СтрукОтбор);
		Для Каждого УдаляемаяСтрока Из СтрокиНаУдаление Цикл
			Объект.ЗакупкиНаЗагрузку.Удалить(УдаляемаяСтрока);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьКнопкиЗагрузитьЗакупки()
	НадписьГруппыКЗагрузке = "Выбрано: " + ПолучитьКоличествоЗакупокНаЗагрузку();
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоЗакупокНаЗагрузку()
	Возврат Объект.ЗакупкиНаЗагрузку.Количество();
КонецФункции

&НаКлиенте
Процедура ЗагрузитьЗакупкиПоСпискуНаКлиенте()
	СинхронизацияНаКлиенте = КонтурЗакупки_ПодсистемаНастройкиВызовСервера.ПолучитьЗначениеНастройки("КонтурПодсистема",
		"СинхронизацияНаКлиенте", Ложь);
	Если СинхронизацияНаКлиенте Тогда
		ЗагрузитьЗакупкиПоСпискуНаКлиентеФорма();
	Иначе
		ЗагрузитьЗакупкиПоСпискуНаСервереФорма();
	КонецЕсли;
	ОбновитьНадписьКнопкиЗагрузитьЗакупки();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗакупкуПоИдентификаторуНаКлиенте(ИдентификаторЗакупки)
	СинхронизацияНаКлиенте = КонтурЗакупки_ПодсистемаНастройкиВызовСервера.ПолучитьЗначениеНастройки("КонтурПодсистема",
		"СинхронизацияНаКлиенте", Ложь);
	Если СинхронизацияНаКлиенте Тогда
		ЗагрузитьЗакупкуПоИдентификаторуНаКлиентеФорма(ИдентификаторЗакупки);
		ОбновитьПризнакиЗагрузкиИСсылкиФорма();
	Иначе
		ЗагрузитьЗакупкуПоИдентификаторуНаСервереФорма(ИдентификаторЗакупки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗакупкуПоИдентификаторуНаКлиентеФорма(ИдентификаторЗакупки)
	СтруктураПараметров = Новый Структура("ИдентификаторЗакупки", ИдентификаторЗакупки);
	ФормаЗагрузки = ПолучитьФорму("Обработка.КонтурЗакупки_ДанныеЗакупки.Форма", СтруктураПараметров, ЭтаФорма);
	ФормаЗагрузки.ПолучитьДанныеНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗакупкиПоСпискуНаКлиентеФорма()
	МассивИдентификаторовЗакупок = ПолучитьМассивИдентификаторовЗакупокНаЗагрузкуФорма();
	Для Каждого ИдентификаторЗакупки Из МассивИдентификаторовЗакупок Цикл
		ЗагрузитьЗакупкуПоИдентификаторуНаКлиенте(ИдентификаторЗакупки);
	КонецЦикла;
	ОбновитьПризнакиЗагрузкиИСсылкиФорма();
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивИдентификаторовЗакупокНаЗагрузкуФорма()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ПолучитьМассивИдентификаторовЗакупокНаЗагрузку();
КонецФункции

&НаСервере
Процедура ЗагрузитьЗакупкиПоСпискуНаСервереФорма()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗагрузитьЗакупкиПоСписку();
	ОбработкаОбъект.ОбновитьПризнакиЗагрузкиИСсылки();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗакупкуПоИдентификаторуНаСервереФорма(ИдентификаторЗакупки)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗагрузитьЗакупкуПоИдентификатору(ИдентификаторЗакупки);
	ОбработкаОбъект.ОбновитьПризнакиЗагрузкиИСсылки();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаСервере
Процедура ОбновитьПризнакиЗагрузкиИСсылкиФорма()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ОбновитьПризнакиЗагрузкиИСсылки();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры
#КонецОбласти

#Область РаботаСШаблонами

&НаКлиенте
Процедура ИзменениеШаблонаПоиска()
	ШаблонПоискаПриИзмененииНаСервере();
	ОбновитьНадписьКоличестваЗаказчиков();
	ОбновитьНадписьКоличестваОтраслей();
	ОбновитьНадписьКоличестваПлощадок();
	ОбновитьНадписьКоличестваРегионов();
	ИзменениеФлагТолькоНесостоявшиесяНаКлиенте();
	ИзменениеФлагТолькоЗавершеныНаКлиенте();
	Если Не ЗначениеЗаполнено(Объект.ШаблонПоиска) Тогда
		НачальноеЗаполнениеПризнаков();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ШаблоныСохранитьНаКлиенте()
	Если Не ЗначениеЗаполнено(Объект.ШаблонПоиска) Тогда
		НазваниеШаблона = "";
		ОповещениеОкончниеВводаНазванияШаблона = Новый ОписаниеОповещения("ОкончниеВводаНазванияШаблона", ЭтаФорма);
		ПоказатьВводСтроки(ОповещениеОкончниеВводаНазванияШаблона, НазваниеШаблона, "Введите название шаблона", 150);
	Иначе
		ШаблоныСохранитьНаСервере();
		Модифицированность = Ложь;
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ОкончниеВводаНазванияШаблона(ВведеннаяСтрока, ДополнительныеПараметры) Экспорт
	Если Не ПустаяСтрока(ВведеннаяСтрока) Тогда
		ШаблоныСохранитьНаСервере(ВведеннаяСтрока);
		Модифицированность = Ложь;
	Иначе
		КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(
		НСтр("ru='Пустое наименование шаблона.
			 |Шаблон не сохранен'"));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ШаблоныСохранитьНаСервере(НазваниеШаблона = "")
	Если ЗначениеЗаполнено(Объект.ШаблонПоиска) Тогда
		СпрШаблон = Объект.ШаблонПоиска.ПолучитьОбъект();
	Иначе
		СпрШаблон = Справочники.КонтурЗакупки_ШаблоныПоиска.СоздатьЭлемент();
		СпрШаблон.Наименование = НазваниеШаблона;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(СпрШаблон, Объект);
	СпрШаблон.ТипТорговКоммерческиеИМалые = Объект.ТипТорговКоммерческие И Объект.ТипТорговМалые;
	СпрШаблон.Заказчики.Загрузить(Объект.Заказчики.Выгрузить());
	СпрШаблон.Площадки.Загрузить(Объект.Площадки.Выгрузить());
	СпрШаблон.Регионы.Загрузить(Объект.Регионы.Выгрузить());
	СпрШаблон.Отрасли.Загрузить(Объект.Отрасли.Выгрузить());
	СпрШаблон.ОтраслиОбновленные.Загрузить(Объект.ОтраслиОбновленные.Выгрузить());

	СпрШаблон.Записать();

	Объект.ШаблонПоиска = СпрШаблон.Ссылка;

	ТекущийПользователь = КонтурЗакупки_ЛокализацияВызовСервера.ПолучитьТекущегоПользователя();
	Если Не ТекущийПользователь = Неопределено Тогда
		КонтурЗакупки_ЛокализацияВызовСервера.УстановитьОтветственного(СпрШаблон.Ссылка, ТекущийПользователь);
	КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура НачальноеЗаполнениеПризнаков()

	Объект.ЭтапПодачаЗаявок = Истина;

	Объект.ТипТоргов223ФЗ = Истина;
	Объект.ТипТоргов44ФЗ = Истина;
	Объект.ТипТоргов615ПП = Истина;
	Объект.ТипТорговКоммерческие = Истина;
//	Объект.ТипТорговКоммерческиеИМалые = Истина;
	Объект.ТипТорговМалые = Истина;

	Объект.СпособОтбораЭлектронныйАукцион = Истина;
	Объект.СпособОтбораЗапросКотировок = Истина;
	Объект.СпособОтбораЗакупкаУЕдинственногоПоставщика = Истина;
	Объект.СпособОтбораКонкурс = Истина;
	Объект.СпособОтбораЗапросИлиМониторингЦен = Истина;
	Объект.СпособОтбораДругиеСпособы = Истина;
	Объект.СпособОтбораВсе = Истина;

КонецПроцедуры

&НаСервере
Процедура ШаблонПоискаПриИзмененииНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьПоискПоШаблону();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

#КонецОбласти

#Область ОтметкиОЗагрузке

&НаСервере
Процедура ОтметитьЗакупкиНеЗагруженныеНаСервере()
	Для Каждого СтрокаТЧ Из Объект.РезультатыПоиска Цикл
		Если Не СтрокаТЧ.Загружен Тогда
			СтрокаТЧ.Загружать = Истина;
			НовСтрокаНаЗагрузку = Объект.ЗакупкиНаЗагрузку.Добавить();
			НовСтрокаНаЗагрузку.ИдентификаторЗакупки = СтрокаТЧ.ИдентификаторЗакупки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
&НаСервере
Процедура ОтметитьЗакупкиВсеНаСервере()
	Для Каждого СтрокаТЧ Из Объект.РезультатыПоиска Цикл
		СтрокаТЧ.Загружать = Истина;
		НовСтрокаНаЗагрузку = Объект.ЗакупкиНаЗагрузку.Добавить();
		НовСтрокаНаЗагрузку.ИдентификаторЗакупки = СтрокаТЧ.ИдентификаторЗакупки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СнятьОтметкиЗакупкиВсеНаСервере()
	Для Каждого СтрокаТЧ Из Объект.РезультатыПоиска Цикл
		СтрокаТЧ.Загружать = Ложь;
	КонецЦикла;
	Объект.ЗакупкиНаЗагрузку.Очистить();
КонецПроцедуры
&НаКлиенте
Процедура ОповещениеОкончанияВопросаОЗагрузке(РезультатВопроса, ИдентификаторЗакупки) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗагрузитьЗакупкуПоИдентификаторуНаКлиенте(ИдентификаторЗакупки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
#КонецОбласти