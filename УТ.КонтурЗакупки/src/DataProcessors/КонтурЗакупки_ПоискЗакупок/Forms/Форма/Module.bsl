&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ТекстПредупрежденияИВопроса = НСтр("ru = 'Данные шаблона были изменены. Закрыть?'");
	Если ЗначениеЗаполнено(ЗавершениеРаботы) Тогда
		Если Модифицированность И ЗначениеЗаполнено(Объект.ШаблонПоиска) Тогда

			КнопкиВопроса = Новый СписокЗначений;
			КнопкиВопроса.Добавить("СохранитьИЗакрыть", "Сохранить и закрыть");
			КнопкиВопроса.Добавить("ЗакрытьБезСохранения", "Закрыть без сохранения");
			КнопкиВопроса.Добавить("НеЗакрывать", "Не закрывать");

			Отказ = Истина;
			ОбратныйВызов = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтаФорма);
			ПоказатьВопрос(ОбратныйВызов, ТекстПредупрежденияИВопроса, КнопкиВопроса, , "НеЗакрывать");
		КонецЕсли;
	Иначе
		Если Модифицированность И ЗначениеЗаполнено(Объект.ШаблонПоиска) Тогда
			Отказ = Истина;
			ТекстПредупреждения = ТекстПредупрежденияИВопроса;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
//	Если КонтурЗакупки_СлужебныеВызовСервера.РежимСовместимости82() Тогда
//		ДекорацияРастяжитель = Элементы.Добавить("ДекорацияРастяжитель1", Тип(
//					"ДекорацияФормы"), Элементы.СтраницаПоиск);
//		ДекорацияРастяжитель.Вид = ВидДекорацииФормы.Картинка;
//		ДекорацияРастяжитель.РастягиватьПоВертикали = Истина;
//
//		ДекорацияРастяжитель = Элементы.Добавить("ДекорацияРастяжитель", Тип(
//					"ДекорацияФормы"), Элементы.СтраницаРезультатыПоиска);
//		ДекорацияРастяжитель.Вид = ВидДекорацииФормы.Картинка;
//		ДекорацияРастяжитель.РастягиватьПоВертикали = Истина;
//	КонецЕсли;

	СтарыйСправочникОтраслей = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"СтарыйСправочникОтраслей", Ложь);

	Элементы.НадписьОтрасли.Видимость = СтарыйСправочникОтраслей;
	Элементы.НадписьОтраслиОбновленные.Видимость = Не СтарыйСправочникОтраслей;

	Объект.КонецПериода = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Параметры.ШаблонПоиска) Тогда
		Объект.ШаблонПоиска = Параметры.ШаблонПоиска;
		//ОкончниеВыбораШаблонаНаСервере();
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ОбработкаОбъект.ЗаполнитьПоискПоШаблону();
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	Иначе
		Объект.НачалоПериода = КонтурЗакупки_СлужебныеКлиентСервер.ДобавитьДней(ТекущаяДатаСеанса(), -7);

		НачальноеЗаполнениеПризнаков();

	КонецЕсли;
	Объект.КонецПериодаОффлайн = ТекущаяДатаСеанса();
	Объект.НачалоПериодаОффлайн = КонтурЗакупки_СлужебныеКлиентСервер.ДобавитьДней(ТекущаяДатаСеанса(), -7);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьНадписьКоличестваЗаказчиков();
	ОбновитьНадписьКоличестваОтраслей();
	ОбновитьНадписьКоличестваПлощадок();
	ОбновитьНадписьКоличестваРегионов();
	ИзменениеФлагТолькоНесостоявшиесяНаКлиенте();
	ИзменениеФлагТолькоЗавершеныНаКлиенте();
	гНаименованиеСправочникаКонтрагенты = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"НаименованиеСправочникаКонтрагентов", "Контрагенты");

	//@skip-check bsl-variable-name-invalid
	гСоответствиеПолейСправочникаКонтрагенты = Новый Структура;
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("Наименование", "Наименование");
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("ИНН", "ИНН");
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("ОГРН", "РегистрационныйНомер");
	гСоответствиеПолейСправочникаКонтрагенты.Вставить("Адрес", "");

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка." + гНаименованиеСправочникаКонтрагенты) Тогда
			ДобавитьЗаказчикаНаКлиенте(ВыбранноеЗначение);
			ОбновитьНадписьКоличестваЗаказчиков();
		ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
			Для Каждого ЭлМассива Из ВыбранноеЗначение Цикл
				Если ТипЗнч(ЭлМассива) = Тип("СправочникСсылка." + гНаименованиеСправочникаКонтрагенты) Тогда
					ДобавитьЗаказчикаНаКлиенте(ЭлМассива);
				КонецЕсли;
			КонецЦикла;
			ОбновитьНадписьКоличестваЗаказчиков();
		КонецЕсли;
	КонецЕсли;
	Модифицированность = Истина;
КонецПроцедуры
#КонецОбласти

