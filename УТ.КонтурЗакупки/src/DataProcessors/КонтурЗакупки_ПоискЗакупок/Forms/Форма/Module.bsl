&НаКлиенте
Процедура ЗаказчикиДобавитьИзКонфигурации(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ИмяКонфигурации1С = КонтурЗакупки_СлужебныеВызовСервера.ИмяКонфигурации1С();
	Если ИмяКонфигурации1С = "УТ" Или ИмяКонфигурации1С = "БСП" Тогда
		ОткрытьФорму(
		"Справочник." + гНаименованиеСправочникаКонтрагенты + ".ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму(
		"Справочник." + гНаименованиеСправочникаКонтрагенты + ".ФормаСписка", ПараметрыФормы, ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
