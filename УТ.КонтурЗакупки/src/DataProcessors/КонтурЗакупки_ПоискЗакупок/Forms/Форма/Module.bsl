&НаКлиенте
Процедура ПоказатьУчастников(ДанныеСтроки)
	Если ДанныеСтроки.УчастникиКоличество > 0 Тогда
		ПараметрыФормы = Новый Структура;
		Параметрыформы.Вставить("СтрокаМассивСтруктурУчастники", ДанныеСтроки.Участники);
		ОткрытьФорму("Обработка.КонтурЗакупки_ПоискЗакупок.Форма.ФормаУчастников", ПараметрыФормы, ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаказчикаНаКлиенте(ВыбранноеЗначение)
	ДобавлятьЗаказчика = Истина;

	Если ДобавлятьЗаказчика Тогда
			// проверяем обязательно ИНН
		ИНН = ПолучитьИНННаСервере(ВыбранноеЗначение, гСоответствиеПолейСправочникаКонтрагенты["ИНН"]);
		Если Не ЗначениеЗаполнено(ИНН) Тогда
			ДобавлятьЗаказчика = Ложь;
			КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр(
					"ru = 'У контрагента не заполнено обязательное поле ИНН'"));
		КонецЕсли;
	КонецЕсли;

	Если ДобавлятьЗаказчика Тогда
		// Ищем в имеющихся по ИНН
		Если ЗаказчикЕстьВВыбранных(ИНН) Тогда
			ДобавлятьЗаказчика = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ДобавлятьЗаказчика Тогда
		ДобавитьЗаказчикаНаСервере(ВыбранноеЗначение, гСоответствиеПолейСправочникаКонтрагенты);
	КонецЕсли;
КонецПроцедуры

