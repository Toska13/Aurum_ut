&НаКлиенте
Процедура СвернутьПоиск(ТекущаяСтраница)
	Если ТекущаяСтраница = Элементы.СтраницаПоиск Тогда
		Если гПоискСвернут = Истина Тогда
			Элементы.ГруппаНастройкиПоиска.Скрыть();
		Иначе
			Элементы.ГруппаНастройкиПоиска.Показать();
		КонецЕсли;
	Иначе
		гПоискСвернут = Элементы.ГруппаНастройкиПоиска.Скрыта();
		Элементы.ГруппаНастройкиПоиска.Скрыть();
	КонецЕсли;
КонецПроцедуры

