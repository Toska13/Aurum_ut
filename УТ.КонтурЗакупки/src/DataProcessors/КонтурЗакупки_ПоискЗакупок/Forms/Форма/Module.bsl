&НаКлиенте
Процедура ТаблицаЗакупокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОповещениеОбЗапуске = Новый ОписаниеОповещения;
	Если Поле = Элементы.ТаблицаЗакупокСсылкаНаЭТП И Не ПустаяСтрока(Элемент.ТекущиеДанные.СсылкаНаЭТП) Тогда
		НачатьЗапускПриложения(ОповещениеОбЗапуске, Элемент.ТекущиеДанные.СсылкаНаЭТП);
	ИначеЕсли Поле = Элементы.ТаблицаЗакупокСсылкаНаКЗ И Не ПустаяСтрока(Элемент.ТекущиеДанные.СсылкаНаКЗ) Тогда
		НачатьЗапускПриложения(ОповещениеОбЗапуске, Элемент.ТекущиеДанные.СсылкаНаКЗ);
	ИначеЕсли Поле = Элементы.ТаблицаЗакупокСсылкаНаЗагруженный Тогда
		ПоказатьЗначение( , Элемент.ТекущиеДанные.СсылкаНаЗагруженный);
	ИначеЕсли Поле = Элементы.ТаблицаЗакупокУчастникиКоличество Тогда
		ПоказатьУчастников(Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ТаблицаЗакупокЗагружатьПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ТаблицаЗакупок.ТекущаяСтрока;

	Если Не ИДТекущейСтроки = Неопределено Тогда
		ЗагружатьПриИзмененииНаСервере(ИДТекущейСтроки);
		ОбновитьНадписьКнопкиЗагрузитьЗакупки();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗакупокПриАктивизацииСтроки(Элемент)
	Если Не Элементы.ТаблицаЗакупок.ТекущиеДанные = Неопределено Тогда
		МассивСтрок = Новый Массив;
		СимволыНачало = "[b]";
		СимволыКонец = "[/b]";

		СтрокаСниппеты = Элементы.ТаблицаЗакупок.ТекущиеДанные.Сниппеты;
		КоличествоЖирных = СтрЧислоВхождений(СтрокаСниппеты, СимволыНачало);
		Для Инд = 1 По КоличествоЖирных Цикл

			НомСимвола = СтрНайти(СтрокаСниппеты, СимволыНачало);
			МассивСтрок.Добавить(Лев(СтрокаСниппеты, НомСимвола - 1));
			СтрокаСниппеты = Сред(СтрокаСниппеты, НомСимвола + СтрДлина(СимволыНачало));

			НомСимвола = СтрНайти(СтрокаСниппеты, СимволыКонец);
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Лев(СтрокаСниппеты, НомСимвола - 1), Новый Шрифт(, ,
				Истина)));
			СтрокаСниппеты = Сред(СтрокаСниппеты, НомСимвола + СтрДлина(СимволыКонец));

		КонецЦикла;
		МассивСтрок.Добавить(СтрокаСниппеты);

		Сниппеты = Новый ФорматированнаяСтрока(МассивСтрок);
	КонецЕсли;
КонецПроцедуры

