#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьМеткиИзбранного(Команда)
	ПолучитьМеткиИзбранногоНаКлиенте();
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьРезультатаФорма(ДанныеСоответствие)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьТабличнуюЧастьРезультата(ДанныеСоответствие);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПоискаФорма()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ПолучитьСтруктуруПоиска();
КонецФункции

&НаСервере
Процедура ОчиститьТабличнаяЧастьМетки()
	Объект.Метки.Очистить();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМеткиИзбранногоНаКлиентеФорма(СтраницаЗначение, ОписаниеРезультата = "")
	Результат = Истина;
	ОчиститьТабличнаяЧастьМетки();

	СтруктураПоиска = ПолучитьСтруктуруПоискаФорма();

	Если СтраницаЗначение > 1 Тогда
		СтруктураПоиска.Вставить("pageNumber", СтраницаЗначение - 1);
	КонецЕсли;

	РезультатHTTPЗапроса = КонтурЗакупки_httpЗапросыКлиентСервер.http_ПолучитьМеткиИзбранного(СтруктураПоиска);
	Если Не РезультатHTTPЗапроса = Неопределено Тогда
		Если Не РезультатHTTPЗапроса["data"] = Неопределено Тогда
			ДанныеПоиска = РезультатHTTPЗапроса["data"];
			ЗаполнитьТабличнуюЧастьРезультатаФорма(ДанныеПоиска);
		ИначеЕсли Не РезультатHTTPЗапроса["error"] = Неопределено И РезультатHTTPЗапроса["error"] = Истина Тогда
			Результат = Ложь;
			ОписаниеРезультата = ОписаниеРезультата + СтрШаблон(
				НСтр("ru = 'Ошибка: %1'"), РезультатHTTPЗапроса["message"]) + Символы.ПС;
		КонецЕсли;
	Иначе
		Результат = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Ошибка'") + Символы.ПС;
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьМеткиИзбранногоНаКлиенте(СтраницаЗначение = 1)
	Результат = Истина;
	ОписаниеРезультата = "";
	Результат = ПолучитьМеткиИзбранногоНаКлиентеФорма(СтраницаЗначение, ОписаниеРезультата);

	Если Не Результат Тогда
		КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеРезультата);
	КонецЕсли;

	Возврат Результат;
КонецФункции
#КонецОбласти