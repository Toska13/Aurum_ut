&НаКлиенте
Процедура Оповещение_ПослеВыбораОбъектаМетаданных(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		ОбновитьМодульНаСервере(ДополнительныеПараметры.КлючОбработки, ДополнительныеПараметры.ТипСодержимого,
			Неопределено, РезультатЗакрытия);
	КонецЕсли;

КонецПроцедуры // Оповещение_ПослеВыбораОбъектаМетаданных()

&НаКлиенте
Процедура ОткрытьФормуОписаниеОбновлений(НазваниеПродукта, Представление, НомерВерсии)

	ПараметрыФормыОбновлений = Новый Структура;
	ПараметрыФормыОбновлений.Вставить("НазваниеПродукта", НазваниеПродукта);
	ПараметрыФормыОбновлений.Вставить("Представление", Представление);
	ПараметрыФормыОбновлений.Вставить("НомерВерсии", НомерВерсии);

	ОткрытьФорму("Обработка.КонтурЗакупки_Обновление.Форма.ФормаОписаниеОбновлений", ПараметрыФормыОбновлений);

КонецПроцедуры // ОткрытьФормуОписаниеОбновлений()

&НаКлиенте
Процедура СохранитьФайлОбновления(НазваниеПродукта, ТипМодуля, Представление, НомерВерсии)

	Если НомерВерсии = "0.0.0.0" Тогда
		Возврат;
	КонецЕсли;

	РежимСохранение = РежимДиалогаВыбораФайла.Сохранение;
	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимСохранение);
	ДиалогСохранения.Заголовок = "Выберите имя файла для сохранения";
	ДиалогСохранения.Фильтр = СтрШаблон("Файлы %1|*.%1", ТипМодуля);
	ДиалогСохранения.ПолноеИмяФайла = НазваниеПродукта + "_" + НомерВерсии + "." + ТипМодуля;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НазваниеПродукта", НазваниеПродукта);
	ДополнительныеПараметры.Вставить("ТипМодуля", ТипМодуля);
	ДополнительныеПараметры.Вставить("НомерВерсии", НомерВерсии);

	ОповещениеЗавершения = Новый ОписаниеОповещения("СохранитьФайлОбновленияЗавершение", ЭтотОбъект,
		ДополнительныеПараметры);
	ДиалогСохранения.Показать(ОповещениеЗавершения);

КонецПроцедуры // ОткрытьФормуОписаниеОбновлений()

&НаКлиенте
Процедура СохранитьФайлОбновленияЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = ВыбранныеФайлы[0];
	ДвоичныеДанныеФайла = КонтурЗакупки_ОбновлениеКлиент.http_СкачатьОбновление(
		ДополнительныеПараметры.НазваниеПродукта, ДополнительныеПараметры.ТипМодуля,
		ДополнительныеПараметры.НомерВерсии);

	Если ДвоичныеДанныеФайла <> Неопределено Тогда
		Попытка
			ДвоичныеДанныеФайла.Записать(ИмяФайла);
		Исключение
			КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(
				СтрШаблон(
				НСтр("ru = 'Не удалось записать файл %1 по причине: %2'"), ИмяФайла, ОписаниеОшибки()));
		КонецПопытки;
	Иначе
		КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(НСтр(
			"ru = 'Не удалось скачать файл с сервера обновлений!'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбновитьМодульНаСервере(КлючРасширения, ТипСодержимого, ДвоичныеДанные, ОбъектыНазначения = Неопределено)

	Если НРег(ТипСодержимого) = "расширение" Тогда
		РезультатОбновления = КонтурЗакупки_ОбновлениеВызовСервера.ОбновитьРасширение(КлючРасширения, ДвоичныеДанные);
//TODO убрано из-за локализации
//	Иначе
//		РезультатОбновления = КонтурЗакупки_ОбновлениеВызовСервера.ОбновитьОбработку(КлючРасширения, ДвоичныеДанные,
//			ОбъектыНазначения);
	КонецЕсли;

	Возврат РезультатОбновления;

КонецФункции


