&НаКлиенте
Процедура ПроверитьОбновлениеНаКлиенте()

	Для Каждого СтрокаПодсистемы Из Подсистемы.ПолучитьЭлементы() Цикл
		ПроверитьОбновлениеПоСтрокеПодсистемы(СтрокаПодсистемы);
		Если СтрокаПодсистемы.ПолучитьЭлементы().Количество() > 0 Тогда
			Для Каждого СтрокаПодсистемы2 Из СтрокаПодсистемы.ПолучитьЭлементы() Цикл
				ПроверитьОбновлениеПоСтрокеПодсистемы(СтрокаПодсистемы2);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаПодсистемы Из Подсистемы.ПолучитьЭлементы() Цикл
		ИдентификаторСтроки=СтрокаПодсистемы.ПолучитьИдентификатор();
		Элементы.Подсистемы.Развернуть(ИдентификаторСтроки);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбновлениеПоСтрокеПодсистемы(СтрокаПодсистемы)

	АктуальнаяВерсия = КонтурЗакупки_ОбновлениеКлиент.http_ПолучитьАктуальнуюВерсиюПродукта(
		СтрокаПодсистемы.НазваниеПродукта);
	ТекущаяВерсия = СтрокаПодсистемы.ТекущаяВерсия;

	СтрокаПодсистемы.АктуальнаяВерсия = АктуальнаяВерсия;

	Установлен = ТекущаяВерсия <> "0.0.0.0";
	ЕстьОбновление = ЭтоНоваяВерсия(ТекущаяВерсия, АктуальнаяВерсия);

	Если Установлен И ЕстьОбновление Тогда
		СтрокаПодсистемы.Результат = СтрШаблон(
		НСтр("ru = 'Есть обновление для модуля %1, версия: %2'"), СокрЛП(СтрокаПодсистемы.Подсистема), СокрЛП(
			АктуальнаяВерсия));
		СтрокаПодсистемы.Установка = "Обновить";
	ИначеЕсли Установлен И Не ЕстьОбновление Тогда
		СтрокаПодсистемы.Результат = НСтр("ru = 'Обновление не требуется'");
		СтрокаПодсистемы.Установка = "Переустановить";
	ИначеЕсли Не Установлен И ЕстьОбновление Тогда
		СтрокаПодсистемы.Результат = НСтр("ru = 'Доступно к установке'");
		СтрокаПодсистемы.Установка = "Установить";
	Иначе
		СтрокаПодсистемы.Результат = НСтр("ru = 'Модуль недоступен для установки'");
		СтрокаПодсистемы.Установка = "";
	КонецЕсли;

//	Если Установлен И СтрокаПодсистемы.ТипМодуля = "epf" Тогда
//		Если СтрокаПодсистемы.КлючРасширения = "КонтурСайнВыгрузкаПрисоединенныхФайлов"
//			Или СтрокаПодсистемы.КлючРасширения = "Kontur_Сайн_Выгрузка_Объекта" Тогда
//			СтрокаПодсистемы.Действие = "Изменить назначение";
//		Иначе
//			СтрокаПодсистемы.Действие = "Настроить модуль";
//		КонецЕсли;
//	КонецЕсли;

	Если Установлен Тогда

		ДвоичныеДанныеОписания = КонтурЗакупки_ОбновлениеКлиент.http_СкачатьОбновление(
			СтрокаПодсистемы.НазваниеПродукта, "release-notes", ТекущаяВерсия);
		Если ДвоичныеДанныеОписания <> Неопределено Тогда
			СтрокаПодсистемы.ТекущаяВерсияОписание = "новое в версии " + ТекущаяВерсия;
		КонецЕсли;

		ПодсистемаИзменена = КонтурЗакупки_ОбновлениеВызовСервера.ПодсистемаИзменена(СтрокаПодсистемы.КлючРасширения,
			СтрокаПодсистемы.НазваниеПродукта, СтрокаПодсистемы.ТипМодуля);
		Если ПодсистемаИзменена Тогда
			СтрокаПодсистемы.ИндексКартинки = 2;
		Иначе
			СтрокаПодсистемы.ИндексКартинки = 1;
		КонецЕсли;

	ИначеЕсли ЕстьОбновление Тогда

		СтрокаПодсистемы.ИндексКартинки = 3;

	КонецЕсли;

	Если ЕстьОбновление Тогда
		ДвоичныеДанныеОписания = КонтурЗакупки_ОбновлениеКлиент.http_СкачатьОбновление(
			СтрокаПодсистемы.НазваниеПродукта, "release-notes", АктуальнаяВерсия);
		Если ДвоичныеДанныеОписания <> Неопределено Тогда
			СтрокаПодсистемы.АктуальнаяВерсияОписание = "новое в версии " + АктуальнаяВерсия;
		КонецЕсли;
	ИначеЕсли АктуальнаяВерсия = ТекущаяВерсия Тогда
		СтрокаПодсистемы.АктуальнаяВерсияОписание = СтрокаПодсистемы.ТекущаяВерсияОписание;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМодульНаКлиенте(ДанныеМодуля)

	РезультатОбновления = Неопределено;

	АктуальнаяВерсия = КонтурЗакупки_ОбновлениеКлиент.http_ПолучитьАктуальнуюВерсиюПродукта(
		ДанныеМодуля.НазваниеПродукта);

	Если АктуальнаяВерсия <> "0.0.0.0" Тогда

		ДвоичныеДанные = КонтурЗакупки_ОбновлениеКлиент.http_СкачатьОбновление(ДанныеМодуля.НазваниеПродукта,
			ДанныеМодуля.ТипМодуля);

		Если ДвоичныеДанные <> Неопределено Тогда

			РезультатОбновления = ОбновитьМодульНаСервере(ДанныеМодуля.КлючРасширения, ДанныеМодуля.ТипСодержимого,
				ДвоичныеДанные);
			ДанныеМодуля.Результат = РезультатОбновления.Описание;
			ДанныеМодуля.Действие = "";
			Если РезультатОбновления.Успех Тогда
				ЗаполнитьСписокПодсистем();
				ПроверитьОбновлениеНаКлиенте();
				Если НРег(ДанныеМодуля.ТипСодержимого) = "расширение" Тогда
					Элементы.Перезапустить.Видимость = Истина;
				КонецЕсли;

				КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Подсистема %1 успешно установлена!'"), ДанныеМодуля.Подсистема));

			Иначе

				КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Не удалось установить подсистему %1 по причине: %2'"), ДанныеМодуля.Подсистема,
					РезультатОбновления.Описание));
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

