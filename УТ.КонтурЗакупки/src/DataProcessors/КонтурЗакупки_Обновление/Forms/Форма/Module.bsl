Функция ЭтоНоваяВерсия(ТекущаяВерсия, АктуальнаяВерсия)

	Возврат КонтурЗакупки_ОбновлениеВызовСервера.ЭтоНоваяВерсия(ТекущаяВерсия, АктуальнаяВерсия);

КонецФункции

&НаСервере
Процедура ДобавитьСтрокуПодсистемы(КлючРасширения, НазваниеПродукта, Представление, ТекущаяВерсия, АктуальнаяВерсия,
	ТипМодуля, ПодсистемаРодитель, ТипСодержимого)

	РекПодсистемыСайн = РеквизитФормыВЗначение("Подсистемы");

	Если ЗначениеЗаполнено(ПодсистемаРодитель) Тогда
		ПараметрыОтбора = Новый Структура("НазваниеПродукта", ПодсистемаРодитель);
		СтрокиРодитель = РекПодсистемыСайн.Строки.НайтиСтроки(ПараметрыОтбора);
		НовСтрока = СтрокиРодитель[0].Строки.Добавить();
	Иначе
		НовСтрока = РекПодсистемыСайн.Строки.Добавить();
	КонецЕсли;

	НовСтрока.Подсистема = Представление;
	НовСтрока.КлючРасширения = КлючРасширения;
	НовСтрока.НазваниеПродукта = НазваниеПродукта;
	НовСтрока.ТекущаяВерсия = ТекущаяВерсия.Версия;
	НовСтрока.АктуальнаяВерсия = АктуальнаяВерсия;
	НовСтрока.ТипМодуля = ТипМодуля;
	НовСтрока.ПодсистемаРодитель = ПодсистемаРодитель;
	НовСтрока.ТипСодержимого = ТипСодержимого;

	Если ТекущаяВерсия.Свойство("СсылкаНаОбработку") Тогда
		НовСтрока.СсылкаНаМодуль = ТекущаяВерсия.СсылкаНаОбработку;
	КонецЕсли;

	ЗначениеВРеквизитФормы(РекПодсистемыСайн, "Подсистемы");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПодсистем()

	Подсистемы.ПолучитьЭлементы().Очистить();

	МассивПодсистем = КонтурЗакупки_ОбновлениеВызовСервера.ПолучитьМассивПодсистем();
	Для Каждого Подсистема Из МассивПодсистем Цикл
		ДобавитьСтрокуПодсистемы(Подсистема.Ключ, Подсистема.НазваниеПродукта, Подсистема.Представление,
			Подсистема.ТекущаяВерсия, Подсистема.АктуальнаяВерсия, Подсистема.ТипМодуля, Подсистема.ПодсистемаРодитель,
			Подсистема.ТипСодержимого);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти