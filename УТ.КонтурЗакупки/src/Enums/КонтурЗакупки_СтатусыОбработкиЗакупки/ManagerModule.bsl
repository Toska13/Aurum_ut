#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ПрограммныйИнтерфейс
// Получить массив статусов обработки по роли.
// 
// Параметры:
//  РольПользователя - ОбъектМетаданныхРоль - Роль пользователя
// 
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.КонтурЗакупки_СтатусыОбработкиЗакупки - Получить массив статусов обработки по роли
Функция ПолучитьМассивСтатусовОбработкиПоРоли(РольПользователя) Экспорт
	МассивСтатусов = Новый Массив;// - ПеречислениеСсылка.КонтурЗакупки_СтатусыОбработкиЗакупки
	Если РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделЛогистики Тогда
		МассивСтатусов.Добавить(НаСогласованииУЛогиста);
	ИначеЕсли РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделПродаж Тогда
		МассивСтатусов.Добавить(ПустаяСсылка());
		МассивСтатусов.Добавить(Новая);
		МассивСтатусов.Добавить(СогласованСЛогистом);
		МассивСтатусов.Добавить(ПоданаЗаявкаНаУчастие);
		МассивСтатусов.Добавить(ЗаключениеДоговора);
	ИначеЕсли РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделСнабжения Тогда
		МассивСтатусов.Добавить(ПринятВРаботу);
		МассивСтатусов.Добавить(Переторжка);
	КонецЕсли;
	Возврат МассивСтатусов;
КонецФункции
#КонецОбласти
#КонецЕсли