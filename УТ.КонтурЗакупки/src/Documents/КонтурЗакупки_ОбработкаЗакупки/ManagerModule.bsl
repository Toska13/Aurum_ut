#Область Печать

// Переопределяет настройки печати для объекта.
//
// Параметры:
//  Настройки - см. УправлениеПечатью.НастройкиПечатиОбъекта.
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт
	
	Настройки.ПриДобавленииКомандПечати = Истина;
	
КонецПроцедуры

// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - Структура - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
//@skip-check module-empty-method
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КонтурЗакупки_ОбработкаЗакупки_ПечатнаяФормаЗакупка";
	КомандаПечати.Представление = НСтр("ru = 'Закупка'");

КонецПроцедуры
	
// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив из ДокументСсылка    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений из ДокументСсылка - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
//@skip-check module-empty-method
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КонтурЗакупки_ОбработкаЗакупки_ПечатнаяФормаЗакупка");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"КонтурЗакупки_ОбработкаЗакупки_ПечатнаяФормаЗакупка",
			НСтр("ru = 'Закупка'"),
			СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати),
			,
			"Документ.КонтурЗакупки_ОбработкаЗакупки.ПФ_Закупка");
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КонтурЗакупки_ОбработкаЗакупки_ПечатнаяФормаЗакупка"; 
	
	Первый = Истина;
	
	Для Каждого ОбъектМассива Из МассивОбъектов Цикл
		
		Если Первый Тогда
			Первый = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокОбъектаПечати = СформироватьПечатнуюФормуЗакупка(ОбъектМассива);
		ТабличныйДокумент.Вывести(ТабДокОбъектаПечати);
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ТолькоПросмотр = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФормуЗакупка(СсылкаНаОбъектПечати)
	
	Макет = ПолучитьМакет("ПФ_Закупка");
	
	ДанныеДляПечати = ДанныеДляПечати(СсылкаНаОбъектПечати);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КонтурЗакупки_Закупка_ПечатнаяФорма"; 
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	//заполняем Области
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(ДанныеДляПечати);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	Если ДанныеДляПечати.ОбъектыЗакупки.Количество() > 0 Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбъектыЗакупкиШапка");
		ОбластьМакета.Параметры.Заполнить(ДанныеДляПечати);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбъектыЗакупки = ДанныеДляПечати.ОбъектыЗакупки;
		Для Каждого ОбъектЗакупки Из ОбъектыЗакупки Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("ОбъектыЗакупкиСтрока");
			ОбластьМакета.Параметры.Заполнить(ОбъектЗакупки);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
		
	КонецЕсли;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ТолькоПросмотр = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // СформироватьПечатнуюФормуДополнительногоОбъектаПечати()

Функция ДанныеДляПечати(ОбработкаЗакупки)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбработкаЗакупки.Номер КАК НомерОбработкиЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.Номер КАК Номер,
		|	ОбработкаЗакупки.ДокументОснования.Дата КАК Дата,
		|	ОбработкаЗакупки.ДокументОснования.Проведен КАК Проведен,
		|	ОбработкаЗакупки.ДокументОснования.Валюта КАК Валюта,
		|	ОбработкаЗакупки.ДокументОснования.ДатаОкончанияПодачиЗаявок КАК ДатаОкончанияПодачиЗаявок,
		|	ОбработкаЗакупки.ДокументОснования.ДатаПодведенияИтогов КАК ДатаПодведенияИтогов,
		|	ОбработкаЗакупки.ДокументОснования.ДатаПоследнегоИзмененияЗакупки КАК ДатаПоследнегоИзмененияЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.ДатаПроведенияАукциона КАК ДатаПроведенияАукциона,
		|	ОбработкаЗакупки.ДокументОснования.ДатаСозданияЗакупки КАК ДатаСозданияЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.ИдентификаторЗакупки КАК ИдентификаторЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.ИмяОписаниеЗакупки КАК ИмяОписаниеЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.КонтактныеДанныеИмя КАК КонтактныеДанныеИмя,
		|	ОбработкаЗакупки.ДокументОснования.КонтактныеДанныеТелефон КАК КонтактныеДанныеТелефон,
		|	ОбработкаЗакупки.ДокументОснования.КонтактныеДанныеЭлектроннаяПочта КАК КонтактныеДанныеЭлектроннаяПочта,
		|	ОбработкаЗакупки.ДокументОснования.НМЦЗакупки КАК НМЦЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.НомерЗакупки КАК НомерЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.ОрганизаторИНН КАК ОрганизаторИНН,
		|	ОбработкаЗакупки.ДокументОснования.ОрганизаторКПП КАК ОрганизаторКПП,
		|	ОбработкаЗакупки.ДокументОснования.ОрганизаторНаименование КАК ОрганизаторНаименование,
		|	ОбработкаЗакупки.ДокументОснования.ПризнакЗакупкаДляСМП КАК ПризнакЗакупкаДляСМП,
		|	ОбработкаЗакупки.ДокументОснования.СпособОтбора КАК СпособОтбора,
		|	ОбработкаЗакупки.ДокументОснования.СсылкаНаЗакупкуНаЕИС КАК СсылкаНаЗакупкуНаЕИС,
		|	ОбработкаЗакупки.ДокументОснования.СсылкаНаЗакупкуНаКЗ КАК СсылкаНаЗакупкуНаКЗ,
		|	ОбработкаЗакупки.ДокументОснования.СсылкаНаЗакупкуНаЭТП КАК СсылкаНаЗакупкуНаЭТП,
		|	ОбработкаЗакупки.ДокументОснования.СтатусЗакупки КАК СтатусЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.ТипЗакупки КАК ТипЗакупки,
		|	ОбработкаЗакупки.ДокументОснования.Комментарий КАК Комментарий,
		|	ОбработкаЗакупки.ДокументОснования.РучнойВвод КАК РучнойВвод,
		|	ОбработкаЗакупки.ОбъектыЗакупки.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		ВЫБОР
		|			КОГДА ОбработкаЗакупки.ОбъектыЗакупки.Номенклатура.НаименованиеПолное <> """"
		|				ТОГДА ОбработкаЗакупки.ОбъектыЗакупки.Номенклатура.НаименованиеПолное
		|			ИНАЧЕ ОбработкаЗакупки.ОбъектыЗакупки.Номенклатура.Наименование
		|		КОНЕЦ КАК Номенклатура,
		|		ОКВЭД2Код КАК ОКВЭД2Код,
		|		ОКВЭД2Расшифровка КАК ОКВЭД2Расшифровка,
