		|	Документ.КонтурЗакупки_ОбработкаЗакупки КАК ОбработкаЗакупки
		|ГДЕ
		|	ОбработкаЗакупки.Ссылка = &ОбработкаЗакупки";
	
	
	Запрос.УстановитьПараметр("ОбработкаЗакупки", ОбработкаЗакупки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаШапка = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаШапка.НомерЗакупки) Тогда
			Результат.Вставить("НомерЗакупки", ВыборкаШапка.НомерЗакупки);
		Иначе
			Результат.Вставить("НомерЗакупки", ВыборкаШапка.Номер);
		КонецЕсли;
		Результат.Вставить("НомерОбработкиЗакупки", ВыборкаШапка.НомерОбработкиЗакупки);
		Результат.Вставить("ИмяОписаниеЗакупки", ВыборкаШапка.ИмяОписаниеЗакупки);
		Результат.Вставить("ОрганизаторНаименование", ВыборкаШапка.ОрганизаторНаименование);
		Результат.Вставить("ОрганизаторИНН", ВыборкаШапка.ОрганизаторИНН);
		Результат.Вставить("ОрганизаторКПП", ВыборкаШапка.ОрганизаторКПП);
		Результат.Вставить("НМЦЗакупки", ВыборкаШапка.НМЦЗакупки);
		Результат.Вставить("ТипЗакупки", ВыборкаШапка.ТипЗакупки);
		Результат.Вставить("СпособОтбора", ВыборкаШапка.СпособОтбора);
		Результат.Вставить("КонтактныеДанныеИмя", ВыборкаШапка.КонтактныеДанныеИмя);
		Результат.Вставить("КонтактныеДанныеТелефон", ВыборкаШапка.КонтактныеДанныеТелефон);
		Результат.Вставить("КонтактныеДанныеЭлектроннаяПочта", ВыборкаШапка.КонтактныеДанныеЭлектроннаяПочта);
		Результат.Вставить("ДатаСозданияЗакупки", ВыборкаШапка.ДатаСозданияЗакупки);
		Результат.Вставить("ДатаОкончанияПодачиЗаявок", ВыборкаШапка.ДатаОкончанияПодачиЗаявок);
		Результат.Вставить("ДатаПодведенияИтогов", ВыборкаШапка.ДатаПодведенияИтогов);

		МассивОбъектовЗакупки = Новый Массив;
		ОбъектЗакупки = ВыборкаШапка.ОбъектыЗакупки.Выбрать();
		
		НомерСтроки = 1;
		
		Пока ОбъектЗакупки.Следующий() Цикл
			
			//Если ОбъектЗакупки.ПоставкаНевозможна Тогда
			//	Продолжить;
			//КонецЕсли;
			
			СтрокаОбъектЗакупки = Новый Структура;
			СтрокаОбъектЗакупки.Вставить("НомерСтроки", НомерСтроки);
			
			//НаименованиеОбъектаЗакупки = ?(ЗначениеЗаполнено(ОбъектЗакупки.Номенклатура), ОбъектЗакупки.Номенклатура, ОбъектЗакупки.НаименованиеОбъектаЗакупки);
			//СтрокаОбъектЗакупки.Вставить("НаименованиеОбъектаЗакупки", СтрШаблон("%1%2", ?(ОбъектЗакупки.ПоставкаНевозможна, "Поставка невозможна. ", ""), НаименованиеОбъектаЗакупки));
			
			НаименованиеОбъектаЗакупки = ?(ЗначениеЗаполнено(ОбъектЗакупки.Номенклатура), ОбъектЗакупки.Номенклатура, ОбъектЗакупки.НаименованиеОбъектаЗакупки);
			СтрокаОбъектЗакупки.Вставить("НаименованиеОбъектаЗакупки", НаименованиеОбъектаЗакупки);
			
			Если ЗначениеЗаполнено(ОбъектЗакупки.ОКПД2Код) Тогда
				СтрокаОбъектЗакупки.Вставить("ОКПД2", СтрШаблон("%1 %2", ОбъектЗакупки.ОКПД2Код, ОбъектЗакупки.ОКПД2Расшифровка));
			Иначе
				СтрокаОбъектЗакупки.Вставить("ОКПД2", "не указан");
			КонецЕсли;
			Если ЗначениеЗаполнено(ОбъектЗакупки.КТРУКод) Тогда
				СтрокаОбъектЗакупки.Вставить("КТРУ", СтрШаблон("%1 %2", ОбъектЗакупки.КТРУКод, ОбъектЗакупки.КТРУРасшифровка));
			Иначе
				СтрокаОбъектЗакупки.Вставить("КТРУ", "не указан");
			КонецЕсли;
			СтрокаОбъектЗакупки.Вставить("СтоимостьЗаЕдиницуОбъекта", ОбъектЗакупки.СтоимостьЗаЕдиницуОбъекта);
			СтрокаОбъектЗакупки.Вставить("Количество", ОбъектЗакупки.Количество);
			СтрокаОбъектЗакупки.Вставить("ЕдиницаИзмерения", ОбъектЗакупки.ЕдиницаИзмерения);
			СтрокаОбъектЗакупки.Вставить("ОбщаяСтоимостьОбъекта", ОбъектЗакупки.ОбщаяСтоимостьОбъекта);
			
			МассивОбъектовЗакупки.Добавить(СтрокаОбъектЗакупки);
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		Результат.Вставить("ОбъектыЗакупки", МассивОбъектовЗакупки);
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

