#Область ПрограммныйИнтерфейс
#Область ЗагрузкаИзФайла

// Производит сопоставление данных, загружаемых в табличную часть ПолноеИмяТабличнойЧасти,
// с данными в ИБ, и заполняет параметры АдресТаблицыСопоставления и СписокНеоднозначностей.
// 
// Параметры:
//  АдресЗагружаемыхДанных - Строка - адрес временного хранилища с таблицей значений, в которой
// находятся загруженные данные из файла.
//  АдресТаблицыСопоставления - Строка - адрес временного хранилища с пустой таблицей значений,
// являющейся копией табличной части документа,
// которую необходимо заполнить из таблицы АдресЗагружаемыхДанных.
//  СписокНеоднозначностей - ТаблицаЗначений - состоит из:
// * Идентификатор - Число - идентификатор
// * Колонка - Строка - имя колонки
//  ПолноеИмяТабличнойЧасти - Строка - полное имя табличной части
//  ДополнительныеПараметры - Структура - дополнительные параметры, переданные из формы-источнике.
Процедура СопоставитьЗагружаемыеДанные(АдресЗагружаемыхДанных, АдресТаблицыСопоставления, СписокНеоднозначностей,
	ПолноеИмяТабличнойЧасти, ДополнительныеПараметры) Экспорт

	ТЗОбъектовЗакупки = ПолучитьИзВременногоХранилища(АдресТаблицыСопоставления); // ТаблицаЗначений
	ЗагружаемыеДанные = ПолучитьИзВременногоХранилища(АдресЗагружаемыхДанных); // ТаблицаЗначений

	Для Каждого СтрокаЗагружаемых Из ЗагружаемыеДанные Цикл
		СтрокаТЧ = ТЗОбъектовЗакупки.Добавить();
		СтрокаТЧ.НаименованиеОбъектаЗакупки = СтрокаЗагружаемых.НаименованиеОбъектаЗакупки; // Строка

		СтрокаТЧ.ОбъектЗакупки = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.НайтиСоздатьОбъектЗакупки(
			СтрокаТЧ); // СправочникСсылка.КонтурЗакупки_ОбъектыЗакупки

		СтрокаТЧ.Номенклатура = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьНоменклатуруПоОбъектуЗакупки(
			ДополнительныеПараметры.МассивОрганизаторов, СтрокаТЧ.ОбъектЗакупки);
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			СтруктураДанныеНоменклатуры = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьДанныеНоменклатуры(
					СтрокаТЧ.Номенклатура);
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураДанныеНоменклатуры);
		КонецЕсли;

		Если Не ПустаяСтрока(СтрокаЗагружаемых.ГородЗаказчикаСтрокой) Тогда
			СтруктураГород = Новый Структура("Наименование", СокрЛП(СтрокаЗагружаемых.ГородЗаказчикаСтрокой));

			СтрокаТЧ.ГородЗаказчика = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.НайтиСоздатьСправочникПоНаименованию(
					"КонтурЗакупки_Города", СтруктураГород);
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаЗагружаемых);
	КонецЦикла;

	ПоместитьВоВременноеХранилище(ТЗОбъектовЗакупки, АдресТаблицыСопоставления);
КонецПроцедуры

// Переопределяет параметры загрузки данных из файла.
// 
// Параметры:
//  Параметры - Структура - :
// * ИмяМакетаСШаблоном - Строка - наименование макета. Например, "ЗагрузкаИзФайла".
// * ИмяТабличнойЧасти - Строка - Полное имя табличной части. Например,
//                                "Документ._ДемоСчетНаОплатуПокупателю.ТабличнаяЧасть.Товары".
// * ОбязательныеКолонки - Массив из Строка - наименования обязательных для заполнения колонок.
// * ТипДанныхКолонки - Соответствие из КлючИЗначение - 
// * Ключ - Строка - имя колонки;
// * Значение - ОписаниеТипов - тип колонки загружаемых данных.
// * ДополнительныеПараметры - Структура - 
Процедура УстановитьПараметрыЗагрузкиИзФайлаВТЧ(Параметры) Экспорт

	ТипДанныхКолонки = Параметры.ТипДанныхКолонки; // Соответствие
	ТипДанныхКолонки.Вставить("НаименованиеОбъектаЗакупки",
		КонтурЗакупки_СлужебныеКлиентСервер.Новый_ОписаниеТиповСтрока(1024));
	ТипДанныхКолонки.Вставить("Количество", КонтурЗакупки_СлужебныеКлиентСервер.Новый_ОписаниеТиповЧисло(15, 2));
	ТипДанныхКолонки.Вставить("СтоимостьЗаЕдиницу", КонтурЗакупки_СлужебныеКлиентСервер.Новый_ОписаниеТиповЧисло(
			15, 2));
	ТипДанныхКолонки.Вставить("ОбщаяСтоимость", КонтурЗакупки_СлужебныеКлиентСервер.Новый_ОписаниеТиповЧисло(15, 2));

	МассивОбязательныхКолонок = Новый Массив; // Массив из Строка
	МассивОбязательныхКолонок.Добавить("НаименованиеОбъектаЗакупки");

	Параметры.ОбязательныеКолонки = МассивОбязательныхКолонок;

КонецПроцедуры

#КонецОбласти
#КонецОбласти

#Область ОбработчикиСобытий
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьОрганизатораИзТабличнойЧасти() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЗакупки_ОбработкаЗакупки.Ссылка КАК ОбрЗакупкиСсылка,
	|	КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.ОрганизаторЗаказчик КАК ОрганизаторЗаказчик
	|ИЗ
	|	Документ.КонтурЗакупки_ОбработкаЗакупки КАК КонтурЗакупки_ОбработкаЗакупки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Ссылка,
	|			МАКСИМУМ(ОрганизаторЗаказчик) КАК ОрганизаторЗаказчик
	|		ИЗ
	|			Документ.КонтурЗакупки_ОбработкаЗакупки.ОрганизаторыЗаказчики
	|		СГРУППИРОВАТЬ ПО
	|			Ссылка) КАК КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики
	|		ПО КонтурЗакупки_ОбработкаЗакупкиОрганизаторыЗаказчики.Ссылка = КонтурЗакупки_ОбработкаЗакупки.Ссылка
	|ГДЕ
	|	КонтурЗакупки_ОбработкаЗакупки.Организатор = ЗНАЧЕНИЕ(Справочник.КонтурЗакупки_ОрганизаторыЗаказчики.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.ОбрЗакупкиСсылка.ПолучитьОбъект(); // ДокументОбъект.КонтурЗакупки_ОбработкаЗакупки
		ДокОбъект.Организатор = Выборка.ОрганизаторЗаказчик;
		ДокОбъект.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ПолучитьСтруктуруНаценки() Экспорт
	СтруктураНаценки = Новый Структура;
	СтруктураНаценки.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	СтруктураНаценки.Вставить("ГородПоставщика", Справочники.КонтурЗакупки_Города.ПустаяСсылка());
	СтруктураНаценки.Вставить("ОбъектЗакупки", Справочники.КонтурЗакупки_ОбъектыЗакупки.ПустаяСсылка());
	СтруктураНаценки.Вставить("ГруппировкаНаценки", "");
	СтруктураНаценки.Вставить("КолонкиГруппировкиНаценки", "");
	СтруктураНаценки.Вставить("ПредставлениеГруппировкиНаценки", "");
	СтруктураНаценки.Вставить("ГородЗаказчика", Справочники.КонтурЗакупки_Города.ПустаяСсылка());
	СтруктураНаценки.Вставить("ПроцентНаценки", 0);
	Возврат СтруктураНаценки;
КонецФункции

