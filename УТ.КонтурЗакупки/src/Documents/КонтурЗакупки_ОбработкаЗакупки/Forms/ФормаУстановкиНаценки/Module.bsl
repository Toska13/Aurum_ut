#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресХраненияТаблицыОбъектыЗакупки = Параметры.АдресХраненияТаблицыОбъектыЗакупки;
	АдресХраненияСтруктурыНаценки = Параметры.АдресХраненияСтруктурыНаценки;
	ЗаполнитьГруппировкиНаценки();
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтборПоОбъектамНаценки

&НаКлиенте
Процедура ОтборПоОбъектамЗатратПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ОтборПоОбъектамНаценки.ТекущиеДанные;
	ПрименитьОтборКОбъектамНаценки(ТекущиеДанные);

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппировкиНаценки

&НаКлиенте
Процедура ГруппировкиЗатратПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ГруппировкиНаценки.ТекущиеДанные;
	ЗаполнитьОтборПоОбъектамНаценки(ТекущиеДанные.ГруппировкаНаценки, ТекущиеДанные.КолонкиГруппировкиНаценки,
		ТекущиеДанные.ПредставлениеГруппировкиНаценки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НазначитьЗатраты(Команда)

	АдресХраненияТаблицыОбъектыЗатрат = ПолучитьАдресХраненияСтруктурыНаценок();
	Закрыть(АдресХраненияТаблицыОбъектыЗатрат);

КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить группировки наценки.
&НаСервере
Процедура ЗаполнитьГруппировкиНаценки()

	НовСтрока = ГруппировкиНаценки.Добавить();
	НовСтрока.ПредставлениеГруппировкиНаценки = "Все строки";
	НовСтрока.ГруппировкаНаценки = "ВсеСтроки";
	НовСтрока.КолонкиГруппировкиНаценки = "";

	НовСтрока = ГруппировкиНаценки.Добавить();
	НовСтрока.ПредставлениеГруппировкиНаценки = "Поставщик";
	НовСтрока.ГруппировкаНаценки = "Контрагент";
	НовСтрока.КолонкиГруппировкиНаценки = "Контрагент";

	НовСтрока = ГруппировкиНаценки.Добавить();
	НовСтрока.ПредставлениеГруппировкиНаценки = "Город поставщика";
	НовСтрока.ГруппировкаНаценки = "ГородПоставщика";
	НовСтрока.КолонкиГруппировкиНаценки = "ГородПоставщика";

	НовСтрока = ГруппировкиНаценки.Добавить();
	НовСтрока.ПредставлениеГруппировкиНаценки = "Город заказчика";
	НовСтрока.ГруппировкаНаценки = "ГородЗаказчика";
	НовСтрока.КолонкиГруппировкиНаценки = "ГородЗаказчика";

	НовСтрока = ГруппировкиНаценки.Добавить();
	НовСтрока.ПредставлениеГруппировкиНаценки = "Объект закупки";
	НовСтрока.ГруппировкаНаценки = "ОбъектЗакупки";
	НовСтрока.КолонкиГруппировкиНаценки = "ОбъектЗакупки";

	НовСтрока = ГруппировкиНаценки.Добавить();
	НовСтрока.ПредставлениеГруппировкиНаценки = "Поставщик и город (поставщика)";
	НовСтрока.ГруппировкаНаценки = "КонтрагентГородПоставщика";
	НовСтрока.КолонкиГруппировкиНаценки = "Контрагент,ГородПоставщика";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтборПоОбъектамНаценки(ГруппировкаЗатрат, КолонкиГруппировкиЗатрат, ПредставлениеГруппировкиЗатрат)

	Если Не ПустаяСтрока(КолонкиГруппировкиЗатрат) Тогда

		Элементы.ОтборПоОбъектамНаценкиГруппировкаНаценки.Видимость = Ложь;
		ТаблицаИзХранилища = ПолучитьИзВременногоХранилища(АдресХраненияТаблицыОбъектыЗакупки);
		//оказывается таблица в хранилище портится
		ВременнаяТЗ = ТаблицаИзХранилища.Скопировать();
		ВременнаяТЗ.Свернуть(КолонкиГруппировкиЗатрат);
		ВременнаяТЗ.Колонки.Добавить("ПредставлениеГруппировкиНаценки");
		ВременнаяТЗ.Колонки.Добавить("ГруппировкаНаценки");
		ВременнаяТЗ.Колонки.Добавить("КолонкиГруппировкиНаценки");
		ВременнаяТЗ.ЗаполнитьЗначения(ГруппировкаЗатрат, "ГруппировкаНаценки");
		ВременнаяТЗ.ЗаполнитьЗначения(КолонкиГруппировкиЗатрат, "КолонкиГруппировкиНаценки");
		ВременнаяТЗ.ЗаполнитьЗначения(ПредставлениеГруппировкиЗатрат, "ПредставлениеГруппировкиНаценки");

	Иначе

		Элементы.ОтборПоОбъектамНаценкиГруппировкаНаценки.Видимость = Истина;
		ВременнаяТЗ = Новый ТаблицаЗначений;
		ВременнаяТЗ.Колонки.Добавить("ПредставлениеГруппировкиНаценки");
		ВременнаяТЗ.Колонки.Добавить("ГруппировкаНаценки");
		ВременнаяТЗ.Колонки.Добавить("КолонкиГруппировкиНаценки");

		ВременнаяТЗ.Добавить();
		ВременнаяТЗ.ЗаполнитьЗначения(ГруппировкаЗатрат, "ГруппировкаНаценки");
		ВременнаяТЗ.ЗаполнитьЗначения(КолонкиГруппировкиЗатрат, "КолонкиГруппировкиНаценки");
		ВременнаяТЗ.ЗаполнитьЗначения(ПредставлениеГруппировкиЗатрат, "ПредставлениеГруппировкиНаценки");

	КонецЕсли;

	ОтборПоОбъектамНаценки.Загрузить(ВременнаяТЗ);

	МассивКолонок = ПолучитьМассивКолонокОтборПоОбъектамЗатрат();
	Для Каждого КолонкаИмя Из МассивКолонок Цикл
		ЭлементФормы = Элементы.Найти("ОтборПоОбъектамНаценки" + КолонкаИмя);
		Если Не ЭлементФормы = Неопределено И Не КолонкаИмя = "ГруппировкаНаценки" И Не КолонкаИмя
			= "КолонкиГруппировкиНаценки" Тогда
			Если Не ВременнаяТЗ.Колонки.Найти(КолонкаИмя) = Неопределено Тогда
				ЭлементФормы.Видимость = Истина;
			Иначе
				ЭлементФормы.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивКолонокОтборПоОбъектамЗатрат()

	Результат = Новый Массив;

	ТЗОтбораПоОбъектамЗатрат = ОтборПоОбъектамНаценки.Выгрузить();
	Для Каждого Колонка Из ТЗОтбораПоОбъектамЗатрат.Колонки Цикл
		Результат.Добавить(Колонка.Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПрименитьОтборКОбъектамНаценки(ТекущиеДанные)

	Если Не ТекущиеДанные = Неопределено Тогда
		ГруппировкаНаценки = ТекущиеДанные.ГруппировкаНаценки;
		ПредставлениеГруппировкиНаценки = ТекущиеДанные.ПредставлениеГруппировкиНаценки;

		Если Не ПустаяСтрока(ТекущиеДанные.КолонкиГруппировкиНаценки) Тогда
			КолонкиГруппировкиНаценки = ТекущиеДанные.КолонкиГруппировкиНаценки;
		КонецЕсли;

		Контрагент = ТекущиеДанные.Контрагент;
		Если ЗначениеЗаполнено(ТекущиеДанные.Контрагент) Тогда
			Элементы.Контрагент.Видимость = Истина;
		Иначе
			Элементы.Контрагент.Видимость = Ложь;
		КонецЕсли;

		ГородПоставщика = ТекущиеДанные.ГородПоставщика;
		Если ЗначениеЗаполнено(ТекущиеДанные.ГородПоставщика) Тогда
			Элементы.ГородПоставщика.Видимость = Истина;
		Иначе
			Элементы.ГородПоставщика.Видимость = Ложь;
		КонецЕсли;

		ГородЗаказчика = ТекущиеДанные.ГородЗаказчика;
		Если ЗначениеЗаполнено(ТекущиеДанные.ГородЗаказчика) Тогда
			Элементы.ГородЗаказчика.Видимость = Истина;
		Иначе
			Элементы.ГородЗаказчика.Видимость = Ложь;
		КонецЕсли;

		ОбъектЗакупки = ТекущиеДанные.ОбъектЗакупки;
		Если ЗначениеЗаполнено(ТекущиеДанные.ОбъектЗакупки) Тогда
			Элементы.ОбъектЗакупки.Видимость = Истина;
		Иначе
			Элементы.ОбъектЗакупки.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьАдресХраненияСтруктурыНаценок()

	СтруктураНаценки = Документы.КонтурЗакупки_ОбработкаЗакупки.ПолучитьСтруктуруНаценки();
	ЗаполнитьЗначенияСвойств(СтруктураНаценки, ЭтотОбъект);
	АдресХраненияСтруктурыНаценки = ПоместитьВоВременноеХранилище(СтруктураНаценки, АдресХраненияСтруктурыНаценки);
	Возврат АдресХраненияСтруктурыНаценки;

КонецФункции

#КонецОбласти