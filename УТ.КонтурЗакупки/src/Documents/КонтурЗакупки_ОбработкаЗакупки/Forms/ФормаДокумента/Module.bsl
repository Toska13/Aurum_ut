&НаКлиенте
Процедура ПослеОтветаОСозданииСделки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = "Открыть" Тогда

		Если ДополнительныеПараметры.Количество() = 1 Тогда
			СтруктураСделка = Новый Структура("Ключ", ДополнительныеПараметры[0]);
			ОткрытьФорму("Справочник.СделкиСКлиентами.ФормаОбъекта", СтруктураСделка);
		Иначе
			СписокВыбора = Новый СписокЗначений;
			СписокВыбора.ЗагрузитьЗначения(ДополнительныеПараметры);

			ПослеВыбораСделки = Новый ОписаниеОповещения("ПослеВыбораСделки", ЭтотОбъект);
			СписокВыбора.ПоказатьВыборЭлемента(ПослеВыбораСделки);
		КонецЕсли;
	ИначеЕсли РезультатВопроса = "Создать" Тогда
		СделкаСсылка = СоздатьСделкуНаКлиенте();
		СтруктураСделка = Новый Структура("Ключ", СделкаСсылка);
		ОткрытьФорму("Справочник.СделкиСКлиентами.ФормаОбъекта", СтруктураСделка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСделки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	Если Не ВыбранныйЭлемент = Неопределено Тогда
		СтруктураСделка = Новый Структура("Ключ", ВыбранныйЭлемент.Значение);
		ОткрытьФорму("Справочник.СделкиСКлиентами.ФормаОбъекта", СтруктураСделка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СоздатьСделкуНаКлиенте()
	ОписаниеРезультата = "";
	ТипОбъекта = КонтурЗакупки_ЛокализацияВызовСервера.ПредставлениеТипаСделка();
	СделкаСсылка = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
				"СоздатьСделку", Объект.Ссылка, Истина);

	Если СделкаСсылка = Неопределено Тогда
		Если КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьСделку(Объект.Ссылка, СделкаСсылка,
			ОписаниеРезультата) Тогда

			КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(
						Объект.Ссылка, ТипОбъекта, Строка(СделкаСсылка.УникальныйИдентификатор()),
				СделкаСсылка.УникальныйИдентификатор(), Строка(СделкаСсылка));
		Иначе
			КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеРезультата);
		КонецЕсли;
	Иначе
		КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(Объект.Ссылка,
			ТипОбъекта, Строка(СделкаСсылка.УникальныйИдентификатор()), СделкаСсылка.УникальныйИдентификатор(), Строка(
			СделкаСсылка));
	КонецЕсли;
	Возврат СделкаСсылка;
КонецФункции

