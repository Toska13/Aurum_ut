&НаКлиенте
Процедура КомандаСоздатьЗаказКлиента(Команда)
	ОписаниеРезультата = "";
	ТипОбъекта = КонтурЗакупки_ЛокализацияВызовСервера.ПредставлениеТипаЗаказКлиента();
	ЗаказКлиентаСсылка  = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьСсылкуНаОбъектИзПривязки(
		Объект.Ссылка, ТипОбъекта, "");
	Создавать = Ложь;

	Если ЗаказКлиентаСсылка = Неопределено Тогда
		Создавать = Истина;
	КонецЕсли;

	Если Создавать Тогда
		ЗаказКлиентаСсылка = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"СоздатьЗаказКлиента", Объект.Ссылка, Истина);

		Если ЗаказКлиентаСсылка = Неопределено Тогда
			Если КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьЗаказКлиента(Объект.Ссылка,
				ЗаказКлиентаСсылка, ОписаниеРезультата) Тогда

				КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(
					Объект.Ссылка, ТипОбъекта, "", ЗаказКлиентаСсылка.УникальныйИдентификатор(), Строка(
					ЗаказКлиентаСсылка));
			Иначе
				КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеРезультата);
			КонецЕсли;
		Иначе
			КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(Объект.Ссылка,
				ТипОбъекта, "", ЗаказКлиентаСсылка.УникальныйИдентификатор(), Строка(ЗаказКлиентаСсылка));
		КонецЕсли;
	КонецЕсли;

	СтруктураЗаказКлиента = Новый Структура("Ключ", ЗаказКлиентаСсылка);
		//@skip-check bsl-legacy-check-string-literal
	ОткрытьФорму("Документ.ЗаказКлиента.ФормаОбъекта", СтруктураЗаказКлиента);
КонецПроцедуры

