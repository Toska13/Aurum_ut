&НаКлиенте
Процедура ДанныеПоставкиСуммаПоставщикаПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ДанныеПоставки.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);

		ПриИзмененииСуммыПоставщика(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоставкиСуммаПоставщикаБезНДСПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ДанныеПоставки.ТекущаяСтрока;

	Если Не ИДТекущейСтроки = Неопределено Тогда
	
		//@skip-check invocation-parameter-type-intersect
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		Если Не ТекущаяСтрока.КоличествоПоставщика = 0 Тогда
			ТекущаяСтрока.ЦенаПоставщикаБезНДС = ТекущаяСтрока.СуммаПоставщикаБезНДС
				/ ТекущаяСтрока.КоличествоПоставщика;

			ТекущаяСтрока.СуммаПоставщика = КонтурЗакупки_ЛокализацияУТ11_РасчетНДСКлиентСервер.ПолучитьСуммуСНДС(
					ТекущаяСтрока.СуммаПоставщикаБезНДС, ТекущаяСтрока.СтавкаНДСПоставщика);

