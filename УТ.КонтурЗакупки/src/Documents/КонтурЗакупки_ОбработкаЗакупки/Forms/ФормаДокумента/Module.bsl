&НаКлиенте
Процедура КомандаСоздатьОбъектПодключаемая(Команда)
	
	ОписаниеРезультата = "";
	
	ПМ_КомандаСоздатьОбъектПодключаемая = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ОбработкаЗакупкиКомандаСоздатьОбъектПодключаемая", Неопределено, Ложь);
	ТипОбъекта = ПМ_КомандаСоздатьОбъектПодключаемая["ТипОбъекта"];
	РезультатСсылка  = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьСсылкуНаОбъектИзПривязки(
		Объект.Ссылка, ТипОбъекта, "");
		
	Если Не ЗначениеЗаполнено(РезультатСсылка) Тогда
		РезультатСсылка = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"ОбработкаЗакупкиСоздатьОбъектПодключаемая", Объект.Ссылка, Истина);
		Если РезультатСсылка <> Неопределено Тогда
			КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(Объект.Ссылка,
				ТипОбъекта, "", РезультатСсылка.УникальныйИдентификатор(), Строка(РезультатСсылка));
		КонецЕсли;
	КонецЕсли;

	ПоказатьЗначение(, РезультатСсылка);
	
КонецПроцедуры

