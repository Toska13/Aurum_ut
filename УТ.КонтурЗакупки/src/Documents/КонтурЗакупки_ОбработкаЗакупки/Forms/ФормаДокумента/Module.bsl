#Область ОбработчикиСобытийЭлементовТаблицыФормыОрганизаторыЗаказчики
&НаКлиенте
Процедура ОрганизаторыЗаказчикиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Копирование Тогда
		Элемент.ТекущиеДанные.ЭтоОрганизатор = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизаторыЗаказчикиПередНачаломИзменения(Элемент, Отказ)
	ИДСтроки = Элементы.ОрганизаторыЗаказчики.ТекущаяСтрока;
	Если Элемент.ТекущиеДанные.ЭтоОрганизатор Тогда
		Отказ = Истина;
	Иначе
		Для Каждого СтрокаОЗ Из Объект.ОрганизаторыЗаказчики Цикл
			Если СтрокаОЗ.ЭтоОрганизатор И Не СтрокаОЗ.ПолучитьИдентификатор() = ИДСтроки Тогда
				СтрокаОЗ.ЭтоОрганизатор = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизаторыЗаказчикиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если Элемент.ТекущиеДанные.ЭтоОрганизатор Тогда
		Объект.Организатор = Элемент.ТекущиеДанные.ОрганизаторЗаказчик;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаСоздатьЗадачуСотруднику(Команда)
	ОписаниеРезультата = "";
	ТипОбъекта = КонтурЗакупки_ЛокализацияВызовСервера.ПредставлениеТипаЗадачаСотрудника();
	ЗадачаСсылка = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьСсылкуНаОбъектИзПривязки(
		Объект.Ссылка, ТипОбъекта, "");
	Создавать = Ложь;

	Если ЗадачаСсылка = Неопределено Тогда
		Создавать = Истина;
	КонецЕсли;

	Если Создавать Тогда
		ЗадачуСотрудникуСсылка = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"СоздатьЗадачуСотруднику", Объект.Ссылка, Истина);

		Если ЗадачуСотрудникуСсылка = Неопределено Тогда
			Если КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьЗадачуСотруднику(Объект.Ссылка,
				ЗадачаСсылка, ОписаниеРезультата) Тогда

				КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(
					Объект.Ссылка, ТипОбъекта, "", ЗадачаСсылка.УникальныйИдентификатор(), Строка(ЗадачаСсылка));
			Иначе
				КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеРезультата);
			КонецЕсли;
		Иначе
			КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьПривязкуОбработкиЗакупки(Объект.Ссылка,
				ТипОбъекта, "", ЗадачаСсылка.УникальныйИдентификатор(), Строка(ЗадачаСсылка));
		КонецЕсли;
	КонецЕсли;

	СтруктураЗадача = Новый Структура("Ключ", ЗадачаСсылка);
		//@skip-check bsl-legacy-check-string-literal
	ОткрытьФорму("Документ.ЗадачаСотрудника.ФормаОбъекта", СтруктураЗадача);

КонецПроцедуры

