&НаКлиенте
Процедура КомандаСоздатьСделку(Команда)
	ТипОбъекта = КонтурЗакупки_ЛокализацияВызовСервера.ПредставлениеТипаСделка();
	МассивСделкаСсылка  = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьМассивСсылокНаОбъектИзПривязки(
		Объект.Ссылка, ТипОбъекта);

	Если МассивСделкаСсылка.Количество() > 0 Тогда
		СписокКнопокВопроса = Новый СписокЗначений;
		СписокКнопокВопроса.Добавить("Открыть", НСтр("ru='Открыть существующую'"));
		СписокКнопокВопроса.Добавить("Создать", НСтр("ru='Создать новую'"));
		СписокКнопокВопроса.Добавить("Отмена", НСтр("ru='Отмена'"));
		ПослеОтветаОСозданииСделки = Новый ОписаниеОповещения("ПослеОтветаОСозданииСделки", ЭтотОбъект,
			МассивСделкаСсылка);
		ПоказатьВопрос(ПослеОтветаОСозданииСделки, НСтр("ru='Сделка уже существует'"), СписокКнопокВопроса);
	Иначе
		СделкаСсылка = СоздатьСделкуНаКлиенте();
		ОткрытьФорму("Справочник.СделкиСКлиентами.ФормаОбъекта", Новый Структура("Ключ", СделкаСсылка));
	КонецЕсли;
КонецПроцедуры

