&НаКлиенте
Процедура ДанныеПоставкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДанныеПоставкиПоставкаНевозможна" Тогда
		
		Модифицированность = Истина;
		ТекущиеДанные = Элементы.ДанныеПоставки.ТекущиеДанные;
		ПоставкаНевозможна = Не ТекущиеДанные.ПоставкаНевозможна;
		ТекущиеДанные.ПоставкаНевозможна = ПоставкаНевозможна;
		
		Если ПоставкаНевозможна  И СтрокаОбъектаЗакупкиЗаполнена(ТекущиеДанные) Тогда
			ДополнительныеПараметры = Новый Структура("ТекущаяСтрока", ТекущиеДанные);
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОчистка", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Очистить данные в строке?';"
			+ " en = 'Clean row data?'"), Режим, 0);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЖелаемаяДатаПодсказка()
	
	ТекстПодсказки = "";
	
	Если ЗначениеЗаполнено(Объект.ДокументОснования) Тогда
		
		РеквизитыЗакупки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДокументОснования, "ДатаОкончанияПодачиЗаявок,ДатаПроведенияАукциона");
		Если ЗначениеЗаполнено(РеквизитыЗакупки.ДатаОкончанияПодачиЗаявок) Тогда
			ТекстПодсказки = СтрШаблон(НСтр("ru='Окончание подачи заявок (MSK): %1'", "ru"), Формат(РеквизитыЗакупки.ДатаОкончанияПодачиЗаявок, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(РеквизитыЗакупки.ДатаПроведенияАукциона) Тогда
			ТекстПодсказки = СтрШаблон(НСтр("ru='Дата проведения аукциона (MSK): %1'", "ru"), Формат(РеквизитыЗакупки.ДатаПроведенияАукциона, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ЖелаемаяДатаРасширеннаяПодсказка.Заголовок = ТекстПодсказки;
	
КонецПроцедуры

#КонецОбласти