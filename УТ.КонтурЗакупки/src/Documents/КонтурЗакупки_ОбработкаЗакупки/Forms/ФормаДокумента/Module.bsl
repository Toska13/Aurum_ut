&НаКлиенте
Процедура ЗагрузитьОбъектыЗакупки()
	ПараметрыЗагрузки = ЗагрузкаДанныхИзФайлаКлиент.ПараметрыЗагрузкиДанных();
	ПараметрыЗагрузки.ПолноеИмяТабличнойЧасти = "Документ.КонтурЗакупки_ОбработкаЗакупки.ОбъектыЗакупки";
	ПараметрыЗагрузки.Заголовок = НСтр("ru = 'Загрузка из файла'");
	СтруктураДопПараметры = Новый Структура;
	СтруктураДопПараметры.Вставить("МассивОрганизаторов", ПолучитьМассивОрганизаторов());
	ПараметрыЗагрузки.ДополнительныеПараметры = СтруктураДопПараметры;

	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтотОбъект);
	ЗагрузкаДанныхИзФайлаКлиент.ПоказатьФормуЗагрузки(ПараметрыЗагрузки, Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура НазначитьЗатратыНаКлиенте()
	Оповещение = Новый ОписаниеОповещения("ПослеНазначенияЗатрат", ЭтотОбъект);
	ПараметрыНазначенияЗатрат = Новый Структура;
	ПараметрыНазначенияЗатрат.Вставить("АдресХраненияТаблицыОбъектыЗакупки",
		ПолучитьАдресХраненияТаблицыОбъектыЗакупки());
	ПараметрыНазначенияЗатрат.Вставить("АдресХраненияТаблицыОбъектыЗатрат", ПолучитьАдресХраненияТаблицыОбъектыЗатрат());
	ОткрытьФорму("Документ.КонтурЗакупки_ОбработкаЗакупки.Форма.ФормаРаспределенияЗатрат", ПараметрыНазначенияЗатрат, ,
		, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаценкиНаКлиенте()
	Оповещение = Новый ОписаниеОповещения("ПослеУстановкиНаценки", ЭтотОбъект);
	ПараметрыУстановкиНаценки = Новый Структура;
	ПараметрыУстановкиНаценки.Вставить("АдресХраненияТаблицыОбъектыЗакупки",
		ПолучитьАдресХраненияТаблицыОбъектыЗакупки());
	ПараметрыУстановкиНаценки.Вставить("АдресХраненияСтруктурыНаценки", ПолучитьАдресХраненияСтруктурыНаценки());
	ОткрытьФорму("Документ.КонтурЗакупки_ОбработкаЗакупки.Форма.ФормаУстановкиНаценки", ПараметрыУстановкиНаценки, , ,
		, , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеЗатратНаСервере()
	ОчиститьПредставлениеЗатрат();

	ТаблицаГруппировок = Объект.ОбъектыЗатрат.Выгрузить();
	ТаблицаГруппировок.Свернуть("ГруппировкаЗатрат, КолонкиГруппировкиЗатрат");

	Для Каждого СтрокаГруппировки Из ТаблицаГруппировок Цикл

		Если СтрокаГруппировки.ГруппировкаЗатрат = "ВсеСтроки" Тогда
			ОтборПоЗатратам = Новый Структура("ГруппировкаЗатрат", СтрокаГруппировки.ГруппировкаЗатрат);
			НашлиСтрокиЗатрат = Объект.ОбъектыЗатрат.НайтиСтроки(ОтборПоЗатратам);
			Для Каждого НашлиСтрокуЗатрат Из НашлиСтрокиЗатрат Цикл      
				// каждая строка это затрата.
				Для Каждого СтрокаИтог Из Объект.ОбъектыЗакупки Цикл
					СтрокаИтог.ПредставлениеЗатрат = Строка(СтрокаИтог.ПредставлениеЗатрат) + Строка(
						НашлиСтрокуЗатрат.СтатьяЗатрат) + " (" + Строка(НашлиСтрокуЗатрат.Сумма) + ")" + "; ";
				КонецЦикла;
			КонецЦикла;
		Иначе
			ОтборПоЗатратам = Новый Структура("ГруппировкаЗатрат", СтрокаГруппировки.ГруппировкаЗатрат);
			НашлиСтрокиЗатрат = Объект.ОбъектыЗатрат.НайтиСтроки(ОтборПоЗатратам);
			Для Каждого НашлиСтрокуЗатрат Из НашлиСтрокиЗатрат Цикл 
				// нужен отбор для поиска строк в объектах закупок  
				ТекОтбор = Новый Структура(СтрокаГруппировки.КолонкиГруппировкиЗатрат);
				ЗаполнитьЗначенияСвойств(ТекОтбор, НашлиСтрокуЗатрат);
				НашлиСтрокиОбъектовЗакупки = Объект.ОбъектыЗакупки.НайтиСтроки(ТекОтбор);
				Для Каждого НашлиСтроку Из НашлиСтрокиОбъектовЗакупки Цикл
					НашлиСтроку.ПредставлениеЗатрат = Строка(НашлиСтроку.ПредставлениеЗатрат) + Строка(
						НашлиСтрокуЗатрат.СтатьяЗатрат) + " (" + Строка(НашлиСтрокуЗатрат.Сумма) + ")" + "; ";
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Получить массив строк объектов закупки по группировке затрат.
// 
// Параметры:
//  СтрокаОбъектаЗатрат - ДанныеФормыЭлементКоллекции - Строка объекта затрат
// 
// Возвращаемое значение:
//  Массив Из ДанныеФормыЭлементКоллекции, ДанныеФормыКоллекция - Получить массив строк объектов закупки по группировке затрат
&НаСервере
Функция ПолучитьСтрокиОбъектовЗакупкиПоГруппировкеЗатрат(СтрокаОбъектаЗатрат)
	МассивСтрок = Новый Массив;
	Если СтрокаОбъектаЗатрат.ГруппировкаЗатрат = "ВсеСтроки" Тогда
		МассивСтрок	= Объект.ОбъектыЗакупки;
	Иначе
		ТекОтбор = Новый Структура(СтрокаОбъектаЗатрат.КолонкиГруппировкиЗатрат);
		ЗаполнитьЗначенияСвойств(ТекОтбор, СтрокаОбъектаЗатрат);
		МассивСтрок = Объект.ОбъектыЗакупки.НайтиСтроки(ТекОтбор);
	КонецЕсли;

	Возврат МассивСтрок;
КонецФункции

&НаСервере
Функция ПолучитьСтрокиОбъектовЗакупкиПоГруппировкеНаценки(СтруктураНаценки)
	МассивСтрок = Новый Массив;
	Если СтруктураНаценки.ГруппировкаНаценки = "ВсеСтроки" Тогда
		МассивСтрок	= Объект.ОбъектыЗакупки;
	Иначе
		ТекОтбор = Новый Структура(СтруктураНаценки.КолонкиГруппировкиНаценки);
		ЗаполнитьЗначенияСвойств(ТекОтбор, СтруктураНаценки);
		МассивСтрок = Объект.ОбъектыЗакупки.НайтиСтроки(ТекОтбор);
	КонецЕсли;

	Возврат МассивСтрок;
КонецФункции

&НаСервере
Процедура ЗагрузитьТаблицуОбъектыЗатрат(РезультатЗакрытия)
	Объект.ОбъектыЗатрат.Загрузить(ПолучитьИзВременногоХранилища(РезультатЗакрытия));
КонецПроцедуры

&НаКлиенте
Процедура ПослеНазначенияЗатрат(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если Не РезультатЗакрытия = Неопределено И Не ПустаяСтрока(РезультатЗакрытия) Тогда
		ЗагрузитьТаблицуОбъектыЗатрат(РезультатЗакрытия);
		ЗаполнитьПредставлениеЗатратНаСервере();
		РаспределениеЗатратНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиНаценки(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если Не РезультатЗакрытия = Неопределено И Не ПустаяСтрока(РезультатЗакрытия) Тогда
		СтруктураНаценка = ПолучитьИзВременногоХранилища(РезультатЗакрытия);
		УстановитьПроцентНаценкиНаСервере(СтруктураНаценка);
//		ЗагрузитьТаблицуОбъектыЗатрат(РезультатЗакрытия);
//		ЗаполнитьПредставлениеЗатратНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьПроцентНаценкиНаСервере(СтруктураНаценка)
	МассивСтрок = ПолучитьСтрокиОбъектовЗакупкиПоГруппировкеНаценки(СтруктураНаценка);
	Для Каждого СтрокаОбъектаЗакупок Из МассивСтрок Цикл
		СтрокаОбъектаЗакупок.ПроцентНаценки = СтруктураНаценка.ПроцентНаценки;
		СтрокаОбъектаЗакупок.СуммаНаценки = СтрокаОбъектаЗакупок.СуммаПоставщика * (СтрокаОбъектаЗакупок.ПроцентНаценки
			/ 100);
		СтрокаОбъектаЗакупок.СуммаПродажи = СтрокаОбъектаЗакупок.СуммаПоставщика + СтрокаОбъектаЗакупок.СуммаНаценки 
											+ СтрокаОбъектаЗакупок.СуммаЗатратВЦене;;
		ПересчитатьПрибыльНаСервере(СтрокаОбъектаЗакупок);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресХраненияТаблицыОбъектыЗакупки()
	ТаблицаДанных = Объект.ОбъектыЗакупки.Выгрузить();
	АдресХраненияТаблицыОбъектыЗакупки = ПоместитьВоВременноеХранилище(ТаблицаДанных, УникальныйИдентификатор);
	Возврат АдресХраненияТаблицыОбъектыЗакупки;
КонецФункции

&НаСервере
Функция ПолучитьАдресХраненияТаблицыОбъектыЗатрат()
	ТаблицаДанных = Объект.ОбъектыЗатрат.Выгрузить();
	АдресХраненияТаблицыОбъектыЗатрат = ПоместитьВоВременноеХранилище(ТаблицаДанных, УникальныйИдентификатор);
	Возврат АдресХраненияТаблицыОбъектыЗатрат;
КонецФункции

&НаСервере
Функция ПолучитьАдресХраненияСтруктурыНаценки()
	СтруктураНаценки = Документы.КонтурЗакупки_ОбработкаЗакупки.ПолучитьСтруктуруНаценки();
	АдресХраненияСтруктурыНаценки = ПоместитьВоВременноеХранилище(СтруктураНаценки, УникальныйИдентификатор);
	Возврат АдресХраненияСтруктурыНаценки;
КонецФункции

&НаСервере
Процедура ОчиститьСуммыЗатрат()
	Для Каждого СтрОбъекта Из Объект.ОбъектыЗакупки Цикл
		СтрОбъекта.СуммаЗатрат = 0;
		СтрОбъекта.СуммаЗатратВЦене = 0;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОчиститьПредставлениеЗатрат()
	Для Каждого СтрОбъекта Из Объект.ОбъектыЗакупки Цикл
		СтрОбъекта.ПредставлениеЗатрат = "";
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура РаспределениеЗатратНаСервере()

	ОчиститьСуммыЗатрат();

	Для Каждого СтрокаЗатрат Из Объект.ОбъектыЗатрат Цикл
		СтрокиОбъектовЗакупки = ПолучитьСтрокиОбъектовЗакупкиПоГруппировкеЗатрат(СтрокаЗатрат);
		СуммаБазыДляРаспределения = ПолучитьСуммуДляРаспределенияЗатрат(СтрокиОбъектовЗакупки,
			СтрокаЗатрат.ПоказательРаспределенияЗатрат);
		СуммаСтрокиЗатрат = СтрокаЗатрат.Сумма;

		Если СуммаБазыДляРаспределения > 0 Тогда
			Пропорция = СуммаСтрокиЗатрат / СуммаБазыДляРаспределения;
		Иначе
			Пропорция = 0;
		КонецЕсли;

		Для Каждого СтрокаОбъектаЗакупок Из СтрокиОбъектовЗакупки Цикл
			Если СтрокаЗатрат.ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.Вес Тогда
				СуммаРеквизитаСтроки = СтрокаОбъектаЗакупок.Вес;
			ИначеЕсли СтрокаЗатрат.ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.Объем Тогда
				СуммаРеквизитаСтроки = СтрокаОбъектаЗакупок.Объем;
			ИначеЕсли СтрокаЗатрат.ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.ВесИОбъем Тогда
				СуммаРеквизитаСтроки = СтрокаОбъектаЗакупок.Вес + СтрокаОбъектаЗакупок.Объем;
			ИначеЕсли СтрокаЗатрат.ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.СуммаЗакупки Тогда
				СуммаРеквизитаСтроки = СтрокаОбъектаЗакупок.ОбщаяСтоимостьОбъекта;
			ИначеЕсли СтрокаЗатрат.ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.СуммаПоставщика Тогда
				СуммаРеквизитаСтроки = СтрокаОбъектаЗакупок.СуммаПоставщика;
			Иначе
				СуммаРеквизитаСтроки = 0;
			КонецЕсли;
			
			СуммаБазыДляРаспределения = СуммаБазыДляРаспределения - СуммаРеквизитаСтроки;
			
			Если СуммаБазыДляРаспределения = 0 Тогда
				СуммаЗатратСтроки = СуммаСтрокиЗатрат;
			Иначе
				СуммаЗатратСтроки = Окр(СуммаРеквизитаСтроки * Пропорция, 2);
			КонецЕсли;
			
			СуммаСтрокиЗатрат = СуммаСтрокиЗатрат - СуммаЗатратСтроки;
			
			Если СтрокаЗатрат.ЗатратыВЦене Тогда
				СтрокаОбъектаЗакупок.СуммаЗатратВЦене = СтрокаОбъектаЗакупок.СуммаЗатратВЦене + СуммаЗатратСтроки;
			Иначе
				СтрокаОбъектаЗакупок.СуммаЗатрат = СтрокаОбъектаЗакупок.СуммаЗатрат + СуммаЗатратСтроки;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаОбъектаЗакупок Из СтрокиОбъектовЗакупки Цикл
		ПересчитатьПрибыльНаСервере(СтрокаОбъектаЗакупок);
	КонецЦикла;
		
	ЗаполнитьПредставлениеЗатратНаСервере();
	
КонецПроцедуры

// Получить сумму для распределения затрат.
// 
// Параметры:
//  МассивСтрокОбъектовЗакупки - Массив Из ДанныеФормыЭлементКоллекции - Массив строк объектов закупки
//  ПоказательРаспределенияЗатрат - ПеречислениеСсылка.КонтурЗакупки_ПоказателиРаспределенияЗатрат - Показатель распределения затрат
// 
// Возвращаемое значение:
//  Число -  Cумма показателя(ей) для распределения затрат
&НаСервере
Функция ПолучитьСуммуДляРаспределенияЗатрат(МассивСтрокОбъектовЗакупки, ПоказательРаспределенияЗатрат)
	СуммаПоказателя = 0;
	Если ЗначениеЗаполнено(ПоказательРаспределенияЗатрат) Тогда
		Для Каждого СтрокаОбъектаЗатрат Из МассивСтрокОбъектовЗакупки Цикл
			Если ПоказательРаспределенияЗатрат = Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.Вес Тогда
				СуммаПоказателя = СуммаПоказателя + СтрокаОбъектаЗатрат.Вес;
			ИначеЕсли ПоказательРаспределенияЗатрат = Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.Объем Тогда
				СуммаПоказателя = СуммаПоказателя + СтрокаОбъектаЗатрат.Объем;
			ИначеЕсли ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.ВесИОбъем Тогда
				СуммаПоказателя = СуммаПоказателя + СтрокаОбъектаЗатрат.Объем + СтрокаОбъектаЗатрат.Вес;
			ИначеЕсли ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.СуммаЗакупки Тогда
				СуммаПоказателя = СуммаПоказателя + СтрокаОбъектаЗатрат.ОбщаяСтоимостьОбъекта;
			ИначеЕсли ПоказательРаспределенияЗатрат
				= Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.СуммаПоставщика Тогда
				СуммаПоказателя = СуммаПоказателя + СтрокаОбъектаЗатрат.СуммаПоставщика;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СуммаПоказателя;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНаименованиеПапкиФайловВерхнегоУровня()
	Возврат "Файлы_КонтурЗакупки_ОбработкаЗакупки";
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСоздатьСправочникПапкиФайлов(УИДДокумента)
	
	НаименованиеВехнийУровень = ПолучитьНаименованиеПапкиФайловВерхнегоУровня();
	СсылкаВерхнийУровень = Справочники.ПапкиФайлов.НайтиПоНаименованию(НаименованиеВехнийУровень, Истина);
	Если Не ЗначениеЗаполнено(СсылкаВерхнийУровень) Тогда
		ОбъектВерхнийУровень = Справочники.ПапкиФайлов.СоздатьЭлемент();
		ОбъектВерхнийУровень.Наименование = НаименованиеВехнийУровень;
		ОбъектВерхнийУровень.Записать();

		СсылкаВерхнийУровень = ОбъектВерхнийУровень.Ссылка;
	КонецЕсли;

	СсылкаПапкиФайлов = Справочники.ПапкиФайлов.НайтиПоНаименованию(XMLСтрока(УИДДокумента), Истина,
		СсылкаВерхнийУровень);

	Если Не ЗначениеЗаполнено(СсылкаПапкиФайлов) Тогда
		ОбъектПапкиФайлов = Справочники.ПапкиФайлов.СоздатьЭлемент();
		ОбъектПапкиФайлов.Наименование = XMLСтрока(УИДДокумента);
		ОбъектПапкиФайлов.Родитель = СсылкаВерхнийУровень;
		ОбъектПапкиФайлов.Записать();

		СсылкаПапкиФайлов = ОбъектПапкиФайлов.Ссылка;
	КонецЕсли;

	Возврат СсылкаПапкиФайлов;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииСуммыЗатрат()
	ИДТекущейСтроки = Элементы.КП.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		ТекущаяСтрока.СуммаПродажи = ТекущаяСтрока.СуммаПоставщика + ТекущаяСтрока.СуммаНаценки
			+ ТекущаяСтрока.СуммаЗатратВЦене;
		ПересчитатьЦеныПродажи(ТекущаяСтрока);
		ПересчитатьПрибыль(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаданиеНаКлиенте()
	СоздаватьЗадание = Истина;
	ОписаниеРезультата = "";

	Если Не ЗначениеЗаполнено(Объект.Пользователь) Тогда
		СоздаватьЗадание = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Не заполнен пользователь'");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.СтатусОбработкиЗакупки) Тогда
		СоздаватьЗадание = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + ?(Не ПустаяСтрока(ОписаниеРезультата), Символы.ПС, "") + НСтр(
				"ru = 'Не заполнен статус обработки'");
	КонецЕсли;

	Если Объект.ЗаданиеСоздано Тогда
		СоздаватьЗадание = Ложь;
		ОписаниеРезультата = ОписаниеРезультата + ?(Не ПустаяСтрока(ОписаниеРезультата), Символы.ПС, "") + НСтр(
				"ru = 'Задание уже создано'");
	КонецЕсли;

	Если СоздаватьЗадание Тогда
		СоздатьЗаданиеНаСервере();
	Иначе
		КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(ОписаниеРезультата);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаданиеНаСогласованииУЛогистаНаКлиенте()
	ОписаниеРезультата = "";

	Если Не СоздатьЗаданиеНаСогласованииУЛогистаНаСервере(ОписаниеРезультата) Тогда
		КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(ОписаниеРезультата);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СоздатьЗаданиеНаСогласованииУЛогистаНаСервере(ОписаниеРезультата = "")
	СоздаватьЗадание = Истина;
	МассивЛогистов = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.ПолучитьМассивПользователейСРолью(
		Метаданные.Роли.КонтурЗакупки_ОтделЛогистики);

	Если МассивЛогистов.Количество() = 0 Тогда
		ОписаниеРезультата = ОписаниеРезультата + НСтр("ru = 'Нет пользователей с ролью КонтурЗакупки_ОтделЛогистики'")
			+ Символы.ПС;
		СоздаватьЗадание = Ложь;
	КонецЕсли;

	Если СоздаватьЗадание Тогда
		Для Каждого ПользовательЛогист Из МассивЛогистов Цикл

			ОписаниеРезультата = "";
			ЗаданиеСсылка = Неопределено;

			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("Автор", ПараметрыСеанса.ТекущийПользователь);
			ПараметрыЗадания.Вставить("Исполнитель", ПользовательЛогист);

			Если Не КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьЗаданиеОбработкиЗакупки(
		Объект.Ссылка, "Задание" + Строка(Объект.СтатусОбработкиЗакупки) + Строка(Объект.Пользователь),
				ПараметрыЗадания, ЗаданиеСсылка, ОписаниеРезультата) Тогда
				Объект.ЗаданиеСоздано = Ложь;
				КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(ОписаниеРезультата);
			Иначе
				ЗаданиеСсылка.Объект.ЗаданиеСоздано = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СоздаватьЗадание;
КонецФункции

&НаСервере
Процедура СоздатьЗаданиеНаСервере()
	ОписаниеРезультата = "";
	ЗаданиеСсылка = Неопределено;

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Автор", ПараметрыСеанса.ТекущийПользователь);
	ПараметрыЗадания.Вставить("Исполнитель", Объект.Пользователь);

	Если Не КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.СоздатьЗаданиеОбработкиЗакупки(
		Объект.Ссылка, "Задание" + Строка(Объект.СтатусОбработкиЗакупки) + Строка(Объект.Пользователь),
		ПараметрыЗадания, ЗаданиеСсылка, ОписаниеРезультата) Тогда
		Объект.ЗаданиеСоздано = Ложь;
		КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(ОписаниеРезультата);
	Иначе
		Объект.ЗаданиеСоздано = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВводаКоличестваДеленияСтроки(ВведенноеЧисло, ТекущаяСтрока) Экспорт

	Если Не ВведенноеЧисло = Неопределено И ВведенноеЧисло < ТекущаяСтрока.Количество И ТекущаяСтрока.Количество > 0
		И ВведенноеЧисло > 0 Тогда

		РазделитьСтроку(ВведенноеЧисло, ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВводаКоличестваПоставщикаДеленияСтроки(ВведенноеЧисло, ТекущаяСтрока) Экспорт

	Если Не ВведенноеЧисло = Неопределено И ВведенноеЧисло < ТекущаяСтрока.КоличествоПоставщика
		И ТекущаяСтрока.КоличествоПоставщика > 0 И ВведенноеЧисло > 0 Тогда

		РазделитьСтроку(ВведенноеЧисло, ТекущаяСтрока, "КоличествоПоставщика");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазделитьСтроку(ВведенноеЧисло, ТекущаяСтрока, РеквизитДляПропорции = "Количество")
	Пропорция = ВведенноеЧисло / ТекущаяСтрока[РеквизитДляПропорции];
	НомерНовойСтроки = Объект.ОбъектыЗакупки.Индекс(ТекущаяСтрока) + 1;
	НоваяСтрока = Объект.ОбъектыЗакупки.Вставить(НомерНовойСтроки);

	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);

	ТекущаяСтрока[РеквизитДляПропорции] = ТекущаяСтрока[РеквизитДляПропорции] - ВведенноеЧисло;
	НоваяСтрока[РеквизитДляПропорции] = ВведенноеЧисло;
		
	// суммы новой строки пересчитываем по пропорции
	МассивРеквизитСумм = Новый Массив;
	МассивРеквизитСумм.Добавить("ОбщаяСтоимостьОбъекта");
	МассивРеквизитСумм.Добавить("Вес");
	МассивРеквизитСумм.Добавить("Объем");
	Если РеквизитДляПропорции = "Количество" Тогда
		МассивРеквизитСумм.Добавить("КоличествоПоставщика");
	ИначеЕсли РеквизитДляПропорции = "КоличествоПоставщика" Тогда
		МассивРеквизитСумм.Добавить("Количество");
	КонецЕсли;
	МассивРеквизитСумм.Добавить("СуммаПоставщика");
	МассивРеквизитСумм.Добавить("СуммаНДСПоставщика");
	МассивРеквизитСумм.Добавить("СуммаНаценки");
	МассивРеквизитСумм.Добавить("СуммаПродажи");
	МассивРеквизитСумм.Добавить("СуммаЗатрат");
	МассивРеквизитСумм.Добавить("СуммаПрибыли");

	Для Каждого РеквизитСуммы Из МассивРеквизитСумм Цикл
		НоваяСтрока[РеквизитСуммы] = ТекущаяСтрока[РеквизитСуммы] * Пропорция;
		ТекущаяСтрока[РеквизитСуммы] = ТекущаяСтрока[РеквизитСуммы] - НоваяСтрока[РеквизитСуммы];
	КонецЦикла;
	ПересчитатьПрибыль(ТекущаяСтрока);
	ПересчитатьПрибыль(НоваяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура НачатьРазделениеСтроки(ТекущаяСтрока)

	ЗавершениеВводаКоличестваДеления = Новый ОписаниеОповещения("ОкончаниеВводаКоличестваДеленияСтроки", ЭтотОбъект,
		ТекущаяСтрока);
	ПоказатьВводЧисла(ЗавершениеВводаКоличестваДеления, , НСтр("ru = 'Введите количество новой строки'"), 15, 2);
КонецПроцедуры

&НаКлиенте
Процедура НачатьРазделениеСтрокиКоличествоПоставщика(ТекущаяСтрока)

	ЗавершениеВводаКоличестваДеления = Новый ОписаниеОповещения("ОкончаниеВводаКоличестваПоставщикаДеленияСтроки",
		ЭтотОбъект, ТекущаяСтрока);
	ПоказатьВводЧисла(ЗавершениеВводаКоличестваДеления, , НСтр("ru = 'Введите количество новой строки'"), 15, 2);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСуммыПродажи(ТекущаяСтрока)
	ТекущаяСтрока.СуммаНаценки = ТекущаяСтрока.СуммаПродажи - ТекущаяСтрока.СуммаПоставщика
		- ТекущаяСтрока.СуммаЗатратВЦене;
	Если Не ТекущаяСтрока.СуммаПоставщика = 0 Тогда
		ТекущаяСтрока.ПроцентНаценки = ТекущаяСтрока.СуммаНаценки * 100 / ТекущаяСтрока.СуммаПоставщика;
	КонецЕсли;

	ПересчитатьПрибыль(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКоличествоПоставщика(ТекущаяСтрока)
	ТекущаяСтрока.СуммаПоставщика = ТекущаяСтрока.ЦенаПоставщика * ТекущаяСтрока.КоличествоПоставщика;

	ТекущаяСтрока.СуммаПоставщикаБезНДС = КонтурЗакупки_ЛокализацияУТ11_РасчетНДСКлиентСервер.ПолучитьСуммуБезНДС( 
	ТекущаяСтрока.СуммаПоставщика, ТекущаяСтрока.СтавкаНДСПоставщика);

	ТекущаяСтрока.СуммаНДСПоставщика = ТекущаяСтрока.СуммаПоставщика - ТекущаяСтрока.СуммаПоставщикаБезНДС;

	ПересчитатьЦеныПродажи(ТекущаяСтрока);
	ПересчитатьСуммыОВХ(ТекущаяСтрока);
	ПересчитатьПрибыль(ТекущаяСтрока);
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОрганизаторов()
	Возврат Объект.ОрганизаторыЗаказчики.Выгрузить().ВыгрузитьКолонку("ОрганизаторЗаказчик");
КонецФункции

&НаСервере
Процедура ЗагрузитьИзФайлаНаСервере(АдресЗагруженныхДанных)

	ЗагруженныеДанные = ПолучитьИзВременногоХранилища(АдресЗагруженныхДанных);

	Для Каждого СтрокаТаблицы Из ЗагруженныеДанные Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ОбъектЗакупки) Тогда
			НовСтрока = Объект.ОбъектыЗакупки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(АдресЗагруженныхДанных, ДополнительныеПараметры) Экспорт
	Если Не АдресЗагруженныхДанных = Неопределено Тогда
		ЗагрузитьИзФайлаНаСервере(АдресЗагруженныхДанных);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСуммыПоставщика(ТекущаяСтрока)
	Если Не ТекущаяСтрока.КоличествоПоставщика = 0 Тогда
		ТекущаяСтрока.СуммаПоставщикаБезНДС = КонтурЗакупки_ЛокализацияУТ11_РасчетНДСКлиентСервер.ПолучитьСуммуБезНДС(
		ТекущаяСтрока.СуммаПоставщика, ТекущаяСтрока.СтавкаНДСПоставщика);

		ТекущаяСтрока.ЦенаПоставщика = ТекущаяСтрока.СуммаПоставщика / ТекущаяСтрока.КоличествоПоставщика;
		ТекущаяСтрока.ЦенаПоставщикаБезНДС = ТекущаяСтрока.СуммаПоставщикаБезНДС / ТекущаяСтрока.КоличествоПоставщика;

		ТекущаяСтрока.СуммаНДСПоставщика = ТекущаяСтрока.СуммаПоставщика - ТекущаяСтрока.СуммаПоставщикаБезНДС;
		ПересчитатьПрибыль(ТекущаяСтрока);
		ПересчитатьНаценку(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНоменклатуры(ТекущаяСтрока)
	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда

		СтруктураДанныеНоменклатуры = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьДанныеНоменклатуры(
					ТекущаяСтрока.Номенклатура);
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураДанныеНоменклатуры);
		ПересчитатьСуммыОВХ(ТекущаяСтрока);

		ОбъектыЗакупкиНоменклатураПриИзмененииНаСервере(ТекущаяСтрока.ОбъектЗакупки, ТекущаяСтрока.Номенклатура);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбъектыЗакупкиДанныеПоставкиПоставщикПриИзмененииНаСервере(ИДТекущейСтроки)
	ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);

	Заполнять = ЗначениеЗаполнено(ТекущаяСтрока.Контрагент);

	Если Заполнять Тогда
		ПВХГородОтгрузкиПартнера = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
			"ПВХГородОтгрузкиПартнера", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка());
		Если Не ЗначениеЗаполнено(ПВХГородОтгрузкиПартнера) Тогда
			ЗаполнитьГородИзКлассификатора( ТекущаяСтрока);
		Иначе
			ЗаполнитьГородИзПВХ(ТекущаяСтрока, ПВХГородОтгрузкиПартнера);
		КонецЕсли;
	Иначе
		ТекущаяСтрока.ГородПоставщика = Справочники.КонтурЗакупки_Города.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГородИзПВХ(ТекущаяСтрока, ПВХГородОтгрузкиПартнера)
	Заполнять = Истина;

	Если Заполнять Тогда
		ГородПоставщика = УправлениеСвойствами.ЗначениеСвойства(ТекущаяСтрока.Контрагент, ПВХГородОтгрузкиПартнера);
		Если Не ЗначениеЗаполнено(ГородПоставщика) Тогда
			ГородПоставщика = УправлениеСвойствами.ЗначениеСвойства(ТекущаяСтрока.Контрагент.Партнер,
				ПВХГородОтгрузкиПартнера);
			Если Не ЗначениеЗаполнено(ГородПоставщика) Тогда
				Заполнять = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Заполнять Тогда
		СтруктураГород = Новый Структура("Наименование", СокрЛП(ГородПоставщика));

		ТекущаяСтрока.ГородПоставщика = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.НайтиСоздатьСправочникПоНаименованию(
				"КонтурЗакупки_Города", СтруктураГород);
	Иначе
		ТекущаяСтрока.ГородПоставщика = Справочники.КонтурЗакупки_Города.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГородИзКлассификатора(ТекущаяСтрока)
	Заполнять = Истина;
	КонтИнф = Неопределено;

	Если Заполнять Тогда
		//@skip-check empty-except-statement
		Попытка
			ОтборКИ = УправлениеКонтактнойИнформацией.ОтборКонтактнойИнформации();
			ОтборКИ.Дата = Объект.Дата;
			ОтборКИ.ВидыКонтактнойИнформации.Добавить(Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
			ОтборКИ.ВидыКонтактнойИнформации.Добавить(Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
			КонтИнф = УправлениеКонтактнойИнформацией.КонтактнаяИнформация(ТекущаяСтрока.Контрагент, ОтборКИ);
		Исключение

		КонецПопытки;

		//@skip-check empty-except-statement
		Попытка
			КонтИнф = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.Контрагент,
				Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента, Объект.Дата, Ложь);
			КонтИнф1 = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущаяСтрока.Контрагент,
				Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации, Объект.Дата, Ложь);
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(КонтИнф1, КонтИнф);
		Исключение

		КонецПопытки;
		Заполнять = Не КонтИнф = Неопределено;
	КонецЕсли;

	Если Заполнять И КонтИнф.Количество() = 0 Тогда
		Заполнять = Ложь;
	КонецЕсли;

	Если Заполнять Тогда
		Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(КонтИнф[0].ЗначенияПолей) Тогда
			МодульУправлениеКонтактнойИнформациейЛокализация = Неопределено;
			ЕстьОМ = Истина;
			Попытка
				//@skip-check wrong-string-literal-content
				МодульУправлениеКонтактнойИнформациейЛокализация = ОбщегоНазначения.ОбщийМодуль(
				"УправлениеКонтактнойИнформациейЛокализация");
			Исключение
				ЕстьОМ = Ложь;
			КонецПопытки;

			Если Не ЕстьОМ Тогда
				МодульУправлениеКонтактнойИнформациейЛокализация = ОбщегоНазначения.ОбщийМодуль(
					"УправлениеКонтактнойИнформациейСлужебный");
			КонецЕсли;

			XDTOКонтактнаяИнформация = МодульУправлениеКонтактнойИнформациейЛокализация.КонтактнаяИнформацияИзXML(
				КонтИнф[0].ЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Адрес);
		Иначе
			Заполнять = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если Заполнять Тогда
		Если XDTOКонтактнаяИнформация.Состав = Неопределено Тогда
			Заполнять = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если Заполнять Тогда
		Если XDTOКонтактнаяИнформация.Состав.Страна = Неопределено Тогда
			Заполнять = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если Заполнять Тогда
		Если XDTOКонтактнаяИнформация.Состав.Состав = Неопределено Тогда
			Заполнять = Ложь;
		КонецЕсли;
	КонецЕсли;

	ГородПоставщика = "";
	Если Заполнять Тогда
		Если Не XDTOКонтактнаяИнформация.Состав.Состав.Город = Неопределено Тогда
			ГородПоставщика = XDTOКонтактнаяИнформация.Состав.Состав.Город;
		КонецЕсли;

		Если Не XDTOКонтактнаяИнформация.Состав.Состав.НаселПункт = Неопределено Тогда
			ГородПоставщика = ГородПоставщика + " " + XDTOКонтактнаяИнформация.Состав.Состав.НаселПункт;
		КонецЕсли;

		Если ПустаяСтрока(ГородПоставщика) Тогда
			Заполнять = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если Заполнять Тогда
		СтруктураГород = Новый Структура("Наименование", СокрЛП(ГородПоставщика));

		ТекущаяСтрока.ГородПоставщика = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.НайтиСоздатьСправочникПоНаименованию(
				"КонтурЗакупки_Города", СтруктураГород);
	Иначе
		ТекущаяСтрока.ГородПоставщика = Справочники.КонтурЗакупки_Города.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбъектыЗакупкиНоменклатураПриИзмененииНаСервере(ОбъектЗакупки, Номенклатура)
	МассивОрганизаторов = Объект.ОрганизаторыЗаказчики.Выгрузить().ВыгрузитьКолонку("ОрганизаторЗаказчик");
	КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ЗаписатьНоменклатуруПоОбъектуЗакупки(
			МассивОрганизаторов, ОбъектЗакупки, Номенклатура);
КонецПроцедуры

// Пересчитать ОВХ.
// 
// Параметры:
//  ТекущаяСтрока - ДанныеФормыЭлементКоллекции - Строка ТЧ
&НаКлиенте
Процедура ПересчитатьСуммыОВХ(ТекущаяСтрока)
	ТекущаяСтрока.Вес = ТекущаяСтрока.ВесЕдиницы * ТекущаяСтрока.КоличествоПоставщика;
	ТекущаяСтрока.Объем = ТекущаяСтрока.ОбъемЕдиницы * ТекущаяСтрока.КоличествоПоставщика;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЦеныПродажи(ТекущаяСтрока)
	Если Не ТекущаяСтрока.КоличествоПоставщика = 0 Тогда
		ТекущаяСтрока.ЦенаПродажи = ТекущаяСтрока.СуммаПродажи / ТекущаяСтрока.КоличествоПоставщика;
		ТекущаяСтрока.ЦенаПродажиБезНДС = КонтурЗакупки_ЛокализацияУТ11_РасчетНДСКлиентСервер.ПолучитьСуммуБезНДС(
			ТекущаяСтрока.ЦенаПродажи, ТекущаяСтрока.СтавкаНДСПродажи);
	КонецЕсли;
КонецПроцедуры

// Пересчитать прибыль на клиенте.
// 
// Параметры:
//  ТекущаяСтрока - ДанныеФормыЭлементКоллекции - Строка ТЧ
&НаКлиенте
Процедура ПересчитатьПрибыль(ТекущаяСтрока)
	ТекущаяСтрока.СуммаПрибыли = ТекущаяСтрока.СуммаНаценки - ТекущаяСтрока.СуммаЗатрат;
	Если Не ТекущаяСтрока.СуммаПоставщика = 0 Тогда
		ТекущаяСтрока.ПроцентМаржи = ТекущаяСтрока.СуммаПрибыли * 100 / ТекущаяСтрока.СуммаПоставщика;
	Иначе
		ТекущаяСтрока.ПроцентМаржи = 0;
	КонецЕсли;
КонецПроцедуры

// Пересчитать прибыль на сервере.
// 
// Параметры:
//  ТекущаяСтрока - СтрокаТабличнойЧасти - Строка ТЧ
&НаСервере
Процедура ПересчитатьПрибыльНаСервере(ТекущаяСтрока)
	
	//ТекущаяСтрока.СуммаПрибыли = ТекущаяСтрока.СуммаНаценки - ТекущаяСтрока.СуммаЗатрат - ТекущаяСтрока.СуммаЗатратВЦене;
	
	ТекущаяСтрока.СуммаПрибыли = ТекущаяСтрока.СуммаПродажи
								- ТекущаяСтрока.СуммаПоставщика
								- ТекущаяСтрока.СуммаЗатрат
								- ТекущаяСтрока.СуммаЗатратВЦене;
	
	Если Не ТекущаяСтрока.СуммаПоставщика = 0 Тогда
		ТекущаяСтрока.ПроцентМаржи = ТекущаяСтрока.СуммаПрибыли * 100 / ТекущаяСтрока.СуммаПоставщика;
	Иначе
		ТекущаяСтрока.ПроцентМаржи = 0;
	КонецЕсли;
	
КонецПроцедуры

// Пересчитать наценку.
// 
// Параметры:
//  ТекущаяСтрока - ДанныеФормыЭлементКоллекции -  Текущая строка
&НаКлиенте
Процедура ПересчитатьНаценку(ТекущаяСтрока)
	ТекущаяСтрока.СуммаНаценки = ТекущаяСтрока.СуммаПродажи - ТекущаяСтрока.СуммаПоставщика
		- ТекущаяСтрока.СуммаЗатратВЦене;
	Если Не ТекущаяСтрока.СуммаПоставщика = 0 Тогда
		ТекущаяСтрока.ПроцентНаценки = ТекущаяСтрока.СуммаНаценки * 100 / ТекущаяСтрока.СуммаПоставщика;
	Иначе
		ТекущаяСтрока.ПроцентНаценки = 0;
	КонецЕсли;
КонецПроцедуры

// Получить имеющиеся данные по кодам.
// 
// Возвращаемое значение:
//  Структура -  Получить имеющиеся данные по кодам:
// * ЕстьОКВЭД2 - Булево - 
// * ЕстьОКПД2 - Булево - 
// * ЕстьКТРУ - Булево - 
&НаСервере
Функция ПолучитьИмеющиесяДанныеПоКодам()
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("ЕстьОКВЭД2", Ложь);
	СтруктураДанные.Вставить("ЕстьОКПД2", Ложь);
	СтруктураДанные.Вставить("ЕстьКТРУ", Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЗДокумента.ОКПД2Код,
	|	ТЗДокумента.ОКВЭД2Код,
	|	ТЗДокумента.КТРУКод
	|ПОМЕСТИТЬ ТЗКодов
	|ИЗ
	|	&ТЗДокумента КАК ТЗДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТЗКодов.ОКПД2Код) КАК КолОКПД2Код,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТЗКодов.ОКВЭД2Код) КАК КолОКВЭД2Код,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТЗКодов.КТРУКод) КАК КолКТРУКод,
	|	МАКСИМУМ(ТЗКодов.ОКПД2Код) КАК МаксОКПД2Код,
	|	МАКСИМУМ(ТЗКодов.ОКВЭД2Код) КАК МаксОКВЭД2Код,
	|	МАКСИМУМ(ТЗКодов.КТРУКод) КАК МаксКТРУКод
	|ИЗ
	|	ТЗКодов КАК ТЗКодов";
	Запрос.УстановитьПараметр("ТЗДокумента", Объект.ОбъектыЗакупки.Выгрузить());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураДанные.ЕстьОКВЭД2 = (Выборка.КолОКВЭД2Код > 1) Или Не ПустаяСтрока(Выборка.МаксОКВЭД2Код);
		СтруктураДанные.ЕстьОКПД2 = (Выборка.КолОКПД2Код > 1) Или Не ПустаяСтрока(Выборка.МаксОКПД2Код);
		СтруктураДанные.ЕстьКТРУ = (Выборка.КолКТРУКод > 1) Или Не ПустаяСтрока(Выборка.МаксКТРУКод);
	КонецЕсли;

	Возврат СтруктураДанные;
КонецФункции

// Получить суммы статьи затрат.
// 
// Параметры:
//  СтатьяЗатрат - СправочникСсылка.КонтурЗакупки_СтатьиЗатрат - Статья затрат
// 
// Возвращаемое значение:
//  Структура - Получить суммы статьи затрат:
// * СуммаБезНДС - Число - 
// * СтавкаНДС - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - Ставка НДС
// * Сумма - Число - 
// * ПоказательРаспределенияЗатрат - ПеречислениеСсылка.КонтурЗакупки_ПоказателиРаспределенияЗатрат - Показатель распределения затрат
&НаСервере
Функция ПолучитьСуммыСтатьиЗатрат(СтатьяЗатрат)
	СтруктураСуммыСтатьиЗатрат = Новый Структура;
	СтруктураСуммыСтатьиЗатрат.Вставить("СуммаБезНДС", 0);
	СтруктураСуммыСтатьиЗатрат.Вставить("СтавкаНДС", Перечисления.КонтурЗакупки_СтавкиНДС.ПустаяСсылка());
	СтруктураСуммыСтатьиЗатрат.Вставить("Сумма", 0);
	СтруктураСуммыСтатьиЗатрат.Вставить("СуммаНДС", 0);
	СтруктураСуммыСтатьиЗатрат.Вставить("ПоказательРаспределенияЗатрат",
		Перечисления.КонтурЗакупки_ПоказателиРаспределенияЗатрат.ПустаяСсылка());
	Если ЗначениеЗаполнено(СтатьяЗатрат) Тогда
		ЗаполнитьЗначенияСвойств(СтруктураСуммыСтатьиЗатрат, СтатьяЗатрат);
		СтруктураСуммыСтатьиЗатрат.СуммаНДС =  СтруктураСуммыСтатьиЗатрат.Сумма - СтруктураСуммыСтатьиЗатрат.СуммаБезНДС;
	КонецЕсли;
	Возврат СтруктураСуммыСтатьиЗатрат;
КонецФункции

// Документ основания при изменении ответ.
// 
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога, ЭлементСпискаЗначений - Результат вопроса
//  ДополнительныеПараметры - Неопределено - Дополнительные параметры
&НаКлиенте
Процедура ДокументОснованияПриИзмененииОтвет(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ДокументОснованияПриИзмененииНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДокументОснованияПриИзмененииНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснования);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	УстановитьТекстЖелаемаяДатаПодсказка();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииВводаПроцентаНаценки(ПроцентНаценки, Параметры) Экспорт
	Если Не ПроцентНаценки = Неопределено Тогда
		УстановитьПроцентНаценкиДляВсехСтрок(ПроцентНаценки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииВводаПроцентаНаценкиДляСтрок(ПроцентНаценки, Параметры) Экспорт
	Если Не ПроцентНаценки = Неопределено Тогда
		Для Каждого СтрокаКП Из Элементы.КП.ВыделенныеСтроки Цикл
			УстановитьПроцентНаценкиДляСтроки(Объект.ОбъектыЗакупки.НайтиПоИдентификатору(СтрокаКП), ПроцентНаценки);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПроцентНаценкиДляВсехСтрок(ПроцентНаценки)
	Для Каждого СтрокаТЧ Из Объект.ОбъектыЗакупки Цикл
		УстановитьПроцентНаценкиДляСтроки(СтрокаТЧ, ПроцентНаценки);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПроцентНаценкиДляСтроки(ТекущаяСтрока, ПроцентНаценки)
	ТекущаяСтрока.ПроцентНаценки = ПроцентНаценки;
	ТекущаяСтрока.СуммаНаценки = ТекущаяСтрока.СуммаПоставщика * (ТекущаяСтрока.ПроцентНаценки / 100);
	ТекущаяСтрока.СуммаПродажи = ТекущаяСтрока.СуммаПоставщика + ТекущаяСтрока.СуммаНаценки+ ТекущаяСтрока.СуммаЗатратВЦене;;
	ПересчитатьЦеныПродажи(ТекущаяСтрока);
	ПересчитатьПрибыль(ТекущаяСтрока);
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеНоменклатурыИзПривязкиНаСервере()
	Для Каждого СтрокаТЧ Из Объект.ОбъектыЗакупки Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			МассивОрганизаторЗаказчик = Объект.ОрганизаторыЗаказчики.Выгрузить().ВыгрузитьКолонку("ОрганизаторЗаказчик");
			Номенклатура = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьНоменклатуруПоОбъектуЗакупки(
				МассивОрганизаторЗаказчик, СтрокаТЧ.ОбъектЗакупки);
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				СтрокаТЧ.Номенклатура = Номенклатура;
				СтруктураДанныеНоменклатуры = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиВызовСервера.ПолучитьДанныеНоменклатуры(
					Номенклатура);
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураДанныеНоменклатуры);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	КонтурЗакупки_ЛокализацияВызовСервера.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

&НаКлиенте
Процедура СброситьПризнакЗадания()
	Объект.ЗаданиеСоздано = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользователиПоРолямНаСервере(ИмяРоли)
	Возврат КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.ПолучитьМассивПользователейСРолью(
				Метаданные.Роли[ИмяРоли]);
КонецФункции

&НаКлиенте
Функция СтрокаОбъектаЗакупкиЗаполнена(СтрокаОбъектаЗакупки)
	
	Результат = Ложь;
	
	МассивИменРеквизитов = МассивИменРеквизитовСтрокиОбъектаЗакупки();
	
	Для Каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
		Если ЗначениеЗаполнено(СтрокаОбъектаЗакупки[ИмяРеквизита]) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

