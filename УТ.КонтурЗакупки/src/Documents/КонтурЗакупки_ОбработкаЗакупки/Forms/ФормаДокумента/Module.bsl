&НаСервере
Процедура УстановитьПользователяПоСтатусу()
	РольПользователя = Неопределено;
	Если Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.НаСогласованииУЛогиста Тогда
		РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделЛогистики;
	ИначеЕсли Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.ПустаяСсылка()
		Или Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.Новая
		Или Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.СогласованСЛогистом
		Или Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.ПоданаЗаявкаНаУчастие
		Или Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.ЗаключениеДоговора Тогда
		РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделПродаж;
	ИначеЕсли Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.ПринятВРаботу
		Или Объект.СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.Переторжка Тогда
		РольПользователя = Метаданные.Роли.КонтурЗакупки_ОтделСнабжения;
	КонецЕсли;
	Если Не РольПользователя = Неопределено Тогда
		Отбор = Новый Структура("РольИмя", РольПользователя.Имя);
		СтрокиСПользователями = Объект.ПользователиПоРолям.НайтиСтроки(Отбор);
		Если СтрокиСПользователями.Количество() > 0 Тогда
			Объект.Пользователь = СтрокиСПользователями[0].Пользователь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

