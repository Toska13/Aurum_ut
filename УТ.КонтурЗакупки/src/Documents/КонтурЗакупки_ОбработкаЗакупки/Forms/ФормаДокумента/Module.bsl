		ДополнительныеПараметры = Новый Структура("ТекущаяСтрока", Элементы.ДанныеПоставки.ТекущиеДанные);
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОчистка", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Очистить данные в строке?';"
		+ " en = 'Clean row data?'"), Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОчистка(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	МассивИменРеквизитов = МассивИменРеквизитовСтрокиОбъектаЗакупки();
	ТекущаяСтрока = ДополнительныеПараметры.ТекущаяСтрока;
	ТекущаяСтрока.ПозицияВыиграна = Ложь;
	Для Каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока[ИмяРеквизита]) Тогда
			ТекущаяСтрока[ИмяРеквизита] = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

