		ТекущаяСтрока.СуммаПродажи = ТекущаяСтрока.СуммаПоставщика + ТекущаяСтрока.СуммаНаценки
			+ ТекущаяСтрока.СуммаЗатратВЦене;
			
		Если Не ТекущаяСтрока.СуммаПоставщика = 0 Тогда
			ТекущаяСтрока.ПроцентНаценки = ТекущаяСтрока.СуммаНаценки * 100 / ТекущаяСтрока.СуммаПоставщика;
		Иначе
			ТекущаяСтрока.ПроцентНаценки = 0;
		КонецЕсли;

		ПересчитатьЦеныПродажи(ТекущаяСтрока);
