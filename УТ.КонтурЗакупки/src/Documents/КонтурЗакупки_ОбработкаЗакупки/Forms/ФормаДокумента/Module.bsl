#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	КонтурЗакупки_ЛокализацияВызовСервера.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если КонтурЗакупки_ЛокализацияСервер.ЕстьДок_ЗадачаСотрудника() Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьЗадачуСотруднику", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьЗадачуСотруднику";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьБП_Задание() Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьЗадание", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьЗадание";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьДокумент("CRM_Интерес") Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьИнтерес", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьИнтерес";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьСправочник("СделкиСКлиентами") Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьСделку", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьСделку";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьДокумент("ЗаказКлиента") Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьЗаказКлиента", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьЗаказКлиента";
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Элементы.ФормаОткрытьПрикрепленныеФайлы.Доступность = Истина;
		
		Попытка
			ПапкиФайлов = ПолучитьСоздатьСправочникПапкиФайлов(Объект.Ссылка.УникальныйИдентификатор());
		Исключение
			Элементы.ФормаОткрытьПрикрепленныеФайлы.Доступность = Ложь;
			Элементы.ФормаОткрытьПрикрепленныеФайлыРасширеннаяПодсказка.Заголовок = СтрШаблон(
				НСтр("ru = 'Нет прав на папку %1'"), ПолучитьНаименованиеПапкиФайловВерхнегоУровня());
		КонецПопытки;
			
	КонецЕсли;
	
	ПМ_КомандаСоздатьОбъектПодключаемая = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ОбработкаЗакупкиКомандаСоздатьОбъектПодключаемая", Неопределено, Ложь);
	Если ПМ_КомандаСоздатьОбъектПодключаемая <> Неопределено Тогда
		Элементы.КнопкаСоздатьОбъектПодключаемая.Заголовок = ПМ_КомандаСоздатьОбъектПодключаемая["Заголовок"];
	Иначе
		Элементы.КнопкаСоздатьОбъектПодключаемая.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьТекстЖелаемаяДатаПодсказка();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДанныеПоКодам = ПолучитьИмеющиесяДанныеПоКодам();

	Элементы.ОбъектыЗакупкиОКПД2Код.Видимость = ДанныеПоКодам.ЕстьОКПД2;
	Элементы.ОбъектыЗакупкиОКПД2Расшифровка.Видимость = ДанныеПоКодам.ЕстьОКПД2;

	Элементы.ОбъектыЗакупкиОКВЭД2Код.Видимость = ДанныеПоКодам.ЕстьОКВЭД2;
	Элементы.ОбъектыЗакупкиОКВЭД2Расшифровка.Видимость = ДанныеПоКодам.ЕстьОКВЭД2;

	Элементы.ОбъектыЗакупкиКТРУКод.Видимость = ДанныеПоКодам.ЕстьКТРУ;
	Элементы.ОбъектыЗакупкиКТРУРасшифровка.Видимость = ДанныеПоКодам.ЕстьКТРУ;

	Элементы.ДанныеПоставкиОКПД2Код.Видимость = ДанныеПоКодам.ЕстьОКПД2;
	Элементы.ДанныеПоставкиОКПД2Расшифровка.Видимость = ДанныеПоКодам.ЕстьОКПД2;

	Элементы.ДанныеПоставкиОКВЭД2Код.Видимость = ДанныеПоКодам.ЕстьОКВЭД2;
	Элементы.ДанныеПоставкиОКВЭД2Расшифровка.Видимость = ДанныеПоКодам.ЕстьОКВЭД2;

	Элементы.ДанныеПоставкиКТРУКод.Видимость = ДанныеПоКодам.ЕстьКТРУ;
	Элементы.ДанныеПоставкиКТРУРасшифровка.Видимость = ДанныеПоКодам.ЕстьКТРУ;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	КонтурЗакупки_ЛокализацияКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтатусОбработкиЗакупкиПриИзменении(Элемент)
	СброситьПризнакЗадания();
	УстановитьПользователяПоСтатусу();
	Если ПроверитьЗаполнение() Тогда
		Элементы.КартинкаПравильностьЗаполнения.Картинка = БиблиотекаКартинок.КонтурЗакупки_Проверено;
	Иначе
		Элементы.КартинкаПравильностьЗаполнения.Картинка = БиблиотекаКартинок.КонтурЗакупки_Предупреждение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПользовательПриИзменении(Элемент)
	СброситьПризнакЗадания();
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованияПриИзменении(Элемент)

	Если Объект.ОбъектыЗакупки.Количество() > 0 Тогда
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДокументОснованияПриИзмененииОтвет", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Документ не пустой.
							|Выбор документа очистит все предыдущие данные.
							|Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницыДокументаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаШапка Тогда
		Объект.СуммаЗатрат = Объект.ОбъектыЗакупки.Итог("СуммаЗатрат");
		Объект.СуммаЗатратВЦене = Объект.ОбъектыЗакупки.Итог("СуммаЗатратВЦене");
		Объект.СуммаЗакупки = Объект.ОбъектыЗакупки.Итог("ОбщаяСтоимостьОбъекта");
		Объект.СуммаПоставщика = Объект.ОбъектыЗакупки.Итог("СуммаПоставщика");
		Объект.СуммаПродажи = Объект.ОбъектыЗакупки.Итог("СуммаПродажи");
		Объект.СуммаПрибыли = Объект.ОбъектыЗакупки.Итог("СуммаПрибыли");
		Объект.Вес = Объект.ОбъектыЗакупки.Итог("Вес");
		Объект.Объем = Объект.ОбъектыЗакупки.Итог("Объем");
		Если Объект.СуммаПоставщика > 0 Тогда
			Объект.ПроцентМаржи = Объект.СуммаПрибыли * 100 / Объект.СуммаПоставщика;
		Иначе
			Объект.ПроцентМаржи = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыЗакупки
&НаКлиенте
Процедура ДокументыЗакупкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Элементы.ДокументыЗакупкиИмяФайла Тогда
		ПерейтиПоНавигационнойСсылке(Элемент.ТекущиеДанные.СсылкаНаФайл);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектыЗакупки

&НаКлиенте
Процедура ОбъектыЗакупкиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	ИдентификаторСтроки = Элементы.ОбъектыЗакупки.ТекущаяСтрока;
	ОповещениеВопросПередУдалениемСтроки = Новый ОписаниеОповещения("ОповещениеВопросПередУдалениемСтроки", ЭтотОбъект,
		ИдентификаторСтроки);
	ПоказатьВопрос(ОповещениеВопросПередУдалениемСтроки, НСтр("ru = 'Удалить строку?'"), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);
КонецПроцедуры
&НаКлиенте
Процедура ОбъектыЗакупкиСтоимостьЗаЕдиницуОбъектаПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ОбъектыЗакупки.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		ТекущаяСтрока.ОбщаяСтоимостьОбъекта = ТекущаяСтрока.СтоимостьЗаЕдиницуОбъекта * ТекущаяСтрока.Количество;
		ПересчитатьПрибыль(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗакупкиОбщаяСтоимостьОбъектаПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ОбъектыЗакупки.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		Если Не ТекущаяСтрока.Количество = 0 Тогда
			ТекущаяСтрока.СтоимостьЗаЕдиницуОбъекта  = ТекущаяСтрока.ОбщаяСтоимостьОбъекта / ТекущаяСтрока.Количество;
			ПересчитатьПрибыль(ТекущаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗакупкиКоличествоПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ОбъектыЗакупки.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		ТекущаяСтрока.ОбщаяСтоимостьОбъекта = ТекущаяСтрока.СтоимостьЗаЕдиницуОбъекта * ТекущаяСтрока.Количество;
		ПересчитатьПрибыль(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанныеПоставки

&НаКлиенте
Процедура ДанныеПоставкиНоменклатураПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ДанныеПоставки.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		ПриИзмененииНоменклатуры(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоставкиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	ИдентификаторСтроки = Элементы.ДанныеПоставки.ТекущаяСтрока;
	ОповещениеВопросПередУдалениемСтроки = Новый ОписаниеОповещения("ОповещениеВопросПередУдалениемСтроки", ЭтотОбъект,
		ИдентификаторСтроки);
	ПоказатьВопрос(ОповещениеВопросПередУдалениемСтроки, НСтр("ru='Удалить строку?'"), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоставкиПоставщикПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ДанныеПоставки.ТекущаяСтрока;
	Если Не ИДТекущейСтроки = Неопределено Тогда
		ОбъектыЗакупкиДанныеПоставкиПоставщикПриИзмененииНаСервере(ИДТекущейСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоставкиОбъемЕдиницыПриИзменении(Элемент)
	ИДТекущейСтроки = Элементы.ДанныеПоставки.ТекущаяСтрока;

	Если Не ИДТекущейСтроки = Неопределено Тогда
		ТекущаяСтрока = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(ИДТекущейСтроки);
		ТекущаяСтрока.Объем = ТекущаяСтрока.ОбъемЕдиницы * ТекущаяСтрока.КоличествоПоставщика;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоставкиВесЕдиницыПриИзменении(Элемент)
