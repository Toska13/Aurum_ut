// Существует документ обработки закупки.
// 
// Параметры:
//  ДокументЗакупки - ДокументСсылка.КонтурЗакупки_Закупка - Документ закупки
// 
// Возвращаемое значение:
//  ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки - Существующий документ или пустая ссылка
Функция НайтиДокументОбработкиЗакупки(ДокументЗакупки)
	ОбработкаЗакупки = Документы.КонтурЗакупки_ОбработкаЗакупки.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЗакупки_ОбработкаЗакупки.Ссылка
	|ИЗ
	|	Документ.КонтурЗакупки_ОбработкаЗакупки КАК КонтурЗакупки_ОбработкаЗакупки
	|ГДЕ
	|	КонтурЗакупки_ОбработкаЗакупки.ДокументОснования = &ДокументОснования
	|	И НЕ КонтурЗакупки_ОбработкаЗакупки.ПометкаУдаления
	|	и Не КонтурЗакупки_ОбработкаЗакупки.Ссылка = &ЭтотДокумент";

	Запрос.УстановитьПараметр("ДокументОснования", ДокументЗакупки);
	Запрос.УстановитьПараметр("ЭтотДокумент", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		//@skip-check property-return-type
		ОбработкаЗакупки = Выборка.Ссылка; // ДокументСсылка.КонтурЗакупки_ОбработкаЗакупки
	КонецЕсли;

	Возврат ОбработкаЗакупки;
