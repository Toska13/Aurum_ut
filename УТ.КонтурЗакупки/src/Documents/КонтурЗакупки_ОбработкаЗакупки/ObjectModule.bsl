Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьИтогиПоДокументу();
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЗакупки_Закупка") Тогда

		ДокументОбработки = НайтиДокументОбработкиЗакупки(ДанныеЗаполнения);

		Если Не ЗначениеЗаполнено(ДокументОбработки) Тогда
			ЗаполнениеНаОснованииЗакупки(ДанныеЗаполнения);
		Иначе
			СтандартнаяОбработка = Ложь;
			ТекстИсключения = СтрШаблон(
				НСтр("ru = 'Документ обработки для этой закупки уже существует: %1'"), Строка(ДокументОбработки));
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Заполнение итогов по документу
Процедура ЗаполнитьИтогиПоДокументу() Экспорт
	СуммаЗатрат = ОбъектыЗакупки.Итог("СуммаЗатрат");
	СуммаЗатратВЦене = ОбъектыЗакупки.Итог("СуммаЗатратВЦене");
	СуммаЗакупки = ОбъектыЗакупки.Итог("ОбщаяСтоимостьОбъекта");
	СуммаПоставщика = ОбъектыЗакупки.Итог("СуммаПоставщика");
	СуммаПродажи = ОбъектыЗакупки.Итог("СуммаПродажи");
	СуммаПрибыли = ОбъектыЗакупки.Итог("СуммаПрибыли");
	Вес = ОбъектыЗакупки.Итог("Вес");
	Объем = ОбъектыЗакупки.Итог("Объем");
	Если СуммаПоставщика > 0 Тогда
		ПроцентМаржи = СуммаПрибыли * 100 / СуммаПоставщика;
	Иначе
		ПроцентМаржи = 0;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьТаблицуПользователейПоРолям() Экспорт
	МассивРолей = Новый Массив; // Массив из ОбъектМетаданныхРоль
	МассивРолей.Добавить(Метаданные.Роли.КонтурЗакупки_ОтделПродаж);
	МассивРолей.Добавить(Метаданные.Роли.КонтурЗакупки_ОтделЛогистики);
	МассивРолей.Добавить(Метаданные.Роли.КонтурЗакупки_ОтделСнабжения);
//	МассивРолей.Добавить(Метаданные.Роли.КонтурЗакупки_ОтделФинансов);

	Для Каждого Роль Из МассивРолей Цикл
		СтрокаРоль = ПользователиПоРолям.Найти (Роль.Имя, "РольИмя");
		Если СтрокаРоль = Неопределено Тогда
			НовСтр = ПользователиПоРолям.Добавить();
			НовСтр.РольИмя = Роль.Имя;
			НовСтр.РольСиноним = Роль.Синоним;
			МассивПользователейСРолью = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.ПолучитьМассивПользователейСРолью(
				Роль);
			Если МассивПользователейСРолью.Количество() > 0 Тогда
				НовСтр.Пользователь = МассивПользователейСРолью[0];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удалить непроверяемые реквизиты из массива.
// 
// Параметры:
//  МассивРеквизитов - Массив из Строка - Массив реквизитов
//  МассивНепроверяемыхРеквизитов - Массив из Строка - Массив непроверяемых реквизитов
Процедура УдалитьНепроверяемыеРеквизитыИзМассива(МассивРеквизитов, МассивНепроверяемыхРеквизитов)
	Для Каждого ЭлементМассива Из МассивНепроверяемыхРеквизитов Цикл
		ПорядковыйНомер = МассивРеквизитов.Найти(ЭлементМассива);
		Если Не ПорядковыйНомер = Неопределено Тогда
			МассивРеквизитов.Удалить(ПорядковыйНомер);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнениеНаОснованииЗакупки(ДокументЗакупки)
	ДокументОснования = ДокументЗакупки;
	ЗаполнитьТаблицуПользователейПоРолям();

	СтатусОбработкиЗакупки = Перечисления.КонтурЗакупки_СтатусыОбработкиЗакупки.Новая;
	СуммаЗакупки = ДокументЗакупки.НМЦЗакупки;
	ИмяОписаниеЗакупки = ДокументЗакупки.ИмяОписаниеЗакупки;
	НомерЗакупки = ДокументЗакупки.НомерЗакупки;
	СуммаЗатрат = 0;
	Пользователь = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.ПолучитьТекущегоПользователя();
	Автор = КонтурЗакупки_ЛокализацияУТ11_РаботаСЗакупкамиСервер.ПолучитьТекущегоПользователя();

	ОрганизаторыЗаказчики.Очистить();
	ОбъектыЗакупки.Очистить();
	ОбъектыЗатрат.Очистить();

	ЗапросОрганизаторыИЗаказчики = Новый Запрос;
	ЗапросОрганизаторыИЗаказчики.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтурЗакупки_Закупка.ОрганизаторНаименование,
	|	КонтурЗакупки_Закупка.ОрганизаторИНН,
	|	КонтурЗакупки_Закупка.ОрганизаторКПП,
	|	ИСТИНА КАК ЭтоОрганизатор
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка КАК КонтурЗакупки_Закупка
	|ГДЕ
	|	КонтурЗакупки_Закупка.Ссылка = &Ссылка
	|	И Не КонтурЗакупки_Закупка.ОрганизаторНаименование = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияНаименование,
	|	КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияИНН,
	|	КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияКПП,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.Заказчики КАК КонтурЗакупки_ЗакупкаЗаказчики
	|ГДЕ
	|	КонтурЗакупки_ЗакупкаЗаказчики.Ссылка = &Ссылка
	|	И Не КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияНаименование = """"
	|СГРУППИРОВАТЬ ПО
