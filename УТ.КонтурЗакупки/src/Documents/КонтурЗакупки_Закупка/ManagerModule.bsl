
#Область ПрограммныйИнтерфейс

// Переопределяет настройки печати для объекта.
//
// Параметры:
//  Настройки - см. УправлениеПечатью.НастройкиПечатиОбъекта.
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт
	
	Настройки.ПриДобавленииКомандПечати = Истина;
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КонтурЗакупки_Закупка_ПечатнаяФормаЗакупка";
	КомандаПечати.Представление = НСтр("ru = 'Закупка'");
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КонтурЗакупки_Закупка_ПечатнаяФормаЗакупка");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"КонтурЗакупки_Закупка_ПечатнаяФормаЗакупка",
			НСтр("ru = 'Закупка'"),
			СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати),
			,
			"Документ.КонтурЗакупки_Закупка.ПФ_Закупка");
	КонецЕсли;
		
КонецПроцедуры

// Получить путь от корневой папки.
// 
// Параметры:
//  СсылкаНаЗакупку - ДокументСсылка.КонтурЗакупки_Закупка, ДокументОбъект.КонтурЗакупки_Закупка, ДанныеФормыСтруктура - Ссылка или объект закупки
// 
// Возвращаемое значение:
//  Строка - Относительный путь от корневой папки
Функция ПолучитьПутьОтКорневойПапки(СсылкаНаЗакупку) Экспорт
	ФайлыЗакупокПутьОтКорня = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки("ФайлыЗакупокПутьОтКорня",
		"");
	ФайлыЗакупокПутьОтКорня = СтрЗаменить(ФайлыЗакупокПутьОтКорня, "[ИдентификаторЗакупки]",
		СсылкаНаЗакупку.ИдентификаторЗакупки);

	Если Не ПустаяСтрока(СсылкаНаЗакупку.ОрганизаторИНН) Тогда
		ФайлыЗакупокПутьОтКорня = СтрЗаменить(ФайлыЗакупокПутьОтКорня, "[ОрганизаторИНН]",
			СсылкаНаЗакупку.ОрганизаторИНН);
	Иначе
		Если СсылкаНаЗакупку.Заказчики.Количество() > 0 Тогда
			ФайлыЗакупокПутьОтКорня = СтрЗаменить(ФайлыЗакупокПутьОтКорня, "[ОрганизаторИНН]",
				СсылкаНаЗакупку.Заказчики[0].ОрганизацияИНН);
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(СсылкаНаЗакупку.ОрганизаторКПП) Тогда
		ФайлыЗакупокПутьОтКорня = СтрЗаменить(ФайлыЗакупокПутьОтКорня, "[ОрганизаторКПП]",
			СсылкаНаЗакупку.ОрганизаторКПП);
	Иначе
		Если СсылкаНаЗакупку.Заказчики.Количество() > 0 Тогда
			ФайлыЗакупокПутьОтКорня = СтрЗаменить(ФайлыЗакупокПутьОтКорня, "[ОрганизаторКПП]",
				СсылкаНаЗакупку.Заказчики[0].ОрганизацияКПП);
		КонецЕсли;
	КонецЕсли;

	ФайлыЗакупокПутьОтКорня = СтрЗаменить(ФайлыЗакупокПутьОтКорня, "[НомерЗакупки]", СсылкаНаЗакупку.НомерЗакупки);
	Возврат ФайлыЗакупокПутьОтКорня;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КонтурЗакупки_Закупка_ПечатнаяФормаЗакупка"; 
	
	Первый = Истина;
	
	Для Каждого ОбъектМассива Из МассивОбъектов Цикл
		
		Если Первый Тогда
			Первый = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокОбъектаПечати = СформироватьПечатнуюФормуЗакупка(ОбъектМассива);
		ТабличныйДокумент.Вывести(ТабДокОбъектаПечати);
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ТолькоПросмотр = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФормуЗакупка(СсылкаНаОбъектПечати)
	
	Макет = ПолучитьМакет("ПФ_Закупка");
	
	ДанныеДляПечати = ДанныеДляПечати(СсылкаНаОбъектПечати);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КонтурЗакупки_Закупка_ПечатнаяФорма"; 
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	//заполняем Области
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(ДанныеДляПечати);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ОбъектыЗакупкиШапка");
	ОбластьМакета.Параметры.Заполнить(ДанныеДляПечати);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбъектыЗакупки = ДанныеДляПечати.ОбъектыЗакупки;
	Для Каждого ОбъектЗакупки Из ОбъектыЗакупки Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ОбъектыЗакупкиСтрока");
		ОбластьМакета.Параметры.Заполнить(ОбъектЗакупки);
		ТабличныйДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ТолькоПросмотр = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // СформироватьПечатнуюФормуДополнительногоОбъектаПечати()

Функция ДанныеДляПечати(Закупка)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурЗакупки_Закупка.Ссылка КАК Ссылка,
		|	КонтурЗакупки_Закупка.ВерсияДанных КАК ВерсияДанных,
		|	КонтурЗакупки_Закупка.ПометкаУдаления КАК ПометкаУдаления,
		|	КонтурЗакупки_Закупка.Номер КАК Номер,
		|	КонтурЗакупки_Закупка.Дата КАК Дата,
		|	КонтурЗакупки_Закупка.Проведен КАК Проведен,
		|	КонтурЗакупки_Закупка.Валюта КАК Валюта,
		|	КонтурЗакупки_Закупка.ДатаОкончанияПодачиЗаявок КАК ДатаОкончанияПодачиЗаявок,
		|	КонтурЗакупки_Закупка.ДатаПодведенияИтогов КАК ДатаПодведенияИтогов,
		|	КонтурЗакупки_Закупка.ДатаПоследнегоИзмененияЗакупки КАК ДатаПоследнегоИзмененияЗакупки,
		|	КонтурЗакупки_Закупка.ДатаПроведенияАукциона КАК ДатаПроведенияАукциона,
		|	КонтурЗакупки_Закупка.ДатаСозданияЗакупки КАК ДатаСозданияЗакупки,
		|	КонтурЗакупки_Закупка.ИдентификаторЗакупки КАК ИдентификаторЗакупки,
		|	КонтурЗакупки_Закупка.ИмяОписаниеЗакупки КАК ИмяОписаниеЗакупки,
		|	КонтурЗакупки_Закупка.КонтактныеДанныеИмя КАК КонтактныеДанныеИмя,
		|	КонтурЗакупки_Закупка.КонтактныеДанныеТелефон КАК КонтактныеДанныеТелефон,
		|	КонтурЗакупки_Закупка.КонтактныеДанныеЭлектроннаяПочта КАК КонтактныеДанныеЭлектроннаяПочта,
		|	КонтурЗакупки_Закупка.НМЦЗакупки КАК НМЦЗакупки,
		|	КонтурЗакупки_Закупка.НомерЗакупки КАК НомерЗакупки,
		|	КонтурЗакупки_Закупка.ОрганизаторИНН КАК ОрганизаторИНН,
		|	КонтурЗакупки_Закупка.ОрганизаторКПП КАК ОрганизаторКПП,
		|	КонтурЗакупки_Закупка.ОрганизаторНаименование КАК ОрганизаторНаименование,
		|	КонтурЗакупки_Закупка.ПризнакЗакупкаДляСМП КАК ПризнакЗакупкаДляСМП,
		|	КонтурЗакупки_Закупка.СпособОтбора КАК СпособОтбора,
		|	КонтурЗакупки_Закупка.СсылкаНаЗакупкуНаЕИС КАК СсылкаНаЗакупкуНаЕИС,
		|	КонтурЗакупки_Закупка.СсылкаНаЗакупкуНаКЗ КАК СсылкаНаЗакупкуНаКЗ,
		|	КонтурЗакупки_Закупка.СсылкаНаЗакупкуНаЭТП КАК СсылкаНаЗакупкуНаЭТП,
		|	КонтурЗакупки_Закупка.СтатусЗакупки КАК СтатусЗакупки,
		|	КонтурЗакупки_Закупка.ТипЗакупки КАК ТипЗакупки,
		|	КонтурЗакупки_Закупка.Комментарий КАК Комментарий,
		|	КонтурЗакупки_Закупка.РучнойВвод КАК РучнойВвод,
		|	КонтурЗакупки_Закупка.ДокументыЗакупки.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		ИмяФайла КАК ИмяФайла,
		|		СсылкаНаФайл КАК СсылкаНаФайл,
		|		ДоступенЛокально КАК ДоступенЛокально
		|	) КАК ДокументыЗакупки,
		|	КонтурЗакупки_Закупка.ОбъектыЗакупки.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Ключ КАК Ключ,
		|		Ключ_ОбъектыЗакупки КАК Ключ_ОбъектыЗакупки,
		|		НаименованиеОбъектаЗакупки КАК НаименованиеОбъектаЗакупки,
		|		Количество КАК Количество,
		|		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|		СтоимостьЗаЕдиницуОбъекта КАК СтоимостьЗаЕдиницуОбъекта,
		|		ОбщаяСтоимостьОбъекта КАК ОбщаяСтоимостьОбъекта,
		|		КТРУКод КАК КТРУКод,
		|		КТРУРасшифровка КАК КТРУРасшифровка,
		|		ОКВЭД2Код КАК ОКВЭД2Код,
		|		ОКВЭД2Расшифровка КАК ОКВЭД2Расшифровка,
		|		ОКПД2Код КАК ОКПД2Код,
		|		ОКПД2Расшифровка КАК ОКПД2Расшифровка,
		|		ТорговоеНаименованиеПрепарата КАК ТорговоеНаименованиеПрепарата,
		|		ЖНВЛП КАК ЖНВЛП,
		|		ОбоснованиеУказанияСведений КАК ОбоснованиеУказанияСведений,
		|		ЕстьЛС КАК ЕстьЛС,
		|		ЕстьХарактеристики КАК ЕстьХарактеристики
		|	) КАК ОбъектыЗакупки
		|ИЗ
		|	Документ.КонтурЗакупки_Закупка КАК КонтурЗакупки_Закупка
		|ГДЕ
		|	КонтурЗакупки_Закупка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Закупка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаШапка = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Результат.Вставить("НомерЗакупки", ВыборкаШапка.НомерЗакупки);
		Результат.Вставить("ИмяОписаниеЗакупки", ВыборкаШапка.ИмяОписаниеЗакупки);
		Результат.Вставить("ОрганизаторНаименование", ВыборкаШапка.ОрганизаторНаименование);
		Результат.Вставить("ОрганизаторИНН", ВыборкаШапка.ОрганизаторИНН);
		Результат.Вставить("ОрганизаторКПП", ВыборкаШапка.ОрганизаторКПП);
		Результат.Вставить("НМЦЗакупки", ВыборкаШапка.НМЦЗакупки);
		Результат.Вставить("ТипЗакупки", ВыборкаШапка.ТипЗакупки);
		Результат.Вставить("СпособОтбора", ВыборкаШапка.СпособОтбора);
		Результат.Вставить("КонтактныеДанныеИмя", ВыборкаШапка.КонтактныеДанныеИмя);
		Результат.Вставить("КонтактныеДанныеТелефон", ВыборкаШапка.КонтактныеДанныеТелефон);
		Результат.Вставить("КонтактныеДанныеЭлектроннаяПочта", ВыборкаШапка.КонтактныеДанныеЭлектроннаяПочта);
		Результат.Вставить("ДатаСозданияЗакупки", ВыборкаШапка.ДатаСозданияЗакупки);
		Результат.Вставить("ДатаОкончанияПодачиЗаявок", ВыборкаШапка.ДатаОкончанияПодачиЗаявок);
		Результат.Вставить("ДатаПодведенияИтогов", ВыборкаШапка.ДатаПодведенияИтогов);

		МассивОбъектовЗакупки = Новый Массив;
		ОбъектЗакупки = ВыборкаШапка.ОбъектыЗакупки.Выбрать();
		
		Пока ОбъектЗакупки.Следующий() Цикл
			
			СтрокаОбъектЗакупки = Новый Структура;
			СтрокаОбъектЗакупки.Вставить("НомерСтроки", ОбъектЗакупки.НомерСтроки);
			СтрокаОбъектЗакупки.Вставить("НаименованиеОбъектаЗакупки", ОбъектЗакупки.НаименованиеОбъектаЗакупки);
			Если ЗначениеЗаполнено(ОбъектЗакупки.ОКПД2Код) Тогда
				СтрокаОбъектЗакупки.Вставить("ОКПД2", СтрШаблон("%1 %2", ОбъектЗакупки.ОКПД2Код, ОбъектЗакупки.ОКПД2Расшифровка));
			Иначе
				СтрокаОбъектЗакупки.Вставить("ОКПД2", "не указан");
			КонецЕсли;
			Если ЗначениеЗаполнено(ОбъектЗакупки.КТРУКод) Тогда
				СтрокаОбъектЗакупки.Вставить("КТРУ", СтрШаблон("%1 %2", ОбъектЗакупки.КТРУКод, ОбъектЗакупки.КТРУРасшифровка));
			Иначе
				СтрокаОбъектЗакупки.Вставить("КТРУ", "не указан");
			КонецЕсли;
			СтрокаОбъектЗакупки.Вставить("СтоимостьЗаЕдиницуОбъекта", ОбъектЗакупки.СтоимостьЗаЕдиницуОбъекта);
			СтрокаОбъектЗакупки.Вставить("Количество", ОбъектЗакупки.Количество);
			СтрокаОбъектЗакупки.Вставить("ЕдиницаИзмерения", ОбъектЗакупки.ЕдиницаИзмерения);
			СтрокаОбъектЗакупки.Вставить("ОбщаяСтоимостьОбъекта", ОбъектЗакупки.ОбщаяСтоимостьОбъекта);
			
			МассивОбъектовЗакупки.Добавить(СтрокаОбъектЗакупки);
			
		КонецЦикла;
		
		Результат.Вставить("ОбъектыЗакупки", МассивОбъектовЗакупки);
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьОрганизатораИзТабличнойЧасти() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияИНН КАК ОрганизаторИНН,
	|	КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияКПП КАК ОрганизаторКПП,
	|	КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияНаименование КАК ОрганизаторНаименование,
	|	КонтурЗакупки_ЗакупкаЗаказчики.Ссылка КАК ЗакупкаСсылка
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.Заказчики КАК КонтурЗакупки_ЗакупкаЗаказчики
	|ГДЕ
	|	КонтурЗакупки_ЗакупкаЗаказчики.НомерСтроки = 1
	|	И НЕ КонтурЗакупки_ЗакупкаЗаказчики.ОрганизацияНаименование = """"
	|	И КонтурЗакупки_ЗакупкаЗаказчики.Ссылка.ОрганизаторНаименование = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.ЗакупкаСсылка.ПолучитьОбъект(); // ДокументОбъект.КонтурЗакупки_Закупка
		ЗаполнитьЗначенияСвойств(ДокОбъект, Выборка);
		ДокОбъект.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

