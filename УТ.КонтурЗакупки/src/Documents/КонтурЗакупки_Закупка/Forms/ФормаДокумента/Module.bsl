#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоЛоты

&НаКлиенте
Процедура ДеревоЛотыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ДеревоЛоты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.СтраницыСтрокДерева.Видимость = Истина;
		Элементы.СтраницыСтрокДерева.ТекущаяСтраница = Элементы.СтраницаПусто;
		Элементы.ТаблицаМестаПоставки1.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ_Заказчики",
			Новый УникальныйИдентификатор);
		Элементы.ОбъектыЗакупки2.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ", Новый УникальныйИдентификатор);
		Элементы.СовместныеОбъектыЗакупки2.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ",
			Новый УникальныйИдентификатор);
	Иначе
		Элементы.СтраницыСтрокДерева.Видимость = Истина;
		Если ТекущиеДанные.ТипСтрокиДерева = "Лот" Тогда
			Элементы.СтраницыСтрокДерева.ТекущаяСтраница = Элементы.СтраницаЛот;
		ИначеЕсли ТекущиеДанные.ТипСтрокиДерева = "Заказчик" Тогда
			Элементы.СтраницыСтрокДерева.ТекущаяСтраница = Элементы.СтраницаЗаказчик;
		ИначеЕсли ТекущиеДанные.ТипСтрокиДерева = "ОбъектЗакупок" Тогда
			Элементы.СтраницыСтрокДерева.ТекущаяСтраница = Элементы.СтраницаСовместныеОбъектыЗакупок;
		КонецЕсли;

		Элементы.ТаблицаМестаПоставки1.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ_Заказчики",
			ТекущиеДанные.Ключ_Заказчики);
		Элементы.ОбъектыЗакупки2.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ", ТекущиеДанные.Ключ_Заказчики);
		Элементы.СовместныеОбъектыЗакупки2.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ", ТекущиеДанные.Ключ_Лоты);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛотыПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ДеревоЛоты.ТекущиеДанные;
	Если ТекущиеДанные.ТипСтрокиДерева = "Лот" Тогда
		ПриУдаленииЛота(ТекущиеДанные.Ключ_Лоты);
	ИначеЕсли ТекущиеДанные.ТипСтрокиДерева = "Заказчик" Тогда
		ПриУдаленииЗаказчика(ТекущиеДанные.Ключ_Заказчики);
	ИначеЕсли ТекущиеДанные.ТипСтрокиДерева = "ОбъектЗакупок" Тогда
		ПриУдаленииСовместногоОЗ(ТекущиеДанные.Ключ_Лоты);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛотыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Элементы.ДеревоЛотыУдалить Тогда

		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если ТекущиеДанные.ТипСтрокиДерева = "Лот" Тогда
			ПриУдаленииЛота(ТекущиеДанные.Ключ_Лоты);
		ИначеЕсли ТекущиеДанные.ТипСтрокиДерева = "Заказчик" Тогда
			ПриУдаленииЗаказчика(ТекущиеДанные.Ключ_Заказчики);
		ИначеЕсли ТекущиеДанные.ТипСтрокиДерева = "ОбъектЗакупок" Тогда
			ПриУдаленииСовместногоОЗ(ТекущиеДанные.Ключ_Лоты);
		КонецЕсли;

		УдаляемаяСтрока = ДеревоЛоты.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
		Родитель = УдаляемаяСтрока.ПолучитьРодителя();

		Если Родитель = Неопределено Тогда
			ДеревоЛоты.ПолучитьЭлементы().Удалить(УдаляемаяСтрока);
		Иначе
			Родитель.ПолучитьЭлементы().Удалить(УдаляемаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектыЗакупки2

&НаКлиенте
Процедура ОбъектыЗакупки2ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ДанныеНовойСтроки = Элементы.ОбъектыЗакупки2.Текущиеданные;
		ДанныеНовойСтроки.Ключ = Элемент.ОтборСтрок.Ключ;
		ДанныеНовойСтроки.Ключ_ОбъектыЗакупки = Новый УникальныйИдентификатор;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗакупки2Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Элементы.ОбъектыЗакупкиЕстьЛС Тогда
		СтрокаОбъекта = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
		СтруктураПраметов = Новый Структура;
		СтруктураПраметов.Вставить("НаименованиеОбъектаЗакупки", СтрокаОбъекта.НаименованиеОбъектаЗакупки);
		СтруктураПраметов.Вставить("ТорговоеНаименованиеПрепарата", СтрокаОбъекта.ТорговоеНаименованиеПрепарата);
		СтруктураПраметов.Вставить("ЖНВЛП", СтрокаОбъекта.ЖНВЛП);
		СтруктураПраметов.Вставить("ОбоснованиеУказанияСведений", СтрокаОбъекта.ОбоснованиеУказанияСведений);
		СтруктураПраметов.Вставить("АдресТаблицыВариантыПоставки", ПолучитьАдресТЗВариантов(
			СтрокаОбъекта.Ключ_ОбъектыЗакупки));

		ОткрытьФорму("Документ.КонтурЗакупки_Закупка.Форма.ФормаПросмотраВариантовПоставки", СтруктураПраметов);

	ИначеЕсли Поле = Элементы.ОбъектыЗакупкиЕстьХарактеристики Тогда
		СтрокаОбъекта = Объект.ОбъектыЗакупки.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
		СтруктураПраметов = Новый Структура;
		СтруктураПраметов.Вставить("НаименованиеОбъектаЗакупки", СтрокаОбъекта.НаименованиеОбъектаЗакупки);
		СтруктураПраметов.Вставить("АдресТаблицыХарактеристик", ПолучитьАдресТЗХарактеристик(
			СтрокаОбъекта.Ключ_ОбъектыЗакупки));

		ОткрытьФорму("Документ.КонтурЗакупки_Закупка.Форма.ФормаПросмотраХарактеристик", СтруктураПраметов);

	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаМестаПоставки1
&НаКлиенте
Процедура ТаблицаМестаПоставки1ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ДанныеНовойСтроки = Элементы.ТаблицаМестаПоставки1.Текущиеданные;
		ДанныеНовойСтроки.Ключ_Заказчики = Элемент.ОтборСтрок.Ключ_Заказчики;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьЛот(Команда)
	НоваяСтрока = ДеревоЛоты.ПолучитьЭлементы().Добавить();
	НоваяСтрока.ТипСтрокиДерева = "Лот";
	НоваяСтрока.НаименованиеЛота = "Наименование лота";
	НоваяСтрока.Ключ_Лоты = Новый УникальныйИдентификатор;
	ВеткаЛотВОбъект(НоваяСтрока);
	ОбновитьОтображениеВеткиЛота(НоваяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаказчика(Команда)

	ТекущиеДанные = Элементы.ДеревоЛоты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИДЛота = "";
		Если ТекущиеДанные.ТипСтрокиДерева = "Лот" Тогда
			Лот = ДеревоЛоты.НайтиПоИдентификатору(Элементы.ДеревоЛоты.ТекущаяСтрока);
			ИДЛота = Лот.Ключ_Лоты;
			НоваяСтрока = Лот.ПолучитьЭлементы().Добавить();
		Иначе
			Родитель = ДеревоЛоты.НайтиПоИдентификатору(Элементы.ДеревоЛоты.ТекущаяСтрока).ПолучитьРодителя();
			ИДЛота = Родитель.Ключ_Лоты;
			НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
		КонецЕсли;
		НоваяСтрока.ТипСтрокиДерева = "Заказчик";
		НоваяСтрока.ОрганизацияНаименование = "Наименование заказчика";
		НоваяСтрока.ОрганизацияИНН = "1234567";
		НоваяСтрока.ОрганизацияКПП = "7654321";
		НоваяСтрока.Ключ_Заказчики = Новый УникальныйИдентификатор;
		НоваяСтрока.Ключ_Лоты = ИДЛота;
		ВеткаЗаказчикВОбъект(НоваяСтрока);
		ОбновитьОтображениеВеткиЗаказчика(НоваяСтрока);
	КонецЕсли;
