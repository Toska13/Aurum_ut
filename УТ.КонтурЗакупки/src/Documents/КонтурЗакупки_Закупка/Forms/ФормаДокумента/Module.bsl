Процедура ВеткаЗаказчикВОбъект(СтрокаДереваЛота)
	ОтборПоИД = Новый Структура("Ключ_Заказчики", СтрокаДереваЛота.Ключ_Заказчики);
	МассивСтрокЗаказчикиПоКлючу = Объект.Заказчики.НайтиСтроки(ОтборПоИД);
	Если МассивСтрокЗаказчикиПоКлючу.Количество() = 0 Тогда
		СтрокаЗаказчики = Объект.Заказчики.Добавить();
	Иначе
		СтрокаЗаказчики = МассивСтрокЗаказчикиПоКлючу[0];
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(СтрокаЗаказчики, СтрокаДереваЛота);
КонецПроцедуры

