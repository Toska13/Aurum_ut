&НаКлиенте
Процедура ВеткаЛотВОбъект(СтрокаДереваЛота)
	ОтборПоИД = Новый Структура("Ключ_Лоты", СтрокаДереваЛота.Ключ_Лоты);
	МассивСтрокЛотыПоКлючу = Объект.Лоты.НайтиСтроки(ОтборПоИД);
	Если МассивСтрокЛотыПоКлючу.Количество() = 0 Тогда
		СтрокаЛота = Объект.Лоты.Добавить();
	Иначе
		СтрокаЛота = МассивСтрокЛотыПоКлючу[0];
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(СтрокаЛота, СтрокаДереваЛота);
КонецПроцедуры

