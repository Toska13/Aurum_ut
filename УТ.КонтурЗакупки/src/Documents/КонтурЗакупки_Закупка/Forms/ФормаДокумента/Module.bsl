
// СтандартныеПодсистемы.Печать 
&НаКлиенте 
Процедура Подключаемый_ВыполнитьКомандуПечати(Команда) 
	УправлениеПечатьюКлиент.ВыполнитьПодключаемуюКомандуПечати(Команда, ЭтаФорма, Объект); 
КонецПроцедуры 
// Конец СтандартныеПодсистемы.Печать

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() Тогда
		Объект.РучнойВвод = Истина;
	КонецЕсли;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	КонтурЗакупки_ЛокализацияВызовСервера.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьДок_ЗадачаСотрудника() Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьЗадачуСотруднику", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьЗадачуСотруднику";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьБП_Задание() Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьЗадание", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьЗадание";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьДокумент("CRM_Интерес") Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьИнтерес", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьИнтерес";
	КонецЕсли;

	Если КонтурЗакупки_ЛокализацияСервер.ЕстьСправочник("СделкиСКлиентами") Тогда
		КнопкаЗадачи = Элементы.Добавить("КомандаСоздатьСделку", Тип("КнопкаФормы"),
			Элементы.ФормаГруппаСоздатьНаОсновании);
		КнопкаЗадачи.ИмяКоманды = "КомандаСоздатьСделку";
	КонецЕсли;

	НаименованиеСправочникаПользователей = КонтурЗакупки_НастройкиВызовСервера.ПолучитьЗначениеНастройки(
		"НаименованиеСправочникаПользователей", "Пользователи");
	ЕстьСправочникПользователей = КонтурЗакупки_ЛокализацияСервер.ЕстьСправочник(НаименованиеСправочникаПользователей);
	Элементы.Ответственный.Видимость = ЕстьСправочникПользователей;
	Если ЕстьСправочникПользователей Тогда
		Элементы.Ответственный.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка."
			+ НаименованиеСправочникаПользователей);
		Ответственный = КонтурЗакупки_ЛокализацияВызовСервера.ПолучитьСсылкуНаОбъектИзПривязки(
		Объект.Ссылка, "Справочники." + НаименованиеСправочникаПользователей, "Ответственный");
	КонецЕсли;
	
	ПМ_КомандаСоздатьОбъектПодключаемая = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЗакупкаКомандаСоздатьОбъектПодключаемая", Неопределено, Ложь);
	Если ПМ_КомандаСоздатьОбъектПодключаемая <> Неопределено Тогда
		Элементы.КнопкаСоздатьОбъектПодключаемая.Заголовок = ПМ_КомандаСоздатьОбъектПодключаемая["Заголовок"];
	Иначе
		Элементы.КнопкаСоздатьОбъектПодключаемая.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ВыбратьКонтрагента.Видимость = Объект.РучнойВвод;

	ОбновитьТаблицуДокументов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	КонтурЗакупки_ЛокализацияКлиентСервер.ОбновитьКоманды(ЭтаФорма, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	КонтурЗакупки_ЛокализацияКлиент.НачатьОбновлениеКоманд(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	УстановитьТолькоПросмотр(Не Объект.РучнойВвод);

	ЗаполнитьДеревоЛоты();

КонецПроцедуры
#КонецОбласти

