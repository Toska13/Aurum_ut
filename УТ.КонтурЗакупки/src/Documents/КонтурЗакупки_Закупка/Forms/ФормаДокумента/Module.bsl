Процедура КомандаСоздатьОбъектПодключаемая(Команда)
		
	ОписаниеРезультата = "";
	
	ПМ_КомандаСоздатьОбъектПодключаемая = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЗакупкаКомандаСоздатьОбъектПодключаемая", Неопределено, Ложь);
	ТипОбъекта = ПМ_КомандаСоздатьОбъектПодключаемая["ТипОбъекта"];
	РезультатСсылка  = КонтурЗакупки_ЛокализацияВызовСервера.ПолучитьСсылкуНаОбъектИзПривязки(Объект.Ссылка, ТипОбъекта, "");
	
	Если Не ЗначениеЗаполнено(РезультатСсылка) Тогда
		РезультатСсылка = КонтурЗакупки_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"ЗакупкаСоздатьОбъектПодключаемая", Объект.Ссылка, Истина);
		Если РезультатСсылка <> Неопределено Тогда
			КонтурЗакупки_ЛокализацияВызовСервера.СоздатьПривязкуЗакупки(Объект.Ссылка,
				ТипОбъекта, "", РезультатСсылка.УникальныйИдентификатор(), Строка(РезультатСсылка));
		КонецЕсли;
	КонецЕсли;

	ПоказатьЗначение(, РезультатСсылка);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьРезультатЗакупки(Команда)
	
	ОчиститьСообщения();
	
	Если Модифицированность Тогда
		ТекстПредупреждения = НСтр("ru = 'Данные еще не записаны. 
							|Загрузка результата закупки возможно только после записи данных.'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.ИдентификаторЗакупки) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен ID закупки.'");
		КонтурЗакупки_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ОписаниеРезультата = ЗагрузитьРезультатЗакупкиНаСервере(Объект.Ссылка, Объект.ИдентификаторЗакупки);
		
	Если ПустаяСтрока(ОписаниеРезультата) Тогда 
		
		ПараметрыОповещения = Новый Структура("ОписаниеРезультата", ОписаниеРезультата);
		Оповещение 			= Новый ОписаниеОповещения("Оповещение_ПослеЗагрузкиРезультатаЗакупки", ЭтаФорма, ПараметрыОповещения); 
		ТекстВопроса 		= НСтр("ru = 'Результат закупки загружен успешно.'") + Символы.ПС + НСтр("ru = 'Открыть результат закупки?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'При загрузке результата закупки возникла ошибка:'") + Символы.ПС + ОписаниеРезультата;
		ПоказатьПредупреждение(Неопределено, ТекстОшибки);
		
	КонецЕсли; 
	
КонецПроцедуры 

&НаКлиенте
Процедура Оповещение_ПослеЗагрузкиРезультатаЗакупки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();	
	ПараметрыФормы.Вставить("Закупка", 						Объект.Ссылка);
	ПараметрыФормы.Вставить("ФормироватьОтчетПриОткрытии", 	Истина);
	ПараметрыФормы.Вставить("ИдентификаторЗакупки", 		Объект.ИдентификаторЗакупки);	
	
	ОткрытьФорму("Отчет.КонтурЗакупки_ОтчетПоРезультатамЗакупок.Форма", ПараметрыФормы, ЭтаФорма, КлючУникальности, Окно);
		
КонецПроцедуры

