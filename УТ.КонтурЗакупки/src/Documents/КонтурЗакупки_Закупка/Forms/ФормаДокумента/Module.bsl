&НаКлиенте
Процедура ОтборЗаказчиковПоЛоту()
	ИДТекущейСтроки = Элементы.Лоты.ТекущаяСтрока;

	Если Не ИДТекущейСтроки = Неопределено И Не Элементы.Лоты.ТекущиеДанные = Неопределено Тогда
		Если ОтбиратьЗаказчикаПоЛоту Тогда
			ФиксСтруктураОтборПоЛоту = Новый ФиксированнаяСтруктура("Ключ_Лоты", Элементы.Лоты.ТекущиеДанные.Ключ_Лоты);
		Иначе
			ФиксСтруктураОтборПоЛоту = Новый ФиксированнаяСтруктура;
		КонецЕсли;

		Элементы.Заказчики.ОтборСтрок = ФиксСтруктураОтборПоЛоту;
		ОтборОбъектовПоЗаказчику();
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ОтборСовместныеОбъектыЗакупкиПоЛоту()
	ИДТекущейСтроки = Элементы.Лоты.ТекущаяСтрока;

	Если Не ИДТекущейСтроки = Неопределено И Не Элементы.Лоты.ТекущиеДанные = Неопределено Тогда
		ФиксСтруктураОтборПоЛоту = Новый ФиксированнаяСтруктура("Ключ", Элементы.Лоты.ТекущиеДанные.Ключ_Лоты);
		Элементы.СовместныеОбъектыЗакупки.ОтборСтрок = ФиксСтруктураОтборПоЛоту;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборОбъектовПоЗаказчику()

	ИДТекущейСтроки = Элементы.Заказчики.ТекущаяСтрока;

	Если Не ИДТекущейСтроки = Неопределено И Не Элементы.Заказчики.ТекущиеДанные = Неопределено Тогда
		Если ОтбиратьОбъектыПоЗаказчику Тогда
			ФиксСтруктураОтборПоЗаказчику = Новый ФиксированнаяСтруктура("Ключ",
				Элементы.Заказчики.ТекущиеДанные.Ключ_Заказчики);
		Иначе
			ФиксСтруктураОтборПоЗаказчику = Новый ФиксированнаяСтруктура;
		КонецЕсли;
		Элементы.ОбъектыЗакупки.ОтборСтрок = ФиксСтруктураОтборПоЗаказчику;

		Элементы.МестаПоставки.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ_Заказчики",
			Элементы.Заказчики.ТекущиеДанные.Ключ_Заказчики);

	КонецЕсли;

КонецПроцедуры

// Конструктор-Структура имеющиеся данные.
// 
// Возвращаемое значение:
//  Структура - Имеющиеся данные:
// * ЕстьОбъектыЗакупки - Булево - 
// * ЕстьОКПД2_ОЗ - Булево - 
// * ЕстьКТРУ_ОЗ - Булево - 
// * ЕстьОКВЭД2_ОЗ - Булево - 
// * ЕстьНаименования_ОЗ - Булево - 
// * ЕстьСовместныеОбъектыЗакупки - Булево - 
// * ЕстьОКПД2_СОЗ - Булево - 
// * ЕстьКТРУ_СОЗ - Булево - 
// * ЕстьОКВЭД2_СОЗ - Булево - 
// * ЕстьНаименования_СОЗ - Булево - 
// * ЕстьАвансВПроцентах - Булево - 
// * ЕстьРазмерОбеспеченияГарантийныхОбязательств - Булево - 
// * ЕстьРазмерОбеспеченияЗаявки - Булево - 
// * ЕстьРазмерОбеспеченияИсполненияКонтрактаПроцент - Булево - 
// * ЕстьРазмерОбеспеченияИсполненияКонтрактаСумма - Булево - 
// * ЕстьРазмерОбеспеченияПоОбслуживаниюПроцент - Булево - 
// * ЕстьРазмерОбеспеченияПоОбслуживаниюСумма - Булево - 
// * ЕстьРазмерОбеспеченияПоПоставкеПроцент - Булево - 
// * ЕстьРазмерОбеспеченияПоПоставкеСумма - Булево - 
&НаСервере
Функция СтруктураИмеющиесяДанные()
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("ЕстьОбъектыЗакупки", Истина);

	СтруктураРезультат.Вставить("ЕстьОКПД2_ОЗ", Ложь);
	СтруктураРезультат.Вставить("ЕстьКТРУ_ОЗ", Ложь);
	СтруктураРезультат.Вставить("ЕстьОКВЭД2_ОЗ", Ложь);
	СтруктураРезультат.Вставить("ЕстьНаименования_ОЗ", Истина);

	СтруктураРезультат.Вставить("ЕстьСовместныеОбъектыЗакупки", Ложь);

	СтруктураРезультат.Вставить("ЕстьОКПД2_СОЗ", Ложь);
	СтруктураРезультат.Вставить("ЕстьКТРУ_СОЗ", Ложь);
	СтруктураРезультат.Вставить("ЕстьОКВЭД2_СОЗ", Ложь);
	СтруктураРезультат.Вставить("ЕстьНаименования_СОЗ", Истина);

	СтруктураРезультат.Вставить("ЕстьАвансВПроцентах", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияГарантийныхОбязательств", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияЗаявки", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияИсполненияКонтрактаПроцент", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияИсполненияКонтрактаСумма", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияПоОбслуживаниюПроцент", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияПоОбслуживаниюСумма", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияПоПоставкеПроцент", Истина);
	СтруктураРезультат.Вставить("ЕстьРазмерОбеспеченияПоПоставкеСумма", Истина);

	Возврат СтруктураРезультат;
КонецФункции

// Получить имеющиеся данные.
// 
// Возвращаемое значение:
//  Структура - См. СтруктураИмеющиесяДанные- Имеющиеся данные
&НаСервере
Функция ПолучитьИмеющиесяДанные()
	СтруктураРезультат = СтруктураИмеющиесяДанные();

	Запрос = Новый Запрос;

#Область ЕстьОбъектыЗакупки
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ЗакупкаОбъектыЗакупки.НаименованиеОбъектаЗакупки КАК НаименованиеОбъектаЗакупки
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.ОбъектыЗакупки КАК КонтурЗакупки_ЗакупкаОбъектыЗакупки
	|ГДЕ
	|	КонтурЗакупки_ЗакупкаОбъектыЗакупки.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	КонтурЗакупки_ЗакупкаОбъектыЗакупки.НаименованиеОбъектаЗакупки";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

	ТЗРезультат = Запрос.Выполнить().Выгрузить();
	Если ТЗРезультат.Количество() = 1 Тогда
		Если Не ПустаяСтрока(ТЗРезультат[0].НаименованиеОбъектаЗакупки) Тогда
			СтруктураРезультат.ЕстьНаименования_ОЗ = Истина;
		КонецЕсли;
	ИначеЕсли ТЗРезультат.Количество() > 1 Тогда
		СтруктураРезультат.ЕстьНаименования_ОЗ = Истина;
	Иначе
		СтруктураРезультат.ЕстьОбъектыЗакупки = Ложь;
	КонецЕсли;
#КонецОбласти

#Область ЕстьСовместныеОбъектыЗакупки
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки.НаименованиеОбъектаЗакупки КАК НаименованиеОбъектаЗакупки
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.СовместныеОбъектыЗакупки КАК КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки
	|ГДЕ
	|	КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки.НаименованиеОбъектаЗакупки";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

	ТЗРезультат = Запрос.Выполнить().Выгрузить();
	Если ТЗРезультат.Количество() = 1 Тогда
		Если Не ПустаяСтрока(ТЗРезультат[0].НаименованиеОбъектаЗакупки) Тогда
			СтруктураРезультат.ЕстьНаименования_СОЗ = Истина;
		КонецЕсли;
	ИначеЕсли ТЗРезультат.Количество() > 1 Тогда
		СтруктураРезультат.ЕстьНаименования_СОЗ = Истина;
	Иначе
		СтруктураРезультат.ЕстьСовместныеОбъектыЗакупки = Ложь;
	КонецЕсли;
#КонецОбласти

#Область ЕстьКоды
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЗакупки_ЗакупкаОбъектыЗакупки.Ключ_ОбъектыЗакупки КАК Ключ_ОбъектыЗакупки_ОЗ
	|ПОМЕСТИТЬ КлючиОбъектовЗакупки
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.ОбъектыЗакупки КАК КонтурЗакупки_ЗакупкаОбъектыЗакупки
	|СГРУППИРОВАТЬ ПО
	|	КонтурЗакупки_ЗакупкаОбъектыЗакупки.Ключ_ОбъектыЗакупки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ключ_ОбъектыЗакупки_ОЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки.Ключ_ОбъектыЗакупки КАК Ключ_ОбъектыЗакупки_СОЗ
	|ПОМЕСТИТЬ КлючиСовместныхОбъектовЗакупки
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.СовместныеОбъектыЗакупки КАК КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки
	|СГРУППИРОВАТЬ ПО
	|	КонтурЗакупки_ЗакупкаСовместныеОбъектыЗакупки.Ключ_ОбъектыЗакупки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ключ_ОбъектыЗакупки_СОЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(КоличестваКодов.ОКПД2Код_ОЗ) КАК ОКПД2Код_ОЗ,
	|	СУММА(КоличестваКодов.КТРУКод_ОЗ) КАК КТРУКод_ОЗ,
	|	СУММА(КоличестваКодов.ОКВЭД2Код_ОЗ) КАК ОКВЭД2Код_ОЗ,
	|	СУММА(КоличестваКодов.ОКПД2Код_СОЗ) КАК ОКПД2Код_СОЗ,
	|	СУММА(КоличестваКодов.КТРУКод_СОЗ) КАК КТРУКод_СОЗ,
	|	СУММА(КоличестваКодов.ОКВЭД2Код_СОЗ) КАК ОКВЭД2Код_СОЗ
	|ИЗ
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2.ОКПД2Код) КАК ОКПД2Код_ОЗ,
	|		0 КАК КТРУКод_ОЗ,
	|		0 КАК ОКВЭД2Код_ОЗ,
	|		0 КАК ОКПД2Код_СОЗ,
	|		0 КАК КТРУКод_СОЗ,
	|		0 КАК ОКВЭД2Код_СОЗ
	|	ИЗ
	|		Документ.КонтурЗакупки_Закупка.КодыОКПД2 КАК КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлючиОбъектовЗакупки КАК КлючиОбъектовЗакупки
	|			ПО КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2.Ключ = КлючиОбъектовЗакупки.Ключ_ОбъектыЗакупки_ОЗ
	|	ГДЕ
	|		КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2.Ссылка = &Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		КОЛИЧЕСТВО(КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ.КТРУКод),
	|		0,
	|		0,
	|		0,
	|		0
	|	ИЗ
	|		Документ.КонтурЗакупки_Закупка.КодыКТРУ КАК КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлючиОбъектовЗакупки КАК КлючиОбъектовЗакупки
	|			ПО КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ.Ключ = КлючиОбъектовЗакупки.Ключ_ОбъектыЗакупки_ОЗ
	|	ГДЕ
	|		КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ.Ссылка = &Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		0,
	|		КОЛИЧЕСТВО(КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2.ОКВЭД2Код),
	|		0,
	|		0,
	|		0
	|	ИЗ
	|		Документ.КонтурЗакупки_Закупка.КодыОКВЭД2 КАК КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлючиОбъектовЗакупки КАК КлючиОбъектовЗакупки
	|			ПО КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2.Ключ = КлючиОбъектовЗакупки.Ключ_ОбъектыЗакупки_ОЗ
	|	ГДЕ
	|		КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2.Ссылка = &Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		0,
	|		0,
	|		КОЛИЧЕСТВО(КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2.ОКПД2Код),
	|		0,
	|		0 З
	|	ИЗ
	|		Документ.КонтурЗакупки_Закупка.КодыОКПД2 КАК КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлючиОбъектовЗакупки КАК КлючиОбъектовЗакупки
	|			ПО КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2.Ключ = КлючиОбъектовЗакупки.Ключ_ОбъектыЗакупки_ОЗ
	|	ГДЕ
	|		КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКПД2.Ссылка = &Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		0,
	|		0,
	|		0,
	|		КОЛИЧЕСТВО(КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ.КТРУКод),
	|		0
	|	ИЗ
	|		Документ.КонтурЗакупки_Закупка.КодыКТРУ КАК КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлючиОбъектовЗакупки КАК КлючиОбъектовЗакупки
	|			ПО КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ.Ключ = КлючиОбъектовЗакупки.Ключ_ОбъектыЗакупки_ОЗ
	|	ГДЕ
	|		КонтурЗакупки_ЗакупкаОбъектыЗакупкиКТРУ.Ссылка = &Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		КОЛИЧЕСТВО(КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2.ОКВЭД2Код)
	|	ИЗ
	|		Документ.КонтурЗакупки_Закупка.КодыОКВЭД2 КАК КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлючиОбъектовЗакупки КАК КлючиОбъектовЗакупки
	|			ПО КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2.Ключ = КлючиОбъектовЗакупки.Ключ_ОбъектыЗакупки_ОЗ
	|	ГДЕ
	|		КонтурЗакупки_ЗакупкаОбъектыЗакупкиОКВЭД2.Ссылка = &Ссылка) КАК КоличестваКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КлючиОбъектовЗакупки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КлючиСовместныхОбъектовЗакупки";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураРезультат.ЕстьОКПД2_ОЗ = ?(Выборка.ОКПД2Код_ОЗ > 0, Истина, Ложь);
		СтруктураРезультат.ЕстьКТРУ_ОЗ = ?(Выборка.КТРУКод_ОЗ > 0, Истина, Ложь);
		СтруктураРезультат.ЕстьОКВЭД2_ОЗ = ?(Выборка.ОКВЭД2Код_ОЗ > 0, Истина, Ложь);

		СтруктураРезультат.ЕстьОКПД2_СОЗ = ?(Выборка.ОКПД2Код_СОЗ > 0, Истина, Ложь);
		СтруктураРезультат.ЕстьКТРУ_СОЗ = ?(Выборка.КТРУКод_СОЗ > 0, Истина, Ложь);
		СтруктураРезультат.ЕстьОКВЭД2_СОЗ = ?(Выборка.ОКВЭД2Код_СОЗ > 0, Истина, Ложь);
	КонецЕсли;

#КонецОбласти

#Область ЕстьОбеспечение
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.АвансВПроцентах) > 0 КАК ЕстьАвансВПроцентах,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияГарантийныхОбязательств) > 0 КАК
	|		ЕстьРазмерОбеспеченияГарантийныхОбязательств,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияЗаявки) > 0 КАК ЕстьРазмерОбеспеченияЗаявки,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияИсполненияКонтрактаПроцент) > 0 КАК
	|		ЕстьРазмерОбеспеченияИсполненияКонтрактаПроцент,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияИсполненияКонтрактаСумма) > 0 КАК
	|		ЕстьРазмерОбеспеченияИсполненияКонтрактаСумма,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияПоОбслуживаниюПроцент) > 0 КАК
	|		ЕстьРазмерОбеспеченияПоОбслуживаниюПроцент,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияПоОбслуживаниюСумма) > 0 КАК
	|		ЕстьРазмерОбеспеченияПоОбслуживаниюСумма,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияПоПоставкеПроцент) > 0 КАК ЕстьРазмерОбеспеченияПоПоставкеПроцент,
	|	СУММА(КонтурЗакупки_ЗакупкаЗаказчики.РазмерОбеспеченияПоПоставкеСумма) > 0 КАК ЕстьРазмерОбеспеченияПоПоставкеСумма
	|ИЗ
	|	Документ.КонтурЗакупки_Закупка.Заказчики КАК КонтурЗакупки_ЗакупкаЗаказчики
	|ГДЕ
	|	КонтурЗакупки_ЗакупкаЗаказчики.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, Выборка);
	КонецЕсли;
#КонецОбласти

	Возврат СтруктураРезультат;
КонецФункции

&НаСервере
Процедура ИсправитьКодыНаСервере()
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.ИсправитьКоды();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДеревоЛоты()
	Для Каждого СтрокаЛот Из ДеревоЛоты.ПолучитьЭлементы() Цикл
		ДеревоЛоты.ПолучитьЭлементы().Удалить(СтрокаЛот);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДеревоЛоты()
	Для Каждого СтрокаЛот Из Объект.Лоты Цикл

		НоваяСтрока = ДеревоЛоты.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЛот);
		НоваяСтрока.ПерваяКолонка = СтрокаЛот.НаименованиеЛота;
		НоваяСтрока.ВтораяКолонка = СтрокаЛот.ЦенаЛотаСумма;
		НоваяСтрока.ТипСтрокиДерева = "Лот";
		НоваяСтрока.Удалить = Истина;

		Если Объект.СовместныеОбъектыЗакупки.Количество() > 0 Тогда
			НоваяСтрокаСовместныеЗакупки = НоваяСтрока.ПолучитьЭлементы().Добавить();
			НоваяСтрокаСовместныеЗакупки.ПерваяКолонка = "Совместные объекты закупок";
			НоваяСтрокаСовместныеЗакупки.ТипСтрокиДерева = "ОбъектЗакупок";
			НоваяСтрокаСовместныеЗакупки.Удалить = Истина;
		КонецЕсли;

		ПоискЗаказчик = Новый Структура("Ключ_Лоты", СтрокаЛот.Ключ_Лоты);
		НашлиСтроки = Объект.Заказчики.НайтиСтроки(ПоискЗаказчик);
		Для Каждого НашлиСтроку Из НашлиСтроки Цикл
			НоваяСтрокаЗаказчик = НоваяСтрока.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЗаказчик, НашлиСтроку);
			НоваяСтрокаЗаказчик.ПерваяКолонка = НашлиСтроку.ОрганизацияНаименование;
			НоваяСтрокаЗаказчик.ВтораяКолонка = СтрШаблон("ИНН: %1", НашлиСтроку.ОрганизацияИНН);
			НоваяСтрокаЗаказчик.ТипСтрокиДерева = "Заказчик";
			НоваяСтрокаЗаказчик.Удалить = Истина;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекстовыйДокумент(Заголовок, Текст)

	ФормаТекста = ПолучитьФорму("ОбщаяФорма.КонтурЗакупки_ФормаТекста");
	ФормаТекста.Заголовок = Заголовок;
	ФормаТекста.Текст = Текст;
	ФормаТекста.Открыть();
	
КонецПроцедуры // ПоказатьТекстовыйДокумент()

&НаКлиенте
Процедура ВыбратьКонтрагента(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораКонтрагента", ЭтаФорма);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора",,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКонтрагента(ВыбранныйКонтрагент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйКонтрагент <> Неопределено Тогда
		
		РеквизитыКонтрагента = РеквизитыКонтрагента(ВыбранныйКонтрагент);
		Объект.ОрганизаторИНН = РеквизитыКонтрагента.ИНН;
		Объект.ОрганизаторКПП = РеквизитыКонтрагента.КПП;
		Объект.ОрганизаторНаименование = РеквизитыКонтрагента.НаименованиеПолное;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыКонтрагента(Контрагент)
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Наименование, НаименованиеПолное, ИНН, КПП");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РучнойВводПриИзменении(Элемент)
	Элементы.ВыбратьКонтрагента.Видимость = Объект.РучнойВвод;
КонецПроцедуры

#КонецОбласти