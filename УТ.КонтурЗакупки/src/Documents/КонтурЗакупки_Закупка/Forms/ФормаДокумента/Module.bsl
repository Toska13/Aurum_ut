#Область ПриУдаленииВеток
&НаСервере
Процедура ПриУдаленииЛота(Ключ_Лоты)
	ПриУдаленииСовместногоОЗ(Ключ_Лоты);

	Отбор = Новый Структура("Ключ_Лоты", Ключ_Лоты);
	МассивСтрок = Объект.Лоты.НайтиСтроки(Отбор);

	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		МассивСтрок1 = Объект.Заказчики.НайтиСтроки(Отбор);
		Для Каждого СтрокаНаУдаление1 Из МассивСтрок1 Цикл
			ПриУдаленииЗаказчика(СтрокаНаУдаление1.Ключ_Заказчики);
		КонецЦикла;

		Объект.Лоты.Удалить(СтрокаНаУдаление);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриУдаленииСовместногоОЗ(Ключ_Лоты)
	Отбор = Новый Структура("Ключ", Ключ_Лоты);
	МассивСтрок = Объект.СовместныеОбъектыЗакупки.НайтиСтроки(Отбор);

	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		ПриУдаленииОбъектаЗакупки(СтрокаНаУдаление.Ключ_ОбъектыЗакупки);
		Объект.СовместныеОбъектыЗакупки.Удалить(СтрокаНаУдаление);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриУдаленииЗаказчика(Ключ_Заказчики)
	Отбор = Новый Структура("Ключ_Заказчики", Ключ_Заказчики);
	МассивСтрок = Объект.МестаПоставки.НайтиСтроки(Отбор);

	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		Объект.МестаПоставки.Удалить(СтрокаНаУдаление);
	КонецЦикла;

	Отбор1 = Новый Структура("Ключ", Ключ_Заказчики);
	МассивСтрок = Объект.ОбъектыЗакупки.НайтиСтроки(Отбор1);

	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		ПриУдаленииОбъектаЗакупки(СтрокаНаУдаление.Ключ_ОбъектыЗакупки);
		Объект.ОбъектыЗакупки.Удалить(СтрокаНаУдаление);
	КонецЦикла;

	МассивСтрок = Объект.Заказчики.НайтиСтроки(Отбор);

	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		Объект.Заказчики.Удалить(СтрокаНаУдаление);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПриУдаленииОбъектаЗакупки(Ключ_ОбъектыЗакупки)
	Отбор = Новый Структура("Ключ", Ключ_ОбъектыЗакупки);
	МассивСтрок = Объект.КодыКТРУ.НайтиСтроки(Отбор);
	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		Объект.КодыКТРУ.Удалить(СтрокаНаУдаление);
	КонецЦикла;

	МассивСтрок = Объект.КодыОКВЭД2.НайтиСтроки(Отбор);
	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		Объект.КодыОКВЭД2.Удалить(СтрокаНаУдаление);
	КонецЦикла;

	МассивСтрок = Объект.КодыОКПД2.НайтиСтроки(Отбор);
	Для Каждого СтрокаНаУдаление Из МассивСтрок Цикл
		Объект.КодыОКПД2.Удалить(СтрокаНаУдаление);
	КонецЦикла;

КонецПроцедуры
