	<item>
		<selection>
			<item>
				<field>ДанныеПоставки</field>
			</item>
			<item>
				<field>КП</field>
			</item>
		</selection>
		<filter>
			<item xsi:type="FilterItemComparison">
				<left xsi:type="dcscor:Field">Объект.ОбъектыЗакупки.ПоставкаНевозможна</left>
