				<field>ДанныеПоставкиСрокДоставкиДоЗаказчика</field>
			</item>
		</selection>
		<filter>
			<item xsi:type="FilterItemComparison">
				<left xsi:type="dcscor:Field">Объект.СтатусОбработкиЗакупки</left>
				<comparisonType>Equal</comparisonType>
				<right xsi:type="dcscor:DesignTimeValue">Перечисление.КонтурЗакупки_СтатусыОбработкиЗакупки.ПринятВРаботу</right>
			</item>
		</filter>
		<appearance>
