#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.НомерВерсии = "0.0.0.0" Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ИмяВременногоФайлаМакета = ПолучитьИмяВременногоФайла("mxl");

	ОписаниеОбновленийURL = СтрШаблон("https://update.kontur.ru/1c/v1/%1/release-notes?id=%1&version=%2",
		Параметры.НазваниеПродукта, Параметры.НомерВерсии);

	Попытка
		КопироватьФайл(ОписаниеОбновленийURL, ИмяВременногоФайлаМакета);
	Исключение
		Отказ = Истина;
		КонтурЗакупки_СлужебныеВызовСервера.СообщитьПользователю(НСтр(
			"ru = 'Не удалось загрузить описание обновлений!'"));
		Возврат;
	КонецПопытки;

	ОписаниеОбновлений = Новый ТабличныйДокумент;
	ОписаниеОбновлений.Прочитать(ИмяВременногоФайлаМакета);
	УдалитьФайлы(ИмяВременногоФайлаМакета);

	ТабличныйДокументОписаниеОбновлений.Вывести(ОписаниеОбновлений);
	Заголовок = СтрШаблон("%1 (версия: %2)", Параметры.Представление, Параметры.НомерВерсии);

КонецПроцедуры

#КонецОбласти