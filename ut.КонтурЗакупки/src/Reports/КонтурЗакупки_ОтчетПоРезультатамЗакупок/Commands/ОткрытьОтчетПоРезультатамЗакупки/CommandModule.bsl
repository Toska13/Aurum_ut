
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
		
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Закупка", ПараметрКоманды);
	ПараметрыФормы.Вставить("ФормироватьОтчетПриОткрытии", Истина);
	
	ФормаВладелец = ПараметрыВыполненияКоманды.Источник;
	
	Если ФормаВладелец.ИмяФормы = "Документ.КонтурЗакупки_Закупка.Форма.ФормаДокумента" Тогда
		ПараметрыФормы.Вставить("ИдентификаторЗакупки", ФормаВладелец.Объект.ИдентификаторЗакупки);			
	КонецЕсли;
	
	ОткрытьФорму("Отчет.КонтурЗакупки_ОтчетПоРезультатамЗакупок.Форма", 
		ПараметрыФормы, 
		ПараметрыВыполненияКоманды.Источник, 
		ПараметрыВыполненияКоманды.Уникальность, 
		ПараметрыВыполненияКоманды.Окно, 
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		
КонецПроцедуры
