#Область ПрограммныйИнтерфейс

// Есть бизнес-процесс задание.
// 
// Возвращаемое значение:
//  Булево - Есть БП задание
Функция ЕстьБП_Задание() Экспорт
	Возврат Не Метаданные.БизнесПроцессы.Найти("Задание") = Неопределено;
КонецФункции

// Есть док задача сотрудника.
// 
// Возвращаемое значение:
//  Булево - Есть док задача сотрудника
Функция ЕстьДок_ЗадачаСотрудника() Экспорт
	Возврат ЕстьДокумент("ЗадачаСотрудника");
КонецФункции

// Есть справочник.
// 
// Параметры:
//  НаименованиеСправочника - Строка - Наименование справочника
// 
// Возвращаемое значение:
//  Булево - Есть справочник
Функция ЕстьСправочник(НаименованиеСправочника) Экспорт
	Если ПустаяСтрока(НаименованиеСправочника) Тогда
		Возврат Ложь;
	Иначе
		Возврат Не Метаданные.Справочники.Найти(НаименованиеСправочника) = Неопределено;
	КонецЕсли;
КонецФункции

// Есть документ.
// 
// Параметры:
//  НаименованиеДокумента - Строка - Наименование документа
// 
// Возвращаемое значение:
//  Булево - Есть документ
Функция ЕстьДокумент(НаименованиеДокумента) Экспорт
	Если ПустаяСтрока(НаименованиеДокумента) Тогда
		Возврат Ложь;
	Иначе
		Возврат Не Метаданные.Документы.Найти(НаименованиеДокумента) = Неопределено;
	КонецЕсли;
КонецФункции

// Иерархический справочник.
// 
// Параметры:
//  НаименованиеСправочника - Строка - Наименование справочника
// 
// Возвращаемое значение:
//  Булево - Иерархический справочник
Функция ИерархическийСправочник(НаименованиеСправочника) Экспорт
	Иерархический = Ложь;
	Если ЕстьСправочник(НаименованиеСправочника) Тогда
		Иерархический = Метаданные.Справочники[НаименованиеСправочника].Иерархический;
	КонецЕсли;

	Возврат Иерархический;
КонецФункции
#КонецОбласти