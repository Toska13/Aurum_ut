#Область ПрограммныйИнтерфейс

// Метрика отправить метрику.
// 
// Параметры:
//  СтруктураДанных - Неопределено, Структура - Структура данных:
// * СтруктураКлиента - Структура - :
// ** ClientID - Строка - 
// ** ClientName - Строка - 
// ** ClientVersion - Строка - 
// ** moduleName - Строка - 
// * МассивСобытий - Массив из Структура - 
// * topic - Строка - 
// 
// Возвращаемое значение:
//  Неопределено, Структура - Метрика отправить метрику:
// * data - Неопределено, Произвольный - 
// * error - Булево - 
// * message - Строка - 
// * traceId - Строка - 
Функция ОтправитьМетрику(СтруктураДанных) Экспорт

	РезультатHTTPЗапроса = Неопределено;

	Если Не СтруктураДанных = Неопределено Тогда
		ПараметрыHTTPЗапроса = КонтурЗакупки_МетрикиВызовСервера.ПолучитьСтруктуруЗапросаМетрики(СтруктураДанных);
		РезультатHTTPЗапроса = КонтурЗакупки_httpКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыHTTPЗапроса);
	КонецЕсли;

	Возврат РезультатHTTPЗапроса;

КонецФункции

#КонецОбласти