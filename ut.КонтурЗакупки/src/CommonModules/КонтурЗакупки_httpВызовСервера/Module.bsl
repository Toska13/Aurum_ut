#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполнить HTTPЗапрос.
// 
// Параметры:
//  ПараметрыHTTPЗапроса - см. КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса
// 
// Возвращаемое значение:
//  см. КонтурЗакупки_СтруктурыКлиентСервер.ИнициализироватьРезультатФункции
Функция ВыполнитьHTTPЗапрос(ПараметрыHTTPЗапроса) Экспорт

	РезультатФункции = КонтурЗакупки_СтруктурыКлиентСервер.ИнициализироватьРезультатФункции();

	Если ПараметрыHTTPЗапроса <> Неопределено Тогда

		Если ПараметрыHTTPЗапроса["ЗащищенноеСоединение"] Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, );
		Иначе
			ЗащищенноеСоединение = Неопределено;
		КонецЕсли;
				
		Таймаут = КонтурЗакупки_СлужебныеВызовСервера.ПолучитьТаймаут(ПараметрыHTTPЗапроса["Метод"],
			ПараметрыHTTPЗапроса["ОтправитьФайл"], ПараметрыHTTPЗапроса["ПолучитьФайл"]);
		HTTPСоединение = Новый HTTPСоединение(ПараметрыHTTPЗапроса["АдресСервера"], ПараметрыHTTPЗапроса["ПортСервера"],
			, , , Таймаут, ЗащищенноеСоединение);
		HTTPЗапрос = Новый HTTPЗапрос(ПараметрыHTTPЗапроса["СтрокаПодключения"], ПараметрыHTTPЗапроса["ЗаголовокHTTP"]);

		СтрокаДанныхПодключения = ПараметрыHTTPЗапроса["АдресСервера"] + "/" + ПараметрыHTTPЗапроса["СтрокаПодключения"];

		МассивЗапросов = ПараметрыHTTPЗапроса["ТелоЗапроса"];
		Если ТипЗнч(МассивЗапросов) = Тип("Массив") Тогда
			data = Новый Массив;
		Иначе
			data = Неопределено;
			МассивЗапросов = Новый Массив;
			МассивЗапросов.Добавить(ПараметрыHTTPЗапроса["ТелоЗапроса"]);
		КонецЕсли;

		ТекстОшибки = "";
		ЭтоОшибка = Ложь;
		ИдентификаторЗапроса = "";

		Для Каждого ТелоЗапроса Из МассивЗапросов Цикл

			Если ТелоЗапроса <> Неопределено Тогда
				Если ПараметрыHTTPЗапроса["ОтправитьФайл"] Тогда
					HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
				Иначе
					HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8,
						ИспользованиеByteOrderMark.НеИспользовать);
				КонецЕсли;
			КонецЕсли;

			РезультатHTTP = Неопределено;
			Попытка
				РезультатHTTP =  HTTPСоединение.ВызватьHTTPМетод(ПараметрыHTTPЗапроса["Метод"], HTTPЗапрос);
			Исключение
				ЭтоОшибка = Истина;
				ТекстОшибки = ТекстОшибки + ?(ТекстОшибки = "", "", Символы.ПС) + СтрШаблон(
					НСтр("ru = 'Неудачная попытка соединения: %1'"), ОписаниеОшибки());
			КонецПопытки;

			Если Не РезультатHTTP = Неопределено Тогда

				Если (РезультатHTTP.КодСостояния >= 400 И РезультатHTTP.КодСостояния < 500)
					Или (РезультатHTTP.КодСостояния >= 500 И РезультатHTTP.КодСостояния < 600)
					Или (РезультатHTTP.КодСостояния >= 300 И РезультатHTTP.КодСостояния < 400) Тогда
					ТекстОшибки = ТекстОшибки + ?(ТекстОшибки = "", "", Символы.ПС) + СтрШаблон(НСтр(
						"ru = 'Код статуса: %1: %2'"), СокрЛП(
							РезультатHTTP.КодСостояния), СокрЛП(РезультатHTTP.ПолучитьТелоКакСтроку()));
					ЭтоОшибка = Истина;
				Иначе
					Если ПараметрыHTTPЗапроса["ПолучитьФайл"] Тогда
						СтруктураДанных = РезультатHTTP.ПолучитьТелоКакДвоичныеДанные();
						Если data = Неопределено Тогда
							data = СтруктураДанных;
						Иначе
							data.Добавить(СтруктураДанных);
						КонецЕсли;
					Иначе
						РезультатСтрокой = РезультатHTTP.ПолучитьТелоКакСтроку();
						Если РезультатHTTP.КодСостояния < 300 И Не РезультатСтрокой = "" Тогда
							СтруктураДанных = КонтурЗакупки_СлужебныеВызовСервера.ПреобразоватьИзJSON(
								РезультатСтрокой);
							Если data = Неопределено Тогда
								data = СтруктураДанных;
							Иначе
								data.Добавить(СтруктураДанных);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				Для Каждого СтрокаЗаголовка Из РезультатHTTP.Заголовки Цикл
					//нам нужен только X-Kontur-Trace-Id
					Если СтрНайти(НРег(СтрокаЗаголовка.Ключ), НРег("X-Kontur-Trace-Id")) > 0 Тогда
						ТекстОшибки = ТекстОшибки + Символы.ПС + СтрокаЗаголовка.Ключ + ": " + СтрокаЗаголовка.Значение;
						ИдентификаторЗапроса = СтрокаЗаголовка.Значение;
					КонецЕсли;
				КонецЦикла;

			КонецЕсли;

		КонецЦикла;

		РезультатФункции.message = ТекстОшибки;
		РезультатФункции.error = ЭтоОшибка;
		РезультатФункции.data = data;
		РезультатФункции.traceid = ИдентификаторЗапроса;

		Если ЭтоОшибка Тогда
			ПрефиксПродукта = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьПрефиксПродукта();
			КонтурЗакупки_СлужебныеВызовСервера.ДобавитьЛог(ПрефиксПродукта, ТекстОшибки + Символы.ПС
				+ СтрокаДанныхПодключения);
		КонецЕсли;

	Иначе

		РезультатФункции.message = НСтр("ru = 'Не определены параметры http запроса'");
		РезультатФункции.error = Истина;

	КонецЕсли;

	Возврат РезультатФункции;

КонецФункции

// Выполнить HTTPЗапрос с метрикой.
// 
// Параметры:
//  ПараметрыHTTPЗапроса - см. КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьСтруктуруПараметровHTTPЗапроса
//  СтруктураДействия - см. КонтурЗакупки_СтруктурыКлиентСервер.ПолучитьОписаниеДействия
//  СтруктураКлиентаДляМетрики - см. КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьСтруктуруКлиентаДляМетрики
//  ЭтоВызовСКлиента - Булево
// 
// Возвращаемое значение:
//  см. КонтурЗакупки_СтруктурыКлиентСервер.ИнициализироватьРезультатФункции
Функция ВыполнитьHTTPЗапросСМетрикой(ПараметрыHTTPЗапроса, СтруктураДействия, СтруктураКлиентаДляМетрики, ЭтоВызовСКлиента) Экспорт
	РезультатФункции = ВыполнитьHTTPЗапрос(ПараметрыHTTPЗапроса);
	Если РезультатФункции["error"] Тогда

		СтрокаОшибки = РезультатФункции["message"];
		СтруктураДляОтправкиОшибки = КонтурЗакупки_МетрикиВызовСервера.ПолучитьСтруктуруОшибки(СтруктураДействия,
			СтрокаОшибки, СтруктураКлиентаДляМетрики, РезультатФункции["traceId"], ЭтоВызовСКлиента);
		КонтурЗакупки_МетрикиВызовСервера.ОтправитьМетрику(СтруктураДляОтправкиОшибки);

	Иначе

		СтруктураСобытия = КонтурЗакупки_МетрикиВызовСервера.ПолучитьСтруктуруСобытия(СтруктураДействия, ,
			СтруктураКлиентаДляМетрики, РезультатФункции["traceId"], ЭтоВызовСКлиента);
		КонтурЗакупки_МетрикиВызовСервера.ОтправитьМетрику(СтруктураСобытия);

	КонецЕсли;
	Возврат РезультатФункции;

КонецФункции

// Разложить URL.
// Раскладывает URL в урезанную структуру ПараметровHTTPЗапроса.
// Использовать можно так:
// ЗаполнитьЗначенияСвойств(СтруктураПараметровHTTPЗапроса, РазложитьURL(URL)) 
// 
// Параметры:
//  URL - Строка - URL
// 
// Возвращаемое значение:
//  Структура - Разложить URL:
// * АдресСервера - Строка - 
// * ПортСервера - Число - 
// * ЗащищенноеСоединение - Булево - 
// * СтрокаПодключения - Строка - 
// * Пользователь - Строка - 
// * Пароль - Строка - 
Функция РазложитьURL(Знач URL) Экспорт

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("АдресСервера", "");
	ПараметрыЗапроса.Вставить("ПортСервера", 80);
	ПараметрыЗапроса.Вставить("ЗащищенноеСоединение", Ложь);
	ПараметрыЗапроса.Вставить("СтрокаПодключения", "");
	ПараметрыЗапроса.Вставить("Пользователь", "");
	ПараметрыЗапроса.Вставить("Пароль", "");

	Схема = ИзвлечьСтрокуПоРазделителю(URL, "://");
	Если Не ПустаяСтрока(Схема) Тогда
		// порт заполним по схеме
		// если указан порт явно, то перезапишем ниже
		Если НРег(Схема) = "http" Тогда
			ПараметрыЗапроса.ПортСервера = 80;
			ПараметрыЗапроса.ЗащищенноеСоединение = Ложь;
			;
		ИначеЕсли НРег(Схема) = "https" Тогда
			ПараметрыЗапроса.ПортСервера = 443;
			ПараметрыЗапроса.ЗащищенноеСоединение = Истина;
		КонецЕсли;
	КонецЕсли;

	АвторизацияСерверПорт = ИзвлечьСтрокуПоРазделителю(URL, "/");

	Авторизация = ИзвлечьСтрокуПоРазделителю(АвторизацияСерверПорт, "@");
	Если Не ПустаяСтрока(Авторизация) Тогда
		Пользователь = ИзвлечьСтрокуПоРазделителю(Авторизация, ":");
		ПараметрыЗапроса.Пользователь = Пользователь;
		ПараметрыЗапроса.Пароль = Авторизация;
	КонецЕсли;

	Порт = ИзвлечьСтрокуПоРазделителю(АвторизацияСерверПорт, ":", Истина);
	Если Не ПустаяСтрока(Порт) Тогда
		Попытка
			ПараметрыЗапроса.ПортСервера = Число(Порт);
		Исключение
			;
		КонецПопытки;
	КонецЕсли;
	ПараметрыЗапроса.АдресСервера = АвторизацияСерверПорт;
	ПараметрыЗапроса.СтрокаПодключения = URL;

	Возврат ПараметрыЗапроса;
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция ИзвлечьСтрокуПоРазделителю(ОстальнаяЧасть, Разделитель, Инверсия = Ложь)
	ИзвлекаемаяЧасть = "";
	Индекс = СтрНайти(ОстальнаяЧасть, Разделитель);
	Если Индекс Тогда
		ИзвлекаемаяЧасть = Лев(ОстальнаяЧасть, Индекс - 1);
		ОстальнаяЧасть = Сред(ОстальнаяЧасть, Индекс + СтрДлина(Разделитель));
		Если Инверсия Тогда
			ДляОбмена = ИзвлекаемаяЧасть;
			ИзвлекаемаяЧасть = ОстальнаяЧасть;
			ОстальнаяЧасть = ДляОбмена;
		КонецЕсли;
	КонецЕсли;
	Возврат ИзвлекаемаяЧасть;
КонецФункции
#КонецОбласти

#КонецЕсли