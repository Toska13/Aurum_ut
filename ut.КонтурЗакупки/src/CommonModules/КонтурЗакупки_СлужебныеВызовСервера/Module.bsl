КонецПроцедуры

// Имя конфигурации 1С.
// 
// Возвращаемое значение:
//  Строка - Имя конфигурации 1С
Функция ИмяКонфигурации1С() Экспорт

	Имя = "БП30";

	Синоним = Метаданные.Синоним;
	Версия = Метаданные.Версия;

	Если Найти(Синоним, "Бухгалтерия предприятия") > 0 И Лев(Версия, 3) = "3.0" Тогда
		Имя = "БП30";
	ИначеЕсли Найти(Синоним, "Бухгалтерия") > 0 И Лев(Версия, 3) = "1.5" Тогда
		Имя = "БП15";
	ИначеЕсли Найти(Синоним, "Комплексная автоматизация") > 0 Тогда
		Имя = "КА";
	ИначеЕсли Найти(Синоним, "Документооборот") > 0 Тогда
		Имя = "ДО";
	ИначеЕсли Найти(Синоним, "Зарплата и управление персоналом") > 0 Тогда
		Имя = "ЗУП";
	ИначеЕсли Найти(Синоним, "Управление производственным предприятием") > 0 Тогда
		Имя = "УПП";
	ИначеЕсли Найти(Синоним, "ERP") > 0 Тогда
		Имя = "ERP";
	ИначеЕсли Найти(Синоним, "Управление торговлей") > 0 Тогда
		Имя = "УТ";
	ИначеЕсли Найти(Синоним, "Управление нашей") > 0 Тогда
		Имя = "УНФ";
	ИначеЕсли Найти(Синоним, "Библиотека стандартных подсистем") > 0 Тогда
		Имя = "БСП";
	КонецЕсли;

	Возврат Имя;

КонецФункции

