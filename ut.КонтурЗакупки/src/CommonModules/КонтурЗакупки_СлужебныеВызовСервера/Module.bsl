// Добавить лог.
// 
// Параметры:
//  ПрефиксПродукта - Строка -  Префикс продукта
//  ТекстОшибки - Строка - Текст ошибки
//  ЗамерВремени - Неопределено - Замер времени
Процедура ДобавитьЛог(ПрефиксПродукта, ТекстОшибки, ЗамерВремени = Неопределено) Экспорт

	Если ЗамерВремени = Неопределено Тогда
		ЗаписьЖурналаРегистрации(ПрефиксПродукта, УровеньЖурналаРегистрации.Информация, , , ТекстОшибки);
	Иначе
		ТекДата = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации(ПрефиксПродукта, УровеньЖурналаРегистрации.Информация, , , СокрЛП(ТекДата
			- ЗамерВремени) + ": " + ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Получить таймаут.
// 
// Параметры:
//  Метод - Строка - Вызываемый метод
//  ЭтоОтправкаФайла - Булево - Это отправка файла
//  ЭтоПолучениеФайла - Булево - Это получение файла
// 
// Возвращаемое значение:
//  Число - Рекомендуемый таймаут
Функция ПолучитьТаймаут(Метод, ЭтоОтправкаФайла, ЭтоПолучениеФайла) Экспорт

	Результат = 30;
	Если ЭтоОтправкаФайла Или ЭтоПолучениеФайла Тогда
		Результат = 120;
	ИначеЕсли Метод = "GET" Тогда
		Результат = 10;
	ИначеЕсли Метод = "POST" Тогда
		Результат = 20;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразовать из JSON.
// 
// Параметры:
//  ТекстJSON - Строка - Текст JSON
// 
// Возвращаемое значение:
//  Произвольный -  Преобразовать из JSON
Функция ПреобразоватьИзJSON(ТекстJSON, ПрочитатьВСоответствие = Истина) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие);

	Возврат Результат;

КонецФункции

// Преобразовать ВJSON.
// 
// Параметры:
//  Значение - Структура, Соответствие из Строка, Неопределено - Значение
// 
// Возвращаемое значение:
//  Строка -  Преобразовать ВJSON
Функция ПреобразоватьВJSON(Значение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Преобразовать base64 в строку.
// 
// Параметры:
//  СтрокаBase64 - Строка - Строка base64
// 
// Возвращаемое значение:
//  Строка -  Преобразовать base64 в строку
Функция ПреобразоватьBase64ВСтроку(СтрокаBase64) Экспорт

	Данные = Base64Значение(СтрокаBase64);

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Данные.Записать(ИмяВременногоФайла);

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяВременногоФайла, "UTF-8");

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ПрефиксПродукта = КонтурЗакупки_ДанныеПродуктаКлиентСерверПовтИсп.ПолучитьПрефиксПродукта();
		ДобавитьЛог(ПрефиксПродукта, ИнформацияОбОшибке());
	КонецПопытки;

	Возврат ТекстовыйДокумент.ПолучитьТекст();

КонецФункции

// Получить дату время из строки.
// 
// Параметры:
//  ДатаВремя - Дата - Дата время
//  ЧасовойПоясСмещения - Неопределено -  Часовой пояс смещения
// 
// Возвращаемое значение:
//  Дата -  Получить дату время из строки
Функция ПолучитьДатуВремяИзСтроки(ДатаВремя, ЧасовойПоясСмещения = Неопределено) Экспорт
	Если Не ДатаВремя = Неопределено Тогда
		Попытка
			ДатаВремяМестное = ПрочитатьДатуJSON(ДатаВремя, ФорматДатыJSON.ISO);
			Если ЗначениеЗаполнено(ДатаВремяМестное) Тогда

				Возврат ДатаВUTC(ДатаВремяМестное) + ?(ЧасовойПоясСмещения = Неопределено, 0,
					СмещениеСтандартногоВремени(
				ЧасовойПоясСмещения));
			Иначе
				Возврат Дата(1, 1, 1);
			КонецЕсли;
		Исключение
			Возврат Дата(1, 1, 1);
		КонецПопытки;
	Иначе
		Возврат Дата(1, 1, 1);
	КонецЕсли;
КонецФункции

// Дата в UTC.
// 
// Параметры:
//  Значение - Дата -  Значение
// 
// Возвращаемое значение:
//  Дата -  Дата в UTC
Функция ДатаВUTC(Значение) Экспорт

	Возврат Значение - СмещениеСтандартногоВремени(ЧасовойПоясСеанса());

КонецФункции

// Получить универсальную дату время строкой.
// 
// Параметры:
//  ДатаВремя - Дата - Дата время
//  ЧасовойПоясСмещения - Неопределено -  Часовой пояс смещения
// 
// Возвращаемое значение:
//  Строка -  Получить универсальную дату время строкой
Функция ПолучитьУниверсальнуюДатуВремяСтрокой(ДатаВремя, ЧасовойПоясСмещения = Неопределено) Экспорт

	ДатаВремяПояса = ДатаВремя - ?(ЧасовойПоясСмещения = Неопределено, 0, СмещениеСтандартногоВремени(
			ЧасовойПоясСмещения));

	ТекстДаты = ЗаписатьДатуJSON(ДатаВремяПояса, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);

	Возврат ТекстДаты;

КонецФункции

// Сообщить пользователю.
// 
// Параметры:
//  ТекстСообщения - Строка - Текст сообщения
Процедура СообщитьПользователю(ТекстСообщения) Экспорт
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
