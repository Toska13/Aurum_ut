// Текущий режим совместимости 8.2 (например УПП запускается на платформе 8.3, а режим 8.2).
// 
// Возвращаемое значение:
//  Булево - Подсистема это расширение
Функция РежимСовместимости82() Экспорт
	Это82 = Ложь;
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_13
		Или Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_16 Тогда
		Это82 = Истина;
	КонецЕсли;
	Возврат Это82;
КонецФункции

// Установленная подсистема это расширение.
// 
// Параметры:
//  КлючРасширения - Строка - Ключ расширения
// 
// Возвращаемое значение:
//  Булево - Подсистема это расширение
Функция ПодсистемаЭтоРасширение(КлючРасширения) Экспорт
	ЭтоРасширение = Ложь;
	Если ЕстьПодсистема(КлючРасширения) Тогда
		ЭтоРасширение = Не Метаданные.Подсистемы[КлючРасширения].РасширениеКонфигурации() = Неопределено;
	КонецЕсли;
	Возврат ЭтоРасширение;
КонецФункции

// Есть подсистема.
// 
// Параметры:
//  КлючРасширения - Строка - Ключ расширения
// 
// Возвращаемое значение:
//  Булево - Есть подсистема
Функция ЕстьПодсистема(КлючРасширения) Экспорт
	Возврат Не Метаданные.Подсистемы.Найти(КлючРасширения) = Неопределено;
КонецФункции


