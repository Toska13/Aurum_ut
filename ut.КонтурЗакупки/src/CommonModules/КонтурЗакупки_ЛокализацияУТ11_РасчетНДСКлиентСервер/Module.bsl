// @strict-types
#Область ПрограммныйИнтерфейс

// Получить сумму НДС.
// 
// Параметры:
//  Сумма - Число - Сумма
//  СтавкаНДС - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - Ставка НДС
//  СуммаВключаетНДС - Булево - Сумма включает НДС
// 
// Возвращаемое значение:
//  Число - Сумма НДС
Функция ПолучитьСуммуНДС(Сумма, СтавкаНДС, СуммаВключаетНДС) Экспорт
	СуммаНДС	 = 0;

	Если ЗначениеЗаполнено(СтавкаНДС) Тогда
		СтавкаНДСЧислом = ПолучитьСтавкуНДСЧислом(СтавкаНДС);

		Процент = 100 + ?(СуммаВключаетНДС, СтавкаНДСЧислом, 0);
		СуммаНДС = Окр(Сумма * (СтавкаНДСЧислом / Процент), 2);
	КонецЕсли;

	Возврат СуммаНДС;
КонецФункции

// Получить сумму с НДС.
// 
// Параметры:
//  СуммаБезНДС - Число - Сумма без НДС
//  СтавкаНДС  - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - Ставка НДС
// 
// Возвращаемое значение:
//  Число -  Сумма с НДС
Функция ПолучитьСуммуСНДС(СуммаБезНДС, СтавкаНДС) Экспорт
	СуммаСНДС = СуммаБезНДС + ПолучитьСуммуНДС(СуммаБезНДС, СтавкаНДС, Ложь);
	Возврат СуммаСНДС;
КонецФункции

// Получить сумму без НДС.
// 
// Параметры:
//  СуммаСНДС - Число - Сумма с НДС
//  СтавкаНДС  - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - Ставка НДС
// 
// Возвращаемое значение:
//  Число -  Сумма без НДС
Функция ПолучитьСуммуБезНДС(СуммаСНДС, СтавкаНДС) Экспорт
	СуммаБезНДС = СуммаСНДС - ПолучитьСуммуНДС(СуммаСНДС, СтавкаНДС, Истина);
	Возврат СуммаБезНДС;
КонецФункции
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получить ставку НДС числом.
// 
// Параметры:
//  СтавкаНДС - ПеречислениеСсылка.КонтурЗакупки_СтавкиНДС - Ставка НДС
// 
// Возвращаемое значение:
//  Число - Ставка НДС числом
Функция ПолучитьСтавкуНДСЧислом(СтавкаНДС)
	СтавкаНДСЧислом = 0;
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда
		Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.КонтурЗакупки_СтавкиНДС.НДС10") Тогда
			СтавкаНДСЧислом = 10;
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.КонтурЗакупки_СтавкиНДС.НДС20") Тогда
			СтавкаНДСЧислом = 20;
		КонецЕсли;
	КонецЕсли;

	Возврат СтавкаНДСЧислом;
КонецФункции

// Код процедур и функций

#КонецОбласти