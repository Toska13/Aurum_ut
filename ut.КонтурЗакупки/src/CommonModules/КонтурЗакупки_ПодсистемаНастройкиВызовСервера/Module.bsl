#Область ПрограммныйИнтерфейс

// Получить значение настройки.
// 
// Параметры:
//  ПрефиксПродукта - Строка -  Префикс продукта
//  ИмяНастройки - Строка - Имя настройки
//  ЗначениеПоУмолчанию - Неопределено - Значение по умолчанию
// 
// Возвращаемое значение:
//  Строка, Число, Булево - Получить значение настройки
Функция ПолучитьЗначениеНастройки(ПрефиксПродукта = "КонтурПодсистема", ИмяНастройки, ЗначениеПоУмолчанию) Экспорт

	Результат = ЗначениеПоУмолчанию;

	НазваниеНастройки = ПрефиксПродукта + "_" + ИмяНастройки;

	ИмяХранилища = ПолучитьИмяХранилищаНастроек();

	УстановитьПривилегированныйРежим(Истина);

	Набор = РегистрыСведений[ИмяХранилища].СоздатьНаборЗаписей();
	Набор.Отбор.Владелец.Установить(НазваниеНастройки);
	Набор.Прочитать();

	Если Набор.Количество() > 0 Тогда
		ЗначениеНабора = Набор[0].Данные.Получить();
//		Если ТипЗнч(ЗначениеНабора) = Тип("Структура") Тогда
//			Результат = ЗначениеНабора;
//		Иначе
		Результат = ЗначениеНабора;
//		КонецЕсли;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Установить значение настройки.
// 
// Параметры:
//  ПрефиксПродукта - Строка -  Префикс продукта
//  ИмяНастройки - Строка - Имя настройки
//  ЗначениеНастройки - Строка, Число, Булево - Значение настройки
Процедура УстановитьЗначениеНастройки(ПрефиксПродукта = "КонтурПодсистема", ИмяНастройки, ЗначениеНастройки) Экспорт

	НазваниеНастройки = ПрефиксПродукта + "_" + ИмяНастройки;

	ИмяХранилища = ПолучитьИмяХранилищаНастроек();

	УстановитьПривилегированныйРежим(Истина);

	Набор = РегистрыСведений[ИмяХранилища].СоздатьНаборЗаписей();
	Набор.Отбор.Владелец.Установить(НазваниеНастройки);

	НовСтрока = набор.Добавить();
	НовСтрока.Владелец = НазваниеНастройки;
	НовСтрока.Данные = Новый ХранилищеЗначения(ЗначениеНастройки);

	Набор.Записать();

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция ПолучитьИмяХранилищаНастроек()
	Если Не Метаданные.РегистрыСведений.Найти("ХранилищеДанных") = Неопределено Тогда
		ИмяХранилища = "ХранилищеДанных";
	ИначеЕсли Не Метаданные.РегистрыСведений.Найти("БезопасноеХранилищеДанных") = Неопределено Тогда
		ИмяХранилища = "БезопасноеХранилищеДанных";
	ИначеЕсли Не Метаданные.РегистрыСведений.Найти("КонтурЗакупки_ХранилищеДанных") = Неопределено Тогда
		ИмяХранилища = "КонтурЗакупки_ХранилищеДанных";
	КонецЕсли;
	Возврат ИмяХранилища
КонецФункции
#КонецОбласти