	Результат=ВыполнитьHTTPЗапросКШине("sendTicket",ш_РаботаСшинойДанныхСервер.ЗаписатьОбъектВJSON(Новый Структура("id",МассивИД)));
	
	Если Результат.КодСостояния=200 Тогда
		
		Ответ.Результат=Истина;
		Возврат Ответ;
		
	Иначе
		ш_РаботаСшинойДанныхСервер.ЗаписатьОшибкуВЛог("getData","",Результат.КодСостояния,Результат.ПолучитьТелоКакСтроку());
		Возврат ш_РаботаСшинойДанныхСервер.СформироватьОшибкуДляВозврата(Ответ,Результат.КодСостояния,Результат.ПолучитьТелоКакСтроку());
	КонецЕсли;
	
КонецФункции

