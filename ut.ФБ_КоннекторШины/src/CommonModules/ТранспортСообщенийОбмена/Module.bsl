
&Вместо("ВсеТипыТранспорта")
Функция ш_ВсеТипыТранспорта()
	
	Результат = ПродолжитьВызов();
	
	Результат.Добавить(Обработки.ш_ТранспортСообщенийОбменаШина);
	
	Возврат Результат;
	
КонецФункции

&Вместо("ДоступныеТипыТранспорта")
Функция ш_ДоступныеТипыТранспорта(Корреспондент, Знач ВариантНастройки)
	
	Результат = ПродолжитьВызов(Корреспондент, ВариантНастройки);
	
	Если Результат.Найти(Обработки.ш_ТранспортСообщенийОбменаШина) = Неопределено Тогда
		Результат.Добавить(Обработки.ш_ТранспортСообщенийОбменаШина);
	КонецЕсли;
	
	Возврат Результат;
	
	
КонецФункции
