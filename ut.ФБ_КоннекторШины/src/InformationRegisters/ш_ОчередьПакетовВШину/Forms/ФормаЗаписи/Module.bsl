	ОткрытьФорму("ОбщаяФорма.ш_ФормаОтображенияДвоичныхДанных", ПараметрыОткрытия, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
