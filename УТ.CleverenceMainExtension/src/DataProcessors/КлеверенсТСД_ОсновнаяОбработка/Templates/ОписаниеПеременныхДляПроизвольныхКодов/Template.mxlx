						</v8:item>
						<v8:item>
							<v8:lang>ka</v8:lang>
							<v8:content>სტრუქტურა</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Yapı</v8:content>
						</v8:item>
						<v8:item>
