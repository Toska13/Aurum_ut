			</c>
			<c>
				<c>
					<f>13</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДанныеДокумента</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Document data</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>kk</v8:lang>
							<v8:content>Документ деректері</v8:content>
						</v8:item>
						<v8:item>
