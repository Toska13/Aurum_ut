			<c>
				<c>
					<f>15</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Ссылка на выгружаемый (исходный) документ 1С).</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Link to the exported (source) 1C document).</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>kk</v8:lang>
							<v8:content>1С деректерінің шығарылатын (бастапқы) документіне сілтеме).</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>uz</v8:lang>
							<v8:content>1C dan yuklanadigan (bosh) hujjat havolasi.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>be</v8:lang>
							<v8:content>Спасылка на выгружаны (крыніцны) дакумент 1С).</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>uk</v8:lang>
							<v8:content>Посилання на вивантажуваний (вихідний) документ 1С).</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ka</v8:lang>
							<v8:content>ბმული გამოსახულებულ 1C დოკუმენტზე).</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>1C'den dışa aktarılan (kaynak) belgeye bir bağlantı sağlar).</v8:content>
