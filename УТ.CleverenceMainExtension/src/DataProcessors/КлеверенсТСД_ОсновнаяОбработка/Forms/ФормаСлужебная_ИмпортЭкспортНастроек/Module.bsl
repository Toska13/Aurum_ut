	Настройка.Родитель		= МетаданныеСписокНастроек.НастройкиОтборовУзлов_Онлайн_Общий;
	МетаданныеСписокНастроек.Вставить(Настройка.Имя, Настройка);
	// -- Группа Отборы онлайн торговых объектов
	
	// } Отборы онлайн
	
	
	// Отборы интерактивные {
	
	// Группа Отборы интерактивные
	Настройка = ПолучитьСтруктуруМетаданныхНастроек();
	Настройка.Имя				= "НастройкиОтборовУзлов_Интерактивный_Общий";
	Настройка.Синоним		= "Интерактивные";
