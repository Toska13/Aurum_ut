
// Все изменения сделаннные в формах основной обработки ФормаСлужебная_ИмпортЭкспортНастроек и ФормаСлужебная_МножественныйВыборИзСписка
// 	должны быть перенесены и во внешнюю обработку КлеверенсТСД_ИмпортЭкспортНастроек. 
// 	Внешняя обработка хранится по пути \core\Служебные обработки\КлеверенсТСД_ИмпортЭкспортНастроек
// Эти формы должны быть совместимы, если используются в виде внешней обработки.
// Внешняя обработка была сделана для совместимости с ОО 1.6.0. Неизвесто начиная с какой верссии импорт/экспорт работает корректно.

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ЗапускИзОсновнойОбработки Экспорт;

&НаКлиенте
Перем КатегорииНастроекMS;

&НаКлиенте
Функция ВерсияВнешнейОбработки()
	Возврат "0.19, 23.08.2024";
КонецФункции 

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		РеквизитОбъект 			= РеквизитФормыВЗначение("Объект");
		ПолноеИмяОбъекта 		= РеквизитОбъект.Метаданные().ПолноеИмя();
		//ИспользуемоеИмяФайла 	= ?(ЛокЯдро_ЭтоВнешняяОбработка(), РеквизитОбъект.ИспользуемоеИмяФайла, "");
		//ИмяОбъекта 				= РеквизитОбъект.Метаданные().Имя;
	#КонецЕсли	
	
	// Добавляем колонки в таблицы, которые не отображаются на форме. Программное добавление сделано для совместимости с ОФ
	ДобавляемыеРеквизиты = Новый Массив;
	
	// ТаблицаБизнесПроцессов
	ИмяТаблицы = "ТаблицаБизнесПроцессов";
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ID_БизнесПроцесса",		Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Название",				Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НомерСтроки",			Новый ОписаниеТипов("Число"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Картинка",				Новый ОписаниеТипов("Картинка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Синоним",				Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	
	// ТаблицаУзлов
	ИмяТаблицы = "ТаблицаУзлов";
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Наименование",			Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ID_Узла",					Новый ОписаниеТипов("Строка"), 	ИмяТаблицы));
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Для каждого НовыйРеквизит Из ДобавляемыеРеквизиты Цикл
			ИмяТаблицы = НовыйРеквизит.Путь;
			Таблица = ЭтаФорма[ИмяТаблицы];
			Таблица.Колонки.Добавить(НовыйРеквизит.Имя, НовыйРеквизит.ТипЗначения);	
		КонецЦикла;
	#Иначе
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		ПриСозданииНаСервере(Неопределено, Неопределено);
		ДеревоНастроек.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
	#КонецЕсли
	
	РежимОбмена = ?(РежимОбмена = "" ИЛИ РежимОбмена = "0", "Импорт", РежимОбмена);
	
	Если ЗапускИзОсновнойОбработки = Истина Тогда
		Заголовок = "Клеверенс: " + РежимОбмена + " настроек";
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			//Элементы.ДеревоНастроекДополнительнаяКоманднаяПанель.Кнопки.Еще.Кнопки.ДеревоНастроекВерсияВнешнейОбработки.Видимость = Ложь;
			Элементы.РежимОбменаИмпорт.Видимость = Ложь;
			Элементы.РежимОбменаЭкспорт.Видимость = Ложь;
		#Иначе
			Элементы.ДеревоНастроекВерсияВнешнейОбработки.Видимость = Ложь;
			Элементы.РежимОбмена.Видимость = Ложь;
		#КонецЕсли
		
	Иначе
		Заголовок = "Клеверенс: Импорт/экспорт настроек";
		ЗапускИзОсновнойОбработки = Ложь;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ДеревоНастроекДополнительнаяКоманднаяПанель.Кнопки.Еще.Кнопки.ДеревоНастроекВерсияВнешнейОбработки.Текст = "Версия обработки: " + ВерсияВнешнейОбработки();
		#Иначе
			Элементы.ДеревоНастроекВерсияВнешнейОбработки.Заголовок = "Версия обработки: " + ВерсияВнешнейОбработки();
		#КонецЕсли
		
		#Область СовместимыйКодFresh
		//Возврат;
		#КонецОбласти //СовместимыйКодFresh
		
		ГлавнаяФорма = ПроверитьДоступностьОсновнойОбработки();
		Если ГлавнаяФорма = Ложь Тогда
			Возврат;
		КонецЕсли;
		
		// +++ TODO:
		// Костыльный вариант сделан для совместимости со старыми вресиями ОО
		РезультатВыбора = Новый Структура("Данные", Новый Структура("Ид"));
		ДопПараметры = Новый Структура("ПроцедураКВыполнениюПослеВыбора, ОбъектыНазначения, ЛокКонтекст", "ДопПараметры.ЛокКонтекст = _ЛокКонтекст //");
		ГлавнаяФорма.ОповещениеОткрытьОкноВыбораДокументаСмартсЗавершение(РезультатВыбора, ДопПараметры);
		_ЛокКонтекст = ДопПараметры.ЛокКонтекст;
		// ---
		
	КонецЕсли;
	
	ПереключитьОтображениеСлужебныхПолей(Неопределено);
	ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
	ИнициализацияСПроверкойПодключения(, Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимОбменаПриИзменении(Элемент)
	ИнициализацияСПроверкойПодключения();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ДеревоНастроекПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекущаяКолонка = Элементы.ДеревоНастроек.ТекущаяКолонка.Имя;
	#Иначе
		ТекущаяКолонка = Элементы.ДеревоНастроек.ТекущийЭлемент.Имя;
	#КонецЕсли
	
	Если ТекущаяКолонка = "ДеревоНастроекИспользовать" Тогда
		
		ТекущиеДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
		Если НЕ ТекущиеДанные.Доступность Тогда
			Сообщить("Данная настройка недоступна");
			ТекущиеДанные.Использовать = Ложь;
			Возврат;
		КонецЕсли;
		
		УстанавливатьИзменениеДетальныхЗаписей = НЕ (ТекущиеДанные.ТипСтроки = "Группа" ИЛИ ТекущиеДанные.ТипСтроки = "Файл");
		
		Если НЕ УстанавливатьИзменениеДетальныхЗаписей Тогда
			УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ТекущиеДанные), "Использовать", ТекущиеДанные.Использовать);
			ТекущиеДанные.ИзменениеДетальныхЗаписей = Ложь;
		КонецЕсли;
		
		СвязанныеЭлементыВыбраны = ВыбратьСвязанныеЭлементыНастроек(ТекущиеДанные);
		
		Если СвязанныеЭлементыВыбраны Тогда
			РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек));
		Иначе
			ПервыйРодитель = ПолучитьПервогоРодителяСтроки(ТекущиеДанные);
			Если ПервыйРодитель <> ТекущиеДанные Тогда
				РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ПолучитьЭлементыСтроки(ПервыйРодитель));
				ПервыйРодитель.Использовать = РежимИспользования > 0;
				ПервыйРодитель.ИзменениеДетальныхЗаписей = РежимИспользования = 2 
					И НЕ ПервыйРодитель.ТипСтроки = "Группа"
					И РежимОбмена = "Импорт";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерезапуститьОбработку(Команда)
	Если ОбработкаИнициализирована Тогда
		ИнициализацияСПроверкойПодключения();
	Иначе
		ПриОткрытии(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	ОчиститьСообщения();
	ТаблицаОшибок.Очистить();
	Если НЕ ПроверитьДоступностьОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимОбмена = "Импорт" Тогда
		СохранитьНастройкиВБазуSMARTS();
	ИначеЕсли РежимОбмена = "Экспорт" Тогда
		СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
		Если ЗапускИзОсновнойОбработки = Истина Тогда
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастроек, "ИмпортЭкспортНастроек", Истина);
		Иначе
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастроек, "ИмпортЭкспортНастроек");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина);
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "ИзменениеДетальныхЗаписей", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Ложь);
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "ИзменениеДетальныхЗаписей", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоУзлу(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		СписокВыбора.Добавить(СтрокаУзла.ID_Узла, СтрокаУзла.Наименование);
	КонецЦикла;
	
	ПараметрыВыбора  = Новый Структура();
	ПараметрыВыбора.Вставить("ПолеСравнения", "ID_Узла");
	ПараметрыВыбора.Вставить("КоличествоСтрок", СписокВыбора.Количество());
	ПараметрыВыбора.Вставить("ВыборПо", "Узлы");
	
	ОП = Новый ОписаниеОповещения("ВыборПоОтборуЗавершение", ЭтаФорма, ПараметрыВыбора);
	ОткрытьФормуМножественногоВыбора("Клеверенс: Выберете торговые объекты", "<Описание>", СписокВыбора, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоБП(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	Для каждого СтрокаУзла Из ТаблицаБизнесПроцессов Цикл
		СписокВыбора.Добавить(СтрокаУзла.ID_БизнесПроцесса, СтрокаУзла.Синоним);
	КонецЦикла;
	
	ПараметрыВыбора  = Новый Структура();
	ПараметрыВыбора.Вставить("ПолеСравнения", "Ид");
	ПараметрыВыбора.Вставить("КоличествоСтрок", СписокВыбора.Количество());
	ПараметрыВыбора.Вставить("ВыборПо", "БизнесПроцессы");
	
	ОП = Новый ОписаниеОповещения("ВыборПоОтборуЗавершение", ЭтаФорма, ПараметрыВыбора);
	ОткрытьФормуМножественногоВыбора("Клеверенс: Выберете бизнес-процессы", "<Описание>", СписокВыбора, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьОтображениеСлужебныхПолей(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		лЭлементы = Элементы.ДеревоНастроек.Колонки;
	#Иначе
		лЭлементы = Элементы;
	#КонецЕсли
	
	Видимость = НЕ лЭлементы.ДеревоНастроекИмя.Видимость;
	
	лЭлементы.ДеревоНастроекИмя.Видимость = Видимость;
	лЭлементы.ДеревоНастроекТипСтроки.Видимость = Видимость;
	лЭлементы.ДеревоНастроекИзменениеДетальныхЗаписей.Видимость = Видимость;
	лЭлементы.ДеревоНастроекЭтоРодитель.Видимость = Видимость;
	лЭлементы.ДеревоНастроекДоступность.Видимость = Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьНастройки(Команда)
	
	Если ОбработкаИнициализирована Тогда
		Если РежимОбмена = "Импорт" Тогда
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучитьНастройкиИзФайлаЗавершение", ЭтаФорма);
			Если ЗапускИзОсновнойОбработки = Истина Тогда
				_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("ИмпортЭкспортНастроек", ОповещениеОЗавершении, Истина);
			Иначе
				_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("ИмпортЭкспортНастроек", ОповещениеОЗавершении);
			КонецЕсли;
		Иначе
			ИнициализацияСПроверкойПодключения();
		КонецЕсли;
	Иначе
		ПриОткрытии(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОшибки(Команда)
	ТаблицаОшибок.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображение(КритическаяОшибка = "")
	
	ЭтоИмпорт = РежимОбмена = "Импорт";
	
	Если КритическаяОшибка  = "НетГлавнойФормы" И НЕ ЗапускИзОсновнойОбработки Тогда
		
		Элементы.ОшибкаИнициализации.Заголовок = 
			"Не удалось найти главную форму основной обработки Клеверенс! 
			|Для импорта/экспорта настроек необходимо открыть основную обработку.";
		ОбработкаИнициализирована = Ложь;
		
	ИначеЕсли КритическаяОшибка = "НетПодключенияSMARTS" Тогда
		
		Элементы.ОшибкаИнициализации.Заголовок = 
			"Ошибка подключения к базе MobileSmarts";
		ОбработкаИнициализирована = Ложь;
		
	ИначеЕсли ОбработкаИнициализирована Тогда
		Элементы.ВыполнитьОбмен.КнопкаПоУмолчанию = Истина;
		Элементы.ВыполнитьОбмен.Заголовок = ТРег(РежимОбмена);
	КонецЕсли;
	
	Элементы.ПерезапуститьОбработку.КнопкаПоУмолчанию = НЕ ОбработкаИнициализирована;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ОбработкаИнициализирована Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.Страницы.ГруппаТелоФормы
		Иначе
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.Страницы.ГруппаОшибкаИнициализации
		КонецЕсли;
		Элементы.ДеревоНастроек.Колонки.ДеревоНастроекИспользовать.Доступность = ЭтоИмпорт;
		
		Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ВыбратьВсе.Доступность = ЭтоИмпорт;
		Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.СнятьВсе.Доступность = ЭтоИмпорт;
		Для каждого КнопкаВыбора Из Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ГруппаДеревоНастроекВыбор.Кнопки Цикл
			КнопкаВыбора.Доступность = ЭтоИмпорт;
		КонецЦикла;
		
	#Иначе
		Если ОбработкаИнициализирована Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаТелоФормы;
		Иначе
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОшибкаИнициализации;
		КонецЕсли;
		Элементы.ДеревоНастроекИспользовать.Доступность = ЭтоИмпорт;
		
		Элементы.ВыбратьВсе.Доступность = ЭтоИмпорт;
		Элементы.СнятьВсе.Доступность = ЭтоИмпорт;
		Элементы.ГруппаДеревоНастроекВыбор.Доступность = ЭтоИмпорт;
		
	#КонецЕсли
	
	Элементы.ВерсияНастроек.Видимость = НЕ ПустаяСтрока(ВерсияНастроек);
	Элементы.ВерсияНастроекЗаголовок.Видимость = Элементы.ВерсияНастроек.Видимость;
	
	Если ЭтоИмпорт Тогда
		Элементы.ПеречитатьНастройки.Заголовок = "Получить настройки из файла";
		Элементы.ПеречитатьНастройки.Картинка = БиблиотекаКартинок.ОткрытьФайл;
	Иначе
		Элементы.ПеречитатьНастройки.Заголовок = "Перечитать настройки";
		Элементы.ПеречитатьНастройки.Картинка = БиблиотекаКартинок.Обновить;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Функция ПредставлениеВерсииНастроек(ДанныеНастроек)
	Возврат Строка(ДанныеНастроек.ВерсияОбработкиНастроек) + " (" + ДанныеНастроек.ДатаНастроек + ")";
КонецФункции 

&НаКлиенте
Функция ПроверитьДоступностьОбмена()
	
	Доступно = Истина;
	
	Если ПроверитьДоступностьОсновнойОбработки() = Ложь Тогда
		Возврат Ложь;		
	КонецЕсли;
	
	Если АдресДанныхНастроек = "" Тогда
		Сообщить("Пустая таблица настроек.");
		Доступно = Ложь;
	КонецЕсли;
	
	Если АдресДанныхНастроек <> "" И РежимОбмена = "Импорт" Тогда
		
		ЕстьОтмеченныеЭлементы = НайтиПервоеЗначениеДереваРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина);
		Если ЕстьОтмеченныеЭлементы = Неопределено Тогда
			Сообщить("Нет отмеченных настроек для импорта.");
			Доступно = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Доступно;
	
КонецФункции 

&НаКлиенте
Процедура ВыборПоОтборуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ЭлементыДерева = ПолучитьЭлементыСтроки(ДеревоНастроек);
		
		Если ДополнительныеПараметры.ВыборПо = "БизнесПроцессы"
			И ДополнительныеПараметры.КоличествоСтрок = Результат.Количество() Тогда
			
			Для каждого Строка Из ЭлементыДерева Цикл
				Если Строка.Имя = "НастройкиБП_Общий"
					ИЛИ Строка.Имя = "НастройкиОтборов"
					ИЛИ Строка.Имя = "ГлобальныеПараметры_Общий"
					ИЛИ Строка.Имя = "ПроизвольныеКоды" Тогда
					УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(Строка), "Использовать", Истина);					
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			Для каждого Идентификатор Из Результат Цикл
				УстановитьЗначениеВДеревоПоУсловию(ЭлементыДерева, "Использовать", Истина, ДополнительныеПараметры.ПолеСравнения, "Равно", Идентификатор, Истина);	
			КонецЦикла;
		КонецЕсли;
		
		РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ЭлементыДерева);
		
	КонецЕсли;
	
КонецПроцедуры 

#Область ИнициализацияНастроек

&НаКлиенте
Функция ПроверитьДоступностьОсновнойОбработки()
	
	Если ЗапускИзОсновнойОбработки Тогда
		Возврат Истина;
	КонецЕсли;
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		ГлавнаяФорма = Неопределено;
		Попытка
			ГлавнаяФорма = ПолучитьФорму("ВнешняяОбработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ОФ_ГлавнаяФорма");
		Исключение
		КонецПопытки;
		
		Если ГлавнаяФорма = Неопределено Тогда
			Попытка
				ГлавнаяФорма = ПолучитьФорму("Обработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ОФ_ГлавнаяФорма");
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	#Иначе
		
		ЗаголовокПоиска = НСтр("be = 'Cleverence'; en = 'Cleverence'; es = 'Cleverence'; ka = 'Cleverence'; kk = 'Cleverence'; ro = 'Cleverence'; ru = 'Клеверенс'; tr = 'Cleverence'; uk = 'Cleverence'; uz = 'Cleverence'");
		АктивныеОкна = ПолучитьОкна();
		ГлавнаяФорма = Неопределено;
		
		Для каждого ТекОкно Из АктивныеОкна Цикл
			Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ТекОкно.Заголовок, ЗаголовокПоиска) И ТекОкно.Содержимое.Количество() Тогда
				ДанныеФормы = ТекОкно.Содержимое[0];
				Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ДанныеФормы.ИмяФормы, "ГлавнаяФорма") Тогда
					ГлавнаяФорма = ДанныеФормы;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	#КонецЕсли

	Если ГлавнаяФорма = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ГлавнаяФорма.ID_ТекущейБазы) Тогда
		ОбновитьОтображение("НетГлавнойФормы");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ГлавнаяФорма;
	
КонецФункции 

&НаКлиенте
Процедура ИнициализацияСПроверкойПодключения(ДанныеНастроек = Неопределено, ПроверитьДоступностьОО = Истина)
	
	Если ПроверитьДоступностьОО И ПроверитьДоступностьОсновнойОбработки() = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ДанныеНастроек", ДанныеНастроек);
	ОП = Новый ОписаниеОповещения("ИнициализацияПослеПодключения",ЭтаФорма, ДопПараметры);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,?(ЕстьЧастнаяБаза,"Частная","Основная"),,,,ОП);
	
КонецПроцедуры 

&НаКлиенте
Процедура ИнициализацияПослеПодключения(СерверДоступен, ДополнительныеПараметры) Экспорт
	
	ЕстьУзлы = Ложь;
	ОбработкаИнициализирована = Ложь;
	АдресДанныхНастроек = "";
	ВерсияНастроек = "";
	
	ТаблицаБизнесПроцессов.Очистить();
	ТаблицаУзлов.Очистить();
	ПолучитьЭлементыСтроки(ДеревоНастроек).Очистить();
	
	Если НЕ СерверДоступен Тогда
		ОбновитьОтображение("НетПодключенияSMARTS");
		Возврат;
	КонецЕсли;
	
	КатегорииНастроекMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS");
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = _ЛокКонтекст.ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	АдресаПеременных = _ЛокКонтекст.АдресаПеременных;
	МетаданныеНастроек = МетаданныеНастроек();
	Если РежимОбмена = "Импорт"
		И ДополнительныеПараметры.ДанныеНастроек <> Неопределено Тогда
		
		ЗаполнитьТаблицуНастроекНаКлиенте(ДополнительныеПараметры.ДанныеНастроек, МетаданныеНастроек);
		
	ИначеЕсли РежимОбмена = "Экспорт" Тогда
		ЗаполнитьТаблицуНастроекНаКлиенте(ПолучитьНастройкиИзSMARTS(), МетаданныеНастроек);
		ВыбратьВсе(Неопределено);
	КонецЕсли;
	
	ОбработкаИнициализирована = Истина;
	ОбновитьОтображение();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНастройкиИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализацияСПроверкойПодключения(СтруктураНастроек);
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьНастройкиИзSMARTS(ПолучитьВсе = Истина, ОтборНастроек = Неопределено)
	
	Если ОтборНастроек = Неопределено Тогда
		ОтборНастроек = Новый Структура;
	КонецЕсли;
	
	//ВерсияНастроек
	//ВерсияОбработкиНастроек
	//ГлобальныеПараметры_Значения
	//ГлобальныеПараметры_Значения_Узлы
	//ГлобальныеПараметры_Пользовательские
	//ГруппыПользователей
	//НастройкиБизнесПроцессов_Пользовательские
	//НастройкиБизнесПроцессов_ПользовательскиеНастройки
	//НастройкиБизнесПроцессов_ПользовательскиеНастройки_Узлы
	//НастройкиБизнесПроцессов_ПоУмолчанию
	//НастройкиОбменаСправочников
	//НастройкиОбменаСправочников_Узлы
	//НастройкиОбменаСправочников_Шапка
	//НастройкиОтборовУзлов_Автообмен
	//НастройкиОтборовУзлов_Автообмен_Узлы
	//НастройкиОтборовУзлов_Интерактивный
	//НастройкиОтборовУзлов_Интерактивный_Узлы
	//НастройкиОтборовУзлов_Онлайн
	//НастройкиОтборовУзлов_Онлайн_Узлы
	//Пользователи
	//ПользователиТСД_Узлы
	//ПроизвольныеКоды_Пользовательские
	//ПроизвольныеКоды_ПоУмолчанию
	//ПроизвольныеОтборыДокументов
	//Узлы
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ДатаНастроек", ТекущаяДата());
	СтруктураНастроек.Вставить("ВерсияОбработкиОбменаНастроек", ВерсияВнешнейОбработки());
	
	ЗначенияНастроек = Новый Структура;
	
	НастройкиКПолучению = Новый Структура;
	НастройкиКПолучению.Вставить("ВерсияОбработкиНастроек");
	НастройкиКПолучению.Вставить("Узлы");
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
	Для каждого НастройкаMS Из НастройкиКПолучению Цикл
		ЗначенияНастроек.Вставить(НастройкаMS.Ключ, НастройкаMS.Значение);
	КонецЦикла;
	
	// Узлы обработка значений
	ЗначенияНастроек.Вставить("ЕстьУзлы", Ложь);
	Узлы = ЗначенияНастроек.Узлы;
	МассивИдУзлов = Новый Массив;
	Если НЕ Узлы = Ложь И ТипЗнч(Узлы) = Тип("Массив")  Тогда
		Для Каждого СтрокаУзла Из Узлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			МассивИдУзлов.Добавить(СтрокаУзла.ID_Узла);
			ЗначенияНастроек.ЕстьУзлы = Истина;
		КонецЦикла;
	КонецЕсли;
	ЗначенияНастроек.Вставить("ИдУзлов", МассивИдУзлов);
	
	// Бизнес-процессы
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ОбщаяСтруктураБизнесПроцессов") ИЛИ ОтборНастроек.Свойство("НастройкиОтборов") Тогда
		ЗначенияНБП = ПолучитьСтруктуруНастроекБизнесПроцессов();
		Для каждого КлючЗначение Из ЗначенияНБП Цикл
			ЗначенияНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки_Узлы", 	ПолучитьНастройкиПоУзламSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", МассивИдУзлов));
	КонецЕсли;
	
	НастройкиКПолучению = Новый Структура;
	
	// Глобальные параметры
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ГлобальныеПараметры_Значения") Тогда
		НастройкиКПолучению.Вставить("ГлобальныеПараметры_ПоУмолчанию");
		НастройкиКПолучению.Вставить("ГлобальныеПараметры_Пользовательские");
		НастройкиКПолучению.Вставить("ГлобальныеПараметры_Значения");
	КонецЕсли;
	
	// Обмен справочников
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОбменаСправочников") Тогда
		НастройкиКПолучению.Вставить("НастройкиОбменаСправочников");
		ЗначенияНастроек.Вставить("НастройкиОбменаСправочников_Узлы", 				ПолучитьНастройкиПоУзламSMARTS("НастройкиОбменаСправочников", МассивИдУзлов));
	КонецЕсли;
	
	// Настройки отборов	
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборовУзлов_Автообмен") Тогда
		НастройкиКПолучению.Вставить("НастройкиОтборовУзлов_Автообмен");
	КонецЕсли;
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборовУзлов_Интерактивный") Тогда
		НастройкиКПолучению.Вставить("НастройкиОтборовУзлов_Интерактивный");
	КонецЕсли;
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборовУзлов_Онлайн") Тогда
		НастройкиКПолучению.Вставить("НастройкиОтборовУзлов_Онлайн");
	КонецЕсли;
	
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборовУзлов_Онлайн_Узлы") Тогда
		ЗначенияНастроек.Вставить("НастройкиОтборовУзлов_Онлайн_Узлы", 				ПолучитьНастройкиПоУзламSMARTS("НастройкиОтборовУзлов_Онлайн", МассивИдУзлов));
	КонецЕсли;
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборовУзлов_Интерактивный_Узлы") Тогда
		ЗначенияНастроек.Вставить("НастройкиОтборовУзлов_Интерактивный_Узлы",		ПолучитьНастройкиПоУзламSMARTS("НастройкиОтборовУзлов_Интерактивный", МассивИдУзлов));
	КонецЕсли;
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборовУзлов_Автообмен_Узлы") Тогда
		ЗначенияНастроек.Вставить("НастройкиОтборовУзлов_Автообмен_Узлы", 			ПолучитьНастройкиПоУзламSMARTS("НастройкиОтборовУзлов_Автообмен", МассивИдУзлов));
	КонецЕсли;
	
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОтборов") Тогда
		НастройкиКПолучению.Вставить("ПроизвольныеОтборыДокументов");
	КонецЕсли;
	
	// Произвольные коды
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ПроизвольныеКоды") Тогда
		НастройкиКПолучению.Вставить("ПроизвольныеКоды_Пользовательские");
		НастройкиКПолучению.Вставить("ПроизвольныеКоды_ПоУмолчанию");
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
	Для каждого НастройкаMS Из НастройкиКПолучению Цикл
		ЗначенияНастроек.Вставить(НастройкаMS.Ключ, НастройкаMS.Значение);
	КонецЦикла;
	
	// Шапка обмена справочников
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("НастройкиОбменаСправочников_Шапка") Тогда
		НастройкиКПолучению = Новый Структура;
		НастройкиКПолучению.Вставить("ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента");
		НастройкиКПолучению.Вставить("ДлинаКодаВесовогоТовара");
		НастройкиКПолучению.Вставить("ИспользоватьШаблоныВесовогоТовара");
		НастройкиКПолучению.Вставить("ПереписыватьНоменклатуруПриВыгрузке");
		НастройкиКПолучению.Вставить("ПрефиксВключенВКодВесовогоТовара");
		НастройкиКПолучению.Вставить("ПрефиксКодаВесовогоТовара");
		НастройкиКПолучению.Вставить("РазмерПорцииНоменклатуры");
		НастройкиКПолучению.Вставить("УстановитьПоискПоНаименованиюИАртикулу");
		НастройкиКПолучению.Вставить("ЧислоЗнаковПослеЗапятойВесТовара");
		
		_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
		ЗначенияНастроек.Вставить("НастройкиОбменаСправочников_Шапка", НастройкиКПолучению);
	КонецЕсли;
	
	// Пользователи
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("Пользователи") Тогда
		// Пользователи
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьПользователейSMARTS();
		Если ЭтоАдресВременногоХранилища(ЗначениеНастройки) Тогда
			ЗначениеНастройки = ПолучитьИзВременногоХранилища(ЗначениеНастройки);
		КонецЕсли;
		ЗначенияНастроек.Вставить("Пользователи", ЗначениеНастройки);
	КонецЕсли;
	
	// Группы пользователей
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ГруппыПользователей") Тогда
		// Группы пользователей
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьГруппыПользователейSMARTS();
		Если ЭтоАдресВременногоХранилища(ЗначениеНастройки) Тогда	
			ЗначениеНастройки = ПолучитьИзВременногоХранилища(ЗначениеНастройки);
		КонецЕсли;
		ЗначенияНастроек.Вставить("ГруппыПользователей", ЗначениеНастройки);
	КонецЕсли;
	
	// Пользователи ТСД
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ПользователиТСД_Узлы") Тогда
		ЗначенияНастроек.Вставить("ПользователиТСД_Узлы", ПолучитьНастройкиПоУзламSMARTS("ПользователиТСД", МассивИдУзлов));
	КонецЕсли;
	
	// Обработка глобальных параметров
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ГлобальныеПараметры_Значения") Тогда
		// Глобальные параметры
		ГлобальныеПараметры = Новый Массив();
		ГлобальныеПараметры_ПоУмолчанию 	 =  ЗначенияНастроек.ГлобальныеПараметры_ПоУмолчанию;
		ГлобальныеПараметры_Пользовательские = ЗначенияНастроек.ГлобальныеПараметры_Пользовательские;
		
		Если ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
			Для каждого СтрокаГП ИЗ ГлобальныеПараметры_ПоУмолчанию Цикл
				Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
					СтрокаГП.Вставить("Типовой", Истина);
					ГлобальныеПараметры.Добавить(_ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаГП));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГлобальныеПараметры_Пользовательские) И НЕ ГлобальныеПараметры_Пользовательские = Ложь Тогда
			Для каждого СтрокаГП ИЗ ГлобальныеПараметры_Пользовательские Цикл
				Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
					НайденныйПараметр = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаГП.ID_Параметра);
					Если НайденныйПараметр = Неопределено Тогда
						СтрокаГП.Вставить("Типовой", Ложь);
						ГлобальныеПараметры.Добавить(_ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаГП));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ГлобальныеПараметры_Значения = ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ГлобальныеПараметры,  ЗначенияНастроек.ГлобальныеПараметры_Значения);
		ЗначенияНастроек.Вставить("ГлобальныеПараметры_Значения", ГлобальныеПараметры_Значения);
	КонецЕсли;
	
	// Глобальные параметры узлов
	Если ПолучитьВсе ИЛИ ОтборНастроек.Свойство("ГлобальныеПараметры_Значения_Узлы") Тогда
		ГлобальныеПараметры_Значения_Узлы = ПолучитьНастройкиПоУзламSMARTS("ГлобальныеПараметры_Значения", МассивИдУзлов);
		Для каждого КлючЗначение Из ГлобальныеПараметры_Значения_Узлы Цикл
			ЗначениеУзла = ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ГлобальныеПараметры, КлючЗначение.Значение, КлючЗначение.Ключ);
			ГлобальныеПараметры_Значения_Узлы.Вставить(КлючЗначение.Ключ, ЗначениеУзла);
		КонецЦикла;
		ЗначенияНастроек.Вставить("ГлобальныеПараметры_Значения_Узлы", ГлобальныеПараметры_Значения_Узлы);
	КонецЕсли;
	
	СтруктураНастроек.Вставить("ВерсияОбработкиНастроек", ЗначенияНастроек.ВерсияОбработкиНастроек);
	СтруктураНастроек.Вставить("Значения", ЗначенияНастроек);
	Возврат СтруктураНастроек;
	
КонецФункции

&НаКлиенте
Функция ПолучитьНовыеЗначенияSMARTS()
	
	ЗначенияНастроек = Новый Структура;
	ЗначенияНастроек.Вставить("Узлы");
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(ЗначенияНастроек);
	
	// Получение узлов
	ЗначенияНастроек.Вставить("ЕстьУзлы", Ложь);
	Узлы = ЗначенияНастроек.Узлы;
	МассивИдУзлов = Новый Массив;
	Если НЕ Узлы = Ложь И ТипЗнч(Узлы) = Тип("Массив")  Тогда
		Для Каждого СтрокаУзла Из Узлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			МассивИдУзлов.Добавить(СтрокаУзла.ID_Узла);
			ЗначенияНастроек.ЕстьУзлы = Истина;
		КонецЦикла;
	КонецЕсли;
	ЗначенияНастроек.Вставить("ИдУзлов", МассивИдУзлов);
	
	ЗначенияНБП = ПолучитьСтруктуруНастроекБизнесПроцессов();
	Для каждого КлючЗначение Из ЗначенияНБП Цикл
		ЗначенияНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	ОбработатьОбщуюСтруктуруБизнесПроцессов(ЗначенияНастроек);
	
	Возврат ЗначенияНастроек;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруНастроекБизнесПроцессов()
	
	ЗначенияНастроек = Новый Структура;
	ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские");
	ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки");
	ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию");
	ЗначенияНастроек.Вставить("ВерсияНастроек");
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(ЗначенияНастроек);
	
	пВерсияНастроек = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВерсияНастроек");
	Для каждого КлючЗначение Из ЗначенияНастроек Цикл
		Если НЕ ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			ЗначенияНастроек.Вставить(КлючЗначение.Ключ, Новый Структура("ВерсияНастроек,НастройкиБизнесПроцессов", пВерсияНастроек, КлючЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	
	НастройкиБизнесПроцессов_ПоУмолчанию 					= ?(ЗначенияНастроек.НастройкиБизнесПроцессов_ПоУмолчанию = Ложь, Ложь, ЗначенияНастроек.НастройкиБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов);
	НастройкиБизнесПроцессов_Пользовательские 				= ?(ЗначенияНастроек.НастройкиБизнесПроцессов_Пользовательские = Ложь, Ложь, ЗначенияНастроек.НастройкиБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов);
	НастройкиБизнесПроцессов_ПользовательскиеНастройки 	= ?(ЗначенияНастроек.НастройкиБизнесПроцессов_ПользовательскиеНастройки = Ложь, Ложь, ЗначенияНастроек.НастройкиБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов);
	ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию", 						НастройкиБизнесПроцессов_ПоУмолчанию);	
	ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские", 					НастройкиБизнесПроцессов_Пользовательские);	
	ЗначенияНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 		НастройкиБизнесПроцессов_ПользовательскиеНастройки);
	
	Возврат ЗначенияНастроек;
	
КонецФункции 

&НаКлиенте
Процедура ОбработатьОбщуюСтруктуруБизнесПроцессов(ЗначенияНастроек)
	
	Если НЕ ЗначенияНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
		Возврат;
	КонецЕсли;
	
	ОбщаяСтруктураБизнесПроцессов = ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ЗначенияНастроек.НастройкиБизнесПроцессов_ПоУмолчанию, ЗначенияНастроек.НастройкиБизнесПроцессов_Пользовательские, ЗначенияНастроек.НастройкиБизнесПроцессов_ПользовательскиеНастройки);
	ЗначенияНастроек.Вставить("ОбщаяСтруктураБизнесПроцессов", ОбщаяСтруктураБизнесПроцессов);
	
	ИдБизнесПроцессов = Новый Массив;
	Для Каждого СтрокаНастройки Из ОбщаяСтруктураБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		ИдБизнесПроцессов.Добавить(СтрокаНастройки.ID_БизнесПроцесса);
	КонецЦикла;
	ЗначенияНастроек.Вставить("ИдБизнесПроцессов", ИдБизнесПроцессов);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНастройкиПоУзламSMARTS(ИмяНастройки, ИдУзлов)
	
	Сериализовать = КатегорииНастроекMS.СериализуемыеНастройки.Найти(ИмяНастройки) <> Неопределено;
	
	СтруктураНастроек = Новый Структура;
	Для Каждого ID_Узла Из ИдУзлов Цикл
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS(ИмяНастройки, ID_Узла);
		Если НЕ ЗначениеНастройки = Ложь И Сериализовать Тогда
			ЗначениеНастройки = СериализоватьНастройки(ЗначениеНастройки, "ИзСтроки");
		КонецЕсли;
		СтруктураНастроек.Вставить(ID_Узла, ЗначениеНастройки);
	КонецЦикла;
	
	Возврат СтруктураНастроек;
	
КонецФункции 

&НаКлиенте
Функция МетаданныеНастроек()
	
	МетаданныеСписокНастроек = Новый Структура;
	МетаданныеДеревоНастроек = Новый Структура;
	
	// Торговые объекты {
	
	// Группа Торговые объекты
	Настройка = ПолучитьСтруктуруМетаданныхНастроек();
	Настройка.Имя				= "Узлы";
	Настройка.Синоним		= "Торговые объекты";
	Настройка.ТипСтроки		= "Файл";
	Настройка.ТребуютсяТО	= Ложь;
	Настройка.ЭтоРодитель	= Истина;
	Настройка.Родитель		= Неопределено;
	МетаданныеСписокНастроек.Вставить(Настройка.Имя, Настройка);
	МетаданныеДеревоНастроек.Вставить(Настройка.Имя, Настройка);
	
	// } Торговые объекты
	
	
	
	// Бизнес-процессы {
	
