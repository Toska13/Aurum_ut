&НаКлиенте
Процедура СохранитьНастройкиВБазуSMARTS()
	
	СтрокиДерева = ПолучитьЭлементыСтроки(ДеревоНастроек);
	
	НастройкиSMARTS = ПолучитьНастройкиИзSMARTS(Ложь, ПолучитьИменаВыбранныхНастроек(СтрокиДерева));
	ОбработатьОбщуюСтруктуруБизнесПроцессов(НастройкиSMARTS.Значения);
	ДанныеНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
	ДанныеНастроек.Вставить("НастройкиSMARTS", НастройкиSMARTS);
	
	ДополнительныеПараметры = Новый Структура("ВыгрузитьБизнесПроцессы", Ложь);
	СохранитьНастройкиВБазуSMARTSРекурсивно(СтрокиДерева, ДанныеНастроек, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.ВыгрузитьБизнесПроцессы Тогда
		ЛокЯдро_ВыгрузитьБизнесПроцессыВТаблицу();
	КонецЕсли;
	
	ЛокЯдро_ОбновитьНастройкиMobileSMARTS();
	ПоказатьПредупреждение(, "Импорт настроек завершен");
	
КонецПроцедуры 

&НаКлиенте
Процедура СохранитьНастройкиВБазуSMARTSРекурсивно(СтрокиДерева, ДанныеНастроек, ДополнительныеПараметры)
	
	Для каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.Использовать Тогда
			
			Если СтрокаДерева.ТипСтроки = "Группа" Тогда
				СохранитьНастройкиВБазуSMARTSРекурсивно(ПолучитьЭлементыСтроки(СтрокаДерева), ДанныеНастроек, ДополнительныеПараметры);
				
			ИначеЕсли СтрокаДерева.ТипСтроки = "Файл" Тогда
				ОбработчикСохраненияНастроекSMARTS(СтрокаДерева, ДанныеНастроек, ДополнительныеПараметры);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработчикСохраненияНастроекSMARTS(СтрокаДерева, ДанныеНастроек, ДополнительныеПараметры)
	
	ИмяНастройки 					= СтрокаДерева.Имя;
	ИмяНастройкиБезРасширения 	= СтрЗаменить(ИмяНастройки, "_Узлы", "");
	ID_Узла 							= СтрокаДерева.ID_Узла;
	ЗначенияИмпорт					= ДанныеНастроек.Значения;
	ЗначенияSMARTS 					= ДанныеНастроек.НастройкиSMARTS.Значения;
	
	// Проверка на наличие узла в базе или импортируемых настройках
	Если ИмяНастройкиБезРасширения <> "Узлы" И ID_Узла <> "" Тогда
		Если НЕ ЗначенияSMARTS.ЕстьУзлы
			ИЛИ ЗначенияSMARTS.ИдУзлов.Найти(ID_Узла) = Неопределено Тогда
			УзелНастройки = ТаблицаУзлов.НайтиСтроки(Новый Структура("ID_Узла", ID_Узла))[0];
			ОписаниеОшибки = "Не удалось найти торговый объект: " + УзелНастройки.Наименование + ". Выберете торговые объекты для импорта";
			ДобавитьЗаписьОшибки(ОписаниеОшибки, ИмяНастройки, ID_Узла);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Получение значений импортируемых настроек и объединение с текущими настройками базы MS
	ОбновитьЗначенияSMARTS = Ложь;
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("ВерсияОбработкиНастроек", ДанныеНастроек.ВерсияОбработкиНастроек);
	
	Если ИмяНастройкиБезРасширения = "ОбщаяСтруктураБизнесПроцессов" Тогда
		
		ПараметрыОтбора = Новый Структура("ЛевоеПоле, ПравоеПоле", "ID_БизнесПроцесса", "Ид");
		ВыбранныеНБП_ПоУмолчанию 					= ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначенияИмпорт.НастройкиБизнесПроцессов_ПоУмолчанию, 					ПараметрыОтбора);
		ВыбранныеНБП_Пользовательские 				= ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначенияИмпорт.НастройкиБизнесПроцессов_Пользовательские, 				ПараметрыОтбора);
		ВыбранныеНБП_ПользовательскиеНастройки 	= ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначенияИмпорт.НастройкиБизнесПроцессов_ПользовательскиеНастройки, 	ПараметрыОтбора);
		
		СтруктураОтбора 						= Новый Структура("ID_БизнесПроцесса");
		БП_ПоУмолчанию 					= ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеНБП_ПоУмолчанию, 					ЗначенияSMARTS.НастройкиБизнесПроцессов_ПоУмолчанию, СтруктураОтбора);
		БП_Пользовательские 				= ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеНБП_Пользовательские, 				ЗначенияSMARTS.НастройкиБизнесПроцессов_Пользовательские, СтруктураОтбора);
		БП_ПользовательскиеНастройки 		= ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеНБП_ПользовательскиеНастройки, 	ЗначенияSMARTS.НастройкиБизнесПроцессов_ПользовательскиеНастройки, СтруктураОтбора);
		
		СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию", БП_ПоУмолчанию);
		СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_Пользовательские", БП_Пользовательские);
		СтруктураНастройки.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки", БП_ПользовательскиеНастройки);
		ОбновитьЗначенияSMARTS = Истина;
		ДополнительныеПараметры.ВыгрузитьБизнесПроцессы = Истина;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "ПроизвольныеКоды" Тогда
		
		СтруктураОтбора = Новый Структура("ID_ПроизвольногоКода");
		ПараметрыОтбора = Новый Структура("ЛевоеПоле, ПравоеПоле", "ID_ПроизвольногоКода", "Ид");
		
		ЗначениеИмпорт 					= НайтиЗначениеНастройки(ЗначенияИмпорт, "ПроизвольныеКоды_ПоУмолчанию");
		ЗначениеSMARTS 					= НайтиЗначениеНастройки(ЗначенияSMARTS, "ПроизвольныеКоды_ПоУмолчанию");
		ВыбранныеЗначенияИмпорт 		= ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначениеИмпорт, ПараметрыОтбора);
		ВыбранныеЗначенияИмпорт 		= ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеЗначенияИмпорт, ЗначениеSMARTS, СтруктураОтбора);
		СтруктураНастройки.Вставить("ПроизвольныеКоды_ПоУмолчанию", ВыбранныеЗначенияИмпорт);
		
		ЗначениеИмпорт 					= НайтиЗначениеНастройки(ЗначенияИмпорт, "ПроизвольныеКоды_Пользовательские");
		ЗначениеSMARTS 					= НайтиЗначениеНастройки(ЗначенияSMARTS, "ПроизвольныеКоды_Пользовательские");
		ВыбранныеЗначенияИмпорт 		= ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначениеИмпорт, ПараметрыОтбора);
		ВыбранныеЗначенияИмпорт 		= ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеЗначенияИмпорт, ЗначениеSMARTS, СтруктураОтбора);
		СтруктураНастройки.Вставить("ПроизвольныеКоды_Пользовательские", ВыбранныеЗначенияИмпорт);
		
	ИначеЕсли ИмяНастройкиБезРасширения = "НастройкиОбменаСправочников_Шапка" Тогда
		
		ЗначениеИмпорт = НайтиЗначениеНастройки(ЗначенияИмпорт, ИмяНастройки, ID_Узла);
		Для каждого КлючЗначение Из ЗначениеИмпорт Цикл
			СтруктураНастройки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		
	ИначеЕсли ИмяНастройки = "ГлобальныеПараметры_Значения" Тогда
		
		ЗначениеИмпорт = НайтиЗначениеНастройки(ЗначенияИмпорт, ИмяНастройки, ID_Узла);
		ЗначениеSMARTS = НайтиЗначениеНастройки(ЗначенияSMARTS, ИмяНастройки, ID_Узла);
		ПараметрыОтбора = Новый Структура("ЛевоеПоле, ПравоеПоле", "ID_Параметра", "Ид");
		ВыбранныеЗначенияИмпорт = ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначениеИмпорт, ПараметрыОтбора);
			
		Если НЕ ТипЗнч(ВыбранныеЗначенияИмпорт) = Тип("Массив") 
			ИЛИ НЕ МассивСтруктурСодержитЭлементы(ВыбранныеЗначенияИмпорт) Тогда
			Возврат;
		КонецЕсли;
		
		ЗначениеИмпорт = ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеЗначенияИмпорт, ЗначениеSMARTS, Новый Структура("ID_Параметра"));
		СтруктураНастройки.Вставить(ИмяНастройкиБезРасширения, ЗначениеИмпорт);
		
		// Поиск ГП в типовых ГП базы
		ЗначениеSMARTS 					= НайтиЗначениеНастройки(ЗначенияSMARTS, "ГлобальныеПараметры_ПоУмолчанию");
		ВыбранныеЗначенияSMARTS 	= ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначениеSMARTS, ПараметрыОтбора);
		
		// Отбираем новые ГП
		СтруктураОтбора = Новый Структура("ID_Параметра");
		ПользовательскиеНастройки = Новый Массив;
		Для каждого СтрокаНастройки Из ВыбранныеЗначенияИмпорт Цикл
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаНастройки);
			РезультатПоиска = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ВыбранныеЗначенияSMARTS, СтруктураОтбора, Истина);
			Если РезультатПоиска = Неопределено Тогда
				ПользовательскиеНастройки.Добавить(СтрокаНастройки);
			КонецЕсли;
		КонецЦикла;
		
		// Если найдены новые ГП, то импортируем их в ГлобальныеПараметры_Пользовательские
		Если ПользовательскиеНастройки.Количество() Тогда
			
			СтруктураОтбора = Новый Структура("ID_Параметра");
			
			ГП_ПоУмолчанию 						= НайтиЗначениеНастройки(ЗначенияИмпорт, "ГлобальныеПараметры_ПоУмолчанию");
			ЗначениеИмпорт_ПоУмолчанию 		= НайтиЭлементыПоВхождениюВМассив(ПользовательскиеНастройки, ГП_ПоУмолчанию, СтруктураОтбора, Истина);
			
			Если ТипЗнч(ЗначениеИмпорт_ПоУмолчанию) = Тип("Массив") Тогда
				Для каждого СтрокаНастройки Из ЗначениеИмпорт_ПоУмолчанию Цикл
					Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений Тогда
						Продолжить;
					КонецЕсли;
					СтрокаНастройки.Типовой = Ложь;
				КонецЦикла;
			КонецЕсли;
			
			ГП_Пользовательские				= НайтиЗначениеНастройки(ЗначенияИмпорт, "ГлобальныеПараметры_Пользовательские");
			ЗначениеИмпорт_Пользовательские 	= НайтиЭлементыПоВхождениюВМассив(ПользовательскиеНастройки, ГП_Пользовательские, СтруктураОтбора, Истина);
			ЗначениеИмпорт_Пользовательские 	= ОбъединитьМассивыУникальнымиЗначениями(ЗначениеИмпорт_Пользовательские, ЗначениеИмпорт_ПоУмолчанию, СтруктураОтбора);
			
			ЗначениеSMARTS 					= НайтиЗначениеНастройки(ЗначенияSMARTS, "ГлобальныеПараметры_Пользовательские");
			ВыбранныеЗначенияИмпорт 		= ОбъединитьМассивыУникальнымиЗначениями(ЗначениеИмпорт_Пользовательские, ЗначениеSMARTS, СтруктураОтбора);
			СтруктураНастройки.Вставить("ГлобальныеПараметры_Пользовательские", ВыбранныеЗначенияИмпорт);
			
		КонецЕсли;
		
	Иначе
		
		ЗначениеИмпорт = НайтиЗначениеНастройки(ЗначенияИмпорт, ИмяНастройки, ID_Узла);
		
		// Поиск строк в сохраненных настройках SMARTS. Нужно чтобы не затереть уже сохраненные настройки в MS
		КлючиОтбора = "";
		Если ИмяНастройкиБезРасширения = "Узлы" Тогда
			КлючиОтбора = "ID_Узла";
			ОбновитьЗначенияSMARTS = Истина;
			ДополнительныеПараметры.ВыгрузитьБизнесПроцессы = Истина;
		ИначеЕсли ИмяНастройкиБезРасширения = "ПроизвольныеОтборыДокументов" Тогда
			КлючиОтбора = "ID_ПроизвольногоОтбора";
		ИначеЕсли ИмяНастройкиБезРасширения = "НастройкиОбменаСправочников" Тогда
			КлючиОтбора = "ИмяТаблицы";
		ИначеЕсли ИмяНастройкиБезРасширения = "Пользователи" Тогда
			КлючиОтбора = "Ид";
		ИначеЕсли ИмяНастройкиБезРасширения = "ГруппыПользователей" Тогда
			КлючиОтбора = "Ид";
		ИначеЕсли ИмяНастройкиБезРасширения = "ПользователиТСД" Тогда
			КлючиОтбора = "ID_Пользователя";
		ИначеЕсли _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройкиБезРасширения, "НастройкиОтборовУзлов") Тогда			
			КлючиОтбора = "ID_БизнесПроцесса";			
		КонецЕсли;
		
		Если КлючиОтбора <> "" Тогда
			ЗначениеSMARTS = НайтиЗначениеНастройки(ЗначенияSMARTS, ИмяНастройки, ID_Узла);
			ПараметрыОтбора = Новый Структура("ЛевоеПоле, ПравоеПоле", КлючиОтбора, "Ид");
			ВыбранныеЗначенияИмпорт = ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначениеИмпорт, ПараметрыОтбора);
			
			Если НЕ ТипЗнч(ВыбранныеЗначенияИмпорт) = Тип("Массив") Тогда
				Возврат;
			КонецЕсли;
			
			Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройкиБезРасширения, "НастройкиОтборовУзлов") Тогда
				// Проверка на наличие БП в базе или импортируемых настройках
				ОтобранныеЗначения = Новый Массив;
				Для каждого СтрокаНастройки Из ВыбранныеЗначенияИмпорт Цикл
					Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
						ОтобранныеЗначения.Добавить(СтрокаНастройки);
					ИначеЕсли ЗначенияSMARTS.ИдБизнесПроцессов.Найти(СтрокаНастройки.ID_БизнесПроцесса) = Неопределено Тогда
						ОписаниеОшибки = "Не удалось найти бизнес-процесс: " + СтрокаНастройки.Название + ". Выберете бизнес-процессы для импорта";
						ДобавитьЗаписьОшибки(ОписаниеОшибки, ИмяНастройки, СтрокаНастройки.ID_БизнесПроцесса);
					Иначе
						ОтобранныеЗначения.Добавить(СтрокаНастройки);
					КонецЕсли;
				КонецЦикла;
				ВыбранныеЗначенияИмпорт = ОтобранныеЗначения;
			КонецЕсли;
			
			Если НЕ МассивСтруктурСодержитЭлементы(ВыбранныеЗначенияИмпорт) Тогда
				Возврат;
			КонецЕсли;
			
			ЗначениеИмпорт = ОбъединитьМассивыУникальнымиЗначениями(ВыбранныеЗначенияИмпорт, ЗначениеSMARTS, Новый Структура(КлючиОтбора));
			
		КонецЕсли;
		
		СтруктураНастройки.Вставить(ИмяНастройкиБезРасширения, ЗначениеИмпорт);
		
	КонецЕсли;
	
	// Сохранение настроек
	Если ИмяНастройкиБезРасширения = "ОбщаяСтруктураБизнесПроцессов" Тогда
		
		ФормаСписка_БизнесПроцессы = ПолучитьФормуОсновнойОбработки("ФормаСписка_БизнесПроцессы");
		ФормаСписка_БизнесПроцессы._ЛокКонтекст = _ЛокКонтекст;
		ФормаСписка_БизнесПроцессы.ЗагрузитьИзФайлаЗавершение(СтруктураНастройки, Неопределено);
		
	ИначеЕсли ИмяНастройкиБезРасширения = "ПроизвольныеКоды" Тогда
		
		ФормаСписка_ПроизвольныеКоды = ПолучитьФормуОсновнойОбработки("ФормаСписка_ПроизвольныеКоды");
		ФормаСписка_ПроизвольныеКоды._ЛокКонтекст = _ЛокКонтекст;
		ФормаСписка_ПроизвольныеКоды.ЗагрузитьИзФайлаЗавершение(СтруктураНастройки, Неопределено);
		
	ИначеЕсли ИмяНастройкиБезРасширения = "Пользователи" Тогда
		
		// TODO: Сделать загрузку пользователей без цикла, одним запросом
		Для каждого СтрокаПользователя Из ЗначениеИмпорт Цикл
			
			ПараметрыПользователя = Новый Соответствие;
			ПараметрыПользователя.Вставить("id", 				СтрокаПользователя.Ид);
			ПараметрыПользователя.Вставить("name", 			СтрокаПользователя.Имя);		
			ПараметрыПользователя.Вставить("description", 	СтрокаПользователя.Описание);		
			ПараметрыПользователя.Вставить("password", 		СтрокаПользователя.Пароль);			
			ПараметрыПользователя.Вставить("barcode", 		СтрокаПользователя.Штрихкод);		
			ПараметрыПользователя.Вставить("groupId", 		СтрокаПользователя.ИдГруппы);		
			ПараметрыПользователя.Вставить("groupName", 	СтрокаПользователя.ИмяГруппы);		
			ПараметрыПользователя.Вставить("warehouseIds",  СтрокаПользователя.ИдСкладов.ВыгрузитьЗначения());				
			
			ЗагрузкаПользователя = _ЛокКонтекст.ЛокЯдро_ЗагрузитьПользователейВSMARTS(ПараметрыПользователя);    
			
		КонецЦикла;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "ГруппыПользователей" Тогда
		
		// TODO: Сделать загрузку групп без цикла, одним запросом
		Для каждого СтрокаГруппы Из ЗначениеИмпорт Цикл
			
			ПараметрыГруппы = Новый Соответствие;
			ПараметрыГруппы.Вставить("id", 								СтрокаГруппы.Ид);
			ПараметрыГруппы.Вставить("name", 							СтрокаГруппы.Имя);		                                            
			ПараметрыГруппы.Вставить("documentTypeNames", 			СтрокаГруппы.ТипыДокументов);	
			
			// Типы документов для кома-режима
			ПараметрыГруппы.Вставить("batchMode", 					Ложь);		
			ПараметрыГруппы.Вставить("role", 							СтрокаГруппы.Роль);		
			ПараметрыГруппы.Вставить("serverSideInventory", 			Ложь);		
			ПараметрыГруппы.Вставить("autorunDocumentTypeName", 	"");		
			ПараметрыГруппы.Вставить("onStartHandlerName", 			"При начале работы пользователя");		
			ПараметрыГруппы.Вставить("onFinishHandlerName", 		"При завершении работы пользователя");			
			
			РезультатЗагрузки = _ЛокКонтекст.ЛокЯдро_ЗагрузитьГруппыПользователейВSMARTS(ПараметрыГруппы);
			
		КонецЦикла;
		
	Иначе
		
		//Выполним обновление - Начало
		ВерсияОбработки =_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");		
		Если СтруктураНастройки.Свойство("ВерсияОбработкиНастроек") Тогда
			ВерсияОбработкиНастроек = СтруктураНастройки.ВерсияОбработкиНастроек;
		Иначе
			ВерсияОбработкиНастроек = 0;		
		КонецЕсли;  
		Если ВерсияОбработки>ВерсияОбработкиНастроек Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ВерсияНастроек,СтруктураНастроек",ВерсияОбработкиНастроек,СтруктураНастройки));
			
			СтруктураНастройки = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,_ЛокКонтекст.АдресаПеременных);
		КонецЕсли;
		//Выполним обновление - Конец
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастройки, ID_Узла);
	КонецЕсли;
	
	Если ОбновитьЗначенияSMARTS Тогда
		НовыеЗначения = ПолучитьНовыеЗначенияSMARTS();
		Для каждого КлючЗначение Из НовыеЗначения Цикл
			ЗначенияSMARTS.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		ДанныеНастроек.НастройкиSMARTS.Вставить("Значения", ЗначенияSMARTS);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ИсточникДанных, ПараметрыОтбора)
	
	Если НЕ ТипЗнч(ИсточникДанных) = Тип("Массив") 
		ИЛИ ИсточникДанных.Количество() = 0 Тогда
		Возврат ИсточникДанных;
	КонецЕсли;
	
	Если НЕ СтрокаДерева.ИзменениеДетальныхЗаписей Тогда
		Возврат ИсточникДанных;
	КонецЕсли;
	
	МассивРезультат = Новый Массив;
	
	СтрокаКолонок = ИсточникДанных[0];
	Если СтрокаКолонок.Свойство("ЭтоТаблицаЗначений") И СтрокаКолонок.ЭтоТаблицаЗначений Тогда
		МассивРезультат.Добавить(СтрокаКолонок);
	КонецЕсли;
	
	ДетальныеЗаписи	= ПолучитьЭлементыСтроки(СтрокаДерева);
	Для каждого ДетальнаяЗапись Из ДетальныеЗаписи Цикл
		
		Если НЕ ДетальнаяЗапись.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура(ПараметрыОтбора.ЛевоеПоле, ДетальнаяЗапись[ПараметрыОтбора.ПравоеПоле]);
		РезультатПоиска = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ИсточникДанных, СтруктураОтбора, Истина);
		Если РезультатПоиска <> Неопределено Тогда
			МассивРезультат.Добавить(РезультатПоиска);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьИменаВыбранныхНастроек(СтрокиДерева)
	
	НайденныеСтроки = НайтиСтрокиДереваРекурсивно(СтрокиДерева, "Использовать", Истина);
	
	ИменаНастроек = Новый Структура;
	Для каждого СтрокаДерева Из НайденныеСтроки Цикл
		ИменаНастроек.Вставить(СтрокаДерева.Имя);
	КонецЦикла;
	
	Возврат ИменаНастроек
	
КонецФункции

&НаКлиенте
Функция МассивСтруктурСодержитЭлементы(МассивСтруктур)
	
	Результат = Ложь;
	Если МассивСтруктур.Количество() Тогда
		Если МассивСтруктур[0].Свойство("ЭтоТаблицаЗначений") 
			И МассивСтруктур[0].ЭтоТаблицаЗначений Тогда
			Результат = МассивСтруктур.Количество() > 1;
		Иначе
			Результат = Истина;
		КонецЕсли;			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти

#Область ЗаполнениеДереваНастроек

&НаКлиенте
Процедура ЗаполнитьТаблицуНастроекНаКлиенте(ДанныеНастроек, МетаданныеНастроек)
	
	ЗначенияНастроек = ДанныеНастроек.Значения;
	ОбработатьОбщуюСтруктуруБизнесПроцессов(ЗначенияНастроек);
	
	АдресДанныхНастроек = ПоместитьВоВременноеХранилище(ДанныеНастроек, ЭтаФорма.УникальныйИдентификатор);
	ВерсияНастроек = ПредставлениеВерсииНастроек(ДанныеНастроек);
	
	// Заполнение торговых объектов
	Если ЗначенияНастроек.ЕстьУзлы Тогда
		Для Каждого СтрокаУзла Из ЗначенияНастроек.Узлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			НоваяСтрока = ТаблицаУзлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУзла);
		КонецЦикла;
	КонецЕсли;
	ЕстьУзлы = ТаблицаУзлов.Количество() > 0;
	
	НомерСтроки = 0;
	Для Каждого СтрокаНастройки Из ЗначенияНастроек.ОбщаяСтруктураБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаБизнесПроцессов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
		НомерСтроки = НомерСтроки + 1;
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.Синоним = "" + НомерСтроки + ". " + НоваяСтрока.Название;
		
		Если СтрокаНастройки.Свойство("ЭтоТиповойБизнесПроцесс") И СтрокаНастройки.ЭтоТиповойБизнесПроцесс = Истина Тогда
			Если СтрокаНастройки.Свойство("ПользовательскаяНастройка") И СтрокаНастройки.ПользовательскаяНастройка = Истина Тогда
				НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументТолькоПросмотр;		
			Иначе
				НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
			КонецЕсли;
		Иначе
			Если СтрокаНастройки.Свойство("ПользовательскаяНастройка") И СтрокаНастройки.ПользовательскаяНастройка = Истина Тогда
				НоваяСтрока.Картинка = БиблиотекаКартинок.Изменить;		
			Иначе
				НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьТаблицуНастроекНаСервере(ДанныеНастроек, МетаданныеНастроек);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНастроекНаСервере(ДанныеНастроек, МетаданныеНастроек)
	
	МетаданныеСписокНастроек = МетаданныеНастроек.СписокНастроек;
	МетаданныеДеревоНастроек = МетаданныеНастроек.ДеревоНастроек;	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЛокДеревоНастроек = ДеревоНастроек.Скопировать();
	#Иначе
		ЛокДеревоНастроек = РеквизитФормыВЗначение("ДеревоНастроек");
	#КонецЕсли
	//ЛокДеревоНастроек.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"))
	ЛокДеревоНастроек.Строки.Очистить();
	
	ДополнительныеПараметры = Новый Структура("ДанныеНастроек, МетаданныеСписокНастроек", ДанныеНастроек, МетаданныеСписокНастроек);
	Для каждого МетаданныеНастройки Из МетаданныеДеревоНастроек Цикл
		ДобавитьСтрокиНастроекРекурсивно(ЛокДеревоНастроек.Строки, МетаданныеНастройки.Значение, МетаданныеСписокНастроек, ДополнительныеПараметры);
	КонецЦикла;
	
	УстановитьКартинкиРекурсивно(ЛокДеревоНастроек.Строки);
	ЗадатьПризнакРодителяРекурсивно(ЛокДеревоНастроек.Строки);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ДеревоНастроек = ЛокДеревоНастроек;
	#Иначе
		ЗначениеВРеквизитФормы(ЛокДеревоНастроек, "ДеревоНастроек");
	#КонецЕсли
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьСтрокиНастроекРекурсивно(СтрокиДерева, МетаданныеНастройки, МетаданныеНастроек, ДополнительныеПараметры = Неопределено)
	
	СтрокаДерева = СтрокиДерева.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДерева, МетаданныеНастройки);
	ДобавитьДетальныеЗаписиНастроек(СтрокаДерева.Строки, МетаданныеНастройки, ДополнительныеПараметры);
	
	Если МетаданныеНастройки.ЭтоРодитель Тогда
		
		Для каждого ТекМетаданные Из МетаданныеНастроек Цикл
			ТекМетаданные = ТекМетаданные.Значение;
			Если ТекМетаданные.Родитель <> Неопределено
				И ТекМетаданные.Родитель.Имя = МетаданныеНастройки.Имя Тогда
				ДобавитьСтрокиНастроекРекурсивно(СтрокаДерева.Строки, ТекМетаданные, МетаданныеНастроек, ДополнительныеПараметры);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьДетальныеЗаписиНастроек(СтрокиДерева, МетаданныеНастройки, ДополнительныеПараметры = Неопределено)
	
	ЗначенияНастроек = ДополнительныеПараметры.ДанныеНастроек.Значения;
	МетаданныеСписокНастроек = ДополнительныеПараметры.МетаданныеСписокНастроек;
	
	ИмяНастройки 					= МетаданныеНастройки.Имя;
	ИмяНастройкиБезДЗ 				= СтрЗаменить(ИмяНастройки, "_ДЗ", "");
	ИмяНастройкиСДЗ 				= ИмяНастройкиБезДЗ + "_ДЗ";
	ИмяНастройкиБезРасширения 	= СтрЗаменить(ИмяНастройки, "_Узлы_ДЗ", "");
	ID_Узла 							= СтрокиДерева.Родитель.ID_Узла;
	
	ЗначениеНастройки = Ложь;
	Если ЗначенияНастроек.Свойство(ИмяНастройкиБезДЗ) Тогда
		ЗначениеНастройки = ЗначенияНастроек[ИмяНастройкиБезДЗ];
		Если МетаданныеНастройки.ЭтоДетальныеЗаписиУзлов
			И ТипЗнч(ЗначениеНастройки) = Тип("Структура")
			И ЗначениеНастройки.Свойство(ID_Узла) Тогда
			ЗначениеНастройки = ЗначениеНастройки[ID_Узла];
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяНастройки = "Узлы" Тогда
		
		Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
			ДетальнаяЗапись = СтрокиДерева.Добавить();
			ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
			ДетальнаяЗапись.Синоним				= СтрокаУзла.Наименование;
			ДетальнаяЗапись.Ид						= СтрокаУзла.ID_Узла;
			ДетальнаяЗапись.ID_Узла					= СтрокаУзла.ID_Узла;
			ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
			ДетальнаяЗапись.Использовать			= Ложь;
			ДетальнаяЗапись.Доступность			= Истина;
		КонецЦикла;
		
	ИначеЕсли ИмяНастройки = "ОбщаяСтруктураБизнесПроцессов" Тогда
		
		Для каждого СтрокаНастройки Из ТаблицаБизнесПроцессов Цикл
			ДетальнаяЗапись = СтрокиДерева.Добавить();
			ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
			ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
			ДетальнаяЗапись.Синоним				= СтрокаНастройки.Синоним;
			ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_БизнесПроцесса;
			ДетальнаяЗапись.ID_Узла					= "";
			ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
			ДетальнаяЗапись.Использовать			= Ложь;
			ДетальнаяЗапись.Доступность			= Истина;
		КонецЦикла;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "НастройкиБизнесПроцессов_ПользовательскиеНастройки" Тогда
		
		Для каждого СтрокаНастройки Из ТаблицаБизнесПроцессов Цикл
			ДетальнаяЗапись = СтрокиДерева.Добавить();
			ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
			ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
			ДетальнаяЗапись.Синоним				= СтрокаНастройки.Синоним;
			ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_БизнесПроцесса;
			ДетальнаяЗапись.ID_Узла					= ID_Узла;
			ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
			ДетальнаяЗапись.Использовать			= Ложь;
			ДетальнаяЗапись.Доступность			= Истина;
		КонецЦикла;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "НастройкиОбменаСправочников" ИЛИ ИмяНастройкиБезРасширения = "НастройкиОбменаСправочников_Узлы" И МетаданныеНастройки.ТипСтроки <> "Группа"  Тогда
		
		ЗначениеНастройки = ЗначенияНастроек[ИмяНастройкиБезДЗ];
		Если ИмяНастройкиСДЗ = "НастройкиОбменаСправочников_Узлы_ДЗ" Тогда
			ЗначениеНастройки = ЗначениеНастройки[ID_Узла];
		КонецЕсли;
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.ИмяТаблицыПредставление;
				ДетальнаяЗапись.Ид						= "";
				ДетальнаяЗапись.ID_Узла					= ID_Узла;
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= ?(СтрокаНастройки.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
				
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеКоды" Тогда
		
		Если ЗначенияНастроек.ПроизвольныеКоды_ПоУмолчанию <> Ложь И ЗначениеЗаполнено(ЗначенияНастроек.ПроизвольныеКоды_ПоУмолчанию) Тогда
			Для каждого СтрокаНастройки Из ЗначенияНастроек.ПроизвольныеКоды_ПоУмолчанию Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_ПроизвольногоКода;
				ДетальнаяЗапись.ID_Узла					= "";
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначенияНастроек.ПроизвольныеКоды_Пользовательские <> Ложь И ЗначениеЗаполнено(ЗначенияНастроек.ПроизвольныеКоды_Пользовательские) Тогда
			Для каждого СтрокаНастройки Из ЗначенияНастроек.ПроизвольныеКоды_Пользовательские Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_ПроизвольногоКода;
				ДетальнаяЗапись.ID_Узла					= "";
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= БиблиотекаКартинок.Пользователь;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеОтборыДокументов" Тогда
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_ПроизвольногоОтбора;
				ДетальнаяЗапись.ID_Узла					= "";
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "ГлобальныеПараметры"
				ИЛИ ИмяНастройкиБезРасширения = "ГлобальныеПараметры_Значения" Тогда
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_Параметра;
				ДетальнаяЗапись.ID_Узла					= ID_Узла;
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= ?(НЕ СтрокаНастройки.Свойство("Типовой") ИЛИ СтрокаНастройки.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ЛокЯдро_СтрНайтиНаСервере(ИмяНастройки, "НастройкиОтборовУзлов") И МетаданныеНастройки.ТипСтроки <> "Группа" Тогда
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ПоискБП = ТаблицаБизнесПроцессов.НайтиСтроки(Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса));
				Если НЕ ПоискБП.Количество() Тогда
					Продолжить;
				КонецЕсли;
				ПоискБП = ПоискБП[0];
				
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= ПоискБП.Синоним;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_БизнесПроцесса;
				ДетальнаяЗапись.ID_Узла					= ID_Узла;
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= ПоискБП.Картинка;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли МетаданныеНастройки.ТребуютсяТО Тогда
		ДобавитьДетальныеЗаписиТорговыхОбъектов(СтрокиДерева, МетаданныеНастройки, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьДетальныеЗаписиТорговыхОбъектов(СтрокиДерева, МетаданныеНастройки, ДополнительныеПараметры = Неопределено)
	
	Если НЕ ТаблицаУзлов.Количество() Тогда
		СтрокиДерева.Родитель.Доступность = Ложь;
	КонецЕсли;
	
	ИмяСтроки = МетаданныеНастройки.Имя;
	ИмяСтрокиБезРасширения = СтрЗаменить(ИмяСтроки, "_Общий", "");
	ТипСтроки = "Файл";
	//ТипСтроки = ?(ИмяСтроки = "НастройкиОбменаСправочников_Общий_Узлы", "Группа", "Файл");
	
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		ДетальнаяЗапись = СтрокиДерева.Добавить();
		ДетальнаяЗапись.Имя						= ИмяСтроки;
		ДетальнаяЗапись.Синоним				= СтрокаУзла.Наименование;
		ДетальнаяЗапись.Ид						= СтрокаУзла.ID_Узла;
		ДетальнаяЗапись.ID_Узла					= СтрокаУзла.ID_Узла;
		ДетальнаяЗапись.ТипСтроки				= ТипСтроки;
		ДетальнаяЗапись.Использовать			= Ложь;
		ДетальнаяЗапись.Доступность			= Истина;
		
		МетаданныеНастройки_ДЗ = ПолучитьСтруктуруМетаданныхНастроекНаСервере();
		МетаданныеНастройки_ДЗ.Имя				= ИмяСтрокиБезРасширения + "_ДЗ";
		МетаданныеНастройки_ДЗ.Синоним			= "";
		МетаданныеНастройки_ДЗ.ТипСтроки		= "ДетальнаяЗапись";
		МетаданныеНастройки_ДЗ.ТребуютсяТО		= Ложь;
		МетаданныеНастройки_ДЗ.ЭтоРодитель		= Ложь;
		МетаданныеНастройки_ДЗ.ЭтоДетальныеЗаписиУзлов		= Истина;
		
		ДобавитьДетальныеЗаписиНастроек(ДетальнаяЗапись.Строки, МетаданныеНастройки_ДЗ, ДополнительныеПараметры);
		
	КонецЦикла;
	
КонецПроцедуры 

