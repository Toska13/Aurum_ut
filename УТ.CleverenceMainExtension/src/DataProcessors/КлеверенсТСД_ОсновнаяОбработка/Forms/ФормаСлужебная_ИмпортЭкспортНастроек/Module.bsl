	Настройка.ТребуютсяТО	= Ложь;
	Настройка.ЭтоРодитель	= Истина;
	Настройка.Родитель		= МетаданныеСписокНастроек.НастройкиОтборовУзлов_Интерактивный_Общий;
	МетаданныеСписокНастроек.Вставить(Настройка.Имя, Настройка);
	// -- Отборы интерактивные общие
	
	// ++ Отборы интерактивные торговых объектов
	Настройка = ПолучитьСтруктуруМетаданныхНастроек();
	Настройка.Имя				= "НастройкиОтборовУзлов_Интерактивный_Узлы";
	Настройка.Синоним		= "По торговым объектам";
