&НаКлиенте
Функция НайтиЗначениеНастройки(ЗначенияНастроек, ИмяНастройки, ID_Узла = "")
	
	Если НЕ ЗначенияНастроек.Свойство(ИмяНастройки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеНастройки = ЗначенияНастроек[ИмяНастройки];
	Если ID_Узла <> "" И _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройки, "_Узлы")  Тогда
		ПоискЗначения = Неопределено;
		Для каждого ЗначениеУзла Из ЗначениеНастройки Цикл
			Если ЗначениеУзла.Ключ = ID_Узла Тогда
				ПоискЗначения = ЗначениеУзла.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЗначениеНастройки = ПоискЗначения;
	КонецЕсли;
	
	Возврат ЗначениеНастройки;
	
КонецФункции 

&НаКлиенте
Функция ОбъединитьМассивыУникальнымиЗначениями(МассивПриемник, МассивИсточник, СтруктураОтбора)
	
	Если ТипЗнч(МассивПриемник) = Тип("Массив")
		И ТипЗнч(МассивИсточник) = Тип("Массив") Тогда
		
		Результат = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(МассивПриемник);
		Для каждого СтрокаЗначения Из МассивИсточник Цикл
			Если ТипЗнч(СтрокаЗначения) = Тип("Структура") И СтрокаЗначения.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаЗначения);
			РезультатПоиска = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(Результат, СтруктураОтбора, Истина);
			Если РезультатПоиска = Неопределено Тогда
				Результат.Добавить(СтрокаЗначения);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(МассивПриемник) = Тип("Массив") Тогда
		Результат = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(МассивПриемник);
	ИначеЕсли ТипЗнч(МассивИсточник) = Тип("Массив") Тогда
		Результат = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(МассивИсточник);
	Иначе
		Результат = МассивПриемник;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Функция НайтиЭлементыПоВхождениюВМассив(МассивОтбор, МассивИсточник, Знач ПараметрыОтбора, ВернутьОписаниеИсточника = Ложь)
	
	МассивРезультат = Новый Массив;
	
	Если НЕ ТипЗнч(МассивОтбор) = Тип("Массив") 
		ИЛИ МассивОтбор.Количество() = 0 Тогда
		Возврат МассивРезультат;
	КонецЕсли;
	
	Если НЕ ТипЗнч(МассивИсточник) = Тип("Массив") 
		ИЛИ МассивИсточник.Количество() = 0 Тогда
		Возврат МассивРезультат;
	КонецЕсли;
	
	Если ВернутьОписаниеИсточника Тогда
		СтрокаКолонок = МассивИсточник[0];
		Если СтрокаКолонок.Свойство("ЭтоТаблицаЗначений") И СтрокаКолонок.ЭтоТаблицаЗначений Тогда
			МассивРезультат.Добавить(СтрокаКолонок);
		КонецЕсли;
	КонецЕсли;
	
	Для каждого СтрокаМассива Из МассивОтбор Цикл
		
		Если СтрокаМассива.Свойство("ЭтоТаблицаЗначений") И СтрокаМассива.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаМассива);
		РезультатПоиска = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(МассивИсточник, ПараметрыОтбора, Истина);
		Если РезультатПоиска <> Неопределено Тогда
			МассивРезультат.Добавить(РезультатПоиска);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции 

