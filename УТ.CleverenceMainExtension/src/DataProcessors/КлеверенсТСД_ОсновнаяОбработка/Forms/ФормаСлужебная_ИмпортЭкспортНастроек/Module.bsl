&НаКлиенте
Процедура ОткрытьФормуМножественногоВыбора(ЗаголовокФормы, Описание, СписокВыбора, ОповещенияОЗакрытии)
	
	Если ЗапускИзОсновнойОбработки = Истина Тогда
		ФормаСлужебная_МножественныйВыборИзСписка = ПолучитьФормуОсновнойОбработки("ФормаСлужебная_МножественныйВыборИзСписка");
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_МножественныйВыборИзСписка = ПолучитьФорму("ОФ_ФормаСлужебная_МножественныйВыборИзСписка", ЭтаФорма);
		#Иначе
			ФормаСлужебная_МножественныйВыборИзСписка = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_МножественныйВыборИзСписка",, ЭтаФорма);	
		#КонецЕсли
	КонецЕсли;
	
	ФормаСлужебная_МножественныйВыборИзСписка.ВнешнийСписок = СписокВыбора;
	ФормаСлужебная_МножественныйВыборИзСписка.Заголовок = ЗаголовокФормы;
	ФормаСлужебная_МножественныйВыборИзСписка.ОписаниеОповещенияОЗакрытии = ОповещенияОЗакрытии;
	ФормаСлужебная_МножественныйВыборИзСписка.Описание = Описание;
	ФормаСлужебная_МножественныйВыборИзСписка.Открыть();
	
