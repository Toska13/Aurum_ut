&НаКлиенте
Функция ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ОбщиеПараметры, ЧастныеПараметры, ID_Узла = "")
	
	Если НЕ ЗначениеЗаполнено(ЧастныеПараметры) ИЛИ ЧастныеПараметры = Ложь  Тогда
		ЧастныеПараметры = Новый Массив;
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ОбщиеПараметры", 	 		ОбщиеПараметры);
	ПараметрыМетода.Вставить("ЧастныеПараметры", 			ЧастныеПараметры);
	ПараметрыМетода.Вставить("ID_Узла", 		 				ID_Узла);
	ПараметрыМетода.Вставить("ПолучатьНеиспользуемые", 	Истина);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьЗначенияГлобальныхПараметров");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	Попытка
		ТаблицаПараметров = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Исключение
		Если НЕ ЗапускИзОсновнойОбработки Тогда
			СтруктураВызова.ПараметрыМетода.Удалить("ПолучатьНеиспользуемые");
			ТаблицаПараметров = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		КонецЕсли;
	КонецПопытки;
	
	Возврат ТаблицаПараметров;
	
КонецФункции 

// Получаем общую структуру настроек бизнес-процессов по узлу
// Скопировано из ЛокальныйКонтекст с изменениями
&НаКлиенте
Функция ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(НБП_ПоУмолчанию, НБП_Пользовательские, НБП_ПользовательскиеНастройки) Экспорт
	
	НастройкиБизнесПроцессов_ПоУмолчанию = НБП_ПоУмолчанию;
	НастройкиБизнесПроцессов_Пользовательские = НБП_Пользовательские;
	НастройкиБизнесПроцессов_ПользовательскиеНастройки = НБП_ПользовательскиеНастройки;
	НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = НБП_ПользовательскиеНастройки;
	//НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ?(НБП_ПользовательскиеНастройки_ГлавныйУзел = Неопределено, НБП_ПользовательскиеНастройки, НБП_ПользовательскиеНастройки_ГлавныйУзел);
	
	НастройкиБизнесПроцессов = Новый Массив();
	ИдТиповыхБП = Новый Массив();
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию, Истина);		
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл			
			Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Истина);
				НастройкиБизнесПроцессов.Добавить(_ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаБП));
				ИдТиповыхБП.Добавить(СтрокаБП.ID_БизнесПроцесса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские, Истина);		
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_Пользовательские Цикл
			Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда			
				СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Ложь);
				Если ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
					НастройкиБизнесПроцессов.Добавить(_ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаБП));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЭтоГлавныйУзел = Истина;
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = _ЛокКонтекст.ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	ПользовательскиеНастройкиГлавногоУзла = КатегорииНастроекMS.ПользовательскиеНастройкиГлавногоУзла;
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки) И НЕ (НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки, Истина);		
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоГлавныйУзел И ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
			    Продолжить;
			КонецЕсли;
			Индекс = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессов, "ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса, Истина);
			Если Индекс <> Неопределено Тогда
				НастройкиБизнесПроцессов[Индекс].Вставить("ПользовательскаяНастройка", Истина);
				Для Каждого КлючИЗначение Из СтрокаБП Цикл
					Если НЕ ЭтоГлавныйУзел И ПользовательскиеНастройкиГлавногоУзла.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НастройкиБизнесПроцессов[Индекс].Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) И НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел, Истина);
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Индекс = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессов, "ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса, Истина);
			Если Индекс <> Неопределено Тогда
				НастройкиБизнесПроцессов[Индекс].Вставить("ПользовательскаяНастройка", Истина);
				Для Каждого КлючИЗначение Из СтрокаБП Цикл
					Если ПользовательскиеНастройкиГлавногоУзла.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НастройкиБизнесПроцессов[Индекс].Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НастройкиБизнесПроцессов;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьБизнесПроцессыВТаблицу()
	
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Если ЗапускИзОсновнойОбработки Тогда
		_ЛокКонтекст.ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
		Возврат;
	КонецЕсли;
	
	ID_Узла = "";
	ВерсияВыгрузки_6_0 = Истина;
	
	//ВерсияКонфигурацииSMARTS = _ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюКонфигурацииSMARTS();
	//Если ВерсияКонфигурацииSMARTS >= 60000 Тогда
	//	ВерсияВыгрузки_6_0 = Истина;
	//КонецЕсли;
	
	// Получение настроек бизнес-процессов для всех узлов, кроме текущего	
	МассивНастроекБизнесПроцессовПоУзлам = Новый Массив;
	ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ЗначениеЗаполнено(ID_Узла) И ТипЗнч(ВсеУзлы) <> Тип("Массив") Тогда
		ВсеУзлы = Новый Массив;
	КонецЕсли;
	МассивУзловЧастныхБаз = Новый Массив;
	
	// Содержатся все узлы, кроме пустого, у которого ID_узла = ""
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		//Скопируем массив всех узлов, чтобы при редактировании массива ВсеУзлы не изменять значение в кэше
		ВсеУзлы = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(ВсеУзлы);
		// Добавим пустой идентификатор узла, т.к. его нет в массиве "ВсеУзлы"
		СтруктураПустогоУзла = Новый Структура;
		СтруктураПустогоУзла.Вставить("ID_Узла", "");
		ВсеУзлы.Добавить(СтруктураПустогоУзла);
		
		НастройкиБизнесПроцессовПоУзлам = Новый Структура;
		
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") Тогда 
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				//Получение настроек бизнес-процессов для всех узлов, кроме текущего, т.к. настройки текущего узла содержатся в реквизите ОтображаемыеНастройкиБизнесПроцессов
				Если СтрокаУзла.Свойство("ID_Узла")
					И СтрокаУзла.ID_Узла <> ID_Узла Тогда
					
					НастройкиБизнесПроцессовПоУзлам.Вставить(?(ЗначениеЗаполнено(СтрокаУзла.ID_Узла), СтрокаУзла.ID_Узла, "ГлавныйУзел"), Неопределено);
					
				КонецЕсли;
				Если СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу")
					И СтрокаУзла.ИспользоватьЧастнуюБазу Тогда
					МассивУзловЧастныхБаз.Добавить(СтрокаУзла.ID_Узла);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		_ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияКэшируемойНастройкиПоУзлам("НастройкиБизнесПроцессов", НастройкиБизнесПроцессовПоУзлам, "ID_БизнесПроцесса,Используется");
		
		Для каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессовПоУзлам Цикл
			ОбрабатываемыйУзел = ?(СтрокаНастройки.Ключ = "ГлавныйУзел", "", СтрокаНастройки.Ключ);
			
			НастройкиБизнесПроцессовПоУзлу = СтрокаНастройки.Значение;
			Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессовПоУзлу) Тогда
				НастройкиБизнесПроцессовПоУзлу = _ЛокКонтекст.ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ОбрабатываемыйУзел);
			КонецЕсли;
			
			МассивНастроекБизнесПроцессовПоУзлам.Добавить(Новый Структура("ID_Узла, НастройкиБизнесПроцессов", ОбрабатываемыйУзел, НастройкиБизнесПроцессовПоУзлу));
		КонецЦикла;
		
	КонецЕсли;
	
	//
	ТаблицыMS = _ЛокКонтекст.СтруктураМетаданных.Tables;
	Если _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "БизнесПроцессы") <> Неопределено Тогда
		ИмяТаблицыБП = "БизнесПроцессы";
	Иначе
		ИмяТаблицыБП = "BusinessProcesses";		
	КонецЕсли;
	
	// Выгружаются все строки бизнес-процессов, которые активны хотя бы для одного узла, в таблицу БизнесПроцессы базы смартс.
	ТаблицаДляВыгрузки = Новый Массив;
	Для Каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивУзлов = Новый Массив;
		
		Для Каждого СтруктураНастроекБизнесПроцессовПоУзлу Из МассивНастроекБизнесПроцессовПоУзлам Цикл
			НастройкиБизнесПроцессовПоУзлу = СтруктураНастроекБизнесПроцессовПоУзлу.НастройкиБизнесПроцессов;
			
			Если ТипЗнч(НастройкиБизнесПроцессовПоУзлу) = Тип("Массив") Тогда
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
				
				НастройкиПоБизнесПроцессуПоУзлу = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессовПоУзлу, СтруктураОтбора);
				Если НастройкиПоБизнесПроцессуПоУзлу <> Неопределено Тогда
					НастройкаПоБизнесПроцессуПоУзлу = НастройкиПоБизнесПроцессуПоУзлу[0];
					Если НастройкаПоБизнесПроцессуПоУзлу.Свойство("Используется") 
						И НастройкаПоБизнесПроцессуПоУзлу.Используется Тогда
						МассивУзлов.Добавить(СтруктураНастроекБизнесПроцессовПоУзлу.ID_Узла);
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		БПВключен = СтрокаНастройки.Используется;
		БПВключенДляТекУзла = МассивУзлов.Найти(ID_Узла) <> Неопределено;
		
		Если БПВключен <> БПВключенДляТекУзла Тогда
			Если БПВключенДляТекУзла Тогда
				МассивУзлов.Удалить(МассивУзлов.Найти(ID_Узла));
			Иначе
				МассивУзлов.Добавить(ID_Узла);
			КонецЕсли;
		КонецЕсли;
				
		Если МассивУзлов.Количество() = 0 Тогда
			// Бизнес-процесс отключен на всех узлах. Не выгружаем БП
			Продолжить;
		КонецЕсли;
		
		Если НЕ ВерсияВыгрузки_6_0 Тогда
			// Удаляем идентификатор пустого узла
			ИндексУзла = МассивУзлов.Найти("");
			Если ИндексУзла <> Неопределено Тогда
				МассивУзлов.Удалить(ИндексУзла);
			КонецЕсли;
				
			СтрокаУзел = _ЛокКонтекст.ЛокЯдро_СтрСоединить(МассивУзлов, ",");
			
			МассивУзлов = Новый Массив;
			МассивУзлов.Добавить(СтрокаУзел);
		КонецЕсли;
		
		Для каждого СтрокаУзел ИЗ МассивУзлов Цикл
		
			Настройка = Новый Структура();
			Если ИмяТаблицыБП = "БизнесПроцессы" Тогда
				Настройка.Вставить("Ид",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Наименование",					СтрокаНастройки.Название);
				Настройка.Вставить("ТипДокументаMobileSMARTS",		СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("ТипИсходногоДокумента",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ТипРезультирующегоДокумента",	СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Узел",							СтрокаУзел);
			Иначе
				Настройка.Вставить("Id",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Name",							СтрокаНастройки.Название);
				Настройка.Вставить("MSDocumentType",				СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("SourceDocumentType",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ResultDocumentType",			СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Description",					СтрокаНастройки.Комментарий);
				Настройка.Вставить("Nodes",							СтрокаУзел);
			КонецЕсли;
		    ТаблицаДляВыгрузки.Добавить(Настройка);
			
		КонецЦикла; // Для каждого СтрокаУзел ИЗ МассивУзлов
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки);
	
	Если ID_Узла = "" 
		И МассивУзловЧастныхБаз.Количество() > 0 Тогда // Будем выгружать таблицу БП в частные базы только если не выбран никакой ТО, чтоб лишний раз не гонять данные
		Для Каждого ИдУзла Из МассивУзловЧастныхБаз Цикл
			_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ИдУзла); 
			_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, "Частная");	
		КонецЦикла;
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла("");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбновитьНастройкиMobileSMARTS()
	
	ПараметрыПодключенияMS = _ЛокКонтекст.ПараметрыПодключенияMS;
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");
	КонецЕсли;
		
	ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), ПараметрыПодключенияMS.Ид, "");
		ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	КонецЕсли;
	
	Если ПустаяСтрока(ИдентификаторБазыMS) Тогда
		Сообщение = НСтр("be = 'Не ўдалося вызначыць ідэнтыфікатар падключанай базы Cleverence!'; en = 'Failed to determine the identifier of the connected Cleverence database!'; es = 'No se pudo determinar el identificador de la base de datos conectada de Cleverence!'; ka = 'დაკვირვების იდენტიფიკატორი არ მოხდა კლევერენსის დაკვირვების ბაზაში!'; kk = 'Cleverence базасының айырмашылықты анықтау мүмкін емес!'; ro = 'Nu s-a putut determina identificatorul bazei de date Cleverence conectate!'; ru = 'Не удалось определить идентификатор подключенной базы Клеверенс!'; tr = 'Bağlı Cleverence veritabanı kimliği belirlenemedi!'; uk = 'Не вдалося визначити ідентифікатор підключеної бази Cleverence!'; uz = 'Уланган Cleverence базаси идентификаторини топиш мумкин эмас!'");
		Сообщить(Сообщение); 
		Возврат;		
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS);
	
	_ЛокКонтекст.ЛокЯдро_Инициализация(ПараметрыПодключенияMS);
	
	_ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();

КонецПроцедуры

&НаСервере
Функция ЛокЯдро_СтрНайтиНаСервере(Строка, ПодстрокаПоиска, НаправлениеПоиска = Неопределено, НачальнаяПозиция = Неопределено, НомерВхождения = 1) Экспорт
	Результат = 0;
	
	// НаправлениеПоиска: СКонца,СНачала. По умолчанию: СНачала
	Если Строка = "" и ПодстрокаПоиска = "" Тогда
		// чтобы отрабатывало как в платформе
		Если НаправлениеПоиска = "СКонца" Тогда
			Если НомерВхождения = 1 Тогда
				Возврат 1;
			Иначе
				Возврат 0;
			КонецЕсли;
		Иначе
			Возврат мин(НомерВхождения, ?(НачальнаяПозиция=Неопределено, 1, НачальнаяПозиция));
		КонецЕсли;
	КонецЕсли;
	
	Если НачальнаяПозиция = Неопределено Тогда
		Если НаправлениеПоиска = "СКонца" Тогда
			лНачальнаяПозиция = СтрДлина(Строка);
		Иначе
			лНачальнаяПозиция = 1;
		КонецЕсли;
	Иначе
		лНачальнаяПозиция = НачальнаяПозиция;
	КонецЕсли;
	
	Если НаправлениеПоиска = "СКонца" Тогда
		лСтрока = "";
		Для сч = 1 По СтрДлина(Строка) Цикл
			лСтрока = Сред(Строка, сч, 1) + лСтрока;
		КонецЦикла;
		лПодстрокаПоиска = "";
		Для сч = 1 По СтрДлина(ПодстрокаПоиска) Цикл
			лПодстрокаПоиска = Сред(ПодстрокаПоиска, сч, 1) + лПодстрокаПоиска;
		КонецЦикла;
		лНачальнаяПозиция = макс(1, СтрДлина(Строка)-лНачальнаяПозиция-СтрДлина(ПодстрокаПоиска)+2);
	Иначе
		лСтрока = Строка;
		лПодстрокаПоиска = ПодстрокаПоиска;
		лНачальнаяПозиция = лНачальнаяПозиция;
	КонецЕсли;
	
	лНомерВхождения = 0;
	Результат = Найти(Сред(лСтрока, лНачальнаяПозиция), лПодстрокаПоиска);
	Пока Результат Цикл
		лНачальнаяПозиция = Результат + лНачальнаяПозиция + СтрДлина(ПодстрокаПоиска)-1;
		лНомерВхождения = лНомерВхождения + 1;
		Если лНомерВхождения = НомерВхождения Тогда
			Прервать;
		КонецЕсли;
		Результат = Найти(Сред(лСтрока, лНачальнаяПозиция), лПодстрокаПоиска);
	КонецЦикла;
	
	Если лНомерВхождения = НомерВхождения Тогда
		Результат = лНачальнаяПозиция - СтрДлина(ПодстрокаПоиска);
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Если НаправлениеПоиска = "СКонца" И Результат<>0 Тогда
		Результат = СтрДлина(Строка) - Результат - СтрДлина(ПодстрокаПоиска) + 2;
	КонецЕсли;
	
	Возврат Результат;        
			
КонецФункции


