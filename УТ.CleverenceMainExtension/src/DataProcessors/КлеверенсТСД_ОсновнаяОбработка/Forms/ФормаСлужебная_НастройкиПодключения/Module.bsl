		_ЛокКонтекст.ЛокЯдро_ОбновитьПараметрыПодключения1С(Истина, Компонента);
		ВыгрузитьБизнесПроцессы();
		
		// Попытка на случай, если окно настроек подключения открыто не из главной формы
