&НаКлиенте
Процедура ОчиститьДанныеАвторизации()

	АвторизацияВключена 	= Ложь;
	АвторизацияТокен 		= "";
	АвторизацияРефрешТокен 	= "";
	АвторизацияТип			= Неопределено;
	
	// Если введено несколько строк подключения, очищаем данные авторизации по каждой из них
	Если Найти(СтрокаПодключенияСМАРТС, "|") Тогда
		МассивПараметров = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПодключенияСМАРТС, "|");
	Иначе
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить(СтрокаПодключенияСМАРТС);
	КонецЕсли;
	
	Для каждого пПараметр ИЗ МассивПараметров Цикл
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(пПараметр);
		
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("API_session_" + СтрЗаменить(СтрЗаменить(СтруктураURI.Хост, ".", "_"), "-", "_") + "_" + Формат(СтруктураURI.Порт, "ЧГ=") + "_" + СтрЗаменить(СтруктураURI.ПутьНаСервере, "-", ""), Неопределено);
	КонецЦикла;
	
	// Если был редирект, также нужно очистить данные авторизации для нового адреса, а также сам новый адрес
	Location = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("Location");
	Если ЗначениеЗаполнено(Location) И НЕ Location = Ложь Тогда
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(Location);
		
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("Location", Неопределено);
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("API_session_" + СтрЗаменить(СтрЗаменить(СтруктураURI.Хост, ".", "_"), "-", "_") + "_" + Формат(СтруктураURI.Порт, "ЧГ=") + "_" + СтрЗаменить(СтруктураURI.ПутьНаСервере, "-", ""), Неопределено);
	КонецЕсли;
	
КонецПроцедуры

