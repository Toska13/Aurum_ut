		Сообщение = НСтр("ru = 'Ошибка инициализации базы Клеверенс.'; en = 'Cleverence database initialization error.'; kk = 'Cleverence базасының інициализациясында қате.'; uz = 'Cleverence bazasini boshlashda xatolik.'; be = 'Памылка ініцыялізацыі базы Cleverence.'; uk = 'Помилка ініціалізації бази Cleverence.'; ka = 'Cleverence ბაზის ინიციალიზაციის შეცდომა'; tr = 'Cleverence veritabanı başlatma hatası.'; es = 'Error de inicialización de la base de datos de Cleverence.'; ro = 'Eroare la inițializarea bazei de date Cleverence.'");
