&НаКлиенте
Процедура ОткрытьИнформациюОСтрокеПодключения(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИнформацияСсылка = "https://www.cleverence.ru/support/97039/";
	
	// В ОФ используем ЗапуститьПриложение, т.к. данная форма открыта модально, 
	// и при использовании НачатьЗапускПриложения ссылка не откроется, пока не закроется данная форма
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЗапуститьПриложение(ИнформацияСсылка);	
	#Иначе	
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьИнформациюОСтрокеПодключенияЗавершение", ЭтаФорма);
		НачатьЗапускПриложения(ОписаниеОповещения, ИнформацияСсылка);
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтрокуПодключенияSMARTS(ОписаниеОповещения = Неопределено)
	
	ИмяСобытия = "ВыбратьСтрокуПодключенияSMARTS";
	
	Если НЕ Найти(СтрокаПодключенияСМАРТС, "|") Тогда
		Если ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
		
	ТипИнтерфейса = "REST_API"; // Если введено несколько строк подключения, к каждой из них будем пытаться подключиться по REST_API
	
	МассивПараметров = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПодключенияСМАРТС, "|");
	
	Если ВыборСтроки_Индекс > МассивПараметров.Количество() - 1 Тогда
		ВыборСтроки_Индекс = 0;
		
		Если ВыборСтроки_Компонента = "НаКлиенте" Тогда
			ОчиститьДанныеАвторизации();
			
			// Если ни по одной строке подключиться не удалось, оставляем первую
			СтрокаПодключенияСМАРТС = МассивПараметров[0];	
			
			_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", "Не удалось выбрать строку подключения. Используется первая строка: " + СокрЛП(СтрокаПодключенияСМАРТС));
			Если ОписаниеОповещения <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
			КонецЕсли;
			Возврат;
		Иначе
			// Повторяем обход строк подключения на клиенте
			ВыборСтроки_Компонента = "НаКлиенте";
		КонецЕсли;
	КонецЕсли;
	
	пПараметр = МассивПараметров[ВыборСтроки_Индекс];
	
	СтруктураПодключения = ПолучитьСтруктуруПараметровПодключения(ВыборСтроки_Компонента, пПараметр);
	
	// Авторизоваться необходимо заново
	СтруктураПодключения.Вставить("АвторизацияВключена", 	 Ложь);
	СтруктураПодключения.Вставить("АвторизацияТокен",		 "");
	СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 "");
	СтруктураПодключения.Вставить("АвторизацияТип",			 Неопределено);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОписаниеОповещения",	  ОписаниеОповещения);
	ДопПараметры.Вставить("СтруктураПодключения", СтруктураПодключения);
	ОП = Новый ОписаниеОповещения("ВыбратьСтрокуПодключенияSMARTS_ПослеПроверкиСоединения", ЭтаФорма, ДопПараметры);
	
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СтруктураПодключения, Истина, "Временная", ВыборСтроки_Компонента, Ложь, Ложь, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтрокуПодключенияSMARTS_ПослеПроверкиСоединения(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Истина Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ОписаниеОповещения",	  ДополнительныеПараметры.ОписаниеОповещения);
		ДопПараметры.Вставить("СтруктураПодключения", ДополнительныеПараметры.СтруктураПодключения);
		ОП = Новый ОписаниеОповещения("ВыбратьСтрокуПодключенияSMARTS_ПослеПроверкиСовместимостиПлатформы", ЭтаФорма, ДопПараметры);
		
		_ЛокКонтекст.ЛокЯдро_ПроверитьСовместимостьПлатформы(ДополнительныеПараметры.СтруктураПодключения, ВыборСтроки_Компонента, ОП);
	Иначе
		// Продолжаем обход строк подключения
		ВыборСтроки_Индекс = ВыборСтроки_Индекс + 1;
		
		ВыбратьСтрокуПодключенияSMARTS(ДополнительныеПараметры.ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтрокуПодключенияSMARTS_ПослеПроверкиСовместимостиПлатформы(Результат, ДополнительныеПараметры) Экспорт

	ИмяСобытия = "ВыбратьСтрокуПодключенияSMARTS_ПослеПроверкиСовместимостиПлатформы";
	
	Если Результат = Истина Тогда
		ОчиститьДанныеАвторизации();
		
		СтрокаПодключенияСМАРТС = ДополнительныеПараметры.СтруктураПодключения.СтрокаПодключенияСМАРТС;
		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", "Выбрана строка подключения: " + СокрЛП(СтрокаПодключенияСМАРТС));
	Иначе
		// Продолжаем обход строк подключения
		ВыборСтроки_Индекс = ВыборСтроки_Индекс + 1;
	КонецЕсли;

    ВыбратьСтрокуПодключенияSMARTS(ДополнительныеПараметры.ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

