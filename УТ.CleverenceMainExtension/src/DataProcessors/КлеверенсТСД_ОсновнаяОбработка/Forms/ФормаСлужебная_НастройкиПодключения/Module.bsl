// Сохраняет в кэш настройки базы
// 
// Параметры:
// 	ПараметрыПодключения - Структура - Структура с параметрами базы
//	ПроверяемаяКомпонента - Строка - компонента, для которой необходимо получить настройки
// Возвращаемое значение:
// 	Булево - Если удачно сохранили, то Истина иначе Ложь
&НаКлиенте
Функция СохранитьПараметрыПодключенияВКэш(пПараметрыПодключения, ПроверяемаяКомпонента = Неопределено)
	
	Результат = Ложь;
	
	Если ПроверяемаяКомпонента = Неопределено Тогда
		ПроверяемаяКомпонента = Компонента;
	КонецЕсли;
	
	пПараметрыПодключения = _ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеБазыSMARTS(ПроверяемаяКомпонента,"Временная",ТипИнтерфейса);
	
	Если пПараметрыПодключения <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура СохранитьНастройкиПодключения(ОписаниеОповещения)

    ДопПараметры = Новый Структура("ОписаниеОповещения", ОписаниеОповещения);
	ОП = Новый ОписаниеОповещения("СохранитьНастройкиПодключенияПослеПроверкиДоступностиБазыMS", ЭтаФорма, ДопПараметры);
	
	ПроверитьДоступностьБазыMS(Истина, ОП);	
	
КонецПроцедуры

// Проверяет корректность выбранной базы, получает и сохраняет настройки подключения к базе SMARTS
// 
// Параметры:
// Возвращаемое значение:
// 	Булево - Результат сохранения
&НаКлиенте 
Процедура СохранитьНастройкиПодключенияПослеПроверкиДоступностиБазыMS(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = ДополнительныеПараметры.ОписаниеОповещения;
	
	ПараметрыПодключенияНаСервере = Новый Структура; 
	Если Результат = Ложь
		ИЛИ НЕ СохранитьПараметрыПодключенияВКэш(ПараметрыПодключенияНаСервере) Тогда
		Сообщение = НСтр("be = 'З выбранай базай адсутнічае злучэнне.'; en = 'No connection to the selected database.'; es = 'No hay conexión con la base de datos seleccionada.'; ka = 'არჩეულ ბაზას კავშირი არ არსებობს.'; kk = 'Таңдалған базаға байланыс жоқ.  '; ro = 'Lipsa conexiunii cu baza de date selectată.'; ru = 'С выбранной базой отсутствует соединение.'; tr = 'Seçilen Veritabanıyla Bağlantı Yok.'; uk = ""З обраною базою відсутнє з'єднання.""; uz = ""Tanlangan bazadan ulanish yo'q.  """);
		Сообщить(Сообщение); 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"РаботаССерверомБазаНедоступна", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		Если ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Ложь);		
		КонецЕсли;
		
		Возврат;
	КонецЕсли; 
	
	// Запоминаем, что выполнена авторизация по темпуид
	Если АвторизацияВключена = Истина Тогда
		Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ПараметрыПодключенияНаСервере["СтрокаПодключения"], "tempuid") Тогда
			ПараметрыПодключенияНаСервере.Вставить("АвторизацияТип", "tempuid")
		Иначе
			ПараметрыПодключенияНаСервере.Вставить("АвторизацияТип", "login")
		КонецЕсли;
	КонецЕсли;
	
	// Очищаем из сохраняемой строки подключения дополнительные параметры, введенные в поле ввода
	РедактируемыеПоля = Новый Массив;
	РедактируемыеПоля.Добавить("СтрокаПодключения");
	РедактируемыеПоля.Добавить("СтрокаПодключенияСМАРТС");
	Для каждого РедактируемоеПоле ИЗ РедактируемыеПоля Цикл
		ПозицияСтрокиПоиска = _ЛокКонтекст.ЛокЯдро_СтрНайти(ПараметрыПодключенияНаСервере[РедактируемоеПоле], "?");
		Если ПозицияСтрокиПоиска Тогда
			ПараметрыПодключенияНаСервере[РедактируемоеПоле] = Лев(ПараметрыПодключенияНаСервере[РедактируемоеПоле], ПозицияСтрокиПоиска - 1);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураПодключения = Новый Структура;
	
	Если РежимВыбораБазы = "СтрокаПодключения" Тогда
		СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",	СтрокаПодключенияСМАРТС);
		СтруктураПодключения.Вставить("IdBaseSMARTS",				Неопределено);	
	Иначе
		СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",	Неопределено);
		СтруктураПодключения.Вставить("IdBaseSMARTS",				БазаСМАРТС);
	КонецЕсли;
	
	СтруктураПодключения.Вставить("РасположениеКомпоненты",			Компонента);
	СтруктураПодключения.Вставить("АвторизацияВключена",			АвторизацияВключена);
	СтруктураПодключения.Вставить("АвторизацияТокен",				АвторизацияТокен);
	СтруктураПодключения.Вставить("АвторизацияРефрешТокен",			АвторизацияРефрешТокен);
	СтруктураПодключения.Вставить("АвторизацияТип",					АвторизацияТип);
	СтруктураПодключения.Вставить("ТипИнтерфейса",					ТипИнтерфейса);
	
	ЗаполнитьЗначенияСвойств(ПараметрыПодключенияНаСервере, СтруктураПодключения, "АвторизацияВключена, АвторизацияТокен, АвторизацияРефрешТокен, АвторизацияТип");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОписаниеОповещения", 			ОписаниеОповещения);
	ДопПараметры.Вставить("ПараметрыПодключенияНаСервере", 	ПараметрыПодключенияНаСервере);
	ОП = Новый ОписаниеОповещения("СохранитьНастройкиПодключенияПослеПодключенияКБазеSMARTS", ЭтаФорма, ДопПараметры);
		
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СтруктураПодключения, Ложь, "Временная", Компонента,, Истина, ОП);
		
КонецПроцедуры 

&НаКлиенте
Процедура СохранитьНастройкиПодключенияПослеПодключенияКБазеSMARTS(ЕстьСоединение, ДопПараметры) Экспорт
	
	ИмяСобытия = "СохранитьНастройкиПодключенияПослеПодключенияКБазеSMARTS";
	
	Результат = Ложь;
	
	Если ЕстьСоединение = Истина Тогда
		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", "Выполнено подключение по строке: " + СокрЛП(СтрокаПодключенияСМАРТС));
		
		Если ТипБазы = "Основная" Тогда
			Если ЗначениеЗаполнено(ИдБазыСМАРТС) Тогда
				_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройки(ИдБазыСМАРТС);
			КонецЕсли;
			
			_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПараметрыПодключенияMS", ДопПараметры.ПараметрыПодключенияНаСервере);
			_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_РасположениеКомпоненты", Компонента);
			_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_РежимВыбораБазы", 		  РежимВыбораБазы);
			_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ТипИнтерфейса", 		  ТипИнтерфейса);
			
			_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("РасположениеКомпоненты",			  Компонента);
			_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса",					  ТипИнтерфейса);
			_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS",			  ДопПараметры.ПараметрыПодключенияНаСервере);
			
			ОП = Новый ОписаниеОповещения("СохранитьНастройкиПодключенияПослеПодключенияОсновнойКБазеSMARTS", ЭтаФорма, ДопПараметры);

            _ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ДопПараметры.ПараметрыПодключенияНаСервере, Истина, "Основная", Компонента, Истина, Истина, ОП);
			
			Возврат;
		ИначеЕсли ТипБазы = "Частная" Тогда
			Результат = Истина;
			СтруктураПоиска = Новый Структура("ЧастнаяБазаMS", Неопределено);
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВладелецФормы);
			// Настройки подключения могут открываться не только из формы настроек узла (в которой имеется реквизит "Частная база Клеверенс"), поэтому проверяем это
			Если СтруктураПоиска.ЧастнаяБазаMS <> Неопределено Тогда
				ВладелецФормы.ЧастнаяБазаMS 			= ДопПараметры.ПараметрыПодключенияНаСервере;
				ВладелецФормы.РасположениеКомпонентыЧБ 	= Компонента;
				ВладелецФормы.РежимВыбораБазыЧБ 		= РежимВыбораБазы;
				ВладелецФормы.НаименованиеЧБ 			= ИмяБазыСМАРТС;
				ВладелецФормы.ТипИнтерфейсаЧБ 			= ТипИнтерфейса;
			КонецЕсли;
		Иначе
			Результат = Истина;
		КонецЕсли;
	Иначе
		Сообщение = НСтр("be = 'З выбранай базай адсутнічае злучэнне.'; en = 'No connection to the selected database.'; es = 'No hay conexión con la base de datos seleccionada.'; ka = 'არჩეულ ბაზას კავშირი არ არსებობს.'; kk = 'Таңдалған базаға байланыс жоқ.  '; ro = 'Lipsa conexiunii cu baza de date selectată.'; ru = 'С выбранной базой отсутствует соединение.'; tr = 'Seçilen Veritabanıyla Bağlantı Yok.'; uk = ""З обраною базою відсутнє з'єднання.""; uz = ""Tanlangan bazadan ulanish yo'q.  """);
		Сообщить(Сообщение); 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"РаботаССерверомБазаНедоступна", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		Если ДопПараметры.ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДопПараметры.ОписаниеОповещения,Ложь);		
		КонецЕсли;
		
		Возврат;
	КонецЕсли;

	Оповестить("УстановленыНастройкиПодключения",,ЭтаФорма);
	
	Если ДопПараметры.ОписаниеОповещения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДопПараметры.ОписаниеОповещения,Истина);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиПодключенияПослеПодключенияОсновнойКБазеSMARTS(ЕстьСоединение,ДопПараметры) Экспорт
	
	Результат = Ложь;
	
	ДопПараметры.Вставить("ЕстьСоединение", ЕстьСоединение);
	
	Если ЕстьСоединение = Истина Тогда
		Если ДоступноВыполнениеВФоне И
			Компонента = "НаСервере" Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"СохранитьНастройкиПодключенияПослеПодключенияОсновнойКБазеSMARTSЗавершение", ЭтаФорма, ДопПараметры);
		КонецЕсли;
		
		//ПодключитьИнтеграционнуюОбработкуПослеПодключенияКОсновнойБазеSMARTS(Истина, ДопПараметры.ПараметрыПодключенияНаСервере);
		
		_ЛокКонтекст.ЛокЯдро_Инициализация(ДопПараметры.ПараметрыПодключенияНаСервере, ОписаниеОповещения);
		
		// Запрещаем фоновую инициализацию, т.к. при ее завершении возможны ошибки из-за обновления основной обработки в справочнике доп. обработок
		//_ЛокКонтекст.ДоступноВыполнениеВФоне = Ложь;
		//_ЛокКонтекст.ЛокЯдро_Инициализация(ДопПараметры.ПараметрыПодключенияНаСервере);
		//_ЛокКонтекст.ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне;
	Иначе
		Сообщение = НСтр("be = 'З выбранай базай адсутнічае злучэнне.'; en = 'No connection to the selected database.'; es = 'No hay conexión con la base de datos seleccionada.'; ka = 'არჩეულ ბაზას კავშირი არ არსებობს.'; kk = 'Таңдалған базаға байланыс жоқ.  '; ro = 'Lipsa conexiunii cu baza de date selectată.'; ru = 'С выбранной базой отсутствует соединение.'; tr = 'Seçilen Veritabanıyla Bağlantı Yok.'; uk = ""З обраною базою відсутнє з'єднання.""; uz = ""Tanlangan bazadan ulanish yo'q.  """);
		Сообщить(Сообщение); 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"РаботаССерверомБазаНедоступна", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		Если ДопПараметры.ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДопПараметры.ОписаниеОповещения,Ложь);		
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если Не ДоступноВыполнениеВФоне Или
		Компонента = "НаКлиенте" Тогда
		СохранитьНастройкиПодключенияПослеПодключенияОсновнойКБазеSMARTSЗавершение(, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

