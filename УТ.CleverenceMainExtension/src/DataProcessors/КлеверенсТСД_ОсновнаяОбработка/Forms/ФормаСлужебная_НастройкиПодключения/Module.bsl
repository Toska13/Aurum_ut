			ВладелецФормы.ID_ТекущейБазы = ИдБазыСмартс;
		Исключение
			//
		КонецПопытки;
		
		ДоступностьОнлайнРежима = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОнлайнРежима(ДопПараметры.ПараметрыПодключенияНаСервере, _ЛокКонтекст.РасположениеКомпоненты);
		
		// Обновление интеграционной обработки и расширений
		ПараметрыОбновленияКомпонентов = Новый Структура("ПроверятьВерсииПриПервомЗапуске", Истина);		
		_ЛокКонтекст.ЛокЯдро_ОбновитьКомпонентыИзПодключеннойБазы(Истина, Ложь, ПараметрыОбновленияКомпонентов);
		ПодключитьИнтеграционнуюОбработкуПослеПодключенияКОсновнойБазеSMARTS(Истина);
		//Оповестить("ПодключеныРасширенияКонфигурации",, ЭтаФорма);
		
		//_ЛокКонтекст.ЛокЯдро_ОбновитьКомпонентыИзПодключеннойБазы(Истина, Истина, ПараметрыОбновленияКомпонентов);
		//Попытка
		//	// Для проверки того, была ли обновлена основная обработка, делаем произвольный серверный вызов
		//	ТекущаяДата = _ЛокКонтекст.ЛокЯдро_ПолучитьТекущуюДатуНаСервере();
		//Исключение
		//	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
		//		"АктуализированаОсновнаяОбработка", 
		//		"", 
		//		"ПодключениеКБазеSMARTS");
		//	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		//	
		//	Если ДопПараметры.ОписаниеОповещения <> Неопределено Тогда
		//		ВыполнитьОбработкуОповещения(ДопПараметры.ОписаниеОповещения, Истина);		
		//	КонецЕсли;
		//	
		//	Возврат;
		//КонецПопытки;
	КонецЕсли;
	
	Если ДоступностьОнлайнРежима Тогда
		Оповестить("УстановленыНастройкиПодключения",, ЭтаФорма);
	КонецЕсли;
	
	Если ДопПараметры.ОписаниеОповещения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДопПараметры.ОписаниеОповещения, Истина);
