// Находит в списке баз SMARTS, текущую базу и заполняет форму параметрами
//
// Параметры:
&НаКлиенте
Процедура ЗаполнитьПараметрыПодключеннойБазыSMARTS(ОписаниеОповещения = Неопределено)

	СтруктураПодключения = ПолучитьСтруктуруПараметровПодключения();
	
	ПодключениеДоступно = Ложь; // Сбрасываем признак доступности подключения
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	ОП = Новый ОписаниеОповещения("ЗаполнитьПараметрыПодключеннойБазыSMARTSЗавершение", ЭтаФорма, ДопПараметры);
	
	//НеПроверятьАвторизацию = Ложь;
	//Если ЭтоВебКлиент ИЛИ ЭтоФреш Тогда
	//	// В веб-клиенте используется тип интерфейса REST_API, при котором не требуется авторизация для получения информации о базе SMARTS BaseInfo
	//	НеПроверятьАвторизацию = Истина;
	//КонецЕсли;
	
	// В случае, если мы переподключаемся к той же базе Клеверенс, настройки подключения к которой хранятся в хранилище настроек пользователя,
	//	то не нужно использовать токены из сохраненных настроек подключения, т.к. в противном случае мы не получим информации, включена авторизация
	//	в базе Клеверенс или нет (проверочные запросы вернут ответ 200, а не 401)
	СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С");
	
	_ЛокКонтекст.ЛокЯдро_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Истина, "Временная", Компонента, Истина, ОП, Ложь);

КонецПроцедуры

// Получает структуру параметров подключения
//
// Параметры:
//	ПроверяемаяКомпонента - Строка - значение компоненты
//
// Возвращаемое значение:
// 	Структура - структура параметров подключения
&НаКлиенте
Функция ПолучитьСтруктуруПараметровПодключения(ПроверяемаяКомпонента = Неопределено, ПроверяемаяСтрокаПодключения = Неопределено)
	
	Если ПроверяемаяКомпонента = Неопределено Тогда
		ПроверяемаяКомпонента = Компонента;
	КонецЕсли;
	Если ПроверяемаяСтрокаПодключения = Неопределено Тогда
		ПроверяемаяСтрокаПодключения = СтрокаПодключенияСМАРТС;
	КонецЕсли;	
	
    СтруктураПодключения = Новый Структура;
	
	Если РежимВыбораБазы = "СтрокаПодключения" Тогда
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(ПроверяемаяСтрокаПодключения);
		
		СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС", ПроверяемаяСтрокаПодключения);
		СтруктураПодключения.Вставить("IdBaseSMARTS",			 Неопределено);
		СтруктураПодключения.Вставить("TempUid",				 СтруктураURI.TempUid);
	Иначе
		СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС", Неопределено);
		СтруктураПодключения.Вставить("IdBaseSMARTS",			 БазаСМАРТС);
	КонецЕсли;
	
	СтруктураПодключения.Вставить("РасположениеКомпоненты",	 ПроверяемаяКомпонента);
	СтруктураПодключения.Вставить("ТипИнтерфейса",			 ТипИнтерфейса);
	СтруктураПодключения.Вставить("ТипБазы",				 "Временная");
	СтруктураПодключения.Вставить("СохранятьАвторизацию",	 Ложь);
	
	СтруктураПодключения.Вставить("АвторизацияВключена", 	 АвторизацияВключена);
	СтруктураПодключения.Вставить("АвторизацияТокен",		 АвторизацияТокен);
	СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 АвторизацияРефрешТокен);
	СтруктураПодключения.Вставить("АвторизацияТип",			 АвторизацияТип);
	
	Возврат СтруктураПодключения;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьПараметрыПодключеннойБазыSMARTSЗавершение(ЕстьПодключение, ДопПараметры) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура")
		И ДопПараметры.Свойство("ОписаниеОповещения") Тогда
		ОписаниеОповещения = ДопПараметры.ОписаниеОповещения;
	Иначе
		ОписаниеОповещения = Неопределено;
	КонецЕсли;
	
	ПолучитьПризнакДоступностиПодключения(ЕстьПодключение, ДопПараметры);
	Если НЕ ЕстьПодключение = Истина Тогда
		Если ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	СтрокаПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеБазыSMARTS(Компонента,?(ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("ТипБазы"),ДопПараметры.ТипБазы,"Временная"),ТипИнтерфейса);
	
	Если СтрокаПараметров <> Неопределено Тогда
		ИдБазыСмартс 			= СтрокаПараметров.Ид;
		ИмяБазыСМАРТС 			= СтрокаПараметров.Имя;
		СтрокаПодключенияСМАРТС = СтрокаПараметров.СтрокаПодключения;
		ИдПриложения 			= СтрокаПараметров.ИдПриложения;
		ИмяПриложения 			= СтрокаПараметров.ИмяПриложения;
		Комментарий 			= СтрокаПараметров.Комментарий;
		РабочийКаталог 			= СтрокаПараметров.РабочийКаталог;
		ПапкаОбмена 			= СтрокаПараметров.ПапкаОбмена;
		
		Если СтрокаПараметров.РаботаСУстройствомНапрямую Тогда
			РежимРаботы = "Работа с устройством напрямую";
		ИначеЕсли СтрокаПараметров.РаботаСКаталогом Тогда
			РежимРаботы = "Работа с каталогом";
		ИначеЕсли СтрокаПараметров.РаботаССервером Тогда
			РежимРаботы = "Работа с сервером";
		ИначеЕсли СтрокаПараметров.РаботаСЛокальнымСервером Тогда
			РежимРаботы = "Работа с локальным сервером";
		ИначеЕсли СтрокаПараметров.РаботаСУдаленнымСервером Тогда
			РежимРаботы = "Работа с удаленным сервером";
		КонецЕсли;
		
		ИмяИнтеграционнойОбработки 	= СтрокаПараметров.ИмяИнтеграционнойОбработки;
		ПутьИнтеграционнойОбработки = СтрокаПараметров.ПутьИнтеграционнойОбработки;
		
		пЭлементы.ПапкаОбмена.Доступность = СтрокаПараметров.РаботаСКаталогом;
		
		АвторизацияВключена    = СтрокаПараметров.АвторизацияВключена;
		АвторизацияТокен 	   = СтрокаПараметров.АвторизацияТокен;
		АвторизацияРефрешТокен = СтрокаПараметров.АвторизацияРефрешТокен;
		АвторизацияТип		   = СтрокаПараметров.АвторизацияТип;
	КонецЕсли;
	
	Если ОписаниеОповещения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

// Очищает и  заполняет параметры базы на форме 
// 
// Параметры:
&НаКлиенте 
Процедура ЗаполнитьПараметрыПодключеннойБазыСмартс(ОписаниеОповещения = Неопределено)
	
	ИдБазыСмартс   			= "";
	ИмяБазыСМАРТС  			= "";
	//СтрокаПодключенияСМАРТС = "";
	ИдПриложения  			= "";
	ИмяПриложения  			= "";
	Комментарий    			= "";
	РабочийКаталог 			= "";
	ПапкаОбмена	   			= "";
	РежимРаботы    			= "Не получилось определить...";
	
	пЭлементы.ПапкаОбмена.Доступность		 = Ложь;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		пЭлементы.ГруппаИнформацияОВыбраннойБазе.Видимость = Ложь;
	#КонецЕсли

	Если (РежимВыбораБазы = "СтрокаПодключения" И НЕ ЗначениеЗаполнено(СтрокаПодключенияСМАРТС))
		ИЛИ (РежимВыбораБазы = "ИзСписка" И НЕ ЗначениеЗаполнено(БазаСМАРТС)) Тогда
		ПодключениеДоступно 	= Ложь; // Сбрасываем признак доступности подключения
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьПараметрыПодключеннойБазыSMARTS(ОписаниеОповещения);
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		пЭлементы.ГруппаИнформацияОВыбраннойБазе.Видимость = ПодключениеДоступно;
	#КонецЕсли
	
КонецПроцедуры

// Проверяет доступность базы Клеверенс с сервера/клиента
//
&НаКлиенте
Процедура ПроверитьДоступностьБазыMS(ПереключатьсяНаСервер = Ложь, ОписаниеОповещения = Неопределено)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ПереключатьсяНаСервер", ПереключатьсяНаСервер);
	ДопПараметры.Вставить("ОписаниеОповещения",	   ОписаниеОповещения);
	ОписаниеОповещенияВыборСтроки = Новый ОписаниеОповещения("ПроверитьДоступностьБазыMSПослеВыбораСтроки", ЭтаФорма, ДопПараметры);
	
	// Будем перебирать все строки, пока не подключимся, с сервера и с клиента
	ВыборСтроки_Индекс	   = 0;
	ВыборСтроки_Компонента = "НаСервере";
	
	ВыбратьСтрокуПодключенияSMARTS(ОписаниеОповещенияВыборСтроки);
	
КонецПроцедуры
	
// Проверяет доступность базы Клеверенс с сервера/клиента
//
&НаКлиенте
Процедура ПроверитьДоступностьБазыMSПослеВыбораСтроки(РезультатВыбора, ДопПараметры) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ПереключатьсяНаСервер = ДопПараметры.ПереключатьсяНаСервер;	
		ОписаниеОповещения	  = ДопПараметры.ОписаниеОповещения;
	Иначе		
		ПереключатьсяНаСервер = Ложь;	
		ОписаниеОповещения 	  = Неопределено;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Для ОФ не выполняем проверку доступности, т.к. проверка доступности базы некорректно работает на сервере
		// Например, при прямом подключении базы Клеверенс отображается, что с сервера доступно подключение, хотя это не так из-за особенности работы толстого клиента
		ЗаполнитьПараметрыПодключеннойБазыСмартс(ОписаниеОповещения);
		Возврат;		
	#КонецЕсли
	
	СтруктураДоступностиПодключения = Новый Структура;
	
	СообщениеПроверки_Доступно 		= ?(Не ЭтоВебКлиент, Символы.ПС, "") + " (Доступно)";	
	СообщениеПроверки_Недоступно 	= ?(Не ЭтоВебКлиент, Символы.ПС, "") + " (Недоступно)";
		
	СписокРедактируемыхЭлементов = пЭлементы.Компонента.СписокВыбора;
	
	Для Каждого РедактируемыйЭлемент Из СписокРедактируемыхЭлементов Цикл
		
		ЗначениеКомпоненты = РедактируемыйЭлемент.Значение;

		Если Компонента = ЗначениеКомпоненты Тогда
			// Если проверяем доступность подключения для текущей компоненты, то необходимо обновить данные подключения на форме
			ЗаполнитьПараметрыПодключеннойБазыСмартс(ОписаниеОповещения);
		ИначеЕсли Не (ЭтоВебКлиент И ЗначениеКомпоненты = "НаКлиенте") Тогда
			// Подключение с веб-клиента недоступно на клиенте, поэтому не проверяем
			
			// Если проверяем доступность подключения для невыбранной компоненты, то нет необходимости обновлять данные подключения на форме
			СтруктураПодключения = ПолучитьСтруктуруПараметровПодключения(ЗначениеКомпоненты);
			ОП = Новый ОписаниеОповещения("ПолучитьПризнакДоступностиПодключения",ЭтаФорма);
			
			ПодключениеДоступно = Ложь; // Сбрасываем признак доступности подключения
			
			_ЛокКонтекст.ЛокЯдро_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Истина, "Временная", ЗначениеКомпоненты, Ложь, ОП, Ложь);
		КонецЕсли;
		
		РезультатПроверки = ПодключениеДоступно;
		
		СтруктураДоступностиПодключения.Вставить(ЗначениеКомпоненты, РезультатПроверки);
		
		Если РезультатПроверки = Истина Тогда
			СообщениеПроверки = СообщениеПроверки_Доступно;
		Иначе
			СообщениеПроверки = СообщениеПроверки_Недоступно;
		КонецЕсли;
		
		// Вывод результата проверки
		Представление = РедактируемыйЭлемент.Представление;
		
		// Удалим из представления результаты предыдущей проверки доступности
		Представление = СтрЗаменить(Представление, СообщениеПроверки_Доступно, "");
		Представление = СтрЗаменить(Представление, СообщениеПроверки_Недоступно, "");
		
		РедактируемыйЭлемент.Представление = Представление + СообщениеПроверки;
		
	КонецЦикла;

	ПодключениеНаСервере = Ложь;
	ПодключениеНаКлиенте = Ложь;
	СтруктураДоступностиПодключения.Свойство("НаСервере", ПодключениеНаСервере);
	СтруктураДоступностиПодключения.Свойство("НаКлиенте", ПодключениеНаКлиенте);
	
	Если ПереключатьсяНаСервер Тогда
		Если Компонента = "НаКлиенте" И
			ТипИнтерфейса = "REST_API" И
			ПодключениеНаСервере Тогда
			// Если подключение доступно с сервера, и выбрана компонента с клиента REST, 
			// то переключаемся на сервер для использования фоновых заданий
			Компонента = "НаСервере";
			Сообщение = НСтр("be = 'Компонента была переключена на сервер для работы фоновых заданий: Кампанента была пераключана на сервер для працы фонавых задач'; en = 'Component switched to server for background tasks'; es = 'El componente se cambió al servidor para tareas en segundo plano'; ka = 'კომპონენტა გადარქმული იყო სერვერზე ფონური დავალებების შესრულებისთვის'; kk = 'Құрамды серверге ауыстыру қажетін себепті жұмыс фонды'; ro = 'Componenta a fost comutată pe server pentru a lucra la sarcinile de fundal'; ru = 'Компонента была переключена на сервер для работы фоновых заданий'; tr = 'Arkaplan görevleri için bileşen sunucuya geçirildi'; uk = 'Компоненту було переключено на сервер для роботи фонових завдань'; uz = 'Фон вазифалар учун серверга компонент ўтказилди'");
			Сообщить(Сообщение); 
		ИначеЕсли Компонента = "НаСервере"
			И НЕ ПодключениеНаСервере
			И ПодключениеНаКлиенте Тогда
			// Если подключение с сервера недоступно, а с клиента - доступно,
			// то переключаемся на клиент
			Компонента = "НаКлиенте";
			ЗаполнитьПараметрыПодключеннойБазыСмартс(ОписаниеОповещения);
			Сообщение = НСтр("be = 'Компонента была переключена на клиент ввиду недоступности подключения с сервера: Кампанента была пераключана на кліента ў выглядзе недаступнасці падлучэння з сервера'; en = 'Component switched to client due to server connection unavailability'; es = 'El componente se cambió al cliente debido a la falta de conexión con el servidor'; ka = 'კომპონენტა გადარქმული იყო კლიენტზე დაკავშირების მიერ სერვერთან დამუშავების შეუძლებლობის გამო'; kk = 'Құрамды клиентке ауыстыру қажетін себепті серверден қосылу мүмкіндігі жоқ'; ro = 'Componenta a fost comutată pe client din cauza indisponibilității conexiunii de la server'; ru = 'Компонента была переключена на клиент ввиду недоступности подключения с сервера'; tr = 'Bileşen, sunucuya bağlantı olmadığı için müşteriye geçirildi'; uk = ""Компоненту було переключено на клієнта у зв'язку з недоступністю підключення з сервера""; uz = 'Клиентга серверга уланиш мавжудлиги сабабли компонент клиентга ўтказилди'");
			Сообщить(Сообщение); 
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЭтоВебКлиент Тогда
		// В веб-клиенте не выводим информацию о доступности онлайн режима, т.к. в веб-клиенте можно работать с компонентой только на сервере
		МассивЭлементовДоступностьОнлайнРежима = Новый Массив;
		МассивЭлементовДоступностьОнлайнРежима.Добавить(пЭлементы.ГруппаДоступностьОнлайнРежима);				
		
		Для Каждого ЭлементДоступностьОнлайнРежима Из МассивЭлементовДоступностьОнлайнРежима Цикл
			// Выводим информацию о недоступности онлайн режима, если нет подключения на сервере, но есть подключение с клиента
			ЭлементДоступностьОнлайнРежима.Видимость = Не ПодключениеНаСервере И ПодключениеНаКлиенте;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПризнакДоступностиПодключения(ЕстьПодключение, ДопПараметры) Экспорт
	
	ПодключениеДоступно = ЕстьПодключение = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьИнтеграционнуюОбработкуПослеПодключенияКОсновнойБазеSMARTS(СерверДоступен) Экспорт
	
	ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");		
	КонецЕсли;	
	
	РезультатПодключенияИнтеграционнойОбработки = Ложь;
	
	// Проверим, нужно ли переключиться на интеграционную обработку из интеграционного расширения
	Если СерверДоступен = Истина Тогда
		ПодключитьИОРасширения = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПодключитьИОРасширения");
		Если ПодключитьИОРасширения = Истина Тогда
			ТипОбработки = ?(ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") И ПараметрыПодключенияMS.Свойство("ТипОбработки"), ПараметрыПодключенияMS.ТипОбработки, "");
			
			Если ТипОбработки = "Встроенная" Тогда
				// Если уже используется встроенная обработка, переключаться на нее не нужно
				_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Ложь);
			Иначе
				СтруктураИменРасширений = _ЛокКонтекст.ЛокЯдро_ПолучитьСтруктуруИменРасширений();
				
				ИнформацияОбИнтеграционномРасширении = _ЛокКонтекст.ЛокЯдро_ПроверитьНаличиеРасширения(СтруктураИменРасширений.ИнтеграционноеРасширение);
				Если ИнформацияОбИнтеграционномРасширении.Активно Тогда
					ИмяИнтеграционнойОбработки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
					Если Найти(ИмяИнтеграционнойОбработки, ".epf") > 0 Тогда
						ИмяИнтеграционнойОбработки = СтрЗаменить(ИмяИнтеграционнойОбработки, ".epf", "");
					КонецЕсли;
					
					Если _ЛокКонтекст.ЛокЯдро_ПроверитьОбъектМетаданныхСуществует("Обработка." + ИмяИнтеграционнойОбработки) Тогда			
						РезультатПодключенияИнтеграционнойОбработки = _ЛокКонтекст.ЛокЯдро_ПереключитьИнтеграционнуюОбработку(Компонента,
							"Встроенная",
						    ИмяИнтеграционнойОбработки,
							ИмяИнтеграционнойОбработки);
						
						Если РезультатПодключенияИнтеграционнойОбработки = Истина Тогда
							_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Ложь);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Если не было принудительного переключения на встроенную обработку, подключаем по сохраненным настройкам
	Если НЕ РезультатПодключенияИнтеграционнойОбработки = Истина Тогда
		РезультатПодключенияИнтеграционнойОбработки = _ЛокКонтекст.ЛокЯдро_ПодключитьИнтеграционнуюОбработку(Компонента);
	КонецЕсли;
	
	//Если интеграционная обработка не подключена, а тип обработки = "СправочникСсылка", то пытаемся заменить обработку на файловый вариант
	//Данный код выполняется после инициализации, т.к. необходима установленная связь с базой Клеверенс, чтобы изменить настройки базы Клеверенс
	Если НЕ РезультатПодключенияИнтеграционнойОбработки = Истина Тогда
		
		//Если СтрокаБазы = Неопределено ИЛИ ТипЗнч(СтрокаБазы) <> Тип("Структура") Тогда
		//	СтрокаБазы = _ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеБазыSMARTS(Компонента);
		//КонецЕсли;
		//
		//СтрокаБазы = _ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеБазыSMARTS(Компонента);
		//
		//ТипОбработки = ?(ТипЗнч(СтрокаБазы) = Тип("Структура") И СтрокаБазы.Свойство("ТипОбработки"), СтрокаБазы.ТипОбработки, "");
		
		ТипОбработки = ?(ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") И ПараметрыПодключенияMS.Свойство("ТипОбработки"), ПараметрыПодключенияMS.ТипОбработки, "");		
		
		Если ТипОбработки = "СправочникСсылка" Тогда
		
			//Имя и путь интеграционной обрабокти по умолчанию
			ТипОбработки 					= "ФайлНаДиске";
			ИмяИнтеграционнойОбработки 		= _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
			ПутьИнтеграционнойОбработки 	= _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С");
			
			ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
			
			//Замена настроек в хранилище 1с
			_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПараметрыПодключенияMS", ПараметрыПодключенияMS);
			_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
			
			//Замена настроек в базе Клеверенс
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ПутьИнтеграционнойОбработки);
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", ТипОбработки);
			
			//Удаление настройки версии интеграционной обработки, т.к. версия хранится только для тип обработки = "СправочникСсылка"
			_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("ВерсияОбработки_ИнтеграционнаяОбработка");
			
		ИначеЕсли ТипОбработки <> "Встроенная" Тогда
			
			// Если интеграционная обработка не подключена, и тип обработки <> "Встроенная", то пытаемся заменить обработку на встроенную в конфигурацию ИО
			// Данный функционал в первую очеред необходим для работы во fresh, т.к. там нет доступа к файлу, а ИО встроена в расширение

			// Имя и путь интеграционной обработки по умолчанию
			ИмяИнтеграционнойОбработки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
			Если Найти(ИмяИнтеграционнойОбработки, ".epf") > 0 Тогда
				ИмяИнтеграционнойОбработки = СтрЗаменить(ИмяИнтеграционнойОбработки, ".epf", "");
			КонецЕсли;
			
			Если _ЛокКонтекст.ЛокЯдро_ПроверитьОбъектМетаданныхСуществует("Обработка." + ИмяИнтеграционнойОбработки) Тогда
				
				// Пытаемся подключить встроенную ИО
				ТипОбработки = "Встроенная";		
				
				ТестовыеПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(ПараметрыПодключенияMS);
				ТестовыеПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
				ТестовыеПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
				ТестовыеПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
				
				РезультатПодключенияИнтеграционнойОбработки = _ЛокКонтекст.ЛокЯдро_ПодключитьИнтеграционнуюОбработку(Компонента, ТестовыеПараметрыПодключенияMS);

				Если РезультатПодключенияИнтеграционнойОбработки Тогда
					// Сохранение настроек
					ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
					ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
					ПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
					
					// Замена настроек в хранилище 1с
					_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПараметрыПодключенияMS", ПараметрыПодключенияMS);
					_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
					
					// Замена настроек в базе Клеверенс
					_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
					_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ИмяИнтеграционнойОбработки);
					_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", ТипОбработки);
					
					// Удаление настройки версии интеграционной обработки, т.к. версия хранится только для тип обработки = "СправочникСсылка"
					_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("ВерсияОбработки_ИнтеграционнаяОбработка");
					
					Сообщение = НСтр("be = 'Тып інтэграцыйнай апрацоўкі заменены на: ""Убудаваная""'; en = 'Integration processing type changed to: ""Embedded""'; es = 'El tipo de procesamiento de integración se ha cambiado a: ""Incorporado""'; ka = 'ინტეგრაციული დამუშავების ტიპი შეცვლილია: ""ჩაშენეული""'; kk = 'Интеграциялық өңдеу түрі ""Жергілікті"" ретінде ауыстырылды'; ro = 'Tipul de proces de integrare a fost schimbat în: ""Încorporat""'; ru = 'Тип интеграционной обработки заменен на: ""Встроенная""'; tr = 'Entegrasyon işleme türü ""Gömülü"" olarak değiştirildi'; uk = 'Тип інтеграційної обробки замінений на: ""Вбудована""'; uz = 'Integratsion qayta ishlash turi ""Ichki"" ga o''zgartirildi'");
					Сообщить(Сообщение);
				КонецЕсли;				
				
			КонецЕсли;			
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипИнтерфейса()
	
	#Область НесовместимыйКодFresh

	СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключенияСМАРТС);
	
	Если Найти(ВРег(СтруктураURI.Схема), "HTTP") <> 0 Тогда
		// Это подключение через Rest
		НовыйТипИнтерфейса = "REST_API";
		ЕстьHttp = Истина;
	Иначе
		НовыйТипИнтерфейса = "COM";
		ЕстьHttp = Ложь;
	КонецЕсли;
	
	Если ТипИнтерфейса <> НовыйТипИнтерфейса Тогда
		ТипИнтерфейса = НовыйТипИнтерфейса;
		Если ЕстьHttp Тогда
			ТекстСообщения = НСтр("be = 'Тып інтэрфейсу быў зменены на %1, т.к. радок падключэння ўтрымлівае http'; en = 'Interface type has been changed to %1 because the connection string contains http'; es = 'El tipo de interfaz se ha cambiado a %1, ya que la cadena de conexión contiene http'; ka = 'ინტერფეისის ტიპი შეცვლილია %1, რადგან კავშირში შეიცავს http'; kk = 'Интерфейс түрі %1-ге өзгертілді, себебі байланыс жолы http-ді қамтиды'; ro = 'Tipul de interfață a fost schimbat în %1, deoarece șirul de conectare conține http'; ru = 'Тип интерфейса был изменен на %1, т.к. строка подключения содержит http'; tr = 'Arayüz türü %1 olarak değiştirildi, çünkü bağlantı dizesi http içeriyor'; uk = 'Тип інтерфейсу був змінений на %1, оскільки рядок підключення містить http'; uz = ""Interfeys turi %1 ga o'zgartirildi, chunki ulanish qatori http ni o'z ichiga oladi""");
		Иначе
			ТекстСообщения = НСтр("be = 'Тып інтэрфейсу быў зменены на %1, т.к. радок падключэння не ўтрымлівае http'; en = 'Interface type has been changed to %1 because the connection string does not contain http'; es = 'El tipo de interfaz se ha cambiado a %1, ya que la cadena de conexión no contiene http'; ka = 'ინტერფეისის ტიპი შეცვლილია %1, რადგან კავშირში არ შეიცავს http'; kk = 'Интерфейс түрі %1-ге өзгертілді, себебі байланыс жолы http-ді қамтиды'; ro = 'Tipul de interfață a fost schimbat în %1, deoarece șirul de conectare nu conține http'; ru = 'Тип интерфейса был изменен на %1, т.к. строка подключения не содержит http'; tr = 'Arayüz türü %1 olarak değiştirildi, çünkü bağlantı dizesi http içermiyor'; uk = 'Тип інтерфейсу був змінений на %1, оскільки рядок підключення не містить http'; uz = ""Interfeys turi %1 ga o'zgartirildi, chunki ulanish qatori http ni o'z ichiga olmaydi""");
		КонецЕсли;
		
		ТекстСообщения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстСообщения, НовыйТипИнтерфейса);
		Сообщить(ТекстСообщения); 
	КонецЕсли;
	
	#КонецОбласти //НесовместимыйКодFresh

КонецПроцедуры

