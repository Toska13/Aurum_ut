	ОписаниеОп = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтаФорма);
	ТекстВопроса = НСтр("be = 'Захаваць змены?'; en = 'Save changes?'; es = '¿Guardar los cambios?'; ka = 'შენახვა ცვლილებები?'; kk = 'Өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; ru = 'Сохранить изменения?'; tr = 'Değişiklikleri kaydetmek istiyor musunuz?'; uk = 'Зберегти зміни?'; uz = 'Ўзгаришларни сақлаш керакми?  '");
	ПоказатьВопрос(ОписаниеОп, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Отмена); 

