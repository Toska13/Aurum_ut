&НаКлиенте
Процедура НастройкиОбменаСправочниковСпособВыгрузкиПриИзменении(Элемент)
	
	ТекущаяСтрока = ЭтаФорма.Элементы.НастройкиОбменаСправочников.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяМакетаИО 		= "";
	ПроизвольныйЗапрос 	= "";
	
	Если ТекущаяСтрока.СпособВыгрузки = "ПоУмолчанию" Тогда
		ИмяМакетаИО = ПолучитьИмяМакетаИОПоУмолчанию(ТекущаяСтрока.ИмяТаблицы);
	ИначеЕсли ТекущаяСтрока.СпособВыгрузки = "СвойМакетСКД" Тогда
		ИмяМакетаИО = ТекущаяСтрока.ИмяМакетаИО;
	ИначеЕсли ТекущаяСтрока.СпособВыгрузки = "ПроизвольныйЗапрос" Тогда
		ПроизвольныйЗапрос = "Запрос";
	КонецЕсли;
	
	ТекущаяСтрока.ИмяМакетаИО 			= ИмяМакетаИО;
	ТекущаяСтрока.ПроизвольныйЗапрос 	= ПроизвольныйЗапрос;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковСпособВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = ЭтаФорма.Элементы.НастройкиОбменаСправочников.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Элемент.СписокВыбора;
	СпособВыгрузки_ПроизвольныйЗапрос = СписокВыбора.НайтиПоЗначению("ПроизвольныйЗапрос");
	
	Если ТекущаяСтрока.ИмяТаблицы = "Номенклатура" Тогда
		// Запрет выбора способа выгрузки "ПроизвольныйЗапрос", т.к. в для выгрузки номенклатуры необходимо правильно написать запрос,
		// чтобы он работал в онлайне
		Если СпособВыгрузки_ПроизвольныйЗапрос <> Неопределено Тогда
			СписокВыбора.Удалить(СпособВыгрузки_ПроизвольныйЗапрос);
		КонецЕсли;
	Иначе
		Если СпособВыгрузки_ПроизвольныйЗапрос = Неопределено Тогда
			// Перезаполняем список выбора
			ЗаполнитьСписокВыбораСпособовВыгрузки();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
		
	Если НоваяСтрока Тогда	
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекущиеДанные.Типовой 			= Ложь;
		ТекущиеДанные.Картинка			= БиблиотекаКартинок.Пользователь;
		ТекущиеДанные.СпособВыгрузки 	= "СвойМакетСКД";
		
		ЗаполнитьКолонкиФиктивнымиНадписями();		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковПередУдалением(Элемент, Отказ)
		
	ТекущиеДанные = Элементы.НастройкиОбменаСправочников.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Типовой Тогда
		Отказ = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковПриАктивизацииСтроки(Элемент)
		
	ТекущиеДанные = Элементы.НастройкиОбменаСправочников.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.НастройкиОбменаСправочниковКоманднаяПанель.Кнопки.НастройкиОбменаСправочниковУдалить.Доступность = НЕ ТекущиеДанные.Типовой;
	#Иначе	
		Элементы.НастройкиОбменаСправочниковУдалить.Доступность = НЕ ТекущиеДанные.Типовой;
	#КонецЕсли
	
	Элементы.НастройкиОбменаСправочниковИмяТаблицыПредставление.ТолькоПросмотр = ТекущиеДанные.Типовой;
	
	Если НЕ ТекущиеДанные.Типовой Тогда
		Попытка
			_ЛокКонтекст.ЛокЯдро_ОбновитьМетаданныеТаблицMS();
			
			ТаблицыСмартс = _ЛокКонтекст.СтруктураМетаданных.Tables;
				
			МассивИсключаемыхТаблиц = Новый Массив;
			МассивИсключаемыхТаблиц.Добавить("Узлы");
			МассивИсключаемыхТаблиц.Добавить("БизнесПроцессы");
				
			МассивСуществующиеТаблиц = ПолучитьМассивСуществующихНастроекОбмена();
				
			СписокВыбора = Новый Массив;
			Для каждого ТаблицаСмартс ИЗ ТаблицыСмартс Цикл
				ПредставлениеТаблицы = ?(ЗначениеЗаполнено(ТаблицаСмартс.Представление), ТаблицаСмартс.Представление, СокрЛП(ТаблицаСмартс));
				Если МассивИсключаемыхТаблиц.Найти(ПредставлениеТаблицы) <> Неопределено
					ИЛИ МассивСуществующиеТаблиц.Найти(ПредставлениеТаблицы) <> Неопределено И НЕ ТекущиеДанные.ИмяТаблицыПредставление = ПредставлениеТаблицы Тогда
					Продолжить;
				КонецЕсли;
				СписокВыбора.Добавить(ПредставлениеТаблицы);
			КонецЦикла;
				
			Элементы.НастройкиОбменаСправочниковИмяТаблицыПредставление.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПолучениеСпискаТаблицДляВыгрузки", "Ошибка", "Не удалось получить список таблиц для выгрузки: " + ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	ЗаполнитьСписокВыбораСпособовВыгрузки(ТекущиеДанные.Типовой);

КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковИмяТаблицыПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
		
	ТекущиеДанные = Элементы.НастройкиОбменаСправочников.ТекущиеДанные;

    Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ИмяТаблицы = ВыбранноеЗначение;		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы

// Собирает структуры настроек выгрузки справочников, сохраняет в базу SMARTS и обновляет кэш
// 
// Параметры:
&НаКлиенте
Процедура СохранитьНастройки()
	
	ТаблицаДляСохранения = ПолучитьМассивСтруктурНастроекКлиент();
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОбменаСправочников", ТаблицаДляСохранения, ID_Узла);
	Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОбменаСправочников", ТаблицаДляСохранения);	
	КонецЕсли;
	
	СтруктураОбщихНастроек = Новый Структура;
	СтруктураОбщихНастроек.Вставить("ИспользоватьШаблоныВесовогоТовара",   ИспользоватьШаблоныВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("ПрефиксКодаВесовогоТовара",           ПрефиксКодаВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("ЧислоЗнаковПослеЗапятойВесТовара",    ЧислоЗнаковПослеЗапятойВесТовара);
	СтруктураОбщихНастроек.Вставить("ДлинаКодаВесовогоТовара",             ДлинаКодаВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("ПрефиксВключенВКодВесовогоТовара",    ПрефиксВключенВКодВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("РазмерПорцииНоменклатуры",    		   РазмерПорцииНоменклатуры);
	СтруктураОбщихНастроек.Вставить("ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента",    ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента);
	СтруктураОбщихНастроек.Вставить("УстановитьПоискПоНаименованиюИАртикулу",    УстановитьПоискПоНаименованиюИАртикулу);
	
	СтруктураОбщихНастроек.Вставить("ПереписыватьНоменклатуруПриВыгрузке", ПереписыватьНоменклатуруПриВыгрузке);
	СтруктураОбщихНастроек.Вставить("ID_ТекущегоУзла", 					   ID_Узла);
	
	// надо обнулить настройки, т.к. могут остаться параметры, установленные мастером настроек
	СтруктураОбщихНастроек.Вставить("ВыгружатьКонтрагентовСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьНоменклатуруСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьОстаткиСразу", 					Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьСерииСразу", 						Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьСкладыСразу", 					Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьФормыАСразу", 					Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьХарактеристикиСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьЦеныСразу",						Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьАкцизныеМаркиСразу", 				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьКоробкиСразу",					Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьОстаткиПоЯчейкамСразу",			Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьЯчейкиСразу",						Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьДополнительнуюИнформациюСразу",	Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьКИЗСразу",						Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьТранспортныеУпаковкиСразу",		Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьСпрЯчейкиСразу",					Ложь);  
	СтруктураОбщихНастроек.Вставить("ВыгружатьОрганизацииСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьСотрудниковСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьПодразделенияСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьМестаХраненияСразу",				Ложь);
	СтруктураОбщихНастроек.Вставить("ВыгружатьСтатусыСразу",					Ложь);

	
	// Теперь запишем настройки с формы
	Для Каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл
		ИмяТаблицы 						= СтрокаНастройки.ИмяТаблицы;
		блВыгружать 					= СтрокаНастройки.Выгружать;
		
		Если ИмяТаблицы = "Номенклатура" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьНоменклатуруСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "Контрагенты" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьКонтрагентовСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "Остатки" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьОстаткиСразу",     блВыгружать);
		ИначеЕсли ИмяТаблицы = "Серии" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьСерииСразу",       блВыгружать);	
		ИначеЕсли ИмяТаблицы = "Склады" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьСкладыСразу",      блВыгружать);
		ИначеЕсли ИмяТаблицы = "ФормыА" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьФормыАСразу",      блВыгружать);
		ИначеЕсли ИмяТаблицы = "Характеристики" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьХарактеристикиСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "Цены" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьЦеныСразу",        блВыгружать);				
		ИначеЕсли ИмяТаблицы = "БутылкиЕГАИС" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьАкцизныеМаркиСразу",блВыгружать);				
		ИначеЕсли ИмяТаблицы = "КоробкиЕГАИС" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьКоробкиСразу",     блВыгружать);				
		ИначеЕсли ИмяТаблицы = "Ячейки" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьЯчейкиСразу",      блВыгружать);									
		ИначеЕсли ИмяТаблицы = "ДопРеквизиты" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьДополнительнуюИнформациюСразу",блВыгружать);									
			СтруктураОбщихНастроек.Вставить("ВыгружатьИнформациюДляЦенниковСразу",блВыгружать);									
		ИначеЕсли ИмяТаблицы = "ОстаткиПоЯчейкам" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьОстаткиПоЯчейкамСразу",блВыгружать);									
		ИначеЕсли ИмяТаблицы = "КИЗ" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьКИЗСразу",         блВыгружать);
		ИначеЕсли ИмяТаблицы = "ТранспортныеУпаковки" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьТранспортныеУпаковкиСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "СпрЯчейки" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьСпрЯчейкиСразу",блВыгружать);    
		ИначеЕсли ИмяТаблицы = "Организации" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьОрганизацииСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "Сотрудники" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьСотрудниковСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "Подразделения" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьПодразделенияСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "МестаХранения" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьМестаХраненияСразу",блВыгружать);
		ИначеЕсли ИмяТаблицы = "Статусы" Тогда
			СтруктураОбщихНастроек.Вставить("ВыгружатьСтатусыСразу",блВыгружать);
		КонецЕсли;
				
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураОбщихНастроек);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураОбщихНастроек);
	_ЛокКонтекст.ЛокЯдро_СохранитьШаблоныВесовогоТовараВБазеSMARTS();
	_ЛокКонтекст.ЛокЯдро_УстановитьПоискПоНаименованиюИАртикулу();

КонецПроцедуры

