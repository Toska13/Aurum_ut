// Заполняет список выбора элемента "ИмяМакетаИО" именами макетов, полученных из ИО
//
&НаКлиенте
Процедура ЗаполнитьСписокВыбораПроизвольныхСКД()

	МассивИменМакетов = ПолучитьМассивИменМакетовИО();
	
	ЭтаФорма.Элементы.НастройкиОбменаСправочниковИмяМакетаИО.СписокВыбора.ЗагрузитьЗначения(МассивИменМакетов);

