// Получает массив имен макетов из интеграционной обработки
//
// Возвращаемое значение:
//   Массив   - массив имен макетов
//
&НаКлиенте
Функция ПолучитьМассивИменМакетовИО()

	МассивИменМакетов = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивИменМакетовИО();

	Возврат МассивИменМакетов;
	
КонецФункции

// Заполняет таблицу макетов ИО по умолчанию для каждого имени справочника
//
&НаКлиенте
Процедура ЗаполнитьТаблицуИменМакетовИОПоУмолчанию()

	МассивСтруктурИменСправочников = Новый Массив;
	Для Каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл
		МассивСтруктурИменСправочников.Добавить(Новый Структура("ИмяСправочника, ИмяМакета", СтрокаНастройки.ИмяТаблицы, ""));
	КонецЦикла;
	
	МассивСтруктурИменМакетовИОПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивСтруктурМакетовИОПоУмолчанию(МассивСтруктурИменСправочников);
	
	ТаблицаИменМакетовИОПоУмолчанию.Очистить();
	
	Для Каждого СтруктураИменМакетовИОПоУмолчанию Из МассивСтруктурИменМакетовИОПоУмолчанию Цикл
		НоваяСтрока = ТаблицаИменМакетовИОПоУмолчанию.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураИменМакетовИОПоУмолчанию);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет имена макетов ИО по умолчанию в таблице настроек
//
&НаКлиенте
Процедура ЗаполнитьИменаМакетовИОПоУмолчаниюВТаблицеНастроек()

	НайденныеСтроки = НастройкиОбменаСправочников.НайтиСтроки(Новый Структура("СпособВыгрузки", "ПоУмолчанию"));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ИмяМакетаИО = ПолучитьИмяМакетаИОПоУмолчанию(НайденнаяСтрока.ИмяТаблицы);
        НайденнаяСтрока.ИмяМакетаИО = ИмяМакетаИО;
	КонецЦикла;
	
КонецПроцедуры

// Получает имя макета ИО по умолчанию
//
// Параметры:
//  ИмяТаблицы  - Строка - имя таблицы, для которой необходимо получить имя макета ИО по умолчанию
//
// Возвращаемое значение:
//   Строка   - имя макета ИО по умолчанию
//
&НаКлиенте
Функция ПолучитьИмяМакетаИОПоУмолчанию(ИмяТаблицы)

	ИмяМакетаИО = "";
	
	НайденныеСтроки = ТаблицаИменМакетовИОПоУмолчанию.НайтиСтроки(Новый Структура("ИмяСправочника", ИмяТаблицы));
	
	Если НайденныеСтроки.Количество() <> 0 Тогда
		ИмяМакетаИО = НайденныеСтроки[0].ИмяМакета;
	КонецЕсли;

	Возврат ИмяМакетаИО;
	
КонецФункции

// Получает параметры выгрузки справочника
//
// Возвращаемое значение:
//   Структура   - см. ЛокЯдро_ПолучитьПустуюСтруктуруПараметровВыгрузкиСправочника()
//
&НаКлиенте
Функция ПолучитьПараметрыВыгрузки(СтрокаНастроек)

	ПараметрыВыгрузки = _ЛокКонтекст.ЛокЯдро_ПолучитьПустуюСтруктуруПараметровВыгрузкиСправочника();
	
	ПараметрыВыгрузки.СпособВыгрузки 				= СтрокаНастроек.СпособВыгрузки;
	ПараметрыВыгрузки.ИмяМакетаИО 					= СтрокаНастроек.ИмяМакетаИО;
	ПараметрыВыгрузки.ТекстЗапроса 					= СтрокаНастроек.ТекстЗапросаВыгрузкиНаТСД;
	ПараметрыВыгрузки.ТекстКодаПолучениеПараметров 	= СтрокаНастроек.ТекстКодаПолучениеПараметров;
	ПараметрыВыгрузки.ТаблицаСопоставленияПолей 	= СтрокаНастроек.СписокСопоставленияПолей.ВыгрузитьЗначения();
	ПараметрыВыгрузки.ИмяИсточникаДанных 			= СтрокаНастроек.ИмяТаблицы;
	ПараметрыВыгрузки.ОчищатьПередВыгрузкой			= СтрокаНастроек.ОчищатьПередВыгрузкой;
	ПараметрыВыгрузки.ПредставлениеСправочника		= СтрокаНастроек.ИмяТаблицыПредставление;
	ПараметрыВыгрузки.Вставить("РазмерПорции", 			СтрокаНастроек.РазмерПорции);
	
	Если НЕ ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		ПараметрыВыгрузки.Вставить("НастройкаКомпоновщикаСтрокой", СтрокаНастроек.НастройкаКомпоновщикаСтрокой);
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		ПараметрыВыгрузки.Вставить("ТипБазы", ТипБазы);
	КонецЕсли;
	
	Возврат ПараметрыВыгрузки;

КонецФункции

// Создание элементов условного оформления для отображения представлений, а не значений списка выбора для колонки СпособВыгрузки
//
&НаСервере
Процедура ДобавитьУсловноеОформлениеТекстаДляСпискаВыбораСпособаВыгрузки()
	
	Элемент = ЭтаФорма.Элементы.НастройкиОбменаСправочниковСпособВыгрузки;
	
	Для Каждого ЭлементСпискаВыбора Из Элемент.СписокВыбора Цикл

        // Новое правило оформления
        ЭлементУсловногоОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
        ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементСпискаВыбора.Представление);

        // Условие
        ЭлементУсловия  = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ЭлементУсловия.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(Элемент.ПутьКДанным);
        ЭлементУсловия.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
        ЭлементУсловия.ПравоеЗначение 	= ЭлементСпискаВыбора.Значение;

        // Поле
        ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
        ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элемент.Имя);

	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Функция ПолучитьМассивСуществующихНастроекОбмена()

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МассивСуществующихНастроек = НастройкиОбменаСправочников.ВыгрузитьКолонку("ИмяТаблицы");
	#Иначе
		МассивСуществующихНастроек = НастройкиОбменаСправочников.Выгрузить().ВыгрузитьКолонку("ИмяТаблицы");
	#КонецЕсли
	
	Возврат МассивСуществующихНастроек;
	
КонецФункции

#КонецОбласти

#Область Описанияоповещений

&НаКлиенте
Процедура ВопросВыгрузитьОтмеченныеСправочникиЗавершение(РезультатВопроса, Параметр = Неопределено) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьОтмеченныеСправочники();
			
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтмеченныеСправочники()

	ПараметрыВыгрузкиСправочников = Новый Массив;
	
	Для Каждого Строка Из НастройкиОбменаСправочников Цикл
		Если Строка.Выгружать = Истина Тогда
			ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки(Строка);
			ПараметрыВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ПараметрыВыгрузки", Строка.ИмяТаблицы, ПараметрыВыгрузки));			
		КонецЕсли;
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS(ПараметрыВыгрузкиСправочников);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчиститьОтмеченныеСправочникиЗавершение(РезультатВопроса,Параметр) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из НастройкиОбменаСправочников Цикл		
		Если Строка.Выгружать = Истина Тогда
			_ЛокКонтекст.ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS(Строка.ИмяТаблицы);	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте 
Процедура ВопросВыгрузитьСправочникЗавершение(РезультатВопроса, ТекущаяСтрокаНастройки) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
		
	ИмяТаблицы 	= ТекущаяСтрокаНастройки.ИмяТаблицы;
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки(ТекущаяСтрокаНастройки);
	
	ПараметрыВыгрузкиСправочников = Новый Массив;
    ПараметрыВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ПараметрыВыгрузки", ИмяТаблицы, ПараметрыВыгрузки));			
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS(ПараметрыВыгрузкиСправочников);
	
КонецПроцедуры

&НаКлиенте 
Процедура ВопросОчиститьСправочникЗавершение(РезультатВопроса, ИмяТаблицы) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		_ЛокКонтекст.ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы);
	КонецЕсли;
	
КонецПроцедуры

