// Собирает структуру настроек выгрузки справочников
// 
// Параметры:
// Возвращаемое значение:
// 	Массив - Структура настроек
&НаКлиенте
Функция ПолучитьМассивСтруктурНастроекКлиент()
	
	МассивНастроек =  Новый Массив;
	СтрокаНастройки = Новый Структура();
	СтрокаНастройки.Вставить("ЭтоТаблицаЗначений",Истина);
	СтрокаНастройки.Вставить("КолонкиТаблицыЗначений","Выгружать,ИмяТаблицы,ИмяТаблицыПредставление,НастройкаКомпоновщикаСтрокой,СпособВыгрузки,ИмяМакетаИО,ТекстЗапросаВыгрузкиНаТСД,ТекстКодаПолучениеПараметров,Типовой,ОчищатьПередВыгрузкой,РазмерПорции");
	МассивНастроек.Добавить(СтрокаНастройки);
	
	Для Каждого СтрокаТЧ ИЗ НастройкиОбменаСправочников Цикл
		
		СтрокаНастройки = Новый Структура();
		
		СтрокаНастройки.Вставить("Выгружать",						СтрокаТЧ.Выгружать);
		СтрокаНастройки.Вставить("ИмяТаблицы",						СтрокаТЧ.ИмяТаблицы);
		СтрокаНастройки.Вставить("ИмяТаблицыПредставление",			СтрокаТЧ.ИмяТаблицыПредставление);
		СтрокаНастройки.Вставить("НастройкаКомпоновщикаСтрокой",	СтрокаТЧ.НастройкаКомпоновщикаСтрокой);
		СтрокаНастройки.Вставить("СпособВыгрузки", 					СтрокаТЧ.СпособВыгрузки);
		СтрокаНастройки.Вставить("ИмяМакетаИО", 					СтрокаТЧ.ИмяМакетаИО);
		СтрокаНастройки.Вставить("ТекстЗапросаВыгрузкиНаТСД",		СтрокаТЧ.ТекстЗапросаВыгрузкиНаТСД);
		СтрокаНастройки.Вставить("ТекстКодаПолучениеПараметров",	СтрокаТЧ.ТекстКодаПолучениеПараметров);
		СтрокаНастройки.Вставить("ТаблицаСопоставленияПолей",		СтрокаТЧ.СписокСопоставленияПолей.ВыгрузитьЗначения());
		СтрокаНастройки.Вставить("Типовой",							СтрокаТЧ.Типовой);
		СтрокаНастройки.Вставить("ОчищатьПередВыгрузкой",			СтрокаТЧ.ОчищатьПередВыгрузкой);
		СтрокаНастройки.Вставить("РазмерПорции",						СтрокаТЧ.РазмерПорции);
		
		МассивНастроек.Добавить(СтрокаНастройки);
		
	КонецЦикла;
	
	Возврат МассивНастроек;
	
КонецФункции

// Заполняет табличную часть декоративными значениями 
// 
// Параметры:
//&НаСервере
Процедура ЗаполнитьКолонкиФиктивнымиНадписями()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		рНастройкиОбменаСправочников = НастройкиОбменаСправочников;
	#Иначе
		рНастройкиОбменаСправочников = РеквизитФормыВЗначение("НастройкиОбменаСправочников");
	#КонецЕсли
	
	Для каждого СтрокаТЧ ИЗ рНастройкиОбменаСправочников Цикл
		СтрокаТЧ.Выгрузка = НСтр("be = 'Выгрузка...'; en = 'Unloading...'; es = 'Descargando...'; ka = 'გამოსახულება...'; kk = 'Жүктеу...'; ro = 'Descărcare...'; ru = 'Выгрузка...'; tr = 'Dışa aktarım...'; uk = 'Вивантаження...'; uz = 'Yuklash...'");
		СтрокаТЧ.Предпросмотр = НСтр("be = 'Прадпрагляд і друк...'; en = 'Preview and print...'; es = 'Vista previa e impresión...'; ka = 'წინასწარი და ბეჭდვა...'; kk = 'Алдын ала қарау және басу...'; ro = 'Previzualizare și tipărire...'; ru = 'Предпросмотр и печать...'; tr = 'Önizleme ve Yazdır...'; uk = 'Попередній перегляд і друк...'; uz = ""Oldindan ko'rish va chop etish...""");
		СтрокаТЧ.ОчисткаСправочника = НСтр("be = ""Translate the following 'Russian' texts to 'Belarusian':""; en = 'Cleaning the directory...'; es = 'Limpiando el directorio...'; ka = 'საწყისის გასუფთავება...'; kk = 'Тізімді тазарту...'; ro = 'Curățarea directorului...'; ru = 'Очистка справочника...'; tr = 'Dizin temizleniyor...'; uk = 'Очищення довідника...'; uz = 'Katalogni tozalash...'");
		Если СтрокаТЧ.НастройкаКомпоновщикаСтрокой = "" Тогда
			СтрокаТЧ.Настройка = НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
		Иначе
			СтрокаТЧ.Настройка = НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");
		КонецЕсли;
		Если СтрокаТЧ.СпособВыгрузки = "" Тогда
			СтрокаТЧ.СпособВыгрузки = "ПоУмолчанию";
		КонецЕсли;
		Если СтрокаТЧ.СпособВыгрузки = "ПроизвольныйЗапрос" Тогда
			СтрокаТЧ.ПроизвольныйЗапрос = НСтр("be = 'Запыт'; en = 'Request'; es = 'Solicitud'; ka = 'მოთხოვნა'; kk = 'Сұрау'; ro = 'Cerere'; ru = 'Запрос'; tr = 'Talep'; uk = 'Запит'; uz = ""So'rov""");
		КонецЕсли;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		НастройкиОбменаСправочников = рНастройкиОбменаСправочников;
	#Иначе
		ЗначениеВРеквизитФормы(рНастройкиОбменаСправочников,"НастройкиОбменаСправочников");
	#КонецЕсли
	
КонецПроцедуры

