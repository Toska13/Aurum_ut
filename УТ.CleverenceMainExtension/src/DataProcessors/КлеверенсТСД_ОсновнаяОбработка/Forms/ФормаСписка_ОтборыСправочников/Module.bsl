&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Настройки шапки
	ПереписыватьНоменклатуруПриВыгрузке = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке");
	ИспользоватьШаблоныВесовогоТовара 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИспользоватьШаблоныВесовогоТовара");
	ПрефиксКодаВесовогоТовара 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПрефиксКодаВесовогоТовара");
	ЧислоЗнаковПослеЗапятойВесТовара 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ЧислоЗнаковПослеЗапятойВесТовара");
	ДлинаКодаВесовогоТовара 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ДлинаКодаВесовогоТовара");
	ПрефиксВключенВКодВесовогоТовара	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПрефиксВключенВКодВесовогоТовара");
	РазмерПорцииНоменклатуры			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РазмерПорцииНоменклатуры");
	ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента");
	УстановитьПоискПоНаименованиюИАртикулу	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("УстановитьПоискПоНаименованиюИАртикулу");
	
	// Параметры выгрузки справочников по умолчанию
	НастройкиОбменаСправочников_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников_ПоУмолчанию");
	
	// Настройки таблицы
	ЭтоТекущийУзел = ЭтаФорма.ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	Если ЭтоТекущийУзел Тогда
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников");				
	Иначе
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОбменаСправочников", ID_Узла);
	КонецЕсли;
	
	СписокИспользуемыхСправочников = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокИспользуемыхСправочников();
	
	СписокСохраненныхИмен = Новый СписокЗначений;
	СписокСтрокКУдалению = Новый СписокЗначений;
	Если НЕ ЗначениеНастройки = Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
		Для Каждого СтрокаНастройки Из ЗначениеНастройки Цикл
			Если СтрокаНастройки.Свойство("КолонкиТаблицыЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = НастройкиОбменаСправочников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			Если СтрокаНастройки.Свойство("ТаблицаСопоставленияПолей")
				И ТипЗнч(СтрокаНастройки.ТаблицаСопоставленияПолей) = Тип("Массив") Тогда
				НоваяСтрока.СписокСопоставленияПолей.ЗагрузитьЗначения(СтрокаНастройки.ТаблицаСопоставленияПолей);
			КонецЕсли;
				
			// Определение признака ОчищатьПередВыгрузкой для совместимости со старыми настройками
			Если НЕ СтрокаНастройки.Свойство("ОчищатьПередВыгрузкой") Тогда
				НоваяСтрока.ОчищатьПередВыгрузкой = ?(ПереписыватьНоменклатуруПриВыгрузке = Неопределено, Ложь, ПереписыватьНоменклатуруПриВыгрузке);
			КонецЕсли;
			
			// Определение признака Типовой для совместимости со старыми настройками
			Если НЕ СтрокаНастройки.Свойство("Типовой") Тогда
				НоваяСтрока.Типовой = СписокИспользуемыхСправочников.НайтиПоЗначению(НоваяСтрока.ИмяТаблицы) <> Неопределено;				
			КонецЕсли;
			НоваяСтрока.Картинка = ?(НоваяСтрока.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
			
			// Временное решение для совместимости с сохраненными настройками от старых версий
			// в настройки сохранялся СписокЗначений, в новой версии разделил на ИмяТаблицы и ИмяТаблицыПредставление для возможности сохранения в файл
			Если ТипЗнч(СтрокаНастройки.ИмяТаблицы) = Тип("ЭлементСпискаЗначений") Тогда
				НоваяСтрока.ИмяТаблицы = СтрокаНастройки.ИмяТаблицы.Значение;
				СписокСохраненныхИмен.Добавить(СтрокаНастройки.ИмяТаблицы.Значение);
			Иначе
				СписокСохраненныхИмен.Добавить(СтрокаНастройки.ИмяТаблицы);
			КонецЕсли;
			// конец
			
			// в интеграционной обработке прописывается использование справочника в зависимости от значения констант в 1С
			// проверяем, если что-то отключили, то удалим такие строки
			ЭлементСписка = СписокИспользуемыхСправочников.НайтиПоЗначению(НоваяСтрока.ИмяТаблицы);
			Если ЭлементСписка <> Неопределено Тогда 
				//Если Не ЗначениеЗаполнено(НоваяСтрока.ИмяТаблицыПредставление) Тогда
					НоваяСтрока.ИмяТаблицыПредставление = ЭлементСписка.Представление;
				//КонецЕсли;
			Иначе
				Если СтрокаНастройки.Свойство("Типовой") И СтрокаНастройки.Типовой Тогда // Пользовательские настройки удалять не нужно
					СписокСтрокКУдалению.Добавить(НоваяСтрока);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СписокСтрокКУдалению.Количество() > 0 Тогда
		Для Каждого Строка Из СписокСтрокКУдалению Цикл
			НастройкиОбменаСправочников.Удалить(Строка.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ИмяСправочника ИЗ СписокИспользуемыхСправочников Цикл
		Если СписокСохраненныхИмен.НайтиПоЗначению(ИмяСправочника.Значение) = Неопределено Тогда
			
			СправочникИмя = ИмяСправочника.Значение;
			
			НоваяСтрока = НастройкиОбменаСправочников.Добавить();			
			НоваяСтрока.ИмяТаблицы 				= СправочникИмя;
			НоваяСтрока.ИмяТаблицыПредставление = ИмяСправочника.Представление;
			НоваяСтрока.Типовой 				= Истина;
			НоваяСтрока.Картинка				= БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
			
			НастройкиПоУмолчанию = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", СправочникИмя);
			Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НастройкиПоУмолчанию);
			КонецЕсли;
			
			// настройки для каждого справочника лежат в отдельных ключах, поэтому проверяем так 
			Если ИмяСправочника.Значение = "Номенклатура" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьНоменклатуруСразу");
			ИначеЕсли ИмяСправочника.Значение = "Контрагенты" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьКонтрагентовСразу");
			ИначеЕсли ИмяСправочника.Значение = "Остатки" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьОстаткиСразу");
			ИначеЕсли ИмяСправочника.Значение = "Серии" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьСерииСразу");	
			ИначеЕсли ИмяСправочника.Значение = "Склады" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьСкладыСразу");
			ИначеЕсли ИмяСправочника.Значение = "ФормыА" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьФормыАСразу");
			ИначеЕсли ИмяСправочника.Значение = "Характеристики" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьХарактеристикиСразу");
			ИначеЕсли ИмяСправочника.Значение = "Цены" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьЦеныСразу");				
			ИначеЕсли ИмяСправочника.Значение = "БутылкиЕГАИС" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьАкцизныеМаркиСразу");				
			ИначеЕсли ИмяСправочника.Значение = "КоробкиЕГАИС" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьКоробкиСразу");				
			ИначеЕсли ИмяСправочника.Значение = "Ячейки" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьЯчейкиСразу");				
			ИначеЕсли ИмяСправочника.Значение = "ОстаткиПоЯчейкам" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьОстаткиПоЯчейкамСразу");								
			ИначеЕсли ИмяСправочника.Значение = "ДопРеквизиты" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьДополнительнуюИнформациюСразу") ИЛИ _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьИнформациюДляЦенниковСразу");				
			ИначеЕсли ИмяСправочника.Значение = "КИЗ" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьКИЗСразу");
			ИначеЕсли ИмяСправочника.Значение = "ТранспортныеУпаковки" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьТранспортныеУпаковкиСразу");
			ИначеЕсли ИмяСправочника.Значение = "СпрЯчейки" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьСпрЯчейкиСразу");
			ИначеЕсли ИмяСправочника.Значение = "Организации" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьОрганизацииСразу");
			ИначеЕсли ИмяСправочника.Значение = "Сотрудники" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьСотрудниковСразу");
			ИначеЕсли ИмяСправочника.Значение = "Подразделения" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьПодразделенияСразу");
			ИначеЕсли ИмяСправочника.Значение = "МестаХранения" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьМестаХраненияСразу");
			ИначеЕсли ИмяСправочника.Значение = "Статусы" Тогда
				НоваяСтрока.Выгружать = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ВыгружатьСтатусыСразу");    
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
		                                              
	ЗаполнитьКолонкиФиктивнымиНадписями();
	
	ЗаполнитьСписокВыбораСпособовВыгрузки();
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ДобавитьУсловноеОформлениеТекстаДляСпискаВыбораСпособаВыгрузки();
	#КонецЕсли

	ЗаполнитьСписокВыбораПроизвольныхСКД();
	
	ЗаполнитьТаблицуИменМакетовИОПоУмолчанию();
	
	ЗаполнитьИменаМакетовИОПоУмолчаниюВТаблицеНастроек();
	
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ЭтаФорма.НаименованиеУзла;	
	//Элементы.НастройкиОбменаСправочниковИмяТаблицы.Видимость = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
		Элементы.НаименованиеУзла.Видимость = Ложь;		
	КонецЕсли;
	
	ОбновитьДоступностьЭлементов();

	Если ВыгрузитьСправочникиПриОткрытии = Истина Тогда
		
		//даем отрисоваться окну
		ПодключитьОбработчикОжидания("ВыгрузитьОтмеченныеСправочники", 0.3, Истина);
				
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементыФормы.НастройкиОбменаСправочников.Колонки.РазмерПорции.ПодсказкаВШапке = НСтр("be = 'Разбіваць даведнік для выгрузкі на партыі (0 - не разбіваць). Дадзеную опцыю рэкамендуецца выкарыстоўваць пры наяўнасці вялікага даведніка і паўстання памылак пры выгрузцы даведніка стандартнай выгрузкай.'; en = 'Break the directory for unloading into portions (0 - do not break). This option is recommended to use when there is a large directory and errors occur during unloading with standard unloading.'; es = 'Dividir el directorio para la descarga en porciones (0 - no dividir). Se recomienda utilizar esta opción cuando se tiene un directorio grande y surgen errores al descargar el directorio de forma estándar.'; ka = 'საჩვენებლად წინასწარ შეიყვანეთ წიგნი ნაწილებად (0 - არ შეიყვანოთ). ეს ოფცია რეკომენდირებულია დიდი წიგნის შემთხვევაში და შეცდომების შემთხვევაში წიგნის სტანდარტულ შესაჩვენებლად შესაძლებელია.'; kk = 'Тізімді жүктеу үшін тарату (0 - таратпау). Бұл опцияны қолдану керек, егер үлкен тізім болса және тізімді дефолтты түрде жүктеу кезінде қателер пайда болса.'; ro = 'Împărțiți cartea de referință pentru descărcare în porții (0 - nu împărțiți). Această opțiune este recomandată să fie folosită în cazul unui registru mare de referință și apariția erorilor la descărcarea standard a registrelor.'; ru = 'Разбивать справочник для выгрузки на порции (0 - не разбивать). Данную опцию рекомендуется использовать при наличии большого справочника и возникновении ошибок при выгрузке справочника стандартной выгрузкой.'; tr = 'Boşaltma için rehberi parçalara ayır (0 - parçalamayın). Bu seçeneğin büyük bir rehber olduğunda ve standart boşaltma ile hatalar oluştuğunda kullanılması önerilir.'; uk = 'Розбивати довідник для вивантаження на порції (0 - не розбивати). Цю опцію рекомендується використовувати при наявності великого довідника та виникнення помилок під час вивантаження довідника стандартним вивантаженням.'; uz = 'Йўқотиш учун кўрсатмани қисмларга бўлиш (0 - кўрсатмани қисмларга бўлиш). Ушбу опцияни катта кўрсатмалар бўлиб, стандарт кўрсатмаларда хатоликлар чиқишидаги ҳолатларда ишлатиш мақсадга мувофиқ.'");
	#Иначе
		Элементы.НастройкиОбменаСправочниковРазмерПорции.Подсказка = НСтр("be = 'Разбіваць даведнік для выгрузкі на партыі (0 - не разбіваць). Дадзеную опцыю рэкамендуецца выкарыстоўваць пры наяўнасці вялікага даведніка і паўстання памылак пры выгрузцы даведніка стандартнай выгрузкай.'; en = 'Break the directory for unloading into portions (0 - do not break). This option is recommended to use when there is a large directory and errors occur during unloading with standard unloading.'; es = 'Dividir el directorio para la descarga en porciones (0 - no dividir). Se recomienda utilizar esta opción cuando se tiene un directorio grande y surgen errores al descargar el directorio de forma estándar.'; ka = 'საჩვენებლად წინასწარ შეიყვანეთ წიგნი ნაწილებად (0 - არ შეიყვანოთ). ეს ოფცია რეკომენდირებულია დიდი წიგნის შემთხვევაში და შეცდომების შემთხვევაში წიგნის სტანდარტულ შესაჩვენებლად შესაძლებელია.'; kk = 'Тізімді жүктеу үшін тарату (0 - таратпау). Бұл опцияны қолдану керек, егер үлкен тізім болса және тізімді дефолтты түрде жүктеу кезінде қателер пайда болса.'; ro = 'Împărțiți cartea de referință pentru descărcare în porții (0 - nu împărțiți). Această opțiune este recomandată să fie folosită în cazul unui registru mare de referință și apariția erorilor la descărcarea standard a registrelor.'; ru = 'Разбивать справочник для выгрузки на порции (0 - не разбивать). Данную опцию рекомендуется использовать при наличии большого справочника и возникновении ошибок при выгрузке справочника стандартной выгрузкой.'; tr = 'Boşaltma için rehberi parçalara ayır (0 - parçalamayın). Bu seçeneğin büyük bir rehber olduğunda ve standart boşaltma ile hatalar oluştuğunda kullanılması önerilir.'; uk = 'Розбивати довідник для вивантаження на порції (0 - не розбивати). Цю опцію рекомендується використовувати при наявності великого довідника та виникнення помилок під час вивантаження довідника стандартним вивантаженням.'; uz = 'Йўқотиш учун кўрсатмани қисмларга бўлиш (0 - кўрсатмани қисмларга бўлиш). Ушбу опцияни катта кўрсатмалар бўлиб, стандарт кўрсатмаларда хатоликлар чиқишидаги ҳолатларда ишлатиш мақсадга мувофиқ.'");
	#КонецЕсли
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьИЗакрытьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	СтруктураНастройки = Новый Структура;	
	СтруктураНастройки.Вставить("НастройкиОбменаСправочников", 				ПолучитьМассивСтруктурНастроекКлиент());
	СтруктураНастройки.Вставить("ИспользоватьШаблоныВесовогоТовара",   		ИспользоватьШаблоныВесовогоТовара);
	СтруктураНастройки.Вставить("ПрефиксКодаВесовогоТовара",           		ПрефиксКодаВесовогоТовара);
	СтруктураНастройки.Вставить("ЧислоЗнаковПослеЗапятойВесТовара",    		ЧислоЗнаковПослеЗапятойВесТовара);
	СтруктураНастройки.Вставить("ДлинаКодаВесовогоТовара",             		ДлинаКодаВесовогоТовара);
	СтруктураНастройки.Вставить("РазмерПорцииНоменклатуры",            		РазмерПорцииНоменклатуры);
	СтруктураНастройки.Вставить("УстановитьПоискПоНаименованиюИАртикулу",   УстановитьПоискПоНаименованиюИАртикулу);
	СтруктураНастройки.Вставить("ВерсияОбработкиНастроек",					_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиНастроек"));
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастройки, "НастройкиОбменаСправочников");
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзФайла(Команда)

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВосстановитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("НастройкиОбменаСправочников", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт

	Если СтруктураНастроек <> Неопределено Тогда
		
		ИспользоватьШаблоныВесовогоТовара = СтруктураНастроек.ИспользоватьШаблоныВесовогоТовара;
		ПрефиксКодаВесовогоТовара = СтруктураНастроек.ПрефиксКодаВесовогоТовара;
		ЧислоЗнаковПослеЗапятойВесТовара = СтруктураНастроек.ЧислоЗнаковПослеЗапятойВесТовара;
		ДлинаКодаВесовогоТовара = СтруктураНастроек.ДлинаКодаВесовогоТовара;
		РазмерПорцииНоменклатуры = СтруктураНастроек.РазмерПорцииНоменклатуры;
		
		НастройкиОбменаСправочников.Очистить();
		
		//Выполним обновление - Начало
		ВерсияОбработки =_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");		
		Если СтруктураНастроек.Свойство("ВерсияОбработкиНастроек") Тогда
			ВерсияОбработкиНастроек = СтруктураНастроек.ВерсияОбработкиНастроек;
		Иначе
			ВерсияОбработкиНастроек = 0;		
		КонецЕсли;  
		Если ВерсияОбработки>ВерсияОбработкиНастроек Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
			
			ПараметрыМетода = Новый Структура();
			ПараметрыМетода.Вставить("ВерсияНастроек",ВерсияОбработкиНастроек);
			ПараметрыМетода.Вставить("СтруктураНастроек",Новый Структура("НастройкиОбменаСправочников", СтруктураНастроек.НастройкиОбменаСправочников));
			СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
			
			СтруктураНастроек = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,_ЛокКонтекст.АдресаПеременных);
		КонецЕсли;
		//Выполним обновление - Конец
		
		Для Каждого пНастройка Из СтруктураНастроек.НастройкиОбменаСправочников Цикл
			Если пНастройка.Свойство("КолонкиТаблицыЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = НастройкиОбменаСправочников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,пНастройка);
			НоваяСтрока.СписокСопоставленияПолей.ЗагрузитьЗначения(пНастройка.ТаблицаСопоставленияПолей);
			НоваяСтрока.Картинка = ?(пНастройка.Свойство("Типовой") И НЕ пНастройка.Типовой, БиблиотекаКартинок.Пользователь, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки);			
		КонецЦикла;
	КонецЕсли;
	ЗаполнитьКолонкиФиктивнымиНадписями();
	ОбновитьДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого СтрокаТЧ Из НастройкиОбменаСправочников Цикл
		СтрокаТЧ.Выгружать = Истина;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого СтрокаТЧ Из НастройкиОбменаСправочников Цикл
		СтрокаТЧ.Выгружать = Ложь;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВыбранные(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ВопросВыгрузитьОтмеченныеСправочникиЗавершение", ЭтаФорма);
	ТекстВопроса = НСтр("be = 'Выгрузіць адзначаныя даведнікі?'; en = 'Unload selected directories?'; es = '¿Descargar directorios marcados?'; ka = 'მონიშნული სამუშაოების გამოტანა?'; kk = 'Таңдалған тізімдерді шығару ма?'; ro = 'Descărcați dicționarele marcate?'; ru = 'Выгрузить отмеченные справочники?'; tr = 'İşaretli rehberleri dışa aktar?'; uk = 'Вивантажити відмічені довідники?'; uz = ""Belgilangan ma'lumotlar yuklanishi mumkinmi?""");
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВыбранные(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ВопросОчиститьОтмеченныеСправочникиЗавершение", ЭтаФорма);
	ТекстВопроса = НСтр("be = 'Ачысціць пазначаныя даведнікі?'; en = 'Clear marked directories?'; es = '¿Limpiar directorios marcados?'; ka = 'გასუფთავება მონიშნული საშუალოებები?'; kk = 'Белгіленген тізімдерді тазалау керек пе?'; ro = 'Ștergeți dicționarele marcate?'; ru = 'Очистить отмеченные справочники?'; tr = 'İşaretli rehberleri temizlemek mi istiyorsunuz?'; uk = 'Очистити позначені довідники?'; uz = ""Belgilangan ma'lumotlar tozalansinmi?""");
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	КолонкаИмя = Поле.Имя;
	ТекущаяСтрокаНастройки = Элемент.ТекущиеДанные;
	ИмяТаблицы 						= ТекущаяСтрокаНастройки.ИмяТаблицы;
	СпособВыгрузки 					= ТекущаяСтрокаНастройки.СпособВыгрузки;
	ИмяМакетаИО 					= ТекущаяСтрокаНастройки.ИмяМакетаИО;
	ТекстЗапросаВыгрузкиНаТСД 		= ТекущаяСтрокаНастройки.ТекстЗапросаВыгрузкиНаТСД;
	ТекстКодаПолучениеПараметров 	= ТекущаяСтрокаНастройки.ТекстКодаПолучениеПараметров;
	СписокСопоставленияПолей 		= ТекущаяСтрокаНастройки.СписокСопоставленияПолей;
	ПредставлениеСправочника 		= ТекущаяСтрокаНастройки.ИмяТаблицыПредставление;
	
	Если КолонкаИмя = "НастройкиОбменаСправочниковНастройка" ИЛИ КолонкаИмя = "НастройкиОбменаСправочниковПредпросмотр"  Тогда 
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ОтборСправочников = ПолучитьФорму("ОФ_ФормаНастройки_ОтборСправочников",  ЭтаФорма);
		#Иначе
			ФормаНастройки_ОтборСправочников = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ОтборСправочников", , ЭтаФорма, "ФормаНастройки_ОтборСправочников_"+ИмяТаблицы);
			//ФормаСписка_ОтборыСправочников.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		ФормаНастройки_ОтборСправочников.ЗакрыватьПриЗакрытииВладельца = Истина;
		ФормаНастройки_ОтборСправочников._ЛокКонтекст = _ЛокКонтекст;
		ФормаНастройки_ОтборСправочников.ТипБазы = ТипБазы;
		ФормаНастройки_ОтборСправочников.ID_Узла = ID_Узла;
		ФормаНастройки_ОтборСправочников.ИмяТаблицы = ИмяТаблицы;
		ФормаНастройки_ОтборСправочников.НастройкаКомпоновщикаСтрокой = ТекущаяСтрокаНастройки.НастройкаКомпоновщикаСтрокой;
		ФормаНастройки_ОтборСправочников.НаименованиеУзла = _ЛокКонтекст.ДанныеТекущегоУзла.Наименование;
		ФормаНастройки_ОтборСправочников.СпособВыгрузки = СпособВыгрузки;
		ФормаНастройки_ОтборСправочников.ИмяМакетаИО = ИмяМакетаИО;
		ФормаНастройки_ОтборСправочников.ТекстЗапросаВыгрузкиНаТСД = ТекстЗапросаВыгрузкиНаТСД;
		ФормаНастройки_ОтборСправочников.ТекстКодаПолучениеПараметров = ТекстКодаПолучениеПараметров;
		ФормаНастройки_ОтборСправочников.СписокСопоставленияПолей = СписокСопоставленияПолей;
		ФормаНастройки_ОтборСправочников.Предпросмотр = КолонкаИмя = "НастройкиОбменаСправочниковПредпросмотр";
		ОП = Новый ОписаниеОповещения("НастройкиОтборСправочниковЗакрытие",ЭтаФорма,ТекущаяСтрокаНастройки);
		ФормаНастройки_ОтборСправочников.ОписаниеОповещенияОЗакрытии = ОП;
		ФормаНастройки_ОтборСправочников.Открыть();
			
	ИначеЕсли КолонкаИмя = "НастройкиОбменаСправочниковВыгрузка" Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ВопросВыгрузитьСправочникЗавершение", ЭтаФорма, ТекущаяСтрокаНастройки);
		ТекстВопроса = НСтр("be = 'Выгрузіць даведнік %1?'; en = 'Unload directory %1?'; es = '¿Descargar directorio %1?'; ka = 'სამუშაოების გამოტანა %1?'; kk = '%1 тізімді шығару ма?'; ro = 'Descărcați dicționarul %1?'; ru = 'Выгрузить справочник %1?'; tr = '%1 rehberini dışa aktar?'; uk = 'Вивантажити довідник %1?'; uz = ""%1 ma'lumotnomasini yuklash?""");
		ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ПредставлениеСправочника);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
		
	ИначеЕсли КолонкаИмя = "НастройкиОбменаСправочниковОчисткаСправочника" Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ВопросОчиститьСправочникЗавершение", ЭтаФорма,ИмяТаблицы);
		ТекстВопроса = НСтр("be = 'Ачысціць даведнік %1?'; en = 'Clear directory %1?'; es = '¿Limpiar directorio %1?'; ka = 'საშუალოს გასუფთავება %1?'; kk = '%1 тізімді тазалау пе?'; ro = 'Ștergeți dicționarul %1?'; ru = 'Очистить справочник %1?'; tr = '%1 rehberi temizlemek mi istiyorsunuz?'; uk = 'Очистити довідник %1?'; uz = ""%1 ma'lumotnoma tozalansinmi?""");
		ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ПредставлениеСправочника);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 	
		
	ИначеЕсли КолонкаИмя = "НастройкиОбменаСправочниковПроизвольныйЗапрос" Тогда
		
		Если СпособВыгрузки <> "ПроизвольныйЗапрос" Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
