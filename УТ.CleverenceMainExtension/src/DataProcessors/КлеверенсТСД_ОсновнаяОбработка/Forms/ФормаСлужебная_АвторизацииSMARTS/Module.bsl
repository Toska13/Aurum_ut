
&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем пЭлементы,
	РезультатПодключения;
	
	
&НаКлиенте
Процедура Авторизоваться(Команда)
	
	АвторизацияТокен 	   = Неопределено;
	АвторизацияРефрешТокен = Неопределено;
	
	РезультатАвторизации = _ЛокКонтекст.ЛокЯдро_ПолучитьТокенSMARTS(СтрокаПодключения, Логин, Пароль, ТипБазы, ТипИнтерфейса, Компонента);
	
	Если ТипЗнч(РезультатАвторизации) = Тип("Структура") Тогда
		АвторизацияТокен 	   = РезультатАвторизации.Access_token;
		АвторизацияРефрешТокен = РезультатАвторизации.Refresh_token;
	ИначеЕсли ТипЗнч(РезультатАвторизации) = Тип("Строка") И НЕ ПустаяСтрока(РезультатАвторизации) Тогда
		АвторизацияТокен	   = РезультатАвторизации;
		АвторизацияРефрешТокен = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АвторизацияТокен) И НЕ АвторизацияТокен = Ложь Тогда
		КлючШифрования 	  = _ЛокКонтекст.ЛокЯдро_ПолучитьКлючШифрования(Логин, СтрДлина(Пароль), Компонента);
		АвторизацияПароль = _ЛокКонтекст.ЛокЯдро_ЗашифроватьСтроку(Пароль, КлючШифрования, Компонента);
		
		СтруктураРезультата = Новый Структура;
		СтруктураРезультата.Вставить("АвторизацияТокен", 	   АвторизацияТокен);
		СтруктураРезультата.Вставить("АвторизацияРефрешТокен", АвторизацияРефрешТокен);
		СтруктураРезультата.Вставить("АвторизацияТип",		   "login");
		
		ДопПараметры.Вставить("СтрокаПодключения", СтрокаПодключения);
		
		РезультатПодключения = _ЛокКонтекст.КомЯдро_ПодключитьсяКБазеSMARTSНаСервереЗавершение(СтруктураРезультата, ДопПараметры);
		Если РезультатПодключения = Ложь Тогда
			ТекстОшибки = 
				НСтр("be = 'У гэтага карыстальніка Cleverence недастаткова правоў для падлучэння да базы!'; en = 'This user Cleverence does not have sufficient rights to connect to the database!'; es = 'Este usuario de Cleverence no tiene suficientes permisos para conectarse a la base de datos'; ka = 'მომხმარებელს Cleverence-ს არ აქვს საკმარისი უფლებები ბაზასთან დაკავშირებისთვის!'; kk = 'Cleverence пайдаланушысының базаға қосу үшін құқығы жеткіліксіз!'; ro = 'Acest utilizator Cleverence nu are suficiente drepturi pentru a se conecta la baza de date!'; ru = 'У данного пользователя Клеверенс недостаточно прав для подключения к базе!'; tr = 'Bu kullanıcının Cleverence veritabanına bağlanmak için yeterli izni yok!'; uk = 'У цього користувача Cleverence недостатньо прав для підключення до бази!'; uz = ""Bu foydalanuvchining Cleverence bazaga ulanish uchun yetarli huquqlari yo'q!""") 
				+ Символы.ПС
				+ НСтр("be = 'Карыстальнік павінен знаходзіцца ў групе ""Адміністратары"" або ""Знешнія падлучэнні"".'; en = 'User must be in the ""Administrators"" or ""External Connections"" group.'; es = 'El usuario debe estar en el grupo ""Administradores"" o ""Conexiones externas"".'; ka = 'მომხმარებელს უნდა ჰქონდეს ""ადმინისტრატორები"" ან ""გარე შეერთებები"" ჯგუფში.'; kk = 'Пайдаланушының ""Администраторлар"" немесе ""Сыртқы қосылулар"" тобында болуы тиіс.'; ro = 'Utilizatorul trebuie să fie în grupul ""Administratori"" sau ""Conexiuni externe"".'; ru = 'Пользователь должен находиться в группе ""Администраторы"" или ""Внешние подключения"".'; tr = 'Kullanıcı ""Yöneticiler"" veya ""Dış Bağlantılar"" grubunda olmalıdır.'; uk = 'Користувач повинен знаходитися в групі ""Адміністратори"" або ""Зовнішні підключення"".'; uz = 'Foydalanuvchi ""Administratorlar"" yoki ""Tashqi ulanishlar"" guruhida bo''lishi kerak.'");
		Иначе
			Оповестить("ФормаСлужебная_АвторизацииSMARTSЗакрытие", СтруктураРезультата, ЭтаФорма);
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Закрыть();	
			#Иначе
				Закрыть(РезультатПодключения);
			#КонецЕсли
		КонецЕсли;
	Иначе
		ТекстОшибки = НСтр("be = 'Уведзены няправільны лагін і/ці пароль'; en = 'Incorrect login and/or password entered!'; es = '¡Se han ingresado un nombre de usuario y/o contraseña incorrectos!'; ka = 'არასწორი ლოგინი და/და პაროლი შეყვანილია!'; kk = 'Введены неверные логин и/или пароль - Дұрыс емес логин және/немесе пароль енгізілді'; ro = 'Nume de utilizator și/sau parolă incorecte introduse!'; ru = 'Введены неверные логин и/или пароль!'; tr = 'Yanlış kullanıcı adı ve/veya şifre girildi!'; uk = 'Введені невірні логін і/або пароль!'; uz = ""Noto'g'ri login va/yoki parol kiritildi!""");
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//пЭлементы.Запомнить.Видимость = ВидимостьКнопкиЗапомнить <> Ложь;
	
	Запомнить = Истина;
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезультатПодключения);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		пЭлементы.ТекстОшибки.Видимость = ЗначениеЗаполнено(ТекстОшибки);
		пЭлементы.ТекстОшибки.Заголовок = ТекстОшибки;
	#Иначе
		пЭлементы.ДекорацияТекстОшибки.Видимость = ЗначениеЗаполнено(ТекстОшибки);
		пЭлементы.ДекорацияТекстОшибки.Заголовок = ТекстОшибки;
	#КонецЕсли
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	пЭлементы = ЭлементыФормы;
#Иначе
	КлючСохраненияПоложенияОкна = Новый УникальныйИдентификатор();
	пЭлементы = Элементы;
#КонецЕсли
