&НаКлиенте
Процедура СохранитьНастройкуСПроверкой(ЗакрытиеФормы = Ложь)
	
	ОшибкаПроверкиКода = ПроверитьКод();
	
	ТекстВопроса = ОшибкаПроверкиКода + Символы.ПС 
						+ НСтр("be = 'Працягнуць захаванне?'; en = 'Continue saving?'; es = '¿Continuar con el guardado?'; ka = 'გაგრძელება შენახვა?'; kk = 'Сақтау жалғастырылсын ба?'; ro = 'Continuați salvarea?'; ru = 'Продолжить сохранение?'; tr = 'Kaydetmeye devam etmek istiyor musunuz?'; uk = 'Продовжити збереження?'; uz = 'Saqlashni davom ettirsak?'");
	
	Если Не ПустаяСтрока(ОшибкаПроверкиКода) Тогда
		ЗаголовокВопроса = НСтр("be = 'Памылка разгадвання штрыхкода: тып ""%Тып%"" не падтрымліваецца'; en = 'Verification error'; es = 'Error de verificación'; ka = 'შემოწმების შეცდომა'; kk = 'Тексеру кезіндегі қате'; ro = 'Eroare la verificare'; ru = 'Ошибка проверки'; tr = 'Kontrol hatası'; uk = 'Помилка перевірки'; uz = 'Tekshirishda xatolik'");
		ПоказатьВопрос(Новый ОписаниеОповещения("СохранитьНастройкуПослеВопроса", ЭтаФорма, ЗакрытиеФормы), ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, ЗаголовокВопроса); 
	Иначе
		СохранитьНастройкуПродолжить(ЗакрытиеФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКод()
	
	РезультатПроверки = "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ПроверяемыйТекст = Элементы.ТекстовыйДокумент.ПолучитьТекст();
	#Иначе
		ПроверяемыйТекст = ТекстПроизвольногоКода;
	#КонецЕсли
	
	ДлинаПроверяемогоТекста = СтрДлина(ПроверяемыйТекст);
	СтрокаПоиска = "КлеверенсРезультатПК";
	ДлинаСтрокиПоиска = СтрДлина(СтрокаПоиска);
	
	Пока Истина Цикл
		
		НайденнаяПозиция = Найти(ПроверяемыйТекст, СтрокаПоиска);
		Если НайденнаяПозиция > 0 Тогда
			
			ВалиднаяПеременная = РасширитьСтрокуДоВалиднойПеременной(ПроверяемыйТекст, ДлинаПроверяемогоТекста, НайденнаяПозиция, ДлинаСтрокиПоиска);
			
			// Поломает либо целая переменная, либо свойство. Результат.Итого - не поломает
			ПозицияТочки = Найти(ВалиднаяПеременная, ".");
			Если ПозицияТочки > 0 Тогда
				СтрокаДоТочки = Сред(ВалиднаяПеременная, 1, ПозицияТочки - 1);
				СтрокаПослеТочки = Сред(ВалиднаяПеременная, ПозицияТочки + 1);
				ПеременнаяПоломаетКод = 
							(Найти(СтрокаДоТочки, СтрокаПоиска) > 0 и СтрокаДоТочки <> СтрокаПоиска)
							или Найти(СтрокаПослеТочки, СтрокаПоиска) > 0;
			Иначе
				ПеременнаяПоломаетКод = ВалиднаяПеременная <> СтрокаПоиска;
			КонецЕсли;
			
			Если ПеременнаяПоломаетКод Тогда
				РезультатПроверки = НСтр("be = 'Зменная ""%1"" можа зламаць выкананне праўльных кодаў. Рэкамендуецца перайменаваць зменную.'; en = 'Variable ""%1"" may break the execution of arbitrary codes. It is recommended to rename the variable.'; es = 'La variable ""%1"" puede interferir con la ejecución de códigos arbitrarios. Se recomienda cambiar el nombre de la variable.'; ka = '""%1"" ცვლადი შეიძლება დააკლოსოს პროცესის შესრულება. რეკომენდაციაა ცვლადის გადარქმევა.'; kk = '""%1"" аймақты орындау произвольді кодтарды орындауға ауыстыру мүмкіндігі бар. Аймақты қайта атандыру мақұл.'; ro = 'Variabila ""%1"" poate afecta execuția codurilor arbitrar. Se recomandă redenumirea variabilei.'; ru = 'Переменная ""%1"" может сломать выполнение произвольных кодов. Рекомендуется переименовать переменную.'; tr = '""%1"" değişkeni rastgele kodları çalıştırmayı bozabilir. Değişkeni yeniden adlandırmak önerilir.'; uk = 'Змінна ""%1"" може зламати виконання довільних кодів. Рекомендується перейменувати змінну.'; uz = '""%1"" ўзгарувчиси белгиланган кодларни бажаришни бузиши мумкин. Овоз бериш ўзгартиришни такрорлаш мақсадга ега.'");
				РезультатПроверки = _ЛокКонтекст.ЛокЯдро_СтрШаблон(РезультатПроверки, ВалиднаяПеременная);
				Прервать;
			КонецЕсли;
			
			ПроверяемыйТекст = Сред(ПроверяемыйТекст, НайденнаяПозиция + ДлинаСтрокиПоиска);
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Функция РасширитьСтрокуДоВалиднойПеременной(ПроверяемыйТекст, ДлинаПроверяемогоТекста, НайденнаяПозиция, ДлинаСтрокиПоиска)

	// расширяем к началу
	н = 0;
	Пока НайденнаяПозиция - (н + 1) > 0 Цикл
		
		ДобавляемыйСимвол = Сред(ПроверяемыйТекст, НайденнаяПозиция - (н + 1), 1);
		
		Если ПустаяСтрока(ДобавляемыйСимвол) Тогда
			Прервать;
		КонецЕсли;
		
		Если ДобавляемыйСимвол <> "." Тогда
			
			ПроверяемаяПеременная = Сред(ПроверяемыйТекст, НайденнаяПозиция - (н + 1), (н + 1) + ДлинаСтрокиПоиска);
			Попытка
				Тест = Новый Структура;
				Тест.Вставить(СтрЗаменить(ПроверяемаяПеременная, ".", ""), Истина);
			Исключение
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
	
		н = н + 1;
		
	КонецЦикла;
	
	// расширяем к концу
	к = -1;
	Пока НайденнаяПозиция + ДлинаСтрокиПоиска + (к + 1) <= ДлинаПроверяемогоТекста Цикл
		
		ДобавляемыйСимвол = Сред(ПроверяемыйТекст, НайденнаяПозиция + ДлинаСтрокиПоиска + (к + 1), 1);
		
		Если ПустаяСтрока(ДобавляемыйСимвол) Тогда
			Прервать;
		КонецЕсли;
		
		Если ДобавляемыйСимвол <> "." Тогда
			
			ПроверяемаяПеременная = Сред(ПроверяемыйТекст, НайденнаяПозиция - н, н + ДлинаСтрокиПоиска + (к + 2));
			Попытка
				Тест = Новый Структура;
				Тест.Вставить(СтрЗаменить(ПроверяемаяПеременная, ".", ""), Истина);
			Исключение
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
		
		к = к + 1;
		
	КонецЦикла;
	
	ВалиднаяПеременная = Сред(ПроверяемыйТекст, НайденнаяПозиция - н, н + ДлинаСтрокиПоиска + к + 1);
	
	Возврат ВалиднаяПеременная;
	
КонецФункции

