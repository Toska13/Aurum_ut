&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ПравилаОбменаТабличнаяЧасть Экспорт,
	ПравилаОбменаШапка Экспорт,
	РезультатРедактирования;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии()
	ЭтоБылТиповой = ЭтоТиповой;	
	Если ЭтоНоваяНастройка Тогда
		ID_ПроизвольногоКода = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("PC");
		Наименование = "НОВЫЙ ПРОИЗВОЛЬНЫЙ КОД";
		ЕстьИзмененияНаФорме = Истина;
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТекстовыйДокумент.УстановитьТекст(ТекстПроизвольногоКода);
		#КонецЕсли
		ЕстьИзмененияНаФорме = Ложь;
	КонецЕсли;
		
	РезультатРедактирования = "";
	
	ПравилаОбменаШапкаАдрес = ПоместитьВоВременноеХранилище(ПравилаОбменаШапка,Новый УникальныйИдентификатор());
	ПравилаОбменаТабличнаяЧастьАдрес = ПоместитьВоВременноеХранилище(ПравилаОбменаТабличнаяЧасть,Новый УникальныйИдентификатор());

	ОбновитьКлючНастройки();
	
	ЗаполнитьПолеПеременных();
	ЭтоТиповойПриИзменении("");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКлючНастройки()
	
