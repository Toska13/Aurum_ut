// Служебные процедуры
&НаКлиенте
Функция СгенерироватьПарольПользователя(ЧисловСимволовПароля, Индекс, ЭтоШК = Ложь)
	
	ГСЧ = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах() + Индекс);		
	
	Пароль = "";                          
	
	Если ЭтоШК Тогда
		ИспользуемыеСимволы = "01243456789";
	Иначе
		ИспользуемыеСимволы = "01243456789qwertyuiopasdfghjklzxcvbnm";
	КонецЕсли;
	
	КоличествоИспользуемыхСимволов = СтрДлина(ИспользуемыеСимволы);
	Пока СтрДлина(Пароль) < ЧисловСимволовПароля Цикл
		НовыйСимвол = Сред(ИспользуемыеСимволы, (ГСЧ.СлучайноеЧисло(1, КоличествоИспользуемыхСимволов)), 1);
		Пароль = Пароль + НовыйСимвол;
	КонецЦикла;                      
	
	Возврат Пароль;
	
КонецФункции         

