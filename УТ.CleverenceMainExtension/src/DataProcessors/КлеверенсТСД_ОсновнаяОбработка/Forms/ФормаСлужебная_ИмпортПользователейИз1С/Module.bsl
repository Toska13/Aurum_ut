&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗагрузитьТаблицуСкладовНаСервере(АдресСкладов);  
	ЗагрузитьГруппыПользователейНаСервере(АдресГруппыПользователей);          
	ЗагрузитьТаблицуИдентификаторов(АдресИдентификаторов);	
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПодборПользователей1С(Команда)

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ПодборПользователей1С = ПолучитьФорму("ОФ_ФормаСлужебная_ПодборПользователей1С", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ПодборПользователей1С = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ПодборПользователей1С", , ЭтаФорма);	
	#КонецЕсли
	
	ФормаСлужебная_ПодборПользователей1С.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСлужебная_ПодборПользователей1С._ЛокКонтекст 					= _ЛокКонтекст;	
	ФормаСлужебная_ПодборПользователей1С.СозданныеПользователиИмпорта	= СформироватьСписокУжеИмпортированныхПользователей();
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ПодборПользователей1СЗакрытие", ЭтаФорма);
	ФормаСлужебная_ПодборПользователей1С.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ПодборПользователей1С.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если Не ТаблицаПользователейMS.Количество() Тогда
		Сообщение = НСтр("be = 'Табліца імпарту карыстальнікаў не запоўнена.'; en = 'User import table is not filled.'; es = 'La tabla de importación de usuarios no está completa.'; ka = 'მომხმარებების იმპორტის ცხრილი არ არის შევსებული.'; kk = '1С-тен пайдаланушыларды імпорттау тізімі толтырылмаған.'; ro = 'Tabelul de import al utilizatorilor nu este completat.'; ru = 'Таблица импорта пользователей не заполнена.'; tr = 'Kullanıcı içe aktarma tablosu doldurulmamış.'; uk = 'Таблиця імпорту користувачів не заповнена.'; uz = ""Foydalanuvchilarni import qilish jadvali to'ldirilmagan.""");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;	
	
	Если Не ПроверкаЗаполненияПолей() Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ТаблицаСохраненаВФайл Тогда
		Сообщение = НСтр("be = 'Дадзеныя аўтарызацыі новых карыстальнікаў Cleverence неабходна раней захаваць.'; en = 'Authorization data for new Cleverence users must be saved in advance.'; es = 'Es necesario guardar previamente los datos de autorización de los nuevos usuarios de Cleverence.'; ka = 'Cleverence-ს ახალი მომხმარებლების ავტორიზაციის მონაცემები უნდა წინასწარ შეინახოთ.'; kk = 'Cleverence жаңа пайдаланушылардың авторлық деректерін алдын ала сақтау керек'; ro = 'Datele de autentificare ale noilor utilizatori Cleverence trebuie salvate în prealabil.'; ru = 'Данные авторизации новых пользователей Клеверенс необходимо предварительно сохранить.'; tr = 'Yeni Cleverence kullanıcılarının kimlik bilgileri önceden kaydedilmelidir.'; uk = 'Дані авторизації нових користувачів Cleverence необхідно передбачально зберегти.'; uz = ""Cleverence yangi foydalanuvchilarining autentifikatsiya ma'lumotlarini oldin saqlashingiz kerak.""");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;
			
	ПовторноеСозданиеПользователя = Ложь;           
	ТекстВопроса = НСтр("be = 'Наступныя карыстальнікі ўжо былі створаны раней:'; en = 'The following users have already been created earlier:'; es = 'Los siguientes usuarios ya han sido creados anteriormente:'; ka = 'შემდეგი მომხმარებელი უკვე წარმოებულია წინ:'; kk = 'Келесі пайдаланушылар алдында құрылған:'; ro = 'Următorii utilizatori au fost deja creați anterior:'; ru = 'Следующие пользователи уже были созданы ранее:'; tr = 'Aşağıdaki kullanıcılar zaten önceden oluşturulmuştur:'; uk = 'Наступні користувачі вже були створені раніше:'; uz = 'Кейинги фойдаланувчилар аввалдан яратилган:  '");
	Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл	
		Если СписокИдентификаторов.НайтиПоЗначению(СтрокаПользователя.Ид) <> Неопределено Тогда
			ТекстВопроса = ТекстВопроса + Символы.ПС + "	- " + СтрокаПользователя.Имя;
			ПовторноеСозданиеПользователя = Истина;
		КонецЕсли;
	КонецЦикла;   
	Если ПовторноеСозданиеПользователя Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС 
				+ НСтр("be = 'Перазапісаць?'; en = 'Overwrite?'; es = '¿Sobrescribir?'; ka = 'გადადება?'; kk = 'Қайта жазу керек пе?'; ro = 'Suprascrieți?'; ru = 'Перезаписать?'; tr = 'Üzerine yazılsın mı?'; uk = 'Перезаписати?'; uz = 'Ўзгартириш?'");
		ОповещениеЗаписатьИЗакрыть = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеЗаписатьИЗакрыть, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе     
		ЗаписатьИЗакрытьЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГенерацияШтрихкодов(Команда)                                    
	
	Если Не ТаблицаПользователейMS.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму("ОФ_ФормаСлужебная_ВводЗначенийЗаполнения", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВводЗначенийЗаполнения", , ЭтаФорма);	
		ФормаСлужебная_ВводЗначенийЗаполнения.РежимОткрытияОкна 		= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_ВводЗначенийЗаполнения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВводЗначенийЗаполнения._ЛокКонтекст 					= _ЛокКонтекст;		
	ФормаСлужебная_ВводЗначенийЗаполнения.Заголовок						= НСтр("be = 'Генерацыя штрыхкода'; en = 'Barcode generation'; es = 'Generación de código de barras'; ka = 'შტრიხკოდის გენერაცია'; kk = 'Штрихкодты жасау'; ro = 'Generare cod de bare'; ru = 'Генерация штрихкода'; tr = 'Barkod oluştur'; uk = 'Генерація штрихкоду'; uz = 'Shtrixkodni generatsiya qilish'");
	ФормаСлужебная_ВводЗначенийЗаполнения.ГенерацияПароля 				= Истина;	
	ФормаСлужебная_ВводЗначенийЗаполнения.МаксЧислоСимволов 			= 20;	
		
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие", ЭтаФорма, "ГенерацияШтрихкода");
	ФормаСлужебная_ВводЗначенийЗаполнения.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ВводЗначенийЗаполнения.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГруппу(Команда)
	
	Если Не Элементы.ТаблицаПользователейMS.ВыделенныеСтроки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму("ОФ_ФормаСлужебная_ВводЗначенийЗаполнения", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВводЗначенийЗаполнения", , ЭтаФорма);	
		ФормаСлужебная_ВводЗначенийЗаполнения.РежимОткрытияОкна 		= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_ВводЗначенийЗаполнения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВводЗначенийЗаполнения._ЛокКонтекст 					= _ЛокКонтекст;		
	ФормаСлужебная_ВводЗначенийЗаполнения.Заголовок						= НСтр("be = 'Запаўненне групы'; en = 'Fill group'; es = 'Rellenar grupo'; ka = 'ჯგუფის შევსება'; kk = 'Топты толтыру'; ro = 'Completarea grupului'; ru = 'Заполнение группы'; tr = 'Grubu doldur'; uk = 'Заповнення групи'; uz = ""Guruhni to'ldirish""");
	ФормаСлужебная_ВводЗначенийЗаполнения.ГенерацияПароля 				= Ложь;			
	ФормаСлужебная_ВводЗначенийЗаполнения.АдресХранилища 				= ВыгрузитьТаблицуГруппПользователейНаСервере();
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие", ЭтаФорма);
	ФормаСлужебная_ВводЗначенийЗаполнения.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ВводЗначенийЗаполнения.Открыть();

