&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем СтруктураТабличныхЧастейДокумента Экспорт,
	ТаблицаРеквизитовДополнительная Экспорт,
	ТаблицаРеквизитовИсходная Экспорт,
	ПредыдущееЗначение;
	
#Область ОбработчикиСобытийФормы
   
&НаКлиенте
Процедура ПриОткрытии()
	
	ТипДокумента1ССиноним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].Синоним;
	ТипДокументаMSСиноним = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Синоним;
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		
		Заголовок = НСтр("be = 'Cleverence: Налада загрузкі палёў шапкі дакумента'; en = 'Cleverence: Setting up loading fields of the document header'; es = 'Cleverence: Configuración de carga de campos de encabezado de documentos'; ka = 'Cleverence: დოკუმენტის თავისი ველების ჩატვირთვის პარამეტრები'; kk = 'Cleverence: Құжаттың шапка өрістерін жүктеу орнату'; ro = 'Cleverence: Configurarea încărcării câmpurilor antetului documentului'; ru = 'Клеверенс: Настройка загрузки полей шапки документа'; tr = 'Cleverence: Belge başlığı alanlarının yüklenme ayarları'; uk = 'Cleverence: Налаштування завантаження полів шапки документа'; uz = 'Cleverence: Hujjat sarlavhasi maydonlarini yuklash sozlash'");
		СписокРеквизитов1С = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].Реквизиты;
		СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Реквизиты);
		СтруктураТабличныхЧастейДокумента = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С];
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковТабличнойЧасти.Свертка = РежимСверткиЭлементаУправления.Верх;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовГруппировать.Видимость = Ложь;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовОбработчикПодбораКоличества.Видимость = Ложь;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовОчищатьПередЗагрузкой.Видимость = Ложь;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовПравилоПоиска.Видимость = Ложь;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовПравилоПоискаСиноним.Видимость = Ложь;
		#Иначе	
			Элементы.РамкаОбработчикиТЧ.Видимость = Ложь;
			Элементы.ТаблицаРеквизитовГруппировать.Видимость = Ложь;
			Элементы.ТаблицаРеквизитовОбработчикПодбораКоличества.Видимость = Ложь;
			Элементы.ТаблицаРеквизитовОчищатьПередЗагрузкой.Видимость = Ложь;
			Элементы.ТаблицаРеквизитовПравилоПоиска.Видимость = Ложь;
			Элементы.ТаблицаРеквизитовПравилоПоискаСиноним.Видимость = Ложь;
		#КонецЕсли
		
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовГруппировать.Видимость = Истина;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовОбработчикПодбораКоличества.Видимость = Истина;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовОчищатьПередЗагрузкой.Видимость = Истина;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовПравилоПоиска.Видимость = Истина;
			Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовПравилоПоискаСиноним.Видимость = Истина;
		#Иначе	
			Элементы.ТаблицаРеквизитовГруппировать.Видимость = Истина;
			Элементы.ТаблицаРеквизитовОбработчикПодбораКоличества.Видимость = Истина;
			Элементы.ТаблицаРеквизитовОчищатьПередЗагрузкой.Видимость = Истина;
			Элементы.ТаблицаРеквизитовПравилоПоиска.Видимость = Ложь;
			Элементы.ТаблицаРеквизитовПравилоПоискаСиноним.Видимость = Истина;
