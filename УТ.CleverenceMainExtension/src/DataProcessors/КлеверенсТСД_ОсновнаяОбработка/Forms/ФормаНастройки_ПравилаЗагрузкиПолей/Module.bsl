		СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
		ДополнительнаяТаблица = Неопределено;
		
		Для Каждого ДопТаблица Из СписокДопТаблиц Цикл
			Если ДопТаблица.Представление = ИмяТабличнойЧастиMS Тогда
				ДополнительнаяТаблица = ДопТаблица; 
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ДополнительнаяТаблица = Неопределено Тогда
			мСписокРеквизитовMS = Новый Массив(Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыТЧ));
			//СписокРеквизитовMS.Добавить("КлючСвязиСерий", "КлючСвязиСерий");
			//СписокРеквизитовMS.Добавить("КлючСвязиСерийныхНомеров", "КлючСвязиСерийныхНомеров");
			мСписокРеквизитовMS.Добавить(Новый Структура("Значение,Ключ,Uni, Имя","КлючСвязи", "КлючСвязи","", "КлючСвязи")); //Трошин И.В. 27.01.2019 
			// + ZHKN 03.10.2017
			Для Каждого ЭлементСписка Из СписокТаблицДляСвязиПоКлючу Цикл
				мСписокРеквизитовMS.Добавить(Новый Структура("Значение,Ключ,Uni,Имя",ЭлементСписка.Представление, "Ключ связи для """+ЭлементСписка.Представление+"""","", "КлючСвязи"));
			КонецЦикла;
			// - ZHKN 03.10.2017
			СписокРеквизитовMS = Новый ФиксированныйМассив(мСписокРеквизитовMS);
		Иначе	
			СписокРеквизитовMS = Новый ФиксированныйМассив(ДополнительнаяТаблица.Значение);	
		КонецЕсли;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;
			Элементы.ПанельОбработчикПослеОткрытияФормыДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;
		#Иначе	
			Элементы.РамкаОбработчикиДокументов.Видимость = Ложь;
			Элементы.РамкаОбработчикПослеОткрытияФормыДокумента.Видимость = Ложь;
		#КонецЕсли
		
		ИмяТабличнойЧасти1ССиноним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].ТабличныеЧасти[ИмяТабличнойЧасти1С].Синоним;
		ИмяТабличнойЧастиMSСиноним = ИмяТабличнойЧастиMS;
		
		СписокПравилПоиска.Добавить("Равно", НСтр("be = 'Роўна або абедзве пустыя'; en = 'Equal or both empty'; es = 'Igual o ambos vacíos'; ka = 'თანადასჯერ ან ორივე ცარიელია'; kk = 'Теңді немесе екісі де бос'; ro = 'Egal sau ambele goale'; ru = 'Равно или оба пустые'; tr = 'Eşit veya her ikisi de boş'; uk = 'Рівно або обидва порожні'; uz = 'Теҳликада ёки ҳаммаси бўш'"));
		СписокПравилПоиска.Добавить("РавноПусто1С", НСтр("be = 'Роўна альбо ў 1С пуста'; en = 'Equal or empty in 1C'; es = 'Igual o vacío en 1C'; ka = 'თანამდევრობა ან 1C-ში ცარიელია'; kk = '1С-де немесе Мобильді құрылғыда бос  '; ro = 'Egal sau gol în 1C'; ru = 'Равно или в 1С пусто'; tr = ""Eşit veya 1C'de boş""; uk = 'Рівно або в 1С порожньо'; uz = ""Teng yoki 1C-da bo'sh  """));
		СписокПравилПоиска.Добавить("РавноПустоТСД", НСтр("be = 'Роўна альбо на Мабільнае прылада пуста'; en = 'Equal or empty on the Mobile device'; es = 'Igual o vacío en el dispositivo móvil'; ka = 'თანამდევრობა ან მობილურ მოწყობაში ცარიელია'; kk = '1С-де немесе Мобильді құрылғыда бос'; ro = 'Egal sau gol pe dispozitivul mobil'; ru = 'Равно или на ТСД пусто'; tr = 'Eşit veya Mobil cihazda boş'; uk = 'Рівно або на Мобільний пристрій порожньо'; uz = ""Teng yoki Mobil qurilma bo'sh"""));
		
	КонецЕсли;
	
	ОбновитьПредставленияСпискаДокументов1С();
	
	ОбновитьСписокПроизвольныхКодов();
	
	// Список Глобальных параметров
	ТаблицаГлобальныхПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ГлобальныеПараметры", Новый Структура());
	
	Если ТипЗнч(ТаблицаГлобальныхПараметров) = Тип("Массив") Тогда 
		Для Каждого СтрокаПараметра Из ТаблицаГлобальныхПараметров Цикл
		    Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			СписокГлобальныхПараметров.Добавить(СтрокаПараметра.ID_Параметра, СтрокаПараметра.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	// Список вариантов обработчиков загрузки
	СписокВариантовОбработчиков.Добавить(0, НСтр("be = 'Без апрацоўніка'; en = 'Without handler'; es = 'Sin controlador'; ka = 'დამუშავების გარეშე'; kk = 'Өңдеушісіз  '; ro = 'Fără manipulator'; ru = 'Без обработчика'; tr = 'İşleyici olmadan'; uk = 'Без обробника'; uz = ""Ilova yo'q  """));
	СписокВариантовОбработчиков.Добавить(1, НСтр("be = 'Апрацоўчык па змаўчанні'; en = 'Default handler'; es = 'Controlador predeterminado'; ka = 'ნაგუშავების გამომტაცება'; kk = 'Өңдеуші әдепкі'; ro = 'Procesorul implicit'; ru = 'Обработчик по умолчанию'; tr = 'Varsayılan işlemci'; uk = 'Обробник за замовчуванням'; uz = 'Sukutiy muhandis'"));
	СписокВариантовОбработчиков.Добавить(2, НСтр("be = 'Свой апрацоўчык'; en = 'Your handler'; es = 'Tu procesador'; ka = 'თქვენი დამუშაველი'; kk = 'Өз өңдеуші'; ro = 'Propriul procesor'; ru = 'Свой обработчик'; tr = 'Kendi işleyici'; uk = 'Ваш обробник'; uz = ""O'zingizning qayta ishlovchi"""));
	СписокВариантовОбработчиков.Добавить(3, НСтр("be = 'Давольны код'; en = 'Arbitrary code'; es = 'Código arbitrario'; ka = 'შემუშავების კოდი'; kk = 'Өзге код'; ro = 'Cod arbitrar'; ru = 'Произвольный код'; tr = 'Rastgele Kod'; uk = 'Довільний код'; uz = 'Tasodifiy kodi'"));
	
	// Список категорий приемника
	СписокТиповПриемника.Добавить("Реквизит1С", 	НСтр("be = 'Фіксаваны рэквізіт 1С'; en = 'Fixed attribute 1C'; es = 'Atributo fijo de 1C'; ka = '1C-ის მკაცრი ატრიბუტი'; kk = '1С фиксировандағы реквизит'; ro = 'Atribut fix 1C'; ru = 'Фиксированный реквизит 1С'; tr = '1C sabit nitelik'; uk = 'Фіксований реквізит 1С'; uz = ""1Cning o'zlashtirilgan atributi"""));
	СписокТиповПриемника.Добавить("НовыйРеквизит", 	НСтр("be = 'Прамежкавае значэнне'; en = 'Intermediate value'; es = 'Valor intermedio'; ka = 'შუა მნიშვნელობა'; kk = 'Орташа мағына  '; ro = 'Valoarea intermediară'; ru = 'Промежуточное значение'; tr = 'Ara değer'; uk = 'Проміжне значення'; uz = 'Orta qiymat  '"));
	
