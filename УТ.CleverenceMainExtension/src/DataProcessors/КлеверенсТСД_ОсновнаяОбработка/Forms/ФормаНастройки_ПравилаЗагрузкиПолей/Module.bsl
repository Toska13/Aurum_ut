&НаКлиенте
Процедура ВидОбработчика_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки = Элемент.Имя;
	Обработчик_ИзменитьЗначение = ЭтаФорма[ИмяЭлементаОбработки] <> ВыбранноеЗначение;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаПриИзменении(Элемент)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	СтруктураОбработчика	= СтруктураВидовОбработчиков[ИмяЭлементаОбработки];
	ИмяОбработчика			= СтруктураОбработчика.Тип; 
	СтрокаОбработчика		= СтруктураОбработчика.Обработчик;
	
	Элементы[СтрокаОбработчика].СписокВыбора.Очистить();
	
	БезЗаполнения	= ЭтаФорма[ИмяЭлементаОбработки] = 0;
	ПоУмолчанию		= ЭтаФорма[ИмяЭлементаОбработки] = 1;
	СвойОбработчик	= ЭтаФорма[ИмяЭлементаОбработки] = 2;	
	ПроизвольныйКод	= ЭтаФорма[ИмяЭлементаОбработки] = 3;
	
	Если ПоУмолчанию Тогда 		
		
		// Формируем стандартное имя процедуры
		ТипОбработчика = СтрЗаменить(ИмяОбработчика, "ТабличнойЧасти", "ТЧ") + ?(Не ПустаяСтрока(ИмяТабличнойЧасти1С), "_" + ИмяТабличнойЧасти1С, "");
		ЭтаФорма[СтрокаОбработчика] = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика(ТипОбработчика, ТипДокумента1С);
		
	ИначеЕсли СвойОбработчик Тогда
		
		// Оставляем пустое строковое поле для ручного ввода имени процедуры, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
		КонецЕсли;
		
	ИначеЕсли ПроизвольныйКод Тогда
		
		// Очищаем строку обработчика и предоставляем возможность выбора из списка подходящих кодов, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
			
			// В обычных формах подменяем поле ввода обработчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[СтрокаОбработчика].Видимость = Ложь;
				Элементы[СтрокаОбработчика + "Выбор"].Видимость = Истина;
				Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Очистить();
				Элементы[СтрокаОбработчика + "Выбор"].ВыделенныйТекст = "";
			#КонецЕсли
			
			Элементы[СтрокаОбработчика].ВыделенныйТекст = "";					
		Иначе
			ТекЗначение = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ЭтаФорма[СтрокаОбработчика]);
			Если ТекЗначение <> Неопределено Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#Иначе
					Элементы[СтрокаОбработчика].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#КонецЕсли
			КонецЕсли;                                                                                             			
		КонецЕсли;					
		
	ИначеЕсли БезЗаполнения Тогда
		
		ЭтаФорма[СтрокаОбработчика] = "";	
		
	КонецЕсли;
	
	ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Возвращаем видимость поля ввода обработчика, если выбран не произвольный код
		Если Не ПроизвольныйКод Тогда
			Элементы[СтрокаОбработчика].Видимость = Истина;
			Элементы[СтрокаОбработчика + "Выбор"].Видимость = Ложь;							
		Иначе
			ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика + "Выбор"];		
		КонецЕсли;                                                                                                                             		    		
	#КонецЕсли
	
	УстановкаОформленияСтрокиОбработчикаЗагрузки(ЭлементСтрокиОбработчика, ЭтаФорма[СтрокаОбработчика], ЭтаФорма[ИмяЭлементаОбработки]);
	
	Если Обработчик_ИзменитьЗначение Тогда
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаНачалоВыбораОбработчикаЗаполнения(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
		
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
	
		ПредыдущееЗначение 		= ЭтаФорма[ИмяЭлементаОбработки];		
		СтандартнаяОбработка 	= Ложь;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаСписка_ПроизвольныеКоды", ПредыдущееЗначение); 
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаОткрытиеОбработчикаЗаполнения(Элемент, СтандартнаяОбработка)
		
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
	
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
				
		СтандартнаяОбработка 	= Ложь;
		Если ПустаяСтрока(ЭтаФорма[ИмяЭлементаОбработки]) Тогда
			Возврат;
		КонецЕсли;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаНастройки_ПроизвольныйКод", ЭтаФорма[ИмяЭлементаОбработки], Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, ИмяФормыПК, ТекущееЗначение, ЭтоФормаЭлемента = Ложь) 
	
	ЭтоОбработчикЗаполнения = Ложь;
	ДопКлючНастройки 		= "";
	ДопТипОбработки			= "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды = ПолучитьФорму("ОФ_" + ИмяФормыПК, ЭтаФорма);
	#Иначе
		Форма_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма." + ИмяФормыПК, , ЭтаФорма, ЭтаФорма);
		Форма_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	Форма_ПроизвольныеКоды._ЛокКонтекст 			= _ЛокКонтекст;
	Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ВРЕГ(ИмяЭлементаОбработки), "ОБРАБОТЧИК_") <> 0 Тогда			
		ДопКлючНастройки							= ПолучитьКлючНастройкиОбработчикаЗаполнения(ИмяЭлементаОбработки);
		ДопТипОбработки								= СтрЗаменить(ДопКлючНастройки, "Загрузка_", "");
		Форма_ПроизвольныеКоды.КлючНастройки 		= ДопКлючНастройки;			
		ЭтоОбработчикЗаполнения						= Истина;			
	Иначе
		Форма_ПроизвольныеКоды.КлючНастройки 		= КлючНастройки;
	КонецЕсли;
	Форма_ПроизвольныеКоды.ТипИсходногоДокумента1С 	= ТипДокумента1С;
	Форма_ПроизвольныеКоды.ИмяТабличнойЧасти1С 		= ИмяТабличнойЧасти1С;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= ТаблицаРеквизитовДополнительная;
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= ТаблицаРеквизитовДополнительная;
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
	КонецЕслИ;
	
	Если ЭтоФормаЭлемента Тогда
		Форма_ПроизвольныеКоды.ЭтоНоваяНастройка	= Ложь;				
		
		ТаблицаПроизвольныхКодов	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды", Истина);
		ДанныеПроизвольногоКода 	= _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ТаблицаПроизвольныхКодов, "ID_ПроизвольногоКода", ТекущееЗначение);
		
		ЗаполнитьЗначенияСвойств(Форма_ПроизвольныеКоды, ДанныеПроизвольногоКода);
	КонецЕсли; 
	
	ДопПараметрыОповещения = Новый Структура("ПредыдущееЗначение, СтрокаОбработчика, ДопТипОбработки, ЭтоОбработчикЗаполнения", 
		ТекущееЗначение, 
		ИмяЭлементаОбработки, 
		ДопТипОбработки,
		ЭтоОбработчикЗаполнения);
	
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие", ЭтаФорма, ДопПараметрыОповещения);
	Форма_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		Форма_ПроизвольныеКоды.Открыть();		
	#КонецЕсли 	

КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ОбновитьСписокПроизвольныхКодов(ДопПараметры.ДопТипОбработки);
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика + "Выбор";
	#Иначе
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	#КонецЕсли      	
	ИмяОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	
	Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.Очистить();
	
	ЗаполнитьСписокВыбора(Элементы[ИмяПоляОбработчикаСобытия], ?(ДопПараметры.ЭтоОбработчикЗаполнения, СписокПроизвольныхКодовОбработчиков, СписокПроизвольныхКодов));	
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Если ДопПараметры.ЭтоОбработчикЗаполнения Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		Иначе
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		КонецЕсли;
	Иначе 
		Если ДопПараметры.ЭтоОбработчикЗаполнения Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ВыбранноеЗначение);
		Иначе
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;		
	ИначеЕсли Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.НайтиПоЗначению(НайденныйЭлементСписка.Значение) = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;
	Иначе
		ЭтаФорма[ИмяОбработчикаСобытия] = НайденныйЭлементСписка.Значение;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ЗаполнениеПоУмолчанию()
	
	// Для корректной интеграции в существующие настройки в случае заполненности обработчика устанавливаем его вид как "Свой обработчик"
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередЗаполнениемДокумента");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеЗаполненияДокумента");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеОткрытияФормыДокумента");
		
		ОбработкаЗаполненныхОбработчиковЗагрузки(МассивИменРеквизитов);
		
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередЗаполнениемТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеЗаполненияТабличнойЧасти");
		
		ОбработкаЗаполненныхОбработчиковЗагрузки(МассивИменРеквизитов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеСоответствияВидовОбработчиковЗагрузки()
	
	СтруктураВидовОбработчиков = Новый Структура;
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПередЗаполнениемДокумента", 				
		Новый Структура("Обработчик, Тип", 
			"Обработчик_ПередЗаполнениемДокумента", 
			"ПередЗаполнениемДокумента"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПослеЗаполненияДокумента", 				
		Новый Структура("Обработчик, Тип",
			"Обработчик_ПослеЗаполненияДокумента", 
			"ПослеЗаполненияДокумента"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПослеОткрытияФормыДокумента", 			
		Новый Структура("Обработчик, Тип",
			"Обработчик_ПослеОткрытияФормыДокумента", 
			"ПослеОткрытияФормыДокумента"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти", 	
		Новый Структура("Обработчик, Тип", 
			"Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти",
			"ПередЗаполнениемСтрокиТабличнойЧасти"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПередЗаполнениемТабличнойЧасти",
		Новый Структура("Обработчик, Тип", 
			"Обработчик_ПередЗаполнениемТабличнойЧасти", 
			"ПередЗаполнениемТабличнойЧасти"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти",
		Новый Структура("Обработчик, Тип", 
			"Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти", 
			"ПослеЗаполненияСтрокиТабличнойЧасти"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПослеЗаполненияТабличнойЧасти",
		Новый Структура("Обработчик, Тип",
			"Обработчик_ПослеЗаполненияТабличнойЧасти", 
			"ПослеЗаполненияТабличнойЧасти"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненныхОбработчиковЗагрузки(МассивИменРеквизитов)
	
	Для Каждого РеквизитОбработчика Из МассивИменРеквизитов Цикл
		
		РеквизитВидаОбработчика = СтрЗаменить(РеквизитОбработчика, "Обработчик", "ВидОбработчика");
		Если Не ПустаяСтрока(ЭтаФорма[РеквизитОбработчика]) Тогда
			Если Не ЗначениеЗаполнено(ЭтаФорма[РеквизитВидаОбработчика]) Тогда
				ЭтаФорма[РеквизитВидаОбработчика] = 2; // "Свой обработчик"
			КонецЕсли;
		Иначе
			ЭтаФорма[РеквизитВидаОбработчика] = 0; // "Без обработчика"
		КонецЕсли;
		
		Если ЭтаФорма[РеквизитВидаОбработчика] = 3 Тогда // "Произвольный код"
			
			// В обычных формах подменяем поле ввода обарботчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[РеквизитОбработчика].Видимость 			= Ложь;				
				Элементы[РеквизитОбработчика + "Выбор"].Видимость 	= Истина;					
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика + "Выбор"], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаЗагрузки(Элементы[РеквизитОбработчика + "Выбор"], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#Иначе
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаЗагрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#КонецЕсли
		Иначе 
			УстановкаОформленияСтрокиОбработчикаЗагрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
		КонецЕсли;		

		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы[РеквизитВидаОбработчика].Значение = ЭтаФорма[РеквизитВидаОбработчика];
		#КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОформленияСтрокиОбработчикаЗагрузки(ЭлементСтрокаОбработчика, ЗначениеСтрокаОбработчика, КодВидаОбработчика)
	
	БезЗаполнения	= КодВидаОбработчика = 0;
	ПоУмолчанию		= КодВидаОбработчика = 1;
	СвойОбработчик	= КодВидаОбработчика = 2;	
	ПроизвольныйКод	= КодВидаОбработчика = 3;

	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементСтрокаОбработчика.РежимВыбораИзСписка	= ПроизвольныйКод;				
		ЭлементСтрокаОбработчика.КнопкаВыбора 			= ПроизвольныйКод;		    		
		ЭлементСтрокаОбработчика.КнопкаВыпадающегоСписка= Ложь;
	#Иначе
		ЭлементСтрокаОбработчика.Значение				= ЗначениеСтрокаОбработчика;
	#КонецЕсли                                          
	ЭлементСтрокаОбработчика.ТолькоПросмотр 			= ПоУмолчанию Или БезЗаполнения;     				
	ЭлементСтрокаОбработчика.ЦветТекста 				= ?(ПоУмолчанию, WebЦвета.Серый, Новый Цвет(51, 51, 51));
	ЭлементСтрокаОбработчика.Шрифт 						= Новый Шрифт(ЭлементСтрокаОбработчика.Шрифт,,,, ПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКорректностьДобавленныхОбработчиков()
	
	КонтрольПройден = Истина;
	
	МассивВидовОбработчиков = Новый Массив;
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередЗаполнениемДокумента, "ВидОбработчика_ПередЗаполнениемДокумента"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеЗаполненияДокумента, "ВидОбработчика_ПослеЗаполненияДокумента"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеОткрытияФормыДокумента, "ВидОбработчика_ПослеОткрытияФормыДокумента"));
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередЗаполнениемТабличнойЧасти, "ВидОбработчика_ПередЗаполнениемТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти, "ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти, "ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеЗаполненияТабличнойЧасти, "ВидОбработчика_ПослеЗаполненияТабличнойЧасти"));
	КонецЕсли;

	Для Каждого ВидОбработчика Из МассивВидовОбработчиков Цикл
		
		ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Обработчик;
		ТипОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Тип;
		
		// Проверка своего обработчика и произвольного кода на пустоту
		Если ВидОбработчика.Значение = 2 Или ВидОбработчика.Значение = 3 Тогда 						
			Если ПустаяСтрока(ЭтаФорма[ИмяОбработчика]) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("be = 'Апрацоўчык не запоўнены!'; en = 'Handler is not filled in!'; es = '¡Controlador no completado!'; ka = 'გამუშავების გამომტაცება არ არის შევსებული!'; kk = 'Өңдеуші толтырылмаған!'; ro = 'Procesorul nu este completat!'; ru = 'Обработчик не заполнен!'; tr = 'İşlemci boş bırakılamaz!'; uk = 'Обробник не заповнений!'; uz = ""Muhandis to'ldirilmagan!""");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("be = 'Не запоўнены свой апрацоўнік <%1>!'; en = 'Your handler <%1> is not filled in!'; es = '¡No se ha completado el controlador personalizado <%1>!'; ka = 'თქვენი დამატების მეთოდი <%1> არ არის შევსებული!'; kk = 'Сіздің өңдеушіңіз <%1> толтырылмаған!'; ro = 'Handlerul propriu nu este completat <%1>!'; ru = 'Не заполнен свой обработчик <%1>!'; tr = 'Kendi işleyiciniz <%1> doldurulmadı!'; uk = 'Не заповнений власний обробник <%1>!'; uz = ""O'z xizmat ko'rsatuvchisi to'ldirilmagan <%1>!""");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 					
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		// Проверка своего обработчика на наличие в интеграционной обработке
		Если ВидОбработчика.Значение = 2 Тогда
			Если ВидОбработчика.Имя = "ВидОбработчика_ПослеОткрытияФормыДокумента" Тогда
				РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчикаФормы(ЭтаФорма[ИмяОбработчика]);
			Иначе
				СтруктураПараметров = Новый Структура("АдресаПеременных, ДанныеДляЗагрузки_Строка, ДанныеДокументаMS, Док1СОснование, Док1СРезультат, ДокументТСД, СтрокаДокумента, СтрокаНастройки, СтруктураПоискаКлючаСвязи, ТЧ, ТекущиеНастройкиMS");
				РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ЭтаФорма[ИмяОбработчика], СтруктураПараметров);
			КонецЕсли;
			
			Если Не РезультатПроверки.Статус Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("be = 'Апрацоўчык не знойдзены ў падключанай інтэграцыйнай апрацоўцы!'; en = 'Handler not found in connected integration processing!'; es = '¡Controlador no encontrado en el procesamiento de integración conectado!'; ka = 'გამუშავების გამომტაცება არ მოიძებნა დაკავშირებულ ინტეგრაციულ დამუშავებაში!'; kk = 'Өңдеуші қосылған интеграциялық өңдеуде табылмады!'; ro = 'Procesorul nu a fost găsit în procesarea integrată conectată!'; ru = 'Обработчик не найден в подключенной интеграционной обработке!'; tr = 'Bağlı entegrasyon işlemcilerinde işlemci bulunamadı!'; uk = 'Обробник не знайдений у підключеній інтеграційній обробці!'; uz = ""Qo'shilgan integratsiya ishlovda muhandis topilmadi!""");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("be = 'Не знойдзены свой апрацоўнік <%1> у падключанай інтэграцыйнай апрацоўцы!'; en = 'Own handler <%1> not found in the connected integration process!'; es = 'No se encontró su controlador <%1> en el procesamiento de integración conectado!'; ka = 'თქვენი დამატების მემკვიდრე <%1> ვერ მოიძებნა დაკავშირებულ ინტეგრაციულ დამუშავებაში!'; kk = 'Тіркелген интеграциялық өңдеуші <%1> табылмады!'; ro = 'Nu a fost găsit propriul handler <%1> în procesul de integrare conectat!'; ru = 'Не найден свой обработчик <%1> в подключенной интеграционной обработке!'; tr = 'Bağlı entegrasyon işleminde <%1> işleyici bulunamadı!'; uk = 'Не знайдений власний обробник <%1> в підключеній інтеграційній обробці!'; uz = '<%1> илова ишловчиси топилмади интеграция ишловчисида!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли; 			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКлючНастройкиОбработчикаЗаполнения(ИмяЭлемента)
	
	ИмяКлючаНастройки = "";
	
	Если ИмяЭлемента = "Обработчик_ПослеОткрытияФормыДокумента" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеОткрытияФормы";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередЗаполнениемДокумента" Тогда
		ИмяКлючаНастройки = "Загрузка_ПередЗагрузкойДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеЗаполненияДокумента" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеЗагрузкиДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередЗаполнениемТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПередЗаполнениемТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеЗаполненияТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеЗаполненияТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПередЗаполнениемСтрокиТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеЗаполненияСтрокиТЧ";
	КонецЕсли;		
	
	Возврат ИмяКлючаНастройки;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставленияСпискаДокументов1С()
	
	Для каждого Реквизит1С ИЗ СписокРеквизитов1С Цикл
		Если ЗначениеЗаполнено(Реквизит1С.Значение) И НЕ ЗначениеЗаполнено(Реквизит1С.Представление) Тогда
			Реквизит1С.Представление = Реквизит1С.Значение;					
		КонецЕсли;					
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков()
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередЗагрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеЗагрузкиДокумента");
	МассивТиповОбъектов.Добавить("ПослеОткрытияФормы");
	МассивТиповОбъектов.Добавить("ПередЗаполнениемТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияТЧ");
	МассивТиповОбъектов.Добавить("ПередЗаполнениемСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияСтрокиТЧ");

	Возврат МассивТиповОбъектов;
	
КонецФункции

&НаСервере
Функция ПроверитьКорректностьЗаполненияПолей()

	КонтрольПройден = Истина;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаРеквизитов;
	#Иначе
		ТЗ = РеквизитФормыВЗначение("ТаблицаРеквизитов");
	#КонецЕсли
	
	МассивПроверяемыхКолонок = Новый Массив;
	МассивПроверяемыхКолонок.Добавить("ТипПриемникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ПрЗначение");
	МассивПроверяемыхКолонок.Добавить("ТипИсточникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ИсЗначение");
	
	ОтмеченныеСтроки = ТЗ.НайтиСтроки(Новый Структура("Загружать", Истина));
	Для каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
	
		Для Каждого ПроверяемаяКолонка Из МассивПроверяемыхКолонок Цикл
			ПроверяемоеЗначение = ОтмеченнаяСтрока[ПроверяемаяКолонка];
			Если Не ЗначениеЗаполнено(ПроверяемоеЗначение) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					ЭлементФормы = ЭтаФорма.Элементы.Найти("ТаблицаРеквизитов" + ПроверяемаяКолонка);
					Если ЭлементФормы <> Неопределено Тогда
						Заголовок = ЭлементФормы.Заголовок;
					Иначе
						Заголовок = ПроверяемаяКолонка;
					КонецЕсли;
					
					Сообщение = Новый СообщениеПользователю;
					Текст = НСтр("be = 'Не запоўнена значэнне ў калонцы %1'; en = 'Value is not filled in column %1'; es = 'No se ha completado el valor en la columna %1'; ka = 'შესავსები არ არის კოლონკა %1-ში'; kk = '%1 бағанды толтыруға болмайды'; ro = 'Valoarea nu este completată în coloana %1'; ru = 'Не заполнено значение в колонке %1'; tr = '%1 sütununda değer doldurulmadı'; uk = 'Не заповнено значення в колонці %1'; uz = '%1 ustunida qiymat kiritilmagan'");
					Текст = РеквизитФормыВЗначение("Объект").ГлЯдро_СтрШаблон(Текст, Заголовок);
					Сообщение.Текст = Текст;
					Сообщение.Поле = "ТаблицаРеквизитов[" + ТЗ.Индекс(ОтмеченнаяСтрока) + "]." + ПроверяемаяКолонка;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					НомерСтроки = ТЗ.Индекс(ОтмеченнаяСтрока) + 1;
					ТекстПредупреждения = НСтр("be = 'Не запоўнена значэнне ў калонцы %1 у радку %2'; en = 'Value is not filled in column %1 in row %2'; es = 'No se ha completado el valor en la columna %1 en la fila %2'; ka = 'შესავსები არ არის კოლონკა %1-ში, სტრიქონში %2-ში'; kk = '%1 бағанды толтыруға болмайды, %2 жолда'; ro = 'Valoarea nu este completată în coloana %1, în rândul %2'; ru = 'Не заполнено значение в колонке %1 в строке %2'; tr = '%2 satırındaki %1 sütununda değer doldurulmadı'; uk = 'Не заповнено значення в колонці %1 в рядку %2'; uz = '%2 qatorida %1 ustunida qiymat kiritilmagan'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТЗ.Колонки[ПроверяемаяКолонка].Заголовок, Строка(НомерСтроки));
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
