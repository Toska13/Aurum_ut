	СписокТиповИсточника.Добавить("ГлобальныйПараметр", 	НСтр("be = 'Глабальны параметр'; en = 'Global parameter'; es = 'Parámetro global'; ka = 'გლობალური პარამეტრი'; kk = 'Құрылымдық параметр'; ro = 'Parametru global'; ru = 'Глобальный параметр'; tr = 'Genel parametre'; uk = 'Глобальний параметр'; uz = 'Global parametr'"));	
	СписокТиповИсточника.Добавить("ПроизвольноеЗначение", 	НСтр("be = 'Давольная велічыня'; en = 'Arbitrary value'; es = 'Valor arbitrario'; ka = 'შემუშავების მნიშვნელობა'; kk = 'Өзге мән'; ro = 'Valoare arbitrară'; ru = 'Произвольное значение'; tr = 'Rastgele Değer'; uk = 'Довільне значення'; uz = 'Tasodifiy qiymat'"));	
	СписокТиповИсточника.Добавить("ПроизвольныйКод", 		НСтр("be = 'Давольны код'; en = 'Arbitrary code'; es = 'Código arbitrario'; ka = 'შემუშავების კოდი'; kk = 'Өзге код'; ro = 'Cod arbitrar'; ru = 'Произвольный код'; tr = 'Rastgele Kod'; uk = 'Довільний код'; uz = 'Tasodifiy kodi'"));	
	
	// Список правил сопоставления для ссылочных типов
	СписокСпособовСопоставления.Добавить("СтрокаGUID",       НСтр("be = 'Пошук па GUID'; en = 'Search by GUID'; es = 'Búsqueda por GUID'; ka = 'GUID-ის მიხედვით ძიება'; kk = 'GUID бойынша іздеу'; ro = 'Căutare după GUID'; ru = 'Поиск по GUID'; tr = ""GUID'e göre arama""; uk = 'Пошук за GUID'; uz = ""GUID bo'yicha izlash"""));
	СписокСпособовСопоставления.Добавить("Наименование",     НСтр("be = 'Пошук па Найменаванні (для даведнікаў)'; en = 'Search by Name (for directories)'; es = 'Búsqueda por Nombre (para directorios)'; ka = 'სახელის მიხედვით ძიება (სამრავლებისთვის)'; kk = 'Атауы бойынша іздеу (аңыздар үшін)'; ro = 'Căutare după Denumire (pentru dicționare)'; ru = 'Поиск по Наименованию (для справочников)'; tr = ""Ad'a göre arama (referanslar için)""; uk = 'Пошук за Найменуванням (для довідників)'; uz = ""Nomi bo'yicha izlash (ma'lumotlar uchun)"""));
	СписокСпособовСопоставления.Добавить("Код",              НСтр("be = 'Пошук па Кодзе (для даведнікаў)'; en = 'Search by Code (for directories)'; es = 'Búsqueda por Código (para directorios)'; ka = 'კოდის მიხედვით ძიება (სამრავლებისთვის)'; kk = 'Код бойынша іздеу (аңыздар үшін)'; ro = 'Căutare după Cod (pentru dicționare)'; ru = 'Поиск по Коду (для справочников)'; tr = ""Kod'a göre arama (referanslar için)""; uk = 'Пошук за Кодом (для довідників)'; uz = ""Kodingiz bo'yicha izlash (ma'lumotlar uchun)"""));
	СписокСпособовСопоставления.Добавить("КакЕсть",          НСтр("be = 'Як ёсць (любы тып)'; en = 'As is (any type)'; es = 'Como está (cualquier tipo)'; ka = 'როგორც არის (ნებისმიერი ტიპი)'; kk = 'Көрсетілгендей (кез келген түрі)'; ro = 'Așa cum este (oricare tip)'; ru = 'Как есть (любой тип)'; tr = 'Mevcut durum (herhangi bir tür)'; uk = 'Як є (будь-який тип)'; uz = 'Joriy hol (istalgan turi)'"));
	СписокСпособовСопоставления.Добавить("ПодборКоличества", НСтр("be = 'Падбор колькасці'; en = 'Selection of quantity'; es = 'Selección de cantidad'; ka = 'რაოდენობის არჩევა'; kk = 'Санын таңдау'; ro = 'Selecție a cantității'; ru = 'Подбор количества'; tr = 'Miktar seçimi'; uk = 'Підбір кількості'; uz = 'Miqdorini tanlash'"));
	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипПриемникаСиноним,СписокТиповПриемника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипИсточникаСиноним,СписокТиповИсточника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовСинонимПриемника,СписокРеквизитов1С);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним,СписокСпособовСопоставления);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПравилоПоискаСиноним,СписокПравилПоиска);
	
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОткрытияФормыДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередЗаполнениемДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеЗаполненияДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередЗаполнениемТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеЗаполненияТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	
	// Видимость и значения элементов
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.НадписьТабличнаяЧасть1С.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
		Элементы.НадписьТабличнаяЧастьMS.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";	
	#КонецЕсли
	Элементы.ИмяТабличнойЧасти1ССиноним.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
	Элементы.ИмяТабличнойЧастиMSСиноним.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементНастройкиПоУмолчанию = Элементы.КомПанельТаблицы.Кнопки.Найти("НастройкиПоУмолчанию");
		Если ЭлементНастройкиПоУмолчанию <> Неопределено Тогда
			Элементы.КомПанельТаблицы.Кнопки.Удалить(ЭлементНастройкиПоУмолчанию); //Пока скроем кнопку восстановления настроек, т.к. механизм еще не готов
		КонецЕсли;
	#Иначе
		Элементы.ТаблицаРеквизитовНастройкиПоУмолчанию.Видимость = Ложь; //Пока скроем кнопку восстановления настроек, т.к. механизм еще не готов
	#КонецЕсли
	
	// Временное решение. В дальнейшем таблица должна передаваться напрямую
	Если ТипЗнч(ТаблицаРеквизитовИсходная) = Тип("Массив") Тогда
		Для Каждого СтрокаИсходнойТаблицы Из ТаблицаРеквизитовИсходная Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);			
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ТаблицаРеквизитовДополнительная) = Тип("Массив") Тогда
		ТаблицаРеквизитовДополнительнаяНовая = Новый Массив();
		ТаблицаРеквизитовДополнительнаяНовая.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Загружать,ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,ПравилоПоискаСиноним,Группировать,ОчищатьПередЗагрузкой,ОбработчикПодбораКоличества,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,ПравилоПоиска"));
		
		Для Каждого СтрокаИсходнойТаблицы Из ТаблицаРеквизитовДополнительная Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Новый Структура("Загружать,ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,ПравилоПоискаСиноним,Группировать,ОчищатьПередЗагрузкой,ОбработчикПодбораКоличества,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,ПравилоПоиска");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
			
			ТаблицаРеквизитовДополнительнаяНовая.Добавить(НоваяСтрока);
		КонецЦикла;
		ТаблицаРеквизитовДополнительная = ТаблицаРеквизитовДополнительнаяНовая;
	КонецЕсли;
	// Временное решение. Окончание.
	Для Каждого Элем Из ТаблицаРеквизитов Цикл
		Элем.ПрЗначение = ?(Элем.ТипПриемника = "НовыйРеквизит",Элем.ИмяПриемника,Элем.СинонимПриемника);
		Элем.ИсЗначение = ?(Элем.ТипИсточника = "ПроизвольноеЗначение",Элем.ЗначениеИсточника,Элем.СинонимИсточника);
	КонецЦикла;
	
	ВидОбработчика_ЗаполнениеПоУмолчанию();
	ЗаполнениеСоответствияВидовОбработчиковЗагрузки();

	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Если Не ПроверитьКорректностьДобавленныхОбработчиков() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьКорректностьЗаполненияПолей() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	Результат.Вставить("ТаблицаНастроек", _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов));
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		Результат.Вставить("ВидОбработчика_ПередЗаполнениемДокумента", 		ВидОбработчика_ПередЗаполнениемДокумента);
		Результат.Вставить("ВидОбработчика_ПослеЗаполненияДокумента",  		ВидОбработчика_ПослеЗаполненияДокумента);
		Результат.Вставить("ВидОбработчика_ПослеОткрытияФормыДокумента",  	ВидОбработчика_ПослеОткрытияФормыДокумента);
		Результат.Вставить("Обработчик_ПередЗаполнениемДокумента", 			Обработчик_ПередЗаполнениемДокумента);
		Результат.Вставить("Обработчик_ПослеЗаполненияДокумента",  			Обработчик_ПослеЗаполненияДокумента);
		Результат.Вставить("Обработчик_ПослеОткрытияФормыДокумента",  		Обработчик_ПослеОткрытияФормыДокумента);
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		Результат.Вставить("ВидОбработчика_ПередЗаполнениемТабличнойЧасти",       	ВидОбработчика_ПередЗаполнениемТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти", 	ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти",  	ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеЗаполненияТабличнойЧасти",        	ВидОбработчика_ПослеЗаполненияТабличнойЧасти);
		Результат.Вставить("Обработчик_ПередЗаполнениемТабличнойЧасти",       		Обработчик_ПередЗаполнениемТабличнойЧасти);
		Результат.Вставить("Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти", 		Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти",  		Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеЗаполненияТабличнойЧасти",        		Обработчик_ПослеЗаполненияТабличнойЧасти);
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(Результат);
КонецПроцедуры

&НаКлиенте 
Процедура ОбновитьСписокПроизвольныхКодов(ДопТипОбработки = "")
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		Направление = "Загрузка";
		ТипОбъекта = "Шапка";		
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		Направление = "Загрузка";
		ТипОбъекта = "ТабличнаяЧасть";
	КонецЕсли;	
	
	// Формируем список произвольных кодов без обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ТипОбъекта);
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодов", Отбор);
	
	// Формируем список произвольных кодов для обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ?(ПустаяСтрока(ДопТипОбработки), ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков(), ДопТипОбработки));
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодовОбработчиков", Отбор);	
	
КонецПроцедуры

&НаКлиенте 
Процедура ЗаполнитьСписокПроизвольныхКодов(ИмяСписка, Отбор)
		
	ЭтаФорма[ИмяСписка].Очистить();
	
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЭтаФорма[ИмяСписка].Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	Если ЭтаФорма[ИмяСписка].Количество() = 0 Тогда
		ЭтаФорма[ИмяСписка].Добавить("");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Элемент,Список)
	
	Приемник = Элемент.СписокВыбора;
	Если ТипЗнч(Список) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элем Из Список Цикл
			Приемник.Добавить(Элем.Значение,Элем.Ключ);	
		КонецЦикла;
		Приемник.СортироватьПоЗначению();
	Иначе
		Для Каждого Элем Из Список Цикл
			Приемник.Добавить(Элем.Значение,Элем.Представление);	
		КонецЦикла;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ТипЗнч(Элемент) = Тип("ПолеВыбора") Тогда
			Элемент.РежимВыбораИзСписка = Истина;
			Элемент.КнопкаСпискаВыбора = Истина;
		КонецЕсли;		
	#Иначе
		Элемент.РежимВыбораИзСписка = Истина;
		Элемент.КнопкаВыпадающегоСписка = Истина;		
	#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипПриемникаСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокТиповПриемника.НайтиПоЗначению(ТекущаяСтрока.ТипПриемникаСиноним);
	
	ТекущаяСтрока.ТипПриемникаСиноним = НайденныйЭлементСписка.Представление;
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ТипПриемника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимПриемника = "";
		ТекущаяСтрока.ИмяПриемника = "";
		Если ТекущаяСтрока.ТипПриемника = "НовыйРеквизит" Тогда
			ТекущаяСтрока.Загружать = Ложь;
		КонецЕсли;
	КонецЕсли;
	текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
	#Иначе
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
	#КонецЕсли
	ОбновитьВидимостьЭлементовСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипПриемникаСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ТипПриемника;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПрЗначениеПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	НайденныйЭлементСписка = Неопределено;
	Если ТекущаяСтрока.ТипПриемника = "Реквизит1С" Тогда
		НайденныйЭлементСписка = СписокРеквизитов1С.НайтиПоЗначению(ТекущаяСтрока.ПрЗначение);
		Если НайденныйЭлементСписка = Неопределено Тогда
			ТекущаяСтрока.ИмяПриемника = "";
			ТекущаяСтрока.ПрЗначение = "";
		Иначе
			ТекущаяСтрока.СинонимПриемника = НайденныйЭлементСписка.Представление;
			ТекущаяСтрока.ИмяПриемника = НайденныйЭлементСписка.Значение;
			ТекущаяСтрока.ПрЗначение = НайденныйЭлементСписка.Представление;
		КонецЕсли;
	Иначе
		ТекущаяСтрока.ИмяПриемника = ТекущаяСтрока.ПрЗначение;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПрЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипИсточникаСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокТиповИсточника.НайтиПоЗначению(ТекущаяСтрока.ТипИсточникаСиноним);
	
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ТипИсточникаСиноним = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ТипИсточника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.ЗначениеИсточника = Неопределено;
	КонецЕсли;
	
	// Способ сопоставления
	Если ТекущаяСтрока.ТипИсточника = "РеквизитMS" Тогда
		ТекущаяСтрока.СпособСопоставления = "";
		ТекущаяСтрока.СпособСопоставленияСиноним = "";
	Иначе
		ТекущаяСтрока.СпособСопоставления = "КакЕсть";
		ТекущаяСтрока.СпособСопоставленияСиноним = "Как есть (любой тип)";
	КонецЕсли;
	
	// Правило поиска
	Если ТекущаяСтрока.ТипИсточника <> "РеквизитMS" Тогда
		ТекущаяСтрока.ПравилоПоиска = "";
		ТекущаяСтрока.ПравилоПоискаСиноним = "";
	КонецЕсли;
	
	Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним.ТолькоПросмотр = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	
	ТекущаяСтрока.ОбработчикПодбораКоличества = "";
	
	текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
	#Иначе
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
	#КонецЕсли
	ОбновитьВидимостьЭлементовСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипИсточникаСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ТипИсточника;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение" Тогда
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.ЗначениеИсточника = ТекущаяСтрока.ИсЗначение;
		ОбновитьВидимостьЭлементовСтроки();
	Иначе	
		НайденныйЭлементСписка = Неопределено;
		Если ТекущаяСтрока.ТипИсточника = "РеквизитMS" Тогда
			НайденныйЭлементСписка = Неопределено;
			Для каждого РеквизитMS из СписокРеквизитовMS Цикл
				Если РеквизитMS.Значение = ТекущаяСтрока.ИсЗначение
					ИЛИ РеквизитMS.Имя = ТекущаяСтрока.ИсЗначение Тогда
					НайденныйЭлементСписка = Новый Структура("Значение,Представление",РеквизитMS.Имя,РеквизитMS.Ключ);	
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);
		ИначеЕсли ТекущаяСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
			НайденныйЭлементСписка = СписокГлобальныхПараметров.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);
		КонецЕсли;
		Если НайденныйЭлементСписка = Неопределено Тогда
			ТекущаяСтрока.СинонимИсточника = "";
			ТекущаяСтрока.ИмяИсточника = "";
			ТекущаяСтрока.ЗначениеИсточника = Неопределено;
			ТекущаяСтрока.ИсЗначение = Неопределено;
		Иначе
			Если НайденныйЭлементСписка.Значение = ПредыдущееЗначение Тогда
				ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
			Иначе
				ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
				ТекущаяСтрока.ИмяИсточника = НайденныйЭлементСписка.Значение;
				ТекущаяСтрока.ЗначениеИсточника = Неопределено;
			КонецЕсли;
			ТекущаяСтрока.ИсЗначение = НайденныйЭлементСписка.Представление;
		КонецЕсли;
		текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		#Иначе
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
			Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
		
		ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
		
		СтандартнаяОбработка = Ложь;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСписка_ПроизвольныеКоды = ПолучитьФорму("ОФ_ФормаСписка_ПроизвольныеКоды",ЭтаФорма);
		#Иначе
			ФормаСписка_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПроизвольныеКоды", , ЭтаФорма, ЭтаФорма);
			ФормаСписка_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаСписка_ПроизвольныеКоды._ЛокКонтекст = _ЛокКонтекст;
		ФормаСписка_ПроизвольныеКоды.КлючНастройки = КлючНастройки;
		ФормаСписка_ПроизвольныеКоды.ТипИсходногоДокумента1С = ТипДокумента1С;
		ФормаСписка_ПроизвольныеКоды.ИмяТабличнойЧасти1С = ИмяТабличнойЧасти1С;
		
		АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
		
		Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаШапка = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть = ТаблицаРеквизитовДополнительная;
		ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаШапка = ТаблицаРеквизитовДополнительная;
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		КонецЕслИ;
		ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыЗакрытие",ЭтаФорма,ПредыдущееЗначение);
		ФормаСписка_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСписка_ПроизвольныеКоды.ОткрытьМодально();
		#Иначе
			ФормаСписка_ПроизвольныеКоды.Открыть();		
		#КонецЕсли
		
	КонецЕсли;
	
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение" И ТекущаяСтрока.ИсЗначение = Неопределено; 
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыЗакрытие(ВыбранноеЗначение,ПредыдущееЗначение) Экспорт
	ОбновитьСписокПроизвольныхКодов();
	
	Если ВыбранноеЗначение = Неопределено Тогда
		НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ПредыдущееЗначение);
	Иначе 
		НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ВыбранноеЗначение);
	КонецЕсли;
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИсЗначение = Неопределено;
	Иначе
		ТекущаяСтрока.ИмяИсточника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ИсЗначение = НайденныйЭлементСписка.Представление;
		текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		#Иначе
			Элемент = Элементы.ТаблицаРеквизитов.ТекущийЭлемент;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
			Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
		#КонецЕсли
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	Элементы.ТаблицаРеквизитовИсЗначение.СписокВыбора.Очистить();	
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаСпискаВыбора = НЕ ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	#Иначе
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаВыпадающегоСписка = ?(НЕ ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#КонецЕсли
	Элементы.ТаблицаРеквизитовИсЗначение.КнопкаОчистки = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	
	Если ТекущаяСтрока.ТипИсточника = "РеквизитMS" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокРеквизитовMS);
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокПроизвольныхКодов);
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокГлобальныхПараметров);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеОчистка(Элемент, СтандартнаяОбработка)
	Элементы.ТаблицаРеквизитов.ТекущиеДанные.ЗначениеИсточника = Неопределено;
	Элементы.ТаблицаРеквизитов.ТекущиеДанные.ИсЗначение = Неопределено;
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовСпособСопоставленияСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.СпособСопоставленияСиноним = "ПодборКоличества" Тогда
		ИмяОбработчикаПодбораКоличества = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика("ПодборКоличества", ТипДокумента1С);
		РезультатПроверки = ПроверитьДоступностьОбработчика(ИмяОбработчикаПодбораКоличества, ТекущаяСтрока.ИмяПриемника);
		Если РезультатПроверки.Статус Тогда
			ТекущаяСтрока.ОбработчикПодбораКоличества = ИмяОбработчикаПодбораКоличества;
			НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ТекущаяСтрока.СпособСопоставленияСиноним);
		Иначе
			ТекущаяСтрока.ОбработчикПодбораКоличества = "";
			НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ПредыдущееЗначение);
		КонецЕсли;
		Сообщить(РезультатПроверки.Сообщение); 
		ТекущаяСтрока.ПравилоПоиска = "";
		ТекущаяСтрока.ПравилоПоискаСиноним = "";
		ТекущаяСтрока.Группировать = Ложь;
	Иначе
		ТекущаяСтрока.ОбработчикПодбораКоличества = "";
		НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ТекущаяСтрока.СпособСопоставленияСиноним);
	КонецЕсли;
	Если НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.СпособСопоставления = "";
		ТекущаяСтрока.СпособСопоставленияСиноним = "";
	Иначе
		ТекущаяСтрока.СпособСопоставления = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СпособСопоставленияСиноним = НайденныйЭлементСписка.Представление;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДоступностьОбработчика(ИмяОбработчика, ИмяПоля)
	
	СтруктураПараметров = Новый Структура("ПодборКоличества_Колонка1С", ИмяПоля);
	
	Возврат _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ИмяОбработчика, СтруктураПараметров);
	
КонецФункции

&НаКлиенте
Процедура ТаблицаРеквизитовСпособСопоставленияСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.СпособСопоставления;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПравилоПоискаСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокПравилПоиска.НайтиПоЗначению(ТекущаяСтрока.ПравилоПоискаСиноним);
	
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ПравилоПоискаСиноним = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ПравилоПоиска = НайденныйЭлементСписка.Значение;
	ИначеЕсли НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.ПравилоПоиска = "";
	КонецЕсли;
	
	// Группировка
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПравилоПоиска) Тогда
		ТекущаяСтрока.Группировать = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПравилоПоискаСинонимОчистка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;

	ТекущаяСтрока.ПравилоПоискаСиноним = "";
	ТекущаяСтрока.ПравилоПоиска = "";
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ПоместитьВоВременноеХранилище(ТаблицаРеквизитов,Новый УникальныйИдентификатор());
	#Иначе
	    ТЗ = РеквизитФормыВЗначение("ТаблицаРеквизитов");
		Возврат ПоместитьВоВременноеХранилище(ТЗ,ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьЭлементовСтроки()
	ТекДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Элементы.ТаблицаРеквизитовИсЗначение.СписокВыбора.Очистить();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаСпискаВыбора = НЕ ТекДанные.ТипИсточника = "ПроизвольноеЗначение";
	#Иначе
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаВыпадающегоСписка = ?(НЕ ТекДанные.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#КонецЕсли
	Элементы.ТаблицаРеквизитовИсЗначение.РежимВыбораИзСписка = ?(НЕ (ТекДанные.ТипИсточника = "ПроизвольноеЗначение"),Истина,Ложь);
	Элементы.ТаблицаРеквизитовИсЗначение.КнопкаОчистки = ТекДанные.ТипИсточника = "ПроизвольноеЗначение";
	Если ТекДанные.ТипИсточника = "РеквизитMS" Тогда
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокРеквизитовMS);
	ИначеЕсли ТекДанные.ТипИсточника = "ПроизвольныйКод" Тогда 
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокПроизвольныхКодов);
	ИначеЕсли ТекДанные.ТипИсточника = "ГлобальныйПараметр" Тогда 
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокГлобальныхПараметров);		
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовПрЗначение.КнопкаСпискаВыбора = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
	#Иначе
		Элементы.ТаблицаРеквизитовПрЗначение.КнопкаВыпадающегоСписка = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
		Элементы.ТаблицаРеквизитовПрЗначение.РежимВыбораИзСписка 	 = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
	#КонецЕсли
		
	Если ТекДанные.ТипПриемника = "НовыйРеквизит" Тогда
		Элементы.ТаблицаРеквизитовПрЗначение.СписокВыбора.Очистить();
	Иначе
		Элементы.ТаблицаРеквизитовПрЗначение.СписокВыбора.Очистить();
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПрЗначение,СписокРеквизитов1С);
	КонецЕсли;
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = ТекДанные.ТипИсточника = "ПроизвольноеЗначение" И ТекДанные.ИсЗначение = Неопределено;
КонецПроцедуры

