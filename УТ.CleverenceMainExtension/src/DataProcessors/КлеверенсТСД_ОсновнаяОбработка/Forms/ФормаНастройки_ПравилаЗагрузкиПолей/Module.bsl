		Заголовок = НСтр("be = 'Cleverence: Налада загрузкі палёў таблічнай часткі дакумента'; en = 'Cleverence: Setting up loading fields of the document table part'; es = 'Cleverence: Configuración de carga de campos de partes de tablas de documentos'; ka = 'Cleverence: დოკუმენტის ცხადი ნაწილების ველების ჩატვირთვის პარამეტრები'; kk = 'Cleverence: Құжаттың тізімді бөлігінің өрістерін жүктеу орнату'; ro = 'Cleverence: Configurarea încărcării câmpurilor părții tabelei a documentului'; ru = 'Клеверенс: Настройка загрузки полей табличной части документа'; tr = 'Cleverence: Belge tablo bölümü alanlarının yüklenme ayarları'; uk = 'Cleverence: Налаштування завантаження полів табличної частини документа'; uz = 'Cleverence: Hujjat jadval qismi maydonlarini yuklash sozlash'");
