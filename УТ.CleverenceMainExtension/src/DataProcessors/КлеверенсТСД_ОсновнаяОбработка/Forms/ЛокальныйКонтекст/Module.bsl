	ФормаНастройки_ПравилаЗагрузкиПолей._ЛокКонтекст 								= ЭтаФорма;
	ФормаНастройки_ПравилаЗагрузкиПолей.КлючНастройки 								= "Загрузка_ШапкаДокумента";
	ФормаНастройки_ПравилаЗагрузкиПолей.КонтрольКоличества 							= СтрокаНастройки.КонтрольКоличества;
	ФормаНастройки_ПравилаЗагрузкиПолей.ТипДокумента1С 								= СтрокаНастройки.ТипРезультирующегоДокумента1С;
	ФормаНастройки_ПравилаЗагрузкиПолей.ТипДокументаMS 								= СтрокаНастройки.ТипДокументаMS;
	ФормаНастройки_ПравилаЗагрузкиПолей.ТаблицаРеквизитовИсходная 					= СтрокаНастройки.НастройкаВыгрузкиПолей;	
	
	ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПередЗаполнениемДокумента 	= СтрокаНастройки.ВидОбработчика_ПередЗаполнениемДокумента;
	ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПослеЗаполненияДокумента 	= СтрокаНастройки.ВидОбработчика_ПослеЗаполненияДокумента;
	ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПослеОткрытияФормыДокумента 	= СтрокаНастройки.ВидОбработчика_ПослеОткрытияФормыДокумента;  
	
	
	ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПередЗаполнениемДокумента 		= СтрокаНастройки.Обработчик_ПередЗаполнениемДокумента;
	ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПослеЗаполненияДокумента 		= СтрокаНастройки.Обработчик_ПослеЗаполненияДокумента;
	ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПослеОткрытияФормыДокумента 		= СтрокаНастройки.Обработчик_ПослеОткрытияФормыДокумента;
	
	
	ФормаНастройки_ПравилаЗагрузкиПолей.АвтоТестОткрытияФормы = Истина;
	ОП = Новый ОписаниеОповещения("ПолучитьТекущееВремяЗакрытияФормы", ЭтаФорма, ВремяНачалаПроверкиФормы);
	ФормаНастройки_ПравилаЗагрузкиПолей.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПравилаЗагрузкиПолей.Открыть();	
	#Иначе	
		ФормаНастройки_ПравилаЗагрузкиПолей.Открыть();
	#КонецЕсли

	ЛокЯдро_Пауза(10);
	
	Если ФормаНастройки_ПравилаЗагрузкиПолей.Открыта() Тогда
