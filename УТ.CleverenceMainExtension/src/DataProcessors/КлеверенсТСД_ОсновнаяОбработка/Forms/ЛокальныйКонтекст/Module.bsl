	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", ЛокЯдро_СтрШаблон("Начало открытия формы %1",
		СтрЗаменить(ИмяСобытия, "ЛокЯдро_ПроверитьОткрытиеФорм_", "")));
	
	ВремяНачалаПроверкиФормы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	////////////////////////////////////////////////////////////////////
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ОтборыДокументов = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаСписка_ОтборыДокументов", ЭтаФорма);
	#Иначе
		ФормаСписка_ОтборыДокументов = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСписка_ОтборыДокументов", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;
	НаименованиеУзла = ДанныеТекущегоУзла.Наименование;
	НастройкиУзла 		   = Неопределено;
	ЕстьЧастнаяБаза = ЕстьЧастнаяБаза;
	Если ЕстьЧастнаяБаза Тогда
		ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
		Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
			НастройкиУзла = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы, "ID_Узла", ID_ТекущегоУзла);
		КонецЕсли;
	КонецЕсли;
	ID_БазыMS 		 = ?(НастройкиУзла <> Неопределено И НастройкиУзла.ИспользоватьЧастнуюБазу, НастройкиУзла.ЧастнаяБазаMS, ПараметрыПодключенияMS.Ид);
	ТипБазы 		 = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	
	ФормаСписка_ОтборыДокументов.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСписка_ОтборыДокументов._ЛокКонтекст = ЭтаФорма;
	ФормаСписка_ОтборыДокументов.ТипОбмена = "Интерактивный";
	ФормаСписка_ОтборыДокументов.ID_Узла = ID_ТекущегоУзла;
	ФормаСписка_ОтборыДокументов.ID_БазыMS = ID_БазыMS;
	ФормаСписка_ОтборыДокументов.НаименованиеУзла = НаименованиеУзла;
	ФормаСписка_ОтборыДокументов.ТипБазы = ТипБазы;
	
	
	ФормаСписка_ОтборыДокументов.АвтоТестОткрытияФормы = Истина;
	ОП = Новый ОписаниеОповещения("ПолучитьТекущееВремяЗакрытияФормы", ЭтаФорма, ВремяНачалаПроверкиФормы);
	ФормаСписка_ОтборыДокументов.ОписаниеОповещенияОЗакрытии = ОП;
	
	
	ФормаСписка_ОтборыДокументов.Открыть();
	
	ЛокЯдро_Пауза(10);
	
	Если ФормаСписка_ОтборыДокументов.Открыта() Тогда
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьОткрытиеФорм", "Ошибка", "Не дождались окончания открытия формы ФормаСписка_ОтборыДокументов");
		ФормаСписка_ОтборыДокументов.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_БизнесПроцесс() Экспорт

	ИмяСобытия = "ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_БизнесПроцесс";

	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", ЛокЯдро_СтрШаблон("Начало открытия формы %1",
		СтрЗаменить(ИмяСобытия, "ЛокЯдро_ПроверитьОткрытиеФорм_", "")));
	
	ВремяНачалаПроверкиФормы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	////////////////////////////////////////////////////////////////////
	
	//получим первую попавшуюся настройку БП
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	НашлиСтроку = Ложь;
	Если НЕ НастройкиБизнесПроцессов = Ложь И ЗначениеЗаполнено(НастройкиБизнесПроцессов)
		И НастройкиБизнесПроцессов.Количество() > 0 //И НастройкиБизнесПроцессов[0].Свойство("КолонкиТаблицыЗначений")
		Тогда	
		Для Каждого СтрокаНастройки Из НастройкиБизнесПроцессов Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаНастройки.Используется = Ложь Тогда
				Продолжить;
			КонецЕсли;
			
			НашлиСтроку = Истина;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Если НашлиСтроку = Ложь Тогда
		ВызватьИсключение "Не удалось получить настройку БП!! ";
	КонецЕсли;
	
	ЭтоКопирование = Ложь;
	ЭтоНовыйБизнесПроцесс = Ложь;
	ID_Узла = ДанныеТекущегоУзла.ID_Узла;
	НаименованиеУзла = ДанныеТекущегоУзла.Наименование;
	
	ЭтоТиповойБизнесПроцесс = Ложь;	
	ПолноеЗначениеНастройки = Неопределено;
	Если НЕ ЭтоНовыйБизнесПроцесс ИЛИ ЭтоКопирование Тогда
		ПолноеЗначениеНастройки = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессов,"ID_БизнесПроцесса",СтрокаНастройки.ID_БизнесПроцесса);
	КонецЕсли;
	
	Если ЭтоКопирование Тогда
		ЭтоТиповойБизнесПроцесс = Ложь;
	ИначеЕсли ПолноеЗначениеНастройки <> Неопределено Тогда
		ЭтоТиповойБизнесПроцесс = ПолноеЗначениеНастройки.ЭтоТиповойБизнесПроцесс;
	КонецЕсли;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_БизнесПроцесс = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаНастройки_БизнесПроцесс",ЭтаФорма);
		ФормаНастройки_БизнесПроцесс.Параметры = Новый Структура("ID_Узла,ЭтоТиповойБизнесПроцесс",ID_Узла,ЭтоТиповойБизнесПроцесс);
	#Иначе
		ФормаНастройки_БизнесПроцесс = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаНастройки_БизнесПроцесс",Новый Структура("ID_Узла,ЭтоТиповойБизнесПроцесс",ID_Узла,ЭтоТиповойБизнесПроцесс) , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_БизнесПроцесс.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаНастройки_БизнесПроцесс._ЛокКонтекст = ЭтаФорма;
	ФормаНастройки_БизнесПроцесс.НаименованиеУзла = НаименованиеУзла;
	ФормаНастройки_БизнесПроцесс.ID_Узла = ID_Узла;
	ФормаНастройки_БизнесПроцесс.ЭтоНовыйБизнесПроцесс = ЭтоНовыйБизнесПроцесс;
	
	Если ПолноеЗначениеНастройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ФормаНастройки_БизнесПроцесс, ПолноеЗначениеНастройки);
		#Если ВебКлиент Тогда
			// В веб-клиенте через ЗаполнитьЗначенияСвойств не заполняются значения экспортных переменных модуля формы. Заполним их
			Если ПолноеЗначениеНастройки.Свойство("НастройкаВыгрузкиПолей") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаВыгрузкиПолей = ПолноеЗначениеНастройки.НастройкаВыгрузкиПолей;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаВыгрузкиТЧ") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаВыгрузкиТЧ = ПолноеЗначениеНастройки.НастройкаВыгрузкиТЧ;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаЗагрузкиПолей") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаЗагрузкиПолей = ПолноеЗначениеНастройки.НастройкаЗагрузкиПолей;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаЗагрузкиТЧ") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаЗагрузкиТЧ = ПолноеЗначениеНастройки.НастройкаЗагрузкиТЧ;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("СвязиТабличныхЧастей") Тогда
				ФормаНастройки_БизнесПроцесс.СвязиТабличныхЧастей = ПолноеЗначениеНастройки.СвязиТабличныхЧастей;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаПредставленийРеквизитовДокумента") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаПредставленийРеквизитовДокумента = ПолноеЗначениеНастройки.НастройкаПредставленийРеквизитовДокумента;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаПоследовательностиБПМассивСтруктур") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаПоследовательностиБПМассивСтруктур = ПолноеЗначениеНастройки.НастройкаПоследовательностиБПМассивСтруктур;	
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	Если ПолноеЗначениеНастройки = Неопределено 
		ИЛИ ПолноеЗначениеНастройки.ЗаписыватьДокументПослеЗагрузки = Ложь Тогда
		ФормаНастройки_БизнесПроцесс.ЗаписыватьДокументПослеЗагрузки = "НеЗаписывать";
	ИначеЕсли ПолноеЗначениеНастройки.ЗаписыватьДокументПослеЗагрузки = Истина Тогда
		ФормаНастройки_БизнесПроцесс.ЗаписыватьДокументПослеЗагрузки = "Всегда";
	КонецЕсли;
	
	Если ЭтоКопирование Тогда
		ФормаНастройки_БизнесПроцесс.Название = "(Копия) "+ФормаНастройки_БизнесПроцесс.Название;
	ИначеЕсли ЭтоНовыйБизнесПроцесс Тогда
		ФормаНастройки_БизнесПроцесс.Название = "НОВЫЙ БИЗНЕС-ПРОЦЕСС";
	КонецЕсли;
	ФормаНастройки_БизнесПроцесс.ЭтоТиповойБизнесПроцесс = ЭтоТиповойБизнесПроцесс;
	
	ФормаНастройки_БизнесПроцесс.АвтоТестОткрытияФормы = Истина;
	ОП = Новый ОписаниеОповещения("ПолучитьТекущееВремяЗакрытияФормы", ЭтаФорма, ВремяНачалаПроверкиФормы);
	ФормаНастройки_БизнесПроцесс.ОписаниеОповещенияОЗакрытии = ОП;
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_БизнесПроцесс.Открыть();
	#Иначе
		ФормаНастройки_БизнесПроцесс.Открыть();
	#КонецЕсли
	
	ЛокЯдро_Пауза(10);
	
	Если ФормаНастройки_БизнесПроцесс.Открыта() Тогда
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьОткрытиеФорм", "Ошибка", "Не дождались окончания открытия формы ФормаНастройки_БизнесПроцесс");
		ФормаНастройки_БизнесПроцесс.Закрыть();
	КонецЕсли;
Конецпроцедуры	

