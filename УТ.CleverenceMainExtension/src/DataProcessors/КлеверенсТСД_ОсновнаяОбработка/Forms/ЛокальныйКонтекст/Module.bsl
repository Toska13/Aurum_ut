		Сообщить(Сообщение + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); 
		Возврат СписокПолей;
	КонецПопытки;	
	
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
