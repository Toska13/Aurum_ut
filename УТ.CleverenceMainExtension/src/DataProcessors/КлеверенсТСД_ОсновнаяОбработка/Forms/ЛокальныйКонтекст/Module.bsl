		КонецЕсли;
			
		СписокРеквизитов.Добавить(Новый Структура("Значение,Ключ,Uni",ИмяПоля, ИмяПоля, ЛокЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(uni)));
