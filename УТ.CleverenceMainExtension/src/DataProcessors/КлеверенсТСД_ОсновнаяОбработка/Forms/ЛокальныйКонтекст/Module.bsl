&НаКлиенте
Функция ЛокЯдро_ТекстДемо(ПараметрыПроверки) Экспорт
	
	ПроверяемоеУстройство = "";
	Событие = "ПоУмолчанию";
	Если ЗначениеЗаполнено(ПараметрыПроверки) Тогда
		Если ПараметрыПроверки.Свойство("Событие") Тогда
			Событие = ПараметрыПроверки.Событие;
		КонецЕсли;
		
		Если ПараметрыПроверки.Свойство("ИдУстройства") Тогда
			ПроверяемоеУстройство = ПараметрыПроверки.ИдУстройства;
		КонецЕсли;		
	КонецЕсли;
	
	МассивСтрок = Новый Массив;	
	
	ТекстПредупреждение 				= НСтр("ru = 'Данная обработка будет работать в демо режиме. Приобретите продление подписки на обновления и техническую поддержку. У следующих устройств закончилась подписка на обновление:'; en = 'This process will work in demo mode. Purchase an extension for updates and technical support. The following devices have expired update subscriptions:'; kk = 'Бұл өңдеу демо режимінде жұмыс істейді. Жаңартулар мен техникалық қолдау үшін жазылу үлгісін қайта сатып алыңыз. Жаңарту үшін жазылу үлгісі аяқталған келесі құрылғылар:'; uz = 'Ushbu ishlov demo rejimida ishlaydi. Yangilanishlar va texnik yordam uchun obuna sotib oling. Quyidagi qurilmalar yangilanish obunasi tugagan:'; be = 'Гэтая апрацоўка будзе працаваць у дэма-рэжыме. Прыдбайце прадленне падпіскі на абнаўленні і тэхнічную падтрымку. У наступных прыладах скончылася падпіска на абнаўленне:'; uk = 'Ця обробка буде працювати в демо режимі. Придбайте продовження підписки на оновлення та технічну підтримку. У наступних пристроях закінчилась підписка на оновлення:'; ka = 'ეს პროცესი იმუშავებს დემო რეჟიმში. შეიძინეთ განახლების და ტექნიკური მხარდაჭერის გაფართოება. შემდეგი მოწყობილების განახლების გასრულება:'; tr = 'Bu işlem demo modunda çalışacaktır. Güncelleme aboneliğini ve teknik destek aboneliğini uzatın. Güncelleme aboneliği sona eren cihazlar:'; es = 'Este proceso funcionará en modo demo. Adquiera una extensión de suscripción para actualizaciones y soporte técnico. La suscripción a las actualizaciones ha expirado en los siguientes dispositivos:'; ro = 'Această operație va funcționa în modul demo. Achiziționați prelungirea abonamentului pentru actualizări și suport tehnic. Abonamentul pentru actualizare a expirat pentru următoarele dispozitive:'");
	ТекстВыгрузкаСправочниковСОбрезкой 	= НСтр("ru = 'Данная обработка работает в демо режиме. Выгрузка справочников будет ограничена 100 строк. Приобретите продление подписки на обновления и техническую поддержку. У следующих устройств закончилась подписка на обновление:'; en = 'This process works in demo mode. Directory unloading will be limited to 100 rows. Purchase an extension for updates and technical support. The following devices have expired update subscriptions:'; kk = 'Бұл өңдеу демо режимінде жұмыс істейді. Справочниктердің шығаруы 100 жолға шектеледі. Жаңартулар мен техникалық қолдау үшін жазылу үлгісін қайта сатып алыңыз. Жаңарту үшін жазылу үлгісі аяқталған келесі құрылғылар:'; uz = ""Ushbu ishlov demo rejimida ishlaydi. Ma'lumotlar bazasini yuklash 100 qatorga cheklanadi. Yangilanishlar va texnik yordam uchun obuna sotib oling. Quyidagi qurilmalar yangilanish obunasi tugagan:""; be = 'Гэтая апрацоўка працуе ў дэма-рэжыме. Выгрузка даведнікаў будзе абмежавана 100 радкамі. Прыдбайце прадленне падпіскі на абнаўленні і тэхнічную падтрымку. У наступных прыладах скончылася падпіска на абнаўленне:'; uk = 'Ця обробка працює в демо режимі. Вивантаження довідників буде обмежено 100 рядків. Придбайте продовження підписки на оновлення та технічну підтримку. У наступних пристроях закінчилась підписка на оновлення:'; ka = 'ეს პროცესი იმუშავებს დემო რეჟიმში. საწყობების გამოყენება შეზღუდული იქნება 100 სტრიქონით. შეიძინეთ განახლების და ტექნიკური მხარდაჭერის გაფართოება. შემდეგი მოწყობილების განახლების გასრულება:'; tr = 'Bu işlem demo modunda çalışıyor. Referanslar dışa aktarımı 100 satır ile sınırlı olacaktır. Güncelleme aboneliğini ve teknik destek aboneliğini uzatın. Güncelleme aboneliği sona eren cihazlar:'; es = 'Este proceso funciona en modo demo. La descarga de directorios estará limitada a 100 filas. Adquiera una extensión de suscripción para actualizaciones y soporte técnico. La suscripción a las actualizaciones ha expirado en los siguientes dispositivos:'; ro = 'Această operație funcționează în modul demo. Descărcarea listelor va fi limitată la 100 de linii. Achiziționați prelungirea abonamentului pentru actualizări și suport tehnic. Abonamentul pentru actualizare a expirat pentru următoarele dispozitive:'");
	ТекстВыгрузкаДокумента 				= НСтр("ru = 'Данная обработка работает в демо режиме. При работе с документом на следующих устройствах табличная часть документа будет обрезана до трех строк:'; en = ""This process works in demo mode. When working with a document on the following devices, the document's table part will be limited to three rows:""; kk = 'Бұл өңдеу демо режимінде жұмыс істейді. Құжаттармен жұмыс істеудің кезінде құжаттардың кестелі бөлігі үш тізімге арналған:'; uz = ""Ushbu ishlov demo rejimida ishlaydi. Hujjatlar bilan ishlashda quyidagi qurilmalar bo'yicha hujjatning jadvallar qatori uch qatorga qisiladi:""; be = 'Гэтая апрацоўка працуе ў дэма-рэжыме. Пры працы з дакументам на наступных прыладах таблічная частка дакумента будзе абрэзана да трох радкоў:'; uk = 'Ця обробка працює в демо режимі. При роботі з документом на наступних пристроях таблична частина документа буде обрізана до трьох рядків:'; ka = 'ეს პროცესი იმუშავებს დემო რეჟიმში. დოკუმენტის საწყობების გამოყენება შეზღუდუდება სამ სტრიქონამდე:'; tr = 'Bu işlem demo modunda çalışıyor. Belge üzerinde çalışırken belge tablo bölümü aşağıdaki cihazlarda üç satıra kadar kırpılacaktır:'; es = 'Este proceso funciona en modo demo. Al trabajar con el documento en los siguientes dispositivos, la parte de la tabla del documento se cortará a tres filas:'; ro = 'Această operație funcționează în modul demo. La lucrul cu documentul pe următoarele dispozitive, partea tabulară a documentului va fi tăiată la trei linii:'");
	ТекстЗагрузкаДокументаСОбрезкой 	= НСтр("ru = 'Документ будет обрезан до трех строк, так как обработка более свежая чем позволяет подписка на обновления на ТСД. Приобретите продление подписки на обновления и техническую поддержку.'; en = 'The document will be truncated to three lines, as the processing is more recent than allowed by the subscription for updates on the Mobile device. Purchase a subscription renewal for updates and technical support.'; kk = 'Құжаттар үш жолға жасалады, себебі мобильді құрылға жаңартуларға жазылуынан кейін. Жаңартулар мен техникалық қолдау үшін жазылуларды қайталап алыңыз.'; uz = 'Ҳужжат учинчи қаторга киритилади, чунки уни мобил қурилмага янгилаш учун имкон берадиган обновления амалга оширилган. Обновления ва техник дастурдан фойдаланиш учун обновленияга янгилашни харид қилинг.'; be = 'Дакумент будзе абрэзаны да трох радкоў, так як апрацоўка абноўленая, чым дазваляе падпіска на абнаўленні на Мабільнае прылада. Набыць прадленне падпіскі на абнаўленні і тэхнічную падтрымку.'; uk = 'Документ буде обрізаний до трьох рядків, оскільки обробка більш свіжа, ніж дозволяє підписка на оновлення на Мобільний пристрій. Придбайте продовження підписки на оновлення та технічну підтримку.'; ka = 'დოკუმენტი შეიკრიბება სამ სტრიქონამდე, რადგან დამუშავება ახლისაა, ვიდრე ნდობა განახლების გამოწერის პრეტენზიებს მოშორება მობილურ მოწყობილობაზე. შეიძინეთ განახლების გამოწერის და ტექნიკური მხარდაჭერის გაგრძელება.'; tr = 'Belge üç satıra kadar kırpılacak, çünkü işleme, Mobil cihazda güncelleme aboneliği izin verdiğinden daha yeni. Güncelleme aboneliği ve teknik destek satın alın.'; es = 'El documento será recortado a tres líneas, ya que el procesamiento es más reciente de lo permitido por la suscripción de actualizaciones en el dispositivo móvil. Adquiera una extensión de suscripción para actualizaciones y soporte técnico.'; ro = 'Documentul va fi tăiat la trei rânduri, deoarece procesarea este mai recentă decât permite abonamentul pentru actualizări pe Dispozitivul mobil. Achiziționați prelungirea abonamentului pentru actualizări și suport tehnic.'");
	
	Если Событие = "ПоУмолчанию" Тогда 
		ЗаголовокСообщения = ТекстПредупреждение;
	ИначеЕсли Событие = "ВыгрузкаСправочника" Тогда
		Если СтруктураМетаданных.HardDemo = Истина Тогда
			ЗаголовокСообщения = ТекстВыгрузкаСправочниковСОбрезкой;
		Иначе
			ЗаголовокСообщения = ТекстПредупреждение;	
		КонецЕсли;
	ИначеЕсли Событие = "ВыгрузкаДокумента" Тогда 
		ЗаголовокСообщения = ТекстВыгрузкаДокумента;
	ИначеЕсли Событие = "ЗагрузкаДокумента" Тогда 
		ЗаголовокСообщения = ТекстЗагрузкаДокументаСОбрезкой;
	КонецЕсли;
	
	МассивСтрок.Добавить(ЗаголовокСообщения);
	
	ДопустимаяДата = Дата(2050,1,1);	
	Для Каждого Устройство Из СтруктураМетаданных.УстройстваMS Цикл
		Если ПроверяемоеУстройство <> "" Тогда
			Если Устройство.deviceId <> ПроверяемоеУстройство Тогда
				Продолжить;
			ИначеЕсли Устройство.isDemo = Ложь Тогда
				Возврат "";
			КонецЕсли;
		КонецЕсли;
				
		Если Устройство.isDemo = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если Устройство.supportDate < ДопустимаяДата Тогда
			ДопустимаяДата = Устройство.supportDate;
		КонецЕсли;
		СтрокаИдУстройства = Новый ФорматированнаяСтрока(Символы.ПС+Устройство.deviceDescription+" ("+Формат(Устройство.supportDate, "ДЛФ=Д")+")", Новый Шрифт(,, Истина), WebЦвета.Красный);
		МассивСтрок.Добавить(СтрокаИдУстройства);
	КонецЦикла;
	
	Если ДопустимаяДата < Дата(2050,1,1) Тогда
		МассивСтрок.Добавить(Символы.ПС);
		ПодвалСообщения = НСтр("ru = 'Используйте обработку версии не позднее '")+Формат(ДопустимаяДата, "ДЛФ=Д");
		МассивСтрок.Добавить(ПодвалСообщения);
	КонецЕсли;
	
	МассивСтрок.Добавить(Символы.ПС);
	СтрокаСсылкаНаБЗ = Новый ФорматированнаяСтрока(НСтр("ru = 'Подробнее'; en = 'More details'; kk = 'Толығырақ'; uz = 'Batafsil'; be = 'Падрабязна'; uk = 'Докладніше'; ka = 'დეტალები'; tr = 'Daha fazla bilgi'; es = 'Más detalles'; ro = 'Mai multe detalii'"),,,,"https://www.cleverence.ru/support/355758/");
		
	МассивСтрок.Добавить(СтрокаСсылкаНаБЗ);
	РезультатСообщение = Новый ФорматированнаяСтрока(МассивСтрок);
	
	Возврат РезультатСообщение;	
КонецФункции

#КонецОбласти

&НаКлиенте
Функция ЛокЯдро_ПредопределенныеЗначения(Группа = "Общее", Ключ = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	Если Кэш = Неопределено Тогда
		Кэш = Новый Структура;
	КонецЕсли;
	
	// в кэш тянется вся группа кроме Общее
	Если Не Кэш.Свойство(Группа) Тогда
		Если Группа = "Общее" Тогда
			ПредопределенныеЗначения = ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа, Ключ);
		Иначе
			ПредопределенныеЗначения = ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа);
		КонецЕсли;
		
		Кэш.Вставить(Группа, ПредопределенныеЗначения);		
	КонецЕсли;
	
	Результат = Новый Структура;
	НетВКэше = Новый Массив;
	Ключи = ЛокЯдро_СтрРазделить(Ключ, ",");
	
	Если Ключ = Неопределено Тогда
		
		Для каждого КЗ Из Кэш[Группа] Цикл
			Результат.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		
	Иначе
		
		ЗначениеКлюча = Неопределено;
		Для каждого ОдинКлюч Из Ключи Цикл
			Если Не Кэш[Группа].Свойство(ОдинКлюч, ЗначениеКлюча) Тогда
				НетВКэше.Добавить(ОдинКлюч);
			Иначе
				Результат.Вставить(ОдинКлюч, ЗначениеКлюча);
			КонецЕсли;
		КонецЦикла;
		
		КоличествоДляЗапроса = НетВКэше.Количество();
		Если КоличествоДляЗапроса > 0 Тогда
			КлючейНетВКэше = ЛокЯдро_СтрСоединить(НетВКэше, ",");
			ЗначенияКлючей = ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа, КлючейНетВКэше);
			Если КоличествоДляЗапроса = 1 Тогда
				Кэш[Группа].Вставить(КлючейНетВКэше, ЗначенияКлючей);
				Результат.Вставить(КлючейНетВКэше, ЗначенияКлючей);
			Иначе
				Для каждого КЗ Из ЗначенияКлючей Цикл
					Кэш[Группа].Вставить(КЗ.Ключ, КЗ.Значение);
					Результат.Вставить(КЗ.Ключ, КЗ.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	
		
		
	КонецЕсли;
	
	Если Ключи.Количество() = 1 Тогда
		Возврат Кэш[Группа][Ключ];
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа, Ключ = Неопределено)
	
	ОбработкаОбъект = ЛокЯдро_ОбработкаОбъект();
	Возврат ОбработкаОбъект.ГлЯдро_ПредопределенныеЗначения(Группа, Ключ, АдресаПеременных);
		
КонецФункции


#Область ЛокальныйКонтекстПроверкаОткрытияФорм

&НаКлиенте
Процедура ЛокЯдро_ПроверитьОткрытиеФорм() 
	НачалоПроверки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", "Старт тестирования открытия форм");
	
	СписокПроцедур = Новый СписокЗначений;
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ОтборыСправочников");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ОбменДокументами");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_ПодборПользователей1С");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_НастройкиПодключения");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_БизнесПроцессы");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ГлобальныеПараметры");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_Узлы");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_НастройкиОбработки");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ОтборДокументов");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ОтборыДокументов");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_БизнесПроцесс");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаВыгрузкиПолей");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаЗагрузкиПолей");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаВыгрузкиТЧ");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаЗагрузкиТЧ");
	
	Для каждого ТекПроцедура из СписокПроцедур Цикл
		ТекстОшибки = "";
		Попытка
			#Область НесовместимыйКодFresh
			Выполнить(ТекПроцедура.Значение + "()");
			#КонецОбласти //НесовместимыйКодFresh
			#Область СовместимыйКодFresh	
			//СтруктураВыполнения = ЛокЯдро_ВыполнитьМетодПоИмени(ТекПроцедура.Значение);
			//
			//ТекстОшибки = СтруктураВыполнения.ТекстОшибки;
			#КонецОбласти //СовместимыйКодFresh
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекФорма = СтрЗаменить(ТекПроцедура.Значение, "ЛокЯдро_ПроверитьОткрытиеФорм_", "");
			
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Ошибка", ЛокЯдро_СтрШаблон("Ошибка открытия формы %1 по причине: %2",
				СтрЗаменить(ТекПроцедура.Значение, "ЛокЯдро_ПроверитьОткрытиеФорм_", ""), Символы.ПС + ТекстОшибки));
		КонецЕсли;
	КонецЦикла;
	
	#Область НесовместимыйКодFresh
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", "Окончание тестирования открытия форм", НачалоПроверки);
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//СтруктураПараметров = Новый Структура("НачалоПроверки", НачалоПроверки);
	//
	//СтруктураВыполнения = ЛокЯдро_ВыполнитьМетодПоИмени("ЛокЯдро_ПроверитьОткрытиеФорм_ЗавершениеПроверки", СтруктураПараметров);
	#КонецОбласти //СовместимыйКодFresh
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТекущееВремяЗакрытияФормы(РезультатВыбора, ВремяНачалаПроверкиФормы) Экспорт
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") и
		РезультатВыбора.Свойство("ВремяЗакрытия") Тогда
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", "Успешное открытие формы " +РезультатВыбора.ИмяФормы,ВремяНачалаПроверкиФормы);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ОтборыСправочников() Экспорт

	ИмяСобытия = "ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ОтборыСправочников";

	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", ЛокЯдро_СтрШаблон("Начало открытия формы %1",
		СтрЗаменить(ИмяСобытия, "ЛокЯдро_ПроверитьОткрытиеФорм_", "")));
	
	ВремяНачалаПроверкиФормы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	////////////////////////////////////////////////////////////////////
	
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ЭтаФорма.ОбъектСсылка 					= ОбъектСсылка;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ОтборыСправочников = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаСписка_ОтборыСправочников", ЭтаФорма);
	#Иначе
		ФормаСписка_ОтборыСправочников = ПолучитьФорму(ЭтаФорма.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ОтборыСправочников",, ЭтаФорма);	
	#КонецЕсли
	
	
	ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;
	
	ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	
	ФормаСписка_ОтборыСправочников.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСписка_ОтборыСправочников._ЛокКонтекст 	= ЭтаФорма;
	ФормаСписка_ОтборыСправочников.ID_Узла 			= ID_ТекущегоУзла;
	ФормаСписка_ОтборыСправочников.ТипБазы 			= ТипБазы;
	ФормаСписка_ОтборыСправочников.НаименованиеУзла = ДанныеТекущегоУзла.Наименование;	
	ФормаСписка_ОтборыСправочников.ВыгрузитьСправочникиПриОткрытии = ЛОЖЬ;
	
	ФормаСписка_ОтборыСправочников.АвтоТестОткрытияФормы = Истина;
	ОП = Новый ОписаниеОповещения("ПолучитьТекущееВремяЗакрытияФормы", ЭтаФорма, ВремяНачалаПроверкиФормы);
	ФормаСписка_ОтборыСправочников.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСписка_ОтборыСправочников.Открыть();
	
	ЛокЯдро_Пауза(10);
	
	Если ФормаСписка_ОтборыСправочников.Открыта() Тогда
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьОткрытиеФорм", "Ошибка", "Не дождались окончания открытия формы ОтборыСправочников");
		ФормаСписка_ОтборыСправочников.Закрыть();
	КонецЕсли;
	
	
КонецПроцедуры

