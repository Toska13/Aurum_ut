Функция КомЯдро_ПолучитьСписокРеквизитовСущностиMS(СущностьMS, ДополнительныйСписок = Неопределено)
	
	ИмяСобытия = "КомЯдро_ПолучитьСписокРеквизитовСущностиMS";
	
	СписокРеквизитов = Новый Массив;
	Для Индекс = 0 По СущностьMS.Количество - 1 Цикл
		ДанныеРеквизита = СущностьMS.Элемент(Индекс);
		Если ДанныеРеквизита.ReadOnly Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = ДанныеРеквизита.ИмяПоля;
		uni = ДанныеРеквизита.uni;
		Если ЛокЯдро_ПроверитьПервыйСимволНаЦифру(ИмяПоля) 
			Или ЛокЯдро_ПроверитьПервыйСимволНаЦифру(uni) Тогда
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Реквизит "+ИмяПоля+" нельзя использовать в интеграции с 1С. Имя реквизита не должно начинаться с цифры.");
