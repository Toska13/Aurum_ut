Процедура ПриОткрытии(Отказ)
	ТекстЗаголовка = НСтр("be = 'Ачысціць даведнік %1'; en = 'Clear directory %1'; es = 'Limpiar directorio %1'; ka = 'საშუალოს გასუფთავება %1'; kk = '%1 тізімді тазалау'; ro = 'Ștergeți dicționarul %1'; ru = 'Очистить справочник %1'; tr = '%1 rehberi temizle'; uk = 'Очистити довідник %1'; uz = ""%1 ma'lumotnoma tozalash""");
	ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, ИмяТаблицы);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПанельФормы.Кнопки.ФормаОчиститьСправочник.Текст = ТекстЗаголовка;
		Элементы.ПанельТаблицыВыгрузки.Свертка = РежимСверткиЭлементаУправления.Низ;
	#Иначе
		Элементы.ФормаОчиститьСправочник.Заголовок = ТекстЗаголовка;
		ТекстЗаголовка = НСтр("be = 'Cleverence: Налада і выгрузка даведніка %1 на Мабільнае прылада'; en = 'Cleverence: Setting up and unloading the directory %1 to the Mobile device'; es = 'Cleverence: Configuración y descarga de directorio %1 en dispositivo móvil'; ka = 'Cleverence: %1 სამრავლოს გამოტანის და ჩატვირთვის პარამეტრების პარამეტრები'; kk = 'Cleverence: %1 деректер тізімінің орнату және шығаруы Мобильді құрылғыға'; ro = 'Cleverence: Configurarea și descărcarea dicționarului %1 pe dispozitivul mobil'; ru = 'Клеверенс: Настройка и выгрузка справочника %1 на ТСД'; tr = 'Cleverence: %1 rehberinin Mobil cihaza ayarlanması ve dışa aktarılması'; uk = 'Cleverence: Налаштування та вивантаження довідника %1 на Мобільний пристрій'; uz = ""Cleverence: Ma'lumotnoma %1 ma'lumotnomasini mobil qurilmaga sozlash va yuklash""");
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, ИмяТаблицы);
		Заголовок = ТекстЗаголовка;
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;		
		КонецЕсли;
	#КонецЕсли
	
	ЗаполнитьНастройкиКолонокТаблицыВыборки();
	
    ЗаполнитьНастройкиВыгрузки();
