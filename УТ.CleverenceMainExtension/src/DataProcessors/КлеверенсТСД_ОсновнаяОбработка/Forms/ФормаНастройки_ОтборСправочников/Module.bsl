		КомПанельТаблицыВыборкиЗаполнитьТаблицу();
		ГиперСсылкаНажатие("");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	РезультатСохранения = СохранитьИЗакрытьСервер();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,РезультатСохранения);
		КонецЕсли;
	#КонецЕсли
	Закрыть(РезультатСохранения);
КонецПроцедуры

&НаСервере 
Функция СохранитьИЗакрытьСервер()
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки();	
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновщика, НазначениеТипаXML.Явное);
	НастройкаКомпоновщикаСтрокой = ЗаписьXML.Закрыть();
	
	РезультатСохранения = Новый Структура;
	РезультатСохранения.Вставить("ИмяТаблицы", ИмяТаблицы);
	РезультатСохранения.Вставить("НастройкаКомпоновщикаСтрокой", НастройкаКомпоновщикаСтрокой);
	
	Возврат РезультатСохранения;
КонецФункции

&НаКлиенте
Процедура ВыгрузитьОтмеченныеСтроки(Команда)
	Если НЕ ТаблицаВыборки.Количество() Тогда	
		Сообщение = НСтр("be = 'Калі ласка, спачатку запоўніце табліцу на форме дадзенымі з 1С, націснуўшы на кнопку ""Запоўніць табліцу""'; en = 'Please first fill the table on the form with data from 1C by clicking the ""Fill table"" button'; es = 'Por favor, primero llene la tabla en el formulario con datos de 1C, haciendo clic en el botón ""Llenar tabla""'; ka = 'გთხოვთ, ჯერ შეავსეთ ცხრილი 1C-ში, დაჭერეთ ""ცხრილის შევსება"" ღილაკს'; kk = 'Өтінеміз, алдымен 1С-ден пішіндікті толтырып, ""Таблицаны толтыру"" түймесін басып, формадағы кестені толтырыңыз'; ro = 'Vă rugăm să completați mai întâi tabelul de pe formular cu date din 1C, apăsând butonul ""Completați tabelul""'; ru = 'Пожалуйста, сначала заполните таблицу на форме данными из 1С, нажав на кнопку ""Заполнить таблицу""'; tr = 'Lütfen önce 1C''den formdaki tabloyu ""Tabloyu Doldur"" düğmesine basarak doldurun'; uk = 'Будь ласка, спочатку заповніть таблицю на формі даними з 1С, натиснувши на кнопку ""Заповнити таблицю""'; uz = 'Iltimos, avval 1C dan ma''lumotlar bilan jadvalni to''ldiring, ""Jadvalni to''ldirish"" tugmasini bosing'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли; 
	ТаблицаДляВыгрузкиАдрес = ПодготовитьТаблицуДляВыгрузкиСервер();
		
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицы, ТаблицаДляВыгрузкиАдрес,ТипБазы);
КонецПроцедуры

&НаСервере
Функция ПодготовитьТаблицуДляВыгрузкиСервер()
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаВыборки;
	#Иначе
		ТЗ = РеквизитФормыВЗначение("ТаблицаВыборки");
	#КонецЕсли
	ТаблицаДляВыгрузки = ТЗ.Скопировать(Новый Структура("Выгружать", Истина));
	
	// надо добавить родителей в выгрузку
	// решение может быть пересмотрено, должно работать для складов
	Если ТаблицаДляВыгрузки.Колонки.Найти("Ид") <> Неопределено и ТаблицаДляВыгрузки.Колонки.Найти("ИдРодителя") <> Неопределено Тогда
		
		СтрокиДляДобавления = Новый Соответствие; // удобнее искать повторы
		
		Для каждого СтрокаДляВыгрузки Из ТаблицаДляВыгрузки Цикл
			ТекСтрока = СтрокаДляВыгрузки;
			Пока ТекСтрока <> Неопределено и ЗначениеЗаполнено(ТекСтрока.ИдРодителя) Цикл
				ТекСтрока = ТЗ.Найти(ТекСтрока.ИдРодителя, "Ид");
				Если ТекСтрока <> Неопределено Тогда
					// если уже в таблице для выгрузки или уже отметили, то пропускаем
					Если СтрокиДляДобавления.Получить(ТекСтрока.Ид) = Неопределено и ТаблицаДляВыгрузки.Найти(ТекСтрока.Ид, "Ид") = Неопределено Тогда
						СтрокиДляДобавления.Вставить(ТекСтрока.Ид, ТекСтрока);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Для каждого КЗ Из СтрокиДляДобавления Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаДляВыгрузки.Добавить(), КЗ.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	// если оставим эту колонку, то Клеверенс не загрузит такие данные (т.е. массивы данных с колонками, которых нет в Клеверенс), НО И ОШИБКУ НЕ ВЫДАСТ!
	Если ТаблицаДляВыгрузки.Колонки.Найти("Выгружать") <> Неопределено Тогда
		ТаблицаДляВыгрузки.Колонки.Удалить("Выгружать");
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДляВыгрузки);
КонецФункции

&НаКлиенте
Процедура ВыгрузитьСправочник(Команда)
	
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки();
	
	НастройкиКомпоновщикаСтрокой = ПолучитьНастройкиКомпоновщикаСтрокой();
	ПараметрыКомпоновщика = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров();
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщикаСтрокой, ПараметрыКомпоновщика, ПараметрыВыгрузки);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиКомпоновщикаСтрокой()
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, КомпоновщикНастроек.ПолучитьНастройки(), НазначениеТипаXML.Явное);
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	Возврат СтрокаXML;
	
КонецФункции

