&НаКлиенте
Процедура ЗаполнитьНастройкиВыгрузки()  Экспорт
	
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки();
	АдресСхемыСКД = _ЛокКонтекст.ЛокЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников(ИмяТаблицы, ПараметрыВыгрузки);
	
	//КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));
	ИнициализироватьКомпоновщикаИзВременногоХранилища(АдресСхемыСКД);
	// сперва загружаем в компоновщик настройки СКД по умолчанию, т.е. как они заданы в конфигураторе
	// далее, если есть сохраненные настройки - загружаем их
	//ПолучитьСхемуСКДИзХранилища(АдресСхемыСКД);
	
	Если НЕ ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
		Отбор = Новый Структура("ИмяТаблицы", ИмяТаблицы);
		Если  ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
			НастройкаКомпоновщикаСтрокой = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "НастройкаКомпоновщикаСтрокой");	
		Иначе
			НастройкаКомпоновщикаСтрокой = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначениеТабличнойНастройкиНаСервереSMARTS("НастройкиОбменаСправочников", Отбор, ID_Узла, "НастройкаКомпоновщикаСтрокой");	
		КонецЕсли;
	КонецЕсли;
	Если НЕ НастройкаКомпоновщикаСтрокой = Ложь И ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
		ЗагрузитьНастройкиКомпоновщикаИзСторки(НастройкаКомпоновщикаСтрокой);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиКомпоновщикаИзСторки(НастройкаКомпоновщикаСтрокой)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(НастройкаКомпоновщикаСтрокой);		
	Попытка
		пНастройкаКомпоновщикаСтрокой = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	Исключение
		пНастройкаКомпоновщикаСтрокой = ЗначениеИзСтрокиВнутр(НастройкаКомпоновщикаСтрокой);
	КонецПопытки;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(пНастройкаКомпоновщикаСтрокой);		
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикаИзВременногоХранилища(АдресСхемыСКД)
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));		
	СхемаСКД = ПолучитьИзВременногоХранилища(АдресСхемыСКД);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанельТаблицыВыборкиЗаполнитьТаблицу()
	
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки();
	
	ПараметрыКомпоновщика = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров();
	ТаблицаВыборкиАдрес = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, КомпоновщикНастроек.Настройки, ПараметрыКомпоновщика, ПараметрыВыгрузки);
	КомПанельТаблицыВыборкиЗаполнитьТаблицуСервер(ТаблицаВыборкиАдрес,ПараметрыКомпоновщика);
	
КонецПроцедуры

&НаСервере
Процедура КомПанельТаблицыВыборкиЗаполнитьТаблицуСервер(ТаблицаВыборкиАдрес,ПараметрыКомпоновщика)
	
	//НастройкиКомпоновщика = КомпоновщикНастроек.Настройки;
		
	ТЗ = ПолучитьИзВременногоХранилища(ТаблицаВыборкиАдрес);	
	//ТаблицаВыборки = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика);
	Элементы.КоличествоСтрок.Заголовок = ТЗ.Количество();
	
	УстановитьВидТаблицыВыборки(ТЗ);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидТаблицыВыборки(ТЗ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТаблицаВыборки = ТЗ;
		ТаблицаВыборки.Колонки.Вставить(0, "Выгружать", Новый ОписаниеТипов("Булево"), "");
		
		Элементы.ТаблицаВыборки.СоздатьКолонки();
		Для Каждого Колонка Из ТаблицаВыборки.Колонки Цикл
			Если СкрываемыеКолонки.НайтиПоЗначению(Колонка.Имя) <> Неопределено Тогда
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].Видимость = Ложь;
			КонецЕсли;
			Если Колонка.ТипЗначения.СодержитТип(Тип("Булево")) ИЛИ Колонка.Имя = "ЕстьСерии" ИЛИ Колонка.Имя = "ПоХарактеристикам" ИЛИ Колонка.Имя = "ВидЦеныВнутр" Тогда
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].УстановитьЭлементУправления(Тип("Флажок"));
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].Данные = "";
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].ДанныеФлажка = Колонка.Имя;
			КонецЕсли;
			Если НЕ Колонка.Имя = "Выгружать" Тогда
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].ТолькоПросмотр = Истина;
			КонецЕсли;
			РазмерКолонки = Неопределено;
			Если РазмерыКолонок.Свойство(Колонка.Имя,РазмерКолонки) Тогда
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].Ширина = РазмерКолонки;
			КонецЕсли;
			ЗаголовокКолонки = Неопределено;
			Если ЗаголовкиКолонок.Свойство(Колонка.Имя,ЗаголовокКолонки) Тогда
				Элементы.ТаблицаВыборки.Колонки[Колонка.Имя].ТекстШапки = ЗаголовокКолонки;
			КонецЕсли;
		КонецЦикла;
	#Иначе
		ТабВыборки = РеквизитФормыВЗначение("ТаблицаВыборки");
		
		МассивРеквизитов = Новый Массив;
		МассивУдаляемыхРеквизитов = Новый Массив;
		
		Для Каждого Колонка Из ТабВыборки.Колонки Цикл
			Если Колонка.Имя = "Выгружать" Тогда
				Продолжить;
			КонецЕсли;
			ИмяЭлементы = Колонка.Имя;
			ЭлементФ = Элементы.Найти(ИмяЭлементы);
			Если ЭлементФ <> Неопределено Тогда 
				МассивУдаляемыхРеквизитов.Добавить("ТаблицаВыборки."+Колонка.Имя);
				Элементы.Удалить(ЭлементФ);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			
			Если ИмяТаблицы = "ДопРеквизиты" И Колонка.Имя = "ДвоичныеДанныеИзображения" Тогда // реквизит "ДвоичныеДанныеИзображения" имеет тип "ХранилищеЗначения" и не может использоваться в реквизитах управляемой формы	
				Продолжить;
			КонецЕсли; 			
			
			МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения,"ТаблицаВыборки"));				
			
		КонецЦикла;
		
		ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);	
		ИзменитьРеквизиты(МассивРеквизитов);
		
		ТаблицаПолейВыбора = Элементы.ТаблицаВыборки;
		
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			
			Если ИмяТаблицы = "ДопРеквизиты" И Колонка.Имя = "ДвоичныеДанныеИзображения" Тогда // реквизит "ДвоичныеДанныеИзображения" имеет тип "ХранилищеЗначения" и не может использоваться в реквизитах управляемой формы	
				Продолжить;
			КонецЕсли;		
			
			НовыйЭлемент = Элементы.Добавить(Колонка.Имя, Тип("ПолеФормы"), ТаблицаПолейВыбора);
			НовыйЭлемент.ПутьКДанным = "ТаблицаВыборки." + Колонка.Имя;
			
			Если СкрываемыеКолонки.НайтиПоЗначению(Колонка.Имя) <> Неопределено Тогда
				НовыйЭлемент.Видимость = Ложь;
			КонецЕсли;
			Если Колонка.ТипЗначения.СодержитТип(Тип("Булево")) ИЛИ Колонка.Имя = "ЕстьСерии" ИЛИ Колонка.Имя = "ПоХарактеристикам" ИЛИ Колонка.Имя = "ВидЦеныВнутр" Тогда
				НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
				НовыйЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
			КонецЕсли;
			Если НЕ Колонка.Имя = "Выгружать" Тогда
				НовыйЭлемент.ТолькоПросмотр = Истина;
			КонецЕсли;
			РазмерКолонки = Неопределено;
			Если РазмерыКолонок.Свойство(Колонка.Имя,РазмерКолонки) Тогда
				Если НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
					НовыйЭлемент.ШиринаЭлемента = РазмерКолонки;
				Иначе
					НовыйЭлемент.Ширина = РазмерКолонки;
				КонецЕсли;
			КонецЕсли;
			ЗаголовокКолонки = Неопределено;
			Если ЗаголовкиКолонок.Свойство(Колонка.Имя,ЗаголовокКолонки) Тогда
				НовыйЭлемент.Заголовок = ЗаголовокКолонки;
			КонецЕсли;
			
		КонецЦикла;
		ТЗ.Колонки.Вставить(0, "Выгружать", Новый ОписаниеТипов("Булево"), "");	
		
		ЗначениеВРеквизитФормы(ТЗ,"ТаблицаВыборки");
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройки(Команда)
	
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки();

	АдресСхемыСКД = _ЛокКонтекст.ЛокЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников(ИмяТаблицы, ПараметрыВыгрузки);
	ИнициализироватьКомпоновщикаИзВременногоХранилища(АдресСхемыСКД);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	// Для корректного отображения таблицы выборки при переключении
	// между режимами настройки и предпросмотра
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Элементы.ПанельТаблицыВыгрузки.Свертка = РежимСверткиЭлементаУправления.Низ Тогда 
			Элементы.ПанельТаблицыВыгрузки.Свертка = РежимСверткиЭлементаУправления.Нет;		
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

// Получает параметры выгрузки справочника
//
// Возвращаемое значение:
//   Структура   - см. ЛокЯдро_ПолучитьПустуюСтруктуруПараметровВыгрузкиСправочника()
//
&НаКлиенте
Функция ПолучитьПараметрыВыгрузки()

	ПараметрыВыгрузки = _ЛокКонтекст.ЛокЯдро_ПолучитьПустуюСтруктуруПараметровВыгрузкиСправочника();
	
	ПараметрыВыгрузки.СпособВыгрузки 				= СпособВыгрузки;
	ПараметрыВыгрузки.ИмяМакетаИО 					= ИмяМакетаИО;
	ПараметрыВыгрузки.ТекстЗапроса 					= ТекстЗапросаВыгрузкиНаТСД;
	ПараметрыВыгрузки.ТекстКодаПолучениеПараметров 	= ТекстКодаПолучениеПараметров;
	ПараметрыВыгрузки.ТаблицаСопоставленияПолей 	= СписокСопоставленияПолей.ВыгрузитьЗначения();
	ПараметрыВыгрузки.ИмяИсточникаДанных 			= ИмяТаблицы;

	Возврат ПараметрыВыгрузки;

КонецФункции

#Область ПечатьЭтикеток

&НаКлиенте
Процедура ПечатьЭтикетки(Команда)
	
	ВыгружаемыеСтроки = ТаблицаВыборки.НайтиСтроки(Новый Структура("Выгружать", ИСТИНА));
	
	КоличествоВыгружаемыхСтрок = ВыгружаемыеСтроки.Количество();
	Если НЕ КоличествоВыгружаемыхСтрок Тогда
		ТекстПредупреждения = НСтр("be = 'Не абрана ні адна пазіцыя для друку!'; en = 'No positions selected for printing!'; es = '¡No se ha seleccionado ninguna posición para imprimir!'; ka = 'არ არის არჩეული არცერთი პოზიცია ბეჭდვისთვის!'; kk = 'Басылу үшін ешқандай элемент таңдалмады!'; ro = 'Nu a fost selectată nicio poziție pentru imprimare!'; ru = 'Не выбрано ни одной позиции для печати!'; tr = 'Yazdırılacak hiçbir pozisyon seçilmedi!'; uk = 'Не обрано жодної позиції для друку!'; uz = 'Chop etish uchun hech qanday pozitsiya tanlanmagan!'");
		ПоказатьПредупреждение(, ТекстПредупреждения, , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	ИначеЕсли КоличествоВыгружаемыхСтрок > 100 Тогда
		ОП = Новый ОписаниеОповещения("ПечатьЭтикеткиПослеОтветаНаВопрос", ЭтаФорма);
		ТекстВопроса = НСтр("be = 'Для друку выбрана больш за 100 пазіцый. Працягнуць?'; en = 'More than 100 items selected for printing. Continue?'; es = '¿Desea imprimir más de 100 elementos seleccionados? '; ka = 'არჩეული პოზიციების ბეჭდვა 100-ზე მეტია. გსურთ გაგრძელება?'; kk = 'Басқару үшін 100-ден астам позиция таңдалды. Жалғастыру керек пе?'; ro = 'Pentru imprimare au fost selectate peste 100 de poziții. Continuare?'; ru = 'Для печати выбрано более 100 позиций. Продолжить?'; tr = ""Yazdırmak için 100'den fazla pozisyon seçildi. Devam etmek istiyor musunuz?""; uk = 'Для друку обрано більше 100 позицій. Продовжити?'; uz = '100 дан ортиқ элемент чоп этиш учун танланган. Давом этамизми?'");
		ПоказатьВопрос(ОП, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе	
		НапечататьЭтикетки();	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭтикеткиПослеОтветаНаВопрос(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		НапечататьЭтикетки();	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЭтикетки()

	АдресТаблицыВыборки = ПолучитьАдресТаблицыВыборки();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИмяТаблицы", 		ИмяТаблицы);
	СтруктураПараметров.Вставить("ID_Узла", 		ID_Узла);
	СтруктураПараметров.Вставить("ТаблицаВыборки",	_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыВыборки));
	
	_ЛокКонтекст.ЛокЯдро_НапечататьЭтикетки(СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыВыборки()

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаВыборки;
	#Иначе
		ТЗ = РеквизитФормыВЗначение("ТаблицаВыборки");
	#КонецЕсли
		
	// В данный момент интересуют только строки для выгрузки
	ТаблицаКВыгрузке = ТЗ.Скопировать(Новый Структура("Выгружать", Истина));
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда	
		Возврат ПоместитьВоВременноеХранилище(ТаблицаКВыгрузке, Новый УникальныйИдентификатор());
	#Иначе
		Возврат ПоместитьВоВременноеХранилище(ТаблицаКВыгрузке, ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура НастройкаПечати(Команда)

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПечатьЭтикеток = ПолучитьФорму("ОФ_ФормаНастройки_ПечатьЭтикеток", ЭтаФорма);
	#Иначе
		ФормаНастройки_ПечатьЭтикеток = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПечатьЭтикеток", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ПечатьЭтикеток.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
		
	ФормаНастройки_ПечатьЭтикеток._ЛокКонтекст 			= _ЛокКонтекст;
	ФормаНастройки_ПечатьЭтикеток.КлючНастройки 		= "Настройка_ПечатьЭтикеток";
	ФормаНастройки_ПечатьЭтикеток.ИмяТаблицы			= ИмяТаблицы;
	ФормаНастройки_ПечатьЭтикеток.СписокРеквизитов1С	= ПолучитьСписокКолонокТаблицыВыборки();
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПечатьЭтикеток.ОткрытьМодально();
	#Иначе
		ФормаНастройки_ПечатьЭтикеток.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокКолонокТаблицыВыборки()
	
	СписокКолонок = Новый СписокЗначений;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТабВыборки = ТаблицаВыборки;	
	#Иначе
		ТабВыборки = РеквизитФормыВЗначение("ТаблицаВыборки");
   	#КонецЕсли
	
	Для Каждого Колонка Из ТабВыборки.Колонки Цикл
		Если Колонка.Имя = "Выгружать" 
			ИЛИ ИмяТаблицы = "ДопРеквизиты" И Колонка.Имя = "ДвоичныеДанныеИзображения" Тогда
			Продолжить;
		КонецЕсли;		
		Если СкрываемыеКолонки.НайтиПоЗначению(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СписокКолонок.Добавить(Колонка.Имя, Колонка.Имя);
	КонецЦикла;
	СписокКолонок.СортироватьПоЗначению();
	
	Возврат СписокКолонок;
	
КонецФункции

