			<item>
				<field>НастройкиТекущееЗначение</field>
			</item>
		</selection>
		<filter>
			<item xsi:type="FilterItemComparison">
				<left xsi:type="dcscor:Field">Настройки.ТекущееЗначение</left>
				<comparisonType>Equal</comparisonType>
				<right xsi:type="xs:string">Настроено</right>
			</item>
		</filter>
		<appearance>
			<dcscor:item xsi:type="SettingsParameterValue">
