			</item>
			<item>
				<field>НастройкиТипЗначения</field>
			</item>
			<item>
				<field>НастройкиТолькоЧтение</field>
			</item>
			<item>
				<field>НастройкиМодифицированность</field>
			</item>
			<item>
				<field>НастройкиНаименование</field>
			</item>
			<item>
				<field>НастройкиОсновная</field>
			</item>
		</selection>
		<filter>
			<item xsi:type="FilterItemComparison">
				<left xsi:type="dcscor:Field">Настройки.ТолькоЧтение</left>
				<comparisonType>Equal</comparisonType>
				<right xsi:type="xs:boolean">true</right>
			</item>
		</filter>
		<appearance>
			<dcscor:item xsi:type="SettingsParameterValue">
				<dcscor:parameter>ТолькоПросмотр</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
		</appearance>
	</item>
	<item>
		<selection>
			<item>
				<field>НастройкиПолноеНаименование</field>
			</item>
			<item>
