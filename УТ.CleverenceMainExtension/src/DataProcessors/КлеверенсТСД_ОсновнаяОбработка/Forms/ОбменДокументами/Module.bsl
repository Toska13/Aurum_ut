&НаКлиенте
Процедура ОбновитьДанныеТорговогоОбъекта()

	ДанныеТекущегоУзла = _ЛокКонтекст.ДанныеТекущегоУзла;
	
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И ДанныеТекущегоУзла.Свойство("ID_Узла") И ДанныеТекущегоУзла.ID_Узла <> ID_Узла Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
		ID_ТекущегоУзла 	   = ДанныеТекущегоУзла.ID_Узла;
		НастройкиУзла 		   = Неопределено;
		
		ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
		Если ЕстьЧастнаяБаза Тогда
			ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
			Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
				НастройкиУзла = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы, "ID_Узла", ID_ТекущегоУзла);
			КонецЕсли;
		КонецЕсли;
		
		ID_Узла 		 = ID_ТекущегоУзла;
		ID_БазыMS 		 = ?(НастройкиУзла <> Неопределено И НастройкиУзла.ИспользоватьЧастнуюБазу, НастройкиУзла.ЧастнаяБазаMS, ПараметрыПодключенияMS.Ид);
		ТипБазы 		 = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
		НаименованиеУзла = ДанныеТекущегоУзла.Наименование;
		
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
				Элементы.НаименованиеУзла.Видимость = Ложь;
			Иначе
				Элементы.НаименованиеУзла.Видимость = Истина;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьМассивКолонокНаНаличиеДублей(ТаблицаНастроекКолонок)

	МассивСодержитДубли = Ложь;
	
	КоличествоРеквизитов = ТаблицаНастроекКолонок.Количество();
	
	ТекущийИндекс = 0;
	Пока ТекущийИндекс < КоличествоРеквизитов Цикл
		Если ТаблицаНастроекКолонок[ТекущийИндекс].Свойство("ЭтоТаблицаЗначений") Тогда
			ТекущийИндекс = ТекущийИндекс + 1;
			Продолжить;
		КонецЕсли;
		
		ИмяТекущегоРеквизита = ТаблицаНастроекКолонок[ТекущийИндекс].Название;
		
		СледующийИндекс = ТекущийИндекс + 1;
		Пока СледующийИндекс < КоличествоРеквизитов Цикл
	    	Если ВРег(ИмяТекущегоРеквизита) = ВРег(ТаблицаНастроекКолонок[СледующийИндекс].Название) Тогда
				ТаблицаНастроекКолонок.Удалить(СледующийИндекс);	
				КоличествоРеквизитов = КоличествоРеквизитов - 1;
				
				МассивСодержитДубли = Истина;
			Иначе
				СледующийИндекс = СледующийИндекс + 1;
			КонецЕсли;
		КонецЦикла;
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
	Возврат МассивСодержитДубли;
	
КонецФункции

// Добавляет колонки на форму в таблицу документов SMARTS
// 
// Параметры:
// 	ВключенныеКолонки - Массив - Массив с описанием колонок
&НаСервере
Функция ДобавитьКолонкиТаблицыДокументовSMARTS(ВключенныеКолонки)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		МассивРеквизитов = Новый Массив;
		КС = Новый КвалификаторыСтроки(0);
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
		ТаблицаПолейВыбора = Элементы.ДокументыMS;
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			
			Если ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ДАТА") > 0
			ИЛИ ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ВРЕМЯ") > 0 Тогда
				ТипКолонки = Новый ОписаниеТипов("Дата");
			Иначе 
				ТипКолонки = ОписаниеТиповС;
			КонецЕсли;
			МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Название, ТипКолонки, "ДокументыMS"));
			
		КонецЦикла;
		
		Попытка
			ИзменитьРеквизиты(МассивРеквизитов);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			// Удалим реквизиты, которые не удалось добавить
			МассивУдаляемыхРеквизитов = Новый Массив;
			Для каждого УдаляемыйРеквизит ИЗ МассивРеквизитов Цикл
				МассивУдаляемыхРеквизитов.Добавить("ДокументыMS." + УдаляемыйРеквизит.Имя);
			КонецЦикла;
			ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
			
			Возврат ТекстОшибки;
		КонецПопытки;
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			НовыйЭлемент = Элементы.Добавить("ДокументыMS" + Колонка.Название, Тип("ПолеФормы"), ТаблицаПолейВыбора);
			НовыйЭлемент.ПутьКДанным = "ДокументыMS." + Колонка.Название;
			НовыйЭлемент.Заголовок = Колонка.Представление;		
			НовыйЭлемент.Ширина = 5;
			НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
			Если Колонка.Название = "Количество" Тогда
				НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
			КонецЕсли;
		КонецЦикла; 
		
	#КонецЕсли
	
	Возврат Истина;
	
КонецФункции

