sing, 1C dan tanlangan barcha hujjatlarni ko'rsatadi. 1C dan mobil qurilmaga yuklab olish uchun faqat kerakli 1C hujjatlari ro'yxatini ko'rsatish uchun %4Hujjatlarni tanlash%5 sozlang.""");
				МассивПодстрок.Добавить(Сред(Подстрока, 1, Найти(Подстрока, "%2") - 1));
				МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(Сред(Подстрока, Найти(Подстрока, "%2") + 2, Найти(Подстрока, "%3") - Найти(Подстрока, "%2") - 2),,,, "vse1C"));
				МассивПодстрок.Добавить(Сред(Подстрока, Найти(Подстрока, "%3") + 2, Найти(Подстрока, "%4") - Найти(Подстрока, "%3") - 2));
				МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(Сред(Подстрока, Найти(Подстрока, "%4") + 2, Найти(Подстрока, "%5") - Найти(Подстрока, "%4") - 2),,,, "otbor"));
