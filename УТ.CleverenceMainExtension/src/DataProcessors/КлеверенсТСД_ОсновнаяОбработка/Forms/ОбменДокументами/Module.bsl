&НаКлиенте
Процедура Служебная_ВыборПинКодаЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено 
		И ТипЗнч(РезультатРедактирования) = Тип("Строка") Тогда
		
		Если ЭтоАдресВременногоХранилища(РезультатРедактирования) Тогда
			НазначенныеПользователи = ПолучитьИзВременногоХранилища(РезультатРедактирования);
		Иначе
			НазначенныеПользователи = _ЛокКонтекст.ЛокЯдро_ПолучениеУстройстваПоПинкодуДляВыгрузкиДокумента(РезультатРедактирования, ТипБазы);
		КонецЕсли;
		
		Если НазначенныеПользователи <> Неопределено 
			И ТипЗнч(НазначенныеПользователи) = Тип("Массив")
			И НазначенныеПользователи.Количество() > 0 Тогда
			
			Если СтруктураПараметров.Свойство("ВыгрузитьКакОдин")
				И СтруктураПараметров.ВыгрузитьКакОдин = Истина Тогда
				Если ТипЗнч(СтруктураПараметров.ДополнительныеПараметры) = Тип("Структура") Тогда
					СтруктураПараметров.ДополнительныеПараметры.Вставить("НазначенныеПользователи",НазначенныеПользователи);	
				Иначе
					СтруктураПараметров.ДополнительныеПараметры = Новый Структура("НазначенныеПользователи",НазначенныеПользователи);
				КонецЕсли;
				ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(СтруктураПараметров.РезультатВопроса,СтруктураПараметров.ДополнительныеПараметры);
			Иначе
				ВыгрузитьДокументВБазуSMARTS(СтруктураПараметров.СтрокаДокумента,СтруктураПараметров.ПроверитьНаТСД,СтруктураПараметров.ID_БизнесПроцесса,НазначенныеПользователи);
			КонецЕсли;
			
		Иначе
			
			Если НазначенныеПользователи = Неопределено Тогда
				СообщениеПользователю = "Введен некорректный пин-код! Документ не выгружен в ТСД.";
			Иначе
				СообщениеПользователю = "Устройство по пин-коду не найдено! Документ не выгружен в ТСД.";
			КонецЕсли;
			
			СтруктураПараметров.Вставить("ВводПинКода", Истина);
			Служебная_ОтменаВыгрузкиДокументов(СообщениеПользователю, СтруктураПараметров);				
			
		КонецЕсли;
		
	Иначе
		
		СообщениеПользователю = "Не введен пин-код для выбора устройства!";
		СтруктураПараметров.Вставить("ВводПинКода", Истина);
		Служебная_ОтменаВыгрузкиДокументов(СообщениеПользователю, СтруктураПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ВыборНазначенияВыгрузкиЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	ВыгрузитьКакОдин 	 = ?(СтруктураПараметров.Свойство("ВыгрузитьКакОдин"), СтруктураПараметров.ВыгрузитьКакОдин, Ложь);
	Если Не ВыгрузитьКакОдин Тогда
		МассивСтрок = СтруктураПараметров.МассивСтрокДокументов;		
	Иначе
		МассивСтрок = Новый Массив;                             		
	КонецЕсли;
	
	Если ТипЗнч(РезультатРедактирования) = Тип("Строка") Тогда
		
		Если ЭтоАдресВременногоХранилища(РезультатРедактирования) Тогда
			НазначенныеПользователи = ПолучитьИзВременногоХранилища(РезультатРедактирования);
		Иначе
			НазначенныеПользователи = _ЛокКонтекст.ЛокЯдро_ПолучениеУстройстваПоПинкодуДляВыгрузкиДокумента(РезультатРедактирования, ТипБазы);
		КонецЕсли;
		
		Если НазначенныеПользователи <> Неопределено 
			И ТипЗнч(НазначенныеПользователи) = Тип("Массив")
			И НазначенныеПользователи.Количество() > 0 Тогда
			
			Если ВыгрузитьКакОдин Тогда
				Если ТипЗнч(СтруктураПараметров.ДополнительныеПараметры) = Тип("Структура") Тогда
					СтруктураПараметров.ДополнительныеПараметры.Вставить("НазначенныеПользователи",НазначенныеПользователи);	
				Иначе
					СтруктураПараметров.ДополнительныеПараметры = Новый Структура("НазначенныеПользователи",НазначенныеПользователи);
				КонецЕсли;
				ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(СтруктураПараметров.РезультатВопроса, СтруктураПараметров.ДополнительныеПараметры);
			Иначе
				ВыгрузитьДокументВБазуSMARTS(МассивСтрок, СтруктураПараметров.ПроверитьНаТСД, СтруктураПараметров.ID_БизнесПроцесса, НазначенныеПользователи);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(РезультатРедактирования) = Тип("Массив") Тогда 
		
		Если РезультатРедактирования.Количество() > 0 Тогда	
			
			НазначенныеПользователи = РезультатРедактирования;				
			
			Если ВыгрузитьКакОдин Тогда					
				Если ТипЗнч(СтруктураПараметров.ДополнительныеПараметры) = Тип("Структура") Тогда
					СтруктураПараметров.ДополнительныеПараметры.Вставить("НазначенныеПользователи",НазначенныеПользователи);	
				Иначе
					СтруктураПараметров.ДополнительныеПараметры = Новый Структура("НазначенныеПользователи",НазначенныеПользователи);
				КонецЕсли;
				ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(СтруктураПараметров.РезультатВопроса,СтруктураПараметров.ДополнительныеПараметры);					
			Иначе					
				ВыгрузитьДокументВБазуSMARTS(МассивСтрок, СтруктураПараметров.ПроверитьНаТСД, СтруктураПараметров.ID_БизнесПроцесса, НазначенныеПользователи);					
			КонецЕсли;
			
		Иначе
			
			Если МассивСтрок.Количество() > 1 Тогда
				ОкончаниеСообщения 	= "документами! Документы не выгружены в ТСД.";
			Иначе                 
				ОкончаниеСообщения 	= "документом! Документ не выгружен в ТСД.";				
			КонецЕсли;
			
			Если СтруктураПараметров.Свойство("СпособНазначения") И СтруктураПараметров.СпособНазначения = "Устройству" Тогда
				СообщениеПользователю = "Не выбрано устройство для работы с " + ОкончаниеСообщения;
			Иначе
				СообщениеПользователю = "Не выбран пользователь для работы с " + ОкончаниеСообщения;
			КонецЕсли;
			Служебная_ОтменаВыгрузкиДокументов(СообщениеПользователю, СтруктураПараметров);				
			
		КонецЕсли; 
		
	ИначеЕсли РезультатРедактирования = Ложь Тогда
		
		СообщениеПользователю = "Не введен пин-код для выбора устройства!";
		СтруктураПараметров.Вставить("ВводПинКода", Истина);
		Служебная_ОтменаВыгрузкиДокументов(СообщениеПользователю, СтруктураПараметров);
		
	КонецЕсли;		
	
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ОтменаВыгрузкиДокументов(ТекстСообщения, СтруктураПараметров)
	
	Сообщить(ТекстСообщения); 
	
	ВыгрузитьКакОдин = СтруктураПараметров.Свойство("ВыгрузитьКакОдин") И СтруктураПараметров.ВыгрузитьКакОдин = Истина;
	ВводПинКода		 = СтруктураПараметров.Свойство("ВводПинКода") И СтруктураПараметров.ВводПинКода = Истина;
	
	Если ВыгрузитьКакОдин Или ВводПинКода Тогда
		Для каждого СтрокаДокумента ИЗ Документы1С Цикл
			СтрокаДокумента.Выгружать = Ложь;	
		КонецЦикла;
	Иначе                               
		Для Каждого ДокументСтрока Из СтруктураПараметров.МассивСтрокДокументов Цикл
			СнятьПометкуВыгружатьВСтрокеТаблицы(ДокументСтрока.Ссылка);
		КонецЦикла;
		ВыгрузитьДокументВБазуSMARTS();                         		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ВосстановлениеДокументовSMARTSЗакрытие(РезультатВосстановления, СтруктураПараметров) Экспорт
		
	Если РезультатВосстановления = Истина Тогда
		Сообщение = НСтр("be = 'Дакументы паспяхова аднаўлены'; en = 'Documents successfully restored'; es = 'Documentos restaurados con éxito'; ka = 'დოკუმენტები წარმატებით აღდგენილია'; kk = 'Құжаттар сәтті қалпына келтірілді'; ro = 'Documentele au fost restaurate cu succes'; ru = 'Документы успешно восстановлены'; tr = 'Belgeler başarıyla geri yüklendi'; uk = 'Документи успішно відновлені'; uz = 'Ҳужжатлар муваффақиятли тикланди'");
		Сообщить(Сообщение); 
		КомПанель_ДокументыMSОбновитьНажатие(Неопределено);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВосстановлениеДокументов" Тогда
		ЗаполнитьТаблицуДокументовSMARTS();		
	КонецЕсли;
	
КонецПроцедуры

