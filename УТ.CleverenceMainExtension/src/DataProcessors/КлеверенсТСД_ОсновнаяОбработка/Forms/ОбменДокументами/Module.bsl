#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)            
	КоличествоДокументовНаФорме = 50;
	
	ID_Узла = ЭтаФорма.ID_Узла;
	ID_БазыMS = ЭтаФорма.ID_БазыMS;
	// Запоминаем текущий узел на случай, если при загрузке документа придется временно переключаться на другой узел
	ID_ТекущегоУзла = ЭтаФорма.ID_Узла;
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;		
		КонецЕсли;		
	#КонецЕсли
	
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина;		
	#КонецЕсли
	
	НеВыводитьИнфоСтроку1С 			= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщений1СФормыОбмена");
	НеВыводитьИнфоСтроку1С_Пустую	= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщений1СПустойФормыОбмена");
	НеВыводитьИнфоСтрокуMS			= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщенийMSФормыОбмена");
	НеВыводитьИнфоСтрокуMS_Пустую	= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщенийMSПустойФормыОбмена");
	
	ИдВыбранногоДокументаМС = "";
	
	СостояниеДокументаВРаботе = НСтр("en = 'In progress'; ru = 'В работе'; kk = 'Жұмыс істеу'; uz = 'Ishda'; be = 'У працы'; uk = 'У роботі'; ka = 'სამუშაოში'; tr = 'Çalışıyor'; es = 'En proceso'; ro = 'În lucru'");
	СостояниеДокументаВыгружен = НСтр("en = 'Unloaded'; ru = 'Выгружен'; kk = 'Шығарылды'; uz = 'Yuklandi'; be = 'Выгружаны'; uk = 'Вивантажено'; ka = 'გამოტანილია'; tr = 'Dışa aktarıldı'; es = 'Descargado'; ro = 'Descărcat'");
	СостояниеДокументаЗавершен = НСтр("en = 'Completed'; ru = 'Завершен'; kk = 'Аяқталды'; uz = 'Yakunlandi'; be = 'Завершаны'; uk = 'Завершено'; ka = 'დასრულდა'; tr = 'Tamamlandı'; es = 'Completado'; ro = 'Finalizat'");
	СостояниеДокументаЗавершенНеИзменен = НСтр("en = 'Completed, not changed'; ru = 'Завершен, не изменен'; kk = 'Өзгертілмеген аяқталды'; uz = ""Yakunlandi, o'zgarmadi""; be = 'Завершаны, не зменены'; uk = 'Завершено, не змінено'; ka = 'დასრულდა, არ შეიცვალა'; tr = 'Değişiklik yapılmadan tamamlandı'; es = 'Completado, no modificado'; ro = 'Finalizat, neschimbat'");
	СостояниеДокументаЗавершенЕстьРасхождения = НСтр("en = 'Completed, there are discrepancies'; ru = 'Завершен, есть расхождения'; kk = 'Айырмашылықтар бар аяқталды'; uz = 'Yakunlandi, farqlar mavjud'; be = 'Завершаны, ёсць розбежнасці'; uk = 'Завершено, є розбіжності'; ka = 'დასრულდა, განსხვავებები არის'; tr = 'Uyumlu olmayan bir şekilde tamamlandı'; es = 'Completado, hay discrepancias'; ro = 'Finalizat, există discrepanțe'");
	СостояниеДокументаЗавершенБезРасхождений = НСтр("en = 'Completed, without discrepancies'; ru = 'Завершен, без расхождений'; kk = 'Айырмашылықсыз аяқталды'; uz = ""Yakunlandi, farq yo'q""; be = 'Завершаны, без розбежнасцяў'; uk = 'Завершено, без розбіжностей'; ka = 'დასრულდა, განსხვავებების გარეშე'; tr = 'Uyumlu bir şekilde tamamlandı'; es = 'Completado, sin discrepancias'; ro = 'Finalizat, fără discrepanțe'");
	
	ЗаполнитьТаблицуДокументов1С();
	ЗаполнитьТаблицуДокументовSMARTS(Истина);
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КомПанель_Документы1СОбновитьНажатие(Команда)
