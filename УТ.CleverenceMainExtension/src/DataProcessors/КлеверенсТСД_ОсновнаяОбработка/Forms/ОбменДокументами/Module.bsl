	КонецЕсли;	
	
	ВидимостьГруппыИнфо1СВерх 	= ВидимостьГруппаИнфо1СВерх;
	ВидимостьГруппыИнфо1СНиз 	= КоличествоДокументовПревышаетРазмерВыборки() И Не ВыборкаДокументов1СБезОграничений;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ВидимостьГруппыИнфо1СВерх Тогда
			Элементы.ПанельИнфоСтрока1СВерх.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрока1СВерх.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстПериодОтбора1С) Тогда
			Элементы.ПанельТекстПериодаОтбора1С.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельТекстПериодаОтбора1С.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;

		Если ВидимостьГруппыИнфо1СНиз Тогда
			Элементы.ПанельИнфоСтрока1СНиз.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрока1СНиз.Свертка = РежимСверткиЭлементаУправления.Низ;
		КонецЕсли;		
	#Иначе
		Элементы.ГруппаИнфо1СВерх.Видимость 			= ВидимостьГруппыИнфо1СВерх;
		Элементы.СкрытьИнфоСтроку1С.Видимость 			= Документы1С.Количество();
		Элементы.СкрытьИнфоСтроку1С_Пустую.Видимость 	= Не Документы1С.Количество();		
		Элементы.ИнфоСтрока1СНиз.Видимость 				= ВидимостьГруппыИнфо1СНиз;
	#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Функция КоличествоДокументовПревышаетРазмерВыборки()
	
	Если ВыборкаДокументов1СБезОграничений Тогда
		Возврат Ложь;		
	КонецЕсли;
	
	КоличествоДокументов = Новый Соответствие;
	
	Для каждого Строка Из Документы1С Цикл
		
		Ключ = ?(Строка.НастройкаБизнесПроцесса = "", Строка.ТипДокумента1С, Строка.НастройкаБизнесПроцесса);
		СоответствиеКоличества = КоличествоДокументов.Получить(Ключ);
		
		Если СоответствиеКоличества = Неопределено Тогда
			КоличествоДокументов.Вставить(Ключ, 1);
		Иначе
			КоличествоДокументов[Ключ] = СоответствиеКоличества + 1;
			Если СоответствиеКоличества + 1 = КоличествоДокументовНаФорме Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИнформационныеСообщенияMS()
	
	МассивПодстрок = Новый Массив;
	
