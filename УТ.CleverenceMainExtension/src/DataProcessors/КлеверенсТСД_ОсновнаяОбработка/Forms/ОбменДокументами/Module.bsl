						Если ПараметрыПодключенияMS.Свойство("РаботаСКаталогом") И ПараметрыПодключенияMS.РаботаСКаталогом = Истина Тогда
							ТекстВопроса = НСтр("be = 'Выдаліць выбраныя дакументы з папкі абмену?'; en = 'Delete selected documents from the exchange folder?'; es = '¿Eliminar los documentos seleccionados de la carpeta de intercambio?'; ka = 'წაშლის არჩეული დოკუმენტები გაცნობილი ფოლდერიდან?'; kk = 'Алып тастау папкасынан таңдалған құжаттарды жою керек пе?'; ro = 'Ștergeți documentele selectate din dosarul de schimb?'; ru = 'Удалить выбранные документы из папки обмена?'; tr = 'Değişim klasöründeki seçilen belgeleri silmek istiyor musunuz?'; uk = 'Видалити вибрані документи з папки обміну?'; uz = ""Ayirilgan hujjatlarni almashuvni o'chirish?""");	
						ИначеЕсли ПараметрыПодключенияMS.Свойство("РаботаСУстройствомНапрямую") И ПараметрыПодключенияMS.РаботаСУстройствомНапрямую = Истина Тогда
							ТекстВопроса = НСтр("be = 'Выдаліць выбраныя дакументы з мабільнага прыладу?'; en = 'Delete selected documents from the mobile device?'; es = '¿Eliminar los documentos seleccionados del dispositivo móvil?'; ka = 'წაშლის არჩეული დოკუმენტები მობილური მოწყობილობიდან?'; kk = 'Мобильді құрылғынан таңдалған құжаттарды жою керек пе?'; ro = 'Ștergeți documentele selectate de pe dispozitivul mobil?'; ru = 'Удалить выбранные документы с мобильного устройства?'; tr = 'Mobil cihazdan seçilen belgeleri silmek istiyor musunuz?'; uk = 'Видалити вибрані документи з мобільного пристрою?'; uz = ""Mobil qurilmadan tanlangan hujjatlarni o'chirish?""");
						Иначе
							ТекстВопроса = НСтр("be = 'Выдаліць выбраныя дакументы з сервера?'; en = 'Delete selected documents from the server?'; es = '¿Eliminar los documentos seleccionados del servidor?'; ka = 'წაშლის არჩეული დოკუმენტები სერვერიდან?'; kk = 'Серверден таңдалған құжаттарды жою керек пе?'; ro = 'Ștergeți documentele selectate de pe server?'; ru = 'Удалить выбранные документы с сервера?'; tr = 'Sunucudan seçilen belgeleri silmek istiyor musunuz?'; uk = 'Видалити вибрані документи з сервера?'; uz = ""Serverdan tanlangan hujjatlarni o'chirish?""");
