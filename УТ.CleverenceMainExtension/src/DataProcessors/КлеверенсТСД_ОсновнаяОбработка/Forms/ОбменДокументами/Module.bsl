&НаКлиенте
Процедура ОповещениеВопросПовторВыгрузкиЗавершение(РезультатВопроса, СтрокаДокумента) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Если ТипЗнч(СтрокаДокумента) = Тип("Массив") Тогда
			Для Каждого ДокументСтрока Из СтрокаДокумента Цикл
				СнятьПометкуВыгружатьВСтрокеТаблицы(ДокументСтрока.Ссылка);			
			КонецЦикла;
		Иначе
			СнятьПометкуВыгружатьВСтрокеТаблицы(СтрокаДокумента.Ссылка);	
		КонецЕсли;		
		ВыгрузитьДокументВБазуSMARTS();
	Иначе     
		Если ТипЗнч(СтрокаДокумента) = Тип("Массив") Тогда
			ВыгрузитьДокументВБазуSMARTS(, Ложь);
		Иначе
			ВыгрузитьДокументВБазуSMARTS(СтрокаДокумента, Ложь);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВопросУдалитьДокументСТСДЗавершение(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ДокументыКУдалению 	= ДокументыMS.НайтиСтроки(Новый Структура("Загружен", Истина));
		ОтмеченныеДокументы	= ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		Для Каждого Док Из ОтмеченныеДокументы Цикл
			ДокументыКУдалению.Добавить(Док);	
		КонецЦикла;
		
		Для Каждого ДокументКЗагрузке Из ДокументыКУдалению Цикл
			Если Найти(ДокументКЗагрузке.Состояние,"Завершен") =  0 Тогда
				Продолжить;	
			КонецЕсли;
			РезультатУдаления = _ЛокКонтекст.ЛокЯдро_УдалитьДокументНаСервереSMARTS(ДокументКЗагрузке.Ид);
			Сообщить(РезультатУдаления.Сообщение + " [" + ДокументКЗагрузке.Имя + "]"); 
			Строка = ДокументыMS.НайтиСтроки(Новый Структура("Ид",ДокументКЗагрузке.Ид));
			Если Строка.Количество() > 0 Тогда
				ДокументыMS.Удалить(Строка[0]);
			КонецЕсли;	
		КонецЦикла; 
		
	Иначе
		
		ЗагруженныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружен", Истина));
		ОтмеченныеДокументы	 = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		Для Каждого Док Из ОтмеченныеДокументы Цикл
			ЗагруженныеДокументы.Добавить(Док);	
		КонецЦикла;
		
		Для Каждого ДокументКЗагрузке Из ЗагруженныеДокументы Цикл
			Если Найти(ДокументКЗагрузке.Состояние,"Завершен") =  0 Тогда
				Продолжить;	
			КонецЕсли;
			СнятьПометкуЗагружатьВСтрокеТаблицыMS(ДокументКЗагрузке.Ид, Ложь);	
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ВыборПользователяИлиГруппыЗакрытие(РезультатРедактирования, СтруктураПараметров) Экспорт
	
	ВыгрузитьКакОдин 	 = ?(СтруктураПараметров.Свойство("ВыгрузитьКакОдин"), СтруктураПараметров.ВыгрузитьКакОдин, Ложь);
	Если Не ВыгрузитьКакОдин Тогда
		МассивСтрок = СтруктураПараметров.МассивСтрокДокументов;		
	Иначе
		МассивСтрок = Новый Массив;                             		
	КонецЕсли;

	Если РезультатРедактирования <> Неопределено 
		И ТипЗнч(РезультатРедактирования) = Тип("Массив")
		И РезультатРедактирования.Количество() > 0 Тогда		
		НазначенныеПользователи = РезультатРедактирования;		
		
		Если ВыгрузитьКакОдин Тогда
			Если ТипЗнч(СтруктураПараметров.ДополнительныеПараметры) = Тип("Структура") Тогда
				СтруктураПараметров.ДополнительныеПараметры.Вставить("НазначенныеПользователи", НазначенныеПользователи);	
			Иначе
				СтруктураПараметров.ДополнительныеПараметры = Новый Структура("НазначенныеПользователи", НазначенныеПользователи);
			КонецЕсли;
			ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(СтруктураПараметров.РезультатВопроса, СтруктураПараметров.ДополнительныеПараметры);
		Иначе
			ВыгрузитьДокументВБазуSMARTS(МассивСтрок, СтруктураПараметров.ПроверитьНаТСД, СтруктураПараметров.ID_БизнесПроцесса, НазначенныеПользователи);
		КонецЕсли;
	Иначе
		Если МассивСтрок.Количество() > 1 Тогда
			СообщениеПользователю 	= "Не выбран пользователь для работы с документами! Документы не выгружены в ТСД.";
			СообщениеУстройство		= "Не выбрано устройство для работы с документами! Документы не выгружены в ТСД.";
		Иначе                 
			СообщениеПользователю 	= "Не выбран пользователь для работы с документом! Документ не выгружен в ТСД.";
			СообщениеУстройство		= "Не выбрано устройство для работы с документом! Документ не выгружен в ТСД.";
		КонецЕсли;
		
		Если СтруктураПараметров.Свойство("СпособНазначения") И СтруктураПараметров.СпособНазначения = "Устройству" Тогда
			Служебная_ОтменаВыгрузкиДокументов(СообщениеУстройство, СтруктураПараметров);
		Иначе
			Служебная_ОтменаВыгрузкиДокументов(СообщениеПользователю, СтруктураПараметров);
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
