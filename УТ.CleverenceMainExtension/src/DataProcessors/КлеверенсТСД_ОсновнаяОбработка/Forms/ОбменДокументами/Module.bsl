			Подстрока1 = Найти(Подстрока, "%1");
			Подстрока2 = Найти(Подстрока, "%2");
			МассивПодстрок.Добавить(Сред(Подстрока, 1, Подстрока1 - 1));
			МассивПодстрок.Добавить(
				Новый ФорматированнаяСтрока(
					Сред(Подстрока, Подстрока1 + 2, Подстрока2 - Подстрока1 - 2),,,, "otbor")
				);
			МассивПодстрок.Добавить(Сред(Подстрока, Подстрока2 + 2));
						
