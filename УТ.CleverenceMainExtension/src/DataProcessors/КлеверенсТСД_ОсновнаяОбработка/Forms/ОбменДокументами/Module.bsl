						КонецЕсли;						
						Форма = ПолучитьФорму("Документ." + РезультатЗаписи.МетаданныеИмя + ".ФормаОбъекта", ПараметрыФормы);
					КонецЕсли;
					
					ИмяОбъектаФормы = "Объект";
					Попытка
						ДанныеФормы = Форма[ИмяОбъектаФормы];						
