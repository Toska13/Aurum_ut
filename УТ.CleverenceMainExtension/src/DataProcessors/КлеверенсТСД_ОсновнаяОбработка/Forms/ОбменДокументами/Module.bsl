	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTSПослеПроверкиДемо", ЭтаФорма);
	ПараметрыПроверки = Новый Структура("Событие", "ВыгрузкаДокумента");
	_ЛокКонтекст.ЛокЯдро_ПроверитьДемоРежим(Оповещение, ПараметрыПроверки);
