			МассивПодстрок.Добавить(Сред(Подстрока, 1, Найти(Подстрока, "%1") - 1));
			МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(Сред(Подстрока, Найти(Подстрока, "%1") + 2, Найти(Подстрока, "%2") - Найти(Подстрока, "%1") - 2),,,, "otbor"));
			МассивПодстрок.Добавить(Сред(Подстрока, Найти(Подстрока, "%2") + 2));
			МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(
					НСтр("be = 'Падрабязна аб наладзе адбораў'; en = 'More details about selection criteria'; es = 'Más detalles sobre la configuración de selección'; ka = 'დამატების გამოყენების დამახსოვრების შესახებ'; kk = 'Сүзгілерді толықтай анықтау туралы толығырақ'; ro = 'Mai multe detalii despre setările de selecție'; ru = 'Подробнее о настройке отборов'; tr = 'Filtre seçenekleri hakkında daha fazla bilgi'; uk = 'Докладніше про налаштування відборів'; uz = ""Tanlash sozlamalari haqida batafsil ma'lumot""")
					,,,, "https://www.cleverence.ru/support/49388/"));
			МассивПодстрок.Добавить(".");
			
			ИнфоСтрока1СВерх = Новый ФорматированнаяСтрока(МассивПодстрок);  
			Элементы.ГруппаИнфо1СВерх.ПодчиненныеЭлементы.ИнфоСтрока1СВерх.Высота = 2;
