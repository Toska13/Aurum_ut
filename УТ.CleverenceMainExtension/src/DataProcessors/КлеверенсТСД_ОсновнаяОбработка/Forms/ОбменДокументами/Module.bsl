&НаКлиенте
Процедура ФормаСлужебная_ВыборСтрокиИзТаблицыЗакрытие(РезультатВыбора, СтруктураПараметров) Экспорт

	ВыгрузитьКакОдин 		= ?(СтруктураПараметров.Свойство("ВыгрузитьКакОдин"), СтруктураПараметров.ВыгрузитьКакОдин, Ложь);
	МассивСтрок				= СтруктураПараметров.МассивСтрок;
	МассивДокументов		= СтруктураПараметров.МассивДокументов;
	
	Если ЗначениеЗаполнено(РезультатВыбора) И ЗначениеЗаполнено(РезультатВыбора.Данные) Тогда
		Если ЗначениеЗаполнено(РезультатВыбора.Данные.ID_БизнесПроцесса) Тогда
			ID_БизнесПроцесса = РезультатВыбора.Данные.ID_БизнесПроцесса;
			Если ВыгрузитьКакОдин Тогда
				ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(, Новый Структура("ID_БизнесПроцесса,МассивДокументов,МассивСтрок", ID_БизнесПроцесса, МассивДокументов, МассивСтрок));
			Иначе 
				Если РезультатВыбора.Свойство("ДляВсех") И РезультатВыбора.ДляВсех Тогда
					ВыгрузитьДокументВБазуSMARTS(МассивСтрок, Ложь, ID_БизнесПроцесса);
				Иначе
					ВыгрузитьДокументВБазуSMARTS(, Ложь, ID_БизнесПроцесса);					
				КонецЕсли;
			КонецЕсли;
		Иначе
			Сообщение = НСтр("be = 'У выбранага бізнес-працэсу ""%1"" не запоўнены ID'; en = 'The ID is not filled in for the selected business process ""%1""'; es = 'El proceso comercial seleccionado ""%1"" no tiene un ID completado'; ka = 'არჩეულ ბიზნეს პროცესში ""%1"" ID არ არის შევსებული'; kk = 'Таңдалған бизнес-процесс ""%1"" ID толтырылмаған'; ro = 'Procesul de afaceri selectat ""%1"" nu are ID-ul completat'; ru = 'У выбранного бизнес-процесса ""%1"" не заполнен ID'; tr = 'Seçilen iş sürecinde ""%1"" kimlik numarası eksik'; uk = 'У обраного бізнес-процесу ""%1"" не заповнено ID'; uz = 'Tanlangan biznes jarayon ""%1"" ID to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(РезультатВыбора.Данные.Название));
			Сообщить(Сообщение); 
			Если РезультатВыбора.Свойство("ДляВсех") И РезультатВыбора.ДляВсех Тогда
				СнятьПометкуВыгружатьВСтрокеТаблицы(МассивДокументов);
			Иначе
				СнятьПометкуВыгружатьВСтрокеТаблицы(МассивДокументов[0]);
			КонецЕсли;                                                		
			ВыгрузитьДокументВБазуSMARTS();
		КонецЕсли;	
	Иначе
		СнятьПометкуВыгружатьВСтрокеТаблицы(МассивДокументов);
		ВыгрузитьДокументВБазуSMARTS();		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранныеДокументыВБазу1СВыборБПЗакрытие(РезультатВыбора, СтруктураПараметров) Экспорт
	
