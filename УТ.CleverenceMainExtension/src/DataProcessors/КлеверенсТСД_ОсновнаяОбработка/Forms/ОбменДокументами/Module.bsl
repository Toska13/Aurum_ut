			ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();
		#КонецЕсли
		
		Возврат;
		
	КонецЕсли;
	
	Если (флУказатьПользователя Или флОтправитьНаУстройство) И НазначенныеПользователи[0].Ид = "Выгружать всем" Тогда 
		НазначенныеПользователи = Неопределено;
	КонецЕсли;

	_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(МассивДокументов, ID_БизнесПроцесса, НазначенныеПользователи, ТипБазы);
	СнятьПометкуВыгружатьВСтрокеТаблицы(МассивДокументов);	
	// Обновить табличные части
	ЗаполнитьТаблицуДокументовSMARTS();
	
КонецПроцедуры	
	
// Снимает флаг Загружать в таблицы документов Клеверенс после загрузки документа
// 
// Параметры:
// 	ДокументMS - Строка - Идентификатор загруженного документа Клеверенс
&НаКлиенте
Процедура СнятьПометкуЗагружатьВСтрокеТаблицыMS(ДокументMS, ПризнакЗагрузки = Неопределено)

	Строка = ДокументыMS.НайтиСтроки(Новый Структура("Ид",ДокументMS));
	
	Если Строка.Количество() > 0 Тогда
		Строка[0].Загружать = Ложь;	
		Если ПризнакЗагрузки <> Неопределено Тогда
			Строка[0].Загружен = ПризнакЗагрузки;	    
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

// Заполняет данные формы переданным объектом. Вызывается перед открытием формы загруженного документа.
// 
// Параметры:
// 	ДанныеФормы - ДанныеФормы - Данные открываемой формы 
// 	РезультатЗаписи - (См. ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID)
//	ТипСтруктура - Структура - Если тип данных формы является обычной структурой
//
&НаСервереБезКонтекста
Процедура ЗаполнитьДокументНаСервере(ДанныеФормы, РезультатЗаписи, ТипСтруктура = Ложь)
	
	Если ТипЗнч(РезультатЗаписи.Данные) = Тип("Строка") Тогда
		ЧтениеХМЛ = Новый ЧтениеXML;
		ЧтениеХМЛ.УстановитьСтроку(РезультатЗаписи.Данные);
		Значение = ПрочитатьXML(ЧтениеХМЛ);
	Иначе
		Значение = РезультатЗаписи.Данные;
	КонецЕСли;
	
	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Объект") Тогда
		Значение = Значение.Объект;
	КонецЕсли;
	
	Если ТипСтруктура Тогда
		ЗаполнитьЗначенияСвойств(ДанныеФормы, Значение);
	Иначе
		ЗначениеВДанныеФормы(Значение, ДанныеФормы);
	КонецЕсли;
	
КонецПроцедуры

