&НаКлиенте
Процедура ИнфоСтрокаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) 
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "otbor" Тогда
		СтандартнаяОбработка = Ложь;                                             	
		ОткрытьНастройкуОтбораДокументов();
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "obnovit" Тогда
		СтандартнаяОбработка = Ложь;                                             	
		ПолучениеСпискаДокументовSMARTS(, ВыборкаДокументовMSБезОграничений);
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "vse1C" Тогда
		СтандартнаяОбработка = Ложь;      
		ВыборкаДокументов1СБезОграничений = Истина;
		ПолучениеСпискаДокументов1С(ВыборкаДокументов1СБезОграничений);   
		ЗаполнитьИнформационныеСообщения1С();
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "vseMS" Тогда
		СтандартнаяОбработка = Ложь;      
		ВыборкаДокументовMSБезОграничений = Истина;
		ПолучениеСпискаДокументовSMARTS(, ВыборкаДокументовMSБезОграничений);
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ЗапуститьПриложение(НавигационнаяСсылкаФорматированнойСтроки);			
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуОтбораДокументов() 
	
	ОП = Новый ОписаниеОповещения("КомПанель_Документы1СНастроитьОтборНажатиеПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);		
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеСпискаДокументов1С(БезОграничений = Ложь)
	
	Документы1С.Очистить();
	
	ЗаполнитьКолонкиТаблицыДокументов1С();
	
	ОтборПоПериоду = Неопределено;
	Если ЗначениеЗаполнено(ПериодОтбора1С.ДатаНачала) Или ЗначениеЗаполнено(ПериодОтбора1С.ДатаОкончания) Тогда
		ОтборПоПериоду = Новый Структура("ДатаНачала,ДатаОкончания", ПериодОтбора1С.ДатаНачала, ПериодОтбора1С.ДатаОкончания);
	КонецЕсли;
	
	СписокОтобранныхДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДокументов1С("Интерактивный", ?(БезОграничений, 0, КоличествоДокументовНаФорме), ОтборПоПериоду);
	Если ЗначениеЗаполнено(СписокОтобранныхДокументов) Тогда 
		Для Каждого СтрокаДокумента Из СписокОтобранныхДокументов Цикл
			Если СтрокаДокумента.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;	
			КонецЕсли;
			НоваяСтрока = Документы1С.Добавить();
			Если СтрокаДокумента.Свойство("ЭтоУникальнаяСсылка") И СтрокаДокумента.ЭтоУникальнаяСсылка = Ложь Тогда
				СтрокаДокумента.НастройкаБизнесПроцесса = "";
				СтрокаДокумента.БизнесПроцесс = "";
				СтрокаДокумента.ИмяБП = "";
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);			
		КонецЦикла;
	КонецЕсли;	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеСпискаДокументовSMARTS(ОткрытиеФормы = Ложь, БезОграничений = Ложь)

	УстановкаВидимостиФункционалаВосстановленияДокументов();
	
	ДокументыMS.Очистить();	
	Если ОткрытиеФормы Тогда
		ЗаполнитьКолонкиТаблицыДокументовSMARTS();	
	КонецЕсли;
	ИзменениеВидимостиКолонокТаблицыДокументовSMARTS();
	
	СписокИдВыгруженныхДокументов.Очистить();
	
	ОтборПоПериоду = Неопределено;
	Если ЗначениеЗаполнено(ПериодОтбораMS.ДатаНачала) Или ЗначениеЗаполнено(ПериодОтбораMS.ДатаОкончания) Тогда
		ОтборПоПериоду = Новый Структура("ДатаНачала,ДатаОкончания", ПериодОтбораMS.ДатаНачала, ПериодОтбораMS.ДатаОкончания);
	КонецЕсли;
	
	ОтборПоУзлу = Неопределено;
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		ОтборПоУзлу = Новый Структура("ID_Узла", ID_Узла);
	КонецЕсли;	
		
	ТЗ = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS(, ?(БезОграничений, 0, КоличествоДокументовНаФорме), ОтборПоПериоду, ОтборПоУзлу);
	Если ТипЗнч(ТЗ) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаТЗ = ДокументыMS.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, СтрокаТЗ);
			
			// Состояние
			Если СтрокаТЗ.Завершен Тогда
				Если СтрокаТЗ.СозданНаТСД Тогда
					НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершен;					
				Иначе
					Если СтрокаТЗ.СтрокиФактКоличество = 0 Тогда
						НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершенНеИзменен;
					Иначе
						Если СтрокаТЗ.КонтрольКоличества = Истина Тогда
							Если СтрокаТЗ.ЕстьПереполнениеИлиНедобор Тогда
								НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершенЕстьРасхождения;
							Иначе
								НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершенБезРасхождений;
							КонецЕсли;
						Иначе
							НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершен;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли СтрокаТЗ.ВОбработке Тогда
				НоваяСтрокаТЗ.Состояние = СостояниеДокументаВРаботе;
			Иначе
				НоваяСтрокаТЗ.Состояние = СостояниеДокументаВыгружен;
			КонецЕсли;
						
			Если ЗначениеЗаполнено(СтрокаТЗ.ИдИсходныхДокументов) Тогда
				МассивИд =  _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаТЗ.ИдИсходныхДокументов,";");
				Для Каждого ИдОбъединенногоДокумента Из МассивИд Цикл
					Если СписокИдВыгруженныхДокументов.НайтиПоЗначению(ИдОбъединенногоДокумента) =  Неопределено Тогда
						СписокИдВыгруженныхДокументов.Добавить(ИдОбъединенногоДокумента);	
					КонецЕсли;
				КонецЦикла;
			Иначе
				Если СписокИдВыгруженныхДокументов.НайтиПоЗначению(СтрокаТЗ.Ид) =  Неопределено Тогда
					СписокИдВыгруженныхДокументов.Добавить(СтрокаТЗ.Ид);	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	 ПользователиMS = _ЛокКонтекст.СтруктураМетаданных.ПользователиMS;
	 ПроставитьСоответсвияПользователейВНазначении(ПользователиMS);
	
	ЗаполнитьИнформационныеСообщенияMS();
	
КонецПроцедуры

&НаСервере
Процедура ПроставитьСоответсвияПользователейВНазначении(ПользователиMS)
	
	ПользователиМС = ПолучитьИзВременногоХранилища(ПользователиMS);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МодульОбработки = ОбработкаОбъект;
	#Иначе
		МодульОбработки = РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЕстьКолонкаНазначение = НЕ ДокументыMS.Колонки.Найти("Назначение") = Неопределено;
	#КонецЕсли
	
	Для Каждого ДокументMS ИЗ ДокументыMS Цикл
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Если НЕ ЕстьКолонкаНазначение Тогда
				Продолжить;
			КонецЕсли;
		#Иначе
			Если НЕ ДокументMS.Свойство("Назначение") Тогда
				Продолжить;
			КонецЕсли;
		#КонецЕсли
		
		Если ДокументMS.Назначение <> "" Тогда
			СтрокаНазначения = "";
			МассивПользователей = МодульОбработки.ГлЯдро_СтрРазделить(ДокументMS.Назначение,"|", Ложь); 
			МассивКоличество = МассивПользователей.Количество();
			
			Для ИндексМассива = 1 ПО МассивКоличество  Цикл
				ДанныеПользователяПоID = ПользователиМС.Строки.Найти(МассивПользователей[ИндексМассива-1],,Истина);
				Если ДанныеПользователяПоID = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтрокаНазначения = СтрокаНазначения+ ДанныеПользователяПоID.ГруппаПользователь + "(" + ДанныеПользователяПоID.ИдГруппыПользователя + ")";
				Если ИндексМассива <> МассивКоличество Тогда
					СтрокаНазначения = СтрокаНазначения + "|";
				КонецЕсли;	
			КонецЦикла;
			ДокументMS.Назначение = СтрокаНазначения; 
		КонецЕсли;	 
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаВидимостиФункционалаВосстановленияДокументов()

	InternetGateOption 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("InternetGateOption");
	флЛегкоеОблако 		= InternetGateOption <> Ложь И ВРег(InternetGateOption) = "AVAILABLE";
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ДокументыMSВосстановитьДокументы.Видимость = флЛегкоеОблако;
	#Иначе                                                                                           
		КнопкаВосстановления = Элементы.КомПанель_ДокументыMS.Кнопки.Найти("ВосстановитьДокументы");
		Если Не флЛегкоеОблако И КнопкаВосстановления <> Неопределено Тогда
			Элементы.КомПанель_ДокументыMS.Кнопки.Удалить(КнопкаВосстановления);
		КонецЕсли;
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СВосстановитьИнфоСообщения(Команда)	
	
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщений1СФормыОбмена", 		Истина, ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщений1СПустойФормыОбмена", Истина, ID_Узла);
	НеВыводитьИнфоСтроку1С 				= Ложь;
	НеВыводитьИнфоСтроку1С_Пустую 		= Ложь; 	
	
	ВыводИнфоОбОтсутствииДокументов		= Не (Документы1С.Количество() Или НеВыводитьИнфоСтроку1С_Пустую);
	ВыводИнфоПриПолномВыводе			= Документы1С.Количество() И Документы1С.Количество() < КоличествоДокументовНаФорме И Не НеВыводитьИнфоСтроку1С;	
	ВидимостьГруппаИнфо1СВерх 			= ВыводИнфоОбОтсутствииДокументов Или ВыводИнфоПриПолномВыводе;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ВидимостьГруппаИнфо1СВерх Тогда
			Элементы.ПанельИнфоСтрока1СВерх.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрока1СВерх.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;
	#Иначе
		Элементы.ГруппаИнфо1СВерх.Видимость = ВидимостьГруппаИнфо1СВерх;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSВосстановитьИнфоСообщения(Команда)
	
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщенийMSФормыОбмена", 		Истина, ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщенийMSПустойФормыОбмена", Истина, ID_Узла);
	НеВыводитьИнфоСтрокуMS 				= Ложь;
	НеВыводитьИнфоСтрокуMS_Пустую 		= Ложь;    

	ВидимостьГруппаИнфоMSВерх = ДокументыMS.Количество() < КоличествоДокументовНаФорме И Не (НеВыводитьИнфоСтрокуMS И НеВыводитьИнфоСтрокуMS_Пустую);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ВидимостьГруппаИнфоMSВерх Тогда
			Элементы.ПанельИнфоСтрокаMSВерх.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрокаMSВерх.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;
	#Иначе
		Элементы.ГруппаИнфоMSВерх.Видимость = ВидимостьГруппаИнфоMSВерх;
	#КонецЕсли
	
КонецПроцедуры

#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	
	&НаСервере
	Процедура УстановитьУсловноеОформлениеФормы(ВключенныеКолонкиMS = Неопределено, ВключенныеКолонки1С = Неопределено)
		
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Если ВключенныеКолонкиMS <> Неопределено Тогда
				//УсловноеОформление.Элементы.Очистить();
				ОчиститьЭлементыУсловногоОформления("ДокументыMS");
				
				МассивПолейОформления = Новый Массив;
				Для Каждого Колонка Из ВключенныеКолонкиMS Цикл
					МассивПолейОформления.Добавить(Новый ПолеКомпоновкиДанных("ДокументыMS" + Колонка.Название));
				КонецЦикла;
				
				// Завершенные строки
				ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
				
				ГруппаОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументыMS.Состояние");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение = СостояниеДокументаЗавершен;
				ЭлементОтбора.Использование = Истина;
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументыMS.Состояние");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение = СостояниеДокументаЗавершенБезРасхождений;
				ЭлементОтбора.Использование = Истина;
				
				Для Каждого ПолеОформления Из МассивПолейОформления Цикл
					ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
					ПолеЭлемента.Поле = ПолеОформления;
				КонецЦикла;
				
				ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(216, 251, 216));
				
				// Строки в работе
				ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(
				СостояниеДокументаВРаботе, 
				Новый Цвет(230, 230, 250),
				МассивПолейОформления);
				
				// Строки завершены с расхождениями
				ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(
				СостояниеДокументаЗавершенЕстьРасхождения,
				Новый Цвет(255, 227, 227),
				МассивПолейОформления);
				
				// Строки завершены и не изменены
				ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(
				СостояниеДокументаЗавершенНеИзменен, 
				Новый Цвет(255, 255, 222),
				МассивПолейОформления);
			ИначеЕсли ВключенныеКолонки1С <> Неопределено Тогда
				// Оформление таблицы документов 1С, подсвечивание исходного документа 1С	
				ОчиститьЭлементыУсловногоОформления("Документы1С");
				
				ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
				ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Документы1С.Ссылка_GUID");
				ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение 	= Новый ПолеКомпоновкиДанных("ИдВыбранногоДокументаМС");				
				ЭлементОтбора.Использование 	= Истина;								
				
				Для Каждого Колонка Из ВключенныеКолонки1С Цикл
					ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
					ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("Документы1С" + Колонка.Название);
				КонецЦикла;
				
				ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 204, 153));
			КонецЕсли;
						
		#КонецЕсли
		
	КонецПроцедуры
	
	&НаСервере
	Процедура ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(Состояние, ЦветФона, МассивПолейОформления)
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		
		ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДокументыMS.Состояние");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.ПравоеЗначение 	= Состояние;
		ЭлементОтбора.Использование 	= Истина;
		
		Для Каждого ПолеОформления Из МассивПолейОформления Цикл
			ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = ПолеОформления;
		КонецЦикла;
		
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
		
	КонецПроцедуры
	
	Процедура ОчиститьЭлементыУсловногоОформления(Условие)
		МассивКУдалению = Новый Массив;
		Для Каждого ЭлементУО Из УсловноеОформление.Элементы Цикл
			Если Найти(Строка(ЭлементУО.Поля.Элементы[0].Поле),Условие) > 0 Тогда
				МассивКУдалению.Добавить(ЭлементУО);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ЭлементУО Из МассивКУдалению Цикл
			УсловноеОформление.Элементы.Удалить(ЭлементУО);
		КонецЦикла;
		
	КонецПроцедуры
#Иначе
	
	Процедура ЗаполнитьТаблицуДокументов1СОбязательнымиКолонками()
		
		// Колонка с галочками выбора
		Документы1С.Колонки.Добавить("Выгружать", Новый ОписаниеТипов("Булево"), "Выгружать", 21);
		НовыйЭФ = Элементы.Документы1С.Колонки.Добавить("Выгружать", "");
		НовыйЭФ.Видимость 			= Истина;
		НовыйЭФ.ДанныеФлажка 		= "Выгружать";
		НовыйЭФ.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
		НовыйЭФ.ТекстШапки 			= "";
		НовыйЭФ.Ширина 				= 5;
		НовыйЭФ.ИзменениеРазмера 	=  ИзменениеРазмераКолонки.НеИзменять;
		
	КонецПроцедуры
	
	Процедура ЗаполнитьТаблицуДокументовSMARTSОбязательнымиКолонками()
		
		// Колонка с галочками выбора
		ДокументыMS.Колонки.Добавить("Загружать", Новый ОписаниеТипов("Булево"), "Загружать", 21);	
		НовыйЭФ = Элементы.ДокументыMS.Колонки.Добавить("ДокументыMSЗагружать", "");
		НовыйЭФ.Видимость = Истина;
		НовыйЭФ.ДанныеФлажка = "Загружать";
		НовыйЭФ.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
		НовыйЭФ.ТекстШапки = "";
		НовыйЭФ.Ширина = 5;
		НовыйЭФ.ИзменениеРазмера = ИзменениеРазмераКолонки.НеИзменять;
		
		// Вспомогательная колонка
		ДокументыMS.Колонки.Добавить("Загружен", Новый ОписаниеТипов("Булево"), "Загружать", 21);	
				
	КонецПроцедуры

	Процедура ДокументыMSПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		Если ДанныеСтроки.Состояние = СостояниеДокументаЗавершен ИЛИ ДанныеСтроки.Состояние = СостояниеДокументаЗавершенБезРасхождений Тогда
			ОформлениеСтроки.ЦветФона = Новый Цвет(216,251,216);	
		ИначеЕсли ДанныеСтроки.Состояние = СостояниеДокументаВРаботе Тогда	
			ОформлениеСтроки.ЦветФона = WebЦвета.БледноЛиловый;
		ИначеЕсли ДанныеСтроки.Состояние = СостояниеДокументаЗавершенЕстьРасхождения Тогда	
			ОформлениеСтроки.ЦветФона = Новый Цвет(255,227,227);
	    ИначеЕсли ДанныеСтроки.Состояние = СостояниеДокументаЗавершенНеИзменен Тогда	
			ОформлениеСтроки.ЦветФона = Новый Цвет(255,255,222);
		КонецЕсли;
	КонецПроцедуры
	
	Функция ПолучитьСкрытыеКолонки()
	
		СкрытыеКолонки = Новый Массив;
		
		// Документ1С
