// Обновляет набор колонок в таблице Документов1С согласно сохранённым настройкам
// 
// Параметры:
&НаКлиенте
Процедура ЗаполнитьКолонкиТаблицыДокументов1С()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Документы1С.Колонки.Очистить();
		Элементы.Документы1С.Колонки.Очистить();
		ЗаполнитьТаблицуДокументов1СОбязательнымиКолонками();
	#Иначе
		УдалитьЛишниеКолонкиТаблицыДокументов1С();
	#КонецЕсли
	
	СохраненныеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ФормаОбменаВыбранныеКолонки", Истина);	
	
	Если СохраненныеНастройки = Ложь ИЛИ СохраненныеНастройки = Неопределено Тогда
		СписокПредставлений = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента();
		СохраненныеНастройки = ЗаполнитьКолонкиТаблицыДокументов1СПоУмолчанию(СписокПредставлений);
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонки", СохраненныеНастройки, ID_Узла);	
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонки",	СохраненныеНастройки);		
	КонецЕсли;
	
	ВключенныеКолонки = Новый Массив;
	ЕстьКолонкаСсылка = Ложь; 
	Для Каждого Настройка ИЗ СохраненныеНастройки Цикл
		Если НЕ Настройка.Свойство("Использование")
			ИЛИ НЕ Настройка.Использование Тогда
			Продолжить;
		КонецЕсли;
		ВключенныеКолонки.Добавить(Настройка);
		Если Настройка.Название = "Ссылка"
			И НЕ ЕстьКолонкаСсылка Тогда
			ЕстьКолонкаСсылка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьКолонкаСсылка Тогда
		ВключенныеКолонки.Вставить(0, Новый Структура("Название, Представление, Использование", "Ссылка", "Ссылка", Истина));
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СкрытыеКолонки = ПолучитьСкрытыеКолонки();
		
		// Добавляем включенные колонки
		Для каждого ВключеннаяКолонка ИЗ ВключенныеКолонки Цикл
			Если Документы1С.Колонки.Найти(ВключеннаяКолонка.Название) <> Неопределено Тогда
				Элементы.Документы1С.Колонки.Найти(ВключеннаяКолонка.Название).Видимость = Истина;
				Продолжить;
			КонецЕсли;
			
			СкрытаяКолонка = _ЛокКонтекст.ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(СкрытыеКолонки, "Название", ВключеннаяКолонка.Название);
			Если СкрытаяКолонка <> Неопределено Тогда
				ДобавитьКолонкуДокументы1С(СкрытаяКолонка, Истина);
			Иначе	
				ДобавитьКолонкуДокументы1С(ВключеннаяКолонка, Истина);
			КонецЕсли;
		КонецЦикла;
		
		// Добавляем скрытые обязательные колонки
		Для каждого СкрытаяКолонка ИЗ СкрытыеКолонки Цикл
			Если Документы1С.Колонки.Найти(СкрытаяКолонка.Название) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьКолонкуДокументы1С(СкрытаяКолонка, Ложь);
		КонецЦикла;
	#Иначе
		ДобавитьКолонкиТаблицыДокументов1С(ВключенныеКолонки);
	#КонецЕсли
	
КонецПроцедуры

// Добавляет колонки на форму в таблицу документов 1С
// 
// Параметры:
// 	ВключенныеКолонки - Массив - Массив с описанием колонок
&НаСервере
Процедура ДобавитьКолонкиТаблицыДокументов1С(ВключенныеКолонки)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда

		МассивРеквизитов = Новый Массив;
		КС = Новый КвалификаторыСтроки(0);
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);                
		ТаблицаПолейВыбора = Элементы.Документы1С;
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			
			Если Колонка.Название = "Ссылка" Тогда
				ТипКолонки = Новый ОписаниеТипов();
			ИначеЕсли ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ДАТА") > 0
					ИЛИ ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ВРЕМЯ") > 0 Тогда
				ТипКолонки = Новый ОписаниеТипов("Дата");
			Иначе 
				ТипКолонки = ОписаниеТиповС;
			КонецЕсли;
			
			МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Название, ТипКолонки, "Документы1С"));
			
		КонецЦикла;
		ИзменитьРеквизиты(МассивРеквизитов);
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			НовыйЭлемент = Элементы.Добавить("Документы1С"+Колонка.Название, Тип("ПолеФормы"), ТаблицаПолейВыбора);
			НовыйЭлемент.ПутьКДанным = "Документы1С." + Колонка.Название;
			НовыйЭлемент.Заголовок = Колонка.Представление;					
			НовыйЭлемент.Ширина = 5;
			НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
			НовыйЭлемент.АвтоМаксимальнаяШирина = Истина;
			Если Колонка.Название = "Количество" Тогда
				НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
			КонецЕсли;
		КонецЦикла;  
		
		УстановитьУсловноеОформлениеФормы(,ВключенныеКолонки);
	#КонецЕсли
	
КонецПроцедуры

// Удаляет все колонки но форме из таблицы документов 1С, кроме обязательных колонок
// 
// Параметры:
&НаСервере
Процедура УдалитьЛишниеКолонкиТаблицыДокументов1С()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ТабВыборки = РеквизитФормыВЗначение("Документы1С");
		
		
		МассивОбязательныхКолонок = Новый Массив;
		МассивОбязательныхКолонок.Добавить("Выгружать");
		МассивОбязательныхКолонок.Добавить("НастройкаБизнесПроцесса");
		МассивОбязательныхКолонок.Добавить("Документ1С");
		МассивОбязательныхКолонок.Добавить("ТипДокумента1С");
		МассивОбязательныхКолонок.Добавить("Ссылка_GUID");
		
		МассивУдаляемыхРеквизитов = Новый Массив;
		
		Для Каждого Колонка Из ТабВыборки.Колонки Цикл
			Если МассивОбязательныхКолонок.Найти(Колонка.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяЭлементы = "Документы1С"+Колонка.Имя;
			ЭлементФ = Элементы.Найти(ИмяЭлементы);
			Если ЭлементФ <> Неопределено Тогда 
				МассивУдаляемыхРеквизитов.Добавить("Документы1С."+Колонка.Имя);
				Элементы.Удалить(ЭлементФ);
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);	
	#КонецЕсли

КонецПроцедуры

// Формирует структуру с описанием колонок на основании списка представлений
// 
// Параметры:
// 	СписокПредставлений - СписокЗначений - Представления реквизитов документов по умолчанию
// Возвращаемое значение:
// 	Массив - Массив структур с описанием колонок
&НаСервере
Функция ЗаполнитьКолонкиТаблицыДокументов1СПоУмолчанию(СписокПредставлений)		
	
	ТаблицаВыбранныхКолонок = Новый Массив;
	ТаблицаВыбранныхКолонок.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Использование,Представление,Название"));	
	
	Для Каждого ОписаниеКолонки Из СписокПредставлений Цикл
		Если ОписаниеКолонки.Значение = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		НС = Новый Структура();
		НС.Вставить("Использование",?(ОписаниеКолонки.Значение = "Ссылка" ИЛИ ОписаниеКолонки.Значение = "Количество" ИЛИ ОписаниеКолонки.Значение = "Контрагент",Истина,Ложь));
		НС.Вставить("Представление",ОписаниеКолонки.Представление);
		НС.Вставить("Название",ОписаниеКолонки.Значение);
		ТаблицаВыбранныхКолонок.Добавить(НС);
	КонецЦикла;
	
	Возврат ТаблицаВыбранныхКолонок;
КонецФункции

// Получает из базы SMARTS данные всех документов и заполняет ими таблицу на форме
// 
// Параметры:
// 	ID_БазыSMARTS - Строка - Идентификатор базы SMARTS
&НаКлиенте
Процедура ЗаполнитьТаблицуДокументовSMARTS(ОткрытиеФормы = Ложь)

	ПолучениеСпискаДокументовSMARTS(ОткрытиеФормы, ВыборкаДокументовMSБезОграничений);
	
КонецПроцедуры

// Обновляет набор колонок в таблице Документов SMARTS согласно сохранённым настройкам
// 
// Параметры:
&НаКлиенте
Процедура ЗаполнитьКолонкиТаблицыДокументовSMARTS()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ДокументыMS.Колонки.Очистить();
		Элементы.ДокументыMS.Колонки.Очистить();		
		ЗаполнитьТаблицуДокументовSMARTSОбязательнымиКолонками();
	#Иначе
		УдалитьЛишниеКолонкиТаблицыДокументовSMARTS();
	#КонецЕсли
	
	ТаблицаНастроекКолонок = ПолучитьАктуальнуюТаблицуКолонокДокументовSMARTS();
	
	ВключенныеКолонки = Новый Массив;	
	Для Каждого Настройка из ТаблицаНастроекКолонок Цикл	
		Если Не Настройка.Свойство("Использование") Тогда
			Продолжить;
		КонецЕсли;
		ВключенныеКолонки.Добавить(Настройка);		
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Для Каждого Строка Из ВключенныеКолонки Цикл
			Если ДокументыMS.Колонки.Найти(Строка.Название) <> Неопределено Тогда
				Элементы.ДокументыMS.Колонки.Найти("ДокументыMS" + Строка.Название).Видимость = Истина;
				Продолжить;
			КонецЕсли;
			НоваяКолонка = ДокументыMS.Колонки.Добавить(Строка.Название, ,Строка.Представление);							
			
			НовыйЭФ = Элементы.ДокументыMS.Колонки.Добавить("ДокументыMS" + Строка.Название,Строка.Представление);
			НовыйЭФ.Данные = Строка.Название; 			
		КонецЦикла;
	#Иначе
		РезультатДобавленияКолонок = ДобавитьКолонкиТаблицыДокументовSMARTS(ВключенныеКолонки);
		Если НЕ РезультатДобавленияКолонок = Истина Тогда
			МассивСодержитДубли = ПроверитьМассивКолонокНаНаличиеДублей(ТаблицаНастроекКолонок);
			
			Если МассивСодержитДубли Тогда
				ВключенныеКолонки = Новый Массив;	
				Для Каждого Настройка ИЗ ТаблицаНастроекКолонок Цикл	
					Если Не Настройка.Свойство("Использование") Тогда
						Продолжить;
					КонецЕсли;
					ВключенныеКолонки.Добавить(Настройка);		
				КонецЦикла;
				
				РезультатДобавленияКолонок = ДобавитьКолонкиТаблицыДокументовSMARTS(ВключенныеКолонки);
				Если РезультатДобавленияКолонок = Истина Тогда
					_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", ТаблицаНастроекКолонок, ID_Узла);
					_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	ТаблицаНастроекКолонок);
				Иначе
					ВызватьИсключение(РезультатДобавленияКолонок);
				КонецЕсли;
			Иначе
				ВызватьИсключение(РезультатДобавленияКолонок);
			КонецЕсли;
		КонецЕсли;
		
		УстановитьУсловноеОформлениеФормы(ВключенныеКолонки);
	#КонецЕсли
		
КонецПроцедуры

// Удаляет все колонки но форме из таблицы документов SMARTS
// 
// Параметры:
&НаСервере
Процедура УдалитьЛишниеКолонкиТаблицыДокументовSMARTS()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		ТабВыборки = РеквизитФормыВЗначение("ДокументыMS"); 		
		
		МассивОбязательныхКолонок = Новый Массив;
		МассивОбязательныхКолонок.Добавить("Загружать");
		МассивОбязательныхКолонок.Добавить("Загружен");

		МассивУдаляемыхРеквизитов = Новый Массив;
		
		Для Каждого Колонка Из ТабВыборки.Колонки Цикл
			Если МассивОбязательныхКолонок.Найти(Колонка.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяЭлементы = Колонка.Имя;
			ЭлементФ = Элементы.Найти(ИмяЭлементы);
			Если ЭлементФ <> Неопределено Тогда 
				МассивУдаляемыхРеквизитов.Добавить("ДокументыMS."+Колонка.Имя);
				Элементы.Удалить(ЭлементФ);
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);	
		
	#КонецЕсли

КонецПроцедуры

// Выгружает выделенные документы 1С в базу SMARTS. При необходимости предлагает пользователю выбрать настройку бизнес-процесса и назначить пользователю
// 
// Параметры:
// 	СтрокаДокумента - Строка таблицы документов 1С для выгрузки
// 	ПроверитьНаТСД - Булево - Флаг проведённой проверки на существование этого документа в базе SMARTS
// 	ID_БизнесПроцесса - Строка - Идентификатор бизнес-процесса для выгрузки документа
// 	НазначенныеПользователи - Массив - Выбранные пользователи для назначения
&НаКлиенте
Процедура ВыгрузитьДокументВБазуSMARTS(СтрокаДокумента = Неопределено,ПроверитьНаТСД=Истина,ID_БизнесПроцесса = Неопределено,НазначенныеПользователи=Неопределено)
	
	НесколькоДокументов 	= Ложь;                       
	МассивДокументов 		= Новый Массив;
	МассивСтрок				= Новый Массив;       
	ВыгружатьВсеПереданные  = Истина;
	
	Если СтрокаДокумента = Неопределено Тогда
		ВыгружатьВсеПереданные = Ложь;
		СтрокиНаВыгрузку = Документы1С.НайтиСтроки(Новый Структура("Выгружать",Истина));
		Если СтрокиНаВыгрузку.Количество() = 0 Тогда
			// Обновить табличные части
			ЗаполнитьТаблицуДокументовSMARTS();
			Возврат;
		ИначеЕсли СтрокиНаВыгрузку.Количество() > 1 Тогда	
			НесколькоДокументов = Истина;			
			ТипДокумента1С		= "";
			// Разбиваем выгружаемые документы по типам
			Для Каждого ДокументСтрока Из СтрокиНаВыгрузку Цикл
				Если ПустаяСтрока(ТипДокумента1С) Тогда
					ТипДокумента1С = ДокументСтрока.ТипДокумента1С;
				ИначеЕсли ТипДокумента1С <> ДокументСтрока.ТипДокумента1С Тогда
					Продолжить;				
				КонецЕсли;                            
				
				МассивДокументов.Добавить(ДокументСтрока.Ссылка);				
				МассивСтрок.Добавить(ДокументСтрока);				
				СтрокаДокумента = МассивСтрок[0]; 				
			КонецЦикла; 			
		Иначе
			СтрокаДокумента = СтрокиНаВыгрузку[0];  
			МассивСтрок.Добавить(СтрокаДокумента);
			МассивДокументов.Добавить(СтрокаДокумента.Ссылка);						
		КонецЕсли;				                    	
	ИначеЕсли ТипЗнч(СтрокаДокумента) = Тип("Массив") Тогда
		НесколькоДокументов = Истина;
		МассивСтрок = СтрокаДокумента;
		Для Каждого ДокументСтрока Из МассивСтрок Цикл
			МассивДокументов.Добавить(ДокументСтрока.Ссылка);			
		КонецЦикла;	  
		СтрокаДокумента = МассивСтрок[0];  
	Иначе
		МассивСтрок.Добавить(СтрокаДокумента);
		МассивДокументов.Добавить(СтрокаДокумента.Ссылка);
	КонецЕсли;
	
	Если ПроверитьНаТСД Тогда
		Если Не НесколькоДокументов Тогда
			
			Если СписокИдВыгруженныхДокументов.НайтиПоЗначению(XMLСтрокаНаСервере(СтрокаДокумента.Ссылка)) <> Неопределено Тогда
				ТекстВопроса = НСтр("be = 'Дакумент ""%1"" ужо быў выгружаны на Мабільнае прылада. Паўтарыць выгрузку?'; en = 'Document ""%1"" has already been uploaded to the Mobile device. Repeat upload?'; es = 'El documento ""%1"" ya ha sido descargado en el dispositivo móvil. ¿Repetir la descarga?'; ka = 'დოკუმენტი ""%1"" უკვე გამოტანილია მობილურ მოწყობილობაზე. გსურთ გაგრძელება?'; kk = '""%1"" құжаты мобильді құрылғыға қалдырылды. Қайтадан жүктеу керек пе?'; ro = 'Documentul ""%1"" a fost deja descărcat pe Dispozitivul mobil. Repetați descărcarea?'; ru = 'Документ ""%1"" уже был выгружен на ТСД. Повторить выгрузку?'; tr = '""%1"" belgesi zaten Mobil cihaza yüklenmiş. Yüklemeyi tekrarlamak istiyor musunuz?'; uk = 'Документ ""%1"" вже був вивантажений на Мобільний пристрій. Повторити вивантаження?'; uz = '""%1"" ҳужжати мобил қурилмага олинган. Қайтаришни истасизми?'");
				ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, Строка(СтрокаДокумента.Ссылка));
				ОповещениеВопросПовторВыгрузки = Новый ОписаниеОповещения("ОповещениеВопросПовторВыгрузкиЗавершение", ЭтаФорма, СтрокаДокумента);
				ПоказатьВопрос(ОповещениеВопросПовторВыгрузки, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
				Возврат;
			КонецЕсли;         
			
		Иначе
			
			ПерваяСтрока 				= Истина;
			ТекстВопроса 				= "";     
			МассивВыгруженныхДокументов = Новый Массив;
			
			Для Каждого ДокументСтрока Из МассивСтрок Цикл
				Если СписокИдВыгруженныхДокументов.НайтиПоЗначению(XMLСтрокаНаСервере(ДокументСтрока.Ссылка)) <> Неопределено Тогда
					ТекстВопроса = ТекстВопроса + ?(ПерваяСтрока,"","," + Символы.ПС) + """" + Строка(ДокументСтрока.Ссылка) + """";
					ПерваяСтрока = Ложь;			
					МассивВыгруженныхДокументов.Добавить(ДокументСтрока);
				КонецЕсли;
			КонецЦикла;	
			
			Если ТекстВопроса <> "" Тогда
				ШаблонВопроса = НСтр("be = 'Дакументы: %1 Ужо былі выгружаны на Мабільнае прылада. Паўтарыць выгрузку?'; en = 'Documents: %1 Have already been uploaded to the Mobile device. Repeat upload?'; es = 'Documentos: %1 Ya han sido descargados en el dispositivo móvil. ¿Repetir la descarga?'; ka = 'დოკუმენტები: %1 უკვე გამოტანილია მობილურ მოწყობილობაზე. გსურთ გაგრძელება?'; kk = 'Құжаттар: %1 Мобильді құрылға қалдырылды. Қайтадан жүктеу керек пе?'; ro = 'Documentele: %1 Au fost deja descărcate pe Dispozitivul mobil. Repetați descărcarea?'; ru = 'Документы: %1 Уже были выгружены на ТСД. Повторить выгрузку?'; tr = 'Belgeler: %1 Zaten Mobil cihaza yüklendi. Yüklemeyi tekrarlamak istiyor musunuz?'; uk = 'Документи: %1 Вже були вивантажені на Мобільний пристрій. Повторити вивантаження?'; uz = 'Ҳужжатлар: %1 Мобил қурилмага олинган. Қайтаришни истасизми?'");
				ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ШаблонВопроса, Символы.ПС + ТекстВопроса + "." + Символы.ПС);
				ОповещениеВопросПовторВыгрузки = Новый ОписаниеОповещения("ОповещениеВопросПовторВыгрузкиЗавершение", ЭтаФорма, МассивВыгруженныхДокументов);
				ПоказатьВопрос(ОповещениеВопросПовторВыгрузки, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 	
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;      
	
	Если ID_БизнесПроцесса = Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаДокумента.НастройкаБизнесПроцесса) Тогда
			
			ID_БизнесПроцесса = СтрокаДокумента.НастройкаБизнесПроцесса;	
			
		Иначе
						
			Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
				НастройкиОтборовУзлов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Интерактивный");
			Иначе
				НастройкиОтборовУзлов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_Интерактивный", ID_Узла);
			КонецЕсли;
			
			НастройкиОбмена = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
			НайденныеСтроки = Новый Массив;
			
			// Получаем доступные бизнес-процессы, с учетом настроек и отборов
			Если Не НесколькоДокументов Тогда
				МассивДокументов = Новый Массив;
				МассивДокументов.Добавить(СтрокаДокумента.Ссылка);				  							
			КонецЕсли;
