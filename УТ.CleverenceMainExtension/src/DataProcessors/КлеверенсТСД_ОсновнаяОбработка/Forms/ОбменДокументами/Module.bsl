&НаКлиенте
Процедура ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(РезультатВопроса = Неопределено,ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;	
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("НазначенныеПользователи") Тогда 
		НазначенныеПользователи = ДополнительныеПараметры.НазначенныеПользователи;
	Иначе
		НазначенныеПользователи = Неопределено;
	КонецЕсли;
	
	НастройкиОбмена = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	
	МассивДокументов 	= Новый Массив;
	МассивСтрок			= Новый Массив;       
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("МассивДокументов") Тогда 
			МассивДокументов = ДополнительныеПараметры.МассивДокументов;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("МассивСтрок") Тогда 
			МассивСтрок = ДополнительныеПараметры.МассивСтрок;
		КонецЕсли;
	КонецЕсли;
	
	Если Не МассивСтрок.Количество() Тогда
		ВыбранныеДокументы = Документы1С.НайтиСтроки(Новый Структура("Выгружать", Истина));
													
		Если ВыбранныеДокументы.Количество() > 0 Тогда
			ДокументКВыгрузке = ВыбранныеДокументы[0];		
			Для Каждого ВыбранныйДокумент из ВыбранныеДокументы Цикл			
				Если ВыбранныйДокумент.НастройкаБизнесПроцесса <> ДокументКВыгрузке.НастройкаБизнесПроцесса Тогда
					Сообщение = НСтр("be = ""Для выбраных дакументаў наладжаны розныя бізнес працэсы. Аб'яднанне немагчыма.""; en = 'Different business processes are configured for the selected documents. Merging is impossible.'; es = 'Los documentos seleccionados tienen diferentes procesos de negocio configurados. No se puede realizar la unión.'; ka = 'არჩეული დოკუმენტებისთვის დაკავშირებული ბიზნეს პროცესები განაყოფილია. შეერთება შეუძლებელია.'; kk = 'Таңдалған құжаттар өзге бизнес процестерге тең болған. Біріктіру мүмкін емес.'; ro = 'Pentru documentele selectate sunt configurate procese de afaceri diferite. Unirea este imposibilă.'; ru = 'Для выбранных документов настроены разные бизнес процессы. Объединение невозможно.'; tr = 'Seçilen belgeler için farklı iş süreçleri yapılandırılmıştır. Birleştirme mümkün değil.'; uk = ""Для обраних документів налаштовані різні бізнес-процеси. Об'єднання неможливе.""; uz = 'Tanlangan hujjatlarga turli biznes jarayonlari sozlangan. Birlashtirish imkonsiz.'");
					Сообщить(Сообщение); 
					Возврат;
				КонецЕсли;
				Если ВыбранныйДокумент.ТипДокумента1С <> ДокументКВыгрузке.ТипДокумента1С Тогда
					Сообщение = НСтр("be = ""Выбраны розныя тыпы дакументаў. Аб'яднанне немагчыма.""; en = 'Different types of documents are selected. Merging is not possible.'; es = 'Se han seleccionado diferentes tipos de documentos. No se puede combinar.'; ka = 'არჩეული დოკუმენტების სხვადასხვა ტიპები. შეერთება შეუძლებელია.'; kk = 'Құжаттардың кәсіптік түрлері таңдалды. Біріктіру мүмкін емес.'; ro = 'Sunt selectate tipuri diferite de documente. Unirea este imposibilă.'; ru = 'Выбраны разные типы документов. Объединение невозможно.'; tr = 'Farklı belge türleri seçildi. Birleştirme mümkün değil.'; uk = ""Обрано різні типи документів. Об'єднання неможливе.""; uz = 'Farqli hujjat turlari tanlandi. Birlashtirish imkonsiz.'");
					Сообщить(Сообщение); 
					Возврат;
				КонецЕсли;                                          
				
				МассивДокументов.Добавить(ВыбранныйДокумент.Ссылка);
				МассивСтрок.Добавить(ВыбранныйДокумент);
			КонецЦикла;                                             		
		Иначе
			ЗаполнитьТаблицуДокументов1С();
			Возврат;
		КонецЕсли;
	Иначе
		ДокументКВыгрузке = МассивСтрок[0];	
	КонецЕсли;
	
	ID_БизнесПроцесса = ДокументКВыгрузке.НастройкаБизнесПроцесса;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("ID_БизнесПроцесса") И ЗначениеЗаполнено(ДополнительныеПараметры.ID_БизнесПроцесса) Тогда
		ID_БизнесПроцесса = ДополнительныеПараметры.ID_БизнесПроцесса;
	КонецЕсли;
		
	Если ID_БизнесПроцесса = Неопределено Или ПустаяСтрока(ID_БизнесПроцесса) Тогда
		Если ЗначениеЗаполнено(ДокументКВыгрузке.НастройкаБизнесПроцесса) Тогда
			
			ID_БизнесПроцесса = ДокументКВыгрузке.НастройкаБизнесПроцесса;	
			
		Иначе
						
			Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
				НастройкиОтборовУзлов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Интерактивный");
			Иначе
				НастройкиОтборовУзлов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_Интерактивный", ID_Узла);
			КонецЕсли;
			
			НастройкиОбмена = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
			НайденныеСтроки = Новый Массив;
						
			// Получаем доступные бизнес-процессы, с учетом настроек и отборов
			НайденныеСтроки = _ЛокКонтекст.ЛокЯдро_ПолучитьБизнесПроцессДляТекущихДокументов("Интерактивный", МассивДокументов, СокрЛП(ДокументКВыгрузке.ТипДокумента1С));

			Если НЕ НайденныеСтроки.Количество() Тогда
				
				Сообщение = НСтр("be = 'Не ўдалося падабраць наладу бізнес-працэсу для дакумента ""%1""'; en = 'Failed to find a business process setting for document ""%1""'; es = 'No se pudo encontrar la configuración del proceso de negocio para el documento ""%1""'; ka = 'ბიზნეს პროცესის პარამეტრები ვერ მოიძებნა დოკუმენტისთვის ""%1""'; kk = '""%1"" документі үшін бизнес-процесті таңдау мүмкін емес'; ro = 'Nu s-a putut selecta setarea procesului de afaceri pentru documentul ""%1""'; ru = 'Не удалось подобрать настройку бизнес-процесса для документа ""%1""'; tr = '""%1"" belgesi için iş süreci ayarı bulunamadı'; uk = 'Не вдалося підібрати налаштування бізнес-процесу для документа ""%1""'; uz = '""%1"" ҳужжат учун бизнес процессини танлаш мумкин эмас'");
				Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(ДокументКВыгрузке.Ссылка));
				Сообщить(Сообщение); 
				СнятьПометкуВыгружатьВСтрокеТаблицы(МассивДокументов);
				ВыгрузитьДокументВБазуSMARTS();
				Возврат;
				
			ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
				
				ID_БизнесПроцесса = НайденныеСтроки[0].ID_БизнесПроцесса;
				
			ИначеЕсли НайденныеСтроки.Количество() > 1 Тогда
				
				ПереданнаяТаблица = Новый Массив;
				ПереданнаяТаблица.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Название,ТипИсходногоДокумента1С_Синоним,ТипИсходногоДокумента1С,ID_БизнесПроцесса"));			
				
				Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					НоваяСтруктура = Новый Структура();
					НоваяСтруктура.Вставить("Название",							НайденнаяСтрока.Название);
					НоваяСтруктура.Вставить("ТипИсходногоДокумента1С_Синоним",	Строка(ТипЗнч(ДокументКВыгрузке.Ссылка)));
					НоваяСтруктура.Вставить("ТипИсходногоДокумента1С",			СокрЛП(ДокументКВыгрузке.ТипДокумента1С));
					НоваяСтруктура.Вставить("ID_БизнесПроцесса",				НайденнаяСтрока.ID_БизнесПроцесса);
					
					ПереданнаяТаблица.Добавить(НоваяСтруктура);
				КонецЦикла; 			
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
