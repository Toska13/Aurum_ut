			ТекстЗаголовка = НСтр("be = 'Выберыце карыстальніка для дакумента %1'; en = 'Select a user for document %1'; es = 'Elija un usuario para el documento %1'; ka = 'აირჩიეთ მომხმარებელი დოკუმენტის %1'; kk = '%1 документі үшін пайдаланушыны таңдаңыз'; ro = 'Alegeți utilizatorul pentru documentul %1'; ru = 'Выберите пользователя для документа %1'; tr = '%1 belgesi için bir kullanıcı seçin'; uk = 'Оберіть користувача для документа %1'; uz = '%1 hujjati uchun foydalanuvchini tanlang'");
			ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка));
		КонецЕсли;
		ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = ТекстЗаголовка;				
		ФормаСлужебная_ВыборПользователяИлиГруппы.ПользователиMSАдрес = ПользователиMS;
		ФормаСлужебная_ВыборПользователяИлиГруппы.ОдиночныйРежимВыделения = Истина;
		ФормаСлужебная_ВыборПользователяИлиГруппы.СпособНазначения = СпособНазначения;
		Если СпособНазначения = "Устройству" Тогда                                                                                      
			Если НесколькоДокументов И ВыгружатьВсеПереданные Тогда
				ТекстЗаголовка = НСтр("be = 'Выберыце прылад для дакумента %1 і яшчэ %2 дакументаў'; en = 'Select a device for document %1 and %2 more documents'; es = 'Elija un dispositivo para el documento %1 y otros %2 documentos'; ka = 'აირჩიეთ მოწყობილობა დოკუმენტის %1 და კიდევ %2 დოკუმენტი'; kk = '%1 документі үшін құрылғы таңдаңыз және қоса %2 документтер'; ro = 'Alegeți dispozitivul pentru documentul %1 și încă %2 documente'; ru = 'Выберите устройство для документа %1 и еще %2 документов'; tr = '%1 belgesi için bir cihaz seçin ve %2 belge daha seçin'; uk = 'Оберіть пристрій для документа %1 і ще %2 документів'; uz = '%1 hujjati uchun qurilmayni tanlang va yana %2 hujjatlar'");
				ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка), Строка(МассивДокументов.Количество()-1));
			Иначе     
				ТекстЗаголовка = НСтр("be = 'Выберыце прылад для дакумента %1'; en = 'Select a device for document %1'; es = 'Elija un dispositivo para el documento %1'; ka = 'აირჩიეთ მოწყობილობა დოკუმენტის %1'; kk = '%1 документі үшін құрылғы таңдаңыз'; ro = 'Alegeți dispozitivul pentru documentul %1'; ru = 'Выберите устройство для документа %1'; tr = '%1 belgesi için bir cihaz seçin'; uk = 'Оберіть пристрій для документа %1'; uz = '%1 hujjati uchun qurilmayni tanlang'");
				ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка));
			КонецЕсли;
			ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = ТекстЗаголовка;
			ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMSГруппаПользователь"].Заголовок = НСтр("be = 'Прылада'; en = 'Device'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; ru = 'Устройство'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
		КонецЕсли;                                                                  
		
		ДопПараметры = Новый Структура("ВыгрузитьКакОдин,МассивСтрокДокументов,ПроверитьНаТСД,ID_БизнесПроцесса,СпособНазначения", Ложь, МассивСтрок, ПроверитьНаТСД, ID_БизнесПроцесса, СпособНазначения);
		ОП = Новый ОписаниеОповещения("Служебная_ВыборПользователяИлиГруппыЗакрытие", ЭтаФорма, ДопПараметры);
		ФормаСлужебная_ВыборПользователяИлиГруппы.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_ВыборПользователяИлиГруппы.ОткрытьМодально();
		#Иначе
			ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();
		#КонецЕсли
		
		Возврат;
		
	КонецЕсли;
	
	Если (флУказатьПользователя Или флОтправитьНаУстройство) И НазначенныеПользователи[0].Ид = "Выгружать всем" Тогда 
		НазначенныеПользователи = Неопределено;
	КонецЕсли;
	
	Если ВыгружатьВсеПереданные Тогда
		Для Каждого ДокументСсылка Из МассивДокументов Цикл
			_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(ДокументСсылка, ID_БизнесПроцесса, НазначенныеПользователи, ТипБазы);
		КонецЦикла;
		СнятьПометкуВыгружатьВСтрокеТаблицы(МассивДокументов);	
	Иначе     
		_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(СтрокаДокумента.Ссылка, ID_БизнесПроцесса, НазначенныеПользователи, ТипБазы);		
		СнятьПометкуВыгружатьВСтрокеТаблицы(СтрокаДокумента.Ссылка);	
	КонецЕсли;                                              	
	ВыгрузитьДокументВБазуSMARTS(, ВыгружатьВсеПереданные Или МассивДокументов.Количество() = 1);
			
КонецПроцедуры

// Обновляет набор колонок в таблице ДокументовMS согласно сохранённым настройкам
// 
// Параметры:
&НаКлиенте
Процедура ИзменениеВидимостиКолонокТаблицыДокументовSMARTS()
			
	ТаблицаНастроекКолонок = ПолучитьАктуальнуюТаблицуКолонокДокументовSMARTS();
	
	Для Каждого Настройка из ТаблицаНастроекКолонок Цикл
		Если Настройка.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		ИмяКолонки = "ДокументыMS" + Настройка.Название;
		Если Настройка.Свойство("Использование") Тогда		
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Если ЭлементыФормы.ДокументыMS.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
					ЭлементыФормы.ДокументыMS.Колонки[ИмяКолонки].Видимость = Настройка.Использование;
				КонецЕсли;
			#Иначе
				Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда
					Элементы[ИмяКолонки].Видимость = Настройка.Использование;
				КонецЕсли;
			#КонецЕсли     	
		Иначе
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Если ЭлементыФормы.ДокументыMS.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
					ЭлементыФормы.ДокументыMS.Колонки["ДокументыMS" + Настройка.Название].Видимость = Ложь;
				КонецЕсли;
			#Иначе
				Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда				
					Элементы[ИмяКолонки].Видимость = Ложь;
				КонецЕсли;
			#КонецЕсли     	
		КонецЕсли;		
	КонецЦикла;
		
КонецПроцедуры

// Получает из настроек/формирует по-умолчанию список колонок документов SMARTS
// 
// Параметры:
&НаКлиенте
Функция ПолучитьАктуальнуюТаблицуКолонокДокументовSMARTS()
	
	Перем АктуальнаяТаблицаКолонок;
	
	СписокКолонокТаблицы = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивКолонокТаблицыДокументовSMARTS();		
	СохраненныеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",Истина);
	 	
	Если ЭтоВебКлиент И ТипЗнч(СохраненныеНастройки) = Тип("Массив") Тогда
		НастройкиПоУмолчанию = СписокКолонокТаблицы.Количество() < СохраненныеНастройки.Количество();	
	Иначе
		НастройкиПоУмолчанию = СохраненныеНастройки = Ложь Или СохраненныеНастройки = Неопределено;
	КонецЕсли;
	
	Если НастройкиПоУмолчанию Тогда
		
		АктуальнаяТаблицаКолонок = ЗаполнитьКолонкиТаблицыДокументов1СПоУмолчанию(СписокКолонокТаблицы);
		// Таблица документов SMARTS по умолчанию должна выводиться со всеми колонками
		Для Каждого СтрокаРеквизита Из АктуальнаяТаблицаКолонок Цикл
			Если СтрокаРеквизита.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			СтрокаРеквизита.Использование = Истина;		
		КонецЦикла;
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", АктуальнаяТаблицаКолонок, ID_Узла);	
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	АктуальнаяТаблицаКолонок);		
		
	Иначе 	
		
		АктуальнаяТаблицаКолонок = Новый Массив;
		АктуальнаяТаблицаКолонок.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Использование,Представление,Название"));
		
		// Если вдруг сохранились настройки с ограниченным количеством реквизитов, необходимо дополнить их актуальными
		ЕстьИзменениеКолонок = Ложь;
		
		МассивКолонок = Новый Массив; 		
		Для Каждого Строка Из СохраненныеНастройки Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// оставляем только существующие
			Колонка = СписокКолонокТаблицы.НайтиПоЗначению(Строка.Название);
			Если Колонка <> Неопределено Тогда
				Если Строка.Представление <> Колонка.Представление Тогда
					Строка.Представление = Колонка.Представление;
					ЕстьИзменениеКолонок = Истина;
				КонецЕсли;
				АктуальнаяТаблицаКолонок.Добавить(Строка);
				МассивКолонок.Добавить(Строка.Название);
			Иначе
				ЕстьИзменениеКолонок = Истина;
			КонецЕсли;
		КонецЦикла;
		
		// добавляем отсутствующие
		Для Каждого СтрокаКолонки Из СписокКолонокТаблицы Цикл
			Если МассивКолонок.Найти(СтрокаКолонки.Значение) = Неопределено Тогда
				НоваяСтрокаНастройки = Новый Структура("Использование, Название, Представление", 
					Ложь, 
					СтрокаКолонки.Значение, 
					СтрокаКолонки.Представление);
				АктуальнаяТаблицаКолонок.Добавить(НоваяСтрокаНастройки);
				ЕстьНовыеКолонки = Истина;			
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьИзменениеКолонок Тогда
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", АктуальнаяТаблицаКолонок, ID_Узла);	
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	АктуальнаяТаблицаКолонок);		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АктуальнаяТаблицаКолонок;
	
КонецФункции

// Убирает флаг Выгружать в строке таблицы документов 1С после выгрузки
// 
// Параметры:
// 	Документ1С - ДокументСсылка - Ссылка на выгруженный документ 
&НаКлиенте
Процедура СнятьПометкуВыгружатьВСтрокеТаблицы(Документ1С)
	
	Если ТипЗнч(Документ1С) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива ИЗ Документ1С Цикл
			СнятьПометкуВыгружатьВСтрокеТаблицы(ЭлементМассива);
		КонецЦикла;
	КонецЕсли;	

	Строка = Документы1С.НайтиСтроки(Новый Структура("Ссылка",Документ1С));
	
	Если Строка.Количество() > 0 Тогда
		Строка[0].Выгружать = Ложь;	
	КонецЕсли;	

КонецПроцедуры

// Открывает форму просмотра документа Клеверенс
// 
// Параметры:
&НаКлиенте
Процедура ОткрытьДокументТСД()
	
	ТекущиеДанные = Элементы.ДокументыMS.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда			
		Возврат;
	КонецЕсли; 					
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаПросмотра_ДокументMS = ПолучитьФорму("ОФ_ФормаПросмотра_ДокументMS", ЭтаФорма);
	#Иначе
		ФормаПросмотра_ДокументMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаПросмотра_ДокументMS", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	
	Если ФормаПросмотра_ДокументMS.Открыта() Тогда		
		ФормаПросмотра_ДокументMS.Закрыть();	
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаПросмотра_ДокументMS = ПолучитьФорму("ОФ_ФормаПросмотра_ДокументMS", ЭтаФорма);
		#Иначе
			ФормаПросмотра_ДокументMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаПросмотра_ДокументMS", , ЭтаФорма, ЭтаФорма);									
		#КонецЕсли
	КонецЕсли;		
	
	ФормаПросмотра_ДокументMS.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаПросмотра_ДокументMS._ЛокКонтекст = _ЛокКонтекст;
	ФормаПросмотра_ДокументMS.Ид = ТекущиеДанные.Ид;
	ФормаПросмотра_ДокументMS.ТипДокументаMS = ТекущиеДанные.ИмяТипаДокумента;
	ФормаПросмотра_ДокументMS.Открыть();							
	
КонецПроцедуры

// Загружает в базу 1С документ полученный из базы SMARTS. При необходимости предлагет выбрать бизнес-процесс 
// для загрузки документа и существующий документ 1С для заполнения данными из SMARTS
// 
// Параметры:
// 	ДокументКЗагрузке - Строка таблицы документов Клеверенс
// 	ID_БизнесПроцесса - Строка - Идентификатор бизнес-процесса для загрузки
// 	ДокументДляЗаполнения - ДокументСсылка - Ссылка на документ заполняемый данными из SMARTS
//	ВсеВОдин - Булево - Все документы Клеверенс будут загружены в один документ 1С
//	ЛюбойБП - Булево - Предоставится выбор любого бизнес-процесса для загрузки
&НаКлиенте
Процедура ЗагрузитьВыбранныеДокументыВБазу1С(ДокументКЗагрузке = Неопределено,ID_БизнесПроцесса=Неопределено,ДокументДляЗаполнения=Неопределено, ВсеВОдин=Ложь,ЛюбойБП=Ложь)
	
	// Флаг, предназначеный для определения последнего элемента массива загружаемых документов
	ЭтоПоследнийДокумент = Истина;
	
	Если ДокументКЗагрузке = Неопределено Тогда		
		ОтмеченныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		
		ВыбранныеДокументы = Новый Массив;
		Для Каждого ВыбранныйДок Из ОтмеченныеДокументы  Цикл
			Если Найти(ВыбранныйДок.Состояние, СостояниеДокументаЗавершен) >  0 Тогда
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Если ТипЗнч(ВыбранныйДок) = Тип("СтрокаТаблицыЗначений") Тогда
						СтруктураДокумента = Новый Структура;
						Для каждого Колонка Из ДокументыMS.Колонки Цикл
							СтруктураДокумента.Вставить(Колонка.Имя);
						КонецЦикла;
						ЗаполнитьЗначенияСвойств(СтруктураДокумента, ВыбранныйДок);
						ВыбранныйДок = СтруктураДокумента;
					КонецЕсли;
				#КонецЕсли 
				
				ВыбранныеДокументы.Добавить(ВыбранныйДок);
			Иначе
				ТекстСообщения = НСтр("ru = '%1: для загрузки в 1С документ должен находиться в состоянии ""Завершен""'; en = '%1: to upload a document to 1C, it must be in the ""Completed"" state'; kk = '%1: 1С-ке жүктеу үшін құжатты ""Аяқталған"" күшінде болуы керек'; uz = '%1: 1Сга юклаб олиш учун ҳужжатнинг ""Тугатилган"" ҳолатида бўлиши керак'; be = '%1: для загрузкі ў 1С дакумент павінен знаходзіцца ў стане ""Завершаны""'; uk = '%1: для завантаження в 1С документ повинен знаходитися в стані ""Завершений""'; ka = '%1: 1C-ში ჩატვირთვისთვის დოკუმენტი უნდა იყოს ""დასრულებული"" სტატუსში'; tr = '%1: 1C''ye yükleme için belgenin ""Tamamlandı"" durumunda olması gerekmektedir'; es = '%1: para cargar el documento en 1C, debe estar en estado ""Completado""'; ro = '%1: pentru a fi încărcat în 1C, documentul trebuie să fie în starea ""Finalizat""'");
