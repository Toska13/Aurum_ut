
&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ТаблицаРеквизитовДополнительная Экспорт,
	ТаблицаРеквизитовИсходная Экспорт,
	ПредыдущееЗначение;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии()
	
	Если ЗначениеЗаполнено(ТипДокумента1С) Тогда
		ТипДокумента1ССиноним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].Синоним;
		СписокРеквизитов1С = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].Реквизиты.Скопировать();
	Иначе
		ТипДокумента1ССиноним = "";
		СписокРеквизитов1С = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента(ТипДокумента1С);
	КонецЕсли;
	ТипДокументаMSСиноним = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Синоним;
	
			
	СписокРеквизитов1С.Добавить("Количество","Количество");
	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовНазваниеРеквизита.СписокВыбора,СписокРеквизитов1С);
	
	Если ЗначениеЗаполнено(ТаблицаРеквизитовИсходная) И ТаблицаРеквизитовИсходная.Количество() > 0 Тогда
		Для Каждого Строка Из ТаблицаРеквизитовИсходная Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НС = ТаблицаРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Строка);
		КонецЦикла;
	Иначе		
		СписокПредставленийРеквизитов1С = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента(ТипДокумента1С);	
		 			
		Для Каждого ПредставлениеРеквизита Из СписокПредставленийРеквизитов1С Цикл
			НС = ТаблицаРеквизитов.Добавить();
			НС.Использование = Истина;
			НС.ПредставлениеРеквизита = ПредставлениеРеквизита.Представление;
			НС.НазваниеРеквизита = ПредставлениеРеквизита.Значение;
			НС.ИспользоватьПриВыгрузке = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьВидимость();
	ОбновитьШаблон();
КонецПроцедуры

#КонецОбласти	

#Область ОбработчикиСобытийОсновныеДействияФормы

&НаКлиенте
Процедура ОсновныеДействияСохранитьИЗакрыть(Кнопка)
	
	Результат = Новый Структура;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	Результат.Вставить("ТаблицаНастроек", _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов));
	Результат.Вставить("ЗаменитьПредставлениеДокументаПриВыгрузке", ЗаменитьПредставлениеДокументаПриВыгрузке);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанельТаблицыНастройкиПоУмолчанию(Кнопка)
	
	ТаблицаРеквизитов.Очистить();
	СписокПредставленийРеквизитов1С = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента(ТипДокумента1С);	
		 			
	Для Каждого ПредставлениеРеквизита Из СписокПредставленийРеквизитов1С Цикл
		НС = ТаблицаРеквизитов.Добавить();
		НС.Использование = Истина;
		НС.ПредставлениеРеквизита = ПредставлениеРеквизита.Представление;
		НС.НазваниеРеквизита = ПредставлениеРеквизита.Значение;
		НС.ИспользоватьПриВыгрузке = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовНазваниеРеквизитаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.НазваниеРеквизита;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовНазваниеРеквизитаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ПредыдущееЗначение <> ТекущаяСтрока.НазваниеРеквизита Тогда
		//НайденныйЭлементСписка = СписокРеквизитов1С.НайтиПоЗначению(Элемент.Значение);
		ТекущаяСтрока.ПредставлениеРеквизита = ТекущаяСтрока.НазваниеРеквизита;
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьПредставлениеДокументаПриВыгрузкеПриИзменении(Элемент)
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.Колонки.ТаблицаРеквизитовИспользоватьПриВыгрузке.Видимость = ЗаменитьПредставлениеДокументаПриВыгрузке;
	#Иначе
		Элементы.ТаблицаРеквизитовИспользоватьПриВыгрузке.Видимость = ЗаменитьПредставлениеДокументаПриВыгрузке;		
	#КонецЕсли
	Элементы.ШаблонИмени.Видимость =  ЗаменитьПредставлениеДокументаПриВыгрузке;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПриИзмененииФлажка(Элемент, Колонка)
	ОбновитьШаблон();
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура ОбновитьШаблон()
	ШаблонИмени = "";
	
	Если ЗаменитьПредставлениеДокументаПриВыгрузке Тогда
		СтрокаИмени = "";
		ВключенныеРеквизиты = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("ИспользоватьПриВыгрузке", Истина));
		Для Каждого ВключенныйРеквизит Из ВключенныеРеквизиты Цикл
			СтрокаИмени = СтрокаИмени+?(СтрокаИмени = "","",", ")+ВключенныйРеквизит.НазваниеРеквизита;
		КонецЦикла;
		ШаблонИмени  = СтрокаИмени;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Приемник,Список)
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение,Элем.Представление);	
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаРеквизитов;
		Возврат ПоместитьВоВременноеХранилище(ТаблицаРеквизитов,Новый УникальныйИдентификатор());
	#Иначе
		ТЗ = РеквизитФормыВЗначение("ТаблицаРеквизитов");
		Возврат ПоместитьВоВременноеХранилище(ТЗ,ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура УдалитьВсеНастройки(Команда)
	ТаблицаРеквизитов.Очистить();
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
#КонецЕсли