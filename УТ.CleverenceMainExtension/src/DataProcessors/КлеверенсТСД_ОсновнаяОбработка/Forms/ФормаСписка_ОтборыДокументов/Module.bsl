&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ПредыдущееЗначение;

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтоТекущийУзел = ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	Если ЭтоТекущийУзел Тогда
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + ТипОбмена);
	Иначе
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, ID_Узла);
	КонецЕсли;
	ЗаполнитьТаблицуЗначениямиНастройки(ЗначениеНастройки, Истина);
	
	Если ЗначениеЗаполнено(НаименованиеУзла) Тогда 
		ТекстЗаголовка = НСтр("be = 'Cleverence: Наладкі выбараў бізнес-працэсаў для магазіна %1'; en = 'Cleverence: Business process selections settings for store %1'; es = 'Cleverence: Configuración de selección de procesos de negocio para tienda %1'; ka = 'Cleverence: ბიზნეს პროცესების გამოტანის პარამეტრები მაღაზია %1'; kk = 'Cleverence: Магазин %1 үшін бизнес процестердің таңдаулары'; ro = 'Cleverence: Setările selecțiilor proceselor de afaceri pentru magazinul %1'; ru = 'Клеверенс: Настройки отборов бизнес-процессов для магазина  %1'; tr = 'Cleverence: Mağaza için iş süreçleri seçim ayarları %1'; uk = 'Cleverence: Налаштування відборів бізнес-процесів для магазину %1'; uz = ""Cleverence: Do'kon uchun biznes jarayonlarini tanlash sozlash %1""");
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, НаименованиеУзла);
		ЭтаФорма.Заголовок = ТекстЗаголовка;
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.НаименованиеУзла.Видимость = Истина;
            Элементы.ЗагрузитьНастройкиПоУмолчанию.Видимость	   = Ложь;
			Элементы.ГруппаЗагрузитьНастройкиПоУмолчанию.Видимость = Истина;
		#Иначе	
			Элементы.ДействияФормы.Кнопки.Удалить(Элементы.ДействияФормы.Кнопки.ЗагрузитьНастройкиПоУмолчанию);
		#КонецЕсли
	Иначе
		ЭтаФорма.Заголовок = НСтр("be = 'Cleverence: Наладкі выбараў бізнес-працэсаў (глабальныя)'; en = 'Cleverence: Business process selections settings (global)'; es = 'Cleverence: Configuración de selección de procesos de negocio (global)'; ka = 'Cleverence: ბიზნეს პროცესების გამოტანის პარამეტრები (გლობალური)'; kk = 'Cleverence: Бизнес процестердің таңдаулары (глобалдық)'; ro = 'Cleverence: Setările selecțiilor proceselor de afaceri (globale)'; ru = 'Клеверенс: Настройки отборов бизнес-процессов (глобальные)'; tr = 'Cleverence: İş süreçleri seçim ayarları (global)'; uk = 'Cleverence: Налаштування відборів бізнес-процесів (глобальні)'; uz = 'Cleverence: Biznes jarayonlarni tanlash sozlash (global)'");
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;
			Элементы.ЗагрузитьНастройкиПоУмолчанию.Видимость	   = Истина;
			Элементы.ГруппаЗагрузитьНастройкиПоУмолчанию.Видимость = Ложь;
		#Иначе	
			Элементы.ДействияФормы.Кнопки.Удалить(Элементы.ДействияФормы.Кнопки.ГруппаЗагрузитьНастройкиПоУмолчанию);
		#КонецЕсли
	КонецЕсли;
	
	ТипОбменаПредставление = "";
	Если ТипОбмена = "Онлайн" Тогда
		Элементы.ТипОбмена.ЦветТекста = WebЦвета.Зеленый;
		ТипОбменаПредставление = НСтр("be = 'Інтэрнэт'; en = 'Online'; es = 'En línea'; ka = 'ონლაინ'; kk = 'Онлайн'; ro = 'Online'; ru = 'Онлайн'; tr = 'Çevrimiçi'; uk = 'Онлайн'; uz = 'Onlayn  '");
	ИначеЕсли ТипОбмена = "Автообмен" Тогда
		Элементы.ТипОбмена.ЦветТекста = WebЦвета.Красный;
		ТипОбменаПредставление = НСтр("be = 'Аўтаабмен'; en = 'Auto exchange'; es = 'Intercambio automático'; ka = 'ავტომატური შეცვლა'; kk = 'Автоалмасу  '; ro = 'Schimb automat'; ru = 'Автообмен'; tr = 'Otomatik veri alışverişi'; uk = 'Автообмін'; uz = 'Avto almashish  '");
	ИначеЕсли ТипОбмена = "Интерактивный" Тогда
		Элементы.ТипОбмена.ЦветТекста = WebЦвета.Синий;
		ТипОбменаПредставление = НСтр("be = 'Інтэрактыўны'; en = 'Interactive'; es = 'Interactivo'; ka = 'ინტერაქტიული'; kk = 'Интерактивті'; ro = 'Interactiv'; ru = 'Интерактивный'; tr = 'Etkileşimli'; uk = 'Інтерактивний'; uz = 'Interaktiv'");
	КонецЕсли;
	
	Элементы.ТипОбмена.Заголовок = ТипОбменаПредставление;
			
	Для каждого СтрокаНастройки из НастройкиОтборов Цикл
		Если ЗначениеЗаполнено(СтрокаНастройки.НастройкаКомпоновщикаСтрокой) Тогда
			СтрокаНастройки.Настройка =  НСтр("be = 'Наладжана'; en = 'Configured'; es = 'Configurado'; ka = 'დაკარგულია'; kk = 'Орнатылған'; ro = 'Configurat'; ru = 'Настроено'; tr = 'Ayarlandı'; uk = 'Налаштовано'; uz = 'Sozlandi'");			
		Иначе
			СтрокаНастройки.Настройка =  НСтр("be = 'Наладзіць'; en = 'Configure'; es = 'Configurar'; ka = 'კონფიგურაცია'; kk = 'Орнату'; ro = 'Configurați'; ru = 'Настроить'; tr = 'Ayarla'; uk = 'Налаштувати'; uz = 'Sozlash'");
		КонецЕсли;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		НастройкиОтборов.Сортировать("БизнесПроцессВключен УБЫВ");
		
		Элементы.ИнфоСтрока.Заголовок = НСтр("be = 'Спіс выбараў сфармаваны на аснове бягучых налад бізнес-працэсаў. Калі патрэбны выбар недаступны, праверце, ці ўключаны адпаведны бізнес-працэс.'; en = 'The list of selections is based on the current business process settings. If the required selection is unavailable, check if the corresponding business process is enabled.'; es = 'La lista de selección se ha formado en base a las configuraciones actuales de los procesos de negocio. Si la selección necesaria no está disponible, verifique si el proceso de negocio correspondiente está activado.'; ka = 'გაფილტრვის სია შექმნილია მიმდინარე ბიზნეს-პროცესების მიხედვით. თუ სასაჭირო ფილტრი არ არსებობს, შეამოწმეთ, გადართულია თუ არა შესაბამისი ბიზნეს-პროცესი.'; kk = 'Бизнес-процестердің ағымдағы параметрлері бойынша тізім жасалды. Қажетті таңдау қол жетімді емес болса, қажетті бизнес-процесті қосуыңызды тексеріңіз.'; ro = 'Lista de selecții este formată pe baza setărilor actuale ale proceselor de afaceri. Dacă selecția dorită nu este disponibilă, verificați dacă procesul de afaceri corespunzător este activat.'; ru = 'Список отборов сформирован на основании текущих настроек бизнес-процессов. Если нужный отбор недоступен, проверьте, включен ли соответствующий бизнес-процесс.'; tr = 'Mevcut iş süreçleri ayarlarına dayalı bir seçim listesi oluşturuldu. Gerekli seçenek erişilebilir değilse, ilgili iş sürecinin etkin olup olmadığını kontrol edin.'; uk = 'Список відборів сформований на основі поточних налаштувань бізнес-процесів. Якщо потрібний відбір недоступний, перевірте, чи включений відповідний бізнес-процес.'; uz = 'Жорий бизнес-просесс созламаларига кўра тайёрланган тафсилотлар рўйхати. Керакли тафсилот мавжуд эмаса, мувофиқ бизнес-просессни текширинг.  '");
	#Иначе
		ИнфоСтрока = НСтр("be = 'Спіс выбараў сфармаваны на аснове бягучых налад бізнес-працэсаў. Калі ў спісе няма патрэбнага выбару, праверце, ці ўключаны адпаведны бізнес-працэс.'; en = 'The list of selections is based on the current business process settings. If the required selection is not in the list, check if the corresponding business process is enabled.'; es = 'La lista de selección se ha formado en base a las configuraciones actuales de los procesos de negocio. Si no encuentra la selección necesaria, verifique si el proceso de negocio correspondiente está activado.'; ka = 'გაფილტრვის სია შექმნილია მიმდინარე ბიზნეს-პროცესების მიხედვით. თუ სასაჭირო ფილტრი არ არსებობს, შეამოწმეთ, გადართულია თუ არა შესაბამისი ბიზნეს-პროცესი.'; kk = 'Бизнес-процестердің ағымдағы параметрлері бойынша тізім жасалды. Өтірікті таңдау тізімінде қажетті таңдау жоқ болса, қажетті бизнес-процесті қосуыңызды тексеріңіз.'; ro = 'Lista de selecții este formată pe baza setărilor actuale ale proceselor de afaceri. Dacă nu există selecția dorită în listă, verificați dacă procesul de afaceri corespunzător este activat.'; ru = 'Список отборов сформирован на основании текущих настроек бизнес-процессов. Если в списке нет нужного отбора, проверьте, включен ли соответствующий бизнес-процесс.'; tr = 'Mevcut iş süreçleri ayarlarına dayalı bir seçim listesi oluşturuldu. Gerekli seçenek listede yoksa, ilgili iş sürecinin etkin olup olmadığını kontrol edin.'; uk = 'Список відборів сформований на основі поточних налаштувань бізнес-процесів. Якщо в списку немає потрібного відбору, перевірте, чи включений відповідний бізнес-процес.'; uz = 'Жорий бизнес-просесс созламаларига кўра тайёрланган тафсилотлар рўйхати. Агар керакли тафсилот топилмаса, мувофиқ бизнес-просессни текширинг.  '");
	#КонецЕсли
	НеВыводитьИнфоСтроку = Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщенийФормаСпискаОтборы");
	ОбновитьВидимостьГруппыИнфо();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьИЗакрытьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	СтруктураНастройки = Новый Структура;
	МассивДляСохранения = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицы());
	СтруктураНастройки.Вставить("НастройкиОтборов", МассивДляСохранения);
	СтруктураНастройки.Вставить("ВерсияОбработкиНастроек",	_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиНастроек"));
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастройки, "НастройкаОтборовУзла");
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзФайла(Команда)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВосстановитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("НастройкаОтборовУзла", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт
	
	Если СтруктураНастроек <> Неопределено Тогда
		ЗаполнитьТаблицуЗначениямиНастройки(СтруктураНастроек.НастройкиОтборов);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	УстановитьЗначениеФлагаИспользуется(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьЗначениеФлагаИспользуется(Ложь);	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиПоУмолчанию(Команда)
		
	Если НастройкиОтборов.Количество() Тогда
		ОповещениеПредупреждениеЗавершение = Новый ОписаниеОповещения("ЗагрузитьНастройкиПоУмолчаниюЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("be = 'Бягучыя налады будуць страчаныя! Перазапісаць іх?'; en = 'Current settings will be lost! Overwrite them?'; es = '¡Se perderán los ajustes actuales! ¿Desea sobrescribirlos?'; ka = 'მიმდინარი პარამეტრები დაკარგულია! გსურთ მათი გადაყვანა?'; kk = 'Ағымдағы орнатулар жоқ болады! Оларды қайта жазу керек пе?'; ro = 'Setările curente vor fi pierdute! Doriți să le suprascrieți?'; ru = 'Текущие настройки будут утеряны! Перезаписать их?'; tr = 'Geçerli ayarlar kaybolacak! Üzerine yazmak istiyor musunuz?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Жорий созламалар йўқ бўлади! Уларни ўчиришга рози бўласизми?'");
		ПоказатьВопрос(ОповещениеПредупреждениеЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		ЗагрузитьНастройкиПоУмолчаниюВыполнить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиГлавногоУзла(Команда)

	Если НастройкиОтборов.Количество() Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИзГлавногоУзла", Истина);
		
		ОповещениеПредупреждениеЗавершение = Новый ОписаниеОповещения("ЗагрузитьНастройкиПоУмолчаниюЗавершение", ЭтаФорма, ДополнительныеПараметры);
		ТекстВопроса = НСтр("be = 'Бягучыя налады будуць страчаныя! Перазапісаць іх?'; en = 'Current settings will be lost! Overwrite them?'; es = '¡Se perderán los ajustes actuales! ¿Desea sobrescribirlos?'; ka = 'მიმდინარი პარამეტრები დაკარგულია! გსურთ მათი გადაყვანა?'; kk = 'Ағымдағы орнатулар жоқ болады! Оларды қайта жазу керек пе?'; ro = 'Setările curente vor fi pierdute! Doriți să le suprascrieți?'; ru = 'Текущие настройки будут утеряны! Перезаписать их?'; tr = 'Geçerli ayarlar kaybolacak! Üzerine yazmak istiyor musunuz?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Жорий созламалар йўқ бўлади! Уларни ўчиришга рози бўласизми?'");
		ПоказатьВопрос(ОповещениеПредупреждениеЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		ЗагрузитьНастройкиПоУмолчаниюВыполнить(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтборовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	
	НоваяСтрока = НастройкиОтборов.Добавить();
	НоваяСтрока.Настройка = "Настроить";
	#Если ТолстыйКлиентОбычноеПриложение Тогда
	Элементы.НастройкиОтборов.ТекущаяСтрока = НоваяСтрока;
	#Иначе
	Элементы.НастройкиОтборов.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	#КонецЕсли
