			Сообщение.Поле = "НастройкиОтборов["+Элементы.НастройкиОтборов.ТекущаяСтрока+"].Название";
			Сообщение.Сообщить(); 
			Возврат;
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрокаНастройки.ТипИсходногоДокумента1С) Тогда			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("be = 'У бізнес-працэсе не запоўнены выхадны дакумент 1С'; en = 'The source 1C document is not filled in for the business process'; es = 'El proceso comercial seleccionado ""%1"" no tiene un documento fuente 1C completado'; ka = 'ბიზნეს პროცესს ""%1"" 1C-ის წყაროში არ არის შევსებული დოკუმენტი'; kk = 'Бизнес-процестің бастапқы 1С документі толтырылмаған'; ro = 'Procesul de afaceri nu are documentul sursă 1C completat'; ru = 'У бизнес-процесса не заполнен исходный документ 1С'; tr = 'İş sürecinde 1C kaynak belge eksik'; uk = 'У бізнес-процесі не заповнений вихідний документ 1С'; uz = ""Biznes jarayonida bosh hujjat 1C to'ldirilmagan""");
			Сообщение.Поле = "НастройкиОтборов["+Элементы.НастройкиОтборов.ТекущаяСтрока+"].ТипИсходногоДокумента1С_Синоним";
			Сообщение.Сообщить(); 
			Возврат;				
		КонецЕсли;		
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ОтборДокументов = ПолучитьФорму("ОФ_ФормаНастройки_ОтборДокументов", ЭтаФорма);
		#Иначе
			ФормаНастройки_ОтборДокументов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ОтборДокументов", , ЭтаФорма, ЭтаФорма);
			ФормаНастройки_ОтборДокументов.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		ФормаНастройки_ОтборДокументов.ID_Узла = ID_Узла;
		ФормаНастройки_ОтборДокументов.НаименованиеУзла = НаименованиеУзла;
		ФормаНастройки_ОтборДокументов.ID_БизнесПроцесса = ТекущаяСтрокаНастройки.ID_БизнесПроцесса;
		ФормаНастройки_ОтборДокументов.НаименованиеБП = ТекущаяСтрокаНастройки.Название;
		ФормаНастройки_ОтборДокументов.ТипДокумента1С = ТекущаяСтрокаНастройки.ТипИсходногоДокумента1С;
		ФормаНастройки_ОтборДокументов.Используется = ?(ЭтоНовый,Истина,ТекущаяСтрокаНастройки.Используется);
		ФормаНастройки_ОтборДокументов.ТипОбмена = ТипОбмена;		
		ФормаНастройки_ОтборДокументов.НастройкаКомпоновщикаСтрокой = ТекущаяСтрокаНастройки.НастройкаКомпоновщикаСтрокой;		
		ФормаНастройки_ОтборДокументов.ВариантОтбора = ?(ТекущаяСтрокаНастройки.ВариантОтбора="","Только конструктор",ТекущаяСтрокаНастройки.ВариантОтбора);
		ФормаНастройки_ОтборДокументов.ID_ПроизвольногоОтбора = ТекущаяСтрокаНастройки.ID_ПроизвольногоОтбора;
		ФормаНастройки_ОтборДокументов._ЛокКонтекст = _ЛокКонтекст;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_ОтборДокументовЗакрытие",ЭтаФорма);
		ФормаНастройки_ОтборДокументов.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ОтборДокументов.ОткрытьМодально();
		#Иначе
			ФормаНастройки_ОтборДокументов.Открыть();
		#КонецЕсли
				
	КонецЕсли;
	
КонецПроцедуры

