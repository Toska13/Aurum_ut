&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТаблицаКолонок.Очистить();
	
	СписокПредставленийПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента();
	
	СохраненныеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ФормаОбменаВыбранныеКолонки",истина);	

	Если СохраненныеНастройки <> Ложь И СохраненныеНастройки <> Неопределено Тогда
		Для Каждого Строка Из СохраненныеНастройки Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НС = ТаблицаКолонок.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Строка);
		КонецЦикла;
	Иначе		
		Для Каждого Строка Из СписокПредставленийПоУмолчанию Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НС = ТаблицаКолонок.Добавить();
			НС.Использование 	= Ложь;
			НС.Представление 	= Строка.Представление;
			НС.Название 		= Строка.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаКолонок.НайтиСтроки(Новый Структура("Название","Ссылка")).Количество() = 0 Тогда
		нКолонка = ТаблицаКолонок.Добавить();	
		нКолонка.Название = "Ссылка";
		нКолонка.Представление = НСтр("be = 'Спасылка'; en = 'Link'; es = 'Enlace'; ka = 'ბმული'; kk = 'Сілтеме'; ro = 'Legătură'; ru = 'Ссылка'; tr = 'Bağlantı'; uk = 'Посилання  '; uz = 'Havola'");
		нКолонка.Использование = Истина;		
	КонецЕсли;
	
	ОбновитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок()
	
	// Пробежимся по всем БП и сделаем список всех настроенных колонок вывода
	ВсеРеквизитыНастроенныеВБП = Новый СписокЗначений;
	
	Для Каждого СтрокаБП Из _ЛокКонтекст.ТекущиеНастройкиMS.НастройкиБизнесПроцессов Цикл
		Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		//  Старый алгоритм
		//ТаблицаНастроекПредставлений = СтрокаБП.НастройкаПредставленийРеквизитовДокумента;
		//Если ТаблицаНастроекПредставлений <> Неопределено 
		//	И ТаблицаНастроекПредставлений <> Ложь
		//	И ТаблицаНастроекПредставлений.Количество() > 1 Тогда
		//	Для Каждого СтрокаНастройки Из ТаблицаНастроекПредставлений Цикл
		//		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
		//			Продолжить;
		//		КонецЕсли;
		//		Если СтрокаНастройки.Использование = Истина 
		//			И ВсеРеквизитыНастроенныеВБП.НайтиПоЗначению(СтрокаНастройки.ПредставлениеРеквизита) = Неопределено Тогда
		//			ВсеРеквизитыНастроенныеВБП.Добавить(СтрокаНастройки.ПредставлениеРеквизита,СтрокаНастройки.ПредставлениеРеквизита);					
		//		КонецЕсли;
		//	КонецЦикла;
		//КонецЕсли;
		//
		
		НастройкиШапки = СтрокаБП.НастройкаВыгрузкиПолей;
		Если НастройкиШапки = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаШапки Из НастройкиШапки Цикл
			Если СтрокаШапки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаШапки.Выгружать = Истина 
				И СтрокаШапки.ТипИсточника = "Реквизит1С" 
				И СтрокаШапки.Свойство("КолонкаВывода") 
				И ЗначениеЗаполнено(СтрокаШапки.КолонкаВывода) 
				И ВсеРеквизитыНастроенныеВБП.НайтиПоЗначению(СтрокаШапки.КолонкаВывода) = Неопределено Тогда
					ВсеРеквизитыНастроенныеВБП.Добавить(СтрокаШапки.КолонкаВывода,СтрокаШапки.КолонкаВывода);
				
			КонецЕсли;			 

		КонецЦикла;
		
	КонецЦикла;	
	
	// Проверим текущий список, если каких-то колонок нет в настройках, то удаляем из списка
	МассивСтрокКУдалению = Новый Массив;
	Для Каждого СтрокаНастройки Из ТаблицаКолонок Цикл
		Если СписокПредставленийПоУмолчанию.НайтиПоЗначению(СтрокаНастройки.Название)  = Неопределено
			И  ВсеРеквизитыНастроенныеВБП.НайтиПоЗначению(СтрокаНастройки.Название)  =  Неопределено Тогда
			МассивСтрокКУдалению.Добавить(СтрокаНастройки);
		КонецЕсли;
	КонецЦикла;
	Если МассивСтрокКУдалению.Количество() > 0 Тогда
		Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
			ТаблицаКолонок.Удалить(СтрокаКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	// Добавим в таблицу реквизиты из БП, которых еще нет в списке
	КолонкиВСписке = Новый Массив;
	Для каждого Строка Из ТаблицаКолонок Цикл
		КолонкиВСписке.Добавить(Строка.Название);	
	КонецЦикла;

	Для Каждого Настройка Из ВсеРеквизитыНастроенныеВБП Цикл
		Если КолонкиВСписке.Найти(Настройка.Значение) = Неопределено Тогда	
			НС = ТаблицаКолонок.Добавить();
			НС.Использование = Ложь;
			НС.Представление = Настройка.Представление;
			НС.Название 		 = Настройка.Значение;
			
			КолонкиВСписке.Добавить(Настройка.Значение);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ВключенныеКолонки = ТаблицаКолонок.НайтиСтроки(Новый Структура("Название,Использование","Ссылка",Истина));
	
	//Защита от дурака. Если выключили все галочки, то оставим хотя бы одну с названием документа
	Если ВключенныеКолонки.Количество() = 0 Тогда
		СтрокаНазвание  =  ТаблицаКолонок.НайтиСтроки(Новый Структура("Название","Ссылка"));
		СтрокаНазвание[0].Использование = Истина;
	КонецЕсли;
	
	ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	МассивСтруктур = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПоместитьТЧВоВременноеХранилище("ТаблицаКолонок"));
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонки", МассивСтруктур, ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонки",МассивСтруктур);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Истина);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(Истина);
КонецПроцедуры

&НаСервере
Функция ПоместитьТЧВоВременноеХранилище(ИмяТЧ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		#Область НесовместимыйКодFresh
		ТЧ = Вычислить(ИмяТЧ);
		#КонецОбласти //НесовместимыйКодFresh
	#Иначе
		ТЧ = РеквизитФормыВЗначение(ИмяТЧ);
	#КонецЕсли
	
	Возврат ПоместитьВоВременноеХранилище(ТЧ,Новый УникальныйИдентификатор());

КонецФункции

&НаКлиенте
Процедура ТаблицаКолонокИспользованиеПриИзменении(Элемент)
	Если Элементы.ТаблицаКолонок.ТекущиеДанные <> Неопределено
		И Элементы.ТаблицаКолонок.ТекущиеДанные.Название = "Ссылка" Тогда
		Элементы.ТаблицаКолонок.ТекущиеДанные.Использование = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьВсе(Команда)
	
	УстановкаСнятиеВсехФлажков(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановкаСнятиеВсехФлажков(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаСнятиеВсехФлажков(ЗначениеФлага)
	
	Для Каждого Строка Из ТаблицаКолонок Цикл		
		Если Строка.Использование = ЗначениеФлага Тогда
			Продолжить;	
		КонецЕсли;
		Строка.Использование = ЗначениеФлага;		
	КонецЦикла;
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли