#Область ОписаниеПеременных 

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем РезультатРедактирования;
	
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии()
	
	#Область СовместимыйКодFresh
	//Сообщить("В базе, размещенной во fresh, запрещено создание произвольных запросов");
	//Возврат;
	#КонецОбласти //СовместимыйКодFresh
	
	Если ЭтоНоваяНастройка Тогда
		ID_ПроизвольногоОтбора = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("CF");
		Наименование = "НОВЫЙ ПРОИЗВОЛЬНЫЙ ОТБОР ДОКУМЕНТОВ";
		ЕстьИзмененияНаФорме = Истина;
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(ТекстПроизвольногоОтбора);
		#Иначе
			ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(ТекстПроизвольногоОтбора);
		#КонецЕсли
		ЕстьИзмененияНаФорме = Ложь;
	КонецЕсли;	
	
	УстановитьПодсказкуПроизвольногоОтбора();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПодсказкуПроизвольногоОтбора()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Подсказка = Элементы.Подсказка;	
	#КонецЕсли
	
	ТекстПодсказки = 
		"Результат - возвращаемый результат типа ""Запрос""
		|
		|ТекстЗапроса = """";
		|Результат = Новый Запрос(ТекстЗапроса);	
		|
		|Запрос должен возвращать одно обязательное поле ""Ссылка"", тип ""ДокументСсылка"". 
		|
		|Опционально: ""Дата"", ""Номер"", ""Контрагент"", ""Склад"", ""Помещение"", ""ВидОперации"", ""Количество"", ""СуммаДокумента"", тип может быть любой.
		|Все эти поля (кроме ссылки), используются только для отображения в окне обмена документов.
		|
		|Если в запросе используются параметры, значения этих параметров берутся из одноименных Глобальных параметров.
		|
		|Дополнительно могут быть использованы параметры &ГлубинаОтбора и &ТекущаяДата, значения которых будут заполнены
		|соответственно глубиной отбора, заданной в параметрах компоновщика, и текущей датой.
		|
		|--------------------------------------------------------------------------------
		|Пример:
		|
		|ТекстЗапроса = 
		|	""ВЫБРАТЬ ПЕРВЫЕ 10
		|	|	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка,
		|	|	ПриобретениеТоваровУслуг.Номер КАК Номер,
		|	|	ПриобретениеТоваровУслуг.Дата КАК Дата,
		|	|	ПриобретениеТоваровУслуг.Склад КАК Склад,
		|	|	ПриобретениеТоваровУслуг.Контрагент КАК Контрагент,
		|	|	ПриобретениеТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
		|	|	КОЛИЧЕСТВО(ПриобретениеТоваровУслугТовары.НомерСтроки) КАК Количество,
		|	|	""""Моя операция"""" КАК ВидОперации
		|	|ИЗ
		|	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
		|	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		|	|		ПО (ПриобретениеТоваровУслугТовары.Ссылка = ПриобретениеТоваровУслуг.Ссылка)
		|	|ГДЕ
		|	|	&ХозяйственнаяОперация В (ПриобретениеТоваровУслуг.ХозяйственнаяОперация, НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка))
		|	|	И НАЧАЛОПЕРИОДА(ПриобретениеТоваровУслуг.Дата, ДЕНЬ) >= ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), ДЕНЬ, -&ГлубинаОтбора)
		|	|
		|	|СГРУППИРОВАТЬ ПО
		|	|	ПриобретениеТоваровУслуг.Ссылка,
		|	|	ПриобретениеТоваровУслуг.Номер,
		|	|	ПриобретениеТоваровУслуг.Дата,
		|	|	ПриобретениеТоваровУслуг.Склад,
		|	|	ПриобретениеТоваровУслуг.Контрагент,
		|	|	ПриобретениеТоваровУслуг.СуммаДокумента
		|	|
		|	|УПОРЯДОЧИТЬ ПО
		|	|	Дата УБЫВ"";
		|
		|Результат = Новый Запрос(ТекстЗапроса);
		|";
	
	Подсказка.УстановитьТекст(ТекстПодсказки);	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройку()
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("ID_ПроизвольногоОтбора", 	ID_ПроизвольногоОтбора);
	СтруктураНастройки.Вставить("Наименование",           	Наименование);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СтруктураНастройки.Вставить("ТекстПроизвольногоОтбора", СокрЛП(Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст()));
	#Иначе
		СтруктураНастройки.Вставить("ТекстПроизвольногоОтбора", СокрЛП(ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст()));
	#КонецЕсли
	СтруктураНастройки.Вставить("Описание",               	Описание);
	
	Отбор = Новый Структура("ID_ПроизвольногоОтбора", ID_ПроизвольногоОтбора);
	_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("ПроизвольныеОтборыДокументов", Отбор, СтруктураНастройки);
	
	РезультатРедактирования = ID_ПроизвольногоОтбора;
	ЕстьИзмененияНаФорме = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы_ОсновныеДействия

&НаКлиенте
Процедура ОсновныеДействияСохранить(Кнопка)
	СохранитьНастройку();
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеДействияСохранитьИЗакрыть(Кнопка)
	
	СохранитьНастройку();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,РезультатРедактирования);
		КонецЕсли;
	#КонецЕсли
	Закрыть(РезультатРедактирования);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы_КоманднаяПанельПроизвольногоОтбора

&НаКлиенте
Процедура КоманднаяПанельПроизвольногоОтбораЗакомментировать(Кнопка)
	
	Перем в1,в2,в3,в4;		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьГраницыВыделения(в1,в2,в3,в4);
	#Иначе
		Элементы.ТекстПроизвольногоОтбора.ПолучитьГраницыВыделения(в1,в2,в3,в4);
	#КонецЕсли
	ТекстДок = Новый ТекстовыйДокумент;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекстДок.УстановитьТекст(Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());
	#Иначе
		ТекстДок.УстановитьТекст(ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());
	#КонецЕсли

	сч = в1;
	Пока сч <= в3 Цикл		
		ТекстСтроки = ТекстДок.ПолучитьСтроку(сч);
		ТекстДок.ЗаменитьСтроку(сч,"//"+ТекстСтроки);		
		сч = сч + 1;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(ТекстДок.ПолучитьТекст());
	#Иначе	
		ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(ТекстДок.ПолучитьТекст());	
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельПроизвольногоОтбораСнятьКомментарий(Кнопка)
	
	Перем в1,в2,в3,в4;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьГраницыВыделения(в1,в2,в3,в4);
	#Иначе
		Элементы.ТекстПроизвольногоОтбора.ПолучитьГраницыВыделения(в1,в2,в3,в4);
	#КонецЕсли
	
	ТекстДок = Новый ТекстовыйДокумент;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекстДок.УстановитьТекст(Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());
	#Иначе	
		ТекстДок.УстановитьТекст(ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());	
	#КонецЕсли                                                                                	
	
	сч = в1;
	Пока сч <= в3 Цикл
		ТекстСтроки = ТекстДок.ПолучитьСтроку(сч);
		 Если Лев(СокрЛП(ТекстСтроки), 2) = "//" Тогда
			ТекстСтроки = Прав(ТекстСтроки,СтрДлина(ТекстСтроки)-2);
			ТекстДок.ЗаменитьСтроку(сч,ТекстСтроки);		
		КонецЕсли;
		сч = сч + 1;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(ТекстДок.ПолучитьТекст());
	#Иначе	
		ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(ТекстДок.ПолучитьТекст());	
	#КонецЕсли 
	
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельПроизвольногоОтбораПроверка(Кнопка)
	
	Сообщить(КоманднаяПанельПроизвольногоОтбораПроверкаСервер()); 
	
КонецПроцедуры

Функция КоманднаяПанельПроизвольногоОтбораПроверкаСервер()
	Попытка
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			#Область НесовместимыйКодFresh
			Выполнить(Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());
			#КонецОбласти //НесовместимыйКодFresh
		#Иначе	
			#Область НесовместимыйКодFresh
			Выполнить(ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());
			#КонецОбласти //НесовместимыйКодFresh
			#Область СовместимыйКодFresh	
			//ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст());
			#КонецОбласти //СовместимыйКодFresh
		#КонецЕсли
		
		Результат = НСтр("be = 'Памылак не знойдзена!'; en = 'No errors found!'; es = '¡No se encontraron errores!'; ka = 'შეცდომები არ მოიძებნა!'; kk = 'Қателер табылмады!'; ro = 'Nu s-au găsit erori!'; ru = 'Ошибок не найдено!'; tr = 'Hata bulunamadı!'; uk = 'Помилок не знайдено!'; uz = 'Хатолик топилмади!'");		
	Исключение
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура КонструкторЗапроса(Команда)
	
	#Область НесовместимыйКодFresh
	Конструктор = Новый КонструкторЗапроса;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ВыделенныйТекст = СтрЗаменить(Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ВыделенныйТекст,Символы.ПС+"|",Символы.ПС);
	#Иначе
		ВыделенныйТекст = СтрЗаменить(Элементы.ТекстПроизвольногоОтбора.ВыделенныйТекст,Символы.ПС+"|",Символы.ПС);
	#КонецЕсли
	ВыделенныйТекст = ?(Лев(ВыделенныйТекст,1)="""",Прав(ВыделенныйТекст,СтрДлина(ВыделенныйТекст)-1),ВыделенныйТекст);
	ВыделенныйТекст = ?(Прав(ВыделенныйТекст,1)="""",Лев(ВыделенныйТекст,СтрДлина(ВыделенныйТекст)-1),ВыделенныйТекст);
	Если ЗначениеЗаполнено(СокрЛП(ВыделенныйТекст)) Тогда
		Конструктор.Текст = ВыделенныйТекст;
	КонецЕсли;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ДопПараметры = Новый Структура("ВыделенныйТекст",Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ВыделенныйТекст);
	#Иначе
		ДопПараметры = Новый Структура("ВыделенныйТекст",Элементы.ТекстПроизвольногоОтбора.ВыделенныйТекст);
	#КонецЕсли
	Оповещение = Новый ОписаниеОповещения("ОткрытьКонструкторЗапросаЗавершение", ЭтаФорма,ДопПараметры);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Рез = Конструктор.ОткрытьМодально();
		Если Рез = Истина Тогда
			ВыполнитьОбработкуОповещения(Оповещение,Конструктор.Текст);
		КонецЕсли;
	#Иначе
		Конструктор.Показать(Оповещение);
	#КонецЕсли
	#КонецОбласти //НесовместимыйКодFresh
	
КонецПроцедуры

&НаКлиенте 
Процедура ОткрытьКонструкторЗапросаЗавершение(Текст, ДополнительныеПараметры) Экспорт 
	Если НЕ Текст = Неопределено Тогда 
		ТекстЗапроса = """"+СтрЗаменить(Текст,Символы.ПС,Символы.ПС+"|")+"""";
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ТекстПроизвольногоОтбора = Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст();
			Поз = Найти(ТекстПроизвольногоОтбора,ДополнительныеПараметры.ВыделенныйТекст);
			Элементы.ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(Лев(ТекстПроизвольногоОтбора,Поз-1)+ТекстЗапроса+Прав(ТекстПроизвольногоОтбора,СтрДлина(ТекстПроизвольногоОтбора)-СтрДлина(ДополнительныеПараметры.ВыделенныйТекст)-Поз+1));
		#Иначе
			ТекстПроизвольногоОтбора = ПолеРедактированияТекстаПроизвольногоОтбора.ПолучитьТекст();
			Поз = Найти(ТекстПроизвольногоОтбора,ДополнительныеПараметры.ВыделенныйТекст);
			ПолеРедактированияТекстаПроизвольногоОтбора.УстановитьТекст(Лев(ТекстПроизвольногоОтбора,Поз-1)+ТекстЗапроса+Прав(ТекстПроизвольногоОтбора,СтрДлина(ТекстПроизвольногоОтбора)-СтрДлина(ДополнительныеПараметры.ВыделенныйТекст)-Поз+1));
		#КонецЕсли
		
		КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли