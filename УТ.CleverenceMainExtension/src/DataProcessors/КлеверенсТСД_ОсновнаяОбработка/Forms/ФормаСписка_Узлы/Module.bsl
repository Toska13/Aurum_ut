&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьТаблицуУзлов();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("НастройкиУзлов", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт

	Если СтруктураНастроек <> Неопределено Тогда
		
		//Выполним обновление - Начало
		ВерсияОбработки =_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");		
		Если СтруктураНастроек.Свойство("ВерсияОбработкиНастроек") Тогда
			ВерсияОбработкиНастроек = СтруктураНастроек.ВерсияОбработкиНастроек;
		Иначе
			ВерсияОбработкиНастроек = 0;		
		КонецЕсли;  
		Если ВерсияОбработки>ВерсияОбработкиНастроек Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ВерсияНастроек,СтруктураНастроек",ВерсияОбработкиНастроек,СтруктураНастроек));
			
			СтруктураНастроек = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,_ЛокКонтекст.АдресаПеременных);
		КонецЕсли;
		//Выполним обновление - Конец
		
		ТаблицаУзлов.Очистить();
		ВсеУзлы = СтруктураНастроек.ТаблицаУзлов;
		Если НЕ ВсеУзлы = Ложь Тогда 
			Для Каждого СтрокаУзла Из ВсеУзлы Цикл
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(ТаблицаУзлов.Добавить(), СтрокаУзла);
			КонецЦикла;
		КонецЕсли;
		ТаблицаДляСохранения = ПолучитьСтруктуруУзловДляСохранения();
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("Узлы", ТаблицаДляСохранения);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", ТаблицаДляСохранения);	
		ВыгрузитьУзлы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ТаблицаУзлов", ПолучитьСтруктуруУзловДляСохранения());
	СтруктураНастроек.Вставить("ВерсияОбработкиНастроек",_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиНастроек"));
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастроек, "НастройкиУзлов");
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУзловПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ОткрытьФормуРедактированияУзла(Истина);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУзловПередНачаломИзменения(Элемент, Отказ)
	ОткрытьФормуРедактированияУзла(Ложь);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьУзлы(Команда = Неопределено)	Экспорт	
	
	ОП = Новый ОписаниеОповещения("ВыгрузитьУзлыПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,,,,,ОП);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУзловПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока	 = Элемент.ТекущиеДанные;
	ID_УзлаУдаляемый = ТекущаяСтрока.ID_Узла;
	
	// Очищаем настройки
	СтруктураНастроек = Новый Структура;
	Для Каждого КлючНастройки Из _ЛокКонтекст.КатегорииНастроекMS.УзловыеНастройки Цикл
		СтруктураНастроек.Вставить(КлючНастройки, Неопределено);
	КонецЦикла;
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастроек, ID_УзлаУдаляемый);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);
	
	// Удаляем строку
	ТаблицаУзлов.Удалить(ТекущаяСтрока);
	ТаблицаДляСохранения = ПолучитьСтруктуруУзловДляСохранения();
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("Узлы", ТаблицаДляСохранения);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", ТаблицаДляСохранения);	
	
	// Удаляем бизнес-процессы узла
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов");
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
	
	// Устанавливаем новое значение текущего узла / восстанавливаем настройки предыдущего
	ID_ТекущегоУзла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	Если ID_ТекущегоУзла = ID_УзлаУдаляемый Тогда
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла("");		
	Иначе
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_ТекущегоУзла);		
	КонецЕсли;
	
	ВыгрузитьУзлы();
	
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы


// Открывает форму редактирования узла
// 
// Параметры:
// 	НовыйУзел - Булево - Признак создания нового узла
&НаКлиенте
Процедура ОткрытьФормуРедактированияУзла(НовыйУзел)
	
	ТекущаяСтрока = ?(НовыйУзел, Неопределено, Элементы.ТаблицаУзлов.ТекущиеДанные);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_Узел = ПолучитьФорму("ОФ_ФормаНастройки_Узел", ЭтаФорма, ?(ТекущаяСтрока = Неопределено, Новый УникальныйИдентификатор, ТекущаяСтрока.ID_Узла));
	#Иначе
		ФормаНастройки_Узел = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_Узел",, ЭтаФорма, ?(ТекущаяСтрока = Неопределено, УникальныйИдентификатор, ТекущаяСтрока.ID_Узла));
	#КонецЕсли
	
	ФормаНастройки_Узел.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаНастройки_Узел._ЛокКонтекст = _ЛокКонтекст;	
	Если НовыйУзел Тогда
		ФормаНастройки_Узел.ЭтоНовыйУзел = НовыйУзел;         
		// Задаем по-умолчанию наименование нового узла
		НомерУзлаПоУмолчанию = 1;		
		Пока (Истина) Цикл
			ИмяНовогоУзла = НСтр("be = ""Торговы аб'ект №""; en = 'Trading object #'; es = 'Objeto comercial n.º'; ka = 'სავაჭრო ობიექტი №'; kk = 'Торговый объект №'; ro = 'Obiect comercial nr'; ru = 'Торговый объект №'; tr = 'Ticari nesne no'; uk = ""Торговий об'єкт №""; uz = ""Savdo ob'ekti №""");
			ИмяНовогоУзла = ИмяНовогоУзла + НомерУзлаПоУмолчанию;
			Если Не ТаблицаУзлов.НайтиСтроки(Новый Структура("Наименование", ИмяНовогоУзла)).Количество() Тогда
				Прервать;
			КонецЕсли;   
			НомерУзлаПоУмолчанию = НомерУзлаПоУмолчанию + 1;
		КонецЦикла;      	
		ФормаНастройки_Узел.Наименование = ИмяНовогоУзла;
	Иначе
		ЗаполнитьЗначенияСвойств(ФормаНастройки_Узел, ТекущаяСтрока);
	КонецЕсли;
	ОП = Новый ОписаниеОповещения("Настройки_УзелЗакрытие",ЭтаФорма,ТекущаяСтрока);
	ФормаНастройки_Узел.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаНастройки_Узел.Открыть();	
	
КонецПроцедуры


// Перезаполнить таблицу узлов из кэша
// 
// Параметры:
&НаКлиенте
Процедура ОбновитьТаблицуУзлов()
	
	ТаблицаУзлов.Очистить();
	ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив")  Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(ТаблицаУзлов.Добавить(), СтрокаУзла);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


// Формирует структуру узлов с таблицей пользователей
// 
// Параметры:
// 	ДляСохранения - Булево - Признак получения структуры для сохранения 
// Возвращаемое значение:
// 	Массив, Структура - Если установлен флаг "ДляСохранения", то будет возвращена структура, а иначе массив для выгрузки в SMARTS 
&НаКлиенте
Функция ПолучитьСтруктуруУзловДляСохранения()
	
	СтруктураПользователиТСД = Новый Структура();	
	Для каждого Строка Из ТаблицаУзлов Цикл
		ПользователиТСД = Новый Массив;
		ТаблицаПользователейТСД = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПользователиТСД", Строка.ID_Узла);
		Если ТипЗнч(ТаблицаПользователейТСД) = Тип("Массив") Тогда
			Для Каждого СтрокаНастройки Из ТаблицаПользователейТСД Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ПользователиТСД.Добавить(Новый Структура("Наименование,ID_Пользователя",СтрокаНастройки.Наименование,СтрокаНастройки.ID_Пользователя));
			КонецЦикла;			
		КонецЕсли;		
		СтруктураПользователиТСД.Вставить("Узел_"+Строка.ID_Узла,ПользователиТСД);
		
	КонецЦикла;
	
	СтруктураДляВыгрузки = Новый Массив;
	
	Для каждого Строка Из ТаблицаУзлов Цикл
	
		НоваяСтрока = Новый Структура;
		
		НоваяСтрока.Вставить("ID_Узла"					, Строка.ID_Узла);
		НоваяСтрока.Вставить("ИспользоватьЧастнуюБазу"	, Строка.ИспользоватьЧастнуюБазу);
		НоваяСтрока.Вставить("ЧастнаяБазаMS"			, Строка.ЧастнаяБазаMS);
		НоваяСтрока.Вставить("Комментарий"				, Строка.Комментарий);
		
		НоваяСтрока.Вставить("Ид"						, Строка.ID_Узла);
		НоваяСтрока.Вставить("Наименование"				, Строка.Наименование);
		НоваяСтрока.Вставить("Код"						, Строка.ID_Узла);
		
		НоваяСтрока.Вставить("ШК"						, "");
		НоваяСтрока.Вставить("ЭтоПапка"					, Ложь);
		НоваяСтрока.Вставить("ИдРодителя"				, "");
		
		НоваяСтрока.Вставить("НаименованиеДляПоиска"	, НРег(Строка.Наименование));
		НоваяСтрока.Вставить("РасположениеКомпонентыЧБ"	, Строка.РасположениеКомпонентыЧБ);
		НоваяСтрока.Вставить("РежимВыбораБазыЧБ"		, Строка.РежимВыбораБазыЧБ);
		НоваяСтрока.Вставить("ТипИнтерфейсаЧБ"			, Строка.ТипИнтерфейсаЧБ);

		ПользователиУзла = СтруктураПользователиТСД["Узел_" + Строка.ID_Узла];
		СтрокаПользователейИГрупп = "";
		Если ТипЗнч(ПользователиУзла) = Тип("Массив") Тогда
			Для каждого Пользователь Из ПользователиУзла Цикл							
				СимволВНачалеСтроки = ?(СтрокаПользователейИГрупп = "", "", ",");
				СтрокаПользователейИГрупп = СтрокаПользователейИГрупп + СимволВНачалеСтроки + """" + СокрЛП(Пользователь.ID_Пользователя) + """";			
			КонецЦикла;
		КонецЕсли;
		
		НоваяСтрока.Вставить("Владелец"					, СтрокаПользователейИГрупп);
		
		СтруктураДляВыгрузки.Добавить(НоваяСтрока);	
		
	КонецЦикла;
	
	Возврат СтруктураДляВыгрузки;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруУзловДляВыгрузки()
	
	ТаблицыMS = _ЛокКонтекст.СтруктураМетаданных.Tables;
	Если _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "Узлы") <> Неопределено Тогда
		ИмяТаблицыУзлы = "Узлы";
	Иначе
		ИмяТаблицыУзлы = "Nodes";		
	КонецЕсли;
	
	ВерсияВыгрузки_6_0 = Истина; // Всегда выгружаем таблицу в новом формате
	
	СтруктураПользователиТСД = Новый Структура();	
	Для каждого Строка Из ТаблицаУзлов Цикл
		ПользователиТСД = Новый Массив;
		ТаблицаПользователейТСД = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПользователиТСД", Строка.ID_Узла);
		Если ТипЗнч(ТаблицаПользователейТСД) = Тип("Массив") Тогда
			Для Каждого СтрокаНастройки Из ТаблицаПользователейТСД Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ПользователиТСД.Добавить(Новый Структура("Наименование, ID_Пользователя", СтрокаНастройки.Наименование, СтрокаНастройки.ID_Пользователя));
			КонецЦикла;			
		КонецЕсли;
		
		// Если необходимо выгрузить узел всем пользователям, оставляем поле пустым, т.к. в Клеверенс
		//	владелец проверяется на равенство либо ID пользователя, либо ID группы, либо на пустое значение
		Если НЕ _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ПользователиТСД, "ID_Пользователя", "Выгружать всем", Истина) = Неопределено Тогда
			ПользователиТСД.Очистить();		
		КонецЕсли;
		
		// Если пользователи узла не заданы, выгружаем в качестве владельца пустое значение
		Если НЕ ПользователиТСД.Количество() И ВерсияВыгрузки_6_0 Тогда
			ПользователиТСД.Добавить(Новый Структура("Наименование, ID_Пользователя", "", ""));
		КонецЕсли;		
		
		СтруктураПользователиТСД.Вставить("Узел_" + Строка.ID_Узла, ПользователиТСД);
	КонецЦикла;
	
	СтруктураДляВыгрузки = Новый Структура;
	
	Для каждого Строка Из ТаблицаУзлов Цикл
	
		ПользователиУзла = СтруктураПользователиТСД["Узел_" + Строка.ID_Узла];
		
		Если НЕ ВерсияВыгрузки_6_0 Тогда
			СтрокаПользователейИГрупп = "";
			Для каждого Пользователь Из ПользователиУзла Цикл
				СимволВНачалеСтроки = ?(СтрокаПользователейИГрупп = "", "", ",");
				СтрокаПользователейИГрупп = СтрокаПользователейИГрупп + СимволВНачалеСтроки + """" + СокрЛП(Пользователь.ID_Пользователя) + """";
			КонецЦикла;
			
			ПользователиУзла = Новый Массив;
			ПользователиУзла.Добавить(Новый Структура("Наименование, ID_Пользователя", "", СтрокаПользователейИГрупп));
		КонецЕсли;
		
		Для каждого Пользователь Из ПользователиУзла Цикл
			
			ПостфиксВладелец = ?(ПустаяСтрока(Пользователь.ID_Пользователя) ИЛИ НЕ ВерсияВыгрузки_6_0, "", 
				"_" + СтрЗаменить(СтрЗаменить(Пользователь.ID_Пользователя, "-", "_"), " ", "_"));
			
			НоваяСтрока = Новый Структура;
		
		    Если ИмяТаблицыУзлы = "Узлы" Тогда
				НоваяСтрока.Вставить("Ид"					, Строка.ID_Узла);
				НоваяСтрока.Вставить("Наименование"			, Строка.Наименование);
				НоваяСтрока.Вставить("Код"					, Строка.ID_Узла);
				
				НоваяСтрока.Вставить("ШК"					, "");
				НоваяСтрока.Вставить("ЭтоПапка"				, Ложь);
				НоваяСтрока.Вставить("ИдРодителя"			, "");
				НоваяСтрока.Вставить("НаименованиеДляПоиска", НРег(Строка.Наименование));
				НоваяСтрока.Вставить("Владелец"				, Пользователь.ID_Пользователя);
				
				СтруктураДляВыгрузки.Вставить("Узел_" + Строка(НоваяСтрока.Ид) + ПостфиксВладелец, НоваяСтрока);
			Иначе
				НоваяСтрока.Вставить("Id"					, Строка.ID_Узла);
				НоваяСтрока.Вставить("Name"					, Строка.Наименование);
				НоваяСтрока.Вставить("Code"					, Строка.ID_Узла);
				
				НоваяСтрока.Вставить("Barcode"				, "");
				НоваяСтрока.Вставить("IsFolder"				, Ложь);
				НоваяСтрока.Вставить("ParentId"				, "");
				НоваяСтрока.Вставить("Search"				, НРег(Строка.Наименование));
				НоваяСтрока.Вставить("Owners"				, Пользователь.ID_Пользователя);
				
				СтруктураДляВыгрузки.Вставить("Узел_" + Строка(НоваяСтрока.Id) + ПостфиксВладелец, НоваяСтрока);
			КонецЕсли;
			
		КонецЦикла; // Для каждого Пользователь Из ПользователиУзла
		
	КонецЦикла;
	
	Возврат СтруктураДляВыгрузки;
	
КонецФункции

// Получает идентификаторы подключенных баз SMARTS
// 
// Параметры:
// Возвращаемое значение:
// 	Массив - Массив идентификаторов
&НаКлиенте
Функция ПолучитьМассивIDБазMS()
	
	Перем МассивIDБазMS;
	Перем Узел;
	Перем IDБазыMS;
	
	МассивIDБазMS = Новый Массив;
	
	Для каждого Узел Из ТаблицаУзлов Цикл
		Если Узел.ИспользоватьЧастнуюБазу Тогда
			IDБазыMS = СокрЛП(Узел.ЧастнаяБазаMS);
			Если IDБазыMS <> "" И МассивIDБазMS.Найти(IDБазыMS) = Неопределено Тогда
				МассивIDБазMS.Добавить(Узел.ID_Узла);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат МассивIDБазMS;
	
КонецФункции
#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура Настройки_УзелЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		ЭтоНовыйТО = Ложь;
		
		Отбор = Новый Структура("ID_Узла", РезультатРедактирования.ID_Узла);
		Строки = ТаблицаУзлов.НайтиСтроки(Отбор);
		Если Строки.Количество() > 0 Тогда
			НоваяСтрока = Строки[0];
		Иначе
			НоваяСтрока = ТаблицаУзлов.Добавить();
			
			ЭтоНовыйТО = Истина;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,РезультатРедактирования);	
		
		_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("Узлы", Отбор, РезультатРедактирования,,Истина);		
		ТаблицаДляСохранения = ПолучитьСтруктуруУзловДляСохранения();
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", ТаблицаДляСохранения);
		ОбновитьТаблицуУзлов();
		ВыгрузитьУзлы();
		
		Если ЭтоНовыйТО Тогда
			НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов");
			_ЛокКонтекст.ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
			_ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	 
	СохранитьВФайл("");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьУзлыПослеПодключения(СерверДоступен,ДопПараметры) Экспорт	
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("be = 'У гэты момант сервер Cleverence недаступны для захавання налад'; en = 'Currently, the Cleverence server is unavailable for saving settings.'; es = 'En este momento el servidor de Cleverence no está disponible para guardar las configuraciones'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შენახვისთვის.'; kk = 'В данный момент сервер Cleverence недоступен для сохранения настроек - Ағымдағы Cleverence сервері параметрлерді сақтау үшін қол жетімді емес'; ro = 'În acest moment, serverul Cleverence nu este disponibil pentru salvarea setărilor'; ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.'; tr = 'Şu anda Cleverence sunucusu ayarların kaydedilmesi için kullanılamıyor.'; uk = 'У данний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirgi paytda Cleverence serveri sozlamalarni saqlash uchun mavjud emas.'")
						+ Символы.ПС
						+ НСтр("be = 'Захаваць налады ў файл?'; en = 'Save settings to file?'; es = '¿Guardar ajustes en archivo?'; ka = 'პარამეტრების შენახვა ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările în fișier?'; ru = 'Сохранить настройки в файл?'; tr = 'Ayarları dosyaya kaydetmek istiyor musunuz?'; uk = 'Зберегти налаштування в файл?'; uz = 'Созламаларни файлга сақлаш керакми?  '");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	ТаблицыMS = _ЛокКонтекст.СтруктураМетаданных.Tables;
	Если _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "Узлы") <> Неопределено Тогда
		ИмяТаблицыУзлы = "Узлы";
	Иначе
		ИмяТаблицыУзлы = "Nodes";		
	КонецЕсли;
	
	СтруктураДляВыгрузки = ПолучитьСтруктуруУзловДляВыгрузки();
	
	МассивIDБазMS = ПолучитьМассивIDБазMS(); //На самом деле получаем Ид частных баз
	
	ID_ТекущегоУзлаПредыдущееЗначение = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыУзлы, СтруктураДляВыгрузки); // Выгружаем таблицу узлов в основную базу
		
	Для каждого ID_Узла Из МассивIDБазMS Цикл // Переключаемся на частную базу в цикле и выгружаем таблицу узлов в каждую
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_Узла); 
		_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыУзлы, СтруктураДляВыгрузки, "Частная");	
	КонецЦикла;
	
	Если ID_ТекущегоУзлаПредыдущееЗначение <> _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_ТекущегоУзлаПредыдущееЗначение); // возвращаем узел, который был установлен ранее
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли

