	ИначеЕсли КлючНастройки = "Выгрузка_ПослеОбъединенияСтрокиТЧ" Тогда
		Направление = "Выгрузка";
		ТипОбъекта = "ПослеОбъединенияСтрокиТЧ";
		УточнениеЗаголовка = НСтр("be = ""Раздзел: Пасля аб'яднання радка Таблічная частка""; en = 'Section: After merging the row of the Table Part'; es = 'Sección: Después de combinar la fila de la Parte de la tabla'; ka = 'თარგმანი: შემცვლელი: ცხრილის სტრიქოს შეერთების შემდეგ'; kk = 'Бөлім: Кестелік бөлімдің жолын біріктіруден кейін  '; ro = 'Secțiune: După unirea rândului Părții tabelei'; ru = 'Раздел: После объединения строки ТЧ'; tr = 'Bölüm: Satır Tablo Kısmının Birleştirilmesinden Sonra'; uk = ""Розділ: Після об'єднання рядка Таблична часть""; uz = ""Bo'lim: Qator jadvallar qismi birlashtirilgandan keyin  """);
	ИначеЕсли КлючНастройки = "Настройка_ПечатьЭтикеток" Тогда
		Направление = "Настройка";
		ТипОбъекта = "ПечатьЭтикеток";
		УточнениеЗаголовка = НСтр("be = 'Раздзел: Наладка друку этыкетак'; en = 'Section: Label printing setup'; es = 'Sección: Configuración de impresión de etiquetas'; ka = 'რუბრიკა: ეტიკეტების ბეჭდვის პარამეტრები'; kk = 'Бөлім: Этикеттерді басу параметрлерін орнату'; ro = 'Secțiune: Configurare tipărire etichete'; ru = 'Раздел: Настройка печати этикеток'; tr = 'Bölüm: Etiketlerin yazdırılmasını yapılandırma'; uk = 'Розділ: Налаштування друку етикеток'; uz = 'Бўлим: Этикетларни чоп этишни созлаш'");
	ИначеЕсли КлючНастройки = "Настройка_УсловиеВыполненияБизнесПроцесса" Тогда
		Направление = "Настройка";
		ТипОбъекта = "УсловиеВыполненияБизнесПроцесса";
		УточнениеЗаголовка = НСтр("be = 'Раздзел: Умова выканання бізнес працэсу'; en = 'Condition for executing a business process'; es = 'Sección: Condición para ejecutar el proceso de negocios'; ka = 'თარგმანი: შემცვლელი: ბიზნეს პროცესის შესრულების პირობა'; kk = 'Бөлім: Бизнес процесті орындау шарты  '; ro = 'Secțiune: Condiția de îndeplinire a procesului de afaceri'; ru = 'Раздел: Условие выполнения бизнес процесса'; tr = 'Bölüm: İş Sürecinin Gerçekleşme Koşulu'; uk = 'Розділ: Умова виконання бізнес процесу'; uz = ""Bo'lim: Biznes jarayonni bajarish sharti  """);
	КонецЕсли;
	
	Если Не ПустаяСтрока(УточнениеЗаголовка) Тогда
		Заголовок = Заголовок + " (" + УточнениеЗаголовка + ")";	
	КонецЕсли;
	
	Если  ЗначениеЗаполнено(ПравилаОбменаШапка) ИЛИ  ЗначениеЗаполнено(ПравилаОбменаТабличнаяЧасть) 
		ИЛИ КлючНастройки = "Выгрузка_ПослеОбъединенияТЧ" ИЛИ КлючНастройки = "Выгрузка_ПослеОбъединенияСтрокиТЧ" Тогда
		ЗапретитьИзменятьНаправлениеТипОбъекта = Истина;
	КонецЕсли;
	
	ОбновитьТаблицуПроизвольныхКодов();
	
КонецПроцедуры

#КонецОбласти
	
#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("ПроизвольныеКоды_Пользовательские",_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские"));
	СтруктураНастройки.Вставить("ПроизвольныеКоды_ПоУмолчанию",_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию"));
	СтруктураНастройки.Вставить("ВерсияОбработкиНастроек",_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиНастроек"));
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастройки, "ПроизвольныеКоды");
КонецПроцедуры
	
&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("ПроизвольныеКоды", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт

	ПроизвольныеКоды_Пользовательские = Ложь;
	
	Если СтруктураНастроек <> Неопределено Тогда
		
		Если СтруктураНастроек.Свойство("ПроизвольныеКоды_Пользовательские") Тогда
			Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Пользовательские) = Тип("Строка") Тогда
				СтруктураНастроек.ПроизвольныеКоды_Пользовательские = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Пользовательские,Истина);	
			КонецЕсли;	
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("ПроизвольныеКоды_ПоУмолчанию") Тогда
			Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_ПоУмолчанию) = Тип("Строка") Тогда
				СтруктураНастроек.ПроизвольныеКоды_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_ПоУмолчанию,Истина);	
			КонецЕсли;
		КонецЕсли;
		
		//Выполним обновление - Начало
		ВерсияОбработки =_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");		
		Если СтруктураНастроек.Свойство("ВерсияОбработкиНастроек") Тогда
			ВерсияОбработкиНастроек = СтруктураНастроек.ВерсияОбработкиНастроек;
		Иначе
			ВерсияОбработкиНастроек = 0;		
		КонецЕсли;  
		Если ВерсияОбработки>ВерсияОбработкиНастроек Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ВерсияНастроек,СтруктураНастроек",ВерсияОбработкиНастроек,СтруктураНастроек));
			
			СтруктураНастроек = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,_ЛокКонтекст.АдресаПеременных);
		КонецЕсли;
		//Выполним обновление - Конец
		
		Если СтруктураНастроек.Свойство("ПроизвольныеКоды_Пользовательские") Тогда
			ПроизвольныеКоды_Пользовательские = СтруктураНастроек.ПроизвольныеКоды_Пользовательские;
		КонецЕсли;	
		
		Если СтруктураНастроек.Свойство("ПроизвольныеКоды_ПоУмолчанию") Тогда
			ПроизвольныеКоды_ПоУмолчанию = СтруктураНастроек.ПроизвольныеКоды_ПоУмолчанию;
			Если НЕ ПроизвольныеКоды_ПоУмолчанию = Ложь и ЗначениеЗаполнено(ПроизвольныеКоды_ПоУмолчанию) Тогда
				
				Если ПроизвольныеКоды_Пользовательские = Ложь Или Не ЗначениеЗаполнено(ПроизвольныеКоды_Пользовательские) Тогда
					ПроизвольныеКоды_Пользовательские = Новый Массив();
					ПроизвольныеКоды_Пользовательские.Добавить(ПроизвольныеКоды_ПоУмолчанию[0]);
				КонецЕсли;
				
				//Если в базе больше нет такого типового БП то создадим ка пользовательский
				ТекущиеПроизвольныеКоды_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию");
				Для Каждого НовыйПК Из ПроизвольныеКоды_ПоУмолчанию Цикл
					Если НовыйПК.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					Отбор = Новый Структура("ID_ПроизвольногоКода",НовыйПК.ID_ПроизвольногоКода);
					Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ТекущиеПроизвольныеКоды_ПоУмолчанию,Отбор);
					Если Результат = Неопределено Тогда	
						ПроизвольныеКоды_Пользовательские.Добавить(НовыйПК);	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;

		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);	
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(Ложь);
		
		ОбновитьТаблицуПроизвольныхКодов();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ОткрытьФормуРедактированияНастройки(Истина, Копирование);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ОткрытьФормуРедактированияНастройки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если  Не (Направление = "" Или ТипОбъекта = "" ) Тогда
		ЗакрытьФормуСВыборомЭлемента();
	Иначе
		ОткрытьФормуРедактированияНастройки(Ложь);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ЗакрытьФормуСВыборомЭлемента();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоТиповой = Истина Тогда
		Сообщение = НСтр("be = 'Тыпавыя давольныя коды выдаляць забаронена!'; en = 'Prohibited to delete standard arbitrary codes!'; es = '¡No se permite eliminar códigos arbitrarios estándar!'; ka = 'სტანდარტული შემთხვევითი კოდების წაშლა აკრძალულია!'; kk = 'Стандартты өзгерту кодтарын жоюға рұқсат етілмейді!'; ro = 'Este interzis să ștergeți codurile arbitrare standard!'; ru = 'Типовые произвольные коды удалять запрещено!'; tr = 'Rastgele kodları silmek yasaktır!'; uk = 'Типові довільні коди видаляти заборонено!'; uz = ""Standart tasodifiy kodlarni o'chirish man etilgan!""");
		Сообщить(Сообщение); 
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные;
	ПроизвольныеКоды_Пользовательские = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские");
	Индекс = 0;
	Для каждого СтрокаПК из ПроизвольныеКоды_Пользовательские Цикл
		Если СтрокаПК.Свойство("ID_ПроизвольногоКода") И СтрокаПК.ID_ПроизвольногоКода = ТекущиеДанные.ID_ПроизвольногоКода Тогда
			ПроизвольныеКоды_Пользовательские.Удалить(Индекс);
			Прервать;
		КонецЕсли;
		Индекс = Индекс+1;
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВОдинКлюч(Команда)
	ПроизвольныеКоды = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды");
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды", _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(ПроизвольныеКоды));
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСлужебныеКолонки(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаПроизвольныхКодов.Колонки.ТаблицаПроизвольныхКодовID_ПроизвольногоКода.Видимость = Истина;
	#Иначе
		Элементы.ТаблицаПроизвольныхКодовID_ПроизвольногоКода.Видимость = Истина;
	#КонецЕсли
	
КонецПроцедуры


#КонецОбласти
	
#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура ОткрытьФормуРедактированияНастройки(ЭтоНоваяНастройка, ЭтоКопирование = Ложь)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПроизвольныйКод = ПолучитьФорму("ОФ_ФормаНастройки_ПроизвольныйКод", ЭтаФорма);
	#Иначе
		ФормаНастройки_ПроизвольныйКод = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПроизвольныйКод", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ПроизвольныйКод.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_ПроизвольныйКод._ЛокКонтекст 							= _ЛокКонтекст;
	ФормаНастройки_ПроизвольныйКод.ЭтоНоваяНастройка 						= ЭтоНоваяНастройка;
	ФормаНастройки_ПроизвольныйКод.КлючНастройки 							= КлючНастройки;
	ФормаНастройки_ПроизвольныйКод.ТипИсходногоДокумента1С 					= ТипИсходногоДокумента1С;
	ФормаНастройки_ПроизвольныйКод.ИмяТабличнойЧасти1С 						= ИмяТабличнойЧасти1С;
	ФормаНастройки_ПроизвольныйКод.ПравилаОбменаШапка 						= ПравилаОбменаШапка;
	ФормаНастройки_ПроизвольныйКод.ПравилаОбменаТабличнаяЧасть 				= ПравилаОбменаТабличнаяЧасть;
	ФормаНастройки_ПроизвольныйКод.Направление 								= Направление;
	ФормаНастройки_ПроизвольныйКод.ТипОбъекта 								= ТипОбъекта;	
	ФормаНастройки_ПроизвольныйКод.ЗапретитьИзменятьНаправлениеТипОбъекта 	= ЗапретитьИзменятьНаправлениеТипОбъекта;
		
	Если НЕ ЭтоНоваяНастройка ИЛИ ЭтоКопирование Тогда
		ТекущаяСтрока = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(ФормаНастройки_ПроизвольныйКод, ТекущаяСтрока);
		Если ЭтоКопирование Тогда
			ФормаНастройки_ПроизвольныйКод.ЭтоТиповой = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_ПроизвольныйКодЗакрытие",ЭтаФорма);
	ФормаНастройки_ПроизвольныйКод.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПроизвольныйКод.ОткрытьМодально();	
	#Иначе
		ФормаНастройки_ПроизвольныйКод.Открыть();
	#КонецЕсли	

КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПроизвольныйКодЗакрытие(ID_РедактируемойНастройки,ДопПараметры) Экспорт
	Если ЗначениеЗаполнено(ID_РедактируемойНастройки) Тогда
		ОбновитьТаблицуПроизвольныхКодов(ID_РедактируемойНастройки);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуПроизвольныхКодов(ID_ТекущейСтроки = "")
	
	ТаблицаПроизвольныхКодов.Очистить();
	пТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды",ИСТИНА);
	
	Индекс=Неопределено;Икс=0;
	
	Если Не (Направление = "" Или ТипОбъекта = "" ) Тогда
		Если ТипЗнч(пТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
			Для Каждого СтрокаМассива Из пТаблицаПроизвольныхКодов Цикл
				Если СтрокаМассива.Свойство("ЭтоТаблицаЗначений")
					ИЛИ НЕ СтрокаМассива.Направление = Направление 
					ИЛИ НЕ СтрокаМассива.ТипОбъекта = ТипОбъекта Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ID_ТекущейСтроки) И СтрокаМассива.ID_ПроизвольногоКода = ID_ТекущейСтроки Тогда
					Индекс = Икс;
				КонецЕсли;
				НоваяСтрока = ТаблицаПроизвольныхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаМассива);
				
				Если СтрокаМассива.Свойство("ЭтоТиповой") И СтрокаМассива.ЭтоТиповой = Истина Тогда
					НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
				Иначе
					НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
				КонецЕсли;
				
				Икс = Икс+1;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Если ТипЗнч(пТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
			Для Каждого СтрокаМассива Из пТаблицаПроизвольныхКодов Цикл
				Если СтрокаМассива.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ID_ТекущейСтроки) И СтрокаМассива.ID_ПроизвольногоКода = ID_ТекущейСтроки Тогда
					Индекс = Икс;
				КонецЕсли;
				НоваяСтрока = ТаблицаПроизвольныхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаМассива);
				
				Если СтрокаМассива.Свойство("ЭтоТиповой") И СтрокаМассива.ЭтоТиповой = Истина Тогда
					НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
				Иначе
					НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
				КонецЕсли;
				
				Икс = Икс+1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		Если Индекс <> Неопределено Тогда
			Элементы.ТаблицаПроизвольныхКодов.ТекущаяСтрока = Индекс;
		КонецЕсли;
	#КонецЕсли
	
	Элементы.ТаблицаПроизвольныхКодовНаправление.Видимость	= Не ЗапретитьИзменятьНаправлениеТипОбъекта;
	Элементы.ТаблицаПроизвольныхКодовТипОбъекта.Видимость 	= Не ЗапретитьИзменятьНаправлениеТипОбъекта;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуСВыборомЭлемента()
	
	Если Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные <> Неопределено Тогда
		Результат = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные.ID_ПроизвольногоКода;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
		Закрыть();	
	#Иначе
		Закрыть(Результат);
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти	
	
#Если ТолстыйКлиентОбычноеПриложение Тогда 
	
	Процедура ТаблицаПроизвольныхКодовПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		
		ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.ОтображатьКартинку = Истина;
		ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.ОтображатьТекст = Ложь;
		Если ДанныеСтроки.ЭтоТиповой = Истина Тогда
			ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
		Иначе
			ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.Картинка = БиблиотекаКартинок.Пользователь;
		КонецЕсли;
		
	КонецПроцедуры
	
	Процедура КомПанельТаблицыВыбрать(Кнопка)
		ЗакрытьФормуСВыборомЭлемента();
	КонецПроцедуры

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Объект = ЭтотОбъект;
#КонецЕсли

