		ТекстПодсказки = НСтр("be = ""У адбор патрапяць дакументы, якія з'яўляюцца вынікам выканання запыту (гл. Сваі запыт)""; en = 'Documents that are the result of a query execution will be selected (see Your query).'; es = 'Los documentos que sean resultado de una consulta se incluirán en la selección (ver Su consulta)'; ka = 'არჩეული დოკუმენტები შეიცვადეს მოთხოვნის შესრულების შედეგად (იხ. თქვენი მოთხოვნა).'; kk = 'В отбор попадут документы, являющиеся результатом выполнения запроса (см. Свой запрос) - Таңдаушы параметрлерге сай болатын құжаттар, сұрау орындалуының нәтижесі болып табылатын (өз сұрауыңызды көріңіз)'; ro = 'Vor fi incluse documentele care sunt rezultatul unei interogări (vezi Interogarea dvs.).'; ru = 'В отбор попадут документы, являющиеся результатом выполнения запроса (см. Свой запрос).'; tr = 'Sorgunun sonucu olan belgeler seçilecek (bkz. Kendi sorgunuz).'; uk = 'У відбір потраплять документи, які є результатом виконання запиту (див. Власний запит).'; uz = ""So'rov natijasi bo'lgan hujjatlar tanlovga tushadi (Ko'rib chiqilishi so'rovi).""");
