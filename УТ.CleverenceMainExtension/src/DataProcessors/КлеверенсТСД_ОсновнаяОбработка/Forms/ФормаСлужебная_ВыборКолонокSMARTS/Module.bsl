&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТаблицаКолонок.Очистить();
	
	СписокПредставленийПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивКолонокТаблицыДокументовSMARTS();
	
	СохраненныеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", Истина);	

	Если СохраненныеНастройки <> Ложь И СохраненныеНастройки <> Неопределено Тогда
		Для Каждого Строка Из СохраненныеНастройки Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если СписокПредставленийПоУмолчанию.НайтиПоЗначению(Строка.Название) <> Неопределено Тогда
				НС = ТаблицаКолонок.Добавить();
				ЗаполнитьЗначенияСвойств(НС,Строка);
			КонецЕсли;
		КонецЦикла;
		// Если вдруг сохранились настройки с ограниченным количеством реквизитов, дополняем их дополнительными
		Для Каждого Строка Из СписокПредставленийПоУмолчанию Цикл
			НайденныеРеквизиты = ТаблицаКолонок.НайтиСтроки(Новый Структура("Название", Строка.Значение)); 
			Если Не НайденныеРеквизиты.Количество() Тогда
				НС = ТаблицаКолонок.Добавить();
				НС.Использование	= Ложь;
				НС.Представление	= Строка.Представление;
				НС.Название			= Строка.Значение;
			КонецЕсли;
		КонецЦикла;		
	Иначе		
		Для Каждого Строка Из СписокПредставленийПоУмолчанию Цикл
			НС = ТаблицаКолонок.Добавить();
			НС.Использование	= Ложь;
			НС.Представление	= Строка.Представление;
			НС.Название			= Строка.Значение;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	МассивСтруктур = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПоместитьТЧВоВременноеХранилище("ТаблицаКолонок"));
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", МассивСтруктур, ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	МассивСтруктур);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, Истина);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(Истина);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТЧВоВременноеХранилище(ИмяТЧ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		#Область НесовместимыйКодFresh
		ТЧ = Вычислить(ИмяТЧ);
		#КонецОбласти //НесовместимыйКодFresh
	#Иначе
		ТЧ = РеквизитФормыВЗначение(ИмяТЧ);
	#КонецЕсли
	
	Возврат ПоместитьВоВременноеХранилище(ТЧ, Новый УникальныйИдентификатор());

КонецФункции

&НаКлиенте
Процедура ВыделитьВсе(Команда)
	
	УстановкаСнятиеВсехФлажков(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановкаСнятиеВсехФлажков(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура УстановкаСнятиеВсехФлажков(ЗначениеФлага)
	
	Для Каждого Строка Из ТаблицаКолонок Цикл		
		Если Строка.Использование = ЗначениеФлага Тогда
			Продолжить;	
		КонецЕсли;
		Строка.Использование = ЗначениеФлага;		
	КонецЦикла;
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли