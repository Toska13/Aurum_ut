&НаСервереБезКонтекста
Функция ПолучитьВладельцаХарактеристик(Номенклатура)

	Владелец = Неопределено;
		
	// Если признак использования характеристик зашит в номенклатуре
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ИспользованиеХарактеристик") <> Неопределено 
		И Метаданные.Перечисления.Найти("ВариантыИспользованияХарактеристикНоменклатуры") <> Неопределено Тогда	
		
		Если Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры") Тогда
			Владелец = Номенклатура.ВидНоменклатуры;
		ИначеЕсли Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры") Тогда
			Владелец = Номенклатура;
		ИначеЕсли Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры") Тогда
			Владелец = Номенклатура.ВладелецХарактеристик;
		ИначеЕсли Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать") Тогда
			Владелец = Неопределено;		
		Иначе		
			Владелец = Неопределено;		
		КонецЕсли;			
		
	// Если признак использования характеристик зашит в виде номенклатуры
	ИначеЕсли Метаданные.Справочники.ВидыНоменклатуры.Реквизиты.Найти("ИспользованиеХарактеристик") <> Неопределено 
		И Метаданные.Перечисления.Найти("ВариантыВеденияДополнительныхДанныхПоНоменклатуре") <> Неопределено Тогда	
		
		Если Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.ОбщиеДляВидаНоменклатуры") Тогда
			Владелец = Номенклатура.ВидНоменклатуры;	
		ИначеЕсли Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.ИндивидуальныеДляНоменклатуры") Тогда
			Владелец = Номенклатура;	
		ИначеЕсли Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.НеИспользовать") Тогда
			Владелец = Неопределено;	
		Иначе
			Владелец = Неопределено;	
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат Владелец;
	
КонецФункции

// Получает структуру имен колонок таблицы
//
// Возвращаемое значение:
//   Стуктура   - структура имен колонок таблицы
//
Функция ПолучитьСтруктуруИменКолонокТаблицы()

	СтруктураИменКолонок = Новый Структура;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТаблицаЗначений = ТаблицаНовыеШтрихкоды;
	#Иначе
		ТаблицаЗначений = ТаблицаНовыеШтрихкоды.Выгрузить();
	#КонецЕсли
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		СтруктураИменКолонок.Вставить(Колонка.Имя);	
	КонецЦикла;

	Возврат СтруктураИменКолонок;
	
КонецФункции

