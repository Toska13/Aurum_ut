          <name>НадписьСправкаРасширенныеНастройкиРасширеннаяПодсказка</name>
          <id>249</id>
          <type>Label</type>
          <autoMaxWidth>true</autoMaxWidth>
          <autoMaxHeight>true</autoMaxHeight>
