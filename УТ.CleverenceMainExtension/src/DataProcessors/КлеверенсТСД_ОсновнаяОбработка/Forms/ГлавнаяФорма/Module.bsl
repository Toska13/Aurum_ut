&НаКлиенте
Процедура ОтправитьОтчетОбОшибкахНажатие(Элемент)
	
	СерверКачестваДоступен = _ЛокКонтекст.ЛокЯдро_СерверКачества_ПроверитьДоступностьСервера();
	
	Если СерверКачестваДоступен = Ложь Тогда
		Сообщить("Портал технической поддержки Клеверенс недоступен. Попробуйте позже.");
		Возврат;
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ГлубинаОтбора", 3);
	ПараметрыМетода.Вставить("СрокДоСледующейПроверки", 3);
	ПараметрыМетода.Вставить("РучноеФормирование", Истина);
	ПараметрыМетода.Вставить("ДатаТекущейПроверки", НачалоДня(ТекущаяДата()));
	_ЛокКонтекст.ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибках(ПараметрыМетода);
	
КонецПроцедуры

