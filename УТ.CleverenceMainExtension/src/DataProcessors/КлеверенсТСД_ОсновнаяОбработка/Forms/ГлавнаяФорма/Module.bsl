			СообщениеУстройство		= НСтр("be = 'Не абрана прылада для працы з дакументамі! Дакументы не выгружаны ў Мабільнае прылада.'; en = 'No device selected for working with documents! Documents are not uploaded to the Mobile device.'; es = '¡No se ha seleccionado un dispositivo para trabajar con documentos! Los documentos no se han descargado en el dispositivo móvil.'; ka = 'დოკუმენტების სამუშაოსთვის მოწყობილობა არ არჩეულია! დოკუმენტები არ არის გამოტანილი მობილურ მოწყობაში.'; kk = 'Құжаттармен жұмыс істеу үшін құрылғы таңдалмаған! Документтер Мобильді құрылғыға жүктелмеді.'; ro = 'Dispozitivul pentru lucru cu documentele nu este selectat! Documentele nu au fost descărcate pe dispozitivul mobil.'; ru = 'Не выбрано устройство для работы с документами! Документы не выгружены в ТСД.'; tr = 'Belgelerle çalışmak için bir cihaz seçilmedi! Belgeler Mobil Cihaza yüklenmedi.'; uk = 'Не обрано пристрій для роботи з документами! Документи не вивантажені в Мобільний пристрій.'; uz = 'Hujjatlar bilan ishlash uchun qurilmagan! Hujjatlar Mobil qurilmaga yuklanmagan.'");
		Иначе                 
			СообщениеПользователю 	= НСтр("be = 'Не абраны карыстальнік для працы з дакументам! Дакумент не выгружаны ў Мабільнае прылада.'; en = 'No user selected to work with the document! Document not unloaded to the Mobile device.'; es = '¡No se ha seleccionado un usuario para trabajar con el documento! El documento no se ha descargado al dispositivo móvil.'; ka = 'არ არის არჩეული მომხმარებელი დოკუმენტის შესაქმნელად! დოკუმენტი არ გამოიტანება მობილურ მოწყობილობაში.'; kk = 'Документпен жұмыс істеу үшін пайдаланушы таңдалмады! Документ мобильді құрылғыға шығарылмады.'; ro = 'Nu a fost selectat un utilizator pentru a lucra cu documentul! Documentul nu a fost descărcat pe dispozitivul mobil.'; ru = 'Не выбран пользователь для работы с документом! Документ не выгружен в ТСД.'; tr = 'Belgeyle çalışmak için kullanıcı seçilmedi! Belge mobil cihaza indirilmedi.'; uk = 'Не обрано користувача для роботи з документом! Документ не вивантажений на мобільний пристрій.'; uz = 'Hujjatlarni ishlash uchun foydalanuvchi tanlanmagan! Hujjat mobil qurilmaga yuklanmadi.'");
			СообщениеУстройство		= НСтр("be = 'Не абрана прылада для працы з дакументам! Дакумент не выгружаны ў Мабільнае прылада.'; en = 'No device selected for working with the document! The document is not uploaded to the Mobile device.'; es = '¡No se ha seleccionado un dispositivo para trabajar con el documento! El documento no se ha descargado en el dispositivo móvil.'; ka = 'დოკუმენტის სამუშაოსთვის მოწყობილობა არ არჩეულია! დოკუმენტი არ არის გამოტანილი მობილურ მოწყობაში.'; kk = 'Құжатпен жұмыс істеу үшін құрылғы таңдалмаған! Документ Мобильді құрылғыға жүктелмеді.'; ro = 'Dispozitivul pentru lucru cu documentul nu este selectat! Documentul nu a fost descărcat pe dispozitivul mobil.'; ru = 'Не выбрано устройство для работы с документом! Документ не выгружен в ТСД.'; tr = 'Belgelerle çalışmak için bir cihaz seçilmedi! Belge Mobil Cihaza yüklenmedi.'; uk = 'Не обрано пристрій для роботи з документом! Документ не вивантажений в Мобільний пристрій.'; uz = 'Hujjat bilan ishlash uchun qurilmagan! Hujjat Mobil qurilmaga yuklanmagan.'");
		КонецЕсли;
		
		Если ДопПараметры.Свойство("СпособНазначения") И ДопПараметры.СпособНазначения = "Устройству" Тогда
			Сообщить(СообщениеУстройство); 
		Иначе
			Сообщить(СообщениеПользователю); 
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

// Вызывает процедуру выгрузки документа в базу Клеверенс после ответа на вопрос
// о повторной выгрузке документа
//
// Параметры:
//	РезультатВопроса - КодВозвратаДиалога - ответ на вопрос о повторной выгрузке документа
//	ДопПараметры - Структура - содержит:
//		* ОбъектыНазначения - Массив - Ссылки, для которых выполняется команда
//		* ВыгрузитьВОдин - Булево
&НаКлиенте
Процедура ОповещениеВопросПовторВыгрузкиЗавершение(РезультатВопроса, ДопПараметры) Экспорт
	
	ВыгрузитьВОдин = ДопПараметры.ВыгрузитьВОдин;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВыгрузитьДокументВстраиваемаяКоманда(ДопПараметры.ОбъектыНазначения,,Ложь,,ВыгрузитьВОдин);
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда                         
		ВыгрузитьДокументВстраиваемаяКоманда(ДопПараметры.МассивДокументовКВыгрузке,,Ложь,,ВыгрузитьВОдин);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ВыборНазначенияВыгрузкиЗакрытие(РезультатРедактирования, СтруктураПараметров) Экспорт
	
	ВыгрузитьКакОдин  = ?(СтруктураПараметров.Свойство("ВыгрузитьКакОдин"), СтруктураПараметров.ВыгрузитьКакОдин, Ложь);
	МассивДокументов  = СтруктураПараметров.МассивДокументов;
	ID_БизнесПроцесса = СтруктураПараметров.ID_БизнесПроцесса;
	
	Если ТипЗнч(РезультатРедактирования) = Тип("Строка") Тогда
		
		Если ЭтоАдресВременногоХранилища(РезультатРедактирования) Тогда
			НазначенныеПользователи = ПолучитьИзВременногоХранилища(РезультатРедактирования);
		Иначе
			НазначенныеПользователи = _ЛокКонтекст.ЛокЯдро_ПолучениеУстройстваПоПинкодуДляВыгрузкиДокумента(РезультатРедактирования, ?(ЕстьЧастнаяБаза, "Частная", "Основная"));
		КонецЕсли;
		
		Если НазначенныеПользователи <> Неопределено 
			И ТипЗнч(НазначенныеПользователи) = Тип("Массив")
			И НазначенныеПользователи.Количество() > 0 Тогда
			
			Если ВыгрузитьКакОдин Тогда				
				_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(МассивДокументов, ID_БизнесПроцесса, НазначенныеПользователи, "");
				Сообщение = НСтр("be = ""Вылучаныя дакументы аб'яднаныя і выгружаныя на Мабільнае прылада""; en = 'Selected documents are merged and unloaded to the Mobile device'; es = 'Documentos seleccionados combinados y descargados en el dispositivo móvil'; ka = 'მონიშნული დოკუმენტები შეერთებული და გამოსახული მობილურ მოწყობაში'; kk = 'Таңдалған құжаттар біріктіріліп, Мобильді құрылғыға жүктелді'; ro = 'Documentele selectate au fost combinate și descărcate pe dispozitivul mobil'; ru = 'Выделенные документы объединены и выгружены в ТСД'; tr = 'Seçilen belgeler birleştirildi ve Mobil Cihaza dışa aktarıldı'; uk = ""Виділені документи об'єднані та вивантажені на Мобільний пристрій""; uz = 'Tanlangan hujjatlar birlashtirildi va Mobil qurilmaga yuklandi'");
				Сообщить(Сообщение); 
			Иначе
				Для Каждого ДокументКВыгрузке Из МассивДокументов Цикл
					_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(ДокументКВыгрузке, ID_БизнесПроцесса, НазначенныеПользователи, "");
					Сообщение = НСтр("be = 'Дакумент ""%1"" адпраўлены ў Мабільнае прылада'; en = 'Document ""%1"" sent to the Mobile device'; es = 'El documento ""%1"" ha sido enviado al dispositivo móvil'; ka = 'დოკუმენტი ""%1"" გადაიგზავნა მობილურ მოწყობილობაში'; kk = '""%1"" документі Мобильді құрылғыға жіберілді'; ro = 'Documentul ""%1"" a fost trimis pe dispozitivul mobil'; ru = 'Документ ""%1"" отправлен в ТСД'; tr = '""%1"" belgesi Mobil Cihaza gönderildi'; uk = 'Документ ""%1"" відправлено на Мобільне пристрій'; uz = '""%1"" ҳужжати Мобил қурилмага юборилди'");
					Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, Строка(ДокументКВыгрузке));
					Сообщить(Сообщение); 
				КонецЦикла;
			КонецЕсли;    						
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(РезультатРедактирования) = Тип("Массив") Тогда 
		
		Если РезультатРедактирования.Количество() > 0 Тогда	
			
			НазначенныеПользователи = РезультатРедактирования;				
			
			Если ВыгрузитьКакОдин Тогда				
				_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(МассивДокументов, ID_БизнесПроцесса, НазначенныеПользователи, "");
				Сообщение = НСтр("be = ""Вылучаныя дакументы аб'яднаныя і выгружаныя на Мабільнае прылада""; en = 'Selected documents are merged and unloaded to the Mobile device'; es = 'Documentos seleccionados combinados y descargados en el dispositivo móvil'; ka = 'მონიშნული დოკუმენტები შეერთებული და გამოსახული მობილურ მოწყობაში'; kk = 'Таңдалған құжаттар біріктіріліп, Мобильді құрылғыға жүктелді'; ro = 'Documentele selectate au fost combinate și descărcate pe dispozitivul mobil'; ru = 'Выделенные документы объединены и выгружены в ТСД'; tr = 'Seçilen belgeler birleştirildi ve Mobil Cihaza dışa aktarıldı'; uk = ""Виділені документи об'єднані та вивантажені на Мобільний пристрій""; uz = 'Tanlangan hujjatlar birlashtirildi va Mobil qurilmaga yuklandi'");
				Сообщить(Сообщение); 
			Иначе
				Для Каждого ДокументКВыгрузке Из МассивДокументов Цикл
					_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(ДокументКВыгрузке, ID_БизнесПроцесса, НазначенныеПользователи, "");
					Сообщение = НСтр("be = 'Дакумент ""%1"" адпраўлены ў Мабільнае прылада'; en = 'Document ""%1"" sent to the Mobile device'; es = 'El documento ""%1"" ha sido enviado al dispositivo móvil'; ka = 'დოკუმენტი ""%1"" გადაიგზავნა მობილურ მოწყობილობაში'; kk = '""%1"" документі Мобильді құрылғыға жіберілді'; ro = 'Documentul ""%1"" a fost trimis pe dispozitivul mobil'; ru = 'Документ ""%1"" отправлен в ТСД'; tr = '""%1"" belgesi Mobil Cihaza gönderildi'; uk = 'Документ ""%1"" відправлено на Мобільне пристрій'; uz = '""%1"" ҳужжати Мобил қурилмага юборилди'");
					Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, Строка(ДокументКВыгрузке));
					Сообщить(Сообщение); 
				КонецЦикла;
			КонецЕсли;    						
			
		Иначе
			
			Если МассивДокументов.Количество() > 1 Тогда
				ОкончаниеСообщения 	= "документами! Документы не выгружены в ТСД.";
			Иначе                 
				ОкончаниеСообщения 	= "документом! Документ не выгружен в ТСД.";				
			КонецЕсли;
			
			Если СтруктураПараметров.Свойство("СпособНазначения") И СтруктураПараметров.СпособНазначения = "Устройству" Тогда
				СообщениеПользователю = "Не выбрано устройство для работы с " + ОкончаниеСообщения;
			Иначе
				СообщениеПользователю = "Не выбран пользователь для работы с " + ОкончаниеСообщения;
			КонецЕсли;
			
		КонецЕсли; 
		
	ИначеЕсли РезультатРедактирования = Ложь Тогда
		
		СообщениеПользователю = "Не введен пин-код для выбора устройства!";
		СтруктураПараметров.Вставить("ВводПинКода", Истина);
		
	КонецЕсли;		
	
	
КонецПроцедуры

#КонецОбласти

#Область КомандыЗагрузки

// Вызывает процедуру загрузки документа из базы Клеверенс в открытый документ 1С
//
// Параметры:
//	ОткрытаяФормаДокумента - Форма
//	ИдДокументаСмартс - Строка
//	ID_БизнесПроцесса - Строка
//
&НаКлиенте
Процедура ЗагрузитьВОткрытыйДокумент(ОткрытаяФормаДокумента, ИдДокументаСмартс = Неопределено, ID_БизнесПроцесса = Неопределено) Экспорт
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СсылкаНаДокумент = ОткрытаяФормаДокумента.ДокументОбъект.Ссылка;
	#Иначе
