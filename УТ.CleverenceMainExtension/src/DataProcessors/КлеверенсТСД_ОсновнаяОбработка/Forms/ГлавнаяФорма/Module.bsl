			ПользователиMS 	= _ЛокКонтекст.ЛокЯдро_ПодготовитьДеревоУстройствНаСервере(пУстройстваMS);
		Иначе
			пПользователиMS = _ЛокКонтекст.СтруктураМетаданных.ПользователиMS;
			ПользователиMS 	= _ЛокКонтекст.ЛокЯдро_ПодготовитьДеревоПользователейНаСервере(пПользователиMS);
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборПользователяИлиГруппы", ЭтаФорма);
		#Иначе		
			ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборПользователяИлиГруппы", , ЭтаФорма, ЭтаФорма);
			ФормаСлужебная_ВыборПользователяИлиГруппы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаСлужебная_ВыборПользователяИлиГруппы.ЗакрыватьПриЗакрытииВладельца = Истина;
		ФормаСлужебная_ВыборПользователяИлиГруппы._ЛокКонтекст = _ЛокКонтекст;		
		Если НесколькоДокументов Тогда
			ТекстЗаголовка = НСтр("be = 'Выберыце карыстальніка для дакумента %1 і яшчэ %2 дакументаў'; en = 'Select a user for document %1 and %2 more documents'; es = 'Elija un usuario para el documento %1 y otros %2 documentos'; ka = 'აირჩიეთ მომხმარებელი დოკუმენტის %1 და კიდევ %2 დოკუმენტი'; kk = '%1 документі үшін пайдаланушыны таңдаңыз және қоса %2 документтер'; ro = 'Alegeți utilizatorul pentru documentul %1 și încă %2 documente'; ru = 'Выберите пользователя для документа %1 и еще %2 документов'; tr = '%1 belgesi için bir kullanıcı seçin ve %2 belge daha seçin'; uk = 'Оберіть користувача для документа %1 і ще %2 документів'; uz = '%1 hujjati uchun foydalanuvchini tanlang va yana %2 hujjatlar'");
			ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(ДокументСсылка), Строка(ОбъектыНазначения.Количество()-1));
		Иначе     
			ТекстЗаголовка = НСтр("be = 'Выберыце карыстальніка для дакумента %1'; en = 'Select a user for document %1'; es = 'Elija un usuario para el documento %1'; ka = 'აირჩიეთ მომხმარებელი დოკუმენტის %1'; kk = '%1 документі үшін пайдаланушыны таңдаңыз'; ro = 'Alegeți utilizatorul pentru documentul %1'; ru = 'Выберите пользователя для документа %1'; tr = '%1 belgesi için bir kullanıcı seçin'; uk = 'Оберіть користувача для документа %1'; uz = '%1 hujjati uchun foydalanuvchini tanlang'");
			ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(ДокументСсылка));
		КонецЕсли;
		ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = ТекстЗаголовка;				
		ФормаСлужебная_ВыборПользователяИлиГруппы.ПользователиMSАдрес = ПользователиMS;
		ФормаСлужебная_ВыборПользователяИлиГруппы.ОдиночныйРежимВыделения = Истина;
		ФормаСлужебная_ВыборПользователяИлиГруппы.СпособНазначения = СпособНазначения;
		Если СпособНазначения = "Устройству" Тогда                                                                                      
			Если НесколькоДокументов Тогда
				ТекстЗаголовка = НСтр("be = 'Выберыце прылад для дакумента %1 і яшчэ %2 дакументаў'; en = 'Select a device for document %1 and %2 more documents'; es = 'Elija un dispositivo para el documento %1 y otros %2 documentos'; ka = 'აირჩიეთ მოწყობილობა დოკუმენტის %1 და კიდევ %2 დოკუმენტი'; kk = '%1 документі үшін құрылғы таңдаңыз және қоса %2 документтер'; ro = 'Alegeți dispozitivul pentru documentul %1 și încă %2 documente'; ru = 'Выберите устройство для документа %1 и еще %2 документов'; tr = '%1 belgesi için bir cihaz seçin ve %2 belge daha seçin'; uk = 'Оберіть пристрій для документа %1 і ще %2 документів'; uz = '%1 hujjati uchun qurilmayni tanlang va yana %2 hujjatlar'");
				ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(ДокументСсылка), Строка(ОбъектыНазначения.Количество()-1));
			Иначе     
				ТекстЗаголовка = НСтр("be = 'Выберыце прылад для дакумента %1'; en = 'Select a device for document %1'; es = 'Elija un dispositivo para el documento %1'; ka = 'აირჩიეთ მოწყობილობა დოკუმენტის %1'; kk = '%1 документі үшін құрылғы таңдаңыз'; ro = 'Alegeți dispozitivul pentru documentul %1'; ru = 'Выберите устройство для документа %1'; tr = '%1 belgesi için bir cihaz seçin'; uk = 'Оберіть пристрій для документа %1'; uz = '%1 hujjati uchun qurilmayni tanlang'");
				ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(ДокументСсылка));
			КонецЕсли;
			ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = ТекстЗаголовка;
			ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMSГруппаПользователь"].Заголовок = НСтр("be = 'Прылада'; en = 'Device'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; ru = 'Устройство'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
		КонецЕсли;                                                                  
		
		ДопПараметры = Новый Структура("ОбъектыНазначения,ПроверитьНаТСД,ID_БизнесПроцесса,ВыгрузитьВОдин,СпособНазначения", 
			ОбъектыНазначения, 
			ПроверитьНаТСД, 
			ID_БизнесПроцесса, 
			ВыгрузитьВОдин, 
			СпособНазначения);                
			
		ОП = Новый ОписаниеОповещения("Служебная_ВыборПользователяИлиГруппыЗакрытие", ЭтаФорма, ДопПараметры);
		ФормаСлужебная_ВыборПользователяИлиГруппы.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_ВыборПользователяИлиГруппы.ОткрытьМодально();
		#Иначе
			ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();
		#КонецЕсли
		
		Возврат;
		
	КонецЕсли;
	
	Если (флУказатьПользователя Или флОтправитьНаУстройство) И НазначенныеПользователи[0].Ид = "Выгружать всем" Тогда
		НазначенныеПользователи = Неопределено;
	КонецЕсли;
	
	Если ВыгрузитьВОдин Тогда
		_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(ОбъектыНазначения, ID_БизнесПроцесса,НазначенныеПользователи,"");
		Сообщение = НСтр("be = ""Вылучаныя дакументы аб'яднаныя і выгружаныя на Мабільнае прылада""; en = 'Selected documents are merged and unloaded to the Mobile device'; es = 'Documentos seleccionados combinados y descargados en el dispositivo móvil'; ka = 'მონიშნული დოკუმენტები შეერთებული და გამოსახული მობილურ მოწყობაში'; kk = 'Таңдалған құжаттар біріктіріліп, Мобильді құрылғыға жүктелді'; ro = 'Documentele selectate au fost combinate și descărcate pe dispozitivul mobil'; ru = 'Выделенные документы объединены и выгружены в ТСД'; tr = 'Seçilen belgeler birleştirildi ve Mobil Cihaza dışa aktarıldı'; uk = ""Виділені документи об'єднані та вивантажені на Мобільний пристрій""; uz = 'Tanlangan hujjatlar birlashtirildi va Mobil qurilmaga yuklandi'");
		Сообщить(Сообщение); 
	Иначе
		Для Каждого ДокументКВыгрузке Из ОбъектыНазначения Цикл
			_ЛокКонтекст.ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(ДокументКВыгрузке, ID_БизнесПроцесса,НазначенныеПользователи,"");
			Сообщение = НСтр("be = 'Дакумент ""%1"" адпраўлены ў Мабільнае прылада'; en = 'Document ""%1"" sent to the Mobile device'; es = 'El documento ""%1"" ha sido enviado al dispositivo móvil'; ka = 'დოკუმენტი ""%1"" გადაიგზავნა მობილურ მოწყობილობაში'; kk = '""%1"" документі Мобильді құрылғыға жіберілді'; ro = 'Documentul ""%1"" a fost trimis pe dispozitivul mobil'; ru = 'Документ ""%1"" отправлен в ТСД'; tr = '""%1"" belgesi Mobil Cihaza gönderildi'; uk = 'Документ ""%1"" відправлено на Мобільне пристрій'; uz = '""%1"" ҳужжати Мобил қурилмага юборилди'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, Строка(ДокументКВыгрузке));
			Сообщить(Сообщение); 
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИдДокумента(ДокументСсылка)
	Возврат XMLСтрока(ДокументСсылка);
КонецФункции

&НаСервере
Функция ПолучитьТипДокументаИзСсылки(ДокументСсылка)
	Возврат  ДокументСсылка.Метаданные().Имя;
КонецФункции

// Вызывает процедуру выгрузки документа в базу Клеверенс после выбора бизнес-процесса
//
// Параметры:
//	РезультатВыбора	- Структура - содержит:
//		* Данные - Структура - содержит данные выбранного бизнес-процесса
//	ДопПараметры - Структура - содержит:
//		* ОбъектыНазначения - Массив - Ссылки, для которых выполняется команда
//		* ПроверитьНаТСД - Булево
//		* ВыгрузитьВОдин - Булево
&НаКлиенте
Процедура ФормаСлужебная_ВыборБПИзТаблицыЗакрытие(РезультатВыбора, ДопПараметры) Экспорт
	
	ОбъектыНазначения 	= ДопПараметры.ОбъектыНазначения;
	ПроверитьНаТСД 		= ДопПараметры.ПроверитьНаТСД;
	ВыгрузитьВОдин		= ДопПараметры.ВыгрузитьВОдин;
	
	Если ЗначениеЗаполнено(РезультатВыбора) И ЗначениеЗаполнено(РезультатВыбора.Данные) Тогда
		Если ЗначениеЗаполнено(РезультатВыбора.Данные.ID_БизнесПроцесса) Тогда
			ID_БизнесПроцесса = РезультатВыбора.Данные.ID_БизнесПроцесса;			
			ВыгрузитьДокументВстраиваемаяКоманда(ОбъектыНазначения,ID_БизнесПроцесса,ПроверитьНаТСД,,ВыгрузитьВОдин);
		Иначе
			Сообщение = НСтр("be = 'У выбранага бізнес-працэсу ""%1"" не запоўнены ID'; en = 'The ID is not filled in for the selected business process ""%1""'; es = 'El proceso comercial seleccionado ""%1"" no tiene un ID completado'; ka = 'არჩეულ ბიზნეს პროცესში ""%1"" ID არ არის შევსებული'; kk = 'Таңдалған бизнес-процесс ""%1"" ID толтырылмаған'; ro = 'Procesul de afaceri selectat ""%1"" nu are ID-ul completat'; ru = 'У выбранного бизнес-процесса ""%1"" не заполнен ID'; tr = 'Seçilen iş sürecinde ""%1"" kimlik numarası eksik'; uk = 'У обраного бізнес-процесу ""%1"" не заповнено ID'; uz = 'Tanlangan biznes jarayon ""%1"" ID to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(РезультатВыбора.Данные.Название));
			Сообщить(Сообщение); 
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

// Вызывает процедуру загрузки документа из базы Клеверенс после выбора бизнес-процесса
//
// Параметры:
//	РезультатВыбора	- Структура - содержит:
//		* Данные - Структура - содержит данные выбранного бизнес-процесса
//	ДопПараметры - Структура - содержит:
//		* ОбъектыНазначения - Массив - Ссылки, для которых выполняется команда
//		* ИдДокументаСмартс - Строка
&НаКлиенте
Процедура ФормаСлужебная_ВыборБППриЗагрузкеИзТаблицыЗакрытие(РезультатВыбора, ДопПараметры) Экспорт
	
	ОбъектыНазначения 	= ДопПараметры.ОбъектыНазначения;
	ИдДокументаСмартс 	= ДопПараметры.ИдДокументаСмартс;	
	
	Если ЗначениеЗаполнено(РезультатВыбора) И ЗначениеЗаполнено(РезультатВыбора.Данные) Тогда
		Если ЗначениеЗаполнено(РезультатВыбора.Данные.ID_БизнесПроцесса) Тогда
			ID_БизнесПроцесса = РезультатВыбора.Данные.ID_БизнесПроцесса;			
			ЗагрузитьДокументыСТСД(ОбъектыНазначения,ИдДокументаСмартс,ID_БизнесПроцесса);
		Иначе
			Сообщение = НСтр("be = 'У выбранага бізнес-працэсу ""%1"" не запоўнены ID'; en = 'The ID is not filled in for the selected business process ""%1""'; es = 'El proceso comercial seleccionado ""%1"" no tiene un ID completado'; ka = 'არჩეულ ბიზნეს პროცესში ""%1"" ID არ არის შევსებული'; kk = 'Таңдалған бизнес-процесс ""%1"" ID толтырылмаған'; ro = 'Procesul de afaceri selectat ""%1"" nu are ID-ul completat'; ru = 'У выбранного бизнес-процесса ""%1"" не заполнен ID'; tr = 'Seçilen iş sürecinde ""%1"" kimlik numarası eksik'; uk = 'У обраного бізнес-процесу ""%1"" не заповнено ID'; uz = 'Tanlangan biznes jarayon ""%1"" ID to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(РезультатВыбора.Данные.Название));
			Сообщить(Сообщение); 
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

// Вызывает процедуру выгрузки документа в базу Клеверенс после выбора пользователя/устройства,
// которому назначается документ
//
// Параметры:
//	РезультатРедактирования	- Массив из Строка - Массив идентификаторов выбранных пользователей/устройств
//	ДопПараметры - Структура - содержит:
//		* ОбъектыНазначения - Массив - Ссылки, для которых выполняется команда
//		* ПроверитьНаТСД - Булево
//		* ID_БизнесПроцесса - Строка
//		* ВыгрузитьВОдин - Булево
&НаКлиенте
