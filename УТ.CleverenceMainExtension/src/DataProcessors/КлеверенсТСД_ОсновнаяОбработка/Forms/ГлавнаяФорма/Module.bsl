		ТекстСостояния = НСтр("be = 'Праца немагчыма! База не знойдзена або недаступная, выберыце іншую базу і перазапусціце апрацоўку!'; en = 'Work is not possible! Database not found or unavailable, select another database and restart the processing!'; es = '¡El trabajo no es posible! ¡No se encontró la base de datos o no está disponible, seleccione otra base de datos y reinicie el procesamiento!'; ka = 'მუშაობა შეუძლებელია! ბაზა ვერ მოიძებნა ან არ არის ხელმისაწვდომი, აირჩიეთ სხვა ბაზა და გადატვირთეთ დამუშავება!'; kk = 'Жұмыс мүмкін емес! База табылмады немесе қолжетімді емес, басқа базаны таңдаңыз және өңдеуін қайта іске қосыңыз!  '; ro = 'Muncă imposibilă! Baza de date nu a fost găsită sau nu este disponibilă, selectați o altă bază de date și reporniți procesarea!'; ru = 'Работа невозможна! База не найдена или недоступна, выберите другую базу и перезапустите обработку!'; tr = 'Çalışma mümkün değil! Veritabanı bulunamadı veya erişilemez, başka bir veritabanı seçin ve işlemi yeniden başlatın!'; uk = 'Робота неможлива! База не знайдена або недоступна, виберіть іншу базу та перезапустіть обробку!'; uz = ""Ish olib bo'lmayapti! Bazani topib olmadingiz yoki mavjud emas, boshqa bazani tanlang va ishni qayta boshlang!  """);		
		СтруктураЗначения = Новый Структура("Текст, Цвет", ТекстСостояния, УстановитьЦветСтатуса(1));
		СтруктураОшибокСостояний.Вставить(ОперацияПоСменеСтатуса, СтруктураЗначения);
		
	ИначеЕсли СтатусЗапускаОсновнойОбработки="БазаНайденаИПодключенаПолучаемНастройки" Тогда
		ТекстСостояния = НСтр("be = 'Праца немагчыма! Узнікла непрадвідзеная праблема пры атрыманні налад з базы Cleverence, вырашыце праблему і перазапусціце апрацоўку!'; en = 'Work is not possible! An unexpected problem occurred while retrieving settings from the Cleverence database, resolve the issue and restart the processing!'; es = '¡El trabajo no es posible! Se ha producido un problema inesperado al obtener la configuración de la base de datos de Cleverence, solucione el problema y reinicie el procesamiento!'; ka = 'მუშაობა შეუძლებელია! არაელი პრობლემა გამოიქვე როცა მიიღეთ Cleverence ბაზიდან კონფიგურაციები, გადაადგილეთ პრობლემა და გადატვირთეთ დამუშავება!'; kk = 'Жұмыс мүмкін емес! Cleverence базасынан орнатуларды алу кезінде күнделіксіз мәселе пайда болды, мәселені шешіп, өңдеуін қайта іске қосыңыз!  '; ro = 'Muncă imposibilă! A apărut o problemă neașteptată la obținerea setărilor din baza de date Cleverence, rezolvați problema și reporniți procesarea!'; ru = 'Работа невозможна! Возникла непредвиденная проблема при получении настроек из базы Клеверенс, устраните проблему и перезапустите обработку!'; tr = 'Çalışma mümkün değil! Cleverence veritabanından ayarları alırken beklenmeyen bir sorun oluştu, sorunu giderin ve işlemi yeniden başlatın!'; uk = 'Робота неможлива! Виникла непередбачена проблема при отриманні налаштувань з бази Cleverence, вирішіть проблему та перезапустіть обробку!'; uz = ""Ish olib bo'lmayapti! Cleverence bazasidan sozlamalarni olishda kutilmagan muammolar paydo bo'ldi, muammalarni bartaraf qiling va ishni qayta boshlang!  """);
		СтруктураЗначения = Новый Структура("Текст, Цвет", ТекстСостояния, УстановитьЦветСтатуса(1));
		СтруктураОшибокСостояний.Вставить(ОперацияПоСменеСтатуса, СтруктураЗначения);
		
	ИначеЕсли СтатусЗапускаОсновнойОбработки="ПрямаяРаботаТСДНеПодключен" Тогда
		ТекстСостояния = НСтр("be = 'Праца немагчыма! Падлучыце Мабільнае прылада да КПК і перазапусціце апрацоўку!'; en = 'Work is not possible! Connect the Mobile device to the PC and restart the processing!'; es = '¡El trabajo no es posible! Conecte el dispositivo móvil a la PC y reinicie el procesamiento!'; ka = 'მუშაობა შეუძლებელია! დაკავშირეთ მობილური მოწყობა კომპიუტერს და გადატვირთეთ დამუშავება!'; kk = 'Жұмыс мүмкін емес! Мобильді құрылғыны ПК-ге қосықтырыңыз және өңдеуін қайта іске қосыңыз!  '; ro = 'Muncă imposibilă! Conectați dispozitivul mobil la PC și reporniți procesarea!'; ru = 'Работа невозможна! Подключите ТСД к ПК и перезапустите обработку!'; tr = 'Çalışma mümkün değil! Mobil cihazı bilgisayara bağlayın ve işlemi yeniden başlatın!'; uk = 'Робота неможлива! Підключіть Мобільний пристрій до ПК та перезапустіть обробку!'; uz = ""Ish olib bo'lmayapti! Mobil qurilmangizni kompyuterga ulang va ishni qayta boshlang!  """);
		СтруктураЗначения = Новый Структура("Текст, Цвет", ТекстСостояния, УстановитьЦветСтатуса(1));
		СтруктураОшибокСостояний.Вставить(ОперацияПоСменеСтатуса, СтруктураЗначения);
		
	ИначеЕсли СтатусЗапускаОсновнойОбработки="РаботаССерверомБазаНедоступна" Тогда
		Если ТипБазы <> "Частная" Тогда
