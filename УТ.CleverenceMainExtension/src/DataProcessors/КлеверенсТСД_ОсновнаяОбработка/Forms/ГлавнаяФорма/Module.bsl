		СтруктураЗначения = Новый Структура("Текст, Цвет", ТекстСостояния, УстановитьЦветСтатуса(1));
		СтруктураОшибокСостояний.Вставить(ОперацияПоСменеСтатуса, СтруктураЗначения);
		
	ИначеЕсли СтатусЗапускаОсновнойОбработки="ПроверкаБезопасностиПройденаПроверямЗапускКомMS" Тогда
		ОбновитьВидимостьЭлементов(Ложь,Истина,Истина);
		ТекстСостояния = НСтр("be = 'Праца немагчыма! COM-кампанента Cleverence не знойдзена. Патрабуецца вырашыць праблему і перазапусціць апрацоўку!'; en = 'Work is not possible! COM component Cleverence not found. Resolve the issue and restart the processing!'; es = '¡El trabajo no es posible! ¡No se encontró el componente COM de Cleverence. Es necesario solucionar el problema y reiniciar el procesamiento!'; ka = 'მუშაობა შეუძლებელია! COM-კომპონენტა Cleverence ვერ მოიძებნა. არსებული პრობლემა უნდა გადაწყვიტოთ და გადატვირთოთ დამუშავება!'; kk = 'Жұмыс мүмкін емес! COM-компоненті Cleverence табылмады. Мәселені шешіп, өңдеуін қайта іске қосыңыз!  '; ro = 'Muncă imposibilă! Componenta COM Cleverence nu a fost găsită. Este necesar să rezolvați problema și să reporniți procesarea!'; ru = 'Работа невозможна! COM-компонента Клеверенс не найдена. Требуется устранить проблему и перезапустить обработку!'; tr = 'Çalışma mümkün değil! COM bileşeni Cleverence bulunamadı. Sorunu gidermek ve işlemi yeniden başlatmak gereklidir!'; uk = 'Робота неможлива! COM-компонента Cleverence не знайдена. Потрібно вирішити проблему та перезапустити обробку!'; uz = ""Ish olib bo'lmayapti! COM-komponenti Cleverence topilmadi. Muammani bartaraf qilish va ishni qayta boshlang!  """);				
