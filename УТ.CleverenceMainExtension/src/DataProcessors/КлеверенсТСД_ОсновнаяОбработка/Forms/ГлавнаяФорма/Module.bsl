// Выгружает список бизнес-процессов в базу SMARTS
&НаКлиенте
Процедура ВыгрузитьБизнесПроцессы()
	
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");	
	Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда			
		Возврат;
	КонецЕсли; 	
	
	ТаблицыMS = _ЛокКонтекст.СтруктураМетаданных.Tables;
	Если _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "БизнесПроцессы") <> Неопределено Тогда
		ИмяТаблицыБП = "БизнесПроцессы";
	Иначе
		ИмяТаблицыБП = "BusinessProcesses";		
	КонецЕсли;
	
	// Выгружаются все строки бизнес процессов, которые имеют статус включен в таблицу БизнесПроцессы базы смартс.
	ТаблицаДляВыгрузки = Новый Массив;
	Для Каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") ИЛИ НЕ СтрокаНастройки.Используется Тогда
			Продолжить;
		КонецЕсли;
		
		Настройка = Новый Структура();
		Если ИмяТаблицыБП = "БизнесПроцессы" Тогда
			Настройка.Вставить("Ид",							СтрокаНастройки.ID_БизнесПроцесса);
			Настройка.Вставить("Наименование",					СтрокаНастройки.Название);
			Настройка.Вставить("ТипДокументаMobileSMARTS",		СтрокаНастройки.ТипДокументаMS);
			Настройка.Вставить("ТипИсходногоДокумента",			СтрокаНастройки.ТипИсходногоДокумента1С);
			Настройка.Вставить("ТипРезультирующегоДокумента",	СтрокаНастройки.ТипРезультирующегоДокумента1С);
		Иначе
			Настройка.Вставить("Id",							СтрокаНастройки.ID_БизнесПроцесса);
			Настройка.Вставить("Name",							СтрокаНастройки.Название);
			Настройка.Вставить("MSDocumentType",				СтрокаНастройки.ТипДокументаMS);
			Настройка.Вставить("SourceDocumentType",			СтрокаНастройки.ТипИсходногоДокумента1С);
			Настройка.Вставить("ResultDocumentType",			СтрокаНастройки.ТипРезультирующегоДокумента1С);
			Настройка.Вставить("Description",					СтрокаНастройки.Комментарий);
		КонецЕсли;
		ТаблицаДляВыгрузки.Добавить(Настройка);
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, ID_ТекущейБазы);
	
КонецПроцедуры	

// Формирует список допустимых ключей параметров запуска программы 1С 
// 
// Параметры:
// 	ПараметрЗапуска - Строка - Параметр запуска
//
// Возвращаемое значение:
// 	Булево - Параметр запуска найден в исклбчениях
&НаКлиенте
Функция ПараметрЗапускаИсключение(ПараметрЗапуска)
	
	СписокИсключений = Новый СписокЗначений;
	СписокИсключений.Добавить("/С ЗапуститьОбновлениеИнформационнойБазы"); //УТАП 10.3 всегда запускает с таким параметром
	СписокИсключений.Добавить("ОбновитьКомпоненту");                       // Далион УМ
	
	
	ЗначениеНайдено = Не (СписокИсключений.НайтиПоЗначению(ПараметрЗапуска) = Неопределено);
	
	Возврат ЗначениеНайдено;
	
КонецФункции

// Формирует структуру с метаданными базы 1С
// 
// Возвращаемое значение:
// 	Структура - структура с метаданными
&НаСервере
Функция ПолучитьДанныеДляПервогоЗапуска()
	
	СисИнфо = Новый СистемнаяИнформация;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПодключеннаяБазаИмяКонфигурации1С",	  СокрЛП(Метаданные.Имя));
	СтруктураПараметров.Вставить("ПодключеннаяБазаСинонимКонфигурации1С", СокрЛП(Метаданные.Синоним)); 
	СтруктураПараметров.Вставить("ПодключеннаяБазаВерсияПлатформы1С",	  СокрЛП(СисИнфо.ВерсияПриложения));
	СтруктураПараметров.Вставить("ПодключеннаяБазаВерсияКонфигурации1С",  СокрЛП(Метаданные.Версия));
	
	Возврат СтруктураПараметров;
	
КонецФункции

// Инициализирует форму локального контекста и заполняет в переменную формы
&НаКлиенте
Процедура СоздатьЛокКонекст()
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		_ЛокКонтекст = Объект.ПолучитьФорму("ОФ_ЛокальныйКонтекст",ЭтаФорма);
	#Иначе
		_ЛокКонтекст = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ЛокальныйКонтекст");
	#КонецЕсли
	_ЛокКонтекст.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	_ЛокКонтекст.ОбъектСсылка 					= ОбъектСсылка;
КонецПроцедуры

// Открывает форму настройки подключения к базе SMARTS
&НаКлиенте
Процедура ОткрытьФормуНастройкиПодключения()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения = ПолучитьФорму("ОФ_ФормаСлужебная_НастройкиПодключения",ЭтаФорма);
	#Иначе
		СтруктураПараметров = Новый Структура;
		ЭтоВебКлиент = Ложь;
		#Если ВебКлиент Тогда
			ЭтоВебКлиент = Истина;
		#КонецЕсли
        СтруктураПараметров.Вставить("ЭтоВебКлиент", ЭтоВебКлиент);

		ФормаНастройкиПодключения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_НастройкиПодключения", СтруктураПараметров, ЭтаФорма, ЭтаФорма);
		ФормаНастройкиПодключения.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ФормаНастройкиПодключения.ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне;
	#КонецЕсли
	
	СтруктураПараметров = Новый Структура("ПараметрыПодключения, Компонента, ТипИнтерфейса, РежимВыбораБазы");
	
	ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
	Если ЕстьЧастнаяБаза Тогда
		// Получаем настройки подключения частной базы из соответствующей переменной
		СтруктураПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("СтруктураПодключенияЧастнойБазыMS");
		Если СтруктураПодключенияMS <> Неопределено Тогда
			СтруктураПараметров.ПараметрыПодключения = СтруктураПодключенияMS.ОписаниеБазы;
		Иначе
			СтруктураПараметров.ПараметрыПодключения = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");
		КонецЕсли;		
	Иначе
		СтруктураПараметров.ПараметрыПодключения	= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");
		СтруктураПараметров.Компонента				= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		СтруктураПараметров.ТипИнтерфейса			= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		СтруктураПараметров.РежимВыбораБазы			= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РежимВыбораБазы");
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ОбновитьИнформациюОРасширенияхПослеЗакрытияФормы", ЭтаФорма);
	
	ФормаНастройкиПодключения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаНастройкиПодключения._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаНастройкиПодключения.БазаСМАРТС 					= ID_ТекущейБазы;
	ФормаНастройкиПодключения.ТипБазы						= ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	ФормаНастройкиПодключения.ПараметрыПодключения			= СтруктураПараметров.ПараметрыПодключения;
	ФормаНастройкиПодключения.Компонента					= СтруктураПараметров.Компонента;
	ФормаНастройкиПодключения.ТипИнтерфейса					= СтруктураПараметров.ТипИнтерфейса;
	ФормаНастройкиПодключения.РежимВыбораБазы				= СтруктураПараметров.РежимВыбораБазы;
	ФормаНастройкиПодключения.ОписаниеОповещенияОЗакрытии	= ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения.ОткрытьМодально();
	#Иначе
		ФормаНастройкиПодключения.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСтруктуруПараметровЗапуска()
	
	СтруктураПараметровЗапуска = Новый Структура;
	
	Если Найти(ВРег(ПараметрЗапуска), "TESTCLIENT") Тогда
		СтруктураПараметровЗапуска.Вставить("ЭтоТестКлиент", Истина);
	КонецЕсли;
	Если Найти(ВРег(ПараметрЗапуска), "НЕЗАПУСКАТЬФОНОВЫЕЗАДАНИЯ") Тогда
		СтруктураПараметровЗапуска.Вставить("НеЗапускатьФоновыеЗадания", Истина);
	Иначе
		СтруктураПараметровЗапуска.Вставить("НеЗапускатьФоновыеЗадания", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПризнакДоступностиВыполненияВФоне()

	_ЛокКонтекст.ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне; // Передаем признак в лок контекст
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", ДоступноВыполнениеВФоне); // Записываем в кэш

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрыПодключения1С(ПервыйЗапуск = Ложь)

	Попытка
		_ЛокКонтекст.ЛокЯдро_ОбновитьПараметрыПодключения1С(ПервыйЗапуск);
	Исключение
		// В старых версиях основной обработки отдельного метода в локальном контексте нет,
		// 	параметры обновляются в процедуре ЛокЯдро_Инициализация().
		//
		// Заглушка необходима для случая, когда при обновлении основной обработки
		//	возникает несоответствие модуля открытой главной формы и локального контекста.
	КонецПопытки;
	
КонецПроцедуры	

&НаСервере
Функция ЕстьПравоАдминистрированияДанных() 
	Возврат ПравоДоступа("АдминистрированиеДанных", Метаданные);
КонецФункции

&НаКлиенте
Процедура ОбновитьИнформациюОРасширениях()
	
	ИнформацияОПодключенныхРасширениях = _ЛокКонтекст.ЛокЯдро_ПолучитьИнформациюОПодключенныхРасширениях();
	ПодключенныеРасширения 	= ИнформацияОПодключенныхРасширениях.ИнформацияТекст;
	ДанныеРасширений 		= ИнформацияОПодключенныхРасширениях.ХешСуммыРасширений;
	
	// Проверка безопасного режима
	СтруктураИменРасширений = _ЛокКонтекст.ЛокЯдро_ПолучитьСтруктуруИменРасширений();
	
	ОсновноеРасширениеИмя = Неопределено;
	Если СтруктураИменРасширений.Свойство("ОсновноеРасширение", ОсновноеРасширениеИмя) Тогда
		ДанныеОсновногоРасширения = ДанныеРасширений.Получить(ОсновноеРасширениеИмя);
	Иначе
		ДанныеОсновногоРасширения = Неопределено;
	КонецЕсли;
	
	Если НЕ ДанныеОсновногоРасширения = Неопределено
		И ДанныеОсновногоРасширения.БезопасныйРежим Тогда
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр",
			"ОсновноеРасширениеВБезопасномРежиме",
			"");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	КонецЕсли;
	//
			
	ТекстОбновленныеРасширения = _ЛокКонтекст.ЛокЯдро_ПроверитьОбновлениеРасширений(ИнформацияОПодключенныхРасширениях);
	
	Если НЕ ПустаяСтрока(ТекстОбновленныеРасширения) Тогда
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр",
			"ТребуетсяПерезапускДляПримененияРасширений",
			"");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		Если НЕ Найти(ПараметрЗапуска, "КлеверенсАвтотесты.") Тогда
			ПоказатьПредупреждениеОбОбновленииРасширений(ТекстОбновленныеРасширения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеОбОбновленииРасширений(ТекстПодключенныеРасширения)

	Если ВыполнениеВнешнейКоманды = Истина Тогда
		// При работе с кнопками просто выводим сообщение о необходимости перезапуска
		ТекстСообщения = НСтр("ru = 'Требуется перезапуск программы 1С для применения подключенных расширений.'; en = 'Restart of 1C program is required to apply connected extensions.'; kk = '1С программасын қайта іске қосу үшін қосылған кеңейтімдерді қолдану үшін 1С программасын қайта іске қосу қажет.'; uz = ""Qo'llanilayotgan kengaytmalarni qo'llash uchun 1C dasturini qayta ishga tushirish talab qilinadi.""; be = 'Патрабуецца перазапуск праграмы 1С для ўплыву падключаных пашырэнняў.'; uk = 'Потрібен перезапуск програми 1С для застосування підключених розширень.'; ka = '1C პროგრამის გადატვირთვისას გადასამართავი გადასაჭირავება'; tr = 'Uzantıların uygulanabilmesi için 1C programının yeniden başlatılması gerekmektedir.'; es = 'Se requiere reiniciar el programa 1C para aplicar las extensiones conectadas.'; ro = 'Este necesar să reporniți programul 1C pentru a aplica extensiile conectate.'");
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
	Иначе
		ТекстПредупрежденияНачало = НСтр("ru = 'Были загружены новые расширения:'; en = 'New extensions have been loaded:'; kk = 'Были загружены новые расширения - Жаңа кеңейтімдер жүктелді'; uz = 'Yangi kengaytma yuklandi:'; be = 'Былі загружаныя новыя пашырэнні'; uk = 'Були завантажені нові розширення:'; ka = 'ახალი გაფართოებები ჩაიტვირთეს:'; tr = 'Yeni uzantılar yüklendi:'; es = 'Se han cargado nuevas extensiones'; ro = 'Au fost descărcate noi extensii:'");
		ТекстПредупрежденияКонец  = НСтр("ru = 'Перезапустить программу 1С с учетом сделанных изменений?'; en = 'Restart 1C program considering the changes made?'; kk = '1С программасын өзгертулерді есептей отырып қайта іске қосу керек пе?'; uz = '1С дастурини ўзгартиришларни қабул қилиб, янгидан ёқиш керакми?'; be = 'Перазапусціць праграму 1С з улікам зробленых зменаў?'; uk = 'Перезапустити програму 1С з урахуванням внесених змін?'; ka = '1C პროგრამის გადასაშვება შეცვლილი შეცდომების შესახებ?'; tr = 'Yapılan değişikliklerle birlikte 1C programını yeniden başlatmak istiyor musunuz?'; es = '¿Reiniciar el programa 1C teniendo en cuenta los cambios realizados?'; ro = 'Reinițializați programul 1C cu modificările efectuate în vedere?'");
		ТекстПредупреждения 	  
			= ТекстПредупрежденияНачало
			+ ТекстПодключенныеРасширения
			+ Символы.ПС
			+ Символы.ПС
			+ ТекстПредупрежденияКонец;
				
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПерезапускПрограммыПослеОтветаНаВопрос", ЭтаФорма);
				
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, 	 "Перезапустить");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			
		ПоказатьВопрос(ОписаниеОповещения, ТекстПредупреждения, СписокКнопок,, КодВозвратаДиалога.Да, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЗапускПоИмениФайлаПараметрЗапуска(ИмяФайла)

	СтрокаЗапуска = "";
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат СтрокаЗапуска;
	КонецЕсли;
	
	ПроверяемыеСтроки = Новый Массив;
	ПроверяемыеСтроки.Добавить("КлеверенсТСД_ОсновнаяОбработка_");
	ПроверяемыеСтроки.Добавить("CleverencePDT_MainDataProcessor_");
	
	Для каждого ПроверяемаяСтрока ИЗ ПроверяемыеСтроки Цикл
		Позиция = Найти(ИмяФайла, ПроверяемаяСтрока);
		Если Позиция Тогда
			Попытка
				СтрокаПараметры = _ЛокКонтекст.ЛокЯдро_СтрокаИзBase64(
					СтрЗаменить(Сред(ИмяФайла, Позиция + СтрДлина(ПроверяемаяСтрока)), ".epf", ""));
			Исключение
				Продолжить;
			КонецПопытки;
					
			СтрокаBaseId = "";
			СтрокаTempuid = "";
						
			ПозицияCloud = Найти(СтрокаПараметры, "cloud_");
			Если ПозицияCloud Тогда
				СтрокаBaseId = Сред(СтрокаПараметры, ПозицияCloud + 6);
			Иначе
				ПозицияClgt = Найти(СтрокаПараметры, "clgt_");
				Если ПозицияClgt Тогда
					СтрокаBaseId = Сред(СтрокаПараметры, ПозицияClgt + 5);
				КонецЕсли;	
			КонецЕсли;
					
			Если НЕ ПустаяСтрока(СтрокаBaseId) Тогда
				Позиция_ = Найти(СтрокаBaseId, "_");
				Если Позиция_ Тогда
					СтрокаTempuid = Сред(СтрокаBaseId, Позиция_ + 1);
					СтрокаBaseId = Лев(СтрокаBaseId, Позиция_ - 1);
				КонецЕсли;
						
				СтрокаЗапуска = _ЛокКонтекст.ЛокЯдро_СтрШаблон("%1|https://%2.cleverence.ru/%3%4",
					СтрокаBaseId,
					?(ПозицияCloud, "cloud", "clgt"),
					СтрокаBaseId,
					?(ПустаяСтрока(СтрокаTempuid), "", "?tempuid=" + СтрокаTempuid));
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокаЗапуска;	
	
КонецФункции

&НаКлиенте
Процедура ЗапускПоИмениФайлаПроверкаПодключения(пПараметрЗапуска)

	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	СохраненныеПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");
	
	СтрокиПодключенияСовпадают = Ложь;
	
	Если НЕ СохраненныеПараметрыПодключенияMS = Неопределено
		И ТипЗнч(СохраненныеПараметрыПодключенияMS) = Тип("Структура") Тогда
		
		Позиция = Найти(пПараметрЗапуска, "|");
		Если Позиция И НЕ Лев(пПараметрЗапуска, Позиция - 1) = "" Тогда
			МассивПараметров = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(пПараметрЗапуска, "|");
			
			Для каждого пПараметр ИЗ МассивПараметров Цикл
				ПроверяемаяСтрока = пПараметр;
				
				ПозицияTempuid = Найти(ПроверяемаяСтрока, "?tempuid");
				Если ПозицияTempuid Тогда
					ПроверяемаяСтрока = Сред(ПроверяемаяСтрока, 1, ПозицияTempuid - 1);
				КонецЕсли;
				
				Если _ЛокКонтекст.ЛокЯдро_СтрокиПодключенияСовпадают(СохраненныеПараметрыПодключенияMS.СтрокаПодключения, ПроверяемаяСтрока) Тогда
			    	СтрокиПодключенияСовпадают = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокиПодключенияСовпадают Тогда
		РасположениеКомпоненты = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
			
		Если РасположениеКомпоненты = Неопределено Тогда
			РасположениеКомпоненты = "НаСервере";
		КонецЕсли;
			
		#Если ВебКлиент тогда
			РасположениеКомпоненты = "НаСервере";
		#КонецЕсли
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрЗапуска", 		пПараметрЗапуска);
		ДополнительныеПараметры.Вставить("ПараметрыПодключенияMS", 	СохраненныеПараметрыПодключенияMS);
		ДополнительныеПараметры.Вставить("РасположениеКомпоненты", 	РасположениеКомпоненты);
		
		ОП = Новый ОписаниеОповещения("ЗапускПоИмениФайлаПослеПроверкиПодключения", ЭтаФорма, ДополнительныеПараметры);
			
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", "Начало", НачалоСобытия);
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СохраненныеПараметрыПодключенияMS, Ложь,, РасположениеКомпоненты,,, ОП);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", "Конец", НачалоСобытия);
	Иначе
		ДействияПриОткрытииФормыПервыйЗапуск(пПараметрЗапуска);
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗапускПоИмениФайлаПослеПроверкиПодключения(СерверДоступен, ДополнительныеПараметры) Экспорт

	Если СерверДоступен = Истина Тогда
		ПараметрыПодключенияMS = ДополнительныеПараметры.ПараметрыПодключенияMS;
		РасположениеКомпоненты = ДополнительныеПараметры.РасположениеКомпоненты;
			
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", 	ПараметрыПодключенияMS);
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("РасположениеКомпоненты",	РасположениеКомпоненты);
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса",			"REST_API");
			
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"НачалоВыполненияПроцедурыЗапускаОбработки", 
			, 
			"ЗапускОсновнойОбработки");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		ДействияПередОткрытиемФормыПослеПроверкиПодключения(СерверДоступен, ДополнительныеПараметры);
	Иначе
		ДействияПриОткрытииФормыПервыйЗапуск(ДополнительныеПараметры.ПараметрЗапуска);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область ВспомогательныеМеханизмы_РаботаСФормой

&НаКлиенте
Процедура ДействияПриОткрытииФормыПервыйЗапуск(пПараметрЗапуска)

	ИмяСобытия = "ДействияПриОткрытииФормыПервыйЗапуск";
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПервыйЗапуск", "Предупреждение", "Параметр запуска: " + СокрЛП(пПараметрЗапуска));
		
	// "Первый запуск"
	Позиция = Найти(пПараметрЗапуска, "|");
	Если Позиция > 0 И НЕ Лев(пПараметрЗапуска, Позиция - 1) = "" Тогда
		МассивПараметров = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(пПараметрЗапуска, "|");
	Иначе
		МассивПараметров = Новый Массив;
	КонецЕсли;
	
	Если МассивПараметров.Количество() > 0 Тогда
		ID_ТекущейБазы = МассивПараметров[0];
	Иначе
		ID_ТекущейБазы = пПараметрЗапуска;
	КонецЕсли;
		
	URIБазы = Неопределено;
	ДоступноВыполнениеВФоне = Ложь; // При первом запуске не используем фоновые задания
	ЗаписатьПризнакДоступностиВыполненияВФоне();
		
	// Для REST приоритетным является подключение с сервера, для COM - с клиента
	МассивОткудаПодключаемся = Новый Массив;
	МассивОткудаПодключаемся.Добавить(Новый Структура("REST_API", "НаСервере")); //  , COM  , "НаКлиенте"
	МассивОткудаПодключаемся.Добавить(Новый Структура("REST_API", "НаКлиенте")); // , COM , "НаСервере"
		
	Для каждого СтруктураРасположениеКомпоненты ИЗ МассивОткудаПодключаемся Цикл
		Для каждого пПараметр Из МассивПараметров Цикл
					
			Если НЕ ТекущаяБазаСуществует Тогда
				ПодключениеREST_API = Ложь;
				Попытка
					СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(пПараметр);
					Если НЕ ЗначениеЗаполнено(СтруктураURI.Схема) Тогда
						Продолжить;
					ИначеЕсли Найти(ВРег(СтруктураURI.Схема), "HTTP") <> 0 Тогда
						// Если в строке подключения есть http, то это НЕ прямая работа, подключаемся через REST
						ПодключениеREST_API = Истина;
					Иначе
						Продолжить;
					КонецЕсли;
					ПутьНаСервере = СтруктураURI.ПутьНаСервере;
					Поз = Найти(ПутьНаСервере, "?");
					ПутьНаСервере = ?(Поз > 0, Лев(ПутьНаСервере, Поз - 1), ПутьНаСервере);
					
				    МассивХостов = СтруктураURI.МассивХостов;
					Для каждого Хост Из МассивХостов Цикл
						URIБазы = СтруктураURI.Схема + "://" + Хост + ?(ЗначениеЗаполнено(СтруктураURI.Порт), ":" + Формат(СтруктураURI.Порт, "ЧГ="), "") + ?(ЗначениеЗаполнено(ПутьНаСервере), "/" + ПутьНаСервере, "") + ?(ЗначениеЗаполнено(СтруктураURI.TempUid), "?tempuid=" + СтруктураURI.TempUid, "");
							
						ТипИнтерфейса	= ?(ПодключениеREST_API, "REST_API", "COM");
						РежимВыбораБазы = "СтрокаПодключения";
						РасположениеКомпоненты 	= СтруктураРасположениеКомпоненты[ТипИнтерфейса];
						
						СтруктураПодключения = Новый Структура;
						СтруктураПодключения.Вставить("ТипБазы",						"Основная");
						СтруктураПодключения.Вставить("СтрокаПодключения",				URIБазы);
						СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",		URIБазы);
						СтруктураПодключения.Вставить("IdBaseSMARTS",					ID_ТекущейБазы);
						СтруктураПодключения.Вставить("ТипИнтерфейса",					ТипИнтерфейса);
						СтруктураПодключения.Вставить("РежимВыбораБазы",				РежимВыбораБазы);
						СтруктураПодключения.Вставить("TempUid",						СтруктураURI.TempUid);
						СтруктураПодключения.Вставить("РасположениеКомпоненты",			РасположениеКомпоненты);
						СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С", 	Истина);
						
						_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", "Начало, первый запуск, " + ТипИнтерфейса + ", " + РасположениеКомпоненты, НачалоСобытия);
						Результат = _ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СтруктураПодключения, Истина, "Основная", РасположениеКомпоненты, Ложь, ЗапускПоИмениФайла);
						_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", "Конец, первый запуск, " + ТипИнтерфейса + ", " + РасположениеКомпоненты, НачалоСобытия);
									
						Если Результат = Истина Тогда
							REST_СовместимостьПлатформы = ?(ПодключениеREST_API, _ЛокКонтекст.ЛокЯдро_ПроверитьСовместимостьПлатформы(СтруктураПодключения, РасположениеКомпоненты), Истина);
							Если REST_СовместимостьПлатформы Тогда
								_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПервыйЗапуск", "Предупреждение", "Выполнено подключение по строке: " + СокрЛП(пПараметр) + ", " + ТипИнтерфейса + ", " + РасположениеКомпоненты);
								
								ТекущаяБазаСуществует = Истина;
								Прервать;	
							КонецЕсли;
						КонецЕсли;
					КонецЦикла; // Цикл по хостам
				Исключение
					_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", 
						_ЛокКонтекст.ЛокЯдро_СтрШаблон("Ошибка при проверке соединения с базой Mobile SMARTS: %1, %2, %3",
							ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
							ТипИнтерфейса,
							РасположениеКомпоненты),
						НачалоСобытия);
				КонецПопытки;
			КонецЕсли;
			
			Если ТекущаяБазаСуществует Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла; // Цикл по строкам подключения
			
		Если ТекущаяБазаСуществует Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;	// Цикл по расположению компоненты
		
	Если ТекущаяБазаСуществует Тогда
		Если НЕ СтруктураОшибокСостояний.Свойство("ОшибкаАвторизации") Тогда
			ДействияПриОткрытииФормыПервыйЗапускПослеПроверкиПодключения(РежимВыбораБазы);
		Иначе
			КлючПеременной = "СтруктураПодключенияБазыMS";
			Если ТипИнтерфейса = "REST_API" Тогда
				КлючПеременной = "REST_API_" + КлючПеременной;
			КонецЕсли;
			
			// Сохраняем структуру подключения в кэше для последующего завершения авторизации
			_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, СтруктураПодключения);
		КонецЕсли;
	Иначе
		Сообщение = НСтр("be = 'База з такім ідэнтыфікатарам [%1] не знойдзеная!'; en = 'Database with identifier [%1] not found!'; es = '¡No se encontró la base de datos con ese identificador [%1]!'; ka = 'ასეთი იდენტიფიკატორით [%1] ბაზა არ მოიძებნა!'; kk = 'Мұндай ID-мен база [%1] табылмады!  '; ro = 'Baza de date cu acest identificator [%1] nu a fost găsită!'; ru = 'База с таким идентификатором [%1] не найдена!'; tr = 'Bu kimlikle veritabanı [%1] bulunamadı!'; uk = 'База з таким ідентифікатором [%1] не знайдена!'; uz = '[%1] identifikatoriga ega bazasi topilmadi!  '");
		Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ID_ТекущейБазы);
		Сообщить(Сообщение); 
		
		СерверДоступен = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриОткрытииФормыПервыйЗапускПослеПроверкиПодключения(РежимВыбораБазы)

	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	_ЛокКонтекст.ЛокЯдро_ОчиститьХранилищеОбщихНастроек1С();
	
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_РасположениеКомпоненты", РасположениеКомпоненты);
		
	_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПолучитьОписаниеБазыSMARTS", "Информация", "Начало", НачалоСобытия);
	ТекущаяБаза = _ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеБазыSMARTS(РасположениеКомпоненты, "Основная", ТипИнтерфейса);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПолучитьОписаниеБазыSMARTS", "Информация", "Конец", НачалоСобытия);
			
	ПараметрыПодключенияMS = Новый Структура;
	ПараметрыПодключенияMS.Вставить("Ид", 							ТекущаяБаза.Ид);
	ПараметрыПодключенияMS.Вставить("Имя", 							ТекущаяБаза.Имя);
	ПараметрыПодключенияMS.Вставить("ИдПриложения", 				ТекущаяБаза.ИдПриложения);			
	ПараметрыПодключенияMS.Вставить("ИмяПриложения", 				ТекущаяБаза.ИмяПриложения);
	ПараметрыПодключенияMS.Вставить("УровеньПриложения", 			ТекущаяБаза.УровеньПриложения);
	ПараметрыПодключенияMS.Вставить("СтрокаПодключения", 			ТекущаяБаза.СтрокаПодключения);
	ПараметрыПодключенияMS.Вставить("ИдОсновногоПриложения", 		ТекущаяБаза.ИдОсновногоПриложения);
	ПараметрыПодключенияMS.Вставить("РабочийКаталог", 				ТекущаяБаза.РабочийКаталог);
	ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",	ТекущаяБаза.ИмяИнтеграционнойОбработки);
	ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки",	ТекущаяБаза.ПутьИнтеграционнойОбработки);
	ПараметрыПодключенияMS.Вставить("ТипОбработки",					?(ТекущаяБаза.Свойство("ТипОбработки"), ТекущаяБаза.ТипОбработки, "ФайлНаДиске"));
	ПараметрыПодключенияMS.Вставить("ТипОсновнойОбработки",			?(ТекущаяБаза.Свойство("ТипОсновнойОбработки"), ТекущаяБаза.ТипОсновнойОбработки, Неопределено));
	ПараметрыПодключенияMS.Вставить("ПутьОсновнойОбработки",		?(ТекущаяБаза.Свойство("ПутьОсновнойОбработки"), ТекущаяБаза.ПутьОсновнойОбработки, Неопределено));			
			
	ИнформацияОПродукте = _ЛокКонтекст.ЛокЯдро_ПолучитьИнформациюОПродукте(ТекущаяБаза.ИдПриложения, ТекущаяБаза.ИдОсновногоПриложения);
		
	ПараметрыПодключенияMS.Вставить("УровеньПриложенияСтрокой",		?(ЗначениеЗаполнено(ИнформацияОПродукте.УровеньПриложения), ИнформацияОПродукте.УровеньПриложения, _ЛокКонтекст.ЛокЯдро_ПолучитьУровеньПриложения(ТекущаяБаза.УровеньПриложения)));
	ПараметрыПодключенияMS.Вставить("ТипУстановленногоПродукта",	ИнформацияОПродукте.ТипУстановленногоПродукта);
	ПараметрыПодключенияMS.Вставить("АвторизацияВключена", 			ТекущаяБаза.АвторизацияВключена);
	ПараметрыПодключенияMS.Вставить("АвторизацияТокен", 			ТекущаяБаза.АвторизацияТокен);
	ПараметрыПодключенияMS.Вставить("АвторизацияРефрешТокен",		ТекущаяБаза.АвторизацияРефрешТокен);
	ПараметрыПодключенияMS.Вставить("СтрокаПодключенияСМАРТС",		ТекущаяБаза.СтрокаПодключения);
	ПараметрыПодключенияMS.Вставить("IdBaseSMARTS", 				ТекущаяБаза.Ид);
	ПараметрыПодключенияMS.Вставить("QR", 							ТекущаяБаза.QR);
	ПараметрыПодключенияMS.Вставить("ВерсияПриложения", 			ТекущаяБаза.ВерсияПриложения);
	ПараметрыПодключенияMS.Вставить("ВерсияКонфигурацииSMARTS",		ТекущаяБаза.ВерсияКонфигурацииSMARTS);
	ПараметрыПодключенияMS.Вставить("ВерсияПлатформыSMARTS",		ТекущаяБаза.ВерсияПлатформыSMARTS);
			
	// Запоминаем, что выполнена авторизация по темпуид
	Если ПараметрыПодключенияMS["АвторизацияВключена"] = Истина Тогда
		Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ПараметрыПодключенияMS["СтрокаПодключения"], "tempuid") Тогда
			ПараметрыПодключенияMS.Вставить("АвторизацияТип", "tempuid")
		Иначе
			ПараметрыПодключенияMS.Вставить("АвторизацияТип", "login")
		КонецЕсли;
	КонецЕсли;
			
	// Очищаем из сохраняемой строки подключения дополнительные параметры
	РедактируемыеПоля = Новый Массив;
	РедактируемыеПоля.Добавить("СтрокаПодключения");
	РедактируемыеПоля.Добавить("СтрокаПодключенияСМАРТС");
	Для каждого РедактируемоеПоле ИЗ РедактируемыеПоля Цикл
		ПозицияСтрокиПоиска = _ЛокКонтекст.ЛокЯдро_СтрНайти(ПараметрыПодключенияMS[РедактируемоеПоле], "?");
		Если ПозицияСтрокиПоиска Тогда
			ПараметрыПодключенияMS[РедактируемоеПоле] = Лев(ПараметрыПодключенияMS[РедактируемоеПоле], ПозицияСтрокиПоиска - 1);
		КонецЕсли;
	КонецЦикла;
			
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПараметрыПодключенияMS", ПараметрыПодключенияMS);
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_РежимВыбораБазы", РежимВыбораБазы);
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ТипИнтерфейса", ТипИнтерфейса);
			
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("РасположениеКомпоненты",РасположениеКомпоненты);
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса",ТипИнтерфейса);
			
	ДопПараметры = Новый Структура("ПараметрыПодключенияMS, ТекущаяБаза",
		ПараметрыПодключенияMS, ТекущаяБаза);
	ОП = Новый ОписаниеОповещения("ДействияПередОткрытиемФормыПервыйЗапуск", ЭтаФорма, ДопПараметры);
				
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ПараметрыПодключенияMS, Ложь,, РасположениеКомпоненты,,, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриОткрытииФормы(СерверДоступен, РезультатПодключенияИнтеграционнойОбработки, СтрокаБазы)
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Инициализируем отдельную переменную ВыполняетсяВФоне, 
	// т.к. в процессе выполнения ФЗ при ошибке мы можем поменять значение переменной ДоступноВыполнениеВФоне
	ВыполняетсяВФоне = ДоступноВыполнениеВФоне;	
	ИнициализацияВФоне = РасположениеКомпоненты = "НаСервере"; // Пока в фоне инициализируем только при серверной компоненте
	ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СерверДоступен", 								СерверДоступен);
	ДополнительныеПараметры.Вставить("РезультатПодключенияИнтеграционнойОбработки", РезультатПодключенияИнтеграционнойОбработки);
	ДополнительныеПараметры.Вставить("СтрокаБазы", 									СтрокаБазы);
	ДополнительныеПараметры.Вставить("НачалоСобытия", 								НачалоСобытия);
	ДополнительныеПараметры.Вставить("ПараметрыПодключенияMS", 						ПараметрыПодключенияMS);
	ДополнительныеПараметры.Вставить("ИзменитьТекущиеНастройкиMS", 					Ложь);
	
	Если  _ЛокКонтекст.ЛокЯдро_ПроверитьСозданиеКОМОбъекта() = Истина Тогда	
		Если ТекущаяБазаСуществует Тогда		
			Если СерверДоступен <> Неопределено И СерверДоступен Тогда 
				Если НЕ _ЛокКонтекст.НастройкиИнициализированы = Истина Тогда
					ДополнительныеПараметры.Вставить("ИзменитьТекущиеНастройкиMS", 	Истина);
					ОписаниеОповещения = Неопределено;
					Если ВыполняетсяВФоне И
						ИнициализацияВФоне Тогда
						// Метод из описания оповещения будет вызван после выполнения фонового задания
						// т.к. после выполнения ФЗ будут получены все настройки
						ОписаниеОповещения = Новый ОписаниеОповещения("ДействияПриОткрытииФормыЗавершение", ЭтаФорма, ДополнительныеПараметры);
					КонецЕсли;
					_ЛокКонтекст.ЛокЯдро_Инициализация(, ОписаниеОповещения);
				КонецЕсли;
			ИначеЕсли ВыполнениеВнешнейКоманды = Истина Тогда
				ОповещениеВопросОткрытьГлавнуюФорму = Новый ОписаниеОповещения("ВопросОткрытьГлавнуюФормуЗавершение", ЭтаФорма);
				ТекстВопроса = НСтр("be = 'Памылка злучэння з серверам Cleverence. Адкрыць апрацоўку для налады падключэння?'; en = 'Connection error with Cleverence server. Open processing to configure the connection?'; es = 'Error de conexión al servidor de Cleverence. ¿Abrir el procesamiento para configurar la conexión?'; ka = 'Cleverence სერვერთან კავშირის შეცდომა. გსურთ პარამეტრების კავშირის დაყენების პროცესის გახსნა?'; kk = 'Cleverence серверімен қосылымды қатесі. Қосылымды орнату үшін өңдеу ашу керек пе?'; ro = 'Eroare de conectare la serverul Cleverence. Deschideți procesul pentru a configura conexiunea?'; ru = 'Ошибка соединения с сервером Клеверенс. Открыть обработку для настройки подключения?'; tr = 'Cleverence sunucusuyla bağlantı hatası. Bağlantıyı yapılandırmak için işlem açılsın mı?'; uk = ""Помилка з'єднання з сервером Cleverence. Відкрити обробку для налаштування підключення?""; uz = 'Cleverence серверига улашниш хатоси. Улашни ёритиш учун обработка очилсинми?'");
				ПоказатьВопрос(ОповещениеВопросОткрытьГлавнуюФорму, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
			КонецЕсли;
		Иначе
			Если Не ВыполнениеВнешнейКоманды = Истина Тогда
				ОткрытьФормуНастройкиПодключения();
						
				Сообщение = Новый СообщениеПользователю;
				ТекстСообщения = НСтр("be = 'Атрымаць дадзеныя канфігурацыі з падлучанай базы Cleverence не ўдалося.'; en = 'Failed to retrieve configuration data from the connected Cleverence database.'; es = 'No se pudieron obtener los datos de configuración de la base de Cleverence conectada.'; ka = 'Cleverence შეერთებული ბაზიდან კონფიგურაციის მონაცემების მიღება ვერ ხელისუფლდა.'; kk = 'Қосылған Cleverence базасынан конфигурация деректерін алу мүмкін болмады.'; ro = 'Nu s-a putut obține datele de configurare din baza de date Cleverence conectată.'; ru = 'Получить данные конфигурации из подключенной базы Клеверенс не удалось.'; tr = 'Bağlı Cleverence veritabanından yapılandırma verileri alınamadı.'; uk = 'Отримати дані конфігурації з підключеної бази Cleverence не вдалося.'; uz = ""Ulanish qatoridan Cleverence ulanish bazasidan konfiguratsiya ma'lumotlarini olish muvaffaqiyatsiz""")
								+ Символы.ПС
								+ ?(_ЛокКонтекст.ПараметрыПодключенияMS <> Неопределено, Символы.ПС + """" + ИмяТекущейБазы + """, """ + _ЛокКонтекст.ПараметрыПодключенияMS.СтрокаПодключения + """", "")
								+ Символы.ПС
								+ НСтр("be = 'Калі памылка паўтараецца, звярніцеся ў тэхнічную падтрымку Cleverence'; en = 'If the error persists, contact Cleverence technical support'; es = 'Si el error persiste, contacte al soporte técnico de Cleverence'; ka = 'თუ შეცდომა განმერიდება, გთხოვთ, დაგვიკავშირდეთ Cleverence-ის ტექნიკურ მხარდაჭერაში'; kk = 'Қателік кейіп кетсе, Cleverence техникалық қолдауға хабарласыңыз'; ro = 'Dacă eroarea persistă, contactați suportul tehnic Cleverence'; ru = 'Если ошибка повторяется обратитесь в техническую поддержку Клеверенс'; tr = 'Hata devam ederse Cleverence teknik destek birimine başvurun'; uk = 'Якщо помилка повторюється, зверніться в технічну підтримку Cleverence'; uz = 'Хатолик кейингида, Cleverence техник дастурдаги техник дастурга мурожаат қилинг'")
								+ Символы.ПС
								+ "https://cleverence.ru/sd";
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить(); 
				Элементы.ВыбратьБазу.Видимость = Истина;
			Иначе
				ОповещениеВопросОткрытьГлавнуюФорму = Новый ОписаниеОповещения("ВопросОткрытьГлавнуюФормуЗавершение", ЭтаФорма);
				ТекстВопроса = НСтр("be = 'Памылка злучэння з базай Cleverence. Адкрыць апрацоўку для налады падключэння?'; en = 'Connection error with Cleverence database. Open processing to configure the connection?'; es = 'Error de conexión a la base de datos de Cleverence. ¿Abrir el procesamiento para configurar la conexión?'; ka = 'Cleverence ბაზასთან კავშირის შეცდომა. გსურთ პარამეტრების კავშირის დაყენების პროცესის გახსნა?'; kk = 'Cleverence базасымен қосылымды қатесі. Қосылымды орнату үшін өңдеу ашу керек пе?'; ro = 'Eroare de conectare la baza de date Cleverence. Deschideți procesul pentru a configura conexiunea?'; ru = 'Ошибка соединения с базой Клеверенс. Открыть обработку для настройки подключения?'; tr = 'Cleverence veritabanıyla bağlantı hatası. Bağlantıyı yapılandırmak için işlem açılsın mı?'; uk = ""Помилка з'єднання з базою Cleverence. Відкрити обробку для налаштування підключення?""; uz = 'Cleverence базаси билан улашиш хатоси. Улашни ёритиш учун обработка очилсинми?'");
				ЗаголовокВопроса = НСтр("be = 'Увага'; en = 'Attention'; es = 'Atención'; ka = 'ყურადღება'; kk = 'Ескерту'; ro = 'Atentie'; ru = 'Внимание'; tr = 'Dikkat'; uk = 'Увага'; uz = 'Эътибор'");
				ПоказатьВопрос(ОповещениеВопросОткрытьГлавнуюФорму, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса); 
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли СерверДоступен = Неопределено Тогда
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"КоннекторMSСозданПроверяемДоступностьБазы", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		Если Не ВыполнениеВнешнейКоманды = Истина Тогда
			ОткрытьФормуНастройкиПодключения();
		КонецЕсли;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("be = 'Не ўдалося падключыць знешнюю кампаненту. Калі ласка, упэўніцеся, што на кампутары ўстаноўлена платформа Cleverence і зарэгістравана знешняя кампанента.'; en = 'Failed to connect external component. Please ensure that the Cleverence platform is installed on the computer and the external component is registered.'; es = 'No se pudo conectar el componente externo. Por favor, asegúrese de que la plataforma Cleverence esté instalada en la computadora y el componente externo esté registrado.'; ka = 'გარე კომპონენტის შეერთება ვერ ხდება. გთხოვთ, დარეგისტრირეთ კლევერენსის პლატფორმა და გარე კომპონენტი.'; kk = 'Сыртқы құрылғыны қосу мүмкін емес. Сенімді болыңыз, компьютерде Cleverence платформасы орнатылған және сыртқы құрылғысы тіркелген болуы керек.'; ro = 'Nu s-a putut conecta componenta externă. Vă rugăm să vă asigurați că platforma Cleverence este instalată pe computer și componenta externă este înregistrată.'; ru = 'Не удалось подключить внешнюю компоненту. Пожалуйста, убедитесь, что на компьютере установлена платформа Клеверенс и зарегистрирована внешняя компонента.'; tr = 'Harici bileşen bağlanamadı. Lütfen, Cleverence platformunun bilgisayarınıza yüklü ve harici bileşenin kayıtlı olduğundan emin olun.'; uk = ""Не вдалося підключити зовнішню компоненту. Будь ласка, переконайтеся, що на комп'ютері встановлена платформа Cleverence і зареєстрована зовнішня компонента.""; uz = 'Ташқи компонентга уланмаслик. Илтимос, компьютерда Cleverence платформасини ўрнатилганлигига ва ташқи компонентга рўйхатдан ўтилганлигига ишонинг.'")
							+ Символы.ПС
							+ НСтр("be = 'Варыянты рашэнняў'; en = 'Solution options:'; es = 'Opciones de solución'; ka = 'გადამხდელი ვარიანტები:'; kk = 'Варианты решения - Шешу варианттары'; ro = 'Opțiuni de rezolvare:'; ru = 'Варианты решения:'; tr = 'Çözüm seçenekleri:'; uk = 'Варіанти рішення:'; uz = 'Yechim variantlari:'")
							+ Символы.ПС
							+ НСтр("be = '1) Зарэгістраваць знешнюю кампаненту [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\Зарэгістраваць COM.bat]'; en = '1) Register an external component [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\Register COM.bat]'; es = '1) Registrar el componente externo [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\Registrar COM.bat]'; ka = '1) დარეგისტრირება გარე კომპონენტა [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\რეგისტრაცია COM.bat]'; kk = '1) Сыртқы компонентті тіркеу [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\COM-ді тіркеу.bat]'; ro = '1) Înregistrați componenta externă [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\Înregistrare COM.bat]'; ru = '1) Зарегистрировать внешнюю компоненту [C:\Program Files (x86)\Cleverence Soft\Mobile SMARTS\Connectivity\Зарегистрировать COM.bat]'; tr = '1) Dış bileşeni kaydet [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\COM.bat]'; uk = '1) Зареєструвати зовнішню компоненту [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\Зареєструвати COM.bat]'; uz = '1) Ташқи компонентни рўйхатга олиш [C:\Program Files (x86)\Cleverence Soft\Cleverence\Connectivity\COMни рўйхатга олиш.bat]'")
							+ Символы.ПС
							+ НСтр("be = '2) Усталяваць/пераўсталёўваць платформу Cleverence'; en = '2) Install/reinstall Cleverence platform'; es = '2) Instalar/reinstalar la plataforma Cleverence'; ka = '2) დაყენება/გადაყვანა პლატფორმა Cleverence'; kk = '2) Cleverence платформасын орнату/қайта орнату'; ro = '2) Instalați/reinstalați platforma Cleverence'; ru = '2) Установить/переустановить платформу Клеверенс'; tr = '2) Cleverence platformunu yükle/yeniden yükle'; uk = '2) Встановити/перевстановити платформу Cleverence'; uz = '2) Cleverence платформасини ўрнатиш/янгилаш'")
							+ Символы.ПС
							+ НСтр("be = '3) Звярнуцца ў тэхнічную падтрымку па адрасе [https://cleverence.ru/sd]'; en = '3) Contact technical support at [https://cleverence.ru/sd]'; es = '3) Contactar al soporte técnico en la dirección [https://cleverence.ru/sd]'; ka = '3) გამოიყენეთ ტექნიკური მხარდაჭერა მისამართზე [https://cleverence.ru/sd]'; kk = '3) Техникалық қолдауға [https://cleverence.ru/sd] мүрж'; ro = '3) Contactați suportul tehnic la adresa [https://cleverence.ru/sd]'; ru = '3) Обратиться в техническую поддержку по адресу [https://cleverence.ru/sd]'; tr = '3) [https://cleverence.ru/sd] adresine teknik destek için başvurun'; uk = '3) Звернутися в технічну підтримку за адресою [https://cleverence.ru/sd]'; uz = '3) Техник дастурлаш қўмитасига мурожаат қилинг [https://cleverence.ru/sd]'");
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить(); 
	КонецЕсли;			
	
	// Сделан вызов отдельной процедуры для работы фоновых заданий, через вызов описания оповещения
	Если Не (ВыполняетсяВФоне И ИнициализацияВФоне) Тогда
		ДействияПриОткрытииФормыЗавершение(, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

// Обновляет выпадающий список выбора текущего узла, всеми доступными узлами 
&НаКлиенте 
Процедура УстановитьСписокВыбораУзлов()
	
	Элементы.ID_ТекущегоУзла.СписокВыбора.Очистить();
	
	ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			Конецесли;
			Элементы.ID_ТекущегоУзла.СписокВыбора.Добавить(СтрокаУзла.ID_Узла, СтрокаУзла.Наименование);
		КонецЦикла;
		Элементы.ID_ТекущегоУзла.СписокВыбора.СортироватьПоПредставлению();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокФормы()
	
	Заголовок = НСтр("be = 'Cleverence'; en = 'Cleverence'; es = 'Cleverence'; ka = 'Cleverence'; kk = 'Cleverence'; ro = 'Cleverence'; ru = 'Клеверенс'; tr = 'Cleverence'; uk = 'Cleverence'; uz = 'Cleverence'") 
					+ ": " + ИмяПриложения;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСсылкуНаБазуЗнаний()	
	
	Если Найти(ИмяПриложения, "Магазин") Тогда		
		Ссылка = "https://www.cleverence.ru/support/category:697/"; 
	ИначеЕсли Найти(ИмяПриложения, "Склад") Тогда			
		Ссылка = "https://www.cleverence.ru/support/50247/"; 
	Иначе
		Ссылка = "https://www.cleverence.ru/support/category:26/"; 
	КонецЕсли;	
			
	Элементы.СсылкаНаИнформациюПоРаботеСОбработкой.Подсказка = Ссылка;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьQRCode(QRCodeСтрока = "", ТипУстановленногоПродукта = "")
	
	Если НЕ ЗначениеЗаполнено(QRCodeСтрока) ИЛИ ТипУстановленногоПродукта = "МДЛП" Тогда
		КартинкаQRCode = "";
	Иначе
		ДанныеQRКода = ДанныеQRКода(QRCodeСтрока, 0, 190);
		
		Если ДанныеQRКода = Неопределено Тогда
			КартинкаQRCode = "";
		Иначе
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы.КартинкаQRКод.Картинка = Новый Картинка(ДанныеQRКода);
				КартинкаQRCode = "QR";
			#Иначе
				КартинкаQRCode = ПоместитьВоВременноеХранилище(ДанныеQRКода, УникальныйИдентификатор);
			#КонецЕсли
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КартинкаQRCode) Тогда
		ТекстЗаголовка = НСтр("be = 'Для падлучэння мабільнага прыладу %1 да базы Cleverence скануйце штрыхкод'; en = 'To connect the mobile device %1 to the Cleverence database, scan the barcode'; es = 'Para conectar el dispositivo móvil %1 a la base de Cleverence, escanee el código de barras'; ka = 'მობილური მოწყობილობის %1-ის Cleverence ბაზასთვის შეერთეთ შტრიხკოდი'; kk = 'Мобильді құрылғыны %1 Cleverence базасына қосу үшін штрихкодты сканерлеу'; ro = 'Pentru conectarea dispozitivului mobil %1 la baza de date Cleverence, scanati codul de bare'; ru = 'Для подключения мобильного устройства %1 к базе Клеверенс сканируйте штрихкод'; tr = 'Mobil cihazınızı Cleverence veritabanına bağlamak için barkodu tarayın'; uk = 'Для підключення мобільного пристрою %1 до бази Cleverence скануйте штрихкод'; uz = 'Мобил қурилмани база Cleverenceга қўшиш учун %1ни сканерланг'");
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Символы.ПС);
	Иначе
		ТекстЗаголовка = "";
	КонецЕсли;
	
	Элементы.ДекорацияQRКод.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервере
Функция ДанныеQRКода(QRСтрока, УровеньКоррекции, Размер) Экспорт
	
	Попытка
		#Область НесовместимыйКодFresh
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			МодульОбработки = Объект;
		#Иначе
			МодульОбработки = РеквизитФормыВЗначение("Объект");
		#КонецЕсли
		Если МодульОбработки.ГлЯдро_ОбщийМодульСуществует("УправлениеПечатью") Тогда
			СтрокаКода = "ДанныеQRКода = УправлениеПечатью.ДанныеQRКода(QRСтрока, УровеньКоррекции, Размер);";
		ИначеЕсли МодульОбработки.ГлЯдро_ОбщийМодульСуществует("PrintManagement") Тогда
			СтрокаКода = "ДанныеQRКода = PrintManagement.QRCodeData(QRСтрока, УровеньКоррекции, Размер);";
		КонецЕсли;
		Выполнить(СтрокаКода);
		#КонецОбласти //НесовместимыйКодFresh
		#Область СовместимыйКодFresh
		//Попытка
		//	ДанныеQRКода = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью").ДанныеQRКода(QRСтрока, УровеньКоррекции, Размер);
		//Исключение
		//	ДанныеQRКода = ОбщегоНазначения.ОбщийМодуль("PrintManagement").QRCodeData(QRСтрока, УровеньКоррекции, Размер);
		//КонецПопытки;
		#КонецОбласти //СовместимыйКодFresh
	Исключение
		ДанныеQRКода = Неопределено;
	КонецПопытки;
	
	Возврат ДанныеQRКода;
	
КонецФункции

// Изменяет описание статуса, согласно полученному параметру
// 
// Параметры:
// 	Параметр - Структура - Структура с описанием статуса
&НаКлиенте
Процедура СменитьСтатус(Параметр)
	
	СтатусЗапускаОсновнойОбработки 	= Параметр.Статус;
	ПереданныйПараметр 				= Параметр.Параметр;
	ОперацияПоСменеСтатуса			= ?(Параметр.Свойство("Операция"), Параметр.Операция, "Служебное");
	Если Параметр.Свойство("ТипБазы") Тогда
		ТипБазы = Параметр.ТипБазы;
	Иначе
		ТипБазы = "Основная";
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов();
	
	Если СтатусЗапускаОсновнойОбработки = "НачалоВыполненияПроцедурыЗапускаОбработки" Тогда		
		ОбновитьВидимостьЭлементов(Ложь,Ложь,Истина);                                      		
