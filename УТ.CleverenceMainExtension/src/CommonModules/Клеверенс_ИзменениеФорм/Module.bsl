#Область ПрограммноеИзменениеФорм

// Изменяет форму справочников
//
// Форма 					- Форма - изменяемая форма
//
Процедура ИзменениеФорм(Форма, ДействиеКоманды = "Подключаемый_ВыполнитьКоманду") Экспорт
	
	ИмяФормы = Форма.ИмяФормы;
	
	// ИИ может еще не знать о новом функционале
	Если Не ВстроитьКнопкиЗагрузкиВыгрузки(Форма, ДействиеКоманды) Тогда
		
		// старый код
	    МассивЧастейИмениФормы = Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ".");
		
		Если МассивЧастейИмениФормы.Количество() = 4 Тогда
			
			Если МассивЧастейИмениФормы[0] = "Справочник" или МассивЧастейИмениФормы[0] = "Catalog" Тогда
				
				Клеверенс_ИзменениеФорм.ИзменениеФормСправочников(Форма, МассивЧастейИмениФормы, ДействиеКоманды);
				
			ИначеЕсли МассивЧастейИмениФормы[0] = "Документ" или МассивЧастейИмениФормы[0] = "Document" Тогда
				
				Клеверенс_ИзменениеФорм.ИзменениеФормДокументов(Форма, МассивЧастейИмениФормы, ДействиеКоманды);
				
			ИначеЕсли МассивЧастейИмениФормы[0] = "Обработка" Тогда
				
				Клеверенс_ИзменениеФорм.ИзменениеФормОбработок(Форма, МассивЧастейИмениФормы, ДействиеКоманды);

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВстроитьКнопкиЗагрузкиВыгрузки(Форма, ДействиеКоманды)
	
	Возврат ВстроитьКнопкуЗагрузки(Форма, ДействиеКоманды) и ВстроитьКнопкуВыгрузки(Форма, ДействиеКоманды);
	
КонецФункции

Функция ВстроитьКнопкуЗагрузки(Форма, ДействиеКоманды)
	
	ИмяФормы = Форма.ИмяФормы;
	
	МассивЧастейИмениФормы = Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ".");
	ИмяОбъектаФормы = МассивЧастейИмениФормы[0] + "." + МассивЧастейИмениФормы[1];
	
	МестаВстраиванияКнопкиЗагрузки = Клеверенс_ОбщегоНазначенияСервер.ПолучитьМассивИменОбъектовПоВидуОбмена("МестаВстраиванияКнопкиЗагрузки");
	
	// ИИ может еще не знать о новом функционале
	Если МестаВстраиванияКнопкиЗагрузки = Неопределено или МестаВстраиванияКнопкиЗагрузки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
		
	МестоВстраиванияКнопкиЗагрузки = НайтиМестоВстраивания(ИмяФормы, ИмяОбъектаФормы, МестаВстраиванияКнопкиЗагрузки);
	
	Если МестоВстраиванияКнопкиЗагрузки <> Неопределено Тогда
		
		//// вызвать кастомный обработчик встраивания
		//Если МестоВстраиванияКнопкиЗагрузки.Свойство("ПроцедураВстраивания") и не ПустаяСтрока(МестоВстраиванияКнопкиЗагрузки.ПроцедураВстраивания)Тогда
		//	
		//	ИнтеграционнаяОбработка = Клеверенс_ОбщегоНазначенияВызовСервера.ПолучитьОбъектИнтеграционнойОбработки();
		//	Выполнить("ИнтеграционнаяОбработка." + МестоВстраиванияКнопкиЗагрузки.ПроцедураВстраивания + "(Форма)");
		//	
		//Иначе // встроить универсально
			
			Если МассивЧастейИмениФормы[0] = "Документ" Тогда
				
				ВстроитьКнопкуЗагрузкиДокумента(Форма, МестоВстраиванияКнопкиЗагрузки, ДействиеКоманды);
				
			ИначеЕсли МассивЧастейИмениФормы[0] = "Обработка" Тогда
				
				ВстроитьКнопкуЗагрузкиДокумента(Форма, МестоВстраиванияКнопкиЗагрузки, ДействиеКоманды);

			КонецЕсли;
			
		//КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ВстроитьКнопкуВыгрузки(Форма, ДействиеКоманды)
	
	ИмяФормы = Форма.ИмяФормы;
	
	МассивЧастейИмениФормы = Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ".");
	ИмяОбъектаФормы = МассивЧастейИмениФормы[0] + "." + МассивЧастейИмениФормы[1];
	
	МестаВстраиванияКнопкиВыгрузки = Клеверенс_ОбщегоНазначенияСервер.ПолучитьМассивИменОбъектовПоВидуОбмена("МестаВстраиванияКнопкиВыгрузки");
	
	// ИИ может еще не знать о новом функционале
	Если МестаВстраиванияКнопкиВыгрузки = Неопределено или МестаВстраиванияКнопкиВыгрузки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МестоВстраиванияКнопкиВыгрузки = НайтиМестоВстраивания(ИмяФормы, ИмяОбъектаФормы, МестаВстраиванияКнопкиВыгрузки);
	
	Если МестоВстраиванияКнопкиВыгрузки <> Неопределено Тогда
		
		//// вызвать кастомный обработчик встраивания
		//Если МестоВстраиванияКнопкиВыгрузки.Свойство("ПроцедураВстраивания") и не ПустаяСтрока(МестоВстраиванияКнопкиВыгрузки.ПроцедураВстраивания)Тогда
		//	
		//	ИнтеграционнаяОбработка = Клеверенс_ОбщегоНазначенияВызовСервера.ПолучитьОбъектИнтеграционнойОбработки();
		//	Выполнить("ИнтеграционнаяОбработка." + МестоВстраиванияКнопкиВыгрузки.ПроцедураВстраивания + "(Форма)");
		//	
		//Иначе // встроить универсально
			
			Если МассивЧастейИмениФормы[0] = "Справочник" Тогда
				
				ВстроитьКнопкуВыгрузкиСправочника(Форма, МестоВстраиванияКнопкиВыгрузки, ДействиеКоманды);
				
			ИначеЕсли МассивЧастейИмениФормы[0] = "Документ" Тогда
				
				ВстроитьКнопкуВыгрузкиДокумента(Форма, МестоВстраиванияКнопкиВыгрузки, ДействиеКоманды);
				
			ИначеЕсли МассивЧастейИмениФормы[0] = "Обработка" Тогда
				
				ВстроитьКнопкуВыгрузкиДокумента(Форма, МестоВстраиванияКнопкиВыгрузки, ДействиеКоманды);

			КонецЕсли;
			
		//КонецЕсли;
		
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

Процедура ВстроитьКнопкуВыгрузкиСправочника(Форма, МестоВстраивания, ДействиеКоманды)
	
	ИмяКоманды 	= "Клеверенс_ВыгрузитьСправочники";
	Заголовок 	= НСтр("be = 'Выгрузіць у Cleverence'; en = 'Export to Cleverence'; es = 'Descargar en Cleverence'; ka = 'Cleverence-ში გამოტანა'; kk = 'Cleverence-ге шығару'; ro = 'Descărcați în Cleverence'; ru = 'Выгрузить в Клеверенс'; tr = ""Cleverence'a dışa aktar""; uk = 'Вивантажити в Cleverence'; uz = 'Cleverence ga yuklash'");
	
	ИмяФормы = Форма.ИмяФормы;
	
	Если ПолучитьЭлементФормы(Форма, ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементРодитель = Неопределено;
	ЭтоФормаСписка = Ложь;
	
	Если МестоВстраивания.Свойство("ИмяРодительскогоЭлемента") и Не ПустаяСтрока(МестоВстраивания.ИмяРодительскогоЭлемента) Тогда
		ЭлементРодитель = ПолучитьЭлементФормы(Форма, МестоВстраивания.ИмяРодительскогоЭлемента);
		
		Если ТипЗнч(ЭлементРодитель) = Тип("ТаблицаФормы") Тогда
			ЭлементРодитель = ?(ЭлементРодитель.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет, Неопределено, ЭлементРодитель.КоманднаяПанель);			
		КонецЕсли;
		
	Иначе
		
		ИмяФормы = Форма.ИмяФормы;
	    МассивЧастейИмениФормы = Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ".");
		
		Если СтрНайти(МассивЧастейИмениФормы[3], "ФормаЭлемента") > 0
			Или СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0 Тогда
		
			Если МестоВстраивания.Свойство("ЭтоФормаСписка", ЭтоФормаСписка) = Ложь Тогда
				ЭтоФормаСписка = СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0;
			КонецЕсли;
			
			ЭлементРодитель = Клеверенс_ОбщегоНазначенияСервер.ПолучитьРодительскийЭлементДляКнопкиОбмена(Форма, ЭтоФормаСписка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭлементРодитель <> Неопределено Тогда
			
		НоваяКоманда_ВыгрузитьСправочник = Клеверенс_ИзменениеФорм.ДобавитьНовуюКоманду(
			Форма,
			ИмяКоманды,
			ДействиеКоманды,
			Заголовок,);
			
		НоваяКнопка_ВыгрузитьДокумент = Клеверенс_ИзменениеФорм.ДобавитьНовуюКнопку(
			Форма,,
			ИмяКоманды,
			НоваяКоманда_ВыгрузитьСправочник,
			ЭлементРодитель,
			Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВстроитьКнопкуЗагрузкиДокумента(Форма, МестоВстраивания, ДействиеКоманды)
	
	ИмяКоманды 	= "Клеверенс_ЗагрузитьИзТСД";
	Заголовок 	= НСтр("be = 'Загрузіць з Cleverence'; en = 'Upload from Cleverence'; es = 'Cargar desde Cleverence'; ka = 'Cleverence-დან ჩატვირთვა'; kk = 'Cleverence-ден жүктеу'; ro = 'Încărcați din Cleverence'; ru = 'Загрузить из Клеверенс'; tr = ""Cleverence'dan yükle""; uk = 'Завантажити з Cleverence'; uz = 'Cleverence dan yuklash'");
		
	Если ПолучитьЭлементФормы(Форма, ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементРодитель = Неопределено;
	
	Если МестоВстраивания.Свойство("ИмяРодительскогоЭлемента") и Не ПустаяСтрока(МестоВстраивания.ИмяРодительскогоЭлемента) Тогда
		ЭлементРодитель = ПолучитьЭлементФормы(Форма, МестоВстраивания.ИмяРодительскогоЭлемента);
		
		Если ТипЗнч(ЭлементРодитель) = Тип("ТаблицаФормы") Тогда
			ЭлементРодитель = ?(ЭлементРодитель.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет, Неопределено, ЭлементРодитель.КоманднаяПанель);			
		КонецЕсли;
		
	Иначе
		
		ИмяФормы = Форма.ИмяФормы;
	    МассивЧастейИмениФормы = Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ".");
		ЭтоФормаСписка = Неопределено;
		
		Если СтрНайти(МассивЧастейИмениФормы[3], "ФормаДокумента") > 0
			Или СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0 Тогда
		
			Если МестоВстраивания.Свойство("ЭтоФормаСписка", ЭтоФормаСписка) = Ложь Тогда
				ЭтоФормаСписка = СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0;
			КонецЕсли;
			
			ЭлементРодитель = Клеверенс_ОбщегоНазначенияСервер.ПолучитьРодительскийЭлементДляКнопкиОбмена(Форма, ЭтоФормаСписка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭлементРодитель <> Неопределено Тогда	
			
		НоваяКоманда = Клеверенс_ИзменениеФорм.ДобавитьНовуюКоманду(
			Форма,
			ИмяКоманды,
			ДействиеКоманды,
			Заголовок,);
		
		НоваяКнопка = Клеверенс_ИзменениеФорм.ДобавитьНовуюКнопку(
			Форма,,
			ИмяКоманды,
			НоваяКоманда,
			ЭлементРодитель,
			Заголовок);
			
		// сохраним в реквизитах формы параметры встраивания
		ИмяРеквизита = "Клеверенс_МестоВстраиванияКнопкиЗагрузки";
		ДобавитьРеквизитФормы(Форма, ИмяРеквизита, Новый ОписаниеТипов());
		Форма[ИмяРеквизита] = МестоВстраивания;
		
	КонецЕсли;		
	
КонецПроцедуры

Процедура ВстроитьКнопкуВыгрузкиДокумента(Форма, МестоВстраивания, ДействиеКоманды)

	ЭлементРодитель = Неопределено;
	ЭтоФормаСписка = Ложь;
	
	// если не указано куда встраивать, то пытаемся найти
	Если МестоВстраивания.Свойство("ИмяРодительскогоЭлемента") и Не ПустаяСтрока(МестоВстраивания.ИмяРодительскогоЭлемента) Тогда
		ЭлементРодитель = ПолучитьЭлементФормы(Форма, МестоВстраивания.ИмяРодительскогоЭлемента);
		МестоВстраивания.Свойство("ЭтоФормаСписка", ЭтоФормаСписка);
		
		Если ТипЗнч(ЭлементРодитель) = Тип("ТаблицаФормы") Тогда
			ЭлементРодитель = ?(ЭлементРодитель.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет, Неопределено, ЭлементРодитель.КоманднаяПанель);			
		КонецЕсли;
		
	Иначе
		
		ИмяФормы = Форма.ИмяФормы;
	    МассивЧастейИмениФормы = Клеверенс_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяФормы, ".");
		
		Если СтрНайти(МассивЧастейИмениФормы[3], "ФормаДокумента") > 0
			Или СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0 Тогда
			
			Если МестоВстраивания.Свойство("ЭтоФормаСписка", ЭтоФормаСписка) = Ложь Тогда
				ЭтоФормаСписка = СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0;
			КонецЕсли;
			
			ЭлементРодитель = Клеверенс_ОбщегоНазначенияСервер.ПолучитьРодительскийЭлементДляКнопкиОбмена(Форма, ЭтоФормаСписка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭлементРодитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоФормаСписка Тогда
		
		ИмяГруппы 	= "Клеверенс_ГруппаКнопокВыгрузить";
		Заголовок 	= НСтр("be = 'Выгрузіць у Cleverence'; en = 'Export to Cleverence'; es = 'Descargar en Cleverence'; ka = 'Cleverence-ში გამოტანა'; kk = 'Cleverence-ге шығару'; ro = 'Descărcați în Cleverence'; ru = 'Выгрузить в Клеверенс'; tr = ""Cleverence'a dışa aktar""; uk = 'Вивантажити в Cleverence'; uz = 'Cleverence ga yuklash'");
		
		ГруппаФормы = ПолучитьЭлементФормы(Форма, ИмяГруппы);
		Если ГруппаФормы = Неопределено Тогда
			// будет две кнопки, объединяем в группу
			НоваяГруппаКнопок = Клеверенс_ИзменениеФорм.ДобавитьНовуюГруппуФормы(
							Форма,,
							ИмяГруппы,
							ЭлементРодитель,
							Заголовок,
							ВидГруппыФормы.Подменю);
							
			ЭлементРодитель = НоваяГруппаКнопок;
			
		Иначе			
			ЭлементРодитель = ГруппаФормы;			
		КонецЕсли;
		
	КонецЕсли;
	
	// кнопка выгрузить
	ИмяКоманды 	= "Клеверенс_ВыгрузитьДокумент";
	Заголовок 	= НСтр("be = 'Выгрузіць дакумент(ы)'; en = 'Export document(s)'; es = 'Descargar documento(s)'; ka = 'დოკუმენტის(ების) გამოტანა'; kk = 'Құжат(тар)ды шығару'; ro = 'Descărcați documentul (e)'; ru = 'Выгрузить документ(ы)'; tr = 'Belge(leri) dışa aktar'; uk = 'Вивантажити документ(и)'; uz = 'Hujjat(lar)ni yuklash'");
			
	Если ПолучитьЭлементФормы(Форма, ИмяКоманды) = Неопределено Тогда
		
		НоваяКоманда_ВыгрузитьДокумент = Клеверенс_ИзменениеФорм.ДобавитьНовуюКоманду(
			Форма,
			ИмяКоманды,
			ДействиеКоманды,
			Заголовок,);
		
		НоваяКнопка_ВыгрузитьДокумент = Клеверенс_ИзменениеФорм.ДобавитьНовуюКнопку(
			Форма,,
			ИмяКоманды,
			НоваяКоманда_ВыгрузитьДокумент,
			ЭлементРодитель,
			Заголовок);
		
	КонецЕсли;
	
	// кнопка выгрузить в один
	Если ЭтоФормаСписка Тогда
		
		ИмяКоманды 	= "Клеверенс_ВыгрузитьВОдинДокумент";
		Заголовок 	= НСтр("be = 'Выгрузіць у адзін дакумент'; en = 'Export to one document'; es = 'Descargar en un solo documento'; ka = 'ერთი დოკუმენტში გამოტანა'; kk = 'Бір құжатқа шығару'; ro = 'Descărcați într-un singur document'; ru = 'Выгрузить в один документ'; tr = 'Tek bir belgeye dışa aktar'; uk = 'Вивантажити в один документ'; uz = 'Bitta hujjatga yuklash'");
		
		Если ПолучитьЭлементФормы(Форма, ИмяКоманды) = Неопределено Тогда
			
			НоваяКоманда_ВыгрузитьВОдинДокумент = Клеверенс_ИзменениеФорм.ДобавитьНовуюКоманду(
				Форма,
				ИмяКоманды,
				ДействиеКоманды,
				Заголовок,);				
			
			НоваяКнопка_ВыгрузитьВОдинДокумент = Клеверенс_ИзменениеФорм.ДобавитьНовуюКнопку(
				Форма,,
				ИмяКоманды,
				НоваяКоманда_ВыгрузитьВОдинДокумент,
				ЭлементРодитель,
				Заголовок);
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиМестоВстраивания(ИмяФормы, ИмяОбъектаФормы, МестаВстраивания)
	
	МестоВстраивания = Неопределено;
	
	Для каждого Место Из МестаВстраивания Цикл
		
		Если ТипЗнч(Место) = Тип("Строка") Тогда
			ИмяОбъектаВстраивания = Место;
		Иначе
			ИмяОбъектаВстраивания = Место.ИмяОбъекта;
		КонецЕсли;
			
		Если ИмяОбъектаВстраивания = ИмяФормы Тогда // точное совпадение
			МестоВстраивания = Место;
			Прервать;
		ИначеЕсли ИмяОбъектаВстраивания = ИмяОбъектаФормы Тогда
			МестоВстраивания = Место;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТипЗнч(МестоВстраивания) = Тип("Строка") Тогда
		МестоВстраивания = Новый Структура("ИмяОбъекта", МестоВстраивания);
	КонецЕсли;
	
	Возврат МестоВстраивания;
	
КонецФункции

// Изменяет форму справочников
//
// Форма 					- Форма - изменяемая форма
// МассивЧастейИмениФормы 	- Массив - массив, содержащий части имени формы, разделенными точками
//
Процедура ИзменениеФормСправочников(Форма, МассивЧастейИмениФормы, ДействиеКоманды) Экспорт
	
	ИмяОбъектаФормы = МассивЧастейИмениФормы[0] + "." + МассивЧастейИмениФормы[1];
	
	Если МассивЧастейИмениФормы[3] = "ФормаЭлемента"
		или СтрНайти(МассивЧастейИмениФормы[3], "ItemForm") > 0
		или СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0
		или СтрНайти(МассивЧастейИмениФормы[3], "ListForm") > 0 Тогда
		
		ЭтоФормаСписка = СтрНайти(МассивЧастейИмениФормы[3], "ФормаСписка") > 0 или СтрНайти(МассивЧастейИмениФормы[3], "ListForm") > 0;
		
		МассивИменСправочниковВыгрузки = Клеверенс_ОбщегоНазначенияСервер.ПолучитьМассивИменОбъектовПоВидуОбмена("ВыгрузкаСправочников");
		
		Если МассивИменСправочниковВыгрузки.Найти(ИмяОбъектаФормы) <> Неопределено Тогда
			
			ИмяКоманды 	= "Клеверенс_ВыгрузитьСправочники";
			Заголовок 	= НСтр("be = 'Выгрузіць у Cleverence'; en = 'Export to Cleverence'; es = 'Descargar en Cleverence'; ka = 'Cleverence-ში გამოტანა'; kk = 'Cleverence-ге шығару'; ro = 'Descărcați în Cleverence'; ru = 'Выгрузить в Клеверенс'; tr = ""Cleverence'a dışa aktar""; uk = 'Вивантажити в Cleverence'; uz = 'Cleverence ga yuklash'");
			
			Если ПолучитьЭлементФормы(Форма, ИмяКоманды) = Неопределено Тогда
				
				НоваяКоманда_ВыгрузитьСправочник = Клеверенс_ИзменениеФорм.ДобавитьНовуюКоманду(
					Форма,
					ИмяКоманды,
					ДействиеКоманды,
					Заголовок,);
					
				ЭлементРодитель = Клеверенс_ОбщегоНазначенияСервер.ПолучитьРодительскийЭлементДляКнопкиОбмена(Форма, ЭтоФормаСписка);
				
				НоваяКнопка_ВыгрузитьДокумент = Клеверенс_ИзменениеФорм.ДобавитьНовуюКнопку(
					Форма,,
					ИмяКоманды,
					НоваяКоманда_ВыгрузитьСправочник,
					ЭлементРодитель,
					Заголовок);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Изменяет форму документов
//
