//
Процедура ИзменениеФормДокументов(Форма, МассивЧастейИмениФормы, ДействиеКоманды) Экспорт
	
	ИмяОбъектаФормы = МассивЧастейИмениФормы[0] + "." + МассивЧастейИмениФормы[1];
	
