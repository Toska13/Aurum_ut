&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Попытка
		ФормаОбработки = ПолучитьФорму("ВнешняяОбработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ГлавнаяФорма");
		Если ФормаОбработки.Открыта() Тогда
			ФормаОбработки.Активизировать();
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	// Существуют кейсы, когда конструкция ПолучитьФорму("ВнешняяОбработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ГлавнаяФорма") не работает.
	//
	// Пример:
	//	Если были открыты обработки из разных источников, конструкция ПолучитьФорму(...) впоследствии отрабатывает только для одного из них.
	//	Воспроизведение:
	//	1 шаг: Открываем обработку из файла и из справочника.
	//	2 шаг: Закрываем обработку из файла.
	// 	Результат: конструкция ПолучитьФорму(...) не может получить оставшуюся открытой форму обработки из справочника.  
	//
	// В связи с этим дополнительно пробуем получить открытую форму путем перебора окон.
	//
	ОткрытыеОкна = ПолучитьОкна();
	Для каждого ОткрытоеОкно ИЗ ОткрытыеОкна Цикл
		Если ОткрытоеОкно.НачальнаяСтраница Тогда
			Продолжить;			
		КонецЕсли;
		Если ОткрытоеОкно.Основное Тогда
			Продолжить;			
		КонецЕсли;
		
		СодержимоеОкна = ОткрытоеОкно.Содержимое;
		Для каждого ЭлементСодержимого ИЗ СодержимоеОкна Цикл	
			Если НЕ ТипЗнч(ЭлементСодержимого) = Тип("ФормаКлиентскогоПриложения") Тогда
				Продолжить;				
			КонецЕсли;
		
			Если Найти(ЭлементСодержимого.ИмяФормы, "ВнешняяОбработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ГлавнаяФорма") > 0 Тогда
				ОткрытоеОкно.Активизировать();
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Если открытой формы обработки нет, открываем встроенную обработку из расширения
	//
	ФормаОбработки = ПолучитьФорму("Обработка.КлеверенсТСД_ОсновнаяОбработка.Форма.ГлавнаяФорма");
	ФормаОбработки.Открыть();
	
КонецПроцедуры
