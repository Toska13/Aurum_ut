
&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Партнеры") Тогда
		
		Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.Использование = Истина;
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Партнер");
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Элемент.ПравоеЗначение = Новый СписокЗначений;
		Элемент.ПравоеЗначение.ЗагрузитьЗначения(Параметры.Партнеры);
		
	КонецЕсли;
	
КонецПроцедуры
