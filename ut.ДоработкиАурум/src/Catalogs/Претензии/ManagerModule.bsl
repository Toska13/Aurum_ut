#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
Функция АУ_ДанныеДляПечатиДокументов(ОбъектыПечати) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапросаДляКонтррасчета =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
	|	РеализацияТоваровУслуг.Номер КАК Номер,
	|	РеализацияТоваровУслуг.Дата КАК Дата,
	|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
	|	РеализацияТоваровУслуг.Грузополучатель КАК Грузополучатель
	|ПОМЕСТИТЬ ВТОтгрузки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОтгрузки.Ссылка КАК Ссылка,
	|	ВТОтгрузки.Номер КАК Номер,
	|	ВТОтгрузки.Дата КАК Дата,
	|	ВТОтгрузки.СуммаДокумента КАК СуммаДокумента,
	|	ВТОтгрузки.Грузополучатель КАК Грузополучатель,
	|	АУ_СтавкиРефинансированияЦБ.Ставка КАК Ставка
	|ИЗ
	|	ВТОтгрузки КАК ВТОтгрузки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТОтгрузки.Ссылка КАК Ссылка,
	|			МАКСИМУМ(АУ_СтавкиРефинансированияЦБ.Период) КАК Период
	|		ИЗ
	|			ВТОтгрузки КАК ВТОтгрузки
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АУ_СтавкиРефинансированияЦБ КАК АУ_СтавкиРефинансированияЦБ
	|				ПО ВТОтгрузки.Дата >= АУ_СтавкиРефинансированияЦБ.Период
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВТОтгрузки.Ссылка) КАК ВложенныйЗапрос
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АУ_СтавкиРефинансированияЦБ КАК АУ_СтавкиРефинансированияЦБ
	|			ПО ВложенныйЗапрос.Период = АУ_СтавкиРефинансированияЦБ.Период
	|		ПО ВТОтгрузки.Ссылка = ВложенныйЗапрос.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	ТекстЗапросаУчастники =
	"ВЫБРАТЬ
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Партнер КАК Партнер,
	|	Т.КонтактноеЛицо КАК КонтактноеЛицо,
	|	Т.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ ВТТЗ
	|ИЗ
	|	&ТЗ КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТЗ.Партнер КАК Партнер,
	|	ВТТЗ.КонтактноеЛицо КАК КонтактноеЛицо,
	|	ВТТЗ.Комментарий КАК Комментарий,
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	Контрагенты.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
	|	ВТТЗ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТТЗ КАК ВТТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТТЗ.Партнер = Контрагенты.Партнер
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ДанныеДляПечати = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Претензии.Ссылка КАК Ссылка,
	|	Претензии.ВерсияДанных КАК ВерсияДанных,
	|	Претензии.ПометкаУдаления КАК ПометкаУдаления,
	|	Претензии.Код КАК Код,
	|	Претензии.Наименование КАК Наименование,
	|	Претензии.Ответственный КАК Ответственный,
	|	Претензии.ДатаРегистрации КАК ДатаРегистрации,
	|	Претензии.ДатаОкончания КАК ДатаОкончания,
	|	Претензии.Завершен КАК Завершен,
	|	Претензии.Комментарий КАК Комментарий,
	|	Претензии.РезультатыОтработки КАК РезультатыОтработки,
	|	Претензии.ОписаниеПретензии КАК ОписаниеПретензии,
	|	Претензии.ПричинаВозникновения КАК ПричинаВозникновения,
	|	Претензии.Партнер КАК Партнер,
	|	Претензии.Статус КАК Статус,
	|	Претензии.ВиновноеПодразделение КАК ВиновноеПодразделение,
	|	Претензии.ВиновныйСотрудник КАК ВиновныйСотрудник,
	|	Претензии.Основание КАК Основание,
	|	ЕСТЬNULL(Претензии.Основание.СуммаДокумента, 0) КАК ОснованиеСуммаДокумента,
	|	ЕСТЬNULL(Претензии.Основание.ДатаОтгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОтгрузки,
	|	ЕСТЬNULL(Претензии.Основание.АУ_КрайняяДатаПоставки, ДАТАВРЕМЯ(1, 1, 1)) КАК КрайняяДатаПоставки,
	|	Претензии.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
	|	Претензии.Организация КАК Организация,
	|	Претензии.Контрагент КАК Контрагент,
	|	Претензии.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Претензии.Договор КАК Договор,
	|	Претензии.Валюта КАК Валюта,
	|	Претензии.Сумма КАК Сумма,
	|	Претензии.ЭтоПретензияПоставщику КАК ЭтоПретензияПоставщику,
	|	Претензии.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Претензии.ВестиРасчетыПоПретензии КАК ВестиРасчетыПоПретензии,
	|	Претензии.АУ_ДатаПретензии КАК АУ_ДатаПретензии,
	|	Претензии.АУ_ЕИС КАК АУ_ЕИС,
	|	Претензии.АУ_ПризнаннаяСумма КАК АУ_ПризнаннаяСумма,
	|	Претензии.АУ_СписанаКонтрагентом КАК АУ_СписанаКонтрагентом,
	|	Претензии.Предопределенный КАК Предопределенный,
	|	Претензии.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	|	Претензии.Представление КАК Представление,
	|	Претензии.Договор.Номер КАК ДоговорНомер,
	|	Претензии.Договор.Наименование КАК ДоговорНаименование,
	|	Претензии.Договор.Сумма КАК ДоговорСумма,
	|	Претензии.Договор.Дата КАК ДоговорДата,
	|	Претензии.Контрагент.Наименование КАК КонтрагентНаименование,
	|	Претензии.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
	|	Претензии.Контрагент.ИНН КАК КонтрагентИНН,
	|	Претензии.Контрагент.КПП КАК КонтрагентКПП,
	|	СостоянияЗаказовКлиентов.Состояние КАК Состояние,
	|	СостоянияЗаказовКлиентов.ДатаСобытия КАК ДатаСобытия,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0) КАК СуммаОплаты,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентОплаты, 0) КАК ПроцентОплаты,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОтгрузки, 0) КАК СуммаОтгрузки,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентОтгрузки, 0) КАК ПроцентОтгрузки,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаДолга, 0) КАК СуммаДолга,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентДолга, 0) КАК ПроцентДолга,
	|	ЕСТЬNULL(АУ_СтавкиРефинансированияЦБСрезПоследних.Ставка, 0) КАК СтавкаЦБ,
	|	Претензии.АУ_ВариантРасчетаНеустойки КАК АУ_ВариантРасчетаНеустойки,
	|	Претензии.АУ_ДатаКлючевойСтавки КАК АУ_ДатаКлючевойСтавки
	|ИЗ
	|	Справочник.Претензии КАК Претензии
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО Претензии.Основание = СостоянияЗаказовКлиентов.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АУ_СтавкиРефинансированияЦБ.СрезПоследних КАК АУ_СтавкиРефинансированияЦБСрезПоследних
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Претензии.Ссылка В(&Ссылка)";
		
	Запрос.УстановитьПараметр("Ссылка", ОбъектыПечати);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Описание=Новый Структура("Ссылка",Выборка.Ссылка);
		
		Описание.Вставить("ДатаФормирования", Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));
		Описание.Вставить("НомерПретензии",Выборка.Наименование);
		Описание.Вставить("ДатаПретензии", Формат(Выборка.АУ_ДатаПретензии, "ДФ=dd.MM.yyyy"));
		Описание.Вставить("ДатаРегистрации", Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy"));
		Описание.Вставить("СуммаПретензии",Формат(Выборка.Сумма, "ЧДЦ=2"));
		
		Описание.Вставить("ДоговорНаименование",Выборка.ДоговорНаименование);
		Описание.Вставить("ДоговорДата", Формат(Выборка.ДоговорДата, "ДФ=dd.MM.yyyy"));
		Описание.Вставить("ДоговорНомер",Выборка.ДоговорНомер);
		Описание.Вставить("СуммаСНДС", Формат(Выборка.ДоговорСумма, "ЧДЦ=2"));
		
		СведенияОКонтрагенте = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Выборка.Контрагент,ТекущаяДатаСеанса(),,);
		Описание.Вставить("КонтрагентПолноеНаименование",Выборка.КонтрагентНаименованиеПолное);
		Описание.Вставить("КонтрагентНаименование",Выборка.КонтрагентНаименование);
		Описание.Вставить("КонтрагентИНН",Выборка.КонтрагентИНН);
		Описание.Вставить("КонтрагентКПП",Выборка.КонтрагентКПП);
		Описание.Вставить("КонтрагентЮридическийАдрес",СведенияОКонтрагенте.ЮридическийАдрес);
		Описание.Вставить("КонтрагентЭлектроннаяПочта",СведенияОКонтрагенте.ЭлектроннаяПочта);
		
		Описание.Вставить("ЗаказСумма",Формат(Выборка.ОснованиеСуммаДокумента, "ЧДЦ=2"));
		Описание.Вставить("СуммаАванса",Формат(Выборка.ОснованиеСуммаДокумента * 0.3, "ЧДЦ=2"));
		Описание.Вставить("СуммаНеустойки",Формат(Выборка.ОснованиеСуммаДокумента * 0.05, "ЧДЦ=2"));
		Описание.Вставить("КоличествоГрузополучателей", 1);
		Описание.Вставить("ДатаНачала", Формат(Выборка.ДатаРегистрации, "ДФ='дд ММММ гггг'"));
		Описание.Вставить("СрокВыполнения", Формат(Выборка.ДатаРегистрации, "ДФ='дд ММММ гггг'"));
		Описание.Вставить("ДатаОтгрузки", Формат(Выборка.ДатаОтгрузки, "ДФ='дд ММММ гггг'"));
		Описание.Вставить("ДатаОтгрузкиМинус3", Формат(Выборка.ДатаОтгрузки - 86400 * 3, "ДФ='дд ММММ гггг'"));
		
		Описание.Вставить("СуммаКонтракта20Процентов", Формат(Выборка.ОснованиеСуммаДокумента * 0.2, "ЧДЦ=2"));
		
		РазмерШтрафа = 0;
		Если Выборка.ОснованиеСуммаДокумента < 3000000 Тогда
			РазмерШтрафа = 1000;
		ИначеЕсли Выборка.ОснованиеСуммаДокумента < 50000000 Тогда
			РазмерШтрафа = 5000;
		ИначеЕсли Выборка.ОснованиеСуммаДокумента < 100000000 Тогда
			РазмерШтрафа = 10000;
		Иначе
			РазмерШтрафа = 100000;
		КонецЕсли;
		Описание.Вставить("РазмерШтрафа", Формат(РазмерШтрафа, "ЧДЦ=2"));
		
		Описание.Вставить("СрокИсполненияКонтракта", Формат(АУ_ОбщиеПроцедурыИФункцииСервер.ПолучитьБлижайшуюРабочуюДату(Выборка.КрайняяДатаПоставки), "ДФ=dd.MM.yyyy"));
		Описание.Вставить("НачалоПросрочки", Формат(АУ_ОбщиеПроцедурыИФункцииСервер.ПолучитьБлижайшуюРабочуюДату(Выборка.КрайняяДатаПоставки) + 86400, "ДФ=dd.MM.yyyy"));
		
		ТекстОборудование = "";
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			Попытка
				ТЗ = Выборка.Основание.Товары.Выгрузить();
				ТЗ.Свернуть("Номенклатура");
				ТекстОборудование = СтрСоединить(ТЗ.ВыгрузитьКолонку("Номенклатура"), ", ");
			Исключение
			КонецПопытки;
		КонецЕсли;
		Описание.Вставить("ЗаказНоменклатура", ТекстОборудование);
		
		Если Выборка.ПроцентОтгрузки >= 100 Тогда
			Описание.Вставить("СтатусИсполненияКонтракта", "Контракт исполнен в полном объеме");
		Иначе
			Описание.Вставить("СтатусИсполненияКонтракта", "Контракт находится на этапе исполнения");
		КонецЕсли;
		
		//участники
		Запрос.Текст = ТекстЗапросаУчастники;
		Запрос.УстановитьПараметр("ТЗ", Выборка.Ссылка.ПартнерыИКонтактныеЛица.Выгрузить());
		ВыборкаУчастники = Запрос.Выполнить().Выбрать();
		Пока ВыборкаУчастники.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаУчастники.Контрагент) Тогда
				
				СведенияОКонтрагенте = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ВыборкаУчастники.Контрагент, ТекущаяДатаСеанса(),,);
				Описание.Вставить(СтрШаблон("УчастникПолноеНаименование%1", ВыборкаУчастники.НомерСтроки), ВыборкаУчастники.КонтрагентНаименованиеПолное);
				Описание.Вставить(СтрШаблон("УчастникНаименование%1", ВыборкаУчастники.НомерСтроки), СокрЛП(ВыборкаУчастники.Контрагент));
				Описание.Вставить(СтрШаблон("УчастникИНН%1", ВыборкаУчастники.НомерСтроки), ВыборкаУчастники.ИНН);
				Описание.Вставить(СтрШаблон("УчастникКПП%1", ВыборкаУчастники.НомерСтроки), ВыборкаУчастники.КПП);
				Описание.Вставить(СтрШаблон("УчастникЮридическийАдрес%1", ВыборкаУчастники.НомерСтроки), СведенияОКонтрагенте.ЮридическийАдрес);
				Описание.Вставить(СтрШаблон("УчастникЭлектроннаяПочта%1", ВыборкаУчастники.НомерСтроки), СведенияОКонтрагенте.ЭлектроннаяПочта);
				
			КонецЕсли;
			
			Описание.Вставить(СтрШаблон("УчастникКонтактноеЛицо%1", ВыборкаУчастники.НомерСтроки), СокрЛП(ВыборкаУчастники.КонтактноеЛицо));
			Описание.Вставить(СтрШаблон("УчастникПартнер%1", ВыборкаУчастники.НомерСтроки), СокрЛП(ВыборкаУчастники.Партнер));
			
		КонецЦикла;
		
		//контррасчет
		Контррасчет = Новый Массив;
		
		Запрос.Текст = ТекстЗапросаДляКонтррасчета;
		Запрос.УстановитьПараметр("ЗаказКлиента", Выборка.Основание);
		
		Счетчик = 0;
		СуммаРеализаций = 0;
		СуммаНейстойкиПоРеализациям = 0;
		
		ТЗОтгрузок = Запрос.Выполнить().Выгрузить();
		
		Если Выборка.АУ_ВариантРасчетаНеустойки = 0 Тогда
			СтавкаЦБ = Выборка.СтавкаЦБ;
		ИначеЕсли Выборка.АУ_ВариантРасчетаНеустойки = 1 Тогда
			СтавкаЦБ = ТЗОтгрузок[ТЗОтгрузок.Количество() -1].Ставка;
		ИначеЕсли Выборка.АУ_ВариантРасчетаНеустойки = 2 Тогда
			СтавкаНаДату = РегистрыСведений.АУ_СтавкиРефинансированияЦБ.ПолучитьСтавкуНаДату(Выборка.АУ_ДатаКлючевойСтавки);
			СтавкаЦБ = СтавкаНаДату;
		КонецЕсли;
		
		Для каждого ВыборкаКонтррасчет ИЗ ТЗОтгрузок Цикл
			
			Счетчик = Счетчик + 1;
			
			ДанныеСтроки = Новый Структура;
			ДанныеСтроки.Вставить("НомерСтроки", Формат(Счетчик, "ЧГ="));
			ДанныеСтроки.Вставить("ДатаРеализации", Формат(ВыборкаКонтррасчет.Дата, "ДФ=dd.MM.yyyy"));
			ДанныеСтроки.Вставить("НомерРеализации", СокрЛП(ВыборкаКонтррасчет.Номер));
			ДанныеСтроки.Вставить("Реализация", СокрЛП(ВыборкаКонтррасчет.Ссылка));
			ДанныеСтроки.Вставить("Грузополучатель", СокрЛП(ВыборкаКонтррасчет.Грузополучатель.НаименованиеПолное));
			ДанныеСтроки.Вставить("СуммаРеализации", Формат(ВыборкаКонтррасчет.СуммаДокумента, "ЧДЦ=2"));
			
			Если Выборка.АУ_ВариантРасчетаНеустойки = 0 Тогда
				СтавкаДляРасчета = ВыборкаКонтррасчет.Ставка;
			ИначеЕсли Выборка.АУ_ВариантРасчетаНеустойки = 1 Тогда
				СтавкаДляРасчета = ТЗОтгрузок[ТЗОтгрузок.Количество() -1].Ставка;
			ИначеЕсли Выборка.АУ_ВариантРасчетаНеустойки = 2 Тогда
				СтавкаДляРасчета = СтавкаНаДату;
			КонецЕсли;
			
			ДанныеСтроки.Вставить("СтавкаЦБ", Формат(СтавкаДляРасчета, "ЧДЦ=2"));
			
			КоличествоДнейПросрочки = Макс(0, Цел((ВыборкаКонтррасчет.Дата - Выборка.КрайняяДатаПоставки) / 86400));
			ДанныеСтроки.Вставить("КоличествоДнейПросрочки", Формат(КоличествоДнейПросрочки, "ЧДЦ=0"));
			СуммаНеустойки = Окр(ВыборкаКонтррасчет.СуммаДокумента * КоличествоДнейПросрочки / 300 * СтавкаДляРасчета / 100, 2);
			ДанныеСтроки.Вставить("СуммаНеустойки", Формат(СуммаНеустойки, "ЧДЦ=2"));
			
			Контррасчет.Добавить(ДанныеСтроки);
			
			СуммаРеализаций = СуммаРеализаций + ВыборкаКонтррасчет.СуммаДокумента;
			СуммаНейстойкиПоРеализациям = СуммаНейстойкиПоРеализациям + СуммаНеустойки;
			
		КонецЦикла;
		
		КоличествоДнейПросрочки = Макс(0, Цел((НачалоДня(ТекущаяДатаСеанса()) - Выборка.КрайняяДатаПоставки) / 86400));
		СуммаНеустойкиПоНеисполненнымОбязательсвам = Окр((Выборка.ОснованиеСуммаДокумента - СуммаРеализаций) * КоличествоДнейПросрочки / 300 * СтавкаЦБ / 100, 2);
		
		Описание.Вставить("Контррасчет", Контррасчет);
		Описание.Вставить("СуммаОтгрузки", Формат(СуммаРеализаций, "ЧДЦ=2"));
		Описание.Вставить("СуммаНейстойкиПоРеализациям", Формат(СуммаНейстойкиПоРеализациям, "ЧДЦ=2"));
		Описание.Вставить("СуммаНеустойкиПоНеисполненнымОбязательсвам", Формат(СуммаНеустойкиПоНеисполненнымОбязательсвам, "ЧДЦ=2"));
		Описание.Вставить("ОбщаяСуммаНеустойки", Формат(СуммаНейстойкиПоРеализациям + СуммаНеустойкиПоНеисполненнымОбязательсвам, "ЧДЦ=2"));
		
		ДанныеДляПечати.Добавить(Описание);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

&Вместо("ОбработкаПолученияПредставления")
Процедура АУ_ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон("%1 : %2", ?(Данные.ЭтоПретензияПоставщику, "Исходящая", "Входящая"), Данные.Наименование);
	
КонецПроцедуры

&Вместо("ОбработкаПолученияПолейПредставления")
Процедура АУ_ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля = Новый Массив;
	Поля.Добавить("Наименование");
	Поля.Добавить("ЭтоПретензияПоставщику");
	
КонецПроцедуры

&После("ДобавитьКомандыПечати")
Процедура АУ_ДобавитьКомандыПечати(КомандыПечати)
	
	АУ_КонструкторПечатныхФормСервер.ДобавитьКомандыПечатиДляОбъекта(Справочники.Претензии.ПустаяСсылка(), КомандыПечати);
	
КонецПроцедуры

&Вместо("Печать")
Процедура АУ_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	АУ_КонструкторПечатныхФормСервер.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
	ПродолжитьВызов(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
КонецПроцедуры

#КонецОбласти

