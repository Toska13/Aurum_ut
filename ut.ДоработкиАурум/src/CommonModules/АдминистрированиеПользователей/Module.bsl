Функция СоздатьСтруктуруДляПользователя() Экспорт
	
	Результат=Пользователи.НовоеОписаниеПользователяИБ();
	Результат.Вставить("ВходВПрограммуРазрешен",Ложь);
	Результат.Вставить("ПотребоватьСменуПароляПриВходе",Ложь);
	Результат.Вставить("СрокДействияНеОграничен",Ложь);
	Результат.Вставить("СрокДействия",Дата(1,1,1));
	Результат.Вставить("ПросрочкаРаботыВПрограммеДоЗапрещенияВхода",0);
	Результат.Вставить("ПоказыватьВСпискеВыбора",Ложь);
	Если ПользователиСлужебныйПовтИсп.ВерсияПредприятияПоддерживаетВосстановлениеПаролей() Тогда
		Результат.Вставить("АдресЭлектроннойПочты", "");
		Результат.Вставить("ЗапрещеноВосстанавливатьПароль", Истина);
	КонецЕсли;
	Результат.Вставить("ЗапрещеноИзменятьПароль",Ложь);
	Результат.Вставить("ПолноеИмя", "");
	Результат.Вставить("АутентификацияСтандартная", Ложь);
	Результат.Вставить("Имя",                       "");
	Результат.Вставить("Пароль",                    Неопределено);
	Результат.Вставить("СтарыйПароль",              Неопределено);
	Результат.Вставить("АутентификацияOpenID",      Ложь);
	Результат.Вставить("АутентификацияОС",          Ложь);
	Результат.Вставить("ПользовательОС",            "");
	Результат.Вставить("Роли");
	Результат.Вставить("УникальныйИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	Результат.Вставить("СохраняемоеЗначениеПароля", Неопределено);
	Результат.Вставить("ПарольУстановлен",          Ложь);
	Результат.Вставить("ОсновнойИнтерфейс",
		?(Метаданные.ОсновнойИнтерфейс = Неопределено, "", Метаданные.ОсновнойИнтерфейс.Имя));
	Результат.Вставить("РежимЗапуска",              "Авто");
	Результат.Вставить("Язык",
		?(Метаданные.ОсновнойЯзык = Неопределено, "", Метаданные.ОсновнойЯзык.Имя));
	Результат.Вставить("Действие",                    "Записать");
	Возврат Результат;
	
КонецФункции

Функция СоздатьОбновитьПользователя(Наименование,ФизическоеЛицо,Недействителен,ИдентификаторПользователяИБ,Подразделение,Должность,ГруппыДоступа,ДопПараметры=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пользователь = Неопределено;
	
	//1. поиск существующего пользователя в базе
	Если ЗначениеЗаполнено(ИдентификаторПользователяИБ) Тогда
		
		ПользовательИБ=ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдентификаторПользователяИБ));
		ДанныеПользователя = Пользователи.СвойстваПользователяИБ(Новый УникальныйИдентификатор(ИдентификаторПользователяИБ));
		ДанныеПользователя.Вставить("ПотребоватьСменуПароляПриВходе",Ложь);
		ДанныеПользователя.Вставить("СрокДействияНеОграничен",Истина);
		ДанныеПользователя.Вставить("СрокДействия",Дата(1,1,1));
		ДанныеПользователя.Вставить("ПросрочкаРаботыВПрограммеДоЗапрещенияВхода",0);
		ДанныеПользователя.Вставить("ПоказыватьВСпискеВыбора",Истина);
		ДанныеПользователя.Вставить("ВходВПрограммуРазрешен",Ложь);
		ДанныеПользователя.Вставить("Действие","Записать");
		
		ПользователиСлужебный.ПользовательПоИдентификаторуСуществует(Новый УникальныйИдентификатор(ИдентификаторПользователяИБ),, Пользователь);
		
		СвойстваПользователяИБ=Пользователь.СвойстваПользователяИБ.Получить();
		
	Иначе
		
		Пользователь=Справочники.Пользователи.НайтиПоНаименованию(Наименование);
		
		Если ЗначениеЗаполнено(Пользователь) Тогда
			
			ПользовательИБ=ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
			ДанныеПользователя = Пользователи.СвойстваПользователяИБ(Пользователь.ИдентификаторПользователяИБ);
			ДанныеПользователя.Вставить("ПотребоватьСменуПароляПриВходе",Ложь);
			ДанныеПользователя.Вставить("СрокДействияНеОграничен",Истина);
			ДанныеПользователя.Вставить("СрокДействия",Дата(1,1,1));
			ДанныеПользователя.Вставить("ПросрочкаРаботыВПрограммеДоЗапрещенияВхода",0);
			ДанныеПользователя.Вставить("ПоказыватьВСпискеВыбора",Истина);
			ДанныеПользователя.Вставить("ВходВПрограммуРазрешен",Ложь);
			ДанныеПользователя.Вставить("Действие","Записать");
			
			ПользователиСлужебный.ПользовательПоИдентификаторуСуществует(Пользователь.ИдентификаторПользователяИБ,, Пользователь);
			
			СвойстваПользователяИБ=Пользователь.СвойстваПользователяИБ.Получить();
			
		КонецЕсли;
		
	КонецЕсли;
	
	//2. если пользователь не найден в базе то создаем нового
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		
		ДанныеПользователя=СоздатьСтруктуруДляПользователя();
		Пользователь = Справочники.Пользователи.СоздатьЭлемент();
		ПользовательСоздан = Истина;
		
		ДанныеПользователя.ПотребоватьСменуПароляПриВходе=Истина;
		
	Иначе
		Пользователь = Пользователь.ПолучитьОбъект();
		ПользовательСоздан = Ложь;
	КонецЕсли;
	
	//3. заполняем данные пользователя
	ДанныеПользователя.Имя=Наименование;
	ДанныеПользователя.ПолноеИмя=Наименование;
	ДанныеПользователя.ПоказыватьВСпискеВыбора=Истина;
	ДанныеПользователя.АутентификацияСтандартная=Истина;
	
	Пользователь.Наименование=Наименование;
	Пользователь.Недействителен=Недействителен;
	Если НЕ Недействителен Тогда
		ДанныеПользователя.ВходВПрограммуРазрешен=Истина;
	КонецЕсли;
		
	Пользователь.Подразделение=Справочники.СтруктураПредприятия.НайтиПоНаименованию(Подразделение);
	
	Если ТипЗнч(ДопПараметры)=Тип("Структура") Тогда
		
		Если ДопПараметры.Свойство("Телефон") Тогда
			
			ТелефонДобавлен=Ложь;
			Для каждого стрКонтакт Из Пользователь.КонтактнаяИнформация Цикл
				Если стрКонтакт.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонПользователя Тогда
					стрКонтакт.НомерТелефона=ДопПараметры.Телефон;
					стрКонтакт.Представление=ДопПараметры.Телефон;
					ТелефонДобавлен=Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ТелефонДобавлен Тогда
				
				стрКонтакт=Пользователь.КонтактнаяИнформация.Добавить();
				стрКонтакт.Тип=Перечисления.ТипыКонтактнойИнформации.Телефон;
				стрКонтакт.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонПользователя;
				стрКонтакт.НомерТелефона=ДопПараметры.Телефон;
				стрКонтакт.Представление=ДопПараметры.Телефон;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ДопПараметры.Свойство("ЭлектроннаяПочта") Тогда
			
			ПочтаДобавлена=Ложь;
			Для каждого стрКонтакт Из Пользователь.КонтактнаяИнформация Цикл
				Если стрКонтакт.Вид=Справочники.ВидыКонтактнойИнформации.EmailПользователя Тогда
					стрКонтакт.Представление=ДопПараметры.ЭлектроннаяПочта;
					ТелефонДобавлен=Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ПочтаДобавлена Тогда
				
				стрКонтакт=Пользователь.КонтактнаяИнформация.Добавить();
				стрКонтакт.Тип=Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				стрКонтакт.Вид=Справочники.ВидыКонтактнойИнформации.EmailПользователя;
				стрКонтакт.Представление=ДопПараметры.ЭлектроннаяПочта;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Пользователь.ФизическоеЛицо) Тогда
			
			СпрФизЛицо=Справочники.ФизическиеЛица.НайтиПоНаименованию(ФизическоеЛицо);
			Если ЗначениеЗаполнено(СпрФизЛицо) Тогда
				Пользователь.ФизическоеЛицо=СпрФизЛицо;
			Иначе
				
				СпрФизЛицо=Справочники.ФизическиеЛица.СоздатьЭлемент();
				СпрФизЛицо.Наименование=ФизическоеЛицо;
				Если ДопПараметры.Свойство("ДатаРождения") Тогда
					СпрФизЛицо.ДатаРождения=ДопПараметры.ДатаРождения;
				КонецЕсли;
				Если ДопПараметры.Свойство("Пол") Тогда
					Если ДопПараметры.Пол="Мужской" Тогда
						СпрФизЛицо.Пол=Перечисления.ПолФизическогоЛица.Мужской;
					Иначе
						СпрФизЛицо.Пол=Перечисления.ПолФизическогоЛица.Женский;
					КонецЕсли;
				КонецЕсли;
				Если ДопПараметры.Свойство("ИНН") Тогда
					СпрФизЛицо.ИНН=ДопПараметры.ИНН;
				КонецЕсли;
				СпрФизЛицо.Записать();
				
				Пользователь.ФизическоеЛицо=СпрФизЛицо.Ссылка;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//4. записываем пользователя в базу
	Пользователь.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ",ДанныеПользователя);
	Пользователь.Записать();
	
	ПользователиСлужебный.ЗаписатьСведенияОПользователе(ДанныеПользователя, Пользователь);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПослеЗаписиНаСервере(Пользователь, Пользователь, Неопределено);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Обсуждения") Тогда
		МодульОбсуждения = ОбщегоНазначения.ОбщийМодуль("Обсуждения");
		МодульОбсуждения.ОбновитьПользователяВСистемеВзаимодействия(Пользователь);
	КонецЕсли;
	
	//5. устанавливаем права доступа
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь",Пользователь.Ссылка);
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
				|ГДЕ
				|	ГруппыДоступаПользователи.Пользователь = &Пользователь";
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ГруппаНайдена=Ложь;
		Для каждого стрГруппаДоступа Из ГруппыДоступа Цикл
			
			Если стрГруппаДоступа=СокрЛП(Выборка.Ссылка) Тогда
				ГруппаНайдена=Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ГруппаНайдена Тогда
			ТекОбъект=Выборка.Ссылка.ПолучитьОбъект();
			ТекОбъект.Пользователи.Удалить(ТекОбъект.Пользователи.Найти(Пользователь.Ссылка));
			ТекОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого стрГруппаДоступа Из ГруппыДоступа Цикл
		
		ГруппаДоступа=Справочники.ГруппыДоступа.НайтиПоНаименованию(стрГруппаДоступа);
		Если ЗначениеЗаполнено(ГруппаДоступа) Тогда
			
			ТекОбъект=ГруппаДоступа.ПолучитьОбъект();
			НоваяСтрока=ТекОбъект.Пользователи.Добавить();
			НоваяСтрока.Пользователь=Пользователь.Ссылка;
			ТекОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Пользователь;
	
КонецФункции