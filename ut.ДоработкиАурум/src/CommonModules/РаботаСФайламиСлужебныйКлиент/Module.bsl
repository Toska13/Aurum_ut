
&ИзменениеИКонтроль("ОтправитьФайлыПоПочтеНастройкаУчетнойЗаписиПредложена")
Процедура АУ_ОтправитьФайлыПоПочтеНастройкаУчетнойЗаписиПредложена(УчетнаяЗаписьНастроена, ДополнительныеПараметры)

	Если УчетнаяЗаписьНастроена <> Истина Тогда
		Возврат;
	КонецЕсли;

	СписокВложений = РаботаСФайламиСлужебныйВызовСервера.ПоместитьФайлыВоВременноеХранилище(ДополнительныеПараметры);
	ПараметрыОтправки = ДополнительныеПараметры.ПараметрыОтправки;

	#Вставка
	ДанныеПретензии=Неопределено;
	Для каждого стрФайл Из ДополнительныеПараметры.МассивФайлов Цикл
		Если ТипЗнч(стрФайл)=Тип("СправочникСсылка.ПретензииПрисоединенныеФайлы") Тогда
			ДанныеПретензии=АУ_Привелигированный.ПолучитьПараметрыПретензииДляОтправкиПисьмаПоПриложенномуФайлу(стрФайл);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ДанныеПретензии=Неопределено Тогда
		ПараметрыОтправки.Тема=ДанныеПретензии.Тема;
		ПараметрыОтправки.Текст=ДанныеПретензии.Текст;
		ПараметрыОтправки.Получатель=ДанныеПретензии.Получатель;
	КонецЕсли;
	#КонецВставки
	
	ПараметрыОтправки.Вставить("Вложения", СписокВложений);
	ПараметрыОтправки.Вставить("УдалятьФайлыПослеОтправки", Истина);

	МодульРаботаСПочтовымиСообщениямиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаСПочтовымиСообщениямиКлиент");
	МодульРаботаСПочтовымиСообщениямиКлиент.СоздатьНовоеПисьмо(ПараметрыОтправки);

КонецПроцедуры
