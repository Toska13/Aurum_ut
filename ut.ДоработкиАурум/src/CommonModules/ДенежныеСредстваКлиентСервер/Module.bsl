#Область ПрограммныйИнтерфейс

// Пересчитывает СуммаНДС от Суммы (валюта документа) для строк расшифровки,
// у которых валюта взаиморасчётов отличается от валюты документа.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура - документ оплаты с табличной частью РасшифровкаПлатежа.
//
Процедура АУ_ПересчитатьСуммуНДСВалютныхСтрокРасшифровки(Объект) Экспорт

	СтруктураПересчетаСуммы = Новый Структура("ЦенаВключаетНДС", Истина);
	СтруктураДействий = Новый Структура("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();

	ОбрабатываемыеСтроки = Новый Массив;

	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл

		Если ЗначениеЗаполнено(СтрокаРасшифровки.ВалютаВзаиморасчетов)
			И СтрокаРасшифровки.ВалютаВзаиморасчетов <> Объект.Валюта Тогда
			ОбрабатываемыеСтроки.Добавить(СтрокаРасшифровки);
		КонецЕсли;

	КонецЦикла;

	Если ОбрабатываемыеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		Объект.РасшифровкаПлатежа,
		КэшированныеЗначения);

КонецПроцедуры

// Формирует строки суммы и НДС для назначения платежа в формате, согласованном с типовым заполнением.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура - документ оплаты.
//
// Возвращаемое значение:
//  Структура - ТекстСумма, ТекстСуммаНДС, ДобавлятьСтрокуСуммы.
//
Функция АУ_СформироватьСтрокиСуммыИНДСНазначенияПлатежа(Объект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ТекстСумма", "");
	Результат.Вставить("ТекстСуммаНДС", "");
	Результат.Вставить("ДобавлятьСтрокуСуммы", Ложь);

	ФорматЗаказПоставщику = АУ_ЭтоФорматСуммыЗаказПоставщику(Объект);
	Результат.ДобавлятьСтрокуСуммы = ФорматЗаказПоставщику;

	Результат.ТекстСуммаНДС = ДенежныеСредстваСервер.ТекстСуммаНДСПлатежа(
		Объект.Организация, Объект.Валюта, Объект.РасшифровкаПлатежа, Истина);

	Если ФорматЗаказПоставщику Тогда
		ВалютаДляПечати = АУ_ВалютаДляПечатиНазначенияПлатежа(Объект.Валюта);
		Результат.ТекстСумма = "Сумма " + Формат(Объект.СуммаДокумента, "ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ=") + " " + ВалютаДляПечати;
	Иначе
		Результат.ТекстСумма = "Сумма " + Формат(Объект.СуммаДокумента, "ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ=");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Частично обновляет пару строк суммы к оплате и НДС в назначении платежа,
// не изменяя описательную часть. При наличии любой из строк блока обновляются обе.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура - документ оплаты.
//  ПараметрыСинхронизации - Неопределено, Структура - ПересчитатьНДСВалютныхСтрок (Булево, по умолчанию Истина).
//
Процедура АУ_ОбновитьСуммуИНДСВНазначенииПлатежа(Объект, ПараметрыСинхронизации = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Объект.НазначениеПлатежа) Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьНДСВалютныхСтрок = Истина;
	Если ПараметрыСинхронизации <> Неопределено
		И ПараметрыСинхронизации.Свойство("ПересчитатьНДСВалютныхСтрок") Тогда
		ПересчитатьНДСВалютныхСтрок = ПараметрыСинхронизации.ПересчитатьНДСВалютныхСтрок;
	КонецЕсли;

	Если ПересчитатьНДСВалютныхСтрок Тогда
		АУ_ПересчитатьСуммуНДСВалютныхСтрокРасшифровки(Объект);
	КонецЕсли;

	СтрокиСуммыИНДС = АУ_СформироватьСтрокиСуммыИНДСНазначенияПлатежа(Объект);
	ТекстБезНалога = НСтр("ru = 'Без налога (НДС)'");

	СтрокиНазначения = СтрРазделить(Объект.НазначениеПлатежа, Символы.ПС, Ложь);
	БылаСтрокаСуммы = Ложь;
	БылаСтрокаНДС = Ложь;
	ОписательныеСтроки = Новый Массив;

	Для Каждого СтрокаТекста Из СтрокиНазначения Цикл

		Если АУ_ЭтоСтрокаСуммыНазначенияПлатежа(СтрокаТекста) Тогда
			БылаСтрокаСуммы = Истина;
		ИначеЕсли АУ_ЭтоСтрокаНДСНазначенияПлатежа(СтрокаТекста, ТекстБезНалога) Тогда
			БылаСтрокаНДС = Истина;
		Иначе
			ОписательныеСтроки.Добавить(СтрокаТекста);
		КонецЕсли;

	КонецЦикла;

	ОбновлятьБлокСуммыИНДС = БылаСтрокаСуммы
		Или БылаСтрокаНДС
		Или СтрокиСуммыИНДС.ДобавлятьСтрокуСуммы;

	Если Не ОбновлятьБлокСуммыИНДС Тогда
		Возврат;
	КонецЕсли;

	НовыеСтроки = Новый Массив;

	Для Каждого СтрокаТекста Из ОписательныеСтроки Цикл
		НовыеСтроки.Добавить(СтрокаТекста);
	КонецЦикла;

	НовыеСтроки.Добавить(СтрокиСуммыИНДС.ТекстСумма);
	НовыеСтроки.Добавить(СтрокиСуммыИНДС.ТекстСуммаНДС);

	Объект.НазначениеПлатежа = СтрСоединить(НовыеСтроки, Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АУ_ЭтоФорматСуммыЗаказПоставщику(Объект)

	Попытка
		Возврат ЗначениеЗаполнено(Объект.ДокументОснование)
			И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику");
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция АУ_ВалютаДляПечатиНазначенияПлатежа(Валюта)

	РеквизитыВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Валюта, "Код, Наименование");

	Если РеквизитыВалюты.Код = "643" Тогда
		Возврат НСтр("ru = 'руб.'");
	КонецЕсли;

	Возврат СокрЛП(РеквизитыВалюты.Наименование);

КонецФункции

Функция АУ_ЭтоСтрокаСуммыНазначенияПлатежа(СтрокаТекста)

	Если СтрНачинаетсяС(СтрокаТекста, "Сумма ") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНачинаетсяС(НРег(СтрокаТекста), "сумма к оплате");

КонецФункции

Функция АУ_ЭтоСтрокаНДСНазначенияПлатежа(СтрокаТекста, ТекстБезНалога)

	Возврат СтрНачинаетсяС(СтрокаТекста, "В т.ч.")
		Или СтрокаТекста = ТекстБезНалога;

КонецФункции

&Вместо("ПересчитатьПодчиненныеСтрокиДерева")
Процедура АУ_ПересчитатьПодчиненныеСтрокиДерева(СтрокаДерева, ДнейПланирования)
	
	Если СтрокаДерева.ВидСтроки = 0 Тогда // Остаток в валюте ДС, либо в валюте платежа
		
		Попытка
			НачальныйОстаток = СтрокаДерева.Остаток;
		Исключение
		КонецПопытки;
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = НачальныйОстаток + СтрокаДерева["День" + Инд + "ВВалюте"];
				НачальныйОстаток = СтрокаДерева["День" + Инд];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.Просрочено;
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаДерева.ВидСтроки = 2 Тогда // Остаток в одной валюте
		
		Попытка
			СтрокаДерева.Остаток = СтрокаДерева.ОстатокВОднойВалюте;
			НачальныйОстаток = СтрокаДерева.ОстатокВОднойВалюте;
		Исключение
		КонецПопытки;
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = НачальныйОстаток + СтрокаДерева["День" + Инд + "ВОднойВалюте"];
				НачальныйОстаток = СтрокаДерева["День" + Инд];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.ПросроченоВОднойВалюте;
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаДерева.ВидСтроки = 1 Тогда // Оборот в валюте ДС, либо в валюте платежа
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = СтрокаДерева["День" + Инд + "ВВалюте"];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.Просрочено;
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаДерева.ВидСтроки = 3 Тогда // Оборот в одной валюте
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = СтрокаДерева["День" + Инд + "ВОднойВалюте"];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.ПросроченоВОднойВалюте;
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Если ТипЗнч(СтрокаДерева) = Тип("ДанныеФормыЭлементДерева") Тогда
		Строки = СтрокаДерева.ПолучитьЭлементы();
	Иначе
		Строки = СтрокаДерева.Строки;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из Строки Цикл
		ПересчитатьПодчиненныеСтрокиДерева(СтрокаДерева, ДнейПланирования);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
