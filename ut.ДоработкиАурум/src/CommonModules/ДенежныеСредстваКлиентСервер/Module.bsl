#Область ПрограммныйИнтерфейс

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Подставляет в назначение платежа строки суммы документа и суммы НДС.
// Описательную часть текста не меняет. Срезает прежние сумма/НДС и в отдельных
// строках, и в хвосте той же строки. Пустое назначение не заполняет.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура - документ оплаты.
//
Процедура АУ_ОбновитьСуммуИНДСВНазначенииПлатежа(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект.НазначениеПлатежа) Тогда
		Возврат;
	КонецЕсли;

	ТекстСумма = "Сумма " + Формат(Объект.СуммаДокумента, "ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ=");
	ТекстСуммаНДС = ДенежныеСредстваСервер.ТекстСуммаНДСПлатежа(
		Объект.Организация, Объект.Валюта, Объект.РасшифровкаПлатежа, Истина);
	ТекстБезНалога = НСтр("ru = 'Без налога (НДС)'");

	ОписательныеСтроки = Новый Массив;

	Для Каждого СтрокаТекста Из СтрРазделить(Объект.НазначениеПлатежа, Символы.ПС, Ложь) Цикл

		ОчищеннаяСтрока = АУ_ОчиститьСтрокуНазначенияОтСуммыИНДС(СтрокаТекста, ТекстБезНалога);

		Если Не ПустаяСтрока(ОчищеннаяСтрока) Тогда
			ОписательныеСтроки.Добавить(ОчищеннаяСтрока);
		КонецЕсли;

	КонецЦикла;

	ОписательныеСтроки.Добавить(ТекстСумма);
	ОписательныеСтроки.Добавить(ТекстСуммаНДС);

	Объект.НазначениеПлатежа = СтрСоединить(ОписательныеСтроки, Символы.ПС);

КонецПроцедуры

// Синхронизирует суммы строк расшифровки платежа с суммой документа в шапке,
// пересчитывает суммы взаиморасчётов, НДС и (опционально) статьи бюджета.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура - ЗРДС или Списание с РасшифровкаПлатежа.
//  Параметры - Структура:
//   * ВалютаРеглУчета - СправочникСсылка.Валюты - обязательный;
//   * ВалютаБанковскогоСчета - СправочникСсылка.Валюты - для пересчёта в валюте отправителя;
//   * СинхронизироватьСуммыСтрок - Булево - вызвать типовой ПересчитатьСуммыВСтрокеРасшифровкиПлатежа (по умолчанию Истина);
//   * ПересчитатьСуммыВВалютеОтправителя - Булево - для платежа с конвертацией (по умолчанию Ложь);
//   * СинхронизироватьСтатьиБюджета - Булево - пропорционально пересчитать АУ_СтатьиБюджета (по умолчанию Истина).
//
Процедура АУ_СинхронизироватьРасшифровкуПоСуммеДокумента(Объект, Параметры) Экспорт

	Если Не АУ_ОбъектИмеетРасшифровкуПлатежа(Объект)
		Или Параметры = Неопределено
		Или Не Параметры.Свойство("ВалютаРеглУчета") Тогда
		Возврат;
	КонецЕсли;

	СинхронизироватьСуммыСтрок = Истина;
	Если Параметры.Свойство("СинхронизироватьСуммыСтрок") Тогда
		СинхронизироватьСуммыСтрок = Параметры.СинхронизироватьСуммыСтрок;
	КонецЕсли;

	Если СинхронизироватьСуммыСтрок
		И (Объект.РасшифровкаПлатежа.Количество() = 0
			Или Объект.РасшифровкаПлатежа.Итог("Сумма") <> Объект.СуммаДокумента) Тогда

		ФинансыКлиентСервер.ПересчитатьСуммыВСтрокеРасшифровкиПлатежа(Объект, Объект.СуммаДокумента, Ложь);

	КонецЕсли;

	АУ_ПересчитатьСуммыВзаиморасчетовРасшифровки(Объект, Параметры.ВалютаРеглУчета);
	АУ_ПересчитатьСуммуНДСРасшифровки(Объект);

	ПересчитатьСуммыВВалютеОтправителя = Ложь;
	Если Параметры.Свойство("ПересчитатьСуммыВВалютеОтправителя") Тогда
		ПересчитатьСуммыВВалютеОтправителя = Параметры.ПересчитатьСуммыВВалютеОтправителя;
	КонецЕсли;

	Если ПересчитатьСуммыВВалютеОтправителя
		И АУ_ОбъектПлатежСКонвертацией(Объект) Тогда

		ВалютаБанковскогоСчета = Неопределено;
		Если Параметры.Свойство("ВалютаБанковскогоСчета") Тогда
			ВалютаБанковскогоСчета = Параметры.ВалютаБанковскогоСчета;
		КонецЕсли;

		ДенежныеСредстваСервер.РассчитатьСуммыВВалютеОтправителяВРасшифровке(Объект, ВалютаБанковскогоСчета);

	КонецЕсли;

	СинхронизироватьСтатьиБюджета = Истина;
	Если Параметры.Свойство("СинхронизироватьСтатьиБюджета") Тогда
		СинхронизироватьСтатьиБюджета = Параметры.СинхронизироватьСтатьиБюджета;
	КонецЕсли;

	Если СинхронизироватьСтатьиБюджета Тогда
		АУ_СинхронизироватьСтатьиБюджетаПоСуммеДокумента(Объект);
	КонецЕсли;

КонецПроцедуры

// Возвращает Истина, если итог расшифровки не совпадает с суммой документа при непустой ТЧ.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура.
//
// Возвращаемое значение:
//  Булево
//
Функция АУ_ЕстьРасхождениеСуммыДокументаИРасшифровки(Объект) Экспорт

	Если Не АУ_ОбъектИмеетРасшифровкуПлатежа(Объект) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Объект.РасшифровкаПлатежа.Итог("Сумма") <> Объект.СуммаДокумента;

КонецФункции

// Пропорционально пересчитывает суммы АУ_СтатьиБюджета под сумму документа.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура.
//
Процедура АУ_СинхронизироватьСтатьиБюджетаПоСуммеДокумента(Объект) Экспорт

	Попытка
		СтатьиБюджета = Объект.АУ_СтатьиБюджета;
	Исключение
		Возврат;
	КонецПопытки;

	Если СтатьиБюджета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если СтатьиБюджета.Количество() = 1 Тогда
		СтатьиБюджета[0].Сумма = Объект.СуммаДокумента;
		Возврат;
	КонецЕсли;

	СуммаСтатей = СтатьиБюджета.Итог("Сумма");

	Если СуммаСтатей = Объект.СуммаДокумента Тогда
		Возврат;
	КонецЕсли;

	Если СуммаСтатей = 0 Тогда

		СтатьиБюджета[СтатьиБюджета.Количество() - 1].Сумма = Объект.СуммаДокумента;
		Возврат;

	КонецЕсли;

	Коэффициент = Объект.СуммаДокумента / СуммаСтатей;
	НакопленнаяСумма = 0;
	ПоследнийИндекс = СтатьиБюджета.Количество() - 1;

	Для Индекс = 0 По ПоследнийИндекс - 1 Цикл

		СтрокаСтатьи = СтатьиБюджета[Индекс];
		НоваяСумма = Окр(СтрокаСтатьи.Сумма * Коэффициент, 2);
		СтрокаСтатьи.Сумма = НоваяСумма;
		НакопленнаяСумма = НакопленнаяСумма + НоваяСумма;

	КонецЦикла;

	СтатьиБюджета[ПоследнийИндекс].Сумма = Объект.СуммаДокумента - НакопленнаяСумма;

КонецПроцедуры

// Проверяет согласованность суммы документа и расшифровки; при расхождении сообщает пользователю.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура.
//  Отказ - Булево - устанавливается в Истина при расхождении.
//
Процедура АУ_ПроверитьСогласованностьСуммыДокументаИРасшифровки(Объект, Отказ) Экспорт

	Если Не АУ_ЕстьРасхождениеСуммыДокументаИРасшифровки(Объект) Тогда
		Возврат;
	КонецЕсли;

	ТекстСообщения = НСтр("ru = 'Сумма документа (%1) не совпадает с итогом расшифровки платежа (%2).'");
	ТекстСообщения = СтрШаблон(
		ТекстСообщения,
		Формат(Объект.СуммаДокумента, "ЧДЦ=2; ЧГ="),
		Формат(Объект.РасшифровкаПлатежа.Итог("Сумма"), "ЧДЦ=2; ЧГ="));

	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.СуммаДокумента", , Отказ);

КонецПроцедуры

// Возвращает Истина, если НДС расшифровки не должен считаться по ставке:
// ЗРДС на основании заказа поставщику с совпадающими валютой и суммой,
// либо списание с ЗРДС при совпадающих валюте и сумме.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура.
//
// Возвращаемое значение:
//  Булево
//
Функция АУ_НДСБезРасчетаПоСтавке(Объект) Экспорт

	Возврат АУ_ЭтоЗаявкаСНДСИзЗаказа(Объект) Или АУ_ЭтоСписаниеСНДСИзЗаявки(Объект);

КонецФункции

// Заполняет СуммаНДС строк расшифровки ЗРДС из Товары заказа-основания
// (только незакрытые строки). Если условия совпадения не выполнены — ничего не делает.
//
// Параметры:
//  Объект - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств, ДанныеФормыСтруктура.
//
Процедура АУ_ЗаполнитьСуммуНДСИзЗаказаПоставщику(Объект) Экспорт

	Если Не АУ_ЭтоЗаявкаСНДСИзЗаказа(Объект) Тогда
		Возврат;
	КонецЕсли;

	Если Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(Товары.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|	И НЕ Товары.Отменено
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.СтавкаНДС";
	Запрос.УстановитьПараметр("Заказ", Объект.ДокументОснование);
	ТаблицаНДС = Запрос.Выполнить().Выгрузить();

	Если Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
		Объект.РасшифровкаПлатежа[0].СуммаНДС = ТаблицаНДС.Итог("СуммаНДС");
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл

		СтрокаНДС = ТаблицаНДС.Найти(СтрокаРасшифровки.СтавкаНДС, "СтавкаНДС");

		Если СтрокаНДС <> Неопределено Тогда
			СтрокаРасшифровки.СуммаНДС = СтрокаНДС.СуммаНДС;
			ТаблицаНДС.Удалить(СтрокаНДС);
		Иначе
			СтрокаРасшифровки.СуммаНДС = 0;
		КонецЕсли;

	КонецЦикла;

	Если ТаблицаНДС.Количество() > 0 И Объект.РасшифровкаПлатежа.Количество() > 0 Тогда

		ПоследняяСтрока = Объект.РасшифровкаПлатежа[Объект.РасшифровкаПлатежа.Количество() - 1];
		ПоследняяСтрока.СуммаНДС = ПоследняяСтрока.СуммаНДС + ТаблицаНДС.Итог("СуммаНДС");

	КонецЕсли;

КонецПроцедуры

// Копирует СуммаНДС и СтавкаНДС из расшифровки ЗРДС в расшифровку списания.
// Если условия совпадения не выполнены — ничего не делает.
//
// Параметры:
//  Объект - ДокументОбъект.СписаниеБезналичныхДенежныхСредств, ДанныеФормыСтруктура.
//
Процедура АУ_ЗаполнитьСуммуНДСИзЗаявки(Объект) Экспорт

	Если Не АУ_ЭтоСписаниеСНДСИзЗаявки(Объект) Тогда
		Возврат;
	КонецЕсли;

	Если Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расшифровка.НомерСтроки КАК НомерСтроки,
	|	Расшифровка.СтавкаНДС КАК СтавкаНДС,
	|	Расшифровка.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК Расшифровка
	|ГДЕ
	|	Расшифровка.Ссылка = &Заявка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Заявка", Объект.ЗаявкаНаРасходованиеДенежныхСредств);
	ТаблицаНДС = Запрос.Выполнить().Выгрузить();

	Если ТаблицаНДС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ТаблицаНДС.Количество() = Объект.РасшифровкаПлатежа.Количество() Тогда

		Индекс = 0;

		Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл

			СтрокаРасшифровки.СуммаНДС = ТаблицаНДС[Индекс].СуммаНДС;
			СтрокаРасшифровки.СтавкаНДС = ТаблицаНДС[Индекс].СтавкаНДС;
			Индекс = Индекс + 1;

		КонецЦикла;

		Возврат;

	КонецЕсли;

	ОстатокНДС = ТаблицаНДС.Скопировать();

	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл

		СтрокаНДС = ОстатокНДС.Найти(СтрокаРасшифровки.СтавкаНДС, "СтавкаНДС");

		Если СтрокаНДС <> Неопределено Тогда

			СтрокаРасшифровки.СуммаНДС = СтрокаНДС.СуммаНДС;
			СтрокаРасшифровки.СтавкаНДС = СтрокаНДС.СтавкаНДС;
			ОстатокНДС.Удалить(СтрокаНДС);

		КонецЕсли;

	КонецЦикла;

	Если ОстатокНДС.Количество() > 0 И Объект.РасшифровкаПлатежа.Количество() > 0 Тогда

		ПоследняяСтрока = Объект.РасшифровкаПлатежа[Объект.РасшифровкаПлатежа.Количество() - 1];
		ПоследняяСтрока.СуммаНДС = ПоследняяСтрока.СуммаНДС + ОстатокНДС.Итог("СуммаНДС");

	КонецЕсли;

КонецПроцедуры

#КонецЕсли

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АУ_ОбъектИмеетРасшифровкуПлатежа(Объект)

	Попытка
		Возврат Объект.РасшифровкаПлатежа <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция АУ_ОбъектПлатежСКонвертацией(Объект)

	Попытка
		Возврат Объект.ПлатежСКонвертацией;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция АУ_ЭтоЗаявкаСНДСИзЗаказа(Объект)

	Попытка
		ДокументОснование = Объект.ДокументОснование;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ДокументОснование)
		Или ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Возврат Ложь;
	КонецЕсли;

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Валюта, СуммаДокумента");

	Возврат РеквизитыЗаказа.Валюта = Объект.Валюта
		И РеквизитыЗаказа.СуммаДокумента = Объект.СуммаДокумента;

КонецФункции

Функция АУ_ЭтоСписаниеСНДСИзЗаявки(Объект)

	Попытка
		Заявка = Объект.ЗаявкаНаРасходованиеДенежныхСредств;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Заявка)
		Или ТипЗнч(Заявка) <> Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		Возврат Ложь;
	КонецЕсли;

	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка, "Валюта, СуммаДокумента");

	Возврат РеквизитыЗаявки.Валюта = Объект.Валюта
		И РеквизитыЗаявки.СуммаДокумента = Объект.СуммаДокумента;

КонецФункции

Процедура АУ_ПересчитатьСуммыВзаиморасчетовРасшифровки(Объект, ВалютаРеглУчета)

	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл

		Если ЗначениеЗаполнено(СтрокаРасшифровки.ВалютаВзаиморасчетов)
			И СтрокаРасшифровки.ВалютаВзаиморасчетов <> Объект.Валюта Тогда

			ДенежныеСредстваКлиентСервер.РассчитатьСуммуВзаиморасчетовВСтрокеРасшифровки(
				СтрокаРасшифровки, Объект.Валюта, ВалютаРеглУчета);

		Иначе
			СтрокаРасшифровки.СуммаВзаиморасчетов = СтрокаРасшифровки.Сумма;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура АУ_ПересчитатьСуммуНДСРасшифровки(Объект)

	Если АУ_ЭтоЗаявкаСНДСИзЗаказа(Объект) Тогда
		АУ_ЗаполнитьСуммуНДСИзЗаказаПоставщику(Объект);
		Возврат;
	КонецЕсли;

	Если АУ_ЭтоСписаниеСНДСИзЗаявки(Объект) Тогда
		Возврат;
	КонецЕсли;

	СтруктураПересчетаСуммы = Новый Структура("ЦенаВключаетНДС", Истина);
	СтруктураДействий = Новый Структура("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.РасшифровкаПлатежа, СтруктураДействий);

КонецПроцедуры

// Убирает автодобавленные сумма/НДС: целую строку или хвост описательной строки.
//
Функция АУ_ОчиститьСтрокуНазначенияОтСуммыИНДС(Знач СтрокаТекста, ТекстБезНалога)

	СтрокаТекста = СокрЛП(СтрокаТекста);

	Если Не ЗначениеЗаполнено(СтрокаТекста) Тогда
		Возврат "";
	КонецЕсли;

	Если СтрНачинаетсяС(НРег(СтрокаТекста), "сумма к оплате") Тогда
		Возврат "";
	КонецЕсли;

	Если АУ_ЭтоАвтострокаСуммыПлатежа(СтрокаТекста) Тогда
		Возврат "";
	КонецЕсли;

	Если СтрНачинаетсяС(СтрокаТекста, "В т.ч.") Или СтрокаТекста = ТекстБезНалога Тогда
		Возврат "";
	КонецЕсли;

	ПозицияСуммы = СтрНайти(СтрокаТекста, " Сумма ", НаправлениеПоиска.СКонца);

	Если ПозицияСуммы > 0 Тогда

		Хвост = СокрЛП(Сред(СтрокаТекста, ПозицияСуммы + 1));

		Если АУ_ЭтоАвтострокаСуммыПлатежа(Хвост) Тогда
			СтрокаТекста = СокрП(Лев(СтрокаТекста, ПозицияСуммы - 1));
		КонецЕсли;

	КонецЕсли;

	ПозицияНДС = СтрНайти(СтрокаТекста, " В т.ч.", НаправлениеПоиска.СКонца);

	Если ПозицияНДС > 0 Тогда

		Хвост = СокрЛП(Сред(СтрокаТекста, ПозицияНДС + 1));

		Если СтрНачинаетсяС(Хвост, "В т.ч.") И СтрНайти(Хвост, "НДС") > 0 Тогда
			СтрокаТекста = СокрП(Лев(СтрокаТекста, ПозицияНДС - 1));
		КонецЕсли;

	КонецЕсли;

	Если СтрЗаканчиваетсяНа(СтрокаТекста, ТекстБезНалога) Тогда

		ДлинаБезНалога = СтрДлина(ТекстБезНалога);
		СтрокаТекста = СокрП(Лев(СтрокаТекста, СтрДлина(СтрокаТекста) - ДлинаБезНалога));

	КонецЕсли;

	Возврат СокрП(СтрокаТекста);

КонецФункции

Функция АУ_ЭтоАвтострокаСуммыПлатежа(СтрокаТекста)

	Если Не СтрНачинаетсяС(СтрокаТекста, "Сумма ") Тогда
		Возврат Ложь;
	КонецЕсли;

	ПослеПрефикса = СокрЛП(Сред(СтрокаТекста, СтрДлина("Сумма ") + 1));

	Если Не ЗначениеЗаполнено(ПослеПрефикса) Тогда
		Возврат Ложь;
	КонецЕсли;

	Цифры = "0123456789";

	Возврат СтрНайти(Цифры, Лев(ПослеПрефикса, 1)) > 0;

КонецФункции

#КонецЕсли

&Вместо("ПересчитатьПодчиненныеСтрокиДерева")
Процедура АУ_ПересчитатьПодчиненныеСтрокиДерева(СтрокаДерева, ДнейПланирования)
	
	Если СтрокаДерева.ВидСтроки = 0 Тогда // Остаток в валюте ДС, либо в валюте платежа
		
		Попытка
			НачальныйОстаток = СтрокаДерева.Остаток;
		Исключение
		КонецПопытки;
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = НачальныйОстаток + СтрокаДерева["День" + Инд + "ВВалюте"];
				НачальныйОстаток = СтрокаДерева["День" + Инд];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.Просрочено;
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаДерева.ВидСтроки = 2 Тогда // Остаток в одной валюте
		
		Попытка
			СтрокаДерева.Остаток = СтрокаДерева.ОстатокВОднойВалюте;
			НачальныйОстаток = СтрокаДерева.ОстатокВОднойВалюте;
		Исключение
		КонецПопытки;
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = НачальныйОстаток + СтрокаДерева["День" + Инд + "ВОднойВалюте"];
				НачальныйОстаток = СтрокаДерева["День" + Инд];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.ПросроченоВОднойВалюте;
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаДерева.ВидСтроки = 1 Тогда // Оборот в валюте ДС, либо в валюте платежа
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = СтрокаДерева["День" + Инд + "ВВалюте"];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.Просрочено;
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаДерева.ВидСтроки = 3 Тогда // Оборот в одной валюте
		
		Для Инд = 0 По ДнейПланирования Цикл
			
			Попытка
				СтрокаДерева["День" + Инд] = СтрокаДерева["День" + Инд + "ВОднойВалюте"];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Попытка
			СтрокаДерева.День0 = СтрокаДерева.ПросроченоВОднойВалюте;
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Если ТипЗнч(СтрокаДерева) = Тип("ДанныеФормыЭлементДерева") Тогда
		Строки = СтрокаДерева.ПолучитьЭлементы();
	Иначе
		Строки = СтрокаДерева.Строки;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из Строки Цикл
		ПересчитатьПодчиненныеСтрокиДерева(СтрокаДерева, ДнейПланирования);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
