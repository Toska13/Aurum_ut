		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ФИО, "Имя", "-", , Ошибки);
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Подписант, "ФИО", ФИО, Истина, Ошибки);
		
		#Вставка
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ФИО, "Фамилия", "Бондарев", , Ошибки);
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ФИО, "Имя", "Александр", , Ошибки);
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ФИО, "Отчество", "Михайлович", , Ошибки);
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Подписант, "ФИО", ФИО, Истина, Ошибки);
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Подписант, "Должн", "Генеральный директор", Истина, Ошибки);
		#КонецВставки
		Документ.Подписант.Добавить(Подписант);
		
	КонецЕсли;

	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Файл, "Документ", Документ, Истина, Ошибки);	
		
	ПроверитьОбъектXDTO(Файл, Ошибки);
	
	Результат = НовыйРезультатЗаполненияДокумента();
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		
		Результат.Ошибки = Ошибки;
		
	Иначе
		
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			ВидДокумента = "УПДПрод";
			МодульЭлектронноеАктированиеЕИС.ПриФормированииДвоичныхДанныхЭД(
				ВидДокумента, Файл, ДеревоДанных);
		КонецЕсли;
		
		ДвоичныеДанные = ДвоичныеДанныеОбъектаXDTO(Файл, , , "Файл");
		Результат.ДанныеОсновногоФайла.ДвоичныеДанные =
			ОбщегоНазначенияБЭД.УдалитьПространствоИмен(ДвоичныеДанные, ПространствоИмен);
		
		ИмяФайлаПоУмолчанию = ИдентификаторФайлаXML + ".xml";
		Результат.ДанныеОсновногоФайла.ИмяФайла = ИмяФайлаПоУмолчанию;
		
		// Формирование приложения для ЕИС в сфере закупок.
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			РезультатСозданияПриложения = МодульЭлектронноеАктированиеЕИС.
				СформироватьДанныеПриложенияУПДДляЕИС(ДеревоДанных, ИдентификаторФайлаXML);
			Если НЕ РезультатСозданияПриложения.Выполнено Тогда
				ОбщегоНазначенияБЭД.ДобавитьОшибку(
					Результат.Ошибки, РезультатСозданияПриложения.ОписаниеОшибки);
			КонецЕсли;
				
			Результат.ДанныеДополнительногоФайла.ДвоичныеДанные =
				РезультатСозданияПриложения.ДвоичныеДанные;
			Результат.ДанныеДополнительногоФайла.ИмяФайла =
				РезультатСозданияПриложения.ИмяФайла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&ИзменениеИКонтроль("ИдентификаторФайла_УПД_5_02_ИнформацияПродавца")
Функция АУ_ИдентификаторФайла_УПД_5_02_ИнформацияПродавца(Знач Данные, Знач ДатаФормирования)

	ЕстьПрослеживание = Ложь;
	ЕстьМаркировка = Ложь;
	Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";

	СведенияОбОтгруженныхПозициях = Данные.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого ТекущаяПозиция Из СведенияОбОтгруженныхПозициях.Строки Цикл

		Прослеживание = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(
		ТекущаяПозиция, Путь + ".НомерСтроки.СведенияОПрослеживаемости");
		Маркировка = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(
		ТекущаяПозиция, Путь + ".НомерСтроки.СведенияОМаркировке");
		ЕстьПрослеживание = ЕстьПрослеживание Или ЗначениеЗаполнено(Прослеживание);		
		ЕстьМаркировка = ЕстьМаркировка Или ЗначениеЗаполнено(Маркировка);

		Если ЕстьПрослеживание И ЕстьМаркировка Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Участники = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
	Данные, "Участники");
	УникальныйИдентификатор = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
	Данные, "УникальныйИдентификатор");
	ЕстьАлкогольнаяПродукция = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
	Данные, "ЕстьАлкогольнаяПродукция");
	ЕстьТабачнаяПродукция = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
	Данные, "ЕстьТабачнаяПродукция");
	ЕстьНефтепродукты = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
	Данные, "ЕстьНефтепродукты");
	СвободноеДвузначноеЧисло = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
	Данные, "СвободноеДвузначноеЧисло");

	#Удаление
	ИдентификаторФайла = СтрШаблон("ON_NSCHFDOPPR_%1_%2_%3_%4_%5_%6_%7_%8_%9_%10",
	Участники.ИдентификаторПолучателя,
	Участники.ИдентификаторОтправителя,
	Формат(ДатаФормирования, "ДФ=yyyyMMdd"),
	УникальныйИдентификатор,
	?(ЕстьПрослеживание, "1", "0"),
	?(ЕстьМаркировка, "1", "0"),
	?(ЗначениеЗаполнено(ЕстьАлкогольнаяПродукция), "1", "0"),
	?(ЗначениеЗаполнено(ЕстьТабачнаяПродукция), "1", "0"),
	?(ЗначениеЗаполнено(ЕстьНефтепродукты), "1", "0"),
	?(ЗначениеЗаполнено(СвободноеДвузначноеЧисло), Формат(СвободноеДвузначноеЧисло, "ЧЦ=2; ЧВН=; ЧГ=0"), "00"));
	#КонецУдаления
	#Вставка
	ИдентификаторФайла = СтрШаблон("ON_NSCHFDOPPR_%1_%2_%3_%4_%5_%6_%7_%8_%9_%10",
	Участники.ИдентификаторПолучателя,
	"2LT-11001655906",
	Формат(ДатаФормирования, "ДФ=yyyyMMdd"),
	УникальныйИдентификатор,
	?(ЕстьПрослеживание, "1", "0"),
	?(ЕстьМаркировка, "1", "0"),
	?(ЗначениеЗаполнено(ЕстьАлкогольнаяПродукция), "1", "0"),
	?(ЗначениеЗаполнено(ЕстьТабачнаяПродукция), "1", "0"),
	?(ЗначениеЗаполнено(ЕстьНефтепродукты), "1", "0"),
	?(ЗначениеЗаполнено(СвободноеДвузначноеЧисло), Формат(СвободноеДвузначноеЧисло, "ЧЦ=2; ЧВН=; ЧГ=0"), "00"));
	#КонецВставки

	Возврат ИдентификаторФайла;

КонецФункции

