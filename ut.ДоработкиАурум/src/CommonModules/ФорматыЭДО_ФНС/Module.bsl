#Область ПрограммныйИнтерфейс

&ИзменениеИКонтроль("ЗаполнитьДокумент_УПД_5_03_ИнформацияПродавца")
Функция АУ_ЗаполнитьДокумент_УПД_5_03_ИнформацияПродавца(Знач ДеревоДанных)

	ДатаФормирования = ТекущаяДатаСеанса();
	ИдентификаторФайлаXML = ИдентификаторФайла_УПД_5_02_ИнформацияПродавца(ДеревоДанных, ДатаФормирования);
	
	ПространствоИмен = ПространствоИмен_УПД_5_03_ИнформацияПродавца();
	Пакет = ФабрикаXDTO.Пакеты.Получить(ПространствоИмен);
	
	Ошибки = Неопределено; // служебная переменная для хранения списка возникших ошибок
	
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	МодульЭлектронноеАктированиеЕИС = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует(
			"ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС") Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		Если МодульЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
			И ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДанныеЭлектронногоАктированияЕИС") = Истина Тогда
			ЭтоЭлектронноеАктированиеЕИС = Истина;
			МодульЭлектронноеАктированиеЕИС.ПередФормированиемЭлектронногоДокумента(
				ДеревоДанных, ПространствоИмен);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОКомиссионере")) Тогда
		СведенияКомиссионера = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
		ЗаполнитьСведенияОбУчастникеУПД_5_02(СведенияКомиссионера, ДеревоДанных, Ошибки, ПространствоИмен, "СведенияОКомиссионере");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, СведенияКомиссионера);
		
		СтрXML = ЗаписьXML.Закрыть();
		НачПоз = СтрНайти(СтрXML, "<ИдСв>");
		КолСимв = СтрНайти(СтрXML, "</ИдСв>") - НачПоз + СтрДлина("</ИдСв>");
		СтрXML = Сред(СтрXML, НачПоз, КолСимв);
		
		ТекстоваяИнформация = Новый ТаблицаЗначений;
		ТекстоваяИнформация.Колонки.Добавить("Идентификатор");
		ТекстоваяИнформация.Колонки.Добавить("Значение");
		НоваяСтрока = ТекстоваяИнформация.Добавить();
		НоваяСтрока.Идентификатор = "ДанныеКомиссионера";
		НоваяСтрока.Значение = СтрXML;
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных,
			НоваяСтрока, "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОКомитенте")) Тогда
		СведенияКомитента = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
		ЗаполнитьСведенияОбУчастникеУПД_5_02(СведенияКомитента, ДеревоДанных, Ошибки, ПространствоИмен, "СведенияОКомитенте");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, СведенияКомитента);
		
		СтрXML = ЗаписьXML.Закрыть();
		НачПоз = СтрНайти(СтрXML, "<ИдСв>");
		КолСимв = СтрНайти(СтрXML, "</ИдСв>") - НачПоз + СтрДлина("</ИдСв>");
		СтрXML = Сред(СтрXML, НачПоз, КолСимв);
		
		ТекстоваяИнформация = Новый ТаблицаЗначений;
		ТекстоваяИнформация.Колонки.Добавить("Идентификатор");
		ТекстоваяИнформация.Колонки.Добавить("Значение");
		НоваяСтрока = ТекстоваяИнформация.Добавить();
		НоваяСтрока.Идентификатор = "ДанныеКомитента";
		НоваяСтрока.Значение = СтрXML;
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных,
			НоваяСтрока, "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПеревозчике")) Тогда
		СведенияПеревозчика = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
		ЗаполнитьСведенияОбУчастникеУПД_5_02(СведенияПеревозчика, ДеревоДанных, Ошибки, ПространствоИмен, "СведенияОПеревозчике");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, СведенияПеревозчика);
		
		СтрXML = ЗаписьXML.Закрыть();
		НачПоз = СтрНайти(СтрXML, "<ИдСв>");
		КолСимв = СтрНайти(СтрXML, "</ИдСв>") - НачПоз + СтрДлина("</ИдСв>");
		СтрXML = Сред(СтрXML, НачПоз, КолСимв);
		
		ТекстоваяИнформация = Новый ТаблицаЗначений;
		ТекстоваяИнформация.Колонки.Добавить("Идентификатор");
		ТекстоваяИнформация.Колонки.Добавить("Значение");
		НоваяСтрока = ТекстоваяИнформация.Добавить();
		НоваяСтрока.Идентификатор = "ДанныеПеревозчика";
		НоваяСтрока.Значение = СтрXML;
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных,
			НоваяСтрока, "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерТранспортнойНакладной")) Тогда
		ТекстоваяИнформация = Новый ТаблицаЗначений;
		ТекстоваяИнформация.Колонки.Добавить("Идентификатор");
		ТекстоваяИнформация.Колонки.Добавить("Значение");
		НоваяСтрока = ТекстоваяИнформация.Добавить();
		НоваяСтрока.Идентификатор = "НомерТранспортнойНакладной";
		НоваяСтрока.Значение = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерТранспортнойНакладной");
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных,
			НоваяСтрока, "СведенияОПередаче.ИнформационноеПолеФХЖ.ТекстоваяИнформация");
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаТранспортнойНакладной")) Тогда
		ТекстоваяИнформация = Новый ТаблицаЗначений;
		ТекстоваяИнформация.Колонки.Добавить("Идентификатор");
		ТекстоваяИнформация.Колонки.Добавить("Значение");
		НоваяСтрока = ТекстоваяИнформация.Добавить();
		НоваяСтрока.Идентификатор = "ДатаТранспортнойНакладной";
		НоваяСтрока.Значение = ДатаФНС(ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаТранспортнойНакладной"));
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных,
			НоваяСтрока, "СведенияОПередаче.ИнформационноеПолеФХЖ.ТекстоваяИнформация");
	КонецЕсли;
	
	СвойствоФайл = Пакет.КорневыеСвойства.Получить("Файл");
	Файл = ПолучитьОбъектТипаCML(СвойствоФайл.Тип, ПространствоИмен);
	
	// Техническая информация по документу.
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Файл, "ИдФайл", ИдентификаторФайлаXML, Истина, Ошибки);
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Файл, "ВерсПрог", ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВерсияПрограммы"),, Ошибки);
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Файл, "ВерсФорм", "5.03", Истина, Ошибки);
	
	СвойствоДокумент = Файл.Свойства().Получить("Документ");
	Документ = ПолучитьОбъектТипаCML(СвойствоДокумент.Тип, ПространствоИмен);
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "КНД", "1115131", Истина, Ошибки);
	УИД = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "УникальныйИдентификаторДокумента");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "УИД", УИД, , Ошибки);
	ФункцияУПД = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "Функция", ФункцияУПД, , Ошибки);
		
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "ДатаИнфПр", Формат(ДатаФормирования, "ДФ=dd.MM.yyyy"), Истина, Ошибки);
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "ВремИнфПр", Формат(ДатаФормирования, "ДФ=HH.mm.ss"), Истина, Ошибки);
	
	НаимЭконСубСост = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "СоставительДокументаНаименование");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "НаимЭконСубСост", НаимЭконСубСост, , Ошибки);
	
	СоглСтрДопИнф = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, "СогласованныеДопПоля");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(Документ, "СоглСтрДопИнф", СоглСтрДопИнф, , Ошибки);
	
	// Сведения о счете-фактуре.
	СвойствоСвСчФакт = Документ.Свойства().Получить("СвСчФакт");
	СвСчФакт = ПолучитьОбъектТипаCML(СвойствоСвСчФакт.Тип, ПространствоИмен);
	Путь = "СведенияОСчетеФактуре.";
	
	НомерДок = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "НомерДокумента");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(СвСчФакт, "НомерДок", НомерДок, Истина, Ошибки);
	
	ДатаДок = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаДокумента");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(СвСчФакт, "ДатаДок", ДатаФНС(ДатаДок), Истина, Ошибки);
	
	ИмяФайлИспрПрод = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ИмяФайлаПродавца");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(СвСчФакт, "ИмяФайлИспрПрод", ИмяФайлИспрПрод, , Ошибки);
	
	ИмяФайлИспрПок = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ИмяФайлаПокупателя");
	РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(СвСчФакт, "ИмяФайлИспрПок", ИмяФайлИспрПок, , Ошибки);
	
	// Исправление.
	Исправление = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Исправление");
	Если ЗначениеЗаполнено(Исправление) Тогда
		СвойствоИспрДок = СвСчФакт.Свойства().Получить("ИспрДок");
		ИспрДок = ПолучитьОбъектТипаCML(СвойствоИспрДок.Тип, ПространствоИмен);
		ИсправлениеПуть = Путь + "Исправление.";
		
		НомИспр = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, ИсправлениеПуть + "НомерИсправления");
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ИспрДок, "НомИспр", НомИспр, Истина, Ошибки);
		
		ДатаИспр = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных, ИсправлениеПуть + "ДатаИсправления");
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ИспрДок, "ДатаИспр", ДатаФНС(ДатаИспр), Истина, Ошибки);
		
		РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(СвСчФакт, "ИспрДок", ИспрДок, , Ошибки);
	КонецЕсли;
	
	// Сведения о продавцах.
	СведенияОПродавцах = ДеревоДанных.Строки.Найти(Путь + "СведенияОПродавцах", "ПолныйПуть", Истина);
	Если ЗначениеЗаполнено(СведенияОПродавцах.Значение) Тогда
		ПродавецПуть = Путь + "СведенияОПродавцах.НомерСтроки.Продавец";
		Для Каждого ТекущийПродавец Из СведенияОПродавцах.Строки Цикл
			Продавец = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
			ЗаполнитьСведенияОбУчастникеУПД_5_02(Продавец, ТекущийПродавец, Ошибки, ПространствоИмен, ПродавецПуть);
			СвСчФакт.СвПрод.Добавить(Продавец);
		КонецЦикла;	
	КонецЕсли;
	
	// Сведения о покупателях.
	СведенияОПокупателях = ДеревоДанных.Строки.Найти(Путь + "СведенияОПокупателях", "ПолныйПуть", Истина);
	Если ЗначениеЗаполнено(СведенияОПокупателях.Значение) Тогда
		ПокупательПуть = Путь + "СведенияОПокупателях.НомерСтроки.Покупатель";
		Для Каждого ТекущийПокупатель Из СведенияОПокупателях.Строки Цикл
			Покупатель = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
			ЗаполнитьСведенияОбУчастникеУПД_5_02(Покупатель, ТекущийПокупатель, Ошибки, ПространствоИмен, ПокупательПуть);
			СвСчФакт.СвПокуп.Добавить(Покупатель);
		КонецЦикла;	
	КонецЕсли;
	
	// Сведения о грузоотправителях.
	СведенияОГрузоотправителях = ДеревоДанных.Строки.Найти(Путь + "СведенияОГрузоотправителях", "ПолныйПуть", Истина);
	Если ЗначениеЗаполнено(СведенияОГрузоотправителях.Значение) Тогда
		
		СвойствоГрузОт = СвСчФакт.Свойства().Получить("ГрузОт");
		ГрузоотправительПуть = Путь + "СведенияОГрузоотправителях.НомерСтроки.Грузоотправитель";
		ОнЖеПуть = Путь + "СведенияОГрузоотправителях.НомерСтроки.ОнЖе";
		
		Для Каждого ТекущийГрузоотправитель Из СведенияОГрузоотправителях.Строки Цикл
			ГрузОт = ПолучитьОбъектТипаCML(СвойствоГрузОт.Тип, ПространствоИмен);
			
			ОнЖе = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ТекущийГрузоотправитель, ОнЖеПуть);
			Если ОнЖе = Истина Тогда
				РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ГрузОт, "ОнЖе", "он же", , Ошибки);
			Иначе
				Грузоотправитель = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
				ЗаполнитьСведенияОбУчастникеУПД_5_02(
					Грузоотправитель, ТекущийГрузоотправитель, Ошибки, ПространствоИмен, ГрузоотправительПуть);
				РаботаСФайламиБЭД.ЗаполнитьСвойствоXDTO(ГрузОт, "ГрузОтпр", Грузоотправитель, Истина, Ошибки);
			КонецЕсли;
			
			СвСчФакт.ГрузОт.Добавить(ГрузОт);
		КонецЦикла;	
	КонецЕсли;
	
	// Сведения о грузополучателях.
	СведенияОГрузополучателях = ДеревоДанных.Строки.Найти(Путь + "СведенияОГрузополучателях", "ПолныйПуть", Истина);
	Если ЗначениеЗаполнено(СведенияОГрузополучателях.Значение) Тогда
		ГрузополучательПуть = Путь + "СведенияОГрузополучателях.НомерСтроки.Грузополучатель";
		Для Каждого ТекущийГрузополучатель Из СведенияОГрузополучателях.Строки Цикл
			Грузополучатель = ПолучитьОбъектТипаCML("УчастникТип", ПространствоИмен);
			ЗаполнитьСведенияОбУчастникеУПД_5_02(Грузополучатель, ТекущийГрузополучатель, Ошибки, ПространствоИмен, ГрузополучательПуть);
