#Область СлужебныеПроцедурыИФункции

&После("ВыполнитьПереопределяемуюКоманду")
Процедура АУ_ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры)
	
	Если Команда.Имя <> "АУ_СообщитьОПроблеме" Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("АУ_ПослеСбораДанныхОбращения", ЭтотОбъект, Форма);
	АУ_СборДанныхТикетаКлиент.СобратьДанныеОбращения(Форма, Оповещение);
	
КонецПроцедуры

// Открывает форму обращения в поддержку после сбора контекста исходной формы.
//
// Параметры:
//  Результат - Структура - см. АУ_СборДанныхТикетаКлиентСервер.НовыйРезультатСбораДанных
//  Форма - ФормаКлиентскогоПриложения - форма-источник команды
//
Процедура АУ_ПослеСбораДанныхОбращения(Результат, Форма) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяФормыИсточника", Результат.ИмяФормы);
	ПараметрыФормы.Вставить("ЗаголовокФормыИсточника", Результат.ЗаголовокФормы);
	ПараметрыФормы.Вставить("ТекстКонтекста", Результат.ТекстКонтекста);
	ПараметрыФормы.Вставить("СнимокЭкрана", Результат.СнимокЭкрана);
	ПараметрыФормы.Вставить("Ошибки", Результат.Ошибки);
	
	ОткрытьФорму("Обработка.АУ_ОбращениеВПоддержку.Форма", ПараметрыФормы, Форма);
	
КонецПроцедуры

#КонецОбласти
