
&После("ПередЗаписью")
Процедура АУ_ПередЗаписью(Отказ)
	
	Если ЗначениеЗаполнено(ЭтотОбъект.БизнесПроцесс) И ТипЗнч(ЭтотОбъект.БизнесПроцесс)=Тип("БизнесПроцессСсылка.Задание") Тогда
		
		ЭтотОбъект.АУ_Предметы.Загрузить(ЭтотОбъект.БизнесПроцесс.АУ_Предметы.Выгрузить());
		
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АУ_Цвет) Тогда
			ЭтотОбъект.АУ_Цвет = ЭтотОбъект.БизнесПроцесс.АУ_Цвет;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&Перед("ОбработкаПроверкиЗаполнения")
Процедура АУ_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.Задание") И ЗначениеЗаполнено(БизнесПроцесс) Тогда
		
		Если БизнесПроцесс.АУ_ВидЗадания = Перечисления.АУ_ВидыЗаданий.УточнениеДатыИсполненияКонтракта И ТочкаМаршрута.Имя = "Выполнить" Тогда
			
			Если ЭтотОбъект.АУ_ВариантИсполненияКонтракта = 0 Тогда
				ОбщегоНазначения.СообщитьПользователю("Укажите срок завершения контратка !",,, "Объект.АУ_ВариантИсполненияКонтракта", Отказ);
			ИначеЕсли ЭтотОбъект.АУ_ВариантИсполненияКонтракта = 2 И НЕ ЗначениеЗаполнено(ЭтотОбъект.АУ_ПеренесенныйСрокИсполненияКонтракта) Тогда
				ОбщегоНазначения.СообщитьПользователю("Укажите срок завершения контракта !",,, "Объект.АУ_ПеренесенныйСрокИсполненияКонтракта", Отказ);
			ИначеЕсли ЭтотОбъект.АУ_ВариантИсполненияКонтракта = 2 И ЭтотОбъект.АУ_ПеренесенныйСрокИсполненияКонтракта <= ТекущаяДатаСеанса() Тогда
				ОбщегоНазначения.СообщитьПользователю("Срок переноса не может быть раньше текущей даты !",,, "Объект.АУ_ПеренесенныйСрокИсполненияКонтракта", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура АУ_ПриЗаписи(Отказ)
	
	Если Выполнена И ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.Задание") И ЗначениеЗаполнено(БизнесПроцесс) И ТочкаМаршрута.Имя = "Выполнить" Тогда
		
		Если БизнесПроцесс.АУ_ВидЗадания = Перечисления.АУ_ВидыЗаданий.УточнениеДатыИсполненияКонтракта Тогда
			
			УстановитьПривилегированныйРежим(Истина);
			
			БизнесПроцессОбъект = БизнесПроцесс.ПолучитьОбъект();
			
			Если ЭтотОбъект.АУ_ВариантИсполненияКонтракта = 2 Тогда
				
				БизнесПроцессОбъект.НаПроверке = Истина;
				Если НЕ ЗначениеЗаполнено(БизнесПроцессОбъект.Проверяющий) Тогда
					БизнесПроцессОбъект.Проверяющий = АУ_ОбщиеПроцедурыИФункцииСерверПовтИсп.ПолучитьЗначениеНастройки("ПользовательУведомленияОПереносеСроковИсполненияКонтракта");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЭтотОбъект.Предмет) И ТипЗнч(ЭтотОбъект.Предмет) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				
					ЗаказОбъект = ЭтотОбъект.Предмет.ПолучитьОбъект();
					ЗаказОбъект.ОбменДанными.Загрузка = Истина;
					ЗаказОбъект.АУ_ПеренесенныйСрокИсполненияКонтракта = ЭтотОбъект.АУ_ПеренесенныйСрокИсполненияКонтракта;
					ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
					
				КонецЕсли;
				
			КонецЕсли;
			
			БизнесПроцессОбъект.АУ_ВариантИсполненияКонтракта = ЭтотОбъект.АУ_ВариантИсполненияКонтракта;
			БизнесПроцессОбъект.АУ_ПеренесенныйСрокИсполненияКонтракта = ЭтотОбъект.АУ_ПеренесенныйСрокИсполненияКонтракта;
			БизнесПроцессОбъект.Записать();
			
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Выполнена И ЭтотОбъект.АУ_ЗадачаОзнакомления И ЭтотОбъект.АУ_СогласованиеДокументов Тогда
		
	КонецЕсли;
	
КонецПроцедуры
