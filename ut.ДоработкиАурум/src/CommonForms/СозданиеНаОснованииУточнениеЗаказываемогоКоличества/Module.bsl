
&НаСервере
&После("ЗаполнитьТоварыПоЗначениюПереключателяВсеИзДокументаНеОбеспечено")
Процедура АУ_ЗаполнитьТоварыПоЗначениюПереключателяВсеИзДокументаНеОбеспечено()
	
	
КонецПроцедуры

&НаСервере
Процедура АУ_ПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.Ссылка) = Тип("ДокументСсылка.ЗаказНаСборку") И НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		
		Если Параметры.Ссылка.АУ_НовыйАлгоритм Тогда
			
			СтатусСогласования = АУ_УправлениеСогласованиемДокументов.ПолучитьСтатусСогласования(Параметры.Ссылка);
			Если НЕ СтатусСогласования = Перечисления.АУ_СтатусыСогласованияДокументов.Согласован Тогда
				ОбщегоНазначения.СообщитьПользователю("Документ НЕ согласован. Необходимо согласовать документ, перед созданием документов на его основании !", Параметры.Ссылка,,, Отказ);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
