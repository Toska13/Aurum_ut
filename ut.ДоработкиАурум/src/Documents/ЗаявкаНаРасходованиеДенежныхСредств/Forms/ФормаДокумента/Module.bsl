&НаСервере
Процедура ПриИзмененииНомераКонтрактаСервер()
	
	ТекущаяСтрока = Объект.АУ_СтатьиБюджета.НайтиПоИдентификатору(Элементы.АУ_СтатьиБюджета.ТекущаяСтрока);
	МассивЗаказовКлиентов = ПолучитьЗаказыКлиентаИзЗаказаПоставщику();
	
	Для каждого стрЗаказ Из МассивЗаказовКлиентов Цикл
		
		Если стрЗаказ.Договор.АУ_КраткийНомер = ТекущаяСтрока.НомерКонтракта Тогда
			ТекущаяСтрока.ЗаказКлиента = стрЗаказ;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АУ_ТаблицаСоответствияКонтрактовРасходки.Программа КАК Программа,
	|	АУ_ТаблицаСоответствияКонтрактовРасходки.Объект КАК Объект,
	|	АУ_ТаблицаСоответствияКонтрактовРасходки.ОбъектСтрока КАК ОбъектСтрока
	|ИЗ
	|	РегистрСведений.АУ_ТаблицаСоответствияКонтрактовРасходки КАК АУ_ТаблицаСоответствияКонтрактовРасходки
	|ГДЕ
	|	АУ_ТаблицаСоответствияКонтрактовРасходки.НомерКонтракта = &НомерКонтракта";
	
	Запрос.УстановитьПараметр("НомерКонтракта", ТекущаяСтрока.НомерКонтракта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

