#Область ПеренесеноСДоработками

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_СменитьЗаказПоставщику", "Сменить заказ", "АУ_СменитьЗаказПоставщику");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_СменитьЗаказПоставщику", "ГруппаКомандыРасшифровки", , "АУ_СменитьЗаказПоставщику", 2);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_СменитьОснование", "Сменить основание", "АУ_СменитьОснование");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_СменитьОснование", "АУ_ГруппаКомандСменитьОснование", , "АУ_СменитьОснование", 2);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_УбратьОснование", "Убрать основание", "АУ_УбратьОснование");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_УбратьОснование", "АУ_ГруппаКомандСменитьОснование", , "АУ_УбратьОснование", 2);
	
	СтраницаСтатьиБюджета=АУ_СозданиеЭлементовФормы.СоздатьСтраница(ЭтаФорма,"АУ_СтраницаСтатьиБюджета",Элементы.ГруппаСтраницы,"Аналитика",1);
	
	Колонки = Новый Структура("СтатьяБюджета,  Сумма, НомерКонтракта, Программа, Шифр, ОбъектСтрока, ПризнакРасходов, Комментарий, ЗаказКлиента",
							  "Статья бюджета", "Сумма", "Контракт", "Программа", "Шифр", "Объект", "Признак расходов", "Комментарий", "ЗаказКлиента");
	ТаблицаСтатьиБюджета=АУ_СозданиеЭлементовФормы.СоздатьТаблицаФормы(ЭтаФорма,"АУ_СтатьиБюджета",СтраницаСтатьиБюджета,"Объект.АУ_СтатьиБюджета", Колонки);
	
	//Элементы.АУ_СтатьиБюджетаОбъект.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	
	Элементы.АУ_СтатьиБюджетаСтатьяБюджета.УстановитьДействие("ПриИзменении", "ПриИзмененииСтатьиБюджета");
	Элементы.АУ_СтатьиБюджетаНомерКонтракта.УстановитьДействие("ПриИзменении", "ПриИзмененииНомераКонтракта");
	Элементы.АУ_СтатьиБюджета.УстановитьДействие("ПриНачалеРедактирования", "ПриНачалеРедактированияСтатейБюджета");
	//Элементы.АУ_СтатьиБюджетаОбъект.УстановитьДействие("НачалоВыбора", "НачалоВыбораОбъекта");
	Элементы.АУ_СтатьиБюджетаШифр.УстановитьДействие("ОбработкаВыбора", "ОбработкаВыбораШифра");
	Элементы.АУ_СтатьиБюджета.УстановитьДействие("ПриОкончанииРедактирования", "ПриОкончанииРедактированияАУ_СтатьиБюджета");
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.УстановитьДействие("ОбработкаВыбора", "ОбработкаВыбораОбъекта");
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.УстановитьДействие("НачалоВыбора", "НачалоВыбораОбъекта");
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.УстановитьДействие("АвтоПодбор", "ОбъектСтрокаАвтоПодбор");
	
	Элементы.АУ_СтатьиБюджетаШифр.КнопкаВыпадающегоСписка = Истина;
	Элементы.АУ_СтатьиБюджетаОбъектСтрока.КнопкаВыбора = Истина;
	
	ЗаполнитьСпискиВыбораЭлементов();
	
	ОбновитьЗаголовокСтраницыАналитика();
	
	АУ_СозданиеЭлементовФормы.СоздатьРеквизит(ЭтаФорма, "АУ_ДокументОснование", Новый ОписаниеТипов(Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств.Реквизиты.ДокументОснование.Тип));
	
	Если Параметры.Ключ.Пустая() Тогда
		АУ_ЗаполнитьСтатьюДДСПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АУ_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.АУ_СтатьиБюджета.Количество()=0 Тогда
		
		Если ЗначениеЗаполнено(ТекущийОбъект.Контрагент.Партнер.АУ_СтатьяБюджета) Тогда
			НоваяСтрока=ТекущийОбъект.АУ_СтатьиБюджета.Добавить();
			НоваяСтрока.СтатьяБюджета=ТекущийОбъект.Контрагент.Партнер.АУ_СтатьяБюджета;
			НоваяСтрока.Сумма=ТекущийОбъект.СуммаДокумента;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ХозяйственнаяОперацияПриИзмененииПосле(Элемент)
	АУ_ЗаполнитьСтатьюДДСПоУмолчанию();
