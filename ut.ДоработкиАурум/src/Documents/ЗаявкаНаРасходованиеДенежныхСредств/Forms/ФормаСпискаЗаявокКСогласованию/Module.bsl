#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_СозданиеЭлементовФормы.СоздатьРеквизит(ЭтаФорма, "АУ_Сумма", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_НомерСчета", Элементы.Список,, 1, "Список.Ссылка.АУ_НомерСчета");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Программа", Элементы.Список,, 1, "Список.Ссылка.АУ_Программа");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Объект", Элементы.Список,, 1, "Список.Ссылка.АУ_Объект");
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ИзменитьДатуПлатежа", "Установить дату платежа", "АУ_ИзменитьДатуПлатежа");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ИзменитьДатуПлатежа", Элементы.Список.КонтекстноеМеню,, "АУ_ИзменитьДатуПлатежа", 1);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ИзменитьБанковскийСчет", "Изменить банковский счет", "АУ_ИзменитьБанковскийСчет");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ИзменитьБанковскийСчет", Элементы.ГруппаФункцииКонтекстноеМеню,, "АУ_ИзменитьБанковскийСчет", 1,, "КонтекстноеМенюСписокУстановитьСтатусУтверждена");
	
	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_Подвал", ЭтаФорма, 3);
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Сумма", "АУ_Подвал", "Сумма строк", 1, "АУ_Сумма", Новый Структура("ТолькоПросмотр", Истина));
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ПеревестиЗаявкиВНесогласованные", "Перенести в Не согласованные", "АУ_ПеревестиЗаявкиВНесогласованные");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ПеревестиЗаявкиВНесогласованные", Элементы.ГруппаФункцииКонтекстноеМеню,, "АУ_ПеревестиЗаявкиВНесогласованные", 1,, "КонтекстноеМенюСписокУстановитьСтатусУтверждена");
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ПеревестиЗаявкиВОтложенные", "Перевести в отложенные", "АУ_ПеревестиЗаявкиВОтложенные");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ПеревестиЗаявкиВОтложенные", Элементы.ГруппаФункцииКонтекстноеМеню,, "АУ_ПеревестиЗаявкиВОтложенные", 1,, "КонтекстноеМенюСписокУстановитьСтатусУтверждена");
	
КонецПроцедуры

#КонецОбласти

#Область КомандыИСобытия

&НаКлиенте
Процедура АУ_ИзменитьДатуПлатежа(Команда)
	
	МассивДокументов = Новый Массив;
	Для каждого стр Из Элементы.Список.ВыделенныеСтроки Цикл
		МассивДокументов.Добавить(стр);
	КонецЦикла;
	
	ОткрытьФорму("Обработка.АУ_ЗагрузкаДанныхВДокументы.Форма.ИзменениеДатыПлатежаЗРДС", Новый Структура("МассивДокументов",МассивДокументов), ЭтаФорма, Новый УникальныйИдентификатор,,,Новый ОписаниеОповещения("ЗавершениеИзменениеДатыПлатежаЗРДС", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеИзменениеДатыПлатежаЗРДС(Значение,ДопПараметры) Экспорт
	
	Сообщить("Даты платежа изменены !");
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ИзменитьБанковскийСчет(Команда)
	
	ОткрытьФорму("Справочник.БанковскиеСчетаОрганизаций.ФормаВыбора", Новый Структура("Отбор", Новый Структура("Владелец", АУ_ОбщиеПроцедурыИФункцииВызовСервера.ПолучитьОсновнуюОрганизацию())), ЭтаФорма, Новый УникальныйИдентификатор,,,Новый ОписаниеОповещения("АУ_ИзменитьБанковскийСчетЗавершение", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ИзменитьБанковскийСчетЗавершение(БанковскийСчет, ДополнительныеПараметры) Экспорт
	
	Если БанковскийСчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	Для каждого стр Из Элементы.Список.ВыделенныеСтроки Цикл
		МассивДокументов.Добавить(стр);
	КонецЦикла;
	
	АУ_ОбщиеПроцедурыИФункцииВызовСервера.ИзменитьБанковскийСчетВЗРДС(МассивДокументов, БанковскийСчет);

КонецПроцедуры

&НаКлиенте
Процедура АУ_СписокПриАктивизацииСтрокиПосле(Элемент)
	
	ПосчитатьСуммуВыделенныхСтрок();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПеревестиЗаявкиВНесогласованные(Команда)
	
	ВыделенныеСтроки = ОбщегоНазначенияУТКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элементы.Список);
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='У выделенных в списке заявок будет установлен статус ""Не согласована"". Продолжить?'");
	Ответ = Неопределено;

	ПоказатьВопрос(Новый ОписаниеОповещения("АУ_ПеревестиЗаявкиВНесогласованныеЗавершение", ЭтотОбъект, Новый Структура("ВыделенныеСтроки", ВыделенныеСтроки)), ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПеревестиЗаявкиВНесогласованныеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    ВыделенныеСтроки = ДополнительныеПараметры.ВыделенныеСтроки;
    
    Ответ = РезультатВопроса;
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    ОчиститьСообщения();
    КоличествоОбработанных = ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(ВыделенныеСтроки, "НеСогласована");
    
    ОбщегоНазначенияУТКлиент.ОповеститьПользователяОбУстановкеСтатуса(Элементы.Список, КоличествоОбработанных, ВыделенныеСтроки.Количество(), "НеСогласована");

КонецПроцедуры

&НаКлиенте
Процедура АУ_ПеревестиЗаявкиВОтложенные(Команда)
	
	ВыделенныеСтроки = ОбщегоНазначенияУТКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элементы.Список);
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='У выделенных в списке заявок будет установлен статус ""Отложена"". Продолжить?'");
	Ответ = Неопределено;

	ПоказатьВопрос(Новый ОписаниеОповещения("АУ_ПеревестиЗаявкиВОтложенныеЗавершение", ЭтотОбъект, Новый Структура("ВыделенныеСтроки", ВыделенныеСтроки)), ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПеревестиЗаявкиВОтложенныеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    ВыделенныеСтроки = ДополнительныеПараметры.ВыделенныеСтроки;
    
    Ответ = РезультатВопроса;
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    ОчиститьСообщения();
    КоличествоОбработанных = ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(ВыделенныеСтроки, "Отложена");
    
    ОбщегоНазначенияУТКлиент.ОповеститьПользователяОбУстановкеСтатуса(Элементы.Список, КоличествоОбработанных, ВыделенныеСтроки.Количество(), "Отложена");

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Процедура ПосчитатьСуммуВыделенныхСтрок()
	
	ЭтаФорма.АУ_Сумма = 0;
	
	Для каждого стр Из Элементы.Список.ВыделенныеСтроки Цикл
		ЭтаФорма.АУ_Сумма = ЭтаФорма.АУ_Сумма + стр.Ссылка.СуммаДокумента;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти