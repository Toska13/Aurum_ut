
&После("ДобавитьКомандыПечати")
Процедура АУ_ДобавитьКомандыПечати(КомандыПечати)
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "АУ_М15";
	КомандаПечати.Представление = "Накладная на передачу материалов М-15";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

&Вместо("Печать")
Процедура АУ_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АУ_М15") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АУ_М15",
			НСтр("ru = 'Накладная на передачу материалов М-15'"),
			ПечатьАУ_М15(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	// Вставить содержимое метода.
	ПродолжитьВызов(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
КонецПроцедуры

&НаСервере
Функция ПечатьАУ_М15(МассивОбъектов, ОбъектыПечати)
	
	Макет=Документы.ВнутреннееПотребление.ПолучитьМакет("ПФ_MXL_М15_ru");
	ТабДокумент=Новый ТабличныйДокумент;
	
	Первый=Истина;
	Для каждого стрДокумент Из МассивОбъектов Цикл
		
		Если НЕ Первый Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Область=Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.НомерДокумента=ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(стрДокумент.Номер);
		
		СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(стрДокумент.Организация, стрДокумент.Дата);
		Область.Параметры.ПредставлениеОрганизации=ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации);
		Область.Параметры.ОрганизацияПоОКПО=СведенияОбОрганизации.КодПоОКПО;
		
		
		ПредставлениеКонтрагента = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(стрДокумент.АУ_Контрагент, стрДокумент.Дата), "ПолноеНаименование,");
		Область.Параметры.КонтрагентНаименование=ПредставлениеКонтрагента;
		
		Область.Параметры.ДатаСоставления=Формат(стрДокумент.Дата,"ДЛФ=Д");
		Область.Параметры.СкладНаименование=стрДокумент.Склад;
		Область.Параметры.СтруктурноеПодразделение=ПредставлениеКонтрагента;
		Область.Параметры.Основание=стрДокумент.АУ_Договор;
		
		ТабДокумент.Вывести(Область);
		
		Область=Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ТабДокумент.Вывести(Область);
		
		Для каждого стрТовары Из стрДокумент.Товары Цикл
			
			Область=Макет.ПолучитьОбласть("Строка");
			
			ПредставлениеНоменклатуры = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(Строка(стрТовары.Номенклатура.НаименованиеПолное),стрТовары.Характеристика.Наименование,,стрТовары.Серия.Наименование,);
			Область.Параметры.ПредставлениеНоменклатуры=ПредставлениеНоменклатуры;
			Область.Параметры.НоменклатураКод=стрТовары.Номенклатура.Код;
			Область.Параметры.ЕдиницаИзмеренияКод=стрТовары.Номенклатура.ЕдиницаИзмерения.Код;
			Область.Параметры.ЕдиницаИзмеренияНаименование=стрТовары.Номенклатура.ЕдиницаИзмерения;
			Область.Параметры.Количество=стрТовары.КоличествоУпаковок;
			Область.Параметры.Цена=0;
			Область.Параметры.СуммаБезНДС=0;
			Область.Параметры.СуммаНДС=0;
			Область.Параметры.СуммаСНДС=0;
			ТабДокумент.Вывести(Область);
		
		КонецЦикла;
		
		Область=Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью=стрДокумент.Товары.Количество();
		ОтветственныеЛица=ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(стрДокумент.Организация,стрДокумент.Дата);
	
		Область.Параметры.ФИОГлавБухгалтера=ОтветственныеЛица.ГлавныйБухгалтер;
		//
		Область.Параметры.ФИОРуководителя=ОтветственныеЛица.Руководитель;
		Область.Параметры.ДолжностьРуководителя=ОтветственныеЛица.РуководительДолжность;
		//
		Область.Параметры.ФИОКладовщика=ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ОтветственныеЛицаБП.ОтветственноеЛицоНаСкладе(стрДокумент.Склад,стрДокумент.Дата), стрДокумент.Дата);
		//СтруктураПараметров.Вставить("ДолжностьКладовщика", ДанныеПечати.ДолжностьКладовщика);
		//
		//
		//СтруктураПараметров.Вставить("СуммаПрописью", ИтоговыеСуммы.СуммаПрописью);
		//Если ЗначениеЗаполнено(ИтоговыеСуммы.ИтогоСуммаНДС) Тогда
		//	СтруктураПараметров.Вставить("ИтогНДС", ФормированиеПечатныхФорм.СуммаРубКоп(ИтоговыеСуммы.ИтогоСуммаНДС, Неопределено, Неопределено));
		//Иначе
		//	СтруктураПараметров.Вставить("ИтогНДС", "______ руб. ______ коп.");
		//КонецЕсли;
		//
		//ОбластьПодвала.Параметры.Заполнить(СтруктураПараметров);
		
		ТабДокумент.Вывести(Область);
		
		Первый=Ложь;
		
	КонецЦикла;
	
	
	Возврат ТабДокумент;
	
КонецФункции