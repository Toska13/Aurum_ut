#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Элементы.ХозяйственнаяОперация.СписокВыбора.Добавить(Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5);

	АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычная(ЭтаФорма, "АУ_ГруппаКонтрагент", "ШапкаПраво", "", 1, , , , );
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Партнер", "АУ_ГруппаКонтрагент", , 1, "Объект.АУ_Партнер");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Контрагент", "АУ_ГруппаКонтрагент", , 1, "Объект.АУ_Контрагент");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Договор", "АУ_ГруппаКонтрагент", , 1, "Объект.АУ_Договор");

	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5 Тогда

		Элементы.АУ_ГруппаКонтрагент.Видимость = Истина;
	Иначе

		Элементы.АУ_ГруппаКонтрагент.Видимость = Ложь;

	КонецЕсли;

	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьПоОстаткам", "Заполнить по остаткам", "АУ_ЗаполнитьПоОстаткам");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоОстаткам", "ТоварыГруппаЗаполнить", , "АУ_ЗаполнитьПоОстаткам", 1);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АУ_ХозяйственнаяОперацияПриИзмененииПосле(Элемент)

	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаПереработчику2_5") Тогда

		Элементы.АУ_ГруппаКонтрагент.Видимость = Истина;
	Иначе

		Элементы.АУ_ГруппаКонтрагент.Видимость = Ложь;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АУ_ЗаполнитьПоОстаткам(Кнопка)

	АУ_ЗаполнитьПоОстаткамСервер();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура АУ_ЗаполнитьПоОстаткамСервер()

	Объект.Товары.Очистить();
	СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("УТ-Р00008");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				  |	Данные.Номенклатура КАК Номенклатура,
				  |	Данные.Характеристика КАК Характеристика,
				  |	Данные.Назначение КАК Назначение,
				  |	Данные.Серия КАК Серия,
				  |	СУММА(Данные.Остаток) КАК КоличествоУпаковок,
				  |	СУММА(Данные.Остаток) КАК Количество
				  |ИЗ
				  |	(ВЫБРАТЬ
				  |		ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
				  |		ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
				  |		ТоварыНаСкладахОстатки.Назначение КАК Назначение,
				  |		ТоварыНаСкладахОстатки.Серия КАК Серия,
				  |		ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток
				  |	ИЗ
				  |		РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, Склад = &Склад) КАК ТоварыНаСкладахОстатки
				  |	
				  |	ОБЪЕДИНИТЬ ВСЕ
				  |	
				  |	ВЫБРАТЬ
				  |		ТоварыКОтгрузкеОстатки.Номенклатура,
				  |		ТоварыКОтгрузкеОстатки.Характеристика,
				  |		ТоварыКОтгрузкеОстатки.Назначение,
				  |		ТоварыКОтгрузкеОстатки.Серия,
				  |		-ТоварыКОтгрузкеОстатки.ВРезервеОстаток - ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток
				  |	ИЗ
				  |		РегистрНакопления.ТоварыКОтгрузке.Остатки(&ДатаОстатков, Склад = &Склад) КАК ТоварыКОтгрузкеОстатки) КАК Данные
				  |
				  |СГРУППИРОВАТЬ ПО
				  |	Данные.Назначение,
				  |	Данные.Номенклатура,
				  |	Данные.Серия,
				  |	Данные.Характеристика
				  |ИМЕЮЩИЕ СУММА(Данные.Остаток)>0";

	Если Объект.Ссылка.Пустая() Тогда

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаОстатков", "");

	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОстатков", Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.СтатьяРасходов = СтатьяРасходов;
		НоваяСтрока.АналитикаРасходов = Объект.Организация;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
