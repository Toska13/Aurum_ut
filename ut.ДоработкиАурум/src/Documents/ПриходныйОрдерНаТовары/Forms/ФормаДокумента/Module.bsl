#Область СобытияФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ПодготовитьРеквизитыФормыДляИстекающихСерий(ЭтаФорма);
	АУ_ОбщиеПроцедурыИФункцииСервер.ОбновитьГраничнуюДатуНаФормеДляИстекающихСерий(ЭтаФорма);
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_КоличествоМест", "Товары",, 1, "Объект.Товары.АУ_КоличествоМест");
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ОтключитьВидимостьНоменклатурыИзАрхиваВФормеДокумента(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
&После("УстановитьУсловноеОформление")
Процедура АУ_УстановитьУсловноеОформлениеСерийСИстекающимСроком()
	
	МассивРеквизитовПосветки = Новый Массив;
	МассивРеквизитовПосветки.Добавить("Товары");
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ОбновитьГраничнуюДатуНаФормеДляИстекающихСерий(ЭтаФорма);
	АУ_ОбщиеПроцедурыИФункцииСервер.УстановитьУсловноеОформлениеИстекающихСерий(
		ЭтаФорма, "Товары", "Объект.Товары", "АУ_ГраничнаяДатаСрокаГодностиСерий", МассивРеквизитовПосветки);
	
КонецПроцедуры

&НаКлиенте
&После("ДатаПриИзменении")
Процедура АУ_ДатаПриИзмененииСерий(Элемент)
	
	АУ_ОбновитьГраничнуюДатуСрокаГодностиСерийНаСервере();
	
КонецПроцедуры

&НаКлиенте
&Вместо("ЗаписатьДокумент")
Процедура АУ_ЗаписатьДокумент(Команда)
	
	АУ_ПроверитьСрокГодностиСерийПередЗаписью("Записать");
	
КонецПроцедуры

&НаКлиенте
&Вместо("ПровестиДокумент")
Процедура АУ_ПровестиДокумент(Команда)
	
	АУ_ПроверитьСрокГодностиСерийПередЗаписью("Провести");
	
КонецПроцедуры

&НаКлиенте
&Вместо("ПровестиИЗакрыть")
Процедура АУ_ПровестиИЗакрыть(Команда)
	
	АУ_ПроверитьСрокГодностиСерийПередЗаписью("ПровестиИЗакрыть");
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыСерияПриИзмененииПосле(Элемент)
	
	АУ_ЗаполнитьСрокГодностиТекущейСтрокиНаСервере();	
	
КонецПроцедуры

&НаСервере
Процедура АУ_ЗаполнитьСрокГодностиТекущейСтрокиНаСервере()
	
	Если Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ЗаполнитьСрокГодностиВСтрокеТовары(Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока));
	
КонецПроцедуры

&НаСервере
Процедура АУ_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ЗаполнитьСрокГодностиТабличнойЧастиТовары(Объект.Товары);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	
	ПроверитьСоответствиеТоваровПриходногоОрдераПриобретению(Объект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура АУ_ПроверитьСрокГодностиСерийПередЗаписью(Действие)
	
	ДополнительныеПараметры = Новый Структура("Действие", Действие);
	
	Если НЕ АУ_ЕстьСерииСИстекающимСрокомГодностиНаСервере() Тогда
		АУ_ПередЗаписьюПроверкаСрокаГодностиСерийЗавершение(КодВозвратаДиалога.Да, ДополнительныеПараметры);
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("АУ_ПередЗаписьюПроверкаСрокаГодностиСерийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(Оповещение,
			АУ_ОбщиеПроцедурыИФункцииКлиент.ТекстВопросаПередЗаписьюСерииСИстекающимСроком(),
			РежимДиалогаВопрос.ДаНет);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПередЗаписьюПроверкаСрокаГодностиСерийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Действие = "Записать" Тогда
		ОбщегоНазначенияУТКлиент.Записать(ЭтаФорма, Истина);
	ИначеЕсли ДополнительныеПараметры.Действие = "Провести" Тогда
		ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма, Истина);
	ИначеЕсли ДополнительныеПараметры.Действие = "ПровестиИЗакрыть" Тогда
		ОбщегоНазначенияУТКлиент.ПровестиИЗакрыть(ЭтаФорма, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция АУ_ЕстьСерииСИстекающимСрокомГодностиНаСервере()
	
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Товары");
	
	Возврат АУ_ОбщиеПроцедурыИФункцииСервер.ЕстьСерииСИстекающимСрокомГодности(
		Объект.Дата, Объект, ИменаТабличныхЧастей);
	
КонецФункции

&НаСервере
Процедура АУ_ОбновитьГраничнуюДатуСрокаГодностиСерийНаСервере()
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ОбновитьГраничнуюДатуНаФормеДляИстекающихСерий(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыПриИзмененииПосле(Элемент)
	
	АУ_ЗаполнитьСрокГодностиТекущейСтрокиНаСервере();
	
КонецПроцедуры

&НаСервере
&После("ОбработатьУказаниеСерийСервер")
Процедура АУ_ОбработатьУказаниеСерийСервер(ПараметрыФормыУказанияСерий)
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ЗаполнитьСрокГодностиТабличнойЧастиТовары(Объект.Товары);
	
КонецПроцедуры

// Проверяет соответствие состава и количества товаров приходного ордера документу приобретения.
// Сравнение выполняется по полям Номенклатура, Характеристика, Назначение.
// Учитываются товары других неудалённых приходных ордеров с тем же распоряжением.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ПриходныйОрдерНаТовары - проверяемый документ.
//  Отказ - Булево - признак отказа записи; устанавливается в Истина при нарушении.
//
&НаСервере
Процедура ПроверитьСоответствиеТоваровПриходногоОрдераПриобретению(ЗНАЧ ДокументОбъект, Отказ) Экспорт
	
	Приобретение = ПолучитьПриобретениеПоРаспоряжениюПриходногоОрдера(ДокументОбъект.Распоряжение);
	Если Не ЗначениеЗаполнено(Приобретение) Тогда
		Возврат;
	КонецЕсли;
	
	ТоварыОрдера = ДокументОбъект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, Назначение, Количество");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Назначение КАК Назначение,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ТоварыОрдера
	|ИЗ
	|	&ТоварыОрдера КАК Товары
	|ГДЕ
	|	Товары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОрдера.Номенклатура КАК Номенклатура,
	|	ТоварыОрдера.Характеристика КАК Характеристика,
	|	ТоварыОрдера.Назначение КАК Назначение,
	|	СУММА(ТоварыОрдера.Количество) КАК Количество
	|ПОМЕСТИТЬ ТоварыОрдераСгруппированные
	|ИЗ
	|	ТоварыОрдера КАК ТоварыОрдера
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОрдера.Номенклатура,
	|	ТоварыОрдера.Характеристика,
	|	ТоварыОрдера.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриобретениеТовары.Номенклатура КАК Номенклатура,
	|	ПриобретениеТовары.Характеристика КАК Характеристика,
	|	ПриобретениеТовары.Назначение КАК Назначение,
	|	СУММА(ПриобретениеТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ТоварыПриобретения
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ПриобретениеТовары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	ПриобретениеТовары.Ссылка = &Приобретение
	|	И СпрНоменклатура.ТипНоменклатуры НЕ В (
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|СГРУППИРОВАТЬ ПО
	|	ПриобретениеТовары.Номенклатура,
	|	ПриобретениеТовары.Характеристика,
	|	ПриобретениеТовары.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриходныйОрдерТовары.Номенклатура КАК Номенклатура,
	|	ПриходныйОрдерТовары.Характеристика КАК Характеристика,
	|	ПриходныйОрдерТовары.Назначение КАК Назначение,
	|	СУММА(ПриходныйОрдерТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ТоварыДругихОрдеров
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерТовары
	|ГДЕ
	|	ПриходныйОрдерТовары.Ссылка.Распоряжение = &Приобретение
	|	И ПриходныйОрдерТовары.Ссылка <> &ТекущийОрдер
	|	И НЕ ПриходныйОрдерТовары.Ссылка.ПометкаУдаления
	|	И ПриходныйОрдерТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	ПриходныйОрдерТовары.Номенклатура,
	|	ПриходныйОрдерТовары.Характеристика,
	|	ПриходныйОрдерТовары.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОрдера.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ТоварыОрдера КАК ТоварыОрдера
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыПриобретения КАК ТоварыПриобретения
	|		ПО ТоварыОрдера.Номенклатура = ТоварыПриобретения.Номенклатура
	|			И ТоварыОрдера.Характеристика = ТоварыПриобретения.Характеристика
	|			И ТоварыОрдера.Назначение = ТоварыПриобретения.Назначение
	|ГДЕ
	|	ТоварыПриобретения.Номенклатура ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОрдераСгруппированные.Номенклатура КАК Номенклатура,
	|	ТоварыОрдераСгруппированные.Характеристика КАК Характеристика,
	|	ТоварыОрдераСгруппированные.Назначение КАК Назначение,
	|	ТоварыОрдераСгруппированные.Количество КАК КоличествоОрдера,
	|	ТоварыПриобретения.Количество КАК КоличествоПриобретения,
	|	ЕСТЬNULL(ТоварыДругихОрдеров.Количество, 0) КАК КоличествоДругихОрдеров
	|ИЗ
	|	ТоварыОрдераСгруппированные КАК ТоварыОрдераСгруппированные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТоварыПриобретения КАК ТоварыПриобретения
	|		ПО ТоварыОрдераСгруппированные.Номенклатура = ТоварыПриобретения.Номенклатура
	|			И ТоварыОрдераСгруппированные.Характеристика = ТоварыПриобретения.Характеристика
	|			И ТоварыОрдераСгруппированные.Назначение = ТоварыПриобретения.Назначение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыДругихОрдеров КАК ТоварыДругихОрдеров
	|		ПО ТоварыОрдераСгруппированные.Номенклатура = ТоварыДругихОрдеров.Номенклатура
	|			И ТоварыОрдераСгруппированные.Характеристика = ТоварыДругихОрдеров.Характеристика
	|			И ТоварыОрдераСгруппированные.Назначение = ТоварыДругихОрдеров.Назначение
	|ГДЕ
	|	ТоварыОрдераСгруппированные.Количество + ЕСТЬNULL(ТоварыДругихОрдеров.Количество, 0) > ТоварыПриобретения.Количество";
	
	Запрос.УстановитьПараметр("ТоварыОрдера", ТоварыОрдера);
	Запрос.УстановитьПараметр("Приобретение", Приобретение);
	Запрос.УстановитьПараметр("ТекущийОрдер", ДокументОбъект.Ссылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаОтсутствующие = РезультатыЗапроса[4].Выбрать();
	Пока ВыборкаОтсутствующие.Следующий() Цикл
		
		ТекстОшибки = НСтр("ru = 'В строке %1 списка ""Товары"" указан товар, отсутствующий в документе приобретения %2.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ВыборкаОтсутствующие.НомерСтроки, Приобретение);
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Товары", ВыборкаОтсутствующие.НомерСтроки, "Номенклатура");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , Поле, "Объект", Отказ);
		
	КонецЦикла;
	
	ВыборкаПревышение = РезультатыЗапроса[5].Выбрать();
	Пока ВыборкаПревышение.Следующий() Цикл
		
		ДоступноеКоличество = ВыборкаПревышение.КоличествоПриобретения - ВыборкаПревышение.КоличествоДругихОрдеров;
		ТекстОшибки = НСтр("ru = 'Количество товара %1 в приходном ордере (%2) превышает доступное количество по документу приобретения %3 (%4).'");
		ТекстОшибки = СтрШаблон(
			ТекстОшибки,
			ПредставлениеКлючаТовараПриходногоОрдера(
				ВыборкаПревышение.Номенклатура,
				ВыборкаПревышение.Характеристика,
				ВыборкаПревышение.Назначение),
			Формат(ВыборкаПревышение.КоличествоОрдера, "ЧГ=15.3; ЧДЦ=3; ЧН=0"),
			Приобретение,
			Формат(ДоступноеКоличество, "ЧГ=15.3; ЧДЦ=3; ЧН=0"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Товары", "Объект", Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает документ приобретения, связанный с распоряжением приходного ордера.
//
// Параметры:
//  Распоряжение - ОпределяемыйТип.РаспоряжениеНаПоступление - распоряжение приходного ордера.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриобретениеТоваровУслуг, Неопределено - если распоряжение не является приобретением.
//
Функция ПолучитьПриобретениеПоРаспоряжениюПриходногоОрдера(Распоряжение)
	
	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
		И ЗначениеЗаполнено(Распоряжение) Тогда
		Возврат Распоряжение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Формирует текстовое представление ключа товара для сообщений пользователю.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика.
//  Назначение - СправочникСсылка.Назначения - назначение.
//
// Возвращаемое значение:
//  Строка - представление ключа товара.
//
Функция ПредставлениеКлючаТовараПриходногоОрдера(Номенклатура, Характеристика, Назначение)
	
	ЧастиПредставления = Новый Массив;
	ЧастиПредставления.Добавить(Строка(Номенклатура));
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		ЧастиПредставления.Добавить(СтрШаблон(НСтр("ru = 'характеристика %1'"), Характеристика));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Назначение) Тогда
		ЧастиПредставления.Добавить(СтрШаблон(НСтр("ru = 'назначение %1'"), Назначение));
	КонецЕсли;
	
	Возврат СтрСоединить(ЧастиПредставления, ", ");
	
КонецФункции

#КонецОбласти