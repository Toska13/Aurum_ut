
&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"АУ_Заказ","ШапкаПраво","по заказу",1,"Объект.АУ_Заказ");
	АУ_СкладПолучательПриИзмененииПослеСервер();
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ОтключитьВидимостьНоменклатурыИзАрхиваВФормеДокумента(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура АУ_СкладПолучательПриИзмененииПослеСервер()
	
	Элементы.АУ_Заказ.ПараметрыВыбора=Новый ФиксированныйМассив(Новый Массив);
	Если НЕ Объект.СкладПолучатель.АУ_Контрагент.Пустая() Тогда
		Элементы.АУ_Заказ.Видимость=Истина;
		Массив=Новый Массив;
		Параметр=Новый ПараметрВыбора("Отбор.Контрагент",Объект.СкладПолучатель.АУ_Контрагент);
		Массив.Добавить(Параметр);
		Элементы.АУ_Заказ.ПараметрыВыбора=Новый ФиксированныйМассив(Массив);
	Иначе
		Элементы.АУ_Заказ.Видимость=Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_СкладПолучательПриИзмененииПосле(Элемент)
	
	АУ_СкладПолучательПриИзмененииПослеСервер();
	
КонецПроцедуры
