
&Вместо("ОбработкаЗаполнения")
Процедура АУ_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения,,"Номер,Дата");
		СкладОтправитель=ДанныеЗаполнения.Склад;
		ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
		Статус=Перечисления.СтатусыПеремещенийТоваров.Принято;
		ВариантПриемкиТоваров=Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
		
		Для каждого стрТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока=ЭтотОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,стрТовары);
		КонецЦикла;
	Иначе
		ПродолжитьВызов(ДанныеЗаполнения, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура АУ_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Для каждого стрТовары Из ЭтотОбъект.Товары Цикл
		стрТовары.КодСтроки=0;
	КонецЦикла;
	
КонецПроцедуры
