#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Шифр", "Список", "Шифр", 1, "Список.Ссылка.Характеристика");
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_ГК", "Список", "ГК" , 1, "Список.Ссылка.ДокументОснование.Договор.Номер");
	
	Список.ТекстЗапроса = Список.ТекстЗапроса + "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АУ_ИсторияСогласованияДокументов.СрезПоследних КАК Согласование
	|		ПО ДокументЗаказНаСборку.Ссылка = Согласование.Документ";
	
	ЗаменяемыйТекст = "ЕСТЬNULL(СостоянияВнутреннихЗаказов.ЕстьРасхожденияОрдерНакладная, ЛОЖЬ) КАК ЕстьРасхожденияОрдерНакладная";
	ТекстЗамены = ",Согласование.Статус КАК СтатусСогласования";
	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ЗаменяемыйТекст, ЗаменяемыйТекст + ТекстЗамены);
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Согласование", "Список", "Согласование", 1, "Список.СтатусСогласования",,, "Состояние");
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_СоздатьЗаказыПоставщикам", "Создать заказы поставщикам", "АУ_СоздатьЗаказыПоставщикам");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_СоздатьЗаказыПоставщикам", Элементы.СписокКоманднаяПанель,, "АУ_СоздатьЗаказыПоставщикам", 1);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_СоздатьКопииЗаказаПоШифрам", "Создать копии заказа по шифрам", "АУ_СоздатьКопииЗаказаПоШифрам");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_СоздатьКопииЗаказаПоШифрам", Элементы.СписокКоманднаяПанель,, "АУ_СоздатьКопииЗаказаПоШифрам", 1);
	
КонецПроцедуры

#КонецОбласти

#Область КомандыИСобытияЭлементов

&НаКлиенте
Процедура АУ_СоздатьЗаказыПоставщикам(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заказы", Элементы.Список.ВыделенныеСтроки);
	
	ОткрытьФорму("Обработка.АУ_ЗагрузкаДанныхВДокументы.Форма.СозданиеЗаказовПоставщику", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_СоздатьКопииЗаказаПоШифрам(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказНаСборку", Элементы.Список.ТекущаяСтрока);
	
	ОткрытьФорму("Документ.ЗаказНаСборку.Форма.АУ_СозданиеКопийЗаказаНаСборкуПоШифрам", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти