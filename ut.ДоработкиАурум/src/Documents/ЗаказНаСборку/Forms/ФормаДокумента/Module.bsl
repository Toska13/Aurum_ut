#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.АУ_НовыйАлгоритм = Истина;
	КонецЕсли;
	
	ПараметрыКолонок = Новый Структура("АвтоМаксимальнаяШирина, МаксимальнаяШирина", Ложь, 10);
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма,"ТоварыАУ_Артикул", "Товары",, 1, "Объект.Товары.АУ_Артикул", ПараметрыКолонок,, "ТоварыНоменклатураАртикул");
	
	Если НЕ Объект.АУ_НовыйАлгоритм Тогда
		
		АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "ТоварыАУ_НоменклатураДляКомплектации", "Товары",, 1, "Объект.Товары.АУ_НоменклатураДляКомплектации", ПараметрыКолонок,, "ТоварыНоменклатураАртикул");
		ПараметрыКолонок.МаксимальнаяШирина = 4;
		АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "ТоварыАУ_ЕдиницаИзмерения", "Товары",,1, "Объект.Товары.АУ_ЕдиницаИзмерения", ПараметрыКолонок,, "ТоварыНоменклатураАртикул");
		АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "ТоварыАУ_Количество", "Товары",,1, "Объект.Товары.АУ_Количество", ПараметрыКолонок,, "ТоварыНоменклатураАртикул");
		
		АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ОбновитьНоменклатуруИКоличество", "Обновить номенклатуру и количество", "АУ_ОбновитьНоменклатуруИКоличество");
		АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ОбновитьНоменклатуруИКоличество", "ГруппаЗаполнить",, "АУ_ОбновитьНоменклатуруИКоличество", 1);
		
	КонецЕсли;
	
	ПараметрыКолонок.МаксимальнаяШирина = 10;
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "ТоварыАУ_Поставщик", "Товары",, 1, "Объект.Товары.АУ_Поставщик", ПараметрыКолонок,, "ТоварыНоменклатураАртикул");
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗагрузитьНоменклатуруДляКомплектации", "Загрузить номенклатуру для комплектации", "АУ_ЗагрузитьНоменклатуруДляКомплектации");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗагрузитьНоменклатуруДляКомплектации", "ГруппаЗаполнить",, "АУ_ЗагрузитьНоменклатуруДляКомплектации", 1);
	
	АУ_СозданиеЭлементовФормы.СоздатьПоле(ЭтаФорма, "АУ_Шифр", "ГруппаКомплектЛеваяКолонка",, 1, "Объект.АУ_Шифр", ПараметрыКолонок,,);
	
	АУ_УправлениеСогласованиемДокументов.СформироватьЭлементыСогласованияДокументаНаФорме(ЭтаФорма, Элементы.ГруппаСтраницы);
	
	Если ПараметрыСеанса.АУ_Буфер = "ОткрываетсяДляСогласования" Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.АУ_СтраницаСогласованияДокументов;
	КонецЕсли;
	
	ПараметрыСеанса.АУ_Буфер = "";
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		//СтатусСогласования = АУ_УправлениеСогласованиемДокументов.ПолучитьСтатусСогласования(Объект.Ссылка);
		//ЭтаФорма.ТолькоПросмотр = Объект.АУ_НовыйАлгоритм И (НЕ СтатусСогласования = Перечисления.АУ_СтатусыСогласованияДокументов.Новый) И ЗначениеЗаполнено(СтатусСогласования);
	КонецЕсли;
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ПересчитатьКоличество", "Количество * Количество комлектов", "АУ_ПересчитатьКоличество");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ПересчитатьКоличество", "ГруппаЗаполнить",, "АУ_ПересчитатьКоличество", 1);
	
	АУ_ОбщиеПроцедурыИФункцииСервер.ОтключитьВидимостьНоменклатурыИзАрхиваВФормеДокумента(ЭтаФорма);
	
	Группа = АУ_СозданиеЭлементовФормы.СоздатьГруппаОбычнаяБезОтображения(ЭтаФорма, "АУ_ГруппаОснование", "ГруппаОсновное", 3,,,, "ДокументОснование");
	Элементы.Переместить(Элементы.ДокументОснование, Группа);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_СменитьЗаказКлиента", "Сменить заказ", "АУ_СменитьЗаказКлиента");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_СменитьЗаказКлиента", Группа,, "АУ_СменитьЗаказКлиента", 2);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ОтвязатьОтЗаказаКлиента", "Отвязать от заказа", "АУ_ОтвязатьОтЗаказаКлиента");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ОтвязатьОтЗаказаКлиента", Группа,, "АУ_ОтвязатьОтЗаказаКлиента", 2);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьПоставщика", "Заполнить поставщика", "АУ_ЗаполнитьПоставщика");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоставщика", "ГруппаЗаполнить",, "АУ_ЗаполнитьПоставщика", 1);
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьПоставщика1", "ТоварыКонтекстноеМеню",, "АУ_ЗаполнитьПоставщика", 1);
	
	АУ_СозданиеЭлементовФормы.СоздатьКоманду(ЭтаФорма, "АУ_ЗаполнитьКоличество", "Заполнить количество", "АУ_ЗаполнитьКоличество");
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьКоличество", "ГруппаЗаполнить",, "АУ_ЗаполнитьКоличество", 1);
	АУ_СозданиеЭлементовФормы.СоздатьКнопка(ЭтаФорма, "АУ_ЗаполнитьКоличество1", "ТоварыКонтекстноеМеню",, "АУ_ЗаполнитьКоличество", 1);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПослеЗаписиПосле(ПараметрыЗаписи)
	
	ОбновитьДанныеСогласованияНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СобытияИКомандыЭлементов

&НаКлиенте
Процедура АУ_ЗагрузитьНоменклатуруДляКомплектации(Команда)
	
	ОткрытьФорму("Обработка.АУ_ЗагрузкаДанныхВДокументы.Форма.ЗагрузкаВЗаказНаСборку",, ЭтаФорма,,,, Новый ОписаниеОповещения("АУ_ЗагрузитьНоменклатуруДляКомплектацииЗавершение" ,ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗагрузитьНоменклатуруДляКомплектацииЗавершение(Значение,ДопПараметры) Экспорт
	
	Если ЭтоАдресВременногоХранилища(Значение) Тогда
		АУ_ЗагрузитьНоменклатуруДляКомплектацииЗавершениеСервер(Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АУ_ЗагрузитьНоменклатуруДляКомплектацииЗавершениеСервер(АдресХранилища)
	
	Счетчик = ПолучитьПоследнийКодСтроки(Объект);
	ТЗ = ПолучитьИзВременногоХранилища(АдресХранилища);
	Для каждого стрТЗ Из ТЗ Цикл
		
		Счетчик = Счетчик + 1;
		
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = стрТЗ.Номенклатура;
		НоваяСтрока.Характеристика = Объект.Характеристика;
		НоваяСтрока.Количество = стрТЗ.Количество;
		НоваяСтрока.КоличествоУпаковок = стрТЗ.Количество;
		НоваяСтрока.АУ_Поставщик=стрТЗ.Поставщик;
		НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
		НоваяСтрока.Обособленно = ЗначениеЗаполнено(Объект.Назначение);
		
		НоваяСтрока.КодСтроки = Счетчик;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ОбновитьНоменклатуруИКоличество(Команда) Экспорт
	
	АУ_ОбновитьНоменклатуруИКоличествоСервер();
	
КонецПроцедуры

&НаСервере
Процедура АУ_ОбновитьНоменклатуруИКоличествоСервер()

	Для каждого стрТовары Из Объект.Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(стрТовары.Номенклатура) И ( ЗначениеЗаполнено(стрТовары.АУ_Артикул) ИЛИ ЗначениеЗаполнено(стрТовары.АУ_НоменклатураДляКомплектации) ) Тогда
			стрТовары.Номенклатура = Обработки.АУ_ЗагрузкаДанныхВДокументы.ПолучитьНоменклатуру(стрТовары.АУ_Артикул, стрТовары.АУ_НоменклатураДляКомплектации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(стрТовары.АУ_Количество) Тогда
			стрТовары.Количество = стрТовары.АУ_Количество;
			стрТовары.КоличествоУпаковок = стрТовары.АУ_Количество;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(стрТовары.ВариантОбеспечения) Тогда
			стрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыПриОкончанииРедактированияПосле(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ЗаполнитьХарактеристикиКомплектующих();
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Элемент.ТекущиеДанные.Обособленно = ЗначениеЗаполнено(Объект.Назначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ПересчитатьКоличество(Команда)
	
	Для каждого стрТовары Из Объект.Товары Цикл
		
		стрТовары.Количество = стрТовары.Количество * Объект.Количество;
		стрТовары.КоличествоУпаковок = стрТовары.КоличествоУпаковок * Объект.Количество;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_СменитьЗаказКлиента(Команда)
	
	ОткрытьФорму("Документ.ЗаказКлиента.ФормаВыбора",, ЭтаФорма, Новый УникальныйИдентификатор,,, Новый ОписаниеОповещения("СменитьЗаказКлиентаЗавершение", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ОтвязатьОтЗаказаКлиента(Команда)
	
	Объект.ДокументОснование = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура СменитьЗаказКлиентаЗавершение(Значение,ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Объект.ДокументОснование = Значение;
		ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование", "Видимость", ЗначениеЗаполнено(Объект.ДокументОснование));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьПоставщика(Команда)
	
	ОткрытьФорму("Справочник.Партнеры.ФормаВыбора",, ЭтаФорма, Новый УникальныйИдентификатор,,, Новый ОписаниеОповещения("АУ_ЗаполнитьПоставщикаЗавершение", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьПоставщикаЗавершение(Значение, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Для каждого стр Из Элементы.Товары.ВыделенныеСтроки Цикл
			
			стрТовары = Объект.Товары.НайтиПоИдентификатору(стр);
			стрТовары.АУ_Поставщик = Значение;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьКоличество(Команда)
	
	ПоказатьВводЧисла(Новый ОписаниеОповещения("АУ_ЗаполнитьКоличествоЗавершение", ЭтаФорма),, "Введите количество", 3);
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ЗаполнитьКоличествоЗавершение(Значение, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Для каждого стр Из Элементы.Товары.ВыделенныеСтроки Цикл
			
			стрТовары = Объект.Товары.НайтиПоИдентификатору(стр);
			стрТовары.Количество = Значение;
			стрТовары.КоличествоУпаковок = Значение;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СогласованиеДокументов

&НаКлиенте
Процедура АУ_ОбновитьДанныеПоСогласованию(Команда)
	
	ОбновитьДанныеСогласованияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ОтправитьНаСогласование(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И НЕ Модифицированность Тогда
		АУ_УправлениеСогласованиемДокументов.ОтправитьДокументНаСогласование(Объект.Ссылка, ЭтаФорма.АУ_Согласующий);
		ОбновитьДанныеСогласованияНаСервере();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед отправкой на согласование необходимо записать документ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ОтказатьВСогласовании(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И НЕ Модифицированность Тогда
		АУ_УправлениеСогласованиемДокументов.ОтказатьВСогласованииДокумента(Объект.Ссылка, ЭтаФорма.АУ_КомментарийКСогласованию);
		ОбновитьДанныеСогласованияНаСервере();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед отказом необходимо записать документ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_Согласовать(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И НЕ Модифицированность Тогда
		АУ_УправлениеСогласованиемДокументов.СогласоватьДокумент(Объект.Ссылка, ЭтаФорма.АУ_КомментарийКСогласованию);
		ОбновитьДанныеСогласованияНаСервере();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед согласованием необходимо записать документ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_СброситьСогласование(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И НЕ Модифицированность Тогда
		АУ_УправлениеСогласованиемДокументов.СброситьСогласованиеДокумента(Объект.Ссылка, ЭтаФорма.АУ_КомментарийКСогласованию);
		ОбновитьДанныеСогласованияНаСервере();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед изменением согласования необходимо записать документ");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСогласованияНаСервере()
	
	АУ_УправлениеСогласованиемДокументов.ОбновитьДанныеПоСогласованиюНаФорме(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Процедура ЗаполнитьХарактеристикиКомплектующих()
	
	Для каждого стрТовары Из Объект.Товары Цикл
		
		Если (стрТовары.Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры 
			ИЛИ стрТовары.Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
			И ЗначениеЗаполнено(Объект.Характеристика) Тогда
			стрТовары.Характеристика = Объект.Характеристика;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ХарактеристикаПриИзмененииПосле(Элемент)
	
	ЗаполнитьХарактеристикиКомплектующих();
	
КонецПроцедуры

&НаКлиенте
Процедура АУ_ТоварыНоменклатураПриИзмененииПосле(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущаяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.НеТребуется") И НЕ ТекущаяСтрока.Отменено Тогда
		ТекущаяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПоследнийКодСтроки(ЗНАЧ ТекОбъект)
	
	Результат = 1;
	Для каждого стрТовары Из ТекОбъект.Товары Цикл
		Результат = Макс(стрТовары.КодСтроки, Результат);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

