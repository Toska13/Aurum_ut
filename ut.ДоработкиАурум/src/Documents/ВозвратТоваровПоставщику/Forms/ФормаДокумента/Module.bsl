#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	АУ_СозданиеЭлементовФормы.СоздатьПоле(
		ЭтаФорма,
		"ТоварыАУ_ЗаменаТовара",
		"Товары",
		НСтр("ru = 'Замена товара'"),
		2,
		"Объект.Товары.АУ_ЗаменаТовара");

КонецПроцедуры

&НаСервере
Процедура АУ_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)

	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда

		Возврат;

	КонецЕсли;

	АУ_СинхронизироватьЗаменуВЗаказахПоставщику(ТекущийОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура АУ_СинхронизироватьЗаменуВЗаказахПоставщику(ВозвратОбъект)

	ИзмененияПоЗаказам = Новый Соответствие;

	Для Каждого СтрокаТовары Из ВозвратОбъект.Товары Цикл

		АУ_ОбработатьСтрокуВозвратаДляЗамены(ВозвратОбъект, СтрокаТовары, ИзмененияПоЗаказам);

	КонецЦикла;

	Для Каждого КлючИЗначение Из ИзмененияПоЗаказам Цикл

		Если КлючИЗначение.Значение.Изменен Тогда

			КлючИЗначение.Значение.Объект.Записать(РежимЗаписиДокумента.Запись);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АУ_ОбработатьСтрокуВозвратаДляЗамены(ВозвратОбъект, СтрокаТовары, ИзмененияПоЗаказам)

	ДокументПоступления = СтрокаТовары.ДокументПоступления;
	Если Не ЗначениеЗаполнено(ДокументПоступления) Тогда

		ДокументПоступления = ВозвратОбъект.ДокументПоступления;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументПоступления) Тогда

		Возврат;

	КонецЕсли;

	ЗаказСсылка = АУ_ЗаказПоставщикуИзПоступления(
		ДокументПоступления,
		СтрокаТовары.Номенклатура,
		СтрокаТовары.Характеристика);

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда

		Возврат;

	КонецЕсли;

	ДанныеЗаказа = ИзмененияПоЗаказам.Получить(ЗаказСсылка);
	Если ДанныеЗаказа = Неопределено Тогда

		ДанныеЗаказа = Новый Структура("Объект, Изменен", ЗаказСсылка.ПолучитьОбъект(), Ложь);
		ИзмененияПоЗаказам.Вставить(ЗаказСсылка, ДанныеЗаказа);

	КонецЕсли;

	ЗаказИзменен = Ложь;

	Если СтрокаТовары.АУ_ЗаменаТовара Тогда

		ЗаказИзменен = АУ_ДобавитьСтрокуЗаменыВЗаказ(
			ДанныеЗаказа.Объект,
			СтрокаТовары,
			ДокументПоступления,
			ВозвратОбъект.Ссылка);
	Иначе

		ЗаказИзменен = АУ_УдалитьСтрокиЗаменыВЗаказе(
			ДанныеЗаказа.Объект,
			СтрокаТовары.Номенклатура,
			ВозвратОбъект.Ссылка);

	КонецЕсли;

	Если ЗаказИзменен Тогда

		ДанныеЗаказа.Изменен = Истина;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АУ_ЗаказПоставщикуИзПоступления(ДокументПоступления, Номенклатура, Характеристика)

	Отбор = Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика);
	НайденныеСтроки = ДокументПоступления.Товары.НайтиСтроки(Отбор);

	Если НайденныеСтроки.Количество() = 0 Тогда

		Отбор = Новый Структура("Номенклатура", Номенклатура);
		НайденныеСтроки = ДокументПоступления.Товары.НайтиСтроки(Отбор);

	КонецЕсли;

	Если НайденныеСтроки.Количество() = 0 Тогда

		Возврат Документы.ЗаказПоставщику.ПустаяСсылка();

	КонецЕсли;

	Возврат НайденныеСтроки[0].ЗаказПоставщику;

КонецФункции

&НаСервере
Функция АУ_ДобавитьСтрокуЗаменыВЗаказ(ЗаказОбъект, СтрокаВозврата, ДокументПоступления, ВозвратСсылка)

	ОтборСуществующих = Новый Структура(
		"Номенклатура, АУ_ВозвратТоваровПоставщику",
		СтрокаВозврата.Номенклатура,
		ВозвратСсылка);
	Если ЗаказОбъект.Товары.НайтиСтроки(ОтборСуществующих).Количество() > 0 Тогда

		Возврат Ложь;

	КонецЕсли;

	СтрокаИсточник = АУ_СтрокаИсточникаЗаменыВЗаказе(ЗаказОбъект, СтрокаВозврата, ДокументПоступления);
	Если СтрокаИсточник = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;

	НоваяСтрока = ЗаказОбъект.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
	НоваяСтрока.АУ_ВозвратТоваровПоставщику = ВозвратСсылка;
	НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	НоваяСтрока.КодСтроки = АУ_СледующийКодСтрокиЗаказа(ЗаказОбъект);
	ЗаказОбъект.МаксимальныйКодСтроки = Макс(ЗаказОбъект.МаксимальныйКодСтроки, НоваяСтрока.КодСтроки);

	Возврат Истина;

КонецФункции

&НаСервере
Функция АУ_СтрокаИсточникаЗаменыВЗаказе(ЗаказОбъект, СтрокаВозврата, ДокументПоступления)

	КодСтрокиИсточника = АУ_КодСтрокиИсточникаИзПоступления(ДокументПоступления, СтрокаВозврата);

	Если ЗначениеЗаполнено(КодСтрокиИсточника) Тогда

		НайденныеПоКоду = ЗаказОбъект.Товары.НайтиСтроки(Новый Структура("КодСтроки", КодСтрокиИсточника));
		Если НайденныеПоКоду.Количество() > 0 Тогда

			Возврат НайденныеПоКоду[0];

		КонецЕсли;

	КонецЕсли;

	НайденныеПоНоменклатуре = ЗаказОбъект.Товары.НайтиСтроки(
		Новый Структура("Номенклатура", СтрокаВозврата.Номенклатура));

	Для Каждого Кандидат Из НайденныеПоНоменклатуре Цикл

		Если Не ЗначениеЗаполнено(Кандидат.АУ_ВозвратТоваровПоставщику) Тогда

			Возврат Кандидат;

		КонецЕсли;

	КонецЦикла;

	Если НайденныеПоНоменклатуре.Количество() > 0 Тогда

		Возврат НайденныеПоНоменклатуре[0];

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция АУ_КодСтрокиИсточникаИзПоступления(ДокументПоступления, СтрокаВозврата)

	ОтборПоступления = Новый Структура(
		"Номенклатура, Характеристика",
		СтрокаВозврата.Номенклатура,
		СтрокаВозврата.Характеристика);
	СтрокиПоступления = ДокументПоступления.Товары.НайтиСтроки(ОтборПоступления);

	Если СтрокиПоступления.Количество() = 0 Тогда

		СтрокиПоступления = ДокументПоступления.Товары.НайтиСтроки(
			Новый Структура("Номенклатура", СтрокаВозврата.Номенклатура));

	КонецЕсли;

	Если СтрокиПоступления.Количество() = 0 Тогда

		Возврат 0;

	КонецЕсли;

	Возврат СтрокиПоступления[0].КодСтроки;

КонецФункции

&НаСервере
Функция АУ_УдалитьСтрокиЗаменыВЗаказе(ЗаказОбъект, Номенклатура, ВозвратСсылка)

	Изменен = Ложь;
	Отбор = Новый Структура("Номенклатура, АУ_ВозвратТоваровПоставщику", Номенклатура, ВозвратСсылка);
	НайденныеСтроки = ЗаказОбъект.Товары.НайтиСтроки(Отбор);

	Для Каждого СтрокаУдаления Из НайденныеСтроки Цикл

		ЗаказОбъект.Товары.Удалить(СтрокаУдаления);
		Изменен = Истина;

	КонецЦикла;

	Возврат Изменен;

КонецФункции

&НаСервере
Функция АУ_СледующийКодСтрокиЗаказа(ЗаказОбъект)

	Результат = ЗаказОбъект.МаксимальныйКодСтроки;

	Для Каждого СтрокаТовары Из ЗаказОбъект.Товары Цикл

		Результат = Макс(Результат, СтрокаТовары.КодСтроки);

	КонецЦикла;

	Возврат Результат + 1;

КонецФункции

#КонецОбласти
