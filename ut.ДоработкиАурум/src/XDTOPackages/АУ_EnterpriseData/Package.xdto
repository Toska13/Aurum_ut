	</objectType>
	<objectType name="Документ.ПоступлениеТоваровУслуг.Товары.Строка" open="true" sequenced="true">
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.10" name="Контракт" type="d3p1:КлючевыеСвойстваДоговор" lowerBound="0" nillable="true"/>
	</objectType>
	<objectType name="Документ.ПоступлениеТоваровУслуг.Услуги.Строка" open="true" sequenced="true">
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.10" name="Контракт" type="d3p1:КлючевыеСвойстваДоговор" lowerBound="0" nillable="true"/>
	</objectType>
	<objectType name="Справочник.Номенклатура" open="true" sequenced="true">
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.10" name="КодОКПД2" type="d3p1:ОбщиеСвойстваДанныеКлассификатора" lowerBound="0"/>
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.10" name="КодРаздел7ДекларацииНДС" type="d3p1:ОбщиеСвойстваДанныеКлассификатора" lowerBound="0"/>
	</objectType>
